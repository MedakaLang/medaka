{- | Hexadecimal encoding and decoding.

   `encode`/`decode` take and return `Bytes`. Each byte becomes two hex
   digits, most significant first. Encoding produces lowercase digits and
   decoding accepts either case; `encodeUpper` produces uppercase digits. -}

-- hex/base64 codec wrappers over a module-local decode share identical wrapper bodies by design.
-- lint-disable-file rule-duplicate-body

-- hex and base64 declare matching signatures for encode/encodeString/decode/decodeString (and
-- hex's encodeUpper matches base64's encode) — a signature-only match between two distinct
-- codecs; the rule has no semantic/type-level check to tell them apart, not a real duplicate.
-- lint-disable-file rule-stdlib-reimpl

import array.{fromList, get as arrGet}
import bytes as B
import bytes.{
  Bytes, encodeUtf8, fromArrayAssumeByteDomain, fromU8Array, toArray
}
import list.{reverse}
import string.{fromDigit, toDigit, toUtf8, fromUtf8, toChars}
import u8 as U8

-- In-bounds indexing via the safe `Array.get`, panicking on a miss.  Every
-- call site below only ever indexes within the array's own known length, so
-- the `None` arm is unreachable; this just avoids the internal-only
-- `arrayGetUnsafe` primitive.
charAt : Int -> Array Char -> Char
charAt i arr = match arrGet i arr
  Some c => c
  None => panic "hex: index out of bounds"

-- # Encoding

digitChar : Int -> Bool -> Char
digitChar n upper =
  if upper then match toDigit n
    Some c => charToUpper c
    None => '?'
  else match toDigit n
    Some c => c
    None => '?'

byteToHexChars : Int -> Bool -> (Char, Char)
byteToHexChars b upper =
  let masked = bitAnd b 255
  let hi = shiftRight masked 4
  let lo = bitAnd masked 15
  (digitChar hi upper, digitChar lo upper)

encodeGo : Bytes -> Int -> Bool -> List Char -> List Char
encodeGo bs i upper acc
  | i < 0 = acc
  | otherwise =
    let (hi, lo) = byteToHexChars (U8.toInt bs[i]) upper
    encodeGo bs (i - 1) upper (hi :: lo :: acc)

encodeAs : Bytes -> Bool -> String
encodeAs bs upper =
  stringFromChars (arrayFromList (encodeGo bs (B.length bs - 1) upper []))

{- | The bytes as lowercase hex, two digits per byte.

   > encode (fromU8Array [|255, 0, 16|])
   "ff0010" -}
export
encode : Bytes -> String
encode b = encodeAs b False

-- > encode (fromU8Array [||])
-- ""
-- > encode (fromU8Array [|0|])
-- "00"

{- | The bytes as uppercase hex, two digits per byte.

   > encodeUpper (fromU8Array [|255, 0, 16|])
   "FF0010" -}
export
encodeUpper : Bytes -> String
encodeUpper b = encodeAs b True

{- | The UTF-8 bytes of a string as lowercase hex.

   > encodeString "Hello"
   "48656c6c6f" -}
export
encodeString : String -> String
encodeString s = encode (encodeUtf8 s)

-- # Decoding

-- Bytes are consed on and reversed once at the end: appending each byte to
-- the accumulator instead would be linear in the bytes already decoded,
-- making the whole decode quadratic in the input's length.
decodeGo : Array Char -> Int -> Int -> List Int -> Result String (List Int)
decodeGo chars i n acc
  | i >= n = Ok (reverse acc)
  | otherwise = match fromDigit (charAt i chars)
    None => Err "hex.decode: invalid hex digit"
    Some hi => match fromDigit (charAt (i + 1) chars)
      None => Err "hex.decode: invalid hex digit"
      Some lo => decodeGo chars (i + 2) n (hi * 16 + lo :: acc)

{- | The bytes written in a hex string, as a `Bytes`.

   `Err` when the string has an odd length or any character that is not a
   hex digit. Whitespace is not skipped.

   > map toArray (decode "ff0010")
   Ok [|255, 0, 16|]
   > decode "zz"
   Err "hex.decode: invalid hex digit" -}
export
decode : String -> Result String Bytes
decode s =
  let chars = toChars s
  let n = arrayLength chars
  if isOdd n then
    Err "hex.decode: odd-length input"
  else
    -- Each decoded byte is `hi * 16 + lo` with both digits in `0` to `15`, so
    -- the byte domain holds by construction and the checked door would only
    -- add a scan.
    map
      (xs => fromArrayAssumeByteDomain (arrayFromList xs))
      (decodeGo chars 0 n [])

-- > let b = fromU8Array [||] in decode (encode b) == Ok b
-- True
-- > let b = fromU8Array [|0|] in decode (encode b) == Ok b
-- True
-- > let b = fromArrayAssumeByteDomain (fromList [0..=255]) in decode (encode b) == Ok b
-- True
-- > map toArray (decode "FF0010")
-- Ok [|255, 0, 16|]
-- > map toArray (decode "")
-- Ok [||]
-- > decode "f"
-- Err "hex.decode: odd-length input"
-- > decode "gg"
-- Err "hex.decode: invalid hex digit"

{- | The string whose UTF-8 bytes are written in a hex string.

   > decodeString "48656c6c6f"
   Ok "Hello" -}
export
decodeString : String -> Result String String
decodeString s = map (bs => fromUtf8 (toArray bs)) (decode s)

-- ── Properties ──────────────────────────────────────────────────────────────

toBytes : List Int -> Bytes
toBytes xs =
  fromArrayAssumeByteDomain
    (arrayFromList (map (b => (b % 256 + 256) % 256) xs))

prop "hex round-trip: decode (encode b) == Ok b" (xs : List Int) =
  let b = toBytes xs
  decode (encode b) == Ok b

prop "hex encode length is 2x byte length" (xs : List Int) =
  let b = toBytes xs
  stringLength (encode b) == 2 * B.length b
