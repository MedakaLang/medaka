-- An element outside the byte domain is refused rather than reduced modulo
-- 256: reducing it would map two different messages onto one digest, which a
-- content-addressing caller cannot detect.
{- | SHA-256 hashing of a byte array (FIPS 180-4).

   A message is an `Array Int` with each element from `0` to `255`, the same
   form `readFileBytes` and `hex.decode` use. The digest is 32 bytes, most
   significant byte of each word first.

   `sha256` panics when any element is outside `0` to `255`. `sha256FixedBytes`
   is the same hash without that check, for a caller whose bytes are already
   known to be in range.

   There is no incremental form. A message is hashed in one call.

   Under the interpreter (`medaka run`, `medaka test`), `sha256` overflows the
   stack on a message longer than about 25 kilobytes. `sha256FixedBytes` and
   native builds hash messages of a megabyte and more. -}

-- Arithmetic contract. Every word is a `U32`, so `+` is addition modulo 2^32
-- and every bit operation, shift and rotate stays within 32 bits. Bytes stay
-- `Int`. A word is assembled from four bytes in `Int` and enters `U32`
-- through `U32.truncate`, and a digest byte leaves through `U32.toInt`.
-- Neither conversion branches. Under HMAC every word derives from secret
-- bytes, so the checked conversions (`fromInt`, `tryFromInt`), which branch
-- on the value, are never applied to a word. Every shift and rotate amount is
-- a constant.
--
-- Message words are big-endian (FIPS 180-4 §3.1) and the digest is emitted in
-- H0..H7 order.
--
-- No padded copy of the whole message is ever materialized: full 64-byte
-- blocks are read directly from the input by offset, and only the final one
-- or two blocks are synthesized to hold the 0x80 marker, the zero padding and
-- the 64-bit big-endian bit length.
--
-- Writes go through `array.setInPlace` rather than the `arr[i] := v` sugar.
-- The two now emit and inline identically, so migrating is mechanical;
-- re-measure the hot loops when you do.
import array.{setInPlace, make, blit}
import u32 as U32

-- ── Constants ────────────────────────────────────────────────────────

-- FIPS 180-4 §5.3.3 initial hash value H(0).
h0Init : (U32, U32, U32, U32, U32, U32, U32, U32)
h0Init = (
  0x6a09e667,
  0xbb67ae85,
  0x3c6ef372,
  0xa54ff53a,
  0x510e527f,
  0x9b05688c,
  0x1f83d9ab,
  0x5be0cd19,
)

-- FIPS 180-4 §4.2.2 round constants K[0..63].
k : Array U32
k = [|
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
  0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
  0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
  0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
  0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
  0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
|]

-- ── Bit / word arithmetic ────────────────────────────────────────────

ch : U32 -> U32 -> U32 -> U32
ch x y z = U32.bitXor (U32.bitAnd x y) (U32.bitAnd (U32.bitNot x) z)

maj : U32 -> U32 -> U32 -> U32
maj x y z =
  U32.bitXor (U32.bitXor (U32.bitAnd x y) (U32.bitAnd x z)) (U32.bitAnd y z)

bigSigma0 : U32 -> U32
bigSigma0 x =
  U32.bitXor
    (U32.bitXor (U32.rotateRight x 2) (U32.rotateRight x 13))
    (U32.rotateRight x 22)

bigSigma1 : U32 -> U32
bigSigma1 x =
  U32.bitXor
    (U32.bitXor (U32.rotateRight x 6) (U32.rotateRight x 11))
    (U32.rotateRight x 25)

smallSigma0 : U32 -> U32
smallSigma0 x =
  U32.bitXor
    (U32.bitXor (U32.rotateRight x 7) (U32.rotateRight x 18))
    (U32.shiftRight x 3)

smallSigma1 : U32 -> U32
smallSigma1 x =
  U32.bitXor
    (U32.bitXor (U32.rotateRight x 17) (U32.rotateRight x 19))
    (U32.shiftRight x 10)

-- In-bounds indexing via the panicking `arr[i]` form: every call site below
-- only ever indexes within a known length, so the panic is unreachable, and
-- unlike `Array.get` it allocates no `Option` per call.
byteAt : Array Int -> Int -> Int
byteAt arr i = arr[i]

wordAt : Array U32 -> Int -> U32
wordAt arr i = arr[i]

-- ── Message schedule ─────────────────────────────────────────────────

-- Big-endian 32-bit word starting at byte index `i*4`, read through an
-- arbitrary byte accessor (so the caller decides whether bytes come from
-- the original message or a synthesized tail block).
scheduleWord : (Int -> Int) -> Int -> U32
scheduleWord byteOf i =
  let b0 = byteOf (i * 4)
  let b1 = byteOf (i * 4 + 1)
  let b2 = byteOf (i * 4 + 2)
  let b3 = byteOf (i * 4 + 3)
  U32.truncate
    (bitOr
      (bitOr (bitOr (shiftLeft b0 24) (shiftLeft b1 16)) (shiftLeft b2 8))
      b3)

fillFirst16 : Array U32 -> (Int -> Int) -> Int -> Unit
fillFirst16 w byteOf i =
  if i >= 16 then
    ()
  else
    setInPlace i (scheduleWord byteOf i) w
    fillFirst16 w byteOf (i + 1)

extendSchedule : Array U32 -> Int -> Unit
extendSchedule w i =
  if i >= 64 then
    ()
  else
    let s0 = smallSigma0 (wordAt w (i - 15))
    let s1 = smallSigma1 (wordAt w (i - 2))
    let v = wordAt w (i - 16) + s0 + wordAt w (i - 7) + s1
    setInPlace i v w
    extendSchedule w (i + 1)

-- Build the 64-word message schedule for one block from a byte accessor
-- covering that block's 64 bytes (offsets 0..63).
buildSchedule : (Int -> Int) -> Array U32
buildSchedule byteOf =
  let w = make 64 (0 : U32)
  fillFirst16 w byteOf 0
  extendSchedule w 16
  w

-- ── Compression ──────────────────────────────────────────────────────

type State = (U32, U32, U32, U32, U32, U32, U32, U32)

compressRounds : Array U32 -> State -> Int -> State
compressRounds w (a, b, c, d, e, f, g, h) t =
  if t >= 64 then
    (a, b, c, d, e, f, g, h)
  else
    let t1 = h + bigSigma1 e + ch e f g + wordAt k t + wordAt w t
    let t2 = bigSigma0 a + maj a b c
    compressRounds w (t1 + t2, a, b, c, d + t1, e, f, g) (t + 1)

-- One 64-byte block, addressed via `byteOf` (offsets 0..63 relative to the
-- block start), folded into the running hash state.
compressBlock : (Int -> Int) -> State -> State
compressBlock byteOf (h0, h1, h2, h3, h4, h5, h6, h7) =
  let w = buildSchedule byteOf
  let (a, b, c, d, e, f, g, h) =
    compressRounds w (h0, h1, h2, h3, h4, h5, h6, h7) 0
  (h0 + a, h1 + b, h2 + c, h3 + d, h4 + e, h5 + f, h6 + g, h7 + h)

-- ── Driving the blocks ───────────────────────────────────────────────

-- Fold every FULL 64-byte block of `msg` directly by offset — no copy of
-- the message is ever made.
processFullBlocks : Array Int -> Int -> State -> Int -> State
processFullBlocks msg numFull st blockIdx =
  if blockIdx >= numFull then
    st
  else
    let base = blockIdx * 64
    processFullBlocks
      msg
      numFull
      (compressBlock (j => byteAt msg (base + j)) st)
      (blockIdx + 1)

-- The length, in bits, of `padLength`-byte messages fits big-endian into
-- the last 8 bytes of the padded block: writes it there.
writeLenGo : Array Int -> Int -> Int -> Int -> Unit
writeLenGo out offset bitLen i =
  if i >= 8 then
    ()
  else
    let shiftAmt = (7 - i) * 8
    setInPlace (offset + i) (bitAnd (shiftRight bitLen shiftAmt) 255) out
    writeLenGo out offset bitLen (i + 1)

-- The number of bytes in the final, padded region (one block if the tail
-- plus the 0x80 marker plus the 8-byte length fits in 64 bytes, else two).
padLength : Int -> Int
padLength tailLen = if tailLen + 1 + 8 <= 64 then 64 else 128

-- Synthesize the final one-or-two padded blocks: `tailLen` message bytes
-- (copied via `blit`, never the whole message), then `0x80`, then zero
-- bytes, then the 64-bit big-endian bit length of `totalLen`. `totalLen` is
-- the FULL count the length field must record, which is `len` at offset
-- zero but includes bytes folded earlier when resuming from a saved state.
buildTailWithTotal : Array Int -> Int -> Int -> Int -> Array Int
buildTailWithTotal msg len tailLen totalLen =
  let size = padLength tailLen
  let out = make size 0
  blit msg (len - tailLen) out 0 tailLen
  setInPlace tailLen 0x80 out
  writeLenGo out (size - 8) (totalLen * 8) 0
  out

processTail : Array Int -> State -> State
processTail tail st =
  let numBlocks = arrayLength tail / 64
  processFullBlocks tail numBlocks st 0

-- ── Public entry point ───────────────────────────────────────────────

-- Is every element of `msg[0 .. len)` inside the `0..255` byte domain? A
-- tail-recursive index scan over safe indexing, allocating nothing.
--
-- This must stay a full-arity self tail call. Native lowers that shape to
-- `musttail`, and callers hash messages of a megabyte and more, so a
-- non-tail rewrite here is a million-frame stack overflow rather than a
-- slowdown. The tree-walking interpreter does not TCO at all, so this same
-- checked entry overflows its stack around tens of kilobytes under `run`/
-- `test` even though native handles a megabyte-plus.
byteDomainOk : Array Int -> Int -> Int -> Bool
byteDomainOk msg len i =
  if i >= len then
    True
  else
    let b = msg[i]
    if b < 0 || b > 255 then False else byteDomainOk msg len (i + 1)

-- Folds `msg` into a hash already carrying `priorState`, which reflects
-- `priorBytes` bytes folded earlier outside `msg` (the final length field
-- must record the total, not just `arrayLength msg`). Internal machinery
-- for `hmac`'s keyed entry point, which folds each padded key block once
-- via `sha256FoldKeyBlock` and resumes from there for every message under
-- that key; not part of the digest API — reach for `sha256`/
-- `sha256FixedBytes` to hash an ordinary message.
export
sha256AssumeByteDomainFrom : (U32, U32, U32, U32, U32, U32, U32, U32) ->
  Int ->
  Array Int ->
  Array Int
sha256AssumeByteDomainFrom priorState priorBytes msg =
  let len = arrayLength msg
  let numFull = len / 64
  let tailLen = len - numFull * 64
  let afterFull = processFullBlocks msg numFull priorState 0
  let tail = buildTailWithTotal msg len tailLen (priorBytes + len)
  let (h0, h1, h2, h3, h4, h5, h6, h7) = processTail tail afterFull
  digestBytes (h0, h1, h2, h3, h4, h5, h6, h7)

sha256AssumeByteDomain : Array Int -> Array Int
sha256AssumeByteDomain msg = sha256AssumeByteDomainFrom h0Init 0 msg

-- Folds one already-padded 64-byte block (an HMAC ipad/opad block) starting
-- from the initial hash state, giving the resume state
-- `sha256AssumeByteDomainFrom` continues from. Internal machinery for
-- `hmac`'s keyed entry point; not part of the digest API.
export
sha256FoldKeyBlock : Array Int -> (U32, U32, U32, U32, U32, U32, U32, U32)
sha256FoldKeyBlock block = compressBlock (byteAt block) h0Init

-- This entry exists for `hmac`, whose every input byte comes from a fixed
-- pad, a SHA-256 digest or caller-canonical scalar bytes. Running the
-- byte-domain scan over those would put a secret-derived early exit inside
-- the signing closure.
{- | The 32-byte SHA-256 digest of `msg`, without checking the byte domain.

   Every element of `msg` must be in `0` to `255`. An element outside that
   range is not detected and yields the digest of some other message. Use
   `sha256` unless the bytes are already known to be in range. -}
export
sha256FixedBytes : Array Int -> Array Int
sha256FixedBytes msg = sha256AssumeByteDomain msg

{- | The 32-byte SHA-256 digest of `msg`.

   Panics when any element of `msg` is outside `0` to `255`. -}
export
sha256 : Array Int -> Array Int
sha256 msg =
  let len = arrayLength msg
  if not (byteDomainOk msg len 0) then
    panic "sha256: every element must be a byte in 0..255"
  else
    sha256AssumeByteDomain msg

digestWord : Array Int -> Int -> U32 -> Unit
digestWord out i h =
  let word = U32.toInt h
  setInPlace (i * 4) (bitAnd (shiftRight word 24) 255) out
  setInPlace (i * 4 + 1) (bitAnd (shiftRight word 16) 255) out
  setInPlace (i * 4 + 2) (bitAnd (shiftRight word 8) 255) out
  setInPlace (i * 4 + 3) (bitAnd word 255) out

digestBytes : State -> Array Int
digestBytes (h0, h1, h2, h3, h4, h5, h6, h7) =
  let out = make 32 0
  digestWord out 0 h0
  digestWord out 1 h1
  digestWord out 2 h2
  digestWord out 3 h3
  digestWord out 4 h4
  digestWord out 5 h5
  digestWord out 6 h6
  digestWord out 7 h7
  out
