_build/
*.install
.merlin
*.swp
.DS_Store

# bootstrap_from_seed.sh output (regenerable native emitter binary)
/medaka_emitter
# Provenance stamp: the compiler-source fingerprint ./medaka_emitter was built from.
# Deliberately NOT checked in and deliberately not copied by `cp medaka_emitter` — a
# stamp-less emitter is one of unknown provenance and must be rebuilt.
/.medaka_emitter.srcstamp
# build_native_medaka.sh output (the native OCaml-free `medaka` CLI binary)
/medaka
# Provenance stamp for ./medaka itself (compiler-source fingerprint). Same rationale
# as /.medaka_emitter.srcstamp above; read by SKIP_CLI_LINK_IF_FRESH=1 only.
/.medaka.srcstamp

# Native gate oracles (built by test/build_oracles.sh)
/test/bin/

# Default `medaka mcp` opt-in call log (scripts/medaka-mcp-wrapper.sh sets
# MEDAKA_MCP_LOG here unless the caller already exported it).
/.medaka-mcp.log

# Playground dist artifacts (built by playground/build_playground_wasm.sh; not committed)
/playground/dist/*.wasm
/playground/dist/*.mdk

# Playground deployable site folder (built by playground/build_site.sh; not committed)
/playground/site/

# Rendered guide pages (built by playground/build_guide.sh from docs/guide/*.md; a
# STAGING dir that build_site.sh will fold into /playground/site/). Regenerable.
/playground/site-guide/

# SQLite demo/probe build artifacts (built to repo root by demos/oracles).
# `/*_demo` covers the whole family (delete_demo, update_demo, update_expr_demo,
# writer_demo, writer_api_demo, overflow_demo, rowid_roundtrip_demo,
# multipage_write_demo, multitable_write_demo, …) — these were being enumerated one
# at a time, and the ones that got missed (e.g. update_expr_demo) sat untracked at
# the root as ~330 KB git-add-A landmines. An agent once committed 5 of them.
/sqlite_*
/*_demo

# `medaka lint --cache` shard cache (#395): per-file lint results keyed by content
# hash, rooted at the project root. Regenerable by definition — a missing or stale
# shard is a cache MISS, which just re-lints the file.
/.medaka/

# Wrangler's local cache, created by playground/deploy_cloudflare.sh. Regenerable, and
# it can hold account metadata — never commit it.
/.wrangler/

# `make dist` / scripts/make_dist.sh output tarball. Regenerable; dist/linux-spike/
# is separate, tracked, historical source and is unaffected by this pattern.
/dist/*.tar.gz
