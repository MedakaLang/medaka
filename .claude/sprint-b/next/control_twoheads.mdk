interface Mk a where
  mk : Int -> a
  un : a -> Int
data T a = T a
data U a = U a
impl Mk (T Int) where
  mk n = T (n + 1)
  un (T n) = n
impl Mk (U Bool) where
  mk n = U (n > 0)
  un (U b) = if b then 777 else 888
roundtrip : Mk a => Int -> Int
roundtrip n = un (mk n)
main : <IO> Unit
main = putStrLn (intToString (roundtrip 10))
