{
  "enabledMcpjsonServers": ["medaka"],
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git grep *)",
      "Bash(git worktree list *)",
      "Bash(./medaka check *)",
      "Bash(./medaka lint *)",
      "Bash(./medaka fmt --check *)",
      "Bash(sh test/must_fail_census.sh)",
      "Bash(make docs-links)",
      "Bash(make agent-doc-symbols)",
      "Bash(make check-self)",
      "Bash(make snapshot-check)"
    ],
    "deny": [
      "Read(./editors/vscode-medaka/package-lock.json)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-triage.py\""
          }
        ]
      }
    ]
  }
}
