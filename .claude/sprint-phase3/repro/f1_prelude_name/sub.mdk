-- F-1. One identifier apart from zub.mdk: the method is named `sub`, which is a
-- method of the PRELUDE interface `Num` (stdlib/core.mdk:699) at arity 2, while
-- this interface declares it at arity 1.
--
-- Measured 2026-08-14 on a cold-built binary at 68f84bf1:
--   check=0  run=0 [2]  build=0  exec=0 [69934889740256]
-- run is correct; the BUILT BINARY prints a leaked pointer at exit 0, no
-- diagnostic. #1450's mechanism with the auto-prelude as the collision partner,
-- so it needs one file and no imports.
interface Zub a where
  sub : a -> Int
data T = T
impl Zub T where
  sub _ = 2
both : Zub a => a -> Int
both x = sub x
main = println (both T)
