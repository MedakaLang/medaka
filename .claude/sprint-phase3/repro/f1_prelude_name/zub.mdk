-- F-1 CONTROL. Identical to sub.mdk except the method is named `zub`, which
-- collides with nothing in the prelude. Correct: run and the built binary both
-- print 2.
interface Zub a where
  zub : a -> Int
data T = T
impl Zub T where
  zub _ = 2
both : Zub a => a -> Int
both x = zub x
main = println (both T)
