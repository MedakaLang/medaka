-- M1c CONTROL: byte-identical to m1c.mdk except the impl head is a plain `Int`
-- rather than `<Stdout> Int`. If this builds and runs while m1c does not, the
-- trigger is the EFFECT ROW in the impl head and nothing else.
interface Sz a where
  sz : a -> Int

impl Sz Int where
  sz _ = 2

main = println (sz 0)
