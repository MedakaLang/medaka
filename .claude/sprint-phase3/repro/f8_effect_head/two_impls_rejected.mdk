-- M1: is an EFFECT-carrying impl head constructible past the parser, and does
-- it survive resolve/coherence/typecheck?
--
-- Today (derived from the printers, not run): eval's implKeyOf strips TyEffect
-- so BOTH impls mint the key "Sz|Int|" and both register at head tag "Int" --
-- findByTag is a first-match scan, so DECLARATION ORDER decides. Meanwhile the
-- typechecker's ppTy renders the effect, stamping "Sz|<Stdout> Int|", a word no
-- definition-side entry carries.
--
-- exit 1 => the ppTy fold is vacuous for TyEffect impl args; bite e is safe on
--           this axis.
-- exit 0 => e CHANGES this program's answer; F5 fixture becomes mandatory, and
--           the permutation twin (m1b.mdk) decides whether it is a live S0.
interface Sz a where
  sz : a -> Int

impl Sz Int where
  sz _ = 1

impl Sz (<Stdout> Int) where
  sz _ = 2

main = println (sz 0)
