-- F-2, permutation arm. Byte-identical to ab.mdk except the two impl blocks are
-- swapped. Answers (9, 9) where ab.mdk answers (5, 5); correct is (5, 9), so
-- BOTH permutations are wrong.
interface Sz a where
  sz : a -> Int
impl Sz (Bool -> Bool) where
  sz _ = 9
impl Sz (Int -> Int) where
  sz _ = 5
f : Int -> Int
f x = x + 1
g : Bool -> Bool
g b = b
main = println (sz f, sz g)
