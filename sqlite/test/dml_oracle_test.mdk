]

-- ── section 2: AUTHORED DB (sqlite3-seeded, Medaka-mutated) ──────────────
dmlAuthoredSeedSql : String
dmlAuthoredSeedSql =
  "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, city TEXT); CREATE TABLE orders (oid INTEGER PRIMARY KEY, uid INTEGER, amt INTEGER); INSERT INTO users VALUES (1,'ada','pdx'),(2,'bob','nyc'),(3,'cyd',NULL); INSERT INTO orders VALUES (1,1,100),(2,2,200),(3,1,50);"

dmlAuthored : List String
dmlAuthored = [
  "INSERT INTO users VALUES (4, 'dee', 'sea')",
  "INSERT INTO orders (uid, amt) VALUES (4, 999)",
  "UPDATE orders SET amt = amt * 2 WHERE uid = 1",
  "DELETE FROM users WHERE city IS NULL",
  "CREATE TABLE tags (t TEXT NOT NULL)",
  "INSERT INTO tags VALUES ('new')",
]

-- ── section 3: OVERFLOW (multi-KB values through the DML path) ──────────
overflowLengths : String -> <Exec "_", IO> Result String Expectation
overflowLengths db = do
  raw <- sqlite3Query db "SELECT length(body) FROM docs ORDER BY rowid;"
  Ok (labelFail "overflow" (expectLines ["9000", "5000"] (outLines raw)))

-- ── section 4: CLI SELECT (byte-identical to the sqlite3 CLI) ────────────
dmlSelects : List String
dmlSelects = [
  "SELECT * FROM users ORDER BY id",
  "SELECT id, name, age, score FROM users ORDER BY id",
  "SELECT name FROM users WHERE age > 20 ORDER BY name",
  "SELECT name, age FROM users WHERE score IS NULL ORDER BY id",
  "SELECT count(*), sum(age), min(age), max(age) FROM users",
  "SELECT age, count(*) FROM users GROUP BY age HAVING count(*) >= 1 ORDER BY age",
  "SELECT DISTINCT age FROM users ORDER BY age",
  "SELECT id, age * 2, score + 0.5 FROM users ORDER BY id LIMIT 3",
  "SELECT id, name FROM users ORDER BY id DESC LIMIT 2 OFFSET 1",
  "select k, note from kv order by k",
  "SELECT * FROM bare ORDER BY n",
  "SELECT a, n FROM bare WHERE n IS NOT NULL ORDER BY n",
  "SELECT users.name, users.age FROM users INNER JOIN bare ON users.age = bare.n ORDER BY users.id",
  "SELECT id, i, r, t FROM aff ORDER BY id",
  "SELECT id FROM aff WHERE i = 5",
]

cliSelectOne : String ->
  String ->
  String ->
  String ->
  <Exec "_", IO> Result String Expectation
cliSelectOne cli mdb sdb q = do
  (_, mout, merr) <- spawnRaw queryTimeoutSeconds cli [mdb, q]
  (_, sout, serr) <- spawnRaw queryTimeoutSeconds "sqlite3" [sdb, q]
  Ok
    (labelFail
      q
      (expectLines (outLines (sout ++ serr)) (outLines (mout ++ merr))))

cliSelectExpectation : String ->
  String ->
  String ->
  <Exec "_", IO> Result String Expectation
cliSelectExpectation cli mdb sdb = do
  diffs <- traverse (cliSelectOne cli mdb sdb) dmlSelects
  Ok (expectAll diffs)

-- ── section 5: REJECTIONS (clean error, no write) ────────────────────────
dmlRejectSeedSql : String
dmlRejectSeedSql =
  "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL, n INTEGER); INSERT INTO t VALUES (1,'a',10),(2,'b',20);"

dmlRejects : List String
dmlRejects = [
  "INSERT INTO t VALUES (1, 'dup', 1)",
  "INSERT INTO t (id, name) VALUES (2, 'dup')",
  "INSERT INTO t (n) VALUES (5)",
  "INSERT INTO t VALUES (3, NULL, 1)",
  "INSERT INTO t (id, name) VALUES ('abc', 'x')",
  "UPDATE t SET name = NULL WHERE id = 1",
  "UPDATE t SET id = 9 WHERE id = 1",
  "INSERT INTO t VALUES (3, 'c')",
  "INSERT INTO t VALUES (3, 'c', 1, 2)",
  "INSERT INTO t (id, name) VALUES (3)",
  "INSERT INTO t (nosuch) VALUES (1)",
  "INSERT INTO t (id, id) VALUES (3, 4)",
  "INSERT INTO nosuch VALUES (1)",
  "UPDATE t SET nosuch = 1",
  "UPDATE nosuch SET n = 1",
  "DELETE FROM nosuch",
  "DELETE FROM t WHERE nosuch = 1",
  "INSERT INTO t VALUES (3, name, 1)",
  "CREATE TABLE t (a INTEGER)",
  "DROP TABLE t",
  "ALTER TABLE t ADD COLUMN x INTEGER",
  "CREATE INDEX i ON t(name)",
  "CREATE TABLE u (a INTEGER) WITHOUT ROWID",
  "CREATE TABLE u (k TEXT PRIMARY KEY)",
  "CREATE TABLE u (a INTEGER DEFAULT 1)",
  "CREATE TABLE u (a INTEGER, UNIQUE(a))",
  "INSERT INTO t SELECT * FROM t",
  "INSERT OR REPLACE INTO t VALUES (1, 'x', 1)",
  "UPDATE t SET n = 1 LIMIT 1",
  "DELETE FROM t ORDER BY id",
  "TRUNCATE t",
  "SELEC * FROM t",
  "UPDATE t SET n = 0 WHERE id IN (SELECT id FROM t)",
  "DELETE FROM t WHERE id NOT IN (SELECT id FROM t)",
]

checkReject : String ->
  String ->
  String ->
  <Exec "_", IO> Result String (List String)
checkReject cli db sql = do
  (code, out, err) <- spawnRaw queryTimeoutSeconds cli [db, sql]
  let combined = trim (out ++ err)
  Ok (if startsWith "error:" combined then
    if code == 0 then
      []
    else
      ["exit \{intToString code} (not a clean error) for: \{sql}"]
  else
    ["NOT REJECTED: \{sql} (got: \{combined})"])

runRejections : String ->
  String ->
  <Exec "_", FileRead "_", IO> Result String Expectation
runRejections cli db = do
  before <- readFileBytes db
  failLists <- traverse (checkReject cli db) dmlRejects
  after <- readFileBytes db
  ic <- sqlite3Query db "PRAGMA integrity_check;"
  Ok
    (expectAll [
      noFailures "reject" (flatLines failLists),
      byteUnchanged (before == after),
      expectEqual "ok" (trim ic),
    ])

dmlLowercaseIpkSeedSql : String
dmlLowercaseIpkSeedSql =
  "CREATE TABLE t (id integer primary key, v TEXT); INSERT INTO t VALUES (1,'a');"

dmlIndexedSeedSql : String
dmlIndexedSeedSql =
  "CREATE TABLE t (a INTEGER, b TEXT); CREATE INDEX ib ON t(b); INSERT INTO t VALUES (1,'x');"

-- A database sqlite3 wrote with a construct the reader cannot round-trip
-- (a lowercase `integer primary key`, a secondary index) must be REFUSED, not
-- silently rewritten without it.
checkSchemaRefusal : String ->
  String ->
  String ->
  String ->
  <Exec "_", IO> Result String Expectation
checkSchemaRefusal label cli db insertSql = do
  (code, out, err) <- spawnRaw queryTimeoutSeconds cli [db, insertSql]
  let combined = trim (out ++ err)
  Ok (if startsWith "error:" combined && code == 0 then
    Pass "a clean error" "a clean error"
  else
    Fail
      "\{label}: expected a clean refusal but got: \{combined} (exit \{intToString code})"
      "a clean error"
      combined)

-- ── section 6: PARSE PROBE (native binary, no database) ──────────────────
parseProbeExpectation : String -> <Exec "_", IO> Result String Expectation
parseProbeExpectation probe = do
  out <- spawnOut queryTimeoutSeconds probe []
  Ok (if contains "TOTAL: PASS" out then
    Pass "TOTAL: PASS" "TOTAL: PASS"
  else
    Fail (trim out) "TOTAL: PASS" (trim out))

-- ── assembling the six sections into four Expectations ────────────────────
data DmlOutcome = DmlOutcome {
  corpusAuthoredOverflow : Expectation,
  cliSelect : Expectation,
  rejections : Expectation,
  parseProbe : Expectation,
}

dmlOutcome : <Exec "_", FileRead "_", IO> Result String DmlOutcome
dmlOutcome = match rowScratch "dml"
  Err e => Err e
  Ok prefix => runDmlOutcome prefix

runDmlOutcome : String -> <Exec "_", FileRead "_", IO> Result String DmlOutcome
runDmlOutcome prefix = do
  let cli = "\{prefix}-cli"
  let probe = "\{prefix}-probe"
  let m1 = "\{prefix}-m1.db"
  let s1 = "\{prefix}-s1.db"
  let m2 = "\{prefix}-m2.db"
  let s2 = "\{prefix}-s2.db"
  let m3 = "\{prefix}-m3.db"
  let s3 = "\{prefix}-s3.db"
  let m5 = "\{prefix}-m5.db"
  let m6 = "\{prefix}-m6.db"
  let m7 = "\{prefix}-m7.db"
  let big = join "" (replicate 5000 "x")
  let big2 = join "" (replicate 9000 "y")
  let dmlOverflow = [
    "CREATE TABLE docs (id INTEGER PRIMARY KEY, body TEXT NOT NULL, n INTEGER)",
    "INSERT INTO docs VALUES (1, '\{big}', 1)",
    "INSERT INTO docs VALUES (2, 'small', 2)",
    "UPDATE docs SET body = '\{big2}' WHERE id = 2",
    "INSERT INTO docs (body) VALUES ('\{big}')",
    "DELETE FROM docs WHERE id = 1",
  ]
  _ <- buildBin [] "sqlite/main.mdk" cli
  _ <- buildBin [] "sqlite/dml_probe.mdk" probe
  e1 <- runCorpusSection cli "dml corpus" m1 s1 dmlCorpus
  _ <- seedDb m2 dmlAuthoredSeedSql
  _ <- seedDb s2 dmlAuthoredSeedSql
  e2 <- runCorpusSection
    cli
    "sqlite3-authored db, Medaka-mutated"
    m2
    s2
    dmlAuthored
  e3 <- runCorpusSection
    cli
    "multi-KB overflow rows through DML"
    m3
    s3
    dmlOverflow
  e3b <- overflowLengths m3
  eSelect <- cliSelectExpectation cli m1 s1
  _ <- seedDb m5 dmlRejectSeedSql
  eReject <- runRejections cli m5
  _ <- seedDb m6 dmlLowercaseIpkSeedSql
  eM6 <- checkSchemaRefusal
    "lowercase IPK schema"
    cli
    m6
    "INSERT INTO t VALUES (2, 'b')"
  _ <- seedDb m7 dmlIndexedSeedSql
  eM7 <- checkSchemaRefusal
    "secondary-indexed schema"
    cli
    m7
    "INSERT INTO t VALUES (2, 'y')"
  eProbe <- parseProbeExpectation probe
  let _ = runVerb "rm" ["-rf", cli, probe, m1, s1, m2, s2, m3, s3, m5, m6, m7]
  Ok DmlOutcome {
    corpusAuthoredOverflow = expectAll [e1, e2, e3, e3b],
    cliSelect = eSelect,
    rejections = expectAll [eReject, eM6, eM7],
    parseProbe = eProbe,
  }

test "dml: DML corpus, authored-db mutation, and multi-KB overflow rows all agree with sqlite3" =
  match dmlOutcome
    Err e => Fail e "the row did not run" "the row did not run"
    Ok o => o.corpusAuthoredOverflow

test "dml: CLI SELECT output is byte-identical to the sqlite3 CLI" =
  match dmlOutcome
    Err e => Fail e "the row did not run" "the row did not run"
    Ok o => o.cliSelect

test "dml: every unsupported construct and constraint violation is a clean error with no write" =
  match dmlOutcome
    Err e => Fail e "the row did not run" "the row did not run"
    Ok o => o.rejections

test "dml: parse probe (native binary) renders and rejects the DML/DDL grammar corpus" =
  match dmlOutcome
    Err e => Fail e "the row did not run" "the row did not run"
    Ok o => o.parseProbe
