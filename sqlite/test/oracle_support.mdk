{- | The shared model behind the `sqlite/` differential oracle runners.

   A differential oracle here is one ROW: a demo entry to build, the SQL that
   seeds a database, how the demo's own output is produced, and how the
   EXPECTED output is derived by asking the real `sqlite3` CLI the equivalent
   question. This module carries the part of that with no process in it — the
   row shape and the two step languages.

   A runner compares a row with `test.expectEqualLines`, over its
   `outLines` joined back with `"\n"`, and never with
   `test.expectEqualText`: that one normalizes away a trailing `()` or a
   whole last line that is exactly `0` as a driver artifact, and
   `projection_demo.mdk`'s `SELECT DISTINCT a*0` block legitimately ends in
   a whole-line `0` that is part of the real answer, not a driver artifact
   — `expectEqualLines` is what compares it untouched.

   The three runners' spawn primitives (`spawnRaw`/`spawnOut`/`seedDb`/
   `spawnEnv`/`emitterBin`) live here too, not because a spawn is a value
   this module models, but because they were three byte-identical copies
   before this module held them. `medaka gate verify`'s native-grading
   clause follows a gate's own project-local imports one hop
   (`gateReaches`/`relaysFor`, `compiler/tools/gate_cmd.mdk`), so a spawn
   routed through this module is graded via the importing gate as long as
   the gate names the spawning binding and the grading evidence sits within
   that one hop — a spawn here is no longer invisible to it.

   Import what you need: `import test.oracle_support.{OracleRow(..), Step(..)}`. -}

import io.{getEnvOr}
import list.{dropWhileEnd, intercalate}
import string.{lines, split, trim, unwords}
import test_process.{boundedVerbSeconds, medakaRoot, underRoot}

-- # One row

{- | How a row's database is seeded before its demo runs: SQL written here, or
   SQL read from a checked-in `.sql` fixture named relative to the tree root.

 -}
-- Two one-field constructors is `Result`'s SHAPE, not its meaning: neither arm
-- is a failure, so folding them onto `Ok`/`Err` would leave the reader guessing
-- which spelling of SQL each one carried.
-- lint-disable-next-line rule-clone-type
public export data Seed = SeedSql String | SeedFile String

{- | One piece of a row's ACTUAL output: a literal line the retired script
   printed itself, or one run of the built demo with these arguments appended
   after the database path. -}
-- `Result`'s shape again, and again not its meaning: a literal line and a
-- command to run are two kinds of output, not a success and a failure.
-- lint-disable-next-line rule-clone-type
public export data Piece = PLine String | PRun (List String)

{- | One piece of a row's EXPECTED output.

   `Rows` is the differential itself: the lines the real `sqlite3` CLI prints
   for that SQL, asked at run time. `NullRows` is the same with
   `.nullvalue NULL`, for a demo that renders SQL NULL as the text `NULL`
   rather than as the empty string. `TypedRows` is the same again through
   `typedUserLine`, for a demo that prints a decoded record rather than a
   pipe-joined row. `Line` is a fixed label, which is the only kind of
   expected line that does not consult `sqlite3`. -}
public export data Step =
  | Line String
  | Rows String
  | NullRows String
  | TypedRows String

{- | One retired `*_oracle.sh` gate, as data.

   `entry` is a tree-root-relative path. `buildFlags` sit before the entry on
   the `medaka build` command line, so a demo that reaches an internal module
   keeps its `--allow-internal`. The two rows whose scripts also diffed
   against a committed golden pass that golden's path directly to
   `goldenExpectation`, as a second, separate assertion from this record. -}
public export data OracleRow = OracleRow {
  name : String,
  entry : String,
  buildFlags : List String,
  seed : List Seed,
  pieces : List Piece,
  expect : List Step,
}

-- # Comparing output

{- | The lines of a captured stdout, without the empty tail that a trailing
   newline leaves behind.

   The retired scripts compared `$(…)` captures, which strip trailing
   newlines, against goldens `diff` compared line-wise; both are this.

   > outLines "a\nb\n"
   ["a", "b"]
   > outLines ""
   [] -}
export
outLines : String -> List String
-- `rule-stdlib-reimpl` matches on the declared signature alone, which
-- `string.lines` shares; taking its suggestion would drop the trailing-empty
-- trim that is the entire point here.
-- lint-disable-next-line rule-stdlib-reimpl
outLines out = dropWhileEnd (== "") (lines out)

{- | The `typed_line` shell function of the retired `typed_oracle.sh`: one
   `sqlite3` `id|name|age` row rendered in `query_demo.mdk`'s own form, with an
   empty age column (SQL NULL) becoming `None`.

   A row of any other shape renders as a self-describing marker rather than
   silently as something plausible, so a column-list change fails the row's
   diff instead of being absorbed by it.

   > typedUserLine "1|Alice|30"
   "User { id=1, name=\"Alice\", age=Some 30 }"
   > typedUserLine "2|Bob|"
   "User { id=2, name=\"Bob\", age=None }"
   > typedUserLine "2|Bob"
   "unexpected sqlite3 row shape: \"2|Bob\"" -}
export
typedUserLine : String -> String
typedUserLine row = match split "|" row
  [i, n, a] =>
    if a == "" then
      "User { id=\{i}, name=\"\{n}\", age=None }"
    else
      "User { id=\{i}, name=\"\{n}\", age=Some \{a} }"
  _ => "unexpected sqlite3 row shape: \{debug row}"

{- | The one list built from many, in order.

   > flatLines [["a"], [], ["b", "c"]]
   ["a", "b", "c"] -}
export
flatLines : List (List String) -> List String
flatLines parts = intercalate [] parts

-- # Spawning a process under the tree

{- | The Medaka native emitter binary a spawn should use: `MEDAKA_EMITTER` if
   set, else the sibling `medaka_emitter` beside the tree's own `medaka`
   binary. -}
export
emitterBin : <IO> String
emitterBin = getEnvOr "MEDAKA_EMITTER" "\{medakaRoot}/medaka_emitter"

{- | `MEDAKA_ROOT` and `MEDAKA_EMITTER`, exported the way the retired shell
   oracles did: a gate shard exports neither on its own, and a `medaka
   build` left to find its own emitter is one refactor away from being
   graded on a verb that silently did nothing. -}
export
spawnEnv : <IO> List String
spawnEnv = ["MEDAKA_ROOT=\{medakaRoot}", "MEDAKA_EMITTER=\{emitterBin}"]

{- | `cmd` run with `args` under a `secs` ceiling: the raw `(exit, stdout,
   stderr)`, except a missing `cmd` (exit 127 through `env`) or a spawn that
   never started, which are both reported as `Err` — "the binary was not on
   PATH" is never read as "it printed nothing and exited 0".

   `env` carries the two `spawnEnv` variables, which is the whole reason it
   is here: Medaka has no `setEnv`. It ends up being `env` twice, harmlessly
   — `boundedVerbSeconds` resolves `cmd` through an `env` of its own, which
   is what makes a missing `cmd` report the host's 127 and its stderr rather
   than `perl`'s failed `exec` returning as if the program had run and
   printed nothing. -}
export
spawnRaw : Int ->
  String ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
spawnRaw secs cmd args =
  match boundedVerbSeconds secs "env" (spawnEnv ++ (cmd :: args))
    Err e =>
      Err "spawn failed: could not start `\{unwords (cmd :: args)}`: \{e}"
    Ok (127, _, err) =>
      Err "spawn failed: \{cmd} not found on PATH: \{trim err}"
    Ok triple => Ok triple

{- | `spawnRaw`, demanding a clean exit: the row's stdout on 0, a named
   failure otherwise. What every build/seed/build-and-run step goes
   through: a row where the tool itself failed is not the same condition as
   a row whose SQL was refused. -}
export
spawnOut : Int -> String -> List String -> <Exec, IO> Result String String
spawnOut secs cmd args = match spawnRaw secs cmd args
  Err e => Err e
  Ok (0, out, _) => Ok out
  Ok (code, out, err) =>
    Err
      "`\{unwords (cmd :: args)}` exited \{intToString code}: \{debug (out ++ err)}"

-- Every seed statement runs under the same ceiling a direct query gets: a
-- hang here is a defect of the row, not of the harness.
seedTimeoutSeconds : Int
seedTimeoutSeconds = 120

{- | One `Seed`'s SQL text: itself, or read from the checked-in fixture it
   names. -}
export
seedSql : Seed -> <FileRead, IO> Result String String
seedSql (SeedSql sql) = Ok sql
seedSql (SeedFile rel) = match readFile (underRoot rel)
  Err e => Err "could not read \{rel}: \{e}"
  Ok text => Ok text

{- | `db` seeded through the real `sqlite3` CLI, one `Seed` statement at a
   time, in order. -}
export
seedDb : String -> List Seed -> <Exec, FileRead, IO> Result String Unit
seedDb _ [] = Ok ()
seedDb db (s :: rest) = match seedSql s
  Err e => Err e
  Ok sql => match spawnOut seedTimeoutSeconds "sqlite3" [db, sql]
    Err e => Err e
    Ok _ => seedDb db rest
