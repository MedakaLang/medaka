-- | sqlite.lib.recordfmt — SQLite record (payload) decoding.
--
-- A record encodes one row.  Layout (SQLITE-DESIGN.md §4):
--
--   [header-length : varint] [serial-type-1 : varint] ... [serial-type-N]
--   [value-1 : bytes] ... [value-N : bytes]
--
-- `header-length` counts itself, so the body starts at record_start +
-- header-length.  We parse the serial types from the header region, then the
-- bodies, threading the ByteParser position.
--
-- Serial types → `Cell` values.  Float (serial 7) decodes via `beFloat64`
-- (8-byte big-endian IEEE 754) into a `CFloat Float` cell.

import byteparser.{
  ByteParser,
  ByteParserE,
  BResult(..),
  onOk,
  runBP,
  runByteParser,
  beSint,
  beU64,
  takeBytes,
  failWith,
  beFloat64,
}
import bytes.{Bytes, fromU8Array, toArray}
import lib.varint.{sqVarint}
import lib.wideint as W
import i64 as I64
import list.{reverse}
import array
import string.{join, fromUtf8}

-- | One decoded column value.
--
-- An INTEGER is `CInt` whenever it fits `Int`, and `CInt64` only when it does
-- not (above 2^62 - 1 or below -2^62): SQLite's integers are 64-bit, Medaka's
-- `Int` holds 63 bits.  One value never has two spellings, so the derived `Eq`
-- and every comparison that dispatches on the constructor stay right.
public export data Cell =
  | CNull
  | CInt Int
  | CInt64 I64
  | CText String
  | CBlob (Array Int)
  | CFloat Float
  deriving (Debug, Eq)

-- | The cell for an INTEGER, `CInt` when it fits `Int`: the one way to build an
--   integer cell from an `I64`, so no value gets two spellings.
export
intCell : I64 -> Cell
intCell x = match W.narrow x
  Some n => CInt n
  None => CInt64 x

-- | An INTEGER cell's value as an `I64`; `None` for every other cell.
export
cellI64 : Cell -> Option I64
cellI64 (CInt n) = Some (W.widen n)
cellI64 (CInt64 x) = Some x
cellI64 _ = None

export impl Display Cell where
  display CNull = "NULL"
  display (CInt n) = intToString n
  display (CInt64 x) = display x
  display (CText s) = s
  display (CBlob _) = "<blob>"
  display (CFloat f) = floatToString f

export
cellToString : Cell -> String
cellToString CNull = ""
cellToString (CInt n) = intToString n
cellToString (CInt64 x) = display x
cellToString (CText s) = s
cellToString (CBlob _) = "<blob>"
cellToString (CFloat f) = floatToString f

-- A serial type's interpretation.  We keep just enough to drive the body parse.
public export data SerialType =
  | STNull
  | STInt Int  -- signed integer of this many body bytes (1,2,3,4,6,8)
  | STIntZero  -- literal 0, no body bytes
  | STIntOne  -- literal 1, no body bytes
  | STFloat  -- 8 body bytes, big-endian IEEE 754 double
  | STText Int  -- text of this many body bytes
  | STBlob Int  -- blob of this many body bytes

-- | Map a raw serial-type code to a `SerialType`.
serialOf : Int -> Result String SerialType
serialOf n
  | n == 0 = Ok STNull
  | n == 1 = Ok (STInt 1)
  | n == 2 = Ok (STInt 2)
  | n == 3 = Ok (STInt 3)
  | n == 4 = Ok (STInt 4)
  | n == 5 = Ok (STInt 6)
  | n == 6 = Ok (STInt 8)
  | n == 7 = Ok STFloat
  | n == 8 = Ok STIntZero
  | n == 9 = Ok STIntOne
  | n == 10 = Err "reserved serial type 10"
  | n == 11 = Err "reserved serial type 11"
  | n >= 12 =
    if isEven n then Ok (STBlob ((n - 12) / 2)) else Ok (STText ((n - 13) / 2))
  | otherwise = Err "negative serial type"

-- | Decode a full record into its column cells.
--
-- Parsing strategy: read the header-length varint, then read serial-type
-- varints until we've consumed (header-length - bytes-of-header-length-varint)
-- bytes' worth of serial types.  Because the ByteParser threads position, we
-- track the absolute end-of-header position and loop until we reach it.
--
-- A real sqlite3 record for the row (id-as-NULL, "Carol", 25): header-length 4,
-- serial 0 (NULL), serial 23 (text, (23-13)/2 = 5 bytes), serial 1 (int8):
--
-- > showCells (runByteParser parseRecord (fromU8Array [|4, 0, 23, 1, 67, 97, 114, 111, 108, 25|]))
-- "NULL|Carol|25"
--
-- A two-int record (header 3, serial 1, serial 2): bytes 0x09 then 0x0100=256:
--
-- > showCells (runByteParser parseRecord (fromU8Array [|3, 1, 2, 9, 1, 0|]))
-- "9|256"
--
-- A single float column (serial 7, 8-byte big-endian IEEE 754):
-- bytes [2, 7] are header (len=2, serial=7); then [63, 248, 0, 0, 0, 0, 0, 0]
-- is the big-endian encoding of 1.5:
--
-- > showCells (runByteParser parseRecord (fromU8Array [|2, 7, 63, 248, 0, 0, 0, 0, 0, 0|]))
-- "1.5"
export
parseRecord : ByteParser (List Cell)
parseRecord = ByteParserE parseRecordGo

-- | Render a decoded record (or a parse error) to a compact "|"-joined string.
--   Used by the doctests above to print results without a Debug instance.
export
showCells : Result String (List Cell) -> String
showCells (Err e) = "Err: \{e}"
showCells (Ok cells) = join "|" (map display cells)

-- | The i-th cell in a decoded row (0-based); out-of-range = `CNull`.
export
nthCell : List Cell -> Int -> Cell
nthCell [] _ = CNull
nthCell (c :: rest) i = if i <= 0 then c else nthCell rest (i - 1)

-- The pure driver: we drop to BResult-level position threading so we can
-- compute the header boundary precisely. `end` is the bound `parseRecord`
-- was itself called with — every nested `runBP` call below passes it
-- through unchanged, so a window set by `runByteParserWithin` still holds
-- inside a record.
parseRecordGo : Bytes -> Int -> Int -> BResult (List Cell)
parseRecordGo input pos end =
  onOk (runBP sqVarint input pos end) (parseRecordAfterHdr input pos end)

parseRecordAfterHdr : Bytes -> Int -> Int -> Int -> Int -> BResult (List Cell)
parseRecordAfterHdr input pos end hdrLen hdrStart =
  let headerEnd = pos + hdrLen
  onOk (readSerialTypes input hdrStart headerEnd end []) (sts _ =>
    readBodies input headerEnd end sts [])

-- Read serial-type varints until `pos >= headerEnd`.
readSerialTypes : Bytes ->
  Int ->
  Int ->
  Int ->
  List SerialType ->
  BResult (List SerialType)
readSerialTypes input pos headerEnd end acc
  | pos >= headerEnd = BOk (reverse acc) pos
  | otherwise = onOk (runBP
    sqVarint
    input
    pos
    end) (code pos2 => match serialOf code
    Err e => BErr e pos
    Ok st => readSerialTypes input pos2 headerEnd end (st :: acc))

-- Read the body bytes for each serial type in order.
readBodies : Bytes ->
  Int ->
  Int ->
  List SerialType ->
  List Cell ->
  BResult (List Cell)
readBodies input pos end [] acc = BOk (reverse acc) pos
readBodies input pos end (st :: rest) acc = onOk (readBody
  input
  pos
  end
  st) (cell pos2 =>
  readBodies input pos2 end rest (cell :: acc))

-- Read one cell's body given its serial type.
readBody : Bytes -> Int -> Int -> SerialType -> BResult Cell
readBody input pos _end STNull = BOk CNull pos
readBody input pos _end STIntZero = BOk (CInt 0) pos
readBody input pos _end STIntOne = BOk (CInt 1) pos
-- An 8-byte integer is SQLite's full 64-bit range, which `Int` does not hold:
-- it is read as its 64 bits and kept as an `I64` only when it does not fit.
readBody input pos end (STInt 8) =
  map (w => intCell (I64.fromBits w)) (runBP beU64 input pos end)
readBody input pos end (STInt nbytes) =
  map CInt (runBP (beSint nbytes) input pos end)
readBody input pos end (STText nbytes) =
  map
    (bs => CText (fromUtf8 (toArray bs)))
    (runBP (takeBytes nbytes) input pos end)
readBody input pos end (STBlob nbytes) =
  map (bs => CBlob (toArray bs)) (runBP (takeBytes nbytes) input pos end)
readBody input pos end STFloat = map CFloat (runBP beFloat64 input pos end)
