-- | sqlite.lib.btree — B-tree page parsing for table pages (leaf 0x0D and
--   interior 0x05).
--
-- A page is `pageSize` bytes.  Page 1 is special: its B-tree header begins at
-- byte offset dbHeaderSize (100, after the database header), not 0.  All other
-- pages begin their B-tree header at offset 0 within the page.
--
-- Page header (SQLITE-DESIGN.md §2):
--   0  1  page type flag (0x0D = table leaf, 0x05 = table interior, ...)
--   1  2  first freeblock offset
--   3  2  number of cells
--   5  2  start of cell content area (0 = 65536)
--   7  1  fragmented free bytes
--   8  4  right-most pointer (interior pages only; absent in leaf header)
--
-- Leaf page header  = leafHeaderSize (8) bytes.
-- Interior page header = interiorHeaderSize (12) bytes (includes the 4-byte
-- right-most pointer).
--
-- The cell pointer array immediately follows the page header.
--
-- Table-leaf cell (§3): [payload-len varint] [rowid varint] [payload].
-- Table-interior cell (§3): [left-child-page 4-byte BE] [rowid varint].
--
-- OVERFLOW PAGES: a payload longer than the leaf's local capacity (see
-- `lib.overflow`) is NOT stored contiguously.  Only its first
-- `localPayloadSize` bytes live in the leaf cell; those are followed by a
-- 4-byte big-endian page number pointing at the head of a chain of overflow
-- pages, each `[4-byte BE next-page][payload bytes]` (next = 0 ends the
-- chain).  `decodeLeafCell` reassembles the payload from the leaf prefix plus
-- the chain before handing it to `parseRecord`.  Every page-geometry-aware
-- entry point therefore takes the `pageSize` and the *usable* page size
-- (`pageSize - reservedPerPage`).
--
-- We decode each row into a `Row` = (rowid, cells).
-- `scanTablePage` recursively walks interior pages, collecting all leaf rows
-- in key order: left-child of cell[0], left-child of cell[1], ...,
-- left-child of cell[n-1], rightmost-child.

import array.{make, blit}
import byteparser.{BOk, BErr, BResult, runBP}
import lib.varint.{sqVarint}
import lib.overflow.{localPayloadSize, localPayloadSizeIndex, overflowCapacity}
import lib.recordfmt.{Cell, CNull, CInt, CText, CBlob, CFloat, parseRecord}
import list.{reverse, init, last}
import string.{join}

-- ---------------------------------------------------------------------------
-- Named structural constants (STYLE §12)
-- ---------------------------------------------------------------------------

-- | Byte offset of the B-tree header on page 1 (follows the 100-byte database
--   file header).  All other pages' B-tree headers start at their page base.
dbHeaderSize : Int
dbHeaderSize = 100

-- | Size of the leaf-page B-tree header (bytes: type + freeblock + cell-count
--   + content-area start + fragmented-free).  The cell-pointer array follows.
leafHeaderSize : Int
leafHeaderSize = 8

-- | Size of the interior-page B-tree header: the 8 common bytes plus the
--   4-byte right-most child pointer.
interiorHeaderSize : Int
interiorHeaderSize = 12

-- | Byte offset of the cell-count uint16 within the page B-tree header.
cellCountOffset : Int
cellCountOffset = 3

-- ---------------------------------------------------------------------------

-- | Bounds-checked single-byte read.  Every structural read in this module
--   funnels through here so that a truncated / corrupt / hostile `.sqlite`
--   yields a recoverable `Err` instead of an unchecked `arrayGetUnsafe` off the
--   heap (memory-unsafe) — mirroring the validate-then-read contract the
--   `byteparser` layer already enforces for cell payloads.
byteAt : Array Int -> Int -> Result String Int
byteAt bytes off =
  if off < 0 || off >= arrayLength bytes then
    Err
      "byte offset \{intToString off} out of bounds (length \{intToString (arrayLength bytes)})"
  else
    Ok bytes[off]

-- | Read a big-endian uint32 at absolute byte offset `off` in `bytes`.
--   Used for the right-most-child pointer and interior-cell left-child pointer.
beU32 : Array Int -> Int -> Result String Int
beU32 bytes off = do
  b0 <- byteAt bytes off
  b1 <- byteAt bytes (off + 1)
  b2 <- byteAt bytes (off + 2)
  b3 <- byteAt bytes (off + 3)
  Ok (shiftLeft b0 24 + shiftLeft b1 16 + shiftLeft b2 8 + b3)

-- | A decoded table row: its rowid and the column cells.
public export data Row = Row Int (List Cell) deriving (Debug, Eq)

export
rowRowid : Row -> Int
rowRowid (Row rid _) = rid

export
rowCells : Row -> List Cell
rowCells (Row _ cs) = cs

export impl Display Row where
  display (Row rid cells) =
    "\{intToString rid}: \{join "|" (map display cells)}"

-- Page-type constants.
export
pageTableLeaf : Int
pageTableLeaf = 13

export
pageTableInterior : Int
pageTableInterior = 5

export
pageIndexInterior : Int
pageIndexInterior = 2

export
pageIndexLeaf : Int
pageIndexLeaf = 10

-- | Read the page-type byte of the page whose B-tree header starts at
--   `hdrOffset` in the whole-file byte array.
export
pageType : Array Int -> Int -> Result String Int
pageType bytes hdrOffset = byteAt bytes hdrOffset

-- | Read the cell count from a page B-tree header at `hdrOffset`.
export
pageCellCount : Array Int -> Int -> Result String Int
pageCellCount bytes hdrOffset = beU16 bytes (hdrOffset + cellCountOffset)

-- Read a big-endian uint16 at absolute byte offset `off`.
beU16 : Array Int -> Int -> Result String Int
beU16 bytes off = do
  b0 <- byteAt bytes off
  b1 <- byteAt bytes (off + 1)
  Ok (shiftLeft b0 8 + b1)

-- | Step one BResult in a flat continuation chain, attaching a per-step label
--   to any error.  Used in `decodeLeafCell` to replace three nested match
--   arms while keeping the label on each failure.  Plain `onOk`/`Mappable`
--   can't carry the per-step label; hence this local helper.
--   Module-private (no export).
bStep : String -> BResult a -> (a -> Int -> Result String b) -> Result String b
bStep label (BErr m ep) _ = Err "\{label}: \{m} at \{intToString ep}"
bStep label (BOk a pos) k = k a pos

-- | Decode all rows of a TABLE-LEAF page.
--
-- `pageSize` / `usable` describe the page geometry (`usable = pageSize -
-- reservedPerPage`); they are needed to locate overflow pages.  `pageBase` is
-- the absolute byte offset of the start of the page (for page N this is
-- (N-1)*pageSize).  `hdrOffset` is where the B-tree header starts (= pageBase,
-- except page 1 where it is pageBase + dbHeaderSize).
--
-- Returns Err if the page is not a table-leaf page.
export
decodeLeafPage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List Row)
decodeLeafPage bytes pageSize usable pageBase hdrOffset = do
  pt <- pageType bytes hdrOffset
  if pt /= pageTableLeaf then
    Err
      "decodeLeafPage: page type \{intToString pt} is not a table-leaf page (0x0D)"
  else do
    nc <- pageCellCount bytes hdrOffset
    decodeCells
      bytes
      pageSize
      usable
      pageBase
      (hdrOffset + leafHeaderSize)
      nc
      0
      []

-- Iterate the cell-pointer array, decoding each table-leaf cell.
decodeCells : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  List Row ->
  Result String (List Row)
decodeCells bytes pageSize usable pageBase cpArrayStart nCells i acc
  | i >= nCells = Ok (reverse acc)
  | otherwise = do
    -- cell pointer i is a uint16 at cpArrayStart + i*2; it is a page-relative
    -- offset, so the absolute cell offset is pageBase + cellPtr.
    cellPtr <- beU16 bytes (cpArrayStart + i * 2)
    let cellOffset = pageBase + cellPtr
    row <- decodeLeafCell bytes pageSize usable cellOffset
    decodeCells
      bytes
      pageSize
      usable
      pageBase
      cpArrayStart
      nCells
      (i + 1)
      (row :: acc)

-- | Decode one table-leaf cell at absolute byte offset `off`:
--   [payload-len varint] [rowid varint] [local payload] [4-byte BE overflow page]
--   — the trailing pointer present only when the payload spills.
--
-- A complete leaf cell for rowid 3, record (NULL, "Carol", 25): payload-length
-- 10, rowid 3, then the 10-byte record (header 4: NULL, text-5, int8).  Ten
-- bytes is far below the local limit, so nothing spills:
--
-- > showRow (decodeLeafCell (arrayFromList [10, 3, 4, 0, 23, 1, 67, 97, 114, 111, 108, 25]) 4096 4096 0)
-- "3: NULL|Carol|25"
--
-- See `lib.overflow` for the threshold arithmetic that decides how much of a
-- payload stays in the cell.
export
decodeLeafCell : Array Int -> Int -> Int -> Int -> Result String Row
decodeLeafCell bytes pageSize usable off = bStep "payload-length varint" (runBP
  sqVarint
  bytes
  off) (payloadLen pos1 => bStep "rowid varint" (runBP
  sqVarint
  bytes
  pos1) (rowid pos2 =>
  decodeCellPayload bytes pageSize usable payloadLen rowid pos2))

-- Reassemble a cell's payload (following the overflow chain when it spills),
-- then parse the record out of it.
--
-- The NO-SPILL path parses in place, straight out of the file image at `pos`,
-- exactly as before overflow support existed — no copy, no behaviour change.
decodeCellPayload : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String Row
decodeCellPayload bytes pageSize usable payloadLen rowid pos =
  let local = localPayloadSize usable payloadLen
  if local >= payloadLen then
    bStep "record" (runBP parseRecord bytes pos) (cells _ =>
      Ok (Row rowid cells))
  else do
    payload <- gatherPayload bytes pageSize usable payloadLen local pos
    bStep "overflow record" (runBP parseRecord payload 0) (cells _ =>
      Ok (Row rowid cells))

-- Build the whole payload of a spilling cell: the `local` bytes held in the
-- leaf, followed by the chain chunks.  The 4-byte big-endian first-overflow
-- page number sits immediately after the local bytes.
gatherPayload : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (Array Int)
gatherPayload bytes pageSize usable payloadLen local pos = do
  _ <- requireBytes bytes (pos + local + 4) "leaf cell local payload"
  firstPage <- beU32 bytes (pos + local)
  -- Allocate the payload buffer once and blit each source region into place:
  -- the leaf-local prefix, then each overflow-page chunk in chain order. Every
  -- payload byte is copied exactly once, so the gather is O(bytes).
  let out = make payloadLen 0
  let _ = blit bytes pos out 0 local
  _ <- gatherChain
    bytes
    pageSize
    usable
    firstPage
    out
    local
    (payloadLen - local)
  Ok out

-- Walk the overflow chain, blitting `remaining` more payload bytes into `out`
-- starting at `writeOff`.  Each page contributes at most `overflowCapacity
-- usable` bytes after its 4-byte next-page pointer; a next-page of 0 must
-- coincide with remaining == 0.
gatherChain : Array Int ->
  Int ->
  Int ->
  Int ->
  Array Int ->
  Int ->
  Int ->
  Result String Unit
gatherChain bytes pageSize usable page out writeOff remaining
  | remaining <= 0 = Ok ()
  | page < 1 =
    Err
      "overflow chain ended early: \{intToString remaining} payload bytes unaccounted for"
  | otherwise =
    let base = (page - 1) * pageSize
    let chunkLen = min remaining (overflowCapacity usable)
    do
      _ <- requireBytes
        bytes
        (base + 4 + chunkLen)
        "overflow page \{intToString page}"
      next <- beU32 bytes base
      let _ = blit bytes (base + 4) out writeOff chunkLen
      gatherChain
        bytes
        pageSize
        usable
        next
        out
        (writeOff + chunkLen)
        (remaining - chunkLen)

-- Fail (rather than silently truncate, which is what `array.slice` would do)
-- if the file image is too short to contain the bytes we are about to read.
requireBytes : Array Int -> Int -> String -> Result String Unit
requireBytes bytes need what =
  if need > arrayLength bytes then
    Err
      "\{what}: file truncated (need \{intToString need} bytes, have \{intToString (arrayLength bytes)})"
  else
    Ok ()

-- ---------------------------------------------------------------------------
-- Index pages (leaf 0x0A, interior 0x02)
-- ---------------------------------------------------------------------------
--
-- An index cell carries no separate rowid varint — the rowid rides inside the
-- record as its trailing column (`lib.dbwriter.encodeIndexLeafCell`).  So a
-- decoded index entry is `(key cells, rowid)`: every cell but the last from
-- `parseRecord`'s result is the indexed key, and the last is always the
-- rowid `lib.dbwriter.encodeIndexCells` appended.
--
-- Unlike a table B-tree (a B+tree: only leaves hold data), an index B-tree
-- keeps a real entry at whatever level it lands on — an index-interior cell's
-- own record is itself part of the index, not just a routing separator. So
-- `scanIndexInteriorCells` below must emit each interior cell's own entry, in
-- key order between its left subtree and the next cell.

-- Split a decoded index record into its key cells and trailing rowid.  The
-- record's LAST cell is always the appended rowid (the inverse of
-- `lib.dbwriter.encodeIndexCells`, which appends `CInt rowid`); everything
-- before it is the indexed key.
splitIndexRecord : List Cell -> Result String (List Cell, Int)
splitIndexRecord cells = match (init cells, last cells)
  (Some ks, Some (CInt rid)) => Ok (ks, rid)
  (Some _, Some other) =>
    Err "index record: trailing rowid cell is not an integer (\{display other})"
  _ => Err "index record: empty record has no rowid column"

-- Reassemble an index cell's payload (following the overflow chain when it
-- spills, using the INDEX local-size formula — different from a table-leaf
-- cell's), parse its record, then split off the trailing rowid.
decodeIndexCellPayload : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List Cell, Int)
decodeIndexCellPayload bytes pageSize usable payloadLen pos =
  let local = localPayloadSizeIndex usable payloadLen
  if local >= payloadLen then
    bStep "record" (runBP parseRecord bytes pos) (cells _ =>
      splitIndexRecord cells)
  else do
    payload <- gatherPayload bytes pageSize usable payloadLen local pos
    bStep "overflow record" (runBP parseRecord payload 0) (cells _ =>
      splitIndexRecord cells)

-- | Decode one index-leaf cell at absolute byte offset `off`:
--   `[payload-len varint][record]` — no rowid varint, unlike a table-leaf cell.
export
decodeIndexLeafCell : Array Int ->
  Int ->
  Int ->
  Int ->
  Result String (List Cell, Int)
decodeIndexLeafCell bytes pageSize usable off = bStep
  "payload-length varint"
  (runBP sqVarint bytes off)
  (payloadLen pos1 =>
    decodeIndexCellPayload bytes pageSize usable payloadLen pos1)

-- Iterate the cell-pointer array, decoding each index-leaf cell.
decodeIndexCells : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  List (List Cell, Int) ->
  Result String (List (List Cell, Int))
decodeIndexCells bytes pageSize usable pageBase cpArrayStart nCells i acc
  | i >= nCells = Ok (reverse acc)
  | otherwise = do
    cellPtr <- beU16 bytes (cpArrayStart + i * 2)
    let cellOffset = pageBase + cellPtr
    entry <- decodeIndexLeafCell bytes pageSize usable cellOffset
    decodeIndexCells
      bytes
      pageSize
      usable
      pageBase
      cpArrayStart
      nCells
      (i + 1)
      (entry :: acc)

-- Decode one index-interior cell at absolute offset `off`:
--   `[4-byte BE left-child][payload-len varint][record]` — the reverse field
-- order from a table-interior cell, because the key (unlike a bare rowid) is
-- variable-length and must be length-prefixed like any other record.
-- Returns the left-child page number plus the entry this cell itself carries.
decodeIndexInteriorCell : Array Int ->
  Int ->
  Int ->
  Int ->
  Result String (Int, (List Cell, Int))
decodeIndexInteriorCell bytes pageSize usable off = do
  leftChild <- beU32 bytes off
  bStep "payload-length varint" (runBP
    sqVarint
    bytes
    (off + 4)) (payloadLen pos1 =>
    decodeIndexInteriorPayload bytes pageSize usable leftChild payloadLen pos1)

decodeIndexInteriorPayload : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (Int, (List Cell, Int))
decodeIndexInteriorPayload bytes pageSize usable leftChild payloadLen pos = do
  entry <- decodeIndexCellPayload bytes pageSize usable payloadLen pos
  Ok (leftChild, entry)

-- | Scan all entries reachable from index page `pageNum`, handling both
--   index-leaf (0x0A) and index-interior (0x02) pages.  Entries come back in
--   key order.
export
scanIndexPage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List (List Cell, Int))
scanIndexPage bytes pageSize usable pageNum hdrOffset = do
  ptype <- pageType bytes hdrOffset
  if ptype == pageIndexLeaf then do
    let pageBase = (pageNum - 1) * pageSize
    nc <- pageCellCount bytes hdrOffset
    decodeIndexCells
      bytes
      pageSize
      usable
      pageBase
      (hdrOffset + leafHeaderSize)
      nc
      0
      []
  else if ptype == pageIndexInterior then
    scanIndexInteriorPage bytes pageSize usable pageNum hdrOffset
  else
    Err
      "scanIndexPage: unexpected page type \{intToString ptype} on page \{intToString pageNum}"

-- Scan an index-interior page: for each cell, recurse into its left-child
-- subtree, then emit the cell's OWN entry (an index-interior cell is a real
-- entry, not just a routing separator), then move on; finally recurse into
-- the rightmost child.
scanIndexInteriorPage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List (List Cell, Int))
scanIndexInteriorPage bytes pageSize usable pageNum hdrOffset = do
  let pageBase = (pageNum - 1) * pageSize
  nCells <- pageCellCount bytes hdrOffset
  rightmost <- beU32 bytes (hdrOffset + leafHeaderSize)
  let cpArrayStart = hdrOffset + interiorHeaderSize
  scanIndexInteriorCells
    bytes
    pageSize
    usable
    cpArrayStart
    pageBase
    nCells
    0
    rightmost
    []

scanIndexInteriorCells : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  List (List Cell, Int) ->
  Result String (List (List Cell, Int))
scanIndexInteriorCells bytes pageSize usable cpArrayStart pageBase nCells i rightmost acc
  | i >= nCells = do
    let rmHdr = pageHdrOffset pageSize rightmost
    rows <- scanIndexPage bytes pageSize usable rightmost rmHdr
    Ok (acc ++ rows)
  | otherwise = do
    cellPtr <- beU16 bytes (cpArrayStart + i * 2)
    let cellOff = pageBase + cellPtr
    (leftChild, entry) <- decodeIndexInteriorCell bytes pageSize usable cellOff
    let childHdr = pageHdrOffset pageSize leftChild
    leftRows <- scanIndexPage bytes pageSize usable leftChild childHdr
    scanIndexInteriorCells
      bytes
      pageSize
      usable
      cpArrayStart
      pageBase
      nCells
      (i + 1)
      rightmost
      (acc ++ leftRows ++ [entry])

-- ---------------------------------------------------------------------------
-- Multi-page recursive B-tree scan
-- ---------------------------------------------------------------------------

-- | Byte offset of the B-tree header for page `pageNum` in the whole-file
--   byte array.  Page 1's header is displaced by `dbHeaderSize`; all others
--   start at the page base `(pageNum-1)*pageSize`.
--   Centralises the page-1-is-special rule used by `scanInteriorCells`.
pageHdrOffset : Int -> Int -> Int
pageHdrOffset pageSize pageNum =
  if pageNum == 1 then dbHeaderSize else (pageNum - 1) * pageSize

-- | Scan all rows reachable from page `pageNum` (1-indexed) in the whole-file
--   byte array `bytes`, where each page is `pageSize` bytes.
--
-- Handles both table-leaf (0x0D) and table-interior (0x05) pages recursively.
-- Interior pages are traversed left-to-right (all left-children in cell order,
-- then the right-most child), yielding rows in rowid order.
--
-- `hdrOffset` for page 1 = dbHeaderSize; for all other pages = pageBase.
-- `usable` is `pageSize - reservedPerPage` (needed for overflow-chain reads).
export
scanTablePage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List Row)
scanTablePage bytes pageSize usable pageNum hdrOffset = do
  ptype <- pageType bytes hdrOffset
  if ptype == pageTableLeaf then do
    let pageBase = (pageNum - 1) * pageSize
    nc <- pageCellCount bytes hdrOffset
    decodeCells
      bytes
      pageSize
      usable
      pageBase
      (hdrOffset + leafHeaderSize)
      nc
      0
      []
  else if ptype == pageTableInterior then
    scanInteriorPage bytes pageSize usable pageNum hdrOffset
  else
    Err
      "scanTablePage: unexpected page type \{intToString ptype} on page \{intToString pageNum}"

-- Scan an interior page: recurse into all left-children then the rightmost child.
scanInteriorPage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (List Row)
scanInteriorPage bytes pageSize usable pageNum hdrOffset = do
  let pageBase = (pageNum - 1) * pageSize
  nCells <- pageCellCount bytes hdrOffset
  -- right-most child pointer is at hdrOffset + leafHeaderSize
  rightmost <- beU32 bytes (hdrOffset + leafHeaderSize)
  -- interior page cell-pointer array starts at hdrOffset + interiorHeaderSize
  let cpArrayStart = hdrOffset + interiorHeaderSize
  scanInteriorCells
    bytes
    pageSize
    usable
    cpArrayStart
    pageBase
    nCells
    0
    rightmost
    []

-- Iterate interior cells; each cell gives us a left-child page to recurse into.
-- After all left-children, recurse into rightmost.
scanInteriorCells : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  List Row ->
  Result String (List Row)
scanInteriorCells bytes pageSize usable cpArrayStart pageBase nCells i rightmost acc
  | i >= nCells = do
    -- all left-children visited; now the rightmost child
    let rmHdr = pageHdrOffset pageSize rightmost
    rows <- scanTablePage bytes pageSize usable rightmost rmHdr
    Ok (acc ++ rows)
  | otherwise = do
    cellPtr <- beU16 bytes (cpArrayStart + i * 2)
    let cellOff = pageBase + cellPtr
    -- interior cell: [4-byte left-child] [rowid varint] — we only need left-child
    leftChild <- beU32 bytes cellOff
    let childHdr = pageHdrOffset pageSize leftChild
    rows <- scanTablePage bytes pageSize usable leftChild childHdr
    scanInteriorCells
      bytes
      pageSize
      usable
      cpArrayStart
      pageBase
      nCells
      (i + 1)
      rightmost
      (acc ++ rows)

-- ---------------------------------------------------------------------------
-- Single-path rowid seek
-- ---------------------------------------------------------------------------
--
-- `scanTablePage` above visits every page reachable from the root; a lookup
-- by exact rowid only needs the one root-to-leaf path that can contain it.
-- Per the table b-tree invariant (SQLITE-DESIGN.md), an interior cell's rowid
-- is the LARGEST rowid in that cell's left-child subtree, and every rowid in
-- the right-most child exceeds every cell's rowid on the page — so comparing
-- the seek target against each cell's rowid in order, left to right, picks
-- the single child to descend into.

-- | Decode a table-interior cell's rowid at absolute offset `off`, without
--   decoding its left-child subtree: `[4-byte BE left-child][rowid varint]`.
interiorCellRowid : Array Int -> Int -> Result String Int
interiorCellRowid bytes off = bStep "interior rowid varint" (runBP
  sqVarint
  bytes
  (off + 4)) (rid _ =>
  Ok rid)

-- | Seek rowid `target` starting from page `pageNum`, handling both
--   table-leaf (0x0D) and table-interior (0x05) pages.  Returns `Ok None`
--   when no row with that rowid exists on the reachable leaf.
export
seekTablePage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (Option Row)
seekTablePage bytes pageSize usable pageNum hdrOffset target = do
  ptype <- pageType bytes hdrOffset
  if ptype == pageTableLeaf then do
    let pageBase = (pageNum - 1) * pageSize
    rows <- decodeLeafPage bytes pageSize usable pageBase hdrOffset
    Ok (findRowid target rows)
  else if ptype == pageTableInterior then
    seekInteriorPage bytes pageSize usable pageNum hdrOffset target
  else
    Err
      "seekTablePage: unexpected page type \{intToString ptype} on page \{intToString pageNum}"

-- Find the row (if any) whose rowid equals `target` among a leaf's decoded rows.
findRowid : Int -> List Row -> Option Row
findRowid target [] = None
findRowid target (r :: rest) =
  if rowRowid r == target then Some r else findRowid target rest

-- Descend one interior page: walk its cells left to right, comparing `target`
-- against each cell's rowid; descend into the first cell whose rowid is >=
-- target, or the right-most child once every cell's rowid is smaller.
seekInteriorPage : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (Option Row)
seekInteriorPage bytes pageSize usable pageNum hdrOffset target = do
  let pageBase = (pageNum - 1) * pageSize
  nCells <- pageCellCount bytes hdrOffset
  rightmost <- beU32 bytes (hdrOffset + leafHeaderSize)
  let cpArrayStart = hdrOffset + interiorHeaderSize
  seekInteriorCells
    bytes
    pageSize
    usable
    cpArrayStart
    pageBase
    nCells
    0
    rightmost
    target

seekInteriorCells : Array Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Result String (Option Row)
seekInteriorCells bytes pageSize usable cpArrayStart pageBase nCells i rightmost target
  | i >= nCells = do
    let rmHdr = pageHdrOffset pageSize rightmost
    seekTablePage bytes pageSize usable rightmost rmHdr target
  | otherwise = do
    cellPtr <- beU16 bytes (cpArrayStart + i * 2)
    let cellOff = pageBase + cellPtr
    leftChild <- beU32 bytes cellOff
    cellRowid <- interiorCellRowid bytes cellOff
    if target <= cellRowid then
      let childHdr = pageHdrOffset pageSize leftChild
      seekTablePage bytes pageSize usable leftChild childHdr target
    else
      seekInteriorCells
        bytes
        pageSize
        usable
        cpArrayStart
        pageBase
        nCells
        (i + 1)
        rightmost
        target

-- ---------------------------------------------------------------------------

-- | Render a decoded row (or error) as "rowid: cell|cell|..." for doctests.
export
showRow : Result String Row -> String
showRow (Err e) = "Err: \{e}"
showRow (Ok row) = display row
