-- `noInlineFnNames` is the whole route from a `@noinline` attribute to the LLVM
-- emitter's `noinline` function attribute: the build driver hands its result to
-- `withNoInlineFns`.  A name it misses is a helper LLVM may inline away, which is
-- invisible until a check that disassembles that helper finds no symbol.

import test.{expectAll, expectEqual, expectFalse, expectTrue, fail}
import frontend.desugar.{desugar}
import frontend.parser.{parse}
import ir.core_ir_lower.{
  noInlineFnNames, methodResultFacts, lowerProgramEmitWith, leadingDictParams
}
import ir.core_ir.{
  CArm(..),
  CBind(..),
  CClause(..),
  CExpr(..),
  CGuard,
  CProgram(..),
  EntryFact(..),
  MethodResultFact(..),
}
import frontend.ast.{
  Decl(..),
  Lit(..),
  Pat(..),
  TyConOrigin(..),
  noDeclLoc,
  noBinderId,
  orCandidates,
  paramCandidates,
}
import ir.sexp.{patSexp}
import types.annotate.{annotateProgram}
import types.program_facts.{ProgramFacts(..), emptyFacts}
import types.publish.{EntryOutcome(..)}
import support.util.{isEmptyL, joinNl}
import types.capability_manifest.{
  EntryKey(..),
  ManifestRequest(..),
  InvocationProtocol(..),
  CapabilityManifest(..),
  FrozenAtom(..),
  FrozenAuthority(..),
}
import types.effect_domain.{Param(..)}
import ir.core_ir.{withBinderRows}
import ir.core_ir_sexp.{cprogramToSexp}
import ir.core_ir_sexp_parse.{parseCProgram}
import ir.dce.{dceFilter}
import backend.wasm_names.{uniqueBinders}
import backend.wasm_reach.{wasmReachFilter}

clockManifest : CapabilityManifest
clockManifest = CapabilityManifest {
  request = ManifestRequest {
    entry = EntryKey { moduleId = "source", binding = "dead" },
    protocol = HostInvocation,
  },
  atoms = [
    FrozenAtom {
      label = "Clock",
      origin = OriginBuiltin,
      domainTop = PUnit,
      authority = FrozenConst PUnit,
    },
  ],
}

test "lowering DCE reach uniquing binder updates and sexp preserve a complete manifest" =
  let facts = { emptyFacts | pfManifests = [clockManifest] }
  let decls =
    annotateProgram
      (dceFilter
        (desugar
          (parse """
dead : Unit -> <Clock> Unit
dead _ = ()
main = ()
""")))
  let lowered = lowerProgramEmitWith facts decls
  let reached = wasmReachFilter lowered
  let unique = uniqueBinders reached
  let restored = parseCProgram (cprogramToSexp unique)
  let view (CProgram _ _ _ _ _ f) =
    map
      (m => (
        (m : CapabilityManifest).request.entry.moduleId,
        (m : CapabilityManifest).request.entry.binding,
        map (a => a.label) m.atoms,
      ))
      f.factManifests
  let expected = [("source", "dead", ["Clock"])]
  expectAll
    (map
      (p => expectEqual expected (view p))
      [lowered, reached, unique, withBinderRows [] unique, restored])

marked : String -> List String
marked source = noInlineFnNames (desugar (parse source))

test "@noinline above a signature marks the function" =
  expectEqual
    ["f"]
    (marked (joinNl ["@noinline", "f : Int -> Int", "f x = x + 1"]))

test "@noinline on a definition without a signature marks the function" =
  expectEqual ["g"] (marked (joinNl ["@noinline", "g x = x + 1"]))

test "@noinline is found under and over another attribute" =
  expectEqual
    ["h", "k"]
    (marked
      (joinNl [
        "@must_use",
        "@noinline",
        "h : Int -> Int",
        "h x = x",
        "@noinline",
        "@deprecated \"old\"",
        "k : Int -> Int",
        "k x = x",
      ]))

test "@noinline above an exported signature marks the function" =
  expectEqual
    ["e"]
    (marked (joinNl ["@noinline", "export", "e : Int -> Int", "e x = x"]))

test "other attributes and unattributed functions mark nothing" =
  expectEqual
    []
    (marked
      (joinNl [
        "@inline",
        "a : Int -> Int",
        "a x = x",
        "@must_use",
        "b : Int -> Int",
        "b x = x",
        "c : Int -> Int",
        "c x = x",
      ]))

resultFacts : String -> List MethodResultFact
resultFacts source =
  match (lowerProgramEmitWith
    emptyFacts
    (annotateProgram (desugar (parse source))))
    CProgram _ _ _ _ _ facts => facts.factMethodResults

test "method results mention only the head interface parameter" =
  expectEqual
    [
      MethodResultFact {
        iface = "Ix",
        method = "whole",
        returnsHead = True,
        callbackPositions = [],
        valueArity = 1,
      },
      MethodResultFact {
        iface = "Ix",
        method = "element",
        returnsHead = False,
        callbackPositions = [],
        valueArity = 1,
      },
    ]
    (resultFacts
      """
interface Ix c v where
  whole : c -> c
  element : c -> v
""")

test "callback facts count value parameters and retain non-head results" =
  expectEqual
    [
      MethodResultFact {
        iface = "Chain",
        method = "step",
        returnsHead = True,
        callbackPositions = [1, 2],
        valueArity = 3,
      },
    ]
    (resultFacts
      """
interface Chain c v where
  step : Num n => c -> (v -> c) -> (c -> v) -> c
""")

qualifiedInterface : String -> Decl -> Decl
qualifiedInterface origin (d@(DInterface { ... })) =
  DInterface { d | ifaceOrigin = OriginModule origin }
qualifiedInterface _ d = d

test "same-spelled interfaces retain distinct qualified result facts" =
  let left =
    map
      (qualifiedInterface "left")
      (parse "interface Shared c where\n  pick : c -> c")
  let right =
    map
      (qualifiedInterface "right")
      (parse "interface Shared c where\n  pick : c -> Int")
  expectEqual
    [
      MethodResultFact {
        iface = "left::Shared",
        method = "pick",
        returnsHead = True,
        callbackPositions = [],
        valueArity = 1,
      },
      MethodResultFact {
        iface = "right::Shared",
        method = "pick",
        returnsHead = False,
        callbackPositions = [],
        valueArity = 1,
      },
    ]
    (methodResultFacts (left ++ right))

test "lowering projects the selected entry outcome without inspecting the program" =
  let selected = EntryOutcome {
    eoMainIsUnit = True,
    eoMainIsFloat = True,
    eoMainIsAsync = True,
    eoMainAsyncPayloadIsUnit = False,
    eoAutoPrint = None,
  }
  let lowered =
    lowerProgramEmitWith { emptyFacts | pfEntryOutcome = Some selected } []
  let carried = match lowered
    CProgram _ _ _ _ _ facts => facts.factEntryOutcome
  match carried
    Some outcome => expectAll [
      expectTrue outcome.entryMainIsUnit,
      expectTrue outcome.entryMainIsFloat,
    ]
    None => fail "lowering dropped its entry outcome"

-- Both emitters size an impl's dictionary pushes from this count, so a corrupted
-- count makes the caller push a different number of words than the define binds.
test "leadingDictParams counts only the leading dict witnesses" =
  let var name = PVar name noDeclLoc noBinderId
  expectAll [
    expectEqual 0 (leadingDictParams [var "x", var "$dict_eq_0"]),
    expectEqual 2 (leadingDictParams [var "$dict_a", var "$dict_b", PWild]),
    expectEqual 1 (leadingDictParams [var "$dict_a", var "x", var "$dict_b"]),
    expectEqual 0 (leadingDictParams []),
  ]

-- ── or-patterns ──────────────────────────────────────────────────────────────
-- An or-pattern reaches no engine: lowering expands an arm into its candidates,
-- the first a `CArm` carrying the body, the rest `CArmAlt`s naming its index.

orLowered : String -> CProgram
orLowered source =
  lowerProgramEmitWith emptyFacts (annotateProgram (desugar (parse source)))

orClauses : String -> CProgram -> List CClause
orClauses name (CProgram groups _ _ _ _ _) =
  flatMap
    (b => match b
      CBind n cs _ _ => if n == name then cs else [])
    groups

-- One word per arm of a clause body's decision: `arm` for an arm with its own
-- body, `alt<i>` for a candidate sharing arm i's, `?` when it is guarded.
armShapes : CExpr -> List String
armShapes (CDecision _ arms _) = map armShape arms
armShapes _ = []

armShape : CArm -> String
armShape (CArm _ gs _) = "arm" ++ guardMark gs
armShape (CArmAlt _ gs i) = "alt\{intToString i}" ++ guardMark gs

guardMark : List CGuard -> String
guardMark gs = if isEmptyL gs then "" else "?"

armPatText : CArm -> String
armPatText (CArm p _ _) = patSexp p
armPatText (CArmAlt p _ _) = patSexp p

decisionArms : CExpr -> List CArm
decisionArms (CDecision _ arms _) = arms
decisionArms _ = []

clauseBody : CClause -> CExpr
clauseBody (CClause _ body) = body

clauseParams : CClause -> List String
clauseParams (CClause pats _) = map patSexp pats

orColors : String
orColors = "data C = A | B | D\n"

test "orCandidates expands alternatives left to right, the leftmost slowest" =
  let x = PVar "x" noDeclLoc noBinderId
  let pat =
    PTuple [POr [PCon "A" [x], PCon "B" [x]], POr [PLit (LInt 1), PWild]]
  expectAll [
    expectEqual
      [
        "(PTuple (PCon \"A\" (PVar \"x\")) (PLit (LInt 1)))",
        "(PTuple (PCon \"A\" (PVar \"x\")) PWild)",
        "(PTuple (PCon \"B\" (PVar \"x\")) (PLit (LInt 1)))",
        "(PTuple (PCon \"B\" (PVar \"x\")) PWild)",
      ]
      (map patSexp (orCandidates pat)),
    expectEqual [patSexp x] (map patSexp (orCandidates x)),
    expectEqual
      [["(PCon \"A\")", "PWild"], ["(PCon \"B\")", "PWild"]]
      (map
        (ps => map patSexp ps)
        (paramCandidates [POr [PCon "A" [], PCon "B" []], PWild])),
  ]

test "an or-pattern arm lowers to candidates sharing the first one's body" =
  let source = orColors ++ "f c = match c\n  A | B => 1\n  D => 2\n"
  let bodies = map clauseBody (orClauses "f" (orLowered source))
  expectAll [
    expectEqual [["arm", "alt0", "arm"]] (map armShapes bodies),
    expectEqual
      [["(PCon \"A\")", "(PCon \"B\")", "(PCon \"D\")"]]
      (map (b => map armPatText (decisionArms b)) bodies),
  ]

test "a guarded arm's candidates each carry the guard, nested ones leftmost slowest" =
  let source =
    "g p = match p\n  ((x, _) | (_, x), (y, _) | (_, y)) if x > y => x\n  _ => 0\n"
  let bodies = map clauseBody (orClauses "g" (orLowered source))
  expectAll [
    expectEqual
      [["arm?", "alt0?", "alt0?", "alt0?", "arm"]]
      (map armShapes bodies),
    expectEqual
      [
        [
          "(PTuple (PTuple (PVar \"x\") PWild) (PTuple (PVar \"y\") PWild))",
          "(PTuple (PTuple (PVar \"x\") PWild) (PTuple PWild (PVar \"y\")))",
          "(PTuple (PTuple PWild (PVar \"x\")) (PTuple (PVar \"y\") PWild))",
          "(PTuple (PTuple PWild (PVar \"x\")) (PTuple PWild (PVar \"y\")))",
          "PWild",
        ],
      ]
      (map (b => map armPatText (decisionArms b)) bodies),
  ]

test "a guard-bind through an or-pattern expands the arm over its alternatives" =
  let source = orColors ++ "h c = match c\n  _ if (A | B) <- c => 1\n  _ => 0\n"
  expectEqual
    [["arm?", "alt0?", "arm"]]
    (map (c => armShapes (clauseBody c)) (orClauses "h" (orLowered source)))

test "an unguarded or-pattern parameter is tested by a decision over a fresh one" =
  let source = orColors ++ "k (A | B) = 1\nk D = 2\n"
  let clauses = orClauses "k" (orLowered source)
  expectAll [
    expectEqual
      [["(PVar \"$or0\")"], ["(PCon \"D\")"]]
      (map clauseParams clauses),
    expectEqual
      [["arm", "alt0", "arm"], []]
      (map (c => armShapes (clauseBody c)) clauses),
  ]

test "a guarded or-pattern parameter repeats its clause once per alternative" =
  let source = orColors ++ "m (A | B) | 1 > 0 = 1\nm _ = 2\n"
  expectEqual
    [["(PCon \"A\")"], ["(PCon \"B\")"], ["PWild"]]
    (map clauseParams (orClauses "m" (orLowered source)))

test "a match without or-patterns lowers to arms only" =
  let source = orColors ++ "n c = match c\n  A => 1\n  _ => 2\n"
  expectEqual
    [["arm", "arm"]]
    (map (c => armShapes (clauseBody c)) (orClauses "n" (orLowered source)))
