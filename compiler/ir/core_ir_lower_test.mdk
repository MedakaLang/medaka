-- `noInlineFnNames` is the whole route from a `@noinline` attribute to the LLVM
-- emitter's `noinline` function attribute: the build driver hands its result to
-- `withNoInlineFns`.  A name it misses is a helper LLVM may inline away, which is
-- invisible until a check that disassembles that helper finds no symbol.

import test.{expectAll, expectEqual, expectFalse, expectTrue, fail}
import frontend.desugar.{desugar}
import frontend.parser.{parse}
import ir.core_ir_lower.{
  noInlineFnNames, methodResultFacts, lowerProgramEmitWith, leadingDictParams
}
import ir.core_ir.{CProgram(..), EntryFact(..), MethodResultFact(..)}
import frontend.ast.{Decl(..), Pat(..), TyConOrigin(..), noDeclLoc, noBinderId}
import types.annotate.{annotateProgram}
import types.program_facts.{ProgramFacts(..), emptyFacts}
import types.publish.{EntryOutcome(..)}
import support.util.{joinNl}
import types.capability_manifest.{
  EntryKey(..),
  ManifestRequest(..),
  InvocationProtocol(..),
  CapabilityManifest(..),
  FrozenAtom(..),
  FrozenAuthority(..),
}
import types.effect_domain.{Param(..)}
import ir.core_ir.{withBinderRows}
import ir.core_ir_sexp.{cprogramToSexp}
import ir.core_ir_sexp_parse.{parseCProgram}
import ir.dce.{dceFilter}
import backend.wasm_names.{uniqueBinders}
import backend.wasm_reach.{wasmReachFilter}

clockManifest : CapabilityManifest
clockManifest = CapabilityManifest {
  request = ManifestRequest {
    entry = EntryKey { moduleId = "source", binding = "dead" },
    protocol = HostInvocation,
  },
  atoms = [
    FrozenAtom {
      label = "Clock",
      origin = OriginBuiltin,
      domainTop = PUnit,
      authority = FrozenConst PUnit,
    },
  ],
}

test "lowering DCE reach uniquing binder updates and sexp preserve a complete manifest" =
  let facts = { emptyFacts | pfManifests = [clockManifest] }
  let decls =
    annotateProgram
      (dceFilter
        (desugar
          (parse """
dead : Unit -> <Clock> Unit
dead _ = ()
main = ()
""")))
  let lowered = lowerProgramEmitWith facts decls
  let reached = wasmReachFilter lowered
  let unique = uniqueBinders reached
  let restored = parseCProgram (cprogramToSexp unique)
  let view (CProgram _ _ _ _ _ f) =
    map
      (m => (
        (m : CapabilityManifest).request.entry.moduleId,
        (m : CapabilityManifest).request.entry.binding,
        map (a => a.label) m.atoms,
      ))
      f.factManifests
  let expected = [("source", "dead", ["Clock"])]
  expectAll
    (map
      (p => expectEqual expected (view p))
      [lowered, reached, unique, withBinderRows [] unique, restored])

marked : String -> List String
marked source = noInlineFnNames (desugar (parse source))

test "@noinline above a signature marks the function" =
  expectEqual
    ["f"]
    (marked (joinNl ["@noinline", "f : Int -> Int", "f x = x + 1"]))

test "@noinline on a definition without a signature marks the function" =
  expectEqual ["g"] (marked (joinNl ["@noinline", "g x = x + 1"]))

test "@noinline is found under and over another attribute" =
  expectEqual
    ["h", "k"]
    (marked
      (joinNl [
        "@must_use",
        "@noinline",
        "h : Int -> Int",
        "h x = x",
        "@noinline",
        "@deprecated \"old\"",
        "k : Int -> Int",
        "k x = x",
      ]))

test "@noinline above an exported signature marks the function" =
  expectEqual
    ["e"]
    (marked (joinNl ["@noinline", "export", "e : Int -> Int", "e x = x"]))

test "other attributes and unattributed functions mark nothing" =
  expectEqual
    []
    (marked
      (joinNl [
        "@inline",
        "a : Int -> Int",
        "a x = x",
        "@must_use",
        "b : Int -> Int",
        "b x = x",
        "c : Int -> Int",
        "c x = x",
      ]))

resultFacts : String -> List MethodResultFact
resultFacts source =
  match (lowerProgramEmitWith
    emptyFacts
    (annotateProgram (desugar (parse source))))
    CProgram _ _ _ _ _ facts => facts.factMethodResults

test "method results mention only the head interface parameter" =
  expectEqual
    [
      MethodResultFact {
        iface = "Ix",
        method = "whole",
        returnsHead = True,
        callbackPositions = [],
        valueArity = 1,
      },
      MethodResultFact {
        iface = "Ix",
        method = "element",
        returnsHead = False,
        callbackPositions = [],
        valueArity = 1,
      },
    ]
    (resultFacts
      """
interface Ix c v where
  whole : c -> c
  element : c -> v
""")

test "callback facts count value parameters and retain non-head results" =
  expectEqual
    [
      MethodResultFact {
        iface = "Chain",
        method = "step",
        returnsHead = True,
        callbackPositions = [1, 2],
        valueArity = 3,
      },
    ]
    (resultFacts
      """
interface Chain c v where
  step : Num n => c -> (v -> c) -> (c -> v) -> c
""")

qualifiedInterface : String -> Decl -> Decl
qualifiedInterface origin (d@(DInterface { ... })) =
  DInterface { d | ifaceOrigin = OriginModule origin }
qualifiedInterface _ d = d

test "same-spelled interfaces retain distinct qualified result facts" =
  let left =
    map
      (qualifiedInterface "left")
      (parse "interface Shared c where\n  pick : c -> c")
  let right =
    map
      (qualifiedInterface "right")
      (parse "interface Shared c where\n  pick : c -> Int")
  expectEqual
    [
      MethodResultFact {
        iface = "left::Shared",
        method = "pick",
        returnsHead = True,
        callbackPositions = [],
        valueArity = 1,
      },
      MethodResultFact {
        iface = "right::Shared",
        method = "pick",
        returnsHead = False,
        callbackPositions = [],
        valueArity = 1,
      },
    ]
    (methodResultFacts (left ++ right))

test "lowering projects the selected entry outcome without inspecting the program" =
  let selected = EntryOutcome {
    eoMainIsUnit = True,
    eoMainIsFloat = True,
    eoMainIsAsync = True,
    eoMainAsyncPayloadIsUnit = False,
    eoAutoPrint = None,
  }
  let lowered =
    lowerProgramEmitWith { emptyFacts | pfEntryOutcome = Some selected } []
  let carried = match lowered
    CProgram _ _ _ _ _ facts => facts.factEntryOutcome
  match carried
    Some outcome => expectAll [
      expectTrue outcome.entryMainIsUnit,
      expectTrue outcome.entryMainIsFloat,
    ]
    None => fail "lowering dropped its entry outcome"

-- Both emitters size an impl's dictionary pushes from this count, so a corrupted
-- count makes the caller push a different number of words than the define binds.
test "leadingDictParams counts only the leading dict witnesses" =
  let var name = PVar name noDeclLoc noBinderId
  expectAll [
    expectEqual 0 (leadingDictParams [var "x", var "$dict_eq_0"]),
    expectEqual 2 (leadingDictParams [var "$dict_a", var "$dict_b", PWild]),
    expectEqual 1 (leadingDictParams [var "$dict_a", var "x", var "$dict_b"]),
    expectEqual 0 (leadingDictParams []),
  ]
