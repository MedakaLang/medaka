-- Unit tests for the clang profile a build's link takes (build_cmd.mdk's
-- `profileClang`): which opt flag, and whether ThinLTO detection runs.  Also
-- the static-libgc link flags (`gcStaticLibs`).

import test.{expectAll, expectEqual}
import driver.build_cmd.{BuildProfile(..), profileClang, gcStaticLibs}

test "a normal build keeps the opt level it was given and runs LTO detection" = expectAll
  [
    expectEqual ("-O2", True) (profileClang BuildNormal "-O2" ""),
    expectEqual ("-O1", True) (profileClang BuildNormal "-O1" ""),
  ]

test "a normal build ignores the probe override" =
  expectEqual ("-O2", True) (profileClang BuildNormal "-O2" "-O0")

test "a probe defaults to -O0 with no LTO" =
  expectEqual ("-O0", False) (profileClang BuildProbe "-O2" "")

test "a probe ignores the normal-build opt level when its override is unset" =
  expectEqual ("-O0", False) (profileClang BuildProbe "-O3" "")

test "an explicit -O0 probe override is the default profile, with no LTO" =
  expectEqual ("-O0", False) (profileClang BuildProbe "-O2" "-O0")

test "a probe override takes that level with LTO detection on" = expectAll [
  expectEqual ("-O2", True) (profileClang BuildProbe "-O2" "-O2"),
  expectEqual ("-O1", True) (profileClang BuildProbe "-O3" "-O1"),
]

test "the static libgc flags put the archive where -lgc was and keep its deps" =
  expectEqual
    ["/usr/lib/libgc.a", "-lpthread", "-ldl"]
    (gcStaticLibs "/usr/lib/libgc.a" ["-lgc", "-lpthread", "-ldl"])

test "the static libgc flags keep a search directory and leave other libraries" =
  expectEqual
    ["-L/opt/gc/lib", "/opt/gc/lib/libgc.a", "-lgcc"]
    (gcStaticLibs "/opt/gc/lib/libgc.a" ["-L/opt/gc/lib", "-lgc", "-lgcc"])
