{- | `analyzeToLines` over the resolve, exhaust and check_match fixture
   corpora, called in-process. Replaces the `diagnostics_main` probe row of
   `test/diff_compiler_fmt_test.mdk`.

   Each fixture's diagnostic lines are sorted and compared with its
   `.analyze.golden`, with `stdlib/runtime.mdk` and `stdlib/core.mdk` as the
   prelude pair. Does NOT cover the project-level diagnostics
   (`diagnostics_project_main`).

   The second half drives graphs through the loader (`analyzeProjectFull`)
   and reads the schemes they publish at graph end: every `stdlib/*.mdk`
   module and every `ACCEPT` fixture of `test/run_check_agreement_fixtures`
   publishes no link and no unsolved effect summary, and a value-restricted
   binding publishes its weak variable. -}

import support.ordmap.{OrdMap, omEmpty, omSize, omLookup}
import driver.diagnostics.{
  analyzeToLines, analyzeProjectFull, analyzeProjectReport, analyzeProjectKeyed,
  analyzeProjectKeyedSources, noStdlibExports, graphCheckDrive, CheckDrive(..),
  CheckDump(..), analyzeFrom, frontEnd, checkFrontDrive, FrontInput(..),
  FrontPolicy(..), FrontProgram(..), FrontOutput(..), Diag(..),
  foldCachedIdentity, resolveCachedIdentity
}
import driver.loader.{loadProgramFilesLocatedCachedSourcesE}
import support.source_index.{indexSource, offsetToUtf16Position}
import types.typecheck.{defaultDriveInputs}
import types.module_interface.{
  ModuleInterface(..), ModuleKey(..), currentModuleInterfaces
}
import frontend.ast.{Decl}
import types.tc_types.{DriveOutputs(..), emptyDriveOutputs}
import frontend.parser.{parseLocated}
import fs.{fixtureFiles}
import list.{sort, somes}
import path.{dirname, stem}
import string.{contains, endsWith, lines, trim, unlines}
import test.{
  Expectation, expectAll, expectEach, expectEqual, expectFalse, expectNotEqual,
  expectNoFindings, expectTrue, fail
}
import types.publish.{
  PubScheme(..), LiveCell(..), TcReport(..), graphCells, pubSchemes
}
import types.repr.{ppSchemeCon}
import test_process.{withScratchDir}

sortedLines : String -> String
sortedLines text = trim (unlines (sort (lines text)))

corpora : List String
corpora = [
  "test/resolve_fixtures",
  "test/exhaust_fixtures",
  "test/check_match_fixtures",
]

sourcesIn : String -> <FileRead> Result String (List String)
sourcesIn dir = match fixtureFiles dir
  Err e => Err "\{dir}: \{e}"
  Ok files => Ok (sort (filter (f => endsWith ".mdk" f) files))

allSources : List String -> <FileRead> Result String (List String)
allSources [] = Ok []
allSources (d :: rest) = match sourcesIn d
  Err e => Err e
  Ok here => map (here ++ _) (allSources rest)

failureOf : String -> String -> String -> <FileRead> Option String
failureOf rsrc csrc path = match readFile path
  Err e => Some "\{stem path}: could not read: \{e}"
  Ok src => match readFile "\{dirname path}/\{stem path}.analyze.golden"
    Err e => Some "\{stem path}: no readable golden: \{e}"
    Ok want =>
      let got = sortedLines (analyzeToLines rsrc csrc src)
      let expected = sortedLines want
      if got == expected then
        None
      else
        Some "\{stem path}: expected \{debug expected} but got \{debug got}"

check : <FileRead> Expectation
check = match readFile "stdlib/runtime.mdk"
  Err e => fail "could not read stdlib/runtime.mdk: \{e}"
  Ok rsrc => match readFile "stdlib/core.mdk"
    Err e => fail "could not read stdlib/core.mdk: \{e}"
    Ok csrc => match allSources corpora
      Err e => fail "could not list the corpora: \{e}"
      Ok srcs => expectAll [
        expectEqual 42 (length srcs),
        expectNoFindings
          "diagnostics fixtures"
          (Ok (somes (map (failureOf rsrc csrc) srcs))),
      ]

test "diagnostics: analyze output matches each fixture's .analyze.golden" =
  check

-- ── published schemes at graph end ─────────────────────────────────────────

-- Each module's published rows for the graph rooted at [entry].
graphRows : String ->
  String ->
  (String -> Option String) ->
  String ->
  List String ->
  <IO> List (String, List (String, PubScheme))
graphRows rsrc csrc read entry roots =
  let (full, _) =
    analyzeProjectFull
      noStdlibExports
      True
      []
      (Ref [])
      (Ref omEmpty)
      read
      entry
      roots
      rsrc
      csrc
  map
    (m => match m
      (mid, (schemes, _, _)) => (mid, schemes))
    full

onDisk : String -> Option String
onDisk _ = None

isLink : LiveCell -> Bool
isLink (LinkCell _ _ _) = True
isLink _ = False

isWeak : LiveCell -> Bool
isWeak (WeakVar _ _ _) = True
isWeak _ = False

isSummary : LiveCell -> Bool
isSummary (OpenSummary _ _) = True
isSummary _ = False

-- The top-level `.mdk` files of [dir] the predicate keeps, each as a graph
-- entry with its roots.
entriesIn : String ->
  List String ->
  (String -> <FileRead> Bool) ->
  <FileRead> Result String (List (String, List String))
entriesIn dir roots keep = match fixtureFiles dir
  Err e => Err "\{dir}: \{e}"
  Ok files =>
    let direct = filter (f => endsWith ".mdk" f && dirname f == dir) files
    Ok (map (f => (f, roots)) (filter keep (sort direct)))

isAccept : String -> <FileRead> Bool
isAccept path = match readFile "\{dirname path}/\{stem path}.expected"
  Ok v => trim v == "ACCEPT"
  Err _ => False

agreementDir : String
agreementDir = "test/run_check_agreement_fixtures"

-- One row per corpus graph: its entry, how many modules it published, and the
-- graph-end cells they hold.
corpusCells : String ->
  String ->
  List (String, List String) ->
  <IO> List (String, Int, List LiveCell)
corpusCells rsrc csrc entries =
  map
    (e =>
      let rows = graphRows rsrc csrc onDisk (fst e) (snd e)
      (fst e, length rows, graphCells (map snd rows)))
    entries

-- The cells [keep] selects, each under the entry of the graph that holds it.
cellsWhere : (LiveCell -> Bool) ->
  List (String, Int, List LiveCell) ->
  List String
cellsWhere keep rows =
  flatMap
    ((entry, _, cs) => map (c => "\{entry}: \{debug c}") (filter keep cs))
    rows

corpusCheck : <IO> Expectation
corpusCheck = match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
  (Ok rsrc, Ok csrc) => match (
    entriesIn "stdlib" ["stdlib"] (_ => True),
    entriesIn agreementDir [agreementDir, "stdlib"] isAccept,
  )
    (Ok stdlibEs, Ok acceptEs) =>
      let rows = corpusCells rsrc csrc (stdlibEs ++ acceptEs)
      let unloaded =
        flatMap ((entry, n, _) => if n == 0 then [entry] else []) rows
      -- Weak variables are allowed, so they are not asserted on.  An open summary
      -- withholds the checked program, so an accepted fixture holding one is a
      -- finding.
      expectEach [
        ("no published Link", expectEqual [] (cellsWhere isLink rows)),
        ("no open effect summary", expectEqual [] (cellsWhere isSummary rows)),
        ("every graph published its modules", expectEqual [] unloaded),
        ("stdlib modules driven", expectEqual 47 (length stdlibEs)),
      ]
    (Err e, _) => fail e
    (_, Err e) => fail e
  _ => fail "could not read the prelude pair"

test "graph end: the stdlib and ACCEPT corpus publishes no Link" = corpusCheck

-- A binding the value restriction leaves ungeneralized, and a second module
-- that imports and names it.
weakModule : String
weakModule = unlines [
  "export data Box a = Empty | Full a",
  "idf : a -> a",
  "idf x = x",
  "export",
  "held = idf Empty",
]

weakImporter : String
weakImporter = unlines ["import weakp.{held}", "again = held"]

renderedIn : String ->
  String ->
  List (String, List (String, PubScheme)) ->
  List String
renderedIn mid name rows =
  flatMap
    (r =>
      if fst r == mid then
        map
          (b => "\{fst b} : \{ppSchemeCon (snd b).psContext (snd b).psScheme}")
          (filter (b => fst b == name) (snd r))
      else
        [])
    rows

weakCheck : String ->
  String ->
  String ->
  <Exec, IO, FileRead, FileWrite> Expectation
weakCheck rsrc csrc dir =
  let p = "\{dir}/weakp.mdk"
  let q = "\{dir}/weakq.mdk"
  match (writeFile p weakModule, writeFile q weakImporter)
    (Ok _, Ok _) =>
      let one = graphRows rsrc csrc onDisk p [dir, "stdlib"]
      let two = graphRows rsrc csrc onDisk q [dir, "stdlib"]
      expectEach [
        (
          "one WeakVar",
          expectEqual 1 (length (filter isWeak (graphCells (map snd one)))),
        ),
        (
          "renders as before",
          expectEqual ["held : Box a"] (renderedIn "weakp" "held" one),
        ),
        (
          "a copy per scheme renders as the shared cell did",
          expectEqual
            (["held : Box a"], ["again : Box a"])
            (renderedIn "weakp" "held" two, renderedIn "weakq" "again" two),
        ),
      ]
    _ => fail "could not write the weak-variable modules"

test "graph end: held = idf Empty publishes one WeakVar and renders as Box a" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) => withScratchDir (weakCheck rsrc csrc)
    _ => fail "could not read the prelude pair"

-- ── the check drive reads its own report ───────────────────────────────────

-- The report of the one-module project holding [src].
reportOf : String ->
  String ->
  String ->
  String ->
  <IO, FileWrite> Option TcReport
reportOf rsrc csrc dir src =
  let entry = "\{dir}/main.mdk"
  match writeFile entry src
    Err _ => None
    Ok _ =>
      fst
        (analyzeProjectReport
          noStdlibExports
          True
          []
          (Ref [])
          (Ref omEmpty)
          (_ => None)
          entry
          [dir, "stdlib"]
          rsrc
          csrc)

alphaSrc : String
alphaSrc = """export
alphaOnly : Int
alphaOnly = 1
"""

betaSrc : String
betaSrc = """export
betaOnly : Int
betaOnly = 2
"""

entryNames : CheckDrive -> List String
entryNames d = sort (map fst d.cdEntrySchemes)

test "a check drive built from a report holds that report's schemes after a later drive" =
  match (
    readFile "stdlib/runtime.mdk",
    readFile "stdlib/core.mdk",
  )
    (Ok rsrc, Ok csrc) => withScratchDir (dir =>
      let a = reportOf rsrc csrc dir alphaSrc
      let b = reportOf rsrc csrc dir betaSrc
      match (a, b)
        (Some ra, Some rb) =>
          let da = graphCheckDrive ra (emptyDriveOutputs ()) [] []
          let db = graphCheckDrive rb (emptyDriveOutputs ()) [] []
          expectEach [
            ("first program", expectEqual ["alphaOnly"] (entryNames da)),
            ("second program", expectEqual ["betaOnly"] (entryNames db)),
            (
              "core schemes are the report's",
              expectEqual
                (map fst (pubSchemes ra.trPartial.paCore))
                (map fst da.cdCoreSchemes),
            ),
            (
              "core schemes are present",
              expectFalse (isEmpty da.cdCoreSchemes),
            ),
          ]
        _ => fail "a project produced no report")
    _ => fail "could not read the prelude pair"

-- ── the front end carries every verdict ────────────────────────────────────

diagText : Diag -> String
diagText (Diag _ code msg _ _ _) = "\{code}: \{msg}"

-- One single-file front-end run of [src] under `check`'s drive.
frontOfFile : String -> String -> String -> FrontOutput CheckDump
frontOfFile rsrc csrc src = frontEnd noStdlibExports (checkFrontDrive
  "main.mdk"
  []) FrontInput {
  fiInputs = defaultDriveInputs,
  fiAllowInternal = False,
  fiTrusted = [],
  fiRuntimeSrc = rsrc,
  fiCoreSrc = csrc,
  fiPolicy = NeverDriveRejected,
  fiProgram = FrontFile ("main", "main.mdk", parseLocated src),
}

test "a derive error outside the drive withholds the checked program" = match (
  readFile "stdlib/runtime.mdk",
  readFile "stdlib/core.mdk",
)
  (Ok rsrc, Ok csrc) =>
    let bad = "data T = T deriving (Frob)\n"
    let front = frontOfFile rsrc csrc bad
    let clean = frontOfFile rsrc csrc "data T = T deriving (Eq)\n"
    expectEach [
      (
        "derive error: no checked program",
        expectTrue (isNone front.foReport.trChecked),
      ),
      (
        "derive error: the diagnostics analyzeFrom reports",
        expectEqual
          (map
            diagText
            (analyzeFrom noStdlibExports "main" rsrc csrc (parseLocated bad)))
          (map diagText (flatMap snd front.foDiags)),
      ),
      ("clean control: checked", expectTrue (isSome clean.foReport.trChecked)),
    ]
  _ => fail "could not read the prelude pair"

-- ── a long import chain: no graph size evicts a module of the graph ────────

-- Module [i] of an [n]-module chain: it imports module [i + 1] and exports a
-- value built on that module's. The last file holds the chain's base case.
chainModuleSrc : Int -> Int -> String
chainModuleSrc n i =
  if i + 1 < n then
    """import m\{i + 1}.{v\{i + 1}}
export
v\{i} : Int
v\{i} = v\{i + 1} + 1
"""
  else
    """export
v\{i} : Int
v\{i} = 1
"""

chainEntry : String
chainEntry = """import m1.{v1}

main = println v1
"""

-- Writes modules [i], [i + 1], ... of the [n]-module chain beside the entry.
writeChain : String -> Int -> Int -> <FileWrite> Result String Unit
writeChain dir n i =
  if i >= n then
    writeFile "\{dir}/main.mdk" chainEntry
  else match writeFile "\{dir}/m\{i}.mdk" (chainModuleSrc n i)
    Err e => Err e
    Ok _ => writeChain dir n (i + 1)

-- One analyze of the chain's entry through the session caches: the number of
-- modules its drive served from their interfaces.
analyzeChain : String ->
  String ->
  String ->
  Ref (OrdMap (List Decl)) ->
  <IO> Int
analyzeChain rsrc csrc dir parseCache =
  let (keyed, _) =
    analyzeProjectKeyed
      noStdlibExports
      True
      []
      (Ref [])
      parseCache
      (_ => None)
      "\{dir}/main.mdk"
      [dir, "stdlib"]
      rsrc
      csrc
  match keyed
    Some ((_, outputs), _) => outputs.doServedModules
    None => -1

test "a graph of 70 modules serves every module but the entry on the second analyze" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) => withScratchDir (dir => match writeChain dir 70 1
      Ok _ =>
        let parseCache = Ref omEmpty
        let first = analyzeChain rsrc csrc dir parseCache
        let second = analyzeChain rsrc csrc dir parseCache
        expectEach [
          ("the first analyze serves nothing", expectEqual 0 first),
          (
            "the second serves the 69 modules before the entry",
            expectEqual 69 second,
          ),
          (
            "the parse memo holds the whole graph",
            expectEqual 70 (omSize !parseCache),
          ),
        ]
      Err e => fail "could not write the chain: \{e}")
    _ => fail "could not read the prelude pair"

-- ── the per-module pass caches ─────────────────────────────────────────────

-- A three-module graph: `fcm` names one constructor of `fcshapes`' type in a clause
-- function, and the entry imports both.  [second] is the type's other constructor.
foldShapesSrc : String -> String
foldShapesSrc second = "public export data Shape = Circle Int | \{second} Int\n"

foldMidSrc : String
foldMidSrc = unlines [
  "import fcshapes.{Shape(..)}",
  "export",
  "area : Shape -> Int",
  "area (Circle r) = r",
]

foldMainSrc : String
foldMainSrc = unlines [
  "import fcm.{area}",
  "import fcshapes.{Shape(..)}",
  "main = println (debug (area (Circle 2)))",
]

-- One analyze of the entry in [dir], [read] answering before the disk: `fcm`'s
-- diagnostics, and the identities the fold's and the resolve pass's caches hold for
-- `fcm` afterwards.
foldAnalyze : String ->
  String ->
  String ->
  (String -> Option String) ->
  <IO> (List String, (Option Int, Option Int))
foldAnalyze rsrc csrc dir read =
  let (_, buckets) =
    analyzeProjectKeyed
      noStdlibExports
      True
      []
      (Ref [])
      (Ref omEmpty)
      read
      "\{dir}/fcmain.mdk"
      [dir, "stdlib"]
      rsrc
      csrc
  (
    map
      diagText
      (flatMap snd (filter (b => endsWith "/fcm.mdk" (fst b)) buckets)),
    (foldCachedIdentity "fcm", resolveCachedIdentity "fcm"),
  )

-- `fcshapes` with its second constructor renamed, the disk for every other file.
renamedShapes : String -> Option String
renamedShapes path =
  if endsWith "/fcshapes.mdk" path then Some (foldShapesSrc "Rect") else None

missingClause : String -> String
missingClause ctor =
  "W-NONEXHAUSTIVE-CLAUSES: non-exhaustive clauses of `area`: missing `\{ctor} _`; add a `\{ctor} _` clause"

foldCacheCheck : String -> String -> String -> <IO, FileWrite> Expectation
foldCacheCheck rsrc csrc dir = match (
  writeFile "\{dir}/fcshapes.mdk" (foldShapesSrc "Square"),
  writeFile "\{dir}/fcm.mdk" foldMidSrc,
  writeFile "\{dir}/fcmain.mdk" foldMainSrc,
)
  (Ok _, Ok _, Ok _) =>
    let (cold, coldId) = foldAnalyze rsrc csrc dir (_ => None)
    let (served, servedId) = foldAnalyze rsrc csrc dir (_ => None)
    let (renamed, renamedId) = foldAnalyze rsrc csrc dir renamedShapes
    expectEach [
      (
        "the first analyze folds fcm",
        expectEqual [missingClause "Square"] cold,
      ),
      ("fcm has a fold entry", expectTrue (isSome (fst coldId))),
      ("fcm has a resolve entry", expectTrue (isSome (snd coldId))),
      (
        "the second analyze serves both of fcm's entries",
        expectEqual coldId servedId,
      ),
      ("the served diagnostics are the computed ones", expectEqual cold served),
      (
        "a renamed constructor in fcm's import refolds fcm",
        expectNotEqual (fst coldId) (fst renamedId),
      ),
      (
        "and resolves fcm again",
        expectNotEqual (snd coldId) (snd renamedId),
      ),
      (
        "fcm reports the import's new constructor",
        expectEqual [missingClause "Rect"] renamed,
      ),
    ]
  _ => fail "could not write the fold fixture"

test "the pass caches serve an unchanged module and recompute it when its import's constructors change" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) => withScratchDir (foldCacheCheck rsrc csrc)
    _ => fail "could not read the prelude pair"

-- ── the caches hold the graph last analyzed ────────────────────────────────

-- One analyze of the project whose entry is [entry] in [dir]: every file's
-- diagnostics as `<file stem> <code>: <message>`, sorted, and the number of
-- modules the drive served from their interfaces.
analyzeEntry : String -> String -> String -> String -> <IO> (List String, Int)
analyzeEntry rsrc csrc dir entry =
  let (keyed, buckets) =
    analyzeProjectKeyed
      noStdlibExports
      True
      []
      (Ref [])
      (Ref omEmpty)
      (_ => None)
      "\{dir}/\{entry}.mdk"
      [dir, "stdlib"]
      rsrc
      csrc
  (
    sort
      (flatMap
        (b => map (d => "\{stem (fst b)} \{diagText d}") (snd b))
        buckets),
    match keyed
      Some ((_, outputs), _) => outputs.doServedModules
      None => -1,
  )

-- The module ids the interface cache holds.
cachedInterfaceIds : Unit -> List String
cachedInterfaceIds _ =
  sort (map (mi => mi.miKey.mkModule) (currentModuleInterfaces ()))

-- A library and an entry that imports it, under module ids that begin with [p].
-- The library's incomplete clause function leaves a warning to serve.
writeLibPair : String -> String -> <FileWrite> Result String Unit
writeLibPair dir p =
  match (writeFile
    "\{dir}/\{p}lib.mdk"
    """public export data Shape = Circle Int | Square Int

export
area : Shape -> Int
area (Circle r) = r
""")
    Err e => Err e
    Ok _ =>
      writeFile
        "\{dir}/\{p}main.mdk"
        """import \{p}lib.{area, Shape(..)}

main = println (area (Circle 1))
"""

cacheBoundCheck : String -> String -> String -> <IO, FileWrite> Expectation
cacheBoundCheck rsrc csrc dir = match (
  writeLibPair dir "ca",
  writeLibPair dir "cb",
)
  (Ok _, Ok _) =>
    let _ = analyzeEntry rsrc csrc dir "camain"
    let afterFirst = cachedInterfaceIds ()
    let (_, firstServed) = analyzeEntry rsrc csrc dir "cbmain"
    let afterSecond = cachedInterfaceIds ()
    let (_, repeatServed) = analyzeEntry rsrc csrc dir "cbmain"
    expectEach [
      ("the first graph records its library", expectEqual ["calib"] afterFirst),
      ("the second graph serves nothing", expectEqual 0 firstServed),
      (
        "the interface cache holds the second graph's ids only",
        expectEqual ["cblib"] afterSecond,
      ),
      (
        "the first graph's pass entries are gone",
        expectEqual
          (None, None)
          (foldCachedIdentity "calib", resolveCachedIdentity "calib"),
      ),
      (
        "the second graph's pass entries are held",
        expectEqual
          (True, True)
          (
            isSome (foldCachedIdentity "cblib"),
            isSome (resolveCachedIdentity "cblib"),
          ),
      ),
      (
        "a repeated analyze of one graph serves its library",
        expectEqual 1 repeatServed,
      ),
      (
        "and keeps the cache as it was",
        expectEqual afterSecond (cachedInterfaceIds ()),
      ),
    ]
  _ => fail "could not write the cache fixtures"

test "an analyze keeps the cached interfaces and pass entries of its own graph only" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) => withScratchDir (cacheBoundCheck rsrc csrc)
    _ => fail "could not read the prelude pair"

-- ── a rejected graph records what a later accepted graph may serve ─────────

-- Modules [p]a and [p]c share nothing with [p]b, which the entry imports with
-- all three.  A rejected graph's drive covers [p]a and [p]c, and takes the last of
-- them for its entry, so only [p]a records.  [p]a leaves a warning to serve.  [bBody] is [p]b's value; with
-- [declaresImpl] it also declares an interface and an impl, which every other
-- module's key reads (the graph part of the key holds each module's instance heads).
writeRejectable : String ->
  String ->
  Bool ->
  String ->
  <FileWrite> Result String Unit
writeRejectable dir p declaresImpl bBody =
  let bSrc =
    if declaresImpl then
      """export interface Speak a where
  speak : a -> String

impl Speak Bool where
  speak _ = "b"

export
bval : Int
bval = \{bBody}
"""
    else
      """export
bval : Int
bval = \{bBody}
"""
  match (
    writeFile
      "\{dir}/\{p}a.mdk"
      """public export data Shape = Circle Int | Square Int

export
area : Shape -> Int
area (Circle r) = r
""",
    writeFile "\{dir}/\{p}b.mdk" bSrc,
    writeFile "\{dir}/\{p}c.mdk" """export
cval : Int
cval = 2
""",
    writeFile
      "\{dir}/\{p}main.mdk"
      """import \{p}a.{area, Shape(..)}
import \{p}b.{bval}
import \{p}c.{cval}

main = println (area (Circle 1) + bval + cval)
""",
  )
    (Ok _, Ok _, Ok _, Ok _) => Ok ()
    _ => Err "could not write the rejectable graph"

-- Analyzes the graph with [p]b undefined-name-rejected, fixes it, analyzes again,
-- evicts the caches with an unrelated graph, and analyzes the fixed graph cold:
-- (the rejected run's lines, the second run, the cold run).
rejectedThenFixed : String ->
  String ->
  String ->
  String ->
  Bool ->
  <IO, FileWrite> Option ((List String, Int), (List String, Int))
rejectedThenFixed rsrc csrc dir p declaresImpl = match (
  writeRejectable dir p declaresImpl "notDefinedAnywhere",
  writeLibPair dir "ev",
)
  (Ok _, Ok _) =>
    let (rejected, _) = analyzeEntry rsrc csrc dir "\{p}main"
    match writeRejectable dir p declaresImpl "3"
      Err _ => None
      Ok _ =>
        let second = analyzeEntry rsrc csrc dir "\{p}main"
        let _ = analyzeEntry rsrc csrc dir "evmain"
        let cold = analyzeEntry rsrc csrc dir "\{p}main"
        if isEmpty (filter (l => contains "R-UNBOUND" l) rejected) then
          None
        else
          Some (second, cold)
  _ => None

rejectedGraphCheck : String -> String -> String -> <IO, FileWrite> Expectation
rejectedGraphCheck rsrc csrc dir = match (
  rejectedThenFixed rsrc csrc dir "pa" False,
  rejectedThenFixed rsrc csrc dir "pb" True,
)
  (Some (plainSecond, plainCold), Some (implSecond, implCold)) => expectEach [
    (
      "without an impl in the rejected module, the second drive serves the first independent module",
      expectEqual 1 (snd plainSecond),
    ),
    (
      "and prints what a cold analyze prints",
      expectEqual (fst plainCold) (fst plainSecond),
    ),
    (
      "the independent module's warning is among the lines",
      expectTrue (any (l => contains "W-NONEXHAUSTIVE" l) (fst plainSecond)),
    ),
    (
      "with an impl in the rejected module, the second drive serves neither",
      expectEqual 0 (snd implSecond),
    ),
    (
      "and prints what a cold analyze prints",
      expectEqual (fst implCold) (fst implSecond),
    ),
  ]
  _ => fail "the rejected graph did not reject, or could not be written"

test "a graph recorded while another module was rejected serves what a cold analyze prints" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) => withScratchDir (rejectedGraphCheck rsrc csrc)
    _ => fail "could not read the prelude pair"

sourceSnapshotChecks : String -> <IO, FileWrite> Expectation
sourceSnapshotChecks dir =
  let entry = dir ++ "/main.mdk"
  let dep = dir ++ "/dep.mdk"
  let good = """import dep
main = 1
"""
  let astral = "export value = \"😀\"\n"
  match (writeFile entry good, writeFile dep astral)
    (Ok _, Ok _) =>
      let cache = Ref omEmpty
      let (first, sources) =
        loadProgramFilesLocatedCachedSourcesE cache (_ => None) entry [dir]
      let (again, same) =
        loadProgramFilesLocatedCachedSourcesE cache (_ => None) entry [dir]
      let _ = removeFile dep
      let (missing, missingSources) =
        loadProgramFilesLocatedCachedSourcesE cache (_ => None) entry [dir]
      let broken = "main = (\n"
      let (bad, badSources) =
        loadProgramFilesLocatedCachedSourcesE
          cache
          (p => if p == entry then Some broken else None)
          entry
          [dir]
      expectEach [
        ("success", expectTrue (isOk first)),
        ("entry captured", expectEqual (Some good) (omLookup entry sources)),
        ("astral captured", expectEqual (Some astral) (omLookup dep sources)),
        (
          "captured astral position after deletion",
          expectEqual
            (Some (0, 19))
            (map
                (src => offsetToUtf16Position (indexSource src) 18)
                (omLookup dep sources)
              |> optionOr None),
        ),
        ("repeated", expectTrue (isOk again)),
        ("repeated source", expectEqual (Some astral) (omLookup dep same)),
        ("missing dependency", expectTrue (isErr missing)),
        (
          "entry on failure",
          expectEqual (Some good) (omLookup entry missingSources),
        ),
        ("no stale dependency", expectEqual None (omLookup dep missingSources)),
        ("parse failure", expectTrue (isErr bad)),
        ("broken source", expectEqual (Some broken) (omLookup entry badSources)),
      ]
    _ => fail "could not write snapshot fixture"

test "loader snapshots contain only current parsed sources on success and failure" =
  withScratchDir sourceSnapshotChecks

analysisSnapshotChecks : String ->
  String ->
  String ->
  <IO, FileWrite> Expectation
analysisSnapshotChecks rsrc csrc dir =
  let entry = dir ++ "/main.mdk"
  let dep = dir ++ "/dep.mdk"
  let entrySrc = """import dep
main = 1
"""
  let depSrc = "export value = \"😀\"\n"
  match (writeFile entry entrySrc, writeFile dep depSrc)
    (Ok _, Ok _) =>
      let cache = Ref []
      let parseCache = Ref omEmpty
      let (_, oldBuckets) =
        analyzeProjectKeyed
          noStdlibExports
          True
          []
          (Ref [])
          (Ref omEmpty)
          (_ => None)
          entry
          [dir, "stdlib"]
          rsrc
          csrc
      let (keyed, newBuckets, sources) =
        analyzeProjectKeyedSources
          noStdlibExports
          True
          []
          cache
          parseCache
          (_ => None)
          entry
          [dir, "stdlib"]
          rsrc
          csrc
      let _ = removeFile dep
      let (failed, buckets, failedSources) =
        analyzeProjectKeyedSources
          noStdlibExports
          True
          []
          cache
          parseCache
          (_ => None)
          entry
          [dir, "stdlib"]
          rsrc
          csrc
      expectEach [
        ("success", expectTrue (isSome keyed)),
        (
          "unchanged diagnostics",
          expectEqual
            (map (b => (fst b, map diagText (snd b))) oldBuckets)
            (map (b => (fst b, map diagText (snd b))) newBuckets),
        ),
        (
          "captured dependency",
          expectEqual (Some depSrc) (omLookup dep sources),
        ),
        ("failure", expectTrue (isNone failed)),
        ("failure keeps diagnostics", expectTrue (length buckets > 0)),
        (
          "entry on failure",
          expectEqual (Some entrySrc) (omLookup entry failedSources),
        ),
        (
          "no previous dependency",
          expectEqual None (omLookup dep failedSources),
        ),
      ]
    _ => fail "could not write analysis snapshot fixture"

test "project diagnostic snapshots are scoped to each analysis" = match (
  readFile "stdlib/runtime.mdk",
  readFile "stdlib/core.mdk",
)
  (Ok rsrc, Ok csrc) => withScratchDir (analysisSnapshotChecks rsrc csrc)
  _ => fail "could not read prelude"
