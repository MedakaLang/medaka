import backend.emit_plan.{
  buildEmitPlanWithIdentity, prepareWasmPlanWithIdentity
}
import backend.llvm_emit.{emitProgram as llvmEmit, makeEmitInput}
import backend.wasm_emit.{emitProgram as wasmEmit, makeWasmEmitInput}
import support.ordmap.{omEmpty}
import test.{pass}
