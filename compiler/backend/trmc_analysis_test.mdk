-- Structural regressions for the Core free-variable walk used by shared TRMC
-- analysis and LLVM closure capture.

import test.{Expectation, expectAll, expectEqual}
import frontend.ast.{
  Addr(..), Lit(..), Loc(..), Pat(..), Route(..), noDeclLoc, noBinderId
}
import ir.core_ir.{
  CBind(..),
  CClause(..),
  CExpr(..),
  MethodEvidence(..),
  mkApp,
  synthBind,
}
import backend.trmc_analysis.{SelfRef(..), freeVars, trmcEligible}

loc : Loc
loc = Loc "" 1 0 1 0

multiClauseGroup : CExpr
multiClauseGroup =
  CLetGroup
    [
      synthBind "g" [
        CClause
          [PVar "p" loc noBinderId]
          (CTuple [
            CVar "outer" AGlobal,
            CVar "p" AGlobal,
            CVar "g" AGlobal,
            CMethod
              "add"
              (MethodEvidence "" 2 (RDict "$d0") [] [RDictFwd "$d1"]),
          ]),
        CClause
          [PVar "q" loc noBinderId]
          (CTuple [
            CVar "q" AGlobal,
            CVar "g" AGlobal,
            CVar "p" AGlobal,
            CVar "secondOuter" AGlobal,
          ]),
      ],
    ]
    (mkApp (CVar "g" AGlobal) [CVar "after" AGlobal])

test "freeVars visits every let-group clause with lexical subtraction" = expectAll
  [
    expectEqual
      ["outer", "$d0", "$d1", "p", "secondOuter", "after"]
      (freeVars [] multiClauseGroup),
    expectEqual
      ["$d1", "p", "secondOuter", "after"]
      (freeVars ["outer", "$d0"] multiClauseGroup),
  ]

helperBind : CExpr -> CBind
helperBind innerBody = synthBind "helper" [
  CClause
    [PWild]
    (CLetGroup
      [synthBind "inner" [CClause [PWild] innerBody]]
      (mkApp (CVar "inner" AGlobal) [CLit LUnit])),
]

trmcBody : CExpr -> CExpr
trmcBody innerBody =
  CLetGroup
    [helperBind innerBody]
    (CBinPrim
      "::"
      (CLit (LInt 1))
      (mkApp (CVar "loop" AGlobal) [CVar "xs" AGlobal])
      ""
      noDeclLoc)

trmcEligibleWith : Bool -> CExpr -> Expectation
trmcEligibleWith expected innerBody =
  expectEqual
    expected
    (trmcEligible
      (_ => False)
      (_ => 0)
      (SelfByVar "loop")
      1
      [([PVar "xs" loc noBinderId], trmcBody innerBody)])

test "TRMC rejects a hidden self-call but keeps an ordinary capture eligible" = expectAll
  [
    trmcEligibleWith True (CVar "xs" AGlobal),
    trmcEligibleWith False (mkApp (CVar "loop" AGlobal) [CVar "xs" AGlobal]),
  ]
