import string.{replaceAll, contains, unlines}
import test.{expectEach, expectTextContainsAll, expectFalse, fail}
import test_process.{withScratchDir, boundedVerbSeconds, medakaRoot}
import driver.build_cmd.{
  runBuildNativeRoots, BuildProfile(..), ppBuildReport, envOr
}
import types.capability_manifest.{
  ManifestRequirement(..), EntryKey(..), InvocationProtocol(..)
}
import backend.emit_plan.{prepareWasmPlan}
import support.ordmap.{omEmpty}
-- Each emitter refuses a program with a binder its binder table has no row for,
-- before it emits anything, through `core_validate.validateForEmission`.
-- The refusal is a panic, which
-- no test observes in its own process, so each case runs this file's probe test
-- in a child `medaka test` with `MEDAKA_BINDER_REFUSAL_PROBE` naming the backend,
-- and grades the child's exit and output.  In an ordinary run the probe passes
-- without emitting.

import backend.extern_catalog.{RuntimeExternDomain(..)}
import backend.emit_target.{Backend(..)}
import test.{
  Expectation, expectAll, expectEqual, expectNotEqual, labelFail, pass
}
import test_process.{expectSpawnFails, medakaBin, underRoot}
import frontend.ast.{BinderId(..), Lit(..), Pat(..), Addr(..), noDeclLoc}
import ir.core_ir.{
  CBind(..),
  CClause(..),
  CExpr(..),
  CProgram(..),
  CallMode(..),
  CallSite(..),
  DeclFacts(..),
  noDeclFacts,
}
import types.runtime_types.{BinderRow(..), RuntimeType(..)}
import backend.core_validate.{validateBinderStamps}
import backend.emit_plan.{buildEmitPlan}

import backend.llvm_emit.{emitProgram as llvmEmit, makeEmitInput}
import backend.wasm_emit.{emitProgram as wasmEmit, makeWasmEmitInput}
import backend.llvm_symbols.{defectMessage as llvmDefectMessage}
import backend.wasm_symbols.{defectMessage as wasmDefectMessage}

probeVar : String
probeVar = "MEDAKA_BINDER_REFUSAL_PROBE"

row : String -> Int -> RuntimeType -> Option RuntimeType -> BinderRow
row name n ty ret = BinderRow {
  brId = BinderId "m" n,
  brName = name,
  brType = ty,
  brReturns = ret,
  brSigned = False,
}

-- `f x = x` and `main = f 1`, with a row for `f` and `main` and, when
-- [paramRow], for `x`.
program : Bool -> CProgram
program paramRow =
  CProgram
    [
      CBind
        "f"
        [CClause [PVar "x" noDeclLoc (BinderId "m" 3)] (CVar "x" (ALocal 0 0))]
        noDeclLoc
        (BinderId "m" 1),
      CBind
        "main"
        [
          CClause
            []
            (CApp (CVar "f" AGlobal) [CLit (LInt 1)] (CallSite CallExact False)),
        ]
        noDeclLoc
        (BinderId "m" 2),
    ]
    []
    []
    []
    []
    DeclFacts {
      factSymbolOrigins = None,
      factMethodResults = [],
      factRequires = [],
      factSupers = [],
      factEntryOutcome = None,
      factExterns = noDeclFacts.factExterns,
      factManifests = [],
      factBinders =
        [row "f" 1 RTValue (Some RTInt), row "main" 2 RTInt (Some RTInt)]
          ++ (if paramRow then [row "x" 3 RTInt None] else []),
    }

llvmText : CProgram -> String
llvmText cp = llvmFor RawUnchecked cp

llvmFor : ManifestRequirement -> CProgram -> String
llvmFor requirement cp =
  let emitted =
    llvmEmit
      (makeEmitInput requirement PreludeFreeRuntime [] [] 0 [] [] "")
      (buildEmitPlan LlvmBackend PreludeFreeRuntime cp)
      cp
  match emitted
    Ok text => text
    Err defects =>
      panic ("emit refused: " ++ unlines (map llvmDefectMessage defects))

wasmText : CProgram -> String
wasmText cp = wasmFor RawUnchecked cp

wasmFor : ManifestRequirement -> CProgram -> String
wasmFor requirement cp =
  let (plan, prepared) = prepareWasmPlan PreludeFreeRuntime omEmpty cp
  match (wasmEmit
    (makeWasmEmitInput requirement PreludeFreeRuntime [])
    plan
    prepared)
    Ok wat => wat
    Err defects =>
      panic ("emit refused: " ++ unlines (map wasmDefectMessage defects))

-- What the refusal says about `x`.
refusal : String
refusal = "internal error: binder: x has no stamped type [in f]"

test "the hand-built program lacks exactly the row for x" = expectAll [
  labelFail
    "without it"
    (expectEqual
      ["binder: x has no stamped type [in f]"]
      (validateBinderStamps (program False))),
  labelFail "with it" (expectEqual [] (validateBinderStamps (program True))),
]

test "both emitters emit the program once x has its row" = expectAll [
  labelFail "llvm" (expectNotEqual "" (llvmText (program True))),
  labelFail "wasm" (expectNotEqual "" (wasmText (program True))),
]

-- The probe: under `MEDAKA_BINDER_REFUSAL_PROBE`, the backend it names emits the
-- program without `x`'s row.  Passing means the emitter did not refuse.
test "probe: emit with an unstamped binder" = match getEnv probeVar
  Some "manifest-llvm" =>
    expectNotEqual
      ""
      (llvmFor
        (CheckedEntry
          EntryKey { moduleId = "m", binding = "main" }
          ExecutedMain)
        (program True))
  Some "manifest-wasm" =>
    expectNotEqual
      ""
      (wasmFor
        (CheckedEntry
          EntryKey { moduleId = "m", binding = "main" }
          ExecutedMain)
        (program True))
  Some "llvm" => expectNotEqual "" (llvmText (program False))
  Some "wasm" => expectNotEqual "" (wasmText (program False))
  _ => pass

-- [backend]'s probe run, which must fail with the refusal.
refusedBy : String -> <Exec "env", IO> Expectation
refusedBy backend =
  expectSpawnFails
    "env"
    [
      "\{probeVar}=\{backend}",
      medakaBin,
      "test",
      "--filter",
      "probe:",
      underRoot "compiler/backend/emit_binder_refusal_test.mdk",
    ]
    refusal

test "the llvm emitter refuses a binder with no stamped type" = refusedBy "llvm"

test "the wasm emitter refuses a binder with no stamped type" = refusedBy "wasm"

test "both renderers refuse paired manifest omission against an external checked requirement" =
  expectAll
    (map
      (backend =>
        expectSpawnFails
          "env"
          [
            "\{probeVar}=manifest-\{backend}",
            medakaBin,
            "test",
            "--filter",
            "probe:",
            underRoot "compiler/backend/emit_binder_refusal_test.mdk",
          ]
          "manifest: missing checked entry manifest")
      ["llvm", "wasm"])

playgroundMutationHelpers : String
playgroundMutationHelpers =
  """
import ir.core_ir.{CProgram(..), DeclFacts(..)}
import backend.emit_plan.{EmitPlan(..)}
import types.capability_manifest.{CapabilityManifest(..), ManifestRequest(..), InvocationProtocol(..), FrozenAtom(..), FrozenAuthority(..)}
import types.effect_domain.{Param(..)}
import frontend.ast.{TyConOrigin(..)}

manifestMutation : <Env> String
manifestMutation = optionOr "valid" (getEnv "MEDAKA_MANIFEST_VICTIM")

mutatePublished : CapabilityManifest -> <Env> CapabilityManifest
mutatePublished m = match manifestMutation
  "wrong-binding" => { m | request = { m.request | entry = { m.request.entry | binding = "neighbor" } } }
  "wrong-module" => { m | request = { m.request | entry = { m.request.entry | moduleId = "unrelated" } } }
  "wrong-protocol" => { m | request = { m.request | protocol = HostInvocation }, atoms = [] }
  "malformed" => { m | atoms = [FrozenAtom { label = "Stdout", origin = OriginBuiltin, domainTop = PUnit, authority = FrozenConst (PPrefix None) }] }
  _ => m

mutateCore : CProgram -> <Env> CProgram
mutateCore (CProgram binds ca ct impls mc facts) =
  let manifests = if manifestMutation == "core-missing" || manifestMutation == "both-missing" then [] else map mutatePublished facts.factManifests
  CProgram binds ca ct impls mc { facts | factManifests = manifests }

mutatePlan : ManifestRequirement -> EmitPlan -> <Env> EmitPlan
mutatePlan requirement plan = match (manifestMutation, requirement)
  ("core-missing", CheckedEntry key protocol) => { plan | manifestIndex = [ManifestRequest { entry = key, protocol = protocol }] }
  ("plan-missing", _) => { plan | manifestIndex = [] }
  _ => plan
"""

playgroundMutationSource : String -> String
playgroundMutationSource source =
  playgroundMutationHelpers
    ++ (source
      |> replaceAll
        "  let lowered = lowerProgramEmitWith facts allDecls"
        "  let lowered = mutateCore (lowerProgramEmitWith facts allDecls)"
      |> replaceAll "  let (plan, reached) =" "  let (originalPlan, reached) ="
      |> replaceAll
        "      lowered\n  if emit then"
        "      lowered\n  let plan = mutatePlan requirement originalPlan\n  if emit then")

playgroundMutationRows : List (String, String)
playgroundMutationRows = [
  ("core-missing", "manifest: missing checked entry manifest"),
  ("plan-missing", "manifest: emit plan projection disagrees with Core"),
  ("both-missing", "manifest: missing checked entry manifest"),
  ("wrong-binding", "manifest: wrong binding for checked entry"),
  ("wrong-module", "manifest: wrong module for checked entry"),
  ("wrong-protocol", "manifest: wrong invocation protocol for checked entry"),
  ("malformed", "manifest: constant domain mismatch"),
]

playgroundResult : String ->
  String ->
  String ->
  String ->
  String ->
  <IO, Exec> Result String (Int, String, String)
playgroundResult binary entry dir mode victim = boundedVerbSeconds 90 "env" [
  "MEDAKA_STRICT=1",
  "MEDAKA_MANIFEST_VICTIM=" ++ victim,
  binary,
  mode,
  underRoot "stdlib/runtime.mdk",
  underRoot "stdlib/core.mdk",
  entry,
  dir,
  underRoot "stdlib",
]

playgroundRefusal : String ->
  String ->
  String ->
  String ->
  (String, String) ->
  <IO, Exec> Expectation
playgroundRefusal binary entry dir mode (victim, needle) =
  match playgroundResult binary entry dir mode victim
    Err e => fail e
    Ok (code, out, err) =>
      let _ = match getEnv "MEDAKA_MANIFEST_MATRIX_DIR"
        Some reports =>
          writeFile
            "\{reports}/playground-\{mode}-\{victim}.txt"
            "exit=\{code}\nstdout:\n\{out}\nstderr:\n\{err}"
        None => Ok ()
      expectAll [
        expectNotEqual 0 code,
        expectTextContainsAll [needle] (out ++ err),
        expectFalse (contains "__MEDAKA_WAT" out),
        expectFalse (contains "__MEDAKA_ANALYZE__" out),
        expectFalse (contains "(module" out),
      ]

playgroundControl : String ->
  String ->
  String ->
  String ->
  <IO, Exec> Expectation
playgroundControl binary entry dir mode =
  match playgroundResult binary entry dir mode "valid"
    Err e => fail e
    Ok (code, out, err) => expectAll [
      expectEqual 0 code,
      expectEqual "" err,
      expectTextContainsAll
        (if mode == "compile" then
          ["__MEDAKA_WAT__", "(module"]
        else
          ["__MEDAKA_ANALYZE__", "{\"files\":[]}"])
        out,
      expectFalse (contains "__MEDAKA_DIAGNOSTICS__" out),
    ]

test "real playground compile and analyze reject checked corruption before either success marker" = withScratchDir
  (dir =>
    let original = underRoot "compiler/entries/playground_main.mdk"
    let probe = dir ++ "/playground_manifest_probe.mdk"
    let binary = dir ++ "/playground_manifest_probe"
    let entry = dir ++ "/entry.mdk"
    match readFile original
      Err e => fail e
      Ok source =>
        if not
          (contains "  let lowered = lowerProgramEmitWith facts allDecls" source
            && contains "      lowered\n  if emit then" source) then
          fail "playground mutation insertion points moved"
        else match (
          writeFile probe (playgroundMutationSource source),
          writeFile entry """
main : Float
main = 6.0
""",
        )
          (Err e, _) => fail e
          (_, Err e) => fail e
          _ =>
            match (runBuildNativeRoots
              medakaRoot
              medakaBin
              (envOr "CC" "clang")
              probe
              binary
              dir
              False
              [underRoot "compiler"]
              True
              False
              False
              BuildProbe)
              Err report =>
                fail ("playground probe build failed: " ++ ppBuildReport report)
              Ok _ =>
                expectEach
                  (flatMap
                    (mode =>
                      (
                          mode ++ "/valid",
                          playgroundControl binary entry dir mode,
                        )
                        :: map
                          (row => (
                            mode ++ "/" ++ fst row,
                            playgroundRefusal binary entry dir mode row,
                          ))
                          playgroundMutationRows)
                    ["compile", "analyze"]))
