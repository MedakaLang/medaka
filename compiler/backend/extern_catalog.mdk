  ExternRow
    "writeFileBytes"
    (CSymbol LlvmFile "mdk_write_file_bytes")
    (Inline WasmLeaf)
    Interpreted,
  ExternRow
    "writeFileMode"
    (CSymbol LlvmFile "mdk_write_file_mode")
    (Inline WasmLeaf)
    Interpreted,
  ExternRow
