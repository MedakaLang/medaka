-- Sibling test module for `compiler/backend/core_validate.mdk` ([P-TEST-SIBLING]).
--
-- Each program is prelude-free and lowered without typechecking, through the
-- pipeline `compiler/entries/wasm_emit_main.mdk` and
-- `compiler/entries/llvm_emit_main.mdk` use, so a reference to a runtime extern
-- reaches the checked program exactly as the source spells it.

import test.{
  Expectation,
  expectAll,
  expectEach,
  expectEqual,
  expectTextContainsAll,
  labelFail,
}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import types.annotate.{annotateProgram}
import types.typecheck.{elaborateOne, grantWholeDomain}
import ir.core_ir.{
  CBind(..),
  CClause(..),
  CExpr(..),
  CField(..),
  CImplBody(..),
  CImplEntry(..),
  MethodEvidence(..),
  CProgram(..),
  DeclFacts(..),
  noDeclFacts,
  noImplSym,
  CStmt(..),
  CallMode(..),
  CallSite(..),
}
import frontend.ast.{Lit(..), Pat(..), Route(..), noDeclLoc}
import ir.core_ir_lower.{
  EmitTarget(..),
  ctorFieldTypeNames,
  declSigTypeNames,
  declaredRecordFieldOrders,
  lowerProgramEmit,
}
import backend.extern_catalog.{catalogRow, ledgerEntry, rowLlvm, rowWasm}
import backend.core_validate.{
  Backend(..),
  CheckedTarget,
  checkedTargetOf,
  findingExtern,
  missingCatalogRows,
  missingRowsMessage,
  renderExternFinding,
  renderExternRefusalUnder,
  validateCalls,
  validateDispatchEvidence,
  validateExterns,
  validateImplSymbols,
  validateMethodContexts,
  validateRecords,
  validateTails,
}
import backend.wasm_emit.{
  emitProgramGaps,
  emitProgramRecord as wasmRecord,
  makeWasmEmitInputFull,
}
import backend.llvm_emit.{emitProgramRecord as llvmRecord, makeEmitInput}
import types.target_profile.{lookupProfile}
import test_process.{underRoot}

lowered : EmitTarget -> String -> CProgram
lowered target src =
  lowerProgramEmit
    target
    (annotateProgram (grantWholeDomain (desugar (parse src))))

-- The extern names `backend` refuses in `src`, in order of first reference.
refused : Backend -> String -> List String
refused LlvmBackend src =
  map findingExtern (validateExterns LlvmBackend [] (lowered TargetNative src))
refused WasmBackend src =
  map findingExtern (validateExterns WasmBackend [] (lowered TargetWasm src))

refusalLines : Backend -> String -> List String
refusalLines LlvmBackend src =
  map
    renderExternFinding
    (validateExterns LlvmBackend [] (lowered TargetNative src))
refusalLines WasmBackend src =
  map
    renderExternFinding
    (validateExterns WasmBackend [] (lowered TargetWasm src))

-- The reason the extern's wasm or llvm row gives, as the row states it.
wasmReason : String -> String
wasmReason name = match catalogRow name
  Some r => match ledgerEntry (rowWasm r)
    Some (_, why) => why
    None => ""
  None => ""

llvmReason : String -> String
llvmReason name = match catalogRow name
  Some r => match ledgerEntry (rowLlvm r)
    Some (_, why) => why
    None => ""
  None => ""

test "(a) wasm: a reference to a net extern is refused, naming extern, backend, kind and reason" =
  expectEqual
    [
      "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in main]",
    ]
    (refusalLines WasmBackend "main = netTcpConnect \"localhost\" 80")

test "(b) wasm: references to WASM-GAP externs are refused, applied or as values, each in its binding" =
  expectEqual
    [
      "wasm: runtime extern 'writeFile' is not available on the wasm backend (WASM-GAP: \{wasmReason "writeFile"}) [in save]",
      "wasm: runtime extern 'listDir' is not available on the wasm backend (WASM-GAP: \{wasmReason "listDir"}) [in main]",
    ]
    (refusalLines
      WasmBackend
      "save = writeFile\nmain =\n  let _ = save \"a\" \"b\"\n  listDir \".\"")

test "(c) wasm: a program that names an extern only as text, a field or a lowered extern is not refused" =
  expectEqual
    []
    (refused
      WasmBackend
      "data Conn = Conn { netSend : Int }\nmain =\n  let c = Conn { netSend = 1 }\n  putStrLn (\"netSend\" ++ intToString c.netSend)")

test "(d) a local binder or a program binding named like a refused extern shadows it, in its scope only" = expectEach
  [
    (
      "lambda parameter",
      expectEqual
        []
        (refused WasmBackend "main = (writeFile => writeFile 1) (x => x)"),
    ),
    (
      "let binding",
      expectEqual
        []
        (refused WasmBackend "main =\n  let netSend = 3\n  netSend + 1"),
    ),
    (
      "match arm",
      expectEqual
        []
        (refused
          WasmBackend
          "main = match Some 1\n  Some listDir => listDir\n  None => 0"),
    ),
    (
      "top-level binding",
      expectEqual [] (refused WasmBackend "readLine x = x\nmain = readLine 3"),
    ),
    (
      "the extern outside its shadow's scope",
      expectEqual
        ["makeDir"]
        (refused
          WasmBackend
          "main =\n  let _ = (makeDir => makeDir) 1\n  makeDir \"d\""),
    ),
  ]

-- Two references to one refused extern, and one to another as a value and
-- applied; the gap events must be exactly the refusal lines a strict build
-- panics with, one per extern.
recordSrc : String
recordSrc =
  "main =\n  let _ = writeFile \"a\" \"b\"\n  let _ = writeFile \"c\" \"d\"\n  let f = netSend\n  netSend 1 \"x\""

test "(e) record mode logs one event per refused extern, and no unbound-variable event" =
  let decls = grantWholeDomain (desugar (parse recordSrc))
  let input =
    makeWasmEmitInputFull
      []
      (declSigTypeNames decls)
      (ctorFieldTypeNames decls)
      False
      False
      (declaredRecordFieldOrders decls)
      []
  let cp = lowerProgramEmit TargetWasm (annotateProgram decls)
  let (_, events) = wasmRecord input cp
  let expected = map ("main\t" ++ _) (refusalLines WasmBackend recordSrc)
  expectAll [
    labelFail
      "the refused externs"
      (expectEqual ["writeFile", "netSend"] (refused WasmBackend recordSrc)),
    labelFail "record emission" (expectEqual expected events),
    labelFail "gap census" (expectEqual expected (emitProgramGaps input cp)),
  ]

assertSnapshotSrc : String
assertSnapshotSrc = "main = assertSnapshot \"a\" \"b\""

test "(f) llvm refuses assertSnapshot and lowers what wasm refuses" = expectEach
  [
    (
      "assertSnapshot on llvm",
      expectEqual
        [
          "llvm: runtime extern 'assertSnapshot' is not available on the llvm backend (TODO: \{llvmReason "assertSnapshot"}) [in main]",
        ]
        (refusalLines LlvmBackend assertSnapshotSrc),
    ),
    (
      "assertSnapshot on wasm, whose row does not lower it either",
      expectEqual ["assertSnapshot"] (refused WasmBackend assertSnapshotSrc),
    ),
    (
      "writeFile on llvm",
      expectEqual [] (refused LlvmBackend "main = writeFile \"a\" \"b\""),
    ),
    ("llvm record mode", llvmRecordEvents),
  ]

llvmRecordEvents : Expectation
llvmRecordEvents =
  let decls = grantWholeDomain (desugar (parse assertSnapshotSrc))
  let input =
    makeEmitInput
      []
      []
      []
      []
      []
      False
      False
      0
      []
      []
      ""
      (declaredRecordFieldOrders decls)
      []
  let (_, events) =
    llvmRecord input (lowerProgramEmit TargetNative (annotateProgram decls))
  expectEqual
    (map ("main\t" ++ _) (refusalLines LlvmBackend assertSnapshotSrc))
    events

test "(g) a runtime extern with no catalog row is an internal error naming it" =
  let missing = missingCatalogRows ["putStrLn", "zzNoSuchExtern", "netSend"]
  expectAll [
    expectEqual ["zzNoSuchExtern"] missing,
    expectTextContainsAll
      ["internal error", "'zzNoSuchExtern'", "extern catalog"]
      (missingRowsMessage missing),
  ]

-- ── under the target `build` checked ─────────────────────────────────────────

-- What `medaka build` publishes once a program passes the target check: the
-- profile, with each runtime extern's labels as `stdlib/runtime.mdk` declares
-- them.  Naming a profile the program was never checked against is the hook
-- that forces an extern past the check.
checkedUnder : String -> <IO, FileRead> Result String CheckedTarget
checkedUnder name = do
  src <- readFile (underRoot "stdlib/runtime.mdk")
  profile <- lookupProfile name
  Ok (checkedTargetOf profile (parse src))

-- The wasm refusal of `src` as `build` renders it under `profile`.
wasmRefusalUnder : String -> String -> <IO, FileRead> Result String String
wasmRefusalUnder profile src =
  map
    (t =>
      renderExternRefusalUnder
        (Some t)
        (validateExterns WasmBackend [] (lowered TargetWasm src)))
    (checkedUnder profile)

uncheckedLine : String -> String -> String
uncheckedLine name profile =
  "internal error: extern `\{name}` reached `wasm` lowering with disposition NotProvided; `check` should have refused this program (profile `\{profile}`)"

owedLine : String -> String -> String
owedLine line profile =
  "\{line}; `\{profile}` grants its labels, so this is a lowering still owed (#3666)"

test "(y) under a checked target, a withheld label is an internal error and a ratchet row names #3666" = expectEach
  [
    (
      "a Net extern past the check on wasmgc/node",
      expectEqual
        (Ok (uncheckedLine "netTcpConnect" "wasmgc/node"))
        (wasmRefusalUnder "wasmgc/node" "main = netTcpConnect \"localhost\" 80"),
    ),
    (
      "an IO extern past the check on wasmgc/wasi-p2, whose IO joins nothing",
      expectEqual
        (Ok (uncheckedLine "allocBytes" "wasmgc/wasi-p2"))
        (wasmRefusalUnder "wasmgc/wasi-p2" "main = allocBytes ()"),
    ),
    (
      "a FileWrite ratchet row on wasmgc/node",
      expectEqual
        (Ok
          (owedLine
            "wasm: runtime extern 'writeFile' is not available on the wasm backend (WASM-GAP: \{wasmReason "writeFile"}) [in main]"
            "wasmgc/node"))
        (wasmRefusalUnder "wasmgc/node" "main = writeFile \"a\" \"b\""),
    ),
    (
      "an IO ratchet row on wasmgc/node, whose IO joins its host labels",
      expectEqual
        (Ok
          (owedLine
            "wasm: runtime extern 'allocBytes' is not available on the wasm backend (WASM-GAP: \{wasmReason "allocBytes"}) [in main]"
            "wasmgc/node"))
        (wasmRefusalUnder "wasmgc/node" "main = allocBytes ()"),
    ),
    (
      "a label-less extern keeps its line",
      expectEqual
        (Ok
          "wasm: runtime extern 'socketFd' is not available on the wasm backend (PERMANENT: \{wasmReason "socketFd"}) [in main]")
        (wasmRefusalUnder "wasmgc/node" "main = socketFd 3"),
    ),
    (
      "with no checked target, every line reads as today",
      expectEqual (refusalLines
        WasmBackend
        "main = netTcpConnect \"localhost\" 80") [
        renderExternRefusalUnder
          None
          (validateExterns
            WasmBackend
            []
            (lowered TargetWasm "main = netTcpConnect \"localhost\" 80")),
      ],
    ),
  ]

-- ── record ordinals ──────────────────────────────────────────────────────────

-- Record nodes written out of declared order, for a record, a named-field
-- variant, and a label two records share at different positions.
recordOrderSrc : String
recordOrderSrc =
  "data P = P { a : Int, b : Int }\ndata Q = Q { b : Int, a : Int }\ndata V = V { x : Int, y : Int, z : Int } | W { y : Int }\nmain =\n  let p = P { b = 1, a = 2 }\n  let q = { p | b = 3, a = 4 }\n  let v = V { z = 1, y = 2, x = 3 }\n  let w = V { v | z = 5, x = 6 }\n  p.b + q.a + w.y"

recordFindings : EmitTarget -> String -> List String
recordFindings target src = validateRecords (lowered target src)

unstamped : CExpr -> CProgram
unstamped body =
  CProgram [CBind "main" [CClause [] body] noDeclLoc] [] [] [] [] noDeclFacts

zero : CExpr
zero = CLit (LInt 0)

test "(h) lowering stamps every record node, so a permuted program validates clean" = expectAll
  [
    labelFail
      "native"
      (expectEqual [] (recordFindings TargetNative recordOrderSrc)),
    labelFail "wasm" (expectEqual [] (recordFindings TargetWasm recordOrderSrc)),
  ]

test "(i) a record node the lowering did not stamp is refused, naming the node and binding" = expectEach
  [
    (
      "literal",
      expectEqual
        [
          "record: CRecord P: field ordinals [a@-1] are not the declared positions [in main]",
        ]
        (validateRecords (unstamped (CRecord "P" [CField "a" (-1) zero]))),
    ),
    (
      "access",
      expectEqual
        ["record: CFieldAccess P.a: unstamped field ordinal [in main]"]
        (validateRecords (unstamped (CFieldAccess zero "a" "P" (-1)))),
    ),
    (
      "update",
      expectEqual
        [
          "record: CRecordUpdate P: field ordinals [a@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CRecordUpdate "P" zero [CField "a" (-1) zero]))),
    ),
    (
      "variant update",
      expectEqual
        [
          "record: CVariantUpdate V: field ordinals [x@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CVariantUpdate "V" zero [CField "x" (-1) zero]))),
    ),
    (
      "the Ref `.value` read needs no ordinal",
      expectEqual
        []
        (validateRecords (unstamped (CFieldAccess zero "value" "" (-1)))),
    ),
  ]

test "(j) ordinals out of declared position are refused" = expectEach [
  (
    "literal in written order",
    expectEqual
      [
        "record: CRecord P: field ordinals [b@1, a@0] are not the declared positions [in main]",
      ]
      (validateRecords
        (unstamped (CRecord "P" [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
  (
    "update in descending order",
    expectEqual
      [
        "record: CRecordUpdate P: field ordinals [b@1, a@0] are not strictly ascending [in main]",
      ]
      (validateRecords
        (unstamped
          (CRecordUpdate "P" zero [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
]

-- ── call modes ───────────────────────────────────────────────────────────────

-- #2078's program: `mk n = add n` names a user `add` that shares its spelling
-- with an interface method, so the reference lowers as a method occurrence
-- routed to the user's binding, and the eta pass gives `mk` that binding's two
-- parameters.  Typechecked against a two-method prelude, as a build would.
i2078Prelude : String
i2078Prelude =
  "interface Num a where\n  fromInt : Int -> a\n  add : a -> a -> a\nimpl Num Int where\n  fromInt n = n\n  add a b = a"

i2078Src : String
i2078Src =
  "add : Int -> Int -> Int\nadd a b = a\nmk : Int -> Int -> Int\nmk n = add n\napply1 : (Int -> Int) -> Int -> Int\napply1 f x = f x\nmain = apply1 (mk 1) 2"

typedLowered : String -> String -> CProgram
typedLowered preludeSrc src =
  lowerProgramEmit
    TargetNative
    (elaborateOne [] (desugar (parse preludeSrc)) (
      "calls",
      grantWholeDomain (desugar (parse src)),
    ))

-- [prog] with every application whose head is the variable [name] re-stamped
-- [mode], in top-level bindings.
restamp : String -> CallMode -> CProgram -> CProgram
restamp name mode (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (restampBind name mode) groups) ctors ctorTypes impls mctx facts

restampBind : String -> CallMode -> CBind -> CBind
restampBind name mode (CBind n clauses site) =
  CBind n (map (restampClause name mode) clauses) site

restampClause : String -> CallMode -> CClause -> CClause
restampClause name mode (CClause pats body) =
  CClause pats (restampExpr name mode body)

restampExpr : String -> CallMode -> CExpr -> CExpr
restampExpr name mode (CApp hd args (CallSite old tailPos)) =
  let args2 = map (restampExpr name mode) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode tailPos)
      else
        CApp hd args2 (CallSite old tailPos)
    _ => CApp (restampExpr name mode hd) args2 (CallSite old tailPos)
restampExpr name mode (CLet r pat rhs body) =
  CLet r pat (restampExpr name mode rhs) (restampExpr name mode body)
restampExpr name mode (CBlock stmts) =
  CBlock (map (restampStmt name mode) stmts)
restampExpr _ _ e = e

restampStmt : String -> CallMode -> CStmt -> CStmt
restampStmt name mode (CSExpr e) = CSExpr (restampExpr name mode e)
restampStmt name mode (CSLet r pat e) = CSLet r pat (restampExpr name mode e)
restampStmt _ _ s = s

shadowSrc : String
shadowSrc = "eq a b = a\npickEq eq x y = eq x y\nmain = pickEq eq 1 2"

overSrc : String
overSrc = "pre n = x => n + x\nmain = pre 1 2"

test "(k) lowering stamps every application, so a lowered program validates clean" = expectEach
  [
    (
      "#2078's point-free wrapper, typed",
      expectEqual [] (validateCalls (typedLowered i2078Prelude i2078Src)),
    ),
    (
      "a local named like a global",
      expectEqual [] (validateCalls (lowered TargetNative shadowSrc)),
    ),
    (
      "an over-application",
      expectEqual [] (validateCalls (lowered TargetWasm overSrc)),
    ),
  ]

test "(l) an application stamped against the wrong arity is refused, naming head, counts and binding" = expectEach
  [
    (
      "#2078: the wrapper's call stamped exact against its one source parameter",
      expectEqual
        ["call: mk applied to 1 of 2, stamped CallExact [in main]"]
        (validateCalls
          (restamp "mk" CallExact (typedLowered i2078Prelude i2078Src))),
    ),
    (
      "a known head stamped dynamic",
      expectEqual
        ["call: pickEq applied to 3 of 3, stamped CallDynamic [in main]"]
        (validateCalls
          (restamp "pickEq" CallDynamic (lowered TargetNative shadowSrc))),
    ),
    (
      "an over-application with the wrong surplus",
      expectEqual
        ["call: pre applied to 2 of 1, stamped (CallOver 2) [in main]"]
        (validateCalls
          (restamp "pre" (CallOver 2) (lowered TargetWasm overSrc))),
    ),
    (
      "a local `eq` stamped against the global `eq`'s two parameters",
      expectEqual
        ["call: eq has no static arity, stamped CallExact [in pickEq]"]
        (validateCalls
          (restamp "eq" CallExact (lowered TargetNative shadowSrc))),
    ),
  ]

test "(m) an application with no arguments, or whose head is an application, is refused" = expectEach
  [
    (
      "no arguments",
      expectEqual
        ["call: application with no arguments [in main]"]
        (validateCalls (unstamped (CApp zero [] (CallSite CallDynamic False)))),
    ),
    (
      "a nested head",
      expectEqual
        ["call: application whose head is an application [in main]"]
        (validateCalls
          (unstamped
            (CApp
              (CApp zero [zero] (CallSite CallDynamic False))
              [zero]
              (CallSite CallDynamic False)))),
    ),
  ]

-- ── tail flags ───────────────────────────────────────────────────────────────

-- [prog] with the tail flag of every application whose head is the variable
-- [name] set to [flag], in top-level bindings.
reflag : String -> Bool -> CProgram -> CProgram
reflag name flag (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (reflagBind name flag) groups) ctors ctorTypes impls mctx facts

reflagBind : String -> Bool -> CBind -> CBind
reflagBind name flag (CBind n clauses site) =
  CBind n (map (reflagClause name flag) clauses) site

reflagClause : String -> Bool -> CClause -> CClause
reflagClause name flag (CClause pats body) =
  CClause pats (reflagExpr name flag body)

reflagExpr : String -> Bool -> CExpr -> CExpr
reflagExpr name flag (CApp hd args (CallSite mode old)) =
  let args2 = map (reflagExpr name flag) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode flag)
      else
        CApp hd args2 (CallSite mode old)
    _ => CApp (reflagExpr name flag hd) args2 (CallSite mode old)
reflagExpr name flag (CLet r pat rhs body) =
  CLet r pat (reflagExpr name flag rhs) (reflagExpr name flag body)
reflagExpr name flag (CIf c t e) =
  CIf (reflagExpr name flag c) (reflagExpr name flag t) (reflagExpr name flag e)
reflagExpr _ _ e = e

tailSrc : String
tailSrc = "g x = x\nf x = g x\nmain = f 1"

tailShapesSrc : String
tailShapesSrc =
  "g x = x\nh x = if x == 0 then g x else g (g x)\nm x = match x\n  0 => g 1\n  n => let y = g n in g y\nw x = go x\n  where\n    go n = if n == 0 then g n else go (n - 1)\nmain = h 1 + m 2 + w 3"

test "(n) lowering flags every tail call, so a lowered program's tails validate clean" = expectEach
  [
    (
      "a call in a clause body",
      expectEqual [] (validateTails (lowered TargetNative tailSrc)),
    ),
    (
      "if, match, let and where bodies",
      expectEqual [] (validateTails (lowered TargetNative tailShapesSrc)),
    ),
    (
      "wasm lowering",
      expectEqual [] (validateTails (lowered TargetWasm tailShapesSrc)),
    ),
  ]

test "(o) a tail flag against the position is refused, naming head and binding" = expectEach
  [
    (
      "flagged outside tail position",
      expectEqual
        ["tail: f is flagged as a tail call outside tail position [in main]"]
        (validateTails (reflag "f" True (lowered TargetNative tailSrc))),
    ),
    (
      "flagged but partial",
      expectEqual
        [
          "tail: g is flagged as a tail call but is a partial application (CallPartial 1) [in f]",
        ]
        (validateTails
          (reflag
            "g"
            True
            (restamp "g" (CallPartial 1) (lowered TargetNative tailSrc)))),
    ),
    (
      "in tail position but not flagged",
      expectEqual
        [
          "tail: g is in tail position, stamped CallExact, but not flagged [in f]",
        ]
        (validateTails (reflag "g" False (lowered TargetNative tailSrc))),
    ),
  ]

-- ── let-bound lambdas ───────────────────────────────────────────────────────

-- A `let` of a lambda, as a block statement or a `let ... in`, is a function
-- local of the lambda's parameter count: an exact call of it and an
-- over-application of a curried one.
letLamSrc : String
letLamSrc =
  "main =\n  let f = x => x + 1\n  let g = x => y => x + y\n  g (f 2) 3"

letInLamSrc : String
letInLamSrc = "main = let f = x => x + 1 in f 2"

test "(p) a call of a let-bound lambda is read against the lambda's parameters" = expectEach
  [
    (
      "lowering stamps both calls, so the program validates clean",
      expectEqual [] (validateCalls (lowered TargetNative letLamSrc)),
    ),
    (
      "a `let ... in` of a lambda validates clean",
      expectEqual [] (validateCalls (lowered TargetNative letInLamSrc)),
    ),
    (
      "an exact call stamped dynamic",
      expectEqual
        ["call: f applied to 1 of 1, stamped CallDynamic [in main]"]
        (validateCalls
          (restamp "f" CallDynamic (lowered TargetNative letLamSrc))),
    ),
    (
      "an over-application stamped dynamic",
      expectEqual
        ["call: g applied to 2 of 1, stamped CallDynamic [in main]"]
        (validateCalls (restamp "g" CallDynamic (lowered TargetWasm letLamSrc))),
    ),
  ]

-- ── impl entry groups ───────────────────────────────────────────────────────

-- Two clauses of one impl method: the eta pass could give `foo A`'s
-- point-free tail (`add` is a method name routed to the user's binding) a
-- second parameter, but `foo B`'s tail is not atomic.
mixedGroupSrc : String
mixedGroupSrc =
  "add : Int -> Int -> Int\nadd a b = a + b\nsub : Int -> Int -> Int\nsub a b = a - b\ninterface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = add 1\n  foo B = sub (3 + 0)\nmain = foo A 5"

-- [prog] with one more parameter on the first impl entry of method [m].
widenFirstEntry : String -> CProgram -> CProgram
widenFirstEntry m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (widenEntries m impls) mctx facts

widenEntries : String -> List CImplEntry -> List CImplEntry
widenEntries _ [] = []
widenEntries m ((ent@(CImplEntry n s d body)) :: rest) =
  if n == m then
    CImplEntry n s d (widenBody body) :: rest
  else
    ent :: widenEntries m rest

widenBody : CImplBody -> CImplBody
widenBody (CImplTagged tag key iface sym pos pats body) =
  CImplTagged tag key iface sym pos (pats ++ [PVar "w" noDeclLoc]) body
widenBody (CImplDefault w tag key sym pos pats body) =
  CImplDefault w tag key sym pos (pats ++ [PVar "w" noDeclLoc]) body

test "(q) the impl entries of one method and route word take one arity" = expectEach
  [
    (
      "the eta pass expands a group whole or not at all, so it validates clean",
      expectEqual [] (validateCalls (typedLowered i2078Prelude mixedGroupSrc)),
    ),
    (
      "an entry widened apart from its group is refused",
      expectEqual
        [
          "call: impl entry takes 1 value parameters, the first entry of its group 2 [in impl foo@calls.T]",
        ]
        (validateCalls
          (widenFirstEntry "foo" (typedLowered i2078Prelude mixedGroupSrc))),
    ),
  ]

-- [prog] with every impl entry's stamped symbol cleared, as a lowering that
-- never stamped would leave it.
unstampImpls : CProgram -> CProgram
unstampImpls (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map unstampEntry impls) mctx facts

unstampEntry : CImplEntry -> CImplEntry
unstampEntry (CImplEntry n s d (CImplTagged tag key iface _ pos pats body)) =
  CImplEntry n s d (CImplTagged tag key iface noImplSym pos pats body)
unstampEntry (CImplEntry n s d (CImplDefault w tag key _ pos pats body)) =
  CImplEntry n s d (CImplDefault w tag key noImplSym pos pats body)

-- [prog] with every supplied method's interface word replaced by [word].
reword : String -> CProgram -> CProgram
reword word (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (rewordEntry word) impls) mctx facts

rewordEntry : String -> CImplEntry -> CImplEntry
rewordEntry word (CImplEntry n s d (CImplTagged tag key _ sym pos pats body)) =
  CImplEntry n s d (CImplTagged tag key word sym pos pats body)
rewordEntry _ ent = ent

test "(t) every impl entry carries its stamped symbol and its qualified interface word" = expectEach
  [
    (
      "lowering stamps both, so a lowered program validates clean",
      expectEqual [] (validateImplSymbols (lowered TargetNative mixedGroupSrc)),
    ),
    (
      "an entry with no stamped symbol is refused",
      expectEqual
        [
          "impl symbol: entry has no stamped symbol [in impl foo@T]",
          "impl symbol: entry has no stamped symbol [in impl foo@T]",
        ]
        (validateImplSymbols
          (unstampImpls (lowered TargetNative mixedGroupSrc))),
    ),
    (
      "an interface word that is not the qualified word of the entry's key is refused",
      expectEqual
        [
          "impl symbol: interface word `Other` is not the qualified word `Foo` of its key [in impl foo@T]",
          "impl symbol: interface word `Other` is not the qualified word `Foo` of its key [in impl foo@T]",
        ]
        (validateImplSymbols
          (reword "Other" (lowered TargetNative mixedGroupSrc))),
    ),
  ]

-- ── method contexts ─────────────────────────────────────────────────────────

-- `desc`'s declared context constrains only the interface parameter, so each
-- call supplies the `Show2 (Pair b)` dictionary and the impl entry takes it.
paramContextSrc : String
paramContextSrc =
  "data Pair a = Pair a a\ninterface Show2 a where\n  show2 : a -> String\nimpl Show2 Int where\n  show2 n = \"int\"\nimpl Show2 (Pair b) requires Show2 b where\n  show2 (Pair x _) = show2 x\ninterface Desc a where\n  desc : Show2 a => a -> String\nimpl Desc (Pair b) where\n  desc p = show2 p\nmain = desc (Pair (1 : Int) 2)"

-- [prog] with the method routes of every top-level application of method [name]
-- dropped, as an elaboration that posed no goal for the context would leave it.
dropMethodRoutes : String -> CProgram -> CProgram
dropMethodRoutes name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (dropRoutesBind name) groups) ctors ctorTypes impls mctx facts

dropRoutesBind : String -> CBind -> CBind
dropRoutesBind name (CBind n clauses site) =
  CBind n (map (dropRoutesClause name) clauses) site

dropRoutesClause : String -> CClause -> CClause
dropRoutesClause name (CClause pats body) =
  CClause pats (dropRoutesExpr name body)

dropRoutesExpr : String -> CExpr -> CExpr
dropRoutesExpr name (CApp hd args site) =
  CApp (dropRoutesExpr name hd) (map (dropRoutesExpr name) args) site
dropRoutesExpr name (m@(CMethod n (MethodEvidence iface arity route impls _))) =
  if n == name then CMethod n (MethodEvidence iface arity route impls []) else m
dropRoutesExpr _ e = e

-- [prog] with the leading parameter of every impl entry of method [m] dropped.
dropEntryDict : String -> CProgram -> CProgram
dropEntryDict m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (dropEntryDictOne m) impls) mctx facts

dropEntryDictOne : String -> CImplEntry -> CImplEntry
dropEntryDictOne m (ent@(CImplEntry n s d body)) =
  if n == m then CImplEntry n s d (dropFirstPat body) else ent

dropFirstPat : CImplBody -> CImplBody
dropFirstPat (CImplTagged tag key iface sym pos (_ :: pats) body) =
  CImplTagged tag key iface sym pos pats body
dropFirstPat (CImplDefault w tag key sym pos (_ :: pats) body) =
  CImplDefault w tag key sym pos pats body
dropFirstPat b = b

test "(u) a method's dictionaries match its declared context" = expectEach [
  (
    "a context over only the interface parameter: lowered, it validates clean",
    expectEqual
      []
      (validateMethodContexts (typedLowered i2078Prelude paramContextSrc)),
  ),
  (
    "a call that supplies no route for the context is refused",
    expectEqual
      [
        "method context: method desc supplies 0 method routes, `calls::Desc` declares 1 [in main]",
      ]
      (validateMethodContexts
        (dropMethodRoutes "desc" (typedLowered i2078Prelude paramContextSrc))),
  ),
  (
    "an impl entry that takes no dictionary for the context is refused",
    expectEqual
      [
        "method context: impl entry opens with 0 `$dict_desc_k` parameters, `calls::Desc` declares 1 and its instance requires 0 [in impl desc@calls.Pair]",
      ]
      (validateMethodContexts
        (dropEntryDict "desc" (typedLowered i2078Prelude paramContextSrc))),
  ),
]

-- `size` declares no context, so the method-context table has no row for it.
contextFreeSrc : String
contextFreeSrc =
  "interface Size a where\n  size : a -> Int\nimpl Size Int where\n  size n = n\nmain = size (3 : Int)"

-- [prog] with one more method route on every top-level application of method
-- [name], as an elaboration that read another declaration's context would leave it.
addMethodRoute : String -> CProgram -> CProgram
addMethodRoute name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (addRouteBind name) groups) ctors ctorTypes impls mctx facts

addRouteBind : String -> CBind -> CBind
addRouteBind name (CBind n clauses site) =
  CBind n (map (addRouteClause name) clauses) site

addRouteClause : String -> CClause -> CClause
addRouteClause name (CClause pats body) = CClause pats (addRouteExpr name body)

addRouteExpr : String -> CExpr -> CExpr
addRouteExpr name (CApp hd args site) =
  CApp (addRouteExpr name hd) (map (addRouteExpr name) args) site
addRouteExpr name (m@(CMethod n (MethodEvidence iface arity route impls meths))) =
  if n == name then
    CMethod n (MethodEvidence iface arity route impls (meths ++ [route]))
  else
    m
addRouteExpr _ e = e

-- [prog] with a leading `$dict_<m>_0` parameter on every impl entry of method [m].
addEntryDict : String -> CProgram -> CProgram
addEntryDict m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (addEntryDictOne m) impls) mctx facts

addEntryDictOne : String -> CImplEntry -> CImplEntry
addEntryDictOne m (ent@(CImplEntry n s d body)) =
  if n == m then CImplEntry n s d (addFirstPat m body) else ent

addFirstPat : String -> CImplBody -> CImplBody
addFirstPat m (CImplTagged tag key iface sym pos pats body) =
  CImplTagged tag key iface sym pos (PVar "$dict_\{m}_0" noDeclLoc :: pats) body
addFirstPat m (CImplDefault w tag key sym pos pats body) =
  CImplDefault w tag key sym pos (PVar "$dict_\{m}_0" noDeclLoc :: pats) body

test "(x) a method with no declared context takes no context dictionary" = expectEach
  [
    (
      "lowered, a context-free method validates clean",
      expectEqual
        []
        (validateMethodContexts (typedLowered i2078Prelude contextFreeSrc)),
    ),
    (
      "a call that supplies a method route to it is refused",
      expectEqual
        [
          "method context: method size supplies 1 method routes, `calls::Size` declares 0 [in main]",
        ]
        (validateMethodContexts
          (addMethodRoute "size" (typedLowered i2078Prelude contextFreeSrc))),
    ),
    (
      "an impl entry that opens with a context dictionary for it is refused",
      expectEqual
        [
          "method context: impl entry opens with 1 `$dict_size_k` parameters, `calls::Size` declares 0 and its instance requires 0 [in impl size@Int]",
        ]
        (validateMethodContexts
          (addEntryDict "size" (typedLowered i2078Prelude contextFreeSrc))),
    ),
  ]

-- A program whose `g` takes one dictionary and whose `main` binds `$dict_m_0`,
-- with `body` as main's body.  Instance `K` requires nothing and its interface has
-- no supers; instance `S` requires nothing and its interface has one super.
evidenceProg : CExpr -> CProgram
evidenceProg body =
  CProgram
    [
      CBind
        "g"
        [CClause [PVar "$dict_g_0" noDeclLoc] (CLit (LInt 1))]
        noDeclLoc,
      CBind "main" [CClause [PVar "$dict_m_0" noDeclLoc] body] noDeclLoc,
    ]
    []
    []
    []
    []
    DeclFacts {
      factRequires = [("K", 0), ("S", 0)],
      factSupers = [("K", 0), ("S", 1)],
    }

evidenceOf : Route -> CExpr
evidenceOf route = CMethod "show" (MethodEvidence "I" 1 route [] [])

test "(v) a dispatch node's evidence denotes dictionaries its callee binds" = expectEach
  [
    (
      "a lowered program validates clean",
      expectEqual
        []
        (validateDispatchEvidence (typedLowered i2078Prelude paramContextSrc)),
    ),
    (
      "hand-built evidence over a bound given validates clean",
      expectEqual
        []
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RProj (RDict "$dict_m_0") [0]]))),
    ),
    (
      "a dictionary the occurrence does not bind is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) reads dictionary `$dict_zz`, which is not bound here [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RDict "$dict_zz"]))),
    ),
    (
      "a projection over an instance is refused",
      expectEqual
        [
          "dispatch evidence: method show projects from a route that is not a given dictionary [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (evidenceOf (RProj (RKey "K" [] []) [0])))),
    ),
    (
      "a head instance key with no entry is refused",
      expectEqual
        [
          "dispatch evidence: method show names instance `Nope` that has no entry for `show` [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (evidenceOf (RKey "Nope" [] [])))),
    ),
    (
      "a dictionary application with an extra slot is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) supplies 2 dictionaries, `g` takes 1 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RDict "$dict_m_0", RDict "$dict_m_0"]))),
    ),
    (
      "a scalar route in a slot is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) carries scalar route `Int` [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RScalar "Int"]))),
    ),
    (
      "a dictionary slot with no route is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) has a dictionary slot with no route [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RNone]))),
    ),
  ]

-- [prog] with the prerequisite routes of every dictionary built in the method
-- routes of each top-level occurrence of method [name] dropped.
dropBuiltPrereqs : String -> CProgram -> CProgram
dropBuiltPrereqs name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (dropPrereqsBind name) groups) ctors ctorTypes impls mctx facts

dropPrereqsBind : String -> CBind -> CBind
dropPrereqsBind name (CBind n clauses site) =
  CBind n (map (dropPrereqsClause name) clauses) site

dropPrereqsClause : String -> CClause -> CClause
dropPrereqsClause name (CClause pats body) =
  CClause pats (dropPrereqsExpr name body)

dropPrereqsExpr : String -> CExpr -> CExpr
dropPrereqsExpr name (CApp hd args site) =
  CApp (dropPrereqsExpr name hd) (map (dropPrereqsExpr name) args) site
dropPrereqsExpr name (m@(CMethod n (MethodEvidence iface arity route impls meths))) =
  if n == name then
    CMethod n (MethodEvidence iface arity route impls (map dropReqs meths))
  else
    m
dropPrereqsExpr _ e = e

dropReqs : Route -> Route
dropReqs (RKey key _ sups) = RKey key [] sups
dropReqs r = r

test "(w) a built dictionary matches the declarations, and a dispatch names its interface" = expectEach
  [
    (
      "a dictionary built with a prerequisite its instance does not require is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `K` from 1 prerequisite dictionaries, it requires 0 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RKey "K" [RDict "$dict_m_0"] []]))),
    ),
    (
      "a dictionary built without its interface's super is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `S` with 0 super dictionaries, `S` has 1 [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RKey "S" [] []]))),
    ),
    (
      "a dictionary of an undeclared instance stores nothing",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `Q` from 1 prerequisite dictionaries, it requires 0 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RKey "Q" [RDict "$dict_m_0"] []]))),
    ),
    (
      "a dispatch through a given with no interface word is refused",
      expectEqual
        [
          "dispatch evidence: method show dispatches with no interface word [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg
            (CMethod "show" (MethodEvidence "" 1 (RDict "$dict_m_0") [] [])))),
    ),
    (
      "a lowered dictionary missing its prerequisite is refused",
      expectEqual
        [
          "dispatch evidence: method desc builds instance `calls::Show2|(calls.Pair b)|` from 0 prerequisite dictionaries, it requires 1 [in main]",
        ]
        (validateDispatchEvidence
          (dropBuiltPrereqs "desc" (typedLowered i2078Prelude paramContextSrc))),
    ),
  ]

-- An impl group whose first clause returns a lambda literal: that clause takes
-- the lambda's parameter, so both entries take two.  When a `let` stands before
-- the lambda, the clause keeps its one parameter and the group is refused.
lamGroupSrc : String
lamGroupSrc =
  "interface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = (y => y + 1)\n  foo B y = y - 3\nmain = foo A 5"

letLamGroupSrc : String
letLamGroupSrc =
  "interface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = let z = 1 + 0 in (y => y + z)\n  foo B y = y - 3\nmain = foo A 5"

test "(r) an impl clause returning a lambda literal takes the lambda's parameters" = expectEach
  [
    (
      "the group then takes one arity and validates clean",
      expectEqual [] (validateCalls (typedLowered i2078Prelude lamGroupSrc)),
    ),
    (
      "a clause with a `let` before its lambda keeps its arity and is refused",
      expectEqual
        [
          "call: impl entry takes 2 value parameters, the first entry of its group 1 [in impl foo@calls.T]",
        ]
        (validateCalls (typedLowered i2078Prelude letLamGroupSrc)),
    ),
  ]

-- ── the `Ref` read ──────────────────────────────────────────────────────────

-- A record that declares a field `value`, beside a `Ref` read `!r`.
refValueSrc : String
refValueSrc =
  "data Entry = Entry { name : String, value : Int }\nmain =\n  let e = Entry { name = \"k\", value = 42 }\n  let r = e\n  !r"

test "(s) `.value` is the Ref read, never a record field" = expectEach [
  (
    "lowering leaves `!r` unstamped though a record declares `value`",
    expectAll [
      labelFail
        "native"
        (expectEqual [] (recordFindings TargetNative refValueSrc)),
      labelFail "wasm" (expectEqual [] (recordFindings TargetWasm refValueSrc)),
    ],
  ),
  (
    "a `.value` read stamped with a record ordinal is refused",
    expectEqual
      [
        "record: CFieldAccess Entry.value: a Ref read stamped with field ordinal 1 [in main]",
      ]
      (validateRecords (unstamped (CFieldAccess zero "value" "Entry" 1))),
  ),
]
