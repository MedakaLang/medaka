-- Sibling test module for `compiler/backend/core_validate.mdk` ([P-TEST-SIBLING]).
--
-- Each program is prelude-free and lowered without typechecking, through the
-- pipeline `compiler/entries/wasm_emit_main.mdk` and
-- `compiler/entries/llvm_emit_main.mdk` use, so a reference to a runtime extern
-- reaches the checked program exactly as the source spells it.

import test.{
  Expectation,
  expectAll,
  expectEach,
  expectEqual,
  expectTextContainsAll,
  labelFail,
}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import types.annotate.{annotateProgram}
import types.typecheck.{elaborateOne, grantWholeDomain}
import ir.core_ir.{
  CBind(..),
  CClause(..),
  CExpr(..),
  CField(..),
  CProgram(..),
  CStmt(..),
  CallMode(..),
  CallSite(..),
}
import frontend.ast.{Lit(..), noDeclLoc}
import ir.core_ir_lower.{
  EmitTarget(..),
  ctorFieldTypeNames,
  declSigTypeNames,
  declaredRecordFieldOrders,
  lowerProgramEmit,
}
import backend.extern_catalog.{catalogRow, ledgerEntry, rowLlvm, rowWasm}
import backend.core_validate.{
  Backend(..),
  findingExtern,
  missingCatalogRows,
  missingRowsMessage,
  renderExternFinding,
  validateCalls,
  validateExterns,
  validateRecords,
  validateTails,
}
import backend.wasm_emit.{
  emitProgramGaps,
  emitProgramRecord as wasmRecord,
  makeWasmEmitInputFull,
}
import backend.llvm_emit.{emitProgramRecord as llvmRecord, makeEmitInput}

lowered : EmitTarget -> String -> CProgram
lowered target src =
  lowerProgramEmit
    target
    (annotateProgram (grantWholeDomain (desugar (parse src))))

-- The extern names `backend` refuses in `src`, in order of first reference.
refused : Backend -> String -> List String
refused LlvmBackend src =
  map findingExtern (validateExterns LlvmBackend [] (lowered TargetNative src))
refused WasmBackend src =
  map findingExtern (validateExterns WasmBackend [] (lowered TargetWasm src))

refusalLines : Backend -> String -> List String
refusalLines LlvmBackend src =
  map
    renderExternFinding
    (validateExterns LlvmBackend [] (lowered TargetNative src))
refusalLines WasmBackend src =
  map
    renderExternFinding
    (validateExterns WasmBackend [] (lowered TargetWasm src))

-- The reason the extern's wasm or llvm row gives, as the row states it.
wasmReason : String -> String
wasmReason name = match catalogRow name
  Some r => match ledgerEntry (rowWasm r)
    Some (_, why) => why
    None => ""
  None => ""

llvmReason : String -> String
llvmReason name = match catalogRow name
  Some r => match ledgerEntry (rowLlvm r)
    Some (_, why) => why
    None => ""
  None => ""

test "(a) wasm: a reference to a net extern is refused, naming extern, backend, kind and reason" =
  expectEqual
    [
      "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in main]",
    ]
    (refusalLines WasmBackend "main = netTcpConnect \"localhost\" 80")

test "(b) wasm: references to WASM-GAP externs are refused, applied or as values, each in its binding" =
  expectEqual
    [
      "wasm: runtime extern 'writeFile' is not available on the wasm backend (WASM-GAP: \{wasmReason "writeFile"}) [in save]",
      "wasm: runtime extern 'listDir' is not available on the wasm backend (WASM-GAP: \{wasmReason "listDir"}) [in main]",
    ]
    (refusalLines
      WasmBackend
      "save = writeFile\nmain =\n  let _ = save \"a\" \"b\"\n  listDir \".\"")

test "(c) wasm: a program that names an extern only as text, a field or a lowered extern is not refused" =
  expectEqual
    []
    (refused
      WasmBackend
      "data Conn = Conn { netSend : Int }\nmain =\n  let c = Conn { netSend = 1 }\n  putStrLn (\"netSend\" ++ intToString c.netSend)")

test "(d) a local binder or a program binding named like a refused extern shadows it, in its scope only" = expectEach
  [
    (
      "lambda parameter",
      expectEqual
        []
        (refused WasmBackend "main = (writeFile => writeFile 1) (x => x)"),
    ),
    (
      "let binding",
      expectEqual
        []
        (refused WasmBackend "main =\n  let netSend = 3\n  netSend + 1"),
    ),
    (
      "match arm",
      expectEqual
        []
        (refused
          WasmBackend
          "main = match Some 1\n  Some listDir => listDir\n  None => 0"),
    ),
    (
      "top-level binding",
      expectEqual [] (refused WasmBackend "readLine x = x\nmain = readLine 3"),
    ),
    (
      "the extern outside its shadow's scope",
      expectEqual
        ["makeDir"]
        (refused
          WasmBackend
          "main =\n  let _ = (makeDir => makeDir) 1\n  makeDir \"d\""),
    ),
  ]

-- Two references to one refused extern, and one to another as a value and
-- applied; the gap events must be exactly the refusal lines a strict build
-- panics with, one per extern.
recordSrc : String
recordSrc =
  "main =\n  let _ = writeFile \"a\" \"b\"\n  let _ = writeFile \"c\" \"d\"\n  let f = netSend\n  netSend 1 \"x\""

test "(e) record mode logs one event per refused extern, and no unbound-variable event" =
  let decls = grantWholeDomain (desugar (parse recordSrc))
  let input =
    makeWasmEmitInputFull
      []
      (declSigTypeNames decls)
      (ctorFieldTypeNames decls)
      False
      False
      (declaredRecordFieldOrders decls)
      []
  let cp = lowerProgramEmit TargetWasm (annotateProgram decls)
  let (_, events) = wasmRecord input cp
  let expected = map ("main\t" ++ _) (refusalLines WasmBackend recordSrc)
  expectAll [
    labelFail
      "the refused externs"
      (expectEqual ["writeFile", "netSend"] (refused WasmBackend recordSrc)),
    labelFail "record emission" (expectEqual expected events),
    labelFail "gap census" (expectEqual expected (emitProgramGaps input cp)),
  ]

assertSnapshotSrc : String
assertSnapshotSrc = "main = assertSnapshot \"a\" \"b\""

test "(f) llvm refuses assertSnapshot and lowers what wasm refuses" = expectEach
  [
    (
      "assertSnapshot on llvm",
      expectEqual
        [
          "llvm: runtime extern 'assertSnapshot' is not available on the llvm backend (TODO: \{llvmReason "assertSnapshot"}) [in main]",
        ]
        (refusalLines LlvmBackend assertSnapshotSrc),
    ),
    (
      "assertSnapshot on wasm, whose row does not lower it either",
      expectEqual ["assertSnapshot"] (refused WasmBackend assertSnapshotSrc),
    ),
    (
      "writeFile on llvm",
      expectEqual [] (refused LlvmBackend "main = writeFile \"a\" \"b\""),
    ),
    ("llvm record mode", llvmRecordEvents),
  ]

llvmRecordEvents : Expectation
llvmRecordEvents =
  let decls = grantWholeDomain (desugar (parse assertSnapshotSrc))
  let input =
    makeEmitInput
      []
      []
      []
      []
      []
      False
      False
      0
      []
      []
      ""
      (declaredRecordFieldOrders decls)
      []
  let (_, events) =
    llvmRecord input (lowerProgramEmit TargetNative (annotateProgram decls))
  expectEqual
    (map ("main\t" ++ _) (refusalLines LlvmBackend assertSnapshotSrc))
    events

test "(g) a runtime extern with no catalog row is an internal error naming it" =
  let missing = missingCatalogRows ["putStrLn", "zzNoSuchExtern", "netSend"]
  expectAll [
    expectEqual ["zzNoSuchExtern"] missing,
    expectTextContainsAll
      ["internal error", "'zzNoSuchExtern'", "extern catalog"]
      (missingRowsMessage missing),
  ]

-- ── record ordinals ──────────────────────────────────────────────────────────

-- Record nodes written out of declared order, for a record, a named-field
-- variant, and a label two records share at different positions.
recordOrderSrc : String
recordOrderSrc =
  "data P = P { a : Int, b : Int }\ndata Q = Q { b : Int, a : Int }\ndata V = V { x : Int, y : Int, z : Int } | W { y : Int }\nmain =\n  let p = P { b = 1, a = 2 }\n  let q = { p | b = 3, a = 4 }\n  let v = V { z = 1, y = 2, x = 3 }\n  let w = V { v | z = 5, x = 6 }\n  p.b + q.a + w.y"

recordFindings : EmitTarget -> String -> List String
recordFindings target src = validateRecords (lowered target src)

unstamped : CExpr -> CProgram
unstamped body = CProgram [CBind "main" [CClause [] body] noDeclLoc] [] [] []

zero : CExpr
zero = CLit (LInt 0)

test "(h) lowering stamps every record node, so a permuted program validates clean" = expectAll
  [
    labelFail
      "native"
      (expectEqual [] (recordFindings TargetNative recordOrderSrc)),
    labelFail "wasm" (expectEqual [] (recordFindings TargetWasm recordOrderSrc)),
  ]

test "(i) a record node the lowering did not stamp is refused, naming the node and binding" = expectEach
  [
    (
      "literal",
      expectEqual
        [
          "record: CRecord P: field ordinals [a@-1] are not the declared positions [in main]",
        ]
        (validateRecords (unstamped (CRecord "P" [CField "a" (-1) zero]))),
    ),
    (
      "access",
      expectEqual
        ["record: CFieldAccess P.a: unstamped field ordinal [in main]"]
        (validateRecords (unstamped (CFieldAccess zero "a" "P" (-1)))),
    ),
    (
      "update",
      expectEqual
        [
          "record: CRecordUpdate P: field ordinals [a@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CRecordUpdate "P" zero [CField "a" (-1) zero]))),
    ),
    (
      "variant update",
      expectEqual
        [
          "record: CVariantUpdate V: field ordinals [x@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CVariantUpdate "V" zero [CField "x" (-1) zero]))),
    ),
    (
      "the Ref `.value` read needs no ordinal",
      expectEqual
        []
        (validateRecords (unstamped (CFieldAccess zero "value" "" (-1)))),
    ),
  ]

test "(j) ordinals out of declared position are refused" = expectEach [
  (
    "literal in written order",
    expectEqual
      [
        "record: CRecord P: field ordinals [b@1, a@0] are not the declared positions [in main]",
      ]
      (validateRecords
        (unstamped (CRecord "P" [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
  (
    "update in descending order",
    expectEqual
      [
        "record: CRecordUpdate P: field ordinals [b@1, a@0] are not strictly ascending [in main]",
      ]
      (validateRecords
        (unstamped
          (CRecordUpdate "P" zero [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
]

-- ── call modes ───────────────────────────────────────────────────────────────

-- #2078's program: `mk n = add n` names a user `add` that shares its spelling
-- with an interface method, so the reference lowers as a method occurrence
-- routed to the user's binding, and the eta pass gives `mk` that binding's two
-- parameters.  Typechecked against a two-method prelude, as a build would.
i2078Prelude : String
i2078Prelude =
  "interface Num a where\n  fromInt : Int -> a\n  add : a -> a -> a\nimpl Num Int where\n  fromInt n = n\n  add a b = a"

i2078Src : String
i2078Src =
  "add : Int -> Int -> Int\nadd a b = a\nmk : Int -> Int -> Int\nmk n = add n\napply1 : (Int -> Int) -> Int -> Int\napply1 f x = f x\nmain = apply1 (mk 1) 2"

typedLowered : String -> String -> CProgram
typedLowered preludeSrc src =
  lowerProgramEmit
    TargetNative
    (elaborateOne [] (desugar (parse preludeSrc)) (
      "calls",
      grantWholeDomain (desugar (parse src)),
    ))

-- [prog] with every application whose head is the variable [name] re-stamped
-- [mode], in top-level bindings.
restamp : String -> CallMode -> CProgram -> CProgram
restamp name mode (CProgram groups ctors ctorTypes impls) =
  CProgram (map (restampBind name mode) groups) ctors ctorTypes impls

restampBind : String -> CallMode -> CBind -> CBind
restampBind name mode (CBind n clauses site) =
  CBind n (map (restampClause name mode) clauses) site

restampClause : String -> CallMode -> CClause -> CClause
restampClause name mode (CClause pats body) =
  CClause pats (restampExpr name mode body)

restampExpr : String -> CallMode -> CExpr -> CExpr
restampExpr name mode (CApp hd args (CallSite old tailPos)) =
  let args2 = map (restampExpr name mode) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode tailPos)
      else
        CApp hd args2 (CallSite old tailPos)
    _ => CApp (restampExpr name mode hd) args2 (CallSite old tailPos)
restampExpr name mode (CLet r pat rhs body) =
  CLet r pat (restampExpr name mode rhs) (restampExpr name mode body)
restampExpr name mode (CBlock stmts) =
  CBlock (map (restampStmt name mode) stmts)
restampExpr _ _ e = e

restampStmt : String -> CallMode -> CStmt -> CStmt
restampStmt name mode (CSExpr e) = CSExpr (restampExpr name mode e)
restampStmt name mode (CSLet r pat e) = CSLet r pat (restampExpr name mode e)
restampStmt _ _ s = s

shadowSrc : String
shadowSrc = "eq a b = a\npickEq eq x y = eq x y\nmain = pickEq eq 1 2"

overSrc : String
overSrc = "pre n = x => n + x\nmain = pre 1 2"

test "(k) lowering stamps every application, so a lowered program validates clean" = expectEach
  [
    (
      "#2078's point-free wrapper, typed",
      expectEqual [] (validateCalls (typedLowered i2078Prelude i2078Src)),
    ),
    (
      "a local named like a global",
      expectEqual [] (validateCalls (lowered TargetNative shadowSrc)),
    ),
    (
      "an over-application",
      expectEqual [] (validateCalls (lowered TargetWasm overSrc)),
    ),
  ]

test "(l) an application stamped against the wrong arity is refused, naming head, counts and binding" = expectEach
  [
    (
      "#2078: the wrapper's call stamped exact against its one source parameter",
      expectEqual
        ["call: mk applied to 1 of 2, stamped CallExact [in main]"]
        (validateCalls
          (restamp "mk" CallExact (typedLowered i2078Prelude i2078Src))),
    ),
    (
      "a known head stamped dynamic",
      expectEqual
        ["call: pickEq applied to 3 of 3, stamped CallDynamic [in main]"]
        (validateCalls
          (restamp "pickEq" CallDynamic (lowered TargetNative shadowSrc))),
    ),
    (
      "an over-application with the wrong surplus",
      expectEqual
        ["call: pre applied to 2 of 1, stamped (CallOver 2) [in main]"]
        (validateCalls
          (restamp "pre" (CallOver 2) (lowered TargetWasm overSrc))),
    ),
    (
      "a local `eq` stamped against the global `eq`'s two parameters",
      expectEqual
        ["call: eq has no static arity, stamped CallExact [in pickEq]"]
        (validateCalls
          (restamp "eq" CallExact (lowered TargetNative shadowSrc))),
    ),
  ]

test "(m) an application with no arguments, or whose head is an application, is refused" = expectEach
  [
    (
      "no arguments",
      expectEqual
        ["call: application with no arguments [in main]"]
        (validateCalls (unstamped (CApp zero [] (CallSite CallDynamic False)))),
    ),
    (
      "a nested head",
      expectEqual
        ["call: application whose head is an application [in main]"]
        (validateCalls
          (unstamped
            (CApp
              (CApp zero [zero] (CallSite CallDynamic False))
              [zero]
              (CallSite CallDynamic False)))),
    ),
  ]

-- ── tail flags ───────────────────────────────────────────────────────────────

-- [prog] with the tail flag of every application whose head is the variable
-- [name] set to [flag], in top-level bindings.
reflag : String -> Bool -> CProgram -> CProgram
reflag name flag (CProgram groups ctors ctorTypes impls) =
  CProgram (map (reflagBind name flag) groups) ctors ctorTypes impls

reflagBind : String -> Bool -> CBind -> CBind
reflagBind name flag (CBind n clauses site) =
  CBind n (map (reflagClause name flag) clauses) site

reflagClause : String -> Bool -> CClause -> CClause
reflagClause name flag (CClause pats body) =
  CClause pats (reflagExpr name flag body)

reflagExpr : String -> Bool -> CExpr -> CExpr
reflagExpr name flag (CApp hd args (CallSite mode old)) =
  let args2 = map (reflagExpr name flag) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode flag)
      else
        CApp hd args2 (CallSite mode old)
    _ => CApp (reflagExpr name flag hd) args2 (CallSite mode old)
reflagExpr name flag (CLet r pat rhs body) =
  CLet r pat (reflagExpr name flag rhs) (reflagExpr name flag body)
reflagExpr name flag (CIf c t e) =
  CIf (reflagExpr name flag c) (reflagExpr name flag t) (reflagExpr name flag e)
reflagExpr _ _ e = e

tailSrc : String
tailSrc = "g x = x\nf x = g x\nmain = f 1"

tailShapesSrc : String
tailShapesSrc =
  "g x = x\nh x = if x == 0 then g x else g (g x)\nm x = match x\n  0 => g 1\n  n => let y = g n in g y\nw x = go x\n  where\n    go n = if n == 0 then g n else go (n - 1)\nmain = h 1 + m 2 + w 3"

test "(n) lowering flags every tail call, so a lowered program's tails validate clean" = expectEach
  [
    (
      "a call in a clause body",
      expectEqual [] (validateTails (lowered TargetNative tailSrc)),
    ),
    (
      "if, match, let and where bodies",
      expectEqual [] (validateTails (lowered TargetNative tailShapesSrc)),
    ),
    (
      "wasm lowering",
      expectEqual [] (validateTails (lowered TargetWasm tailShapesSrc)),
    ),
  ]

test "(o) a tail flag against the position is refused, naming head and binding" = expectEach
  [
    (
      "flagged outside tail position",
      expectEqual
        ["tail: f is flagged as a tail call outside tail position [in main]"]
        (validateTails (reflag "f" True (lowered TargetNative tailSrc))),
    ),
    (
      "flagged but partial",
      expectEqual
        [
          "tail: g is flagged as a tail call but is a partial application (CallPartial 1) [in f]",
        ]
        (validateTails
          (reflag
            "g"
            True
            (restamp "g" (CallPartial 1) (lowered TargetNative tailSrc)))),
    ),
    (
      "in tail position but not flagged",
      expectEqual
        [
          "tail: g is in tail position, stamped CallExact, but not flagged [in f]",
        ]
        (validateTails (reflag "g" False (lowered TargetNative tailSrc))),
    ),
  ]
