lowered : String -> CProgram
lowered src =
  lowerProgramEmitWith
    emptyFacts
    (annotateProgram (grantWholeDomain (desugar (parse src))))

test "missing-extern-abi is a fatal metadata defect before target gaps" =
  let (cp@(CProgram groups ca ct impls mc facts)) =
    lowered "main = intToString 42"
  let symbol = runtimeExternSymbol "intToString"
  match omLookup symbol facts.factExterns
    None => fail "lowering omitted the runtime declaration"
    Some fact =>
      let malformed = CProgram groups ca ct impls mc { facts |
        factExterns =
          omInsert symbol { fact | callableShape = None } facts.factExterns,
      }
      let validation =
        validateForEmission
          LlvmBackend
          PreludeFreeRuntime
          (buildEmitPlan LlvmBackend PreludeFreeRuntime malformed)
          malformed
      expectAll [
        expectTextContainsAll
          ["missing-extern-abi", symbol]
          (joinNl (map coreDefectMessage validation.defects)),
        expectEqual [] (map findingExtern validation.externFindings),
      ]

-- The extern names `backend` refuses in `src`, in order of first reference.
refused : Backend -> String -> List String
refused backend src =
  map findingExtern (validateExterns backend [] (lowered src))

refusalLines : Backend -> String -> List String
refusalLines backend src =
  map renderExternFinding (validateExterns backend [] (lowered src))

-- The reason the extern's wasm or llvm row gives, as the row states it.
wasmReason : String -> String
wasmReason name = match catalogRow name
  Some r => match ledgerEntry (rowWasm r)
    Some (_, why) => why
    None => ""
  None => ""

llvmReason : String -> String
llvmReason name = match catalogRow name
  Some r => match ledgerEntry (rowLlvm r)
    Some (_, why) => why
    None => ""
  None => ""

test "(a) wasm: a reference to a net extern is refused, naming extern, backend, kind and reason" =
  expectEqual
    [
      "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in main]",
    ]
    (refusalLines WasmBackend "main = netTcpConnect \"localhost\" 80")

test "(b) wasm: references to a WASM-GAP and a PERMANENT extern are refused, applied or as values, each in its binding" =
  expectEqual
    [
      "wasm: runtime extern 'allocBytes' is not available on the wasm backend (WASM-GAP: \{wasmReason "allocBytes"}) [in save]",
      "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in main]",
    ]
    (refusalLines
      WasmBackend
      "save = allocBytes\nmain =\n  let _ = save ()\n  netTcpConnect \"localhost\" 80")

test "(c) wasm: a program that names an extern only as text, a field or a lowered extern is not refused" =
  expectEqual
    []
    (refused
      WasmBackend
      "data Conn = Conn { netSend : Int }\nmain =\n  let c = Conn { netSend = 1 }\n  putStrLn (\"netSend\" ++ intToString c.netSend)")

test "(d) a local binder or a program binding named like a refused extern shadows it, in its scope only" = expectEach
  [
    (
      "lambda parameter",
      expectEqual
        []
        (refused WasmBackend "main = (allocBytes => allocBytes 1) (x => x)"),
    ),
    (
      "let binding",
      expectEqual
        []
        (refused WasmBackend "main =\n  let netSend = 3\n  netSend + 1"),
    ),
    (
      "match arm",
      expectEqual
        []
        (refused
          WasmBackend
          "main = match Some 1\n  Some allocBytes => allocBytes\n  None => 0"),
    ),
    (
      "top-level binding",
      expectEqual [] (refused WasmBackend "readLine x = x\nmain = readLine 3"),
    ),
    (
      "the extern outside its shadow's scope",
      expectEqual
        ["allocBytes"]
        (refused
          WasmBackend
          "main =\n  let _ = (allocBytes => allocBytes) 1\n  allocBytes ()"),
    ),
  ]

-- Two references to one refused extern, and one to another as a value and
-- applied; the gap events must be exactly the refusal lines a strict build
-- panics with, one per extern.
recordSrc : String
recordSrc =
  "main =\n  let _ = allocBytes ()\n  let _ = allocBytes ()\n  let f = netSend\n  netSend 1 \"x\""

test "(e) record mode logs one event per refused extern, and no unbound-variable event" =
  let decls = grantWholeDomain (desugar (parse recordSrc))
  let input = makeWasmEmitInput PreludeFreeRuntime (ctorFieldTypeNames decls)
  let cp = lowerProgramEmitWith emptyFacts (annotateProgram decls)
  let (wasmPlan, prepared) =
    prepareWasmPlan PreludeFreeRuntime (inputCtorFloatFieldsW input) cp
  let (_, events) = wasmRecord input wasmPlan prepared
  let expected = map ("main\t" ++ _) (refusalLines WasmBackend recordSrc)
  expectAll [
    labelFail
      "the refused externs"
      (expectEqual ["allocBytes", "netSend"] (refused WasmBackend recordSrc)),
    labelFail "record emission" (expectEqual expected events),
    labelFail
      "gap census"
      (expectEqual expected (emitProgramGaps input wasmPlan prepared)),
  ]

assertSnapshotSrc : String
assertSnapshotSrc = "main = assertSnapshot \"a\" \"b\""

test "(f) llvm refuses assertSnapshot and lowers what wasm refuses" = expectEach
  [
    (
      "assertSnapshot on llvm",
      expectEqual
        [
          "llvm: runtime extern 'assertSnapshot' is not available on the llvm backend (TODO: \{llvmReason "assertSnapshot"}) [in main]",
        ]
        (refusalLines LlvmBackend assertSnapshotSrc),
    ),
    (
      "assertSnapshot on wasm, whose row does not lower it either",
      expectEqual ["assertSnapshot"] (refused WasmBackend assertSnapshotSrc),
    ),
    (
      "writeFile on llvm",
      expectEqual [] (refused LlvmBackend "main = writeFile \"a\" \"b\""),
    ),
    ("llvm record mode", llvmRecordEvents),
  ]

llvmRecordEvents : Expectation
llvmRecordEvents =
  let decls = grantWholeDomain (desugar (parse assertSnapshotSrc))
  let input = makeEmitInput PreludeFreeRuntime [] [] 0 [] [] ""
  let cp = lowerProgramEmitWith emptyFacts (annotateProgram decls)
  let (_, events) =
    llvmRecord input (buildEmitPlan LlvmBackend PreludeFreeRuntime cp) cp
  expectEqual
    (map ("main\t" ++ _) (refusalLines LlvmBackend assertSnapshotSrc))
    events

test "(g) a runtime extern with no catalog row is an internal error naming it" =
  let missing = missingCatalogRows ["putStrLn", "zzNoSuchExtern", "netSend"]
  expectAll [
    expectEqual ["zzNoSuchExtern"] missing,
    expectTextContainsAll
      ["internal error", "'zzNoSuchExtern'", "extern catalog"]
      (missingRowsMessage missing),
  ]

-- ── under the target `build` checked ─────────────────────────────────────────

-- What `medaka build` publishes once a program passes the target check: the
-- profile, with each runtime extern's labels as `stdlib/runtime.mdk` declares
-- them.  Naming a profile the program was never checked against is the hook
-- that forces an extern past the check.
checkedUnder : String -> <IO, FileRead> Result String CheckedTarget
checkedUnder name = do
  src <- readFile (underRoot "stdlib/runtime.mdk")
  profile <- lookupProfile name
  Ok (checkedTargetOf profile (parse src))

-- The wasm refusal of `src` as `build` renders it under `profile`.
wasmRefusalUnder : String -> String -> <IO, FileRead> Result String String
wasmRefusalUnder profile src =
  map
    (t =>
      renderExternRefusalUnder
        (Some t)
        (validateExterns WasmBackend [] (lowered src)))
    (checkedUnder profile)

-- What a build says of an extern the profile withholds: `check` should have
-- refused the program, so the line names a compiler bug.
withheldLine : String -> String -> String -> String -> String
withheldLine line name labels profile =
  "\{line}; the target `\{profile}` does not grant \{labels}, which `\{name}` performs; `check` should have refused this program before the wasm backend saw it, so this is a bug in the compiler"

-- What a build says of any other extern past the check: the same compiler
-- bug, with no label to name.
grantedLine : String -> String
grantedLine line =
  "\{line}; `check` should have refused this program before the wasm backend saw it, so this is a bug in the compiler"

test "(y) under a checked target, every finding names a compiler bug, and a withheld label names the label" = expectEach
  [
    (
      "a Net extern named as a value on wasmgc/node",
      expectEqual
        (Ok
          (withheldLine
            "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in fns]"
            "netTcpConnect"
            "Net"
            "wasmgc/node"))
        (wasmRefusalUnder "wasmgc/node" "fns = [netTcpConnect]\nmain = 0"),
    ),
    (
      "a Net extern applied on wasmgc/node, which check refuses before lowering",
      expectEqual
        (Ok
          (withheldLine
            "wasm: runtime extern 'netTcpConnect' is not available on the wasm backend (PERMANENT: \{wasmReason "netTcpConnect"}) [in main]"
            "netTcpConnect"
            "Net"
            "wasmgc/node"))
        (wasmRefusalUnder "wasmgc/node" "main = netTcpConnect \"localhost\" 80"),
    ),
    (
      "an IO extern past the check on wasmgc/wasi-p2, whose IO joins nothing",
      expectEqual
        (Ok
          (withheldLine
            "wasm: runtime extern 'allocBytes' is not available on the wasm backend (WASM-GAP: \{wasmReason "allocBytes"}) [in main]"
            "allocBytes"
            "IO"
            "wasmgc/wasi-p2"))
        (wasmRefusalUnder "wasmgc/wasi-p2" "main = allocBytes ()"),
    ),
    (
      "an IO ratchet row on wasmgc/node, whose IO joins its host labels",
      expectEqual
        (Ok
          (grantedLine
            "wasm: runtime extern 'allocBytes' is not available on the wasm backend (WASM-GAP: \{wasmReason "allocBytes"}) [in main]"))
        (wasmRefusalUnder "wasmgc/node" "main = allocBytes ()"),
    ),
    (
      "a label-less extern names the same bug",
      expectEqual
        (Ok
          (grantedLine
            "wasm: runtime extern 'socketFd' is not available on the wasm backend (PERMANENT: \{wasmReason "socketFd"}) [in main]"))
        (wasmRefusalUnder "wasmgc/node" "main = socketFd 3"),
    ),
    (
      "with no checked target, every line reads as today",
      expectEqual (refusalLines
        WasmBackend
        "main = netTcpConnect \"localhost\" 80") [
        renderExternRefusalUnder
          None
          (validateExterns
            WasmBackend
            []
            (lowered "main = netTcpConnect \"localhost\" 80")),
      ],
    ),
  ]

-- A user FFI extern with only a `c` binding, named as a value.  `check
-- --target` refuses it on every wasm profile (T-TARGET-NO-BINDING), so only a
-- lowering that skipped the target check meets it.
ffiValueSrc : String
ffiValueSrc =
  "extern ffiAddInts : Int -> Int -> <FFI \"c\"> Int\n\nfns = [ffiAddInts]\n\nmain = 0"

-- The wasm record-mode events of `ffiValueSrc` with `checked` published as
-- the target `build` checked it against.  An emitter gap names no binding, so
-- each event's binding column is `?`.
ffiNoJsEvents : Option CheckedTarget -> <IO> List String
ffiNoJsEvents checked =
  let decls = grantWholeDomain (desugar (parse ffiValueSrc))
  let cp = lowerProgramEmitWith emptyFacts (annotateProgram decls)
  let input = makeWasmEmitInput PreludeFreeRuntime (ctorFieldTypeNames decls)
  checkedTarget := checked
  let (wasmPlan, prepared) =
    prepareWasmPlan PreludeFreeRuntime (inputCtorFloatFieldsW input) cp
  let (_, events) = wasmRecord input wasmPlan prepared
  checkedTarget := None
  events

ffiNoJs : String
ffiNoJs =
  "?\twasm: the extern 'ffiAddInts' has no `js` binding, so the module has nothing to import for it; `check --target` refuses a reached extern with no binding for its target's host (T-TARGET-NO-BINDING)"

test "(z) an FFI extern with no js binding is a gap naming the missing binding, with or without a checked target" =
  match checkedUnder "wasmgc/node"
    Err e => expectEqual "" e
    Ok t => expectEach [
      ("under wasmgc/node", expectEqual [ffiNoJs] (ffiNoJsEvents (Some t))),
      ("with no checked target", expectEqual [ffiNoJs] (ffiNoJsEvents None)),
    ]

-- ── record ordinals ──────────────────────────────────────────────────────────

-- Record nodes written out of declared order, for a record, a named-field
-- variant, and a label two records share at different positions.
recordOrderSrc : String
recordOrderSrc =
  "data P = P { a : Int, b : Int }\ndata Q = Q { b : Int, a : Int }\ndata V = V { x : Int, y : Int, z : Int } | W { y : Int }\nmain =\n  let p = P { b = 1, a = 2 }\n  let q = { p | b = 3, a = 4 }\n  let v = V { z = 1, y = 2, x = 3 }\n  let w = V { v | z = 5, x = 6 }\n  p.b + q.a + w.y"

recordFindings : String -> List String
recordFindings src = validateRecords (lowered src)

unstamped : CExpr -> CProgram
unstamped body =
  CProgram
    [CBind "main" [CClause [] body] noDeclLoc noBinderId]
    []
    []
    []
    []
    noDeclFacts

zero : CExpr
zero = CLit (LInt 0)

scalarProgram : String -> String -> CProgram
scalarProgram op tag = unstamped (CBinPrim op zero zero tag noDeclLoc)

test "scalar binop validation accepts every published operator and tag shape" =
  expectEach
    (map
      ((op, tag) => (
        "\{op}@\{tag}",
        expectEqual [] (validateScalarOperators (scalarProgram op tag)),
      ))
      [
        ("+", "Int"),
        ("/", "Float"),
        ("%", "U8"),
        ("*", "U16"),
        ("-", "U32"),
        ("+", "U64"),
        ("/", "I32"),
        ("%", "I64"),
        ("==", "Int"),
        ("<", "Char"),
        (">=", "U64"),
        ("/=", "I64"),
        ("++", ""),
      ])

test "scalar binop validation rejects malformed operator and tag pairs" = expectEach
  [
    (
      "an arithmetic tag on append",
      expectEqual
        ["scalar binop: operator `++` cannot carry scalar tag `Int` [in main]"]
        (validateScalarOperators (scalarProgram "++" "Int")),
    ),
    (
      "an unknown arithmetic tag",
      expectEqual
        [
          "scalar binop: operator `+` cannot carry scalar tag `String` [in main]",
        ]
        (validateScalarOperators (scalarProgram "+" "String")),
    ),
    (
      "an arithmetic-only tag on comparison",
      expectEqual
        ["scalar binop: operator `<` cannot carry scalar tag `Float` [in main]"]
        (validateScalarOperators (scalarProgram "<" "Float")),
    ),
  ]

test "(h) lowering stamps every record node, so a permuted program validates clean" = expectAll
  [
    labelFail "native" (expectEqual [] (recordFindings recordOrderSrc)),
    labelFail "wasm" (expectEqual [] (recordFindings recordOrderSrc)),
  ]

test "(i) a record node the lowering did not stamp is refused, naming the node and binding" = expectEach
  [
    (
      "literal",
      expectEqual
        [
          "record: CRecord P: field ordinals [a@-1] are not the declared positions [in main]",
        ]
        (validateRecords (unstamped (CRecord "P" [CField "a" (-1) zero]))),
    ),
    (
      "access",
      expectEqual
        ["record: CFieldAccess P.a: unstamped field ordinal [in main]"]
        (validateRecords (unstamped (CFieldAccess zero "a" "P" (-1)))),
    ),
    (
      "update",
      expectEqual
        [
          "record: CRecordUpdate P: field ordinals [a@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CRecordUpdate "P" zero [CField "a" (-1) zero]))),
    ),
    (
      "variant update",
      expectEqual
        [
          "record: CVariantUpdate V: field ordinals [x@-1] are not strictly ascending [in main]",
        ]
        (validateRecords
          (unstamped (CVariantUpdate "V" zero [CField "x" (-1) zero]))),
    ),
    (
      "the Ref `.value` read needs no ordinal",
      expectEqual
        []
        (validateRecords (unstamped (CFieldAccess zero "value" "" (-1)))),
    ),
  ]

test "(j) ordinals out of declared position are refused" = expectEach [
  (
    "literal in written order",
    expectEqual
      [
        "record: CRecord P: field ordinals [b@1, a@0] are not the declared positions [in main]",
      ]
      (validateRecords
        (unstamped (CRecord "P" [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
  (
    "update in descending order",
    expectEqual
      [
        "record: CRecordUpdate P: field ordinals [b@1, a@0] are not strictly ascending [in main]",
      ]
      (validateRecords
        (unstamped
          (CRecordUpdate "P" zero [CField "b" 1 zero, CField "a" 0 zero]))),
  ),
]

-- ── call modes ───────────────────────────────────────────────────────────────

-- #2078's program: `mk n = add n` names a user `add` that shares its spelling
-- with an interface method, so the reference lowers as a method occurrence
-- routed to the user's binding, and the eta pass gives `mk` that binding's two
-- parameters.  Typechecked against a two-method prelude, as a build would.
i2078Prelude : String
i2078Prelude =
  "interface Num a where\n  fromInt : Int -> a\n  add : a -> a -> a\nimpl Num Int where\n  fromInt n = n\n  add a b = a"

i2078Src : String
i2078Src =
  "add : Int -> Int -> Int\nadd a b = a\nmk : Int -> Int -> Int\nmk n = add n\napply1 : (Int -> Int) -> Int -> Int\napply1 f x = f x\nmain = apply1 (mk 1) 2"

typedLowered : String -> String -> CProgram
typedLowered preludeSrc src =
  let (decls, facts) = elaborateOneFacts defaultDriveInputs [] (desugar
    (parse preludeSrc)) (
    "calls",
    grantWholeDomain (desugar (parse src)),
  )
  lowerProgramEmitWith facts decls

-- [prog] with every application whose head is the variable [name] re-stamped
-- [mode], in top-level bindings.
restamp : String -> CallMode -> CProgram -> CProgram
restamp name mode (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (restampBind name mode) groups) ctors ctorTypes impls mctx facts

restampBind : String -> CallMode -> CBind -> CBind
restampBind name mode (CBind n clauses site bid) =
  CBind n (map (restampClause name mode) clauses) site bid

restampClause : String -> CallMode -> CClause -> CClause
restampClause name mode (CClause pats body) =
  CClause pats (restampExpr name mode body)

restampExpr : String -> CallMode -> CExpr -> CExpr
restampExpr name mode (CApp hd args (CallSite old tailPos)) =
  let args2 = map (restampExpr name mode) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode tailPos)
      else
        CApp hd args2 (CallSite old tailPos)
    _ => CApp (restampExpr name mode hd) args2 (CallSite old tailPos)
restampExpr name mode (CLet r pat rhs body) =
  CLet r pat (restampExpr name mode rhs) (restampExpr name mode body)
restampExpr name mode (CBlock stmts) =
  CBlock (map (restampStmt name mode) stmts)
restampExpr _ _ e = e

restampStmt : String -> CallMode -> CStmt -> CStmt
restampStmt name mode (CSExpr e) = CSExpr (restampExpr name mode e)
restampStmt name mode (CSLet r pat e) = CSLet r pat (restampExpr name mode e)
restampStmt _ _ s = s

shadowSrc : String
shadowSrc = "eq a b = a\npickEq eq x y = eq x y\nmain = pickEq eq 1 2"

overSrc : String
overSrc = "pre n = x => n + x\nmain = pre 1 2"

test "(k) lowering stamps every application, so a lowered program validates clean" = expectEach
  [
    (
      "#2078's point-free wrapper, typed",
      expectEqual [] (validateCalls (typedLowered i2078Prelude i2078Src)),
    ),
    (
      "a local named like a global",
      expectEqual [] (validateCalls (lowered shadowSrc)),
    ),
    (
      "an over-application",
      expectEqual [] (validateCalls (lowered overSrc)),
    ),
  ]

test "(l) an application stamped against the wrong arity is refused, naming head, counts and binding" = expectEach
  [
    (
      "#2078: the wrapper's call stamped exact against its one source parameter",
      expectEqual
        ["call: mk applied to 1 of 2, stamped CallExact [in main]"]
        (validateCalls
          (restamp "mk" CallExact (typedLowered i2078Prelude i2078Src))),
    ),
    (
      "a known head stamped dynamic",
      expectEqual
        ["call: pickEq applied to 3 of 3, stamped CallDynamic [in main]"]
        (validateCalls (restamp "pickEq" CallDynamic (lowered shadowSrc))),
    ),
    (
      "an over-application with the wrong surplus",
      expectEqual
        ["call: pre applied to 2 of 1, stamped (CallOver 2) [in main]"]
        (validateCalls (restamp "pre" (CallOver 2) (lowered overSrc))),
    ),
    (
      "a local `eq` stamped against the global `eq`'s two parameters",
      expectEqual
        ["call: eq has no static arity, stamped CallExact [in pickEq]"]
        (validateCalls (restamp "eq" CallExact (lowered shadowSrc))),
    ),
  ]

test "(m) an application with no arguments, or whose head is an application, is refused" = expectEach
  [
    (
      "no arguments",
      expectEqual
        ["call: application with no arguments [in main]"]
        (validateCalls (unstamped (CApp zero [] (CallSite CallDynamic False)))),
    ),
    (
      "a nested head",
      expectEqual
        ["call: application whose head is an application [in main]"]
        (validateCalls
          (unstamped
            (CApp
              (CApp zero [zero] (CallSite CallDynamic False))
              [zero]
              (CallSite CallDynamic False)))),
    ),
  ]

-- ── tail flags ───────────────────────────────────────────────────────────────

-- [prog] with the tail flag of every application whose head is the variable
-- [name] set to [flag], in top-level bindings.
reflag : String -> Bool -> CProgram -> CProgram
reflag name flag (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (reflagBind name flag) groups) ctors ctorTypes impls mctx facts

reflagBind : String -> Bool -> CBind -> CBind
reflagBind name flag (CBind n clauses site bid) =
  CBind n (map (reflagClause name flag) clauses) site bid

reflagClause : String -> Bool -> CClause -> CClause
reflagClause name flag (CClause pats body) =
  CClause pats (reflagExpr name flag body)

reflagExpr : String -> Bool -> CExpr -> CExpr
reflagExpr name flag (CApp hd args (CallSite mode old)) =
  let args2 = map (reflagExpr name flag) args
  match hd
    CVar x _ =>
      if x == name then
        CApp hd args2 (CallSite mode flag)
      else
        CApp hd args2 (CallSite mode old)
    _ => CApp (reflagExpr name flag hd) args2 (CallSite mode old)
reflagExpr name flag (CLet r pat rhs body) =
  CLet r pat (reflagExpr name flag rhs) (reflagExpr name flag body)
reflagExpr name flag (CIf c t e) =
  CIf (reflagExpr name flag c) (reflagExpr name flag t) (reflagExpr name flag e)
reflagExpr _ _ e = e

tailSrc : String
tailSrc = "g x = x\nf x = g x\nmain = f 1"

tailShapesSrc : String
tailShapesSrc =
  "g x = x\nh x = if x == 0 then g x else g (g x)\nm x = match x\n  0 => g 1\n  n => let y = g n in g y\nw x = go x\n  where\n    go n = if n == 0 then g n else go (n - 1)\nmain = h 1 + m 2 + w 3"

test "(n) lowering flags every tail call, so a lowered program's tails validate clean" = expectEach
  [
    (
      "a call in a clause body",
      expectEqual [] (validateTails (lowered tailSrc)),
    ),
    (
      "if, match, let and where bodies",
      expectEqual [] (validateTails (lowered tailShapesSrc)),
    ),
    (
      "wasm lowering",
      expectEqual [] (validateTails (lowered tailShapesSrc)),
    ),
  ]

test "(o) a tail flag against the position is refused, naming head and binding" = expectEach
  [
    (
      "flagged outside tail position",
      expectEqual
        ["tail: f is flagged as a tail call outside tail position [in main]"]
        (validateTails (reflag "f" True (lowered tailSrc))),
    ),
    (
      "flagged but partial",
      expectEqual
        [
          "tail: g is flagged as a tail call but is a partial application (CallPartial 1) [in f]",
        ]
        (validateTails
          (reflag "g" True (restamp "g" (CallPartial 1) (lowered tailSrc)))),
    ),
    (
      "in tail position but not flagged",
      expectEqual
        [
          "tail: g is in tail position, stamped CallExact, but not flagged [in f]",
        ]
        (validateTails (reflag "g" False (lowered tailSrc))),
    ),
  ]

-- ── let-bound lambdas ───────────────────────────────────────────────────────

-- A `let` of a lambda, as a block statement or a `let ... in`, is a function
-- local of the lambda's parameter count: an exact call of it and an
-- over-application of a curried one.
letLamSrc : String
letLamSrc =
  "main =\n  let f = x => x + 1\n  let g = x => y => x + y\n  g (f 2) 3"

letInLamSrc : String
letInLamSrc = "main = let f = x => x + 1 in f 2"

test "(p) a call of a let-bound lambda is read against the lambda's parameters" = expectEach
  [
    (
      "lowering stamps both calls, so the program validates clean",
      expectEqual [] (validateCalls (lowered letLamSrc)),
    ),
    (
      "a `let ... in` of a lambda validates clean",
      expectEqual [] (validateCalls (lowered letInLamSrc)),
    ),
    (
      "an exact call stamped dynamic",
      expectEqual
        ["call: f applied to 1 of 1, stamped CallDynamic [in main]"]
        (validateCalls (restamp "f" CallDynamic (lowered letLamSrc))),
    ),
    (
      "an over-application stamped dynamic",
      expectEqual
        ["call: g applied to 2 of 1, stamped CallDynamic [in main]"]
        (validateCalls (restamp "g" CallDynamic (lowered letLamSrc))),
    ),
  ]

-- ── impl entry groups ───────────────────────────────────────────────────────

-- Two clauses of one impl method: the eta pass could give `foo A`'s
-- point-free tail (`add` is a method name routed to the user's binding) a
-- second parameter, but `foo B`'s tail is not atomic.
mixedGroupSrc : String
mixedGroupSrc =
  "add : Int -> Int -> Int\nadd a b = a + b\nsub : Int -> Int -> Int\nsub a b = a - b\ninterface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = add 1\n  foo B = sub (3 + 0)\nmain = foo A 5"

-- [prog] with one more parameter on the first impl entry of method [m].
widenFirstEntry : String -> CProgram -> CProgram
widenFirstEntry m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (widenEntries m impls) mctx facts

widenEntries : String -> List CImplEntry -> List CImplEntry
widenEntries _ [] = []
widenEntries m ((ent@(CImplEntry n s d body)) :: rest) =
  if n == m then
    CImplEntry n s d (widenBody body) :: rest
  else
    ent :: widenEntries m rest

widenBody : CImplBody -> CImplBody
widenBody (CImplTagged tag key iface sym pos pats body) =
  CImplTagged
    tag
    key
    iface
    sym
    pos
    (pats ++ [PVar "w" noDeclLoc noBinderId])
    body
widenBody (CImplDefault w tag key sym pos pats body) =
  CImplDefault w tag key sym pos (pats ++ [PVar "w" noDeclLoc noBinderId]) body

test "(q) the impl entries of one method and route word take one arity" = expectEach
  [
    (
      "the eta pass expands a group whole or not at all, so it validates clean",
      expectEqual [] (validateCalls (typedLowered i2078Prelude mixedGroupSrc)),
    ),
    (
      "an entry widened apart from its group is refused",
      expectEqual
        [
          "call: impl entry takes 1 value parameters, the first entry of its group 2 [in impl foo@calls.T]",
        ]
        (validateCalls
          (widenFirstEntry "foo" (typedLowered i2078Prelude mixedGroupSrc))),
    ),
  ]

-- [prog] with every impl entry's stamped symbol cleared, as a lowering that
-- never stamped would leave it.
unstampImpls : CProgram -> CProgram
unstampImpls (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map unstampEntry impls) mctx facts

unstampEntry : CImplEntry -> CImplEntry
unstampEntry (CImplEntry n s d (CImplTagged tag key iface _ pos pats body)) =
  CImplEntry n s d (CImplTagged tag key iface noImplSym pos pats body)
unstampEntry (CImplEntry n s d (CImplDefault w tag key _ pos pats body)) =
  CImplEntry n s d (CImplDefault w tag key noImplSym pos pats body)

-- [prog] with every supplied method's interface word replaced by [word].
reword : String -> CProgram -> CProgram
reword word (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (rewordEntry word) impls) mctx facts

rewordEntry : String -> CImplEntry -> CImplEntry
rewordEntry word (CImplEntry n s d (CImplTagged tag key _ sym pos pats body)) =
  CImplEntry n s d (CImplTagged tag key word sym pos pats body)
rewordEntry _ ent = ent

test "(t) every impl entry carries its stamped symbol and its qualified interface word" = expectEach
  [
    (
      "lowering stamps both, so a lowered program validates clean",
      expectEqual [] (validateImplSymbols (lowered mixedGroupSrc)),
    ),
    (
      "an entry with no stamped symbol is refused",
      expectEqual
        [
          "impl symbol: entry has no stamped symbol [in impl foo@T]",
          "impl symbol: entry has no stamped symbol [in impl foo@T]",
        ]
        (validateImplSymbols (unstampImpls (lowered mixedGroupSrc))),
    ),
    (
      "an interface word that is not the qualified word of the entry's key is refused",
      expectEqual
        [
          "impl symbol: interface word `Other` is not the qualified word `Foo` of its key [in impl foo@T]",
          "impl symbol: interface word `Other` is not the qualified word `Foo` of its key [in impl foo@T]",
        ]
        (validateImplSymbols (reword "Other" (lowered mixedGroupSrc))),
    ),
  ]

-- ── impl-symbol and dict-tag injectivity ────────────────────────────────────

-- Two impls of one method at head tycons whose djb2 hashes agree in the full
-- width (`hashName "Mzone" == hashName "NYone"`).
fullWidthSrc : String
fullWidthSrc =
  "interface Zn a where\n  zn : a -> String\ndata Mzone = Mzone\ndata NYone = NYone\nimpl Zn Mzone where\n  zn _ = \"mzone\"\nimpl Zn NYone where\n  zn _ = \"nyone\"\nmain = zn Mzone"

-- The same shape at head tycons whose hashes differ but agree in the low 30 bits.
narrowWidthSrc : String
narrowWidthSrc =
  "interface Zn a where\n  zn : a -> String\ndata Dbnfbcp = Dbnfbcp\ndata Llzhriz = Llzhriz\nimpl Zn Dbnfbcp where\n  zn _ = \"d\"\nimpl Zn Llzhriz where\n  zn _ = \"l\"\nmain = zn Dbnfbcp"

faultList : Option String -> List String
faultList (Some message) = [message]
faultList None = []

-- [prog] with every supplied method's emitted symbol restamped to one tag.
sameSymbol : CProgram -> CProgram
sameSymbol (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map sameSymbolEntry impls) mctx facts

sameSymbolEntry : CImplEntry -> CImplEntry
sameSymbolEntry (CImplEntry n s d (CImplTagged tag key iface _ pos pats body)) =
  CImplEntry
    n
    s
    d
    (CImplTagged tag key iface (ImplSym "Same" "Same" "Same") pos pats body)
sameSymbolEntry ent = ent

test "(u) two distinct impls colliding on one dict-witness tag are refused, per tag width" = expectEach
  [
    (
      "a full-width hash collision is refused for llvm",
      expectTextContainsAll
        [
          "emitted dict-witness tag collision",
          "method `zn`",
          "Mzone",
          "NYone",
          "native (LLVM) i64",
        ]
        (joinNl
          (faultList (dictTagCollision LlvmBackend (lowered fullWidthSrc)))),
    ),
    (
      "a full-width hash collision is refused for wasm in the native space",
      expectTextContainsAll
        ["emitted dict-witness tag collision", "native (LLVM) i64"]
        (joinNl
          (faultList (dictTagCollision WasmBackend (lowered fullWidthSrc)))),
    ),
    (
      "a 30-bit-only collision is not refused for llvm",
      expectEqual
        []
        (faultList (dictTagCollision LlvmBackend (lowered narrowWidthSrc))),
    ),
    (
      "a 30-bit-only collision is refused for wasm",
      expectTextContainsAll
        [
          "emitted dict-witness tag collision",
          "tag space: wasm (WasmGC) 30-bit"
        ]
        (joinNl
          (faultList (dictTagCollision WasmBackend (lowered narrowWidthSrc)))),
    ),
    (
      "a program without a collision is accepted by both",
      expectEqual
        []
        (faultList (dictTagCollision LlvmBackend (lowered mixedGroupSrc))
          ++ faultList (dictTagCollision WasmBackend (lowered mixedGroupSrc))),
    ),
  ]

test "(v) two distinct impls stamped to one emitted symbol are refused" = expectEach
  [
    (
      "restamped to one symbol tag, the pair is refused",
      expectTextContainsAll
        ["emitted impl-symbol collision", "mdk_impl_Same_zn"]
        (joinNl
          (faultList (implSymbolCollision (sameSymbol (lowered fullWidthSrc))))),
    ),
    (
      "as lowered, the symbols are distinct",
      expectEqual [] (faultList (implSymbolCollision (lowered fullWidthSrc))),
    ),
    (
      "the clauses of one impl share its symbol without a collision",
      expectEqual
        []
        (faultList (implSymbolCollision (sameSymbol (lowered mixedGroupSrc)))),
    ),
  ]

-- ── inherited defaults in the dict-tag space ────────────────────────────────

-- `zn` has a default.  The first instance supplies `zn`, the second inherits it, so
-- both entries are arms of `zn`'s one dispatcher, and each arm compares its own
-- instance's word.  Typechecked, since only an elaborated program lowers the
-- inherited entries.
defaultSrc : String -> String -> String
defaultSrc supplied inherited =
  "interface Zn a where\n  zn : a -> String\n  zn _ = \"default\"\ndata \{supplied} = \{supplied}\ndata \{inherited} = \{inherited}\nimpl Zn \{supplied} where\n  zn _ = \"s\"\nimpl Zn \{inherited}\nmain = zn \{inherited}"

defaultTags : Backend -> String -> String -> List String
defaultTags backend supplied inherited =
  faultList
    (dictTagCollision backend (typedLowered "" (defaultSrc supplied inherited)))

test "(af) a supplied impl colliding with an inherited default is refused, per tag width" = expectEach
  [
    (
      "a full-width collision is refused for llvm",
      expectTextContainsAll
        [
          "emitted dict-witness tag collision",
          "method `zn`",
          "Mzone",
          "NYone",
          "native (LLVM) i64",
        ]
        (joinNl (defaultTags LlvmBackend "Mzone" "NYone")),
    ),
    (
      "a full-width collision is refused for wasm in the native space",
      expectTextContainsAll
        ["emitted dict-witness tag collision", "native (LLVM) i64"]
        (joinNl (defaultTags WasmBackend "Mzone" "NYone")),
    ),
    (
      "a 30-bit-only collision is not refused for llvm",
      expectEqual [] (defaultTags LlvmBackend "Dbnfbcp" "Llzhriz"),
    ),
    (
      "a 30-bit-only collision is refused for wasm",
      expectTextContainsAll
        [
          "emitted dict-witness tag collision",
          "tag space: wasm (WasmGC) 30-bit",
          "Dbnfbcp",
          "Llzhriz",
        ]
        (joinNl (defaultTags WasmBackend "Dbnfbcp" "Llzhriz")),
    ),
    (
      "distinct words are accepted by both",
      expectEqual
        []
        (defaultTags LlvmBackend "Mzone" "Pqrst"
          ++ defaultTags WasmBackend "Mzone" "Pqrst"),
    ),
  ]

-- ── method contexts ─────────────────────────────────────────────────────────

-- `desc`'s declared context constrains only the interface parameter, so each
-- call supplies the `Show2 (Pair b)` dictionary and the impl entry takes it.
paramContextSrc : String
paramContextSrc =
  "data Pair a = Pair a a\ninterface Show2 a where\n  show2 : a -> String\nimpl Show2 Int where\n  show2 n = \"int\"\nimpl Show2 (Pair b) requires Show2 b where\n  show2 (Pair x _) = show2 x\ninterface Desc a where\n  desc : Show2 a => a -> String\nimpl Desc (Pair b) where\n  desc p = show2 p\nmain = desc (Pair (1 : Int) 2)"

-- [prog] with the method routes of every top-level application of method [name]
-- dropped, as an elaboration that posed no goal for the context would leave it.
dropMethodRoutes : String -> CProgram -> CProgram
dropMethodRoutes name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (dropRoutesBind name) groups) ctors ctorTypes impls mctx facts

dropRoutesBind : String -> CBind -> CBind
dropRoutesBind name (CBind n clauses site bid) =
  CBind n (map (dropRoutesClause name) clauses) site bid

dropRoutesClause : String -> CClause -> CClause
dropRoutesClause name (CClause pats body) =
  CClause pats (dropRoutesExpr name body)

dropRoutesExpr : String -> CExpr -> CExpr
dropRoutesExpr name (CApp hd args site) =
  CApp (dropRoutesExpr name hd) (map (dropRoutesExpr name) args) site
dropRoutesExpr name (m@(CMethod n (MethodEvidence iface arity route impls _))) =
  if n == name then CMethod n (MethodEvidence iface arity route impls []) else m
dropRoutesExpr _ e = e

-- [prog] with the leading parameter of every impl entry of method [m] dropped.
dropEntryDict : String -> CProgram -> CProgram
dropEntryDict m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (dropEntryDictOne m) impls) mctx facts

dropEntryDictOne : String -> CImplEntry -> CImplEntry
dropEntryDictOne m (ent@(CImplEntry n s d body)) =
  if n == m then CImplEntry n s d (dropFirstPat body) else ent

dropFirstPat : CImplBody -> CImplBody
dropFirstPat (CImplTagged tag key iface sym pos (_ :: pats) body) =
  CImplTagged tag key iface sym pos pats body
dropFirstPat (CImplDefault w tag key sym pos (_ :: pats) body) =
  CImplDefault w tag key sym pos pats body
dropFirstPat b = b

test "(u) a method's dictionaries match its declared context" = expectEach [
  (
    "a context over only the interface parameter: lowered, it validates clean",
    expectEqual
      []
      (validateMethodContexts (typedLowered i2078Prelude paramContextSrc)),
  ),
  (
    "a call that supplies no route for the context is refused",
    expectEqual
      [
        "method context: method desc supplies 0 method routes, `calls::Desc` declares 1 [in main]",
      ]
      (validateMethodContexts
        (dropMethodRoutes "desc" (typedLowered i2078Prelude paramContextSrc))),
  ),
  (
    "an impl entry that takes no dictionary for the context is refused",
    expectEqual
      [
        "method context: impl entry opens with 0 `$dict_desc_k` parameters, `calls::Desc` declares 1 and its instance requires 0 [in impl desc@calls.Pair]",
      ]
      (validateMethodContexts
        (dropEntryDict "desc" (typedLowered i2078Prelude paramContextSrc))),
  ),
]

-- `size` declares no context, so the method-context table has no row for it.
contextFreeSrc : String
contextFreeSrc =
  "interface Size a where\n  size : a -> Int\nimpl Size Int where\n  size n = n\nmain = size (3 : Int)"

-- [prog] with one more method route on every top-level application of method
-- [name], as an elaboration that read another declaration's context would leave it.
addMethodRoute : String -> CProgram -> CProgram
addMethodRoute name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (addRouteBind name) groups) ctors ctorTypes impls mctx facts

addRouteBind : String -> CBind -> CBind
addRouteBind name (CBind n clauses site bid) =
  CBind n (map (addRouteClause name) clauses) site bid

addRouteClause : String -> CClause -> CClause
addRouteClause name (CClause pats body) = CClause pats (addRouteExpr name body)

addRouteExpr : String -> CExpr -> CExpr
addRouteExpr name (CApp hd args site) =
  CApp (addRouteExpr name hd) (map (addRouteExpr name) args) site
addRouteExpr name (m@(CMethod n (MethodEvidence iface arity route impls meths))) =
  if n == name then
    CMethod n (MethodEvidence iface arity route impls (meths ++ [route]))
  else
    m
addRouteExpr _ e = e

-- [prog] with a leading `$dict_<m>_0` parameter on every impl entry of method [m].
addEntryDict : String -> CProgram -> CProgram
addEntryDict m (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram groups ctors ctorTypes (map (addEntryDictOne m) impls) mctx facts

addEntryDictOne : String -> CImplEntry -> CImplEntry
addEntryDictOne m (ent@(CImplEntry n s d body)) =
  if n == m then CImplEntry n s d (addFirstPat m body) else ent

addFirstPat : String -> CImplBody -> CImplBody
addFirstPat m (CImplTagged tag key iface sym pos pats body) =
  CImplTagged
    tag
    key
    iface
    sym
    pos
    (PVar "$dict_\{m}_0" noDeclLoc noBinderId :: pats)
    body
addFirstPat m (CImplDefault w tag key sym pos pats body) =
  CImplDefault
    w
    tag
    key
    sym
    pos
    (PVar "$dict_\{m}_0" noDeclLoc noBinderId :: pats)
    body

test "(x) a method with no declared context takes no context dictionary" = expectEach
  [
    (
      "lowered, a context-free method validates clean",
      expectEqual
        []
        (validateMethodContexts (typedLowered i2078Prelude contextFreeSrc)),
    ),
    (
      "a call that supplies a method route to it is refused",
      expectEqual
        [
          "method context: method size supplies 1 method routes, `calls::Size` declares 0 [in main]",
        ]
        (validateMethodContexts
          (addMethodRoute "size" (typedLowered i2078Prelude contextFreeSrc))),
    ),
    (
      "an impl entry that opens with a context dictionary for it is refused",
      expectEqual
        [
          "method context: impl entry opens with 1 `$dict_size_k` parameters, `calls::Size` declares 0 and its instance requires 0 [in impl size@Int]",
        ]
        (validateMethodContexts
          (addEntryDict "size" (typedLowered i2078Prelude contextFreeSrc))),
    ),
  ]

-- A program whose `g` takes one dictionary and whose `main` binds `$dict_m_0`,
-- with `body` as main's body.  Instance `K` requires nothing and its interface has
-- no supers; instance `S` requires nothing and its interface has one super.
evidenceProg : CExpr -> CProgram
evidenceProg body =
  CProgram
    [
      CBind
        "g"
        [CClause [PVar "$dict_g_0" noDeclLoc noBinderId] (CLit (LInt 1))]
        noDeclLoc
        noBinderId,
      CBind
        "main"
        [CClause [PVar "$dict_m_0" noDeclLoc noBinderId] body]
        noDeclLoc
        noBinderId,
    ]
    []
    []
    []
    []
    DeclFacts {
      factMethodResults = [],
      factRequires = [("K", 0), ("S", 0)],
      factSupers = [("K", 0), ("S", 1)],
      factBinders = [],
      factEntryOutcome = None,
      factExterns = noDeclFacts.factExterns,
      factManifests = [],
    }

evidenceOf : Route -> CExpr
evidenceOf route = CMethod "show" (MethodEvidence "I" 1 route [] [])

test "(v) a dispatch node's evidence denotes dictionaries its callee binds" = expectEach
  [
    (
      "a lowered program validates clean",
      expectEqual
        []
        (validateDispatchEvidence (typedLowered i2078Prelude paramContextSrc)),
    ),
    (
      "hand-built evidence over a bound given validates clean",
      expectEqual
        []
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RProj (RDict "$dict_m_0") [0]]))),
    ),
    (
      "a dictionary the occurrence does not bind is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) reads dictionary `$dict_zz`, which is not bound here [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RDict "$dict_zz"]))),
    ),
    (
      "a projection over an instance is refused",
      expectEqual
        [
          "dispatch evidence: method show projects from a route that is not a given dictionary [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (evidenceOf (RProj (RKey "K" [] []) [0])))),
    ),
    (
      "a head instance key with no entry is refused",
      expectEqual
        [
          "dispatch evidence: method show names instance `Nope` that has no entry for `show` [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (evidenceOf (RKey "Nope" [] [])))),
    ),
    (
      "a dictionary application with an extra slot is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) supplies 2 dictionaries, `g` takes 1 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RDict "$dict_m_0", RDict "$dict_m_0"]))),
    ),
    (
      "a scalar route in a slot is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) carries scalar route `Int` [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RScalar "Int"]))),
    ),
    (
      "a dictionary slot with no route is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) has a dictionary slot with no route [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RNone]))),
    ),
    (
      "a method occurrence naming its interface with no route is refused",
      expectEqual
        ["dispatch evidence: method show has no route [in main]"]
        (validateDispatchEvidence
          (evidenceProg (CMethod "show" (MethodEvidence "Show" 1 RNone [] [])))),
    ),
    (
      "a standalone method occurrence with no interface word is not a hole",
      expectEqual
        []
        (validateDispatchEvidence
          (evidenceProg (CMethod "show" (MethodEvidence "" 1 RNone [] [])))),
    ),
  ]

-- [prog] with the prerequisite routes of every dictionary built in the method
-- routes of each top-level occurrence of method [name] dropped.
dropBuiltPrereqs : String -> CProgram -> CProgram
dropBuiltPrereqs name (CProgram groups ctors ctorTypes impls mctx facts) =
  CProgram (map (dropPrereqsBind name) groups) ctors ctorTypes impls mctx facts

dropPrereqsBind : String -> CBind -> CBind
dropPrereqsBind name (CBind n clauses site bid) =
  CBind n (map (dropPrereqsClause name) clauses) site bid

dropPrereqsClause : String -> CClause -> CClause
dropPrereqsClause name (CClause pats body) =
  CClause pats (dropPrereqsExpr name body)

dropPrereqsExpr : String -> CExpr -> CExpr
dropPrereqsExpr name (CApp hd args site) =
  CApp (dropPrereqsExpr name hd) (map (dropPrereqsExpr name) args) site
dropPrereqsExpr name (m@(CMethod n (MethodEvidence iface arity route impls meths))) =
  if n == name then
    CMethod n (MethodEvidence iface arity route impls (map dropReqs meths))
  else
    m
dropPrereqsExpr _ e = e

dropReqs : Route -> Route
dropReqs (RKey key _ sups) = RKey key [] sups
dropReqs r = r

test "(w) a built dictionary matches the declarations, and a dispatch names its interface" = expectEach
  [
    (
      "a dictionary built with a prerequisite its instance does not require is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `K` from 1 prerequisite dictionaries, it requires 0 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RKey "K" [RDict "$dict_m_0"] []]))),
    ),
    (
      "a dictionary built without its interface's super is refused",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `S` with 0 super dictionaries, `S` has 1 [in main]",
        ]
        (validateDispatchEvidence (evidenceProg (CDict "g" [RKey "S" [] []]))),
    ),
    (
      "a dictionary of an undeclared instance stores nothing",
      expectEqual
        [
          "dispatch evidence: g (constrained) builds instance `Q` from 1 prerequisite dictionaries, it requires 0 [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg (CDict "g" [RKey "Q" [RDict "$dict_m_0"] []]))),
    ),
    (
      "a dispatch through a given with no interface word is refused",
      expectEqual
        [
          "dispatch evidence: method show dispatches with no interface word [in main]",
        ]
        (validateDispatchEvidence
          (evidenceProg
            (CMethod "show" (MethodEvidence "" 1 (RDict "$dict_m_0") [] [])))),
    ),
    (
      "a lowered dictionary missing its prerequisite is refused",
      expectEqual
        [
          "dispatch evidence: method desc builds instance `calls::Show2|(calls.Pair b)|` from 0 prerequisite dictionaries, it requires 1 [in main]",
        ]
        (validateDispatchEvidence
          (dropBuiltPrereqs "desc" (typedLowered i2078Prelude paramContextSrc))),
    ),
  ]

-- An impl group whose first clause returns a lambda literal: that clause takes
-- the lambda's parameter, so both entries take two.  When a `let` stands before
-- the lambda, the clause keeps its one parameter and the group is refused.
lamGroupSrc : String
lamGroupSrc =
  "interface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = (y => y + 1)\n  foo B y = y - 3\nmain = foo A 5"

letLamGroupSrc : String
letLamGroupSrc =
  "interface Foo a where\n  foo : a -> Int -> Int\ndata T = A | B\nimpl Foo T where\n  foo A = let z = 1 + 0 in (y => y + z)\n  foo B y = y - 3\nmain = foo A 5"

test "(r) an impl clause returning a lambda literal takes the lambda's parameters" = expectEach
  [
    (
      "the group then takes one arity and validates clean",
      expectEqual [] (validateCalls (typedLowered i2078Prelude lamGroupSrc)),
    ),
    (
      "a clause with a `let` before its lambda keeps its arity and is refused",
      expectEqual
        [
          "call: impl entry takes 2 value parameters, the first entry of its group 1 [in impl foo@calls.T]",
        ]
        (validateCalls (typedLowered i2078Prelude letLamGroupSrc)),
    ),
  ]

-- ── the `Ref` read ──────────────────────────────────────────────────────────

-- A record that declares a field `value`, beside a `Ref` read `!r`.
refValueSrc : String
refValueSrc =
  "data Entry = Entry { name : String, value : Int }\nmain =\n  let e = Entry { name = \"k\", value = 42 }\n  let r = e\n  !r"

test "(s) `.value` is the Ref read, never a record field" = expectEach [
  (
    "lowering leaves `!r` unstamped though a record declares `value`",
    expectAll [
      labelFail "native" (expectEqual [] (recordFindings refValueSrc)),
      labelFail "wasm" (expectEqual [] (recordFindings refValueSrc)),
    ],
  ),
  (
    "a `.value` read stamped with a record ordinal is refused",
    expectEqual
      [
        "record: CFieldAccess Entry.value: a Ref read stamped with field ordinal 1 [in main]",
      ]
      (validateRecords (unstamped (CFieldAccess zero "value" "Entry" 1))),
  ),
]

-- ── binder stamps ───────────────────────────────────────────────────────────

-- Parameters, a `let` of a string, of a pair and of an Int, and a lambda.
stampSrc : String
stampSrc =
  "f x = x\nmain =\n  let s = \"a\"\n  let t = (1, 2)\n  let n = 5\n  let h = k => k + n\n  f (h n)"

-- The programs of `test/engine_fixtures` that bind a parameter, a `let`, a match
-- arm or a record pun, or define a where/let-group function, and need no import.
stampCorpus : List String
stampCorpus = [
  "adt_deriving_ord",
  "adt_nested",
  "arrays_ranges",
  "box_do",
  "call_mode_arity",
  "dispatch_basic",
  "guards_where",
  "hof_compose",
  "letgroup_toplevel",
  "letrec_mutual",
  "local_two_num_dicts",
  "numlit_local_concrete_capture",
  "numlit_recursive_nonlead",
  "record_field_emit_interleave_2049",
  "shadowed_binders",
  "where_dict_forward",
  "where_generalize_num",
  "where_value_shadows_prelude",
]

-- [path] elaborated against the real prelude and lowered as a native build does.
loweredFixture : String -> <IO, FileRead> Result String CProgram
loweredFixture name = do
  src <- readFile (underRoot "test/engine_fixtures/\{name}.mdk")
  loweredSource src

-- [src] elaborated against the real prelude and lowered as a native build does.
loweredSource : String -> <IO, FileRead> Result String CProgram
loweredSource src = do
  rsrc <- readFile (underRoot "stdlib/runtime.mdk")
  csrc <- readFile (underRoot "stdlib/core.mdk")
  let (decls, facts) = elaborateOneFacts defaultDriveInputs (desugar
    (parse rsrc)) (desugar (parse csrc)) (
    "main",
    grantWholeDomain (desugar (parse src)),
  )
  Ok (lowerProgramEmitWith facts decls)

stampFixture : String -> <IO, FileRead> Expectation
stampFixture name = match loweredFixture name
  Ok prog => labelFail name (expectEqual [] (validateBinderStamps prog))
  Err e => fail e

test "(aa) lowering stamps every binder and every function's return, so a lowered program's binders validate clean" =
  expectAll
    (labelFail
        "a typed program with parameters, lets and a lambda"
        (expectEqual
          []
          (validateBinderStamps (typedLowered i2078Prelude stampSrc)))
      :: map stampFixture stampCorpus)

-- [prog] with its binder table emptied, and with the row named [name] retyped.
dropBinderTable : CProgram -> CProgram
dropBinderTable (CProgram groups ctors ctorTypes impls mctx facts) = CProgram
  groups
  ctors
  ctorTypes
  impls
  mctx
  DeclFacts {
    factMethodResults = facts.factMethodResults,
    factRequires = facts.factRequires,
    factSupers = facts.factSupers,
    factBinders = [],
    factEntryOutcome = facts.factEntryOutcome,
    factExterns = facts.factExterns,
    factManifests = facts.factManifests,
  }

restampBinder : String -> RuntimeType -> CProgram -> CProgram
restampBinder name ty (CProgram groups ctors ctorTypes impls mctx facts) = CProgram
  groups
  ctors
  ctorTypes
  impls
  mctx
  DeclFacts {
    factMethodResults = facts.factMethodResults,
    factRequires = facts.factRequires,
    factSupers = facts.factSupers,
    factEntryOutcome = facts.factEntryOutcome,
    factExterns = facts.factExterns,
    factManifests = facts.factManifests,
    factBinders =
      map
        (row =>
          if row.brName == name then
            BinderRow {
              brId = row.brId,
              brName = row.brName,
              brType = ty,
              brReturns = row.brReturns,
              brSigned = row.brSigned,
            }
          else
            row)
        facts.factBinders,
  }

test "(ab) a binder with no stamped type is refused, naming it and its binding" = expectEach
  [
    (
      "a parameter",
      expectEqual
        ["binder: x has no stamped type [in f]"]
        (take
          1
          (validateBinderStamps
            (dropBinderTable (typedLowered i2078Prelude stampSrc)))),
    ),
    (
      "a hand-built binder with no id",
      expectEqual
        [
          "binder: x has no id, so no stamped type [in main]",
          "function: main has no id, so no return type [in main]",
        ]
        (validateBinderStamps
          (CProgram
            [
              CBind
                "main"
                [CClause [PVar "x" noDeclLoc noBinderId] (CLit (LInt 0))]
                noDeclLoc
                noBinderId,
            ]
            []
            []
            []
            []
            noDeclFacts)),
    ),
  ]

-- Exactly one fault, whose text holds [needles]; lowering renames a local, so the
-- binder's own spelling is not asserted.
oneFault : List String -> CProgram -> Expectation
oneFault needles prog = match validateBinderStamps prog
  [fault] => expectTextContainsAll needles fault
  faults => expectEqual 1 (listLen faults)

-- `main = { let n = 5 }` with the binder `n` stamped [ty]; the typed lowering wraps
-- an integer literal in `fromInt`, so the bare literal is built by hand.
intLetProg : RuntimeType -> CProgram
intLetProg ty =
  let bid = BinderId "" 7001
  let mainId = BinderId "" 7002
  CProgram
    [
      CBind
        "main"
        [
          CClause
            []
            (CBlock [
              CSLet False (PVar "n" noDeclLoc bid) (CLit (LInt 5)),
              CSExpr (CLit LUnit),
            ]),
        ]
        noDeclLoc
        mainId,
    ]
    []
    []
    []
    []
    DeclFacts {
      factMethodResults = [],
      factRequires = [],
      factSupers = [],
      factEntryOutcome = None,
      factExterns = noDeclFacts.factExterns,
      factManifests = [],
      factBinders = [
        BinderRow {
          brId = bid,
          brName = "n",
          brType = ty,
          brReturns = None,
          brSigned = False,
        },
        BinderRow {
          brId = mainId,
          brName = "main",
          brType = RTUnit,
          brReturns = Some RTUnit,
          brSigned = False,
        },
      ],
    }

test "(ac) a binder stamped against its own literal or constructor is refused" = expectEach
  [
    (
      "a string bound to an Int",
      oneFault
        ["is stamped RTInt but is bound to a RTString literal [in main]"]
        (restampBinder "s" RTInt (typedLowered i2078Prelude stampSrc)),
    ),
    (
      "a pair bound to a Float",
      oneFault
        ["is stamped RTFloat but is bound to a constructor cell [in main]"]
        (restampBinder "t" RTFloat (typedLowered i2078Prelude stampSrc)),
    ),
    (
      "a user constructor bound to an Int",
      oneFault
        ["is stamped RTInt but is bound to a constructor cell [in main]"]
        (restampBinder
          "b"
          RTInt
          (typedLowered
            i2078Prelude
            "data Box = Box Int\nmain =\n  let b = Box 1\n  b")),
    ),
    (
      "an integer literal bound to a String",
      oneFault
        ["is stamped RTString but is bound to an integer literal [in main]"]
        (intLetProg RTString),
    ),
    (
      "an integer literal stamped Float is a Num-defaulted binder, not a fault",
      expectEqual [] (validateBinderStamps (intLetProg RTFloat)),
    ),
    (
      "a stamp of no static fact contradicts nothing",
      expectEqual
        []
        (validateBinderStamps
          (restampBinder "s" RTValue (typedLowered i2078Prelude stampSrc))),
    ),
  ]

-- [prog] with the rows named [name] dropped, or with their return type dropped.
dropRowsNamed : String -> CProgram -> CProgram
dropRowsNamed name prog =
  editRows (rows => filter (r => r.brName /= name) rows) prog

dropReturnsNamed : String -> CProgram -> CProgram
dropReturnsNamed name prog =
  editRows
    (rows =>
      map
        (r =>
          if r.brName == name then
            BinderRow {
              brId = r.brId,
              brName = r.brName,
              brType = r.brType,
              brReturns = None,
              brSigned = r.brSigned,
            }
          else
            r)
        rows)
    prog

editRows : (List BinderRow -> List BinderRow) -> CProgram -> CProgram
editRows edit (CProgram groups ctors ctorTypes impls mctx facts) = CProgram
  groups
  ctors
  ctorTypes
  impls
  mctx
  DeclFacts {
    factMethodResults = facts.factMethodResults,
    factRequires = facts.factRequires,
    factSupers = facts.factSupers,
    factBinders = edit facts.factBinders,
    factEntryOutcome = facts.factEntryOutcome,
    factExterns = facts.factExterns,
    factManifests = facts.factManifests,
  }

test "(ad) a function whose row is missing or gives no return type is refused" = expectEach
  [
    (
      "no row",
      expectEqual
        ["function: f has no stamped type [in f]"]
        (validateBinderStamps
          (dropRowsNamed "f" (typedLowered i2078Prelude stampSrc))),
    ),
    (
      "a row with no return type",
      expectEqual
        ["function: f has no return type [in f]"]
        (validateBinderStamps
          (dropReturnsNamed "f" (typedLowered i2078Prelude stampSrc))),
    ),
  ]

-- Two where-functions named `go` and two named `r` in one module.  The second
-- `go` is unannotated, so it generalizes to `Num a => a -> a` and returns a type
-- variable; the third pins its literal to Int.  Neither `r` takes a parameter or
-- is a literal, so lowering keeps both under the one Core name `r`.
sameNameSrc : String
sameNameSrc = joinNl [
  "f1 : Int -> Float",
  "f1 n = go n",
  "  where",
  "    go m = intToFloat m * 1.5",
  "f2 : Int -> Int",
  "f2 n = go n",
  "  where",
  "    go m = m + 1",
  "f3 : Int -> Int",
  "f3 n = go n",
  "  where",
  "    go m = m + (1 : Int)",
  "g1 : Int -> Float",
  "g1 n = r",
  "  where",
  "    r = intToFloat n * 1.5",
  "g2 : Int -> Int",
  "g2 n = r",
  "  where",
  "    r = n + 1",
  "main = println (f1 2, f2 2, f3 2, g1 2, g2 2)",
]

-- The functions of the top-level binding [top], inner first, as
-- (row name, return type); the Core names of the inner ones; their ids.
functionReturnsIn : String ->
  CProgram ->
  (List (String, Option RuntimeType), List String, List Int)
functionReturnsIn top (CProgram groups _ _ _ _ facts) =
  let rows =
    BM.fromList (map (r => (binderOrdinal r.brId, r)) facts.factBinders)
  let found = Ref []
  let _ =
    mapProgramBinders
      (site x bid =>
        let _ = match site
          FunctionBinder _ => found := (x, bid) :: !found
          PatternBinder _ => ()
        bid)
      (CProgram
        (filter
          (b => match b
            CBind n _ _ _ => n == top)
          groups)
        []
        []
        []
        []
        noDeclFacts)
  let fns = reverseL !found
  let inner = take (listLen fns - 1) fns
  (
    map
      (p => match BM.get (binderOrdinal (snd p)) rows
        Some r => (r.brName, r.brReturns)
        None => (fst p, None))
      fns,
    map fst inner,
    map (p => binderOrdinal (snd p)) inner,
  )

test "(ae) two functions of one name each return what their own body returns" =
  match loweredSource sameNameSrc
    Ok prog =>
      let (f1, _, _) = functionReturnsIn "f1" prog
      let (f2, _, _) = functionReturnsIn "f2" prog
      let (f3, _, _) = functionReturnsIn "f3" prog
      let (g1, g1Core, g1Ids) = functionReturnsIn "g1" prog
      let (g2, g2Core, g2Ids) = functionReturnsIn "g2" prog
      expectEach [
        (
          "the Float go",
          expectEqual [("go", Some RTFloat), ("f1", Some RTFloat)] f1,
        ),
        (
          "the generalized go returns its type variable",
          expectEqual [("go", Some RTValue), ("f2", Some RTInt)] f2,
        ),
        ("the Int go", expectEqual [("go", Some RTInt), ("f3", Some RTInt)] f3),
        (
          "the Float r",
          expectEqual [("r", Some RTFloat), ("g1", Some RTFloat)] g1,
        ),
        ("the Int r", expectEqual [("r", Some RTInt), ("g2", Some RTInt)] g2),
        (
          "both r keep one Core name",
          expectEqual (["r"], ["r"]) (g1Core, g2Core),
        ),
        ("the two r are two binders", expectNotEqual g1Ids g2Ids),
      ]
    Err e => fail e

-- `tools/target_check` skips the built-in rule's reach when no module of the
-- program but the prelude names a built-in the profile's column leaves
-- unprovided, which is sound only while the prelude names none on any column.
test "(ag) the prelude names no built-in that any column leaves unprovided" =
  match readFile (underRoot "stdlib/core.mdk")
    Err e => fail e
    Ok src =>
      expectEqual
        []
        (filter
          unprovidedOnAnyColumn
          (dedup (flatMap declRefs (desugar (parse src)))))

unprovidedOnAnyColumn : String -> Bool
unprovidedOnAnyColumn name =
  any (b => isUnprovidedOn b name) [LlvmBackend, WasmBackend, EvalBackend]

-- The native test section is inherited by a child of this executable. A probe
-- prints its sentinel only after the selected emitter has returned text.
emissionProbeVar : String
emissionProbeVar = "MEDAKA_EMISSION_VALIDATION_PROBE"

emissionControl : CProgram
emissionControl = typedLowered "" "main = (0 : Int)"

replaceMain : CExpr -> CProgram -> CProgram
replaceMain body (CProgram [CBind n _ loc bid] cs ts is ms fs) =
  CProgram [CBind n [CClause [] body] loc bid] cs ts is ms fs
replaceMain _ cp = cp

emissionVictim : String -> CProgram
emissionVictim "F1" =
  replaceMain (CRecord "P" [CField "a" (-1) zero]) emissionControl
emissionVictim "F2" =
  replaceMain (CApp zero [] (CallSite CallDynamic False)) emissionControl
emissionVictim "F3" =
  let (CProgram gs cs ts _ ms fs) = emissionControl
  CProgram
    gs
    cs
    ts
    [CImplEntry "f" 0 0 (CImplTagged "Int" "I|Int|" "I" noImplSym [] [] zero)]
    ms
    fs
emissionVictim "F4" =
  replaceMain
    (CApp (CVar "opaque" AGlobal) [zero] (CallSite CallDynamic True))
    emissionControl
emissionVictim "F5" =
  let (CProgram gs cs ts is ms fs) = emissionControl
  CProgram gs cs ts is ms { fs | factBinders = [] }
emissionVictim "F6" =
  replaceMain
    (CMethod "show" (MethodEvidence "I" 1 (RDict "$dict_missing") [] []))
    emissionControl
emissionVictim "not-provided" =
  let (CProgram _ _ _ _ _ facts) = emissionControl
  match omLookup (runtimeExternSymbol "assertSnapshot") facts.factExterns
    Some fact => replaceMain (externVar fact) emissionControl
    None => panic "emission control omitted assertSnapshot extern fact"
emissionVictim victim =
  if contains "extern-" victim then
    let cp =
      if victim == "extern-paired" || victim == "extern-import" then
        lowered
          """
      extern identityHost : Int -> Int
        bind c "identity_host"
        bind js "identityHost"
      main = identityHost 42
      """
      else
        typedLowered "" "main = bitAnd 6 3"
    if victim == "extern-missing-abi" || victim == "extern-priority" then
      let (CProgram bs ca ct impls mc facts) = cp
      let symbol = runtimeExternSymbol "bitAnd"
      let inventory = match omLookup symbol facts.factExterns
        Some fact =>
          omInsert symbol { fact | callableShape = None } facts.factExterns
        None => facts.factExterns
      CProgram bs ca ct impls mc { facts | factExterns = inventory }
    else
      cp
  else if contains "global-cycle" victim then
    typedLowered "" """
      x : Int
      x = x + 1
      main = x
      """
  else if contains "global-" victim then
    let cp = typedLowered "" """
      a = f 1
      b = 5
      c = 40
      f n = c + n
      main = a
      """
    if victim == "global-duplicate" then duplicateGlobal cp else cp
  else
    emissionControl

duplicateGlobal : CProgram -> CProgram
duplicateGlobal (CProgram binds cs ts impls ms facts) =
  let renamed =
    map
      (b => match b
        CBind "b" clauses loc bid => CBind "a" clauses loc bid
        _ => b)
      binds
  CProgram renamed cs ts impls ms facts

corruptGlobalPlan : String -> EmitPlan -> EmitPlan
corruptGlobalPlan victim plan =
  let order values eager = { plan |
    globalInit = GlobalInitPlan { valueOrder = values, eagerOrder = eager },
  }
  match victim
    "global-missing" => order ["c", "a"] ["c", "a"]
    "global-unknown" => order ["b", "c", "unknown"] ["b", "c", "unknown"]
    "global-repeat" => order ["b", "c", "c"] ["b", "c", "c"]
    "global-main" => order ["b", "c", "main"] ["b", "c", "main"]
    "global-function" => order ["b", "c", "f"] ["b", "c", "f"]
    "global-dependency" => order ["a", "b", "c"] ["a", "b", "c"]
    "global-paired-dependency" => { order ["a", "b", "c"] ["a", "b", "c"] |
      eagerReach = omInsert "a" [] plan.eagerReach,
    }
    "global-priority" => order ["c", "a", "b"] ["c", "a", "b"]
    "global-eager-missing" => order ["b", "c", "a"] ["c", "a"]
    "global-cycle-eager" =>
      { plan | globalInit = { plan.globalInit | eagerOrder = ["x"] } }
    "global-cycle-paired" => { order ["x"] ["x"] | lazyGlobals = [] }
    "global-cycle-repeat-lazy" => { plan | lazyGlobals = ["x", "x"] }
    _ => plan

corruptExternPlan : String -> EmitPlan -> EmitPlan
corruptExternPlan victim plan =
  let requirements = plan.externRequirements
  let alter f = { requirements | rows = map f requirements.rows }
  let changed = match victim
    "extern-missing" => { requirements | rows = [] }
    "extern-paired" => { requirements | rows = [] }
    "extern-duplicate" =>
      { requirements | rows = requirements.rows ++ requirements.rows }
    "extern-target" => { requirements | target = EvalBackend }
    "extern-binding" =>
      alter (row => { row | selectedBinding = RuntimeRequirement "bitOr" })
    "extern-abi" => alter (row => { row |
      declaration = { row.declaration |
        callableShape =
          map
            (shape => { shape | loweredCoreArity = 7 })
            row.declaration.callableShape,
      },
    })
    "extern-use" => alter (row => { row | selectedUses = [] })
    _ => requirements
  if victim == "extern-paired" then
    { plan | externRequirements = changed, jsImports = [], hostKeys = [] }
  else if victim == "extern-import" then
    { plan | externRequirements = changed, jsImports = [] }
  else
    { plan | externRequirements = changed }

externVictims : List String
externVictims = [
  "extern-missing", "extern-paired", "extern-duplicate", "extern-target",
  "extern-binding", "extern-abi", "extern-use", "extern-missing-abi",
  "extern-priority"
]

emissionNeedle : String -> String
emissionNeedle "extern-missing" = "missing-extern-requirement"
emissionNeedle "extern-paired" = "missing-extern-requirement"
emissionNeedle "extern-import" = "extern-import-mismatch"
emissionNeedle "extern-duplicate" = "duplicate-extern-requirement"
emissionNeedle "extern-target" = "extern-target-mismatch"
emissionNeedle "extern-binding" = "extern-binding-mismatch"
emissionNeedle "extern-abi" = "extern-abi-mismatch"
emissionNeedle "extern-use" = "extern-use-mismatch"
emissionNeedle "extern-missing-abi" = "missing-extern-abi"
emissionNeedle "extern-priority" = "missing-extern-abi"
emissionNeedle "F1" = "internal error: record:"
emissionNeedle "F2" = "internal error: call:"
emissionNeedle "F3" = "internal error: impl symbol:"
emissionNeedle "F4" = "internal error: tail:"
emissionNeedle "F5" = "internal error: function:"
emissionNeedle "F6" = "internal error: dispatch evidence:"
emissionNeedle "missing-domain" =
  "runtime extern 'zzEmissionMissingRow' has no row"
emissionNeedle "not-provided" =
  "runtime extern 'assertSnapshot' is not available"
emissionNeedle "global-duplicate" = "global init: duplicate binding"
emissionNeedle "global-dependency" = "global init: dependency order"
emissionNeedle "global-paired-dependency" = "global init: dependency order"
emissionNeedle "global-priority" = "global init: source priority"
emissionNeedle "global-cycle-paired" = "global init: eager cycle"
emissionNeedle "global-cycle-eager" = "global init: lazy partition"
emissionNeedle "global-cycle-repeat-lazy" = "global init: lazy partition"
emissionNeedle "global-eager-missing" = "global init: lazy partition"
emissionNeedle victim =
  if contains "global-" victim then
    "global init: membership"
  else
    "internal error: emit plan was built for"

globalVictims : List String
globalVictims = [
  "global-duplicate", "global-missing", "global-unknown", "global-repeat",
  "global-main", "global-function", "global-dependency",
  "global-paired-dependency", "global-priority", "global-eager-missing",
  "global-cycle-eager", "global-cycle-paired", "global-cycle-repeat-lazy"
]

emissionRoutes : List String
emissionRoutes = [
  "llvm-stats", "llvm-strict", "llvm-record", "llvm-census", "wasm-strict",
  "wasm-unchecked", "wasm-record", "wasm-census"
]

publicRendererNames : List Decl -> List String
publicRendererNames [] = []
publicRendererNames ((DTypeSig True name ty _) :: rest) =
  let (args, result) = signatureParts ty
  if any (typeMentions "EmitPlan") args
    && any (typeMentions "CProgram") args
    && typeMentions "String" result then
    name :: publicRendererNames rest
  else
    publicRendererNames rest
publicRendererNames ((DAttrib _ decl) :: rest) =
  publicRendererNames (decl :: rest)
publicRendererNames (_ :: rest) = publicRendererNames rest

signatureParts : Ty -> (List Ty, Ty)
signatureParts (TyFun arg rest) =
  let (args, result) = signatureParts rest
  (arg :: args, result)
signatureParts (TyConstrained _ ty) = signatureParts ty
signatureParts ty = ([], ty)

typeMentions : String -> Ty -> Bool
typeMentions name (TyCon { tyConName = n }) = name == n
typeMentions name (TyApp a b) = typeMentions name a || typeMentions name b
typeMentions name (TyTuple ts) = any (typeMentions name) ts
typeMentions name (TyEffect _ _ ty) = typeMentions name ty
typeMentions name (TyConstrained _ ty) = typeMentions name ty
typeMentions _ _ = False

rendererRoute : String -> String
rendererRoute "llvm-stats" = "llvm/emitProgramWithStats"
rendererRoute "llvm-strict" = "llvm/emitProgram"
rendererRoute "llvm-record" = "llvm/emitProgramRecord"
rendererRoute "llvm-census" = "llvm/emitProgramGaps"
rendererRoute "wasm-strict" = "wasm/emitProgram"
rendererRoute "wasm-record" = "wasm/emitProgramRecord"
rendererRoute "wasm-census" = "wasm/emitProgramGaps"
rendererRoute _ = "wasm/emitProgramUnchecked"

publicRendererRoutes : String -> <IO, FileRead> Result String (List String)
publicRendererRoutes emitter = do
  src <- readFile (underRoot "compiler/backend/\{emitter}_emit.mdk")
  Ok (map (name => "\{emitter}/\{name}") (publicRendererNames (parse src)))

test "the emission gateway matrix covers every public renderer derived from both emitters" =
  match (publicRendererRoutes "llvm", publicRendererRoutes "wasm")
    (Ok llvm, Ok wasm) =>
      expectEqual (llvm ++ wasm) (map rendererRoute emissionRoutes)
    (Err e, _) => fail e
    (_, Err e) => fail e

export
emissionText : String -> String -> <Stdout> String
emissionText route victim =
  let cp = emissionVictim victim
  let target = if contains "llvm" route then LlvmBackend else WasmBackend
  let other = if contains "llvm" route then WasmBackend else LlvmBackend
  let domain =
    if victim == "missing-domain" then
      runtimeDomain (externDecls (parse "extern zzEmissionMissingRow : Int"))
    else
      PreludeFreeRuntime
  let plan =
    corruptExternPlan
      victim
      (corruptGlobalPlan
        victim
        (buildEmitPlan
          (if victim == "target" then other else target)
          domain
          cp))
  let li = makeEmitInput domain [] [] 0 [] [] ""
  let wi = makeWasmEmitInput domain []
  match route
    "llvm-stats" =>
      let (text, stats) = llvmStats li plan cp
      let _ =
        putStrLn ("EMISSION_STATS_SENTINEL" ++ intToString (listLen stats))
      text
    "llvm-strict" => llvmStrict li plan cp
    "llvm-record" => fst (llvmRecord li plan cp)
    "llvm-census" => joinNl (llvmCensus li plan cp)
    "wasm-strict" => wasmStrict wi plan cp
    "wasm-record" => fst (wasmRecord wi plan cp)
    "wasm-census" => joinNl (emitProgramGaps wi plan cp)
    "playground" =>
      let wat = wasmStrict wi plan cp
      let _ = putStrLn "__MEDAKA_WAT__"
      wat
    _ => wasmUnchecked wi plan cp

-- A native sibling process carries its runner's framed results before the
-- victim executes. Only those frames are excluded from renderer-output checks.
rendererOutputLines : List String -> List String
rendererOutputLines [] = []
rendererOutputLines (line :: rest) =
  if stringStartsWith "@@__mdk_native_test__@@" line then
    if contains ".start" line then
      rendererOutputLines rest
    else match rest
      _ :: afterValue => rendererOutputLines afterValue
      [] => []
  else if line == "" then
    rendererOutputLines rest
  else
    line :: rendererOutputLines rest

emissionRefused : String ->
  String ->
  <IO, Exec, Env, FileRead, FileWrite> Expectation
emissionRefused route victim =
  withScratchDir (dir => emissionRefusedAt (dir ++ "/destination") route victim)

emissionRefusedAt : String ->
  String ->
  String ->
  <IO, Exec, Env, FileRead> Expectation
emissionRefusedAt destination route victim = match boundedVerbSeconds 90 "env" [
  "\{emissionProbeVar}=\{route}/\{victim}",
  "MEDAKA_EMISSION_DESTINATION=" ++ destination,
  executablePath (),
]
  Err e => fail e
  Ok (code, out, err) => expectEach [
    ("refuses", expectNotEqual 0 code),
    (
      "empty renderer stdout",
      expectEqual "" (joinNl (rendererOutputLines (split "\n" out))),
    ),
    ("no artifact", expectFalse (fileExists destination)),
    ("class", expectTextContainsAll [emissionNeedle victim] (out ++ err)),
    (
      "no output returned",
      expectFalse (contains "EMISSION_RETURNED_SENTINEL" out),
    ),
    (
      "no module text",
      expectFalse (contains "(module" out || contains "define i32" out),
    ),
    ("no marker", expectFalse (contains "__MEDAKA_WAT__" out)),
    ("no stats", expectFalse (contains "EMISSION_STATS_SENTINEL" out)),
  ]

test "gateway emission seams refuse F1-F6 and a mismatched target before returning output" =
  match getEnv emissionProbeVar
    Some selected => match split "/" selected
      [route, victim] =>
        let text = emissionText route victim
        let _ = match getEnv "MEDAKA_EMISSION_DESTINATION"
          Some destination => writeFile destination text
          None => Ok ()
        let _ = putStrLn ("EMISSION_RETURNED_SENTINEL" ++ text)
        pass
      _ => fail "invalid emission probe selector"
    None =>
      expectEach
        (flatMap
            (route =>
              map
                (victim => ("\{route}/\{victim}", emissionRefused route victim))
                [
                  "F1", "F2", "F3", "F4", "F5", "F6", "target", "missing-domain"
                ])
            emissionRoutes
          ++ map
            (route =>
              ("\{route}/not-provided", emissionRefused route "not-provided"))
            ["llvm-strict", "wasm-strict", "wasm-unchecked"])

test "all global corruptions refuse before output on every renderer and playground composition" =
  match getEnv emissionProbeVar
    Some _ => pass
    None =>
      expectEach
        (flatMap
          (route =>
            map
              (victim => ("\{route}/\{victim}", emissionRefused route victim))
              globalVictims)
          (emissionRoutes ++ ["playground"]))

test "global route controls emit nonempty modules and gaps remain empty" =
  match getEnv emissionProbeVar
    Some _ => pass
    None =>
      expectEach
        (map
          (route => (
            route,
            if contains "census" route then
              expectEqual "" (emissionText route "global-valid")
            else
              expectTextContainsAll
                [
                  if contains "llvm" route then
                    "define i32 @mdk_program_main"
                  else
                    "(module",
                ]
                (emissionText route "global-valid"),
          ))
          (emissionRoutes ++ ["playground"]))

test "gateway returns fatal defects separately from target extern findings" =
  expectEach
    (flatMap
      (target =>
        let check victim =
          validateForEmission
            target
            PreludeFreeRuntime
            (buildEmitPlan target PreludeFreeRuntime (emissionVictim victim))
            (emissionVictim victim)
        map
          (victim => (
            "\{victim}/\{backendName target}",
            expectEach [
              (
                "defect class",
                expectTextContainsAll
                  [emissionNeedle victim]
                  (joinNl (map coreDefectMessage (check victim).defects)),
              ),
              (
                "no target gaps",
                expectEqual [] (map findingExtern (check victim).externFindings),
              ),
            ],
          ))
          ["F1", "F2", "F3", "F4", "F5", "F6"])
      [LlvmBackend, WasmBackend])

test "gateway preserves runtime domain identity and rejects a loaded missing row" =
  let loaded = runtimeDomain []
  let preludeFree = PreludeFreeRuntime
  let missing =
    runtimeDomain (externDecls (parse "extern zzEmissionMissingRow : Int"))
  let check domain =
    validateForEmission
      LlvmBackend
      domain
      (buildEmitPlan LlvmBackend domain emissionControl)
      emissionControl
  expectEach [
    (
      "loaded empty stays loaded",
      expectEqual "loaded" (match loaded
        LoadedRuntimeExterns [] => "loaded"
        _ => "wrong"),
    ),
    (
      "prelude-free stays explicit",
      expectEqual "prelude-free" (match preludeFree
        PreludeFreeRuntime => "prelude-free"
        _ => "wrong"),
    ),
    (
      "loaded empty validates",
      expectEqual [] (map coreDefectMessage (check loaded).defects),
    ),
    (
      "prelude-free validates",
      expectEqual [] (map coreDefectMessage (check preludeFree).defects),
    ),
    (
      "missing row",
      expectTextContainsAll
        ["'zzEmissionMissingRow'", "extern catalog"]
        (joinNl (map coreDefectMessage (check missing).defects)),
    ),
  ]

test "gateway preserves collision priority and backend dict-tag widths" =
  let check backend cp =
    map
      coreDefectMessage
      (validateForEmission
        backend
        PreludeFreeRuntime
        (buildEmitPlan backend PreludeFreeRuntime cp)
        cp).defects
  expectEach [
    (
      "symbol before tags",
      expectTextContainsAll
        ["emitted impl-symbol collision"]
        (joinNl (check LlvmBackend (sameSymbol (lowered fullWidthSrc)))),
    ),
    (
      "full-width tags",
      expectTextContainsAll
        ["emitted dict-witness tag collision", "native (LLVM) i64"]
        (joinNl (check LlvmBackend (lowered fullWidthSrc))),
    ),
    (
      "masked tags",
      expectTextContainsAll
        ["wasm (WasmGC) 30-bit"]
        (joinNl (check WasmBackend (lowered narrowWidthSrc))),
    ),
  ]

test "gateway valid controls return module text and unavailable externs stay record-visible" =
  let cp = emissionVictim "not-provided"
  let lp = buildEmitPlan LlvmBackend PreludeFreeRuntime cp
  let wp = buildEmitPlan WasmBackend PreludeFreeRuntime cp
  let li = makeEmitInput PreludeFreeRuntime [] [] 0 [] [] ""
  let wi = makeWasmEmitInput PreludeFreeRuntime []
  let (_, le) = llvmRecord li lp cp
  let (_, we) = wasmRecord wi wp cp
  expectEach [
    (
      "llvm strict control",
      expectTextContainsAll
        ["define i32 @mdk_program_main"]
        (emissionText "llvm-strict" "valid"),
    ),
    (
      "llvm record control",
      expectTextContainsAll
        ["define i32 @mdk_program_main"]
        (emissionText "llvm-record" "valid"),
    ),
    (
      "wasm strict control",
      expectTextContainsAll ["(module"] (emissionText "wasm-strict" "valid"),
    ),
    (
      "wasm record control",
      expectTextContainsAll ["(module"] (emissionText "wasm-record" "valid"),
    ),
    (
      "census control",
      expectEqual
        ("", "")
        (emissionText "llvm-census" "valid", emissionText "wasm-census" "valid"),
    ),
    (
      "llvm record gap",
      expectTextContainsAll
        ["runtime extern 'assertSnapshot' is not available"]
        (joinNl le),
    ),
    (
      "wasm record gap",
      expectTextContainsAll
        ["runtime extern 'assertSnapshot' is not available"]
        (joinNl we),
    ),
    (
      "llvm census gap",
      expectTextContainsAll
        ["runtime extern 'assertSnapshot' is not available"]
        (joinNl (llvmCensus li lp cp)),
    ),
    (
      "wasm census gap",
      expectTextContainsAll
        ["runtime extern 'assertSnapshot' is not available"]
        (joinNl (emitProgramGaps wi wp cp)),
    ),
  ]

test "runtime domain projection unwraps attributed externs without dropping declarations" =
  let decls =
    parse "extern putStrLn : String -> Unit\nextern zzEmissionMissingRow : Int"
  let attributed =
    map (d => DAttrib [AttrDeprecated None] (DAttrib [AttrInline] d)) decls
  let domain = runtimeDomain (externDecls attributed)
  let validation =
    validateForEmission
      LlvmBackend
      domain
      (buildEmitPlan LlvmBackend domain emissionControl)
      emissionControl
  expectEach [
    (
      "names and order",
      expectEqual
        ["putStrLn", "zzEmissionMissingRow"]
        (map (d => d.edName) (externDecls attributed)),
    ),
    (
      "missing attributed extern is refused",
      expectTextContainsAll
        ["'zzEmissionMissingRow'", "extern catalog"]
        (joinNl (map coreDefectMessage validation.defects)),
    ),
  ]

methodFactControl : CProgram
methodFactControl =
  lowered
    """
interface Chain c where
  step : c -> (Int -> c) -> c
impl Chain Int where
  step x f = f x
main = 1
"""

editMethodFacts : (List MethodResultFact -> List MethodResultFact) ->
  CProgram ->
  CProgram
editMethodFacts edit (CProgram gs cs ts impls ms facts) = CProgram
  gs
  cs
  ts
  impls
  ms
  { facts | factMethodResults = edit facts.factMethodResults }

methodFactFaults : CProgram -> List String
methodFactFaults cp =
  validateMethodResults (buildEmitPlan LlvmBackend PreludeFreeRuntime cp) cp

test "method result facts validate before either backend emits" =
  expectAll
    (map
      (backend =>
        let plan = buildEmitPlan backend PreludeFreeRuntime methodFactControl
        expectAll [
          expectEqual [] (validateMethodResults plan methodFactControl),
          expectEqual
            []
            (map
              coreDefectMessage
              (validateForEmission
                backend
                PreludeFreeRuntime
                plan
                methodFactControl).defects),
        ])
      [LlvmBackend, WasmBackend])

test "method result validation refuses a missing row and a missing plan key" =
  let missing = editMethodFacts (_ => []) methodFactControl
  let plan = buildEmitPlan LlvmBackend PreludeFreeRuntime methodFactControl
  expectAll [
    expectTextContainsAll
      ["method result", "missing declaration fact", "Chain#step"]
      (joinNl (methodFactFaults missing)),
    expectTextContainsAll
      ["method result", "index disagrees"]
      (joinNl
        (validateMethodResults
          { plan | methodResults = omEmpty }
          methodFactControl)),
  ]

test "method result validation refuses malformed keys and callback positions" =
  let row = MethodResultFact {
    iface = "Chain",
    method = "step",
    returnsHead = True,
    callbackPositions = [1],
    valueArity = 2,
  }
  expectEach
    (map
      ((message, mutated) => (
        message,
        expectTextContainsAll
          ["method result", message]
          (joinNl
            (methodFactFaults
              (editMethodFacts (_ => [mutated]) methodFactControl))),
      ))
      [
        ("empty interface or method key", { row | iface = "" }),
        ("invalid callback position", { row | callbackPositions = [-1] }),
        ("invalid callback position", { row | callbackPositions = [2] }),
        ("invalid callback position", { row | callbackPositions = [1, 1] }),
        ("negative value arity", { row | valueArity = -1 }),
      ])

test "method result validation refuses duplicate qualified keys" =
  expectTextContainsAll
    ["method result", "duplicate qualified key"]
    (joinNl
      (methodFactFaults
        (editMethodFacts (rows => rows ++ rows) methodFactControl)))

test "method result validation refuses a callback position lost from the plan" =
  let changed = editMethodFacts (map withoutCallbackPositions) methodFactControl
  let plan = buildEmitPlan LlvmBackend PreludeFreeRuntime changed
  expectTextContainsAll
    ["method result", "index disagrees"]
    (joinNl (validateMethodResults plan methodFactControl))

test "method result validation refuses a fact arity above its Core impl entry" =
  let changed =
    editMethodFacts
      (map (row => { row | callbackPositions = [2], valueArity = 3 }))
      methodFactControl
  let plan = buildEmitPlan LlvmBackend PreludeFreeRuntime changed
  expectTextContainsAll
    [
      "method result",
      "fact value arity 3",
      "Core impl entry declared value arity 2",
      "Chain#step",
    ]
    (joinNl (validateMethodResults plan changed))

withoutCallbackPositions : MethodResultFact -> MethodResultFact
withoutCallbackPositions row = { row | callbackPositions = [] }

methodOccurrence : String -> CProgram
methodOccurrence iface =
  CProgram
    [
      CBind
        "main"
        [CClause [] (CMethod "step" (MethodEvidence iface 2 RNone [] []))]
        noDeclLoc
        noBinderId,
    ]
    []
    []
    []
    []
    { noDeclFacts |
      factMethodResults = [
        MethodResultFact {
          iface = "left::Chain",
          method = "step",
          returnsHead = True,
          callbackPositions = [1],
          valueArity = 2,
        },
      ],
    }

test "method result completeness checks qualified occurrences and permits standalone evidence" = expectAll
  [
    expectEqual [] (methodFactFaults (methodOccurrence "left::Chain")),
    expectEqual [] (methodFactFaults (methodOccurrence "")),
    expectTextContainsAll
      ["missing declaration fact", "right::Chain#step"]
      (joinNl (methodFactFaults (methodOccurrence "right::Chain"))),
  ]

test "missing method result facts are fatal for both backends" =
  let cp = editMethodFacts (_ => []) methodFactControl
  expectAll
    (map
      (backend =>
        expectTextContainsAll
          ["method result", "missing declaration fact"]
          (joinNl
            (map
              coreDefectMessage
              (validateForEmission
                backend
                PreludeFreeRuntime
                (buildEmitPlan backend PreludeFreeRuntime cp)
                cp).defects)))
      [LlvmBackend, WasmBackend])

test "all requirement defects refuse before output on every renderer and playground" =
  match getEnv emissionProbeVar
    Some _ => pass
    None =>
      expectEach
        (flatMap
          (route =>
            map
              (victim => ("\{route}/\{victim}", emissionRefused route victim))
              externVictims)
          (emissionRoutes ++ ["playground"]))

test "Wasm import projection omissions refuse before output on every Wasm renderer" =
  match getEnv emissionProbeVar
    Some _ => pass
    None =>
      expectEach
        (map
          (route => (route, emissionRefused route "extern-import"))
          [
            "wasm-strict", "wasm-record", "wasm-census", "wasm-unchecked",
            "playground"
          ])
