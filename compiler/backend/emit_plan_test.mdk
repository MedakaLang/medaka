val : String -> CExpr -> CBind
val name rhs = synthBind name [CClause [] rhs]

ref : String -> CExpr
ref n = CVar n AGlobal

program : List CBind -> CProgram
program binds =
  lowerExterns
    emptyFacts
    (parse
      """
  extern jsUp : String -> String
    bind c "c_up"
    bind js "jsUpper"
  extern cNeg : Int -> Int
    bind c "c_neg"
  """)
    (CProgram binds [] [] [] [] noDeclFacts)

planOf : List CBind -> EmitPlan
planOf binds = buildEmitPlan LlvmBackend PreludeFreeRuntime (program binds)

reachOf : String -> EmitPlan -> List String
reachOf n plan = match omLookup n plan.eagerReach
  Some rs => rs
  None => ["<no entry>"]

-- a = 1 (eager)  b = a (eager)  c = c (self loop)  d = c (reads a lazy one)
-- x = y, y = x (a cycle)  main = 0 (never lazy)
mixed : List CBind
mixed = [
  val "a" (CLit (LInt 1)),
  val "b" (ref "a"),
  val "c" (ref "c"),
  val "d" (ref "c"),
  val "x" (ref "y"),
  val "y" (ref "x"),
  val "main" (CLit (LInt 0)),
]

test "a pure literal global and a reader of it are eager" = expectAll [
  labelFail
    "no eager global is lazy"
    (expectEqual
      []
      (planOf [
        val "a" (CLit (LInt 1)),
        val "b" (ref "a"),
      ]).lazyGlobals),
  labelFail "a reaches nothing" (expectEqual [] (reachOf "a" (planOf mixed))),
  labelFail "b reaches a" (expectEqual ["a"] (reachOf "b" (planOf mixed))),
]

test "a self loop, a reader of it, and a mutual cycle are lazy; main is not" =
  expectEqual ["c", "d", "x", "y"] (planOf mixed).lazyGlobals

test "the plan carries one source-prioritized value order and its eager filter" =
  let binds = [
    val "a" (ref "c"),
    val "b" (CLit (LInt 5)),
    val "c" (CLit (LInt 40)),
    val "main" (ref "a"),
  ]
  let plan = planOf binds
  let mixedPlan = planOf mixed
  expectEach [
    ("priority", expectEqual ["b", "c", "a"] plan.globalInit.valueOrder),
    ("acyclic eager", expectEqual ["b", "c", "a"] plan.globalInit.eagerOrder),
    (
      "mixed members",
      expectEqual ["a", "b", "c", "d", "x", "y"] mixedPlan.globalInit.valueOrder,
    ),
    ("mixed eager", expectEqual ["a", "b"] mixedPlan.globalInit.eagerOrder),
    (
      "Core validation",
      expectEqual
        []
        (validateGlobalInit
          (program mixed)
          mixedPlan.lazyGlobals
          mixedPlan.globalInit),
    ),
  ]

test "a cycle's members share one reach set" = expectAll [
  labelFail
    "x reaches y and x"
    (expectTrue (hasAll ["x", "y"] (reachOf "x" (planOf mixed)))),
  labelFail
    "y reaches y and x"
    (expectTrue (hasAll ["x", "y"] (reachOf "y" (planOf mixed)))),
]

test "the plan carries the target it was built with" = expectAll [
  labelFail
    "wasm"
    (expectTrue
      (isWasm
        (buildEmitPlan WasmBackend PreludeFreeRuntime (program mixed)).target)),
  labelFail "native" (expectFalse (isWasm (planOf mixed).target)),
]

entryOutcomeProgram : CProgram
entryOutcomeProgram =
  let outcome = EntryFact {
    entryMainIsUnit = False,
    entryMainIsFloat = True,
  }
  CProgram [] [] [] [] [] { noDeclFacts | factEntryOutcome = Some outcome }

planOutcomeExpectation : Backend -> Expectation
planOutcomeExpectation target =
  match ((buildEmitPlan
    target
    PreludeFreeRuntime
    entryOutcomeProgram).entryOutcome)
    Some outcome => expectAll [
      expectFalse outcome.entryMainIsUnit,
      expectTrue outcome.entryMainIsFloat,
    ]
    None => fail "the plan dropped its entry outcome"

test "LLVM and Wasm plans preserve the entry outcome" =
  expectEach
    (map
      (named => (
        fst named,
        planOutcomeExpectation (snd named),
      ))
      [("LLVM", LlvmBackend), ("Wasm", WasmBackend)])

hasAll : List String -> List String -> Bool
hasAll wanted have = all (w => any (== w) have) wanted

isWasm : Backend -> Bool
isWasm WasmBackend = True
isWasm _ = False

-- The emitters read the global classification, the TRMC verdict and the dispatch
-- groups from the plan; neither may recompute them.
-- Comment lines are skipped: they may name the analyses.
codeMentions : String -> String -> Bool
codeMentions word text =
  any (l => not (startsWith "--" (trimLeft l)) && contains word l) (lines text)

noRecompute : String -> <IO, FileRead> Expectation
noRecompute file = match readFile "\{medakaRoot}/compiler/backend/\{file}"
  Err e => expectEqual "readable" "cannot read \{file}: \{e}"
  Ok text => expectAll [
    labelFail
      "\{file} calls eagerReachMap"
      (expectFalse (codeMentions "eagerReachMap" text)),
    labelFail
      "\{file} calls lazyGlobalNames"
      (expectFalse (codeMentions "lazyGlobalNames" text)),
    labelFail
      "\{file} calls trmcEligible"
      (expectFalse (codeMentions "trmcEligible" text)),
    labelFail
      "\{file} calls detectDispatchGroups"
      (expectFalse (codeMentions "detectDispatchGroups" text)),
    labelFail
      "\{file} calls wasmReachFilter"
      (expectFalse (codeMentions "wasmReachFilter" text)),
  ]

test "neither emitter recomputes a plan analysis" = expectAll [
  noRecompute "llvm_emit.mdk",
  noRecompute "wasm_emit.mdk",
]

test "each emitter uses the shared validation gateway and owns no collision sequence" =
  expectEach
    (map
      (file => (
        file,
        match readFile "\{medakaRoot}/compiler/backend/\{file}"
          Err e => fail e
          Ok text => expectEach [
            ("gateway", expectTextContainsAll ["validateForEmission"] text),
            (
              "no impl-symbol predicate",
              expectFalse (codeMentions "validateImplSymbolInjectivity" text),
            ),
            (
              "no dict-tag predicate",
              expectFalse (codeMentions "validateDictTags" text),
            ),
          ],
      ))
      ["llvm_emit.mdk", "wasm_emit.mdk"])

test "the gateway owns both collision checks before shape checks" =
  match readFile "\{medakaRoot}/compiler/backend/core_validate.mdk"
    Err e => fail e
    Ok text =>
      expectTextContainsAll
        [
          "match implSymbolCollision cp", "match dictTagCollision backend cp",
          "firstShapeDefect"
        ]
        text

-- Reach belongs to the plan builder: no entry calls the filter itself.
noEntryReach : String -> <IO, FileRead> Expectation
noEntryReach file = match readFile "\{medakaRoot}/compiler/entries/\{file}"
  Err e => expectEqual "readable" "cannot read \{file}: \{e}"
  Ok text =>
    labelFail
      "\{file} calls wasmReachFilter"
      (expectFalse (codeMentions "wasmReachFilter" text))

test "no entry runs reach itself" =
  match listDir "\{medakaRoot}/compiler/entries"
    Err e => expectEqual "listable" "cannot list compiler/entries: \{e}"
    Ok names =>
      let entries = filter (n => endsWith ".mdk" n) names
      expectAll
        (labelFail "compiler/entries holds entries" (expectNotEqual [] entries)
          :: map noEntryReach entries)

-- ── physical-identity ratchets ──────────────────────────────────────────────
-- Each one reads emitter source and fails when a retired mechanism returns:
-- an unchecked direct call, a declare derived from emitted text, or a leading
-- dictionary count taken from parameter spelling.

-- Lines that are not `--` comments.
codeLinesOf : String -> List String
codeLinesOf text = filter (l => not (startsWith "--" (trimLeft l))) (lines text)

-- [check] over the code lines of compiler/backend/[file]; a file that cannot be
-- read fails rather than passing as one with nothing in it.
withBackendCode : String ->
  (List String -> Expectation) ->
  <IO, FileRead> Expectation
withBackendCode file check =
  match readFile "\{medakaRoot}/compiler/backend/\{file}"
    Err e => fail "cannot read compiler/backend/\{file}: \{e}"
    Ok text => check (codeLinesOf text)

-- Supplemental partial-name checks retain the earlier spelling-based refusals.
-- They do not recognize renamed partial restorations.
partialGroupNames : String -> List String
partialGroupNames target =
  if target == "llvm" then
    ["distinctImplKeys :", "gatherGroup :"]
  else
    ["distinctImplKeys :", "gatherImplGroup :"]

partialValueNames : List String
partialValueNames = [
  "scanFnValueUses",
  "scanImplValueUses",
  "scanImplEntryValueUses",
  "scanBindValueUses",
  "scanExprValueUses",
  "scanArmValueUses",
  "scanGuardValueUses",
  "scanBlockValueUses",
]

partialNameFindings : List String -> String -> List String
partialNameFindings names text = filter (name => contains name text) names

test "supplemental partial-name checks reject historical spellings" = match (
  readFile "\{medakaRoot}/compiler/backend/llvm_emit.mdk",
  readFile "\{medakaRoot}/compiler/backend/wasm_emit.mdk",
  retirementFixture "group-llvm",
)
  (Ok llvm, Ok wasm, Ok historical) =>
    let partial = optionOr "" (head (split "gatherGroup :" historical))
    let restored = "\{llvm}\n\{partial}"
    expectAll [
      expectEqual [] (partialNameFindings (partialGroupNames "llvm") llvm),
      expectEqual [] (partialNameFindings (partialGroupNames "wasm") wasm),
      expectEqual
        []
        (partialNameFindings partialValueNames (join "\n" (codeLinesOf wasm))),
      expectEqual
        ["distinctImplKeys :"]
        (partialNameFindings (partialGroupNames "llvm") restored),
      expectEqual (Ok []) (checkRetirement "R-GROUP LLVM" historical restored),
      expectEqual
        ["scanExprValueUses"]
        (partialNameFindings
          partialValueNames
          "scanExprValueUses fnNames ctorArs"),
    ]
  (Err e, _, _) => fail e
  (_, Err e, _) => fail e
  (_, _, Err e) => fail e

-- This bounded fingerprint recognizes the retained historical families under
-- consistent identifier substitutions. It does not decide semantic equivalence:
-- changing control flow, literals, constructors or clause order can evade it.
-- Match whole families, including helper multiplicity, rather than banning a
-- generic recursive list walk that a target physical adapter may also need.
retirementFixtures : List (String, String, String)
retirementFixtures = [
  ("R-ROSTER LLVM", "roster-llvm", "llvm_emit.mdk"),
  ("R-ORD LLVM", "ordinal-llvm", "llvm_emit.mdk"),
  ("R-GROUP LLVM", "group-llvm", "llvm_emit.mdk"),
  ("R-ROSTER Wasm", "roster-wasm", "wasm_emit.mdk"),
  ("R-ORD Wasm", "ordinal-wasm", "wasm_emit.mdk"),
  ("R-GROUP Wasm", "group-wasm", "wasm_emit.mdk"),
  ("R-VALUSE Wasm", "valuse-wasm", "wasm_emit.mdk"),
]

retirementFixture : String -> <IO, FileRead> Result String String
retirementFixture name =
  readFile "\{medakaRoot}/test/backend_retirement_fixtures/\{name}.txt"

-- Parse first, then print each complete function with the existing AST printer.
-- This removes comments, source locations, whitespace and redundant parentheses.
-- Lowercase identifiers are erased, including their equality relationships:
-- binders in separate scopes may be alpha-renamed independently. This can
-- collide with unrelated same-shaped code; whole-family matching limits that
-- conservatism, and the physical-adapter controls pin the current neighbors.
retirementFunctions : List Decl -> OrdMap (List Decl)
retirementFunctions ds = fold (acc d => retirementMerge d acc) omEmpty ds

retirementMerge : Decl -> OrdMap (List Decl) -> OrdMap (List Decl)
retirementMerge (DFunDef _ n ps body _ _) acc =
  omInsert
    n
    (DFunDef False n ps body noDeclLoc noBinderId
      :: optionOr [] (omLookup n acc))
    acc
retirementMerge (DAttrib _ inner) acc = retirementMerge inner acc
retirementMerge _ acc = acc

retirementTokens : List Token -> List String
retirementTokens [] = []
retirementTokens ((TIdent _) :: rest) = "IDENT" :: retirementTokens rest
retirementTokens (t :: rest) =
  if isLayoutTok t || t == TEof then
    retirementTokens rest
  else
    tokenToString t :: retirementTokens rest

retirementShape : List Decl -> String
retirementShape ds =
  let text = programToString (reverse ds)
  let (tokens, spans) = tokenizeWithOffsetPairs text
  let names = canonicalRetirementNames tokens omEmpty
  let normalized =
    stringConcat (renameRetirementTokens text names tokens spans 0)
  join "\n" (retirementTokens (tokenize (programToString (parse normalized))))

-- Canonicalize before the final print: identifier width can change the printer's
-- optional parentheses and trailing commas, even when the AST shape is unchanged.
canonicalRetirementNames : List Token -> OrdMap String -> OrdMap String
canonicalRetirementNames [] names = names
canonicalRetirementNames ((TIdent n) :: rest) names =
  canonicalRetirementNames rest (omInsert n "identifier" names)
canonicalRetirementNames (_ :: rest) names = canonicalRetirementNames rest names

retirementShapes : String -> Result String (OrdMap Int)
retirementShapes text = match parseResult text
  Err _ => Err "retirement: source does not parse"
  Ok ds =>
    let funcs = retirementFunctions ds
    Ok
      (fold
        (counts n =>
          let shape = retirementShape (optionOr [] (omLookup n funcs))
          omInsert shape (1 + optionOr 0 (omLookup shape counts)) counts)
        omEmpty
        (omKeys funcs))

retirementFindings : String ->
  OrdMap Int ->
  OrdMap Int ->
  Result String (List String)
retirementFindings family historical actual =
  if isEmpty (omKeys historical) then
    Err "retirement: empty historical family \{family}"
  else
    Ok (if all
      (shape =>
        optionOr 0 (omLookup shape actual)
          >= optionOr 0 (omLookup shape historical))
      (omKeys historical) then
      [family]
    else
      [])

checkRetirement : String -> String -> String -> Result String (List String)
checkRetirement family historical actual = do
  required <- retirementShapes historical
  found <- retirementShapes actual
  retirementFindings family required found

-- Rename only lexical identifier tokens belonging to declarations or binders;
-- strings, comments, constructors and imported callees remain intact. The set
-- comes from the parsed fixture, independently of fingerprint normalization.
renamedRetirement : String -> Result String String
renamedRetirement text = match parseResult text
  Err _ => Err "retirement: fixture does not parse"
  Ok ds =>
    let bound =
      omFromNames (flatMap declBinderNames ds ++ localBoundNames ds) omEmpty
    let names =
      omFromPairs
        (mapWithIndex
          (i n => (n, "restoredIdentifier_\{1000003 - 13 * i}"))
          (omKeys bound))
        omEmpty
    let (tokens, spans) = tokenizeWithOffsetPairs text
    Ok (stringConcat (renameRetirementTokens text names tokens spans 0))

renameRetirementTokens : String ->
  OrdMap String ->
  List Token ->
  List (Int, Int) ->
  Int ->
  List String
renameRetirementTokens text names (t :: ts) ((start, end) :: spans) offset =
  match t
    TIdent n => match omLookup n names
      Some replacement =>
        sliceClamped offset start text
          :: replacement
          :: renameRetirementTokens text names ts spans end
      None => renameRetirementTokens text names ts spans offset
    _ => renameRetirementTokens text names ts spans offset
renameRetirementTokens text _ [] [] offset =
  [sliceClamped offset (stringLength text) text]
renameRetirementTokens _ _ _ _ _ = panic "retirement: token/span mismatch"

expectRetirementRestored : String -> Bool -> <IO, FileRead> Expectation
expectRetirementRestored fixture renamed =
  match filter ((_, name, _) => name == fixture) retirementFixtures
    [(family, _, emitter)] => match (
      retirementFixture fixture,
      readFile "\{medakaRoot}/compiler/backend/\{emitter}",
    )
      (Ok historical, Ok current) =>
        match if renamed then renamedRetirement historical else Ok historical
          Err e => fail e
          Ok restored =>
            let verdict =
              checkRetirement family historical "\{current}\n\{restored}"
            expectAll [
              expectAtLeast
                1
                (length (omKeys (retirementFunctions (parse restored)))),
              if renamed then
                expectNotEqual historical restored
              else
                expectEqual historical restored,
              expectEqual
                (retirementShapes historical)
                (retirementShapes restored),
              expectFindings family verdict,
              expectEqual (Ok [family]) verdict,
            ]
      (Err e, _) => fail e
      (_, Err e) => fail e
    _ => fail "retirement: unknown fixture \{fixture}"

test "R-ROSTER Wasm complete original restoration" =
  expectRetirementRestored "roster-wasm" False
test "R-ROSTER Wasm complete renamed restoration" =
  expectRetirementRestored "roster-wasm" True
test "R-ORD Wasm complete original restoration" =
  expectRetirementRestored "ordinal-wasm" False
test "R-ORD Wasm complete renamed restoration" =
  expectRetirementRestored "ordinal-wasm" True
test "R-GROUP Wasm complete original restoration" =
  expectRetirementRestored "group-wasm" False
test "R-GROUP Wasm complete renamed restoration" =
  expectRetirementRestored "group-wasm" True
test "R-VALUSE Wasm complete original restoration" =
  expectRetirementRestored "valuse-wasm" False
test "R-VALUSE Wasm complete renamed restoration" =
  expectRetirementRestored "valuse-wasm" True
test "R-ROSTER LLVM complete original restoration" =
  expectRetirementRestored "roster-llvm" False
test "R-ROSTER LLVM complete renamed restoration" =
  expectRetirementRestored "roster-llvm" True
test "R-ORD LLVM complete original restoration" =
  expectRetirementRestored "ordinal-llvm" False
test "R-ORD LLVM complete renamed restoration" =
  expectRetirementRestored "ordinal-llvm" True
test "R-GROUP LLVM complete original restoration" =
  expectRetirementRestored "group-llvm" False
test "R-GROUP LLVM complete renamed restoration" =
  expectRetirementRestored "group-llvm" True

test "current target physical adapters contain no historical semantic producer family" = expectAll
  [
    expectAtLeast 4 (length retirementFixtures),
    expectEach
      (map
        ((family, fixture, emitter) => (
          family,
          match (
            retirementFixture fixture,
            readFile "\{medakaRoot}/compiler/backend/\{emitter}",
          )
            (Ok historical, Ok current) =>
              expectNoFindings
                family
                (checkRetirement family historical current)
            (Err e, _) => fail e
            (_, Err e) => fail e,
        ))
        retirementFixtures),
  ]

test "retirement fingerprints erase identifiers and retain semantic tokens" =
  let base = retirementShapes "apply f x = f x"
  expectEach [
    (
      "opaque declaration and local renames",
      expectEqual base (retirementShapes "opaque a b = a b"),
    ),
    (
      "documented collision for different identifier relationships",
      expectEqual base (retirementShapes "apply f x = f f"),
    ),
    (
      "operators",
      expectNotEqual
        (retirementShapes "f x = x + 1")
        (retirementShapes "g y = y - 1"),
    ),
    (
      "literals",
      expectNotEqual
        (retirementShapes "f x = x + 1")
        (retirementShapes "g y = y + 2"),
    ),
    (
      "constructors",
      expectNotEqual
        (retirementShapes "f x = Some x")
        (retirementShapes "g y = Ok y"),
    ),
    (
      "comments and parentheses",
      expectEqual base (retirementShapes "-- apply\nopaque a b = (a b)"),
    ),
    (
      "parser errors cannot count as retirement findings",
      expectEqual
        (Err "retirement: source does not parse")
        (retirementShapes "broken = ("),
    ),
    (
      "empty reference cannot pass",
      expectEqual
        (Err "retirement: empty historical family empty")
        (checkRetirement "empty" "" "main = 42"),
    ),
  ]

test "similar physical tables and method buckets are lawful retirement neighbors" =
  let physical =
    """
    physicalTags : String -> List String
    physicalTags "Option" = ["i31:0", "struct:1"]
    physicalTags "Result" = ["struct:0", "struct:1"]
    physicalTags "Ordering" = ["i31:0", "i31:1", "i31:2"]
    physicalTags _ = []
    methodBuckets [] buckets = buckets
    methodBuckets (entry :: rest) buckets =
      let method = implEntryMethodW entry
      let bucket = optionOr [] (omLookup method buckets)
      methodBuckets rest (omInsert method (entry :: bucket) buckets)
    physicalOrdinals [] _ acc = acc
    physicalOrdinals (name :: rest) index acc =
      physicalOrdinals rest (index + 1) (omInsert name index acc)
    """
  expectEach
    (map
      ((family, fixture, _) => (
        family,
        match retirementFixture fixture
          Err e => fail e
          Ok historical =>
            expectNoFindings family (checkRetirement family historical physical),
      ))
      retirementFixtures)

test "retirement fingerprints allow independent renaming of shadowed binders" =
  expectEqual
    (retirementShapes
      """
      f x =
        let x = x + 1
        x
      f x y =
        let x = x + y
        x
      """)
    (retirementShapes
      """
      renamed first =
        let inner = first + 1
        inner
      renamed other delta =
        let result = other + delta
        result
      """)

test "no emitter derives declares from emitted text" =
  expectAll
    (map
      (file =>
        labelFail
          "\{file} derives declares from text"
          (withBackendCode file (code =>
            expectFalse
              (any
                (l =>
                  contains "declareOfDefine" l || contains "emitDeclaresFor" l)
                code))))
      ["llvm_emit.mdk", "wasm_emit.mdk", "llvm_preamble.mdk"])

test "no emitter counts leading dictionary parameters from their spelling" =
  expectAll
    (map
      (file =>
        labelFail
          "\{file} counts dictionary parameters itself"
          (withBackendCode file (code =>
            expectFalse
              (any
                (l =>
                  contains "leadingDictPats" l
                    || contains "wLeadingDictPats" l
                    || contains "isDictParamName" l
                    || contains "startsWith \"$dict\"" l)
                code))))
      ["llvm_emit.mdk", "wasm_emit.mdk", "trmc_analysis.mdk", "emit_plan.mdk"])

-- Every entry that imports an emitter is a route a program reaches an artifact
-- through; each builds its plan with `buildEmitPlan*`, never by hand.
emitRoutes : List String
emitRoutes = [
  "llvm_bootstrap_lex_main.mdk", "llvm_emit_main.mdk",
  "llvm_emit_modules_main.mdk", "llvm_emit_typed_main.mdk",
  "playground_main.mdk", "profile_main.mdk", "wasm_emit_gaps_main.mdk",
  "wasm_emit_main.mdk", "wasm_emit_modules_main.mdk", "wasm_emit_typed_main.mdk"
]

importsEmitter : String -> Bool
importsEmitter text =
  any
    (l =>
      startsWith "import backend.llvm_emit" l
        || startsWith "import backend.wasm_emit" l)
    (lines text)

test "the emit-route entries are exactly the pinned roster and each builds its plan" =
  match listDir "\{medakaRoot}/compiler/entries"
    Err e => expectEqual "listable" "cannot list compiler/entries: \{e}"
    Ok names =>
      let entries = filter (n => endsWith ".mdk" n) names
      let routes =
        filter
          (n => match readFile "\{medakaRoot}/compiler/entries/\{n}"
            Ok text => importsEmitter text
            Err _ => False)
          entries
      expectAll [
        labelFail "emit routes found" (expectNotEqual [] routes),
        expectEqual (sort emitRoutes) (sort routes),
        expectAll
          (map
            (n => match readFile "\{medakaRoot}/compiler/entries/\{n}"
              Ok text =>
                labelFail
                  "\{n} builds no emission plan"
                  (expectTrue (contains "buildEmitPlan" text))
              Err e => expectEqual "readable" "cannot read \{n}: \{e}")
            routes),
      ]

-- ── wasm-only reach ─────────────────────────────────────────────────────────

-- main = m            (dispatch only: a CMethod, no static reference to the impl)
-- impl m for Int = g  (the impl body reads the lazy global g)
-- g = g               (a self-loop, so lazy)
-- dead = 2            (named by nothing)
-- impl k for Int = 3  (k is mentioned by nothing reachable)
-- Units: 3 binds + 2 impls = 5; reach keeps main, g and the m impl = 3.
methodRef : String -> CExpr
methodRef name = CMethod name (MethodEvidence "" 0 RNone [] [])

implOf : String -> CExpr -> CImplEntry
implOf method body =
  CImplEntry method 0 0 (CImplTagged "Int" "Int" "I" noImplSym [] [] body)

reachProgram : CProgram
reachProgram =
  CProgram
    [
      val "main" (methodRef "m"),
      val "g" (ref "g"),
      val "dead" (CLit (LInt 2)),
    ]
    []
    []
    [implOf "m" (ref "g"), implOf "k" (CLit (LInt 3))]
    []
    noDeclFacts

implMethods : CProgram -> List String
implMethods (CProgram _ _ _ impls _ _) = map implName impls

implName : CImplEntry -> String
implName (CImplEntry m _ _ _) = m

bindNames : CProgram -> List String
bindNames (CProgram groups _ _ _ _ _) = map bindNm groups

bindNm : CBind -> String
bindNm (CBind n _ _ _) = n

test "wasm reach keeps a dispatch-only impl and its lazy global, drops the rest" =
  let (plan, reached) =
    buildEmitPlanReached PreludeFreeRuntime omEmpty reachProgram
  expectAll [
    labelFail
      "the m impl survives, the k impl does not"
      (expectEqual ["m"] (implMethods reached)),
    labelFail
      "main and g survive, dead does not"
      (expectEqual ["main", "g"] (bindNames reached)),
    labelFail
      "the plan counts 5 total and 3 kept units"
      (expectEqual "Some (5, 3)" (match plan.wasmOnlyReach
        Some u => "Some (\{u.total}, \{u.kept})"
        None => "None")),
    labelFail
      "partition is for reached program"
      (expectEqual
        [("m", "Int", [0])]
        (map
          (g => (
            (g : ImplClauseGroup).method,
            (g : ImplClauseGroup).key,
            (g : ImplClauseGroup).indices,
          ))
          plan.implGroups)),
    labelFail "g is lazy" (expectEqual ["g"] plan.lazyGlobals),
    labelFail
      "reached value order"
      (expectEqual ["g"] plan.globalInit.valueOrder),
    labelFail "reached eager order" (expectEqual [] plan.globalInit.eagerOrder),
    labelFail
      "reached Core validates"
      (expectEqual
        []
        (validateGlobalInit reached plan.lazyGlobals plan.globalInit)),
    labelFail
      "dead has no eagerReach entry"
      (expectEqual ["<no entry>"] (reachOf "dead" plan)),
    labelFail
      "g has an eagerReach entry"
      (expectNotEqual (reachOf "g" plan) ["<no entry>"]),
  ]

test "an unreached plan reports no reach and keeps every unit" =
  let plan = buildEmitPlan WasmBackend PreludeFreeRuntime reachProgram
  expectAll [
    labelFail "no wasmOnlyReach" (expectTrue (isNone plan.wasmOnlyReach)),
    labelFail
      "dead keeps its eagerReach entry"
      (expectNotEqual (reachOf "dead" plan) ["<no entry>"]),
  ]

-- ── TRMC verdict and dispatch groups ────────────────────────────────────────

fn : String -> List String -> CExpr -> CBind
fn name params body =
  synthBind name [CClause (map (p => PVar p noDeclLoc noBinderId) params) body]

call : String -> List CExpr -> CExpr
call f args = mkApp (ref f) args

int : Int -> CExpr
int n = CLit (LInt n)

prim : String -> CExpr -> CExpr -> CExpr
prim op l r = CBinPrim op l r "" noDeclLoc

trmcPlan : List (String, Int) -> List CBind -> EmitPlan
trmcPlan ctors binds =
  buildEmitPlan
    LlvmBackend
    PreludeFreeRuntime
    (CProgram binds ctors [] [] [] noDeclFacts)

-- upto lo hi = if lo > hi then [] else lo :: upto (lo + 1) hi
uptoLeaf : CExpr
uptoLeaf =
  prim "::" (ref "lo") (call "upto" [prim "+" (ref "lo") (int 1), ref "hi"])

upto : CBind
upto =
  fn
    "upto"
    ["lo", "hi"]
    (CIf (prim ">" (ref "lo") (ref "hi")) (CList []) uptoLeaf)

-- data T = Leaf | Node Int T
-- build n = if n == 0 then Leaf else Node n (build (n - 1))
buildLeaf : CExpr
buildLeaf = call "Node" [ref "n", call "build" [prim "-" (ref "n") (int 1)]]

build : CBind
build =
  fn "build" ["n"] (CIf (prim "==" (ref "n") (int 0)) (ref "Leaf") buildLeaf)

treeCtors : List (String, Int)
treeCtors = [("Leaf", 0), ("Node", 2)]

test "a cons-tail builder is TRMC-eligible" =
  expectTrue (isTrmcFn (trmcPlan [] [upto]).trmc "upto")

-- Both backends realize this verdict.  Which cell the loop links is per backend:
-- wasm asks `ctorTailIsCons` of each leaf and builds the built-in list cell only
-- for `::`, the user constructor's struct otherwise.
test "a user constructor tail is eligible, and is not the built-in list cell" = expectAll
  [
    labelFail
      "build is eligible"
      (expectTrue (isTrmcFn (trmcPlan treeCtors [build]).trmc "build")),
    labelFail
      "the Node leaf is a user cell"
      (expectFalse (ctorTailIsCons buildLeaf)),
    labelFail
      "the :: leaf is the list cell"
      (expectTrue (ctorTailIsCons uptoLeaf)),
    labelFail
      "without the program's constructor table, Node is no constructor"
      (expectFalse (isTrmcFn (trmcPlan [] [build]).trmc "build")),
  ]

-- keep xs = match xs
--   y :: ys | keep ys == [] => [y]
--   y :: ys => y :: keep ys
--   [] => []
consArm : CArm
consArm =
  CArm
    (PCons (PVar "y" noDeclLoc noBinderId) (PVar "ys" noDeclLoc noBinderId))
    []
    (prim "::" (ref "y") (call "keep" [ref "ys"]))

nilArm : CArm
nilArm = CArm (PList []) [] (CList [])

guardArm : CArm
guardArm =
  CArm
    (PCons (PVar "y" noDeclLoc noBinderId) (PVar "ys" noDeclLoc noBinderId))
    [CGBool (prim "==" (call "keep" [ref "ys"]) (CList []))]
    (CList [ref "y"])

keepWith : List CArm -> CBind
keepWith arms = fn "keep" ["xs"] (CDecision (ref "xs") arms (CTLeaf 0))

test "a self-call in a match guard disqualifies the function" = expectAll [
  labelFail
    "without the guard arm it is eligible"
    (expectTrue
      (isTrmcFn (trmcPlan [] [keepWith [consArm, nilArm]]).trmc "keep")),
  labelFail
    "with it, it is not"
    (expectFalse
      (isTrmcFn
        (trmcPlan [] [keepWith [guardArm, consArm, nilArm]]).trmc
        "keep")),
]

-- c0 k = if k <= 0 then [] else 0 :: c0 (k - 1)
-- c1 k = if k <= 0 then c0 1 else 1 :: c1 (k - 1)
-- main = c1 5
-- c0 builds its own spine, so it stays a singleton.  c1 conses onto itself and
-- tail-calls c0, and nothing outside reaches c0, so c1 roots the group {c1, c0}.
consFamily : List CBind
consFamily = [
  fn
    "c0"
    ["k"]
    (CIf
      (prim "<=" (ref "k") (int 0))
      (CList [])
      (prim "::" (int 0) (call "c0" [prim "-" (ref "k") (int 1)]))),
  fn
    "c1"
    ["k"]
    (CIf
      (prim "<=" (ref "k") (int 0))
      (call "c0" [int 1])
      (prim "::" (int 1) (call "c1" [prim "-" (ref "k") (int 1)]))),
  val "main" (call "c1" [int 5]),
]

test "a mutually tail-calling cons family is one dispatch group" =
  expectEqual
    [("c1", ["c1", "c0"])]
    (map
      (g => (dispRootOf g, dispMembersOf g))
      (trmcPlan [] consFamily).dispGroups)

-- impl Upto Int where
--   upto lo hi = if lo > hi then [] else lo :: upto (lo + 1) hi
-- The recursion dispatches through the instance's own word, `K`, so the group is
-- eligible.  The same body recursing through another instance's word has no
-- self-call, so its group is not.
uptoImpl : String -> CImplEntry
uptoImpl word =
  let self = CMethod "upto" (MethodEvidence "Upto" 2 (RKey word [] []) [] [])
  let leaf =
    prim "::" (ref "lo") (mkApp self [prim "+" (ref "lo") (int 1), ref "hi"])
  let body = CIf (prim ">" (ref "lo") (ref "hi")) (CList []) leaf
  let pats = map (p => PVar p noDeclLoc noBinderId) ["lo", "hi"]
  CImplEntry "upto" 0 2 (CImplTagged "Int" "K" "Upto" noImplSym [] pats body)

implTrmc : String -> Bool
implTrmc word =
  let plan =
    buildEmitPlan
      LlvmBackend
      PreludeFreeRuntime
      (CProgram [] [] [] [uptoImpl word] [] noDeclFacts)
  isTrmcImpl plan.trmc "upto" "K"

test "an impl group recursing through its own instance word is TRMC-eligible" = expectAll
  [
    labelFail "self word" (expectTrue (implTrmc "K")),
    labelFail "another instance's word" (expectFalse (implTrmc "Other")),
  ]

test "impl plan groups keep clause order for TRMC and prepared programs" =
  let first = uptoImpl "K"
  let second = uptoImpl "K"
  let (CImplEntry method arity slots (CImplTagged tag key _ sym pos pats body)) =
    first
  let inherited =
    CImplEntry
      "inherited"
      arity
      slots
      (CImplDefault "I" tag "D" sym pos pats body)
  let cp = CProgram [] [] [] [first, inherited, second] [] noDeclFacts
  let plan = buildEmitPlan LlvmBackend PreludeFreeRuntime cp
  let rows =
    map
      (g => (
        (g : ImplClauseGroup).method,
        (g : ImplClauseGroup).key,
        (g : ImplClauseGroup).indices,
      ))
      plan.implGroups
  expectEach [
    (
      "partition",
      expectEqual [(method, key, [0, 2]), ("inherited", "D", [1])] rows,
    ),
    ("grouped eligible", expectTrue (isTrmcImpl plan.trmc method key)),
  ]

-- ── host keys ───────────────────────────────────────────────────────────────

-- The keys follow from the catalog: an `EnvImport` extern's key is the one host
-- import its lowering calls, so a program reaching only clock, math or `exit`
-- externs has exactly their keys, sorted, and none of another group's.  The IO
-- externs are `Inline` and carry no key of their own.
hostKeysOf : Backend -> CExpr -> List String
hostKeysOf target mainBody =
  (buildEmitPlan
    target
    PreludeFreeRuntime
    (program [val "main" mainBody])).hostKeys

unit : CExpr
unit = CLit LUnit

float : Float -> CExpr
float x = CLit (LFloat x)

test "a wasm plan's host keys are its reached externs' imports, per group" = expectAll
  [
    labelFail
      "clock: wallTimeSec only"
      (expectEqual
        ["mdk_wall_time_sec"]
        (hostKeysOf WasmBackend (call "wallTimeSec" [unit]))),
    labelFail
      "clock: all three, sorted"
      (expectEqual
        ["mdk_monotonic_sec", "mdk_sleep_ms", "mdk_wall_time_sec"]
        (hostKeysOf
          WasmBackend
          (CTuple [
            call "monotonicSec" [unit],
            call "sleepMs" [int 1],
            call "wallTimeSec" [unit],
          ]))),
    labelFail
      "math: sin and pow, a repeat counted once"
      (expectEqual
        ["mdk_pow", "mdk_sin"]
        (hostKeysOf
          WasmBackend
          (call "pow" [call "sin" [float 1.0], call "sin" [float 2.0]]))),
    labelFail
      "exit only"
      (expectEqual ["mdk_exit"] (hostKeysOf WasmBackend (call "exit" [int 0]))),
    labelFail
      "readFile: the grant and path channels, the read and the result channel; no args, env or exit"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_read_file",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "readFile" [ref "p", CList []]))),
    labelFail
      "canonicalizePath: the grant and path channels, the host answer and a refusal's panic"
      (expectEqual
        [
          "mdk_canonicalize_path",
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_write_err_byte",
        ]
        (hostKeysOf WasmBackend (call "canonicalizePath" [ref "p", CList []]))),
    labelFail
      "writeFile: the grant and path channels, the write channel, the commit and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_write_file",
          "mdk_write_file_push",
          "mdk_write_file_reset",
        ]
        (hostKeysOf
          WasmBackend
          (call "writeFile" [ref "p", str "x", CList []]))),
    labelFail
      "appendFile: the grant and path channels, the append, the write channel and the result channel"
      (expectEqual
        [
          "mdk_append_file",
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_write_file_push",
          "mdk_write_file_reset",
        ]
        (hostKeysOf
          WasmBackend
          (call "appendFile" [ref "p", str "x", CList []]))),
    labelFail
      "makeDir: the grant and path channels, the creation and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_make_dir",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "makeDir" [ref "p", CList []]))),
    labelFail
      "removeFile: the grant and path channels, the removal and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_remove_file",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "removeFile" [ref "p", CList []]))),
    labelFail
      "removeDir: the grant and path channels, the removal and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_remove_dir",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "removeDir" [ref "p", CList []]))),
    labelFail
      "fsync: the grant and path channels, the flush and the result channel"
      (expectEqual
        [
          "mdk_fsync",
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "fsync" [ref "p", CList []]))),
    labelFail
      "fileMode: the grant and path channels, the stat and its mode field, not statFile's own key"
      (expectEqual
        [
          "mdk_file_mode",
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_stat_field",
        ]
        (hostKeysOf WasmBackend (call "fileMode" [ref "p", CList []]))),
    labelFail
      "writeFileMode: the grant and path channels, the write channel, the commit with its mode and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_write_file_mode",
          "mdk_write_file_push",
          "mdk_write_file_reset",
        ]
        (hostKeysOf
          WasmBackend
          (call "writeFileMode" [ref "p", int 420, str "x", CList []]))),
    labelFail
      "rename: the grant and path channels, the move and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_rename",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf
          WasmBackend
          (call "rename" [ref "a", ref "b", CList [], CList []]))),
    labelFail
      "listDir: the grant and path channels, the listing and the result channel"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_list_dir",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "listDir" [ref "p", CList []]))),
    labelFail
      "statFile: the grant and path channels, the stat and its fields"
      (expectEqual
        [
          "mdk_grant_push",
          "mdk_grant_reset",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_stat_field",
          "mdk_stat_file",
        ]
        (hostKeysOf WasmBackend (call "statFile" [ref "p", CList []]))),
    labelFail
      "a declared file bound: the grant channel and the bound frame"
      (expectEqual
        [
          "mdk_file_bound_enter",
          "mdk_file_bound_exit",
          "mdk_grant_push",
          "mdk_grant_reset",
        ]
        (hostKeysOf
          WasmBackend
          (call "$withFileReadBound" [
            CList [str "cfg/*"],
            CLam [PWild] unit,
          ]))),
    labelFail
      "args: the argument channel only"
      (expectEqual
        ["mdk_arg_byte", "mdk_arg_len", "mdk_args_count"]
        (hostKeysOf WasmBackend (call "args" [unit]))),
    labelFail
      "getEnv: the path channel, the lookup and the result channel"
      (expectEqual
        [
          "mdk_get_env",
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_result_byte",
          "mdk_result_len",
        ]
        (hostKeysOf WasmBackend (call "getEnv" [ref "p"]))),
    labelFail
      "readLine and readLineOpt: the one line key and the result channel"
      (expectEqual
        ["mdk_read_line", "mdk_result_byte", "mdk_result_len"]
        (hostKeysOf WasmBackend (call "readLineOpt" [unit]))),
    labelFail
      "readAll: the drain key and the result channel"
      (expectEqual
        ["mdk_read_all", "mdk_result_byte", "mdk_result_len"]
        (hostKeysOf WasmBackend (call "readAll" [unit]))),
    labelFail
      "readExactly: the count key and the result channel"
      (expectEqual
        ["mdk_read_exactly", "mdk_result_byte", "mdk_result_len"]
        (hostKeysOf WasmBackend (call "readExactly" [ref "n"]))),
    labelFail
      "osEntropyBytes: the entropy key, the result channel and a refusal's panic"
      (expectEqual
        [
          "mdk_os_entropy",
          "mdk_result_byte",
          "mdk_result_len",
          "mdk_write_err_byte",
        ]
        (hostKeysOf WasmBackend (call "osEntropyBytes" [ref "n"]))),
    labelFail
      "executablePath: the path key and the result channel"
      (expectEqual
        ["mdk_executable_path", "mdk_result_byte", "mdk_result_len"]
        (hostKeysOf WasmBackend (call "executablePath" [unit]))),
    labelFail
      "stringToFloat: the path channel and the host parse"
      (expectEqual
        [
          "mdk_path_push",
          "mdk_path_reset",
          "mdk_str_to_float",
          "mdk_str_to_float_ok",
        ]
        (hostKeysOf WasmBackend (call "stringToFloat" [ref "p"]))),
    labelFail
      "a pure program has none"
      (expectEqual [] (hostKeysOf WasmBackend (prim "+" (int 1) (int 2)))),
    labelFail
      "an llvm plan has none"
      (expectEqual [] (hostKeysOf LlvmBackend (call "exit" [int 0]))),
  ]

-- statFile's lowering builds a 4-tuple the program may never write, so the plan
-- declares that arity itself; a program without the extern does not.
test "statFile demands the 4-tuple type; a pure program demands none" = expectAll
  [
    labelFail
      "statFile"
      (expectEqual
        [4]
        (buildEmitPlan
          WasmBackend
          PreludeFreeRuntime
          (program [
            val "main" (call "statFile" [ref "p", CList []]),
          ])).wasmDemand.tupleArities),
    labelFail
      "pure"
      (expectEqual
        []
        (buildEmitPlan
          WasmBackend
          PreludeFreeRuntime
          (program [
            val "main" (prim "+" (int 1) (int 2)),
          ])).wasmDemand.tupleArities),
  ]

-- The stderr writer's key is the static half of the module's stderr import: the
-- externs whose runtime writes stderr (`$mdk_eprint_str`) carry it.  A coded trap
-- adds the import while lowering, which no plan sees, so a trap-free program
-- without those externs has no key.
str : String -> CExpr
str s = CLit (LString s)

test "the stderr writer's key comes with each extern whose runtime writes stderr" = expectAll
  [
    labelFail
      "ePutStrLn"
      (expectEqual
        ["mdk_write_err_byte"]
        (hostKeysOf WasmBackend (call "ePutStrLn" [str "x"]))),
    labelFail
      "panic"
      (expectEqual
        ["mdk_write_err_byte"]
        (hostKeysOf WasmBackend (call "panic" [str "x"]))),
    labelFail
      "putStrLn writes stdout only"
      (expectEqual [] (hostKeysOf WasmBackend (call "putStrLn" [str "x"]))),
  ]

-- ── names the emitter does not lower as an extern ───────────────────────────

-- A binder shadows an extern of its name wherever it is in scope, so the plan
-- notes the extern's keys only where the emitter would call the extern: outside
-- the binder's scope, or in a `let`'s own right side when the `let` is not `rec`.
-- A top-level binding wins over an extern in value position, and so does the
-- `core__` function a bare prelude name stands for in either position.  An applied
-- name the program also defines at top level is still the extern, which is the
-- emitter's order; a lowered program never has one, because module lowering
-- prefixes every top-level name with its module.
pvar : String -> Pat
pvar x = PVar x noDeclLoc noBinderId

argsKeys : List String
argsKeys = ["mdk_arg_byte", "mdk_arg_len", "mdk_args_count"]

keysOf : List CBind -> List String
keysOf binds =
  (buildEmitPlan WasmBackend PreludeFreeRuntime (program binds)).hostKeys

test "a binder named like an extern demands nothing; the extern itself does" = expectAll
  [
    labelFail
      "a clause parameter, read and applied"
      (expectEqual
        []
        (keysOf [
          fn "count" ["args"] (CTuple [ref "args", call "args" [unit]]),
          val "main" (call "count" [int 1]),
        ])),
    labelFail
      "a clause parameter does not reach another function"
      (expectEqual
        argsKeys
        (keysOf [
          fn "count" ["args"] (ref "args"),
          fn "other" ["xs"] (call "args" [unit]),
        ])),
    labelFail
      "a let binder over its body"
      (expectEqual
        []
        (keysOf [
          val
            "main"
            (CLet
              False
              (pvar "listDir")
              (int 7)
              (prim "+" (ref "listDir") (int 1))),
        ])),
    labelFail
      "a let binder is not in scope in its own right side"
      (expectEqual
        argsKeys
        (keysOf [
          val
            "main"
            (CLet False (pvar "args") (call "args" [unit]) (ref "args")),
        ])),
    labelFail
      "a rec let binder is in scope in its own right side"
      (expectEqual
        []
        (keysOf [
          val
            "main"
            (CLet
              True
              (pvar "args")
              (CLam [pvar "u"] (call "args" [ref "u"]))
              (call "args" [unit])),
        ])),
    labelFail
      "a lambda parameter, and not past the lambda"
      (expectEqual
        argsKeys
        (keysOf [
          val
            "main"
            (CTuple [
              CLam [pvar "getEnv", pvar "args"] (call "getEnv" [ref "args"]),
              call "args" [unit],
            ]),
        ])),
    labelFail
      "a match arm's pattern and a guard's binder"
      (expectEqual
        []
        (keysOf [
          val
            "main"
            (CMatch (int 1) [
              CArm (pvar "args") [] (call "args" [unit]),
              CArm
                PWild
                [CGBind (pvar "rename") (int 2)]
                (call "rename" [int 3]),
            ]),
        ])),
    labelFail
      "a guard's right side is outside its own binder"
      (expectEqual
        argsKeys
        (keysOf [
          val
            "main"
            (CMatch (int 1) [
              CArm PWild [CGBind (pvar "args") (call "args" [unit])] (int 0),
            ]),
        ])),
    labelFail
      "a block let and a let group"
      (expectEqual
        []
        (keysOf [
          val
            "main"
            (CBlock [
              CSLet False (pvar "args") (int 1),
              CSExpr (call "args" [unit]),
              CSExpr
                (CLetGroup [fn "listDir" ["u"] (int 1)] (call "listDir" [unit])),
            ]),
        ])),
    labelFail
      "an impl clause's parameter"
      (expectEqual
        []
        (buildEmitPlan
          WasmBackend
          PreludeFreeRuntime
          (CProgram
            []
            []
            []
            [
              CImplEntry
                "pick"
                0
                1
                (CImplTagged
                  "Int"
                  "K"
                  "Pick"
                  noImplSym
                  []
                  [pvar "getEnv"]
                  (call "getEnv" [str "HOME"])),
            ]
            []
            noDeclFacts)).hostKeys),
    labelFail
      "a shadowed extern demands none of its runtime either"
      (expectEqual
        []
        (buildEmitPlan
          WasmBackend
          PreludeFreeRuntime
          (program [fn "count" ["args"] (call "args" [unit])])).wasmDemand.uses),
  ]

test "a top-level definition named like an extern, as the emitter resolves it" = expectAll
  [
    labelFail
      "a lowered user definition carries its module's prefix"
      (expectEqual
        []
        (keysOf [
          fn "main__rename" ["x"] (prim "+" (ref "x") (int 1)),
          fn "main__fsync" ["x"] (ref "x"),
          fn "main__statFile" ["x"] (ref "x"),
          val
            "main"
            (CTuple [
              call "main__rename" [int 1],
              call "main__fsync" [int 2],
              call "main__statFile" [int 3],
            ]),
        ])),
    labelFail
      "read as a value, a top-level function or value is the definition"
      (expectEqual
        []
        (keysOf [
          fn "fsync" ["x"] (ref "x"),
          val "statFile" (int 3),
          val "main" (CTuple [ref "fsync", ref "statFile"]),
        ])),
    labelFail
      "a bare prelude name is its core__ function, applied or read"
      (expectEqual
        []
        (keysOf [
          fn "m636f7265__rename" ["x"] (ref "x"),
          val "main" (CTuple [call "rename" [int 1], ref "rename"]),
        ])),
    labelFail
      "applied, an unprefixed top-level name is still the extern"
      (expectEqual
        argsKeys
        (keysOf [
          fn "args" ["u"] (int 0),
          val "main" (call "args" [unit]),
        ])),
  ]

-- ── the `jsffi` imports (docs/spec/WASM-SEMANTICS.md section 3.1) ──────────

-- the reached wasm plan's imports as (Medaka name, JS name, field), and its
-- host keys
jsPlanOf : List CBind -> (List (String, String, String), List String)
jsPlanOf binds =
  let (plan, _) =
    buildEmitPlanReached PreludeFreeRuntime omEmpty (program binds)
  (
    map (imp => (imp.medakaName, imp.jsName, jsImportField imp)) plan.jsImports,
    plan.hostKeys,
  )

jsUpImport : List (String, String, String)
jsUpImport = [("$extern$u5:<raw>4:jsUp", "jsUpper", "jsUpper:String->String")]

test "an explicit extern variable and its declaration select the runtime import" =
  match filter (fact => fact.declaredName == "exit") implicitRuntimeFacts
    [fact] =>
      expectEqual
        ["mdk_exit"]
        (hostKeysOf WasmBackend (mkApp (externVar fact) [int 0]))
    _ => fail "canonical runtime has no unique exit declaration"

-- a `String` argument crosses on the path channel, a `String` result on the
-- result channel
jsUpKeys : List String
jsUpKeys =
  ["mdk_path_push", "mdk_path_reset", "mdk_result_byte", "mdk_result_len"]

test "a wasm plan imports each reached js binding once, and only those" = expectAll
  [
    labelFail
      "applied twice and named as a value: one import, with its channels"
      (expectEqual
        (jsUpImport, jsUpKeys)
        (jsPlanOf [
          val
            "main"
            (CTuple [
              call "jsUp" [CLit (LString "a")],
              call "jsUp" [CLit (LString "b")],
              ref "jsUp",
            ]),
        ])),
    labelFail
      "named only in a function main never reaches: no import"
      (expectEqual
        ([], [])
        (jsPlanOf [
          fn "unused" ["s"] (call "jsUp" [ref "s"]),
          val "main" (int 0),
        ])),
    labelFail
      "a parameter named like the binding is the parameter"
      (expectEqual
        ([], [])
        (jsPlanOf [
          fn "apply" ["jsUp"] (call "jsUp" [int 1]),
          val "main" (call "apply" [ref "apply"]),
        ])),
    labelFail
      "an extern with no js binding imports nothing"
      (expectEqual ([], []) (jsPlanOf [val "main" (call "cNeg" [int 1])])),
  ]

test "method result plan index preserves qualified interface identity on both backends" =
  let left = MethodResultFact {
    iface = "left::Shared",
    method = "pick",
    returnsHead = True,
    callbackPositions = [1],
    valueArity = 2,
  }
  let right = MethodResultFact {
    iface = "right::Shared",
    method = "pick",
    returnsHead = False,
    callbackPositions = [],
    valueArity = 1,
  }
  let cp =
    CProgram [] [] [] [] [] { noDeclFacts | factMethodResults = [left, right] }
  expectAll
    (map
      (backend =>
        let plan = buildEmitPlan backend PreludeFreeRuntime cp
        expectAll [
          expectEqual
            (Some left)
            (lookupMethodResult plan.methodResults "left::Shared" "pick"),
          expectEqual
            (Some right)
            (lookupMethodResult plan.methodResults "right::Shared" "pick"),
          expectEqual
            None
            (lookupMethodResult plan.methodResults "Shared" "pick"),
          expectEqual
            None
            (lookupMethodResult plan.methodResults "left::Shared" "missing"),
        ])
      [LlvmBackend, WasmBackend])
