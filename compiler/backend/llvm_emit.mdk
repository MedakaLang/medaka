-- ── D4 emitter-completeness inventory (record-and-skip) ──────────────────────
-- A MEASUREMENT scaffold for STAGE D4 (compiler/EMITTER-GAPS.md). Strict by default:
-- every gap site below still `panic`s, exactly as
-- before, so normal emit output and all four diff_compiler_* gates stay
-- byte-identical. A D4 gaps probe emits in Record mode to COLLECT every gap
-- in one pass instead of aborting on the first: each gap is
-- recorded as "<binding>\t<reason>" and the offending construct returns a benign
-- placeholder so emission of the rest of the program proceeds.  The placeholder
-- poisons only that one sub-expression's output (which the probe discards — it
-- never compiles/links the .ll), so it surfaces ALL gaps rather than one. Gap state
-- belongs to an individual emission, never the module process.
data GapMode = Strict | Record

-- The CTFail target for a multi-clause function emitted as a CHAIN of single-clause

-- compile-time closure-arity table, keyed by the closure cell's WORD — either a
-- per-define `%tN` SSA register (the heap-alloc path, `emitClosureAllocA`) or a
-- `ptrtoint (ptr @mdk_cc_N to i64)` constant naming a module-level global (the
-- capture-free path, `emitConstClosureA` — what `emitLamGo`/`emitLamPat` now use
-- for most user lambdas, since they have no captures to force a heap cell).
-- ⚠️ `%tN` is only unique WITHIN a define (issue #118 restarts the register
-- counter at each one), so this table is PER-DEFINE: `beginDefine` clears it and
-- `endDefine` restores the enclosing define's — otherwise `%t5` in one function
-- would answer a lookup for `%t5` in another and the indirect call would
-- saturate with the WRONG arity.  That per-define clearing is what keeps the
-- SSA-register-keyed entries sound.  The constant-global-keyed entries need no
-- such protection on their own: `@mdk_cc_<scope>_N`'s `<scope>_N` comes from
-- `freshId`, which never repeats a (scope, N) pair within an emission (unlike the
-- per-define `%tN` counter, which restarts), so no two
-- closure-construction sites can ever mint the same word regardless of which
-- define reads it — the per-define clearing is redundant safety for this
-- subset, not the reason it's sound.
--   Recorded when a user lambda's closure cell is allocated
-- (emitClosureAllocA / emitConstClosureA); read at an INDIRECT call site (emitIndirect) so a
-- let-bound closure applied to MORE args than its arity (`(g 7) 9` where `g = (x => (y => …))`)
-- saturates with the first `arity` args then applies the surplus to the returned
-- closure (emitApplyAny) — mirroring emitOverApp for known fns.  Without this the
-- indirect call passed ALL args to the arity-1 lifted code → arity mismatch →
-- garbage.  A miss (closure word not a recorded key — e.g. a captured/param
-- closure) falls to emitApplyAny, which reads the closure's RUNTIME arity from the
-- cell header (field 0) and dispatches exact / partial (PAP) / over application via
-- the runtime @mdk_apply — so an opaque under-application no longer miscompiles.

-- compile-time closure RETURN-TYPE table, keyed by the closure cell's SSA register.
-- ⚠️ Same `%tN` scoping hazard as `e.closureArity` above — also PER-DEFINE.
-- Records LTFloat for a user lambda whose body EVIDENTLY returns a Float (a float
-- literal or known-float capture flows to the result through arith/if/block — see
-- bodyFloatRet, conservative).  Read at an indirect call site (indirectRetTy) so a
-- saturated call to a float-returning closure types its result LTFloat — fixing
-- `f 1.0 + f 2.0` (each `f _` result was LTInt → integer arith on boxed-float
-- pointers → garbage).  Only LTFloat is ever recorded, so non-float closures keep
-- the historical LTInt default → zero blast radius for them.

-- compile-time DIRECT-CALL table for let-group local functions, keyed by the
-- closure cell's word — the same mixed key domain as `e.closureArity` above
-- (`emitGroupBind` calls the very same `emitConstClosureA` / `emitClosureAllocA`
-- to build the cell and reuses the resulting word `w` as this table's key too),
-- so the same split applies: entries keyed by a
-- `ptrtoint (ptr @mdk_cc_<scope>_N to i64)`
-- constant can never collide, the `<scope>_N` word coming from `freshId`,
-- while entries keyed by a raw `%tN` SSA register still depend on the
-- PER-DEFINE scoping — `beginDefine` clears it, `endDefine` restores it.
-- The value is the lifted define's symbol and its arity.  An entry is written by
-- `emitGroupBind` ONLY when `satOnlyUses` has proved that, over the rest of the
-- group and its body, the bound name occurs exclusively as the head of an
-- application of exactly that arity; it is read by `emitIndirect`, which then
-- emits `call i64 @mdk_lamN(<cell>, args…)` instead of loading the cell's
-- code_ptr and calling through it.
--
-- Keying by the CELL WORD rather than the source name is what makes the
-- optimization shadow-proof: an inner binding of the same name allocates its own
-- cell, so its call sites can never resolve to an outer entry.  The cell itself is
-- still built exactly as before, so any occurrence that does NOT take this path —
-- an escaping occurrence, a partial or over-application — reads an unchanged
-- closure value.
--
-- is this CVar name the fall-through sentinel — either BARE (`__fallthrough__`, no
-- enclosing clause chain) or LABELLED by emit_support's `labelFallthrough`
-- (`__ft__<block>`, "resume at that clause's block")?
isFallthroughVar : String -> Bool
isFallthroughVar x = x == fallthroughName || startsWith ftPrefix x

-- lower the fall-through sentinel: a LABELLED one branches to the next clause's
-- block; a BARE one (single-clause fn, or a `__fallthrough__` under a CLam, which
-- labelFallthrough deliberately does not enter) has no next clause, so the guard
-- chain is non-exhaustive → @mdk_nonexhaustive_match, the same abort the interpreter
-- and the EMatch decision tree raise for an unmatched scrutinee.  `@mdk_nonexhaustive_match`
-- is not a terminator, so the caller's store+branch stays well-formed; the `br` path
-- leaves them in a dead anonymous block, which LLVM discards.
-- A sentinel labelled with `siteFtLabel` instead aborts at the site it names:
-- the guards of a function's last clause failed, and its first clause is where
-- `medaka run` reports that.
emitFallthrough : Emit -> String -> (String, LTy)
emitFallthrough e fname = match ftLabelOf fname
  Some lbl =>
    let _ =
      if startsWith "@" lbl then
        emitTrapCall
          e
          "mdk_nonexhaustive_match"
          ""
          (stringSlice 1 (stringLength lbl) lbl)
      else
        emit e ("  br label %" ++ lbl)
    ("0", LTInt)
  None =>
    let _ = emit e "  call void @mdk_nonexhaustive_match()"
    ("0", LTInt)

-- The fall-through label of a function's LAST clause: its packed first-clause
-- [site] behind an `@`, which no block label starts with, or "" (leave the
-- sentinel bare) when the site is unlocated.
siteFtLabel : Emit -> Loc -> String
siteFtLabel e site =
  let imm = siteImm e site
  if imm == "0" then "" else "@" ++ imm

-- a single-clause body whose guards fall through to its function's [site].
siteFtBody : Emit -> Loc -> CExpr -> CExpr
siteFtBody e site body = match siteFtLabel e site
  "" => body
  lbl => labelFallthrough body lbl

-- ── TRMC (tail-recursion-modulo-cons) context (PLAN #56, TRMC-DESIGN.md) ─────
-- When a top-level NON-DICT self-recursive define is `trmcEligible` — its tail
-- leaves are `head :: self-call` cons-tails (`upto`/`replicate`/`myMap`) — it is
-- emitted in destination-passing form: an O(1)-stack loop with a MUTABLE
-- destination slot (`%trmc_dest`, an `alloca ptr` holding the address of the i64
-- to fill next).  A cons leaf allocates the cell, links it into `*dest`, advances
-- `dest` to the cell's tail slot, recomputes the recursion args into the param
-- slots, and branches back to the loop head; a base leaf stores its value into
-- `*dest` and branches to the exit, which loads `%trmc_hole` (the final list head)
-- and rets.  The self-call is NEVER emitted as a `call` — only its arg
-- recomputation feeds the loop, which is what removes the stack-growing call.
--
-- The per-emission context carries the active context so the decision-tree leaf
-- (emitLeaf) and the single-clause CIf-tail descent (emitTrmcBody) both route into
-- it without threading it through every emit arm.  (The fallthrough label was once
-- carried the same way; it is now a plain emitTree parameter — issue #354.  This Ref
-- is NOT analogous: it is saved+restored around a nested match, never NULLED-then-read
-- as a jump target, so it cannot silently erase one.)
-- TrmcOff = ordinary (non-TRMC) codegen; TrmcOn self arity destSlot loopL exitL
-- paramSlots = the live context.  `self` is the SelfRef the loop recurses on (a
-- top-level CVar name, or a dispatched CMethod method+tag — Phase 2 B-dispatch);
-- destSlot is the `alloca ptr` register (the mutable destination); loopL/exitL the
-- loop-head / exit blocks; paramSlots the mutable `alloca i64` param slots the cons
-- leaf recomputes the recursion args into.
data TrmcCtx = TrmcOff | TrmcOn SelfRef Int String String String (List String)

-- ── dispatch-graph (b′) TMC context (TMC-parity arc; TRMC-DESIGN §Phase 3) ────
-- The active group context during a member-body emit: `GDispOn root members
-- uslots destSlot exitL` — root/member names (the leaf redirect recognizes
-- sanctioned tail edges), the U shared `alloca i64` param slots, the mutable
-- destination slot (the SAME local-alloca protocol as TrmcOn — dest seeded to
-- &hole, no globals), and the group define's shared exit label.  GDispOff =
-- ordinary codegen.  Mirrors `e.trmcCtx` (saved+cleared by emitDecision for an
-- expression-position match; kept LIVE across a tail-position CDecision).
data GDispCtx =
  | GDispOff
  | GDispOn String (List String) (List String) String String

-- the detected (b′) groups (shared detection, backend/trmc_analysis.mdk), the fn
-- binds they were detected over, and the fn-arity table with wasm's `progFnArity`
-- contract (clause arity; -1 when not a top-level fn — an 0-when-unknown lookup
-- would let a 0-arg call "saturate").  Computed once per emitProgram; reset (to
-- empty) by emitProgramGaps so a prior program's groups can never leak into the
-- gap-census path.

-- #990: the (fn-name -> arity) table above indexed into an OrdMap, built once beside
-- `e.gDispArs` in emitProgram.  `detectDispatchGroups` (the TMC group detection run
-- inside emitProgram) calls `gDispIsFn`/`gDispFnArity` PER referenced fn name, and each
-- `lookupAssoc` scanned the WHOLE O(fns) list — O(refs·fns) = O(N²) `emit`-stage
-- OP-COUNT on dispatch-heavy code (the residual LLVM-side emit-op quadratic #986 isolated
-- from methodArityOf, ~3.77×/doubling; #990).  The map returns the SAME first-match value
-- (`omFromPairs (reverseL …)` makes the FIRST pair win on a duplicate name, matching
-- lookupAssoc), so the TMC grouping — and therefore the emitted IR — is byte-identical.
-- RUN-EMIT-003: the second `lookupAssoc n !e.gDispArs` path is RETIRED.
-- `installDispatchState` installs this map on BOTH arms, so `None` is now a
-- broken-invariant panic, not a silent slow path that has to agree with the index.
gDispIsFn : Emit -> String -> Bool
gDispIsFn e n = match !e.gDispArMap
  Some m => omHasKey n m
  None => panic "llvm: gDispArMap read before install (internal error)"

gDispFnArity : Emit -> String -> Int
gDispFnArity e n = match !e.gDispArMap
  Some m => match omLookup n m
    Some a => a
    None => 0 - 1
  None => panic "llvm: gDispArMap read before install (internal error)"

-- is `n` a member (root included) of a detected group?
gDispIsMember : Emit -> String -> Bool
gDispIsMember e n = match dispGroupOf !e.gDispGroups n
  Some _ => True
  None => False

-- set the binding name attributed to subsequent gaps (the probe sets this per
-- top-level binding / impl entry before emitting it).
setGapBind : Emit -> String -> Unit
setGapBind e name = e.curGapBind := name

noteGap : Emit -> String -> Unit
noteGap e reason = e.gapLog := "\{!e.curGapBind}\t\{reason}" :: !e.gapLog

-- ── method-call RESULT-type inference (native backend) ──────────────────────
-- The (interface, method) -> returns-self table, computed by core_ir_lower's
-- `returnsSelfTable` and carried in EmitInput.  A method whose RESULT type mentions the
-- interface/self type variable (`map`/`ap`/`andThen`: f a -> … -> f b) returns
-- the CONTAINER; the emitter types its RKey-dispatched call result as the impl's
-- own type (`tagToLTy tag` → LTCon for List), so a downstream `++`/`::` on that
-- result picks list/string append instead of falling to the LTInt default.  This
-- closes EMITTER-GAPS #3's last residual (`ap@List` / `andThen@List`, whose `++`
-- operand is a CALL result like `map f xs` / the recursive `ap fs xs`, not a
-- param the static E2c typing could reach).
-- does interface method (iface, method) return the self/container type?
-- (False when absent — the conservative default keeps the pre-change behaviour.)
methodReturnsSelf : Emit -> String -> String -> Bool
methodReturnsSelf e iface method =
  lookupReturnsSelf iface method e.input.returnsSelf

lookupReturnsSelf : String -> String -> List ((String, String), Bool) -> Bool
lookupReturnsSelf _ _ [] = False
lookupReturnsSelf iface method (((i, m), b) :: rest)
  | i == iface && m == method = b
  | otherwise = lookupReturnsSelf iface method rest

-- ── self-returning function-PARAM typing (native backend) ───────────────────
-- The (interface, method) -> [function-param positions returning self] table,
-- from core_ir_lower's `selfFnParamTable`.  When emitting an impl method's body,
-- the params at those positions are callbacks that yield the container (e.g.
-- `andThen : m a -> (a -> m b) -> m b`, param 1 = `a -> m b`).  Before emitting a
-- group body, `e.curSelfFnParams` is set to the NAMES of those params and
-- `e.curImplTag` to the impl's type-head tag; `emitIndirect` then types the
-- APPLICATION of such a param (`f x`) as `tagToLTy e.curImplTag` instead of the
-- LTInt indirect-call default.  This closes `andThen@List`, whose `++` LEFT
-- operand `f x` is an indirect call the method-call inference can't reach.
selfFnParamPositions : Emit -> String -> String -> List Int
selfFnParamPositions e iface method =
  lookupSelfFnParams iface method e.input.selfFnParams

lookupSelfFnParams : String ->
  String ->
  List ((String, String), List Int) ->
  List Int
lookupSelfFnParams _ _ [] = []
lookupSelfFnParams iface method (((i, m), p) :: rest)
  | i == iface && m == method = p
  | otherwise = lookupSelfFnParams iface method rest

-- ── method → declared arity (native backend) ────────────────────────────────
-- The method → (interface, full-arity) table from core_ir_lower's
-- `methodIfaceTable`, keyed by BARE method name: the arity a call site of a method
-- with no identity-keyed row supplies (see `methodArityOfIface` below for the
-- identity-keyed leg, which every entry-holding site uses).
methodArityOfInput : Emit -> String -> Int
methodArityOfInput e method = match omLookup method e.input.methodIfaceIndex
  Some (_, arity) => arity
  None => 0

-- ── ARITY BY DECLARATION (#1450, #1668) ─────────────────────────────────────
-- THE ARITY LEG MOVED; THE `methodIfaceOf` ROUTE LEG DID NOT, and that asymmetry
-- is deliberate, not an oversight.  `methodArityOfInput` above is keyed by the
-- BARE method name, so two modules declaring same-spelled methods on unrelated
-- interfaces (`amod.IA.szK : a -> Int` and `zmod.IZ.szK : b -> Int -> Int`)
-- collapse to one row and whichever declaration the module graph visits last
-- silently supplies BOTH impls' emitted arity -- an under-applied define that
-- SEGFAULTS (#1450) or a saturated source call lowered as a PAP whose closure
-- POINTER is then compared as a value, at exit 0 (#1668).  The helpers below take
-- the arity from the DECLARATION identity of the interface the asking impl entry's
-- own `impl` head names, recovered from that entry's route key (which
-- `route_key.implRouteKeyWord` already mints identity-bearing).
--
-- Why the field stays bare: `CImplTagged`'s third field keeps its current bare
-- contents and its current meaning; `implEntryIface`/`methodReturnsSelf` read it
-- as a bare word, so the identity travels as an ADDITIONAL fact (the
-- `methodIfaceIdIndex` above) rather than by re-purposing the field.  A miss on the identity key falls back to the bare table, so every
-- collision-free program emits byte-identically to before.
methodArityOfIface : Emit -> String -> String -> Int
methodArityOfIface e ifaceWord method =
  match (omLookup
    (ifaceMethodArityKey ifaceWord method)
    e.input.methodIfaceIdIndex)
    Some arity => arity
    None => methodArityOfInput e method

-- the DECLARATION word of the interface an impl entry implements.  A supplied method
-- carries it as the first field of its route key; an inherited default carries it
-- directly (`CImplDefault`'s first field, the same `ifaceWordOf` word).  It is also
-- the word a `CMethod` occurrence carries for the interface it resolved to, so the
-- two compare with `==` (`narrowImplsByIface`).
implEntryIfaceWord : CImplEntry -> String
implEntryIfaceWord (CImplEntry _ _ (CImplTagged _ key _ _ _ _)) =
  ifaceWordOfKey key
implEntryIfaceWord (CImplEntry _ _ (CImplDefault ifaceWord _ _ _ _ _)) =
  ifaceWord

-- #1034: the SOURCE value arity of a TAGGED impl's method clause -- its pattern
-- count less the leading `$dict_*` witnesses dict_pass prepended.  `methodArgTys`
-- walks the method type's WHOLE arrow spine, so `act : a -> (Unit -> Unit)` reports
-- arity 2 against a source arity of 1, and the true arity is NOT recoverable from
-- the type (`a -> (Unit -> Unit)` and `a -> Unit -> Unit` are the same `Ty`).  The
-- impl clause's own `List Pat` -- the very field eval's `implMethodValue` reads to
-- build `VClosure env pats body`, which is WHY eval is right on #1034 -- carries it.
-- An inherited default's per-instance entry follows the same rule, exactly as the
-- same default does when desugar specializes it into a same-module impl.
implSrcValueArity : CImplEntry -> Int
implSrcValueArity ent =
  let pats = implPats ent
  listLen pats - leadingDictPats pats

-- #1034, THE CALL-SITE ARITY.  The declared arity is the answer EXCEPT when the
-- impl's own clause proves a SHORTER source arity; then the clause wins.  This only
-- ever LOWERS -- a clause at or beyond the declared arity, or one with no value
-- pattern at all (`act = someFn`, which carries no arity evidence), keeps the
-- declared answer byte-identically.  Lowering makes a saturated source call (`act
-- Dog`, 1 arg) classify as SATURATED instead of under-applied, so the impl body's
-- strict prefix runs where the source says it does rather than being deferred into a
-- PAP; Medaka is strict and eval already behaves this way.  A call site that passes
-- MORE than the lowered arity is an over-application against the impl's returned
-- closure, which `emitImplCallSat`/`emitKnownFnSat` already lower via `emitOverApp` --
-- the same shape an eta-expansion would hard-code into the define.
-- `gatherGroup`'s define-arity site applies the SAME rule, so define and call sites
-- keep agreeing (that agreement is #1450/#1668 and must not be broken here).
methodArityOfEntry : Emit -> CImplEntry -> String -> Int
methodArityOfEntry e ent method =
  let declared = methodArityOfIface e (implEntryIfaceWord ent) method
  let src = implSrcValueArity ent
  if src > 0 && src < declared then src else declared

-- ── constructor → DECLARED field type-head names (native backend, Gap E2) ────
-- The ctor → declared-field-type-head-name table from core_ir_lower's
-- `ctorFieldTypeNames` (e.g. `Rect Float Float` → ("Rect", ["Float","Float"])).
-- `bindFields` reads it to type a match-bound field VARIABLE from the ctor's
-- DECLARED field type rather than guessing from body-use (`paramUseTy`, which
-- defaults a Float field to LTInt → integer arith on a boxed-Float pointer-word →
-- SIGSEGV; Gap E2). Carried by the explicit EmitInput; its first-match OrdMap is
-- built once by makeEmitInput before either emit entry point begins.
-- #352: the table above has ONE ENTRY PER CONSTRUCTOR in the program, and
-- `ctorFieldTypeNamesOf` is called from `bindPattern` for EVERY constructor pattern
-- the emitter binds — so the `lookupAssoc` scan was O(patterns × ctors) = O(N²).
-- Measured on an N-ctor / N-arm `match` shape (profile_main, emit stage, prelude
-- constant subtracted): counted-op ratio r1=3.63 r2=3.80 per doubling at
-- N=250/500/1000, and `perf --call-graph dwarf` names `bindPattern → lookupAssoc`
-- as the caller. `makeEmitInput` indexes it once with `reverseL`, preserving the
-- FIRST entry on duplicate constructors exactly as `lookupAssoc` did.
-- the declared field type-head names of a constructor, or [] if unknown.
ctorFieldTypeNamesOf : Emit -> String -> List String
ctorFieldTypeNamesOf e con = match omLookup con e.input.ctorFieldIndex
  Some names => names
  None => []

-- map a declared field type-head NAME to a definite scalar LTy, or None when it
-- is not a known scalar (polymorphic / pointer-typed / "" unknown) — None ⇒ the
-- caller falls back to paramUseTy/LTInt, so the override is ADDITIVE: only
-- known-scalar fields (esp. Float/Bool) change typing.
fieldNameToLTy : String -> Option LTy
fieldNameToLTy "Float" = Some LTFloat
fieldNameToLTy "Bool" = Some LTBool
fieldNameToLTy "Int" = Some LTInt
fieldNameToLTy "Char" = Some LTChar
fieldNameToLTy "String" = Some LTStr
fieldNameToLTy "U64" = Some LTU64
fieldNameToLTy "I64" = Some LTI64
fieldNameToLTy n = if isTaggedFixedHead n then Some LTInt else None

-- ── function → DECLARED param/return type-head names (native backend, Gap E1) ─
-- The fn → (declared-param-type-head-names, declared-return-type-head-name) table
-- from core_ir_lower's `declSigTypeNames` (e.g. `double : Float -> Float` →
-- ("double", (["Float"], "Float"))).  Signature inference (`inferSigs` →
-- `inferOneSig`/`inferParamTys`) SEEDS each param/return LTy from this declared
-- type when it is a known scalar, winning over the body-use guess (`paramUseTy`,
-- which for a literal-free annotated body like `double x = x + x` finds no Float
-- anchor → LTInt → integer arith on a boxed-Float word → garbage; Gap E1).
-- Carried by EmitInput and indexed once by makeEmitInput. ADDITIVE: only known-
-- scalar declared params/returns override; an
-- unannotated fn / non-scalar declared type falls through to the existing guess.
-- The constructor's `reverseL` index makes the FIRST list entry win on a duplicate key,
-- matching the `lookupAssoc` first-match it replaces (the table is
-- `runtimeDecls ++ allDecls`, so a runtime decl shadows a same-named user decl —
-- preserving that order is load-bearing). The table is set once per emit run and
-- GROWS with the program (one entry per annotated fn), and `declSigOf` is called
-- once per binding per inference pass, so the old scan was quadratic.
-- the declared (param-type-head-names, return-type-head-name) of a function, or
-- None when it has no annotation.  Index-only: this one reads `input.declSigIndex`,
-- supplied by the caller, so it never had a scan half to fall back to.
declSigOf : Emit -> String -> Option (List String, String)
declSigOf e name = omLookup name e.input.declSigIndex

nthName : List String -> Int -> Option String
nthName (x :: _) 0 = Some x
nthName (_ :: rest) i = nthName rest (i - 1)
nthName [] _ = None

-- the impl currently being emitted: its type-head tag, and the NAMES of its
-- params that are self-returning function callbacks (set in emitGroupBody).
-- set the current-impl context for self-returning-fn-param typing; cleared after
-- the group body so a following top-level fn body isn't mis-typed.
setCurImplSelfFns : Emit -> String -> List String -> Unit
setCurImplSelfFns e tag names =
  let _ = e.curImplTag := tag in e.curSelfFnParams := names

clearCurImplSelfFns : Emit -> Unit
clearCurImplSelfFns e = let _ = e.curImplTag := "" in e.curSelfFnParams := []

-- is `name` a self-returning function param of the impl currently being emitted?
isCurSelfFnParam : Emit -> String -> Bool
isCurSelfFnParam e name = contains name !e.curSelfFnParams

-- gap helpers: when recording is on, log the reason + return a placeholder so
-- emission continues; otherwise `panic` (the unchanged normal-path behaviour).
-- One per return shape the panic sites need.
gapE : Emit -> String -> (String, LTy)
gapE e reason = match e.gapMode
  Record => let _ = noteGap e reason in ("0", LTInt)
  Strict => panic reason

gapU : Emit -> String -> Unit
gapU e reason = match e.gapMode
  Record => noteGap e reason
  Strict => panic reason

-- gap that returns the unchanged emit env (the bindPattern accumulator).
gapEnv : Emit -> String -> OrdMap (String, LTy) -> OrdMap (String, LTy)
gapEnv e reason env = match e.gapMode
  Record => let _ = noteGap e reason in env
  Strict => panic reason

-- gap that returns a placeholder operand word (an unbound dict witness).
gapStr : Emit -> String -> String
gapStr e reason = match e.gapMode
  Record => let _ = noteGap e reason in "0"
  Strict => panic reason

-- the static type of a slice-1/3 value, used to pick the print routine and the
-- int-vs-float instruction (Core IR is type-erased; for this subset the type is
-- recoverable structurally as we emit).  `LTCon` is an ADT value — a
-- boxed heap-cell pointer word; it never reaches an arithmetic/print site in the
-- supported subset (constructor values flow only as scrutinees and call args,
-- which are LTy-agnostic uniform i64 words), so it carries no payload type.
-- `LTClosure` is a first-class function value — a boxed closure cell
-- pointer word, like `LTCon`.  It flows only as a call argument and as the head of
-- an indirect call (both LTy-agnostic uniform i64 words); it never reaches an
-- arithmetic or print site in the supported subset, so it carries no payload type.
-- `LTRef` is a mutable ref cell pointer word.  Like `LTCon`/`LTClosure`,
-- it never reaches an arithmetic or print site directly — so it carries no payload.
-- `LTStr` (native extern catalog slice 1) is a heap String value — a boxed cell
-- pointer word (RUNTIME-DESIGN.md §4: UTF-8 bytes + cached codepoint count).  It
-- flows as a call argument and reaches the top-level print site (mdk_print_str);
-- it never reaches an arithmetic site, so it carries no payload type.
-- `LTUnit` (native extern catalog slice 3) is the Unit return type of IO-output
-- externs (putStr/putStrLn/ePutStr/ePutStrLn).  Its operand word is never
-- inspected — only auto-printed as "()" by emitPrint.
-- `LTUnknown` tags the result of a `++` whose operand static LTy could NOT be
-- recovered (the runtime-dispatched @mdk_append fallback below).  Its VALUE is
-- always correct (mdk_append inspects the cell header: String → string append,
-- list → list append), but its static kind is genuinely unknown — it may be a
-- String (the dominant `scanTriple`/`splitLines` string-builder case) OR a list
-- (e.g. typecheck.mdk's `freeEffvars a ++ rowFreeEffvars r ++ freeEffvars b`,
-- `List Int`).  Crucially it must NOT be treated as a guaranteed String: a
-- CHAINED `++` over an LTUnknown left operand re-routes through @mdk_append
-- (runtime dispatch) rather than a DIRECT @mdk_string_append, which would read a
-- list cell as a String header and segfault.  Everywhere a guaranteed String is
-- treated specially (print, `==`/`/=`) LTUnknown follows LTStr, because those
-- sites are only reached for the string-builder case in practice.
-- LTNum (G3): a POLYMORPHIC numeric operand — a `Num a =>`-constrained param
-- whose declared type head is a type variable, so it could be an Int OR a Float
-- at runtime.  The emitter can't pick int- vs float-instructions statically, so
-- LTNum arithmetic/print route through the runtime tag-dispatched @mdk_num_*
-- helpers (low-bit discriminator).  EVERYWHERE ELSE LTNum behaves like LTInt
-- (its word rep IS the tagged-int/boxed-float word, default-handled like a word),
-- so concrete Int/Float paths are byte-unchanged; only emitArith/emitPrint
-- special-case it.
data LTy =
  | LTInt
  | LTFloat
  | LTBool
  | LTCon
  | LTClosure
  | LTStr
  | LTUnit
  | LTChar
  | LTUnknown
  | LTNum
  -- LTFloatU: the register holds an UNBOXED `double`, not an i64 word.  Used ONLY
  -- for a let-bound float that is not captured by any lambda (so it never reaches
  -- the pure `lookupVar`/capWords path).  Every read through `lookupVarG` boxes it
  -- back to an i64 word (escape coercion); only `emitFloatLeaf` consumes it raw.
  | LTFloatU
  -- LTU64: a boxed `U64` cell word (`boxU64`).  Its own constructor rather than
  -- `LTCon` or `LTInt`, so a path keyed on the operand type (the unstamped
  -- arithmetic and comparison fallbacks, unary minus, the auto-print) can take the
  -- unsigned payload instead of an Int untag or a Float unbox.
  | LTU64
  -- LTI64: a boxed `I64` cell word (`boxI64`): U64's payload read signed, under
  -- a header of its own, so the same LTy-keyed paths order, divide and print it
  -- signed.
  | LTI64
  -- LTU64U: the register holds a `U64`'s raw 64-bit payload, not a cell word:
  -- a `let` whose value is statically `U64`, or a `U64` parameter of a raw
  -- worker (`rawWorkerOf`).  `emitU64Raw` reads it as is; every other read
  -- goes through `lookupVarG`, which boxes it (escape coercion), as LTFloatU's do.
  | LTU64U
  -- LTU32U: the register is an `i32` holding a `U32`, not a tagged word: a `let`
  -- whose value is statically `U32`, or a `U32` parameter of a raw worker
  -- (`rawWorkerOf`) or of an inlined function (`u32Inline`).  `emitU32Raw` reads
  -- it as is; `lookupVarG` retags it.
  | LTU32U
  -- LTI32U: LTU32U's `i32` holding an `I32`.  The bits are read the same way;
  -- `lookupVarG` sign-extends where LTU32U zero-extends.
  | LTI32U

-- emitter state: the per-scope fresh-name counters, the output lines (accumulated in REVERSE
-- — prepend is O(1); reverseL'd once at the end restores program order), the
-- set of known top-level FUNCTION names, so a `CApp` head can be
-- distinguished as a direct call to `@mdk_<name>` vs an unsupported higher-order
-- application, and the function SIGNATURE table (`name ->
-- (param types, return type)`), which lets a `CApp` recover the callee's return
-- type and a `define` bind each parameter at its inferred type instead of
-- assuming Int.  Both the function set and the signature table are populated
-- once, up front, in emitProgram.  The fifth ref is the CONSTRUCTOR table
-- (`name -> arity`, read out of `CProgram`): it tells a `CVar`/`CApp`
-- head apart as an ADT constructor (→ heap-cell allocation) vs a function call /
-- local variable, and supplies the arity for the alloc + field stores.  The SIXTH
-- ref is a SEPARATE output buffer for LIFTED LAMBDA definitions: a CLam
-- is lambda-lifted to its own top-level `define` (LLVM has no nested functions),
-- but it is DISCOVERED mid-body while the main buffer holds the enclosing
-- function — so its `define` is emitted into this side buffer (via a save/restore
-- swap of the main buffer) and concatenated after `@main` at module end (LLVM
-- define order is irrelevant).  The SEVENTH ref is the RECORD FIELD
-- ORDER table (`name -> [label_in_order]`, built by scanning CRecord nodes in the
-- program up front): it lets CFieldAccess recover a label's positional index so
-- the field can be reached by loadField without carrying type information.  The
-- EIGHTH ref (typeclass dispatch) is the IMPL TABLE: the program's
-- `CImplEntry` list (read out of `CProgram`).  It tells a `CMethod` site which
-- concrete impl body an `RKey`-resolved route names (→ a direct call to that
-- impl's lifted `@mdk_impl_<tag>_<method>`), and supplies the full impl set a
-- runtime `RDict`/`RDictFwd` site switches over by the dict's head tag.  The
-- NINTH ref (arg-position dispatch) is the CTOR→TYPE map (read out of
-- `CProgram`'s 3rd field): a method dispatched on its argument's runtime tag
-- (`eq`/`compare`/`show`) lowers to a bare `CVar` applied to args; the call site
-- loads the discriminating argument's constructor tag and selects the impl whose
-- TYPE owns that constructor — this map turns the loaded ctor tag into its type.
-- The TENTH ref (top-level value/`Ref` globals) is the GLOBALS
-- REGISTRY: `name -> (initialised?, LTy)`.  Each top-level non-`main` non-function
-- binding is emitted as a module global `@mdk_g_<name>` and computed once in an
-- `@main` init prologue (source order).  The registry lets `emitVar` recognise such
-- a name and lower it to a `load i64, ptr @mdk_g_<name>` referenceable from ANY
-- `define` (the gap #7 fix: a value binding referenced from a sibling function is
-- no longer an unbound local).  The `initialised?` flag is set as the prologue
-- computes each rhs in source order, so a reference to a NOT-yet-computed global
-- inside the prologue (a forward / mutual init dependency) is caught precisely
-- instead of loading an uninitialised 0; after the prologue every entry is `True`,
-- so any function body may reference any global.  MULTI-MODULE init (each module's
-- globals initialised in cross-module dependency order) is a D4 concern — NOT built
-- here; this is the single-program (`@main` + prologue) milestone.
-- All declaration-derived semantic facts required by LLVM emission.  Callers
-- construct this immutable value for each program; LLVM never reads installed
-- semantic state from a previous emission.
data EmitInputData = EmitInputData {
  returnsSelf : List ((String, String), Bool),
  selfFnParams : List ((String, String), List Int),
  methodIfaces : List (String, (String, Int)),
  methodIfaceIndex : OrdMap (String, Int),
  methodIfaceIdIndex : OrdMap Int,
  ctorFieldIndex : OrdMap (List String),
  declSigIndex : OrdMap (List String, String),
  -- #2074: the USER-declared externs only (the runtime catalog's own names are
  -- subtracted at the mint, `ir.core_ir_lower.ffiExternTypeNames`), keyed name →
  -- (declared param type-head names, declared return type-head name).  This is
  -- the ONLY table that answers "is this name a foreign call?"; `declSigIndex`
  -- cannot, because it mixes the 138 builtins and every annotated function into
  -- one flat keyspace.
  ffiExternIndex : OrdMap (List String, String),
  recordFieldOrders : List (String, List String),
  mainIsUnit : Bool,
  mainIsFloat : Bool,
  emitHalf : Int,
  preludeBinds : List String,
  -- Exact prelude impl ownership, method -> canonical impl key -> the symbol tag
  -- selected when core.mdk was lowered alone.  The program half uses the same
  -- entry both to suppress the prelude-owned define and to keep every reference
  -- to it byte-identical to the symbol that prelude.o actually exports.
  preludeImplIndex : OrdMap (OrdMap String),
  srcName : String,
  -- the method names two or more interfaces declare (by declaration word), whose
  -- dispatchers therefore carry the interface in their symbol (`dispMethodWord`)
  sharedMethodNames : OrdMap Unit,
}

-- The constructor is intentionally private: callers supply raw declaration facts
-- once, and this boundary builds the first-match indexes exactly once per emission.
export type EmitInput = EmitInputData

-- `recordFieldOrders` is LAST on purpose: every other list-shaped parameter here is
-- `List (String, List String)` too, so appending it where its neighbour is a String
-- means a mis-ordered call site is a TYPE error rather than a silently swapped table.
export
makeEmitInput : List ((String, String), Bool) ->
  List ((String, String), List Int) ->
  List (String, (String, String, Int)) ->
  List (String, List String) ->
  List (String, (List String, String)) ->
  Bool ->
  Bool ->
  Int ->
  List String ->
  List (String, String, String) ->
  String ->
  List (String, List String) ->
  List (String, (List String, String)) ->
  EmitInput
makeEmitInput returnsSelf selfFnParams methodIfaces ctorFieldTypes declSigTypes mainIsUnit mainIsFloat emitHalf preludeBinds preludeImpls srcName recordFieldOrders ffiExternTypes = EmitInputData {
  returnsSelf = returnsSelf,
  selfFnParams = selfFnParams,
  methodIfaces = map bareIfaceArityRow methodIfaces,
  methodIfaceIndex =
    omFromPairs (reverseL (map bareIfaceArityRow methodIfaces)) omEmpty,
  methodIfaceIdIndex =
    omFromPairs (reverseL (map ifaceIdArityRow methodIfaces)) omEmpty,
  ctorFieldIndex = omFromPairs (reverseL ctorFieldTypes) omEmpty,
  declSigIndex = omFromPairs (reverseL declSigTypes) omEmpty,
  ffiExternIndex = omFromPairs (reverseL ffiExternTypes) omEmpty,
  mainIsUnit = mainIsUnit,
  mainIsFloat = mainIsFloat,
  emitHalf = emitHalf,
  preludeBinds = preludeBinds,
  preludeImplIndex = preludeImplIndexOf preludeImpls omEmpty,
  srcName = srcName,
  recordFieldOrders = recordFieldOrders,
  sharedMethodNames = sharedMethodNamesOf methodIfaces omEmpty omEmpty,
}

-- The methods declared by more than one interface word, from `methodIfaceTable` rows
-- (one per declared interface method).  [firstWord] remembers each method's first
-- declaring word.
sharedMethodNamesOf : List (String, (String, String, Int)) ->
  OrdMap String ->
  OrdMap Unit ->
  OrdMap Unit
sharedMethodNamesOf [] _ shared = shared
sharedMethodNamesOf ((m, (_, word, _)) :: rest) firstWord shared =
  match omLookup m firstWord
    None => sharedMethodNamesOf rest (omInsert m word firstWord) shared
    Some w =>
      if w == word then
        sharedMethodNamesOf rest firstWord shared
      else
        sharedMethodNamesOf rest firstWord (omInsert m () shared)

preludeImplIndexOf : List (String, String, String) ->
  OrdMap (OrdMap String) ->
  OrdMap (OrdMap String)
preludeImplIndexOf [] acc = acc
preludeImplIndexOf ((method, key, symTag) :: rest) acc =
  let byKey = optionOr omEmpty (omLookup method acc)
  preludeImplIndexOf rest (omInsert method (omInsert key symTag byKey) acc)

-- #1450/#1668 -- the two PROJECTIONS of a `methodIfaceTable` row.
--   * `bareIfaceArityRow` reproduces the row this table has always carried,
--     `(method, (ifaceName, arity))`, so `methodIfaces` and `methodIfaceIndex`
--     -- and every reader of them -- keep their current bare spelling and their
--     current answers, byte for byte.
--   * `ifaceIdArityRow` is the ADDITIVE one: the same arity, re-keyed by the
--     interface's DECLARATION word.  Two modules declaring same-spelled methods
--     on unrelated interfaces occupy ONE slot in the bare index and TWO here.
bareIfaceArityRow : (String, (String, String, Int)) -> (String, (String, Int))
bareIfaceArityRow (m, (ifaceName, _, arity)) = (m, (ifaceName, arity))

ifaceIdArityRow : (String, (String, String, Int)) -> (String, Int)
ifaceIdArityRow (m, (_, ifaceWord, arity)) =
  (ifaceMethodArityKey ifaceWord m, arity)

data Emit = Emit {
  input : EmitInput,
  -- the gensym id every per-scope counter starts from (`EmitStateConfig.counter0`
  -- — 0 for the prelude half, `programHalfIdBase` for the program half).
  counter0 : Int,
  -- the scope every lifted name minted right now is attributed to, and the value
  -- the `; mdk-module` marker carries: a module id (`frontend_lexer`), an impl
  -- group's own key (`impl:List_eq`), or `program`.
  curModule : Ref String,
  -- one gensym counter PER scope, keyed by `curModule`'s word.
  counters : Ref (OrdMap Int),
  buf : Ref (List String),
  fnNames : Ref (List String),
  sigs : Ref (List (String, FnSig)),
  lams : Ref (List String),
  recFields : Ref (List (String, List String)),
  implEntries : Ref (List CImplEntry),
  globalsReg : Ref (List (String, (Bool, LTy))),
  gapMode : GapMode,
  gapLog : Ref (List String),
  curGapBind : Ref String,
  defineCounter : Ref Int,
  closureArity : Ref (List (String, Int)),
  closureRetTy : Ref (List (String, LTy)),
  directFn : Ref (List (String, (String, Int))),
  trmcCtx : Ref TrmcCtx,
  gDispCtx : Ref GDispCtx,
  -- The define whose match leaves are in function tail position (a clause chain,
  -- or a body-level match `emitFnBody` reached): a leaf that is a saturated call
  -- of it returns as `musttail call` + `ret` (`emitArmBody`).  Saved and cleared
  -- at the same places as `trmcCtx`, and read after it and `gDispCtx`.
  selfTailCtx : Ref (Option String),
  gDispGroups : Ref (List DispGroup),
  gDispBinds : Ref (List CBind),
  gDispBindMap : Ref (OrdMap CBind),
  gDispArs : Ref (List (String, Int)),
  gDispArMap : Ref (Option (OrdMap Int)),
  curImplTag : Ref String,
  curSelfFnParams : Ref (List String),
  knownFnMap : Ref (Option (OrdMap Unit)),
  lazyGlobalMap : Ref (Option (OrdMap Unit)),
  ctorMap : Ref (Option (OrdMap Int)),
  sigMap : Ref (Option (OrdMap FnSig)),
  defArityMap : Ref (Option (OrdMap Int)),
  recByName : Ref (Option (OrdMap (List String))),
  recByLabel : Ref (Option (OrdMap (String, List String))),
  implsByMethod : Ref (Option (OrdMap (List CImplEntry))),
  implMethodSet : Ref (Option (OrdMap Unit)),
  ctorTypeMap : Ref (Option (OrdMap String)),
  ctorsByType : Ref (Option (OrdMap (List String))),
  ctorOrdinalMap : Ref (Option (OrdMap Int)),
  typeIdMap : Ref (Option (OrdMap Int)),
  dispCache : Ref (List String),
  -- constant dict / closure cells already emitted, keyed by `constCellKey`
  -- (scope word + initializer text), so a cell is deduped only WITHIN the scope
  -- that minted it — see `constCellKey`.
  dictConstCache : Ref (List (String, String)),
  closConstCache : Ref (List (String, String)),
  floatFwSet : Ref (List (String, (Int, List Int))),
  floatClosureFns : Ref (List String),
  -- the functions with a raw worker (`rawWorkerOf`), by name; built once per
  -- program, since a call site can precede its callee's define.
  rawWorkers : Ref (OrdMap RawWorker),
  -- the top-level value bindings whose body is a literal, by name
  -- (`collectConstGlobals`).
  constGlobals : Ref (OrdMap Lit),
  -- how many `u32Inline` inlinings are open at the current emission point.
  inlineOpen : Ref Int,
  -- how many inlinings the current outermost inlining site has opened.
  inlineSpent : Ref Int,
  -- the trap-site file table (`siteImm`): each located file's number, and the
  -- files in reverse numbering order.
  siteFileNums : Ref (OrdMap Int),
  siteFiles : Ref (List String),
  -- the trap entries called with a site (`emitTrapCall`), in first-call order,
  -- reversed; each one's `_at` declare is emitted once.
  siteTraps : Ref (List String),
}

-- a function's inferred signature: its parameter types (in order) and its return
-- type.  At the LLVM ABI every value is a uniform i64 word regardless (Int
-- immediate, Bool immediate, Float boxed-pointer-as-i64), so a signature changes
-- NO `define`/`call` LLVM type — it only drives the static LTy bookkeeping that
-- picks int-vs-float instructions in the body and the print routine for a result.
data FnSig = FnSig (List LTy) LTy

-- an emit-time environment: source name -> (its LLVM operand, its static type).
-- A "register" is any LLVM operand text: a `%tN`, or an immediate like `5` for a
-- tagged-int constant (constants are used inline, emitting no instruction).

-- ── emitter plumbing ────────────────────────────────────────────────────────
-- TWO gensym namespaces (issue #118, "per-define deterministic numbering"):
--
--   * `freshId` — the PER-SCOPE counter (`e.counters`, keyed by the scope WORD,
--     the same string the name carries).  Feeds every name that must be unique
--     across the whole LLVM module: `@.strc.<scope>.N` string constants,
--     `@mdk_dc.<scope>.N` constant dict cells, and every lifted-define name
--     (`@mdk_lam.<scope>.N`, `@mdk_eta_<f>.<scope>.N`, `@mdk_pap_*`,
--     `@mdk_methval_*`, …).  A scope is an emitting MODULE id, an impl group's
--     own key, or `program` (`setScope*` below).  Uniqueness comes from the
--     (scope, N) PAIR, which is why every minted name carries both;
--     `mangleScoped` is the one place that spelling lives and all 20 mint sites
--     call it.  Each scope's counter starts at `e.counter0` and counts up within
--     the scope; it is never reset within one emission.
--
--     THE PARSE RULE, and why the separator is `.`: a minted name is
--     `<family>[_<subject>] "." <scope> "." <N>`.  Both `<family>_<subject>` and
--     `<scope>` contain `_` freely (`mdk_eta_core__fst`, `frontend_lexer`), so an
--     `_` separator would not be injective — `mdk_eta_a_b_c_1` could split three
--     ways.  `.` is legal in an unquoted LLVM identifier and is OUTSIDE the
--     mangled alphabet: `private_mangle.safeChar` admits only `[A-Za-z0-9_]`, so
--     neither a sanitized subject nor an `injectiveIdent` image nor a scope word
--     can contain one.  Splitting from the RIGHT at the last two `.` therefore
--     recovers (subject, scope, N) exactly, whatever the subject holds.
--
--   * `freshLocal` — the PER-DEFINE counter (`e.defineCounter`).  Feeds `%tN` SSA
--     registers (`freshReg`) and block labels (`then{N}`, `divok{N}`, `clause{N}`,
--     …).  Both are FUNCTION-scoped in LLVM, so restarting them at 0 in each
--     `define` is legal — and it is what makes a define's text depend only on that
--     define, not on how much code was emitted before it.
--
-- Reset by `beginDefine` at the top of every `define`; saved+restored by
-- `endDefine` around the side-buffer swap that emits a lifted define INSIDE
-- another define's emission (see `defineScope` below).
--
-- #2726: scoping `freshId` per module is what makes a one-module source edit a
-- one-module text edit.  With ONE never-reset counter, adding a lambda to
-- `frontend/lexer.mdk` shifted every id minted after it and renamed 2,892 of the
-- compiler's 13,922 defines; per scope, it renames one.
freshId : Emit -> Int
freshId e =
  -- keyed on the WORD, not on `!e.curModule`: the word is what the emitted name
  -- carries, so two scopes that share a word must share a counter or they would
  -- mint the same name twice.
  let k = scopeWord e
  let n = optionOr e.counter0 (omLookup k !e.counters)
  e.counters := omInsert k (n + 1) !e.counters
  n

-- The current scope as an LLVM-name-safe word.  `curModule` may hold an impl
-- group's key (`impl:List_eq`), and `:` is not in LLVM's unquoted-identifier set,
-- so the NAME form maps it to `_` while the marker keeps the readable spelling.
scopeWord : Emit -> String
scopeWord e = scopeWordOf !e.curModule

scopeWordOf : String -> String
scopeWordOf s = match stringIndexOf ":" s
  Some i => "\{stringSlice 0 i s}_\{stringSlice (i + 1) (stringLength s) s}"
  None => s

-- THE gensym spelling, in one place: the `.<scope>.<id>` tail every minted name
-- ends with (parse rule + why `.`: the `freshId` header above).
mangleScoped : Emit -> String
mangleScoped e = ".\{scopeWord e}.\{intToString (freshId e)}"

-- ── scope attribution (#2726) ───────────────────────────────────────────────
-- The module id of a top-level bind: the text before its FIRST `__`, the
-- universal per-module mangling every bind name carries
-- (`mdk_types_typecheck__foo`, `@mdk_g_frontend_parser__peekP`).  A name with no
-- `__` at all comes from a SINGLE-module emission, where the driver mangles
-- nothing and there is no module to name — those fall to `program`, which is
-- exactly the one-counter behaviour such a program had before this change.
scopeProgram : String
scopeProgram = "program"

moduleIdOf : String -> String
moduleIdOf name = match stringIndexOf "__" name
  Some 0 => scopeProgram
  Some i => stringSlice 0 i name
  None => scopeProgram

setScope : Emit -> String -> Unit
setScope e s = e.curModule := s

-- Run `act` attributed to `program` and restore the demanding scope afterwards.
-- The two callers are the demand-emitted WHOLE-PROGRAM entities — a dispatcher
-- and an interface default — each emitted once, from inside whichever module's
-- body first needs it.  Drawing their gensyms from that module's counter would
-- make one module's ids depend on another module's demand order, which is the
-- coupling #2726 exists to remove.
withProgramScope : Emit -> (Unit -> Unit) -> Unit
withProgramScope e act =
  let saved = !e.curModule
  let _ = setScope e scopeProgram
  let _ = act ()
  setScope e saved

-- attribute what follows to the module that owns `bindName`.
setScopeOfBind : Emit -> String -> Unit
setScopeOfBind e bind = setScope e (moduleIdOf bind)

-- The marker line that precedes every TOP-LEVEL entity, naming the scope its
-- gensyms were drawn from.  `;` is LLVM's line comment, so it is inert IR and a
-- pure partitioning aid for the consumer (#2727/#2752).
--
-- Column 0 is load-bearing: a consumer keys on `^; mdk-module` to find entity
-- boundaries, so a marker inside a define's body would read as a boundary that is
-- not one (#2753 review S3-9).  There are none: this is called only from
-- `beginDefine` and `emitGlobal`, both of which write at top level.
markScope : Emit -> Unit
markScope e = emit e "; mdk-module \{!e.curModule}"

freshLocal : Emit -> Int
freshLocal e =
  let n = !e.defineCounter
  e.defineCounter := n + 1
  n

freshReg : Emit -> String
freshReg e = "%t" ++ intToString (freshLocal e)

-- ── the per-define gensym scope (issue #118) ────────────────────────────────
-- Everything keyed on, or counting, a FUNCTION-SCOPED name: the `%tN`/label
-- counter plus the three tables keyed BY the closure cell's word —
-- `e.closureArity`, `e.closureRetTy` and `e.directFn` (full account: their own
-- doc comments above).  Once `%tN` restarts per define, a register name is only
-- unique WITHIN a define, so a table entry keyed by one must be scoped the same
-- way or `%t5` in one function would answer a lookup for `%t5` in another (a
-- wrong closure arity at an indirect call = silent miscompile).  Not every entry
-- needs this protection — a `ptrtoint (ptr @mdk_cc_N to i64)` constant key is
-- already globally unique (its `<scope>_N` word is minted once by `freshId`,
-- which never repeats a pair within an emission) regardless of
-- scoping — but clearing per define costs nothing on that subset and is load-
-- bearing on the `%tN`-keyed one, so all three tables are scoped uniformly.
--
-- Tail contexts contain labels and slots belonging to their own define.
data DefScope =
  | DefScope Int (List (String, Int)) (List (String, LTy)) (List (String, (String, Int))) TrmcCtx GDispCtx (Option String)

-- Start a fresh `define` scope, returning the enclosing one (for `endDefine`).
--
-- #2726: this is also the ONE place the `; mdk-module` marker is written for a
-- `define`.  Every `define` line in this file is emitted immediately after a
-- `beginDefine` call and nowhere else (25 of each), so marking here gives
-- exactly one marker per define, in the right buffer: at a side-buffer swap the
-- caller has already redirected `e.buf` before calling, so the marker lands at
-- the head of the spliced lifted define rather than in the enclosing one.
beginDefine : Emit -> DefScope
beginDefine e =
  let saved =
    DefScope
      !e.defineCounter
      !e.closureArity
      !e.closureRetTy
      !e.directFn
      !e.trmcCtx
      !e.gDispCtx
      !e.selfTailCtx
  let _ = markScope e
  e.defineCounter := 0
  e.closureArity := []
  e.closureRetTy := []
  e.directFn := []
  e.trmcCtx := TrmcOff
  e.gDispCtx := GDispOff
  e.selfTailCtx := None
  saved

-- restore the enclosing `define` scope (only needed where a define NESTS inside
-- another's emission, i.e. at each bufRef save/restore swap).
endDefine : Emit -> DefScope -> Unit
endDefine e (DefScope n ar rt df trmc gd st) =
  e.defineCounter := n
  e.closureArity := ar
  e.closureRetTy := rt
  e.directFn := df
  e.trmcCtx := trmc
  e.gDispCtx := gd
  e.selfTailCtx := st

emit : Emit -> String -> Unit
emit e line = let buf = e.buf in buf := line :: !buf

-- the main output buffer ref (needed for the save/restore swap that
-- redirects emission of a lifted lambda's `define` into the side buffer).
bufRef : Emit -> Ref (List String)
bufRef e = e.buf

-- the side buffer holding lifted-lambda `define`s, in REVERSE order (newest
-- first): each append prepends its chunk (O(chunk), amortized O(total)) instead
-- of the old O(N²) `acc ++ forward`; the consumer `reverseL`s it once at module
-- end.
lamsRef : Emit -> Ref (List String)
lamsRef e = e.lams

-- the known-function table (set once in emitProgram); membership decides whether
-- a `CApp` head names a callable top-level function.
fnNames : Emit -> List String
fnNames e = !e.fnNames

-- ── known-function index (perf) ─────────────────────────────────────────────
-- `fnNames` is set ONCE at Emit construction and never mutated (unlike `sigs`,
-- which the two-pass float propagation rewrites — that is why only THIS table,
-- not the sig table, is safely indexable). Index it into the shared `OrdMap`
-- (support.ordmap, a String-keyed weight-balanced tree → self-compiles in
-- llvm_emit's own graph) installed at emitProgram, so the per-CApp/CVar
-- `isKnownFn` membership test is O(log n) not O(fns).  `omFromPairs` inserts the
-- list REVERSED at the call sites below so the FIRST list entry wins on a
-- duplicate key (matches lookupAssoc's first-match). For CONSTANT tables only.

installKnownFnMap : Emit -> List String -> Unit
installKnownFnMap e fns = e.knownFnMap := Some (omFromNames fns omEmpty)

-- ── #561 PR-A: lazy value-global set (installed once per program) ────────────
-- The value globals emit_support.lazyGlobalNames classifies as LAZY (reaching an
-- eager dispatch or a value cycle — no static init order): their reads lower to
-- `call @mdk_force_<x>()` instead of a plain `load @mdk_g_<x>`, and each gets a
-- `@mdk_force_<x>` define + an `@mdk_gs_<x>` state flag (0 UNFORCED / 1 FORCING /
-- 2 FORCED).  Everything else stays on the byte-identical eager prologue.  Installed
-- (even empty) at EVERY emitProgram entry so a prior program's set can never leak
-- across a same-process re-emit — the same discipline as installKnownFnMap.
installLazyGlobalMap : Emit -> List String -> Unit
-- Intentional cross-file duplicate of installLazyGlobalMapW in wasm_emit.mdk (#561 PR-B); not consolidating (tiny install helper over a backend-local Ref / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
installLazyGlobalMap e names =
  e.lazyGlobalMap := Some (omFromNames names omEmpty)

export
isLazyGlobal : Emit -> String -> Bool
-- Intentional cross-file duplicate of isLazyGlobalW in wasm_emit.mdk (#561 PR-B); not consolidating (tiny query over a backend-local Ref / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
isLazyGlobal e x = match !e.lazyGlobalMap
  Some m => omHasKey x m
  None => panic "llvm: lazyGlobalMap read before install (internal error)"

-- ctor-arity table index (ct field is set once at Emit construction, constant).
installCtorMap : Emit -> List (String, Int) -> Unit
installCtorMap e t = e.ctorMap := Some (omFromPairs (reverseL t) omEmpty)

-- sig table index — the GLOBAL-`sigs` users (fnRetTy/fnArity) read the Emit's
-- `sigs` field. That field is set once at construction and never mutated
-- (constant), so a memo built from `sigTable e` is byte-identical to the old
-- `lookupAssoc name sigs.value`.
installSigMap : Emit -> List (String, FnSig) -> Unit
installSigMap e t = e.sigMap := Some (omFromPairs (reverseL t) omEmpty)

-- Index an assoc sig table for the THREADED `sigs` parameter (the pure inference
-- pass's own table, and the `sigTable e` handed to bindVarTy). `reverseL` makes
-- the FIRST list entry win on a duplicate key, exactly matching the `lookupAssoc`
-- first-match this replaces. Unlike the Ref-held indexes above this is a plain
-- VALUE threaded where the list was, so it cannot go stale or index the wrong
-- table — the two callers (nthParamTy/callRetTy) scanned a table that GROWS with
-- the program (|fns| ≈ 9.2K for the medaka_cli graph), making the old scan the
-- emitter's one measured quadratic (9.1% of runtime; see PERF-RESULTS.md).
sigsToMap : List (String, FnSig) -> OrdMap FnSig
sigsToMap t = omFromPairs (reverseL t) omEmpty

-- E22: the EMITTED define arity per top-level fn (post eta-saturate), the truth a
-- CDict call site needs to decide under-application.  Computed by replaying
-- etaSaturateMethodBody (deterministic, side-effect-free reads only) — the
-- SIGNATURE arity is NOT a safe proxy.  A CLam-returning constrained fn is
-- eta-saturated to `nDicts + sigValueArity`; a dynamic-method-tail wrapper retains
-- its dicts plus source clause params so dispatch can precede PAP construction; and
-- another non-CLam body can keep its bare clause arity.  Only the replayed arity
-- tracks the real `@mdk_<fn>` define across those shapes.
installDefArityMap : Emit -> List CBind -> Unit
installDefArityMap e binds =
  e.defArityMap := Some (omFromPairs (map (defArityPair e) binds) omEmpty)

defArityPair : Emit -> CBind -> (String, Int)
defArityPair e (CBind name [CClause pats body] _) =
  let (pats2, _) = etaSaturateMethodBody e name pats body
  (name, listLen pats2)
defArityPair e (CBind name (c :: rest) _) = (name, clauseArityC (c :: rest))
defArityPair _ (CBind name [] _) = (name, 0)

-- the recorded emitted define arity of `name` (None when the name is absent — fall
-- back to the unconditional direct call).  RUN-EMIT-003: the table is always
-- installed, so an uninstalled read is a broken invariant, not a second answer.
defArityOf : Emit -> String -> Option Int
defArityOf e name = match !e.defArityMap
  Some m => omLookup name m
  None => panic "llvm: defArityMap read before install (internal error)"

isKnownFn : Emit -> String -> Bool
isKnownFn e name = match !e.knownFnMap
  Some m => match omLookup name m
    Some _ => True
    None => False
  None => panic "llvm: knownFnMap read before install (internal error)"

-- Canonicalize a referenced function name to the actual emitted symbol.  An emit
-- driver that runs `mangleUnits` BEFORE `elaborateModules` renames every prelude
-- definition `core__<name>` while `elaborateModules` SYNTHESIZES bare references
-- afterwards — notably the `/=` rewrite (`typecheck.mdk` binopMethodApp)
-- which builds `EApp (EVar "not") …`.  Such a bare prelude name is absent from the
-- `core__`-keyed known-fn table → it falls through to a closure-load and the emitter
-- aborts `unbound variable 'not'`.  The repair: a bare name that is not a known fn
-- but whose `core__`-mangled form IS resolves to the mangled symbol.  A name already
-- known (incl. a user `core__`-collision) is returned unchanged, and a genuinely
-- unbound name still falls through to the original gap.
-- Since #2809 the emit drivers elaborate FIRST and mangle the elaborated trees, so a
-- synthesized bare reference is renamed with everything else and is a known fn by the
-- time it reaches here.  Accommodation 12 of the census in
-- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` SA-10a item 20 (`dce.canonRef`,
-- `wasm_emit.canonFn` and `wasm_reach` carry the mirrored copies); it retires with
-- that census, on a measurement of which callers still reach it.
canonFnName : Emit -> String -> String
canonFnName e name =
  if isKnownFn e name then
    name
  else
    let mangled = "core__" ++ name
    if isKnownFn e mangled then mangled else name

-- O(log n) lookup into the CONSTANT global sig table (the `e.sigMap` index built
-- from `sigTable e` at emitProgram). Byte-identical to `lookupAssoc name (sigTable
-- e)`: the map is built with `reverseL` so the FIRST list entry wins on a duplicate
-- key, matching lookupAssoc's first-match. RUN-EMIT-003: the linear-scan half is
-- retired — the map is always installed. Use for GLOBAL-sigs sites (`sigTable e`); the threaded
-- `sigs` parameter is a DIFFERENT table, not a mutated one — it is indexed too, via
-- `sigMapOf` below.  `sigs` is not "augmented" with Float-propagation types:
-- it is never consed, appended or iterated anywhere — only threaded and looked
-- up.
sigLookup : Emit -> String -> Option FnSig
sigLookup e name = match !e.sigMap
  Some m => omLookup name m
  None => panic "llvm: sigMap read before install (internal error)"

-- The GLOBAL sig table as a map, for the sites that thread `sigs` onward rather
-- than look up a single name (bindVarTy → paramUseTy). Reuses the installed
-- `e.sigMap` index.  RUN-EMIT-003: the rebuild-from-`sigTable` path is retired.
sigMapOf : Emit -> OrdMap FnSig
sigMapOf e = match !e.sigMap
  Some m => m
  None => panic "llvm: sigMap read before install (internal error)"

-- the inferred return type of a known function (Int if unknown — keeps the
-- pre-signature behaviour for any head the table somehow misses).
fnRetTy : Emit -> String -> LTy
fnRetTy e name = match sigLookup e name
  Some (FnSig _ rty) => rty
  None => LTInt

-- ── constructor table ─────────────────────────────────────────────
-- membership of the constructor arity index decides whether a `CVar`/`CApp` head
-- names an ADT constructor (→ heap allocation).  RUN-EMIT-003: the raw list form
-- (`e.ctors`) went with the retired scan; `e.ctorMap` is the only representation.
isCtor : Emit -> String -> Bool
isCtor e name = match !e.ctorMap
  Some m => match omLookup name m
    Some _ => True
    None => False
  None => panic "llvm: ctorMap read before install (internal error)"

-- ── record field-order table ─────────────────────────────────────
-- maps record-ctor-name -> [field-names-in-declaration-order].  CFieldAccess uses
-- it to convert a label name to a positional index so the field can be reached by
-- loadField without carrying type information.
--
-- #1513: the table is SEEDED FROM THE DECLARATIONS (`input.recordFieldOrders`,
-- `core_ir_lower.declaredRecordFieldOrders`), and only then extended with the
-- `collectRecords` scan of the program's CRecord nodes — first entry wins, so the
-- declaration always answers for a declared record.  The scan ALONE is silently
-- wrong whenever a record has no construction site in a position
-- the scan happens to walk: `fieldIdxByName` then falls through to `findFieldIdx` →
-- `findRecordByLabel`, which answers with the first OTHER record owning the label
-- and emits ITS index — a wrong offset at exit 0 (MEASURED: `5 99` where `5 7` is
-- correct), or a segfault when the colliding fields are differently typed.
-- Patching the scan cannot close that: the holes are a SET (a match arm's guard
-- qualifiers, `CStringSlice`'s bounds, `CLetGroup` on the wasm side …), and any arm
-- added later reopens it. The declaration is always present, is independent of DCE
-- and of which positions a scan walks, and is the same authority the `PRec`→`PCon`
-- pattern rewrite and the literal-order normalisation in `core_ir_lower` use — so
-- all four record operations agree by construction rather than by coincidence.
-- The scan is RETAINED as a fallback for records with no declaration in `prog`
-- (anonymous/synthesized shapes, and probes that pass no declaration table).
recFieldTable : Emit -> List (String, List String)
recFieldTable e = !e.recFields

-- ── record field-order INDEX (#352) ──────────────────────────────
-- The table above is CONSTANT for a program (`Ref (collectRecords groups)`, set once
-- at Emit construction), has one entry per record TYPE, and is consulted on EVERY
-- record field op — create/access/update/variant-update — two ways:
--
--   * BY NAME (`lookupAssoc recName (recFieldTable e)`, in `floatFieldRecord`,
--     `fieldIdxByName`, `recordByName`, `emitVariantUpdate`) — O(records) per op;
--   * BY LABEL (`findRecordByLabel`, the unstamped/collision fallback) — worse, a
--     `contains label labels` over EVERY record's label list until one matches.
--
-- Both are O(records) per field op ⇒ O(field-ops × records) = O(N²) on a program of
-- many record types. Measured (profile_main emit stage, prelude constant subtracted,
-- N distinct 2-field records with a create+update+2 accesses each, N=125/250/500):
-- counted-op ratio r1=3.39 r2=3.64 per doubling — quadratic.
--
-- Two maps, both built once at the single install point below:
--   `e.recByName`  recName → labels (first entry wins ⇒ `lookupAssoc` first-match)
--   `e.recByLabel` label → (recName, labels) of the FIRST record in TABLE ORDER
--                   owning that label — exactly `findRecordByLabel`'s answer. Built
--                   by folding the table in REVERSE so an earlier record overwrites
--                   a later one, which is what makes "first in table order" win.
-- RUN-EMIT-003: both readers' scan fallbacks are RETIRED.  `buildEmitState` is the
-- ONE `Emit` construction path and it always installs, so there is no probe that
-- can reach a reader with the index uninstalled.
installRecFieldIndex : Emit -> List (String, List String) -> Unit
installRecFieldIndex e t =
  e.recByName := Some (omFromPairs (reverseL t) omEmpty)
  e.recByLabel := Some (recLabelIndex (reverseL t) omEmpty)

-- fold the (already reversed) table, mapping every label of a record to that record.
-- Later inserts win, and "later" here is EARLIER in the original table.
recLabelIndex : List (String, List String) ->
  OrdMap (String, List String) ->
  OrdMap (String, List String)
recLabelIndex [] acc = acc
recLabelIndex ((name, labels) :: rest) acc =
  recLabelIndex rest (insertLabels (name, labels) labels acc)

-- (`owner`, not `rec` — `rec` is a RESERVED WORD and the parse error it produces
-- reads as an unrelated layout complaint two lines away.)
insertLabels : (String, List String) ->
  List String ->
  OrdMap (String, List String) ->
  OrdMap (String, List String)
insertLabels _ [] acc = acc
insertLabels owner (l :: rest) acc =
  insertLabels owner rest (omInsert l owner acc)

-- the record type named `recName`, index-backed (RUN-EMIT-003: no scan fallback).
recFieldsOfName : Emit -> String -> Option (List String)
recFieldsOfName e recName = match !e.recByName
  Some m => omLookup recName m
  None => panic "llvm: recByName read before install (internal error)"

-- ── impl table ────────────────────────────────────────────────────
-- the program's CImplEntry list (set once in emitProgram).  A CMethod site reads
-- it two ways: `implFor` resolves an RKey-narrowed route to the ONE concrete impl
-- it names (a direct call to that impl's lifted fn); `implsOf` returns every
-- tagged impl of a method (the runtime RDict/RDictFwd dispatch-switch arms).
implEntriesOf : Emit -> List CImplEntry
implEntriesOf e = !e.implEntries

-- ── impl INDEX by method name (perf #990 — the LLVM twin of #382/#985's wasm scan) ─
-- Every per-site dispatch scan below reads the WHOLE flat `implEntries` list and FIRST
-- filters it by the interface METHOD name: `implsOf`/`filterTagged`, and
-- `implFnSymOf`→`headTagUnique`→`distinctKeysAtHead` (the C7 collision
-- count).  The LLVM emitter resolves an RKey call site directly
-- (`emitMethod`'s `implFor` + `implFnSymOf` per site) and outlines one dispatcher per
-- method, so on dispatch-heavy code (many interfaces × many sites) each per-site scan is
-- O(impls) ⇒ O(sites·impls) = O(N²) `emit`-stage work (measured `emit` op-ratio ~3.77×/
-- doubling; #986/#990).  Grouping the entries by method name ONCE — ORIGINAL ORDER
-- preserved in each bucket — makes every one of those scans O(bucket): restricting a
-- scan that already filters by method to just that method's entries yields the IDENTICAL
-- first-match / flat-map / distinct-key result, so the emitted IR is byte-for-byte
-- unchanged (fixpoint C3a/C3b).  `installImplIndex` builds it once in
-- `buildEmitState`, the ONE `Emit` construction path shared by emitProgram and
-- emitProgramGaps.  RUN-EMIT-003: the "fall back to the full list" second path is
-- RETIRED — it was genuinely reachable (from `installDefArityMap`'s eta replay,
-- before that install was reordered to run AFTER this one), and a live second path
-- that has to agree with the index is the duality this slice removes.  Mirrors
-- wasm_emit's `implsByMethodW`.

-- the interface method an impl entry implements (field 0).
implEntryMethodOf : CImplEntry -> String
implEntryMethodOf (CImplEntry n _ _) = n

orEmptyEntries : Option (List CImplEntry) -> List CImplEntry
orEmptyEntries (Some xs) = xs
orEmptyEntries None = []

-- one LEFT fold prepending each entry to its method's bucket (O(1) per entry), then
-- `omMapValues reverseL` restores ORIGINAL order in each bucket — total O(entries).
-- (A right-append build would be O(bucket²) on a many-impl method; prepend+reverse is
-- linear, the same discipline the ctor/sig tables use.)
groupImplsByMethod : List CImplEntry -> OrdMap (List CImplEntry)
groupImplsByMethod entries =
  omMapValues reverseL (foldImplsByMethod entries omEmpty)

foldImplsByMethod : List CImplEntry ->
  OrdMap (List CImplEntry) ->
  OrdMap (List CImplEntry)
foldImplsByMethod [] m = m
foldImplsByMethod (e :: rest) m =
  let k = implEntryMethodOf e
  foldImplsByMethod rest (omInsert k (e :: orEmptyEntries (omLookup k m)) m)

installImplIndex : Emit -> List CImplEntry -> Unit
installImplIndex e entries =
  e.implsByMethod := Some (groupImplsByMethod entries)

-- [method]'s impl entries from the index (original order).  Every whole-`implEntries`
-- per-method scan routes through this — the index is the ONLY path (RUN-EMIT-003).
methodEntries : Emit -> String -> List CImplEntry
methodEntries e method = match !e.implsByMethod
  Some m => orEmptyEntries (omLookup method m)
  None => panic "llvm: implsByMethod read before install (internal error)"

-- the impls of a method, in program order: every supplied method and every
-- inherited default's per-instance entry — each is a dispatch target.
-- #126: a method's entries can carry literal duplicates (same tag, same key,
-- same iface — e.g. one impl reachable via >1 re-export path), which
-- `filterTagged` alone does not collapse; every duplicate widens the linear
-- `icmp` dispatch chain `emitDispatchChain` builds from this list. Dedup
-- mirrors `ifaceTags`'s `dedupS` (reverse, keeps-FIRST dedup, reverse — so
-- the SURVIVING occurrence is the LAST one in program order, same contract).
implsOf : Emit -> String -> List CImplEntry
implsOf e method =
  dedupImplEntries (filterTagged method (methodEntries e method))

dedupImplEntries : List CImplEntry -> List CImplEntry
dedupImplEntries xs = reverseL (dedupBy implEntryDedupKey (reverseL xs))

-- injective per #242 (`lenKey`): (tag, key, iface) is exactly the routing
-- identity a dispatch arm carries, so two entries collide here only when
-- they are genuinely the same impl.
implEntryDedupKey : CImplEntry -> String
implEntryDedupKey (CImplEntry _ _ (CImplTagged tag key iface _ _ _)) =
  lenKey tag ++ lenKey key ++ iface
implEntryDedupKey (CImplEntry _ _ (CImplDefault ifaceWord tag key _ _ _)) =
  "\{lenKey tag}\{lenKey key}default \{ifaceWord}"

filterTagged : String -> List CImplEntry -> List CImplEntry
filterTagged method entries =
  filterList (ent => implEntryMethodOf ent == method) entries

-- the candidates of the interface a `CMethod` resolved to (`""`: no interface was
-- recorded, and nothing is narrowed).  Two interfaces' same-spelled methods at one
-- head (#1265), or a same-spelled interface beside an inherited default (#1619), are
-- never candidates for one another.
narrowImplsByIface : String -> List CImplEntry -> List CImplEntry
narrowImplsByIface "" impls = impls
narrowImplsByIface iface impls =
  filterList (ent => implEntryIfaceWord ent == iface) impls

-- #1852: keep only the candidates whose OWN declared arity is the arity this
-- dispatcher was minted at.  The shared `@mdk_disp_<method>_<nmw>_<nargs>`
-- dispatcher is keyed by the BARE method name, so when two unrelated interfaces
-- declare the same-spelled method at DIFFERENT arity on the SAME receiver head
-- (`impl IA Int` with `szK : a -> Int`, `impl IZ Int` with `szK : b -> Int -> Int`)
-- both entries stamp the bare route word `"Int"` and both arms carry that same
-- disjunct.  Whichever the loader saw first then won every dispatcher regardless of
-- arity: the arity-2 dispatcher called the arity-1 impl, `inttoptr`'d its Int result
-- as a closure and applied it — a segfault on a check-green program, decided by
-- import order (#1852).
--
-- The occurrence's carried site arity is independent of the number of supplied
-- arguments.  Compare it with each entry's interface DECLARATION arity; the
-- entry's callable `methodArityOfEntry` remains the saturation ruler after the
-- tag selects that entry.  No match stays empty because the occurrence scalar is
-- authoritative and restoring the whole bare-name list would re-admit the bug.
narrowImplsByArity : Emit -> String -> List CImplEntry -> Int -> List CImplEntry
narrowImplsByArity e method impls siteArity =
  filterList
    (ent => methodArityOfIface e (implEntryIfaceWord ent) method == siteArity)
    impls

-- the single entry an RKey route names: the entry of `method` filed under the
-- route's word, which is always the selected instance's canonical key (a general
-- instance's included).  None ⇒ the route named an instance not in the program (an
-- internal error — the typechecker only stamps words it selected an instance for).
implForSite : Emit -> String -> String -> String -> Int -> Option CImplEntry
implForSite e method iface tag siteArity =
  findByTagArity
    e
    method
    tag
    siteArity
    (narrowImplsByIface iface (implsOf e method))

findByTagArity : Emit ->
  String ->
  String ->
  Int ->
  List CImplEntry ->
  Option CImplEntry
findByTagArity _ _ _ _ [] = None
findByTagArity e method tag siteArity (entry :: rest) =
  if implEntryAnswers tag entry
    && methodArityOfIface e (implEntryIfaceWord entry) method == siteArity then
    Some entry
  else
    findByTagArity e method tag siteArity rest

-- does [entry] answer to the route word [word]?  A word names exactly one instance.
implEntryAnswers : String -> CImplEntry -> Bool
implEntryAnswers word entry = implEntryKey entry == word

-- the lifted LLVM name of an inherited default's per-instance body:
-- `mdk_default_<iface>_<method>_<instance key>`.  It is keyed by the interface that
-- declared the default AND the instance that inherits it, so two interfaces' defaults
-- for one method spelling at one type (#1265) are two symbols, and no two instances
-- share one.  The interface word and key carry `::`/`|`/spaces, which
-- `injectiveIdent` (the ONE shared encoding since #1950) maps injectively into an
-- LLVM identifier.
defaultFnName : String -> String -> String -> String
defaultFnName ifaceWord method key =
  "\{defaultFnPrefix}\{injectiveIdent ifaceWord}_\{method}_\{injectiveIdent key}"

defaultFnPrefix : String
defaultFnPrefix = "mdk_default_"

-- the lifted LLVM name of a tagged impl method: `mdk_impl_<symTag>_<method>`.
-- [symTag] is already a legal identifier (`implFnSymTag` spells it through
-- `injectiveIdent`), and method names are alphanumeric identifiers (an operator
-- like `+` is a `CBinPrim`, never a method name here), so the concatenation is a
-- legal LLVM symbol — clang would reject it loudly otherwise, which the gate catches.
implFnName : String -> String -> String
implFnName tag method = "mdk_impl_\{tag}_\{method}"

-- TYPECHECK-AUDIT C7 (native backend): the SYMBOL tag a same-head-tycon impl is
-- emitted/dispatched under.  Two impls of one method that share a head tycon but
-- differ in type args (`Def (MyPair Int Bool)` vs `Def (MyPair Bool Int)`) must NOT
-- collide on `mdk_impl_<head>_<method>` — they need distinct bodies.  When the head
-- `tag` is the SOLE impl of `(method, head)` (the common case) → the head tag
-- through `injectiveIdent`: a prelude or builtin head is an identifier and maps to
-- itself, a module-qualified head (`app.T`, `route_key.typeTagOf`) is escaped, so
-- two modules' same-named types never share a symbol (#1397).  On a
-- collision → the INJECTIVELY encoded canonical full-type `key`, byte-distinct per
-- impl.  #1950: this used to be a lossy `[^A-Za-z0-9_] → _` collapse, under which
-- two keys differing ONLY in those positions landed on one symbol.
-- `wasm_emit.implFnSymTagW` and `core_ir_lower.implSymTagOf` call the SAME
-- `injectiveIdent`, so both backends and the guard agree on the emitted symbol.
-- The typechecker stamps the SAME canonical key into the RKey route (keyForSite),
-- so emitMethod's `implFnSymE` and emitGroup's name agree.
implFnSymTag : List CImplEntry -> String -> String -> String -> String
implFnSymTag entries method tag key =
  if headTagUnique entries method tag then
    injectiveIdent tag
  else
    injectiveIdent key

-- The exact impl symbols exported by a standalone prelude object.  A later
-- program can add a same-(method, head) impl, changing the whole-program C7
-- collision answer; retaining this standalone choice is what keeps references
-- to the already-compiled object linkable.  Both indexes use injective newline
-- keys and are built once in O(entries log entries), rather than rescanning the
-- impl list for every row.
export
-- [ownImpls] is the prelude's own declared-impl table (`core_ir_lower.
-- ifaceImplHeadTable`): an inherited default's entry is prelude code only for a
-- PRELUDE instance -- the table lowered alone still lists the program's instances
-- as inheritors of a prelude interface's default, and those entries are the
-- program's to define.
preludeImplSymbols : List (String, String, String, String) ->
  List CImplEntry ->
  List (String, String, String)
preludeImplSymbols ownImpls entries =
  let collisions = preludeImplCollisions entries omEmpty omEmpty
  let own = omFromNames (map (row => implHeadRowKey row) ownImpls) omEmpty
  preludeImplSymbolsGo own entries collisions omEmpty

implHeadRowKey : (String, String, String, String) -> String
implHeadRowKey (_, _, _, key) = key

preludeImplCollisions : List CImplEntry ->
  OrdMap String ->
  OrdMap Unit ->
  OrdMap Unit
preludeImplCollisions [] _ collisions = collisions
preludeImplCollisions ((CImplEntry method _ (CImplTagged tag key _ _ _ _)) :: rest) firstKeys collisions =
  let headKey = preludeImplPairKey method tag
  match omLookup headKey firstKeys
    None =>
      preludeImplCollisions rest (omInsert headKey key firstKeys) collisions
    Some firstKey => preludeImplCollisions rest firstKeys (if firstKey
      == key then
      collisions
    else
      omInsert headKey () collisions)
preludeImplCollisions (_ :: rest) firstKeys collisions =
  preludeImplCollisions rest firstKeys collisions

preludeImplSymbolsGo : OrdMap Unit ->
  List CImplEntry ->
  OrdMap Unit ->
  OrdMap Unit ->
  List (String, String, String)
preludeImplSymbolsGo _ [] _ _ = []
preludeImplSymbolsGo own ((CImplEntry method _ (CImplTagged tag key _ _ _ _)) :: rest) collisions seen =
  let implKey = preludeImplPairKey method key
  if omHasKey implKey seen then
    preludeImplSymbolsGo own rest collisions seen
  else
    let symTag =
      if omHasKey (preludeImplPairKey method tag) collisions then
        injectiveIdent key
      else
        tag
    (method, key, symTag)
      :: preludeImplSymbolsGo own rest collisions (omInsert implKey () seen)
-- an inherited default's entry is named by its interface and instance key, never by
-- a symbol tag, so the tag it records is only its head
preludeImplSymbolsGo own ((CImplEntry method _ (CImplDefault _ tag key _ _ _)) :: rest) collisions seen =
  let implKey = preludeImplPairKey method key
  if omHasKey implKey seen || not (omHasKey key own) then
    preludeImplSymbolsGo own rest collisions seen
  else
    (method, key, tag)
      :: preludeImplSymbolsGo own rest collisions (omInsert implKey () seen)

preludeImplPairKey : String -> String -> String
preludeImplPairKey method identity = "\{method}\n\{identity}"

-- does the head tycon [tag] of [method] have a single impl, or several distinct
-- ones (C7 collision)?  Count DISTINCT canonical keys at this head — NOT raw
-- entries: the joint prelude+module entry list duplicates each prelude impl, and a
-- multi-clause impl contributes several entries that share ONE key.  A genuine
-- collision is ≥2 DIFFERENT keys at the same (method, head).
headTagUnique : List CImplEntry -> String -> String -> Bool
headTagUnique entries method tag =
  lengthS (distinctKeysAtHead entries entries method tag []) <= 1

distinctKeysAtHead : List CImplEntry ->
  List CImplEntry ->
  String ->
  String ->
  List String ->
  List String
distinctKeysAtHead _ [] _ _ acc = acc
distinctKeysAtHead full (ent :: rest) method tag acc
  | implEntryMethodOf ent == method
    && implEntryTag ent == tag
    && not (contains (implEntryKey ent) acc) =
    distinctKeysAtHead full rest method tag (implEntryKey ent :: acc)
  | otherwise = distinctKeysAtHead full rest method tag acc

-- The call-site symbol for an exact impl entry.  The C7 collision count
-- (`headTagUnique`→`distinctKeysAtHead`) only accumulates entries whose method ==
-- [method], so passing [method]'s bucket is the whole-program answer in O(bucket).
-- In the program half, an exact prelude-owned row instead retains the standalone
-- symbol recorded when prelude.o was compiled.
implFnSymE : Emit -> String -> CImplEntry -> String
implFnSymE e method ent =
  implFnSymForKey
    e
    (methodEntries e method)
    method
    (implEntryTag ent)
    (implEntryKey ent)

-- the lifted define an entry's calls target: `mdk_impl_<symTag>_<method>` for a
-- supplied method, `defaultFnName` for an inherited default's per-instance body.
implEntryFnName : Emit -> String -> CImplEntry -> String
implEntryFnName e method (ent@(CImplEntry _ _ (CImplTagged _ _ _ _ _ _))) =
  implFnName (implFnSymE e method ent) method
implEntryFnName _ method (CImplEntry _ _ (CImplDefault ifaceWord _ key _ _ _)) =
  defaultFnName ifaceWord method key

implFnSymForKey : Emit ->
  List CImplEntry ->
  String ->
  String ->
  String ->
  String
implFnSymForKey e entries method tag key = match preludeImplSym e method key
  Some symTag => symTag
  None => implFnSymTag entries method tag key

preludeImplSym : Emit -> String -> String -> Option String
preludeImplSym e method key = match omLookup method e.input.preludeImplIndex
  Some byKey => omLookup key byKey
  None => None

-- the method names of the program's tagged impls.  A bare CVar naming one of these,
-- applied to args, is an arg-position dispatch site (return-position methods are
-- CMethod nodes, never a bare applied CVar — so this set is exactly the
-- arg-dispatched methods at a call site).  `installImplMethodSet` dedups it into
-- `e.implMethodSet`; RUN-EMIT-003 retired the `dedupS`-rebuilding list form.
taggedMethodNames : List CImplEntry -> List String
taggedMethodNames entries = map implEntryMethodOf entries

-- #990: the tagged-impl method NAMES as an OrdMap membership set, built once in
-- emitProgram.  `isImplMethod` (emitVar/emitApp, PER bare-CVar / saturated-app site)
-- called `contains name (implMethodNames e)`, which REBUILT the O(N) `dedupS` (itself
-- O(N²)) on every call — O(sites · N²) on dispatch-heavy code.  `omFromNames` dedups
-- via map insertion (O(N log N)); membership is then O(log N) and the deduped rebuild
-- is gone.  Same set as `contains … (dedupS (taggedMethodNames …))`, so byte-identical.
-- RUN-EMIT-003: the list-scan second path is RETIRED — the set is installed on the
-- one `Emit` construction path, so `None` is a broken invariant.
installImplMethodSet : Emit -> List CImplEntry -> Unit
installImplMethodSet e entries =
  e.implMethodSet := Some (omFromNames (taggedMethodNames entries) omEmpty)

isImplMethod : Emit -> String -> Bool
isImplMethod e name = match !e.implMethodSet
  Some m => omHasKey name m
  None => panic "llvm: implMethodSet read before install (internal error)"

-- the parameter patterns + body of an impl entry (CImplTagged or CImplDefault).
implPats : CImplEntry -> List Pat
implPats (CImplEntry _ _ (CImplTagged _ _ _ _ pats _)) = pats
implPats (CImplEntry _ _ (CImplDefault _ _ _ _ pats _)) = pats

implBody : CImplEntry -> CExpr
implBody (CImplEntry _ _ (CImplTagged _ _ _ _ _ body)) = body
implBody (CImplEntry _ _ (CImplDefault _ _ _ _ _ body)) = body

implEntryPositions : CImplEntry -> List Int
implEntryPositions (CImplEntry _ _ (CImplTagged _ _ _ positions _ _)) =
  positions
implEntryPositions (CImplEntry _ _ (CImplDefault _ _ _ positions _ _)) =
  positions

-- #747: is this a nullary/return-position/no-requires impl — the exact shape
-- core_ir_lower.memoKeys treats as a per-instance CAF (positions == [] && pats == [],
-- mirroring eval's memoThunk gate)?  A dispatch arm for such an impl, reached with no
-- method-level or value args, is memoised via its `$memo_<symTag>_<method>` CAF.
implEntryMemoisable : CImplEntry -> Bool
implEntryMemoisable ent =
  isEmptyL (implEntryPositions ent) && isEmptyL (implPats ent)

implEntryTag : CImplEntry -> String
implEntryTag (CImplEntry _ _ (CImplTagged tag _ _ _ _ _)) = tag
implEntryTag (CImplEntry _ _ (CImplDefault _ tag _ _ _ _)) = tag

-- the canonical full-type key the entry's instance is filed under
implEntryKey : CImplEntry -> String
implEntryKey (CImplEntry _ _ (CImplTagged _ key _ _ _ _)) = key
implEntryKey (CImplEntry _ _ (CImplDefault _ _ key _ _ _)) = key

-- ── ctor→type map ─────────────────────────────────────────────────
-- the program's constructor→type-name map (CProgram's 3rd field).  An arg-tag
-- dispatch loads the discriminating argument's constructor tag at run time; this
-- map names the constructors each candidate TYPE owns, so the dispatch chain can
-- test "is the loaded ctor tag one of type T's constructors?" by OR-ing the
-- hashName of each.  RUN-EMIT-003: the raw list form (`e.ctorTypes`) went with the
-- retired scan; the indices below are the only representation.

-- #990: the ctor→type table indexed into an OrdMap, built once in emitProgram.  `cellTag`
-- (the composite ctor tag, run on EVERY ctor alloc AND every ctor tag-test) computes
-- `ctorTypeId × shift + ctorOrdinal`, and BOTH did `lookupAssoc name (ctorTypeTable e)`
-- over the WHOLE O(types) list; `ctorHasSiblings` (refutable-let, per PCon) does the same.
-- On dispatch-heavy code — many single-ctor data types, one per interface — that is
-- O(ctors·types) = O(N²) `emit`-stage OP-COUNT (this is the residual LLVM emit-op
-- quadratic #986 measured INDEPENDENT of methodArityOf; #990).  The map returns the SAME
-- first-match (`omFromPairs (reverseL …)` = first pair wins on a duplicate ctor name,
-- matching lookupAssoc), so the composite tag — and the emitted IR — is byte-identical.
-- Uninstalled (None) it FALLS BACK to the list scan, identical answer either way.

-- #352: the THREE derived views of the SAME constant ctor→type table that #990 left
-- as whole-table scans, all built at this one install point (so none can go stale):
--
--   * `e.ctorsByType`   type → its constructors IN TABLE ORDER.  Replaces
--     `ctorsOfTypeIn`, which filtered the WHOLE table on every call — and its
--     callers run per ctor site (`ctorOrdinal` via `cellTag`), per refutable-let
--     PCon (`ctorHasSiblings`) and per dispatch arm (`emitTagMatch`).
--   * `e.ctorOrdinalMap` ctor → its 0-based index within its type's ctor list.
--     Replaces `indexOfStr name (ctorsOfType e ty)`, which is O(that type's ctors)
--     AND allocates an `Option` per step (`map (+ 1)` recursion) — so on an N-ctor
--     type this was O(N²) in TIME **and** in ALLOCATION.
--   * `e.typeIdMap`      type → its dense id (index among `distinctTypeNames`).
--     Replaces `indexOfStr ty (distinctTypeNames e)`, O(types) per ctor site.
--
-- ORDER IS LOAD-BEARING and is preserved, not assumed: the buckets are built by a
-- left fold that PREPENDS then `omMapValues reverseL`s (the `groupImplsByMethod`
-- discipline), so each bucket is exactly `ctorsOfTypeIn`'s filtered order — which
-- `emitTagMatch` renders as an OR-chain of `hashName`s, so any reorder would move
-- emitted IR.  Ordinals/type-ids are read off those ordered lists and installed with
-- `omFromPairs (reverseL …)` so the FIRST occurrence wins, exactly matching the
-- `indexOfStr`/`ctorTypeOf` first-match they replace (a ctor name owned by two types
-- keeps the first type's ordinal).  Uninstalled (None) every reader falls back to the
-- original scan, so a probe that never calls emitProgram is unaffected.
--
-- Measured (profile_main emit stage, prelude constant subtracted, N=250/500/1000):
-- the N-distinct-single-ctor-type shape read op r1=2.61 r2=2.93 before.
installCtorTypeMap : Emit -> List (String, String) -> Unit
installCtorTypeMap e t =
  let byType = groupCtorsByType t
  let tys = nubStr (typeNamesOf t)
  e.ctorsByType := Some byType
  e.ctorOrdinalMap :=
    Some (omFromPairs (reverseL (ctorOrdinalPairs byType tys)) omEmpty)
  e.typeIdMap := Some (omFromPairs (reverseL (numberFrom 0 tys)) omEmpty)
  e.ctorTypeMap := Some (omFromPairs (reverseL t) omEmpty)

-- one LEFT fold prepending each ctor to its type's bucket (O(1) per entry), then
-- `omMapValues reverseL` restores TABLE order in each bucket — total O(entries).
groupCtorsByType : List (String, String) -> OrdMap (List String)
groupCtorsByType t = omMapValues reverseL (foldCtorsByType t omEmpty)

foldCtorsByType : List (String, String) ->
  OrdMap (List String) ->
  OrdMap (List String)
foldCtorsByType [] acc = acc
foldCtorsByType ((c, ty) :: rest) acc =
  foldCtorsByType rest (omInsert ty (c :: optionOr [] (omLookup ty acc)) acc)

-- (ctor, ordinal) for every ctor of every type, types visited in first-appearance
-- order and each bucket numbered from 0 — so `omFromPairs (reverseL …)` keeps the
-- first occurrence, matching `indexOfStr name (ctorsOfType e ty)`.
ctorOrdinalPairs : OrdMap (List String) -> List String -> List (String, Int)
ctorOrdinalPairs _ [] = []
ctorOrdinalPairs byType (ty :: rest) =
  numberFrom 0 (optionOr [] (omLookup ty byType))
    ++ ctorOrdinalPairs byType rest

numberFrom : Int -> List String -> List (String, Int)
numberFrom _ [] = []
numberFrom i (x :: rest) = (x, i) :: numberFrom (i + 1) rest

-- the type name owning constructor [name], index-backed (RUN-EMIT-003: no scan path).
ctorTypeOf : Emit -> String -> Option String
ctorTypeOf e name = match !e.ctorTypeMap
  Some m => omLookup name m
  None => panic "llvm: ctorTypeMap read before install (internal error)"

-- ── globals registry ────────────────────────────────────────────
-- the top-level value/`Ref` globals registry ref: `name -> (initialised?, LTy)`.
-- `emitVar` consults it (via lookupVarG) to lower a value-binding reference to a
-- `load i64, ptr @mdk_g_<name>`; the `@main` init prologue computes each rhs in
-- source order and flips its flag, so a forward/mutual init dependency is caught.
globalsRegRef : Emit -> Ref (List (String, (Bool, LTy)))
globalsRegRef e = e.globalsReg

-- mark a global initialised, recording the static type its rhs computed to.  Drops
-- any prior (uninitialised) entry for the name and prepends the resolved one.
markGlobalInit : Emit -> String -> LTy -> Unit
markGlobalInit e name ty =
  let gr = globalsRegRef e
  gr := (name, (True, ty)) :: dropAssoc name !gr

-- drop the first entry keyed `k` from an assoc list (keeps the rest in order).
dropAssoc : String -> List (String, (Bool, LTy)) -> List (String, (Bool, LTy))
dropAssoc _ [] = []
dropAssoc k ((n, v) :: rest) =
  if n == k then rest else (n, v) :: dropAssoc k rest

-- the constructor names owned by a type, in program order.  The runtime ADTs
-- (List/Option/Result/Ordering) carry RESERVED built-in constructors that are not
-- user-declared, so they are absent from the ctor→type table (`ctorTypeTable`); an
-- arg-tag dispatch over such a type (e.g. an UNANNOTATED `fold`/`Foldable List`
-- caller whose route stays RNone — `total xs = fold (+) 0 xs`) would otherwise see
-- an empty ctor list and hit the "owns no constructors" gap.  Fall back to the
-- reserved ctors so the tag-match discriminates on the built-in cell tags.
-- #352: index-backed (a bucket is non-empty by construction, so an ABSENT type is
-- exactly the old empty-filter case → the reserved fallback).  RUN-EMIT-003: the
-- full-table-filter second path is RETIRED; the reserved-ctor arm below is a
-- SEMANTIC fallback for a type absent from the table, not an uninstalled-index one.
ctorsOfType : Emit -> String -> List String
ctorsOfType e ty = match !e.ctorsByType
  Some m => match omLookup ty m
    Some cs => cs
    None => reservedCtorsOfType ty
  None => panic "llvm: ctorsByType read before install (internal error)"

-- the reserved built-in constructors of a runtime ADT, mirroring `reservedTag`'s
-- ordinal layout (List = Cons|Nil, Option = Some|None, Result = Ok|Err,
-- Ordering = Lt|Eq|Gt).  Empty for any other (user) type.
reservedCtorsOfType : String -> List String
reservedCtorsOfType "List" = ["Cons", "Nil"]
reservedCtorsOfType "Option" = ["Some", "None"]
reservedCtorsOfType "Result" = ["Ok", "Err"]
reservedCtorsOfType "Ordering" = ["Lt", "Eq", "Gt"]
reservedCtorsOfType _ = []

-- ── tag / box helpers (the value-representation, made concrete) ──────────────
-- untag an immediate int word -> raw i64 (arithmetic shift, preserves sign).
untagInt : Emit -> String -> String
untagInt e v =
  let r = freshReg e
  let _ = emit e "  \{r} = ashr i64 \{v}, 1"
  r

-- tag a raw i64 -> immediate int word ((x << 1) | 1).
tagInt : Emit -> String -> String
tagInt e v =
  let s = freshReg e
  let _ = emit e "  \{s} = shl i64 \{v}, 1"
  let r = freshReg e
  let _ = emit e "  \{r} = or i64 \{s}, 1"
  r

-- Normalise a float lexeme so it always contains a decimal point in the mantissa,
-- which LLVM requires to distinguish a floating-point constant from an integer.
-- Examples: "1e-05" → "1.0e-05", "1e+12" → "1.0e+12", "100" → "100.0".
-- Lexemes that already contain "." are returned unchanged.
-- Special values "nan", "inf", "-inf" are returned unchanged (adding ".0" would
-- corrupt them — LLVM accepts these bare).
ensureFloatDot : String -> String
ensureFloatDot s =
  if startsWith "nan" s || startsWith "inf" s || startsWith "-inf" s then
    s
  else match stringIndexOf "." s
    Some _ => s
    None => match stringIndexOf "e" s
      Some i =>
        "\{stringSlice 0 i s}.0e\{stringSlice (i + 1) (stringLength s) s}"
      None => match stringIndexOf "E" s
        Some i =>
          "\{stringSlice 0 i s}.0E\{stringSlice (i + 1) (stringLength s) s}"
        None => s ++ ".0"

-- box a double -> a heap cell {i64 header, double}; word = pointer-as-i64.
-- The cell is POINTER-FREE (tag + raw double), so allocate it atomic — Boehm
-- never scans its 8 payload bytes for pointers during mark (sound; no false
-- retention from float bit patterns).
boxFloat : Emit -> String -> String
boxFloat e d =
  let p = freshReg e
  let _ = emit e ("  " ++ p ++ " = call ptr @mdk_alloc_atomic(i64 16)")
  let _ = emit e ("  store i64 2, ptr " ++ p)
  let dp = freshReg e
  let _ = emit e "  \{dp} = getelementptr i8, ptr \{p}, i64 8"
  let _ = emit e "  store double \{d}, ptr \{dp}"
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  w

-- The header of a boxed `U64` cell, `{ i64 header, i64 payload }` in Float's cell
-- shape: reserved type-id 5 (`reservedTypeBase` below), which no constructor tag
-- reaches.  runtime/medaka_rt.c spells the same word as MDK_U64_TAG and pins it to
-- `MDK_TAG(5, 0)` with a _Static_assert.
u64CellTag : Int
u64CellTag = (reservedTypeBase + 5) * ctorTagShift

-- The header of a boxed `I64` cell: U64's shape and payload under reserved
-- type-id 6.  runtime/medaka_rt.c spells the same word as MDK_I64_TAG and pins
-- it to `MDK_TAG(6, 0)`.
i64CellTag : Int
i64CellTag = (reservedTypeBase + 6) * ctorTagShift

-- box a raw 64-bit payload -> a U64 cell word.  Pointer-free, as boxFloat's is.
boxU64 : Emit -> String -> String
boxU64 e x = boxCell64 e u64CellTag x

-- box a raw 64-bit payload -> an I64 cell word.
boxI64 : Emit -> String -> String
boxI64 e x = boxCell64 e i64CellTag x

-- box a 64-bit payload under the U64 or I64 header, as `signed` says.
boxW64 : Emit -> Bool -> String -> String
boxW64 e signed x = if signed then boxI64 e x else boxU64 e x

-- the LTy of a U64 or I64 cell word.
w64LTy : Bool -> LTy
w64LTy signed = if signed then LTI64 else LTU64

boxCell64 : Emit -> Int -> String -> String
boxCell64 e tag x =
  let p = freshReg e
  let _ = emit e "  \{p} = call ptr @mdk_alloc_atomic(i64 16)"
  let _ = emit e "  store i64 \{intToString tag}, ptr \{p}"
  let xp = freshReg e
  let _ = emit e "  \{xp} = getelementptr i8, ptr \{p}, i64 8"
  let _ = emit e "  store i64 \{x}, ptr \{xp}"
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  w

-- unbox a U64 or I64 cell word -> its raw 64-bit payload.
unboxU64 : Emit -> String -> String
unboxU64 e v =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{v} to ptr"
  let xp = freshReg e
  let _ = emit e "  \{xp} = getelementptr i8, ptr \{p}, i64 8"
  let x = freshReg e
  let _ = emit e "  \{x} = load i64, ptr \{xp}"
  x

-- unbox a float word -> the stored double.
unboxFloat : Emit -> String -> String
unboxFloat e v =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{v} to ptr"
  let dp = freshReg e
  let _ = emit e "  \{dp} = getelementptr i8, ptr \{p}, i64 8"
  let d = freshReg e
  let _ = emit e "  \{d} = load double, ptr \{dp}"
  d

-- ── expressions ─────────────────────────────────────────────────────────────
emitExpr : Emit -> OrdMap (String, LTy) -> CExpr -> (String, LTy)
emitExpr e _ (CLit l) = emitLit e l
emitExpr e env (CVar x _) = emitVar e env x
emitExpr e env (CBinPrim op l r tag site) = emitBin e env op l r tag site
emitExpr e env (CUnOp op x) = emitUn e env op x
emitExpr e env (CIf c t f) = emitIf e env c t f
emitExpr e env (CLet recF pat e1 e2) = emitLet e env recF pat e1 e2
emitExpr e env (CLetGroup binds body) = emitLetGroup e env binds body
emitExpr e env (CBlock stmts) = emitBlock e env stmts
emitExpr e env (CApp f a) = emitApp e env (CApp f a)
emitExpr e env (CLam pats body) = emitLam e env pats body
emitExpr e env (CDecision scrut arms tree) = emitDecision e env scrut arms tree
emitExpr e env (CTuple es) = emitTuple e env es
emitExpr e env (CRecord name fields) = emitRecordCreate e env name fields
emitExpr e env (CFieldAccess ex label recName) =
  emitFieldAccess e env ex label recName
emitExpr e env (CRecordUpdate name base updates) =
  emitRecordUpdate e env name base updates
emitExpr e env (CVariantUpdate con base updates) =
  emitVariantUpdate e env con base updates
emitExpr e env (CMethod name iface arity route implRoutes methRoutes) =
  emitMethodValue e env name iface arity route implRoutes methRoutes
emitExpr e env (CDict name routes) = emitDictValue e env name routes
emitExpr e env (CArray es) = emitArrayCreate e env es
emitExpr e env (CRangeArray lo hi incl) = emitRangeArray e env lo hi incl
emitExpr e env (CIndex a i) = emitArrayIndex e env a i
emitExpr e env (CSlice a lo hi incl) = emitArraySlice e env a lo hi incl
emitExpr e env (CStringIndex a i) = emitStringIndex e env a i
emitExpr e env (CStringSlice a lo hi incl) = emitStringSlice e env a lo hi incl
emitExpr e env (CListIndex a i) = emitListIndex e env a i
emitExpr e env (CListSlice a lo hi incl) = emitListSlice e env a lo hi incl
emitExpr e env (CList es) = emitList e env es
emitExpr e env (CRangeList lo hi incl) = emitRangeList e env lo hi incl
emitExpr e _ other = gapE e ("unsupported Core IR node " ++ ctag other)

-- a variable occurrence: a bare constructor name is a NULLARY ADT value
-- → allocate its heap cell; a bare KNOWN top-level FUNCTION name used as a VALUE
-- (not the head of a saturated call) must become a closure, so eta-wrap
-- it into a captureless static closure forwarding to `@mdk_<name>`; anything else
-- is a let/param-bound local operand.
--
-- The math/bound constants (`pi`/`e`/`intMaxBound`/…) are ordinary PRELUDE
-- bindings, so a LOCAL of the same name must shadow them — check the local env
-- FIRST for those.  (`True`/`False`/`otherwise` and constructors are reserved
-- value keywords a local can never rebind, so they stay ahead of the env check.)
-- This matters for real code: the self-hosted lexer uses `e` as a parameter name
-- pervasively (`let e = identEnd …`); intercepting it as Euler's number wrecked
-- every `substr … e` call (B1 bootstrap bug).
emitVar : Emit -> OrdMap (String, LTy) -> String -> (String, LTy)
emitVar e env x =
  if x == "True" then
    ("3", LTBool)
  else if x == "False" then
    ("1", LTBool)
  else if x == "otherwise" then
    ("3", LTBool)
  else if isLocal env x then
    lookupVarG e env x
  else if x == "pi" then
    (boxFloat e "3.141592653589793", LTFloat)
  else if x == "e" then
    (boxFloat e "2.718281828459045", LTFloat)
  else if x == "intMaxBound" then
    ("9223372036854775807", LTInt)
  else if x == "intMinBound" then
    ("-9223372036854775807", LTInt)
  else if x == "charMinBound" then
    ("1", LTChar)
  else if x == "charMaxBound" then
    ("2228223", LTChar)
  else if isCtor e x then
    if ctorArity e x == 0 then emitCtorAlloc e x [] else emitCtorEtaClosure e x
  else if isKnownFn e x then
    emitEtaClosure e x
  else if isKnownFn e (canonFnName e x) then
    emitEtaClosure e (canonFnName e x)
  else if isAnyExtern x then
    emitExternEtaClosure e x
  else if isFfiExtern e x then
    emitFfiEtaClosure e x
  else if isImplMethod e x then
    emitMethodEtaClosure e x
  else
    lookupVarG e env x

-- is `x` a local (let/param) binding in the current emit env?  Used to let a local
-- shadow the prelude math/bound constants (pi/e/intMaxBound/…) above.
isLocal : OrdMap (String, LTy) -> String -> Bool
isLocal env x = match omLookup x env
  Some _ => True
  None => False

-- a Mut-aware variable lookup used at the emit site (emitVar): a local (let/param)
-- operand shadows everything, so the env is checked FIRST; otherwise the name may
-- be a top-level value/`Ref` global → emit a `load i64, ptr @mdk_g_<x>`
-- (referenceable from any `define`).  A global that the source-order init prologue
-- has NOT yet computed (a forward/mutual init dependency) records a precise gap
-- rather than loading an uninitialised 0.  When gap-recording is on, a genuinely
-- unbound variable records a gap and returns a placeholder instead of aborting (the
-- dict/internal callers keep the pure `lookupVar` panic).
lookupVarG : Emit -> OrdMap (String, LTy) -> String -> (String, LTy)
lookupVarG e env x = match omLookup x env
  Some (reg, LTFloatU) => (boxFloat e reg, LTFloat)
  Some (reg, LTU64U) => (boxU64 e reg, LTU64)
  Some (reg, LTU32U) => (tagU32 e reg, LTInt)
  Some (reg, LTI32U) => (tagI32 e reg, LTInt)
  Some vt => vt
  -- #561 PR-A: a LAZY value global (dispatch-reaching or cyclic) is forced on first
  -- use — its read is `call @mdk_force_<x>()`, which memoises into @mdk_g_<x> and
  -- black-holes a re-entrant force into E-CYCLIC-VALUE.  A LOCAL of the same name
  -- still shadows (the env is checked first, above).
  --
  -- ⚠️ The returned LTy `LTInt` is a PLACEHOLDER, not a type claim: the forced word is a
  -- uniform i64 (Int immediate / Bool immediate / boxed-Float-ptr-as-i64), and this call
  -- site does not carry the global's real static type.  That is SOUND because no
  -- type-sensitive consumer trusts THIS LTy — each recovers the real type from its OWN
  -- typecheck-stamped tag: a Float arithmetic/print op from the CBinPrim/scalar tag
  -- (scalarTagIsFloat), a bare value-main's print from main's inferred `mty`, a Bool
  -- `if`/print from the scrutinee/return type.  Verified: LAZY Bool/Float/String globals
  -- all print & compute == eval (fixtures eager_global_lazy_{bool,float,string}).  If a
  -- future consumer WERE to key off this returned LTy, those fixtures would fail the gate.
  None =>
    if isLazyGlobal e x then
      let r = freshReg e
      let _ = emit e "  \{r} = call i64 @mdk_force_\{x}()"
      (r, LTInt)
    else match lookupAssoc x (globalsRegRef e).value
      Some (True, ty) =>
        let r = freshReg e
        let _ = emit e "  \{r} = load i64, ptr @mdk_g_\{x}"
        (r, ty)
      Some (False, _) =>
        let r = freshReg e
        let _ = emit e "  \{r} = load i64, ptr @mdk_g_\{x}"
        (r, LTInt)
      None =>
        gapE
          e
          ("unbound variable '" ++ x ++ "' (not a local, ctor, or known fn)")
-- A not-yet-initialised global is still loaded from its `@mdk_g_<name>` cell:
-- the `load` resolves at the instruction's RUNTIME, not emit time.  Two cases
-- reach here, both correct as a deferred load.  (1) A reference INSIDE A LAMBDA
-- body emitted during an enclosing global's init (`stmtsCons`'s continuation
-- closes over `stmtsLoop`, defined later): the closure runs only at parse time,
-- long after every global is initialised, so the load sees the real value — a
-- gap-`0` here would bake a permanent null into the closure and crash.  (2) An
-- eager same-init forward ref: orderedValBinds topologically sorts eager
-- dependencies, so a surviving eager forward ref is either a genuine value cycle
-- or an edge the sort MISSED, and the cell still holds 0.
-- ⚠️ This comment used to claim such refs are cycles that "none arise in
-- practice" and that reading 0 "is exactly the interpreter's recursive-value
-- semantics".  BOTH HALVES ARE FALSE (#553; corrected 2026-07-17).  `x = x + 1`
-- is a two-line counterexample: the interpreter BLACK-HOLES and raises
-- E-CYCLIC-VALUE (exit 1), while native silently prints 1 at exit 0 — so the
-- zero is a DEVIATION from eval, not a shared semantics.  Since #553 Stage B the
-- sort DOES follow calls (`eagerReachMap`, emit_support.mdk, over `CVar`+`CDict`
-- callees), so a surviving forward ref here is now either a genuine value cycle
-- (`x = x + 1`) or a global reached through interface-method DISPATCH (a `CMethod`
-- head Stage B does not resolve to impl bodies) — the two residual deviations, both
-- landing here as a silent 0 for an unboxed Int / SIGSEGV for a boxed value.  See
-- compiler/EMITTER-GAPS.md "NATIVE-EAGER-INIT" for the law and the divergence table;
-- #561 removes the approximation by making these bindings actually lazy.  Either way
-- the cell exists (declared `@mdk_g_<name> = global i64 0` up front), so emit
-- the load.  LTy is unknown until init computes it; default LTInt (the loaded
-- word is a uniform i64 — a downstream container op re-derives its shape).

emitLit : Emit -> Lit -> (String, LTy)
-- Tag boundary: n*2+1 overflows the emitter's own 63-bit Medaka Int when |n| >= 2^61.
-- For those literals, emit 64-bit shl+or instructions so tagging is done at full
-- i64 width by LLVM rather than in Medaka arithmetic (which would wrap).
-- tagSafeMax = 2^61 - 1 = 2305843009213693951: largest n where n*2+1 stays in range.
emitLit e (LInt n) =
  let tagSafeMax = 2305843009213693951
  if n >= -tagSafeMax - 1 && n <= tagSafeMax then
    (intToString (n * 2 + 1), LTInt)
  else
    (tagInt e (intToString n), LTInt)
emitLit _ (LBool b) = (if b then "3" else "1", LTBool)
-- a `U64` literal: its whole cell as a private module-scope constant, as a String
-- literal's is, so evaluating it allocates nothing.  A U64 cell is never written
-- after it is built, so one shared constant is sound, and Boehm ignores a pointer
-- outside its heap.  `u0x` is LLVM's unsigned hex integer syntax, which carries
-- the value above 2^63 that the emitter's own 63-bit `Int` cannot.
emitLit e (LU64 hi lo) = (emitCell64Lit e ".u64c" u64CellTag hi lo, LTU64)
-- an `I64` literal: the same constant cell under the I64 header, the halves
-- being its two's complement pattern.
emitLit e (LI64 hi lo) = (emitCell64Lit e ".i64c" i64CellTag hi lo, LTI64)
emitLit e (LFloat f) =
  let w = boxFloat e (ensureFloatDot (floatToString f))
  (w, LTFloat)
-- a String literal (native extern catalog slice 1): emit the ENTIRE boxed String
-- cell — header, byte_len, cached cp_count and the NUL-terminated UTF-8 bytes — as
-- a single private module-scope compile-time constant global, and yield
-- `ptrtoint (ptr @.strc.<id> to i64)`.  Nothing runs at run time: no @mdk_str_lit
-- call, no alloc, no memcpy (RUNTIME-DESIGN.md §4 gives the cell layout).  Bytes
-- are escaped one-per-`\HH` so the LLVM `c"…"` constant is byte-faithful.
emitLit e (LString s) =
  let bytes = strBytes s
  let n = lengthS bytes
  let cpc = arrayLength (stringToChars s)
  let gid = ".strc" ++ mangleScoped e
  let _ =
    emitGlobal
      e
      "@\{gid} = private unnamed_addr constant { i64, i64, i64, [\{intToString (n + 1)} x i8] } { i64 1, i64 \{intToString n}, i64 \{intToString cpc}, [\{intToString (n + 1)} x i8] c\"\{escBytes bytes}\\00\" }"
  ("ptrtoint (ptr @" ++ gid ++ " to i64)", LTStr)
emitLit _ (LChar c) =
  let cp = charCode (arrayGetUnsafe 0 (stringToChars c))
  (intToString (cp * 2 + 1), LTChar)
emitLit _ LUnit = ("1", LTUnit)
emitLit e _ = gapE e "non-Int/Float/Bool/String/Char/Unit literal"

-- a 64-bit cell constant under header `tag`, as a word.
emitCell64Lit : Emit -> String -> Int -> Int -> Int -> String
emitCell64Lit e prefix tag hi lo =
  let gid = prefix ++ mangleScoped e
  let _ =
    emitGlobal
      e
      "@\{gid} = private unnamed_addr constant { i64, i64 } { i64 \{intToString tag}, i64 u0x\{u64HalvesHex hi lo} }"
  "ptrtoint (ptr @" ++ gid ++ " to i64)"

-- ── string literals + string externs (native extern catalog slice 1) ─────────
-- emit a module-scope line (a private string-literal global) into the side buffer
-- the lifted-lambda defines also use — LLVM module-item order is irrelevant, so a
-- `@.str.N = … constant …` appended after @main is sound (same discipline as the
-- lifted `define`s).
-- #2726: `lams` is reversed on the way out, so consing the marker AFTER the line
-- puts it BEFORE the line in the emitted text.
emitGlobal : Emit -> String -> Unit
emitGlobal e line =
  lamsRef e := line :: "; mdk-module \{!e.curModule}" :: (lamsRef e).value

-- the raw UTF-8 bytes of a string literal, in order.  `stringToChars` yields the
-- source codepoints; `utf8Bytes` re-encodes each to its UTF-8 byte sequence, so the
-- emitted global is byte-faithful to the source whatever the codepoints' width.
strBytes : String -> List Int
strBytes s = strBytesGo (stringToChars s) 0

strBytesGo : Array Char -> Int -> List Int
strBytesGo cs i
  | i >= arrayLength cs = []
  | otherwise =
    utf8Bytes (charCode (arrayGetUnsafe i cs)) ++ strBytesGo cs (i + 1)

-- encode one Unicode codepoint to its UTF-8 bytes (0..255).  The bit fields are
-- disjoint, so `or` is `+` and the masks are `% 64`; no bitwise primitive needed.
utf8Bytes : Int -> List Int
utf8Bytes cp
  | cp < 128 = [cp]
  | cp < 2048 = [192 + cp / 64, 128 + cp % 64]
  | cp < 65536 = [224 + cp / 4096, 128 + cp / 64 % 64, 128 + cp % 64]
  | otherwise = [
    240 + cp / 262144,
    128 + cp / 4096 % 64,
    128 + cp / 64 % 64,
    128 + cp % 64,
  ]

-- escape a byte list for an LLVM `c"…"` constant: EVERY byte as `\HH` (uppercase
-- hex).  Always valid (no quoting edge cases) and exact — the constant's declared
-- length is the byte count, and every source byte contributes exactly one `\HH`
-- escape to the constant, so declared length and emitted bytes cannot drift.
-- (Both callers are `emitGlobal` compile-time constants; nothing copies at run
-- time.)
escBytes : List Int -> String
escBytes [] = ""
escBytes (b :: rest) = "\\\{hex2 b}\{escBytes rest}"

hex2 : Int -> String
hex2 b = hexDigit (b / 16) ++ hexDigit (b % 16)

-- Uppercase `A`-`F`, matching LLVM's own textual convention for `\HH` string
-- escapes.  The WAT emitter's `hexDigitW` (backend/wasm_emit.mdk) is the same
-- function over lowercase and stays separate on purpose: both grammars accept
-- either case and assemble to identical bytes, but `wasm-tools print`
-- normalizes escapes to lowercase, so only lowercase keeps emitted WAT equal to
-- its own round-trip.  One shared case would therefore have to be lowercase,
-- which would rewrite every `\HH` escape in the emitted LLVM IR text for no
-- semantic gain.
hexDigit : Int -> String
hexDigit d
  | d < 10 = intToString d
  | d == 10 = "A"
  | d == 11 = "B"
  | d == 12 = "C"
  | d == 13 = "D"
  | d == 14 = "E"
  | otherwise = "F"

-- the string-returning leaf externs the spike lowers to direct C-ABI calls
-- (RUNTIME-DESIGN.md §5 LEAF).  `intToString` is the first: it proves the §2a
-- contract that an extern returning a Medaka value allocates it in the GC heap
-- (mdk_int_to_string -> mdk_str_lit -> mdk_alloc).  charToStr/stringConcat/putStr
-- are the obvious next additions (a follow-on slice).
isStrExtern : String -> Bool
isStrExtern name = contains name ["intToString", "stringConcat", "stringLength"]

emitStrExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitStrExtern e env "intToString" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_int_to_string(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: intToString takes exactly one argument"
emitStrExtern e env "stringConcat" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_concat(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: stringConcat takes one argument"
emitStrExtern e env "stringLength" args = match emitArgs e env args
  [a] =>
    let p = freshReg e
    let _ = emit e "  \{p} = inttoptr i64 \{a} to ptr"
    let cpp = freshReg e
    let _ = emit e "  \{cpp} = getelementptr i8, ptr \{p}, i64 16"
    let n = freshReg e
    let _ = emit e "  \{n} = load i64, ptr \{cpp}"
    (tagInt e n, LTInt)
  _ => panic "llvm: stringLength takes one argument"
-- INTRINSIC: load cp_count@16, tag it

emitStrExtern e _ name _ = gapE e ("unsupported string extern " ++ name)

-- numeric conversion externs (native extern catalog slice 2).
-- intToFloat / floatToInt are INTRINSIC: inline sitofp / fptosi + box/untag.
-- floatToString is a LEAF: delegates to mdk_float_to_string (mirrors mdk_print_float's
-- %.12g+dot logic but returns a mdk_str_lit box instead of printf-ing).
isNumExtern : String -> Bool
isNumExtern name =
  contains name [
      "intToFloat",
      "floatToInt",
      "floatToString",
      "intBitsToFloat",
      "bytesToFloat64",
      "floatRem",
      "floatToBytes64",
    ]
    || isMathUnary name
    || isMathBinary name

-- libm one-arg Float -> Float externs (native/LLVM only).  Each emits a
-- direct `call double @mdk_<name>(double x)`, unbox in / rebox out.
isMathUnary : String -> Bool
isMathUnary name = contains name [
  "sqrt",
  "cbrt",
  "exp",
  "log",
  "log2",
  "log10",
  "sin",
  "cos",
  "tan",
  "asin",
  "acos",
  "atan",
  "sinh",
  "cosh",
  "tanh",
  "floor",
  "ceil",
  "round",
  "trunc",
]

-- libm two-arg Float -> Float -> Float externs (native/LLVM only).
isMathBinary : String -> Bool
isMathBinary name = contains name ["pow", "atan2", "hypot"]

emitNumExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitNumExtern e env "intToFloat" args = match emitArgs e env args
  [a] =>
    let i = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = sitofp i64 \{i} to double"
    (boxFloat e r, LTFloat)
  _ => panic "llvm: intToFloat takes exactly one argument"
-- #346 (S0): floatToInt SATURATES — NaN -> 0, +inf/over -> intMaxBound,
-- -inf/under -> intMinBound.  A raw `fptosi` on an out-of-range/NaN double is
-- LLVM POISON, and on x86 it did not merely return a wrong number: the poison
-- register was read back as a LIVE POINTER, so `println (floatToInt 1.0e19)`
-- printed an ASLR-randomized address (stable under `setarch -R`, different every
-- run with ASLR on) — an address-disclosure primitive reachable from safe,
-- non-`internal` surface.  `llvm.fptosi.sat` makes the conversion total.
--
-- The clamp is NOT redundant: fptosi.sat saturates to *i64* bounds (+-2^63), but
-- Medaka's Int is the 63-bit payload of the tagged word (RUNTIME-DESIGN §8), so
-- its domain is [-2^62, 2^62-1].  Saturating to i64 and then tagging would shift
-- INT64_MAX/MIN straight out the top and decode to -1/0 — so we must clamp to the
-- Int bounds BEFORE tagInt.  Those literals are the UNTAGGED bounds; the tagged
-- words emitVar uses for `intMaxBound`/`intMinBound` are these << 1 | 1.
-- icmp+select (not llvm.smin/smax) keeps the preamble to a single new declare.
emitNumExtern e env "floatToInt" args = match emitArgs e env args
  [a] =>
    let d = unboxFloat e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @llvm.fptosi.sat.i64.f64(double \{d})"
    let hi = freshReg e
    let _ = emit e "  \{hi} = icmp sgt i64 \{r}, 4611686018427387903"
    let rhi = freshReg e
    let _ =
      emit e "  \{rhi} = select i1 \{hi}, i64 4611686018427387903, i64 \{r}"
    let lo = freshReg e
    let _ = emit e "  \{lo} = icmp slt i64 \{rhi}, -4611686018427387904"
    let rlo = freshReg e
    let _ =
      emit e "  \{rlo} = select i1 \{lo}, i64 -4611686018427387904, i64 \{rhi}"
    (tagInt e rlo, LTInt)
  _ => panic "llvm: floatToInt takes exactly one argument"
emitNumExtern e env "floatToString" args = match emitArgs e env args
  [a] =>
    let d = unboxFloat e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_float_to_string(double \{d})"
    (r, LTStr)
  _ => panic "llvm: floatToString takes exactly one argument"
emitNumExtern e env "intBitsToFloat" args = match emitArgs e env args
  [a] =>
    let i = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_int_bits_to_float(i64 \{i})"
    (r, LTFloat)
  _ => panic "llvm: intBitsToFloat takes one argument"
emitNumExtern e env "bytesToFloat64" args = match emitArgs e env args
  [arr, off] =>
    let oi = untagInt e off
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_bytes_to_float64(i64 \{arr}, i64 \{oi})"
    (r, LTFloat)
  _ => panic "llvm: bytesToFloat64 takes two arguments"
-- floatToBytes64 d — encode a Float as 8 big-endian IEEE 754 bytes → Array Int.
-- The Float is unboxed to `double` then passed to mdk_float_to_bytes64; the result
-- is a freshly-allocated Array cell (LTCon, a heap-pointer word).
emitNumExtern e env "floatToBytes64" args = match emitArgs e env args
  [a] =>
    let d = unboxFloat e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_float_to_bytes64(double \{d})"
    (r, LTCon)
  _ => panic "llvm: floatToBytes64 takes one argument"
-- floatRem a b = fmod(a, b); both operands unbox to double, result reboxes.
-- Same value as the inline `frem` the `Float % Float` operator emits.
emitNumExtern e env "floatRem" args = match emitArgs e env args
  [a, b] =>
    let da = unboxFloat e a
    let db = unboxFloat e b
    let r = freshReg e
    let _ =
      emit e "  \{r} = call double @mdk_float_rem(double \{da}, double \{db})"
    (boxFloat e r, LTFloat)
  _ => panic "llvm: floatRem takes two arguments"
-- libm one-arg math externs: unbox one double, call mdk_<name>, rebox.
emitNumExtern e env name args
  | isMathUnary name = match emitArgs e env args
    [a] =>
      let d = unboxFloat e a
      let r = freshReg e
      let _ = emit e "  \{r} = call double @mdk_\{name}(double \{d})"
      (boxFloat e r, LTFloat)
    _ => panic "llvm: unary math extern takes one argument"
-- libm two-arg math externs: unbox two doubles, call mdk_<name>, rebox.
emitNumExtern e env name args
  | isMathBinary name = match emitArgs e env args
    [a, b] =>
      let da = unboxFloat e a
      let db = unboxFloat e b
      let r = freshReg e
      let _ =
        emit e "  \{r} = call double @mdk_\{name}(double \{da}, double \{db})"
      (boxFloat e r, LTFloat)
    _ => panic "llvm: binary math extern takes two arguments"
emitNumExtern e _ name _ = gapE e ("unsupported numeric extern " ++ name)

-- IO-output externs (native extern catalog slice 3).
-- putStr/putStrLn write to stdout; ePutStr/ePutStrLn write to stderr.
-- All return Unit (LTUnit); the operand "1" is an arbitrary immediate never read.
isIoExtern : String -> Bool
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
isIoExtern name = contains name [
  "putStr",
  "putStrLn",
  "ePutStr",
  "ePutStrLn",
  "flushStdout",
  "stashRunStdout",
  "enableRunStdoutFlush",
  "byteBlockWriteStdout",
]

emitIoExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitIoExtern e env "putStr" args = match emitArgs e env args
  [s] =>
    let _ = emit e ("  call void @mdk_putstr(i64 " ++ s ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: putStr takes exactly one argument"
emitIoExtern e env "putStrLn" args = match emitArgs e env args
  [s] =>
    let _ = emit e ("  call void @mdk_putstrln(i64 " ++ s ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: putStrLn takes exactly one argument"
emitIoExtern e env "ePutStr" args = match emitArgs e env args
  [s] =>
    let _ = emit e ("  call void @mdk_eputstr(i64 " ++ s ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: ePutStr takes exactly one argument"
emitIoExtern e env "ePutStrLn" args = match emitArgs e env args
  [s] =>
    let _ = emit e ("  call void @mdk_eputstrln(i64 " ++ s ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: ePutStrLn takes exactly one argument"
emitIoExtern e env "flushStdout" args = match emitArgs e env args
  [u] =>
    let _ = emit e ("  call void @mdk_flushstdout(i64 " ++ u ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: flushStdout takes exactly one argument"
-- "run drops stdout on panic" fix: stashRunStdout snapshots the interpreter's
-- currently-buffered stdout (a pointer+length store; no allocation) so an
-- abort can flush it; enableRunStdoutFlush arms that flush.  See
-- runtime/medaka_rt.c's mdk_flush_run_stdout_on_abort and eval.mdk's
-- appendOutput/evalModulesOutputRun.
emitIoExtern e env "stashRunStdout" args = match emitArgs e env args
  [s] =>
    let _ = emit e ("  call void @mdk_stash_run_stdout(i64 " ++ s ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: stashRunStdout takes exactly one argument"
emitIoExtern e env "enableRunStdoutFlush" args = match emitArgs e env args
  [u] =>
    let _ = emit e ("  call void @mdk_enable_run_stdout_flush(i64 " ++ u ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: enableRunStdoutFlush takes exactly one argument"
-- Writes a ByteBlock's raw bytes to stdout byte-for-byte, no encoding
-- assumption; unlike putStr/putStrLn, the argument is a block register, not a
-- string register.
emitIoExtern e env "byteBlockWriteStdout" args = match emitArgs e env args
  [bb] =>
    let _ = emit e ("  call void @mdk_byteblock_write_stdout(i64 " ++ bb ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: byteBlockWriteStdout takes exactly one argument"
emitIoExtern e _ name _ = gapE e ("unsupported IO extern " ++ name)

-- abort externs (native extern catalog slice 4).
-- panic/exit terminate the process; the call itself never returns, so the
-- auto-print emitted downstream is dead code.  Return ("1", LTUnit) so
-- emitPrint sees LTUnit (safe) rather than LTCon/LTClosure (compile panic).
isAbortExtern : String -> Bool
isAbortExtern name = contains name [
  "panic",
  "exit",
  "indexError",
  "indexErrorAt",
  "sliceError",
  "panicAt",
  "indexErrorAtSite",
]

emitAbortExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
-- panicAt (site, msg): `panic msg` reporting the packed site.  The lowering
-- passes a trap-site literal, which is packed here straight to the immediate.
emitAbortExtern e env "panicAt" [site, msg] = match emitArgs e env [msg]
  [m] =>
    let raw = match siteLiteralLoc site
      Some l => siteImm e l
      None => untagInt e (fst (emitExpr e env site))
    let _ = emitTrapCall e "mdk_panic" "i64 \{m}" raw
    ("1", LTUnit)
  _ => panic "llvm: emitAbortExtern: panicAt takes a site and a message"
emitAbortExtern e env name args = match emitArgs e env args
  [a] =>
    if name == "indexError" then
      -- indexError carries its message into the coded E-INDEX-OOB abort
      -- (@mdk_oob_msg), which prints "runtime error [E-INDEX-OOB]: <msg>" --
      -- the same line the interpreter has always printed.  `a` is a tagged
      -- string pointer passed through unchanged, as in the panic/exit branch
      -- below; only the int-carrying arms untag.
      let _ = emit e "  call void @mdk_oob_msg(i64 \{a})"
      ("1", LTUnit)
    else if name == "indexErrorAt" then
      -- indexErrorAt carries the offending index into the abort (@mdk_oob_at),
      -- which formats it -- so a built binary prints the same "index N out of
      -- bounds" text `run` does without the caller interpolating a string on a
      -- path whose inline budget cannot afford one (#1787).  The arg is a RAW
      -- i64 there, as in sliceError.
      let idx_raw = untagInt e a
      let _ = emit e "  call void @mdk_oob_at(i64 \{idx_raw})"
      ("1", LTUnit)
    else
      let cname = if name == "panic" then "panic" else "exit"
      let _ = emit e "  call void @mdk_\{cname}(i64 \{a})"
      ("1", LTUnit)
  [a, b] =>
    if name == "sliceError" then
      -- sliceError (lo, hiIncl) reuses the existing coded E-SLICE-OOB abort
      -- (@mdk_slice_oob), which prints `slice [lo..hiIncl] out of bounds`.  Both
      -- args are RAW i64s there, so untag the tagged-Int operands first.
      let lo_raw = untagInt e a
      let hi_raw = untagInt e b
      let _ = emit e "  call void @mdk_slice_oob(i64 \{lo_raw}, i64 \{hi_raw})"
      ("1", LTUnit)
    else if name == "indexErrorAtSite" then
      -- indexErrorAtSite (site, idx): indexErrorAt idx reporting the caller's
      -- packed site, which an `Index` impl's twin receives as a parameter.
      let idx_raw = untagInt e b
      let _ = emitTrapCall e "mdk_oob_at" "i64 \{idx_raw}" (untagInt e a)
      ("1", LTUnit)
    else
      panic ("llvm: emitAbortExtern: " ++ name ++ " takes two arguments")
  _ => panic ("llvm: emitAbortExtern: " ++ name ++ " bad arity")

-- array intrinsics (native extern catalog slice 6).
-- pure-inline: no C helper; all three reuse loadTag/loadFieldDyn/storeFieldDyn.
-- arrayLength: header word = raw element count; tag it as a Medaka Int.
-- arrayGetUnsafe: CIndex path minus bounds-check.
-- arraySetUnsafe: store to element slot; returns Unit.
isArrIntrinsic : String -> Bool
isArrIntrinsic name =
  contains name ["arrayLength", "arrayGetUnsafe", "arraySetUnsafe"]

emitArrIntrinsic : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitArrIntrinsic e env "arrayLength" args = match emitArgs e env args
  [arr] => (tagInt e (loadTag e arr), LTInt)
  _ => panic "llvm: arrayLength takes one argument"
emitArrIntrinsic e env "arrayGetUnsafe" args = match emitArgs e env args
  [i, arr] =>
    let idx_raw = untagInt e i
    (loadFieldDyn e arr idx_raw, LTInt)
  _ => panic "llvm: arrayGetUnsafe takes two arguments"
emitArrIntrinsic e env "arraySetUnsafe" args = match emitArgs e env args
  [i, x, arr] =>
    let idx_raw = untagInt e i
    let _ = storeFieldDyn e arr idx_raw x
    ("1", LTUnit)
  _ => panic "llvm: arraySetUnsafe takes three arguments"
emitArrIntrinsic e _ name _ = gapE e ("unsupported array intrinsic " ++ name)

-- array leaf externs (native extern catalog slice 7).
-- C helpers in runtime/medaka_rt.c; array cell = [i64 count | elem@8 | ...].
-- arrayMake/arrayCopy/arrayFromList return Array (LTCon); arrayBlit/arrayFill return Unit.
-- Do NOT end a fixture with an array-returning call: emitPrint LTCon panics.
-- Project to scalar via .[i] (CIndex) in every fixture.
isArrLeafExtern : String -> Bool
isArrLeafExtern name = contains name [
  "arrayMake", "arrayCopy", "arrayBlit", "arrayFill", "arrayFromList"
]

emitArrLeafExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitArrLeafExtern e env "arrayMake" args = match emitArgs e env args
  [n, x] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_array_make(i64 \{n}, i64 \{x})"
    (r, LTCon)
  _ => panic "llvm: arrayMake takes two arguments"
emitArrLeafExtern e env "arrayCopy" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_array_copy(i64 \{a})"
    (r, LTCon)
  _ => panic "llvm: arrayCopy takes one argument"
emitArrLeafExtern e env "arrayFromList" args = match emitArgs e env args
  [l] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_array_from_list(i64 \{l})"
    (r, LTCon)
  _ => panic "llvm: arrayFromList takes one argument"
emitArrLeafExtern e env "arrayBlit" args = match emitArgs e env args
  [src, so, dst, dof, len] =>
    let _ =
      emit
        e
        "  call void @mdk_array_blit(i64 \{src}, i64 \{so}, i64 \{dst}, i64 \{dof}, i64 \{len})"
    ("1", LTUnit)
  _ => panic "llvm: arrayBlit takes five arguments"
emitArrLeafExtern e env "arrayFill" args = match emitArgs e env args
  [x, arr] =>
    let _ = emit e "  call void @mdk_array_fill(i64 \{x}, i64 \{arr})"
    ("1", LTUnit)
  _ => panic "llvm: arrayFill takes two arguments"
emitArrLeafExtern e _ name _ = gapE e ("unsupported array leaf extern " ++ name)

-- byte-block leaf externs (the `ByteBlock` builtin).
-- C helpers in runtime/medaka_rt.c; byte-block cell = [i64 tag | i64 count |
-- count bytes].  Unlike the array cell there is a header word, so `length` is a
-- C call rather than the `loadTag` intrinsic `arrayLength` uses.
-- byteBlockMake/CopyUnsafe/FromIntArray/ToIntArray/FromString return a cell
-- (LTCon); ToString returns a String cell (LTStr, so it is printable);
-- Length/GetUnsafe return Int; SetUnsafe and Blit return Unit.
-- Do NOT end a fixture with a block-returning call: emitPrint LTCon panics.
-- Project to scalar via byteBlockGetUnsafe / byteBlockLength in every fixture.
isByteBlockExtern : String -> Bool
-- Deliberately a per-backend copy of wasm_emit.mdk's `isByteBlockExternW`, not a
-- shared list.  test/diff_compiler_capability_matrix.sh derives each engine's
-- implemented-extern column by extracting the family binding's own quoted names
-- out of that engine's own file, so hoisting the names into a module both
-- backends import would leave the gate reading neither engine as implementing
-- them -- the duplication is what keeps the two columns independently derivable.
-- lint-disable-next-line rule-duplicate-body
isByteBlockExtern name = contains name [
  "byteBlockMake", "byteBlockLength", "byteBlockGetUnsafe",
  "byteBlockSetUnsafe", "byteBlockCopyUnsafe", "byteBlockBlit",
  "byteBlockFromIntArray", "byteBlockToIntArray", "byteBlockFromString",
  "byteBlockToString"
]

emitByteBlockExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitByteBlockExtern e env "byteBlockMake" args = match emitArgs e env args
  [n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_make(i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: byteBlockMake takes one argument"
emitByteBlockExtern e env "byteBlockLength" args = match emitArgs e env args
  [bb] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_length(i64 \{bb})"
    (r, LTInt)
  _ => panic "llvm: byteBlockLength takes one argument"
emitByteBlockExtern e env "byteBlockGetUnsafe" args = match emitArgs e env args
  [i, bb] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_get(i64 \{i}, i64 \{bb})"
    (r, LTInt)
  _ => panic "llvm: byteBlockGetUnsafe takes two arguments"
emitByteBlockExtern e env "byteBlockSetUnsafe" args = match emitArgs e env args
  [i, v, bb] =>
    let _ =
      emit e "  call void @mdk_byteblock_set(i64 \{i}, i64 \{v}, i64 \{bb})"
    ("1", LTUnit)
  _ => panic "llvm: byteBlockSetUnsafe takes three arguments"
emitByteBlockExtern e env "byteBlockCopyUnsafe" args = match emitArgs e env args
  [n, bb] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_copy(i64 \{n}, i64 \{bb})"
    (r, LTCon)
  _ => panic "llvm: byteBlockCopyUnsafe takes two arguments"
emitByteBlockExtern e env "byteBlockBlit" args = match emitArgs e env args
  [src, so, dst, dof, len] =>
    let _ =
      emit
        e
        "  call void @mdk_byteblock_blit(i64 \{src}, i64 \{so}, i64 \{dst}, i64 \{dof}, i64 \{len})"
    ("1", LTUnit)
  _ => panic "llvm: byteBlockBlit takes five arguments"
emitByteBlockExtern e env "byteBlockFromIntArray" args =
  match emitArgs e env args
    [a] =>
      let r = freshReg e
      let _ = emit e "  \{r} = call i64 @mdk_byteblock_from_int_array(i64 \{a})"
      (r, LTCon)
    _ => panic "llvm: byteBlockFromIntArray takes one argument"
emitByteBlockExtern e env "byteBlockToIntArray" args = match emitArgs e env args
  [bb] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_to_int_array(i64 \{bb})"
    (r, LTCon)
  _ => panic "llvm: byteBlockToIntArray takes one argument"
emitByteBlockExtern e env "byteBlockFromString" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_from_string(i64 \{s})"
    (r, LTCon)
  _ => panic "llvm: byteBlockFromString takes one argument"
emitByteBlockExtern e env "byteBlockToString" args = match emitArgs e env args
  [bb] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_byteblock_to_string(i64 \{bb})"
    (r, LTStr)
  _ => panic "llvm: byteBlockToString takes one argument"
emitByteBlockExtern e _ name _ =
  gapE e ("unsupported byte-block extern " ++ name)

-- char scalar externs (native extern catalog slice 8).
-- charCode is INTRINSIC: Char and Int share the same tagged word encoding, so
-- charCode is a pure re-type — emit the operand as-is and return LTInt.
-- charToStr delegates to mdk_char_to_str (runtime/medaka_rt.c).
isCharExtern : String -> Bool
isCharExtern name = contains name ["charCode", "charToStr"]

emitCharExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitCharExtern e env "charCode" args = match emitArgs e env args
  [a] => (a, LTInt)
  _ => panic "llvm: charCode takes one argument"
emitCharExtern e env "charToStr" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_to_str(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: charToStr takes one argument"
emitCharExtern e _ name _ = gapE e ("unsupported char extern " ++ name)

-- slice 9: string↔char conversions + codepoint slicing.
isStrCharExtern : String -> Bool
isStrCharExtern name = contains name [
  "stringToChars",
  "stringFromChars",
  "stringSlice",
  "stringToUtf8Bytes",
  "stringFromUtf8Bytes",
]

emitStrCharExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitStrCharExtern e env "stringToChars" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_to_chars(i64 \{s})"
    (r, LTCon)
  _ => panic "llvm: stringToChars takes one argument"
emitStrCharExtern e env "stringFromChars" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_from_chars(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: stringFromChars takes one argument"
emitStrCharExtern e env "stringSlice" args = match emitArgs e env args
  [lo, hi, s] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_string_slice(i64 \{lo}, i64 \{hi}, i64 \{s})"
    (r, LTStr)
  _ => panic "llvm: stringSlice takes three arguments"
-- UTF-8 codec: stringToUtf8Bytes -> Array Int ($arr-shaped, LTCon); stringFromUtf8Bytes -> String.
emitStrCharExtern e env "stringToUtf8Bytes" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_to_utf8_bytes(i64 \{s})"
    (r, LTCon)
  _ => panic "llvm: stringToUtf8Bytes takes one argument"
emitStrCharExtern e env "stringFromUtf8Bytes" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_from_utf8_bytes(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: stringFromUtf8Bytes takes one argument"
emitStrCharExtern e _ name _ = gapE e ("unsupported str-char extern " ++ name)

-- slice 14: ASCII char classification + case mapping (unicode subset).
-- Predicate externs return raw 0/1 from C; emitter wraps with tagInt to Bool.
-- charIsPunct matches Unicode Pc/Pd/Pe/Pf/Pi/Po/Ps for ASCII (NOT C ispunct —
-- symbols like + $ = ^ ` | ~ are excluded).
isUnicodeExtern : String -> Bool
isUnicodeExtern name = contains name [
  "charIsAlpha",
  "charIsSpace",
  "charIsUpper",
  "charIsLower",
  "charIsPunct",
  "charToUpper",
  "charToLower",
  "stringToUpper",
  "stringToLower",
]

emitUnicodeExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitUnicodeExtern e env "charIsAlpha" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_is_alpha(i64 \{a})"
    (tagInt e r, LTBool)
  _ => panic "llvm: charIsAlpha takes one argument"
emitUnicodeExtern e env "charIsSpace" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_is_space(i64 \{a})"
    (tagInt e r, LTBool)
  _ => panic "llvm: charIsSpace takes one argument"
emitUnicodeExtern e env "charIsUpper" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_is_upper(i64 \{a})"
    (tagInt e r, LTBool)
  _ => panic "llvm: charIsUpper takes one argument"
emitUnicodeExtern e env "charIsLower" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_is_lower(i64 \{a})"
    (tagInt e r, LTBool)
  _ => panic "llvm: charIsLower takes one argument"
emitUnicodeExtern e env "charIsPunct" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_is_punct(i64 \{a})"
    (tagInt e r, LTBool)
  _ => panic "llvm: charIsPunct takes one argument"
emitUnicodeExtern e env "charToUpper" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_to_upper(i64 \{a})"
    (r, LTChar)
  _ => panic "llvm: charToUpper takes one argument"
emitUnicodeExtern e env "charToLower" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_to_lower(i64 \{a})"
    (r, LTChar)
  _ => panic "llvm: charToLower takes one argument"
emitUnicodeExtern e env "stringToUpper" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_to_upper(i64 \{s})"
    (r, LTStr)
  _ => panic "llvm: stringToUpper takes one argument"
emitUnicodeExtern e env "stringToLower" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_to_lower(i64 \{s})"
    (r, LTStr)
  _ => panic "llvm: stringToLower takes one argument"
emitUnicodeExtern e _ name _ = gapE e ("unsupported unicode extern " ++ name)

-- slice 10: ADT-RETURNING externs (precursor canary).  The C side constructs the
-- result cell with the reserved tags (see `reservedTag` / runtime mdk_some etc.), so
-- a later `match` agrees.  `charFromCode` is the canary — it proves both the boxed
-- (`Some`) and immediate (`None`) reserved-tag round-trips end-to-end.  Slices 11/12/
-- 13 extend this family (stringToFloat, args, readFile, …).  Result is LTCon (an ADT
-- value): never auto-printed — fixtures `match` it down to a scalar.
isAdtExtern : String -> Bool
isAdtExtern name = contains name [
  "charFromCode", "stringToFloat", "stringIndexOf", "stringCompare"
]

emitAdtExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitAdtExtern e env "charFromCode" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_char_from_code(i64 \{a})"
    (r, LTCon)
  _ => panic "llvm: charFromCode takes one argument"
emitAdtExtern e env "stringToFloat" args = match emitArgs e env args
  [s] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_to_float(i64 \{s})"
    (r, LTCon)
  _ => panic "llvm: stringToFloat takes one argument"
emitAdtExtern e env "stringIndexOf" args = match emitArgs e env args
  [n, h] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_index_of(i64 \{n}, i64 \{h})"
    (r, LTCon)
  _ => panic "llvm: stringIndexOf takes two arguments"
emitAdtExtern e env "stringCompare" args = match emitArgs e env args
  [a, b] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_compare(i64 \{a}, i64 \{b})"
    (r, LTCon)
  _ => panic "llvm: stringCompare takes two arguments"
emitAdtExtern e _ name _ = gapE e ("unsupported adt extern " ++ name)

-- slice 12: args + env externs.  `args ()` → List String of argv[1..];
-- `getEnv name` → Option String.  Results are LTCon — never auto-printed.
isEnvExtern : String -> Bool
isEnvExtern name = contains name ["args", "getEnv"]

emitEnvExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitEnvExtern e env "args" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_args(i64 \{u})"
    (r, LTCon)
  _ => panic "llvm: args takes one (Unit) argument"
emitEnvExtern e env "getEnv" args = match emitArgs e env args
  [n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_get_env(i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: getEnv takes one argument"
emitEnvExtern e _ name _ = gapE e ("unsupported env extern " ++ name)

-- slice 13: file IO + stdin externs.  Result/Option/List returns are LTCon;
-- fileExists returns raw 0/1 which the emitter tags (LTBool); readLine/readAll
-- return heap Strings (LTStr).  readLine/readLineOpt/readAll are implemented
-- but NOT fixtured — the gate does not pipe stdin.
isFileExtern : String -> Bool
isFileExtern name = contains name [
  "readFile",
  "readFileBytes",
  "writeFile",
  "writeFileBytes",
  "writeFileMode",
  "appendFile",
  "fileExists",
  "fileMode",
  "canonicalizePath",
  "listDir",
  "readLine",
  "readLineOpt",
  "readAll",
  "readExactly",
  "makeDir",
  "removeFile",
  "rename",
  "removeDir",
  "fsync",
  "statFile",
  "runCommand",
  "runCommandBatch",
  "executablePath",
  "buildFingerprint",
  "buildCommit",
  "buildDate",
]

-- A file extern whose path is an authority takes, after its value arguments, the
-- authority granted for each path (EFFECTS-SEMANTICS §8): elaboration saturates
-- every use of one, so a call here always carries them.
emitFileExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitFileExtern e env "readFile" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_file(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: readFile takes one argument and its grant"
emitFileExtern e env "readFileBytes" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_file_bytes(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: readFileBytes takes one argument and its grant"
emitFileExtern e env "writeFile" args = match emitArgs e env args
  [p, c, g] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_write_file(i64 \{p}, i64 \{c}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: writeFile takes two arguments and its grant"
emitFileExtern e env "writeFileBytes" args = match emitArgs e env args
  [p, a, g] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_write_file_bytes(i64 \{p}, i64 \{a}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: writeFileBytes takes two arguments and its grant"
emitFileExtern e env "writeFileMode" args = match emitArgs e env args
  [p, m, c, g] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_write_file_mode(i64 \{p}, i64 \{m}, i64 \{c}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: writeFileMode takes three arguments and its grant"
emitFileExtern e env "fileMode" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_file_mode(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: fileMode takes one argument and its grant"
emitFileExtern e env "appendFile" args = match emitArgs e env args
  [p, c, g] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_append_file(i64 \{p}, i64 \{c}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: appendFile takes two arguments and its grant"
emitFileExtern e env "fileExists" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_file_exists(i64 \{p}, i64 \{g})"
    (tagInt e r, LTBool)
  _ => panic "llvm: fileExists takes one argument and its grant"
emitFileExtern e env "canonicalizePath" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_canonicalize_path(i64 \{p}, i64 \{g})"
    (r, LTStr)
  _ => panic "llvm: canonicalizePath takes one argument and its grant"
emitFileExtern e env "listDir" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_list_dir(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: listDir takes one argument and its grant"
emitFileExtern e env "readLine" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_line(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: readLine takes one (Unit) argument"
emitFileExtern e env "readLineOpt" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_line_opt(i64 \{u})"
    (r, LTCon)
  _ => panic "llvm: readLineOpt takes one (Unit) argument"
emitFileExtern e env "readAll" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_all(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: readAll takes one (Unit) argument"
emitFileExtern e env "readExactly" args = match emitArgs e env args
  [n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_read_exactly(i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: readExactly takes one (Int) argument"
emitFileExtern e env "makeDir" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_make_dir(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: makeDir takes one argument and its grant"
emitFileExtern e env "removeFile" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_remove_file(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: removeFile takes one argument and its grant"
emitFileExtern e env "rename" args = match emitArgs e env args
  [old, new, gs, gd] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_rename(i64 \{old}, i64 \{new}, i64 \{gs}, i64 \{gd})"
    (r, LTCon)
  _ => panic "llvm: rename takes two arguments and its two grants"
emitFileExtern e env "removeDir" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_remove_dir(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: removeDir takes one argument and its grant"
emitFileExtern e env "fsync" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_fsync(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: fsync takes one argument and its grant"
emitFileExtern e env "statFile" args = match emitArgs e env args
  [p, g] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_stat_file(i64 \{p}, i64 \{g})"
    (r, LTCon)
  _ => panic "llvm: statFile takes one argument and its grant"
emitFileExtern e env "runCommand" args = match emitArgs e env args
  [prog, argv] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_run_command(i64 \{prog}, i64 \{argv})"
    (r, LTCon)
  _ => panic "llvm: runCommand takes two arguments"
emitFileExtern e env "runCommandBatch" args = match emitArgs e env args
  [prog, jobs, argvs] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_run_command_batch(i64 \{prog}, i64 \{jobs}, i64 \{argvs})"
    (r, LTCon)
  _ => panic "llvm: runCommandBatch takes three arguments"
emitFileExtern e env "executablePath" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_executable_path(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: executablePath takes one (Unit) argument"
emitFileExtern e env "buildFingerprint" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_build_fingerprint(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: buildFingerprint takes one (Unit) argument"
emitFileExtern e env "buildCommit" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_build_commit(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: buildCommit takes one (Unit) argument"
emitFileExtern e env "buildDate" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_build_date(i64 \{u})"
    (r, LTStr)
  _ => panic "llvm: buildDate takes one (Unit) argument"
emitFileExtern e _ name _ = gapE e ("unsupported file extern " ++ name)

-- Net externs (NET-DESIGN.md).  A SEPARATE family from isFileExtern — deliberately,
-- so the wasm backend can reject the whole net set in one guard.  All return a
-- Result (LTCon) traffic'ing raw tagged-Int fds; blocking BSD-socket shims in
-- runtime/medaka_rt.c.
isNetExtern : String -> Bool
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
isNetExtern name = contains name [
  "netResolve",
  "netTcpConnect",
  "netTcpListen",
  "netListenPort",
  "netTcpAccept",
  "netSend",
  "netSendFrom",
  "netRecv",
  "netShutdown",
  "netClose",
  "netCloseListener",
  "netSetTimeout",
  "socketFd",
  "listenSocketFd",
  "ioPoll",
  "pdsSignalStart",
  "pdsSignalRequested",
  "netSetNonblock",
  "netSetNonblockListener",
  "netConnectStart",
  "netConnectCheck",
  "netTryAccept",
  "netTryRecv",
  "netTryRecvBytes",
  "netTrySend",
  "netTrySendFrom",
  "netSendBytesFrom",
  "netTrySendBytesFrom",
]

emitNetExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitNetExtern e env "netResolve" args = match emitArgs e env args
  [h] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_resolve(i64 \{h})"
    (r, LTCon)
  _ => panic "llvm: netResolve takes one argument"
emitNetExtern e env "netTcpConnect" args = match emitArgs e env args
  [h, p] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_tcp_connect(i64 \{h}, i64 \{p})"
    (r, LTCon)
  _ => panic "llvm: netTcpConnect takes two arguments"
emitNetExtern e env "netTcpListen" args = match emitArgs e env args
  [a, p] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_tcp_listen(i64 \{a}, i64 \{p})"
    (r, LTCon)
  _ => panic "llvm: netTcpListen takes two arguments"
emitNetExtern e env "netListenPort" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_listen_port(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netListenPort takes one argument"
emitNetExtern e env "netTcpAccept" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_tcp_accept(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netTcpAccept takes one argument"
emitNetExtern e env "netSend" args = match emitArgs e env args
  [fd, bs] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_send(i64 \{fd}, i64 \{bs})"
    (r, LTCon)
  _ => panic "llvm: netSend takes two arguments"
emitNetExtern e env "netSendFrom" args = match emitArgs e env args
  [fd, bs, off] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_net_send_from(i64 \{fd}, i64 \{bs}, i64 \{off})"
    (r, LTCon)
  _ => panic "llvm: netSendFrom takes three arguments"
emitNetExtern e env "netRecv" args = match emitArgs e env args
  [fd, n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_recv(i64 \{fd}, i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: netRecv takes two arguments"
emitNetExtern e env "netShutdown" args = match emitArgs e env args
  [fd, how] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_shutdown(i64 \{fd}, i64 \{how})"
    (r, LTCon)
  _ => panic "llvm: netShutdown takes two arguments"
emitNetExtern e env "netClose" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_close(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netClose takes one argument"
-- A listener closes through the same shim: both are descriptors to the host.
emitNetExtern e env "netCloseListener" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_close(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netCloseListener takes one argument"
-- A socket is the descriptor's tagged word (RUNTIME-DESIGN §8), so its number
-- is the same word read as an Int.
emitNetExtern e env "socketFd" args = match emitArgs e env args
  [s] => (s, LTInt)
  _ => panic "llvm: socketFd takes one argument"
emitNetExtern e env "listenSocketFd" args = match emitArgs e env args
  [s] => (s, LTInt)
  _ => panic "llvm: listenSocketFd takes one argument"
emitNetExtern e env "netSetTimeout" args = match emitArgs e env args
  [fd, ms] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_net_set_timeout(i64 \{fd}, i64 \{ms})"
    (r, LTCon)
  _ => panic "llvm: netSetTimeout takes two arguments"
-- Readiness shims (async runtime): every arg is a tagged Int, a Bool (tagged
-- like an Int), or a boxed Array; every result is a boxed Result.
emitNetExtern e env "pdsSignalStart" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_pds_signal_start(i64 \{u})"
    (r, LTCon)
  _ => panic "llvm: pdsSignalStart takes one argument"
emitNetExtern e env "pdsSignalRequested" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_pds_signal_requested(i64 \{u})"
    (r, LTBool)
  _ => panic "llvm: pdsSignalRequested takes one argument"
emitNetExtern e env "ioPoll" args = match emitArgs e env args
  [fds, ints, ms] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_io_poll(i64 \{fds}, i64 \{ints}, i64 \{ms})"
    (r, LTCon)
  _ => panic "llvm: ioPoll takes three arguments"
emitNetExtern e env "netSetNonblock" args = match emitArgs e env args
  [fd, on] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_net_set_nonblock(i64 \{fd}, i64 \{on})"
    (r, LTCon)
  _ => panic "llvm: netSetNonblock takes two arguments"
emitNetExtern e env "netSetNonblockListener" args = match emitArgs e env args
  [fd, on] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_net_set_nonblock(i64 \{fd}, i64 \{on})"
    (r, LTCon)
  _ => panic "llvm: netSetNonblockListener takes two arguments"
emitNetExtern e env "netConnectStart" args = match emitArgs e env args
  [h, p] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_net_connect_start(i64 \{h}, i64 \{p})"
    (r, LTCon)
  _ => panic "llvm: netConnectStart takes two arguments"
emitNetExtern e env "netConnectCheck" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_connect_check(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netConnectCheck takes one argument"
emitNetExtern e env "netTryAccept" args = match emitArgs e env args
  [fd] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_try_accept(i64 \{fd})"
    (r, LTCon)
  _ => panic "llvm: netTryAccept takes one argument"
emitNetExtern e env "netTryRecv" args = match emitArgs e env args
  [fd, n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_try_recv(i64 \{fd}, i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: netTryRecv takes two arguments"
emitNetExtern e env "netTryRecvBytes" args = match emitArgs e env args
  [fd, n] =>
    let r = freshReg e
    let _ =
      emit e "  \{r} = call i64 @mdk_net_try_recv_bytes(i64 \{fd}, i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: netTryRecvBytes takes two arguments"
emitNetExtern e env "netTrySend" args = match emitArgs e env args
  [fd, bs] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_net_try_send(i64 \{fd}, i64 \{bs})"
    (r, LTCon)
  _ => panic "llvm: netTrySend takes two arguments"
emitNetExtern e env "netTrySendFrom" args = match emitArgs e env args
  [fd, bs, off] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_net_try_send_from(i64 \{fd}, i64 \{bs}, i64 \{off})"
    (r, LTCon)
  _ => panic "llvm: netTrySendFrom takes three arguments"
emitNetExtern e env "netSendBytesFrom" args = match emitArgs e env args
  [fd, bb, lo, hi] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_net_send_bytes_from(i64 \{fd}, i64 \{bb}, i64 \{lo}, i64 \{hi})"
    (r, LTCon)
  _ => panic "llvm: netSendBytesFrom takes four arguments"
emitNetExtern e env "netTrySendBytesFrom" args = match emitArgs e env args
  [fd, bb, lo, hi] =>
    let r = freshReg e
    let _ =
      emit
        e
        "  \{r} = call i64 @mdk_net_try_send_bytes_from(i64 \{fd}, i64 \{bb}, i64 \{lo}, i64 \{hi})"
    (r, LTCon)
  _ => panic "llvm: netTrySendBytesFrom takes four arguments"
emitNetExtern e _ name _ = gapE e ("unsupported net extern " ++ name)

-- Tier D: RNG. The deterministic random* family uses SplitMix64 state in the C
-- runtime. osEntropyBytes is deliberately separate and reads the host OS source.
-- randomInt/Bool/Char return RAW words tagged here; randomFloat returns a boxed
-- Float word; osEntropyBytes returns a boxed Array; setSeed is Unit.
isRngExtern : String -> Bool
isRngExtern name = contains name [
  "randomInt",
  "randomBool",
  "randomFloat",
  "randomChar",
  "setSeed",
  "randomState",
  "restoreRandomState",
  "osEntropyBytes",
]

emitRngExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitRngExtern e env "randomInt" args = match emitArgs e env args
  [lo, hi] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_random_int(i64 \{lo}, i64 \{hi})"
    (tagInt e r, LTInt)
  _ => panic "llvm: randomInt takes two arguments"
emitRngExtern e env "randomBool" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_random_bool(i64 \{u})"
    (tagInt e r, LTBool)
  _ => panic "llvm: randomBool takes one (Unit) argument"
emitRngExtern e env "randomFloat" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_random_float(i64 \{u})"
    (r, LTFloat)
  _ => panic "llvm: randomFloat takes one (Unit) argument"
emitRngExtern e env "randomChar" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_random_char(i64 \{u})"
    (tagInt e r, LTChar)
  _ => panic "llvm: randomChar takes one (Unit) argument"
emitRngExtern e env "setSeed" args = match emitArgs e env args
  [n] =>
    let _ = emit e ("  call void @mdk_set_seed(i64 " ++ n ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: setSeed takes one argument"
emitRngExtern e env "randomState" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_random_state(i64 \{u})"
    (r, LTU64)
  _ => panic "llvm: randomState takes one (Unit) argument"
emitRngExtern e env "restoreRandomState" args = match emitArgs e env args
  [state] =>
    let _ = emit e "  call void @mdk_restore_random_state(i64 \{state})"
    ("1", LTUnit)
  _ => panic "llvm: restoreRandomState takes one argument"
emitRngExtern e env "osEntropyBytes" args = match emitArgs e env args
  [n] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_os_entropy_bytes(i64 \{n})"
    (r, LTCon)
  _ => panic "llvm: osEntropyBytes takes one argument"
emitRngExtern e _ name _ = gapE e ("unsupported rng extern " ++ name)

-- wallTimeSec / allocBytes: both take Unit and return a boxed Float (same ABI
-- as randomFloat).  C: mdk_wall_time_sec / mdk_alloc_bytes in medaka_rt.c.
isPerfExtern : String -> Bool
isPerfExtern name =
  contains name ["wallTimeSec", "monotonicSec", "sleepMs", "allocBytes"]

emitPerfExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitPerfExtern e env "wallTimeSec" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_wall_time_sec(i64 \{u})"
    (r, LTFloat)
  _ => panic "llvm: wallTimeSec takes one (Unit) argument"
emitPerfExtern e env "monotonicSec" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_monotonic_sec(i64 \{u})"
    (r, LTFloat)
  _ => panic "llvm: monotonicSec takes one (Unit) argument"
emitPerfExtern e env "sleepMs" args = match emitArgs e env args
  [n] =>
    let _ = emit e ("  call void @mdk_sleep_ms(i64 " ++ n ++ ")")
    ("1", LTUnit)
  _ => panic "llvm: sleepMs takes one (Int) argument"
emitPerfExtern e env "allocBytes" args = match emitArgs e env args
  [u] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_alloc_bytes(i64 \{u})"
    (r, LTFloat)
  _ => panic "llvm: allocBytes takes one (Unit) argument"
emitPerfExtern e _ name _ = gapE e ("unsupported perf extern " ++ name)

-- Hashable per-type hashers.
-- Each unpacks the native arg the C helper wants (untagged int / codepoint /
-- unboxed double / String cell pointer) and tags the RAW Int result.  hashBool
-- untags the 0/1 bool word.  See runtime/medaka_rt.c mdk_hash_*.
-- Bitwise / shift externs (PURE).  Args are tagged ints — untag each operand,
-- call the C helper on the raw values, retag the result.  shiftRight is LOGICAL
-- (C >> on the untagged non-negative value == OCaml lsr for non-negative);
-- bitNot's retag (shl/or) drops the top bit so it matches OCaml lnot on the
-- 63-bit rep.  See runtime/medaka_rt.c mdk_bit_*/mdk_shift_*.  The `int`-prefixed
-- names (`intBitAnd`, …) are the same primitives under names a module defining its
-- own `bitAnd` can still reach; they emit exactly what the bare name does.
isBitExtern : String -> Bool
isBitExtern name = contains name [
  "bitAnd", "bitOr", "bitXor", "shiftLeft", "shiftRight", "bitNot", "intBitAnd",
  "intBitOr", "intBitXor", "intShiftLeft", "intShiftRight", "intBitNot"
]

emitBitBin : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitBitBin e env sym args = match emitArgs e env args
  [a, b] =>
    let x = untagInt e a
    let y = untagInt e b
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @\{sym}(i64 \{x}, i64 \{y})"
    (tagInt e r, LTInt)
  _ => panic ("llvm: " ++ sym ++ " takes two arguments")

emitBitExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitBitExtern e env "bitAnd" args = emitBitBin e env "mdk_bit_and" args
emitBitExtern e env "bitOr" args = emitBitBin e env "mdk_bit_or" args
emitBitExtern e env "bitXor" args = emitBitBin e env "mdk_bit_xor" args
emitBitExtern e env "shiftLeft" args = emitBitBin e env "mdk_shift_left" args
emitBitExtern e env "shiftRight" args = emitBitBin e env "mdk_shift_right" args
emitBitExtern e env "intBitAnd" args = emitBitExtern e env "bitAnd" args
emitBitExtern e env "intBitOr" args = emitBitExtern e env "bitOr" args
emitBitExtern e env "intBitXor" args = emitBitExtern e env "bitXor" args
emitBitExtern e env "intShiftLeft" args = emitBitExtern e env "shiftLeft" args
emitBitExtern e env "intShiftRight" args = emitBitExtern e env "shiftRight" args
emitBitExtern e env "intBitNot" args = emitBitExtern e env "bitNot" args
emitBitExtern e env "bitNot" args = match emitArgs e env args
  [a] =>
    let x = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_bit_not(i64 \{x})"
    (tagInt e r, LTInt)
  _ => panic "llvm: bitNot takes one argument"
emitBitExtern e _ name _ = gapE e ("unsupported bit extern " ++ name)

-- Fixed-width integer conversions (PURE).  A `U8`/`U16`/`U32` is Int's tagged
-- word, so `uNToInt` is the identity on it, and `uNTruncate` keeps the low `n`
-- bits of the payload with one `and` on the TAGGED word: the mask shifted over
-- the tag bit, tag bit kept (`(2^n - 1) << 1 | 1`), which is exact for a
-- negative payload too.  An `I32` is the same word held sign-extended:
-- `i32ToInt` is the identity and `i32Truncate` the low 32 bits sign-extended.
isFixedWidthExtern : String -> Bool
isFixedWidthExtern name = contains name [
  "u8Truncate", "u8ToInt", "u16Truncate", "u16ToInt", "u32Truncate", "u32ToInt",
  "i32Truncate", "i32ToInt"
]

emitFixedWidthTruncate : Emit ->
  OrdMap (String, LTy) ->
  Int ->
  List CExpr ->
  (String, LTy)
emitFixedWidthTruncate e env mask args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let taggedMask = intToString (mask * 2 + 1)
    let _ = emit e "  \{r} = and i64 \{a}, \{taggedMask}"
    (r, LTInt)
  _ => panic "llvm: a fixed-width truncation takes one argument"

emitFixedWidthExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitFixedWidthExtern e env "u8Truncate" args =
  emitFixedWidthTruncate e env 255 args
emitFixedWidthExtern e env "u16Truncate" args =
  emitFixedWidthTruncate e env 65535 args
emitFixedWidthExtern e env "u32Truncate" [a] =
  (tagU32 e (u32TruncateRaw e env a), LTInt)
emitFixedWidthExtern e env "u32Truncate" args =
  emitFixedWidthTruncate e env 4294967295 args
emitFixedWidthExtern e env "i32Truncate" [a] =
  (tagI32 e (u32TruncateRaw e env a), LTInt)
emitFixedWidthExtern e env "u8ToInt" args = emitFixedWidthToInt e env args
emitFixedWidthExtern e env "u16ToInt" args = emitFixedWidthToInt e env args
emitFixedWidthExtern e env "u32ToInt" args = emitFixedWidthToInt e env args
emitFixedWidthExtern e env "i32ToInt" args = emitFixedWidthToInt e env args
emitFixedWidthExtern e _ name _ =
  gapE e ("unsupported fixed-width extern " ++ name)

emitFixedWidthToInt : Emit ->
  OrdMap (String, LTy) ->
  List CExpr ->
  (String, LTy)
emitFixedWidthToInt e env args = match emitArgs e env args
  [a] => (a, LTInt)
  _ => panic "llvm: a fixed-width widening takes one argument"

-- The `U64` kernels (PURE), all inline IR on the unboxed payload.  They are the
-- only doors between a U64 cell and an Int word: `u64Truncate` sign-extends the
-- 63-bit Int to 64 bits (the `ashr` untag is exactly that), and
-- `u64TruncateToInt` retags the low 63 bits (`shl` drops bit 63).  The shifts take
-- an Int amount and give 0 for any amount outside `0 .. 63`, by a select rather
-- than a branch; the amount is masked first, so the `shl`/`lshr` itself never sees
-- an out-of-range count.
-- Each backend names the kernels it implements itself, and
-- test/diff_compiler_capability_matrix.sh reads the list from each backend's own
-- source, so the list is duplicated in wasm_emit.mdk's `isU64ExternW` on purpose.
-- `i64FromBits` and `i64ToBits` keep the payload and change only the header, so
-- they are kernels of this family too: on payloads they are the identity.
isU64Extern : String -> Bool
-- lint-disable-next-line rule-duplicate-body
isU64Extern name = contains name [
  "u64Truncate", "u64TruncateToInt", "u64BitAnd", "u64BitOr", "u64BitXor",
  "u64ShiftLeft", "u64ShiftRight", "u64MulHigh", "i64FromBits", "i64ToBits"
]

emitU64Extern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitU64Extern e env "u64TruncateToInt" [a] =
  (tagInt e (emitU64Raw e env a), LTInt)
emitU64Extern _ _ "u64TruncateToInt" _ =
  panic "llvm: u64TruncateToInt takes one argument"
emitU64Extern e env "i64FromBits" args =
  (boxI64 e (emitU64Kernel e env "i64FromBits" args), LTI64)
emitU64Extern e env name args =
  (boxU64 e (emitU64Kernel e env name args), LTU64)

-- The raw 64-bit payload of a `U64`- or `I64`-valued expression.  Nested U64 and
-- I64 arithmetic and the kernels below compute on payloads and are boxed once, by
-- the outermost node that needs a cell: every intermediate cell would be a heap
-- allocation, and the allocator was most of a boxed-U64 fold's cost
-- (docs/design/INTEGER-TYPES-DESIGN.md §6.2).  A payload does not say which of
-- the two it is: each arithmetic node reads its own stamp, and whoever boxes the
-- result knows its type.  Anything else is emitted as usual and unboxed; a
-- literal is a static cell, so that is a load.
emitU64Raw : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitU64Raw e env (CBinPrim op l r tag site)
  | isBoxed64Head tag && isArithOp op =
    emitU64RawArith e env (isI64Head tag) op l r site
  | otherwise = unboxU64 e (fst (emitExpr e env (CBinPrim op l r tag site)))
emitU64Raw e env (CVar x a) = match omLookup x env
  Some (reg, LTU64U) => reg
  Some _ => emitU64RawApp e env (CVar x a) (CVar x a, [])
  None => match omLookup x !e.constGlobals
    Some (LU64 hi lo) => emitU64Raw e env (CLit (LU64 hi lo))
    Some (LI64 hi lo) => emitU64Raw e env (CLit (LI64 hi lo))
    _ => emitU64RawApp e env (CVar x a) (CVar x a, [])
emitU64Raw e env (CIf c t f) = emitRawIf e env RawU64 c t f
emitU64Raw e env (CBlock stmts) = emitRawBlock e env RawU64 stmts
emitU64Raw e env (CLet False (PVar x a) e1 e2) = match e1
  CLam _ _ => unboxU64 e (fst (emitExpr e env (CLet False (PVar x a) e1 e2)))
  _ => emitU64Raw e (bindLetRaw e env x e1 e2) e2
emitU64Raw e env ex = emitU64RawApp e env ex (flattenApp ex [])

-- a saturated call of a kernel is computed on payloads; anything else is boxed
-- by its own emission and unboxed here.
emitU64RawApp : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  (CExpr, List CExpr) ->
  String
emitU64RawApp e env ex (CVar f _, args)
  | isW64RawKernel f (lengthS args) && not (isLocal env f) =
    emitU64Kernel e env f args
  | isLocal env f = unboxU64 e (fst (emitExpr e env ex))
  | otherwise = match u64KernelAlias e f args
    Some k => emitU64Kernel e env k args
    None => match rawWorkerReturning e f (lengthS args) RawU64
      Some (sym, w) => emitRawWorkerCall e env sym w args
      None => unboxU64 e (fst (emitExpr e env ex))
emitU64RawApp e env ex _ = unboxU64 e (fst (emitExpr e env ex))

-- ── Raw workers: U64 and U32 across parameter and return (N5) ───────────────
-- An annotated single-clause function whose declared signature names `U64` or
-- `U32` in a parameter or the result gets a raw worker `@mdk_<f>__rw`: the same
-- body, with each such parameter held raw (a `U64` as its 64-bit payload,
-- LTU64U; a `U32` as an `i32`, LTU32U) and such a result returned raw.
-- `@mdk_<f>` stays the uniform-ABI entry, a wrapper that unboxes or untags,
-- calls the worker, and boxes or retags.  A saturated direct call calls the
-- worker, so the value crosses the call with no cell and no tag, and a tail
-- self-call in the worker is a loop on raw registers.  The declared signature
-- is what typecheck checked, so a position is raw only where the program says
-- `U64` or `U32`.  An `I32` position is raw as a U32's is (RawI32, an `i32`),
-- and differs only where it is retagged: sign-extended, not zero-extended.
data RawKind = RawWord | RawU64 | RawU32 | RawI32

data RawWorker = RawWorker Int (List RawKind) RawKind

rawKindOfHead : String -> RawKind
rawKindOfHead "U64" = RawU64
rawKindOfHead "U32" = RawU32
rawKindOfHead "I32" = RawI32
rawKindOfHead _ = RawWord

-- the LLVM type a value of this kind travels as.
rawKindTy : RawKind -> String
rawKindTy RawU32 = "i32"
rawKindTy RawI32 = "i32"
rawKindTy _ = "i64"

isRawWord : RawKind -> Bool
isRawWord RawWord = True
isRawWord _ = False

-- a kind held as an `i32` (a U32 or an I32).
isRaw32 : RawKind -> Bool
isRaw32 RawU32 = True
isRaw32 RawI32 = True
isRaw32 _ = False

sameRawKind : RawKind -> RawKind -> Bool
sameRawKind RawWord RawWord = True
sameRawKind RawU64 RawU64 = True
sameRawKind RawU32 RawU32 = True
sameRawKind RawI32 RawI32 = True
sameRawKind _ _ = False

-- an `i32` register of kind `k` -> its tagged word.
tagW32 : Emit -> RawKind -> String -> String
tagW32 e RawI32 r = tagI32 e r
tagW32 e _ r = tagU32 e r

-- the LTy of a local holding an `i32` of kind `k`.
w32LocalLTy : RawKind -> LTy
w32LocalLTy RawI32 = LTI32U
w32LocalLTy _ = LTU32U

rawWorkerRet : RawWorker -> RawKind
rawWorkerRet (RawWorker _ _ r) = r

-- the worker of top-level `f` for a call with `n` arguments, when it has one of
-- exactly that arity: the worker symbol and its shape.
rawWorkerCall : Emit -> String -> Int -> Option (String, RawWorker)
rawWorkerCall e f n =
  let name = canonFnName e f
  match omLookup name !e.rawWorkers
    Some (RawWorker ar ks r) =>
      if ar == n then
        Some ("mdk_" ++ name ++ "__rw", RawWorker ar ks r)
      else
        None
    None => None

-- the worker of `f`, when its result is raw of kind `k`.
rawWorkerReturning : Emit ->
  String ->
  Int ->
  RawKind ->
  Option (String, RawWorker)
rawWorkerReturning e f n k = match rawWorkerCall e f n
  Some (sym, w) =>
    if sameRawKind (rawWorkerRet w) k then Some (sym, w) else None
  None => None

-- A call of a raw worker: each argument as its position's kind (a payload, an
-- `i32` or a word), evaluated left to right.  Returns the result register, of
-- the worker's result kind.
emitRawWorkerCall : Emit ->
  OrdMap (String, LTy) ->
  String ->
  RawWorker ->
  List CExpr ->
  String
emitRawWorkerCall e env sym (RawWorker _ ks r) args =
  let ops = emitRawArgs e env ks args
  let res = freshReg e
  let _ = emit e "  \{res} = call \{rawKindTy r} @\{sym}(\{rawArgDecls ops})"
  res

emitRawArgs : Emit ->
  OrdMap (String, LTy) ->
  List RawKind ->
  List CExpr ->
  List (String, String)
emitRawArgs e env (k :: ks) (a :: rest) =
  let op = emitRawAs e env k a
  (rawKindTy k, op) :: emitRawArgs e env ks rest
emitRawArgs _ _ _ _ = []

-- the worker of `f` whose result is an `i32` (a U32 or an I32).
rawWorkerReturning32 : Emit -> String -> Int -> Option (String, RawWorker)
rawWorkerReturning32 e f n = match rawWorkerCall e f n
  Some (sym, w) => if isRaw32 (rawWorkerRet w) then Some (sym, w) else None
  None => None

-- A U64- or U32-valued `if` or block on raw values: each arm stores its raw
-- value in the slot, so neither boxes or retags (emitIf's slot holds words).
emitRawIf : Emit ->
  OrdMap (String, LTy) ->
  RawKind ->
  CExpr ->
  CExpr ->
  CExpr ->
  String
emitRawIf e env k c t f =
  let ty = rawKindTy k
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "then" ++ n
  let elseL = "else" ++ n
  let endL = "end" ++ n
  let slot = freshReg e
  let _ = emit e "  \{slot} = alloca \{ty}"
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let tv = emitRawAs e env k t
  let _ = emit e "  store \{ty} \{tv}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (elseL ++ ":")
  let fv = emitRawAs e env k f
  let _ = emit e "  store \{ty} \{fv}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load \{ty}, ptr \{slot}"
  r

emitRawBlock : Emit -> OrdMap (String, LTy) -> RawKind -> List CStmt -> String
emitRawBlock e env k [CSExpr ex] = emitRawAs e env k ex
emitRawBlock e env k (s :: rest) = match rest
  [] => rawOfWord e k (fst (emitBlockLast e env s))
  _ => emitRawBlock e (emitBlockLead e env s rest) k rest
emitRawBlock e _ k [] = rawOfWord e k (fst (gapE e "empty block"))

-- a word as a value of kind `k`: a U64 cell's payload, a U32 word's `i32`.
rawOfWord : Emit -> RawKind -> String -> String
rawOfWord e RawU64 w = unboxU64 e w
rawOfWord e RawU32 w = untagU32 e w
rawOfWord e RawI32 w = untagU32 e w
rawOfWord _ RawWord w = w

-- `a` as a value of kind `k`.
emitRawAs : Emit -> OrdMap (String, LTy) -> RawKind -> CExpr -> String
emitRawAs e env RawU64 a = emitU64Raw e env a
emitRawAs e env RawU32 a = emitU32Raw e env a
emitRawAs e env RawI32 a = emitU32Raw e env a
emitRawAs e env RawWord a = fst (emitExpr e env a)

-- typed call operands, `i32 %x, i64 %y`.
rawArgDecls : List (String, String) -> String
rawArgDecls [] = ""
rawArgDecls [(t, x)] = "\{t} \{x}"
rawArgDecls ((t, x) :: rest) = "\{t} \{x}, \{rawArgDecls rest}"

-- The word result of a saturated call of a raw worker, for an ordinary (word)
-- context: a raw `U64` result is boxed and a raw `U32` retagged, once, here.
emitRawWorkerCallW : Emit ->
  OrdMap (String, LTy) ->
  String ->
  RawWorker ->
  List CExpr ->
  LTy ->
  (String, LTy)
emitRawWorkerCallW e env sym w args resTy =
  let r = emitRawWorkerCall e env sym w args
  match rawWorkerRet w
    RawU64 => (boxU64 e r, LTU64)
    RawU32 => (tagU32 e r, LTInt)
    RawI32 => (tagI32 e r, LTInt)
    RawWord => (r, resTy)

-- Is `ex` statically a `U64` that `emitU64Raw` computes on payloads?  Conservative:
-- a U64 literal, a local already holding a payload or cell, U64-stamped
-- arithmetic, a U64-valued `if`, a saturated kernel or kernel wrapper returning a
-- U64, and a saturated call of a worker with a raw result.  A false negative only
-- keeps the boxed path.
staticIsU64 : Emit -> OrdMap (String, LTy) -> CExpr -> Bool
staticIsU64 _ _ (CLit (LU64 _ _)) = True
staticIsU64 _ env (CVar x _) = match omLookup x env
  Some (_, LTU64U) => True
  Some (_, LTU64) => True
  _ => False
staticIsU64 _ _ (CBinPrim op _ _ tag _) = isU64Head tag && isArithOp op
staticIsU64 e env (CIf _ t f) = staticIsU64 e env t && staticIsU64 e env f
staticIsU64 e env ex = match flattenApp ex []
  (CVar f _, args) =>
    if isLocal env f then
      False
    else if isU64RawKernel f (lengthS args) then
      True
    else match u64KernelAlias e f args
      Some k => isU64RawKernel k (lengthS args)
      None => isSome (rawWorkerReturning e f (lengthS args) RawU64)
  _ => False

-- ── U32 as native i32 (N5) ──────────────────────────────────────────────────
-- A `U32` is Int's tagged word at every boundary (argument, result, array
-- slot, capture).  Inside an expression it is an `i32`: `emitU32Raw` computes a
-- U32-valued expression on `i32` registers, so `+ - *` wrap modulo 2^32 by
-- themselves and need no mask, and the word is untagged and truncated once at a
-- leaf and zero-extended and retagged once at the root (`tagU32`).  A `let`
-- keeps the `i32` (LTU32U).  The `u32` module's operations are Medaka over the
-- kernels (`u32Truncate`, `u32ToInt` and the `int`-prefixed bit primitives), so
-- a saturated call of a small `U32`-returning function is inlined here
-- (`u32Inline`): its body computes on the `i32`s too, and a rotate by a constant
-- amount reaches LLVM as the `shl`/`lshr`/`or` it turns into one rotate.
-- An `I32` is computed on the same `i32` registers: the bits of `+ - *` and of
-- every leaf are the same, and the sign shows only in `/` and `%` (read from each
-- node's own stamp) and where a value is retagged (`tagI32`).

-- an `i32` U32 register -> its tagged word.
tagU32 : Emit -> String -> String
tagU32 e r =
  let z = freshReg e
  let _ = emit e "  \{z} = zext i32 \{r} to i64"
  tagInt e z

-- an `i32` I32 register -> its tagged word.
tagI32 : Emit -> String -> String
tagI32 e r =
  let z = freshReg e
  let _ = emit e "  \{z} = sext i32 \{r} to i64"
  tagInt e z

-- a tagged U32 or I32 word -> its `i32`.  The payload is in `0 .. 2^32 - 1` or
-- in `-2^31 .. 2^31 - 1`, so the truncation keeps all of it.
untagU32 : Emit -> String -> String
untagU32 e w =
  let u = freshReg e
  let _ = emit e "  \{u} = lshr i64 \{w}, 1"
  let t = freshReg e
  let _ = emit e "  \{t} = trunc i64 \{u} to i32"
  t

-- An Int literal as an `i32` constant: the value is in `0 .. 2^32 - 1`
-- wherever a U32 is expected and in `-2^31 .. 2^31 - 1` wherever an I32 is,
-- spelled in `i32`'s signed range.
u32Const : Int -> String
u32Const n =
  let m = bitAnd n 4294967295
  intToString (if m >= 2147483648 then m - 4294967296 else m)

-- The `i32` of a U32- or I32-valued expression.
emitU32Raw : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitU32Raw _ _ (CLit (LInt n)) = u32Const n
emitU32Raw e env (CBinPrim op l r tag site)
  | isW32Head tag && isArithOp op =
    emitU32RawArith e env (isI32Head tag) op l r site
  | otherwise = untagU32 e (fst (emitExpr e env (CBinPrim op l r tag site)))
emitU32Raw e env (CVar x a) = match omLookup x env
  Some (reg, LTU32U) => reg
  Some (reg, LTI32U) => reg
  Some _ => untagU32 e (fst (emitExpr e env (CVar x a)))
  None => match omLookup x !e.constGlobals
    Some (LInt n) => u32Const n
    _ => untagU32 e (fst (emitExpr e env (CVar x a)))
emitU32Raw e env (CIf c t f) = emitRawIf e env RawU32 c t f
emitU32Raw e env (CBlock stmts) = emitRawBlock e env RawU32 stmts
emitU32Raw e env (CLet False (PVar x a) e1 e2) = match e1
  CLam _ _ => untagU32 e (fst (emitExpr e env (CLet False (PVar x a) e1 e2)))
  _ => emitU32Raw e (bindLetRaw e env x e1 e2) e2
emitU32Raw e env ex = match flattenApp ex []
  (CVar f _, [a]) if isTruncate32 f && not (isLocal env f) =>
    u32TruncateRaw e env a
  (CVar f _, args) =>
    if isLocal env f then
      untagU32 e (fst (emitExpr e env ex))
    else match u32Inline e env f args
      Some (_, pats, body) => emitU32Inlined e env pats body args
      None => match rawWorkerReturning32 e f (lengthS args)
        Some (sym, w) => emitRawWorkerCall e env sym w args
        None => untagU32 e (fst (emitExpr e env ex))
  _ => untagU32 e (fst (emitExpr e env ex))

-- the heads computed as `i32`s.
isW32Head : String -> Bool
isW32Head tag = tag == "U32" || isI32Head tag

-- the kernels that keep an Int's low 32 bits: the same `trunc` for both.
isTruncate32 : String -> Bool
isTruncate32 f = f == "u32Truncate" || f == "i32Truncate"

-- Bind a `let` for the rest of its scope, keeping a statically Float, U64, U32
-- or I32 value in its raw register.
-- `scope` is what the binding is visible in.  Another local's name is an alias
-- and shares that local's register, raw or not.  A U64 is kept as a payload
-- unless it would be boxed more than once in `scope` (`u64Escapes`), where one
-- box at the binding is cheaper.
bindLetRaw : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  OrdMap (String, LTy)
bindLetRaw e env x (CVar y a) _ = match omLookup y env
  Some entry => omInsert x entry env
  None => omInsert x (emitExpr e env (CVar y a)) env
bindLetRaw e env x ex scope =
  if staticIsFloat env ex then
    omInsert x (emitFloatD e env ex, LTFloatU) env
  else if staticIsU64 e env ex && u64Escapes e x False scope <= 1 then
    omInsert x (emitU64Raw e env ex, LTU64U) env
  else
    let k = static32Kind e env ex
    if isRaw32 k then
      omInsert x (emitU32Raw e env ex, w32LocalLTy k) env
    else
      omInsert x (emitExpr e env ex) env

-- `+`, `-` and `*` are the `i32` instructions, which wrap modulo 2^32; `/` and
-- `%` are `udiv`/`urem` for a U32 and `sdiv`/`srem` for an I32 (`signed`), behind
-- Int's zero-divisor abort.
emitU32RawArith : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  String ->
  CExpr ->
  CExpr ->
  Loc ->
  String
emitU32RawArith e env signed op l r site =
  let a = emitU32Raw e env l
  let b = emitU32Raw e env r
  if op == "/" || op == "%" then
    let wide = freshReg e
    let _ = emit e "  \{wide} = zext i32 \{b} to i64"
    let _ = emitDivZeroGuard e op wide site
    emitDivRem e signed "i32" op a b
  else
    let res = freshReg e
    let _ = emit e "  \{res} = \{u64Op op} i32 \{a}, \{b}"
    res

-- `/` or `%` on two raw values of LLVM type `ty` whose divisor is known nonzero.
-- Signed, a divisor of -1 is taken aside: `sdiv`/`srem` of the minimum by -1 is
-- undefined (and traps on x86), and the wrapped answers are `0 - a` and 0, so
-- the instruction divides by 1 there and a `select` gives the answer.
emitDivRem : Emit -> Bool -> String -> String -> String -> String -> String
emitDivRem e signed ty op a b =
  if signed then
    let m1 = freshReg e
    let _ = emit e "  \{m1} = icmp eq \{ty} \{b}, -1"
    let safe = freshReg e
    let _ = emit e "  \{safe} = select i1 \{m1}, \{ty} 1, \{ty} \{b}"
    let q = freshReg e
    let instr = if op == "%" then "srem" else "sdiv"
    let _ = emit e "  \{q} = \{instr} \{ty} \{a}, \{safe}"
    let alt =
      if op == "%" then
        "0"
      else
        let n = freshReg e
        let _ = emit e "  \{n} = sub \{ty} 0, \{a}"
        n
    let res = freshReg e
    let _ = emit e "  \{res} = select i1 \{m1}, \{ty} \{alt}, \{ty} \{q}"
    res
  else
    let res = freshReg e
    let _ = emit e "  \{res} = \{u64Op op} \{ty} \{a}, \{b}"
    res

-- A comparison typecheck stamped `U32`: the unsigned predicate on the `i32`s.
emitU32Cmp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitU32Cmp e env op l r =
  let a = emitU32Raw e env l
  let b = emitU32Raw e env r
  let c = freshReg e
  let _ = emit e "  \{c} = icmp \{u64Pred op} i32 \{a}, \{b}"
  boolFromI1 e c

-- `u32Truncate x` or `i32Truncate x`, the low 32 bits of an Int: the Int is
-- computed untagged (`intRaw`), so a bit operation over `u32ToInt` operands
-- becomes the `i64` operation on zero-extended `i32`s, which LLVM narrows back
-- to `i32`.
u32TruncateRaw : Emit -> OrdMap (String, LTy) -> CExpr -> String
u32TruncateRaw e env x =
  let i = intRaw e env x
  let t = freshReg e
  let _ = emit e "  \{t} = trunc i64 \{i} to i32"
  t

-- The untagged `i64` of an Int-valued expression, looking through `u32ToInt`
-- of a U32, `i32ToInt` of an I32 and the `int` bit primitives' and/or/xor/not,
-- which have no overflow and no domain check.  Anything else is emitted as usual
-- and untagged.
intRaw : Emit -> OrdMap (String, LTy) -> CExpr -> String
intRaw e env x = match flattenApp x []
  (CVar f _, args) =>
    if isLocal env f then
      untagInt e (fst (emitExpr e env x))
    else match (intRawBitOp f, args)
      (Some instr, [a, b]) =>
        let p = intRaw e env a
        let q = intRaw e env b
        let r = freshReg e
        let _ = emit e "  \{r} = \{instr} i64 \{p}, \{q}"
        r
      _ => match (f, args)
        ("u32ToInt", [a]) =>
          let v = emitU32Raw e env a
          let z = freshReg e
          let _ = emit e "  \{z} = zext i32 \{v} to i64"
          z
        ("i32ToInt", [a]) =>
          let v = emitU32Raw e env a
          let z = freshReg e
          let _ = emit e "  \{z} = sext i32 \{v} to i64"
          z
        ("intBitNot", [a]) =>
          let p = intRaw e env a
          let r = freshReg e
          let _ = emit e "  \{r} = xor i64 \{p}, -1"
          r
        _ => untagInt e (fst (emitExpr e env x))
  _ => untagInt e (fst (emitExpr e env x))

intRawBitOp : String -> Option String
intRawBitOp "intBitAnd" = Some "and"
intRawBitOp "intBitOr" = Some "or"
intRawBitOp "intBitXor" = Some "xor"
intRawBitOp _ = None

-- Is `ex` statically a U32 or an I32 that `emitU32Raw` computes on `i32`s, and
-- which?  Arithmetic stamped with either head, a local holding an `i32`, an `if`
-- whose arms agree, `u32Truncate`/`i32Truncate`, a call `u32Inline` inlines, and
-- a call of a worker with an `i32` result.  RawWord when it is neither.
static32Kind : Emit -> OrdMap (String, LTy) -> CExpr -> RawKind
static32Kind _ env (CVar x _) = match omLookup x env
  Some (_, LTU32U) => RawU32
  Some (_, LTI32U) => RawI32
  _ => RawWord
static32Kind _ _ (CBinPrim op _ _ tag _) =
  if isArithOp op then rawKindOfHead32 tag else RawWord
static32Kind e env (CIf _ t f) =
  let k = static32Kind e env t
  if sameRawKind k (static32Kind e env f) then k else RawWord
static32Kind e env ex = match flattenApp ex []
  (CVar f _, args) =>
    if isLocal env f then
      RawWord
    else if isTruncate32 f then
      if lengthS args == 1 then
        if f == "i32Truncate" then RawI32 else RawU32
      else
        RawWord
    else match u32Inline e env f args
      Some (k, _, _) => k
      None => match rawWorkerReturning32 e f (lengthS args)
        Some (_, w) => rawWorkerRet w
        None => RawWord
  _ => RawWord

-- the `i32` kind of a head: RawWord unless it is `U32` or `I32`.
rawKindOfHead32 : String -> RawKind
rawKindOfHead32 tag = if isW32Head tag then rawKindOfHead tag else RawWord

-- The clause to inline for a saturated call of top-level `f`, with the kind of
-- its result: a single clause of plain-variable parameters, a declared `U32` or
-- `I32` result, a body no larger than
-- `inlineBudget` nodes that does not name `f`, and fewer than
-- `inlineDepth` inlinings already open at this site.  Everything such a
-- body does is still emitted by the ordinary paths; only its parameters and
-- its U32 and I32 subexpressions stay in registers.
u32Inline : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  Option (RawKind, List Pat, CExpr)
u32Inline e env f args =
  if isLocal env f || not (inlineRoom e) then
    None
  else
    let name = canonFnName e f
    match omLookup name !e.gDispBindMap
      Some (CBind _ [CClause pats body] _) => match declSigOf e name
        Some (_, rname) =>
          if isW32Head rname
            && lengthS pats == lengthS args
            && hasArgs args
            && allPVar pats
            && leadingDictPats pats == 0
            && not (contains name (freeVars [] body))
            && coreSize body <= inlineBudget then
            Some (rawKindOfHead rname, pats, body)
          else
            None
        _ => None
      _ => None

inlineDepth : Int
inlineDepth = 6

inlineBudget : Int
inlineBudget = 48

-- Inline one call: the arguments are evaluated left to right in the caller
-- (a U32 or I32 argument to its `i32`), bound to the parameters in an env of
-- their own, and the body is computed on `i32`s in that env.
emitU32Inlined : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  CExpr ->
  List CExpr ->
  String
emitU32Inlined e env pats body args =
  let penv = bindInlineArgs e env pats args omEmpty
  withInlineScope e (_ => emitU32Raw e penv body)

-- Emit an inlined callee's body.  The enclosing define's impl context
-- (`curImplTag`/`curSelfFnParams`, keyed by the caller's parameter names) and
-- its TRMC, dispatch-group and self-tail contexts describe the caller, so they
-- are cleared for the body and restored after.  Each outermost inlining site may
-- open at most `inlineSiteBudget` inlinings in all, so a chain of small
-- functions that each call the next several times cannot grow the emitted
-- code exponentially.
withInlineScope : Emit -> (Unit -> a) -> a
withInlineScope e act =
  let tag = !e.curImplTag
  let fns = !e.curSelfFnParams
  let trmc = !e.trmcCtx
  let gd = !e.gDispCtx
  let st = !e.selfTailCtx
  let _ = clearCurImplSelfFns e
  e.trmcCtx := TrmcOff
  e.gDispCtx := GDispOff
  e.selfTailCtx := None
  if !e.inlineOpen == 0 then e.inlineSpent := 0
  e.inlineSpent := !e.inlineSpent + 1
  e.inlineOpen := !e.inlineOpen + 1
  let r = act ()
  e.inlineOpen := !e.inlineOpen - 1
  let _ = setCurImplSelfFns e tag fns
  e.trmcCtx := trmc
  e.gDispCtx := gd
  e.selfTailCtx := st
  r

-- may another inlining open here?
inlineRoom : Emit -> Bool
inlineRoom e =
  !e.inlineOpen < inlineDepth
    && (!e.inlineOpen == 0 || !e.inlineSpent < inlineSiteBudget)

inlineSiteBudget : Int
inlineSiteBudget = 64

bindInlineArgs : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  List CExpr ->
  OrdMap (String, LTy) ->
  OrdMap (String, LTy)
bindInlineArgs e env ((PVar x _) :: ps) (a :: rest) acc =
  bindInlineArgs e env ps rest (omInsert x (emitRawOrWord e env a) acc)
bindInlineArgs _ _ _ _ acc = acc

-- `a`'s value in the register its static type allows: a U64 payload, a U32 or
-- I32 `i32`, a Float `double`, or the word.
emitRawOrWord : Emit -> OrdMap (String, LTy) -> CExpr -> (String, LTy)
emitRawOrWord e env a =
  if staticIsU64 e env a then
    (emitU64Raw e env a, LTU64U)
  else
    let k = static32Kind e env a
    if isRaw32 k then
      (emitU32Raw e env a, w32LocalLTy k)
    else if staticIsFloat env a then
      (emitFloatD e env a, LTFloatU)
    else
      emitExpr e env a

-- The number of Core IR nodes in an expression, counted up to one past the
-- budget.  A node of any shape `coreChildren` does not list (a match, a lambda,
-- a record) counts as over the budget, so its function is never inlined.
coreSize : CExpr -> Int
coreSize ex = coreSizeGo [ex] 0

coreSizeGo : List CExpr -> Int -> Int
coreSizeGo [] n = n
coreSizeGo (x :: rest) n =
  if n > inlineBudget then
    n
  else match coreChildren x
    Some kids => coreSizeGo (kids ++ rest) (n + 1)
    None => inlineBudget + 1

coreChildren : CExpr -> Option (List CExpr)
coreChildren (CLit _) = Some []
coreChildren (CVar _ _) = Some []
coreChildren (CApp f a) = Some [f, a]
coreChildren (CBinPrim _ l r _ _) = Some [l, r]
coreChildren (CUnOp _ x) = Some [x]
coreChildren (CIf c t f) = Some [c, t, f]
coreChildren (CLet _ _ e1 e2) = Some [e1, e2]
coreChildren (CBlock stmts) = Some (stmtExprs stmts)
coreChildren (CIndex a i) = Some [a, i]
coreChildren (CTuple es) = Some es
coreChildren (CMethod _ _ _ _ _ _) = Some []
coreChildren (CDict _ _) = Some []
coreChildren _ = None

stmtExprs : List CStmt -> List CExpr
stmtExprs [] = []
stmtExprs ((CSExpr x) :: rest) = x :: stmtExprs rest
stmtExprs ((CSLet _ _ x) :: rest) = x :: stmtExprs rest
stmtExprs ((CSAssign _ x) :: rest) = x :: stmtExprs rest

-- ── where a raw U64 would be boxed ──────────────────────────────────────────
-- How many occurrences of `x` in `ex` would read a raw U64 held in `x` as a
-- word, which boxes it: every occurrence `emitU64Raw` would not read as a
-- payload.  `raw` says whether `ex` itself is computed as a payload.  It
-- over-counts where it cannot tell (a match, a lambda, a constructor), which
-- only keeps a value boxed.  A worker parameter is held raw only at zero
-- (`rawWorkerOf`), a `let` at one or fewer (`bindLetRaw`).
u64Escapes : Emit -> String -> Bool -> CExpr -> Int
u64Escapes _ x raw (CVar y _) = if y == x && not raw then 1 else 0
u64Escapes _ _ _ (CLit _) = 0
u64Escapes e x _ (CBinPrim op l r tag _) =
  let inner = isBoxed64Head tag && (isArithOp op || isCmpOp op)
  u64Escapes e x inner l + u64Escapes e x inner r
u64Escapes e x raw (CIf c t f) =
  u64Escapes e x False c + u64Escapes e x raw t + u64Escapes e x raw f
u64Escapes e x raw (CLet False (PVar y a) e1 e2) = match e1
  CLam _ _ => occurrencesOf x (CLet False (PVar y a) e1 e2)
  _ =>
    u64Escapes e x (u64Shaped e e1) e1
      + (if y == x then 0 else u64Escapes e x raw e2)
u64Escapes e x raw (CLet False pat e1 e2) =
  u64EscapesBound e x pat e1
    + (if contains x (patVars pat) then 0 else u64Escapes e x raw e2)
u64Escapes e x raw (CBlock stmts) = u64EscapesBlock e x raw stmts
-- a container literal or an access binds nothing, so its parts are read as
-- words (`U64.toIntTruncating x` inside one reads `x` as a payload).
u64Escapes e x _ (CArray es) = u64EscapesWords e x es
u64Escapes e x _ (CTuple es) = u64EscapesWords e x es
u64Escapes e x _ (CList es) = u64EscapesWords e x es
u64Escapes e x _ (CIndex a i) = u64EscapesWords e x [a, i]
u64Escapes e x _ (CUnOp _ a) = u64Escapes e x False a
u64Escapes e x raw ex = match flattenApp ex []
  (CVar f _, args) =>
    if f == x then
      occurrencesOf x ex
    else
      u64EscapesArgs e x (u64ArgRaw e f args) args
  _ => occurrencesOf x ex

u64EscapesBlock : Emit -> String -> Bool -> List CStmt -> Int
u64EscapesBlock e x raw [CSExpr ex] = u64Escapes e x raw ex
u64EscapesBlock e x _ ((CSExpr ex) :: rest) =
  u64Escapes e x False ex + u64EscapesBlock e x False rest
u64EscapesBlock e x raw ((CSLet _ (PVar y a) ex) :: rest) = match ex
  CLam _ _ => occurrencesOf x (CBlock (CSLet False (PVar y a) ex :: rest))
  _ =>
    u64Escapes e x (u64Shaped e ex) ex
      + (if y == x then 0 else u64EscapesBlock e x raw rest)
u64EscapesBlock e x raw ((CSLet _ pat ex) :: rest) =
  u64EscapesBound e x pat ex
    + (if contains x (patVars pat) then 0 else u64EscapesBlock e x raw rest)
u64EscapesBlock e x raw ((CSAssign y ex) :: rest) =
  u64Escapes e x False ex + (if y == x then 0 else u64EscapesBlock e x raw rest)
u64EscapesBlock _ _ _ [] = 0

-- the right side of a destructuring `let`: a call `bindTupleInline` inlines
-- binds each argument in its raw register, anything else is read as a word.
u64EscapesBound : Emit -> String -> Pat -> CExpr -> Int
u64EscapesBound e x (PTuple ps) ex = match flattenApp ex []
  (CVar f _, args) =>
    if allVarOrWild ps && isSome (tupleInline e f args (lengthS ps)) then
      u64EscapesArgs e x (map (_ => True) args) args
    else
      u64Escapes e x False ex
  _ => u64Escapes e x False ex
u64EscapesBound e x _ ex = u64Escapes e x False ex

u64EscapesWords : Emit -> String -> List CExpr -> Int
u64EscapesWords e x es = u64EscapesArgs e x [] es

u64EscapesArgs : Emit -> String -> List Bool -> List CExpr -> Int
u64EscapesArgs e x (r :: rs) (a :: as_) =
  u64Escapes e x r a + u64EscapesArgs e x rs as_
u64EscapesArgs e x [] (a :: as_) =
  u64Escapes e x False a + u64EscapesArgs e x [] as_
u64EscapesArgs _ _ _ [] = 0

-- which arguments of a call of `f` are read as payloads: a kernel's U64
-- operands (directly or through its `u64` wrapper), and a raw worker's U64
-- positions.
u64ArgRaw : Emit -> String -> List CExpr -> List Bool
u64ArgRaw e f args =
  let n = lengthS args
  if f == "u64TruncateToInt" && n == 1 then
    [True]
  else if isW64RawKernel f n then
    u64KernelArgRaw f
  else match u64KernelAlias e f args
    Some k => if k == "u64TruncateToInt" then [True] else u64KernelArgRaw k
    None => match rawWorkerCall e f n
      Some (_, RawWorker _ ks _) => map (k => sameRawKind k RawU64) ks
      None => []

u64KernelArgRaw : String -> List Bool
u64KernelArgRaw "u64Truncate" = [False]
u64KernelArgRaw "i64FromBits" = [True]
u64KernelArgRaw "i64ToBits" = [True]
u64KernelArgRaw "u64ShiftLeft" = [True, False]
u64KernelArgRaw "u64ShiftRight" = [True, False]
u64KernelArgRaw _ = [True, True]

-- is `ex` computed as a payload wherever it is bound (the syntactic half of
-- `staticIsU64`, for the analysis, which has no env)?
u64Shaped : Emit -> CExpr -> Bool
u64Shaped _ (CLit (LU64 _ _)) = True
u64Shaped _ (CVar _ _) = True
u64Shaped _ (CBinPrim op _ _ tag _) = isU64Head tag && isArithOp op
u64Shaped e (CIf _ t f) = u64Shaped e t && u64Shaped e f
u64Shaped e ex = match flattenApp ex []
  (CVar f _, args) =>
    if isU64RawKernel f (lengthS args) then
      True
    else match u64KernelAlias e f args
      Some k => isU64RawKernel k (lengthS args)
      None => isSome (rawWorkerReturning e f (lengthS args) RawU64)
  _ => False

-- every free occurrence of `x` in `ex`.
occurrencesOf : String -> CExpr -> Int
occurrencesOf x ex = lengthS (filterList (== x) (freeVars [] ex))

-- ── a tuple built by a small callee, bound in place ──────────────────────────
-- `let (p1, …, pn) = f a1 … am`, where `f` is a small single-clause function
-- whose body ends in an n-tuple (`U64.mulWide`): the call is inlined and each
-- component bound directly, so no tuple is allocated and a U64 or U32
-- component stays in its raw register.  Evaluation order is the call's: the
-- arguments, the body's leading statements, then the components in order.
bindTupleInline : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  CExpr ->
  Option (OrdMap (String, LTy))
bindTupleInline e env ps ex =
  if not (allVarOrWild ps) then
    None
  else match flattenApp ex []
    (CVar f _, args) =>
      if isLocal env f then
        None
      else match tupleInline e f args (lengthS ps)
        Some (pats, lead, comps) =>
          let penv = bindInlineArgs e env pats args omEmpty
          let vals = withInlineScope e (_ =>
            emitRawOrWords e (emitBlockLeads e penv lead) comps)
          Some (bindTupleVals env ps vals)
        None => None
    _ => None

allVarOrWild : List Pat -> Bool
allVarOrWild [] = True
allVarOrWild ((PVar _ _) :: rest) = allVarOrWild rest
allVarOrWild (PWild :: rest) = allVarOrWild rest
allVarOrWild _ = False

emitRawOrWords : Emit ->
  OrdMap (String, LTy) ->
  List CExpr ->
  List (String, LTy)
emitRawOrWords _ _ [] = []
emitRawOrWords e env (c :: rest) =
  let v = emitRawOrWord e env c
  v :: emitRawOrWords e env rest

emitBlockLeads : Emit ->
  OrdMap (String, LTy) ->
  List CStmt ->
  OrdMap (String, LTy)
emitBlockLeads _ env [] = env
emitBlockLeads e env (s :: rest) =
  emitBlockLeads e (emitBlockLead e env s rest) rest

bindTupleVals : OrdMap (String, LTy) ->
  List Pat ->
  List (String, LTy) ->
  OrdMap (String, LTy)
bindTupleVals env ((PVar x _) :: ps) (v :: vs) =
  bindTupleVals (omInsert x v env) ps vs
bindTupleVals env (_ :: ps) (_ :: vs) = bindTupleVals env ps vs
bindTupleVals env _ _ = env

-- The callee to inline for a destructuring `let` of `n` names: the same limits
-- as `u32Inline`, and a body that is an n-tuple, or a block ending in one.
tupleInline : Emit ->
  String ->
  List CExpr ->
  Int ->
  Option (List Pat, List CStmt, List CExpr)
tupleInline e f args n =
  if not (inlineRoom e) then
    None
  else
    let name = canonFnName e f
    match omLookup name !e.gDispBindMap
      Some (CBind _ [CClause pats body] _) =>
        if lengthS pats == lengthS args
          && hasArgs args
          && allPVar pats
          && leadingDictPats pats == 0
          && not (contains name (freeVars [] body))
          && coreSize body <= inlineBudget then
          map ((lead, comps) => (pats, lead, comps)) (tupleBody body n)
        else
          None
      _ => None

tupleBody : CExpr -> Int -> Option (List CStmt, List CExpr)
tupleBody (CTuple es) n = if lengthS es == n then Some ([], es) else None
tupleBody (CBlock stmts) n = match reverseL stmts
  (CSExpr (CTuple es)) :: lead =>
    if lengthS es == n then Some (reverseL lead, es) else None
  _ => None
tupleBody _ _ = None

-- The kernel a saturated call of top-level `f` amounts to, when `f`'s one clause
-- applies that kernel to its own parameters in order: the `u64` module's
-- `truncate`, `toIntTruncating`, `bitAnd`, `bitOr` and `bitXor` are such
-- wrappers, and code outside the stdlib can only reach the kernels through them.
-- Inlining the kernel lets the call fuse with the U64 arithmetic around it
-- instead of boxing its result in a call.  `shiftLeft`/`shiftRight` refuse a
-- negative amount before applying their kernel, so they are inlined only at a
-- non-negative literal amount, where that refusal cannot fire.
u64KernelAlias : Emit -> String -> List CExpr -> Option String
u64KernelAlias e f args = match omLookup (canonFnName e f) !e.gDispBindMap
  Some (CBind _ [CClause pats body] _) => match paramNames pats
    Some ps =>
      if lengthS ps == lengthS args then u64AliasBody ps body args else None
    None => None
  _ => None

-- the parameter names of an all-variable pattern list.
paramNames : List Pat -> Option (List String)
paramNames [] = Some []
paramNames ((PVar n _) :: rest) = map (n :: _) (paramNames rest)
paramNames _ = None

u64AliasBody : List String -> CExpr -> List CExpr -> Option String
u64AliasBody ps (CIf (CBinPrim "<" (CVar k _) zero _ _) _ body) args = match (
  u64KernelApplied ps (skipOtherwise body),
  ps,
  args,
  intLitOf zero,
)
  (Some kern, [_, amount], [_, lit], Some 0) => match intLitOf lit
    Some n =>
      if isU64ShiftKernel kern && amount == k && n >= 0 then Some kern else None
    None => None
  _ => None
u64AliasBody ps body _ = match u64KernelApplied ps body
  Some kern => if isU64ShiftKernel kern then None else Some kern
  None => None

-- The value of an Int literal as the emitter receives it: bare, or still the
-- `fromInt` application the typechecker routed to `Num Int`.
intLitOf : CExpr -> Option Int
intLitOf (CLit (LInt n)) = Some n
intLitOf (CApp (CMethod "fromInt" _ _ (RKey word _ _) _ _) (CLit (LInt n)))
  | word == numIntWord = Some n
intLitOf _ = None

-- a guard's `| otherwise = e` arm, which lowers to `if otherwise then e else …`.
skipOtherwise : CExpr -> CExpr
skipOtherwise (CIf (CVar o _) b _)
  | o == "otherwise" || o == "core__otherwise" = b
skipOtherwise ex = ex

-- `body` is a kernel applied to exactly the parameters `ps`, in order.
u64KernelApplied : List String -> CExpr -> Option String
u64KernelApplied ps body = match flattenApp body []
  (CVar kern _, xs) =>
    if isU64Extern kern && argsAreParams ps xs then Some kern else None
  _ => None

argsAreParams : List String -> List CExpr -> Bool
argsAreParams [] [] = True
argsAreParams (p :: ps) ((CVar x _) :: xs) = p == x && argsAreParams ps xs
argsAreParams _ _ = False

isU64ShiftKernel : String -> Bool
isU64ShiftKernel k = k == "u64ShiftLeft" || k == "u64ShiftRight"

-- the kernels `emitU64Raw` computes on payloads whose result is a `U64`, at their
-- full arity.
isU64RawKernel : String -> Int -> Bool
isU64RawKernel "u64Truncate" n = n == 1
isU64RawKernel "i64ToBits" n = n == 1
isU64RawKernel f n =
  n == 2
    && contains f [
      "u64BitAnd", "u64BitOr", "u64BitXor", "u64ShiftLeft", "u64ShiftRight",
      "u64MulHigh"
    ]

-- every kernel `emitU64Raw` computes on payloads: the U64-valued ones and
-- `i64FromBits`, whose result is an I64.
isW64RawKernel : String -> Int -> Bool
isW64RawKernel f n = isU64RawKernel f n || f == "i64FromBits" && n == 1

-- A U64 or I64 (`signed`) arithmetic operator on its operands' payloads: `+`,
-- `-` and `*` are the 64-bit instructions, which wrap modulo 2^64; `/` and `%` are
-- `udiv`/`urem` or `sdiv`/`srem` (`emitDivRem`) behind Int's zero-divisor abort.
emitU64RawArith : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  String ->
  CExpr ->
  CExpr ->
  Loc ->
  String
emitU64RawArith e env signed op l r site =
  let a = emitU64Raw e env l
  let b = emitU64Raw e env r
  emitW64Op e signed op a b site

-- the U64 or I64 operator on two payloads; [site] is a zero divisor's trap site.
emitW64Op : Emit -> Bool -> String -> String -> String -> Loc -> String
emitW64Op e signed op a b site =
  if op == "/" || op == "%" then
    let _ = emitDivZeroGuard e op b site
    emitDivRem e signed "i64" op a b
  else
    let res = freshReg e
    let _ = emit e "  \{res} = \{u64Op op} i64 \{a}, \{b}"
    res

-- The kernels on payloads: `u64Truncate` sign-extends the untagged Int, the
-- bitwise kernels are one instruction, the shifts give 0 outside `0 .. 63` by a
-- select, `u64MulHigh` is the top half of the 128-bit product, and the two
-- retypings between `U64` and `I64` are the identity.
emitU64Kernel : Emit -> OrdMap (String, LTy) -> String -> List CExpr -> String
emitU64Kernel e env "u64Truncate" [a] = untagInt e (fst (emitExpr e env a))
emitU64Kernel e env "i64FromBits" [a] = emitU64Raw e env a
emitU64Kernel e env "i64ToBits" [a] = emitU64Raw e env a
emitU64Kernel e env "u64BitAnd" [a, b] = emitU64Bin e env "and" a b
emitU64Kernel e env "u64BitOr" [a, b] = emitU64Bin e env "or" a b
emitU64Kernel e env "u64BitXor" [a, b] = emitU64Bin e env "xor" a b
emitU64Kernel e env "u64ShiftLeft" [a, k] = emitU64Shift e env "shl" a k
emitU64Kernel e env "u64ShiftRight" [a, k] = emitU64Shift e env "lshr" a k
emitU64Kernel e env "u64MulHigh" [a, b] =
  let x = emitU64Raw e env a
  let y = emitU64Raw e env b
  let wa = freshReg e
  let _ = emit e "  \{wa} = zext i64 \{x} to i128"
  let wb = freshReg e
  let _ = emit e "  \{wb} = zext i64 \{y} to i128"
  let p = freshReg e
  let _ = emit e "  \{p} = mul i128 \{wa}, \{wb}"
  let h = freshReg e
  let _ = emit e "  \{h} = lshr i128 \{p}, 64"
  let r = freshReg e
  let _ = emit e "  \{r} = trunc i128 \{h} to i64"
  r
emitU64Kernel _ _ name _ =
  panic ("llvm: U64 kernel " ++ name ++ " applied to the wrong arguments")

-- a bitwise U64 kernel: one instruction on the two payloads.
emitU64Bin : Emit -> OrdMap (String, LTy) -> String -> CExpr -> CExpr -> String
emitU64Bin e env instr a b =
  let x = emitU64Raw e env a
  let y = emitU64Raw e env b
  let r = freshReg e
  let _ = emit e "  \{r} = \{instr} i64 \{x}, \{y}"
  r

-- a logical U64 shift by a tagged Int amount; 0 outside `0 .. 63`.
emitU64Shift : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  String
emitU64Shift e env instr a k =
  let x = emitU64Raw e env a
  let n = untagInt e (fst (emitExpr e env k))
  let inRange = freshReg e
  let _ = emit e "  \{inRange} = icmp ult i64 \{n}, 64"
  let masked = freshReg e
  let _ = emit e "  \{masked} = and i64 \{n}, 63"
  let shifted = freshReg e
  let _ = emit e "  \{shifted} = \{instr} i64 \{x}, \{masked}"
  let r = freshReg e
  let _ = emit e "  \{r} = select i1 \{inRange}, i64 \{shifted}, i64 0"
  r

isHashExtern : String -> Bool
isHashExtern name =
  contains name ["hashInt", "hashChar", "hashBool", "hashFloat", "hashString"]

emitHashExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitHashExtern e env "hashInt" args = match emitArgs e env args
  [a] =>
    let i = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_hash_int(i64 \{i})"
    (tagInt e r, LTInt)
  _ => panic "llvm: hashInt takes one argument"
emitHashExtern e env "hashChar" args = match emitArgs e env args
  [a] =>
    let cp = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_hash_char(i64 \{cp})"
    (tagInt e r, LTInt)
  _ => panic "llvm: hashChar takes one argument"
emitHashExtern e env "hashBool" args = match emitArgs e env args
  [a] =>
    let b = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_hash_bool(i64 \{b})"
    (tagInt e r, LTInt)
  _ => panic "llvm: hashBool takes one argument"
emitHashExtern e env "hashFloat" args = match emitArgs e env args
  [a] =>
    let d = unboxFloat e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_hash_float(double \{d})"
    (tagInt e r, LTInt)
  _ => panic "llvm: hashFloat takes one argument"
emitHashExtern e env "hashString" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_hash_string(i64 \{a})"
    (tagInt e r, LTInt)
  _ => panic "llvm: hashString takes one argument"
emitHashExtern e _ name _ = gapE e ("unsupported hash extern " ++ name)

-- Debug-literal externs (byte-exact quoted/escaped rendering; no oracle change).
-- The String/Char arg word passes straight to the C helper (mdk_debug_*_lit
-- reads the cell / untags the codepoint); result is a heap String (LTStr).
isDebugLitExtern : String -> Bool
isDebugLitExtern name = contains name ["debugStringLit", "debugCharLit"]

emitDebugLitExtern : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitDebugLitExtern e env "debugStringLit" args = match emitArgs e env args
  [a] =>
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_debug_string_lit(i64 \{a})"
    (r, LTStr)
  _ => panic "llvm: debugStringLit takes one argument"
emitDebugLitExtern e env "debugCharLit" args = match emitArgs e env args
  [a] =>
    let cp = untagInt e a
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_debug_char_lit(i64 \{cp})"
    (r, LTStr)
  _ => panic "llvm: debugCharLit takes one argument"
emitDebugLitExtern e _ name _ = gapE e ("unsupported debug-lit extern " ++ name)

-- ── extern dispatch: applied form ───────────────────────────────────────────
-- ONE name-keyed catalog (RUN-EMIT-005 (B) grain (c) / RUN-EMIT-006, #358):
-- each row pairs a family's existing membership predicate with its existing
-- emitter — the per-name clause bodies inside `emitXExtern` stay exactly
-- where they are; only the SELECTION ladder collapses.  `isAnyExtern` and
-- `emitExternApplied` both derive from this one list, so a family can't
-- register in one without the other — no more hand-kept-in-sync OR-chain +
-- if-chain pair.  `arrayMakeWith` has no `isXxx` predicate (exact-name
-- dispatch, its `:10564` signature omits the name param) so it stays a
-- literal pre-check ahead of the table on both sides, exactly as before.
type ExternEmitter = Emit -> OrdMap (String, LTy) -> String -> List CExpr -> (String, LTy)

externCatalog : List (String -> Bool, ExternEmitter)
externCatalog = [
  (isStrExtern, emitStrExtern),
  (isNumExtern, emitNumExtern),
  (isIoExtern, emitIoExtern),
  (isAbortExtern, emitAbortExtern),
  (isArrIntrinsic, emitArrIntrinsic),
  (isArrLeafExtern, emitArrLeafExtern),
  (isByteBlockExtern, emitByteBlockExtern),
  (isCharExtern, emitCharExtern),
  (isStrCharExtern, emitStrCharExtern),
  (isUnicodeExtern, emitUnicodeExtern),
  (isAdtExtern, emitAdtExtern),
  (isEnvExtern, emitEnvExtern),
  (isFileExtern, emitFileExtern),
  (isNetExtern, emitNetExtern),
  (isRngExtern, emitRngExtern),
  (isHashExtern, emitHashExtern),
  (isBitExtern, emitBitExtern),
  (isFixedWidthExtern, emitFixedWidthExtern),
  (isU64Extern, emitU64Extern),
  (isDebugLitExtern, emitDebugLitExtern),
  (isPerfExtern, emitPerfExtern),
]

-- first (and, by the disjointness the catalog assumes, only) row whose
-- predicate accepts `name`.
findExternFamily : String ->
  List (String -> Bool, ExternEmitter) ->
  Option ExternEmitter
findExternFamily _ [] = None
findExternFamily name ((pred, fn) :: rest)
  | pred name = Some fn
  | otherwise = findExternFamily name rest

-- Is `name` a KNOWN extern of any family the emitter handles?  Drives both the
-- saturated CApp head path (emitExternApplied) and the value-position eta-wrap
-- (emitVar → emitExternEtaClosure); keeping the membership in ONE place means
-- the two paths can never disagree about what counts as an extern.
isAnyExtern : String -> Bool
isAnyExtern name =
  name == "arrayMakeWith" || anyList ((pred, _) => pred name) externCatalog

-- SATURATED extern application: route a known extern + its (non-empty) argument
-- list to the right family emitter.  Factored out of emitApp's CVar-head ladder
-- so that the VALUE-position eta-wrap (emitExternEtaClosure) can REPLAY the exact
-- applied-form codegen on synthetic `%argK` operands — value/applied byte-
-- consistency by construction, no parallel codegen to drift.  A name matching
-- no catalog row is out-of-catalog: `gapE` decides loudly (`panic`, `Strict`,
-- every real build) or quietly-recorded (`noteGap`, `Record`, the D4 census
-- scaffold) — the same mode-aware floor the old terminal
-- `else -> emitDebugLitExtern` reached, now explicit instead of borrowed from
-- debugLit's own wildcard clause (RUN-EMIT-006 §5 property 5: debugLit is an
-- ordinary keyed entry now, and the table-lookup miss carries the fallthrough
-- role). Caller guards `hasArgs args`.
emitExternApplied : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitExternApplied e env fname args =
  if fname == "arrayMakeWith" then
    emitArrayMakeWith e env args
  else match findExternFamily fname externCatalog
    Some fn => fn e env fname args
    None => gapE e ("unsupported extern " ++ fname)

-- ── #2074: user-declared FFI externs — the C-ABI lowering ────────────────────
--
-- A USER `extern` is a different kind of thing from the 138 `stdlib/runtime.mdk`
-- builtins above.  A builtin is an INTERNAL name whose codegen this file owns
-- (`externCatalog`), often an intrinsic with no C symbol at all.  A user extern
-- names a FOREIGN symbol this compiler has never seen: the declared name is the
-- C symbol VERBATIM (`call @<name>`, NOT `@mdk_<name>`), and the only contract
-- available is its declared Medaka signature, marshalled per `compiler/FFI-ABI.md`
-- §2.  So it gets its own arm in `emitApp`'s CVar-head ladder — placed AFTER
-- `isAnyExtern` and before `isCtor` — rather than a fourth row in the catalog.
--
-- 🚨 ORDER IS THE BUILTIN-NAME EXEMPTION.  `isAnyExtern` is consulted FIRST in
-- both `emitApp` and `emitVar`, so a local `extern bitAnd : …` redeclaring a
-- catalog name still runs the BUILTIN's codegen — the fact
-- `ffiIsBuiltinExternName` (compiler/types/typecheck.mdk) exempts from slice 1's
-- crossable-set guard.  The index itself is belt AND braces: the mint
-- (`ir.core_ir_lower.ffiExternTypeNames`) subtracts `stdlib/runtime.mdk`'s own
-- extern names, so a runtime extern name that NO `externCatalog` family predicate
-- happens to claim still cannot become a foreign call here.
--
-- 🚨 THE CROSSABLE SET IS NOT REDEFINED HERE.  `ffiCrossableHead` below is the
-- SET OF TYPE-HEAD NAMES that slice 1's `ffiCrossableTy`
-- (compiler/types/typecheck.mdk) accepts — its `ffiCrossableConName` six plus its
-- `Array Int` arm's head — restated in the only vocabulary this file has
-- (`tyHeadName` strings from `declSigTypeNames`, not `Ty`).  It is a
-- CONSISTENCY GUARD, not a second gate: every signature reaching here has already
-- passed `ffiCrossableTy` at check time, so a head this predicate rejects is an
-- internal inconsistency and reports as a loud gap, never a quiet skip.

-- the declared (param type-head names, return type-head name) of a USER extern,
-- or None when `name` is not one.
ffiSigOf : Emit -> String -> Option (List String, String)
ffiSigOf e name = omLookup name e.input.ffiExternIndex

isFfiExtern : Emit -> String -> Bool
isFfiExtern e name = match ffiSigOf e name
  Some _ => True
  None => False

-- declared arity = the arrow count of the declared signature (`Unit` params
-- included: they are real Medaka arguments, they just marshal to nothing).
ffiExternArity : Emit -> String -> Int
ffiExternArity e name = match ffiSigOf e name
  Some (ptys, _) => lengthS ptys
  None => 0

-- The FFI-ABI.md §1 heads, by NAME.  `Array` means `Array Int` and only that:
-- `tyHeadName` erases the element type, which is unambiguous here BECAUSE
-- `ffiCrossableTy` already rejected `Array` of anything else before this
-- signature could reach the emitter.
ffiCrossableHead : String -> Bool
ffiCrossableHead n =
  n == "Int"
    || n == "Float"
    || n == "Bool"
    || n == "Char"
    || n == "String"
    || n == "Unit"
    || n == "Array"
    || isFixedIntHead n

-- The fixed-width integers cross as their C twins (FFI-ABI.md §2.1b): the
-- tagged ones as the narrow C type, with the extension C's ABI expects written
-- as the LLVM attribute so the platform's rule applies, and `U64`/`I64` as the
-- 64-bit payload of their cell.
ffiNarrowTy : String -> Option String
ffiNarrowTy "U8" = Some "i8 zeroext"
ffiNarrowTy "U16" = Some "i16 zeroext"
ffiNarrowTy "U32" = Some "i32 zeroext"
ffiNarrowTy "I32" = Some "i32 signext"
ffiNarrowTy _ = None

-- The bare LLVM type of a narrow head.
ffiNarrowBits : String -> String
ffiNarrowBits "U8" = "i8"
ffiNarrowBits "U16" = "i16"
ffiNarrowBits "U32" = "i32"
ffiNarrowBits "I32" = "i32"
ffiNarrowBits _ = "i64"

-- ── the C types, per FFI-ABI.md §2 ──────────────────────────────────────────
-- §2.1 immediates cross as plain `int64_t` (untagged); §2.2 `Float` crosses as an
-- unboxed `double`, never as the cell pointer; §2.3/§2.4 `String`/`Array Int`
-- cross as a `ptr`.  §2.6 `Unit` has no C type at all — see `ffiValueParams`.
ffiCParamTy : String -> String
ffiCParamTy "Float" = "double"
ffiCParamTy "String" = "ptr"
ffiCParamTy "Array" = "ptr"
ffiCParamTy t = optionOr "i64" (ffiNarrowTy t)

-- A return attribute precedes its type (`zeroext i8`), where a parameter's
-- follows it.
ffiCRetTy : String -> String
ffiCRetTy "Unit" = "void"
ffiCRetTy "Float" = "double"
ffiCRetTy "String" = "ptr"
ffiCRetTy t = match ffiNarrowTy t
  Some _ => "\{ffiNarrowAttr t} \{ffiNarrowBits t}"
  None => "i64"

ffiNarrowAttr : String -> String
ffiNarrowAttr "I32" = "signext"
ffiNarrowAttr _ = "zeroext"

-- §2.6: a `Unit` PARAMETER marshals to nothing — it does not appear in the C
-- call's argument list.  Dropped from the `declare` and the call site alike, by
-- this one function, so the two can never disagree about the C arity.
ffiValueParams : List String -> List String
ffiValueParams [] = []
ffiValueParams ("Unit" :: rest) = ffiValueParams rest
ffiValueParams (t :: rest) = t :: ffiValueParams rest

ffiJoinComma : List String -> String
ffiJoinComma [] = ""
ffiJoinComma [x] = x
ffiJoinComma (x :: rest) = "\{x}, \{ffiJoinComma rest}"

-- One `declare` per user extern, plus the two runtime marshalling helpers, right
-- after the preamble.  ⚠️ EMPTY INDEX ⇒ NOTHING EMITTED: a program with no user
-- extern (every program in the corpus, the compiler itself included) gets
-- byte-identical IR to the pre-#2074 emitter, which is what the emitter gates
-- pin.  Declares are emitted for EVERY declared user extern, called or not — an
-- unused `declare` produces no relocation, so an uncalled extern still links.
emitFfiDeclares : Emit -> Unit
emitFfiDeclares e = match omKeys e.input.ffiExternIndex
  [] => ()
  names =>
    let _ = emit e "declare ptr @mdk_ffi_array_int_out(i64)"
    let _ = emit e "declare void @mdk_ffi_array_int_in(i64, ptr)"
    let _ = emit e "declare i64 @mdk_ffi_str_in(ptr)"
    emitFfiDeclareEach e names

emitFfiDeclareEach : Emit -> List String -> Unit
emitFfiDeclareEach _ [] = ()
emitFfiDeclareEach e (n :: rest) =
  let _ = match ffiSigOf e n
    Some (ptys, rty) =>
      emit
        e
        "declare \{ffiCRetTy rty} @\{n}(\{ffiJoinComma (map ffiCParamTy (ffiValueParams ptys))})"
    None => ()
  emitFfiDeclareEach e rest

-- SATURATED foreign call.  Arguments emit left-to-right exactly as every other
-- call shape does, then each is marshalled per its DECLARED type head — never per
-- the inferred `LTy`, because the declared signature IS the ABI contract and the
-- emitter's structural type guess is not.
emitFfiCall : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitFfiCall e env fname args = match ffiSigOf e fname
  None => gapE e ("not a user-declared extern: " ++ fname)
  Some (ptys, rty) =>
    let argOps = emitArgs e env args
    if lengthS argOps /= lengthS ptys then
      -- Partial / over-application of a foreign symbol.  A C symbol has no arity
      -- cell to curry through, so this is LOUD rather than silently mis-called.
      gapE
        e
        "foreign call '\{fname}' applied to \{intToString (lengthS argOps)} argument(s) but declared with \{intToString (lengthS ptys)} — partial application of an FFI extern is not supported"
    else
      -- Marshal, call, THEN copy back (§2.4, #2164), then hand the result on.
      -- The order is the whole point: a copy-back emitted before the call would
      -- restore the pre-call words over whatever C wrote.
      let (cargs, abufs) = ffiMarshalOut e ptys argOps
      let r = ffiEmitCall e fname rty (ffiJoinComma cargs)
      let _ = ffiArrayCopyBack e abufs
      r

-- Medaka → C, per argument (FFI-ABI.md §2, outbound half).  Returns the rendered
-- `<ctype> <operand>` list for the call instruction, PLUS the §2.4 copy-back
-- worklist: one `(live Medaka array cell operand, outbound buffer pointer)` pair
-- per `Array` parameter, in argument order.
--
-- The pairs are RETURNED rather than recomputed by a second pass, because
-- `ffiArrayIntOut` does not merely name the buffer — it EMITS the out-copy call
-- that creates it, so a parallel pass would emit a second copy per argument.
--
-- ⚠️ EVERY ARM EMITS ITS OWN ARGUMENT BEFORE RECURSING.  The `let`s below are
-- ordered, not incidental: these helpers write instructions into `e` as a side
-- effect, so binding the recursive result first would emit the later arguments'
-- setup ahead of the earlier ones'.
ffiMarshalOut : Emit ->
  List String ->
  List String ->
  (List String, List (String, String))
ffiMarshalOut _ [] _ = ([], [])
ffiMarshalOut _ _ [] = ([], [])
-- §2.6: marshals to nothing.  The argument EXPRESSION was already emitted (by
-- `emitArgs`, above) so its effects still happen; only the operand is dropped.
ffiMarshalOut e ("Unit" :: ts) (_ :: rest) = ffiMarshalOut e ts rest
-- §2.2: the C side receives the unboxed `double`, never the `{header, double}`
-- cell pointer — boxing is a backend-internal representation choice that must not
-- leak across an ABI whose other side has no concept of a Medaka heap cell.
ffiMarshalOut e ("Float" :: ts) (a :: rest) =
  let c = "double " ++ unboxFloat e a
  let (cs, bufs) = ffiMarshalOut e ts rest
  (c :: cs, bufs)
ffiMarshalOut e ("String" :: ts) (a :: rest) =
  let c = "ptr " ++ ffiStrBytes e a
  let (cs, bufs) = ffiMarshalOut e ts rest
  (c :: cs, bufs)
-- §2.4: the outbound copy, and the buffer it allocated joins the copy-back
-- worklist paired with the LIVE cell it was copied from.
ffiMarshalOut e ("Array" :: ts) (a :: rest) =
  let buf = ffiArrayIntOut e a
  let (cs, bufs) = ffiMarshalOut e ts rest
  ("ptr " ++ buf :: cs, (a, buf) :: bufs)
-- §2.1b: a tagged fixed-width value is in its type's range by construction, so
-- narrowing the untagged word to the C type loses nothing; `U64`/`I64` hand C
-- the cell's payload.
ffiMarshalOut e (t :: ts) (a :: rest)
  | isSome (ffiNarrowTy t) =
    let n = freshReg e
    let _ = emit e "  \{n} = trunc i64 \{untagInt e a} to \{ffiNarrowBits t}"
    let c = "\{optionOr "i64" (ffiNarrowTy t)} \{n}"
    let (cs, bufs) = ffiMarshalOut e ts rest
    (c :: cs, bufs)
  | isBoxed64Head t =
    let c = "i64 " ++ unboxU64 e a
    let (cs, bufs) = ffiMarshalOut e ts rest
    (c :: cs, bufs)
-- §2.1: `Int`/`Bool`/`Char` are immediates — `ashr 1` to the plain C scalar.
ffiMarshalOut e (t :: ts) (a :: rest)
  | ffiCrossableHead t =
    let c = "i64 " ++ untagInt e a
    let (cs, bufs) = ffiMarshalOut e ts rest
    (c :: cs, bufs)
  | otherwise =
    let _ =
      gapU
        e
        "non-crossable parameter type '\{t}' reached the FFI lowering (compiler/FFI-ABI.md section 1)"
    ffiMarshalOut e ts rest

-- §2.3 Medaka → C: a BORROWED `const char*` into the String cell's own inline
-- payload — `{i64 tag, i64 byte_len, i64 cp_count, bytes…, '\0'}` (`mdk_str_lit`,
-- runtime/medaka_rt.c), so the bytes start at offset 24 and are NUL-terminated.
-- No copy, no allocation.  ⚠️ §2.5: valid FOR THE DURATION OF THE CALL ONLY —
-- Boehm registers no root for a pointer the C side stashes past its own return.
ffiStrBytes : Emit -> String -> String
ffiStrBytes e v =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{v} to ptr"
  let q = freshReg e
  let _ = emit e "  \{q} = getelementptr i8, ptr \{p}, i64 24"
  q

-- §2.4 Medaka → C: a MANDATORY COPY, never the live cell.  The Medaka array cell
-- is `{i64 count, tagged elem…}` (`mdk_array_make`, runtime/medaka_rt.c) — its
-- elements are TAGGED words, so a raw `int64_t*` view of it would hand C every
-- value doubled-plus-one.  `mdk_ffi_array_int_out` allocates a flat untagged
-- buffer and copies.  The C side gets NO length channel here (§2.4 specifies a
-- flat `int64_t*`); a C function that needs the length takes it as its own
-- explicit `Int` parameter, author-written — see the report's Notes.
ffiArrayIntOut : Emit -> String -> String
ffiArrayIntOut e v =
  let p = freshReg e
  let _ = emit e "  \{p} = call ptr @mdk_ffi_array_int_out(i64 \{v})"
  p

-- §2.4 C → Medaka, the COPY-BACK (#2164).  Emitted AFTER the call instruction,
-- once per `Array` parameter, in argument order.
--
-- 🚨 UNCONDITIONAL, and that is the design, not an oversight.  A Medaka FFI
-- signature has no "in" vs "out" parameter distinction — §2.4 does not
-- distinguish them — so there is nothing to detect: an argument C never wrote to
-- copies back the identical words, a correctness no-op.  Skipping it for
-- arguments that "look" read-only would need the compiler to know a C function's
-- body, which it never does.
--
-- Without this, a C function that fills a caller-allocated array fills the §2.4
-- throwaway buffer and the Medaka array is silently unchanged, at exit 0 — the
-- worst shape of wrong (AGENTS.md [W-QUIETER]).
ffiArrayCopyBack : Emit -> List (String, String) -> Unit
ffiArrayCopyBack _ [] = ()
ffiArrayCopyBack e ((a, buf) :: rest) =
  let _ = emit e "  call void @mdk_ffi_array_int_in(i64 \{a}, ptr \{buf})"
  ffiArrayCopyBack e rest

-- C → Medaka (FFI-ABI.md §2, inbound half) + the call instruction itself.
ffiEmitCall : Emit -> String -> String -> String -> (String, LTy)
-- §2.6: called for effect only; nothing is read from the C return register.
ffiEmitCall e fname "Unit" cargs =
  let _ = emit e "  call void @\{fname}(\{cargs})"
  ("1", LTUnit)
-- §2.2: reboxed into a FRESH `{header, double}` cell on the Medaka side — C never
-- allocates, sees, or owns a Float cell.
ffiEmitCall e fname "Float" cargs =
  let d = freshReg e
  let _ = emit e "  \{d} = call double @\{fname}(\{cargs})"
  (boxFloat e d, LTFloat)
-- §2.3: the copy is MANDATORY, not an optimisation to skip later — Medaka never
-- adopts a C-allocated buffer as a String cell.  `mdk_ffi_str_in` routes through
-- `mdk_str_lit`, the same alloc+memcpy every String-returning builtin uses, and
-- treats a NULL return as "".  Length comes from the NUL terminator, the only
-- channel a single C return value has.
ffiEmitCall e fname "String" cargs =
  let p = freshReg e
  let _ = emit e "  \{p} = call ptr @\{fname}(\{cargs})"
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_ffi_str_in(ptr \{p})"
  (r, LTStr)
-- 🚨 KNOWN GAP, and it is a hole in FFI-ABI.md §2.4 rather than in this code.
-- §2.4's C → Medaka rule is "a C-side `int64_t*` PLUS LENGTH is copied into a
-- fresh cell" — but a C-ABI return carries ONE value, so a plain `Array Int`
-- return has no channel for the length, and copying an unknown number of words is
-- not a thing that can be done correctly.  LOUD, not silent: the outbound
-- direction (§2.4 Medaka → C) is fully implemented above.
--
-- 🚨 THE OUT-PARAMETER SHAPE IS NOW THE ANSWER, AND THIS MESSAGE SAYS SO.  Its
-- history is worth keeping: it originally recommended the out-parameter, that
-- advice was FALSE (S1-6, review round of `ffi-lower-and-link`) because §2.4's
-- outbound copy discarded every write the C side made, and the recommendation
-- was then removed rather than repaired — trading a loud gap for a silent wrong
-- answer is the worse of the two ([W-QUIETER] in reverse), so while the
-- copy-back was missing the honest message was "there is no working shape".
-- #2164 landed the copy-back (`mdk_ffi_array_int_in`, above), so the shape works
-- and the message points at it again.  ⚠️ If the copy-back is ever removed, this
-- sentence must go back to naming NO shape — never leave it recommending one
-- that silently drops the data.
ffiEmitCall e fname "Array" _ =
  gapE
    e
    "foreign call '\{fname}' returns 'Array Int', which has no length channel in a C return value (compiler/FFI-ABI.md section 2.4 specifies pointer PLUS length). Use an OUT-PARAMETER instead: declare the array as a parameter, allocate it on the Medaka side, and have the C side fill it in place — section 2.4 copies the buffer back into your array after the call returns"
-- §2.1 immediates, C → Medaka.  The returned C scalar is re-tagged
-- `(x << 1) | 1`, and the `LTy` follows the DECLARED head so `Bool`/`Char`
-- results print and branch as themselves.
--
-- 🚨 TAGGING ALONE IS NOT ENOUGH FOR `Bool`/`Char` (#2128).  `tagInt` is a
-- faithful re-tag of WHATEVER 63-bit payload C handed back, and for `Int` that
-- is exactly right — every `i64` is a valid `Int`.  `Bool` and `Char` are not
-- like that: their native reps are SUBSETS of the immediate space (§8.1), and a
-- user's C function is under no obligation to stay inside them.  The stdlib
-- predicate externs elsewhere in this file also `tagInt` a raw `r`, but they
-- call OUR OWN C in `runtime/medaka_rt.c`, written to return exactly 0 or 1; a
-- foreign library was never told that contract.  Before this arm normalised,
-- `long long cTruthy(void){ return 42; }` behind `extern cTruthy : Unit ->
-- <FFI "…"> Bool` produced the word 85, which is NEITHER `3` (True) nor `1`
-- (False) — and the two constructs that read a Bool DISAGREED on it: `if`
-- untags and tests `!= 0` (emitIf), so it took the True branch, while `match`
-- compares the immediate word against 3/1 exactly (emitRefutMatch), so it fell
-- off the end into E-NONEXHAUSTIVE-MATCH.  Same program, same value, two
-- answers.  So:
--
--   * `Bool` is NORMALISED, not merely tagged — C's own truthiness rule (0 is
--     false, every other bit pattern is true) is applied at the boundary, which
--     is the convention every C caller already writes to, and the result is one
--     of the exactly two words `if` and `match` both agree about.
--   * `Char` is VALIDATED and TRAPS — see ffiNormalizeChar.
-- §2.1b: a narrow result is read at its C width and extended here, never by
-- trusting the register's upper bits, so it is in its type's range by
-- construction; a `U64` or `I64` result is boxed in its own cell.
ffiEmitCall e fname rty cargs
  | isSome (ffiNarrowTy rty) =
    let r = freshReg e
    let _ = emit e "  \{r} = call \{ffiCRetTy rty} @\{fname}(\{cargs})"
    let x = freshReg e
    let ext = if rty == "I32" then "sext" else "zext"
    let _ = emit e "  \{x} = \{ext} \{ffiNarrowBits rty} \{r} to i64"
    (tagInt e x, LTInt)
  | isU64Head rty =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @\{fname}(\{cargs})"
    (boxU64 e r, LTU64)
  | isI64Head rty =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @\{fname}(\{cargs})"
    (boxI64 e r, LTI64)
  | ffiCrossableHead rty =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @\{fname}(\{cargs})"
    if rty == "Bool" then
      (ffiNormalizeBool e r, LTBool)
    else if rty == "Char" then
      (ffiNormalizeChar e fname r, LTChar)
    else if rty == "Int" then
      (ffiCheckInt e fname r, LTInt)
    else
      (tagInt e r, ffiImmediateLTy rty)
  | otherwise =
    gapE
      e
      "non-crossable return type '\{rty}' reached the FFI lowering (compiler/FFI-ABI.md section 1)"

-- Inbound `Bool`: collapse an arbitrary C `long long` onto the two words the
-- rest of the backend recognises, using C's own truthiness rule.  `icmp ne 0` →
-- `zext` → `tagInt` yields `1` for 0 and `3` for anything else, so `if`'s
-- untag-and-test-nonzero and `match`'s exact-word compare can no longer
-- disagree.  In-range 0/1 round-trips unchanged, so this is a widening of what
-- is handled correctly, never a change to what already worked.
ffiNormalizeBool : Emit -> String -> String
ffiNormalizeBool e r =
  let b = freshReg e
  let _ = emit e "  \{b} = icmp ne i64 \{r}, 0"
  let z = freshReg e
  let _ = emit e "  \{z} = zext i1 \{b} to i64"
  tagInt e z

-- Inbound `Char`: TRAP on an out-of-range codepoint rather than tag it.
--
-- The decision (FFI-ABI.md §2.1, recorded there and not only here): a `Char` has
-- no C-side truthiness convention to normalise onto the way a `Bool` does, and
-- there is no defensible value to substitute — clamping to `charMaxBound` or
-- masking the low bits would invent a codepoint the C function never returned
-- and hand it on at exit 0, which is exactly the silent-wrongness this arm
-- exists to remove (AGENTS.md [W-QUIETER]: making a defect quieter is a severity
-- INCREASE).  FFI-ABI.md §4's "a foreign call cannot fail into Medaka" governs
-- the C function SIGNALLING failure through the effect system; it does not ask
-- the ABI to launder data C has already got wrong, and an abort is not a value
-- threaded back to a caller.
--
-- The predicate is VALIDITY, not merely bounds — the two are not the same set,
-- and reading `charMinBound`/`charMaxBound` as the whole story is what let a
-- surrogate through at exit 0 (review S0-1).  The ONE authority is the runtime's
-- own `mdk_char_from_code` (runtime/medaka_rt.c): valid iff
-- `n >= 0 && n <= 0x10FFFF && !(n >= 0xD800 && n <= 0xDFFF)` — i.e. a Unicode
-- SCALAR value, so the UTF-16 surrogate window 0xD800..0xDFFF (55296..57343) is
-- EXCLUDED even though it sits inside the bounds.  Every other `Char`-producing
-- path in the language agrees (the lexer rejects a surrogate literal;
-- `charFromCode 55296` is `None`), so accepting one here would have made the FFI
-- boundary the single door in the language through which an invalid `Char`
-- reaches `println` as malformed UTF-8, silently.
--
-- Lowered as three unsigned compares combined with `or`/`and` (this emitter is
-- phi-free by design): the low end needs no compare of its own because a
-- negative `long long` reads as a huge unsigned and fails `ult 1114112` the same
-- way an above-max value does.  The abort reuses @mdk_panic (already in the
-- preamble), so no new runtime entry point is needed; it prints
-- `runtime error [E-PANIC]: <msg>` and exits 1.
ffiNormalizeChar : Emit -> String -> String -> String
ffiNormalizeChar e fname r =
  let n = intToString (freshLocal e)
  let okL = "ffichar_ok" ++ n
  let badL = "ffichar_bad" ++ n
  let inRange = freshReg e
  let belowSurr = freshReg e
  let aboveSurr = freshReg e
  let notSurr = freshReg e
  let c = freshReg e
  let _ = emit e "  \{inRange} = icmp ult i64 \{r}, 1114112"
  let _ = emit e "  \{belowSurr} = icmp ult i64 \{r}, 55296"
  let _ = emit e "  \{aboveSurr} = icmp ugt i64 \{r}, 57343"
  let _ = emit e "  \{notSurr} = or i1 \{belowSurr}, \{aboveSurr}"
  let _ = emit e "  \{c} = and i1 \{inRange}, \{notSurr}"
  let _ = emit e "  br i1 \{c}, label %\{okL}, label %\{badL}"
  let _ = emit e (badL ++ ":")
  let (msg, _) =
    emitLit
      e
      (LString
        "foreign call '\{fname}' returned a value that is not a valid Char: a Char must be a Unicode scalar, i.e. in 0..1114111 excluding the UTF-16 surrogates 55296..57343 (compiler/FFI-ABI.md section 2.1); the C function must return a valid Unicode scalar for a 'Char' result")
  let _ = emit e "  call void @mdk_panic(i64 \{msg})"
  let _ = emit e "  unreachable"
  let _ = emit e (okL ++ ":")
  tagInt e r

-- Inbound `Int`: an `int64_t` outside `Int`'s 63 bits would lose its top bit to
-- the tag, a different number at exit 0, so the boundary traps instead, as it
-- does for an invalid `Char`.  The value fits exactly when shifting it left one
-- bit and back reproduces it.  A C function that returns the full `int64_t`
-- range is declared `I64`.
ffiCheckInt : Emit -> String -> String -> String
ffiCheckInt e fname r =
  let n = intToString (freshLocal e)
  let okL = "ffiint_ok" ++ n
  let badL = "ffiint_bad" ++ n
  let t = freshReg e
  let back = freshReg e
  let fits = freshReg e
  let _ = emit e "  \{t} = shl i64 \{r}, 1"
  let _ = emit e "  \{back} = ashr i64 \{t}, 1"
  let _ = emit e "  \{fits} = icmp eq i64 \{back}, \{r}"
  let _ = emit e "  br i1 \{fits}, label %\{okL}, label %\{badL}"
  let _ = emit e (badL ++ ":")
  let (msg, _) =
    emitLit
      e
      (LString
        "foreign call '\{fname}' returned an int64_t outside Int's range -4611686018427387904..4611686018427387903 (compiler/FFI-ABI.md section 2.1a); declare the result I64 to receive the full int64_t range")
  let _ = emit e "  call void @mdk_panic(i64 \{msg})"
  let _ = emit e "  unreachable"
  let _ = emit e (okL ++ ":")
  tagInt e r

ffiImmediateLTy : String -> LTy
ffiImmediateLTy "Bool" = LTBool
ffiImmediateLTy "Char" = LTChar
ffiImmediateLTy _ = LTInt

emitBin : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  Loc ->
  (String, LTy)
emitBin e env op l r tag site
  | isCmpOp op = emitCmp e env op l r tag
  | isArithOp op = emitArith e env op l r tag site
  | op == "::" =
    let (lv, _) = emitExpr e env l
    let (rv, _) = emitExpr e env r
    emitCtorAlloc e "Cons" [lv, rv]
  | op == "++" =
    let (lv, lty) = emitExpr e env l
    let (rv, _) = emitExpr e env r
    let r2 = freshReg e
    match lty
      LTStr =>
        let _ =
          emit e "  \{r2} = call i64 @mdk_string_append(i64 \{lv}, i64 \{rv})"
        (r2, LTStr)
      LTCon =>
        let _ =
          emit e "  \{r2} = call i64 @mdk_list_append(i64 \{lv}, i64 \{rv})"
        (r2, LTCon)
      LTUnknown =>
        let _ = emit e "  \{r2} = call i64 @mdk_append(i64 \{lv}, i64 \{rv})"
        (r2, LTUnknown)
      _ =>
        let _ = emit e "  \{r2} = call i64 @mdk_append(i64 \{lv}, i64 \{rv})"
        (r2, LTUnknown)
  | otherwise = gapE e ("unsupported binary operator '" ++ op ++ "'")
-- LTUnknown: the left operand is itself a runtime-dispatched-append result
-- (a CHAINED `++`, e.g. `a ++ b ++ c`).  Its kind is genuinely unknown — it
-- may be a String OR a list (typecheck.mdk's `freeEffvars` builds `List Int`
-- this way).  Re-route through @mdk_append (NOT a direct @mdk_string_append,
-- which would crash on a list cell), keeping the result LTUnknown so any
-- further chaining stays runtime-dispatched.  Value-identical to the direct
-- path for the string case (mdk_append → mdk_string_append on a String
-- header), so every byte-diff gate is unaffected.

-- E8 (#3 census-B): operand static LTy unknown (E2c/E7 couldn't recover
-- it) — the ~328 scanTriple/splitLines string-builder residual.  Instead
-- of gapE, dispatch at RUNTIME via @mdk_append, which inspects the left
-- cell header (odd => Nil/list; even header==MDK_STR_TAG => string; else
-- => Cons/list) and calls the right append helper.  The result VALUE is
-- always correct.  Result LTy is statically unknowable here, so we tag it
-- LTUnknown (NOT LTStr): LTUnknown follows LTStr at print/`==` sites (the
-- dominant String-builder downstream) but a CHAINED `++` over it re-routes
-- through @mdk_append instead of a direct @mdk_string_append — closing the
-- segfault when the value is actually a list.  emitPrint LTCon already
-- panics on lists, and fixtures project String results through
-- stringLength (a type-forcing String read) so validation is
-- byte-identical and independent of this default.

-- the arithmetic operators the spike lowers to int/float instructions.  `::` and
-- `++` survive lowering as CBinPrim but are NOT arithmetic — they fall to the gap.
isArithOp : String -> Bool
isArithOp op = op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

-- ── float-expression fusion (unboxed double arithmetic) ─────────────────────
-- Float arith/compare otherwise boxes a 16B cell at EVERY intermediate node and
-- round-trips each result through a box even when the parent immediately
-- re-consumes it.  Fusion computes a maximal float-arith subtree in unboxed
-- `double` SSA registers and boxes ONCE at the boundary (and ZERO times when the
-- consumer is a comparison).  Bit-identical results — box/unbox is a pure memory
-- round-trip of the same double.  No ABI change; only the statically-Float path
-- (the polymorphic LTNum path is untouched).

-- shared by `staticIsFloat` and `bodyFloatRet` below (#1201): a var is
-- known-float when its recorded LTy is LTFloat/LTFloatU.
varIsKnownFloat : OrdMap (String, LTy) -> String -> Bool
varIsKnownFloat env x = match omLookup x env
  Some (_, LTFloat) => True
  Some (_, LTFloatU) => True
  _ => False

-- Statically Float?  CONSERVATIVE (no false positives vs emitExpr's emitted LTy):
-- a float literal; a local typed LTFloat; an arith node whose left operand is
-- statically float (arith preserves operand type).  A false negative only loses
-- the optimization (falls to the boxing path); it can never miscompile.
staticIsFloat : OrdMap (String, LTy) -> CExpr -> Bool
staticIsFloat env (CLit (LFloat _)) = True
staticIsFloat env (CVar x _) = varIsKnownFloat env x
staticIsFloat env (CBinPrim op l _ _ _) = isArithOp op && staticIsFloat env l
staticIsFloat env _ = False

-- CONSERVATIVE "does this expression evidently evaluate to a Float?" check, used to
-- record a lambda's return type.  Unlike staticIsFloat (which checks only the LEFT
-- arith operand, for the unbox-fusion fast path) this is SYMMETRIC over arith (a
-- float on EITHER side ⇒ the homogeneous `+`/`-`/`*`/`/` result is float) and
-- descends if/let/block tails.  Only a float LITERAL or a known-float var (capture)
-- makes it True, so it never false-positives a non-float body.
bodyFloatRet : OrdMap (String, LTy) -> CExpr -> Bool
bodyFloatRet env (CLit (LFloat _)) = True
bodyFloatRet env (CVar x _) = varIsKnownFloat env x
bodyFloatRet env (CBinPrim op l r _ _) =
  isArithOp op && (bodyFloatRet env l || bodyFloatRet env r)
bodyFloatRet env (CIf _ t f) = bodyFloatRet env t || bodyFloatRet env f
bodyFloatRet env (CLet _ _ _ b) = bodyFloatRet env b
bodyFloatRet env (CBlock stmts) = blockFloatRet env stmts
bodyFloatRet env _ = False

-- a block evaluates to its LAST statement's value (a trailing CSLet yields Unit).
blockFloatRet : OrdMap (String, LTy) -> List CStmt -> Bool
blockFloatRet _ [] = False
blockFloatRet env [CSExpr e] = bodyFloatRet env e
blockFloatRet _ [_] = False
blockFloatRet env (_ :: rest) = blockFloatRet env rest

-- record a closure word's return type as LTFloat when its body evidently returns a
-- Float (so a saturated indirect call to it types its result LTFloat).
recordFloatRet : Emit -> OrdMap (String, LTy) -> String -> CExpr -> Unit
recordFloatRet e env w body =
  if bodyFloatRet env body then
    e.closureRetTy := (w, LTFloat) :: !e.closureRetTy

-- ── #672: NaN const-fold SIGN parity (run==build on the same box) ────────────
-- clang constant-folds a NaN-producing float op on constant operands (e.g.
-- `fdiv double 0.0, 0.0`) to APFloat's canonical qNaN = +NaN (0x7FF8…), but the
-- runtime `divsd` (native) and the tree-walk interpreter both yield the HOST's NaN —
-- −NaN (0xFFF8…) on x86.  Under the sign-dependent totalOrder (N6, Rust total_cmp)
-- a +NaN sorts/compares/hashes OPPOSITELY to a −NaN, so a literal-folded NaN gave a
-- same-box run≠build divergence (Gt vs Lt / nan-last vs nan-first).  Fix: when a
-- fully-constant float-arith subtree evaluates ON THE EMITTER HOST (a,b are runtime
-- Floats pulled out of the AST, so this runs at emitter runtime — clang cannot fold
-- it — and produces exactly what the same box's runtime/interpreter produce) to a
-- NaN, emit that value's EXACT 64 bits as a `double` hex constant.  clang keeps an
-- explicit 0xFFF8… verbatim through -O2 + inlining (verified) and never re-folds it.
-- Non-NaN constants are left as the plain op: clang folds them to a bit-identical
-- finite/inf value, so there is no divergence and nothing to intercept.  Because the
-- bits are the HOST's, an x86-built binary carries −NaN and an ARM-built one +NaN —
-- each matching its own box; cross-BUILD portability (one binary, two targets) is a
-- separate golden-portability item (#509) and deliberately out of scope here.

-- Host value of a fully-constant float-arith subtree, or None if any leaf is
-- non-constant.  Uses the host's own hardware float ops (bit-identical to runtime).
constFoldFloat : CExpr -> Option Float
constFoldFloat (CLit (LFloat f)) = Some f
constFoldFloat (CBinPrim op l r _ _) = match (
  constFoldFloat l,
  constFoldFloat r,
)
  (Some a, Some b) => hostFloatOp op a b
  _ => None
constFoldFloat _ = None

-- Host float op for the const-fold — each computed with the SAME operation the
-- runtime routes this operator to, so the host fold is bit-identical to what the
-- built program (and the interpreter) produce for the same operands on this box:
-- `+`/`-`/`*`/`/` are the hardware `fadd/fsub/fmul/fdiv`, and `%` is `floatRem`
-- (libm `fmod` == LLVM `frem` == the runtime `mdk_float_rem` == eval's `floatRem`).
-- `%` MUST be folded too: `x % 0.0` is NaN for any finite x, so a constant `frem`
-- is the identical #672 divergence (clang folds `frem 0.0,0.0` to +NaN while the
-- runtime/interp fmod give -NaN) — the libm-call vs single-instruction distinction
-- is irrelevant because both runtime and interp use libm fmod, so the host fmod
-- matches them exactly.  Any other op returns None → normal (non-folded) emission.
hostFloatOp : String -> Float -> Float -> Option Float
hostFloatOp "+" a b = Some (a + b)
hostFloatOp "-" a b = Some (a - b)
hostFloatOp "*" a b = Some (a * b)
hostFloatOp "/" a b = Some (a / b)
hostFloatOp "%" a b = Some (floatRem a b)
hostFloatOp _ _ _ = None

-- If `op l r` is a constant float-arith subtree evaluating to a NaN, that host NaN's
-- exact bits as an LLVM `double` hex constant (`0x…`); else None.  `v /= v` is IEEE
-- NaN-ness (true only for a NaN) and runs on the emitter host, so it observes the
-- host's real NaN, sign included.
constNanFold : String -> CExpr -> CExpr -> Option String
constNanFold op l r =
  if isArithOp op then match (constFoldFloat l, constFoldFloat r)
    (Some a, Some b) => match hostFloatOp op a b
      Some v => if v /= v then Some (floatBitsHex v) else None
      None => None
    _ => None
  else
    None

-- ── #762: NaN-sign fold barrier (run==build on the same box) ────────────────
-- #672 (above) neutralises the case where BOTH operands are emit-time-constant
-- floats: constNanFold computes the NaN on the host and emits its exact bits.  But
-- when an operand is only constant AFTER clang's own optimisations — e.g.
-- `idf 0.0 / idf 0.0` where `idf` is a pure identity clang INLINES — the emitter
-- sees a runtime call, emits a real `fdiv double %a, %b`, and clang then folds the
-- inlined `fdiv 0.0, 0.0` to APFloat's canonical +NaN (0x7FF8…).  The runtime
-- `divsd` and the tree-walk interpreter both yield the host's −NaN (0xFFF8… on
-- x86), and under the sign-dependent totalOrder (N6) a +NaN sorts/compares/hashes
-- OPPOSITELY — a same-box run≠build divergence (#762: compare Gt vs Lt).
--
-- Fix: pass ONE operand of the float op through `llvm.arithmetic.fence.f64`, which
-- returns its argument unchanged but is opaque to the constant folder — so clang
-- can no longer fold the op to a wrong-signed NaN and must keep the runtime
-- instruction, which yields the host NaN sign matching run/eval.  Breaking a single
-- operand's constant-ness is enough: a binary fold needs BOTH operands constant.
--
-- SCOPED so it does NOT defeat ordinary float folding: skipped when BOTH operands
-- are emit-time constants (constNanFold already handles the NaN sub-case, and a
-- non-NaN literal fold is bit-identical to hardware — nothing to defend).  So the
-- only folds it blocks are of operands clang would discover constant by inlining,
-- and for a non-NaN result the runtime op is bit-identical anyway.  `arithmetic.fence`
-- lowers to a no-op, so a genuinely-runtime float op pays ZERO runtime cost — the
-- barrier is a compile-time-only constraint on the folder.
fenceFloatOperand : Emit -> CExpr -> CExpr -> String -> String
fenceFloatOperand e l r ld = match (constFoldFloat l, constFoldFloat r)
  (Some _, Some _) => ld
  _ =>
    let fr = freshReg e
    let _ =
      emit e "  \{fr} = call double @llvm.arithmetic.fence.f64(double \{ld})"
    fr

-- LLVM `double` hex literal of a host Float's exact 64-bit pattern.  floatToBytes64
-- gives 8 big-endian bytes (byte 0 = MSB), so their concatenated hex IS the i64 bit
-- pattern — the form LLVM requires to spell a NaN double constant.
floatBitsHex : Float -> String
floatBitsHex f = "0x" ++ bytesHexBE (floatToBytes64 f) 0

bytesHexBE : Array Int -> Int -> String
bytesHexBE arr i =
  if i >= arrayLength arr then
    ""
  else
    hex2 (arrayGetUnsafe i arr) ++ bytesHexBE arr (i + 1)

-- Emit `ex` as an UNBOXED double register (no heap box).  Recurses through float
-- arith nodes; a non-arith leaf is emitted normally to a word then unboxed once
-- (matching emitArith's existing LTFloat branch, which already unboxes operands on
-- the strength of the left's type).  Only called in statically-Float context.
emitFloatD : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitFloatD e env (CLit (LFloat f)) = ensureFloatDot (floatToString f)
emitFloatD e env (ex@(CBinPrim op l r _ _)) =
  if isArithOp op then match constNanFold op l r
    -- #672: a compile-time-constant NaN → the host's exact NaN bits (a valid
    -- `double` operand), so clang keeps −NaN instead of re-folding to +NaN.
    Some hexC => hexC
    None =>
      let ld = emitFloatD e env l
      let rd = emitFloatD e env r
      let ldf = fenceFloatOperand e l r ld
      let res = freshReg e
      let _ = emit e "  \{res} = \{floatOp op} double \{ldf}, \{rd}"
      res
  else
    emitFloatLeaf e env ex
emitFloatD e env ex = emitFloatLeaf e env ex

emitFloatLeaf : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitFloatLeaf e env ex = match floatFromIntArg ex
  Some a =>
    let (aw, _) = emitExpr e env a
    let i = untagInt e aw
    let r = freshReg e
    let _ = emit e "  \{r} = sitofp i64 \{i} to double"
    r
  None => emitFloatLeafN e env ex

-- a saturated call to a float-fw fn → call its `$fw` (double-ABI) directly (float-pos
-- args as doubles, others i64) and use the returned double — no box/unbox round-trip.
emitFloatLeafN : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitFloatLeafN e env ex = match flattenApp ex []
  (CVar f _, args) => match floatFwHas e f (lengthS args) && not (isLocal env f)
    True =>
      let ops = emitWorkerArgs e env (floatFwFp e f) 0 args
      let r = freshReg e
      let _ = emit e "  \{r} = call double @mdk_\{f}__fw(\{ops})"
      r
    False => emitFloatLeafVar e env ex
  _ => emitFloatLeafVar e env ex

emitFloatLeafVar : Emit -> OrdMap (String, LTy) -> CExpr -> String
emitFloatLeafVar e env ex = match floatVarReg env ex
  Some reg => reg
  None =>
    let (w, _) = emitExpr e env ex
    unboxFloat e w

-- `e.floatFwSet` accessors: does `f` have a `$fw` of arity `n`, and its float positions.
floatFwHas : Emit -> String -> Int -> Bool
floatFwHas e f n = match lookupAssoc f !e.floatFwSet
  Some (ar, _) => ar == n
  None => False

floatFwFp : Emit -> String -> List Int
floatFwFp e f = match lookupAssoc f !e.floatFwSet
  Some (_, fp) => fp
  None => []

-- in a statically-Float context, `intToFloat x` / `fromInt x` (@ Float) is just an
-- int→double conversion: emit `sitofp` directly instead of the extern/impl call's
-- box-then-unbox. Returns the Int arg if `ex` is such a call (head name match, arity 1).
floatFromIntArg : CExpr -> Option CExpr
floatFromIntArg ex = match flattenApp ex []
  (h, a :: []) =>
    if headNameIs h "intToFloat" || headNameIs h "fromInt" then Some a else None
  _ => None

-- #2729 item 3: `Num Int`'s own `fromInt` IS the identity — `stdlib/core.mdk` defines
-- it `fromInt x = x`, on a word that is already a tagged Int — so a SATURATED
-- occurrence routed to that impl emits its argument and nothing else.  The witness is
-- the route's own word, `Num Int`'s (`numIntWord`, the instance emitMethod would
-- call as `@mdk_impl_Int_fromInt`), never the argument's shape: `fromInt` at any other
-- head (`Float`'s intToFloat, a user `impl Num`) is a real conversion and keeps its
-- call.  Empty impl/method dict routes are required rather than assumed — `Num` has no
-- element `requires`, so a non-empty route vector here is some other shape and is left
-- alone.
intFromIntIdentityArg : String ->
  Route ->
  List Route ->
  List Route ->
  List CExpr ->
  Option CExpr
intFromIntIdentityArg "fromInt" (RKey word [] _) [] [] (a :: [])
  | word == numIntWord = Some a
intFromIntIdentityArg _ _ _ _ _ = None

headNameIs : CExpr -> String -> Bool
headNameIs (CVar n _) name = n == name
headNameIs (CMethod n _ _ _ _ _) name = n == name
headNameIs _ _ = False

-- the unboxed-double register for an LTFloatU let-bound CVar (a float-let kept
-- unboxed in the env), else None — then emitFloatLeaf unboxes the boxed word.
floatVarReg : OrdMap (String, LTy) -> CExpr -> Option String
floatVarReg env (CVar x _) = match omLookup x env
  Some (reg, LTFloatU) => Some reg
  _ => None
floatVarReg _ _ = None

-- arithmetic preserves operand type (well-typed: both operands share a type).
-- SHARED-FLOAT-RESIDUAL §3(C): [tag] is the typecheck-stamped scalar type of this
-- arithmetic node ("Float"/"Int"/""; from CBinPrim's RScalar route).  When it is
-- "Float" (fieldNameToLTy → LTFloat) route to the float path even when the
-- structural staticIsFloat can't see through a type-lost operand (e.g. a value
-- bound from a polymorphic HOF, #9) — additive: an absent/non-Float tag falls back
-- to today's structural detection, so the tag only ever ADDS Float knowledge.
scalarTagIsFloat : String -> Bool
scalarTagIsFloat tag = match fieldNameToLTy tag
  Some LTFloat => True
  _ => False

-- #2356: the POSITIVE Int witness — typecheck stamped `RScalar "Int"` on this node
-- because the operand mono ground to concrete `Int` (stampOpRouteVal).  It is a
-- string equality on the stamp and NOT a test on the operands' LTy: `LTInt` is this
-- emitter's default for an operand whose type it could not recover, so keying an
-- inline `icmp` on LTy would order boxed String/Float heap addresses.  An empty or
-- any other tag leaves the comparison on the runtime-discriminated path.
-- A fixed-width head (`U8`/`U16`/`U32`) is a witness too: its value is a tagged
-- Int word held in `0 .. 2^n - 1`, never negative, so the signed word compare
-- orders it exactly as `Int` does; and so is `I32`, held sign-extended.
scalarTagIsInt : String -> Bool
scalarTagIsInt tag = tag == "Int" || isTaggedFixedHead tag

-- [site] is the node's trap site, the location an overflow or zero-divisor abort
-- prints.
emitArith : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  Loc ->
  (String, LTy)
emitArith e env op l r tag site =
  if isBoxed64Head tag then
    emitU64Arith e env (isI64Head tag) op l r site
  else if isW32Head tag then
    let k = rawKindOfHead tag
    (tagW32 e k (emitU32RawArith e env (isI32Head tag) op l r site), LTInt)
  else match fixedWidthMask tag
    Some mask => emitFixedWidthArith e env op l r mask site
    None => emitArithUnsized e env op l r tag site

-- An arithmetic node typecheck stamped `U64` or `I64` (`signed`): both operands
-- are boxed cells, so the stamp is tested before every Float or Int route (a
-- payload read as a double or untagged as an Int is silently wrong).  `+`, `-`
-- and `*` are the 64-bit instructions, which wrap modulo 2^64; `/` and `%` are
-- unsigned or signed behind Int's zero-divisor abort.
emitU64Arith : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  String ->
  CExpr ->
  CExpr ->
  Loc ->
  (String, LTy)
emitU64Arith e env signed op l r site =
  (boxW64 e signed (emitU64RawArith e env signed op l r site), w64LTy signed)

-- the U64 or I64 operator on two already-emitted cell words.
emitU64ArithW : Emit ->
  Bool ->
  String ->
  String ->
  String ->
  Loc ->
  (String, LTy)
emitU64ArithW e signed op lv rv site =
  let a = unboxU64 e lv
  let b = unboxU64 e rv
  (boxW64 e signed (emitW64Op e signed op a b site), w64LTy signed)

-- the LLVM instruction for a U64 arithmetic operator: Int's for the ring
-- operations, the unsigned forms for division and remainder.
u64Op : String -> String
u64Op "/" = "udiv"
u64Op "%" = "urem"
u64Op op = intOp op

-- An arithmetic node typecheck stamped with a fixed-width head: both operands are
-- tagged Int words, so the operand LTys (which may read `LTNum` for a param of a
-- polymorphic-looking body) are not consulted.  `+`, `-` and `*` run the Int
-- instruction and keep the low `n` bits (`and` with `2^n - 1`) before retagging;
-- the 64-bit `mul` wraps modulo 2^64, whose low 32 bits are the true product's.
-- `/` and `%` of two non-negative in-range values are already in range, so they
-- keep Int's lowering, zero-divisor abort included.
emitFixedWidthArith : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  Int ->
  Loc ->
  (String, LTy)
emitFixedWidthArith e env op l r mask site =
  let (lv, _) = emitExpr e env l
  let (rv, _) = emitExpr e env r
  let li = untagInt e lv
  let ri = untagInt e rv
  if op == "/" || op == "%" then
    emitIntDivZeroChecked e op li ri site
  else
    let res = freshReg e
    let _ = emit e "  \{res} = \{intOp op} i64 \{li}, \{ri}"
    let masked = freshReg e
    let _ = emit e "  \{masked} = and i64 \{res}, \{intToString mask}"
    (tagInt e masked, LTInt)

emitArithUnsized : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  Loc ->
  (String, LTy)
emitArithUnsized e env op l r tag site =
  if scalarTagIsFloat tag
    || staticIsFloat env l
    || isFloatFieldAccess e l
    || isFloatFieldAccess e r then
    emitFloatArith e env op l r
  else
    emitArithW e env op l r site

-- True when `ex` is a record field ACCESS of a declared-Float field.  Used ONLY to
-- route arith to the float path (emitFloatArith unboxes the boxed-float field word
-- via emitFloatLeafVar) — `r.dx + r.dy` over Float fields otherwise defaulted both
-- operands to LTInt (emitFieldAccess always returns LTInt) and did INTEGER arith on
-- boxed-float pointers → garbage.  Scoped to the arith ROUTING decision (no change
-- to emitFieldAccess's returned LTy), so field accesses flowing elsewhere — e.g.
-- arg-tag dispatch — keep LTInt and the emitter's own self-compile is unperturbed.
isFloatFieldAccess : Emit -> CExpr -> Bool
isFloatFieldAccess e (CFieldAccess _ label recName) =
  isFloatFieldLabel e recName label
isFloatFieldAccess _ _ = False

isFloatFieldLabel : Emit -> String -> String -> Bool
isFloatFieldLabel e recName label = match floatFieldRecord e recName label
  Some (name, labels) => match indexOfStr label labels
    Some pos =>
      let tns = ctorFieldTypeNamesOf e name
      if pos < listLen tns then nthStr tns pos == "Float" else False
    None => False
  None => False

-- Pick the record owning `label` for float-ness: by the typecheck-stamped name
-- when known + present, else the label-only search (same fallback rule as
-- fieldIdxByName, so an Int/Float collision on the same field name routes float
-- arithmetic by the receiver's actual record).
floatFieldRecord : Emit -> String -> String -> Option (String, List String)
floatFieldRecord e recName label =
  if recName == "" then
    findRecordByLabel e label
  else match recFieldsOfName e recName
    Some labels =>
      if contains label labels then
        Some (recName, labels)
      else
        findRecordByLabel e label
    None => findRecordByLabel e label

-- fused statically-Float arithmetic: both operands as unboxed doubles, one float
-- op, box ONCE (replaces N intermediate boxes with 1).
emitFloatArith : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitFloatArith e env op l r = match constNanFold op l r
  -- #672: box the host's exact NaN bits so clang keeps −NaN (matches runtime/eval on
  -- this box) rather than folding `fdiv 0.0,0.0` to its canonical +NaN.
  Some hexC => (boxFloat e hexC, LTFloat)
  None =>
    let ld = emitFloatD e env l
    let rd = emitFloatD e env r
    let ldf = fenceFloatOperand e l r ld
    let res = freshReg e
    let _ = emit e "  \{res} = \{floatOp op} double \{ldf}, \{rd}"
    (boxFloat e res, LTFloat)

-- the boxing fallback path (left operand not statically float): unchanged from the
-- original emitArith.  Still reached for float values the static check misses (e.g.
-- a float-returning CALL on the left) — its LTFloat branch boxes as before.
emitArithW : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  Loc ->
  (String, LTy)
emitArithW e env op l r site =
  let (lv, lty) = emitExpr e env l
  let (rv, rty) = emitExpr e env r
  match lty
    -- An operand the emitter knows is a U64 or I64 cell, on a node that reached
    -- here without the stamp: its payload, never an Int untag.
    LTU64 => emitU64ArithW e False op lv rv site
    LTI64 => emitU64ArithW e True op lv rv site
    LTFloat =>
      let ld = unboxFloat e lv
      let rd = unboxFloat e rv
      let ldf = fenceFloatOperand e l r ld
      let res = freshReg e
      let _ = emit e "  \{res} = \{floatOp op} double \{ldf}, \{rd}"
      (boxFloat e res, LTFloat)
    LTNum =>
      let res = freshReg e
      let _ = emit e "  \{res} = call i64 @\{numOp op}(i64 \{lv}, i64 \{rv})"
      (res, LTNum)
    _ => match rty
      LTU64 => emitU64ArithW e False op lv rv site
      LTI64 => emitU64ArithW e True op lv rv site
      LTFloat =>
        let ld = unboxFloat e lv
        let rd = unboxFloat e rv
        let ldf = fenceFloatOperand e l r ld
        let res = freshReg e
        let _ = emit e "  \{res} = \{floatOp op} double \{ldf}, \{rd}"
        (boxFloat e res, LTFloat)
      LTNum =>
        let res = freshReg e
        let _ = emit e "  \{res} = call i64 @\{numOp op}(i64 \{lv}, i64 \{rv})"
        (res, LTNum)
      _ => emitIntArithChecked e op lv rv site

-- `Int` arithmetic traps: a result outside -2^62 .. 2^62 - 1 calls
-- @mdk_int_overflow (E-INT-OVERFLOW) instead of wrapping.  `+` and `-` work on
-- the tagged words: (2a+1) + 2b = 2(a+b)+1, so the 64-bit add overflows exactly
-- when the 63-bit sum does and its result is already tagged; `*` multiplies the
-- untagged a by 2b and sets the tag bit.  `/` overflows only at intMinBound / -1,
-- caught by retagging the quotient with an overflow-checked add; `%` never does.
emitIntArithChecked : Emit -> String -> String -> String -> Loc -> (String, LTy)
emitIntArithChecked e op lv rv site =
  if op == "/" || op == "%" then
    let li = untagInt e lv
    let ri = untagInt e rv
    let _ = emitDivZeroGuard e op ri site
    let q = freshReg e
    let _ = emit e "  \{q} = \{intOp op} i64 \{li}, \{ri}"
    if op == "%" then
      (tagInt e q, LTInt)
    else
      (setTagBit e (emitOverflowChecked e "sadd" q q "3" lv rv site), LTInt)
  else
    let r2 = freshReg e
    let _ = emit e "  \{r2} = sub i64 \{rv}, 1"
    match op
      "*" =>
        let li = untagInt e lv
        (setTagBit e (emitOverflowChecked e "smul" li r2 "2" lv rv site), LTInt)
      "+" => (emitOverflowChecked e "sadd" lv r2 "0" lv rv site, LTInt)
      _ => (emitOverflowChecked e "ssub" lv r2 "1" lv rv site, LTInt)

-- an even word with the Int tag bit set: the product 2ab, or the doubled
-- quotient, becomes the tagged 2ab+1.
setTagBit : Emit -> String -> String
setTagBit e w =
  let res = freshReg e
  let _ = emit e "  \{res} = or i64 \{w}, 1"
  res

-- `a <op> b` through llvm.<intrinsic>.with.overflow.i64, yielding the result on
-- the ok label.  On overflow the cold block calls @mdk_int_overflow with the
-- operator code (0 `+`, 1 `-`, 2 `*`, 3 `/`, 4 negation) and the operands,
-- untagged there from the TAGGED words `ta`/`tb` so the hot path pays nothing.
-- [site] reaches only the cold block, as an immediate argument.
emitOverflowChecked : Emit ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  Loc ->
  String
emitOverflowChecked e intrinsic a b code ta tb site =
  let pair = freshReg e
  let _ =
    emit
      e
      "  \{pair} = call { i64, i1 } @llvm.\{intrinsic}.with.overflow.i64(i64 \{a}, i64 \{b})"
  let v = freshReg e
  let _ = emit e "  \{v} = extractvalue { i64, i1 } \{pair}, 0"
  let o = freshReg e
  let _ = emit e "  \{o} = extractvalue { i64, i1 } \{pair}, 1"
  let n = intToString (freshLocal e)
  let ovfL = "intovf" ++ n
  let okL = "intok" ++ n
  let _ = emit e "  br i1 \{o}, label %\{ovfL}, label %\{okL}"
  let _ = emit e (ovfL ++ ":")
  let ua = untagInt e ta
  let ub = untagInt e tb
  let _ =
    emitTrapCall
      e
      "mdk_int_overflow"
      "i64 \{code}, i64 \{ua}, i64 \{ub}"
      (siteImm e site)
  let _ = emit e "  unreachable"
  let _ = emit e (okL ++ ":")
  v

-- Integer `/` or `%`: guard the divisor against zero before the hardware
-- sdiv/srem.  A zero divisor is UB in LLVM (the div is elided / yields garbage
-- and the program silently exits 0), so branch to a runtime abort
-- (@mdk_div_zero / @mdk_mod_zero: prints `runtime error [E-DIV-ZERO]` /
-- `[E-MOD-ZERO]` to stderr, exits nonzero), matching the interpreter's evalArith
-- guard, located at the node's trap site (`emitTrapCall`).  On a nonzero divisor the ok-branch runs the original sdiv/srem
-- unchanged, so valid-division output is byte-identical.  The fixed-width types'
-- `/` and `%` use it as is: two non-negative in-range operands never overflow.
emitIntDivZeroChecked : Emit ->
  String ->
  String ->
  String ->
  Loc ->
  (String, LTy)
emitIntDivZeroChecked e op li ri site =
  let _ = emitDivZeroGuard e op ri site
  let res = freshReg e
  let _ = emit e "  \{res} = \{intOp op} i64 \{li}, \{ri}"
  (tagInt e res, LTInt)
-- The zero-divisor branch of `/` or `%` on the raw divisor `ri`: the abort block,
-- then the ok label the caller's instruction is emitted under.  Shared by Int's
-- `sdiv`/`srem` and U64's `udiv`/`urem`, so both abort with the same message.
emitDivZeroGuard : Emit -> String -> String -> Loc -> Unit
emitDivZeroGuard e op ri site =
  let z = freshReg e
  let _ = emit e "  \{z} = icmp eq i64 \{ri}, 0"
  let n = intToString (freshLocal e)
  let zeroL = "divzero" ++ n
  let okL = "divok" ++ n
  let _ = emit e "  br i1 \{z}, label %\{zeroL}, label %\{okL}"
  let _ = emit e (zeroL ++ ":")
  let abortFn = if op == "%" then "mdk_mod_zero" else "mdk_div_zero"
  let _ = emitTrapCall e abortFn "" (siteImm e site)
  let _ = emit e "  unreachable"
  emit e (okL ++ ":")

-- ── trap sites ──────────────────────────────────────────────────────────────
-- A located trap calls the `_at` twin of its runtime abort with one more
-- argument, the packed site `(file + 1) << 44 | line << 20 | col` (16, 24 and
-- 20 bits), where `file` numbers the program's `@mdk_site_files` table.  The
-- runtime prints `file:line:col: ` before the abort's own line.  A site of 0
-- means no location and calls the plain abort, so an unlocated program's IR is
-- what it was.

-- The packed site of [l], or "0" when [l] names no file, is the placeholder span,
-- or does not fit its fields.  The prelude half defines no table of its own.
siteImm : Emit -> Loc -> String
siteImm e l = intToString (sitePacked e l)

sitePacked : Emit -> Loc -> Int
sitePacked e (Loc f sl sc el ec)
  | f == "" || sl == 1 && sc == 0 && el == 1 && ec == 0 = 0
  | e.input.emitHalf == emitHalfPrelude = 0
  | sl < 0 || sl >= 16777216 || sc < 0 || sc >= 1048576 = 0
  | otherwise = match siteFileNumber e f
    Some n => n * 17592186044416 + sl * 1048576 + sc
    None => 0

-- A trap-site literal (`siteSentinelName` applied to a file, a line and a
-- column) is the packed site as an Int word, 0 when it does not pack.
emitSiteLiteral : Emit -> List CExpr -> (String, LTy)
emitSiteLiteral e args = match siteLiteralLocOf args
  Some l => emitLit e (LInt (sitePacked e l))
  None => gapE e "a trap-site literal takes a file, a line and a column"

-- the site a trap-site literal names, if [x] is one.
siteLiteralLoc : CExpr -> Option Loc
siteLiteralLoc x = match flattenApp x []
  (CVar v _, args) =>
    if v == siteSentinelName then siteLiteralLocOf args else None
  _ => None

siteLiteralLocOf : List CExpr -> Option Loc
siteLiteralLocOf [CLit (LString f), CLit (LInt line), CLit (LInt col)] =
  Some (Loc f line col line (col + 1))
siteLiteralLocOf _ = None

-- [f]'s 1-based number in the site file table, assigned on first use; None once
-- the 16-bit field is full.
siteFileNumber : Emit -> String -> Option Int
siteFileNumber e f = match omLookup f !e.siteFileNums
  Some n => Some n
  None =>
    let n = omSize !e.siteFileNums + 1
    if n >= 65536 then
      None
    else
      e.siteFileNums := omInsert f n !e.siteFileNums
      e.siteFiles := f :: !e.siteFiles
      Some n

-- `call void @<fn>(<args>)`, or its `_at` twin with the packed [site] appended
-- when the site is located.
emitTrapCall : Emit -> String -> String -> String -> Unit
emitTrapCall e fn args site
  | site == "0" = emit e "  call void @\{fn}(\{args})"
  | otherwise =
    let _ =
      if contains fn !e.siteTraps then () else e.siteTraps := fn :: !e.siteTraps
    let sep = if args == "" then "" else ", "
    emit e "  call void @\{fn}_at(\{args}\{sep}i64 \{site})"

-- The `declare` of each `_at` twin the program calls.  They go ahead of the
-- preamble, so every partition sees them.
siteTrapDeclares : Emit -> List String
siteTrapDeclares e = map siteTrapDeclare (reverseL !e.siteTraps)

siteTrapDeclare : String -> String
siteTrapDeclare "mdk_int_overflow" =
  "declare void @mdk_int_overflow_at(i64, i64, i64, i64) noreturn"
siteTrapDeclare "mdk_panic" = "declare void @mdk_panic_at(i64, i64) noreturn"
siteTrapDeclare "mdk_oob_at" = "declare void @mdk_oob_at_at(i64, i64) noreturn"
siteTrapDeclare fn = "declare void @\{fn}_at(i64) noreturn"

-- The site file table, a NULL-terminated array of the files' paths behind the
-- `mdk_site_files` pointer the runtime reads (a weak null there when a program
-- defines none).  Nothing when no located trap was emitted.
siteFileTable : Emit -> List String
siteFileTable e = match reverseL !e.siteFiles
  [] => []
  files =>
    let n = listLen files
    ["; mdk-module \{scopeProgram}"]
      ++ siteFileStrings 0 files
      ++ [
        "@.sitefiles = private unnamed_addr constant [\{intToString (n + 1)} x ptr] [\{siteFileElems 0 n}ptr null]",
        "@mdk_site_files = constant ptr @.sitefiles",
      ]

-- the table's first [n] elements, from [i], each followed by ", ".
siteFileElems : Int -> Int -> String
siteFileElems i n
  | i >= n = ""
  | otherwise = "ptr @.sitef.\{intToString i}, \{siteFileElems (i + 1) n}"

siteFileStrings : Int -> List String -> List String
siteFileStrings _ [] = []
siteFileStrings i (f :: rest) =
  let bytes = strBytes f
  let line =
    "@.sitef.\{intToString i} = private unnamed_addr constant [\{intToString (lengthS bytes + 1)} x i8] c\"\{escBytes bytes}\\00\""
  line :: siteFileStrings (i + 1) rest

-- A decision tree's miss: the abort its site names, then `unreachable`.
emitFailTrap : Emit -> FailSite -> Unit
emitFailTrap e (NoArm l) =
  let _ = emitTrapCall e "mdk_nonexhaustive_match" "" (siteImm e l)
  emit e "  unreachable"
emitFailTrap e (LetRefuted l) =
  let _ = emitTrapCall e "mdk_let_refute" "" (siteImm e l)
  emit e "  unreachable"

-- G3: a POLYMORPHIC Num operand (declared type-var param) — could be Int OR
-- Float at runtime.  Route through the runtime tag-dispatched @mdk_num_* helper
-- (low-bit discriminator), keeping the result LTNum so a chained `Num` op and
-- the polymorphic print site stay runtime-dispatched.  An LTNum on EITHER side
-- propagates (the other operand shares the type by well-typing).

-- comparison always yields a Bool word; dispatch the compare on operand type.
emitCmp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  (String, LTy)
emitCmp e env op l r tag =
  if isBoxed64Head tag then
    emitU64Cmp e env (isI64Head tag) op l r
  else if tag == "U32" then
    emitU32Cmp e env op l r
  else if scalarTagIsInt tag then
    emitIntCmp e env op l r
  else if staticIsFloat env l then
    emitFloatCmp e env op l r
  else
    emitCmpW e env op l r

-- #2356: a comparison typecheck GROUNDED to `Int`.  Both operands are tagged Int
-- words (`w = 2n+1`, emitted by tagInt), and that tagging is strictly monotonic on
-- the 63-bit payload, so the signed predicate on the tagged words answers exactly
-- what the untagged payloads would — no untag, no @mdk_value_eq/@mdk_value_lt call,
-- and no opaque callee for LLVM to re-establish the tag invariant around.  Reached
-- ONLY through scalarTagIsInt, never through an LTy default.
emitIntCmp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitIntCmp e env op l r =
  let (lv, _) = emitExpr e env l
  let (rv, _) = emitExpr e env r
  let c = freshReg e
  let _ = emit e "  \{c} = icmp \{intPred op} i64 \{lv}, \{rv}"
  boolFromI1 e c

-- A comparison typecheck stamped `U64` or `I64` (`signed`): the unsigned or
-- signed predicate on the two payloads, so a U64 at or above 2^63 orders above
-- every smaller one and an I64 there below zero.  Tested before the Float and
-- type-lost routes, as the arithmetic stamp is.
emitU64Cmp : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitU64Cmp e env signed op l r =
  let a = emitU64Raw e env l
  let b = emitU64Raw e env r
  let c = freshReg e
  let _ = emit e "  \{c} = icmp \{w64Pred signed op} i64 \{a}, \{b}"
  boolFromI1 e c

-- the U64 or I64 comparison on two already-emitted cell words.
emitU64CmpW : Emit -> Bool -> String -> String -> String -> (String, LTy)
emitU64CmpW e signed op lv rv =
  let a = unboxU64 e lv
  let b = unboxU64 e rv
  let c = freshReg e
  let _ = emit e "  \{c} = icmp \{w64Pred signed op} i64 \{a}, \{b}"
  boolFromI1 e c

-- the `icmp` predicate of a comparison operator, signed or unsigned.
w64Pred : Bool -> String -> String
w64Pred signed op = if signed then intPred op else u64Pred op

-- the unsigned `icmp` predicate for a comparison operator.
u64Pred : String -> String
u64Pred "==" = "eq"
u64Pred "/=" = "ne"
u64Pred "<" = "ult"
u64Pred "<=" = "ule"
u64Pred ">" = "ugt"
u64Pred ">=" = "uge"
u64Pred op = panic ("llvm: unsupported U64 comparison " ++ op)

-- fused statically-Float comparison: operands as unboxed doubles, fcmp, NO box.
emitFloatCmp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitFloatCmp e env op l r =
  let ld = emitFloatD e env l
  let rd = emitFloatD e env r
  let c = freshReg e
  let _ = emit e "  \{c} = fcmp \{floatPred op} double \{ld}, \{rd}"
  boolFromI1 e c

emitCmpW : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitCmpW e env op l r =
  let (lv, lty) = emitExpr e env l
  let (rv, rty) = emitExpr e env r
  if (isLTUnknown lty || isLTUnknown rty) && isEqOp op then
    emitValueEq e op lv rv
  else if isStrLTy lty || isStrLTy rty then
    emitStrCmp e op lv rv
  else if isU64LTy lty || isU64LTy rty then
    emitU64CmpW e False op lv rv
  else if isI64LTy lty || isI64LTy rty then
    emitU64CmpW e True op lv rv
  else match lty
    LTFloat =>
      let ld = unboxFloat e lv
      let rd = unboxFloat e rv
      let c = freshReg e
      let _ = emit e "  \{c} = fcmp \{floatPred op} double \{ld}, \{rd}"
      boolFromI1 e c
    LTInt =>
      if isEqOp op then emitValueEq e op lv rv else emitValueCmp e op lv rv
    -- Same split as LTInt: `==`/`/=` are @mdk_value_eq's job, ordering is
    -- emitValueCmp's.  (This arm USED to send BOTH to the 3-way, where `==`
    -- worked only incidentally — `icmp eq raw, 0` ⟺ "compare said EQ" — and
    -- inherited the 3-way's NaN collapse, so a Float reaching here compared
    -- `nan == nan` as True.  @mdk_value_eq's `da == db` is IEEE. #305)
    _ => if isEqOp op then emitValueEq e op lv rv else emitValueCmp e op lv rv
-- A boxed-string operand (EITHER side — a `""` literal forces it even when the
-- other side's static LTy wasn't inferred to LTStr) routes `==`/`/=` through
-- @mdk_string_eq; pointer identity (the integer arm) is WRONG for string cells.
-- An LTUnknown operand (chained-`++` result) could be a String OR a list, so
-- for `==`/`/=` route through @mdk_value_eq (runtime String/word discriminator)
-- rather than @mdk_string_eq, which would crash reading a list cell as a String.

-- Unknown static type (LTInt default — could be Int/Bool/Char OR a boxed
-- String/Float the emitter couldn't recover, e.g. `k <= k2` where `k`/`k2`
-- were bound through a TUPLE destructure inside a recursive list walk, losing
-- their `(String,String)` component type → both default to LTInt): an integer
-- `icmp` then compares boxed-String/Float POINTERS as ints — pointer-identity
-- (heap-ADDRESS) ordering, and so WRONG.  Route BOTH equality AND ordering
-- through the runtime discriminators: `==`/`/=` via @mdk_value_eq, `<`/`>`/…
-- via the per-op IEEE predicates @mdk_value_lt/le/gt/ge (Float cell → direct f64
-- predicate, #305; String cell → byte compare; immediate → word compare, the
-- latter two over the shared 3-way @mdk_value_cmp_raw), mirroring mdk_append's runtime
-- String/List discrimination.  This is the ordering analog of the @mdk_value_eq
-- precedent — concrete-Int ordering also routes through the runtime helper
-- (as concrete-Int `==` already does), staying correct and uniform.
--
-- An `if`-EXPRESSION (not a guarded `LTInt if isEqOp op` arm) keeps this
-- function self-compilable: the gap-tolerant bootstrap emitter cannot lower a
-- guarded match arm.  IR is byte-identical to the guarded form.

-- ordering (`<`/`>`/`<=`/`>=`) of two operands of statically-unknown kind via the
-- runtime per-op IEEE predicates @mdk_value_lt/le/gt/ge (note at emitCmp), which
-- return a TAGGED Bool directly — no `icmp … , 0` step.
--
-- #305 (S0): this USED to call the three-way @mdk_value_cmp_raw and then `icmp
-- <intPred op> raw, 0`.  That is wrong at Float+NaN: a -1/0/1 Ordering
-- STRUCTURALLY CANNOT express NaN's unorderedness, so the runtime's Float arm
-- collapsed an unordered pair to 0 (EQ) and `nan <= nan` read as `0 <= 0` = True
-- — while `run` (eval) and the static-Float path (`fcmp ole`, #288) both said
-- False.  EMITTER-SEMANTICS §4 N5/N6: the four relational ops at Float are
-- PRIMITIVE IEEE predicates on EVERY path and are never derived from `compare`.
-- The runtime helpers take the boxed-Float arm themselves (plain f64 compare —
-- False at NaN, matching inline `fcmp`) and fall back to the 3-way only for the
-- String/immediate shapes, where -1/0/1 is exact.
emitValueCmp : Emit -> String -> String -> String -> (String, LTy)
emitValueCmp e op lv rv =
  let r = freshReg e
  let _ =
    emit
      e
      "  \{r} = call i64 @mdk_value_\{valueRelName op}(i64 \{lv}, i64 \{rv})"
  (r, LTBool)

-- The @mdk_value_* suffix for an ordering op.  Only `<`/`>`/`<=`/`>=` reach
-- emitValueCmp — emitCmpW routes `==`/`/=` to emitValueEq before it.
valueRelName : String -> String
valueRelName "<" = "lt"
valueRelName ">" = "gt"
valueRelName "<=" = "le"
valueRelName ">=" = "ge"
valueRelName op = panic ("llvm: unsupported value ordering op " ++ op)

-- equality of two operands of statically-unknown kind via the runtime
-- discriminator (note at emitCmp).  `==` returns @mdk_value_eq's tagged Bool
-- directly; `/=` flips 3<->1 with `xor … 2` (same shape as emitStrCmp).
emitValueEq : Emit -> String -> String -> String -> (String, LTy)
emitValueEq e op lv rv
  | op == "==" =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_value_eq(i64 \{lv}, i64 \{rv})"
    (r, LTBool)
  | otherwise =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_value_eq(i64 \{lv}, i64 \{rv})"
    let n = freshReg e
    let _ = emit e "  \{n} = xor i64 \{r}, 2"
    (n, LTBool)

isEqOp : String -> Bool
isEqOp op = op == "==" || op == "/="

isStrLTy : LTy -> Bool
isStrLTy LTStr = True
-- LTUnknown (chained-`++` result) follows LTStr for `==`/`/=`: route through the
-- runtime string/value discriminator rather than a pointer-identity icmp.
isStrLTy LTUnknown = True
isStrLTy _ = False

isU64LTy : LTy -> Bool
isU64LTy LTU64 = True
isU64LTy _ = False

isI64LTy : LTy -> Bool
isI64LTy LTI64 = True
isI64LTy _ = False

isLTUnknown : LTy -> Bool
isLTUnknown LTUnknown = True
isLTUnknown _ = False

-- String `==`/`/=`: pointer identity is WRONG for boxed string cells, so route
-- content equality through @mdk_string_eq (the same helper the pattern-match
-- literal path uses, returning a TAGGED Bool word 3/1).  `==` returns it directly;
-- `/=` flips 3<->1 via `xor … 2`.  Ordering ops (`<`/`>`/`<=`/`>=`) on strings
-- route through @mdk_string_compare_raw, which returns a PLAIN -1/0/1 i64; the
-- operator then becomes `icmp <intPred op> raw, 0` (e.g. `a < b` ⟺ `cmp < 0`),
-- reusing intPred's slt/sgt/sle/sge and boolFromI1.  (Self-compile C2 exercises
-- this: the native emitter's own sanitizeId/safeChar do String `<`/`<=` at emit
-- time; a pointer `icmp` there mis-mangled module names.)
emitStrCmp : Emit -> String -> String -> String -> (String, LTy)
emitStrCmp e op lv rv
  | op == "==" =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_eq(i64 \{lv}, i64 \{rv})"
    (r, LTBool)
  | op == "/=" =
    let r = freshReg e
    let _ = emit e "  \{r} = call i64 @mdk_string_eq(i64 \{lv}, i64 \{rv})"
    let n = freshReg e
    let _ = emit e "  \{n} = xor i64 \{r}, 2"
    (n, LTBool)
  | otherwise =
    let cmp = freshReg e
    let _ =
      emit e "  \{cmp} = call i64 @mdk_string_compare_raw(i64 \{lv}, i64 \{rv})"
    let c = freshReg e
    let _ = emit e "  \{c} = icmp \{intPred op} i64 \{cmp}, 0"
    boolFromI1 e c

-- an i1 (from icmp/fcmp) -> a Bool word (zext to i64, then tag as immediate int).
boolFromI1 : Emit -> String -> (String, LTy)
boolFromI1 e c =
  let z = freshReg e
  let _ = emit e "  \{z} = zext i1 \{c} to i64"
  (tagInt e z, LTBool)

emitUn : Emit -> OrdMap (String, LTy) -> String -> CExpr -> (String, LTy)
emitUn e env "-" x =
  let (v, ty) = emitExpr e env x
  match ty
    LTFloat =>
      let d = unboxFloat e v
      let r = freshReg e
      let _ = emit e "  \{r} = fneg double \{d}"
      (boxFloat e r, LTFloat)
    -- Typecheck routes a U64 or I64 `-x` through `negate`, so such an operand
    -- arrives here only on a path that lost that routing; two's complement,
    -- never an untag.
    LTU64 => emitW64Neg e False v
    LTI64 => emitW64Neg e True v
    -- Int negation traps at intMinBound, whose negation is 2^62.  On the tagged
    -- word, 2 - (2a+1) = 2(-a)+1, which overflows exactly there.
    _ => (emitOverflowChecked e "ssub" "2" v "4" v "1" noDeclLoc, LTInt)
emitUn e _ op _ = gapE e ("unsupported unary op " ++ op)

emitW64Neg : Emit -> Bool -> String -> (String, LTy)
emitW64Neg e signed v =
  let x = unboxU64 e v
  let r = freshReg e
  let _ = emit e "  \{r} = sub i64 0, \{x}"
  (boxW64 e signed r, w64LTy signed)

-- `if`: lower via an alloca slot (memory, not phi) so a branch's own internal
-- control flow never has to be threaded into a phi's incoming-block list — the
-- simplest correct lowering for a spike (clang -O0 keeps the alloca; mem2reg
-- would promote it under -O).  Both arms share a type; report the then-arm's.
emitIf : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitIf e env c t f =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "then" ++ n
  let elseL = "else" ++ n
  let endL = "end" ++ n
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let (tv, tty) = emitExpr e env t
  let _ = emit e "  store i64 \{tv}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (elseL ++ ":")
  let (fv, _) = emitExpr e env f
  let _ = emit e "  store i64 \{fv}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  (r, tty)

emitLet : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  Pat ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitLet e env recF pat e1 e2 =
  if letBinds recF pat e1 then
    emitExpr e (bindLet e env recF pat e1 e2) e2
  else
    gapE
      e
      "unsupported let (only non-recursive let var/_/tuple = e, or function-let)"

-- the `let` shapes `bindLet` lowers: every non-recursive pattern, and a recursive
-- `let` only when it binds a function.
letBinds : Bool -> Pat -> CExpr -> Bool
letBinds False _ _ = True
letBinds True (PVar _ _) (CLam _ _) = True
letBinds True _ _ = False

-- emit a `let pat = e1`'s binding and return the env `e2` (its scope) sees.
-- Callers gate on `letBinds`.  Shared by the value path (`emitLet`) and the
-- tail-position descents (`emitFnBody`, `emitSelfTailArm`), so a let emits the
-- same instructions whether or not its body is in tail position.
bindLet : Emit ->
  OrdMap (String, LTy) ->
  Bool ->
  Pat ->
  CExpr ->
  CExpr ->
  OrdMap (String, LTy)
bindLet e env False (PVar x _) e1 e2 = bindLetRaw e env x e1 e2
bindLet e env False PWild e1 _ =
  let _ = emitExpr e env e1
  env
bindLet e env False (PTuple ps) e1 e2 = match bindTupleInline e env ps e1
  Some env2 => env2
  None =>
    let (v, _) = emitExpr e env e1
    bindPattern e env (PTuple ps) v e2
-- a recursive (function-`let`) closure: `let f p… = … in e2` lowers to
-- CLet True (PVar f) (CLam …).  The lambda's own name `f` is the
-- closure itself, so it is EXCLUDED from the capture set at the alloc site and
-- bound to `%clos` (the leading closure pointer) inside the lifted define — a
-- recursive self-call re-enters the same code with the same cell.  Non-recursive
-- function-lets take the same path harmlessly (`f` simply never appears free).
bindLet e env True (PVar f _) (CLam pats body) _ =
  let (w, ty) = emitRecLam e env f pats body
  omInsert f (w, ty) env
-- P0-2c: general expression-level `let pat = e1 in e2` for a non-recursive,
-- non-(var/wild/tuple) pattern (PCon/PCons/PList/PAs) — the expression-position
-- analog of emitBlock's general CSLet arms.  Mirrors them: an irrefutable head
-- (single-ctor PCon) destructures unchecked (bindPattern); a refutable head
-- (sibling ctors, list) gets the trap-on-miss check (emitRefutableCsLet), matching
-- the interpreter's blockLet "E-LET-REFUTE" panic.  Placed after the
-- PVar/PWild/PTuple and recursive-function arms so those stay byte-identical.
bindLet e env False pat e1 e2 =
  let (v, _) = emitExpr e env e1
  if refutableCsLet e pat then
    emitRefutableCsLet e env pat v
  else
    bindPattern e env pat v e2
bindLet e env _ _ _ _ =
  gapEnv
    e
    "unsupported let (only non-recursive let var/_/tuple = e, or function-let)"
    env

-- a `let`/`where` group.  Bindings emit one at a time, left-to-right, threading
-- the growing env, so a later binding sees the earlier ones (and the body sees
-- all).  Two binding shapes:
--   • `CBind name [CClause [] rhs]` — a nullary VALUE binding: emit the
--     rhs, bind the word, recurse.
--   • `CBind name clauses` with non-empty params (a LOCAL FUNCTION, possibly
--     multi-clause / self-recursive — the `go`/`step`/`g` workers core.mdk writes
--     with `where`): lambda-lift it into a (self-recursive) closure via
--     `emitGroupBind` and bind its closure word, then recurse.
-- A binding that forward/mutually references a LATER sibling can't be lifted
-- one-at-a-time — the referent's closure word isn't allocated when this binding's
-- captures are taken.  When that happens the maximal contiguous run of LOCAL
-- FUNCTION bindings starting here is KNOT-TIED together (`emitLetGroupKnot`): all
-- their closure cells are allocated up front (so every sibling word exists), every
-- sibling name is bound in the env, and each cell's capture fields are then
-- back-patched with the now-available sibling words (and any enclosing-scope
-- captures).  References to EARLIER siblings, self-references (bound to `%clos`),
-- arbitrary forward refs and true mutual recursion all emit correctly.  A value
-- binding interleaved INSIDE such a run (a mutual ref crossing a non-function
-- sibling) is the residue this scheme doesn't cover — it is rejected precisely
-- (`letGroupGap`) rather than miscompiled.
emitLetGroup : Emit ->
  OrdMap (String, LTy) ->
  List CBind ->
  CExpr ->
  (String, LTy)
emitLetGroup e env binds body = match bindLetGroup e env binds body
  Some env2 => emitExpr e env2 body
  None => letGroupGap e

-- emit a `let`/`where` group's bindings (see `emitLetGroup`) and return the env
-- `body` sees, or None at the knot-tying residue, whose gap the caller reports
-- with `letGroupGap` after the bindings before it are emitted.  `body` is read
-- only for `satOnlyUses`; it is not emitted.  Shared by the value path and the
-- tail-position descents (`emitFnBody`, `emitSelfTailArm`), so a group emits the
-- same instructions whether or not its body is in tail position.
bindLetGroup : Emit ->
  OrdMap (String, LTy) ->
  List CBind ->
  CExpr ->
  Option (OrdMap (String, LTy))
bindLetGroup _ env [] _ = Some env
bindLetGroup e env ((CBind name [CClause [] rhs] _) :: rest) body =
  let (v, ty) = emitExpr e env rhs
  bindLetGroup e (omInsert name (v, ty) env) rest body
bindLetGroup e env ((CBind name clauses site) :: rest) body
  | refsLater name clauses (bindNames rest) =
    emitKnotRun e env (CBind name clauses site :: rest) body
  | otherwise =
    -- The region this binding is in scope over is exactly the rest of the group
    -- plus the body, i.e. `CLetGroup rest body`.  When every occurrence of `name`
    -- there is the head of an application of exactly its arity, its call sites
    -- may skip the closure's code_ptr load (`e.directFn`).
    let direct = satOnlyUses name (clauseArityC clauses) (CLetGroup rest body)
    let (w, ty) = emitGroupBind e env (CBind name clauses site) direct
    bindLetGroup e (omInsert name (w, ty) env) rest body

letGroupGap : Emit -> (String, LTy)
letGroupGap e =
  gapE
    e
    "unsupported let-group: a binding forward/mutually references a later value binding (knot-tying covers only mutual function bindings)"

-- knot-tie the maximal leading run of function bindings of `binds`, then continue
-- the group with the remainder.  A forward/mutual ref crossing into a LATER value
-- binding (outside the run) is the uncovered residue: None, emitting nothing.
emitKnotRun : Emit ->
  OrdMap (String, LTy) ->
  List CBind ->
  CExpr ->
  Option (OrdMap (String, LTy))
emitKnotRun e env binds body =
  let run = takeFnRun binds
  let after = dropS (lengthS run) binds
  let runNames = bindNames run
  if anyRefsOutsideRun run runNames (bindNames after) then
    None
  else
    let env2 = emitLetGroupKnot e env run runNames
    bindLetGroup e env2 after body

-- the maximal leading run of LOCAL FUNCTION bindings (non-empty params) — a nullary
-- VALUE binding (`CBind _ [CClause [] _]`) ends the run.
takeFnRun : List CBind -> List CBind
takeFnRun [] = []
takeFnRun ((CBind _ [CClause [] _] _) :: _) = []
takeFnRun (b :: rest) = b :: takeFnRun rest

dropS : Int -> List a -> List a
dropS _ [] = []
dropS n (x :: xs) = if n <= 0 then x :: xs else dropS (n - 1) xs

-- True if any binding in the run references a name bound LATER but OUTSIDE the run
-- (i.e. a later value binding) — the case knot-tying cannot tie.
anyRefsOutsideRun : List CBind -> List String -> List String -> Bool
anyRefsOutsideRun [] _ _ = False
anyRefsOutsideRun ((CBind name clauses _) :: rest) runNames laterOutside
  | anyInList (dedupS (clausesFreeVars name clauses)) laterOutside = True
  | otherwise = anyRefsOutsideRun rest runNames laterOutside
anyRefsOutsideRun (_ :: rest) runNames laterOutside =
  anyRefsOutsideRun rest runNames laterOutside

-- True when any clause of a local-function binding references a sibling bound
-- LATER in the same group (a forward or mutually-recursive reference whose
-- closure word is not yet available at this binding's capture site).  Self- and
-- param-bound names are excluded by `clausesFreeVars`.
refsLater : String -> List CClause -> List String -> Bool
refsLater name clauses laterNames =
  anyInList (dedupS (clausesFreeVars name clauses)) laterNames

-- the free variables across ALL clauses of a binding, with the self name and each
-- clause's own parameter variables treated as bound.
clausesFreeVars : String -> List CClause -> List String
clausesFreeVars _ [] = []
clausesFreeVars self ((CClause pats body) :: rest) =
  freeVars (self :: patVarNames pats) body ++ clausesFreeVars self rest

anyInList : List String -> List String -> Bool
anyInList [] _ = False
anyInList (x :: xs) ys = if contains x ys then True else anyInList xs ys

-- lambda-lift a LOCAL FUNCTION binding from a `let`/`where` group into a (possibly
-- self-recursive) closure.  Captures are the free variables across all clauses
-- present in the emit env, MINUS the binding's own name (it is the closure cell
-- itself, bound to `%clos` inside the lift — a self-call re-enters the same cell).
-- The lifted body reuses the E1a decision-tree path (`emitClauseTree`), so a
-- multi-clause worker or a patterned param lowers exactly as a top-level fn does.
-- `direct` says the caller's use analysis proved every occurrence of `name` in
-- the binding's scope is a saturated application head; the cell is built either
-- way, and the flag only registers it as a direct-call target (`e.directFn`).
emitGroupBind : Emit -> OrdMap (String, LTy) -> CBind -> Bool -> (String, LTy)
emitGroupBind e env (CBind name clauses site) direct =
  let lamName = "mdk_lam" ++ mangleScoped e
  let arity = clauseArity (clauseList clauses)
  let captured =
    keepInEnv env (removeStr name (dedupS (clausesFreeVars name clauses)))
  let captureWords = capWords e env captured
  let _ = emitGroupBindDefine e env lamName name arity clauses captured site
  let (w, ty) = match captureWords
    -- S-1: capture-free ⇒ every cell field is a compile-time constant, so hoist the
    -- cell to an `internal constant` module global instead of allocating a fresh one
    -- on every entry to the enclosing function (emitConstClosureA).  This is the
    -- non-mutual path only — `emitLetGroup` routes forward/mutual runs to
    -- `emitLetGroupKnot`, whose cells are back-patched and must stay heap cells (F9).
    [] => emitConstClosureA e lamName arity
    _ => emitClosureAllocA e lamName arity captureWords
  let _ = if direct then e.directFn := (w, (lamName, arity)) :: !e.directFn
  (w, ty)

-- ── the direct-call use analysis (`e.directFn`'s admission test) ────────────
-- True when EVERY free occurrence of `name` in `ex` is the head of an application
-- spine applied to exactly `arity` arguments.  A bare occurrence in ANY other
-- position — passed as an argument, returned, stored in a data structure, the
-- scrutinee of a match, partially applied, over-applied — is a first-class use of
-- the closure VALUE and answers False, which keeps that binding's call sites on
-- the unchanged indirect path.
--
-- Every binder that rebinds `name` (a lambda/let/clause/arm/statement pattern, a
-- nested group binding) makes the subtree it covers irrelevant to THIS binding, so
-- the walk answers True for it rather than descending.  That is a convenience,
-- not the shadow-safety argument: safety comes from `e.directFn` being keyed by
-- the closure cell word, so a shadowed call site cannot reach an outer entry
-- whatever this walk concludes.
--
-- The catch-all answers False, so a CExpr constructor added later disables the
-- optimization inside it rather than silently claiming the name does not escape
-- there.
satOnlyUses : String -> Int -> CExpr -> Bool
satOnlyUses _ _ (CLit _) = True
satOnlyUses name _ (CVar x _) = x /= name
satOnlyUses name arity (CApp f a) =
  let (hd, args) = flattenApp (CApp f a) []
  match hd
    CVar n _ =>
      if n == name && lengthS args /= arity then
        False
      else
        satOnlyList name arity args
    _ => satOnlyUses name arity hd && satOnlyList name arity args
satOnlyUses name arity (CLam ps b) =
  contains name (patVarNames ps) || satOnlyUses name arity b
satOnlyUses name arity (CLet recF pat e1 e2) =
  let shadow = contains name (patVars pat)
  let ok1 =
    if recF then
      shadow || satOnlyUses name arity e1
    else
      satOnlyUses name arity e1
  ok1 && (shadow || satOnlyUses name arity e2)
satOnlyUses name arity (CLetGroup binds b) =
  contains name (bindNames binds)
    || satOnlyBinds name arity binds && satOnlyUses name arity b
satOnlyUses name arity (CMatch scrut arms) =
  satOnlyUses name arity scrut && satOnlyArms name arity arms
satOnlyUses name arity (CDecision scrut arms _) =
  satOnlyUses name arity scrut && satOnlyArms name arity arms
satOnlyUses name arity (CIf c t f) =
  satOnlyUses name arity c
    && satOnlyUses name arity t
    && satOnlyUses name arity f
satOnlyUses name arity (CBinPrim _ l r _ _) =
  satOnlyUses name arity l && satOnlyUses name arity r
satOnlyUses name arity (CUnOp _ x) = satOnlyUses name arity x
satOnlyUses name arity (CTuple es) = satOnlyList name arity es
satOnlyUses name arity (CList es) = satOnlyList name arity es
satOnlyUses name arity (CArray es) = satOnlyList name arity es
satOnlyUses name arity (CRangeList lo hi _) =
  satOnlyUses name arity lo && satOnlyUses name arity hi
satOnlyUses name arity (CRangeArray lo hi _) =
  satOnlyUses name arity lo && satOnlyUses name arity hi
satOnlyUses name arity (CRecord _ fields) = satOnlyFields name arity fields
satOnlyUses name arity (CFieldAccess ex _ _) = satOnlyUses name arity ex
satOnlyUses name arity (CRecordUpdate _ base updates) =
  satOnlyUses name arity base && satOnlyFields name arity updates
satOnlyUses name arity (CVariantUpdate _ base updates) =
  satOnlyUses name arity base && satOnlyFields name arity updates
satOnlyUses name arity (CIndex a i) =
  satOnlyUses name arity a && satOnlyUses name arity i
satOnlyUses name arity (CStringIndex a i) =
  satOnlyUses name arity a && satOnlyUses name arity i
satOnlyUses name arity (CListIndex a i) =
  satOnlyUses name arity a && satOnlyUses name arity i
satOnlyUses name arity (CSlice a lo hi _) =
  satOnlyUses name arity a
    && satOnlyUses name arity lo
    && satOnlyUses name arity hi
satOnlyUses name arity (CStringSlice a lo hi _) =
  satOnlyUses name arity a
    && satOnlyUses name arity lo
    && satOnlyUses name arity hi
satOnlyUses name arity (CListSlice a lo hi _) =
  satOnlyUses name arity a
    && satOnlyUses name arity lo
    && satOnlyUses name arity hi
satOnlyUses name arity (CBlock stmts) = satOnlyStmts name arity stmts
-- a dict/method occurrence names its captured dict PARAMS, never a local
-- function binding — but read them anyway rather than assume it.
satOnlyUses name _ (CMethod _ _ _ route implRoutes methRoutes) =
  not (contains name (routeDictNames [] (route :: implRoutes ++ methRoutes)))
satOnlyUses name _ (CDict _ routes) =
  not (contains name (routeDictNames [] routes))
satOnlyUses _ _ _ = False

satOnlyList : String -> Int -> List CExpr -> Bool
satOnlyList _ _ [] = True
satOnlyList name arity (x :: rest) =
  satOnlyUses name arity x && satOnlyList name arity rest

satOnlyFields : String -> Int -> List CField -> Bool
satOnlyFields _ _ [] = True
satOnlyFields name arity ((CField _ ex) :: rest) =
  satOnlyUses name arity ex && satOnlyFields name arity rest

satOnlyArms : String -> Int -> List CArm -> Bool
satOnlyArms _ _ [] = True
satOnlyArms name arity ((CArm pat guards b) :: rest) =
  let shadow = contains name (patVars pat)
  satOnlyGuards name arity guards
    && (shadow || satOnlyUses name arity b)
    && satOnlyArms name arity rest

satOnlyGuards : String -> Int -> List CGuard -> Bool
satOnlyGuards _ _ [] = True
satOnlyGuards name arity ((CGBool ex) :: rest) =
  satOnlyUses name arity ex && satOnlyGuards name arity rest
satOnlyGuards name arity ((CGBind _ ex) :: rest) =
  satOnlyUses name arity ex && satOnlyGuards name arity rest

satOnlyStmts : String -> Int -> List CStmt -> Bool
satOnlyStmts _ _ [] = True
satOnlyStmts name arity ((CSExpr ex) :: rest) =
  satOnlyUses name arity ex && satOnlyStmts name arity rest
satOnlyStmts name arity ((CSLet _ pat ex) :: rest) =
  satOnlyUses name arity ex
    && (contains name (patVars pat) || satOnlyStmts name arity rest)
-- an assignment TO the name would replace the value its call sites resolve to.
satOnlyStmts name arity ((CSAssign target ex) :: rest) =
  target /= name && satOnlyUses name arity ex && satOnlyStmts name arity rest

-- every clause body of a nested group's bindings, with that clause's parameter
-- patterns treated as shadowing binders.
satOnlyBinds : String -> Int -> List CBind -> Bool
satOnlyBinds _ _ [] = True
satOnlyBinds name arity ((CBind _ clauses _) :: rest) =
  satOnlyClauses name arity clauses && satOnlyBinds name arity rest

satOnlyClauses : String -> Int -> List CClause -> Bool
satOnlyClauses _ _ [] = True
satOnlyClauses name arity ((CClause pats b) :: rest) =
  (contains name (patVarNames pats) || satOnlyUses name arity b)
    && satOnlyClauses name arity rest

-- emit the lifted multi-clause `define` for a let-group local function into the
-- SIDE buffer (same swap discipline as emitPatLamDefine).  Captures load from
-- `%clos` fields 1.., the self name binds to `%clos` (recursive self-call
-- re-enters the same cell), and `emitClauseTree` lowers the clauses over the
-- `%argK` words (arity ≥1 here — nullary values take the fast path above).
emitGroupBindDefine : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  Int ->
  List CClause ->
  List String ->
  Loc ->
  Unit
emitGroupBindDefine e env lamName name arity clauses captured site =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ =
    emit e "define i64 @\{lamName}(i64 %clos, \{implParamDecls arity 0}) {"
  let _ = emit e "entry:"
  let cenv = loadCaptures e env captured 0
  let _ =
    emitClauseTree
      e
      (envMergeL
        (omInsert name ("%clos", LTClosure) cenv)
        (implParamEnv arity 0))
      arity
      (clauseList clauses)
      ""
      site
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved
-- A lifted define is a FRESH function: its clause chain's last-clause
-- fallthrough must be @mdk_oob (non-exhaustive abort), NOT the enclosing
-- function's leftover next-clause label.  Without this the lifted `go`'s final
-- clause would `br label %clauseN` to a block defined in the PARENT function —
-- invalid LLVM once functions are concatenated in the multi-module output
-- (issue #53).  Hence the explicit "" outer argument to emitClauseTree — which since
-- issue #354 is a parameter, so a fresh define states its own contract instead of
-- depending on nulling ambient state.

clauseList : List CClause -> List (List Pat, CExpr)
clauseList [] = []
clauseList ((CClause pats body) :: rest) = (pats, body) :: clauseList rest

-- ── knot-tying: forward/mutual local function bindings ──────────────────────
-- Tie the knot for a RUN of mutually/forward-referencing local function bindings
-- (E5 residual / EMITTER-GAPS #10).  Two passes over the run:
--   1. ALLOC: for each fn binding, lambda-lift it (the lifted `@mdk_lamN` define is
--      independent of the cells — captures load from `%clos` fields by index), then
--      allocate its closure cell with the code pointer in field 0 and PLACEHOLDER
--      `0` words in the capture fields (`emitClosureAllocPatch` returns the raw cell
--      pointer for later stores).  Every sibling name is bound to its cell word.
--   2. PATCH: now that every sibling word exists, store each cell's REAL capture
--      words — looked up in the fully-knotted env (siblings + enclosing scope) — into
--      its capture fields.  This BY-VALUE back-patch ties arbitrary mutual recursion
--      and forward references; self-recursion still flows through `%clos`.
-- The capture-NAME list per binding is computed against a sibling env (so a sibling
-- ref is kept by `keepInEnv` and indexed correctly), and must MATCH the field order
-- the lifted define's `loadCaptures` reads — both walk the same `captured` list.
emitLetGroupKnot : Emit ->
  OrdMap (String, LTy) ->
  List CBind ->
  List String ->
  OrdMap (String, LTy)
emitLetGroupKnot e env run runNames =
  let cellEnv = sibPlaceholderEnv runNames env
  let (cells, env2) = knotAlloc e env cellEnv run
  let _ = knotPatch e env2 cells
  env2
-- pass 2: back-patch each cell's capture fields with real words from env2.

-- shadow-insert a placeholder env entry per run name (word "0", LTClosure) over
-- `env`, for capture-name computation only — siblings shadow the same name in the
-- enclosing scope, matching the old `sibEnv ++ env` first-match-wins concat.
sibPlaceholderEnv : List String -> OrdMap (String, LTy) -> OrdMap (String, LTy)
sibPlaceholderEnv [] env = env
sibPlaceholderEnv (n :: rest) env =
  sibPlaceholderEnv rest (omInsert n ("0", LTClosure) env)

-- a knot cell records the binding name, its allocated cell POINTER (for stores),
-- and its ordered capture-name list (matching the lifted define's field layout).
data KnotCell = KnotCell String String (List String)

-- pass 1: for each fn binding, lift it and alloc its closure cell with placeholder
-- captures; thread the env binding each cell word.  `cellEnv` (siblings + outer)
-- is used to compute the capture NAME set so a sibling ref is kept and indexed.
knotAlloc : Emit ->
  OrdMap (String, LTy) ->
  OrdMap (String, LTy) ->
  List CBind ->
  (List KnotCell, OrdMap (String, LTy))
knotAlloc _ env _ [] = ([], env)
knotAlloc e env cellEnv ((CBind name clauses site) :: rest) =
  let lamName = "mdk_lam" ++ mangleScoped e
  let arity = clauseArity (clauseList clauses)
  let captured =
    keepInEnv cellEnv (removeStr name (dedupS (clausesFreeVars name clauses)))
  let _ = emitGroupBindDefine e cellEnv lamName name arity clauses captured site
  let (cellPtr, cellWord) =
    emitClosureAllocPatch e lamName arity (lengthS captured)
  let (cells, env2) =
    knotAlloc e (omInsert name (cellWord, LTClosure) env) cellEnv rest
  (KnotCell name cellPtr captured :: cells, env2)
knotAlloc e env cellEnv (_ :: rest) = knotAlloc e env cellEnv rest

-- pass 2: store each cell's real capture words (from the fully-bound env) into its
-- capture fields (offset 8*(i+1), field 0 holds the code pointer).
knotPatch : Emit -> OrdMap (String, LTy) -> List KnotCell -> Unit
knotPatch _ _ [] = ()
knotPatch e env ((KnotCell _ cellPtr captureNames) :: rest) =
  let words = capWords e env captureNames
  let _ = storeFields e cellPtr words 1
  knotPatch e env rest

-- allocate a closure cell with the code pointer in field 0 and `nCap` PLACEHOLDER
-- zero capture words, returning BOTH the raw cell pointer (for later stores) and
-- the cell word (the closure value).  Mirrors emitClosureAlloc/emitCtorAlloc's
-- layout exactly — field 0 = code_ptr — so the cell is callable immediately
-- (`emitIndirect` loads field 0); only the capture fields await back-patch.
emitClosureAllocPatch : Emit -> String -> Int -> Int -> (String, String)
emitClosureAllocPatch e lamName callArity nCap =
  let codePtr = "ptrtoint (ptr @" ++ lamName ++ " to i64)"
  let fields = codePtr :: zeroWords nCap
  let nFields = lengthS fields
  let p = freshReg e
  let _ =
    emit
      e
      "  \{p} = call ptr @mdk_alloc(i64 \{intToString (8 * (nFields + 1))})"
  let _ = emit e "  store i64 \{intToString callArity}, ptr \{p}"
  let _ = storeFields e p fields 0
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (p, w)

zeroWords : Int -> List String
zeroWords n = if n <= 0 then [] else "0" :: zeroWords (n - 1)

emitBlock : Emit -> OrdMap (String, LTy) -> List CStmt -> (String, LTy)
emitBlock e env [s] = emitBlockLast e env s
emitBlock e env (s :: rest) = emitBlock e (emitBlockLead e env s rest) rest
emitBlock e _ [] = gapE e "empty block"

-- The last statement of a block, which is its value.
emitBlockLast : Emit -> OrdMap (String, LTy) -> CStmt -> (String, LTy)
emitBlockLast e env (CSExpr ex) = emitExpr e env ex
-- last-position block-let `[let pat = e]`: mirror cevalBlock's cBlockLetLast
-- (core_ir_eval :265/:277) — evaluate `e` (for effect + to honour the binding),
-- destructure, and the block yields Unit.  A refutable pattern still gets the
-- trap-on-miss check (P0-2c).  Every block-let shape reaches this arm when it
-- ends the block (#1741).
emitBlockLast e env (CSLet _ pat ex) =
  let (v, _) = emitExpr e env ex
  let _ =
    if refutableCsLet e pat then
      let _ = emitRefutableCsLet e env pat v
      env
    else
      bindPattern e env pat v (CLit (LInt 0))
  ("1", LTUnit)
-- the tail statement of a block may be a bare assignment (`x = e`): evaluate for
-- effect, the block yields Unit.
emitBlockLast e env (CSAssign _ ex) =
  let _ = emitExpr e env ex
  ("1", LTUnit)

-- A statement that is not the block's last (`rest` follows it): emitted for its
-- effect, it returns the env the rest of the block sees.
emitBlockLead : Emit ->
  OrdMap (String, LTy) ->
  CStmt ->
  List CStmt ->
  OrdMap (String, LTy)
emitBlockLead e env (CSExpr ex) _ =
  let _ = emitExpr e env ex
  env
-- #314: a block-statement function-`let` (`let go i = … go …`) lowers to a
-- `CSLet` whose rhs is a `CLam` and whose body may call `go` recursively (the
-- self-ref is annotated AGlobal since the non-recursive let does not scope its own
-- name).  The generic PVar arm below would `emitExpr` the CLam with `go` NOT in the
-- env, so the lifted body's self-call hits the `gapE "unbound variable"` build
-- failure (`run` worked — eval binds the name before evaluating the body).  Route
-- it through `emitRecLam` (which binds `go -> %clos` inside the lifted define, so a
-- self-call re-enters the same closure) and bind `go` for the rest of the block —
-- the exact mirror of the expression-level `emitLet _ True (PVar f) (CLam …)` arm.
-- A non-recursive function-`let` takes this path harmlessly (`go` never appears
-- free, so it is simply not captured).
emitBlockLead e env (CSLet _ (PVar x _) (CLam pats body)) _ =
  let (w, ty) = emitRecLam e env x pats body
  omInsert x (w, ty) env
emitBlockLead e env (CSLet _ (PVar x _) ex) rest =
  bindLetRaw e env x ex (CBlock rest)
emitBlockLead e env (CSLet _ PWild ex) _ =
  let _ = emitExpr e env ex
  env
emitBlockLead e env (CSLet _ (PTuple ps) ex) rest =
  match bindTupleInline e env ps ex
    Some env2 => env2
    None =>
      let (v, _) = emitExpr e env ex
      bindPattern e env (PTuple ps) v (CBlock rest)
-- General block-let `let pat = e` for an ARBITRARY pattern (PCon, PCons, PList,
-- PAs, nested).  Two cases (P0-2c):
--  • IRREFUTABLE pattern (PVar/PWild/PAs-of-irrefutable, or a PCon of a
--    single-constructor type) — destructure with NO failure branch, exactly as
--    cevalBlock's cBlockLet does (core_ir_eval :269) and as the PTuple arm above.
--    Reuses bindPattern; keeps existing goldens byte-identical.
--  • REFUTABLE pattern (a PCon of a type with sibling ctors, or a list pattern) —
--    a plain `let (Some y) = e` with NO `else` can FAIL at runtime.  The
--    interpreter's blockLet runtimePanics "E-LET-REFUTE"; before this fix the
--    emitter blindly loaded field 0 of a mismatching cell → SIGSEGV.  Now emit a
--    head-ctor tag check that traps @mdk_let_refute on a miss (emitRefutableCsLet).
-- Placed after the specialized PVar/PWild/PTuple arms so those stay byte-identical.
emitBlockLead e env (CSLet _ pat ex) rest =
  let (v, _) = emitExpr e env ex
  if refutableCsLet e pat then
    emitRefutableCsLet e env pat v
  else
    bindPattern e env pat v (CBlock rest)
-- `let mut x = e` reuses the irrefutable `CSLet _ (PVar x)` arm above (the mut
-- flag carries no extra emit work — a mutable local is just an SSA value the
-- block's tail rebinds).  A reassignment `x = e` (CSAssign, gap B1) mirrors the
-- tree-walker's `cevalBlock ((CSAssign x e)::rest)`: re-evaluate `e` and SHADOW
-- the `x` binding for the rest of the block.  Blocks are linear (no back-edge re-
-- enters the binding), so functional rebinding is observationally identical to a
-- real mutable slot — no Ref cell needed.
emitBlockLead e env (CSAssign x ex) _ = omInsert x (emitExpr e env ex) env

-- bind a list of field patterns to a parallel list of loaded field words.
bindFieldList : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  List String ->
  OrdMap (String, LTy)
bindFieldList _ env [] _ = env
bindFieldList _ env _ [] = env
bindFieldList e env (p :: ps) (v :: vs) =
  let env2 = bindPattern e env p v (CLit (LInt 0))
  bindFieldList e env2 ps vs

-- the head ctor (name, arity, field patterns) of a refutable let-else pattern, if
-- it is a constructor-like pattern (named ctor, cons, or non-empty list literal).
letElseHead : Pat -> Option (String, Int, List Pat)
letElseHead (PCon c args) = Some (c, listLen args, args)
letElseHead (PCons h t) = Some ("Cons", 2, [h, t])
letElseHead (PList (p :: ps)) = Some ("Cons", 2, [p, PList ps])
letElseHead _ = None

-- P0-2c: does a general block-`let` pattern (already NOT PVar/PWild/PTuple — those
-- have specialized irrefutable arms) need a runtime match-failure trap?  A PCon is
-- refutable iff its type has SIBLING constructors (a single-ctor `data` — e.g.
-- `Box` — always matches → keep the no-check fast path so goldens stay
-- byte-identical); a cons / non-empty list pattern can always miss (Nil).  Only the
-- TOP-LEVEL head is classified here — nested refutability inside fields shares
-- emitRefutableCsLet's single-level-check limitation.
refutableCsLet : Emit -> Pat -> Bool
refutableCsLet e (PAs _ _ p) = refutableCsLet e p
refutableCsLet e (PCon c _) = ctorHasSiblings e c
refutableCsLet _ (PCons _ _) = True
refutableCsLet _ (PList (_ :: _)) = True
refutableCsLet _ _ = False

-- True when constructor `c` shares its type with at least one other constructor
-- (so a pattern on `c` can fail to match).  Unknown ctors (absent from the
-- ctor→type table — e.g. the built-in list Cons/Nil) are conservatively refutable.
ctorHasSiblings : Emit -> String -> Bool
ctorHasSiblings e c = match ctorTypeOf e c
  Some ty => listLen (ctorsOfType e ty) > 1
  None => True

-- P0-2c: emit a REFUTABLE block-`let` bind with a trap-on-miss.  Emits a
-- head-ctor tag check that branches to a noreturn @mdk_let_refute panic
-- (matching the interpreter's blockLet runtimePanic "E-LET-REFUTE").  On a tag
-- match, bind the fields (bindFieldList → bindPattern, a single-level extract)
-- and return the extended env; the
-- caller continues emission in the `ok` block.  A non-constructor-head refutable
-- pattern (letElseHead None — e.g. a bare Nil `let [] = …`) falls back to the old
-- unchecked bindPattern behaviour (no regression).
emitRefutableCsLet : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  String ->
  OrdMap (String, LTy)
emitRefutableCsLet e env pat sv = match letElseHead pat
  Some (c, a, fieldPats) =>
    let rep = discRepOfHead e c a [c]
    let tag = discReg e rep sv
    let cmp = freshReg e
    let _ = emit e "  \{cmp} = icmp eq i64 \{tag}, \{discExpected e rep c}"
    let n = intToString (freshLocal e)
    let ok = "letrefok" ++ n
    let no = "letrefno" ++ n
    let _ = emit e "  br i1 \{cmp}, label %\{ok}, label %\{no}"
    let _ = emit e (no ++ ":")
    let _ = emit e "  call void @mdk_let_refute()"
    let _ = emit e "  unreachable"
    let _ = emit e (ok ++ ":")
    let fields = loadFields e sv a 0
    bindFieldList e env fieldPats fields
  None => bindPattern e env pat sv (CLit (LInt 0))

-- ── function application (slices 2 + 4) ─────────────────────────────────────
-- Three call shapes, by the application spine's head:
--   • a known top-level FUNCTION — saturated direct `call @mdk_<name>`.
--   • a CONSTRUCTOR — heap-cell allocation.
--   • ANYTHING ELSE — a closure-valued head (a parameter, a let-bound
--     lambda, an immediately-applied `CLam`, or a returned closure): emit the head
--     to a closure word, load its code_ptr, and INDIRECT-call it passing the
--     closure word as the leading argument.  SATURATED only — the Core IR is
--     type-erased, so the call site cannot see the closure's arity; the spike
--     relies on controlled fixtures applying a closure with exactly its arity in
--     one spine.  Partial application (under-application → a residual closure) and
--     over-application are OUT (the real backend will carry arity in the cell).
emitApp : Emit -> OrdMap (String, LTy) -> CExpr -> (String, LTy)
emitApp e env app =
  let (hd, args) = flattenApp app []
  match hd
    CVar fname _ =>
      if fname == "$withFileReadBound"
        || fname == "$withFileWriteBound" then match emitArgs e env args
        [grant, thunk] =>
          let r = freshReg e
          let mode = if fname == "$withFileWriteBound" then "1" else "0"
          let _ =
            emit
              e
              "  \{r} = call i64 @mdk_with_file_bound(i64 \{mode}, i64 \{grant}, i64 \{thunk})"
          let resultTy = match args
            [_, CLam _ body] =>
              typeOf
                (sigMapOf e)
                (map
                  (n => (n, snd (optionOr ("", LTInt) (omLookup n env))))
                  (omKeys env))
                body
            _ => LTInt
          (r, resultTy)
        _ => panic "llvm: file bound takes a grant and a thunk"
      else if fname == "Ref" then
        emitRefAlloc e env args
      else if fname == "setRef" then
        emitSetRef e env args
      else if fname == siteSentinelName then
        emitSiteLiteral e args
      else if isLocal env fname then
        -- A LOCALLY-BOUND name (param / let-binding) SHADOWS any same-named ctor /
        -- known top-level fn / interface method / extern: it is a runtime closure
        -- value, so applying it is an INDIRECT call, never a ctor alloc / direct
        -- call / method dispatch.  Without this, a HOF param named like a method
        -- (`pickEq eq x y = eq x y`, or `cmp`/`compare`) fell to the isImplMethod
        -- arm → emitMethodArgDispatch arg-tag-dispatched over the method's impl
        -- groups (incl. PRIMITIVE Int/String/… that own no ctor cell tag) →
        -- emitTagMatch [] slice-7 build reject — while `medaka run` was always
        -- correct (eval treats the param as the local it is).  Mirrors emitVar's
        -- isLocal-first priority for the same name in VALUE position.
        emitIndirect e env hd args
      else if isAnyExtern fname && hasArgs args then
        emitExternApplied e env fname args
      else if isSome (u64KernelAlias e fname args) then
        -- a `u64` wrapper around one kernel (`u64KernelAlias`): the kernel
        -- itself, so `U64.toIntTruncating (…)` fuses with its argument
        emitU64Extern e env (optionOr "" (u64KernelAlias e fname args)) args
      else if isFfiExtern e fname && hasArgs args then
        -- #2074: a USER-declared extern is a FOREIGN symbol, not a builtin, not a
        -- ctor, and not a compiled top-level fn — without this arm the ladder falls
        -- all the way through to `emitVar`'s bare-variable case and panics with
        -- "unbound variable".  AFTER `isAnyExtern` on purpose: that ordering is the
        -- builtin-name exemption (see `emitFfiCall`'s header).
        emitFfiCall e env fname args
      else if isCtor e fname then
        let argOps = emitArgs e env args
        emitCtorApp e fname argOps (ctorArity e fname)
      else
        let fname2 = canonFnName e fname
        if isKnownFn e fname2 && hasArgs args then
          emitKnownFnApp e env fname2 args
        else if isImplMethod e fname && hasArgs args then
          let argOps = emitArgs e env args
          emitMethodArgDispatch e fname "" (methodArityOfInput e fname) argOps
        else if isFallthroughVar fname then
          emitFallthrough e fname
        else
          emitIndirect e env hd args
    CMethod name iface arity route implRoutes methRoutes =>
      match intFromIntIdentityArg name route implRoutes methRoutes args
        Some a => emitExpr e env a
        None =>
          let argOps = emitArgs e env args
          emitMethod e env name iface arity route implRoutes methRoutes argOps
    CDict name routes =>
      let argOps = emitArgs e env args
      emitDictApp e env name routes argOps
    _ => emitIndirect e env hd args
-- A known top-level function applied to arguments: its raw worker when it has one
-- of this arity, else the uniform-ABI call (which handles under- and
-- over-application).
emitKnownFnApp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitKnownFnApp e env fname args = match u32Inline e env fname args
  Some (k, pats, body) =>
    (tagW32 e k (emitU32Inlined e env pats body args), LTInt)
  None => match rawWorkerCall e fname (lengthS args)
    Some (sym, w) =>
      let res = emitRawWorkerCallW e env sym w args (fnRetTy e fname)
      let n = lengthS args
      let _ = recordFloatClosureResult e fname n n res
      res
    None => emitKnownFnCall e env fname args

emitKnownFnCall : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  (String, LTy)
emitKnownFnCall e env fname args =
  let argOps = emitArgs e env args
  let res =
    emitKnownFnSat
      e
      ("mdk_" ++ fname)
      argOps
      (fnArity e fname)
      (fnRetTy e fname)
  let _ =
    recordFloatClosureResult e fname (lengthS argOps) (fnArity e fname) res
  res

-- slice 6: an applied method / constrained-fn occurrence.  The real arguments
-- emit first (left-to-right), then the dispatch resolves to a direct impl call
-- (RKey), a runtime impl switch (RDict/RDictFwd), or a dict-passing call (CDict).

-- a saturated INDIRECT call: emit the head to a closure word, load its
-- code_ptr (cell field 0), and `call` the loaded pointer with the closure word as
-- the leading argument.  The result type is unknown to the type-erased call site;
-- default Int — EXCEPT (native backend) when the head is a self-returning function
-- PARAM of the impl currently being emitted (`andThen`'s `f` in `f x`): that
-- callback yields the container, so type the result as `tagToLTy <curImplTag>`.
emitIndirect : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  List CExpr ->
  (String, LTy)
emitIndirect e env hd args =
  let (cw, _) = emitExpr e env hd
  let argOps = emitArgs e env args
  match directLamOf e cw (lengthS argOps)
    -- KNOWN-AT-EMIT head: this closure word is the cell of a let-group local
    -- function that `satOnlyUses` proved is only ever applied to exactly its
    -- arity, and this application supplies exactly that many args.  The cell's
    -- code_ptr therefore cannot be anything but `@mdk_lamN`, so call it directly
    -- and skip the load + inttoptr the indirect shape needs.  The cell word is
    -- still passed as the leading argument (the lifted define reads its captures
    -- and its self-reference out of `%clos`), and the result type comes from the
    -- same `indirectRetTy` the exact-arity indirect branch below uses — so a
    -- float-returning local function keeps its LTFloat result.
    Some lam =>
      let r = freshReg e
      let _ = emit e "  \{r} = call i64 @\{lam}(\{argDecls (cw :: argOps)})"
      (r, indirectRetTy e cw hd)
    None => emitIndirectArity e cw argOps hd

-- the lifted symbol a saturated call through closure word `cw` may target
-- DIRECTLY: an `e.directFn` entry whose recorded arity is exactly `nargs`.  A
-- surplus or shortfall is deliberately NOT a hit — over- and under-application
-- must keep flowing through `emitIndirectArity`'s split/PAP paths unchanged.
directLamOf : Emit -> String -> Int -> Option String
directLamOf e cw nargs = match lookupAssoc cw !e.directFn
  Some (lam, arity) => if arity == nargs then Some lam else None
  None => None

-- the historical indirect-call shape: split on the closure's compile-time arity.
emitIndirectArity : Emit -> String -> List String -> CExpr -> (String, LTy)
emitIndirectArity e cw argOps hd = match lookupAssoc cw !e.closureArity
  Some n =>
    if n > 0 && lengthS argOps > n then
      -- OVER-APPLICATION of a let-bound closure (`(g 7) 9`): saturate with the
      -- first `n` args, then apply the surplus to the returned (opaque) value.
      let r0 = emitIndirectCallWords e cw (takeS n argOps)
      (emitApplyAny e r0 (dropS n argOps), LTInt)
    else if n > 0 && lengthS argOps < n then
      -- UNDER-APPLICATION (`let h = g 7` for arity-2 g): build a residual
      -- partial-application closure over the inner closure value + supplied args.
      emitPapClosureIndirect e cw argOps n
    else
      (emitIndirectCallWords e cw argOps, indirectRetTy e cw hd)
  -- OPAQUE head (arity unknown at compile time — e.g. a closure PARAM `f` in
  -- `map f`, or a closure pulled from a container).  The supplied count may not
  -- match the closure's runtime arity, so dispatch arity-aware (emitApplyAny):
  -- exact ⇒ inline call; partial ⇒ runtime PAP; over ⇒ saturate + reapply.
  None => (emitApplyAny e cw argOps, indirectRetTy e cw hd)

-- the raw indirect call: load the closure's code_ptr (cell field 0) and `call` it
-- with the closure word as the leading argument followed by `argOps`.
emitIndirectCallWords : Emit -> String -> List String -> String
emitIndirectCallWords e cw argOps =
  let cp = loadField e cw 0
  let fp = freshReg e
  let _ = emit e "  \{fp} = inttoptr i64 \{cp} to ptr"
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 \{fp}(\{argDecls (cw :: argOps)})"
  r

-- the static result type of an indirect call: container when the head is a
-- self-returning function param of the current impl, else LTInt (unchanged).
indirectResultTy : Emit -> CExpr -> LTy
indirectResultTy e (CVar f _) =
  if isCurSelfFnParam e f then tagToLTy !e.curImplTag else LTInt
indirectResultTy _ _ = LTInt

-- the result type of an indirect call: a recorded float-returning closure (keyed by
-- the closure word `cw`) types its result LTFloat; otherwise the historical
-- indirectResultTy (self-fn-param container, else LTInt).
indirectRetTy : Emit -> String -> CExpr -> LTy
indirectRetTy e cw hd = match lookupAssoc cw !e.closureRetTy
  Some t => t
  None => indirectResultTy e hd

hasArgs : List CExpr -> Bool
hasArgs [] = False
hasArgs _ = True

-- emit each argument expression (left-to-right); collect the i64 operand words.
emitArgs : Emit -> OrdMap (String, LTy) -> List CExpr -> List String
emitArgs _ _ [] = []
emitArgs e env (a :: rest) =
  let (v, _) = emitExpr e env a
  v :: emitArgs e env rest

-- render an operand list as a comma-separated i64 argument list.
argDecls : List String -> String
argDecls [] = ""
argDecls [x] = "i64 " ++ x
argDecls (x :: rest) = "i64 \{x}, \{argDecls rest}"

-- ── typeclass dispatch ────────────────────────────────────────────
-- Core IR carries the typechecker's resolved dispatch in two structural nodes
-- (core_ir.mdk): `CMethod name arity route implRoutes methRoutes` (a method occurrence)
-- and `CDict name routes` (a `=>`-constrained-function occurrence).  Each Route is
-- RNone | RKey String (List Route) | RDict String | RDictFwd String (ast.mdk).
--
-- The KEY TRACTABILITY PROPERTY (the reason the bootstrap is in reach): an RKey
-- route is STATICALLY resolved — the typechecker already pinned the concrete type
-- head, so the impl is known at COMPILE time and the site lowers to a DIRECT call
-- to that impl's lifted `@mdk_impl_<tag>_<method>`, with NO runtime tag inspection.
-- The self-host compiler dispatches return-position via RKey (compiler/README.md),
-- so RKey alone covers the bootstrap.  RDict/RDictFwd read a named dict PARAMETER
-- at run time, so they lower to an if-chain switching on the dict's head tag over
-- the method's impls (corpus completeness — the dict-passing fixtures).  This
-- mirrors core_ir_eval's `methodAtNarrow`/`applyDicts`/`narrowMethod` one-to-one,
-- resolving the same routes in emitted control flow instead of walking VMulti
-- values.  RNone (D3a: a type-variable arg-position site the front end left
-- unstamped) falls back to runtime arg-tag dispatch; nested-requires dicts are out
-- of scope.
--
-- SPIKE-REP NOTES (the (j)/(k)/(l) entries in STAGE2-DESIGN §2.4a):
--   (j) DICTS (GAP 1, Option A — BOXED witness) — a dict witness is a POINTER to a
--       heap cell `[ i64 head_tag | i64 reqdict_0 | … ]` (via @mdk_alloc, the same
--       boxed-cell shape ADT ctors use): field 0 = `hashName(impl-head-tag)` (the
--       djb2 used for the `icmp eq` dispatch test), fields 1..n = the RECURSIVELY-
--       built witness words for the impl's per-instance `requires` dicts.  RNone ⇒ 0
--       (no cell).  The rep is UNIFORM: a one-level dict (`RKey k []`) is a 1-word
--       cell `[ hashName k ]`; a two-level dict (`RKey k [RKey k2 …]`) nests another
--       cell pointer in field 1.  Consumption: the RKey direct-call path forwards the
--       boxed pointer as the impl fn's leading dict param; the RDict dispatch chain
--       (emitDispatchChain) loads the head tag from field 0 for the `icmp` and
--       prepends fields 1..n as the matched impl's leading element-dict args.
--       (Previously the witness was a flat i64 that dropped nested reqs and panicked
--       on a non-empty set — the GAP-1 SIGSEGV `medaka build` hit on `[[Int]]`.)
--   (k) IMPL FUNCTIONS — each tagged impl method lowers to a top-level
--       `@mdk_impl_<tag>_<method>(params…)` (lambda-lift convention of emitFn).  A
--       nullary return-position impl (`def`/`zero`/`empty`) is a zero-arg function
--       the use site CALLs for its value; a parameterized impl takes its params.
--   (l) DISPATCH — RKey ⇒ a direct call (impl chosen at compile time).  RDict/
--       RDictFwd ⇒ a CALL to the method's SHARED dispatcher
--       `@mdk_disp_<method>_<nMeth>_<nArgs>(%dict, %mw…, %arg…)`.  ⚠️ THE IF-CHAIN IS
--       NOT AT THE SITE — it lives in that dispatcher (issue #118: it used to be
--       inlined at every site, which made emitted IR grow as `Σ over sites of
--       (#impls of that site's method)`; 107 sites shared just 9 distinct chains on a
--       9-line fixture).  INSIDE the dispatcher the chain is unchanged: compare the
--       dict witness word to each impl's hashName tag; an exhausted chain is
--       `unreachable` (the typechecker proves the dict names a real impl).
--       Debugging a dispatch miscompile? The arm you want is in `@mdk_disp_*`.
--
--       Why one dispatcher can serve every site of a method: the chain body is a pure
--       function of the method (and, when two interfaces declare it, the interface —
--       `dispMethodWord`), the method-level dict count, and the arg count — all baked
--       into the symbol — plus program-global tables (`implsOf`, reading `e.implEntries`,
--       which is
--       written ONCE at Emit construction and never mutated).  So the impl set cannot
--       grow between the site that mints a dispatcher and any later site.

-- a method occurrence.  `argOps` are the already-emitted real-argument words (empty
-- for a bare nullary method like `def`).  methRoutes/implRoutes apply method-/
-- instance-level constraint dicts as leading args (D3b-1): on an RKey call into a
-- parametric `requires` impl, each materializes a one-word dict witness prepended
-- ahead of the real args, matching dict_pass's leading `$dict_<method>_<slot>`
-- params.  Both empty for an unconstrained impl ⇒ the plain direct call.
-- GAP 1: the route's OWN nested `reqs` are now representable (boxed dict cells,
-- Option A) — the former `ensureNoReqs reqs` guard is gone.  This site's leading
-- dicts come from the call-site routes (methRoutes ++ implRoutes); each such
-- route's nested reqs are materialized recursively inside dictWordOfRoute.
--
-- [iface] is the `ifaceWordOf` word of the interface the occurrence resolved to:
-- every lookup below narrows the method's entries to that interface's before it
-- matches a tag (`narrowImplsByIface`), so two interfaces' same-spelled methods are
-- never candidates for one another.
emitMethod : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  List String ->
  (String, LTy)
emitMethod e env name iface siteArity (route@(RKey tag _ _)) implRoutes methRoutes argOps =
  match implForSite e name iface tag siteArity
    Some entry =>
      let dictWords =
        dictWordsOf
          e
          env
          (staticEntryDictRoutes e name entry route methRoutes implRoutes)
      -- [tag] is the selected instance's canonical key.  For tagToLTy/returns-self
      -- use the matched entry's head tag; the lifted-fn symbol uses implFnSymOf so
      -- it matches emitGroup's name.
      let headTag = implEntryTag entry
      let resTy =
        if methodReturnsSelf e (implEntryIface entry) name then
          tagToLTy headTag
        else
          LTInt
      emitImplCallSat
        e
        (implEntryFnName e name entry)
        (dictWords ++ argOps)
        (methodArityOfEntry e entry name + lengthS dictWords)
        resTy
    None => gapE e "no impl of method '\{name}' for instance '\{tag}'"
emitMethod e env name iface siteArity (RDict d) implRoutes methRoutes argOps =
  emitMethodDispatch e env name iface siteArity (RDict d) methRoutes argOps
emitMethod e env name iface siteArity (RDictFwd d) implRoutes methRoutes argOps =
  emitMethodDispatch e env name iface siteArity (RDictFwd d) methRoutes argOps
-- a projected super dictionary dispatches exactly as a dictionary parameter does
emitMethod e env name iface siteArity (RProj r path) implRoutes methRoutes argOps =
  emitMethodDispatch e env name iface siteArity (RProj r path) methRoutes argOps
emitMethod e env name iface siteArity RNone implRoutes methRoutes argOps =
  emitMethodArgDispatch e name iface siteArity argOps
-- S-1: a CONSTRAINED shadowing standalone was given leading dict PARAMS by
-- dictPassDecl, so its call must supply the matching dict WORDS.  Delegate to
-- emitDictApp — the SAME tested helper the ordinary CDict path uses (it prepends the
-- dict words and, via defArityOf, builds a residual PAP when genuinely
-- under-applied).  Without this the direct emitKnownFnSat call below supplies one
-- word too few, emitKnownFnSat correctly reads that as under-application, and the
-- program silently prints a PAP heap pointer instead of the answer (the S-1 bug).
-- `dicts == []` (every unconstrained standalone, the compiler's own definer shadows
-- included) keeps the byte-identical pre-S1 direct call ⇒ the self-compile
-- fixpoint cannot move.
emitMethod e env name _ _ (RLocal sym dicts) implRoutes methRoutes argOps =
  let target = if sym == "" then name else sym
  -- #1430 (S2, row 39): a RETURN-POSITION method (`zed : a`) shadowed by a module-local
  -- standalone routes RLocal to a NULLARY top-level binding, and a nullary binding is a
  -- value GLOBAL, never an `@mdk_<sym>` define — it is read through `@mdk_force_<sym>()`
  -- (LAZY) or `@mdk_g_<sym>` (eager).  `emitKnownFnSat` below emits `call i64
  -- @mdk_<sym>()` unconditionally, which clang rejected with `use of undefined value
  -- '@mdk_main__zed'` — `medaka build` exit 1 on a program `check` and `run` both accept.
  -- `lookupVarG` is the SAME accessor `emitVar` uses for any other reference to that
  -- binding, so the two spellings of "read this global" cannot drift.  Gated on
  -- `isKnownFn` so every arg-position shadow (whose target IS a function) keeps the
  -- byte-identical direct call — the compiler's own definer shadows included.
  if isEmpty argOps && not (isKnownFn e target) then
    lookupVarG e env target
  else if isEmpty dicts then
    emitKnownFnSat
      e
      ("mdk_" ++ target)
      argOps
      (fnArity e target)
      (fnRetTy e target)
  else
    emitDictApp e env target dicts argOps
-- native backend: a method whose RESULT mentions the interface/self
-- type variable (map/ap/andThen) returns the CONTAINER; type its
-- RKey-dispatched result as the impl's own type (tagToLTy tag) so a
-- downstream `++`/`::` on it dispatches list/string append.  Otherwise
-- (scalar/element result) keep the LTInt default.

-- C5 (mirror eval.mdk's RLocal handling): NOT a method dispatch — the receiver has no
-- impl of this interface but an explicitly-imported/local standalone shadows the
-- method name.  Emit a DIRECT call to that standalone top-level fn (`mdk_<target>`),
-- exactly as emitApp's isKnownFn branch would for a plain call — no dispatch, no
-- dicts.  P0-18: `target` is the symbol the route CARRIES, and the `EMethodAt` beside
-- it keeps the BARE dispatch name so `implFor` still finds the impl for a receiver
-- that has one.  Since #2809 the route names its symbol on EVERY path: typecheck seeds
-- a definer-shadow occurrence with the bare standalone name, and `private_mangle`'s
-- `mangleRoute` renames it on the emit path — so `target` reads `<mid>__name` in an
-- emitted program and the plain name off the emit path.  The `sym == ""` fallback
-- below is what a route carrying no symbol at all would take; typecheck mints no such
-- `RLocal` (`mintMethodCell ""` yields `RNone`).  The compiler's OWN definer shadows
-- reach THIS arm with their mangled symbol; the emitted `emitKnownFnSat` call is
-- byte-identical to the pre-P0-18 direct `@mdk_<mid>__name` bare-EVar call (fixpoint
-- gate).  The membership is derived, not memorised — a module's own top-level function
-- whose name is also a nameable interface method — and it moves with the tree: `map`'s
-- and `hash_map`'s `toList` were members until #2769 deleted both in favour of a real
-- `impl Foldable`; `stdlib/map.mdk`'s and `stdlib/hash_map.mdk`'s `isEmpty` (against
-- `Foldable.isEmpty`) and `compiler/frontend/parser.mdk`'s `orElse` still are.

-- Gap #50 (value position) — a bare method occurrence
-- `CMethod name arity route ..` used
-- as a FIRST-CLASS VALUE (passed to a HOF, e.g. `applyOp max 3 7`): there are no
-- applied args, so the saturated dispatch chain that `emitMethod .. []` would emit
-- runs the impl/default with ZERO operands (garbage), and the result is then handed
-- to the HOF as a closure word and INDIRECTLY called → crash.  Instead eta-wrap the
-- method into a real closure value: a lifted `@mdk_methval_<name>_N(%clos, %arg…)`
-- whose body re-emits the SATURATED dispatch (emitMethod with the full %argK
-- operands) under the method's own route.  For an RDict/RDictFwd route the closure
-- CAPTURES the dict word and rebinds it from `%clos` field 1 in the body, so the
-- runtime impl switch still reads the caller's dict.  A nullary method (arity 0,
-- e.g. `def`) is a plain value — keep the immediate `emitMethod .. []`.
-- S1-RESIDUAL-A (fixed 2026-07-16, issue #410; SHADOW-SEMANTICS.md §6): a VALUE-position
-- standalone SHADOW (`map size [1,2,3]`) must not miscompile here.  The arity below is
-- ROUTE-derived (`methValArity`), never name-derived, and that is what keeps it correct:
-- lifting at `methodArityOf name` — the interface METHOD's arity — for a body that calls
-- the STANDALONE, whose value arity need not match, builds a closure that lies.  With the
-- two arities EQUAL the lie is invisible, which is why every pre-#410 probe (and the whole
-- d4/d10 corpus) missed it.  When they differ the closure advertises N args to the HOF but
-- its body forwards them to an M-arg function: N>M makes `emitKnownFnSat` take the
-- `emitOverApp` path (:3941), which calls the target, gets a SCALAR back, and hands that
-- Int to `emitApplyAny`, which reads an arity out of the "cell header" of an integer ⇒ the
-- built binary SEGFAULTs (wasm: `illegal cast`) while `check`/`run` both stay green.  The
-- RLocal arm below already knew the truth via `fnArity e target`.
emitMethodValue : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  (String, LTy)
emitMethodValue e env name iface siteArity route implRoutes methRoutes =
  let arity = methValArity e name iface siteArity route
  if isDynamicMethodRoute route || arity <= 0 then
    emitMethod e env name iface siteArity route implRoutes methRoutes []
  else
    -- the lifted body builds the site's impl and method dictionaries too, and
    -- either may read an enclosing dictionary parameter
    let capNames =
      dedupS
        (methValDictNames route ++ routeDictNames [] (implRoutes ++ methRoutes))
    let capWords = capDictWords e env capNames
    let lamName = "mdk_methval_\{name}\{mangleScoped e}"
    let _ =
      emitMethodValDefine
        e
        env
        lamName
        name
        iface
        siteArity
        route
        implRoutes
        methRoutes
        arity
        capNames
    emitClosureAllocA e lamName arity capWords

-- the VALUE arity the lifted method-value closure must advertise to a HOF — i.e. the
-- number of value args the body it wraps actually consumes, which is a property of the
-- ROUTE, not of the method name (#410).
--
-- RLocal is the definer-shadow route: the body (`emitMethod`'s RLocal arm) forwards to
-- the STANDALONE `mdk_<target>`, so the closure must expose the STANDALONE's value arity.
-- The recorded emitted define arity is authoritative because it is the ruler that
-- target's `emitKnownFnSat`/`emitDictApp` saturation uses.  A declaration signature can
-- exceed a dynamic-method-tail wrapper's source clause arity, so using it here would
-- delay dispatch and overcall the define.  `fnArity` remains the compatibility fallback
-- when the target has no recorded define.
--
-- ⚠️ the `- listLen dicts` is load-bearing and NOT cosmetic: `inferSigs` runs over the
-- LOWERED (post-dict-pass) clauses, so both define and fallback arities are
-- DICT-INCLUSIVE.  A CONSTRAINED shadow therefore counts its leading dict params, but
-- the closure exposes VALUE args only — the dict words are CAPTURED (see
-- `methValDictNames`) and re-prepended inside the body by `emitDictApp`.  Without the
-- subtraction a constrained shadow would advertise nDicts too many and segfault exactly
-- like the unconstrained case it fixes.  `dicts == []` ⇒ subtract 0.
--
-- RKey uses the selected implementation's callable arity.  RNone accepts only enough
-- args to expose its runtime receiver before per-group saturation.  RDict/RDictFwd are
-- dispatched immediately by emitMethodValue and do not allocate this closure.
methValArity : Emit -> String -> String -> Int -> Route -> Int
methValArity e name _ siteArity (RLocal sym dicts) =
  let target = if sym == "" then name else sym
  match defArityOf e target
    Some n => maxInt 0 (n - listLen dicts)
    None =>
      let a = fnArity e target - listLen dicts
      if a <= 0 then siteArity else a
methValArity e name iface siteArity (RKey tag _ _) =
  match implForSite e name iface tag siteArity
    Some entry => methodArityOfEntry e entry name
    None => siteArity
methValArity e name iface siteArity RNone =
  methodArgDispatchArity e name iface siteArity
methValArity _ _ _ siteArity _ = siteArity

-- An RNone value must accept enough arguments to expose the runtime receiver, then
-- let the selected group decide saturation against its own callable arity.  Using
-- the interface declaration arity here defers a strict-prefix implementation whose
-- source clause returns a function (declared arity 2, callable arity 1).
methodArgDispatchArity : Emit -> String -> String -> Int -> Int
methodArgDispatchArity e name iface siteArity =
  match implGroupsForMethodArity e name iface siteArity
    [] => siteArity
    groups => headPos (groupPositionsOf (headGroup groups)) + 1

isDynamicMethodRoute : Route -> Bool
isDynamicMethodRoute (RDict _) = True
isDynamicMethodRoute (RDictFwd _) = True
isDynamicMethodRoute (RProj _ _) = True
isDynamicMethodRoute _ = False

-- the dict-witness param name(s) a route reads at runtime (the names whose words the
-- value-closure must capture so the lifted body can rebind them).  Only RDict/
-- RDictFwd name a dict; RKey/RNone/RLocal capture nothing.  (Distinct from the
-- `freeVars` helper `routeDictNames`, which scans a route LIST for free dict vars.)
methValDictNames : Route -> List String
methValDictNames (RDict d) = [d]
methValDictNames (RDictFwd d) = [d]
-- S-1: a VALUE-position constrained shadow (`map size xs`) lifts to a closure, and its
-- RLocal route's dict slots may include an RDict — the enclosing constrained fn's own
-- dict param.  That word must be CAPTURED or the lifted body reads an out-of-scope
-- name.  Empty dicts ⇒ [] ⇒ byte-identical to the pre-S1 catch-all.
methValDictNames (RLocal _ dicts) = routeDictNames [] dicts
methValDictNames (RProj r _) = methValDictNames r
methValDictNames _ = []

-- the operand words for each captured dict name, looked up in the current emit env.
capDictWords : Emit -> OrdMap (String, LTy) -> List String -> List String
capDictWords e env ds = map (dictOperand e env) ds

-- emit the lifted method-value forwarder.  Captures (the dict words) load from
-- `%clos` fields 1.. and rebind the route's dict name(s); the body re-emits the
-- SATURATED method dispatch over the `%argK` value operands.
emitMethodValDefine : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  Int ->
  List String ->
  Unit
emitMethodValDefine e env lamName name iface siteArity route implRoutes methRoutes arity capNames =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let cenv = loadCaptures e env capNames 0
  let synArgs = etaArgOps arity 0
  let (r, _) =
    emitMethod e cenv name iface siteArity route implRoutes methRoutes synArgs
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- CDict in VALUE position (EMITTER-GAPS #18, value facet): a `=>`-constrained
-- NAMED function used as a FIRST-CLASS value — passed unapplied to a higher-order
-- combinator (`filter myParity xs`, `map inc xs`, a user HOF `apply isEv 4`).  The
-- dict_pass-elaborated define `@mdk_<name>` takes `listLen routes` leading dict
-- PARAMS + the value args; emitDictApp handles the CALL (head) position, but a bare
-- occurrence used as a value reached emitExpr's catch-all and panicked
-- "unsupported Core IR node CDict".  Mirror emitMethodValue (the CMethod-as-value
-- path): build the route dict words at THIS site, capture them in a closure cell,
-- and emit a forwarder that reloads them and prepends them ahead of the `%argK`
-- value words when the HOF invokes the closure — yielding a plain closure VALUE with
-- the ABI filter/map/apply expect (field 0 = code_ptr, fields 1.. = captured dicts).
-- The forwarder body is a DIRECT `@mdk_<name>` call (vs emitMethodValue's dispatch).
-- A nullary value arity (the constrained fn takes no value args) degenerates to the
-- plain saturated dict call.
emitDictValue : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Route ->
  (String, LTy)
emitDictValue e env name routes =
  if isLocal env name then
    emitLocalDictApp e env name routes []
  else if isKnownFn e name then
    let valArity = match defArityOf e name
      Some n => maxInt 0 (n - listLen routes)
      None => fnArity e name - listLen routes
    if valArity <= 0 then
      emitDictApp e env name routes []
    else
      let dictWords = dictWordsOf e env routes
      let lamName = "mdk_dictval_\{name}\{mangleScoped e}"
      let _ = emitDictValDefine e lamName name (lengthS dictWords) valArity
      emitClosureAllocA e lamName valArity dictWords
  else
    gapE e ("CDict head '" ++ name ++ "' is not a known top-level function")

-- emit the lifted constrained-fn value forwarder.  Closure cell layout: field 0 =
-- code_ptr, fields 1..nDicts = captured dict words.  The forwarder takes `valArity`
-- fresh `%argK` params, reloads the dict words from %clos fields 1..nDicts, and
-- calls `@mdk_<name>(dicts.., %arg0.., %arg(valArity-1))` — the same leading-dict-then-
-- value-arg order emitDictApp / dict_pass use at every direct call site.  valArity
-- comes from the recorded emitted define, so a dynamic-method-tail wrapper that
-- deliberately retains its source clause arity is neither overcalled nor advertised
-- at the larger signature arity.
emitDictValDefine : Emit -> String -> String -> Int -> Int -> Unit
emitDictValDefine e lamName name nDicts valArity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls valArity}) {"
  let _ = emit e "entry:"
  let dictOps = loadPapCaptures e nDicts 0
  let synArgs = dictOps ++ etaArgOps valArity 0
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_\{name}(\{argDecls synArgs})"
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- The leading dictionaries a static call to [ent] passes after its method-level
-- ones.  A supplied method takes the instance's `requires` (#1648: no more than its
-- define binds); an inherited default takes its RECEIVER, the dictionary of the
-- selected instance -- built here from the site's word, its `requires` routes and
-- the supers the typechecker put on the route for exactly this case.
staticEntryDictRoutes : Emit ->
  String ->
  CImplEntry ->
  Route ->
  List Route ->
  List Route ->
  List Route
staticEntryDictRoutes e name ent route methRoutes implRoutes =
  if isInheritedEntry ent then
    methRoutes ++ [receiverRoute route implRoutes]
  else
    methRoutes ++ implRoutesForDefine e name ent methRoutes implRoutes

receiverRoute : Route -> List Route -> Route
receiverRoute (RKey word _ sups) implRoutes = RKey word implRoutes sups
receiverRoute route _ = route

-- an inherited default's per-instance entry
isInheritedEntry : CImplEntry -> Bool
isInheritedEntry (CImplEntry _ _ (CImplDefault _ _ _ _ _ _)) = True
isInheritedEntry _ = False

-- a direct call to a statically-resolved impl fn (RKey).  Nullary (argOps == [])
-- ⇒ `call @mdk_impl_<tag>_<method>()`, yielding the impl's value.  `resTy` is the
-- statically-inferred result type: LTInt for a scalar/element-returning method,
-- or the container (tagToLTy tag) for a returns-self method (map/ap/andThen) so
-- a downstream `++`/`::` types its operand correctly (native backend).
emitImplCall : Emit -> String -> List String -> LTy -> (String, LTy)
emitImplCall e fname argOps resTy =
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @\{fname}(\{argDecls argOps})"
  (r, resTy)

-- a call to a statically-resolved impl fn (RKey / single arg-tag group) that
-- may be UNDER- or OVER-APPLIED.  A point-free prelude binding (`length = fold f
-- 0`) lowers to the impl method applied to FEWER args than the impl fn's full
-- arity: a saturated `emitImplCall` would emit a call missing its trailing
-- parameter(s), which on the native backend reads a garbage register for the
-- missing arg and crashes.  When `lengthS argOps < arity`, build a PARTIAL-
-- APPLICATION closure capturing the supplied words; the residual closure
-- completes the call when the remaining args arrive at an indirect call site.
-- Saturated (`==`) ⇒ the plain direct call, unchanged.
--
-- Over-application CAN arise at an impl call head as of S-emit-arity-by-
-- declaration (#1450/#1668, 7d57ac53): `argOps` is built from the CALL SITE's
-- surface arg count, while `arity` is now the matched entry's OWN declared
-- arity — and those can diverge whenever `implFor`'s same-spelled-interface
-- selection (#1810, untouched here) hands back an entry whose interface
-- declares fewer params than the call site's other same-spelled candidate.
-- Before this branch existed, `lengthS argOps > arity` fell to `otherwise` and
-- silently called the impl fn with its own extra, unread argument — a wrong
-- value at exit 0 with no diagnostic (F17/RUN-METHID-086). Route it through the
-- same `emitOverApp` used by `emitKnownFnSat`, so the excess arg applies against
-- the impl's return value: on the normal (non-#1810-confused) over-application
-- shape that's a legitimate call to a returned closure, and on the #1810
-- selection-confusion shape the return value isn't a closure at all, so the
-- indirect call faults loudly instead of returning a silently-wrong number.
emitImplCallSat : Emit -> String -> List String -> Int -> LTy -> (String, LTy)
emitImplCallSat e fname argOps arity resTy
  | lengthS argOps < arity = emitPapClosure e fname argOps arity
  | lengthS argOps > arity = emitOverApp e fname argOps arity resTy
  | otherwise = emitImplCall e fname argOps resTy

-- a call to a known top-level function (`@<sym>`, sym already mdk-prefixed) that
-- may be UNDER-APPLIED.  A partial application of a named function passed to a
-- higher-order combinator (`map (desugarDottedField e) fields` — 1 of 2 args)
-- lowers to a residual closure capturing the supplied args, not a truncated
-- direct call (which would read garbage for the missing trailing param).
-- Saturated (`==`) ⇒ the plain direct call, unchanged.  fnArity returns 0 for a
-- fn with no recorded signature; then `lengthS argOps >= 0` is always saturated,
-- preserving the old direct-call behaviour for such (signature-less) callees.
emitKnownFnSat : Emit -> String -> List String -> Int -> LTy -> (String, LTy)
emitKnownFnSat e sym argOps arity resTy
  | arity > 0 && lengthS argOps < arity = emitPapClosure e sym argOps arity
  | arity > 0 && lengthS argOps > arity = emitOverApp e sym argOps arity resTy
  | otherwise = emitImplCall e sym argOps resTy

-- OVER-APPLICATION: a known fn of arity N applied to >N args (`makeAdder 10 5` —
-- `makeAdder` returns a closure that consumes the extra arg).  Saturate the direct
-- call with the FIRST N args, then apply the residual VALUE (a closure) to each
-- remaining arg through an indirect call (the same load-code_ptr / call-(closure,
-- arg) shape as emitIndirect).  Without this the trailing args are silently dropped
-- into @sym (which ignores them) and the returned closure is never applied —
-- garbage result / crash.
emitOverApp : Emit -> String -> List String -> Int -> LTy -> (String, LTy)
emitOverApp e sym argOps arity resTy =
  let satArgs = takeS arity argOps
  let extra = dropS arity argOps
  let (r0, _) = emitImplCall e sym satArgs resTy
  (emitApplyAny e r0 extra, LTInt)

-- ARITY-AWARE application of an OPAQUE closure word `cw` to `argOps` (count N): the
-- compile-time arity is unknown (a closure param, a container element, an over-app
-- residual), so the supplied count may not equal the closure's runtime arity.  Read
-- the arity from the cell header (field 0); if it equals N, inline the direct call
-- (the historical fast path); otherwise route through the runtime @mdk_apply, which
-- builds a PAP for a partial application, flattens a PAP, and splits an
-- over-application.  A PAP carries a -1 header so it never matches N (>=1) and always
-- takes the runtime path.  Uses an alloca result slot (like emitIf) so no phi
-- predecessor-label bookkeeping is needed.
emitApplyAny : Emit -> String -> List String -> String
emitApplyAny e cw [] = cw
emitApplyAny e cw argOps =
  let n = lengthS argOps
  let hdr = loadHeader e cw
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{hdr}, \{intToString n}"
  let m = intToString (freshLocal e)
  let fastL = "apfast" ++ m
  let slowL = "apslow" ++ m
  let endL = "apend" ++ m
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let _ = emit e "  br i1 \{cmp}, label %\{fastL}, label %\{slowL}"
  let _ = emit e (fastL ++ ":")
  let rf = emitIndirectCallWords e cw argOps
  let _ = emit e "  store i64 \{rf}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (slowL ++ ":")
  let rs = emitApplyRuntime e cw argOps
  let _ = emit e "  store i64 \{rs}, ptr \{slot}"
  let _ = emit e ("  br label %" ++ endL)
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  r

-- the runtime-generic path: materialize `argOps` into an [N x i64] alloca and call
-- @mdk_apply(cw, N, ptr).  Handles partial / over application + PAP flatten.
emitApplyRuntime : Emit -> String -> List String -> String
emitApplyRuntime e cw argOps =
  let n = lengthS argOps
  let arr = freshReg e
  let _ = emit e "  \{arr} = alloca i64, i64 \{intToString n}"
  let _ = storeArgv e arr argOps 0
  let r = freshReg e
  let _ =
    emit
      e
      "  \{r} = call i64 @__mdk_apply(i64 \{cw}, i64 \{intToString n}, ptr \{arr})"
  r

-- store each arg word into the argv alloca at index `i` (getelementptr i64 stride).
storeArgv : Emit -> String -> List String -> Int -> Unit
storeArgv _ _ [] _ = ()
storeArgv e arr (a :: rest) i =
  let p = freshReg e
  let _ = emit e "  \{p} = getelementptr i64, ptr \{arr}, i64 \{intToString i}"
  let _ = emit e "  store i64 \{a}, ptr \{p}"
  storeArgv e arr rest (i + 1)

-- load the header word (field 0, offset 0 — the closure arity) of a boxed cell.
loadHeader : Emit -> String -> String
loadHeader e ptrWord =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{ptrWord} to ptr"
  let f = freshReg e
  let _ = emit e "  \{f} = load i64, ptr \{p}"
  f

-- build a partial-application closure over `@fname` with `argOps` already-supplied
-- arg words captured.  Emits a forwarder `@mdk_pap_..(%clos, %arg0..%arg(rem-1))`
-- that loads the captured words from the closure cell (fields 1..k, code_ptr is
-- field 0) and tail-calls `@fname(captured.., remaining..)`; allocates the closure
-- capturing `argOps`.  The residual is a closure VALUE (LTClosure) consumed at an
-- indirect call site — the same cell shape emitClosureAlloc / emitIndirect use.
emitPapClosure : Emit -> String -> List String -> Int -> (String, LTy)
emitPapClosure e fname argOps arity =
  let supplied = lengthS argOps
  let remaining = arity - supplied
  let papName = "mdk_pap_\{fname}\{mangleScoped e}"
  let _ = emitPapDefine e papName fname supplied remaining
  emitClosureAlloc e papName remaining argOps

-- emit the PAP forwarder define into the side buffer (same swap discipline as
-- emitEtaDefine).  `supplied` captured words are loaded from %clos fields 1..k;
-- `remaining` fresh %argK params follow; the body calls @fname with the captured
-- words first, then the fresh params, in original order, and returns the result.
emitPapDefine : Emit -> String -> String -> Int -> Int -> Unit
emitPapDefine e papName fname supplied remaining =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{papName}(\{etaParamDecls remaining}) {"
  let _ = emit e "entry:"
  let capOps = loadPapCaptures e supplied 0
  let allArgs = capOps ++ argNames remaining 0
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @\{fname}(\{argDecls allArgs})"
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- load the `k` captured argument words from %clos fields 1..k (code_ptr is 0).
loadPapCaptures : Emit -> Int -> Int -> List String
loadPapCaptures e k i
  | i >= k = []
  | otherwise = loadField e "%clos" (i + 1) :: loadPapCaptures e k (i + 1)

-- UNDER-APPLICATION of an INDIRECT closure VALUE `cw` of arity `arity`, given
-- `argOps` supplied (1..arity-1).  Unlike emitPapClosure (which closes over a known
-- @fname symbol), here the callee is a runtime closure word, so the cell captures
-- BOTH the inner closure word and the supplied args: field 1 = inner closure, fields
-- 2.. = supplied args.  The forwarder loads them and does an INDIRECT call of the
-- inner closure with (supplied.. ++ remaining..) — now saturated.  Recorded with its
-- residual arity so a further over-application of the PAP also splits correctly.
emitPapClosureIndirect : Emit -> String -> List String -> Int -> (String, LTy)
emitPapClosureIndirect e cw argOps arity =
  let supplied = lengthS argOps
  let remaining = arity - supplied
  let papName = "mdk_pap_ind" ++ mangleScoped e
  let _ = emitPapDefineIndirect e papName supplied remaining
  emitClosureAllocA e papName remaining (cw :: argOps)

-- emit the indirect-PAP forwarder define into the side buffer.  field 1 = the
-- captured inner closure word; fields 2.. = `supplied` captured arg words; then
-- `remaining` fresh %argK params.  Body: load the inner closure's code_ptr (its
-- field 0) and `call` it with (innerClosure, supplied.., remaining..).
emitPapDefineIndirect : Emit -> String -> Int -> Int -> Unit
emitPapDefineIndirect e papName supplied remaining =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{papName}(\{etaParamDecls remaining}) {"
  let _ = emit e "entry:"
  let innerCw = loadField e "%clos" 1
  let capOps = loadPapCaptures e (supplied + 1) 1
  let allArgs = capOps ++ argNames remaining 0
  let cp = loadField e innerCw 0
  let fp = freshReg e
  let _ = emit e "  \{fp} = inttoptr i64 \{cp} to ptr"
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 \{fp}(\{argDecls (innerCw :: allArgs)})"
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- the BARE interface name a resolved impl entry belongs to (for the returns-self
-- lookup and the declared-impl head table, both keyed by spelling).
implEntryIface : CImplEntry -> String
implEntryIface (CImplEntry _ _ (CImplTagged _ _ iface _ _ _)) = iface
implEntryIface (CImplEntry _ _ (CImplDefault ifaceWord _ _ _ _ _)) =
  ifaceNameOfWord ifaceWord

-- a runtime method dispatch (RDict/RDictFwd/RProj): the dictionary [dict] denotes
-- — the enclosing function's dict PARAMETER or a super projected out of one (a BOXED
-- dict-witness pointer, GAP 1 Option A) — selects the impl at run time.  Load the head tag from the cell's field 0, then emit an if-chain over
-- the method's tagged impls — compare the head tag to each impl's hashName tag, on
-- a match load the matched impl's nested per-instance dicts from the cell's fields
-- 1..n, PREPEND them to argOps (the impl fn's leading element-dict params), call
-- that impl's lifted fn into a result slot and branch to the end; an exhausted
-- chain is `unreachable`.
emitMethodDispatch : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List String ->
  (String, LTy)
emitMethodDispatch e env name iface siteArity dict methRoutes argOps =
  match soleImplDirectSite e name iface siteArity
    Some ent =>
      -- WS-1b: the selected interface method has exactly ONE impl with no `requires`
      -- element dicts, so a well-typed call always reaches that impl regardless of the
      -- runtime dict (mirrors eval's `narrowMethod (VMulti vs) ""` → sole-impl pick, and
      -- the arg-position single-impl-group DIRECT-call optimization).  Emitting a direct
      -- call here avoids LOADING the dict head tag — which, under an AMBIGUOUS
      -- return-position superclass constraint (`build : Sub a => Int -> a; build n = mk n`,
      -- where `mk`'s `Sup` dict stays ungrounded → the caller passes a NULL dict), would
      -- dereference null → the run≠build SIGTRAP.  Concrete-grounded callers (a real dict)
      -- are unaffected: the direct call is the same impl the tag-dispatch chain would have
      -- selected.
      -- F10: saturate against the impl's own callable arity (see emitDispatchArmBody).
      emitKnownFnSat
        e
        (implEntryFnName e name ent)
        argOps
        (methodArityOfEntry e ent name)
        LTInt
    _ =>
      emitMethodDispatchChain e env name iface siteArity dict methRoutes argOps

-- WS-1b: Some impl iff the occurrence's interface has exactly one entry for [name]
-- AND that entry takes no leading `requires` element-dict params (reqCount 0) — the
-- case where a direct call needs nothing from the runtime dict.  Every instance that
-- inherits the method has its own entry (an inherited default's per-instance body),
-- so "one entry" is "one possible callee".  A multi-entry method, or a sole entry
-- WITH requires (whose element dicts live in the dict cell), still goes through the
-- tag-switching chain (which reads the dict).
soleImplDirect : Emit -> String -> String -> Int -> Option CImplEntry
soleImplDirect e name iface siteArity = match siteImpls e name iface siteArity
  [ent] => if implReqCount e name ent <= 0 then Some ent else None
  _ => None

-- the entries a site of [name] can reach: its interface's, at its arity
siteImpls : Emit -> String -> String -> Int -> List CImplEntry
siteImpls e name iface siteArity =
  narrowImplsByArity
    e
    name
    (narrowImplsByIface iface (implsOf e name))
    siteArity

-- The SITE-level form of the same test.  In prelude-object mode a dict-routed
-- site must NOT bake an impl decision into its enclosing define, because that
-- define may be a PRELUDE body destined for the shared `prelude.o` — and the sole
-- impl of a method in the prelude ALONE is not the sole impl in a program that
-- adds one (`impl Bimappable MyPair`).  Baking it there would be a silent
-- miscompile: `prelude.o` would direct-call the wrong impl forever.
--
-- So under `MEDAKA_PRELUDE_OBJ` every site routes through the shared dispatcher,
-- and the sole-impl shortcut moves INSIDE the dispatcher body (emitDispatcherDefine),
-- which is re-emitted per program from the WHOLE-program impl table.  The
-- null-dict property WS-1b exists for is preserved exactly: that body still makes
-- a direct call and still never loads `%dict` (see emitDispatcherDefine).
--
-- Mode 0 (every ordinary `medaka build`) is unchanged, so the default path's IR
-- stays byte-for-byte what it was.
soleImplDirectSite : Emit -> String -> String -> Int -> Option CImplEntry
soleImplDirectSite e name iface siteArity =
  if e.input.emitHalf == emitHalfWhole then
    soleImplDirect e name iface siteArity
  else
    None

-- ── issue #118 step 3: the shared prelude object (MEDAKA_PRELUDE_OBJ) ────────
-- 88% of a small program's emitted IR is the PRELUDE (270 of 281 defines, 9,935
-- of 11,841 lines on `test/wasm/fixtures/adt_enum_nullary.mdk` — a NINE-line
-- program), and `clang -O2` re-optimises all of it on every single build.  The fix
-- mirrors MEDAKA_RT_OBJ one level up: compile the prelude ONCE to `prelude.o`, and
-- per program emit only the program's own code plus `declare`s for what it uses.
--
-- This was IMPOSSIBLE until the dispatch chains were outlined (step 2, above): a
-- program's own `impl` decls would be INLINED into prelude function bodies, so no
-- one object could serve two programs.  With the chains outlined into shared
-- `@mdk_disp_*` dispatchers, prelude bodies are program-independent — verified by
-- emitting two programs differing only by an `impl Eq Color` and comparing all 249
-- shared prelude defines: ZERO structural differences (only the module-global
-- gensym counter shifts the `@mdk_lamN`/`@mdk_etac_*_N` names).
--
-- THREE MODES, selected by MEDAKA_EMIT_HALF (read by the emit driver):
--
--   0 WHOLE   (unset — every ordinary `medaka build`).  Untouched.  Every branch
--             this section adds is keyed on `emitHalfRef.value /= 0`, so the
--             default path's IR is byte-for-byte what it was.
--
--   1 PRELUDE (`medaka build --emit-prelude-obj <path>`).  Emit core.mdk ALONE, as
--             a library: no `@mdk_program_main`, `@mdk_g_*` globals declared
--             `external` (the program half defines and initialises them), and the
--             per-program symbol family `@mdk_disp_*` DECLARED, not defined.  (An
--             inherited default's `@mdk_default_*` body belongs to the instance
--             that inherits it, so a prelude instance's is ordinary prelude code
--             and a program instance's is program code.)
--
--   2 PROGRAM (a build with MEDAKA_PRELUDE_OBJ set).  Emit the whole program, but
--             replace every PRELUDE define's BODY with a `declare` (emitAsDeclares).
--             The prelude's bodies are still WALKED — that is what registers the
--             dispatchers `prelude.o` declares — their text is just dropped.
--
-- ⚠️ DCE MUST BE OFF in modes 1 and 2 (the emit driver does this).  Source DCE is
-- per-program, so an on-DCE prelude.o would ship only what the STUB reached; and an
-- on-DCE program half would walk fewer prelude bodies than prelude.o was built from
-- and so fail to define a dispatcher it declares.  The LINKER's `--gc-sections`
-- (already in the link line, issue #120) recovers the size, from the real
-- relocation graph rather than source reachability.
emitHalfWhole : Int
emitHalfWhole = 0

emitHalfPrelude : Int
emitHalfPrelude = 1

emitHalfProgram : Int
emitHalfProgram = 2

-- The gensym-id base for the PROGRAM half.  `freshId` names every LIFTED define —
-- `@mdk_lam_<scope>_N`, `@mdk_eta_*_<scope>_N`, `@mdk_pap_*` — and
-- those have external linkage, so if the two halves drew from the same range they
-- would collide on a symbol name (loudly, at link).  The halves are emitted by two
-- INDEPENDENT emitter runs, so give them disjoint ranges: the prelude half counts
-- up from 0, the program half from this base.  #2726 made the counter PER SCOPE,
-- which does not weaken the argument and does not strengthen it either: the two
-- halves can emit the same scope (the program half re-walks the prelude's own
-- bodies, `emitAsDeclares`), so the disjoint id ranges — not the scope word — stay
-- the thing that separates the names.  Every scope therefore starts at
-- `counter0`.  `preludeIdSpaceGuard` turns the
-- "0 .. base is enough for the prelude" assumption into a build-time check rather
-- than a hope — emitting core.mdk whole draws ~500 ids, four orders of magnitude
-- below the base — and it must check EVERY scope's counter, since any one of them
-- crossing the base is a collision.
programHalfIdBase : Int
programHalfIdBase = 1000000

preludeIdSpaceGuard : Emit -> Unit
preludeIdSpaceGuard e =
  if e.input.emitHalf == emitHalfPrelude then
    preludeIdSpaceGuardGo e (omKeys !e.counters)

preludeIdSpaceGuardGo : Emit -> List String -> Unit
preludeIdSpaceGuardGo _ [] = ()
preludeIdSpaceGuardGo e (k :: rest) =
  let n = optionOr e.counter0 (omLookup k !e.counters)
  if n >= programHalfIdBase then
    panic
      "prelude-object emit exhausted its gensym id space (scope '\{k}': \{intToString n} >= \{intToString programHalfIdBase}) — raise programHalfIdBase in llvm_emit.mdk"
  else
    preludeIdSpaceGuardGo e rest

-- The PRELUDE-owned symbols, installed by the emit driver in PROGRAM-half mode
-- (mode 2 only — in mode 1 every decl in the program IS the prelude).  Derived by
-- lowering core.mdk's decls on their own, so the classification comes from where a
-- decl was DEFINED, not from guessing at its emitted name.
-- Is this top-level bind / impl group one whose define lives in `prelude.o`?
-- Only ever True in mode 2.
hiddenBind : Emit -> String -> Bool
hiddenBind e name =
  e.input.emitHalf == emitHalfProgram && contains name e.input.preludeBinds

hiddenImplGroup : Emit -> ImplGroup -> Bool
hiddenImplGroup e (ImplGroup method _ key _ _ _ _ _) =
  e.input.emitHalf == emitHalfProgram && hasPreludeImpl e method key

hasPreludeImpl : Emit -> String -> String -> Bool
hasPreludeImpl e method key = match preludeImplSym e method key
  Some _ => True
  None => False

-- Run `act` (an ordinary emitFn/emitGroup), then throw its BODY TEXT away and keep
-- only a `declare` per define it produced.
--
-- Running it and discarding the output is the whole point, not waste: emitting a
-- prelude body is what REGISTERS the `@mdk_disp_*` dispatchers that `prelude.o`
-- only declares, so the program half defines exactly the set the prelude half
-- demanded.  The lifted lambdas/strings/
-- dict-cells it also produces land (dead) in `e.lams` and are dropped by
-- `--gc-sections` — they cost IR lines, not correctness, and their names cannot
-- collide with prelude.o's (disjoint gensym range, see programHalfIdBase).
--
-- Deriving the `declare` from the `define` line the emitter ACTUALLY produced —
-- rather than re-deriving the signature — is what makes the two halves' ABI
-- impossible to drift apart.  It also handles, for free, the cases where a bind
-- emits no define (a TMC dispatch-group MEMBER) or more than one (a float `__fw`
-- worker): whatever was emitted is exactly what gets declared.
emitAsDeclares : Emit -> (Unit -> Unit) -> Unit
emitAsDeclares e act =
  let saved = (bufRef e).value
  bufRef e := []
  let _ = act ()
  let produced = reverseL (bufRef e).value
  bufRef e := saved
  emitDeclaresFor e produced

emitDeclaresFor : Emit -> List String -> Unit
emitDeclaresFor _ [] = ()
emitDeclaresFor e (l :: rest) =
  let _ = match declareOfDefine l
    Some d => emit e d
    None => ()
  emitDeclaresFor e rest

-- `define i64 @f(i64 %a, i64 %b) {`  →  `declare i64 @f(i64 %a, i64 %b)`.
-- Every define the emitter writes has exactly this shape (verified: all 281 define
-- lines of the reference module end in `) {`); a line that does not is not a define
-- header and yields None.
declareOfDefine : String -> Option String
declareOfDefine l =
  let n = stringLength l
  if n > 9
    && stringSlice 0 7 l == "define "
    && stringSlice (n - 2) n l == " {" then
    Some ("declare " ++ stringSlice 7 (n - 2) l)
  else
    None

-- ── issue #118: the dispatch chain is OUTLINED, one per method ──────────────
-- INLINING the whole impl chain at a runtime-dict dispatch site — one `icmp` +
-- branch + call arm per impl of the method, at EVERY site — makes the emitted IR
-- grow as `Σ over sites of (#impls of that site's method)`, and it is the dominant
-- term in a small program's IR: on `test/wasm/fixtures/adt_enum_nullary.mdk` (9 lines
-- of source) there were 107 dispatch sites but only NINE distinct chains between
-- them — 2,123 emitted arms, ~80% of the module's 32,895 lines, to express 9 chains.
--
-- So the chain now lives ONCE, in a shared `@mdk_disp_<method>_<nMeth>_<nArgs>`
-- define, and the site is a single `call`.  The chain BODY is unchanged — the same
-- head-tag `icmp` arms in the same order, the same
-- `unreachable` tail — so every dispatch decision is byte-for-byte the one the inline
-- chain made; only its PLACEMENT moved.
--
-- The dispatcher's parameters are exactly what the inline chain read out of the
-- enclosing define, in that order:
--   %dict   — the dict-witness word (the enclosing fn's dict PARAM; `loadTag`/
--             `loadField` read the cell's head tag and per-instance `requires`).
--   %mwK    — the METHOD-LEVEL constraint dicts.  These are AMBIENT at the CALL site
--             (a `traverse : Thenable m =>` whose `m` is not the dispatch receiver),
--             so they are still resolved from `env` HERE and passed IN — they are not,
--             and never were, in the dict cell.
--   %argK   — the supplied value args.  Each selected arm compares that count with
--             its own definition-side callable arity and emits an exact call, PAP,
--             or over-application as required.
--
-- Both operand counts and the selected declaration arity are baked into the
-- dispatcher's name.  The arity suffix is omitted when it equals nargs to preserve
-- the established prelude ABI.
emitMethodDispatchChain : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List String ->
  (String, LTy)
emitMethodDispatchChain e env name iface siteArity dict methRoutes argOps =
  let dictPtr = dictWordOfRoute e env dict
  let methWords = dictWordsOf e env methRoutes
  let nmw = lengthS methWords
  let nargs = lengthS argOps
  let fname = dispFnName (dispMethodWord e name iface) nmw nargs siteArity
  let _ = ensureDispatcherEmitted e fname name iface nmw nargs siteArity
  emitImplCall e fname (dictPtr :: methWords ++ argOps) LTInt

-- the shared dispatcher's symbol: `mdk_disp_<method word>_<nmw>_<nargs>`.  Method
-- names are plain identifiers here (an operator is a `CBinPrim`, never a method
-- name — same assumption `implFnName` already makes).
dispFnName : String -> Int -> Int -> Int -> String
dispFnName methodWord nmw nargs siteArity =
  let base = "mdk_disp_\{methodWord}_\{intToString nmw}_\{intToString nargs}"
  if siteArity == nargs then base else "\{base}_a\{intToString siteArity}"

-- A dispatcher's arm set is its interface's alone (`siteImpls`), so a method two
-- interfaces declare needs one dispatcher per interface: its symbol carries the
-- interface word, `injectiveIdent`-encoded.  A method only one interface declares
-- keeps the bare name, and so does a prelude (`core::`) interface's method in every
-- case — a prelude body's dispatcher symbol must not depend on what the program
-- declares (the `prelude.o` precondition), and the prelude's own interfaces never
-- share a method spelling.
dispMethodWord : Emit -> String -> String -> String
dispMethodWord e name iface =
  if iface /= ""
    && not (startsWith "core::" iface)
    && omHasKey name e.input.sharedMethodNames then
    "\{injectiveIdent iface}_\{name}"
  else
    name

-- the dispatchers emitted so far, by symbol, scoped to this emission.

ensureDispatcherEmitted : Emit ->
  String ->
  String ->
  String ->
  Int ->
  Int ->
  Int ->
  Unit
ensureDispatcherEmitted e fname name iface nmw nargs siteArity =
  if contains fname !e.dispCache then
    ()
  else
    -- Register before emitting, so a dispatcher can never be emitted twice however
    -- its emission is reached.
    e.dispCache := fname :: !e.dispCache
    -- PRELUDE HALF: the dispatcher body enumerates every impl of the method in THIS
    -- program, so it is inherently per-program and must NOT be baked into the shared
    -- `prelude.o` — declare it and let the program half define it.  The program half
    -- re-walks the prelude's own bodies (emitAsDeclares), so it reaches this exact
    -- (name, nmw, nargs) site and DEFINES every dispatcher the prelude declares: the
    -- demand set is derived, never encoded, and a mismatch is a LOUD undefined symbol.
    withProgramScope e (_ =>
      if e.input.emitHalf == emitHalfPrelude then
        emitGlobal e "declare i64 @\{fname}(\{dispParamDecls nmw nargs})"
      else
        emitDispatcherDefine e fname name iface nmw nargs siteArity)

-- emit the shared dispatcher define.  Same side-buffer swap every other lifted define
-- uses (emitMethodValDefine/emitDictValDefine): redirect `buf`, emit, splice into
-- `lams`, restore.  `beginDefine` resets the per-define `%tN`/label counter, so the
-- dispatcher's text depends only on the method — not on where the first site of it
-- happened to appear (issue #118 step 1).
emitDispatcherDefine : Emit ->
  String ->
  String ->
  String ->
  Int ->
  Int ->
  Int ->
  Unit
emitDispatcherDefine e fname name iface nmw nargs siteArity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{fname}(\{dispParamDecls nmw nargs}) {"
  let _ = emit e "entry:"
  let (r, _) = emitDispatcherBody e name iface nmw nargs siteArity
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- The dispatcher's body.  Ordinarily (mode 0) this is only ever reached when the
-- method has ≥2 impls — soleImplDirect already diverted the sole-impl case to a
-- direct call at the SITE — so the `Some` arm below is dead and the emitted IR is
-- byte-identical to what it was.
--
-- Under MEDAKA_PRELUDE_OBJ the site no longer takes that shortcut
-- (soleImplDirectSite), so the shortcut lives HERE instead, where it is computed
-- from the whole-program impl table each build.  It reproduces WS-1b exactly: a
-- direct call to the sole impl that never touches `%dict` — which is what keeps an
-- ambiguous return-position superclass constraint's NULL dict from being
-- dereferenced.  `%mw`/`%dict` are simply left unread, as at the direct call site.
emitDispatcherBody : Emit ->
  String ->
  String ->
  Int ->
  Int ->
  Int ->
  (String, LTy)
emitDispatcherBody e name iface nmw nargs siteArity =
  match soleImplDirect e name iface siteArity
    Some ent =>
      -- F10: same saturation as emitDispatchArmBody — the selected interface's sole
      -- impl callable arity can still differ from the occurrence arity.
      emitKnownFnSat
        e
        (implEntryFnName e name ent)
        (dispWordNames "%arg" nargs 0)
        (methodArityOfEntry e ent name)
        LTInt
    _ =>
      emitDispatchBody
        e
        name
        iface
        "%dict"
        (dispWordNames "%mw" nmw 0)
        (dispWordNames "%arg" nargs 0)
        siteArity

dispParamDecls : Int -> Int -> String
dispParamDecls nmw nargs =
  argDecls
    ("%dict" :: dispWordNames "%mw" nmw 0 ++ dispWordNames "%arg" nargs 0)

dispWordNames : String -> Int -> Int -> List String
dispWordNames pre n i
  | i >= n = []
  | otherwise = pre ++ intToString i :: dispWordNames pre n (i + 1)

-- the dispatch chain itself, verbatim from the old inline site — now the BODY of the
-- shared dispatcher.  [dictPtr] is the dict-witness word, [methWords] the ambient
-- method-level constraint dicts (`emitDispatchChain` prepends them ahead of the
-- cell-sourced per-instance `requires`, matching the lifted fn's leading dict-param
-- order: dict_pass binds methRoutes ++ implRoutes), [argOps] the saturated value args.
emitDispatchBody : Emit ->
  String ->
  String ->
  String ->
  List String ->
  List String ->
  Int ->
  (String, LTy)
emitDispatchBody e name iface dictPtr methWords argOps siteArity =
  let headTag = loadTag e dictPtr
  let impls = siteImpls e name iface siteArity
  -- #1818: mint this ONCE per dispatch body — same set `gatherGroup` built these
  -- impls' own defines from — and thread it to every arm below, so `armArity`
  -- there is a lookup into what was already minted, not a fresh `groupImpls`
  -- walk per arm (which would also be O(program) per arm instead of once here).
  let groups = implGroupsForMethod e name
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "dispend" ++ intToString (freshLocal e)
  let _ =
    emitDispatchChain
      e
      dictPtr
      headTag
      impls
      groups
      name
      methWords
      argOps
      slot
      endL
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  (r, LTInt)

-- the count of leading element-dict params a matched impl's lifted fn expects:
-- `leadingDictPats` applied to THIS entry's own clause — a DIRECT count of the
-- `$dict_*`-named patterns dict_pass prepended, never a subtraction.  That is the
-- identical ruler `gatherGroup` sizes the define with (`nDicts = leadingDictPats
-- (firstClausePats cls0)`), so caller and callee agree by construction rather than
-- by coincidence.  Exact peer of wasm_emit's `implLeadingDictCountOfEntryW`, which
-- made this same choice for #717.
--
-- ⚠️ The old body was `listLen (implPats ent) - methodArityOfEntry e ent name`.
-- That agrees with the direct count only when the clause's VALUE-pattern count
-- equals `methodArityOfEntry`, which a POINT-FREE (eta-short) impl clause breaks:
-- `impl DictUser (Live a) requires Eq a where dictUser = selfEq` has
-- `pats = [$dict_dictUser_0]`, so `implSrcValueArity` reads `1 - 1 = 0`,
-- `methodArityOfEntry`'s `src > 0` guard never fires and it stays at the declared 1,
-- and the subtraction answered 0 leading dicts against a define that binds 1.  The
-- value argument then landed positionally in the dict slot — SIGSEGV.  The direct
-- count cannot skew that way.
--
-- The result is also the number of per-instance `requires` dicts stored in the boxed
-- dict cell (fields 1..count), so the runtime chain loads exactly that many and
-- prepends them.  Never negative.
implReqCount : Emit -> String -> CImplEntry -> Int
implReqCount _e _name ent = leadingDictPats (implPats ent)

-- #1648: the impl-`requires` dict words a DIRECT (RKey) call to [ent]'s lifted fn is
-- allowed to push — never more than that define actually BINDS.  dict_pass prepends an
-- impl method's `$dict_<method>_<slot>` params only when the body READS one
-- (typecheck.mdk's `usesImplDict` gate), while the CALL site stamps one route per
-- DECLARED `requires` unconditionally.  The two disagree exactly when the body ignores
-- its element dict: `impl Same (Box a) requires Eq a where bar (Box n) = n` is DEFINED
-- `@mdk_impl_Box_bar(i64 %arg0)` and was CALLED `@mdk_impl_Box_bar(i64 0, i64 %t3)`, so
-- the one surviving parameter bound positionally to the (null) DICT slot and the body
-- read a dictionary pointer where its value belonged — SIGSEGV, or a silent wrong
-- answer when nothing reads the mis-bound word.
-- This is the SAME skew, from the SAME cause, that eval already closes in
-- `implDictRoutes` (eval/eval.mdk, #413) and that the RUNTIME dispatch chain already
-- closes in `emitDispatchArmBody`'s `cellCount` — both by sizing the call from the
-- DEFINITION.  #413's comment claims "emit never had this bug"; that is true of the
-- dispatch chain and false of this static RKey path, which is #1648.  Same formula, so
-- the three now agree by construction: `implReqCount` counts the entry's own leading
-- `$dict_*` patterns DIRECTLY (`leadingDictPats (implPats ent)`) — the very ruler
-- `gatherGroup` mints the define with (`nDicts = leadingDictPats (firstClausePats
-- cls0)`) — of which the first `lengthS methRoutes` are the METHOD-level dicts,
-- leaving this impl's own share.  (It was briefly a SUBTRACTION — clause pattern count
-- less value arity — which is a DIFFERENT quantity for a POINT-FREE clause and reopened
-- #1648 for exactly that shape; see `implReqCount`'s own comment.)  The `maxInt 0`
-- below is vacuous for the count itself (a direct dict count is never negative) and
-- now only guards the `- lengthS methRoutes` subtraction.
-- An impl method that DOES read its
-- dict declares the param, so `implReqCount` covers every stamped route and the list is
-- returned whole: byte-identical for every impl outside this exact skew.
implRoutesForDefine : Emit ->
  String ->
  CImplEntry ->
  List Route ->
  List Route ->
  List Route
implRoutesForDefine e name ent methRoutes implRoutes =
  takeRoutes
    (maxInt 0 (implReqCount e name ent - lengthS methRoutes))
    implRoutes

-- the first [n] routes ([] for n <= 0 or a shorter list) — the local `takeN` this
-- module's truncating callers need, with no new import.  Exact peer of wasm_emit's
-- `takeRoutesW`, which the wasm arm has used for the SAME truncation since #717
-- (`emitMethodRef`'s RKey arm).  That arm's comment reads "Native gets away with it
-- (LLVM cdecl silently ignores extra args)"; #1648 is the measurement that it does
-- not — the surplus word shifts the value into the dict slot and the binary faults.
takeRoutes : Int -> List Route -> List Route
takeRoutes n (r :: rest)
  | n > 0 = r :: takeRoutes (n - 1) rest
takeRoutes _ _ = []

-- The super dictionaries a dictionary of [ent]'s interface stores ahead of its
-- `requires` dictionaries (see `dictWordOfRoute`).
entrySuperCount : CImplEntry -> Int
entrySuperCount ent = match installedDispositionsOpt ()
  Some table => ifaceSuperCount (implEntryIfaceWord ent) table
  None => 0

-- load dict words [i, n) from the boxed dict cell `dictPtr`.  The head tag is the
-- cell header (offset 0); field i is loaded by `loadField i` (offset 8*(i+1)), stored
-- by emitDictCell via storeFields at the same field indices.
loadReqDicts : Emit -> String -> Int -> Int -> List String
loadReqDicts e dictPtr n i
  | i >= n = []
  | otherwise = loadField e dictPtr i :: loadReqDicts e dictPtr n (i + 1)

-- emit ONE tagged-impl dispatch arm: test the dict head tag against this impl's route
-- key and, on a match, call the impl fn (prepending method-level + per-instance
-- `requires` dicts) and jump to `endL`; otherwise fall through to the `next` label the
-- caller continues after.
--
-- The matched impl's lifted fn expects `implReqCount` leading dict params, ordered
-- methRoutes ++ implRoutes.  The first `lengthS methWords` are METHOD-LEVEL
-- constraint dicts — already materialized from the caller's ambient args (env);
-- the remaining are this impl's per-instance `requires` dicts, loaded from the
-- runtime dispatch-dict cell's fields 0..k-1.  Sourcing the method-level ones from
-- the cell (the old behavior) was an OUT-OF-BOUNDS load whenever the dispatch dict
-- was a bare tag (no requires) → a garbage dict → SIGSEGV (e.g. `traverse` whose
-- `Thenable m =>` is over a tyvar that is not the `Traversable` receiver).
-- The arm tests the dictionary's word against this entry's canonical key: a word
-- names exactly one instance, the same one in every module, so one comparison
-- selects it.
emitDispatchArm : Emit ->
  String ->
  String ->
  CImplEntry ->
  List ImplGroup ->
  String ->
  List String ->
  List String ->
  String ->
  String ->
  Unit
emitDispatchArm e dictPtr headTag ent groups name methWords argOps slot endL =
  let cmp = freshReg e
  let _ =
    emit
      e
      "  \{cmp} = icmp eq i64 \{headTag}, \{intToString (hashName (implEntryKey ent))}"
  let n = intToString (freshLocal e)
  let yes = "dispyes" ++ n
  let next = "dispnext" ++ n
  let _ = emit e "  br i1 \{cmp}, label %\{yes}, label %\{next}"
  let _ = emit e (yes ++ ":")
  let _ =
    emitDispatchArmBody e dictPtr ent groups name methWords argOps slot endL
  emit e (next ++ ":")

-- the matched-arm body (emitDispatchArm): load the impl's per-instance cell
-- `requires` dicts, call its lifted fn, store the result, and jump to the dispatcher
-- exit.
emitDispatchArmBody : Emit ->
  String ->
  CImplEntry ->
  List ImplGroup ->
  String ->
  List String ->
  List String ->
  String ->
  String ->
  Unit
emitDispatchArmBody e dictPtr ent groups name methWords argOps slot endL =
  let symTag = implFnSymE e name ent
  -- #747: a nullary/return-position/no-requires impl reached through this runtime
  -- dispatch (no method-level or value args) is a per-instance CAF.  core_ir_lower
  -- synthesized a `$memo_<symTag>_<name>` lazy global for it (a LAZY value global —
  -- isLazyGlobal confirms it exists); FORCE that shared CAF instead of re-calling the
  -- impl fn, so the resolved tag's side effect runs once and is shared across every
  -- occurrence at that tag (matching eval's per-VTypedImpl memoThunk).  Each tag has
  -- its OWN `$memo` CAF ⇒ distinct tags memoise independently.
  if isEmptyL methWords
    && isEmptyL argOps
    && implEntryMemoisable ent
    && isLazyGlobal e (memoGlobalName symTag name) then
    let rv = freshReg e
    let _ =
      emit e "  \{rv} = call i64 @mdk_force_\{memoGlobalName symTag name}()"
    let _ = emit e "  store i64 \{rv}, ptr \{slot}"
    emit e ("  br label %" ++ endL)
  else
    -- #1816: CLAMP AT ZERO.  ⚠️ HISTORICAL, now VACUOUS for `implReqCount` itself.
    -- `implReqCount` USED TO be `listLen (implPats ent) - declared arity`, which went
    -- NEGATIVE for an ETA-SHORT clause -- exactly what an interface DEFAULT
    -- specialized into an impl is (`mapFirst f = bimap f identity` binds 1 of
    -- `mapFirst`'s 2 declared params).  `loadReqDicts` already treated a negative as
    -- zero, so the operand list was always right; but F10's `armArity` below ADDS this
    -- number back, and a negative there cancelled the declared arity straight down to
    -- `listLen (implPats ent)` -- under-applying the define `gatherGroup` mints at
    -- `maxInt (clauseArity) (declared + nDicts)`.  The arm then called an arity-2
    -- define with 1 operand and re-applied the rest to whatever came back, which is
    -- the E-NONEXHAUSTIVE-MATCH of #1816.
    -- `implReqCount` is now a DIRECT `leadingDictPats` count, which is never negative
    -- by construction, so it can no longer supply the negative #1816 described; the
    -- clamp is kept because the `- lengthS methWords` subtraction here is still a
    -- subtraction, and because #1818's `armArity` is read off the group rather than
    -- recomputed from `cellCount`.  Byte-identical either way for every shape the
    -- clamp fires on.
    let cellCount = maxInt 0 (implReqCount e name ent - lengthS methWords)
    let superCount = entrySuperCount ent
    -- an inherited default receives the dictionary that selected it
    let cellDicts =
      if isInheritedEntry ent then
        [dictPtr]
      else
        loadReqDicts e dictPtr (superCount + cellCount) superCount
    -- F10 (#1450/#1668 follow-on): SATURATE AGAINST THIS ARM'S OWN DECLARED ARITY.
    -- The dispatcher is keyed by BARE method name and its `%argK` count is the arity
    -- the SITE saw, so on an arity collision (two modules declaring same-spelled
    -- methods on unrelated interfaces) one arm's impl define -- which
    -- `gatherGroup` now mints at its interface's DECLARATION arity -- disagrees with
    -- that count, and a raw `emitImplCall` emitted a call whose argument count
    -- differed from its callee's parameter count.  That is UB, and it is the
    -- mismatch between a define minted at the DECLARATION arity and a call site
    -- reading the bare one.  `emitKnownFnSat` closes the
    -- gap WITHOUT re-opening which declaration supplies the arity: under-application
    -- becomes the residual PAP the source `op x` actually denotes, over-application
    -- the indirect re-apply.  Collision-free programs supply exactly the declared
    -- count, so this is the plain direct call, byte-identical.
    --
    -- #1818: `armArity` is now READ OFF `gatherGroup`'s own minted define-arity
    -- (`groupArity`, matched by `symTag` -- the exact identity `gatherGroup` used
    -- to name this same define), not independently recomputed.  Recomputing it as
    -- `methodArityOfEntry + lengthS methWords + cellCount` is a STRUCTURAL
    -- duplicate of `gatherGroup`'s `maxInt (clauseArity) (methodArityOfIface + nDicts)`
    -- -- the two are "coincidentally" equal, and #1816 was exactly the case where a
    -- negative `cellCount` broke that coincidence.  Consulting the group directly
    -- makes the two PROVABLY equal instead: this arm's call always saturates
    -- against the same number the callee's `define` actually has.  Every entry
    -- reaching this function -- concrete arm or general instance, supplied or
    -- inherited -- has exactly one group in `groups` (`groupImpls` groups every
    -- entry), so the fallback below is not expected to fire; it is kept as
    -- the pre-#1818 formula so a genuine miss degrades to the old (already-correct
    -- post-#1816) behavior rather than panicking.
    let armArity = match findGroupBySymTag symTag groups
      Some g => groupArity g
      None => methodArityOfEntry e ent name + lengthS methWords + cellCount
    let (rv, _) =
      emitKnownFnSat
        e
        (implEntryFnName e name ent)
        (methWords ++ cellDicts ++ argOps)
        armArity
        LTInt
    let _ = emit e "  store i64 \{rv}, ptr \{slot}"
    emit e ("  br label %" ++ endL)

-- #747: the synthesized per-instance CAF bind name for (symTag, method) — must match
-- core_ir_lower.memoBindName EXACTLY.  It does NOT re-encode: [symTag] is already
-- the selected symbol word: either a bare standalone-prelude tag or the encoded
-- whole-program collision key.  Both are already legal LLVM identifier fragments.
-- Adding an encode step here would break that agreement, not strengthen it.
memoGlobalName : String -> String -> String
memoGlobalName symTag method = "$memo_\{symTag}_\{method}"

-- every entry is a guarded arm, a general instance's too: its dictionary carries its
-- own canonical key.  A word no arm claims traps.
emitDispatchChain : Emit ->
  String ->
  String ->
  List CImplEntry ->
  List ImplGroup ->
  String ->
  List String ->
  List String ->
  String ->
  String ->
  Unit
emitDispatchChain e dictPtr headTag impls groups name methWords argOps slot endL =
  let _ =
    emitConcreteArms
      e
      dictPtr
      headTag
      impls
      groups
      name
      methWords
      argOps
      slot
      endL
  -- #1958: no arm matched -- a dict-key mismatch.  Trap loudly instead of a bare
  -- `unreachable`.
  let _ = emit e "  call void @mdk_dispatch_no_impl()"
  emit e "  unreachable"

emitConcreteArms : Emit ->
  String ->
  String ->
  List CImplEntry ->
  List ImplGroup ->
  String ->
  List String ->
  List String ->
  String ->
  String ->
  Unit
emitConcreteArms _ _ _ [] _ _ _ _ _ _ = ()
emitConcreteArms e dictPtr headTag (ent :: rest) groups name methWords argOps slot endL =
  let _ =
    emitDispatchArm e dictPtr headTag ent groups name methWords argOps slot endL
  emitConcreteArms e dictPtr headTag rest groups name methWords argOps slot endL

-- ── arg-position (arg-tag) dispatch at a call site ─────────────────
-- A method occurrence with no route (RNone), or a bare CVar naming an impl method,
-- applied to args.  The impl is chosen by the discriminating argument's runtime
-- constructor TYPE (mirrors eval's filterByTag → runtimeTypeTag), among the groups of
-- the occurrence's interface (`""` for a bare CVar, which narrows nothing).  Every
-- instance that inherits the method has a group of its own — an inherited default's
-- per-instance body — so the groups ARE the whole arm set:
--   • ONE group — no runtime test is needed: a well-typed call always reaches that
--     impl, so emit a DIRECT call (covers single-impl + the multi-clause-body
--     fixture; the multi-clause fall-through lives INSIDE the impl fn's decision
--     tree, note (n)/(o)).
--   • SEVERAL groups — load the discriminating argument's cell tag and emit an
--     if-chain: for each group, test whether the loaded ctor tag is one the group's
--     TYPE owns (OR over its constructors' hashName, via ctorsOfType), and on a match
--     call that group's impl fn.  An exhausted chain calls the terminal
--     `@mdk_dispatch_no_impl` trap — loud at run time, not `unreachable` (the
--     typechecker proves a real impl exists, but not that this site can emit an arm
--     for every head that reaches it, e.g. a primitive head, which owns no
--     constructors — #1075).
--     The discriminating arg may be an IMMEDIATE nullary ctor, so the tag is read
--     via `loadDiscriminant` (low-bit branch), not a bare `loadTag` (note (p)).
emitMethodArgDispatch : Emit ->
  String ->
  String ->
  Int ->
  List String ->
  (String, LTy)
emitMethodArgDispatch e method iface siteArity argOps =
  match implGroupsForMethodArity e method iface siteArity
    [] => emitDefaultArgTag e method argOps
    [g] => emitImplCallSat e (groupFnName g) argOps (groupArity g) LTInt
    groups =>
      emitArgTagDispatch e method groups argOps (argTagCollidingHeads groups)

-- #2445: every chain arm tests the receiver's constructor tag.  Two groups at the
-- same head therefore create indistinguishable tests, so the guard is emitted inside
-- the colliding arm as `@mdk_dispatch_ambiguous`.  This keeps declarations at an
-- unreachable colliding head from rejecting the whole program while making an
-- actually received ambiguous value loud.  The groups are the occurrence's own
-- interface's, so two unrelated same-spelled interfaces never false-collide.
argTagCollidingHeads : List ImplGroup -> List String
argTagCollidingHeads groups = dupStrings (map groupTag groups) [] []

-- the members of [xs] that occur more than once, each reported once.
dupStrings : List String -> List String -> List String -> List String
dupStrings [] _ dups = reverseL dups
dupStrings (x :: rest) seen dups
  | contains x seen && not (contains x dups) = dupStrings rest seen (x :: dups)
  | otherwise = dupStrings rest (x :: seen) dups

-- is THIS arm's head tag one the runtime constructor tag cannot decide?
argTagArmAmbiguous : List String -> String -> Bool
argTagArmAmbiguous colliding tag = contains tag colliding

-- the trapped arm body: loud at run time, in place of the impl call this arm would
-- otherwise make.  `noreturn`, so the block does not fall through.
emitAmbiguousArm : Emit -> Unit
emitAmbiguousArm e =
  let _ = emit e "  call void @mdk_dispatch_ambiguous()"
  emit e "  unreachable"

-- an arg-tag site whose interface has no impl groups at all for the method: nothing
-- can be called, so the site is an honest gap rather than a guess.
emitDefaultArgTag : Emit -> String -> List String -> (String, LTy)
emitDefaultArgTag e method argOps =
  gapE
    e
    ("arg-tag dispatch for method '"
      ++ method
      ++ "' has no impl groups (unresolved RNone fallback)")

emitArgTagDispatch : Emit ->
  String ->
  List ImplGroup ->
  List String ->
  List String ->
  (String, LTy)
emitArgTagDispatch e method groups argOps colliding
  | headPos (groupPositionsOf (headGroup groups)) >= lengthS argOps =
    gapE
      e
      ("arg-tag dispatch for method '"
        ++ method
        ++ "': discriminating arg position not supplied (under-applied / unapplied method)")
  | otherwise =
    emitArgTagDispatchGo
      e
      groups
      argOps
      colliding
      (headPos (groupPositionsOf (headGroup groups)))

emitArgTagDispatchGo : Emit ->
  List ImplGroup ->
  List String ->
  List String ->
  Int ->
  (String, LTy)
emitArgTagDispatchGo e groups argOps colliding discrimPos =
  let discrimWord = nthStr argOps discrimPos
  let tagReg = loadDiscriminant e discrimWord
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "argdispend" ++ intToString (freshLocal e)
  let _ = emitArgDispatchChain e tagReg groups argOps colliding slot endL
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  (r, LTInt)

emitArgDispatchChain : Emit ->
  String ->
  List ImplGroup ->
  List String ->
  List String ->
  String ->
  String ->
  Unit
-- the arms are exhausted: #1958's loud trap, never a bare `unreachable`, which is UB
-- that `clang -O1+` may fold the preceding tests away against.
emitArgDispatchChain e _ [] _ _ _ _ =
  let _ = emit e "  call void @mdk_dispatch_no_impl()"
  emit e "  unreachable"
-- An inherited default at a head that owns no runtime constructors (a primitive)
-- cannot be tag-tested, so it gets no arm and a receiver of that head reaches the
-- trap (#1075).
emitArgDispatchChain e tagReg (g :: rest) argOps colliding slot endL
  | groupInherits g && isEmptyL (ctorsOfType e (groupTag g)) =
    emitArgDispatchChain e tagReg rest argOps colliding slot endL
emitArgDispatchChain e tagReg (g :: rest) argOps colliding slot endL =
  let tag = groupTag g
  let cond = emitTagMatch e tagReg (ctorsOfType e tag)
  let n = intToString (freshLocal e)
  let yes = "argyes" ++ n
  let next = "argnext" ++ n
  let _ = emit e "  br i1 \{cond}, label %\{yes}, label %\{next}"
  let _ = emit e (yes ++ ":")
  -- #2445: the tag TEST is still emitted — it is what scopes the trap to the receivers
  -- that actually reach this head — but the arm body becomes the loud trap, because two
  -- or more declared impls answer to this one constant and the call this arm would make
  -- is a coin-flip between them.  Every sibling arm at a non-colliding head is
  -- untouched.  The trap is `noreturn`, so this block terminates and no `store`/`br` to
  -- the join label follows.
  let _ =
    if argTagArmAmbiguous colliding tag then
      emitAmbiguousArm e
    else
      -- F10: saturate against this group's own declared arity, the same answer the
      -- single-group site above already takes (see emitDispatchArmBody).
      let (rv, _) = emitKnownFnSat e (groupFnName g) argOps (groupArity g) LTInt
      let _ = emit e "  store i64 \{rv}, ptr \{slot}"
      emit e ("  br label %" ++ endL)
  let _ = emit e (next ++ ":")
  emitArgDispatchChain e tagReg rest argOps colliding slot endL

-- an i1 that is true when the loaded ctor tag equals ANY of a type's constructor
-- tags (OR-chain of icmp eq against each hashName).
emitTagMatch : Emit -> String -> List String -> String
emitTagMatch e _ [] =
  gapStr
    e
    "arg-tag dispatch on impl type that owns no constructors (primitive receiver carries no cell tag)"
emitTagMatch e tagReg [c] =
  let r = freshReg e
  let _ = emit e "  \{r} = icmp eq i64 \{tagReg}, \{intToString (cellTag e c)}"
  r
emitTagMatch e tagReg (c :: rest) =
  let r = freshReg e
  let _ = emit e "  \{r} = icmp eq i64 \{tagReg}, \{intToString (cellTag e c)}"
  let rrest = emitTagMatch e tagReg rest
  let o = freshReg e
  let _ = emit e "  \{o} = or i1 \{r}, \{rrest}"
  o

-- the impl groups of one method, in program order.
implGroupsForMethod : Emit -> String -> List ImplGroup
implGroupsForMethod e method =
  filterGroupsByMethod method (groupImpls e (implEntriesOf e))

implGroupsForMethodArity : Emit -> String -> String -> Int -> List ImplGroup
implGroupsForMethodArity e method iface siteArity =
  let entries = siteImpls e method iface siteArity
  filterGroupsForEntries e method entries (implGroupsForMethod e method)

filterGroupsForEntries : Emit ->
  String ->
  List CImplEntry ->
  List ImplGroup ->
  List ImplGroup
filterGroupsForEntries _ _ _ [] = []
filterGroupsForEntries e method entries (g :: rest) =
  if anyList
    (entry => implEntryFnName e method entry == groupFnName g)
    entries then
    g :: filterGroupsForEntries e method entries rest
  else
    filterGroupsForEntries e method entries rest

filterGroupsByMethod : String -> List ImplGroup -> List ImplGroup
filterGroupsByMethod _ [] = []
filterGroupsByMethod method (g :: rest)
  | groupMethodOf g == method = g :: filterGroupsByMethod method rest
  | otherwise = filterGroupsByMethod method rest

groupTag : ImplGroup -> String
groupTag (ImplGroup _ tag _ _ _ _ _ _) = tag

groupSymTag : ImplGroup -> String
groupSymTag (ImplGroup _ _ _ symTag _ _ _ _) = symTag

-- the symbol of the group's lifted define (see `implEntryFnName`)
groupFnName : ImplGroup -> String
groupFnName (ImplGroup _ _ _ _ _ _ _ fname) = fname

-- is this group an inherited default's per-instance body?
groupInherits : ImplGroup -> Bool
groupInherits g = startsWith defaultFnPrefix (groupFnName g)

groupMethodOf : ImplGroup -> String
groupMethodOf (ImplGroup m _ _ _ _ _ _ _) = m

groupPositionsOf : ImplGroup -> List Int
groupPositionsOf (ImplGroup _ _ _ _ p _ _ _) = p

-- #1818: the arity `gatherGroup` MINTED for this group's `define` — the single
-- number every F10 call site should consult rather than re-derive.  See
-- `armArityOfEntry` below, the one caller that must not recompute it.
groupArity : ImplGroup -> Int
groupArity (ImplGroup _ _ _ _ _ arity _ _) = arity

-- the group among [groups] whose lifted define is `@mdk_impl_<symTag>_<method>` —
-- i.e. the one `gatherGroup` built for the SAME impl an entry-holding call site
-- names.  `symTag` (`implFnSymE`) is exactly the identity `gatherGroup` used to
-- name that define (`implFnSymForKey` over the same entries + prelude map), so this is a
-- same-identity lookup, not a second guess: any hit is THE group whose `arity`
-- field is what the define was actually emitted to accept.
findGroupBySymTag : String -> List ImplGroup -> Option ImplGroup
findGroupBySymTag _ [] = None
findGroupBySymTag symTag (g :: rest)
  | groupSymTag g == symTag = Some g
  | otherwise = findGroupBySymTag symTag rest

headGroup : List ImplGroup -> ImplGroup
headGroup (g :: _) = g
headGroup [] = panic "llvm: no impl group for arg-tag dispatch"

-- the discriminating arg position (first dispatch position; default 0 — for a
-- single-position method like `eq` the head suffices, both args share the type).
headPos : List Int -> Int
headPos (p :: _) = p
headPos [] = 0

nthStr : List String -> Int -> String
nthStr (x :: _) 0 = x
nthStr (_ :: rest) i = nthStr rest (i - 1)
nthStr [] _ = panic "llvm: discriminating arg index out of range"

-- a constrained-function occurrence (CDict): `name` is a `=>`-constrained function
-- that dict_pass gave leading dict PARAMETERS; the routes give the dict values for
-- this call site.  Lower to a direct call passing the dict words FOLLOWED by the
-- real argument words — the same order applyDicts prepends them at run time and
-- the order emitFn bound `name`'s leading dict params.
emitDictApp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Route ->
  List String ->
  (String, LTy)
emitDictApp e env name routes argOps =
  if isLocal env name then
    emitLocalDictApp e env name routes argOps
  else if isKnownFn e name then
    let dictWords = dictWordsOf e env routes
    let allWords = dictWords ++ argOps
    -- E22: measure a constrained call against the RECORDED define arity.  A short
    -- call needs a residual PAP; a surplus must apply to the returned closure
    -- instead of being silently ignored by the fixed-arity LLVM define.
    match defArityOf e name
      Some n => emitKnownFnSat e ("mdk_" ++ name) allWords n (fnRetTy e name)
      None => emitDictAppDirect e name allWords
  else
    gapE e ("CDict head '" ++ name ++ "' is not a known top-level function")

-- A dictionary-abstracted LOCAL binding is a closure whose leading parameters are
-- its dictionaries: apply it to the dict words, then the argument words.
emitLocalDictApp : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Route ->
  List String ->
  (String, LTy)
emitLocalDictApp e env name routes argOps =
  let (cw, _) = lookupVarG e env name
  let dictWords = dictWordsOf e env routes
  emitIndirectArity e cw (dictWords ++ argOps) (CVar name AGlobal)

-- the plain direct constrained-fn call: dict words followed by the real arg words,
-- in the order dict_pass bound `name`'s leading dict params (the historical lowering).
emitDictAppDirect : Emit -> String -> List String -> (String, LTy)
emitDictAppDirect e name allWords =
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_\{name}(\{argDecls allWords})"
  (r, fnRetTy e name)

-- the dict witness words for a constrained-function call's routes (note (j)).
dictWordsOf : Emit -> OrdMap (String, LTy) -> List Route -> List String
dictWordsOf e env rs = map (dictWordOfRoute e env) rs

-- one route -> its dict witness word (GAP 1, Option A — BOXED dict witness).
-- A dict witness is a POINTER to a heap cell
-- `[ i64 head_tag | i64 super_0 | … | i64 reqdict_0 | … ]` allocated via @mdk_alloc
-- (the same boxed-cell shape emitCtorAlloc uses): field 0 is
-- `hashName(impl-head-tag)`, then one RECURSIVELY-built witness word per direct
-- superinterface of the dictionary's interface (declaration order), then one per
-- impl's per-instance `requires` dict, in `reqs` order (matching the interpreter's
-- structured `VDict key reqs supers` and the leading dict-param order dict_pass
-- binds — methRoutes then implRoutes, here the impl's own requires).  Supers come
-- first so that a projection indexes the same field whichever instance the
-- dictionary is; a dispatch arm skips them by its interface's super count.  This makes the rep UNIFORM: a one-level dict (`RKey k []`) is a
-- pointer to a 1-word cell `[ hashName k ]`; a two-level dict nests another cell
-- pointer in field 1.  Consumption (emitDispatchChain / the RKey direct-call path)
-- loads field 0 for the icmp and prepends fields 1..n as the matched impl's leading
-- element-dict args.  RDict/RDictFwd forward the enclosing dict parameter's word
-- (already a boxed-cell pointer); RNone is the 0 dict (no cell).
dictWordOfRoute : Emit -> OrdMap (String, LTy) -> Route -> String
dictWordOfRoute e env (RKey key reqs sups) =
  let fieldWords = dictWordsOf e env (sups ++ reqs)
  if allConstWords fieldWords then
    emitConstDictCell e (hashName key) fieldWords
  else
    emitDictCell e (hashName key) fieldWords
dictWordOfRoute e env (RDict d) = dictOperand e env d
dictWordOfRoute e env (RDictFwd d) = dictOperand e env d
dictWordOfRoute e env (RProj r path) =
  loadSuperPath e (dictWordOfRoute e env r) path
dictWordOfRoute _ _ RNone = "0"
-- S-1: RLocal's own dicts are the call's leading dict ARGS (emitted by emitMethod's
-- RLocal arm via emitDictApp), not a dict WITNESS for this route — so as a witness it
-- stays the no-op 0 dict, mirroring eval's `dictOfRoute (RLocal _ _) = VDict "" []`.
dictWordOfRoute _ _ (RLocal _ _) = "0"

-- the super dictionary at [path] below the dictionary word [w]: a super index i is
-- cell field i
loadSuperPath : Emit -> String -> List Int -> String
loadSuperPath _ w [] = w
loadSuperPath e w (i :: rest) = loadSuperPath e (loadField e w i) rest

-- allocate a boxed dict-witness cell `[ i64 headTag | i64 req_0 | … | i64 req_(n-1) ]`
-- via @mdk_alloc and return its pointer word (ptrtoint).  Mirrors emitCtorAlloc's
-- header+fields layout (header at offset 0, field i at 8*(i+1)) so loadField /
-- loadTag read it back without type info.  A one-word cell (no reqs) is the
-- uniform one-level dict.
emitDictCell : Emit -> Int -> List String -> String
emitDictCell e headTag reqWords =
  let n = lengthS reqWords
  let p = freshReg e
  let _ =
    emit e "  \{p} = call ptr @mdk_alloc(i64 \{intToString (8 * (n + 1))})"
  let _ = emit e "  store i64 \{intToString headTag}, ptr \{p}"
  let _ = storeFields e p reqWords 0
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  w

-- ── constant dict-witness hoisting (perf/dict-const) ────────────────────────
-- A dict witness whose head tag and every requirement word are compile-time
-- constants (a one-level `RKey k []` → `[hashName k]`, or a nested RKey whose reqs
-- are themselves constant) does NOT need a per-call `@mdk_alloc`: the cell is
-- immutable and identical at every invocation. Emit it ONCE as an `internal
-- constant` module global and pass `ptrtoint (ptr @g to i64)` — eliminating the
-- per-invocation allocation that dominated dispatch-heavy polymorphic loops (~4×
-- on a tight `Ord` loop; broad — every constant dict across stdlib/compiler/user
-- code). Deduped by initializer content WITHIN one scope, so identical dicts in
-- one module share a global and two modules get one apiece (`constCellKey`).

-- every dict word is a compile-time constant (not a runtime %register): a literal
-- tag, "0" (RNone), or a `ptrtoint`-of-global constant-expr (a nested const dict).
allConstWords : List String -> Bool
allConstWords [] = True
allConstWords (w :: rest) = not (startsWith "%" w) && allConstWords rest

constDictReqInits : List String -> String
constDictReqInits [] = ""
constDictReqInits (w :: rest) = ", i64 \{w}\{constDictReqInits rest}"

-- emit (or reuse) a module-global constant dict cell; return its pointer-as-i64
-- constant-expr. Layout byte-identical to emitDictCell's heap cell, so every
-- consumer (RKey dispatch loadField, nested-dict store, call arg) reads it the same.
emitConstDictCell : Emit -> Int -> List String -> String
emitConstDictCell e headTag reqWords =
  let n = lengthS reqWords
  let initBody =
    "[\{intToString (n + 1)} x i64] [i64 \{intToString headTag}\{constDictReqInits reqWords}]"
  let key = constCellKey e initBody
  match lookupAssoc key !e.dictConstCache
    Some gname => "ptrtoint (ptr @" ++ gname ++ " to i64)"
    None =>
      let gname = "mdk_dc" ++ mangleScoped e
      let _ = emitGlobal e "@\{gname} = internal constant \{initBody}"
      e.dictConstCache := (key, gname) :: !e.dictConstCache
      "ptrtoint (ptr @" ++ gname ++ " to i64)"

-- The constant-cell cache key.  #2753 review S2-1: keying on the initializer text
-- ALONE made the caches program-global while the names they mint are per-scope,
-- so the first module to need a body owned the cell and every later module
-- referenced it — 217 cross-partition references on the CLI IR, and a one-line
-- edit to `frontend/desugar.mdk` moved 25 of 77 partitions.  Prefixing the scope
-- word confines a cell to the scope that minted it: a duplicate `internal
-- constant` per scope instead of one shared global.  Sound because consumers
-- LOAD the cell's fields and nothing compares cell addresses (the layout is
-- byte-identical to `emitDictCell`'s heap cell, which is per-call anyway).
-- `|` is outside `private_mangle.safeChar`'s alphabet, so it cannot occur in a
-- scope word and the two components can never blur.
constCellKey : Emit -> String -> String
constCellKey e initBody = "\{scopeWord e}|\{initBody}"

-- the operand word a dict parameter name is bound to in the emit env.
dictOperand : Emit -> OrdMap (String, LTy) -> String -> String
dictOperand e env d = match omLookup d env
  Some (op, _) => op
  None =>
    gapStr
      e
      ("unbound dict witness '"
        ++ d
        ++ "' in emit env (dict not threaded to this site)")

-- ── impl method definitions ─────────────────────────────────────────────────
-- Each typeclass impl method lowers to ONE top-level `@mdk_impl_<tag>_<method>`,
-- emitted alongside the ordinary function defines (before @main); an inherited
-- default's per-instance body (`CImplDefault`) is emitted the same way under
-- `defaultFnName`.
--
-- SLICE 7 — multi-clause / arg-position impl methods.  The Core IR carries one
-- CImplEntry PER CLAUSE (eval coalesces same-named candidates into a VMulti that
-- falls through arg-by-arg, leftmost clause winning — exactly Maranget column
-- specialization, see ceval/applyOpt/collectPartials).  So same-`(method,tag)`
-- entries are COALESCED here into a single lifted fn whose body is a decision
-- tree built by the SAME `compileTree` the match lowering uses (Axis-1: shared
-- backend-neutral pass).  By arity:
--   • 0 (slice-6 nullary return-position `zero`/`def`): the body is emitted in
--     TAIL position (emitFnBody), byte-for-byte the old single-clause path.
--   • 1: the lone param `%arg0` is the scrutinee; the clauses' single patterns
--     are the match arms.
--   • ≥2: the params are wrapped in a synthetic tuple `(a0, a1, …)` so the
--     multi-param match reduces to a single scrutinee — letting emitDecision /
--     emitTree / bindPattern be reused VERBATIM (note (o); one extra `$tuple`
--     cell alloc per call, acceptable for the spike).

-- a coalesced impl group: method, type-head tag, canonical impl key, the SYMBOL
-- tag (= the standalone prelude tag for an owned row; otherwise head tag when
-- this is the sole impl at that head, else the encoded canonical key — C7), the
-- dispatch positions, arity, and the clauses (patterns + body) in source order
-- (leftmost-first — the priority the decision tree preserves).
data ImplGroup =
  | ImplGroup String String String String (List Int) Int (List (List Pat, CExpr)) String

-- #2726: the gensym scope of an impl group — its OWN emitted symbol, prefixed so
-- the marker reads as what it is (`impl:List_eq`) and can never be confused with
-- a module id.  `scopeWordOf` maps the `:` out again for the LLVM name form.
implGroupScope : ImplGroup -> String
implGroupScope (ImplGroup method _ _ symTag _ _ _ _) =
  "impl:\{symTag}_\{method}"

emitImpls : Emit -> List CImplEntry -> Unit
emitImpls e entries = emitGroups e (groupImpls e entries)

emitGroups : Emit -> List ImplGroup -> Unit
emitGroups _ [] = ()
emitGroups e (g :: rest) =
  -- #2726: an impl group gets its OWN scope, not a module's.  Its module is not
  -- in the emitter's inputs at all — `DImpl.implOrigin` is the identity of the
  -- INTERFACE the impl names, not of the module that wrote the impl — and a
  -- per-group scope is in any case more local than any bucket it could share.
  let _ = setScope e (implGroupScope g)
  -- PROGRAM half (issue #118): same treatment as a prelude fn bind — see emitFns.
  let _ =
    if hiddenImplGroup e g then
      emitAsDeclares e (_ => emitGroup e g)
    else
      emitGroup e g
  emitGroups e rest

emitGroup : Emit -> ImplGroup -> Unit
emitGroup e (ImplGroup method tag key _ positions arity clauses fname) =
  let iface = ifaceNameOfWord (ifaceWordOfKey key)
  let selfFnPos = selfFnParamPositions e iface method
  let _ = setCurImplSelfFns e tag (selfFnParamNames clauses selfFnPos)
  if trmcImplTry e fname method tag key positions arity clauses then
    let _ = clearCurImplSelfFns e
    ()
  else
    let _ = beginDefine e
    let _ = emit e "define i64 @\{fname}(\{implParamDecls arity 0}) {"
    let _ = emit e "entry:"
    let _ = emitGroupBody e fname tag positions arity clauses
    let _ = clearCurImplSelfFns e
    let _ = emit e "}"
    emit e ""
-- native backend: set the self-returning-fn-param context for this impl body so
-- `emitIndirect` types `f x` (a callback returning the container) as the impl's
-- own type.  The self-fn positions come from the method's signature (keyed by
-- iface, looked up from the resolved impl entry); their names are the PVar names
-- the clauses bind at those positions.  (Set BEFORE choosing the TRMC vs ordinary
-- body so a cons-head callback `f x` — e.g. `map`'s `f x :: …` — types correctly.)

-- Phase 2 B-dispatch (TRMC-DESIGN.md): a DISPATCHED self-recursive cons/ctor-tail
-- impl method (`map`/`filterMap`/`ap` over List, recursing via a `CMethod method
-- (RKey tag)` node) is emitted as an O(1)-stack destination-passing loop, just like
-- a top-level builder.  Scope: uniform-leading-dict impls (`dictUniformPairs`); a
-- point-free eta-reshaped impl (`filter p = filterMap …`) is a single dispatched
-- call, NOT cons-tail-recursive, so `trmcEligible` rejects it (stays ordinary).

-- Phase 2 B-dispatch: try to emit an impl group as a TRMC destination-passing loop.
-- Returns True (and emits the whole define) when the impl is F2(a)/F2(b)-shape-(a)
-- eligible: uniform leading-dict count (`dictUniformPairs` — dicts are admitted as
-- ordinary loop slots) and cons/ctor-tail self-recursive via its own `CMethod method
-- (RKey tag)` dispatch (`trmcEligible (SelfByMethod …)`).  Otherwise returns False so
-- emitGroup falls back to the ordinary `emitGroupBody`.  The loop body reuses
-- emitTrmcLoopBody verbatim (the shared Axis-A machinery); the impl path supplies the
-- `@mdk_impl_<tag>_<method>` define name, the receiver-typed `aK` scrutinee env
-- (`patPosTys`), and the SelfByMethod self-ref for the cons/ctor leaf's self-call
-- recognition + the safety-critical `mentionsSelfMethod` disqualification.
trmcImplTry : Emit ->
  String ->
  String ->
  String ->
  String ->
  List Int ->
  Int ->
  List (List Pat, CExpr) ->
  Bool
-- [key] is the instance's canonical key, the word its own self-calls route on;
-- [tag] is its head tag, which types the receiver slots.
trmcImplTry e fname method tag key positions arity clauses =
  let self = methodSelf method key (firstClausePats clauses)
  if arity > 0
    && dictUniformPairs clauses
    && trmcEligible (isCtor e) (ctorArity e) self arity clauses then
    let slotTys = patPosTys tag positions arity 0
    let (spats, sbody) = match clauses
      (ps, b) :: _ => (ps, b)
      [] => ([], CLit LUnit)
    let single = listLen clauses == 1 && allClausesPVar clauses
    let _ = tmcMarker e fname "trmc"
    let _ = emitTrmcHeader e fname arity
    let _ =
      emitTrmcLoopBody e self arity slotTys clauses single spats sbody noDeclLoc
    let _ = emit e "}"
    let _ = emit e ""
    True
  else
    False

maxInt : Int -> Int -> Int
-- Intentional: this IS the compiler's hot monomorphic Int max (AGENTS.md
-- anti-pattern: don't delegate hot inner-loop helpers to the dict-passed
-- prelude Ord method).
-- lint-disable-next-line rule-if-max-min
maxInt a b = if a >= b then a else b

-- eta-expand `pats`/`body` from `have` params to `arity` by appending fresh
-- `$etaK` params and applying the body to each (left-to-right).
etaExpand : List Pat -> CExpr -> Int -> Int -> (List Pat, CExpr)
etaExpand pats body arity have
  | have >= arity = (pats, body)
  | otherwise =
    let name = "$eta" ++ intToString have
    etaExpand
      (pats ++ [PVar name (Loc "" 0 0 0 0)])
      (CApp body (CVar name AGlobal))
      arity
      (have + 1)

-- the PVar names bound at the self-fn positions, taken from the FIRST clause that
-- binds a plain variable there (impl callback params are PVars across clauses; a
-- non-PVar position contributes no name and is simply not typed specially).
selfFnParamNames : List (List Pat, CExpr) -> List Int -> List String
selfFnParamNames clauses positions =
  dedupS (concatMapClausePVars clauses positions)

concatMapClausePVars : List (List Pat, CExpr) -> List Int -> List String
concatMapClausePVars [] _ = []
concatMapClausePVars ((pats, _) :: rest) positions =
  pvarsAtPositions pats positions 0 ++ concatMapClausePVars rest positions

pvarsAtPositions : List Pat -> List Int -> Int -> List String
pvarsAtPositions [] _ _ = []
pvarsAtPositions ((PVar x _) :: rest) positions i
  | listContains positions i = x :: pvarsAtPositions rest positions (i + 1)
  | otherwise = pvarsAtPositions rest positions (i + 1)
pvarsAtPositions (_ :: rest) positions i =
  pvarsAtPositions rest positions (i + 1)

-- the lifted impl fn's positional parameter list: `i64 %arg0, …` (arity words),
-- or "" for a nullary return-position impl.
implParamDecls : Int -> Int -> String
implParamDecls n i
  | i >= n = ""
  | i == n - 1 = "i64 %arg" ++ intToString i
  | otherwise = "i64 %arg\{intToString i}, \{implParamDecls n (i + 1)}"

-- bind each positional param to its `%argK` operand under a synthetic name aK
-- (the names the synthetic scrutinee CVars reference).
implParamEnv : Int -> Int -> OrdMap (String, LTy)
implParamEnv n i
  | i >= n = omEmpty
  | otherwise =
    omInsert
      ("a" ++ intToString i)
      ("%arg" ++ intToString i, LTInt)
      (implParamEnv n (i + 1))

-- map an impl head tag name to its static LTy for use in param typing.
-- Known primitives → their type (a fixed-width `U8`/`U16`/`U32`/`I32` is an Int
-- word, a `U64` or `I64` its boxed cell);
-- everything else (ADT, List, Array, tuples, …) → LTCon.
tagToLTy : String -> LTy
tagToLTy "String" = LTStr
tagToLTy "Int" = LTInt
tagToLTy "Float" = LTFloat
tagToLTy "Bool" = LTBool
tagToLTy "Char" = LTChar
tagToLTy "U64" = LTU64
tagToLTy "I64" = LTI64
tagToLTy t = if isTaggedFixedHead t then LTInt else LTCon

-- like implParamEnv, but types param `i` as `tagToLTy tag` when `i ∈ positions`
-- (the receiver-type positions from CImplTagged), otherwise LTInt.
-- This lets `append xs ys = xs ++ ys` in impl Semigroup (List a) emit xs/ys as
-- LTCon → mdk_list_append, and in impl Semigroup String emit them as LTStr →
-- mdk_string_append — without touching emitBin.
implParamEnvByPos : String -> List Int -> Int -> Int -> OrdMap (String, LTy)
implParamEnvByPos _ _ n i
  | i >= n = omEmpty
implParamEnvByPos tag positions n i =
  let ty = if listContains positions i then tagToLTy tag else LTInt
  omInsert
    ("a" ++ intToString i)
    ("%arg" ++ intToString i, ty)
    (implParamEnvByPos tag positions n (i + 1))

listContains : List Int -> Int -> Bool
listContains [] _ = False
listContains (x :: rest) v
  | x == v = True
  | otherwise = listContains rest v

emitGroupBody : Emit ->
  String ->
  String ->
  List Int ->
  Int ->
  List (List Pat, CExpr) ->
  Unit
emitGroupBody e fname _ _ 0 [([], body)] = emitFnBody e omEmpty fname body
emitGroupBody e fname _ _ 0 _ =
  gapU e "nullary impl group with more than one clause"
-- Fast path: single-clause all-PVar impl (e.g. `append xs ys = xs ++ ys`).
-- Build a typed env directly from param names × receiver type so that `++`/`::`
-- operands inherit the correct LTy (LTStr/LTCon) from the impl head tag.
-- The decision-tree path (emitClauseTree) loses this type info through the
-- tuple-scrutinee indirection → paramUseTy falls back to LTInt → ++ gaps.
--
-- NOTE: this dispatch is written with `if`-EXPRESSIONS (not a guarded match arm)
-- so the emitter itself is self-compilable — the gap-tolerant bootstrap driver
-- cannot lower a guarded match arm (it inserts a `store 0` placeholder, see the
-- CTGuard arm of emitTree), which would silently blank this body in the native
-- emitter.  The IR produced is byte-identical to the guarded form; only the
-- source shape changes.  (The other compiler stages contain NO guarded matches
-- for the same reason.)
emitGroupBody e fname tag positions arity (clauses@[(pats, body)]) =
  if allPVar pats then
    let tyList = patPosTys tag positions (listLen pats) 0
    let env = paramEnvByPos pats tyList 0
    emitFnBody e env fname body
  else
    emitTailClauseTree
      e
      (implParamEnvByPos tag positions arity 0)
      fname
      arity
      clauses
      noDeclLoc
emitGroupBody e fname tag positions arity clauses =
  emitTailClauseTree
    e
    (implParamEnvByPos tag positions arity 0)
    fname
    arity
    clauses
    noDeclLoc

-- build a LTy list of length n, typed as tagToLTy tag at positions ∈ positions,
-- LTInt elsewhere.
patPosTys : String -> List Int -> Int -> Int -> List LTy
patPosTys _ _ n i
  | i >= n = []
patPosTys tag positions n i =
  let ty = if listContains positions i then tagToLTy tag else LTInt
  ty :: patPosTys tag positions n (i + 1)

-- bind PVar params to their %argK operands at the given LTy list.
paramEnvByPos : List Pat -> List LTy -> Int -> OrdMap (String, LTy)
paramEnvByPos [] _ _ = omEmpty
paramEnvByPos ((PVar x _) :: rest) (ty :: tys) i =
  omInsert x ("%arg" ++ intToString i, ty) (paramEnvByPos rest tys (i + 1))
paramEnvByPos ((PVar x _) :: rest) [] i =
  omInsert x ("%arg" ++ intToString i, LTInt) (paramEnvByPos rest [] (i + 1))
paramEnvByPos _ _ _ = omEmpty

-- the shared decision-tree body for a coalesced multi-clause group (impl methods
-- AND top-level fns, slice 2/E1a).  `env` binds the synthetic `aK` scrutinee
-- params to their `%argK` operands at the caller's chosen LTy (impl: all LTInt;
-- top-level fn: the inferred signature param types).
--
-- The params are scrutinised AS A MATRIX — one decision-tree COLUMN per param,
-- each column's occurrence word being the param's own operand.  Historically an
-- arity-≥2 group boxed its params into a synthetic `CTuple` cell so the
-- multi-param match reduced to a SINGLE scrutinee; that cost an `@mdk_alloc` on
-- EVERY call (24 B at arity 2) — including every tail-recursive self-call and
-- every TRMC loop iteration — purely to destructure the cell back into the very
-- words it was built from.  Maranget's algorithm is already multi-column
-- (`compileTree` specializes the leftmost column and `emitTree` carries `occs` as
-- a column LIST), so the tuple was never needed: `implRows` now emits one column
-- per param and the occurrences start as the param words themselves.  A leaf
-- binds the clause's patterns element-wise against those words (`bindArm`) rather
-- than loading them back out of a cell.  Zero allocation, one fewer (always-true)
-- tuple-discriminant test, and the param LTys survive into the leaf.
-- `outer` is the fallthrough target for the LAST clause of the chain — see
-- emitClauseChain.  It is a PARAMETER (issue #354): it must never be read out of the
-- module-level fallthroughLabelRef, which makes the contract "whatever ambient value
-- some ancestor happened to leave behind".  Every caller today passes "" (a chain
-- either opens a fresh `define` — where inheriting a parent function's block label
-- would emit invalid cross-function LLVM, issue #53 — or sits at top level), so
-- making it explicit costs one argument and buys a call-site-local answer.
-- `site` is the function's first-clause site, where a call no clause accepts
-- aborts (`noDeclLoc` for an impl method, which has none).
emitClauseTree : Emit ->
  OrdMap (String, LTy) ->
  Int ->
  List (List Pat, CExpr) ->
  String ->
  Loc ->
  Unit
emitClauseTree e env arity clauses outer site =
  let roots = emitArgs e env (implScrutVars arity 0)
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "decend" ++ intToString (freshLocal e)
  let rty = Ref LTInt
  let _ = emitClauseChain e env arity clauses roots slot endL rty outer site
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  emit e ("  ret i64 " ++ r)
-- Emit the clauses as a CHAIN of single-clause decision trees sharing one result
-- slot + end label.  Each clause passes the NEXT clause's
-- entry block to emitTree, so a pattern miss (CTFail) or a guard fallthrough
-- (`__fallthrough__`) resumes the next clause — the interpreter's "try next
-- clause" semantics.  The scrutinee is emitted ONCE, before the chain.  (A lone
-- clause degenerates to the historical single-tree path: no next label → CTFail
-- stays `unreachable`, fallthrough stays oob.)

-- emit clause chain: each clause's fallthrough target is the NEXT clause's entry
-- block; the LAST clause falls through to `outer` (the fallthrough that was in
-- effect when the chain began — "" at top level → oob; a nested chain inside a
-- guarded clause body inherits the enclosing clause's next-clause label).  A
-- single-clause function degenerates to `outer` directly, preserving the historical
-- single-tree behaviour.
emitClauseChain : Emit ->
  OrdMap (String, LTy) ->
  Int ->
  List (List Pat, CExpr) ->
  List String ->
  String ->
  String ->
  Ref LTy ->
  String ->
  Loc ->
  Unit
emitClauseChain _ _ _ [] _ _ _ _ _ _ = ()
emitClauseChain e env arity (c :: rest) roots slot endL rty outer site =
  let nextL = chainNextLabel e rest outer
  -- Stamp this clause's next-clause label INTO its `__fallthrough__` sentinels
  -- (emit_support's labelFallthrough) before building the arms, so the sentinel
  -- lowers to `br %nextL` from the var name alone.  Leaving the sentinel
  -- bare and having emitFallthrough read a module-level fallthrough Ref — which
  -- emitDecision NULLED, so a refutable pattern-guard clause (whose guard chain
  -- desugars to a body-level CDecision) fell through to `@mdk_oob` instead of the
  -- next clause.  (That Ref is gone as of issue #354; the label is now threaded.)
  let c2 = ftClause (if nextL == "" then siteFtLabel e site else nextL) c
  let arms = [clauseArm arity c2]
  let tree = compileTree (NoArm site) [False] (implRows [c2] 0)
  -- This tree is SINGLE-ROW (one clause), so its CTFail means "this clause's pattern
  -- missed" → resume at nextL.  Handed to emitTree as an argument (issue #354); it is
  -- the only emitTree entry point with a live fallthrough — the other three (a
  -- self-contained expression match, and the two tail-match descents) pass "".
  let _ = emitTree e env roots arms roots slot endL nextL rty tree
  if isEmptyL rest then
    ()
  else
    let _ = emit e (nextL ++ ":")
    emitClauseChain e env arity rest roots slot endL rty outer site

-- label a clause's fall-through sentinels with the block to resume at.  An EMPTY
-- label means "no next clause" and no site to report (an impl method's last
-- clause): leave the sentinels BARE so emitFallthrough lowers them to the
-- unlocated non-exhaustive abort.
ftClause : String -> (List Pat, CExpr) -> (List Pat, CExpr)
ftClause "" c = c
ftClause lbl (pats, body) = (pats, labelFallthrough body lbl)

-- the next clause's entry label: the outer fallthrough when this is the last
-- clause, else a fresh `clauseN` block label.
chainNextLabel : Emit -> List (List Pat, CExpr) -> String -> String
chainNextLabel _ [] outer = outer
chainNextLabel e _ _ = "clause" ++ intToString (freshLocal e)

isEmptyL : List a -> Bool
isEmptyL [] = True
isEmptyL _ = False

-- the synthetic scrutinee components of a group: `[a0, a1, …]`.  Emitted through
-- `emitArgs`, so each resolves to the param's operand word — `%argK` for an
-- ordinary define, the loop-head reload register under TRMC.
implScrutVars : Int -> Int -> List CExpr
implScrutVars n i
  | i >= n = []
  | otherwise = CVar ("a" ++ intToString i) AGlobal :: implScrutVars n (i + 1)

-- one match arm per clause: arity 1 uses the lone pattern directly; arity ≥2
-- keeps the clause's params as a `PTuple` — NOT because a tuple cell exists (it
-- does not; see emitClauseTree), but because `CArm` carries a single `Pat`.  The
-- leaf binder (`bindArm`) recognises the multi-root case and binds the tuple's
-- element patterns element-wise against the param words.
clauseArm : Int -> (List Pat, CExpr) -> CArm
clauseArm 1 (pats, body) = CArm (headPat pats) [] body
clauseArm _ (pats, body) = CArm (PTuple pats) [] body

-- one matrix row per clause, ONE COLUMN PER PARAM (each CANONICALISED into matrix
-- form via canonPat — the same normalisation initialRows applies to match arms, so
-- compileTree recognises list/bool/ctor heads); index = the clause position so the
-- decision-tree leaf selects the right arm.  The ARM keeps the RAW patterns
-- (clauseArm) — bindArm re-matches those to bind variables.
implRows : List (List Pat, CExpr) -> Int -> List (List Pat, Int)
implRows [] _ = []
implRows ((pats, _) :: rest) i = (map canonPat pats, i) :: implRows rest (i + 1)

headPat : List Pat -> Pat
headPat (p :: _) = p
headPat [] = PWild

-- ── impl coalescing ───────────────────────────────────────────────
-- group the per-clause CImplTagged entries by `(method, key)` — the canonical
-- full-type impl key, so two impls sharing a head tycon but differing in type args
-- (C7) land in DISTINCT groups (own body each) while a multi-clause impl (one key)
-- stays coalesced.  Preserves first-seen group order and source clause order within
-- each (the Maranget priority).  CImplDefault entries (interface defaults) are
-- skipped — they are the arg-tag fallback, never a lifted static-dispatch target.
groupImpls : Emit -> List CImplEntry -> List ImplGroup
groupImpls e entries = map (gatherGroup e entries) (distinctImplKeys entries [])

-- the (method, key) keys of the entries, in first-seen order.
distinctImplKeys : List CImplEntry ->
  List (String, String) ->
  List (String, String)
distinctImplKeys [] seen = reverseL seen
distinctImplKeys ((CImplEntry method _ body) :: rest) seen =
  let key = implBodyKey body
  if keySeen method key seen then
    distinctImplKeys rest seen
  else
    distinctImplKeys rest ((method, key) :: seen)

implBodyKey : CImplBody -> String
implBodyKey (CImplTagged _ key _ _ _ _) = key
implBodyKey (CImplDefault _ _ key _ _ _) = key

keySeen : String -> String -> List (String, String) -> Bool
keySeen _ _ [] = False
keySeen m t ((m2, t2) :: rest) =
  if m == m2 && t == t2 then True else keySeen m t rest

-- build the group for one (method, key) key: head tag + symTag + positions + arity
-- from the first matching entry, clauses (pats, body) from all matching entries in
-- order.  The SYMBOL tag (C7) is the head tag when this is the sole impl of the head
-- (byte-identical to the pre-C7 scheme), else the sanitized canonical key.  A
-- POINT-FREE impl (`length = fold f 0` — clauseArity < the method's declared
-- arity) is ETA-EXPANDED to the method's full arity, mirroring emitDefaultDefine:
-- the lifted `@mdk_impl_<symTag>_<method>` then takes every call-site arg, so the
-- RKey/arg-tag call sites (which use methodArityOf) and the define agree.  A
-- multi-clause or already-full-arity impl is unchanged (etaExpand is a no-op when
-- have >= arity).
gatherGroup : Emit -> List CImplEntry -> (String, String) -> ImplGroup
gatherGroup e entries (method, key) =
  let tag = headTagForKey method key entries
  let symTag = implFnSymForKey e entries method tag key
  let cls0 = gatherClauses method key entries
  let positions = groupPositions method key entries
  -- Eta-expand a point-free / ETA-SHORT impl clause up to the method's FULL arity
  -- INCLUDING its leading dict params: `methodArityOf` counts only the source value
  -- params, so a default like `foldMap f = fold (acc x => acc ++ f x) empty`
  -- (synthesized into an impl, clause `[$dict_foldMap_0, f]`) must expand to
  -- `dict + f + container`, not stop at `dict + f`.  Adding `nDicts` (the leading
  -- `$dict_*` params dict_pass prepended) makes the lifted fn take every call-site
  -- arg (RKey/arg-tag callers use `methodArityOf + dictWords`), so the unapplied PAP
  -- (container dropped) → SIGSEGV no longer happens.  nDicts = 0 for a concrete impl
  -- ⇒ identical to the old `maxInt (clauseArity) (methodArityOf)`.
  let nDicts = leadingDictPats (firstClausePats cls0)
  -- #1450 / #1668, THE DEFINE-ARITY SITE.  `methodArityOfIface` takes the method's
  -- declared arity from the DECLARATION identity of the interface this group's own
  -- `impl` head names (`key`'s first field, minted by `route_key.implRouteKeyWord`)
  -- instead of from the bare-method-name table, which two modules declaring
  -- same-spelled methods on unrelated interfaces silently share.  ONLY THE ARITY LEG
  -- MOVES: `iface` (`CImplTagged` field 3) keeps its bare spelling, because
  -- `implEntryIface`/`methodReturnsSelf` read it as a bare word.  A miss falls back
  -- to the bare table, so a collision-free program emits byte-identically to before.
  -- #1034, THE DEFINE-ARITY MIRROR of `methodArityOfEntry`'s lowering rule.  A clause
  -- that binds at least one VALUE pattern but fewer than the declared spine proves a
  -- SHORTER source arity than the type can express, and eta-expanding it to the
  -- declared arity is what defers the body's strict prefix past the source's call.
  -- Such a clause is emitted at its own arity; every other shape keeps the previous
  -- `maxInt (clauseArity) (declared + nDicts)` answer exactly.
  let declaredTotal = methodArityOfIface e (ifaceWordOfKey key) method + nDicts
  let srcTotal = clauseArity cls0
  let arity =
    if srcTotal > nDicts && srcTotal < declaredTotal then
      srcTotal
    else
      maxInt srcTotal declaredTotal
  let cls = map (etaExpandClause arity) cls0
  let fnName = match firstEntryFor method key entries
    Some ent => implEntryFnNameAt ent method symTag
    None => implFnName symTag method
  ImplGroup method tag key symTag positions arity cls fnName

-- the head tycon tag of the impl whose (method, key) matches (the first such entry).
headTagForKey : String -> String -> List CImplEntry -> String
headTagForKey method key entries = match firstEntryFor method key entries
  Some ent => implEntryTag ent
  None => ""

firstEntryFor : String -> String -> List CImplEntry -> Option CImplEntry
firstEntryFor _ _ [] = None
firstEntryFor method key (ent :: rest)
  | implEntryMethodOf ent == method && implEntryKey ent == key = Some ent
  | otherwise = firstEntryFor method key rest

-- [implEntryFnName] with the symbol tag already decided (inside `gatherGroup`)
implEntryFnNameAt : CImplEntry -> String -> String -> String
implEntryFnNameAt (CImplEntry _ _ (CImplTagged _ _ _ _ _ _)) method symTag =
  implFnName symTag method
implEntryFnNameAt (CImplEntry _ _ (CImplDefault ifaceWord _ key _ _ _)) method _ =
  defaultFnName ifaceWord method key

-- eta-expand one impl clause's (pats, body) to `arity` (no-op when already there).
etaExpandClause : Int -> (List Pat, CExpr) -> (List Pat, CExpr)
etaExpandClause arity (pats, body) = etaExpand pats body arity (lengthS pats)

gatherClauses : String -> String -> List CImplEntry -> List (List Pat, CExpr)
gatherClauses _ _ [] = []
gatherClauses method key (ent :: rest)
  | implEntryMethodOf ent == method && implEntryKey ent == key =
    (implPats ent, implBody ent) :: gatherClauses method key rest
  | otherwise = gatherClauses method key rest

groupPositions : String -> String -> List CImplEntry -> List Int
groupPositions method key entries = match firstEntryFor method key entries
  Some ent => implEntryPositions ent
  None => []

clauseArity : List (List Pat, CExpr) -> Int
clauseArity ((pats, _) :: _) = lengthS pats
clauseArity [] = 0

-- the first clause's patterns (for counting leading dict params); [] when no clause.
firstClausePats : List (List Pat, CExpr) -> List Pat
firstClausePats ((pats, _) :: _) = pats
firstClausePats [] = []

-- ── closures + higher-order functions ─────────────────────────────
-- VALUE REPRESENTATION (RUNTIME-DESIGN.md §8.5 "Closures"): a closure value is a
-- BOXED heap cell, the same boxed-pointer discipline as ADTs and Floats
--.  Cell layout (8-byte words):
--   [ 0: i64 header ] [ 8: i64 code_ptr ] [ 16: capt0 ] [ 24: capt1 ] …
-- DECISION (filed in PLAN.md as a spike-rep note): the cell carries a one-word
-- HEADER (a fixed closure tag) before `code_ptr`, mirroring §8.5's `{ header,
-- code_ptr, captured… }` and the slice-3 ADT header — NOT code_ptr-at-offset-0.
-- This lets the closure cell reuse `emitCtorAlloc`/`storeFields`/`loadField`
-- VERBATIM: it is allocated exactly like a constructor whose "fields" are
-- `[code_ptr, capt0, capt1, …]`, so `code_ptr` is field 0 and capture i is field
-- i+1.  The CALLING CONVENTION (§8.5): load `code_ptr`, then call passing the
-- closure pointer as a LEADING argument (`@mdk_lamN(i64 %clos, i64 %arg0, …)`).
--
-- Each CLam is LAMBDA-LIFTED to a top-level `define @mdk_lamN` (LLVM has no nested
-- functions).  Its CAPTURED set is freeVars(body) − params, intersected with the
-- emit-time env (free names NOT in the env are top-level globals — known fns /
-- ctors — which need no capture).  At the CLam site we allocate the cell storing
-- `[&@mdk_lamN, capturedWords…]`; in the lifted body we bind params from `%argK`
-- and re-load captures from `%clos`.  Lifted-lambda params/captures default to Int
-- (the type-erased subset; every slice-4 fixture's lambda is Int-typed) — a
-- documented scope limit, like the saturated-only call rule above.

-- allocate a closure cell {arity, code_ptr, captured…}.  Field 0 is the closure's
-- callable ARITY (the value-arg count of its lifted `@mdk_lamN` define, i.e. the
-- args AFTER the leading `%clos` word) — the runtime reads it (mdk_apply) to decide
-- exact / partial / over application.  `code_ptr` is a constant-expression operand
-- (`ptrtoint (ptr @mdk_lamN to i64)`).  The arity MUST equal the emitted define's
-- param count (the E22 hazard): an inline exact call trusts field 0, so a mismatch
-- would divert a saturated call to the PAP path.  Result is the cell pointer word,
-- typed LTClosure.
emitClosureAlloc : Emit -> String -> Int -> List String -> (String, LTy)
emitClosureAlloc e lamName arity captureWords =
  let codePtr = "ptrtoint (ptr @" ++ lamName ++ " to i64)"
  let (w, _) = emitClosureCell e arity (codePtr :: captureWords)
  (w, LTClosure)

-- allocate a boxed cell whose header word is the raw integer `hdr` (the closure
-- arity) rather than a hashed ctor tag; fields stored at offset 8*(i+1) as usual.
emitClosureCell : Emit -> Int -> List String -> (String, LTy)
emitClosureCell e hdr fields =
  let n = lengthS fields
  let p = freshReg e
  let _ =
    emit e "  \{p} = call ptr @mdk_alloc(i64 \{intToString (8 * (n + 1))})"
  let _ = emit e "  store i64 \{intToString hdr}, ptr \{p}"
  let _ = storeFields e p fields 0
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTClosure)

-- emitClosureAlloc + record the closure's compile-time arity in `e.closureArity`
-- (keyed by its SSA word) so an indirect over-application of this closure value can
-- split saturate+apply-extra.  Used for user lambdas and let-group/method-value
-- closures whose arity is statically known.
emitClosureAllocA : Emit -> String -> Int -> List String -> (String, LTy)
emitClosureAllocA e lamName arity captureWords =
  let (w, lty) = emitClosureAlloc e lamName arity captureWords
  e.closureArity := (w, arity) :: !e.closureArity
  (w, lty)

-- ── capture-free closure hoisting (S-1, EMITTER-GAPS #10 allocation half) ───
-- THE SPRINT'S MECHANISM.  A closure cell whose capture set is EMPTY has fields
-- that are ALL compile-time constants: the header is the literal arity and field 0
-- is `ptrtoint (ptr @mdk_lamN to i64)`, already a constant-expression.  Such a cell
-- is immutable and identical at every entry to the enclosing function, so it does
-- NOT need a per-entry `@mdk_alloc`: emit it ONCE as an `internal constant` module
-- global and use `ptrtoint (ptr @g to i64)` as the closure word.  Exactly the
-- transform `emitConstDictCell` already performs for constant dict witnesses, and
-- byte-identical in LAYOUT to `emitClosureCell`'s heap cell (header at offset 0,
-- field i at 8*(i+1)) so every consumer — `loadField` code-ptr load, `__mdk_apply`,
-- a capture-word store into a sibling cell — reads it unchanged.
--
-- SOUND because a closure cell is READ-ONLY after construction on this path: the
-- only writer is the knot-tying back-patch (`knotPatch`), and mutual/forward groups
-- are routed to `emitLetGroupKnot` BEFORE reaching here (F9 — an immutable global
-- cannot be back-patched, so that path keeps its per-entry alloc by design).
-- `__mdk_apply` only reads the cell; a PAP is a separate freshly-allocated cell.
--
-- Cached by `constCellKey` in its own cache (NOT `dictConstCache` — different
-- value domain, and sharing it would let a dict and a closure alias one global).
-- ⚠️ In practice this cache can never HIT: `lamName` is always minted from
-- `freshId` at the call site (`emitGroupBind`'s `mdk_lam.<scope>.<id>`,
-- `emitLamGo`'s and `emitLamPat`'s own for a capture-free user lambda, each
-- eta-wrapper's `mdk_eta_<name>.<scope>.<id>` / `mdk_etac_<name>.<scope>.<id>`),
-- so `initBody`'s
-- `ptrtoint` operand is globally unique per closure and no two initializers can
-- ever match.  Measured cost of the miss-only lookups (re-measured after S-1
-- routed capture-free user lambdas through this path too, not just eta-wrappers):
-- 902 `@mdk_cc_` globals in a full self-hosting `llvm_emit_modules_main` build of
-- this compiler, so up to ~406K miss comparisons (a linear scan against an
-- ever-growing list before each miss) — still a linear list scan per call, not
-- worth removing or restructuring, but the cache is dead weight, not working
-- dedup.
emitConstClosureCell : Emit -> String -> Int -> String
emitConstClosureCell e lamName arity =
  let codePtr = "ptrtoint (ptr @" ++ lamName ++ " to i64)"
  let initBody = "[2 x i64] [i64 \{intToString arity}, i64 \{codePtr}]"
  let key = constCellKey e initBody
  match lookupAssoc key !e.closConstCache
    Some gname => "ptrtoint (ptr @" ++ gname ++ " to i64)"
    None =>
      let gname = "mdk_cc" ++ mangleScoped e
      let _ = emitGlobal e "@\{gname} = internal constant \{initBody}"
      e.closConstCache := (key, gname) :: !e.closConstCache
      "ptrtoint (ptr @" ++ gname ++ " to i64)"

-- emitConstClosureCell + the same `e.closureArity` bookkeeping `emitClosureAllocA`
-- does, so an indirect over/under-application of this closure value still splits
-- statically.  The drop-in replacement for `emitClosureAllocA e lam arity []`.
emitConstClosureA : Emit -> String -> Int -> (String, LTy)
emitConstClosureA e lamName arity =
  let w = emitConstClosureCell e lamName arity
  e.closureArity := (w, arity) :: !e.closureArity
  (w, LTClosure)

-- emitConstClosureCell WITHOUT the `e.closureArity` registration — the drop-in
-- replacement for `emitClosureAlloc e lam arity []` (S-2, EMITTER-GAPS #10
-- allocation half, the five eta-closure call sites below).  Strict parity with
-- those sites' current non-`A` `emitClosureAlloc` call: they do not register
-- `closureArity` today, and this wrapper must not start doing so — that would
-- newly enable a static over/under-application split at these call sites,
-- a separate behavior addition out of this slice's scope.
emitConstClosure : Emit -> String -> Int -> (String, LTy)
emitConstClosure e lamName arity =
  (emitConstClosureCell e lamName arity, LTClosure)

-- emit a CLam: compute its captured set, lift its body to a top-level define, and
-- allocate the closure cell capturing the live operand words.
-- E2b — a CLam whose params are NOT all plain `PVar` (a tuple/constructor
-- destructuring lambda) routes through `emitLamPatDefine`: the SAME lifted-frame
-- machinery as `emitLamGo`, but the patterned params are bound by a single-clause
-- decision tree (`emitClauseTree`) over the `%argK` words instead of a verbatim
-- `paramEnv`.  Capture computation is identical — `patVarNames` already collects
-- nested pattern vars, so the patterned param vars are correctly excluded from the
-- captured set.  Closes the lambda half of EMITTER-GAPS #5.
emitLam : Emit -> OrdMap (String, LTy) -> List Pat -> CExpr -> (String, LTy)
emitLam e env pats body =
  if allPVar pats then emitLamGo e env pats body else emitLamPat e env pats body

emitLamGo : Emit -> OrdMap (String, LTy) -> List Pat -> CExpr -> (String, LTy)
emitLamGo e env pats body =
  let lamName = "mdk_lam" ++ mangleScoped e
  let pnames = patVarNames pats
  let captured = keepInEnv env (dedupS (freeVars pnames body))
  let captureWords = capWords e env captured
  let _ = emitLamDefine e env lamName pats captured body
  -- S-1-style hoist (mirrors `emitGroupBind`): capture-free ⇒ every cell field
  -- is a compile-time constant, so hoist to an `internal constant` module
  -- global via `emitConstClosureA` instead of allocating a fresh cell on every
  -- entry to the enclosing function. `emitConstClosureA` is the documented
  -- drop-in for `emitClosureAllocA e lam arity []` — it keeps the
  -- `e.closureArity` registration this call already relies on for static
  -- over/under-application splitting, unlike the bookkeeping-free
  -- `emitConstClosure` used by the eta-closure sites.
  let (cw, clty) = match captureWords
    [] => emitConstClosureA e lamName (listLen pats)
    _ => emitClosureAllocA e lamName (listLen pats) captureWords
  let _ = recordFloatRet e env cw body
  (cw, clty)

emitLamPat : Emit -> OrdMap (String, LTy) -> List Pat -> CExpr -> (String, LTy)
emitLamPat e env pats body =
  let lamName = "mdk_lam" ++ mangleScoped e
  let pnames = patVarNames pats
  let captured = keepInEnv env (dedupS (freeVars pnames body))
  let captureWords = capWords e env captured
  let _ = emitPatLamDefine e env lamName omEmpty pats captured body
  -- Same S-1-style hoist as `emitLamGo` above; see that comment.
  let (cw, clty) = match captureWords
    [] => emitConstClosureA e lamName (listLen pats)
    _ => emitClosureAllocA e lamName (listLen pats) captureWords
  let _ = recordFloatRet e env cw body
  (cw, clty)

-- emit a RECURSIVE function-`let` closure: lambda-lift exactly like
-- emitLam, but EXCLUDE the binding's own name `f` from the captured set (it is the
-- closure cell itself, not an external free variable) and, inside the lifted body,
-- bind `f` to `%clos` so a self-call re-enters the same code with the same cell.
emitRecLam : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Pat ->
  CExpr ->
  (String, LTy)
emitRecLam e env f pats body =
  if allPVar pats then
    emitRecLamGo e env f pats body
  else
    emitRecLamPat e env f pats body

emitRecLamGo : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Pat ->
  CExpr ->
  (String, LTy)
emitRecLamGo e env f pats body =
  let lamName = "mdk_lam" ++ mangleScoped e
  let pnames = patVarNames pats
  let captured = keepInEnv env (removeStr f (dedupS (freeVars pnames body)))
  let captureWords = capWords e env captured
  let _ = emitRecLamDefine e env lamName f pats captured body
  let (cw, clty) = emitClosureAllocA e lamName (listLen pats) captureWords
  let _ = recordFloatRet e env cw body
  (cw, clty)

-- E2b — recursive-`let` lambda with non-`PVar` params: same patterned-frame body
-- as `emitLamPat`, but binds `f -> %clos` ahead of captures so a self-call
-- re-enters the same code with the same cell (mirrors `emitRecLamGo` vs
-- `emitLamGo`).  `f` is removed from the free set before computing captures.
emitRecLamPat : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Pat ->
  CExpr ->
  (String, LTy)
emitRecLamPat e env f pats body =
  let lamName = "mdk_lam" ++ mangleScoped e
  let pnames = patVarNames pats
  let captured = keepInEnv env (removeStr f (dedupS (freeVars pnames body)))
  let captureWords = capWords e env captured
  let _ =
    emitPatLamDefine
      e
      env
      lamName
      (omInsert f ("%clos", LTClosure) omEmpty)
      pats
      captured
      body
  let (cw, clty) = emitClosureAllocA e lamName (listLen pats) captureWords
  let _ = recordFloatRet e env cw body
  (cw, clty)

-- like emitLamDefine, but prepends `f -> %clos` to the body's env so the lifted
-- body's recursive references resolve to the closure pointer (the leading param).
-- (Gap E3: lambda params are per-param inferred from the body via `inferParamTys`/
-- `paramUseTy`, so a Float-param lambda gets float instruction selection; params
-- `paramUseTy` can't resolve default to LTInt as before.)
emitRecLamDefine : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  List Pat ->
  List String ->
  CExpr ->
  Unit
emitRecLamDefine e env lamName f pats captured body =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{closureParamDecls pats}) {"
  let _ = emit e "entry:"
  let cenv = loadCaptures e env captured 0
  let penv = paramEnv pats (inferParamTys (sigMapOf e) pats body) 0
  let _ =
    emitFnBody
      e
      (envMergeL (omInsert f ("%clos", LTClosure) cenv) penv)
      lamName
      body
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- E2b — emit a lifted lambda whose params are NON-variable patterns, into the side
-- buffer (same swap discipline as emitLamDefine).  Captures load from `%clos`
-- fields 1.., the patterned params are the synthetic `aK` scrutinee words
-- (`%argK`, via `implParamEnv`), and the SINGLE clause's body is lowered by
-- `emitClauseTree` — the SAME decision-tree path the patterned top-level fns use
-- (E1a) — so a tuple/constructor param binds its vars via `bindPattern` and the
-- body `ret`s.  `extra` is the leading env binding the recursive case prepends
-- (`f -> %clos`); the non-recursive case passes `[]`.  Lambda params/captures
-- default to Int (`implParamEnv`) — the documented slice-4 scope limit, identical
-- to emitLamDefine's `paramEnv … (allInt pats)`.
emitPatLamDefine : Emit ->
  OrdMap (String, LTy) ->
  String ->
  OrdMap (String, LTy) ->
  List Pat ->
  List String ->
  CExpr ->
  Unit
emitPatLamDefine e env lamName extra pats captured body =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let arity = listLen pats
  let _ =
    emit e "define i64 @\{lamName}(i64 %clos, \{implParamDecls arity 0}) {"
  let _ = emit e "entry:"
  let cenv = loadCaptures e env captured 0
  let _ =
    emitClauseTree
      e
      (envMergeL extra (envMergeL cenv (implParamEnv arity 0)))
      arity
      [(pats, body)]
      ""
      noDeclLoc
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- drop every occurrence of a name from a list (the recursive-closure self name is
-- removed from its own free-variable set before computing the capture set).
removeStr : String -> List String -> List String
removeStr _ [] = []
removeStr x (y :: ys) = if x == y then removeStr x ys else y :: removeStr x ys

-- eta-wrap a NAMED top-level function used as a value into a captureless static
-- closure whose lifted body forwards every argument to `@mdk_<fname>`.  The arity
-- is the function's inferred parameter count (signature table).
emitEtaClosure : Emit -> String -> (String, LTy)
emitEtaClosure e fname =
  let arity = fnArity e fname
  let lamName = "mdk_eta_\{fname}\{mangleScoped e}"
  let _ = emitEtaDefine e lamName fname arity
  emitConstClosure e lamName arity

-- the inferred arity of a known top-level function (its signature's param count).
fnArity : Emit -> String -> Int
fnArity e fname = match !e.sigMap
  Some m => match omLookup fname m
    Some (FnSig ptys _) => lengthS ptys
    None => 0
  None => panic "llvm: sigMap read before install (internal error)"

-- the declared arity of constructor `name` (its field count, from the ctor table).
ctorArity : Emit -> String -> Int
ctorArity e name = match !e.ctorMap
  Some m => match omLookup name m
    Some n => n
    None => 0
  None => panic "llvm: ctorMap read before install (internal error)"

-- #35: an APPLIED constructor, dispatched on saturation.  This is the arity check
-- that the emitVar-side comment below has always ASSUMED but which emitApp did not
-- actually perform: the ctor arm must not call `emitCtorAlloc` unconditionally, or an
-- UNDER-applied ctor (`Bin OAdd` for arity-3 `Bin`) allocates a `Bin` cell holding 1
-- of its 3 fields.  Saturating that later applies args to a DATA cell as if it were a
-- closure (@mdk_apply reads the ctor TAG out of the header as if it were an arity), so
-- the value carries the right tag but junk fields — a SILENT wrong-value miscompile:
-- `check` accepted, `run` was correct, `build` produced garbage (E-NONEXHAUSTIVE-MATCH).
--   • SATURATED (the overwhelmingly common case) ⇒ `emitCtorAlloc`, byte-identical to
--     before, so no gate/fixpoint churn.
--   • UNDER-applied ⇒ a ctor PAP (emitCtorPap): a real closure cell over the supplied
--     args whose forwarder allocates the cell once the rest arrive.
--   • OVER-applied ⇒ unreachable for a well-typed program (typecheck rejects applying
--     a data value), but route the surplus through the runtime @mdk_apply rather than
--     silently storing past the cell's end.
emitCtorApp : Emit -> String -> List String -> Int -> (String, LTy)
emitCtorApp e name argOps arity
  | lengthS argOps < arity = emitCtorPap e name argOps arity
  | lengthS argOps > arity =
    let (cw, _) = emitCtorAlloc e name (takeS arity argOps)
    (emitApplyAny e cw (dropS arity argOps), LTInt)
  | otherwise = emitCtorAlloc e name argOps

-- the residual PAP closure for an UNDER-applied constructor.  Exactly the E22
-- method-PAP shape (emitMethodPap) with the dict captures dropped: the closure cell
-- captures the k supplied arg words, its recorded arity is the RESIDUAL (arity − k)
-- so a later over-application of the PAP still splits correctly, and the lifted
-- forwarder reloads the captures and allocates the cell from (supplied ++ fresh).
-- Equivalently: emitCtorEtaClosure (the captureless k==0 eta-wrapper below)
-- generalised to k > 0 supplied args.
emitCtorPap : Emit -> String -> List String -> Int -> (String, LTy)
emitCtorPap e name argOps arity =
  let remaining = arity - lengthS argOps
  let lamName = "mdk_ctorpap_\{name}\{mangleScoped e}"
  let _ = emitCtorPapDefine e lamName name arity (lengthS argOps)
  emitClosureAllocA e lamName remaining argOps

-- emit the under-applied-ctor PAP forwarder.  Closure cell layout: field 0 =
-- code_ptr, fields 1..S = the S supplied arg words.  The forwarder takes `remaining`
-- fresh `%argK` params, reloads the supplied words from fields 1..S, and allocates
-- the ctor cell from (supplied ++ fresh).  Side-buffer swap discipline is
-- emitCtorEtaDefine's, verbatim.
emitCtorPapDefine : Emit -> String -> String -> Int -> Int -> Unit
emitCtorPapDefine e lamName name arity supplied =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let remaining = arity - supplied
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls remaining}) {"
  let _ = emit e "entry:"
  let suppliedOps = loadPapCaptures e supplied 0
  let (w, _) = emitCtorAlloc e name (suppliedOps ++ etaArgOps remaining 0)
  let _ = emit e ("  ret i64 " ++ w)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- a CONSTRUCTOR with arity>0 referenced as a FIRST-CLASS value (`map PVar vars`):
-- emitApp only builds the cell when the ctor is SATURATED (via emitCtorAlloc — see
-- emitCtorApp above, which now ENFORCES that), so a bare ctor name reaches emitVar.
-- Eta-wrap it into a captureless static closure whose lifted forwarder allocates the
-- ctor cell from its `%argK` words — mirrors emitEtaClosure (known-fn eta) but the
-- body is emitCtorAlloc, not a call.
-- (Arity-0 ctors stay the immediate `emitCtorAlloc e name []` in emitVar — already a
-- complete value, not a function.)
emitCtorEtaClosure : Emit -> String -> (String, LTy)
emitCtorEtaClosure e name =
  let arity = ctorArity e name
  let lamName = "mdk_etac_\{name}\{mangleScoped e}"
  let _ = emitCtorEtaDefine e lamName name arity
  emitConstClosure e lamName arity

-- emit the captureless ctor-eta forwarder `@mdk_etacN(i64 %clos, %arg…) { <alloc
-- cell from %arg0..%argN-1>; ret }` into the side buffer (same swap discipline as
-- emitEtaDefine).
emitCtorEtaDefine : Emit -> String -> String -> Int -> Unit
emitCtorEtaDefine e lamName name arity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let (w, _) = emitCtorAlloc e name (argNames arity 0)
  let _ = emit e ("  ret i64 " ++ w)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- emit a lifted lambda's top-level `define` into the SIDE buffer (LLVM forbids a
-- nested define).  Swap the main buffer out, emit the define with `emit` (so it
-- lands in a private buffer), then move those lines (forward order) into the lams
-- buffer and restore the main buffer.  Captures bind by loading `%clos` fields
-- 1.., params bind to `%argK`; the body is emitted in TAIL position (it `ret`s).
-- (Gap E3: param types are per-param inferred from the body via `inferParamTys`/
-- `paramUseTy` — a Float-param lambda gets float ops; unresolved params → LTInt.)
emitLamDefine : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List Pat ->
  List String ->
  CExpr ->
  Unit
emitLamDefine e env lamName pats captured body =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{closureParamDecls pats}) {"
  let _ = emit e "entry:"
  let cenv = loadCaptures e env captured 0
  let penv = paramEnv pats (inferParamTys (sigMapOf e) pats body) 0
  let _ = emitFnBody e (envMergeL cenv penv) lamName body
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- emit the captureless eta-forwarder `@mdk_etaN(i64 %clos, %arg…) { ret = call
-- @mdk_fname(%arg…); ret }` into the side buffer (same swap discipline).
emitEtaDefine : Emit -> String -> String -> Int -> Unit
emitEtaDefine e lamName fname arity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let r = freshReg e
  let _ =
    emit e "  \{r} = call i64 @mdk_\{fname}(\{argDecls (argNames arity 0)})"
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- gap-2 (GENERAL): a known extern of ANY family (str/num/io/char/file/hash/…)
-- referenced as a FIRST-CLASS value (point-free alias `f = stringLength`, or
-- passed to a HOF like a fold that applies the extern).  emitApp lowers an extern
-- only when SATURATED (via emitExternApplied); a bare name reaches emitVar.  Eta-
-- wrap it into a captureless static closure whose lifted body REPLAYS
-- emitExternApplied's applied-form codegen on the incoming `%argK` operands, so
-- the value form is byte-consistent with the applied form for every family —
-- including INTRINSICS with no C symbol (e.g. `stringLength`, which inlines a load
-- of the cached codepoint count) since we reuse the exact applied emitter.  Arity
-- comes from the runtime sig (externArity → declSigOf, the runtime extern decls'
-- arrow count), so no per-family arity is hardcoded.
emitExternEtaClosure : Emit -> String -> (String, LTy)
emitExternEtaClosure e name =
  let lamName = "mdk_eta_\{name}\{mangleScoped e}"
  let _ = emitExternEtaDefine e lamName name (externArity e name)
  emitConstClosure e lamName (externArity e name)

-- Gap #50 (value position) — an interface METHOD name reaching emitVar as a bare
-- first-class value (passed to a HOF, e.g. `apply2 max 3 8`).  At a value site the
-- receiver type is monomorphic but NO route accompanies the bare CVar (routes live
-- on CMethod, not CVar), so dispatch must fall to the runtime arg-tag path.  Eta-
-- wrap into a captureless closure whose lifted body REPLAYS emitMethodArgDispatch's
-- applied-form codegen on the incoming `%argK` operands — byte-consistent with the
-- saturated `isImplMethod` call site (emitApp).  Arity = methodArityOf.  A method
-- reached point-free under a `=>` constraint instead becomes a fn-bind with a dict
-- param; a static route can be eta-saturated there, while a dynamic route retains
-- the source wrapper arity and dispatches before constructing a residual PAP.
emitMethodEtaClosure : Emit -> String -> (String, LTy)
emitMethodEtaClosure e name =
  let lamName = "mdk_eta_\{name}\{mangleScoped e}"
  let _ = emitMethodEtaDefine e lamName name (methodArityOfInput e name)
  emitConstClosure e lamName (methodArityOfInput e name)

-- the captureless method-eta forwarder `@mdk_etaN(i64 %clos, %arg…) { <inline
-- arg-tag dispatch over %arg0..%arg(N-1)>; ret }` (mirror of emitExternEtaDefine).
emitMethodEtaDefine : Emit -> String -> String -> Int -> Unit
emitMethodEtaDefine e lamName name arity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let synArgs = etaArgOps arity 0
  let (r, _) =
    emitMethodArgDispatch e name "" (methodArityOfInput e name) synArgs
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- the declared arity of extern `name` = the arrow count of its runtime signature
-- (`declSigOf` is seeded from the runtime extern decls via declSigTypeNames).  An
-- extern with no recorded signature defaults to arity 1 (every current extern is
-- annotated, so this is a defensive fallback, not a live path).
externArity : Emit -> String -> Int
externArity e name = match declSigOf e name
  Some (ptys, _) => lengthS ptys
  None => 1

-- emit the captureless extern-eta forwarder `@mdk_etaN(i64 %clos, %arg…) {
-- <inline applied-extern body over %arg0..%arg(N-1)>; ret }` into the side buffer
-- (same swap discipline as emitEtaDefine).  The body is produced by calling
-- emitExternApplied with synthetic `__eta_argK__` CVars bound to the `%argK`
-- regs — reuses the EXACT applied-form codegen, guaranteeing value/applied
-- consistency across all families.
emitExternEtaDefine : Emit -> String -> String -> Int -> Unit
emitExternEtaDefine e lamName name arity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let argEnv = etaArgEnv arity 0
  let synArgs = etaArgVars arity 0
  let (r, _) = emitExternApplied e argEnv name synArgs
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- #2074, VALUE position: a user-declared extern referenced as a first-class value
-- (`f = myCFn`, or passed to a HOF).  Exactly the shape `emitExternEtaClosure`
-- gives a builtin, and deliberately built the same way — a captureless static
-- closure whose lifted body REPLAYS `emitFfiCall` on the incoming `%argK`
-- operands.  Value/applied consistency is therefore by CONSTRUCTION: there is one
-- marshalling implementation, not two that could drift.  Arity comes from the
-- declared signature (`ffiExternArity`).
emitFfiEtaClosure : Emit -> String -> (String, LTy)
emitFfiEtaClosure e name =
  let lamName = "mdk_eta_\{name}\{mangleScoped e}"
  let _ = emitFfiEtaDefine e lamName name (ffiExternArity e name)
  emitConstClosure e lamName (ffiExternArity e name)

emitFfiEtaDefine : Emit -> String -> String -> Int -> Unit
emitFfiEtaDefine e lamName name arity =
  let saved = (bufRef e).value
  bufRef e := []
  let scope = beginDefine e
  let _ = emit e "define i64 @\{lamName}(\{etaParamDecls arity}) {"
  let _ = emit e "entry:"
  let argEnv = etaArgEnv arity 0
  let synArgs = etaArgVars arity 0
  let (r, _) = emitFfiCall e argEnv name synArgs
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  let _ = emit e ""
  let lamLines = (bufRef e).value
  lamsRef e := lamLines ++ (lamsRef e).value
  let _ = endDefine e scope
  bufRef e := saved

-- env binding `__eta_argK__ -> (%argK, LTInt)` for K in [i, arity) — so the
-- replayed applied-form emitter resolves each synthetic arg to its `%argK` reg.
etaArgEnv : Int -> Int -> OrdMap (String, LTy)
etaArgEnv n i =
  if i >= n then
    omEmpty
  else
    omInsert
      ("__eta_arg" ++ intToString i ++ "__")
      ("%arg" ++ intToString i, LTInt)
      (etaArgEnv n (i + 1))

-- the synthetic argument exprs `CVar "__eta_argK__" AGlobal` for K in [i, arity).
etaArgVars : Int -> Int -> List CExpr
etaArgVars n i =
  if i >= n then
    []
  else
    CVar ("__eta_arg" ++ intToString i ++ "__") AGlobal :: etaArgVars n (i + 1)

-- the eta-define's `%arg0..%arg(n-1)` parameter OPERAND words (as raw register
-- strings), for an eta body that consumes operands directly (emitMethodArgDispatch)
-- rather than re-emitting CVars through an env.
etaArgOps : Int -> Int -> List String
etaArgOps n i =
  if i >= n then [] else "%arg" ++ intToString i :: etaArgOps n (i + 1)

closureParamDecls : List Pat -> String
closureParamDecls [] = "i64 %clos"
closureParamDecls pats = "i64 %clos, " ++ paramDecls pats 0

-- the eta-forwarder's parameter list: `%clos` then `arity` `%argK`s.
etaParamDecls : Int -> String
etaParamDecls n = "i64 %clos" ++ etaArgDecls n 0

etaArgDecls : Int -> Int -> String
etaArgDecls n i =
  if i >= n then "" else ", i64 %arg\{intToString i}\{etaArgDecls n (i + 1)}"

-- the `%argK` operand names 0..n-1 (the eta-forwarder's call arguments).
argNames : Int -> Int -> List String
argNames n i =
  if i >= n then [] else "%arg" ++ intToString i :: argNames n (i + 1)

-- bind each captured variable by loading `%clos` field i+1 (field 0 is code_ptr).
loadCaptures : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  Int ->
  OrdMap (String, LTy)
loadCaptures _ _ [] _ = omEmpty
loadCaptures e env (c :: rest) i =
  let r = loadField e "%clos" (i + 1)
  omInsert c (r, capTypeOf env c) (loadCaptures e env rest (i + 1))

-- a captured FLOAT is stored BOXED in the closure cell (capWords/lookupVarG boxes
-- an unboxed LTFloatU on escape), so bind it LTFloat inside the lifted body —
-- matching emitLit's boxed-float convention, so arith (the Win-12 one-float-operand
-- path), print, and list ops all unbox it correctly.  A captured U64 or I64 cell
-- keeps LTU64 or LTI64 for the same reason.  Every OTHER capture stays LTInt
-- (the uniform-i64 default), so non-float captures are unaffected → zero
-- regression surface.
-- Fixes the closure-float-capture arith soundness bug (`map (x => x * scale)`
-- with a captured float `scale`, `(z => z + k)` etc., which previously did
-- INTEGER arith on boxed-float pointers → garbage).
capTypeOf : OrdMap (String, LTy) -> String -> LTy
capTypeOf env c = match omLookup c env
  Some (_, LTFloat) => LTFloat
  Some (_, LTFloatU) => LTFloat
  Some (_, LTU64) => LTU64
  Some (_, LTU64U) => LTU64
  Some (_, LTI64) => LTI64
  _ => LTInt

-- the live operand words for a captured-name list (looked up in the emit env).
-- Routed through lookupVarG (Mut) so an LTFloatU let-bound float is BOXED to an
-- i64 word before being stored into a closure capture slot (escape coercion) —
-- the closure ABI is uniform i64, and loadCaptures reads captures back as words.
capWords : Emit -> OrdMap (String, LTy) -> List String -> List String
capWords _ _ [] = []
capWords e env (c :: rest) =
  let (op, _) = lookupVarG e env c
  op :: capWords e env rest

-- keep only the names present as keys in the emit env (the capturable locals);
-- drop free names that resolve to top-level globals (known fns / ctors).
keepInEnv : OrdMap (String, LTy) -> List String -> List String
keepInEnv _ [] = []
keepInEnv env (k :: rest) =
  if envHasKey env k then k :: keepInEnv env rest else keepInEnv env rest

envHasKey : OrdMap (String, LTy) -> String -> Bool
envHasKey env k = omHasKey k env

-- left-biased env union — `left`'s bindings win a same-name collision.  Mirrors
-- a `left ++ right` first-match-wins list concat (which composes a
-- closure's captures/self-ref/params into one starting env), but O(|left| log n)
-- instead of a linear scan per later lookup.
envMergeL : OrdMap (String, LTy) -> OrdMap (String, LTy) -> OrdMap (String, LTy)
envMergeL left right = envMergeLKeys (omKeys left) left right

envMergeLKeys : List String ->
  OrdMap (String, LTy) ->
  OrdMap (String, LTy) ->
  OrdMap (String, LTy)
envMergeLKeys [] _ right = right
envMergeLKeys (k :: rest) left right = match omLookup k left
  Some v => omInsert k v (envMergeLKeys rest left right)
  None => envMergeLKeys rest left right

-- #242/#623: order-preserving dedup keeping the LAST occurrence of each name —
-- NOT the same function as `support.util.dedup`, which keeps the FIRST (#623's
-- "`dedup` could replace `dedupS` directly" is WRONG: on [a,b,a] this yields
-- [b,a] and `dedup` yields [a,b], and the order feeds emitted-definition order).
-- Reversing on both sides turns last-wins into first-wins, so the O(n²)
-- `contains`-per-element scan routes through the canonical O(n·log n)
-- OrdMap-backed `dedup` with the result byte-identical.
dedupS : List String -> List String
dedupS xs = reverseL (dedup (reverseL xs))

-- ── ADT constructors + pattern matching ───────────────────────────
-- VALUE REPRESENTATION (RUNTIME-DESIGN.md §8.4 "Option A", extended from the
-- slice-1 Float box): an ADT value is a BOXED heap cell with a one-word header.
--   cell layout (8-byte words):  [ 0: i64 tag ] [ 8: field0 ] [ 16: field1 ] …
-- the tag is the constructor's COMPOSITE (typeId, ordinal) — see `cellTag` (computed
-- identically at the alloc site and at every switch test, so the two always agree); the word
-- carried in registers is the cell pointer (`ptrtoint`, low bit 0 — disjoint from
-- the immediate-int low-bit-1 encoding, exactly as the Float box is).  Allocation
-- reuses the slice-1 `@mdk_alloc` (malloc-and-leak; no GC this slice).

-- `hashName` (djb2, seed 5381) lives in `backend.private_mangle`, shared with the
-- WasmGC emitter so the dict-witness tag agrees across backends.  STILL used here
-- for the NON-ctor sentinel headers ("$tuple"/"$ref"/"$closure") and dict witness
-- words; constructor cell tags use `cellTag` (ordinals) instead.

-- ── constructor tag = dense per-type ordinal (RUNTIME-DESIGN §8.4, ratified ──────
--    2026-06-07; supersedes the spike's i64 string-hash for CONSTRUCTOR tags).
-- A constructor C of type T is tagged with its 0-based index in T's
-- declaration-ordered constructor list (the ratified value — `br_table`-ready and
-- collision-free).  But the spike's ARG-TAG dispatch (emitTagMatch) discriminates a
-- value's TYPE by loading its cell tag and OR-ing it against a candidate type's
-- ctor tags — and per-type ordinals COLLIDE across types (every type has an
-- ordinal-0 ctor), so a bare ordinal cannot identify the type.  The one-word header
-- therefore carries a COMPOSITE: a dense per-type id in the high 32 bits and the
-- ratified per-type ctor ordinal in the low 32 bits.
--   • match-head test (within ONE statically-known type) and `br_table` use the low
--     half — `tag & 0xffffffff` is the dense 0-based ordinal.
--   • the spike's arg-tag dispatch uses the FULL composite, which is globally unique
--     (distinct type ⇒ distinct high half), so cross-type discrimination is exact.
-- The high half is spike scaffolding for that runtime dispatch; the real backend
-- resolves such call sites statically / by dictionary and keeps only the low-half
-- ordinal.  hashName is gone from every constructor tag — collisions are impossible.
-- 2^32, the type-id shift.  (Int is 63-bit; type-id × 2^32 + ordinal stays well
-- under 2^62 for any real program.)
ctorTagShift : Int
ctorTagShift = 4294967296

-- the cell-header tag a NAME stamps / is tested against.  Sentinel headers
-- ("$tuple"/"$ref"/"$closure") keep their hash; every constructor (incl. the
-- built-in list Cons/Nil and a user ctor that owns those names) gets the composite
-- (typeId, ordinal).  Alloc and every tag test route through THIS one function, so
-- the stored tag and the compared tag are identical by construction.
-- RESERVED ADT-TAG BLOCK.  The runtime ADTs — List, Option,
-- Result, Ordering — get FIXED composite tags, far above any real program's dense
-- type-id range, so a C extern can construct these cells (mdk_some/mdk_cons/… in
-- runtime/medaka_rt.c) with a tag a later `match` agrees with.  The driver
-- (llvm_emit_main.mdk) does NOT load the prelude, so a prelude-free fixture using
-- `Some`/`None`/`Ok`/… has them ABSENT from the ctor→type table — without this
-- reservation `Some` and `Cons` both fall to the "one past" type-id with ordinal 0
-- and COLLIDE.  Both alloc and every tag test route through `cellTag`, so reserving
-- here keeps construction and the match-head test consistent by construction.
-- The C side hardcodes the SAME constants (MDK_TAG_* in runtime/medaka_rt.c); keep
-- the two in sync.  Ordinals follow core.mdk: Option = Some|None, Result = Ok|Err,
-- Ordering = Lt|Eq|Gt; List (synthetic) = Cons|Nil.  #361: a user type reusing
-- one of these names is not a "spike limitation" that "the real backend resolves
-- statically" — as if this emitter were the spike and some other, more careful
-- backend existed downstream. THIS is the real (and only) backend; there is no
-- other one to defer to. The actual guard is upstream, in the
-- RESOLVER: `data Foo = Ok Int | Bad` is rejected before it ever reaches this file
-- (`dupErr "constructor"`, resolve.mdk:1422, message "Duplicate constructor: Ok" —
-- probed). So a user ctor can never actually alias `Cons`/`Some`/`None`/`Ok`/`Err`/
-- `Lt`/`Eq`/`Gt` by the time `reservedTag` runs; this function's fixed-tag table is
-- safe because that invariant is enforced elsewhere, not because collisions here are
-- merely "consistent." If that resolver check is ever removed, THIS is the place a
-- silent tag collision would resurface — worth an emit-time assertion, not just a
-- comment (EMITTER-SEMANTICS M2).
-- Reserved type-id slots, so the next one added takes the first FREE id rather
-- than a used one: 0 List, 1 Option, 2 Result, 3 Ordering, 4 ByteBlock, 5 the
-- U64 cell (`u64CellTag`), 6 the I64 cell (`i64CellTag`).  Slots 4 to 6 are cell
-- headers with no `reservedTag` arm, for the reason slot 4 gives.  Slot 4
-- is NOT an ADT and deliberately has no `reservedTag` arm -- `ByteBlock` is a
-- type name, and an arm here would hand its cell header to a user CONSTRUCTOR
-- that happened to be spelled `ByteBlock`.  Its one construction site is
-- mdk_byteblock_alloc in runtime/medaka_rt.c, which spells the same composite as
-- MDK_BYTEBLOCK_TAG and pins it to `MDK_TAG(4, 0)` with a _Static_assert.
reservedTypeBase : Int
reservedTypeBase = 65536

reservedTag : String -> Option Int
reservedTag name =
  if name == "Cons" then
    Some ((reservedTypeBase + 0) * ctorTagShift + 0)
  else if name == "Nil" then
    Some ((reservedTypeBase + 0) * ctorTagShift + 1)
  else if name == "Some" then
    Some ((reservedTypeBase + 1) * ctorTagShift + 0)
  else if name == "None" then
    Some ((reservedTypeBase + 1) * ctorTagShift + 1)
  else if name == "Ok" then
    Some ((reservedTypeBase + 2) * ctorTagShift + 0)
  else if name == "Err" then
    Some ((reservedTypeBase + 2) * ctorTagShift + 1)
  else if name == "Lt" then
    Some ((reservedTypeBase + 3) * ctorTagShift + 0)
  else if name == "Eq" then
    Some ((reservedTypeBase + 3) * ctorTagShift + 1)
  else if name == "Gt" then
    Some ((reservedTypeBase + 3) * ctorTagShift + 2)
  else
    None

-- the cell-header tag a NAME stamps / is tested against.  Sentinel headers
-- ("$tuple"/"$ref"/"$closure") keep their hash; the runtime ADTs route through
-- `reservedTag` (fixed, program-stable); every other constructor gets the composite
-- (typeId, ordinal).  Alloc and every tag test route through THIS one function, so
-- the stored tag and the compared tag are identical by construction.
-- Bool immediates are hardcoded by emitVar/emitLit: True→word 3 (ashr1→tag 1),
-- False→word 1 (ashr1→tag 0).  Special-case before the ctor-table lookup so
-- construction and discrimination agree regardless of whether Bool is in the table.
cellTag : Emit -> String -> Int
cellTag e name =
  if name == "True" then
    1
  else if name == "False" then
    0
  else if contains name ["$tuple", "$ref", "$closure"] then
    hashName name
  else match reservedTag name
    Some t => t
    None => ctorTypeId e name * ctorTagShift + ctorOrdinal e name

-- the 0-based index of constructor `name` in its type's declaration-ordered ctor
-- list.  The built-in list Cons/Nil are not user-declared (absent from the
-- ctor→type table) → reserved ordinals 0/1 of the synthetic list type.
ctorOrdinal : Emit -> String -> Int
ctorOrdinal e name = match ctorTypeOf e name
  -- #352: `ctorTypeOf name = Some ty` means `name` IS in the ctor→type table, so it
  -- is in `ty`'s bucket and therefore in the ordinal map — the map probe and the
  -- `indexOfStr` scan return the same Int.  RUN-EMIT-003: the scan path is retired.
  Some _ => match !e.ctorOrdinalMap
    Some m => optionOr 0 (omLookup name m)
    None => panic "llvm: ctorOrdinalMap read before install (internal error)"
  None => if name == "Nil" then 1 else 0

-- the dense per-type id of the type that owns constructor `name`: its index among
-- the program's distinct type names (declaration order).  The built-in list (and
-- any name not in the ctor→type table) gets a reserved id one past the user types,
-- so its composite tags can never collide with a user type's.
ctorTypeId : Emit -> String -> Int
ctorTypeId e name = match ctorTypeOf e name
  -- #352: `e.typeIdMap` is built from the SAME `nubStr (typeNamesOf …)` list that
  -- `distinctTypeNames` memoizes, numbered from 0 — so the probe and the
  -- `indexOfStr` scan agree, and `omSize` is that list's length (nubStr ⇒ distinct).
  -- RUN-EMIT-003: both `distinctTypeNames`-scan paths are retired.
  Some ty => match !e.typeIdMap
    Some m => optionOr 0 (omLookup ty m)
    None => panic "llvm: typeIdMap read before install (internal error)"
  None => match !e.typeIdMap
    Some m => omSize m
    None => panic "llvm: typeIdMap read before install (internal error)"

-- RUN-EMIT-003: `distinctTypeNames` (and the `distinctTypeNamesCache` memo that
-- existed only to make its O(n²) `nubStr` affordable) are GONE with the two
-- `ctorTypeId` scan branches that were their only callers.  `e.typeIdMap` is built
-- from exactly that `nubStr (typeNamesOf …)` list numbered from 0 (see
-- `installCtorTypeMap`), so `omSize` IS the distinct-type count and a probe IS the
-- index — the list never needs materialising during an emission.

typeNamesOf : List (String, String) -> List String
typeNamesOf [] = []
typeNamesOf ((_, t) :: rest) = t :: typeNamesOf rest

-- dedup a list of strings, preserving first-occurrence order.  #990: the seen-set is an
-- OrdMap (membership O(log k)) instead of a `contains`-scanned list (O(k)) — so the nub
-- is O(N log N) not O(N²).  `distinctTypeNames` memoizes the result, but the one-time
-- computation was itself O(types²) and thus a QUADRATIC `emit`-op contributor as the type
-- count grows (one-per-interface on dispatch-heavy code).  Output order is unchanged
-- (first occurrence kept), so every downstream type-id / ordinal is byte-identical.
nubStr : List String -> List String
nubStr xs = nubStrAcc xs omEmpty

nubStrAcc : List String -> OrdMap Unit -> List String
nubStrAcc [] _ = []
nubStrAcc (x :: xs) seen =
  if omHasKey x seen then
    nubStrAcc xs seen
  else
    x :: nubStrAcc xs (omInsert x () seen)

-- allocate a constructor cell {tag, field…}; the field words are already emitted.
-- Result is the cell pointer as an i64 word, typed LTCon.  A NULLARY constructor
-- (RUNTIME-DESIGN §8.1 / §8.4 decision 1: nullary ctors are immediate/free) does
-- NOT allocate — it is the IMMEDIATE word `(cellTag<<1)|1`, carrying the SAME
-- composite (typeId, ordinal) tag a boxed cell would store in its header, untaggable
-- by `ashr 1`.  This generalises the existing Bool immediate (emitVar True→"3"/
-- False→"1") to every nullary ctor.  The constant operand emits no instructions; a
-- `match` recovers the tag via `loadDiscriminant` (low-bit branch), so construction
-- and the match-head test agree on `cellTag` whether the value is immediate or boxed.
emitCtorAlloc : Emit -> String -> List String -> (String, LTy)
emitCtorAlloc e name [] = (intToString (cellTag e name * 2 + 1), LTCon)
emitCtorAlloc e name fields =
  let arity = lengthS fields
  let p = freshReg e
  let _ =
    emit e "  \{p} = call ptr @mdk_alloc(i64 \{intToString (8 * (arity + 1))})"
  let _ = emit e "  store i64 \{intToString (cellTag e name)}, ptr \{p}"
  let _ = storeFields e p fields 0
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTCon)

-- store each field at offset 8*(i+1) (field 0 follows the one-word header).
storeFields : Emit -> String -> List String -> Int -> Unit
storeFields _ _ [] _ = ()
storeFields e p (f :: rest) i =
  let fp = freshReg e
  let _ =
    emit
      e
      "  \{fp} = getelementptr i8, ptr \{p}, i64 \{intToString (8 * (i + 1))}"
  let _ = emit e "  store i64 \{f}, ptr \{fp}"
  storeFields e p rest (i + 1)

-- load a cell's tag (header word at offset 0) given the cell's pointer word.
loadTag : Emit -> String -> String
loadTag e ptrWord =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{ptrWord} to ptr"
  let t = freshReg e
  let _ = emit e "  \{t} = load i64, ptr \{p}"
  t

-- the DISCRIMINANT word a constructor `match` head (and arg-tag dispatch) tests.
-- A value of an ADT type is EITHER an immediate nullary ctor (low bit 1 — its
-- composite (typeId, ordinal) tag rides the payload, recovered by `ashr 1`) OR a
-- boxed pointer to a cell whose header word IS that same composite tag (low bit 0 —
-- `loadTag` it).  A type that mixes the two (e.g. Option = None immediate + Some
-- boxed) means a single scrutinee can be either, so branch on the low bit BEFORE
-- choosing — an immediate must NEVER be dereferenced (`loadTag` on an odd word
-- inttoptr's to a misaligned address and segfaults).  Both arms phi to ONE tag word
-- equal to the `cellTag` the alloc site stamps, so emitConChain/emitTagMatch compare
-- against `cellTag` UNCHANGED: immediate and boxed reps are tag-comparable by
-- construction (RUNTIME-DESIGN §8.1).  loadTag stays the raw boxed-cell load — used
-- directly only where the value is known boxed (array length header).
loadDiscriminant : Emit -> String -> String
loadDiscriminant e word =
  let n = intToString (freshLocal e)
  let imm = "discimm" ++ n
  let box = "discbox" ++ n
  let cont = "disccont" ++ n
  let lb = freshReg e
  let _ = emit e "  \{lb} = and i64 \{word}, 1"
  let isImm = freshReg e
  let _ = emit e "  \{isImm} = icmp eq i64 \{lb}, 1"
  let _ = emit e "  br i1 \{isImm}, label %\{imm}, label %\{box}"
  let _ = emit e (imm ++ ":")
  let iv = freshReg e
  let _ = emit e "  \{iv} = ashr i64 \{word}, 1"
  let _ = emit e ("  br label %" ++ cont)
  let _ = emit e (box ++ ":")
  let bv = loadTag e word
  let _ = emit e ("  br label %" ++ cont)
  let _ = emit e (cont ++ ":")
  let d = freshReg e
  let _ = emit e "  \{d} = phi i64 [ \{iv}, %\{imm} ], [ \{bv}, %\{box} ]"
  d

-- the cell a guarded boxed load reads INSTEAD of a word that is not a cell
-- pointer, so the load is total without a branch (`loadTagGuarded`).  Its one
-- word holds -1, which no `cellTag` can return — `typeId * ctorTagShift +
-- ordinal` and `reservedTag` are non-negative by construction, True/False are
-- 1/0, and the three sentinel headers ("$tuple"/"$ref"/"$closure") are djb2
-- hashes of short strings — so the loaded "tag" matches no constructor and every
-- test on it falls through to the switch default.
discNoneCell : String
discNoneCell = "@mdk_disc_none"

-- define that cell, once per emitted module.  It goes through `emitGlobal` (a
-- `; mdk-module`-MARKED top-level entity) rather than the preamble, because the
-- preamble is copied into EVERY ThinLTO partition and a definition copied that
-- way redefines itself (test/lib/pcg_partition.sh).  `program` scope is the one
-- every whole-program entity already uses; `private` keeps it local, so the two
-- halves of a `--emit-prelude-obj` build can each carry their own.
emitDiscNoneCell : Emit -> Unit
emitDiscNoneCell e = withProgramScope e (_ =>
  emitGlobal e "\{discNoneCell} = private unnamed_addr constant i64 -1")

-- the boxed half of `loadDiscriminant`, made TOTAL without a branch: read the
-- header of `word` when `word` really is a cell pointer (low bit 0), and of
-- `discNoneCell` when it is not.  `select` on the POINTER (not on the loaded
-- value) is what keeps the load from ever dereferencing an immediate, which
-- `inttoptr`s to a misaligned address and segfaults.  Branchless on purpose: the
-- guard must not add a value-dependent branch to code that is timing-sensitive.
loadTagGuarded : Emit -> String -> String
loadTagGuarded e word =
  let lb = freshReg e
  let _ = emit e "  \{lb} = and i64 \{word}, 1"
  let isBox = freshReg e
  let _ = emit e "  \{isBox} = icmp eq i64 \{lb}, 0"
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{word} to ptr"
  let sp = freshReg e
  let _ = emit e "  \{sp} = select i1 \{isBox}, ptr \{p}, ptr \{discNoneCell}"
  let t = freshReg e
  let _ = emit e "  \{t} = load i64, ptr \{sp}"
  t

-- load field `idx` (offset 8*(idx+1)) of a cell given its pointer word.
loadField : Emit -> String -> Int -> String
loadField e ptrWord idx =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{ptrWord} to ptr"
  let fp = freshReg e
  let _ =
    emit
      e
      "  \{fp} = getelementptr i8, ptr \{p}, i64 \{intToString (8 * (idx + 1))}"
  let f = freshReg e
  let _ = emit e "  \{f} = load i64, ptr \{fp}"
  f

-- load the first `a` fields of a cell as a list of operand words.
loadFields : Emit -> String -> Int -> Int -> List String
loadFields e foc a i
  | i >= a = []
  | otherwise =
    let f = loadField e foc i
    f :: loadFields e foc a (i + 1)

-- a `match` lowered to a decision tree (CDecision).  Mirrors core_ir_eval's
-- cevalDecision exactly, but emits an LLVM CFG instead of walking values: the
-- scrutinee word, an `alloca` result slot, the tree (which routes control via
-- br/icmp to the selected arm, where the arm stores its body value into the slot
-- and branches to the end label), then a load of the slot in the end block.  The
-- arm's static result type is captured into `rty` as the arm body is emitted (all
-- arms agree — well-typed match).
emitDecision : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  List CArm ->
  CTree ->
  (String, LTy)
emitDecision e env scrut arms tree =
  let (sv, _) = emitExpr e env scrut
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "decend" ++ intToString (freshLocal e)
  let rty = Ref LTInt
  let savedTrmc = !e.trmcCtx
  e.trmcCtx := TrmcOff
  let savedGDisp = !e.gDispCtx
  e.gDispCtx := GDispOff
  let savedSelfTail = !e.selfTailCtx
  e.selfTailCtx := None
  -- "" = a miss in an expression-position match is a genuine non-exhaustive abort,
  -- NOT the enclosing clause chain's fallthrough (the clause's pattern already
  -- matched to get here).  Passing it as an argument replaces the old
  -- save+null+restore of fallthroughLabelRef (issue #354).
  let _ = emitTree e env [sv] arms [sv] slot endL "" rty tree
  e.trmcCtx := savedTrmc
  e.gDispCtx := savedGDisp
  e.selfTailCtx := savedSelfTail
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  (r, !rty)
-- A `match` in expression position is self-contained: its own non-exhaustive
-- CTFail is a genuine abort, NOT the enclosing clause-chain's fallthrough.  Save
-- + null the fallthrough label across the tree so a body-level match emitted
-- inside a chained clause leaf doesn't inherit (and wrongly branch to) the
-- next-clause block.  Restored after.

-- Likewise self-contained for TRMC: an expression-position `match`'s arms
-- compute VALUES into `slot`, never cons-into-dest — so clear the TRMC ctx
-- across the tree (a tail cons in a match arm is Phase 2, deliberately not here).

-- walk the compiled CTree, emitting basic blocks.  `root` is the whole scrutinee
-- word (kept for the leaf re-match that recovers bindings — mirrors ceval's
-- `root`); `occs` is the live column words (the matrix columns), starting as just
-- [root] and expanding into a constructor's fields as the tree descends.  Every
-- path terminates its current block (a `br` to `endL` after storing, a `br` into
-- a sibling test block, or `unreachable` for CTFail).
emitTree : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  List String ->
  String ->
  String ->
  String ->
  Ref LTy ->
  CTree ->
  Unit
-- CTFail: the matrix path matched no row.  In a CHAINED single-clause tree
-- (emitClauseChain) this is "this clause's pattern didn't match" → resume the next
-- clause via `ftL`, the fallthrough label THREADED IN by the caller; with no next
-- clause (`""`) it is a genuine non-exhaustive-match abort.  A bare `unreachable`
-- here was UB (LLVM `ud2` → a
-- silent SIGTRAP, no output); call the noreturn abort the leaf's site names
-- (`emitFailTrap`: E-NONEXHAUSTIVE-MATCH or E-LET-REFUTE, located as the
-- interpreter's message is) before the `unreachable`, mirroring the div-by-zero
-- trap.  (The GUARD-chain half of "try the
-- next clause" is NOT this arm — that is the `__fallthrough__` sentinel, lowered by
-- emitFallthrough from the label stamped into the node.)
--
-- `ftL` is a PLAIN PARAMETER, not ambient state (issue #354).  A
-- module-level Ref that four entry points save+NULL+restore makes "is the
-- fallthrough live here?" a whole-call-graph question — the exact shape that made the
-- `__fallthrough__` sentinel branch to @mdk_oob instead of the next clause (a run≠build
-- miscompile, fixed 2026-07-13 by moving THAT label into the node).  Threading it makes
-- the answer local and the hazard structurally impossible: an entry point that means
-- "a miss here is a genuine abort" passes "" and cannot forget to restore.
emitTree e _ _ _ _ _ _ "" _ (CTFail site) = emitFailTrap e site
emitTree e _ _ _ _ _ _ lbl _ (CTFail _) = emit e ("  br label %" ++ lbl)
emitTree e env roots arms _ slot endL _ rty (CTLeaf i) =
  emitLeaf e env roots arms i slot endL rty
-- CTGuard i fail: arm i matched but is GUARDED.  Re-bind its pattern (like a
-- leaf), evaluate its guards; all pass → eval the body (emitLeaf-style); any
-- guard fails → branch to the `fail` subtree, which resumes the ordered match at
-- the same column context `occs` (mirrors core_ir_eval's `cevalGuardedBody`).
-- This CLOSES the historical CTGuard emitter gap — `compiler/` code on the native
-- self-compile path no longer needs the guard-free convention for `CGBool`
-- guards.  A refutable `p <- e` pattern guard stays a contained gap (not produced
-- by current source); a bad arm index likewise.
emitTree e env roots arms occs slot endL ftL rty (CTGuard i fail) =
  match nthArm arms i
    Some (CArm pat guards body) =>
      if allGuardsEmittable guards then
        emitGuardedArm
          e
          env
          roots
          arms
          occs
          pat
          guards
          body
          fail
          slot
          endL
          ftL
          rty
      else
        let _ =
          gapU
            e
            "refutable pattern guard (`p <- e`) in a match arm (CTGuard) — not yet lowered"
        let _ = emit e ("  store i64 0, ptr " ++ slot)
        emit e ("  br label %" ++ endL)
    None =>
      let _ = gapU e "guarded arm index out of range (CTGuard)"
      let _ = emit e ("  store i64 0, ptr " ++ slot)
      emit e ("  br label %" ++ endL)
emitTree e env roots arms occs slot endL ftL rty (CTDrop sub) =
  emitTree e env roots arms (tailS occs) slot endL ftL rty sub
emitTree e env roots arms occs slot endL ftL rty (CTSwitch branches dft) =
  emitSwitch e env roots arms occs branches dft slot endL ftL rty

-- a terminal leaf: re-match the selected arm's ORIGINAL pattern against the leaf's
-- root word(s) — `roots` (the tree path guarantees it matches) to bind its
-- variables — emitting getelementptr loads for each field a `PVar` deconstructs —
-- then emit the body, store the result, and branch to the end block.
emitLeaf : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  Int ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitLeaf e env roots arms i slot endL rty = match nthArm arms i
  Some (CArm pat _ body) =>
    let env2 = bindArm e env pat roots body
    match !e.gDispCtx
      GDispOn _ _ _ _ _ => emitGDispBody e env2 body
      GDispOff => match !e.trmcCtx
        TrmcOn _ _ _ _ _ _ => emitTrmcBody e env2 body
        TrmcOff => emitArmBody e env2 body slot endL rty
  None => gapU e "decision arm index out of range"
-- TRMC (TRMC-DESIGN.md): when a destination-passing loop is active (multi-clause
-- eligible fn — emitClauseTree's clause-selection tree), the clause body is a
-- TAIL leaf → descend it via emitTrmcBody (cons-into-dest+loop / store+exit)
-- instead of computing a value into `slot`.  `e.trmcCtx` is cleared inside any
-- expression-position `match` (emitDecision), so a nested match's arms still
-- compute values normally.

-- a guarded clause: re-match the arm pattern against `root` (a RANGE/`PRng` arm
-- canonicalizes to PWild in the matrix, so the tree routed here unconditionally
-- and the actual range comparison happens HERE — `emitRefutMatch` branches to
-- `failL` on no-match; an irrefutable pattern emits no test, preserving the
-- plain-`if`-guard case), run the guards (branching to `failL` on any failure),
-- and on all-pass eval the body into `slot`; then emit `failL` and the `fail`
-- subtree (resumes the match at the same column context `occs`).
emitGuardedArm : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  List String ->
  Pat ->
  List CGuard ->
  CExpr ->
  CTree ->
  String ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitGuardedArm e env roots arms occs pat guards body fail slot endL ftL rty =
  let failL = "guardfail" ++ intToString (freshLocal e)
  let env2 = emitRefutArm e env pat roots body failL
  let env3 = emitGuardChain e env2 guards body failL
  -- Under an ACTIVE TRMC loop the guarded arm's body is a TAIL leaf: descend it
  -- via emitTrmcBody (cons-into-dest+loop / plain-tail+loop / base+exit), exactly
  -- like emitLeaf's TrmcOn branch.  Value-emitting it here instead stored into
  -- `slot` and branched to the TAIL match's DEAD end block (`trmcdecend:` … loads
  -- then `unreachable`) — runtime UB, a SILENT MISCOMPILE (native returned `[]`/0
  -- where the interpreter and WasmGC returned the right list; wasm's tail engine
  -- always handled guards).  Fixture: test/stack_fixtures/guard_arm_trmc.mdk.
  let _ = match !e.gDispCtx
    GDispOn _ _ _ _ _ => emitGDispBody e env3 body
    GDispOff => match !e.trmcCtx
      TrmcOn _ _ _ _ _ _ => emitTrmcBody e env3 body
      TrmcOff => emitArmBody e env3 body slot endL rty
  let _ = emit e (failL ++ ":")
  emitTree e env roots arms occs slot endL ftL rty fail

-- A matched arm's body.  It normally computes its value into the match's result
-- `slot` and joins at `endL`.  When the match is in the tail position of the
-- define named by `e.selfTailCtx`, the body is descended instead: a saturated
-- call of that define is emitted as `musttail call` + `ret` straight from the
-- leaf, so the recursion does not grow the stack even where clang does not turn
-- the call into a jump (-O0).  Every other leaf still stores and joins.
emitArmBody : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitArmBody e env body slot endL rty = match !e.selfTailCtx
  Some self => emitSelfTailArm e env self body slot endL rty
  None => emitArmValue e env body slot endL rty

emitArmValue : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitArmValue e env body slot endL rty =
  emitArmWord e (emitExpr e env body) slot endL rty

-- store an arm's already-emitted value into `slot` and join at `endL`.
emitArmWord : Emit -> (String, LTy) -> String -> String -> Ref LTy -> Unit
emitArmWord e (bv, bty) slot endL rty =
  rty := bty
  let _ = emit e "  store i64 \{bv}, ptr \{slot}"
  emit e ("  br label %" ++ endL)

-- An arm body in the tail position of the define `self` (its emitted symbol).
-- `if`, `let`, a `let`/`where` group, a block and a nested match pass tail
-- position on (the nested match's arms join at the same `endL`, `e.selfTailCtx`
-- left live as `emitTrmcBody` leaves `trmcCtx`; a let, group or block emits its
-- bindings as the value path does); a saturated call of `self` is returned
-- with `musttail`, the calling-convention proof `emitFnBody` relies on;
-- anything else stores into `slot` and joins.
emitSelfTailArm : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitSelfTailArm e env self (CIf c t f) slot endL rty =
  let (thenL, elseL) = emitTailIfHead e env c
  let _ = emit e (thenL ++ ":")
  let _ = emitSelfTailArm e env self t slot endL rty
  let _ = emit e (elseL ++ ":")
  emitSelfTailArm e env self f slot endL rty
emitSelfTailArm e env _ (CDecision scrut arms tree) slot endL rty =
  let (sv, _) = emitExpr e env scrut
  emitTree e env [sv] arms [sv] slot endL "" rty tree
emitSelfTailArm e env self (CLet recF pat e1 e2) slot endL rty =
  if letBinds recF pat e1 then
    emitSelfTailArm e (bindLet e env recF pat e1 e2) self e2 slot endL rty
  else
    emitArmValue e env (CLet recF pat e1 e2) slot endL rty
emitSelfTailArm e env self (CLetGroup binds body) slot endL rty =
  match bindLetGroup e env binds body
    Some env2 => emitSelfTailArm e env2 self body slot endL rty
    None => emitArmWord e (letGroupGap e) slot endL rty
emitSelfTailArm e env self (CBlock stmts) slot endL rty =
  match lastStmtExpr stmts
    Some last =>
      emitSelfTailArm e (emitBlockInit e env stmts) self last slot endL rty
    None => emitArmValue e env (CBlock stmts) slot endL rty
emitSelfTailArm e env self body slot endL rty =
  if directTailCallee e body == Some self then
    emitTailCallRet e env self body
  else
    emitArmValue e env body slot endL rty

-- emit the guard tests left-to-right: a `CGBool` tests a Bool (`True` = the word
-- 3) and branches to `failL` on failure, falling through on success; a
-- `CGBind p <- e` evaluates `e` and refutably matches `p` against it via
-- `emitRefutMatch` (an irrefutable `p` emits no test + just binds; a refutable
-- `Just x <- e` tests the discriminant and branches to `failL` on no-match — G5).
-- Returns the env extended by any `CGBind` bindings (visible to later guards +
-- the body).
emitGuardChain : Emit ->
  OrdMap (String, LTy) ->
  List CGuard ->
  CExpr ->
  String ->
  OrdMap (String, LTy)
emitGuardChain _ env [] _ _ = env
emitGuardChain e env ((CGBool g) :: rest) body failL =
  let (bw, _) = emitExpr e env g
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{bw}, 3"
  let pass = "guardok" ++ intToString (freshLocal e)
  let _ = emit e "  br i1 \{cmp}, label %\{pass}, label %\{failL}"
  let _ = emit e (pass ++ ":")
  emitGuardChain e env rest body failL
emitGuardChain e env ((CGBind p ex) :: rest) body failL =
  let (v, _) = emitExpr e env ex
  let env2 = emitRefutMatch e env p v body failL
  emitGuardChain e env2 rest body failL

-- a clause's guards are now ALL emittable: `CGBool` guards always were; a
-- `CGBind p <- e` is lowered via `emitRefutMatch` whether `p` is irrefutable
-- (just binds) or refutable (`Just x <- e` — runtime discriminant test, G5).
allGuardsEmittable : List CGuard -> Bool
allGuardsEmittable [] = True
allGuardsEmittable ((CGBool _) :: rest) = allGuardsEmittable rest
allGuardsEmittable ((CGBind _ _) :: rest) = allGuardsEmittable rest

-- ── arm binding against the leaf's ROOT WORD(S) ─────────────────────────────
-- ONE root is the ordinary single scrutinee (a `match` expression, or an arity-1
-- clause chain): re-match the arm pattern against it, exactly as before.
--
-- SEVERAL roots are the un-boxed PARAMETER WORDS of an arity-≥2 clause chain
-- (emitClauseTree).  There, `clauseArm` wrapped the clause's param patterns in a
-- synthetic `PTuple` only because `CArm` carries a single `Pat` — there is NO
-- tuple cell at runtime.  So bind element-wise: pattern i against param word i.
-- This is what retires the per-call argument-tuple `@mdk_alloc`.
bindArm : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  List String ->
  CExpr ->
  OrdMap (String, LTy)
bindArm e env pat [v] body = bindPattern e env pat v body
bindArm e env (PTuple ps) roots body = bindEach e env ps roots body
bindArm e env pat (v :: _) body = bindPattern e env pat v body
bindArm _ env _ [] _ = env

-- bind each pattern against its OWN word — no cell, hence no `loadField`.  The
-- multi-root counterpart of `bindFields` (which loads field i out of one cell).
bindEach : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  List String ->
  CExpr ->
  OrdMap (String, LTy)
bindEach e env (p :: ps) (v :: vs) body =
  let env2 = bindPattern e env p v body
  bindEach e env2 ps vs body
bindEach _ env _ _ _ = env

-- the refutable counterpart of `bindArm` (guarded / range-pattern clause): test +
-- bind each param pattern against its own word, branching to `failL` on a miss.
emitRefutArm : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  List String ->
  CExpr ->
  String ->
  OrdMap (String, LTy)
emitRefutArm e env pat [v] body failL = emitRefutMatch e env pat v body failL
emitRefutArm e env (PTuple ps) roots body failL =
  emitRefutEach e env ps roots body failL
emitRefutArm e env pat (v :: _) body failL =
  emitRefutMatch e env pat v body failL
emitRefutArm _ env _ [] _ _ = env

emitRefutEach : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  List String ->
  CExpr ->
  String ->
  OrdMap (String, LTy)
emitRefutEach e env (p :: ps) (v :: vs) body failL =
  let env2 = emitRefutMatch e env p v body failL
  emitRefutEach e env2 ps vs body failL
emitRefutEach _ env _ _ _ _ = env

-- bind a pattern's variables against a value word, emitting field loads for the
-- constructor sub-patterns.  Mirrors the binding half of eval.mdk's matchPat, but
-- since the decision tree already proved the shape, it only EXTRACTS (no tests).
-- A `PVar`'s static type is recovered from its first typed use in the arm body
-- (reusing the slice-2b `paramUseTy`); pointer-typed fields default to Int, which
-- is harmless — they only ever flow on as LTy-agnostic call args.
bindPattern : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  String ->
  CExpr ->
  OrdMap (String, LTy)
bindPattern _ env PWild _ _ = env
bindPattern _ env (PLit _) _ _ = env
bindPattern e env (PVar x _) v body = bindVarTy e env x v body ""
-- A constructor pattern binds each field with the field's DECLARED type (Gap E2):
-- a scalar declared field type (esp. Float/Bool) types the bound var directly,
-- so `match (Rect w h) { … w * h }` does FLOAT arith on the unboxed fields rather
-- than guessing LTInt from body-use.  Non-scalar / unknown fields fall back to the
-- paramUseTy guess (declared name "" passed through bindFieldsDecl).
bindPattern e env (PCon c args) v body =
  bindFieldsDecl e env args (ctorFieldTypeNamesOf e c) v body 0
bindPattern e env (PTuple ps) v body = bindFields e env ps v body 0
-- built-in list patterns: a cons cell is a 2-field "Cons" constructor
-- (head = field 0, tail = field 1); the empty-list pattern (a "Nil" cell) binds
-- nothing.  The decision tree already proved the shape (HCons/HNil switch), so
-- this only EXTRACTS — same as the PCon binding path, with [head, tail] fields.
bindPattern e env (PCons h t) v body = bindFields e env [h, t] v body 0
bindPattern _ env (PList []) _ _ = env
-- as-pattern `x@p`: bind `x` to the WHOLE value v (same LTy lookup as PVar),
-- then descend into `p` so its inner vars also bind.
bindPattern e env (PAs x _ p) v body =
  let env2 = bindVarTy e env x v body ""
  bindPattern e env2 p v body
-- non-empty list-literal pattern `[p::ps]`: v is a Cons cell (the switch proved
-- it); bind the head element (field 0) to `p` and the tail (field 1) to `PList ps`.
bindPattern e env (PList (p :: ps)) v body =
  bindFields e env [p, PList ps] v body 0
bindPattern e env p _ _ =
  gapEnv
    e
    ("unsupported pattern in match arm (variable / wildcard / constructor / tuple / cons / nil / int-literal only): "
      ++ ptag p)
    env

-- bind variable `x` to word `v`.  Its LTy is the DECLARED field type-head name
-- `declName` when that is a known scalar (Gap E2), else the paramUseTy guess from
-- the arm body, else LTInt — so the declared-type override is additive.
bindVarTy : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  CExpr ->
  String ->
  OrdMap (String, LTy)
bindVarTy e env x v body declName =
  -- Not an `orElse` staircase: `orElse` is eager, so it would run the
  -- `paramUseTy` walk over the whole arm body on every bind, including the
  -- common case where the declared field type already answered.
  -- lint-disable-next-line rule-orelse-staircase
  let ty = match fieldNameToLTy declName
    Some t => t
    None => match paramUseTy (sigMapOf e) [] x body
      Some t => t
      None => LTInt
  omInsert x (v, ty) env

bindFields : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  String ->
  CExpr ->
  Int ->
  OrdMap (String, LTy)
bindFields _ env [] _ _ _ = env
bindFields e env (p :: rest) v body i =
  let f = loadField e v i
  let env2 = bindPattern e env p f body
  bindFields e env2 rest v body (i + 1)

-- like bindFields, but pairs each field pattern with its constructor's DECLARED
-- field type-head name (Gap E2).  A bare PVar/PAs field uses the declared scalar
-- type when known; everything else (nested patterns, unknown/non-scalar fields,
-- missing declared names) falls through to the paramUseTy guess.
bindFieldsDecl : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  List String ->
  String ->
  CExpr ->
  Int ->
  OrdMap (String, LTy)
bindFieldsDecl _ env [] _ _ _ _ = env
bindFieldsDecl e env (p :: rest) declNames v body i =
  let f = loadField e v i
  let declName = nthOr declNames i ""
  let env2 = bindFieldDecl e env p declName f body
  bindFieldsDecl e env2 rest declNames v body (i + 1)

-- bind one constructor field: a bare PVar/PAs uses its declared scalar type, any
-- other pattern recurses through bindPattern (no scalar to apply at the top).
bindFieldDecl : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  String ->
  String ->
  CExpr ->
  OrdMap (String, LTy)
bindFieldDecl e env (PVar x _) declName f body =
  bindVarTy e env x f body declName
bindFieldDecl e env (PAs x _ p) declName f body =
  let env2 = bindVarTy e env x f body declName
  bindPattern e env2 p f body
bindFieldDecl e env p _ f body = bindPattern e env p f body

-- ── refutable pattern match (G5 refutable pattern-guards / G6 range patterns) ──
-- Test pattern `p` against value word `v`, branching to `failL` on a MISMATCH;
-- on a match, bind `p`'s variables and FALL THROUGH, returning the extended env
-- (visible to later guards + the body).  Unlike `bindPattern` (which only
-- EXTRACTS at a tree leaf the decision tree already proved), this emits the
-- runtime TEST too — for the two sites the decision tree can't pre-test: a
-- refutable `p <- e` pattern guard (CGBind) and a range/`PRng` arm pattern
-- (which canonicalizes to PWild in the matrix, so the tree routes to it
-- unconditionally and the guarded-arm re-match must do the comparison — exactly
-- mirroring core_ir_eval's `cevalGuardedBody` re-running `matchPat`).
--   Irrefutable patterns (PWild/PVar/PAs/PTuple) emit NO test (reuse
-- bindPattern's extraction); refutable ones (PLit/PRng/PCon/PCons/PList) emit a
-- discriminant/range/equality test + a `br … failL`.  An unsupported shape is a
-- gap (records, nested-refutable beyond this set).
emitRefutMatch : Emit ->
  OrdMap (String, LTy) ->
  Pat ->
  String ->
  CExpr ->
  String ->
  OrdMap (String, LTy)
-- irrefutable: no test, just bind (delegates to bindPattern's extraction).
emitRefutMatch e env PWild v body _ = bindPattern e env PWild v body
emitRefutMatch e env (PVar x l) v body _ = bindPattern e env (PVar x l) v body
emitRefutMatch e env (PAs x _ p) v body failL =
  let env2 = bindVarTy e env x v body ""
  emitRefutMatch e env2 p v body failL
-- a tuple is irrefutable in SHAPE (the type fixes the arity), but its element
-- patterns can be refutable — recurse element-wise on the loaded fields.
emitRefutMatch e env (PTuple ps) v body failL =
  emitRefutFields e env ps v body failL 0
-- integer / char literal: compare the tagged immediate word directly (both are
-- `n*2+1`); String literal via @mdk_string_eq (tagged Bool result); Bool literal
-- compares the immediate (3/1).
emitRefutMatch e env (PLit (LInt k)) v _ failL =
  -- full-width tag via emitLit (see emitLitChain / #759): a `k*2+1` head wraps for
  -- |k| >= 2^61 and bakes the wrong comparison constant.
  let (kw, _) = emitLit e (LInt k)
  let _ = emitWordEqTest e v kw failL
  env
emitRefutMatch e env (PLit (LChar c)) v _ failL =
  let cp = charCode (arrayGetUnsafe 0 (stringToChars c))
  let _ = emitWordEqTest e v (intToString (cp * 2 + 1)) failL
  env
emitRefutMatch e env (PLit (LBool b)) v _ failL =
  let _ = emitWordEqTest e v (if b then "3" else "1") failL
  env
emitRefutMatch e env (PLit (LString s)) v _ failL =
  let (lit, _) = emitLit e (LString s)
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_string_eq(i64 \{v}, i64 \{lit})"
  let _ = emitWordEqTest e r "3" failL
  env
-- range pattern (G6): `lo <= v && v <= hi` (`..=`) or `lo <= v && v < hi` (`..`),
-- on the tagged immediate words (the `n*2+1` transform is strictly monotonic for
-- both Int and Char, so the tagged comparison matches the untagged one).  Mirrors
-- eval.mdk's inIntRange/inCharRange: incl ⇒ `<= hi`, else `<= hi-1` ≡ `< hi`.
emitRefutMatch e env (PRng lo hi incl) v _ failL =
  let _ = emitRangeTest e v (rngBound lo) (rngBound hi) incl failL
  env
-- constructor: test the discriminant against the ctor's composite tag; on
-- mismatch branch to failL, on match load fields and recurse element-wise.
emitRefutMatch e env (PCon "True" []) v body failL =
  emitRefutMatch e env (PLit (LBool True)) v body failL
emitRefutMatch e env (PCon "False" []) v body failL =
  emitRefutMatch e env (PLit (LBool False)) v body failL
emitRefutMatch e env (PCon c args) v body failL =
  let rep = discRepOfHead e c (lengthS args) [c]
  let _ = emitWordEqTest e (discReg e rep v) (discExpected e rep c) failL
  emitRefutFields e env args v body failL 0
-- list cons cell: test the discriminant is "Cons", then recurse on head/tail.
emitRefutMatch e env (PCons h t) v body failL =
  let rep = discRepOfHead e "Cons" 2 ["Cons"]
  let _ = emitWordEqTest e (discReg e rep v) (discExpected e rep "Cons") failL
  emitRefutFields e env [h, t] v body failL 0
emitRefutMatch e env (PList []) v _ failL =
  let rep = discRepOfHead e "Nil" 0 ["Nil"]
  let _ = emitWordEqTest e (discReg e rep v) (discExpected e rep "Nil") failL
  env
emitRefutMatch e env (PList (p :: ps)) v body failL =
  let rep = discRepOfHead e "Cons" 2 ["Cons"]
  let _ = emitWordEqTest e (discReg e rep v) (discExpected e rep "Cons") failL
  emitRefutFields e env [p, PList ps] v body failL 0
emitRefutMatch e env p _ _ _ =
  gapEnv
    e
    ("refutable pattern in guard/range arm not lowered (variable / wildcard / as / tuple / literal / range / constructor / cons / list only): "
      ++ ptag p)
    env

-- recurse a refutable test over a cell's leading fields (loadField per index).
emitRefutFields : Emit ->
  OrdMap (String, LTy) ->
  List Pat ->
  String ->
  CExpr ->
  String ->
  Int ->
  OrdMap (String, LTy)
emitRefutFields _ env [] _ _ _ _ = env
emitRefutFields e env (p :: rest) v body failL i =
  let f = loadField e v i
  let env2 = emitRefutMatch e env p f body failL
  emitRefutFields e env2 rest v body failL (i + 1)

-- emit `icmp eq word, k`; on inequality branch to failL, else fall through.
emitWordEqTest : Emit -> String -> String -> String -> Unit
emitWordEqTest e word k failL =
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{word}, \{k}"
  let ok = "refok" ++ intToString (freshLocal e)
  let _ = emit e "  br i1 \{cmp}, label %\{ok}, label %\{failL}"
  emit e (ok ++ ":")

-- emit a range membership test on the tagged word `v`: `v >= loWord` AND
-- (incl ? `v <= hiWord` : `v < hiWord`); any failing comparison branches to failL.
emitRangeTest : Emit -> String -> Int -> Int -> Bool -> String -> Unit
emitRangeTest e v lo hi incl failL =
  -- full-width tag via emitLit (see emitLitChain / #759): a `bound*2+1` bound wraps
  -- for |bound| >= 2^61 and bakes the wrong range endpoint.  Both shl/or land in the
  -- entry block, which dominates the mid block that consumes hiW — SSA-valid.
  let (loW, _) = emitLit e (LInt lo)
  let (hiW, _) = emitLit e (LInt hi)
  let n = intToString (freshLocal e)
  let cLo = freshReg e
  let _ = emit e "  \{cLo} = icmp sge i64 \{v}, \{loW}"
  let mid = "rngmid" ++ n
  let _ = emit e "  br i1 \{cLo}, label %\{mid}, label %\{failL}"
  let _ = emit e (mid ++ ":")
  let cHi = freshReg e
  let op = if incl then "sle" else "slt"
  let _ = emit e "  \{cHi} = icmp \{op} i64 \{v}, \{hiW}"
  let ok = "rngok" ++ n
  let _ = emit e "  br i1 \{cHi}, label %\{ok}, label %\{failL}"
  emit e (ok ++ ":")

-- (`rngBound` — the Int codepoint of a range bound literal — is backend-neutral and
-- lives in `compiler/backend/emit_support.mdk`, shared with the WasmGC emitter.)

-- the i-th element of a list, or `dflt` if out of range.
nthOr : List String -> Int -> String -> String
nthOr [] _ dflt = dflt
nthOr (x :: rest) i dflt
  | i == 0 = x
  | otherwise = nthOr rest (i - 1) dflt

-- a switch on the focus column (occs head): constructor-LIKE heads (named ADT
-- constructors HCon, built-in list HCons/HNil, and tuples HTuple) test a
-- DISCRIMINANT word (`loadDiscriminant`: an immediate nullary ctor's `ashr 1`
-- payload, or a boxed cell's loaded header — both the composite `cellTag`); int
-- literals test the immediate directly.  A homogeneous switch (the
-- matrix is either all-constructor-like or all-literal in a column), so the first
-- branch's head selects the test kind.  HCons/HNil/HTuple map to the same tag the
-- alloc site stamps (`cellTag` of "Cons"/"Nil"/"$tuple"), so a constructor
-- test reaches them with no special case beyond the name/arity (see conHeadInfo).
emitSwitch : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  List String ->
  List CTBranch ->
  CTree ->
  String ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitSwitch e env roots arms [] branches dft slot endL ftL rty =
  emitTree e env roots arms [] slot endL ftL rty dft
emitSwitch e env roots arms (foc :: rest) [] dft slot endL ftL rty =
  emitTree e env roots arms rest slot endL ftL rty dft
emitSwitch e env roots arms (foc :: rest) (branches@((CTBranch (HLit _) _) :: _)) dft slot endL ftL rty =
  emitLitChain e env roots arms foc rest branches dft slot endL ftL rty
emitSwitch e env roots arms (foc :: rest) ((CTBranch HUnit sub) :: _) dft slot endL ftL rty =
  emitTree e env roots arms rest slot endL ftL rty sub
emitSwitch e env roots arms (foc :: rest) (branches@((CTBranch h _) :: _)) dft slot endL ftL rty =
  match conHeadInfo h
    Some _ =>
      let rep = switchDiscRep e branches
      let tagReg = discReg e rep foc
      let exh = switchIsExhaustive e (coveredCtorNames branches)
      emitConChain
        e
        env
        roots
        arms
        foc
        rest
        tagReg
        rep
        branches
        dft
        slot
        endL
        ftL
        rty
        exh
    None => gapSwitchHead e slot endL
-- HUnit is irrefutable (Unit has exactly one inhabitant): no discriminant test
-- needed.  Drop the focus occurrence and descend into the single branch body.
-- This closes gap #12 (the 6 Arbitrary impls in core.mdk and any user f()=…).

-- gap-TOLERANT terminator (bootstrap): a switch head the spike cannot lower
-- records the gap, then — when recording is ON — still TERMINATES the current block
-- (store "0" placeholder, branch to the decision end) so the module stays
-- structurally valid LLVM even though the function is dead code.  With recording
-- OFF the `gapU` panics first, exactly as before.  The harness byte-diff catches
-- any switch the program actually REACHES (its output would diverge).
-- Note: HUnit is now handled before reaching here (irrefutable — no test needed).
gapSwitchHead : Emit -> String -> String -> Unit
gapSwitchHead e slot endL =
  let _ =
    gapU
      e
      "unsupported switch head (constructor / list / tuple / int-literal / unit heads only)"
  let _ = emit e ("  store i64 0, ptr " ++ slot)
  emit e ("  br label %" ++ endL)

-- the name + arity a constructor-LIKE head tests against: a named ADT constructor
-- carries them directly; built-in list HCons/HNil and tuples HTuple reuse the same
-- boxed-cell discipline with the fixed names the alloc sites stamp (emitTuple uses
-- "$tuple"; a user `data … = Cons … | Nil` stamps "Cons"/"Nil").  HLit/HUnit are
-- not constructor-like (HLit goes through emitLitChain; HUnit handled irrefutably
-- before this call — see emitSwitch).
conHeadInfo : CHead -> Option (String, Int)
conHeadInfo (HCon c a) = Some (c, a)
conHeadInfo HCons = Some ("Cons", 2)
conHeadInfo HNil = Some ("Nil", 0)
conHeadInfo (HTuple n) = Some ("$tuple", n)
conHeadInfo _ = None

-- The constructor roster of a BUILT-IN ADT absent from the ctor->type table
-- (`ctorTypeOf`/`ctorsOfType` have nothing for these four either — see
-- `reservedTag`, whose grouping this mirrors), keyed by one of its own
-- constructor names since a covered-constructor set only ever carries names
-- (`conHeadInfo`), never a type.
reservedRosterOf : String -> Option (List String)
reservedRosterOf name =
  if contains name ["Cons", "Nil"] then
    Some ["Cons", "Nil"]
  else if contains name ["Some", "None"] then
    Some ["Some", "None"]
  else if contains name ["Ok", "Err"] then
    Some ["Ok", "Err"]
  else if contains name ["Lt", "Eq", "Gt"] then
    Some ["Lt", "Eq", "Gt"]
  else
    None

-- #2848 (S-dead-tails): true when `covered` (the constructor names a
-- CTSwitch's own branches test) already accounts for every constructor of
-- the type owning them, so that switch's own default arm — a CTFail lowering
-- to the `@mdk_nonexhaustive_match` abort — is provably unreachable.
-- The roster MUST come from `resolveRoster`: a lookup that answers
-- `reservedRosterOf` first would test a user type reusing a reserved spelling
-- (`data Doc = Nil | Cons Int Int | Text Int`) against the LIST roster and read
-- `["Cons","Nil"]` as fully covered.  Trying every covered name also makes the
-- answer order-independent.
-- A wrong answer here is bounded: the default arm this proves unreachable is
-- emitted anyway, as the same defined abort `emitTree` emits (`emitConChain`),
-- so a mis-derived roster costs a reached abort, never a silent wrong value.
switchIsExhaustive : Emit -> List String -> Bool
switchIsExhaustive _ [] = False
switchIsExhaustive e covered = match resolveRoster e covered
  Some roster => isNonEmptyL roster && coveredByRoster covered roster
  None => False

-- The constructor names a CTSwitch's own branches test, in branch order — the
-- covered set `switchIsExhaustive` compares against a type's full roster.
coveredCtorNames : List CTBranch -> List String
coveredCtorNames [] = []
coveredCtorNames ((CTBranch h _) :: rest) = match conHeadInfo h
  Some (c, _) => c :: coveredCtorNames rest
  None => coveredCtorNames rest

-- #2848: how a scrutinee's own constructor roster lets a discriminant test be
-- cheaper than the generic immediate/boxed phi dance (`loadDiscriminant`).
--   RepAllImm     every ctor of the type is nullary ⇒ every value is ONE immediate
--                 word ⇒ the scrutinee word IS the discriminant, compared against
--                 the ctor's whole immediate encoding.  No instruction at all.
--   RepAllBox     every ctor takes fields ⇒ every value is a boxed cell ⇒ the
--                 header `load` is the tag (pointer-guarded: `loadTagGuarded`).
--   RepTwoSplit c exactly two ctors, `c` nullary and the other boxed ⇒ one compare
--                 against `c`'s immediate word decides `c`, and the guarded header
--                 load answers the other — branchless, no blocks, no phi.
--   RepMixed      unproven (≥3 ctors of both shapes, or a roster that cannot be
--                 determined) ⇒ the generic `loadDiscriminant`, unchanged.
-- Every case is derived POSITIVELY from the constructor table; anything not proved
-- lands in RepMixed.  Each case is also TOTAL on an arbitrary word, which is what
-- bounds the cost of getting one wrong: a rep that does not describe the actual
-- scrutinee yields a discriminant matching no constructor of the claimed type, so
-- the switch takes its default (the next clause, or the
-- `@mdk_nonexhaustive_match` abort) instead of a wrong arm or a wild load.  The
-- fast paths are therefore an optimisation only — never a soundness premise.
data DiscRep = RepAllImm | RepAllBox | RepTwoSplit String | RepMixed

-- the declared arity of a RESERVED built-in constructor — the ones `ctorMap` has
-- no entry for (List/Option/Result/Ordering, mirroring `reservedTag`'s roster).
-- `ctorArity` cannot answer for these: it returns 0 for any absent name, which is
-- indistinguishable from a genuinely nullary ctor and would classify `Cons` as an
-- immediate.  So membership is asked FIRST and this table answers second.
reservedCtorArity : String -> Option Int
reservedCtorArity name =
  if name == "Cons" then
    Some 2
  else if contains name ["Some", "Ok", "Err"] then
    Some 1
  else if contains name ["Nil", "None", "Lt", "Eq", "Gt"] then
    Some 0
  else
    None

-- the field count of a constructor when it can be established, `None` when it
-- cannot.  A name BOTH tables claim (a user type declaring one of the exempt
-- reserved spellings) counts as unestablished unless they agree, since the two
-- tables would then describe different values under one tag.
ctorArityOf : Emit -> String -> Option Int
ctorArityOf e name = match reservedCtorArity name
  Some r =>
    if isCtor e name then
      if ctorArity e name == r then Some r else None
    else
      Some r
  None => if isCtor e name then Some (ctorArity e name) else None

-- the representation of ONE constructor: nullary ⇒ immediate word, otherwise a
-- boxed cell.  An unestablished arity is claimed by NEITHER predicate, which
-- lands its type in RepMixed.
ctorIsImmediate : Emit -> String -> Bool
ctorIsImmediate e name = match ctorArityOf e name
  Some a => a == 0
  None => False

ctorIsBoxed : Emit -> String -> Bool
ctorIsBoxed e name = match ctorArityOf e name
  Some a => a > 0
  None => False

-- classify a type from its FULL constructor roster (never a covered subset — a
-- branch list that omits a ctor still has to lower a value of that ctor safely).
ctorRepOfRoster : Emit -> List String -> DiscRep
ctorRepOfRoster e roster =
  let n = listLen roster
  let imms = filterList (ctorIsImmediate e) roster
  let ni = listLen imms
  let nb = listLen (filterList (ctorIsBoxed e) roster)
  if n == 0 || ni + nb < n then
    RepMixed
  else if nb == 0 then
    RepAllImm
  else if ni == 0 then
    RepAllBox
  else if n == 2 then match imms
    [c] => RepTwoSplit c
    _ => RepMixed
  else
    RepMixed

-- true when every name in `names` also appears in `roster`.
coveredByRoster : List String -> List String -> Bool
coveredByRoster roster names =
  not (anyList (c => not (contains c roster)) names)

-- two ctor-name lists denote the same roster (order is not significant).
sameRoster : List String -> List String -> Bool
sameRoster a b = listLen a == listLen b && coveredByRoster b a

-- every constructor in `roster` resolves back to type `ty`.  False means some
-- OTHER type also declares one of these names, and `ctorTypeOf` keeps only the
-- first such type — so this roster is not provably the one a scrutinee has.
rosterOwnedBy : Emit -> String -> List String -> Bool
rosterOwnedBy e ty roster =
  not
    (anyList
      (r => match ctorTypeOf e r
        Some t => t /= ty
        None => True)
      roster)

-- The roster a ctor NAME determines, or `None` when the name does not determine
-- exactly one.  Asking `reservedRosterOf` FIRST is the wrong lookup for either
-- the REPRESENTATION or the EXHAUSTIVENESS question, because the
-- reserved constructor names are exempt from module mangling
-- (private_mangle.mdk), so a user type that declares one of them reaches the
-- emitter under the bare name too — compiler/tools/printer.mdk's `Doc` really
-- does declare a `Nil`, and reading it as the list `Nil` would make every
-- immediate `Doc` (Line/Softline/…) answer a low-bit test for `Nil`.  So: a name
-- the ctor table knows is resolved through the table, and a name BOTH tables
-- claim must have them agree.
unambiguousRoster : Emit -> String -> Option (List String)
unambiguousRoster e name =
  if isCtor e name then match ctorTypeOf e name
    None => None
    Some ty =>
      let t = ctorsOfType e ty
      if isNonEmptyL t && rosterOwnedBy e ty t then match reservedRosterOf name
        None => Some t
        Some r => if sameRoster r t then Some t else None
      else
        None
  else
    reservedRosterOf name

-- The roster of the type a constructor test is testing, taken from the first
-- covered ctor name that determines one.  Trying every covered name (not just
-- the head) is what keeps a `Nil`-first list switch on the fast path: `Nil` is
-- ambiguous, `Cons` is not, and either one identifies the same type.
resolveRoster : Emit -> List String -> Option (List String)
resolveRoster _ [] = None
resolveRoster e (c :: rest) = match unambiguousRoster e c
  Some r => Some r
  None => resolveRoster e rest

-- classify the scrutinee of a constructor test from one head constructor `name`
-- (arity `a`) plus the full set of ctor names the test's own branches cover.
-- The covered set is a SOUNDNESS guard, not an optimisation: the roster is looked
-- up from ONE name, so a branch naming a ctor outside that roster would mean the
-- roster does not describe the scrutinee and no case may be claimed.
discRepOfHead : Emit -> String -> Int -> List String -> DiscRep
discRepOfHead e name a covered = match resolveRoster e covered
  Some roster =>
    if coveredByRoster roster covered then
      ctorRepOfRoster e roster
    else
      RepMixed
  -- No roster: two constructor sets live entirely outside the ctor table, and
  -- both are decided by facts `cellTag`/`emitCtorAlloc` already hardcode.
  -- `$tuple` allocates a cell for every non-empty tuple ⇒ boxed; an EMPTY tuple
  -- would be an immediate, so guard it rather than assume `HUnit` caught it.
  -- `True`/`False` are the hardcoded immediate words 3 and 1.
  None =>
    if name == "$tuple" && a >= 1 && coveredByRoster ["$tuple"] covered then
      RepAllBox
    else if contains name ["True", "False"]
      && coveredByRoster ["True", "False"] covered then
      RepAllImm
    else
      RepMixed

-- classify the scrutinee of a whole CTSwitch from its branch list.
switchDiscRep : Emit -> List CTBranch -> DiscRep
switchDiscRep _ [] = RepMixed
switchDiscRep e (branches@((CTBranch h _) :: _)) = match conHeadInfo h
  Some (c, a) => discRepOfHead e c a (coveredCtorNames branches)
  None => RepMixed

-- RepTwoSplit's discriminant: the full composite tag, materialised WITHOUT a
-- branch.  The nullary constructor `imm` occupies exactly ONE word — its
-- immediate encoding `cellTag * 2 + 1` — so testing for it is one compare against
-- that constant, no shift and no load.  Everything else routes through the
-- guarded header load, which answers the boxed constructor's own `cellTag` for a
-- real cell of this type, some OTHER type's (globally unique) composite tag for a
-- cell of another type, and `discNoneCell`'s non-tag for a word that is neither.
-- So a value that is not of this type matches NEITHER constructor, and the switch
-- falls to its default.
twoSplitDisc : Emit -> String -> String -> String
twoSplitDisc e imm word =
  let isImm = freshReg e
  let immWord = intToString (cellTag e imm * 2 + 1)
  let _ = emit e "  \{isImm} = icmp eq i64 \{word}, \{immWord}"
  let boxed = loadTagGuarded e word
  let d = freshReg e
  let _ =
    emit
      e
      "  \{d} = select i1 \{isImm}, i64 \{intToString (cellTag e imm)}, i64 \{boxed}"
  d

-- emit the discriminant `rep` licenses for scrutinee word `word`, returning the
-- register (or, under RepAllImm, the scrutinee word itself) a test compares
-- against `discExpected`.  EVERY rep is total: a word that is not a value of the
-- rep's own type yields a discriminant no constructor of that type answers to, so
-- the switch falls through to its default rather than taking an arm.  That
-- totality is the whole point — `ctorRepOfRoster`'s proof is derived from the
-- constructor table, and a wrong roster answer must cost a missed optimisation,
-- never a wrong arm or a wild load (`data DiscRep`).
discReg : Emit -> DiscRep -> String -> String
-- every ctor is nullary ⇒ every value of the type is ONE immediate word, so the
-- word IS the discriminant: no instruction at all, and a boxed pointer (low bit
-- 0) can equal no immediate constant (low bit 1).
discReg _ RepAllImm word = word
discReg e RepAllBox word = loadTagGuarded e word
discReg e (RepTwoSplit imm) word = twoSplitDisc e imm word
discReg e RepMixed word = loadDiscriminant e word

-- the constant a `discReg` register is compared against to test for ctor `c` —
-- the composite `cellTag` the alloc site stamps, except under RepAllImm where the
-- register is the untouched scrutinee word and the constant is therefore `c`'s
-- whole immediate encoding (the same `cellTag * 2 + 1` `emitCtorAlloc` emits).
discExpected : Emit -> DiscRep -> String -> String
discExpected e RepAllImm c = intToString (cellTag e c * 2 + 1)
discExpected e _ c = intToString (cellTag e c)

-- the constructor-switch test chain: compare the discriminant register `tagReg`
-- (produced by `discReg` for `rep`) against the constant `discExpected` says
-- identifies each branch's constructor; on a match, descend with the matched
-- cell's fields as the new leading columns; on exhausting the branches, take the
-- default (focus dropped).
-- `exh` (`switchIsExhaustive`) proves the default is unreachable, but the default
-- is still emitted as a DEFINED abort rather than a bare `unreachable`: an
-- unreachable that control does reach is UB (LLVM `ud2` → a silent SIGTRAP, no
-- output), so the proof would have to be infallible to be worth the trade, and it
-- is derived from the constructor table rather than from the value in hand.  This
-- clause therefore matches `emitTree`'s own `ftL == ""` CTFail arm, and is where a
-- wrong roster answer is paid for in a loud abort (#2848).
emitConChain : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  String ->
  List String ->
  String ->
  DiscRep ->
  List CTBranch ->
  CTree ->
  String ->
  String ->
  String ->
  Ref LTy ->
  Bool ->
  Unit
emitConChain e env roots arms _ rest _ _ [] dft slot endL ftL rty exh
  | exh && ftL == "" = match dft
    CTFail site => emitFailTrap e site
    _ => emitTree e env roots arms rest slot endL ftL rty dft
  | otherwise = emitTree e env roots arms rest slot endL ftL rty dft
emitConChain e env roots arms foc rest tagReg rep ((CTBranch h sub) :: more) dft slot endL ftL rty exh =
  match conHeadInfo h
    Some (c, a) =>
      let cmp = freshReg e
      let _ = emit e "  \{cmp} = icmp eq i64 \{tagReg}, \{discExpected e rep c}"
      let n = intToString (freshLocal e)
      let yes = "conyes" ++ n
      let next = "connext" ++ n
      let _ = emit e "  br i1 \{cmp}, label %\{yes}, label %\{next}"
      let _ = emit e (yes ++ ":")
      let fields = loadFields e foc a 0
      let _ = emitTree e env roots arms (fields ++ rest) slot endL ftL rty sub
      let _ = emit e (next ++ ":")
      emitConChain
        e
        env
        roots
        arms
        foc
        rest
        tagReg
        rep
        more
        dft
        slot
        endL
        ftL
        rty
        exh
    None =>
      let _ =
        gapU
          e
          "heterogeneous constructor switch (a column is all-constructor or all-literal)"
      let _ = emit e ("  store i64 0, ptr " ++ slot)
      emit e ("  br label %" ++ endL)

-- the literal-switch test chain: compare the focus immediate against each branch's
-- tagged-int constant; a literal head has arity 0, so a match descends with the
-- focus simply dropped (no field columns).
emitLitChain : Emit ->
  OrdMap (String, LTy) ->
  List String ->
  List CArm ->
  String ->
  List String ->
  List CTBranch ->
  CTree ->
  String ->
  String ->
  String ->
  Ref LTy ->
  Unit
emitLitChain e env roots arms _ rest [] dft slot endL ftL rty =
  emitTree e env roots arms rest slot endL ftL rty dft
emitLitChain e env roots arms foc rest ((CTBranch (HLit (LInt k)) sub) :: more) dft slot endL ftL rty =
  -- Tag the pattern head with the SAME full-width lowering the value-construction
  -- path uses (emitLit): for |k| >= 2^61 the `k*2+1` tag overflows the emitter's own
  -- 63-bit Medaka Int and bakes a WRONG comparison constant (#759, an S0 wrong-arm
  -- miscompile). emitLit shifts at full i64 width via LLVM so the head can't wrap.
  let (kw, _) = emitLit e (LInt k)
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{foc}, \{kw}"
  let n = intToString (freshLocal e)
  let yes = "lityes" ++ n
  let next = "litnext" ++ n
  let _ = emit e "  br i1 \{cmp}, label %\{yes}, label %\{next}"
  let _ = emit e (yes ++ ":")
  let _ = emitTree e env roots arms rest slot endL ftL rty sub
  let _ = emit e (next ++ ":")
  emitLitChain e env roots arms foc rest more dft slot endL ftL rty
-- Char = immediate codepoint word (cp << 1) | 1 — same comparison shape as Int.
emitLitChain e env roots arms foc rest ((CTBranch (HLit (LChar c)) sub) :: more) dft slot endL ftL rty =
  let cp = charCode (arrayGetUnsafe 0 (stringToChars c))
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{foc}, \{intToString (cp * 2 + 1)}"
  let n = intToString (freshLocal e)
  let yes = "lityes" ++ n
  let next = "litnext" ++ n
  let _ = emit e "  br i1 \{cmp}, label %\{yes}, label %\{next}"
  let _ = emit e (yes ++ ":")
  let _ = emitTree e env roots arms rest slot endL ftL rty sub
  let _ = emit e (next ++ ":")
  emitLitChain e env roots arms foc rest more dft slot endL ftL rty
-- String = boxed cell; equality via the @mdk_string_eq runtime helper, which
-- returns a TAGGED Bool word (3 = True), so branch on `icmp eq i64 r, 3`.
-- Materialize the literal operand the same way emitLit (LString _) does.
emitLitChain e env roots arms foc rest ((CTBranch (HLit (LString s)) sub) :: more) dft slot endL ftL rty =
  let (lit, _) = emitLit e (LString s)
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_string_eq(i64 \{foc}, i64 \{lit})"
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp eq i64 \{r}, 3"
  let n = intToString (freshLocal e)
  let yes = "lityes" ++ n
  let next = "litnext" ++ n
  let _ = emit e "  br i1 \{cmp}, label %\{yes}, label %\{next}"
  let _ = emit e (yes ++ ":")
  let _ = emitTree e env roots arms rest slot endL ftL rty sub
  let _ = emit e (next ++ ":")
  emitLitChain e env roots arms foc rest more dft slot endL ftL rty
emitLitChain e _ _ _ _ _ _ _ _ _ _ _ =
  gapU e "non-Int literal switch (no Float / Bool literal heads)"

-- ── small list helpers ────────────────────────────────────────────
takeS : Int -> List a -> List a
takeS n xs
  | n <= 0 = []
  | otherwise = match xs
    [] => []
    y :: ys => y :: takeS (n - 1) ys

tailS : List a -> List a
tailS [] = []
tailS (_ :: xs) = xs

nthArm : List CArm -> Int -> Option CArm
-- Intentional cross-file duplicate of core_ir_eval.mdk's copy. The Core IR
-- interpreter is the oracle this backend is differenced against, so the two must
-- not share code: a defect in a shared helper would move both arms of the
-- differential together and the gate would report agreement.
-- lint-disable-next-line rule-duplicate-body
nthArm (a :: _) 0 = Some a
nthArm (_ :: rest) n = nthArm rest (n - 1)
nthArm [] _ = None

-- a readable tag for the unsupported-pattern panic.
ptag : Pat -> String
ptag (PTuple _) = "PTuple"
ptag (PCons _ _) = "PCons"
ptag (PList _) = "PList"
ptag (PAs _ _ _) = "PAs"
ptag (PRng _ _ _) = "PRng"
ptag (PRec _ _ _) = "PRec"
ptag _ = "?"

-- ── top-level function definitions ────────────────────────────────
-- Each non-`main` top-level binding with parameters becomes an LLVM function
-- `@mdk_<name>(i64 %arg0, …) -> i64`.  Parameters bind to %argN at their
-- INFERRED static type (every param is still an i64 word at the ABI;
-- the type only selects int-vs-float instructions in the body).  The
-- body is emitted in TAIL position so a self-recursive tail call lowers to
-- `musttail call` immediately followed by `ret` (the calling-convention proof:
-- self-recursion guarantees the caller/callee prototypes match, which musttail
-- requires).  Cross-function tail calls lower to an ordinary `call` (still
-- correct; guaranteed-TCO across distinct prototypes is a later increment).
emitFns : Emit -> List CBind -> Unit
emitFns _ [] = ()
emitFns e (b :: rest) =
  let _ = setScopeOfBind e (bindName b)
  -- PROGRAM half (issue #118): a prelude bind's define already lives in prelude.o,
  -- so emit it, keep the side effects, and ship only its `declare`.
  let _ =
    if hiddenBind e (bindName b) then
      emitAsDeclares e (_ => emitFn e b)
    else
      emitFn e b
  emitFns e rest

-- (b′) routing first (mirrors wasm's emitRefFnBind precedence: a multi-member
-- group claims its members ahead of Stage-1 TRMC; the shared detection's v5 keeps
-- Stage-1-claimable SINGLETONS out of groups).  A group MEMBER emits nothing
-- standalone — its body lives as basic blocks inside the root's group define
-- (v3/v4 prove nothing outside the group references it); the ROOT emits the whole
-- group define at its own bind position (deterministic emission order).
emitFn : Emit -> CBind -> Unit
emitFn e (CBind name [CClause pats body] site) =
  match dispGroupOf !e.gDispGroups name
    Some grp => if dispRootOf grp == name then emitGDispGroup e grp
    None => match omLookup name !e.rawWorkers
      Some w => emitRawWorkerFn e name pats (siteFtBody e site body) w
      None => emitFnSingle e name pats (siteFtBody e site body) site

emitFn e (CBind name (c :: rest) site) = match dispGroupOf !e.gDispGroups name
  Some grp => if dispRootOf grp == name then emitGDispGroup e grp
  None =>
    let clauses = clausePairs (c :: rest)
    if trmcTryFn e name clauses False site then
      ()
    else
      emitMultiClauseFn e name clauses site
emitFn e (CBind _ [] _) = gapU e "top-level function with no clauses"

-- a single-clause function with no raw U64 worker.
emitFnSingle : Emit -> String -> List Pat -> CExpr -> Loc -> Unit
emitFnSingle e name pats body site =
  let (pats2, body2) = etaSaturateMethodBody e name pats body
  if trmcTryFn e name [(pats2, body2)] True site then
    ()
  else if allPVar pats2 then
    emitFnClause e name pats2 body2
  else
    emitMultiClauseFn e name [(pats2, body2)] site

-- TRMC branch point (TRMC-DESIGN.md §"Emitter touchpoints" #2): if `name`'s
-- clauses are TRMC-eligible AND its leading-dict count is uniform across clauses
-- (`dictUniformPairs` — a dict-carrying define, i.e. every unannotated
-- polymorphic builder, is admitted; the dict is just another loop slot, and
-- `inferSigs` runs over the LOWERED clauses so `ptys` is already dict-inclusive),
-- emit it as a destination-passing loop and return True; else
-- return False so the caller falls back to the current (stack-growing) codegen.
-- `forceSingle` marks the all-PVar single-clause path so emitTrmcFn descends the
-- CIf-guarded body directly instead of the decision-tree chain.
trmcTryFn : Emit -> String -> List (List Pat, CExpr) -> Bool -> Loc -> Bool
trmcTryFn e name clauses forceSingle site =
  let arity = clauseArity clauses
  let single = forceSingle && allClausesPVar clauses
  if arity > 0
    && dictUniformPairs clauses
    && trmcEligible (isCtor e) (ctorArity e) (SelfByVar name) arity clauses then
    let ptys = match sigLookup e name
      Some (FnSig ts _) => ts
      None => []
    let (spats, sbody) = match clauses
      (ps, b) :: _ => (ps, b)
      [] => ([], CLit LUnit)
    let _ = emitTrmcFn e name arity ptys clauses single spats sbody site
    True
  else
    False

-- every clause's params are all plain PVars (the single-clause TRMC ABI shape).
allClausesPVar : List (List Pat, CExpr) -> Bool
allClausesPVar [] = True
allClausesPVar ((pats, _) :: rest) = allPVar pats && allClausesPVar rest

-- Gap #50 — eta-SATURATE a point-free constrained binding whose body is an
-- UNDER-APPLIED statically selected interface method (CMethod) or constrained fn
-- (CDict) occurrence.  Static RKey selection already knows the chosen impl's callable
-- arity, so the missing value params can be appended to the wrapper and applied to its
-- body.  CDict similarly has one known define arity.
--
-- A dynamic RDict/RDictFwd occurrence is deliberately excluded.  Its selected
-- declaration arity only narrows candidates; each runtime arm can have a smaller
-- callable arity and must dispatch before deciding whether to return a PAP.  Expanding
-- `forge x = forgeOp x` from one source param to the declaration's two params delays a
-- strict-prefix `forgeOp x = y => ...` until `y`, changing observable effects.  Keep the
-- source wrapper arity: `emitMethodValue` dispatches a bare dynamic method immediately,
-- and the CDict caller's saturation path applies surplus args to the returned closure.
--
-- Gap #12 (3rd wrapper shape — CLam/compose) — a point-free `=>`-constrained binding
-- whose body is a CLOSURE VALUE, not a method spine.  `clamp lo hi = min hi >> max lo`
-- dict-passes to a clause `[$dict, lo, hi]` (arity 3) whose body is the `CLam` compose
-- (`>>`/`<<` desugar to CLam) producing `\x -> max lo (min hi x)`.  The closure is
-- well-formed and dispatches correctly, but the define RETURNS it unapplied (arity 3)
-- while the call site `clamp 0 10 7` passes `$dict + 3 value args` (arity 4) — the
-- extra arg is DROPPED, garbage out (SIGSEGV at -O2).  methodBodyDeficit is 0 (the
-- body is a CLam value, not an under-applied CMethod/CDict head), so the method-spine
-- path can't fire.  The SIGNATURE-arity deficit catches it: a constrained binding's
-- define MUST have arity `dictCount + sigValueArity` (what emitDictApp passes at every
-- call site = leading dict words ++ all declared value args); when the clause binds
-- fewer params (the closure body supplies the rest), append the shortfall as fresh
-- eta params and APPLY them to the body.  applyEtaArgs' `CApp body etaVar` over a CLam
-- body lowers via emitIndirect (closure-alloc → load code_ptr → call), i.e. it applies
-- the returned closure — exactly the missing application.  General for any point-free
-- constrained binding under-applied relative to its declared value arity, whatever the
-- wrapper (bare CLam, or a method/closure spine the method-spine path already covers —
-- both deficits agree there, so the method-spine path is kept as the primary signal).
etaSaturateMethodBody : Emit -> String -> List Pat -> CExpr -> (List Pat, CExpr)
etaSaturateMethodBody e name pats body =
  let mDeficit = methodBodyDeficit e body
  let deficit = etaDeficit e name pats body mDeficit
  if deficit <= 0 then
    (pats, body)
  else
    let fresh = etaFreshPats deficit (listLen pats)
    (pats ++ fresh, applyEtaArgsTail body fresh)
-- method-spine deficit is the primary signal (#50/#11).  When it is 0 the body may
-- still be a CLOSURE VALUE (CLam from compose `>>`/`<<`) that the define returns
-- unapplied while the call site passes more value args (clamp/#12) — recover that
-- shortfall from the SIGNATURE arity, but ONLY when the tail is a CLam (a bare value
-- return is legitimate point-free currying; eta-applying it would corrupt the body).

-- the eta deficit: the method-spine count when positive, else the signature-arity
-- shortfall when the body tail is a CLam closure value (#12), else 0.
etaDeficit : Emit -> String -> List Pat -> CExpr -> Int -> Int
etaDeficit e name pats body mDeficit
  | mDeficit > 0 = mDeficit
  | tailIsLam body = sigArityDeficit e name pats
  | otherwise = 0

-- does the body's TAIL (through where/let wrappers) reduce to a CLam closure value?
-- Mirrors applyEtaArgsTail's CLet/CLetGroup transparency so a compose under a
-- `where` is still recognised.
tailIsLam : CExpr -> Bool
tailIsLam (CLet _ _ _ b) = tailIsLam b
tailIsLam (CLetGroup _ b) = tailIsLam b
tailIsLam (CLam _ _) = True
tailIsLam _ = False

-- the shortfall between a constrained binding's REQUIRED define arity
-- (`dictCount + sigValueArity` = what every call site passes through emitDictApp)
-- and the clause's actual param count.  0 (or negative) when the clause already
-- binds every dict + value param (the ordinary case) or when no signature is known
-- (fnArity 0 ⇒ no eta-expansion — leave it to the method-spine path).  dictCount is
-- the number of leading `$dict_…` params dict_pass prepended; the remaining pats are
-- the source value params, and a point-free closure body (e.g. compose) makes that
-- count fall short of the declared sigValueArity.
sigArityDeficit : Emit -> String -> List Pat -> Int
sigArityDeficit e name pats =
  let sigArity = fnArity e name
  if sigArity <= 0 then
    0
  else
    maxInt 0 (leadingDictPats pats + sigArity - listLen pats)

-- count of leading `$dict_…` parameter patterns (the dict witnesses dict_pass
-- prepends ahead of the source value params).
leadingDictPats : List Pat -> Int
leadingDictPats ((PVar x _) :: rest) =
  if isDictParamName x then 1 + leadingDictPats rest else 0
leadingDictPats _ = 0

-- (`isDictParamName` — a dict-witness parameter name, `$dict_<method>_<slot>` — now
-- lives in backend/emit_support.mdk: BOTH backends need it, for the same reason.)

-- the count of still-unapplied VALUE params of an under-applied method/dict body
-- (0 = saturated / not a method-or-dict head ⇒ no eta-expansion).  A bare CMethod
-- needs its full `methodArityOf`; an applied spine `(CApp.. (CMethod..) a1..ak)`
-- needs `methodArityOf - k`.  A CDict (a `=>`-constrained-function occurrence) head is
-- handled the SAME way (#21 point-free CAF), but its arity needs care: `fnArity name`
-- counts the LEADING DICT params dict_pass prepended as well as the value params, so a
-- CDict's remaining VALUE arity is `fnArity name - <dict count> - <value args applied>`.
-- The dict count is exactly `listLen routes` (the witnesses this occurrence supplies —
-- emitDictApp passes one word per route ahead of the value args).  So a bare
-- `seqp = trav` needs `fnArity trav - routes` eta params and an applied spine
-- `seqp = trav identity` needs `fnArity trav - routes - k` (here 3 - 1 - 1 = 1).  This
-- is the load-bearing case the old "leave CDict alone" rule MISSED: when seqp's define
-- is under-applied (clause `[$dict]`, body `trav identity`) the emitter lowered the body
-- as a DIRECT under-saturated call to trav (emitDictApp forwards only the supplied args)
-- AND gave seqp's define arity 1 (dict only) while the saturated call site `seqp xs`
-- passes dict + xs → the value arg was dropped and trav ran on garbage → SIGSEGV.
-- Appending the deficit as fresh eta params makes BOTH the define arity and the inner
-- trav application saturate, byte-identically to the eta-expanded source form.  (The old
-- comment's "partially-applied CDict passes its supplied args through emitDictApp" is true
-- but does not produce the missing-args closure a point-free define returns — that is the
-- bug.)  A SATURATED clause (`seqp xs = trav identity xs`, deficit 3 - 1 - 2 = 0) is left
-- untouched.
-- A `where`/`let` wrapper (CLet/CLetGroup) is TRANSPARENT to the deficit — the
-- under-applied method may be the let-body TAIL (`maximum = fold step None`
-- desugars its `step` `where`-helper to a CLetGroup around the `fold` spine).  The
-- companion applyEtaArgsTail threads the fresh args into that same tail.
methodBodyDeficit : Emit -> CExpr -> Int
methodBodyDeficit e (CLet _ _ _ b) = methodBodyDeficit e b
methodBodyDeficit e (CLetGroup _ b) = methodBodyDeficit e b
methodBodyDeficit e (CMethod name iface arity route _ _) =
  if isDynamicMethodRoute route then
    0
  else
    methodOccurrenceCallableArity e name iface arity route
methodBodyDeficit e (CDict name routes) =
  maxInt 0 (fnArity e name - listLen routes)
methodBodyDeficit e app =
  let (hd, args) = flattenApp app []
  match hd
    CMethod name iface arity route _ _ =>
      if isDynamicMethodRoute route then
        0
      else
        maxInt
          0
          (methodOccurrenceCallableArity e name iface arity route
            - listLen args)
    CDict name routes =>
      maxInt 0 (fnArity e name - listLen routes - listLen args)
    _ => 0

methodOccurrenceCallableArity : Emit -> String -> String -> Int -> Route -> Int
methodOccurrenceCallableArity e name iface arity (RKey tag _ _) =
  match implForSite e name iface tag arity
    Some entry => methodArityOfEntry e entry name
    None => arity
methodOccurrenceCallableArity _ _ _ arity _ = arity

-- `n` fresh value-param PVars (`__eta_<i>`) numbered after the existing `start`
-- params so paramEnv/paramDecls index them positionally without clashing.
etaFreshPats : Int -> Int -> List Pat
etaFreshPats 0 _ = []
etaFreshPats n start =
  PVar ("__eta_" ++ intToString start) (Loc "" 0 0 0 0)
    :: etaFreshPats (n - 1) (start + 1)

-- apply the fresh eta params at the body's TAIL position, threading THROUGH any
-- enclosing `where`/`let` wrappers so the let bindings (e.g. `maximum`'s `step`
-- helper) stay in scope for the now-saturated tail application.  Mirrors
-- methodBodyDeficit's CLet/CLetGroup transparency.
applyEtaArgsTail : CExpr -> List Pat -> CExpr
applyEtaArgsTail (CLet r p rhs b) fresh =
  CLet r p rhs (applyEtaArgsTail b fresh)
applyEtaArgsTail (CLetGroup bs b) fresh =
  CLetGroup bs (applyEtaArgsTail b fresh)
applyEtaArgsTail body fresh = applyEtaArgs body fresh

-- apply `body` to each fresh eta param as a CVar (AGlobal — emit resolves a CVar by
-- NAME against the param env, ignoring the Addr), left to right.
applyEtaArgs : CExpr -> List Pat -> CExpr
applyEtaArgs body [] = body
applyEtaArgs body ((PVar x _) :: rest) =
  applyEtaArgs (CApp body (CVar x AGlobal)) rest
applyEtaArgs body (_ :: rest) = applyEtaArgs body rest

-- E1a — multi-clause / patterned top-level fns.  Route ordinary fn-binds whose
-- clauses don't all reduce to plain-variable params through the SAME
-- clause-coalescing + decision-tree lowering the impl methods use
-- (`emitClauseTree`).  This closes EMITTER-GAPS #1 (multi-clause top-level fn)
-- and the fn half of #4 (non-variable parameter pattern), since the decision
-- tree binds patterned params via `bindPattern` in each leaf.  The synthetic
-- `aK` scrutinee params are typed from the fn's inferred signature (sigTable /
-- FnSig) so body arithmetic/printing selects the right instruction; absent a
-- sig, params default to Int (the impl-path behaviour).
emitMultiClauseFn : Emit -> String -> List (List Pat, CExpr) -> Loc -> Unit
emitMultiClauseFn e name clauses site =
  let arity = clauseArity clauses
  let ptys = match sigLookup e name
    Some (FnSig ts _) => ts
    None => []
  let env = implParamEnvTyped arity ptys 0
  let _ = beginDefine e
  let _ = emit e "define i64 @mdk_\{name}(\{implParamDecls arity 0}) {"
  let _ = emit e "entry:"
  let _ = emitTailClauseTree e env ("mdk_" ++ name) arity clauses site
  let _ = emit e "}"
  emit e ""

-- the (List Pat, CExpr) clause pairs of a fn-bind, in source order.
clausePairs : List CClause -> List (List Pat, CExpr)
clausePairs [] = []
clausePairs ((CClause pats body) :: rest) = (pats, body) :: clausePairs rest

-- ── TRMC emit (destination-passing loop) ────────────────────────────────────
-- emit a TRMC-eligible function as an O(1)-stack destination-passing loop.
-- entry sets up the result hole + the mutable destination slot + the mutable
-- param slots, then jumps to the loop head; the loop reloads the params, runs the
-- ORDINARY param dispatch (single-clause: CIf-tail descent; multi-clause: the
-- decision-tree clause chain) whose LEAVES are redirected via `e.trmcCtx`:
--   • cons leaf:  alloc Cons cell, store head, link cell into `*dest`, advance
--                 `dest` to the cell's tail slot (+16), recompute the recursion
--                 args into the param slots, br loop.
--   • base leaf:  store the value into `*dest`, br exit.
-- exit loads the hole (the final list head) and rets it.  destSlot holds the
-- ADDRESS of the next i64 to fill; the hole's address is the first destination, a
-- linked cell's tail slot (cell+16) each subsequent one.
-- census marker (TMC-parity gate): one deterministic `; tmc: <fn> <mode>`
-- comment per TMC decision — the LLVM peer of wasm's wTmcMarker.
-- test/tmc_census.sh + diff_compiler_tmc_parity.sh extract these to diff both
-- backends' TMC'd source-function sets.  Census-normalized name (leading `mdk_`
-- stripped).
tmcMarker : Emit -> String -> String -> Unit
tmcMarker e sym mode =
  let name =
    if startsWith "mdk_" sym then stringSlice 4 (stringLength sym) sym else sym
  emit e "; tmc: \{name} \{mode}"

tmcGroupMarkers : Emit -> String -> List String -> Unit
tmcGroupMarkers _ _ [] = ()
tmcGroupMarkers e root (m :: rest) =
  let _ =
    if m == root then
      tmcMarker e m "group-root"
    else
      tmcMarker e m ("group:" ++ root)
  tmcGroupMarkers e root rest

emitTrmcFn : Emit ->
  String ->
  Int ->
  List LTy ->
  List (List Pat, CExpr) ->
  Bool ->
  List Pat ->
  CExpr ->
  Loc ->
  Unit
emitTrmcFn e name arity ptys clauses single singlePats singleBody site =
  let _ = tmcMarker e name "trmc"
  let _ = emitTrmcHeader e ("mdk_" ++ name) arity
  let _ =
    emitTrmcLoopBody
      e
      (SelfByVar name)
      arity
      ptys
      clauses
      single
      singlePats
      singleBody
      site
  let _ = emit e "}"
  emit e ""

-- emit the `define` header + entry label for a TRMC define.  `defineName` is the
-- bare symbol (`mdk_<name>` for a top-level fn, `mdk_impl_<tag>_<method>` for a
-- dispatched impl method).  The caller emits the closing `}` (the impl path's
-- emitGroup already brackets the define).
emitTrmcHeader : Emit -> String -> Int -> Unit
emitTrmcHeader e defineName arity =
  let _ = beginDefine e
  let _ = emit e "define i64 @\{defineName}(\{implParamDecls arity 0}) {"
  emit e "entry:"

-- the REUSABLE TRMC loop body (assumes `define`+`entry:` already emitted; does NOT
-- emit the closing `}`).  Sets up the result hole + mutable destination slot +
-- mutable param slots, jumps to the loop head, reloads the params, runs the
-- ordinary param dispatch (single-clause: CIf-tail descent; multi-clause: the
-- decision-tree clause chain) with the LEAVES redirected via `e.trmcCtx` (TrmcOn
-- carries the SelfRef so the cons/ctor leaf recognises the self-call — a CVar for
-- a top-level fn, a CMethod for a dispatched impl method), then emits the exit
-- block (load hole, ret).  `self` is the SelfRef the loop recurses on; `slotTys`
-- types each reloaded `aK` scrutinee word (top-level: inferred sig types, padded
-- with LTInt; impl: receiver type at the impl positions, LTInt elsewhere).
emitTrmcLoopBody : Emit ->
  SelfRef ->
  Int ->
  List LTy ->
  List (List Pat, CExpr) ->
  Bool ->
  List Pat ->
  CExpr ->
  Loc ->
  Unit
emitTrmcLoopBody e self arity slotTys clauses single singlePats singleBody site =
  let hole = freshReg e
  let _ = emit e ("  " ++ hole ++ " = alloca i64")
  let destSlot = freshReg e
  let _ = emit e ("  " ++ destSlot ++ " = alloca ptr")
  let _ = emit e "  store ptr \{hole}, ptr \{destSlot}"
  let pslots = trmcEmitParamSlots e arity 0
  let loopL = "trmcloop" ++ intToString (freshLocal e)
  let exitL = "trmcexit" ++ intToString (freshLocal e)
  let _ = emit e ("  br label %" ++ loopL)
  let _ = emit e (loopL ++ ":")
  let reloaded = trmcReloadParams e pslots slotTys 0
  let saved = !e.trmcCtx
  e.trmcCtx := TrmcOn self arity destSlot loopL exitL pslots
  let _ =
    trmcEmitDispatch
      e
      reloaded
      arity
      clauses
      single
      singlePats
      reloaded
      singleBody
      site
  e.trmcCtx := saved
  let _ = emit e (exitL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{hole}"
  emit e ("  ret i64 " ++ r)
-- mutable param slots, seeded from the incoming %argK words.

-- reload the params into fresh regs for THIS iteration (each loop re-executes
-- the loads, so a back-edge to %loop re-reads the mutated slots — valid SSA).

-- one mutable `alloca i64` param slot per arg, seeded from %argK; returns the slot
-- registers in order.
trmcEmitParamSlots : Emit -> Int -> Int -> List String
trmcEmitParamSlots e arity i
  | i >= arity = []
  | otherwise =
    let slot = freshReg e
    let _ = emit e ("  " ++ slot ++ " = alloca i64")
    let _ = emit e "  store i64 %arg\{intToString i}, ptr \{slot}"
    slot :: trmcEmitParamSlots e arity (i + 1)

-- reload each param slot into a fresh reg at the loop head, binding the synthetic
-- `aK` scrutinee name (the name emitClauseTree's scrutinee tuple uses) to the
-- loaded word at the fn's inferred param type.  #1031: returns a plain POSITIONAL
-- list (index 0..arity-1, in order) — NOT the main OrdMap env — because
-- `trmcRenameEnv` below matches it against `singlePats` by POSITION, and an
-- OrdMap's key order ("a10" < "a2" lexicographically) does not preserve that.
-- `trmcEmitDispatch`'s non-single arm folds it into a real OrdMap via
-- `omFromPairs` at the point it is used as `emitClauseTree`'s (by-name) env.
trmcReloadParams : Emit ->
  List String ->
  List LTy ->
  Int ->
  List (String, (String, LTy))
trmcReloadParams _ [] _ _ = []
trmcReloadParams e (slot :: rest) tys i =
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  let ty = match tys
    t :: _ => t
    [] => LTInt
  ("a" ++ intToString i, (r, ty))
    :: trmcReloadParams e rest (trmcTail tys) (i + 1)

trmcTail : List a -> List a
trmcTail [] = []
trmcTail (_ :: xs) = xs

-- run the in-loop param dispatch.  Single-clause (all-PVar params): rename the
-- reloaded `aK` env to the clause's PVar names and descend the body in tail
-- position (emitTrmcBody).  Multi-clause: reuse emitClauseTree's decision-tree
-- chain verbatim — its emitLeaf is TRMC-aware via `e.trmcCtx`.
trmcEmitDispatch : Emit ->
  List (String, (String, LTy)) ->
  Int ->
  List (List Pat, CExpr) ->
  Bool ->
  List Pat ->
  List (String, (String, LTy)) ->
  CExpr ->
  Loc ->
  Unit
trmcEmitDispatch e reloaded arity clauses single singlePats aenv singleBody site =
  if single then
    let env = trmcRenameEnv singlePats aenv
    emitTrmcBody e env singleBody
  else
    emitClauseTree e (omFromPairs reloaded omEmpty) arity clauses "" site

-- bind the clause's PVar param names to the reloaded `aK` operand words (single
-- clause, all-PVar params — the slice-2 ABI requirement also holds for TRMC).
-- `aenv` is the plain POSITIONAL list from `trmcReloadParams`; this is the
-- boundary where it becomes a real by-name OrdMap env.
trmcRenameEnv : List Pat -> List (String, (String, LTy)) -> OrdMap (String, LTy)
trmcRenameEnv [] _ = omEmpty
trmcRenameEnv ((PVar x _) :: ps) ((_, op) :: rest) =
  omInsert x op (trmcRenameEnv ps rest)
trmcRenameEnv (_ :: ps) (_ :: rest) = trmcRenameEnv ps rest
trmcRenameEnv _ [] = omEmpty

-- single-clause TRMC body in TAIL position: descend CIf/CLet/CLetGroup wrappers,
-- emit each leaf via the TRMC context (cons leaf or base leaf).  Mirrors
-- emitFnBody's CIf descent but redirects the value leaves.  CLet/CLetGroup descend
-- only their (self-free, verified by trmcBodyOk) simple value-binding shapes; any
-- richer let is emitted whole as a base leaf (no self-call inside ⇒ no stack risk).
emitTrmcBody : Emit -> OrdMap (String, LTy) -> CExpr -> Unit
emitTrmcBody e env (CIf c t f) =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "trmcthen" ++ n
  let elseL = "trmcelse" ++ n
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let _ = emitTrmcBody e env t
  let _ = emit e (elseL ++ ":")
  emitTrmcBody e env f
emitTrmcBody e env (CLet False (PVar x _) rhs b) =
  let (v, ty) = emitExpr e env rhs
  emitTrmcBody e (omInsert x (v, ty) env) b
emitTrmcBody e env (CLetGroup binds b) =
  if allNullaryBinds binds then
    let env2 = trmcBindNullaryGroup e env binds
    emitTrmcBody e env2 b
  else
    emitTrmcLeaf e env (CLetGroup binds b)
-- B-match-descent (TRMC-DESIGN §"Phase 2 sub-part 3"): a TAIL-position decision
-- tree.  Emit the scrutinee, then walk the SAME decision-tree machinery as
-- emitDecision (emitTree) but keep `e.trmcCtx` LIVE — so each arm body is descended
-- as a TRMC tail leaf (cons-into-dest+loop / plain-tail-call+loop / base+exit) via
-- emitLeaf's TrmcOn branch, NOT computed into a value slot.  This is the inverse of
-- emitDecision's save+clear, which stays for an EXPRESSION-position match inside an
-- arm (a value-producing match whose arms must store into its own slot).  The
-- result slot + end label passed to emitTree are a DEAD block (no leaf stores into
-- them under TrmcOn — every leaf branches to loopL/exitL); LLVM tolerates the
-- unreachable load/branch (Phase-1 precedent: the nested decision result slot is a
-- dead block).  emitTree is passed "" as its fallthrough label (a non-exhaustive tail
-- match's CTFail is a genuine abort, not the enclosing clause chain's fallthrough).
emitTrmcBody e env (CDecision scrut arms tree) =
  let (sv, _) = emitExpr e env scrut
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "trmcdecend" ++ intToString (freshLocal e)
  let rty = Ref LTInt
  let _ = emitTree e env [sv] arms [sv] slot endL "" rty tree
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  emit e "  unreachable"
-- `e.trmcCtx` is INTENTIONALLY left LIVE across the tree (the tail arms cons/loop
-- into the active destination); a nested EXPRESSION-position match within an arm
-- body re-enters emitDecision, which saves+clears it for its own value arms.

-- the dead end block: no TrmcOn leaf branches here, but emit it well-formed so a
-- (non-treeable / fallthrough) path that did would still verify.

emitTrmcBody e env ex = emitTrmcLeaf e env ex

-- every binding is a nullary value binding (the descendable let-group shape).
allNullaryBinds : List CBind -> Bool
allNullaryBinds [] = True
allNullaryBinds ((CBind _ [CClause [] _] _) :: rest) = allNullaryBinds rest
allNullaryBinds _ = False

-- emit each nullary value binding left-to-right, threading the env (mirrors
-- emitLetGroup's value-binding arm).
trmcBindNullaryGroup : Emit ->
  OrdMap (String, LTy) ->
  List CBind ->
  OrdMap (String, LTy)
trmcBindNullaryGroup _ env [] = env
trmcBindNullaryGroup e env ((CBind name [CClause [] rhs] _) :: rest) =
  let (v, ty) = emitExpr e env rhs
  trmcBindNullaryGroup e (omInsert name (v, ty) env) rest
trmcBindNullaryGroup _ env (_ :: rest) = env

-- a TRMC tail leaf: an eligible ctor-tail conses into the destination + loops; a
-- bare plain-tail self-call (F3 — `None => self …`, no enclosing cons/ctor)
-- recomputes its args + loops with NO cell alloc + NO dest store (iterate on a
-- shorter list); any other leaf stores its value into the destination + exits.
emitTrmcLeaf : Emit -> OrdMap (String, LTy) -> CExpr -> Unit
emitTrmcLeaf e env ex = match !e.trmcCtx
  TrmcOff => emitValueRet e env ex
  TrmcOn self arity destSlot loopL exitL pslots =>
    if isCtorTail (isCtor e) (ctorArity e) self arity ex then
      emitTrmcCtor
        e
        env
        (ctorTailName ex)
        (ctorTailLeadFields ex)
        (consTailArgs ex)
        (ctorTailSelfIdx ex)
        destSlot
        loopL
        pslots
    else if isSelfSatApp self arity ex then
      emitTrmcTailCall e env ex loopL pslots
    else
      emitTrmcBase e env ex destSlot exitL

-- F3 plain-tail self-call leaf (TRMC-DESIGN §"Phase 2 sub-part 3"): a bare
-- saturated self-call in tail position (`None => filterMap f xs`).  It is the
-- cons-leaf MINUS the cell alloc + head store + dest link/advance — an
-- iterate-on-a-shorter-list step: recompute the recursion args into TEMPS (an arg
-- may read an earlier param), store them into the loop's param slots, and branch
-- back to the loop head.  The destination is left UNCHANGED (this arm produces no
-- list cell), so the next iteration fills the same destination slot — exactly the
-- "drop this element" semantics of `filter`/`filterMap`.  The self-call is NOT
-- emitted as a `call` (that is what removes the stack-growing recursion).
emitTrmcTailCall : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  String ->
  List String ->
  Unit
emitTrmcTailCall e env ex loopL pslots =
  let args = match flattenApp ex []
    (_, as_) => as_
  let argOps = emitArgs e env args
  -- a dict-carrying (CDict-headed) self-call's args cover only the VALUE params;
  -- its leading dict slots are loop-invariant (identity-forwarded routes,
  -- trmc_analysis dictRoutesForwarded) — store into the LAST |args| slots only.
  let _ =
    trmcStoreParamSlots
      e
      (dropFirstN (lengthS pslots - lengthS argOps) pslots)
      argOps
  emit e ("  br label %" ++ loopL)

-- ctor leaf (Phase 2 Axis A): alloc a single-constructor cell (header + the
-- non-last fields), link it into the current destination at the SELF-CALL field
-- slot (offset `8*(selfIdx+1)`), advance the destination to that slot, recompute
-- the recursion args into the param slots, and branch back to the loop head.  The
-- self-call is NOT emitted — only the leading fields + arg recomputations are,
-- which is what removes the stack-growing `call`.  Store order (GC-safe,
-- TRMC-DESIGN §"Risk"): alloc → header → leading fields → link-into-dest → advance;
-- the cell's own self-call slot stays ZEROED (GC_malloc returns zeroed memory; an
-- even/null word is never dereferenced by Boehm) until the next iteration fills it.
-- For `::`/Cons this is arity 2, selfIdx 1 (offset 16) — the Phase-1 cons shape.
-- F1(b) SEAM: the dest-offset is COMPUTED from `selfIdx`, not hardcoded "last", so a
-- future self-call-in-any-field is a detection-only patch (this emit is unchanged).
emitTrmcCtor : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  List CExpr ->
  Int ->
  String ->
  String ->
  List String ->
  Unit
emitTrmcCtor e env ctor leadFields args selfIdx destSlot loopL pslots =
  let arity = lengthS leadFields + 1
  let leadVals = emitArgs e env leadFields
  let cell = freshReg e
  let _ =
    emit
      e
      "  \{cell} = call ptr @mdk_alloc(i64 \{intToString (8 * (arity + 1))})"
  let _ = emit e "  store i64 \{intToString (cellTag e ctor)}, ptr \{cell}"
  let _ = storeFields e cell leadVals 0
  let cellw = freshReg e
  let _ = emit e "  \{cellw} = ptrtoint ptr \{cell} to i64"
  let d = freshReg e
  let _ = emit e "  \{d} = load ptr, ptr \{destSlot}"
  let _ = emit e "  store i64 \{cellw}, ptr \{d}"
  let newdest = freshReg e
  let _ =
    emit
      e
      "  \{newdest} = getelementptr i8, ptr \{cell}, i64 \{intToString (8 * (selfIdx + 1))}"
  let _ = emit e "  store ptr \{newdest}, ptr \{destSlot}"
  let argOps = emitArgs e env args
  -- dict-carrying self-call: skip the loop-invariant leading dict slots (see
  -- emitTrmcTailCall); non-dict is |argOps| == |pslots| ⇒ drop 0.
  let _ =
    trmcStoreParamSlots
      e
      (dropFirstN (lengthS pslots - lengthS argOps) pslots)
      argOps
  emit e ("  br label %" ++ loopL)
-- emit the leading (non-last) field values FIRST (left-to-right), then alloc.

-- store the leading fields at their positional offsets (field 0 at +8, …).  The
-- self-call slot (offset 8*(selfIdx+1)) is left zeroed for the link below.

-- advance the destination to THIS cell's self-call field slot (offset
-- 8*(selfIdx+1)) — COMPUTED from the field index (F1(b) seam).

-- recompute every recursion arg into a TEMP first (an arg may read an earlier
-- param), THEN store all temps into the slots, so an in-place store can't clobber
-- a not-yet-read param within the same iteration.

-- store the recomputed arg operands back into the loop's mutable param slots.
trmcStoreParamSlots : Emit -> List String -> List String -> Unit
trmcStoreParamSlots _ [] _ = ()
trmcStoreParamSlots _ _ [] = ()
trmcStoreParamSlots e (slot :: slots) (op :: ops) =
  let _ = emit e "  store i64 \{op}, ptr \{slot}"
  trmcStoreParamSlots e slots ops

-- base/other leaf: store the value into the current destination, branch to exit.
emitTrmcBase : Emit -> OrdMap (String, LTy) -> CExpr -> String -> String -> Unit
emitTrmcBase e env ex destSlot exitL =
  let (v, _) = emitExpr e env ex
  let d = freshReg e
  let _ = emit e "  \{d} = load ptr, ptr \{destSlot}"
  let _ = emit e "  store i64 \{v}, ptr \{d}"
  emit e ("  br label %" ++ exitL)

-- ════════════════════════════════════════════════════════════════════════════
-- Dispatch-graph (b′) TMC — the LLVM group emit (TMC-parity arc, TRMC-DESIGN
-- §Phase 3).  The shared detection (backend/trmc_analysis.mdk) finds a family of
-- mutually tail-calling fns rooted at ONE external entry (the lexer's `scan`
-- token spine, the offside-rule `layout` family), whose spine conses bottom in
-- saturated member calls.  The WasmGC emit keeps members as separate funcs and
-- loops via `return_call` + per-group dest GLOBALS; LLVM has no `return_call`
-- and `musttail` demands caller/callee prototype equality — but the detection's
-- v4 check PROVES no bind or impl outside the group references a non-root
-- member, so the whole group INLINES into the root's single define:
--   • one labeled entry block per member (`gdisp_<member>:`), its body emitted
--     by the ORDINARY clause machinery (direct tail descent / emitClauseTree)
--     under a live `e.gDispCtx`, leaves redirected;
--   • every sanctioned tail edge = recompute the callee's args into fresh regs,
--     store them into the shared param slots, `br %gdisp_<callee>` — a plain
--     branch, no call, no musttail (the "heterogeneous member arities" obstacle
--     that deferred the 2026-06-22 port is moot: there is no cross-define edge);
--   • the destination is a LOCAL `alloca` seeded to &hole — the Stage-1 protocol
--     verbatim (no module globals, no first-cell flag; a nested outer call to
--     the root gets a fresh frame, so re-entrancy is safe by construction);
--   • a spine-cons leaf links its 1..N Cons cells into *dest in source order
--     and advances dest through each tail slot before branching to the bottom
--     callee; a base leaf stores its value into *dest and exits (emitTrmcBase).
-- Members emit NO standalone define; the root's public `@mdk_<root>` IS the
-- group define, so external callers and fn-as-value eta closures over the root
-- are untouched.

-- the member's basic-block label inside the group define (member names are
-- unique within a group; LLVM labels are function-scoped, so two groups may
-- reuse the scheme).
gDispLabel : String -> String
gDispLabel m = "gdisp_" ++ m

-- emit the whole group define, rooted at `@mdk_<root>` with the root's real
-- params.  U = max member arity shared slots; slots 0..rootArity seed from
-- %argK, the rest from 0 (never read before a store — zeroed only so no undef
-- load exists).
emitGDispGroup : Emit -> DispGroup -> Unit
emitGDispGroup e grp =
  let root = dispRootOf grp
  let members = dispMembersOf grp
  let binds = !e.gDispBinds
  let rootArity = gDispFnArity e root
  let u = gDispMaxArity e members 0
  let _ = tmcGroupMarkers e root members
  let _ = emitTrmcHeader e ("mdk_" ++ root) rootArity
  let uslots = gDispEmitSlots e u rootArity 0
  let hole = freshReg e
  let _ = emit e ("  " ++ hole ++ " = alloca i64")
  let destSlot = freshReg e
  let _ = emit e ("  " ++ destSlot ++ " = alloca ptr")
  let _ = emit e "  store ptr \{hole}, ptr \{destSlot}"
  let exitL = "gdispexit" ++ intToString (freshLocal e)
  let _ = emit e ("  br label %" ++ gDispLabel root)
  let saved = !e.gDispCtx
  e.gDispCtx := GDispOn root members uslots destSlot exitL
  let _ = emitGDispMembers e binds members
  e.gDispCtx := saved
  let _ = emit e (exitL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{hole}"
  let _ = emit e ("  ret i64 " ++ r)
  let _ = emit e "}"
  emit e ""

-- one shared `alloca i64` slot per uniform param position, seeded from the
-- root's %argK (< rootArity) or 0.
gDispEmitSlots : Emit -> Int -> Int -> Int -> List String
gDispEmitSlots e u rootArity i
  | i >= u = []
  | otherwise =
    let slot = freshReg e
    let _ = emit e ("  " ++ slot ++ " = alloca i64")
    let seed = if i < rootArity then "%arg" ++ intToString i else "0"
    let _ = emit e "  store i64 \{seed}, ptr \{slot}"
    slot :: gDispEmitSlots e u rootArity (i + 1)

gDispMaxArity : Emit -> List String -> Int -> Int
gDispMaxArity _ [] acc = acc
gDispMaxArity e (m :: rest) acc =
  let a = gDispFnArity e m
  gDispMaxArity e rest (maxInt a acc)

emitGDispMembers : Emit -> List CBind -> List String -> Unit
emitGDispMembers _ _ [] = ()
emitGDispMembers e binds (m :: rest) =
  let _ = match omLookup m !e.gDispBindMap
    Some b => emitGDispMember e b
    None => gapU e ("(b') group member without a bind: " ++ m)
  emitGDispMembers e binds rest

-- a member's entry block: reload its arity-many slots (typed from its inferred
-- sig, LTInt-padded — the same trmcReloadParams the Stage-1 loop head uses,
-- binding the synthetic `aK` scrutinee names), then run the ordinary dispatch:
-- a single all-PVar clause descends its body directly (emitGDispBody); anything
-- else reuses emitClauseTree verbatim (its emitLeaf/emitGuardedArm are
-- gDispCtx-aware).  Each member's clause chain is emitted with "" as its outer
-- fallthrough (each member manages its own fallthroughs).
emitGDispMember : Emit -> CBind -> Unit
emitGDispMember e (CBind name clauses site) = match !e.gDispCtx
  GDispOff => gapU e "(b') member emit with no active group context"
  GDispOn _ _ uslots _ _ =>
    let arity = clauseArityOf clauses
    let ptys = match sigLookup e name
      Some (FnSig ts _) => ts
      None => []
    let _ = emit e (gDispLabel name ++ ":")
    let reloaded = trmcReloadParams e (gDispTake arity uslots) ptys 0
    let pairs = clausePairs clauses
    match pairs
      [(pats, body)] =>
        if allPVar pats then
          emitGDispBody e (trmcRenameEnv pats reloaded) (siteFtBody e site body)
        else
          emitClauseTree e (omFromPairs reloaded omEmpty) arity pairs "" site
      _ => emitClauseTree e (omFromPairs reloaded omEmpty) arity pairs "" site

gDispTake : Int -> List a -> List a
gDispTake n _
  | n <= 0 = []
gDispTake _ [] = []
gDispTake n (x :: rest) = x :: gDispTake (n - 1) rest

-- member-body TAIL descent.  Mirrors the shared detection's wrapper set EXACTLY
-- (dispLeavesOk: CIf / non-rec CLet PVar+PWild / CBlock / CDecision), so the
-- emit redirects precisely the leaves the detection sanctioned.  A CLetGroup is
-- deliberately NOT descended (the detection treats it as a leaf: base if
-- member-free, else the group was rejected).
emitGDispBody : Emit -> OrdMap (String, LTy) -> CExpr -> Unit
emitGDispBody e env (CIf c t f) =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "gdispthen" ++ n
  let elseL = "gdispelse" ++ n
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let _ = emitGDispBody e env t
  let _ = emit e (elseL ++ ":")
  emitGDispBody e env f
emitGDispBody e env (CLet False (PVar x _) rhs b) =
  let (v, ty) = emitExpr e env rhs
  emitGDispBody e (omInsert x (v, ty) env) b
emitGDispBody e env (CLet False PWild rhs b) =
  let _ = emitExpr e env rhs
  emitGDispBody e env b
emitGDispBody e env (CBlock stmts) = emitGDispBlock e env stmts
-- tail-position decision tree: keep `e.gDispCtx` LIVE across the tree (each arm
-- body is a redirected tail leaf via emitLeaf/emitGuardedArm), save+null the
-- fallthrough label (a non-exhaustive tail match's CTFail is a genuine abort).
-- The result slot + end label are a DEAD block (no leaf stores there under an
-- active group ctx) — the Stage-1 B-match precedent.
emitGDispBody e env (CDecision scrut arms tree) =
  let (sv, _) = emitExpr e env scrut
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "gdispdecend" ++ intToString (freshLocal e)
  let rty = Ref LTInt
  let _ = emitTree e env [sv] arms [sv] slot endL "" rty tree
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  emit e "  unreachable"
emitGDispBody e env ex = emitGDispLeaf e env ex

-- block TAIL descent: emit the prefix statements exactly as emitBlock does
-- (minus its float-let unboxing specialization — a boxed binding is the
-- universal rep, semantics unchanged), then descend the final CSExpr.  The
-- detection only sanctions blocks whose LAST statement is a CSExpr
-- (lastStmtExpr); any other tail form falls to the base leaf (member-free by
-- detection, so emitting it whole as a value is sound).
emitGDispBlock : Emit -> OrdMap (String, LTy) -> List CStmt -> Unit
emitGDispBlock e env [CSExpr ex] = emitGDispBody e env ex
emitGDispBlock e env ((CSExpr ex) :: rest) =
  let _ = emitExpr e env ex
  emitGDispBlock e env rest
emitGDispBlock e env ((CSLet _ (PVar x _) ex) :: rest) =
  let (v, ty) = emitExpr e env ex
  emitGDispBlock e (omInsert x (v, ty) env) rest
emitGDispBlock e env ((CSLet _ PWild ex) :: rest) =
  let _ = emitExpr e env ex
  emitGDispBlock e env rest
emitGDispBlock e env ((CSLet _ pat ex) :: rest) =
  let (v, _) = emitExpr e env ex
  if refutableCsLet e pat then
    let env2 = emitRefutableCsLet e env pat v
    emitGDispBlock e env2 rest
  else
    let env2 = bindPattern e env pat v (CBlock rest)
    emitGDispBlock e env2 rest
emitGDispBlock e env ((CSAssign x ex) :: rest) =
  let (v, ty) = emitExpr e env ex
  emitGDispBlock e (omInsert x (v, ty) env) rest
emitGDispBlock e env stmts = emitGDispLeaf e env (CBlock stmts)

-- a group TAIL leaf.  Three classes, matching the detection's dispLeafOk:
--   • spine cons `<h1> :: … :: f <sat>` (f a member) — link the 1..N cells into
--     the dest in source order, then edge to `f`;
--   • bare saturated member call — edge to `f` (dest threads through untouched);
--   • anything else — a base value: close the dest + exit (emitTrmcBase; the
--     detection guarantees it references no member, so no member symbol — which
--     does not exist — can be emitted).
emitGDispLeaf : Emit -> OrdMap (String, LTy) -> CExpr -> Unit
emitGDispLeaf e env ex = match !e.gDispCtx
  GDispOff => emitValueRet e env ex
  GDispOn _ members uslots destSlot exitL => match gDispSpine e members ex
    Some (heads, f, args) =>
      let _ = emitGDispCells e env heads destSlot
      emitGDispEdge e env f args uslots
    None => match flattenApp ex []
      (CVar f0 _, args) =>
        let f = canonFnName e f0
        let fa = gDispFnArity e f
        if contains f members && fa >= 0 && listLen args == fa then
          emitGDispEdge e env f args uslots
        else
          emitTrmcBase e env ex destSlot exitL
      _ => emitTrmcBase e env ex destSlot exitL

-- the shared spine classifier, closed over this emitter's hooks (identical to
-- what the detection ran, so emit and detection agree leaf-by-leaf).
gDispSpine : Emit ->
  List String ->
  CExpr ->
  Option (List CExpr, String, List CExpr)
gDispSpine e members ex =
  dispSpineParts
    (n => canonFnName e n)
    (n => gDispIsFn e n)
    (n => gDispFnArity e n)
    (f => contains f members)
    ex

-- link one Cons cell per peeled head into the destination, in source order:
-- head value → alloc 24 → tag Cons → store head at +8 → link the cell word into
-- *dest → advance dest to THIS cell's tail slot (+16).  The tail word stays
-- zeroed (GC_malloc) until the next cell/base fills it — the Stage-1 GC-safety
-- argument verbatim.
emitGDispCells : Emit -> OrdMap (String, LTy) -> List CExpr -> String -> Unit
emitGDispCells _ _ [] _ = ()
emitGDispCells e env (h :: rest) destSlot =
  let hv = emitArgs e env [h]
  let cell = freshReg e
  let _ = emit e "  \{cell} = call ptr @mdk_alloc(i64 24)"
  let _ = emit e "  store i64 \{intToString (cellTag e "Cons")}, ptr \{cell}"
  let _ = storeFields e cell hv 0
  let cellw = freshReg e
  let _ = emit e "  \{cellw} = ptrtoint ptr \{cell} to i64"
  let d = freshReg e
  let _ = emit e "  \{d} = load ptr, ptr \{destSlot}"
  let _ = emit e "  store i64 \{cellw}, ptr \{d}"
  let newdest = freshReg e
  let _ = emit e "  \{newdest} = getelementptr i8, ptr \{cell}, i64 16"
  let _ = emit e "  store ptr \{newdest}, ptr \{destSlot}"
  emitGDispCells e env rest destSlot

-- a sanctioned tail edge: recompute the callee's args into fresh regs FIRST (an
-- arg may read the current member's params), store them into the shared slots
-- (positional, first arity_f slots), branch to the callee's entry block.  NO
-- call — the branch IS the loop edge.
emitGDispEdge : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CExpr ->
  List String ->
  Unit
emitGDispEdge e env f args uslots =
  let argOps = emitArgs e env args
  let _ = trmcStoreParamSlots e uslots argOps
  emit e ("  br label %" ++ gDispLabel f)

-- the clause-derived fn-arity table (wasm's collectFnArities contract: name →
-- first clause's param count) — the detection's isFn/fa hooks read it.
gDispFnArsOf : List CBind -> List (String, Int)
gDispFnArsOf [] = []
gDispFnArsOf ((CBind n cs _) :: rest) =
  (n, clauseArityOf cs) :: gDispFnArsOf rest

-- would the LLVM Stage-1 self-TMC (trmcTryFn's gate) already claim this fn?
-- (the shared dispValidate v5 keeps such singletons on Stage-1.)
gDispStage1Claims : Emit -> String -> Int -> List CClause -> Bool
gDispStage1Claims e name arity clauses =
  let pairs = clausePairs clauses
  arity > 0
    && dictUniformPairs pairs
    && trmcEligible (isCtor e) (ctorArity e) (SelfByVar name) arity pairs

-- keep only groups whose every SINGLE-CLAUSE member has eta deficit 0 (the
-- multi-clause emitFn arm never eta-saturates, so multi-clause members are
-- always stable).  A deficit member's ordinary define would gain params
-- (etaSaturateMethodBody), diverging from the group's clause-arity slot
-- protocol — no real group contains one (members are non-dict with cons/call/
-- base tails), but reject deterministically rather than assume.
gDispKeepEtaStable : Emit -> List CBind -> List DispGroup -> List DispGroup
gDispKeepEtaStable _ _ [] = []
gDispKeepEtaStable e binds (g :: rest) =
  if gDispMembersEtaStable e binds (dispMembersOf g) then
    g :: gDispKeepEtaStable e binds rest
  else
    gDispKeepEtaStable e binds rest

gDispMembersEtaStable : Emit -> List CBind -> List String -> Bool
gDispMembersEtaStable _ _ [] = True
gDispMembersEtaStable e binds (m :: rest) = match omLookup m !e.gDispBindMap
  Some (CBind name [CClause pats body] _) =>
    etaDeficit e name pats body (methodBodyDeficit e body) == 0
      && gDispMembersEtaStable e binds rest
  Some _ => gDispMembersEtaStable e binds rest
  None => False

-- drop group members from the float worker-wrapper advertisement set.
gDispDropMembers : Emit ->
  List (String, (Int, List Int)) ->
  List (String, (Int, List Int))
gDispDropMembers _ [] = []
gDispDropMembers e ((n, v) :: rest) =
  let isMember = gDispIsMember e n
  if isMember then
    gDispDropMembers e rest
  else
    (n, v) :: gDispDropMembers e rest

-- like implParamEnv, but types each synthetic `aK` scrutinee param from the fn's
-- inferred signature param types (FnSig ts) instead of defaulting to LTInt.
-- Params past the signature length (or with no sig) fall back to LTInt.
implParamEnvTyped : Int -> List LTy -> Int -> OrdMap (String, LTy)
implParamEnvTyped n _ i
  | i >= n = omEmpty
implParamEnvTyped n (ty :: tys) i =
  omInsert
    ("a" ++ intToString i)
    ("%arg" ++ intToString i, ty)
    (implParamEnvTyped n tys (i + 1))
implParamEnvTyped n [] i =
  omInsert
    ("a" ++ intToString i)
    ("%arg" ++ intToString i, LTInt)
    (implParamEnvTyped n [] (i + 1))

-- emit one variable-pattern function clause (the slice-2 path).
-- ── worker-wrapper float-param unboxing (perf/float-param-unbox) ─────────────
-- A self-recursive float-accumulator fn (`f acc n | n==0 = acc | otherwise =
-- f (acc + e) (n-1)`) boxes `acc` at every self-call (i64 ABI) then unboxes it
-- next iteration; clang TCO-loops the self-call, so the box is the only cost.
-- Emit a WORKER `@mdk_<name>__fw(double acc, …)` that carries float params as
-- native `double` (self-calls musttail back into it with unboxed args → NO box per
-- iteration) + a WRAPPER `@mdk_<name>(i64 …)` (the original ABI) that unboxes float
-- params, calls the worker, boxes the result. External callers + eta/dispatch see
-- the unchanged wrapper. Scope: single-clause, all-PVar, non-dict, ≥1 Float param,
-- Float return, body is CIf/value only (every leaf is a full-arity tail self-call
-- OR a self-free value). A `match`-bodied fn (CDecision) falls back to normal
-- codegen (safe; the CDecision-double extension is future work).
floatPositions : List LTy -> Int -> List Int
floatPositions [] _ = []
floatPositions (LTFloat :: rest) i = i :: floatPositions rest (i + 1)
floatPositions (_ :: rest) i = floatPositions rest (i + 1)

elemInt : Int -> List Int -> Bool
elemInt _ [] = False
elemInt n (x :: rest) = if n == x then True else elemInt n rest

hasFloatPty : List LTy -> Bool
hasFloatPty [] = False
hasFloatPty (LTFloat :: _) = True
hasFloatPty (_ :: rest) = hasFloatPty rest

-- a 2-arm `match scrut { lit => A ; _ => B }` (literal pattern then wildcard, no
-- guards) as the equivalent `if scrut == lit then A else B`, so a match-bodied float
-- accumulator (the idiomatic floatsum form) reuses the CIf worker machinery. None for
-- any other shape → the function stays ineligible / falls back. == on a scalar literal
-- is value-equality (emitCmp routes Int/Char/Bool/String), matching match semantics.
decisionToIf : CExpr -> List CArm -> Option CExpr
decisionToIf scrut ((CArm (PLit l) [] a) :: (CArm PWild [] b) :: []) =
  Some (CIf (CBinPrim "==" scrut (CLit l) "" noDeclLoc) a b)
decisionToIf _ _ = None

-- `self` does not occur free in `ex` (so the leaf is an ordinary value, safe to
-- compute via the wrapper-ABI path).
selfFreeW : String -> CExpr -> Bool
selfFreeW self ex = not (contains self (freeVars [] ex))

-- every leaf of the body is either a full-arity tail self-call or a self-free value;
-- descends CIf and a desugarable 2-arm match. Any self outside a tail self-call ⇒
-- ineligible.
floatWorkerOk : String -> Int -> CExpr -> Bool
floatWorkerOk self arity (CIf c t f) =
  selfFreeW self c && floatWorkerOk self arity t && floatWorkerOk self arity f
floatWorkerOk self arity (CDecision scrut arms tree) =
  match decisionToIf scrut arms
    Some cif => floatWorkerOk self arity cif
    None => selfFreeW self (CDecision scrut arms tree)
floatWorkerOk self arity (CBlock stmts) = floatWorkerBlockOk self arity stmts
floatWorkerOk self arity ex = match flattenApp ex []
  (CVar f _, args) =>
    if f == self then lengthS args == arity else selfFreeW self ex
  _ => selfFreeW self ex

-- a let-block body is worker-eligible if every leading CSLet binds a plain var with a
-- self-free RHS (the lets are evaluated before the tail) and the final stmt is a
-- CSExpr that is itself worker-eligible (the tail). Any other stmt shape (assign,
-- let-else, non-PVar pattern, non-CSExpr final) disqualifies → fall back.
floatWorkerBlockOk : String -> Int -> List CStmt -> Bool
floatWorkerBlockOk self arity ((CSExpr ex) :: []) = floatWorkerOk self arity ex
floatWorkerBlockOk self arity ((CSLet _ (PVar _ _) rhs) :: rest) =
  selfFreeW self rhs && floatWorkerBlockOk self arity rest
floatWorkerBlockOk _ _ _ = False

floatWorkerEligible : Emit -> String -> List Pat -> List LTy -> CExpr -> Bool
floatWorkerEligible e name pats ptys body =
  let rty = match sigLookup e name
    Some (FnSig _ r) => r
    None => LTInt
  let isFloatRet = match rty
    LTFloat => True
    _ => False
  allPVar pats
    && leadingDictPats pats == 0
    && hasFloatPty ptys
    && isFloatRet
    && contains name (freeVars [] body)
    && floatWorkerOk name (lengthS pats) body

-- a float-RETURNING fn that gets a `$fw` double-ABI variant for float-context callers
-- (no self-recursive / float-param requirement — return-unboxing alone is a win).
-- Single-clause, all-PVar, non-dict, float return, body shape `emitFnBodyD` handles.
floatFwEligible : Emit -> String -> List Pat -> List LTy -> CExpr -> Bool
floatFwEligible e name pats ptys body =
  let rty = match sigLookup e name
    Some (FnSig _ r) => r
    None => LTInt
  let isFloatRet = match rty
    LTFloat => True
    _ => False
  allPVar pats
    && leadingDictPats pats == 0
    && isFloatRet
    && floatWorkerOk name (lengthS pats) body

-- module set of fns that have an emitted `@mdk_<name>__fw` (name → (arity, float
-- param positions)), for emitFloatLeaf to reroute float-context calls. Built once
-- per program (call sites may precede the callee's emission).

-- collect the float-fw set from the program's single-clause function binds.
collectFloatFw : Emit -> List CBind -> List (String, (Int, List Int))
collectFloatFw _ [] = []
collectFloatFw e ((CBind name ((CClause pats body) :: []) _) :: rest) =
  let ptys = match sigLookup e name
    Some (FnSig ts _) => ts
    None => allInt pats
  if floatFwEligible e name pats ptys body then
    (name, (lengthS pats, floatPositions ptys 0)) :: collectFloatFw e rest
  else
    collectFloatFw e rest
collectFloatFw e (_ :: rest) = collectFloatFw e rest

-- module set of top-level fns that RETURN a float-returning closure (their single
-- clause body is a CLam whose body evidently returns Float, e.g.
-- `mkAdd base = (x => x + base)`).  A SATURATED call to such a fn yields a closure
-- whose own saturated call returns Float — so `recordFloatClosureResult` records the
-- call-result word in `e.closureRetTy`, letting indirectRetTy type `f 1.0` LTFloat
-- for `let f = mkAdd 100.0`.  Closes the returned-from-fn case of the closure-call-
-- result float-arith bug (the direct `let f = (x=>…)` case is handled at emitLam).

collectFloatClosureFns : Emit -> List CBind -> List String
collectFloatClosureFns _ [] = []
collectFloatClosureFns e ((CBind name ((CClause pats body) :: []) _) :: rest) =
  if isFloatClosureBody e name pats body then
    name :: collectFloatClosureFns e rest
  else
    collectFloatClosureFns e rest
collectFloatClosureFns e (_ :: rest) = collectFloatClosureFns e rest

-- The float-closure DETECTION scan runs `paramEnv` over the RAW outer params of
-- EVERY single-clause CLam-bodied fn, BEFORE any `allPVar` gate (this is the only
-- `paramEnv` caller not so gated), so it must tolerate every `Pat` shape.  `paramEnv`
-- only handles `PVar`/`PWild`; a fn whose outer param is any OTHER pattern
-- (`PCon`/`PTuple`/… — #737) simply isn't a float-closure factory, so the scan
-- returns False instead of feeding `paramEnv` a shape it panics on.  (The real emit
-- path routes such a fn through `emitMultiClauseFn` — never the float-worker path —
-- so skipping it here never suppresses a legitimate float-worker.)
paramEnvSafe : List Pat -> Bool
paramEnvSafe [] = True
paramEnvSafe ((PVar _ _) :: rest) = paramEnvSafe rest
paramEnvSafe (PWild :: rest) = paramEnvSafe rest
paramEnvSafe _ = False

isFloatClosureBody : Emit -> String -> List Pat -> CExpr -> Bool
isFloatClosureBody e name pats (CLam _ lamBody) =
  if paramEnvSafe pats then
    let ptys = match sigLookup e name
      Some (FnSig ts _) => ts
      None => allInt pats
    bodyFloatRet (paramEnv pats ptys 0) lamBody
  else
    False
isFloatClosureBody e name pats _ = False

-- after a SATURATED known-fn call whose callee returns a float-returning closure,
-- record the result word as a float-returning closure (`e.closureRetTy`) so a later
-- indirect call of it types its result LTFloat.
recordFloatClosureResult : Emit -> String -> Int -> Int -> (String, LTy) -> Unit
recordFloatClosureResult e fname argc arity (reg, _) =
  if argc == arity && contains fname !e.floatClosureFns then
    e.closureRetTy := (reg, LTFloat) :: !e.closureRetTy

-- param decls with `double` at the float positions, `i64` elsewhere.
paramDeclsD : List Pat -> List Int -> Int -> String
paramDeclsD [] _ _ = ""
paramDeclsD ((PVar _ _) :: rest) fp i =
  let ty = if elemInt i fp then "double" else "i64"
  let sep = match rest
    [] => ""
    _ => ", "
  "\{ty} %arg\{intToString i}\{sep}\{paramDeclsD rest fp (i + 1)}"
paramDeclsD _ _ _ = panic "llvm: float-worker params must be plain variables"

-- env for the worker: float params are unboxed doubles (LTFloatU → %argN holds a
-- double); other params keep their LTy.
paramEnvD : List Pat -> List LTy -> List Int -> Int -> OrdMap (String, LTy)
paramEnvD [] _ _ _ = omEmpty
paramEnvD ((PVar x _) :: rest) (ty :: tys) fp i =
  let lty = if elemInt i fp then LTFloatU else ty
  omInsert x ("%arg" ++ intToString i, lty) (paramEnvD rest tys fp (i + 1))
paramEnvD ((PVar x _) :: rest) [] fp i =
  omInsert x ("%arg" ++ intToString i, LTInt) (paramEnvD rest [] fp (i + 1))
paramEnvD _ _ _ _ = panic "llvm: float-worker params must be plain variables"

-- a self-call's argument operands: `double <d>` at float positions, `i64 <w>` else,
-- emitted left-to-right.
emitWorkerArgs : Emit ->
  OrdMap (String, LTy) ->
  List Int ->
  Int ->
  List CExpr ->
  String
emitWorkerArgs _ _ _ _ [] = ""
emitWorkerArgs e env fp i (a :: rest) =
  let op = match elemInt i fp
    True => "double " ++ emitFloatD e env a
    False =>
      let (w, _) = emitExpr e env a
      "i64 " ++ w
  let sep = match rest
    [] => ""
    _ => ", "
  op ++ sep ++ emitWorkerArgs e env fp (i + 1) rest

-- the worker body in tail position: CIf recurses; a full-arity tail self-call
-- musttails into the worker (NO box); any other (self-free) value rets a double.
emitFnBodyD : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  List Int ->
  Int ->
  CExpr ->
  Unit
emitFnBodyD e env self worker fp arity (CIf c t f) =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "then" ++ n
  let elseL = "else" ++ n
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let _ = emitFnBodyD e env self worker fp arity t
  let _ = emit e (elseL ++ ":")
  emitFnBodyD e env self worker fp arity f
emitFnBodyD e env self worker fp arity (CDecision scrut arms tree) =
  match decisionToIf scrut arms
    Some cif => emitFnBodyD e env self worker fp arity cif
    None =>
      let d = emitFloatD e env (CDecision scrut arms tree)
      emit e ("  ret double " ++ d)
emitFnBodyD e env self worker fp arity (CBlock stmts) =
  emitFnBodyDBlock e env self worker fp arity stmts
emitFnBodyD e env self worker fp arity other =
  emitTailLeafD e env self worker fp arity other (flattenApp other [])

-- emit a worker-mode let-block: bind each leading CSLet (float RHS → unboxed double
-- LTFloatU, same as emitBlock; else normal), then emit the final CSExpr in tail
-- (double-return) mode. Gated by floatWorkerBlockOk, so the shape is guaranteed.
emitFnBodyDBlock : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  List Int ->
  Int ->
  List CStmt ->
  Unit
emitFnBodyDBlock e env self worker fp arity ((CSExpr ex) :: []) =
  emitFnBodyD e env self worker fp arity ex
emitFnBodyDBlock e env self worker fp arity ((CSLet _ (PVar x _) rhs) :: rest) =
  if staticIsFloat env rhs then
    let d = emitFloatD e env rhs
    emitFnBodyDBlock e (omInsert x (d, LTFloatU) env) self worker fp arity rest
  else
    let (v, ty) = emitExpr e env rhs
    emitFnBodyDBlock e (omInsert x (v, ty) env) self worker fp arity rest
emitFnBodyDBlock e env _ _ _ _ _ =
  gapU
    e
    "float-worker block: unexpected statement shape (should be gated by floatWorkerBlockOk)"

emitTailLeafD : Emit ->
  OrdMap (String, LTy) ->
  String ->
  String ->
  List Int ->
  Int ->
  CExpr ->
  (CExpr, List CExpr) ->
  Unit
emitTailLeafD e env self worker fp arity _ (CVar f0 _, args)
  | f0 == self && lengthS args == arity =
    let ops = emitWorkerArgs e env fp 0 args
    let r = freshReg e
    let _ = emit e "  \{r} = musttail call double @mdk_\{worker}(\{ops})"
    emit e ("  ret double " ++ r)
emitTailLeafD e env _ _ _ _ other _ =
  let d = emitFloatD e env other
  emit e ("  ret double " ++ d)

-- the wrapper's call args: `double <unbox %argN>` at float positions, `i64 %argN` else.
wrapperCallArgs : Emit -> List Int -> Int -> List Pat -> String
wrapperCallArgs _ _ _ [] = ""
wrapperCallArgs e fp i (_ :: rest) =
  let op = match elemInt i fp
    True => "double " ++ unboxFloat e ("%arg" ++ intToString i)
    False => "i64 %arg" ++ intToString i
  let sep = match rest
    [] => ""
    _ => ", "
  op ++ sep ++ wrapperCallArgs e fp (i + 1) rest

-- emit ONLY the double-ABI `$fw` variant of a float fn (no wrapper) — used both by
-- emitFloatWorkerFn (self-recursive: wrapper added separately) and for non-recursive
-- float fns emitted alongside their original i64-ABI definition.
emitFloatFwOnly : Emit -> String -> List Pat -> List LTy -> CExpr -> Unit
emitFloatFwOnly e name pats ptys body =
  let fp = floatPositions ptys 0
  let arity = lengthS pats
  let worker = name ++ "__fw"
  let wenv = paramEnvD pats ptys fp 0
  let _ = beginDefine e
  let _ = emit e "define double @mdk_\{worker}(\{paramDeclsD pats fp 0}) {"
  let _ = emit e "entry:"
  let _ = emitFnBodyD e wenv name worker fp arity body
  let _ = emit e "}"
  emit e ""

emitFloatWorkerFn : Emit -> String -> List Pat -> List LTy -> CExpr -> Unit
emitFloatWorkerFn e name pats ptys body =
  let fp = floatPositions ptys 0
  let worker = name ++ "__fw"
  -- worker ($fw): float params as doubles, body emitted double-returning
  let _ = emitFloatFwOnly e name pats ptys body
  -- wrapper: original i64 ABI; unbox float params, call worker, box the result
  let _ = beginDefine e
  let _ = emit e "define i64 @mdk_\{name}(\{paramDecls pats 0}) {"
  let _ = emit e "entry:"
  let callArgs = wrapperCallArgs e fp 0 pats
  let r = freshReg e
  let _ = emit e "  \{r} = call double @mdk_\{worker}(\{callArgs})"
  let b = boxFloat e r
  let _ = emit e ("  ret i64 " ++ b)
  let _ = emit e "}"
  emit e ""

-- ── the raw worker (see `RawWorker`) ────────────────────────────────────────
-- Which functions get one: a single clause of plain-variable parameters, no
-- dictionary parameters, a declared signature of exactly the clause's arity
-- naming `U64`, `U32` or `I32` in a parameter or the result and no `Float`
-- (whose own worker is `__fw`), and none of the shapes emitFn routes elsewhere
-- (a dispatch-group member, a TRMC loop, an eta-saturated method body).
rawWorkerOf : Emit -> Bool -> CBind -> Option RawWorker
rawWorkerOf e refine (CBind name [CClause pats body] _) = match declSigOf e name
  Some (pnames, rname) =>
    let arity = lengthS pats
    let declaredRk = rawKindOfHead rname
    let rk =
      if refine && not (rawRetOk e name arity declaredRk body) then
        RawWord
      else
        declaredRk
    let declared = map rawKindOfHead pnames
    let ks =
      if refine then
        refineU64Params e (sameRawKind rk RawU64) body pats declared
      else
        declared
    if arity > 0
      && lengthS pnames == arity
      && (any (k => not (isRawWord k)) ks || not (isRawWord rk))
      && allPVar pats
      && leadingDictPats pats == 0
      && not (contains "Float" pnames)
      && rname /= "Float"
      && isNone (dispGroupOf !e.gDispGroups name)
      && not
        (trmcEligible (isCtor e) (ctorArity e) (SelfByVar name) arity [
          (pats, body),
        ])
      && lengthS (fst (etaSaturateMethodBody e name pats body)) == arity then
      Some (RawWorker arity ks rk)
    else
      None
  None => None
rawWorkerOf _ _ _ = None

-- A top-level value binding whose body is a literal (`limbMask : U64 =
-- 0x3ffffff`).  Read where a raw U64 or U32 is wanted, it is that literal,
-- which LLVM folds, rather than a load of the global's word and, for a U64,
-- of its cell's payload.
collectConstGlobals : List CBind -> OrdMap Lit
collectConstGlobals [] = omEmpty
collectConstGlobals ((CBind name [CClause [] (CLit l)] _) :: rest) =
  omInsert name l (collectConstGlobals rest)
collectConstGlobals (_ :: rest) = collectConstGlobals rest

-- A U64 parameter stays raw only if no occurrence would box it, and a raw
-- result only if its tail calls stay tail calls (`rawRetOk`); both depend on
-- which positions of the functions called are raw.  The first pass takes every
-- declared position as raw; later passes re-derive each worker against the
-- previous pass's map until it stops changing (a pass only ever turns a raw
-- position into a word, so this ends).  The map is sound at every pass, since
-- every call site reads the final one; the passes decide how many boxes and
-- which tail calls are left.
collectRawWorkers : Emit -> List CBind -> OrdMap RawWorker
collectRawWorkers e binds =
  let first = collectRawWorkersPass e False binds
  e.rawWorkers := first
  refineRawWorkers e binds (rawWorkerKey first) 20

refineRawWorkers : Emit -> List CBind -> String -> Int -> OrdMap RawWorker
refineRawWorkers e binds prevKey fuel =
  let next = collectRawWorkersPass e True binds
  let key = rawWorkerKey next
  if key == prevKey || fuel <= 0 then
    next
  else
    e.rawWorkers := next
    refineRawWorkers e binds key (fuel - 1)

-- a textual key of a worker map, to see a pass change nothing.
rawWorkerKey : OrdMap RawWorker -> String
rawWorkerKey m =
  joinNl (map (k => rawWorkerEntryKey k (omLookup k m)) (omKeys m))

rawWorkerEntryKey : String -> Option RawWorker -> String
rawWorkerEntryKey k (Some (RawWorker _ ks r)) =
  "\{k}:\{joinNl (map rawKindKey ks)}>\{rawKindKey r};"
rawWorkerEntryKey k None = k

rawKindKey : RawKind -> String
rawKindKey RawWord = "w"
rawKindKey RawU64 = "u"
rawKindKey RawU32 = "i"
rawKindKey RawI32 = "s"

-- A raw result is kept only when every call in tail position returns without
-- a box or a retag between it and the `ret`: a saturated self-call, which
-- `emitFnBodyRaw` makes a `musttail`, or a call of a worker whose result is raw
-- of the same kind.  Any other tail call would box its result before
-- returning, which is no longer a tail call, so a deep recursion through it
-- (a `match` arm, a mutual recursion through an ordinary function) would grow
-- the stack where the uniform define loops.  Such a function returns a word.
rawRetOk : Emit -> String -> Int -> RawKind -> CExpr -> Bool
rawRetOk e self n k (CIf _ t f) = rawRetOk e self n k t && rawRetOk e self n k f
rawRetOk e self n k (CDecision scrut arms tree) = match decisionToIf scrut arms
  Some cif => rawRetOk e self n k cif
  None => not (tailCalls e (CDecision scrut arms tree))
rawRetOk e self n k (CBlock stmts) = match reverseL stmts
  (CSExpr ex) :: _ => rawRetOk e self n k ex
  _ => True
rawRetOk e self n k (CLet False (PVar x a) e1 e2) = match e1
  CLam _ _ => not (tailCalls e (CLet False (PVar x a) e1 e2))
  _ => rawRetOk e self n k e2
rawRetOk e self n k ex = match flattenApp ex []
  (CVar f _, args) =>
    let name = canonFnName e f
    if name == self then
      lengthS args == n
    else if isKnownFn e name then
      isSome (rawWorkerReturning e f (lengthS args) k)
    else
      True
  _ => not (tailCalls e ex)

-- does a call of a top-level function sit in a tail position of `ex`?
tailCalls : Emit -> CExpr -> Bool
tailCalls e (CIf _ t f) = tailCalls e t || tailCalls e f
tailCalls e (CDecision _ arms _) = armsTailCall e arms
tailCalls e (CBlock stmts) = match reverseL stmts
  (CSExpr ex) :: _ => tailCalls e ex
  _ => False
tailCalls e (CLet _ _ _ e2) = tailCalls e e2
tailCalls e ex = match flattenApp ex []
  (CVar f _, _ :: _) => isKnownFn e (canonFnName e f)
  _ => False

armsTailCall : Emit -> List CArm -> Bool
armsTailCall _ [] = False
armsTailCall e ((CArm _ _ body) :: rest) =
  tailCalls e body || armsTailCall e rest

collectRawWorkersPass : Emit -> Bool -> List CBind -> OrdMap RawWorker
collectRawWorkersPass _ _ [] = omEmpty
collectRawWorkersPass e refine (b :: rest) = match rawWorkerOf e refine b
  Some w => omInsert (bindName b) w (collectRawWorkersPass e refine rest)
  None => collectRawWorkersPass e refine rest

-- each declared `U64` parameter that some occurrence would box becomes a word.
refineU64Params : Emit ->
  Bool ->
  CExpr ->
  List Pat ->
  List RawKind ->
  List RawKind
refineU64Params e retRaw body ((PVar x _) :: ps) (RawU64 :: ks) =
  let k = if u64Escapes e x retRaw body == 0 then RawU64 else RawWord
  k :: refineU64Params e retRaw body ps ks
refineU64Params e retRaw body (_ :: ps) (k :: ks) =
  k :: refineU64Params e retRaw body ps ks
refineU64Params _ _ _ _ ks = ks

-- The worker `@mdk_<name>__rw` and the uniform-ABI wrapper `@mdk_<name>`.
emitRawWorkerFn : Emit -> String -> List Pat -> CExpr -> RawWorker -> Unit
emitRawWorkerFn e name pats body (RawWorker arity ks rk) =
  let ptys = match sigLookup e name
    Some (FnSig ts _) => ts
    None => allInt pats
  let worker = "mdk_" ++ name ++ "__rw"
  let rty = rawKindTy rk
  let wenv = paramEnvRaw pats ptys ks 0
  let _ = beginDefine e
  let _ = emit e "define \{rty} @\{worker}(\{rawParamDecls ks 0}) {"
  let _ = emit e "entry:"
  let _ =
    emitFnBodyRaw e wenv (RawTail name worker (RawWorker arity ks rk)) body
  let _ = emit e "}"
  let _ = emit e ""
  let _ = beginDefine e
  let _ = emit e "define i64 @mdk_\{name}(\{paramDecls pats 0}) {"
  let _ = emit e "entry:"
  let ops = rawWrapperArgs e ks 0
  let r = freshReg e
  let _ = emit e "  \{r} = call \{rty} @\{worker}(\{rawArgDecls ops})"
  let out = match rk
    RawU64 => boxU64 e r
    RawU32 => tagU32 e r
    RawI32 => tagI32 e r
    RawWord => r
  let _ = emit e "  ret i64 \{out}"
  let _ = emit e "}"
  emit e ""

-- the worker's parameter list: `i32` for a U32 or I32 position, `i64` otherwise.
rawParamDecls : List RawKind -> Int -> String
rawParamDecls [] _ = ""
rawParamDecls [k] i = "\{rawKindTy k} %arg\{intToString i}"
rawParamDecls (k :: rest) i =
  "\{rawKindTy k} %arg\{intToString i}, \{rawParamDecls rest (i + 1)}"

-- the wrapper's worker arguments: each parameter's word unboxed or untagged to
-- its position's kind.
rawWrapperArgs : Emit -> List RawKind -> Int -> List (String, String)
rawWrapperArgs _ [] _ = []
rawWrapperArgs e (k :: rest) i =
  let a = "%arg" ++ intToString i
  let op = match k
    RawU64 => unboxU64 e a
    RawU32 => untagU32 e a
    RawI32 => untagU32 e a
    RawWord => a
  (rawKindTy k, op) :: rawWrapperArgs e rest (i + 1)

-- the worker's env: a raw parameter holds its payload (LTU64U) or its `i32`
-- (LTU32U, LTI32U), the others their words at the signature's types.
paramEnvRaw : List Pat ->
  List LTy ->
  List RawKind ->
  Int ->
  OrdMap (String, LTy)
paramEnvRaw ((PVar x _) :: rest) tys (k :: ks) i =
  let (ty, tys2) = match tys
    t :: ts => (t, ts)
    [] => (LTInt, [])
  let lty = match k
    RawU64 => LTU64U
    RawU32 => LTU32U
    RawI32 => LTI32U
    RawWord => ty
  omInsert x ("%arg" ++ intToString i, lty) (paramEnvRaw rest tys2 ks (i + 1))
paramEnvRaw [] _ _ _ = omEmpty
paramEnvRaw _ _ _ _ = panic "llvm: raw-worker params must be plain variables"

-- the function a worker body belongs to: its name, its worker symbol, its shape.
data RawTail = RawTail String String RawWorker

-- A worker body in tail position.  `if`, a two-arm literal match, a block and a
-- `let` pass tail position on; a saturated self-call is a `musttail` call of the
-- worker on raw values (the loop); any other value is returned in the worker's
-- result kind.
emitFnBodyRaw : Emit -> OrdMap (String, LTy) -> RawTail -> CExpr -> Unit
emitFnBodyRaw e env t (CIf c th el) =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "then" ++ n
  let elseL = "else" ++ n
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  let _ = emit e (thenL ++ ":")
  let _ = emitFnBodyRaw e env t th
  let _ = emit e (elseL ++ ":")
  emitFnBodyRaw e env t el
emitFnBodyRaw e env t (CDecision scrut arms tree) =
  match decisionToIf scrut arms
    Some cif => emitFnBodyRaw e env t cif
    None => emitRawValueRet e env t (CDecision scrut arms tree)
emitFnBodyRaw e env t (CBlock stmts) = emitFnBodyRawBlock e env t stmts
emitFnBodyRaw e env t (CLet False (PVar x a) e1 e2) = match e1
  CLam _ _ => emitRawValueRet e env t (CLet False (PVar x a) e1 e2)
  _ => emitFnBodyRaw e (bindLetRaw e env x e1 e2) t e2
emitFnBodyRaw e env (RawTail self worker w) other = match flattenApp other []
  (CVar f _, args) =>
    if not (isLocal env f)
      && canonFnName e f == self
      && lengthS args == rawWorkerArity w then
      let ops = emitRawArgs e env (rawWorkerKinds w) args
      let rty = rawKindTy (rawWorkerRet w)
      let r = freshReg e
      let _ =
        emit e "  \{r} = musttail call \{rty} @\{worker}(\{rawArgDecls ops})"
      emit e "  ret \{rty} \{r}"
    else
      emitRawValueRet e env (RawTail self worker w) other
  _ => emitRawValueRet e env (RawTail self worker w) other

emitFnBodyRawBlock : Emit ->
  OrdMap (String, LTy) ->
  RawTail ->
  List CStmt ->
  Unit
emitFnBodyRawBlock e env t [CSExpr ex] = emitFnBodyRaw e env t ex
emitFnBodyRawBlock e env (RawTail _ _ w) [s] =
  let (v, _) = emitBlockLast e env s
  emitRawWordRet e (rawWorkerRet w) v
emitFnBodyRawBlock e env t (s :: rest) =
  emitFnBodyRawBlock e (emitBlockLead e env s rest) t rest
emitFnBodyRawBlock e _ _ [] = gapU e "empty block"

-- return a worker body's value in the worker's result kind.
emitRawValueRet : Emit -> OrdMap (String, LTy) -> RawTail -> CExpr -> Unit
emitRawValueRet e env (RawTail _ _ w) ex = match rawWorkerRet w
  RawU64 => emit e "  ret i64 \{emitU64Raw e env ex}"
  RawU32 => emit e "  ret i32 \{emitU32Raw e env ex}"
  RawI32 => emit e "  ret i32 \{emitU32Raw e env ex}"
  RawWord => emitValueRet e env ex

-- return an already-emitted word in the worker's result kind.
emitRawWordRet : Emit -> RawKind -> String -> Unit
emitRawWordRet e k v = emit e "  ret \{rawKindTy k} \{rawOfWord e k v}"

rawWorkerArity : RawWorker -> Int
rawWorkerArity (RawWorker n _ _) = n

rawWorkerKinds : RawWorker -> List RawKind
rawWorkerKinds (RawWorker _ ks _) = ks

emitFnClause : Emit -> String -> List Pat -> CExpr -> Unit
emitFnClause e name pats body =
  let ptys = match sigLookup e name
    Some (FnSig ts _) => ts
    None => allInt pats
  if floatWorkerEligible e name pats ptys body then
    emitFloatWorkerFn e name pats ptys body
  else
    emitFnClauseStd e name pats ptys body

-- non-worker single-clause fn: emit the original i64-ABI define; if it is a
-- float-returning fn `emitFnBodyD` can handle, ALSO emit a standalone `$fw` variant
-- (the original stays for i64-ABI callers; float-context callers use `$fw`).
emitFnClauseStd : Emit -> String -> List Pat -> List LTy -> CExpr -> Unit
emitFnClauseStd e name pats ptys body =
  let _ = emitFnClauseW e name pats ptys body
  if floatFwEligible e name pats ptys body then
    emitFloatFwOnly e name pats ptys body

emitFnClauseW : Emit -> String -> List Pat -> List LTy -> CExpr -> Unit
emitFnClauseW e name pats ptys body =
  let env = paramEnv pats ptys 0
  let _ = beginDefine e
  let _ = emit e "define i64 @mdk_\{name}(\{paramDecls pats 0}) {"
  let _ = emit e "entry:"
  let _ = emitFnBody e env ("mdk_" ++ name) body
  let _ = emit e "}"
  emit e ""

-- every parameter is a plain variable pattern (the slice-2 ABI requirement).
allPVar : List Pat -> Bool
allPVar [] = True
allPVar ((PVar _ _) :: rest) = allPVar rest
allPVar _ = False

sigTable : Emit -> List (String, FnSig)
sigTable e = !e.sigs

-- default param types when no signature was inferred (every param Int).
allInt : List Pat -> List LTy
allInt [] = []
allInt (_ :: rest) = LTInt :: allInt rest

-- A `PWild` param binds no name but still occupies an ABI slot: emit the `%argN`
-- word (unused in the body) exactly as a `PVar` would, so positional %argN indexing
-- stays aligned.  These `PWild` arms are kept SYMMETRIC with `paramEnv`'s (the two
-- are always used as a pair); every `paramDecls` caller is `allPVar`-gated
-- (`emitFn`, `emitRecLam`), so a `PWild` never actually reaches here — a wildcard
-- outer param routes through `emitMultiClauseFn` — but keeping the arms avoids a
-- spurious catch-all panic if a future caller drops that gate.
paramDecls : List Pat -> Int -> String
paramDecls [] _ = ""
paramDecls [PVar _ _] i = "i64 %arg" ++ intToString i
paramDecls [PWild] i = "i64 %arg" ++ intToString i
paramDecls ((PVar _ _) :: rest) i =
  "i64 %arg\{intToString i}, \{paramDecls rest (i + 1)}"
paramDecls (PWild :: rest) i =
  "i64 %arg\{intToString i}, \{paramDecls rest (i + 1)}"
paramDecls _ _ = panic "llvm: function parameters must be plain variables"

-- bind each parameter to %argN at its inferred static type (every param is an i64
-- word at the ABI; the type only drives int-vs-float instruction selection).
paramEnv : List Pat -> List LTy -> Int -> OrdMap (String, LTy)
paramEnv [] _ _ = omEmpty
paramEnv ((PVar x _) :: rest) (ty :: tys) i =
  omInsert x ("%arg" ++ intToString i, ty) (paramEnv rest tys (i + 1))
paramEnv ((PVar x _) :: rest) [] i =
  omInsert x ("%arg" ++ intToString i, LTInt) (paramEnv rest [] (i + 1))
-- A `PWild` param binds no name: contribute NO env entry, but still consume its
-- type slot and advance the %argN index so later `PVar` params keep their positions
-- (#671 — a wildcard outer param on a closure-returning fn reached here through
-- `isFloatClosureBody`; the missing arm was the emitter panic).
paramEnv (PWild :: rest) (_ :: tys) i = paramEnv rest tys (i + 1)
paramEnv (PWild :: rest) [] i = paramEnv rest [] (i + 1)
paramEnv _ _ _ = panic "llvm: function parameters must be plain variables"

-- #1101: is a tail-position call of `fname` with `n` flattened arguments SATURATED
-- against the callee's EMITTED define arity?  The ruler is `defArityOf` (the
-- replayed post-`etaSaturateMethodBody` param count of the actual `@mdk_<fn>`
-- define), NEVER `fnArity` — the signature/clause arity diverges from the emitted
-- one whenever eta-saturation fires (see installDefArityMap's note above).  `None`
-- (name absent from the table) keeps the unconditional direct call, matching the
-- behaviour that predated this guard for anything not in the table.
tailCallSaturated : Emit -> String -> Int -> Bool
tailCallSaturated e fname n = match defArityOf e fname
  Some a => n == a
  None => True

-- emit a function body in TAIL position: every control path ends in a `ret`.
-- An `if` recurses into both arms (each arm is itself in tail position and rets);
-- a `let`, a `let`/`where` group or a block emits its bindings as the value
-- path does and passes tail position to its body; a `match` puts its arms in
-- tail position (`emitTailDecision`); a SATURATED tail call to a known function
-- emits `[musttail] call` + `ret`; anything else is computed as a value and
-- returned.  `self` is the emitted symbol of the enclosing define (`mdk_…`), the
-- namespace `directTailCallee` answers in.  A `musttail` callee must not receive
-- a pointer into the caller's frame: every closure a let or group binds is an
-- `@mdk_alloc` cell or a constant global, never an `alloca`, so this is sound.
emitFnBody : Emit -> OrdMap (String, LTy) -> String -> CExpr -> Unit
emitFnBody e env self (CIf c t f) =
  let (thenL, elseL) = emitTailIfHead e env c
  let _ = emit e (thenL ++ ":")
  let _ = emitFnBody e env self t
  let _ = emit e (elseL ++ ":")
  emitFnBody e env self f
emitFnBody e env self (CDecision scrut arms tree) =
  emitTailDecision e env self scrut arms tree
emitFnBody e env self (CLet recF pat e1 e2) =
  if letBinds recF pat e1 then
    emitFnBody e (bindLet e env recF pat e1 e2) self e2
  else
    emitValueRet e env (CLet recF pat e1 e2)
emitFnBody e env self (CLetGroup binds body) =
  match bindLetGroup e env binds body
    Some env2 => emitFnBody e env2 self body
    None =>
      let (v, _) = letGroupGap e
      emit e ("  ret i64 " ++ v)
emitFnBody e env self (CBlock stmts) = match lastStmtExpr stmts
  Some last => emitFnBody e (emitBlockInit e env stmts) self last
  None => emitValueRet e env (CBlock stmts)
emitFnBody e env self other = match directTailCallee e other
  Some _ => emitTailCallRet e env self other
  None => emitValueRet e env other

-- emit every statement of a block but the last, exactly as `emitBlock` does
-- (each one's scope is the rest of the block, the last statement included), and
-- return the env the last statement sees.
emitBlockInit : Emit ->
  OrdMap (String, LTy) ->
  List CStmt ->
  OrdMap (String, LTy)
emitBlockInit _ env [] = env
emitBlockInit _ env [_] = env
emitBlockInit e env (s :: rest) =
  emitBlockInit e (emitBlockLead e env s rest) rest

-- test a tail `if`'s condition and branch on it; returns the (then, else) block
-- labels, which the caller opens.
emitTailIfHead : Emit -> OrdMap (String, LTy) -> CExpr -> (String, String)
emitTailIfHead e env c =
  let (cv, _) = emitExpr e env c
  let ci = untagInt e cv
  let cb = freshReg e
  let _ = emit e "  \{cb} = icmp ne i64 \{ci}, 0"
  let n = intToString (freshLocal e)
  let thenL = "then" ++ n
  let elseL = "else" ++ n
  let _ = emit e "  br i1 \{cb}, label %\{thenL}, label %\{elseL}"
  (thenL, elseL)

-- a `match` in the tail position of the define `self`: `emitDecision`'s shape
-- (result slot, join block, load + `ret`), with the arms descended under
-- `e.selfTailCtx` so a saturated self call returns from its own leaf.
emitTailDecision : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  List CArm ->
  CTree ->
  Unit
emitTailDecision e env self scrut arms tree =
  let (sv, _) = emitExpr e env scrut
  let slot = freshReg e
  let _ = emit e ("  " ++ slot ++ " = alloca i64")
  let endL = "decend" ++ intToString (freshLocal e)
  let rty = Ref LTInt
  let saved = !e.selfTailCtx
  e.selfTailCtx := Some self
  let _ = emitTree e env [sv] arms [sv] slot endL "" rty tree
  e.selfTailCtx := saved
  let _ = emit e (endL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{slot}"
  emit e ("  ret i64 " ++ r)

-- `emitClauseTree` for a define whose clause bodies are its tail position: the
-- leaves are descended under `e.selfTailCtx` (see `emitArmBody`).
emitTailClauseTree : Emit ->
  OrdMap (String, LTy) ->
  String ->
  Int ->
  List (List Pat, CExpr) ->
  Loc ->
  Unit
emitTailClauseTree e env self arity clauses site =
  let saved = !e.selfTailCtx
  e.selfTailCtx := Some self
  let _ = emitClauseTree e env arity clauses "" site
  e.selfTailCtx := saved

-- The emitted symbol (`mdk_…`, the name the IR `call`s) of `ex`'s callee when
-- `ex` is a SATURATED call of a known function that a tail position lowers to a
-- direct `call` + `ret` (`emitTailCallRet`), else None.  Emits nothing.
--
-- #1101: an UNSATURATED (over- or under-applied) tail call must not be emitted as
-- a direct call — passing every flattened argument to a define with fewer params
-- silently dropped the surplus and never invoked the returned closure.  Such a
-- call returns None, so it is emitted as a value through `emitApp` ->
-- `emitKnownFnSat` -> `emitOverApp`/`emitPapClosure`, the same correct shape an
-- application in `main`'s own body already gets.  `emitArgs` is 1:1 with `args`,
-- so `lengthS args` is the arg-word count.  A `u64` kernel wrapper
-- (`u64KernelAlias`) goes through `emitApp`, which emits the kernel inline.
--
-- A constrained call carries its leading dictionary words in the CDict head,
-- outside `args`.  Both lists count against the actual emitted define arity;
-- mismatched calls keep the normal PAP/over-application path through
-- emitDictApp.  A statically routed method call (`CMethod` with an `RKey` route,
-- an impl method calling itself among them) is accepted on `emitMethod`'s own
-- saturation rule (`tailMethodEntry`).
directTailCallee : Emit -> CExpr -> Option String
directTailCallee e ex =
  let (hd, args) = flattenApp ex []
  match hd
    CVar fname0 _ =>
      let fname = canonFnName e fname0
      if isKnownFn e fname
        && hasArgs args
        && tailCallSaturated e fname (lengthS args)
        && isNone (u64KernelAlias e fname0 args)
        && isNone (rawWorkerCall e fname (lengthS args)) then
        Some ("mdk_" ++ fname)
      else
        None
    CDict fname routes =>
      let nwords = listLen routes + lengthS args
      if isKnownFn e fname
        && nwords > 0
        && tailCallSaturated e fname nwords then
        Some ("mdk_" ++ fname)
      else
        None
    CMethod name iface siteArity route implRoutes methRoutes =>
      let entry =
        tailMethodEntry e name iface siteArity route implRoutes methRoutes args
      map (implEntryFnName e name) entry
    _ => None

-- The impl entry a statically routed method call selects, when `emitApp` would
-- lower the call to a saturated direct call of that entry's define: an `RKey`
-- route, not the `fromInt` identity `emitApp` folds away, and as many arguments
-- as the entry's arity (the leading dict words count on both sides of
-- `emitMethod`'s comparison, so they cancel).  Any other call is None and keeps
-- `emitImplCallSat`'s PAP/over-application path.  Emits nothing.
tailMethodEntry : Emit ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  List CExpr ->
  Option CImplEntry
tailMethodEntry e name iface siteArity (route@(RKey tag _ _)) implRoutes methRoutes args =
  let folded = intFromIntIdentityArg name route implRoutes methRoutes args
  let entry =
    if hasArgs args && isNone folded then
      implForSite e name iface tag siteArity
    else
      None
  match entry
    Some ent =>
      if lengthS args == methodArityOfEntry e ent name then Some ent else None
    None => None
tailMethodEntry _ _ _ _ _ _ _ _ = None

-- emit a call `directTailCallee` accepted, then `ret` its result; a call of the
-- enclosing define `self` is a `musttail call` (self recursion means the caller
-- and callee prototypes match, which musttail requires).  Operands are emitted in
-- the order the value path (`emitApp`) emits them.
emitTailCallRet : Emit -> OrdMap (String, LTy) -> String -> CExpr -> Unit
emitTailCallRet e env self ex =
  let (hd, args) = flattenApp ex []
  let (sym, ops) = match hd
    CDict f routes =>
      let dictWords = dictWordsOf e env routes
      ("mdk_" ++ f, dictWords ++ emitArgs e env args)
    CVar f0 _ => ("mdk_" ++ canonFnName e f0, emitArgs e env args)
    CMethod name iface siteArity route implRoutes methRoutes =>
      let entry =
        tailMethodEntry e name iface siteArity route implRoutes methRoutes args
      match entry
        Some ent =>
          let argOps = emitArgs e env args
          let dictRoutes =
            staticEntryDictRoutes e name ent route methRoutes implRoutes
          let dictWords = dictWordsOf e env dictRoutes
          (implEntryFnName e name ent, dictWords ++ argOps)
        None =>
          panic "llvm: emitTailCallRet on a call directTailCallee rejected"
    _ => panic "llvm: emitTailCallRet on a call directTailCallee rejected"
  let r = freshReg e
  let kw = if sym == self then "musttail call" else "call"
  let _ = emit e "  \{r} = \{kw} i64 @\{sym}(\{argDecls ops})"
  emit e ("  ret i64 " ++ r)

emitValueRet : Emit -> OrdMap (String, LTy) -> CExpr -> Unit
emitValueRet e env ex =
  let (v, _) = emitExpr e env ex
  emit e ("  ret i64 " ++ v)

-- ── classifying top-level bindings ──────────────────────────────────────────
-- a function binding = non-`main`, first clause has at least one parameter.
isFnBind : CBind -> Bool
isFnBind (CBind "main" _ _) = False
isFnBind (CBind _ ((CClause (_ :: _) _) :: _) _) = True
isFnBind _ = False

collectFns : List CBind -> List String
collectFns [] = []
collectFns (b :: rest) =
  if isFnBind b then bindName b :: collectFns rest else collectFns rest

fnBinds : List CBind -> List CBind
fnBinds [] = []
fnBinds (b :: rest) = if isFnBind b then b :: fnBinds rest else fnBinds rest

-- the nullary value bindings (non-`main`, no parameters), in source order.
valBinds : List CBind -> List CBind
valBinds [] = []
valBinds ((CBind "main" cs _) :: rest) = valBinds rest
valBinds (b :: rest) = if isFnBind b then valBinds rest else b :: valBinds rest

-- value bindings ORDERED so a binding precedes the ones that reference it (E1b).
-- The init prologue computes each rhs once, eagerly, so a binding whose rhs reads
-- ANOTHER value global (`prog = andThen skip …`, `skip` defined later) must run
-- after that dependency or it captures the still-zero global cell — a null that
-- crashes at use.  Source order is NOT dependency order in general (the self-host
-- parser binds combinator values forward of their producers), so topologically
-- sort by intra-value-global references.  A genuine VALUE cycle (mutual recursion
-- through nullary globals — none arise in practice) keeps its members in source
-- order, the pre-existing behaviour (still caught by the forward-ref gap).
-- `allBinds` is the WHOLE program (functions included) so the eager-reachability
-- closure can follow calls; `binds` is the nullary value bindings to be ordered.
orderedValBinds : List CBind -> List CBind -> List CBind
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
orderedValBinds allBinds binds =
  let rm = eagerReachMap allBinds
  -- #623: ONE name→bind map replaces the `all : List CBind` + `names : List
  -- String` pair; `done`/`visiting` are sets, not lists; and `acc` is built by
  -- PREPEND + one final reverse instead of `acc ++ [b]` per binding.  Every one
  -- of those was a `List` used as a set (or an O(left) `++` inside a fold) over
  -- the transitive reach sets #553 Stage B enlarged.  Output order unchanged.
  let bm = bindNameMap binds
  let (_, ordered) = topoValGo rm bm binds omEmpty []
  reverseL ordered

-- DFS post-order: visit each binding's value-global dependencies first, appending
-- the binding after them.  `visiting` guards against cycles (a back-edge is
-- skipped — its target stays where source order placed it).  Returns the grown
-- (done-names, ordered-binds) accumulators.  `rm` is the eager-reachability map
-- (Stage B of #553): a binding's edges are the value globals it eagerly reaches
-- THROUGH calls, not merely the ones its own body names directly.
topoValGo : OrdMap (List String) ->
  OrdMap CBind ->
  List CBind ->
  OrdMap Unit ->
  List CBind ->
  (OrdMap Unit, List CBind)
topoValGo _ _ [] done acc = (done, acc)
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
topoValGo rm bm (b :: rest) done acc =
  let (done2, acc2) = topoValVisit rm bm b done acc omEmpty
  topoValGo rm bm rest done2 acc2

topoValVisit : OrdMap (List String) ->
  OrdMap CBind ->
  CBind ->
  OrdMap Unit ->
  List CBind ->
  OrdMap Unit ->
  (OrdMap Unit, List CBind)
topoValVisit rm bm b done acc visiting
  | omHasKey (bindName b) done = (done, acc)
  | omHasKey (bindName b) visiting = (done, acc)
  | otherwise =
    let deps = filterList (n => omHasKey n bm) (dedupS (bindEagerReach rm b))
    let (done2, acc2) =
      topoValVisitDeps rm bm deps done acc (omInsert (bindName b) () visiting)
    (omInsert (bindName b) () done2, b :: acc2)

topoValVisitDeps : OrdMap (List String) ->
  OrdMap CBind ->
  List String ->
  OrdMap Unit ->
  List CBind ->
  OrdMap Unit ->
  (OrdMap Unit, List CBind)
topoValVisitDeps _ _ [] done acc _ = (done, acc)
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
topoValVisitDeps rm bm (d :: rest) done acc visiting = match omLookup d bm
  Some db =>
    let (done2, acc2) = topoValVisit rm bm db done acc visiting
    topoValVisitDeps rm bm rest done2 acc2 visiting
  None => topoValVisitDeps rm bm rest done acc visiting

-- the value-global names a binding's rhs references EAGERLY (at init time) — i.e.
-- references NOT inside a lambda body — TRANSITIVELY through calls, are supplied by
-- `bindEagerReach` (backend.emit_support, Stage B of #553), which the sort consumes
-- via the `rm` reachability map above.  A `CLam` captures a global by reference and
-- resolves it only when the closure is later CALLED (at parse time, long after all
-- globals are initialised), so a name appearing only inside a lambda is NOT an
-- init-order dependency and `eagerVars` excludes it — which is why following EAGER
-- calls forges no false cycle between two combinator globals that reference each
-- other solely through their closures (`stmtsLoop = orElse stmtsCons (pure [])` ←
-- eager; `stmtsCons = do … stmtsLoop` ← back-ref inside a `do` closure, lazy).

-- #623: `findBind` (linear scan of `all`) and `intersectStr` (`contains` per
-- element against `names`) were the only two consumers of the topo sort's two
-- `List` views of the same bindings.  `bindNameMap` + `omHasKey`/`omLookup`
-- replace both, so they are gone.

-- the initial globals registry: every value binding's name registered
-- UNinitialised (`False`) with a placeholder LTy.  The `@main` init prologue flips
-- each to `(True, <its rhs LTy>)` in source order as it computes the rhs, so a
-- reference to a not-yet-computed global is caught as a forward/mutual dependency.
initGlobalsReg : List CBind -> List (String, (Bool, LTy))
initGlobalsReg [] = []
initGlobalsReg (b :: rest) = (bindName b, (False, LTInt)) :: initGlobalsReg rest

-- a fully-initialised globals registry: every value binding registered `True` with
-- a placeholder LTy.  The D4 gaps probe uses this so a function body referencing a
-- top-level value binding resolves to a global load (no spurious gap) — the probe
-- discards the emitted text, so the placeholder LTy is immaterial.
initGlobalsRegReady : List CBind -> List (String, (Bool, LTy))
initGlobalsRegReady [] = []
initGlobalsRegReady (b :: rest) =
  (bindName b, (True, LTInt)) :: initGlobalsRegReady rest

-- emit a zero-initialised module global `@mdk_g_<name> = global i64 0` for each
-- value binding (into the side buffer, like string-literal globals — LLVM module
-- item order is irrelevant).  The `@main` prologue stores each binding's computed
-- rhs word here; references anywhere load it back.
emitGlobalDecls : Emit -> List CBind -> Unit
emitGlobalDecls _ [] = ()
emitGlobalDecls e (b :: rest) =
  let _ = setScopeOfBind e (bindName b)
  -- PRELUDE half (issue #118): a top-level value's storage is DEFINED (and, in
  -- source order, INITIALISED) by `@mdk_program_main`, which lives in the program
  -- half — so prelude.o only declares it.  Defining it in both halves would be a
  -- duplicate symbol.
  let line =
    if e.input.emitHalf == emitHalfPrelude then
      "@mdk_g_" ++ bindName b ++ " = external global i64"
    else
      "@mdk_g_" ++ bindName b ++ " = global i64 0"
  let _ = emitGlobal e line
  -- #561 PR-A: a LAZY global also carries a per-global state flag @mdk_gs_<name>
  -- (0 UNFORCED / 1 FORCING / 2 FORCED).  The value cell stays a uniform i64.  In
  -- the PRELUDE half the flag is external (defined by the program half's force fn,
  -- alongside @mdk_g_*) and the force fn is declared so a prelude body can call it.
  let _ =
    if isLazyGlobal e (bindName b) then
      if e.input.emitHalf == emitHalfPrelude then
        let _ = emitGlobal e "@mdk_gs_\{bindName b} = external global i8"
        emitGlobal e "declare i64 @mdk_force_\{bindName b}()"
      else
        emitGlobal e "@mdk_gs_\{bindName b} = global i8 0"
  emitGlobalDecls e rest

-- ── function signature inference ──────────────────────────────────
-- Core IR is type-erased, so to lower a Bool/Float-typed function boundary we
-- must RECOVER the static type of each parameter and result.  `typeOf` is the
-- pure (non-emitting) twin of the type-recovery that `emitExpr` already does as
-- it emits — it computes a CExpr's LTy from the signature table + a var→LTy env,
-- with no side effects.  `inferSigs` runs it to a two-pass fixpoint so a callee's
-- signature is available before its caller's body is typed (one extra pass lets a
-- caller see a callee defined later / mutual recursion settle).
--
-- Float/Bool ride the EXISTING uniform i64 word (Float boxed, Bool immediate), so
-- inference changes no LLVM type — only which instructions the body emits and the
-- print routine `main` picks.  Param/return remain i64 at the ABI, so musttail's
-- prototype-match invariant is untouched.

-- structural type of an expression given known fn signatures + a var→type env.
-- Unknown vars (top-level value globals) default to Int — the slice's existing
-- assumption (function bodies referencing globals are out of scope anyway).
typeOf : OrdMap FnSig -> List (String, LTy) -> CExpr -> LTy
typeOf _ _ (CLit (LInt _)) = LTInt
typeOf _ _ (CLit (LFloat _)) = LTFloat
typeOf _ _ (CLit (LBool _)) = LTBool
typeOf _ _ (CLit (LString _)) = LTStr
typeOf _ _ (CLit (LChar _)) = LTChar
typeOf _ _ (CLit (LU64 _ _)) = LTU64
typeOf _ _ (CLit (LI64 _ _)) = LTI64
-- A list literal / range-list is a chain of Cons/Nil cells — a constructor
-- value (LTCon), NOT an Int.  Without this, the empty-list base clause of a
-- list-returning multi-clause fn (e.g. `externNames [] = []`) typed as LTInt, so
-- the fn's inferred return LTy was LTInt; a `++` on its result then fell to the
-- runtime-dispatch arm (default LTStr), and a CHAINED outer `++` saw LTStr and
-- statically emitted mdk_string_append on a List → memmove crash.  LTCon routes
-- the whole `++` chain through mdk_list_append correctly.
typeOf _ _ (CList _) = LTCon
typeOf _ _ (CRangeList _ _ _) = LTCon
typeOf _ env (CVar x _) = match lookupAssoc x env
  Some LTFloatU => LTFloat
  Some t => t
  None => LTInt
typeOf sigs env (CBinPrim op l r tag _)
  | isCmpOp op = LTBool
  | op == "::" = LTCon
  | isU64Head tag = LTU64
  | isI64Head tag = LTI64
  | otherwise = typeOf sigs env l
typeOf sigs env (CUnOp "-" x) = typeOf sigs env x
typeOf sigs env (CIf _ t _) = typeOf sigs env t
typeOf sigs env (CLet False (PVar x _) e1 e2) =
  typeOf sigs ((x, typeOf sigs env e1) :: env) e2
typeOf sigs env (CLetGroup binds body) =
  typeOf sigs (letGroupEnv sigs env binds) body
typeOf sigs env (CBlock stmts) = blockTy sigs env stmts
typeOf sigs env (CDecision _ arms _) = armsRetTy sigs env arms
-- A constrained-function or return-position-method occurrence (CDict/CMethod)
-- carries the SAME callee name as the bare CVar would; its emit path
-- (`emitDictApp`/`emitMethod`) types the result via `fnRetTy e name`, so the pure
-- twin must mirror that and route through `callRetTy sigs name` — not default to
-- LTInt.  Without this, a Unit-returning constrained stdlib fn called inside a
-- user fn (e.g. `f s = println s`, where `println : Display a => a -> <IO> Unit`
-- lowers `f`'s body to `CDict "println" …`) inferred `f`'s return as LTInt,
-- mis-printing `main`'s `()` result as `0` (construct-gap F1; layers on #2b's
-- LTUnit IO-extern fix).
typeOf sigs env app =
  let (hd, args) = flattenApp app []
  match hd
    CVar fname _ =>
      if fname == "$withFileReadBound"
        || fname == "$withFileWriteBound" then match args
        [_, CLam _ body] => typeOf sigs env body
        _ => LTInt
      else if hasArgs args then
        callRetTy sigs fname
      else
        LTInt
    CDict fname _ => callRetTy sigs fname
    CMethod fname _ _ _ _ _ => callRetTy sigs fname
    _ => LTInt

-- the return type of a known function from the sig table (Int if unknown).
-- the return type of a known function from the sig table (Int if unknown).
-- IO output externs (putStr/putStrLn/…) return Unit but are NOT user-fn binds,
-- so they are absent from `sigs` and would default to LTInt — typing a
-- Unit-returning wrapper (e.g. `println x = putStrLn (display x)`) as LTInt and
-- mis-rendering `main`'s result as `0` instead of `()` (Stage 3 #2b).  Resolve
-- them to LTUnit up front, matching the real emit path (`emitIoExtern`).
callRetTy : OrdMap FnSig -> String -> LTy
callRetTy sigs fname =
  if isIoExtern fname then
    LTUnit
  else match omLookup fname sigs
    Some (FnSig _ rty) => rty
    None => LTInt

-- a decision's result type is its first arm's body type (all arms agree —
-- well-typed match).  Pattern-bound vars are unknown to the pure pass, so a body
-- referencing them defaults via typeOf's CVar/None branch; the fixtures' arms are
-- Int-typed, matching the runtime-captured `rty`.
armsRetTy : OrdMap FnSig -> List (String, LTy) -> List CArm -> LTy
armsRetTy _ _ [] = LTInt
armsRetTy sigs env ((CArm _ _ body) :: _) = typeOf sigs env body

letGroupEnv : OrdMap FnSig ->
  List (String, LTy) ->
  List CBind ->
  List (String, LTy)
letGroupEnv _ env [] = env
letGroupEnv sigs env ((CBind name [CClause [] rhs] _) :: rest) =
  letGroupEnv sigs ((name, typeOf sigs env rhs) :: env) rest
letGroupEnv _ env _ = env

blockTy : OrdMap FnSig -> List (String, LTy) -> List CStmt -> LTy
blockTy sigs env [CSExpr ex] = typeOf sigs env ex
blockTy sigs env ((CSExpr _) :: rest) = blockTy sigs env rest
blockTy sigs env ((CSLet _ (PVar x _) ex) :: rest) =
  blockTy sigs ((x, typeOf sigs env ex) :: env) rest
-- a constructor / nested block-let (emitBlock now binds these): type its pattern
-- vars in blockTy's env so a tail expr that uses a bound field still recurses
-- (the old catch-all stopped at LTInt for the whole tail).  blockTy is pure, so
-- it cannot consult the (Mut) ctor field-type table — each var gets LTInt, the
-- same default the catch-all produced.  emitBlock's bindPattern applies the
-- precise declared scalar types at emit time; this only types the result lookup.
blockTy sigs env ((CSLet _ pat ex) :: rest) =
  blockTy sigs (patBindTys pat ++ env) rest
blockTy sigs env ((CSAssign x ex) :: rest) =
  blockTy sigs ((x, typeOf sigs env ex) :: env) rest
blockTy _ _ _ = LTInt

-- bind a non-PVar block-let pattern's vars for blockTy's env.  blockTy is pure,
-- so we cannot consult the (Mut) ctor field-type table; each var gets LTInt (the
-- same value the catch-all `blockTy _ _ _ = LTInt` produced for these lets).
patBindTys : Pat -> List (String, LTy)
patBindTys pat = mapVarLTInt (patVars pat)

mapVarLTInt : List String -> List (String, LTy)
mapVarLTInt [] = []
mapVarLTInt (x :: rest) = (x, LTInt) :: mapVarLTInt rest

-- infer one parameter's type from its first typed USE in the body: the condition
-- of an `if` or the operand of `!` forces Bool; an operand of an arithmetic/
-- comparison binop shares its SIBLING's type; an argument to a known function
-- takes that function's parameter type.  None ⇒ no determining use found (the
-- caller defaults it to Int).

-- infer the type of `p` given the OTHER operand of a binop.  For ARITHMETIC ops the
-- operand is provably numeric (`+`/`-`/`*`/`/`/`%`, not the String `++`/`::`), so
-- when the other operand does NOT pin a concrete Int/Float (e.g. `a + b` where both
-- are tuple-destructured vars with no type source — typeOf DEFAULTS them to LTInt and
-- emits INTEGER arith on boxed-float pointers → garbage) fall back to LTNum, whose
-- arith/print route through the runtime tag-dispatched @mdk_num_* helpers (correct
-- for Int AND Float).  When the other operand DOES pin a concrete numeric type (a
-- literal, an env-typed var) use it — so int-literal-anchored arith (`a + 1`) keeps
-- its inline fast path.  Non-arith ops keep the historical `typeOf other` (a
-- comparison var has the same type as what it is compared to).
binOperandTy : OrdMap FnSig -> List (String, LTy) -> String -> CExpr -> LTy
binOperandTy sigs env op other =
  if isArithOp op then match concreteNumTy sigs env other
    Some t => t
    None => LTNum
  else
    typeOf sigs env other

-- Some (concrete numeric LTy) when `e` is DEFINITELY typed; None when its type would
-- only be a guess (a bare var absent from env, a call result) — mirrors typeOf but
-- treats typeOf's LTInt-default as "unknown" so binOperandTy can pick LTNum instead.
concreteNumTy : OrdMap FnSig -> List (String, LTy) -> CExpr -> Option LTy
concreteNumTy _ _ (CLit (LInt _)) = Some LTInt
concreteNumTy _ _ (CLit (LFloat _)) = Some LTFloat
concreteNumTy _ _ (CLit (LU64 _ _)) = Some LTU64
concreteNumTy _ _ (CLit (LI64 _ _)) = Some LTI64
concreteNumTy sigs env (CUnOp "-" x) = concreteNumTy sigs env x
concreteNumTy _ env (CVar x _) = match lookupAssoc x env
  Some LTFloatU => Some LTFloat
  Some t => Some t
  None => None
concreteNumTy sigs env (CBinPrim op l r tag _) =
  if isArithOp op && isU64Head tag then
    Some LTU64
  else if isArithOp op && isI64Head tag then
    Some LTI64
  else if isArithOp op then
    firstSome (concreteNumTy sigs env l) (concreteNumTy sigs env r)
  else
    None
concreteNumTy _ _ _ = None

paramUseTy : OrdMap FnSig -> List (String, LTy) -> String -> CExpr -> Option LTy
paramUseTy sigs env p (CIf c t f) =
  if isVarNamed p c then
    Some LTBool
  else
    firstSome (paramUseTy sigs env p t) (paramUseTy sigs env p f)
paramUseTy sigs env p (CUnOp _ x) = paramUseTy sigs env p x
-- `::` is NOT a symmetric binop: in `l :: r`, l is the ELEMENT and r is the
-- `List element` — their LTys differ.  So a var on the LEFT of `::` cannot take
-- the right operand's (list) type; doing so mistypes a String accumulator as
-- LTCon (e.g. `acc :: …` in splitLines), routing its OTHER `++` use to
-- mdk_list_append on a String → crash.  Skip the element side; a var on the
-- right of `::` is a list (LTCon).
paramUseTy sigs env p (CBinPrim "::" l r _ _) =
  if isVarNamed p r then
    Some LTCon
  else
    firstSome (paramUseTy sigs env p l) (paramUseTy sigs env p r)
paramUseTy sigs env p (CBinPrim op l r _ _) =
  if isVarNamed p l then
    Some (binOperandTy sigs env op r)
  else if isVarNamed p r then
    Some (binOperandTy sigs env op l)
  else
    firstSome (paramUseTy sigs env p l) (paramUseTy sigs env p r)
paramUseTy sigs env p (CLet _ _ e1 e2) =
  firstSome (paramUseTy sigs env p e1) (paramUseTy sigs env p e2)
-- scan a block's statements for a determining use of `p` (a tuple/pattern-destructure
-- in a block passes its continuation here as `CBlock rest` so the bound var's type
-- can be inferred from later uses, not a dummy `0`).
paramUseTy sigs env p (CBlock stmts) = paramUseStmts sigs env p stmts
paramUseTy sigs env p (CDecision scrut arms _tree) =
  firstSome (paramUseTy sigs env p scrut) (paramUseArms sigs env p arms)
paramUseTy sigs env p (CLam _ body) = paramUseTy sigs env p body
paramUseTy sigs env p app =
  let (hd, args) = flattenApp app []
  match hd
    CVar fname _ =>
      if hasArgs args then
        firstSome
          (argPosTy sigs env p fname args 0)
          (paramUseArgs sigs env p args)
      else
        None
    _ => paramUseArgs sigs env p args

-- if `p` is passed as the Nth argument to a known function, its type is that
-- function's Nth parameter type.
argPosTy : OrdMap FnSig ->
  List (String, LTy) ->
  String ->
  String ->
  List CExpr ->
  Int ->
  Option LTy
argPosTy _ _ _ _ [] _ = None
argPosTy sigs env p fname (a :: rest) i =
  if isVarNamed p a then
    nthParamTy sigs fname i
  else
    argPosTy sigs env p fname rest (i + 1)

-- the type of the Nth parameter of a known function (None if unknown).
nthParamTy : OrdMap FnSig -> String -> Int -> Option LTy
nthParamTy sigs fname i = match omLookup fname sigs
  Some (FnSig ptys _) => nthTy ptys i
  None => None

nthTy : List LTy -> Int -> Option LTy
nthTy [] _ = None
nthTy (t :: _) 0 = Some t
nthTy (_ :: rest) i = nthTy rest (i - 1)

paramUseArgs : OrdMap FnSig ->
  List (String, LTy) ->
  String ->
  List CExpr ->
  Option LTy
paramUseArgs _ _ _ [] = None
paramUseArgs sigs env p (a :: rest) =
  firstSome (paramUseTy sigs env p a) (paramUseArgs sigs env p rest)

-- scan block statements for a determining use of `p` in any statement's expression
-- (CSExpr / CSLet rhs); unknown statement shapes are skipped.
paramUseStmts : OrdMap FnSig ->
  List (String, LTy) ->
  String ->
  List CStmt ->
  Option LTy
paramUseStmts _ _ _ [] = None
paramUseStmts sigs env p ((CSExpr ex) :: rest) =
  firstSome (paramUseTy sigs env p ex) (paramUseStmts sigs env p rest)
paramUseStmts sigs env p ((CSLet _ _ ex) :: rest) =
  firstSome (paramUseTy sigs env p ex) (paramUseStmts sigs env p rest)
paramUseStmts sigs env p (_ :: rest) = paramUseStmts sigs env p rest

-- scan a CDecision's arms for a determining use of `p` in a guard or the arm body.
paramUseArms : OrdMap FnSig ->
  List (String, LTy) ->
  String ->
  List CArm ->
  Option LTy
paramUseArms _ _ _ [] = None
paramUseArms sigs env p ((CArm _ guards body) :: rest) =
  firstSome
    (firstSome (paramUseGuards sigs env p guards) (paramUseTy sigs env p body))
    (paramUseArms sigs env p rest)

paramUseGuards : OrdMap FnSig ->
  List (String, LTy) ->
  String ->
  List CGuard ->
  Option LTy
paramUseGuards _ _ _ [] = None
paramUseGuards sigs env p ((CGBool e) :: rest) =
  firstSome (paramUseTy sigs env p e) (paramUseGuards sigs env p rest)
paramUseGuards sigs env p ((CGBind _ e) :: rest) =
  firstSome (paramUseTy sigs env p e) (paramUseGuards sigs env p rest)

isVarNamed : String -> CExpr -> Bool
isVarNamed p (CVar x _) = p == x
isVarNamed _ _ = False

firstSome : Option a -> Option a -> Option a
firstSome (Some x) _ = Some x
firstSome None y = y

-- infer one function's full signature against the current (partial) sig table.
inferOneSig : OrdMap FnSig -> Option (List String, String) -> CBind -> FnSig
inferOneSig sigs dsig (CBind _ [CClause pats body] _) =
  let ptys = inferParamTysSeed sigs dsig pats body 0
  let env = zipParamEnv pats ptys
  FnSig ptys (seedRetTy dsig (typeOf sigs env body))
inferOneSig sigs dsig (CBind _ (c :: rest) _) =
  inferMultiSig sigs dsig (c :: rest)
inferOneSig _ _ _ = FnSig [] LTInt

-- E1: a DECLARED scalar param/return type (from EmitInput, sourced from
-- the fn's `DTypeSig`) WINS over the body-use guess.  `seedParamTy` overrides the
-- i-th inferred param type with its declared scalar LTy when one is known (else
-- keeps the guess); `seedRetTy` likewise for the return.  ADDITIVE: an
-- unannotated fn (`dsig = None`) or a non-scalar declared type leaves the guess
-- untouched, so literal-anchored Float fns and Int fns are unchanged.
seedParamTy : Option (List String, String) -> Int -> LTy -> LTy
seedParamTy (Some (ptyNames, _)) i guessed = match declScalarAt ptyNames i
  Some t => t
  None => guessed
seedParamTy None i guessed = guessed

seedRetTy : Option (List String, String) -> LTy -> LTy
seedRetTy (Some (_, retName)) guessed = match fieldNameToLTy retName
  Some t => t
  None => guessed
seedRetTy None guessed = guessed

-- the declared scalar LTy at param index `i` of a declared param-type-head list,
-- or None when out of range / not a known scalar.
declScalarAt : List String -> Int -> Option LTy
declScalarAt names i = match nthName names i
  Some n => fieldNameToLTy n
  None => None

-- E1a: signature inference for a MULTI-CLAUSE binding.  A param's type is the
-- first type-revealing finding scanning clauses left-to-right (a literal pattern
-- names it directly; a plain-var pattern is inferred from that clause's body use
-- via `paramUseTy`; a constructor/tuple/wild pattern is an i64 word, left to
-- default Int).  The return type is the first clause's body typed under its
-- param env.  Without this, a multi-clause fn fell to `FnSig [] LTInt`, so its
-- non-Int params (`implParamEnvTyped`) and non-Int result (`fnRetTy` → print
-- selection) were both lost.  (Gap E1: a declared scalar param/return seeds over
-- the guess via `seedParamTy`/`seedRetTy`.)
inferMultiSig : OrdMap FnSig ->
  Option (List String, String) ->
  List CClause ->
  FnSig
inferMultiSig sigs dsig clauses =
  let arity = clauseArityC clauses
  let ptys = inferMultiParamTys sigs dsig clauses arity 0
  FnSig ptys (seedRetTy dsig (inferMultiRetTy sigs clauses ptys))

clauseArityC : List CClause -> Int
clauseArityC ((CClause pats _) :: _) = listLen pats
clauseArityC [] = 0

inferMultiParamTys : OrdMap FnSig ->
  Option (List String, String) ->
  List CClause ->
  Int ->
  Int ->
  List LTy
inferMultiParamTys sigs dsig clauses arity i
  | i >= arity = []
  | otherwise =
    seedParamTy dsig i (paramTyAcross sigs clauses i)
      :: inferMultiParamTys sigs dsig clauses arity (i + 1)

-- the i-th param's type: the first informative finding across clauses, else Int.
paramTyAcross : OrdMap FnSig -> List CClause -> Int -> LTy
paramTyAcross sigs clauses i = match firstInformative sigs clauses i
  Some t => t
  None => LTInt

firstInformative : OrdMap FnSig -> List CClause -> Int -> Option LTy
firstInformative _ [] _ = None
firstInformative sigs ((CClause pats body) :: rest) i =
  firstSome (clausePatTy sigs pats body i) (firstInformative sigs rest i)

-- one clause's contribution to the i-th param type: a plain var is inferred from
-- its body use; a literal pattern carries its literal type; a ctor/tuple/wild
-- pattern is uninformative (an i64 word, defaulted to Int by the caller).
clausePatTy : OrdMap FnSig -> List Pat -> CExpr -> Int -> Option LTy
clausePatTy sigs pats body i = match nthPat pats i
  Some (PVar x _) => paramUseTy sigs [] x body
  Some (PLit l) => Some (litTy l)
  _ => None

litTy : Lit -> LTy
litTy (LInt _) = LTInt
litTy (LFloat _) = LTFloat
litTy (LBool _) = LTBool
litTy (LString _) = LTStr
litTy (LChar _) = LTChar
litTy (LU64 _ _) = LTU64
litTy (LI64 _ _) = LTI64
litTy LUnit = LTInt

nthPat : List Pat -> Int -> Option Pat
nthPat (p :: _) 0 = Some p
nthPat (_ :: rest) i = nthPat rest (i - 1)
nthPat [] _ = None

-- the multi-clause return type: the first clause's body typed under that clause's
-- (var-pattern → inferred-param-type) env.
inferMultiRetTy : OrdMap FnSig -> List CClause -> List LTy -> LTy
inferMultiRetTy sigs ((CClause pats body) :: _) ptys =
  typeOf sigs (zipParamEnv pats ptys) body
inferMultiRetTy _ [] _ = LTInt

inferParamTys : OrdMap FnSig -> List Pat -> CExpr -> List LTy
inferParamTys _ [] _ = []
inferParamTys sigs pats body
  | isArithSectionLam pats body = mapConst LTNum pats
inferParamTys sigs ((PVar x _) :: rest) body =
  let ty = match paramUseTy sigs [] x body
    Some t => t
    None => LTInt
  ty :: inferParamTys sigs rest body
inferParamTys sigs (_ :: rest) body = LTInt :: inferParamTys sigs rest body

-- G9: an operator-SECTION lambda — `\_a _b => _a OP _b` for an arithmetic OP,
-- the desugaring of a bare arithmetic section `(+)`/`(*)`/… (desugar.mdk
-- `sectionToCore (SecBare op)`).  Such a section flows as a first-class function
-- value (`fold (+) seed xs`), so it is POLYMORPHIC over `Num` — neither
-- statically Int nor Float.  Its two params carry no declared sig and no Float
-- literal anchor, so the default LTInt path would emit integer `add`/`mul`,
-- which is WRONG when the section is applied at Float (untags a boxed Float
-- pointer → garbage/SIGSEGV).  Seeding LTNum routes the body through the runtime
-- tag-dispatched @mdk_num_* helper (low-bit Int/Float discriminator), correct for
-- BOTH (Int: low-bit immediate → int op, byte-identical value to the old int
-- path; Float: boxed → float op).  Shape is EXACT: body is a single CBinPrim of
-- an arith op over the two params in order, so only the genuine section lambda is
-- affected — a lambda doing other work keeps its per-param inference.
isArithSectionLam : List Pat -> CExpr -> Bool
isArithSectionLam [PVar a _, PVar b _] (CBinPrim op (CVar la _) (CVar rb _) _ _) =
  isArithOp op && la == a && rb == b
isArithSectionLam _ _ = False

mapConst : a -> List b -> List a
mapConst _ [] = []
mapConst v (_ :: rest) = v :: mapConst v rest

-- like inferParamTys, but a DECLARED scalar type at param index `i` seeds (wins)
-- over the body-use guess (Gap E1: `double x = x + x : Float -> Float` has no
-- Float literal anchor, so the guess is LTInt → int arith on a boxed Float;
-- the declared `Float` overrides to LTFloat).  Index-tracked so each param's
-- declared type lines up by position.
inferParamTysSeed : OrdMap FnSig ->
  Option (List String, String) ->
  List Pat ->
  CExpr ->
  Int ->
  List LTy
inferParamTysSeed sigs dsig pats body i =
  inferParamTysSeedD sigs dsig pats body i i

-- like inferParamTysSeed, but tracks the DECLARED-param index `di` separately from
-- the emit/IR position `i`.  A dict-passing param (`$dict_<fn>_<slot>`, prepended
-- by elaborateModules to a `=>`-constrained fn) advances `i` but NOT `di`, so the
-- declared signature's param types — which DON'T include the synthesized dict
-- params — stay aligned to the source params.  Without this, a `Num a =>` fn's
-- real param sits one slot right of where `declScalarAt`/`isNumPolyParam` look
-- (the G3 root cause: x's LTNum seed was read at the dict's index → missed).
inferParamTysSeedD : OrdMap FnSig ->
  Option (List String, String) ->
  List Pat ->
  CExpr ->
  Int ->
  Int ->
  List LTy
inferParamTysSeedD _ _ [] _ _ _ = []
inferParamTysSeedD sigs dsig ((PVar x _) :: rest) body i di
  | isDictParamName x =
    LTInt :: inferParamTysSeedD sigs dsig rest body (i + 1) di
  | otherwise =
    let guessed = match paramUseTy sigs [] x body
      Some t => t
      None => LTInt
    let seeded = seedParamTy dsig di guessed
    let final = numPolySeed dsig di seeded (paramUsedInArith x body)
    final :: inferParamTysSeedD sigs dsig rest body (i + 1) (di + 1)
-- G3: a param whose DECLARED type head is a type variable (`a` in
-- `double : Num a => a -> a`) and which is USED arithmetically is polymorphic
-- over Num — neither statically Int nor Float.  Seed LTNum so emitArith/emitPrint
-- route through the runtime tag-dispatched @mdk_num_* helpers.  A concrete
-- declared scalar (Int/Float/…) still wins via seedParamTy; a type-var param
-- NOT used in arithmetic (e.g. `id : a -> a`) keeps its guess (no LTNum).

inferParamTysSeedD sigs dsig (_ :: rest) body i di =
  seedParamTy dsig di LTInt
    :: inferParamTysSeedD sigs dsig rest body (i + 1) (di + 1)

-- G3: override a type-var param's LTInt seed with LTNum when it's used in
-- arithmetic (a polymorphic Num operand); otherwise keep the seed unchanged.
numPolySeed : Option (List String, String) -> Int -> LTy -> Bool -> LTy
numPolySeed dsig i seeded usedArith
  | isNumPolyParam dsig i seeded && usedArith = LTNum
  | otherwise = seeded

-- G3: True when param index `i`'s declared type head is a type VARIABLE (a
-- lowercase-initial name like `a` — concrete cons are uppercase) and the
-- seedParamTy result is still LTInt (i.e. no concrete scalar declared/inferred).
-- This is the "polymorphic Num operand" signal.
isNumPolyParam : Option (List String, String) -> Int -> LTy -> Bool
isNumPolyParam (Some (ptyNames, _)) i LTInt = match nthName ptyNames i
  Some n => isTypeVarName n
  None => False
isNumPolyParam None i LTInt = True
isNumPolyParam dsig i _ = False

-- a type-variable head name is lowercase-initial (`a`, `elem`); a concrete type
-- (`Int`, `Float`, a user type) is uppercase-initial.  Empty ⇒ not a var.
isTypeVarName : String -> Bool
isTypeVarName n =
  let cs = stringToChars n
  numVarFirst cs

numVarFirst : Array Char -> Bool
numVarFirst cs
  | arrayLength cs == 0 = False
  | otherwise = isLowerCode (charCode (arrayGetUnsafe 0 cs))

isLowerCode : Int -> Bool
isLowerCode c = c >= 97 && c <= 122

-- G3: True when `p` is an operand of an arithmetic binop anywhere in the body.
paramUsedInArith : String -> CExpr -> Bool
paramUsedInArith p (CBinPrim op l r _ _) =
  if isArithOp op && (isVarNamed p l || isVarNamed p r) then
    True
  else
    paramUsedInArith p l || paramUsedInArith p r
paramUsedInArith p (CIf c t f) =
  paramUsedInArith p c || paramUsedInArith p t || paramUsedInArith p f
paramUsedInArith p (CUnOp _ x) = paramUsedInArith p x
paramUsedInArith p (CLet _ _ e1 e2) =
  paramUsedInArith p e1 || paramUsedInArith p e2
paramUsedInArith p (CDecision scrut arms _tree) =
  paramUsedInArith p scrut || anyArithArm p arms
paramUsedInArith p (CLam _ body) = paramUsedInArith p body
paramUsedInArith p app =
  let (_, args) = flattenApp app []
  anyArithArg p args
paramUsedInArith _ _ = False

anyArithArg : String -> List CExpr -> Bool
anyArithArg _ [] = False
anyArithArg p (a :: rest) = paramUsedInArith p a || anyArithArg p rest

anyArithArm : String -> List CArm -> Bool
anyArithArm _ [] = False
anyArithArm p ((CArm _ guards body) :: rest) =
  paramUsedInArith p body || anyArithGuard p guards || anyArithArm p rest

anyArithGuard : String -> List CGuard -> Bool
anyArithGuard _ [] = False
anyArithGuard p ((CGBool e) :: rest) =
  paramUsedInArith p e || anyArithGuard p rest
anyArithGuard p ((CGBind _ e) :: rest) =
  paramUsedInArith p e || anyArithGuard p rest

zipParamEnv : List Pat -> List LTy -> List (String, LTy)
zipParamEnv ((PVar x _) :: ps) (t :: ts) = (x, t) :: zipParamEnv ps ts
zipParamEnv (_ :: ps) (_ :: ts) = zipParamEnv ps ts
zipParamEnv _ _ = []

-- one inference pass: recompute every function's signature using the prior table.
-- (Gap E1: each binding's DECLARED signature, looked up by name in the installed
-- declared-signature index, seeds its param/return types over the body-use guess.)
inferPass : OrdMap (List String, String) ->
  OrdMap FnSig ->
  List CBind ->
  List (String, FnSig)
inferPass _ _ [] = []
inferPass decls sigs (b :: rest) =
  (bindName b, inferOneSig sigs (omLookup (bindName b) decls) b)
    :: inferPass decls sigs rest

-- fixpoint to two passes: pass 1 seeds signatures (callees defined earlier are
-- already typed); pass 2 lets a caller see a callee defined later / mutual
-- recursion settle.  Two passes suffice for the spike's call graphs (no deeper
-- type-flow chains than caller→callee→sibling exist in the subset).
inferSigs : OrdMap (List String, String) -> List CBind -> List (String, FnSig)
inferSigs decls fns =
  let pass1 = inferPass decls omEmpty fns
  inferPass decls (sigsToMap pass1) fns

-- ── operator -> LLVM mnemonic tables ────────────────────────────────────────
intOp : String -> String
intOp "+" = "add"
intOp "-" = "sub"
intOp "*" = "mul"
intOp "/" = "sdiv"  -- OCaml `/` truncates toward zero; sdiv matches
intOp "%" = "srem"  -- OCaml `mod` sign-of-dividend; srem matches
intOp op = panic ("llvm: unsupported int operator " ++ op)

floatOp : String -> String
floatOp "+" = "fadd"
floatOp "-" = "fsub"
floatOp "*" = "fmul"
floatOp "/" = "fdiv"
floatOp "%" = "frem"  -- OCaml Float.rem == C fmod == LLVM frem
floatOp op = panic ("llvm: unsupported float operator " ++ op)

-- G3: the runtime tag-dispatched numeric helper for a POLYMORPHIC Num operand
-- (mdk_num_* branch on the low bit: Int → int op, boxed Float → float op).
numOp : String -> String
numOp "+" = "mdk_num_add"
numOp "-" = "mdk_num_sub"
numOp "*" = "mdk_num_mul"
numOp "/" = "mdk_num_div"
numOp "%" = "mdk_num_mod"
numOp op = panic ("llvm: unsupported num operator " ++ op)

intPred : String -> String
intPred "==" = "eq"
intPred "/=" = "ne"
intPred "<" = "slt"
intPred ">" = "sgt"
intPred "<=" = "sle"
intPred ">=" = "sge"
intPred op = panic ("llvm: unsupported comparison " ++ op)

-- IEEE-754 comparison predicates (issue #285).  `==`/`<`/`>`/`<=`/`>=` are all
-- ORDERED (`o*`): every relational comparison against NaN is false, which is
-- correct IEEE semantics.  `/=` is the LONE exception — `a /= b` must be TRUE
-- when either operand is NaN — so it needs the UNORDERED-or-not-equal predicate
-- `une`, not the ordered `one` (which is false for NaN and would break both IEEE
-- and the identity `(a /= b) == not (a == b)`).  Matches eval and the wasm backend's
-- `f64.ne` (also une-equivalent).
floatPred : String -> String
floatPred "==" = "oeq"
floatPred "/=" = "une"
floatPred "<" = "olt"
floatPred ">" = "ogt"
floatPred "<=" = "ole"
floatPred ">=" = "oge"
floatPred op = panic ("llvm: unsupported comparison " ++ op)

isCmpOp : String -> Bool
isCmpOp op =
  op == "==" || op == "/=" || op == "<" || op == ">" || op == "<=" || op == ">="

-- ── records, tuples, and mutable refs ────────────────────────────

emitTuple : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitTuple e env es =
  let words = emitArgs e env es
  if allConstWords words then
    (emitConstDictCell e (cellTag e "$tuple") words, LTCon)
  else
    emitCtorAlloc e "$tuple" words

emitRecordCreate : Emit ->
  OrdMap (String, LTy) ->
  String ->
  List CField ->
  (String, LTy)
emitRecordCreate e env name fields =
  let words = emitFieldExprs e env fields
  if allConstWords words then
    (emitConstDictCell e (cellTag e name) words, LTCon)
  else
    emitCtorAlloc e name words

emitFieldAccess : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  String ->
  String ->
  (String, LTy)
emitFieldAccess e env ex label recName =
  let (w, _) = emitExpr e env ex
  if label == "value" then
    let f = loadField e w 0
    (f, LTInt)
  else
    let idx = fieldIdxByName e recName label
    let f = loadField e w idx
    (f, LTInt)

-- Resolve a field's positional index by the typecheck-stamped record name when
-- known (recName ≠ "" and that record actually has the label); otherwise fall
-- back to today's label-only search (safety for unstamped / synthesized
-- accesses).  The by-name path is what makes two records sharing a field name at
-- DIFFERENT indices resolve to the correct offset.
-- #352: takes the `Emit` (not the raw table) so the by-name probe can go through the
-- installed index; same answers, same fallbacks.
fieldIdxByName : Emit -> String -> String -> Int
fieldIdxByName e recName label =
  if recName == "" then
    findFieldIdx e label
  else match recFieldsOfName e recName
    Some labels => match indexOfStr label labels
      Some i => i
      None => findFieldIdx e label
    None => findFieldIdx e label

emitRecordUpdate : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  List CField ->
  (String, LTy)
emitRecordUpdate e env recName base updates =
  let (bw, _) = emitExpr e env base
  let firstLabel = cFieldFirstLabel updates
  match recordByName e recName firstLabel
    None =>
      gapE
        e
        ("CRecordUpdate: unknown record type for field '" ++ firstLabel ++ "'")
    Some (name, labels) =>
      let updatePairs = emitUpdatePairs e env updates
      let words = buildUpdateWords e bw labels updatePairs 0
      emitCtorAlloc e name words

-- Resolve the RECEIVER record of an update by the typecheck-stamped record name
-- (CRecordUpdate's 1st field) when it is usable — non-empty, present in the
-- field-order table, and actually owning the update label — else fall back to
-- today's label-only search (unstamped / synthesized updates).  The by-name path
-- is what makes two records that share a field name at DIFFERENT slot indices
-- update the correct slot; the label-only guess silently wrote the other
-- record's slot (bug #38).  Peer of fieldIdxByName on the access path.
recordByName : Emit -> String -> String -> Option (String, List String)
recordByName e recName label =
  if recName == "" then
    findRecordByLabel e label
  else match recFieldsOfName e recName
    Some labels => match indexOfStr label labels
      Some _ => Some (recName, labels)
      None => findRecordByLabel e label
    None => findRecordByLabel e label

emitVariantUpdate : Emit ->
  OrdMap (String, LTy) ->
  String ->
  CExpr ->
  List CField ->
  (String, LTy)
emitVariantUpdate e env con base updates =
  let (bw, _) = emitExpr e env base
  match recFieldsOfName e con
    None =>
      gapE
        e
        ("CVariantUpdate: unknown variant type for constructor '" ++ con ++ "'")
    Some labels =>
      let updatePairs = emitUpdatePairs e env updates
      let words = buildUpdateWords e bw labels updatePairs 0
      emitCtorAlloc e con words

emitRefAlloc : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitRefAlloc e env [x] =
  let (xw, _) = emitExpr e env x
  emitCtorAlloc e "$ref" [xw]
emitRefAlloc e env _ = gapE e "Ref expects exactly 1 argument"

emitSetRef : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitSetRef e env [r, x] =
  let (rw, _) = emitExpr e env r
  let (xw, _) = emitExpr e env x
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{rw} to ptr"
  let fp = freshReg e
  let _ = emit e "  \{fp} = getelementptr i8, ptr \{p}, i64 8"
  let _ = emit e "  store i64 \{xw}, ptr \{fp}"
  ("1", LTInt)
emitSetRef e env _ = gapE e "setRef expects exactly 2 arguments"

emitFieldExprs : Emit -> OrdMap (String, LTy) -> List CField -> List String
emitFieldExprs _ _ [] = []
emitFieldExprs e env ((CField _ ex) :: rest) =
  let (w, _) = emitExpr e env ex
  w :: emitFieldExprs e env rest

emitUpdatePairs : Emit ->
  OrdMap (String, LTy) ->
  List CField ->
  List (String, String)
emitUpdatePairs _ _ [] = []
emitUpdatePairs e env ((CField k ex) :: rest) =
  let (w, _) = emitExpr e env ex
  (k, w) :: emitUpdatePairs e env rest

buildUpdateWords : Emit ->
  String ->
  List String ->
  List (String, String) ->
  Int ->
  List String
buildUpdateWords _ _ [] _ _ = []
buildUpdateWords e bw (label :: rest) updates i =
  let w = match lookupAssoc label updates
    Some newWord => newWord
    None => loadField e bw i
  w :: buildUpdateWords e bw rest updates (i + 1)

cFieldFirstLabel : List CField -> String
cFieldFirstLabel [] = panic "llvm: CRecordUpdate: empty update list"
cFieldFirstLabel ((CField k _) :: _) = k

cFieldLabels : List CField -> List String
cFieldLabels [] = []
cFieldLabels ((CField k _) :: rest) = k :: cFieldLabels rest

cFieldExprs : List CField -> List CExpr
cFieldExprs [] = []
cFieldExprs ((CField _ ex) :: rest) = ex :: cFieldExprs rest

findFieldIdx : Emit -> String -> Int
findFieldIdx e label = match findRecordByLabel e label
  Some (_, labels) => match indexOfStr label labels
    Some i => i
    None =>
      panic
        ("llvm: field '" ++ label ++ "' not found in record (internal error)")
  None => panic ("llvm: CFieldAccess: unknown field '" ++ label ++ "'")

-- #352: index-backed — `e.recByLabel` already holds, per label, the FIRST record in
-- table order that owns it, which is exactly what a first-match scan returns.
-- RUN-EMIT-003: that scan (`findRecordByLabelIn`) is RETIRED — the index is the
-- only path, and an uninstalled read is a broken invariant.
findRecordByLabel : Emit -> String -> Option (String, List String)
findRecordByLabel e label = match !e.recByLabel
  Some m => omLookup label m
  None => panic "llvm: recByLabel read before install (internal error)"

indexOfStr : String -> List String -> Option Int
indexOfStr _ [] = None
indexOfStr x (y :: rest) =
  if x == y then Some 0 else map (+ 1) (indexOfStr x rest)

collectRecords : List CBind -> List (String, List String)
collectRecords [] = []
collectRecords ((CBind _ clauses _) :: rest) =
  collectRecordsClauses clauses ++ collectRecords rest

collectRecordsClauses : List CClause -> List (String, List String)
collectRecordsClauses [] = []
collectRecordsClauses ((CClause _ body) :: rest) =
  scanExprRecords body ++ collectRecordsClauses rest

scanExprRecords : CExpr -> List (String, List String)
scanExprRecords (CRecord name fields) =
  (name, cFieldLabels fields) :: scanExprsRecords (cFieldExprs fields)
scanExprRecords (CFieldAccess ex _ _) = scanExprRecords ex
scanExprRecords (CRecordUpdate _ base updates) =
  scanExprRecords base ++ scanExprsRecords (cFieldExprs updates)
scanExprRecords (CVariantUpdate _ base updates) =
  scanExprRecords base ++ scanExprsRecords (cFieldExprs updates)
scanExprRecords (CTuple es) = scanExprsRecords es
scanExprRecords (CApp f a) = scanExprRecords f ++ scanExprRecords a
scanExprRecords (CLam _ body) = scanExprRecords body
scanExprRecords (CIf c t f) =
  scanExprRecords c ++ scanExprRecords t ++ scanExprRecords f
scanExprRecords (CBinPrim _ l r _ _) = scanExprRecords l ++ scanExprRecords r
scanExprRecords (CUnOp _ x) = scanExprRecords x
scanExprRecords (CLet _ _ e1 e2) = scanExprRecords e1 ++ scanExprRecords e2
scanExprRecords (CLetGroup binds body) =
  collectRecords binds ++ scanExprRecords body
scanExprRecords (CBlock stmts) = scanStmtsRecords stmts
scanExprRecords (CDecision scrut arms _) =
  scanExprRecords scrut ++ scanArmsRecords arms
scanExprRecords (CMatch scrut arms) =
  scanExprRecords scrut ++ scanArmsRecords arms
scanExprRecords (CArray es) = scanExprsRecords es
scanExprRecords (CList es) = scanExprsRecords es
scanExprRecords (CRangeArray lo hi _) = scanExprRecords lo ++ scanExprRecords hi
scanExprRecords (CRangeList lo hi _) = scanExprRecords lo ++ scanExprRecords hi
scanExprRecords (CIndex a i) = scanExprRecords a ++ scanExprRecords i
scanExprRecords (CStringIndex a i) = scanExprRecords a ++ scanExprRecords i
scanExprRecords (CStringSlice a lo hi _) =
  scanExprRecords a ++ scanExprRecords lo ++ scanExprRecords hi
scanExprRecords (CListIndex a i) = scanExprRecords a ++ scanExprRecords i
scanExprRecords (CListSlice a lo hi _) =
  scanExprRecords a ++ scanExprRecords lo ++ scanExprRecords hi
scanExprRecords (CSlice a lo hi _) =
  scanExprRecords a ++ scanExprRecords lo ++ scanExprRecords hi
scanExprRecords _ = []

scanExprsRecords : List CExpr -> List (String, List String)
scanExprsRecords [] = []
scanExprsRecords (e :: rest) = scanExprRecords e ++ scanExprsRecords rest

-- The fallback scan is a BEST EFFORT, not the authority (see the table comment):
-- guard qualifiers and the string-slice bounds are walked because a construction
-- site living there is otherwise invisible, but correctness rests on the
-- declaration seed, not on this walk being complete.
scanArmsRecords : List CArm -> List (String, List String)
scanArmsRecords [] = []
scanArmsRecords ((CArm _ guards body) :: rest) =
  scanGuardsRecords guards ++ scanExprRecords body ++ scanArmsRecords rest

scanGuardsRecords : List CGuard -> List (String, List String)
scanGuardsRecords [] = []
scanGuardsRecords ((CGBool ex) :: rest) =
  scanExprRecords ex ++ scanGuardsRecords rest
scanGuardsRecords ((CGBind _ ex) :: rest) =
  scanExprRecords ex ++ scanGuardsRecords rest

scanStmtsRecords : List CStmt -> List (String, List String)
scanStmtsRecords [] = []
scanStmtsRecords ((CSExpr ex) :: rest) =
  scanExprRecords ex ++ scanStmtsRecords rest
scanStmtsRecords ((CSLet _ _ ex) :: rest) =
  scanExprRecords ex ++ scanStmtsRecords rest
scanStmtsRecords ((CSAssign _ ex) :: rest) =
  scanExprRecords ex ++ scanStmtsRecords rest
scanStmtsRecords (_ :: rest) = scanStmtsRecords rest

-- ── arrays + ranges ────────────────────────────────────────────────
-- VALUE REPRESENTATION (RUNTIME-DESIGN.md §8 — see also §2.4a-5 in STAGE2-DESIGN.md):
-- an array is a BOXED heap cell with the same layout as an ADT cell but with the
-- header word = the raw element count (not a constructor hash):
--   [ 0: i64 raw_len | 8: elem0 | 16: elem1 … ]
-- `loadTag` thus reads the raw element count; `loadField e w i` reads element i
-- (at offset 8*(i+1)), exactly the ADT field convention.  Allocation reuses
-- @mdk_alloc; element words are uniform i64 (tagged Ints for range elements).
-- BOUNDS CHECKS: an OOB index calls @mdk_oob(), an OOB slice @mdk_slice_oob(lo, hi)
-- (both noreturn; print + exit, matching eval's panic).  CSlice's check is #550 — it
-- was missing entirely, which made an over-range slice an out-of-bounds HEAP READ
-- rather than a diagnostic; see emitArraySlice.
-- LOOPS: CRangeArray and CSlice use an alloca-counter loop (the first non-recursion
-- loop in the spike — avoids phi instructions and matches the alloca/store/load
-- pattern the rest of the emitter uses for multi-path merges).
-- SCOPE: CList and CRangeList are covered by slice 9 ("lists" section below).
-- list MATCH (HCons/HNil) works from slice 5b.
-- SPIKE-REP NOTES (extending (a)–(p)):
--   (q) ARRAY CELL — header word = raw_len (not hashName), so `loadTag` gives the
--       count directly.  Element i is at offset 8*(i+1), consistent with `loadField`.
--   (r) BOUNDS CHECK — two icmps (idx < 0 || idx >= len) OR'd, br to an @mdk_oob
--       block (call + unreachable); the ok path continues inline.
--   (s) RANGE LOOP — alloca i64 counter + load/store inside the loop; each element
--       = `tagInt(lo_raw + i)`.  CFG: br to cond block → load/icmp/br → body
--       (compute+store+increment) → back to cond; done block receives the br on
--       exit.  No phi nodes (consistent with the rest of the emitter).
--   (t) SLICE LOOP — same alloca-counter pattern; each iteration loads element
--       (lo_raw+i) from the source array via `loadFieldDyn` and stores it to dest
--       field i.

-- allocate an array cell with a STATICALLY known element list; header = raw count.
emitArrayAlloc : Emit -> Int -> List String -> (String, LTy)
emitArrayAlloc e n fields =
  let p = freshReg e
  let _ =
    emit e "  \{p} = call ptr @mdk_alloc(i64 \{intToString (8 * (n + 1))})"
  let _ = emit e "  store i64 \{intToString n}, ptr \{p}"
  let _ = storeFields e p fields 0
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTCon)

-- allocate an array cell with a DYNAMIC element count (for ranges and slices);
-- returns the raw ptr register (caller fills element fields).
emitArrayDynAlloc : Emit -> String -> String
emitArrayDynAlloc e len_raw =
  let sz = freshReg e
  let _ = emit e "  \{sz} = add i64 \{len_raw}, 1"
  let bytes = freshReg e
  let _ = emit e "  \{bytes} = mul i64 \{sz}, 8"
  let p = freshReg e
  let _ = emit e "  \{p} = call ptr @mdk_alloc(i64 \{bytes})"
  let _ = emit e "  store i64 \{len_raw}, ptr \{p}"
  p

-- CArray [e0, e1, …]: allocate a static-size array cell, emit each element,
-- store them as fields, return the cell pointer word.
emitArrayCreate : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitArrayCreate e env es =
  let words = emitArgs e env es
  emitArrayAlloc e (lengthS words) words

-- load a cell field at a DYNAMIC index (offset = (idxRaw+1)*8).  Used for CIndex
-- and the CSlice copy loop.
loadFieldDyn : Emit -> String -> String -> String
loadFieldDyn e ptrWord idxRaw =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{ptrWord} to ptr"
  let off1 = freshReg e
  let _ = emit e "  \{off1} = add i64 \{idxRaw}, 1"
  let off = freshReg e
  let _ = emit e "  \{off} = mul i64 \{off1}, 8"
  let fp = freshReg e
  let _ = emit e "  \{fp} = getelementptr i8, ptr \{p}, i64 \{off}"
  let f = freshReg e
  let _ = emit e "  \{f} = load i64, ptr \{fp}"
  f

-- store `val` (an i64 word) to element at dynamic index `idxRaw` of a boxed array.
-- mirrors loadFieldDyn verbatim, but ends with a store instead of a load.
storeFieldDyn : Emit -> String -> String -> String -> Unit
storeFieldDyn e ptrWord idxRaw val =
  let p = freshReg e
  let _ = emit e "  \{p} = inttoptr i64 \{ptrWord} to ptr"
  let off1 = freshReg e
  let _ = emit e "  \{off1} = add i64 \{idxRaw}, 1"
  let off = freshReg e
  let _ = emit e "  \{off} = mul i64 \{off1}, 8"
  let fp = freshReg e
  let _ = emit e "  \{fp} = getelementptr i8, ptr \{p}, i64 \{off}"
  let _ = emit e "  store i64 \{val}, ptr \{fp}"
  ()

-- CIndex arr i: bounds-check, then load element at dynamic offset.
emitArrayIndex : Emit -> OrdMap (String, LTy) -> CExpr -> CExpr -> (String, LTy)
emitArrayIndex e env a i =
  let (arr_w, _) = emitExpr e env a
  let (idx_w, _) = emitExpr e env i
  let idx_raw = untagInt e idx_w
  let arr_len = loadTag e arr_w
  let c1 = freshReg e
  let _ = emit e "  \{c1} = icmp slt i64 \{idx_raw}, 0"
  let c2 = freshReg e
  let _ = emit e "  \{c2} = icmp sge i64 \{idx_raw}, \{arr_len}"
  let oob = freshReg e
  let _ = emit e "  \{oob} = or i1 \{c1}, \{c2}"
  let n = intToString (freshLocal e)
  let oobL = "oob" ++ n
  let okL = "idx_ok" ++ n
  let _ = emit e "  br i1 \{oob}, label %\{oobL}, label %\{okL}"
  let _ = emit e (oobL ++ ":")
  let _ = emit e "  call void @mdk_oob()"
  let _ = emit e "  unreachable"
  let _ = emit e (okL ++ ":")
  let r = loadFieldDyn e arr_w idx_raw
  (r, LTInt)

-- CRangeArray lo hi incl: compute count, alloc, fill with alloca-counter loop.
emitRangeArray : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  Bool ->
  (String, LTy)
emitRangeArray e env lo hi incl =
  let (lo_w, _) = emitExpr e env lo
  let (hi_w, _) = emitExpr e env hi
  let lo_raw = untagInt e lo_w
  let hi_raw = untagInt e hi_w
  let hi_adj =
    if incl then
      let r = freshReg e
      let _ = emit e "  \{r} = add i64 \{hi_raw}, 1"
      r
    else
      hi_raw
  let count = freshReg e
  let _ = emit e "  \{count} = sub i64 \{hi_adj}, \{lo_raw}"
  let p = emitArrayDynAlloc e count
  let n = intToString (freshLocal e)
  let condL = "rng_cond" ++ n
  let bodyL = "rng_body" ++ n
  let doneL = "rng_done" ++ n
  let ic = freshReg e
  let _ = emit e ("  " ++ ic ++ " = alloca i64")
  let _ = emit e ("  store i64 0, ptr " ++ ic)
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (condL ++ ":")
  let iv = freshReg e
  let _ = emit e "  \{iv} = load i64, ptr \{ic}"
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp sge i64 \{iv}, \{count}"
  let _ = emit e "  br i1 \{cmp}, label %\{doneL}, label %\{bodyL}"
  let _ = emit e (bodyL ++ ":")
  let elem_sum = freshReg e
  let _ = emit e "  \{elem_sum} = add i64 \{lo_raw}, \{iv}"
  let elem_w = tagInt e elem_sum
  let off1 = freshReg e
  let _ = emit e "  \{off1} = add i64 \{iv}, 1"
  let off = freshReg e
  let _ = emit e "  \{off} = mul i64 \{off1}, 8"
  let fp = freshReg e
  let _ = emit e "  \{fp} = getelementptr i8, ptr \{p}, i64 \{off}"
  let _ = emit e "  store i64 \{elem_w}, ptr \{fp}"
  let iv2 = freshReg e
  let _ = emit e "  \{iv2} = add i64 \{iv}, 1"
  let _ = emit e "  store i64 \{iv2}, ptr \{ic}"
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (doneL ++ ":")
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTCon)

-- CSlice arr lo hi incl: bounds-check, then compute new_len, alloc, copy with a loop.
--
-- #550: the bounds check is NOT optional and NOT a clamp.  Without it this emitted
-- `new_len = end - lo` slots and copied `a[lo + i]` unchecked, so `[|1,2,3,4,5|].[2..99]`
-- allocated 97 slots and READ 94 words PAST THE ARRAY, publishing raw heap words (live
-- pointers among them) as ordinary Ints at exit 0 — while `run` raised E-SLICE-OOB.  The
-- guard mirrors sliceArray (compiler/eval/eval.mdk): `lo < 0 || end > len || end - lo < 0`.
-- All three disjuncts are load-bearing: `lo < 0` catches a read BEFORE the array, `end >
-- len` a read past it, and `end - lo < 0` an inverted range (whose negative new_len would
-- otherwise reach emitArrayDynAlloc).
--
-- Deliberately NOT a clamp: `arr.[lo..hi]` panicking is the documented contract that
-- distinguishes it from stdlib `array.slice`, which clamps (stdlib/array.mdk).  Clamping
-- here would silently merge the two and destroy the only bounds-checked slice in the
-- language.
--
-- The check is `end` (exclusive) vs the length, so the INCLUSIVE form is guarded on its
-- already-adjusted end_raw = hi+1 — i.e. the +1 happens BEFORE the compare, not after, so
-- `[|1,2,3|].[0..=2]` (end 3 == len 3) is legal while `.[0..=3]` (end 4 > 3) aborts.
-- mdk_slice_oob wants the INCLUSIVE upper bound for its message, so it is handed
-- `end_raw - 1`, matching the interpreter's `hiX - 1` text in both forms.
emitArraySlice : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  CExpr ->
  Bool ->
  (String, LTy)
emitArraySlice e env a lo hi incl =
  let (arr_w, _) = emitExpr e env a
  let (lo_w, _) = emitExpr e env lo
  let (hi_w, _) = emitExpr e env hi
  let lo_raw = untagInt e lo_w
  let hi_raw = untagInt e hi_w
  let end_raw =
    if incl then
      let r = freshReg e
      let _ = emit e "  \{r} = add i64 \{hi_raw}, 1"
      r
    else
      hi_raw
  let new_len = freshReg e
  let _ = emit e "  \{new_len} = sub i64 \{end_raw}, \{lo_raw}"
  let arr_len = loadTag e arr_w
  let s1 = freshReg e
  let _ = emit e "  \{s1} = icmp slt i64 \{lo_raw}, 0"
  let s2 = freshReg e
  let _ = emit e "  \{s2} = icmp sgt i64 \{end_raw}, \{arr_len}"
  let s3 = freshReg e
  let _ = emit e "  \{s3} = icmp slt i64 \{new_len}, 0"
  let s12 = freshReg e
  let _ = emit e "  \{s12} = or i1 \{s1}, \{s2}"
  let sbad = freshReg e
  let _ = emit e "  \{sbad} = or i1 \{s12}, \{s3}"
  let sn = intToString (freshLocal e)
  let sBadL = "sloob" ++ sn
  let sOkL = "sl_ok" ++ sn
  let _ = emit e "  br i1 \{sbad}, label %\{sBadL}, label %\{sOkL}"
  let _ = emit e (sBadL ++ ":")
  let hi_incl = freshReg e
  let _ = emit e "  \{hi_incl} = sub i64 \{end_raw}, 1"
  let _ = emit e "  call void @mdk_slice_oob(i64 \{lo_raw}, i64 \{hi_incl})"
  let _ = emit e "  unreachable"
  let _ = emit e (sOkL ++ ":")
  let p = emitArrayDynAlloc e new_len
  let n = intToString (freshLocal e)
  let condL = "sl_cond" ++ n
  let bodyL = "sl_body" ++ n
  let doneL = "sl_done" ++ n
  let ic = freshReg e
  let _ = emit e ("  " ++ ic ++ " = alloca i64")
  let _ = emit e ("  store i64 0, ptr " ++ ic)
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (condL ++ ":")
  let iv = freshReg e
  let _ = emit e "  \{iv} = load i64, ptr \{ic}"
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp sge i64 \{iv}, \{new_len}"
  let _ = emit e "  br i1 \{cmp}, label %\{doneL}, label %\{bodyL}"
  let _ = emit e (bodyL ++ ":")
  let src_idx = freshReg e
  let _ = emit e "  \{src_idx} = add i64 \{lo_raw}, \{iv}"
  let elem = loadFieldDyn e arr_w src_idx
  let dst_off1 = freshReg e
  let _ = emit e "  \{dst_off1} = add i64 \{iv}, 1"
  let dst_off = freshReg e
  let _ = emit e "  \{dst_off} = mul i64 \{dst_off1}, 8"
  let dst_fp = freshReg e
  let _ = emit e "  \{dst_fp} = getelementptr i8, ptr \{p}, i64 \{dst_off}"
  let _ = emit e "  store i64 \{elem}, ptr \{dst_fp}"
  let iv2 = freshReg e
  let _ = emit e "  \{iv2} = add i64 \{iv}, 1"
  let _ = emit e "  store i64 \{iv2}, ptr \{ic}"
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (doneL ++ ":")
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTCon)

-- CStringIndex s i: codepoint-indexed Char.  The String runtime rep is a packed
-- UTF-8 cell (NOT an i64-element array), so we mirror the interpreter's
-- stringIndexCp: convert to a Char array via @mdk_string_to_chars (each element
-- already a Char immediate (cp<<1)|1, header = codepoint count), bounds-check the
-- codepoint index against that count, then load element i.  Result LTy = LTChar.
-- Bounds violation calls @mdk_oob (matching the interpreter's index-OOB panic).
emitStringIndex : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  (String, LTy)
emitStringIndex e env a i =
  let (str_w, _) = emitExpr e env a
  let (idx_w, _) = emitExpr e env i
  let chars = freshReg e
  let _ = emit e "  \{chars} = call i64 @mdk_string_to_chars(i64 \{str_w})"
  let idx_raw = untagInt e idx_w
  let arr_len = loadTag e chars
  let c1 = freshReg e
  let _ = emit e "  \{c1} = icmp slt i64 \{idx_raw}, 0"
  let c2 = freshReg e
  let _ = emit e "  \{c2} = icmp sge i64 \{idx_raw}, \{arr_len}"
  let oob = freshReg e
  let _ = emit e "  \{oob} = or i1 \{c1}, \{c2}"
  let n = intToString (freshLocal e)
  let oobL = "soob" ++ n
  let okL = "sidx_ok" ++ n
  let _ = emit e "  br i1 \{oob}, label %\{oobL}, label %\{okL}"
  let _ = emit e (oobL ++ ":")
  let _ = emit e "  call void @mdk_oob()"
  let _ = emit e "  unreachable"
  let _ = emit e (okL ++ ":")
  let r = loadFieldDyn e chars idx_raw
  (r, LTChar)

-- CStringSlice s lo hi incl: codepoint substring.  Mirror the interpreter's
-- evalSliceInt VString = stringSlice lo (incl ? hi+1 : hi) s — which CLAMPS lo/hi
-- to [0, cp_count] (no OOB panic, unlike the array slice).  Reuse the
-- @mdk_string_slice extern (it >>1-untags the tagged Int bounds internally); for
-- the inclusive form hi+1 in value space is +2 on the tagged word (tag = n*2+1).
emitStringSlice : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  CExpr ->
  Bool ->
  (String, LTy)
emitStringSlice e env a lo hi incl =
  let (str_w, _) = emitExpr e env a
  let (lo_w, _) = emitExpr e env lo
  let (hi_w, _) = emitExpr e env hi
  let hi_adj =
    if incl then
      let r = freshReg e
      let _ = emit e "  \{r} = add i64 \{hi_w}, 2"
      r
    else
      hi_w
  let r = freshReg e
  let _ =
    emit
      e
      "  \{r} = call i64 @mdk_string_slice(i64 \{lo_w}, i64 \{hi_adj}, i64 \{str_w})"
  (r, LTStr)

-- CListIndex xs i: walk the Cons chain to the i-th element.  A List is a chain of
-- Cons cells ([tag|head@8|tail@16], Nil = odd immediate), NOT an i64-element
-- array, so we can't array-GEP it.  Mirror the interpreter's listNthAt: walk
-- (i decrementing) returning the head once i<=0, panic (@mdk_oob) on running off
-- the end.  @mdk_list_index does the walk in C (>>1-untags the tagged index).
-- Result word is the stored head (same shape as an array load → LTInt).
emitListIndex : Emit -> OrdMap (String, LTy) -> CExpr -> CExpr -> (String, LTy)
emitListIndex e env a i =
  let (lst_w, _) = emitExpr e env a
  let (idx_w, _) = emitExpr e env i
  let r = freshReg e
  let _ = emit e "  \{r} = call i64 @mdk_list_index(i64 \{lst_w}, i64 \{idx_w})"
  (r, LTInt)

-- CListSlice xs lo hi incl: collect elements at indices [lo, hi) into a NEW list.
-- Mirror the interpreter's listSliceV/listSliceGo — which CLAMPS (no OOB panic):
-- walks the chain with a running index, keeps heads in [lo, hi), stops at hi or
-- end-of-list.  @mdk_list_slice does the walk + rebuild in C (>>1-untags lo/hi);
-- for the inclusive form hi+1 in value space is +2 on the tagged word (tag n*2+1).
-- Result is a boxed Cons/Nil list → LTCon (same as the array slice).
emitListSlice : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  CExpr ->
  Bool ->
  (String, LTy)
emitListSlice e env a lo hi incl =
  let (lst_w, _) = emitExpr e env a
  let (lo_w, _) = emitExpr e env lo
  let (hi_w, _) = emitExpr e env hi
  let hi_adj =
    if incl then
      let r = freshReg e
      let _ = emit e "  \{r} = add i64 \{hi_w}, 2"
      r
    else
      hi_w
  let r = freshReg e
  let _ =
    emit
      e
      "  \{r} = call i64 @mdk_list_slice(i64 \{lst_w}, i64 \{lo_w}, i64 \{hi_adj})"
  (r, LTCon)

-- arrayMakeWith n f: INLINE INTRINSIC.  Allocates a dynamic array of `n` elements;
-- fills element i by calling the Medaka closure `f` with the tagged index `i`.
-- Shape mirrors emitRangeArray (alloca-counter loop) + emitIndirect (closure call).
-- No C extern; the closure is called directly from the emitted loop body.
emitArrayMakeWith : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitArrayMakeWith e env [nExpr, fExpr] =
  let (n_w, _) = emitExpr e env nExpr
  let (fw, _) = emitExpr e env fExpr
  let count = untagInt e n_w
  let p = emitArrayDynAlloc e count
  let n = intToString (freshLocal e)
  let condL = "mw_cond" ++ n
  let bodyL = "mw_body" ++ n
  let doneL = "mw_done" ++ n
  let ic = freshReg e
  let _ = emit e ("  " ++ ic ++ " = alloca i64")
  let _ = emit e ("  store i64 0, ptr " ++ ic)
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (condL ++ ":")
  let iv = freshReg e
  let _ = emit e "  \{iv} = load i64, ptr \{ic}"
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp sge i64 \{iv}, \{count}"
  let _ = emit e "  br i1 \{cmp}, label %\{doneL}, label %\{bodyL}"
  let _ = emit e (bodyL ++ ":")
  let ti = tagInt e iv
  let cp = loadField e fw 0
  let fp = freshReg e
  let _ = emit e "  \{fp} = inttoptr i64 \{cp} to ptr"
  let elem = freshReg e
  let _ = emit e "  \{elem} = call i64 \{fp}(i64 \{fw}, i64 \{ti})"
  let off1 = freshReg e
  let _ = emit e "  \{off1} = add i64 \{iv}, 1"
  let off = freshReg e
  let _ = emit e "  \{off} = mul i64 \{off1}, 8"
  let ep = freshReg e
  let _ = emit e "  \{ep} = getelementptr i8, ptr \{p}, i64 \{off}"
  let _ = emit e "  store i64 \{elem}, ptr \{ep}"
  let iv2 = freshReg e
  let _ = emit e "  \{iv2} = add i64 \{iv}, 1"
  let _ = emit e "  store i64 \{iv2}, ptr \{ic}"
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (doneL ++ ":")
  let w = freshReg e
  let _ = emit e "  \{w} = ptrtoint ptr \{p} to i64"
  (w, LTCon)
emitArrayMakeWith e env _ = gapE e "arrayMakeWith takes two arguments"

-- ── lists ─────────────────────────────────────────────────────────
-- VALUE REPRESENTATION: a list is a chain of boxed Cons cells (matching the
-- slice-5b match heads HCons/HNil, which test `cellTag` of "Cons"/"Nil").
-- The built-in list is not user-declared, so "Cons"/"Nil" are absent from the
-- ctor→type table and `cellTag` gives them the reserved list-type id with ordinals
-- 0 (Cons) and 1 (Nil) — UNLESS a user `data` owns those names, in which case both
-- the list literal and the user ctor resolve to that type's ordinal (they alias,
-- exactly as they did under the old hash).  Cell layouts (8-byte words):
--   Nil  → odd immediate (nullary; low bit 1)                  (no cell allocated)
--   Cons → [ i64 cellTag "Cons" | i64 head | i64 tail ]   (3-word cell)
-- Construction uses emitCtorAlloc "Nil" [] / emitCtorAlloc "Cons" [hw, tw]
-- verbatim — the SAME tag the slice-5b switch tests, so construction
-- and match agree by construction.
--
-- SPIKE-REP NOTES (extending (a)–(t)):
--   (u) CList [e0…en] is RIGHT-FOLDED INLINE (compile-time unroll): N+1 allocs
--       emitted as a straight-line sequence from tail to head.  No loop, no
--       stack growth — the list size is statically known.  Consistent with
--       emitTuple (which also unrolls inline for a static arity).
--   (v) CRangeList lo hi incl uses an ALLOCA-COUNTER LOOP (back-to-front):
--       initialise tail=Nil, i=count-1; while i≥0 prepend Cons(lo+i, tail) and
--       decrement i.  Back-to-front builds the list in ascending order (lo…hi)
--       without reversing.  An alloca i64 `acc` holds the current list head word
--       (a cell pointer as i64), so the same alloca/store/load discipline the
--       rest of the emitter uses for multi-path merges.  An empty range (count≤0)
--       returns Nil immediately (i=count-1 < 0 on first test).  This approach
--       matches the slice-8 loop pattern and avoids stack overflow on large ranges.

-- CList [e0, e1, …, en]: right-fold to Cons cells, innermost first.
emitList : Emit -> OrdMap (String, LTy) -> List CExpr -> (String, LTy)
emitList e _ [] = emitCtorAlloc e "Nil" []
emitList e env xs =
  let words = emitListWords e env xs
  if allConstWords words then emitConstList e words else emitRtList e words

-- emit every element to its operand word, head-to-tail (same order as the original
-- recursive emitList's element emission).
emitListWords : Emit -> OrdMap (String, LTy) -> List CExpr -> List String
emitListWords _ _ [] = []
emitListWords e env (x :: xs) =
  let (w, _) = emitExpr e env x
  w :: emitListWords e env xs

-- runtime cons chain from already-emitted element words (back-to-front), IR-identical
-- to the original recursive emitList for the non-constant case.
emitRtList : Emit -> List String -> (String, LTy)
emitRtList e [] = emitCtorAlloc e "Nil" []
emitRtList e (w :: rest) =
  let (tw, _) = emitRtList e rest
  emitCtorAlloc e "Cons" [w, tw]

-- a list literal whose elements are ALL compile-time constants: build the cons spine
-- as a chain of `internal constant` module globals (one cell per element, tail = the
-- next cell's pointer-constant; the base is the Nil immediate) instead of allocating
-- N cons cells at every evaluation. `==` on lists is structural, so sharing/dedup is
-- value-safe. Deduped via the same constant-cell cache as dict witnesses.
emitConstList : Emit -> List String -> (String, LTy)
emitConstList e words =
  let nilImm = intToString (cellTag e "Nil" * 2 + 1)
  let head = emitConstListGo e (cellTag e "Cons") (reverseL words) nilImm
  (head, LTCon)

emitConstListGo : Emit -> Int -> List String -> String -> String
emitConstListGo _ _ [] tl = tl
emitConstListGo e consTag (w :: rest) tl =
  let cell = emitConstDictCell e consTag [w, tl]
  emitConstListGo e consTag rest cell

-- CRangeList lo hi incl: build an ascending list [lo…hi] (or [lo…<hi]) via a
-- back-to-front alloca-counter loop.  An alloca i64 `acc` holds the current
-- head pointer; a second alloca i64 `ic` holds the loop counter (count-1 downto 0).
emitRangeList : Emit ->
  OrdMap (String, LTy) ->
  CExpr ->
  CExpr ->
  Bool ->
  (String, LTy)
emitRangeList e env lo hi incl =
  let (lo_w, _) = emitExpr e env lo
  let (hi_w, _) = emitExpr e env hi
  let lo_raw = untagInt e lo_w
  let hi_raw = untagInt e hi_w
  let hi_adj =
    if incl then
      let r = freshReg e
      let _ = emit e "  \{r} = add i64 \{hi_raw}, 1"
      r
    else
      hi_raw
  let count = freshReg e
  let _ = emit e "  \{count} = sub i64 \{hi_adj}, \{lo_raw}"
  let (nil_w, _) = emitCtorAlloc e "Nil" []
  let acc = freshReg e
  let _ = emit e ("  " ++ acc ++ " = alloca i64")
  let _ = emit e "  store i64 \{nil_w}, ptr \{acc}"
  let ic = freshReg e
  let _ = emit e ("  " ++ ic ++ " = alloca i64")
  let im1 = freshReg e
  let _ = emit e "  \{im1} = sub i64 \{count}, 1"
  let _ = emit e "  store i64 \{im1}, ptr \{ic}"
  let n = intToString (freshLocal e)
  let condL = "rl_cond" ++ n
  let bodyL = "rl_body" ++ n
  let doneL = "rl_done" ++ n
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (condL ++ ":")
  let iv = freshReg e
  let _ = emit e "  \{iv} = load i64, ptr \{ic}"
  let cmp = freshReg e
  let _ = emit e "  \{cmp} = icmp slt i64 \{iv}, 0"
  let _ = emit e "  br i1 \{cmp}, label %\{doneL}, label %\{bodyL}"
  let _ = emit e (bodyL ++ ":")
  let elem_raw = freshReg e
  let _ = emit e "  \{elem_raw} = add i64 \{lo_raw}, \{iv}"
  let elem_w = tagInt e elem_raw
  let tail_w = freshReg e
  let _ = emit e "  \{tail_w} = load i64, ptr \{acc}"
  let (cons_w, _) = emitCtorAlloc e "Cons" [elem_w, tail_w]
  let _ = emit e "  store i64 \{cons_w}, ptr \{acc}"
  let iv2 = freshReg e
  let _ = emit e "  \{iv2} = sub i64 \{iv}, 1"
  let _ = emit e "  store i64 \{iv2}, ptr \{ic}"
  let _ = emit e ("  br label %" ++ condL)
  let _ = emit e (doneL ++ ":")
  let r = freshReg e
  let _ = emit e "  \{r} = load i64, ptr \{acc}"
  (r, LTCon)
-- Seed the accumulator with Nil.

-- Counter starts at count-1 (back-to-front).

-- ── observability: table-cardinality dump (issue #542) ───────────────────────
-- Reports the SIZE of each emitter table the emitter itself built — never a
-- source-text grep, which #542's worked examples show can undercount a real
-- dispatch/impl table by 20x-59x. `globalsReg`'s count IS the value-global
-- count (it is keyed one entry per top-level value binding) — slice 5 cites
-- it by this name.
--
-- ⚠️ DEVIATION from the packet's literal ask: this reads `Emit`'s internal
-- Refs and returns the counts as a PLAIN pure value (`List (String, Int)`),
-- rather than printing to stderr from inside the emitter. `emitProgram` /
-- `emitProgramMode` / `emitProgramRecord` are effect-polymorphic PURE
-- functions (declared `<>`) reused by callers that are themselves pure
-- (`llvm_emit_typed_main.mdk`'s `runEmit`, `snapshot.mdk`'s `llvmOf`) —
-- printing here (a real `<IO>` — `getEnv`+`ePutStrLn`) would force `<IO>`
-- onto `emitProgram` itself and ripple through every one of those pure
-- callers. `emitProgramWithStats` below keeps the whole emitter pure; the
-- ONE real build driver (`entries/llvm_emit_modules_main.mdk`, already
-- `<IO>`) is where MEDAKA_STATS is read and the dump is actually printed
-- (support/timer.mdk's `emitStats`). Read-only Ref derefs are NOT an <IO>
-- effect here (contained/local state, same as every other `!e.xxx` read in
-- this file) — only `getEnv`/`ePutStrLn` are, which is why keeping this
-- function print-free keeps it byte-identical-safe and ripple-free.
optOmSize : Option (OrdMap a) -> Int
optOmSize (Some m) = omSize m
optOmSize None = 0

tableStats : Emit -> List (String, Int)
tableStats e = [
  ("implEntries", listLen !e.implEntries),
  ("globalsReg", listLen !e.globalsReg),
  ("recFields", listLen !e.recFields),
  ("ctorType", optOmSize !e.ctorTypeMap),
  ("declSig", omSize e.input.declSigIndex),
  ("knownFnMap", optOmSize !e.knownFnMap),
  ("sigMap", optOmSize !e.sigMap),
]

-- Shared per-program `EmitStateConfig` construction (F2-emit-stats-cleanup):
-- `emitProgramMode` and `emitProgramWithStats` built byte-identical configs
-- apart from `gapMode` — `emitProgramMode` threads its caller's mode through,
-- `emitProgramWithStats` always runs Strict. Extracted to ONE function so a
-- future edit to one caller's config can't silently diverge from the
-- other's with no gate to catch it.
programEmitConfig : GapMode -> EmitInput -> List CBind -> EmitStateConfig
programEmitConfig gapMode input groups = EmitStateConfig {
  counter0 = if input.emitHalf == emitHalfProgram then programHalfIdBase else 0,
  globalsReg0 =
    if input.emitHalf == emitHalfPrelude then
      initGlobalsRegReady (valBinds groups)
    else
      initGlobalsReg (valBinds groups),
  gapMode = gapMode,
  lazyGlobalNames = lazyGlobalNames groups,
  runDispatchAnalysis = True,
}

-- The Strict-mode emission body, factored out of `emitProgramMode` so
-- `emitProgramWithStats` can share the exact emit-step sequence without
-- duplicating it. Byte-identical to the inline body `emitProgramMode` ran
-- before this refactor, plus the `emitFfiDeclares` step (#2074) that landed on
-- the FFI sprint's inline copy after this refactor's own base — folded in here
-- so BOTH callers emit the user externs' `declare`s, not just `emitProgramMode`.
-- (`emitFfiDeclares` writes only `e.buf`, so `emitProgramWithStats`'s
-- pre-emission `tableStats` snapshot is unaffected — none of the seven counted
-- tables is touched by it.)
runStrictEmission : Emit -> EmitInput -> List CBind -> List CImplEntry -> String
runStrictEmission e input groups implEntries =
  let _ = emitPreamble e
  -- #2074: the user-declared externs' `declare`s.  No user extern ⇒ no lines.
  let _ = emitFfiDeclares e
  let _ = emitGlobalDecls e (valBinds groups)
  -- issue #118: the PRELUDE half is a LIBRARY — it has no entry point, and the
  -- program half's `@mdk_program_main` is the one that defines and initialises
  -- every `@mdk_g_*` (the prelude's included).
  let _ =
    if input.emitHalf == emitHalfPrelude then () else emitProgramMain e groups
  -- #561 PR-A: LAZY value globals' @mdk_force_<x> defines live with the init logic
  -- (@mdk_program_main), i.e. the program/whole half; the prelude half only declares
  -- them (emitGlobalDecls).  In whole mode with no lazy global this emits nothing.
  let _ =
    if input.emitHalf == emitHalfPrelude then
      ()
    else
      emitLazyForces e (valBinds groups)
  let _ = emitFns e (fnBinds groups)
  let _ = emitImpls e implEntries
  let _ = preludeIdSpaceGuard e
  joinNl
    (siteTrapDeclares e
      ++ reverseL !e.buf
      ++ reverseL !e.lams
      ++ siteFileTable e)

-- Same emission as `emitProgram`, plus a pure table-cardinality snapshot (see
-- the block comment above `tableStats`). Never used by the default `medaka
-- build` path — only by the MEDAKA_STATS-aware call site in
-- `entries/llvm_emit_modules_main.mdk`, so an unset env var costs this
-- function nothing (it is simply not called).
--
-- F2-emit-stats-cleanup: every counted table (`tableStats`) is fully
-- populated inside `buildEmitState`, before this function's snapshot is
-- taken, and none of the seven is mutated again anywhere in
-- `runStrictEmission`'s call chain (confirmed by grepping every `:=` site
-- for each table's Ref) — so a snapshot taken before emission and one taken
-- after are identical by construction. One snapshot is therefore taken
-- (post-`buildEmitState`, matching what a caller reading the printed line
-- expects: "the table the emitter built"), not two.
export
emitProgramWithStats : EmitInput -> CProgram -> (String, List (String, Int))
emitProgramWithStats input (CProgram groups ctorArs ctorTypes implEntries) =
  let cfg = programEmitConfig Strict input groups
  let e = buildEmitState cfg input groups ctorArs ctorTypes implEntries
  let stats = tableStats e
  let text = runStrictEmission e input groups implEntries
  (text, stats)

-- ── program ─────────────────────────────────────────────────────────────────
-- Emit a whole CProgram as a textual LLVM module: the runtime declares, then one
-- LLVM function per top-level `name p… = …` binding, then a single
-- `@main` that computes the top-level nullary value bindings (in source order),
-- then `main`'s body, then a type-directed print.
export
emitProgram : EmitInput -> CProgram -> String
emitProgram input cp =
  let (text, _) = emitProgramMode Strict input cp
  text

-- Record-mode emission is self-contained: callers receive both the rendered LLVM and
-- the gap events, so no state can leak across emissions in one process.
export
emitProgramRecord : EmitInput -> CProgram -> (String, List String)
emitProgramRecord input cp = emitProgramMode Record input cp

-- Per-emission derived-state config (RUN-EMIT-002): the fields the six-row
-- divergence census found differing between emitProgramMode and
-- emitProgramGaps. Each is a value the caller supplies here — never a shared
-- default silently overwritten afterward (packet S-emit-input-record §5).
data EmitStateConfig = EmitStateConfig {
  counter0 : Int,
  globalsReg0 : List (String, (Bool, LTy)),
  gapMode : GapMode,
  lazyGlobalNames : List String,
  runDispatchAnalysis : Bool,
}

-- Row #5/#6 (RUN-EMIT-002: one disposition, not two): when the caller wants the
-- dispatch-graph TMC groups computed (emitProgramMode), install them via the
-- full detection sequence; otherwise leave `gDispGroups` empty, matching
-- emitProgramGaps' plain per-bind census. `gDispDropMembers` over an empty
-- group list is identity, so routing floatFwSet through it unconditionally
-- reproduces emitProgramGaps' bare `collectFloatFw` while keeping ONE call site
-- for the whole disposition.
installDispatchState : Emit ->
  Bool ->
  List CBind ->
  List CBind ->
  List CImplEntry ->
  Unit
installDispatchState e runAnalysis groupsAll fnBindsList implEntries =
  -- RUN-EMIT-003: `gDispArMap` is installed on BOTH arms, so no reader can ever
  -- observe it uninstalled.  The census arm leaves `gDispArs` empty and never
  -- reaches gDispIsFn/gDispFnArity (they run only under GDispOn, which needs the
  -- groups this arm does not compute) — an EMPTY map answers exactly what the
  -- retired `lookupAssoc n ![]` scan answered (False / -1), so this is inert.
  -- `installDispatchGroupsFull` overwrites it with the real table on the other arm.
  e.gDispArMap := Some omEmpty
  let _ =
    if runAnalysis then
      installDispatchGroupsFull e groupsAll fnBindsList implEntries
    else
      e.gDispGroups := []
  e.floatFwSet := gDispDropMembers e (collectFloatFw e fnBindsList)

-- (b′) dispatch-graph TMC: run the SHARED detection (backend/trmc_analysis.mdk)
-- before any fn emit, so emitFn can route group members/roots. Hooks: the LLVM
-- canonFnName + a clause-derived fn-arity table with wasm's progFnArity contract
-- (-1 when unknown); v5's stage-1-claims hook is the LLVM Stage-1 gate (no
-- uniform-ctor condition — the backends' hooks unify when wasm's gate retires).
-- gDispGroupEtaStable then drops any group containing a single-clause member
-- that eta-saturation would re-arity (deficit > 0 — such a member's inlined
-- clause-arity body would diverge from the ordinary define's ABI); dropped
-- groups fall back to ordinary codegen, no transform, no regression.
installDispatchGroupsFull : Emit ->
  List CBind ->
  List CBind ->
  List CImplEntry ->
  Unit
installDispatchGroupsFull e groupsAll fnBindsList implEntries =
  let gDispArs = gDispFnArsOf fnBindsList
  e.gDispArs := gDispArs
  -- #990: index the fn-arity table so detectDispatchGroups' per-ref gDispIsFn/
  -- gDispFnArity is O(log fns) not O(fns) — reverseL ⇒ first-pair-wins = lookupAssoc.
  e.gDispArMap := Some (omFromPairs (reverseL gDispArs) omEmpty)
  e.gDispBinds := fnBindsList
  -- #1061: O(log P) member lookup for emitGDispMembers/gDispMembersEtaStable,
  -- replacing dispFindBind's per-member O(P) linear scan over the whole
  -- program's function binds. bindNameMap's leftmost-wins insert order
  -- matches dispFindBind's first-match semantics exactly (emit_support.mdk).
  e.gDispBindMap := bindNameMap fnBindsList
  let dispGroups0 =
    detectDispatchGroups
      (n => canonFnName e n)
      (n => gDispIsFn e n)
      (n => gDispFnArity e n)
      (nm ar cs => gDispStage1Claims e nm ar cs)
      fnBindsList
      groupsAll
      implEntries
  e.gDispGroups := gDispKeepEtaStable e fnBindsList dispGroups0

-- ONE construction path (RUN-EMIT-002) for the per-emission derived state: the
-- `Emit` record literal, the nine `install*` calls, and the post-install
-- dispatch/float-state block — shared by emitProgramMode, emitProgramGaps,
-- and emitProgramWithStats (the last routes its config through the shared
-- `programEmitConfig`, not a separate literal, per F2-emit-stats-cleanup).
buildEmitState : EmitStateConfig ->
  EmitInput ->
  List CBind ->
  List (String, Int) ->
  List (String, String) ->
  List CImplEntry ->
  Emit
buildEmitState cfg input groups ctorArs ctorTypes implEntries =
  let e = Emit {
    input = input,
    counter0 = cfg.counter0,
    curModule = Ref scopeProgram,
    counters = Ref omEmpty,
    buf = Ref [],
    fnNames = Ref (collectFns groups),
    sigs = Ref (inferSigs input.declSigIndex (fnBinds groups)),
    lams = Ref [],
    recFields = Ref (input.recordFieldOrders ++ collectRecords groups),
    implEntries = Ref implEntries,
    globalsReg = Ref cfg.globalsReg0,
    gapMode = cfg.gapMode,
    gapLog = Ref [],
    curGapBind = Ref "?",
    defineCounter = Ref 0,
    closureArity = Ref [],
    closureRetTy = Ref [],
    directFn = Ref [],
    trmcCtx = Ref TrmcOff,
    gDispCtx = Ref GDispOff,
    selfTailCtx = Ref None,
    gDispGroups = Ref [],
    gDispBinds = Ref [],
    gDispBindMap = Ref omEmpty,
    gDispArs = Ref [],
    gDispArMap = Ref None,
    curImplTag = Ref "",
    curSelfFnParams = Ref [],
    knownFnMap = Ref None,
    lazyGlobalMap = Ref None,
    ctorMap = Ref None,
    sigMap = Ref None,
    defArityMap = Ref None,
    recByName = Ref None,
    recByLabel = Ref None,
    implsByMethod = Ref None,
    implMethodSet = Ref None,
    ctorTypeMap = Ref None,
    ctorsByType = Ref None,
    ctorOrdinalMap = Ref None,
    typeIdMap = Ref None,
    dispCache = Ref [],
    dictConstCache = Ref [],
    closConstCache = Ref [],
    floatFwSet = Ref [],
    floatClosureFns = Ref [],
    rawWorkers = Ref omEmpty,
    constGlobals = Ref omEmpty,
    inlineOpen = Ref 0,
    inlineSpent = Ref 0,
    siteFileNums = Ref omEmpty,
    siteFiles = Ref [],
    siteTraps = Ref [],
  }
  e.dictConstCache := []
  e.closConstCache := []
  e.dispCache := []
  let _ = installKnownFnMap e (collectFns groups)
  -- #561 PR-A: classify LAZY value globals (dispatch-reaching / cyclic) once per
  -- program.  Reads of these lower to `call @mdk_force_<x>()`; every other global
  -- stays on the byte-identical eager prologue.
  let _ = installLazyGlobalMap e cfg.lazyGlobalNames
  let _ = installCtorMap e ctorArs
  -- #990: index the ctor→type table so cellTag's per-ctor ctorTypeId/ctorOrdinal/
  -- ctorHasSiblings lookups are O(log types) not O(types) — reverseL ⇒ first-wins.
  let _ = installCtorTypeMap e ctorTypes
  -- #352: index the CONSTANT record field-order table (by name and by label) so every
  -- per-field-op probe is O(log records) not O(records) — same first-match answers.
  let _ = installRecFieldIndex e (recFieldTable e)
  let _ = installSigMap e (sigTable e)
  -- #990: group the flat impl-entry list by interface method ONCE, so every per-site
  -- dispatch scan (implsOf/implFnSymE) is O(bucket) not
  -- O(impls) — byte-identical IR, O(N²)→O(N log N) emit on dispatch-heavy code.
  -- ⚠️ RUN-EMIT-003: these two MUST precede `installDefArityMap`.  That install
  -- replays `etaSaturateMethodBody` per bind, which reaches `methodBodyDeficit` →
  -- `methodOccurrenceCallableArity` → `implForSite` → `implsOf` →
  -- `methodEntries`, i.e. it READS `e.implsByMethod`.  Ordered the other way round
  -- that read landed on the (now retired) uninstalled-scan branch, which is the one
  -- place the two paths were both live in a single emission.
  let _ = installImplIndex e implEntries
  let _ = installImplMethodSet e implEntries
  let _ = installDefArityMap e (fnBinds groups)
  -- a group member must never be ADVERTISED as having a float `__fw` worker (the
  -- group path emits no standalone defines, so a float-context caller would call
  -- a nonexistent symbol; v3/v4 make external float callers impossible anyway —
  -- belt and braces).
  let _ =
    installDispatchState
      e
      cfg.runDispatchAnalysis
      groups
      (fnBinds groups)
      implEntries
  e.floatClosureFns := collectFloatClosureFns e (fnBinds groups)
  e.rawWorkers := collectRawWorkers e (fnBinds groups)
  e.constGlobals := collectConstGlobals (valBinds groups)
  e

emitProgramMode : GapMode -> EmitInput -> CProgram -> (String, List String)
emitProgramMode gapMode input (CProgram groups ctorArs ctorTypes implEntries) =
  -- issue #118: the two halves are emitted by INDEPENDENT emitter runs, so they
  -- get disjoint gensym ranges or their lifted defines collide — see
  -- programHalfIdBase.  Mode 0 keeps starting at 0, so its IR is unchanged.
  -- The PRELUDE half emits no `@mdk_program_main`, hence no init prologue to mark
  -- the globals initialised as it computes them — so they start READY, exactly as
  -- the non-emitting gaps driver does (initGlobalsRegReady).  Without this every
  -- prelude body that loads a global would hit the forward-dependency gap.
  let cfg = programEmitConfig gapMode input groups
  let e = buildEmitState cfg input groups ctorArs ctorTypes implEntries
  let text = runStrictEmission e input groups implEntries
  (text, reverseL !e.gapLog)

-- `@mdk_program_main`: the init prologue (every top-level value binding's rhs, in
-- source order) followed by `main`'s own body and the type-directed print.
emitProgramMain : Emit -> List CBind -> Unit
emitProgramMain e groups =
  -- `@mdk_program_main` itself is a whole-program entity; the per-bind
  -- initializers inside its prologue re-scope themselves (emitTopGlobals).
  let _ = setScope e scopeProgram
  let _ = beginDefine e
  let _ = emit e "define i32 @mdk_program_main(i32 %argc, ptr %argv) {"
  let _ = emit e "entry:"
  let _ = emit e "  call void @mdk_set_args(i32 %argc, ptr %argv)"
  -- #1334: resolve `main`'s body FIRST, before touching any top-level global.
  -- `mainBody` is a pure scan over `groups` — it neither reads nor writes `e`,
  -- so hoisting it earlier changes NOTHING about the emitted IR for any program
  -- that already builds today; it only changes which of two independent panics
  -- fires first when BOTH conditions are true (no `main` AND a malformed value
  -- global). A program with no `main` at all (e.g. `stdlib/core.mdk` built as
  -- its own entry) is missing the more fundamental thing, so it should report
  -- "no main" rather than tripping over an unrelated global first — see the
  -- prelude-double-load note on emitTopGlobals below for why such a global can
  -- appear at all.
  let mainRhs = mainBody e groups
  -- #561 PR-A: only SAFE (statically-orderable) value globals are eager-initialised
  -- in this prologue — byte-identical to the pre-#561 emitter whenever no global is
  -- lazy (the compiler's own case).  A SAFE global's whole eager reach is SAFE (the
  -- taint is downward-closed over reads), so this prologue never calls a force fn.
  -- LAZY globals are initialised on first use by their @mdk_force_<x> defines below.
  let _ =
    emitTopGlobals e (orderedValBinds groups (safeValBinds e (valBinds groups)))
  let (mv, mty) = emitExpr e omEmpty mainRhs
  -- A Unit-returning `main` produces output ONLY through explicit print calls (or
  -- a panic); never auto-print its `()` result.  Detected by the DECLARED return
  -- type (`declSigOf "main"` → "Unit", robust even when the body LTy is
  -- mis-inferred — e.g. the medaka CLI's own `match`-bodied main, which otherwise
  -- printed a stray `0`) OR a body LTy that is already LTUnit (an unannotated IO
  -- `main = putStrLn …`).  Value-returning mains keep auto-printing (the pp_value
  -- differential-test contract).
  -- C4: if the typecheck Float hint is set, override the structural LTy so the
  -- print path uses the Float formatter even when emitExpr returns LTUnknown/LTInt
  -- (the type-erased result from a polymorphic HOF like `fold`).
  let mty2 = if e.input.mainIsFloat then LTFloat else mty
  let _ = if mainIsUnit e mty2 then () else emitPrint e mv mty2
  let _ = emit e "  ret i32 0"
  emit e "}"
-- declare a module global per top-level value/`Ref` binding.

-- emit `@main` FIRST: its init prologue computes each value-binding rhs in
-- SOURCE ORDER and marks the registry, so the globals' LTys are resolved before
-- the function `define`s (emitted next) reference them.  LLVM module-item order
-- is irrelevant, so emitting `@main` ahead of the fn/impl defines is sound.

-- the function + impl defines (registry now fully initialised, so any body may
-- reference any global via a `load i64, ptr @mdk_g_<name>`).

-- the module body (preamble, @main, fn/impl defines) in forward order, then the
-- side buffer (string-literal + value-binding globals, lifted-lambda defines).
-- LLVM module-item order is irrelevant, so appending the side buffer is sound.

emitPreamble : Emit -> Unit
emitPreamble e =
  let _ = emitLines e preambleLines
  emitDiscNoneCell e

-- emit each constant preamble line in order; the strings live in
-- backend.llvm_preamble (pure data) so this module's `emit`/`Emit` machinery
-- stays here without a circular import.
emitLines : Emit -> List String -> Unit
emitLines _ [] = ()
emitLines e (line :: rest) =
  let _ = emit e line
  emitLines e rest

-- the `@main` init prologue: compute each top-level value/`Ref`
-- binding's rhs in SOURCE ORDER and `store` the word into its module global
-- `@mdk_g_<name>`, then mark the registry entry initialised with the rhs's LTy.
-- Computing in source order means a binding referencing an EARLIER one loads the
-- already-stored global; a reference to a LATER (not-yet-marked) global hits the
-- forward/mutual-dependency gap in lookupVarG instead of an uninitialised 0.
-- A `Ref v` rhs allocs its cell as usual → the stored word is the cell POINTER, so
-- `.value`/`setRef` deref through the loaded global.
--
-- #1334: the wildcard panic below fires for a genuinely multi-clause or
-- non-nullary top-level function (a real emitter bug) — but ALSO for a name
-- that legitimately has a single nullary clause per file yet arrives here with
-- more than one, because it was loaded twice and merged (e.g. building
-- `stdlib/core.mdk` as its OWN entry re-loads the prelude's `core.mdk` a second
-- time as the entry module). That double-load merge is a separate, open defect
-- (#1334 half 2) — this panic only ever reports the SYMPTOM ("more clauses than
-- a value binding should have"), never which of the two causes produced it.
emitTopGlobals : Emit -> List CBind -> Unit
emitTopGlobals _ [] = ()
emitTopGlobals e ((CBind name [CClause [] body] _) :: rest) =
  -- #2753 review S2-1: the prologue stays in `@mdk_program_main`'s own scope,
  -- NOT each bind's module.  An initializer is emitted INSIDE this define, so
  -- everything it lifts — a const cell, a `@.strc.` literal, a lambda — is
  -- REFERENCED from here; attributing the lifted entity to the bind's module put
  -- its definition in one partition and its only reference in another, which is
  -- exactly the leak that made a one-module edit move 25 of 77 partitions.
  -- Owning them here costs the prologue's ids a shared counter (a value-bind edit
  -- renumbers all of them) and costs no locality at all, because every one of
  -- them already lived or died with this single partition.
  let (v, ty) = emitExpr e omEmpty body
  let _ = emit e "  store i64 \{v}, ptr @mdk_g_\{name}"
  let _ = markGlobalInit e name ty
  emitTopGlobals e rest
emitTopGlobals _ ((CBind name _ _) :: _) =
  panic
    ("llvm: top-level function '"
      ++ name
      ++ "' unsupported (value bindings only)")

-- ── #561 PR-A: lazy value-global force functions ─────────────────────────────
-- The SAFE (eager) value binds — those NOT classified lazy — kept on the byte-
-- identical init prologue.  When no global is lazy this is the identity on valBinds.
safeValBinds : Emit -> List CBind -> List CBind
safeValBinds e bs = filterList (b => not (isLazyGlobal e (bindName b))) bs

-- the value binds classified LAZY — each emitted as an @mdk_force_<name> define.
lazyValBinds : Emit -> List CBind -> List CBind
lazyValBinds e bs = filterList (b => isLazyGlobal e (bindName b)) bs

-- emit an @mdk_force_<name> define for every LAZY value global (whole/program half
-- only — the prelude half just declares them; see emitGlobalDecls).  A faithful
-- transliteration of eval's forceMemo/blackholeCell (compiler/eval/eval.mdk):
--   state 2 FORCED  -> return the memoised @mdk_g_<name>
--   state 1 FORCING -> re-entered mid-init => E-CYCLIC-VALUE (the black-hole)
--   state 0 UNFORCED-> mark FORCING, run the rhs, memoise the value, mark FORCED
-- A read of another global inside the body lowers through lookupVarG exactly as
-- anywhere else (a plain load for a SAFE dep — already eager-initialised by the
-- prologue that ran first — or a nested @mdk_force_ for a LAZY dep).
emitLazyForces : Emit -> List CBind -> Unit
emitLazyForces e binds = emitLazyForcesGo e (lazyValBinds e binds)

emitLazyForcesGo : Emit -> List CBind -> Unit
emitLazyForcesGo _ [] = ()
emitLazyForcesGo e ((CBind name [CClause [] body] _) :: rest) =
  -- an ordinary forcer is its bind's module; the synthesized `$memo_<Tag>_<m>`
  -- cells carry no `__` and fall to `program` through `moduleIdOf`.
  let _ = setScopeOfBind e name
  let _ = emitForceFn e name body
  emitLazyForcesGo e rest
emitLazyForcesGo e (_ :: rest) = emitLazyForcesGo e rest

emitForceFn : Emit -> String -> CExpr -> Unit
emitForceFn e name body =
  -- module-scope name constant for the E-CYCLIC-VALUE message.
  let nbytes = strBytes name
  let nlen = lengthS nbytes
  let gnid = ".gname." ++ name
  let _ =
    emitGlobal
      e
      "@\{gnid} = private unnamed_addr constant [\{intToString (nlen + 1)} x i8] c\"\{escBytes nbytes}\\00\""
  let _ = beginDefine e
  let _ = emit e "define i64 @mdk_force_\{name}() {"
  let _ = emit e "entry:"
  let s = freshReg e
  let _ = emit e "  \{s} = load i8, ptr @mdk_gs_\{name}"
  let _ =
    emit
      e
      "  switch i8 \{s}, label %lz_unforced [ i8 2, label %lz_forced i8 1, label %lz_forcing ]"
  let _ = emit e "lz_forced:"
  let fv = freshReg e
  let _ = emit e "  \{fv} = load i64, ptr @mdk_g_\{name}"
  let _ = emit e "  ret i64 \{fv}"
  let _ = emit e "lz_forcing:"
  let _ = emit e "  call void @mdk_cyclic_value(ptr @\{gnid})"
  let _ = emit e "  unreachable"
  let _ = emit e "lz_unforced:"
  let _ = emit e "  store i8 1, ptr @mdk_gs_\{name}"
  let (v, _ty) = emitExpr e omEmpty body
  let _ = emit e "  store i64 \{v}, ptr @mdk_g_\{name}"
  let _ = emit e "  store i8 2, ptr @mdk_gs_\{name}"
  let _ = emit e "  ret i64 \{v}"
  emit e "}"

-- " in <file>" when a source name was installed, else "" — a shared clause for the
-- two main-shape diagnostics below.  A function (not a lazy nullary value) so it
-- re-reads the ref at each call rather than memoising a stale first read.
emitSrcWhere : Emit -> String
emitSrcWhere e = if e.input.srcName == "" then "" else " in " ++ e.input.srcName

-- Is `main` Unit-returning (→ suppress the auto-print of its result)?  Three checks:
-- 1. The typecheck-inferred-Unit hint (installMainIsUnitHint) — catches unannotated
--    mains whose return type resolved to Unit through a polymorphic HOF.
-- 2. The DECLARED return type (declSigOf "main" → "Unit") — catches the annotated
--    case `main : <IO> Unit`; effects already stripped by core_ir_lower.methodRetTy.
-- 3. The body's emit-time LTy (LTUnit) — catches the simple `main = putStrLn …` case.
mainIsUnit : Emit -> LTy -> Bool
mainIsUnit e mty =
  if e.input.mainIsUnit then
    True
  else match declSigOf e "main"
    Some (_, "Unit") => True
    _ => match mty
      LTUnit => True
      _ => False

emitPrint : Emit -> String -> LTy -> Unit
emitPrint e v LTInt =
  let i = untagInt e v
  emit e ("  call void @mdk_print_int(i64 " ++ i ++ ")")
emitPrint e v LTBool =
  let i = untagInt e v
  emit e ("  call void @mdk_print_bool(i64 " ++ i ++ ")")
emitPrint e v LTFloat =
  let d = unboxFloat e v
  emit e ("  call void @mdk_print_float(double " ++ d ++ ")")
emitPrint e v LTStr = emit e ("  call void @mdk_print_str(i64 " ++ v ++ ")")
-- LTUnknown reaches print only for the dominant String-builder case (a chained
-- `++` whose value is a String); print it as a String, matching the old LTStr
-- default.  A list-valued LTUnknown is never printed by the bootstrap fixtures.
emitPrint e v LTUnknown = emit e ("  call void @mdk_print_str(i64 " ++ v ++ ")")
emitPrint e _ LTUnit = emit e "  call void @mdk_print_unit()"
emitPrint e v LTChar = emit e ("  call void @mdk_print_char(i64 " ++ v ++ ")")
-- G3: a polymorphic Num result (LTNum) is an Int OR boxed-Float word; dispatch
-- the print on its runtime tag via @mdk_print_num (mirrors the @mdk_num_* arith).
emitPrint e v LTNum = emit e ("  call void @mdk_print_num(i64 " ++ v ++ ")")
emitPrint e v LTU64 = emit e ("  call void @mdk_print_u64(i64 " ++ v ++ ")")
-- an I64 cell: @mdk_print_num's I64 arm, which renders it signed.
emitPrint e v LTI64 = emit e ("  call void @mdk_print_num(i64 " ++ v ++ ")")
emitPrint _ _ LTCon =
  panic
    "llvm: cannot print an ADT value (`main` must reduce to a scalar Int/Bool/Float)"
emitPrint _ _ LTClosure =
  panic
    "llvm: cannot print a closure value (`main` must reduce to a scalar Int/Bool/Float)"

-- the body of the `main` binding (must be a nullary clause).  Both diagnostics name
-- the file (when a driver installed it via installEmitSrcName) and state the fix — the
-- zero-arg-value shape is a documented beginner footgun.
mainBody : Emit -> List CBind -> CExpr
mainBody e [] =
  panic
    ("llvm: no 'main' binding found"
      ++ emitSrcWhere e
      ++ " — a program must define 'main' as a zero-arg value: write 'main = …', not"
      ++ " 'main () = …'. ('medaka run'/'build' never applies main; it forces a"
      ++ " zero-arg main for its effects.)")
mainBody _ ((CBind "main" [CClause [] body] _) :: _) = body
mainBody e ((CBind "main" _ _) :: _) =
  panic
    ("llvm: 'main'"
      ++ emitSrcWhere e
      ++ " must be a zero-arg value: write 'main = …', not 'main () = …' or"
      ++ " 'main x = …'. ('medaka run'/'build' never applies main; it forces a"
      ++ " zero-arg main for its effects.)")
mainBody e (_ :: rest) = mainBody e rest

-- a readable tag for the unsupported-node panic (only the nodes a slice-1
-- fixture could hit if it strayed out of scope).
ctag : CExpr -> String
ctag (CApp _ _) = "CApp (function application)"
ctag (CLam _ _) = "CLam (lambda)"
ctag (CMatch _ _) = "CMatch"
ctag (CDecision _ _ _) = "CDecision (match)"
ctag (CTuple _) = "CTuple"
ctag (CList _) = "CList"
ctag (CArray _) = "CArray"
ctag (CRecord _ _) = "CRecord"
ctag (CFieldAccess _ _ _) = "CFieldAccess"
ctag (CRecordUpdate _ _ _) = "CRecordUpdate"
ctag (CRangeList _ _ _) = "CRangeList"
ctag (CRangeArray _ _ _) = "CRangeArray"
ctag (CIndex _ _) = "CIndex"
ctag (CSlice _ _ _ _) = "CSlice"
ctag (CStringIndex _ _) = "CStringIndex"
ctag (CStringSlice _ _ _ _) = "CStringSlice"
ctag (CListIndex _ _) = "CListIndex"
ctag (CListSlice _ _ _ _) = "CListSlice"
ctag (CMethod _ _ _ _ _ _) = "CMethod (typeclass dispatch)"
ctag (CDict _ _) = "CDict (dictionary)"
ctag (CVariantUpdate _ _ _) = "CVariantUpdate (named-field variant update)"
ctag _ = "?"

-- ── D4 emitter-completeness inventory entry point ───────────────────────────
-- Mirrors emitProgram's setup but turns gap-recording ON, attributes each gap to
-- the top-level binding / impl group being emitted, and SKIPS the `@main` path (a
-- real prelude/compiler module carries no `main`).  Emits every fn-bind, value
-- bind, and impl group; returns the recorded gap events ("<binding>\t<reason>").
-- The emitted LLVM text is discarded by the probe — only the gap log matters.
export
emitProgramGaps : EmitInput -> CProgram -> List String
emitProgramGaps input (CProgram groups ctorArs ctorTypes implEntries) =
  -- #561 PR-A: the gap census emits every value bind ORDINARILY (eager load), so
  -- install an EMPTY lazy set — this also RESETS any prior emitProgram's set so it
  -- cannot leak into the census. Likewise `runDispatchAnalysis = False` resets the
  -- (b′) groups (see installDispatchState) so a prior emitProgram's routing state
  -- can never leak into this path.
  let cfg = EmitStateConfig {
    counter0 = 0,
    globalsReg0 = initGlobalsRegReady (valBinds groups),
    gapMode = Record,
    lazyGlobalNames = [],
    runDispatchAnalysis = False,
  }
  let e = buildEmitState cfg input groups ctorArs ctorTypes implEntries
  let _ = emitPreamble e
  let _ = emitFnsGaps e (fnBinds groups)
  let _ = emitImplsGaps e implEntries
  let _ = emitTopBindsGaps e omEmpty (valBinds groups)
  reverseL !e.gapLog

emitFnsGaps : Emit -> List CBind -> Unit
emitFnsGaps _ [] = ()
emitFnsGaps e ((CBind name cs site) :: rest) =
  let _ = setGapBind e ("fn " ++ name)
  let _ = emitFn e (CBind name cs site)
  emitFnsGaps e rest

emitImplsGaps : Emit -> List CImplEntry -> Unit
emitImplsGaps e entries = emitGroupsGaps e (groupImpls e entries)

emitGroupsGaps : Emit -> List ImplGroup -> Unit
emitGroupsGaps _ [] = ()
emitGroupsGaps e (g :: rest) =
  let _ = setGapBind e "impl \{groupMethodOf g}@\{groupTag g}"
  let _ = emitGroup e g
  emitGroupsGaps e rest

emitTopBindsGaps : Emit -> OrdMap (String, LTy) -> List CBind -> Unit
emitTopBindsGaps _ _ [] = ()
emitTopBindsGaps e env ((CBind name [CClause [] body] _) :: rest) =
  let _ = setGapBind e ("val " ++ name)
  let (v, ty) = emitExpr e env body
  emitTopBindsGaps e (omInsert name (v, ty) env) rest
emitTopBindsGaps e env ((CBind name _ _) :: rest) =
  let _ = setGapBind e ("val " ++ name)
  let _ = gapU e "non-nullary / multi-clause value binding"
  emitTopBindsGaps e env rest
