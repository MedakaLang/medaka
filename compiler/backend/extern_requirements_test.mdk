  Expectation, expectAll, expectEach, expectEqual, expectTextContainsAll
}

lowered : String -> CProgram
lowered = parse >> desugar >> annotateProgram >> lowerProgramEmitWith emptyFacts

symbols : ExternRequirements -> List String
symbols requirements = map (row => row.declaration.symbol) requirements.rows

problems : CProgram -> ExternRequirements -> List String
problems = validateExternRequirements LlvmBackend PreludeFreeRuntime

requiresDefect : String -> CProgram -> ExternRequirements -> Expectation
requiresDefect needle cp requirements =
  expectTextContainsAll [needle] (joinNl (problems cp requirements))

alterFirst : (ExternRequirement -> ExternRequirement) ->
  ExternRequirements ->
  ExternRequirements
alterFirst f requirements = match requirements.rows
  row :: rest => { requirements | rows = f row :: rest }
  [] => requirements

runtimeControl : CProgram
runtimeControl = lowered "main = bitAnd 6 3"

runtimeRequirements : ExternRequirements
runtimeRequirements = planExterns LlvmBackend PreludeFreeRuntime runtimeControl

test "selection follows Core uses and retains the complete explicit runtime domain" =
  let p = lowered "main = intToString 42"
  let u = lowered "main = charCode charMaxBound"
  let select = planExterns LlvmBackend PreludeFreeRuntime
  let loaded = planExterns LlvmBackend (LoadedRuntimeExterns []) p
  expectAll [
    expectEqual [runtimeExternSymbol "intToString"] (symbols (select p)),
    expectEqual
      [runtimeExternSymbol "charMaxBound", runtimeExternSymbol "charCode"]
      (symbols (select u)),
    expectEqual (symbols (select p)) (symbols (select p)),
    expectEqual
      []
      (validateExternRequirements
        LlvmBackend
        (LoadedRuntimeExterns [])
        p
        loaded),
    expectEqual "loaded" (match loaded.runtimeDomain
      LoadedRuntimeExterns [] => "loaded"
      _ => "wrong"),
    expectEqual [] (symbols (select (lowered "main = unknownOrdinary"))),
    expectEqual
      []
      (symbols (select (lowered "f bitAnd = bitAnd 6 3\nmain = 42"))),
  ]

test "whole and reached selection use the returned Core without another reach" =
  let cp = lowered "unused x = intToString x\nmain = 42"
  let whole = planExterns WasmBackend PreludeFreeRuntime cp
  let (plan, reached) = buildEmitPlanReached PreludeFreeRuntime omEmpty cp
  expectAll [
    expectEqual [runtimeExternSymbol "intToString"] (symbols whole),
    expectEqual [] (symbols plan.externRequirements),
    expectEqual
      []
      (validateExternRequirements
        WasmBackend
        PreludeFreeRuntime
        reached
        plan.externRequirements),
  ]

test "value, saturated and partial occurrences retain their use kind and argument count" =
  let cp =
    lowered
      "value = bitAnd\nsaturated = bitAnd 6 3\npartial = bitAnd 6\nmain = 42"
  let selected = planExterns LlvmBackend PreludeFreeRuntime cp
  expectEqual
    [(ExternValue, 0), (ExternApplication, 2), (ExternApplication, 1)]
    (flatMap
      (row =>
        map (use => (use.useKind, use.suppliedCoreArguments)) row.selectedUses)
      selected.rows)

test "requirements reject missing, duplicate, unknown, target, binding and use mutations" =
  let cp = runtimeControl
  let good = runtimeRequirements
  expectAll [
    expectEqual [] (problems cp good),
    requiresDefect "missing-extern-requirement" cp { good | rows = [] },
    requiresDefect "duplicate-extern-requirement" cp { good |
      rows = good.rows ++ good.rows,
    },
    requiresDefect "extern-target-mismatch" cp { good | target = WasmBackend },
    requiresDefect "extern-domain-mismatch" cp { good |
      runtimeDomain = LoadedRuntimeExterns [],
    },
    requiresDefect
      "extern-binding-mismatch"
      cp
      (alterFirst
        (row => { row | selectedBinding = RuntimeRequirement "bitOr" })
        good),
    requiresDefect
      "extern-use-mismatch"
      cp
      (alterFirst (row => { row | selectedUses = [] }) good),
    requiresDefect "unknown-extern-requirement" (lowered "main = 42") good,
  ]

corruptAbi : (CallableShape -> CallableShape) -> ExternRequirements
corruptAbi f =
  alterFirst
    (row => { row |
      declaration = { row.declaration |
        callableShape = map f row.declaration.callableShape,
      },
    })
    runtimeRequirements

test "requirement ABI mutations cannot agree with a deleted derived projection" =
  expectEach
    (map
      ((name, requirements) => (
        name,
        requiresDefect "extern-abi-mismatch" runtimeControl requirements,
      ))
      [
        (
          "written arity",
          corruptAbi (shape => { shape | writtenValueArity = 7 }),
        ),
        ("Core arity", corruptAbi (shape => { shape | loweredCoreArity = 7 })),
        (
          "parameter head",
          corruptAbi (shape => { shape | parameterHeads = ["Float", "Int"] }),
        ),
        ("result head", corruptAbi (shape => { shape | resultHead = "Float" })),
        (
          "schema",
          corruptAbi (shape => { shape | canonicalSignature = "v2:wrong" }),
        ),
      ])

alterFact : (ExternDeclFact -> ExternDeclFact) -> CProgram -> CProgram
alterFact f (CProgram bs ca ct impls mc facts) =
  let key = runtimeExternSymbol "bitAnd"
  let inventory = match omLookup key facts.factExterns
    Some fact => omInsert key (f fact) facts.factExterns
    None => facts.factExterns
  CProgram bs ca ct impls mc { facts | factExterns = inventory }

test "full Core facts independently reject key, missing ABI and canonical runtime ABI defects" =
  let missing =
    alterFact (fact => { fact | callableShape = None }) runtimeControl
  let wrong =
    alterFact
      (fact => { fact |
        callableShape =
          map (shape => { shape | loweredCoreArity = 1 }) fact.callableShape,
      })
      runtimeControl
  let badKey = alterFact (fact => { fact | symbol = "wrong" }) runtimeControl
  let reserved =
    walkExternVars
      (_ _ _ addr => CVar "$extern$unknown" addr)
      (lowered "main = ordinary")
  let check needle cp =
    requiresDefect needle cp (planExterns LlvmBackend PreludeFreeRuntime cp)
  expectAll [
    check "missing-extern-abi" missing,
    check "extern-abi-mismatch" wrong,
    check "extern-declaration-key-mismatch" badKey,
    check "unknown-extern-declaration" reserved,
  ]

foreignControl : CProgram
foreignControl =
  lowered
    """
extern foreignAdd : Int -> Int -> Int
  bind c "host_add"
  bind js "hostAdd"
main = foreignAdd 40 2
"""

test "target bindings keep C, JS and runtime identity distinct" =
  let native = planExterns LlvmBackend PreludeFreeRuntime foreignControl
  let wasm = planExterns WasmBackend PreludeFreeRuntime foreignControl
  expectAll [
    expectEqual
      [ForeignRequirement "c" (Some "host_add")]
      (map (row => row.selectedBinding) native.rows),
    expectEqual
      [ForeignRequirement "js" (Some "hostAdd")]
      (map (row => row.selectedBinding) wasm.rows),
    expectEqual [] (problems foreignControl native),
    expectEqual
      []
      (validateExternRequirements
        WasmBackend
        PreludeFreeRuntime
        foreignControl
        wasm),
    requiresDefect
      "extern-binding-mismatch"
      foreignControl
      (alterFirst
        (row => { row |
          selectedBinding = ForeignRequirement "c" (Some "wrong_alias"),
        })
        native),
    expectEqual
      [RuntimeRequirement "bitAnd"]
      (map (row => row.selectedBinding) runtimeRequirements.rows),
  ]

test "native prototypes preserve unused declarations and enforce one C symbol ABI" =
  let unused =
    lowered """
extern unused : Int -> Int
  bind c "unused_host"
main = 42
"""
  let requirements = planExterns LlvmBackend PreludeFreeRuntime unused
  let aliases =
    lowered
      """
extern first : Int -> Int
  bind c "same_host"
extern second : Float -> Int
  bind c "same_host"
main = 42
"""
  expectAll [
    expectEqual [] (symbols requirements),
    expectEqual
      ["unused"]
      (map (fact => fact.declaredName) requirements.nativePrototypes),
    expectEqual [] (problems unused requirements),
    requiresDefect "extern-prototype-mismatch" unused { requirements |
      nativePrototypes = [],
    },
    requiresDefect
      "extern-abi-mismatch: C alias"
      aliases
      (planExterns LlvmBackend PreludeFreeRuntime aliases),
  ]

