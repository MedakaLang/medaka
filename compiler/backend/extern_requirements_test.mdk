checkEtaArity : CallableShape -> String -> Expectation
checkEtaArity shape name =
  let cp = lowered ("main = let _ = " ++ name ++ " in 42")
  let input = makeEmitInput RawUnchecked PreludeFreeRuntime [] [] 0 [] [] ""
  let emitted =
    emitProgramRecord input (buildEmitPlan LlvmBackend PreludeFreeRuntime cp) cp
  match emitted
    Err defects => fail (joinNl (map defectMessage defects))
    Ok (text, _) =>
      let definitions =
        filter
          (line => contains "define internal i64 @mdk.gen.externeta." line)
          (lines text)
      expectEqual
        [shape.loweredCoreArity]
        (map (line => listLen (split "," line) - 1) definitions)

test "every native census mismatch eta wrapper uses the independently parsed runtime Core arity" =
  match readFile (underRoot "stdlib/runtime.mdk")
    Err e => fail e
    Ok source =>
      let abi =
        fold
          (index (name, shape) => omInsert name shape index)
          omEmpty
          (runtimeRowsFromSource (parse source))
      expectEach
        (map
          (name => (
            name,
            match omLookup name abi
              None => fail ("runtime declaration disappeared: " ++ name)
              Some shape => checkEtaArity shape name,
          ))
          nativeArityMismatches)

duplicateProbeVar : String
duplicateProbeVar = "MEDAKA_EXTERN_DUPLICATE_PROBE"

duplicateDecodedProgram : String
duplicateDecodedProgram =
  """
(CProgram () () () () () (facts () () () none (externs
(extern symbol origin name foreign () missing-abi raw)
(extern symbol origin name foreign () missing-abi raw))))
"""

test "source and decoded declaration rows reject duplicates before map insertion" =
  match getEnv duplicateProbeVar
    Some "decoded" =>
      let (CProgram _ _ _ _ _ facts) = parseCProgram duplicateDecodedProgram
      expectEqual None (omLookup "symbol" facts.factExterns)
    Some "source" => match runtimeRequirements.rows
      row :: _ =>
        let index = externFactIndex [row.declaration, row.declaration]
        expectEqual None (omLookup row.declaration.symbol index)
      [] => fail "missing runtime test row"
    Some _ => fail "invalid duplicate selector"
    None =>
      expectEach
        (map
          (kind => (
            kind,
            match boundedVerbSeconds 90 "env" [
              duplicateProbeVar ++ "=" ++ kind,
              executablePath (),
            ]
              Err e => fail e
              Ok (code, out, err) => expectAll [
                expectNotEqual 0 code,
                expectTextContainsAll ["duplicate-extern-declaration"] err,
              ],
          ))
          ["decoded", "source"])
