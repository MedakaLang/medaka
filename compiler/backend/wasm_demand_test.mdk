test "selected family projection" =
  let sentinel =
    optionOrPanic
      "missing fallthrough declaration"
      (find (f => f.declaredName == "__fallthrough__") implicitRuntimeFacts)
  let ordinary =
    optionOrPanic
      "missing ordinary declaration"
      (find (f => f.declaredName == "intToString") implicitRuntimeFacts)
  let first = { sentinel | symbol = "aliasA" }
  let second = { sentinel | symbol = "aliasB" }
  let unused = { sentinel | symbol = "unusedAlias" }
  let foreign = { sentinel |
    symbol = "foreignAlias",
    bindingKind = ForeignBinding,
    hostBindings = [("js", "foreign")],
  }
  let neighbor = { ordinary | symbol = "ordinaryAlias" }
  let (CProgram _ ca ct impls mc facts) = snd (prepared "main = ()")
  let cp =
    CProgram
      [
        synthBind "main" [
          CClause [] (CTuple (map externVar [first, second, foreign, neighbor])),
        ],
      ]
      ca
      ct
      impls
      mc
      { facts |
        factExterns =
          omFromPairs
            (map
              (f => (f.symbol, f))
              [first, second, unused, foreign, neighbor])
            omEmpty,
      }
  let (plan, _) = prepareWasmPlan PreludeFreeRuntime omEmpty cp
  let selected =
    selectedFallthroughSymbols
      plan.externRequirements
      (physical plan).catalogFamilies
  expectAll [
    expectEqual
      ["aliasA", "aliasB", "foreignAlias", "ordinaryAlias"]
      (map (row => row.declaration.symbol) plan.externRequirements.rows),
    expectEqual ["aliasA", "aliasB"] (omKeys selected),
    expectEqual
      ["__fallthrough__", "__fallthrough__", "intToString"]
      (map fst (physical plan).catalogFamilies),
    expectEqual
      []
      (omKeys
        (selectedFallthroughSymbols
          { plan.externRequirements | rows = [] }
          (physical plan).catalogFamilies)),
  ]

test "declared Clock remains published without adding physical Wasm demand" =
  let manifest = CapabilityManifest {
    request = ManifestRequest {
      entry = EntryKey { moduleId = "source", binding = "declared" },
      protocol = HostInvocation,
    },
    atoms = [
      FrozenAtom {
        label = "Clock",
        origin = OriginBuiltin,
        domainTop = PUnit,
        authority = FrozenConst PUnit,
      },
    ],
  }
  let (baselinePlan, CProgram groups ctors types impls contexts facts) =
    prepared "main = ()"
  let cp = CProgram groups ctors types impls contexts { facts |
    factManifests = [manifest],
  }
  let (plan, CProgram _ _ _ _ _ retained) =
    prepareWasmPlan PreludeFreeRuntime omEmpty cp
  expectAll [
    expectEqual
      (importFields (physical baselinePlan))
      (importFields (physical plan)),
    expectEqual (physical baselinePlan).helpers (physical plan).helpers,
    expectEqual
      [("source", "declared", ["Clock"])]
      (map
        (m => (
          (m : CapabilityManifest).request.entry.moduleId,
          (m : CapabilityManifest).request.entry.binding,
          map (a => a.label) m.atoms,
        ))
        retained.factManifests),
  ]

prepared : String -> (EmitPlan, CProgram)
prepared =
  parse
    >> desugar
    >> annotateProgram
    >> lowerProgramEmitWith emptyFacts
    >> prepareWasmPlan PreludeFreeRuntime omEmpty

physical : EmitPlan -> WasmDemandPlan
physical plan = optionOrPanic "missing test demand" plan.wasmPhysical

demandOf : String -> WasmDemandPlan
demandOf src = physical (fst (prepared src))

setOf : List String -> List String
setOf names = omKeys (omFromNames names omEmpty)

expectPrerequisites : String -> List String -> List String -> Expectation
expectPrerequisites src helpers types =
  let demand = demandOf src
  expectAll [
    expectEqual
      (setOf helpers)
      (setOf (filter (h => any (== h) helpers) demand.helpers)),
    expectEqual
      (setOf types)
      (setOf (filter (t => any (== t) types) demand.representationTypes)),
  ]

test "String clause and decision patterns close helpers and representation before rendering" =
  expectEach
    (map
      ((name, src) => (
        name,
        expectPrerequisites
          src
          ["strSearchRuntimeLines", "strLeafRuntimeLines", "ioStrRuntimeLines"]
          ["str", "u8arr"],
      ))
      [
        ("clause", """
f "" = 1
f _ = 2
main = 42
"""),
        ("nested tuple", """
f ("", x) = 1
f _ = 2
main = 42
"""),
        ("tail switch", """
f s = match s
  "" => 1
  _ => 2
main = 42
"""),
        ("guard", """
f s
  | "" <- s = 1
  | True = 2
main = 42
"""),
      ])

test "lambda destructuring includes tuple and list representation without constructing either" = expectEach
  [
    (
      "tuple",
      expectPrerequisites
        """
main =
  let f = (x,y) => x
  42
"""
        ["closApplyLines", "stderrByteImportLines"]
        ["C_Tup2", "T_zZ_24_Tuple2", "argarr", "clos", "codety"],
    ),
    (
      "list",
      expectPrerequisites
        """
main =
  let f = (x :: xs) => x
  42
"""
        ["closApplyLines", "stderrByteImportLines"]
        ["C_Cons", "T_List"],
    ),
  ]

test "compound expressions close String helper types independently of String mode eligibility" = expectEach
  [
    (
      "tuple",
      expectPrerequisites
        """
f x = (charToStr x,42)
main = 42
"""
        ["strLeafRuntimeLines"]
        ["str", "u8arr"],
    ),
    (
      "list",
      expectPrerequisites
        """
f x = [charToStr x]
main = 42
"""
        ["strLeafRuntimeLines"]
        ["str", "u8arr"],
    ),
    (
      "array",
      expectPrerequisites
        """
f x = [|charToStr x|]
main = 42
"""
        ["strLeafRuntimeLines"]
        ["str", "u8arr", "arr"],
    ),
    (
      "stderr tuple",
      expectPrerequisites
        """
f x = (ePutStr x,42)
main = 42
"""
        ["stderrRuntimeLines"]
        ["str", "u8arr"],
    ),
  ]

importFields : WasmDemandPlan -> List String
importFields demand = map (i => "\{i.namespace}:\{i.field}") demand.imports

test "Float autoprint closes both formatting and String printing prerequisites" =
  expectPrerequisites
    """
main =
  let _ = (1,2)
  pi
"""
    ["floatRuntimeLines", "ioStrRuntimeLines"]
    ["str", "u8arr", "float"]

test "closure bodies below collection expressions retain their physical representation" =
  expectPrerequisites
    "main = let _ = [x => x] in 42"
    ["closApplyLines"]
    ["clos", "argarr", "codety", "T_List", "C_Cons"]

test "captured local-group arithmetic retains the outer binder stamp" =
  let demand =
    demandOf
      """
f x = g ()
  where
    g _ = x + x
main = let _ = (z => z) in f 21
"""
  expectEqual
    ["valueAddRuntimeLines"]
    (filter (== "valueAddRuntimeLines") demand.helpers)

test "captured local-group comparison retains the outer binder stamp" =
  let demand =
    demandOf
      """
f x = g ()
  where
    g _ = if x > x then 0 else 42
main = let _ = (z => z) in f 21
"""
  expectEqual
    ["valueCmpNumRuntimeLines"]
    (filter (== "valueCmpNumRuntimeLines") demand.helpers)

test "ordinary lambda capture retains its value arithmetic helper" =
  let demand =
    demandOf """
f x = (u => x + x) ()
main = let _ = (z => z) in f 21
"""
  expectEqual
    ["valueAddRuntimeLines"]
    (filter (== "valueAddRuntimeLines") demand.helpers)

test "baseline imports and new type prerequisites do not broaden legacy eligibility" =
  let scalar = demandOf "main = 42"
  let local = demandOf """
main =
  let putStrLn = 42
  putStrLn
"""
  let neutral = demandOf """
main =
  let value = 42
  value
"""
  let nested = demandOf """
f x = g x
  where
    g y = charToStr y
main = 42
"""
  expectAll [
    expectEqual
      [False, True, False, False]
      [scalar.useRef, local.useRef, neutral.useRef, nested.useRef],
    expectEqual ["env:mdk_write_byte"] (importFields scalar),
    expectEqual ["env:mdk_write_byte"] (importFields local),
    expectEqual [] scalar.sourceHostKeys,
    expectEqual ["boxint", "float"] scalar.representationTypes,
  ]

test "scalar traps and emitted unused bodies retain exact import order" =
  expectEach
    (map
      (src => (
        src,
        expectEqual
          ["env:mdk_write_byte", "env:mdk_write_err_byte"]
          (importFields (demandOf src)),
      ))
      ["main = 12 / 3", """
unused x = 10 / x
main = 42
"""])

test "catalog specials retain selected dispositions and Ref representation" =
  let ref = demandOf "main = (Ref 42).value"
  let bound = demandOf """
main =
  let _ = (1,2)
  intMaxBound
"""
  let cp =
    parse "main = __fallthrough__ ()"
      |> desugar
      |> annotateProgram
      |> lowerProgramEmitWith emptyFacts
  let fallthrough =
    match filter (f => f.declaredName == "__fallthrough__") implicitRuntimeFacts
      fact :: _ =>
        let canonical =
          walkExternVars
            (scope supplied name addr =>
              if name == "__fallthrough__" then
                externVar fact
              else
                CVar name addr)
            cp
        physical (fst (prepareWasmPlan PreludeFreeRuntime omEmpty canonical))
      [] => panic "missing canonical fallthrough fact"
  expectAll [
    expectEqual ["Ref"] (map fst ref.catalogFamilies),
    expectEqual ["intMaxBound"] (map fst bound.catalogFamilies),
    expectEqual ["__fallthrough__"] (map fst fallthrough.catalogFamilies),
    expectPrerequisites "main = (Ref 42).value" [] ["refbox"],
    expectEqual ["env:mdk_write_byte"] (importFields ref),
  ]

refusal : String -> (WasmDemandPlan -> WasmDemandPlan) -> Result String String
refusal src mutate =
  let (plan, cp) = prepared src
  let bad = { plan | wasmPhysical = Some (mutate (physical plan)) }
  let checked =
    validateForEmission WasmBackend PreludeFreeRuntime RawUnchecked bad cp
  match checked.defects
    [] => Ok "output would be permitted"
    defects => Err (joinNl (map coreDefectMessage defects))

without : String -> List String -> List String
without name = filter (/= name)

stringPattern : String
stringPattern = """
f "" = 1
f _ = 2
main = 42
"""

test "gateway refuses required helper, type and catalog disposition mutations" = expectAll
  [
    expectErrContains
      "missing-wasm-helper-prerequisite: strSearchRuntimeLines"
      (refusal stringPattern (d => { d |
        helpers = without "strSearchRuntimeLines" d.helpers,
      })),
    expectErrContains
      "missing-wasm-type-prerequisite: str"
      (refusal stringPattern (d => { d |
        representationTypes = without "str" d.representationTypes,
      })),
    expectErrContains
      "wasm-catalog-disposition-mismatch"
      (refusal "main = (Ref 42).value" (d => { d | catalogFamilies = [] })),
  ]

test "function value demand validates exact keys and survives census" =
  let src = "f x = x\nmain = (f, 1)"
  let d = demandOf src
  expectAll [
    expectEqual ["f"] (omKeys d.fnValues),
    expectEqual (omKeys d.fnValues) (omKeys (censusWasmDemand d).fnValues),
    expectErrContains
      "wasm-function-value-demand-mismatch"
      (refusal src (p => { p | fnValues = omEmpty })),
    expectErrContains
      "wasm-function-value-demand-mismatch"
      (refusal src (p => { p | fnValues = omInsert "bogus" () p.fnValues })),
  ]

test "function value plans follow their own prepared programs" =
  let (p, cp) = prepared "f x = x\nmain = (f, 1)"
  let (u, _) = prepared "g x = x\nmain = (g, 2)"
  let (pAgain, _) = prepared "f x = x\nmain = (f, 1)"
  let defects =
    validateForEmission WasmBackend PreludeFreeRuntime RawUnchecked u cp
  expectAll [
    expectEqual ["f"] (omKeys (physical p).fnValues),
    expectEqual ["g"] (omKeys (physical u).fnValues),
    expectEqual
      (omKeys (physical p).fnValues)
      (omKeys (physical pAgain).fnValues),
    expectTextContainsAll
      ["wasm-function-value-demand-mismatch"]
      (joinNl (map coreDefectMessage defects.defects)),
  ]

test "index operand function values belong to the emitted plan" =
  let (_, CProgram bs ca ct impls ms fs) = prepared "f x = x + 1\nmain = 0"
  let ix = CIndex (CArray [CVar "f" AGlobal]) (CLit (LInt 0))
  let body = CApp ix [CLit (LInt 41)] (CallSite CallDynamic False)
  let cp =
    CProgram
      (map
        (b => match b
          CBind "main" [CClause pats _] loc bid =>
            CBind "main" [CClause pats body] loc bid
          _ => b)
        bs)
      ca
      ct
      impls
      ms
      fs
  let (plan, same) = prepareWasmPlan PreludeFreeRuntime omEmpty cp
  expectAll [
    expectEqual ["f"] (omKeys (physical plan).fnValues),
    expectEqual ["f"] (omKeys (censusWasmDemand (physical plan)).fnValues),
    match (emitProgram
      (makeWasmEmitInput RawUnchecked PreludeFreeRuntime [])
      plan
      same)
      Ok wat => expectTextContainsAll ["(func $f.gen.wrapper.66.0"] wat
      Err _ => fail "index program refused",
  ]

test "paired helper/type/import omissions cannot erase unchanged Core prerequisites" = expectAll
  [
    expectErrContains
      "missing-wasm-helper-prerequisite: strSearchRuntimeLines"
      (refusal stringPattern (d => { d |
        helpers =
          without
            "strSearchRuntimeLines"
            (without "strLeafRuntimeLines" d.helpers),
        representationTypes =
          without "str" (without "u8arr" d.representationTypes),
        representation =
          { d.representation | uses = filter (/= UseStr) d.representation.uses },
      })),
    expectErrContains
      "missing-wasm-host-key: env:mdk_write_err_byte"
      (refusal "main = 12 / 3" (d => { d |
        helpers =
          without "stderrByteImportLines" (without "intRuntimeLines" d.helpers),
        imports = filter (i => i.field /= "mdk_write_err_byte") d.imports,
      })),
  ]

intArith : String
intArith = """
f x y = shiftLeft (x + y) (x - y)
main = f 3 1
"""

test "gateway refuses a checked Int helper or shift dropped from the plan" = expectAll
  [
    expectEqual ["add", "left", "sub"] (demandOf intArith).intHelpers,
    expectErrContains
      "missing-wasm-helper-prerequisite: physical branches"
      (refusal intArith (d => { d |
        intHelpers = without "add" (without "left" d.intHelpers),
      })),
    expectErrContains
      "wasm-census-demand-mismatch"
      (refusal intArith (d => { d |
        censusIntHelpers = without "add" (without "left" d.censusIntHelpers),
      })),
  ]

test "gap census preserves its forced reference walk without requiring main" =
  let (plan, cp) = prepared "f x y = x + y"
  expectEqual
    (Ok [])
    (emitProgramGaps
      (makeWasmEmitInput RawUnchecked PreludeFreeRuntime [])
      plan
      cp)

test "census helper domain and no-main neighbors" =
  let run =
    src =>
      let (plan, cp) = prepared src
      emitProgramGaps
        (makeWasmEmitInput RawUnchecked PreludeFreeRuntime [])
        plan
        cp
  expectAll [
    expectTrue (contains "mdk_int_add" helperFunctionNames),
    expectTrue (contains "mdk_str_concat" helperFunctionNames),
    expectEqual (Ok []) (run "f x y = x + y"),
    expectEqual (Ok []) (run "f x = x ++ \"z\""),
    expectEqual (Ok []) (run "f x = y => x + y"),
    match run "f x = missing x"
      Ok gaps => expectTextContainsAll ["missing"] (joinNl gaps)
      Err _ => fail "unknown user call must remain a census gap",
  ]

test "ordinary spellings cannot acquire a runtime declaration's result stamp" =
  let (_, cp) = prepared "main = 42"
  let context = wasmTypeContext omEmpty cp
  expectAll [
    expectEqual RTValue (returnStamp context envEmpty "putStrLn"),
    expectEqual RTValue (cexprStamp context envEmpty (CVar "pi" AGlobal)),
  ]

-- what `envLookup` found, as text, so a test states the binder it expects
refText : EnvRef -> String
refText NotLocal = "not-local"
refText LocalUnstamped = "unstamped"
refText (LocalBinder ord) = "binder " ++ ord

test "an inner binding shadows in its own scope only; the outer env keeps its binder" =
  let outer = envBind "x" (BinderId "x" 7) envEmpty
  let inner = envBind "x" (BinderId "x" 9) outer
  expectAll [
    expectEqual "binder 7" (refText (envLookup "x" outer)),
    expectEqual "binder 9" (refText (envLookup "x" inner)),
    expectEqual "not-local" (refText (envLookup "y" inner)),
  ]

test "extending with unstamped names never replaces a stamped binder" =
  let env = envBind "x" (BinderId "x" 7) envEmpty
  let extended = envExtendUnstamped ["x", "__lp0"] env
  expectAll [
    expectEqual "binder 7" (refText (envLookup "x" extended)),
    expectEqual "unstamped" (refText (envLookup "__lp0" extended)),
    expectEqual "unstamped" (refText (envLookup "s" (envBindUnstamped "s" env))),
  ]

test "restricting to the captured names keeps their stamps and drops the rest" =
  let env =
    envBindUnstamped
      "scratch"
      (envBind "b" (BinderId "b" 2) (envBind "a" (BinderId "a" 1) envEmpty))
  let captured = envRestrict ["a", "scratch"] env
  expectAll [
    expectEqual "binder 1" (refText (envLookup "a" captured)),
    expectEqual "unstamped" (refText (envLookup "scratch" captured)),
    expectFalse (envHas "b" captured),
  ]

test "planned host and JS imports use physical wire parameter counts" =
  let demand =
    demandOf
      """
extern zero : Unit -> <FFI "js"> Int
  bind js "zero"
extern mixed : Int -> Float -> <FFI "js"> Int
  bind js "mixed"
main = (zero (), mixed 2 3.0)
"""
  let rows =
    filter
      (i => i.namespace == "jsffi" || i.field == "mdk_write_byte")
      demand.imports
  expectEqual
    [
      ("env", "mdk_write_byte", " (param i32)", 1),
      ("jsffi", "zero:Unit->Int", " (result i64)", 0),
      (
        "jsffi",
        "mixed:Int,Float->Int",
        " (param i64) (param f64) (result i64)",
        2,
      ),
    ]
    (map (i => (i.namespace, i.field, i.signature, i.parameterCount)) rows)

test "tuple physical type identities match emitted root and constructor" =
  let demand = demandOf "main = (1, 2)"
  expectEqual
    ["C_Tup2", "T_zZ_24_Tuple2"]
    (filter
      (t => t == "T_zZ_24_Tuple2" || t == "C_Tup2" || t == "T_Tup2")
      demand.representationTypes)
