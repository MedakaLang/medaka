-- Sibling test for `compiler/backend/wasm_emit.mdk`'s parameter naming ([P-TEST-SIBLING]).
--
-- A single all-PVar clause names its wasm params by their source variables, so the
-- body reads the param local directly and no `local.get $__wparg<i>; local.set $x`
-- copy is emitted.  Multi-clause groups and wildcard params keep the positional
-- `__wparg<i>` locals.  Each program is emitted through `emitProgramRecord` as
-- `compiler/entries/wasm_emit_modules_main.mdk` does for its lowered program.  Runtime
-- behaviour (shadowing, TRMC depth, closure capture) is pinned by the wasm fixture.

-- lint-disable-file rule-duplicate-body
-- `watOf` is kept local so each sibling test file reads alone.

import test.{expectAll, expectFalse, expectTrue, labelFail}
import string.{contains, lines, startsWith}
import list.{reverse}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import types.annotate.{annotateProgram}
import types.typecheck.{grantWholeDomain}
import ir.core_ir_lower.{
  ctorFieldTypeNames,
  declaredRecordFieldOrders,
  lowerProgramEmit,
}
import backend.wasm_emit.{emitProgramRecord, makeWasmEmitInputFull}
import backend.emit_plan.{buildEmitPlan}
import backend.core_validate.{Backend(..)}

-- the emitted WAT of `src`, as the modules entry would print it for that program
watOf : String -> String
watOf src =
  let decls = grantWholeDomain (desugar (parse src))
  let input =
    makeWasmEmitInputFull
      []
      (ctorFieldTypeNames decls)
      False
      False
      (declaredRecordFieldOrders decls)
      []
  let cp = lowerProgramEmit (annotateProgram decls)
  let (text, _) = emitProgramRecord input (buildEmitPlan WasmBackend cp) cp
  text

-- the lines of the top-level `(func $<name> ` definition, from its header through `  )`
funcBlock : String -> String -> List String
funcBlock name wat = blockFrom ("  (func $" ++ name ++ " ") (lines wat)

blockFrom : String -> List String -> List String
blockFrom _ [] = []
blockFrom head (l :: rest) =
  if startsWith head l then takeBlock rest [l] else blockFrom head rest

takeBlock : List String -> List String -> List String
takeBlock [] acc = reverse acc
takeBlock (l :: rest) acc =
  if l == "  )" then reverse (l :: acc) else takeBlock rest (l :: acc)

-- does any line of `block` contain `needle`
blockHas : String -> List String -> Bool
blockHas needle block = anyLine (l => contains needle l) block

anyLine : (String -> Bool) -> List String -> Bool
anyLine _ [] = False
anyLine p (l :: rest) = p l || anyLine p rest

-- a single all-PVar clause: the source names are the wasm params, no __wparg copy
pickSrc : String
pickSrc = "pick a b = a\nmain = pick \"x\" \"y\""

test "all-PVar single clause: params are named by their source variables, with no copy" =
  let blk = funcBlock "pick" (watOf pickSrc)
  expectAll [
    labelFail
      "header carries the source names"
      (expectTrue
        (blockHas "(param $a (ref eq))" blk
          && blockHas "(param $b (ref eq))" blk)),
    labelFail
      "no positional __wparg local is read in the body"
      (expectFalse (blockHas "__wparg" blk)),
  ]

-- a wildcard keeps its positional name; the PVar beside it keeps its source name
wildSrc : String
wildSrc = "second _ b = b\nmain = second \"x\" \"y\""

test "PVar + wildcard mix: the wildcard stays positional, the PVar is the source name" =
  let blk = funcBlock "second" (watOf wildSrc)
  expectAll [
    labelFail
      "wildcard param is positional"
      (expectTrue (blockHas "(param $u____wparg0 (ref eq))" blk)),
    labelFail
      "PVar param is its source name and is never copied into"
      (expectTrue
        (blockHas "(param $b (ref eq))" blk
          && not (blockHas "local.set $b" blk))),
  ]

-- a multi-clause group dispatches on positional params: the header is not the clause variable
multiSrc : String
multiSrc = "pairFn 0 = 1\npairFn n = n\nmain = pairFn 3"

test "multi-clause group keeps the positional params" =
  let blk = funcBlock "pairFn" (watOf multiSrc)
  labelFail
    "header is positional, not the clause variable"
    (expectTrue
      (blockHas "(param $u____wparg0 (ref eq))" blk
        && not (blockHas "(param $n (ref eq))" blk)))

-- a cons-tail self-call is TRMC-looped; the loop stores into the source-named params
trmcSrc : String
trmcSrc =
  "upto lo hi = if lo > hi then [] else lo :: upto (lo + 1) hi\nmain = upto 1 3"

test "TRMC loop: the loop writes the source-named params directly" =
  let blk = funcBlock "upto" (watOf trmcSrc)
  expectAll [
    labelFail
      "the loop stores into $lo and $hi"
      (expectTrue
        (blockHas "local.set $lo" blk && blockHas "local.set $hi" blk)),
    labelFail
      "no positional slot appears in the TRMC function"
      (expectFalse (blockHas "__wparg" blk)),
  ]

-- a body binder that rebinds a param name is renamed apart (`uniqueBinders`), so the
-- param keeps its source name and the binder gets its own local
shadowSrc : String
shadowSrc = "shadowL xs = let xs = [] in xs\nmain = shadowL []"

test "shadowed param: the param keeps its source name, the binder gets a distinct local" =
  let blk = funcBlock "shadowL" (watOf shadowSrc)
  expectAll [
    labelFail
      "header names the param by its source variable"
      (expectTrue
        (blockHas "(param $xs (ref eq))" blk
          && not (blockHas "(param $u____wparg0 (ref eq))" blk))),
    labelFail
      "the shadowing let binder is a different local"
      (expectTrue (blockHas "$xs$1" blk)),
  ]
