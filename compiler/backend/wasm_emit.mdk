-- ── static value kind (scalar-mode only; for the auto-print routing) ─────────
data WTy = WInt | WBool | WUnit | WStr | WRef | WChar | WFloat

-- Per-emission gap lifecycle. Strict is the normal public path; record mode
-- continues with placeholders while preserving first-observed event order.
data WGapMode = WGapStrict | WGapRecord

-- Destination-passing TMC context. It is owned by a fresh WasmEmit so nested
-- and independent emission routes cannot leak loop-local authority.
data WTrmcCtx =
  | WTrmcOff
  | WTrmcOn SelfRef Int (List String) (List (String, Int)) Bool String String

-- the active dispatch-group context during a group member's body emit.  `WDispOn root
-- loopLbl rootArity members` ⇒ redirect SPINE cons leaves (a peeled cons chain
-- bottoming in a saturated call to a group member) to the dest-passing emit +
-- `return_call` (the root's inner loop for the root, the member fn itself otherwise),
-- and base leaves to the dest-close.  WDispOff ⇒ ordinary emit.  Owned by a fresh
-- WasmEmit (peer of WTrmcCtx) so one emission's group authority cannot reach another.
data WDispCtx = WDispOff | WDispOn String String Int (List String)

data WasmEmit = WasmEmit {
  physical : Option WasmDemandPlan,
  externFacts : OrdMap ExternDeclFact,
  gapMode : WGapMode,
  gapLog : Ref (List String),
  curGapBind : Ref String,
  stringSegments : Ref (List (Int, List Int)),
  nextStringSegmentId : Ref Int,
  -- the segment of each distinct literal payload, keyed by `strSegKey` (an OrdMap,
  -- so a lookup is O(log n)).  `freshStrSeg` consults it before allocating.
  strSegIds : Ref (OrdMap Int),
  nextLambdaId : Ref Int,
  liftedDefinitions : Ref (List (List String)),
  liftedDefinitionNames : Ref (OrdMap Unit),
  -- S-4: the capture-free closure globals this emission hoisted.  `constClosIdx`
  -- maps an initializer's TEXT to its global name (the dedup key — an OrdMap, not
  -- a List-as-map, so N distinct cells cost N log N and not N²); `constClosCells`
  -- keeps them in emission order for the module's global section.  See
  -- `wConstClos` for the mechanism.
  constClosIdx : Ref (OrdMap String),
  constClosCells : Ref (List (String, String)),
  nextConstClosId : Ref Int,
  -- the module's physical identities so far and the defects found against them,
  -- latest first (backend/wasm_symbols.mdk).  `closureChecked` is False for the
  -- gap census, which writes no module: there a use need not find its identity.
  -- `completionChecked` is False for the input-isolation harness
  -- (`emitProgramUnchecked`): its mismatched inputs can plan a call whose helper
  -- the plan leaves out, and its module is never assembled, so only the uses
  -- still waiting once it is complete go unjudged.
  symbols : Ref SymbolRegistry,
  symbolDefects : Ref (List SymbolDefect),
  closureChecked : Bool,
  completionChecked : Bool,
  trapImportNeeded : Ref Bool,
  trapIntNeeded : Ref Bool,
  -- located traps: the files a trap site names, in reverse number order, and
  -- their 1-based numbers; whether the located-trap runtime and the shared
  -- non-exhaustive-match trap are called.
  siteFiles : Ref (List String),
  siteFileNums : Ref (OrdMap Int),
  siteRtUsed : Ref Bool,
  siteNonexhUsed : Ref Bool,
  -- coded trap texts: one `$trapmsg_K` helper per DISTINCT text, numbered in
  -- first-use order.  `trapMsgIds` maps a text to its number (an OrdMap, so a
  -- lookup is O(log n)); `trapMsgFns` holds the helper definitions latest-first.
  -- See `trapMsgCall`.
  trapMsgIds : Ref (OrdMap Int),
  trapMsgFns : Ref (List String),
  -- the checked `Int` operators and `Int` shifts this emission called, by helper
  -- name (`add`, `left`, ...), for `intRuntimeLines` (wasm_preamble.mdk).
  intRtUsed : Ref (List String),
  useEPut : Ref Bool,
  useDivGuard : Ref Bool,
  useRng : Ref Bool,
  useHash : Ref Bool,
  useFloatHash : Ref Bool,
  useFloatRng : Ref Bool,
  useFileBytes : Ref Bool,
  useStrCodec : Ref Bool,
  useByteBlock : Ref Bool,
  useValueCmp : Ref Bool,
  useCharFromCode : Ref Bool,
  useCharClass : Ref Bool,
  -- ── lifted from module-level ambient cells (X-W.H) ─────────────────────
  -- PROGRAM-lifetime: the representation / runtime demand the plan's
  -- `wasmDemand` seeds (`seedDemandW`), plus the tuple arities and the
  -- statically-Float top-level globals.  Body emission may turn more on; the
  -- type / import / runtime sections read them.
  useStr : Ref Bool,
  useList : Ref Bool,
  useArray : Ref Bool,
  useRefBox : Ref Bool,
  useStrLeaf : Ref Bool,
  useFloat : Ref Bool,
  useU64 : Ref Bool,
  useI64 : Ref Bool,
  useStrSearch : Ref Bool,
  useValueAdd : Ref Bool,
  useValueSub : Ref Bool,
  useValueMul : Ref Bool,
  useValueDiv : Ref Bool,
  useValueMod : Ref Bool,
  useValueCmpNum : Ref Bool,
  useStrToInt : Ref Bool,
  useStrReverse : Ref Bool,
  useStrJoin : Ref Bool,
  tupleArities : Ref (List Int),
  wDispGroups : Ref (List DispGroup),
  -- the W7 scratch locals (`__rli2`, ...) the function being emitted references;
  -- see w7ScopeOpen.
  w7Used : Ref (OrdMap Unit),
}

freshWasmEmit : WGapMode -> WasmEmit
freshWasmEmit mode = WasmEmit {
  physical = None,
  externFacts = omEmpty,
  gapMode = mode,
  gapLog = Ref [],
  curGapBind = Ref "?",
  stringSegments = Ref [],
  nextStringSegmentId = Ref 0,
  strSegIds = Ref omEmpty,
  nextLambdaId = Ref 0,
  liftedDefinitions = Ref [],
  liftedDefinitionNames = Ref omEmpty,
  constClosIdx = Ref omEmpty,
  constClosCells = Ref [],
  nextConstClosId = Ref 0,
  symbols = Ref emptyRegistry,
  symbolDefects = Ref [],
  closureChecked = True,
  completionChecked = True,
  trapImportNeeded = Ref False,
  trapIntNeeded = Ref False,
  siteFiles = Ref [],
  siteFileNums = Ref omEmpty,
  siteRtUsed = Ref False,
  siteNonexhUsed = Ref False,
  trapMsgIds = Ref omEmpty,
  trapMsgFns = Ref [],
  intRtUsed = Ref [],
  useEPut = Ref False,
  useDivGuard = Ref False,
  useRng = Ref False,
  useHash = Ref False,
  useFloatHash = Ref False,
  useFloatRng = Ref False,
  useFileBytes = Ref False,
  useStrCodec = Ref False,
  useByteBlock = Ref False,
  useValueCmp = Ref False,
  useCharFromCode = Ref False,
  useCharClass = Ref False,
  useStr = Ref False,
  useList = Ref False,
  useArray = Ref False,
  useRefBox = Ref False,
  useStrLeaf = Ref False,
  useFloat = Ref False,
  useU64 = Ref False,
  useI64 = Ref False,
  useStrSearch = Ref False,
  useValueAdd = Ref False,
  useValueSub = Ref False,
  useValueMul = Ref False,
  useValueDiv = Ref False,
  useValueMod = Ref False,
  useValueCmpNum = Ref False,
  useStrToInt = Ref False,
  useStrReverse = Ref False,
  useStrJoin = Ref False,
  tupleArities = Ref [],
  wDispGroups = Ref [],
  w7Used = Ref omEmpty,
}

-- Declaration-derived facts are indexed once for each emission.
import types.capability_manifest.{ManifestRequirement}

data WasmEmitInputData =
  WasmEmitInputData (OrdMap (List Int)) RuntimeExternDomain ManifestRequirement

export type WasmEmitInput = WasmEmitInputData

export
makeWasmEmitInput : ManifestRequirement ->
  RuntimeExternDomain ->
  List (String, List String) ->
  WasmEmitInput
makeWasmEmitInput requirement domain ctorFieldTypes =
  WasmEmitInputData (ctorFloatFieldIndex ctorFieldTypes) domain requirement

export
inputRuntimeExternsW : WasmEmitInput -> RuntimeExternDomain
inputRuntimeExternsW (WasmEmitInputData _ names _) = names

export
inputCtorFloatFieldsW : WasmEmitInput -> OrdMap (List Int)
inputCtorFloatFieldsW (WasmEmitInputData fields _ _) = fields

inputManifestRequirementW : WasmEmitInput -> ManifestRequirement
inputManifestRequirementW (WasmEmitInputData _ _ requirement) = requirement

physicalPlanW : EmitPlan -> WasmDemandPlan
physicalPlanW plan = match plan.wasmPhysical
  Some p => p
  None => panic "internal error: missing-wasm-demand-plan"

emitDemandW : WasmEmit -> WasmDemandPlan
emitDemandW emit = match emit.physical
  Some p => p
  None => panic "internal error: missing-wasm-demand-plan"

seedPhysicalW : WasmEmit -> WasmDemandPlan -> Unit
seedPhysicalW emit physical =
  let _ = seedDemandW emit physical.representation
  let _ =
    forEachU
      ((name, cell) => setRef cell (hasWasmHelper physical name))
      [
        ("strLeafRuntimeLines", emit.useStrLeaf),
        ("strSearchRuntimeLines", emit.useStrSearch),
        ("valueEqRuntimeLines", emit.useValueCmp),
        ("valueCmpNumRuntimeLines", emit.useValueCmpNum),
        ("valueAddRuntimeLines", emit.useValueAdd),
        ("valueSubRuntimeLines", emit.useValueSub),
        ("valueMulRuntimeLines", emit.useValueMul),
        ("valueDivRuntimeLines", emit.useValueDiv),
        ("valueModRuntimeLines", emit.useValueMod),
        ("floatRuntimeLines", emit.useFloat),
        ("stderrByteImportLines", emit.trapImportNeeded),
        ("trapIntRuntimeLines", emit.trapIntNeeded),
      ]
  let _ = setRef emit.intRtUsed physical.intHelpers
  let _ = setRef emit.siteRtUsed physical.siteRuntime
  setRef emit.siteNonexhUsed physical.nonexhaustiveRuntime

-- ── program info threaded through the ref-mode emitter ───────────────────────
-- WasmProgramIndex owns the declaration-derived function, value, constructor,
-- record-fallback, lazy-global, and per-method-impl lookup tables for this emission.
-- Prog retains only the remaining ordered carriers: user type names, value-global
-- names, closure-use flag, impl entries, and declaration-derived input.
data WasmFnImplIndex = WasmFnImplIndex {
  fnNames : OrdMap Unit,
  valNames : OrdMap Unit,
  -- the defined arity of every top-level binding, constructor and impl entry
  -- (`core_ir_lower.programArities`)
  arities : ArityEnv,
  implBuckets : OrdMap (List CImplEntry),
  lazyGlobals : OrdMap Unit,
  -- the super count of each interface word (`DeclFacts.factSupers`); a word
  -- absent from it has no supers
  superCounts : OrdMap Int,
  -- the plan's self-recursive TRMC verdict (`EmitPlan.trmc`)
  trmc : TrmcVerdicts,
}

data WasmRecordValueIndex = WasmRecordValueIndex { fnValues : OrdMap Unit }

data WasmCtorIndex = WasmCtorIndex {
  arities : OrdMap Int,
  types : OrdMap String,
  ordinals : OrdMap Int,
  typeCtors : OrdMap (List String),
}

-- The program's binder table (`DeclFacts.factBinders`): every row by the
-- ordinal of its id (printed, so an env entry can name a row without parsing),
-- and the row of each top-level binding by its name.
data WasmStamps = WasmStamps {
  rows : OrdMap BinderRow,
  tops : OrdMap BinderRow,
}

data WasmProgramIndex = WasmProgramIndex {
  fnImpl : WasmFnImplIndex,
  recordValue : WasmRecordValueIndex,
  ctor : WasmCtorIndex,
  stamps : WasmStamps,
  typeContext : WasmTypeContext,
}

makeWasmStamps : List CBind -> List BinderRow -> WasmStamps
makeWasmStamps groups binderRows =
  let rows =
    omFromPairs
      (reverseL (map (r => (intToString (binderOrdinal r.brId), r)) binderRows))
      omEmpty
  WasmStamps {
    rows = rows,
    tops = omFromPairs (reverseL (flatMap (topRow rows) groups)) omEmpty,
  }

topRow : OrdMap BinderRow -> CBind -> List (String, BinderRow)
topRow rows (CBind name _ _ bid) =
  match omLookup (intToString (binderOrdinal bid)) rows
    Some row => [(name, row)]
    None => []

data Prog =
  Prog WasmProgramIndex (List String) (List String) Bool (List CImplEntry) WasmEmitInput WasmEmit FnCtx

-- What is true of the ONE function whose body is being emitted: the TMC loop
-- or dispatch-group context its tail leaves redirect to, its first-clause site
-- (packed by `sitePackedW`, 0 for none), and the binding name its gap messages
-- cite.  It is a value of the `Prog` the body is emitted with, never a cell: a
-- function that needs a different context emits its body with a derived `Prog`
-- (`progInFn`, `progForBinding`, `progWithTrmc`, `progWithDisp`), so there is no
-- state to restore, and a lifted lambda or let-group member starts without its
-- encloser's TMC loop, dispatch group or clause site however it was reached.  A
-- lifted lambda keeps citing its encloser's binding name.
data FnCtx = FnCtx {
  trmc : WTrmcCtx,
  disp : WDispCtx,
  site : Int,
  binding : String,
  origin : SymbolOrigin,
  localSlots : Ref (OrdMap LocalSlot),
  localTypes : Ref (List WasmRepr),
  nextLocal : Ref Int,
}

freshFnCtx : Unit -> FnCtx
freshFnCtx () = FnCtx {
  trmc = WTrmcOff,
  disp = WDispOff,
  site = 0,
  binding = "?",
  origin = SymbolOrigin "?" "" 0 0,
  localSlots = Ref omEmpty,
  localTypes = Ref [],
  nextLocal = Ref 0,
}

progValNames : Prog -> List String
progValNames (Prog _ _ vals _ _ _ _ _) = vals

progUseClos : Prog -> Bool
progUseClos (Prog _ _ _ uc _ _ _ _) = uc

-- W5: the lowered typeclass impl entries (CProgram's 4th field).
progImpls : Prog -> List CImplEntry
progImpls (Prog _ _ _ _ impls _ _ _) = impls

progIndex : Prog -> WasmProgramIndex
progIndex (Prog index _ _ _ _ _ _ _) = index

progEmit : Prog -> WasmEmit
progEmit (Prog _ _ _ _ _ _ emit _) = emit

progFnCtx : Prog -> FnCtx
progFnCtx (Prog _ _ _ _ _ _ _ fn) = fn

-- [prog] for emitting the body of another function: no TMC loop, no dispatch
-- group, no clause site; the binding name is inherited.
progInFn : Prog -> Prog
progInFn prog = progWithFnCtx prog { freshFnCtx () |
  binding = (progFnCtx prog).binding,
  origin = (progFnCtx prog).origin,
}

-- [progInFn prog] for the binding [name] at [loc], whose first clause is at [site].
progForBinding : String -> Loc -> Int -> Prog -> Prog
progForBinding name loc site prog = progWithFnCtx prog { freshFnCtx () |
  site = site,
  binding = name,
  origin = bindingOrigin name loc,
}

-- [prog] with its physical definitions and uses attributed to [label], for a
-- body that has no source binding of its own (an impl method, `main`, a value).
progWithOrigin : String -> Prog -> Prog
progWithOrigin label prog =
  progWithFnCtx prog { progFnCtx prog | origin = SymbolOrigin label "" 0 0 }

-- The binding name the body being emitted with [prog] cites in a gap message.
progBinding : Prog -> String
progBinding prog = (progFnCtx prog).binding

-- [prog] with [ctx] as the Stage-1 TMC loop context of the body about to be emitted.
progWithTrmc : WTrmcCtx -> Prog -> Prog
progWithTrmc ctx prog = progWithFnCtx prog { progFnCtx prog | trmc = ctx }

-- [prog] with [ctx] as the dispatch-group context of the body about to be emitted.
progWithDisp : WDispCtx -> Prog -> Prog
progWithDisp ctx prog = progWithFnCtx prog { progFnCtx prog | disp = ctx }

progWithFnCtx : Prog -> FnCtx -> Prog
progWithFnCtx (Prog index types vals uc impls input emit _) fn =
  Prog index types vals uc impls input emit fn

indexFnNamesW : WasmProgramIndex -> OrdMap Unit
indexFnNamesW index = index.fnImpl.fnNames

indexValNamesW : WasmProgramIndex -> OrdMap Unit
indexValNamesW index = index.fnImpl.valNames

indexAritiesW : WasmProgramIndex -> ArityEnv
indexAritiesW index = index.fnImpl.arities

indexImplsByMethodW : WasmProgramIndex -> OrdMap (List CImplEntry)
indexImplsByMethodW index = index.fnImpl.implBuckets

indexLazyGlobalsW : WasmProgramIndex -> OrdMap Unit
indexLazyGlobalsW index = index.fnImpl.lazyGlobals

progTrmcW : Prog -> TrmcVerdicts
progTrmcW prog = (progIndex prog).fnImpl.trmc

indexFnsUsedAsValuesW : WasmProgramIndex -> OrdMap Unit
indexFnsUsedAsValuesW index = index.recordValue.fnValues

indexCtorAritiesW : WasmProgramIndex -> OrdMap Int
indexCtorAritiesW index = index.ctor.arities

indexCtorTypesW : WasmProgramIndex -> OrdMap String
indexCtorTypesW index = index.ctor.types

indexCtorOrdinalsW : WasmProgramIndex -> OrdMap Int
indexCtorOrdinalsW index = index.ctor.ordinals

indexTypeCtorsW : WasmProgramIndex -> OrdMap (List String)
indexTypeCtorsW index = index.ctor.typeCtors

-- ── declaration-derived semantic input readers ────────────────────────────────
-- the DECLARATION word of the interface an impl entry implements (mirror of
-- llvm_emit's `implEntryIfaceWord`): a supplied method carries it as the first field
-- of its route key, an inherited default directly as `CImplDefault`'s first field —
-- the same `ifaceWordOf` word a `CMethod` occurrence carries (`narrowByIfaceW`).
implEntryIfaceWordW : CImplEntry -> String
implEntryIfaceWordW (CImplEntry _ _ _ (CImplTagged _ _ iface _ _ _ _)) = iface
implEntryIfaceWordW (CImplEntry _ _ _ (CImplDefault ifaceWord _ _ _ _ _ _)) =
  ifaceWord

-- the head tag / canonical key / clause of any per-instance entry
implEntryTagW : CImplEntry -> String
implEntryTagW (CImplEntry _ _ _ (CImplTagged t _ _ _ _ _ _)) = t
implEntryTagW (CImplEntry _ _ _ (CImplDefault _ t _ _ _ _ _)) = t

implEntryKeyW : CImplEntry -> String
implEntryKeyW (CImplEntry _ _ _ (CImplTagged _ k _ _ _ _ _)) = k
implEntryKeyW (CImplEntry _ _ _ (CImplDefault _ _ k _ _ _ _)) = k

implEntryPatsW : CImplEntry -> List Pat
implEntryPatsW (CImplEntry _ _ _ (CImplTagged _ _ _ _ _ pats _)) = pats
implEntryPatsW (CImplEntry _ _ _ (CImplDefault _ _ _ _ _ pats _)) = pats

implEntryMethodW : CImplEntry -> String
implEntryMethodW (CImplEntry m _ _ _) = m

-- does [entry] answer to the route word [word]?  A word names exactly one instance.
implEntryAnswersW : String -> CImplEntry -> Bool
implEntryAnswersW word entry = implEntryKeyW entry == word

-- the entries of the interface an occurrence resolved to (`""`: none recorded, and
-- nothing is narrowed), so two interfaces' same-spelled methods are never candidates
-- for one another (#1265, #1619)
narrowByIfaceW : String -> List CImplEntry -> List CImplEntry
narrowByIfaceW "" entries = entries
narrowByIfaceW iface entries =
  filterList (ent => implEntryIfaceWordW ent == iface) entries

-- #2076: the wasm peer of `llvm_emit.mdk`'s `ffiSigOf`/`isFfiExtern` — the host
-- bindings of `name` when it is a USER-declared FFI extern.  Built from
-- `makeWasmEmitInput`'s rows (empty for every caller of `makeWasmEmitInput`).
-- Consulted by `emitAppRef`/`emitTailCallW`/`emitVarRefPlain` ahead of the
-- runtime extern families, as `DemandScope` resolves a name.
ffiBindsOfW : Prog -> String -> Option (List (String, String))
ffiBindsOfW prog name = match omLookup name (progEmit prog).externFacts
  Some fact if fact.bindingKind == ForeignBinding => Some fact.hostBindings
  _ => None

isFfiExternW : Prog -> String -> Bool
isFfiExternW prog name = isSome (ffiBindsOfW prog name)

-- The plan's `jsffi` import for the user extern `name`, or the gap its
-- reference is.  `check --target` refuses a reached extern with no `js`
-- binding (T-TARGET-NO-BINDING), so only a lowering that skipped the target
-- check meets the last gap.  An `Array Int` result has no channel on either target
-- (compiler/FFI-ABI.md section 2.4), so wasm refuses it as native does.
jsImportForW : Prog -> String -> Result (List String) JsImport
jsImportForW prog name = match selectedJsImport prog name
  Some imp =>
    if not (allList jsCrossableHead (imp.result :: imp.params)) then
      Err
        (gapLP
          prog
          "wasm: a non-crossable type reached the lowering of foreign call '\{externDisplayW (progEmit prog) name}' (compiler/FFI-ABI.md section 1)")
    else if imp.result == "Array" then
      Err
        (gapLP
          prog
          "wasm: foreign call '\{externDisplayW (progEmit prog) name}' returns 'Array Int', which no FFI target can return (compiler/FFI-ABI.md section 2.4, docs/spec/WASM-SEMANTICS.md section 3.1). Declare the array as a parameter instead and have the binding fill it in place: its elements are copied back after the call returns")
    else
      Ok imp
  None => match ffiBindsOfW prog name
    Some binds if isSome (hostSymbol "js" binds) =>
      Err
        (gapLP
          prog
          "internal error: the emit plan has no `jsffi` import for the reached extern '\{externDisplayW (progEmit prog) name}'")
    _ =>
      Err
        (gapLP
          prog
          "wasm: the extern '\{externDisplayW (progEmit prog) name}' has no `js` binding, so the module has nothing to import for it; `check --target` refuses a reached extern with no binding for its target's host (T-TARGET-NO-BINDING)")

selectedJsImport : Prog -> String -> Option JsImport
selectedJsImport prog name = match omLookup name (progEmit prog).externFacts
  Some fact if fact.bindingKind
    == ForeignBinding => match hostSymbol "js" fact.hostBindings
    Some host =>
      map
        (shape => JsImport {
          medakaName = name,
          jsName = host,
          params = shape.parameterHeads,
          result = shape.resultHead,
        })
        fact.callableShape
    None => None
  _ => None

-- A user extern applied: with all its arguments, the arguments and then its
-- wrapper (`jsffiWrapperLines`); otherwise its eta closure, applied.
emitFfiAppW : Prog ->
  Env ->
  Int ->
  CExpr ->
  String ->
  List CExpr ->
  CallEndW ->
  List String
emitFfiAppW prog env d hd name args end = match jsImportForW prog name
  Err gap => gap
  Ok imp =>
    if listLen args == listLen imp.params then
      flatMap (a => emitRefExpr prog env d a) args
        ++ [callFnW prog end (jsffiWrapperW prog imp) (listLen args)]
    else
      emitIndirectApp prog env d hd args end

-- A user extern named as a value: a captureless closure whose code unpacks its
-- arguments and calls the wrapper (the native peer is `emitFfiEtaClosure`).
emitFfiEtaW : Prog -> String -> List String
emitFfiEtaW prog name = match jsImportForW prog name
  Err gap => gap
  Ok imp =>
    let arity = listLen imp.params
    let lamName = "$mdk_ffi_" ++ injectiveIdent name
    let params = synthParams arity
    let body =
      flatMap argLoadAt (zipIdx params 0)
        ++ map (p => "local.get $" ++ gname p) params
        ++ [callFnW prog CallValueW (jsffiWrapperW prog imp) arity, "return"]
    let _ = noteFuncRef prog lamName
    let _ =
      addLiftedNamed
        prog
        lamName
        codeShapeW
        ([
            "  (func "
              ++ lamName
              ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
          ]
          ++ map ("    " ++ _) (map localDeclRef params)
          ++ indent body
          ++ ["  )"])
    wConstClos prog lamName arity

-- The binding's wrapper, lifted once; its name without the `$`.  Its traps are
-- the native boundary's (compiler/FFI-ABI.md section 2.1a, 2.4).
jsffiWrapperW : Prog -> JsImport -> String
jsffiWrapperW prog imp =
  let emit = progEmit prog
  let name = jsffiWrapperId imp.medakaName
  let call = "foreign call '\{imp.jsName}'"
  let intTrap =
    if imp.result == "Int" then
      wasmTrap
        emit
        "E-PANIC"
        "\{call} returned a value outside Int's range -4611686018427387904..4611686018427387903 (docs/spec/WASM-SEMANTICS.md section 3.1); declare the result I64 to receive the full 64-bit range"
    else
      []
  let charTrap =
    if imp.result == "Char" then
      wasmTrap
        emit
        "E-PANIC"
        "\{call} returned a value that is not a valid Char: a Char must be a Unicode scalar, i.e. in 0..1114111 excluding the UTF-16 surrogates 55296..57343 (docs/spec/WASM-SEMANTICS.md section 3.1)"
    else
      []
  let copyTrap =
    if contains "Array" imp.params then
      wasmTrap
        emit
        "E-PANIC"
        "\{call} wrote a value outside Int's range -4611686018427387904..4611686018427387903 into an Array Int argument (docs/spec/WASM-SEMANTICS.md section 3.1)"
    else
      []
  let _ =
    addLiftedNamed
      prog
      ("$" ++ name)
      (FuncParams (listLen imp.params))
      (jsffiWrapperLines imp intTrap charTrap copyTrap)
  name

progFnMemberW : Prog -> String -> Bool
progFnMemberW prog n = omHasKey n (indexFnNamesW (progIndex prog))

-- val-name membership is served by this Prog's immutable index.
progValMemberW : Prog -> String -> Bool
progValMemberW prog x = omHasKey x (indexValNamesW (progIndex prog))

-- Pre-Prog scans receive this invocation's locally-built fn index directly.
fnMemberIndexW : OrdMap Unit -> String -> Bool
fnMemberIndexW fnNames n = omHasKey n fnNames

-- ── impl INDEX by method name (perf #382 — the #350/#349 twins) ───────────────
-- The `Prog` carries every impl clause as one flat `List CImplEntry` (`progImpls`),
-- and the emitter scans the WHOLE list per RKey/RDict dispatch site: `implForW`,
-- `methodImpls`,
-- `methodReturnsBoolW`, and the `emitImplFns`/`gatherImplGroup` group builder all do
-- `findByKeyArityW`/`flatMap implClauseFor`/`flatMap methodImplKey` over one method bucket.
-- EVERY one of those first filters by the METHOD name (`n == method`) — so restricting
-- the scan to just that method's entries yields the IDENTICAL first-match/flat-map
-- result, only faster.  Wasm inlines a dispatch chain PER call site (llvm outlines one
-- dispatcher), so these per-site scans multiply → O(sites · impls) on dispatch-heavy
-- code (#382). The private immutable index groups the entries by method name once per
-- invocation into per-method lists in ORIGINAL ORDER, so a multi-clause impl's first
-- clause still wins findByKeyArityW. Every per-method scan below routes through it.
-- method name of an impl entry (field 1 — the interface method it implements).
implEntryMethod : CImplEntry -> String
implEntryMethod (CImplEntry n _ _ _) = n

orEmptyEntriesW : Option (List CImplEntry) -> List CImplEntry
orEmptyEntriesW (Some xs) = xs
orEmptyEntriesW None = []

-- one LEFT fold prepending each entry to its method's bucket (O(1) per entry), then
-- `omMapValues reverseL` restores original order in each bucket — total O(entries).
-- (A right-append build would be O(bucket²) on a many-impl method; prepend+reverse is
-- linear, the same discipline the fn-index / ctor tables use.)
groupImplsByMethodW : List CImplEntry -> OrdMap (List CImplEntry)
groupImplsByMethodW entries =
  omMapValues reverseL (foldImplsByMethodW entries omEmpty)

makeWasmProgramIndex : EmitPlan ->
  DeclFacts ->
  List CBind ->
  List (String, Int) ->
  List (String, String) ->
  List CImplEntry ->
  List String ->
  List String ->
  WasmProgramIndex
makeWasmProgramIndex plan facts groups ctorArs ctorTypes impls fnNames valNames =
  makeWasmProgramIndexWithLazy
    plan.wasmInputs.ctorFloatFields
    facts
    groups
    ctorArs
    ctorTypes
    impls
    fnNames
    valNames
    plan.lazyGlobals
    plan.trmc

makeWasmProgramIndexGaps : OrdMap (List Int) ->
  TrmcVerdicts ->
  DeclFacts ->
  List CBind ->
  List (String, Int) ->
  List (String, String) ->
  List CImplEntry ->
  List String ->
  List String ->
  WasmProgramIndex
makeWasmProgramIndexGaps ctorFields trmc facts groups ctorArs ctorTypes impls fnNames valNames =
  makeWasmProgramIndexWithLazy
    ctorFields
    facts
    groups
    ctorArs
    ctorTypes
    impls
    fnNames
    valNames
    []
    trmc

makeWasmProgramIndexWithLazy : OrdMap (List Int) ->
  DeclFacts ->
  List CBind ->
  List (String, Int) ->
  List (String, String) ->
  List CImplEntry ->
  List String ->
  List String ->
  List String ->
  TrmcVerdicts ->
  WasmProgramIndex
makeWasmProgramIndexWithLazy ctorFields facts groups ctorArs ctorTypes impls fnNames valNames lazyNames trmc =
  let fnIndex = omFromNames fnNames omEmpty
  let valIndex = omFromNames valNames omEmpty
  let ctorArIndex = omFromPairs (reverseL ctorArs) omEmpty
  let ctorTyIndex = omFromPairs (reverseL ctorTypes) omEmpty
  let typeCtors = typeCtorsOfW (reverseL ctorTypes) omEmpty
  let ctorOrds =
    ctorOrdsOfW (distinctTypeNames ctorTypes) ctorTyIndex typeCtors omEmpty
  let usedFns =
    scanFnValueUses fnIndex ctorArs groups
      ++ scanImplValueUses fnIndex ctorArs impls
  WasmProgramIndex {
    fnImpl = WasmFnImplIndex {
      fnNames = fnIndex,
      valNames = valIndex,
      arities =
        programArities (CProgram groups ctorArs ctorTypes impls [] noDeclFacts),
      implBuckets = groupImplsByMethodW impls,
      lazyGlobals = omFromNames lazyNames omEmpty,
      superCounts = omFromPairs facts.factSupers omEmpty,
      trmc = trmc,
    },
    recordValue = WasmRecordValueIndex {
      fnValues = omFromNames usedFns omEmpty,
    },
    ctor = WasmCtorIndex {
      arities = ctorArIndex,
      types = ctorTyIndex,
      ordinals = ctorOrds,
      typeCtors = typeCtors,
    },
    stamps = makeWasmStamps groups facts.factBinders,
    typeContext =
      wasmTypeContext
        ctorFields
        (CProgram groups ctorArs ctorTypes impls [] facts),
  }

foldImplsByMethodW : List CImplEntry ->
  OrdMap (List CImplEntry) ->
  OrdMap (List CImplEntry)
foldImplsByMethodW [] m = m
foldImplsByMethodW (e :: rest) m =
  let k = implEntryMethod e
  foldImplsByMethodW rest (omInsert k (e :: orEmptyEntriesW (omLookup k m)) m)

-- [method]'s impl entries from this Prog's immutable bucket, in original order.
-- Every whole-`progImpls` per-site scan routes through this lookup.
methodEntriesW : Prog -> String -> List CImplEntry
methodEntriesW prog method =
  orEmptyEntriesW (omLookup method (indexImplsByMethodW (progIndex prog)))

-- The defined arity of a callee reached outside an application (a value-position
-- occurrence, a dispatch-group member), read from the program as
-- `core_ir_lower.stampCallModes` reads it for an application.
definedArityW : Prog -> CExpr -> Option Int
definedArityW prog hd =
  definedArityOf (indexAritiesW (progIndex prog)) omEmpty hd

-- a top-level function's parameter count, or -1 when [n] names no function (the
-- contract the shared dispatch-group detection takes)
fnParamCountW : Prog -> String -> Int
fnParamCountW prog n =
  if progFnMemberW prog n then
    optionOr (-1) (definedArityW prog (CVar n AGlobal))
  else
    -1

-- W9: canonicalize a referenced fn name against the defined-fn set, mirroring DCE's
-- canonRef + the LLVM emitter's canonFnName.  Mangling renames prelude defs to
-- `core__<name>` AND rewrites the uses it can see; under the old mangle-first order it
-- ran before the passes that SYNTHESIZE bare prelude references (notably string-interp
-- `\{e}` → `debug`/`debugStringLit`/`displayListItems`, and `/=` → `not`), so such a
-- bare ref did not match its `core__`-mangled def by string equality.  The repair: if
-- the bare name isn't a defined fn but its `core__` form is, use the mangled name.
-- Since #2809 the emit drivers elaborate FIRST and mangle after, so those synthesized
-- references are renamed too.  Accommodation 12 of the census in
-- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` SA-10a item 20, and it retires with it —
-- each of the four mirrored copies on its own measurement.
canonFn : Prog -> String -> String
canonFn prog n =
  if progFnMemberW prog n then
    n
  else if progFnMemberW prog ("core__" ++ n) then
    "core__" ++ n
  else
    n

-- ── program entry ────────────────────────────────────────────────────────────
-- Names of lifted defines whose body is fully determined by the name (the eta-wrap
-- ctor `$mdk_wctor_<C>` and extern `$mdk_ext_<name>` closures) — used to dedup so a
-- ctor/extern referenced point-free at MORE THAN ONE site emits its lifted (func …)
-- ONCE.  `noteFuncRef` already deduped the matching `(elem declare)`, but `addLifted`
-- did not dedup the define, so a second use-site duplicated the func → "duplicate func
-- identifier" at wasm-tools assembly (`$mdk_lamN` names are unique, so they still route
-- through the plain `addLifted`).  Per-emission `WasmEmit` state owns its dedup set.
-- perf #382: both named-lift and function-reference sets preserve O(log n) membership;
-- companion lists retain insertion order for their module-end drains.

-- ── W6 string state ──────────────────────────────────────────────────────────
-- `useStr` records whether the program uses any String/Char literal, the
-- byte-level IO externs (putStr/putStrLn/…), or a String-returning extern
-- (intToString/charToStr/stringConcat/…) — any of which forces the §3.3 `$str`
-- aggregate + the byte-write runtime into the module (and ref-mode, since a String
-- is a boxed (ref eq) value).  `WasmEmit.stringSegments` accumulates the passive data
-- segments for string literals: one `(data $strseg_N "…")` per DISTINCT byte payload
-- (`freshStrSeg` interns by content), init'd via `array.new_data`, the
-- §11-preferred non-const-array scheme. Both segment state and `useStr` itself belong
-- to each fresh `WasmEmit` record (a `Ref Bool` field, not an ambient cell).
-- ── gap census (mirrors LLVM's per-emission gap recording) ───────────────────
-- The WasmGC emitter normally `panic`s at the first node it can't lower (`gap`).
-- In CENSUS mode the gap helpers instead RECORD the reason and return a
-- type-appropriate placeholder so emission CONTINUES, surfacing EVERY gap over the
-- whole compiler graph in one run (the LLVM-self-hosting playbook).  Default
-- (record OFF) is behaviourally identical to today — every gap still `panic`s the
-- same message, so the existing gates stay green.
-- The event log and its attribution travel only in `WasmEmit`; no gap state is
-- shared between public emission calls.
gapEventsOfW : WasmEmit -> List String
gapEventsOfW emit = reverseL !emit.gapLog

setGapBindingOfW : WasmEmit -> String -> Unit
setGapBindingOfW emit name = setRef emit.curGapBind name

noteGapW : WasmEmit -> String -> Unit
noteGapW emit reason = noteGapAtW emit !emit.curGapBind reason

noteGapAtW : WasmEmit -> String -> String -> Unit
noteGapAtW emit binding reason =
  setRef emit.gapLog ("\{binding}\t\{reason}" :: !emit.gapLog)

-- typed gap-tolerant variants, one per return shape the `gap` call sites need.
-- Each records (census mode) or panics (default), returning a placeholder.
gapL : WasmEmit -> String -> List String
gapL emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in []
  WGapStrict => gap reason

gapLTy : WasmEmit -> String -> (List String, WTy)
gapLTy emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in ([], WInt)
  WGapStrict => gap reason

-- an unresolved name is an OBSERVATION ("this lookup found nothing"), not a
-- claim that wasm codegen lacks coverage for it — `gap`'s "wasm_emit gap — "
-- prefix asserts the latter, and asserting a category the emitter cannot
-- verify is exactly what T-22 (AGENTS.md) is about: on the untypechecked,
-- prelude-free probe path an interface method occurrence (e.g. `.[i]`'s
-- `index`) NEVER resolves to anything but a bare unbound name — not because
-- wasm codegen is missing it, but because the probe skipped typecheck/marker,
-- the pass that would have turned it into a dispatchable `CMethod`.  Twelve+
-- fixtures sat ledgered as "wasm gaps" for weeks on exactly this laundered
-- claim (test/engine_divergence.txt).  So an unbound-name lookup miss is
-- reported plainly — no "gap" wording, let the reader diagnose the cause —
-- while every OTHER gap call site here is a genuine, verified codegen-coverage
-- gap (an exhaustive match with no arm for the node/op/extern shape) and keeps
-- the `gap` wording, which is accurate for that case.
gapUnboundL : WasmEmit -> String -> List String
gapUnboundL emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in []
  WGapStrict => panic reason

gapUnboundLTy : WasmEmit -> String -> (List String, WTy)
gapUnboundLTy emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in ([], WInt)
  WGapStrict => panic reason

gapS : WasmEmit -> String -> String
gapS emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in "0"
  WGapStrict => gap reason

gapSInt : WasmEmit -> String -> (String, Int)
gapSInt emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in ("0", 0)
  WGapStrict => gap reason

gapOptE : WasmEmit -> String -> Option CExpr
gapOptE emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in None
  WGapStrict => gap reason

gapL2 : WasmEmit -> String -> (List String, Env)
gapL2 emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in ([], envEmpty)
  WGapStrict => gap reason

gapL3 : WasmEmit -> String -> (List String, List String, Env)
gapL3 emit reason = match emit.gapMode
  WGapRecord => let _ = noteGapW emit reason in ([], [], envEmpty)
  WGapStrict => gap reason

gapLP : Prog -> String -> List String
gapLP prog reason = gapL (progEmit prog) reason

gapUnboundLP : Prog -> String -> List String
gapUnboundLP prog reason = gapUnboundL (progEmit prog) reason

-- The fallthrough for a runtime extern wasm does not lower.  The extern check
-- (`refuseUnprovidedExternsW`) has already refused it in strict mode and
-- recorded it in record mode, so record mode adds no second event, and strict
-- mode reaching here means the two disagree about which references are free.
unprovidedExternW : WasmEmit -> String -> List String
unprovidedExternW emit name = match emit.gapMode
  WGapRecord => []
  WGapStrict => panic (unrefusedExternMessage WasmBackend name)

gapSP : Prog -> String -> String
gapSP prog reason = gapS (progEmit prog) reason

gapSIntP : Prog -> String -> (String, Int)
gapSIntP prog reason = gapSInt (progEmit prog) reason

gapL2P : Prog -> String -> (List String, Env)
gapL2P prog reason = gapL2 (progEmit prog) reason

gapL3P : Prog -> String -> (List String, List String, Env)
gapL3P prog reason = gapL3 (progEmit prog) reason

-- ── W7 collection state ──────────────────────────────────────────────────────
-- Which collection reps the program actually uses (gates their type-section decls,
-- peer to `useStr`).  `useList`: any CList/CRangeList or a HCons/HNil match
-- head → the cons-cell `$C_Cons` + root `$T_List` (Nil is an i31).  `useArray`:
-- any CArray/CRangeArray/CIndex/CSlice → the `$arr` (array (mut (ref eq))) type.
-- `useRefBox`: any Ref/setRef/.value → the `$refbox` 1-field mutable struct.
-- `tupleArities`: the distinct tuple arities present (CTuple / HTuple) → one
-- per-arity struct `$C_TupN`.  Records reuse the EXISTING per-ctor struct ($C_<ctor>,
-- already declared by the W3 ctor type section since a named-field ctor is in the
-- ctor table) — they need no new type, only the field-order table below.
-- ── W8 extern-use state ──────────────────────────────────────────────────────
-- Which W8 LEAF runtime groups the program reaches (gates their preamble
-- emission, peer to useStr).  useStrLeaf: any pure-WAT string leaf op
-- (++/charToStr/stringConcat/stringSlice/toUpper/toLower) → the strLeafRuntime.
-- The per-emission RNG/hash observations live in WasmEmit; `WasmEmit.useEPut` gates the
-- stderr import + runtime.
-- B5 (RUNTIME-TRAP-UNIFY §3 (5)): per-emission event set while a coded runtime trap
-- writes stderr bytes. Body emission precedes late scalar/ref import bindings, so strict
-- lets expose this physical fact without ambient authority.

isLazyGlobalW : Prog -> String -> Bool
isLazyGlobalW prog x = omHasKey x (indexLazyGlobalsW (progIndex prog))

-- W8b: the program uses Float (a Float literal, a Float extern, or a Float arith op).
-- Forces ref-mode (a Float is a boxed (ref eq) $float struct) + gates the Float runtime
-- (floatRuntimeLines + the floatToString host import).  WasmEmit.useFloatHash / useFloatRng
-- gate the hashFloat / randomFloat runtimes (which need the shared mix64 / next_u64).

-- W8b: the program uses stringIndexOf / stringCompare (the strSearchRuntime).
-- WasmEmit.useValueCmp records layer-9 per-emission demand from a ref-mode
-- `==`/`/=`/ordering binop in a string-using program for the runtime-shape-dispatched
-- $mdk_value_eq / $mdk_value_cmp
-- (Core IR is type-erased, so a String `==` cannot be told from an Int `==` statically;
-- the old i31-only lowering trapped `illegal cast` on a String operand).  Its producer
-- also forces useStrSearch so $mdk_str_compare (the byte comparator) is in scope.

-- A0/A1 (poly-`Num`-on-Float): the program routes an arithmetic binop through the
-- runtime value-tag-dispatched $mdk_value_add/sub/mul/div/mod helpers (a polymorphic
-- `Num a` operand — see isPolyNumOperand).  Gates valueArithRuntimeLines.
-- A1 (poly-`Num`-on-Float): the pattern-var names bound at the CURRENT function's
-- POLYMORPHIC `Num`/`Ord` param positions — a param whose declared type head is a type
-- VARIABLE (lowercase-initial) used arithmetically, OR (no declared sig) any param used
-- arithmetically.  The wasm peer of native's `isNumPolyParam`/LTNum seed.  A binop with
-- such an operand routes to the runtime value-dispatch helper instead of the trapping
-- inline int primitive; the static Int/Float fast paths (declared `Int`/`Float`, literals,
-- structural Float) are unchanged.  Seeded (and reset to []) per fn in emitRefFnBind.
-- W12: the program uses any IO host-surface extern (readFile / fileExists / args /
-- getEnv / exit).  Gates the IO host imports + the byte-channel marshaling runtime.
-- All of these touch a $str (path/result), so they also force useStr.
-- W8b: the names KNOWN to hold a Float in the CURRENT function/impl body — set while
-- emitting an `impl Num Float` (etc.) method, whose params are Float but appear as bare
-- CVars the structural detector can't otherwise see.  `cexprIsFloat` consults this so
-- `add a b = a + b` lowers to f64 ops.  Reset to [] before every non-Float-impl body.
-- #288: top-level nullary value bindings whose RHS is statically Float (e.g.
-- `nan = 0.0 / 0.0`).  A `global.get` of such a binding carries no static Float
-- tag at the USE site, so a `nan <= nan` comparison would fall to the poly
-- runtime-dispatched path.  Seeding these names (in emitRefProgram, before any body
-- emission) lets `cexprIsFloat` recognize the operand as Float so the comparison
-- lowers to inline `f64.le`/`f64.ge` (IEEE-correct, NaN → False), mirroring native's
-- fcmp on a global whose stamp is Float.
-- (#305: the poly path is IEEE-correct at NaN too now — ordering there calls the
-- per-op $mdk_value_lt/le/gt/ge rather than comparing a 3-way against 0 — so this
-- seeding is a code-quality win (inline f64, no call), no longer a correctness fix.)
-- convert one ctorFieldTypeNames entry to (ctorName, [floatFieldIndex, …]).
freshStrSeg : Prog -> List Int -> Int
freshStrSeg prog bytes =
  let emit = progEmit prog
  let key = strSegKey bytes
  match omLookup key !emit.strSegIds
    Some i => i
    None =>
      let i = !emit.nextStringSegmentId
      let _ = setRef emit.nextStringSegmentId (i + 1)
      let _ = setRef emit.stringSegments ((i, bytes) :: !emit.stringSegments)
      let _ = setRef emit.strSegIds (omInsert key i !emit.strSegIds)
      let _ =
        registerW
          emit
          (declareSymbol
            (WasmData (strSegNameW i))
            DataDecl
            (progFnCtx prog).origin)
      i

-- the name of string segment [i], without its `$`
strSegNameW : Int -> String
strSegNameW i = "strseg_" ++ intToString i

-- `$strseg_<i>` read by a body
strSegRefW : Prog -> Int -> String
strSegRefW prog i =
  let _ =
    registerW
      (progEmit prog)
      (checkRef (WasmData (strSegNameW i)) (progFnCtx prog).origin)
  "$" ++ strSegNameW i

-- the `strSegIds` key of a payload: its byte values, comma-separated.  Distinct byte
-- lists give distinct keys (a comma follows every value but the last, and only the
-- empty list spells as "").
strSegKey : List Int -> String
strSegKey bytes = joinWith "," (map intToString bytes)

freshLamId : WasmEmit -> Int
freshLamId emit =
  let n = !emit.nextLambdaId
  let _ = setRef emit.nextLambdaId (n + 1)
  n

-- Lift the definition [def] of function [name], whose shape is [shape].  The
-- lifted section is written only for a module with closures, so only there does
-- the registry learn of the definition.
addLifted : Prog -> String -> WasmShape -> List String -> Unit
addLifted prog name shape def =
  let emit = progEmit prog
  let _ = if progUseClos prog then defineFnW prog name shape
  setRef emit.liftedDefinitions (def :: !emit.liftedDefinitions)

-- addLifted, but keyed by a unique define name: a second call
-- with an already-seen name is a no-op, so a point-free ctor/extern used at N sites
-- lifts its (func …) exactly once.
addLiftedNamed : Prog -> String -> WasmShape -> List String -> Unit
addLiftedNamed prog name shape def =
  let emit = progEmit prog
  if omHasKey name !emit.liftedDefinitionNames then
    ()
  else
    let _ =
      setRef
        emit.liftedDefinitionNames
        (omInsert name () !emit.liftedDefinitionNames)
    addLifted prog name shape def

-- the shape of a `$codety` function: its self and its argument array
codeShapeW : WasmShape
codeShapeW = FuncOfType "codety" 2

-- ── the physical-identity registry (backend/wasm_symbols.mdk) ─────────────────

-- Apply one registry step for [emit]: keep the registry it returns, or keep the
-- defect it found.
registerW : WasmEmit ->
  (SymbolRegistry -> Result SymbolDefect SymbolRegistry) ->
  Unit
registerW emit step = match step !emit.symbols
  Ok reg => setRef emit.symbols reg
  Err d => setRef emit.symbolDefects (d :: !emit.symbolDefects)

-- a physical name as the registry keys it: without its `$`
symNameW : String -> String
symNameW n = if startsWith "$" n then stringSlice 1 (stringLength n) n else n

-- [prog] defines function [name] with [shape]; a function declared through a
-- type uses that type, which the type section must declare.
defineFnW : Prog -> String -> WasmShape -> Unit
defineFnW prog name shape =
  let emit = progEmit prog
  let origin = (progFnCtx prog).origin
  let _ = match shape
    FuncOfType t _ =>
      if emit.closureChecked then
        registerW emit (checkTypeUse t (symNameW name) origin)
    _ => ()
  registerW emit (defineSymbol (WasmFunc (symNameW name)) shape origin)

-- the instruction that calls `$<target>` with [operands] operands
callFnW : Prog -> CallEndW -> String -> Int -> String
callFnW prog end target operands =
  callFnAtW (progEmit prog) (progFnCtx prog).origin end target operands

-- `callFnW` for code no binding's body owns, its uses attributed to [origin]
callFnAtW : WasmEmit -> SymbolOrigin -> CallEndW -> String -> Int -> String
callFnAtW emit origin end target operands =
  let _ = registerW emit (checkCall (WasmFunc target) operands origin)
  callInstrW end target

-- `call $<name>` of a runtime helper or host import, with [operands] operands
rtCallW : Prog -> String -> Int -> String
rtCallW prog name operands = callFnW prog CallValueW name operands

-- the Int box seam's two calls
unboxIntW : Prog -> String
unboxIntW prog = rtCallW prog "mdk_unbox_int" 1

boxIntW : Prog -> String
boxIntW prog = rtCallW prog "mdk_box_int" 1

-- the uses of code emitted outside any binding: coded traps and their helpers
trapOriginW : SymbolOrigin
trapOriginW = SymbolOrigin "coded trap" "" 0 0

-- `<op> <name>` for the access [op] (`global.get`, `global.set`) of the global
-- [name].  The gap census declares no globals, so it checks no access.
globalW : Prog -> String -> String -> String
globalW prog op name =
  let emit = progEmit prog
  let _ =
    if emit.closureChecked then
      registerW
        emit
        (checkRef (WasmGlobal (symNameW name)) (progFnCtx prog).origin)
  "\{op} \{name}"

-- the SplitMix64 state global `rngStateGlobalLines` declares
rngStateW : String
rngStateW = "$mdk_rng_state"

-- `ref.func` of [name] in a body: the function must exist and an element
-- declaration must list it.
refFuncW : Prog -> String -> String
refFuncW prog name =
  let origin = (progFnCtx prog).origin
  let _ = registerW (progEmit prog) (checkRef (WasmFunc (symNameW name)) origin)
  let _ = registerW (progEmit prog) (checkRef (WasmElem (symNameW name)) origin)
  "ref.func " ++ name

-- the module-level identities, declared before any body is emitted: the type
-- section, the host imports, the planned runtime helpers, the globals and the
-- closure-apply element entry, whose function the closure helpers define
seedSymbolsW : Prog -> WasmDemandPlan -> List String -> Unit
seedSymbolsW prog physical globals =
  let emit = progEmit prog
  let origin = SymbolOrigin "module" "" 0 0
  let declare = sym shape => registerW emit (declareSymbol sym shape origin)
  let _ =
    forEachU (t => declare (WasmType t) TypeDecl) physical.representationTypes
  let _ =
    forEachU
      (imp => declare (WasmFunc imp.watSymbol) FuncImported)
      physical.imports
  let _ = forEachU (registerW emit) (declarePlannedHelpers physical)
  let _ = forEachU (g => declare (WasmGlobal g) GlobalDecl) globals
  if progUseClos prog then
    let _ = declare (WasmElem "mdk_pap") ElemDecl
    registerW emit (checkRef (WasmFunc "mdk_pap") origin)

-- every defect this emission found: those found as it went, then (unless it is
-- the census or the input-isolation harness) one for each identity a use still
-- waits for
symbolDefectsW : WasmEmit -> List SymbolDefect
symbolDefectsW emit =
  reverseL !emit.symbolDefects
    ++ (if emit.closureChecked && emit.completionChecked then
      unresolved !emit.symbols
    else
      [])

-- ── S-4: capture-free closure hoisting (the WasmGC peer of S-1/S-2's LLVM cells) ──
-- A `$clos` struct whose capture set is EMPTY has fields that are ALL constant: the
-- code pointer is `ref.func $lam`, the arity is an `i32.const`, and the env is a
-- zero-length `array.new_fixed $argarr 0`.  Such a struct is identical at every entry
-- to the enclosing function, so it need not be rebuilt per entry: emit it ONCE as an
-- IMMUTABLE module global and read it with a single `global.get`.
--
-- This is NOT a port of the LLVM mechanism — that one hoists a flat `[2 x i64]`
-- `internal constant` cell and hands back a `ptrtoint` constant-expression (F8).  The
-- WasmGC representation is a GC struct, so the analogue is a global whose INITIALIZER
-- is a `struct.new`, which needs wasm-GC constant expressions.  Confirmed accepted by
-- this project's whole toolchain before the mechanism was written: `wasm-tools parse`,
-- `wasm-tools validate --features=all`, and the Node engine `test/wasm/run.js` uses
-- all accept `(global $g (ref $clos) (struct.new $clos (ref.func $l) (i32.const N)
-- (array.new_fixed $argarr 0)))` and read back field `$arity` correctly.  There is no
-- prior const-initialized global in this file (every other one is `mut` + a runtime
-- store), so that probe — not precedent — is what licenses this.
--
-- `ref.func` inside a global initializer self-declares the function reference (the
-- validator's `refs` set is collected from module fields OUTSIDE function bodies,
-- globals included), so no `(elem declare)` entry is required for validity — but the
-- call sites keep their existing `noteFuncRef` anyway, since the lifted code function
-- is also reachable through ordinary code paths.
--
-- SOUND because a `$clos` struct is never mutated after construction on any path: its
-- three fields are IMMUTABLE in the type (`$clos` declares no `mut` field), so unlike
-- LLVM there is not even a back-patch to reason about.  The knot for a mutually- or
-- self-recursive let-group is tied by RECONSTRUCTION inside each lifted member's
-- prologue (`emitLgLifted`'s `memberRebuilds`), which this does not touch.
--
-- Deduped by initializer TEXT: two references to the same capture-free closure share
-- one global.  That is observationally safe here for the same reason it is in LLVM —
-- a closure value has no identity in this language (no reference equality on
-- functions), and `$mdk_apply`/`$mdk_pap` only READ the struct, allocating any partial
-- application into a fresh cell.
wConstClos : Prog -> String -> Int -> List String
wConstClos prog lamName arity =
  let emit = progEmit prog
  let origin = (progFnCtx prog).origin
  -- a global's initializer declares its own function reference, so only the
  -- function and the `$clos` type have to exist
  let _ = registerW emit (checkRef (WasmFunc (symNameW lamName)) origin)
  let _ =
    if emit.closureChecked then
      registerW emit (checkTypeUse "clos" (symNameW lamName) origin)
  let initBody =
    "(struct.new $clos (ref.func \{lamName}) (i32.const \{intToString arity}) (array.new_fixed $argarr 0))"
  match omLookup initBody !emit.constClosIdx
    Some g => [globalW prog "global.get" g]
    None =>
      let g = "$mdk_cc_" ++ intToString !emit.nextConstClosId
      let _ =
        registerW
          emit
          (declareSymbol (WasmGlobal (symNameW g)) GlobalDecl origin)
      let _ = setRef emit.nextConstClosId (!emit.nextConstClosId + 1)
      let _ = setRef emit.constClosIdx (omInsert initBody g !emit.constClosIdx)
      let _ = setRef emit.constClosCells ((g, initBody) :: !emit.constClosCells)
      [globalW prog "global.get" g]

-- the hoisted globals, in emission order.  Drained by emitRefProgram AFTER every body
-- has been emitted (the same after-body discipline `dataSegs` / `trapImport` use), so
-- this must be bound late even though the lines are placed with the other globals.
wConstClosGlobalLines : WasmEmit -> List String
wConstClosGlobalLines emit =
  map oneConstClosGlobal (reverseL !emit.constClosCells)

oneConstClosGlobal : (String, String) -> String
oneConstClosGlobal (g, initBody) = "  (global \{g} (ref $clos) \{initBody})"

-- [nm] is taken by `ref.func`, so the element declaration lists it.  That
-- declaration is written only for a module with closures.
noteFuncRef : Prog -> String -> Unit
noteFuncRef prog nm =
  if progUseClos prog then
    registerW
      (progEmit prog)
      (declareSymbol (WasmElem (symNameW nm)) ElemDecl (progFnCtx prog).origin)

-- The module text, or the physical defects that keep it from being written.
export
emitProgram : WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) String
emitProgram input plan cp =
  emitProgramWith (freshWasmEmit WGapStrict) input plan cp

-- The X-W.H1/H2 same-process input/state-isolation harnesses (`reemitInput` and
-- peers, compiler/entries/wasm_emit_typed_main.mdk) deliberately re-emit ONE
-- lowered `CProgram` under MISMATCHED inputs (P's real program with U's
-- ctor/method tables) specifically to prove each field
-- independently influences the physical plan (`P_NE_CTOR` etc). Such a
-- combination never occurs in a real compile (there sigs/ctors/methods are
-- always derived from the SAME decls as the program), can
-- legitimately desync a gating decision that reads the mismatched table (e.g.
-- a plan forcing a Float auto-print with no Float anywhere in the
-- program's own body), and is never assembled by wasm-tools -- so it is not
-- this check's business, same reasoning as `emitProgramGaps` below. Exported
-- for that harness ONLY; every real caller (build/run, every fixture-driven
-- gate) stays on the checked `emitProgram`.
export
emitProgramUnchecked : WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) String
emitProgramUnchecked input plan cp =
  emitProgramCore
    { freshWasmEmit WGapStrict | completionChecked = False }
    input
    plan
    cp

-- Record mode is a complete ordinary emission with a fresh event lifecycle.
-- It is intentionally separate from the all-binding/no-main census below.
export
emitProgramRecord : WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) (String, List String)
emitProgramRecord input plan cp =
  let emit = freshWasmEmit WGapRecord
  map (text => (text, gapEventsOfW emit)) (emitProgramWith emit input plan cp)

emitProgramWith : WasmEmit ->
  WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) String
emitProgramWith emit input plan cp = match emitProgramCore emit input plan cp
  Err defects => Err defects
  Ok text =>
    -- WGapRecord is the tolerant/census mode (mirrors emitProgramGaps below): it
    -- continues past an unsupported node by RECORDING a gap event instead of
    -- aborting, so its assembled text is intentionally allowed to be incomplete/
    -- self-inconsistent -- not a real module, so not this check's business.
    -- Only WGapStrict (the real, on-by-default production path) is asserted.
    let _ = match emit.gapMode
      WGapStrict => assertEmittedClosureW text
      WGapRecord => ()
    Ok text

-- Strict and record modes share one semantic gateway; only target gaps may
-- become record events instead of a refusal.
refuseUnprovidedExternsW : WasmEmit ->
  WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Unit
refuseUnprovidedExternsW emit input plan cp =
  let validation =
    validateForEmission
      WasmBackend
      (inputRuntimeExternsW input)
      (inputManifestRequirementW input)
      plan
      cp
  match validation.defects
    bad :: _ => panic (coreDefectMessage bad)
    [] => match validation.externFindings
      [] => ()
      findings => match emit.gapMode
        WGapStrict => panic (renderExternRefusal findings)
        WGapRecord =>
          forEachU
            (f => noteGapAtW emit (findingBinding f) (renderExternFinding f))
            findings

emitProgramCore : WasmEmit ->
  WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) String
emitProgramCore emit input plan cp =
  emitUniqueProgram
    { emit |
      externFacts = requirementFacts plan.externRequirements,
      physical = plan.wasmPhysical,
    }
    input
    plan
    cp

emitUniqueProgram : WasmEmit ->
  WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) String
emitUniqueProgram emit input plan (cp@(CProgram groups ctorArs ctorTypes impls _ facts)) =
  let _ = refuseUnprovidedExternsW emit input plan cp
  let physical = physicalPlanW plan
  let _ = seedPhysicalW emit physical
  let fnNames = collectFnNames groups
  let valNames = collectValNames groups
  let index =
    makeWasmProgramIndex
      plan
      facts
      groups
      ctorArs
      ctorTypes
      impls
      fnNames
      valNames
  let useClos = physical.useClos
  let useRef = physical.useRef
  let typeNames = distinctTypeNames ctorTypes
  let prog =
    Prog index typeNames valNames useClos impls input emit (freshFnCtx ())
  emitRefProgram prog plan groups

-- ── emit-time closure check (#392) ──────────────────────────────────────────
-- The runtime-line gating graph (which WAT helper block a program's use-flags
-- pull in) is hand-maintained; S1-S3 each narrowed it (fewer impls, per-operator
-- splits, dropped names), and a wrongly-narrowed gate would otherwise surface only as a
-- downstream `wasm-tools validate` "unknown func $x" on whichever fixture
-- happened to exercise the gap (#388: `$mdk_value_mod` called `$mdk_float_rem`
-- with only `useValueArith` set, silently broke 21 int-only fixtures). Run on
-- every emit (not a flag) so a gate that gets narrowed wrong fails HERE, in
-- process, naming the missing symbol, instead of downstream and silently.
--
-- Operates on the FINAL assembled text, granularity-agnostic to whatever flags
-- gated what -- it only asserts every directly-named callee resolves within
-- this module, either as a `(func $name ...)` definition or an
-- `(import "env" "..." (func $name ...))` declaration (see
-- `stderrByteImportLines`, wasm_preamble.mdk, for the import text shape).
-- `call_ref`/`return_call_ref` are exempt: they dispatch dynamically through a
-- `(ref $codety)` table value, never naming a callee symbol directly, and
-- their literal text never matches the `call $` needle below (`call_ref`/
-- `return_call_ref` both have `_ref` where this needle expects a space).
--
-- NOT one call per line: wasm_emit.mdk's own call sites are each their own
-- list element (flat, unfolded -- operands already on the stack), but the
-- hand-written runtime blocks in wasm_preamble.mdk are FOLDED s-expr WAT
-- with a call site anywhere inside a line, sometimes several per line (e.g.
-- valueAddRuntimeLines' `(call $mdk_box_int (i64.add (call $mdk_unbox_int
-- ...) (call $mdk_unbox_int ...)))`) -- an earlier draft of this check that
-- assumed startsWith missed exactly this shape. So this scans every line for
-- ALL occurrences of the `call $` needle, not just a line-leading one.
-- `return_call $NAME` is caught by the SAME needle -- "return_call $NAME"
-- literally contains "call $NAME" as a substring (right after `return_`), so
-- no separate needle is needed.
-- A string literal can never spoof either needle: `escWatBytes` hex-escapes
-- EVERY byte of a data segment (`oneDataSeg`), so no literal ASCII ever
-- reaches the assembled text from user data.
assertEmittedClosureW : String -> Unit
assertEmittedClosureW text =
  let lines = splitNl text
  let defined = omFromNames (collectDefinedNamesW lines) omEmpty
  let called = collectCalledNamesW lines
  checkCalledNamesW defined called

-- ⚠️ ACCUMULATOR-PASSING, DELIBERATELY (#392 follow-up).  The three walkers
-- below (`collectCalledNamesGoW`, `collectDefinedNamesGoW`, `identsAfterAllGoW`)
-- would otherwise build their result AFTER the recursive call returns (`idents ++
-- recurse rest` / `name :: recurse ...`), i.e. one live stack frame per WAT line
-- and per `call $` occurrence within a line.  That is fine on the native path
-- (a 256 MB GC-aware worker thread, runtime/medaka_rt.c) but FATAL on the wasm
-- path: `compiler/entries/playground_main.mdk` compiles this very code to
-- WasmGC, and the guest then runs on the HOST JS engine's ~1 MB stack, so the
-- check's own depth is proportional to the emitted module's text size.  It
-- overflowed at 15,739 lines -- i.e. on `main = 42`, the smallest program there
-- is -- taking every browser compile down with `Maximum call stack size
-- exceeded`.  Threading an accumulator makes each self-call a TRUE tail call,
-- which W4's TCO (§4.2) emits as `return_call`: constant stack, any module size.
-- Keep them tail-recursive.  The `Rev` suffix marks the reversed intermediate:
-- each `xxxRevW` returns its names LAST-FIRST, and the single `reverseL` at the
-- public entry restores the exact pre-rewrite order (per line, and across
-- lines), so the collected lists are element-for-element identical to what the
-- non-tail version produced.
collectCalledNamesW : List String -> List String
collectCalledNamesW lines = reverseL (collectCalledNamesGoW lines [])

collectCalledNamesGoW : List String -> List String -> List String
collectCalledNamesGoW [] acc = acc
collectCalledNamesGoW (line :: rest) acc =
  if startsWith ";;" (stringTrimLeft line) then
    collectCalledNamesGoW rest acc
  else
    collectCalledNamesGoW rest (identsAfterAllRevW "call $" 6 line ++ acc)

-- `(func $NAME` appears exactly once per defining line -- a plain top-level
-- function's own def line AND an import's `(import "env" "..." (func $NAME
-- ...))` line alike -- so one needle covers both (a) and (b) of the closure
-- requirement.
collectDefinedNamesW : List String -> List String
collectDefinedNamesW lines = reverseL (collectDefinedNamesGoW lines [])

collectDefinedNamesGoW : List String -> List String -> List String
collectDefinedNamesGoW [] acc = acc
collectDefinedNamesGoW (line :: rest) acc =
  collectDefinedNamesGoW rest (identsAfterAllRevW "(func $" 7 line ++ acc)

-- every occurrence of `needle` in `line`, mapped to the identifier
-- immediately following it (skipping `skipLen` chars of the needle itself,
-- e.g. `call $` -> 6, so the scan resumes right after the `$`), in REVERSE
-- order of occurrence.  The callers above prepend this onto their own reversed
-- accumulator, so one `reverseL` at the public entry un-reverses both levels at
-- once: acc = revLn ++ ... ++ revL1, and `reverseL acc` = L1 ++ ... ++ Ln,
-- exactly the old `L1 ++ ... ++ Ln`.
identsAfterAllRevW : String -> Int -> String -> List String
identsAfterAllRevW needle skipLen line =
  identsAfterAllGoW needle skipLen line 0 []

identsAfterAllGoW : String -> Int -> String -> Int -> List String -> List String
identsAfterAllGoW needle skipLen line from acc =
  let n = stringLength line
  if from >= n then
    acc
  else match stringIndexOf needle (stringSlice from n line)
    None => acc
    Some rel =>
      let hit = from + rel
      let name = identAfterW line (hit + skipLen)
      identsAfterAllGoW
        needle
        skipLen
        line
        (hit + stringLength needle)
        (name :: acc)

-- read a bare identifier (word chars only -- `$` already consumed) forward
-- from `from` until a non-identifier char or end of line.
identAfterW : String -> Int -> String
identAfterW line from = identAfterGoW line from (stringLength line) from

identAfterGoW : String -> Int -> Int -> Int -> String
identAfterGoW line i n from =
  if i >= n then
    stringSlice from n line
  else if isIdentCharW (stringSlice i (i + 1) line) then
    identAfterGoW line (i + 1) n from
  else
    stringSlice from i line

isIdentCharW : String -> Bool
isIdentCharW c = c /= " " && c /= "(" && c /= ")" && c /= "\""

checkCalledNamesW : OrdMap Unit -> List String -> Unit
checkCalledNamesW _ [] = ()
checkCalledNamesW defined (name :: rest) =
  if omHasKey name defined then
    checkCalledNamesW defined rest
  else
    panic
      ("wasm emit: call to undefined/unimported $"
        ++ name
        ++ " -- a runtime-line gate is missing this helper's dependency (#392)")

-- ── gap census driver ────────────────────────────────────────────────────────
-- The WasmGC peer of llvm_emit's emitProgramGaps: emit EVERY binding (fns +
-- impls + top-level values) in record mode and return the recorded gap events,
-- WITHOUT requiring a `main`.  Mirrors emitProgram's Prog/state setup (the same
-- W7 scans + Prog build), but forces the ref path (the whole compiler graph is
-- ADT/string/closure-heavy, so ref-mode is the representative path) and never
-- calls the main-requiring emitRefMain.  Each binding is wrapped with setGapBindingOfW
-- so a recorded gap is attributed to its source binding.
export
emitProgramGaps : WasmEmitInput ->
  EmitPlan ->
  CProgram ->
  Result (List SymbolDefect) (List String)
emitProgramGaps input plan cp0 =
  let (CProgram groups ctorArs ctorTypes impls mctx facts) = cp0
  let emit = freshWasmEmit WGapRecord
  let emit = { emit |
    externFacts = requirementFacts plan.externRequirements,
    physical = plan.wasmPhysical,
    closureChecked = False,
  }
  let _ =
    refuseUnprovidedExternsW
      emit
      input
      plan
      (CProgram groups ctorArs ctorTypes impls mctx facts)
  let _ = seedPhysicalW emit (physicalPlanW plan)
  let emit =
    { emit | physical = Some (WD.censusWasmDemand (physicalPlanW plan)) }
  let fnNames = collectFnNames groups
  let valNames = collectValNames groups
  let index =
    makeWasmProgramIndexGaps
      plan.wasmInputs.ctorFloatFields
      plan.trmc
      facts
      groups
      ctorArs
      ctorTypes
      impls
      fnNames
      valNames
  let useClos = (physicalPlanW plan).useClos
  -- force the ref path: the census measures the full (ref eq) emitter surface.
  let typeNames = distinctTypeNames ctorTypes
  let prog =
    Prog index typeNames valNames useClos impls input emit (freshFnCtx ())
  let _ = emitFnsGapsW prog (userFnBinds groups)
  let _ = emitImplsGapsW prog (implGroups prog impls)
  let _ = emitValsGapsW prog (filterList isValBind groups)
  match symbolDefectsW emit
    [] => Ok (gapEventsOfW emit)
    defects => Err defects

emitFnsGapsW : Prog -> List CBind -> Unit
emitFnsGapsW _ [] = ()
emitFnsGapsW prog ((CBind name cs site bid) :: rest) =
  let _ = setGapBindingOfW (progEmit prog) ("fn " ++ name)
  let _ = emitRefFnBind prog (CBind name cs site bid)
  emitFnsGapsW prog rest

emitImplsGapsW : Prog -> List ImplG -> Unit
emitImplsGapsW _ [] = ()
emitImplsGapsW prog ((g@(ImplG method headTag _ _ _ _)) :: rest) =
  let _ = setGapBindingOfW (progEmit prog) "impl \{method}@\{headTag}"
  let _ = emitImplGroup prog g
  emitImplsGapsW prog rest

emitValsGapsW : Prog -> List CBind -> Unit
emitValsGapsW _ [] = ()
emitValsGapsW prog (b :: rest) =
  let _ = setGapBindingOfW (progEmit prog) ("val " ++ bindName b)
  let _ = emitRefValInit prog b
  emitValsGapsW prog rest

externFamilyW : WasmEmit -> String -> Option WasmFamily
externFamilyW emit name =
  if name == siteSentinelName then
    Some WasmLeaf
  else match lookupAssoc name (emitDemandW emit).catalogFamilies
    Some f => if isWasmExternFamily f then Some f else None
    None => None

isWasmEtaExtern : WasmEmit -> String -> Bool
isWasmEtaExtern emit name = isSome (externFamilyW emit name)

-- A declared file bound's grant, thunk body and mode (1 for FileWrite): the type
-- checker writes `$withFileReadBound grant (_ => body)` around the body of a
-- binding whose row is closed and names a narrow file authority.  The body is
-- emitted inline, in the enclosing function, between entering and leaving a host
-- bound frame (`emitAppRef`, `emitAppTail`).
fileBoundW : CExpr -> Option (CExpr, CExpr, Int)
fileBoundW app = match flattenApp app []
  (CVar "$withFileReadBound" _, [g, CLam [PWild] b]) => Some (g, b, 0)
  (CVar "$withFileWriteBound" _, [g, CLam [PWild] b]) => Some (g, b, 1)
  _ => None

-- Entering a bound pushes its grant and asks the host for a frame.  Off a tail
-- position the host always keeps a record, so leaving pops one unconditionally.
-- In a tail position it pushes a frame only when no equal bound of the mode is
-- active, as medaka_rt.c mdk_with_file_bound does, and says whether it did: a
-- re-entered bound leaves the body's tail call a tail call.
fileBoundEnterW : Prog -> Env -> Int -> CExpr -> Int -> Bool -> List String
fileBoundEnterW prog env d g mode keep =
  emitRefExpr prog env d g
    ++ [
      rtCallW prog "mdk_push_grant" 1,
      "i32.const \{intToString mode}",
      "i32.const \{if keep then "1" else "0"}",
      rtCallW prog "mdk_file_bound_enter" 2,
    ]

-- ── W6: does the program use strings? ────────────────────────────────────────
-- True if any body contains a String/Char literal, or applies an extern whose
-- catalog wasm family is `WasmStr` (intToString/putStrLn/stringConcat/…).  Any of
-- these forces the §3.3 $str rep + the byte-write runtime + ref-mode.  Detected
-- structurally over every clause body.
-- Local spellings retain legacy mode eligibility; extern binding uses facts.
seedDemandW : WasmEmit -> WasmDemand -> Unit
seedDemandW emit d =
  let _ = forEachU (u => noteWasmUse emit u) d.uses
  let _ = if d.refBox then setRef emit.useRefBox True
  let _ = if d.divGuard then setRef emit.useDivGuard True
  setRef emit.tupleArities (reverseL d.tupleArities)

-- The `WasmEmit` flag that carries one catalog demand.
noteWasmUse : WasmEmit -> WasmUse -> Unit
noteWasmUse emit UseStr = setRef emit.useStr True
noteWasmUse emit UseStrLeaf = setRef emit.useStrLeaf True
noteWasmUse emit UseRng = setRef emit.useRng True
noteWasmUse emit UseHash = setRef emit.useHash True
noteWasmUse emit UseFloat = setRef emit.useFloat True
noteWasmUse emit UseU64 = setRef emit.useU64 True
noteWasmUse emit UseI64 = setRef emit.useI64 True
-- the libm and clock imports are the extern's own host keys (`EmitPlan.hostKeys`)
noteWasmUse _ UseMath = ()
noteWasmUse _ UseFloatStr = ()
noteWasmUse emit UseFloatHash = setRef emit.useFloatHash True
noteWasmUse emit UseFloatRng = setRef emit.useFloatRng True
noteWasmUse emit UseStrSearch = setRef emit.useStrSearch True
noteWasmUse emit UseStrCodec = setRef emit.useStrCodec True
noteWasmUse emit UseArray = setRef emit.useArray True
noteWasmUse emit UseList = setRef emit.useList True
noteWasmUse emit UseCharFromCode = setRef emit.useCharFromCode True
noteWasmUse emit UseCharClass = setRef emit.useCharClass True
noteWasmUse emit UseEPut = setRef emit.useEPut True
noteWasmUse emit UseByteBlock = setRef emit.useByteBlock True
noteWasmUse _ UseArgs = ()
noteWasmUse emit UseFileBytes = setRef emit.useFileBytes True
noteWasmUse _ UseClock = ()
noteWasmUse emit UseStrToInt = setRef emit.useStrToInt True
noteWasmUse emit UseStrReverse = setRef emit.useStrReverse True
noteWasmUse emit UseStrJoin = setRef emit.useStrJoin True
cFieldExpr : CField -> CExpr
cFieldExpr (CField _ _ e) = e

-- the set of top-level fn names that appear as VALUES (bare ref in a non-call
-- position, or partially / over applied) anywhere in the program — these need a
-- closure wrapper so they can flow through `(ref eq)` slots / be applied indirectly.
-- `locals` is the scope's locally-bound names (parameters, let, lambda and
-- let-group binders): a local named like a top-level fn shadows it, so it is not a
-- value use of the fn (emitVarRef and emitAppRef consult the env first), the same
-- rule `exprUsesClosures` applies.
scanFnValueUses : OrdMap Unit -> List (String, Int) -> List CBind -> List String
scanFnValueUses fnNames ctorArs groups =
  dedupKeep (flatMap (scanBindValueUses fnNames ctorArs envEmpty) groups)

-- W9: the impl method bodies + interface defaults also use top-level fns as values
-- (e.g. `toList = identity` in `impl Foldable List`), so their fn-value uses must seed
-- the closure-wrapper set too — else `$mdk_w_<f>` is referenced but never emitted.
scanImplValueUses : OrdMap Unit ->
  List (String, Int) ->
  List CImplEntry ->
  List String
scanImplValueUses fnNames ctorArs impls =
  dedupKeep (flatMap (e => scanImplEntryValueUses fnNames ctorArs e) impls)

scanImplEntryValueUses : OrdMap Unit ->
  List (String, Int) ->
  CImplEntry ->
  List String
scanImplEntryValueUses fnNames ctorArs (ent@(CImplEntry _ _ _ body)) =
  let locals =
    envExtendUnstamped (flatMap patVars (implEntryPatsW ent)) envEmpty
  match body
    CImplTagged _ _ _ _ _ _ b => scanExprValueUses fnNames ctorArs locals b
    CImplDefault _ _ _ _ _ _ b => scanExprValueUses fnNames ctorArs locals b

scanBindValueUses : OrdMap Unit ->
  List (String, Int) ->
  Env ->
  CBind ->
  List String
scanBindValueUses fnNames ctorArs locals (CBind _ clauses _ _) =
  flatMap
    ((CClause pats body) =>
      scanExprValueUses
        fnNames
        ctorArs
        (envExtendUnstamped (flatMap patVars pats) locals)
        body)
    clauses

scanExprValueUses : OrdMap Unit ->
  List (String, Int) ->
  Env ->
  CExpr ->
  List String
scanExprValueUses fnNames ctorArs locals (CVar x _) =
  if envHas x locals then
    []
  else if fnMemberIndexW fnNames x then
    [x]
  else if fnMemberIndexW fnNames ("core__" ++ x) then
    ["core__" ++ x]
  else
    []
scanExprValueUses fnNames ctorArs locals (app@(CApp _ _ _)) =
  let (hd, args, mode) = appParts app
  let here = match hd
    CVar fn0 _ =>
      let fn =
        if fnMemberIndexW fnNames fn0 then
          fn0
        else if fnMemberIndexW fnNames ("core__" ++ fn0) then
          "core__" ++ fn0
        else
          fn0
      if not (envHas fn0 locals)
        && fnMemberIndexW fnNames fn
        && not (isExactCall mode) then
        [fn]
      else
        []
    -- P1: an RLocal method-ref head is a DIRECT call to a shadowing standalone top-level
    -- fn — the same direct call the CVar arm above describes, reached by a different
    -- route.  So it needs the SAME rule: when the call is not exact, emitMethodRef
    -- falls back to the closure/$__mdk_apply path, which references `$mdk_w_<fn>` — and
    -- that wrapper is only DEFINED for a fn this scan reports.  Missing it emitted the
    -- ref.func and never the func: "unknown func $mdk_w_…" at assemble (exactly the
    -- failure the composite-arm comment below records).  Kept in lockstep with
    -- emitMethodRef's RLocal arm, including the `sym == ""` bare-name fallback.
    CMethod mname (MethodEvidence _ _ (RLocal sym dicts) _ _) =>
      let target = if sym == "" then mname else sym
      if isEmpty dicts
        && fnMemberIndexW fnNames target
        && not (isExactCall mode) then
        [target]
      else
        []
    _ => scanExprValueUses fnNames ctorArs locals hd
  here ++ flatMap (scanExprValueUses fnNames ctorArs locals) args
scanExprValueUses fnNames ctorArs locals (CLam pats b) =
  scanExprValueUses
    fnNames
    ctorArs
    (envExtendUnstamped (flatMap patVars pats) locals)
    b
scanExprValueUses fnNames ctorArs locals (CBinPrim _ l r _ _) =
  scanExprValueUses fnNames ctorArs locals l
    ++ scanExprValueUses fnNames ctorArs locals r
scanExprValueUses fnNames ctorArs locals (CUnOp _ x) =
  scanExprValueUses fnNames ctorArs locals x
scanExprValueUses fnNames ctorArs locals (CIf c t f) =
  scanExprValueUses fnNames ctorArs locals c
    ++ scanExprValueUses fnNames ctorArs locals t
    ++ scanExprValueUses fnNames ctorArs locals f
scanExprValueUses fnNames ctorArs locals (CLet _ pat a b) =
  scanExprValueUses fnNames ctorArs locals a
    ++ scanExprValueUses
      fnNames
      ctorArs
      (envExtendUnstamped (patVars pat) locals)
      b
scanExprValueUses fnNames ctorArs locals (CBlock stmts) =
  scanBlockValueUses fnNames ctorArs locals stmts
scanExprValueUses fnNames ctorArs locals (CDecision scrut arms _) =
  scanExprValueUses fnNames ctorArs locals scrut
    ++ flatMap (a => scanArmValueUses fnNames ctorArs locals a) arms
scanExprValueUses fnNames ctorArs locals (CMatch scrut arms) =
  scanExprValueUses fnNames ctorArs locals scrut
    ++ flatMap (a => scanArmValueUses fnNames ctorArs locals a) arms
scanExprValueUses fnNames ctorArs locals (CLetGroup binds b) =
  let inGroup = envExtendUnstamped (map bindName binds) locals
  flatMap (bd => scanBindValueUses fnNames ctorArs inGroup bd) binds
    ++ scanExprValueUses fnNames ctorArs inGroup b
-- Composite arms emitVarRef descends into at emit time — each can hold a fn-VALUE
-- use (`map (mapIfaceMethod f) ms` lives in a CRecordUpdate; `map (substField s) fs`
-- in a CTuple; `flatMap dataArity prog` in a CRecord field).  Missing these here
-- under-counted fn-value uses → the closure wrapper `$mdk_w_<f>` was referenced
-- (ref.func emitted) but never DEFINED → "unknown func" at assemble.
scanExprValueUses fnNames ctorArs locals (CTuple xs) =
  flatMap (scanExprValueUses fnNames ctorArs locals) xs
scanExprValueUses fnNames ctorArs locals (CList xs) =
  flatMap (scanExprValueUses fnNames ctorArs locals) xs
scanExprValueUses fnNames ctorArs locals (CArray xs) =
  flatMap (scanExprValueUses fnNames ctorArs locals) xs
scanExprValueUses fnNames ctorArs locals (CRecord _ fs) =
  flatMap (fd => scanExprValueUses fnNames ctorArs locals (cFieldExpr fd)) fs
scanExprValueUses fnNames ctorArs locals (CFieldAccess r _ _ _) =
  scanExprValueUses fnNames ctorArs locals r
scanExprValueUses fnNames ctorArs locals (CRecordUpdate _ r fs) =
  scanExprValueUses fnNames ctorArs locals r
    ++ flatMap
      (fd => scanExprValueUses fnNames ctorArs locals (cFieldExpr fd))
      fs
scanExprValueUses fnNames ctorArs locals (CVariantUpdate _ r fs) =
  scanExprValueUses fnNames ctorArs locals r
    ++ flatMap
      (fd => scanExprValueUses fnNames ctorArs locals (cFieldExpr fd))
      fs
scanExprValueUses fnNames ctorArs locals (CRangeList lo hi _) =
  scanExprValueUses fnNames ctorArs locals lo
    ++ scanExprValueUses fnNames ctorArs locals hi
scanExprValueUses fnNames ctorArs locals (CRangeArray lo hi _) =
  scanExprValueUses fnNames ctorArs locals lo
    ++ scanExprValueUses fnNames ctorArs locals hi
scanExprValueUses _ _ _ _ = []

-- scan an arm's guards (refutable `Pat <- e` / boolean `if e`) AND its body — a
-- guard scrutinee can carry a fn-value use just like the body.
scanArmValueUses : OrdMap Unit ->
  List (String, Int) ->
  Env ->
  CArm ->
  List String
scanArmValueUses fnNames ctorArs locals (CArm _ guards body) =
  flatMap (g => scanGuardValueUses fnNames ctorArs locals g) guards
    ++ scanExprValueUses fnNames ctorArs locals body

scanGuardValueUses : OrdMap Unit ->
  List (String, Int) ->
  Env ->
  CGuard ->
  List String
scanGuardValueUses fnNames ctorArs locals (CGBool e) =
  scanExprValueUses fnNames ctorArs locals e
scanGuardValueUses fnNames ctorArs locals (CGBind _ e) =
  scanExprValueUses fnNames ctorArs locals e

-- a block's statements, each later one seeing the names an earlier `let` bound
scanBlockValueUses : OrdMap Unit ->
  List (String, Int) ->
  Env ->
  List CStmt ->
  List String
scanBlockValueUses _ _ _ [] = []
scanBlockValueUses fnNames ctorArs locals ((CSLet _ pat e) :: rest) =
  scanExprValueUses fnNames ctorArs locals e
    ++ scanBlockValueUses
      fnNames
      ctorArs
      (envExtendUnstamped (patVars pat) locals)
      rest
scanBlockValueUses fnNames ctorArs locals ((CSExpr e) :: rest) =
  scanExprValueUses fnNames ctorArs locals e
    ++ scanBlockValueUses fnNames ctorArs locals rest
scanBlockValueUses fnNames ctorArs locals (_ :: rest) =
  scanBlockValueUses fnNames ctorArs locals rest

anyList : (a -> Bool) -> List a -> Bool
anyList _ [] = False
anyList p (x :: xs) = if p x then True else anyList p xs

-- ════════════════════════════════════════════════════════════════════════════
-- Raw physical values and function-local storage.
-- ════════════════════════════════════════════════════════════════════════════

oneGlobalI32 : String -> String
oneGlobalI32 n = "  (global $" ++ gname n ++ " (mut i64) (i64.const 0))"

printFor : Prog -> WTy -> List String
-- layer-17 §2.1: scalar values are uniformly i64 now.  Int prints directly; Bool is
-- an i64 0/1, so wrap to i32 for $mdk_print_bool.
printFor prog WInt = ["    " ++ rtCallW prog "mdk_print_int" 1]
printFor prog WBool =
  ["    i32.wrap_i64", "    " ++ rtCallW prog "mdk_print_bool" 1]
printFor prog WUnit =
  gapLP prog "scalar-mode: Unit main has no scalar value to print"
printFor prog WStr =
  gapLP
    prog
    "scalar-mode main produced a String — internal mode mismatch (strings force ref-mode)"
printFor prog WChar =
  gapLP
    prog
    "scalar-mode main produced a Char — internal mode mismatch (Char main forces ref-mode)"
printFor prog WRef =
  gapLP prog "scalar-mode main produced a (ref eq) — internal mode mismatch"
printFor prog WFloat =
  gapLP
    prog
    "scalar-mode main produced a Float — internal mode mismatch (Float forces ref-mode)"

emitLitI32 : WasmEmit -> Lit -> (List String, WTy)
-- layer-17 §2.1: scalar mode is now uniformly i64 (Int/Bool/Unit all i64 0/1/value)
-- so >2^30 Int arithmetic computes in i64 and never truncates.
emitLitI32 _ (LInt n) = (["i64.const " ++ intToString n], WInt)
emitLitI32 _ (LBool b) = ([if b then "i64.const 1" else "i64.const 0"], WBool)
emitLitI32 _ LUnit = (["i64.const 0"], WUnit)
emitLitI32 emit (LFloat _) =
  gapLTy
    emit
    "Float literal (boxed (struct f64)) is deferred — no scalar Float fixture"
emitLitI32 emit (LString _) =
  gapLTy emit "String literal (the (array i8) rep) is W6"
emitLitI32 emit (LChar _) =
  gapLTy emit "Char literal is W6 (string/unicode slice)"
emitLitI32 emit (LU64 _ _) =
  gapLTy emit "U64 literal (a boxed $u64 cell) needs ref-mode"
emitLitI32 emit (LI64 _ _) =
  gapLTy emit "I64 literal (a boxed $i64 cell) needs ref-mode"

rawProgramW : Prog -> Bool
rawProgramW prog = not (emitDemandW (progEmit prog)).useRef

programReprW : Prog -> WasmRepr
programReprW prog = if rawProgramW prog then WInt63 else WBoxEq

programValueW : Prog -> List String -> WasmValue
programValueW prog lines = WasmValue (programReprW prog) lines

prependValueW : List String -> WasmValue -> WasmValue
prependValueW prefix (WasmValue repr lines) = WasmValue repr (prefix ++ lines)

rawPrintKindW : WasmRepr -> WTy
rawPrintKindW WBool64 = WBool
rawPrintKindW WUnit64 = WUnit
rawPrintKindW _ = WInt

rawReprW : WTy -> WasmRepr
rawReprW WBool = WBool64
rawReprW WUnit = WUnit64
rawReprW _ = WInt63

localTargetW : Prog -> Env -> String -> String
localTargetW prog env name =
  if rawProgramW prog then match WD.envLookup name env
    WD.LocalBinder ord => match omLookup ord (progFnCtx prog).localSlots.value
      Some slot => intToString (slotIndex slot)
      None => panic ("wasm: missing numeric local for binder " ++ ord)
    _ => panic ("wasm: missing scoped binder for local " ++ name)
  else
    "$" ++ gname name

mintLocalW : Prog -> BinderId -> Unit
mintLocalW prog bid =
  if rawProgramW prog then
    let ctx = progFnCtx prog
    let ord = intToString (binderOrdinal bid)
    let index = ctx.nextLocal.value
    let _ = setRef ctx.nextLocal (index + 1)
    let _ =
      setRef
        ctx.localSlots
        (omInsert ord (LocalSlot index WInt63) ctx.localSlots.value)
    setRef ctx.localTypes (WInt63 :: ctx.localTypes.value)

installRawParamsW : Prog -> Int -> List Pat -> Unit
installRawParamsW prog index [] = setRef (progFnCtx prog).nextLocal index
installRawParamsW prog index (pat :: rest) =
  let ctx = progFnCtx prog
  let _ = match pat
    PVar _ _ bid =>
      setRef
        ctx.localSlots
        (omInsert
          (intToString (binderOrdinal bid))
          (LocalSlot index WInt63)
          ctx.localSlots.value)
    _ => ()
  installRawParamsW prog (index + 1) rest

numericDeclsW : Prog -> List String
numericDeclsW prog =
  map
    (repr => "  (local " ++ physicalType repr ++ ")")
    (reverseL (progFnCtx prog).localTypes.value)

rawScratchW : Prog -> List String
rawScratchW prog =
  if rawProgramW prog && (progEmit prog).useDivGuard.value then
    ["  (local $__sdivr i64)"]
  else
    []

conditionW : Prog -> List String
conditionW prog =
  if rawProgramW prog then
    ["i64.const 0", "i64.ne"]
  else
    ["ref.cast (ref i31)", "i31.get_u"]

-- Sign-extend the i64 on the stack from bit 62 — the `(x << 1) >> 1` pair that
-- mirrors native's tag/untag shift.  Only a fixed-width (`U8`/`U16`/`U32`) scalar
-- site still emits it, ahead of its mask, where it cannot change the kept low bits;
-- an `Int` site checks instead of wrapping (`intChkCall`).
normInt64 : List String
normInt64 = ["i64.const 1", "i64.shl", "i64.const 1", "i64.shr_s"]

-- The `Int` operators whose exact result can leave the 63-bit range, given operands
-- already in it: `+ - *`, and `/` only at intMinBound / -1.  `%` and the
-- comparisons cannot.
intOpCanOverflow : String -> Bool
intOpCanOverflow op = contains op ["+", "-", "*", "/"]

-- A call to the checked `Int` operator for `op` (`$mdk_int_add`… in
-- `intRuntimeLines`): it leaves the exact result on the stack, or stops the
-- program with E-INT-OVERFLOW.  Operands and result are raw 63-bit i64s, so the
-- same call serves scalar and ref mode (ref mode reboxes after it).  Demands the
-- runtime block and the stderr/decimal trap seam its trap path writes through.
intChkCall : Prog -> String -> Int -> List String
intChkCall prog op site =
  let _ = noteIntRt (progEmit prog) (intChkName op)
  [
    "i64.const " ++ intToString site,
    rtCallW prog ("mdk_int_" ++ intChkName op) 3,
  ]

-- demand the `intRuntimeLines` helper `name`, and the stderr/decimal trap seam
-- every one of them writes through.
noteIntRt : WasmEmit -> String -> Unit
noteIntRt emit name =
  if contains name (emitDemandW emit).intHelpers then
    ()
  else
    panic ("internal error: unplanned-wasm-helper: Int " ++ name)

-- `Int` negation, checked the same way (`$mdk_int_neg`).
intChkNegCall : Prog -> List String
intChkNegCall prog =
  let _ = noteIntRt (progEmit prog) "neg"
  [rtCallW prog "mdk_int_neg" 1]

-- An `Int` shift (`$mdk_shift_left`/`$mdk_shift_right`, "left"/"right"): raw i64
-- value and amount in, raw i64 out.  Its negative-amount panic streams the amount
-- through the decimal trap seam.
intShiftCall : Prog -> String -> List String
intShiftCall prog dir =
  let _ = noteIntRt (progEmit prog) dir
  [rtCallW prog ("mdk_shift_" ++ dir) 2]

intChkName : String -> String
intChkName "+" = "add"
intChkName "-" = "sub"
intChkName "*" = "mul"
intChkName "/" = "div"
intChkName op = panic ("wasm: no checked Int operator '" ++ op ++ "'")

-- `uNTruncate x` in ref mode: unbox, keep the head's low bits, rebox.
emitTruncateRef : Prog -> Env -> Int -> String -> CExpr -> List String
emitTruncateRef prog env d head a = match fixedWidthMask head
  Some mask =>
    emitRefExpr prog env d a
      ++ [
        unboxIntW prog,
        "i64.const " ++ intToString mask,
        "i64.and",
        boxIntW prog,
      ]
  None => gapLP prog ("wasm: '" ++ head ++ "' is not a fixed-width head")

-- A `U8`/`U16`/`U32` arithmetic site (`CBinPrim`'s tag names the head) computes the
-- Int op and then keeps the low `n` bits, so `+ - *` wrap modulo 2^n
-- (`docs/design/INTEGER-TYPES-DESIGN.md` §4).  The mask is applied to the raw i64
-- result, whose low 32 bits are exact even when the Int product overflowed 64 bits.
-- `/` and `%` of in-range operands are already in range and take the Int path as is.
-- An `I32` site sign-extends the low 32 bits instead, which also wraps
-- `minBound / -1` (2^31 in the i64) back to `minBound`; its `%` cannot leave range.
fixedWidthWrapW : String -> String -> List String
fixedWidthWrapW tag op = match fixedWidthMask tag
  Some mask =>
    if contains op ["+", "-", "*"] then
      ["i64.const " ++ intToString mask, "i64.and"]
    else
      []
  None =>
    if tag == "I32" && contains op ["+", "-", "*", "/"] then
      ["i64.extend32_s"]
    else
      []

emitRefProgram : Prog ->
  EmitPlan ->
  List CBind ->
  Result (List SymbolDefect) String
emitRefProgram prog plan groups =
  let header = preambleHeadLines
  let typeSection =
    if rawProgramW prog then
      [
        "  (rec", "    (type $boxint (sub (struct (field i64))))",
        "    (type $float (sub (struct (field f64))))", "  )"
      ]
    else
      emitTypeSection prog
  let physical = physicalPlanW plan
  let imports = plannedImportLines physical.imports
  let valNames = progValNames prog
  -- Stage-2/3 (b′) WASMGC-TRMC: the plan's dispatch-graph TMC groups (the lexer's
  -- `scan` token spine, the offside-rule `layout` family, `intersperse`), installed
  -- BEFORE emitting fns, so emitRefFnBind can route a group member to the
  -- dest-passing reset-wrapper + inner-loop emit.
  let dispGroups = plan.dispGroups
  let _ = setRef (progEmit prog).wDispGroups dispGroups
  -- W8: the SplitMix64 seed lives in a mutable i64 global (emitted before the value globals).
  let rngGlobal =
    if (progEmit prog).useRng.value then rngStateGlobalLines else []
  let dispGlobals = flatMap wDispGlobalLines dispGroups
  -- #561 PR-B: a LAZY value global ALSO carries a per-global 3-state flag $gs_<name>
  -- (0 UNFORCED / 1 FORCING / 2 FORCED); the value cell $g_<name> stays (ref null eq).
  let lazyStateGlobals =
    map oneGlobalState (filterList (isLazyGlobalW prog) valNames)
  let globals =
    rngGlobal
      ++ dispGlobals
      ++ map (if rawProgramW prog then oneGlobalI32 else oneGlobalRef) valNames
      ++ lazyStateGlobals
  let _ =
    seedSymbolsW
      prog
      physical
      ((if isEmptyL rngGlobal then [] else [symNameW rngStateW])
        ++ flatMap wDispGlobalNames dispGroups
        ++ map gname valNames
        ++ map
          (n => "gs_" ++ gname n)
          (filterList (isLazyGlobalW prog) valNames))
  -- emit user fns FIRST (this accumulates lifted lambdas into this WasmEmit).
  let fns = flatMap (emitRefFnBind prog) (userFnBinds groups)
  -- W5: the typeclass impl functions ($mdk_impl_<tag>_<method>), emitted as ordinary
  -- (ref eq) functions the RKey direct call / RDict if-chain dispatch into.
  let implFns = emitImplFns prog
  -- #561 PR-B: a `$force_<name>` func for every LAZY value global — the 3-state force
  -- (memoise-or-black-hole) that its reads `call` instead of `global.get`.  Emitted
  -- alongside initLines so its body-emit runs BEFORE the trapImport binding below reads
  -- trapImportNeeded (an E-CYCLIC-VALUE trap sets it); mirrors value-init order.
  let forceFns = emitRefForceFns prog groups
  let initLines = emitRefInit prog plan groups
  -- now drain the lifted-lambda defs + the closure-apply runtime + elem-declare.
  let lifted =
    if progUseClos prog then
      flatMap (x => x) (reverseL (progEmit prog).liftedDefinitions.value)
    else
      []
  let elemDecl =
    if progUseClos prog then [emitElemDeclare (progEmit prog)] else []
  let runtime =
    plannedHelperLines
      physical
      (map strBytesW (reverseL (progEmit prog).siteFiles.value))
  let dataSegs = emitDataSegs (progEmit prog)
  -- S-4: the capture-free closure globals (wConstClos), accumulated during fn / impl /
  -- default / init body emission.  Bound HERE, after every body-emit binding above, for
  -- the same reason `trapImport` and `dataSegs` are; their LINES are placed with the
  -- other globals below, which the text format permits independently of binding order.
  let constClosGlobals = wConstClosGlobalLines (progEmit prog)
  -- the `$trapmsg_K` helpers, bound last of all: every coded trap they hold was
  -- interned during the body emission above.
  let trapMsgRt = trapMsgRuntimeOf (progEmit prog)
  match symbolDefectsW (progEmit prog)
    [] =>
      Ok
        (joinNl
          (header
            ++ typeSection
            ++ imports
            ++ elemDecl
            ++ globals
            ++ constClosGlobals
            ++ fns
            ++ implFns
            ++ lifted
            ++ runtime
            ++ dataSegs
            ++ forceFns
            ++ initLines
            ++ trapMsgRt
            ++ [")"]))
    defects => Err defects

-- the passive data segments for string literals — one `(data $strseg_N "…")` per
-- distinct payload (`freshStrSeg`), emitted in segment-index order.  `array.new_data`
-- reads from these (the §11-preferred non-const-array init scheme; no active memory
-- needed).
emitDataSegs : WasmEmit -> List String
emitDataSegs emit =
  let segs = sortSegsByIdx (reverseL !emit.stringSegments)
  map oneDataSeg segs

oneDataSeg : (Int, List Int) -> String
oneDataSeg (i, bytes) =
  "  (data $strseg_\{intToString i} \"\{escWatBytes bytes}\")"

-- sort (idx, bytes) entries by ascending idx (insertion sort; segment counts are tiny).
sortSegsByIdx : List (Int, List Int) -> List (Int, List Int)
sortSegsByIdx [] = []
sortSegsByIdx (x :: xs) = insertSeg x (sortSegsByIdx xs)

insertSeg : (Int, List Int) -> List (Int, List Int) -> List (Int, List Int)
insertSeg x [] = [x]
insertSeg (i, b) ((j, c) :: rest) =
  if i <= j then (i, b) :: (j, c) :: rest else (j, c) :: insertSeg (i, b) rest

-- the `(elem declare func …)` line listing every fn `ref.func`'d (lifted lambdas,
-- the PAP code, and any top-level fn used as a value) — required so `ref.func`
-- validates.  Drained from WasmEmit after all bodies are emitted.
emitElemDeclare : WasmEmit -> String
emitElemDeclare emit =
  let names = map ("$" ++ _) (elemNames !emit.symbols)
  "  (elem declare func " ++ joinWith " " names ++ ")"

oneGlobalRef : String -> String
oneGlobalRef n =
  "  (global $" ++ gname n ++ " (mut (ref null eq)) (ref.null eq))"

-- ── §3.4 type section: one rec group with the universal root + per-type roots
-- + per payload-ctor structs.  Each payload struct has an explicit i32 tag field
-- (field 0 — defends against structural-subtyping collapse) then one (ref eq) per
-- payload field.  Nullary ctors need no struct (they are i31 immediates).  The
-- reserved Option/Result/Ordering types are appended (their structs only matter
-- for the payload ctors Some/Ok/Err).
emitTypeSection : Prog -> List String
emitTypeSection prog =
  let userTypes = userTypesWithCtors prog
  let userStructs = flatMap (emitTypeStructs prog) userTypes
  let reservedStructs = emitReservedStructs prog
  let closTypes =
    if contains "codety" (emitDemandW (progEmit prog)).representationTypes then
      closTypeLines
    else
      []
  let strTypes =
    if contains "str" (emitDemandW (progEmit prog)).representationTypes then
      strTypeLines
    else
      []
  let w7Types = emitW7Types (progEmit prog)
  [
      "  ;; ── §3 type section (rec group) — §3.4 ADT structs + §8.6 (ref eq)/i31 ──",
      "  (rec",
      "    ;; layer-17 §2.1: boxed Int outside ±2^30 (the $mdk_box_int/$mdk_unbox_int seam).",
      "    (type $boxint (sub (struct (field i64))))",
      "    ;; boxed Float (§3.3) — declared, unused until a Float fixture needs it.",
      "    (type $float (sub (struct (field f64))))",
      -- W5 nested requires-dict cell (mirrors llvm_emit's `[ i64 head_tag | i64 reqdict_0 | … ]`).
      -- A one-level dict stays an i31 (just the tag); a NESTED dict (`RKey k [reqs]`) is a
      -- $dictcell: field 0 = i32 hashName(head-tag), field 1 = a $dictarr of the recursively-
      -- built nested req witnesses.  Consumption (readDictParam / loadReqDicts) type-tests the
      -- witness: i31 ⇒ tag = i31.get_s, no reqs; $dictcell ⇒ tag = struct.get 0, reqs = array.
      "    (type $dictarr (array (mut (ref eq))))",
      "    (type $dictcell (sub (struct (field i32) (field (ref $dictarr)))))",
    ]
    ++ strTypes
    ++ closTypes
    ++ userStructs
    ++ reservedStructs
    ++ w7Types
    ++ ["  )"]

-- ── W7 collection types (§3.3) ───────────────────────────────────────────────
-- Conditionally emitted by usage (peer to strTypes):
--   List: root $T_List (i32 tag) + cons struct $C_Cons (tag, head, tail); Nil is an
--     i31 immediate (ordinal 1) so it needs no struct.  Matches the §3.3 + LLVM rep.
--   Tuple n: per-arity $T_Tup<n> root + $C_Tup<n> struct (tag + n (ref eq) fields).
--     A tuple is single-shape, but it reuses the W3 ctor machinery (discrimReadOf
--     reads the struct's field-0 tag = ordinal 0), so it carries a leading i32 tag.
--   Array: $arr = (array (mut (ref eq))) — array.len carries the length (§3.3).
--   Ref:   $refbox = a 1-field MUTABLE struct (setRef overwrites the field).
emitW7Types : WasmEmit -> List String
emitW7Types emit =
  let listT =
    if contains "T_List" (emitDemandW emit).representationTypes then
      [
        "    (type $T_List (sub (struct (field i32))))",
        -- §3/Stage-0: cons TAIL field (index 2) is `mut` so TRMC destination-passing can
        -- `struct.set` a freshly-built child into the parent cell.  Head (index 1) stays
        -- immutable.  `mut` only PERMITS mutation — output is unchanged (nothing writes it yet).
        "    (type $C_Cons (sub $T_List (struct (field i32) (field (ref eq)) (field (mut (ref eq))))))",
      ]
    else
      []
  let tupTs = flatMap tupleTypeDecl (reverseL !emit.tupleArities)
  let arrT =
    if contains "arr" (emitDemandW emit).representationTypes then
      ["    (type $arr (array (mut (ref eq))))"]
    else
      []
  let refT =
    if contains "refbox" (emitDemandW emit).representationTypes then
      ["    (type $refbox (sub (struct (field (mut (ref eq))))))"]
    else
      []
  -- a `U64` is a `$u64` cell, never an i31 or a `$boxint`: the i64 payload is read
  -- unsigned, and a separate type keeps every `ref.test` on the other shapes false.
  let u64T =
    if contains "u64" (emitDemandW emit).representationTypes then
      ["    (type $u64 (sub (struct (field i64))))"]
    else
      []
  -- an `I64` is an `$i64` cell: the same payload as `$u64`, read signed, and a
  -- type of its own so a shape-dispatched helper never reads one as the other.
  let i64T =
    if contains "i64" (emitDemandW emit).representationTypes then
      ["    (type $i64 (sub (struct (field i64))))"]
    else
      []
  listT ++ tupTs ++ arrT ++ refT ++ u64T ++ i64T

tupleTypeDecl : Int -> List String
tupleTypeDecl n =
  let fields = joinWith "" (replicate n " (field (ref eq))")
  let root = typeRootName (syntheticCtorType (tupleCtorName n))
  let cs = ctorStructName (tupleCtorName n)
  [
    "    (type $" ++ root ++ " (sub (struct (field i32))))",
    "    (type $\{cs} (sub $\{root} (struct (field i32)\{fields})))",
  ]

-- distinct user type names (declaration order) that actually own ctors, paired
-- with their ctor list.  Reserved types are handled separately so they are never
-- double-declared.
userTypesWithCtors : Prog -> List String
userTypesWithCtors (Prog _ typeNames _ _ _ _ _ _) =
  filterList (t => not (isReservedType t)) typeNames

-- per-type: a root struct (just the i32 tag) + one struct per PAYLOAD ctor (tag +
-- fields), each declared `(sub $root …)`.  Nullary ctors get no struct.
emitTypeStructs : Prog -> String -> List String
emitTypeStructs prog ty =
  let ctors = ctorsOfType prog ty
  let root = "    (type $" ++ typeRootName ty ++ " (sub (struct (field i32))))"
  let payloadStructs = flatMap (emitCtorStruct prog ty) ctors
  [root] ++ payloadStructs

emitCtorStruct : Prog -> String -> String -> List String
emitCtorStruct prog ty ctor =
  let arity = ctorArity prog ctor
  if arity == 0 then
    []
  else
    -- §3/Stage-0: ctor payload fields are `mut` so a TRMC-destination recursive field
    -- can be `struct.set` after the parent cell is built.  Field types are uniform
    -- `(ref eq)` here (no per-field type), so all payload fields are made `mut`; this is
    -- output-neutral (`mut` only PERMITS mutation — nothing writes them yet), following
    -- the `$refbox`/`$arr` precedent.
    let fields = joinWith "" (replicate arity " (field (mut (ref eq)))")
    [
      "    (type $\{ctorStructName ctor} (sub $\{typeRootName ty} (struct (field i32)\{fields})))",
    ]

-- reserved Option/Result/Ordering: declare each type's root + payload structs.
-- Emitted UNCONDITIONALLY in ref-mode (they are small; unused struct types are
-- valid WasmGC).  Detecting exact usage would need to scan the whole program for
-- reserved-ctor occurrences (constructions AND match heads) — the ctor table only
-- lists USER ctors — so always-declare is the simple correct choice for this slice.
emitReservedStructs : Prog -> List String
emitReservedStructs prog =
  reservedTypeStructs prog "Option" ["Some", "None"]
    ++ reservedTypeStructs prog "Result" ["Ok", "Err"]
    ++ reservedTypeStructs prog "Ordering" ["Lt", "Eq", "Gt"]

reservedTypeStructs : Prog -> String -> List String -> List String
reservedTypeStructs prog ty ctors =
  let root = "    (type $" ++ typeRootName ty ++ " (sub (struct (field i32))))"
  let payloadStructs = flatMap (emitReservedCtorStruct ty) ctors
  [root] ++ payloadStructs

-- reserved-ctor arities are fixed: Some/Ok/Err carry 1 payload field; None/Lt/Eq/Gt
-- are nullary.
emitReservedCtorStruct : String -> String -> List String
emitReservedCtorStruct ty ctor =
  if reservedCtorArity ctor == 0 then
    []
  else
    let fields =
      joinWith "" (replicate (reservedCtorArity ctor) " (field (ref eq))")
    [
      "    (type $\{ctorStructName ctor} (sub $\{typeRootName ty} (struct (field i32)\{fields})))",
    ]

-- ── ref-mode globals init + main ─────────────────────────────────────────────

-- #561 PR-B: the (mut i32) 3-state flag for a LAZY value global (0 UNFORCED / 1 FORCING
-- / 2 FORCED).  Peer of oneGlobalRef; the value cell $g_<name> stays (mut (ref null eq)).
oneGlobalState : String -> String
oneGlobalState n = "  (global $gs_" ++ gname n ++ " (mut i32) (i32.const 0))"

-- The program entry, shared by both init shapes.  `mdk_entry_split` marks a
-- module whose `start` does not run `main`: a host that finds `mdk_main` without
-- it holds a module whose `start` already runs `main`, and calling `mdk_main`
-- would run the program twice, so the hosts refuse such a module.
entryExports : List String
entryExports = [
  "  (export \"mdk_main\" (func $__main))",
  "  (func $__entry_split)",
  "  (export \"mdk_entry_split\" (func $__entry_split))",
]

emitRefInit : Prog -> EmitPlan -> List CBind -> List String
emitRefInit prog plan groups =
  -- #561 PR-B: only SAFE (statically-orderable) value globals are eager-initialised in
  -- $__init — byte-identical to the pre-#561 emitter whenever no global is lazy.  A SAFE
  -- global's whole eager reach is SAFE (the taint is downward-closed over reads), so this
  -- prologue never calls a $force fn.  LAZY globals are initialised on first use by their
  -- $force_<name> defines (emitRefForceFns); they are excluded from the eager set here.
  let valBinds = plannedValBinds plan groups
  let initProg = progWithOrigin "value initialization" (progInFn prog)
  let mainProg = progWithOrigin "main" (progInFn prog)
  let _ =
    forEachU
      (f => defineFnW (progWithOrigin "module" prog) f (FuncParams 0))
      ["__main", "__entry_split", "__init"]
  let initW7Outer = w7ScopeOpen (progEmit prog)
  let valInit = flatMap (emitRefValInit initProg) valBinds
  let initW7Used = w7ScopeClose (progEmit prog) initW7Outer
  let mainW7Outer = w7ScopeOpen (progEmit prog)
  let mainLines = emitRefMain mainProg plan groups
  let mainW7Used = w7ScopeClose (progEmit prog) mainW7Outer
  let valLocals =
    if rawProgramW prog then [] else flatMap collectBindLocals valBinds
  let mainBodies = match findMain (progEmit prog) groups
    Some body => [body]
    None => []
  let mainLocals =
    if rawProgramW prog then [] else flatMap collectExprLocals mainBodies
  let valBodies = flatMap bindBodies valBinds
  -- scratch ($__rf<d>) locals sized to the deepest match nesting of each
  -- function's own bodies: the val inits for $__init, `main` for $__main.
  let valDepth = if rawProgramW prog then 0 else foldMaxDepth valBodies
  let mainDepth = if rawProgramW prog then 0 else foldMaxDepth mainBodies
  let initLocalDecls =
    map
      (l => "  " ++ localDeclRef l)
      (dedupKeep valLocals
        ++ (if rawProgramW prog then [] else scratchLocals valDepth))
  let mainLocalDecls =
    map
      (l => "  " ++ localDeclRef l)
      (dedupKeep mainLocals
        ++ (if rawProgramW prog then [] else scratchLocals mainDepth))
  let initW7Decls = map ("  " ++ _) (w7LocalDecls initW7Used valDepth)
  let mainW7Decls = map ("  " ++ _) (w7LocalDecls mainW7Used mainDepth)
  -- `start` runs only the eager value inits; `main` is the exported
  -- `mdk_main`, which every host calls after instantiation.  A module
  -- instantiated without that call runs no program code.  A suspending
  -- import (JSPI) cannot be reached from `start`, and a host may re-enter
  -- `mdk_main` on one instance (playground/compile.mjs keeps the compiler's
  -- top-level memo Refs alive across analyze calls that way).
  ["  (func $__main"]
    ++ numericDeclsW mainProg
    ++ rawScratchW mainProg
    ++ mainLocalDecls
    ++ mainW7Decls
    ++ mainLines
    ++ ["  )"]
    ++ entryExports
    ++ ["  (func $__init"]
    ++ numericDeclsW initProg
    ++ rawScratchW initProg
    ++ initLocalDecls
    ++ initW7Decls
    ++ valInit
    ++ ["  )", "  (start $__init)"]

bindBodies : CBind -> List CExpr
bindBodies (CBind _ clauses _ _) = flatMap clauseBody clauses

clauseBody : CClause -> List CExpr
clauseBody (CClause _ body) = [body]

foldMaxDepth : List CExpr -> Int
foldMaxDepth [] = 0
foldMaxDepth (e :: rest) = maxI (maxRefDepth e) (foldMaxDepth rest)

emitRefValInit : Prog -> CBind -> List String
emitRefValInit prog (CBind name [CClause [] body] _ _) =
  let instrs = emitRefExpr prog envEmpty 0 body
  indent instrs ++ ["    " ++ globalW prog "global.set" ("$" ++ gname name)]
emitRefValInit prog _ = gapLP prog "value binding must be a nullary clause"

-- ── #561 PR-B: lazy value-global force functions ─────────────────────────────
-- A `$force_<name>` func for every LAZY value global (dispatch-reaching / cyclic — see
-- emit_support.lazyGlobalNames).  A faithful transliteration of the reference engine's
-- forceMemo/blackholeCell (compiler/eval/eval.mdk) and the native @mdk_force_<x>:
--   state 2 FORCED   -> return the memoised $g_<name>
--   state 1 FORCING  -> re-entered mid-init => E-CYCLIC-VALUE (the black-hole), unreachable
--   state 0 UNFORCED -> mark FORCING, run the rhs, memoise the value, mark FORCED, return
-- The FORCING flag is set BEFORE the body runs (the black-hole ordering), so a re-entrant
-- read `call $force_<name>` from inside the body hits state 1 and traps.  A read of another
-- global inside the body lowers through emitVarRefPlain exactly as anywhere else (a plain
-- `global.get` for a SAFE dep — already eager-set by $__init, which runs first — or a nested
-- `call $force_` for a LAZY dep).  Result is a non-null (ref eq) via ref.as_non_null on the
-- memoised cell, the same guarantee every eager global read carries.
emitRefForceFns : Prog -> List CBind -> List String
emitRefForceFns prog groups =
  flatMap
    (b => emitRefForceFn (progWithOrigin (bindName b) prog) b)
    (filterList
      (b => isLazyGlobalW prog (bindName b))
      (filterList isValBind groups))

emitRefForceFn : Prog -> CBind -> List String
emitRefForceFn prog (CBind name [CClause [] body] _ _) =
  let g = gname name
  let _ = defineFnW prog ("force_" ++ g) (FuncParams 0)
  let w7Outer = w7ScopeOpen (progEmit prog)
  let instrs = emitRefExpr prog envEmpty 0 body
  let bodyLocals = dedupKeep (collectExprLocals body)
  let maxDepth = maxRefDepth body
  let scratch = scratchLocals maxDepth
  let localDecls = map (l => "  " ++ localDeclRef l) (bodyLocals ++ scratch)
  let w7Decls =
    map
      ("  " ++ _)
      (w7LocalDecls (w7ScopeClose (progEmit prog) w7Outer) maxDepth)
  let cyclic =
    wasmTrapNamed
      (progEmit prog)
      "E-CYCLIC-VALUE"
      name
      " refers to itself during initialization (non-productive cyclic value)\n"
  let value = "$" ++ g
  let state = "$gs_" ++ g
  let unforced =
    ["    i32.const 1", "    " ++ globalW prog "global.set" state]
      ++ indent instrs
      ++ [
        "    local.set $__frcv",
        "    local.get $__frcv",
        "    " ++ globalW prog "global.set" value,
        "    i32.const 2",
        "    " ++ globalW prog "global.set" state,
        "    local.get $__frcv",
        "    ref.as_non_null",
      ]
  [
      "  (func $force_" ++ g ++ " (result (ref eq))",
      "  (local $__frcv (ref null eq))",
    ]
    ++ localDecls
    ++ w7Decls
    ++ [
      "    " ++ globalW prog "global.get" state,
      "    i32.const 2",
      "    i32.eq",
      "    if (result (ref eq))",
      "    " ++ globalW prog "global.get" value,
      "    ref.as_non_null",
      "    else",
      "    " ++ globalW prog "global.get" state,
      "    i32.const 1",
      "    i32.eq",
      "    if (result (ref eq))",
    ]
    ++ indent cyclic
    ++ ["    else"]
    ++ unforced
    ++ ["    end", "    end", "  )"]
emitRefForceFn prog (CBind name _ _ _) =
  -- in record mode the gap stands in for this force function
  let _ =
    setRef
      (progEmit prog).symbols
      (excuseSymbol
        (WasmFunc ("force_" ++ gname name))
        !(progEmit prog).symbols)
  gapLP prog "value binding must be a nullary clause"

-- main: compute the body (a (ref eq)), then unbox to i32 and route to the print
-- import by the body's STATIC kind (Int vs Bool — the only printable scalar mains
-- in this slice).  In ref-mode an Int/Bool result is an i31 immediate, so unbox via
-- `i31.get_s` / `i31.get_u`.
emitRefMain : Prog -> EmitPlan -> List CBind -> List String
emitRefMain prog plan groups = match findMain (progEmit prog) groups
  Some body =>
    let value = emitValueW prog envEmpty 0 body
    let instrs = valueLines value
    if rawProgramW prog then
      indent instrs ++ printFor prog (rawPrintKindW (valueRepr value))
    else
      emitBoxedMainW prog plan groups body instrs
  None => gapLP prog "no `main` binding"

emitBoxedMainW : Prog ->
  EmitPlan ->
  List CBind ->
  CExpr ->
  List String ->
  List String
emitBoxedMainW prog plan groups body instrs =
  -- A main stamped `Unit` is Unit whatever its body's shape, and one stamped
  -- with a printable scalar prints as that scalar: the structural read below is
  -- only for a main with no stamp of its own (an untyped lowering stamps every
  -- binder `RTValue`).  The typechecker's Float hint overrides a body whose
  -- result is a polymorphic return (`main = fold (acc x => acc + x) 0.0 [..]`).
  let k =
    if planEntryMainIsUnit plan
      || mainStamp prog == RTUnit
      || mainBodyIsUnit prog (cafBodies groups) body then
      WUnit
    else if planEntryMainIsFloat plan then
      WFloat
    else
      stampPrintKind (mainPrintStamp prog body)
  -- a Unit main (a `putStrLn …` etc.) has already produced its IO effect; drop its
  -- i31-0 result and auto-print NOTHING (the "Unit main no auto-print" contract).
  match k
    WUnit => indent instrs ++ ["    drop"]
    _ => indent instrs ++ refPrintFor prog k

-- W9b: a value main whose head function returns Unit (`println`, `print`, any
-- user/prelude Unit-returning wrapper: the head's return stamp) is a Unit main and
-- must NOT auto-print its result, or the Unit result would go to the Int printer
-- (a trailing `0`).
-- `cafs` maps each top-level nullary value binding still in scope to its body: a
-- reference to an unannotated CAF (`go = println "x"; main = go`) is Unit iff that
-- body is.  Following a CAF removes it from the map, so a cyclic chain ends False.
mainBodyIsUnit : Prog -> OrdMap CExpr -> CExpr -> Bool
mainBodyIsUnit prog _ (CApp f _ _) = match appHead f
  CVar fn _ =>
    isUnitExtern (runtimeNameW prog fn)
      || returnStamp prog envEmpty fn == RTUnit
  -- `println`/`print` are `Display a =>` constrained → the dict-pass rewrites the
  -- head to a CDict carrying the routes; recover the bare name.
  CDict fn _ => returnStamp prog envEmpty fn == RTUnit
  _ => False
mainBodyIsUnit prog cafs (CVar fn _) =
  if returnStamp prog envEmpty fn == RTUnit then
    True
  else match omLookup fn cafs
    Some body => mainBodyIsUnit prog (omDelete fn cafs) body
    None => False
mainBodyIsUnit prog _ (CDict fn _) = returnStamp prog envEmpty fn == RTUnit
mainBodyIsUnit prog cafs (CLet _ pat _ b) =
  mainBodyIsUnit prog (shadowCafs (patVars pat) cafs) b
-- the native branch-(2) equivalent: an UNANNOTATED `main = match … { … }` whose
-- Unit-ness is only knowable from its inferred body type (e.g. check_main's
-- `match args () { [r,c,f] => withFiles … ; _ => ePutStrLn … }`).  Type-erased here,
-- so reason structurally: a match/decision body is Unit iff EVERY tail leaf is Unit
-- (an IO-extern returning Unit, a fn whose declared ret is Unit, or another all-Unit
-- match).  Conservative — a single non-Unit leaf ⇒ False, so a value main is never
-- suppressed.  Block/Let tails recurse to their final expr.
mainBodyIsUnit prog cafs (CDecision _ arms _) = allArmsUnit prog cafs arms
mainBodyIsUnit prog cafs (CMatch _ arms) = allArmsUnit prog cafs arms
mainBodyIsUnit prog cafs (CBlock stmts) = blockTailIsUnit prog cafs stmts
mainBodyIsUnit _ _ _ = False

-- True iff every match/decision arm body is itself a Unit main body.  Empty ⇒ False
-- (no leaves to prove Unit ⇒ don't suppress).
allArmsUnit : Prog -> OrdMap CExpr -> List CArm -> Bool
allArmsUnit _ _ [] = False
allArmsUnit prog cafs arms = allArmsUnitGo prog cafs arms

allArmsUnitGo : Prog -> OrdMap CExpr -> List CArm -> Bool
allArmsUnitGo _ _ [] = True
allArmsUnitGo prog cafs ((CArm pat _ body) :: rest) =
  if mainBodyIsUnit prog (shadowCafs (patVars pat) cafs) body then
    allArmsUnitGo prog cafs rest
  else
    False

blockTailIsUnit : Prog -> OrdMap CExpr -> List CStmt -> Bool
blockTailIsUnit _ _ [] = False
blockTailIsUnit prog cafs [CSExpr e] = mainBodyIsUnit prog cafs e
blockTailIsUnit prog cafs ((CSLet _ pat _) :: rest) =
  blockTailIsUnit prog (shadowCafs (patVars pat) cafs) rest
blockTailIsUnit prog cafs (_ :: rest) = blockTailIsUnit prog cafs rest

-- The top-level nullary value bindings, name -> body (`isValBind`: never `main`).
cafBodies : List CBind -> OrdMap CExpr
cafBodies groups = omFromPairs (cafBodyRows groups) omEmpty

cafBodyRows : List CBind -> List (String, CExpr)
cafBodyRows [] = []
cafBodyRows ((CBind name [CClause [] body] _ _) :: rest) =
  if name == "main" then cafBodyRows rest else (name, body) :: cafBodyRows rest
cafBodyRows (_ :: rest) = cafBodyRows rest

-- A local binder of the same name hides a top-level CAF below it.
shadowCafs : List String -> OrdMap CExpr -> OrdMap CExpr
shadowCafs [] cafs = cafs
shadowCafs (x :: xs) cafs = shadowCafs xs (omDelete x cafs)

-- The stamp of `main` itself: the type of the value it holds.
mainStamp : Prog -> RuntimeType
mainStamp prog = varStamp prog envEmpty "main"

-- What `main`'s result prints as: its own stamp where that is a printable
-- scalar, else the stamp the body states for itself.
mainPrintStamp : Prog -> CExpr -> RuntimeType
mainPrintStamp prog body =
  let own = mainStamp prog
  if isPrintableScalarStamp own then own else cexprStamp prog envEmpty body

isPrintableScalarStamp : RuntimeType -> Bool
isPrintableScalarStamp RTInt = True
isPrintableScalarStamp RTFloat = True
isPrintableScalarStamp RTBool = True
isPrintableScalarStamp RTChar = True
isPrintableScalarStamp RTString = True
isPrintableScalarStamp _ = False

-- the auto-print kind of a main whose result has stamp [t]; a stamp that names no
-- printable scalar prints as an Int
stampPrintKind : RuntimeType -> WTy
stampPrintKind RTFloat = WFloat
stampPrintKind RTBool = WBool
stampPrintKind RTString = WStr
stampPrintKind RTChar = WChar
stampPrintKind RTUnit = WUnit
stampPrintKind _ = WInt

-- the Unit-RESULT IO externs: a `main = putStrLn …` produces Unit and must NOT be
-- auto-printed (the "Unit main no auto-print" contract — the native oracle prints
-- nothing for a Unit main; the IO side effect IS the output).
isUnitExtern : String -> Bool
-- Intentional cross-file duplicate of the same helper in llvm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
isUnitExtern name =
  contains name ["putStr", "putStrLn", "ePutStr", "ePutStrLn", "flushStdout"]

refPrintFor : Prog -> WTy -> List String
refPrintFor prog WInt =
  ["    " ++ unboxIntW prog, "    " ++ rtCallW prog "mdk_print_int" 1]
refPrintFor prog WBool = [
  "    ref.cast (ref i31)",
  "    i31.get_u",
  "    " ++ rtCallW prog "mdk_print_bool" 1,
]
refPrintFor prog WStr =
  ["    ref.cast (ref $str)", "    " ++ rtCallW prog "mdk_print_strln" 1]
-- a Char main: an i31 codepoint → encode to a $str via $mdk_char_to_str → print + '\n'
-- (matches the oracle's pp_value, which renders a Char as its glyph).  Forces the
-- $str rep + the char-encode strLeaf runtime (see noteW8MainChar).
refPrintFor prog WChar = [
  "    ref.cast (ref i31)",
  "    i31.get_u",
  "    " ++ rtCallW prog "mdk_char_to_str" 1,
  "    " ++ rtCallW prog "mdk_print_strln" 1,
]
-- W8b: a Float main → unbox the $float → format ($mdk_float_to_str builds a $str)
-- → print + '\n' (matches the oracle's mdk_print_float — shortest-round-trip since #57,
-- + the .0 rule — NOT %.12g; see wasm_preamble.mdk's W8b Float section).
refPrintFor prog WFloat = [
  "    ref.cast (ref $float)",
  "    struct.get $float 0",
  "    " ++ rtCallW prog "mdk_float_to_str" 1,
  "    " ++ rtCallW prog "mdk_print_strln" 1,
]
refPrintFor prog WUnit = gapLP prog "ref-mode: Unit main has no value to print"
refPrintFor prog WRef =
  gapLP
    prog
    "ref-mode main produced a non-scalar value — printing ADTs is W6b (Debug)"

-- ── ref-mode top-level function defs ─────────────────────────────────────────
-- Every param/local/result is `(ref eq)`.  Three shapes:
--   * single clause, all-PVar params → the fast path: bind params, TAIL-emit the
--     body (self-recursion + general tail calls become return_call/return_call_ref).
--   * single clause with a non-PVar (literal/ctor) param, OR multiple clauses →
--     coalesce into a synthetic-parameter dispatch: each clause becomes a guarded
--     block testing its non-PVar params, binding its PVar params, then tail-emitting
--     its body; clauses fall through in order (W4 clause-dispatch coalescing,
--     peer to llvm_emit's emitClauseTree).
-- After the body, if `name` is used anywhere as a VALUE (passed/returned/partially
-- applied), also emit a closure wrapper `$name__clos` (a $clos with arity = param
-- count, code = a thunk that unpacks the args array + calls $name).
emitRefFnBind : Prog -> CBind -> List String
emitRefFnBind outer (CBind name clauses bindLoc _) =
  let prog =
    progForBinding name bindLoc (sitePackedW (progEmit outer) bindLoc) outer
  let arity = clauseArityOf clauses
  let params =
    if rawProgramW prog then match clauses
      [CClause pats _] => map (patName (progEmit prog) name) pats
      _ => synthParams arity
    else
      clauseParamNames clauses arity
  -- Stage-2/3 (b′): a member of a detected dispatch-TMC group emits via the dest-passing
  -- reset-wrapper (root) / inner-loop or redirected-leaf member path.  The group takes
  -- PRECEDENCE over Stage-1: a group root like the lexer's `layout` is Stage-1-eligible
  -- for its SELF-cons arm, but only the group transform linearizes the cross-member
  -- edges (`layout ↔ flushCloseGo ↔ …`) — and a Stage-1-emitted member inside a group
  -- would return its own locally-built spine instead of closing the group's shared dest
  -- globals (a miscompile).  Detection keeps a Stage-1-claimable SINGLETON out of any
  -- group (wDispValidate v5), so plain self-TMC fns still take the Stage-1 loop below.
  if rawProgramW prog then
    emitOrdinaryFnW prog name params arity clauses
  else match dispGroupOf (progEmit prog).wDispGroups.value name
    Some grp =>
      let gd =
        if wDispIsRoot grp name then
          emitWDispRoot prog grp arity clauses
        else
          emitWDispMemberFn prog grp name name arity clauses
      gd
        ++ (if needsClosWrapper prog name then
          emitFnClosWrapper prog name arity
        else
          [])
    None => match wasmTrmcTry prog name arity clauses
      -- Stage 1 (WASMGC-TRMC-DESIGN §7): a top-level self-recursive define (uniform
      -- leading-dict count; dicts ride along as loop slots) whose
      -- clauses are `trmcEligible` for the self-only cons/ctor-tail shape (a) is emitted as
      -- a destination-passing LOOP (emitWasmTrmcBind) instead of the stack-growing recursive
      -- call (emitRefTail's generic ctor arm evaluates the self-call as a struct.new ARG, so
      -- the frame stays live → deep lists overflow).  Ineligible fns fall to the normal path.

      Some tmcDef =>
        tmcDef
          ++ (if needsClosWrapper prog name then
            emitFnClosWrapper prog name arity
          else
            [])
      None => emitOrdinaryFnW prog name params arity clauses

emitOrdinaryFnW : Prog ->
  String ->
  List String ->
  Int ->
  List CClause ->
  List String
emitOrdinaryFnW prog name params arity clauses =
  let w7Outer = w7ScopeOpen (progEmit prog)
  let bodyLines =
    if rawProgramW prog then match clauses
      [CClause pats body] =>
        if allPlainParams pats then
          let _ = installRawParamsW prog 0 pats
          emitRefTail prog (paramEnv pats) arity body
        else
          gapLP
            prog
            ("scalar-mode top-level function '"
              ++ name
              ++ "' is multi-clause or pattern-matching (decision-tree match needs ADT mode)")
      _ =>
        gapLP
          prog
          ("scalar-mode top-level function '"
            ++ name
            ++ "' is multi-clause or pattern-matching (decision-tree match needs ADT mode)")
    else
      emitClausesRef prog name params arity clauses
  let extraLocals =
    if rawProgramW prog then
      []
    else
      filterList (notIn params) (dedupKeep (clauseLocals clauses))
  let depth = if rawProgramW prog then 0 else clausesMaxDepth clauses
  let scratch = if rawProgramW prog then [] else scratchLocals depth
  let paramDecls =
    if rawProgramW prog then
      map (_ => " (param i64)") params
    else
      map paramDeclRef params
  let _ = defineFnW prog (gname name) (FuncParams (listLen params))
  let sig =
    "  (func $\{gname name}\{joinWith "" paramDecls} (result \{physicalType (programReprW prog)})"
  let localDecls = map localDeclRef (extraLocals ++ scratch)
  let w7Decls = w7LocalDecls (w7ScopeClose (progEmit prog) w7Outer) depth
  let fnDef =
    [sig]
      ++ numericDeclsW prog
      ++ rawScratchW prog
      ++ map ("  " ++ _) (localDecls ++ w7Decls)
      ++ indent bodyLines
      ++ ["  )"]
  fnDef
    ++ (if needsClosWrapper prog name then
      emitFnClosWrapper prog name arity
    else
      [])

-- synthetic positional parameter names `$__wparg0 $__wparg1 …` (used for multi-clause
-- dispatch and as the uniform fn ABI param names).  The `__wparg` prefix is RESERVED:
-- a source pattern variable in a clause head (e.g. `unifyN (TFun a1 r1 b1) (TFun a2 r2
-- b2)` binds `a1`) must NOT collide with a sibling positional param's wasm local, or
-- its `local.set` clobbers a not-yet-read argument and a later field extract `ref.cast`
-- traps `illegal cast` (layer-11 bug: the second `TFun`'s value was destroyed by the
-- first clause head binding a var literally named `a1` into `$a1`).  Earlier these were
-- `$a0/$a1/…`, which a user var named `a1` aliased directly.  `gname` escapes any user
-- identifier spelled `__wparg<digits>` (mirrors the `self`/`args` reserved-name escape),
-- so the positional params are provably distinct from every clause-bound source var.
synthParams : Int -> List String
synthParams n = map (i => "__wparg" ++ intToString i) (rangeList 0 n)

-- wasm param names for a clause group.  A single clause whose params are all plain and
-- whose body has no guard fallthrough takes the fast path (emitClausesRefEnv and the
-- TRMC loop): a PVar param is named by its source variable, so the body reads the wasm
-- param directly and no `local.get $__wparg<i>; local.set $x` copy is emitted.  The
-- source name is kept only when it is not `__`-prefixed (scratch locals), is bound once
-- in the head, and is not bound again by a local of the body (a shadowing binder would
-- otherwise share the param's own wasm local).  Every other param keeps its positional
-- `__wparg<i>` name (a PWild, a shadowed name, or any param of a multi-clause group).
clauseParamNames : List CClause -> Int -> List String
clauseParamNames [CClause pats body] arity =
  if allPlainParams pats && not (exprHasFallthrough body) then
    headParamNames pats (collectExprLocals body) 0
  else
    synthParams arity
clauseParamNames _ arity = synthParams arity

headParamNames : List Pat -> List String -> Int -> List String
headParamNames [] _ _ = []
headParamNames (p :: ps) inner i =
  let name = "__wparg" ++ intToString i
  let chosen = match p
    PVar x _ _ => if startsWith "__" x || contains x inner then name else x
    _ => name
  chosen :: headParamNames ps inner (i + 1)

-- emit the clause chain.  Single all-PVar clause: rename its params to the synthetic
-- positions (so the body env binds them) and tail-emit.  Otherwise: a fallthrough
-- chain of guarded blocks.
emitClausesRef : Prog ->
  String ->
  List String ->
  Int ->
  List CClause ->
  List String
emitClausesRef prog name params arity clauses =
  emitClausesRefEnv prog envEmpty name params arity clauses

-- W9: env-seeded clause emission — `baseEnv` names (a CLetGroup's sibling closures +
-- captured outer vars, bound as locals before the body) are in scope in every clause
-- body in addition to the clause's own param bindings.  The non-letgroup path passes
-- baseEnv=[] (emitClausesRef).
emitClausesRefEnv : Prog ->
  Env ->
  String ->
  List String ->
  Int ->
  List CClause ->
  List String
-- the single-clause fast path skips the clause BLOCK (plain params need no test).
-- But a guard chain in the body desugars to `__fallthrough__`, which needs a block
-- to `br` to — so when the body contains one, fall back to the chain path (its
-- block wrapper + trailing `unreachable` give the fall-through a target).
emitClausesRefEnv prog baseEnv name params arity (clauses@[CClause pats body]) =
  if allPlainParams pats && not (exprHasFallthrough body) then
    let aliases = bindParamAliases prog pats params
    let env = paramEnvOver pats baseEnv
    aliases ++ emitRefTail prog env arity body
  else
    emitClauseChainRefEnv prog baseEnv name params arity clauses
emitClausesRefEnv prog baseEnv name params arity clauses =
  emitClauseChainRefEnv prog baseEnv name params arity clauses

-- when the single clause's params are plain PVars, alias each to its wasm param:
-- `local.get $<param>; local.set $<srcname>`.  A PVar already named by its source
-- variable (clauseParamNames) IS its own wasm param, so no copy is emitted.  (The
-- source names are declared as locals via clauseLocals.)
bindParamAliases : Prog -> List Pat -> List String -> List String
bindParamAliases prog pats params =
  flatMap (aliasOne prog) (zipPats pats params)

aliasOne : Prog -> (Pat, String) -> List String
aliasOne _ (PVar x _ _, a) =
  if x == a then [] else ["local.get $" ++ gname a, "local.set $" ++ gname x]
aliasOne _ (PWild, _) = []
aliasOne prog _ = gapLP prog "ref-mode: non-plain param in fast-path alias"

zipPats : List Pat -> List String -> List (Pat, String)
zipPats (p :: ps) (a :: bs) = (p, a) :: zipPats ps bs
zipPats _ _ = []

allPlainParams : List Pat -> Bool
allPlainParams pats = not (anyList (p => not (isPlainParam p)) pats)

-- the fallthrough clause chain.  Each clause: a block `$cl<i>` that tests its
-- non-PVar params (literal/ctor) against the synthetic positions, binds its PVar
-- params, and on full match TAIL-emits its body; a failed test `br $cl<i>` falls
-- through to the next clause.  The last clause's failure is `unreachable` (a
-- well-typed exhaustive fn won't reach it).
emitClauseChainRefEnv : Prog ->
  Env ->
  String ->
  List String ->
  Int ->
  List CClause ->
  List String
emitClauseChainRefEnv prog baseEnv name params arity clauses =
  emitClauseChainGo
    prog
    baseEnv
    name
    params
    arity
    clauses
    0
    (progFnCtx prog).site

emitClauseChainGo : Prog ->
  Env ->
  String ->
  List String ->
  Int ->
  List CClause ->
  Int ->
  Int ->
  List String
-- B5: the last clause fell through (non-exhaustive function) → coded trap.
emitClauseChainGo prog _ _ _ _ [] _ site = wasmNonexhTrap (progEmit prog) site
emitClauseChainGo prog baseEnv name params arity ((CClause pats body) :: rest) i site =
  let clLabel = "$cl_\{name}_\{intToString i}"
  let (tests, binds, env) = clausePatCodeEnv prog baseEnv pats params clLabel
  -- A guard chain inside this clause's body desugars to `__fallthrough__` (the
  -- "no arm matched, try the next clause" sentinel).  We REWRITE each such occurrence
  -- in the body to a label-carrying sentinel `__ft__<clLabel>` BEFORE emitting, so the
  -- emitter lowers it to `br <clLabel>` as a PURE function of the var name.  (A mutable
  -- "current label" ref does NOT work here: this emitter builds the instruction list
  -- lazily and forces the strings at final assembly, long after any setRef/restore —
  -- so the read would see a stale/default label.  Encoding the target in the node is
  -- timing-independent.)  `br <clLabel>` exits this clause's block, landing on the next
  -- clause (or the chain's trailing `unreachable` for the last clause).
  let body2 = labelFallthrough body clLabel
  ["block " ++ clLabel]
    ++ indent (tests ++ binds ++ emitRefTail prog env arity body2)
    ++ ["end"]
    ++ emitClauseChainGo prog baseEnv name params arity rest (i + 1) site

-- `ftPrefix` / `labelFallthrough` are the BACKEND-NEUTRAL sentinel-labelling pass —
-- they now live in `backend/emit_support.mdk` and are shared with the LLVM emitter,
-- which had reimplemented the same idea as a mutable "current label" Ref and
-- MISCOMPILED a refutable pattern-guard clause because of it (see the comment there).

-- generate (tests, binds, env) for a clause's parameter patterns against the
-- synthetic positional params.  A `br clLabel` on a failed test falls to the next
-- clause.  PLit param → compare the i31 against the constant.  PCon param → test
-- the discriminant + bind fields.  PVar → bind to a local.  PWild → nothing.
clausePatCodeEnv : Prog ->
  Env ->
  List Pat ->
  List String ->
  String ->
  (List String, List String, Env)
clausePatCodeEnv prog baseEnv pats params clLabel =
  clausePatGo prog (zipPats pats params) clLabel [] [] baseEnv

clausePatGo : Prog ->
  List (Pat, String) ->
  String ->
  List String ->
  List String ->
  Env ->
  (List String, List String, Env)
clausePatGo _ [] _ tAcc bAcc env = (tAcc, bAcc, env)
clausePatGo prog ((pat, a) :: rest) clLabel tAcc bAcc env =
  let occ = ["local.get $" ++ gname a]
  let (t, b, env2) = patTestBind prog pat occ clLabel env
  clausePatGo prog rest clLabel (tAcc ++ t) (bAcc ++ b) env2

-- (tests, binds, env') for matching `pat` against the value snippet `occ`.
patTestBind : Prog ->
  Pat ->
  List String ->
  String ->
  Env ->
  (List String, List String, Env)
patTestBind prog PWild occ clLabel env = ([], [], env)
patTestBind prog (PVar x _ bid) occ clLabel env =
  ([], occ ++ ["local.set $" ++ gname x], envBind x bid env)
-- #759: unbox the scrutinee through the $mdk_unbox_int seam (i31 OR $boxint) and
-- compare at full i64 width.  An `i31.get_s` + `i32.const n` path truncates to
-- 31 bits — for |n| >= 2^30 the `i32.const` overflows (wasm-tools REJECTS the module)
-- and a boxed scrutinee ref.casts to i31 and TRAPS.
patTestBind prog (PLit (LInt n)) occ clLabel env = (
  occ
    ++ [
      unboxIntW prog,
      "i64.const " ++ intToString n,
      "i64.ne",
      "br_if " ++ clLabel,
    ],
  [],
  env,
)
patTestBind prog (PLit (LBool b)) occ clLabel env = (
  occ
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      "i32.const " ++ (if b then "1" else "0"),
      "i32.ne",
      "br_if " ++ clLabel,
    ],
  [],
  env,
)
-- W9: a `()` (Unit) clause head — Unit is the i31 0 immediate, irrefutable here
-- (the type guarantees the value is Unit), so no test and no binding.
patTestBind prog (PLit LUnit) occ clLabel env = ([], [], env)
-- W9: a Char-literal clause head — a Char is an i31 codepoint immediate (same rep
-- as emitLitRef (LChar)); compare the i31 against the codepoint constant.
patTestBind prog (PLit (LChar c)) occ clLabel env = (
  occ
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      "i32.const "
        ++ intToString (charCode (arrayGetUnsafe 0 (stringToChars c))),
      "i32.ne",
      "br_if " ++ clLabel,
    ],
  [],
  env,
)
patTestBind prog (PLit (LString s)) occ clLabel env =
  let cmpSuffix = [
    rtCallW prog "mdk_str_compare" 2,
    "ref.cast (ref i31)",
    "i31.get_u",
    "i32.const 1",
    "i32.ne",
    "br_if " ++ clLabel,
  ]
  (
    occ ++ ["ref.cast (ref $str)"] ++ emitLitRef prog (LString s) ++ cmpSuffix,
    [],
    env,
  )
-- W10: a constructor clause head — test the discriminant, then descend into each
-- field with patTestBind (NOT bindConFields).  A nested field pattern can itself be
-- refutable (e.g. `Variant cname (ConNamed fs)` — the inner `ConNamed` discriminates
-- against a sibling `ConPos` of the same payload type), so the field must emit its own
-- discriminant test, else its struct cast runs unconditionally and traps `illegal
-- cast` on the sibling shape.  bindConFields only binds (no tests), so it is unsound
-- for refutable nested ctors — mirror PCons/PTuple/PList, which recurse via patTestBind.
patTestBind prog (PCon c args) occ clLabel env =
  let ctest =
    discrimReadOf occ (ctorTypeName prog c)
      ++ [
        "i32.const " ++ intToString (ctorOrdinal prog c),
        "i32.ne",
        "br_if " ++ clLabel,
      ]
  let (ft, fb, env2) = patTestBindCon prog c args occ clLabel env 0
  (ctest ++ ft, fb, env2)
patTestBind prog (PAs x _ bid p) occ clLabel env =
  let setX = occ ++ ["local.set $" ++ gname x]
  let (t, b, env2) = patTestBind prog p occ clLabel (envBind x bid env)
  (t, setX ++ b, env2)
-- W9: a refutable cons-cell clause head `(h :: t)` — the focus must be a Cons
-- (ordinal 0; Nil is ordinal 1), else fall to the next clause.  Then test+bind
-- the head (field 1) and tail (field 2) recursively (nested patterns may also be
-- refutable, e.g. `[x] = (x :: [])`).
patTestBind prog (PCons h t) occ clLabel env =
  let consTest =
    discrimReadOf occ "List" ++ ["i32.const 0", "i32.ne", "br_if " ++ clLabel]
  let hSnip = occ ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 1"]
  let tSnip = occ ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 2"]
  let (ht, hb, env2) = patTestBind prog h hSnip clLabel env
  let (tt, tb, env3) = patTestBind prog t tSnip clLabel env2
  (consTest ++ ht ++ tt, hb ++ tb, env3)
-- W9: a refutable fixed-length list clause head `[p0, p1, …]` — descend the Cons
-- spine: each element's cell must be a Cons (else fall through), then the final
-- tail must be Nil (ordinal 1).
patTestBind prog (PList ps) occ clLabel env =
  patTestBindList prog ps occ clLabel env
-- W9: a tuple clause head `(p0, p1, …)` — a tuple is single-shape (irrefutable),
-- so no test; bind each field (field i+1 of $C_Tup<n>) and recurse for nested
-- refutable subpatterns.
patTestBind prog (PTuple ps) occ clLabel env =
  patTestBindTuple prog (tupleCtorName (listLen ps)) ps occ clLabel env 0
-- G6 (#379): a range pattern `lo..=hi` / `lo..hi`.  PRng canonicalizes to PWild in the
-- decision matrix (core_ir_lower's canonPat), so the tree routes to this arm
-- UNCONDITIONALLY and marks it patNeedsGuard — the actual comparison must happen here,
-- in the guarded-arm re-match.  Peer of llvm_emit's `emitRefutMatch (PRng ...)`.
-- One signed i64 test serves both Int and Char (Char = its codepoint, cf. the PLit
-- LChar arm above); rngCmpW unboxes via $mdk_unbox_int so NEGATIVE bounds (`-1..1`) and
-- Int bounds >= 2^30 are both correct.  Fail-fast, mirroring eval.mdk's inIntRange/inCharRange:
-- `v < lo` fails; then `v > hi` (incl) / `v >= hi` (exclusive `..`) fails.
patTestBind prog (PRng lo hi incl) occ clLabel env = (
  rngCmpW prog occ (rngBound lo) "i64.lt_s" clLabel
    ++ rngCmpW
      prog
      occ
      (rngBound hi)
      (if incl then "i64.gt_s" else "i64.ge_s")
      clLabel,
  [],
  env,
)
patTestBind prog other occ clLabel env =
  gapL3P prog ("ref-mode: unsupported clause parameter pattern " ++ ptag other)

-- one half of a range test: unbox `occ` to i64 and `br_if clLabel` when `cmp` against
-- `bound` holds (i.e. when the value is OUT of range).  `occ` is re-embedded per half —
-- patTestBind's contract already requires it be a cheap re-runnable read.  #759: the
-- $mdk_unbox_int seam (i31 OR $boxint) at full i64 width so an Int bound >= 2^30 neither
-- overflows `i32.const` nor traps a boxed scrutinee's i31 cast; a Char is a small i31
-- codepoint, which $mdk_unbox_int sign-extends exactly as `i31.get_s` did.  `cmp` is the
-- i64 comparator (`i64.lt_s`/`i64.gt_s`/`i64.ge_s`).
rngCmpW : Prog -> List String -> Int -> String -> String -> List String
rngCmpW prog occ bound cmp clLabel =
  occ
    ++ [
      unboxIntW prog,
      "i64.const " ++ intToString bound,
      cmp,
      "br_if " ++ clLabel,
    ]

-- (tests, binds, env') for a refutable fixed-length list clause head against `occ`.
-- Each element requires its cell be a Cons; the spine end requires Nil.
patTestBindList : Prog ->
  List Pat ->
  List String ->
  String ->
  Env ->
  (List String, List String, Env)
patTestBindList _ [] occ clLabel env = (
  discrimReadOf occ "List" ++ ["i32.const 1", "i32.ne", "br_if " ++ clLabel],
  [],
  env,
)
patTestBindList prog (p :: ps) occ clLabel env =
  let consTest =
    discrimReadOf occ "List" ++ ["i32.const 0", "i32.ne", "br_if " ++ clLabel]
  let hSnip = occ ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 1"]
  let tSnip = occ ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 2"]
  let (ht, hb, env2) = patTestBind prog p hSnip clLabel env
  let (tt, tb, env3) = patTestBindList prog ps tSnip clLabel env2
  (consTest ++ ht ++ tt, hb ++ tb, env3)

-- (tests, binds, env') for a tuple clause head: each field i+1 of $C_Tup<n> (after
-- the i32 tag), recursing into the sub-pattern (which may itself be refutable).
patTestBindTuple : Prog ->
  String ->
  List Pat ->
  List String ->
  String ->
  Env ->
  Int ->
  (List String, List String, Env)
patTestBindTuple _ _ [] _ _ env _ = ([], [], env)
patTestBindTuple prog tc (p :: rest) occ clLabel env i =
  let fieldSnip =
    occ
      ++ [
        "ref.cast (ref $" ++ ctorStructName tc ++ ")",
        "struct.get $\{ctorStructName tc} \{intToString (i + 1)}",
      ]
  let (ft, fb, env2) = patTestBind prog p fieldSnip clLabel env
  let (rt, rb, env3) = patTestBindTuple prog tc rest occ clLabel env2 (i + 1)
  (ft ++ rt, fb ++ rb, env3)

-- (tests, binds, env') for a constructor clause head's fields: field i+1 of the ctor's
-- struct (after the i32 tag), recursing into each sub-pattern with patTestBind so a
-- refutable nested ctor (`ConNamed fs`) emits its own discriminant test+bind.
patTestBindCon : Prog ->
  String ->
  List Pat ->
  List String ->
  String ->
  Env ->
  Int ->
  (List String, List String, Env)
patTestBindCon _ _ [] _ _ env _ = ([], [], env)
patTestBindCon prog c (p :: rest) occ clLabel env i =
  let fieldSnip =
    occ
      ++ [
        "ref.cast (ref $" ++ ctorStructName c ++ ")",
        "struct.get $\{ctorStructName c} \{intToString (i + 1)}",
      ]
  let (ft, fb, env2) = patTestBind prog p fieldSnip clLabel env
  let (rt, rb, env3) = patTestBindCon prog c rest occ clLabel env2 (i + 1)
  (ft ++ rt, fb ++ rb, env3)

-- all locals a clause group needs: every clause's param-bound vars + body locals.
clauseLocals : List CClause -> List String
clauseLocals clauses = flatMap oneClauseLocals clauses

oneClauseLocals : CClause -> List String
oneClauseLocals (CClause pats body) =
  flatMap patVars pats ++ collectExprLocals body

clausesMaxDepth : List CClause -> Int
clausesMaxDepth clauses = foldMaxDepth (flatMap clauseBody clauses)

-- whether a top-level fn needs its closure wrapper. The pre-emission program-index
-- build scans value positions once and stores the immutable membership set in this
-- Prog's invocation-private index; lookup is O(log n) with no ambient authority.
-- Never in raw mode: a raw program declares no closure types, and the demand
-- planner routes every genuine value use of a function to ref mode.  The scan
-- behind the index does not see match-arm binders, so in raw mode a hit can only
-- be such a local shadowing the function's name, whose wrapper would reference
-- the undeclared `$codety`.
needsClosWrapper : Prog -> String -> Bool
needsClosWrapper prog name =
  not (rawProgramW prog)
    && omHasKey name (indexFnsUsedAsValuesW (progIndex prog))

-- the closure wrapper for a top-level fn: `$mdk_w_<name>` is a $codety that unpacks
-- the args array and calls $name; `$name__clos` is built by `mkFnClos` at each value
-- ref.  Here we emit only the wrapper CODE function; the $clos struct is built inline
-- at the value-reference site (emitVarRef) so partial application threads its arity.
emitFnClosWrapper : Prog -> String -> Int -> List String
emitFnClosWrapper prog name arity =
  let wrapper = "$mdk_w_" ++ name
  let _ = noteFuncRef prog wrapper
  let _ = defineFnW prog wrapper codeShapeW
  closWrapperLines wrapper (callFnW prog CallTailW (gname name) arity) arity

-- A `$codety` function [wrapper] that loads [arity] arguments out of its argument
-- array and makes the tail call [call] on them.
closWrapperLines : String -> String -> Int -> List String
closWrapperLines wrapper call arity =
  let argLoads =
    flatMap
      (i => [
        "local.get $args",
        "i32.const " ++ intToString i,
        "array.get $argarr",
        "ref.as_non_null",
      ])
      (rangeList 0 arity)
  [
      "  (func "
        ++ wrapper
        ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
    ]
    ++ indent (argLoads ++ [call])
    ++ ["  )"]

paramDeclRef : String -> String
paramDeclRef p = " (param $" ++ gname p ++ " (ref eq))"

localDeclRef : String -> String
localDeclRef l = "(local $" ++ gname l ++ " (ref eq))"

-- ── §W5 typeclass dispatch (dict-passing) ────────────────────────────────────
-- Parallels the LLVM emitter (emitMethod/emitDictApp/dictWordsOf + emitImpls).
-- STAGE2-DESIGN §2.4c policy: dispatch is RUNTIME DICT-PASSING.  The Core IR
-- carries the resolved Routes as DATA on CMethod/CDict; this section reads them.
--
-- DICT-WITNESS REPRESENTATION (the WasmGC analogue of the LLVM i64 "dict word").
-- Every value here is a (ref eq).  A dict witness is an i31 immediate carrying
-- `hashName(impl-head-tag)` — the SAME djb2 hash the LLVM emitter stores at field
-- 0 of its dict cell.  Threading it as a (ref eq) i31 rides the uniform W4 ABI for
-- free: a constrained fn's leading `$dict_*` params are ordinary (ref eq) params,
-- and at a dispatch site the witness is unboxed (`i31.get_s`) back to the i32 tag
-- word.  For minimal Eq/Ord/Num at Int/Bool/ADT the per-instance `requires` dicts
-- are empty, so a one-level witness is just `i32.const <hashName tag>; ref.i31`
-- (no heap cell needed — the LLVM emitter's nested-cell layout is W5-out-of-scope).
--
--   RKey tag   → a STATIC direct call to $mdk_impl_<tag>_<method> (llvm_emit line
--                2846: an RKey is a compile-time direct call).
--   RDict d    → the in-scope dict param $d carries hashName(tag); unbox it and
--   RDictFwd d   if-chain over the method's candidate impls (i32.eq against each
--                impl's hashName(routeKey)) → call the matching impl.  Sparse hash
--                keys ⇒ an if-chain, NOT a br_table (which is for dense ctor tags).
--   RNone      → arg-tag fallback (gap this slice; no minimal fixture needs it).

-- the method occurrence (return-/arg-position), applied to `args`.  `implRoutes`
-- (per-instance requires) + `methRoutes` (method-level constraints) are the leading
-- dict witnesses, prepended to the args (in methRoutes++implRoutes order, matching
-- llvm_emit's dictWordsOf (methRoutes ++ implRoutes)).
emitMethodRef : Prog ->
  Env ->
  Int ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  List CExpr ->
  CallMode ->
  CallEndW ->
  List String
-- An RKey route is a STATIC direct call, legal only when the application is exact:
-- the selected entry's define takes exactly the supplied value arguments after its
-- dicts.  Any other application builds the method's value closure (whose own body is
-- that exact call) and applies every argument through $__mdk_apply, whose
-- under-application arm makes the residual PAP and whose over-application arm applies
-- the surplus to the call's result -- after every argument is evaluated.  A dynamic
-- mode names no selected entry's arity, and keeps the direct call.
emitMethodRef prog env d name iface siteArity (route@(RKey tag _ _)) implRoutes methRoutes args mode end =
  if missesArity mode then
    emitMethodValueRef
        prog
        env
        d
        name
        iface
        siteArity
        route
        implRoutes
        methRoutes
      ++ emitArgsArray prog env d args
      ++ [callFnW prog end "__mdk_apply" 2]
  else
    emitMethodRKeyCallRef
      prog
      env
      d
      name
      iface
      siteArity
      route
      implRoutes
      methRoutes
      args
      end
-- A runtime dictionary selects the entry, so the site cannot know its arity: every
-- argument goes to the dispatch, whose arms each apply them to their own entry.
emitMethodRef prog env d name iface siteArity (RDict dpar) _ methRoutes args _ end =
  emitMethodDispatchRef prog env d name iface siteArity dpar methRoutes args end
emitMethodRef prog env d name iface siteArity (RDictFwd dpar) _ methRoutes args _ end =
  emitMethodDispatchRef prog env d name iface siteArity dpar methRoutes args end
-- A projected super dictionary is read into its own local (`projLocalName`,
-- declared by `collectExprLocals`) and dispatched on exactly as a dict parameter.
emitMethodRef prog env d name iface siteArity (route@(RProj r path)) _ methRoutes args _ end =
  let local = projLocalName r path
  routeWitness prog env d route
    ++ ["local.set $" ++ gname local]
    ++ emitMethodDispatchRef
      prog
      (envBindUnstamped local env)
      d
      name
      iface
      siteArity
      local
      methRoutes
      args
      end
emitMethodRef prog env d name _ _ RNone implRoutes methRoutes args _ end =
  gapLP
      prog
      ("wasm W5: RNone arg-tag dispatch for '" ++ name ++ "' is out of slice")
    ++ endValueW end
-- P0-18 (wasm peer of llvm_emit's emitMethod RLocal arm): NOT a method dispatch —
-- the receiver has no impl of this interface but a local/imported standalone shadows
-- the method name.  Emit a DIRECT call to that standalone top-level fn, exactly as a
-- known-fn CApp would.  `target` is the carried MANGLED symbol `<mid>__name` when
-- non-empty (the marked EMethodAt carries the bare dispatch name), else the bare name.
-- S-1 (wasm peer of llvm_emit's emitMethod RLocal emitDictApp delegation): a
-- CONSTRAINED shadowing standalone has leading dict PARAMS, so the call must push the
-- matching dict witnesses first.  Delegate to emitDictRef — the SAME tested helper the
-- ordinary CDict path uses.  Without this the raw `call` below pushes one operand too
-- few and wasm-tools rejects the module outright ("type mismatch: expected (ref eq) but
-- nothing on stack" — that "nothing" IS the missing dict word).  `dicts == []` keeps the
-- byte-identical pre-S1 direct call.
-- P1: the direct `call` below is only legal when the application is exact, as at
-- emitAppRef's CVar arm.  `inc = add 1` is the shape: `add` shadows the prelude
-- `Num.add` method name, so the marker rewrites it to `CMethod "add" (RLocal
-- "<mid>__add")` and it arrives HERE rather than at the CVar arm.  A non-exact call
-- goes through emitIndirectApp: it builds the fn's closure and applies via
-- $__mdk_apply, whose under-app arm makes the residual PAP.
emitMethodRef prog env d name _ _ (RLocal sym dicts) implRoutes methRoutes args mode end =
  let target = if sym == "" then name else sym
  if isEmpty dicts then
    if progFnMemberW prog target && not (isExactCall mode) then
      emitIndirectApp prog env d (CVar target AGlobal) args end
    else
      let argInstrs = flatMap (a => emitRefExpr prog env d a) args
      argInstrs ++ [callFnW prog end (gname target) (listLen args)]
  else
    emitDictRef prog env d target dicts args mode end
emitMethodRef prog env d name _ _ (RScalar _) implRoutes methRoutes args _ end =
  gapLP
      prog
      ("wasm W5: RScalar route for method '" ++ name ++ "' is out of slice")
    ++ endValueW end

-- a partial or an over application: its arguments do not fill a known arity
missesArity : CallMode -> Bool
missesArity (CallPartial _) = True
missesArity (CallOver _) = True
missesArity _ = False

-- the RKey direct call itself, for a site supplying exactly the value arity.
emitMethodRKeyCallRef : Prog ->
  Env ->
  Int ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  List CExpr ->
  CallEndW ->
  List String
emitMethodRKeyCallRef prog env d name iface siteArity route implRoutes methRoutes args end =
  let tag = optionOr "" (instanceWord route)
  let argInstrs = flatMap (a => emitRefExpr prog env d a) args
  -- `RKey tag` selects a STATIC impl (peer of llvm_emit's emitMethod RKey arm): the
  -- entry of the occurrence's interface filed under the instance key [tag] — a
  -- supplied method, or an inherited default's per-instance body — else a gap.
  match implForWSite prog name iface tag siteArity
    -- P3 (dropped-requires-dict over-forwarding, #717): a TERMINAL impl body that IGNORES
    -- its `requires` dict (`impl S (List a) requires S a where s _ = 2`) has that dict
    -- DROPPED from the define by the dict-pass (usesImplDict false) — so `$mdk_impl_<tag>_
    -- <name>` declares FEWER leading dict params than the call-site route forwards.  A flat
    -- `dictWords ++ argInstrs ++ call` then pushes a surplus dict witness the callee never
    -- pops ("values remaining on stack at end of block").  Native gets away with it (LLVM
    -- cdecl silently ignores extra args); wasm's strict types do not.  Forward only the
    -- leading dicts the concrete define actually declares — a PREFIX of `methRoutes ++
    -- implRoutes` (method-level dicts, then kept `requires` dicts), so a define that kept
    -- all its dicts is byte-identical.
    Some entry =>
      let kept =
        staticEntryDictRoutesW
          entry
          (MethodEvidence iface siteArity route implRoutes methRoutes)
      let keptWords = flatMap (routeWitness prog env d) kept
      keptWords
        ++ argInstrs
        ++ [
          callFnW
            prog
            end
            (implEntrySymW name entry)
            (listLen kept + listLen args),
        ]
    None =>
      gapLP
          prog
          "wasm layer-15: no impl of method '\{name}' for instance '\{tag}'"
        ++ endValueW end

-- The leading dictionaries a static call to [ent] passes after its method-level
-- ones (llvm_emit's `staticEntryDictRoutes`): a supplied method's kept `requires`,
-- or an inherited default's RECEIVER, the selected instance's dictionary built from
-- the site's word, `requires` routes and the supers the route carries for this case.
staticEntryDictRoutesW : CImplEntry -> MethodEvidence -> List Route
staticEntryDictRoutesW ent ev =
  if isInheritedEntryW ent then
    ev.meContext ++ [receiverEvidence ev]
  else
    takeRoutesW
      (implLeadingDictCountOfEntryW ent)
      (ev.meContext ++ ev.mePrereqs)

-- an inherited default's per-instance entry
isInheritedEntryW : CImplEntry -> Bool
isInheritedEntryW (CImplEntry _ _ _ (CImplDefault _ _ _ _ _ _ _)) = True
isInheritedEntryW _ = False

-- A dispatch site's method-level dictionaries: the instructions that push their
-- witnesses, and how many there are.
data MethodDictsW = MethodDictsW { mdInstrs : List String, mdCount : Int }

-- The dictionaries a dispatch arm loads for its entry after the [nMeth] method-level
-- ones: an inherited default receives the dictionary that selected it; a supplied
-- method its `requires` -- the rest of the entry's own leading `$dict_*` count --
-- which follow the dictionary's super segment (llvm_emit's `emitDispatchArmBody`).
armDictLoadsW : WasmProgramIndex -> CImplEntry -> String -> Int -> List String
armDictLoadsW index ent dpar nMeth =
  if isInheritedEntryW ent then
    ["local.get $" ++ gname dpar]
  else
    let supers = entrySuperCountW index ent
    flatMap
      (loadReqDict dpar)
      (rangeList supers (supers + armDictCountW ent nMeth))

-- how many dictionaries `armDictLoadsW` loads
armDictCountW : CImplEntry -> Int -> Int
armDictCountW ent nMeth =
  if isInheritedEntryW ent then
    1
  else
    maxI 0 (implLeadingDictCountOfEntryW ent - nMeth)

-- RDict/RDictFwd: the dict param `$dpar` is an i31 carrying hashName(tag).  Unbox
-- it, then if-chain over the method's candidate impls comparing the loaded tag
-- against each impl's hashName(routeKey); on a match call $mdk_impl_<symTag>_<m>.
-- For a value the chain runs inside a result block and each arm `br`s out with its
-- value; for a tail call each arm `return_call`s and no block is needed.
emitMethodDispatchRef : Prog ->
  Env ->
  Int ->
  String ->
  String ->
  Int ->
  String ->
  List Route ->
  List CExpr ->
  CallEndW ->
  List String
emitMethodDispatchRef prog env d name iface siteArity dpar methRoutes args end =
  -- the occurrence's interface's candidates (#1265, #1619), and (#1852, LOCKSTEP with
  -- llvm_emit's `narrowImplsByArity`) only those whose own declared arity is the
  -- arity this site supplies.
  let impls = narrowImplsByArityW (methodImpls prog name iface) siteArity
  let argInstrs = flatMap (a => emitRefExpr prog env d a) args
  -- every arm passes the site's method-level dictionaries ahead of its own
  let methInstrs = flatMap (routeWitness prog env d) methRoutes
  -- the dict tag is read repeatedly; stash it in the scratch local for this depth.
  let tagRead = readDictParam prog env dpar
  let blk = "$disp_\{name}_\{intToString d}"
  -- every entry is a guarded arm, a general instance's too: its dictionary carries
  -- its own canonical key
  let chain =
    emitDispatchChain
      prog
      name
      impls
      blk
      tagRead
      dpar
      MethodDictsW { mdInstrs = methInstrs, mdCount = listLen methRoutes }
      argInstrs
      (listLen args)
      end
      0
  match end
    CallValueW =>
      ["block " ++ blk ++ " (result (ref eq))"]
        ++ indent chain
        ++ ["unreachable", "end"]
    CallTailW => chain ++ ["unreachable"]

-- #747: the call instruction(s) a matched dispatch arm emits after its dictionaries
-- and arguments.  A nullary/return-position/dictionary-free impl (nArgs == 0 and a
-- `$memo_<symTag>_<method>` LAZY value global synthesized by core_ir_lower —
-- isLazyGlobalW confirms it exists) is a per-instance CAF: FORCE its shared CAF
-- (`call $force_<memo>`, which memoises into `$<memo>` and black-holes a cyclic
-- re-force) instead of re-calling `$mdk_impl_*`, so the resolved tag's side effect
-- runs once and is shared across every occurrence at that tag (matching eval's
-- per-VTypedImpl memoThunk).  Each tag owns its own `$memo` CAF ⇒ distinct tags
-- memoise independently.  Otherwise the ordinary impl call.
dispatchCallSeqW : Prog -> ImplArmW -> String -> Int -> CallEndW -> List String
dispatchCallSeqW prog arm name nArgs end =
  let memoName = "$memo_\{armSymTagW arm}_\{name}"
  if nArgs == 0 && isLazyGlobalW prog memoName then
    [callFnW prog end ("force_" ++ gname memoName) 0]
  else
    [callFnW prog end (armFnSymW arm) (armDictCountW (armEntryW arm) 0 + nArgs)]

-- F10 (#1450/#1668 follow-on): a dispatch site pushes exactly the arguments THAT
-- SITE saw, and the entry a runtime dictionary selects need not take that many: two
-- interfaces' same-spelled methods at different arity, or an impl clause that takes
-- fewer parameters than its declaration.  An arm whose entry takes exactly the
-- site's arguments calls its define; any other pushes the define as a closure first
-- and applies it to the dictionaries and arguments together through $__mdk_apply, so
-- an under-application builds the residual PAP and an over-application applies the
-- surplus to the define's result -- after every argument is evaluated.
armIsExactW : ImplArmW -> Int -> Bool
armIsExactW arm nArgs =
  let pats = implEntryPatsW (armEntryW arm)
  listLen pats - leadingDictParams pats == nArgs

-- The define of [arm]'s entry as a closure value: a lifted `$codety` wrapper that
-- unpacks its argument array into the define's parameters, at the define's arity.
armClosureW : Prog -> ImplArmW -> List String
armClosureW prog arm =
  let arity = listLen (implEntryPatsW (armEntryW arm))
  let wrapper = "$mdk_lam" ++ intToString (freshLamId (progEmit prog))
  let _ = noteFuncRef prog wrapper
  let _ =
    addLifted
      prog
      wrapper
      codeShapeW
      (closWrapperLines
        wrapper
        (callFnW prog CallTailW (armFnSymW arm) arity)
        arity)
  wConstClos prog wrapper arity

-- one comparison + call per candidate impl group.  loaded tag (i32) == dictTag
-- routeKey?  if so: load this impl's nested requires-dicts from the dict param's
-- $dictcell (W5 — was a placeholder zero) ++ the args, call the impl, `br` out of the
-- result block carrying its (ref eq).  The `if` carries NO result type — the matched
-- branch exits via `br $blk` (which supplies the block's value), the else branch falls
-- through to the next comparison; after the whole chain an `unreachable` (a well-typed
-- dict always names a candidate) satisfies the block's (ref eq) fallthrough requirement.
-- `idt` (trailing) is the chain's own INDENT depth — see emitLitSwitchRef (#381).
emitDispatchChain : Prog ->
  String ->
  List ImplArmW ->
  String ->
  List String ->
  String ->
  MethodDictsW ->
  List String ->
  Int ->
  CallEndW ->
  Int ->
  List String
emitDispatchChain _ _ [] _ _ _ _ _ _ _ _ = []
emitDispatchChain prog name (arm :: rest) blk tagRead dpar meth argInstrs nArgs end idt =
  -- W5: a `requires`-bearing impl (e.g. `Debug (a,b) requires Debug a, Debug b`) compiles
  -- to a fn whose leading params are the forwarded `requires` dicts BEFORE the method args.
  -- The dispatch site holds the dict param ($dpar): when this impl is constrained, the dict
  -- reaching this arm is a $dictcell whose field-1 $dictarr carries those nested req dicts in
  -- order (built by routeWitness).  Load field 0..reqDicts-1 and prepend them as the impl fn's
  -- leading dict args, mirroring llvm_emit's loadReqDicts (fields 1..n of the boxed cell).
  let reqLoads =
    armDictLoadsW (progIndex prog) (armEntryW arm) dpar meth.mdCount
  let pushed = meth.mdInstrs ++ reqLoads ++ argInstrs
  let armBody =
    if not (armIsExactW arm nArgs) then
      armClosureW prog arm
        ++ pushed
        ++ [
          "array.new_fixed $argarr "
            ++ intToString
              (meth.mdCount
                + armDictCountW (armEntryW arm) meth.mdCount
                + nArgs),
          callFnW prog end "__mdk_apply" 2,
        ]
    else if meth.mdCount > 0 then
      pushed
        ++ [
          callFnW
            prog
            end
            (armFnSymW arm)
            (meth.mdCount + armDictCountW (armEntryW arm) meth.mdCount + nArgs),
        ]
    else
      pushed ++ dispatchCallSeqW prog arm name nArgs end
  let armExit = match end
    CallValueW => ["br " ++ blk]
    CallTailW => []
  indentBy idt (dispatchKeyTestW arm tagRead ++ ["if"])
    ++ indentBy (idt + 1) (armBody ++ armExit)
    ++ indentBy idt ["else"]
    ++ emitDispatchChain
      prog
      name
      rest
      blk
      tagRead
      dpar
      meth
      argInstrs
      nArgs
      end
      (idt + 1)
    ++ indentBy idt ["end"]

-- The test that selects one implementation: the dictionary's word against the arm's
-- canonical key.  A word names exactly one instance, the same one in every module.
dispatchKeyTestW : ImplArmW -> List String -> List String
dispatchKeyTestW arm tagRead =
  tagRead ++ ["i32.const " ++ intToString (dictTag (armKeyW arm)), "i32.eq"]

-- load nested req dict `i` from the dict param $dpar's $dictcell (field 1 = $dictarr).
-- Only reached for a constrained impl arm, where the in-scope dict IS a $dictcell.
-- load nested req dict `i` for a matched impl arm.  The witness ($dpar) is EITHER a
-- one-level i31 (no nested reqs — the typed-entry case where the iface table is absent
-- so the req COUNT is over-counted, or any concrete-element dict) OR a $dictcell (a real
-- nested dict carrying its element witnesses in field-1's $dictarr).  Runtime-test the
-- shape: i31 ⇒ a placeholder i31(0) (mirrors the pre-W5 stub — harmless, the impl never
-- recurses into a real element dict in that case); $dictcell ⇒ load field-1 array[i] (the
-- genuine nested element witness).  Both arms leave one (ref eq) → the arg count is static.
loadReqDict : String -> Int -> List String
loadReqDict dpar i =
  ["local.get $" ++ gname dpar, "ref.test (ref i31)", "if (result (ref eq))"]
    ++ indent ["i32.const 0", "ref.i31"]
    ++ ["else"]
    ++ indent [
      "local.get $" ++ gname dpar,
      "ref.cast (ref $dictcell)",
      "struct.get $dictcell 1",
      "i32.const " ++ intToString i,
      "array.get $dictarr",
      "ref.as_non_null",
    ]
    ++ ["end"]

-- the super dictionaries a dictionary of [ent]'s interface stores ahead of its
-- `requires` dictionaries (llvm_emit's `entrySuperCount`)
entrySuperCountW : WasmProgramIndex -> CImplEntry -> Int
entrySuperCountW index ent =
  optionOr 0 (omLookup (implEntryIfaceWordW ent) index.fnImpl.superCounts)

-- the local a projected super dictionary is dispatched through
projLocalName : Route -> List Int -> String
projLocalName (RDict d) path = "\{d}$p\{projPathWord path}"
projLocalName (RDictFwd d) path = "\{d}$p\{projPathWord path}"
projLocalName (RProj r p) path = projLocalName r (p ++ path)
projLocalName _ path = "$proj$p\{projPathWord path}"

projPathWord : List Int -> String
projPathWord path = joinWith "_" (map intToString path)

implLeadingDictCountOfEntryW : CImplEntry -> Int
implLeadingDictCountOfEntryW ent = leadingDictParams (implEntryPatsW ent)

-- `take n` for a route list (no stdlib `take` in scope here).
takeRoutesW : Int -> List Route -> List Route
takeRoutesW n _
  | n <= 0 = []
takeRoutesW _ [] = []
takeRoutesW n (r :: rest) = r :: takeRoutesW (n - 1) rest

-- read a dict PARAM's HEAD TAG (an i32) into the stack.  The witness is EITHER an i31
-- (a one-level `RKey k []` dict — tag = i31.get_s) OR a $dictcell (a nested `RKey k [reqs]`
-- dict — tag = struct.get 0).  Type-test once and read the tag from the matching shape;
-- both arms leave one i32 on the stack.  The param is a leading $dict_* local, always in env.
readDictParam : Prog -> Env -> String -> List String
readDictParam prog env dpar =
  if envHas dpar env then
    ["local.get $" ++ gname dpar, "ref.test (ref i31)", "if (result i32)"]
      ++ indent ["local.get $" ++ gname dpar, "ref.cast (ref i31)", "i31.get_s"]
      ++ ["else"]
      ++ indent [
        "local.get $" ++ gname dpar,
        "ref.cast (ref $dictcell)",
        "struct.get $dictcell 0",
      ]
      ++ ["end"]
  else
    gapLP prog ("wasm W5: dict param '" ++ dpar ++ "' not in scope")

-- materialize a Route as its leading dict witness instruction(s): a concrete RKey →
-- the i31 of hashName(tag); a forwarded RDict/RDictFwd → re-push the in-scope dict
-- param.  Nested `requires` (RKey with non-empty reqs) are out of the minimal slice.
routeWitness : Prog -> Env -> Int -> Route -> List String
routeWitness _ _ _ (RKey tag [] []) =
  ["i32.const " ++ intToString (dictTag tag), "ref.i31"]
-- W5 (nested requires-dict): build a $dictcell — push the tag, recursively build each
-- nested req witness onto the stack, pack them into a $dictarr (array.new_fixed), then
-- struct.new $dictcell.  Mirrors llvm_emit's emitDictCell (header + recursively-built
-- req fields); the recursion is dictWordsOf == flatMap routeWitness over reqs.
-- The array holds the dictionary's direct supers first, then its requires (the
-- LLVM cell's order), so a projection indexes the same slot whichever instance the
-- dictionary is.
routeWitness prog env d (RKey tag reqs sups) =
  let fieldWitnesses = flatMap (routeWitness prog env d) (sups ++ reqs)
  ["i32.const " ++ intToString (dictTag tag)]
    ++ fieldWitnesses
    ++ [
      "array.new_fixed $dictarr " ++ intToString (listLen sups + listLen reqs),
      "struct.new $dictcell",
    ]
-- a super projected out of a dictionary: a dictionary with supers is always a cell
routeWitness prog env d (RProj r path) =
  routeWitness prog env d r ++ flatMap superFieldW path
routeWitness prog env _ (RDict dpar) =
  if envHas dpar env then
    ["local.get $" ++ gname dpar]
  else
    gapLP prog ("wasm W5: forwarded dict '" ++ dpar ++ "' not in scope")
routeWitness prog env _ (RDictFwd dpar) =
  if envHas dpar env then
    ["local.get $" ++ gname dpar]
  else
    gapLP prog ("wasm W5: forwarded dict '" ++ dpar ++ "' not in scope")
-- RNone as a witness is the dictionary for an unconstrained type variable under a
-- `requires` (the element of `None : Option a`, the error of `Ok 1 : Result e Int`).
-- There is no value of that type for a method to take, so no value-position
-- dispatch goes through it: the constructor-only and Display/Eq/Ord shapes never
-- call it.  It is the no-op i31 (dict tag 0), mirroring llvm_emit's
-- `dictWordOfRoute _ _ RNone = "0"`.
routeWitness _ _ _ RNone = ["i32.const 0", "ref.i31"]
-- S-1: RLocal's own dicts are the call's leading dict ARGS (pushed by emitMethodRef's
-- RLocal arm via emitDictRef), not a dict WITNESS for this route — so as a witness it
-- stays the no-op i31 (dict tag 0), mirroring llvm_emit's
-- `dictWordOfRoute (RLocal _ _) = "0"`.  RScalar (scalar-tag) likewise.
routeWitness _ _ _ (RLocal _ _) = ["i32.const 0", "ref.i31"]
routeWitness _ _ _ (RScalar _) = ["i32.const 0", "ref.i31"]

superFieldW : Int -> List String
superFieldW i = [
  "ref.cast (ref $dictcell)",
  "struct.get $dictcell 1",
  "i32.const " ++ intToString i,
  "array.get $dictarr",
  "ref.as_non_null",
]

-- a constrained-function occurrence applied to `args`: prepend the materialized
-- dict witnesses (one per `=>` constraint, in route order) to the args, then call
-- the lifted $name (whose leading params are the $dict_* the dict-pass injected).
emitDictRef : Prog ->
  Env ->
  Int ->
  String ->
  List Route ->
  List CExpr ->
  CallMode ->
  CallEndW ->
  List String
emitDictRef prog env d name routes args mode end =
  if envHas name env then
    emitLocalDictRef prog env d name routes args end
  else if progFnMemberW prog name then
    -- P2 (over/under-application, #729): the direct `call` is only legal when the
    -- application is exact.  A point-free dict-passed fn keeps a TRAILING CLam, so its
    -- define value-arity is SHORT of the args a saturating call supplies: `clamp lo hi
    -- = min hi >> max lo` compiles to a 3-param define (dict, lo, hi) RETURNING a
    -- closure, yet `clamp 0 10 15` supplies three value args.  Mirror emitAppRef's CVar
    -- gate: any other application materializes the CDict as a closure VALUE and
    -- applies every arg through $__mdk_apply (whose over-application arm chains into
    -- the returned closure).
    if isExactCall mode then
      let dictWords = flatMap (routeWitness prog env d) routes
      let argInstrs = flatMap (a => emitRefExpr prog env d a) args
      dictWords
        ++ argInstrs
        ++ [callFnW prog end (gname name) (listLen routes + listLen args)]
    else
      emitIndirectApp prog env d (CDict name routes) args end
  else
    gapLP prog ("wasm W5: CDict over unknown function '" ++ name ++ "'")
      ++ endValueW end

-- A dictionary-abstracted LOCAL binding is a closure whose leading parameters are
-- its dictionaries: apply it to the dict witnesses, then the arguments.
emitLocalDictRef : Prog ->
  Env ->
  Int ->
  String ->
  List Route ->
  List CExpr ->
  CallEndW ->
  List String
emitLocalDictRef prog env d name routes args end =
  let dictWords = flatMap (routeWitness prog env d) routes
  let argInstrs = flatMap (a => emitRefExpr prog env d a) args
  emitVarRef prog env d name
    ++ dictWords
    ++ argInstrs
    ++ [
      "array.new_fixed $argarr " ++ intToString (listLen routes + listLen args),
      callFnW prog end "__mdk_apply" 2,
    ]

-- ── EMITTER-GAPS E23 (wasm peer): CMethod / CDict in VALUE position ───────────
-- A typeclass METHOD (`map negate xs`, `filter isEv xs`) or a `=>`-constrained NAMED
-- function (`filter myParity xs`) passed UNAPPLIED to a higher-order combinator lowers
-- to a bare CMethod/CDict in OPERAND position.  The emitRefExpr arms previously routed
-- these to emitMethodRef/emitDictRef with `[]` args → a TRUNCATED saturated dispatch
-- (`call $mdk_impl_*` / `call $fn`) carrying ONLY the dict words, no value args and no
-- closure capture → wasm stack underflow at validate (`not enough arguments on the
-- stack for call`).  (This is the wasm peer of the LLVM emitDictValue/emitMethodValue
-- fix — EMITTER-GAPS E23; distinct from #18/E18, the shadowed-local case that stays a
-- plain EVar.)
--
-- FIX: ETA-EXPAND the occurrence to a synthetic lambda `\a0..a(k-1) -> head a0..a(k-1)`
-- and lower it through emitClosure — the universal W4 closure path.  emitClosure (a)
-- captures the route's forwarded dict params (freeVarsExpr surfaces every given the
-- evidence names, `core_ir.givenNames`) into the closure $env, and (b) re-emits the SATURATED dispatch in the
-- lifted body via the CALL-position emitMethodRef/emitDictRef (correct: dicts ++ args ++
-- call).  The result is a `$clos` struct (code_ptr, arity, $env captures) with the exact
-- ABI W4 HOFs expect — the working lambda path IS the reference.

-- CMethod value: arity k = the method's declared USER arity; a nullary method (k <= 0)
-- is a plain value — keep the immediate saturated dispatch.
emitMethodValueRef : Prog ->
  Env ->
  Int ->
  String ->
  String ->
  Int ->
  Route ->
  List Route ->
  List Route ->
  List String
emitMethodValueRef prog env d name iface siteArity route implRoutes methRoutes =
  let node =
    CMethod name (MethodEvidence iface siteArity route implRoutes methRoutes)
  let arity = methodValueArityW prog node
  if arity <= 0 then
    emitMethodRef
      prog
      env
      d
      name
      iface
      siteArity
      route
      implRoutes
      methRoutes
      []
      (callModeFor (definedArityW prog node) 0)
      CallValueW
  else
    let names = etaValNames arity
    let ps = map (n => PVar n (Loc "" 0 0 0 0) noBinderId) names
    let body = stampedAppW prog node (map (n => CVar n AGlobal) names)
    emitClosure prog env d ps body

-- the method's USER arity for an eta-value closure: the occurrence's defined arity
-- (#410: an RLocal route forwards to a STANDALONE, so the closure exposes that
-- standalone's value arity, less the dictionaries the route supplies; an RKey route
-- the selected entry's parameters).  A route with no static arity (a runtime
-- dictionary) exposes the occurrence's declared arity.
methodValueArityW : Prog -> CExpr -> Int
methodValueArityW prog (node@(CMethod _ (MethodEvidence _ siteArity _ _ _))) =
  match definedArityW prog node
    Some n => maxI 0 n
    None => siteArity
methodValueArityW _ _ = 0

-- CDict value: value arity v = the define's parameters − route count.  A nullary
-- value arity (the constrained fn takes no value args) degenerates to the saturated
-- dict call.
emitDictValueRef : Prog -> Env -> Int -> String -> List Route -> List String
emitDictValueRef prog env d name routes =
  if envHas name env then
    emitLocalDictRef prog env d name routes [] CallValueW
  else if progFnMemberW prog name then
    let valArity = optionOr 0 (definedArityW prog (CDict name routes))
    if valArity <= 0 then
      emitDictRef prog env d name routes [] CallExact CallValueW
    else
      let names = etaValNames valArity
      let ps = map (n => PVar n (Loc "" 0 0 0 0) noBinderId) names
      let body =
        stampedAppW prog (CDict name routes) (map (n => CVar n AGlobal) names)
      emitClosure prog env d ps body
  else
    gapLP prog ("wasm E23: CDict value over unknown function '" ++ name ++ "'")

-- fresh eta param names `$hov0..$hov(n-1)` (`$`-prefixed, so no source name can
-- collide); each lambda owns its own param scope so fixed names never collide.
etaValNames : Int -> List String
etaValNames n = map (i => "$hov" ++ intToString i) (rangeList 0 n)

-- [hd] applied to [args], stamped with the mode `core_ir_lower.stampCallModes` would
-- give it: the application an eta-value closure's body makes.  It is that body's
-- tail call, so it is flagged as one unless it is a partial application.
stampedAppW : Prog -> CExpr -> List CExpr -> CExpr
stampedAppW prog hd args =
  let mode = callModeFor (definedArityW prog hd) (listLen args)
  CApp hd args (CallSite mode (not (isPartialMode mode)))

-- the stamped symbol tag of an entry of either kind
implEntrySymTagW : CImplEntry -> String
implEntrySymTagW (CImplEntry _ _ _ (CImplTagged _ _ _ (ImplSym tag _ _) _ _ _)) =
  tag
implEntrySymTagW (CImplEntry _ _ _ (CImplDefault _ _ _ (ImplSym tag _ _) _ _ _)) =
  tag

-- The function symbol of one exact entry, composed from its stamp
-- (`core_ir_lower.stampImplSymbols`): a supplied method's `mdk_impl_<symTag>_<method>`,
-- or an inherited default's per-instance `mdk_default_<iface>_<method>_<key>`.
implEntrySymW : String -> CImplEntry -> String
implEntrySymW method (CImplEntry _ _ _ (CImplTagged _ _ _ (ImplSym tag _ _) _ _ _)) =
  implFnSymOfTag tag method
implEntrySymW method (CImplEntry _ _ _ (CImplDefault _ _ _ (ImplSym _ ifaceTag keyTag) _ _ _)) =
  "mdk_default_\{ifaceTag}_\{gname method}_\{keyTag}"

-- build the symbol from an entry's stamped symbol tag
implFnSymOfTag : String -> String -> String
implFnSymOfTag symTag method = "mdk_impl_\{symTag}_\{gname method}"

-- the head tycon of the impl whose canonical key is [key] (mirror of llvm_emit's
-- headTagForKey) — the group's dispatch/self/Float tag, distinct from its symbol tag.
headTagForKeyW : String -> String -> List CImplEntry -> String
headTagForKeyW method key entries = match firstEntryForKeyW method key entries
  Some ent => implEntryTagW ent
  None => ""

firstEntryForKeyW : String -> String -> List CImplEntry -> Option CImplEntry
firstEntryForKeyW _ _ [] = None
firstEntryForKeyW method key (ent :: rest)
  | implEntryMethodW ent == method && implEntryKeyW ent == key = Some ent
  | otherwise = firstEntryForKeyW method key rest

-- ── §W5 impl-function emission ───────────────────────────────────────────────
-- Coalesce the CImplEntry list (one entry per clause) by (method, symTag) into
-- per-impl clause groups, then emit each as a wasm function $mdk_impl_<tag>_<m>
-- via the SAME clause machinery top-level fns use (emitClausesRef).  Multi-clause
-- impls (`eq Red Red = …; eq _ _ = …`) coalesce into a fall-through chain.
emitImplFns : Prog -> List String
emitImplFns prog =
  flatMap (emitImplGroup prog) (implGroups prog (progImpls prog))

-- (method, tag, arity, clauses) per distinct impl key, in first-seen order.
-- (method, headTag, key, arity, clauses) per distinct canonical impl key.  #324:
-- headTag drives dispatch/self-recursion/Float-param decisions (mirror of llvm_emit's
-- ImplGroup `tag`), while [key] drives the SYMBOL (via the stamp) and clause selection
-- (mirror of `symTag`/`key`).  For a sole impl per head the two coincide in effect
-- (a sole impl's symbol tag is its head tag), so existing output is byte-identical.
data ImplG = ImplG String String String Int (List CClause) String

implGroups : Prog -> List CImplEntry -> List ImplG
implGroups prog entries =
  mapGatherGroups prog entries (distinctImplKeys entries)

-- map gatherImplGroup (an effectful fn — it reads the iface-arity table) over the keys.
mapGatherGroups : Prog -> List CImplEntry -> List (String, String) -> List ImplG
mapGatherGroups _ _ [] = []
mapGatherGroups prog entries (k :: rest) =
  let g = gatherImplGroup prog entries k
  g :: mapGatherGroups prog entries rest

-- the (method, canonical-key) groups present, first-seen order.  #324: key on the
-- CANONICAL KEY (field 2), not the head tycon — so two overlapping same-head impls
-- (`Default (Box a)` / `Default (Box Int)`, both head `Box`) form DISTINCT groups
-- and get distinct $mdk_impl_* functions, instead of collapsing into one.  For a sole
-- impl per head the key↔head map is 1:1, so the group set (and its emit order) is
-- unchanged from the old head-keyed form.
distinctImplKeys : List CImplEntry -> List (String, String)
distinctImplKeys entries = dedupPairs (flatMap implKeyOf entries) []

implKeyOf : CImplEntry -> List (String, String)
implKeyOf ent = [(implEntryMethodW ent, implEntryKeyW ent)]

-- dedup a (method, tag) key list, first-seen order (dedupKeep is String-only).  perf
-- #382: the old `containsPair p acc` was O(kept) per element ⇒ O(k²) — quadratic in
-- distinct impl keys, run once per program by `distinctImplKeys` and once per RDict site
-- by `methodImpls`.  An OrdMap seen-set makes membership O(log k); `acc` still carries
-- the reversed first-seen order (identical output), and `seen` is seeded from the initial
-- `acc` so the 2-arg contract is preserved for any caller.  `pairKey` joins on a SPACE:
-- the method (field 1) is always a bare identifier — space-free — so `m ++ " " ++ tag` is
-- injective (the first space delimits method from tag), i.e. two distinct pairs never
-- collide on a key.
dedupPairs : List (String, String) ->
  List (String, String) ->
  List (String, String)
dedupPairs pairs acc = dedupPairsGo pairs (seedPairSeen acc omEmpty) acc

pairKey : (String, String) -> String
pairKey (a, b) = "\{a} \{b}"

seedPairSeen : List (String, String) -> OrdMap Unit -> OrdMap Unit
seedPairSeen [] m = m
seedPairSeen (p :: rest) m = seedPairSeen rest (omInsert (pairKey p) () m)

dedupPairsGo : List (String, String) ->
  OrdMap Unit ->
  List (String, String) ->
  List (String, String)
dedupPairsGo [] _ acc = reverseL acc
dedupPairsGo (p :: rest) seen acc =
  let k = pairKey p
  if omHasKey k seen then
    dedupPairsGo rest seen acc
  else
    dedupPairsGo rest (omInsert k () seen) (p :: acc)

gatherImplGroup : Prog -> List CImplEntry -> (String, String) -> ImplG
gatherImplGroup prog entries (m, key) =
  let mEntries = methodEntriesW prog m
  let headTag = headTagForKeyW m key mEntries
  let clauses = flatMap (implClauseFor m key) mEntries
  -- the define takes exactly its clauses' parameters: a call site's mode was read
  -- against that same count, so nothing here may lengthen a clause
  let fnName = match firstEntryForKeyW m key mEntries
    Some ent => implEntrySymW m ent
    None => panic "wasm: impl group without an entry (internal error)"
  ImplG m headTag key (implGroupArity clauses) clauses fnName

-- the clauses of (method, key): the def-side grouping passes a canonical key, which
-- selects exactly one impl's clauses even when it shares a head with an overlapping
-- sibling (#324).
implClauseFor : String -> String -> CImplEntry -> List CClause
implClauseFor m tag ent =
  if implEntryMethodW ent == m && implEntryAnswersW tag ent then
    [CClause (implEntryPatsW ent) (implBodyExprW (implEntryBodyW ent))]
  else
    []

implBodyExprW : CImplBody -> CExpr
implBodyExprW (CImplTagged _ _ _ _ _ _ e) = e
implBodyExprW (CImplDefault _ _ _ _ _ _ e) = e

implEntryBodyW : CImplEntry -> CImplBody
implEntryBodyW (CImplEntry _ _ _ body) = body

implGroupArity : List CClause -> Int
implGroupArity ((CClause pats _) :: _) = listLen pats
implGroupArity [] = 0

emitImplGroup : Prog -> ImplG -> List String
emitImplGroup outer (ImplG method headTag key arity clauses fnName) =
  -- an impl method has no first-clause site of its own
  let prog = progWithOrigin "impl \{method} for \{key}" (progInFn outer)
  let params = synthParams arity
  -- Phase 2 B-dispatch (TRMC-DESIGN §"Phase 2"): a DISPATCHED self-recursive cons/ctor-tail
  -- impl (the `List map`: self-call is a `CMethod method (RKey tag)`) is emitted as a
  -- destination-passing loop — the WasmGC peer of llvm_emit's trmcImplTry.  Eligibility +
  -- the safety-critical `mentionsSelfMethod` disqualification are in wTrmcImplTry; an
  -- ineligible impl (non-tail self, dict-passed, no cons-tail) returns None → ordinary body.
  match wTrmcImplTry prog method key fnName arity clauses
    Some tmcDef => tmcDef
    None =>
      let w7Outer = w7ScopeOpen (progEmit prog)
      let bodyLines = emitClausesImpl prog fnName params arity clauses
      let allLocals = clauseLocals clauses
      let extraLocals = filterList (notIn params) (dedupKeep allLocals)
      let scratch = scratchLocals (clausesMaxDepth clauses)
      let _ = defineFnW prog fnName (FuncParams arity)
      let sig =
        "  (func $\{fnName}\{joinWith "" (map paramDeclRef params)} (result (ref eq))"
      let localDecls = map localDeclRef (extraLocals ++ scratch)
      let w7Decls =
        w7LocalDecls
          (w7ScopeClose (progEmit prog) w7Outer)
          (clausesMaxDepth clauses)
      [sig]
        ++ map ("  " ++ _) (localDecls ++ w7Decls)
        ++ indent bodyLines
        ++ ["  )"]

-- impl bodies use the SAME clause emission as top-level fns; the synthetic fn
-- "name" (used only for the internal clause-block labels) is the impl symbol.
emitClausesImpl : Prog ->
  String ->
  List String ->
  Int ->
  List CClause ->
  List String
emitClausesImpl prog fnName params arity clauses =
  emitClausesRef prog fnName params arity clauses

-- One dispatch arm: the entry's symbol tag (memo naming), the function the arm
-- calls, and the entry itself, whose canonical key its dictionary carries.
data ImplArmW = ImplArmW String String CImplEntry

armSymTagW : ImplArmW -> String
armSymTagW (ImplArmW symTag _ _) = symTag

armFnSymW : ImplArmW -> String
armFnSymW (ImplArmW _ fnSym _) = fnSym

armEntryW : ImplArmW -> CImplEntry
armEntryW (ImplArmW _ _ ent) = ent

armKeyW : ImplArmW -> String
armKeyW arm = implEntryKeyW (armEntryW arm)

-- The candidate implementations of the interface a site resolved to ([iface]; `""`
-- narrows nothing), one arm per implementation, first-seen order.
methodImpls : Prog -> String -> String -> List ImplArmW
methodImpls prog method iface =
  let mEntries = methodEntriesW prog method
  dedupArmsW
    (map
      (methodImplArm method)
      (filterList
        (ent => implEntryMethodW ent == method)
        (narrowByIfaceW iface mEntries)))
    omEmpty

methodImplArm : String -> CImplEntry -> ImplArmW
methodImplArm method ent =
  ImplArmW (implEntrySymTagW ent) (implEntrySymW method ent) ent

-- one arm per called function, first-seen order
dedupArmsW : List ImplArmW -> OrdMap Unit -> List ImplArmW
dedupArmsW [] _ = []
dedupArmsW (arm :: rest) seen =
  if omHasKey (armFnSymW arm) seen then
    dedupArmsW rest seen
  else
    arm :: dedupArmsW rest (omInsert (armFnSymW arm) () seen)

-- #1852, the wasm peer of llvm_emit's `narrowImplsByArity`.  Two unrelated interfaces
-- declaring the same-spelled method at DIFFERENT arity on one receiver head put two
-- candidates of different declared arity under one bare-name dispatcher; keep only the
-- ones whose interface declaration arity matches the occurrence's carried scalar.
-- Each arm carries its entry, so declaration identity is recovered from that entry
-- rather than from the supplied argument count.  No match stays empty: restoring the whole list would make the
-- bare-name collision authoritative again.
narrowImplsByArityW : List ImplArmW -> Int -> List ImplArmW
narrowImplsByArityW impls siteArity =
  filterList (arm => implEntryDeclaredArity (armEntryW arm) == siteArity) impls

-- the entry of the occurrence's interface [iface] for (method, tag) at the site's
-- arity (mirror of llvm_emit's implForSite): a supplied method, or an inherited
-- default's per-instance body.
implForWSite : Prog -> String -> String -> String -> Int -> Option CImplEntry
implForWSite prog method iface tag siteArity =
  findByKeyArityW
    prog
    method
    tag
    siteArity
    (narrowByIfaceW iface (methodEntriesW prog method))

findByKeyArityW : Prog ->
  String ->
  String ->
  Int ->
  List CImplEntry ->
  Option CImplEntry
findByKeyArityW _ _ _ _ [] = None
findByKeyArityW prog method tag siteArity (entry :: rest) =
  if implEntryAnswersW tag entry
    && implEntryDeclaredArity entry == siteArity then
    Some entry
  else
    findByKeyArityW prog method tag siteArity rest

-- `hashName` (djb2, seed 5381) lives in `types.private_mangle`, shared verbatim
-- with the LLVM emitter so the dict-witness tag matches across backends + the
-- route-key dispatch agrees.

-- `dictTag` (the i31-safe 30-bit mask of `hashName`) and its `posMod` helper moved
-- to `types.private_mangle`, beside `hashName`, in #377/#348: the emit-time
-- collision guard (`core_validate.validateDictTags`) has to check THIS tag space
-- with the SAME expression this emitter mints, and a second copy of the mask is a
-- copy that can drift.  Imported at the top of this file; the emitted `i32.const`s
-- are unchanged.
--
-- ⚠️ The comment that used to stand here called a 30-bit tag collision
-- "astronomically unlikely for the small impl-tag alphabet" and the 64-bit LLVM
-- scheme's the "same theoretical collision shape".  Both halves were wrong:
-- colliding pre-images are CONSTRUCTIBLE in the full i64 (`hashName "Mzone" ==
-- hashName "NYone"`), the mechanism is the radix-33 polynomial versus a 74-code-
-- point alphabet rather than anything about how many tags a program has, and it
-- was a live silent-wrong-dispatch S0 on both backends until the guard landed.
-- See `private_mangle.hashName`'s note.

-- Common expression traversal; physical mode chooses i64 or (ref eq) values.
-- `d` is the current match/switch nesting DEPTH: a CDecision/CTSwitch stashes a
-- value into the scratch local `$__rf<d>` and recurses at d+1, so simultaneously-
-- live stash locals never collide.  The function header declares `$__rf0..` up to
-- the body's max depth (`maxRefDepth`).  No mutable counter needed → re-derivable.

emitRefExpr : Prog -> Env -> Int -> CExpr -> List String
emitRefExpr prog env d expr = valueLines (emitValueW prog env d expr)

refOnlyValueW : Prog -> CExpr -> (Unit -> List String) -> WasmValue
refOnlyValueW prog expr body =
  if rawProgramW prog then
    programValueW
      prog
      (gapLP prog ("scalar-mode: unsupported Core IR node " ++ ctag expr))
  else
    WasmValue WBoxEq (body ())

emitValueW : Prog -> Env -> Int -> CExpr -> WasmValue
emitValueW prog env d (CLit l) =
  if rawProgramW prog then
    let (lines, ty) = emitLitI32 (progEmit prog) l
    WasmValue (rawReprW ty) lines
  else
    WasmValue WBoxEq (emitLitRef prog l)
emitValueW prog env d (CVar x _) = programValueW prog (emitVarRef prog env d x)
emitValueW prog env d (CBinPrim op l r tag loc) =
  let code =
    if rawProgramW prog then
      emitIntBinRef prog env d op l r tag (sitePackedW (progEmit prog) loc)
    else
      emitBinRef prog env d op l r tag (sitePackedW (progEmit prog) loc)
  WasmValue (if rawProgramW prog then rawReprW (binOpTy op) else WBoxEq) code
emitValueW prog env d (CUnOp op x) =
  programValueW prog (emitUnRef prog env d op x)
emitValueW prog env d (CIf c t f) =
  let ci = emitRefExpr prog env d c ++ conditionW prog
  let tv = emitValueW prog env d t
  let fv = emitValueW prog env d f
  WasmValue
    (valueRepr tv)
    (ci
      ++ ["if (result " ++ physicalType (programReprW prog) ++ ")"]
      ++ indent (valueLines tv)
      ++ ["else"]
      ++ indent (valueLines fv)
      ++ ["end"])
emitValueW prog env d (CLet recF pat e1 e2) =
  let (prefix, env2) = emitLetBindingW prog env d recF pat e1
  prependValueW prefix (emitValueW prog env2 d e2)
emitValueW prog env d (CLetGroup binds body) = refOnlyValueW prog (CLetGroup
  binds
  body) (() =>
  emitLetGroupWith prog env d (env2 b => emitRefExpr prog env2 d b) binds body)
emitValueW prog env d (CBlock stmts) = emitBlockRef prog env d stmts
emitValueW prog env d (app@(CApp _ _ _)) =
  programValueW prog (emitAppRef prog env d app)
emitValueW prog env d (node@(CDecision scrut arms tree)) =
  refOnlyValueW prog node (() => emitDecisionRef prog env d scrut arms tree)
emitValueW prog env d (node@(CLam pats body)) =
  refOnlyValueW prog node (() => emitClosure prog env d pats body)
emitValueW prog env d (node@(CMethod name (MethodEvidence iface arity route implRoutes methRoutes))) = refOnlyValueW
  prog
  node
  (() =>
    emitMethodValueRef prog env d name iface arity route implRoutes methRoutes)
emitValueW prog env d (node@(CDict name routes)) =
  refOnlyValueW prog node (() => emitDictValueRef prog env d name routes)
emitValueW prog env d (node@(CTuple es)) =
  refOnlyValueW prog node (() => emitTupleRef prog env d es)
emitValueW prog env d (node@(CList es)) =
  refOnlyValueW prog node (() => emitListRef prog env d es)
emitValueW prog env d (node@(CRangeList lo hi incl)) =
  refOnlyValueW prog node (() => emitRangeListRef prog env d lo hi incl)
emitValueW prog env d (node@(CArray es)) =
  refOnlyValueW prog node (() => emitArrayCreateRef prog env d es)
emitValueW prog env d (node@(CRangeArray lo hi incl)) =
  refOnlyValueW prog node (() => emitRangeArrayRef prog env d lo hi incl)
emitValueW prog env d (node@(CIndex a i)) =
  refOnlyValueW prog node (() => emitIndexRef prog env d a i)
emitValueW prog env d (node@(CSlice a lo hi incl)) =
  refOnlyValueW prog node (() => emitSliceRef prog env d a lo hi incl)
emitValueW prog env d (node@(CRecord name fields)) =
  refOnlyValueW prog node (() => emitRecordRef prog env d name fields)
emitValueW prog env d (node@(CFieldAccess ex label recName ord)) = refOnlyValueW
  prog
  node
  (() => emitFieldAccessRef prog env d ex label recName ord)
emitValueW prog env d (node@(CRecordUpdate recName base fields)) = refOnlyValueW
  prog
  node
  (() => emitRecordUpdateRef prog env d recName base fields)
emitValueW prog env d (node@(CVariantUpdate con base fields)) = refOnlyValueW
  prog
  node
  (() => emitVariantUpdateRef prog env d con base fields)
emitValueW prog env d other =
  programValueW
    prog
    (gapLP prog (if rawProgramW prog then
      "scalar-mode: unsupported Core IR node " ++ ctag other
    else
      "ref-mode: unsupported Core IR node \{ctag other} [in \{progBinding prog}]"))

-- a scalar literal → an i31 immediate.  Int: ref.i31 of the value.  Bool: 1/0.
-- Unit: i31 0 (a placeholder immediate; Unit is never inspected in this slice).
emitLitRef : Prog -> Lit -> List String
emitLitRef prog (LInt n) =
  -- layer-17 §2.1: in-range Ints stay i31 immediates (byte-identical to before);
  -- literals outside ±2^30 box into $boxint via the i64 seam so they don't truncate.
  if n >= 0 - 1073741824 && n < 1073741824 then
    ["i32.const " ++ intToString n, "ref.i31"]
  else
    ["i64.const " ++ intToString n, boxIntW prog]
emitLitRef _ (LBool b) = [if b then "i32.const 1" else "i32.const 0", "ref.i31"]
emitLitRef _ LUnit = ["i32.const 0", "ref.i31"]
-- W8b: a Float literal in ref-mode boxes the double into a `(struct $float (f64))`.
-- The f64.const text is `floatToString f` — the SAME rendering (shortest-round-trip
-- since #57, NOT `%.12g`) that the LLVM oracle bakes into its IR const, so clang and
-- wasm-tools parse the identical double (verified
-- byte-identical via i64.reinterpret_f64).  `$float` is always in the rec group.  Emitted
-- as TWO FLAT instructions (not the folded `struct.new $float (f64.const …)`) so it
-- composes with the surrounding flat instruction stream (a folded form mid-stream breaks
-- wasm-tools' stack tracking).
emitLitRef _ (LFloat f) = ["f64.const " ++ floatToString f, "struct.new $float"]
-- a `U64` literal boxes its 64 bits, written in hex so a value past 2^63 needs no
-- signed spelling.
emitLitRef _ (LU64 hi lo) =
  ["i64.const 0x" ++ u64HalvesHex hi lo, "struct.new $u64"]
-- an `I64` literal's halves are its two's complement pattern, spelled the same way.
emitLitRef _ (LI64 hi lo) =
  ["i64.const 0x" ++ u64HalvesHex hi lo, "struct.new $i64"]
-- W6: a String literal is a §3.3 `$str` boxed value.  Its UTF-8 bytes go in a
-- passive data segment (the §11-preferred non-const-array init), read at run time by
-- `array.new_data`; the cached cp_count is computed at emit time (UTF-8 codepoint
-- count == source Char count).  Stack: push cp_count (i32), build the byte array via
-- array.new_data, then struct.new $str.
emitLitRef prog (LString s) =
  let bytes = strBytesW s
  let cpc = stringLength s
  let n = listLen bytes
  let seg = freshStrSeg prog bytes
  [
    "i32.const " ++ intToString cpc,
    "i32.const 0",
    "i32.const " ++ intToString n,
    "array.new_data $u8arr " ++ strSegRefW prog seg,
    "struct.new $str",
  ]
-- W6: a Char literal is its Unicode codepoint as an i31 immediate (matching the
-- native rep: a Char is a tagged codepoint, not a boxed string).  `LChar` carries a
-- one-char String, so take the codepoint of its sole char (peer to llvm_emit).
emitLitRef _ (LChar c) = [
  "i32.const " ++ intToString (charCode (arrayGetUnsafe 0 (stringToChars c))),
  "ref.i31",
]

-- ── W6 UTF-8 codec (compiler-local; mirrors llvm_emit.strBytes/utf8Bytes — the
-- no-stdlib rule forbids importing `string`, so the codec is duplicated here). ──
-- the raw UTF-8 bytes of a string, in order.
strBytesW : String -> List Int
strBytesW s = strBytesGoW (stringToChars s) 0

strBytesGoW : Array Char -> Int -> List Int
strBytesGoW cs i =
  if i >= arrayLength cs then
    []
  else
    utf8BytesW (charCode (arrayGetUnsafe i cs)) ++ strBytesGoW cs (i + 1)

-- encode one Unicode codepoint to its UTF-8 bytes (0..255).  Bit fields are disjoint,
-- so `or` is `+` and the masks are `% 64`; no bitwise primitive needed.
utf8BytesW : Int -> List Int
utf8BytesW cp =
  if cp < 128 then
    [cp]
  else if cp < 2048 then
    [192 + cp / 64, 128 + cp % 64]
  else if cp < 65536 then
    [224 + cp / 4096, 128 + cp / 64 % 64, 128 + cp % 64]
  else
    [
      240 + cp / 262144,
      128 + cp / 4096 % 64,
      128 + cp / 64 % 64,
      128 + cp % 64,
    ]

-- escape a byte list for a WAT data-string `"…"`: every byte as `\HH` (lowercase
-- hex per wasm-tools convention; uppercase also parses, lowercase keeps the emitted
-- text stable vs a `wasm-tools print` round-trip).
escWatBytes : List Int -> String
escWatBytes [] = ""
escWatBytes (b :: rest) = "\\\{hex2W b}\{escWatBytes rest}"

hex2W : Int -> String
hex2W b = hexDigitW (b / 16) ++ hexDigitW (b % 16)

hexDigitW : Int -> String
hexDigitW d =
  if d < 10 then
    intToString d
  else if d == 10 then
    "a"
  else if d == 11 then
    "b"
  else if d == 12 then
    "c"
  else if d == 13 then
    "d"
  else if d == 14 then
    "e"
  else
    "f"

-- a variable: local/global → get (already (ref eq)); a nullary ctor → its i31 tag;
-- a top-level fn used as a VALUE → build its closure wrapper struct (code =
-- $mdk_w_<f>, arity = its param count, env = []) so it can flow through a (ref eq)
-- slot / be applied indirectly.
-- a fall-through sentinel var → its lowering.  `__ft__<label>` (produced by
-- labelFallthrough in a clause body) → `br <label>`, exiting the clause block to fall
-- through to the next clause.  The bare `__fallthrough__` (NOT rewritten — appears only
-- outside a clause block, e.g. a value-binding body or a context the typechecker proved
-- exhaustive) → a trap stub `unreachable` (the WasmGC peer of llvm_emit's `call void
-- @mdk_nonexhaustive_match()`, EMITTER-GAPS.md E3; unlike that call the bare wasm trap
-- carries no coded message — a clause chain's own terminus does, at
-- emitClauseChainGo's empty-list arm).  PURE functions of the name — no mutable "current
-- label" ref, which this lazily-assembled emitter cannot thread reliably (the strings
-- are forced at final assembly, long after any setRef).
isFtSentinel : String -> Bool
isFtSentinel x = x == "__fallthrough__" || startsWith ftPrefix x

ftSentinelInstrs : String -> List String
ftSentinelInstrs x =
  if startsWith ftPrefix x then
    ["br " ++ dropPrefix x ftPrefix]
  else
    ["unreachable"]

emitFtSentinel : String -> Option (List String)
emitFtSentinel x = if isFtSentinel x then Some (ftSentinelInstrs x) else None

dropPrefix : String -> String -> String
dropPrefix s p = stringSlice (stringLength p) (stringLength s) s

-- a variable: local/global → get (already (ref eq)); a nullary ctor → its i31 tag;
emitVarRef : Prog -> Env -> Int -> String -> List String
emitVarRef prog env d x =
  if rawProgramW prog then
    if envHas x env then
      ["local.get " ++ localTargetW prog env x]
    else if omHasKey x (indexValNamesW (progIndex prog)) then
      [globalW prog "global.get" ("$" ++ gname x)]
    else if progFnMemberW prog x then
      [callFnW prog CallValueW (gname x) 0]
    else if isUnprovidedOn
      WasmBackend
      (optionOr "" (externRuntimeKey (progEmit prog).externFacts x)) then
      unprovidedExternW
        (progEmit prog)
        (optionOr "" (externRuntimeKey (progEmit prog).externFacts x))
    else
      fst
        (gapUnboundLTy
          (progEmit prog)
          ("unbound variable '"
            ++ externDisplayW (progEmit prog) x
            ++ "' (scalar mode: not a local, global value, or known function)"))
  else
    emitVarRefBoxed prog env d x

emitVarRefBoxed : Prog -> Env -> Int -> String -> List String
emitVarRefBoxed prog env d x = match emitFtSentinel x
  Some instrs => instrs
  None => emitVarRefPlain prog env d x

emitVarRefPlain : Prog -> Env -> Int -> String -> List String
emitVarRefPlain prog env d x =
  if envHas x env then
    ["local.get $" ++ gname x]
  else if progValMemberW prog x then
    -- #561 PR-B: a LAZY value global (dispatch-reaching / cyclic) is forced on first use —
    -- `call $force_<x>` memoises into $<x> and black-holes a re-entrant force into
    -- E-CYCLIC-VALUE.  A LOCAL of the same name still shadows (env checked first, above).
    -- The result is a non-null (ref eq), same as the eager `global.get; ref.as_non_null`.
    -- #664: a single memo membership check (was two linear `contains … (progValNames prog)`
    -- scans on this hot path); the lazy/eager choice nests under it, byte-identical.

    if isLazyGlobalW prog x then
      [callFnW prog CallValueW ("force_" ++ gname x) 0]
    else
      [globalW prog "global.get" ("$" ++ gname x), "ref.as_non_null"]
  else if x == "True" then
    -- the Bool constructors used as VALUES (e.g. an `eq` impl body `… = True`) are
    -- i31 immediates 1/0 — the same rep as `emitLitRef (LBool _)`, so `if` reads them
    -- via `i31.get_u` uniformly.  (Surface `True`/`False` literals desugar to CLit;
    -- these reach the emitter only as bare ctor occurrences, e.g. from impl bodies.)
    ["i32.const 1", "ref.i31"]
  else if x == "False" then
    ["i32.const 0", "ref.i31"]
  else if x == "otherwise" then
    ["i32.const 1", "ref.i31"]
  else if hasFamilyW prog x "constant"
    && runtimeNameW prog x == "charMinBound" then
    -- W9: builtin Char bounds fit in an i31 → emit directly.  These are the RAW
    -- codepoints (0 / 0x10FFFF), because an i31 payload is UNTAGGED — the same rep as
    -- `emitLitRef (LChar _)` and the `True`/`False` arms above, and what `charCode`
    -- (an identity in ref mode) and every `i31.get_u` pattern test read back.
    -- ⚠️ llvm_emit's peer constants are 1 / 2228223 and are NOT wrong there — native's
    -- word is TAGGED (`2·cp+1`).  Do NOT copy that table here: pasting the tagged words
    -- into an untagged i31 leaks the tag out as a value (#373 — `charCode charMaxBound`
    -- printed 2228223, and range checks against the bounds were silently wrong).
    ["i32.const 0", "ref.i31"]
  else if hasFamilyW prog x "constant"
    && runtimeNameW prog x == "charMaxBound" then
    ["i32.const 1114111", "ref.i31"]
  else if hasFamilyW prog x "constant" && runtimeNameW prog x == "pi" then
    -- W8b: the Float math constants pi/e are boxed (struct $float) — the SAME decimal
    -- text the LLVM oracle boxes (3.141592653589793 / 2.718281828459045).
    ["f64.const 3.141592653589793", "struct.new $float"]
  else if hasFamilyW prog x "constant" && runtimeNameW prog x == "e" then
    ["f64.const 2.718281828459045", "struct.new $float"]
  else if hasFamilyW prog x "constant"
    && runtimeNameW prog x == "intMaxBound" then
    -- P1: builtin Int bounds.  These must not be a bare `unreachable` trap-stub, on the
    -- STALE grounds that a 64-bit bound "overflows i31" and so has no
    -- wasm rep: layer-17 §2.1 gave ref-mode the `$boxint` i64 box, and every int
    -- binop already round-trips through `$mdk_box_int`/`$mdk_unbox_int` (both always in
    -- scope via ioRuntimeLines).  So the bound is representable, and a stub here makes
    -- `main = intMaxBound` ASSEMBLE and VALIDATE, then trap
    -- `unreachable` at instantiate.
    --
    -- The VALUES are the language's, not the machine's.  Medaka's Int is the NATIVE
    -- rep's 63-bit tagged word, so `intMaxBound` = 2^62-1 and `intMinBound` = -2^62 —
    -- llvm_emit emits the TAGGED words (9223372036854775807 / -9223372036854775807,
    -- as literal strings: `n*2+1` would overflow the self-host's own 63-bit Int), whose
    -- untagged values are these.  Ref-mode is untagged, so it emits the values directly
    -- — again as literal STRINGS, for exactly the same self-host-overflow reason (they
    -- are 2^62-1 / -2^62, at the boundary of the Int the compiler itself computes in).
    ["i64.const 4611686018427387903", boxIntW prog]
  else if hasFamilyW prog x "constant"
    && runtimeNameW prog x == "intMinBound" then
    ["i64.const -4611686018427387904", boxIntW prog]
  else if hasFamilyW prog x "fallthrough" then
    ftSentinelInstrs (runtimeNameW prog x)
  else if isCtor prog x then
    if ctorArity prog x == 0 then
      emitCtorConstruct prog env d x []
    else
      emitCtorEtaClosure prog x
  else if progFnMemberW prog x then
    let _ = noteFuncRef prog ("$mdk_w_" ++ x)
    -- S-4: captureless by construction (a top-level fn's wrapper closes over nothing)
    -- ⇒ one hoisted module global, not a fresh `$clos` on every evaluation of `x`.
    wConstClos prog ("$mdk_w_" ++ x) (fnParamCountW prog x)
  else if canonFn prog x /= x then
    -- W9: a bare prelude reference synthesized post-mangle (string-interp / `/=`) →
    -- resolve to its `core__`-mangled def and emit the closure wrapper for it.
    emitVarRef prog env d (canonFn prog x)
  else if isWasmEtaExtern (progEmit prog) (runtimeNameW prog x) then
    -- W9: a str/leaf extern referenced as a VALUE (point-free / passed as an arg) —
    -- build an eta closure wrapping a lifted `$mdk_ext_<name>` that calls the extern
    -- (peer of the LLVM emitExternEtaClosure).  env = [] (externs capture nothing).
    emitExternEtaClosure prog x
  else if isFfiExternW prog x then
    emitFfiEtaW prog x
  else if isUnprovidedOn WasmBackend (runtimeNameW prog x) then
    unprovidedExternW (progEmit prog) (runtimeNameW prog x)
  else
    gapUnboundLP
      prog
      "unbound variable '\{x}' (not a local, global value, constructor, or known function) [in \{progBinding prog}]"

-- W9: lift `$mdk_ext_<name>` (a $codety) that unpacks its $args into synthetic CVar
-- locals and emits the extern call, then build the closure struct at the use site.
emitExternEtaClosure : Prog -> String -> List String
emitExternEtaClosure prog name =
  let arity = match omLookup name (progEmit prog).externFacts
    Some fact => match fact.callableShape
      Some shape => shape.loweredCoreArity
      None => panic ("internal error: missing-extern-abi: " ++ name)
    None => panic ("internal error: missing-extern-requirement: " ++ name)
  let lamName = "$mdk_ext_" ++ injectiveIdent name
  let _ = noteFuncRef prog lamName
  let _ =
    addLiftedNamed
      prog
      lamName
      codeShapeW
      (emitExternEtaDefine prog lamName name arity)
  -- S-4: an extern eta captures nothing (the comment above says so) ⇒ hoisted global.
  wConstClos prog lamName arity

-- The depth-0 `$__aex*`/`$__raarr*` array-intrinsic scratch locals (the array-extern
-- rows of w7LocalKinds at depth 0) that an ARRAY-extern eta (func …)
-- must declare to host emitArrayExternRef's loop counter / size / result $arr / list
-- cursor / closure-init-value cells / i64 reinterpret accumulator.
arrayEtaScratchLocals : List String
arrayEtaScratchLocals = [
  "(local $__aexi0 i32)",
  "(local $__aexn0 i32)",
  "(local $__aexarr0 (ref null $arr))",
  "(local $__aexlst0 (ref eq))",
  "(local $__aexf0 (ref eq))",
  "(local $__aexv0 (ref eq))",
  "(local $__aexbits0 i64)",
  "(local $__raarr0 (ref null $arr))",
]

emitExternEtaDefine : Prog -> String -> String -> Int -> List String
emitExternEtaDefine prog lamName name arity =
  let params = synthParams arity
  let argPrologue = flatMap argLoadAt (zipIdx params 0)
  let argVars = map (p => CVar p AGlobal) params
  -- An ARRAY extern referenced point-free (e.g. `arrayFromList` passed to the byteparser
  -- parse path) must route to emitArrayExternRef — mirroring the DIRECT-call arm at
  -- emitAppRef (a `WasmArray` family → emitArrayExternRef).  Without this it fell to
  -- emitLeafExternRef → "unsupported leaf extern".  The array externs use the depth-0
  -- `$__aex*`/`$__raarr*` scratch locals (loop counter, size, result $arr, list cursor,
  -- closure/init/value cells, i64 reinterpret accumulator), which the synthesized eta
  -- (func …) must declare itself (its localLines otherwise only cover the param locals).
  -- the eta declares its own fixed scratch set (arrayEtaScratchLocals), so its body's
  -- W7 references must not land in the function whose codegen reached it.
  let w7Outer = w7ScopeOpen (progEmit prog)
  let key = runtimeNameW prog name
  let family = externFamilyW (progEmit prog) key
  let call = match family
    Some WasmStr =>
      emitStrExternRef prog (envExtendUnstamped params envEmpty) 0 key argVars
    Some WasmArray =>
      emitArrayExternRef prog (envExtendUnstamped params envEmpty) 0 key argVars
    Some WasmByteBlock =>
      emitByteBlockExternRef
        prog
        (envExtendUnstamped params envEmpty)
        0
        key
        argVars
    _ =>
      emitLeafExternRef prog (envExtendUnstamped params envEmpty) 0 key argVars
  let _ = w7ScopeClose (progEmit prog) w7Outer
  let arrayScratch = match family
    Some WasmArray => arrayEtaScratchLocals
    _ => []
  let localLines = map (l => localDeclRef l) params ++ arrayScratch
  [
      "  (func "
        ++ lamName
        ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
    ]
    ++ map ("  " ++ _) localLines
    ++ indent (argPrologue ++ call ++ ["return"])
    ++ ["  )"]

-- W9b: a bare/partial ADT constructor of arity > 0 used as a VALUE (`map PVar xs`)
-- — eta-wrap it into a captureless closure whose lifted code function `$mdk_wctor_
-- <Ctor>` unpacks the argarr and allocates the ctor cell.  Peer to llvm_emit's
-- emitCtorEtaClosure: an arity-0 ctor stays the immediate i31 (emitCtorConstruct
-- … []), but an arity-N ctor in value position is a FUNCTION and must be a closure,
-- not a malformed partial struct.new (the pre-W9b bug: emitCtorConstruct unpacked 0
-- args at an N-field struct → stray operands underflow at validate).
emitCtorEtaClosure : Prog -> String -> List String
emitCtorEtaClosure prog ctor =
  let arity = ctorArity prog ctor
  let lamName = "$mdk_wctor_" ++ gname ctor
  let _ = noteFuncRef prog lamName
  let _ =
    addLiftedNamed
      prog
      lamName
      codeShapeW
      (emitCtorEtaDefine prog lamName ctor arity)
  -- S-4: a ctor eta is captureless ⇒ hoisted global, not a per-reference `$clos`.
  wConstClos prog lamName arity

emitCtorEtaDefine : Prog -> String -> String -> Int -> List String
emitCtorEtaDefine prog lamName ctor arity =
  let params = synthParams arity
  let argPrologue = flatMap argLoadAt (zipIdx params 0)
  let argVars = map (p => CVar p AGlobal) params
  let body =
    emitCtorConstruct prog (envExtendUnstamped params envEmpty) 0 ctor argVars
  let localLines = map (l => localDeclRef l) params
  [
      "  (func "
        ++ lamName
        ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
    ]
    ++ map ("  " ++ _) localLines
    ++ indent (argPrologue ++ body ++ ["return"])
    ++ ["  )"]

-- arithmetic / comparison: unbox both operands from i31 to i32, do the i32 op, then
-- re-box (arithmetic → i31 int; comparison → i31 0/1 bool).
emitBinRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  Int ->
  List String
-- W13: `++` is runtime-dispatched (Core IR is type-erased, so we can't tell a
-- String `++` from a List `++` statically).  Both operands stay (ref eq) and
-- $mdk_append inspects the left operand's shape ($str → string concat; i31/$C_Cons
-- → list append), mirroring the LLVM backend's @mdk_append.
emitBinRef prog env d "++" l r _ _ =
  emitRefExpr prog env d l
    ++ emitRefExpr prog env d r
    ++ [rtCallW prog "mdk_append" 2]
-- W9: `::` is cons — build a $C_Cons cell {tag=0, head=l, tail=r} (same rep the W7
-- list-literal / Cons match machinery uses).  Reached from prelude fns that cons in
-- expression position (e.g. `gen () :: acc` in arbitraryList's where-go).
emitBinRef prog env d "::" l r _ _ =
  ["i32.const 0"]
    ++ emitRefExpr prog env d l
    ++ emitRefExpr prog env d r
    ++ ["struct.new $C_Cons"]
-- W8b: Float arithmetic / comparison.  Core IR is type-erased (CBinPrim carries no
-- LTy), so Float-ness is recovered STRUCTURALLY from the operands (a Float lit, pi/e,
-- a Float-returning extern, or a nested Float binop).  SHARED-FLOAT-RESIDUAL §6 C3:
-- the typecheck-stamped scalar-type tag (CBinPrim's 4th field, "Float" when the
-- operands ground to concrete Float) provides a direct route — additive over the
-- structural check, so an absent/non-Float tag falls back to today's path.
emitBinRef prog env d op l r tag site =
  let branch =
    selectWasmBin
      (progIndex prog).typeContext
      (emitDemandW (progEmit prog)).stringOps
      env
      op
      l
      r
      tag
  match branch
    "int-fixed" => emitIntBinRef prog env d op l r tag site
    "u64" => emitU64BinRef prog env d op l r site
    "i64" => emitI64BinRef prog env d op l r site
    "float" => emitFloatBinRef prog env d op l r
    "compare" => emitValueCmpRef prog env d op l r
    "compare-number" => emitValueCmpNumRef prog env d op l r
    _ =>
      if startsWith "value-" branch then
        let _ =
          if intOpCanOverflow op then noteIntRt (progEmit prog) (intChkName op)
        emitRefExpr prog env d l
          ++ emitRefExpr prog env d r
          ++ [rtCallW prog ("mdk_value_" ++ valueArithName op) 2]
      else
        emitIntBinRef prog env d op l r tag site

-- layer-17 §2.1: Int arithmetic/comparison computes in i64 over the box/unbox
-- seam ($mdk_unbox_int / $mdk_box_int), so values outside ±2^30 no longer
-- truncate.  Arithmetic re-boxes the i64 result (a fixed-width site masks it
-- first, `fixedWidthWrapW`); comparisons yield an i31 Bool.  A `U32` above 2^30
-- boxes into `$boxint` like any other large Int.
emitIntBinRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  CExpr ->
  String ->
  Int ->
  List String
emitIntBinRef prog env d op l r tag site =
  let seamIn = if rawProgramW prog then [] else [unboxIntW prog]
  let seamOut = if rawProgramW prog then [] else [boxIntW prog]
  let li = emitRefExpr prog env d l ++ seamIn
  let ri = emitRefExpr prog env d r ++ seamIn
  -- N4 (#3377): an `Int` `+ - * /` runs its checked operator BEFORE the rebox, so an
  -- out-of-range result stops with E-INT-OVERFLOW rather than reaching
  -- `$mdk_box_int`'s sign-extend.  A fixed-width site keeps the plain i64 op and
  -- its wrap (`fixedWidthWrapW`): the fixed-width types wrap.
  let opInstrs =
    if intOpCanOverflow op && not (isTaggedFixedHead tag) then
      intChkCall prog op site
    else
      [wasmBinOp64 (progEmit prog) op]
        ++ (if rawProgramW prog
          && isTaggedFixedHead tag
          && intOpCanOverflow op then
          normInt64
        else
          [])
  -- B5: concrete-Int `/`/`%` get a divisor-zero guard emitting the coded trap line
  -- (peer of the native emitIntDivZeroChecked) before the division.
  if op == "/" || op == "%" then
    li
      ++ ri
      ++ emitDivZeroGuard
        (progEmit prog)
        op
        (if rawProgramW prog then "$__sdivr" else divrLocal prog d)
        site
      ++ opInstrs
      ++ fixedWidthWrapW tag op
      ++ seamOut
  else if isCmpOp op then
    li
      ++ ri
      ++ [wasmBinOp64 (progEmit prog) op]
      ++ (if rawProgramW prog then ["i64.extend_i32_u"] else ["ref.i31"])
  else
    li ++ ri ++ opInstrs ++ fixedWidthWrapW tag op ++ seamOut

-- A `U64` operator (the typechecker stamps both arithmetic and comparison sites
-- `U64`): unbox both i64 payloads, then the unsigned i64 op.  `+ - *` wrap modulo
-- 2^64 for free; `/`/`%` take the Int path's divisor guard; a comparison yields
-- the i31 Bool the Int path does.
emitU64BinRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  CExpr ->
  Int ->
  List String
emitU64BinRef prog env d op l r site =
  let li = emitRefExpr prog env d l ++ unboxU64W
  let ri = emitRefExpr prog env d r ++ unboxU64W
  if op == "/" || op == "%" then
    li
      ++ ri
      ++ emitDivZeroGuard (progEmit prog) op (divrLocal prog d) site
      ++ [wasmU64Op op, "struct.new $u64"]
  else if isCmpOp op then
    li ++ ri ++ [wasmU64Op op, "ref.i31"]
  else
    li ++ ri ++ [wasmU64Op op, "struct.new $u64"]

unboxU64W : List String
unboxU64W = ["ref.cast (ref $u64)", "struct.get $u64 0"]

-- An `I64` operator (stamped `I64` at arithmetic and comparison sites alike):
-- `U64`'s shape with the signed operations.  `+ - *` are the same bits either
-- way; `/` goes through `$mdk_i64_div`, since `i64.div_s` traps on
-- `minBound / -1`, and `i64.rem_s` already answers 0 there.
emitI64BinRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  CExpr ->
  Int ->
  List String
emitI64BinRef prog env d op l r site =
  let li = emitRefExpr prog env d l ++ unboxI64W
  let ri = emitRefExpr prog env d r ++ unboxI64W
  let instr =
    if op == "/" then
      rtCallW prog "mdk_i64_div" 2
    else
      wasmBinOp64 (progEmit prog) op
  if op == "/" || op == "%" then
    li
      ++ ri
      ++ emitDivZeroGuard (progEmit prog) op (divrLocal prog d) site
      ++ [instr, "struct.new $i64"]
  else if isCmpOp op then
    li ++ ri ++ [instr, "ref.i31"]
  else
    li ++ ri ++ [instr, "struct.new $i64"]

unboxI64W : List String
unboxI64W = ["ref.cast (ref $i64)", "struct.get $i64 0"]

-- a binary `U64` kernel: both payloads, one i64 instruction (or helper call), reboxed.
emitU64KernelRef : Prog -> Env -> Int -> CExpr -> CExpr -> String -> List String
emitU64KernelRef prog env d a b instr =
  emitRefExpr prog env d a
    ++ unboxU64W
    ++ emitRefExpr prog env d b
    ++ unboxU64W
    ++ [instr, "struct.new $u64"]

-- a `U64` shift: the payload and the Int amount, through the range-checked helper.
emitU64ShiftRef : Prog -> Env -> Int -> CExpr -> CExpr -> String -> List String
emitU64ShiftRef prog env d a k helper =
  emitRefExpr prog env d a
    ++ unboxU64W
    ++ emitRefExpr prog env d k
    ++ [unboxIntW prog, helper, "struct.new $u64"]

wasmU64Op : String -> String
wasmU64Op "+" = "i64.add"
wasmU64Op "-" = "i64.sub"
wasmU64Op "*" = "i64.mul"
wasmU64Op "/" = "i64.div_u"
wasmU64Op "%" = "i64.rem_u"
wasmU64Op "==" = "i64.eq"
wasmU64Op "/=" = "i64.ne"
wasmU64Op "<" = "i64.lt_u"
wasmU64Op ">" = "i64.gt_u"
wasmU64Op "<=" = "i64.le_u"
wasmU64Op ">=" = "i64.ge_u"
wasmU64Op op = panic ("wasm: not a U64 op '" ++ op ++ "'")

-- A0: arithmetic op → the $mdk_value_<name> helper suffix.
valueArithName : String -> String
valueArithName "+" = "add"
valueArithName "-" = "sub"
valueArithName "*" = "mul"
valueArithName "/" = "div"
valueArithName "%" = "mod"
valueArithName op = panic ("wasm A0: not a value-arith op '" ++ op ++ "'")

-- ── located traps ────────────────────────────────────────────────────────────
-- A located trap writes `<file>:<line>:<col>: ` ahead of its line, from one packed
-- i64 `(file + 1) << 44 | line << 20 | col` (the word the native backend packs),
-- where `file` numbers the program's site files in order of first use.  0 means
-- no location: the trap is the unlocated line, byte for byte.

-- The packed site of [l], 0 when [l] names no file, is the placeholder span, or
-- does not fit its fields.
sitePackedW : WasmEmit -> Loc -> Int
sitePackedW emit (Loc f sl sc el ec)
  | f == "" || sl == 1 && sc == 0 && el == 1 && ec == 0 = 0
  | sl < 0 || sl >= 16777216 || sc < 0 || sc >= 1048576 = 0
  | otherwise = match siteFileNumW emit f
    Some n => n * 17592186044416 + sl * 1048576 + sc
    None => 0

siteFileNumW : WasmEmit -> String -> Option Int
siteFileNumW emit f = match omLookup f !emit.siteFileNums
  Some n => Some n
  None =>
    let n = omSize !emit.siteFileNums + 1
    if n >= 65536 then
      None
    else
      let _ = setRef emit.siteFileNums (omInsert f n !emit.siteFileNums)
      let _ = setRef emit.siteFiles (f :: !emit.siteFiles)
      Some n

-- `<file>:<line>:<col>: ` for [site], nothing for 0.
siteLocInstrs : WasmEmit -> Int -> List String
siteLocInstrs _ 0 = []
siteLocInstrs emit site =
  ["i64.const " ++ intToString site, trapCallW emit "mdk_write_err_loc" 1]

-- the located-trap runtime of the module: the table of site files, the location
-- writer, and the shared non-exhaustive-match trap if one is called.
siteExprInstrs : Prog -> Env -> Int -> CExpr -> List String
siteExprInstrs prog env d (CLit (LInt 0)) = []
siteExprInstrs prog env d (e@(CApp _ _ _)) = match flattenApp e []
  (CVar v _, [CLit (LString f), CLit (LInt line), CLit (LInt col)]) =>
    if v == siteSentinelName then
      siteLocInstrs
        (progEmit prog)
        (sitePackedW (progEmit prog) (Loc f line col line (col + 1)))
    else
      siteDynInstrs prog env d e
  _ => siteDynInstrs prog env d e
siteExprInstrs prog env d e = siteDynInstrs prog env d e

siteDynInstrs : Prog -> Env -> Int -> CExpr -> List String
siteDynInstrs prog env d e =
  emitRefExpr prog env d e
    ++ [unboxIntW prog, rtCallW prog "mdk_write_err_loc" 1]

-- the non-exhaustive-match trap at [site]: one call of the shared helper when
-- located, today's unrolled line when not.
wasmNonexhTrap : WasmEmit -> Int -> List String
wasmNonexhTrap emit 0 =
  wasmTrap emit "E-NONEXHAUSTIVE-MATCH" "non-exhaustive match"
wasmNonexhTrap emit site = [
  "i64.const " ++ intToString site,
  trapCallW emit "mdk_trap_nonexh" 1,
  "unreachable",
]

-- the site a decision tree's miss reports.
failSiteW : WasmEmit -> FailSite -> Int
failSiteW emit (NoArm l) = sitePackedW emit l
failSiteW emit (LetRefuted l) = sitePackedW emit l

-- the trap a decision tree's miss raises: no arm matched, or a `let` pattern
-- did not match.
wasmFailTrap : WasmEmit -> FailSite -> List String
wasmFailTrap emit (LetRefuted l) =
  let site = sitePackedW emit l
  siteLocInstrs emit site
    ++ wasmTrap emit "E-LET-REFUTE" "let pattern match failed"
wasmFailTrap emit fs = wasmNonexhTrap emit (failSiteW emit fs)

-- ── B5: coded runtime-trap helpers (RUNTIME-TRAP-UNIFY-DESIGN §3 (5), §7 forks 1-2) ──
-- The WasmGC peer of the native traps: emit the same coded stderr line the interpreter
-- and medaka_rt.c produce — `runtime error [E-CODE]: <message>\n` — then `unreachable`.
-- The bytes are streamed to stderr via the mdk_write_err_byte host import, FULLY
-- UNROLLED (one i32.const/call pair per byte): no $str value, no data segment, no
-- ref-mode dependency, so the SAME helper works in scalar AND ref mode and only the
-- import (not the $str runtime) is forced.  `unreachable` is stack-polymorphic, so the
-- sequence validates as any result type (mirroring the bare `unreachable` it replaces).
-- Records this event on WasmEmit so emit{Ref,Scalar}Program declares host import.
trapByteInstr : WasmEmit -> Int -> List String
trapByteInstr emit b =
  ["i32.const " ++ intToString b, trapCallW emit "mdk_write_err_byte" 1]

-- `call $<name>` of a runtime helper or host import from a coded trap
trapCallW : WasmEmit -> String -> Int -> String
trapCallW emit name operands =
  callFnAtW emit trapOriginW CallValueW name operands

wasmTrapBytes : WasmEmit -> String -> List String
wasmTrapBytes emit text = if text == "" then [] else trapMsgCall emit text

-- Stream the coded-trap text [text] by calling its `$trapmsg_K` helper.  The
-- helper holds the unrolled byte-writes once per DISTINCT text, so a message repeated
-- at many trap sites costs one body plus a call per site.  The helper takes and
-- leaves nothing, so the `call` is stack-neutral exactly as the pairs were; the
-- caller still supplies any `unreachable`.  Helper bodies are assembled by
-- `trapMsgRuntimeOf`, after every body emission (see the module assembly).
trapMsgCall : WasmEmit -> String -> List String
trapMsgCall emit text = match omLookup text !emit.trapMsgIds
  Some k => [trapCallW emit ("trapmsg_" ++ intToString k) 0]
  None =>
    let k = omSize !emit.trapMsgIds
    let _ = setRef emit.trapMsgIds (omInsert text k !emit.trapMsgIds)
    let def =
      ["  (func $trapmsg_" ++ intToString k]
        ++ map ("    " ++ _) (flatMap (trapByteInstr emit) (strBytesW text))
        ++ ["  )"]
    let _ = setRef emit.trapMsgFns (reverseL def ++ !emit.trapMsgFns)
    let _ =
      registerW
        emit
        (defineSymbol
          (WasmFunc ("trapmsg_" ++ intToString k))
          (FuncParams 0)
          trapOriginW)
    [trapCallW emit ("trapmsg_" ++ intToString k) 0]

-- the `$trapmsg_K` helper definitions this emission made, in number order.
trapMsgRuntimeOf : WasmEmit -> List String
trapMsgRuntimeOf emit = reverseL !emit.trapMsgFns

-- a full coded trap with a compile-time-fixed message (div/mod/OOB/non-exhaustive).
wasmTrap : WasmEmit -> String -> String -> List String
wasmTrap emit code msg =
  wasmTrapBytes emit "runtime error [\{code}]: \{msg}\n" ++ ["unreachable"]

-- a coded trap whose message is the fixed prefix, then `name`, then the fixed
-- `after` (which ends in its newline).  The prefix and `after` are interned like
-- any fixed text, so sites that differ only in `name` share their two helpers and
-- only the name bytes are unrolled at the site.  `name` is an identifier known at
-- emission; the stderr bytes are the same as the whole message spelled out.  The name
-- bytes call the error-byte import themselves, so the import flag is set here rather
-- than left to the interned prefix.
wasmTrapNamed : WasmEmit -> String -> String -> String -> List String
wasmTrapNamed emit code name after =
  wasmTrapBytes emit "runtime error [\{code}]: "
    ++ flatMap (trapByteInstr emit) (strBytesW name)
    ++ wasmTrapBytes emit after
    ++ ["unreachable"]

-- #1787: a coded trap whose message carries a RUNTIME number -- the fixed bytes
-- either side of it are still streamed unrolled, and the value itself goes through
-- $mdk_write_err_int.  `valIns` must leave the number on the stack as a (ref eq)
-- Medaka Int; it is unboxed here.  Sets trapIntNeeded so the decimal runtime is
-- emitted (a fixed-text trap alone must not pull it in -- that would move every
-- existing wasm golden).
wasmTrapNum : WasmEmit ->
  String ->
  String ->
  List String ->
  String ->
  List String
wasmTrapNum emit code before valIns after =
  wasmTrapBytes emit "runtime error [\{code}]: \{before}"
    ++ valIns
    ++ [
      trapCallW emit "mdk_unbox_int" 1,
      trapCallW emit "mdk_write_err_int" 1,
    ]
    ++ wasmTrapBytes emit "\{after}\n"
    ++ ["unreachable"]

-- B5: guard a concrete-Int div/mod divisor.  Stack in `[dividend:i64, divisor:i64]`;
-- stashes the divisor in `dloc`, traps with the coded [E-DIV-ZERO]/[E-MOD-ZERO] line if
-- it is zero, then restores `[dividend, divisor]` for the following i64.div_s/rem_s.
-- (The `if` has empty block type; the dividend rests untouched beneath it, and the
-- then-branch ends in `unreachable` so the branch is stack-polymorphic.)
emitDivZeroGuard : WasmEmit -> String -> String -> Int -> List String
emitDivZeroGuard emit op dloc site =
  let code = if op == "/" then "E-DIV-ZERO" else "E-MOD-ZERO"
  let msg = if op == "/" then "division by zero" else "modulo by zero"
  ["local.set " ++ dloc, "local.get " ++ dloc, "i64.eqz", "if"]
    ++ indent (siteLocInstrs emit site ++ wasmTrap emit code msg)
    ++ ["end", "local.get " ++ dloc]

-- layer-9: emit a runtime-shape-dispatched comparison.  `==`/`/=` go through
-- $mdk_value_eq (-> i31 Bool); ordering ops call $mdk_value_cmp (-> plain i32 -1/0/1)
-- then i32-compare the result against 0 for the requested op, re-boxing the Bool i31.
emitValueCmpRef : Prog -> Env -> Int -> String -> CExpr -> CExpr -> List String
emitValueCmpRef prog env d op l r =
  let lv = emitRefExpr prog env d l
  let rv = emitRefExpr prog env d r
  if op == "==" then
    lv ++ rv ++ [rtCallW prog "mdk_value_eq" 2]
  else if op == "/=" then
    lv
      ++ rv
      ++ [
        rtCallW prog "mdk_value_eq" 2,
        "ref.cast (ref i31)",
        "i31.get_u",
        "i32.eqz",
        "ref.i31",
      ]
  else
    -- #305: ordering calls the per-op IEEE predicate $mdk_value_lt/le/gt/ge,
    -- which returns an i31 Bool directly.  It USED to be `$mdk_value_cmp` then
    -- `i32.const 0` + compare — but a 3-way -1/0/1 cannot express NaN's
    -- unorderedness, so `nan <= nan` read `0 <= 0` = True.
    lv ++ rv ++ [rtCallW prog ("mdk_value_" ++ valueRelName op) 2]

-- A1 (poly-`Ord`-on-Float, string-free program): the num-only peer of emitValueCmpRef.
-- `==`/`/=` go through $mdk_value_eq_num (-> i31 Bool); ordering through $mdk_value_cmp_num
-- (-> i32 -1/0/1).  Both dispatch $float vs int (i31/$boxint) ONLY — no $str — so they
-- need no pre-scan-set type; gated by its own useValueCmpNum flag (S2/#2359 —
-- independent of the per-operator arith flags, since this branch never touches
-- $mdk_value_add/sub/mul/div/mod).
emitValueCmpNumRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  CExpr ->
  List String
emitValueCmpNumRef prog env d op l r =
  let lv = emitRefExpr prog env d l
  let rv = emitRefExpr prog env d r
  if op == "==" then
    lv ++ rv ++ [rtCallW prog "mdk_value_eq_num" 2]
  else if op == "/=" then
    lv
      ++ rv
      ++ [
        rtCallW prog "mdk_value_eq_num" 2,
        "ref.cast (ref i31)",
        "i31.get_u",
        "i32.eqz",
        "ref.i31",
      ]
  else
    -- #305: per-op IEEE predicate (num-only peer), returns an i31 Bool directly
    -- — see the note at emitValueCmpRef.
    lv ++ rv ++ [rtCallW prog ("mdk_value_" ++ valueRelName op ++ "_num") 2]

-- #305: the $mdk_value_* suffix for an ordering op.  Only `<`/`>`/`<=`/`>=` reach
-- the ordering arms — `==`/`/=` are routed to $mdk_value_eq(_num) before them.
valueRelName : String -> String
valueRelName "<" = "lt"
valueRelName ">" = "gt"
valueRelName "<=" = "le"
valueRelName ">=" = "ge"
valueRelName op = panic ("wasm: unsupported value ordering op " ++ op)

-- W8b: emit a Float binop.  Arith (+,-,*,/) → unbox both, f64 op, rebox.  `%` has no
-- f64 instruction, so it calls $mdk_float_rem (exact power-of-two-reduction fmod == LLVM frem).
-- Comparison (==,/=,<,>,<=,>=) → unbox both, f64 compare → i31 Bool.
emitFloatBinRef : Prog -> Env -> Int -> String -> CExpr -> CExpr -> List String
emitFloatBinRef prog env d op l r =
  let lf =
    emitRefExpr prog env d l ++ ["ref.cast (ref $float)", "struct.get $float 0"]
  let rf =
    emitRefExpr prog env d r ++ ["ref.cast (ref $float)", "struct.get $float 0"]
  if isCmpOp op then
    lf ++ rf ++ [wasmFloatCmp op, "ref.i31"]
  else if op == "%" then
    lf ++ rf ++ [rtCallW prog "mdk_float_rem" 2, "struct.new $float"]
  else
    lf ++ rf ++ [wasmFloatArith op, "struct.new $float"]

wasmFloatArith : String -> String
wasmFloatArith "+" = "f64.add"
wasmFloatArith "-" = "f64.sub"
wasmFloatArith "*" = "f64.mul"
wasmFloatArith "/" = "f64.div"
wasmFloatArith op = panic ("wasm W8b: not a Float arith op '" ++ op ++ "'")

wasmFloatCmp : String -> String
wasmFloatCmp "==" = "f64.eq"
wasmFloatCmp "/=" = "f64.ne"
wasmFloatCmp "<" = "f64.lt"
wasmFloatCmp ">" = "f64.gt"
wasmFloatCmp "<=" = "f64.le"
wasmFloatCmp ">=" = "f64.ge"
wasmFloatCmp op = panic ("wasm W8b: not a Float compare op '" ++ op ++ "'")

-- ── what a name holds, read from the binder stamps ───────────────────────────
-- Every static numeric fact this emitter acts on is a binder's published
-- runtime type (`DeclFacts.factBinders`), found through the binder's `BinderId`
-- ordinal.  A reference is a name, and the names in `env` are unique only among
-- NESTED binders (`uniqueBinders`): two sibling arms may bind `x` at different
-- types.  So `env` maps each name to the binder it currently denotes
-- (`envBind`), scoped exactly as the name is: an inner binding replaces the
-- outer one in its own scope only.  A fact is never stored under a name.

-- [env] extended with the stamped binder [x]
envBind : String -> BinderId -> Env -> Env
envBind = WD.envBind

-- the env of a function's plain parameters
paramEnv : List Pat -> Env
paramEnv = WD.paramEnv

varStamp : Prog -> Env -> String -> RuntimeType
varStamp prog = WD.varStamp (progIndex prog).typeContext

returnStamp : Prog -> Env -> String -> RuntimeType
returnStamp prog = WD.returnStamp (progIndex prog).typeContext

cexprStamp : Prog -> Env -> CExpr -> RuntimeType
cexprStamp prog = WD.cexprStamp (progIndex prog).typeContext

envBindGroups : List CBind -> Env -> Env
envBindGroups = WD.envBindGroups

-- is [e] statically a Float?
cexprIsFloat : Prog -> Env -> CExpr -> Bool
cexprIsFloat prog env e = cexprStamp prog env e == RTFloat

-- A binop operand whose type is known only at run time: a variable stamped
-- `RTValue` (a `Num a` parameter, or any binder the typechecker left generic).
-- It routes to the runtime value-dispatch helpers, never the inline Int path
-- (which would trap `illegal cast` on a boxed $float).
emitUnRef : Prog -> Env -> Int -> String -> CExpr -> List String
emitUnRef prog env d "-" x =
  -- W8b: unary `-` on a Float negates the f64 (f64.neg), reboxing; else integer negate.
  if not (rawProgramW prog) && cexprIsFloat prog env x then
    emitRefExpr prog env d x
      ++ [
        "ref.cast (ref $float)",
        "struct.get $float 0",
        "f64.neg",
        "struct.new $float",
      ]
  else
    -- layer-17 §2.1: integer negate over the i64 box/unbox seam, checked
    -- (intMinBound has no negation).
    let xi =
      emitRefExpr prog env d x
        ++ (if rawProgramW prog then [] else [unboxIntW prog])
    xi
      ++ intChkNegCall prog
      ++ (if rawProgramW prog then [] else [boxIntW prog])
emitUnRef prog _ _ op _ =
  gapLP
    prog
    "\{if rawProgramW prog then "scalar-mode" else "ref-mode"}: unsupported unary op '\{op}'"
-- ── W11: irrefutable destructuring let / refutable let-else / assignment ──────
-- An irrefutable `let <pat> = e` (PTuple / single-ctor PCon / PRecord / PCons /
-- PList — all single-shape here, the type proves the shape): emit the RHS once,
-- stash it into the scratch local `$__rf<de>` (de = one slot above whatever the
-- RHS uses, so it never collides), then bind each sub-pattern by field extraction
-- (reusing bindPatRef, the same machinery match-arm leaves use).  Returns the
-- stash+bind instructions and the env extended with the bound vars.
emitDestructureLet : Prog -> Env -> Int -> Pat -> CExpr -> (List String, Env)
emitDestructureLet prog env d pat e1 =
  let de = maxIndexAt e1 d + 1
  let sv = scratchLocal de
  let rhs = emitRefExpr prog env d e1 ++ ["local.set $" ++ sv]
  let (binds, env2) = bindPatRef prog env pat ["local.get $" ++ sv]
  (rhs ++ binds, env2)

-- Binding emission is shared by value and tail descent; the caller keeps the
-- body's position and passes the extended lexical environment.
emitLetBindingW : Prog ->
  Env ->
  Int ->
  Bool ->
  Pat ->
  CExpr ->
  (List String, Env)
emitLetBindingW prog env d False (PVar x _ bid) e1 =
  let rhs = emitRefExpr prog env d e1
  let _ = mintLocalW prog bid
  let env2 = envBind x bid env
  (rhs ++ ["local.set " ++ localTargetW prog env2 x], env2)
emitLetBindingW prog env d False PWild e1 =
  (emitRefExpr prog env d e1 ++ ["drop"], env)
emitLetBindingW prog env d False pat e1 =
  if rawProgramW prog then
    (
      gapLP prog "scalar-mode: only non-recursive `let x = e` / `let _ = e`",
      env,
    )
  else
    emitDestructureLet prog env d pat e1
emitLetBindingW prog env _ True (PVar x _ bid) (CLam pats body) =
  if rawProgramW prog then
    (
      gapLP prog "scalar-mode: only non-recursive `let x = e` / `let _ = e`",
      env,
    )
  else
    (emitSelfRecLocalBind prog env x bid pats body, envBind x bid env)
emitLetBindingW prog env _ _ _ _ = (
  gapLP prog (if rawProgramW prog then
    "scalar-mode: only non-recursive `let x = e` / `let _ = e`"
  else
    "ref-mode: recursive non-function `let` binding (value knot)"),
  env,
)

emitBlockRef : Prog -> Env -> Int -> List CStmt -> WasmValue
emitBlockRef prog env d [CSExpr ex] = emitValueW prog env d ex
emitBlockRef prog env d ((CSExpr ex) :: rest) =
  let prefix = emitRefExpr prog env d ex ++ ["drop"]
  prependValueW prefix (emitBlockRef prog env d rest)
emitBlockRef prog env d ((CSLet recF pat ex) :: rest) =
  let (prefix, env2) = emitBlockBindingW prog env d recF pat ex
  prependValueW prefix (emitBlockRef prog env2 d rest)
emitBlockRef prog env d ((CSAssign x ex) :: rest) =
  let prefix =
    emitRefExpr prog env d ex ++ ["local.set " ++ localTargetW prog env x]
  prependValueW prefix (emitBlockRef prog env d rest)
emitBlockRef prog env d [] = emitValueW prog env d (CLit LUnit)
emitBlockRef prog _ _ _ =
  programValueW
    prog
    (gapLP prog (if rawProgramW prog then
      "scalar-mode: unsupported block statement"
    else
      "ref-mode: unsupported block statement"))

emitBlockBindingW : Prog ->
  Env ->
  Int ->
  Bool ->
  Pat ->
  CExpr ->
  (List String, Env)
emitBlockBindingW prog env d _ pat ex = match (pat, ex)
  (PVar x _ bid, CLam pats body) =>
    if rawProgramW prog then
      emitLetBindingW prog env d False pat ex
    else
      (emitSelfRecLocalBind prog env x bid pats body, envBind x bid env)
  _ => emitLetBindingW prog env d False pat ex

emitDirectRawCallW : Prog ->
  Env ->
  Int ->
  CExpr ->
  List CExpr ->
  Bool ->
  List String
emitDirectRawCallW prog env d (CVar f _) args tail =
  if progFnMemberW prog f then
    flatMap (a => emitRefExpr prog env d a) args
      ++ [
        callFnW
          prog
          (if tail then CallTailW else CallValueW)
          (gname f)
          (listLen args),
      ]
  else
    gapLP
      prog
      ("scalar-mode: application of non-top-level head '"
        ++ f
        ++ "' (closures/HOFs are W4)")
emitDirectRawCallW prog _ _ _ _ _ =
  gapLP
    prog
    "scalar-mode: application of a non-variable head (closures/HOFs are W4)"

-- application (non-tail position).  An exact application of a known top-level fn
-- → `call`.  A ctor application → struct.new.  Anything else (a partial / over
-- application of a known fn; an indirect call whose head is a closure value: a local
-- param, a let-bound closure, a returned closure, an immediately-applied lambda) →
-- build an args array + `call $__mdk_apply` (the universal arity-dispatched apply).
emitAppRef : Prog -> Env -> Int -> CExpr -> List String
emitAppRef prog env d app =
  let (hd, args, mode) = appParts app
  if rawProgramW prog then
    emitDirectRawCallW prog env d hd args False
  else match hd
    CVar f0 _ =>
      let f = canonFn prog f0
      if f0 == "$withFileReadBound"
        || f0 == "$withFileWriteBound" then match fileBoundW app
        Some (g, body, mode) =>
          fileBoundEnterW prog env d g mode True
            ++ ["drop"]
            ++ emitRefExpr prog env d body
            ++ [rtCallW prog "mdk_file_bound_exit" 0]
        None => gapLP prog "wasm: a file bound requires a grant and a thunk"
      else if isFtSentinel f0 || hasFamilyW prog f0 "fallthrough" then
        -- the desugared `__fallthrough__ ()` / `__ft__<label> ()` form: ignore the (unit)
        -- arg, lower the sentinel (br to the clause label, or trap stub).  The bare-CVar
        -- form is handled by emitVarRef; this catches the applied form guard chains make.
        ftSentinelInstrs f0
      else if envHas f0 env then
        -- E24 (wasm peer): a LOCALLY-BOUND name (param / let-binding) SHADOWS any same-named
        -- ctor / known top-level fn / extern: it is a runtime closure VALUE, so applying it
        -- is an INDIRECT call, never a direct `call $fn` / ctor.new.  Without this, a HOF
        -- param named like an interface method (`pickEq eq x y = eq x y`, or `cmp`/`compare`/
        -- `map`) that ALSO collides with a top-level fn name fell to the function-name arm →
        -- a direct `call $<toplevel>` over the WRONG callee (silent miscompile: the top-level
        -- fn ran instead of the param), while `medaka run` and the LLVM build were always
        -- correct.  Mirrors emitVarRefPlain's `envHas x env`-first priority for the bare
        -- VALUE reference, and the LLVM emitApp E24 `isLocal`-first guard.
        emitIndirectApp prog env d hd args CallValueW
      else if isCtor prog f then
        emitCtorApp prog env d f args
      else if f0 == siteSentinelName then
        emitLeafExternRef prog env d siteSentinelName args
      else if hasFamilyW prog f0 "ref" && runtimeNameW prog f0 == "Ref" then
        emitRefBoxNew prog env d args
      else if hasFamilyW prog f0 "ref" && runtimeNameW prog f0 == "setRef" then
        emitRefBoxSet prog env d args
      else if isFfiExternW prog f then
        emitFfiAppW prog env d hd f args CallValueW
      else match externFamilyW (progEmit prog) (runtimeNameW prog f0)
        Some WasmStr => emitStrExternRef prog env d (runtimeNameW prog f0) args
        Some WasmLeaf =>
          emitLeafExternRef prog env d (runtimeNameW prog f0) args
        Some WasmArray =>
          emitArrayExternRef prog env d (runtimeNameW prog f0) args
        Some WasmByteBlock =>
          emitByteBlockExternRef prog env d (runtimeNameW prog f0) args
        _ =>
          if progFnMemberW prog f && isExactCall mode then
            let argInstrs = flatMap (a => emitRefExpr prog env d a) args
            argInstrs ++ [callFnW prog CallValueW (gname f) (listLen args)]
          else
            emitIndirectApp prog env d hd args CallValueW
    -- W5: a method occurrence applied to its args (the common return-/arg-position
    -- dispatch shape — a CMethod head under a CApp).  Dispatch on the route.
    CMethod name (MethodEvidence iface arity route implRoutes methRoutes) =>
      emitMethodRef
        prog
        env
        d
        name
        iface
        arity
        route
        implRoutes
        methRoutes
        args
        mode
        CallValueW
    -- W5: a constrained-function occurrence applied to its real args.  The dict
    -- witnesses (from `routes`) are PREPENDED to the args at the call.
    CDict name routes => emitDictRef prog env d name routes args mode CallValueW
    _ => emitIndirectApp prog env d hd args CallValueW

-- ── W6 string / IO externs ───────────────────────────────────────────────────
-- `intToString` : i31 Int → unbox → i64 → $mdk_int_to_str → (ref $str) (an (ref eq)).
-- `stringLength` : (ref $str) → cached cp_count (O(1), §5 INTRINSIC) → i31 Int.
-- `putStr`/`putStrLn` : (ref $str) → byte-write (no/with trailing '\n'); Unit (i31 0).
-- `flushStdout` : no-op (byte writes are unbuffered through the host import); Unit.
-- `charToStr`/`stringConcat` are W6b (charToStr needs a codepoint→$str runtime;
-- stringConcat takes a `List String`, which needs W7 list support).
emitStrExternRef : Prog -> Env -> Int -> String -> List CExpr -> List String
emitStrExternRef prog env d "intToString" [a] =
  emitRefExpr prog env d a ++ [unboxIntW prog, rtCallW prog "mdk_int_to_str" 1]
emitStrExternRef prog env d "intToString" _ =
  gapLP prog "wasm W6: intToString takes exactly one argument"
emitStrExternRef prog env d "stringLength" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", "struct.get $str $cp_count", "ref.i31"]
emitStrExternRef prog env d "stringLength" _ =
  gapLP prog "wasm W6: stringLength takes exactly one argument"
emitStrExternRef prog env d "stringByteLength" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", "struct.get $str $bytes", "array.len", "ref.i31"]
emitStrExternRef prog env d "stringByteLength" _ =
  gapLP prog "wasm W6: stringByteLength takes exactly one argument"
emitStrExternRef prog env d "putStr" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $str)",
      rtCallW prog "mdk_print_str" 1,
      "i32.const 0",
      "ref.i31",
    ]
emitStrExternRef prog env d "putStr" _ =
  gapLP prog "wasm W6: putStr takes exactly one argument"
emitStrExternRef prog env d "putStrLn" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $str)",
      rtCallW prog "mdk_print_strln" 1,
      "i32.const 0",
      "ref.i31",
    ]
emitStrExternRef prog env d "putStrLn" _ =
  gapLP prog "wasm W6: putStrLn takes exactly one argument"
emitStrExternRef prog env d "ePutStr" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $str)",
      rtCallW prog "mdk_eprint_str" 1,
      "i32.const 0",
      "ref.i31",
    ]
emitStrExternRef prog env d "ePutStr" _ =
  gapLP prog "wasm W8: ePutStr takes exactly one argument"
emitStrExternRef prog env d "ePutStrLn" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $str)",
      rtCallW prog "mdk_eprint_strln" 1,
      "i32.const 0",
      "ref.i31",
    ]
emitStrExternRef prog env d "ePutStrLn" _ =
  gapLP prog "wasm W8: ePutStrLn takes exactly one argument"
emitStrExternRef _ _ _ "flushStdout" _ = ["i32.const 0", "ref.i31"]
-- charToStr : a Char is an i31 codepoint (ref eq) → unbox to i32 → $mdk_char_to_str.
emitStrExternRef prog env d "charToStr" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref i31)", "i31.get_u", rtCallW prog "mdk_char_to_str" 1]
emitStrExternRef prog env d "charToStr" _ =
  gapLP prog "wasm W8: charToStr takes exactly one argument"
-- stringConcat : a List String (ref eq) → walk the W7 cons list → fresh $str.
emitStrExternRef prog env d "stringConcat" [a] =
  emitRefExpr prog env d a ++ [rtCallW prog "mdk_str_concat" 1]
emitStrExternRef prog env d "stringConcat" _ =
  gapLP prog "wasm W8: stringConcat takes exactly one argument"
-- stringSlice lo hi s : lo/hi are i31 Int codepoint indices, s a $str.
emitStrExternRef prog env d "stringSlice" [lo, hi, s] =
  emitRefExpr prog env d lo
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ emitRefExpr prog env d hi
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_slice" 3]
emitStrExternRef prog env d "stringSlice" _ =
  gapLP prog "wasm W8: stringSlice takes exactly three arguments"
emitStrExternRef prog env d "stringToUpper" [s] =
  emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_upper" 1]
emitStrExternRef prog env d "stringToUpper" _ =
  gapLP prog "wasm W8: stringToUpper takes exactly one argument"
emitStrExternRef prog env d "stringToLower" [s] =
  emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_lower" 1]
emitStrExternRef prog env d "stringToLower" _ =
  gapLP prog "wasm W8: stringToLower takes exactly one argument"
-- hashString : a $str → FNV-1a i32 in [0,2^30) → i31 Int.
emitStrExternRef prog env d "hashString" [s] =
  emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_hash_string" 1, "ref.i31"]
emitStrExternRef prog env d "hashString" _ =
  gapLP prog "wasm W8: hashString takes exactly one argument"
-- W8b: floatToString : a boxed $float → unbox → $mdk_float_to_str → (ref $str).
emitStrExternRef prog env d "floatToString" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $float)",
      "struct.get $float 0",
      rtCallW prog "mdk_float_to_str" 1,
    ]
emitStrExternRef prog env d "floatToString" _ =
  gapLP prog "wasm W8b: floatToString takes exactly one argument"
-- W8b: stringIndexOf needle hay : two $str → Option Int (ref eq).  The runtime fn
-- builds the Some/None result directly (Some idx / None), so no inline ctor here.
emitStrExternRef prog env d "stringIndexOf" [needle, hay] =
  emitRefExpr prog env d needle
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d hay
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_index_of" 2]
emitStrExternRef prog env d "stringIndexOf" _ =
  gapLP prog "wasm W8b: stringIndexOf takes exactly two arguments"
-- W8c: byte-level searches over two $str.  Bool / Int results are i32 immediates
-- from the runtime fns; stringLastIndexOf builds its Option Int like $mdk_str_index_of.
emitStrExternRef prog env d "stringStartsWith" [p, s] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_starts_with" 2, "ref.i31"]
emitStrExternRef prog env d "stringStartsWith" _ =
  gapLP prog "wasm W8c: stringStartsWith takes exactly two arguments"
emitStrExternRef prog env d "stringEndsWith" [p, s] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_ends_with" 2, "ref.i31"]
emitStrExternRef prog env d "stringEndsWith" _ =
  gapLP prog "wasm W8c: stringEndsWith takes exactly two arguments"
emitStrExternRef prog env d "stringCountOccurrences" [n, h] =
  emitRefExpr prog env d n
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d h
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_count_occ" 2, "ref.i31"]
emitStrExternRef prog env d "stringCountOccurrences" _ =
  gapLP prog "wasm W8c: stringCountOccurrences takes exactly two arguments"
emitStrExternRef prog env d "stringLastIndexOf" [n, h] =
  emitRefExpr prog env d n
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d h
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_last_index_of" 2]
emitStrExternRef prog env d "stringLastIndexOf" _ =
  gapLP prog "wasm W8c: stringLastIndexOf takes exactly two arguments"
-- W8d: stringToInt / stringReverse take one $str; stringJoin a $str and a cons list.
emitStrExternRef prog env d "stringToInt" [s] =
  emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_to_int" 1]
emitStrExternRef prog env d "stringToInt" _ =
  gapLP prog "wasm W8d: stringToInt takes exactly one argument"
emitStrExternRef prog env d "stringReverse" [s] =
  emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_reverse" 1]
emitStrExternRef prog env d "stringReverse" _ =
  gapLP prog "wasm W8d: stringReverse takes exactly one argument"
emitStrExternRef prog env d "stringJoin" [sep, parts] =
  emitRefExpr prog env d sep
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d parts
    ++ [rtCallW prog "mdk_str_join" 2]
emitStrExternRef prog env d "stringJoin" _ =
  gapLP prog "wasm W8d: stringJoin takes exactly two arguments"
-- W8b: stringCompare a b : two $str → Ordering (ref eq).  The runtime fn returns the
-- Lt/Eq/Gt i31 immediate directly.
emitStrExternRef prog env d "stringCompare" [a, b] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d b
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_compare" 2]
emitStrExternRef prog env d "stringCompare" _ =
  gapLP prog "wasm W8b: stringCompare takes exactly two arguments"
-- W11b: stringToChars : String -> Array Char.  Decode the $str's UTF-8 bytes into a
-- fresh $arr of `cp_count` i31 Char codepoints.  The runtime fn builds the $arr.
emitStrExternRef prog env d "stringToChars" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_to_chars" 1]
emitStrExternRef prog env d "stringToChars" _ =
  gapLP prog "wasm W11b: stringToChars takes exactly one argument"
-- W11b: stringFromChars : Array Char -> String.  Encode an $arr of i31 Char codepoints
-- into a fresh $str (UTF-8); cp_count = array.len.  The runtime fn builds the $str.
emitStrExternRef prog env d "stringFromChars" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)", rtCallW prog "mdk_chars_to_str" 1]
emitStrExternRef prog env d "stringFromChars" _ =
  gapLP prog "wasm W11b: stringFromChars takes exactly one argument"
-- W11b: stringToUtf8Bytes : String -> Array Int.  Copy the $str's $u8arr backing into
-- a fresh $arr of i31 Int bytes (0..255).  stringFromUtf8Bytes : Array Int -> String —
-- blit the low 8 bits of each i31 back into a $u8arr + struct.new $str.
emitStrExternRef prog env d "stringToUtf8Bytes" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_str_to_utf8_bytes" 1]
emitStrExternRef prog env d "stringToUtf8Bytes" _ =
  gapLP prog "wasm W11b: stringToUtf8Bytes takes exactly one argument"
emitStrExternRef prog env d "stringFromUtf8Bytes" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)", rtCallW prog "mdk_utf8_bytes_to_str" 1]
emitStrExternRef prog env d "stringFromUtf8Bytes" _ =
  gapLP prog "wasm W11b: stringFromUtf8Bytes takes exactly one argument"
-- W11b: charFromCode : Int -> Option Char.  Range-check the i31 Int (valid = 0..0x10FFFF
-- EXCLUDING surrogates 0xD800..0xDFFF, byte-identical to medaka_rt.c mdk_char_from_code)
-- → Some <char i31> (struct.new $C_Some, ordinal 0) / None (i31 ordinal 1).  Inlined
-- (peer to the runtime-built stringIndexOf Option, but small enough to emit directly).
emitStrExternRef prog env d "charFromCode" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref i31)", "i31.get_s", rtCallW prog "mdk_char_from_code" 1]
emitStrExternRef prog env d "charFromCode" _ =
  gapLP prog "wasm W11b: charFromCode takes exactly one argument"
-- W9: debugStringLit s : $str -> $str (quote+escape with double-quotes).
emitStrExternRef prog env d "debugStringLit" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_debug_string_lit" 1]
emitStrExternRef prog env d "debugStringLit" _ =
  gapLP prog "wasm W9: debugStringLit takes exactly one argument"
-- W9: debugCharLit c : Char (i31) -> $str (quote+escape with single-quotes).
emitStrExternRef prog env d "debugCharLit" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref i31)", "i31.get_u", rtCallW prog "mdk_debug_char_lit" 1]
emitStrExternRef prog env d "debugCharLit" _ =
  gapLP prog "wasm W9: debugCharLit takes exactly one argument"
-- layer-6: stringToFloat : String -> Option Float.
-- Push the $str's bytes via the path channel, call mdk_str_to_float -> f64, return
-- Option Float (Some(boxed $float) | None) via the WAT runtime $mdk_string_to_float.
emitStrExternRef prog env d "stringToFloat" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_string_to_float" 1]
emitStrExternRef prog env d "stringToFloat" _ =
  gapLP prog "wasm layer-6: stringToFloat takes exactly one argument"
emitStrExternRef prog _ _ name _ =
  gapLP prog ("wasm W6: unsupported string extern '" ++ name ++ "'")

-- ── W8 RNG + hash LEAF externs (RUNTIME-DESIGN §5 RNG / §5 hash) ─────────────
-- RNG: randomInt lo hi (i31 Int args → $mdk_random_int → i31 Int, INCLUSIVE);
-- randomBool/randomChar take a Unit arg (emitted + dropped) → i31 Bool/Char;
-- setSeed unboxes its i31 Int to i64 into the seed global.  Hash: hashInt/hashChar
-- ── Ref / setRef / .value — $refbox mutable-cell externs ───────────────────
-- `Ref x`     : allocate a fresh 1-field mutable $refbox, storing x as (ref eq).
-- `setRef r v` : overwrite field 0 of r's $refbox; result is Unit (i31 0).
-- `.value`    : struct.get the mutable field 0; handled in emitFieldAccessRef.
emitRefBoxNew : Prog -> Env -> Int -> List CExpr -> List String
emitRefBoxNew prog env d [x] =
  emitRefExpr prog env d x ++ ["struct.new $refbox"]
emitRefBoxNew prog env d _ =
  gapLP prog "wasm Ref: Ref takes exactly one argument"

-- `setRef r v` : struct.set $refbox 0 ; returns Unit.
-- WAT stack order for struct.set is [structref, value] (ref on top first).
emitRefBoxSet : Prog -> Env -> Int -> List CExpr -> List String
emitRefBoxSet prog env d [r, v] =
  emitRefExpr prog env d r
    ++ ["ref.cast (ref $refbox)"]
    ++ emitRefExpr prog env d v
    ++ ["struct.set $refbox 0", "i32.const 0", "ref.i31"]
emitRefBoxSet prog env d _ =
  gapLP prog "wasm Ref: setRef takes exactly two arguments"

-- untag the i31 value to i32 (the runtime sign-extends to i64, matching the native
-- signed `tagged>>1`); hashBool passes the 0/1 i31.  All hash results fit i31
-- (masked to 2^30-1, non-negative).  randomFloat / hashFloat are DEFERRED (W8b —
-- they need Float boxing + the float formatter (shortest-round-trip since #57, NOT
-- %.12g — see wasm_preamble.mdk's W8b Float section); see the gap arms).
emitLeafExternRef : Prog -> Env -> Int -> String -> List CExpr -> List String
-- #179: randomInt lo hi — the draw (and lo/hi) can exceed ±2^30, so BOTH args unbox
-- through the i31/$boxint seam ($mdk_unbox_int → i64) and the i64 result reboxes via
-- $mdk_box_int.  Casting args + result to a bare `ref.i31` instead traps
-- `illegal cast` when lo/hi/draw fall outside i31 (e.g. `randomInt 0 1000000000000000`
-- draws 457532755261734).  $mdk_random_int is i64→i64 (mirrors native mdk_random_int:
-- inclusive, unsigned modulus of hi-lo+1).
-- lo > hi answers lo; every other span, the full Int range's 2^63 included, draws.
emitLeafExternRef prog env d "randomInt" [lo, hi] =
  emitRefExpr prog env d lo
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d hi
    ++ [unboxIntW prog]
    ++ [rtCallW prog "mdk_random_int" 2, boxIntW prog]
emitLeafExternRef prog env d "randomInt" _ =
  gapLP prog "wasm W8: randomInt takes exactly two arguments"
emitLeafExternRef prog env d "randomBool" [u] =
  emitRefExpr prog env d u
    ++ ["drop", rtCallW prog "mdk_random_bool" 0, "ref.i31"]
emitLeafExternRef prog env d "randomBool" _ =
  gapLP prog "wasm W8: randomBool takes exactly one (Unit) argument"
emitLeafExternRef prog env d "randomChar" [u] =
  emitRefExpr prog env d u
    ++ ["drop", rtCallW prog "mdk_random_char" 0, "ref.i31"]
emitLeafExternRef prog env d "randomChar" _ =
  gapLP prog "wasm W8: randomChar takes exactly one (Unit) argument"
-- #199: the seed is a general Int; unbox the full width through $mdk_unbox_int (→ i64)
-- so `setSeed 4503599627370497` no longer traps the i31 cast.
emitLeafExternRef prog env d "setSeed" [n] =
  emitRefExpr prog env d n
    ++ [
      unboxIntW prog,
      globalW prog "global.set" rngStateW,
      "i32.const 0",
      "ref.i31",
    ]
emitLeafExternRef prog env d "setSeed" _ =
  gapLP prog "wasm W8: setSeed takes exactly one argument"
emitLeafExternRef prog env d "randomState" [u] =
  emitRefExpr prog env d u
    ++ ["drop", globalW prog "global.get" rngStateW, "struct.new $u64"]
emitLeafExternRef prog env d "randomState" _ =
  gapLP prog "wasm W8: randomState takes exactly one (Unit) argument"
emitLeafExternRef prog env d "restoreRandomState" [state] =
  emitRefExpr prog env d state
    ++ unboxU64W
    ++ [globalW prog "global.set" rngStateW, "i32.const 0", "ref.i31"]
emitLeafExternRef prog env d "restoreRandomState" _ =
  gapLP prog "wasm W8: restoreRandomState takes exactly one argument"
-- #199: hashInt unboxes the FULL-WIDTH Int (via $mdk_unbox_int → i64) so an Int key
-- outside ±2^30 (e.g. a HashMap Int) hashes correctly instead of trapping the i31 cast;
-- $mdk_hash_int now takes i64.  hashChar's codepoint fits i32 → sign-extend to i64.
emitLeafExternRef prog env d "hashInt" [a] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog, rtCallW prog "mdk_hash_int" 1, "ref.i31"]
emitLeafExternRef prog env d "hashInt" _ =
  gapLP prog "wasm W8: hashInt takes exactly one argument"
emitLeafExternRef prog env d "hashChar" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      "i64.extend_i32_s",
      rtCallW prog "mdk_hash_int" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "hashChar" _ =
  gapLP prog "wasm W8: hashChar takes exactly one argument"
emitLeafExternRef prog env d "hashBool" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_hash_bool" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "hashBool" _ =
  gapLP prog "wasm W8: hashBool takes exactly one argument"
-- W11: charCode : Char -> Int — a Char is an i31 codepoint immediate.  Cast to i31,
-- read the unsigned payload (the codepoint), wrap back as an i31 Int.  The unbox +
-- rebox is identity on the bits (both Char and Int are i31 codepoint / integer), but
-- the cast ensures Wasm's type-safe path through (ref eq).
emitLeafExternRef prog env d "charCode" [a] =
  emitRefExpr prog env d a ++ ["ref.cast (ref i31)", "i31.get_u", "ref.i31"]
emitLeafExternRef prog env d "charCode" _ =
  gapLP prog "wasm W11: charCode takes exactly one argument"
-- W11b: char classification predicates (ASCII-only, byte-identical to medaka_rt.c).
-- Char is i31 codepoint; unbox with i31.get_u, call WAT helper, result is i32 0/1 → ref.i31.
-- charIsAlpha c → (c>='a'&&c<='z')||(c>='A'&&c<='Z')
emitLeafExternRef prog env d "charIsAlpha" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_is_alpha" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charIsAlpha" _ =
  gapLP prog "wasm W11b: charIsAlpha takes exactly one argument"
-- charIsSpace c → c==32 || (c>=9 && c<=13)
emitLeafExternRef prog env d "charIsSpace" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_is_space" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charIsSpace" _ =
  gapLP prog "wasm W11b: charIsSpace takes exactly one argument"
-- charIsUpper c → c>='A'&&c<='Z'
emitLeafExternRef prog env d "charIsUpper" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_is_upper" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charIsUpper" _ =
  gapLP prog "wasm W11b: charIsUpper takes exactly one argument"
-- charIsLower c → c>='a'&&c<='z'
emitLeafExternRef prog env d "charIsLower" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_is_lower" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charIsLower" _ =
  gapLP prog "wasm W11b: charIsLower takes exactly one argument"
-- charIsPunct: exact set from medaka_rt.c switch — Unicode Pc/Pd/Pe/Pf/Pi/Po/Ps for ASCII.
emitLeafExternRef prog env d "charIsPunct" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_is_punct" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charIsPunct" _ =
  gapLP prog "wasm W11b: charIsPunct takes exactly one argument"
-- charToUpper c → if c>='a'&&c<='z' then c-32 else c  (result = Char i31 codepoint)
emitLeafExternRef prog env d "charToUpper" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_to_upper" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charToUpper" _ =
  gapLP prog "wasm W11b: charToUpper takes exactly one argument"
-- charToLower c → if c>='A'&&c<='Z' then c+32 else c  (result = Char i31 codepoint)
emitLeafExternRef prog env d "charToLower" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref i31)",
      "i31.get_u",
      rtCallW prog "mdk_char_to_lower" 1,
      "ref.i31",
    ]
emitLeafExternRef prog env d "charToLower" _ =
  gapLP prog "wasm W11b: charToLower takes exactly one argument"
-- W8b Float leaf externs.  #199: intToFloat unboxes its Int arg through the $mdk_unbox_int
-- (→ i64) seam, and floatToInt reboxes its i64 truncation via $mdk_box_int — the SAME seam
-- randomInt/bitAnd use — so full-width Ints outside ±2^30 no longer trap the i31 cast.
-- hashFloat : $float → masked i32 → i31.  randomFloat : Unit arg dropped → $mdk_random_float.
emitLeafExternRef prog env d "intToFloat" [a] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog, rtCallW prog "mdk_int_to_float" 1]
emitLeafExternRef prog env d "intToFloat" _ =
  gapLP prog "wasm W8b: intToFloat takes exactly one argument"
emitLeafExternRef prog env d "floatToInt" [a] =
  emitRefExpr prog env d a
    ++ [
      "ref.cast (ref $float)",
      rtCallW prog "mdk_float_to_int" 1,
      boxIntW prog,
    ]
emitLeafExternRef prog env d "floatToInt" _ =
  gapLP prog "wasm W8b: floatToInt takes exactly one argument"
emitLeafExternRef prog env d "hashFloat" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $float)", rtCallW prog "mdk_hash_float" 1, "ref.i31"]
emitLeafExternRef prog env d "hashFloat" _ =
  gapLP prog "wasm W8b: hashFloat takes exactly one argument"
emitLeafExternRef prog env d "randomFloat" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_random_float" 0]
emitLeafExternRef prog env d "randomFloat" _ =
  gapLP prog "wasm W8b: randomFloat takes exactly one (Unit) argument"
-- W12 IO host-surface externs.  readFile/fileExists/getEnv take a $str path/name;
-- args takes a Unit (dropped); exit takes an i31 Int.  Each routes through the
-- byte-channel host-import runtime (ioHostRuntimeLines).  readFile returns a Result
-- (ref eq), fileExists a Bool i31, getEnv an Option (ref eq), args a List (ref eq),
-- exit traps (mdk_exit + unreachable, stack-polymorphic like panic).
-- A file extern whose path is an authority takes its grant last
-- (EFFECTS-SEMANTICS §8), and its runtime body hands both to the host, which
-- confines the path (`ioHostRuntimeLines`).
emitLeafExternRef prog env d "readFile" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_read_file_io" 2]
emitLeafExternRef prog env d "readFile" _ =
  gapLP prog "wasm W12: readFile takes exactly one argument and its grant"
emitLeafExternRef prog env d "canonicalizePath" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_canonicalize_path_io" 2]
emitLeafExternRef prog env d "canonicalizePath" _ =
  gapLP prog "wasm: canonicalizePath takes exactly one argument and its grant"
emitLeafExternRef prog env d "fileExists" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_file_exists_io" 2]
emitLeafExternRef prog env d "fileExists" _ =
  gapLP prog "wasm W12: fileExists takes exactly one argument and its grant"
emitLeafExternRef prog env d "getEnv" [n] =
  emitRefExpr prog env d n
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_get_env_io" 1]
emitLeafExternRef prog env d "getEnv" _ =
  gapLP prog "wasm W12: getEnv takes exactly one argument"
-- The stdin readers share one host-side buffer: a Unit argument is dropped, and
-- readExactly's Int is unboxed to the i64 the import takes.
emitLeafExternRef prog env d "readLine" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_read_line_io" 0]
emitLeafExternRef prog env d "readLine" _ =
  gapLP prog "wasm: readLine takes exactly one (Unit) argument"
emitLeafExternRef prog env d "readLineOpt" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_read_line_opt_io" 0]
emitLeafExternRef prog env d "readLineOpt" _ =
  gapLP prog "wasm: readLineOpt takes exactly one (Unit) argument"
emitLeafExternRef prog env d "readAll" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_read_all_io" 0]
emitLeafExternRef prog env d "readAll" _ =
  gapLP prog "wasm: readAll takes exactly one (Unit) argument"
emitLeafExternRef prog env d "readExactly" [n] =
  emitRefExpr prog env d n
    ++ [unboxIntW prog, rtCallW prog "mdk_read_exactly_io" 1]
emitLeafExternRef prog env d "readExactly" _ =
  gapLP prog "wasm: readExactly takes exactly one argument"
-- osEntropyBytes unboxes its Int to the i64 the import takes and builds an Array Int;
-- executablePath takes a Unit (dropped) and answers its String through the result channel.
emitLeafExternRef prog env d "osEntropyBytes" [n] =
  emitRefExpr prog env d n
    ++ [unboxIntW prog, rtCallW prog "mdk_os_entropy_io" 1]
emitLeafExternRef prog env d "osEntropyBytes" _ =
  gapLP prog "wasm: osEntropyBytes takes exactly one argument"
emitLeafExternRef prog env d "executablePath" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_executable_path_io" 0]
emitLeafExternRef prog env d "executablePath" _ =
  gapLP prog "wasm: executablePath takes exactly one (Unit) argument"
emitLeafExternRef prog env d "args" [u] =
  emitRefExpr prog env d u ++ ["drop", rtCallW prog "mdk_args_io" 0]
emitLeafExternRef prog env d "args" args =
  gapLP prog "wasm W12: args takes exactly one (Unit) argument"
emitLeafExternRef prog env d "exit" [code] =
  emitRefExpr prog env d code
    ++ [
      "ref.cast (ref i31)",
      "i31.get_s",
      rtCallW prog "mdk_exit" 1,
      "unreachable",
    ]
emitLeafExternRef prog env d "exit" _ =
  gapLP prog "wasm W12: exit takes exactly one argument"
-- The clock externs: the two reads box the host's f64 seconds; sleepMs unboxes its
-- Int to the i64 the import takes (a non-positive count returns at once, host-side,
-- as medaka_rt.c's mdk_sleep_ms does).
emitLeafExternRef prog env d "wallTimeSec" [u] =
  emitRefExpr prog env d u
    ++ ["drop", rtCallW prog "mdk_wall_time_sec" 0, "struct.new $float"]
emitLeafExternRef prog env d "wallTimeSec" _ =
  gapLP prog "wasm: wallTimeSec takes exactly one (Unit) argument"
emitLeafExternRef prog env d "monotonicSec" [u] =
  emitRefExpr prog env d u
    ++ ["drop", rtCallW prog "mdk_monotonic_sec" 0, "struct.new $float"]
emitLeafExternRef prog env d "monotonicSec" _ =
  gapLP prog "wasm: monotonicSec takes exactly one (Unit) argument"
emitLeafExternRef prog env d "sleepMs" [n] =
  emitRefExpr prog env d n
    ++ [unboxIntW prog, rtCallW prog "mdk_sleep_ms" 1, "i32.const 0", "ref.i31"]
emitLeafExternRef prog env d "sleepMs" _ =
  gapLP prog "wasm: sleepMs takes exactly one argument"
-- fetchText pushes its url through the path channel and answers a Result through the
-- result channel, as readFile does; Net carries no grant argument.
emitLeafExternRef prog env d "fetchText" [u] =
  emitRefExpr prog env d u
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_fetch_text_io" 1]
emitLeafExternRef prog env d "fetchText" _ =
  gapLP prog "wasm: fetchText takes exactly one argument"
-- ioPoll: no wasm host binds descriptor readiness, so a call stops with a coded
-- runtime error.  It traps at run time, not at build time, because the async
-- scheduler (`systemPoller`) names ioPoll and calls it only when a task waits on
-- a descriptor; a clock-only async program must still build.  The arguments are
-- evaluated left to right first, as native evaluates them.
emitLeafExternRef prog env d "ioPoll" [fds, interests, timeout] =
  emitRefExpr prog env d fds
    ++ ["drop"]
    ++ emitRefExpr prog env d interests
    ++ ["drop"]
    ++ emitRefExpr prog env d timeout
    ++ ["drop"]
    ++ wasmTrap
      (progEmit prog)
      "E-WASM-NO-BINDING"
      "ioPoll: descriptor readiness has no wasm binding (Net and Stdin bindings: #3666); build for a native target"
emitLeafExternRef prog env d "ioPoll" _ =
  gapLP prog "wasm: ioPoll takes exactly three arguments"
-- stage-D: byte-clean file I/O.  readFileBytes returns a Result String (Array Int);
-- writeFileBytes takes (path, Array Int) and returns Result String Unit.  Both route
-- into the fileBytes host seam ($mdk_read_file_bytes_io / $mdk_write_file_bytes_io).
emitLeafExternRef prog env d "readFileBytes" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_read_file_bytes_io" 2]
emitLeafExternRef prog env d "readFileBytes" _ =
  gapLP
    prog
    "wasm stage-D: readFileBytes takes exactly one argument and its grant"
emitLeafExternRef prog env d "writeFileBytes" [p, arr, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d arr
    ++ ["ref.cast (ref $arr)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_write_file_bytes_io" 3]
emitLeafExternRef prog env d "writeFileBytes" _ =
  gapLP
    prog
    "wasm stage-D: writeFileBytes takes exactly two arguments and its grant"
emitLeafExternRef prog env d "writeFile" [p, s, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_write_file_io" 3]
emitLeafExternRef prog env d "writeFile" _ =
  gapLP prog "wasm: writeFile takes exactly two arguments and its grant"
emitLeafExternRef prog env d "appendFile" [p, s, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_append_file_io" 3]
emitLeafExternRef prog env d "appendFile" _ =
  gapLP prog "wasm: appendFile takes exactly two arguments and its grant"
emitLeafExternRef prog env d "rename" [src, dst, gs, gd] =
  emitRefExpr prog env d src
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d dst
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d gs
    ++ emitRefExpr prog env d gd
    ++ [rtCallW prog "mdk_rename_io" 4]
emitLeafExternRef prog env d "rename" _ =
  gapLP prog "wasm: rename takes exactly two arguments and the grant of each"
emitLeafExternRef prog env d "listDir" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_list_dir_io" 2]
emitLeafExternRef prog env d "listDir" _ =
  gapLP prog "wasm: listDir takes exactly one argument and its grant"
emitLeafExternRef prog env d "statFile" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_stat_file_io" 2]
emitLeafExternRef prog env d "statFile" _ =
  gapLP prog "wasm: statFile takes exactly one argument and its grant"
emitLeafExternRef prog env d "makeDir" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_make_dir_io" 2]
emitLeafExternRef prog env d "makeDir" _ =
  gapLP prog "wasm: makeDir takes exactly one argument and its grant"
emitLeafExternRef prog env d "removeFile" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_remove_file_io" 2]
emitLeafExternRef prog env d "removeFile" _ =
  gapLP prog "wasm: removeFile takes exactly one argument and its grant"
emitLeafExternRef prog env d "removeDir" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_remove_dir_io" 2]
emitLeafExternRef prog env d "removeDir" _ =
  gapLP prog "wasm: removeDir takes exactly one argument and its grant"
emitLeafExternRef prog env d "fsync" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_fsync_io" 2]
emitLeafExternRef prog env d "fsync" _ =
  gapLP prog "wasm: fsync takes exactly one argument and its grant"
emitLeafExternRef prog env d "fileMode" [p, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_file_mode_io" 2]
emitLeafExternRef prog env d "fileMode" _ =
  gapLP prog "wasm: fileMode takes exactly one argument and its grant"
emitLeafExternRef prog env d "writeFileMode" [p, m, s, g] =
  emitRefExpr prog env d p
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d m
    ++ emitRefExpr prog env d s
    ++ ["ref.cast (ref $str)"]
    ++ emitRefExpr prog env d g
    ++ [rtCallW prog "mdk_write_file_mode_io" 4]
emitLeafExternRef prog env d "writeFileMode" _ =
  gapLP prog "wasm: writeFileMode takes three arguments and its grant"
-- W10/B5: `panic msg` → stream the coded line `runtime error [E-PANIC]: <msg>\n` to
-- stderr, then `unreachable` (peer of native @mdk_panic / the interp's runtimePanic).
-- The fixed prefix is unrolled to byte-writes; the user message (a $str (ref eq), any
-- expression) is streamed through $mdk_eprint_str (forced via `WasmEmit.useEPut`, which the
-- catalog demands for `panic`), then a trailing newline byte.  `unreachable` is stack-polymorphic, so it
-- validates as any result type.
emitLeafExternRef prog env d "panic" [msg] =
  wasmTrapBytes (progEmit prog) "runtime error [E-PANIC]: "
    ++ emitRefExpr prog env d msg
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_eprint_str" 1]
    ++ trapByteInstr (progEmit prog) 10
    ++ ["unreachable"]
emitLeafExternRef prog env d "panic" _ =
  gapLP prog "wasm W10: panic takes exactly one argument"
-- Index-16a: `indexError msg` streams the coded line `runtime error
-- [E-INDEX-OOB]: <msg>` to stderr and traps, the same shape `panic` uses above
-- and the same line native's @mdk_oob_msg and the interpreter both print.  The
-- $str rep and $mdk_eprint_str are demanded for `indexError` in the catalog.
emitLeafExternRef prog env d "indexError" [msg] =
  wasmTrapBytes (progEmit prog) "runtime error [E-INDEX-OOB]: "
    ++ emitRefExpr prog env d msg
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_eprint_str" 1]
    ++ trapByteInstr (progEmit prog) 10
    ++ ["unreachable"]
emitLeafExternRef prog env d "indexError" _ =
  gapLP prog "wasm Index-16a: indexError takes exactly one argument"
-- #1787: `indexErrorAt idx` raises E-INDEX-OOB naming the offending index, so all
-- three engines print the SAME line.  Dropping it here instead (as sliceError's
-- bounds still are) would redden test/wasm/diff_wasm_modules.sh, which since #531
-- compares stderr and exit code as well as stdout -- w7_array_oob.mdk exists to
-- assert exactly this parity.
emitLeafExternRef prog env d "indexErrorAt" [idx] =
  wasmTrapNum
    (progEmit prog)
    "E-INDEX-OOB"
    "index "
    (emitRefExpr prog env d idx)
    " out of bounds"
emitLeafExternRef prog env d "indexErrorAt" _ =
  gapLP prog "wasm #1787: indexErrorAt takes exactly one argument"
emitLeafExternRef prog env d "indexErrorAtSite" [site, idx] =
  siteExprInstrs prog env d site
    ++ emitLeafExternRef prog env d "indexErrorAt" [idx]
emitLeafExternRef prog env d "indexErrorAtSite" _ =
  gapLP prog "wasm: indexErrorAtSite takes exactly two arguments"
emitLeafExternRef prog env d "panicAt" [site, msg] =
  siteExprInstrs prog env d site ++ emitLeafExternRef prog env d "panic" [msg]
emitLeafExternRef prog env d "__site__" [CLit (LString f), CLit (LInt line), CLit (LInt col)] =
  emitLitRef
    prog
    (LInt (sitePackedW (progEmit prog) (Loc f line col line (col + 1))))
emitLeafExternRef prog env d "__site__" _ =
  gapLP prog "wasm: a trap-site literal takes a file, a line and a column"
emitLeafExternRef prog env d "panicAt" _ =
  gapLP prog "wasm: panicAt takes exactly two arguments"
-- #670: `sliceError lo hiIncl` reuses the existing coded E-SLICE-OOB trap (the
-- same fixed text the built-in slice path emits) -- both bound arguments are
-- dropped, where native's @mdk_slice_oob formats them into the line.
emitLeafExternRef prog env d "sliceError" [lo, hi] =
  wasmTrap (progEmit prog) "E-SLICE-OOB" "slice out of bounds"
emitLeafExternRef prog env d "sliceError" _ =
  gapLP prog "wasm #670: sliceError takes exactly two arguments"
-- The `int`-prefixed bit externs are the originals under unshadowable names.
emitLeafExternRef prog env d "intBitAnd" args =
  emitLeafExternRef prog env d "bitAnd" args
emitLeafExternRef prog env d "intBitOr" args =
  emitLeafExternRef prog env d "bitOr" args
emitLeafExternRef prog env d "intBitXor" args =
  emitLeafExternRef prog env d "bitXor" args
emitLeafExternRef prog env d "intBitNot" args =
  emitLeafExternRef prog env d "bitNot" args
emitLeafExternRef prog env d "intShiftLeft" args =
  emitLeafExternRef prog env d "shiftLeft" args
emitLeafExternRef prog env d "intShiftRight" args =
  emitLeafExternRef prog env d "shiftRight" args
-- stage-A: bitwise / shift externs (Int -> Int -> Int).  Args are (ref eq) boxed Ints;
-- unbox both to i64 via $mdk_unbox_int, apply the i64 op, rebox via $mdk_box_int.
-- The shifts call `$mdk_shift_left`/`$mdk_shift_right` (intRuntimeLines), which
-- define every amount as native's mdk_shift_left/right do: a negative amount panics,
-- 63 or more shifts every bit out, and shiftRight is arithmetic.  shiftLeft's bits
-- past bit 62 are dropped by $mdk_box_int's sign-extend, as native's retag drops them.
emitLeafExternRef prog env d "bitAnd" [a, b] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d b
    ++ [unboxIntW prog]
    ++ ["i64.and", boxIntW prog]
emitLeafExternRef prog env d "bitAnd" _ =
  gapLP prog "wasm stage-A: bitAnd takes exactly two arguments"
emitLeafExternRef prog env d "shiftLeft" [a, b] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d b
    ++ [unboxIntW prog]
    ++ intShiftCall prog "left"
    ++ [boxIntW prog]
emitLeafExternRef prog env d "shiftLeft" _ =
  gapLP prog "wasm stage-A: shiftLeft takes exactly two arguments"
emitLeafExternRef prog env d "shiftRight" [a, b] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d b
    ++ [unboxIntW prog]
    ++ intShiftCall prog "right"
    ++ [boxIntW prog]
emitLeafExternRef prog env d "shiftRight" _ =
  gapLP prog "wasm stage-A: shiftRight takes exactly two arguments"
-- #101: bitwise completion (mirror llvm mdk_bit_or/xor/not).  bitOr/bitXor are exact
-- i64 two's-complement ops; bitNot n = n xor -1 (== ~n = -n-1, matches native mdk_bit_not
-- for all in-range Ints).  intBitsToFloat reinterprets the unboxed i64 bit pattern as f64.
emitLeafExternRef prog env d "bitOr" [a, b] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d b
    ++ [unboxIntW prog]
    ++ ["i64.or", boxIntW prog]
emitLeafExternRef prog env d "bitXor" [a, b] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog]
    ++ emitRefExpr prog env d b
    ++ [unboxIntW prog]
    ++ ["i64.xor", boxIntW prog]
emitLeafExternRef prog env d "bitNot" [a] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog, "i64.const -1", "i64.xor", boxIntW prog]
emitLeafExternRef prog env d "intBitsToFloat" [a] =
  emitRefExpr prog env d a
    ++ [unboxIntW prog, "f64.reinterpret_i64", "struct.new $float"]
-- `u8Truncate`/`u16Truncate`/`u32Truncate` keep the low n bits of the Int (a
-- non-negative result, so a U32 above 2^30 reboxes into `$boxint`); the `ToInt`
-- forms are the identity on the word.
emitLeafExternRef prog env d "u8Truncate" [a] =
  emitTruncateRef prog env d "U8" a
emitLeafExternRef prog env d "u16Truncate" [a] =
  emitTruncateRef prog env d "U16" a
emitLeafExternRef prog env d "u32Truncate" [a] =
  emitTruncateRef prog env d "U32" a
emitLeafExternRef prog env d "u8ToInt" [a] = emitRefExpr prog env d a
emitLeafExternRef prog env d "u16ToInt" [a] = emitRefExpr prog env d a
emitLeafExternRef prog env d "u32ToInt" [a] = emitRefExpr prog env d a
-- `i32Truncate` sign-extends the Int's low 32 bits, so a negative `I32` stays an
-- i31 or `$boxint` word like any Int; `i32ToInt` is the identity on that word.
emitLeafExternRef prog env d "i32Truncate" [a] =
  emitRefExpr prog env d a ++ [unboxIntW prog, "i64.extend32_s", boxIntW prog]
emitLeafExternRef prog env d "i32ToInt" [a] = emitRefExpr prog env d a
-- the `I64` doors keep the 64 bits and change the cell they are read from.
emitLeafExternRef prog env d "i64FromBits" [a] =
  emitRefExpr prog env d a ++ unboxU64W ++ ["struct.new $i64"]
emitLeafExternRef prog env d "i64ToBits" [a] =
  emitRefExpr prog env d a ++ unboxI64W ++ ["struct.new $u64"]
-- `u64Truncate` boxes the Int's sign-extended i64, which is its value modulo
-- 2^64; `u64TruncateToInt` reboxes the payload as an Int, and `$mdk_box_int`'s
-- renormalization from bit 62 is exactly "the low 63 bits, bit 62 the sign".
emitLeafExternRef prog env d "u64Truncate" [a] =
  emitRefExpr prog env d a ++ [unboxIntW prog, "struct.new $u64"]
emitLeafExternRef prog env d "u64TruncateToInt" [a] =
  emitRefExpr prog env d a ++ unboxU64W ++ [boxIntW prog]
emitLeafExternRef prog env d "u64BitAnd" [a, b] =
  emitU64KernelRef prog env d a b "i64.and"
emitLeafExternRef prog env d "u64BitOr" [a, b] =
  emitU64KernelRef prog env d a b "i64.or"
emitLeafExternRef prog env d "u64BitXor" [a, b] =
  emitU64KernelRef prog env d a b "i64.xor"
emitLeafExternRef prog env d "u64MulHigh" [a, b] =
  emitU64KernelRef prog env d a b (rtCallW prog "mdk_u64_mulhi" 2)
emitLeafExternRef prog env d "u64ShiftLeft" [a, k] =
  emitU64ShiftRef prog env d a k (rtCallW prog "mdk_u64_shl" 2)
emitLeafExternRef prog env d "u64ShiftRight" [a, k] =
  emitU64ShiftRef prog env d a k (rtCallW prog "mdk_u64_shr" 2)
-- #101: libm math externs.  IEEE-exact unary ops → native f64 opcodes (correctly-rounded,
-- byte-match native libm); round → $mdk_round (C round(): half away from zero);
-- transcendentals → JS Math.* host imports; binary pow/atan2/hypot → host imports;
-- floatRem → $mdk_float_rem (WAT fmod, floatRemRuntimeLines).  A $float is
-- unboxed to f64, the op runs, the f64 result reboxes into a fresh (struct $float).
emitLeafExternRef prog env d "sqrt" [a] =
  floatArgW prog env d a ++ ["f64.sqrt", "struct.new $float"]
emitLeafExternRef prog env d "floor" [a] =
  floatArgW prog env d a ++ ["f64.floor", "struct.new $float"]
emitLeafExternRef prog env d "ceil" [a] =
  floatArgW prog env d a ++ ["f64.ceil", "struct.new $float"]
emitLeafExternRef prog env d "trunc" [a] =
  floatArgW prog env d a ++ ["f64.trunc", "struct.new $float"]
emitLeafExternRef prog env d "round" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_round" 1, "struct.new $float"]
emitLeafExternRef prog env d "cbrt" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_cbrt" 1, "struct.new $float"]
emitLeafExternRef prog env d "exp" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_exp" 1, "struct.new $float"]
emitLeafExternRef prog env d "log" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_log" 1, "struct.new $float"]
emitLeafExternRef prog env d "log2" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_log2" 1, "struct.new $float"]
emitLeafExternRef prog env d "log10" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_log10" 1, "struct.new $float"]
emitLeafExternRef prog env d "sin" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_sin" 1, "struct.new $float"]
emitLeafExternRef prog env d "cos" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_cos" 1, "struct.new $float"]
emitLeafExternRef prog env d "tan" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_tan" 1, "struct.new $float"]
emitLeafExternRef prog env d "asin" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_asin" 1, "struct.new $float"]
emitLeafExternRef prog env d "acos" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_acos" 1, "struct.new $float"]
emitLeafExternRef prog env d "atan" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_atan" 1, "struct.new $float"]
emitLeafExternRef prog env d "sinh" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_sinh" 1, "struct.new $float"]
emitLeafExternRef prog env d "cosh" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_cosh" 1, "struct.new $float"]
emitLeafExternRef prog env d "tanh" [a] =
  floatArgW prog env d a ++ [rtCallW prog "mdk_tanh" 1, "struct.new $float"]
emitLeafExternRef prog env d "pow" [a, b] =
  floatArgW prog env d a
    ++ floatArgW prog env d b
    ++ [rtCallW prog "mdk_pow" 2, "struct.new $float"]
emitLeafExternRef prog env d "atan2" [a, b] =
  floatArgW prog env d a
    ++ floatArgW prog env d b
    ++ [rtCallW prog "mdk_atan2" 2, "struct.new $float"]
emitLeafExternRef prog env d "hypot" [a, b] =
  floatArgW prog env d a
    ++ floatArgW prog env d b
    ++ [rtCallW prog "mdk_hypot" 2, "struct.new $float"]
emitLeafExternRef prog env d "floatRem" [a, b] =
  floatArgW prog env d a
    ++ floatArgW prog env d b
    ++ [rtCallW prog "mdk_float_rem" 2, "struct.new $float"]
emitLeafExternRef prog _ _ name _ =
  gapLP prog ("wasm W8: unsupported leaf extern '" ++ name ++ "'")

-- #101: unbox a boxed $float argument to a raw f64 on the WAT stack.  Shared by every
-- libm math arm above (unary opcode, host-import transcendental, and binary).
floatArgW : Prog -> Env -> Int -> CExpr -> List String
floatArgW prog env d a =
  emitRefExpr prog env d a ++ ["ref.cast (ref $float)", "struct.get $float 0"]

-- ── W10: Array intrinsic externs ─────────────────────────────────────────────
-- All work over `$arr = (array (mut (ref eq)))`.  Index/size args are i31 Ints
-- (unboxed to i32); element args are (ref eq).  NOTE the arg orders (runtime.mdk):
--   arrayLength    arr               → array.len → i31
--   arrayGetUnsafe idx arr           → (idx FIRST) cast arr, array.get
--   arrayMake      size init         → array.new $arr (init, size)
--   arrayMakeWith  size f            → alloc size, loop i: array.set (f applied to i)
--   arrayCopy      arr               → array.new (len) + array.copy
--   arraySetUnsafe idx val arr       → array.set; result Unit (i31 0)
--   arrayFromList  list              → alloc (length list), loop-fill from cons cells
emitArrayExternRef : Prog -> Env -> Int -> String -> List CExpr -> List String
emitArrayExternRef prog env d "arrayLength" [a] =
  emitRefExpr prog env d a ++ ["ref.cast (ref $arr)", "array.len", "ref.i31"]
emitArrayExternRef prog env d "arrayLength" _ =
  gapLP prog "wasm W10: arrayLength takes exactly one argument"
-- idx is the FIRST arg, the array the SECOND.  Cast arr, unbox idx, array.get.
emitArrayExternRef prog env d "arrayGetUnsafe" [i, a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)"]
    ++ emitRefExpr prog env d i
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ ["array.get $arr", "ref.as_non_null"]
emitArrayExternRef prog env d "arrayGetUnsafe" _ =
  gapLP prog "wasm W10: arrayGetUnsafe takes exactly two arguments"
-- size FIRST, init SECOND.  array.new takes (init, size) from the stack.
emitArrayExternRef prog env d "arrayMake" [n, init] =
  emitRefExpr prog env d init
    ++ emitRefExpr prog env d n
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ ["array.new $arr"]
emitArrayExternRef prog env d "arrayMake" _ =
  gapLP prog "wasm W10: arrayMake takes exactly two arguments"
emitArrayExternRef prog env d "arrayCopy" [a] =
  let sfx = intToString d
  let srcL = w7Local (progEmit prog) "__aexarr" sfx
  let dstL = w7Local (progEmit prog) "__raarr" sfx
  let nL = w7Local (progEmit prog) "__aexn" sfx
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)", "local.set " ++ srcL]
    ++ [
      "local.get " ++ srcL,
      "ref.as_non_null",
      "array.len",
      "local.set " ++ nL,
    ]
    ++ [
      "i32.const 0",
      "ref.i31",
      "local.get " ++ nL,
      "array.new $arr",
      "local.set " ++ dstL,
    ]
    ++ [
      "local.get " ++ dstL,
      "ref.as_non_null",
      "i32.const 0",
      "local.get " ++ srcL,
      "ref.as_non_null",
      "i32.const 0",
      "local.get " ++ nL,
      "array.copy $arr $arr",
    ]
    ++ ["local.get " ++ dstL, "ref.as_non_null"]
emitArrayExternRef prog env d "arrayCopy" _ =
  gapLP prog "wasm W10: arrayCopy takes exactly one argument"
-- idx, val, arr.  array.set takes (arrayref, index, value); result Unit (i31 0).
emitArrayExternRef prog env d "arraySetUnsafe" [i, v, a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)"]
    ++ emitRefExpr prog env d i
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ emitRefExpr prog env d v
    ++ ["array.set $arr", "i32.const 0", "ref.i31"]
emitArrayExternRef prog env d "arraySetUnsafe" _ =
  gapLP prog "wasm W10: arraySetUnsafe takes exactly three arguments"
-- size FIRST, f SECOND.  Alloc size slots (init 0), then loop i=0..n-1:
-- array.set arr i (apply f [i]).  f is applied via the universal $__mdk_apply.
emitArrayExternRef prog env d "arrayMakeWith" [n, f] =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__aexarr" sfx
  let iL = w7Local (progEmit prog) "__aexi" sfx
  let nL = w7Local (progEmit prog) "__aexn" sfx
  let fL = w7Local (progEmit prog) "__aexf" sfx
  emitRefExpr prog env d n
    ++ ["ref.cast (ref i31)", "i31.get_s", "local.set " ++ nL]
    ++ emitRefExpr prog env d f
    ++ ["local.set " ++ fL]
    ++ [
      "i32.const 0",
      "ref.i31",
      "local.get " ++ nL,
      "array.new $arr",
      "local.set " ++ arrL,
    ]
    ++ ["i32.const 0", "local.set " ++ iL]
    ++ ["block $aexd" ++ sfx, "loop $aexl" ++ sfx]
    ++ [
      "local.get " ++ iL,
      "local.get " ++ nL,
      "i32.ge_s",
      "br_if $aexd" ++ sfx,
    ]
    ++ ["local.get " ++ arrL, "ref.as_non_null", "local.get " ++ iL]
    -- value = f applied to (i31 i): build a 1-element $argarr, call $__mdk_apply
    ++ [
      "local.get " ++ fL,
      "local.get " ++ iL,
      "ref.i31",
      "array.new_fixed $argarr 1",
      rtCallW prog "__mdk_apply" 2,
    ]
    ++ ["array.set $arr"]
    ++ ["local.get " ++ iL, "i32.const 1", "i32.add", "local.set " ++ iL]
    ++ ["br $aexl" ++ sfx, "end", "end"]
    ++ ["local.get " ++ arrL, "ref.as_non_null"]
emitArrayExternRef prog env d "arrayMakeWith" _ =
  gapLP prog "wasm W10: arrayMakeWith takes exactly two arguments"
-- count the list (a $C_Cons chain ending in an i31 Nil), alloc that many slots,
-- walk the chain again filling cells in order.  Two-pass over a $C_Cons cursor.
emitArrayExternRef prog env d "arrayFromList" [lst] =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__aexarr" sfx
  let iL = w7Local (progEmit prog) "__aexi" sfx
  let nL = w7Local (progEmit prog) "__aexn" sfx
  let curL = w7Local (progEmit prog) "__aexlst" sfx
  -- pass 1: length.  cursor = lst; while not i31: n++, cursor = tail.
  emitRefExpr prog env d lst
    ++ ["local.set " ++ curL]
    ++ ["i32.const 0", "local.set " ++ nL]
    ++ ["block $aexcd" ++ sfx, "loop $aexcl" ++ sfx]
    ++ ["local.get " ++ curL, "ref.test (ref i31)", "br_if $aexcd" ++ sfx]
    ++ ["local.get " ++ nL, "i32.const 1", "i32.add", "local.set " ++ nL]
    ++ [
      "local.get " ++ curL,
      "ref.cast (ref $C_Cons)",
      "struct.get $C_Cons 2",
      "local.set " ++ curL,
    ]
    ++ ["br $aexcl" ++ sfx, "end", "end"]
    -- alloc n slots
    ++ [
      "i32.const 0",
      "ref.i31",
      "local.get " ++ nL,
      "array.new $arr",
      "local.set " ++ arrL,
    ]
    -- pass 2: fill.  cursor = lst; i = 0; while not i31: set arr[i]=head, i++, cursor=tail.
    ++ emitRefExpr prog env d lst
    ++ ["local.set " ++ curL]
    ++ ["i32.const 0", "local.set " ++ iL]
    ++ ["block $aexfd" ++ sfx, "loop $aexfl" ++ sfx]
    ++ ["local.get " ++ curL, "ref.test (ref i31)", "br_if $aexfd" ++ sfx]
    ++ ["local.get " ++ arrL, "ref.as_non_null", "local.get " ++ iL]
    ++ ["local.get " ++ curL, "ref.cast (ref $C_Cons)", "struct.get $C_Cons 1"]
    ++ ["array.set $arr"]
    ++ ["local.get " ++ iL, "i32.const 1", "i32.add", "local.set " ++ iL]
    ++ [
      "local.get " ++ curL,
      "ref.cast (ref $C_Cons)",
      "struct.get $C_Cons 2",
      "local.set " ++ curL,
    ]
    ++ ["br $aexfl" ++ sfx, "end", "end"]
    ++ ["local.get " ++ arrL, "ref.as_non_null"]
emitArrayExternRef prog env d "arrayFromList" _ =
  gapLP prog "wasm W10: arrayFromList takes exactly one argument"
-- stage-A: arrayBlit src srcOff dst dstOff len — copies `len` elements from src[srcOff..]
-- into dst[dstOff..] using `array.copy $arr $arr`.  Arg order from runtime.mdk: src, srcOff,
-- dst, dstOff, len.  Wasm array.copy takes: [dst, dstOff, src, srcOff, len] (all i32).
-- Int args (offsets/len) are i31 small ints; unbox with i31.get_s to i32.  Result = Unit.
emitArrayExternRef prog env d "arrayBlit" [src, srcOff, dst, dstOff, len] =
  emitRefExpr prog env d dst
    ++ ["ref.cast (ref $arr)"]
    ++ emitRefExpr prog env d dstOff
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ emitRefExpr prog env d src
    ++ ["ref.cast (ref $arr)"]
    ++ emitRefExpr prog env d srcOff
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ emitRefExpr prog env d len
    ++ ["ref.cast (ref i31)", "i31.get_s"]
    ++ ["array.copy $arr $arr", "i32.const 0", "ref.i31"]
emitArrayExternRef prog env d "arrayBlit" _ =
  gapLP prog "wasm stage-A: arrayBlit takes exactly five arguments"
-- stage-A: arrayFill val arr — sets every element of arr to val via a loop.
-- Uses the $__aex* W7 scratch locals (w7Local).
emitArrayExternRef prog env d "arrayFill" [val, arr] =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__aexarr" sfx
  let iL = w7Local (progEmit prog) "__aexi" sfx
  let nL = w7Local (progEmit prog) "__aexn" sfx
  let vL = w7Local (progEmit prog) "__aexv" sfx
  emitRefExpr prog env d arr
    ++ ["ref.cast (ref $arr)", "local.set " ++ arrL]
    ++ [
      "local.get " ++ arrL,
      "ref.as_non_null",
      "array.len",
      "local.set " ++ nL,
    ]
    ++ emitRefExpr prog env d val
    ++ ["local.set " ++ vL]
    ++ ["i32.const 0", "local.set " ++ iL]
    ++ ["block $afld" ++ sfx, "loop $afll" ++ sfx]
    ++ [
      "local.get " ++ iL,
      "local.get " ++ nL,
      "i32.ge_s",
      "br_if $afld" ++ sfx,
    ]
    ++ [
      "local.get " ++ arrL,
      "ref.as_non_null",
      "local.get " ++ iL,
      "local.get " ++ vL,
    ]
    ++ ["array.set $arr"]
    ++ ["local.get " ++ iL, "i32.const 1", "i32.add", "local.set " ++ iL]
    ++ ["br $afll" ++ sfx, "end", "end"]
    ++ ["i32.const 0", "ref.i31"]
emitArrayExternRef prog env d "arrayFill" _ =
  gapLP prog "wasm stage-A: arrayFill takes exactly two arguments"
-- stage-B: floatToBytes64 : Float -> Array Int — reinterpret the boxed $float's f64 to
-- an i64 via i64.reinterpret_f64, then extract 8 bytes BIG-ENDIAN (byte 0 = bits>>56,
-- byte 7 = bits&0xFF) into a fresh 8-element $arr, each byte a boxed Int.  Matches
-- runtime/medaka_rt.c:mdk_float_to_bytes64 exactly (cell[i+1] = byte at (bits>>(8*(7-i)))&0xFF).
emitArrayExternRef prog env d "floatToBytes64" [f] =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__aexarr" sfx
  let bitsL = w7Local (progEmit prog) "__aexbits" sfx
  emitRefExpr prog env d f
    ++ [
      "ref.cast (ref $float)",
      "struct.get $float 0",
      "i64.reinterpret_f64",
      "local.set " ++ bitsL,
    ]
    -- alloc 8 slots (placeholder element, overwritten below)
    ++ [
      "i32.const 0",
      "ref.i31",
      "i32.const 8",
      "array.new $arr",
      "local.set " ++ arrL,
    ]
    ++ flatMap (i => f2bByteSet prog arrL bitsL i) [0, 1, 2, 3, 4, 5, 6, 7]
    ++ ["local.get " ++ arrL, "ref.as_non_null"]
emitArrayExternRef prog env d "floatToBytes64" _ =
  gapLP prog "wasm stage-B: floatToBytes64 takes exactly one argument"
-- stage-B: bytesToFloat64 : Array Int -> Int -> Float — read 8 bytes BIG-ENDIAN from the
-- $arr starting at index `off`, assemble an i64 (byte at off+0 → bits 56..63), then
-- f64.reinterpret_i64 + box into a $float.  Matches runtime/medaka_rt.c:mdk_bytes_to_float64.
emitArrayExternRef prog env d "bytesToFloat64" [arr, off] =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__aexarr" sfx
  let offL = w7Local (progEmit prog) "__aexi" sfx
  let bitsL = w7Local (progEmit prog) "__aexbits" sfx
  emitRefExpr prog env d arr
    ++ ["ref.cast (ref $arr)", "local.set " ++ arrL]
    ++ emitRefExpr prog env d off
    ++ ["ref.cast (ref i31)", "i31.get_s", "local.set " ++ offL]
    ++ ["i64.const 0", "local.set " ++ bitsL]
    ++ flatMap
      (i => b2fByteRead prog arrL offL bitsL i)
      [0, 1, 2, 3, 4, 5, 6, 7]
    ++ ["local.get " ++ bitsL, "f64.reinterpret_i64", "struct.new $float"]
emitArrayExternRef prog env d "bytesToFloat64" _ =
  gapLP prog "wasm stage-B: bytesToFloat64 takes exactly two arguments"
emitArrayExternRef prog _ _ name _ =
  gapLP prog ("wasm W10: unsupported array extern '" ++ name ++ "'")

-- ── the `ByteBlock` builtin's primitives ──────────────────────────────────
-- A block is a bare `$u8arr`; the four that loop or copy call into
-- byteBlockRuntimeLines, the four that don't are inline.  Arg orders follow
-- stdlib/runtime.mdk (index/size FIRST, block LAST), mirroring the $arr family:
--   byteBlockMake         n            → array.new $u8arr (0, n)
--   byteBlockLength       b            → array.len → i31
--   byteBlockGetUnsafe    i b          → (i FIRST) cast b, array.get_u → i31
--   byteBlockSetUnsafe    i v b        → array.set (low 8 bits of v); result Unit
--   byteBlockCopyUnsafe   n b          → $mdk_bb_copy (a COPY — freeze's engine half)
--   byteBlockBlit         s so d do n  → array.copy (memmove-equivalent; may overlap)
--   byteBlockFromIntArray a            → $mdk_bb_from_int_array
--   byteBlockToIntArray   b            → $mdk_bb_to_int_array
--   byteBlockFromString   s            → $mdk_bb_from_string
--   byteBlockToString     b            → $mdk_bb_to_string
--   byteBlockWriteStdout  b            → $mdk_bb_write_stdout
--   sha256Native          b            → $mdk_sha256
emitByteBlockExternRef : Prog ->
  Env ->
  Int ->
  String ->
  List CExpr ->
  List String
emitByteBlockExternRef prog env d "byteBlockMake" [n] =
  ["i32.const 0"] ++ bbIntArg prog env d n ++ ["array.new $u8arr"]
emitByteBlockExternRef prog env d "byteBlockMake" _ =
  gapLP prog "wasm: byteBlockMake takes exactly one argument"
emitByteBlockExternRef prog env d "byteBlockLength" [b] =
  emitRefExpr prog env d b ++ ["ref.cast (ref $u8arr)", "array.len", "ref.i31"]
emitByteBlockExternRef prog env d "byteBlockLength" _ =
  gapLP prog "wasm: byteBlockLength takes exactly one argument"
emitByteBlockExternRef prog env d "byteBlockGetUnsafe" [i, b] =
  emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)"]
    ++ bbIntArg prog env d i
    ++ ["array.get_u $u8arr", "ref.i31"]
emitByteBlockExternRef prog env d "byteBlockGetUnsafe" _ =
  gapLP prog "wasm: byteBlockGetUnsafe takes exactly two arguments"
-- The i8 slot keeps the low eight bits of the stored i32 on its own, so the
-- explicit mask is what makes the 0..255 domain READABLE here rather than a
-- property of the array type; both agree with native's (unsigned char) cast.
emitByteBlockExternRef prog env d "byteBlockSetUnsafe" [i, v, b] =
  emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)"]
    ++ bbIntArg prog env d i
    ++ bbIntArg prog env d v
    ++ ["i32.const 255", "i32.and"]
    ++ ["array.set $u8arr", "i32.const 0", "ref.i31"]
emitByteBlockExternRef prog env d "byteBlockSetUnsafe" _ =
  gapLP prog "wasm: byteBlockSetUnsafe takes exactly three arguments"
emitByteBlockExternRef prog env d "byteBlockCopyUnsafe" [n, b] =
  bbIntArg prog env d n
    ++ emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)", rtCallW prog "mdk_bb_copy" 2]
emitByteBlockExternRef prog env d "byteBlockCopyUnsafe" _ =
  gapLP prog "wasm: byteBlockCopyUnsafe takes exactly two arguments"
-- array.copy takes (dst, dstOff, src, srcOff, len), so the destination operands
-- are pushed before the source ones even though the extern's argument order is
-- source-first; `byteBlockSetUnsafe` above reorders for the same reason.  The
-- copy is overlap-safe by the WasmGC spec, matching native's memmove.
emitByteBlockExternRef prog env d "byteBlockBlit" [src, srcOff, dst, dstOff, len] =
  emitRefExpr prog env d dst
    ++ ["ref.cast (ref $u8arr)"]
    ++ bbIntArg prog env d dstOff
    ++ emitRefExpr prog env d src
    ++ ["ref.cast (ref $u8arr)"]
    ++ bbIntArg prog env d srcOff
    ++ bbIntArg prog env d len
    ++ ["array.copy $u8arr $u8arr", "i32.const 0", "ref.i31"]
emitByteBlockExternRef prog env d "byteBlockBlit" _ =
  gapLP prog "wasm: byteBlockBlit takes exactly five arguments"
emitByteBlockExternRef prog env d "byteBlockFromIntArray" [a] =
  emitRefExpr prog env d a
    ++ ["ref.cast (ref $arr)", rtCallW prog "mdk_bb_from_int_array" 1]
emitByteBlockExternRef prog env d "byteBlockFromIntArray" _ =
  gapLP prog "wasm: byteBlockFromIntArray takes exactly one argument"
emitByteBlockExternRef prog env d "byteBlockToIntArray" [b] =
  emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)", rtCallW prog "mdk_bb_to_int_array" 1]
emitByteBlockExternRef prog env d "byteBlockToIntArray" _ =
  gapLP prog "wasm: byteBlockToIntArray takes exactly one argument"
emitByteBlockExternRef prog env d "byteBlockFromString" [sv] =
  emitRefExpr prog env d sv
    ++ ["ref.cast (ref $str)", rtCallW prog "mdk_bb_from_string" 1]
emitByteBlockExternRef prog env d "byteBlockFromString" _ =
  gapLP prog "wasm: byteBlockFromString takes exactly one argument"
emitByteBlockExternRef prog env d "byteBlockToString" [b] =
  emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)", rtCallW prog "mdk_bb_to_string" 1]
emitByteBlockExternRef prog env d "byteBlockToString" _ =
  gapLP prog "wasm: byteBlockToString takes exactly one argument"
emitByteBlockExternRef prog env d "sha256Native" [b] =
  emitRefExpr prog env d b
    ++ ["ref.cast (ref $u8arr)", rtCallW prog "mdk_sha256" 1]
emitByteBlockExternRef prog env d "sha256Native" _ =
  gapLP prog "wasm: sha256Native takes exactly one argument"
-- byteBlockWriteStdout: writes the block's bytes to stdout byte-for-byte via
-- the same $mdk_write_byte host import putStr's $mdk_print_str loop uses,
-- then returns Unit -- the operand is a $u8arr, so this dispatches through
-- the byte-block family rather than the WasmStr family's $str-typed IO externs.
emitByteBlockExternRef prog env d "byteBlockWriteStdout" [b] =
  emitRefExpr prog env d b
    ++ [
      "ref.cast (ref $u8arr)",
      rtCallW prog "mdk_bb_write_stdout" 1,
      "i32.const 0",
      "ref.i31",
    ]
emitByteBlockExternRef prog env d "byteBlockWriteStdout" _ =
  gapLP prog "wasm: byteBlockWriteStdout takes exactly one argument"
emitByteBlockExternRef prog _ _ name _ =
  gapLP prog ("wasm: unsupported byte-block extern '" ++ name ++ "'")

-- An Int argument as a raw i32.  The $arr family takes the i31 fast path, which
-- traps on an Int outside the i31 range; native has no boxed Int at all, so a
-- block index, length, or stored byte built from a large Int would diverge rather
-- than agree.  Route through $mdk_unbox_int (i31 OR $boxint) and narrow.
bbIntArg : Prog -> Env -> Int -> CExpr -> List String
bbIntArg prog env d e =
  emitRefExpr prog env d e ++ [unboxIntW prog, "i32.wrap_i64"]

-- stage-B helpers: set arr[i] = boxed byte ((bits >> (8*(7-i))) & 0xFF); big-endian.
f2bByteSet : Prog -> String -> String -> Int -> List String
f2bByteSet prog arrL bitsL i = [
  "local.get " ++ arrL,
  "ref.as_non_null",
  "i32.const " ++ intToString i,
  "local.get " ++ bitsL,
  "i64.const " ++ intToString (8 * (7 - i)),
  "i64.shr_u",
  "i64.const 255",
  "i64.and",
  boxIntW prog,
  "array.set $arr",
]
-- read arr[off+i] (a boxed Int 0..255), shift to its big-endian position, OR into bits.
b2fByteRead : Prog -> String -> String -> String -> Int -> List String
b2fByteRead prog arrL offL bitsL i = [
  "local.get " ++ arrL,
  "ref.as_non_null",
  "local.get " ++ offL,
  "i32.const " ++ intToString i,
  "i32.add",
  "array.get $arr",
  "ref.as_non_null",
  unboxIntW prog,
  "i64.const 255",
  "i64.and",
  "i64.const " ++ intToString (8 * (7 - i)),
  "i64.shl",
  "local.get " ++ bitsL,
  "i64.or",
  "local.set " ++ bitsL,
]

-- #35 (wasm peer of llvm_emit's emitCtorApp): an APPLIED constructor, dispatched on
-- SATURATION.  This arm must not call `emitCtorConstruct` unconditionally, or an
-- UNDER-applied ctor (`Bin OAdd` for arity-3 `Bin`) emits a `struct.new $S_Bin`
-- with only 1 of its 3 fields on the stack — the identical shape (and identical
-- silent wrong-value miscompile: `check` accepts, `run` is right, `build` is garbage)
-- as the LLVM bug, and the same shape as the pre-W9b bare-ctor bug that
-- emitCtorEtaClosure was introduced to fix.  The eta-wrapper IS the missing piece: an
-- under-applied ctor is just its full-arity eta CLOSURE applied to the args it does
-- have, and `$__mdk_apply` already turns that into a `$mdk_pap` (§4 universal apply:
-- exact / under→PAP / over→saturate+reapply).  So no ctor-specific PAP forwarder is
-- needed here — unlike LLVM, whose call sites take a lifted define, wasm reads arity
-- from the VALUE.  Over-application is unreachable for a well-typed program but falls
-- out of the same path safely.  SATURATED stays `emitCtorConstruct`, byte-identical.
emitCtorApp : Prog -> Env -> Int -> String -> List CExpr -> List String
emitCtorApp prog env d ctor args =
  if listLen args == ctorArity prog ctor then
    emitCtorConstruct prog env d ctor args
  else
    emitCtorEtaClosure prog ctor
      ++ emitArgsArray prog env d args
      ++ [rtCallW prog "__mdk_apply" 2]

-- an indirect application: emit the head (a (ref eq) closure value), pack the args
-- into an $argarr, and `call $__mdk_apply` — which dispatches on the closure's arity
-- (exact / under→PAP / over→saturate+reapply).  This makes over/under/exact uniform
-- and reads arity from the value (never a name-keyed table), per WASMGC-DESIGN §11.
emitIndirectApp : Prog ->
  Env ->
  Int ->
  CExpr ->
  List CExpr ->
  CallEndW ->
  List String
emitIndirectApp prog env d hd args end =
  let hi = emitRefExpr prog env d hd
  let arr = emitArgsArray prog env d args
  hi ++ arr ++ [callFnW prog end "__mdk_apply" 2]

-- How an application's final call is made: for its value, which the code after it
-- consumes, or as the tail call that replaces the enclosing function's frame.
data CallEndW = CallValueW | CallTailW

-- the instruction that makes a call of `$<target>`
callInstrW : CallEndW -> String -> String
callInstrW CallValueW target = "call $" ++ target
callInstrW CallTailW target = "return_call $" ++ target

-- what follows a value an application computes without a call to end on
endValueW : CallEndW -> List String
endValueW CallValueW = []
endValueW CallTailW = ["return"]

-- build an $argarr holding the emitted args, in order.  `array.new_fixed` takes the
-- element values from the stack — so emit all args (each leaves a (ref eq)) then one
-- array.new_fixed of the right length.  Zero args → an empty array.
emitArgsArray : Prog -> Env -> Int -> List CExpr -> List String
emitArgsArray prog env d args =
  let n = listLen args
  let argInstrs = flatMap (a => emitRefExpr prog env d a) args
  argInstrs ++ ["array.new_fixed $argarr " ++ intToString n]

-- ── §4.2 tail-position emission (guaranteed TCO) ─────────────────────────────
-- ════════════════════════════════════════════════════════════════════════════
-- Stage-1 WasmGC self-recursive TMC (destination-passing loop) — WASMGC-TRMC-DESIGN §7
-- ════════════════════════════════════════════════════════════════════════════
-- When a top-level non-dict self-recursive define is `trmcEligible` for the self-only
-- cons/ctor-tail shape (a), we emit the body as a LOOP that conses into a mutable
-- destination cell instead of issuing the stack-growing recursive call.  The
-- destination-passing context (the self-ref, arity, the param locals, the loop/exit
-- labels, the uniform cell struct name + recursive-field index) is carried in a
-- `FnCtx` of the `Prog` the body is emitted with, so tail descent (emitRefTail / emitDecisionTail) can
-- redirect its cons/ctor/base leaves without threading a new argument through every arm.
-- The ENGINE never sees a recursive `call`/`return_call` to the self fn inside the loop
-- (the decisive "TMC fired" property): a cons/ctor leaf builds a cell, struct.sets it
-- into the parent's recursive slot, advances the dest, recomputes the self-call args
-- into the loop's param locals, and `br`s to the loop header.
-- WTrmcOn self arity pslots ctorSet loopLbl exitLbl — `ctorSet` is the fn's
-- distinct (ctorName, selfFieldIdx) leaf-ctor pairs in first-seen clause order.
-- A singleton set emits exactly the historical uniform-ctor code; a MIXED set
-- (P3, TMC-parity arc — LLVM always handled mixed ctors) additionally tracks
-- WHICH ctor the current dest cell is in the i32 local $__tmc_dctor (its index
-- into ctorSet) and link sites dispatch on it (ref.cast to that ctor's struct +
-- struct.set at its recursive field).
-- #712: `isBuiltinList` (the 5th field) records whether this fn's cons leaves are
-- the built-in `h :: t` (→ reserved `$C_Cons`) vs a user ctor named `Cons`
-- (→ `$CU_Cons`).  Homogeneous per fn, so the base leaf's parent-link
-- (emitWasmTrmcBase) reads it from here rather than re-deriving from the ctor name.
-- the loop-local names used by the destination-passing emit.  `$__tmc_head` holds the
-- first cell (the result returned at exit); `$__tmc_dest` holds the cell whose recursive
-- slot the NEXT leaf must fill; `$__tmc_first` is 1 until the first cell is built.
-- `$__tmc_t<k>` are arg-recompute temps (one per param) so an arg may read an old param
-- before any slot is overwritten.
wTrmcHeadL : String
wTrmcHeadL = "$__tmc_head"
wTrmcDestL : String
wTrmcDestL = "$__tmc_dest"
wTrmcFirstL : String
wTrmcFirstL = "$__tmc_first"
wTrmcTempL : Int -> String
wTrmcTempL k = "$__tmc_t" ++ intToString k
wTrmcDctorL : String
wTrmcDctorL = "$__tmc_dctor"

-- Emit `body` in TAIL position of the enclosing function.  Descends into the tails
-- of if/let/block/decision so the syntactic tail call is found wherever it sits.
-- A tail call emits `return_call` (saturated direct call to a known top-level fn) or
-- `return_call $__mdk_apply` (indirect / non-saturated — the universal apply itself
-- tail-dispatches via return_call_ref).  These are guaranteed constant-stack by the
-- engine (Wasm 3.0 / Node 24).  A NON-call tail leaf emits its value then `return`.
-- Calls to host imports are NOT reachable as tail calls here (IO is W6), so the
-- "never tail a host import" rule is vacuously satisfied this slice.
-- `arity` = the enclosing fn's param count (unused today; kept for symmetry with
-- the LLVM self-call walk).
emitRefTail : Prog -> Env -> Int -> CExpr -> List String
emitRefTail prog env arity e = match (progFnCtx prog).trmc
  WTrmcOn self sarity pslots ctorSet _ loopLbl exitLbl =>
    -- TMC active: descend the structural tail wrappers (if/let/block/decision) with the
    -- context STILL LIVE so their inner leaves re-enter here; redirect every LEAF
    -- (cons/ctor-tail, plain self-call, or base) to the destination-passing emit.
    if isWTrmcWrapper e then
      emitRefTailWrap prog env arity e
    else
      emitWasmTrmcLeaf prog env self sarity pslots ctorSet loopLbl exitLbl e
  WTrmcOff => match (progFnCtx prog).disp
    WDispOn root loopLbl rootArity members =>
      -- Stage-2/3 (b′) active: descend the structural tail wrappers with the dispatch
      -- context LIVE; redirect SPINE cons leaves + base leaves to the dest globals.
      if isWTrmcWrapper e then
        emitRefTailWrap prog env arity e
      else
        emitWDispLeaf prog env root loopLbl rootArity members e
    WDispOff => emitRefTailWrap prog env arity e

-- a (b′) tail leaf: a peeled spine cons `<h1> :: … :: <member> <sat>` → dest-link each
-- cell + return_call the target (the root's inner loop for the root, the member fn
-- itself otherwise — only the root carries a reset wrapper); a saturated tail-call to
-- a group member → ordinary return_call (the dest threads through untouched); any
-- other leaf (base, e.g. `[]`) → close the dest + return $g_tmc_head.
emitWDispLeaf : Prog ->
  Env ->
  String ->
  String ->
  Int ->
  List String ->
  CExpr ->
  List String
emitWDispLeaf prog env root loopLbl rootArity members (e@(CBinPrim "::" _ _ _ _)) =
  match wDispSpineParts prog (f => contains f members) e
    Some (heads, f, args) =>
      emitWDispSpineCons
        prog
        env
        root
        (if f == root then loopLbl else f)
        heads
        args
    None =>
      -- a cons that does not bottom in a saturated group call (the spine terminator
      -- can be a cons onto a non-spine value): group validation guaranteed it is
      -- member-free, so it is a BASE value — close the dest + return the head global.
      emitWDispBase prog env root e
emitWDispLeaf prog env root loopLbl rootArity members other =
  if wDispIsSatRootCall prog root rootArity other then match flattenApp other []
    -- a bare saturated tail-call to root: emit the args + return_call the inner loop
    -- (skip the reset wrapper, which would re-zero the in-flight dest).

    (_, args) =>
      flatMap (a => emitRefExpr prog env 0 a) args
        ++ [callFnW prog CallTailW (gname loopLbl) (listLen args)]
  else match flattenApp other []
    (CVar f0 _, args) =>
      let f = canonFn prog f0
      if isFtSentinel f0 then
        ftSentinelInstrs f0
      else
        emitWDispTailOrBase prog env root members f other
    _ => emitWDispBase prog env root other

-- a non-cons, non-root-bare leaf: an EXACT tail-call to another group member →
-- ordinary return_call (dest untouched; the member's own redirected leaves will close
-- it); anything else → a base value — dest-close.  (An unsaturated or non-member call
-- here cannot thread the dest, so it must terminate the spine as a value.)
emitWDispTailOrBase : Prog ->
  Env ->
  String ->
  List String ->
  String ->
  CExpr ->
  List String
emitWDispTailOrBase prog env root members f e = match appParts e
  (_, _, mode) =>
    if contains f members && isExactCall mode then
      emitAppTail prog env 0 e
    else
      emitWDispBase prog env root e

-- the ordinary tail descent (TMC-inactive, or the wrapper arms while TMC is active).
emitRefTailWrap : Prog -> Env -> Int -> CExpr -> List String
emitRefTailWrap prog env arity (CIf c t f) =
  let ci = emitRefExpr prog env 0 c ++ conditionW prog
  let ti = emitRefTail prog env arity t
  let fi = emitRefTail prog env arity f
  ci ++ ["if"] ++ indent ti ++ ["else"] ++ indent fi ++ ["end", "unreachable"]
emitRefTailWrap prog env arity (CLet recF pat e1 e2) =
  let (prefix, env2) = emitLetBindingW prog env 0 recF pat e1
  prefix ++ emitRefTail prog env2 arity e2
emitRefTailWrap prog env arity (node@(CLetGroup binds body)) =
  valueLines
    (refOnlyValueW prog node (() =>
      emitLetGroupWith
        prog
        env
        0
        (env2 b => emitRefTail prog env2 arity b)
        binds
        body))
emitRefTailWrap prog env arity (CBlock stmts) =
  emitBlockTail prog env arity stmts
emitRefTailWrap prog env arity (node@(CDecision scrut arms tree)) =
  valueLines
    (refOnlyValueW prog node (() =>
      emitDecisionTail prog env arity scrut arms tree))
emitRefTailWrap prog env arity (app@(CApp _ _ _)) =
  emitAppTail prog env arity app
-- a bare fall-through sentinel in tail position lowers to its sentinel instrs (a `br`
-- to the clause label, or a trap) — NOT value+return (the generic CVar arm would
-- append a dead `return` after an unconditional branch, leaving the stack ill-typed).
emitRefTailWrap prog env arity (e@(CVar x _)) =
  if not (rawProgramW prog) && isFtSentinel x then
    ftSentinelInstrs x
  else
    emitRefExpr prog env 0 e ++ ["return"]
emitRefTailWrap prog env arity other =
  emitRefExpr prog env 0 other ++ ["return"]

-- a structural tail WRAPPER (if/let/block/decision) whose tail descends to leaves —
-- vs a LEAF (cons/ctor/self-call/base) that TMC redirects.  These are emitRefTailWrap's
-- wrapper arms less a let-group and a recursive or destructuring let, which TMC
-- takes as a base leaf: computed as a value and stored into the destination.
isWTrmcWrapper : CExpr -> Bool
isWTrmcWrapper (CIf _ _ _) = True
isWTrmcWrapper (CLet False (PVar _ _ _) _ _) = True
isWTrmcWrapper (CLet False PWild _ _) = True
isWTrmcWrapper (CBlock _) = True
isWTrmcWrapper (CDecision _ _ _) = True
isWTrmcWrapper _ = False

-- a TMC tail leaf: an eligible cons/ctor-tail conses into the destination + loops; a
-- bare saturated plain self-call recomputes its args + loops (iterate-on-shorter-list);
-- any other leaf is the BASE — store it into the current destination + exit.
emitWasmTrmcLeaf : Prog ->
  Env ->
  SelfRef ->
  Int ->
  List String ->
  List (String, Int) ->
  String ->
  String ->
  CExpr ->
  List String
emitWasmTrmcLeaf prog env self arity pslots ctorSet loopLbl exitLbl e =
  if isCtorTail (c => isCtor prog c) (c => ctorArity prog c) self arity e then
    -- #712: `ctorTailIsCons e` distinguishes the built-in `h :: t` (reserved
    -- `$C_Cons`) from a user ctor named `Cons` (remapped `$CU_Cons`); a whole TRMC
    -- function's cons-cell leaves are homogeneous (one return type), so this leaf's
    -- verdict also governs the parent link.
    emitWasmTrmcCtor
      prog
      env
      self
      arity
      pslots
      ctorSet
      (ctorTailIsCons e)
      (ctorTailName e)
      (ctorTailSelfIdx e)
      loopLbl
      (ctorTailLeadFields e)
      (consTailArgs e)
  else if isSelfSatApp self arity e then
    emitWasmTrmcTailCall prog env pslots loopLbl e
  else
    emitWasmTrmcBase prog env exitLbl e

-- cons/ctor leaf: build THIS leaf's ctor cell with its NON-recursive (leading) fields
-- + a placeholder in the recursive slot, link it into the parent's recursive slot (or
-- seed $__tmc_head on the first cell), advance the destination to this cell, recompute
-- the self-call args into the loop's param locals, and br to the loop header.  NO
-- recursive call is emitted.
--   • first cell  → $__tmc_head := cell ; $__tmc_first := 0
--   • later cells → struct.set <parent ctor's struct> $__tmc_dest <its selfIdx+1> cell
--     (the PARENT may be a different ctor than this leaf's — wTrmcLinkParent
--     dispatches on $__tmc_dctor when the fn's leaf-ctor set is mixed)
--   • always      → $__tmc_dest := cell (+ record THIS ctor's set-index in
--     $__tmc_dctor when mixed)
-- The recursive slot is `(mut (ref eq))` (Stage 0), seeded here with a safe i31 nil
-- placeholder (never dereferenced — it is overwritten by the next iteration's struct.set,
-- or stays as the cell's tail which the BASE leaf fills before exit).
emitWasmTrmcCtor : Prog ->
  Env ->
  SelfRef ->
  Int ->
  List String ->
  List (String, Int) ->
  Bool ->
  String ->
  Int ->
  String ->
  List CExpr ->
  List CExpr ->
  List String
emitWasmTrmcCtor prog env self arity pslots ctorSet isBuiltinList ctorName selfIdx loopLbl leadFields args =
  let cellStruct = trmcCellStruct isBuiltinList ctorName
  -- #712/S0: a built-in `::` leaf pins the reserved Cons ordinal; a user ctor leaf
  -- keys off the table (declaration order), same split as the cell struct id above.
  let tag =
    ["i32.const " ++ intToString (trmcCellOrdinal isBuiltinList prog ctorName)]
  let leadInstrs = flatMap (a => emitRefExpr prog env 0 a) leadFields
  -- placeholder for the recursive slot (overwritten next iter / by the base leaf).
  let placeholder = ["i32.const 1", "ref.i31"]
  let buildCell =
    tag ++ leadInstrs ++ placeholder ++ ["struct.new $" ++ cellStruct]
  -- stash new cell in temp 0; link into prev dest (or seed head); advance dest := new.
  let stashNew = buildCell ++ ["local.set " ++ wTrmcTempL 0]
  let cellVal = ["local.get " ++ wTrmcTempL 0, "ref.as_non_null"]
  let linkSet = wTrmcLinkParent isBuiltinList ctorSet cellVal
  let linkSeed = [
    "local.get " ++ wTrmcTempL 0,
    "local.set " ++ wTrmcHeadL,
    "i32.const 0",
    "local.set " ++ wTrmcFirstL,
  ]
  let linkInstrs =
    ["local.get " ++ wTrmcFirstL, "if"]
      ++ indent linkSeed
      ++ ["else"]
      ++ indent linkSet
      ++ ["end"]
  let advance =
    ["local.get " ++ wTrmcTempL 0, "local.set " ++ wTrmcDestL]
      ++ wTrmcRecordDctor ctorSet ctorName
  -- recompute the self-call args into temps (an arg may read an old param), then store
  -- into the param slots, then loop.  Args occupy temps 1..arity (temp 0 = the cell).
  -- A dict-carrying (CDict-headed) self-call's args cover only the VALUE params; its
  -- leading dict slots are loop-invariant (identity-forwarded routes, trmc_analysis
  -- dictRoutesForwarded) — store into the LAST |args| slots only (non-dict drops 0).
  let argTemps = wTrmcEmitArgsToTemps prog env args 1
  let storeSlots =
    wTrmcStoreSlots (dropFirstN (listLen pslots - listLen args) pslots) args 1
  stashNew
    ++ linkInstrs
    ++ advance
    ++ argTemps
    ++ storeSlots
    ++ ["br " ++ loopLbl]

-- store `valInstrs` into the CURRENT dest cell's recursive slot.  Singleton
-- leaf-ctor set: the parent's type is static — exactly the historical uniform
-- emit.  Mixed set: dispatch on $__tmc_dctor (the parent ctor's set-index) with
-- an if/else chain; the LAST entry needs no test (the index is exhaustive).
-- #712: the cons-cell struct id for a TRMC leaf.  A built-in `::` leaf is the
-- reserved `$C_Cons`; any user ctor keys off its name via ctorStructName (so a user
-- `Cons` becomes `$CU_Cons`).  A function's TRMC leaves are homogeneous, so one
-- `isBuiltinList` flag governs both the leaf and its parent link.
trmcCellStruct : Bool -> String -> String
trmcCellStruct True _ = "C_Cons"
trmcCellStruct False ctorName = ctorStructName ctorName

-- the cons-cell tag for a TRMC leaf (#712/S0): the reserved list ordinal for a
-- built-in `::` leaf, the table (declaration-order) ordinal for a user ctor leaf.
trmcCellOrdinal : Bool -> Prog -> String -> Int
trmcCellOrdinal True _ ctorName = syntheticCtorOrdinal ctorName
trmcCellOrdinal False prog ctorName = ctorOrdinal prog ctorName

wTrmcLinkParent : Bool -> List (String, Int) -> List String -> List String
wTrmcLinkParent isBuiltinList [(ctorName, selfIdx)] valInstrs =
  wTrmcLinkOne isBuiltinList ctorName selfIdx valInstrs
wTrmcLinkParent isBuiltinList ctorSet valInstrs =
  wTrmcLinkChain isBuiltinList ctorSet 0 valInstrs

wTrmcLinkOne : Bool -> String -> Int -> List String -> List String
wTrmcLinkOne isBuiltinList ctorName selfIdx valInstrs =
  let cellStruct = trmcCellStruct isBuiltinList ctorName
  ["local.get " ++ wTrmcDestL, "ref.cast (ref $" ++ cellStruct ++ ")"]
    ++ valInstrs
    ++ ["struct.set $\{cellStruct} \{intToString (selfIdx + 1)}"]

wTrmcLinkChain : Bool -> List (String, Int) -> Int -> List String -> List String
wTrmcLinkChain _ [] _ _ = []
wTrmcLinkChain isBuiltinList [(ctorName, selfIdx)] _ valInstrs =
  wTrmcLinkOne isBuiltinList ctorName selfIdx valInstrs
wTrmcLinkChain isBuiltinList ((ctorName, selfIdx) :: rest) k valInstrs =
  ["local.get " ++ wTrmcDctorL, "i32.const " ++ intToString k, "i32.eq", "if"]
    ++ indent (wTrmcLinkOne isBuiltinList ctorName selfIdx valInstrs)
    ++ ["else"]
    ++ indent (wTrmcLinkChain isBuiltinList rest (k + 1) valInstrs)
    ++ ["end"]

-- record which ctor the NEW dest cell is (mixed sets only; a singleton set needs
-- no tracking — the parent type is static).
wTrmcRecordDctor : List (String, Int) -> String -> List String
wTrmcRecordDctor [_] _ = []
wTrmcRecordDctor ctorSet ctorName = [
  "i32.const " ++ intToString (wTrmcCtorIndex ctorSet ctorName 0),
  "local.set " ++ wTrmcDctorL,
]

wTrmcCtorIndex : List (String, Int) -> String -> Int -> Int
wTrmcCtorIndex [] _ _ = 0
wTrmcCtorIndex ((n, _) :: rest) ctorName k =
  if n == ctorName then k else wTrmcCtorIndex rest ctorName (k + 1)

-- plain saturated self-call leaf (no cell): recompute args into temps + store into the
-- param slots + br.  Leaves the destination UNCHANGED (the next iter fills the same slot).
emitWasmTrmcTailCall : Prog ->
  Env ->
  List String ->
  String ->
  CExpr ->
  List String
emitWasmTrmcTailCall prog env pslots loopLbl e =
  let (_, args) = flattenApp e []
  -- dict-carrying self-call: skip the loop-invariant leading dict slots (see
  -- emitWasmTrmcCtor); non-dict is |args| == |pslots| ⇒ drop 0.
  let argTemps = wTrmcEmitArgsToTemps prog env args 0
  let storeSlots =
    wTrmcStoreSlots (dropFirstN (listLen pslots - listLen args) pslots) args 0
  argTemps ++ storeSlots ++ ["br " ++ loopLbl]

-- base/other leaf: a value with NO self-call.  Store it into the current destination's
-- recursive slot (or directly into $__tmc_head if no cell was ever built), then br to exit
-- where the function returns $__tmc_head.  Uses $__tmc_first to choose.
emitWasmTrmcBase : Prog -> Env -> String -> CExpr -> List String
emitWasmTrmcBase prog env exitLbl e =
  let valInstrs = emitRefExpr prog env 0 e
  -- if no cell was built, the whole result IS this value → head := value.
  -- else store it into the current dest's recursive slot (the parent ctor's type
  -- is static for a singleton leaf-ctor set; a mixed set dispatches on
  -- $__tmc_dctor — wTrmcLinkParent).  Fetch the set from the ctx.
  match (progFnCtx prog).trmc
    WTrmcOn _ _ _ ctorSet isBuiltinList _ _ =>
      let storeBranch = wTrmcLinkParent isBuiltinList ctorSet valInstrs
      let seedBranch = valInstrs ++ ["local.set " ++ wTrmcHeadL]
      ["local.get " ++ wTrmcFirstL, "if"]
        ++ indent seedBranch
        ++ ["else"]
        ++ indent storeBranch
        ++ ["end", "br " ++ exitLbl]
    WTrmcOff => valInstrs ++ ["return"]

-- recompute each self-call arg into its temp local ($__tmc_t<base+k>), left-to-right.
wTrmcEmitArgsToTemps : Prog -> Env -> List CExpr -> Int -> List String
wTrmcEmitArgsToTemps prog env args base = wTrmcArgsGo prog env args base 0

wTrmcArgsGo : Prog -> Env -> List CExpr -> Int -> Int -> List String
wTrmcArgsGo _ _ [] _ _ = []
wTrmcArgsGo prog env (a :: rest) base k =
  emitRefExpr prog env 0 a
    ++ ["local.set " ++ wTrmcTempL (base + k)]
    ++ wTrmcArgsGo prog env rest base (k + 1)

-- store each recomputed temp into the matching param slot ($a<i>), left-to-right.
wTrmcStoreSlots : List String -> List CExpr -> Int -> List String
wTrmcStoreSlots pslots args base = wTrmcStoreGo pslots args base 0

wTrmcStoreGo : List String -> List CExpr -> Int -> Int -> List String
wTrmcStoreGo [] _ _ _ = []
wTrmcStoreGo _ [] _ _ = []
wTrmcStoreGo (p :: ps) (_ :: as_) base k =
  [
      "local.get " ++ wTrmcTempL (base + k),
      "ref.as_non_null",
      "local.set $" ++ gname p,
    ]
    ++ wTrmcStoreGo ps as_ base (k + 1)

-- ── the Stage-1 driver: decide eligibility + emit the destination-passing loop ──
-- Returns `Some fnDef` when the plan's verdict (`EmitPlan.trmc`) holds `name`: a
-- top-level self-recursive define that is `trmcEligible` for the self-only
-- cons/ctor-tail shape (a).  Dict-carrying defines (every unannotated polymorphic
-- builder — F2(b) shape (a)) are admitted when the leading-dict count is uniform
-- across clauses; the
-- emit is arity-keyed and types every param `(ref eq)`, so the dict is just another
-- loop slot.
-- Otherwise `None` → the caller falls back to the ordinary (stack-growing)
-- codegen (no regression).  MIXED leaf ctors are supported (P3, TMC-parity arc):
-- the emit dispatches link sites on the parent cell's ctor; the old uniform-ctor
-- gate (a wasm-only restriction the LLVM backend never had) is retired.
wasmTrmcTry : Prog -> String -> Int -> List CClause -> Option (List String)
wasmTrmcTry prog name arity clauses =
  let self = SelfByVar name
  let pairs = map clauseToPair clauses
  -- Stage-1b: a multi-clause fn whose params carry list/ctor PATTERNS (the
  -- `stripComments` {cons-tail + plain-tail-drop + base} shape) is NOW admitted —
  -- emitWasmTrmcFn routes it through the clause-dispatch chain (emitClauseChainGo)
  -- with the TMC context live, so each clause's tail leaf is TMC-aware (cons-into-dest,
  -- plain-tail-drop+loop, base+exit) instead of the stack-growing recursive call the
  -- ordinary emitClausesRef path emits.  All-PVar single/multi-clause stays the fast
  -- direct-body path.  (Mirrors llvm_emit's trmcTryFn forceSingle=False / emitClauseTree
  -- reuse.)
  if isTrmcFn (progTrmcW prog) name then
    Some
      (emitWasmTrmcFn
        prog
        name
        arity
        clauses
        (wTrmcCtorSet prog self arity pairs))
  else
    None

clauseToPair : CClause -> (List Pat, CExpr)
clauseToPair (CClause pats body) = (pats, body)

-- Phase 2 B-dispatch (mirror of llvm_emit.trmcImplTry): a DISPATCHED self-recursive
-- cons/ctor-tail IMPL method (the `List` Functor `map`: `map f (x::xs) = f x :: map f xs`,
-- recursing via a `CMethod method (RKey tag)` node) is emitted as an O(1)-stack
-- destination-passing loop, just like a top-level builder.  Without this the ordinary
-- impl-body emit lowers the self-call as a `call $mdk_impl_<tag>_<method>` inside the
-- cons args (the frame stays live → deep lists overflow V8's stack).
--
-- The self-ref is `SelfByMethod method tag` (the self-call head is `CMethod method
-- (RKey tag)`, NOT a `CVar`).  SAFETY-CRITICAL: `freeVars (CMethod …)` is BLIND to the
-- method NAME — the analysis (`trmcEligible`/`isCtorTail`/`selfFree`) routes the
-- `SelfByMethod` disqualification through `mentionsSelfMethod`, so a body that
-- self-recurses via `CMethod` in a NON-tail position is rejected (stays ordinary) rather
-- than wrongly transformed (dropped recursion → silent miscompile).
--
-- Scope = F2(a) + F2(b) shape (a): NON-eta impls, dicts admitted when the leading-dict
-- count is uniform across clauses.  Returns Some def when eligible (the whole
-- `(func …)` define via emitWasmTrmcCore with the impl symbol + SelfByMethod), else None
-- so emitImplGroup falls back to the ordinary emitClausesImpl body.
-- [key] drives the SelfByMethod self-call recognition: the in-body self route
-- carries the instance's canonical key.
wTrmcImplTry : Prog ->
  String ->
  String ->
  String ->
  Int ->
  List CClause ->
  Option (List String)
wTrmcImplTry prog method key fnName arity clauses =
  let pairs = map clauseToPair clauses
  let self = methodSelf method key (match pairs
    (ps, _) :: _ => ps
    [] => [])
  if isTrmcImpl (progTrmcW prog) method key then
    Some
      (emitWasmTrmcCore
        prog
        fnName
        self
        fnName
        arity
        clauses
        (wTrmcCtorSet prog self arity pairs))
  else
    None

-- the fn's distinct (ctorName, selfFieldIdx) leaf-ctor pairs, in first-seen
-- clause/leaf order (deterministic).  Cons-tail leaves report ("Cons", 1).
-- trmcEligible guarantees ≥1 cons/ctor-tail leaf, so the set is never empty;
-- Axis-A eligibility puts the self-call in the LAST field, so a ctor's selfIdx
-- is a function of the ctor — dedup by NAME is exact.
wTrmcCtorSet : Prog ->
  SelfRef ->
  Int ->
  List (List Pat, CExpr) ->
  List (String, Int)
wTrmcCtorSet prog self arity pairs =
  wTrmcDedupCtors
    (flatMap (pr => wTrmcCtorTailsOf prog self arity (snd pr)) pairs)
    []

wTrmcDedupCtors : List (String, Int) -> List String -> List (String, Int)
wTrmcDedupCtors [] _ = []
wTrmcDedupCtors ((n, i) :: rest) seen =
  if contains n seen then
    wTrmcDedupCtors rest seen
  else
    (n, i) :: wTrmcDedupCtors rest (n :: seen)

snd : (a, b) -> b
snd (_, b) = b

-- collect the (ctor name, selfIdx) of every cons/ctor-tail leaf reachable through
-- the tail wrappers (if/let/block/decision).  Mirrors trmcBodyHasCons's descent.
wTrmcCtorTailsOf : Prog -> SelfRef -> Int -> CExpr -> List (String, Int)
wTrmcCtorTailsOf prog self arity (CIf _ t f) =
  wTrmcCtorTailsOf prog self arity t ++ wTrmcCtorTailsOf prog self arity f
wTrmcCtorTailsOf prog self arity (CLet _ _ _ b) =
  wTrmcCtorTailsOf prog self arity b
wTrmcCtorTailsOf prog self arity (CBlock stmts) = match lastStmtExpr stmts
  Some ex => wTrmcCtorTailsOf prog self arity ex
  None => []
wTrmcCtorTailsOf prog self arity (CDecision _ arms _) =
  flatMap (a => wTrmcCtorTailsOf prog self arity (armBody a)) arms
wTrmcCtorTailsOf prog self arity ex =
  if isCtorTail (c => isCtor prog c) (c => ctorArity prog c) self arity ex then
    [(ctorTailName ex, ctorTailSelfIdx ex)]
  else
    []

-- #712: the ctor-tail LEAF exprs (same descent as wTrmcCtorTailsOf), so the caller
-- can ask `ctorTailIsCons` per leaf.  Used to decide whether a fn builds the
-- built-in list (`::` → `$C_Cons`) or a user ADT (`$C_<ctor>` / `$CU_Cons`).
wTrmcCtorTailExprs : Prog -> SelfRef -> Int -> CExpr -> List CExpr
wTrmcCtorTailExprs prog self arity (CIf _ t f) =
  wTrmcCtorTailExprs prog self arity t ++ wTrmcCtorTailExprs prog self arity f
wTrmcCtorTailExprs prog self arity (CLet _ _ _ b) =
  wTrmcCtorTailExprs prog self arity b
wTrmcCtorTailExprs prog self arity (CBlock stmts) = match lastStmtExpr stmts
  Some ex => wTrmcCtorTailExprs prog self arity ex
  None => []
wTrmcCtorTailExprs prog self arity (CDecision _ arms _) =
  flatMap (a => wTrmcCtorTailExprs prog self arity (armBody a)) arms
wTrmcCtorTailExprs prog self arity ex =
  if isCtorTail (c => isCtor prog c) (c => ctorArity prog c) self arity ex then
    [ex]
  else
    []

-- whether an eligible TRMC fn's cons leaves are the built-in `h :: t` (homogeneous
-- per fn — a fn returns one type).  Governs the cons-cell struct id (#712).
wTrmcBuildsBuiltinList : Prog -> SelfRef -> Int -> List CClause -> Bool
wTrmcBuildsBuiltinList prog self arity clauses =
  anyList
    ctorTailIsCons
    (flatMap (c => wTrmcCtorTailExprs prog self arity (clauseBodyOf c)) clauses)

-- emit the eligible function as a destination-passing loop.  Scaffold:
--   (func $name (param $a0 …) (result (ref eq))
--     <tmc locals> <clause locals> <scratch> <w7 locals>
--     i32.const 1  local.set $__tmc_first
--     block $tmcexit  loop $tmcloop  <body via emitRefTail under WTrmcOn>  end  end
--     local.get $__tmc_head)
-- Every cons/ctor leaf `br $tmcloop` (no recursive call); the base leaf `br $tmcexit`.
emitWasmTrmcFn : Prog ->
  String ->
  Int ->
  List CClause ->
  List (String, Int) ->
  List String
emitWasmTrmcFn prog name arity clauses ctorSet =
  -- top-level define: the func symbol is `gname name`, the self-ref is `SelfByVar name`,
  -- and `name` doubles as the clause-block label root.
  emitWasmTrmcCore prog (gname name) (SelfByVar name) name arity clauses ctorSet

-- the shared destination-passing-loop emitter for BOTH the top-level path (SelfByVar) and
-- the Phase-2 B-dispatch impl path (SelfByMethod).  `funcSym` is the rendered func symbol
-- (no leading `$`; `gname name` for a top-level fn, the group's symbol for an impl);
-- `self` is the SelfRef the TMC analysis + leaf-emit thread (CVar vs CMethod recognition);
-- `lblRoot` is the clause-block label root (unique per emitted define).
emitWasmTrmcCore : Prog ->
  String ->
  SelfRef ->
  String ->
  Int ->
  List CClause ->
  List (String, Int) ->
  List String
emitWasmTrmcCore prog funcSym self lblRoot arity clauses ctorSet =
  let params = clauseParamNames clauses arity
  let pslots = map gname params
  let loopLbl = "$tmcloop"
  let exitLbl = "$tmcexit"
  let isBuiltinList = wTrmcBuildsBuiltinList prog self arity clauses
  let w7Outer = w7ScopeOpen (progEmit prog)
  let tprog =
    progWithTrmc
      (WTrmcOn self arity pslots ctorSet isBuiltinList loopLbl exitLbl)
      prog
  -- Single all-PVar clause (no fallthrough): the fast path — alias params to the
  -- synthetic positions and TMC-emit the body directly.  Otherwise (multi-clause OR
  -- a clause carries a list/ctor pattern, e.g. `stripComments`/the `map` impl): route
  -- through the clause-dispatch chain (emitClauseChainGo) with the TMC context LIVE, so
  -- each clause's tail leaf is TMC-aware (cons-into-dest / plain-tail-drop+loop / base+exit).
  let bodyLines = match clauses
    [CClause ps b] =>
      if allPlainParams ps && not (exprHasFallthrough b) then
        bindParamAliases prog ps params
          ++ emitRefTail tprog (paramEnv ps) arity b
      else
        emitClauseChainGo
          tprog
          envEmpty
          lblRoot
          params
          arity
          clauses
          0
          (progFnCtx prog).site
    _ =>
      emitClauseChainGo
        tprog
        envEmpty
        lblRoot
        params
        arity
        clauses
        0
        (progFnCtx prog).site
  let loopShell =
    ["i32.const 1", "local.set " ++ wTrmcFirstL]
      ++ ["block " ++ exitLbl, "loop " ++ loopLbl]
      ++ indent bodyLines
      ++ ["end", "end"]
      ++ ["local.get " ++ wTrmcHeadL, "ref.as_non_null"]
  -- locals: the tmc bookkeeping + temps (t0..t_arity), then the ordinary clause/scratch.
  -- a MIXED leaf-ctor set additionally tracks the dest cell's ctor set-index.
  let dctorLocal = match ctorSet
    [_] => []
    _ => ["(local " ++ wTrmcDctorL ++ " i32)"]
  let tmcLocals =
    [
        "(local " ++ wTrmcHeadL ++ " (ref null eq))",
        "(local " ++ wTrmcDestL ++ " (ref null eq))",
        "(local " ++ wTrmcFirstL ++ " i32)",
      ]
      ++ dctorLocal
      ++ map
        (k => "(local " ++ wTrmcTempL k ++ " (ref null eq))")
        (rangeList 0 (arity + 1))
  let allLocals = clauseLocals clauses
  let extraLocals = filterList (notIn params) (dedupKeep allLocals)
  let scratch = scratchLocals (clausesMaxDepth clauses)
  let localDecls = map localDeclRef (extraLocals ++ scratch)
  let w7Decls =
    w7LocalDecls
      (w7ScopeClose (progEmit prog) w7Outer)
      (clausesMaxDepth clauses)
  let _ = defineFnW prog funcSym (FuncParams (listLen params))
  let sig =
    "  (func $\{funcSym}\{joinWith "" (map paramDeclRef params)} (result (ref eq))"
  wTmcMarker funcSym "trmc"
    :: [sig]
      ++ map ("  " ++ _) (tmcLocals ++ localDecls ++ w7Decls)
      ++ indent loopShell
      ++ ["  )"]

-- ════════════════════════════════════════════════════════════════════════════
-- Stage-2/3 WasmGC DISPATCH-GRAPH TMC (shape (b′)) — WASMGC-TRMC-DESIGN §7/§11,
-- BROWSER-STACK-DIAGNOSIS §7 (Stage-3 generalization: pattern-matched roots,
-- member-targeted multi-cell spine conses, external-entry root selection)
-- ════════════════════════════════════════════════════════════════════════════
-- The lexer overflows because each per-token LEAF (`scanLower`/`emit`/…) does
-- `tok :: scan …`: the cons-target is the single dispatcher `scan`, NOT the leaf
-- itself, so the LLVM/Stage-1 self-recursive analysis (`isSelfSatApp self`) never
-- fires across the dispatch boundary.  The cons `scan …` is emitted as a struct.new
-- ARG → the leaf frame stays live to EOF → V8 stack overflow.
--
-- Fix (emitter-only, reuses Stage-1's cons-cell + dest mechanism): identify a "TMC
-- group" = a set of functions tail-connected under an EXTERNAL-ENTRY root `R`
-- (`scan`, the layout family's `layout`), where every tail leaf is either
--   (1) a base case (no call to a group member), or
--   (2) a SPINE cons — a peeled chain of 1..N member-free heads bottoming in a
--       saturated call to ANY group member (the overflow site), or
--   (3) a saturated tail-call to another group member (a dispatcher OR a
--       non-spine self-accumulator like the string-interp `acc++` loops).
-- We then emit `R` as a RESET wrapper that saves and zeroes three module-level dest
-- globals ($g_tmc_head / $g_tmc_dest / $g_tmc_first), calls an inner `R__loop`, and
-- restores them,
-- and we emit every group member with its SPINE cons leaves rewritten to: build each
-- `Cons` cell with a placeholder tail, link it into $g_tmc_dest (or seed $g_tmc_head
-- on the first cell), advance the dest, then `return_call` the bottom callee (`$R__loop`
-- when it is the root — never the reset wrapper — else the member fn itself; a REAL
-- tail call — the leaf frame dies; no struct.new holds the recursion).  A member's
-- base leaf closes the dest with its real value and returns $g_tmc_head.  Dispatcher /
-- self-accumulator tails (case 3) are emitted UNCHANGED (they already `return_call`,
-- and they never touch the dest globals, which thread through transparently).
--
-- This needs NO param-slot recompute loop (unlike Stage-1): the engine's `return_call`
-- IS the loop.  Soundness rests on the root wrapper being the group's only external
-- entry (dispValidate v4): every entry, including a re-entry from inside an in-flight
-- spine, passes through the wrapper, which saves the dest globals, runs its own spine
-- from zeroed ones, and restores them before returning, so the outer spine resumes
-- linking where it left off.

-- (`WDispCtx` rides in the `FnCtx` of the `Prog` a body is emitted with, and
-- `WasmEmit.wDispGroups` carries the detected groups; both live above.)

-- PER-GROUP dest globals (Stage-3): each group root gets its own head/dest/first
-- triple, so one group's spine build cannot clobber another's — a member's helper
-- (mid-spine, non-tail) may freely call ANOTHER group's root (e.g. a lexer helper
-- reaching `join` → `intersperse`): that root resets and threads ITS OWN globals
-- and returns a closed spine, leaving the in-flight group's dest untouched.
-- SAME-group re-entry is not excluded by validation: v3 sees only named call heads,
-- so a member calling back into its own root through a function-typed argument
-- passes it.  The root wrapper's save/restore of the triple is what makes that safe.
wDispHeadL : String -> String
wDispHeadL root = "$g_tmc_head_" ++ gname root
wDispDestL : String -> String
wDispDestL root = "$g_tmc_dest_" ++ gname root
wDispFirstL : String -> String
wDispFirstL root = "$g_tmc_first_" ++ gname root

-- the inner-loop fn name for a group root `R`: `<R>__disploop`.
wDispLoopName : String -> String
wDispLoopName root = root ++ "__disploop"

-- one group's three dest globals (mutable; reset per outer entry by the wrapper).
-- the names of the globals `wDispGlobalLines` declares, without their `$`
wDispGlobalNames : DispGroup -> List String
wDispGlobalNames grp =
  let root = dispRootOf grp
  map symNameW [wDispHeadL root, wDispDestL root, wDispFirstL root]

wDispGlobalLines : DispGroup -> List String
wDispGlobalLines grp =
  let root = dispRootOf grp
  [
    "  (global " ++ wDispHeadL root ++ " (mut (ref null eq)) (ref.null eq))",
    "  (global " ++ wDispDestL root ++ " (mut (ref null eq)) (ref.null eq))",
    "  (global " ++ wDispFirstL root ++ " (mut i32) (i32.const 1))",
  ]

-- ── group detection (SHARED — backend/trmc_analysis.mdk) ─────────────────────
-- The Stage-3 dispatch-graph groups are detected once, by the plan
-- (`emit_plan.buildEmitPlan`), with the shared detection in
-- `backend/trmc_analysis.mdk`; both backends route the SAME groups.  The spine
-- classifier below closes the shared one over `prog`.

-- shared spine classifier, closed over `prog` (detection, validation, and the
-- leaf emit below all agree on what is — and is not — a spine cons).
wDispSpineParts : Prog ->
  (String -> Bool) ->
  CExpr ->
  Option (List CExpr, String, List CExpr)
wDispSpineParts prog ok e =
  dispSpineParts
    (n => canonFn prog n)
    (n => progFnMemberW prog n)
    (n => fnParamCountW prog n)
    ok
    e

-- a saturated direct call to `root` (canonicalized), via the shared classifier.
wDispIsSatRootCall : Prog -> String -> Int -> CExpr -> Bool
wDispIsSatRootCall prog root arity e =
  dispIsSatRootCall (n => canonFn prog n) root arity e

-- ── group-member emit ────────────────────────────────────────────────────────
-- (group lookup/accessors are the shared dispGroupOf/dispRootOf/dispMembersOf.)
wDispIsRoot : DispGroup -> String -> Bool
wDispIsRoot (DispGroup root _) name = root == name

-- census marker (TMC-parity gate): one deterministic `;; tmc: <fn> <mode>`
-- comment per TMC decision; test/tmc_census.sh + diff_compiler_tmc_parity.sh
-- extract these to diff both backends' TMC'd source-function sets.  The name is
-- census-normalized (leading `mdk_` stripped, so an impl fn reads
-- `impl_<tag>_<method>` on both backends).
wTmcMarker : String -> String -> String
wTmcMarker sym mode =
  let name = if startsWith "mdk_" sym then dropPrefix sym "mdk_" else sym
  "  ;; tmc: \{name} \{mode}"

-- emit a group ROOT: the reset wrapper `$root` (save and zero the dest globals, call the
-- inner loop, restore them) + the inner `$root__disploop` (the real body, leaves redirected).
emitWDispRoot : Prog -> DispGroup -> Int -> List CClause -> List String
emitWDispRoot prog grp arity clauses =
  let name = dispRootOf grp
  let params = synthParams arity
  let loopName = wDispLoopName name
  let _ = defineFnW prog (gname name) (FuncParams arity)
  let resetWrapper = wDispResetWrapper prog name loopName params arity
  let inner = emitWDispMemberFn prog grp loopName name arity clauses
  wTmcMarker name "group-root" :: resetWrapper ++ inner

-- the reset wrapper: (func $root (param …) (result (ref eq))
--   save $g_tmc_head / $g_tmc_dest / $g_tmc_first into locals
--   i32.const 1  global.set $g_tmc_first
--   ref.null eq  global.set $g_tmc_head
--   ref.null eq  global.set $g_tmc_dest
--   local.get $a0 … call $root__disploop
--   restore the saved triple, return the result)
-- A plain `call`, not `return_call`: the restore must run after the spine closes.
wDispResetWrapper : Prog ->
  String ->
  String ->
  List String ->
  Int ->
  List String
wDispResetWrapper prog name loopName params arity =
  let sig =
    "  (func $\{gname name}\{joinWith "" (map paramDeclRef params)} (result (ref eq))"
  let locals = [
    "(local $__disp_sh (ref null eq))",
    "(local $__disp_sd (ref null eq))",
    "(local $__disp_sf i32)",
    "(local $__disp_r (ref eq))",
  ]
  let get = g => globalW prog "global.get" g
  let set = g => globalW prog "global.set" g
  let save = [
    get (wDispHeadL name),
    "local.set $__disp_sh",
    get (wDispDestL name),
    "local.set $__disp_sd",
    get (wDispFirstL name),
    "local.set $__disp_sf",
  ]
  let reset = [
    "i32.const 1",
    set (wDispFirstL name),
    "ref.null eq",
    set (wDispHeadL name),
    "ref.null eq",
    set (wDispDestL name),
  ]
  let forward =
    flatMap (p => ["local.get $" ++ gname p]) params
      ++ [callFnW prog CallValueW (gname loopName) arity, "local.set $__disp_r"]
  let restore = [
    "local.get $__disp_sh",
    set (wDispHeadL name),
    "local.get $__disp_sd",
    set (wDispDestL name),
    "local.get $__disp_sf",
    set (wDispFirstL name),
    "local.get $__disp_r",
  ]
  [sig] ++ indent (locals ++ save ++ reset ++ forward ++ restore) ++ ["  )"]

-- emit a non-root group MEMBER (or the root's inner loop): the ordinary clause machinery,
-- but with the dispatch context LIVE so spine cons leaves + the root's base redirect.
-- `emitName` is the wasm fn name to emit under (the inner loop for the root; the fn's own
-- name for a non-root member).
emitWDispMemberFn : Prog ->
  DispGroup ->
  String ->
  String ->
  Int ->
  List CClause ->
  List String
emitWDispMemberFn prog grp emitName origName arity clauses =
  let root = dispRootOf grp
  let params = synthParams arity
  let loopName = wDispLoopName root
  -- the dispatch context carries the ROOT's arity (for the bare-root-call redirect
  -- check), NOT this member's arity — a member like scanAt is arity-6 but the bare
  -- call it makes to `scan` is arity-5.  It also carries the MEMBER SET so spine
  -- cons leaves targeting a non-root member return_call that member directly.
  let rootArity = fnParamCountW prog root
  let w7Outer = w7ScopeOpen (progEmit prog)
  let dprog =
    progWithDisp (WDispOn root loopName rootArity (dispMembersOf grp)) prog
  let bodyLines = emitClausesRef dprog origName params arity clauses
  let allLocals = clauseLocals clauses
  let extraLocals = filterList (notIn params) (dedupKeep allLocals)
  let scratch = scratchLocals (clausesMaxDepth clauses)
  let _ = defineFnW prog (gname emitName) (FuncParams arity)
  let sig =
    "  (func $\{gname emitName}\{joinWith "" (map paramDeclRef params)} (result (ref eq))"
  -- census marker for a NON-root member (the root's marker is emitted by
  -- emitWDispRoot; the inner __disploop is the root's own body, not a member).
  let marker =
    if emitName == origName then
      [wTmcMarker origName ("group:" ++ root)]
    else
      []
  -- the member needs the tmc temp local ($__tmc_t0 = the fresh cell stash).
  let tmcLocal = ["(local " ++ wTrmcTempL 0 ++ " (ref null eq))"]
  let localDecls = map localDeclRef (extraLocals ++ scratch)
  let w7Decls =
    w7LocalDecls
      (w7ScopeClose (progEmit prog) w7Outer)
      (clausesMaxDepth clauses)
  marker
    ++ [sig]
    ++ map ("  " ++ _) (tmcLocal ++ localDecls ++ w7Decls)
    ++ indent bodyLines
    ++ ["  )"]

-- the spine-cons leaf rewrite (case 2), generalized to N cells + any group-member
-- target: build each peeled cell in source order (lead field + placeholder tail),
-- link it into $g_tmc_dest (or seed $g_tmc_head on the very first cell), advance the
-- dest — the second-and-later cells naturally chain through the just-advanced dest —
-- then emit the bottom call's ARGS + `return_call` the target (`$root__disploop` for
-- the root, the member fn itself otherwise).  NO struct.new holds the recursion →
-- the leaf frame dies.
emitWDispSpineCons : Prog ->
  Env ->
  String ->
  String ->
  List CExpr ->
  List CExpr ->
  List String
emitWDispSpineCons prog env root target heads args =
  flatMap (h => emitWDispCell prog env root h) heads
    ++ flatMap (a => emitRefExpr prog env 0 a) args
    ++ [callFnW prog CallTailW (gname target) (listLen args)]

-- one Cons cell of a spine-cons leaf: build, link, advance.
emitWDispCell : Prog -> Env -> String -> CExpr -> List String
emitWDispCell prog env root head =
  let cellStruct = "C_Cons"
  -- #712/S0: this is the built-in list `::` spine — pin the reserved Cons ordinal,
  -- not `ctorOrdinal "Cons"` (which a coexisting user `Cons` ctor would poison).
  let tag = ["i32.const " ++ intToString (syntheticCtorOrdinal "Cons")]
  let headInstrs = emitRefExpr prog env 0 head
  let placeholder = ["i32.const 1", "ref.i31"]
  let buildCell =
    tag ++ headInstrs ++ placeholder ++ ["struct.new $" ++ cellStruct]
  let stashNew = buildCell ++ ["local.set " ++ wTrmcTempL 0]
  -- link: first cell → head:=cell, first:=0 ; else struct.set dest.tail := cell.
  let linkSeed = [
    "local.get " ++ wTrmcTempL 0,
    globalW prog "global.set" (wDispHeadL root),
    "i32.const 0",
    globalW prog "global.set" (wDispFirstL root),
  ]
  let linkSet = [
    globalW prog "global.get" (wDispDestL root),
    "ref.cast (ref $" ++ cellStruct ++ ")",
    "local.get " ++ wTrmcTempL 0,
    "ref.as_non_null",
    "struct.set $" ++ cellStruct ++ " 2",
  ]
  let linkInstrs =
    [globalW prog "global.get" (wDispFirstL root), "if"]
      ++ indent linkSeed
      ++ ["else"]
      ++ indent linkSet
      ++ ["end"]
  let advance = [
    "local.get " ++ wTrmcTempL 0,
    globalW prog "global.set" (wDispDestL root),
  ]
  stashNew ++ linkInstrs ++ advance

-- the root's BASE leaf (case 1): close the dest with the real value of the base (the
-- spine's terminator, e.g. `[]` = Nil), then return $g_tmc_head.  If no cell was ever
-- built ($g_tmc_first still 1) the whole result IS the base value.
emitWDispBase : Prog -> Env -> String -> CExpr -> List String
emitWDispBase prog env root e =
  let valInstrs = emitRefExpr prog env 0 e
  let cellStruct = "C_Cons"
  let storeBranch =
    [
        globalW prog "global.get" (wDispDestL root),
        "ref.cast (ref $" ++ cellStruct ++ ")",
      ]
      ++ valInstrs
      ++ ["struct.set $" ++ cellStruct ++ " 2"]
  let seedBranch = valInstrs ++ [globalW prog "global.set" (wDispHeadL root)]
  [globalW prog "global.get" (wDispFirstL root), "if"]
    ++ indent seedBranch
    ++ ["else"]
    ++ indent storeBranch
    ++ ["end"]
    ++ [
      globalW prog "global.get" (wDispHeadL root),
      "ref.as_non_null",
      "return",
    ]

-- A tail-position application.  A file bound and a fall-through sentinel are
-- control, not calls, and keep their own lowering.  An application the lowering
-- flagged as the tail call (`isTailCall`) replaces this function's frame
-- (`emitTailCallW`); any other is computed and returned.
emitAppTail : Prog -> Env -> Int -> CExpr -> List String
emitAppTail prog env arity app =
  let (hd, args, _) = appParts app
  if rawProgramW prog then
    if isTailCall app then
      emitDirectRawCallW prog env 0 hd args True
    else
      emitAppRef prog env 0 app ++ ["return"]
  else match hd
    CVar f0 _ =>
      if f0 == "$withFileReadBound"
        || f0 == "$withFileWriteBound" then match fileBoundW app
        Some (g, body, mode) =>
          let pushed =
            emitRefExpr prog env 0 body
              ++ [rtCallW prog "mdk_file_bound_exit" 0, "return"]
          fileBoundEnterW prog env 0 g mode False
            ++ ["if"]
            ++ indent pushed
            ++ ["else"]
            ++ indent (emitRefTail prog env arity body)
            ++ ["end", "unreachable"]
        None => gapLP prog "wasm: a file bound requires a grant and a thunk"
      else if isFtSentinel f0 || hasFamilyW prog f0 "fallthrough" then
        -- tail-position `__fallthrough__ ()` / `__ft__<label> ()`: lower the sentinel
        -- (a `br`, NOT a `return` — control leaves the clause, not the function).
        ftSentinelInstrs f0
      else
        emitFlaggedAppW prog env app
    _ => emitFlaggedAppW prog env app

emitFlaggedAppW : Prog -> Env -> CExpr -> List String
emitFlaggedAppW prog env app =
  if isTailCall app then
    emitTailCallW prog env app
  else
    emitAppRef prog env 0 app ++ ["return"]

-- The tail call itself: the call `emitAppRef` would make, as a `return_call`.  A
-- constructor, `Ref`/`setRef` and an extern compute a value and return it.  An
-- indirect call returns through `$__mdk_apply`, which `return_call_ref`s the
-- closure's code, so every shape is constant-stack.
emitTailCallW : Prog -> Env -> CExpr -> List String
emitTailCallW prog env app =
  let (hd, args, mode) = appParts app
  match hd
    CVar f0 _ =>
      let f = canonFn prog f0
      if envHas f0 env then
        -- E24 (wasm peer): a LOCALLY-BOUND name shadows any same-named ctor / known top-level
        -- fn / extern — applying it is an INDIRECT tail call (`return_call $__mdk_apply`), never a
        -- direct `return_call $<toplevel>`.  Same guard as emitAppRef's CVar arm; without it a
        -- method-named HOF param colliding with a top-level fn (`pickEq eq x y = eq x y`) tail-
        -- called the WRONG callee.  Mirrors emitVarRefPlain's `envHas x env`-first priority.

        emitIndirectApp prog env 0 hd args CallTailW
      else if isCtor prog f then
        emitRefExpr prog env 0 app ++ ["return"]
      else if isFfiExternW prog f then
        emitFfiAppW prog env 0 hd f args CallTailW
      else if f0 == siteSentinelName
        || hasFamilyW prog f0 "ref" && runtimeNameW prog f0 == "Ref"
        || hasFamilyW prog f0 "ref" && runtimeNameW prog f0 == "setRef"
        || isSome (externFamilyW (progEmit prog) (runtimeNameW prog f0)) then
        emitAppRef prog env 0 app ++ ["return"]
      else if progFnMemberW prog f && isExactCall mode then
        flatMap (a => emitRefExpr prog env 0 a) args
          ++ [callFnW prog CallTailW (gname f) (listLen args)]
      else
        emitIndirectApp prog env 0 hd args CallTailW
    -- #1349: a dispatched method in tail position.  An RKey route return_calls the
    -- selected entry (an impl method calling itself among them); a runtime
    -- dictionary return_calls the entry each dispatch arm selects.
    CMethod name (MethodEvidence iface arity route implRoutes methRoutes) =>
      emitMethodRef
        prog
        env
        0
        name
        iface
        arity
        route
        implRoutes
        methRoutes
        args
        mode
        CallTailW
    -- P0-7 / #2577: a `=>`-constrained function in tail position.  The un-annotated
    -- `Num a` loop (`loop acc n = … loop (acc+n) (n-1)`) lowers its recursive call
    -- to a `CDict loop [<Num route>]` head: dict words + args + `return_call $loop`
    -- for a top-level one, and `return_call $__mdk_apply` for a local
    -- (`where`-bound) one.
    CDict name routes => emitDictRef prog env 0 name routes args mode CallTailW
    _ => emitIndirectApp prog env 0 hd args CallTailW

-- a block in tail position: the last CSExpr is the tail; everything before is a
-- statement (effect/let).  (W4 blocks in tail position only appear via desugared
-- sequencing; the last expr is the result.)
emitBlockTail : Prog -> Env -> Int -> List CStmt -> List String
emitBlockTail prog env arity [CSExpr ex] = emitRefTail prog env arity ex
emitBlockTail prog env arity ((CSExpr ex) :: rest) =
  emitRefExpr prog env 0 ex ++ ["drop"] ++ emitBlockTail prog env arity rest
emitBlockTail prog env arity ((CSLet recF pat ex) :: rest) =
  let (prefix, env2) = emitBlockBindingW prog env 0 recF pat ex
  prefix ++ emitBlockTail prog env2 arity rest
emitBlockTail prog env arity ((CSAssign x ex) :: rest) =
  emitRefExpr prog env 0 ex
    ++ ["local.set " ++ localTargetW prog env x]
    ++ emitBlockTail prog env arity rest
emitBlockTail prog env arity [] = emitRefTail prog env arity (CLit LUnit)
emitBlockTail prog _ _ _ = gapLP prog (if rawProgramW prog then
  "scalar-mode: unsupported block statement"
else
  "ref-mode: unsupported block statement in tail position")

-- a CDecision in tail position: each arm body is itself in tail position.  Reuse the
-- W3 decision machinery but route arm bodies through emitRefTail (so a tail call in
-- a match arm is a return_call).  The decision's result block is no longer needed —
-- each arm either return_calls or value+returns, so the function returns directly
-- from within the tower.  We emit the scrutinee stash + the tree with TAIL arm
-- emission.  `decLabel` is unused for tail arms (they `return`/`return_call`), but
-- the tree walker still threads it; we pass a dead label that is never branched to.
emitDecisionTail : Prog ->
  Env ->
  Int ->
  CExpr ->
  List CArm ->
  CTree ->
  List String
emitDecisionTail prog env arity scrut arms tree =
  let st = emitRefExpr prog env 0 scrut
  let scrutL = scratchLocal 0
  let occ0 = ["local.get $" ++ scrutL]
  st
    ++ ["local.set $" ++ scrutL]
    ++ emitTreeTail prog env arity 1 occ0 [occ0] arms tree

-- the decision tree, with arm LEAVES emitted in tail position.  Structurally mirrors
-- emitTreeRef but: leaves → emitRefTail (return_call / value+return), and switches do
-- NOT need a result block (each path returns).  Reuses the same br_table tower shape
-- with the slot bodies tail-emitting their arms.
emitTreeTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List (List String) ->
  List CArm ->
  CTree ->
  List String
emitTreeTail prog env arity d root occs arms (CTFail fs) =
  wasmFailTrap (progEmit prog) fs
emitTreeTail prog env arity d root occs arms (CTLeaf i) =
  emitLeafTail prog env arity root arms i
emitTreeTail prog env arity d root occs arms (CTGuard i fail) =
  emitGuardArmTail prog env arity d root occs arms i fail
emitTreeTail prog env arity d root occs arms (CTDrop sub) =
  emitTreeTail prog env arity d root (tailList occs) arms sub
emitTreeTail prog env arity d root occs arms (CTSwitch branches dft) =
  emitSwitchTail prog env arity d root occs arms branches dft

-- Like emitLeafRef, for an arm body in TAIL POSITION (emitRefTail path).
emitLeafTail : Prog ->
  Env ->
  Int ->
  List String ->
  List CArm ->
  Int ->
  List String
emitLeafTail prog env arity root arms i = match nthArm arms i
  Some (CArm pat _ body) =>
    let (binds, env2) = bindPatRef prog env pat root
    let bodyCode = emitRefTail prog env2 arity body
    binds ++ bodyCode
  None => gapLP prog "ref-mode: tail decision arm index out of range"

-- Like emitGuardArmRef, for guarded arms in tail position.
-- G6 (#379): same `patTestBind` re-match as emitGuardArmRef — see its note.  A `PRng`
-- arm reaches THIS site too (`f n = match n` is a tail match), so the range test has to
-- exist on both engines or the two disagree.
emitGuardArmTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List (List String) ->
  List CArm ->
  Int ->
  CTree ->
  List String
emitGuardArmTail prog env arity d root occs arms i fail = match nthArm arms i
  Some (CArm pat guards body) =>
    let gLabel = "$gt" ++ intToString d
    let (tests, binds, env2) = patTestBind prog pat root gLabel env
    -- #379: guards now thread the env (a CGBind binds names the body can see), so the
    -- body is emitted under env3, not env2.
    let (gcode, env3) = emitGuardChainRef prog env2 0 gLabel guards
    let armCode =
      ["block " ++ gLabel]
        ++ indent (tests ++ binds ++ gcode ++ emitRefTail prog env3 arity body)
        ++ ["end"]
    armCode ++ emitTreeTail prog env arity d root occs arms fail
  None => gapLP prog "ref-mode: tail guarded arm index out of range"

emitSwitchTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  List String
emitSwitchTail prog env arity d root [] arms branches dft =
  emitTreeTail prog env arity d root [] arms dft
emitSwitchTail prog env arity d root (foc :: rest) arms [] dft =
  emitTreeTail prog env arity d root rest arms dft
emitSwitchTail prog env arity d root (foc :: rest) arms (branches@((CTBranch (HLit _) _) :: _)) dft =
  emitLitSwitchTail prog env arity d root foc rest arms branches dft 0
emitSwitchTail prog env arity d root (foc :: rest) arms ((CTBranch HUnit sub) :: _) dft =
  emitTreeTail prog env arity d root rest arms sub
emitSwitchTail prog env arity d root (foc :: rest) arms (branches@((CTBranch h _) :: _)) dft =
  match conHeadInfo h
    Some _ => emitConSwitchTail prog env arity d root foc rest arms branches dft
    None => gapLP prog "ref-mode: unsupported tail switch head"

-- constructor switch (tail): stash focus, br_table on the discriminant; each slot
-- tail-emits its arm (which return_calls / returns), so we need no result block.
emitConSwitchTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  List String
emitConSwitchTail prog env arity d root foc rest arms branches dft =
  let ty = switchTypeName prog branches
  let nOrd = typeCtorCount prog ty
  let sv = scratchLocal d
  let svRead = ["local.get $" ++ sv]
  foc
    ++ ["local.set $" ++ sv]
    ++ emitBrTableTowerTail
      prog
      env
      arity
      (d + 1)
      root
      svRead
      rest
      arms
      (branchOrdMapW prog branches)
      dft
      ty
      d
      nOrd

-- the br_table tower in tail position: no `$swd` result block — each ordinal slot's
-- body tail-emits its arm (return_call / return), and the default subtree follows the
-- innermost `end`.  The table targets `$sw<sd>_k` slots; the default slot is the last
-- `end`'s fall-through into the default subtree.
emitBrTableTowerTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  CTree ->
  String ->
  Int ->
  Int ->
  List String
emitBrTableTowerTail prog env arity d root svRead rest arms branches dft ty sd nOrd =
  let sfx = intToString sd
  let labels = map (k => "$swt\{sfx}_\{intToString k}") (rangeList 0 nOrd)
  let dftLabel = "$swdt" ++ sfx
  let tableInstr = "br_table \{joinWith " " labels} \{dftLabel}"
  let opens =
    ["block " ++ dftLabel]
      ++ map (k => "block $swt\{sfx}_\{intToString k}") (rangeList 0 nOrd)
  let pick = discrimReadOf svRead ty ++ [tableInstr]
  opens
    ++ pick
    ++ towerBodiesTail
      prog
      env
      arity
      d
      root
      svRead
      rest
      arms
      branches
      dft
      ty
      sd
      (nOrd - 1)

towerBodiesTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  CTree ->
  String ->
  Int ->
  Int ->
  List String
towerBodiesTail prog env arity d root svRead rest arms branches dft ty sd k =
  if k < 0 then
    ["end"] ++ emitTreeTail prog env arity d root rest arms dft
  else
    ["end"]
      ++ emitOrdinalSlotTail
        prog
        env
        arity
        d
        root
        svRead
        rest
        arms
        branches
        ty
        sd
        k
      ++ towerBodiesTail
        prog
        env
        arity
        d
        root
        svRead
        rest
        arms
        branches
        dft
        ty
        sd
        (k - 1)

emitOrdinalSlotTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  String ->
  Int ->
  Int ->
  List String
emitOrdinalSlotTail prog env arity d root svRead rest arms branches ty sd k =
  match branchForOrdinal branches k
    Some (CTBranch h sub) =>
      -- #712: key the field-extract cast off the CHead (headCtorStructName), not the
      -- bare ctor name — so a built-in `HCons` stays on the reserved `$C_Cons` even when
      -- a user ADT also declares a `Cons` (which resolves to `$CU_Cons`).
      let cs = headCtorStructName prog h
      let a = snd (conHeadInfoUnsafe prog h)
      let fieldOccs =
        map
          (i =>
            svRead
              ++ [
                "ref.cast (ref $" ++ cs ++ ")",
                "struct.get $\{cs} \{intToString (i + 1)}",
              ])
          (rangeList 0 a)
      emitTreeTail prog env arity d root (fieldOccs ++ rest) arms sub
    None => ["br $swdt" ++ intToString sd]

-- `idt` (trailing) is the chain's own INDENT depth — see emitLitSwitchRef (#381).
emitLitSwitchTail : Prog ->
  Env ->
  Int ->
  Int ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  Int ->
  List String
emitLitSwitchTail prog env arity d root foc rest arms [] dft idt =
  indentBy idt (emitTreeTail prog env arity d root rest arms dft)
-- #759: unbox to i64 ($mdk_unbox_int handles i31 immediate OR $boxint) and compare at
-- full width, so a head |k| >= 2^30 neither overflows `i32.const` (module rejected) nor
-- ref.casts a boxed scrutinee to i31 (trap).
emitLitSwitchTail prog env arity d root foc rest arms ((CTBranch (HLit (LInt k)) sub) :: more) dft idt =
  indentBy
      idt
      (foc
        ++ [unboxIntW prog, "i64.const " ++ intToString k, "i64.eq"]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeTail prog env arity d root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchTail prog env arity d root foc rest arms more dft (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
-- W6: Char-literal switch head — a Char is an i31 codepoint immediate (cf.
-- `PLit (LChar)`); compare the i31 against the codepoint constant.
emitLitSwitchTail prog env arity d root foc rest arms ((CTBranch (HLit (LChar c)) sub) :: more) dft idt =
  indentBy
      idt
      (foc
        ++ [
          "ref.cast (ref i31)",
          "i31.get_u",
          "i32.const "
            ++ intToString (charCode (arrayGetUnsafe 0 (stringToChars c))),
          "i32.eq",
        ]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeTail prog env arity d root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchTail prog env arity d root foc rest arms more dft (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
-- W6: String-literal switch head — compare the focus $str against each literal via
-- `$mdk_str_compare` (returns the i31 1 on equal), reusing the `PLit (LString)` logic.
emitLitSwitchTail prog env arity d root foc rest arms ((CTBranch (HLit (LString s)) sub) :: more) dft idt =
  indentBy
      idt
      (foc
        ++ ["ref.cast (ref $str)"]
        ++ emitLitRef prog (LString s)
        ++ [
          rtCallW prog "mdk_str_compare" 2,
          "ref.cast (ref i31)",
          "i31.get_u",
          "i32.const 1",
          "i32.eq",
        ]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeTail prog env arity d root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchTail prog env arity d root foc rest arms more dft (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
emitLitSwitchTail prog _ _ _ _ _ _ _ _ _ _ =
  gapLP prog "ref-mode: non-Int literal tail switch head"

-- ── §4 closure (CLam) lowering — lambda-lift + arity-in-struct ───────────────
-- A CLam is lambda-lifted to a top-level $codety function `$mdk_lamN`.  Its FREE
-- variables (names referenced in the body, minus the lambda's own params, that are
-- live in the enclosing env) are CAPTURED into the closure's $env array, in a fixed
-- order.  The lifted function reads its captures from `self`'s $env (cast to $clos)
-- and its params from the $args array.  At the USE site we build the $clos struct:
-- code = `ref.func $mdk_lamN`, arity = the lambda's param count, env = the captured
-- values emitted from the current env.  Arity lives IN THE STRUCT (§11) so apply
-- never consults a name-keyed table.
emitClosure : Prog -> Env -> Int -> List Pat -> CExpr -> List String
emitClosure prog env d pats body =
  let n = freshLamId (progEmit prog)
  let lamName = "$mdk_lam" ++ intToString n
  -- W2/cat2: a param may be a destructuring pattern (tuple/ctor); its BOUND vars
  -- (patVars) — not a single synthetic name — are what the body's free-var set
  -- subtracts, so the captures are computed over the real bound names.
  let boundVars = flatMap patVars pats
  let captured =
    filterList (c => envHas c env) (dedupKeep (freeVarsExpr boundVars body))
  let _ = noteFuncRef prog lamName
  let _ =
    addLifted
      prog
      lamName
      codeShapeW
      (emitLamDefine prog lamName pats captured (envRestrict captured env) body)
  -- build the closure struct at the use site: ref.func, arity, env array of captures.
  -- S-4: with NO captures every operand is constant, so hoist the struct to a module
  -- global (wConstClos) instead of rebuilding it on each evaluation of the `CLam`.
  match captured
    [] => wConstClos prog lamName (listLen pats)
    _ =>
      let capInstrs = flatMap (c => ["local.get $" ++ gname c]) captured
      [refFuncW prog lamName, "i32.const " ++ intToString (listLen pats)]
        ++ capInstrs
        ++ [
          "array.new_fixed $argarr " ++ intToString (listLen captured),
          "struct.new $clos",
        ]

-- the lifted lambda body.  Prologue: bind each captured var from self's $env (cast
-- self to $clos, get $env, array.get i, non-null) into its local; bind each param
-- from the $args array.  Then TAIL-emit the body.
emitLamDefine : Prog ->
  String ->
  List Pat ->
  List String ->
  Env ->
  CExpr ->
  List String
emitLamDefine prog lamName pats captured capEnv body =
  let arity = listLen pats
  -- each param i: load $args[i] into a synthetic local `$__lp<i>`, then bind its
  -- (possibly-destructuring) pattern against that local via bindPatRef (the same
  -- field-extraction machinery match-arm leaves / destructuring-lets use).
  let synthPs = map (i => "__lp" ++ intToString i) (rangeList 0 arity)
  let w7Outer = w7ScopeOpen (progEmit prog)
  let capPrologue = flatMap capLoadAt (zipIdx captured 0)
  let argLoads = flatMap argLoadAt (zipIdx synthPs 0)
  let (paramBinds, bodyEnv0) =
    bindParamPats
      prog
      (envExtendUnstamped synthPs capEnv)
      (zipPatsP pats synthPs)
  let bodyEnv = bodyEnv0
  let patBoundVars = flatMap patVars pats
  let bodyLocals =
    filterList
      (notIn (synthPs ++ captured ++ patBoundVars))
      (dedupKeep (collectExprLocals body))
  let scratch = scratchLocals (maxRefDepth body)
  let localLines =
    ["(local $__self_clos (ref $clos))"]
      ++ map
        (l => localDeclRef l)
        (synthPs ++ captured ++ patBoundVars ++ bodyLocals ++ scratch)
  let setup =
    ["local.get $self", "ref.cast (ref $clos)", "local.set $__self_clos"]
  -- A lifted lambda is an INDEPENDENT function: it must NOT inherit the enclosing
  -- fn's TMC loop context nor a dispatch-group context, so its body is emitted
  -- with `progInFn`.
  -- emitLamDefine can run while one of those is LIVE (a cons-tail clause body whose
  -- lead-field / recomputed-arg builds a closure is emitted under a live trmc context),
  -- and without clearing it the lambda body's tail leaves would emit `$__tmc_*` /
  -- `$tmcloop` references that this lambda never declares as locals → invalid wasm.
  let bodyLines = emitRefTail (progInFn prog) bodyEnv arity body
  let w7Decls =
    w7LocalDecls (w7ScopeClose (progEmit prog) w7Outer) (maxRefDepth body)
  [
      "  (func "
        ++ lamName
        ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
    ]
    ++ map ("  " ++ _) (localLines ++ w7Decls)
    ++ indent (setup ++ capPrologue ++ argLoads ++ paramBinds ++ bodyLines)
    ++ ["  )"]

-- bind a list of (pattern, synthetic-local-name) lambda params: for each, run
-- bindPatRef against `local.get $<synth>` (the pattern is irrefutable — the type
-- proves the shape, like a destructuring let).  Threads the env left-to-right.
bindParamPats : Prog -> Env -> List (Pat, String) -> (List String, Env)
bindParamPats _ env [] = ([], env)
bindParamPats prog env ((p, a) :: rest) =
  let (binds, env2) = bindPatRef prog env p ["local.get $" ++ gname a]
  let (more, env3) = bindParamPats prog env2 rest
  (binds ++ more, env3)

-- zip patterns to synthetic param names (peer of zipPats but for synthetic params).
zipPatsP : List Pat -> List String -> List (Pat, String)
zipPatsP (p :: ps) (a :: bs) = (p, a) :: zipPatsP ps bs
zipPatsP _ _ = []

-- load captured var i: $__self_clos.$env[i] → its local.
capLoadAt : (String, Int) -> List String
capLoadAt (c, i) = [
  "local.get $__self_clos",
  "struct.get $clos $env",
  "i32.const " ++ intToString i,
  "array.get $argarr",
  "ref.as_non_null",
  "local.set $" ++ gname c,
]

-- load param i: $args[i] → its local.
argLoadAt : (String, Int) -> List String
argLoadAt (p, i) = [
  "local.get $args",
  "i32.const " ++ intToString i,
  "array.get $argarr",
  "ref.as_non_null",
  "local.set $" ++ gname p,
]

-- ── W9: CLetGroup (where / local letrec functions) ───────────────────────────
-- A `where`/`let`-group of (possibly mutually-recursive, multi-clause) LOCAL
-- functions, lambda-lifted to top-level functions.  Strategy (the wasm peer of
-- llvm_emit.emitKnotRun):
--   * groupCaps = the free vars across ALL bindings' clause bodies, minus every
--     binding's own params and minus the group's own names, kept to those visible
--     in the enclosing env.  This single capture set is shared by every member.
--   * each binding `name` is lifted to `$mdk_lgN_<name>` whose $env carries
--     groupCaps.  Its prologue (a) loads groupCaps from $env, (b) REBUILDS every
--     group member's closure (ref.func + arity + an $argarr of groupCaps) into a
--     local — so a member body referencing itself or a sibling resolves to a fresh
--     closure with the same captures (the knot is tied by reconstruction, no cyclic
--     heap value needed), (c) loads its own params from $args, then emits the
--     clause chain.
--   * the USE site (the group body) rebuilds the same closures into locals from the
--     enclosing env, then emits the body — so the body sees each group name bound.
-- A zero-binding group is just its body.
--
-- P1 — a NULLARY VALUE binding (`base = 10`, i.e. `CBind n [CClause [] rhs]`) is NOT a
-- local function and must NOT be lifted.  Lifting every member of the group
-- uniformly binds `base` in `where base = 10 …` to an arity-0 CLOSURE that is never
-- forced, and a sibling's `x + base` then runs $mdk_unbox_int over a `$clos` → the module
-- validates and traps `illegal cast` at instantiate (test/llvm_fixtures/where_sibling_ref).
-- llvm_emit's emitLetGroup has always had the dedicated nullary-value arm; ref-mode
-- didn't.  Fix: evaluate a value binding's rhs at the use site into its local, and hand
-- the value to the lifted members as an ordinary CAPTURE (it joins groupCaps, so each
-- member loads it from $env exactly like any enclosing free var).  Values are computed
-- before the closures because the closures capture them — so a value binding whose rhs
-- calls a sibling FUNCTION is the one shape this cannot tie, and it is rejected
-- precisely rather than miscompiled (llvm_emit rejects the mirror case in emitKnotRun).
-- #314: a block-statement function-`let` (`let go i = … go …`) — a single
-- self-recursive LOCAL function that the CBlock emitters (emitBlockTail /
-- emitBlockRef) would otherwise lower as a plain `CLam` capture, leaving the
-- self-call `go` unbound in the lifted body (build-fail; eval worked because it
-- binds the name first).  Reuse the W9 letgroup machinery for a ONE-member group:
-- lift `$mdk_lgN_go` (its prologue rebuilds `go`'s own closure into a local, so the
-- self-call resolves), then at the use site rebuild `go`'s closure into local `$go`.
-- Returns the use-site rebuild instrs; the caller binds `go` (`envBind`) for the rest
-- of the block.  Peer of the native emitter's `emitRecLam` route in emitBlock.
emitSelfRecLocalBind : Prog ->
  Env ->
  String ->
  BinderId ->
  List Pat ->
  CExpr ->
  List String
emitSelfRecLocalBind prog env x bid pats body =
  let gid = freshLamId (progEmit prog)
  let bind = CBind x [CClause pats body] noDeclLoc bid
  let groupCaps =
    filterList
      (c => envHas c env)
      (dedupKeep (filterList (notIn [x]) (freeVarsClauses [] bind)))
  let groupEnv = envBind x bid (envRestrict groupCaps env)
  let _ = emitLgLifted prog gid [x] groupCaps groupEnv [bind] bind
  -- one-member group: `useSiteRebuilds`'s later-sibling guard is vacuous here, so a
  -- capture-free `go` reaches the hoisted-global branch.  Self-reference is not a
  -- forward reference — the knot is tied inside the lifted prologue, not here.
  useSiteRebuilds prog gid groupCaps [bind]

-- A let-group: its members, then `body` emitted by `emitBody` with every member
-- bound (`emitLetWith`'s contract).
emitLetGroupWith : Prog ->
  Env ->
  Int ->
  (Env -> CExpr -> List String) ->
  List CBind ->
  CExpr ->
  List String
emitLetGroupWith prog env d emitBody binds body =
  let gid = freshLamId (progEmit prog)
  let valBinds = filterList isLgValBind binds
  let fnBinds = filterList (b => not (isLgValBind b)) binds
  let valNames = map lgBindName valBinds
  let names = map lgBindName fnBinds
  let allParams = flatMap lgBindParams fnBinds
  let valFree = dedupKeep (flatMap (freeVarsClauses []) valBinds)
  if anyOfList names valFree then
    gapLP
      prog
      "wasm W9: unsupported let-group — a VALUE binding's right-hand side calls a sibling FUNCTION of the same group; the value must be computed before the group's closures are built (peer of the native emitter's knot-tying restriction)"
  else
    let freeCaps =
      filterList
        (c => envHas c env)
        (dedupKeep
          (filterList
            (notIn (names ++ valNames ++ allParams))
            (flatMap (freeVarsClauses []) binds)))
    -- the group's value bindings are shared by every member, so they ride along as caps.
    let groupCaps = freeCaps ++ valNames
    -- emit each lifted top-level fn (drained into the module like other lifted lams).
    let groupEnv = envBindGroups binds (envRestrict freeCaps env)
    let _ =
      forEachU
        (b => emitLgLifted prog gid names groupCaps groupEnv fnBinds b)
        fnBinds
    -- at the use site: compute the value bindings into their locals (each visible to the
    -- next), rebuild every FUNCTION member's closure, then emit the body with all bound.
    let valInit = emitLgValBinds prog env d valBinds
    let rebuilds = useSiteRebuilds prog gid groupCaps fnBinds
    valInit ++ rebuilds ++ emitBody (envBindGroups binds env) body

-- S-4: the USE-SITE closure rebuilds for a let-group.  A member whose group capture
-- set is EMPTY and which does not FORWARD-reference a later sibling builds a `$clos`
-- out of nothing but constants, so it reads one hoisted module global (wConstClos)
-- instead of rebuilding the struct on every entry to the enclosing function.
--
-- The forward-reference guard is the direct analogue of the LLVM emitter's routing
-- (`emitLetGroup` sends a binding that `refsLater` to `emitLetGroupKnot`, and only the
-- non-forward-referencing arm reaches the `emitGroupBind` hoist).  Self-recursion is
-- NOT a forward reference and stays eligible — the capture-free `where go … = … go …`
-- worker is exactly the shape this is for.  On THIS backend the guard is conservative
-- rather than load-bearing: `groupCaps` never contains a sibling's name (siblings are
-- subtracted when it is computed) and every `$clos` field is immutable, so the wasm
-- knot is tied by RECONSTRUCTION inside `emitLgLifted`'s prologue — which this never
-- touches — and not by patching the use-site struct.
useSiteRebuilds : Prog -> Int -> List String -> List CBind -> List String
useSiteRebuilds _ _ _ [] = []
useSiteRebuilds prog gid groupCaps (b :: rest) =
  let laterNames = map lgBindName rest
  let hoistable =
    listLen groupCaps == 0 && not (anyOfList laterNames (freeVarsClauses [] b))
  let here =
    if hoistable then
      constLgClosure prog gid b
    else
      rebuildLgClosure prog gid groupCaps b
  here ++ useSiteRebuilds prog gid groupCaps rest

-- S-4 (prologue half): the member-closure rebuilds a LIFTED member runs on every
-- entry, including a tail self-call's re-entry.  Its hoist condition is weaker than
-- the use site's: this materializes the group's ENTIRE member set before any body
-- line runs, so there is no later sibling to forward-reference — a member naming any
-- other member finds it in a local whichever order the rebuilds emitted in.  What is
-- left is the condition that makes a `$clos` constant at all, an empty `groupCaps`,
-- which is a property of the GROUP — so the group hoists whole or not at all.
liftedMemberRebuilds : Prog -> Int -> List String -> List CBind -> List String
liftedMemberRebuilds prog gid groupCaps binds =
  if listLen groupCaps == 0 then
    flatMap (b => constLgClosure prog gid b) binds
  else
    flatMap (b => rebuildLgClosure prog gid groupCaps b) binds

-- the hoisted-global form of rebuildLgClosure: same lifted code function, same arity,
-- an empty env — read from one module global and stored into the member's local.
constLgClosure : Prog -> Int -> CBind -> List String
constLgClosure prog gid (CBind name clauses _ _) =
  wConstClos
      prog
      "$mdk_lg\{intToString gid}_\{gname name}"
      (clauseArityOf clauses)
    ++ ["local.set $" ++ gname name]

-- P1: a CLetGroup member that is a nullary VALUE binding, not a local function.
isLgValBind : CBind -> Bool
isLgValBind (CBind _ [CClause [] _] _ _) = True
isLgValBind _ = False

-- P1: evaluate each value binding's rhs into its local, threading the bound names
-- through the env so a later value binding can reference an earlier one.
emitLgValBinds : Prog -> Env -> Int -> List CBind -> List String
emitLgValBinds _ _ _ [] = []
emitLgValBinds prog env d ((CBind name [CClause [] rhs] _ bid) :: rest) =
  emitRefExpr prog env d rhs
    ++ ["local.set $" ++ gname name]
    ++ emitLgValBinds prog (envBind name bid env) d rest
emitLgValBinds prog env d (_ :: rest) = emitLgValBinds prog env d rest

-- P1: does any name in `xs` occur in `ys`?
anyOfList : List String -> List String -> Bool
anyOfList xs ys = anyList (x => contains x ys) xs

-- params of a CLetGroup binding (the first clause's pattern arity → synthetic names).
lgBindParams : CBind -> List String
lgBindParams (CBind _ clauses _ _) = synthParams (clauseArityOf clauses)

-- the lifted member function `$mdk_lg<gid>_<name>`: $env = groupCaps; prologue loads
-- caps, rebuilds every member closure into its local, loads own params, emits clauses.
emitLgLifted : Prog ->
  Int ->
  List String ->
  List String ->
  Env ->
  List CBind ->
  CBind ->
  Unit
emitLgLifted prog gid names groupCaps groupEnv binds (CBind name clauses bindLoc _) =
  let memberProg =
    progForBinding
      ("lg:" ++ name)
      bindLoc
      (sitePackedW (progEmit prog) bindLoc)
      prog
  let lamName = "$mdk_lg\{intToString gid}_\{gname name}"
  let _ = noteFuncRef prog lamName
  let arity = clauseArityOf clauses
  -- synthetic names: this member also declares its group captures and sibling
  -- names as locals, so a source-named param could collide with either.
  let params = synthParams arity
  let w7Outer = w7ScopeOpen (progEmit prog)
  let capPrologue = flatMap capLoadAt (zipIdx groupCaps 0)
  let memberRebuilds = liftedMemberRebuilds prog gid groupCaps binds
  let argPrologue = flatMap argLoadAt (zipIdx params 0)
  -- a lifted letgroup member is an independent function: clear any live TMC /
  -- dispatch-group context so its body doesn't leak `$__tmc_*`/`$tmcloop` references
  -- (see emitLamDefine — same hazard when lifted under a live trmc context).
  let bodyLines =
    emitClausesRefEnv memberProg groupEnv name params arity clauses
  let memberLocals = names
  let bodyLocals =
    filterList
      (notIn (params ++ groupCaps ++ memberLocals))
      (dedupKeep (clauseLocals clauses))
  let scratch = scratchLocals (clausesMaxDepth clauses)
  let localLines =
    ["(local $__self_clos (ref $clos))"]
      ++ map (n => "(local $" ++ gname n ++ " (ref eq))") memberLocals
      ++ map
        (l => localDeclRef l)
        (params ++ groupCaps ++ bodyLocals ++ scratch)
      ++ w7LocalDecls
        (w7ScopeClose (progEmit prog) w7Outer)
        (clausesMaxDepth clauses)
  let setup =
    ["local.get $self", "ref.cast (ref $clos)", "local.set $__self_clos"]
  let def =
    [
        "  (func "
          ++ lamName
          ++ " (type $codety) (param $self (ref eq)) (param $args (ref $argarr)) (result (ref eq))",
      ]
      ++ map ("  " ++ _) localLines
      ++ indent
        (setup ++ capPrologue ++ memberRebuilds ++ argPrologue ++ bodyLines)
      ++ ["  )"]
  addLifted prog lamName codeShapeW def

-- rebuild ONE member's closure value (ref.func + arity + $argarr of groupCaps) and
-- bind it to its local `$<name>`.  Used BOTH at the use site and inside each lifted
-- member's prologue; groupCaps must be bound as locals in either context.
rebuildLgClosure : Prog -> Int -> List String -> CBind -> List String
rebuildLgClosure prog gid groupCaps (CBind name clauses _ _) =
  let lamName = "$mdk_lg\{intToString gid}_\{gname name}"
  let arity = clauseArityOf clauses
  let capInstrs = flatMap (c => ["local.get $" ++ gname c]) groupCaps
  [refFuncW prog lamName, "i32.const " ++ intToString arity]
    ++ capInstrs
    ++ [
      "array.new_fixed $argarr " ++ intToString (listLen groupCaps),
      "struct.new $clos",
      "local.set $" ++ gname name,
    ]

zipIdx : List String -> Int -> List (String, Int)
zipIdx [] _ = []
zipIdx (x :: xs) i = (x, i) :: zipIdx xs (i + 1)

-- free variables of a lambda body (names referenced, minus the bound params; we
-- also subtract names bound by inner let/lambda/match so only truly-free names
-- remain).  Returns names in first-seen order.
freeVarsExpr : List String -> CExpr -> List String
freeVarsExpr bound (CVar x _) = if contains x bound then [] else [x]
freeVarsExpr bound (CApp f args _) =
  freeVarsExpr bound f ++ flatMap (freeVarsExpr bound) args
-- A lambda param may be a DESTRUCTURING pattern (tuple/ctor) — e.g. a `do`-bind
-- with a tuple LHS `(a, b) <- m` desugars to `andThen m (\(a, b) => …)`.  Subtract
-- ALL its bound vars (patVars, like the CLet case), not `map patName` which only
-- accepts PVar/PWild and gaps on any real pattern.  (emitClosure/emitLamDefine
-- already destructure such params via bindPatRef; only this free-var walk lagged.)
freeVarsExpr bound (CLam pats b) =
  freeVarsExpr (flatMap patVars pats ++ bound) b
freeVarsExpr bound (CLit _) = []
freeVarsExpr bound (CBinPrim _ l r _ _) =
  freeVarsExpr bound l ++ freeVarsExpr bound r
freeVarsExpr bound (CUnOp _ x) = freeVarsExpr bound x
freeVarsExpr bound (CIf c t f) =
  freeVarsExpr bound c ++ freeVarsExpr bound t ++ freeVarsExpr bound f
freeVarsExpr bound (CLet _ pat e1 e2) =
  freeVarsExpr bound e1 ++ freeVarsExpr (patVars pat ++ bound) e2
freeVarsExpr bound (CBlock stmts) = freeVarsStmts bound stmts
freeVarsExpr bound (CDecision scrut arms _) =
  freeVarsExpr bound scrut ++ flatMap (freeVarsArm bound) arms
freeVarsExpr bound (CMatch scrut arms) =
  freeVarsExpr bound scrut ++ flatMap (freeVarsArm bound) arms
freeVarsExpr bound (CLetGroup binds b) =
  let names = map lgBindName binds
  let bound2 = names ++ bound
  flatMap (freeVarsClauses bound2) binds ++ freeVarsExpr bound2 b
-- compound value nodes: their sub-expressions can reference outer-bound vars
-- (e.g. a do-block's `pure (a, b, c)` lowers to CTuple — without this arm the
-- captured `a`/`b` are dropped and emit as unbound).  Each descends with the
-- SAME `bound` (these nodes introduce no binders).
freeVarsExpr bound (CTuple es) = flatMap (freeVarsExpr bound) es
freeVarsExpr bound (CList es) = flatMap (freeVarsExpr bound) es
freeVarsExpr bound (CArray es) = flatMap (freeVarsExpr bound) es
freeVarsExpr bound (CRecord _ fields) = flatMap (freeVarsField bound) fields
freeVarsExpr bound (CFieldAccess e _ _ _) = freeVarsExpr bound e
freeVarsExpr bound (CRecordUpdate _ e fields) =
  freeVarsExpr bound e ++ flatMap (freeVarsField bound) fields
freeVarsExpr bound (CVariantUpdate _ e fields) =
  freeVarsExpr bound e ++ flatMap (freeVarsField bound) fields
freeVarsExpr bound (CRangeList lo hi _) =
  freeVarsExpr bound lo ++ freeVarsExpr bound hi
freeVarsExpr bound (CRangeArray lo hi _) =
  freeVarsExpr bound lo ++ freeVarsExpr bound hi
freeVarsExpr bound (CIndex e i) = freeVarsExpr bound e ++ freeVarsExpr bound i
freeVarsExpr bound (CSlice e lo hi _) =
  freeVarsExpr bound e ++ freeVarsExpr bound lo ++ freeVarsExpr bound hi
-- cat4/W5: a return-position method occurrence (CMethod) and a constrained-fn
-- occurrence (CDict) carry their dispatch Routes; a route's RDict/RDictFwd names a
-- dict PARAM that is read at the use site.  Without surfacing it here, a method/
-- constrained-fn call inside a lifted lambda (`clamp lo hi = min hi >> max lo`) or a
-- where-group closure (`minimum`/`maximum`'s `step`) drops the dict from the closure
-- capture set → "dict param '$dict_…' not in scope".  (These nodes carry no value
-- args of their own — args arrive via the surrounding CApp, already handled.)
freeVarsExpr bound (CMethod _ (MethodEvidence _ _ route implRoutes methRoutes)) =
  freeGivens bound (route :: implRoutes ++ methRoutes)
freeVarsExpr bound (CDict name routes) =
  (if contains name bound then [] else [name]) ++ freeGivens bound routes
freeVarsExpr bound _ = []

-- free vars of a CLetGroup binding's clauses (each clause's params are locally bound).
freeVarsClauses : List String -> CBind -> List String
freeVarsClauses bound (CBind _ clauses _ _) =
  flatMap (freeVarsClause bound) clauses

freeVarsClause : List String -> CClause -> List String
freeVarsClause bound (CClause pats body) =
  freeVarsExpr (flatMap patVars pats ++ bound) body

lgBindName : CBind -> String
lgBindName (CBind n _ _ _) = n

freeVarsStmts : List String -> List CStmt -> List String
freeVarsStmts _ [] = []
freeVarsStmts bound ((CSExpr e) :: rest) =
  freeVarsExpr bound e ++ freeVarsStmts bound rest
freeVarsStmts bound ((CSLet _ pat e) :: rest) =
  freeVarsExpr bound e ++ freeVarsStmts (patVars pat ++ bound) rest
freeVarsStmts bound (_ :: rest) = freeVarsStmts bound rest

freeVarsArm : List String -> CArm -> List String
freeVarsArm bound (CArm pat guards body) =
  let bound2 = patVars pat ++ bound
  flatMap (freeVarsGuard bound2) guards ++ freeVarsExpr bound2 body

freeVarsGuard : List String -> CGuard -> List String
freeVarsGuard bound (CGBool g) = freeVarsExpr bound g
freeVarsGuard bound (CGBind p e) = freeVarsExpr bound e

freeVarsField : List String -> CField -> List String
freeVarsField bound (CField _ _ e) = freeVarsExpr bound e

-- ── ADT construction (§3.4) ──────────────────────────────────────────────────
-- A NULLARY ctor → an `i31ref` carrying its PER-TYPE dense ordinal (the same value
-- a payload ctor stores in struct field 0, so one discriminant read + one br_table
-- cover both reps within a match).  Two nullary ctors of DIFFERENT types could
-- share an i31 ordinal, but a well-typed match's scrutinee is one fixed type, so
-- only that type's ctors are ever compared — no cross-type aliasing.  The §3.4
-- structural-collapse caution is about STRUCTS (handled by the per-ctor struct type
-- + explicit i32 tag field), not i31 immediates.  A PAYLOAD ctor → `struct.new
-- $S_ctor` with the per-type dense ordinal as i32 field 0, then the (ref eq) fields.
emitCtorConstruct : Prog -> Env -> Int -> String -> List CExpr -> List String
emitCtorConstruct prog env d ctor args =
  let arity = ctorArity prog ctor
  if arity == 0 then
    ["i32.const " ++ intToString (ctorOrdinal prog ctor), "ref.i31"]
  else
    let tagField = ["i32.const " ++ intToString (ctorOrdinal prog ctor)]
    let argInstrs = flatMap (a => emitRefExpr prog env d a) args
    tagField ++ argInstrs ++ ["struct.new $" ++ ctorStructName ctor]

-- ════════════════════════════════════════════════════════════════════════════
-- W7 — collections (§3.3): List / Tuple / Array / Record / Ref, ranges, index/slice
-- ════════════════════════════════════════════════════════════════════════════

-- a tuple: a single-shape struct `$C_Tup<n>` (tag-0 field + n (ref eq) fields).
-- Reuses the W3 ctor construction shape (a leading i32 tag = ordinal 0) so the match
-- machinery (discrimReadOf → struct field-0) drives HTuple uniformly.
emitTupleRef : Prog -> Env -> Int -> List CExpr -> List String
emitTupleRef prog env d es =
  let n = listLen es
  let argInstrs = flatMap (a => emitRefExpr prog env d a) es
  ["i32.const 0"]
    ++ argInstrs
    ++ ["struct.new $" ++ ctorStructName (tupleCtorName n)]

-- a list literal: a right-nested cons spine ending in the Nil i31.  Built
-- back-to-front so the emitted struct.news nest correctly (Cons head tail).
-- #712/S0: the `[]` terminator is the BUILT-IN list Nil — emit its reserved ordinal
-- i31 directly, not `emitCtorConstruct "Nil"` (whose `ctorOrdinal "Nil"` a coexisting
-- user `Nil` ctor would poison to the user's declaration-order ordinal).
-- Assembled LINEARLY.  A two-clause recursion emitting, per cons level,
-- `["i32.const 0"] ++ hd ++ tl ++ ["struct.new $C_Cons"]` right-associates the
-- `tl ++ ["struct.new $C_Cons"]`, COPYING the growing accumulated instruction list at
-- each of N levels — O(n²) instruction-cons allocation in list-literal width (#522;
-- the LLVM peer emitList/emitRtList prepends via `::` and is linear).  The emitted WAT
-- is BYTE-IDENTICAL: N leading `(i32.const 0, <head instrs>)` prefixes, then the
-- built-in Nil i31 terminator, then N `struct.new $C_Cons` closers — exactly the
-- flattening of the old right-nested `struct.new (Cons hd tl)` spine.  Each `flatMap`
-- chunk / `replicate` cell is constant-length, so total assembly is O(n).
emitListRef : Prog -> Env -> Int -> List CExpr -> List String
emitListRef prog env d es =
  let prefixes = flatMap (x => ["i32.const 0"] ++ emitRefExpr prog env d x) es
  let nilTerm =
    ["i32.const " ++ intToString (syntheticCtorOrdinal "Nil"), "ref.i31"]
  let closers = replicate (listLen es) "struct.new $C_Cons"
  prefixes ++ nilTerm ++ closers

-- a range list [lo..hi] / [lo..=hi]: a back-to-front counted loop building the cons
-- spine in a scratch accumulator local.  The accumulator + counter reuse the
-- depth-keyed scratch locals ($__rl_acc<d> / $__rl_i<d>) declared in the header.
emitRangeListRef : Prog -> Env -> Int -> CExpr -> CExpr -> Bool -> List String
-- The bounds unbox to i64 ($mdk_unbox_int), so a bound outside ±2^30 works, and
-- the count is raw i64 arithmetic on two 63-bit values: `hi + 1` at intMaxBound is
-- 2^62, which i64 holds, so `[lo..=intMaxBound]` neither traps nor comes out empty.
-- Each element `lo + i` lies in [lo, hi] and boxes through $mdk_box_int.
emitRangeListRef prog env d lo hi incl =
  let loI = emitRefExpr prog env d lo ++ [unboxIntW prog]
  let hiI = emitRefExpr prog env d hi ++ [unboxIntW prog]
  let sfx = intToString d
  let accL = w7Local (progEmit prog) "__rlacc" sfx
  let iL = w7Local (progEmit prog) "__rli" sfx
  let loL = w7Local (progEmit prog) "__rllo" sfx
  -- count = (incl ? hi+1 : hi) - lo ; clamped at 0 by the loop guard.
  let adj = if incl then ["i64.const 1", "i64.add"] else []
  -- stash lo, init acc=Nil, i = count-1, loop i>=0: acc = Cons (lo+i) acc.
  loI
    ++ ["local.set " ++ loL]
    ++ ["i32.const 1", "ref.i31", "local.set " ++ accL]
    ++ hiI
    ++ adj
    ++ [
      "local.get " ++ loL,
      "i64.sub",
      "i64.const 1",
      "i64.sub",
      "local.set " ++ iL,
    ]
    ++ ["block $rld" ++ sfx, "loop $rll" ++ sfx]
    ++ ["local.get " ++ iL, "i64.const 0", "i64.lt_s", "br_if $rld" ++ sfx]
    ++ ["i32.const 0"]
    ++ ["local.get " ++ loL, "local.get " ++ iL, "i64.add", boxIntW prog]
    ++ ["local.get " ++ accL]
    ++ ["struct.new $C_Cons", "local.set " ++ accL]
    ++ ["local.get " ++ iL, "i64.const 1", "i64.sub", "local.set " ++ iL]
    ++ ["br $rll" ++ sfx, "end", "end"]
    ++ ["local.get " ++ accL]

-- an array literal: array.new_fixed over the emitted element values.
emitArrayCreateRef : Prog -> Env -> Int -> List CExpr -> List String
emitArrayCreateRef prog env d es =
  let argInstrs = flatMap (a => emitRefExpr prog env d a) es
  argInstrs ++ ["array.new_fixed $arr " ++ intToString (listLen es)]

-- a range array [lo..hi] / [lo..=hi]: allocate `count` slots, fill with a counted
-- loop (peer to llvm_emit.emitRangeArray's alloca-counter loop).
emitRangeArrayRef : Prog -> Env -> Int -> CExpr -> CExpr -> Bool -> List String
emitRangeArrayRef prog env d lo hi incl =
  let loI = emitRefExpr prog env d lo ++ [unboxIntW prog]
  let hiI = emitRefExpr prog env d hi ++ [unboxIntW prog]
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__raarr" sfx
  let iL = w7Local (progEmit prog) "__rai" sfx
  let loL = w7Local (progEmit prog) "__ralo" sfx
  let cntL = w7Local (progEmit prog) "__racnt" sfx
  -- the bound and count arithmetic is i64, as in emitRangeListRef; the slot index
  -- stays i32, the width `array.new`/`array.set` take.
  let adj = if incl then ["i64.const 1", "i64.add"] else []
  loI
    ++ ["local.set " ++ loL]
    ++ hiI
    ++ adj
    ++ ["local.get " ++ loL, "i64.sub", "local.set " ++ cntL]
    -- clamp negative count to 0
    ++ [
      "local.get " ++ cntL,
      "i64.const 0",
      "i64.lt_s",
      "if",
      "i64.const 0",
      "local.set " ++ cntL,
      "end",
    ]
    -- a count past array.new's i32 length is clamped to the largest one, whose
    -- allocation fails, rather than wrapped to a small array.
    ++ [
      "local.get " ++ cntL,
      "i64.const 2147483647",
      "i64.gt_s",
      "if",
      "i64.const 2147483647",
      "local.set " ++ cntL,
      "end",
    ]
    ++ [
      "i32.const 0",
      "ref.i31",
      "local.get " ++ cntL,
      "i32.wrap_i64",
      "array.new $arr",
      "local.set " ++ arrL,
    ]
    ++ ["i32.const 0", "local.set " ++ iL]
    ++ ["block $rad" ++ sfx, "loop $ral" ++ sfx]
    ++ [
      "local.get " ++ iL,
      "i64.extend_i32_u",
      "local.get " ++ cntL,
      "i64.ge_s",
      "br_if $rad" ++ sfx,
    ]
    ++ ["local.get " ++ arrL, "ref.as_non_null", "local.get " ++ iL]
    ++ [
      "local.get " ++ loL,
      "local.get " ++ iL,
      "i64.extend_i32_u",
      "i64.add",
      boxIntW prog,
    ]
    ++ ["array.set $arr"]
    ++ ["local.get " ++ iL, "i32.const 1", "i32.add", "local.set " ++ iL]
    ++ ["br $ral" ++ sfx, "end", "end"]
    ++ ["local.get " ++ arrL, "ref.as_non_null"]

-- CIndex arr i: bounds-check (i<0 or i>=len → trap, matching native @mdk_oob), then
-- array.get.  The trap is `unreachable` (WasmGC has no host-trap call here; an OOB
-- access aborting the module mirrors the native abort).
emitIndexRef : Prog -> Env -> Int -> CExpr -> CExpr -> List String
emitIndexRef prog env d a i =
  let sfx = intToString d
  let arrL = w7Local (progEmit prog) "__ixarr" sfx
  let idxL = w7Local (progEmit prog) "__ixi" sfx
  let arrI =
    emitRefExpr prog env d a ++ ["ref.cast (ref $arr)", "local.set " ++ arrL]
  let idxI =
    emitRefExpr prog env d i
      ++ ["ref.cast (ref i31)", "i31.get_s", "local.set " ++ idxL]
  arrI
    ++ idxI
    -- bounds: idx < 0 || idx >= len → B5 coded [E-INDEX-OOB] trap (peer of native
    -- @mdk_oob; message matches medaka_rt.c, sans the index value native also omits).
    ++ ["local.get " ++ idxL, "i32.const 0", "i32.lt_s"]
    ++ [
      "local.get " ++ idxL,
      "local.get " ++ arrL,
      "ref.as_non_null",
      "array.len",
      "i32.ge_s",
    ]
    ++ ["i32.or", "if"]
    ++ indent (wasmTrap (progEmit prog) "E-INDEX-OOB" "index out of bounds")
    ++ ["end"]
    ++ [
      "local.get " ++ arrL,
      "ref.as_non_null",
      "local.get " ++ idxL,
      "array.get $arr",
      "ref.as_non_null",
    ]

-- CSlice arr lo hi incl: bounds-check, then new array of (end-lo) slots, copy via
-- array.copy.  end = incl ? hi+1 : hi.
--
-- #550: this used to carry NO bounds check — the comment here read "an over-range copy
-- traps in-engine", which was true but is not the contract: the trap is a RAW ENGINE
-- trap, not the coded [E-SLICE-OOB] line `run` produces (sliceArray, eval.mdk).  So wasm
-- was memory-safe but diagnosed wrong, while the LLVM backend (which the comment claimed
-- to "mirror") had no check at all and read out of bounds.  Both are now guarded on the
-- same predicate: `lo < 0 || end > len || end - lo < 0`.  Guarding explicitly rather than
-- leaning on array.new/array.copy's own traps also keeps the two backends' ABORT
-- CONDITION identical instead of merely coincidentally-both-fatal.
--
-- Message parity, and its one REMAINING GAP: this trap line is static bytes (wasmTrap
-- streams them through $mdk_write_err_byte at emit time, no $str value and no data
-- segment), so wasm reports the CODE but not the `[lo..hi]` numbers that eval and
-- native's @mdk_slice_oob both print.
--
-- E-INDEX-OOB does not have this gap: #1787's wasmTrapNum
-- streams a runtime value through $mdk_write_err_int between two fixed byte runs, so
-- all three engines name the offending index.  The same treatment would work here (two
-- numbers instead of one); it is simply not done yet.
--
-- ⚠️ Do NOT read this gap as unobserved.  An earlier version of this comment claimed
-- "nothing compares stderr text across engines: diff_wasm*.sh diff stdout" — that has
-- been FALSE since #531, which made test/wasm/diff_wasm_modules.sh compare stdout,
-- stderr AND exit code (see its `diverges` reporting).  E-SLICE-OOB survives only
-- because no wasm module fixture trips an out-of-range slice; add one and this gate
-- goes red until the numbers match.  (diff_compiler_engines.sh does still classify an
-- interpreter `runtime error [E-` as n/a.)
-- The ABORT CONDITION — which is what soundness turns on — is identical on all three.
emitSliceRef : Prog ->
  Env ->
  Int ->
  CExpr ->
  CExpr ->
  CExpr ->
  Bool ->
  List String
emitSliceRef prog env d a lo hi incl =
  let sfx = intToString d
  let srcL = w7Local (progEmit prog) "__slsrc" sfx
  let dstL = w7Local (progEmit prog) "__sldst" sfx
  let loL = w7Local (progEmit prog) "__sllo" sfx
  let lenL = w7Local (progEmit prog) "__sllen" sfx
  let arrI =
    emitRefExpr prog env d a ++ ["ref.cast (ref $arr)", "local.set " ++ srcL]
  let loI =
    emitRefExpr prog env d lo
      ++ ["ref.cast (ref i31)", "i31.get_s", "local.set " ++ loL]
  let hiI = emitRefExpr prog env d hi ++ ["ref.cast (ref i31)", "i31.get_s"]
  let adj = if incl then ["i32.const 1", "i32.add"] else []
  -- `end` is live on the stack after adj; stash it in lenL, guard, then turn it into the
  -- element count.  Ordering matters: the `end > len` compare needs `end`, and the
  -- `len < 0` compare needs `end - lo`, so the two uses are sequenced through lenL.
  let guardI =
    ["local.set " ++ lenL]
      -- lo < 0
      ++ ["local.get " ++ loL, "i32.const 0", "i32.lt_s"]
      -- end > array.len src
      ++ [
        "local.get " ++ lenL,
        "local.get " ++ srcL,
        "ref.as_non_null",
        "array.len",
        "i32.gt_s",
        "i32.or",
      ]
      -- (end - lo) < 0  (inverted range)
      ++ [
        "local.get " ++ lenL,
        "local.get " ++ loL,
        "i32.sub",
        "i32.const 0",
        "i32.lt_s",
        "i32.or",
      ]
      ++ ["if"]
      ++ indent (wasmTrap (progEmit prog) "E-SLICE-OOB" "slice out of bounds")
      ++ ["end"]
      ++ [
        "local.get " ++ lenL,
        "local.get " ++ loL,
        "i32.sub",
        "local.set " ++ lenL,
      ]
  arrI
    ++ loI
    ++ hiI
    ++ adj
    ++ guardI
    ++ [
      "i32.const 0",
      "ref.i31",
      "local.get " ++ lenL,
      "array.new $arr",
      "local.set " ++ dstL,
    ]
    -- array.copy dst dstoff src srcoff len
    ++ [
      "local.get " ++ dstL,
      "ref.as_non_null",
      "i32.const 0",
      "local.get " ++ srcL,
      "ref.as_non_null",
      "local.get " ++ loL,
      "local.get " ++ lenL,
      "array.copy $arr $arr",
    ]
    ++ ["local.get " ++ dstL, "ref.as_non_null"]

-- a named-field record construction: CRecord carries fields in DECLARED order
-- (lowering preserves it), so emit positionally — identical to a positional ctor
-- struct.new (the ctor IS a W3 user ctor with a $C_<name> struct already declared).
emitRecordRef : Prog -> Env -> Int -> String -> List CField -> List String
emitRecordRef prog env d name fields =
  let tagField = ["i32.const " ++ intToString (ctorOrdinal prog name)]
  let argInstrs = flatMap (f => emitRefExpr prog env d (cFieldExpr f)) fields
  tagField ++ argInstrs ++ ["struct.new $" ++ ctorStructName name]

-- field access `r.label`: cast to the record's ctor struct and struct.get the field
-- at index (1 + its declared ordinal), both stamped by `core_ir_lower`.  The label
-- `value` is always a `Ref` read (the typechecker refuses `.value` on a record),
-- whatever ordinal it carries, as in llvm_emit's `emitFieldAccess`.
emitFieldAccessRef : Prog ->
  Env ->
  Int ->
  CExpr ->
  String ->
  String ->
  Int ->
  List String
emitFieldAccessRef prog env d ex label recName ord =
  if label == "value" then
    -- a $refbox read: cast to $refbox and read the mutable field at slot 0.
    emitRefExpr prog env d ex
      ++ ["ref.cast (ref $refbox)", "struct.get $refbox 0"]
  else if ord >= 0 then
    emitRefExpr prog env d ex
      ++ [
        "ref.cast (ref $" ++ ctorStructName recName ++ ")",
        "struct.get $\{ctorStructName recName} \{intToString (ord + 1)}",
      ]
  else
    gapLP
      prog
      ("ref-mode: CFieldAccess on unknown field '"
        ++ label
        ++ "' (no record ctor in the field-order table)")

-- functional update `{ base | f = v … }`: copy the base's struct, overriding the
-- fields at the stamped ordinals.
emitRecordUpdateRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  List CField ->
  List String
emitRecordUpdateRef prog env d recName base fields =
  emitUpdateCopy prog env d recName base fields

-- named-field variant update `Con { base | f = v … }`: same copy, ctor known.
emitVariantUpdateRef : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  List CField ->
  List String
emitVariantUpdateRef prog env d con base fields =
  emitUpdateCopy prog env d con base fields

-- the shared copy-with-overrides: stash the base into a scratch local, then build a
-- struct.new whose tag is the ctor ordinal and whose fields are, per ordinal, the
-- override expr (if present) or a struct.get of the stashed base.  The base local
-- stays live across the override exprs, so they are emitted one depth deeper: an
-- update nested in an override (`{ r | f = { r.f | g = v } }`) stashes its own base
-- in `$__rub<d+1>` instead of overwriting this one.
emitUpdateCopy : Prog ->
  Env ->
  Int ->
  String ->
  CExpr ->
  List CField ->
  List String
emitUpdateCopy prog env d ctor base fields =
  let sfx = intToString d
  let bL = w7Local (progEmit prog) "__rub" sfx
  let baseI =
    emitRefExpr prog env d base
      ++ ["ref.cast (ref $" ++ ctorStructName ctor ++ ")", "local.set " ++ bL]
  let tagField = ["i32.const " ++ intToString (ctorOrdinal prog ctor)]
  baseI
    ++ tagField
    ++ flatMap
      (idx => oneUpdateField prog env d ctor bL fields idx)
      (rangeList 0 (ctorArity prog ctor))
    ++ ["struct.new $" ++ ctorStructName ctor]

oneUpdateField : Prog ->
  Env ->
  Int ->
  String ->
  String ->
  List CField ->
  Int ->
  List String
oneUpdateField prog env d ctor bL fields idx = match findUpdateExpr idx fields
  Some ex => emitRefExpr prog env (d + 1) ex
  None => [
    "local.get " ++ bL,
    "ref.cast (ref $" ++ ctorStructName ctor ++ ")",
    "struct.get $\{ctorStructName ctor} \{intToString (idx + 1)}",
  ]

findUpdateExpr : Int -> List CField -> Option CExpr
findUpdateExpr _ [] = None
findUpdateExpr idx ((CField _ o ex) :: rest) =
  if o == idx then Some ex else findUpdateExpr idx rest

-- ── match lowering: CDecision → discriminant + br_table + field extraction ───
-- The scrutinee is a (ref eq).  The decision tree (CTree) is walked into a nest of
-- wasm blocks.  We mirror the LLVM emitter's structure: `root` is the whole
-- scrutinee value (kept for the leaf re-match that recovers bindings); each arm
-- body computes a (ref eq).  A CTSwitch on a constructor column reads the column's
-- discriminant (i31 nullary tag vs struct field-0 ordinal) and `br_table`s on the
-- dense per-type ordinal to the matching branch.
--
-- IMPLEMENTATION: a uniform result via a labelled block that all arms `br` out of
-- with their value.  Each arm stores its (ref eq) into a fresh result LOCAL and
-- branches to the shared end.  The tree's control flow is a tower of wasm `block`s.
-- We thread occurrence-values (the focus stack) as a list of "value-producing
-- instruction snippets" (each a List String that, executed, pushes that occurrence
-- onto the stack) — the LLVM emitter uses SSA register names; we use re-emittable
-- snippets (local.get of a stashed local), which keeps it stackless and simple.

-- CDecision at nesting depth `d`.  Stashes the scrutinee into scratch local
-- `$__rf<d>` (so the focus stack re-reads it), wraps the tree in a result block
-- `$dec<d>` that arm bodies `br` out of with their value, and recurses into the
-- tree at depth `d+1` (nested matches/switches get fresh, non-colliding locals +
-- labels).  `decLabel` is `$dec<d>` — the target every arm body branches to.
emitDecisionRef : Prog ->
  Env ->
  Int ->
  CExpr ->
  List CArm ->
  CTree ->
  List String
emitDecisionRef prog env d scrut arms tree =
  let st = emitRefExpr prog env d scrut
  let scrutL = scratchLocal d
  let decLabel = "$dec" ++ intToString d
  let occ0 = ["local.get $" ++ scrutL]
  st
    ++ ["local.set $" ++ scrutL]
    ++ ["block " ++ decLabel ++ " (result (ref eq))"]
    ++ indent (emitTreeRef prog env (d + 1) decLabel occ0 [occ0] arms tree)
    ++ ["end"]

-- emit a CTree.  `d` = nesting depth (fresh locals/labels); `decLabel` = the
-- enclosing `$dec<n>` an arm body branches to; `root` = the scrutinee occurrence
-- snippet (for leaf re-match); `occs` = the live focus columns.  Every path leaves
-- exactly one (ref eq) for `decLabel`'s block to yield (via `br decLabel`), except
-- the default tail of a switch tower which falls through with the value on the stack.
emitTreeRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List (List String) ->
  List CArm ->
  CTree ->
  List String
emitTreeRef prog env d decLabel root occs arms (CTFail fs) =
  wasmFailTrap (progEmit prog) fs
emitTreeRef prog env d decLabel root occs arms (CTLeaf i) =
  emitLeafRef prog env d decLabel root arms i
emitTreeRef prog env d decLabel root occs arms (CTGuard i fail) =
  emitGuardArmRef prog env d decLabel root occs arms i fail
emitTreeRef prog env d decLabel root occs arms (CTDrop sub) =
  emitTreeRef prog env d decLabel root (tailList occs) arms sub
emitTreeRef prog env d decLabel root occs arms (CTSwitch branches dft) =
  emitSwitchRef prog env d decLabel root occs arms branches dft

-- a leaf: re-match arm i's pattern against `root` to bind its PVars (loading struct
-- fields), then emit the body, then `br decLabel` with the value.
emitLeafRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List CArm ->
  Int ->
  List String
emitLeafRef prog env d decLabel root arms i = match nthArm arms i
  Some (CArm pat _ body) =>
    let (binds, env2) = bindPatRef prog env pat root
    let bodyCode = emitRefExpr prog env2 d body
    binds ++ bodyCode ++ ["br " ++ decLabel]
  None => gapLP prog "ref-mode: decision arm index out of range"

-- a guarded arm: RE-MATCH the pattern, evaluate the guards; all-pass → body + br
-- decLabel; any fail → the `fail` subtree (resumes at the same column context).
-- Fall-through is a labelled block `$g<d>`: a failed guard `br_if $g<d>` skips the
-- body, then control falls into the fail subtree after the block's `end`.
-- G6 (#379): the re-match goes through `patTestBind` (test+bind against `gLabel`), not
-- `bindPatRef` (bind only) — a `PRng` arm canonicalizes to PWild in the matrix, so the
-- tree routes HERE unconditionally and this re-match must do the range comparison.
-- An irrefutable pattern emits NO test, so the plain-`if`-guard case is unchanged.
-- Mirrors llvm_emit's emitGuardedArm/`emitRefutArm`.  `root` is the scrutinee
-- `local.get` (occ0), which satisfies patTestBind's re-runnable-read contract.
emitGuardArmRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List (List String) ->
  List CArm ->
  Int ->
  CTree ->
  List String
emitGuardArmRef prog env d decLabel root occs arms i fail = match nthArm arms i
  Some (CArm pat guards body) =>
    let gLabel = "$g" ++ intToString d
    let (tests, binds, env2) = patTestBind prog pat root gLabel env
    -- #379: guards now thread the env (a CGBind binds names the body can see), so the
    -- body is emitted under env3, not env2.
    let (gcode, env3) = emitGuardChainRef prog env2 d gLabel guards
    let armCode =
      ["block " ++ gLabel]
        ++ indent
          (tests
            ++ binds
            ++ gcode
            ++ emitRefExpr prog env3 d body
            ++ ["br " ++ decLabel])
        ++ ["end"]
    armCode ++ emitTreeRef prog env d decLabel root occs arms fail
  None => gapLP prog "ref-mode: guarded arm index out of range"

-- #379: the stash slot for a refutable pattern guard's right-hand side.  `patTestBind`
-- embeds its `occ` snippet once per test AND once per bind, so `occ` must be a cheap,
-- side-effect-free, re-runnable read — every other caller passes a `local.get`.  The
-- guard RHS must therefore be evaluated ONCE into a local.  The native peer just reuses
-- the SSA register `emitExpr` hands back (llvm_emit's `emitGuardChain`); wasm has no
-- free-mint temp, so the slot is declared like any other body local, via
-- `collectGuardLocals`.  ONE slot per function suffices: a stash is consumed
-- (tests ++ binds, into named locals) immediately after it is set, and a nested CGBind
-- inside the RHS finishes evaluating before the outer `local.set` — live ranges never
-- overlap, so no depth indexing is needed (unlike the `__rf<d>` scratch pool, which
-- `maxIndexAt` sizes by walking arm BODIES only, never their guards).
guardStashLocal : String
guardStashLocal = "__gbind"

-- emit a clause's guard chain left-to-right, THREADING the env: a `CGBind p <- e` binds
-- names that later guards AND the body can see -- which the old `flatMap` over a
-- FIXED env could not express.  A CGBool tests the unboxed i31 Bool; a
-- CGBind evaluates `e` into the stash and refutably matches `p` against it via
-- patTestBind (an irrefutable `p` emits no test and just binds; a refutable `Just x <- e`
-- tests the discriminant).  Either failure `br`s to gLabel, exiting the guard block and
-- landing in the fail subtree — the same fall-through the CGBool path always used.
-- Peer of the native emitter's `emitGuardChain`.  Returns (code, env').
emitGuardChainRef : Prog ->
  Env ->
  Int ->
  String ->
  List CGuard ->
  (List String, Env)
emitGuardChainRef _ env _ _ [] = ([], env)
emitGuardChainRef prog env d gLabel ((CGBool g) :: rest) =
  let unbox = ["ref.cast (ref i31)", "i31.get_u", "i32.eqz", "br_if " ++ gLabel]
  let boolTest = emitRefExpr prog env d g ++ unbox
  let (more, env2) = emitGuardChainRef prog env d gLabel rest
  (boolTest ++ more, env2)
emitGuardChainRef prog env d gLabel ((CGBind p ex) :: rest) =
  let sv = gname guardStashLocal
  let rhs = emitRefExpr prog env d ex ++ ["local.set $" ++ sv]
  let (tests, binds, env2) = patTestBind prog p ["local.get $" ++ sv] gLabel env
  let (more, env3) = emitGuardChainRef prog env2 d gLabel rest
  (rhs ++ tests ++ binds ++ more, env3)

-- a CTSwitch on the focus column.  All heads in one switch are homogeneous.  ADT
-- heads → discriminant + br_table on the dense per-type ordinal.  Int-literal heads
-- → compare immediates.  HUnit is irrefutable (drop focus, descend).
emitSwitchRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  List String
emitSwitchRef prog env d decLabel root [] arms branches dft =
  emitTreeRef prog env d decLabel root [] arms dft
emitSwitchRef prog env d decLabel root (foc :: rest) arms [] dft =
  emitTreeRef prog env d decLabel root rest arms dft
emitSwitchRef prog env d decLabel root (foc :: rest) arms (branches@((CTBranch (HLit _) _) :: _)) dft =
  emitLitSwitchRef prog env d decLabel root foc rest arms branches dft 0
emitSwitchRef prog env d decLabel root (foc :: rest) arms ((CTBranch HUnit sub) :: _) dft =
  emitTreeRef prog env d decLabel root rest arms sub
emitSwitchRef prog env d decLabel root (foc :: rest) arms (branches@((CTBranch h _) :: _)) dft =
  match conHeadInfo h
    Some _ =>
      emitConSwitchRef prog env d decLabel root foc rest arms branches dft
    None =>
      gapLP
        prog
        "ref-mode: unsupported switch head (constructor / int-literal / unit only)"

-- the constructor switch (§3.4): stash the focus into scratch local `$__rf<d>`,
-- read its discriminant, and `br_table` on the dense per-type ordinal.  Recurses
-- into branch subtrees at depth d+1.
emitConSwitchRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  List String
emitConSwitchRef prog env d decLabel root foc rest arms branches dft =
  let ty = switchTypeName prog branches
  let nOrd = typeCtorCount prog ty
  let sv = scratchLocal d
  let svRead = ["local.get $" ++ sv]
  foc
    ++ ["local.set $" ++ sv]
    ++ emitBrTableTower
      prog
      env
      (d + 1)
      decLabel
      root
      svRead
      rest
      arms
      (branchOrdMapW prog branches)
      dft
      ty
      d
      nOrd

-- the discriminant: from a value that is EITHER an i31 nullary (its per-type ordinal,
-- set at construction) OR a payload struct (the per-type ordinal in field 0).
-- `ref.test (ref i31)` selects the rep; both yield the SAME dense ordinal.
discrimReadOf : List String -> String -> List String
discrimReadOf svRead ty =
  -- W9: Bool is always an i31 (0/1) — it has no $T_Bool root struct, so emit the i31
  -- read directly (the generic two-branch form would reference an undeclared type in
  -- its dead struct branch and fail wasm-tools validation).
  if ty == "Bool" then
    svRead ++ ["ref.cast (ref i31)", "i31.get_u"]
  else
    svRead
      ++ ["ref.test (ref i31)", "if (result i32)"]
      ++ indent (svRead ++ ["ref.cast (ref i31)", "i31.get_u"])
      ++ ["else"]
      ++ indent
        (svRead
          ++ [
            "ref.cast (ref $" ++ typeRootName ty ++ ")",
            "struct.get $" ++ typeRootName ty ++ " 0",
          ])
      ++ ["end"]

-- build the br_table tower (the standard switch idiom).  Labels are suffixed by the
-- SWITCH depth `sd` so nested switches don't collide.  Structure for nOrd cases:
--
--   block $swd<sd> (result (ref eq))
--     block $sw<sd>_{n-1} … block $sw<sd>_0
--       <discriminant i32>  br_table $sw<sd>_0 … $sw<sd>_{n-1} $swd<sd>
--     end           ;; end $sw<sd>_0 — fall through = ordinal 0 selected
--     <arm 0>  br decLabel
--     end           ;; end $sw<sd>_1
--     <arm 1>  br decLabel
--     …
--   end             ;; end $swd<sd>
--   <default subtree>          (falls through with its value on the stack)
emitBrTableTower : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  CTree ->
  String ->
  Int ->
  Int ->
  List String
emitBrTableTower prog env d decLabel root svRead rest arms branches dft ty sd nOrd =
  let sfx = intToString sd
  let labels = map (k => "$sw\{sfx}_\{intToString k}") (rangeList 0 nOrd)
  let tableInstr = "br_table \{joinWith " " labels} $swd\{sfx}"
  let opens =
    ["block $swd" ++ sfx]
      ++ map (k => "block $sw\{sfx}_\{intToString k}") (rangeList 0 nOrd)
  let pick = discrimReadOf svRead ty ++ [tableInstr]
  opens
    ++ pick
    ++ towerBodies
      prog
      env
      d
      decLabel
      root
      svRead
      rest
      arms
      branches
      dft
      ty
      sd
      (nOrd - 1)

-- emit, innermost-first (ordinal n-1 down to 0): `end` of $sw<sd>_k then ordinal k's
-- arm; finally `end` of $swd<sd> then the default subtree (yields the block value).
towerBodies : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  CTree ->
  String ->
  Int ->
  Int ->
  List String
towerBodies prog env d decLabel root svRead rest arms branches dft ty sd k =
  if k < 0 then
    ["end"] ++ emitTreeRef prog env d decLabel root rest arms dft
  else
    ["end"]
      ++ emitOrdinalSlot
        prog
        env
        d
        decLabel
        root
        svRead
        rest
        arms
        branches
        ty
        sd
        k
      ++ towerBodies
        prog
        env
        d
        decLabel
        root
        svRead
        rest
        arms
        branches
        dft
        ty
        sd
        (k - 1)

-- ordinal k's arm: the branch whose head has ordinal k.  Present → extract its
-- fields (ref.cast to the ctor struct + struct.get i+1) as new leading occurrences,
-- emit its subtree.  Absent → fall to $swd<sd> (the default).
emitOrdinalSlot : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  OrdMap CTBranch ->
  String ->
  Int ->
  Int ->
  List String
emitOrdinalSlot prog env d decLabel root svRead rest arms branches ty sd k =
  match branchForOrdinal branches k
    Some (CTBranch h sub) =>
      -- #712: key the field-extract cast off the CHead (headCtorStructName), not the
      -- bare ctor name — so a built-in `HCons` stays on the reserved `$C_Cons` even when
      -- a user ADT also declares a `Cons` (which resolves to `$CU_Cons`).
      let cs = headCtorStructName prog h
      let a = snd (conHeadInfoUnsafe prog h)
      let fieldOccs =
        map
          (i =>
            svRead
              ++ [
                "ref.cast (ref $" ++ cs ++ ")",
                "struct.get $\{cs} \{intToString (i + 1)}",
              ])
          (rangeList 0 a)
      emitTreeRef prog env d decLabel root (fieldOccs ++ rest) arms sub
    None => ["br $swd" ++ intToString sd]

-- the literal switch: compare the focus i31 Int against each branch's constant via
-- an if/else chain.  The focus is re-read per comparison through `foc`.
-- `idt` (trailing) is the chain's own INDENT depth — distinct from the switch depth
-- `d`.  Each level renders itself at `idt` and its arm at `idt + 1`, then hands the
-- else-chain `idt + 1`, instead of wrapping the recursion in `indent` and re-copying
-- every line below it once per level (#381).  Callers start the chain at 0.
emitLitSwitchRef : Prog ->
  Env ->
  Int ->
  String ->
  List String ->
  List String ->
  List (List String) ->
  List CArm ->
  List CTBranch ->
  CTree ->
  Int ->
  List String
emitLitSwitchRef prog env d decLabel root foc rest arms [] dft idt =
  indentBy idt (emitTreeRef prog env d decLabel root rest arms dft)
emitLitSwitchRef prog env d decLabel root foc rest arms ((CTBranch (HLit (LInt k)) sub) :: more) dft idt =
  -- W6 (validate fix): a NO-RESULT `if`.  Every decision-tree path is `br`-terminated
  -- (leaves `br decLabel`, CTFail → unreachable, the else-chain recurses to another
  -- br-terminated `if` or the br-terminated `dft`), so the `if` never falls through
  -- with a value.  A `(result (ref eq))` form leaves a PHANTOM `(ref eq)` on the stack
  -- when this switch is NESTED inside a con-tower slot — at the slot's untyped `end`
  -- that strands the value ("values remaining on stack at end of block").  No result
  -- type ⇒ nothing stranded.
  --
  -- …but a no-result `if` is REACHABLE-after: wasm types it `[] -> []` and does NOT
  -- propagate "both arms diverged", so control notionally falls out of `end` with an
  -- empty stack.  Under a `block $dec… (result (ref eq))` head (a value-position
  -- scrutinee, e.g. `main = match "if"`) that fall-out hits the block's end owing a
  -- `(ref eq)` and strands it the other way — "expected (ref eq) but nothing on
  -- stack", an INVALID module (#374).  Every path here really is `br`-terminated, so
  -- close with `unreachable`: the fall-out goes stack-polymorphic and validates under
  -- BOTH a result-typed head and an untyped con-tower slot.  This is exactly what the
  -- `emitLitSwitchTail` twin already does — the fix was ported to only one of the pair.
  -- #759: unbox to i64 ($mdk_unbox_int handles i31 immediate OR $boxint); see
  -- emitLitSwitchTail — the i31/i32 path truncated/trapped for |k| >= 2^30.
  indentBy
      idt
      (foc
        ++ [unboxIntW prog, "i64.const " ++ intToString k, "i64.eq"]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeRef prog env d decLabel root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchRef
      prog
      env
      d
      decLabel
      root
      foc
      rest
      arms
      more
      dft
      (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
-- W6: Char-literal switch head — a Char is an i31 codepoint immediate (cf.
-- `PLit (LChar)`); compare the i31 against the codepoint constant.
emitLitSwitchRef prog env d decLabel root foc rest arms ((CTBranch (HLit (LChar c)) sub) :: more) dft idt =
  indentBy
      idt
      (foc
        ++ [
          "ref.cast (ref i31)",
          "i31.get_u",
          "i32.const "
            ++ intToString (charCode (arrayGetUnsafe 0 (stringToChars c))),
          "i32.eq",
        ]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeRef prog env d decLabel root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchRef
      prog
      env
      d
      decLabel
      root
      foc
      rest
      arms
      more
      dft
      (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
-- W6: String-literal switch head — compare the focus $str against each literal via
-- `$mdk_str_compare` (returns the i31 1 on equal), reusing the `PLit (LString)` logic.
emitLitSwitchRef prog env d decLabel root foc rest arms ((CTBranch (HLit (LString s)) sub) :: more) dft idt =
  indentBy
      idt
      (foc
        ++ ["ref.cast (ref $str)"]
        ++ emitLitRef prog (LString s)
        ++ [
          rtCallW prog "mdk_str_compare" 2,
          "ref.cast (ref i31)",
          "i31.get_u",
          "i32.const 1",
          "i32.eq",
        ]
        ++ ["if"])
    ++ indentBy (idt + 1) (emitTreeRef prog env d decLabel root rest arms sub)
    ++ indentBy idt ["else"]
    ++ emitLitSwitchRef
      prog
      env
      d
      decLabel
      root
      foc
      rest
      arms
      more
      dft
      (idt + 1)
    ++ indentBy idt ["end", "unreachable"]
emitLitSwitchRef prog _ _ _ _ _ _ _ _ _ _ =
  gapLP
    prog
    "ref-mode: non-Int literal switch head (Char/String literals are W6)"

-- ── pattern binding (leaf re-match) ──────────────────────────────────────────
-- bind a pattern's PVars against the value the snippet `v` produces, emitting struct
-- field extractions.  Returns (instructions that stash bound vars into their locals,
-- extended env).  Mirrors the LLVM bindPattern but stashes into named locals.
bindPatRef : Prog -> Env -> Pat -> List String -> (List String, Env)
bindPatRef prog env PWild v = ([], env)
bindPatRef prog env (PLit _) v = ([], env)
bindPatRef prog env (PVar x _ bid) v =
  (v ++ ["local.set $" ++ gname x], envBind x bid env)
bindPatRef prog env (PCon c args) v = bindConFields prog env c args v
-- W7: a cons cell — field 1 = head, field 2 = tail (struct $C_Cons).
bindPatRef prog env (PCons h t) v =
  let hSnip = v ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 1"]
  let tSnip = v ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 2"]
  let (hb, env2) = bindPatRef prog env h hSnip
  let (tb, env3) = bindPatRef prog env2 t tSnip
  (hb ++ tb, env3)
-- W7: a fixed-length list pattern — bind each element by descending the Cons spine.
bindPatRef prog env (PList ps) v = bindListPat prog env ps v
-- W7: a tuple pattern — field i+1 of the $C_Tup<n> struct.
bindPatRef prog env (PTuple ps) v =
  bindTupleFields prog env (tupleCtorName (listLen ps)) ps v 0
bindPatRef prog env (PAs x _ bid p) v =
  let setX = v ++ ["local.set $" ++ gname x]
  let (inner, env2) = bindPatRef prog (envBind x bid env) p v
  (setX ++ inner, env2)
bindPatRef prog env other v =
  gapL2P
    prog
    ("ref-mode: unsupported pattern in match arm (variable / wildcard / constructor / literal): "
      ++ ptag other)

-- bind a fixed-length list pattern `[p0, p1, …]`: p0 = head of v, the rest match the
-- tail recursively (descending Cons cells; the final empty list / Nil is irrefutable
-- here — the decision tree already proved the length).
bindListPat : Prog -> Env -> List Pat -> List String -> (List String, Env)
bindListPat _ env [] _ = ([], env)
bindListPat prog env (p :: ps) v =
  let hSnip = v ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 1"]
  let tSnip = v ++ ["ref.cast (ref $C_Cons)", "struct.get $C_Cons 2"]
  let (hb, env2) = bindPatRef prog env p hSnip
  let (tb, env3) = bindListPat prog env2 ps tSnip
  (hb ++ tb, env3)

-- bind a tuple pattern's fields: field i+1 of $C_Tup<n> (after the i32 tag).
bindTupleFields : Prog ->
  Env ->
  String ->
  List Pat ->
  List String ->
  Int ->
  (List String, Env)
bindTupleFields _ env _ [] _ _ = ([], env)
bindTupleFields prog env tc (p :: rest) v i =
  let fieldSnippet =
    v
      ++ [
        "ref.cast (ref $" ++ ctorStructName tc ++ ")",
        "struct.get $\{ctorStructName tc} \{intToString (i + 1)}",
      ]
  let (cur, env2) = bindPatRef prog env p fieldSnippet
  let (more, env3) = bindTupleFields prog env2 tc rest v (i + 1)
  (cur ++ more, env3)

-- bind a constructor pattern's fields: for each field i, extract via ref.cast +
-- struct.get (field i+1, after the i32 tag), then recurse into the sub-pattern.
bindConFields : Prog ->
  Env ->
  String ->
  List Pat ->
  List String ->
  (List String, Env)
bindConFields prog env c args v = bindConFieldsGo prog env c args v 0

bindConFieldsGo : Prog ->
  Env ->
  String ->
  List Pat ->
  List String ->
  Int ->
  (List String, Env)
bindConFieldsGo _ env _ [] _ _ = ([], env)
bindConFieldsGo prog env c (p :: rest) v i =
  let fieldSnippet =
    v
      ++ [
        "ref.cast (ref $" ++ ctorStructName c ++ ")",
        "struct.get $\{ctorStructName c} \{intToString (i + 1)}",
      ]
  let (cur, env2) = bindPatRef prog env p fieldSnippet
  let (more, env3) = bindConFieldsGo prog env2 c rest v (i + 1)
  (cur ++ more, env3)

-- ── helpers shared by both modes ─────────────────────────────────────────────

isFnBind : CBind -> Bool
isFnBind (CBind "main" _ _ _) = False
isFnBind b = not (isValBind b)

userFnBinds : List CBind -> List CBind
userFnBinds groups = filterList isFnBind groups

collectFnNames : List CBind -> List String
collectFnNames groups = map bindName (filterList isFnBind groups)

collectValNames : List CBind -> List String
collectValNames groups = map bindName (filterList isValBind groups)

bindName : CBind -> String
bindName (CBind n _ _ _) = n

findMain : WasmEmit -> List CBind -> Option CExpr
findMain _ [] = None
findMain _ ((CBind "main" [CClause [] body] _ _) :: _) = Some body
findMain emit ((CBind "main" _ _ _) :: _) =
  gapOptE emit "`main` must be a nullary value (main = ...)"
findMain emit (_ :: rest) = findMain emit rest

-- the let-bound locals inside a binding's (single, nullary) clause body.
collectBindLocals : CBind -> List String
collectBindLocals (CBind _ [CClause _ body] _ _) = collectExprLocals body
collectBindLocals _ = []

patName : WasmEmit -> String -> Pat -> String
patName _ _ (PVar x _ _) = x
patName _ _ PWild = "_"
patName emit binding _ =
  gapS
    emit
    ("only PVar/PWild parameters (pattern params are inner-match material) [in "
      ++ binding
      ++ "]")

-- ── local collection ─────────────────────────────────────────────────────────
-- Wasm requires every local declared in the function header.  Walk the body for
-- every `let`-bound / block-let-bound PVar AND (W3) every PATTERN-bound var in a
-- CDecision arm (the leaf re-match binds them into locals).
collectExprLocals : CExpr -> List String
collectExprLocals (CLet _ (PVar x _ _) e1 e2) =
  x :: collectExprLocals e1 ++ collectExprLocals e2
collectExprLocals (CLet _ pat e1 e2) =
  patVars pat ++ (collectExprLocals e1 ++ collectExprLocals e2)
collectExprLocals (CBinPrim _ l r _ _) =
  collectExprLocals l ++ collectExprLocals r
collectExprLocals (CUnOp _ x) = collectExprLocals x
collectExprLocals (CIf c t f) =
  collectExprLocals c ++ collectExprLocals t ++ collectExprLocals f
collectExprLocals (app@(CApp f args _)) = match fileBoundW app
  Some (g, body, _) => collectExprLocals g ++ collectExprLocals body
  None => collectExprLocals f ++ flatMap collectExprLocals args
collectExprLocals (CTuple items) = flatMap collectExprLocals items
collectExprLocals (CList items) = flatMap collectExprLocals items
collectExprLocals (CArray items) = flatMap collectExprLocals items
collectExprLocals (CRecord _ fields) = flatMap collectFieldLocals fields
collectExprLocals (CFieldAccess base _ _ _) = collectExprLocals base
collectExprLocals (CRecordUpdate _ base fields) =
  collectExprLocals base ++ flatMap collectFieldLocals fields
collectExprLocals (CVariantUpdate _ base fields) =
  collectExprLocals base ++ flatMap collectFieldLocals fields
collectExprLocals (CRangeList lo hi _) =
  collectExprLocals lo ++ collectExprLocals hi
collectExprLocals (CRangeArray lo hi _) =
  collectExprLocals lo ++ collectExprLocals hi
collectExprLocals (CIndex base index) =
  collectExprLocals base ++ collectExprLocals index
collectExprLocals (CSlice base lo hi _) =
  collectExprLocals base ++ collectExprLocals lo ++ collectExprLocals hi
collectExprLocals (CBlock stmts) = flatMap collectStmtLocals stmts
collectExprLocals (CDecision scrut arms _) =
  collectExprLocals scrut ++ flatMap collectArmLocals arms
collectExprLocals (CMatch scrut arms) =
  collectExprLocals scrut ++ flatMap collectArmLocals arms
-- W9: a CLetGroup's member NAMES are bound as closure locals at the use site (the
-- enclosing fn must declare them); the bindings' own clause locals belong to the
-- LIFTED fns, not here, so only the group body's locals are collected here.
-- P1: a group's FUNCTION members are lambda-lifted (their bodies declare their own
-- locals in their own lifted fn), but a nullary VALUE member's rhs is emitted INLINE at
-- the use site — so its locals must be declared HERE, in the enclosing function.
collectExprLocals (CLetGroup binds body) =
  map lgBindName binds
    ++ flatMap collectLgValLocals binds
    ++ collectExprLocals body
-- a method dispatched on a projected super dictionary reads it through a local
collectExprLocals (CMethod _ (MethodEvidence _ _ (RProj r path) _ _)) =
  [projLocalName r path]
collectExprLocals _ = []

collectFieldLocals : CField -> List String
collectFieldLocals (CField _ _ value) = collectExprLocals value

-- P1: the inline-emitted locals of a group's nullary VALUE member (none for a function
-- member — that one is lifted).
collectLgValLocals : CBind -> List String
collectLgValLocals (CBind _ [CClause [] rhs] _ _) = collectExprLocals rhs
collectLgValLocals _ = []

collectStmtLocals : CStmt -> List String
collectStmtLocals (CSExpr ex) = collectExprLocals ex
collectStmtLocals (CSLet _ (PVar x _ _) ex) = x :: collectExprLocals ex
collectStmtLocals (CSLet _ pat ex) = patVars pat ++ collectExprLocals ex
collectStmtLocals (CSAssign _ ex) = collectExprLocals ex

-- ── W7 scratch-local declarations ────────────────────────────────────────────
-- The range/index/slice/record-update/array-extern/divisor-guard codegen uses
-- depth-keyed scratch locals ($__rli<d> etc.) with specific WAT types (i32 counters,
-- (ref $arr) array temps, (ref eq) accumulators).  Each site names its local through
-- `w7Local`, which records the name in `w7Used`, and a function declares exactly the
-- W7 locals its own body recorded.  A local is a stack slot in every frame of its
-- function on some engines (Firefox), so declaring every W7 local in every function
-- multiplied frame sizes and overflowed deep but legitimate recursion (#3882).
--
-- A function's emitter brackets the codegen of its body with `w7ScopeOpen` and
-- `w7ScopeClose`.  The pair saves and restores the enclosing function's set, because
-- a lifted lambda or let-group member is emitted while its parent's body is
-- being emitted.

-- the `$`-prefixed name of the W7 scratch local `stem` at depth suffix `sfx`, recorded
-- as referenced by the function being emitted.
w7Local : WasmEmit -> String -> String -> String
w7Local emit stem sfx =
  let name = stem ++ sfx
  let _ = setRef emit.w7Used (omInsert name () !emit.w7Used)
  "$" ++ name

-- start recording a new function's W7 locals; returns the enclosing function's set,
-- which `w7ScopeClose` restores.
w7ScopeOpen : WasmEmit -> OrdMap Unit
w7ScopeOpen emit =
  let outer = !emit.w7Used
  let _ = setRef emit.w7Used omEmpty
  outer

-- the W7 locals recorded since the matching `w7ScopeOpen`; restores `outer`.
w7ScopeClose : WasmEmit -> OrdMap Unit -> OrdMap Unit
w7ScopeClose emit outer =
  let used = !emit.w7Used
  let _ = setRef emit.w7Used outer
  used

-- The `(local …)` lines for the W7 locals in `used`, over depths 0..maxDepth (the
-- bound `maxRefDepth` already computes for $__rf<d>, which covers every W7 site),
-- in depth-major then `w7LocalKinds` order.
w7LocalDecls : OrdMap Unit -> Int -> List String
w7LocalDecls used maxDepth = match omKeys used
  [] => []
  _ => flatMap (d => w7LocalsAtDepth used d) (rangeList 0 (maxI maxDepth 1))

w7LocalsAtDepth : OrdMap Unit -> Int -> List String
w7LocalsAtDepth used d =
  let sfx = intToString d
  flatMap
    ((stem, ty) =>
      if omHasKey (stem ++ sfx) used then
        ["(local $\{stem}\{sfx} \{ty})"]
      else
        [])
    w7LocalKinds

-- the divisor-guard scratch local of a concrete `/`/`%` at depth `d`.
divrLocal : Prog -> Int -> String
divrLocal prog d = w7Local (progEmit prog) "__divr" (intToString d)

-- every W7 scratch local's name stem and WAT type, in declaration order.
w7LocalKinds : List (String, String)
w7LocalKinds = [
  ("__rlacc", "(ref eq)"),
  ("__rli", "i64"),
  ("__rllo", "i64"),
  ("__raarr", "(ref null $arr)"),
  ("__rai", "i32"),
  ("__ralo", "i64"),
  ("__racnt", "i64"),
  ("__ixarr", "(ref null $arr)"),
  ("__ixi", "i32"),
  ("__slsrc", "(ref null $arr)"),
  ("__sldst", "(ref null $arr)"),
  ("__sllo", "i32"),
  ("__sllen", "i32"),
  -- W10 array-intrinsic-extern scratch (loop counter, size, result array, list cursor,
  -- closure/init value) for arrayMake/arrayMakeWith/arrayFromList/arraySetUnsafe.
  ("__aexi", "i32"),
  ("__aexn", "i32"),
  ("__aexarr", "(ref null $arr)"),
  ("__aexlst", "(ref eq)"),
  ("__aexf", "(ref eq)"),
  ("__aexv", "(ref eq)"),
  -- stage-B: i64 bit accumulator for floatToBytes64/bytesToFloat64 reinterpret.
  ("__aexbits", "i64"),
  -- the record/variant update base (emitUpdateCopy).
  ("__rub", "(ref eq)"),
  -- B5: the i64 divisor-guard scratch for a concrete-Int `/`/`%`.
  ("__divr", "i64"),
]

-- an arm contributes its pattern's bound vars + its body's locals + guard locals.
collectArmLocals : CArm -> List String
collectArmLocals (CArm pat guards body) =
  patVars pat ++ flatMap collectGuardLocals guards ++ collectExprLocals body

collectGuardLocals : CGuard -> List String
collectGuardLocals (CGBool g) = collectExprLocals g
-- #379: `guardStashLocal` is the slot emitGuardChainRef evaluates the RHS into before
-- refutably matching `p` against it — declared here so it rides the normal body-local
-- path (dedupKeep collapses the repeats when a function has several such guards).
collectGuardLocals (CGBind p e) =
  guardStashLocal :: patVars p ++ collectExprLocals e

-- the variables a pattern binds (for local declaration).
patVars : Pat -> List String
patVars (PVar x _ _) = [x]
patVars PWild = []
patVars (PLit _) = []
patVars (PCon _ args) = flatMap patVars args
patVars (PTuple ps) = flatMap patVars ps
patVars (PCons h t) = patVars h ++ patVars t
patVars (PList ps) = flatMap patVars ps
patVars (PAs x _ _ p) = x :: patVars p
patVars _ = []

-- ── operator tables (both modes) ─────────────────────────────────────────────

-- Ref-mode Int arithmetic/comparison over the box/unbox seam (layer-17 §2.1):
-- i64 throughout, so values outside +/-2^30 no longer truncate.  Division/modulo are
-- i64 signed (i64.div_s/i64.rem_s) — matching native's truncated-toward-zero div and
-- sign-of-dividend rem (medaka_rt.c).
--
-- (The i32 peer `wasmBinOp` was removed with #305: its last two callers were the
-- ordering arms of emitValueCmpRef/emitValueCmpNumRef, which compared a 3-way
-- -1/0/1 against 0 — the derivation that could not express NaN's unorderedness.
-- Those now call the per-op IEEE $mdk_value_lt/le/gt/ge(_num) instead, and every
-- surviving caller was already on wasmBinOp64.)
wasmBinOp64 : WasmEmit -> String -> String
wasmBinOp64 _ "+" = "i64.add"
wasmBinOp64 _ "-" = "i64.sub"
wasmBinOp64 _ "*" = "i64.mul"
wasmBinOp64 _ "/" = "i64.div_s"
wasmBinOp64 _ "%" = "i64.rem_s"
wasmBinOp64 _ "==" = "i64.eq"
wasmBinOp64 _ "/=" = "i64.ne"
wasmBinOp64 _ "<" = "i64.lt_s"
wasmBinOp64 _ ">" = "i64.gt_s"
wasmBinOp64 _ "<=" = "i64.le_s"
wasmBinOp64 _ ">=" = "i64.ge_s"
wasmBinOp64 emit op =
  gapS emit ("unsupported i64 binary operator '" ++ op ++ "'")

binOpTy : String -> WTy
binOpTy op =
  if op == "++" then
    WStr
  else if contains op ["==", "/=", "<", ">", "<=", ">="] then
    WBool
  else
    WInt

-- ── ctor / type info (ref mode) ──────────────────────────────────────────────

isCtor : Prog -> String -> Bool
isCtor prog name =
  isSome (omLookup name (indexCtorAritiesW (progIndex prog)))
    || isReservedCtor name
    || isSyntheticCtor name

isReservedCtor : String -> Bool
isReservedCtor name = isSome (reservedCtorOrdinal name)

-- ── W7 synthetic ctors (List Cons/Nil, tuple Tup<n>) ─────────────────────────
-- These are not in the user ctor table; they share the W3 ctor machinery so the
-- match tower / construction / field-extract code stays uniform.  A tuple ctor is
-- "Tup<n>" (its own single-ctor synthetic type "$Tuple<n>").  List = Cons/Nil under
-- type "List".
isSyntheticCtor : String -> Bool
isSyntheticCtor name =
  name == "Cons"
    || name == "Nil"
    || name == "True"
    || name == "False"
    || isTupleCtorName name

tupleCtorName : Int -> String
tupleCtorName n = "Tup" ++ intToString n

isTupleCtorName : String -> Bool
isTupleCtorName name =
  startsWith "Tup" name && allDigitsFrom (stringToChars name) 3

-- the synthetic type a synthetic ctor belongs to.
syntheticCtorType : String -> String
syntheticCtorType "Cons" = "List"
syntheticCtorType "Nil" = "List"
-- W9: with the REAL prelude, `Bool` is a builtin (not a `data` decl), so its ctors
-- True/False are not in the ctor table.  Treat them as synthetic Bool ctors:
-- type "Bool", ordinals False=0/True=1, nullary, rep = i31 (same as emitVarRef's
-- True/False fast path and emitLitRef LBool), so discrimReadOf's i31 branch reads
-- the ordinal directly.
syntheticCtorType "True" = "Bool"
syntheticCtorType "False" = "Bool"
syntheticCtorType name = "$Tuple" ++ intToString (trailingIntOf name)

syntheticCtorOrdinal : String -> Int
syntheticCtorOrdinal "Cons" = 0
syntheticCtorOrdinal "Nil" = 1
syntheticCtorOrdinal "False" = 0
syntheticCtorOrdinal "True" = 1
syntheticCtorOrdinal _ = 0

syntheticCtorArity : String -> Int
syntheticCtorArity "Cons" = 2
syntheticCtorArity "Nil" = 0
syntheticCtorArity "True" = 0
syntheticCtorArity "False" = 0
syntheticCtorArity name = trailingIntOf name

-- typeName → its ctor list in DECLARATION order.  Walks the ctor→type table
-- REVERSED and PREPENDS, so each type's list comes out in forward declaration
-- order — the same order `ctorsOfTypeUser`'s filter+map produced, duplicates and
-- all.
typeCtorsOfW : List (String, String) ->
  OrdMap (List String) ->
  OrdMap (List String)
typeCtorsOfW [] m = m
typeCtorsOfW ((c, t) :: rest) m =
  typeCtorsOfW rest (omInsert t (c :: optionOr [] (omLookup t m)) m)

-- ctorName → dense per-type ordinal, for the USER path of `ctorOrdinal` only.
-- Reproduces that path's formula
--   orZeroIdx (indexOfL name (ctorsOfType prog (ctorTypeName prog name)))
-- exactly, but in O(ctors · log ctors) instead of O(ctors) per call:
--   * types are walked in DECLARATION order (`distinctTypeNames`);
--   * a ctor is indexed only under the type `ctorTypeName` would name for it (its
--     FIRST type, per `tym`) — so a name shared by two types still takes its
--     ordinal from the first one, as `lookupAssoc` + `indexOfL` did;
--   * the `omHasKey` guard keeps the FIRST index on a name repeated within one
--     type, matching `indexOfL`'s first-match.
-- A ctor absent from the map is not a user ctor, so `userCtorOrdinalW` returns None
-- and `ctorOrdinal` falls through to the reserved/synthetic ordinal (#712/S0).
ctorOrdsOfW : List String ->
  OrdMap String ->
  OrdMap (List String) ->
  OrdMap Int ->
  OrdMap Int
ctorOrdsOfW [] _ _ m = m
ctorOrdsOfW (ty :: rest) tym tcm m =
  ctorOrdsOfW rest tym tcm (indexCtorsW tym ty (ctorsOfTypeIxW tcm ty) 0 m)

indexCtorsW : OrdMap String ->
  String ->
  List String ->
  Int ->
  OrdMap Int ->
  OrdMap Int
indexCtorsW _ _ [] _ m = m
indexCtorsW tym ty (c :: cs) i m = indexCtorsW tym ty cs (i + 1) (if omHasKey
  c
  m then
  m
else if firstTyIsW tym c ty then
  omInsert c i m
else
  m)

firstTyIsW : OrdMap String -> String -> String -> Bool
firstTyIsW tym c ty = match omLookup c tym
  Some t => eqStr t ty
  None => False

-- the shared 5-branch ctor-list dispatch used by BOTH `ctorsOfTypeIxW` (memo-only,
-- called before the `Prog` exists) and `ctorsOfType` (Prog-based). Parameterized
-- over the fallback for a plain user type, so each caller supplies its own way to
-- resolve that case (a direct memo lookup vs `ctorsOfTypeUser`) while the
-- reserved/List/Bool/tuple branches — and their order — exist exactly once, so
-- the two can no longer drift apart.
ctorsOfTypeDispatchW : (String -> List String) -> String -> List String
ctorsOfTypeDispatchW userFallback ty =
  if isReservedType ty then
    reservedCtorsOfType ty
  else if ty == "List" then
    ["Cons", "Nil"]
  else if ty == "Bool" then
    ["False", "True"]
  else if isTupleType ty then
    [tupleCtorName (tupleTypeArity ty)]
  else
    userFallback ty

-- `ctorsOfType`'s dispatch, off the memo and without a `Prog` (the indices are built
-- before the Prog exists). Shares its branches with `ctorsOfType` via
-- `ctorsOfTypeDispatchW` — nothing left to keep in lockstep by hand.
ctorsOfTypeIxW : OrdMap (List String) -> String -> List String
ctorsOfTypeIxW tcm ty =
  ctorsOfTypeDispatchW (t => optionOr [] (omLookup t tcm)) ty

ctorArity : Prog -> String -> Int
ctorArity prog name = match omLookup name (indexCtorAritiesW (progIndex prog))
  Some a => a
  None =>
    if isSyntheticCtor name then
      syntheticCtorArity name
    else
      reservedCtorArity name

-- a ctor's owning type name (user types via the ctor→type map; reserved ctors map
-- to their fixed type names; W7 synthetic ctors to their synthetic types).
ctorTypeName : Prog -> String -> String
ctorTypeName prog name = match omLookup name (indexCtorTypesW (progIndex prog))
  Some ty => ty
  None =>
    if isSyntheticCtor name then
      syntheticCtorType name
    else
      reservedTypeOf prog name

-- the per-type dense ordinal of a ctor (0-based index in its type's declaration
-- order).  Reserved ctors have fixed ordinals.
--
-- #712/S0: a USER ctor is looked up in the ctor TABLE **before** the name-based
-- `syntheticCtorOrdinal` short-circuit — mirroring `ctorArity`/`ctorTypeName` (both
-- table-first) and native `llvm_emit.mdk`'s `ctorOrdinal`.  Taking the
-- synthetic short-circuit FIRST instead gives a user ctor named `Cons`/`Nil` the
-- built-in list ordinal (Cons=0/Nil=1) instead of its DECLARATION-ORDER index.  In a
-- ≥3-ctor ADT like `data T = Extra | Cons Int T | Nil` that collides the user `Cons`
-- (wrongly 0) with `Extra` (legitimately 0) → wasm `br_table` sent `Cons` to `Extra`'s
-- arm = SILENT wrong dispatch. The private ctor-ordinal index holds only USER ctors, so a genuine
-- built-in list ctor (absent) still falls through to `syntheticCtorOrdinal`; a user
-- ctor and the built-in list are told apart at CALL sites via the CHead / tail expr
-- (see `ordinalOfHead`, `emitWDispCell`, the TRMC `isBuiltinList` flag, `emitListRef`),
-- the same discipline the struct-id fix uses.
ctorOrdinal : Prog -> String -> Int
ctorOrdinal prog name =
  optionOr
    (syntheticCtorOrdinal name)
    (orElse (reservedCtorOrdinal name) (userCtorOrdinalW prog name))

-- the DECLARATION-ORDER ordinal of a name IFF it is a user-declared ctor (present in
-- the ctor table), else None so the caller falls back to a synthetic/reserved ordinal.
userCtorOrdinalW : Prog -> String -> Option Int
userCtorOrdinalW prog name = omLookup name (indexCtorOrdinalsW (progIndex prog))

-- the ordinal to discriminate a decision-tree switch HEAD against.  Built-in list
-- heads keep their reserved ordinal (Cons=0/Nil=1) regardless of a poisoning user
-- ctor of the same name; every other head keys off `ctorOrdinal` (a user `HCon
-- "Cons"` thus gets its declaration-order ordinal).  Distinguished by the CHead
-- (`HCons`/`HNil` vs `HCon`), the only signal that survives the bare-name ctor table.
ordinalOfHead : Prog -> CHead -> Int
ordinalOfHead _ HCons = syntheticCtorOrdinal "Cons"
ordinalOfHead _ HNil = syntheticCtorOrdinal "Nil"
ordinalOfHead prog h = ctorOrdinal prog (fstConHead prog h)

-- the declaration-ordered ctor list of a user type (the ctor→type map lists each
-- type's ctors consecutively in declaration order — filter to this type).
-- Bool's ctors are SYNTHETIC (registered via syntheticCtor* helpers, not in the
-- program's ctorTypes table), so `ctorsOfTypeUser` would return [] → a 0-slot
-- br_table tower → both arms dropped → fall-through `unreachable` if it weren't
-- special-cased in the shared dispatch below. A genuine `match <Bool> { True =>
-- …; False => … }` (a CDecision switch, not a lowered CIf) hits this.
-- Index-aligned to syntheticCtorOrdinal: False=0, True=1.
-- Shares its branches with `ctorsOfTypeIxW` via `ctorsOfTypeDispatchW` — nothing
-- left to keep in lockstep by hand.
ctorsOfType : Prog -> String -> List String
ctorsOfType prog ty = ctorsOfTypeDispatchW (ctorsOfTypeUser prog) ty

-- a synthetic tuple type name "$Tuple<n>" and its arity.
isTupleType : String -> Bool
isTupleType ty = startsWith "$Tuple" ty

tupleTypeArity : String -> Int
tupleTypeArity ty = trailingIntOf ty

ctorsOfTypeUser : Prog -> String -> List String
ctorsOfTypeUser prog ty =
  optionOr [] (omLookup ty (indexTypeCtorsW (progIndex prog)))

-- the number of ctors a type has (the br_table's slot count).
typeCtorCount : Prog -> String -> Int
typeCtorCount prog ty = listLen (ctorsOfType prog ty)

-- the type a switch's branches discriminate (all branches share one type — take the
-- first ADT head's ctor's owning type).
switchTypeName : Prog -> List CTBranch -> String
switchTypeName prog [] = gapSP prog "ref-mode: empty constructor switch"
-- #712: the built-in list heads discriminate type "List" (root `$T_List`) — pin
-- them off the CHead, NOT `ctorTypeName "Cons"`, which the bare-name ctor table
-- would (mis)route to a user type "T" the moment `data T = Cons … | Nil` exists.
switchTypeName _ ((CTBranch HCons _) :: _) = "List"
switchTypeName _ ((CTBranch HNil _) :: _) = "List"
switchTypeName prog ((CTBranch h _) :: rest) = match conHeadInfo h
  Some (c, _) => ctorTypeName prog c
  None => switchTypeName prog rest

-- ordinal → the branch that fills that br_table slot, built ONCE per switch (#381).
-- The tower walks every ordinal slot 0..n-1; re-scanning the whole
-- branch list per slot (`branchForOrdinal`) calling `ctorOrdinal` per branch is O(slots ×
-- branches) even with `ctorOrdinal` memoized.  Keyed by the ordinal rendered as a
-- string (`OrdMap` is String-keyed).  The `omHasKey` guard keeps the FIRST branch on
-- a duplicate ordinal, matching the old left-to-right `branchForOrdinal` scan.
branchOrdMapW : Prog -> List CTBranch -> OrdMap CTBranch
branchOrdMapW prog bs = branchOrdMapGoW prog bs omEmpty

branchOrdMapGoW : Prog -> List CTBranch -> OrdMap CTBranch -> OrdMap CTBranch
branchOrdMapGoW _ [] m = m
branchOrdMapGoW prog ((CTBranch h sub) :: rest) m = match conHeadInfo h
  Some _ =>
    -- #712/S0: key off the HEAD (ordinalOfHead), so a built-in `HCons`/`HNil` keeps
    -- its reserved ordinal while a user `HCon "Cons"` gets its declaration-order one.
    let k = intToString (ordinalOfHead prog h)
    branchOrdMapGoW prog rest (if omHasKey k m then
      m
    else
      omInsert k (CTBranch h sub) m)
  None => branchOrdMapGoW prog rest m

-- the branch whose head's ordinal is k (for the br_table slot).
branchForOrdinal : OrdMap CTBranch -> Int -> Option CTBranch
branchForOrdinal bmap k = omLookup (intToString k) bmap

-- the name + arity a constructor-LIKE head tests against.  W7 maps the built-in
-- heads to synthetic ctor names so the SAME ctor machinery (ordinal / struct /
-- field-extract) drives them: HCons → ("Cons", 2) / HNil → ("Nil", 0) (type "List",
-- exactly the LLVM names), HTuple n → the per-arity synthetic tuple ctor "Tup<n>".
conHeadInfo : CHead -> Option (String, Int)
conHeadInfo (HCon c a) = Some (c, a)
conHeadInfo HCons = Some ("Cons", 2)
conHeadInfo HNil = Some ("Nil", 0)
conHeadInfo (HTuple n) = Some (tupleCtorName n, n)
conHeadInfo _ = None

conHeadInfoUnsafe : Prog -> CHead -> (String, Int)
conHeadInfoUnsafe prog h = match conHeadInfo h
  Some p => p
  None =>
    gapSIntP
      prog
      "ref-mode: non-constructor head in a constructor switch (HCons/HNil/HTuple are W7)"

-- ── reserved ADTs (Option / Result / Ordering) ───────────────────────────────
-- The lowering names Ordering's ctors `Lt`/`Eq`/`Gt` (capitalized — see
-- llvm_emit.reservedTag).
isReservedType : String -> Bool
isReservedType ty = contains ty ["Option", "Result", "Ordering"]

reservedCtorsOfType : String -> List String
reservedCtorsOfType "Option" = ["Some", "None"]
reservedCtorsOfType "Result" = ["Ok", "Err"]
reservedCtorsOfType "Ordering" = ["Lt", "Eq", "Gt"]
reservedCtorsOfType _ = []

reservedTypeOf : Prog -> String -> String
reservedTypeOf prog name =
  if contains name ["Some", "None"] then
    "Option"
  else if contains name ["Ok", "Err"] then
    "Result"
  else if contains name ["Lt", "Eq", "Gt"] then
    "Ordering"
  else
    gapSP
      prog
      ("ref-mode: unknown constructor '"
        ++ name
        ++ "' (not in the ctor table, not reserved)")

reservedCtorOrdinal : String -> Option Int
reservedCtorOrdinal "Some" = Some 0
reservedCtorOrdinal "None" = Some 1
reservedCtorOrdinal "Ok" = Some 0
reservedCtorOrdinal "Err" = Some 1
reservedCtorOrdinal "Lt" = Some 0
reservedCtorOrdinal "Eq" = Some 1
reservedCtorOrdinal "Gt" = Some 2
reservedCtorOrdinal _ = None

reservedCtorArity : String -> Int
reservedCtorArity "Some" = 1
reservedCtorArity "Ok" = 1
reservedCtorArity "Err" = 1
reservedCtorArity _ = 0

-- ── WAT type-name mangling ───────────────────────────────────────────────────
-- a per-type root struct type name and a per-ctor struct type name.  Prefixed to
-- avoid colliding with the fixed $float / $boxint scaffolding.  The type word
-- carries its module id (`my prog.T`, `café.T`), which need not be a WAT
-- identifier, so it is spelled through `injectiveIdent`.
typeRootName : String -> String
typeRootName ty = "T_" ++ injectiveIdent ty

-- The per-ctor WasmGC struct type identifier.
--
-- #712: a USER constructor whose bare name coincides with a built-in list head
-- (`Cons`/`Nil` — the names the built-in list SYNTAX canonicalises to) would mint
-- the SAME id as the reserved built-in list cons cell (`$C_Cons`), so
-- `data T = Cons Int T | Nil` declares `$C_Cons` TWICE (once `(sub $T_List)` for the
-- built-in list, once `(sub $T_T)` for the user ctor) and wasm-tools rejects the
-- module with "duplicate type identifier".  `Cons`/`Nil` are NOT prelude `data`
-- ctors (they are pure list SYNTAX with no `data` decl), so resolve lets a user
-- reuse them.  Disambiguate the USER ctor with a `U` (user) prefix → `$CU_Cons`,
-- keeping the reserved built-in `$C_Cons` bare.  This mirrors, on the WasmGC side,
-- native's universal-ctor discipline (private_mangle.mdk): the reserved built-in id
-- stays fixed and the user-defined same-name ctor gets a collision-free key.  Native
-- needs no analogue — its LLVM value rep is a uniform boxed cell with no per-ctor
-- NOMINAL struct type, so the two never collide there.
--
-- The remap is keyed on the ctor NAME, so it fires for a USER `Cons`/`Nil` at EVERY
-- construct / match-field-extract / decl site uniformly (they all route through
-- here).  The built-in list's OWN generic paths — the decision-tree switch on an
-- `HCons` head and the TRMC `::`-spine loop — must NOT be remapped (they build the
-- reserved `$C_Cons`); they force the bare id via `headCtorStructName` / the
-- `isBuiltinList` flag rather than calling this with the bare name.
ctorStructName : String -> String
ctorStructName ctor
  | isBuiltinListHeadName ctor = "CU_" ++ ctor
  | otherwise = "C_" ++ ctor

-- the two ctor names the built-in list syntax canonicalises to.  A user ctor of
-- either name is remapped away from the reserved list type id (see ctorStructName).
isBuiltinListHeadName : String -> Bool
isBuiltinListHeadName name = name == "Cons" || name == "Nil"

-- the struct id to `ref.cast` / `struct.get` against for a decision-tree switch
-- HEAD.  The built-in list head `HCons` is the RESERVED `$C_Cons` cell (never the
-- user remap), regardless of whether a user ADT also declares a `Cons` ctor; every
-- other head keys off its ctor name via ctorStructName (so a user `HCon "Cons"`
-- correctly resolves to the remapped `$CU_Cons`).  This is what keeps the built-in
-- list's generic switch/field-extract on `$C_Cons` while the user ctor's is on
-- `$CU_Cons`, the two being distinguished by the CHead (`HCons` vs `HCon "Cons"`),
-- the only signal that survives once the bare-name ctor table maps `Cons` → the
-- user type.
headCtorStructName : Prog -> CHead -> String
headCtorStructName _ HCons = "C_Cons"
headCtorStructName _ HNil = "C_Nil"
headCtorStructName prog h = ctorStructName (fstConHead prog h)

fstConHead : Prog -> CHead -> String
fstConHead prog h = match conHeadInfo h
  Some (c, _) => c
  None =>
    gapSP
      prog
      "ref-mode: non-constructor head where a ctor struct id was needed"

-- ── distinct type names (declaration order) ──────────────────────────────────
-- the ctor→type map lists each type's ctors consecutively, so dedup-preserving-
-- order over the type column gives declaration order.
distinctTypeNames : List (String, String) -> List String
distinctTypeNames ctorTypes = dedupKeep (map sndPair ctorTypes)

-- ── scratch locals for match scrutinee/focus stashes ─────────────────────────
-- a CDecision/CTSwitch at nesting depth d stashes its value into `$__rf<d>`.  The
-- function header declares `$__rf0..$__rf<maxDepth-1>`.
scratchLocal : Int -> String
scratchLocal d = "__rf" ++ intToString d

scratchLocals : Int -> List String
scratchLocals n = map scratchLocal (rangeList 0 n)

-- the number of scratch locals an expression needs = (highest scratch index used
-- anywhere) + 1.  This MIRRORS the actual depth threading: emitDecisionRef at depth
-- d uses local d and recurses its tree at d+1; emitConSwitchRef at depth d uses
-- local d and recurses subtrees at d+1.  `maxIndexAt e d` = the highest local index
-- used when `e` is emitted at depth d (or d-1 if `e` uses no stash, meaning no
-- scratch beyond what the caller already accounts for).
maxRefDepth : CExpr -> Int
maxRefDepth e = maxIndexAt e 0 + 1

-- the highest scratch-local index used emitting `e` at depth `d`.  Returns d-1 as a
-- "nothing used here" sentinel (so `+1` gives d, i.e. no extra slot).
maxIndexAt : CExpr -> Int -> Int
maxIndexAt (CDecision scrut arms tree) d =
  let scrutI = maxIndexAt scrut d
  let treeI = maxIndexTree tree (d + 1)
  let armDepth = d + 1 + treeSwitchNesting tree
  let armsI = foldMaxI (map (a => maxIndexAt (armBody a) armDepth) arms)
  maxI d (maxI scrutI (maxI treeI armsI))
maxIndexAt (CMatch scrut arms) d =
  let scrutI = maxIndexAt scrut d
  let armsI = foldMaxI (map (a => maxIndexAt (armBody a) (d + 1)) arms)
  maxI d (maxI scrutI armsI)
maxIndexAt (CIf c t f) d =
  maxI (maxIndexAt c d) (maxI (maxIndexAt t d) (maxIndexAt f d))
maxIndexAt (CLet _ pat a b) d =
  maxI (letStashIndex pat a d) (maxI (maxIndexAt a d) (maxIndexAt b d))
-- a `/` or `%` stashes its divisor in `$__divr<d>` (emitDivZeroGuard), so like the
-- four nodes below it counts `d` even over leaf operands, or an Int or `U64`
-- division nested two matches deep names an undeclared `$__divr2`.
maxIndexAt (CBinPrim op a b _ _) d =
  let sub = maxI (maxIndexAt a d) (maxIndexAt b d)
  if op == "/" || op == "%" then maxI d sub else sub
maxIndexAt (CUnOp _ a) d = maxIndexAt a d
maxIndexAt (app@(CApp f args _)) d = match fileBoundW app
  Some (g, body, _) => maxI (maxIndexAt g d) (maxIndexAt body d)
  None => foldMaxI (maxIndexAt f d :: map (a => maxIndexAt a d) args)
maxIndexAt (CBlock stmts) d = foldMaxI (map (s => maxIndexAtStmt s d) stmts)
-- a let-group's BODY is emitted at this same depth `d` at the use site (its lifted
-- members carry their own scratch in their own functions); descend into the body so
-- the enclosing function declares enough `$__rf` slots (a match in the body uses them).
-- P1: a nullary VALUE member's rhs is emitted INLINE at the use site (function members
-- are lifted and size their own scratch), so its depth must be folded in here — else the
-- enclosing fn under-declares scratch locals for it.
maxIndexAt (CLetGroup binds body) d =
  foldMaxI (maxIndexAt body d :: map (b => maxIndexAtLgVal b d) binds)
-- compound value nodes emit their sub-expressions at depth `d` (no own stash slot);
-- descend so a scratch-using element (e.g. CIndex/CSlice/a nested match) is counted.
maxIndexAt (CTuple es) d = foldMaxI (map (x => maxIndexAt x d) es)
maxIndexAt (CList es) d = foldMaxI (map (x => maxIndexAt x d) es)
maxIndexAt (CArray es) d = foldMaxI (map (x => maxIndexAt x d) es)
maxIndexAt (CRecord _ fields) d =
  foldMaxI (map (x => maxIndexAt (cFieldExpr x) d) fields)
-- CRecordUpdate/CVariantUpdate stash the base in $__rub<d> at their own emit site
-- and emit their override exprs at d+1 (emitUpdateCopy).
maxIndexAt (CRecordUpdate _ b fields) d =
  maxI
    d
    (maxI
      (maxIndexAt b d)
      (foldMaxI (map (x => maxIndexAt (cFieldExpr x) (d + 1)) fields)))
maxIndexAt (CVariantUpdate _ b fields) d =
  maxI
    d
    (maxI
      (maxIndexAt b d)
      (foldMaxI (map (x => maxIndexAt (cFieldExpr x) (d + 1)) fields)))
maxIndexAt (CFieldAccess e1 _ _ _) d = maxIndexAt e1 d
-- These four nodes each allocate depth-`d` scratch locals ($__rl*/$__ra*/$__ix*/
-- $__sl* at suffix `d`) at their OWN emit site, so they must contribute `d` even
-- when their subexpressions are leaves (which report d-1).  Omitting the `maxI d`
-- undercounts by one — masked at depths 0/1 by the `maxI maxDepth 1` floor in
-- w7LocalDecls, but at depth >= 2 (e.g. an `arr[i]` nested inside two matches, as in
-- the sqlite lib) it left `$__ixarr2` undeclared → wasm-tools "unknown local".
maxIndexAt (CRangeList lo hi _) d =
  maxI d (maxI (maxIndexAt lo d) (maxIndexAt hi d))
maxIndexAt (CRangeArray lo hi _) d =
  maxI d (maxI (maxIndexAt lo d) (maxIndexAt hi d))
maxIndexAt (CIndex a i) d = maxI d (maxI (maxIndexAt a d) (maxIndexAt i d))
maxIndexAt (CSlice a lo hi _) d =
  maxI d (maxI (maxIndexAt a d) (maxI (maxIndexAt lo d) (maxIndexAt hi d)))
maxIndexAt _ d = d - 1

-- the deepest switch nesting in a tree (each CTSwitch increments the emit depth by
-- 1 for its subtrees; an arm body at a leaf is emitted at decision-depth + this).
-- A constructor switch emits its default subtree inside the same tower as its
-- branches, one level deeper (`emitBrTableTower` at d+1); a literal switch emits
-- both at its own depth, so counting the default one level deeper covers both.
treeSwitchNesting : CTree -> Int
treeSwitchNesting (CTFail _) = 0
treeSwitchNesting (CTLeaf _) = 0
treeSwitchNesting (CTGuard _ fail) = treeSwitchNesting fail
treeSwitchNesting (CTDrop sub) = treeSwitchNesting sub
treeSwitchNesting (CTSwitch branches dft) =
  let bd = foldMaxI (map (b => treeSwitchNesting (branchSub b)) branches)
  1 + maxI bd (treeSwitchNesting dft)

-- P1: scratch depth of a group's nullary VALUE member's inline-emitted rhs (a function
-- member contributes nothing here — it is lifted).
maxIndexAtLgVal : CBind -> Int -> Int
maxIndexAtLgVal (CBind _ [CClause [] rhs] _ _) d = maxIndexAt rhs d
maxIndexAtLgVal _ d = d - 1

maxIndexAtStmt : CStmt -> Int -> Int
maxIndexAtStmt (CSExpr e) d = maxIndexAt e d
maxIndexAtStmt (CSLet _ pat e) d = maxI (letStashIndex pat e d) (maxIndexAt e d)
maxIndexAtStmt (CSAssign _ e) d = maxIndexAt e d

-- the scratch-local index a let/block-let with `pat` against RHS `e` (emitted at
-- depth d) needs to stash its RHS, or d-1 (no stash) for a PVar/PWild bind which
-- needs no scratch.  An irrefutable destructure stashes the RHS one slot ABOVE
-- whatever the RHS itself uses, so the stash never collides with the RHS's own
-- scratch and is live only while the sub-patterns extract their fields.
letStashIndex : Pat -> CExpr -> Int -> Int
letStashIndex (PVar _ _ _) _ d = d - 1
letStashIndex PWild _ d = d - 1
letStashIndex _ e d = maxIndexAt e d + 1

-- the highest scratch index used emitting a decision tree at depth d (a CTSwitch
-- stashes the focus at index d and recurses subtrees, the default included, at d+1;
-- leaves/guards re-emit arm bodies via emitTreeRef at the same depth, accounted by the
-- arm walk above).
maxIndexTree : CTree -> Int -> Int
maxIndexTree (CTFail _) d = d - 1
maxIndexTree (CTLeaf _) d = d - 1
maxIndexTree (CTGuard _ fail) d = maxIndexTree fail d
maxIndexTree (CTDrop sub) d = maxIndexTree sub d
maxIndexTree (CTSwitch branches dft) d =
  let bd = foldMaxI (map (b => maxIndexTree (branchSub b) (d + 1)) branches)
  maxI d (maxI bd (maxIndexTree dft (d + 1)))

branchSub : CTBranch -> CTree
branchSub (CTBranch _ sub) = sub

foldMaxI : List Int -> Int
foldMaxI [] = 0
foldMaxI (x :: xs) = maxI x (foldMaxI xs)

-- ── small generic helpers ────────────────────────────────────────────────────

-- W7 string helpers (no stdlib): trailing-integer parse over the char array.
-- Used only for the synthetic tuple ctor/type names ("Tup<n>" / "$Tuple<n>")
-- whose arity is recovered from the trailing decimal.
--
-- the integer formed by the trailing decimal digits of `s` (e.g. "Tup3" → 3,
-- "$Tuple12" → 12).  Walks from the first digit to the end.
trailingIntOf : String -> Int
trailingIntOf s =
  let cs = stringToChars s
  trailingIntGo cs (firstDigitIdx cs 0) 0

firstDigitIdx : Array Char -> Int -> Int
firstDigitIdx cs i =
  if i >= arrayLength cs then
    i
  else if isDigitCh (charCode (arrayGetUnsafe i cs)) then
    i
  else
    firstDigitIdx cs (i + 1)

trailingIntGo : Array Char -> Int -> Int -> Int
trailingIntGo cs i acc =
  if i >= arrayLength cs then
    acc
  else
    trailingIntGo cs (i + 1) (acc * 10 + (charCode (arrayGetUnsafe i cs) - 48))

isDigitCh : Int -> Bool
isDigitCh c = c >= 48 && c <= 57

-- True if every char from index `i` to the end is a decimal digit (and there is at
-- least one).  Used to confirm a "Tup<n>" synthetic tuple ctor name.
allDigitsFrom : Array Char -> Int -> Bool
allDigitsFrom cs i = if i >= arrayLength cs then False else allDigitsGo cs i

allDigitsGo : Array Char -> Int -> Bool
allDigitsGo cs i =
  if i >= arrayLength cs then
    True
  else if isDigitCh (charCode (arrayGetUnsafe i cs)) then
    allDigitsGo cs (i + 1)
  else
    False

indent : List String -> List String
indent lines = map ("    " ++ _) lines

-- `indent` applied `d` times, but in ONE pass (#381).  The if/else CHAIN emitters
-- (emitLitSwitch{Ref,Tail}, emitDispatchChain) nest their own recursion inside
-- `indent`, so the k-th arm's text would be re-mapped — and every line
-- re-allocated — once per level above it: O(arms²) line copies for one chain.
-- Threading the depth and padding ONCE collapses that to one copy per line.  The
-- emitted text is unchanged: `indentBy d` is by construction `indent` iterated d
-- times, and `indentBy 0` is the identity.
indentBy : Int -> List String -> List String
indentBy d lines =
  let pad = indentPad d
  map (pad ++ _) lines

indentPad : Int -> String
indentPad d = joinWith "" (replicate d "    ")

gname : String -> String
-- A user identifier that is LITERALLY one of the codety ABI param names (`$self` /
-- `$args`, emitted as `(param ...)` on every lifted lambda / wrapper / extern-eta)
-- would collide with that param when it also becomes a `(local ...)` in the same body
-- → wasm-tools "duplicate local identifier".  Escape just those two reserved words so
-- the user var renders distinctly; consistent here means decl + local.get + local.set
-- (all routed through gname) stay in agreement.  Top-level fn/global names also flow
-- through gname, but a user binding named `self`/`args` is equally safe to rename there.
gname "self" = "u__self"
gname "args" = "u__args"
gname n =
  -- The `__wparg<digits>` family is reserved for synthetic positional fn params
  -- (synthParams).  A source var spelled identically would collide with a sibling
  -- positional param's wasm local — escape it so user vars stay distinct.
  if startsWith "__wparg" n && allDigitsFrom (stringToChars n) 7 then
    "u__" ++ n
  else
    n

notIn : List String -> String -> Bool
notIn xs x = not (contains x xs)

-- perf #382: dedup a String list keeping FIRST-seen order.  A `contains x acc`
-- membership test is O(kept) per element ⇒ O(k²), and `dedupKeep` is called ~20× across
-- emit (locals/free-var/num-poly/impl-value-use collection) — several on lists that grow
-- with program size, so the quadratic surfaced as superlinear wasm-emit OP counts on
-- dispatch-heavy code.  An OrdMap seen-set makes membership O(log k); `acc` still carries
-- the reversed first-seen order, so the deduped list is BYTE-IDENTICAL to the old result.
dedupKeep : List String -> List String
dedupKeep xs = reverseL (dedupGo xs omEmpty [])

dedupGo : List String -> OrdMap Unit -> List String -> List String
dedupGo [] _ acc = acc
dedupGo (x :: xs) seen acc =
  if omHasKey x seen then
    dedupGo xs seen acc
  else
    dedupGo xs (omInsert x () seen) (x :: acc)

fst : (a, b) -> a
fst (x, _) = x

sndPair : (String, String) -> String
sndPair (_, y) = y

isSome : Option a -> Bool
isSome (Some _) = True
isSome None = False

-- inclusive-exclusive integer range [lo, hi) as a list.
rangeList : Int -> Int -> List Int
rangeList lo hi = if lo >= hi then [] else lo :: rangeList (lo + 1) hi

tailList : List a -> List a
tailList [] = []
tailList (_ :: xs) = xs

nthArm : List CArm -> Int -> Option CArm
nthArm [] _ = None
nthArm (a :: rest) i = if i == 0 then Some a else nthArm rest (i - 1)

-- a readable tag for the unsupported-node gap message.
ctag : CExpr -> String
ctag (CApp _ _ _) = "CApp (application)"
ctag (CLam _ _) = "CLam (lambda — W4)"
ctag (CMatch _ _) = "CMatch (ordered-arm match — needs the decision-tree form)"
ctag (CDecision _ _ _) = "CDecision (match)"
ctag (CTuple _) = "CTuple (W7)"
ctag (CList _) = "CList (W7)"
ctag (CArray _) = "CArray (W7)"
ctag (CRecord _ _) = "CRecord (W7)"
ctag (CFieldAccess _ _ _ _) = "CFieldAccess (W7)"
ctag (CRecordUpdate _ _ _) = "CRecordUpdate (W7)"
ctag (CVariantUpdate _ _ _) = "CVariantUpdate (W7)"
ctag (CRangeList _ _ _) = "CRangeList (W7)"
ctag (CRangeArray _ _ _) = "CRangeArray (W7)"
ctag (CIndex _ _) = "CIndex (W7)"
ctag (CSlice _ _ _ _) = "CSlice (W7)"
ctag (CMethod _ _) = "CMethod (dispatch — W5)"
ctag (CDict _ _) = "CDict (dispatch — W5)"
ctag (CLetGroup _ _) = "CLetGroup (where/let-group — W4)"
ctag _ = "?"

-- a readable tag for an unsupported pattern.
ptag : Pat -> String
ptag (PVar _ _ _) = "PVar"
ptag PWild = "PWild"
ptag (PLit (LInt _)) = "PLit-LInt"
ptag (PLit (LFloat _)) = "PLit-LFloat"
ptag (PLit (LString _)) = "PLit-LString"
ptag (PLit (LChar _)) = "PLit-LChar"
ptag (PLit (LBool _)) = "PLit-LBool"
ptag (PLit LUnit) = "PLit-LUnit"
ptag (PCon _ _) = "PCon"
ptag (PTuple _) = "PTuple (W7)"
ptag (PCons _ _) = "PCons (list — W7)"
ptag (PList _) = "PList (list — W7)"
ptag (PAs _ _ _ _) = "PAs"
-- #380 (first half): without this arm a range-shaped residual gap fell to `_ = "?"` and
-- named no construct — which is why the #379 ledger rows read `… literal): ?`.
ptag (PRng _ _ _) = "PRng"
ptag _ = "?"

-- the W3 scope wall: any out-of-slice node lands here (an explicit hard stop).
gap : String -> a
gap msg = panic ("wasm_emit gap — " ++ msg)

plannedValBinds : EmitPlan -> List CBind -> List CBind
plannedValBinds plan groups =
  let binds = bindNameMap groups
  map
    (n => match omLookup n binds
      Some b => b
      None => panic ("internal error: global init: membership: " ++ n))
    plan.globalInit.eagerOrder

runtimeNameW : Prog -> String -> String
runtimeNameW prog symbol =
  optionOr "" (externRuntimeKey (progEmit prog).externFacts symbol)

externDisplayW : WasmEmit -> String -> String
externDisplayW emit symbol = match omLookup symbol emit.externFacts
  Some fact => fact.declaredName
  None => symbol

hasFamilyW : Prog -> String -> String -> Bool
hasFamilyW prog symbol tag =
  match (lookupAssoc
    (runtimeNameW prog symbol)
    (emitDemandW (progEmit prog)).catalogFamilies)
    Some family => WD.wasmFamilyTag family == tag
    None => False
