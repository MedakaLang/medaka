import backend.runtime_c_abi.{
  AbiType(..), AbiError(..), RuntimeAbiRow(..), runtimeAbiRows, renderAbiError
}
import backend.llvm_preamble.{
  RuntimeDecl(..), runtimeDecls, ffiRuntimeDecls, siteTrapDecls, siteTrapDecl,
  declareLine
}
import test.{expectAll, expectEqual, expectOkThen, expectAtLeast}

test "runtime descriptors classify representations and reject unknown types" = expectAll
  [
    expectEqual
      (Ok [
        RuntimeAbiRow {
          name = "f",
          result = AbiDouble,
          parameters = [AbiWord, AbiPointer],
          noReturn = False,
        },
      ])
      (runtimeAbiRows [RuntimeDecl "" "double" "f" ["i64", "ptr"] ""]),
    expectEqual
      (Err (UnknownAbiType "bad" "i16"))
      (runtimeAbiRows [RuntimeDecl "" "i16" "bad" [] ""]),
    expectEqual
      (Err (UnknownAbiType "ordinary" "{ i64, i1 }"))
      (runtimeAbiRows [
        RuntimeDecl "" "{ i64, i1 }" "ordinary" ["i64", "i64"] "",
      ]),
    expectEqual
      "bad: unknown ABI type: i16"
      (renderAbiError (UnknownAbiType "bad" "i16")),
    expectEqual
      (Err (VoidAbiParameter "bad_arg"))
      (runtimeAbiRows [RuntimeDecl "" "i64" "bad_arg" ["void"] ""]),
    expectEqual
      (Ok [
        RuntimeAbiRow {
          name = "argc",
          result = AbiVoid,
          parameters = [AbiInt32],
          noReturn = False,
        },
      ])
      (runtimeAbiRows [RuntimeDecl "" "void" "argc" ["i32"] ""]),
    expectEqual
      (Err (UnclassifiedIntrinsic "llvm.unknown"))
      (runtimeAbiRows [RuntimeDecl "" "i64" "llvm.unknown" [] ""]),
    expectOkThen
      (rows => expectAtLeast 1 (length rows))
      (runtimeAbiRows (runtimeDecls ++ ffiRuntimeDecls ++ siteTrapDecls)),
  ]

test "located traps and panic carry the emitted noreturn prototypes" = expectAll
  [
    expectEqual
      (Some "declare void @mdk_panic_at(i64, i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_panic")),
    expectEqual
      (Some "declare void @mdk_oob_at_at(i64, i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_oob_at")),
    expectEqual
      (Some "declare void @mdk_int_overflow_at(i64, i64, i64, i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_int_overflow")),
    expectEqual
      (Some "declare void @mdk_div_zero_at(i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_div_zero")),
    expectEqual
      (Some "declare void @mdk_mod_zero_at(i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_mod_zero")),
    expectEqual
      (Some "declare void @mdk_nonexhaustive_match_at(i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_nonexhaustive_match")),
    expectEqual
      (Some "declare void @mdk_let_refute_at(i64) noreturn")
      (map declareLine (siteTrapDecl "mdk_let_refute")),
    expectEqual None (siteTrapDecl "unknown"),
    expectEqual
      ["declare void @mdk_panic(i64) noreturn"]
      (map
        declareLine
        (filter
          (d => match d
            RuntimeDecl _ _ name _ _ => name == "mdk_panic")
          runtimeDecls)),
  ]
