-- Native physical ABI facts shared with the generated C header.

export
abiVersion : Int
abiVersion = 1

export
wordBytes : Int
wordBytes = 8

export
ctorTagShift : Int
ctorTagShift = 4294967296

export
reservedTypeBase : Int
reservedTypeBase = 65536

export
papHeader : Int
papHeader = -1

export
closureCodeSlot : Int
closureCodeSlot = 1

export
closureCaptureStart : Int
closureCaptureStart = 2

export
runtimeCallArgMax : Int
runtimeCallArgMax = 8

export
applyBufferArity : Int
applyBufferArity = 16

export
siteFileShift : Int
siteFileShift = 44

export
siteLineShift : Int
siteLineShift = 20

export
siteFileBits : Int
siteFileBits = 16

export
siteLineBits : Int
siteLineBits = 24

export
siteColumnBits : Int
siteColumnBits = 20

export
reservedCellTag : Int -> Int -> Int
reservedCellTag tid ordinal = (reservedTypeBase + tid) * ctorTagShift + ordinal

export
renderAbiHeader : Unit -> String
renderAbiHeader _ = stringConcat [
  "/* Generated by compiler/entries/runtime_layout_gen_main.mdk. */\n",
  "#ifndef MEDAKA_ABI_H\n",
  "#define MEDAKA_ABI_H\n",
  "\n",
  "#define MDK_ABI_VERSION \{intToString abiVersion}\n",
  "#define MDK_WORD_BYTES \{intToString wordBytes}\n",
  "#define MDK_TAG_SHIFT \{intToString ctorTagShift}LL\n",
  "#define MDK_RESERVED_BASE \{intToString reservedTypeBase}LL\n",
  "#define MDK_PAP_HEADER \{intToString papHeader}\n",
  "#define MDK_CLOSURE_CODE_SLOT \{intToString closureCodeSlot}\n",
  "#define MDK_CLOSURE_CAPTURE_START \{intToString closureCaptureStart}\n",
  "#define MDK_RUNTIME_CALL_ARG_MAX \{intToString runtimeCallArgMax}\n",
  "#define MDK_MAX_ARITY \{intToString applyBufferArity}\n",
  "#define MDK_SITE_FILE_SHIFT \{intToString siteFileShift}\n",
  "#define MDK_SITE_LINE_SHIFT \{intToString siteLineShift}\n",
  "#define MDK_SITE_FILE_BITS \{intToString siteFileBits}\n",
  "#define MDK_SITE_LINE_BITS \{intToString siteLineBits}\n",
  "#define MDK_SITE_COLUMN_BITS \{intToString siteColumnBits}\n",
  "#define MDK_TAG(tid, ord) (((MDK_RESERVED_BASE + (tid)) * MDK_TAG_SHIFT) + (ord))\n",
  "#define MDK_TAG_CONS MDK_TAG(0, 0)\n",
  "#define MDK_TAG_NIL MDK_TAG(0, 1)\n",
  "#define MDK_TAG_SOME MDK_TAG(1, 0)\n",
  "#define MDK_TAG_NONE MDK_TAG(1, 1)\n",
  "#define MDK_TAG_OK MDK_TAG(2, 0)\n",
  "#define MDK_TAG_ERR MDK_TAG(2, 1)\n",
  "#define MDK_TAG_LT MDK_TAG(3, 0)\n",
  "#define MDK_TAG_EQ MDK_TAG(3, 1)\n",
  "#define MDK_TAG_GT MDK_TAG(3, 2)\n",
  "#define MDK_BYTEBLOCK_TAG MDK_TAG(4, 0)\n",
  "#define MDK_U64_TAG MDK_TAG(5, 0)\n",
  "#define MDK_I64_TAG MDK_TAG(6, 0)\n",
  "#define MDK_PROCESS_INVALID_IO 13\n",
  "#define MDK_PROCESS_READ_FAILED 14\n",
  "#define MDK_PROCESS_WRITE_FAILED 15\n",
  "#define MDK_PROCESS_BUSY 17\n",
  "#define MDK_STR_TAG 1\n",
  "#define MDK_FLOAT_TAG 2\n",
  "#define MDK_TUPLE_TAG 6950939912435LL\n",
  "#define MDK_SITE_LINE_MASK ((1ULL << MDK_SITE_LINE_BITS) - 1)\n",
  "#define MDK_SITE_COLUMN_MASK ((1ULL << MDK_SITE_COLUMN_BITS) - 1)\n",
  "#define MDK_STRING_BYTE_LENGTH_SLOT 1\n",
  "#define MDK_STRING_CODEPOINT_LENGTH_SLOT 2\n",
  "#define MDK_STRING_BYTES_OFFSET 24\n",
  "#define MDK_ARRAY_LENGTH_SLOT 0\n",
  "#define MDK_ARRAY_ELEMENTS_SLOT 1\n",
  "#define MDK_BOX_PAYLOAD_SLOT 1\n",
  "#define MDK_CTOR_FIELDS_SLOT 1\n",
  "#define MDK_PAP_CLOSURE_SLOT 1\n",
  "#define MDK_PAP_COUNT_SLOT 2\n",
  "#define MDK_PAP_ARGS_SLOT 3\n",
  "_Static_assert(sizeof(long long) == MDK_WORD_BYTES, \"ABI word must be eight bytes\");\n",
  "_Static_assert(sizeof(void *) == MDK_WORD_BYTES, \"ABI pointer must fit a word\");\n",
  "_Static_assert(MDK_BYTEBLOCK_TAG == 281492156579840LL, \"ByteBlock tag\");\n",
  "_Static_assert(MDK_U64_TAG == 281496451547136LL, \"U64 tag\");\n",
  "_Static_assert(MDK_I64_TAG == 281500746514432LL, \"I64 tag\");\n",
  "#endif\n",
]
