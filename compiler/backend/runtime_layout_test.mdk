import backend.runtime_layout.{
  wordBytes, runtimeCallArgMax, applyBufferArity, reservedCellTag,
  closureCodeSlot, closureCaptureStart, renderAbiHeader
}
import test.{expectAll, expectEqual, expectOkThen}
import test_process.{medakaRoot}

test "native ABI facts and generated header agree" = expectAll [
  expectEqual 1 closureCodeSlot,
  expectEqual 2 closureCaptureStart,
  expectEqual 8 wordBytes,
  expectEqual 8 runtimeCallArgMax,
  expectEqual 16 applyBufferArity,
  expectEqual 281474976710656 (reservedCellTag 0 0),
  expectEqual 281492156579840 (reservedCellTag 4 0),
  expectOkThen
    (header => expectEqual (renderAbiHeader ()) header)
    (readFile "\{medakaRoot ()}/runtime/medaka_abi.h"),
]
