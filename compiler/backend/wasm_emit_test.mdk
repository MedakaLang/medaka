-- Sibling test for `compiler/backend/wasm_emit.mdk` ([P-TEST-SIBLING]): the pieces of
-- a method-table slot call that need no program around them.  A slot call itself is
-- pinned end to end by the wasm fixtures (`test/wasm/fixtures_modules`).

import backend.wasm_emit.{
  slotNullCheckW,
  slotFieldW,
  slotTypeLines,
  slotParamsW,
  gname,
  ImplG(..),
  ownValuesW,
}
import backend.emit_plan.{MethodSlot(..), SlotCallee(..)}
import frontend.ast.{Lit(..), Loc(..), Pat(..), noBinderId}
import ir.core_ir.{CClause(..), CExpr(..)}
import test.{expectAll, expectEqual}

-- A word that is no `$dict` (the `i31 0` of a null witness) must not be read as a
-- table: the check branches to `unreachable` before any field load.
test "a null word at a slot load traps at unreachable" =
  expectEqual
    [
      "local.get $\{gname "d"}",
      "ref.test (ref $dict)",
      "i32.eqz",
      "if",
      "  unreachable",
      "end",
    ]
    (slotNullCheckW "d")

test "a slot load reads the slot array field of the dictionary" =
  expectEqual
    [
      "local.get $\{gname "d"}",
      "ref.cast (ref $dict)",
      "struct.get $dict 2",
      "i32.const 3",
      "array.get $slotarr",
    ]
    (slotFieldW "d" 2 "$slotarr" 3)

-- A site with fewer or more arguments than the slot declares applies the slot's
-- closure through `$__mdk_apply`, never the slot's function.
test "a site whose argument count is not the declared one loads the slot's closure" =
  expectEqual
    [
      "local.get $\{gname "d"}",
      "ref.cast (ref $dict)",
      "struct.get $dict 3",
      "i32.const 1",
      "array.get $dictarr",
    ]
    (slotFieldW "d" 3 "$dictarr" 1)

-- `forgeOp : a -> a -> a` with the eta-short `forgeOp x = (effect; y => ..)` under
-- one leading dictionary: the define takes it and one value, so the closure takes
-- one value and the impl runs at the first value, not at the second.  The
-- dictionary is a `requires` of a supplied impl, or an inherited default's
-- receiver.
test "a slot's closure takes the impl's own value count, not the declared one" =
  let slot = MethodSlot { method = "forgeOp", contextDicts = 0, valueArity = 2 }
  let pat = x => PVar x (Loc "" 0 0 0 0) noBinderId
  let g =
    ImplG
      "forgeOp"
      ""
      ""
      2
      [CClause [pat "$dict_r", pat "x"] (CLit (LInt 0))]
      "f"
  expectAll [
    expectEqual
      1
      (ownValuesW
        slot
        SlotCallee { group = 0, inherited = False, declaredArity = 1 }
        g),
    expectEqual
      1
      (ownValuesW
        slot
        SlotCallee { group = 0, inherited = True, declaredArity = 1 }
        g),
  ]

test "the slot function types declared are exactly the demanded arities" =
  expectEqual
    [
      "    (type $slot2 (func (param (ref eq)) (param (ref eq)) (result (ref eq))))",
      "    (type $slot3 (func (param (ref eq)) (param (ref eq)) (param (ref eq)) (result (ref eq))))",
    ]
    (slotTypeLines ["dictarr", "slot3", "slot2", "slotarr"])

test "a slot function takes the dictionary, the method-level dictionaries, then the values" = expectAll
  [
    expectEqual
      "(param $sd (ref eq))"
      (slotParamsW MethodSlot {
        method = "m",
        contextDicts = 0,
        valueArity = 0,
      }),
    expectEqual
      "(param $sd (ref eq)) (param $sm0 (ref eq)) (param $sa0 (ref eq)) (param $sa1 (ref eq))"
      (slotParamsW MethodSlot {
        method = "m",
        contextDicts = 1,
        valueArity = 2,
      }),
  ]
