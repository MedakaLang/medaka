import support.sexp_value.{
  SExp(..),
  SexpError(..),
  SexpCursor,
  renderSExp,
  parseSExp,
  atomInt,
  atomBool,
  expectList,
  expectAtom,
  cursorOf,
  cursorFailed,
  cursorAtEnd,
  cursorOffset,
  cursorPeek,
  cursorOpen,
  cursorClose,
  cursorInt,
  cursorAtom,
  cursorChar,
  cursorList,
}
import list.{reverse}
import test.{expectAll, expectEqual, expectErr, expectTrue, expectFalse}

-- One atom per escape class.
classAtoms : List String
classAtoms = [
  "",
  "a b",
  "(",
  ")",
  "\"",
  "\\",
  "x\ny",
  "x\ty",
  ";",
  "café λ",
  "plain",
]

tree : List String -> SExp
tree atoms = SList [
  SList (map SAtom atoms),
  SAtom "k",
  SList [],
  SList [SList (map SAtom (reverse atoms))],
]

failure : String -> Result SexpError SExp -> (Int, String)
failure _ (Err (SexpError { seOffset, seWhat })) = (seOffset, seWhat)
failure label (Ok _) = (-1, label ++ ": parsed")

prop "render then parse round-trips generated atoms" (atoms : List String) =
  parseSExp (renderSExp (tree atoms)) == Ok (tree atoms)

prop "render is deterministic" (atoms : List String) =
  renderSExp (tree atoms) == renderSExp (tree atoms)

test "every escape class round-trips and renders deterministically" =
  expectAll
    (map
        (a => expectAll [
          expectEqual (Ok (SAtom a)) (parseSExp (renderSExp (SAtom a))),
          expectEqual (renderSExp (SAtom a)) (renderSExp (SAtom a)),
        ])
        classAtoms
      ++ [
        expectEqual
          (Ok (tree classAtoms))
          (parseSExp (renderSExp (tree classAtoms))),
      ])

test "canonical spelling" = expectAll [
  expectEqual
    "(a \"b c\" \"\" (d))"
    (renderSExp (SList [SAtom "a", SAtom "b c", SAtom "", SList [SAtom "d"]])),
  expectEqual "()" (renderSExp (SList [])),
  expectEqual "\"a\\\\b\\\"\\n\\t\"" (renderSExp (SAtom "a\\b\"\n\t")),
  expectEqual (Ok (SList [SAtom "a", SAtom "b"])) (parseSExp "  ( a\n b )  "),
]

test "the reader fails closed with the offset of the problem" = expectAll [
  expectEqual (0, "empty input") (failure "empty" (parseSExp "")),
  expectEqual (3, "empty input") (failure "blank" (parseSExp "   ")),
  expectEqual
    (0, "unbalanced open paren")
    (failure "open" (parseSExp "(a (b)")),
  expectEqual (0, "unbalanced close paren") (failure "close" (parseSExp ")")),
  expectEqual
    (4, "trailing text after the first node")
    (failure "trailing" (parseSExp "(a) b")),
  expectEqual
    (3, "trailing text after the first node")
    (failure "stray" (parseSExp "(a))")),
  expectEqual
    (3, "unterminated string")
    (failure "string" (parseSExp "(a \"bc)")),
  expectEqual (5, "bad escape") (failure "escape" (parseSExp "(a \"b\\qc\")")),
  expectEqual
    (3, "unterminated string")
    (failure "dangling" (parseSExp "(a \"b\\")),
  expectEqual
    (3, "unexpected character outside a quoted atom")
    (failure "semi" (parseSExp "(a ;b)")),
  expectEqual
    (0, "unexpected character outside a quoted atom")
    (failure "slash" (parseSExp "\\a")),
  expectEqual
    (2, "unexpected character inside a bare atom")
    (failure "quote" (parseSExp "(a\"b\")")),
]

test "the reader keeps its verdicts on quoted atoms and stray bytes" = expectAll
  [
    expectEqual (2, "bad escape") (failure "escape" (parseSExp "\"a\\qb\"")),
    expectEqual
      (0, "unterminated string")
      (failure "open quote" (parseSExp "\"x")),
    expectEqual (Ok (SAtom "a\nb")) (parseSExp "\"a\\nb\""),
    expectEqual (Ok (SAtom "café")) (parseSExp "\"café\""),
    expectEqual (Ok (SAtom "é\"é")) (parseSExp "\"é\\\"é\""),
    expectEqual (Ok (SList [SAtom "1", SAtom "-2"])) (parseSExp "(1 -2)"),
    expectEqual
      (2, "unexpected character inside a bare atom")
      (failure "backslash" (parseSExp "(a\\b)")),
    expectEqual
      (6, "trailing text after the first node")
      (failure "after close" (parseSExp "(a b) )")),
    expectEqual
      (1, "unbalanced open paren")
      (failure "nested open" (parseSExp "((")),
  ]

-- A decoder reading `(point 3 -4 "a\nb c" (x y))` straight off the bytes.
test "the cursor reads values off the bytes" =
  let cur = cursorOf " ( point 3 -4 \"a\\nb c\" (x y) ) "
  let _ = cursorOpen cur
  let head = cursorAtom cur
  let a = cursorInt cur
  let b = cursorInt cur
  let text = cursorAtom cur
  let rest = cursorList cursorAtom cur
  let _ = cursorClose cur
  expectAll [
    expectEqual "point" head,
    expectEqual (3, -4) (a, b),
    expectEqual "a\nb c" text,
    expectEqual ["x", "y"] rest,
    expectTrue (cursorAtEnd cur),
    expectFalse (cursorFailed cur),
  ]

-- After the first refusal every primitive is a no-op, so a decoder checks the
-- flag once and never acts on a half-read value.
test "the cursor fails closed and stays put" =
  let cur = cursorOf "(a 4x b)"
  let _ = cursorOpen cur
  let _ = cursorAtom cur
  let bad = cursorInt cur
  let at = cursorOffset cur
  let after = cursorAtom cur
  expectAll [
    expectEqual 0 bad,
    expectTrue (cursorFailed cur),
    expectEqual "" after,
    expectEqual at (cursorOffset cur),
    expectEqual (-1) (cursorPeek cur),
    expectFalse (cursorAtEnd cur),
  ]

-- The least `Int` is -4611686018427387904: its magnitude is not an `Int`, so
-- the reader carries the sum below zero.
test "the cursor reads the whole Int range and refuses past it" =
  let least = cursorOf "-4611686018427387904"
  let most = cursorOf "4611686018427387903"
  let pastLeast = cursorOf "-4611686018427387905"
  let pastMost = cursorOf "4611686018427387904"
  let huge = cursorOf "99999999999999999999"
  let a = cursorInt least
  let b = cursorInt most
  expectAll [
    expectEqual intMinBound a,
    expectEqual intMaxBound b,
    expectFalse (cursorFailed least),
    expectFalse (cursorFailed most),
    expectEqual 0 (cursorInt pastLeast),
    expectTrue (cursorFailed pastLeast),
    expectEqual 0 (cursorInt pastMost),
    expectTrue (cursorFailed pastMost),
    expectEqual 0 (cursorInt huge),
    expectTrue (cursorFailed huge),
  ]

test "a one-byte atom reads as its byte and a longer one is refused" =
  let ok = cursorOf " t f "
  let first = cursorChar ok
  let second = cursorChar ok
  let long = cursorOf "tf"
  let _ = cursorChar long
  expectAll [
    expectEqual (116, 102) (first, second),
    expectTrue (cursorAtEnd ok),
    expectTrue (cursorFailed long),
    expectEqual 0 (cursorOffset long),
  ]

test "the cursor refuses what the tree reader refuses" = expectAll [
  expectTrue (cursorFailed (failedAfter "\"a\\qb\"")),
  expectTrue (cursorFailed (failedAfter "\"ab")),
  expectTrue (cursorFailed (failedAfter "a\"b")),
  expectTrue (cursorFailed (failedAfter ")")),
  expectTrue (cursorFailed (failedAfter "")),
  expectFalse (cursorFailed (failedAfter "ok")),
]

failedAfter : String -> SexpCursor
failedAfter text =
  let cur = cursorOf text
  let _ = cursorAtom cur
  cur

test "node helpers accept the right shape and name the path on failure" = expectAll
  [
    expectEqual (Ok 42) (atomInt "n" (SAtom "42")),
    expectEqual (Ok True) (atomBool "b" (SAtom "true")),
    expectEqual (Ok False) (atomBool "b" (SAtom "false")),
    expectEqual (Ok "x") (expectAtom "a" (SAtom "x")),
    expectEqual (Ok [SAtom "x"]) (expectList 1 "l" (SList [SAtom "x"])),
    expectErr (atomInt "n" (SAtom "4x")),
    expectErr (atomInt "n" (SList [])),
    expectErr (atomBool "b" (SAtom "yes")),
    expectErr (expectAtom "a" (SList [])),
    expectErr (expectList 2 "l" (SList [SAtom "x"])),
    expectErr (expectList 0 "l" (SAtom "x")),
    expectEqual "n.field" (pathOf (atomInt "n.field" (SAtom "zz"))),
  ]

pathOf : Result SexpError a -> String
pathOf (Err (SexpError { sePath })) = sePath
pathOf (Ok _) = ""
