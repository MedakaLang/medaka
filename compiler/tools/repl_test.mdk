import test.{expectAll, expectEqual, expectTrue}
import list.{sort}
import frontend.parser.{parse}
import frontend.ast.{Decl}
import frontend.desugar.{desugar}
import types.typecheck.{checkOneScheme, defaultDriveInputs}
import types.repr.{ppScheme}
import tools.repl.{preludeBinderNames, endsWithKeyword, replResultScheme}

sortedUnique : List String -> List String
sortedUnique xs = dedupe (sort xs)

dedupe : List String -> List String
dedupe (a :: b :: rest)
  | a == b = dedupe (b :: rest)
  | otherwise = a :: dedupe (b :: rest)
dedupe xs = xs

-- The session-init name set must equal what the whole-graph check of the
-- prelude lists, so the REPL never prints a prelude binding as new.
test "prelude binder names equal the names a whole-graph check lists" = match (
  readFile "stdlib/runtime.mdk",
  readFile "stdlib/core.mdk",
)
  (Ok r, Ok c) =>
    let rd = desugar (parse r)
    let cd = desugar (parse c)
    expectAll [
      expectEqual
        (sortedUnique
          (map fst (checkOneScheme defaultDriveInputs rd [] ("__user__", cd))))
        (sortedUnique (preludeBinderNames cd)),
    ]
  _ => expectEqual "readable" "unreadable"

test "a trailing vertical tab or form feed does not hide a block-opening keyword" = expectAll
  [
    expectTrue (endsWithKeyword "x = where\u{0b}" "where"),
    expectTrue (endsWithKeyword "x = where\u{0c}" "where"),
  ]

-- The scheme the REPL prints for an expression, from the unit function it is wrapped in.
exprSchemeText : List Decl -> List Decl -> String -> String
exprSchemeText rd cd src =
  let user = desugar (parse "__repl__ () = \{src}\n")
  let schemes = checkOneScheme defaultDriveInputs rd cd ("__repl__", user)
  match find (p => fst p == "__repl__") schemes
    Some (_, sc) => match replResultScheme sc
      Some rs => ppScheme rs
      None => "not a function"
    None => "no __repl__"

test "an effectful REPL expression is a unit function whose value scheme keeps its row" =
  match (
    readFile "stdlib/runtime.mdk",
    readFile "stdlib/core.mdk",
  )
    (Ok r, Ok c) =>
      let rd = desugar (parse r)
      let cd = desugar (parse c)
      expectAll [
        expectEqual "<Stdout> Unit" (exprSchemeText rd cd "putStrLn \"hi\""),
        expectEqual "Int" (exprSchemeText rd cd "1 + 2"),
      ]
    _ => expectEqual "readable" "unreadable"
