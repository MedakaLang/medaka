-- Sibling test module for `compiler/tools/prop_runner.mdk`.
--
-- A `*_test.mdk` file lives beside its subject and is NOT compiler source:
-- excluded from the source fingerprint and the snapshot corpus. See
-- AGENTS.md's `[P-TEST-SIBLING]`.
--
-- Distribution regression for `rngNextLocal`'s bit extraction (#2344): before
-- the fix, an odd multiplier and odd increment made the low bit of
-- consecutive draws strictly alternate, so `randBoolL` drew a fixed
-- true/false/true/false… pattern instead of a genuine sample. This pins the
-- observable symptom directly against the runner's own private RNG
-- (`seedPropRng`/`randBoolL`), independent of any `prop`'s randomized-length
-- `List Bool` generation.

import test.{expectTrue}
import tools.prop_runner.{seedPropRng, randBoolL}

drawBools : Int -> List Bool
drawBools 0 = []
drawBools n = randBoolL () :: drawBools (n - 1)

hasTrue : List Bool -> Bool
hasTrue [] = False
hasTrue (x :: xs) = x || hasTrue xs

hasFalse : List Bool -> Bool
hasFalse [] = False
hasFalse (x :: xs) = not x || hasFalse xs

-- True iff every adjacent pair of draws differs — the exact pre-fix symptom.
strictlyAlternates : List Bool -> Bool
strictlyAlternates [] = True
strictlyAlternates (_ :: []) = True
strictlyAlternates (a :: b :: rest) = a /= b && strictlyAlternates (b :: rest)

test "a run of Bool draws hits both values and is not a fixed alternation" =
  let _ = seedPropRng 123456789
  let draws = drawBools 100
  expectTrue (hasTrue draws && hasFalse draws && not (strictlyAlternates draws))
