import driver.build_cmd.{makeTempDir, cleanupTempDir}
import test_process.{medakaBin, medakaRoot, boundedVerbSeconds}
import test.{
  Expectation, expectAll, expectEqual, expectTrue, expectNotEqual,
  expectTextContainsAll, fail
}
import json.{Json, parse, get, asArray, asString, asInt}
import string.{contains}

writeFixtures : String -> List (String, String) -> <IO> Result String Unit
writeFixtures _ [] = Ok ()
writeFixtures dir ((name, source) :: rest) = do
  _ <- writeFile "\{dir}/\{name}" source
  writeFixtures dir rest

withFixtures : List (String, String) ->
  (String -> <Exec, IO> Expectation) ->
  <Exec, IO> Expectation
withFixtures files inspect = match makeTempDir ()
  Err message => fail message
  Ok dir =>
    let manifest =
      ("medaka.toml", "[package]\nname = \"native_prop_acceptance\"\n")
    let result = match writeFixtures dir (manifest :: files)
      Err message => fail message
      Ok _ => inspect "\{dir}/main.mdk"
    let _ = cleanupTempDir dir
    result

runInvocation : List String ->
  String ->
  <Exec, IO> Result String (Int, String, String)
runInvocation options target =
  let args =
    [
        "MEDAKA_NATIVE_PROP_PROOF=compiled", medakaBin, "test", "--json",
        "--cases", "20", "--seed", "20261005"
      ]
      ++ options
      ++ [target]
  boundedVerbSeconds 120 "env" args

runReport : List String -> String -> <Exec, IO> Result String (Int, Json)
runReport options target = match runInvocation options target
  Err message => Err message
  Ok (code, out, err) =>
    if err /= "" then
      Err "unexpected runner stderr: \{err}"
    else
      map (report => (code, report)) (parse out)

propertyReports : Json -> List Json
propertyReports report = match flatMap asArray (get "properties" report)
  None => []
  Some rows => toList rows

field : String -> Json -> Option String
field name report = flatMap asString (get name report)

gradeReport : Int ->
  List (String, String, String) ->
  Result String (Int, Json) ->
  Expectation
gradeReport _ _ (Err message) = fail message
gradeReport expectedCode expected (Ok (code, report)) =
  let actual =
    map
      (row => (field "engine" row, field "name" row, field "status" row))
      (propertyReports report)
  expectAll [
    expectEqual expectedCode code,
    expectEqual
      (map
        ((engine, name, status) => (Some engine, Some name, Some status))
        expected)
      actual,
  ]

nativeOnlySource : String
nativeOnlySource =
  "prop \"native body proof\" (n : Int) = getEnv \"MEDAKA_NATIVE_PROP_PROOF\" == Some \"compiled\" && n == n\n"

test "default and explicit native properties execute compiled bodies" =
  withFixtures
    [("main.mdk", nativeOnlySource)]
    (target => expectAll [
      gradeReport
        0
        [("native", "native body proof", "pass")]
        (runReport [] target),
      gradeReport
        0
        [("native", "native body proof", "pass")]
        (runReport ["--native"] target),
    ])

test "combined engines retain a property result from each engine" =
  withFixtures
    [
      (
        "main.mdk",
        "import list.{reverse}\nprop \"both bodies\" (xs : List (Int, Bool)) = reverse (reverse xs) == xs\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("eval", "both bodies", "pass"), ("native", "both bodies", "pass")]
        (runReport ["--engines", "eval,native"] target))

test "native properties structurally generate an imported recursive applied ADT" =
  withFixtures
    [
      (
        "trees.mdk",
        "public export data Tree a = Leaf a | Fork (Tree a) (Tree a) deriving (Eq, Debug)\nexport\nmirror : Tree a -> Tree a\nmirror (Leaf x) = Leaf x\nmirror (Fork left right) = Fork (mirror right) (mirror left)\n",
      ),
      (
        "main.mdk",
        "import trees.{Tree, mirror}\nprop \"imported tree\" (tree : Tree Int) = mirror (mirror tree) == tree\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("native", "imported tree", "pass")]
        (runReport ["--native"] target))

test "custom shrinking runs on both property engines" =
  withFixtures
    [
      (
        "main.mdk",
        "data Wrap = Wrap Int deriving (Eq, Debug)\nimpl Arbitrary Wrap where\n  arbitrary () = Wrap 500\n  shrink (Wrap 0) = []\n  shrink (Wrap _) = [Wrap 0]\nprop \"custom shrink\" (w : Wrap) = False\n",
      ),
    ]
    (target =>
      let result = runReport ["--engines", "eval,native"] target
      let shrunk = match result
        Err _ => False
        Ok (_, report) =>
          all
            (row => match field "detail" row
              Some detail => contains "w = Wrap 0" detail
              None => False)
            (propertyReports report)
      expectAll [
        gradeReport
          1
          [
            ("eval", "custom shrink", "fail"),
            ("native", "custom shrink", "fail"),
          ]
          result,
        expectTrue shrunk,
      ])

test "native property generation covers builtin containers and tuples" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"containers\" (xs : Array Int) (pair : (Int, Bool, String)) (optional : Option Int) (result : Result Int Bool) = xs == xs && pair == pair && optional == optional && result == result\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("native", "containers", "pass")]
        (runReport ["--native"] target))

test "native property execution works for the core auto-prelude itself" =
  gradeReport
    0
    [("native", "neq is the negation of eq", "pass")]
    (runReport
      ["--native", "--filter", "neq is the negation of eq"]
      "\{medakaRoot}/stdlib/core.mdk")

test "native generators explore containers, characters and independent Boolean draws" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"nonempty strings are reachable\" (s : String) = stringLength s == 0\nprop \"characters vary\" (c : Char) = charCode c == 97\nprop \"longer lists are reachable\" (xs : List Int) = length xs <= 1\nprop \"equal Boolean pairs are reachable\" (x : Bool) (y : Bool) = x /= y\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [
          ("native", "nonempty strings are reachable", "fail"),
          ("native", "characters vary", "fail"),
          ("native", "longer lists are reachable", "fail"),
          ("native", "equal Boolean pairs are reachable", "fail"),
        ]
        (runReport ["--native"] target))

test "native recursive ADT generation reaches a recursive constructor" =
  withFixtures
    [
      (
        "trees.mdk",
        "public export data Tree a = Leaf a | Fork (Tree a) (Tree a) deriving (Eq, Debug)\n",
      ),
      (
        "main.mdk",
        "import trees.{Tree(..)}\nprop \"recursive constructors are reachable\" (tree : Tree Int) = match tree\n  Leaf _ => True\n  Fork _ _ => False\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [("native", "recursive constructors are reachable", "fail")]
        (runReport ["--native"] target))

pinEntry : String -> String
pinEntry engine =
  "[[pin]]\nfile = \"main.mdk\"\nkind = \"prop\"\nname = \"known false\"\nengine = \"\{engine}\"\nissue = 1\nseed = 1\ncases = 100\nfailure = \"false\"\n"

pinLedger : String
pinLedger = "version = 1\n\{pinEntry "eval"}\{pinEntry "native"}"

knownRedCount : Json -> Option Int
knownRedCount report =
  flatMap
    (summary => flatMap asInt (get "knownRed" summary))
    (get "summary" report)

test "known-red property pins execute fixed witnesses and report separate counts" =
  withFixtures
    [
      ("main.mdk", "prop \"known false\" (n : Int) = False\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      let result = runReport ["--engines", "eval,native"] target
      let metadata = match result
        Err _ => False
        Ok (_, report) =>
          knownRedCount report == Some 2
            && all
              (row =>
                flatMap asInt (get "issue" row) == Some 1
                  && flatMap asInt (get "seed" row) == Some 1
                  && flatMap asInt (get "cases" row) == Some 100)
              (propertyReports report)
      expectAll [
        gradeReport
          0
          [
            ("eval", "known false", "known-red"),
            ("native", "known false", "known-red"),
          ]
          result,
        expectTrue metadata,
      ])

test "a known-red property unexpectedly passing makes the run fail" =
  withFixtures
    [
      ("main.mdk", "prop \"known false\" (n : Int) = True\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "1", "unexpected"]
        (runInvocation ["--engines", "eval,native"] target))

test "a runtime error cannot satisfy a known-red law-failure pin" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"known false\" (n : Int) = panic \"different failure\"\n",
      ),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "different failure"]
        (runInvocation ["--native"] target))

test "a deleted pinned declaration stays loud despite a name filter" =
  withFixtures
    [
      ("main.mdk", "prop \"other law\" (n : Int) = True\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "pin"]
        (runInvocation ["--native", "--filter", "other law"] target))

gradeFailedInvocation : List String ->
  Result String (Int, String, String) ->
  Expectation
gradeFailedInvocation _ (Err message) = fail message
gradeFailedInvocation needles (Ok (code, out, err)) = expectAll [
  expectNotEqual 0 code,
  expectTextContainsAll needles (out ++ err),
]

unitPinEntry : String -> String
unitPinEntry engine =
  "[[pin]]\nfile = \"main.mdk\"\nkind = \"test\"\nname = \"known assertion\"\nengine = \"\{engine}\"\nissue = 1\ndetail_lines = [\"expected True but got False\"]\n"

unitPinLedger : String
unitPinLedger = "version = 1\n\{unitPinEntry "eval"}\{unitPinEntry "native"}"

unitReportRows : Json -> List Json
unitReportRows report = match flatMap asArray (get "tests" report)
  None => []
  Some rows => toList rows

test "known-red unit pins retain the exact assertion in both engines" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectTrue}\ntest \"known assertion\" = expectTrue False\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        expectEqual 0 code,
        expectEqual (Some 2) (knownRedCount report),
        expectEqual
          [
            (Some "eval", Some "known-red", Some 1),
            (Some "native", Some "known-red", Some 1),
          ]
          (map
            (row => (
              field "engine" row,
              field "status" row,
              flatMap asInt (get "issue" row),
            ))
            (unitReportRows report)),
      ])

test "a known-red unit passing drains its pin loudly" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectTrue}\ntest \"known assertion\" = expectTrue True\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known assertion", "1", "unexpected"]
        (runInvocation ["--engines", "eval,native"] target))

test "a changed assertion cannot satisfy a known-red unit pin" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectFalse}\ntest \"known assertion\" = expectFalse True\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known assertion", "1", "changed"]
        (runInvocation ["--native"] target))

test "property bodies must typecheck as Bool" =
  withFixtures
    [("main.mdk", "prop \"invalid result\" (n : Int) = n\n")]
    (target =>
      gradeFailedInvocation
        ["Bool", "Int"]
        (boundedVerbSeconds 120 medakaBin ["check", target]))
