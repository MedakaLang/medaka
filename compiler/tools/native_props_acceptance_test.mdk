import driver.build_cmd.{makeTempDir, cleanupTempDir}
import test_process.{medakaBin, medakaRoot, boundedVerbSeconds}
import test.{
  Expectation, expectAll, expectEqual, expectTrue, expectNotEqual,
  expectTextContainsAll, labelFail, fail
}
import json.{Json, parse, stringify, get, asArray, asString, asInt}
import string.{contains, lines}

writeFixtures : String -> List (String, String) -> <IO> Result String Unit
writeFixtures _ [] = Ok ()
writeFixtures dir ((name, source) :: rest) = do
  _ <- writeFile "\{dir}/\{name}" source
  writeFixtures dir rest

withFixtures : List (String, String) ->
  (String -> <Exec, IO> Expectation) ->
  <Exec, IO> Expectation
withFixtures files inspect = match makeTempDir ()
  Err message => fail message
  Ok dir =>
    let manifest =
      ("medaka.toml", "[package]\nname = \"native_prop_acceptance\"\n")
    let result = match writeFixtures dir (manifest :: files)
      Err message => fail message
      Ok _ => inspect "\{dir}/main.mdk"
    let _ = cleanupTempDir dir
    result

runInvocation : List String ->
  String ->
  <Exec, IO> Result String (Int, String, String)
runInvocation options target =
  let args =
    [
        "MEDAKA_NATIVE_PROP_PROOF=compiled", medakaBin, "test", "--json",
        "--cases", "20", "--seed", "20261005"
      ]
      ++ options
      ++ [target]
  boundedVerbSeconds 120 "env" args

runReport : List String -> String -> <Exec, IO> Result String (Int, Json)
runReport options target = match runInvocation options target
  Err message => Err message
  Ok (code, out, err) =>
    if err /= "" then
      Err "unexpected runner stderr: \{err}"
    else
      map (report => (code, report)) (parse out)

propertyReports : Json -> List Json
propertyReports report = match flatMap asArray (get "properties" report)
  None => []
  Some rows => toList rows

field : String -> Json -> Option String
field name report = flatMap asString (get name report)

gradeReport : Int ->
  List (String, String, String) ->
  Result String (Int, Json) ->
  Expectation
gradeReport _ _ (Err message) = fail message
gradeReport expectedCode expected (Ok (code, report)) =
  let actual =
    map
      (row => (field "engine" row, field "name" row, field "status" row))
      (propertyReports report)
  expectAll [
    labelFail (stringify report) (expectEqual expectedCode code),
    labelFail
      (stringify report)
      (expectEqual
        (map
          ((engine, name, status) => (Some engine, Some name, Some status))
          expected)
        actual),
  ]

nativeOnlySource : String
nativeOnlySource =
  "prop \"native body proof\" (n : Int) = getEnv \"MEDAKA_NATIVE_PROP_PROOF\" == Some \"compiled\" && n == n\n"

test "default and explicit native properties execute compiled bodies" =
  withFixtures
    [("main.mdk", nativeOnlySource)]
    (target => expectAll [
      gradeReport
        0
        [("native", "native body proof", "pass")]
        (runReport [] target),
      gradeReport
        0
        [("native", "native body proof", "pass")]
        (runReport ["--native"] target),
    ])

test "combined engines retain a property result from each engine" =
  withFixtures
    [
      (
        "main.mdk",
        "import list.{reverse}\nprop \"both bodies\" (xs : List (Int, Bool)) = reverse (reverse xs) == xs\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("eval", "both bodies", "pass"), ("native", "both bodies", "pass")]
        (runReport ["--engines", "eval,native"] target))

test "native properties structurally generate an imported recursive applied ADT" =
  withFixtures
    [
      (
        "trees.mdk",
        "public export data Tree a = Leaf a | Fork (Tree a) (Tree a) deriving (Eq, Debug)\nexport\nmirror : Tree a -> Tree a\nmirror (Leaf x) = Leaf x\nmirror (Fork left right) = Fork (mirror right) (mirror left)\n",
      ),
      (
        "main.mdk",
        "import trees.{Tree, mirror}\nprop \"imported tree\" (tree : Tree Int) = mirror (mirror tree) == tree\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("native", "imported tree", "pass")]
        (runReport ["--native"] target))

test "custom shrinking runs on both property engines" =
  withFixtures
    [
      (
        "main.mdk",
        "data Wrap = Wrap Int\nimpl Arbitrary Wrap where\n  arbitrary () = Wrap 500\n  shrink (Wrap 0) = []\n  shrink (Wrap _) = [Wrap 0]\nprop \"custom shrink\" (w : Wrap) = False\n",
      ),
    ]
    (target =>
      let result = runReport ["--engines", "eval,native"] target
      let shrunk = match result
        Err _ => False
        Ok (_, report) =>
          all
            (row => match field "detail" row
              Some detail => contains "w = Wrap 0" detail
              None => False)
            (propertyReports report)
      expectAll [
        gradeReport
          1
          [
            ("eval", "custom shrink", "fail"),
            ("native", "custom shrink", "fail"),
          ]
          result,
        expectTrue shrunk,
      ])

test "native property generation covers builtin containers and tuples" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"containers\" (xs : Array Int) (pair : (Int, Bool, String)) (optional : Option Int) (result : Result Int Bool) = xs == xs && pair == pair && optional == optional && result == result\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("native", "containers", "pass")]
        (runReport ["--native"] target))

test "native property execution works for the core auto-prelude itself" =
  gradeReport
    0
    [("native", "neq is the negation of eq", "pass")]
    (runReport
      ["--native", "--filter", "neq is the negation of eq"]
      "\{medakaRoot}/stdlib/core.mdk")

test "native generators explore containers, characters and independent Boolean draws" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"nonempty strings are reachable\" (s : String) = stringLength s == 0\nprop \"characters vary\" (c : Char) = charCode c == 97\nprop \"longer lists are reachable\" (xs : List Int) = length xs <= 1\nprop \"equal Boolean pairs are reachable\" (x : Bool) (y : Bool) = x /= y\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [
          ("native", "nonempty strings are reachable", "fail"),
          ("native", "characters vary", "fail"),
          ("native", "longer lists are reachable", "fail"),
          ("native", "equal Boolean pairs are reachable", "fail"),
        ]
        (runReport ["--native"] target))

test "native recursive ADT generation reaches a recursive constructor" =
  withFixtures
    [
      (
        "trees.mdk",
        "public export data Tree a = Leaf a | Fork (Tree a) (Tree a) deriving (Eq, Debug)\n",
      ),
      (
        "main.mdk",
        "import trees.{Tree(..)}\nprop \"recursive constructors are reachable\" (tree : Tree Int) = match tree\n  Leaf _ => True\n  Fork _ _ => False\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [("native", "recursive constructors are reachable", "fail")]
        (runReport ["--native"] target))

pinEntry : String -> String
pinEntry engine =
  "[[pin]]\nfile = \"main.mdk\"\nkind = \"prop\"\nname = \"known false\"\nengine = \"\{engine}\"\nissue = 1\nseed = 1\ncases = 100\nfailure = \"false\"\n"

pinLedger : String
pinLedger = "version = 1\n\{pinEntry "eval"}\{pinEntry "native"}"

knownRedCount : Json -> Option Int
knownRedCount report = summaryCount "knownRed" report

summaryCount : String -> Json -> Option Int
summaryCount name report =
  flatMap (summary => flatMap asInt (get name summary)) (get "summary" report)

test "known-red property pins execute fixed witnesses and report separate counts" =
  withFixtures
    [
      ("main.mdk", "prop \"known false\" (n : Int) = False\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      let result = runReport ["--engines", "eval,native"] target
      let metadata = match result
        Err _ => False
        Ok (_, report) =>
          knownRedCount report == Some 2
            && summaryCount "passed" report == Some 0
            && summaryCount "failed" report == Some 0
            && all
              (row =>
                flatMap asInt (get "issue" row) == Some 1
                  && flatMap asInt (get "seed" row) == Some 1
                  && flatMap asInt (get "cases" row) == Some 100)
              (propertyReports report)
      expectAll [
        gradeReport
          0
          [
            ("eval", "known false", "known-red"),
            ("native", "known false", "known-red"),
          ]
          result,
        expectTrue metadata,
      ])

test "a known-red property unexpectedly passing makes the run fail" =
  withFixtures
    [
      ("main.mdk", "prop \"known false\" (n : Int) = True\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "1", "unexpected"]
        (runInvocation ["--engines", "eval,native"] target))

test "a runtime error cannot satisfy a known-red law-failure pin" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"known false\" (n : Int) = panic \"different failure\"\n",
      ),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "different failure"]
        (runInvocation ["--native"] target))

test "a deleted pinned declaration stays loud despite a name filter" =
  withFixtures
    [
      ("main.mdk", "prop \"other law\" (n : Int) = True\n"),
      ("medaka-test-pins.toml", pinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known false", "pin"]
        (runInvocation ["--native", "--filter", "other law"] target))

gradeFailedInvocation : List String ->
  Result String (Int, String, String) ->
  Expectation
gradeFailedInvocation _ (Err message) = fail message
gradeFailedInvocation needles (Ok (code, out, err)) = expectAll [
  expectNotEqual 0 code,
  expectTextContainsAll needles (out ++ err),
]

unitPinEntry : String -> String
unitPinEntry engine =
  "[[pin]]\nfile = \"main.mdk\"\nkind = \"test\"\nname = \"known assertion\"\nengine = \"\{engine}\"\nissue = 1\nfailure = \"assertion\"\ndetail_lines = [\"expected True but got False\"]\n"

unitPinLedger : String
unitPinLedger = "version = 1\n\{unitPinEntry "eval"}\{unitPinEntry "native"}"

unitReportRows : Json -> List Json
unitReportRows report = match flatMap asArray (get "tests" report)
  None => []
  Some rows => toList rows

test "known-red unit pins retain the exact assertion in both engines" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectTrue}\ntest \"known assertion\" = expectTrue False\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        expectEqual 0 code,
        expectEqual (Some 2) (knownRedCount report),
        expectEqual (Some 0) (summaryCount "passed" report),
        expectEqual (Some 0) (summaryCount "failed" report),
        expectEqual
          [
            (Some "eval", Some "known-red", Some "fail", Some 1),
            (Some "native", Some "known-red", Some "fail", Some 1),
          ]
          (map
            (row => (
              field "engine" row,
              field "status" row,
              field "rawStatus" row,
              flatMap asInt (get "issue" row),
            ))
            (unitReportRows report)),
      ])

test "a known-red unit passing drains its pin loudly" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectTrue}\ntest \"known assertion\" = expectTrue True\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known assertion", "1", "unexpected"]
        (runInvocation ["--engines", "eval,native"] target))

test "a changed assertion cannot satisfy a known-red unit pin" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectFalse}\ntest \"known assertion\" = expectFalse True\n",
      ),
      ("medaka-test-pins.toml", unitPinLedger),
    ]
    (target =>
      gradeFailedInvocation
        ["known assertion", "1", "changed"]
        (runInvocation ["--native"] target))

test "property bodies must typecheck as Bool" =
  withFixtures
    [("main.mdk", "prop \"invalid result\" (n : Int) = n\n")]
    (target =>
      gradeFailedInvocation
        ["Bool", "Int"]
        (boundedVerbSeconds 120 medakaBin ["check", target]))

test "same-spelled imported ADTs retain their declaring identities" =
  withFixtures
    [
      (
        "numbers.mdk",
        "public export data Box = NumberBox Int deriving (Eq, Debug)\n",
      ),
      (
        "flags.mdk",
        "public export data Box = FlagBox Bool deriving (Eq, Debug)\n",
      ),
      (
        "main.mdk",
        "import numbers as N\nimport flags as F\nprop \"nominal boxes\" (number : N.Box) (flag : F.Box) = match number\n  N.NumberBox n => match flag\n    F.FlagBox b => n == n && b == b\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("eval", "nominal boxes", "pass"), ("native", "nominal boxes", "pass")]
        (runReport ["--engines", "eval,native"] target))

test "same-spelled imported types select their own custom generators" =
  withFixtures
    [
      (
        "numbers.mdk",
        "public export data Box = NumberBox Int deriving (Eq, Debug)\nexport impl Arbitrary Box where\n  arbitrary () = NumberBox 500\n  shrink _ = []\n",
      ),
      (
        "flags.mdk",
        "public export data Box = FlagBox Int deriving (Eq, Debug)\nexport impl Arbitrary Box where\n  arbitrary () = FlagBox 900\n  shrink _ = []\n",
      ),
      (
        "main.mdk",
        "import numbers as N\nimport flags as F\nprop \"custom nominal boxes\" (number : N.Box) (flag : F.Box) = match number\n  N.NumberBox n => match flag\n    F.FlagBox f => n == 500 && f == 900\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "custom nominal boxes", "pass"),
          ("native", "custom nominal boxes", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "both generators support named constructor fields without a Debug instance" =
  withFixtures
    [
      (
        "main.mdk",
        "data Sample = Sample { sampleCount : Int, sampleFlag : Bool }\nprop \"named fields\" (sample : Sample) = sample.sampleCount == sample.sampleCount && sample.sampleFlag == sample.sampleFlag\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [("eval", "named fields", "pass"), ("native", "named fields", "pass")]
        (runReport ["--engines", "eval,native"] target))

test "unsupported property parameters produce a named capability error" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"function generation is unsupported\" (f : Int -> Int) = True\nprop \"supported neighbor still runs\" (n : Int) = n == n\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        expectNotEqual 0 code,
        expectEqual
          [
            (
              Some "eval",
              Some "function generation is unsupported",
              Some "error",
              Some "capability",
            ),
            (
              Some "eval",
              Some "supported neighbor still runs",
              Some "pass",
              None,
            ),
            (
              Some "native",
              Some "function generation is unsupported",
              Some "error",
              Some "capability",
            ),
            (
              Some "native",
              Some "supported neighbor still runs",
              Some "pass",
              None,
            ),
          ]
          (map
            (row => (
              field "engine" row,
              field "name" row,
              field "status" row,
              field "failureKind" row,
            ))
            (propertyReports report)),
      ])

runSeededReport : Int -> String -> <Exec, IO> Result String (Int, Json)
runSeededReport seed target = match boundedVerbSeconds 120 medakaBin [
  "test",
  "--json",
  "--engines",
  "eval,native",
  "--cases",
  "20",
  "--seed",
  intToString seed,
  target,
]
  Err message => Err message
  Ok (code, out, err) =>
    if err /= "" then
      Err "unexpected runner stderr: \{err}"
    else
      map (report => (code, report)) (parse out)

drawCounterexamples : Result String (Int, Json) -> List (List String)
drawCounterexamples (Err _) = []
drawCounterexamples (Ok (_, report)) =
  map
    (row =>
      let detail = match field "detail" row
        Some text => text
        None => ""
      filter (contains "x = Draw") (lines detail))
    (propertyReports report)

randomArbitrarySource : String
randomArbitrarySource =
  "data Draw = Draw Int deriving (Eq, Debug)\nimpl Arbitrary Draw where\n  arbitrary () = Draw (randomInt (-1000000) 1000000)\n  shrink _ = []\n"

test "custom Arbitrary random draws replay the requested seed" =
  withFixtures
    [
      (
        "main.mdk",
        randomArbitrarySource
          ++ "prop \"random draw replay\" (x : Draw) = False\n",
      ),
    ]
    (target =>
      let first = runSeededReport 1 target
      let repeated = runSeededReport 1 target
      let changed = runSeededReport 2 target
      let expectedRows = [
        ("eval", "random draw replay", "fail"),
        ("native", "random draw replay", "fail"),
      ]
      expectAll [
        gradeReport 1 expectedRows first,
        gradeReport 1 expectedRows repeated,
        gradeReport 1 expectedRows changed,
        expectEqual (drawCounterexamples first) (drawCounterexamples repeated),
        expectNotEqual
          (drawCounterexamples first)
          (drawCounterexamples changed),
        expectTrue (all (rows => length rows == 1) (drawCounterexamples first)),
      ])

test "custom Arbitrary draws leave the program random stream intact" =
  withFixtures
    [
      (
        "main.mdk",
        randomArbitrarySource
          ++ "prop \"isolated custom stream\" (x : Draw) = randomState () == (0 : U64)\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "isolated custom stream", "pass"),
          ("native", "isolated custom stream", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "custom Arbitrary takes priority over structural construction" =
  withFixtures
    [
      (
        "main.mdk",
        "data Wrap = Wrap Int\nimpl Arbitrary Wrap where\n  arbitrary () = Wrap 500\n  shrink (Wrap _) = [Wrap 0]\nprop \"custom generator priority\" (w : Wrap) = match w\n  Wrap n => n == 500\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "custom generator priority", "pass"),
          ("native", "custom generator priority", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "both engines shrink later candidates and every parameter repeatedly" =
  withFixtures
    [
      (
        "main.mdk",
        "data Wrap = Wrap Int\nimpl Arbitrary Wrap where\n  arbitrary () = Wrap 100\n  shrink (Wrap 100) = [Wrap 0, Wrap 50]\n  shrink (Wrap 50) = [Wrap 0, Wrap 25]\n  shrink (Wrap 25) = [Wrap 0, Wrap 5]\n  shrink (Wrap _) = [Wrap 0, Wrap 1]\nprop \"two shrinking parameters\" (left : Wrap) (right : Wrap) = match (left, right)\n  (Wrap a, Wrap b) => a < 5 || b < 5\n",
      ),
    ]
    (target =>
      let result = runReport ["--engines", "eval,native"] target
      let minimal = match result
        Err _ => False
        Ok (_, report) =>
          all
            (row => match field "detail" row
              Some detail =>
                contains "left = Wrap 5" detail
                  && contains "right = Wrap 5" detail
              None => False)
            (propertyReports report)
      expectAll [
        gradeReport
          1
          [
            ("eval", "two shrinking parameters", "fail"),
            ("native", "two shrinking parameters", "fail"),
          ]
          result,
        expectTrue minimal,
      ])

test "a failing eval law still executes and labels native in a human report" =
  withFixtures
    [("main.mdk", "prop \"both failures\" (n : Int) = False\n")]
    (target =>
      gradeFailedInvocation
        ["both failures", "[eval]", "[native]"]
        (boundedVerbSeconds 120 medakaBin [
          "test",
          "--engines",
          "eval,native",
          "--cases",
          "3",
          "--seed",
          "1",
          target,
        ]))

gradeCapabilityNeighbor : String -> Result String (Int, Json) -> Expectation
gradeCapabilityNeighbor _ (Err message) = fail message
gradeCapabilityNeighbor name (Ok (code, report)) = expectAll [
  expectNotEqual 0 code,
  expectEqual
    [
      (Some "eval", Some name, Some "error", Some "capability"),
      (Some "eval", Some "neighbor", Some "pass", None),
      (Some "native", Some name, Some "error", Some "capability"),
      (Some "native", Some "neighbor", Some "pass", None),
    ]
    (map
      (row => (
        field "engine" row,
        field "name" row,
        field "status" row,
        field "failureKind" row,
      ))
      (propertyReports report)),
]

test "recursive types with no finite value fail planning without blocking a neighbor" =
  withFixtures
    [
      (
        "main.mdk",
        "data Loop = Again Loop\nprop \"no finite value\" (x : Loop) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "no finite value"
        (runReport ["--engines", "eval,native"] target))

test "imported abstract constructors cannot leak through structural generation" =
  withFixtures
    [
      ("hidden.mdk", "export data Hidden = Hidden Int\n"),
      (
        "main.mdk",
        "import hidden.{Hidden}\nprop \"hidden constructors\" (x : Hidden) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "hidden constructors"
        (runReport ["--engines", "eval,native"] target))

test "exported newtypes keep their constructors private during structural generation" =
  withFixtures
    [
      ("wrapped.mdk", "export newtype Wrapped = Wrapped Int\n"),
      (
        "main.mdk",
        "import wrapped.{Wrapped}\nprop \"private newtype constructor\" (x : Wrapped) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "private newtype constructor"
        (runReport ["--engines", "eval,native"] target))

gradeMinimized : String ->
  List String ->
  Result String (Int, Json) ->
  Expectation
gradeMinimized _ _ (Err message) = fail message
gradeMinimized name fragments (result@(Ok (_, report))) = expectAll [
  gradeReport 1 [("eval", name, "fail"), ("native", name, "fail")] result,
  expectAll
    (map
      (row => match field "detail" row
        None => fail "missing counterexample detail"
        Some detail => expectTextContainsAll fragments detail)
      (propertyReports report)),
]

test "both structural list shrinkers retain only the minimal failing length" =
  withFixtures
    [("main.mdk", "prop \"minimum list\" (xs : List Int) = length xs < 2\n")]
    (target =>
      gradeMinimized
        "minimum list"
        ["xs = [0, 0]"]
        (runReport ["--engines", "eval,native"] target))

test "both structural tuple shrinkers reduce each component" =
  withFixtures
    [
      (
        "main.mdk",
        "prop \"minimum tuple\" (pair : (Int, Bool)) = fst pair < 5 || snd pair\n",
      ),
    ]
    (target =>
      gradeMinimized
        "minimum tuple"
        ["pair = (5, False)"]
        (runReport ["--engines", "eval,native"] target))

test "named nominal fields shrink and display without a Debug instance" =
  withFixtures
    [
      (
        "main.mdk",
        "data Sample = Sample { sampleCount : Int, sampleFlag : Bool }\nprop \"minimum record\" (sample : Sample) = sample.sampleCount < 5 || sample.sampleFlag\n",
      ),
    ]
    (target =>
      gradeMinimized
        "minimum record"
        ["sampleCount = 5", "sampleFlag = False"]
        (runReport ["--engines", "eval,native"] target))

test "recursive plans inside containers terminate and reach recursive constructors" =
  withFixtures
    [
      (
        "main.mdk",
        "data Tree a = Leaf a | Fork (List (Tree a)) deriving Eq\nleafOnly : Tree a -> Bool\nleafOnly (Leaf _) = True\nleafOnly (Fork _) = False\nprop \"nested recursion\" (trees : List (Tree Int)) = trees == trees\nprop \"recursive branch reached\" (trees : List (Tree Int)) = all leafOnly trees\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [
          ("eval", "nested recursion", "pass"),
          ("eval", "recursive branch reached", "fail"),
          ("native", "nested recursion", "pass"),
          ("native", "recursive branch reached", "fail"),
        ]
        (runReport ["--engines", "eval,native", "--cases", "100"] target))

test "changing recursive type arguments can produce finite generated values" =
  withFixtures
    [
      (
        "main.mdk",
        "data Loop = Again Loop\ndata Rotate a b c = RotateNext (Rotate b c (List a)) | RotateEnd a\nprop \"finite changing arguments\" (value : Rotate Loop Loop Loop) = True\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "finite changing arguments", "pass"),
          ("native", "finite changing arguments", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "an expected native abort pin preserves later ordinary test execution" =
  withFixtures
    [
      (
        "verdict.mdk",
        "public export data Verdict = Pass String String | Fail String String String\nexport\nisFailure : Verdict -> Bool\nisFailure (Fail _ _ _) = True\nisFailure (Pass _ _) = False\n",
      ),
      (
        "main.mdk",
        "import test as TestAlias\nimport verdict.{Verdict(..), isFailure}\ntest \"known native abort\" = TestAlias.expectTrue (isFailure (Fail \"detail\" \"left\" \"right\"))\ntest \"later ordinary test\" = TestAlias.expectEqual 1 1\n",
      ),
      (
        "medaka-test-pins.toml",
        "version = 1\n[[pin]]\nfile = \"main.mdk\"\nkind = \"test\"\nname = \"known native abort\"\nengine = \"native\"\nissue = 3857\nfailure = \"error\"\ndetail_lines = [\"native test run ended (probe exit 1) — runtime error [E-NONEXHAUSTIVE-MATCH]: non-exhaustive match; the abort happened while this test was running\"]\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        expectEqual 0 code,
        expectEqual (Some 1) (knownRedCount report),
        expectEqual (Some 3) (summaryCount "passed" report),
        expectEqual (Some 0) (summaryCount "failed" report),
        expectEqual
          [
            (Some "eval", Some "known native abort", Some "pass", Some "pass"),
            (Some "eval", Some "later ordinary test", Some "pass", Some "pass"),
            (
              Some "native",
              Some "known native abort",
              Some "known-red",
              Some "error",
            ),
            (
              Some "native",
              Some "later ordinary test",
              Some "pass",
              Some "pass",
            ),
          ]
          (map
            (row => (
              field "engine" row,
              field "name" row,
              field "status" row,
              field "rawStatus" row,
            ))
            (unitReportRows report)),
      ])

test "unsupported fields remain capability errors when another constructor is finite" =
  withFixtures
    [
      (
        "main.mdk",
        "data Choice = Number Int | Function (Int -> Int)\nprop \"unsupported constructor field\" (value : Choice) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "unsupported constructor field"
        (runReport ["--engines", "eval,native"] target))

test "abstract imported types can use their custom generators without exposing constructors" =
  withFixtures
    [
      (
        "hidden.mdk",
        "export data Hidden = Secret Int\nexport impl Arbitrary Hidden where\n  arbitrary () = Secret 500\n  shrink _ = []\nexport\nisValid : Hidden -> Bool\nisValid (Secret n) = n == 500\n",
      ),
      (
        "main.mdk",
        "import hidden.{Hidden, isValid}\nprop \"abstract custom value\" (value : Hidden) = isValid value\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "abstract custom value", "pass"),
          ("native", "abstract custom value", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

negativeReplayPin : String -> String -> String
negativeReplayPin engine name =
  "[[pin]]\nfile = \"main.mdk\"\nkind = \"prop\"\nname = \"\{name}\"\nengine = \"\{engine}\"\nissue = 1\nseed = -9\ncases = 20\nfailure = \"false\"\n"

negativeReplayLedger : String
negativeReplayLedger =
  "version = 1\n\{negativeReplayPin "eval" "negative structural seed"}\{negativeReplayPin "eval" "negative custom seed"}\{negativeReplayPin "native" "negative structural seed"}\{negativeReplayPin "native" "negative custom seed"}"

test "signed request seeds preserve the structural domain and complete custom RNG state" =
  withFixtures
    [
      (
        "main.mdk",
        "import u64 as U\ndata SeedCheck = SeedCheck Bool\nimpl Arbitrary SeedCheck where\n  arbitrary () = SeedCheck (randomState () == U.truncate (0 - 9))\n  shrink _ = []\nprop \"negative structural seed\" (n : Int) = n >= (0 - 1000) && n <= 1000\nprop \"negative custom seed\" (value : SeedCheck) = match value\n  SeedCheck correct => correct\n",
      ),
      ("medaka-test-pins.toml", negativeReplayLedger),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        expectEqual 1 code,
        expectEqual (Some 0) (knownRedCount report),
        expectEqual (Some 4) (summaryCount "failed" report),
        expectEqual
          [Some "pass", Some "pass", Some "pass", Some "pass"]
          (map (field "rawStatus") (propertyReports report)),
        expectEqual
          [Some (0 - 9), Some (0 - 9), Some (0 - 9), Some (0 - 9)]
          (map (row => flatMap asInt (get "seed" row)) (propertyReports report)),
      ])

test "user parameter names cannot shadow native runner counters and shrink locals" =
  withFixtures
    [
      (
        "main.mdk",
        "calls : Ref Int\ncalls = Ref 0\nprop \"runner local names\" (remaining : Int) (fuel : Int) (candidate : Int) =\n  let prior = !calls\n  let _ = calls := prior + 1\n  remaining == remaining && fuel == fuel && candidate == candidate\nprop \"budget observer\" (n : Int) = !calls == 20 && n == n\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "runner local names", "pass"),
          ("eval", "budget observer", "pass"),
          ("native", "runner local names", "pass"),
          ("native", "budget observer", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "unrelated generic declarations cannot change finite capability planning" =
  withFixtures
    [
      (
        "main.mdk",
        "data Loop = Again Loop\ndata Unused a b c d e f g h i j k l m n o p q r s t u v w x y = UnusedInt Int\nprop \"no finite value\" (value : Loop) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "no finite value"
        (runReport ["--engines", "eval,native"] target))

test "structural floats stay bounded and reach fractional values on both sides of zero" =
  withFixtures
    [
      (
        "main.mdk",
        "extern floor : Float -> Float\nprop \"float domain\" (value : Float) = value >= (0.0 - 1.0) && value <= 1.0\nprop \"only integral floats\" (value : Float) = value == floor value\nprop \"only nonpositive floats\" (value : Float) = value <= 0.0\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [
          ("eval", "float domain", "pass"),
          ("eval", "only integral floats", "fail"),
          ("eval", "only nonpositive floats", "fail"),
          ("native", "float domain", "pass"),
          ("native", "only integral floats", "fail"),
          ("native", "only nonpositive floats", "fail"),
        ]
        (runReport ["--engines", "eval,native", "--cases", "100"] target))

test "applied mutual recursion without a base remains a bounded capability error" =
  withFixtures
    [
      (
        "main.mdk",
        "data A = Wrap (B A)\ndata B a = Pack a\nprop \"no finite value\" (value : A) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "no finite value"
        (runReport ["--engines", "eval,native"] target))

test "custom generators and shrinkers select the complete applied carrier" =
  withFixtures
    [
      (
        "main.mdk",
        "data Box a = Box a\nimpl Arbitrary (Box Int) where\n  arbitrary () = Box 500000\n  shrink (Box 0) = []\n  shrink _ = [Box 0]\nimpl Arbitrary (Box String) where\n  arbitrary () = Box \"custom string\"\n  shrink (Box \"\") = []\n  shrink _ = [Box \"\"]\nprop \"applied integer generator\" (value : Box Int) = match value\n  Box n => n == 500000\nprop \"applied string generator\" (value : Box String) = match value\n  Box text => text == \"custom string\"\nprop \"applied integer shrink\" (value : Box Int) = False\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          1
          [
            ("eval", "applied integer generator", "pass"),
            ("eval", "applied string generator", "pass"),
            ("eval", "applied integer shrink", "fail"),
            ("native", "applied integer generator", "pass"),
            ("native", "applied string generator", "pass"),
            ("native", "applied integer shrink", "fail"),
          ]
          (Ok (code, report)),
        expectTrue
          (all
            (row => match field "detail" row
              Some detail =>
                contains "value = Box (0)" detail
                  || contains "value = Box 0" detail
              None => False)
            (filter
              (row => field "name" row == Some "applied integer shrink")
              (propertyReports report))),
      ])

test "abstract custom counterexamples preserve module privacy on both engines" =
  withFixtures
    [
      (
        "hidden.mdk",
        "export data Hidden = Secret Int\nexport impl Arbitrary Hidden where\n  arbitrary () = Secret 500000\n  shrink _ = []\n",
      ),
      (
        "main.mdk",
        "import hidden.{Hidden}\nprop \"private counterexample\" (value : Hidden) = False\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          1
          [
            ("eval", "private counterexample", "fail"),
            ("native", "private counterexample", "fail"),
          ]
          (Ok (code, report)),
        expectTrue
          (all
            (row => match field "detail" row
              Some detail =>
                contains "<Hidden>" detail
                  && not (contains "Secret" detail)
                  && not (contains "500000" detail)
              None => False)
            (propertyReports report)),
      ])

genericTreeSource : String
genericTreeSource =
  "data Tree a = Leaf a | Node (Tree a)\nimpl Arbitrary (Tree a) requires Arbitrary a where\n  arbitrary () = Node (Leaf (arbitrary ()))\n  shrink (Node inner) = [inner]\n  shrink (Leaf _) = []\n"

test "generic custom generators discharge prerequisites and shrink recursive carriers" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectEqual}\n"
          ++ genericTreeSource
          ++ "prop \"generic generator\" (value : Tree Int) = match value\n  Node _ => True\n  Leaf _ => False\nprop \"generic shrink\" (value : Tree Int) = False\ntest \"ordinary test after generic properties\" = expectEqual 4 (2 + 2)\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          1
          [
            ("eval", "generic generator", "pass"),
            ("eval", "generic shrink", "fail"),
            ("native", "generic generator", "pass"),
            ("native", "generic shrink", "fail"),
          ]
          (Ok (code, report)),
        expectTrue
          (all
            (row => match field "detail" row
              Some detail =>
                contains "value = Leaf" detail && not (contains "Node" detail)
              None => False)
            (filter
              (row => field "name" row == Some "generic shrink")
              (propertyReports report))),
        expectEqual
          [
            (
              Some "eval",
              Some "ordinary test after generic properties",
              Some "pass",
            ),
            (
              Some "native",
              Some "ordinary test after generic properties",
              Some "pass",
            ),
          ]
          (map
            (row => (field "engine" row, field "name" row, field "status" row))
            (unitReportRows report)),
      ])

test "missing generic prerequisites reject only dependent properties" =
  withFixtures
    [
      (
        "main.mdk",
        genericTreeSource
          ++ "data Token = Token\nprop \"missing prerequisite\" (value : Tree Token) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target =>
      gradeCapabilityNeighbor
        "missing prerequisite"
        (runReport ["--engines", "eval,native"] target))

test "imported generic custom carriers retain their module and nested argument identities" =
  withFixtures
    [
      (
        "boxes.mdk",
        "public export data Box a = Box a\nexport impl Arbitrary (Box a) requires Arbitrary a where\n  arbitrary () = Box (arbitrary ())\n  shrink _ = []\nexport\nisBounded : Box Int -> Bool\nisBounded (Box n) = n >= (0 - 1000) && n <= 1000\n",
      ),
      (
        "main.mdk",
        "import boxes.{Box, isBounded}\nprop \"imported generic carrier\" (value : Box Int) = isBounded value\nprop \"nested generic carrier\" (value : Box (List Int)) = True\n",
      ),
    ]
    (target =>
      gradeReport
        0
        [
          ("eval", "imported generic carrier", "pass"),
          ("eval", "nested generic carrier", "pass"),
          ("native", "imported generic carrier", "pass"),
          ("native", "nested generic carrier", "pass"),
        ]
        (runReport ["--engines", "eval,native"] target))

test "custom helpers retain the Arbitrary interface identity under standalone method shadows" =
  withFixtures
    [
      (
        "main.mdk",
        "import test.{expectEqual}\ndata Box = Box Int\nimpl Arbitrary Box where\n  arbitrary () = Box 42\n  shrink _ = []\narbitrary : Unit -> Int\narbitrary () = 99\nshrink : Int -> List Int\nshrink _ = []\nprop \"custom method identity\" (value : Box) = match value\n  Box n => n == 42\ntest \"ordinary shadow remains visible\" = expectEqual 99 (arbitrary ())\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          0
          [
            ("eval", "custom method identity", "pass"),
            ("native", "custom method identity", "pass"),
          ]
          (Ok (code, report)),
        expectEqual
          [Some "pass", Some "pass"]
          (map (field "status") (unitReportRows report)),
      ])

test "typed custom helpers close over nominal fields and isolate missing prerequisites" =
  withFixtures
    [
      (
        "main.mdk",
        genericTreeSource
          ++ "data Seeded = Seeded Int\nimpl Arbitrary Seeded where\n  arbitrary () = Seeded 999999\n  shrink _ = []\ndata Outer = Outer Seeded\ndata Token = Token\ndata Missing = Missing (Tree Token)\nprop \"nested custom carrier\" (value : Outer) = match value\n  Outer (Seeded n) => n == 999999\nprop \"nested missing prerequisite\" (value : Missing) = True\nprop \"neighbor\" (n : Int) = n == n\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          1
          [
            ("eval", "nested custom carrier", "pass"),
            ("eval", "nested missing prerequisite", "error"),
            ("eval", "neighbor", "pass"),
            ("native", "nested custom carrier", "pass"),
            ("native", "nested missing prerequisite", "error"),
            ("native", "neighbor", "pass"),
          ]
          (Ok (code, report)),
        expectEqual
          [Some "capability", Some "capability"]
          (map
            (field "failureKind")
            (filter
              (row => field "name" row == Some "nested missing prerequisite")
              (propertyReports report))),
      ])

test "finite nonregular carriers can grow their arguments without expanding helper closure forever" =
  withFixtures
    [
      (
        "main.mdk",
        "data Nest a = Empty | Step (Nest (List a))\nprop \"finite increasing carrier\" (value : Nest Int) = True\nprop \"increasing recursion is reachable\" (value : Nest Int) = match value\n  Empty => True\n  Step _ => False\n",
      ),
    ]
    (target =>
      gradeReport
        1
        [
          ("eval", "finite increasing carrier", "pass"),
          ("eval", "increasing recursion is reachable", "fail"),
          ("native", "finite increasing carrier", "pass"),
          ("native", "increasing recursion is reachable", "fail"),
        ]
        (runReport ["--engines", "eval,native"] target))

