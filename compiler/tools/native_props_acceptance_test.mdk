test "imported newtypes use exported custom generators while keeping counterexamples opaque" =
  withFixtures
    [
      (
        "wrapped.mdk",
        "export newtype Wrapped = Wrapped Int\nexport impl Arbitrary Wrapped where\n  arbitrary () = Wrapped 500000\n  shrink _ = []\n",
      ),
      (
        "main.mdk",
        "import wrapped.{Wrapped}\nprop \"custom newtype\" (value : Wrapped) = True\nprop \"private newtype value\" (value : Wrapped) = False\n",
      ),
    ]
    (target => match runReport ["--engines", "eval,native"] target
      Err message => fail message
      Ok (code, report) => expectAll [
        gradeReport
          1
          [
            ("eval", "custom newtype", "pass"),
            ("eval", "private newtype value", "fail"),
            ("native", "custom newtype", "pass"),
            ("native", "private newtype value", "fail"),
          ]
          (Ok (code, report)),
        expectTrue
          (all
            (row => match field "detail" row
              Some detail =>
                contains "<Wrapped>" detail && not (contains "500000" detail)
              None => False)
            (filter
              (row => field "name" row == Some "private newtype value")
              (propertyReports report))),
      ])
