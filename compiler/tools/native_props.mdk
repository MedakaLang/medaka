-- Native property runner.  It deliberately compiles one probe per target, then
-- lets the driver (below) judge the printed Bool transcript.  A probe never
-- prints a pass/fail label of its own.

import frontend.ast.{
  Decl(..), Expr, PropParam(..), Ty(..), TyConOrigin(..), Variant(..),
  Field(..), ConPayload(..), Pat(..)
}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import driver.build_cmd.{
  ppBuildReport, makeTempDir, scratchProjectManifest, cleanupTempDir,
  runBuildNativeRoots, envOr, defaultMedakaRoot
}
import driver.loader.{entrySearchRoots}
import support.path.{joinPath, baseOf, dirOf}
import support.ordmap.{OrdMap, omEmpty, omHasKey, omInsert, omLookup}
import support.util.{
  joinNl, joinWith, splitNl, filterList, lookupAssoc, listLen, zipL, reverseL
}
import string.{toInt}
import tools.probe_transcript.{
  Chunk(..), chunksOf, decodeValue, endTag, firstNonEmptyLine, lookupChunk,
  mintNonce, noncedPrefix, renameUserMain, sentinelLine, tagsInOrder,
  valuePrintExpr
}
import tools.printer.{exprToString, ppTy}
import tools.prop_plan.{
  PlanModule(..), TypeKey(..), CustomPlan(..), PlanEnv, GenPlan(..),
  PlanDef(..), PlanCtor(..), PlanField(..), PlanError(..), PlanErrorReason(..),
  planErrorText, buildPlanEnvModules, planFor, planDef, instantiateCtor, planTy,
  typeKeyWord, ctorWeights, listLengthBound, optionWeights, resultWeights,
  maxGenDepth
}
import tools.prop_runner.{
  PropResult(..), PropStatus(..), PropFailureKind(..), filterProps,
  filterPropsByName, propSeedValue, PropRequest(..), propRequestName,
  propRequestSeed, propRequestCases
}

sentinelBase : String
sentinelBase = "@@__mdk_native_prop__@@"

sentinelPrefix : String -> String
sentinelPrefix nonce = noncedPrefix sentinelBase nonce

sentinelFor : String -> String -> String
sentinelFor nonce tag = sentinelLine (sentinelPrefix nonce) tag

startTag : Int -> String
startTag i = "\{intToString i}.start"

boolTag : Int -> String
boolTag i = "\{intToString i}.bool"

detailTag : Int -> String
detailTag i = "\{intToString i}.detail"

seedTag : Int -> String
seedTag i = "\{intToString i}.seed"

expectedTags : Int -> List (Decl, PropRequest) -> List String
expectedTags _ [] = [endTag]
expectedTags i (_ :: rest) =
  [startTag i, seedTag i, boolTag i, detailTag i] ++ expectedTags (i + 1) rest

-- The command path supplies paired raw/runtime declarations so the native
-- renderer can share identity-aware planning with the evaluator.  The legacy
-- entry remains for direct callers whose source is a self-contained module.
export
runNativePlannedPropRequests : String ->
  String ->
  List PlanModule ->
  List PropRequest ->
  <IO> List PropResult
runNativePlannedPropRequests target tsrc modules requests =
  let props = filterProps (desugarProps tsrc)
  match requestIndex requests omEmpty
    Err duplicate => nativeProtocolErrors duplicate requests
    Ok index => match duplicateSelectedPropName props index omEmpty
      Some duplicate =>
        nativeProtocolErrors
          "duplicate property declaration name \"{duplicate}\""
          requests
      None => match buildPlanEnvModules (plannedRoot modules) modules
        Err e =>
          plannedResults (planCapabilities props index (planErrorText e)) []
        Ok env =>
          let outcomes = plannedOutcomes env modules props index
          let runnable = plannedRunnable outcomes
          match runnable
            [] => plannedResults outcomes []
            _ => match nativeRenderedPlanned target tsrc modules env runnable
              Err e =>
                plannedResults
                  outcomes
                  (map (nativePlannedBuildError e) runnable)
              Ok rows => plannedResults outcomes rows

plannedRoot : List PlanModule -> String
plannedRoot [] = ""
plannedRoot [PlanModule name _ _] = name
plannedRoot (_ :: rest) = plannedRoot rest

planCapabilities : List Decl ->
  OrdMap PropRequest ->
  String ->
  List NativePlanOutcome
planCapabilities [] _ _ = []
planCapabilities ((d@(DProp _ _ _ _)) :: rest) requests message =
  match omLookup (propName d) requests
    Some r =>
      NativeCapability d r message :: planCapabilities rest requests message
    None => planCapabilities rest requests message
planCapabilities (_ :: rest) requests message =
  planCapabilities rest requests message

-- Planning is deliberately per declaration, before the one shared native
-- build.  A parameter the engines cannot generate is a capability result for
-- that law only; it must not prevent an unrelated law in the same file from
-- getting its compiled result.
data NativePlanOutcome =
  | NativeRunnable Decl PropRequest (List GenPlan)
  | NativeCapability Decl PropRequest String

plannedOutcomes : PlanEnv ->
  List PlanModule ->
  List Decl ->
  OrdMap PropRequest ->
  List NativePlanOutcome
plannedOutcomes _ _ [] _ = []
plannedOutcomes env modules ((d@(DProp _ _ _ _)) :: rest) requests =
  match omLookup (propName d) requests
    None => plannedOutcomes env modules rest requests
    Some r => match runtimePropParams modules (propName d)
      None =>
        NativeCapability
            d
            r
            "property declaration was absent from the elaborated module"
          :: plannedOutcomes env modules rest requests
      Some ps => match planParameters env (propName d) ps []
        Ok plans =>
          NativeRunnable d r plans :: plannedOutcomes env modules rest requests
        Err e =>
          NativeCapability d r (planErrorText e)
            :: plannedOutcomes env modules rest requests
plannedOutcomes env modules (_ :: rest) requests =
  plannedOutcomes env modules rest requests

runtimePropParams : List PlanModule -> String -> Option (List PropParam)
runtimePropParams [] _ = None
runtimePropParams [PlanModule _ _ runtime] name =
  runtimePropParamsIn runtime name
runtimePropParams (_ :: rest) name = runtimePropParams rest name

runtimePropParamsIn : List Decl -> String -> Option (List PropParam)
runtimePropParamsIn [] _ = None
runtimePropParamsIn ((DProp _ name ps _) :: _) wanted
  | name == wanted = Some ps
runtimePropParamsIn (_ :: rest) wanted = runtimePropParamsIn rest wanted

propName : Decl -> String
propName (DProp _ name _ _) = name
propName _ = "<invalid prop>"

planParameters : PlanEnv ->
  String ->
  List PropParam ->
  List GenPlan ->
  Result PlanError (List GenPlan)
planParameters _ _ [] acc = Ok (reverseL acc)
planParameters env property ((PropParam name _ ty) :: rest) acc =
  match planFor env property name ty
    Ok p => planParameters env property rest (p :: acc)
    Err e => Err e

plannedRunnable : List NativePlanOutcome -> List NativePlanOutcome
plannedRunnable [] = []
plannedRunnable ((x@(NativeRunnable _ _ _)) :: rest) = x :: plannedRunnable rest
plannedRunnable (_ :: rest) = plannedRunnable rest

nativePlannedBuildError : String -> NativePlanOutcome -> PropResult
nativePlannedBuildError e (NativeRunnable d r _) = nativeError e (d, r)
nativePlannedBuildError e _ =
  PropResult
    "native"
    "<invalid prop>"
    PropErroredResult
    (Some PropBuildError)
    e
    0
    0

plannedResults : List NativePlanOutcome -> List PropResult -> List PropResult
plannedResults [] _ = []
plannedResults ((NativeCapability d r message) :: rest) rows =
  PropResult
      "native"
      (propName d)
      PropErroredResult
      (Some PropCapabilityError)
      message
      (propRequestSeed r)
      (propRequestCases r)
    :: plannedResults rest rows
plannedResults ((NativeRunnable d r _) :: rest) rows =
  nativeRowFor (propName d) r rows :: plannedResults rest rows

nativeRowFor : String -> PropRequest -> List PropResult -> PropResult
nativeRowFor _ r [] =
  PropResult
    "native"
    (propRequestName r)
    PropErroredResult
    (Some PropRuntimeError)
    "native property runner: the compiled probe omitted this property result"
    (propRequestSeed r)
    (propRequestCases r)
nativeRowFor name r ((row@(PropResult _ rowName _ _ _ _ _)) :: rest) =
  if name == rowName then row else nativeRowFor name r rest

requestIndex : List PropRequest ->
  OrdMap PropRequest ->
  Result String (OrdMap PropRequest)
requestIndex [] index = Ok index
requestIndex (r :: rest) index =
  let name = propRequestName r
  if propRequestCases r <= 0 then
    Err "property request \"{name}\" has a non-positive case budget"
  else if omHasKey name index then
    Err "duplicate property request name \"{name}\""
  else
    requestIndex rest (omInsert name r index)

duplicateSelectedPropName : List Decl ->
  OrdMap PropRequest ->
  OrdMap Unit ->
  Option String
duplicateSelectedPropName [] _ _ = None
duplicateSelectedPropName ((DProp _ name _ _) :: rest) requests seen =
  if omHasKey name seen then
    if omHasKey name requests then
      Some name
    else
      duplicateSelectedPropName rest requests seen
  else
    duplicateSelectedPropName rest requests (omInsert name () seen)
duplicateSelectedPropName (_ :: rest) requests seen =
  duplicateSelectedPropName rest requests seen

nativeProtocolErrors : String -> List PropRequest -> List PropResult
nativeProtocolErrors duplicate requests =
  map (nativeProtocolError duplicate) requests

nativeProtocolError : String -> PropRequest -> PropResult
nativeProtocolError duplicate r =
  PropResult
    "native"
    (propRequestName r)
    PropErroredResult
    (Some PropProtocolError)
    "native property runner: \{duplicate}"
    (propRequestSeed r)
    (propRequestCases r)

desugarProps : String -> List Decl
desugarProps src = desugar (parse src)

nativeError : String -> (Decl, PropRequest) -> PropResult
nativeError e (DProp _ name _ _, r) =
  PropResult
    "native"
    name
    PropErroredResult
    (Some PropBuildError)
    e
    (propRequestSeed r)
    (propRequestCases r)
nativeError e (_, r) =
  PropResult
    "native"
    "<invalid prop>"
    PropErroredResult
    (Some PropBuildError)
    e
    (propRequestSeed r)
    (propRequestCases r)

nativeRenderedPlanned : String ->
  String ->
  List PlanModule ->
  PlanEnv ->
  List NativePlanOutcome ->
  <IO> Result String (List PropResult)
nativeRenderedPlanned target tsrc modules env jobs = match makeTempDir ()
  Err e =>
    Err "native property runner: could not create a scratch directory: \{e}"
  Ok tmp =>
    let nonce = mintNonce ()
    let rendered = runInTmpPlanned target tsrc modules env jobs tmp nonce
    let _ = cleanupTempDir tmp
    rendered

runInTmpPlanned : String ->
  String ->
  List PlanModule ->
  PlanEnv ->
  List NativePlanOutcome ->
  String ->
  String ->
  <IO> Result String (List PropResult)
runInTmpPlanned target tsrc modules env jobs tmp nonce =
  let entry = joinPath tmp (scratchEntryName target)
  let out = joinPath tmp "prop_probe"
  let _ =
    writeFile
      (joinPath tmp "medaka.toml")
      (scratchProjectManifest "medaka_native_props" target)
  match writeFile entry (plannedProbeSource nonce target tsrc modules env jobs)
    Err e =>
      Err "native property runner: could not write the probe source: \{e}"
    Ok _ => buildAndRunPlanned target entry out tmp jobs nonce

buildAndRunPlanned : String ->
  String ->
  String ->
  String ->
  List NativePlanOutcome ->
  String ->
  <IO> Result String (List PropResult)
buildAndRunPlanned target entry out tmp jobs nonce =
  let root = envOr "MEDAKA_ROOT" defaultMedakaRoot
  let medaka = envOr "MEDAKA" "medaka"
  let emitter = envOr "MEDAKA_EMITTER" (joinPath root "medaka_emitter")
  let cc = envOr "CC" "clang"
  match (runBuildNativeRoots
    root
    medaka
    cc
    entry
    out
    tmp
    False
    (entrySearchRoots (dirOf target))
    True
    False
    False)
    Err rep =>
      Err
        "native property runner: could not build \{target} natively\n\{ppBuildReport rep}"
    Ok _ => match runCommand "env" [
      "MEDAKA_ROOT=" ++ root,
      "MEDAKA=" ++ medaka,
      "MEDAKA_EMITTER=" ++ emitter,
      out,
    ]
      Err e =>
        Err "native property runner: could not run the compiled probe: \{e}"
      Ok (code, stdout, stderr) =>
        let props = plannedDeclRequests jobs
        let chunks = chunksOf (sentinelPrefix nonce) (splitNl stdout)
        if tagsInOrder (expectedTags 0 props) chunks then
          Ok (renderAll chunks (abortNote code stderr) 0 props)
        else
          Err
            "native property runner: the probe printed a forged or malformed transcript; no property result was trusted"

plannedDeclRequests : List NativePlanOutcome -> List (Decl, PropRequest)
plannedDeclRequests [] = []
plannedDeclRequests ((NativeRunnable d r _) :: rest) =
  (d, r) :: plannedDeclRequests rest
plannedDeclRequests (_ :: rest) = plannedDeclRequests rest

scratchEntryName : String -> String
scratchEntryName target = "prop_" ++ baseOf target

abortNote : Int -> String -> String
abortNote code stderr =
  let first = firstNonEmptyLine (splitNl stderr)
  "native property run ended (probe exit \{intToString code})\{if first == "" then "" else " — " ++ first}"

complete : String -> List Chunk -> Option String
complete tag chunks = match lookupChunk tag chunks
  Some (Chunk _ ls True) => decodeValue ls
  _ => None

seedFor : List Chunk -> Int -> Int
seedFor chunks i = match complete (seedTag i) chunks
  Some text => match toInt text
    Some seed => seed
    None => 0
  None => 0

renderAll : List Chunk ->
  String ->
  Int ->
  List (Decl, PropRequest) ->
  List PropResult
renderAll _ _ _ [] = []
renderAll chunks note i ((DProp _ name _ _, r) :: rest) =
  renderOne chunks note (propRequestCases r) i name
    :: renderAll chunks note (i + 1) rest
renderAll chunks note i (_ :: rest) = renderAll chunks note (i + 1) rest

renderOne : List Chunk -> String -> Int -> Int -> String -> PropResult
renderOne chunks note cases i name = match (
  complete (boolTag i) chunks,
  complete (detailTag i) chunks,
)
  (Some "True", Some detail) =>
    PropResult
      "native"
      name
      PropPassedResult
      None
      detail
      (seedFor chunks i)
      cases
  (Some "False", Some detail) =>
    PropResult
      "native"
      name
      PropFailedResult
      (Some PropLawFalse)
      detail
      (seedFor chunks i)
      cases
  _ =>
    PropResult
      "native"
      name
      PropErroredResult
      (Some PropRuntimeError)
      "\{note}; this property was not fully reported"
      (seedFor chunks i)
      cases

-- Probe source ---------------------------------------------------------------

plannedProbeSource : String ->
  String ->
  String ->
  List PlanModule ->
  PlanEnv ->
  List NativePlanOutcome ->
  String
plannedProbeSource nonce target tsrc modules env jobs =
  joinNl
    (plannedImports modules jobs env
      ++ [
        probeTargetSource target tsrc,
        "",
        "__np_state : Ref Int",
        "__np_state = Ref 0",
        "",
        "__np_custom_state : Ref U64",
        "__np_custom_state = Ref 0",
        "",
        "__np_next _ =",
        "  let s = (!__np_state * 1103515245 + 12345) % 2147483648",
        "  __np_state := s",
        "  s",
        "",
        "__np_int _ = (__np_next () / 65536) % 2001 - 1000",
        "__np_bool _ = (__np_next () / 65536) % 2 == 0",
        "__np_choose n = if n <= 1 then 0 else (__np_next () / 65536) % n",
        "__np_char _ = charFromCodeUnsafe (32 + __np_choose 95)",
        "__np_string n = if n <= 0 then \"\" else charToStr (__np_char ()) ++ __np_string (n - 1)",
        "",
        "__np_delete_each [] = []",
        "__np_delete_each (x :: xs) = xs :: map (ys => x :: ys) (__np_delete_each xs)",
        "__np_replace_each f [] = []",
        "__np_replace_each f (x :: xs) = map (ys => ys :: xs) (f x) ++ map (ys => x :: ys) (__np_replace_each f xs)",
        "",
      ]
      ++ plannedPropLines modules env jobs 0
      ++ ["main ="]
      ++ plannedMainLines nonce jobs 0
      ++ ["  putStrLn \"\{sentinelFor nonce endTag}\"", ""])

-- Each imported module gets a probe-local alias. Constructor selection is by
-- the TypeKey owner, never by a bare source spelling.
plannedImports : List PlanModule ->
  List NativePlanOutcome ->
  PlanEnv ->
  List String
plannedImports modules jobs env =
  uniqueStrings (flatMap (importsForOutcome modules env) jobs)

importsForOutcome : List PlanModule ->
  PlanEnv ->
  NativePlanOutcome ->
  List String
importsForOutcome modules env (NativeRunnable _ _ plans) =
  flatMap (importsForPlan modules env) plans
importsForOutcome _ _ _ = []

importsForPlan : List PlanModule -> PlanEnv -> GenPlan -> List String
importsForPlan _ _ GInt = []
importsForPlan _ _ GBool = []
importsForPlan _ _ GFloat = []
importsForPlan _ _ GChar = []
importsForPlan _ _ GString = []
importsForPlan _ _ GUnit = []
importsForPlan modules env (GList p) = importsForPlan modules env p
importsForPlan modules env (GArray p) = importsForPlan modules env p
importsForPlan modules env (GOption p) = importsForPlan modules env p
importsForPlan modules env (GResult e a) =
  importsForPlan modules env e ++ importsForPlan modules env a
importsForPlan modules env (GTuple ps) = flatMap (importsForPlan modules env) ps
importsForPlan modules _ (GCustom (CustomPlan key _)) = importForKey modules key
importsForPlan modules env (p@(GNominal key _)) = match planDef env key
  Err _ => importForKey modules key
  Ok (PlanDef _ _ _ _ ctors) =>
    importForKey modules key
      ++ flatMap
        (ctor => match instantiateCtor env p ctor
          Ok fields => flatMap (importsForPlan modules env) (map snd fields)
          Err _ => [])
        ctors

importForKey : List PlanModule -> TypeKey -> List String
importForKey modules (TypeKey _ (OriginModule owner)) =
  match moduleAlias modules owner
    Some alias => ["import \{owner} as \{alias}"]
    None => []
importForKey _ _ = []

moduleAlias : List PlanModule -> String -> Option String
moduleAlias modules owner = moduleAliasGo (dropLastPlanModule modules) owner 0

moduleAliasGo : List PlanModule -> String -> Int -> Option String
moduleAliasGo [] _ _ = None
moduleAliasGo ((PlanModule name _ _) :: rest) owner i =
  if name == owner then
    Some "NP\{intToString i}"
  else
    moduleAliasGo rest owner (i + 1)

dropLastPlanModule : List PlanModule -> List PlanModule
dropLastPlanModule [] = []
dropLastPlanModule [_] = []
dropLastPlanModule (x :: xs) = x :: dropLastPlanModule xs

uniqueStrings : List String -> List String
uniqueStrings [] = []
uniqueStrings (x :: xs) = x :: uniqueStrings (filterList (/= x) xs)

plannedPropLines : List PlanModule ->
  PlanEnv ->
  List NativePlanOutcome ->
  Int ->
  List String
plannedPropLines _ _ [] _ = []
plannedPropLines modules env ((NativeRunnable (DProp _ _ params body) r plans) :: rest) i =
  fnLines i params body
    ++ plannedGenLines modules env i 0 params plans
    ++ plannedRunLines modules env i params plans (propRequestCases r)
    ++ plannedShrinkLines modules env i params plans
    ++ plannedPropLines modules env rest (i + 1)
plannedPropLines modules env (_ :: rest) i = plannedPropLines modules env rest i

plannedGenLines : List PlanModule ->
  PlanEnv ->
  Int ->
  Int ->
  List PropParam ->
  List GenPlan ->
  List String
plannedGenLines _ _ _ _ [] [] = []
plannedGenLines modules env i j ((PropParam _ _ ty) :: rest) (p :: plans) =
  let graph = nominalGraph env p []
  let root = match p
    GNominal _ _ => "\{graphRef graph p} depth"
    _ => graphDraw modules env graph p
  ["\{genName i j} : Int -> \{ppTy ty}", "\{genName i j} depth = \{root}", ""]
    ++ graphLines modules env graph graph 0
    ++ plannedGenLines modules env i (j + 1) rest plans
plannedGenLines _ _ _ _ _ _ = []

-- The graph is closed before rendering.  Recursive edges are function calls,
-- including through containers, so rendering List (Tree Int) stays finite.
nominalGraph : PlanEnv -> GenPlan -> List GenPlan -> List GenPlan
nominalGraph _ GInt seen = seen
nominalGraph _ GBool seen = seen
nominalGraph _ GFloat seen = seen
nominalGraph _ GChar seen = seen
nominalGraph _ GString seen = seen
nominalGraph _ GUnit seen = seen
nominalGraph _ (GCustom _) seen = seen
nominalGraph env (GList p) seen = nominalGraph env p seen
nominalGraph env (GArray p) seen = nominalGraph env p seen
nominalGraph env (GOption p) seen = nominalGraph env p seen
nominalGraph env (GResult a b) seen =
  nominalGraph env b (nominalGraph env a seen)
nominalGraph env (GTuple ps) seen = nominalGraphMany env ps seen
nominalGraph env (p@(GNominal key _)) seen =
  if any (sameGenPlan p) seen then
    seen
  else match planDef env key
    Err _ => seen
    Ok (PlanDef _ _ _ _ ctors) => nominalGraphCtors env p ctors (seen ++ [p])

nominalGraphMany : PlanEnv -> List GenPlan -> List GenPlan -> List GenPlan
nominalGraphMany _ [] seen = seen
nominalGraphMany env (p :: ps) seen =
  nominalGraphMany env ps (nominalGraph env p seen)

nominalGraphCtors : PlanEnv ->
  GenPlan ->
  List PlanCtor ->
  List GenPlan ->
  List GenPlan
nominalGraphCtors _ _ [] seen = seen
nominalGraphCtors env p (ctor :: ctors) seen =
  nominalGraphCtors env p ctors (nominalCtorGraph env p seen ctor)

nominalCtorGraph : PlanEnv ->
  GenPlan ->
  List GenPlan ->
  PlanCtor ->
  List GenPlan
nominalCtorGraph env p seen ctor = match instantiateCtor env p ctor
  Err _ => seen
  Ok fields => nominalGraphMany env (map snd fields) seen

graphName : Int -> String
graphName n = "__np_node_\{intToString n}"

graphRef : List GenPlan -> GenPlan -> String
graphRef graph p = graphRefGo graph p 0

graphRefGo : List GenPlan -> GenPlan -> Int -> String
graphRefGo [] _ _ = "__np_missing_plan"
graphRefGo (x :: xs) p n =
  if sameGenPlan x p then graphName n else graphRefGo xs p (n + 1)

graphLines : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  List GenPlan ->
  Int ->
  List String
graphLines _ _ _ [] _ = []
graphLines modules env full (p :: ps) n =
  [
      "\{graphName n} : Int -> \{ppTy (planTy p)}",
      "\{graphName n} depth = \{graphNominalBody modules env full p}",
      "",
    ]
    ++ graphLines modules env full ps (n + 1)

graphDraw : List PlanModule -> PlanEnv -> List GenPlan -> GenPlan -> String
graphDraw _ _ graph (p@(GNominal _ _)) = "\{graphRef graph p} (depth + 1)"
graphDraw modules env graph (GList p) =
  graphList "[" "]" env p (graphDraw modules env graph p)
graphDraw modules env graph (GArray p) =
  graphList "[|" "|]" env p (graphDraw modules env graph p)
graphDraw modules env graph (GOption p) =
  renderOptionAtDepth env p (graphDraw modules env graph p) 0
graphDraw modules env graph (GResult a b) =
  renderResultAtDepth
    env
    a
    b
    (graphDraw modules env graph a)
    (graphDraw modules env graph b)
    0
graphDraw modules env graph (GTuple ps) =
  "(\{joinWith ", " (map (graphDraw modules env graph) ps)})"
graphDraw _ _ _ GInt = "__np_int ()"
graphDraw _ _ _ GBool = "__np_bool ()"
graphDraw _ _ _ GFloat = "intToFloat (__np_int ())"
graphDraw _ _ _ GChar = "__np_char ()"
graphDraw _ _ _ GString = stringExpr 0
graphDraw _ _ _ GUnit = "()"
graphDraw _ _ _ (GCustom _) = customDrawExpr

graphList : String -> String -> PlanEnv -> GenPlan -> String -> String
graphList open close env p child = renderListAtDepth open close env p child 0

graphNominalBody : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  GenPlan ->
  String
graphNominalBody modules env graph (p@(GNominal key _)) = match planDef env key
  Err _ => "panic \"native property runner: missing planned constructor\""
  Ok (PlanDef _ owner _ _ ctors) =>
    graphCtorAtDepth modules env graph p owner ctors 0
graphNominalBody _ _ _ _ =
  "panic \"native property runner: invalid graph node\""

graphCtorAtDepth : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  GenPlan ->
  String ->
  List PlanCtor ->
  Int ->
  String
graphCtorAtDepth modules env graph p owner ctors depth =
  let here =
    graphCtorChoice modules env graph p owner ctors (ctorWeights env p depth)
  if depth >= maxGenDepth then
    here
  else
    "if depth <= \{intToString depth} then \{here} else \{graphCtorAtDepth modules env graph p owner ctors (depth + 1)}"

graphCtorChoice : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  GenPlan ->
  String ->
  List PlanCtor ->
  List Int ->
  String
graphCtorChoice _ _ _ _ _ [] _ =
  "panic \"native property runner: no finite constructor\""
graphCtorChoice modules env graph p owner (ctor :: rest) (w :: ws) =
  if w <= 0 then
    graphCtorChoice modules env graph p owner rest ws
  else
    let here = graphCtorValue modules env graph p owner ctor
    let tail = graphCtorChoice modules env graph p owner rest ws
    if sumInts ws == 0 then
      here
    else
      "if __np_choose \{intToString (w + sumInts ws)} < \{intToString w} then \{here} else \{tail}"
graphCtorChoice _ _ _ _ _ _ _ =
  "panic \"native property runner: no finite constructor\""

sumInts : List Int -> Int
sumInts [] = 0
sumInts (x :: xs) = x + sumInts xs

graphCtorValue : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  GenPlan ->
  String ->
  PlanCtor ->
  String
graphCtorValue modules env graph p owner (ctor@(PlanCtor source _ _)) =
  match instantiateCtor env p ctor
    Err _ => "panic \"native property runner: invalid constructor plan\""
    Ok fields =>
      let values = map (graphDraw modules env graph) (map snd fields)
      let ref = qualifiedCtor modules owner source
      if hasNamedField fields then
        "\{ref} { \{joinWith ", " (namedAssignments fields values)} }"
      else if listLen values == 0 then
        ref
      else
        "\{ref} \{joinWith " " (map paren values)}"

renderPlannedGen : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  Int ->
  Result PlanError String
renderPlannedGen _ _ _ _ GInt _ = Ok "__np_int ()"
renderPlannedGen _ _ _ _ GBool _ = Ok "__np_bool ()"
renderPlannedGen _ _ _ _ GFloat _ = Ok "intToFloat (__np_int ())"
renderPlannedGen _ _ _ _ GChar _ = Ok "__np_char ()"
renderPlannedGen _ _ _ _ GString depth = Ok (stringExpr depth)
renderPlannedGen _ _ _ _ GUnit _ = Ok "()"
renderPlannedGen _ _ _ _ (GCustom _) _ = Ok customDrawExpr
renderPlannedGen modules env rootName root (GList p) depth =
  listExpr "[" "]" modules env rootName root p depth
renderPlannedGen modules env rootName root (GArray p) depth =
  listExpr "[|" "|]" modules env rootName root p depth
renderPlannedGen modules env rootName root (GOption p) depth =
  map
    (child => renderOptionAtDepth env p child 0)
    (renderPlannedGen modules env rootName root p depth)
renderPlannedGen modules env rootName root (GResult e a) depth = match (
  renderPlannedGen modules env rootName root e depth,
  renderPlannedGen modules env rootName root a depth,
)
  (Ok error, Ok ok) => Ok (renderResultAtDepth env e a error ok 0)
  (Err x, _) => Err x
  (_, Err x) => Err x
renderPlannedGen modules env rootName root (GTuple ps) depth =
  map
    (xs => "(\{joinWith ", " xs})")
    (renderPlanList modules env rootName root ps depth)
renderPlannedGen modules env rootName root (p@(GNominal key _)) depth =
  if depth > 0 && sameGenPlan p root then
    Ok "\{rootName} (depth + 1)"
  else
    renderNominal modules env rootName root p key depth

renderOptionChoice : List Int -> String -> String
renderOptionChoice [noneWeight, someWeight] child =
  if noneWeight <= 0 then
    "Some (\{child})"
  else if someWeight <= 0 then
    "None"
  else
    "if __np_choose \{noneWeight + someWeight} < \{noneWeight} then None else Some (\{child})"
renderOptionChoice _ child = "Some (\{child})"

renderOptionAtDepth : PlanEnv -> GenPlan -> String -> Int -> String
renderOptionAtDepth env p child level =
  let here = renderOptionChoice (optionWeights env level p) child
  if level >= maxGenDepth then
    here
  else
    "if depth <= \{intToString level} then \{here} else \{renderOptionAtDepth env p child (level + 1)}"

renderResultChoice : List Int -> String -> String -> String
renderResultChoice [errWeight, okWeight] error ok =
  if errWeight <= 0 then
    "Ok (\{ok})"
  else if okWeight <= 0 then
    "Err (\{error})"
  else
    "if __np_choose \{errWeight + okWeight} < \{errWeight} then Err (\{error}) else Ok (\{ok})"
renderResultChoice _ error _ = "Err (\{error})"

renderResultAtDepth : PlanEnv ->
  GenPlan ->
  GenPlan ->
  String ->
  String ->
  Int ->
  String
renderResultAtDepth env err ok error okExpr level =
  let here = renderResultChoice (resultWeights env level err ok) error okExpr
  if level >= maxGenDepth then
    here
  else
    "if depth <= \{intToString level} then \{here} else \{renderResultAtDepth env err ok error okExpr (level + 1)}"

customDrawExpr : String
customDrawExpr =
  "(let caller = randomState ()\n  let _ = restoreRandomState (!__np_custom_state)\n  let x = arbitrary ()\n  let next = randomState ()\n  let _ = __np_custom_state := next\n  let _ = restoreRandomState caller\n  x)"

stringExpr : Int -> String
stringExpr _ =
  "__np_string (__np_choose (if depth >= \{intToString maxGenDepth} then 1 else 11))"

listExpr : String ->
  String ->
  List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  Int ->
  Result PlanError String
listExpr open close modules env rootName root p depth =
  map
    (child => renderListAtDepth open close env p child 0)
    (renderPlannedGen modules env rootName root p depth)

renderListAtDepth : String ->
  String ->
  PlanEnv ->
  GenPlan ->
  String ->
  Int ->
  String
renderListAtDepth open close env p child level =
  let here = renderListChoice open close child (listLengthBound env level p)
  if level >= maxGenDepth then
    here
  else
    "if depth <= \{intToString level} then \{here} else \{renderListAtDepth open close env p child (level + 1)}"

renderListChoice : String -> String -> String -> Int -> String
renderListChoice open close child bound =
  "match __np_choose \{intToString (bound + 1)}\n\{renderListArms open close child bound 0}"

renderListArms : String -> String -> String -> Int -> Int -> String
renderListArms open close child bound n
  | n > bound = ""
renderListArms open close child bound n =
  "  \{if n == bound then "_" else intToString n} => \{open}\{joinWith ", " (repeatString child n)}\{close}\n\{renderListArms open close child bound (n + 1)}"

repeatString : String -> Int -> List String
repeatString _ 0 = []
repeatString x n = x :: repeatString x (n - 1)

renderPlanList : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  List GenPlan ->
  Int ->
  Result PlanError (List String)
renderPlanList _ _ _ _ [] _ = Ok []
renderPlanList modules env rootName root (p :: rest) depth = match (
  renderPlannedGen modules env rootName root p depth,
  renderPlanList modules env rootName root rest depth,
)
  (Ok x, Ok xs) => Ok (x :: xs)
  (Err e, _) => Err e
  (_, Err e) => Err e

renderNominal : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  TypeKey ->
  Int ->
  Result PlanError String
renderNominal modules env rootName root p key depth = match planDef env key
  Err e => Err e
  Ok (PlanDef _ owner _ _ ctors) =>
    renderCtorAtDepth modules env rootName root p owner ctors 0

renderCtorAtDepth : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  String ->
  List PlanCtor ->
  Int ->
  Result PlanError String
renderCtorAtDepth modules env rootName root p owner ctors level =
  match (renderCtorChoices
    modules
    env
    rootName
    root
    p
    owner
    ctors
    (ctorWeights env p level)
    level)
    Err e => Err e
    Ok here =>
      if level >= maxGenDepth then
        Ok here
      else
        map
          (next => "if depth <= \{intToString level} then \{here} else \{next}")
          (renderCtorAtDepth
            modules
            env
            rootName
            root
            p
            owner
            ctors
            (level + 1))

renderCtorChoices : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  String ->
  List PlanCtor ->
  List Int ->
  Int ->
  Result PlanError String
renderCtorChoices modules env rootName root p owner ctors weights depth =
  renderWeightedCtors
    modules
    env
    rootName
    root
    p
    owner
    (zipL ctors weights)
    depth

renderWeightedCtors : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  String ->
  List (PlanCtor, Int) ->
  Int ->
  Result PlanError String
renderWeightedCtors _ _ _ _ _ _ [] _ =
  Err (PlanError "" "" (TyVar "") PENoFiniteValue "no finite constructor")
renderWeightedCtors modules env rootName root p owner [(ctor, weight)] depth =
  if weight <= 0 then
    Err (PlanError "" "" (TyVar "") PENoFiniteValue "no finite constructor")
  else
    renderCtor modules env rootName root p owner ctor depth
renderWeightedCtors modules env rootName root p owner ((ctor, weight) :: rest) depth =
  if weight <= 0 then
    renderWeightedCtors modules env rootName root p owner rest depth
  else match (
    renderCtor modules env rootName root p owner ctor depth,
    renderWeightedCtors modules env rootName root p owner rest depth,
  )
    (Ok here, Ok next) =>
      Ok
        "if __np_choose \{sumCtorWeights ((ctor, weight) :: rest)} < \{weight} then \{here} else \{next}"
    (Err e, _) => Err e
    (_, Err e) => Err e

sumCtorWeights : List (PlanCtor, Int) -> Int
sumCtorWeights [] = 0
sumCtorWeights ((_, n) :: rest) = max 0 n + sumCtorWeights rest

renderCtor : List PlanModule ->
  PlanEnv ->
  String ->
  GenPlan ->
  GenPlan ->
  String ->
  PlanCtor ->
  Int ->
  Result PlanError String
renderCtor modules env rootName root p owner (ctor@(PlanCtor source _ _)) depth =
  match instantiateCtor env p ctor
    Err e => Err e
    Ok fields =>
      match (renderPlanList
        modules
        env
        rootName
        root
        (map snd fields)
        (depth + 1))
        Err e => Err e
        Ok values =>
          let ctorRef = qualifiedCtor modules owner source
          if hasNamedField fields then
            Ok
              "\{ctorRef} { \{joinWith ", " (namedAssignments fields values)} }"
          else if listLen values == 0 then
            Ok ctorRef
          else
            Ok "\{ctorRef} \{joinWith " " (map paren values)}"

qualifiedCtor : List PlanModule -> String -> String -> String
qualifiedCtor modules owner ctor = match moduleAlias modules owner
  Some alias => "\{alias}.\{ctor}"
  None => ctor

hasNamedField : List (Option String, GenPlan) -> Bool
hasNamedField [] = False
hasNamedField ((Some _, _) :: _) = True
hasNamedField (_ :: rest) = hasNamedField rest

namedAssignments : List (Option String, GenPlan) -> List String -> List String
namedAssignments [] _ = []
namedAssignments _ [] = []
namedAssignments ((Some name, _) :: rest) (value :: values) =
  "\{name} = \{value}" :: namedAssignments rest values
namedAssignments ((None, _) :: rest) (_ :: values) =
  namedAssignments rest values

paren : String -> String
paren x = "(\{x})"

sameGenPlan : GenPlan -> GenPlan -> Bool
sameGenPlan GInt GInt = True
sameGenPlan GBool GBool = True
sameGenPlan GFloat GFloat = True
sameGenPlan GChar GChar = True
sameGenPlan GString GString = True
sameGenPlan GUnit GUnit = True
sameGenPlan (GNominal key args) (GNominal key2 args2) =
  typeKeyWord key == typeKeyWord key2 && sameGenPlans args args2
sameGenPlan _ _ = False

sameGenPlans : List GenPlan -> List GenPlan -> Bool
sameGenPlans [] [] = True
sameGenPlans (a :: more) (b :: more2) =
  sameGenPlan a b && sameGenPlans more more2
sameGenPlans _ _ = False

plannedRunLines : List PlanModule ->
  PlanEnv ->
  Int ->
  List PropParam ->
  List GenPlan ->
  Int ->
  List String
plannedRunLines modules env i ps plans _ =
  ["\{runName i} remaining =", "  if remaining <= 0 then (True, \"\") else"]
    ++ plannedBindings i ps 0
    ++ ["    let ok = \{fnName i} \{joinWith " " (map paramName ps)}"]
    ++ plannedFailureLines i ps plans
    ++ [""]

plannedBindings : Int -> List PropParam -> Int -> List String
plannedBindings _ [] _ = []
plannedBindings i ((PropParam name _ _) :: rest) j =
  ["    let \{name} = \{genName i j} 0"] ++ plannedBindings i rest (j + 1)

plannedFailureLines : Int -> List PropParam -> List GenPlan -> List String
plannedFailureLines i [] _ = [
  "    if ok then \{runName i} (remaining - 1) else (False, \"counterexample\")",
]
plannedFailureLines i ps plans = [
  "    if ok then \{runName i} (remaining - 1) else \{plannedShrinkStart i ps plans}",
]

plannedShrinkStart : Int -> List PropParam -> List GenPlan -> String
plannedShrinkStart i ps plans =
  "\{shrinkName i} 100 \{joinWith " " (map paramName ps)}"

shrinkName : Int -> String
shrinkName i = "__np_shrink_\{intToString i}"

-- The generated shrinker tries every candidate, left-to-right, and restarts
-- from parameter zero after each successful reduction.  Only custom plans may
-- invoke `shrink`; structural plans deliberately use the shared construction
-- policy above and remain displayable without imposing Debug on a nominal.
plannedShrinkLines : List PlanModule ->
  PlanEnv ->
  Int ->
  List PropParam ->
  List GenPlan ->
  List String
plannedShrinkLines _ _ _ [] _ = []
plannedShrinkLines modules env i ps plans =
  shrinkTopLines modules env i ps plans
    ++ shrinkTryLines modules env i ps plans 0

shrinkTopLines : List PlanModule ->
  PlanEnv ->
  Int ->
  List PropParam ->
  List GenPlan ->
  List String
shrinkTopLines modules env i ps plans = [
  "\{shrinkName i} fuel \{joinWith " " (map paramName ps)} =",
  "  if fuel <= 0 then (False, \{plannedDetail modules env ps plans}) else \{shrinkTryName i 0} fuel \{candidateExpr modules env (nthPlan 0 plans) (nthParam 0 ps)} \{joinWith " " (map paramName ps)}",
  "",
]

shrinkTryName : Int -> Int -> String
shrinkTryName i j = "__np_try_\{intToString i}_\{intToString j}"

shrinkTryLines : List PlanModule ->
  PlanEnv ->
  Int ->
  List PropParam ->
  List GenPlan ->
  Int ->
  List String
shrinkTryLines _ _ _ [] _ _ = []
shrinkTryLines modules env i ps plans j =
  shrinkTryLine modules env i ps plans j
    ++ shrinkTryLines modules env i ps plans (j + 1)

shrinkTryLine : List PlanModule ->
  PlanEnv ->
  Int ->
  List PropParam ->
  List GenPlan ->
  Int ->
  List String
shrinkTryLine modules env i ps plans j =
  let current = nthParam j ps
  let plan = nthPlan j plans
  let params = map paramName ps
  let after =
    if j + 1 >= listLen ps then
      "(False, \{plannedDetail modules env ps plans})"
    else
      "\{shrinkTryName i (j + 1)} fuel \{candidateExpr modules env plan current} \{joinWith " " params}"
  let replacement = replaceName j "candidate" params
  [
    "\{shrinkTryName i j} fuel candidates \{joinWith " " params} =",
    "  match candidates",
    "    [] => \{after}",
    "    candidate :: rest =>",
    "      if \{fnName i} \{joinWith " " replacement} then \{shrinkTryName i j} fuel rest \{joinWith " " params}",
    "      else \{shrinkName i} (fuel - 1) \{joinWith " " replacement}",
    "",
  ]

nthParam : Int -> List PropParam -> String
nthParam 0 ((PropParam name _ _) :: _) = name
nthParam n (_ :: rest) = nthParam (n - 1) rest
nthParam _ [] = "__np_missing"

nthPlan : Int -> List GenPlan -> GenPlan
nthPlan 0 (p :: _) = p
nthPlan n (_ :: rest) = nthPlan (n - 1) rest
nthPlan _ [] = GUnit

candidateExpr : List PlanModule -> PlanEnv -> GenPlan -> String -> String
candidateExpr _ _ GInt name = "if \{name} == 0 then [] else [0, \{name} / 2]"
candidateExpr _ _ GBool name = "if \{name} then [False] else []"
candidateExpr _ _ GFloat name =
  "if \{name} == 0.0 then [] else [0.0, \{name} / 2.0]"
candidateExpr _ _ GChar _ = "[]"
candidateExpr _ _ GString name =
  "if \{name} == \"\" then [] else [stringSlice 0 (stringLength \{name} / 2) \{name}]"
candidateExpr _ _ GUnit _ = "[]"
candidateExpr _ _ (GCustom _) name = "shrink \{name}"
candidateExpr modules env (GList p) name =
  "__np_delete_each \{name} ++ __np_replace_each (x => \{candidateExpr modules env p "x"}) \{name}"
candidateExpr modules env (GArray p) name =
  "map arrayFromList (__np_delete_each (toList \{name})) ++ map arrayFromList (__np_replace_each (x => \{candidateExpr modules env p "x"}) (toList \{name}))"
candidateExpr modules env (GOption p) name =
  "match \{name}\n  None => []\n  Some x => None :: map Some (\{candidateExpr modules env p "x"})"
candidateExpr modules env (GResult e a) name =
  "match \{name}\n  Err x => map Err (\{candidateExpr modules env e "x"})\n  Ok x => map Ok (\{candidateExpr modules env a "x"})"
candidateExpr modules env (GTuple ps) name =
  tupleCandidates modules env ps name 0
candidateExpr modules env (p@(GNominal key _)) name =
  nominalCandidates modules env p key name

replaceName : Int -> String -> List String -> List String
replaceName _ _ [] = []
replaceName 0 replacement (_ :: rest) = replacement :: rest
replaceName n replacement (x :: rest) =
  x :: replaceName (n - 1) replacement rest

plannedDetail : List PlanModule ->
  PlanEnv ->
  List PropParam ->
  List GenPlan ->
  String
plannedDetail _ _ [] _ = "\"counterexample\""
plannedDetail modules env ((PropParam name _ _) :: rest) (p :: plans) =
  detailPiece modules env name p ++ plannedDetailTail modules env rest plans
plannedDetail _ _ _ _ = "\"counterexample\""

plannedDetailTail : List PlanModule ->
  PlanEnv ->
  List PropParam ->
  List GenPlan ->
  String
plannedDetailTail _ _ [] _ = ""
plannedDetailTail modules env ((PropParam name _ _) :: rest) (p :: plans) =
  " ++ \"\\n\" ++ \{detailPiece modules env name p}\{plannedDetailTail modules env rest plans}"
plannedDetailTail _ _ _ _ = ""

detailPiece : List PlanModule -> PlanEnv -> String -> GenPlan -> String
detailPiece modules env name p =
  "\"\{name} = \" ++ \{displayExpr modules env p name}"

tupleVars : Int -> List String
tupleVars n = tupleVarsGo n 0

tupleVarsGo : Int -> Int -> List String
tupleVarsGo n i =
  if i >= n then [] else "v\{intToString i}" :: tupleVarsGo n (i + 1)

tupleCandidates : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  String ->
  Int ->
  String
tupleCandidates modules env ps name _ =
  let vars = tupleVars (listLen ps)
  "match \{name}\n  (\{joinWith ", " vars}) => \{tupleCandidateLists modules env ps vars 0}"

tupleCandidateLists : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  List String ->
  Int ->
  String
tupleCandidateLists _ _ [] _ _ = "[]"
tupleCandidateLists modules env (p :: ps) (v :: vs) i =
  "map (candidate => (\{joinWith ", " (replaceName i "candidate" (v :: vs))})) (\{candidateExpr modules env p v}) ++ \{tupleCandidateLists modules env ps (v :: vs) (i + 1)}"
tupleCandidateLists _ _ _ _ _ = "[]"

nominalCandidates : List PlanModule ->
  PlanEnv ->
  GenPlan ->
  TypeKey ->
  String ->
  String
nominalCandidates modules env p key name = match planDef env key
  Err _ => "[]"
  Ok (PlanDef _ owner _ _ ctors) =>
    "match \{name}\n\{joinNl (map (nominalCandidateArm modules env p owner) ctors)}"

nominalCandidateArm : List PlanModule ->
  PlanEnv ->
  GenPlan ->
  String ->
  PlanCtor ->
  String
nominalCandidateArm modules env p owner (ctor@(PlanCtor source _ _)) =
  match instantiateCtor env p ctor
    Err _ => "  _ => []"
    Ok fields =>
      let vars = tupleVars (listLen fields)
      let ref = qualifiedCtor modules owner source
      if hasNamedField fields then
        "  \{ref} { \{joinWith ", " (namedAssignments fields vars)} } => \{nominalFieldCandidates modules env ref fields fields vars True 0}"
      else if listLen fields == 0 then
        "  \{ref} => []"
      else
        "  \{ref} \{joinWith " " vars} => \{nominalFieldCandidates modules env ref fields fields vars False 0}"

nominalFieldCandidates : List PlanModule ->
  PlanEnv ->
  String ->
  List (Option String, GenPlan) ->
  List (Option String, GenPlan) ->
  List String ->
  Bool ->
  Int ->
  String
nominalFieldCandidates _ _ _ _ [] _ _ _ = "[]"
nominalFieldCandidates modules env ref all ((_, p) :: rest) (v :: vs) named i =
  "map (candidate => \{rebuildCtor ref all (replaceName i "candidate" (v :: vs)) named}) (\{candidateExpr modules env p v}) ++ \{nominalFieldCandidates modules env ref all rest (v :: vs) named (i + 1)}"
nominalFieldCandidates _ _ _ _ _ _ _ _ = "[]"

rebuildCtor : String ->
  List (Option String, GenPlan) ->
  List String ->
  Bool ->
  String
rebuildCtor ref fields values named =
  if named then
    "\{ref} { \{joinWith ", " (namedAssignments fields values)} }"
  else
    "\{ref} \{joinWith " " (map paren values)}"

displayExpr : List PlanModule -> PlanEnv -> GenPlan -> String -> String
displayExpr _ _ GInt name = "intToString \{name}"
displayExpr _ _ GBool name = "if \{name} then \"True\" else \"False\""
displayExpr _ _ GFloat name = "debug \{name}"
displayExpr _ _ GChar name = "debug \{name}"
displayExpr _ _ GString name = "debug \{name}"
displayExpr _ _ GUnit _ = "\"()\""
displayExpr modules env (GCustom (CustomPlan key _)) name =
  nominalDisplay modules env (GNominal key []) key name
displayExpr modules env (GList p) name =
  "\"[\" ++ joinWith \", \" (map (x => \{displayExpr modules env p "x"}) \{name}) ++ \"]\""
displayExpr modules env (GArray p) name =
  "\"[|\" ++ joinWith \", \" (map (x => \{displayExpr modules env p "x"}) (toList \{name})) ++ \"|]\""
displayExpr modules env (GOption p) name =
  "match \{name}\n  None => \"None\"\n  Some x => \"Some (\" ++ \{displayExpr modules env p "x"} ++ \")\""
displayExpr modules env (GResult e a) name =
  "match \{name}\n  Err x => \"Err (\" ++ \{displayExpr modules env e "x"} ++ \")\"\n  Ok x => \"Ok (\" ++ \{displayExpr modules env a "x"} ++ \")\""
displayExpr modules env (GTuple ps) name =
  let vars = tupleVars (listLen ps)
  "match \{name}\n  (\{joinWith ", " vars}) => \"(\" ++ \{joinDisplay modules env ps vars} ++ \")\""
displayExpr modules env (p@(GNominal key _)) name =
  nominalDisplay modules env p key name

joinDisplay : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  List String ->
  String
joinDisplay _ _ [] _ = "\"\""
joinDisplay modules env (p :: ps) (v :: vs) =
  displayExpr modules env p v ++ joinDisplayTail modules env ps vs
joinDisplay _ _ _ _ = "\"\""

joinDisplayTail : List PlanModule ->
  PlanEnv ->
  List GenPlan ->
  List String ->
  String
joinDisplayTail _ _ [] _ = ""
joinDisplayTail modules env (p :: ps) (v :: vs) =
  " ++ \", \" ++ \{displayExpr modules env p v}\{joinDisplayTail modules env ps vs}"
joinDisplayTail _ _ _ _ = ""

nominalDisplay : List PlanModule ->
  PlanEnv ->
  GenPlan ->
  TypeKey ->
  String ->
  String
nominalDisplay modules env p key name = match planDef env key
  Err _ => "\"<unavailable>\""
  Ok (PlanDef _ owner _ _ ctors) =>
    "match \{name}\n\{joinNl (map (nominalDisplayArm modules env p owner) ctors)}"

nominalDisplayArm : List PlanModule ->
  PlanEnv ->
  GenPlan ->
  String ->
  PlanCtor ->
  String
nominalDisplayArm modules env p owner (ctor@(PlanCtor source _ _)) =
  match instantiateCtor env p ctor
    Err _ => "  _ => \"<unavailable>\""
    Ok fields =>
      let vars = tupleVars (listLen fields)
      let ref = qualifiedCtor modules owner source
      let text =
        if hasNamedField fields then
          "\"\{source} { \" ++ \{joinNamedDisplay modules env fields vars} ++ \" }\""
        else if listLen fields == 0 then
          "\"\{source}\""
        else
          "\"\{source} (\" ++ \{joinDisplay modules env (map snd fields) vars} ++ \")\""
      let pat =
        if hasNamedField fields then
          "\{ref} { \{joinWith ", " (namedAssignments fields vars)} }"
        else if listLen fields == 0 then
          ref
        else
          "\{ref} \{joinWith " " vars}"
      "  \{pat} => \{text}"

joinNamedDisplay : List PlanModule ->
  PlanEnv ->
  List (Option String, GenPlan) ->
  List String ->
  String
joinNamedDisplay _ _ [] _ = ""
joinNamedDisplay modules env ((Some field, p) :: rest) (v :: vs) =
  "\{field} = \" ++ \{displayExpr modules env p v}\{joinNamedDisplayTail modules env rest vs}"
joinNamedDisplay _ _ _ _ = ""

joinNamedDisplayTail : List PlanModule ->
  PlanEnv ->
  List (Option String, GenPlan) ->
  List String ->
  String
joinNamedDisplayTail _ _ [] _ = ""
joinNamedDisplayTail modules env ((Some field, p) :: rest) (v :: vs) =
  " ++ \", \" ++ \"\{field} = \" ++ \{displayExpr modules env p v}\{joinNamedDisplayTail modules env rest vs}"
joinNamedDisplayTail _ _ _ _ = ""

plannedMainLines : String -> List NativePlanOutcome -> Int -> List String
plannedMainLines _ [] _ = []
plannedMainLines nonce ((NativeRunnable (DProp _ _ params _) r plans) :: rest) i =
  [
      "  let _ = putStrLn \"\{sentinelFor nonce (startTag i)}\"",
      "  let _ = __np_state := \{intToString (propRequestSeed r)}",
      "  let _ = __np_custom_state := \{seedU64 (propRequestSeed r)}",
      "  let seed = \{intToString (propRequestSeed r)}",
      "  let _ = putStrLn \"\{sentinelFor nonce (seedTag i)}\"",
      "  let _ = \{valuePrintExpr "intToString seed"}",
      "  let (ok, detail) = \{runName i} \{intToString (propRequestCases r)}",
      "  let _ = putStrLn \"\{sentinelFor nonce (boolTag i)}\"",
      "  let _ = \{valuePrintExpr "debug ok"}",
      "  let _ = putStrLn \"\{sentinelFor nonce (detailTag i)}\"",
      "  let _ = \{valuePrintExpr "detail"}",
    ]
    ++ plannedMainLines nonce rest (i + 1)
plannedMainLines nonce (_ :: rest) i = plannedMainLines nonce rest i

seedU64 : Int -> String
seedU64 n = if n < 0 then "0" else intToString n

-- `core.mdk` is the auto-prelude, so splicing its declarations into a scratch
-- entry duplicates every prelude binding.  Its property bodies can instead be
-- compiled in an ordinary entry where core is already the auto-prelude.
probeTargetSource : String -> String -> String
probeTargetSource target src =
  if baseOf target == "core.mdk" then "" else renameUserMain src

fnName : Int -> String
fnName i = "__np_prop_\{intToString i}"

genName : Int -> Int -> String
genName i j = "__np_gen_\{intToString i}_\{intToString j}"

runName : Int -> String
runName i = "__np_run_\{intToString i}"

fnLines : Int -> List PropParam -> Expr -> List String
fnLines i ps body =
  ["\{fnName i} \{joinWith " " (map paramName ps)} = \{exprToString body}", ""]

paramName : PropParam -> String
paramName (PropParam n _ _) = n
