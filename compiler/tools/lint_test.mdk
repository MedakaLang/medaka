-- compiler/tools/lint_test.mdk — sibling test for lint.mdk / lint_cmd.mdk /
-- mcp.mdk (`[P-TEST-SIBLING]`, AGENTS.md).
--
-- #2701 leg 3: `rule-duplicate-body` (a `ProjectRule`) never reached
-- `medaka lint --json` or the `medaka_lint` MCP tool — both surfaces looped
-- the per-file diag-triple builder alone and never called
-- `runProjectRules`.  This property pins the gap AND the fix, over the
-- SHARED `test/lint_crossfile_fixtures` corpus (`[T-SHARED-CORPUS]`):
--
--   1. the OLD per-file-only triple builder (`lintFilesToDiagTriples`, kept
--      unchanged — it is still `--write-baseline`'s vehicle) has NO
--      `rule-duplicate-body` diagnostic anywhere in it, for ANY file set —
--      `duplicateBodyRule` is a `ProjectRule`, never a per-file `Rule`, so
--      this holds independent of the fix below and documents exactly the
--      shape of the gap `rule-duplicate-body` fell into.
--   2. the JSON path's OWN internals (`lintFilesToDiagQuads` +
--      `projectJsonFindings`, exactly what `runLintJsonCmd` calls) DO
--      surface it, merged into the owning file's entry via
--      `mergeProjectIntoTriples`.
--   3. the MCP path's OWN internals (`lintPathsToDiagQuads` +
--      `projectMcpFindings`, exactly what `runLintTool` calls) produce the
--      SAME finding set as the JSON path — renderer parity across both
--      machine-readable surfaces.  Licensed per the sprint contract §8.4 to
--      assert this by calling the tool's own internal functions rather than
--      a live MCP stdio round trip.
--
-- `--native`, not the interpreter: every function here reaches the
-- filesystem (parsing the real fixture files), and `medaka test` under the
-- interpreter binds no filesystem extern.  Run as
-- `medaka test --native compiler/tools/lint_test.mdk` (the Makefile `test:`
-- target line does this).

import test.{
  Expectation, expectEqual, expectFalse, expectTrue, expectEach, expectNotEqual,
  fail
}
import tools.lint_index.{Answer(..)}
import tools.lint_cache.{
  LintEntry(..),
  entryFindings,
  ShardLoad(..),
  decodeEntry,
  encodeEntry,
}
import string.{replace, lines}
import list.{take}
import support.util.{anyList, listLen, sortUniqS}
import driver.diagnostics.{Diag(..), Severity(..), diagIdText}
import frontend.ast.{Loc(..)}
import test_process.{underRoot}
import tools.lint.{
  Applicability(..),
  FixRun(..),
  allProjectRules,
  allRuleNames,
  applyFixes,
  buildStdlibIndexResult,
  projectRuleMetaProblems,
  emptyStdlibIndex,
  fixSource,
  lintParseSource,
  lintProgram,
  mergeProjectIntoTriples,
  projectWildMods,
  selectRules,
}
import tools.lint_walk.{
  runProjectRulesOver,
  runVisitors,
  sourceHasWildImport,
  stdlibIndexNeeded,
  wildIndexNeeded,
}
import tools.lint_shared.{declLocList}
import frontend.ast_walk.{ExprKind(..)}
import tools.lint_core.{
  Category(..),
  Ctx(..),
  DirScope(..),
  Directive(..),
  ProjectRule,
  Finding(..),
  Fixability(..),
  Ratchet(..),
  RuleMeta(..),
  Scope(..),
  Summary(..),
  Visitor(..),
  mkProjectRule,
}
import tools.lint_cmd.{
  allRuleRows,
  dropQuadParse,
  lintCacheCtx,
  explainRule,
  dropInactiveInternalProject,
  inactiveInternalRuleUse,
  internalActiveFor,
  internalDisabledFor,
  internalRuleNames,
  lintFilesToDiagTriples,
  RuleRow,
  renderRuleRowsNames,
  rulesPageMarkdown,
  selectRuleRows,
  lintFilesToDiagQuads,
  projectJsonFindings,
}
import tools.mcp.{lintPathsToDiagQuads, projectMcpFindings}

-- The two-file duplicate pair the multi-clause blind spot (#2651) fixed —
-- `stepA`/`stepB` are each one function split across two clauses, so neither
-- clause alone clears `dupComplexityThreshold`, but the two together do.
-- Picked over the single-clause pair so this property also proves the
-- cross-file tier's INPUT (the full per-file parse) reaches JSON/MCP intact,
-- not just a simpler one-clause case.
fixtureFiles : List String
fixtureFiles = [
  "test/lint_crossfile_fixtures/dup_multiclause_a.mdk",
  "test/lint_crossfile_fixtures/dup_multiclause_b.mdk",
]

diagCode : Diag -> String
diagCode (Diag _ code _ _ _ _) = diagIdText code

tripleDiags : (String, String, List Diag) -> List Diag
tripleDiags (_, _, diags) = diags

anyDupRuleDiag : List (String, String, List Diag) -> Bool
anyDupRuleDiag triples =
  anyList
    (t => anyList (d => diagCode d == "rule-duplicate-body") (tripleDiags t))
    triples

-- (path, code, message) keys, sorted — a set representation two triple lists
-- can be compared by, independent of file/rule ordering.
tripleKeys : List (String, String, List Diag) -> List String
tripleKeys triples = sortUniqS (flatMap tripleKeysOne triples)

tripleKeysOne : (String, String, List Diag) -> List String
tripleKeysOne (path, _, diags) = map (diagKeyOf path) diags

diagKeyOf : String -> Diag -> String
diagKeyOf path (Diag _ code msg _ _ _) = "\{path}::\{diagIdText code}::\{msg}"

-- ── 0. the stdlib index is built only when a reader of it can matter ─────────
test "the edit rules ask for the index only on a wildcard import" = expectEach [
  (
    "reimpl disabled",
    expectFalse (stdlibIndexNeeded [] ["rule-stdlib-reimpl"]),
  ),
  ("reimpl active", expectTrue (stdlibIndexNeeded [] [])),
  ("edit rules active", expectTrue (wildIndexNeeded [] ["rule-stdlib-reimpl"])),
  ("only reimpl", expectFalse (wildIndexNeeded ["rule-stdlib-reimpl"] [])),
  (
    "no wildcard",
    expectFalse (sourceHasWildImport "import map.{Map, get}\nmain = 1\n"),
  ),
  (
    "wildcard",
    expectTrue (sourceHasWildImport "import list.{map}\nimport map.*\n"),
  ),
]

-- ── 1. the per-file-only gap, pinned ────────────────────────────────────────
test "the old per-file-only triple builder never carries a duplicate-body finding" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let triples = lintFilesToDiagTriples idx True [] [] [] None fixtureFiles
      expectTrue (not (anyDupRuleDiag triples))

-- ── 2. the JSON path's own internals surface it ─────────────────────────────
test "the JSON path's own internals surface the duplicate-body finding" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let quads = lintFilesToDiagQuads idx True [] [] [] None fixtureFiles
      let triples = map dropQuadParse quads
      let cross = projectJsonFindings idx True [] [] [] quads
      let merged = mergeProjectIntoTriples cross triples
      expectTrue (anyDupRuleDiag merged)

-- ── 3. renderer parity: JSON internals == MCP internals ─────────────────────
test "the MCP path's own internals produce the SAME finding set as JSON" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let jsonQuads = lintFilesToDiagQuads idx True [] [] [] None fixtureFiles
      let jsonTriples = map dropQuadParse jsonQuads
      let jsonCross = projectJsonFindings idx True [] [] [] jsonQuads
      let jsonMerged = mergeProjectIntoTriples jsonCross jsonTriples
      let mcpQuads = lintPathsToDiagQuads idx [] [] [] fixtureFiles
      let mcpTriples = map dropQuadParse mcpQuads
      let mcpCross = projectMcpFindings idx [] [] [] mcpQuads
      let mcpMerged = mergeProjectIntoTriples mcpCross mcpTriples
      expectEqual (tripleKeys jsonMerged) (tripleKeys mcpMerged)

messageOf : Finding -> String
messageOf f = f.message

-- A ranked finding as text: everything a shard stores of it.
rankedKey : (Int, Finding) -> String
rankedKey (rank, f) =
  "\{intToString rank} \{f.rule} \{f.message} \{severityKey f.severity} \{locKey f.loc}"

severityKey : Severity -> String
severityKey SevError = "error"
severityKey SevWarning = "warning"

locKey : Option Loc -> String
locKey None = "-"
locKey (Some (Loc file l c el ec)) =
  "\{file}:\{intToString l}:\{intToString c}:\{intToString el}:\{intToString ec}"

-- A hit's path, so a test can say which shards answered.
loadedPath : ShardLoad -> Option String
loadedPath (ShardHit entry) = Some entry.path
loadedPath (ShardStale entry) = Some "stale:\{entry.path}"
loadedPath ShardMiss = None

sampleFinding : Finding
sampleFinding = Finding {
  rule = "rule-zz-probe",
  message = "has \"quotes\"\nand a newline",
  severity = SevError,
  loc = Some (Loc "p" 1 2 3 4),
  fix = None,
}

sampleEntry : LintEntry
sampleEntry = LintEntry {
  path = "p",
  contentHash = "h",
  freeFindings = [(0, sampleFinding)],
  indexFindings = [(2, { sampleFinding | message = "indexed", loc = None })],
  indexKey = "k",
  indexAnswers = [
    Answer { ansQuestion = "npv:f", ansDigest = "1.2.3" },
    Answer { ansQuestion = "as", ansDigest = "4.5.6" },
  ],
  summaries = [("rule-a", DupOccs [(3, "f", "(key)")])],
  directives = [Directive DScopeFile ["rule-a"], Directive (DScopeLine 7) []],
  dirty = True,
}

-- A shard whose recorded index answers are not re-asked.
noAnswers : List Answer -> Bool
noAnswers _ = False

test "lint cache rejects pre-sexp format and mismatched identity" =
  let shard = encodeEntry "s" sampleEntry
  let old =
    "{\"version\":2,\"stamp\":\"s\",\"path\":\"p\",\"hash\":\"h\",\"findings\":[],\"dupOccs\":[],\"directives\":[]}"
  let nextVersion = replace "(3 " "(4 " shard
  expectEach [
    (
      "round trip",
      expectEqual
        (Some "p")
        (loadedPath (decodeEntry "s" "k" noAnswers "p" "h" shard)),
    ),
    (
      "json shard",
      expectEqual None (loadedPath (decodeEntry "s" "k" noAnswers "p" "h" old)),
    ),
    (
      "other version",
      expectEqual
        None
        (loadedPath (decodeEntry "s" "k" noAnswers "p" "h" nextVersion)),
    ),
    (
      "other content",
      expectEqual
        None
        (loadedPath (decodeEntry "s" "k" noAnswers "p" "other" shard)),
    ),
    (
      "other stamp",
      expectEqual
        None
        (loadedPath (decodeEntry "other" "k" noAnswers "p" "h" shard)),
    ),
    (
      "other path",
      expectEqual
        None
        (loadedPath (decodeEntry "s" "k" noAnswers "other" "h" shard)),
    ),
    (
      "other index key",
      expectEqual
        (Some "stale:p")
        (loadedPath (decodeEntry "s" "other" noAnswers "p" "h" shard)),
    ),
    (
      "truncated",
      expectEqual
        None
        (loadedPath
          (decodeEntry "s" "k" noAnswers "p" "h" (stringSlice 0 40 shard))),
    ),
    (
      "trailing text",
      expectEqual
        None
        (loadedPath (decodeEntry "s" "k" noAnswers "p" "h" (shard ++ " x"))),
    ),
  ]

test "a shard round-trips findings, summaries and directives" =
  match decodeEntry "s" "k" noAnswers "p" "h" (encodeEntry "s" sampleEntry)
    ShardHit e => expectEach [
      (
        "free",
        expectEqual
          (map rankedKey sampleEntry.freeFindings)
          (map rankedKey e.freeFindings),
      ),
      (
        "index",
        expectEqual
          (map rankedKey sampleEntry.indexFindings)
          (map rankedKey e.indexFindings),
      ),
      ("answers", expectEqual sampleEntry.indexAnswers e.indexAnswers),
      ("summaries", expectEqual sampleEntry.summaries e.summaries),
      ("directives", expectEqual sampleEntry.directives e.directives),
      (
        "merged in rank order",
        expectEqual
          ["has \"quotes\"\nand a newline", "indexed"]
          (map messageOf (entryFindings e)),
      ),
    ]
    _ => fail "the shard did not decode"

-- One sample per `Summary` constructor.  `summaryKind` has no wildcard arm, so
-- a new constructor warns non-exhaustive here until it has a sample below.
summaryKind : Summary -> String
summaryKind (DupOccs _) = "dup-occs"

summarySamples : List Summary
summarySamples = [
  DupOccs [],
  DupOccs [
    (3, "f", "(key)"),
    (12, "name with space", "has \"quotes\"\nand a newline"),
  ],
]

test "every Summary constructor round-trips through the shard codec" =
  let entryOf =
    sm => { sampleEntry | summaries = [("rule-a", sm), ("rule-b", sm)] }
  let roundTrip =
    sm =>
      match decodeEntry "s" "k" noAnswers "p" "h" (encodeEntry "s" (entryOf sm))
        ShardHit e => Some e.summaries
        _ => None
  expectEach
    (map
      (sm => (
        summaryKind sm,
        expectEqual (Some (entryOf sm).summaries) (roundTrip sm),
      ))
      summarySamples)

test "a shard made against another index keeps what does not read the index" =
  match decodeEntry "s" "other" noAnswers "p" "h" (encodeEntry "s" sampleEntry)
    ShardStale e => expectEach [
      (
        "free",
        expectEqual
          (map rankedKey sampleEntry.freeFindings)
          (map rankedKey e.freeFindings),
      ),
      ("index group dropped", expectEqual 0 (listLen e.indexFindings)),
      ("summaries", expectEqual sampleEntry.summaries e.summaries),
      ("directives", expectEqual sampleEntry.directives e.directives),
      ("new key", expectEqual "other" e.indexKey),
      ("answers dropped", expectEqual [] e.indexAnswers),
    ]
    _ => fail "expected a stale shard"

test "a shard made against another index is a hit when its answers hold" =
  let shard = encodeEntry "s" sampleEntry
  let asked = (== sampleEntry.indexAnswers)
  match decodeEntry "s" "other" asked "p" "h" shard
    ShardHit e => expectEach [
      (
        "index group kept",
        expectEqual
          (map rankedKey sampleEntry.indexFindings)
          (map rankedKey e.indexFindings),
      ),
      ("the stored key is kept", expectEqual "k" e.indexKey),
    ]
    _ => fail "expected a hit"

test "a shard from before answers were stored is a miss" =
  let old = "(3 \"s\" \"p\" \"h\" \"k\" () () () ())"
  expectEqual None (loadedPath (decodeEntry "s" "k" (_ => True) "p" "h" old))

-- ── 4. the generated rules page ─────────────────────────────────────────────
-- `docs/ops/LINT-RULES.md` is `medaka lint --list-rules --markdown`.  A rule's
-- summary or doc changed without regenerating the page fails here; regenerate
-- with `medaka lint --list-rules --markdown > docs/ops/LINT-RULES.md`.
test "docs/ops/LINT-RULES.md matches the registry" =
  match readFile "docs/ops/LINT-RULES.md"
    Err e => fail "cannot read docs/ops/LINT-RULES.md: \{e}"
    Ok page => expectEqual rulesPageMarkdown page

-- One rule name per row, in registry order.
rowNames : List RuleRow -> List String
rowNames rows = filter (/= "") (lines (renderRuleRowsNames rows))

-- The listing is the registry's distinct names, and each filter pair partitions
-- it, so a new rule needs no count bumped here.
test "the registry rows are the distinct registered rule names and filters partition them" =
  let names scope ratchet tier = match selectRuleRows scope ratchet tier
    Ok rows => Some (rowNames rows)
    Err _ => None
  let count scope ratchet tier = match names scope ratchet tier
    Some ns => listLen ns
    None => -1
  let total = listLen allRuleRows
  expectEach [
    (
      "rows are the registered names",
      expectEqual (Some allRuleNames) (names None None None),
    ),
    (
      "scope partitions",
      expectEqual
        total
        (count (Some "internal") None None + count (Some "universal") None None),
    ),
    (
      "ratchet partitions",
      expectEqual
        total
        (count None (Some "gated") None + count None (Some "baselined") None),
    ),
    (
      "duplicate-body is in the cross tier",
      expectTrue (match names None None (Some "cross")
        Some ns => elem "rule-duplicate-body" ns
        None => False),
    ),
    ("bad value", expectEqual None (names (Some "nope") None None)),
  ]

test "--explain names a known rule and rejects an unknown one" = expectEach [
  (
    "known",
    expectTrue (isOk (explainRule "rule-lambda-section")),
  ),
  ("unknown", expectFalse (isOk (explainRule "nope"))),
]

-- ── 5. a test-verb fix applies only to `test`'s own verb ────────────────────
-- The two test-verb rules report in every fixture below; `--fix` rewrites the
-- one whose verb resolves to the `test` import and leaves the four whose verb is
-- captured by another binding untouched.
test "the test-verb rules report in every fixture" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let triples = lintFilesToDiagTriples idx True [] [] [] None verbFixtures
      expectEach (map (reportsTestVerbRule triples) verbFixtures)

test "--fix leaves a verb that does not resolve to the test import alone" =
  expectEach (map fixLeavesAlone verbFixtures)

test "--fix rewrites a verb that resolves to the test import" =
  fixResult
    "test/lint_fix_fixtures/test_verb_resolves_to_import.mdk"
    "test/lint_fix_fixtures/test_verb_resolves_to_import.fixed"

test "a test whose label is isEven is still checked for parity tests" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let path = "test/lint_fix_fixtures/rem_parity_excl_kinds.mdk"
      let triples = lintFilesToDiagTriples idx True [] [] [] None [path]
      expectTrue
        (anyList
          (d => diagCode d == "rule-rem-parity")
          (flatMap (diagsOfFile path) triples))

test "--fix leaves an impl method named isEven alone" =
  expectEach
    (map fixLeavesAlone ["test/lint_fix_fixtures/rem_parity_excl_kinds.mdk"])

-- `--fix` run over a fixture file: the rewritten source, `None` when the file
-- cannot be read or parsed.
fixedSource : String -> <FileRead> Option String
fixedSource path = match readFile path
  Err _ => None
  Ok src => match lintParseSource src
    Err _ => None
    Ok (decls, pos) => Some (fst (applyFixes [] [] src decls pos))

fixResult : String -> String -> <FileRead> Expectation
fixResult path fixedPath = match readFile fixedPath
  Err _ => fail "cannot read \{fixedPath}"
  Ok expected => expectEqual (Some expected) (fixedSource path)

fixLeavesAlone : String -> <FileRead> (String, Expectation)
fixLeavesAlone path = match readFile path
  Err _ => (path, fail "cannot read it")
  Ok src => (path, expectEqual (Some src) (fixedSource path))

verbFixtures : List String
verbFixtures = [
  "test/lint_fix_fixtures/test_verb_where_bound_introduced.mdk",
  "test/lint_fix_fixtures/test_verb_where_bound_swapped.mdk",
  "test/lint_fix_fixtures/test_verb_param_shadow.mdk",
  "test/lint_fix_fixtures/test_verb_alias_inverts.mdk",
  "test/lint_fix_fixtures/test_verb_guard_bind.mdk",
  "test/lint_fix_fixtures/test_verb_guard_bind_equal.mdk",
  "test/lint_fix_fixtures/test_verb_do_bind.mdk",
  "test/lint_fix_fixtures/test_verb_lambda_bind.mdk",
  "test/lint_fix_fixtures/test_verb_foreign_wildcard.mdk",
]

reportsTestVerbRule : List (String, String, List Diag) ->
  String ->
  (String, Expectation)
reportsTestVerbRule triples path = (
  path,
  expectTrue (anyList isTestVerbDiag (flatMap (diagsOfFile path) triples)),
)

diagsOfFile : String -> (String, String, List Diag) -> List Diag
diagsOfFile path (p, _, diags) = if p == path then diags else []

isTestVerbDiag : Diag -> Bool
isTestVerbDiag d =
  diagCode d == "rule-test-bool-literal-equal"
    || diagCode d == "rule-test-equal-in-true"

-- ── 6. internal-scope activation ────────────────────────────────────────────
-- Internal rules run only under `--internal` or a manifest whose `[lint]`
-- section says `internal = true`; every other manifest, and no manifest at all,
-- leaves them off.
test "internal rules are off unless a manifest or --internal turns them on" = expectEach
  [
    (
      "the flag wins without a manifest",
      expectEqual [] (internalDisabledFor True "stdlib/list.mdk"),
    ),
    (
      "no manifest",
      expectEqual
        internalRuleNames
        (internalDisabledFor False "stdlib/list.mdk"),
    ),
    (
      "[lint] internal = true",
      expectEqual
        []
        (internalDisabledFor False "test/lint_internal_fixtures/on/a.mdk"),
    ),
    (
      "a manifest without the key",
      expectEqual
        internalRuleNames
        (internalDisabledFor False "test/lint_internal_fixtures/no_key/a.mdk"),
    ),
    (
      "the key outside [lint]",
      expectEqual
        internalRuleNames
        (internalDisabledFor
          False
          "test/lint_internal_fixtures/wrong_section/a.mdk"),
    ),
    (
      "a quoted value",
      expectEqual
        internalRuleNames
        (internalDisabledFor False "test/lint_internal_fixtures/quoted/a.mdk"),
    ),
    (
      "the compiler's own manifest",
      expectEqual [] (internalDisabledFor False "compiler/tools/lint.mdk"),
    ),
  ]

test "the internal-rule list is exactly the internal-scope registry rows" =
  match selectRuleRows (Some "internal") None None
    Ok rows => expectEqual internalRuleNames (rowNames rows)
    Err e => fail "selectRuleRows rejected --scope internal: \{e}"

-- With activation off the test-verb rules (scope Internal) are silent on
-- fixtures that trip them; the `--internal` run above reports them.
test "an internal rule is silent on a manifest-less project" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      let triples = lintFilesToDiagTriples idx False [] [] [] None verbFixtures
      expectFalse
        (anyList (t => anyList isTestVerbDiag (tripleDiags t)) triples)

-- The MCP entry applies the same activation as the CLI: `rule-directive-reason`
-- (scope Internal) is silent under a manifest without `[lint] internal = true`
-- and fires under one that has it.
mcpDirectiveReasonFires : String -> <IO> Result String Bool
mcpDirectiveReasonFires path = match buildStdlibIndexResult
  Err _ => Err "could not build stdlib index"
  Ok idx =>
    let quads = lintPathsToDiagQuads idx [] ["rule-directive-reason"] [] [path]
    Ok
      (anyList
        (t =>
          anyList (d => diagCode d == "rule-directive-reason") (tripleDiags t))
        (map dropQuadParse quads))

test "the MCP lint entry keeps internal rules off without the manifest key" =
  match mcpDirectiveReasonFires "test/lint_internal_fixtures/no_key/leak.mdk"
    Err e => fail e
    Ok fired => expectFalse fired

test "the MCP lint entry runs internal rules under [lint] internal = true" =
  match mcpDirectiveReasonFires "test/lint_internal_fixtures/on/leak.mdk"
    Err e => fail e
    Ok fired => expectTrue fired

-- ── 7. cross-file rule metadata and activation ──────────────────────────────
-- A probe rule built here, not registered: the metadata combinations no rule in
-- the registry exercises yet.
probeMeta : Scope -> Ratchet -> RuleMeta
probeMeta scope ratchet = RuleMeta {
  name = "rule-zz-probe",
  summary = "probe",
  doc = "probe",
  category = Style,
  scope = scope,
  ratchet = ratchet,
  defaultSeverity = SevWarning,
  fixability = NotFixable,
  needs = [],
}

probeRule : Scope -> Ratchet -> ProjectRule
probeRule scope ratchet =
  mkProjectRule (probeMeta scope ratchet) (_ _ _ _ => DupOccs []) (_ _ => [])

probeFindingIn : String -> Finding
probeFindingIn file = Finding {
  rule = "rule-zz-probe",
  message = file,
  severity = SevWarning,
  loc = Some (Loc file 1 1 1 1),
  fix = None,
}

findingFile : Finding -> String
findingFile f = f.message

test "no registered cross-file rule carries metadata that nothing enforces" = expectEach
  [
    ("the registry", expectEqual [] (projectRuleMetaProblems allProjectRules)),
    (
      "a baselined cross-file rule is rejected",
      expectNotEqual
        []
        (projectRuleMetaProblems [probeRule Universal Baselined]),
    ),
    (
      "a gated internal cross-file rule is allowed",
      expectEqual [] (projectRuleMetaProblems [probeRule Internal Gated]),
    ),
  ]

-- A second registered project rule needs no switch flipped: its summaries ride
-- in the same shard as the first's, the runner hands each rule only its own,
-- and `--cache` stays on.  The roster here is the real duplicate-body rule plus
-- a probe that reports how many files it was given.
countingRule : ProjectRule
countingRule =
  mkProjectRule
    (probeMeta Universal Gated)
    (_ _ _ _ => DupOccs [])
    (_ files => map (countFinding (listLen files)) (take 1 files))

countFinding : Int -> (String, Summary) -> Finding
countFinding n (path, _) = Finding {
  rule = "rule-zz-probe",
  message = intToString n,
  severity = SevWarning,
  loc = Some (Loc path 1 1 1 1),
  fix = None,
}

test "a second project rule is evaluated over its own summaries and keeps --cache on" =
  let both = [countingRule]
  let files = [
    ("a.mdk", [("rule-zz-probe", DupOccs []), ("rule-a", DupOccs [])]),
    ("b.mdk", [("rule-zz-probe", DupOccs [])]),
    ("c.mdk", [("rule-a", DupOccs [])]),
  ]
  let entry = { sampleEntry |
    summaries =
      [("rule-a", DupOccs [(1, "f", "k")]), ("rule-zz-probe", DupOccs [])],
  }
  expectEach [
    (
      "the probe sees only the files that summarized under its name",
      expectEqual
        ["2"]
        (map messageOf (runProjectRulesOver both [] [] emptyStdlibIndex files)),
    ),
    (
      "--only gates it",
      expectEqual
        []
        (map
          messageOf
          (runProjectRulesOver both ["rule-a"] [] emptyStdlibIndex files)),
    ),
    (
      "both rules' summaries survive a shard round trip",
      expectEqual (Some
        entry.summaries) (match (decodeEntry
        "s"
        "k"
        noAnswers
        "p"
        "h"
        (encodeEntry "s" entry))
        ShardHit e => Some e.summaries
        _ => None),
    ),
    (
      "the cache is on whatever the roster holds",
      expectTrue (isSome (lintCacheCtx True False)),
    ),
  ]

-- A cross-file rule sees every target at once, so its internal scope is applied
-- to its findings, by the file each lands in.
test "an internal cross-file rule's findings are dropped where internal is off" = expectEach
  [
    (
      "a manifest-less project",
      expectEqual
        []
        (map
          findingFile
          (dropInactiveInternalProject
            [probeRule Internal Gated]
            False
            [probeFindingIn "stdlib/list.mdk"])),
    ),
    (
      "a project with [lint] internal = true",
      expectEqual
        ["compiler/tools/lint.mdk"]
        (map
          findingFile
          (dropInactiveInternalProject
            [probeRule Internal Gated]
            False
            [probeFindingIn "compiler/tools/lint.mdk"])),
    ),
    (
      "the --internal flag",
      expectEqual
        ["stdlib/list.mdk"]
        (map
          findingFile
          (dropInactiveInternalProject
            [probeRule Internal Gated]
            True
            [probeFindingIn "stdlib/list.mdk"])),
    ),
    (
      "a universal rule is untouched",
      expectEqual
        ["stdlib/list.mdk"]
        (map
          findingFile
          (dropInactiveInternalProject
            [probeRule Universal Gated]
            False
            [probeFindingIn "stdlib/list.mdk"])),
    ),
    (
      "only the findings in an inactive project are dropped",
      expectEqual
        ["compiler/tools/lint.mdk"]
        (map
          findingFile
          (dropInactiveInternalProject
            [probeRule Internal Gated]
            False
            [
              probeFindingIn "stdlib/list.mdk",
              probeFindingIn "compiler/tools/lint.mdk",
            ])),
    ),
  ]

-- Activation resolves from the target's absolute directory, so a path spelled
-- with dot segments reads the same manifest as the plain one.
test "internal activation does not depend on how the target is spelled" = expectEach
  [
    (
      "a dot segment",
      expectTrue (internalActiveFor False "./compiler/tools/lint.mdk"),
    ),
    (
      "a parent step from a manifest-less project into the on one",
      expectTrue
        (internalActiveFor
          False
          "test/lint_internal_fixtures/no_key/../on/leak.mdk"),
    ),
    (
      "a parent step from the on project into a manifest-less one",
      expectFalse
        (internalActiveFor
          False
          "test/lint_internal_fixtures/on/../quoted/leak.mdk"),
    ),
  ]

test "naming an internal rule where internal is off is reported" = expectEach [
  (
    "an inactive target",
    expectTrue
      (isSome
        (inactiveInternalRuleUse
          False
          ["rule-match-on-param"]
          ["stdlib/list.mdk"])),
  ),
  (
    "the flag",
    expectEqual
      None
      (inactiveInternalRuleUse True ["rule-match-on-param"] ["stdlib/list.mdk"]),
  ),
  (
    "an active project",
    expectEqual
      None
      (inactiveInternalRuleUse
        False
        ["rule-match-on-param"]
        ["compiler/tools/lint.mdk"]),
  ),
  (
    "a universal rule",
    expectEqual
      None
      (inactiveInternalRuleUse False ["rule-not-eq"] ["stdlib/list.mdk"]),
  ),
]

-- ── the visitor walk ──────────────────────────────────────────────────────────
-- A visitor that reports, at every application, the `Ctx` it was handed.
ctxProbe : List Visitor
ctxProbe = [OnExpr [KApp] (ctx _ => [ctxFinding ctx])]

ctxFinding : Ctx -> Finding
ctxFinding ctx = Finding {
  rule = "probe",
  message =
    "\{ctx.ctxDeclName} params=\{intToString (listLen ctx.ctxParams)} test=\{debug ctx.ctxInTest} parent=\{debug ctx.ctxParent}",
  severity = SevWarning,
  loc = ctx.ctxSpan,
  fix = None,
}

walkSrc : String
walkSrc = "f x = g (h x)\ntest \"t\" = k 1\n"

findingMessage : Finding -> String
findingMessage f = f.message

test "the visitor walk hands each callback its owner, test flag and parent kind" =
  match lintParseSource walkSrc
    Err _ => fail "the fixture did not parse"
    Ok (decls, pos) =>
      expectEqual
        [
          [
            "f params=1 test=False parent=None",
            "f params=1 test=False parent=Some KApp",
            "t params=0 test=True parent=None",
          ],
        ]
        (map
          (map findingMessage)
          (runVisitors [ctxProbe] (declLocList pos decls)))

notEqSrc : String
notEqSrc =
  """interface Same a where
  same : a -> a -> Bool
  same x y = not (x == y)
let rec loop n = not (n == 0)
test "t" = expectTrue (not (1 == 2))
"""

test "rule-not-eq reaches interface-default, let-group and test bodies" =
  match lintParseSource notEqSrc
    Err _ => fail "the fixture did not parse"
    Ok (decls, pos) =>
      expectEqual
        [
          "negated equality. Rewrite as 'x /= y'",
          "negated equality. Rewrite as 'n /= 0'",
          "negated equality. Rewrite as '1 /= 2'",
        ]
        (map
          findingMessage
          (lintProgram
            emptyStdlibIndex
            (selectRules ["rule-not-eq"] [])
            "t.mdk"
            notEqSrc
            pos
            decls))

-- A wildcard import of a project module that shares a stdlib module's name
-- brings that project module's names into scope, whatever the stdlib module
-- exports: `hex` has no `count`, a project's own `hex.mdk` may.
lengthOfFilter : String
lengthOfFilter = "import hex.*\n\nhits xs = length (filter even xs)\n"

test "a wildcard import of the stdlib module hex does not withhold the count fix" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      expectEqual
        (Ok (Settled "import hex.*\n\nhits xs = count even xs\n" 1))
        (fixSource
          idx
          Safe
          ["rule-fuse-list-pipeline"]
          []
          []
          "t.mdk"
          lengthOfFilter)

test "a wildcard import of a project module named like a stdlib module withholds the fix" =
  match buildStdlibIndexResult
    Err _ => fail "could not build stdlib index"
    Ok idx =>
      expectEqual
        (Ok (Settled lengthOfFilter 0))
        (fixSource
          idx
          Safe
          ["rule-fuse-list-pipeline"]
          []
          ["hex"]
          "t.mdk"
          lengthOfFilter)

test "projectWildMods names the wildcard imports that are files of the project" =
  match lintParseSource "import support.util.*\nimport hex.*\n"
    Err _ => fail "the source did not parse"
    Ok (decls, _) =>
      expectEqual
        ["support.util"]
        (projectWildMods (underRoot "compiler/tools/probe.mdk") decls)
