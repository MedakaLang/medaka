  manifestLintInternal,
  readSource,
}
import driver.diagnostics.{
  Diag,
  cjAllToJson,
  ppSeverity,
  diagIsError,
  ppDiagCliLines,
  ppDiagCliSrc,
  srcLinesArr,
  parseErrDiag,
}
import support.cli_targets.{collectMdkFiles, expandLintTarget}
import support.stage_count.{stageExit}
import tools.lint.{
  Applicability(..),
  Category(..),
  ProjectRule(..),
  Directive,
  Finding,
  Fixability(..),
  Need(..),
  Ratchet(..),
  Rule(..),
  RuleMeta(..),
  Scope(..),
  Summary,
  applicabilityText,
  maxApplicability,
  ruleMetaName,
  allProjectRules,
  StdlibIndex,
  allRules,
  applyFindingDeny,
  applyFindingFilters,
  applySuppressionsDirs,
  applySuppressionsMulti,
  applySuppressionsMultiDirs,
  factDirectives,
  fileSummaries,
  findingToDiag,
  fixPassLimit,
  fixSource,
  FixRun(..),
  runParts,
  isFindingError,
  lintFileDiagTriple,
  lintFileDiagTripleParsed,
  lintParseSource,
  lintProgramRanked,
  indexKeyFor,
  rankedIndexRules,
  splitByIndex,
  mkFileFacts,
  mkFileFactsAt,
  mkFileFactsIn,
  localModStates,
  projectWildMods,
  projectRuleSelected,
  ranked,
  selectRules,
  mergeProjectIntoTriples,
  runProjectRules,
}
import tools.lint_core.{
  recordingStdlibIndex,
  withStdlibLocalMods,
  localModOfQuestion,
  stdlibRecorded,
  stdlibAnswersHold,
}
import tools.lint_cache.{
