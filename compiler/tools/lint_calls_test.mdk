-- compiler/tools/lint_calls_test.mdk: sibling test for lint_calls.mdk
-- (`[P-TEST-SIBLING]`, AGENTS.md).  Each row parses a small program, takes the
-- first `let _ =` of its first block and checks the verdict and the block kind.

import test.{expectEqual, expectTrue, expectFalse}
import frontend.ast.{
  Decl(..), DoStmt(..), Expr(..), Loc, Pat(..), Ty, noDeclLoc
}
import frontend.ast_walk.{DeclBody(..), ExprKind(..), childExprs, declBodies}
import tools.lint_calls.{
  AbstainReason(..),
  BlockKind(..),
  DiscardClass(..),
  Verdict(..),
  blockOf,
  discardClass,
  discardOf,
  discardVerdict,
  inPlainBlock,
}
import tools.lint_core.{Ctx(..)}
import list.{findMap}
import tools.lint_index.{ProjectIndex, stdlibKeptRows}
import tools.lint_index_test.{mkProjectIndex, declRows}
import tools.lint_scope.{buildScopes}
import tools.lint.{lintParseSource}

-- The callees live in the same file, so a head resolves to a top-level binder
-- and reads the project rows.
header : String
header =
  """
unitFn : Int -> Unit
unitFn _ = ()

resultFn : Int -> Result String Int
resultFn n = Ok n

optionFn : Int -> Option Int
optionFn n = Some n

twoArgs : Int -> Int -> Result String Int
twoArgs a b = Ok (a + b)

effectful : String -> <IO> Result String Unit
effectful _ = Ok ()

noSig n = Ok n
"""

stmtsOf : Expr -> Option (BlockKind, List DoStmt)
stmtsOf e = match blockOf e
  Some found => Some found
  None => findMap stmtsOf (childExprs e)

mainBlock : List Decl -> Option (BlockKind, List DoStmt)
mainBlock decls = findMap firstBlockOfDecl decls

firstBlockOfDecl : Decl -> Option (BlockKind, List DoStmt)
firstBlockOfDecl d =
  findMap stmtsOf (map ((DeclBody _ body) => body) (declBodies d))

firstDiscard : List DoStmt -> Option DoStmt
firstDiscard = find isDiscard

isDiscard : DoStmt -> Bool
isDiscard (DoLet _ _ PWild _ _) = True
isDiscard _ = False

-- The block kind and verdict of the first `let _ =` in the first block of
-- `decls`, read against `ix`.
verdictIn : ProjectIndex -> List Decl -> Option (BlockKind, Verdict)
verdictIn ix decls = do
  (kind, stmts) <- mainBlock decls
  map
    (s => (kind, discardVerdict ix (buildScopes decls) "" s))
    (firstDiscard stmts)

-- The block kind and verdict of the first `let _ =` in `body`, the program
-- being `header` followed by `body`.  `stdlib` rows come from `lib` instead.
probe : String -> String -> Option (BlockKind, Verdict)
probe lib body = match lintParseSource (header ++ body)
  Err _ => None
  Ok (decls, _) =>
    let stdRows = match lintParseSource lib
      Ok (ds, _) => declRows "core" ds
      Err _ => []
    verdictIn (mkProjectIndex stdRows (declRows "m" decls)) decls

-- As `probe`, the library rows passing through `stdlibKeptRows` as module `lib`.
probeKept : String -> String -> String -> Option (BlockKind, Verdict)
probeKept lib src body = match (
  lintParseSource src,
  lintParseSource (header ++ body),
)
  (Ok (libDecls, _), Ok (decls, _)) =>
    verdictIn
      (mkProjectIndex
        (stdlibKeptRows (declRows lib libDecls))
        (declRows "m" decls))
      decls
  _ => None

verdictOf : String -> Option (BlockKind, Verdict)
verdictOf body = probe "" body

-- A program whose `main` is a bare block of `stmt` followed by `()`.
mainWith : String -> String
mainWith stmt = """

main =
  \{stmt}
  ()
"""

-- A type written in a signature, as a parsed `Ty`.
tyOfSig : String -> Option Ty
tyOfSig t = match lintParseSource "probeTy : \{t}\nprobeTy = probeTy\n"
  Ok ((DTypeSig _ _ ty _) :: _, _) => Some ty
  _ => None

discarding : String -> Option (BlockKind, Verdict)
discarding t = map (ty => (PlainBlock, Discard ty)) (tyOfSig t)

test "a saturated Unit call is a Unit discard" =
  expectEqual (discarding "Unit") (verdictOf (mainWith "let _ = unitFn 1"))

test "a saturated Result call is a Result discard" =
  expectEqual
    (discarding "Result String Int")
    (verdictOf (mainWith "let _ = resultFn 1"))

test "a saturated Option call is an Option discard" =
  expectEqual
    (discarding "Option Int")
    (verdictOf (mainWith "let _ = optionFn 1"))

test "an effect row on the result is not part of the declared result" =
  expectEqual
    (discarding "Result String Unit")
    (verdictOf (mainWith "let _ = effectful \"x\""))

test "a partial application abstains" =
  expectEqual
    (Some (PlainBlock, Abstain PartialApplication))
    (verdictOf (mainWith "let _ = twoArgs 1"))

test "a local that shadows a top-level name abstains" =
  expectEqual
    (Some (PlainBlock, Abstain LocalBinder))
    (verdictOf """

main =
  let unitFn = n => Ok n
  let _ = unitFn 1
  ()
""")

test "a parameter that shadows a top-level name abstains" =
  expectEqual
    (Some (PlainBlock, Abstain LocalBinder))
    (verdictOf
      """

run resultFn =
  let _ = resultFn 1
  ()

main = run unitFn
""")

test "an unsigned callee abstains" =
  expectEqual
    (Some (PlainBlock, Abstain NoSignature))
    (verdictOf (mainWith "let _ = noSig 1"))

test "an operator section head abstains" =
  expectEqual
    (Some (PlainBlock, Abstain HeadNotAName))
    (verdictOf (mainWith "let _ = (+ 1) 2"))

test "a lambda head abstains" =
  expectEqual
    (Some (PlainBlock, Abstain HeadNotAName))
    (verdictOf (mainWith "let _ = (n => Ok n) 2"))

test "a name with no argument abstains" =
  expectEqual
    (Some (PlainBlock, Abstain NotACall))
    (verdictOf (mainWith "let _ = unitFn"))

test "a name the index does not declare abstains" =
  expectEqual
    (Some (PlainBlock, Abstain NoRows))
    (verdictOf (mainWith "let _ = mystery 1"))

test "an unresolved prelude name resolves through the stdlib rows" =
  expectEqual
    (discarding "Option Int")
    (probe
      """
libFn : Int -> Option Int
libFn n = Some n
"""
      (mainWith "let _ = libFn 1"))

test "a runtime extern resolves through the kept stdlib rows" =
  expectEqual
    (discarding "Unit")
    (probeKept
      "runtime"
      "extern ePutStrLn : String -> <Stderr> Unit\n"
      (mainWith "let _ = ePutStrLn \"x\""))

test "an unexported value of another stdlib module stays out of the stdlib rows" =
  expectEqual
    (Some (PlainBlock, Abstain NoRows))
    (probeKept
      "other"
      """
hidden : Int -> Unit
hidden _ = ()
"""
      (mainWith "let _ = hidden 1"))

test "a method call abstains" =
  expectEqual
    (Some (PlainBlock, Abstain NotAPlainFunction))
    (probe
      """
interface Sized a where
  sizeOf : a -> Int
"""
      (mainWith "let _ = sizeOf 1"))

test "a saturated call inside a do block reports the do kind" =
  expectEqual
    (Some (DoBlock, Abstain NoRows))
    (verdictOf """

main =
  do
    let _ = missing 1
    pure ()
""")

test "the same saturated call in a do block is a Unit discard of a do block" =
  expectEqual
    (map (ty => (DoBlock, Discard ty)) (tyOfSig "Unit"))
    (verdictOf """

main =
  do
    let _ = unitFn 1
    pure ()
""")

test "a statement that is not let underscore is no discard" =
  expectEqual
    (Abstain NotADiscard)
    (discardVerdict
      (mkProjectIndex [] [])
      (buildScopes [])
      ""
      (DoAssign "x" (EVar "y")))

withLoc : Loc -> DoStmt -> DoStmt
withLoc l (DoLet a b p e _) = DoLet a b p e l
withLoc _ s = s

-- The class `discardOf` reports for the first `let _ =` of a Unit call, after
-- `edit` has rewritten the statement.
discardClassOf : (DoStmt -> DoStmt) -> Option DiscardClass
discardClassOf edit =
  match lintParseSource (header ++ mainWith "let _ = unitFn 1")
    Err _ => None
    Ok (decls, _) => do
      (_, stmts) <- mainBlock decls
      s <- firstDiscard stmts
      let ix = mkProjectIndex [] (declRows "m" decls)
      (_, _, c) <- discardOf ix (buildScopes decls) "" (edit s)
      Some c

test "a let underscore of a Unit call is a Unit discard" =
  expectEqual (Some ClassUnit) (discardClassOf (s => s))

test "a let underscore with a zero-width span is no discard" =
  expectEqual None (discardClassOf (withLoc noDeclLoc))

test "the ctx fact says plain block for a bare-block parent" =
  expectTrue (inPlainBlock (ctxWithParent (Some KBlock)))

test "the ctx fact says do for a do-block parent" =
  expectFalse (inPlainBlock (ctxWithParent (Some KDo)))

test "result and option and unit classify" =
  expectEqual
    [ClassUnit, ClassResult, ClassOption, ClassOther]
    (map classOfSig ["Unit", "Result String Int", "Option Int", "Int"])

classOfSig : String -> DiscardClass
classOfSig t = match tyOfSig t
  Some ty => discardClass ty
  None => ClassOther

ctxWithParent : Option ExprKind -> Ctx
ctxWithParent parent = Ctx {
  ctxDeclName = "",
  ctxParams = [],
  ctxInTest = False,
  ctxParent = parent,
  ctxSpan = None,
  ctxOwn = None,
  ctxDeclLoc = None,
  ctxBinding = None,
}

-- The verdict of the first `let _ =` of `src`, a module `m` of a project whose
-- other modules are `others` (module id, source).
probeProject : List (String, String) -> String -> Option Verdict
probeProject others src = match lintParseSource src
  Err _ => None
  Ok (decls, _) =>
    let otherRows =
      flatMap
        ((modId, text) => match lintParseSource text
          Ok (ds, _) => declRows modId ds
          Err _ => [])
        others
    let ix = mkProjectIndex [] (declRows "m" decls ++ otherRows)
    do
      (_, stmts) <- mainBlock decls
      map (s => discardVerdict ix (buildScopes decls) "" s) (firstDiscard stmts)

wildCaller : String
wildCaller = """
import dep.lib.*

main =
  let _ = step 1
  ()
"""

unrelatedStep : (String, String)
unrelatedStep = (
  "other",
  """
step : Int -> Unit
step _ = ()
""",
)

test "a wildcard import from a module the index lacks abstains despite a same-named row elsewhere" =
  expectEqual (Some (Abstain NoRows)) (probeProject [unrelatedStep] wildCaller)

test "a wildcard import from an indexed module decides by that module's row" =
  expectEqual
    (map Discard (tyOfSig "Result String Int"))
    (probeProject
      [
        (
          "dep.lib",
          """
step : Int -> Result String Int
step n = Ok n
""",
        ),
        unrelatedStep,
      ]
      wildCaller)

test "an unbound head does not read a same-named row of a module the file does not import" =
  expectEqual
    (Some (Abstain NoRows))
    (probeProject [unrelatedStep] """
main =
  let _ = step 1
  ()
""")
