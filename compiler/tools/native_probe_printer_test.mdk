-- Native probe regressions: the fixture shadows every historical bare
-- transcript primitive and probe identifier. A passing transcript proves the
-- generated ordinary-test and doctest programs used their private aliases.

import driver.build_cmd.{cleanupTempDir, makeTempDir}
import tools.native_fixture_test_support_test.{writeFixtureFiles}
import test.{Expectation, expectAll, expectEqual, expectTextContainsAll, fail}
import test_process.{boundedVerbSeconds, medakaBin}

withFixtures : List (String, String) ->
  (String -> <Exec, IO> Expectation) ->
  <Exec, IO> Expectation
withFixtures files inspect = match makeTempDir ()
  Err message => fail message
  Ok dir =>
    let result =
      match (writeFixtureFiles
        dir
        (("medaka.toml", "[package]\nname = \"native_probe_printer\"\n")
          :: files))
        Err message => fail message
        Ok _ => inspect "\{dir}/main.mdk"
    let _ = cleanupTempDir dir
    result

runNative : String -> <Exec, IO> Result String (Int, String, String)
runNative target = boundedVerbSeconds 120 medakaBin ["test", "--native", target]

shadowSource : String
shadowSource =
  "import test.{expectEqual}\nimport fake as MdkProbeTest__\n\nputStrLn : String -> Unit\nputStrLn _ = ()\n\ndebugStringLit : String -> String\ndebugStringLit _ = \"shadowed\"\n\n__ts_0__ = 0\n__tse_0__ = 0\n__tsv_0__ = 0\n__dt_0__ = 0\n\ntest \"native test transcript survives shadows\" = expectEqual 1 1\n\n-- > 1 + 1\n-- 2\n"

test "native probes preserve canonical printers and fresh generated names" =
  withFixtures
    [("fake.mdk", "export\nvalue = 0\n"), ("main.mdk", shadowSource)]
    (target => match runNative target
      Err message => fail message
      Ok (code, out, err) => expectAll [
        expectEqual 0 code,
        expectEqual "" err,
        expectTextContainsAll
          [
            "native test transcript survives shadows [native]",
            "ok   ",
            "1/1 passed",
          ]
          out,
      ])
