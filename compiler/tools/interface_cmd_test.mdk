-- Sibling test module for `compiler/tools/interface_cmd.mdk`.
--
-- The real stdlib's core is written under the default targets once per
-- assertion that needs it; `show` is graded through `showLines`, which is the
-- text the verb prints, and `verify` through `verdictOf`, which is what the
-- verb prints the text of.
import test.{
  Expectation, expectAll, expectEqual, expectTrue, expectErrContains, fail,
  labelFail
}
import test_process.{underRoot, withScratchDir, medakaBin}
import list.{zipWith}
import string as S
import tools.interface_cmd.{
  buildInterfaceFile, buildBoth, showLines, verdictOf, verdictText
}
import types.prelude_elab.{
  PreludeElab(..), encodeElabFile, elabKeyOf, readElabFile, renderElabFault
}
import driver.build_cmd.{
  readPreludeInterface, PreludeInputs(..), PreludeVerdict(..)
}
import types.interface_sexp.{
  PreludeInterfaceFile(..), InterfaceSection(..), encodeInterface, sha256Hex,
  decodeInterface, formatVersion
}
import types.prelude_interface.{PreludeInterface(..), InterfaceKey(..)}

corePath : String
corePath = underRoot "stdlib/core.mdk"

rowLines : List String -> List String
rowLines = filter (S.startsWith "  row ")

test "show lists every published row of every section" =
  match buildInterfaceFile corePath []
    Err e => fail e
    Ok file =>
      let published =
        sum (map (s => length s.isInterface.piCore) file.ifSections)
      expectAll [
        labelFail
          "rows shown"
          (expectEqual published (length (rowLines (showLines "d" file)))),
        labelFail "core has rows" (expectTrue (published > 100)),
        labelFail
          "default targets give one or two sections"
          (expectTrue (length file.ifSections >= 1)),
      ]

copyInto : String -> String -> <IO> Result String Unit
copyInto dir name = match readFile (underRoot "stdlib/\{name}")
  Err e => Err e
  Ok text => writeFile "\{dir}/\{name}" text

-- [body] run on a scratch directory holding the real runtime.mdk and core.mdk.
withStagedStdlib : (String -> <Exec, IO, FileRead, FileWrite> Expectation) ->
  <Exec, IO, FileRead, FileWrite> Expectation
withStagedStdlib body = withScratchDir (dir => match (
  copyInto dir "runtime.mdk",
  copyInto dir "core.mdk",
)
  (Ok _, Ok _) => body dir
  _ => fail "could not stage the scratch stdlib")

test "verify reads fresh, then stale: sources after an edit, and missing without a file" = withStagedStdlib
  (dir =>
    let scratchCore = "\{dir}/core.mdk"
    match buildBoth scratchCore []
      Err e => fail e
      Ok (file, elab) =>
        let before = verdictText (verdictOf scratchCore)
        match writeFile "\{scratchCore}i" (encodeInterface file)
          Err e => fail e
          Ok _ =>
            let onlyInterface = verdictText (verdictOf scratchCore)
            let elabText = encodeElabFile (elabKeyOf file.ifKey) elab
            match writeFile "\{scratchCore}e" elabText
              Err e => fail e
              Ok _ =>
                let fresh = verdictText (verdictOf scratchCore)
                match readFile scratchCore
                  Err e => fail e
                  Ok text => match writeFile scratchCore (text ++ " ")
                    Err e => fail e
                    Ok _ => expectAll [
                      labelFail "no file yet" (expectEqual "missing" before),
                      labelFail
                        "interface only"
                        (expectEqual
                          "stale: elaborated trees (.mdke) missing"
                          onlyInterface),
                      labelFail
                        "both files just written"
                        (expectEqual "fresh" fresh),
                      labelFail
                        "source edited"
                        (expectEqual
                          "stale: sources"
                          (verdictText (verdictOf scratchCore))),
                    ])

verdictName : PreludeVerdict -> String
verdictName (PVLoaded _) = "loaded"
verdictName PVMissing = "missing"
verdictName (PVStale component) = "stale: \{component}"
verdictName PVDisabled = "disabled"

-- The verdict of reading [file], written under compiler identity [written],
-- as compiler [reader].
readUnder : PreludeInputs ->
  PreludeInterfaceFile ->
  String ->
  <IO> Result String String
readUnder inputs file written =
  let stamped = { file | ifKey = { file.ifKey | ikCompiler = written } }
  map
    (_ => verdictName (readPreludeInterface inputs))
    (writeFile "\{inputs.pnStdlibDir}/core.mdki" (encodeInterface stamped))

test "an empty compiler identity on either side reads stale: compiler" = withStagedStdlib
  (dir => match (
    readFile "\{dir}/runtime.mdk",
    readFile "\{dir}/core.mdk",
    buildInterfaceFile "\{dir}/core.mdk" [],
  )
    (Ok runtimeSrc, Ok coreSrc, Ok file) =>
      let read written reader =
        readUnder
          PreludeInputs {
            pnStdlibDir = dir,
            pnRuntimeSrc = runtimeSrc,
            pnCoreSrc = coreSrc,
            pnCompiler = reader,
          }
          file
          written
      expectAll [
        labelFail
          "both empty"
          (expectEqual (Ok "stale: compiler") (read "" "")),
        labelFail
          "file empty"
          (expectEqual (Ok "stale: compiler") (read "" "x")),
        labelFail
          "reader empty"
          (expectEqual (Ok "stale: compiler") (read "x" "")),
        labelFail "both named" (expectEqual (Ok "loaded") (read "x" "x")),
      ]
    _ => fail "could not read the scratch stdlib")

test "a core with a type error is refused with its diagnostic" = withStagedStdlib
  (dir =>
    let scratchCore = "\{dir}/core.mdk"
    match readFile scratchCore
      Err e => fail e
      Ok text =>
        match (writeFile
          scratchCore
          (text ++ "\nbadBinding : Int\nbadBinding = \"x\"\n"))
          Err e => fail e
          Ok _ =>
            expectErrContains
              "type mismatch"
              (map (_ => ()) (buildInterfaceFile scratchCore [])))

-- ── the check family's fallback ─────────────────────────────────────────────
--
-- Each case runs the built binary under its own scratch MEDAKA_ROOT, which has
-- the real prelude and no `compiler/` directory (so the binary's own staleness
-- check skips it), and holds one variant of `core.mdki`.  The reference runs
-- read the fresh file with the interface disabled.

helloSrc : String
helloSrc = """main : <Stdout> Unit
main = println "hi"
"""

staleLine : String -> String
staleLine component =
  "prelude interface stale: checking stdlib/core.mdk (\{component})\n"

-- A scratch root holding the real prelude and [mdki] as its `core.mdki`.
stageRoot : String -> Option String -> <IO> Result String Unit
stageRoot root mdki = do
  _ <- makeDir root
  _ <- makeDir "\{root}/stdlib"
  _ <- copyInto "\{root}/stdlib" "runtime.mdk"
  _ <- copyInto "\{root}/stdlib" "core.mdk"
  match mdki
    Some text => writeFile "\{root}/stdlib/core.mdki" text
    None => Ok ()

-- [text] with its key changed and its digest recomputed.
reKeyed : (InterfaceKey -> InterfaceKey) -> String -> Result String String
reKeyed change text = match decodeInterface text
  Err e => Err e.seWhat
  Ok f => Ok (encodeInterface { f | ifKey = change f.ifKey })

-- What a spawned run gave: exit code, stdout and stderr.
data Run = Run {
  runCode : Int,
  runOut : String,
  runErr : String,
} deriving (Eq, Debug)

runOf : (Int, String, String) -> Run
runOf (code, out, err) = Run { runCode = code, runOut = out, runErr = err }

-- A stale variant of the fresh file: its name, the component the line names,
-- and its text.
data StaleFile = StaleFile {
  sfName : String,
  sfComponent : String,
  sfText : String,
}

staleFiles : String -> Result String (List StaleFile)
staleFiles fresh = do
  foreignCompiler <- reKeyed
    (k => { k | ikCompiler = "not-this-compiler" })
    fresh
  otherSources <- reKeyed
    (k => { k | ikSources = map (s => (fst s, "0")) k.ikSources })
    fresh
  Ok [
    StaleFile "compiler" "compiler" foreignCompiler,
    StaleFile "sources" "sources" otherSources,
    StaleFile "truncated" "file" (S.take (S.length fresh / 2) fresh),
    StaleFile
      "version"
      "format"
      (S.replace
        "(medaka-interface \{formatVersion} "
        "(medaka-interface 99 "
        fresh),
    StaleFile
      "previous format"
      "format"
      (S.replace
        "(medaka-interface \{formatVersion} "
        "(medaka-interface \{formatVersion - 1} "
        fresh),
    StaleFile "digest" "file" (S.replace "(digest " "(digest 0" fresh),
  ]

-- `env` arguments running the binary under [root] with [env] set, after
-- clearing the switches this file's own run may carry.
under : String ->
  List String ->
  List String ->
  <Env "MEDAKA_ROOT", Env "MEDAKA"> List String
under root env verb =
  [
      "MEDAKA_ROOT=\{root}",
      "MEDAKA_STRICT=",
      "MEDAKA_NO_INTERFACE=",
      "MEDAKA_STAGE_COUNTS=",
    ]
    ++ env
    ++ [medakaBin]
    ++ verb

-- One case: its label, its `env` arguments, and what the run must give.
data Case = Case { caseLabel : String, caseArgv : List String, caseWant : Run }

caseVerdict : Case -> Result String (Int, String, String) -> Expectation
caseVerdict c got =
  labelFail c.caseLabel (expectEqual (Ok c.caseWant) (map runOf got))

-- A stale variant's cases: the reference's output with the one line on stderr,
-- and exit 1 under MEDAKA_STRICT.
staleCases : String ->
  Run ->
  Run ->
  StaleFile ->
  <Env "MEDAKA_ROOT", Env "MEDAKA"> List Case
staleCases dir checkRef jsonRef f =
  let root = "\{dir}/\{f.sfName}"
  let hello = "\{dir}/hello.mdk"
  let line = staleLine f.sfComponent
  [
    Case "\{f.sfName}: check" (under root [] ["check", hello]) { checkRef |
      runErr = line,
    },
    Case "\{f.sfName}: check --json" (under root [] [
      "check", "--json", hello
    ]) { jsonRef |
      runErr = line,
    },
    Case "\{f.sfName}: check under MEDAKA_STRICT" (under
      root
      ["MEDAKA_STRICT=1"]
      ["check", hello]) Run { runCode = 1, runOut = "", runErr = line },
  ]

-- The reference runs: `check`, `check --json` and `run --json` of hello over
-- the fresh file with the interface disabled.
referenceArgvs : String -> <Env "MEDAKA_ROOT", Env "MEDAKA"> List (List String)
referenceArgvs dir =
  let off = under "\{dir}/fresh" ["MEDAKA_NO_INTERFACE=1"]
  let hello = "\{dir}/hello.mdk"
  [
    off ["check", hello],
    off ["check", "--json", hello],
    off ["run", "--json", hello],
  ]

-- The silent cases, each giving its reference's output exactly: a fresh file,
-- no file, a stale file with the interface disabled, and `run --json` over a
-- stale file.
silentCases : String ->
  Run ->
  Run ->
  <Env "MEDAKA_ROOT", Env "MEDAKA"> List Case
silentCases dir checkRef runRef =
  let hello = "\{dir}/hello.mdk"
  [
    Case "fresh: check" (under "\{dir}/fresh" [] ["check", hello]) checkRef,
    Case "missing: check" (under "\{dir}/missing" [] ["check", hello]) checkRef,
    Case
      "disabled: check"
      (under "\{dir}/compiler" ["MEDAKA_NO_INTERFACE=1"] ["check", hello])
      checkRef,
    Case
      "compiler: run --json"
      (under "\{dir}/compiler" [] ["run", "--json", hello])
      runRef,
  ]

stageAll : String -> String -> List StaleFile -> <IO> Result String Unit
stageAll dir fresh stale = do
  _ <- writeFile "\{dir}/hello.mdk" helloSrc
  _ <- stageRoot "\{dir}/fresh" (Some fresh)
  _ <- stageRoot "\{dir}/missing" None
  firstErr (map (f => stageRoot "\{dir}/\{f.sfName}" (Some f.sfText)) stale)

firstErr : List (Result String Unit) -> Result String Unit
firstErr [] = Ok ()
firstErr ((Err e) :: _) = Err e
firstErr ((Ok _) :: rest) = firstErr rest

test "a stale prelude interface prints one line on the check family and changes no output" = withScratchDir
  (dir => match readFile (underRoot "stdlib/core.mdki")
    Err e => fail "no stdlib/core.mdki (run make medaka): \{e}"
    Ok fresh => match staleFiles fresh
      Err e => fail e
      Ok stale => match stageAll dir fresh stale
        Err e => fail e
        Ok _ => match runCommandBatch "env" 3 (referenceArgvs dir)
          [Ok c, Ok j, Ok r] =>
            let checkRef = runOf c
            let jsonRef = runOf j
            let runRef = runOf r
            let cases =
              flatMap (staleCases dir checkRef jsonRef) stale
                ++ silentCases dir checkRef runRef
            let runs = runCommandBatch "env" 4 (map (c => c.caseArgv) cases)
            expectAll
              (labelFail
                  "the reference check passes"
                  (expectEqual (0, "") (checkRef.runCode, checkRef.runErr))
                :: zipWith caseVerdict cases runs)
          other => fail "reference runs failed: \{debug other}")

-- ── the elaborated trees, through the built binary ─────────────────────────
--
-- A spawned write runs in a fresh process, where core's counters are the
-- values the format promises.

writeArgv : String -> <Env "MEDAKA_ROOT", Env "MEDAKA"> List String
writeArgv dir = [
  "MEDAKA_STRICT=",
  "MEDAKA_NO_INTERFACE=",
  medakaBin,
  "interface",
  "write",
  "\{dir}/core.mdk",
]

-- What the built binary's `interface verify` prints for [dir]'s core; the
-- file's compiler identity is the binary's own, not this test process's.
verifyOut : String -> <Exec, Env "MEDAKA_ROOT", Env "MEDAKA"> String
verifyOut dir = match runCommandBatch "env" 1 [
  [
    "MEDAKA_STRICT=",
    medakaBin,
    "interface",
    "verify",
    "\{dir}/core.mdk",
  ],
]
  [Ok (_, out, _)] => S.trim out
  _ => "the verify run failed"

exitOf : Result String (Int, String, String) -> Int
exitOf (Ok (code, _, _)) = code
exitOf (Err _) = -1

test "the writer leaves a fresh pair whose counters describe its rows, the same bytes twice" = withStagedStdlib
  (dir => match runCommandBatch "env" 1 [writeArgv dir]
    [first] =>
      let a = readFile "\{dir}/core.mdke"
      let second = runCommandBatch "env" 1 [writeArgv dir]
      let b = readFile "\{dir}/core.mdke"
      match (a, b)
        (Ok ta, Ok tb) => match readElabFile ta
          Err f => fail "did not read: \{renderElabFault f}"
          Ok (key, pe) => expectAll [
            labelFail "first write exit" (expectEqual 0 (exitOf first)),
            labelFail "second write exit" (expectEqual [0] (map exitOf second)),
            labelFail "determinism" (expectEqual (sha256Hex ta) (sha256Hex tb)),
            labelFail "both files fresh" (expectEqual "fresh" (verifyOut dir)),
            labelFail
              "the file is what its own value encodes to"
              (expectEqual ta (encodeElabFile key pe)),
            labelFail
              "the evidence counter is above the kept rows"
              (expectTrue
                (pe.peEvCounter > 0
                  && length pe.peEvidence > 0
                  && length pe.peEvidence <= pe.peEvCounter)),
            labelFail
              "the binder count is the rows'"
              (expectEqual (length pe.peBinders) pe.peBinderCount),
            labelFail
              "a fresh process hands out core's binder ordinals from 0"
              (expectEqual 0 pe.peBinderBase),
          ]
        _ => fail "core.mdke was not written"
    _ => fail "write run failed")

test "a core with a type error writes neither file and exits 1" = withStagedStdlib
  (dir =>
    let broken = "\nbadBinding : Int\nbadBinding = \"x\"\n"
    match readFile "\{dir}/core.mdk"
      Err e => fail e
      Ok text => match writeFile "\{dir}/core.mdk" (text ++ broken)
        Err e => fail e
        Ok _ => match runCommandBatch "env" 1 [writeArgv dir]
          [run] => expectAll [
            labelFail "exit code" (expectEqual 1 (exitOf run)),
            labelFail
              "no interface file"
              (expectTrue (isErr (readFile "\{dir}/core.mdki"))),
            labelFail
              "no elaborated file"
              (expectTrue (isErr (readFile "\{dir}/core.mdke"))),
          ]
          _ => fail "write run failed")

test "two concurrent writes both succeed and leave a fresh pair" = withStagedStdlib
  (dir => match runCommandBatch "env" 2 [writeArgv dir, writeArgv dir]
    runs => expectAll [
      labelFail "both exit 0" (expectEqual [0, 0] (map exitOf runs)),
      labelFail "fresh" (expectEqual "fresh" (verifyOut dir)),
    ])

test "a missing or stale elaborated file makes verify name it" = withStagedStdlib
  (dir => match runCommandBatch "env" 1 [writeArgv dir]
    [_] =>
      let fresh = verifyOut dir
      let _ = removeFile "\{dir}/core.mdke"
      let missing = verifyOut dir
      match writeFile "\{dir}/core.mdke" "(medaka-elab 99)\n"
        Err e => fail e
        Ok _ => expectAll [
          labelFail "both written" (expectEqual "fresh" fresh),
          labelFail
            "mdke removed"
            (expectEqual "stale: elaborated trees (.mdke) missing" missing),
          labelFail
            "mdke of another format"
            (expectEqual
              "stale: elaborated trees (.mdke) format"
              (verifyOut dir)),
        ]
    _ => fail "write run failed")

-- What `verify` prints for [dir] after its fresh core.mdke is replaced by [edited].
verdictOfText : String ->
  String ->
  <Exec, IO, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> Result String String
verdictOfText dir edited =
  map (_ => verifyOut dir) (writeFile "\{dir}/core.mdke" edited)

-- [fresh] with its evidence counter changed by [change] and, when [redigest],
-- the digest recomputed over the edited covered text.
counterEdited : String -> (Int -> Int) -> Bool -> Result String String
counterEdited fresh change redigest = match (
  readElabFile fresh,
  S.indexOf "\n" fresh,
)
  (Ok (_, pe), Some i) =>
    let covered = S.drop (i + 1) fresh
    let k = pe.peEvCounter
    let edited = S.replace "(counters \{k} " "(counters \{change k} " covered
    let header = S.take i fresh
    Ok (if redigest then
      "\{S.replace (sha256Hex covered) (sha256Hex edited) header}\n\{edited}"
    else
      "\{header}\n\{edited}")
  _ => Err "the fresh file did not read"

-- What `verify` prints for [dir] once [fresh]'s evidence counter is lowered by one.
verdictOfCounter : String ->
  String ->
  Bool ->
  <Exec, IO, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> Result String String
verdictOfCounter dir fresh redigest =
  match counterEdited fresh (k => k - 1) redigest
    Ok edited => verdictOfText dir edited
    Err e => Err e

test "verify names the component of a header edit, a truncation and an empty elaborated file" = withStagedStdlib
  (dir => match runCommandBatch "env" 1 [writeArgv dir]
    [_] => match readFile "\{dir}/core.mdke"
      Err e => fail e
      Ok fresh =>
        let header =
          verdictOfText dir (S.replace "(compiler " "(compiler 0" fresh)
        let truncated = verdictOfText dir (S.take (S.length fresh / 2) fresh)
        let empty = verdictOfText dir ""
        let counters = verdictOfCounter dir fresh False
        let counterDigested = verdictOfCounter dir fresh True
        expectAll [
          labelFail
            "compiler field edited"
            (expectEqual
              (Ok "stale: elaborated trees (.mdke) compiler")
              header),
          labelFail
            "truncated"
            (expectEqual (Ok "stale: elaborated trees (.mdke) file") truncated),
          labelFail
            "empty"
            (expectEqual (Ok "stale: elaborated trees (.mdke) file") empty),
          labelFail
            "counter lowered under the old digest"
            (expectEqual (Ok "stale: elaborated trees (.mdke) file") counters),
          labelFail
            "counter lowered under a recomputed digest"
            (expectEqual
              (Ok "stale: elaborated trees (.mdke) file")
              counterDigested),
        ]
    _ => fail "write run failed")
