-- Unit tests for test_cmd.mdk's `treesUnread`: whether a `medaka test` run
-- may skip elaborating the trees that only the prop planner and the
-- interpreter arms read.

import frontend.ast.{Decl}
import frontend.parser.{parse}
import tools.doctest.{Engine(..)}
import tools.test_cmd.{
  treesUnread, childJobsPrefix, childGcMarkersPrefix, helperElabDiags, runTest,
  besideRuntime
}
import frontend.desugar.{desugar}
import frontend.parser.{parseLocated}
import types.typecheck.{defaultDriveInputs, elaborateModules}
import eval.eval.{Value(..), evalOneFacts, force}
import types.program_facts.{factsOfElab}
import support.util.{lookupAssoc}
import io.{runVerb}
import string.{contains, indexOf, toInt, trim, lines, words, startsWith, join}
import list.{reverse, take}
import test.{
  Expectation, expectAll, expectEqual, expectFalse, expectNotEqual, expectTrue,
  fail, labelFail
}
import json.{Json(..)}
import json as J
import test_process.{medakaBin, underRoot, withScratchDir}

noProps : List Decl
noProps = parse "f : Int -> Int\nf x = x + 1\n\ntest \"t\" = f 1 == 2\n"

withProp : List Decl
withProp = parse "prop \"p\" (x : Int) = x == x\n"

test "a native-only run with no props leaves the trees unread" =
  expectTrue (treesUnread [EngNative] noProps)

test "any interpreter engine reads the trees" = expectAll [
  expectFalse (treesUnread [EngInterp] noProps),
  expectFalse (treesUnread [EngInterp, EngNative] noProps),
  expectFalse (treesUnread [EngNative, EngInterp] noProps),
]

test "a target with props reads the trees, even native-only" =
  expectFalse (treesUnread [EngNative] withProp)

-- A program whose value reads a method occurrence's published evidence.
methodProgram : List (String, List Decl)
methodProgram = [
  (
    "helper_probe",
    desugar
      (parseLocated
        "interface Def a where\n  def : a\nimpl Def Int where\n  def = 7\nmain : Int\nmain = def\n"),
  ),
]

-- `main` of the trees one drive elaborated, evaluated after the helper validation's
-- diagnostics-only drive has run, against the facts of the drive that elaborated
-- them, as the property worker does.
mainAfterHelperDiags : Unit -> Int
mainAfterHelperDiags _ =
  let elab = elaborateModules defaultDriveInputs [] [] methodProgram
  let coreE = elab.erCore
  let modulesE = elab.erModules
  let _ = helperElabDiags [] [] methodProgram
  let facts = factsOfElab elab
  let bindings = evalOneFacts facts coreE ("helper_probe", flatMap snd modulesE)
  match lookupAssoc "main" bindings
    Some value => match force value
      VInt n => n
      _ => -1
    None => -2

test "trees elaborated before a helper diagnostics drive still evaluate" =
  expectEqual 7 (mainAfterHelperDiags ())

dirWithPassFailBroken : String -> <FileWrite> Result String Unit
dirWithPassFailBroken dir = do
  _ <- writeFile
    "\{dir}/a_ok_test.mdk"
    "import test.{expectEqual}\n\ntest \"fine\" = expectEqual (1 + 1) 2\n"
  _ <- writeFile
    "\{dir}/b_fail_test.mdk"
    "import test.{expectEqual}\n\ntest \"bad\" = expectEqual (1 + 1) 3\n"
  _ <- writeFile "\{dir}/c_broken_test.mdk" "test \"broken\" = (\n"
  writeFile
    "\{dir}/d_ok_test.mdk"
    "import test.{expectEqual}\n\ntest \"also fine\" = expectEqual (2 + 2) 4\n"

appearsBefore : String -> String -> String -> Bool
appearsBefore first second text = match (
  indexOf first text,
  indexOf second text,
)
  (Some i, Some j) => i < j
  _ => False

dirRun : String -> String -> <Exec, IO> Result String (Int, String, String)
dirRun jobs dir = runVerb "env" [
  "MEDAKA_TEST_JOBS=\{jobs}",
  medakaBin,
  "test",
  dir,
  "--engines",
  "native",
]

-- A directory target prints each file's output in input order and names each
-- failing child, whatever MEDAKA_TEST_JOBS is.
test "a directory run is the same serial or concurrent, in order, with death notices" = withScratchDir
  (dir => match dirWithPassFailBroken dir
    Err e => fail e
    Ok () => match (dirRun "1" dir, dirRun "4" dir)
      (Ok (c1, o1, e1), Ok (c4, o4, e4)) => expectAll [
        expectEqual c1 c4,
        expectEqual o1 o4,
        expectEqual e1 e4,
        expectNotEqual c1 0,
        expectTrue
          (contains "b_fail_test.mdk: test runner died (child exited" e4),
        expectTrue
          (contains "c_broken_test.mdk: test runner died (child exited" e4),
        expectFalse (contains "a_ok_test.mdk: test runner died" e4),
        expectFalse (contains "d_ok_test.mdk: test runner died" e4),
        expectTrue
          (appearsBefore
            "b_fail_test.mdk: test runner died"
            "c_broken_test.mdk: test runner died"
            e4),
      ]
      _ => fail "could not spawn medaka test")

dirWithSlowFirst : String -> <FileWrite> Result String Unit
dirWithSlowFirst dir = do
  _ <- writeFile
    "\{dir}/a_slow_test.mdk"
    "import test.{expectEqual}\n\nfib : Int -> Int\nfib n = if n < 2 then n else fib (n - 1) + fib (n - 2)\n\ntest \"slow one\" = expectEqual (fib 36) 14930352\n"
  _ <- writeFile
    "\{dir}/b_fast_test.mdk"
    "import test.{expectEqual}\n\ntest \"fast two\" = expectEqual 1 1\n"
  writeFile
    "\{dir}/c_fast_test.mdk"
    "import test.{expectEqual}\n\ntest \"fast three\" = expectEqual 2 2\n"

-- The slow first file finishes last at JOBS=4, yet its output still leads.
test "a slow first file still prints first under concurrent jobs" = withScratchDir
  (dir => match dirWithSlowFirst dir
    Err e => fail e
    Ok () => match (dirRun "1" dir, dirRun "4" dir)
      (Ok (c1, o1, e1), Ok (c4, o4, e4)) => expectAll [
        expectEqual 0 c4,
        expectEqual c1 c4,
        expectEqual o1 o4,
        expectEqual e1 e4,
        expectTrue (appearsBefore "slow one" "fast two" o4),
        expectTrue (appearsBefore "fast two" "fast three" o4),
      ]
      _ => fail "could not spawn medaka test")

test "children split the budget with the outer fan-out" = expectAll [
  expectEqual ["MEDAKA_TEST_JOBS=2"] (childJobsPrefix 2 4),
  expectEqual ["MEDAKA_TEST_JOBS=4"] (childJobsPrefix 1 4),
  expectEqual ["MEDAKA_TEST_JOBS=1"] (childJobsPrefix 4 4),
  expectEqual ["MEDAKA_TEST_JOBS=1"] (childJobsPrefix 8 4),
  expectEqual ["MEDAKA_TEST_JOBS=1"] (childJobsPrefix 1 1),
  expectEqual ["MEDAKA_TEST_JOBS=1"] (childJobsPrefix 0 1),
]

test "GC_MARKERS: caller env beats the concurrent-children default" = expectAll
  [
    expectEqual ["GC_MARKERS=1"] (childGcMarkersPrefix "" 4),
    expectEqual [] (childGcMarkersPrefix "4" 4),
    expectEqual [] (childGcMarkersPrefix "" 1),
  ]

dirWithKnobProbe : String -> <FileWrite> Result String Unit
dirWithKnobProbe dir = dirWithKnobProbeFor dir knobProbeSource

dirWithKnobProbeFor : String -> String -> <FileWrite> Result String Unit
dirWithKnobProbeFor dir src = match writeFile (probeFile dir "a") src
  Err e => Err e
  Ok () => writeFile (probeFile dir "b") src

knobProbeSource : String
knobProbeSource = knobProbeSourceFor 2

knobProbeSourceFor : Int -> String
knobProbeSourceFor n =
  "import test.{expectEqual}\n\ntest \"knob\" = expectEqual (getEnv \"MEDAKA_TEST_JOBS\") (Some \"\{intToString n}\")\n"

probeFile : String -> String -> String
probeFile dir name = "\{dir}/\{name}_knob_test.mdk"

-- Two files under a set knob of 4 run two at once, so each child sees half of
-- it; a knob of 3 divides to 1, so the same probe fails.
test "a directory run divides a set knob across its concurrent children" = withScratchDir
  (dir => match dirWithKnobProbe dir
    Err e => fail e
    Ok () => match (
      runVerb "env" ["MEDAKA_TEST_JOBS=4", medakaBin, "test", dir],
      runVerb "env" ["MEDAKA_TEST_JOBS=3", medakaBin, "test", dir],
    )
      (Ok (c4, _, _), Ok (c3, _, _)) => expectAll [
        expectEqual 0 c4,
        expectNotEqual 0 c3,
      ]
      _ => fail "could not spawn medaka test")

-- A value that is not a positive integer reads as unset, so a child still gets
-- a positive budget rather than the bad value.
positiveKnobProbeSource : String
positiveKnobProbeSource =
  "import string.{toInt}\nimport test.{expectTrue}\n\ntest \"knob\" = expectTrue (getEnv \"MEDAKA_TEST_JOBS\" |> flatMap toInt |> map (n => n > 0) |> optionOr False)\n"

test "a directory run reads an invalid knob as unset" = withScratchDir
  (dir => match writeFile (probeFile dir "p") positiveKnobProbeSource
    Err e => fail e
    Ok () => match (
      runVerb "env" ["MEDAKA_TEST_JOBS=0", medakaBin, "test", dir],
      runVerb "env" ["MEDAKA_TEST_JOBS=-3", medakaBin, "test", dir],
      runVerb "env" ["MEDAKA_TEST_JOBS=x", medakaBin, "test", dir],
    )
      (Ok (c0, _, _), Ok (cn, _, _), Ok (cx, _, _)) => expectAll [
        expectEqual 0 c0,
        expectEqual 0 cn,
        expectEqual 0 cx,
      ]
      _ => fail "could not spawn medaka test")

-- With the knob unset the outer fan-out is every core, capped by the two
-- files, so each child is handed the cores divided by min(cores, 2).
test "a directory run hands each child the divided budget when the knob is unset" = withScratchDir
  (dir => match runVerb "nproc" []
    Ok (0, out, _) => unsetKnobRun dir (toInt (trim out))
    _ => fail "could not run nproc")

unsetKnobRun : String -> Option Int -> <Exec, FileWrite, IO> Expectation
unsetKnobRun _ None = fail "nproc printed no count"
unsetKnobRun dir (Some cores) =
  match (dirWithKnobProbeFor
    dir
    (knobProbeSourceFor (max 1 (cores / min cores 2))))
    Err e => fail e
    Ok () =>
      match runVerb "env" ["-u", "MEDAKA_TEST_JOBS", medakaBin, "test", dir]
        Ok (c, _, _) => expectEqual 0 c
        _ => fail "could not spawn medaka test"

-- A check-accepted file whose doctest example is ill-typed: the example's own
-- injected elaboration rejects it, so under the interpreter it is that example's
-- error, and the file's other examples still run rather than every one dying on
-- the evaluator's unrouted-dictionary panic.  One target imports nothing (the
-- single-module arm), the other imports a sibling (the injected-graph arm).
illTypedDoctestFiles : String -> <FileWrite> Result String Unit
illTypedDoctestFiles dir = do
  _ <- writeFile
    "\{dir}/single.mdk"
    "-- Doc.\n--\n-- > debug []\n-- []\n-- > zero + 1\n-- 1\nexport zero = 0\n"
  _ <- writeFile "\{dir}/lib.mdk" "export one = 1\n"
  writeFile
    "\{dir}/imports.mdk"
    "import lib.{one}\n\n-- Doc.\n--\n-- > debug []\n-- []\n-- > two + 1\n-- 3\nexport two = one + 1\n"

evalDoctests : String -> <Exec, IO> Result String (Int, String, String)
evalDoctests target = runVerb medakaBin ["test", "--engines", "eval", target]

test "an ill-typed doctest example fails alone under the interpreter" = withScratchDir
  (dir => match illTypedDoctestFiles dir
    Err e => fail e
    Ok () => match (
      evalDoctests "\{dir}/single.mdk",
      evalDoctests "\{dir}/imports.mdk",
    )
      (Ok (c1, o1, e1), Ok (c2, o2, e2)) => expectAll [
        expectEqual 1 c1,
        expectTrue (contains "ERROR \{dir}/single.mdk:3: debug []" o1),
        expectTrue (contains "ok   \{dir}/single.mdk:5: zero + 1" o1),
        expectFalse (contains "unrouted dictionary slot" e1),
        expectEqual 1 c2,
        expectTrue (contains "ERROR \{dir}/imports.mdk:5: debug []" o2),
        expectTrue (contains "ok   \{dir}/imports.mdk:7: two + 1" o2),
        expectFalse (contains "unrouted dictionary slot" e2),
      ]
      _ => fail "could not spawn medaka test")

-- The prelude is read from the directory of runtime.mdk, so a core.mdk from
-- anywhere else is refused (the verb exits 1 on the False).  The pair beside it
-- is what every `medaka test` run uses.
test "runTest refuses a core.mdk that is not the one beside runtime.mdk" = withScratchDir
  (dir =>
    let target = "\{dir}/target.mdk"
    match (
      readFile (underRoot "stdlib/core.mdk"),
      writeFile target "main = 1\n",
    )
      (Ok core, Ok _) => match writeFile "\{dir}/core.mdk" core
        Err e => fail e
        Ok _ =>
          expectFalse
            (runTest
              [EngInterp]
              (underRoot "stdlib/runtime.mdk")
              "\{dir}/core.mdk"
              target
              [dir]
              100
              None)
      _ => fail "could not stage the scratch files")

-- Spellings of the one directory are the same directory, and a symlink to it
-- resolves to it; another directory's core.mdk stays refused.
test "core.mdk is beside runtime.mdk under any spelling of their directory" = withScratchDir
  (dir =>
    let stdlib = underRoot "stdlib"
    let link = "\{dir}/stdlink"
    let linked = runCommandBatch "ln" 1 [["-s", stdlib, link]]
    expectAll [
      labelFail
        "plain"
        (expectTrue
          (besideRuntime "\{stdlib}/runtime.mdk" "\{stdlib}/core.mdk")),
      labelFail
        "doubled slash"
        (expectTrue
          (besideRuntime "\{stdlib}//runtime.mdk" "\{stdlib}/core.mdk")),
      labelFail
        "dot segment"
        (expectTrue
          (besideRuntime "\{stdlib}/./runtime.mdk" "\{stdlib}/core.mdk")),
      labelFail
        "symlinked directory"
        (expectTrue (besideRuntime "\{link}/runtime.mdk" "\{stdlib}/core.mdk")),
      labelFail "the link was made" (expectEqual 1 (length linked)),
      labelFail
        "another directory"
        (expectFalse (besideRuntime "\{stdlib}/runtime.mdk" "\{dir}/core.mdk")),
      labelFail
        "another file name"
        (expectFalse
          (besideRuntime "\{stdlib}/runtime.mdk" "\{stdlib}/list.mdk")),
    ])

test "medaka test runs a target against the core.mdk beside runtime.mdk" = withScratchDir
  (dir => match writeFile "\{dir}/target.mdk" "main = 1\n"
    Err e => fail e
    Ok _ => match runVerb medakaBin ["test", "\{dir}/target.mdk"]
      Ok (code, out, _) => expectAll [
        expectEqual 0 code,
        expectTrue (contains "(no doctests found)" out),
      ]
      Err e => fail e)

-- The run seed: one `medaka test` invocation picks it (MEDAKA_SEED, else
-- entropy), every engine draws from it, and a run whose tests ran and failed
-- prints `seed: N (rerun with MEDAKA_SEED=N)` once, after the summary.

-- `medaka test` with MEDAKA_SEED set to `seed`, or removed from the
-- environment when it is None.
seededTest : Option Int ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
seededTest seed args =
  runVerb "env" (seedAssignment seed ++ [medakaBin, "test"] ++ args)

seedAssignment : Option Int -> List String
seedAssignment (Some n) = ["MEDAKA_SEED=\{intToString n}"]
seedAssignment None = ["-u", "MEDAKA_SEED"]

-- Runs `check` on a spawn's result, or fails the row when it did not start.
withSpawn : Result String (Int, String, String) ->
  ((Int, String, String) -> <Exec, IO> Expectation) ->
  <Exec, IO> Expectation
withSpawn (Ok r) check = check r
withSpawn (Err e) _ = fail "could not spawn medaka: \{e}"

seedLines : List String -> List String
seedLines = filter (startsWith "seed: ")

-- A top-level member of the one JSON document `out` holds; None when `out` does
-- not parse or the member is absent.
jsonMember : String -> String -> Option Json
jsonMember key out = match J.parse (trim out)
  Ok doc => J.get key doc
  Err _ => None

lastWord : String -> String
lastWord line = match reverse (words line)
  w :: _ => w
  [] => ""

-- The value a failing `expectEqual` reports ("expected -1 but got V").
gotValues : String -> List String
gotValues out = map lastWord (filter (contains "but got ") (lines out))

lastNonEmpty : String -> String
lastNonEmpty out = match reverse (filter (l => trim l /= "") (lines out))
  l :: _ => l
  [] => ""

-- The N of a `seed: N (rerun with MEDAKA_SEED=N)` line.
seedOfLine : String -> Option Int
seedOfLine line = match words line
  _ :: n :: _ => toInt n
  _ => None

seedLineFor : Int -> String
seedLineFor n = join "" [
  "seed: ",
  intToString n,
  " (rerun with MEDAKA_SEED=",
  intToString n,
  ")",
]

drawTestSrc : String
drawTestSrc =
  "import test.{expectEqual}\n\ntest \"draws\" = expectEqual (-1) (randomInt 0 1000000000)\n"

-- The same draw as `drawTestSrc`, as a program whose only output is the value.
drawMainSrc : String
drawMainSrc = "main = println (intToString (randomInt 0 1000000000))\n"

passTestSrc : String
passTestSrc = "import test.{expectEqual}\n\ntest \"fine\" = expectEqual 1 1\n"

-- A type error beside a doctest, so the file is type-checked and refused before
-- any test runs.
illTypedSrc : String
illTypedSrc = "-- > f 1\n-- 1\nf : Int -> Int\nf x = \"a\"\n"

writeFiles : String -> List (String, String) -> <FileWrite> Result String Unit
writeFiles _ [] = Ok ()
writeFiles dir ((name, src) :: rest) = match writeFile "\{dir}/\{name}" src
  Ok _ => writeFiles dir rest
  Err e => Err e

withFixtures : List (String, String) ->
  (String -> <Exec, IO, FileRead, FileWrite> Expectation) ->
  <Exec, IO, FileRead, FileWrite> Expectation
withFixtures files body = withScratchDir (dir => match writeFiles dir files
  Ok _ => body dir
  Err e => fail e)

-- The value `medaka run` draws under MEDAKA_SEED=n.
runDraw : Int -> String -> <Exec, IO> String
runDraw n mainPath = match runVerb "env" [
  "MEDAKA_SEED=\{intToString n}",
  medakaBin,
  "run",
  mainPath,
]
  Ok (_, out, _) => trim out
  Err e => "spawn failed: \{e}"

test "a failing test prints one seed line after the summary, and that seed replays the failure" =
  withFixtures
    [("draw_test.mdk", drawTestSrc), ("draw.mdk", drawMainSrc)]
    (dir =>
      let target = "\{dir}/draw_test.mdk"
      withSpawn (seededTest None [
        target,
      ]) ((code, out, _) => match seedLines (lines out)
        [line] => match seedOfLine line
          Some n => expectAll [
            expectNotEqual 0 code,
            expectEqual (seedLineFor n) line,
            expectEqual line (lastNonEmpty out),
            expectTrue (contains "0/1 passed" out),
            withSpawn (seededTest (Some n) [
              target,
            ]) ((_, replay, _) => expectAll [
              expectEqual out replay,
              expectEqual (gotValues out) [runDraw n "\{dir}/draw.mdk"],
            ]),
          ]
          None => fail "unreadable seed line: \{line}"
        found => fail "want exactly one seed line, got \{debug found}"))

test "MEDAKA_SEED=7 gives the same draw on the eval engine, the native engine and run" =
  withFixtures
    [("draw_test.mdk", drawTestSrc), ("draw.mdk", drawMainSrc)]
    (dir =>
      let target = "\{dir}/draw_test.mdk"
      let expected = [runDraw 7 "\{dir}/draw.mdk"]
      expectAll [
        withSpawn (seededTest (Some 7) [
          "--engines", "eval", target
        ]) ((_, out, _) => expectAll [
          expectEqual expected (gotValues out),
          expectEqual [seedLineFor 7] (seedLines (lines out)),
        ]),
        withSpawn (seededTest (Some 7) [
          "--engines", "native", target
        ]) ((_, out, _) => expectAll [
          expectEqual expected (gotValues out),
          expectEqual [seedLineFor 7] (seedLines (lines out)),
        ]),
      ])

test "a green run prints no seed line, seeded or not" =
  withFixtures
    [("ok_test.mdk", passTestSrc)]
    (dir =>
      let target = "\{dir}/ok_test.mdk"
      expectAll [
        withSpawn (seededTest None [target]) ((code, out, _) => expectAll [
          expectEqual 0 code,
          expectEqual [] (seedLines (lines out)),
        ]),
        withSpawn (seededTest (Some 7) [target]) ((code, out, _) => expectAll [
          expectEqual 0 code,
          expectEqual [] (seedLines (lines out)),
        ]),
      ])

test "a directory with two failing files prints exactly one seed line, last" =
  withFixtures
    [("a_test.mdk", drawTestSrc), ("b_test.mdk", drawTestSrc)]
    (dir => withSpawn (seededTest None [dir]) ((code, out, _) => expectAll [
      expectNotEqual 0 code,
      expectEqual 2 (count (contains "0/1 passed") (lines out)),
      expectEqual 1 (length (seedLines (lines out))),
      expectEqual (take 1 (seedLines (lines out))) [lastNonEmpty out],
    ]))

test "a refusal before any test runs prints no seed line" =
  withFixtures
    [("ill.mdk", illTypedSrc)]
    (dir =>
      let target = "\{dir}/ill.mdk"
      expectAll [
        withSpawn (seededTest (Some 7) [
          "--engines", "eval", target
        ]) ((code, out, err) => expectAll [
          expectNotEqual 0 code,
          expectEqual [] (seedLines (lines out)),
          expectTrue (contains "type error in" err),
        ]),
        withSpawn (seededTest (Some 7) [
          target,
        ]) ((code, out, err) => expectAll [
          expectNotEqual 0 code,
          expectEqual [] (seedLines (lines out)),
          expectTrue (contains "type error in" err),
        ]),
      ])

test "a malformed MEDAKA_SEED is a usage error" =
  withFixtures
    [("ok_test.mdk", passTestSrc)]
    (dir => withSpawn (runVerb "env" [
      "MEDAKA_SEED=abc",
      medakaBin,
      "test",
      "\{dir}/ok_test.mdk",
    ]) ((code, out, err) => expectAll [
      expectEqual 1 code,
      expectTrue (contains "must be a decimal integer" err),
      expectEqual [] (seedLines (lines out)),
    ]))

test "--json carries the seed only when the run failed, and leaves stderr empty" =
  withFixtures
    [("draw_test.mdk", drawTestSrc), ("ok_test.mdk", passTestSrc)]
    (dir => expectAll [
      withSpawn (seededTest (Some 7) [
        "--json",
        "\{dir}/draw_test.mdk",
      ]) ((code, out, err) => expectAll [
        expectEqual 1 code,
        expectEqual [] (seedLines (lines out)),
        expectEqual (Some (JInt 7)) (jsonMember "seed" out),
        expectEqual "" err,
      ]),
      withSpawn (seededTest (Some 7) [
        "--json",
        "\{dir}/ok_test.mdk",
      ]) ((code, out, err) => expectAll [
        expectEqual 0 code,
        expectEqual None (jsonMember "seed" out),
        expectEqual "" err,
      ]),
    ])

test "a --json type-error refusal carries no seed" =
  withFixtures
    [("ill.mdk", illTypedSrc)]
    (dir => withSpawn (seededTest (Some 7) [
      "--json",
      "\{dir}/ill.mdk",
    ]) ((code, out, _) => expectAll [
      expectEqual 1 code,
      expectEqual None (jsonMember "seed" out),
    ]))

siblingFixtureRun : String ->
  String ->
  <Exec, IO> Result String (Int, String, String)
siblingFixtureRun engine file = runVerb medakaBin [
  "test",
  "--engines",
  engine,
  underRoot "test/sibling_view_fixtures/\{file}",
]

-- A test sibling reaches its subject's private names under `medaka test`: the
-- interpreter through `diSibling` and the facts, the native engine through the
-- real target the scratch build hands its emitter child.  The `test "…"` decls,
-- the prop and the doctest are different runners over different scratch builds.
test "a test sibling's private names resolve under medaka test on both engines" =
  expectAll
    (flatMap
      (engine => [
        match siblingFixtureRun engine "counter_test.mdk"
          Ok (code, out, _) =>
            labelFail
              "\{engine} counter_test"
              (expectAll [
                expectEqual 0 code,
                expectTrue (contains "2/2 passed" out),
              ])
          Err e => fail e,
        match siblingFixtureRun engine "runners_test.mdk"
          Ok (code, out, _) =>
            labelFail
              "\{engine} runners_test"
              (expectAll [
                expectEqual 0 code,
                expectTrue (contains "runners_test.mdk:8: step 1" out),
                expectTrue (contains "\"bump is step\" [\{engine}] ... OK" out),
                expectTrue
                  (contains "runners_test.mdk:11: bump goes through step" out),
              ])
          Err e => fail e,
      ])
      ["eval", "native"])

-- The front-end gate judges an entry by its own path, so naming a real sibling
-- in the environment does not make `other.mdk` buildable.
test "a forged real-target variable grants nothing to an unrelated entry" = withScratchDir
  (dir => match runVerb "env" [
    "MEDAKA_SIBLING_TARGET=\{underRoot "test/sibling_view_fixtures/counter_test.mdk"}",
    medakaBin,
    "build",
    underRoot "test/sibling_view_fixtures/other.mdk",
    "-o",
    "\{dir}/other",
  ]
    Ok (code, _, errOut) => expectAll [
      expectEqual 1 code,
      expectTrue
        (contains "R-PRIVATE-NAME" errOut
          || contains "exports no constructors" errOut),
    ]
    Err e => fail e)

-- An inherited real-target variable reaches a plain build's emitter child only if
-- the parent hands it on: the entry stays a non-sibling, so the subject's private
-- `helper` does not collide with the exported one and the program builds.
test "a forged real-target variable does not reach the emitter child of a plain build" = withScratchDir
  (dir => match runVerb "env" [
    "MEDAKA_SIBLING_TARGET=\{underRoot "test/sibling_view_fixtures/ambp_test.mdk"}",
    medakaBin,
    "build",
    underRoot "test/sibling_view_fixtures/ambp_other.mdk",
    "-o",
    "\{dir}/other",
  ]
    Ok (code, _, errOut) => match runVerb "\{dir}/other" []
      Ok (runCode, out, _) => expectAll [
        labelFail "build: \{errOut}" (expectEqual 0 code),
        expectEqual 0 runCode,
        expectEqual "3\n" out,
      ]
      Err e => fail e
    Err e => fail e)

-- The privilege, case by case, on every engine that can run a sibling.  Each
-- subject's private name is read by its sibling's `main`; the value is fixed
-- by the design (TEST-SIBLING-ACCESS-DESIGN.md §3.1), not by an engine run.
siblingCases : List (String, String)
siblingCases = [
  ("counter", "2\n2\n"),
  ("ptype", "4\n"),
  ("pnewtype", "3\n"),
  ("pimpl", "green\n"),
  ("piface", "5\n"),
  ("peffect", "2\n"),
  ("pimport", "3\n"),
  ("pconstr", "[1, 2, 3]\n"),
  ("psame", "Some 6\n"),
  ("pclash", "105\n3\n"),
  ("palias", "2\n4\n2\n"),
  ("pchain", "2\n"),
  ("pduo", "200\n"),
  ("pshadow", "5\n"),
]

siblingVerb : String -> String -> <Exec, IO> Result String (Int, String, String)
siblingVerb verb file =
  runVerb medakaBin [verb, underRoot "test/sibling_view_fixtures/\{file}"]

-- What a verb gave, as an expectation under [label]: it exited 0, and for
-- `expectPrints` printed [expected].
expectSucceeds : String -> Result String (Int, String, String) -> Expectation
expectSucceeds label (Ok (code, _, _)) = labelFail label (expectEqual 0 code)
expectSucceeds _ (Err e) = fail e

expectPrints : String ->
  String ->
  Result String (Int, String, String) ->
  Expectation
expectPrints label expected (Ok (code, out, _)) =
  labelFail label (expectAll [expectEqual 0 code, expectEqual expected out])
expectPrints _ _ (Err e) = fail e

-- The verb refused with exit 1 and its stderr names [needle].
expectRefuses : String ->
  String ->
  Result String (Int, String, String) ->
  Expectation
expectRefuses label needle (Ok (code, _, errOut)) =
  labelFail
    label
    (expectAll [expectEqual 1 code, expectTrue (contains needle errOut)])
expectRefuses _ _ (Err e) = fail e

-- `medaka build` of the fixture [file] into [out].
siblingBuild : String ->
  String ->
  <Exec, IO> Result String (Int, String, String)
siblingBuild file out = runVerb medakaBin [
  "build",
  underRoot "test/sibling_view_fixtures/\{file}",
  "-o",
  out,
]

test "a test sibling's main computes the spec value under check, run and build" = withScratchDir
  (dir =>
    expectAll
      (flatMap
        (c => match c
          (subject, expected) =>
            let file = "\{subject}_test.mdk"
            [
              expectSucceeds "check \{subject}" (siblingVerb "check" file),
              expectPrints "run \{subject}" expected (siblingVerb "run" file),
              expectSucceeds
                "build \{subject}"
                (siblingBuild file "\{dir}/\{subject}"),
              expectPrints
                "native \{subject}"
                expected
                (runVerb "\{dir}/\{subject}" []),
            ])
        siblingCases))

test "a test sibling's rows pass under medaka test eval and native" =
  expectAll
    (map
      (c => match c
        (subject, _) => match runVerb medakaBin [
          "test",
          "--engines",
          "eval,native",
          underRoot "test/sibling_view_fixtures/\{subject}_test.mdk",
        ]
          Ok (code, out, _) =>
            labelFail
              "medaka test \{subject}"
              (expectAll [
                expectEqual 0 code,
                expectTrue (contains "passed" out),
                expectFalse (contains "failed" out),
              ])
          Err e => fail e)
      siblingCases)

-- Each twin names the same private thing from a module that is not the
-- subject's sibling: check, run and build reject it alike.  `other_5` is the
-- one acceptance: an impl is not a name, so importing the type is enough.
-- `xduo_test` is another subject's sibling, and `rename_test` names a renamed
-- import its subject's full view does not carry.
siblingTwins : List (String, String)
siblingTwins = [
  ("other_1", "has no export `step`"),
  ("other_2", "exports no constructors"),
  ("other_3", "has no export `Hidden`"),
  ("other_4", "a `newtype` constructor is always module-private"),
  ("other_6", "has no export `Sized`"),
  ("other_7", "has no export `Beep`"),
  ("other_8", "has no export `last`"),
  ("xduo_test", "has no export `step`"),
  ("rename_test", "has no export `lst`"),
]

test "the non-sibling twin of each case is rejected alike by check, run and build" = withScratchDir
  (dir =>
    expectAll
      (flatMap
        (t => match t
          (stem, needle) =>
            let file = "\{stem}.mdk"
            [
              expectRefuses "check \{stem}" needle (siblingVerb "check" file),
              expectRefuses "run \{stem}" needle (siblingVerb "run" file),
              expectRefuses
                "build \{stem}"
                needle
                (siblingBuild file "\{dir}/\{stem}"),
            ])
        siblingTwins))

test "importing only a type reaches its non-exported impl from any module" =
  match siblingVerb "run" "other_5.mdk"
    Ok (code, out, _) =>
      expectAll [expectEqual 0 code, expectEqual "green\n" out]
    Err e => fail e

shadowProgram : String
shadowProgram =
  "-- > elem 3\n-- 4\n-- > notElem 1 [2, 3]\n-- True\nelem : Int -> Int\nelem x = x + 1\n\nprop \"elem bumps\" (n : Int) = elem n == n + 1\n"

test "a user name shadows core only for user code, under both engines" = withScratchDir
  (dir => match writeFile "\{dir}/shadow.mdk" shadowProgram
    Err e => fail e
    Ok () =>
      expectAll
        (flatMap
          (engine => match runVerb medakaBin [
            "test",
            "--engines",
            engine,
            "\{dir}/shadow.mdk",
          ]
            Ok (code, out, err) => [
              expectEqual 0 code,
              expectTrue (contains "ok   \{dir}/shadow.mdk:1: elem 3" out),
              expectTrue
                (contains "ok   \{dir}/shadow.mdk:3: notElem 1 [2, 3]" out),
              expectFalse (contains "unbound constrained fn" err),
            ]
            Err e => [fail e])
          ["eval", "native"]))
