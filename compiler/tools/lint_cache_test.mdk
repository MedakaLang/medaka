-- compiler/tools/lint_cache_test.mdk: sibling test for lint_cache.mdk and the
-- `--cache` decision in lint_cmd.mdk (`[P-TEST-SIBLING]`, AGENTS.md).
--
-- Pins that a cached finding which read the declaration index is never served
-- against an index it was not made from.  The subject is a probe rule (none is
-- registered) that reports, for every file, the declared signature of `b.f` in
-- the project and of `list.singleton` in a private stdlib, as the index it was
-- handed shows them.  Each scenario runs the real `--cache` entry decision
-- (`cachedEntryOf`) over two project files with isolated cache and stdlib
-- directories, and grades the finding text and the count of files re-linted.
--
-- Scenarios a and c run twice: with the real key, and with a key that omits the
-- index fingerprint (`indexKeyWith`).  The second run must serve a stale
-- finding, which is what shows the fingerprint is the thing doing the work.
--
-- It reaches the filesystem, so it runs native:
-- `medaka test --native compiler/tools/lint_cache_test.mdk`.

import test.{
  Expectation(..),
  expectEqual,
  expectNotEqual,
  expectTrue,
  expectFalse,
  expectEach,
  fail,
}
import test_process.{withScratchDir}
import frontend.ast.{Decl}
import frontend.parser.{Positions}
import driver.diagnostics.{Severity(..)}
import string.{replace}
import support.util.{joinWith, listLen, filterList}
import tools.printer.{ppTy}
import tools.lint_index.{IndexRow, Ns(..), rowSig, rowsIn}
import tools.lint.{
  StdlibIndex,
  Rule,
  Finding(..),
  Category(..),
  Scope(..),
  Ratchet(..),
  Fixability(..),
  Need(..),
  RuleMeta(..),
  lintParseSource,
  lintProgram,
  projectIndexOf,
}
import tools.lint_core.{mkRule, FileFacts, stdlibSigTextIn}
import tools.lint_walk.{indexForRosterIn, indexKeyFor, indexKeyWith}
import tools.lint_cmd.{cachedEntryOf}
import tools.lint_cache.{
  LintEntry(..),
  entryFindings,
  storeEntries,
  cacheDirOf,
  shardPathOf,
}

-- ── the probe ───────────────────────────────────────────────────────────────

probeMeta : String -> List Need -> RuleMeta
probeMeta name needs = RuleMeta {
  name = name,
  summary = "probe",
  doc = "probe",
  category = Suspicious,
  scope = Universal,
  ratchet = Baselined,
  defaultSeverity = SevWarning,
  fixability = NotFixable,
  needs = needs,
}

probeCheck : String ->
  StdlibIndex ->
  String ->
  FileFacts ->
  Positions ->
  List Decl ->
  List Finding
probeCheck name idx _ _ _ _ = [
  Finding {
    rule = name,
    message = probeText idx,
    severity = SevWarning,
    loc = None,
    fix = None,
  },
]

probeText : StdlibIndex -> String
probeText idx =
  "b.f : \{projectSig idx "b" "f"}; list.singleton : \{optionOr "<none>" (stdlibSigTextIn idx "list" "singleton")}"

projectSig : StdlibIndex -> String -> String -> String
projectSig idx modId name =
  match map sigText (rowsIn (projectIndexOf idx) modId NsValue name)
    [] => "<none>"
    sigs => joinWith "," sigs

sigText : IndexRow -> String
sigText r = match rowSig r
  Some t => ppTy t
  None => "<unsigned>"

readerRule : Rule
readerRule =
  mkRule
    (probeMeta "probe-reader" [NeedsProjectIndex])
    (probeCheck "probe-reader")
    None

-- Reads the same index but declares no need for it.
blindRule : Rule
blindRule = mkRule (probeMeta "probe-blind" []) (probeCheck "probe-blind") None

-- ── the harness ─────────────────────────────────────────────────────────────

-- Where one scenario's files live.  `shards` holds the stdlib's row shards, so
-- nothing is shared with the user's cache.
data Env = Env {
  proj : String,
  std : String,
  shards : String,
  cacheDir : String,
}

mkEnv : String -> Env
mkEnv dir = Env {
  proj = "\{dir}/proj",
  std = "\{dir}/std",
  shards = "\{dir}/shards",
  cacheDir = cacheDirOf "\{dir}/proj",
}

stampOf : String
stampOf = "probe-stamp"

aPath : Env -> String
aPath e = "\{e.proj}/a.mdk"

bPath : Env -> String
bPath e = "\{e.proj}/b.mdk"

stdPath : Env -> String
stdPath e = "\{e.std}/list.mdk"

aSource : String
aSource = "import b.{f}\n\ng : Int -> Int\ng x = f x\n"

bSource : String -> String -> String
bSource sig body = "export\nf : \{sig}\nf x = \{body}\n"

stdSource : String -> String -> String
stdSource sig body = "export\nsingleton : \{sig}\nsingleton a = \{body}\n"

setup : Env -> <IO, FileRead, FileWrite, Exec> Unit
setup e =
  let _ = runMkdirs [e.proj, e.std, e.shards]
  let _ = writeFile (aPath e) aSource
  let _ = writeFile (bPath e) (bSource "Int -> Int" "x + 1")
  let _ = writeFile (stdPath e) (stdSource "a -> List a" "[a]")
  ()

runMkdirs : List String -> <IO, FileRead, FileWrite, Exec> Unit
runMkdirs [] = ()
runMkdirs (d :: rest) =
  let _ = makeDir d
  runMkdirs rest

-- One file's result of one run: whether it was linted this run, and what the
-- probe said about it.
data FileRun = FileRun { relinted : Bool, texts : List String }

data Run = Run { fileA : FileRun, fileB : FileRun }

misses : Run -> Int
misses r = listLen (filterList (f => f.relinted) [r.fileA, r.fileB])

-- Build the index from `indexRoster`, then take each file's entry through the
-- `--cache` decision under `roster` and `keyOf`, and write the dirty shards.
runWith : (List Rule -> StdlibIndex -> String) ->
  List Rule ->
  List Rule ->
  Env ->
  <IO, FileRead, FileWrite, Exec> Option Run
runWith keyOf indexRoster roster e = match indexOf indexRoster e
  None => None
  Some idx =>
    let ea = entryFor keyOf roster idx e (aPath e)
    let eb = entryFor keyOf roster idx e (bPath e)
    match (ea, eb)
      (Some xa, Some xb) =>
        let _ = storeEntries e.cacheDir stampOf [xa, xb]
        Some Run { fileA = fileRun xa, fileB = fileRun xb }
      _ => None

entryFor : (List Rule -> StdlibIndex -> String) ->
  List Rule ->
  StdlibIndex ->
  Env ->
  String ->
  <IO, FileRead, FileWrite, Exec> Option LintEntry
entryFor keyOf roster idx e path = match readFile path
  Err _ => None
  Ok src => match cachedEntryOf roster keyOf idx e.cacheDir stampOf path src
    Err _ => None
    Ok entry => Some entry

fileRun : LintEntry -> FileRun
fileRun entry = FileRun {
  relinted = entry.dirty,
  texts = map findingText (entryFindings entry),
}

-- The run production does: the reader probe, the real key.
run : Env -> <IO, FileRead, FileWrite, Exec> Option Run
run e = runWith indexKeyFor [readerRule] [readerRule] e

-- The same run with a key that leaves the index fingerprint out.
runNoFingerprint : Env -> <IO, FileRead, FileWrite, Exec> Option Run
runNoFingerprint e = runWith noFingerprint [readerRule] [readerRule] e

noFingerprint : List Rule -> StdlibIndex -> String
noFingerprint = indexKeyWith (_ => "")

-- The line the reader probe reports, as the index of the CURRENT sources shows.
probeLine : String -> String -> String
probeLine projSig stdSig = "b.f : \{projSig}; list.singleton : \{stdSig}"

-- ── scenarios ───────────────────────────────────────────────────────────────
-- Each takes the run function, so the same assertions grade the real key and
-- the key without the fingerprint.

-- (a) A signature edit in B re-lints A, and A's finding shows the new signature.
scenarioA : (Env -> <IO, FileRead, FileWrite, Exec> Option Run) ->
  String ->
  <IO, FileRead, FileWrite, Exec> Expectation
scenarioA go dir =
  let e = mkEnv dir
  let _ = setup e
  match go e
    None => fail "the populate run did not complete"
    Some cold =>
      let _ = writeFile (bPath e) (bSource "Int -> String" "intToString x")
      match go e
        None => fail "the run after the edit did not complete"
        Some after => expectEach [
          ("cold run lints both files", expectEqual 2 (misses cold)),
          ("the edit re-lints B and A", expectEqual 2 (misses after)),
          (
            "A reports the new signature",
            expectEqual
              [probeLine "Int -> String" "a -> List a"]
              after.fileA.texts,
          ),
        ]

-- (b) A body-only edit in B, with a line inserted above, re-lints B alone and
-- leaves A's finding as it was.
scenarioB : (Env -> <IO, FileRead, FileWrite, Exec> Option Run) ->
  String ->
  <IO, FileRead, FileWrite, Exec> Expectation
scenarioB go dir =
  let e = mkEnv dir
  let _ = setup e
  match go e
    None => fail "the populate run did not complete"
    Some _ =>
      let _ =
        writeFile
          (bPath e)
          ("-- moved down a line\n" ++ bSource "Int -> Int" "x + 2")
      match go e
        None => fail "the run after the edit did not complete"
        Some after => expectEach [
          ("only B is re-linted", expectEqual 1 (misses after)),
          (
            "A is served from the cache",
            expectFalse after.fileA.relinted,
          ),
          (
            "A's finding is unchanged",
            expectEqual [probeLine "Int -> Int" "a -> List a"] after.fileA.texts,
          ),
        ]

-- (c) A signature edit in a stdlib file re-lints A, and A's finding shows it.
scenarioC : (Env -> <IO, FileRead, FileWrite, Exec> Option Run) ->
  String ->
  <IO, FileRead, FileWrite, Exec> Expectation
scenarioC go dir =
  let e = mkEnv dir
  let _ = setup e
  match go e
    None => fail "the populate run did not complete"
    Some _ =>
      let _ = writeFile (stdPath e) (stdSource "a -> List (List a)" "[[a]]")
      match go e
        None => fail "the run after the edit did not complete"
        Some after => expectEach [
          ("both files are re-linted", expectEqual 2 (misses after)),
          (
            "A reports the new stdlib signature",
            expectEqual
              [probeLine "Int -> Int" "a -> List (List a)"]
              after.fileA.texts,
          ),
        ]

-- (c') A body-only edit in a stdlib file invalidates nothing.
scenarioC2 : (Env -> <IO, FileRead, FileWrite, Exec> Option Run) ->
  String ->
  <IO, FileRead, FileWrite, Exec> Expectation
scenarioC2 go dir =
  let e = mkEnv dir
  let _ = setup e
  match go e
    None => fail "the populate run did not complete"
    Some _ =>
      let _ = writeFile (stdPath e) (stdSource "a -> List a" "a :: []")
      match go e
        None => fail "the run after the edit did not complete"
        Some after => expectEach [
          ("nothing is re-linted", expectEqual 0 (misses after)),
          (
            "A's finding is unchanged",
            expectEqual [probeLine "Int -> Int" "a -> List a"] after.fileA.texts,
          ),
        ]

isFail : Expectation -> Bool
isFail (Fail _ _ _) = True
isFail (Pass _ _) = False

test "(a) a signature edit in B re-lints A and A shows the new signature" =
  withScratchDir (scenarioA run)

test "(a) without the fingerprint A is served stale, so the scenario goes red" =
  withScratchDir (dir => expectTrue (isFail (scenarioA runNoFingerprint dir)))

test "(b) a body-only edit in B re-lints B alone and A keeps its finding" =
  withScratchDir (scenarioB run)

test "(b) holds without the fingerprint too: it is not what keeps A warm" =
  withScratchDir (scenarioB runNoFingerprint)

test "(c) a stdlib signature edit re-lints A and A shows the new signature" =
  withScratchDir (scenarioC run)

test "(c) without the fingerprint A is served stale, so the scenario goes red" =
  withScratchDir (dir => expectTrue (isFail (scenarioC runNoFingerprint dir)))

test "(c') a stdlib body-only edit invalidates nothing" =
  withScratchDir (scenarioC2 run)

-- ── (d) a rule that declared no need ────────────────────────────────────────

-- The index is built for the reader, but the cache runs the blind rule alone.
runBlind : Env -> <IO, FileRead, FileWrite, Exec> Option Run
runBlind e = runWith indexKeyFor [readerRule, blindRule] [blindRule] e

test "(d) a rule that declared no need keeps its stamp across a signature edit" =
  withScratchDir blindStampCase

blindStampCase : String -> <IO, FileRead, FileWrite, Exec> Expectation
blindStampCase dir =
  let e = mkEnv dir
  let _ = setup e
  match indexOf [readerRule] e
    None => fail "the index did not build"
    Some before =>
      let _ = writeFile (bPath e) (bSource "Int -> String" "intToString x")
      match indexOf [readerRule] e
        None => fail "the index did not rebuild"
        Some after => expectEach [
          (
            "control: a declaring roster's key moves with the edit",
            expectNotEqual
              (indexKeyFor [readerRule] before)
              (indexKeyFor [readerRule] after),
          ),
          (
            "the blind roster's key is the same before and after",
            expectEqual
              (indexKeyFor [blindRule] before)
              (indexKeyFor [blindRule] after),
          ),
        ]

indexOf : List Rule -> Env -> <IO, FileRead, FileWrite, Exec> Option StdlibIndex
indexOf roster e =
  let built =
    indexForRosterIn e.std e.shards roster e.proj True [] [] [aPath e, bPath e]
  match built
    Err _ => None
    Ok idx => Some idx

test "(d) a signature edit re-lints only B for the blind rule, and A stays warm" =
  withScratchDir blindRunCase

blindRunCase : String -> <IO, FileRead, FileWrite, Exec> Expectation
blindRunCase dir =
  let e = mkEnv dir
  let _ = setup e
  match runBlind e
    None => fail "the populate run did not complete"
    Some _ =>
      let _ = writeFile (bPath e) (bSource "Int -> String" "intToString x")
      match runBlind e
        None => fail "the run after the edit did not complete"
        Some after => expectEqual 1 (misses after)

test "(d) a rule that reads the index undeclared sees it empty on every run" =
  withScratchDir blindSeesNothingCase

blindSeesNothingCase : String -> <IO, FileRead, FileWrite, Exec> Expectation
blindSeesNothingCase dir =
  let e = mkEnv dir
  let _ = setup e
  let blank = probeLine "<none>" "<none>"
  match indexOf [readerRule] e
    None => fail "the index did not build"
    Some idx =>
      let coldRun = runBlind e
      let warmRun = runBlind e
      match (coldRun, warmRun)
        (Some cold, Some warm) =>
          let _ = writeFile (bPath e) (bSource "Int -> String" "intToString x")
          match runBlind e
            None => fail "the run after the edit did not complete"
            Some edited => expectEach [
              (
                "control: the reader sees the real signature",
                expectEqual
                  [probeLine "Int -> Int" "a -> List a"]
                  (messagesOf readerRule idx),
              ),
              (
                "uncached, through the full index",
                expectEqual [blank] (messagesOf blindRule idx),
              ),
              ("--cache, cold", expectEqual [blank] cold.fileA.texts),
              ("--cache, warm", expectEqual [blank] warm.fileA.texts),
              (
                "--cache, after the signature edit",
                expectEqual [blank] edited.fileA.texts,
              ),
            ]
        _ => fail "a run did not complete"

messagesOf : Rule -> StdlibIndex -> List String
messagesOf rule idx = match lintParseSource aSource
  Err _ => ["<parse error>"]
  Ok (decls, pos) =>
    map findingText (lintProgram idx [rule] "a.mdk" aSource pos decls)

-- ── fail closed ─────────────────────────────────────────────────────────────

-- Populate, damage A's shard with `damage`, run again.  A must be re-linted and
-- its finding must be the true one.
damagedCase : (String -> String) ->
  String ->
  <IO, FileRead, FileWrite, Exec> Expectation
damagedCase damage dir =
  let e = mkEnv dir
  let _ = setup e
  match run e
    None => fail "the populate run did not complete"
    Some _ =>
      let shard = shardPathOf e.cacheDir (aPath e)
      match readFile shard
        Err _ => fail "A has no shard after the populate run"
        Ok text =>
          let _ = writeFile shard (damage text)
          match run e
            None => fail "the run over the damaged shard did not complete"
            Some after => expectEach [
              ("A is re-linted", expectTrue after.fileA.relinted),
              ("B is not", expectFalse after.fileB.relinted),
              (
                "A's finding is the true one",
                expectEqual
                  [probeLine "Int -> Int" "a -> List a"]
                  after.fileA.texts,
              ),
            ]

test "a corrupt row shard is a miss" =
  withScratchDir (damagedCase (_ => "(3 \"x\""))

test "a shard of another format version is a miss" =
  withScratchDir (damagedCase (replace "(3 " "(2 "))

test "a shard under a forged stamp is a miss" =
  withScratchDir (damagedCase (replace stampOf "forged-stamp"))

test "the second run over an unchanged tree re-lints nothing" =
  withScratchDir secondRunCase

secondRunCase : String -> <IO, FileRead, FileWrite, Exec> Expectation
secondRunCase dir =
  let e = mkEnv dir
  let _ = setup e
  let firstRun = run e
  let secondRun = run e
  match (firstRun, secondRun)
    (Some first, Some second) => expectEach [
      ("the first run lints both", expectEqual 2 (misses first)),
      ("the second run lints none", expectEqual 0 (misses second)),
      ("and says the same", expectEqual first.fileA.texts second.fileA.texts),
    ]
    _ => fail "a run did not complete"

-- A cache directory that cannot be created (its parent is a regular file) must
-- leave the run's findings correct.
test "a cache that cannot be written leaves the findings correct" =
  withScratchDir unwritableCase

unwritableCase : String -> <IO, FileRead, FileWrite, Exec> Expectation
unwritableCase dir =
  let e0 = mkEnv dir
  let e = Env {
    proj = e0.proj,
    std = e0.std,
    shards = e0.shards,
    cacheDir = "\{dir}/blocked/lint-cache",
  }
  let _ = setup e
  let _ = writeFile "\{dir}/blocked" "a file, not a directory"
  let firstRun = run e
  let secondRun = run e
  match (firstRun, secondRun)
    (Some first, Some second) => expectEach [
      (
        "the finding is correct",
        expectEqual [probeLine "Int -> Int" "a -> List a"] first.fileA.texts,
      ),
      (
        "nothing was stored, so the next run lints again",
        expectEqual 2 (misses second),
      ),
      ("and is correct again", expectEqual first.fileA.texts second.fileA.texts),
    ]
    _ => fail "a run did not complete"

findingText : Finding -> String
findingText f = f.message
