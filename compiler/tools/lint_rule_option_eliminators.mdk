-- lint rule rule-option-eliminators: an Option/Result eliminator written as a 2-arm `match` that a prelude function names. Prefer `optionOr`, `optionOrPanic`, `isSome`, `isNone`, `resultOr`.

import frontend.ast.{
  Arm(..),
  Decl(..),
  Expr(..),
  Loc(..),
  Pat(..),
}
import frontend.parser.{Positions(..)}
import driver.diagnostics.{Severity(..)}
import support.util.{isEmptyL}
import tools.printer.{exprToString}
import tools.lint_core.{
  Applicability(..),
  Category(..),
  Ctx(..),
  FileFacts(..),
  Finding(..),
  Fix,
  Fixability(..),
  Need(..),
  Ratchet(..),
  Rule,
  RuleMeta(..),
  Scope(..),
  StdlibIndex,
  Visitor,
  mkVisitorRule,
}
import tools.lint_shared.{
  bindingOf,
  calledName,
  exprRuleEditVisitors,
  isEVarNamed,
  isNilPCon,
  matchSpan,
  noExcl,
  rebinds,
  replaceFix,
  ruleNameOptionEliminators,
  unwrapLoc,
  usesPreludeName,
}

export
rule : Rule
rule =
  mkVisitorRule
    RuleMeta {
      name = ruleNameOptionEliminators,
      summary =
        "2-arm `match` on an Option/Result that unwraps with an atomic default, panics with a message, or answers whether it is `Some`. The prelude names these: `optionOr`, `optionOrPanic`, `isSome`, `isNone`, `resultOr`",
      doc =
        "A two-arm `match` that returns the payload of `Some`/`Ok` and otherwise a literal, a variable or a nullary constructor is `optionOr`/`resultOr`; one that otherwise panics with a message is `optionOrPanic`; one that only answers `True`/`False` is `isSome`/`isNone`. A default that is a call is left alone: the function form evaluates it eagerly.\n\nBefore:\n  match o\n    Some x => x\n    None => 0\nAfter:\n  optionOr 0 o",
      category = Style,
      scope = Universal,
      ratchet = Gated,
      defaultSeverity = SevWarning,
      fixability = Fixable,
      needs = [NeedsScopes, NeedsWildIndex],
    }
    ruleOptionEliminators
    None

-- A default the function form can take in place of the arm without changing
-- when it is evaluated or whether it is: a literal, a variable or a nullary
-- constructor.  A call is excluded, because `optionOr d o` evaluates `d` even
-- when `o` is `Some`.
atomic : Expr -> Bool
atomic e = match unwrapLoc e
  ELit _ => True
  ENumLit _ _ _ => True
  EVar _ => True
  _ => False

isBoolLit : Bool -> Expr -> Bool
isBoolLit b e = match unwrapLoc e
  EVar n => n == (if b then "True" else "False")
  _ => False

call1 : String -> Expr -> Expr -> Expr
call1 fn arg scrut = EApp (EApp (EVar fn) arg) scrut

-- `Some x => x` / `Ok x => x`: the success arm hands its payload back.
isIdentityArm : String -> Pat -> Expr -> Bool
isIdentityArm ctor (PCon c [PVar x _ _]) body = c == ctor && isEVarNamed x body
isIdentityArm _ _ _ = False

-- `panic m` with an atomic message.
panicMessage : Expr -> Option Expr
panicMessage body = match unwrapLoc body
  EApp hd m => if isEVarNamed "panic" hd && atomic m then Some m else None
  _ => None

-- (success arm, failure arm) in this order.
elimPair : Expr -> Arm -> Arm -> Option Expr
elimPair scrut (Arm ps gs bs) (Arm pf gf bf)
  | not (isEmptyL gs && isEmptyL gf) = None
  | isIdentityArm "Some" ps bs && isNilPCon "None" pf =
    if atomic bf then
      Some (call1 "optionOr" bf scrut)
    else
      map (m => call1 "optionOrPanic" m scrut) (panicMessage bf)
  | isIdentityArm "Ok" ps bs && isErrWild pf && atomic bf =
    Some (call1 "resultOr" bf scrut)
  | isSomeWild ps
    && isNilPCon "None" pf
    && isBoolLit True bs
    && isBoolLit False bf = Some (EApp (EVar "isSome") scrut)
  | isSomeWild ps
    && isNilPCon "None" pf
    && isBoolLit False bs
    && isBoolLit True bf = Some (EApp (EVar "isNone") scrut)
  | otherwise = None

isSomeWild : Pat -> Bool
isSomeWild (PCon "Some" [PWild]) = True
isSomeWild _ = False

isErrWild : Pat -> Bool
isErrWild (PCon "Err" [PWild]) = True
isErrWild _ = False

-- detector (matches the RAW `EMatch`, never its `ELoc` wrapper); either arm order.
optionElimOf : Expr -> Option Expr
optionElimOf (EMatch scrut arms) = match arms
  [a1, a2] => orElse (elimPair scrut a1 a2) (elimPair scrut a2 a1)
  _ => None
optionElimOf _ = None

ruleOptionEliminators : StdlibIndex ->
  String ->
  FileFacts ->
  Positions ->
  List Decl ->
  List Visitor
ruleOptionEliminators idx _ facts _ _ =
  exprRuleEditVisitors
    noExcl
    optionElimOf
    (optionElimEdit idx facts)
    optionElimFinding

optionElimFinding : Option Loc -> Expr -> Option Fix -> Finding
optionElimFinding loc rewritten fix = Finding {
  rule = ruleNameOptionEliminators,
  message =
    "this match is a prelude eliminator — rewrite as '"
      ++ exprToString rewritten
      ++ "'",
  severity = SevWarning,
  loc = loc,
  fix = fix,
}

-- The `panic` the `optionOrPanic` shape reads, when the arm is one.
panicHead : Expr -> Option Expr
panicHead (EMatch _ arms) = firstJust panicArmHead arms
panicHead _ = None

panicArmHead : Arm -> Option Expr
panicArmHead (Arm _ _ body) = match unwrapLoc body
  EApp hd _ => if isEVarNamed "panic" hd then Some hd else None
  _ => None

firstJust : (a -> Option b) -> List a -> Option b
firstJust _ [] = None
firstJust f (x :: rest) = orElse (f x) (firstJust f rest)

-- The fix replaces the whole `match` with the call.  Every shape is `Safe`: the
-- scrutinee text moves unduplicated, the arms are exactly the eliminator, and the
-- default is atomic.  The fix is withheld where the file binds the name the
-- rewrite writes, or binds the `panic` the match calls, since either would change
-- what the text means.
optionElimEdit : StdlibIndex -> FileFacts -> Ctx -> Expr -> Expr -> Option Fix
optionElimEdit idx facts ctx e rewritten =
  if rebinds idx facts ctx (calledName rewritten)
    || panicRebound idx facts e then
    None
  else
    replaceFix
      Safe
      "use the prelude eliminator"
      (matchSpan facts ctx e)
      (bindingOf rewritten)
      ctx
      (exprToString rewritten)

panicRebound : StdlibIndex -> FileFacts -> Expr -> Bool
panicRebound idx facts e = match panicHead e
  Some hd => not (usesPreludeName idx facts hd)
  None => False
