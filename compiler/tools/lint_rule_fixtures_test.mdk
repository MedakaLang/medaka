test "rule-fuse-list-pipeline fixture" = fixtureHolds "fuse-list-pipeline"

test "rule-hand-rolled-derivable fixture" = fixtureHolds "hand-rolled-derivable"

test "rule-if-max-min fixture" = fixtureHolds "if-max-min"

test "rule-lambda-section fixture" = fixtureHolds "lambda-section"

test "rule-match-on-param fixture" = fixtureHolds "match-on-param"

test "rule-match-to-map fixture" = fixtureHolds "match-to-map"

test "rule-missing-signature fixture" = fixtureHolds "missing-signature"

test "rule-not-eq fixture" = fixtureHolds "not-eq"

test "rule-option-eliminators fixture" = fixtureHolds "option-eliminators"

test "rule-orelse-staircase fixture" = fixtureHolds "orelse-staircase"

test "rule-prefer-assign-op fixture" = fixtureHolds "prefer-assign-op"

test "rule-prelude-shadow fixture" = fixtureHolds "prelude-shadow"

test "rule-promissory-reader fixture" = fixtureHolds "promissory-reader"

test "rule-regex-literal fixture" = fixtureHolds "regex-literal"

test "rule-rem-parity fixture" = fixtureHolds "rem-parity"

test "rule-self-shadow-extern fixture" = fixtureHolds "self-shadow-extern"

test "rule-stdlib-reimpl fixture" = fixtureHolds "stdlib-reimpl"

test "rule-test-bool-literal-equal fixture" =
  fixtureHolds "test-bool-literal-equal"

test "rule-test-equal-in-true fixture" = fixtureHolds "test-equal-in-true"

test "rule-unused-import fixture" = fixtureHolds "unused-import"

test "rule-unused-local fixture" = fixtureHolds "unused-local"

test "rule-unused-param fixture" = fixtureHolds "unused-param"

test "rule-when-unless fixture" = fixtureHolds "when-unless"

-- The same declarations still fire under a `_test.mdk` path.
test "rule-prelude-shadow fires under a test path" =
  match readOr "\{fixtureDir}/prelude-shadow.mdk"
    Err e => fail e
    Ok src =>
      match (lintLinesAt
        emptyStdlibIndex
        "fixture_test.mdk"
        "rule-prelude-shadow"
        src)
        Err e => fail e
        Ok flagged => expectEqual 3 (length flagged)

preludeShadowAt : String -> String -> Result String (List Int)
preludeShadowAt path src =
  lintLinesAt emptyStdlibIndex path "rule-prelude-shadow" src

-- The exemption follows the declarations, not the file name: the module that
-- declares `Option` owns `isSome`, and a file called `core.mdk` that does not
-- is shadowing it.
test "rule-prelude-shadow exempts the module that declares the type" =
  let owner = "data Option a = Some a | None\n\nisSome o = True\n"
  let user = "isSome o = True\n"
  expectAll [
    labelFail
      "owner under any path"
      (expectEqual (Ok []) (preludeShadowAt "core.mdk" owner)),
    labelFail
      "owner under a stdlib path"
      (expectEqual (Ok []) (preludeShadowAt "stdlib/core.mdk" owner)),
    labelFail
      "a core.mdk in a stdlib directory that declares no Option"
      (expectEqual (Ok [1]) (preludeShadowAt "stdlib/core.mdk" user)),
    labelFail
      "a core.mdk in a mystdlib directory"
      (expectEqual (Ok [1]) (preludeShadowAt "mystdlib/core.mdk" user)),
    labelFail
      "Option does not own isOk"
      (expectEqual
        (Ok [4])
        (preludeShadowAt "core.mdk" (owner ++ "isOk r = True\n"))),
  ]

test "every fixture file is on the roster" = rosterIsClosed

markedRule : Marker -> String
markedRule m = m.rule

-- A rule whose rewrite can change meaning or fail to compile on types lint
-- cannot see is `Unsafe`: plain `--fix` leaves the source, `--unsafe-fixes`
-- applies it.  An `I64` operand is not `isEven`'s `Int`, and `isNonEmptyL` is
-- only in scope with its own import.
unsafeCases : List (String, String, String)
unsafeCases = [
  (
    "rule-rem-parity",
    "import i64.{I64}\n\nev : I64 -> Bool\nev n = n % 2 == 0\n",
    "import i64.{I64}\n\nev : I64 -> Bool\nev n = isEven n\n",
  ),
  (
    "rule-complement-predicate",
    "f xs = not (isEmptyL xs)\n",
    "f xs = isNonEmptyL xs\n",
  ),
  (
    "rule-if-max-min",
    "pickGt a b = if a > b then a else b\n",
    "pickGt a b = max a b\n",
  ),
  (
    "rule-fuse-list-pipeline",
    "none p xs = isEmpty (filter p xs)\n",
    "none p xs = not (any p xs)\n",
  ),
  (
    "rule-fuse-list-pipeline",
    "nil xs = xs == []\n",
    "nil xs = isEmpty xs\n",
  ),
  (
    "rule-eager-default",
    "pick k xs = optionOr (fresh k) (lookup k xs)\n",
    "pick k xs = optionOrElse (_ => fresh k) (lookup k xs)\n",
  ),
  (
    "rule-option-eliminators",
    "get o = match o\n  Some x => x\n  None => panic \"no value\"\n",
    "get o = optionOrPanic \"no value\" o\n",
  ),
  (
    "rule-eager-default",
    "settle r = resultOr (fresh 1) r\n",
    "settle r = resultOrElse (_ => fresh 1) r\n",
  ),
]

test "an unsafe rule is left alone by --fix and applied by --unsafe-fixes" =
  expectAll (map unsafeCase unsafeCases)

unsafeCase : (String, String, String) -> <IO> Expectation
unsafeCase (rule, src, fixed) = labelFail rule (match indexForRules [rule]
  Err e => fail e
  Ok idx => expectAll [
    labelFail
      "plain --fix"
      (expectEqual
        (Ok (Settled src 0))
        (fixSource idx Safe [rule] [] [] "ev.mdk" src)),
    labelFail
      "--unsafe-fixes"
      (expectEqual
        (Ok (Settled fixed 1))
        (fixSource idx Unsafe [rule] [] [] "ev.mdk" src)),
  ])

-- The point of the rule-eager-default rewrite, run rather than read: the
-- default of `optionOr` is evaluated although the option holds a value, and the
-- default of `optionOrElse` is evaluated only on a miss.
bump : Ref Int -> Int
bump counter =
  counter := !counter + 1
  42

-- The eager form is the subject of the contrast, so the rule's finding is wanted here.
-- lint-disable-next-line rule-eager-default
test "rule-eager-default: the lazy form runs its default on a miss only" =
  let eagerHit = Ref 0
  let lazyHit = Ref 0
  let lazyMiss = Ref 0
  let eager = optionOr (bump eagerHit) (Some 7)
  let lazyOnHit = optionOrElse (_ => bump lazyHit) (Some 7)
  let lazyOnMiss = optionOrElse (_ => bump lazyMiss) None
  expectAll [
    labelFail "eager form, hit: value" (expectEqual 7 eager),
    labelFail "eager form, hit: default ran" (expectEqual 1 !eagerHit),
    labelFail "lazy form, hit: value" (expectEqual 7 lazyOnHit),
    labelFail "lazy form, hit: default did not run" (expectEqual 0 !lazyHit),
    labelFail "lazy form, miss: value" (expectEqual 42 lazyOnMiss),
    labelFail "lazy form, miss: default ran once" (expectEqual 1 !lazyMiss),
  ]

test "rule-eager-default: resultOrElse runs its default on an Err only" =
  let onOk = Ref 0
  let onErr = Ref 0
  let ok = resultOrElse (_ => bump onOk) (Ok 7 : Result String Int)
  let bad = resultOrElse (_ => bump onErr) (Err "no" : Result String Int)
  expectAll [
    labelFail "Ok: value" (expectEqual 7 ok),
    labelFail "Ok: default did not run" (expectEqual 0 !onOk),
    labelFail "Err: value" (expectEqual 42 bad),
    labelFail "Err: default ran once" (expectEqual 1 !onErr),
  ]
