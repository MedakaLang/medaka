import frontend.lexer.{
  Token(..), tokenToString, describeToken, tokenize, tokenizeWithOffsets,
  tokenizeWithOffsetPairs
}
import test.{Expectation, expectTrue, expectEqual, expectAll, expectEach}
import list.{zip, filterMap, take, drop}
import frontend.parse_diagnostic.{ParseDiagnosticKind(..), UnicodeProblem(..)}

literalText : Token -> String
literalText (TInterpOpen s) = s
literalText (TInterpMid s) = s
literalText (TInterpEnd s) = s
literalText (TString s) = s
literalText _ = ""

test "ordinary interpolated control character and spans" =
  let (tokens, spans) = tokenizeWithOffsetPairs "\"\\u{1}\\{1}\""
  expectAll [
    expectEqual ["\u{01}", "", "", "", ""] (map literalText tokens),
    expectEqual [(6, 8), (8, 9), (10, 11), (0, 0), (0, 0)] spans,
  ]

test "triple interpolation dedents together" =
  let (tokens, spans) =
    tokenizeWithOffsetPairs "\"\"\"\n  a \\{1}\n  b\n  \"\"\""
  expectAll [
    expectEqual ["a ", "", "\nb\n", "", ""] (map literalText tokens),
    expectEqual [(8, 10), (10, 11), (19, 22), (0, 0), (0, 0)] spans,
  ]

test "ordinary string and span" =
  let (tokens, spans) = tokenizeWithOffsetPairs "\"hello\""
  expectAll [
    expectEqual ["hello", "", ""] (map literalText tokens),
    expectEqual [(0, 7), (0, 0), (0, 0)] spans,
  ]

projectionRow : String -> List String -> List (Int, Int) -> Expectation
projectionRow src contents spans =
  let plain = tokenize src
  let (offsetTokens, offsets) = tokenizeWithOffsets src
  let (pairTokens, pairs) = tokenizeWithOffsetPairs src
  expectAll [
    expectEqual contents (map literalText plain),
    expectEqual (map tokenToString plain) (map tokenToString offsetTokens),
    expectEqual (map tokenToString plain) (map tokenToString pairTokens),
    expectEqual (map fst spans) offsets,
    expectEqual spans pairs,
  ]

controlRow : (String, Int) -> (String, Expectation)
controlRow (hex, n) = (
  "U+" ++ hex,
  projectionRow
    ("\"\\u{" ++ hex ++ "}\"")
    [charToStr (optionOr ' ' (charFromCode n)), "", ""]
    [(0, 8), (0, 0), (0, 0)],
)

