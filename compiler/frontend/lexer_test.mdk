test "interpolation preserves control positions and projections" = expectEach [
  (
    "open",
    projectionRow
      "\"\\u{01}x\\{1}y\""
      ["\u{01}x", "", "y", "", ""]
      [(8, 10), (10, 11), (13, 14), (0, 0), (0, 0)],
  ),
  (
    "end",
    projectionRow
      "\"x\\{1}\\u{01}y\""
      ["x", "", "\u{01}y", "", ""]
      [(2, 4), (4, 5), (13, 14), (0, 0), (0, 0)],
  ),
]

test "triple and middle segment projection controls" = expectEach [
  (
    "middle",
    projectionRow
      "\"x\\{1}\\u{01}y\\{2}z\""
      ["x", "", "\u{01}y", "", "z", "", ""]
      [(2, 4), (4, 5), (13, 15), (15, 16), (18, 19), (0, 0), (0, 0)],
  ),
  (
    "triple plain",
    projectionRow
      "\"\"\"\\u{01}x\"\"\""
      ["\u{01}x", "", ""]
      [(0, 13), (0, 0), (0, 0)],
  ),
  (
    "triple open",
    projectionRow
      "\"\"\"\\u{01}x\\{1}y\"\"\""
      ["\u{01}x", "", "y", "", ""]
      [(10, 12), (12, 13), (15, 18), (0, 0), (0, 0)],
  ),
  (
    "dedent",
    projectionRow
      "\"\"\"\n  a \\{1}\n  b\n  \"\"\""
      ["a ", "", "\nb\n", "", ""]
      [(8, 10), (10, 11), (19, 22), (0, 0), (0, 0)],
  ),
]

unicodeFailureRow : String -> UnicodeProblem -> (Int, Int) -> Expectation
unicodeFailureRow source problem span =
  let (tokens, spans) = tokenizeWithOffsetPairs source
  let errors =
    filterMap
      ((token, offsets) => match token
        TLexError _ => Some (tokenToString token, offsets)
        _ => None)
      (zip tokens spans)
  expectEqual
    [(tokenToString (TLexError (BadUnicodeEscape problem)), span)]
    errors

test "Unicode failure kinds and exact spans agree across scanner continuations" =
  expectEach
    (flatMap
      ((label, prefix, suffix) =>
        let start = stringLength prefix
        map
            ((spelling, problem) => (
              label ++ spelling,
              unicodeFailureRow (prefix ++ spelling ++ suffix) problem (
                start,
                start + stringLength spelling,
              ),
            ))
            [
              ("\\u{}", UnicodeEmpty),
              ("\\u{4_1}", UnicodeSeparator),
              ("\\u{z}", UnicodeExpectedDigit "z"),
              ("\\u{41z}", UnicodeExpectedClose "z"),
              ("\\u{D800}", UnicodeSurrogate "\\u{D800}"),
              ("\\u{110000}", UnicodeOutOfRange "\\u{110000}"),
            ]
          ++ [
            (
              label ++ "unterminated",
              unicodeFailureRow (prefix ++ "\\u{41") UnicodeUnterminated (
                start,
                start + 5,
              ),
            ),
          ])
      [
        ("string", "\"😀", "\""),
        ("triple", "\"\"\"😀", "\"\"\""),
        ("interpolation", "\"a\\{1}😀", "\""),
        ("triple interpolation", "\"\"\"a\\{1}😀", "\"\"\""),
        ("character", "'", "'"),
      ])

test "token descriptions and constructors" = expectEach [
  (
    "identifier",
    expectEqual
      ("IDENT \"hello\"", "`hello`")
      (tokenToString (TIdent "hello"), describeToken (TIdent "hello")),
  ),
  (
    "eof",
    expectEqual ("EOF", "end of input") (tokenToString TEof, describeToken TEof),
  ),
]

test "unterminated string continuations produce terminal errors" =
  expectEach
    (map
      ((label, source) =>
        let (tokens, spans) = tokenizeWithOffsetPairs source
        let errors =
          filterMap
            ((token, span) => match token
              TLexError UnterminatedString => Some span
              _ => None)
            (zip tokens spans)
        (
          label,
          expectEqual [(stringLength source, stringLength source)] errors,
        ))
      [
        ("plain", "\"oops"),
        ("triple", "\"\"\"oops"),
        ("interpolation", "\"a\\{1}tail"),
        ("triple interpolation", "\"\"\"a\\{1}tail"),
        ("escaped quote tail", "\"\"\"a\\\"\"\""),
      ])

nestedRow : (String, String, (Int, Int)) -> (String, Expectation)
nestedRow (label, source, expected) =
  let (tokens, spans) = tokenizeWithOffsetPairs source
  let errors =
    filterMap
      ((token, span) => match token
        TLexError NestedInterpolation => Some span
        _ => None)
      (zip tokens spans)
  (label, expectEqual [expected] errors)

test "nested interpolation rejects the inner opener" =
  expectEach
    (map nestedRow [
      ("plain in plain", "\"a\\{\"b\\{1}\"}\"", (6, 8)),
      ("triple in plain", "\"a\\{\"\"\"b\\{1}\"\"\"}\"", (8, 10)),
      ("plain in triple", "\"\"\"a\\{\"b\\{1}\"}\"\"\"", (8, 10)),
      ("triple in triple", "\"\"\"a\\{\"\"\"b\\{1}\"\"\"}\"\"\"", (10, 12)),
    ])

test "scanner invocations and EOF tails remain independent" =
  let first = tokenizeWithOffsetPairs "a"
  let empty = tokenizeWithOffsetPairs ""
  let whitespace =
    tokenizeWithOffsetPairs (stringFromChars (arrayMake 100000 ' '))
  let comment = tokenizeWithOffsetPairs "-- tail"
  let bad = tokenizeWithOffsetPairs "\"unfinished"
  let second = tokenizeWithOffsetPairs "a"
  let blankExpected = (["NEWLINE", "EOF"], [(0, 0), (0, 0)])
  let shape = (tokens, spans) => (map tokenToString tokens, spans)
  expectAll [
    expectEqual blankExpected (shape empty),
    expectEqual blankExpected (shape whitespace),
    expectEqual blankExpected (shape comment),
    expectEqual (shape first) (shape second),
    expectEqual
      [(11, 11)]
      (filterMap
        ((t, span) => match t
          TLexError UnterminatedString => Some span
          _ => None)
        (zip (fst bad) (snd bad))),
  ]

tokensOf : String -> List String
tokensOf src = map tokenToString (tokenize src)

test "byte literal is one token; neighbours are unchanged" = expectAll [
  expectEqual
    ["IDENT \"x\"", "EQUAL", "BYTE 97"]
    (take 3 (tokensOf "x = b'a'")),
  expectEqual ["BYTE 255"] (take 1 (drop 2 (tokensOf "x = b'\\xFF'"))),
  expectEqual ["IDENT \"b\"", "CHAR \"a\""] (take 2 (tokensOf "b 'a'")),
  expectEqual ["IDENT \"b'\""] (take 1 (tokensOf "b'")),
  expectEqual ["IDENT \"b'x\""] (take 1 (tokensOf "b'x")),
  expectEqual ["IDENT \"fib'\""] (take 1 (tokensOf "fib'")),
]

errOf : Token -> Option String
errOf (TLexError (ByteLikeIdent old new)) = Some "ident:\{old}:\{new}"
errOf (TLexError (NonAsciiByte _ _)) = Some "non-ascii"
errOf (TLexError (BadByteLiteral _)) = Some "bad"
errOf _ = None

lexErrorKind : String -> String
lexErrorKind src = match filterMap errOf (tokenize src)
  k :: _ => k
  [] => "none"

test "identifier spelled as a byte literal is an error" = expectAll [
  expectEqual "ident:b'a':b_a" (lexErrorKind "main = let b'a' = 3 in 1"),
  expectEqual "ident:b'a':b_a" (lexErrorKind "b'a' = 3"),
  expectEqual "ident:b'a':b_a" (lexErrorKind "x = b'a'z"),
  expectEqual "non-ascii" (lexErrorKind "x = b'é'"),
  expectEqual "none" (lexErrorKind "x = b''"),
  expectEqual "bad" (lexErrorKind "x = b'\\x100'"),
  expectEqual "none" (lexErrorKind "x = b'a'"),
]

-- Boundary table: what a `b'` token start becomes.
test "primed b names stay identifiers unless a literal is closed" = expectAll [
  expectEqual
    ["IDENT \"b'\"", "COMMA", "IDENT \"b'\""]
    (take 3 (tokensOf "b',b'")),
  expectEqual
    ["IDENT \"b'\"", "PLUS", "IDENT \"b'\""]
    (take 3 (tokensOf "b'+b'")),
  expectEqual ["IDENT \"b''\""] (take 1 (tokensOf "b''")),
  expectEqual ["IDENT \"b'ab'\""] (take 1 (tokensOf "b'ab'")),
  expectEqual ["IDENT \"b'\""] (take 1 (tokensOf "b'")),
  expectEqual ["IDENT \"b'\"", "IDENT \"x\""] (take 2 (tokensOf "b' x")),
  expectEqual ["BYTE 97"] (take 1 (drop 2 (tokensOf "x = b'a'"))),
  expectEqual ["BYTE 32"] (take 1 (drop 2 (tokensOf "x = b' '"))),
  expectEqual "none" (lexErrorKind "swap (a',b') = (b',a')"),
  expectEqual "none" (lexErrorKind "x = [b',b']"),
  expectEqual "none" (lexErrorKind "x = \"\\{b'}x\\{b'}\""),
  expectEqual "none" (lexErrorKind "let b'' = 5"),
  expectEqual "none" (lexErrorKind "f b' = b'*b'"),
  expectEqual "bad" (lexErrorKind "x = b'\\"),
  expectEqual "bad" (lexErrorKind "x = b'\\x41"),
  expectEqual "bad" (lexErrorKind "x = b'\\q'"),
  expectEqual "bad" (lexErrorKind "x = b'é'"),
  expectEqual "non-ascii" (lexErrorKind "x = b'\\u{E9}'"),
]

test "shebang first line is skipped and later offsets keep their real positions" =
  let shebang = "#!/usr/bin/env -S medaka run\n"
  let body = "main = 1\n"
  expectAll [
    expectEqual
      (map tokenToString (tokenize body))
      (drop 1 (map tokenToString (tokenize (shebang ++ body)))),
    expectEqual
      [29, 34, 36]
      (take 3 (drop 1 (snd (tokenizeWithOffsets (shebang ++ body))))),
  ]

test "shebang elsewhere than offset 0 stays a lex error" =
  let hasErr src = any isLexError (tokenize src)
  expectAll [
    expectTrue (hasErr "main = 1\n#!/bin/x\n"),
    expectTrue (hasErr "\n#!/bin/x\nmain = 1\n"),
    expectTrue (hasErr " #!/bin/x\nmain = 1\n"),
    expectTrue (not (hasErr "#!/bin/x\nmain = 1\n")),
  ]

isLexError : Token -> Bool
isLexError (TLexError _) = True
isLexError _ = False

-- Raw literals: the TString bodies of a source, and the first literal's span.
rawBodies : String -> List String
rawBodies src =
  filterMap
    (t => match t
      TString s => Some s
      _ => None)
    (tokenize src)

rawSpan : String -> Option (Int, Int)
rawSpan src =
  let (tokens, spans) = tokenizeWithOffsetPairs src
  let found =
    filterMap
      ((t, sp) => match t
        TString _ => Some sp
        _ => None)
      (zip tokens spans)
  match found
    sp :: _ => Some sp
    [] => None

unterminatedAt : String -> Option (Int, Int)
unterminatedAt src =
  let (tokens, spans) = tokenizeWithOffsetPairs src
  let found =
    filterMap
      ((t, sp) => match t
        TLexError UnterminatedString => Some sp
        _ => None)
      (zip tokens spans)
  match found
    sp :: _ => Some sp
    [] => None

test "raw literals keep every character" = expectAll [
  expectEqual ["\\d+"] (rawBodies "r\"\\d+\""),
  expectEqual ["a\\nb"] (rawBodies "r\"a\\nb\""),
  expectEqual ["\\{x}"] (rawBodies "r\"\\{x}\""),
  expectEqual ["\\"] (rawBodies "r\"\\\""),
  expectEqual [""] (rawBodies "r\"\""),
  expectEqual ["a\"b"] (rawBodies "r\"\"\"a\"b\"\"\""),
  expectEqual
    ["\n  line1\\nline2\n  s = \"\\{x}\"\n"]
    (rawBodies "r\"\"\"\n  line1\\nline2\n  s = \"\\{x}\"\n\"\"\""),
]

test "raw literal span starts at the r" = expectAll [
  expectEqual (Some (4, 9)) (rawSpan "x = r\"ab\""),
  expectEqual (Some (0, 9)) (rawSpan "r\"\"\"ab\"\"\""),
]

test "raw prefix needs a token start and an adjacent quote" = expectAll [
  expectEqual ["IDENT \"r\"", "STRING \"x\""] (take 2 (tokensOf "r \"x\"")),
  expectEqual ["IDENT \"xr\""] (take 1 (tokensOf "xr\"a\"")),
  expectEqual ["IDENT \"bar\""] (take 1 (tokensOf "bar\"x\"")),
  expectEqual ["a"] (rawBodies "xr\"a\""),
  expectEqual ["x"] (rawBodies "bar\"x\""),
  expectEqual ["x"] (rawBodies "r \"x\""),
]

test "unterminated raw literals are located at the r" = expectAll [
  expectEqual (Some (4, 11)) (unterminatedAt "x = r\"\"\"abc"),
  expectEqual (Some (4, 9)) (unterminatedAt "x = r\"abc"),
  expectEqual (Some (4, 11)) (unterminatedAt "x = r\"ab\nc\""),
  expectEqual (Some (4, 8)) (unterminatedAt "x = r\"\"\""),
  expectEqual None (unterminatedAt "x = r"),
]
