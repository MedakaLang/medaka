          "deep-unmatched",
          "before = 1\nbroken = ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((\nafter = 2\n",
          ["before"],
        ),
        ("eof-missing-close", "before = 1\nbroken = (3", ["before"]),
        ("eof-missing-rhs", "before = 1\nbroken =", ["before"]),
        ("unicode-eof", "before = 1\nbroken = (\"😀\"", ["before"]),
        (
          "edit-0",
          "before = 1\nmiddle = (3 + 4)\nafter = 2\n",
          ["before", "middle", "after"],
        ),
        ("edit-1", "before = 1\nmiddle = (3 + 4\nafter = 2\n", ["before"]),
        (
          "edit-2",
          "before = 1\nmiddle = 3 + 4\nafter = 2\n",
          ["before", "middle", "after"],
        ),
        (
          "edit-3",
          "before = 1\nmiddle 3 + 4\nafter = 2\n",
          ["before", "after"],
        ),
        ("edit-4", "before = 1\nmiddle = )\nafter = 2\n", ["before", "after"]),
        ("edit-5", "before = 1\nmiddle = \"bad\nafter = 2\n", ["before"]),
        (
          "edit-6",
          "before = 1\nmiddle = 3 + 4\nafter = 2\n",
          ["before", "middle", "after"],
        ),
        (
          "real-edit-0",
          "-- #331 increment 2 (child-name spans) guard: MIXED multi-child decls of every\n-- outline-child kind, with children at DISTINCT columns/lines so a parser↔lsp\n-- child-order DESYNC (a Loc attaching to the wrong child) shows as a wrong\n-- name-column. Columns are 0-based; hand-verified in child_spans.golden.\ninterface Shape a where\n  area : a -> Float\n  perim : a -> Float\n  describe a = \"a shape\"\n\ndata Color =\n  | Red\n  | Green\n  | Blue\n\ndata Point = { px : Int, py : Int, pz : Int }\n\nimpl Shape Color where\n  area c = 1.0\n  perim c = 2.0\n  describe c = \"color\"\n\nlet rec spin n = spin n\n\n-- #331 increment 5 Part A regression guard: a PARENTHESIZED impl head must\n-- still blame the head TyCon inside the parens (`firstTyLoc` walks INTO a\n-- `TyApp` regardless of parens, frontend/ast.mdk) — not fall back to `impl`\n-- (a depth-0-only scan misses it entirely) and not, in the multi-arg case,\n-- land on a later BARE type argument (a depth-0-only scan matches `Int`\n-- instead of the parenthesized `Box`). Columns hand-verified below.\ninterface Wrap a where\n  unwrap : a -> Int\n\ndata Box a = Box a\n\nimpl Wrap (Box a) where\n  unwrap b = 0\n\ninterface Access a b where\n  get2 : a -> b -> Int\n\nimpl Access (Box a) Int where\n  get2 b i = i\n",
          [
            "interface:Shape", "Color", "Point", "impl:Shape", "other",
            "interface:Wrap", "Box", "impl:Wrap", "interface:Access",
            "impl:Access"
          ],
        ),
        (
          "real-edit-1",
          "-- #331 increment 2 (child-name spans) guard: MIXED multi-child decls of every\n-- outline-child kind, with children at DISTINCT columns/lines so a parser↔lsp\n-- child-order DESYNC (a Loc attaching to the wrong child) shows as a wrong\n-- name-column. Columns are 0-based; hand-verified in child_spans.golden.\ninterface Shape a where\n  area : a -> Float\n  perim : a -> Float\n  describe a = \"a shape\"\n\ndata Color =\n  | Red\n  | Green\n  | Blue\n\ndata Point { px : Int, py : Int, pz : Int }\n\nimpl Shape Color where\n  area c = 1.0\n  perim c = 2.0\n  describe c = \"color\"\n\nlet rec spin n = spin n\n\n-- #331 increment 5 Part A regression guard: a PARENTHESIZED impl head must\n-- still blame the head TyCon inside the parens (`firstTyLoc` walks INTO a\n-- `TyApp` regardless of parens, frontend/ast.mdk) — not fall back to `impl`\n-- (a depth-0-only scan misses it entirely) and not, in the multi-arg case,\n-- land on a later BARE type argument (a depth-0-only scan matches `Int`\n-- instead of the parenthesized `Box`). Columns hand-verified below.\ninterface Wrap a where\n  unwrap : a -> Int\n\ndata Box a = Box a\n\nimpl Wrap (Box a) where\n  unwrap b = 0\n\ninterface Access a b where\n  get2 : a -> b -> Int\n\nimpl Access (Box a) Int where\n  get2 b i = i\n",
          [
            "interface:Shape", "Color", "impl:Shape", "other", "interface:Wrap",
            "Box", "impl:Wrap", "interface:Access", "impl:Access"
          ],
        ),
        (
          "real-edit-2",
          "-- #331 increment 2 (child-name spans) guard: MIXED multi-child decls of every\n-- outline-child kind, with children at DISTINCT columns/lines so a parser↔lsp\n-- child-order DESYNC (a Loc attaching to the wrong child) shows as a wrong\n-- name-column. Columns are 0-based; hand-verified in child_spans.golden.\ninterface Shape a where\n  area : a -> Float\n  perim : a -> Float\n  describe a = \"a shape\"\n\ndata Color =\n  | Red\n  | Green\n  | Blue\n\ndata Point = { px : Int, py : Int, pz : Int\n\nimpl Shape Color where\n  area c = 1.0\n  perim c = 2.0\n  describe c = \"color\"\n\nlet rec spin n = spin n\n\n-- #331 increment 5 Part A regression guard: a PARENTHESIZED impl head must\n-- still blame the head TyCon inside the parens (`firstTyLoc` walks INTO a\n-- `TyApp` regardless of parens, frontend/ast.mdk) — not fall back to `impl`\n-- (a depth-0-only scan misses it entirely) and not, in the multi-arg case,\n-- land on a later BARE type argument (a depth-0-only scan matches `Int`\n-- instead of the parenthesized `Box`). Columns hand-verified below.\ninterface Wrap a where\n  unwrap : a -> Int\n\ndata Box a = Box a\n\nimpl Wrap (Box a) where\n  unwrap b = 0\n\ninterface Access a b where\n  get2 : a -> b -> Int\n\nimpl Access (Box a) Int where\n  get2 b i = i\n",
          ["interface:Shape", "Color"],
        ),
        (
          "real-edit-3",
          "-- #331 increment 2 (child-name spans) guard: MIXED multi-child decls of every\n-- outline-child kind, with children at DISTINCT columns/lines so a parser↔lsp\n-- child-order DESYNC (a Loc attaching to the wrong child) shows as a wrong\n-- name-column. Columns are 0-based; hand-verified in child_spans.golden.\ninterface Shape a where\n  area : a -> Float\n  perim : a -> Float\n  describe a = \"a shape\"\n\ndata Color =\n  | Red\n  | Green\n  | Blue\n\ndata Point = { px : Int, py : Int, pz : Int }\n\nimpl Shape Color where\n  area c = 1.0\n  perim c = )\n  describe c = \"color\"\n\nlet rec spin n = spin n\n\n-- #331 increment 5 Part A regression guard: a PARENTHESIZED impl head must\n-- still blame the head TyCon inside the parens (`firstTyLoc` walks INTO a\n-- `TyApp` regardless of parens, frontend/ast.mdk) — not fall back to `impl`\n-- (a depth-0-only scan misses it entirely) and not, in the multi-arg case,\n-- land on a later BARE type argument (a depth-0-only scan matches `Int`\n-- instead of the parenthesized `Box`). Columns hand-verified below.\ninterface Wrap a where\n  unwrap : a -> Int\n\ndata Box a = Box a\n\nimpl Wrap (Box a) where\n  unwrap b = 0\n\ninterface Access a b where\n  get2 : a -> b -> Int\n\nimpl Access (Box a) Int where\n  get2 b i = i\n",
          [
            "interface:Shape", "Color", "Point", "other", "interface:Wrap",
            "Box", "impl:Wrap", "interface:Access", "impl:Access"
          ],
        ),
        (
          "real-edit-4",
          "-- #331 increment 2 (child-name spans) guard: MIXED multi-child decls of every\n-- outline-child kind, with children at DISTINCT columns/lines so a parser↔lsp\n-- child-order DESYNC (a Loc attaching to the wrong child) shows as a wrong\n-- name-column. Columns are 0-based; hand-verified in child_spans.golden.\ninterface Shape a where\n  area : a -> Float\n  perim : a -> Float\n  describe a = \"a shape\"\n\ndata Color =\n  | Red\n  | Green\n  | Blue\n\ndata Point = )\n\nimpl Shape Color where\n  area c = 1.0\n  perim c = 2.0\n  describe c = \"color\"\n\nlet rec spin n = spin n\n\n-- #331 increment 5 Part A regression guard: a PARENTHESIZED impl head must\n-- still blame the head TyCon inside the parens (`firstTyLoc` walks INTO a\n-- `TyApp` regardless of parens, frontend/ast.mdk) — not fall back to `impl`\n-- (a depth-0-only scan misses it entirely) and not, in the multi-arg case,\n-- land on a later BARE type argument (a depth-0-only scan matches `Int`\n-- instead of the parenthesized `Box`). Columns hand-verified below.\ninterface Wrap a where\n  unwrap : a -> Int\n\ndata Box a = Box a\n\nimpl Wrap (Box a) where\n  unwrap b = 0\n\ninterface Access a b where\n  get2 : a -> b -> Int\n\nimpl Access (Box a) Int where\n  get2 b i = i\n",
          [
