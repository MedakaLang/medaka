import string.{repeat}
import frontend.ast.{Decl(..), Loc(..)}
import frontend.parse_recovery.{
  parseRecovering, parseRecoveringWith, parseRecoveringWithIndex,
  RecoveryLimits(..)
}
import frontend.recovery_result.{
  recoveredDecls, recoveredDiagnostics, invalidRegions, invalidExtent,
  recoveredCompleteness, recoveredStats, RecoveryCompleteness(..),
  RecoveryStop(..), RecoveryStats(..), SourceExtent(..)
}
import frontend.parse_diagnostic.{
  ParseDiagnostic, diagnosticCode, diagnosticLoc, diagnosticEdits,
  ParseEdit(..), EditApplicability(..)
}
import support.source_index.{indexSource}
import test.{Expectation, expectAll, expectEqual, expectEach}

name : Decl -> String
name (DFunDef _ n _ _ _ _) = n
name (DData { dataName = n }) = n
name (DInterface { name = n }) = "interface:" ++ n
name (DImpl { iface = n }) = "impl:" ++ n
name (DTypeSig _ n _ _) = "signature:" ++ n
name _ = "other"

extent : SourceExtent -> (Int, Int)
extent (SourceExtent start end) = (start, end)

test "recovery retains declarations on both sides of damage" =
  let r = parseRecovering "before = 1\nbroken = )\nafter = 2\n"
  expectAll [
    expectEqual ["before", "after"] (map name (recoveredDecls r)),
    expectEqual ["P-PARSE"] (map diagnosticCode (recoveredDiagnostics r)),
    expectEqual
      [(11, 22)]
      (map (region => extent (invalidExtent region)) (invalidRegions r)),
  ]

test "unclosed delimiters do not promote nested declarations" =
  let r = parseRecovering "before = 1\nbroken = (\nhidden = 9\nafter = 2\n"
  expectEqual ["before"] (map name (recoveredDecls r))

test "recovery matrix retains the expected current declarations" =
  expectEach
    (map
      ((label, src, expected) => (
        label,
        expectEqual expected (map name (recoveredDecls (parseRecovering src))),
      ))
      [
        (
          "valid",
          "before = 1\nmiddle = 3\nafter = 2\n",
          ["before", "middle", "after"],
        ),
        (
          "rhs-close",
          "before = 1\nbroken = )\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "deleted-equal",
          "before = 1\nbroken 3\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "missing-rhs",
          "before = 1\nbroken =\nafter = 2\n",
          ["before", "after"],
        ),
        ("missing-close", "before = 1\nbroken = (3\nafter = 2\n", ["before"]),
        (
          "missing-list-close",
          "before = 1\nbroken = [3,\nafter = 2\n",
          ["before"],
        ),
        (
          "missing-record-close",
          "before = 1\nbroken = { field = 3\nafter = 2\n",
          ["before"],
        ),
        (
          "missing-projection-close",
          "before = 1\nbroken = value.{field\nafter = 2\n",
          ["before"],
        ),
        (
          "mismatched-close",
          "before = 1\nbroken = ([3)\nafter = 2\n",
          ["before"],
        ),
        (
          "extra-close",
          "before = 1\nbroken = 3 )\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "indent-nested",
          "before = 1\nbroken = do\n  local = )\n  hidden = 9\n  local\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "dedent",
          "before = 1\nbroken = do\n  local = )\n hidden = 9\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "continuation",
          "before = 1\nbroken = 1 +\n  hidden = 9\nafter = 2\n",
          ["before", "after"],
        ),
        ("top-level-indent", "  before = 1\n  broken = )\n  after = 2\n", []),
        (
          "nested-col-zero",
          "before = 1\nbroken = (\nhidden = 9\n)\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "nested-unclosed-zero",
          "before = 1\nbroken = (\nhidden = 9\nafter = 2\n",
          ["before"],
        ),
        (
          "nested-brace-zero",
          "before = 1\nbroken = {\nhidden = 9\n}\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "nested-interpolation",
          "before = 1\nbroken = \"\\{\nhidden = 9\n}\"\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "closed-string-control",
          "before = 1\ntext = \"fake = 9\"\nnope = )\nafter = 2\n",
          ["before", "text", "after"],
        ),
        (
          "closed-comment-control",
          "before = 1\n{-\nfake = 9\n-}\nbroken = )\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "line-comment-control",
          "before = 1\n-- fake = 9\nbroken = )\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "unterminated-string-middle",
          "before = 1\nbroken = \"oops\nafter = 2\n",
          ["before"],
        ),
        ("unterminated-string-eof", "before = 1\nbroken = \"oops", ["before"]),
        (
          "unterminated-comment",
          "before = 1\n{- oops\nafter = 2\n",
          ["before"],
        ),
        (
          "unterminated-char",
          "before = 1\nbroken = 'x\nafter = 2\n",
          ["before"],
        ),
        (
          "bad-character-middle",
          "before = 1\nbroken = $\nafter = 2\n",
          ["before"],
        ),
        ("bad-character-eof", "before = 1\nbroken = $", ["before"]),
        ("bad-escape", "before = 1\nbroken = \"\\q\"\nafter = 2\n", ["before"]),
        (
          "two-errors",
          "before = 1\nbroken = )\nmiddle = 3\nother = ]\nafter = 2\n",
          ["before", "middle", "after"],
        ),
        (
          "removed-prescan",
          "before = 1\nbroken = 1 != 2\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "prefix-export",
          "before = 1\nexport\nkept = 4\nbroken = )\nafter = 2\n",
          ["before", "kept", "after"],
        ),
        (
          "missing-equal-next-line",
          "before = 1\nbroken\n= 3\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "unicode-locations",
          "-- 😀\nbefore = 1\nbroken = )\nafter = 2\n",
          ["before", "after"],
        ),
        (
          "crlf",
          "before = 1\r\nbroken = )\r\nafter = 2\r\n",
          ["before", "after"],
        ),
