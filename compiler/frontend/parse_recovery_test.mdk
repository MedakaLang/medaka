status : RecoveryCompleteness -> String
status Complete = "complete"
status (Partial ReachedEnd) = "reached"
status (Partial StoppedLexically) = "lexical"
status (Partial StoppedDelimiter) = "delimiter"
status (Partial StoppedBoundary) = "boundary"
status (Partial ExhaustedBudget) = "budget"

counts : RecoveryStats -> (Int, Int, Int)
counts (RecoveryStats tokens attempts diagnostics) =
  (tokens, attempts, diagnostics)

test "budgets bound diagnostics and declaration attempts" =
  let errors = parseRecovering ("""before = 1
""" ++ repeat 1000 """bad = )
""")
  let many = parseRecovering ("""bad = )
""" ++ repeat 5000 """ok = 1
""")
  let (_, errorAttempts, diagnostics) = counts (recoveredStats errors)
  let (_, attempts, _) = counts (recoveredStats many)
  expectAll [
    expectEqual
      ("budget", 33, 32)
      (status (recoveredCompleteness errors), errorAttempts, diagnostics),
    expectEqual
      ("budget", 4096, 4095)
      (
        status (recoveredCompleteness many),
        attempts,
        length (recoveredDecls many),
      ),
  ]

test "source and token admission stop before parsing" =
  let source = parseRecovering ("-- " ++ repeat 8388608 "x")
  let tokens = parseRecovering (repeat 125001 """a = 1
""")
  let (_, sourceAttempts, _) = counts (recoveredStats source)
  let (_, tokenAttempts, _) = counts (recoveredStats tokens)
  expectEqual
    ("budget", 0, "budget", 0)
    (
      status (recoveredCompleteness source),
      sourceAttempts,
      status (recoveredCompleteness tokens),
      tokenAttempts,
    )

test "zero diagnostic limit does not publish a diagnostic" =
  let result = parseRecoveringWith (RecoveryLimits 1000 1000 1000 0) "bad = )"
  expectEqual
    ("budget", 0)
    (
      status (recoveredCompleteness result),
      length (recoveredDiagnostics result),
    )

test "independent recovery results do not share invocation state" =
  let p = """before = 1
broken = )
after = 2
"""
  let first = parseRecovering p
  let other = parseRecovering """other = 3
"""
  let again = parseRecovering p
  expectAll [
    expectEqual ["other"] (map name (recoveredDecls other)),
    expectEqual
      (
        map name (recoveredDecls first),
        regionExtents (invalidRegions first),
      )
      (
        map name (recoveredDecls again),
        regionExtents (invalidRegions again),
      ),
  ]

data ExpectedSpan = ExpectedSpan Int Int Int Int deriving (Eq, Debug)

span : Loc -> ExpectedSpan
span (Loc _ sl sc el ec) = ExpectedSpan sl sc el ec

neqSpan : Int -> ExpectedSpan
neqSpan line = ExpectedSpan line 8 line 10

test "synthetic tail diagnostic uses real emoji EOF" =
  let result = parseRecovering (withoutFinalLf """before = 1
broken = (\"😀\"
""")
  expectAll [
    expectEqual ["before"] (map name (recoveredDecls result)),
    expectEqual
      [ExpectedSpan 2 13 2 13]
      (map (d => span (diagnosticLoc d)) (recoveredDiagnostics result)),
    expectEqual [(11, 24)] (regionExtents (invalidRegions result)),
  ]

test "terminal string errors and deep delimiters stop the suffix" =
  let literal = parseRecovering """before = 1
broken = \"oops
after = 2
"""
  let deep =
    parseRecovering
      ("before = 1\nbroken = " ++ repeat 5000 "(" ++ "\nafter = 2\n")
  expectAll [
    expectEqual
      (["before"], ["L-UNTERMINATED-STRING"], "lexical")
      (
        map name (recoveredDecls literal),
        map diagnosticCode (recoveredDiagnostics literal),
        status (recoveredCompleteness literal),
      ),
    expectEqual
      (["before"], "delimiter")
      (map name (recoveredDecls deep), status (recoveredCompleteness deep)),
  ]

test "strict string EOF prerequisite is reflected in recovery" =
  let result = parseRecovering "before = 1\nbroken = \"\"\"oops\nafter = 2\n"
  expectEqual
    (["before"], ["L-UNTERMINATED-STRING"], "lexical")
    (
      map name (recoveredDecls result),
      map diagnosticCode (recoveredDiagnostics result),
      status (recoveredCompleteness result),
    )

test "separate islands preserve typed diagnostics and original extents" =
  let result =
    parseRecovering """before = 1
broken = )
middle = 3
other = ]
after = 2
"""
  expectAll [
    expectEqual
      ["before", "middle", "after"]
      (map name (recoveredDecls result)),
    expectEqual
      ["P-PARSE", "P-PARSE"]
      (map diagnosticCode (recoveredDiagnostics result)),
    expectEqual [(11, 22), (33, 43)] (regionExtents (invalidRegions result)),
  ]

test "prescan diagnostic remains typed on a rejected island" =
  let result = parseRecovering """before = 1
broken = 1 != 2
after = 2
"""
  expectEqual
    (["before", "after"], ["P-BAD-NEQ"], [(11, 27)])
    (
      map name (recoveredDecls result),
      map diagnosticCode (recoveredDiagnostics result),
      regionExtents (invalidRegions result),
    )

editRow : ParseEdit -> (ExpectedSpan, String, String, Bool)
editRow (ParseEdit loc old replacement applicability) =
  (span loc, old, replacement, applicability == MachineApplicable)

diagnosticRow : ParseDiagnostic ->
  (String, ExpectedSpan, List (ExpectedSpan, String, String, Bool))
diagnosticRow diagnostic = (
  diagnosticCode diagnostic,
  span (diagnosticLoc diagnostic),
  map editRow (diagnosticEdits diagnostic),
)

indexedCoordinateCase : String ->
  Int ->
  List ExpectedSpan ->
  (String, Expectation)
indexedCoordinateCase newline count spans =
  let src =
    stringConcat ["-- 😀", newline, repeat count ("bad = 1 != 2" ++ newline)]
  let expected =
    map (loc => ("P-BAD-NEQ", loc, [(loc, "!=", "/=", True)])) spans
  let raw = parseRecovering src
  let indexed = parseRecoveringWithIndex (indexSource src) src
  (
    newline ++ intToString count,
    expectAll [
      expectEqual expected (map diagnosticRow (recoveredDiagnostics raw)),
      expectEqual expected (map diagnosticRow (recoveredDiagnostics indexed)),
    ],
  )

test "shared diagnostic index preserves coordinates and edits" = expectEach [
  indexedCoordinateCase "\n" 1 [neqSpan 2],
  indexedCoordinateCase "\r\n" 2 [neqSpan 2, neqSpan 3],
  indexedCoordinateCase "\r" 4 [
    neqSpan 2,
    neqSpan 3,
    neqSpan 4,
    neqSpan 5,
  ],
  indexedCoordinateCase "\n" 8 [
    neqSpan 2,
    neqSpan 3,
    neqSpan 4,
    neqSpan 5,
    neqSpan 6,
    neqSpan 7,
    neqSpan 8,
    neqSpan 9,
  ],
]
