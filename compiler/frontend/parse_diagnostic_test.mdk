import support.diag_codes.{DiagCode(..), codeText}
import frontend.ast.{Loc(..)}
import frontend.parse_diagnostic.{
  ParseDiagnostic(..), ParseDiagnosticKind(..), ParseEdit(..),
  EditApplicability(..), UnicodeProblem(..), diagnosticCode, diagnosticLoc,
  diagnosticEdits, diagnosticHelp, renderParseDiagnostic, locateParseProblem,
  makeParseDiagnostic
}
import frontend.parser.{
  parseResult, parseLocatedResult, parseResultPairs, parseErrorDiagnostic
}
import frontend.lexer.{tokenizeWithOffsetPairs}
import support.source_index.{indexSource}
import test.{Expectation, expectEqual, expectEach, expectAll, fail}

spanText : Loc -> (Int, Int, Int, Int)
spanText (Loc _ sl sc el ec) = (sl, sc, el, ec)

editText : ParseEdit -> ((Int, Int, Int, Int), String, String, Bool)
editText (ParseEdit loc old new applicability) =
  (spanText loc, old, new, applicability == MachineApplicable)

problem : ParseDiagnosticKind -> ParseDiagnostic
problem kind = locateParseProblem (indexSource "bad") 0 3 kind

test "the established frontend code roster is assigned by kinds" =
  expectEach
    (map
      ((kind, code) =>
        (codeText code, expectEqual code (diagnosticCode (problem kind))))
      [
        (UnterminatedString, LUnterminatedString),
        (NestedInterpolation, LNestedInterpolation),
        (UnterminatedComment, LUnterminatedComment),
        (UnterminatedChar, LBadCharLiteral),
        (InvalidEscape "\\v" False, LBadEscape),
        (BadUnicodeEscape UnicodeEmpty, LBadUnicodeEscape),
        (BareUnicodeEscape "\\u0041" "\\u{0041}", LBareUnicodeEscape),
        (HsLambda, LHsLambda),
        (HsDollar, LHsDollar),
        (UnexpectedCharacter "?", LBadChar),
        (IntegerOverflow, LIntOverflow),
        (FloatOverflow, LFloatOverflow),
        (MalformedRadix "0x_FF" "0x" "FF", LMalformedRadix),
        (MalformedFloat "5." "5.0" False, LMalformedFloat),
        (UnexpectedEnd, PUnexpectedEof),
        (BadNeq, PBadNeq),
        (HsCase, PHsCase),
        (MatchWith, POcamlMatchWith),
        (NoPow, PNoPowOperator),
        (HsSignature, PHsSig),
        (BlockComment, LBlockcomment),
        (BraceBlock, PBraceBlock),
        (ForeignKeyword "for", PForWhile),
        (ForeignKeyword "def", PDefKeyword),
        (Semicolon, LSemicolon),
        (MissingWhere "impl", PMissingWhere),
        (WhereSameLine "interface", PWhereBodySameLine),
        (BlockEndsBinding "do", PDoEndsInBinding),
        (MatchGuardBar, PGuardBarInMatch),
        (EquationGuardIf, PGuardIfInEquation),
        (ReservedKeyword "type", PReservedKeyword),
        (GenericParse "expected an expression", PParse),
      ])

test "generic wording cannot impersonate a specialized diagnostic or edit" =
  let diagnostic = problem (GenericParse "unexpected `!=`; did you mean `/=`?")
  expectAll [
    expectEqual "P-PARSE" (codeText (diagnosticCode diagnostic)),
    expectEqual [] (map editText (diagnosticEdits diagnostic)),
    expectEqual None (diagnosticHelp diagnostic),
  ]

test "differently worded typed cases retain the same code and edit rule" =
  expectEach
    (map
      ((old, new) =>
        let diagnostic =
          locateParseProblem
            (indexSource old)
            0
            (stringLength old)
            (BareUnicodeEscape old new)
        (
          old,
          expectAll [
            expectEqual
              "L-BARE-UNICODE-ESCAPE"
              (codeText (diagnosticCode diagnostic)),
            expectEqual
              [((1, 0, 1, 6), old, new, True)]
              (map editText (diagnosticEdits diagnostic)),
            expectEqual
              ("bare unicode escape `"
                ++ old
                ++ "` is not valid; did you mean `"
                ++ new
                ++ "`?")
              (renderParseDiagnostic diagnostic),
          ],
        ))
      [("\\u0041", "\\u{0041}"), ("\\u0062", "\\u{0062}")])

expectSource : String ->
  String ->
  (Int, Int, Int, Int) ->
  List (String, String) ->
  Expectation
expectSource source code span edits =
  let check result = match result
    Ok _ => fail ("unexpected acceptance of " ++ source)
    Err error =>
      let diagnostic = parseErrorDiagnostic error
      expectAll [
        expectEqual code (codeText (diagnosticCode diagnostic)),
        expectEqual span (spanText (diagnosticLoc diagnostic)),
        expectEqual
          (map ((old, new) => (span, old, new, True)) edits)
          (map editText (diagnosticEdits diagnostic)),
      ]
  let (tokens, pairs) = tokenizeWithOffsetPairs source
  expectAll [
    check (parseResult source),
    check (parseLocatedResult source),
    check (parseResultPairs source tokens pairs),
  ]

test "malformed radix and Unicode spans preserve the written codepoints" = expectEach
  [
    (
      "radix",
      expectSource
        "x = 0x_FF"
        "L-MALFORMED-RADIX"
        (1, 4, 1, 9)
        [("0x_FF", "0xFF")],
    ),
    (
      "radix without digits",
      expectSource "x = 0x_" "L-MALFORMED-RADIX" (1, 4, 1, 7) [],
    ),
    (
      "bare unicode after emoji",
      expectSource
        "x = \"😀\\u0041\""
        "L-BARE-UNICODE-ESCAPE"
        (1, 6, 1, 12)
        [("\\u0041", "\\u{0041}")],
    ),
    (
      "surrogate",
      expectSource "x = \"😀\\u{D800}\"" "L-BAD-UNICODE-ESCAPE" (1, 6, 1, 14) [],
    ),
    (
      "unicode separator",
      expectSource "x = \"😀\\u{4_1}\"" "L-BAD-UNICODE-ESCAPE" (1, 6, 1, 13) [],
    ),
    (
      "invalid string escape",
      expectSource "x = \"😀\\v\"" "L-BAD-ESCAPE" (1, 6, 1, 8) [],
    ),
    (
      "invalid char escape",
      expectSource "x = '\\v'" "L-BAD-ESCAPE" (1, 5, 1, 7) [],
    ),
    (
      "leading float",
      expectSource "x = .5" "L-MALFORMED-FLOAT" (1, 4, 1, 6) [(".5", "0.5")],
    ),
    (
      "trailing float",
      expectSource "x = 5." "L-MALFORMED-FLOAT" (1, 4, 1, 6) [("5.", "5.0")],
    ),
  ]

test "safe parser edits cover only the offending token after Unicode" = expectEach
  [
    (
      "inequality",
      expectSource "x = \"😀\" != \"a\"" "P-BAD-NEQ" (1, 8, 1, 10) [("!=", "/=")],
    ),
    (
      "signature",
      expectSource "f :: Int" "P-HS-SIG" (1, 2, 1, 4) [("::", ":")],
    ),
    (
      "keyword",
      expectSource
        "f type = 1"
        "P-RESERVED-KEYWORD"
        (1, 2, 1, 6)
        [("type", "type_")],
    ),
    ("semicolon", expectSource "x = 1;" "L-SEMICOLON" (1, 5, 1, 6) []),
    (
      "multi-step case rewrite",
      expectSource "x = case y of" "P-HS-CASE" (1, 4, 1, 8) [],
    ),
  ]

test "committed and recoverable failures retain their diagnostic identity" = expectEach
  [
    (
      "committed guard",
      expectSource
        """
f x
  if true = x
"""
        "P-GUARD-IF-IN-EQUATION"
        (2, 2, 2, 4)
        [("if", "|")],
    ),
    (
      "committed reserved name",
      expectSource
        "f = match 1\n  type => 1"
        "P-RESERVED-KEYWORD"
        (2, 2, 2, 6)
        [("type", "type_")],
    ),
    (
      "bar guard carries the if fix",
      expectSource
        "f n = match n\n  m | m > 0 => 1"
        "P-GUARD-BAR-IN-MATCH"
        (2, 4, 2, 5)
        [("|", "if")],
    ),
    (
      "wrapped or-pattern carries no fix",
      expectSource
        "data K = K1 | K2 | K3\nf k = match k\n  K1 | K2 |\n    K3 => 1\n  _ => 0"
        "P-GUARD-BAR-IN-MATCH"
        (3, 10, 3, 11)
        [],
    ),
    ("recoverable", expectSource "f x = = 1" "P-PARSE" (1, 6, 1, 7) []),
  ]

test "unterminated string EOF location uses original Unicode and CRLF" = expectEach
  [
    (
      "triple",
      expectSource "x = \"\"\"😀\r\nend" "L-UNTERMINATED-STRING" (2, 3, 2, 3) [],
    ),
    (
      "plain interpolation",
      expectSource "x = \"😀\\{1}tail" "L-UNTERMINATED-STRING" (1, 14, 1, 14) [],
    ),
    (
      "triple interpolation",
      expectSource
        "x = \"\"\"😀\\{1}\r\ntail"
        "L-UNTERMINATED-STRING"
        (2, 4, 2, 4)
        [],
    ),
  ]

test "shared diagnostic construction retains typed edits" =
  let loc = Loc "" 2 3 2 5
  let diagnostic = makeParseDiagnostic BadNeq loc
  expectAll [
    expectEqual "P-BAD-NEQ" (codeText (diagnosticCode diagnostic)),
    expectEqual
      [((2, 3, 2, 5), "!=", "/=", True)]
      (map editText (diagnosticEdits diagnostic)),
  ]
