dumpSection : Section -> SExp
dumpSection (SecBare a0) = SList [SAtom "ctor:Section.SecBare", dumpString a0]
dumpSection (SecRight a0 a1) =
  SList [SAtom "ctor:Section.SecRight", dumpString a0, dumpExpr a1]
dumpSection (SecLeft a0 a1) =
  SList [SAtom "ctor:Section.SecLeft", dumpExpr a0, dumpString a1]

dumpFunClause : FunClause -> SExp
dumpFunClause (FunClause a0 a1) =
  SList [SAtom "ctor:FunClause.FunClause", dumpList dumpPat a0, dumpExpr a1]

dumpLetBind : LetBind -> SExp
dumpLetBind (LetBind a0 a1 a2 a3) = SList [
  SAtom "ctor:LetBind.LetBind",
  dumpString a0,
  dumpList dumpFunClause a1,
  dumpLoc a2,
  dumpBinderId a3,
]

dumpExpr : Expr -> SExp
dumpExpr (ELit a0) = SList [SAtom "ctor:Expr.ELit", dumpLit a0]
dumpExpr (EVar a0) = SList [SAtom "ctor:Expr.EVar", dumpString a0]
dumpExpr (EApp a0 a1) = SList [SAtom "ctor:Expr.EApp", dumpExpr a0, dumpExpr a1]
dumpExpr (ELam a0 a1) =
  SList [SAtom "ctor:Expr.ELam", dumpList dumpPat a0, dumpExpr a1]
dumpExpr (ELet a0 a1 a2 a3 a4) = SList [
  SAtom "ctor:Expr.ELet",
  dumpLoc a0,
  dumpBool a1,
  dumpPat a2,
  dumpExpr a3,
  dumpExpr a4,
]
dumpExpr (EMatch a0 a1) =
  SList [SAtom "ctor:Expr.EMatch", dumpExpr a0, dumpList dumpArm a1]
dumpExpr (EIf a0 a1 a2) =
  SList [SAtom "ctor:Expr.EIf", dumpExpr a0, dumpExpr a1, dumpExpr a2]
dumpExpr (EBinOp a0 a1 a2 a3) = SList [
  SAtom "ctor:Expr.EBinOp",
  dumpString a0,
  dumpExpr a1,
  dumpExpr a2,
  dumpEvId a3,
]
dumpExpr (EUnOp a0 a1 a2) =
  SList [SAtom "ctor:Expr.EUnOp", dumpString a0, dumpExpr a1, dumpEvId a2]
dumpExpr (EInfix a0 a1 a2) =
  SList [SAtom "ctor:Expr.EInfix", dumpString a0, dumpExpr a1, dumpExpr a2]
dumpExpr (EFieldAccess a0 a1 a2) = SList [
  SAtom "ctor:Expr.EFieldAccess",
  dumpExpr a0,
  dumpString a1,
  dumpEvId a2,
]
dumpExpr (ETuple a0) = SList [SAtom "ctor:Expr.ETuple", dumpList dumpExpr a0]
dumpExpr (EListLit a0) =
  SList [SAtom "ctor:Expr.EListLit", dumpList dumpExpr a0]
dumpExpr (EArrayLit a0) =
  SList [SAtom "ctor:Expr.EArrayLit", dumpList dumpExpr a0]
dumpExpr (ERangeList a0 a1 a2) =
  SList [SAtom "ctor:Expr.ERangeList", dumpExpr a0, dumpExpr a1, dumpBool a2]
dumpExpr (ERangeArray a0 a1 a2) =
  SList [SAtom "ctor:Expr.ERangeArray", dumpExpr a0, dumpExpr a1, dumpBool a2]
dumpExpr (ESlice a0 a1 a2 a3) = SList [
  SAtom "ctor:Expr.ESlice",
  dumpExpr a0,
  dumpExpr a1,
  dumpExpr a2,
  dumpBool a3,
]
dumpExpr (ELetGroup a0 a1) =
  SList [SAtom "ctor:Expr.ELetGroup", dumpList dumpLetBind a0, dumpExpr a1]
dumpExpr (ESection a0) = SList [SAtom "ctor:Expr.ESection", dumpSection a0]
dumpExpr (EIndex a0 a1) =
  SList [SAtom "ctor:Expr.EIndex", dumpExpr a0, dumpExpr a1]
dumpExpr (EAnnot a0 a1) =
  SList [SAtom "ctor:Expr.EAnnot", dumpExpr a0, dumpTy a1]
dumpExpr (EHeadAnnot a0 a1) =
  SList [SAtom "ctor:Expr.EHeadAnnot", dumpExpr a0, dumpTy a1]
dumpExpr (EBlock a0) = SList [SAtom "ctor:Expr.EBlock", dumpList dumpDoStmt a0]
dumpExpr (EDo a0 a1) =
  SList [SAtom "ctor:Expr.EDo", dumpBool a0, dumpList dumpDoStmt a1]
dumpExpr (EStringInterp a0) =
  SList [SAtom "ctor:Expr.EStringInterp", dumpList dumpInterpPart a0]
dumpExpr (EGuards a0) =
  SList [SAtom "ctor:Expr.EGuards", dumpList dumpGuardArm a0]
dumpExpr (ERecordCreate a0 a1) = SList [
  SAtom "ctor:Expr.ERecordCreate",
  dumpString a0,
  dumpList dumpFieldAssign a1,
]
dumpExpr (ERecordUpdate a0 a1 a2) = SList [
  SAtom "ctor:Expr.ERecordUpdate",
  dumpExpr a0,
  dumpList dumpFieldAssign a1,
  dumpEvId a2,
]
dumpExpr (EVariantUpdate a0 a1 a2) = SList [
  SAtom "ctor:Expr.EVariantUpdate",
  dumpString a0,
  dumpExpr a1,
  dumpList dumpFieldAssign a2,
]
dumpExpr (EMapLit a0 a1) = SList [
  SAtom "ctor:Expr.EMapLit",
  dumpString a0,
  dumpList (dumpPair dumpExpr dumpExpr) a1,
]
dumpExpr (ESetLit a0 a1) =
  SList [SAtom "ctor:Expr.ESetLit", dumpString a0, dumpList dumpExpr a1]
dumpExpr (EAsPat a0 a1) =
  SList [SAtom "ctor:Expr.EAsPat", dumpString a0, dumpExpr a1]
dumpExpr (EMethodRef a0) = SList [SAtom "ctor:Expr.EMethodRef", dumpString a0]
dumpExpr (EDictApp a0) = SList [SAtom "ctor:Expr.EDictApp", dumpString a0]
dumpExpr (EVarAt a0 a1) =
  SList [SAtom "ctor:Expr.EVarAt", dumpString a0, dumpAddr a1]
dumpExpr (EVarId a0 a1) =
  SList [SAtom "ctor:Expr.EVarId", dumpString a0, dumpInt a1]
dumpExpr (EMethodAt a0 a1 a2) =
  SList [SAtom "ctor:Expr.EMethodAt", dumpString a0, dumpString a1, dumpEvId a2]
dumpExpr (EDictAt a0 a1) =
  SList [SAtom "ctor:Expr.EDictAt", dumpString a0, dumpEvId a1]
dumpExpr (ELoc a0 a1) = SList [SAtom "ctor:Expr.ELoc", dumpLoc a0, dumpExpr a1]
dumpExpr (EDoOrigin a0 a1) =
  SList [SAtom "ctor:Expr.EDoOrigin", dumpLoc a0, dumpExpr a1]
dumpExpr (ENumLit a0 a1 a2) =
  SList [SAtom "ctor:Expr.ENumLit", dumpInt a0, dumpEvId a1, dumpString a2]
dumpExpr (EWideLit a0 a1 a2 a3) = SList [
  SAtom "ctor:Expr.EWideLit",
  dumpInt a0,
  dumpInt a1,
  dumpEvId a2,
  dumpString a3,
]

dumpUseMember : UseMember -> SExp
dumpUseMember (UseMember a0 a1 a2 a3) = SList [
  SAtom "ctor:UseMember.UseMember",
  dumpString a0,
  dumpBool a1,
  dumpLoc a2,
  dumpOpt dumpString a3,
]

dumpUsePath : UsePath -> SExp
dumpUsePath (UseName a0) =
  SList [SAtom "ctor:UsePath.UseName", dumpList dumpString a0]
dumpUsePath (UseGroup a0 a1) = SList [
  SAtom "ctor:UsePath.UseGroup",
  dumpList dumpString a0,
  dumpList dumpUseMember a1,
]
dumpUsePath (UseWild a0) =
  SList [SAtom "ctor:UsePath.UseWild", dumpList dumpString a0]
dumpUsePath (UseAlias a0 a1) =
  SList [SAtom "ctor:UsePath.UseAlias", dumpList dumpString a0, dumpString a1]

dumpPropParam : PropParam -> SExp
dumpPropParam (PropParam a0 a1 a2) =
  SList [SAtom "ctor:PropParam.PropParam", dumpString a0, dumpLoc a1, dumpTy a2]

dumpMethodDefault : MethodDefault -> SExp
dumpMethodDefault (MethodDefault a0 a1) = SList [
  SAtom "ctor:MethodDefault.MethodDefault",
  dumpList dumpPat a0,
  dumpExpr a1,
]

dumpIfaceMethod : IfaceMethod -> SExp
dumpIfaceMethod (IfaceMethod a0 a1 a2 a3) = SList [
  SAtom "ctor:IfaceMethod.IfaceMethod",
  dumpString a0,
  dumpTy a1,
  dumpOpt dumpMethodDefault a2,
  dumpOpt dumpLoc a3,
]

dumpSuper : Super -> SExp
dumpSuper (Super { superHead = a0, superParams = a1, superOrigin = a2 }) = SList
  [
    SAtom "ctor:Super.Super",
    dumpString a0,
    dumpList dumpString a1,
    dumpTyConOrigin a2,
  ]

dumpRequire : Require -> SExp
dumpRequire (Require { requireHead = a0, requireArgs = a1, requireOrigin = a2 }) = SList
  [
    SAtom "ctor:Require.Require",
    dumpString a0,
    dumpList dumpTy a1,
    dumpTyConOrigin a2,
  ]

dumpImplMethod : ImplMethod -> SExp
dumpImplMethod (ImplMethod a0 a1 a2) = SList [
  SAtom "ctor:ImplMethod.ImplMethod",
  dumpString a0,
  dumpList dumpPat a1,
  dumpExpr a2,
]

dumpDataVis : DataVis -> SExp
dumpDataVis VisPrivate = SList [SAtom "ctor:DataVis.VisPrivate"]
dumpDataVis VisAbstract = SList [SAtom "ctor:DataVis.VisAbstract"]
dumpDataVis VisPublic = SList [SAtom "ctor:DataVis.VisPublic"]

dumpField : Field -> SExp
dumpField (Field a0 a1) =
  SList [SAtom "ctor:Field.Field", dumpString a0, dumpTy a1]

dumpConPayload : ConPayload -> SExp
dumpConPayload (ConPos a0) =
  SList [SAtom "ctor:ConPayload.ConPos", dumpList dumpTy a0]
dumpConPayload (ConNamed a0 a1) =
  SList [SAtom "ctor:ConPayload.ConNamed", dumpList dumpField a0, dumpBool a1]

dumpVariant : Variant -> SExp
dumpVariant (Variant a0 a1) =
  SList [SAtom "ctor:Variant.Variant", dumpString a0, dumpConPayload a1]

dumpAttr : Attr -> SExp
dumpAttr (AttrDeprecated a0) =
  SList [SAtom "ctor:Attr.AttrDeprecated", dumpOpt dumpString a0]
dumpAttr AttrInline = SList [SAtom "ctor:Attr.AttrInline"]
dumpAttr AttrMustUse = SList [SAtom "ctor:Attr.AttrMustUse"]
dumpAttr AttrNoInline = SList [SAtom "ctor:Attr.AttrNoInline"]

dumpDeriveRef : DeriveRef -> SExp
dumpDeriveRef (DeriveRef a0 a1) =
  SList [SAtom "ctor:DeriveRef.DeriveRef", dumpString a0, dumpOpt dumpLoc a1]

dumpExternDecl : ExternDecl -> SExp
dumpExternDecl (ExternDecl { edPub = a0, edName = a1, edTy = a2, edLoc = a3, edBinds = a4 }) = SList
  [
    SAtom "ctor:ExternDecl.ExternDecl",
    dumpBool a0,
    dumpString a1,
    dumpTy a2,
    dumpLoc a3,
    dumpList dumpExternBind a4,
  ]

dumpExternBind : ExternBind -> SExp
dumpExternBind (ExternBind { ebHost = a0, ebSymbol = a1, ebLoc = a2 }) = SList [
  SAtom "ctor:ExternBind.ExternBind",
  dumpString a0,
  dumpString a1,
  dumpLoc a2,
]

dumpDecl : Decl -> SExp
dumpDecl (DTypeSig a0 a1 a2 a3) = SList [
  SAtom "ctor:Decl.DTypeSig",
  dumpBool a0,
  dumpString a1,
  dumpTy a2,
  dumpLoc a3,
]
dumpDecl (DExtern a0) = SList [SAtom "ctor:Decl.DExtern", dumpExternDecl a0]
dumpDecl (DFunDef a0 a1 a2 a3 a4 a5) = SList [
  SAtom "ctor:Decl.DFunDef",
  dumpBool a0,
  dumpString a1,
  dumpList dumpPat a2,
  dumpExpr a3,
  dumpLoc a4,
  dumpBinderId a5,
]
dumpDecl (DData { dataVis = a0, dataName = a1, dataParams = a2, dataParamKinds = a3, dataCtors = a4, dataCtorBinders = a5, dataDerives = a6, dataOrigin = a7, dataExtern = a8, dataNameLoc = a9 }) = SList
  [
    SAtom "ctor:Decl.DData",
    dumpDataVis a0,
    dumpString a1,
    dumpList dumpString a2,
    dumpList (dumpOpt dumpKindAnn) a3,
    dumpList dumpVariant a4,
    dumpList (dumpList (dumpPair dumpString dumpKindAnn)) a5,
    dumpList dumpDeriveRef a6,
    dumpTyConOrigin a7,
    dumpBool a8,
    dumpOpt dumpLoc a9,
  ]
dumpDecl (DUse a0 a1 a2) =
  SList [SAtom "ctor:Decl.DUse", dumpBool a0, dumpUsePath a1, dumpLoc a2]
dumpDecl (DEffect a0 a1 a2 a3 a4 a5) = SList [
  SAtom "ctor:Decl.DEffect",
  dumpBool a0,
  dumpString a1,
  dumpOpt dumpString a2,
  dumpList (dumpPair dumpString dumpString) a3,
  dumpTyConOrigin a4,
  dumpOpt dumpLoc a5,
]
dumpDecl (DProp a0 a1 a2 a3) = SList [
  SAtom "ctor:Decl.DProp",
  dumpBool a0,
  dumpString a1,
  dumpList dumpPropParam a2,
  dumpExpr a3,
]
dumpDecl (DTest a0 a1 a2) =
  SList [SAtom "ctor:Decl.DTest", dumpBool a0, dumpString a1, dumpExpr a2]
dumpDecl (DInterface { pub = a0, def = a1, name = a2, typarams = a3, typaramKinds = a4, supers = a5, methods = a6, ifaceOrigin = a7, ifaceNameLoc = a8 }) = SList
  [
    SAtom "ctor:Decl.DInterface",
    dumpBool a0,
    dumpBool a1,
    dumpString a2,
    dumpList dumpString a3,
    dumpList (dumpOpt dumpKindAnn) a4,
    dumpList dumpSuper a5,
    dumpList dumpIfaceMethod a6,
    dumpTyConOrigin a7,
    dumpOpt dumpLoc a8,
  ]
dumpDecl (DImpl { pub = a0, iface = a1, tys = a2, reqs = a3, methods = a4, implOrigin = a5, implIfaceLoc = a6 }) = SList
  [
    SAtom "ctor:Decl.DImpl",
    dumpBool a0,
    dumpString a1,
    dumpList dumpTy a2,
    dumpList dumpRequire a3,
    dumpList dumpImplMethod a4,
    dumpTyConOrigin a5,
    dumpOpt dumpLoc a6,
  ]
dumpDecl (DTypeAlias { tyAliasPub = a0, tyAliasName = a1, tyAliasParams = a2, tyAliasParamKinds = a3, tyAliasRhs = a4, tyAliasOrigin = a5, tyAliasNameLoc = a6 }) = SList
  [
    SAtom "ctor:Decl.DTypeAlias",
    dumpBool a0,
    dumpString a1,
    dumpList dumpString a2,
    dumpList (dumpOpt dumpKindAnn) a3,
    dumpTy a4,
    dumpTyConOrigin a5,
    dumpOpt dumpLoc a6,
  ]
dumpDecl (DNewtype { newtypePub = a0, newtypeName = a1, newtypeParams = a2, newtypeParamKinds = a3, newtypeCtor = a4, newtypeCtorBinders = a5, newtypeFieldTy = a6, newtypeDerives = a7, newtypeOrigin = a8, newtypeNameLoc = a9 }) = SList
  [
    SAtom "ctor:Decl.DNewtype",
    dumpBool a0,
    dumpString a1,
    dumpList dumpString a2,
    dumpList (dumpOpt dumpKindAnn) a3,
    dumpString a4,
    dumpList (dumpPair dumpString dumpKindAnn) a5,
    dumpTy a6,
    dumpList dumpDeriveRef a7,
    dumpTyConOrigin a8,
    dumpOpt dumpLoc a9,
  ]
dumpDecl (DLetGroup a0 a1) =
  SList [SAtom "ctor:Decl.DLetGroup", dumpBool a0, dumpList dumpLetBind a1]
dumpDecl (DAttrib a0 a1) =
  SList [SAtom "ctor:Decl.DAttrib", dumpList dumpAttr a0, dumpDecl a1]
