dumpGuardArm : GuardArm -> SExp
dumpGuardArm (GuardArm a0 a1) =
  SList [SAtom "ctor:GuardArm.GuardArm", dumpList dumpGuard a0, dumpExpr a1]

dumpFieldAssign : FieldAssign -> SExp
dumpFieldAssign (FieldAssign a0 a1) =
