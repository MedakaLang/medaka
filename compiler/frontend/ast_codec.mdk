tagTyNamed : Unit -> Int
tagTyNamed () = 7
tagTyQual : Unit -> Int
tagTyQual () = 8
tagTyRow : Unit -> Int
tagTyRow () = 9
tagTyAuth : Unit -> Int
tagTyAuth () = 10

