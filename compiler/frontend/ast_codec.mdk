tagPCon () = 3
tagPCons : Unit -> Int
tagPCons () = 4
tagPTuple : Unit -> Int
tagPTuple () = 5
tagPList : Unit -> Int
tagPList () = 6
tagPAs : Unit -> Int
tagPAs () = 7
tagPRng : Unit -> Int
tagPRng () = 8
tagPRec : Unit -> Int
