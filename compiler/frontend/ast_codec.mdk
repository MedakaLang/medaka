readEvValTagged 1 cur =
  let a0 = cursorList readRoute cur
  EvMany a0
readEvValTagged 2 cur =
  let a0 = readString cur
  let a1 = readInt cur
  let a2 = readRoute cur
  let a3 = cursorList readRoute cur
  let a4 = cursorList readRoute cur
