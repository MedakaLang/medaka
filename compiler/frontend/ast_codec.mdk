tagKindAuthority : Unit -> Int
tagKindAuthority () = 2
tagKindArrow : Unit -> Int
tagKindArrow () = 3

-- Route
tagRNone : Unit -> Int
tagRNone () = 0
tagRKey : Unit -> Int
tagRKey () = 1
tagRDict : Unit -> Int
tagRDict () = 2
tagRDictFwd : Unit -> Int
tagRDictFwd () = 3
tagRLocal : Unit -> Int
tagRLocal () = 4
tagRScalar : Unit -> Int
tagRScalar () = 5
tagRProj : Unit -> Int
tagRProj () = 6

-- EvVal
tagEvOne : Unit -> Int
tagEvOne () = 0
tagEvMany : Unit -> Int
tagEvMany () = 1
tagEvMethod : Unit -> Int
tagEvMethod () = 2
tagEvLit : Unit -> Int
tagEvLit () = 3
