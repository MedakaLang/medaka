-- Sibling test module for `compiler/frontend/resolve.mdk` ([P-TEST-SIBLING]).
--
-- #1685: `ModuleExports` carried nine export-namespace fields and only
-- seven had a `reExp<Field>From` re-export companion — the gap this sprint's
-- earlier slices closed instance by instance (`UseWild`'s missing
-- interfaces, the constructor/field re-export hop). A hand-copied roster of
-- "these nine fields need these seven companions" would have re-asserted
-- that exact fact and gone stale the same way the original count did, so
-- this test instead PARSES `resolve.mdk`'s own current source with the
-- compiler's own frontend, derives `ModuleExports`' field list and the set
-- of top-level function names from that parse, and checks the naming
-- convention generically — a tenth field added later without its
-- `reExp<Field>From` companion reds this test without anyone updating it.
--
-- `--native`: deriving the field list from the LIVE file needs `readFile`,
-- an extern the interpreter's test capability list (`testCapableExterns`,
-- `compiler/eval/eval.mdk`) deliberately excludes (file/env/stdin/net are
-- unavailable under `medaka test`'s default eval engine). Verified live: a
-- `readFile` call in a `test "…"` body fails to build under the default
-- engine and succeeds under `medaka test --native`.

import test.{expectEqual}
import frontend.parser.{parse}
import frontend.ast.{Decl(..), Variant(..), ConPayload(..), Field(..)}
import support.util.{contains, filterList}
import string.{stripPrefix}

resolveSourcePath : String
resolveSourcePath = "compiler/frontend/resolve.mdk"

-- The field names of `ModuleExports`' single record constructor, in the
-- order the `data` decl lists them.
moduleExportsFields : List Decl -> List String
moduleExportsFields [] = []
moduleExportsFields ((DData { dataName = "ModuleExports", dataCtors = ctors }) :: _) =
  flatMapVariants ctors
moduleExportsFields ((DAttrib _ d) :: rest) = moduleExportsFields (d :: rest)
moduleExportsFields (_ :: rest) = moduleExportsFields rest

flatMapVariants : List Variant -> List String
flatMapVariants [] = []
flatMapVariants ((Variant _ (ConNamed fields _)) :: rest) =
  map fieldName fields ++ flatMapVariants rest
flatMapVariants (_ :: rest) = flatMapVariants rest

fieldName : Field -> String
fieldName (Field n _) = n

-- Every top-level function name resolve.mdk defines (one entry per clause,
-- duplicates included — only membership is ever asked of this list).
topLevelFunNames : List Decl -> List String
topLevelFunNames [] = []
topLevelFunNames ((DFunDef _ n _ _) :: rest) = n :: topLevelFunNames rest
topLevelFunNames ((DAttrib _ d) :: rest) = topLevelFunNames (d :: rest)
topLevelFunNames (_ :: rest) = topLevelFunNames rest

-- `expNewtypeCtors` is the one export-namespace field with no
-- `reExp*From` companion BY DESIGN: a `newtype`'s constructor is
-- unconditionally module-private (#1311, `resolve.mdk`'s own comment on
-- `expNewtypeCtors`), so there is nothing for `export import` to re-export
-- and no companion to write.
fieldsExemptFromCompanion : List String
fieldsExemptFromCompanion = ["expNewtypeCtors"]

-- A field not prefixed `exp` (just `modId`) names no export namespace and
-- needs no companion; `stripPrefix` returning `None` skips it on its own,
-- with no name needing to be hand-listed.
requiredCompanion : String -> Option String
requiredCompanion field =
  map (suffix => "reExp" ++ suffix ++ "From") (stripPrefix "exp" field)

missingCompanion : List String -> String -> Bool
missingCompanion funNames field =
  not (contains field fieldsExemptFromCompanion)
    && (match requiredCompanion field
      Some companion => not (contains companion funNames)
      None => False)

missingCompanions : List String -> List String -> List String
missingCompanions fields funNames =
  filterList (missingCompanion funNames) fields

test "every ModuleExports export-namespace field has a reExp*From companion, derived from resolve.mdk's own source" =
  match readFile resolveSourcePath
    Err e => expectEqual "read \{resolveSourcePath}" "failed: \{e}"
    Ok src =>
      let decls = parse src
      let fields = moduleExportsFields decls
      let funNames = topLevelFunNames decls
      expectEqual [] (missingCompanions fields funNames)
