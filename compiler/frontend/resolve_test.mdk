-- Sibling test module for `compiler/frontend/resolve.mdk` ([P-TEST-SIBLING]).
--
-- #1685: `ModuleExports` carried nine export-namespace fields and only
-- seven had a re-export rule — a gap closed instance by instance
-- (`UseWild`'s missing interfaces, the constructor/field re-export hop).
-- Each field's projection, direct builder and carriage rule now live on one
-- `exp<Suffix>` → `ns<Suffix>` descriptor in `resolve.mdk`'s
-- export-namespace table. A hand-copied roster of "these nine fields need
-- these nine descriptors" would go stale the same way the original count
-- did, so this test instead parses `resolve.mdk`'s own current source with
-- the compiler's own frontend, derives `ModuleExports`' field list and the
-- set of top-level binding names from that parse, and checks the naming
-- convention generically — a tenth field added later with no descriptor
-- reds this test without anyone updating it.
--
-- `--native`: deriving the field list from the LIVE file needs `readFile`,
-- an extern the interpreter's test capability list (`testCapableExterns`,
-- `compiler/eval/eval.mdk`) deliberately excludes (file/env/stdin/net are
-- unavailable under `medaka test`'s default eval engine). Verified live: a
-- `readFile` call in a `test "…"` body fails to build under the default
-- engine and succeeds under `medaka test --native`.

import test.{expectEqual, expectTrue}
import frontend.parser.{parse}
import frontend.ast.{Decl(..), Variant(..), ConPayload(..), Field(..)}
import support.util.{contains, filterList}
import string.{stripPrefix}

resolveSourcePath : String
resolveSourcePath = "compiler/frontend/resolve.mdk"

-- The field names of `ModuleExports`' single record constructor, in the
-- order the `data` decl lists them.
moduleExportsFields : List Decl -> List String
moduleExportsFields [] = []
moduleExportsFields ((DData { dataName = "ModuleExports", dataCtors = ctors }) :: _) =
  flatMapVariants ctors
moduleExportsFields ((DAttrib _ d) :: rest) = moduleExportsFields (d :: rest)
moduleExportsFields (_ :: rest) = moduleExportsFields rest

flatMapVariants : List Variant -> List String
flatMapVariants [] = []
flatMapVariants ((Variant _ (ConNamed fields _)) :: rest) =
  map fieldName fields ++ flatMapVariants rest
flatMapVariants (_ :: rest) = flatMapVariants rest

fieldName : Field -> String
fieldName (Field n _) = n

-- Every top-level binding name resolve.mdk defines (one entry per clause,
-- duplicates included — only membership is ever asked of this list). A
-- nullary binding like `nsValues = ExpNs { … }` is a `DFunDef` with no
-- parameters, so every descriptor is in here.
topLevelFunNames : List Decl -> List String
topLevelFunNames [] = []
topLevelFunNames ((DFunDef _ n _ _) :: rest) = n :: topLevelFunNames rest
topLevelFunNames ((DAttrib _ d) :: rest) = topLevelFunNames (d :: rest)
topLevelFunNames (_ :: rest) = topLevelFunNames rest

-- A field not prefixed `exp` (just `modId`) names no export namespace and
-- needs no descriptor; `stripPrefix` returning `None` skips it on its own,
-- with no name needing to be hand-listed. There are no other exemptions:
-- every export namespace has a descriptor, `expNewtypeCtors` included —
-- its carriage rule is `noCarry`, which is how the table states that a
-- `newtype`'s module-private constructor (#1311) crosses no `export import`
-- hop.
requiredNsValue : String -> Option String
requiredNsValue field = map ("ns" ++ _) (stripPrefix "exp" field)

missingNsValue : List String -> String -> Bool
missingNsValue funNames field = match requiredNsValue field
  Some nsValue => not (contains nsValue funNames)
  None => False

missingNsValues : List String -> List String -> List String
missingNsValues fields funNames = filterList (missingNsValue funNames) fields

-- A parse that lands on the wrong file, or a `ModuleExports`/`exp*` rename
-- the parse no longer matches, makes `fields` silently `[]` — the
-- `expectEqual [] (missingNsValues ...)` below would then pass vacuously.
-- This floor keeps that failure loud: `ModuleExports` has never had fewer
-- than nine export-namespace fields.
test "the field derivation itself is non-vacuous — at least nine ModuleExports fields are found" =
  match readFile resolveSourcePath
    Err e => expectEqual "read \{resolveSourcePath}" "failed: \{e}"
    Ok src =>
      let fields = moduleExportsFields (parse src)
      expectTrue (length fields >= 9)

test "every ModuleExports export-namespace field has an ns* descriptor, derived from resolve.mdk's own source" =
  match readFile resolveSourcePath
    Err e => expectEqual "read \{resolveSourcePath}" "failed: \{e}"
    Ok src =>
      let decls = parse src
      let fields = moduleExportsFields decls
      let funNames = topLevelFunNames decls
      expectEqual [] (missingNsValues fields funNames)
