import frontend.lex_token.{Token(..), peekTok}
import frontend.lexer.{tokenizeWithOffsetPairs}
import frontend.parse_hints.{
  prescanDiagnostic, matchContinuationHint, rawLiteralAfterDot
}
import frontend.parse_diagnostic.{
  ParseDiagnosticKind(..), diagnosticCode, renderParseDiagnostic
}
import support.diag_codes.{codeText}
import support.source_index.{indexSource}
import test.{expectEqual, expectEach, expectNone}

hintSummary : String -> Option (String, String)
hintSummary src =
  let (tokens, pairs) = tokenizeWithOffsetPairs src
  let result =
    prescanDiagnostic
      (() => indexSource src)
      (arrayFromList tokens)
      (arrayFromList (map fst pairs))
      (arrayFromList (map snd pairs))
      (stringLength src)
  map (d => (codeText (diagnosticCode d), renderParseDiagnostic d)) result

test "prescan reports removed inequality" =
  expectEqual
    (Some ("P-BAD-NEQ", "unexpected `!=`; did you mean `/=`?"))
    (hintSummary "main = 1 != 2")

test "prescan accepts ordinary record names" =
  expectNone (hintSummary "record = 1")

test "match guard arrow stops brace-block hint" =
  expectNone
    (hintSummary
      """main = match Some 1
  Some n if n > 0 => R { a = n }.a
  _ => 0
""")

test "brace-block if still reports its hint" =
  expectEqual
    (Some (
      "P-BRACE-BLOCK",
      "Medaka has no `{ ... }` blocks; indent the body after `then` and `else`",
    ))
    (hintSummary "main = if True { 1 } else { 0 }")

hintTokens : List Token -> Bool
hintTokens body =
  let tokens = [TMatch] ++ body
  let offset t = match t
    TMatch => (0, 0)
    TIdent "arm" => (2, 2)
    _ => (6, 6)
  let result =
    matchContinuationHint
      (arrayFromList tokens)
      (arrayFromList (map offset tokens))
      (arrayFromList [0])
      0
      1
  isSome result

test "match evidence keeps delimiter matching and stop tokens" =
  let following = [TRParen, TDedent, TIdent "arm", TFatArrow]
  let candidate open close = [TLParen, TFatArrow, open, close] ++ following
  let rows = [
    (True, candidate TLParen TRParen),
    (True, candidate TLBracket TRBracket),
    (True, candidate TLBracketTight TRBracket),
    (True, candidate TLBrace TRBrace),
    (False, candidate TLParen TRBracket),
    (False, candidate TLBracket TRBrace),
    (False, candidate TLBracketTight TRParen),
    (False, candidate TLBrace TRParen),
    (False, candidate TLArray TRArray),
    (False, [TLParen, TFatArrow, TRArray] ++ following),
    (False, [TLParen, TFatArrow, TLexError UnterminatedString] ++ following),
    (False, [TRParen, TDedent, TIdent "arm", TFatArrow]),
    (False, [TRBracket, TDedent, TIdent "arm", TFatArrow]),
    (False, [TRBrace, TDedent, TIdent "arm", TFatArrow]),
    (False, [TLParen, TRParen, TFatArrow, TDedent, TIdent "arm", TFatArrow]),
    (False, [TLParen, TFatArrow, TEof]),
    (True, [TLParen, TIndent, TFatArrow, TDedent] ++ following),
  ]
  expectEach
    (map
      ((expected, tokens) =>
        ("delimiter", expectEqual expected (hintTokens tokens)))
      rows)

rawAfterDot : String -> Option Int
rawAfterDot src =
  let (tokens, pairs) = tokenizeWithOffsetPairs src
  let toks = arrayFromList tokens
  let offs = arrayFromList (map fst pairs)
  let dots = filter (i => peekTok toks i == TDot) [0..arrayLength toks - 1]
  match dots
    [] => None
    d :: _ => rawLiteralAfterDot src toks offs d

test "a dot glued to a raw literal reports the literal for each receiver shape" = expectEach
  [
    ("field", expectEqual (Some 4) (rawAfterDot "x = p.r\"x\"")),
    ("qualified", expectEqual (Some 4) (rawAfterDot "x = M.r\"x\"")),
    ("parenthesised", expectEqual (Some 6) (rawAfterDot "x = (e).r\"x\"")),
  ]

test "spaced, plain and longer-named literals are not glued raw literals" = expectEach
  [
    ("space", expectNone (rawAfterDot "x = p.r \"x\"")),
    ("plain string", expectNone (rawAfterDot "x = p.\"x\"")),
    ("longer field", expectNone (rawAfterDot "x = p.rx\"y\"")),
    ("no dot", expectNone (rawAfterDot "x = r\"x\"")),
    ("range", expectNone (rawAfterDot "x = [a..r\"x\"]")),
  ]
