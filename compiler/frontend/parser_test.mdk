{- | Recoverable parse failures stay unrendered until they become a
   diagnostic: the text of `unexpected X; expected Y`, the furthest-failure
   choice between two failed alternatives, and the tie rule.  Then the
   binary-operator ladder: precedence, associativity, and an operator whose
   right operand fails. -}

import frontend.ast.{Expr(..), Decl(..), Attr(..), Loc(..)}
import frontend.lexer.{Token(..), tokenizeWithOffsetPairs}
import frontend.parser.{
  PR(..),
  PFail(..),
  ParserE(..),
  Parser,
  failP,
  expectTok,
  runP,
  renderFail,
  parseResult,
  parse,
  parseLocated,
  ParseError,
  parseErrorMessage,
  parseErrorLine,
  parseErrorCol,
  prescanErrorPairs,
}
import test.{
  expectEqual, expectEach, expectAll, expectSome, expectNone, expectTrue,
  Expectation
}
import frontend.parser as P
import support.util.{joinWith}

-- The rendered message of a recoverable failure, or the marker text for any
-- other outcome so a wrong outcome shows up in the assertion's diff.
failText : PR a -> String
failText (PErr f _) = renderFail f
failText (PFatal m _) = "fatal: \{m}"
failText (POk _ _) = "ok"

failPos : PR a -> Int
failPos (PErr _ q) = q
failPos _ = -1

expectAt : Token -> List Token -> PR Unit
expectAt t toks = runP (expectTok t) (arrayFromList toks) 0

parseMsg : String -> String
parseMsg src = match parseResult src
  Err e => parseErrorMessage e
  Ok _ => "parsed"

-- Reverting to eager rendering leaves these equal; they pin the TEXT, which
-- must not move when rendering is deferred.
test "expect failure text: layout tokens" =
  expectEqual
    [
      "unexpected indentation; expected `)`",
      "unexpected end of block; expected an indented block",
      "unexpected indentation; expected the end of the block",
    ]
    [
      failText (expectAt TRParen [TIndent]),
      failText (expectAt TIndent [TDedent]),
      failText (expectAt TDedent [TIndent]),
    ]

test "expect failure text: identifier and punctuation tokens" =
  expectEqual
    [
      "unexpected `x`; expected `)`",
      "unexpected `)`; expected `(`",
      "unexpected line break; expected `]`",
    ]
    [
      failText (expectAt TRParen [TIdent "x"]),
      failText (expectAt TLParen [TRParen]),
      failText (expectAt TRBracket [TNewline]),
    ]

-- Reverting `PErr` to carry a String changes nothing visible here; the test
-- pins that the end-to-end text still comes out of `renderFail`.
test "expect failure text survives to the diagnostic" =
  expectEqual
    [
      "unexpected line break; expected `)`",
      "unexpected `=`; expected the end of the block",
    ]
    [
      parseMsg "main = (1 + 2\n",
      parseMsg "main =\n  let x = 1\n    y = 2\n  x\n",
    ]

test "renderFail of a plain message is that message" =
  expectEqual "boom" (renderFail (FailMsg "boom"))

-- `far` fails at token index 1 (after "consuming" one token), `near` at 0.
far : Parser Unit
far = ParserE (toks pos => runP (expectTok TRParen) toks (pos + 1))

near : Parser Unit
near = failP "near"

twoToks : Array Token
twoToks = arrayFromList [TIdent "y", TIdent "x"]

-- The first alternative failed further (qa > qb): its message is kept.
-- Reverting to "always the second alternative" would give "near".
test "farthest failure wins when it is the first alternative" =
  expectEqual
    ("unexpected `x`; expected `)`", 1)
    (
      failText (runP (P.orElse far near) twoToks 0),
      failPos (runP (P.orElse far near) twoToks 0),
    )

-- The second alternative failed further: it is kept.
test "farthest failure wins when it is the second alternative" =
  expectEqual
    "unexpected `x`; expected `)`"
    (failText (runP (P.orElse near far) twoToks 0))

-- Equal positions: the later alternative (`otherwise = PErr eb qb`) wins.
-- Reverting the tie to the first alternative would give "first".
test "a tie goes to the later alternative" =
  expectEqual
    "second"
    (failText (runP (P.orElse (failP "first") (failP "second")) twoToks 0))

-- ── The binary-operator ladder ──────────────────────────────────────────
-- Expected values follow the ladder `binLevelOf` encodes, which is the one the
-- combinator ladder it replaced encoded: loosest first `|>`, `>>` `<<`, `||`,
-- `&&`, comparisons, `::`, `++`, `+` `-`, `*` `/` `%`; all left-associative but
-- `::`; application binds tighter than any operator.

-- The operator skeleton of `x = <src>`'s body, fully parenthesised.
shape : Expr -> String
shape (ELoc _ e) = shape e
shape (EBinOp op l r _) = "(\{shape l} \{op} \{shape r})"
shape (EApp f a) = "(\{shape f} \{shape a})"
shape (EVar v) = v
shape (ENumLit _ _ lx) = lx
shape _ = "?"

bodyShape : String -> String
bodyShape src = match parseResult "x = \{src}\n"
  Ok [DFunDef _ _ _ e _ _] => shape e
  Ok _ => "not one definition"
  Err e => "error: \{parseErrorMessage e}"

test "each operator binds tighter than the level above it" =
  expectEqual
    [
      "(a |> (b >> c))",
      "(a >> (b || c))",
      "(a || (b && c))",
      "(a && (b == c))",
      "(a < (b :: c))",
      "(a :: (b ++ c))",
      "(a ++ (b + c))",
      "(a + (b * c))",
      "(a * (f b))",
    ]
    (map bodyShape [
      "a |> b >> c",
      "a >> b || c",
      "a || b && c",
      "a && b == c",
      "a < b :: c",
      "a :: b ++ c",
      "a ++ b + c",
      "a + b * c",
      "a * f b",
    ])

test "a looser operator after a tighter one takes the whole left side" =
  expectEqual
    [
      "((a << b) |> c)",
      "((a || b) >> c)",
      "((a && b) || c)",
      "((a /= b) && c)",
      "((a :: b) >= c)",
      "((a ++ b) :: c)",
      "((a - b) ++ c)",
      "((a % b) - c)",
    ]
    (map bodyShape [
      "a << b |> c",
      "a || b >> c",
      "a && b || c",
      "a /= b && c",
      "a :: b >= c",
      "a ++ b :: c",
      "a - b ++ c",
      "a % b - c",
    ])

test "every level is left-associative except cons" =
  expectEqual
    [
      "((a |> b) |> c)",
      "((a >> b) << c)",
      "((a || b) || c)",
      "((a && b) && c)",
      "((a < b) <= c)",
      "(a :: (b :: c))",
      "((a ++ b) ++ c)",
      "((a - b) + c)",
      "((a / b) * c)",
    ]
    (map bodyShape [
      "a |> b |> c",
      "a >> b << c",
      "a || b || c",
      "a && b && c",
      "a < b <= c",
      "a :: b :: c",
      "a ++ b ++ c",
      "a - b + c",
      "a / b * c",
    ])

-- A tight minus after a numeric head is subtraction; after any other head it
-- is a negative argument.
test "a tight minus is subtraction only after a numeric head" =
  expectEqual ["(5 - 1)", "(f -1)"] (map bodyShape ["5 -1", "f -1"])

-- The head test looks through parentheses (`(5) -1` is subtraction), and a
-- second tight negative literal is still an argument of a non-numeric head.
test "the numeric-head test sees through parens and keeps applying" =
  expectEqual ["(5 - 1)", "((f -1) -2)"] (map bodyShape ["(5) -1", "f -1 -2"])

-- A token that cannot start an argument ends the application and is left for
-- the leftover-token diagnostic.
test "an application stops at a token that cannot start an argument" =
  expectEqual
    ["unexpected `)`", "unexpected `,`", "unexpected `]`"]
    [parseMsg "x = f a )\n", parseMsg "x = f a , b\n", parseMsg "x = f a ]\n"]

-- An operator whose right operand does not parse is not consumed, so the
-- leftover-token diagnostic names that operator, at every level.
test "an operator with no right operand is left for the diagnostic" =
  expectEqual
    [
      "unexpected `+`",
      "unexpected `::`",
      "unexpected `++`",
      "unexpected `|>`",
      "unexpected `>`",
    ]
    [
      parseMsg "x = a * b +\n",
      parseMsg "x = a :: b ::\n",
      parseMsg "x = a :: b ++\n",
      parseMsg "x = a || b |>\n",
      parseMsg "x = (a > b) >\n",
    ]

-- ── fmt's parse check: prescanError vs parseResult ────────────────────────
-- `medaka fmt` runs `prescanErrorPairs` in place of the full check parse.
-- It must give the same verdict as `parseResult` on every input, and the
-- pre-scan that fires must be the one the trigger was written for.  One row
-- per pre-scan (17), plus a clean program and a record form that is not a
-- removed construct.
prescanVerdict : String -> Option (Int, Int, String)
prescanVerdict src = match tokenizeWithOffsetPairs src
  (toks, pairs) =>
    map
      (e => (parseErrorLine e, parseErrorCol e, parseErrorMessage e))
      (prescanErrorPairs src toks pairs)

parseVerdict : String -> Option (Int, Int, String)
parseVerdict src = match parseResult src
  Err e => Some (parseErrorLine e, parseErrorCol e, parseErrorMessage e)
  Ok _ => None

prescanTriggers : List (String, String)
prescanTriggers = [
  ("lexerr_unterminated_string", "main = println \"abc\n"),
  ("bangeq", "main = println (1 != 2)\n"),
  ("let_mut", "main =\n  let mut x = 1\n  println x\n"),
  ("record_decl_oneline", "record P : Int\n\nmain = println 1\n"),
  ("ctxkw_let_toplevel", "let = 5\n\nmain = println 1\n"),
  ("function_keyword", "f = function x => x\n\nmain = println 1\n"),
  (
    "inline_let_missing_in",
    "f x = if x then 1 else let y = 2 y\n\nmain = println 1\n",
  ),
  ("hs_case_of", "f x = case x of\n  1 => 2\n\nmain = println 1\n"),
  ("backtick_infix", "main = println (1 `add` 2)\n"),
  ("match_with", "f x = match x with\n  1 => 2\n\nmain = println 1\n"),
  ("let_rec_with", "f = let rec g = 1 with h = 2 in g\n\nmain = println 1\n"),
  ("block_comment", "/* hi */\n\nmain = println 1\n"),
  ("star_star", "main = println (2 ** 3)\n"),
  ("hs_sig_coloncolon", "f :: Int\n\nmain = println 1\n"),
  ("brace_block", "f x = if x { 1 } else 2\n\nmain = println 1\n"),
  ("foreign_kw_def", "def f():\n  1\n\nmain = println 1\n"),
  ("for_loop", "main =\n  for x in [1, 2]\n    println x\n"),
]

prescanParityRow : (String, String) -> (String, Expectation)
prescanParityRow (name, src) = (
  name,
  expectAll [
    expectSome (prescanVerdict src),
    expectEqual (parseVerdict src) (prescanVerdict src),
  ],
)

test "prescanError fires on each removed-construct trigger, agreeing with parseResult" =
  expectEach (map prescanParityRow prescanTriggers)

test "prescanError is silent on a clean program and on a record used as an identifier" = expectAll
  [
    expectNone (prescanVerdict "main = println 1\n"),
    expectNone (prescanVerdict "record = 3\n\nmain = println 1\n"),
  ]

-- ── declaration attributes ────────────────────────────────────────────────
-- An attribute name is one of the four the parser knows, or a located error.
-- Each outcome is rendered as text so a wrong one shows in the assertion diff.
attrText : Attr -> String
attrText (AttrDeprecated None) = "@deprecated"
attrText (AttrDeprecated (Some msg)) = "@deprecated \"\{msg}\""
attrText AttrInline = "@inline"
attrText AttrMustUse = "@must_use"
attrText AttrNoInline = "@noinline"

declAttrText : List Decl -> String
declAttrText ((DAttrib [a] _) :: _) = attrText a
declAttrText _ = "no single attribute"

attrOutcome : String -> String
attrOutcome src = match parseResult src
  Err e =>
    "error at \{parseErrorLine e}:\{parseErrorCol e}: \{parseErrorMessage e}"
  Ok ds => declAttrText ds

parsesOk : String -> Bool
parsesOk src = match parseResult src
  Ok _ => True
  Err _ => False

test "a bare @deprecated keeps its spelling as AttrDeprecated None" =
  expectEqual
    "@deprecated"
    (attrOutcome "@deprecated\nold : Int -> Int\nold x = x\n")

test "@deprecated with a message keeps the message" =
  expectEqual
    "@deprecated \"use new\""
    (attrOutcome "@deprecated \"use new\"\nold : Int -> Int\nold x = x\n")

test "the known bare attributes parse to themselves" = expectAll [
  expectEqual "@inline" (attrOutcome "@inline\nf : Int -> Int\nf x = x\n"),
  expectEqual "@must_use" (attrOutcome "@must_use\nf : Int -> Int\nf x = x\n"),
  expectEqual "@noinline" (attrOutcome "@noinline\nf : Int -> Int\nf x = x\n"),
]

test "an unknown attribute name is a located error, never @inline" =
  expectEqual
    "error at 1:0: unknown declaration attribute `@foo`; the attributes are `@deprecated \"msg\"`, `@inline`, `@must_use` and `@noinline`"
    (attrOutcome "@foo\ndouble : Int -> Int\ndouble x = x * 2\n")

test "a misspelt @deprecated is a located error that names the misspelling" =
  expectEqual
    "error at 3:0: unknown declaration attribute `@deprecatd`; the attributes are `@deprecated \"msg\"`, `@inline`, `@must_use` and `@noinline`"
    (attrOutcome
      "main = println 1\n\n@deprecatd \"use triple\"\nhalve : Int -> Int\nhalve x = x / 2\n")

test "an attribute that takes no message is an error when given one" =
  expectEqual
    "error at 1:0: `@inline` takes no message"
    (attrOutcome "@inline \"use x\"\nf : Int -> Int\nf x = x\n")

test "a second authority qualifier after a type is refused at that @" =
  expectEqual
    "error at 1:45: a type takes one authority qualifier"
    (attrOutcome "idp : (p : String) -> <FileRead p> String @p @p\nidp p = p\n")

test "a single authority qualifier before an attribute line still parses" =
  expectTrue (parsesOk "f : (p : String) -> String @p\n@inline\nf s = s\n")

-- ── extern `bind` clauses under a wrapped signature ─────────────────────────
-- The clauses of the first declaration, if it is an extern, as `host symbol`
-- pairs, plus how many declarations parsed; or the located parse error.
externBindsText : String -> String
externBindsText src = match parseResult src
  Err e =>
    "error at \{parseErrorLine e}:\{parseErrorCol e}: \{parseErrorMessage e}"
  Ok ((DExtern d) :: rest) =>
    let binds = map (b => "\{b.ebHost} \{b.ebSymbol}") d.edBinds
    "\{joinWith ", " binds}; \{intToString (1 + length rest)} decls"
  Ok _ => "the first declaration is not an extern"

test "clauses parse under a signature wrapped at any continuation column" = expectAll
  [
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n  (r : Int) ->\n  <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n    (r : Int) ->\n    <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl, js fImpl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n    (r : Int) ->\n    <FFI \"c\"> String\n  bind c \"f_impl\"\n  bind js \"fImpl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n  (r : Int) ->\n  <FFI \"c\"> String\n    bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : String ->\n  Int -> <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : String ->\n  Int ->\n    Bool ->\n      <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
  ]

test "a top-level `bind` after a wrapped extern's clauses is its own declaration" =
  expectEqual
    "c f_impl; 3 decls"
    (externBindsText
      "extern f : String ->\n  Int ->\n  <FFI \"c\"> String\n  bind c \"f_impl\"\n\nbind : Int -> Int\nbind x = x\n")

-- A non-located parse must not read the span offsets of the last located one.

locText : Expr -> String
locText (ELoc (Loc _ a b c d) _) = "\{a}:\{b}-\{c}:\{d}"
locText _ = "no loc"

bodyLocText : List Decl -> String
bodyLocText [DFunDef _ _ _ e _ _] = locText e
bodyLocText _ = "not one definition"

resultLocText : Result ParseError (List Decl) -> String
resultLocText (Ok ds) = bodyLocText ds
resultLocText (Err _) = "error"

afterLocated : String -> String
afterLocated userSrc =
  let _ = parseLocated userSrc
  bodyLocText (parse "x = y\n")

afterLocatedResult : String -> String
afterLocatedResult userSrc =
  let _ = parseLocated userSrc
  resultLocText (parseResult "x = y\n")

test "parse spans do not depend on the located parse before it" =
  expectEqual (afterLocated "longname = 1\nb = 2\n") (afterLocated "q = 0\n")

test "parseResult spans do not depend on the located parse before it" =
  expectEqual
    (afterLocatedResult "longname = 1\nb = 2\n")
    (afterLocatedResult "q = 0\n")
