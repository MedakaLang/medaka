{- | Recoverable parse failures stay unrendered until they become a
   diagnostic: the text of `unexpected X; expected Y`, the furthest-failure
   choice between two failed alternatives, and the tie rule.  Then the
   binary-operator ladder: precedence, associativity, and an operator whose
   right operand fails. -}

import frontend.ast.{
  Expr(..), Decl(..), Attr(..), Loc(..), Section(..), Pat(..), Arm(..), Lit(..),
  stripLocE
}
import frontend.lexer.{Token(..), tokenizeWithOffsetPairs}
import frontend.parse_engine.{
  PR(..),
  PFail(..),
  ParserE(..),
  Parser,
  failP,
  expectTok,
  runP,
  renderFail,
  runPWith,
}
import frontend.parser.{
  parseResult,
  parse,
  parseLocated,
  ParseError,
  parseErrorMessage,
  parseErrorLine,
  parseErrorCol,
  prescanErrorPairs,
}
import test.{
  expectEqual, expectEach, expectAll, expectSome, expectNone, expectTrue,
  expectOkThen, expectErrContains, Expectation, expectTextContainsAll
}
import frontend.parser as P
import frontend.parse_engine as E
import frontend.parse_result as R
import support.util.{joinWith}
import frontend.parse_diagnostic.{renderParseDiagnostic}
import string as S
import tools.fmt.{formatParsed, formatSource}
import tools.codemod.{codemodSource}

-- The rendered message of a recoverable failure, or the marker text for any
-- other outcome so a wrong outcome shows up in the assertion's diff.
failText : PR a -> String
failText (PErr f _) = renderFail f
failText (PFatal f _) = "fatal: \{renderFail f}"
failText (POk _ _) = "ok"

failPos : PR a -> Int
failPos (PErr _ q) = q
failPos _ = -1

expectAt : Token -> List Token -> PR Unit
expectAt t toks = runP (expectTok t) (arrayFromList toks) 0

parseMsg : String -> String
parseMsg src = match parseResult src
  Err e => parseErrorMessage e
  Ok _ => "parsed"

-- Reverting to eager rendering leaves these equal; they pin the TEXT, which
-- must not move when rendering is deferred.
test "expect failure text: layout tokens" =
  expectEqual
    [
      "unexpected indentation; expected `)`",
      "unexpected end of block; expected an indented block",
      "unexpected indentation; expected the end of the block",
    ]
    [
      failText (expectAt TRParen [TIndent]),
      failText (expectAt TIndent [TDedent]),
      failText (expectAt TDedent [TIndent]),
    ]

test "expect failure text: identifier and punctuation tokens" =
  expectEqual
    [
      "unexpected `x`; expected `)`",
      "unexpected `)`; expected `(`",
      "unexpected line break; expected `]`",
    ]
    [
      failText (expectAt TRParen [TIdent "x"]),
      failText (expectAt TLParen [TRParen]),
      failText (expectAt TRBracket [TNewline]),
    ]

-- Reverting `PErr` to carry a String changes nothing visible here; the test
-- pins that the end-to-end text still comes out of `renderFail`.
test "expect failure text survives to the diagnostic" =
  expectEqual
    [
      "unexpected end of input; expected `)`",
      "unexpected `=`; expected the end of the block",
    ]
    [
      parseMsg "main = (1 + 2\n",
      parseMsg "main =\n  let x = 1\n    y = 2\n  x\n",
    ]

test "renderFail of a plain message is that message" =
  expectEqual "boom" (renderFail (FailMsg "boom"))

-- `far` fails at token index 1 (after "consuming" one token), `near` at 0.
far : Parser Unit
far = ParserE (ctx pos => runPWith ctx (expectTok TRParen) (pos + 1))

near : Parser Unit
near = failP "near"

twoToks : Array Token
twoToks = arrayFromList [TIdent "y", TIdent "x"]

-- The first alternative failed further (qa > qb): its message is kept.
-- Reverting to "always the second alternative" would give "near".
test "farthest failure wins when it is the first alternative" =
  expectEqual
    ("unexpected `x`; expected `)`", 1)
    (
      failText (runP (E.orElse far near) twoToks 0),
      failPos (runP (E.orElse far near) twoToks 0),
    )

-- The second alternative failed further: it is kept.
test "farthest failure wins when it is the second alternative" =
  expectEqual
    "unexpected `x`; expected `)`"
    (failText (runP (E.orElse near far) twoToks 0))

-- Equal positions: the later alternative (`otherwise = PErr eb qb`) wins.
-- Reverting the tie to the first alternative would give "first".
test "a tie goes to the later alternative" =
  expectEqual
    "second"
    (failText (runP (E.orElse (failP "first") (failP "second")) twoToks 0))

-- ── The binary-operator ladder ──────────────────────────────────────────
-- Expectations follow the precedence contract in docs/spec/SYNTAX.md.

-- The operator skeleton of `x = <src>`'s body, fully parenthesised.
shape : Expr -> String
shape (ELoc _ e) = shape e
shape (EBinOp op l r _) = "(\{shape l} \{op} \{shape r})"
shape (EApp f a) = "(\{shape f} \{shape a})"
shape (EUnOp op e _) = "(\{op}\{shape e})"
shape (ESection (SecBare op)) = "(bare \{op})"
shape (ESection (SecRight op e)) = "(right \{op} \{shape e})"
shape (ESection (SecLeft e op)) = "(left \{shape e} \{op})"
shape (EVar v) = v
shape (ENumLit _ _ lx) = lx
shape _ = "?"

bodyShape : String -> String
bodyShape src = match parseResult "x = \{src}\n"
  Ok [DFunDef _ _ _ e _ _] => shape e
  Ok _ => "not one definition"
  Err e => "error: \{parseErrorMessage e}"

test "each operator binds tighter than the level above it" =
  expectEqual
    [
      "(a |> (b >> c))",
      "(a >> (b || c))",
      "(a || (b && c))",
      "(a && (b == c))",
      "(a < (b :: c))",
      "(a :: (b ++ c))",
      "(a ++ (b + c))",
      "(a + (b * c))",
      "(a * (f b))",
    ]
    (map bodyShape [
      "a |> b >> c",
      "a >> b || c",
      "a || b && c",
      "a && b == c",
      "a < b :: c",
      "a :: b ++ c",
      "a ++ b + c",
      "a + b * c",
      "a * f b",
    ])

test "a looser operator after a tighter one takes the whole left side" =
  expectEqual
    [
      "((a << b) |> c)",
      "((a || b) >> c)",
      "((a && b) || c)",
      "((a /= b) && c)",
      "((a :: b) >= c)",
      "((a ++ b) :: c)",
      "((a - b) ++ c)",
      "((a % b) - c)",
    ]
    (map bodyShape [
      "a << b |> c",
      "a || b >> c",
      "a && b || c",
      "a /= b && c",
      "a :: b >= c",
      "a ++ b :: c",
      "a - b ++ c",
      "a % b - c",
    ])

test "every level is left-associative except cons" =
  expectEqual
    [
      "((a |> b) |> c)",
      "((a >> b) << c)",
      "((a || b) || c)",
      "((a && b) && c)",
      "((a < b) <= c)",
      "(a :: (b :: c))",
      "((a ++ b) ++ c)",
      "((a - b) + c)",
      "((a / b) * c)",
    ]
    (map bodyShape [
      "a |> b |> c",
      "a >> b << c",
      "a || b || c",
      "a && b && c",
      "a < b <= c",
      "a :: b :: c",
      "a ++ b ++ c",
      "a - b + c",
      "a / b * c",
    ])

test "parentheses, application, unary and assignment group by the syntax contract" =
  expectEqual
    [
      "((a + b) * c)", "(a - (b - c))", "((f a) b)", "(-(f a))",
      "(a := (b := c))", "(a := (b + c))"
    ]
    (map bodyShape [
      "(a + b) * c", "a - (b - c)", "f a b", "-f a", "a := b := c", "a := b + c"
    ])

test "sections and parenthesized negation keep their distinct shapes" =
  expectEqual
    ["(right + 5)", "(left 2 *)", "(bare +)", "(-1)"]
    (map bodyShape ["(+ 5)", "(2 * _)", "(+)", "(- 1)"])

test "leading continuation includes arithmetic and comparison, but not tight minus" =
  expectEqual
    [
      "(1 + 2)", "(1 < 2)", "(8 - 3)",
      "error: unexpected `-`; this line is indented to column 2, which matches no enclosing block"
    ]
    (map bodyShape [
      stringSlice 0 7 """1
  + 2
""",
      stringSlice 0 7 """1
  < 2
""",
      stringSlice 0 7 """8
  - 3
""",
      stringSlice 0 6 """8
  -3
""",
    ])

-- A tight minus after a numeric head is subtraction; after any other head it
-- is a negative argument.
test "a tight minus is subtraction only after a numeric head" =
  expectEqual ["(5 - 1)", "(f -1)"] (map bodyShape ["5 -1", "f -1"])

-- The head test looks through parentheses (`(5) -1` is subtraction), and a
-- second tight negative literal is still an argument of a non-numeric head.
test "the numeric-head test sees through parens and keeps applying" =
  expectEqual ["(5 - 1)", "((f -1) -2)"] (map bodyShape ["(5) -1", "f -1 -2"])

-- A token that cannot start an argument ends the application and is left for
-- the leftover-token diagnostic.
test "an application stops at a token that cannot start an argument" =
  expectEqual
    ["unexpected `)`", "unexpected `,`", "unexpected `]`"]
    [parseMsg "x = f a )\n", parseMsg "x = f a , b\n", parseMsg "x = f a ]\n"]

test "an operator with no right operand reports the missing expression" =
  expectEqual
    [
      "expected an expression after the binary operator",
      "expected an expression after the binary operator",
      "expected an expression after the binary operator",
      "expected an expression after the binary operator",
      "expected an expression after the binary operator",
    ]
    [
      parseMsg "x = a * b +\n",
      parseMsg "x = a :: b ::\n",
      parseMsg "x = a :: b ++\n",
      parseMsg "x = a || b |>\n",
      parseMsg "x = (a > b) >\n",
    ]

test "match advice requires a parenthesized arrow island and a following arm" =
  expectEqual
    [
      "expected `=>` after the match pattern or guard",
      "expected a match arm (`pattern => body`); if this line continues the scrutinee, wrap the whole scrutinee in parentheses",
      "expected a match arm (`pattern => body`)",
    ]
    [
      parseMsg """main =
  match f x
      Some y
    _ => 0
""",
      parseMsg """main =
  match f x
      (a => a)
    _ => 0
""",
      parseMsg """main =
  match f x
      (a => a)
    k = a => a
""",
    ]

test "match advice suppresses tabs and root type arrows" =
  expectEqual
    [
      "expected a match arm (`pattern => body`)",
      "expected a match arm (`pattern => body`)",
      "expected a match arm (`pattern => body`)",
    ]
    [
      parseMsg """main =
	match f x
            (a => a)
        _ => 0
""",
      parseMsg """main =
  match f x
      (a => a)
    y : Int -> Int => 0
""",
      parseMsg
        ("-- \t\n" ++ """main =
  match f x
      (a => a)
    _ => 0
"""),
    ]

test "malformed operands retain their enclosing context" =
  expectEqual
    [
      "expected an expression after the binary operator",
      "expected a record field value after `=`",
      "expected a complete parenthesized expression",
    ]
    [
      parseMsg "main = f (1 + )\n",
      parseMsg "main = R { field = }\n",
      parseMsg "main = f (\n",
    ]

-- ── fmt's parse check: prescanError vs parseResult ────────────────────────
-- `medaka fmt` runs `prescanErrorPairs` in place of the full check parse.
-- It must give the same verdict as `parseResult` on every input, and the
-- pre-scan that fires must be the one the trigger was written for.  One row
-- per pre-scan (17), plus a clean program and a record form that is not a
-- removed construct.
prescanVerdict : String -> Option (Int, Int, String)
prescanVerdict src = match tokenizeWithOffsetPairs src
  (toks, pairs) =>
    map
      (e => (parseErrorLine e, parseErrorCol e, parseErrorMessage e))
      (prescanErrorPairs src toks pairs)

parseVerdict : String -> Option (Int, Int, String)
parseVerdict src = match parseResult src
  Err e => Some (parseErrorLine e, parseErrorCol e, parseErrorMessage e)
  Ok _ => None

test "match hint fallback retains diagnostic location" =
  expectEqual
    [
      Some (3, 12, "expected a match arm (`pattern => body`)"),
      Some (3, 6, "expected a match arm (`pattern => body`)"),
      Some (
        3,
        6,
        "expected a match arm (`pattern => body`); if this line continues the scrutinee, wrap the whole scrutinee in parentheses",
      ),
    ]
    (map parseVerdict [
      """main =
	match f x
            (a => a)
        _ => 0
""",
      """main =
  match f x
      (a => a)
    y : Int -> Int => 0
""",
      """main =
  match f x
      (a => a)
    _ => 0
""",
    ])

test "missing operand after an astral character is located at EOF" =
  expectEqual
    (Some (2, 0, "expected an expression after the binary operator"))
    (parseVerdict "main = (\"🐟\" +\n")

prescanTriggers : List (String, String)
prescanTriggers = [
  ("lexerr_unterminated_string", "main = println \"abc\n"),
  ("bangeq", "main = println (1 != 2)\n"),
  ("let_mut", "main =\n  let mut x = 1\n  println x\n"),
  ("record_decl_oneline", "record P : Int\n\nmain = println 1\n"),
  ("ctxkw_let_toplevel", "let = 5\n\nmain = println 1\n"),
  ("function_keyword", "f = function x => x\n\nmain = println 1\n"),
  (
    "inline_let_missing_in",
    "f x = if x then 1 else let y = 2 y\n\nmain = println 1\n",
  ),
  ("hs_case_of", "f x = case x of\n  1 => 2\n\nmain = println 1\n"),
  ("backtick_infix", "main = println (1 `add` 2)\n"),
  ("match_with", "f x = match x with\n  1 => 2\n\nmain = println 1\n"),
  ("let_rec_with", "f = let rec g = 1 with h = 2 in g\n\nmain = println 1\n"),
  ("block_comment", "/* hi */\n\nmain = println 1\n"),
  ("star_star", "main = println (2 ** 3)\n"),
  ("hs_sig_coloncolon", "f :: Int\n\nmain = println 1\n"),
  ("brace_block", "f x = if x { 1 } else 2\n\nmain = println 1\n"),
  ("foreign_kw_def", "def f():\n  1\n\nmain = println 1\n"),
  ("for_loop", "main =\n  for x in [1, 2]\n    println x\n"),
]

prescanParityRow : (String, String) -> (String, Expectation)
prescanParityRow (name, src) = (
  name,
  expectAll [
    expectSome (prescanVerdict src),
    expectEqual (parseVerdict src) (prescanVerdict src),
  ],
)

test "prescanError fires on each removed-construct trigger, agreeing with parseResult" =
  expectEach (map prescanParityRow prescanTriggers)

test "prescanError is silent on a clean program and on a record used as an identifier" = expectAll
  [
    expectNone (prescanVerdict "main = println 1\n"),
    expectNone (prescanVerdict "record = 3\n\nmain = println 1\n"),
  ]

-- ── declaration attributes ────────────────────────────────────────────────
-- An attribute name is one of the four the parser knows, or a located error.
-- Each outcome is rendered as text so a wrong one shows in the assertion diff.
attrText : Attr -> String
attrText (AttrDeprecated None) = "@deprecated"
attrText (AttrDeprecated (Some msg)) = "@deprecated \"\{msg}\""
attrText AttrInline = "@inline"
attrText AttrMustUse = "@must_use"
attrText AttrNoInline = "@noinline"

declAttrText : List Decl -> String
declAttrText ((DAttrib [a] _) :: _) = attrText a
declAttrText _ = "no single attribute"

attrOutcome : String -> String
attrOutcome src = match parseResult src
  Err e =>
    "error at \{parseErrorLine e}:\{parseErrorCol e}: \{parseErrorMessage e}"
  Ok ds => declAttrText ds

parsesOk : String -> Bool
parsesOk src = match parseResult src
  Ok _ => True
  Err _ => False

test "a bare @deprecated keeps its spelling as AttrDeprecated None" =
  expectEqual
    "@deprecated"
    (attrOutcome "@deprecated\nold : Int -> Int\nold x = x\n")

test "@deprecated with a message keeps the message" =
  expectEqual
    "@deprecated \"use new\""
    (attrOutcome "@deprecated \"use new\"\nold : Int -> Int\nold x = x\n")

test "the known bare attributes parse to themselves" = expectAll [
  expectEqual "@inline" (attrOutcome "@inline\nf : Int -> Int\nf x = x\n"),
  expectEqual "@must_use" (attrOutcome "@must_use\nf : Int -> Int\nf x = x\n"),
  expectEqual "@noinline" (attrOutcome "@noinline\nf : Int -> Int\nf x = x\n"),
]

test "an unknown attribute name is a located error, never @inline" =
  expectEqual
    "error at 1:0: unknown declaration attribute `@foo`; the attributes are `@deprecated \"msg\"`, `@inline`, `@must_use` and `@noinline`"
    (attrOutcome "@foo\ndouble : Int -> Int\ndouble x = x * 2\n")

test "a misspelt @deprecated is a located error that names the misspelling" =
  expectEqual
    "error at 3:0: unknown declaration attribute `@deprecatd`; the attributes are `@deprecated \"msg\"`, `@inline`, `@must_use` and `@noinline`"
    (attrOutcome
      "main = println 1\n\n@deprecatd \"use triple\"\nhalve : Int -> Int\nhalve x = x / 2\n")

test "an attribute that takes no message is an error when given one" =
  expectEqual
    "error at 1:0: `@inline` takes no message"
    (attrOutcome "@inline \"use x\"\nf : Int -> Int\nf x = x\n")

test "a second authority qualifier after a type is refused at that @" =
  expectEqual
    "error at 1:45: a type takes one authority qualifier"
    (attrOutcome "idp : (p : String) -> <FileRead p> String @p @p\nidp p = p\n")

test "a single authority qualifier before an attribute line still parses" =
  expectTrue (parsesOk "f : (p : String) -> String @p\n@inline\nf s = s\n")

-- ── extern `bind` clauses under a wrapped signature ─────────────────────────
-- The clauses of the first declaration, if it is an extern, as `host symbol`
-- pairs, plus how many declarations parsed; or the located parse error.
externBindsText : String -> String
externBindsText src = match parseResult src
  Err e =>
    "error at \{parseErrorLine e}:\{parseErrorCol e}: \{parseErrorMessage e}"
  Ok ((DExtern d) :: rest) =>
    let binds = map (b => "\{b.ebHost} \{b.ebSymbol}") d.edBinds
    "\{joinWith ", " binds}; \{intToString (1 + length rest)} decls"
  Ok _ => "the first declaration is not an extern"

test "clauses parse under a signature wrapped at any continuation column" = expectAll
  [
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n  (r : Int) ->\n  <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n    (r : Int) ->\n    <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl, js fImpl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n    (r : Int) ->\n    <FFI \"c\"> String\n  bind c \"f_impl\"\n  bind js \"fImpl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : (u : String) ->\n  (r : Int) ->\n  <FFI \"c\"> String\n    bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : String ->\n  Int -> <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
    expectEqual
      "c f_impl; 2 decls"
      (externBindsText
        "extern f : String ->\n  Int ->\n    Bool ->\n      <FFI \"c\"> String\n  bind c \"f_impl\"\n\nmain = 1\n"),
  ]

test "a top-level `bind` after a wrapped extern's clauses is its own declaration" =
  expectEqual
    "c f_impl; 3 decls"
    (externBindsText
      "extern f : String ->\n  Int ->\n  <FFI \"c\"> String\n  bind c \"f_impl\"\n\nbind : Int -> Int\nbind x = x\n")

-- A non-located parse must not read the span offsets of the last located one.

locText : Expr -> String
locText (ELoc (Loc _ a b c d) _) = "\{a}:\{b}-\{c}:\{d}"
locText _ = "no loc"

bodyLocText : List Decl -> String
bodyLocText [DFunDef _ _ _ e _ _] = locText e
bodyLocText _ = "not one definition"

resultLocText : Result ParseError (List Decl) -> String
resultLocText (Ok ds) = bodyLocText ds
resultLocText (Err _) = "error"

afterLocated : String -> String
afterLocated userSrc =
  let _ = parseLocated userSrc
  bodyLocText (parse "x = y\n")

afterLocatedResult : String -> String
afterLocatedResult userSrc =
  let _ = parseLocated userSrc
  resultLocText (parseResult "x = y\n")

test "parse spans do not depend on the located parse before it" =
  expectEqual (afterLocated "longname = 1\nb = 2\n") (afterLocated "q = 0\n")

test "parseResult spans do not depend on the located parse before it" =
  expectEqual
    (afterLocatedResult "longname = 1\nb = 2\n")
    (afterLocatedResult "q = 0\n")

locTuple : Option Loc -> Option (Int, Int, Int, Int)
locTuple loc = map ((Loc _ l c el ec) => (l, c, el, ec)) loc

test "position and immutable result projections preserve CRLF and Unicode" =
  let (decls, positions) =
    P.parseWithPositions "-- λ\r\ndata Foo = Bar | Baz\r\nx = 1\r\n"
  let metadata = R.makeParseMetadata [(2, 3)] [(3, 0, 1)]
  let result = R.makeParsedSource decls positions metadata
  expectAll [
    expectEqual 2 (length (R.parsedDecls result)),
    expectEqual
      [(2, 2), (3, 3)]
      (map
        (d => (P.declPosLine d, P.declPosEndLine d))
        (P.positionsDecls (R.parsedPositions result))),
    expectEqual
      [Some (2, 5, 2, 8), Some (3, 0, 3, 1)]
      (map (d => locTuple (P.declPosNameLoc d)) (P.positionsDecls positions)),
    expectEqual
      [[Some (2, 11, 2, 14), Some (2, 17, 2, 20)], []]
      (map
        (d => map locTuple (P.declPosChildLocs d))
        (P.positionsDecls positions)),
    expectEqual [(2, 3)] (R.metadataTrailingCommas (R.parsedMetadata result)),
    expectEqual [(3, 0, 1)] (R.metadataUnitStarts (R.parsedMetadata result)),
  ]

metadataPair : R.ParsedSource -> (List (Int, Int), List (Int, Int, Int))
metadataPair parsed =
  let m = R.parsedMetadata parsed
  (R.metadataTrailingCommas m, R.metadataUnitStarts m)

test "retained P after Q and unlocated parsing equals cold P" =
  expectOkThen
    (p =>
      let before = publishedView p
      let _ = parse "plain = [0,]\n"
      expectOkThen
        (_ =>
          expectOkThen
            (_ =>
              expectOkThen
                (cold => expectEqual (publishedView cold) before)
                (parsePublished "main = [1, 2,]\n"))
            (map
              (ds => length ds)
              (mapErr
                parseErrorMessage
                (parseResult "checked = Box { field = 7 }\n"))))
        (parsePublished "other = [9,]\n"))
    (parsePublished "main = [1, 2,]\n")

test "discarded variant update speculation contributes exactly one comma" =
  expectOkThen
    (p => expectEqual ([(1, 18)], []) (metadataPair p))
    (parsePublished "main = Box { [1, 2,] }\n")

test "discarded variant update speculation contributes exactly one field unit" =
  expectOkThen
    (p => expectEqual ([], [(4, 1, 21)]) (metadataPair p))
    (parsePublished "main = Box { Inner { field = 1 } }\n")

boundedCues : String -> ((String, Int), (List (Int, Int), List (Int, Int, Int)))
boundedCues src =
  let (ts, os) = tokenizeWithOffsetPairs src
  let ctx =
    E.newParseContextWith
      E.LocatedSyntax
      src
      (arrayFromList ts)
      (arrayFromList os)
  let r = P.parseDeclAt ctx 0
  let result = match r
    POk _ q => ("ok", q)
    PErr f q => (renderFail f, q)
    PFatal f q => ("fatal: " ++ renderFail f, q)
  (result, E.contextCues ctx)

test "raw operator RHS fallback discards cues from its failed operand" =
  let (outcome, cues) = boundedCues "main = a + Box { [1, 2,]\n"
  expectAll [expectEqual "ok" (fst outcome), expectEqual ([], []) cues]

test "a failed match arm restores its entry cues" =
  let (outcome, cues) = boundedCues "main = match x\n  [1, 2,]\n"
  expectAll [
    expectEqual
      "fatal: expected `=>` after the match pattern or guard"
      (fst outcome),
    expectEqual ([], []) cues,
  ]

test "bounded declaration failure restores entry cues" =
  let (ts, os) = tokenizeWithOffsetPairs "main = Box { [1, 2,]"
  let ctx =
    E.newParseContext
      "main = Box { [1, 2,]"
      (arrayFromList ts)
      (arrayFromList os)
  let _ = E.runPWith ctx (E.recordUnitStart 2 0) 0
  let before = E.contextCues ctx
  let _ = P.parseDeclAt ctx 0
  expectEqual before (E.contextCues ctx)

test "retained formatting uses P metadata after another parse" =
  let src = "main = [1, 2,]\n"
  expectOkThen
    (p =>
      let cold = formatParsed src p
      expectOkThen
        (_ => expectEqual cold (formatParsed src p))
        (parsePublished "other = 9\n"))
    (parsePublished src)

test "codemod formatting retains cues across a transform callback parse" =
  let src = "main = [1, 2,]\n"
  let cold = codemodSource (d => (d, True)) src
  let interleaved =
    codemodSource
      (d =>
        let _ = P.parseWithPositions "other = 9\n"
        (d, True))
      src
  expectEqual
    (mapErr parseErrorMessage cold)
    (mapErr parseErrorMessage interleaved)

test "expression, pattern and type nesting share the existing cap" =
  let deep = S.repeat 20001 "("
  let close = S.repeat 20001 ")"
  expectEach
    (map
      ((name, src) => (
        name,
        expectErrContains
          "nesting too deep"
          (map (ds => length ds) (mapErr parseErrorMessage (parseResult src))),
      ))
      [
        ("expression", "main = \{deep}1\{close}\n"),
        ("pattern", "f \{deep}x\{close} = 1\n"),
        ("type", "f : \{deep}Int\{close}\n"),
      ])

parsePublished : String -> Result String R.ParsedSource
parsePublished src = mapErr renderParseDiagnostic (P.parseSource src)

publishedView : R.ParsedSource ->
  (String, List (Int, Int, Option (Int, Int, Int, Int)), List (Int, Int), List (Int, Int, Int))
publishedView p =
  let (commas, units) = metadataPair p
  (
    bodyLocText (R.parsedDecls p),
    map
      (d =>
        (P.declPosLine d, P.declPosEndLine d, locTuple (P.declPosNameLoc d)))
      (P.positionsDecls (R.parsedPositions p)),
    commas,
    units,
  )

test "guarded match arm accepts a record body" =
  expectOkThen
    (decls => expectEqual 2 (length decls))
    (mapErr
      parseErrorMessage
      (P.parseResult
        """data R = { a : Int }
main = match Some 1
  Some n if n > 0 => R { a = n }.a
  _ => 0
"""))

-- ── or-patterns ──────────────────────────────────────────────────────────

patShape : Pat -> String
patShape (POr ps) = "(or \{joinWith " " (map patShape ps)})"
patShape (PCon c []) = c
patShape (PCon c ps) = "(\{c} \{joinWith " " (map patShape ps)})"
patShape (PVar x _ _) = x
patShape PWild = "_"
patShape (PLit (LInt n)) = intToString n
patShape (PTuple ps) = "(tuple \{joinWith " " (map patShape ps)})"
patShape (PAs x _ _ p) = "\{x}@\{patShape p}"
patShape (PCons h t) = "(\{patShape h} :: \{patShape t})"
patShape _ = "?"

armShape : Arm -> String
armShape (Arm p gs _) = match gs
  [] => patShape p
  _ => "\{patShape p} if"

declBody : String -> Result String Expr
declBody src = match parseResult src
  Ok [DFunDef _ _ _ e _ _] => Ok (stripLocE e)
  Ok _ => Err "not one definition"
  Err e => Err "error: \{parseErrorMessage e}"

matchArmShapes : String -> List String
matchArmShapes src = match declBody src
  Ok (EMatch _ arms) => map armShape arms
  Ok _ => ["not a match"]
  Err m => [m]

test "a match arm joins alternatives with a bare bar" =
  expectEqual
    ["(or 1 2)", "_"]
    (matchArmShapes """x = match n
  1 | 2 => 10
  _ => 0
""")

test "alternatives nest in parentheses, tuples and as-patterns" =
  expectEqual
    [
      "(Some (or Red Green))", "(tuple (or 1 2) _)", "q@(or 1 2)",
      "(or (A x) (B x)) if"
    ]
    (matchArmShapes
      """x = match n
  Some (Red | Green) => 1
  (1 | 2, _) => 2
  q@(1 | 2) => 3
  A x | B x if x > 0 => 4
""")

test "a nested or-pattern flattens into its parent" =
  expectEqual
    ["(or 1 2 3)"]
    (matchArmShapes """x = match n
  (1 | 2) | 3 => 1
""")

test "a bar after a parenthesized clause parameter stays a guard" =
  expectEqual "ok" (parseStatus """f (1 | 2) = 5
f n | n > 0 = 6
f _ = 0
""")

parseStatus : String -> String
parseStatus src = match parseResult src
  Ok _ => "ok"
  Err e => "error: \{parseErrorMessage e}"

test "let, lambda, do-bind and guard-bind take parenthesized alternatives" = expectEach
  [
    ("let", expectEqual "ok" (parseStatus """x =
  let (A y | B y) = t
  y
""")),
    ("lambda", expectEqual "ok" (parseStatus "x = (A y | B y) => y\n")),
    (
      "do-bind",
      expectEqual "ok" (parseStatus """x = do
  (A y | B y) <- t
  pure y
"""),
    ),
    (
      "guard-bind",
      expectEqual
        "ok"
        (parseStatus """x = match t
  _ if (A y | B y) <- u => y
"""),
    ),
  ]

test "a bar followed by a non-pattern keeps the if steer" = expectEach [
  (
    "guard",
    expectTextContainsAll
      ["guard uses `if`"]
      (parseStatus """x = match n
  m | m > 0 => 1
"""),
  ),
  (
    "trailing",
    expectTextContainsAll
      ["guard uses `if`"]
      (parseStatus """x = match n
  1 | => 1
"""),
  ),
]

test "a bar ending a line steers to parentheses and carries no if" =
  expectTextContainsAll
    ["ending a line", "(A | B | C)"]
    (parseStatus """x = match n
  K1 | K2 |
    K3 => 1
""")

test "formatting an or-pattern is stable and keeps parentheses where needed" =
  let src =
    """x = match n
  Some (Red | Green) => 1
  A x | B x => 2
  (1 | 2, q@(3 | 4)) => 3
"""
  expectAll [
    expectEqual src (formatSource src),
    expectEqual (formatSource src) (formatSource (formatSource src)),
  ]

test "formatting byte literals is canonical: printable ASCII as itself, the rest escaped" =
  let src =
    """x = [b'a', b'\\n', b'\\t', b'\\r', b'\\0', b'\\'', b'\\\\', b'\\xFF', b'\\x7F']
"""
  expectAll [
    expectEqual src (formatSource src),
    expectEqual
      src
      (formatSource
        """x = [b'\\x61', b'\\x0a', b'\\x09', b'\\x0D', b'\\x00', b'\\x27', b'\\x5C', b'\\xff', b'\\x7f']
"""),
  ]

test "formatting a byte literal in each pattern position is stable" =
  let src =
    """f x = match x
  b'a' => 1
  b'\\n' | b' ' => 2
  _ => 0

g b'a' = 1
g _ = 0
"""
  expectAll [
    expectEqual src (formatSource src),
    expectEqual (formatSource src) (formatSource (formatSource src)),
  ]

test "a byte literal range pattern parses and formats" =
  let src = """f x = match x
  b'a'..=b'z' => 3
  b'0'..b'9' => 4
  _ => 0
"""
  expectEqual src (formatSource src)

test "a range pattern mixing a byte bound with an integer or character bound is refused with one message" =
  let msg =
    "a range pattern cannot mix a byte literal bound with an integer or character bound; write both bounds as byte literals (`b'a'..=b'z'`) or neither"
  expectEqual
    (msg, msg, msg, "parsed")
    (
      parseMsg "f x = match x\n  b'a'..=122 => 1\n  _ => 0\n",
      parseMsg "f x = match x\n  48..=b'z' => 1\n  _ => 0\n",
      parseMsg "f x = match x\n  'a'..=b'z' => 1\n  _ => 0\n",
      parseMsg "f x = match x\n  b'a'..=b'z' => 1\n  _ => 0\n",
    )
