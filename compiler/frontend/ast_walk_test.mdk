-- Sibling test for frontend/ast_walk.mdk: its enumerations stay exhaustive,
-- every kind of declaration body is reached under its owner, and a span is
-- recovered for a node the parser leaves unwrapped.

import test.{expectEach, expectEqual, expectNoFindings}
import test_process.{boundedVerb, medakaBin, underRoot}
import string.{contains, lines}
import frontend.ast.{Decl(..), Expr(..), Loc(..)}
import frontend.ast_walk.{BodyOwner(..), DeclBody(..), declBodies, childExprs}
import frontend.parser.{parseLocated}

-- Exhaustiveness is a warning, so a constructor missing from one of the
-- module's enumerations shows only in `check`'s output.  A `check` that exits
-- nonzero did not judge the module and counts as not run.
test "medaka check reports no non-exhaustive clauses in ast_walk.mdk" =
  expectNoFindings
    "non-exhaustive clauses in compiler/frontend/ast_walk.mdk"
    (andThen
      (boundedVerb medakaBin [
        "check",
        underRoot "compiler/frontend/ast_walk.mdk",
      ])
      nonExhaustiveLines)

nonExhaustiveLines : (Int, String, String) -> Result String (List String)
nonExhaustiveLines (0, out, err) =
  Ok (filter (contains "non-exhaustive") (lines (out ++ err)))
nonExhaustiveLines (code, _, err) =
  Err "medaka check exited \{intToString code}: \{err}"

ownerTag : DeclBody -> String
ownerTag (DeclBody (OwnerClause n _) _) = "clause \{n}"
ownerTag (DeclBody (OwnerImplMethod i m _) _) = "method \{i}.\{m}"
ownerTag (DeclBody (OwnerIfaceDefault i m _) _) = "default \{i}.\{m}"
ownerTag (DeclBody (OwnerTest n) _) = "test \{n}"
ownerTag (DeclBody (OwnerProp n _) _) = "prop \{n}"
ownerTag (DeclBody (OwnerLetGroup n _) _) = "let-group \{n}"

bodiesSrc : String
bodiesSrc =
  """f : Int -> Int
f x = x
interface Size a where
  size : a -> Int
  size _ = 0
impl Size Bool where
  size _ = 1
let rec down n = if n == 0 then 0 else down (n - 1)
test "t" = expectEqual 1 1
prop "p" (n : Int) = n == n
"""

test "declBodies names the owner of every kind of body" =
  expectEqual
    [
      "clause f",
      "default Size.size",
      "method Size.size",
      "let-group down",
      "test t",
      "prop p",
    ]
    (map ownerTag (flatMap declBodies (parseLocated bodiesSrc)))

-- A body's start line and column and end line and column; `Loc` has no `Eq`.
data SpanPos = SpanPos {
  startLine : Int,
  startCol : Int,
  endLine : Int,
  endCol : Int,
} deriving (Eq, Debug)

bodySpans : String -> List (Option SpanPos)
bodySpans src = map bodySpan (parseLocated src)

bodySpan : Decl -> Option SpanPos
bodySpan (DFunDef _ _ _ body _ _) =
  map
    ((Loc _ sl sc el ec) =>
      SpanPos { startLine = sl, startCol = sc, endLine = el, endCol = ec })
    (exprSpan body)
bodySpan _ = None

test "exprSpan of an unwrapped node covers its leftmost and rightmost leaves" = expectEach
  [
    (
      "application",
      expectEqual
        [Some SpanPos { startLine = 1, startCol = 4, endLine = 1, endCol = 13 }]
        (bodySpans "f = g 1 (h 2)"),
    ),
    (
      "operator",
      expectEqual
        [Some SpanPos { startLine = 1, startCol = 4, endLine = 1, endCol = 9 }]
        (bodySpans "f = a + b"),
    ),
  ]

-- A node's source span: its own `ELoc` span, or else the span from the
-- earliest start to the latest end among the `ELoc`s nearest its leaves.  The
-- parser leaves application and operator nodes unwrapped, so this is how their
-- extent is recovered.  `None` for a tree with no `ELoc` at all.
exprSpan : Expr -> Option Loc
exprSpan e = match nodeLoc e
  Some l => Some l
  None => fold joinSpan None (map exprSpan (childExprs e))

-- The span of a node's own `ELoc` wrapper, if it is one.
nodeLoc : Expr -> Option Loc
nodeLoc (ELit _) = None
nodeLoc (EVar _) = None
nodeLoc (EApp _ _) = None
nodeLoc (ELam _ _) = None
nodeLoc (ELet _ _ _ _ _) = None
nodeLoc (EMatch _ _) = None
nodeLoc (EIf _ _ _) = None
nodeLoc (EBinOp _ _ _ _) = None
nodeLoc (EUnOp _ _ _) = None
nodeLoc (EInfix _ _ _) = None
nodeLoc (EFieldAccess _ _ _) = None
nodeLoc (ETuple _) = None
nodeLoc (EListLit _) = None
nodeLoc (EArrayLit _) = None
nodeLoc (ERangeList _ _ _) = None
nodeLoc (ERangeArray _ _ _) = None
nodeLoc (ESlice _ _ _ _) = None
nodeLoc (ELetGroup _ _) = None
nodeLoc (ESection _) = None
nodeLoc (EIndex _ _) = None
nodeLoc (EAnnot _ _) = None
nodeLoc (EHeadAnnot _ _) = None
nodeLoc (EBlock _) = None
nodeLoc (EDo _ _) = None
nodeLoc (EStringInterp _) = None
nodeLoc (EGuards _) = None
nodeLoc (ERecordCreate _ _) = None
nodeLoc (ERecordUpdate _ _ _) = None
nodeLoc (EVariantUpdate _ _ _) = None
nodeLoc (EMapLit _ _) = None
nodeLoc (ESetLit _ _) = None
nodeLoc (EAsPat _ _) = None
nodeLoc (EOrPat _) = None
nodeLoc (EMethodRef _) = None
nodeLoc (EDictApp _) = None
nodeLoc (EVarAt _ _) = None
nodeLoc (EVarId _ _) = None
nodeLoc (EMethodAt _ _ _) = None
nodeLoc (EDictAt _ _) = None
nodeLoc (ELoc l _) = Some l
nodeLoc (EDoOrigin _ _) = None
nodeLoc (ENumLit _ _ _) = None
nodeLoc (EWideLit _ _ _ _) = None

joinSpan : Option Loc -> Option Loc -> Option Loc
joinSpan None b = b
joinSpan a None = a
joinSpan (Some (Loc f sl sc el ec)) (Some (Loc _ sl2 sc2 el2 ec2)) =
  let (l1, c1) = min (sl, sc) (sl2, sc2)
  let (l2, c2) = max (el, ec) (el2, ec2)
  Some (Loc f l1 c1 l2 c2)
