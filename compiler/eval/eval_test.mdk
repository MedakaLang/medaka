-- Sibling tests for the evaluator's method-dispatch tables.

import test.{expectAll, expectEqual}
import frontend.ast.{
  noBinderId,
  Lit(..),
  Pat(..),
  Expr(..),
  Ty(..),
  TyConOrigin(..),
  UsePath(..),
  ImplMethod(..),
  Decl(..),
  ExternDecl(..),
  Loc(..),
}
import types.route_key.{implRouteKeyWord}
import eval.eval.{
  buildMethodReqCounts,
  Value(..),
  evalModulesOutput,
  ppValue,
  externBindings,
  ioExternBindings,
}
import list.{lookup}
import ir.core_ir_eval.{cevalModulesOutput}

testLoc : Loc
testLoc = Loc "" 1 0 1 0

boxTy : Ty
boxTy =
  TyApp
    TyCon {
      tyConName = "Box",
      tyConLoc = None,
      tyConOrigin = OriginModule "fixture",
    }
    (TyVar "a")

methodWithDicts : String -> Int -> ImplMethod
methodWithDicts name count =
  ImplMethod name (dictPats count ++ [PVar "n" testLoc noBinderId]) (ELit LUnit)

dictPats : Int -> List Pat
dictPats count
  | count <= 0 = []
  | otherwise =
    PVar ("$dict_fromInt_" ++ intToString (count - 1)) testLoc noBinderId
      :: dictPats (count - 1)

implDecl : String -> TyConOrigin -> Int -> Decl
implDecl iface origin count = DImpl {
  pub = False,
  iface = iface,
  tys = [boxTy],
  reqs = [],
  methods = [methodWithDicts "fromInt" count],
  implOrigin = origin,
  implIfaceLoc = None,
}

lookupCount : (String, String) -> List ((String, String), Int) -> Option Int
lookupCount _ [] = None
lookupCount wanted ((key, count) :: rest)
  | wanted == key = Some count
  | otherwise = lookupCount wanted rest

test "method requires counts are keyed by the canonical route word only" =
  let numOrigin = OriginModule "core"
  let forgeOrigin = OriginModule "fixture"
  let counts = buildMethodReqCounts None [
    implDecl "Num" numOrigin 1,
    implDecl "Forge" forgeOrigin 2,
  ]
  let numKey = implRouteKeyWord numOrigin "Num" [boxTy] None
  let forgeKey = implRouteKeyWord forgeOrigin "Forge" [boxTy] None
  expectAll
    [
      -- A dictionary word names one instance row, so the type's bare word
      -- answers nothing: two interfaces' rows at one head stay apart.
      expectEqual None (lookupCount ("fromInt", "fixture.Box") counts),
      expectEqual (Some 1) (lookupCount ("fromInt", numKey) counts),
      expectEqual (Some 2) (lookupCount ("fromInt", forgeKey) counts),
      expectEqual None (lookupCount ("missing", numKey) counts),
    ]

-- The REPL printer parenthesizes nested payloads the way `Debug`/`Display`
-- do: negatives, constructor applications and records get parens, tuples and
-- lists keep their own brackets.
test "ppValue parenthesizes nested negative and compound payloads" = expectAll [
  expectEqual "Some (-3)" (ppValue (VCon "Some" [VInt (-3)])),
  expectEqual "Some (-1.5)" (ppValue (VCon "Some" [VFloat (-1.5)])),
  expectEqual "Some 3" (ppValue (VCon "Some" [VInt 3])),
  expectEqual "Ok (Some (-2))" (ppValue (VCon "Ok" [VCon "Some" [VInt (-2)]])),
  expectEqual
    "[Some (-1), None]"
    (ppValue (VList [VCon "Some" [VInt (-1)], VCon "None" []])),
  expectEqual "Some (1, 2)" (ppValue (VCon "Some" [VTuple [VInt 1, VInt 2]])),
  expectEqual "Some [1, 2]" (ppValue (VCon "Some" [VList [VInt 1, VInt 2]])),
]

mkExtern : Bool -> String -> Ty -> Decl
mkExtern pub n ty = DExtern ExternDecl {
  edPub = pub,
  edName = n,
  edTy = ty,
  edLoc = Loc "<test>" 1 1 1 1,
  edBinds = [],
}

runtimeAliasModules : List (String, List Decl)
runtimeAliasModules = [
  ("runtime", [mkExtern True "Ref" (TyVar "a")]),
  (
    "root",
    [
      DUse False (UseAlias ["runtime"] "R") testLoc,
      DFunDef
        False
        "main"
        []
        (EApp (EVar "R.Ref") (ELit LUnit))
        testLoc
        noBinderId,
    ],
  ),
]

test "public runtime extern aliases share their primitive cell in both evaluators" = expectAll
  [
    expectEqual "" (evalModulesOutput [] runtimeAliasModules),
    expectEqual "" (cevalModulesOutput [] runtimeAliasModules),
  ]

applyPrim : Value <IO> -> Value <IO> -> <IO> Value <IO>
applyPrim (VPrim f) v = f v
applyPrim other _ = other

bindingOf : String -> List (String, Value <IO>) -> Value <IO>
bindingOf name binds = match lookup name binds
  Some v => v
  None => VUnit

-- `medaka run` draws from its own stream, so seeding or drawing it never moves
-- the differential oracle's state, and a given seed gives the same draws in both.
test "run's random externs use a stream separate from the oracle's" =
  let oracle = externBindings ()
  let run = ioExternBindings ()
  let draw =
    binds =>
      applyPrim
        (applyPrim (bindingOf "randomInt" binds) (VInt 0))
        (VInt 1000000000)
  let seed = binds => applyPrim (bindingOf "setSeed" binds) (VInt 42)
  let state = binds => applyPrim (bindingOf "randomState" binds) VUnit
  let _ = seed run
  let fromRun = draw run
  let oracleState = state oracle
  let _ = seed oracle
  let fromOracle = draw oracle
  expectAll [
    expectEqual "0" (ppValue oracleState),
    expectEqual (ppValue fromRun) (ppValue fromOracle),
    expectEqual "75817894" (ppValue fromOracle),
  ]
