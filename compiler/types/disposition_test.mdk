-- Sibling test module for `compiler/types/disposition.mdk`. See
-- `registry_test.mdk`'s own header for why a `*_test.mdk` sibling exists at
-- all: excluded from both build fingerprints and the snapshot corpus, so this
-- file never makes `./medaka` warn stale and never owes a golden.
--
-- The producer (`buildDispositions`, `types/typecheck.mdk`) is exercised end
-- to end in `typecheck_test.mdk` against real compiled programs; what lives
-- here is the carrier's own logic in isolation — the map index, the
-- duplicate-detection fold, and the validator — none of which needs a
-- typechecked program to exercise.
--
-- Comparisons render the looked-up row to a string (`rowLabel`) rather than
-- `expectEqual` on a `MethodDisposition`/`Option MethodDisposition` value:
-- neither `IfaceRef` nor `MethodDisposition` derives `Eq`/`Debug`, and adding
-- either only for this file would be exactly the kind of instance a real
-- reader (`types.repr`'s own callers) never asked for.
import test.{Expectation, expectEqual, expectAll}
import frontend.ast.{TyConOrigin(..)}
import types.repr.{IfaceRef(..)}
import support.ordmap.{omEmpty}
import types.disposition.{
  DispositionTable(..),
  InstId(..),
  MethodDisposition(..),
  insertDispositions,
  dispositionKey,
  dispositionLookup,
  dispositionRows,
  emptyDispositionTable,
  dispositionProblems,
}

-- Fold [rows] into the table's map index, panicking on the first duplicate
-- (instance, method) key: two rows publishing the same slot is a producer bug,
-- never a case with a policy, so `dispositionLookup` must answer with exactly
-- one row or none.
buildDispositionTable : List MethodDisposition -> DispositionTable
buildDispositionTable rows = DispositionTable {
  dtRows = rows,
  dtIndex = insertDispositions rows omEmpty,
  dtInheritors = omEmpty,
  dtIfaceSuperCounts = omEmpty,
}

speakIface : IfaceRef
speakIface = IfaceRef { irName = "Speak", irOrigin = OriginModule "ifa" }

greetIface : IfaceRef
greetIface = IfaceRef { irName = "Greet", irOrigin = OriginModule "ifb" }

dogInst : InstId
dogInst = InstId "ca" 0

catInst : InstId
catInst = InstId "cb" 1

-- The row a lookup found, as its kind and key; `none` when there is no row.
rowLabel : Option MethodDisposition -> String
rowLabel None = "none"
rowLabel (Some (Supplied { instance = i, method = m })) =
  "supplied " ++ dispositionKey i m
rowLabel (Some (InheritedDefault { instance = i, method = m })) =
  "inherited " ++ dispositionKey i m

expectNoneRow : Option MethodDisposition -> Expectation
expectNoneRow o = expectEqual "none" (rowLabel o)

expectSuppliedFor : InstId -> String -> Option MethodDisposition -> Expectation
expectSuppliedFor wantInst wantMethod o =
  expectEqual ("supplied " ++ dispositionKey wantInst wantMethod) (rowLabel o)

expectInheritedDefaultFor : InstId ->
  String ->
  Option MethodDisposition ->
  Expectation
expectInheritedDefaultFor wantInst wantMethod o =
  expectEqual ("inherited " ++ dispositionKey wantInst wantMethod) (rowLabel o)

test "dispositionKey renders instance identity and method as one string" =
  expectEqual "ca#0@speak" (dispositionKey dogInst "speak")

test "an empty table answers every lookup with None" =
  expectNoneRow (dispositionLookup dogInst "speak" emptyDispositionTable)

test "buildDispositionTable answers a supplied row by exact key" =
  let table = buildDispositionTable [
    Supplied { instance = dogInst, iface = speakIface, method = "speak" },
  ]
  expectSuppliedFor dogInst "speak" (dispositionLookup dogInst "speak" table)

-- The shape: the SAME method spelling, inherited on the SAME underlying
-- type, but under two impls of two differently-named interfaces — two
-- separate instance identities (separate `impl` declarations), so the table
-- must keep both rows distinct rather than collapsing them onto one
-- (method, tag)-shaped key.
test "two same-named methods of two different interfaces stay distinct rows" =
  let table = buildDispositionTable [
    InheritedDefault {
      instance = dogInst,
      iface = speakIface,
      method = "speak",
    },
    InheritedDefault {
      instance = catInst,
      iface = greetIface,
      method = "speak",
    },
  ]
  expectAll [
    expectInheritedDefaultFor
      dogInst
      "speak"
      (dispositionLookup dogInst "speak" table),
    expectInheritedDefaultFor
      catInst
      "speak"
      (dispositionLookup catInst "speak" table),
    expectEqual 2 (length (dispositionRows table)),
  ]

test "an exact table has no disposition problems" =
  let table = buildDispositionTable [
    Supplied { instance = dogInst, iface = speakIface, method = "speak" },
  ]
  expectEqual [] (dispositionProblems [(dogInst, speakIface, "speak")] table)

test "a dropped slot is a disposition problem" =
  let table = buildDispositionTable [
    Supplied { instance = dogInst, iface = speakIface, method = "speak" },
  ]
  expectEqual
    1
    (length
      (dispositionProblems
        [(dogInst, speakIface, "speak"), (catInst, speakIface, "speak")]
        table))
