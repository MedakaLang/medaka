-- Tests of `types.tc_solve`'s own API: the goal-kind tags and names, the interface-reference
-- mints, the per-function site index, the small id and name
-- projections, the enclosing-variable and return-position projections, the method-slot
-- projections, the dispatch-mono walk of a declared type against an occurrence
-- (`walkGoalFollowed`), the numeric return route (`numericReturnRoute`), the
-- obligation arguments (`uOblArgs`) and the commits filed again under the variable that
-- now heads their goal (`refileDeterminedRows`).  Each test builds its
-- inputs from the parsed signature, a fresh walk or a hand-built slot.  What a whole check
-- resolves for a return-position method, the method-return trace and memo, the drain's live
-- spans and the route stamps are observed through `types.typecheck` in `typecheck_test`.

import test.{
  Expectation, expectAll, expectEach, expectEqual, expectFalse, expectTrue
}
import frontend.ast.{Loc(..), Route(..)}
import frontend.parser.{parse}
import types.effect_rows.{EffRow(..), pureRow}
import types.repr.{Mono(..), Tyvar(..), normalize, ppMono}
import types.tc_types.{
  GoalKind(..), ImplRow(..), InstRef(..), MethodPredicateSlot(..),
  ModuleCtx(..), PredicateSlot(..), PredicateSlotArgs(..)
}
import types.tc_unify.{freshEffvar, freshVar, unify}
import types.tc_mono.{monoVecSameGiven, tyvarId}
import map as IdMap
import types.tc_state.{initialModuleCtx, probeGraphCtx}
import support.ordmap.{OrdMap, omEmpty, omInsert, omKeys}
import support.util.{joinNl, listLen}
import types.tc_solve.{
  collectByParam,
  consSiteFn,
  enclosingVarIds,
  goalKindName,
  goalKindTag,
  goalVarsAllHeld,
  ifaceRefBare,
  ifaceRefNone,
  isLocalAbsName,
  localSourceName,
  methodSlotArgumentIds,
  methodSlotBoundIds,
  methodSlotIdsAtPositions,
  methodSlotPositions,
  noteWalkGoalDischarged,
  noteWalkGoalFollowed,
  numericReturnRoute,
  refileDeterminedRows,
  uOblArgs,
  walkGoalFollowed,
  occurrenceDispatchMonos,
  outerRigidIds,
  predicateSlotKnownArgs,
  returnPosMethodNames,
  routeLocalSym,
  sitesFor,
  walkDispatch,
  walkGoalDischarged,
  walkGoalSame,
}
import types.tc_solve_entail.{reqWalkSeed}
import list.{nub, sort}
import types.tc_mono.{tconBuiltin}
import types.tc_test_support.{
  boolM, fresh, ifaceOf, intM, oblOver, sigsOf, varM
}
import types.tc_types.{
  GivenProvenance(..), GivenMatch(..), GivenScope(..), AssumAnswer(..)
}
import types.evidence.{SolverEvidence(..)}
import types.scopes as Scopes
import types.scopes.{ScopeOwner(..)}
import frontend.ast.{TyConOrigin(..)}
import types.repr.{IfaceRef(..)}
import types.tc_types.{PredicateRequest(..)}
import types.tc_solve_givens.{
  anyGivenMatches, firstPredForEncl, firstPredForEnclAt,
  firstPredForEnclResidual, givensForScope, pushGiven
}
import types.tc_state.{currentScopeStore}

-- `monoVecSameGiven` equates two arrows that differ only in their effect rows; the
-- solving walks' memo must not, in either order.
test "the solving-walk memo keeps goals that differ only in an effect row apart" =
  expectEqual [True, True, False, False, True] (walkGoalSameProbe ())

allKinds : List GoalKind
allKinds = [
  GKReturnSite,
  GKArgStamp,
  GKRLocalSite,
  GKBinopSite,
  GKUnopSite,
  GKArithSite,
  GKDictApp,
  GKMethodDict,
  GKRecDictApp,
]

test "every goal kind has its own tag" =
  expectEqual (length allKinds) (length (nub (map goalKindTag allKinds)))

test "a goal kind's name is its constructor's spelling" = expectEach [
  ("return", expectEqual "GKReturnSite" (goalKindName GKReturnSite)),
  ("arg", expectEqual "GKArgStamp" (goalKindName GKArgStamp)),
  ("rlocal", expectEqual "GKRLocalSite" (goalKindName GKRLocalSite)),
  ("binop", expectEqual "GKBinopSite" (goalKindName GKBinopSite)),
  ("unop", expectEqual "GKUnopSite" (goalKindName GKUnopSite)),
  ("arith", expectEqual "GKArithSite" (goalKindName GKArithSite)),
  ("dictapp", expectEqual "GKDictApp" (goalKindName GKDictApp)),
  ("methoddict", expectEqual "GKMethodDict" (goalKindName GKMethodDict)),
  ("recdictapp", expectEqual "GKRecDictApp" (goalKindName GKRecDictApp)),
]

-- ── interface references and the site index ───────────────────────────────

test "ifaceRefBare carries the spelling it is given and ifaceRefNone carries none" = expectAll
  [
    expectEqual "Sz" (ifaceRefBare "Sz").irName,
    expectEqual "" ifaceRefNone.irName,
  ]

test "sitesFor reads the sites recorded for a function, most recent first, and none for another" =
  let idx = consSiteFn "g" 3 (consSiteFn "f" 2 (consSiteFn "f" 1 omEmpty))
  expectAll [
    expectEqual [2, 1] (sitesFor "f" idx),
    expectEqual [3] (sitesFor "g" idx),
    expectEqual [] (sitesFor "h" idx),
    expectEqual ["f", "g"] (omKeys idx),
  ]

-- ── routes and stamps ─────────────────────────────────────────────────────

test "routeLocalSym reads the mangled symbol of a local route and is empty for any other" = expectAll
  [
    expectEqual "f$m" (routeLocalSym (RLocal "f$m" [])),
    expectEqual "" (routeLocalSym RNone),
    expectEqual "" (routeLocalSym (RDict "d")),
  ]

-- ── small projections ─────────────────────────────────────────────────────

test "a local abstraction's name ends in the local suffix and reads back as its source name" = expectAll
  [
    expectTrue (isLocalAbsName "f$m$3$lb"),
    expectFalse (isLocalAbsName "f"),
    expectEqual "f" (localSourceName "f$m$3$lb"),
    expectEqual "f" (localSourceName "f"),
  ]

test "predicateSlotKnownArgs is the known vector and empty for an unknown one" = expectAll
  [
    expectEqual
      ["Int", "Bool"]
      (map ppMono (predicateSlotKnownArgs (PSArgsKnown [intM, boolM]))),
    expectEqual [] (map ppMono (predicateSlotKnownArgs PSArgsUnknown)),
  ]

varAtLevel : Int -> Int -> Mono
varAtLevel id level = TVar (Ref (Unbound id level))

test "the variables an enclosing binder owns are those below its level" =
  let args = [varAtLevel 3 1, varAtLevel 4 5, tconBuiltin "Int"]
  expectAll [
    expectEqual [3] (enclosingVarIds (Some 2) args),
    expectEqual [3, 4] (enclosingVarIds (Some 6) args),
    expectEqual [] (enclosingVarIds (Some 0) args),
    expectEqual [] (enclosingVarIds None args),
  ]

test "outerRigidIds adds the enclosing variables to the base set and keeps what was there" =
  let base = omInsert "99" () omEmpty
  let args = [varAtLevel 3 1, varAtLevel 4 5]
  expectAll [
    expectEqual ["3", "99"] (sortedKeys (outerRigidIds (Some 2) args base)),
    expectEqual ["99"] (sortedKeys (outerRigidIds None args base)),
  ]

sortedKeys : OrdMap Unit -> List String
sortedKeys m = sort (omKeys m)

test "a method is return-position when its interface parameter occurs only in its result" =
  expectEqual
    ["make"]
    (returnPosMethodNames
      (parse
        (joinNl [
          "interface Make a where",
          "  make : Unit -> a",
          "  size : a -> Int",
        ])))

-- ── method slots ──────────────────────────────────────────────────────────

-- A method slot for interface [name] over [args], bound to [ids] and read at [positions].
methodSlot : String ->
  PredicateSlotArgs ->
  List Int ->
  List Int ->
  MethodPredicateSlot
methodSlot name args ids positions = MethodPredicateSlot {
  mpsPredicate = PredicateSlot {
    psIface = ifaceOf name,
    psArgs = args,
    psBoundIds = ids,
  },
  mpsPositions = positions,
}

methodSlots : List MethodPredicateSlot
methodSlots = [
  methodSlot "A" (PSArgsKnown [varM 3]) [3] [0],
  methodSlot "B" (PSArgsKnown [varM 4, varM 5]) [4, 5] [0, 1],
]

test "a method slot's bound ids and positions are read slot by slot" = expectAll
  [
    expectEqual [[3], [4, 5]] (methodSlotBoundIds methodSlots),
    expectEqual [[0], [0, 1]] (methodSlotPositions methodSlots),
    expectEqual [] (methodSlotBoundIds []),
  ]

test "a method slot's argument ids are the variables of its known vector, none for an unknown one" = expectAll
  [
    expectEqual [[3], [4, 5]] (methodSlotArgumentIds methodSlots),
    expectEqual
      [[]]
      (methodSlotArgumentIds [methodSlot "A" PSArgsUnknown [3] [0]]),
    expectEqual
      [[2, 7]]
      (methodSlotArgumentIds [
        methodSlot "A" (PSArgsKnown [TApp (varM 2) (varM 7), intM]) [2] [0],
      ]),
  ]

test "the ids at a slot's positions are read from the id list, and minus one past its end" =
  expectEqual
    [[10, 30], [20, 0 - 1]]
    (methodSlotIdsAtPositions
      [10, 20, 30]
      [
        methodSlot "A" PSArgsUnknown [] [0, 2],
        methodSlot "B" PSArgsUnknown [] [1, 5],
      ])

-- ── goals and dispatch monos ──────────────────────────────────────────────

test "a goal's variables are all held when every one is in the rigid set" =
  let rigid = omInsert "3" () (omInsert "4" () omEmpty)
  expectEach [
    (
      "all held",
      expectTrue (goalVarsAllHeld rigid [varM 3, TApp intM (varM 4)]),
    ),
    ("one free", expectFalse (goalVarsAllHeld rigid [varM 3, varM 5])),
    ("ground", expectTrue (goalVarsAllHeld rigid [intM])),
    ("no goal", expectTrue (goalVarsAllHeld rigid [])),
  ]

test "collectByParam gives one mono per parameter in declaration order, and none when one has no binding" = expectAll
  [
    expectEqual
      ["Int", "Bool"]
      (map ppMono (collectByParam ["a", "b"] [("b", boolM), ("a", intM)])),
    expectEqual [] (map ppMono (collectByParam ["a", "b"] [("a", intM)])),
    expectEqual [] (map ppMono (collectByParam ["a"] [])),
  ]

-- The (parameter, type) bindings of [src]'s signature walked against [occurrence].
walked : List String -> String -> Mono -> List (List (String, String))
walked params src occurrence =
  map
    (t => map (p => (fst p, ppMono (snd p))) (walkDispatch params t occurrence))
    (sigsOf (parse src))

test "walkDispatch binds the interface parameter wherever the declared type has it" =
  let occurrence = TFun boolM pureRow (TApp intM boolM)
  expectAll [
    expectEqual [[("a", "Bool")]] (walked ["a"] "x : a -> Box b" occurrence),
    expectEqual [[]] (walked ["z"] "x : a -> Int" occurrence),
    expectEqual [[]] (walked ["a"] "x : a -> Int" intM),
  ]

test "an occurrence's dispatch monos keep every interface position, an omitted one read from the occurrence" =
  let occurrence = TFun boolM pureRow intM
  expectEqual
    [["Bool", "Int"]]
    (map
      (t =>
        map
          ppMono
          (occurrenceDispatchMonos ["a", "b"] t occurrence [("b", intM)]))
      (sigsOf (parse "x : a -> Int")))

test "a walk has discharged the goal it noted, under the same interface and arguments only" =
  let walk = reqWalkSeed (ifaceOf "A") [intM]
  let before = walkGoalDischarged walk (ifaceOf "A") [intM]
  noteWalkGoalDischarged walk (ifaceOf "A") [intM]
  expectEach [
    ("before noting", expectFalse before),
    (
      "the same goal",
      expectTrue (walkGoalDischarged walk (ifaceOf "A") [intM]),
    ),
    (
      "another interface",
      expectFalse (walkGoalDischarged walk (ifaceOf "B") [intM]),
    ),
    (
      "other arguments",
      expectFalse (walkGoalDischarged walk (ifaceOf "A") [boolM]),
    ),
  ]

test "a numeric return's selected word takes the element routes it is given and any other route is kept" = expectAll
  [
    expectEqual
      "key:W"
      (routeKeyOf (numericReturnRoute (RKey "W" [] []) [RDict "e"])),
    expectEqual
      ["dict:e"]
      (routeDictsOf (numericReturnRoute (RKey "W" [] []) [RDict "e"])),
    expectEqual
      "dict:d"
      (routeKeyOf (numericReturnRoute (RDict "d") [RDict "e"])),
  ]

-- The head of a route as text: `key:` and its word for an instance, `dict:` and its name for a
-- dictionary, `other` for the rest.
routeKeyOf : Route -> String
routeKeyOf (RKey word _ _) = "key:\{word}"
routeKeyOf (RDict d) = "dict:\{d}"
routeKeyOf _ = "other"

-- The element routes an instance route carries, each by its head.
routeDictsOf : Route -> List String
routeDictsOf (RKey _ reqs _) = map routeKeyOf reqs
routeDictsOf _ = []

test "a walk has followed the goal it noted, under the same interface and arguments only" =
  let walk = reqWalkSeed (ifaceOf "A") [intM]
  let before = walkGoalFollowed walk (ifaceOf "A") [intM]
  noteWalkGoalFollowed walk (ifaceOf "A") [intM]
  expectEach [
    ("before noting", expectFalse before),
    (
      "the same goal",
      expectTrue (walkGoalFollowed walk (ifaceOf "A") [intM]),
    ),
    (
      "another interface",
      expectFalse (walkGoalFollowed walk (ifaceOf "B") [intM]),
    ),
    (
      "other arguments",
      expectFalse (walkGoalFollowed walk (ifaceOf "A") [boolM]),
    ),
  ]

test "the arguments of a projected obligation are the ones it was built over" =
  expectEqual
    ["Int", "Bool"]
    (map
      ppMono
      (uOblArgs (probeGraphCtx ()) (oblOver (ifaceOf "A") [intM, boolM])))

-- ── refileDeterminedRows ──────────────────────────────────────────────────

-- A commit's instance row; the tests tell commits apart by the goal arguments filed with it.
commitRow : ImplRow
commitRow = ImplRow 0 (InstRef "probe" 0 0) (ifaceOf "A") [] [] [] None

-- The variable ids the table of determined rows is keyed by, ascending.
filedUnder : ModuleCtx -> List Int
filedUnder m = sort (IdMap.keys m.mcCells.determinedRowsRef.value)

-- The id `idOf` answers for a mono that is not a variable; no variable has it.
notAVariable : Int
notAVariable = 0 - 1

-- The id of the variable [t] is, read through any link.
idOf : Mono -> Int
idOf t = match normalize t
  TVar cell => tyvarId cell
  _ => notAVariable

-- [a] and [b] fresh variables, one commit filed under [a] with the goal argument [a].
filedUnderA : Unit -> (ModuleCtx, Mono, Mono)
filedUnderA _ =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  m.mcCells.determinedRowsRef := IdMap.set (idOf a) [(commitRow, [a])] IdMap.Tip
  (m, a, b)

test "a commit filed under a variable stays under it while that variable still heads its goal" =
  let (m, a, _) = filedUnderA ()
  refileDeterminedRows m ()
  expectEqual [idOf a] (filedUnder m)

-- The commit of `filedUnderA` after [joinVars] unified the goal variable with another, refiled:
-- it is under the representative.
refiledAfter : (ModuleCtx -> Mono -> Mono -> Unit) -> Expectation
refiledAfter joinVars =
  let (m, a, b) = filedUnderA ()
  joinVars m a b
  refileDeterminedRows m ()
  expectEqual [idOf a] (filedUnder m)

-- One of the two orders of unification moves the representative of the goal's variable off the
-- variable the commit was filed under, so each is read.
test "a commit is filed again under the variable its goal now has as representative, whichever way they were unified" = expectEach
  [
    ("goal variable first", refiledAfter (m a b => unify m a b)),
    ("goal variable second", refiledAfter (m a b => unify m b a)),
  ]

test "a commit whose goal variable was bound to a head is dropped" =
  let (m, a, _) = filedUnderA ()
  unify m a intM
  refileDeterminedRows m ()
  expectEqual [] (filedUnder m)

test "two commits under two variables unified into one are both filed under it" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  m.mcCells.determinedRowsRef :=
    IdMap.set
      (idOf b)
      [(commitRow, [b])]
      (IdMap.set (idOf a) [(commitRow, [a])] IdMap.Tip)
  unify m a b
  refileDeterminedRows m ()
  expectEqual
    (1, 2)
    (
      listLen (filedUnder m),
      sum (map listLen (IdMap.values m.mcCells.determinedRowsRef.value)),
    )

test "a graph with no determined row is left with none" =
  let m = fresh ()
  refileDeterminedRows m ()
  expectEqual [] (filedUnder m)

-- Private probe for the memo's goal equality: two goals `C (Int -> Int)` whose arrows
-- carry different effect rows are one predicate to `monoVecSameGiven` and two to
-- `walkGoalSame`, in either order; the same row is one goal to both.
export
walkGoalSameProbe : Unit -> List Bool
walkGoalSameProbe _ =
  let iface = ifaceRefBare "C"
  let int = tconBuiltin "Int"
  let mctx = initialModuleCtx (probeGraphCtx ())
  let row1 = EffRow [] (Some (freshEffvar mctx ()))
  let row2 = EffRow [] (Some (freshEffvar mctx ()))
  let goal1 = [TFun int row1 int]
  let goal2 = [TFun int row2 int]
  [
    monoVecSameGiven goal1 goal2,
    monoVecSameGiven goal2 goal1,
    walkGoalSame iface goal1 iface goal2,
    walkGoalSame iface goal2 iface goal1,
    walkGoalSame iface goal1 iface [TFun int row1 int],
  ]

-- Private service check for the selection half of the scope adapter.  It keeps
-- the full-vector and id-witness eligibility rules observable independently of
-- production examples, and its sibling query fails if lexical filtering is
-- removed from `anyGivenMatches`.
scopeGivenProbe : Unit -> List Bool
scopeGivenProbe _ =
  let gctx = probeGraphCtx ()
  let store = currentScopeStore gctx ()
  let root = Scopes.freshScope store None 0 "given-probe" ModuleOwner
  let owner =
    Scopes.freshScope store (Some root) 1 "given-probe" (BindingOwner "owner")
  let sibling =
    Scopes.freshScope store (Some root) 1 "given-probe" (BindingOwner "sibling")
  let iface =
    IfaceRef { irName = "PairGiven", irOrigin = OriginModule "given-probe" }
  let args = [tconBuiltin "Int", tconBuiltin "Bool"]
  let slot = PredicateSlot {
    psIface = iface,
    psArgs = PSArgsKnown args,
    psBoundIds = [41],
  }
  pushGiven gctx GMPredicate DirectGiven slot (Scopes.binderAt owner 0)
  let exact = PredicateRequest { prIface = iface, prArgs = PSArgsKnown args }
  let unknown = PredicateRequest { prIface = iface, prArgs = PSArgsUnknown }
  let truncated = PredicateRequest {
    prIface = iface,
    prArgs = PSArgsKnown [tconBuiltin "Int"],
  }
  let witnessIface = IfaceRef {
    irName = "WitnessGiven",
    irOrigin = OriginModule "given-probe",
  }
  let witnessSlot = PredicateSlot {
    psIface = witnessIface,
    psArgs = PSArgsKnown [tconBuiltin "Int"],
    psBoundIds = [73],
  }
  let witnessRequest = PredicateRequest {
    prIface = witnessIface,
    prArgs = PSArgsKnown [tconBuiltin "Int"],
  }
  pushGiven gctx GMIdWitnessed DirectGiven witnessSlot (Scopes.binderAt owner 1)
  let compatibleIface = IfaceRef {
    irName = "CompatibleGiven",
    irOrigin = OriginModule "given-probe",
  }
  let compatibleSlot = PredicateSlot {
    psIface = compatibleIface,
    psArgs = PSArgsUnknown,
    psBoundIds = [89],
  }
  let compatibleRequest = PredicateRequest {
    prIface = compatibleIface,
    prArgs = PSArgsKnown [tconBuiltin "Int"],
  }
  pushGiven
    gctx
    GMPredicate
    DirectGiven
    compatibleSlot
    (Scopes.binderAt owner 2)
  let givens = givensForScope gctx owner
  let result = [
    anyGivenMatches gctx exact owner givens,
    not (anyGivenMatches gctx exact sibling givens),
    not (anyGivenMatches gctx truncated owner givens),
    not (anyGivenMatches gctx witnessRequest owner givens),
    isSome
      (firstPredForEnclAt gctx GSImplRequires 73 witnessRequest owner givens),
    isNone
      (firstPredForEnclAt gctx GSImplRequires 74 witnessRequest owner givens),
    isSemanticGivenAnswer (firstPredForEncl gctx exact owner givens),
    isLegacyPredicateAnswer
      (firstPredForEnclAt gctx GSPredicateOnly 41 unknown owner givens),
    isLegacyPredicateAnswer
      (firstPredForEnclResidual gctx "PairGiven" args owner givens),
    isLegacyPredicateAnswer
      (firstPredForEncl gctx compatibleRequest owner givens),
  ]
  result

test "a scope's givens answer exact, witnessed, truncated and compatible requests" =
  expectEqual
    [True, True, True, True, True, True, True, True, True, True]
    (scopeGivenProbe ())

isSemanticGivenAnswer : Option AssumAnswer -> Bool
isSemanticGivenAnswer (Some (SemanticGiven (GivenEvidence _))) = True
isSemanticGivenAnswer _ = False

isLegacyPredicateAnswer : Option AssumAnswer -> Bool
isLegacyPredicateAnswer (Some (LegacyPredicate _)) = True
isLegacyPredicateAnswer _ = False
