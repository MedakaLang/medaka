-- Tests of `types.tc_solve`'s own API: the goal-kind tags and names, the interface-reference
-- mints, the per-function site index, the route and arity stamps, the arithmetic site stamp,
-- the small id and name projections, the enclosing-variable and return-position projections;
-- the method-return solver observed through its trace and memo (the ordinary return's
-- identity, vector and destination, the given and instance evidence it retains, the cache
-- replay, and the memo across requests); the discharge memo's goal identity and the drain's
-- live spans; the evidence a nested or constructed goal publishes; and what a whole check
-- resolves for a return-position method and for an integer literal.  The solver reads a site
-- context only a whole check mints, so most rows drive `types.typecheck`, which sits above it.

import test.{
  expectAll, expectEach, expectEqual, expectFalse, expectGreaterThan,
  expectNotEqual, expectTrue, fail, Expectation
}
import frontend.ast.{
  Decl(..), EvId(..), EvTable, EvVal(..), Expr(..), Loc(..), Route(..),
  TyConOrigin(..)
}
