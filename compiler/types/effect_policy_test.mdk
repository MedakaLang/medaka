-- The shared policy judgment over hand-built atoms and call graphs: every
-- refusal beside the control that differs in one position.
import test.{expectAll, expectEqual, expectTrue, expectFalse}
import frontend.ast.{EffParamTy(..)}
import types.effect_authority.{Authority(..), Authvar(..)}
import types.effect_domain.{Param(..)}
import types.effect_policy.{
  PolicyVerdict(..), policyRefusals, viaChain, CallGraph, EffectTable
}
import types.effect_rows.{Atom(..), EffLabel(..), atomBuiltin, atomLabel}
import types.typecheck.{atomOfLabel, ioJoinAtoms}
import types.target_profile.{hostLabels}
import list.{take, sort}
import support.ordmap.{omEmpty, omFromPairs}

-- The effect domains before any drive registered one: what no-drive callers read.
noDomains : List (String, Param)
noDomains = []

ioAtom : Atom
ioAtom = atomOfLabel noDomains "IO"

ffiAtom : Atom
ffiAtom = atomOfLabel noDomains "FFI"

wholeGrant : String -> (String, EffParamTy)
wholeGrant l = (l, EPTop)

refused : PolicyVerdict -> Bool
refused PolicyAdmitted = False
refused (PolicyRefused _ _) = True

refusedLabels : PolicyVerdict -> List String
refusedLabels PolicyAdmitted = []
refusedLabels (PolicyRefused ls _) = ls

refusalLines : PolicyVerdict -> List String
refusalLines PolicyAdmitted = []
refusalLines (PolicyRefused _ ls) = ls

eightLabels : List (String, EffParamTy)
eightLabels = map wholeGrant (take 8 hostLabels)

test "IO is the join: refused by eight labels, permitted by all eleven" = expectAll
  [
    expectTrue (refused (policyRefusals noDomains [ioAtom] eightLabels)),
    expectEqual
      ["IO"]
      (refusedLabels (policyRefusals noDomains [ioAtom] eightLabels)),
    expectFalse
      (refused (policyRefusals noDomains [ioAtom] (map wholeGrant hostLabels))),
  ]

test "FFI is not in the IO join" = expectAll [
  expectTrue
    (refused (policyRefusals noDomains [ffiAtom] (map wholeGrant hostLabels))),
  expectFalse
    (refused
      (policyRefusals
        noDomains
        [ffiAtom]
        (wholeGrant "FFI" :: map wholeGrant hostLabels))),
]

unresolvedNet : Atom
unresolvedNet =
  Atom
    (atomOfLabelLabel "Net")
    (AVar (Ref (AUnbound 1 0 (PPrefix None) False (Some "k"))))

atomOfLabelLabel : String -> EffLabel
atomOfLabelLabel l = match atomOfLabel noDomains l
  Atom lbl _ => lbl

test "an unresolved authority needs a whole grant" =
  let partial = [("Net", EPLit "a.com/*")]
  expectAll [
    expectTrue (refused (policyRefusals noDomains [unresolvedNet] partial)),
    expectEqual
      1
      (length
        (refusalLines (policyRefusals noDomains [unresolvedNet] partial))),
    expectFalse
      (refused (policyRefusals noDomains [unresolvedNet] [wholeGrant "Net"])),
  ]

callGraph : CallGraph
callGraph =
  omFromPairs
    [
      ("a", ["b", "c"]),
      ("b", []),
      ("c", ["a"]),
      ("d", ["d"]),
    ]
    omEmpty

netAtoms : List Atom
netAtoms = [atomBuiltin "Net" (PPrefix None)]

effTable : EffectTable
effTable =
  omFromPairs [("a", netAtoms), ("c", netAtoms), ("d", netAtoms)] omEmpty

test "the via-chain follows the smallest effectful callee and stops on a cycle" = expectAll
  [
    expectEqual ["a", "c", "a"] (viaChain callGraph effTable "a" "Net"),
    expectEqual ["b"] (viaChain callGraph effTable "b" "Net"),
    expectEqual ["d", "d"] (viaChain callGraph effTable "d" "Net"),
    expectEqual ["a"] (viaChain callGraph effTable "a" "Stdout"),
  ]

-- The typechecker's `IO` join over a profile granting everything is the eleven
-- host labels, the same set `target_profile` gates on.
test "the typechecker's IO join over the full profile is hostLabels" = expectAll
  [
    expectEqual
      (sort hostLabels)
      (sort
        (map atomLabel (ioJoinAtoms noDomains (map wholeGrant hostLabels)))),
    expectEqual
      (sort [
        "Clock",
        "Env",
        "Exec",
        "FileRead",
        "FileWrite",
        "Net",
        "Rand",
        "Signal",
        "Stderr",
        "Stdin",
        "Stdout",
      ])
      (sort hostLabels),
  ]
