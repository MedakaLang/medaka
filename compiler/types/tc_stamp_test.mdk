-- Tests of `types.tc_stamp`'s own API.  A module is checked in a graph record built by
-- `tc_module_test`'s fixtures and the queue the check filled is drained with `drainStampQueue`.
-- Covered: the stamp queue and its drain (what is enqueued, what is reported, that a drain
-- empties the queue), `captureTypeErrors`, `verdictFinding`, `isLiveSpan` and `spanKeys`.  The
-- plural site resolvers are not driven here, because no export reaches them: their effect is
-- observed as the drain's routes and unrouted-dispatch findings.

import support.diag_codes.{DiagCode(..), codeText}
import test.{expectAll, expectEqual, expectFalse, expectNotEqual, expectTrue}
import list.{drop, sort, take}
import frontend.ast.{Loc(..)}
import support.ordmap.{omEmpty, omFromNames}
import types.publish.{TcDiag(..), tcCode}
import types.tc_diag.{pushTypeError}
import types.tc_test_support.{codesOf, fresh}
import types.tc_types.{DrainFinding(..)}
import types.tc_module_test.{
  bodyChecked, callingSz, checkEach, driven, findingsOf, importingSz,
  methodRoutes, onlyModule, prepared, Checked(..)
}
import types.tc_stamp.{
  captureTypeErrors,
  drainStampQueue,
  enqueueStampCtx,
  isLiveSpan,
  spanKeys,
  verdictFinding,
}

-- ── the stamp queue and its drain ─────────────────────────────────────────

test "a module whose calls all find an impl leaves nothing to drain" =
  expectEqual
    (Checked [("sz", "a -> Int"), ("y", "Int")] [] [], [])
    (onlyModule (callingSz "1"))

test "a call with no impl is an error of the module and an unrouted-dispatch finding of the drain" =
  expectEqual
    (
      Checked [("sz", "a -> Int"), ("y", "Int")] ["T-NO-IMPL"] [],
      [("m", "T-UNROUTED-DISPATCH")],
    )
    (onlyModule (callingSz "True"))

test "every module that was checked is drained, each finding under its own module" =
  let (_, fs) = driven [
    (
      "m",
      """
export interface Sz a where
  sz : a -> Int
export impl Sz Int where
  sz x = x
""",
    ),
    ("n", importingSz "True"),
    ("o", importingSz "False"),
  ]
  expectEqual
    [("n", "T-UNROUTED-DISPATCH"), ("o", "T-UNROUTED-DISPATCH")]
    (sort fs)

test "a drain reports a finding once, so a second drain over the same graph finds nothing" =
  let (m, decls) = prepared [("m", callingSz "True")]
  let _ = checkEach m.mcGraph [] decls
  let first = findingsOf (drainStampQueue m)
  let second = findingsOf (drainStampQueue m)
  expectEqual ([("m", "T-UNROUTED-DISPATCH")], []) (first, second)

test "enqueueing a module's stamping context queues exactly one, which the drain empties" =
  let (m, decls) = prepared [("m", callingSz "1")]
  let ctx = bodyChecked m decls
  let before = length ctx.mcGraph.graphRun.stampCtxs.value
  enqueueStampCtx ctx "m" []
  let queued = length ctx.mcGraph.graphRun.stampCtxs.value
  let _ = drainStampQueue ctx
  expectEqual
    (0, 1, 0)
    (before, queued, length ctx.mcGraph.graphRun.stampCtxs.value)

test "a drain empties the stamp queue the module check filled" =
  let (m, decls) = prepared [("m", callingSz "1")]
  let _ = checkEach m.mcGraph [] decls
  let queued = length m.mcGraph.graphRun.stampCtxs.value
  let _ = drainStampQueue m
  expectEqual (True, 0) (queued > 0, length m.mcGraph.graphRun.stampCtxs.value)

-- A module of its own interface `name` with no impl, and a call of the method at a type that
-- has none.
unanswered : String -> String
unanswered name =
  """
interface \{name} a where
  m\{name} : a -> Int
y : Int
y = m\{name} True
"""

test "a module checked after a drain has its finding drained under its own module id" =
  let (m, decls) = prepared [("m", unanswered "Sz"), ("n", unanswered "Tz")]
  let _ = checkEach m.mcGraph [] (take 1 decls)
  let first = findingsOf (drainStampQueue m)
  let _ = checkEach m.mcGraph [] (drop 1 decls)
  let second = findingsOf (drainStampQueue m)
  expectEqual
    ([("m", "T-UNROUTED-DISPATCH")], [("n", "T-UNROUTED-DISPATCH")])
    (first, second)

test "the module check queues its stamping, so the drain routes a method call to its impl" =
  let (m, decls) = prepared [("m", callingSz "1")]
  let _ = checkEach m.mcGraph [] decls
  let _ = drainStampQueue m
  expectEqual ["key:m::Sz|Int|"] (methodRoutes m.mcGraph)

test "the body check alone queues no stamping, so a drain leaves the method call unrouted" =
  let (m, decls) = prepared [("m", callingSz "1")]
  let ctx = bodyChecked m decls
  let _ = drainStampQueue ctx
  expectEqual ["none"] (methodRoutes m.mcGraph)

test "an evidence hole is found by a drain whether or not a stamping context was queued" =
  let (m, decls) = prepared [("m", callingSz "True")]
  let ctx = bodyChecked m decls
  expectEqual
    (["T-NO-IMPL"], [("m", "T-UNROUTED-DISPATCH")])
    (codesOf ctx, findingsOf (drainStampQueue ctx))

test "a finding the drain makes of a hole is not a verdict" =
  let (m, decls) = prepared [("m", callingSz "True")]
  let _ = checkEach m.mcGraph [] decls
  expectEqual [False] (map (f => f.dfVerdict) (drainStampQueue m))

-- ── errors captured out of a record ───────────────────────────────────────

test "the errors an action pushes are returned oldest first and leave the record as it was" =
  let m = fresh ()
  pushTypeError m TNoImpl "kept"
  let taken = captureTypeErrors m (_ =>
    pushTypeError m TUnbound "one"
    pushTypeError m TMissingField "two")
  expectEqual
    (["T-UNBOUND", "T-MISSING-FIELD"], ["T-NO-IMPL"])
    (map (d => codeText (tcCode d)) taken, codesOf m)

test "an action that pushes no error captures none" =
  expectEqual
    []
    (map (d => codeText (tcCode d)) (captureTypeErrors (fresh ()) (_ => ())))

-- The verdict finding of module "mod" over [d], on a live span and on one that is not.
liveVerdict : TcDiag -> DrainFinding
liveVerdict = verdictFinding "mod" True

deadVerdict : TcDiag -> DrainFinding
deadVerdict = verdictFinding "mod" False

test "a verdict finding carries its module, its diagnostic and its liveness, and is a verdict" =
  let d = TcDiag TUnknownField 1 None "msg" None None
  let f = liveVerdict d
  expectAll [
    expectEqual "mod" f.dfModule,
    expectEqual "T-UNKNOWN-FIELD" (codeText (tcCode f.dfDiag)),
    expectTrue f.dfLive,
    expectTrue f.dfVerdict,
    expectFalse (deadVerdict d).dfLive,
  ]

-- ── the drain's live spans ────────────────────────────────────────────────

-- A finding is live when its span is a live goal's.  Goals built after a drain
-- (`pushArithGoal` and its siblings) carry no location, so an unlocated live goal must not
-- make every unlocated finding live.
test "an unlocated drain finding is never live, even beside an unlocated live goal" =
  let at = Some (Loc "m.mdk" 3 4 3 9)
  let live = omFromNames (spanKeys [None, at]) omEmpty
  expectAll [
    expectEqual ["m.mdk:3:4"] (spanKeys [None, at, None]),
    expectFalse (isLiveSpan live None),
    expectTrue (isLiveSpan live at),
    expectFalse (isLiveSpan live (Some (Loc "m.mdk" 3 5 3 9))),
  ]

test "the span keys of goals skip an unlocated goal and keep the located ones in order" =
  let first = Some (Loc "probe.mdk" 3 1 3 5)
  let second = Some (Loc "probe.mdk" 9 1 9 5)
  expectAll [
    expectEqual [] (spanKeys [None, None]),
    expectEqual (spanKeys [first]) (spanKeys [None, first, None]),
    expectNotEqual (spanKeys [first]) (spanKeys [second]),
    expectEqual
      (spanKeys [first] ++ spanKeys [second])
      (spanKeys [first, None, second]),
  ]

-- The location a generated number stands for: none for a multiple of 4, else the line its
-- residue mod 6 names, so two draws often stand at one place.
locOf : Int -> Option Loc
locOf n = if n % 4 == 0 then None else Some (Loc "p.mdk" (n % 6) 1 (n % 6) 2)

-- Law: the keys of goals followed by goals are the keys of each in turn.  No precondition.
prop "the span keys of two lists of goals are the keys of each in turn" (xs : List Int) (ys : List Int) =
  spanKeys (map locOf (xs ++ ys))
    == spanKeys (map locOf xs) ++ spanKeys (map locOf ys)

-- The same answer as `isLiveSpan`, read off the numbers: [y] stands at a place and some live goal
-- stands at that place.
standsLive : List Int -> Int -> Bool
standsLive xs y = y % 4 /= 0 && any (x => x % 4 /= 0 && x % 6 == y % 6) xs

-- Law: a finding is live exactly when a live goal stands at its place.  Precondition for the law
-- to say anything: a located finding, and live goals of which some stand at its place and some do
-- not; the examples above pin both verdicts by hand.
prop "a span is live exactly when a live goal stands at it" (xs : List Int) (y : Int) =
  isLiveSpan (omFromNames (spanKeys (map locOf xs)) omEmpty) (locOf y)
    == standsLive xs y
