-- Sibling tests for the superclass closure.  The lookups are hand-built
-- interface graphs, so each case states the declared supers it walks.

import test.{expectEqual}
import frontend.ast.{Super(..), TyConOrigin(..)}
import types.repr.{IfaceRef(..)}
import types.superclass.{
  SuperNode(..),
  directSupers,
  lookupPos,
  mapAll,
  superClosure,
}

ref : String -> IfaceRef
ref n = IfaceRef { irName = n, irOrigin = OriginModule "m" }

sup : String -> List String -> Super
sup n ps =
  Super { superHead = n, superParams = ps, superOrigin = OriginModule "m" }

-- Top requires Mid, Side; Mid requires Base; Side requires Base.
diamond : IfaceRef -> Option (List String, List Super)
diamond r
  | r.irName == "Top" = Some (["a"], [sup "Mid" ["a"], sup "Side" ["a"]])
  | r.irName == "Mid" = Some (["a"], [sup "Base" ["a"]])
  | r.irName == "Side" = Some (["a"], [sup "Base" ["a"]])
  | otherwise = Some (["a"], [])

-- Maps each super parameter through the sub-predicate's positional payload.
positional : List String -> List Int -> Super -> Option (List Int)
positional tps vs s = mapAll (p => lookupPos p tps vs) s.superParams

nameKey : IfaceRef -> List Int -> String
nameKey r _ = r.irName

view : SuperNode (List Int) -> (String, List Int, List Int)
view n = (n.superIface.irName, n.superPayload, n.superPath)

test "a diamond is closed breadth-first and its shared base appears once" =
  expectEqual
    [
      ("Top", [7], [0]),
      ("Mid", [7], [0, 0]),
      ("Side", [7], [0, 1]),
      ("Base", [7], [0, 0, 0]),
    ]
    (map view (superClosure diamond positional nameKey [(ref "Top", [7])]))

test "every seed precedes every super, and a seeded predicate is not reached again" =
  expectEqual
    [
      ("Top", [1], [0]),
      ("Base", [2], [1]),
      ("Mid", [1], [0, 0]),
      ("Side", [1], [0, 1]),
    ]
    (map
      view
      (superClosure diamond positional nameKey [
        (ref "Top", [1]),
        (ref "Base", [2]),
      ]))

test "the dedup key decides which predicates are the same" =
  let payloadKey = r => vs => r.irName ++ debug vs
  expectEqual
    [("Base", [1], [0]), ("Base", [2], [1])]
    (map
      view
      (superClosure diamond positional payloadKey [
        (ref "Base", [1]),
        (ref "Base", [2]),
      ]))

-- C a b requires L a, R b a, X z (z is not a parameter of C).
pairIface : IfaceRef -> Option (List String, List Super)
pairIface r
  | r.irName == "C" =
    Some (["a", "b"], [sup "L" ["a"], sup "R" ["b", "a"], sup "X" ["z"]])
  | otherwise = Some ([], [])

test "direct supers map parameters positionally and drop an unresolvable super" =
  expectEqual
    [("L", [1], [3, 0]), ("R", [2, 1], [3, 1])]
    (map
      view
      (directSupers pairIface positional SuperNode {
        superPath = [3],
        superIface = ref "C",
        superPayload = [1, 2],
      }))

test "an interface the lookup does not know contributes no supers" =
  expectEqual
    [("Gone", [5], [0])]
    (map view (superClosure (_ => None) positional nameKey [(ref "Gone", [5])]))

test "lookupPos and mapAll" =
  let _ = expectEqual (Some 20) (lookupPos "b" ["a", "b"] [10, 20])
  let _ = expectEqual None (lookupPos "c" ["a", "b"] [10, 20])
  expectEqual None (mapAll (x => if x > 0 then Some x else None) [1, 0])
