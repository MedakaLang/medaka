-- Sibling test module for `compiler/types/registry.mdk`.
--
-- A `*_test.mdk` file lives beside its subject and is NOT compiler source: it
-- is excluded from the two build fingerprints and from the snapshot corpus,
-- so adding or editing one never makes `./medaka` report itself stale and
-- never demands a golden. See AGENTS.md's `[P-TEST-SIBLING]`.
--
-- WHAT LIVES HERE: the unit-test-shaped assertions about `registry.mdk` —
-- boolean properties of the identity/key substrate, for which a reader of the
-- module's public surface is not being shown a return value. The documentary
-- doctests, which illustrate a real return value, stay in `registry.mdk`
-- beside the function they document.
--
-- The doctest fixtures of `registry.mdk` (`identTypeFooM` and its siblings) are
-- private to it; this file reads them through the sibling's view of its subject
-- instead of redeclaring them, so a fixture has one definition.
--
-- Three assertions stay doctests in `registry.mdk`: the ones naming
-- `OriginUnresolved` in the expression. `test/typecheck_compiler_source.sh`'s
-- #1110 producer ratchet pins the set of tracked files carrying a non-comment
-- `OriginUnresolved` mention, and `registry_test.mdk` is not in that set; a
-- `test` block is live code, so moving them here would red the ratchet.

import test.{expectEqual, expectNotEqual, expectTrue}
import types.registry.{
  HeadKey(..),
  headA,
  regInsertCheckedK,
  headU,
  headZ,
  identIfaceFooM,
  identIfaceIxM,
  identIn,
  identShiftA,
  identShiftB,
  identSizeIn,
  identTypeBarM,
  identTypeFooBuiltin,
  identTypeFooM,
  keyIxIntUndet,
  keyIxUndetInt,
  mregOrderA,
  mregOrderB,
  regBothNs,
  slotPA,
  slotUA,
  tabTable,
  tabU,
  lenKey,
  ordKey,
  MultiRegistry,
  RegKey,
  Registry,
  headBucketKey,
  headKeyIdent,
  headKeyOfCon,
  identKey,
  mregAdd,
  mregEmpty,
  mregEntries,
  mregLookup,
  mregMerge,
  mregSize,
  regEmpty,
  regEntries,
  regInsert,
  regInsertK,
  regDelete,
  regKeyAt,
  regKeyN,
  regKeyNAt,
  regKeyOf,
  regKeyOfTab,
  regKeyRender,
  regKeyTabAt,
  regLookupK,
  regSize,
  sregAdd,
  sregAddK,
  sregEmpty,
  sregKeys,
  sregSize,
  SetRegistry(..),
  tabKeyRender,
  SpellingPop,
  spEmpty,
  spInsert,
  spFloor,
  spCollided,
  spCandsOf,
  spLookupIdent,
}
import frontend.ast.{
  Ident(..),
  Ns(..),
  TabKey(..),
  TyConOrigin(..),
  identOriginBuiltin,
  identOriginOf,
  mkIdent,
  tabHasName,
  tabKeyOf,
}
import support.util.{filterList, startsWith, listLen, joinWith}
import support.ordmap.{omLookup}
import list.{sort}
import map.{has}

-- A tuple of identities, rendered by plain concatenation. Injective on its
-- own: each element contributes exactly four netstrings, so a stream of `4n`
-- netstrings decodes to exactly one list, and two lists of different length
-- render to strings of different length.
identKeys : List Ident -> String
identKeys idents = joinWith "" (map identKey idents)

regKeyTabs : RegKey -> List TabKey
regKeyTabs (RegKey keys _) = keys

regInsertChecked : Ident -> v -> Registry v -> (Registry v, Bool)
regInsertChecked ident v r = regInsertCheckedK (regKeyOf ident) v r

-- Same order caveat as `regEntries`.
regKeys : Registry v -> List RegKey
regKeys r = map fst (regEntries r)

mregKeys : MultiRegistry v -> List RegKey
mregKeys mr = map fst (mregEntries mr)

sregMemberK : RegKey -> SetRegistry -> Bool
sregMemberK k (SetRegistry m) = has k m

sregMember : Ident -> SetRegistry -> Bool
sregMember ident s = sregMemberK (regKeyOf ident) s

-- ── A dispatch key over a whole ARGUMENT VECTOR ───────────────────────────
-- `checkCallObligationsU`'s dedup key (`types/typecheck.mdk`) is a vector, not
-- a single key: an interface plus one projected head PER argument, where a
-- position can be a declaration, absent, OR rigid. `RegKey` alone cannot
-- express it, and widening `RegKey` to admit a rigid is precisely what §8
-- I6.1 forbids (see `RegKey`'s own doc-comment). So the two halves are
-- rendered SEPARATELY and concatenated:
--
--   [base]   a `RegKey` whose identity block is the interface key followed by
--            the DECLARATION positions' keys, and whose ordinal block is the
--            vector's ARITY followed by those positions' indices. Every
--            position that is neither in the ordinal block nor in [rigids] is
--            absent, and the arity says how many positions there are, so the
--            classification of every position is recoverable ⇒ two vectors
--            differing only in WHICH position is absent get different keys.
--            That is #607's property, kept structurally rather than by a
--            positional `""` placeholder that a name could in principle equal.
--   [rigids] the §8 I6.1 RESIDUAL, as `(position, parameter name)` pairs in
--            ascending position order. It is a separate argument, and a
--            separate netstring group, for one reason: **deleting the residual
--            is deleting this argument**, and until then `grep -n
--            dispKeyRender` names every site that still keys on one.
--
-- Injectivity across the join: `regKeyRender`'s output is wrapped in a
-- netstring of its own (`lenKey`) rather than concatenated raw, because the
-- ordinal block is NOT count-prefixed — an ordinal netstring and a rigid
-- position netstring are indistinguishable, so a raw join could read one as
-- the other. Wrapping fixes the boundary: `lenKey s ++ t` determines `s`
-- because a valid-UTF-8 byte-prefix of a valid-UTF-8 string is a codepoint
-- prefix, so equal codepoint counts force equal strings.
--
-- Two rigids of the same name at the same position do compare equal, and
-- that is deliberate: it is what the bare-name key did, and A-2.2b's bar is
-- answer-preservation. Making distinct occurrences of one rigid name
-- never-equal would need an occurrence identity that does not exist at the
-- call site, and inventing one is the I6.3 violation A-2.0's review already
-- rejected. What this rendering DOES guarantee is that a rigid never compares
-- equal to a DECLARATION of the same spelling, and never to a rigid at a
-- different position — the two conflations a bare-name vector admits.
dispKeyRender : RegKey -> List (Int, String) -> String
dispKeyRender base rigids =
  lenKey (regKeyRender base)
    ++ lenKey "\{listLen rigids}"
    ++ joinWith "" (map ((i, name) => ordKey i ++ lenKey name) rigids)

-- ── Fixtures ──────────────────────────────────────────────────────────────
-- The fixtures shared with `registry.mdk`'s doctests (`identTypeFooM`,
-- `identIn`, `tabTable`, `headA`, ...) are the subject's own, imported above.
-- Each pair differs from its sibling along exactly ONE axis (Ns, IdentOrigin,
-- or name), so each assertion below isolates one collision dimension.
--
-- `mkIdent` is partial, so the module-origin fixtures need a total fallback.
-- `identBuiltinFixture` is a WELL-FORMED identity under a name no assertion
-- uses, so a fixture that silently fell back shows up as the WRONG identity
-- rather than as a crash — checked by the `mkIdent`-is-`Some` block below.
-- The vector with NO declaration position at all, so a rigid can sit at
-- position 0 or 1 without colliding with a declaration slot.
keyIxNoDecl : RegKey
keyIxNoDecl = regKeyNAt [identIfaceIxM] [2]

-- A DECLARATION at position 0 whose name is `a` — the spelling a rigid type
-- parameter carries. Both `TabKey` halves are exercised, and neither may
-- equal the rigid.
identTypeLowerAM : Ident
identTypeLowerAM = identIn NsType "m" "a"

keyIxDeclAOnly : RegKey
keyIxDeclAOnly = regKeyNAt [identIfaceIxM, identTypeLowerAM] [2, 0]

keyIxBareAOnly : RegKey
keyIxBareAOnly = RegKey [TkIdent identIfaceIxM, TkBare NsType "a"] [2, 0]

-- The three facts `headBucketKey` classifies.
headDeclFoo : Option HeadKey
headDeclFoo = Some (headKeyOfCon (OriginModule "m") "Foo")

-- ⚠️ Spelled with the CONSTRUCTOR rather than `headKeyOfCon OriginUnresolved
-- "Foo"`, for the reason the module header gives: the #1110 producer ratchet
-- pins the file set carrying a live `OriginUnresolved` mention.
headBareFoo : Option HeadKey
headBareFoo = Some (HkDecl (TkBare NsType "Foo"))

headRigidA : Option HeadKey
headRigidA = Some (HkRigid "a")

-- ── The namespace half of `regKeyRender` ──────────────────────────────────
-- A `Registry` distinguishes two keys that differ ONLY in their namespace.
-- `regKeyRender` reaches that answer through `identKey`'s leading namespace
-- netstring, so a namespace dropped from the rendered key would silently
-- merge a type and a constructor of the same spelling into one row.
typeFoo : RegKey
typeFoo = regKeyOfTab (tabKeyOf NsType (OriginModule "m") "Foo")

ctorFoo : RegKey
ctorFoo = regKeyOfTab (tabKeyOf NsCtor (OriginModule "m") "Foo")

bothFoos : Registry Int
bothFoos = regInsertK ctorFoo 2 (regInsertK typeFoo 1 regEmpty)

test "namespace separates two identically spelled registry keys" =
  expectEqual
    (2, Some 1, Some 2)
    (regSize bothFoos, regLookupK typeFoo bothFoos, regLookupK ctorFoo bothFoos)

-- ── F1: neither non-identity can become an identity ────────────────────────
-- `identOriginOf` is total and REFUSES the empty module id, so no `Ident`
-- exists that would render to a shared constant key. The builtin origin is
-- its own inhabitant, distinct from a module literally named `builtin`.
-- (The `OriginUnresolved` arm of this property is still a doctest in
-- `registry.mdk` — see the module header.)
test "identOriginOf refuses an empty module id and keeps the origins apart" =
  expectEqual
    [True, True, True, False, False]
    [
      identOriginOf (OriginModule "") == None,
      identOriginOf OriginBuiltin == Some identOriginBuiltin,
      identOriginOf (OriginModule "m") == identOriginOf (OriginModule "m"),
      identOriginOf (OriginModule "m") == identOriginOf (OriginModule "n"),
      identOriginOf OriginBuiltin == identOriginOf (OriginModule "builtin"),
    ]

test "mkIdent refuses the empty module id and mints the two good origins" =
  expectEqual
    [True, True, True]
    [
      mkIdent NsType (OriginModule "") "Foo" == None,
      mkIdent NsType (OriginModule "m") "Foo" == Some identTypeFooM,
      mkIdent NsType OriginBuiltin "Foo" == Some identTypeFooBuiltin,
    ]

-- The fixture-fallback guard: every module-origin fixture is a `Some`, so
-- none of them silently became the builtin fallback.
test "every module-origin fixture mint is Some, not the fallback" =
  expectEqual
    [True, True]
    [
      isSome (mkIdent NsType (OriginModule "m") "Foo"),
      isSome (mkIdent NsType (OriginModule "ab") "c"),
    ]

-- ── F2: the field-vs-method case `Ns`'s own doc-comment names, asserted on
-- the renderer rather than through a registry.
test "identKey separates the field and method namespaces" =
  expectNotEqual
    (identKey (identSizeIn NsField))
    (identKey (identSizeIn NsMethod))

-- The origin TAG is redundant by construction and this is the only thing that
-- tests it: every module id is non-empty, so the module string alone already
-- separates builtin from every module. Pinning the tag needs a BYTE-SHAPE
-- assertion, because no property-level one can see it. `identKey` is four
-- netstrings: ns, origin tag, origin module, name.
test "identKey renders exactly four netstrings, tag included" =
  expectEqual
    ["4:type7:builtin0:3:Foo", "4:type6:module1:m3:Foo"]
    [identKey identTypeFooBuiltin, identKey identTypeFooM]

-- The count prefix: the only thing that can distinguish the prefix being
-- there at all.
test "regKeyRender leads with the identity COUNT" =
  expectEqual
    [True, True, True]
    [
      startsWith "1:1" (regKeyRender (regKeyOf identTypeFooM)),
      startsWith "1:2" (regKeyRender (regKeyN [identTypeFooM, identTypeBarM])),
      startsWith "1:0" (regKeyRender (regKeyN [])),
    ]

-- Adversarial boundary shift: `identKey` itself must differ, which is the
-- property that keeps a shifted pair on two registry rows.
test "identKey does not collide a module/name boundary shift" =
  expectNotEqual (identKey identShiftA) (identKey identShiftB)

-- ── F3: #607 — two vectors differing only in WHICH position is absent ──────
-- Both keys carry the SAME identities and differ only in which argument
-- position the present head came from; under the discarded `Ident × [Ident]`
-- row they would have been one key and one ambiguity diagnostic would have
-- been dropped.
test "an ordinal position separates two vectors with equal identities" =
  expectEqual
    [False, True]
    [
      regKeyRender keyIxIntUndet == regKeyRender keyIxUndetInt,
      regKeyTabs keyIxIntUndet == regKeyTabs keyIxUndetInt,
    ]

-- ── F3b: the same property THROUGH `dispKeyRender`'s join ──────────────────
-- `regKeyRender`'s output is netstring-WRAPPED inside `dispKeyRender`, and
-- that is what stops a raw join from reading a rigid position as an ordinal
-- and re-conflating exactly what F3 keeps apart.
test "dispKeyRender's join preserves the #607 separation" =
  expectEqual
    [False, True]
    [
      dispKeyRender keyIxIntUndet [] == dispKeyRender keyIxUndetInt [],
      dispKeyRender keyIxIntUndet [] == dispKeyRender keyIxIntUndet [],
    ]

-- ── F3c: a RIGID position is none of the other two facts ───────────────────
-- Same vector, same position, three different facts at it. The conflations a
-- bare-name key admits are that a rigid `a` renders like a type CONSTRUCTOR
-- named `a`, and that the empty rendering of an absent position equals any
-- head whose name were empty. The declaration arm is asserted on BOTH
-- `TabKey` halves — `TkIdent` alone would leave the flat path, where every
-- user declaration currently lands, untested.
test "a rigid position is neither an absent one nor a declaration" =
  expectEqual
    [False, False, False, False]
    [
      dispKeyRender keyIxNoDecl [(0, "a")] == dispKeyRender keyIxNoDecl [],
      dispKeyRender keyIxDeclAOnly [] == dispKeyRender keyIxNoDecl [(0, "a")],
      dispKeyRender keyIxBareAOnly [] == dispKeyRender keyIxNoDecl [(0, "a")],
      dispKeyRender keyIxDeclAOnly [] == dispKeyRender keyIxBareAOnly [],
    ]

test "a rigid's POSITION and NAME both discriminate" =
  expectEqual
    [False, False, False]
    [
      dispKeyRender keyIxNoDecl [(0, "a")]
        == dispKeyRender keyIxNoDecl [(1, "a")],
      dispKeyRender keyIxNoDecl [(0, "a")]
        == dispKeyRender keyIxNoDecl [(0, "b")],
      dispKeyRender keyIxNoDecl [(0, "a"), (1, "b")]
        == dispKeyRender keyIxNoDecl [(0, "b"), (1, "a")],
    ]

-- ...and two occurrences of the SAME rigid name at the SAME position DO
-- compare equal. That is not an oversight: it is what the bare-name key did,
-- and the widening is answer-preserving by construction.
test "the same rigid name at the same position compares equal" =
  expectEqual
    (dispKeyRender keyIxNoDecl [(0, "a")])
    (dispKeyRender keyIxNoDecl [(0, "a")])

-- ── F3d: `headBucketKey`'s three-way classification ────────────────────────
-- A rigid head yields NO key at all — the §8 I6.1 refusal. An ABSENT head
-- does yield one (the empty identity block), and it can never equal a
-- declaration's, because every declaration key carries at least one `TabKey`.
test "headBucketKey refuses a rigid and separates absent from declared" =
  expectEqual
    [False, True, False, False, True]
    [
      isSome (headBucketKey headRigidA),
      isSome (headBucketKey None),
      map regKeyRender (headBucketKey None)
        == map regKeyRender (headBucketKey headDeclFoo),
      map regKeyRender (headBucketKey headDeclFoo)
        == map regKeyRender (headBucketKey headBareFoo),
      map regKeyRender (headBucketKey headDeclFoo)
        == map regKeyRender (headBucketKey headDeclFoo),
    ]

-- A one-ident key and the same ident at slot 0 are DIFFERENT keys — the
-- ordinal block is not silently equivalent to its absence.
test "an ordinal block is not equivalent to its absence" =
  expectNotEqual
    (regKeyRender (regKeyOf identIfaceFooM))
    (regKeyRender (regKeyAt identIfaceFooM 0))

-- The grouping is what keeps identity tuples apart, not a separator: `[A, B]`
-- and `[B, A]` are different keys, and no concatenation of two 1-tuples
-- equals a 2-tuple (the leading ident-count differs).
test "identity tuples are ordered and their rendering concatenates" =
  expectEqual
    [False, True, True]
    [
      regKeyRender (regKeyN [identTypeFooM, identTypeBarM])
        == regKeyRender (regKeyN [identTypeBarM, identTypeFooM]),
      identKeys [identTypeFooM, identTypeBarM]
        == identKey identTypeFooM ++ identKey identTypeBarM,
      identKeys [identTypeFooM] == identKey identTypeFooM,
    ]

-- `regInsertChecked`'s overwrite signal fires both ways.
test "regInsertChecked reports overwrite and freshness" =
  expectEqual
    [True, False]
    [
      snd
        (regInsertChecked
          identTypeFooM
          99
          (regInsert identTypeFooM 1 regEmpty)),
      snd (regInsertChecked identTypeFooM 99 regEmpty),
    ]

-- ── F4: `regEntries` hands back the ORIGINAL identities ────────────────────
-- Asserted by comparing the returned keys themselves, not merely by counting
-- them: a `regEntries` returning two FABRICATED identities would pass a count.
-- Enumeration is in `RegKey` structural order, and `NsType` is declared before
-- `NsIface`, so `NsType` comes first.
test "regEntries returns the original identities in key order" =
  expectEqual
    [True, True, True]
    [
      map (e => regKeyTabs (fst e)) (regEntries regBothNs)
        == [[TkIdent identTypeFooM], [TkIdent identIfaceFooM]],
      map snd (regEntries regBothNs) == [1, 2],
      regKeys regBothNs == [regKeyOf identTypeFooM, regKeyOf identIfaceFooM],
    ]

-- `mregAdd` never drops a registration to call order: both orders keep BOTH
-- values, compared as a multiset since the internal list order is not itself
-- the guarantee.
test "mregAdd keeps both values under either call order" =
  expectEqual
    (sort (mregLookup identTypeFooM mregOrderA))
    (sort (mregLookup identTypeFooM mregOrderB))

test "MultiRegistry enumeration and union keep every registration" =
  expectEqual
    [True, True, True]
    [
      map (e => regKeyTabs (fst e)) (mregEntries mregOrderA)
        == [[TkIdent identTypeFooM]],
      mregKeys mregOrderA == [regKeyOf identTypeFooM],
      sort (mregLookup identTypeFooM (mregMerge mregOrderA mregOrderB))
        == [1, 1, 2, 2],
    ]

-- SetRegistry: membership under both the `Ident` and the `RegKey` entry
-- points, and the ordinal discriminating on the latter.
test "SetRegistry membership answers for its own key and no other" =
  expectEqual
    [True, False, True, True, False]
    [
      sregMember identTypeFooM (sregAdd identTypeFooM sregEmpty),
      sregMember identTypeBarM (sregAdd identTypeFooM sregEmpty),
      sregKeys (sregAdd identTypeFooM sregEmpty) == [regKeyOf identTypeFooM],
      sregMemberK
        (regKeyAt identIfaceFooM 3)
        (sregAddK (regKeyAt identIfaceFooM 3) sregEmpty),
      sregMemberK
        (regKeyAt identIfaceFooM 4)
        (sregAddK (regKeyAt identIfaceFooM 3) sregEmpty),
    ]

-- ── SpellingPop ─────────────────────────────────────────────────────────────
identCtorCA : Ident
identCtorCA = identIn NsCtor "a" "C"

identCtorCB : Ident
identCtorCB = identIn NsCtor "b" "C"

popTwoDecls : SpellingPop Int
popTwoDecls =
  spInsert
    (Some identCtorCB)
    "C"
    "TB"
    2
    (spInsert (Some identCtorCA) "C" "TA" 1 spEmpty)

test "two declarations under one spelling are a collision" =
  expectEqual
    (["C"], 2)
    (spCollided popTwoDecls, listLen (spCandsOf "C" popTwoDecls))

test "re-inserting one declaration keeps one row and no collision" =
  let pop =
    spInsert
      (Some identCtorCA)
      "C"
      "TA"
      3
      (spInsert (Some identCtorCA) "C" "TA" 1 spEmpty)
  expectEqual
    ([], 1, Some 3)
    (
      spCollided pop,
      listLen (spCandsOf "C" pop),
      spLookupIdent identCtorCA "C" pop,
    )

test "the floor holds the last payload registered under a spelling" =
  expectEqual
    (Some 2, Some 1)
    (
      omLookup "C" (spFloor popTwoDecls),
      spLookupIdent identCtorCA "C" popTwoDecls,
    )

test "an unstamped declaration reaches the floor and no row" =
  let pop = spInsert None "C" "TA" 7 spEmpty
  expectEqual
    (Some 7, 0)
    (omLookup "C" (spFloor pop), listLen (spCandsOf "C" pop))

-- ── F4: `TabKey` — the assoc-list half ─────────────────────────────────────
-- The mint is total, and each origin case lands where it must. (Its
-- `OriginUnresolved` arm is still a doctest in `registry.mdk` — see the
-- module header.)
test "tabKeyOf routes each origin to the right TabKey half" =
  expectEqual
    [False, True, True]
    [
      tabKeyOf NsType (OriginModule "apub") "Box"
        == TkIdent (Ident NsType identOriginBuiltin "Box"),
      tabKeyOf NsType (OriginModule "") "Box" == TkBare NsType "Box",
      tabKeyOf NsType OriginBuiltin "Box"
        == TkIdent (Ident NsType identOriginBuiltin "Box"),
    ]

-- `tabHasName` is the name-only membership predicate: it sees BOTH halves and
-- returns no value, so it can never select a row.
test "tabHasName sees both TabKey halves and selects no row" =
  expectEqual
    [True, True, False, False]
    [
      tabHasName "Box" tabTable,
      tabHasName "Box" [(tabU, 7)],
      tabHasName "Bx" tabTable,
      tabHasName "Box" ([] : List (TabKey, Int)),
    ]

-- ── F5: the identity/bare exclusion THROUGH THE RENDERED PATH ──────────────
-- This is the rendered text the rendering-layer contract pins; the `Registry`
-- itself compares `RegKey`s structurally, so `tabKeyEq` is not consulted down
-- here either. A `tabKeyRender` whose bare arm collided with
-- an identity arm is caught only by this.
test "a bare slot key never renders as an identity-bearing one" =
  expectNotEqual (regKeyRender slotUA) (regKeyRender slotPA)

-- `regKeyOfTab` and `regKeyOf` agree on an identity-bearing key — the
-- `List Ident` to `List TabKey` widening is answer-preserving for every
-- pre-widening caller.
test "regKeyOfTab agrees with regKeyOf on an identity-bearing key" =
  expectEqual
    [True, True, True]
    [
      regKeyOfTab (TkIdent identIfaceFooM) == regKeyOf identIfaceFooM,
      regKeyRender (regKeyOfTab (TkIdent identIfaceFooM))
        == regKeyRender (regKeyOf identIfaceFooM),
      regKeyTabAt (TkIdent identIfaceFooM) 3 == regKeyAt identIfaceFooM 3,
    ]

-- `tabKeyRender`'s identity arm IS `identKey`, unchanged, and namespace still
-- discriminates on the bare half through the render too.
test "tabKeyRender preserves identKey and keeps the bare half apart" =
  expectEqual
    [True, False]
    [
      tabKeyRender (TkIdent identTypeFooM) == identKey identTypeFooM,
      regKeyRender (regKeyOfTab (TkBare NsType "Same"))
        == regKeyRender (regKeyOfTab (TkBare NsIface "Same")),
    ]

-- The ident-COUNT prefix is present on a `TabKey`-built key exactly as on an
-- `Ident`-built one.
test "the identity count prefix survives a TabKey-built key" =
  expectTrue (startsWith "1:1" (regKeyRender slotPA))

-- ── F5: `HeadKey` — the head-tycon projection's key ────────────────────────
-- The mint is total, it delegates the identity question to `tabKeyOf`, and it
-- is the one site that fixes the namespace to `NsType`.
test "headKeyOfCon delegates the origin and fixes the namespace" =
  expectEqual
    [False, True, True, False]
    [
      headKeyOfCon (OriginModule "apub") "Box"
        == HkDecl (TkIdent (Ident NsType identOriginBuiltin "Box")),
      headKeyOfCon OriginBuiltin "Box"
        == HkDecl (TkIdent (Ident NsType identOriginBuiltin "Box")),
      headKeyOfCon (OriginModule "") "Box" == HkDecl (TkBare NsType "Box"),
      headKeyOfCon (OriginModule "apub") "Box"
        == HkDecl (tabKeyOf NsIface (OriginModule "apub") "Box"),
    ]

-- The point of the widening: two modules' same-named heads are now DISTINCT
-- keys, where the old `Option String` made them the same string.
test "two modules' same-named heads are distinct HeadKeys" =
  expectEqual
    [False, True]
    [headA == headZ, headA == headKeyOfCon (OriginModule "apub") "Box"]

-- A declaration head and a rigid type variable never equate, in either
-- direction — §8 I6.1, which is why `HkRigid` is a separate inhabitant rather
-- than a `TkBare` holding a parameter name.
test "a declaration head never equates with a rigid type variable" =
  expectEqual
    [False, False, True]
    [
      headA == HkRigid "Box",
      headU == HkRigid "Box",
      HkRigid "Box" == HkRigid "Box",
    ]

-- Inside the declaration half, `TabKey`'s own separation is inherited: an
-- identity-bearing head is not an identity-less one, and two identity-less
-- heads of the same name still match — which keeps the flat path answering
-- exactly as it does today.
test "HeadKey inherits TabKey's identity/bare separation" =
  expectEqual
    [False, True]
    [headA == headU, headU == HkDecl (TkBare NsType "Box")]

-- `headKeyIdent`: the identity a head carries, for a consumer selecting a ROW
-- rather than keying a bucket. Two modules' same-named heads give DIFFERENT
-- identities — the whole discrimination the record lookup in
-- `types/typecheck.mdk` buys from it.
test "headKeyIdent discriminates two modules' same-named heads" =
  expectEqual
    [False, True, True]
    [
      headKeyIdent headA == headKeyIdent headZ,
      headKeyIdent headA
        == headKeyIdent (headKeyOfCon (OriginModule "apub") "Box"),
      headKeyIdent (headKeyOfCon OriginBuiltin "Box")
        == Some (Ident NsType identOriginBuiltin "Box"),
    ]

-- ── Script properties ────────────────────────────────────────────────────
--
-- The prop runner has structural generators only, so a `List Int` is the
-- compact operation language here.  Every raw word is normalized into a tiny
-- key pool and an insert/delete kind.  That deliberately makes collisions,
-- overwrites, and repeated deletes common rather than leaving them to chance.

bounded : Int -> Int -> Int
bounded n width = (n % width + width) % width

scriptIdent : Int -> Ident
scriptIdent raw = match bounded raw 7
  0 => identTypeFooM
  1 => identIfaceFooM
  2 => identTypeBarM
  3 => identTypeFooBuiltin
  4 => identShiftA
  5 => identShiftB
  _ => identIn NsType "other" "Foo"

scriptIdents : List Ident
scriptIdents = map scriptIdent [0, 1, 2, 3, 4, 5, 6]

scriptValue : Int -> Int
scriptValue raw = bounded (raw / 7) 17

modelLookup : Ident -> List (Ident, Int) -> Option Int
modelLookup _ [] = None
modelLookup ident ((other, value) :: rest) =
  if ident == other then Some value else modelLookup ident rest

modelPut : Ident -> Int -> List (Ident, Int) -> List (Ident, Int)
modelPut ident value [] = [(ident, value)]
modelPut ident value ((other, prior) :: rest) =
  if ident == other then
    (ident, value) :: rest
  else
    (other, prior) :: modelPut ident value rest

modelDelete : Ident -> List (Ident, Int) -> List (Ident, Int)
modelDelete _ [] = []
modelDelete ident ((other, value) :: rest) =
  if ident == other then rest else (other, value) :: modelDelete ident rest

registryMatchesModel : Registry Int -> List (Ident, Int) -> Bool
registryMatchesModel registry model =
  regSize registry == listLen model
    && registryKeysMatch registry model scriptIdents

registryKeysMatch : Registry Int -> List (Ident, Int) -> List Ident -> Bool
registryKeysMatch _ _ [] = True
registryKeysMatch registry model (ident :: rest) =
  regLookupK (regKeyOf ident) registry == modelLookup ident model
    && registryKeysMatch registry model rest

-- Read the whole key pool before each mutation, then carry the resulting
-- state to later words.  This is deliberately stronger than a final-state
-- assertion: an implementation that caches a stale lookup, or mutates an old
-- persistent value, is observed by a later read before the following write.
registryTraceMatches : List Int -> Registry Int -> List (Ident, Int) -> Bool
registryTraceMatches [] registry model = registryMatchesModel registry model
registryTraceMatches (raw :: rest) registry model =
  registryMatchesModel registry model
    && registryTraceMatches
      rest
      (if bounded raw 3 == 0 then
        regDelete (scriptIdent raw) registry
      else
        regInsert (scriptIdent raw) (scriptValue raw) registry)
      (if bounded raw 3 == 0 then
        modelDelete (scriptIdent raw) model
      else
        modelPut (scriptIdent raw) (scriptValue raw) model)

registryScriptLaw : List Int -> Bool
registryScriptLaw raw = registryTraceMatches raw regEmpty []

-- `MultiRegistry` has no delete: the independent model keeps a per-key list
-- in the same newest-first order promised by `mregAdd`.
multiModelAdd : Ident -> Int -> List (Ident, List Int) -> List (Ident, List Int)
multiModelAdd ident value [] = [(ident, [value])]
multiModelAdd ident value ((other, values) :: rest) =
  if ident == other then
    (ident, value :: values) :: rest
  else
    (other, values) :: multiModelAdd ident value rest

multiModelLookup : Ident -> List (Ident, List Int) -> List Int
multiModelLookup _ [] = []
multiModelLookup ident ((other, values) :: rest) =
  if ident == other then values else multiModelLookup ident rest

multiRun : List Int -> MultiRegistry Int
multiRun raw = multiRunGo raw mregEmpty

multiRunGo : List Int -> MultiRegistry Int -> MultiRegistry Int
multiRunGo [] registry = registry
multiRunGo (raw :: rest) registry =
  multiRunGo rest (mregAdd (scriptIdent raw) (scriptValue raw) registry)

multiModel : List Int -> List (Ident, List Int)
multiModel raw = multiModelGo raw []

multiModelGo : List Int -> List (Ident, List Int) -> List (Ident, List Int)
multiModelGo [] model = model
multiModelGo (raw :: rest) model =
  multiModelGo rest (multiModelAdd (scriptIdent raw) (scriptValue raw) model)

multiMatchesModel : MultiRegistry Int -> List (Ident, List Int) -> Bool
multiMatchesModel registry model =
  mregSize registry == listLen model
    && multiKeysMatch registry model scriptIdents

multiKeysMatch : MultiRegistry Int ->
  List (Ident, List Int) ->
  List Ident ->
  Bool
multiKeysMatch _ _ [] = True
multiKeysMatch registry model (ident :: rest) =
  mregLookup ident registry == multiModelLookup ident model
    && multiKeysMatch registry model rest

setModelAdd : Ident -> List Ident -> List Ident
setModelAdd ident [] = [ident]
setModelAdd ident (other :: rest) =
  if ident == other then other :: rest else other :: setModelAdd ident rest

setModelMember : Ident -> List Ident -> Bool
setModelMember _ [] = False
setModelMember ident (other :: rest) =
  ident == other || setModelMember ident rest

setRun : List Int -> SetRegistry
setRun raw = setRunGo raw sregEmpty

setRunGo : List Int -> SetRegistry -> SetRegistry
setRunGo [] registry = registry
setRunGo (raw :: rest) registry =
  setRunGo rest (sregAdd (scriptIdent raw) registry)

setModel : List Int -> List Ident
setModel raw = setModelGo raw []

setModelGo : List Int -> List Ident -> List Ident
setModelGo [] model = model
setModelGo (raw :: rest) model =
  setModelGo rest (setModelAdd (scriptIdent raw) model)

setMatchesModel : SetRegistry -> List Ident -> Bool
setMatchesModel registry model =
  sregSize registry == listLen model && setKeysMatch registry model scriptIdents

setKeysMatch : SetRegistry -> List Ident -> List Ident -> Bool
setKeysMatch _ _ [] = True
setKeysMatch registry model (ident :: rest) =
  sregMember ident registry == setModelMember ident model
    && setKeysMatch registry model rest

-- SpellingPop keeps a floor for every spelling plus identity-indexed rows. The
-- model is intentionally just association lists; it does not reuse an OrdMap.
scriptSpelling : Int -> String
scriptSpelling raw = if bounded raw 2 == 0 then "same" else "other"

scriptOwner : Int -> String
scriptOwner raw = "owner-\{bounded (raw / 11) 3}"

rowIdent : (Ident, String, Int) -> Ident
rowIdent (ident, _, _) = ident

modelRowsAt : String ->
  List (String, List (Ident, String, Int)) ->
  List (Ident, String, Int)
modelRowsAt _ [] = []
modelRowsAt spelling ((other, rows) :: rest) =
  if spelling == other then rows else modelRowsAt spelling rest

modelFloorAt : String -> List (String, Int) -> Option Int
modelFloorAt _ [] = None
modelFloorAt spelling ((other, value) :: rest) =
  if spelling == other then Some value else modelFloorAt spelling rest

modelReplaceRow : Ident ->
  (Ident, String, Int) ->
  List (Ident, String, Int) ->
  List (Ident, String, Int)
modelReplaceRow _ row [] = [row]
modelReplaceRow ident row (prior :: rest) =
  if rowIdent prior == ident then
    modelReplaceRow ident row rest
  else
    prior :: modelReplaceRow ident row rest

modelRowsPut : String ->
  (Ident, String, Int) ->
  List (String, List (Ident, String, Int)) ->
  List (String, List (Ident, String, Int))
modelRowsPut spelling row [] = [(spelling, [row])]
modelRowsPut spelling row ((other, rows) :: rest) =
  if spelling == other then
    (other, modelReplaceRow (rowIdent row) row rows) :: rest
  else
    (other, rows) :: modelRowsPut spelling row rest

modelFloorPut : String -> Int -> List (String, Int) -> List (String, Int)
modelFloorPut spelling value [] = [(spelling, value)]
modelFloorPut spelling value ((other, prior) :: rest) =
  if spelling == other then
    (other, value) :: rest
  else
    (other, prior) :: modelFloorPut spelling value rest

spellingRun : List Int -> SpellingPop Int
spellingRun raw = spellingRunGo raw spEmpty

spellingRunGo : List Int -> SpellingPop Int -> SpellingPop Int
spellingRunGo [] pop = pop
spellingRunGo (raw :: rest) pop =
  let spelling = scriptSpelling raw
  let value = scriptValue raw
  let next =
    if bounded raw 3 == 0 then
      spInsert (Some (scriptIdent raw)) spelling (scriptOwner raw) value pop
    else
      spInsert None spelling (scriptOwner raw) value pop
  spellingRunGo rest next

spellingModel : List Int ->
  (List (String, List (Ident, String, Int)), List (String, Int))
spellingModel raw = spellingModelGo raw ([], [])

spellingModelGo : List Int ->
  (List (String, List (Ident, String, Int)), List (String, Int)) ->
  (List (String, List (Ident, String, Int)), List (String, Int))
spellingModelGo [] model = model
spellingModelGo (raw :: rest) (rows, floor) =
  let spelling = scriptSpelling raw
  let value = scriptValue raw
  let nextRows =
    if bounded raw 3 == 0 then
      modelRowsPut spelling (scriptIdent raw, scriptOwner raw, value) rows
    else
      rows
  spellingModelGo rest (nextRows, modelFloorPut spelling value floor)

spellingMatchesModel : SpellingPop Int ->
  (List (String, List (Ident, String, Int)), List (String, Int)) ->
  Bool
spellingMatchesModel pop (rows, floor) =
  spellingAtMatches pop rows floor "same"
    && spellingAtMatches pop rows floor "other"

spellingAtMatches : SpellingPop Int ->
  List (String, List (Ident, String, Int)) ->
  List (String, Int) ->
  String ->
  Bool
spellingAtMatches pop rows floor spelling =
  spCandsOf spelling pop == modelRowsAt spelling rows
    && omLookup spelling (spFloor pop) == modelFloorAt spelling floor
    && collisionMatches pop rows spelling

collisionMatches : SpellingPop Int ->
  List (String, List (Ident, String, Int)) ->
  String ->
  Bool
collisionMatches pop rows spelling =
  let collided = listLen (modelRowsAt spelling rows) >= 2
  listLen (filterList (== spelling) (spCollided pop)) == 1 == collided

-- Composite keys cover singleton, tuples, ordinals, and shifting a position.
-- Equality is derived independently of the opaque renderer, so this catches a
-- renderer collision without parsing renderer bytes.
scriptRegKey : Int -> RegKey
scriptRegKey raw = match bounded raw 4
  0 => regKeyNAt [scriptIdent raw] [bounded (raw / 5) 3]
  1 => regKeyNAt [scriptIdent raw, scriptIdent (raw / 7)] [bounded (raw / 11) 3]
  2 =>
    regKeyNAt
      [scriptIdent (raw / 13)]
      [bounded (raw / 17) 3, bounded (raw / 19) 3]
  _ =>
    regKeyNAt
      [scriptIdent raw, scriptIdent (raw / 23)]
      [bounded (raw / 29) 3, bounded (raw / 31) 3]

prop "registry operation script agrees with a list model" (raw : List Int) =
  registryScriptLaw raw

prop "multi-registry operation script agrees with a list model" (raw : List Int) =
  multiMatchesModel (multiRun raw) (multiModel raw)

prop "set-registry operation script agrees with a list model" (raw : List Int) =
  setMatchesModel (setRun raw) (setModel raw)

prop "spelling population operation script agrees with a list model" (raw : List Int) =
  spellingMatchesModel (spellingRun raw) (spellingModel raw)

prop "ident render equality is identity equality across namespace and origin" (left : Int) (right : Int) =
  identKey (scriptIdent left)
    == identKey (scriptIdent right)
    == (scriptIdent left == scriptIdent right)

prop "composite registry renderer is injective on bounded key shapes" (left : Int) (right : Int) =
  regKeyRender (scriptRegKey left)
    == regKeyRender (scriptRegKey right)
    == (scriptRegKey left == scriptRegKey right)
