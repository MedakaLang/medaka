-- Tests of `types.tc_mark`'s own API: the sites and occurrences the mark pass mints through
-- `markGroupClauses`, the clause map it applies to a group (`mapGroupClauses`), the name sets it
-- marks with (`constrainedSigNames`, `markDictNames`), the write-back of marked clauses
-- (`rebuildGroupDecls`), the occurrence spelling and shadow tables behind the mark sets
-- (`moduleSpellsShadowBare`, `shadowSymSpelledBare`, `computeMangledShadowMap`,
-- `buildStandaloneShadowsGraph`), and the mark sets a module may name (`methodMarkCtx`) and
-- those it marks with (`moduleMarkCtx`). The fixtures that build a module marking and read the
-- marked clauses live in `tc_occurrence_test`, whose own tests read the cells the pass mints;
-- the shadow fixtures live in `tc_shadow_test`.

import test.{
  expectEqual,
  expectAll,
  expectEach,
  expectFalse,
  expectTrue,
}
import frontend.ast.{
  Decl(..),
  EvId(..),
  Expr(..),
  Route(..),
}
import frontend.desugar.{
  desugar,
}
import frontend.parser.{
  parse,
}
import support.ordmap.{
  omEmpty,
  omInsert,
  omKeys,
}
import types.tc_env.{
  envFor,
}
import types.tc_mark.{
  constrainedSigNames,
  mapGroupClauses,
  markDictNames,
  finishModuleMarking,
  markGroupClauses,
  markTailDecls,
  rebuildGroupDecls,
  buildStandaloneShadowsGraph,
  computeMangledShadowMap,
  methodMarkCtx,
  moduleMarkCtx,
  moduleSpellsShadowBare,
  shadowBareName,
  shadowSymSpelledBare,
}
import types.tc_occurrence.{
  siteHeadCell,
  siteRouteCell,
}
import types.tc_shadow.{
  methodCellLookup,
}
import types.tc_state.{
  probeGraphCtx,
}
import types.tc_test_support.{
  scoped,
  intM,
}
import types.tc_types.{
  ModuleCtx(..),
  SiteCell(..),
  BareLocals(..),
  GraphCtx(..),
  MarkCtx(..),
  MarkSets(..),
}
