-- Production-path observations for nominal typechecker scopes and givens.
-- Every scope id is projected while its request graph is still live.  Tests
-- compare immutable module/owner labels across requests, never raw ordinals.

import test.{expectAll, expectEqual}
import frontend.ast.{Loc(..), Route(..), TyConOrigin(..)}
import frontend.desugar.{desugar}
import frontend.parser.{parse, parseLocated}
import types.evidence.{EvidenceBinderId(..), ScopeId}
import types.repr.{ppMono, ppScheme}
import types.typecheck.{
  AssumptionTraceEntry(..),
  AssumptionTraceKind(..),
  DefaultBodyRNoneKind(..),
  DefaultBodyRNoneTraceEntry(..),
  ModDiags,
  NumericPredicateTraceEntry(..),
  NumericPredicateTraceStage(..),
  beginAssumptionTrace,
  beginDefaultBodyRNoneTrace,
  beginNumericPredicateTrace,
  checkModulesDiagsChain,
  checkOneDiags,
  checkOneSchemeFullK,
  checkProgramDiags,
  elaborateDict,
  finishAssumptionTrace,
  finishDefaultBodyRNoneTrace,
  finishNumericPredicateTrace,
  scopeFrameStats,
  scopeTraceContext,
  tcMsg,
}
import support.util.{joinNl, listLen}

data NumericTraceView = NumericTraceView {
  ntvStage : NumericPredicateTraceStage,
  ntvInterface : String,
  ntvArguments : List String,
  ntvOwner : String,
  ntvSelected : String,
  ntvRoute : String,
  ntvForwarded : Bool,
  ntvPrerequisites : List String,
}
  deriving (Eq, Debug)

numericRouteView : Route -> String
numericRouteView RNone = "none"
numericRouteView (RKey key prerequisites) =
  "\{key}[\{joinNl (map numericRouteView prerequisites)}]"
numericRouteView (RDict name) = "dict:" ++ name
numericRouteView (RDictFwd name) = "given:" ++ name
numericRouteView (RLocal name _) = "local:" ++ name
numericRouteView (RScalar name) = "scalar:" ++ name

numericTraceView : NumericPredicateTraceEntry -> NumericTraceView
numericTraceView entry =
  let predicate = entry.nptPredicate
  let iface = predicate.predicateInterface
  let origin = match iface.irOrigin
    OriginModule name => name
    _ => "<non-module>"
  let selected = match entry.nptSelectedInterface
    Some identity => identity.irName
    None => ""
  let route = match entry.nptRoute
    Some answer => numericRouteView answer
    None => ""
  NumericTraceView {
    ntvStage = entry.nptStage,
    ntvInterface = "\{origin}::\{iface.irName}",
    ntvArguments = map ppMono predicate.predicateArguments,
    ntvOwner = snd (scopeTraceContext entry.nptScope),
    ntvSelected = selected,
    ntvRoute = route,
    ntvForwarded = match entry.nptRoute
      Some (RDictFwd _) => True
      _ => False,
    ntvPrerequisites = map numericRouteView entry.nptPrerequisites,
  }

numericPreludeSource : String
numericPreludeSource = joinNl [
  "interface Num a where",
  "  fromInt : Int -> a",
  "impl Num Int where",
  "  fromInt n = n",
]

numericValueSource : Bool -> String
numericValueSource collision = numericBodySource collision "N n"

numericBodySource : Bool -> String -> String
numericBodySource collision body =
  joinNl
    (["data N = N Int"]
      ++ (if collision then
        [
          "interface Forge a where",
          "  fromInt : Int -> a",
          "impl Forge N where",
          "  fromInt n = N n",
        ]
      else
        [])
      ++ [
        "impl Num N where",
        "  fromInt n = " ++ body,
        "value : N",
        "value = 1",
      ])

numericCheckObserved : String -> (List String, List NumericTraceView)
numericCheckObserved source =
  beginNumericPredicateTrace ()
  let (errors, _) = checkOneDiags [] (desugar (parse numericPreludeSource)) (
    "numeric_predicate",
    desugar (parseLocated source),
  )
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (map tcMsg errors, trace)

numericStages : List NumericTraceView -> List NumericPredicateTraceStage
numericStages views = map (view => view.ntvStage) views

test "a fromInt collision cannot hide an invalid Num constructor argument" =
  let collision = numericCheckObserved (numericBodySource True "N \"wrong\"")
  let control = numericCheckObserved (numericBodySource False "N \"wrong\"")
  expectEqual
    (["Type mismatch: Int vs String"], ["Type mismatch: Int vs String"])
    (fst collision, fst control)

test "a fromInt collision cannot hide an invalid Num method result" =
  let collision = numericCheckObserved (numericBodySource True "\"wrong\"")
  let control = numericCheckObserved (numericBodySource False "\"wrong\"")
  expectEqual
    (["Type mismatch: N vs String"], ["Type mismatch: N vs String"])
    (fst collision, fst control)

numericNestedBodySource : String
numericNestedBodySource = joinNl [
  "data Box a = Box a",
  "interface Forge a where",
  "  fromInt : Int -> a",
  "impl Num (Box a) requires Num a where",
  "  fromInt _ = Box 1",
  "value : Box Int",
  "value = 1",
]

test "a nested numeric literal may use the declared impl prerequisite" =
  let (errors, _) = numericCheckObserved numericNestedBodySource
  expectEqual [] errors

test "numeric return keeps the Num predicate through production checking and stamping" =
  let (errors, trace) = numericCheckObserved (numericValueSource True)
  expectAll [
    expectEqual [] errors,
    expectEqual [NPTProduced, NPTChecked, NPTReturn] (numericStages trace),
    expectEqual
      [
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        trace),
    expectEqual
      [("Num", "core::Num|N|[]", [])]
      (map
        (view => (view.ntvSelected, view.ntvRoute, view.ntvPrerequisites))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return without a method collision preserves the short route ABI" =
  let (errors, trace) = numericCheckObserved (numericValueSource False)
  expectAll [
    expectEqual [] errors,
    expectEqual
      ["N[]"]
      (map
        (view => view.ntvRoute)
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "a Forge instance cannot discharge the numeric Num obligation" =
  let source = joinNl [
    "data N = N Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge N where",
    "  fromInt n = N n",
    "value : N",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual True (listLen errors > 0),
    expectEqual
      True
      (any
        (view =>
          view.ntvStage == NPTChecked && view.ntvInterface == "core::Num")
        trace),
  ]

test "numeric return forwards the in-scope Num dictionary" =
  let source = joinNl [
    "interface Forge a where",
    "  fromInt : Int -> a",
    "value : Num a => Unit -> a",
    "value _ = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", "", True, [])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvSelected,
          view.ntvForwarded,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return selects prerequisites from the Num instance row" =
  let source = joinNl [
    "data Box a = Box Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge (Box a) where",
    "  fromInt n = Box n",
    "impl Num (Box a) requires Num a where",
    "  fromInt n = Box n",
    "value : Box Int",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", ["Box Int"], "Num", ["Int[]"])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvArguments,
          view.ntvSelected,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

numericSchemeObserved : Option (Int, Int) ->
  String ->
  (List String, List NumericTraceView)
numericSchemeObserved key source =
  beginNumericPredicateTrace ()
  let (_, schemes) = checkOneSchemeFullK key [] (desugar
    (parse numericPreludeSource)) (
    "numeric_scheme",
    desugar (parseLocated source),
  )
  let values =
    map
      (entry => ppScheme (snd entry))
      (filter (entry => fst entry == "value") schemes)
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (values, trace)

numericImportedObserved : Bool -> (Int, List NumericTraceView)
numericImportedObserved reverseOrder =
  let shape = ("numeric_shape", "public export data N = N Int")
  let numeric = (
    "numeric_impl",
    joinNl [
      "import numeric_shape.{N(..)}",
      "impl Num N where",
      "  fromInt n = N n",
    ],
  )
  let forge = (
    "numeric_forge",
    joinNl [
      "import numeric_shape.{N(..)}",
      "export interface Forge a where",
      "  fromInt : Int -> a",
      "impl Forge N where",
      "  fromInt n = N n",
    ],
  )
  let imports =
    if reverseOrder then
      ["import numeric_forge.{Forge, fromInt}", "import numeric_impl"]
    else
      ["import numeric_impl", "import numeric_forge.{Forge, fromInt}"]
  let entry = (
    "numeric_entry",
    joinNl
      (["import numeric_shape.{N}"] ++ imports ++ ["value : N", "value = 1"]),
  )
  let sources =
    if reverseOrder then
      [shape, forge, numeric, entry]
    else
      [shape, numeric, forge, entry]
  beginNumericPredicateTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      (desugar (parse numericPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (modErrorCount results, trace)

test "numeric predicates survive module and import order permutations" =
  let forward = numericImportedObserved False
  let backward = numericImportedObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [NPTProduced, NPTChecked, NPTReturn]
      (numericStages (snd forward)),
    expectEqual
      [("core::Num", "Num", "core::Num|N|[]")]
      (map
        (view => (view.ntvInterface, view.ntvSelected, view.ntvRoute))
        (filter (view => view.ntvStage == NPTReturn) (snd forward))),
  ]

test "finalized scheme queries drain numeric predicates on cold and keyed calls" =
  let source = numericValueSource True
  let cold = numericSchemeObserved None source
  let keyed = numericSchemeObserved (Some (977, 983)) source
  let repeated = numericSchemeObserved (Some (977, 983)) source
  let (failedErrors, _) =
    numericCheckObserved "value : Int\nvalue = \"wrong\"\n"
  let afterFailure = numericSchemeObserved (Some (977, 983)) source
  expectAll [
    expectEqual True (listLen failedErrors > 0),
    expectEqual (["N"], ["N"], ["N"]) (fst cold, fst keyed, fst repeated),
    expectEqual
      [
        [NPTProduced, NPTChecked, NPTReturn],
        [NPTProduced, NPTChecked, NPTReturn],
        [NPTProduced, NPTChecked, NPTReturn],
      ]
      [
        numericStages (snd cold),
        numericStages (snd keyed),
        numericStages (snd repeated),
      ],
    expectEqual (snd cold) (snd keyed),
    expectEqual (snd keyed) (snd repeated),
    expectEqual repeated afterFailure,
  ]
data TraceView = TraceView {
  tvKind : AssumptionTraceKind,
  tvGoalModule : String,
  tvGoalOwner : String,
  tvBinderModule : String,
  tvBinderOwner : String,
  tvSameScope : Bool,
  tvBinder : EvidenceBinderId,
}
  deriving (Eq, Debug)

data RequestView = RequestView {
  rvTrace : List TraceView,
  rvErrors : Int,
  rvFrameCount : Int,
  rvFrameCapacity : Int,
}
  deriving (Eq, Debug)

data DefaultTraceView = DefaultTraceView {
  dtvIfaceModule : String,
  dtvIfaceName : String,
  dtvMethod : String,
  dtvCallee : String,
  dtvKind : DefaultBodyRNoneKind,
  dtvScopeModule : String,
  dtvScopeOwner : String,
  dtvStartLine : Int,
}
  deriving (Eq, Debug)

data ModuleTraceView = ModuleTraceView {
  mtvDefaults : List DefaultTraceView,
  mtvAssumptions : List TraceView,
  mtvErrors : Int,
}

data ContextView = ContextView {
  cvKind : AssumptionTraceKind,
  cvGoalModule : String,
  cvGoalOwner : String,
  cvBinderModule : String,
  cvBinderOwner : String,
  cvSameScope : Bool,
}
  deriving (Eq, Debug)

traceView : AssumptionTraceEntry -> TraceView
traceView entry =
  let (EvidenceBinderId binderScope _) = entry.atBinder
  let (goalModule, goalOwner) = scopeTraceContext entry.atGoalScope
  let (binderModule, binderOwner) = scopeTraceContext binderScope
  TraceView {
    tvKind = entry.atKind,
    tvGoalModule = goalModule,
    tvGoalOwner = goalOwner,
    tvBinderModule = binderModule,
    tvBinderOwner = binderOwner,
    tvSameScope = entry.atGoalScope == binderScope,
    tvBinder = entry.atBinder,
  }

-- This recursion forces every context projection before the next request can
-- reset the graph that owns the request-local ScopeIds.
traceViewsNow : List AssumptionTraceEntry -> List TraceView
traceViewsNow entries = map traceView entries

defaultTraceView : DefaultBodyRNoneTraceEntry -> DefaultTraceView
defaultTraceView entry =
  let owner = entry.dbrOwner
  let ifaceModule = match owner.dbiIface.irOrigin
    OriginModule m => m
    OriginBuiltin => "<builtin>"
    OriginUnresolved => "<unresolved>"
  let (scopeModule, scopeOwner) = scopeTraceContext entry.dbrScope
  let startLine = match entry.dbrOrigin
    Some (Loc _ line _ _ _) => line
    None => 0
  DefaultTraceView {
    dtvIfaceModule = ifaceModule,
    dtvIfaceName = owner.dbiIface.irName,
    dtvMethod = owner.dbiMethod,
    dtvCallee = entry.dbrCallee,
    dtvKind = entry.dbrKind,
    dtvScopeModule = scopeModule,
    dtvScopeOwner = scopeOwner,
    dtvStartLine = startLine,
  }

runModulesObserved : List (String, String) -> ModuleTraceView
runModulesObserved sources =
  beginAssumptionTrace ()
  beginDefaultBodyRNoneTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      []
      (map (entry => (fst entry, desugar (parseLocated (snd entry)))) sources)
  let defaultEntries = finishDefaultBodyRNoneTrace ()
  let assumptionEntries = finishAssumptionTrace ()
  ModuleTraceView {
    mtvDefaults = map defaultTraceView defaultEntries,
    mtvAssumptions = traceViewsNow assumptionEntries,
    mtvErrors = modErrorCount results,
  }

runObserved : String -> String -> RequestView
runObserved moduleId source =
  beginAssumptionTrace ()
  let (errors, _) = checkOneDiags [] [] (moduleId, desugar (parse source))
  let entries = finishAssumptionTrace ()
  let views = traceViewsNow entries
  let (count, capacity) = scopeFrameStats ()
  RequestView {
    rvTrace = views,
    rvErrors = listLen errors,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

modErrorCount : List ModDiags -> Int
modErrorCount [] = 0
modErrorCount ((_, (_, errors, _)) :: rest) =
  listLen errors + modErrorCount rest

runCachedObserved : String -> RequestView
runCachedObserved entrySource =
  beginAssumptionTrace ()
  let results =
    checkModulesDiagsChain
      (Some (731, 733))
      "typecheck-scope-cache"
      [Some "stable-prefix-v1", None]
      []
      []
      [
        ("cache_prefix", desugar (parse scalarSource)),
        ("cache_entry", desugar (parse entrySource)),
      ]
  let entries = finishAssumptionTrace ()
  let views = traceViewsNow entries
  let (count, capacity) = scopeFrameStats ()
  RequestView {
    rvTrace = views,
    rvErrors = modErrorCount results,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

withoutBinderIds : List TraceView -> List ContextView
withoutBinderIds views =
  map
    (view => ContextView {
      cvKind = view.tvKind,
      cvGoalModule = view.tvGoalModule,
      cvGoalOwner = view.tvGoalOwner,
      cvBinderModule = view.tvBinderModule,
      cvBinderOwner = view.tvBinderOwner,
      cvSameScope = view.tvSameScope,
    })
    views

context : AssumptionTraceKind -> String -> String -> ContextView
context kind moduleId owner = ContextView {
  cvKind = kind,
  cvGoalModule = moduleId,
  cvGoalOwner = owner,
  cvBinderModule = moduleId,
  cvBinderOwner = owner,
  cvSameScope = True,
}

directSource : String
directSource = joinNl [
  "data Wrap a = Wrap a",
  "data Box a = Box a",
  "data Other a = Other a",
  "interface D t where",
  "  d : t -> Int",
  "interface C t where",
  "  foo : t -> Int",
  "impl D (Wrap a) where",
  "  d _ = 99",
  "impl C (Box a) requires D (Wrap a) where",
  "  foo (Box x) = d (Wrap x)",
  "impl C (Other a) requires D (Wrap a) where",
  "  foo (Other x) = d (Wrap x)",
]

scalarSource : String
scalarSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "f : D a => a -> Int",
  "f x = d x",
]

superSource : String
superSource = joinNl [
  "data Wrap a = Wrap a",
  "interface Base t where",
  "  base : t -> Int",
  "interface Sub t requires Base t where",
  "  sub : t -> Int",
  "f : Sub (Wrap a) => Wrap a -> Int",
  "f x = base x",
]

failedSource : String
failedSource = "bad : Int\nbad = True\n"

conflictingSource : String
conflictingSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "impl D Int where",
  "  d _ = 1",
  "impl D Int where",
  "  d _ = 2",
]

test "direct predicate evidence keeps same-rendering binders nominal" =
  let observed = runObserved "trace_direct" directSource
  let contexts = withoutBinderIds observed.rvTrace
  let binders = map (entry => entry.tvBinder) observed.rvTrace
  expectEqual
    (
      [
        context ATDirectPredicate "trace_direct" "binding:foo",
        context ATDirectPredicate "trace_direct" "binding:foo",
      ],
      True,
      0,
    )
    (
      contexts,
      match binders
        first :: second :: [] => first /= second
        _ => False,
      observed.rvErrors,
    )

test "scalar and superclass assumption paths remain explicit legacy kinds" =
  let scalar = runObserved "trace_scalar" scalarSource
  let super = runObserved "trace_super" superSource
  expectEqual
    (
      [context ATLegacyScalar "trace_scalar" "binding:f"],
      [context ATLegacySuperclass "trace_super" "binding:f"],
      0,
      0,
    )
    (
      withoutBinderIds scalar.rvTrace,
      withoutBinderIds super.rvTrace,
      scalar.rvErrors,
      super.rvErrors,
    )

requestProjection : RequestView -> (List ContextView, Int)
requestProjection view = (withoutBinderIds view.rvTrace, view.rvFrameCount)

sameProjection : RequestView -> RequestView -> Bool
sameProjection left right = requestProjection left == requestProjection right

test "fresh repeat and failed/conflicting intervening requests retain ownership" =
  let first = runObserved "trace_repeat" scalarSource
  let repeated = runObserved "trace_repeat" scalarSource
  let failed = runObserved "trace_failed" failedSource
  let afterFailed = runObserved "trace_repeat" scalarSource
  let conflicting = runObserved "trace_conflict" conflictingSource
  let afterConflict = runObserved "trace_repeat" scalarSource
  expectEqual
    [True, True, True, True, True, True]
    [
      sameProjection first repeated,
      sameProjection first afterFailed,
      sameProjection first afterConflict,
      failed.rvErrors > 0,
      conflicting.rvErrors > 0,
      first.rvFrameCount <= first.rvFrameCapacity
        && repeated.rvFrameCount <= repeated.rvFrameCapacity
        && afterFailed.rvFrameCount <= afterFailed.rvFrameCapacity
        && afterConflict.rvFrameCount <= afterConflict.rvFrameCapacity,
    ]

test "module-chain cache hits restore bounded scopes across failing suffixes" =
  let cold = runCachedObserved "entry = 0\n"
  let hit = runCachedObserved "entry = 0\n"
  let failed = runCachedObserved failedSource
  let afterFailed = runCachedObserved "entry = 0\n"
  let conflicting = runCachedObserved conflictingSource
  let afterConflict = runCachedObserved "entry = 0\n"
  expectEqual
    [True, True, True, True, True, True, True]
    [
      withoutBinderIds cold.rvTrace
        == [context ATLegacyScalar "cache_prefix" "binding:f"],
      hit.rvTrace == [],
      afterFailed.rvTrace == [],
      afterConflict.rvTrace == [],
      cold.rvFrameCount == hit.rvFrameCount
        && cold.rvFrameCount == afterFailed.rvFrameCount
        && cold.rvFrameCount == afterConflict.rvFrameCount,
      failed.rvErrors > 0 && conflicting.rvErrors > 0,
      cold.rvFrameCount <= cold.rvFrameCapacity
        && hit.rvFrameCount <= hit.rvFrameCapacity
        && afterFailed.rvFrameCount <= afterFailed.rvFrameCapacity
        && afterConflict.rvFrameCount <= afterConflict.rvFrameCapacity,
    ]

mixedAttrFirstSource : String
mixedAttrFirstSource = joinNl [
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "interface Num a b where",
  "  fromInt : String -> a",
  "main = 1",
]

mixedDirectFirstSource : String
mixedDirectFirstSource = joinNl [
  "interface Num a b where",
  "  fromInt : String -> a",
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "main = 1",
]

flatMessages : String -> List String
flatMessages source =
  let (errors, _) = checkProgramDiags [] [] (desugar (parse source))
  map tcMsg errors

test "attributed-direct Num declarations reject mismatches without cross-pairing rows" =
  expectEqual
    (
      ["Type mismatch: String vs Int"],
      ["Type mismatch: String vs Int"],
    )
    (flatMessages mixedAttrFirstSource, flatMessages mixedDirectFirstSource)

test "Flat unresolved interface givens remain legacy" =
  let source = joinNl [
    "data Wrap a = Wrap a",
    "interface D t where",
    "  d : t -> Int",
    "g : D (Wrap a) => a -> Int",
    "g _ = 5",
    "h : D (Wrap a) => a -> Int",
    "h x = g x",
  ]
  beginAssumptionTrace ()
  let _ = elaborateDict [] ["g", "h"] ["g", "h"] (desugar (parse source))
  let flatKinds = map (entry => entry.atKind) (finishAssumptionTrace ())
  let resolved = runObserved "resolved_given" source
  expectEqual
    (
      [ATLegacyPredicate],
      [context ATDirectPredicate "resolved_given" "binding:h"],
      0,
    )
    (flatKinds, withoutBinderIds resolved.rvTrace, resolved.rvErrors)

test "id-witnessed impl givens remain legacy" =
  let source = joinNl [
    "interface D t where",
    "  d : t -> Int",
    "data Box a = Box a",
    "interface C t where",
    "  foo : t -> Int",
    "impl C (Box a) requires D a where",
    "  foo (Box x) = d x",
  ]
  let observed = runObserved "id_assisted" source
  expectEqual
    ([context ATLegacyPredicate "id_assisted" "binding:foo"], 0)
    (withoutBinderIds observed.rvTrace, observed.rvErrors)

binderOrdinal : EvidenceBinderId -> Int
binderOrdinal (EvidenceBinderId _ ordinal) = ordinal

assumptionShape : TraceView -> (AssumptionTraceKind, Int, String, String, Bool)
assumptionShape view = (
  view.tvKind,
  binderOrdinal view.tvBinder,
  view.tvGoalOwner,
  view.tvBinderOwner,
  view.tvSameScope,
)

supplySource : String
supplySource = joinNl [
  "export default interface Supply a where",
  "  seed : a",
  "  copy : a",
  "  copy = seed",
]

mixedDefaultSource : String
mixedDefaultSource = joinNl [
  "interface Base a where",
  "  base : a -> Int",
  "interface Other a where",
  "  other : a -> Int",
  "default interface Rich a requires Base a where",
  "  peer : a -> Int",
  "  mixed : Rich b => Other c => a -> b -> c -> Int",
  "  mixed x y z =",
  "    let local _ = peer x",
  "    let _ = local ()",
  "    let _ = peer y",
  "    let _ = other z",
  "    base y",
]

test "genuine inherited Supply return keeps full default owner and parser origin" =
  let observed = runModulesObserved [("supply_iface", supplySource)]
  expectEqual
    (
      [
        DefaultTraceView {
          dtvIfaceModule = "supply_iface",
          dtvIfaceName = "Supply",
          dtvMethod = "copy",
          dtvCallee = "seed",
          dtvKind = DBRKReturn,
          dtvScopeModule = "supply_iface",
          dtvScopeOwner = "default:copy",
          dtvStartLine = 4,
        },
      ],
      0,
    )
    (observed.mtvDefaults, observed.mtvErrors)

test "mixed default separates argument fallback from qualified givens" =
  let observed = runModulesObserved [("mixed_default", mixedDefaultSource)]
  expectEqual
    (
      [
        DefaultTraceView {
          dtvIfaceModule = "mixed_default",
          dtvIfaceName = "Rich",
          dtvMethod = "mixed",
          dtvCallee = "peer",
          dtvKind = DBRKArg,
          dtvScopeModule = "mixed_default",
          dtvScopeOwner = "default:mixed",
          dtvStartLine = 9,
        },
      ],
      [
        (ATLegacySuperclass, 0, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 1, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 0, "default:mixed", "default:mixed", True),
      ],
      0,
    )
    (
      observed.mtvDefaults,
      map assumptionShape observed.mtvAssumptions,
      observed.mtvErrors,
    )

test "same spelling retains module identity while impl bodies stay ordinary" =
  let colliding = runModulesObserved [
    ("owner_a", supplySource),
    ("owner_b", supplySource),
  ]
  let synthesized = runModulesObserved [
    (
      "owner_same",
      supplySource ++ "\nimpl Supply Int where\n  seed = 41\n",
    ),
  ]
  let explicit = runModulesObserved [
    (
      "ordinary_impl",
      joinNl [
        "interface Echo a where",
        "  echo : a -> a",
        "impl Echo Int where",
        "  echo x = echo x",
      ],
    ),
  ]
  let concrete = runModulesObserved [
    (
      "concrete_default",
      joinNl [
        "data Token = Token",
        "default interface Concrete a where",
        "  echo : a -> a",
        "  echo x = x",
        "  use : a -> Token",
        "  use _ = echo Token",
        "impl Concrete Token where",
      ],
    ),
  ]
  expectEqual
    (
      ["owner_a", "owner_b"],
      (1, [], []),
      [0, 0, 0, 0],
    )
    (
      map (entry => entry.dtvIfaceModule) colliding.mtvDefaults,
      (
        listLen synthesized.mtvDefaults,
        explicit.mtvDefaults,
        concrete.mtvDefaults,
      ),
      [
        colliding.mtvErrors,
        synthesized.mtvErrors,
        explicit.mtvErrors,
        concrete.mtvErrors,
      ],
    )

test "synthesized impl copy retains ordinary binding ownership" =
  let observed = runModulesObserved [
    (
      "specialized_default",
      joinNl [
        "interface Other a where",
        "  other : a -> Int",
        "impl Other Int where",
        "  other x = x",
        "default interface Supply a where",
        "  seed : a",
        "  use : Other b => a -> b -> Int",
        "  use x y = other y",
        "impl Supply Bool where",
        "  seed = False",
      ],
    ),
  ]
  expectEqual
    (
      [
        (ATDirectPredicate, 0, "default:use", "default:use", True),
        (ATDirectPredicate, 0, "binding:use", "binding:use", True),
      ],
      0,
    )
    (map assumptionShape observed.mtvAssumptions, observed.mtvErrors)
