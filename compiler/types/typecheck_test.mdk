      TCon "Int" OriginBuiltin,
      TCon "Float" OriginBuiltin,
      TCon "U8" OriginBuiltin,
      TCon "U16" OriginBuiltin,
      TCon "U32" OriginBuiltin,
      TCon "U64" OriginBuiltin,
      TCon "I32" OriginBuiltin,
      TCon "I64" OriginBuiltin,
      generic,
      linkedInt,
    ])

test "arithmetic keeps missing Num and explicit result mismatches loud" = expectAll
  [
    expectEqual
      ["T-MISSING-CONSTRAINT"]
      (arithmeticErrorCodes "bad : a -> a -> a\nbad x y = x + y\n"),
    expectEqual
      ["T-TYPE-TOO-GENERAL", "T-NO-IMPL"]
      (arithmeticErrorCodes
        "bad : Num a => a -> a -> (a, Bool)\nbad x y = (x + y, x)\n"),
  ]

declaredNumHelperSource : String
declaredNumHelperSource = "value : Num a => Int -> a\nvalue n = fromInt n\n"

schemeVariableCount : Scheme -> Int
schemeVariableCount (Forall variables _ _ _ _ _) = listLen variables

declaredNumSchemeObserved : Option (Int, Int) ->
  String ->
  (List (Int, String), List (String, String, Int))
declaredNumSchemeObserved key source =
  declaredNumMemberSchemeObserved key "value" source

declaredNumMemberSchemeObserved : Option (Int, Int) ->
  String ->
  String ->
  (List (Int, String), List (String, String, Int))
declaredNumMemberSchemeObserved key member source =
  let sink = beginAssumptionTrace ()
  let ((_, schemes), gctx) =
    checkOneSchemeFullKGraph
      (driveArgs (traced sink) False key [] (desugar
        (parse numericPreludeSource)) [
        ("declared_numeric_scheme", desugar (parseLocated source)),
      ])
  let values =
    map
      (entry => (
        schemeVariableCount (snd entry).psScheme,
        ppScheme (snd entry).psScheme,
      ))
      (filter (entry => fst entry == member) schemes)
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext gctx entry.atGoalScope),
          snd (scopeTraceContext gctx binderScope),
          slot,
        ))
      (finishAssumptionTrace sink)
  (values, assumptions)

declaredNumErrorCodes : String -> List String
declaredNumErrorCodes source =
  let (errors, _) = checkOneDiags defaultDriveInputs [] (desugar
    (parse numericPreludeSource)) (
    "declared_numeric_errors",
    desugar (parseLocated source),
  )
  map tcCode errors

test "declared numeric result retains its quantifier and given at finalized queries" =
  let cold = declaredNumSchemeObserved None declaredNumHelperSource
  let keyed =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  let repeated =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  let failed = declaredNumErrorCodes "value : Int\nvalue = \"wrong\"\n"
  let afterFailure =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  expectEach [
    ("cold's arity/scheme", expectEqual [(1, "Int -> a")] (fst cold)),
    (
      "cold's binding trace",
      expectEqual [("binding:value", "binding:value", 0)] (snd cold),
    ),
    ("cold == keyed", expectEqual cold keyed),
    ("keyed == repeated", expectEqual keyed repeated),
    ("repeated == afterFailure", expectEqual repeated afterFailure),
    (
      "a failing declaration produces at least one error",
      expectGreaterThan 0 (listLen failed),
    ),
  ]

test "declared numeric channels include nested results and independent quantifiers" =
  let nested =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : Num a => b -> Int -> (b, a)",
        "value b n = (b, fromInt n)",
      ])
  let returnedFunction =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : Num a => Int -> (Unit -> a)",
        "value n = _ => fromInt n",
      ])
  let independent =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : (Num a, Num b) => Int -> (a, b)",
        "value n = (fromInt n, fromInt n)",
      ])
  expectAll [
    expectEqual [(2, "a -> Int -> (a, b)")] (fst nested),
    expectEqual [(1, "Int -> Unit -> a")] (fst returnedFunction),
    expectEqual [(2, "Int -> (a, b)")] (fst independent),
  ]

test "an unsigned recursive sibling cannot default a declared numeric root" =
  let source = joinNl [
    "value : Num a => Int -> a",
    "value n = if n == 0 then fromInt n else relay (n - 1)",
    "relay n = value n",
  ]
  expectAll [
    expectEqual [(1, "Int -> a")] (fst (declaredNumSchemeObserved None source)),
    expectEqual
      [(1, "Int -> a")]
      (fst (declaredNumMemberSchemeObserved None "relay" source)),
  ]

test "an erased sibling defaults its own contract copy; an expansive sibling fixes the universal" =
  let floatInstance =
    joinNl [
        "impl Num Float where",
        "  fromInt _ = 0.0",
      ]
      ++ "\n"
  let erased =
    floatInstance
      ++ joinNl [
        "consume : a -> Int",
        "consume _ = 1",
        "signed : Num a => Int -> a",
        "signed n = if ping n == 0 then fromInt n else fromInt n",
        "ping n = if n == 0 then 1 else consume (signed (n - 1))",
        "floating : Float",
        "floating = signed 2",
      ]
  let expansive =
    floatInstance
      ++ joinNl [
        "signed : Num a => Int -> a",
        "signed n = if n == 0 then ping else fromInt n",
        "ping = signed 1",
        "floating : Float",
        "floating = signed 0",
      ]
  expectAll [
    expectEqual
      []
      (declaredNumErrorCodes
        (floatInstance
          ++ joinNl [
            "signed : Num a => Int -> a",
            "signed n = fromInt n",
            "floating : Float",
            "floating = signed 2",
          ])),
    expectEqual [] (declaredNumErrorCodes erased),
    expectEqual ["T-TYPE-TOO-GENERAL"] (declaredNumErrorCodes expansive),
  ]

test "declared result protection preserves missing-context and value-restriction errors" = expectAll
  [
    expectEqual
      ["T-MISSING-CONSTRAINT"]
      (declaredNumErrorCodes "value : Int -> a\nvalue n = fromInt n\n"),
    expectEqual
      ["T-SIG-OVER-EXPANSIVE"]
      (declaredNumErrorCodes "value : Num a => a\nvalue = 0\n"),
  ]

test "inferred numeric results still default without a declared caller channel" =
  let literal = declaredNumSchemeObserved None "value = 1\n"
  let helper = declaredNumSchemeObserved None "value n = fromInt n\n"
  expectAll [
    expectEqual [(0, "Int")] (fst literal),
    expectEqual [(0, "Int -> Int")] (fst helper),
  ]

