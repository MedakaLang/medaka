  let generic = TVar (Ref (Unbound 9001 0))
  let linkedInt = TVar (Ref (Link (TCon "Int" OriginBuiltin)))
  expectEqual
    [
      Some "Int",
      Some "Float",
      Some "U8",
      Some "U16",
      Some "U32",
      Some "U64",
      Some "I32",
      Some "I64",
