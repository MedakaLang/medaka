-- Production-path observations for nominal typechecker scopes and givens.
-- Every scope id is projected while its request graph is still live.  Tests
-- compare immutable module/owner labels across requests, never raw ordinals.

import test.{expectAll, expectEqual}
import frontend.ast.{
  Decl(..), EvId(..), EvVal(..), Expr(..), Loc(..), Route(..), TyConOrigin(..)
}
import frontend.desugar.{desugar}
import frontend.parser.{parse, parseLocated}
import eval.eval.{Value(..), evalOne, force}
import ir.core_ir.{CBind(..), CClause(..), CExpr(..), CProgram(..), CStmt(..)}
import ir.core_ir_lower.{
  ifaceMethodArityKey, lowerProgram, methodConstraintIfaces
}
import ir.core_ir_sexp.{cprogramToSexp}
import ir.core_ir_sexp_parse.{parseCProgram}
import types.evidence.{
  EvidenceBinderId(..),
  PrerequisiteEvidence(..),
  RequestInstanceId(..),
  ScopeId,
  SolverEvidence(..),
}
import types.repr.{Scheme(..), ppMono, ppScheme}
import types.solver_contract.{SolverOutcome(..), Wanted(..)}
import types.typecheck.{
  AssumptionTraceEntry(..),
  AssumptionTraceKind(..),
  DefaultBodyRNoneKind(..),
  DefaultBodyRNoneTraceEntry(..),
  MethodReturnMemoView(..),
  MethodReturnTraceEntry(..),
  MethodReturnTraceStage(..),
  ModDiags,
  NumericPredicateTraceEntry(..),
  NumericPredicateTraceStage(..),
  TcDiag(..),
  beginAssumptionTrace,
  beginDefaultBodyRNoneTrace,
  beginMethodReturnTrace,
  beginNumericPredicateTrace,
  checkModulesDiagsChain,
  checkModulesEntryReport,
  checkOneDiags,
  checkOneSchemeFullK,
  elaborateOne,
  finishAssumptionTrace,
  finishDefaultBodyRNoneTrace,
  finishMethodReturnTrace,
  finishNumericPredicateTrace,
  methodReturnResolutionMutationProbe,
  methodReturnMemoCurrentViews,
  methodReturnMemoFenceMutationProbe,
  methodReturnMemoRetentionStats,
  methodReturnMemoTeardownStats,
  methodReturnTemplatePresenceProbe,
  scopeFrameStats,
  scopeTraceContext,
  tcCode,
  tcMsg,
}
import support.util.{contains, joinNl, listLen, lookupAssoc}

data NumericTraceView = NumericTraceView {
  ntvStage : NumericPredicateTraceStage,
  ntvInterface : String,
  ntvArguments : List String,
  ntvOwner : String,
  ntvOrigin : (Int, Int, Int, Int),
  ntvSelected : String,
  ntvSelectedIdentity : String,
  ntvRoute : String,
  ntvGiven : Bool,
  ntvForwarded : Bool,
  ntvPrerequisites : List String,
}
  deriving (Eq, Debug)

numericRouteView : Route -> String
numericRouteView RNone = "none"
numericRouteView (RKey key prerequisites) =
  "\{key}[\{joinNl (map numericRouteView prerequisites)}]"
numericRouteView (RDict name) = "dict:" ++ name
numericRouteView (RDictFwd name) = "given:" ++ name
numericRouteView (RLocal name _) = "local:" ++ name
numericRouteView (RScalar name) = "scalar:" ++ name

numericTraceView : NumericPredicateTraceEntry -> NumericTraceView
numericTraceView entry =
  let predicate = entry.nptPredicate
  let iface = predicate.predicateInterface
  let origin = match iface.irOrigin
    OriginModule name => name
    _ => "<non-module>"
  let selected = match entry.nptSelectedInterface
    Some identity => identity.irName
    None => ""
  let selectedIdentity = match entry.nptSelectedInterface
    Some identity => match identity.irOrigin
      OriginModule name => "\{name}::\{identity.irName}"
      _ => "<non-module>::\{identity.irName}"
    None => ""
  let originSpan = match entry.nptOrigin
    Some (Loc _ startLine startCol endLine endCol) =>
      (startLine, startCol, endLine, endCol)
    None => (0, 0, 0, 0)
  let route = match entry.nptRoute
    Some answer => numericRouteView answer
    None => ""
  NumericTraceView {
    ntvStage = entry.nptStage,
    ntvInterface = "\{origin}::\{iface.irName}",
    ntvArguments = map ppMono predicate.predicateArguments,
    ntvOwner = snd (scopeTraceContext entry.nptScope),
    ntvOrigin = originSpan,
    ntvSelected = selected,
    ntvSelectedIdentity = selectedIdentity,
    ntvRoute = route,
    ntvGiven = match entry.nptRoute
      Some (RDict _) => True
      Some (RDictFwd _) => True
      _ => False,
    ntvForwarded = match entry.nptRoute
      Some (RDictFwd _) => True
      _ => False,
    ntvPrerequisites = map numericRouteView entry.nptPrerequisites,
  }

numericPreludeSource : String
numericPreludeSource = joinNl [
  "interface Num a where",
  "  fromInt : Int -> a",
  "impl Num Int where",
  "  fromInt n = n",
]

numericValueSource : Bool -> String
numericValueSource collision = numericBodySource collision "N n"

numericBodySource : Bool -> String -> String
numericBodySource collision body =
  joinNl
    (["data N = N Int"]
      ++ (if collision then
        [
          "interface Forge a where",
          "  fromInt : Int -> a",
          "impl Forge N where",
          "  fromInt n = N n",
        ]
      else
        [])
      ++ [
        "impl Num N where",
        "  fromInt n = " ++ body,
        "value : N",
        "value = 1",
      ])

numericCheckObserved : String -> (List String, List NumericTraceView)
numericCheckObserved source =
  beginNumericPredicateTrace ()
  let (errors, _) = checkOneDiags [] (desugar (parse numericPreludeSource)) (
    "numeric_predicate",
    desugar (parseLocated source),
  )
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (map tcMsg errors, trace)

numericStages : List NumericTraceView -> List NumericPredicateTraceStage
numericStages views = map (view => view.ntvStage) views

test "a fromInt collision cannot hide an invalid Num constructor argument" =
  let collision = numericCheckObserved (numericBodySource True "N \"wrong\"")
  let control = numericCheckObserved (numericBodySource False "N \"wrong\"")
  expectEqual
    (["Type mismatch: Int vs String"], ["Type mismatch: Int vs String"])
    (fst collision, fst control)

test "a fromInt collision cannot hide an invalid Num method result" =
  let collision = numericCheckObserved (numericBodySource True "\"wrong\"")
  let control = numericCheckObserved (numericBodySource False "\"wrong\"")
  expectEqual
    (["Type mismatch: N vs String"], ["Type mismatch: N vs String"])
    (fst collision, fst control)

numericNestedBodySource : String
numericNestedBodySource = joinNl [
  "data Box a = Box a",
  "interface Forge a where",
  "  fromInt : Int -> a",
  "impl Num (Box a) requires Num a where",
  "  fromInt _ = Box 1",
  "value : Box Int",
  "value = 1",
]

test "a nested numeric literal may use the declared impl prerequisite" =
  let (errors, _) = numericCheckObserved numericNestedBodySource
  expectEqual [] errors

numericSuperclassImplSource : String -> String
numericSuperclassImplSource reqs = joinNl [
  "data Acc b = MkAcc b",
  "interface Fancy a requires Num a where",
  "  fromInt : Int -> a",
  "impl Fancy Float where",
  "  fromInt _ = 42.0",
  "interface Mk a where",
  "  mk : Unit -> a",
  "impl Mk (Acc b) requires " ++ reqs ++ " where",
  "  mk _ = MkAcc 0",
]

test "an impl prerequisite supplies numeric evidence through its superclass" = expectAll
  [
    expectEqual
      []
      (fst (numericCheckObserved (numericSuperclassImplSource "Fancy b"))),
    expectEqual
      []
      (fst
        (numericCheckObserved (numericSuperclassImplSource "Fancy b, Num b"))),
  ]

numericImplHeadSource : String -> String -> String
numericImplHeadSource methodType methodBody = joinNl [
  "data Acc b = MkAcc b",
  "interface Make a where",
  "  make : " ++ methodType,
  "impl Make (Acc b) where",
  "  " ++ methodBody,
]

test "numeric impl-head roots require an explicit prerequisite at nullary and return positions" =
  let nullary =
    fst (numericCheckObserved (numericImplHeadSource "a" "make = MkAcc 0"))
  let returns =
    fst
      (numericCheckObserved
        (numericImplHeadSource "Unit -> a" "make _ = MkAcc 0"))
  let declared = joinNl [
    "data Acc b = MkAcc b",
    "interface Make a where",
    "  make : a",
    "impl Make (Acc b) requires Num b where",
    "  make = MkAcc 0",
  ]
  expectAll [
    expectEqual
      [
        "Impl of 'make' for interface 'Make' requires 'Num' on the instance-head type variable 'b', but the impl does not declare that prerequisite. Add `requires Num b` to the impl.",
      ]
      nullary,
    expectEqual
      [
        "Impl of 'make' for interface 'Make' requires 'Num' on the instance-head type variable 'b', but the impl does not declare that prerequisite. Add `requires Num b` to the impl.",
      ]
      returns,
    expectEqual [] (fst (numericCheckObserved declared)),
  ]

test "numeric return keeps the Num predicate through production checking and stamping" =
  let (errors, trace) = numericCheckObserved (numericValueSource True)
  expectAll [
    expectEqual [] errors,
    expectEqual [NPTProduced, NPTChecked, NPTReturn] (numericStages trace),
    expectEqual
      [
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        trace),
    expectEqual
      [("Num", "core::Num|N|[]", [])]
      (map
        (view => (view.ntvSelected, view.ntvRoute, view.ntvPrerequisites))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return without a method collision preserves the short route ABI" =
  let (errors, trace) = numericCheckObserved (numericValueSource False)
  expectAll [
    expectEqual [] errors,
    expectEqual
      ["N[]"]
      (map
        (view => view.ntvRoute)
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "a Forge instance cannot discharge the numeric Num obligation" =
  let source = joinNl [
    "data N = N Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge N where",
    "  fromInt n = N n",
    "value : N",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual True (listLen errors > 0),
    expectEqual
      True
      (any
        (view =>
          view.ntvStage == NPTChecked && view.ntvInterface == "core::Num")
        trace),
  ]

test "numeric return forwards the in-scope Num dictionary" =
  let source = joinNl [
    "interface Forge a where",
    "  fromInt : Int -> a",
    "value : Num a => Unit -> a",
    "value _ = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", "", True, [])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvSelected,
          view.ntvForwarded,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return selects prerequisites from the Num instance row" =
  let source = joinNl [
    "data Box a = Box Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge (Box a) where",
    "  fromInt n = Box n",
    "impl Num (Box a) requires Num a where",
    "  fromInt n = Box n",
    "value : Box Int",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", ["Box Int"], "Num", ["Int[]"])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvArguments,
          view.ntvSelected,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

numericSchemeObserved : Option (Int, Int) ->
  String ->
  (List String, List NumericTraceView)
numericSchemeObserved key source =
  beginNumericPredicateTrace ()
  let (_, schemes) = checkOneSchemeFullK key [] (desugar
    (parse numericPreludeSource)) (
    "numeric_scheme",
    desugar (parseLocated source),
  )
  let values =
    map
      (entry => ppScheme (snd entry))
      (filter (entry => fst entry == "value") schemes)
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (values, trace)

numericImportedObserved : Bool -> (Int, List NumericTraceView)
numericImportedObserved reverseOrder =
  let shape = ("numeric_shape", "public export data N = N Int")
  let numeric = (
    "numeric_impl",
    joinNl [
      "import numeric_shape.{N(..)}",
      "impl Num N where",
      "  fromInt n = N n",
    ],
  )
  let forge = (
    "numeric_forge",
    joinNl [
      "import numeric_shape.{N(..)}",
      "export interface Forge a where",
      "  fromInt : Int -> a",
      "impl Forge N where",
      "  fromInt n = N n",
    ],
  )
  let imports =
    if reverseOrder then
      ["import numeric_forge.{Forge, fromInt}", "import numeric_impl"]
    else
      ["import numeric_impl", "import numeric_forge.{Forge, fromInt}"]
  let entry = (
    "numeric_entry",
    joinNl
      (["import numeric_shape.{N}"] ++ imports ++ ["value : N", "value = 1"]),
  )
  let sources =
    if reverseOrder then
      [shape, forge, numeric, entry]
    else
      [shape, numeric, forge, entry]
  beginNumericPredicateTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      (desugar (parse numericPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  (modErrorCount results, trace)

test "numeric predicates survive module and import order permutations" =
  let forward = numericImportedObserved False
  let backward = numericImportedObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [NPTProduced, NPTChecked, NPTReturn]
      (numericStages (snd forward)),
    expectEqual
      [("core::Num", "Num", "core::Num|N|[]")]
      (map
        (view => (view.ntvInterface, view.ntvSelected, view.ntvRoute))
        (filter (view => view.ntvStage == NPTReturn) (snd forward))),
  ]

test "prelude-free split graphs retain every builtin class identity" =
  let eqSource = joinNl [
    "export interface Eq a where",
    "  eq : a -> a -> Bool",
    "export impl Eq Int where",
    "  eq x y = x == y",
  ]
  let numSource = joinNl [
    "import eq.{Eq}",
    "export interface Num a requires Eq a where",
    "  fromInt : Int -> a",
    "export impl Num Int where",
    "  fromInt x = x",
  ]
  let useSource = joinNl [
    "import eq",
    "import num",
    "data Box = Box Int",
    "main = (Box 1) == (Box 2)",
  ]
  let oneSource = joinNl [
    "interface Eq a where",
    "  eq : a -> a -> Bool",
    "interface Num a requires Eq a where",
    "  fromInt : Int -> a",
    "impl Eq Int where",
    "  eq x y = x == y",
    "impl Num Int where",
    "  fromInt x = x",
    "data Box = Box Int",
    "main = (Box 1) == (Box 2)",
  ]
  let expected =
    "TYPE ERROR: No impl of Eq for Box; add 'deriving Eq' to the 'Box' type, or write an 'impl Eq Box'."
  expectEqual
    (expected, expected)
    (
      checkModulesEntryReport [] [] [("one", desugar (parse oneSource))],
      checkModulesEntryReport [] [] [
        ("eq", desugar (parse eqSource)),
        ("num", desugar (parse numSource)),
        ("use", desugar (parse useSource)),
      ],
    )

test "finalized scheme queries drain numeric predicates on cold and keyed calls" =
  let source = numericValueSource True
  let cold = numericSchemeObserved None source
  let keyed = numericSchemeObserved (Some (977, 983)) source
  let repeated = numericSchemeObserved (Some (977, 983)) source
  let (failedErrors, _) =
    numericCheckObserved "value : Int\nvalue = \"wrong\"\n"
  let afterFailure = numericSchemeObserved (Some (977, 983)) source
  expectAll [
    expectEqual True (listLen failedErrors > 0),
    expectEqual (["N"], ["N"], ["N"]) (fst cold, fst keyed, fst repeated),
    expectEqual
      [
        [NPTProduced, NPTChecked, NPTReturn],
        [NPTProduced, NPTChecked, NPTReturn],
        [NPTProduced, NPTChecked, NPTReturn],
      ]
      [
        numericStages (snd cold),
        numericStages (snd keyed),
        numericStages (snd repeated),
      ],
    expectEqual (snd cold) (snd keyed),
    expectEqual (snd keyed) (snd repeated),
    expectEqual repeated afterFailure,
  ]

arithmeticPreludeSource : String
arithmeticPreludeSource = joinNl [
  "interface Num a where",
  "  add : a -> a -> a",
  "  sub : a -> a -> a",
  "  mul : a -> a -> a",
  "  div : a -> a -> a",
  "  negate : a -> a",
  "  abs : a -> a",
  "  signum : a -> a",
  "  fromInt : Int -> a",
  "  rem : a -> a -> a",
  "impl Num Int where",
  "  add x _ = x",
  "  sub x _ = x",
  "  mul x _ = x",
  "  div x _ = x",
  "  negate x = x",
  "  abs x = x",
  "  signum x = x",
  "  fromInt n = n",
  "  rem x _ = x",
  "impl Num Float where",
  "  add x _ = x",
  "  sub x _ = x",
  "  mul x _ = x",
  "  div x _ = x",
  "  negate x = x",
  "  abs x = x",
  "  signum x = x",
  "  fromInt _ = 0.0",
  "  rem x _ = x",
]

arithmeticFunctionsSource : String
arithmeticFunctionsSource = joinNl [
  "signedAdd : Num a => a -> a -> a",
  "signedAdd x y = x + y",
  "signedSub : Num a => a -> a -> a",
  "signedSub x y = x - y",
  "signedMul : Num a => a -> a -> a",
  "signedMul x y = x * y",
  "signedDiv : Num a => a -> a -> a",
  "signedDiv x y = x / y",
  "signedRem : Num a => a -> a -> a",
  "signedRem x y = x % y",
  "inferredAdd x y = x + y",
  "inferredSub x y = x - y",
  "inferredMul x y = x * y",
  "inferredDiv x y = x / y",
  "inferredRem x y = x % y",
]

isArithmeticFunction : String -> Bool
isArithmeticFunction name = contains name [
  "signedAdd",
  "signedSub",
  "signedMul",
  "signedDiv",
  "signedRem",
  "inferredAdd",
  "inferredSub",
  "inferredMul",
  "inferredDiv",
  "inferredRem",
]

arithmeticSchemeObserved : Option (Int, Int) ->
  String ->
  (List (String, Int, String), List (String, String, Int))
arithmeticSchemeObserved key source =
  beginAssumptionTrace ()
  let (_, schemes) = checkOneSchemeFullK key [] (desugar
    (parse arithmeticPreludeSource)) (
    "arithmetic_scheme",
    desugar (parseLocated source),
  )
  let values =
    map
      (entry => (
        fst entry,
        schemeVariableCount (snd entry),
        ppScheme (snd entry),
      ))
      (filter (entry => isArithmeticFunction (fst entry)) schemes)
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext entry.atGoalScope),
          snd (scopeTraceContext binderScope),
          slot,
        ))
      (finishAssumptionTrace ())
  (values, assumptions)

arithmeticErrorCodes : String -> List String
arithmeticErrorCodes source =
  let (errors, _) = checkOneDiags [] (desugar (parse arithmeticPreludeSource)) (
    "arithmetic_errors",
    desugar (parseLocated source),
  )
  map tcCode errors

test "declared and inferred arithmetic retain one Num slot at finalized queries" =
  let cold = arithmeticSchemeObserved None arithmeticFunctionsSource
  let keyed =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  let repeated =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  let failed = arithmeticErrorCodes "bad : Int\nbad = \"wrong\"\n"
  let afterFailure =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  expectAll [
    expectEqual
      [
        ("signedAdd", 1, "a -> a -> a"),
        ("signedSub", 1, "a -> a -> a"),
        ("signedMul", 1, "a -> a -> a"),
        ("signedDiv", 1, "a -> a -> a"),
        ("signedRem", 1, "a -> a -> a"),
        ("inferredAdd", 1, "a -> a -> a"),
        ("inferredSub", 1, "a -> a -> a"),
        ("inferredMul", 1, "a -> a -> a"),
        ("inferredDiv", 1, "a -> a -> a"),
        ("inferredRem", 1, "a -> a -> a"),
      ]
      (fst cold),
    expectEqual cold keyed,
    expectEqual keyed repeated,
    expectEqual repeated afterFailure,
    expectEqual True (listLen failed > 0),
    expectEqual
      [
        ("binding:signedRem", "binding:signedRem", 0),
        ("binding:signedDiv", "binding:signedDiv", 0),
        ("binding:signedMul", "binding:signedMul", 0),
        ("binding:signedSub", "binding:signedSub", 0),
        ("binding:signedAdd", "binding:signedAdd", 0),
      ]
      (snd cold),
  ]

arithmeticTraceObserved : String ->
  (List String, List NumericTraceView, List (String, String, Int))
arithmeticTraceObserved source =
  beginNumericPredicateTrace ()
  beginAssumptionTrace ()
  let (errors, _) = checkOneDiags [] (desugar (parse arithmeticPreludeSource)) (
    "arithmetic_trace",
    desugar (parseLocated source),
  )
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext entry.atGoalScope),
          snd (scopeTraceContext binderScope),
          slot,
        ))
      (finishAssumptionTrace ())
  (map tcMsg errors, trace, assumptions)

test "operator events correlate by whole span scope and exact prelude Num predicate" =
  let (errors, trace, assumptions) =
    arithmeticTraceObserved "value : Num a => a -> a\nvalue x = x + 0\n"
  let operator = filter (view => view.ntvOrigin == (2, 10, 2, 15)) trace
  let literal = filter (view => view.ntvOrigin == (2, 14, 2, 15)) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [NPTProduced, NPTChecked, NPTArithmetic]
      (numericStages operator),
    expectEqual [NPTProduced, NPTChecked, NPTReturn] (numericStages literal),
    expectEqual
      [
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        operator),
    expectEqual
      [("", True, [])]
      (map
        (view => (
          view.ntvSelectedIdentity,
          view.ntvGiven,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTArithmetic) operator)),
    expectEqual
      [
        ("binding:value", "binding:value", 0),
        ("binding:value", "binding:value", 0),
      ]
      assumptions,
  ]

test "generic remainder uses the same scoped Num evidence route" =
  let (errors, trace, assumptions) =
    arithmeticTraceObserved "value : Num a => a -> a -> a\nvalue x y = x % y\n"
  let operator = filter (view => view.ntvOrigin == (2, 12, 2, 17)) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [NPTProduced, NPTChecked, NPTArithmetic]
      (numericStages operator),
    expectEqual
      [
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        operator),
    expectEqual
      [("", True, [])]
      (map
        (view => (
          view.ntvSelectedIdentity,
          view.ntvGiven,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTArithmetic) operator)),
    expectEqual [("binding:value", "binding:value", 0)] assumptions,
  ]

arithmeticImportedObserved : Bool -> (Int, List NumericTraceView)
arithmeticImportedObserved reverseOrder =
  let shape = ("arithmetic_shape", "public export data Box a = Box a")
  let numeric = (
    "arithmetic_numeric",
    joinNl [
      "import arithmetic_shape.{Box(..)}",
      "impl Num (Box a) requires Num a where",
      "  add x _ = x",
      "  sub x _ = x",
      "  mul x _ = x",
      "  div x _ = x",
      "  negate x = x",
      "  abs x = x",
      "  signum x = x",
      "  fromInt n = Box (fromInt n)",
      "  rem x _ = x",
    ],
  )
  let forge = (
    "arithmetic_forge",
    joinNl [
      "import arithmetic_shape.{Box}",
      "export interface Forge a where",
      "  add : a -> a -> a",
      "  rem : a -> a -> a",
      "impl Forge (Box a) where",
      "  add x _ = x",
      "  rem x _ = x",
    ],
  )
  let imports =
    if reverseOrder then
      [
        "import arithmetic_forge.{Forge, add, rem}",
        "import arithmetic_numeric",
      ]
    else
      [
        "import arithmetic_numeric",
        "import arithmetic_forge.{Forge, add, rem}",
      ]
  let entry = (
    "arithmetic_entry",
    joinNl
      (["import arithmetic_shape.{Box(..)}"]
        ++ imports
        ++ [
          "left : Box Int",
          "left = Box 12",
          "right : Box Int",
          "right = Box 3",
          "addValue : Box Int",
          "addValue = left + right",
          "subValue : Box Int",
          "subValue = left - right",
          "mulValue : Box Int",
          "mulValue = left * right",
          "divValue : Box Int",
          "divValue = left / right",
          "remValue : Box Int",
          "remValue = left % right",
        ]),
  )
  let sources =
    if reverseOrder then
      [shape, forge, numeric, entry]
    else
      [shape, numeric, forge, entry]
  beginNumericPredicateTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      (desugar (parse arithmeticPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace = map numericTraceView (finishNumericPredicateTrace ())
  let arithmetic =
    filter
      (view =>
        view.ntvStage == NPTArithmetic
          && contains view.ntvOwner [
            "binding:addValue",
            "binding:subValue",
            "binding:mulValue",
            "binding:divValue",
            "binding:remValue",
          ])
      trace
  (modErrorCount results, arithmetic)

test "arithmetic collision imports select the exact Num row and prerequisites" =
  let forward = arithmeticImportedObserved False
  let backward = arithmeticImportedObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [
        (
          "binding:remValue",
          "core::Num",
          "core::Num",
          "core::Num|(Box a)|[]",
          ["Int[]"],
        ),
        ("binding:divValue", "core::Num", "core::Num", "Box[]", ["Int[]"]),
        ("binding:mulValue", "core::Num", "core::Num", "Box[]", ["Int[]"]),
        ("binding:subValue", "core::Num", "core::Num", "Box[]", ["Int[]"]),
        (
          "binding:addValue",
          "core::Num",
          "core::Num",
          "core::Num|(Box a)|[]",
          ["Int[]"],
        ),
      ]
      (map
        (view => (
          view.ntvOwner,
          view.ntvInterface,
          view.ntvSelectedIdentity,
          view.ntvRoute,
          view.ntvPrerequisites,
        ))
        (snd forward)),
  ]

test "primitive arithmetic retains the Int and Float scalar routes" =
  let (errors, trace, _) =
    arithmeticTraceObserved
      (joinNl [
        "intValue : Int",
        "intValue = 12 + 3",
        "floatValue : Float",
        "floatValue = 7.5 / 2.0",
      ])
  let arithmetic = filter (view => view.ntvStage == NPTArithmetic) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [
        ("binding:floatValue", ["Float"], "scalar:Float", "", []),
        ("binding:intValue", ["Int"], "none", "", []),
      ]
      (map
        (view => (
          view.ntvOwner,
          view.ntvArguments,
          view.ntvRoute,
          view.ntvSelectedIdentity,
          view.ntvPrerequisites,
        ))
        arithmetic),
  ]

test "arithmetic keeps missing Num and explicit result mismatches loud" = expectAll
  [
    expectEqual
      ["T-MISSING-CONSTRAINT"]
      (arithmeticErrorCodes "bad : a -> a -> a\nbad x y = x + y\n"),
    expectEqual
      ["T-NO-IMPL"]
      (arithmeticErrorCodes
        "bad : Num a => a -> a -> (a, Bool)\nbad x y = (x + y, x)\n"),
  ]

declaredNumHelperSource : String
declaredNumHelperSource = "value : Num a => Int -> a\nvalue n = fromInt n\n"

schemeVariableCount : Scheme -> Int
schemeVariableCount (Forall variables _ _) = listLen variables

declaredNumSchemeObserved : Option (Int, Int) ->
  String ->
  (List (Int, String), List (String, String, Int))
declaredNumSchemeObserved key source =
  declaredNumMemberSchemeObserved key "value" source

declaredNumMemberSchemeObserved : Option (Int, Int) ->
  String ->
  String ->
  (List (Int, String), List (String, String, Int))
declaredNumMemberSchemeObserved key member source =
  beginAssumptionTrace ()
  let (_, schemes) = checkOneSchemeFullK key [] (desugar
    (parse numericPreludeSource)) (
    "declared_numeric_scheme",
    desugar (parseLocated source),
  )
  let values =
    map
      (entry => (schemeVariableCount (snd entry), ppScheme (snd entry)))
      (filter (entry => fst entry == member) schemes)
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext entry.atGoalScope),
          snd (scopeTraceContext binderScope),
          slot,
        ))
      (finishAssumptionTrace ())
  (values, assumptions)

declaredNumErrorCodes : String -> List String
declaredNumErrorCodes source =
  let (errors, _) = checkOneDiags [] (desugar (parse numericPreludeSource)) (
    "declared_numeric_errors",
    desugar (parseLocated source),
  )
  map tcCode errors

test "declared numeric result retains its quantifier and given at finalized queries" =
  let cold = declaredNumSchemeObserved None declaredNumHelperSource
  let keyed =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  let repeated =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  let failed = declaredNumErrorCodes "value : Int\nvalue = \"wrong\"\n"
  let afterFailure =
    declaredNumSchemeObserved (Some (991, 997)) declaredNumHelperSource
  expectAll [
    expectEqual [(1, "Int -> a")] (fst cold),
    expectEqual [("binding:value", "binding:value", 0)] (snd cold),
    expectEqual cold keyed,
    expectEqual keyed repeated,
    expectEqual repeated afterFailure,
    expectEqual True (listLen failed > 0),
  ]

test "declared numeric channels include nested results and independent quantifiers" =
  let nested =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : Num a => b -> Int -> (b, a)",
        "value b n = (b, fromInt n)",
      ])
  let returnedFunction =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : Num a => Int -> (Unit -> a)",
        "value n = _ => fromInt n",
      ])
  let independent =
    declaredNumSchemeObserved
      None
      (joinNl [
        "value : (Num a, Num b) => Int -> (a, b)",
        "value n = (fromInt n, fromInt n)",
      ])
  expectAll [
    expectEqual [(2, "a -> Int -> (a, b)")] (fst nested),
    expectEqual [(1, "Int -> Unit -> a")] (fst returnedFunction),
    expectEqual [(2, "Int -> (a, b)")] (fst independent),
  ]

test "an unsigned recursive sibling cannot default a declared numeric root" =
  let source = joinNl [
    "value : Num a => Int -> a",
    "value n = if n == 0 then fromInt n else relay (n - 1)",
    "relay n = value n",
  ]
  expectAll [
    expectEqual [(1, "Int -> a")] (fst (declaredNumSchemeObserved None source)),
    expectEqual
      [(1, "Int -> a")]
      (fst (declaredNumMemberSchemeObserved None "relay" source)),
  ]

test "unsupported recursive evidence keeps erased and expansive siblings rejected" =
  let floatInstance =
    joinNl [
        "impl Num Float where",
        "  fromInt _ = 0.0",
      ]
      ++ "\n"
  let erased =
    floatInstance
      ++ joinNl [
        "consume : a -> Int",
        "consume _ = 1",
        "signed : Num a => Int -> a",
        "signed n = if ping n == 0 then fromInt n else fromInt n",
        "ping n = if n == 0 then 1 else consume (signed (n - 1))",
        "floating : Float",
        "floating = signed 2",
      ]
  let expansive =
    floatInstance
      ++ joinNl [
        "signed : Num a => Int -> a",
        "signed n = if n == 0 then ping else fromInt n",
        "ping = signed 1",
        "floating : Float",
        "floating = signed 0",
      ]
  expectAll [
    expectEqual
      []
      (declaredNumErrorCodes
        (floatInstance
          ++ joinNl [
            "signed : Num a => Int -> a",
            "signed n = fromInt n",
            "floating : Float",
            "floating = signed 2",
          ])),
    expectEqual ["T-TYPE-MISMATCH"] (declaredNumErrorCodes erased),
    expectEqual ["T-TYPE-MISMATCH"] (declaredNumErrorCodes expansive),
  ]

test "declared result protection preserves missing-context and value-restriction errors" = expectAll
  [
    expectEqual
      ["T-MISSING-CONSTRAINT"]
      (declaredNumErrorCodes "value : Int -> a\nvalue n = fromInt n\n"),
    expectEqual
      ["T-SIG-OVER-EXPANSIVE"]
      (declaredNumErrorCodes "value : Num a => a\nvalue = 0\n"),
  ]

test "inferred numeric results still default without a declared caller channel" =
  let literal = declaredNumSchemeObserved None "value = 1\n"
  let helper = declaredNumSchemeObserved None "value n = fromInt n\n"
  expectAll [
    expectEqual [(0, "Int")] (fst literal),
    expectEqual [(0, "Int -> Int")] (fst helper),
  ]

