localNumBlockRecSource = joinNl [
  "value : Num a => a -> a",
  "value x =",
  "  let local _ = x + 0",
  "  local ()",
]

localNumBlockLetSource : String
localNumBlockLetSource = joinNl [
  "value : Num a => a -> a",
  "value x =",
  "  let local = x + 0",
  "  local",
]

localNumInferRecSource : String
localNumInferRecSource = joinNl [
  "value : Num a => a -> a",
  "value x = let local _ = x + 0 in local ()",
]

localNumInferLetSource : String
localNumInferLetSource = joinNl [
  "value : Num a => a -> a",
  "value x = let local = x + 0 in local",
]

localNumGroupSource : String
localNumGroupSource = joinNl [
  "value : Num a => a -> a",
  "value x = local ()",
  "  where",
  "    local _ = x + 0",
]

localNumFinalizedScheme : String -> List (Int, String)
localNumFinalizedScheme source = fst (declaredNumSchemeObserved None source)

test "block recursive let preserves an enclosing numeric root" =
  expectEqual [(1, "a -> a")] (localNumFinalizedScheme localNumBlockRecSource)

test "block let preserves an enclosing numeric root" =
  expectEqual [(1, "a -> a")] (localNumFinalizedScheme localNumBlockLetSource)

test "inline recursive let preserves an enclosing numeric root" =
  expectEqual [(1, "a -> a")] (localNumFinalizedScheme localNumInferRecSource)

test "inline let preserves an enclosing numeric root" =
  expectEqual [(1, "a -> a")] (localNumFinalizedScheme localNumInferLetSource)

test "where group preserves an enclosing numeric root" =
  expectEqual [(1, "a -> a")] (localNumFinalizedScheme localNumGroupSource)

