test "each local boundary retains an inferred outer numeric root" =
  expectEqual
    [
      [(1, "a -> a")],
      [(1, "a -> a")],
      [(1, "a -> a")],
      [(1, "a -> a")],
      [(1, "a -> a")],
    ]
    [
      localNumFinalizedScheme localNumInferredBlockRecSource,
      localNumFinalizedScheme localNumInferredBlockLetSource,
      localNumFinalizedScheme localNumInferredInferRecSource,
      localNumFinalizedScheme localNumInferredInferLetSource,
      localNumFinalizedScheme localNumInferredGroupSource,
