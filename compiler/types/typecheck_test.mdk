  let observed =
    map (entry => (fst entry, ppScheme (snd entry).psScheme)) schemes
  expectEqual
    [
      ("blockRec", "a -> Int"),
      ("blockLet", "a -> Int"),
      ("inferRec", "a -> Int"),
      ("inferLet", "a -> Int"),
      ("group", "a -> Int"),
    ]
    observed

localNumMismatchCodes : String -> List String
localNumMismatchCodes body =
  declaredNumErrorCodes
    (joinNl [
      "value : Num a => a -> (a, Bool)",
      body,
    ])

test "local numeric ownership does not admit explicit result mismatches" =
  expectEqual
    [
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
    ]
    [
      localNumMismatchCodes "value x =\n  let local _ = x + 0\n  (local (), 1)",
      localNumMismatchCodes "value x =\n  let local = x + 0\n  (local, 1)",
      localNumMismatchCodes "value x = let local _ = x + 0 in (local (), 1)",
      localNumMismatchCodes "value x = let local = x + 0 in (local, 1)",
      localNumMismatchCodes
        "value x = (local (), 1)\n  where\n    local _ = x + 0",
    ]

data TraceView = TraceView {
  tvKind : AssumptionTraceKind,
  tvGoalModule : String,
  tvGoalOwner : String,
  tvBinderModule : String,
  tvBinderOwner : String,
  tvSameScope : Bool,
  tvBinder : EvidenceBinderId,
} deriving (Eq, Debug)

data RequestView = RequestView {
  rvTrace : List TraceView,
  rvErrors : Int,
  rvFrameCount : Int,
  rvFrameCapacity : Int,
} deriving (Eq, Debug)

data ModuleTraceView = ModuleTraceView {
  mtvAssumptions : List TraceView,
  mtvErrors : Int,
}

data ContextView = ContextView {
  cvKind : AssumptionTraceKind,
  cvGoalModule : String,
  cvGoalOwner : String,
  cvBinderModule : String,
  cvBinderOwner : String,
  cvSameScope : Bool,
} deriving (Eq, Debug)

traceView : GraphCtx -> AssumptionTraceEntry -> TraceView
traceView gctx entry =
  let (EvidenceBinderId binderScope _) = entry.atBinder
  let (goalModule, goalOwner) = scopeTraceContext gctx entry.atGoalScope
  let (binderModule, binderOwner) = scopeTraceContext gctx binderScope
  TraceView {
    tvKind = entry.atKind,
    tvGoalModule = goalModule,
    tvGoalOwner = goalOwner,
    tvBinderModule = binderModule,
    tvBinderOwner = binderOwner,
    tvSameScope = entry.atGoalScope == binderScope,
    tvBinder = entry.atBinder,
  }

-- This recursion forces every context projection before the next request can
-- reset the graph that owns the request-local ScopeIds.
traceViewsNow : GraphCtx -> List AssumptionTraceEntry -> List TraceView
traceViewsNow gctx entries = map (traceView gctx) entries

runModulesObserved : List (String, String) -> ModuleTraceView
runModulesObserved sources =
  let sink = beginAssumptionTrace ()
  let (results, gctx) =
    chainDiagsGraph
      (traced sink)
      None
      ""
      []
      []
      []
      (map (entry => (fst entry, desugar (parseLocated (snd entry)))) sources)
  let assumptionEntries = finishAssumptionTrace sink
  ModuleTraceView {
    mtvAssumptions = traceViewsNow gctx assumptionEntries,
    mtvErrors = modErrorCount results,
  }

runObserved : String -> String -> RequestView
runObserved moduleId source =
  let sink = beginAssumptionTrace ()
  let ((errors, _), gctx) =
    checkOneDiagsGraph
      (driveArgs (traced sink) False None [] [] [
        (moduleId, desugar (parse source)),
      ])
  let entries = finishAssumptionTrace sink
  let views = traceViewsNow gctx entries
  let (count, capacity) = scopeFrameStats gctx
  RequestView {
    rvTrace = views,
    rvErrors = listLen errors,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

-- `checkModulesChainReportForGraph`'s per-module rows beside the graph record its
-- drive ends in.
chainDiagsGraph : DriveInputs ->
  Option (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List ModDiags, GraphCtx)
chainDiagsGraph inputs preludeKey chainKey stepKeys runtimeDecls coreDecls modules =
  let ((report, _), gctx) =
    checkModulesChainReportForGraph
      (chainArgs
        inputs
        noValueMain
        preludeKey
        chainKey
        stepKeys
        runtimeDecls
        coreDecls
        modules)
  (report.trDiagnostics, gctx)

runCachedObserved : String -> RequestView
runCachedObserved entrySource =
  let sink = beginAssumptionTrace ()
  let (results, gctx) =
    chainDiagsGraph
      (traced sink)
      (Some (731, 733))
      "typecheck-scope-cache"
      [Some "stable-prefix-v1", None]
      []
      []
      [
        ("cache_prefix", desugar (parse scalarSource)),
        ("cache_entry", desugar (parse entrySource)),
      ]
  let entries = finishAssumptionTrace sink
  let views = traceViewsNow gctx entries
  let (count, capacity) = scopeFrameStats gctx
  RequestView {
    rvTrace = views,
    rvErrors = modErrorCount results,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

withoutBinderIds : List TraceView -> List ContextView
withoutBinderIds views =
  map
    (view => ContextView {
      cvKind = view.tvKind,
      cvGoalModule = view.tvGoalModule,
      cvGoalOwner = view.tvGoalOwner,
      cvBinderModule = view.tvBinderModule,
      cvBinderOwner = view.tvBinderOwner,
      cvSameScope = view.tvSameScope,
    })
    views

context : AssumptionTraceKind -> String -> String -> ContextView
context kind moduleId owner = ContextView {
  cvKind = kind,
  cvGoalModule = moduleId,
  cvGoalOwner = owner,
  cvBinderModule = moduleId,
  cvBinderOwner = owner,
  cvSameScope = True,
}

directSource : String
directSource = joinNl [
  "data Wrap a = Wrap a",
  "data Box a = Box a",
  "data Other a = Other a",
  "interface D t where",
  "  d : t -> Int",
  "interface C t where",
  "  foo : t -> Int",
  "impl D (Wrap a) where",
  "  d _ = 99",
  "impl C (Box a) requires D (Wrap a) where",
  "  foo (Box x) = d (Wrap x)",
  "impl C (Other a) requires D (Wrap a) where",
  "  foo (Other x) = d (Wrap x)",
]

scalarSource : String
scalarSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "f : D a => a -> Int",
  "f x = d x",
]

superSource : String
superSource = joinNl [
  "data Wrap a = Wrap a",
  "interface Base t where",
  "  base : t -> Int",
  "interface Sub t requires Base t where",
  "  sub : t -> Int",
  "f : Sub (Wrap a) => Wrap a -> Int",
  "f x = base x",
]

failedSource : String
failedSource = "bad : Int\nbad = True\n"

conflictingSource : String
conflictingSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "impl D Int where",
  "  d _ = 1",
  "impl D Int where",
  "  d _ = 2",
]

test "direct predicate evidence keeps same-rendering binders nominal" =
  let observed = runObserved "trace_direct" directSource
  let contexts = withoutBinderIds observed.rvTrace
  let binders = map (entry => entry.tvBinder) observed.rvTrace
  expectEqual
    (
      [
        context ATDirectPredicate "trace_direct" "binding:foo",
        context ATDirectPredicate "trace_direct" "binding:foo",
      ],
      True,
      0,
    )
    (
      contexts,
      match binders
        first :: second :: [] => first /= second
        _ => False,
      observed.rvErrors,
    )

test "a scalar assumption stays legacy and a superclass assumption is a projection" =
  let scalar = runObserved "trace_scalar" scalarSource
  let super = runObserved "trace_super" superSource
  expectEqual
    (
      [context ATLegacyScalar "trace_scalar" "binding:f"],
      [context ATSuperclassProjection "trace_super" "binding:f"],
      0,
      0,
    )
    (
      withoutBinderIds scalar.rvTrace,
      withoutBinderIds super.rvTrace,
      scalar.rvErrors,
      super.rvErrors,
    )

requestProjection : RequestView -> (List ContextView, Int)
requestProjection view = (withoutBinderIds view.rvTrace, view.rvFrameCount)

sameProjection : RequestView -> RequestView -> Bool
sameProjection left right = requestProjection left == requestProjection right

test "fresh repeat and failed/conflicting intervening requests retain ownership" =
  let first = runObserved "trace_repeat" scalarSource
  let repeated = runObserved "trace_repeat" scalarSource
  let failed = runObserved "trace_failed" failedSource
  let afterFailed = runObserved "trace_repeat" scalarSource
  let conflicting = runObserved "trace_conflict" conflictingSource
  let afterConflict = runObserved "trace_repeat" scalarSource
  expectEqual
    [True, True, True, True, True, True]
    [
      sameProjection first repeated,
      sameProjection first afterFailed,
      sameProjection first afterConflict,
      failed.rvErrors > 0,
      conflicting.rvErrors > 0,
      first.rvFrameCount <= first.rvFrameCapacity
        && repeated.rvFrameCount <= repeated.rvFrameCapacity
        && afterFailed.rvFrameCount <= afterFailed.rvFrameCapacity
        && afterConflict.rvFrameCount <= afterConflict.rvFrameCapacity,
    ]

test "served prefixes keep bounded scopes across failing entries" =
  let cold = runCachedObserved "entry = 0\n"
  let hit = runCachedObserved "entry = 0\n"
  let failed = runCachedObserved failedSource
  let afterFailed = runCachedObserved "entry = 0\n"
  let conflicting = runCachedObserved conflictingSource
  let afterConflict = runCachedObserved "entry = 0\n"
  let afterConflictHit = runCachedObserved "entry = 0\n"
  let runs = [cold, hit, afterFailed, afterConflict, afterConflictHit]
  -- Every frame is the drive's own: a core miss continues from the frozen prelude
  -- interface as a hit does, so core's frame is never left in the run either way.
  -- A drive that checks the prefix leaves four frames and one that serves it two,
  -- since a served module brings no scope frame.
  expectEach [
    (
      "cold traces the prefix's scalar assumption",
      expectEqual
        [context ATLegacyScalar "cache_prefix" "binding:f"]
        (withoutBinderIds cold.rvTrace),
    ),
    ("hit replays with no trace", expectEqual [] hit.rvTrace),
    (
      "a hit after a failing entry replays with no trace",
      expectEqual [] afterFailed.rvTrace,
    ),
    (
      "the conflicting entry's impl heads change the chain key, so the next drive re-derives",
      expectEqual
        (withoutBinderIds cold.rvTrace)
        (withoutBinderIds afterConflict.rvTrace),
    ),
    (
      "the drive after that re-derivation hits again",
      expectEqual [] afterConflictHit.rvTrace,
    ),
    (
      "a checked prefix leaves four frames and a served one two",
      expectEqual [4, 2, 2, 4, 2] (map (view => view.rvFrameCount) runs),
    ),
    (
      "both failing entries report errors",
      expectEach [
        ("failed", expectGreaterThan 0 failed.rvErrors),
        ("conflicting", expectGreaterThan 0 conflicting.rvErrors),
      ],
    ),
    (
      "every run stays within its frame capacity",
      expectEqual
        (map (_ => True) runs)
        (map (view => view.rvFrameCount <= view.rvFrameCapacity) runs),
    ),
  ]

mixedAttrFirstSource : String
mixedAttrFirstSource = joinNl [
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "interface Num a b where",
  "  fromInt : String -> a",
  "main = 1",
]

mixedDirectFirstSource : String
mixedDirectFirstSource = joinNl [
  "interface Num a b where",
  "  fromInt : String -> a",
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "main = 1",
]

flatMessages : String -> List String
flatMessages source =
  let (errors, _) =
    checkOneDiags defaultDriveInputs [] [] ("__user__", desugar (parse source))
  map tcMsg errors

test "attributed-direct Num declarations reject mismatches without cross-pairing rows" =
  expectEqual
    (
      ["type mismatch: String vs Int"],
      ["type mismatch: String vs Int"],
    )
    (flatMessages mixedAttrFirstSource, flatMessages mixedDirectFirstSource)

test "an else-less if names its missing branch and a written else does not" =
  expectEqual
    (
      [
        "type mismatch: String vs Unit; an `if` without `else` has type Unit, so add an `else` branch or make the `then` branch Unit",
      ],
      ["type mismatch: String vs Bool"],
    )
    (
      flatMessages "f n = if n > 0 then \"pos\"",
      flatMessages "g n = if n > 0 then \"pos\" else True",
    )

test "unresolved interface givens resolve as a direct predicate" =
  let source = joinNl [
    "data Wrap a = Wrap a",
    "interface D t where",
    "  d : t -> Int",
    "g : D (Wrap a) => a -> Int",
    "g _ = 5",
    "h : D (Wrap a) => a -> Int",
    "h x = g x",
  ]
  let resolved = runObserved "resolved_given" source
  expectEqual
    ([context ATDirectPredicate "resolved_given" "binding:h"], 0)
    (withoutBinderIds resolved.rvTrace, resolved.rvErrors)

test "id-witnessed impl givens remain legacy" =
  let source = joinNl [
    "interface D t where",
    "  d : t -> Int",
    "data Box a = Box a",
    "interface C t where",
    "  foo : t -> Int",
    "impl C (Box a) requires D a where",
    "  foo (Box x) = d x",
  ]
  let observed = runObserved "id_assisted" source
  expectEqual
    ([context ATLegacyPredicate "id_assisted" "binding:foo"], 0)
    (withoutBinderIds observed.rvTrace, observed.rvErrors)

binderOrdinal : EvidenceBinderId -> Int
binderOrdinal (EvidenceBinderId _ ordinal) = ordinal

assumptionShape : TraceView -> (AssumptionTraceKind, Int, String, String, Bool)
assumptionShape view = (
  view.tvKind,
  binderOrdinal view.tvBinder,
  view.tvGoalOwner,
  view.tvBinderOwner,
  view.tvSameScope,
)

supplySource : String
supplySource = joinNl [
  "export default interface Supply a where",
  "  seed : a",
  "  copy : a",
  "  copy = seed",
]

mixedDefaultSource : String
mixedDefaultSource = joinNl [
  "interface Base a where",
  "  base : a -> Int",
  "interface Other a where",
  "  other : a -> Int",
  "default interface Rich a requires Base a where",
  "  peer : a -> Int",
  "  mixed : Rich b => Other c => a -> b -> c -> Int",
  "  mixed x y z =",
  "    let local _ = peer x",
  "    let _ = local ()",
  "    let _ = peer y",
  "    let _ = other z",
  "    base y",
]

-- A default body's receiver is registered under this ordinal (`typecheck`'s
-- `defaultReceiverOrdinal`), below every real slot.
receiverOrdinal : Int
receiverOrdinal = -1

receiverAnswers : List TraceView -> List TraceView
receiverAnswers views =
  filter (v => binderOrdinal v.tvBinder == receiverOrdinal) views

test "a default body's sibling return call is answered by its receiver" =
  let observed = runModulesObserved [("supply_iface", supplySource)]
  expectEqual
    (
      [
        (
          ATDirectPredicate,
          receiverOrdinal,
          "default:copy",
          "default:copy",
          True,
        ),
      ],
      0,
    )
    (map assumptionShape observed.mtvAssumptions, observed.mtvErrors)

test "mixed default answers its argument-position sibling by the receiver" =
  let observed = runModulesObserved [("mixed_default", mixedDefaultSource)]
  expectEqual
    (
      [
        (ATSuperclassProjection, 0, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 1, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 0, "default:mixed", "default:mixed", True),
        (
          ATDirectPredicate,
          receiverOrdinal,
          "local:local",
          "default:mixed",
          False,
        ),
      ],
      0,
    )
    (map assumptionShape observed.mtvAssumptions, observed.mtvErrors)

test "same spelling retains module identity while impl bodies stay ordinary" =
  let colliding = runModulesObserved [
    ("owner_a", supplySource),
    ("owner_b", supplySource),
  ]
  let synthesized = runModulesObserved [
    (
      "owner_same",
      supplySource ++ "\nimpl Supply Int where\n  seed = 41\n",
    ),
  ]
  let explicit = runModulesObserved [
    (
      "ordinary_impl",
      joinNl [
        "interface Echo a where",
        "  echo : a -> a",
        "impl Echo Int where",
        "  echo x = echo x",
      ],
    ),
  ]
  let concrete = runModulesObserved [
    (
      "concrete_default",
      joinNl [
        "data Token = Token",
        "default interface Concrete a where",
        "  echo : a -> a",
        "  echo x = x",
        "  use : a -> Token",
        "  use _ = echo Token",
        "impl Concrete Token where",
      ],
    ),
  ]
  expectEqual
    (
      ["owner_a", "owner_b"],
      (1, 0, 0),
      [0, 0, 0, 0],
    )
    (
      map
        (view => view.tvBinderModule)
        (receiverAnswers colliding.mtvAssumptions),
      (
        listLen (receiverAnswers synthesized.mtvAssumptions),
        listLen (receiverAnswers explicit.mtvAssumptions),
        listLen (receiverAnswers concrete.mtvAssumptions),
      ),
      [
        colliding.mtvErrors,
        synthesized.mtvErrors,
        explicit.mtvErrors,
        concrete.mtvErrors,
      ],
    )

test "an inherited default is inferred once, as the default body" =
  let observed = runModulesObserved [
    (
      "specialized_default",
      joinNl [
        "interface Other a where",
        "  other : a -> Int",
        "impl Other Int where",
        "  other x = x",
        "default interface Supply a where",
        "  seed : a",
        "  use : Other b => a -> b -> Int",
        "  use x y = other y",
        "impl Supply Bool where",
        "  seed = False",
      ],
    ),
  ]
  expectEqual
    (
      [(ATDirectPredicate, 0, "default:use", "default:use", True)],
      0,
    )
    (map assumptionShape observed.mtvAssumptions, observed.mtvErrors)

localUseSiteObserved : String -> (List String, List EvidenceObservationEntry)
localUseSiteObserved source =
  let sink = beginEvidenceObservation ()
  let (errors, _) = checkOneDiags (traced sink) [] [] (
    "local_use_site",
    desugar (parseLocated source),
  )
  let entries = finishEvidenceObservation sink
  (map tcCode errors, entries)

test "a generalized local is dictionary-abstracted: each use applies it to the given its own argument needs (#1082, #2095)" =
  let (codes, entries) =
    localUseSiteObserved
      (joinNl
        [
          "interface Sz a where",
          "  sz : a -> Int",
          "impl Sz Int where",
          "  sz _ = 1",
          "impl Sz Bool where",
          "  sz _ = 2",
          "both : (Sz a, Sz b) => a -> b -> Int",
          "both x y =",
          "  let g v = sz v",
          "  g x + g y",
        ])
  -- `g x` and `g y` are dictionary applications of `g`, one per use, and each
  -- forwards the given for its own argument's variable: two distinct binders.  One
  -- binder shared by both uses is the #1045 wrong answer.
  let apps = evidenceEntriesOfKind "GKDictApp" entries
  expectAll [
    expectEqual [] codes,
    expectEqual 2 (listLen apps),
    expectTrue (all (e => e.eoeOutcome == EOKGiven) apps),
    expectTrue (match map (e => e.eoeGivenBinder) apps
      [Some first, Some second] => first /= second
      _ => False),
  ]

-- #1112 A-3: production-path observation of `buildDispositions`'
-- table, over a real multi-module elaboration. `elaborateModules` returns the
-- table it built (`types/typecheck.mdk`'s `driveGraphK`) as the sixth component
-- of its result.
--
-- Rows are matched by MODULE ID rather than by exact `InstId` (which also
-- carries a whole-graph-running `seq` the prelude's own impls advance), so a
-- future prelude change that adds or removes an `impl` cannot move these
-- numbers underneath the test.
dispositionsAfter : List (String, String) -> DispositionTable
dispositionsAfter sources =
  let (_, _, _, _, _, dispositions, _) =
    elaborateModules
      defaultDriveInputs
      []
      (desugar (parse numericPreludeSource))
      (map (entry => (fst entry, desugar (parseLocated (snd entry)))) sources)
  dispositions

sameIfaceSpelling : IfaceRef -> String -> Bool
sameIfaceSpelling iface name = iface.irName == name

anyMatchSupplied : String -> String -> List MethodDisposition -> Bool
anyMatchSupplied _ _ [] = False
anyMatchSupplied wantMid wantMethod (d :: rest) = match d
  Supplied { instance = i, method = m } =>
    instIdMid i == wantMid && m == wantMethod
      || anyMatchSupplied wantMid wantMethod rest
  InheritedDefault _ _ _ => anyMatchSupplied wantMid wantMethod rest

anyMatchInheritedDefault : String ->
  String ->
  String ->
  List MethodDisposition ->
  Bool
anyMatchInheritedDefault _ _ _ [] = False
anyMatchInheritedDefault wantMid wantIface wantMethod (d :: rest) = match d
  InheritedDefault { instance = i, iface = ir, method = m } =>
    instIdMid i == wantMid && sameIfaceSpelling ir wantIface && m == wantMethod
      || anyMatchInheritedDefault wantMid wantIface wantMethod rest
  Supplied _ _ _ => anyMatchInheritedDefault wantMid wantIface wantMethod rest

-- #1265's shape: `Dog` implements two DIFFERENT interfaces (`ifa::Speak`,
-- `ifb::Greet`) that happen to share the bare method name `speak`, both
-- method-less (both `InheritedDefault`). The disposition table keys on
-- INSTANCE identity (one row per `impl` declaration), so it must keep the two
-- rows apart by their declaring module — the (method, tag)-keyed collapse
-- #1265 pins is a Core IR default-registry defect, not one this table can
-- even express.
test "#1265: two same-named methods of two different interfaces stay two rows" =
  let table = dispositionsAfter [
    (
      "ifa",
      joinNl [
        "export interface Speak x where",
        "  speak : x -> String",
        "  speak _ = \"A-default\"",
      ],
    ),
    (
      "ifb",
      joinNl [
        "export interface Greet x where",
        "  speak : x -> String",
        "  speak _ = \"B-default\"",
      ],
    ),
    ("dog", "public export data Dog = Dog"),
    (
      "ca",
      joinNl [
        "import ifa.{Speak(..), speak}",
        "import dog.{Dog(..)}",
        "impl Speak Dog where",
      ],
    ),
    (
      "cb",
      joinNl [
        "import ifb.{Greet(..), speak}",
        "import dog.{Dog(..)}",
        "impl Greet Dog where",
      ],
    ),
  ]
  expectAll [
    expectTrue
      (anyMatchInheritedDefault "ca" "Speak" "speak" (dispositionRows table)),
    expectTrue
      (anyMatchInheritedDefault "cb" "Greet" "speak" (dispositionRows table)),
  ]

-- #1020's cross-module shape: a cross-module `impl` overriding NOTHING
-- (`Speak Dog`) is `InheritedDefault`; a sibling overriding its one method
-- (`Loud Cat`) is `Supplied`; a second cross-module empty impl of the SAME
-- interface (`Loud Dog`) is `InheritedDefault` alongside it.
test "#1020: cross-module empty and overriding impls disposition correctly" =
  let table = dispositionsAfter [
    (
      "dface",
      joinNl [
        "export interface Speak a where",
        "  speak : a -> String",
        "  speak _ = \"woof\"",
        "export interface Loud a where",
        "  loud : a -> String",
        "  loud _ = \"WOOF\"",
      ],
    ),
    (
      "entry",
      joinNl [
        "import dface.{Speak(..), speak, Loud(..), loud}",
        "data Cat = Cat",
        "data Dog = Dog",
        "impl Speak Dog where",
        "impl Loud Cat where",
        "  loud _ = \"MEOW\"",
        "impl Loud Dog where",
      ],
    ),
  ]
  expectAll [
    expectTrue
      (anyMatchInheritedDefault
        "entry"
        "Speak"
        "speak"
        (dispositionRows table)),
    expectTrue (anyMatchSupplied "entry" "loud" (dispositionRows table)),
    expectTrue
      (anyMatchInheritedDefault "entry" "Loud" "loud" (dispositionRows table)),
  ]

-- The same method body, written as a supplied impl method or inherited as the
-- interface default, is checked by the one method-body driver and must be judged
-- alike: `inherited` places [body] under the interface, otherwise under the impl.
placedBodySource : Bool ->
  List String ->
  List String ->
  String ->
  List String ->
  String
placedBodySource inherited prelude ifaceLines implHead body =
  joinNl
    (prelude
      ++ ifaceLines
      ++ (if inherited then body ++ [implHead] else implHead :: body))

placedEffectSource : Bool -> List String -> String
placedEffectSource inherited body =
  placedBodySource
    inherited
    ["put : Unit -> <Stdout> Unit", "put _ = ()"]
    [
      "interface Speak a where",
      "  speak : a -> (Unit -> <e> Unit) -> <e> Unit",
    ]
    "impl Speak Unit where"
    body

placedEffectCodes : Bool -> List String -> List String
placedEffectCodes inherited body =
  map fst (methodBodyCheck "placed_effect" (placedEffectSource inherited body))

-- The body performs <Stdout> inside the row <e> its caller chooses: a launder on
-- either placement.  Performing only the callback's row is the accepted control.
test "a supplied and an inherited body are judged alike on a method effect variable" =
  let launders = ["  speak _ k =", "    let _ = put ()", "    k ()"]
  let threads = ["  speak _ k = k ()"]
  expectEqual
    (["T-EFFECT-LAUNDER"], ["T-EFFECT-LAUNDER"], [], [])
    (
      placedEffectCodes False launders,
      placedEffectCodes True launders,
      placedEffectCodes False threads,
      placedEffectCodes True threads,
    )

placedNumSource : Bool -> String
placedNumSource inherited =
  placedBodySource
      inherited
      [
        "interface S a where",
        "  s : a -> Int",
        "impl S (List a) where",
        "  s _ = 0",
        "impl S (List Int) where",
        "  s _ = 1",
        "data Foo = Foo",
      ]
      ["interface T a where", "  t : a -> Int"]
      "impl T Foo where"
      ["  t _ = s [1, 2]"]
    ++ "\nmain : Int\nmain = t Foo\n"

placedNumCodes : Bool -> List String
placedNumCodes inherited =
  let core = desugar (parse numericPreludeSource)
  let program = desugar (parseLocated (placedNumSource inherited))
  let (errors, _) =
    checkOneDiags defaultDriveInputs [] core ("placed_num", program)
  map tcCode errors

placedNumElaborated : Bool -> (List Decl, ProgramFacts)
placedNumElaborated inherited =
  let core = desugar (parse numericPreludeSource)
  let program = desugar (parseLocated (placedNumSource inherited))
  elaborateOneFacts defaultDriveInputs [] core ("placed_num", program)

placedNumSuppliedValue : Int
placedNumSuppliedValue = placedNumValue False

placedNumInheritedValue : Int
placedNumInheritedValue = placedNumValue True

placedNumValue : Bool -> Int
placedNumValue inherited =
  let (elaborated, facts) = placedNumElaborated inherited
  withFacts facts (_ =>
    let bindings = evalOneFacts facts [] ("placed_num", elaborated)
    match lookupAssoc "main" bindings
      Some v => match force v
        VInt n => n
        _ => 0 - 1
      _ => 0 - 1)

-- The body-local literal `[1, 2]` appears nowhere in `t`'s declared type, so the
-- body's own numeric boundary grounds it to Int on either placement, and the call
-- selects the more specific `impl S (List Int)`.
test "a supplied and an inherited body ground a body-local literal alike" =
  expectEqual
    ([], [], 1, 1)
    (
      placedNumCodes False,
      placedNumCodes True,
      placedNumSuppliedValue,
      placedNumInheritedValue,
    )

-- A local binder or parameter that shadows a top-level name is not a reference
-- to it: the binding stays out of that name's recursive group and keeps its own
-- generalized scheme, free of the constraint the top-level name's body adds, so
-- `g` may use it at a type with no `Shout` impl.
binderShadowSource : List String -> String
binderShadowSource body =
  joinNl
    ([
        "interface Shout a where",
        "  shout : a -> Int",
        "impl Shout Int where",
        "  shout x = x",
      ]
      ++ body)

binderShadowObserved : String -> List String -> (List String, Option String)
binderShadowObserved name body =
  let core = desugar (parse arithmeticPreludeSource)
  let program = desugar (parseLocated (binderShadowSource body))
  let (errors, _) =
    checkOneDiags defaultDriveInputs [] core ("binder_shadow", program)
  let (_, schemes) = checkOneSchemeFullK defaultDriveInputs None [] core (
    "binder_shadow",
    program,
  )
  (map tcMsg errors, map (p => ppScheme p.psScheme) (lookupAssoc name schemes))

test "a let binder shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f x = let main = x + 1 in main * 2",
      "main = shout (f 3)",
      "g = f 1.5",
    ])

test "a where binder shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f x = main * 2",
      "  where",
      "    main = x + 1",
      "main = shout (f 3)",
      "g = f 1.5",
    ])

test "a let binder named like any top-level binding keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f x = let h = x + 1 in h * 2",
      "h = shout (f 3)",
      "g = f 1.5",
      "main = h",
    ])

test "a parameter shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f h = h * 2",
      "h = shout (f 3)",
      "g = f 1.5",
      "main = h",
    ])

test "a match-arm pattern shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "(a, b) -> a")
    (binderShadowObserved "f" [
      "f x = match x",
      "  (h, _) => h * 2",
      "h = shout (f (3, 0))",
      "g = f (1.5, 0)",
      "main = h",
    ])

test "a pattern-guard binder shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "Opt a -> a")
    (binderShadowObserved "f" [
      "data Opt a = No | Yes a",
      "f x = match x",
      "  y if (Yes h) <- y => h * 2",
      "  _ => 0",
      "h = shout (f (Yes 3))",
      "g = f (Yes 1.5)",
      "main = h",
    ])

test "a lambda parameter shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f x = (h => h * 2) x",
      "h = shout (f 3)",
      "g = f 1.5",
      "main = h",
    ])

test "a block-statement let shadowing a top-level name keeps the enclosing scheme its own" =
  expectEqual
    ([], Some "a -> a")
    (binderShadowObserved "f" [
      "f x =",
      "  let h = x + 1",
      "  h * 2",
      "h = shout (f 3)",
      "g = f 1.5",
      "main = h",
    ])

test "a let binder shadowing a where sibling keeps the sibling's group apart" =
  expectEqual
    ([], Some "Float -> Float")
    (binderShadowObserved "k" [
      "k : Float -> Float",
      "k z = p z + p 1.5",
      "  where",
      "    p x = let q = x + 1 in q * 2",
      "    q = p (3 : Int)",
    ])

test "mutually recursive top-level and where bindings still form one group" =
  expectEqual
    [([], Some "a -> Int"), ([], Some "a -> Int")]
    [
      binderShadowObserved "ping" ["ping x = pong x + 1", "pong y = ping y"],
      binderShadowObserved "outer" [
        "outer z = ev z",
        "  where",
        "    ev n = od n + 1",
        "    od n = ev n",
      ],
    ]

-- The `test/dict_fixtures/s6-drain-quiescence-*.mdk` programs over a minimal
-- prelude.  `check` renders the per-module diagnostics collected before the
-- graph-end drain, so what the drain decides about a scheme-quantified goal is
-- visible only in the sticky accumulator and in the evidence it records.
drainPreludeSource : String
drainPreludeSource = joinNl [
  "interface Eq a where",
  "  eq : a -> a -> Bool",
  "impl Eq Int where",
  "  eq _ _ = True",
  "interface Display a where",
  "  display : a -> String",
  "impl Display String where",
  "  display s = s",
  "impl Display Int where",
  "  display _ = \"int\"",
  "impl Display Float where",
  "  display _ = \"float\"",
  "println : Display a => a -> Unit",
  "println x = let _ = display x in ()",
]

drainCheck : DriveInputs -> List String -> DriveOutputs
drainCheck inputs body =
  let core = desugar (parse "\{arithmeticPreludeSource}\n\{drainPreludeSource}")
  snd
    (checkModulesEntryFullReportK inputs False None [] core [
      ("drain_quiescence", desugar (parseLocated (joinNl body))),
    ])

drainStickyObserved : List String -> List String
drainStickyObserved body =
  let outputs = drainCheck defaultDriveInputs body
  map (entry => tcMsg (snd entry)) (stickyTypeErrorDiags outputs)

drainInferredSchemeSource : List String
drainInferredSchemeSource = [
  "interface Sh a where",
  "  shv : a -> Int",
  "impl Sh Int where",
  "  shv _ = 11",
  "impl Sh Bool where",
  "  shv _ = 22",
  "needsSh : Sh a => a -> Int",
  "needsSh x = shv x",
  "top a = h a",
  "  where",
  "    h x = needsSh x",
  "main = println (top True)",
]

drainDeclaredSchemeSource : List String
drainDeclaredSchemeSource = [
  "interface Ixd a b where",
  "  ixd : a -> b -> a",
  "impl Ixd Int Bool where",
  "  ixd x _ = x",
  "interface Shb a where",
  "  shb : a -> a",
  "impl Shb Bool where",
  "  shb x = x",
  "impl Shb Int where",
  "  shb x = x",
  "nonlead : (Ixd a b, Shb b) => b -> a -> a",
  "nonlead n x = ixd x (shb n)",
  "relay n x = nonlead n x",
  "main = println (relay True 7)",
]

drainLetAliasSource : List String
drainLetAliasSource = [
  "greet name =",
  "  let msg = name",
  "  println msg",
  "  println name",
  "main = greet \"hi\"",
]

drainProjectedGoalSource : List String
drainProjectedGoalSource = [
  "interface Tweak a b where",
  "  tweak : b -> a -> a",
  "impl Tweak Float Int where",
  "  tweak _ x = x",
  "impl Tweak Float Bool where",
  "  tweak _ x = x",
  "value : (Tweak a Int, Tweak a Bool) => Int -> a -> a",
  "value n x = if n == 0 then x else tweak True (tweak 1 (relay (n - 1) x))",
  "relay n x = value n x",
  "main = println (relay 1 (2.5 : Float))",
]

-- A goal that reaches two or more instances and is on a scheme-quantified
-- variable is the caller's; reporting it ambiguous at the drain was #3031.
test "the graph-end drain reports no scheme-quantified goal ambiguous" =
  expectEqual
    [
      ("inferred-scheme", []),
      ("declared-scheme", []),
      ("let-alias", []),
      ("projected-goal", []),
    ]
    [
      ("inferred-scheme", drainStickyObserved drainInferredSchemeSource),
      ("declared-scheme", drainStickyObserved drainDeclaredSchemeSource),
      ("let-alias", drainStickyObserved drainLetAliasSource),
      ("projected-goal", drainStickyObserved drainProjectedGoalSource),
    ]

-- `relay`'s two `Tweak` goals sit on its scheme-quantified `a` and each reaches
-- exactly one instance (`Tweak Float Int`, `Tweak Float Bool`).  The one instance
-- a goal reaches is not chosen for a goal its caller owns, so both slots stay
-- unrouted rather than keyed on `Float`.
test "the graph-end drain mints no instance route for a scheme-quantified goal" =
  let sink = beginEvidenceObservation ()
  let _ = drainCheck (traced sink) drainProjectedGoalSource
  let entries = finishEvidenceObservation sink
  expectEqual
    [None, None]
    (map
      (e => e.eoeInstanceKey)
      (filter
        (e => e.eoeGoalKind == "GKDictApp" && e.eoePredicate == Some "a")
        entries))

nestedWrap : Int -> String -> String
nestedWrap depth leaf =
  if depth <= 0 then leaf else "Wrap (\{nestedWrap (depth - 1) leaf})"

-- `deep : Wrap^n Int` routes `Mk` at return position through n prerequisites.
returnChainSource : Int -> List String
returnChainSource depth = [
  "data Wrap a = Wrap a",
  "interface Mk a where",
  "  mk : Int -> a",
  "impl Mk Int where",
  "  mk n = n",
  "impl Mk (Wrap a) requires Mk a where",
  "  mk n = Wrap (mk n)",
  "deep : \{nestedWrap depth "Int"}",
  "deep = mk 7",
]

-- Each `Wrap` impl requires both interfaces at the payload, so the goals at
-- depth k are reached along 2^k paths while only two distinct goals exist there.
branchingRequiresSource : Int -> List String
branchingRequiresSource depth =
  branchingRequiresImpls ++ ["deepv = tagOf (\{nestedWrap depth "5"})"]

branchingRequiresImpls : List String
branchingRequiresImpls = [
  "data Wrap a = Wrap a",
  "interface Tag t where",
  "  tagOf : t -> String",
  "interface Tag2 t where",
  "  tag2Of : t -> String",
  "impl Tag Int where",
  "  tagOf _ = \"int\"",
  "impl Tag2 Int where",
  "  tag2Of _ = \"int2\"",
  "impl Tag2 (Wrap a) requires Tag2 a, Tag a where",
  "  tag2Of (Wrap x) = \"v\"",
  "impl Tag (Wrap a) requires Tag a, Tag2 a where",
  "  tagOf (Wrap x) = \"w\"",
]

-- The same goal on a variable, reduced to its residual `(Tag a, Tag2 a)` at a
-- generalizing binder.
branchingGeneralizedSource : Int -> List String
branchingGeneralizedSource depth =
  branchingRequiresImpls ++ ["deep x = tagOf (\{nestedWrap depth "x"})"]

-- The same goal at a signed binder, whose declared context answers the residual.
branchingSignedSource : Int -> List String
branchingSignedSource depth =
  branchingRequiresImpls
    ++ [
      "deep : (Tag a, Tag2 a) => a -> String",
      "deep x = tagOf (\{nestedWrap depth "x"})",
    ]

-- The same goal in an impl body, on the impl's head variable, whose `requires`
-- answers the residual.
branchingImplBodySource : Int -> List String
branchingImplBodySource depth =
  branchingRequiresImpls
    ++ [
      "interface Desc t where",
      "  desc : t -> String",
      "data Q a = Q a",
      "impl Desc (Q a) requires Tag a, Tag2 a where",
      "  desc (Q x) = tagOf (\{nestedWrap depth "x"})",
    ]

-- The same goal on a variable no type determines: the boundary judges the goal and
-- every prerequisite it selects, and reports `Mk` ambiguous once.
branchingUndeterminedSource : Int -> List String
branchingUndeterminedSource depth =
  branchingRequiresImpls
    ++ [
      "interface Mk a where",
      "  mk : Int -> a",
      "impl Mk Int where",
      "  mk n = n",
      "impl Mk Bool where",
      "  mk _ = True",
      "impl Tag Bool where",
      "  tagOf _ = \"b\"",
      "impl Tag2 Bool where",
      "  tag2Of _ = \"b\"",
      "undetermined = tagOf (\{nestedWrap depth "mk 5"})",
    ]

ambiguousMkMessage : String
ambiguousMkMessage =
  "ambiguous instance for `Mk`: the type here does not determine which impl applies; add a type annotation"

scalingCheckAlloc : List String -> <IO> (Float, List String)
scalingCheckAlloc body =
  let core = desugar (parse arithmeticPreludeSource)
  let decls = desugar (parseLocated (joinNl body))
  let before = allocBytes ()
  let (errors, _) =
    checkOneDiags defaultDriveInputs [] core ("requires_scaling", decls)
  (allocBytes () - before, map tcMsg errors)

-- Checks one family at three evenly spaced sizes and returns the two allocation
-- increments.  Work linear in the size gives equal increments; a walk that
-- revisits shared structure once per path multiplies the second by 2^step.
scalingIncrements : (Int -> List String) ->
  Int ->
  Int ->
  <IO> (Float, Float, List String)
scalingIncrements family start step =
  let _ = scalingCheckAlloc (family start)
  let (small, smallErrors) = scalingCheckAlloc (family start)
  let (middle, middleErrors) = scalingCheckAlloc (family (start + step))
  let (large, largeErrors) = scalingCheckAlloc (family (start + 2 * step))
  (middle - small, large - middle, smallErrors ++ middleErrors ++ largeErrors)

test "a return-position requires chain checks in work linear in its depth" =
  let (first, second, errors) = scalingIncrements returnChainSource 8 4
  expectAll [
    expectEqual [] errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

test "branching requires check in work linear in the distinct goals" =
  let (first, second, errors) = scalingIncrements branchingRequiresSource 6 3
  expectAll [
    expectEqual [] errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

test "branching requires reduce at a generalizing binder in work linear in depth" =
  let (first, second, errors) = scalingIncrements branchingGeneralizedSource 8 4
  expectAll [
    expectEqual [] errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

test "branching requires reduce at a signed binder in work linear in depth" =
  let (first, second, errors) = scalingIncrements branchingSignedSource 8 4
  expectAll [
    expectEqual [] errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

test "branching requires reduce in an impl body in work linear in depth" =
  let (first, second, errors) = scalingIncrements branchingImplBodySource 8 4
  expectAll [
    expectEqual [] errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

test "an undetermined goal's prerequisites are judged in work linear in depth" =
  let (first, second, errors) =
    scalingIncrements branchingUndeterminedSource 4 2
  expectAll [
    expectEqual
      [
        ambiguousMkMessage,
        ambiguousMkMessage,
        ambiguousMkMessage,
      ]
      errors,
    expectGreaterThan 0.0 first,
    expectLessThan (first * 3.0 + 65536.0) second,
  ]

-- An argument stamp, a return site and a method's own dictionaries each write a
-- method cell, and the stamper's notes about what it built below the top must land
-- in that cell's summary, which is all `judgeCells` reads for depth two and below.
-- A producer that captured a fresh summary instead hides a nested hole in an
-- accepted program, and no natural program has one to show it.
cellInnerSource : String
cellInnerSource = joinNl [
  "interface Sh a where",
  "  sh : a -> Int",
  "interface Mk a where",
  "  mk : Int -> a",
  "interface Wr a where",
  "  wr : Sh b => a -> b -> Int",
  "impl Sh Int where",
  "  sh n = n",
  "impl Mk Int where",
  "  mk n = n",
  "impl Wr Int where",
  "  wr a b = sh b",
  "useAll : Int",
  "useAll = wr (mk 1 : Int) (sh (mk 2 : Int))",
]

test "every goal that writes a method cell notes into that cell's summary" =
  let (_, gctx) =
    elaborateModulesGraph
      (driveArgs defaultDriveInputs False None [] (desugar
        (parse numericPreludeSource)) [
        ("cell_inner", desugar (parseLocated cellInnerSource)),
      ])
  let observed = cellGoalInnerAliasing gctx
  expectAll [
    expectEqual [] (filter (o => not (snd o)) observed),
    expectEqual
      ["GKArgStamp", "GKMethodDict", "GKReturnSite"]
      (sort (nub (map fst observed))),
  ]

-- ── what `IO` joins follows the selected target profile ──────────────────────
-- The label set of `wasmgc/node` excludes `Exec`, so there an `<IO>` bound does
-- not cover `runIt`; with no profile, and on `llvm/native-posix`, it does.

ioJoinPrelude : String
ioJoinPrelude =
  "effect Audit\nextern runIt : String -> <Exec> Unit\nextern say : String -> <Stdout> Unit\nextern emitAudit : Unit -> <Audit> Unit\nextern touchIo : Unit -> <IO> Unit\n"

-- The drive inputs under the profile `name` names, selected the way
-- `check --target` selects it.
inputsUnder : Option String -> DriveInputs
inputsUnder name = match selectProfile name None
  Ok p => driveInputsFor p False []
  Err m => panic m

-- Each error as (module, line, code, message).
ioJoinErrors : List ModDiags -> List (String, Int, String, String)
ioJoinErrors results = flatMap moduleIoJoinErrors results

moduleIoJoinErrors : ModDiags -> List (String, Int, String, String)
moduleIoJoinErrors (mid, (_, errors, _)) =
  map (d => (mid, diagLine d, tcCode d, tcMsg d)) errors

diagLine : TcDiag -> Int
diagLine (TcDiag _ _ (Some (Loc _ line _ _ _)) _ _ _) = line
diagLine _ = 0

ioJoinCheck : Option String ->
  List (String, String) ->
  List (String, Int, String, String)
ioJoinCheck name sources =
  ioJoinErrors
    (checkModulesDiagsChain
      (inputsUnder name)
      None
      ""
      []
      []
      (desugar (parseLocated ioJoinPrelude))
      (map (s => (fst s, desugar (parseLocated (snd s)))) sources))

-- A constrained function of one module that shares its name with an interface method, used at a
-- type with no impl by a second module that imports it: the rejection names the missing impl at
-- the call.
test "an imported constrained function used at a type with no impl is rejected at the call, naming the impl" =
  let core =
    desugar
      (parseLocated
        """
interface Display a where
  display : a -> String
impl Display String where
  display s = s
interface Addable a where
  add : a -> a -> a
""")
  let lib = """
export
add : Display b => a -> b -> a
add x y = x
"""
  let entry =
    """
import lib.{add}

data NoDisp = NoDisp

main = add "a" NoDisp
"""
  expectEqual
    [
      (
        "entry",
        5,
        "T-NO-IMPL",
        "no impl of Display for NoDisp; add `deriving Display` to `NoDisp` or write `impl Display NoDisp`",
      ),
    ]
    (ioJoinErrors
      (checkModulesDiagsChain defaultDriveInputs None "" [] [] core [
        ("lib", desugar (parseLocated lib)),
        ("entry", desugar (parseLocated entry)),
      ]))

nodeJoinClause : String
nodeJoinClause =
  "; `IO` on `wasmgc/node` is <Clock, Env, FileRead, FileWrite, Rand, Stderr, Stdin, Stdout>"

test "an <IO> entry performing only granted labels is admitted on wasm" =
  let source = "main : <IO> Unit\nmain = say \"hi\"\n"
  expectEach [
    ("none", expectEqual [] (ioJoinCheck None [("entry", source)])),
    ("wasm", expectEqual [] (ioJoinCheck (Some "wasm") [("entry", source)])),
  ]

test "an <IO> function running a command is refused on wasm at the call" =
  let source =
    "listDir : Unit -> <IO> Unit\nlistDir _ = runIt \"ls\"\n\nmain : <IO> Unit\nmain = listDir ()\n"
  expectEach [
    ("none", expectEqual [] (ioJoinCheck None [("entry", source)])),
    (
      "native",
      expectEqual [] (ioJoinCheck (Some "native") [("entry", source)]),
    ),
    (
      "wasm",
      expectEqual
        [
          (
            "entry",
            2,
            "T-EFFECT-LEAK",
            "performs <Exec> where only <IO> is allowed" ++ nodeJoinClause,
          ),
        ]
        (ioJoinCheck (Some "wasm") [("entry", source)]),
    ),
  ]

test "an unused <IO> library function running a command is refused on wasm" =
  let lib =
    "export\ndouble : Int -> Int\ndouble x = x * 2\n\nexport\nlistDir : Unit -> <IO> Unit\nlistDir _ = runIt \"ls\"\n"
  let entry = "import lib.{double}\n\nmain : <Stdout> Unit\nmain = say \"hi\"\n"
  let sources = [("lib", lib), ("entry", entry)]
  expectEach [
    ("none", expectEqual [] (ioJoinCheck None sources)),
    (
      "wasm",
      expectEqual
        [
          (
            "lib",
            7,
            "T-EFFECT-LEAK",
            "performs <Exec> where only <IO> is allowed" ++ nodeJoinClause,
          ),
        ]
        (ioJoinCheck (Some "wasm") sources),
    ),
  ]

test "a leak past an <IO> bound names what IO joins on a narrowed target only" =
  let source = "audit : Unit -> <IO> Unit\naudit _ = emitAudit ()\n"
  let bare = "performs <Audit> where only <IO> is allowed"
  expectEach [
    (
      "none",
      expectEqual
        [("entry", 2, "T-EFFECT-LEAK", bare)]
        (ioJoinCheck None [("entry", source)]),
    ),
    (
      "native",
      expectEqual
        [("entry", 2, "T-EFFECT-LEAK", bare)]
        (ioJoinCheck (Some "native") [("entry", source)]),
    ),
    (
      "edge",
      expectEqual
        [
          (
            "entry",
            2,
            "T-EFFECT-LEAK",
            bare
              ++ "; `IO` on `wasmgc/edge` is <Clock, Net, Rand, Stderr, Stdout>",
          ),
        ]
        (ioJoinCheck (Some "wasmgc/edge") [("entry", source)]),
    ),
  ]

-- A performed `IO` is covered only by a label of the join, so on
-- `wasmgc/wasi-p2`, whose join is empty, a pure bound still refuses it.
test "an <IO> extern in a pure function is refused on every profile" =
  let source = "measure : Unit -> Unit\nmeasure _ = touchIo ()\n"
  let bare = "performs <IO> where only <> is allowed"
  let refusedWith = msg => [("entry", 2, "T-EFFECT-LEAK", msg)]
  expectEach [
    (
      "none",
      expectEqual (refusedWith bare) (ioJoinCheck None [("entry", source)]),
    ),
    (
      "native",
      expectEqual
        (refusedWith bare)
        (ioJoinCheck (Some "native") [("entry", source)]),
    ),
    (
      "wasm",
      expectEqual
        (refusedWith (bare ++ nodeJoinClause))
        (ioJoinCheck (Some "wasm") [("entry", source)]),
    ),
    (
      "wasi-p2",
      expectEqual
        (refusedWith (bare ++ "; `IO` on `wasmgc/wasi-p2` is <>"))
        (ioJoinCheck (Some "wasmgc/wasi-p2") [("entry", source)]),
    ),
  ]

-- The keyed drive serves `lib` from its interface, so `lib`'s result under one
-- profile must not be served under another.
ioJoinKeyedCheck : Option String -> List (String, Int, String, String)
ioJoinKeyedCheck name =
  let lib = "export\nlistDir : Unit -> <IO> Unit\nlistDir _ = runIt \"ls\"\n"
  let entry = "import lib.{listDir}\n\nmain : <IO> Unit\nmain = say \"hi\"\n"
  ioJoinErrors
    (checkModulesDiagsChain
      (inputsUnder name)
      (Some (4032, 4033))
      "io-join-profile-key"
      [Some "lib-v1", None]
      []
      (desugar (parseLocated ioJoinPrelude))
      [
        ("lib", desugar (parseLocated lib)),
        ("entry", desugar (parseLocated entry)),
      ])

test "the memoized drive gives each profile its own result in one process" =
  let first = ioJoinKeyedCheck None
  let onWasm = ioJoinKeyedCheck (Some "wasm")
  let again = ioJoinKeyedCheck None
  expectEach [
    ("none first", expectEqual [] first),
    (
      "wasm after none",
      expectEqual
        [
          (
            "lib",
            3,
            "T-EFFECT-LEAK",
            "performs <Exec> where only <IO> is allowed" ++ nodeJoinClause,
          ),
        ]
        onWasm,
    ),
    ("none after wasm", expectEqual [] again),
  ]

-- An impl head written through a `type` alias is the impl over the alias's
-- expansion (DICT-SEMANTICS §8 I4.3): `impl Nm LB` IS `impl Nm (List Bool)`.
-- Each program is checked, then elaborated and evaluated, and observed as its
-- error codes and the value of `main` (empty when the program is rejected).
aliasHeadPrelude : String
aliasHeadPrelude = joinNl [
  "interface Shw a where",
  "  shw : a -> String",
  "impl Shw (List a) where",
  "  shw _ = \"general\"",
]

aliasHeadOutcome : List (String, String) -> (List String, String)
aliasHeadOutcome sources = preludeOutcome aliasHeadPrelude sources

-- The outcome of [sources] checked, elaborated and evaluated over [prelude].
preludeOutcome : String -> List (String, String) -> (List String, String)
preludeOutcome prelude sources =
  let core = desugar (parseLocated prelude)
  let modules =
    map (entry => (fst entry, desugar (parseLocated (snd entry)))) sources
  let codes =
    flatMap
      (row => match row
        (_, (_, errors, _)) => map tcCode errors)
      (checkModulesDiagsChain defaultDriveInputs None "" [] [] core modules)
  if isEmptyL codes then
    let elab = elaborateModules defaultDriveInputs [] core modules
    let (coreD, elaborated, _, _, _, _, _) = elab
    let rootId = optionOr "" (map fst (last sources))
    let facts = factsOfElab elab
    withFacts facts (_ =>
      let bindings =
        evalOneFacts facts [] (rootId, coreD ++ flatMap snd elaborated)
      match lookupAssoc "main" bindings
        Some value => match force value
          VString s => (codes, s)
          _ => (codes, "<not a string>")
        None => (codes, "<no main>"))
  else
    (codes, "")

aliasHeadModule : List String -> List (String, String)
aliasHeadModule lines = [("alias_head", joinNl lines)]

test "an impl over an alias head is selected for the alias's expansion" = expectEach
  [
    (
      "prelude interface beside the prelude's general impl",
      expectEqual
        ([], "LB")
        (aliasHeadOutcome
          (aliasHeadModule [
            "type LB = List Bool",
            "impl Shw LB where",
            "  shw _ = \"LB\"",
            "main = shw [True]",
          ])),
    ),
    (
      "user interface beside a general impl",
      expectEqual
        ([], "LB")
        (aliasHeadOutcome
          (aliasHeadModule [
            "type LB = List Bool",
            "interface Nm a where",
            "  nm : a -> String",
            "impl Nm (List a) where",
            "  nm _ = \"general\"",
            "impl Nm LB where",
            "  nm _ = \"LB\"",
            "main = nm [True]",
          ])),
    ),
    (
      "alias head alone",
      expectEqual
        ([], "LB")
        (aliasHeadOutcome
          (aliasHeadModule [
            "type LB = List Bool",
            "interface Nm a where",
            "  nm : a -> String",
            "impl Nm LB where",
            "  nm _ = \"LB\"",
            "main = nm [True]",
          ])),
    ),
  ]

-- The judgment matrix: one program per judgment, written once with the head
-- spelled through the alias and once spelled as its expansion.  Every judgment
-- must reach the same verdict on both spellings, and that verdict is the one the
-- semantics gives the expanded spelling.
aliasHeadSpelling : Bool -> String
aliasHeadSpelling aliased = if aliased then "LB" else "(List Bool)"

aliasHeadIfaces : List String
aliasHeadIfaces = [
  "type LB = List Bool",
  "interface Sup a where",
  "  sup : a -> String",
  "interface Sub a requires Sup a where",
  "  sub : a -> String",
]

aliasHeadSelection : Bool -> (List String, String)
aliasHeadSelection aliased =
  aliasHeadOutcome
    (aliasHeadModule
      (aliasHeadIfaces
        ++ [
          "impl Sup \{aliasHeadSpelling aliased} where",
          "  sup _ = \"SUP\"",
          "main = sup [True]",
        ]))

-- The alias is private to `lib`, so only an expansion made with `lib`'s own
-- aliases sees that `lib`'s impl and `entry`'s overlap.
aliasHeadCoherence : Bool -> (List String, String)
aliasHeadCoherence aliased = aliasHeadOutcome [
  (
    "lib",
    joinNl [
      "type LB = List Bool",
      "export interface Nm a where",
      "  nm : a -> String",
      "impl Nm \{aliasHeadSpelling aliased} where",
      "  nm _ = \"lib\"",
    ],
  ),
  (
    "entry",
    joinNl [
      "import lib.{Nm, nm}",
      "impl Nm (List Bool) where",
      "  nm _ = \"entry\"",
      "main = nm [True]",
    ],
  ),
]

-- The alias heads the super's impl, so the check that `impl Sub (List Bool)` has
-- its super finds that impl through the alias.
aliasHeadSuperExistence : Bool -> (List String, String)
aliasHeadSuperExistence aliased =
  aliasHeadOutcome
    (aliasHeadModule
      (aliasHeadIfaces
        ++ [
          "impl Sup \{aliasHeadSpelling aliased} where",
          "  sup _ = \"SUP\"",
          "impl Sub (List Bool) where",
          "  sub _ = \"sub\"",
          "main = sub [True]",
        ]))

-- The dictionary `useSup` receives for `Sub (List Bool)` carries its super's,
-- which must be built from the alias-headed impl, the more specific of the two
-- `Sup` impls at `List Bool`.
aliasHeadSuperConstruction : Bool -> (List String, String)
aliasHeadSuperConstruction aliased =
  aliasHeadOutcome
    (aliasHeadModule
      (aliasHeadIfaces
        ++ [
          "impl Sup (List a) where",
          "  sup _ = \"general\"",
          "impl Sup \{aliasHeadSpelling aliased} where",
          "  sup _ = \"SUP\"",
          "impl Sub (List Bool) where",
          "  sub _ = \"sub\"",
          "useSup : Sub a => a -> String",
          "useSup x = sup x",
          "main = useSup [True]",
        ]))

aliasHeadMinOrder : Bool -> (List String, String)
aliasHeadMinOrder aliased =
  aliasHeadOutcome
    (aliasHeadModule
      (aliasHeadIfaces
        ++ [
          "impl Sup (List a) where",
          "  sup _ = \"general\"",
          "impl Sup \{aliasHeadSpelling aliased} where",
          "  sup _ = \"SUP\"",
          "main = sup [True]",
        ]))

aliasHeadVerdicts : (List String, String) ->
  (Bool -> (List String, String)) ->
  Expectation
aliasHeadVerdicts expected observe =
  expectEqual (expected, expected) (observe False, observe True)

test "alias-head judgment matrix: selection" =
  aliasHeadVerdicts ([], "SUP") aliasHeadSelection

test "alias-head judgment matrix: coherence" =
  aliasHeadVerdicts (["T-CONFLICTING-IMPL"], "") aliasHeadCoherence

test "alias-head judgment matrix: super existence" =
  aliasHeadVerdicts ([], "sub") aliasHeadSuperExistence

test "alias-head judgment matrix: super construction" =
  aliasHeadVerdicts ([], "SUP") aliasHeadSuperConstruction

test "alias-head judgment matrix: min order" =
  aliasHeadVerdicts ([], "SUP") aliasHeadMinOrder

-- Two modules' types that share a spelling are two types (DICT-SEMANTICS §8 I4):
-- an impl over `lib`'s `Box` neither answers nor supplies the super of an impl
-- over the entry module's own `Box`.  `lib` does not export `Box` to the entry
-- module, so only an identity comparison tells the two apart.
collisionLib : List String -> (String, String)
collisionLib impls = (
  "lib",
  joinNl
    ([
        "export interface Sup a where",
        "  sup : a -> String",
        "export interface Sub a requires Sup a where",
        "  sub : a -> String",
        "public export data Box a = Box a",
      ]
      ++ impls),
)

collisionEntry : String -> List String -> (String, String)
collisionEntry ty lines = (
  "entry",
  joinNl
    (["import lib.{Sup, Sub, sup, sub}", "data \{ty} a = \{ty} a"] ++ lines),
)

test "an impl over another module's same-spelled type is no super impl" = expectEach
  [
    (
      "parametric head",
      expectEqual
        (["T-MISSING-SUPER-IMPL"], "")
        (aliasHeadOutcome [
          collisionLib ["impl Sup (Box a) where", "  sup _ = \"lib\""],
          collisionEntry "Box" [
            "impl Sub (Box a) where",
            "  sub _ = \"sub\"",
            "useSup : Sub a => a -> String",
            "useSup x = sup x ++ sub x",
            "main = useSup (Box True)",
          ],
        ]),
    ),
    (
      "concrete head",
      expectEqual
        (["T-MISSING-SUPER-IMPL"], "")
        (aliasHeadOutcome [
          collisionLib ["impl Sup (Box a) where", "  sup _ = \"lib\""],
          collisionEntry "Box" [
            "impl Sub (Box Bool) where",
            "  sub _ = \"sub\"",
            "useSup : Sub a => a -> String",
            "useSup x = sup x ++ sub x",
            "main = useSup (Box True)",
          ],
        ]),
    ),
  ]

-- Each of two modules declares its own `T` with a `Conv` impl, and the receiver's
-- impl alone determines the result type, so each call has exactly one instance.
test "a receiver's own impl determines a multi-parameter goal beside a same-spelled type" =
  expectEqual
    ([], "beeint")
    (aliasHeadOutcome [
      (
        "cv",
        joinNl [
          "export interface Conv a b where",
          "  conv : a -> b",
          "export interface Say a where",
          "  say : a -> String",
          "impl Say Int where",
          "  say _ = \"int\"",
          "impl Say String where",
          "  say s = s",
        ],
      ),
      (
        "amod",
        joinNl [
          "import cv.{Conv, conv}",
          "public export data T = TA",
          "impl Conv T Int where",
          "  conv _ = 7",
        ],
      ),
      (
        "bmod",
        joinNl [
          "import cv.{Conv, conv}",
          "public export data T = TB",
          "impl Conv T String where",
          "  conv _ = \"bee\"",
        ],
      ),
      (
        "main",
        joinNl [
          "import cv.{Conv, conv, Say, say}",
          "import amod as A",
          "import bmod as B",
          "main = say (conv B.TB) ++ say (conv A.TA)",
        ],
      ),
    ])

-- The spelling-collision judgment matrix: one program per judgment, with the entry
-- module's own type spelled like `lib`'s `Box` and spelled distinctly.  Every
-- judgment must reach the same verdict on both spellings.
collisionSpelling : Bool -> String
collisionSpelling collides = if collides then "Box" else "Crate"

-- `Box` sits below the head's root, so the bucket keyed on the root (`List`)
-- admits `lib`'s impl and only the matcher can refuse it.
collisionSelection : Bool -> (List String, String)
collisionSelection collides =
  let ty = collisionSpelling collides
  aliasHeadOutcome [
    collisionLib ["impl Sup (List (Box Bool)) where", "  sup _ = \"lib\""],
    collisionEntry ty [
      "impl Sup (List (\{ty} a)) where",
      "  sup _ = \"entry\"",
      "main = sup [\{ty} True]",
    ],
  ]

collisionCoherence : Bool -> (List String, String)
collisionCoherence collides =
  let ty = collisionSpelling collides
  aliasHeadOutcome [
    collisionLib ["impl Sup (Box Bool) where", "  sup _ = \"lib\""],
    collisionEntry ty [
      "impl Sup (\{ty} Bool) where",
      "  sup _ = \"entry\"",
      "main = sup (\{ty} True)",
    ],
  ]

collisionSuperExistence : Bool -> (List String, String)
collisionSuperExistence collides =
  let ty = collisionSpelling collides
  aliasHeadOutcome [
    collisionLib ["impl Sup (Box a) where", "  sup _ = \"lib\""],
    collisionEntry ty [
      "impl Sub (\{ty} a) where",
      "  sub _ = \"sub\"",
      "main = sub (\{ty} True)",
    ],
  ]

collisionSuperConstruction : Bool -> (List String, String)
collisionSuperConstruction collides =
  let ty = collisionSpelling collides
  aliasHeadOutcome [
    collisionLib ["impl Sup (Box a) where", "  sup _ = \"lib\""],
    collisionEntry ty [
      "impl Sup (\{ty} a) where",
      "  sup _ = \"entry\"",
      "impl Sub (\{ty} a) where",
      "  sub _ = \"sub\"",
      "useSup : Sub a => a -> String",
      "useSup x = sup x",
      "main = useSup (\{ty} True)",
    ],
  ]

-- `lib`'s impl is the more specific of the three heads when only spellings are
-- compared, so the ranking must see the entry module's own two impls alone.
collisionMinOrder : Bool -> (List String, String)
collisionMinOrder collides =
  let ty = collisionSpelling collides
  aliasHeadOutcome [
    collisionLib ["impl Sup (List (Box Bool)) where", "  sup _ = \"lib\""],
    collisionEntry ty [
      "impl Sup (List a) where",
      "  sup _ = \"general\"",
      "impl Sup (List (\{ty} a)) where",
      "  sup _ = \"entry\"",
      "main = sup [\{ty} True]",
    ],
  ]

test "spelling-collision judgment matrix: selection" =
  aliasHeadVerdicts ([], "entry") collisionSelection

test "spelling-collision judgment matrix: coherence" =
  aliasHeadVerdicts ([], "entry") collisionCoherence

test "spelling-collision judgment matrix: super existence" =
  aliasHeadVerdicts (["T-MISSING-SUPER-IMPL"], "") collisionSuperExistence

test "spelling-collision judgment matrix: super construction" =
  aliasHeadVerdicts ([], "entry") collisionSuperConstruction

test "spelling-collision judgment matrix: min order" =
  aliasHeadVerdicts ([], "entry") collisionMinOrder

-- An arrow is a constructed head like any other (#1617): an impl over `(Int -> b)`
-- is selected for a ground arrow goal, and that impl's `requires` are owed at the
-- use, as they are for `(Box b)` (#4045).
arrowHeadShow : List String
arrowHeadShow = [
  "interface Show2 a where",
  "  show2 : a -> String",
  "impl Show2 Int where",
  "  show2 _ = \"i\"",
  "interface Sup2 a where",
  "  sup2 : a -> String",
  "impl Sup2 (Int -> b) requires Show2 b where",
  "  sup2 f = \"INTFN\" ++ show2 (f 1)",
  "isPos : Int -> Bool",
  "isPos _ = True",
]

arrowHeadShowOutcome : List String -> (List String, String)
arrowHeadShowOutcome lines =
  aliasHeadOutcome (aliasHeadModule (arrowHeadShow ++ lines))

test "an arrow-headed impl's requires are checked at every use" = expectEach [
  (
    "plain use",
    expectEqual (["T-NO-IMPL"], "") (arrowHeadShowOutcome ["main = sup2 isPos"]),
  ),
  (
    "use through a carried super",
    expectEqual
      (["T-NO-IMPL"], "")
      (arrowHeadShowOutcome [
        "interface Sub2 a requires Sup2 a where",
        "  sub2 : a -> String",
        "impl Sub2 (Int -> b) requires Show2 b where",
        "  sub2 _ = \"sub\"",
        "useSub : Sub2 a => a -> String",
        "useSub x = sup2 x",
        "main = useSub isPos",
      ]),
  ),
  (
    "nested requires",
    expectEqual
      (["T-NO-IMPL"], "")
      (arrowHeadShowOutcome [
        "impl Sup2 (List a) requires Sup2 a where",
        "  sup2 xs = match xs",
        "    [] => \"nil\"",
        "    x :: _ => \"L\" ++ sup2 x",
        "main = sup2 [isPos]",
      ]),
  ),
  (
    "generalized binder",
    expectEqual
      (["T-NO-IMPL"], "")
      (arrowHeadShowOutcome [
        "konst : b -> Int -> b",
        "konst y _ = y",
        "h y = sup2 (konst y)",
        "main = h True",
      ]),
  ),
  (
    "satisfied requires",
    expectEqual
      ([], "INTFNb")
      (arrowHeadShowOutcome [
        "impl Show2 Bool where",
        "  show2 _ = \"b\"",
        "main = sup2 isPos",
      ]),
  ),
]

-- The arrow-vs-Box judgment matrix: one program per judgment, written once with an
-- arrow head and once with a `Box` head.  Every judgment must reach the same verdict
-- on both.  `lib` declares the interfaces and general fallback impls, so an entry
-- impl that loses selection to one shows up as the fallback's word.
arrowHeadVar : Bool -> String
arrowHeadVar arrow = if arrow then "(Int -> b)" else "(Box b)"

arrowHeadBool : Bool -> String
arrowHeadBool arrow = if arrow then "(Int -> Bool)" else "(Box Bool)"

arrowHeadGeneral : Bool -> String
arrowHeadGeneral arrow = if arrow then "(a -> b)" else "(Box b)"

arrowHeadValue : Bool -> String
arrowHeadValue arrow = if arrow then "isPos" else "(Box True)"

arrowHeadLib : (String, String)
arrowHeadLib = (
  "lib",
  joinNl [
    "export interface Show2 a where",
    "  show2 : a -> String",
    "impl Show2 Int where",
    "  show2 _ = \"i\"",
    "public export data Box a = Box a",
    "export interface Sel a where",
    "  sel : a -> String",
    "impl Sel a where",
    "  sel _ = \"GEN\"",
    "export interface Sup a where",
    "  sup : a -> String",
    "export interface Sub a requires Sup a where",
    "  sub : a -> String",
    "impl Sup a where",
    "  sup _ = \"GEN\"",
    "export interface Lone a where",
    "  lone : a -> String",
    "export interface LoneSub a requires Lone a where",
    "  loneSub : a -> String",
    "export interface R a where",
    "  r : a -> String",
    "impl R a where",
    "  r _ = \"GEN\"",
    "export interface Mo a where",
    "  mo : a -> String",
  ],
)

arrowHeadEntry : List String -> (List String, String)
arrowHeadEntry lines = aliasHeadOutcome [
  arrowHeadLib,
  (
    "entry",
    joinNl
      ([
          "import lib.*",
          "isPos : Int -> Bool",
          "isPos _ = True",
        ]
        ++ lines),
  ),
]

arrowHeadSelection : Bool -> (List String, String)
arrowHeadSelection arrow = arrowHeadEntry [
  "impl Sel \{arrowHeadVar arrow} where",
  "  sel _ = \"SPEC\"",
  "main = sel \{arrowHeadValue arrow}",
]

arrowHeadCoherence : Bool -> (List String, String)
arrowHeadCoherence arrow = arrowHeadEntry [
  "impl Lone \{arrowHeadVar arrow} where",
  "  lone _ = \"one\"",
  "impl Lone \{arrowHeadVar arrow} where",
  "  lone _ = \"two\"",
  "main = lone \{arrowHeadValue arrow}",
]

arrowHeadSuperExistence : Bool -> (List String, String)
arrowHeadSuperExistence arrow = arrowHeadEntry [
  "impl LoneSub \{arrowHeadVar arrow} where",
  "  loneSub _ = \"s\"",
  "main = loneSub \{arrowHeadValue arrow}",
]

-- The super dictionary `useSup` receives is built from the entry's impl, whose
-- `requires Show2 b` is owed at `b = Bool`.
arrowHeadSuperConstruction : List String -> Bool -> (List String, String)
arrowHeadSuperConstruction extra arrow =
  arrowHeadEntry
    (extra
      ++ [
        "impl Sup \{arrowHeadVar arrow} requires Show2 b where",
        "  sup _ = \"SUP\"",
        "impl Sub \{arrowHeadVar arrow} requires Show2 b where",
        "  sub _ = \"sub\"",
        "useSup : Sub a => a -> String",
        "useSup x = sup x",
        "main = useSup \{arrowHeadValue arrow}",
      ])

arrowHeadRequires : List String -> Bool -> (List String, String)
arrowHeadRequires extra arrow =
  arrowHeadEntry
    (extra
      ++ [
        "impl R \{arrowHeadVar arrow} requires Show2 b where",
        "  r _ = \"R\"",
        "main = r \{arrowHeadValue arrow}",
      ])

arrowHeadShowBool : List String
arrowHeadShowBool = ["impl Show2 Bool where", "  show2 _ = \"b\""]

arrowHeadMinOrder : Bool -> (List String, String)
arrowHeadMinOrder arrow = arrowHeadEntry [
  "impl Mo \{arrowHeadGeneral arrow} where",
  "  mo _ = \"GEN\"",
  "impl Mo \{arrowHeadBool arrow} where",
  "  mo _ = \"SPEC\"",
  "main = mo \{arrowHeadValue arrow}",
]

test "arrow-head judgment matrix: selection" =
  aliasHeadVerdicts ([], "SPEC") arrowHeadSelection

test "arrow-head judgment matrix: coherence" =
  aliasHeadVerdicts (["T-CONFLICTING-IMPL"], "") arrowHeadCoherence

test "arrow-head judgment matrix: super existence" =
  aliasHeadVerdicts (["T-MISSING-SUPER-IMPL"], "") arrowHeadSuperExistence

test "arrow-head judgment matrix: super construction" = expectEach [
  (
    "unsatisfied requires",
    aliasHeadVerdicts (["T-NO-IMPL"], "") (arrowHeadSuperConstruction []),
  ),
  (
    "satisfied requires",
    aliasHeadVerdicts ([], "SUP") (arrowHeadSuperConstruction arrowHeadShowBool),
  ),
]

test "arrow-head judgment matrix: requires" = expectEach [
  (
    "unsatisfied requires",
    aliasHeadVerdicts (["T-NO-IMPL"], "") (arrowHeadRequires []),
  ),
  (
    "satisfied requires",
    aliasHeadVerdicts ([], "R") (arrowHeadRequires arrowHeadShowBool),
  ),
]

test "arrow-head judgment matrix: min order" =
  aliasHeadVerdicts ([], "SPEC") arrowHeadMinOrder

-- A goal that mixes a constructed head with a variable defers to its use whatever
-- the constructed head is: never called, `f` generalizes over the goal, and called,
-- it is rejected at the call.
arrowMixedProgram : String -> Bool -> (List String, String)
arrowMixedProgram mainLine arrow =
  aliasHeadOutcome
    (aliasHeadModule [
      "interface C a b where",
      "  c : a -> b -> String",
      "impl C Int Int where",
      "  c _ _ = \"ii\"",
      "data Box a = Box a",
      "isPos : Int -> Bool",
      "isPos _ = True",
      "f x = c \{arrowHeadValue arrow} x",
      mainLine,
    ])

test "a mixed arrow goal defers to its use, as a mixed Box goal does" = expectEach
  [
    (
      "never called",
      aliasHeadVerdicts ([], "ok") (arrowMixedProgram "main = \"ok\""),
    ),
    (
      "called",
      aliasHeadVerdicts (["T-NO-IMPL"], "") (arrowMixedProgram "main = f 1"),
    ),
  ]

-- In an impl body the head variable is rigid, so the same mixed goal is decided
-- there: a `requires` declares it, and otherwise it is rejected at the body.
implMixedProgram : (Bool -> List String) -> Bool -> (List String, String)
implMixedProgram lines arrow =
  aliasHeadOutcome
    (aliasHeadModule
      ([
          "interface C a b where",
          "  c : a -> b -> String",
          "impl C Int Int where",
          "  c _ _ = \"ii\"",
          "interface Def a b where",
          "  def : b -> a",
          "impl Def Int Int where",
          "  def x = x + 41",
          "data Box a = Box a",
          "isPos : Int -> Bool",
          "isPos _ = True",
          "interface Q a where",
          "  q : a -> String",
          "interface R a where",
          "  r : a -> b -> String",
        ]
        ++ lines arrow))

-- The constructed argument's type, then one built around a variable the body owns,
-- then one built around the impl-head variable `x`.
mixedType : Bool -> String
mixedType arrow = if arrow then "(Int -> Bool)" else "(Box Bool)"

mixedOpenValue : Bool -> String
mixedOpenValue arrow = if arrow then "(y => y)" else "(Box [])"

mixedHeadValue : Bool -> String
mixedHeadValue arrow = if arrow then "(z => x)" else "(Box x)"

test "a mixed goal in an impl body is declared or rejected there" = expectEach [
  (
    "parametric head",
    aliasHeadVerdicts
      (["T-IMPL-MISSING-REQUIRES"], "")
      (implMixedProgram (arrow => [
        "impl Q (Box a) where",
        "  q (Box x) = c \{arrowHeadValue arrow} x",
        "main = q (Box (1 : Int))",
      ])),
  ),
  (
    "blanket head",
    aliasHeadVerdicts
      (["T-IMPL-MISSING-REQUIRES"], "")
      (implMixedProgram (arrow => [
        "impl Q a where",
        "  q x = c \{arrowHeadValue arrow} x",
        "main = q (1 : Int)",
      ])),
  ),
  (
    "exact return",
    aliasHeadVerdicts
      (["T-IMPL-MISSING-REQUIRES"], "")
      (implMixedProgram (arrow => [
        "impl Q (Box a) where",
        "  q (Box x) =",
        "    let f : \{mixedType arrow} = def x",
        "    \"Q\"",
        "main = q (Box (1 : Int))",
      ])),
  ),
  (
    "declared by requires",
    aliasHeadVerdicts
      ([], "R")
      (implMixedProgram (arrow => [
        "impl C \{mixedType arrow} Int where",
        "  c _ _ = \"R\"",
        "impl Q (Box a) requires C \{mixedType arrow} a where",
        "  q (Box x) = c \{arrowHeadValue arrow} x",
        "main = q (Box (1 : Int))",
      ])),
  ),
  (
    "with a body variable no instance unifies with",
    aliasHeadVerdicts
      (["T-NO-IMPL"], "")
      (implMixedProgram (arrow => [
        "impl Q (Box a) where",
        "  q (Box x) = c \{mixedOpenValue arrow} x",
        "main = q (Box (1 : Int))",
      ])),
  ),
  (
    "with a method variable no instance unifies with",
    aliasHeadVerdicts
      (["T-NO-IMPL"], "")
      (implMixedProgram (arrow => [
        "impl R (Box a) where",
        "  r (Box x) y = c \{mixedHeadValue arrow} y",
        "main = r (Box (1 : Int)) True",
      ])),
  ),
]

-- A declared `Num` impl over an arrow answers a literal at that arrow, as one over a
-- `Box` does; a literal applied as a function is rejected where it is used.
arrowNumOutcome : List String -> (List String, String)
arrowNumOutcome lines =
  preludeOutcome numericPreludeSource (aliasHeadModule lines)

arrowNumImpl : Bool -> (List String, String)
arrowNumImpl arrow =
  if arrow then
    arrowNumOutcome [
      "impl Num (Int -> String) where",
      "  fromInt _ = x => \"FN\"",
      "v : Int -> String",
      "v = 7",
      "main = v 0",
    ]
  else
    arrowNumOutcome [
      "data Box a = Box a",
      "unbox : Box a -> a",
      "unbox (Box x) = x",
      "impl Num (Box (Int -> String)) where",
      "  fromInt _ = Box (x => \"FN\")",
      "v : Box (Int -> String)",
      "v = 7",
      "main = unbox v 0",
    ]

test "a Num impl over an arrow is selected like one over a Box" =
  aliasHeadVerdicts ([], "FN") arrowNumImpl

test "a literal applied as a function is rejected at its use" = expectEach [
  (
    "never called",
    expectEqual ([], "ok") (arrowNumOutcome ["f x = 1 x", "main = \"ok\""]),
  ),
  (
    "called",
    expectEqual
      (["T-NO-IMPL"], "")
      (arrowNumOutcome ["f x = 1 x", "main : String", "main = f 2"]),
  ),
]

-- The line `check` prints for [name]'s scheme in [source], checked over the
-- alias-head prelude; the whole report when no such line exists.
superGoalScheme : String -> List String -> String
superGoalScheme name source =
  let report = checkModulesEntryReport defaultDriveInputs [] (desugar
    (parseLocated aliasHeadPrelude)) [
    ("super_goal", desugar (parseLocated (joinNl source))),
  ]
  match filter (startsWith "\{name} : ") (splitNl report)
    line :: _ => line
    [] => report

-- #4044: `D b`, the super goal of `C (Box Bool) b`, has arguments that are all
-- variables.  The matched `impl C (Box a) b` has no context to answer it, so it is a
-- selection: `impl D a` answers it at the binder and `impl D Int` at a use, so the
-- goal is kept as written.
blanketSuperProgram : List String -> List String
blanketSuperProgram extra =
  [
      "interface D a where",
      "  d : a -> String",
      "interface C a b requires D b where",
      "  c : a -> b -> String",
      "data Box a = Box a",
      "impl D a where",
      "  d _ = \"BLANKET\"",
      "impl D Int where",
      "  d _ = \"INT\"",
      "impl C (Box a) b where",
      "  c _ _ = \"c\"",
      "useC : C a b => a -> b -> String",
      "useC x y = d y ++ c x y",
      "g y = useC (Box True) y",
    ]
    ++ extra

test "an all-variable super goal is a selection at a generalizing binder" = expectEach
  [
    (
      "scheme",
      expectEqual
        "g : C (Box Bool) a => a -> String"
        (superGoalScheme "g" (blanketSuperProgram [])),
    ),
    (
      "satisfied use",
      expectEqual
        ([], "INTc")
        (aliasHeadOutcome
          (aliasHeadModule (blanketSuperProgram ["main = g (1 : Int)"]))),
    ),
    (
      "unsatisfied use",
      expectEqual
        (["T-NO-IMPL"], "")
        (aliasHeadOutcome
          (aliasHeadModule
            (blanketSuperProgram [
              "interface Show2 a where",
              "  show2 : a -> String",
              "impl D (List a) requires Show2 a where",
              "  d _ = \"LIST\"",
              "main = g [True]",
            ]))),
    ),
  ]

-- #4043: the super goal `Sup2 (a -> <b> c)` of `Conv (Box Int) (a -> <b> c)` has an
-- arrow argument; `impl Sup2 (Int -> b)` can match it at a use, so the goal is kept.
arrowSuperProgram : List String -> List String
arrowSuperProgram extra =
  [
      "interface Sup2 a where",
      "  sup2 : a -> String",
      "interface Conv a b requires Sup2 b where",
      "  conv : a -> b -> String",
      "data Box a = Box a",
      "impl Sup2 (a -> b) where",
      "  sup2 _ = \"GENFN\"",
      "impl Sup2 (Int -> b) where",
      "  sup2 _ = \"INTFN\"",
      "impl Conv (Box a) (b -> c) where",
      "  conv _ _ = \"conv\"",
      "useC : Conv a b => a -> b -> String",
      "useC x y = sup2 y ++ conv x y",
      "inc : Int -> Int",
      "inc x = x",
      "g f = useC (Box (1 : Int)) (y => f y)",
    ]
    ++ extra

test "an arrow super goal is a selection at a generalizing binder" = expectEach
  [
    (
      "scheme",
      expectEqual
        "g : Conv (Box Int) (a -> <b> c) => (a -> <b> c) -> String"
        (superGoalScheme "g" (arrowSuperProgram [])),
    ),
    (
      "uses",
      expectEqual
        ([], "INTFNconvINTFNconv")
        (aliasHeadOutcome
          (aliasHeadModule
            (arrowSuperProgram [
              "main = g inc ++ useC (Box (1 : Int)) (y => inc y)",
            ]))),
    ),
  ]

-- The super-goal judgment matrix.  `Sub (Wrap Bool) s` has the super goal `Sup s`,
-- where `s` is a constructed type, an arrow or a variable over `g`'s quantified
-- variable.  Every judgment must treat the three shapes alike.
superShapes : List String
superShapes = ["constructed", "arrow", "variable"]

superShapeType : String -> String -> String
superShapeType "constructed" v = "(Box \{v})"
superShapeType "arrow" v = "(Int -> \{v})"
superShapeType _ v = v

superShapeValue : String -> String -> String
superShapeValue "constructed" v = "(Box \{v})"
superShapeValue "arrow" v = "(konst \{v})"
superShapeValue _ v = v

-- `sup`'s body, which reaches the shape's one `b` value.
superShapeSup : String -> String
superShapeSup "constructed" = "  sup (Box v) = show2 [v]"
superShapeSup "arrow" = "  sup f = show2 [f 1]"
superShapeSup _ = "  sup v = show2 [v]"

superShapeProgram : String -> List String -> List String
superShapeProgram shape extra =
  [
      "interface Show2 a where",
      "  show2 : a -> String",
      "impl Show2 Bool where",
      "  show2 _ = \"b\"",
      "data Box a = Box a",
      "data Wrap a = Wrap a",
      "konst : b -> Int -> b",
      "konst y _ = y",
      "interface Sup a where",
      "  sup : a -> String",
      "interface Sub a b requires Sup b where",
      "  sub : a -> b -> String",
      "useSub : Sub a b => a -> b -> String",
      "useSub x y = sup y ++ sub x y",
      "g y = useSub (Wrap True) \{superShapeValue shape "y"}",
    ]
    ++ extra

-- A blanket `Sup`, the `Sub` impl, and a more specific `Sup` at the shape over
-- `Two c`, which a use at `Two Bool` selects; its `requires Show4 c` is owed there.
superShapeOverlap : String -> List String -> List String
superShapeOverlap shape extra =
  superShapeProgram
    shape
    ([
        "data Two a = Two a",
        "interface Show4 a where",
        "  show4 : a -> String",
        "impl Sup a where",
        "  sup _ = \"GEN\"",
        "impl Sup \{superShapeType shape "(Two c)"} requires Show4 c where",
        "  sup _ = \"SPEC\"",
        "impl Sub (Wrap a) b where",
        "  sub _ _ = \"sub\"",
      ]
      ++ extra)

-- The `Sup` instance at the shape requires `Show2 (List b)`, which `impl Show2 (List
-- Bool)` can answer at a use, so the carried goal stays in `g`'s scheme beside what
-- the `Sub` impl's own context leaves.  For the variable shape that instance is the
-- blanket one, and the `Sub` impl's `requires Show2 b` entails its context.
superShapeCarry : String -> List String
superShapeCarry shape =
  superShapeProgram
    shape
    ([
        "impl Show2 (List a) requires Show2 a where",
        "  show2 _ = \"L\"",
        "impl Show2 (List Bool) where",
        "  show2 _ = \"LB\"",
        "impl Sup \{superShapeType shape "b"} requires Show2 (List b) where",
        superShapeSup shape,
      ]
      ++ (if shape == "variable" then
        ["impl Sub (Wrap a) b requires Show2 b where", "  sub _ _ = \"sub\""]
      else
        [
          "impl Sup a where",
          "  sup _ = \"GEN\"",
          "impl Sub (Wrap a) b where",
          "  sub _ _ = \"sub\"",
        ]))

superShapeVerdicts : (Eq a, Debug a) =>
  (String -> a) ->
  (String -> a) ->
  Expectation
superShapeVerdicts expected observe =
  expectEach (map (s => (s, expectEqual (expected s) (observe s))) superShapes)

superShapeRun : List String -> (List String, String)
superShapeRun program = aliasHeadOutcome (aliasHeadModule program)

test "super-goal judgment matrix: stability test" = expectEach [
  (
    "unsatisfied requires",
    superShapeVerdicts
      (_ => (["T-NO-IMPL"], ""))
      (s => superShapeRun (superShapeOverlap s ["main = g (Two True)"])),
  ),
  (
    "satisfied requires",
    superShapeVerdicts
      (_ => ([], "SPECsub"))
      (s =>
        superShapeRun
          (superShapeOverlap s [
            "impl Show4 Bool where",
            "  show4 _ = \"4\"",
            "main = g (Two True)",
          ])),
  ),
]

test "super-goal judgment matrix: generalized scheme" =
  superShapeVerdicts
    (s => "g : Sub (Wrap Bool) \{superShapeType s "a"} => a -> String")
    (s => superGoalScheme "g" (superShapeOverlap s []))

-- Pins the scheme only: the variable shape's program builds the wrong super
-- dictionary and crashes on run, a separate open defect.
test "super-goal judgment matrix: carry" =
  superShapeVerdicts
    (s =>
      if s == "variable" then
        "g : (Show2 (List a), Show2 a) => a -> String"
      else
        "g : Show2 (List a) => a -> String")
    (s => superGoalScheme "g" (superShapeCarry s))

-- A stable super selection is reduced: with only the blanket `Sup`, `g` keeps no
-- goal, and its use builds the blanket super.
test "super-goal judgment matrix: residual" =
  superShapeVerdicts
    (_ => ("g : a -> String", ([], "GENsub")))
    (s =>
      let program = superShapeProgram s [
        "impl Sup a where",
        "  sup _ = \"GEN\"",
        "impl Sub (Wrap a) b where",
        "  sub _ _ = \"sub\"",
      ]
      (
        superGoalScheme "g" program,
        superShapeRun (program ++ ["main = g True"]),
      ))

-- The #4023 controls: a goal whose super selection is stable reduces at the
-- binder, and each use builds the super its own instantiation selects.
test "a stable super selection builds each use's super" =
  expectEqual
    ([], "supsub suptbsub")
    (aliasHeadOutcome
      (aliasHeadModule [
        "interface Show2 t where",
        "  show2 : t -> String",
        "impl Show2 Bool where",
        "  show2 _ = \"b\"",
        "interface Sup a where",
        "  sup : a -> String",
        "interface Sub a requires Sup a where",
        "  sub : a -> String",
        "data Box a = Box a",
        "data Two a = Two a",
        "impl Sup (Box a) where",
        "  sup _ = \"sup\"",
        "impl Sup (Box (Two a)) requires Show2 a where",
        "  sup (Box (Two x)) = \"supt\" ++ show2 x",
        "impl Sub (Box a) where",
        "  sub _ = \"sub\"",
        "useSup : Sub a => a -> String",
        "useSup x = sup x ++ sub x",
        "main = useSup (Box True) ++ \" \" ++ useSup (Box (Two True))",
      ]))

-- A closed goal that no instance row answers keeps no route.  What the program
-- gets instead is the boundary's own located diagnostic: the first residual of
-- the drive, as (code, line, column), and whether the lowered tree still holds a
-- bare head-tag `RKey` (a key without the canonical `|`, which names no
-- instance).
closedGoalOutcome : String -> List String -> ((String, Int, Int), Bool)
closedGoalOutcome prelude lines =
  let elab = elaborateModules defaultDriveInputs [] (desugar (parse prelude)) [
    ("closed_goal", desugar (parseLocated (joinNl lines))),
  ]
  let (coreD, modules, _, residual, _, _, _) = elab
  let first = match residual
    (_, TcDiag code _ (Some (Loc _ line col _ _)) _ _ _) :: _ =>
      (code, line, col)
    (_, TcDiag code _ None _ _ _) :: _ => (code, 0, 0)
    [] => ("", 0, 0)
  let sexp =
    cprogramToSexp
      (lowerProgramWithFacts (factsOfElab elab) (coreD ++ flatMap snd modules))
  (first, hasBareRKey (splitOnChar '"' sexp))

-- [segments] is the sexp split at every quote, so a route key is the segment
-- that follows one ending in `RKey `.
hasBareRKey : List String -> Bool
hasBareRKey (before :: rest@(key :: _)) =
  endsWith "RKey " before && listLen (splitOnChar '|' key) == 1
    || hasBareRKey rest
hasBareRKey _ = False

closedGoalEqPrelude : String
closedGoalEqPrelude = joinNl [
  "interface Eq a where",
  "  eq : a -> a -> Bool",
  "impl Eq Int where",
  "  eq a b = True",
]

test "a closed return goal with no instance keeps no route" = expectEach [
  (
    "deferred: a rigid result the one instance does not cover",
    expectEqual
      (("T-MISSING-CONSTRAINT", 7, 6), False)
      (closedGoalOutcome numericPreludeSource [
        "interface Mk a where",
        "  mk : Int -> a",
        "data Box a = Box a",
        "impl Mk (Box Int) where",
        "  mk n = Box n",
        "g : Int -> Box a",
        "g n = mk n",
      ]),
  ),
  (
    "insoluble: a ground result with no instance",
    expectEqual
      (("T-NO-IMPL", 8, 14), False)
      (closedGoalOutcome numericPreludeSource [
        "interface Mk a where",
        "  mk : Int -> a",
        "data Box a = Box a",
        "impl Mk Int where",
        "  mk n = n",
        "unbox : Box Int -> Int",
        "unbox (Box n) = n",
        "main = unbox (mk 1)",
      ]),
  ),
  (
    "vector: a phantom method selected on its interface vector",
    expectEqual
      (("T-PHANTOM-METHOD", 3, 12), False)
      (closedGoalOutcome numericPreludeSource [
        "interface Mk a where",
        "  mk : Int -> a",
        "  phantom : Int",
        "data Red = Red Int",
        "impl Mk Red where",
        "  mk n = Red n",
        "  phantom = 7",
        "useBoth : Mk a => a -> Int",
        "useBoth _ = phantom",
        "main = useBoth (Red 1)",
      ]),
  ),
]

test "a closed numeric, nested or operator goal with no instance keeps no route" = expectEach
  [
    (
      "a literal at a type with no Num instance",
      expectEqual
        (("T-TYPE-MISMATCH", 3, 4), False)
        (closedGoalOutcome numericPreludeSource [
          "data Nat = Z | S Nat", "n : Nat", "n = 3"
        ]),
    ),
    (
      "a constrained call at a type with no instance",
      expectEqual
        (("T-NO-IMPL", 7, 7), False)
        (closedGoalOutcome numericPreludeSource [
          "interface Sz a where",
          "  sz : a -> Int",
          "impl Sz Int where",
          "  sz n = n",
          "useSz : Sz a => a -> Int",
          "useSz x = sz x",
          "main = useSz True",
        ]),
    ),
    (
      "an operator over a type with no instance",
      expectEqual
        (("T-NO-IMPL", 2, 7), False)
        (closedGoalOutcome closedGoalEqPrelude [
          "data Color = Red | Green | Blue", "main = Red == Green"
        ]),
    ),
  ]

-- #2705: every array indexed by evidence ordinals spans one graph lineage,
-- so repeating an unkeyed drive in one process leaves it the size the first drive
-- left it, however many ordinals the earlier drives minted.
spanProgramModule : (String, List Decl)
spanProgramModule = (
  "span_probe",
  desugar
    (parseLocated
      (joinNl [
        "value : Int", "value = fromInt 3", "other : Int",
        "other = fromInt value"
      ])),
)

-- The method-cell index's length and the returned table's slot count after one
-- unkeyed `elaborateModules` drive.
elaborateSpans : Unit -> (Int, Int)
elaborateSpans _ = fst (elaborateSpansGraph ())

-- `elaborateSpans` beside the graph record of its drive.
elaborateSpansGraph : Unit -> ((Int, Int), GraphCtx)
elaborateSpansGraph _ =
  let ((_, _, _, _, table, _, _), gctx) =
    elaborateModulesGraph
      (driveArgs defaultDriveInputs False None [] (desugar
        (parse numericPreludeSource)) [
        spanProgramModule,
      ])
  ((evCellsSpanProbe gctx, evIndexSlotCount (evIndexOf table)), gctx)

-- The method-cell index's length after one unkeyed `checkOneDiags` drive.
diagsSpan : Unit -> Int
diagsSpan _ =
  let (_, gctx) =
    checkOneDiagsGraph
      (driveArgs defaultDriveInputs False None [] (desugar
        (parse numericPreludeSource)) [
        spanProgramModule,
      ])
  evCellsSpanProbe gctx

-- [drive]'s reading after the first and after the [n]th of [n] drives.
firstAndNth : Int -> (Unit -> a) -> (a, a)
firstAndNth n drive =
  let first = drive ()
  (first, driveAgain (n - 1) drive first)

driveAgain : Int -> (Unit -> a) -> a -> a
driveAgain k drive seen =
  if k <= 0 then seen else driveAgain (k - 1) drive (drive ())

test "twenty unkeyed elaborateModules drives keep the evidence arrays one graph wide" =
  let (first, twentieth) = firstAndNth 20 elaborateSpans
  expectAll [
    expectGreaterThan 0 (fst first),
    expectGreaterThan 0 (snd first),
    expectEqual first twentieth,
  ]

test "twenty unkeyed checkOneDiags drives keep the method-cell index one graph wide" =
  let (first, twentieth) = firstAndNth 20 diagsSpan
  expectAll [expectGreaterThan 0 first, expectEqual first twentieth]

-- A prelude with a data declaration and an exhaustive match of it.
seedCoreDecls : Unit -> List Decl
seedCoreDecls _ =
  desugar
    (parseLocated
      (joinNl [
        "public export data Shape = Circle | Square", "area : Shape -> Int",
        "area s = match s", "  Circle => 1", "  Square => 2"
      ]))

-- The record `checkModulesK`'s fold hands its first user module, whose oracle and
-- warnings `cmCheckWorker` seeds that module with (`checkRunResidue`).  With no
-- user module, `checkModulesPartialLast` (the same preamble and fold) returns it.
firstModuleSeed : Unit -> (List String, Bool)
firstModuleSeed _ =
  let (_, ctx) =
    checkModulesPartialLast
      defaultDriveInputs
      (Some (4366, 4367))
      []
      (seedCoreDecls ())
      []
  (omKeys ctx.mcCells.matchOracle.value.ctorArity, matchWarningsNow ctx)

-- The record this drive hands its first module holds an empty oracle and no
-- match warnings, on the keyed miss and on the hit after it.  The oracle was
-- already empty at base; this row does not drive `cmCheckWorker`.  Core is
-- checked from an empty oracle, so its own record holds a spurious
-- non-exhaustive warning for every match on a prelude type; the blank record past
-- the core pass carries none, which is intended: they are not findings about any
-- user module.
test "a zero-user-module record carries an empty oracle and no match warnings" =
  let miss = firstModuleSeed ()
  let hit = firstModuleSeed ()
  let empty = (omKeys (buildOracle []).ctorArity, False)
  expectEqual [empty, empty] [miss, hit]

-- ── what a signature's givens accept and reject through one check ──

sizeable : String
sizeable =
  """
interface Sz a where
  sz : a -> Int
impl Sz Int where
  sz _ = 1
"""

test "a signature's constraint is a given for its body" =
  expectChecks (joinNl [sizeable, "g : Sz a => a -> Int", "g x = sz x"])

test "a body that needs a constraint its signature omits is rejected as a missing constraint" =
  expectRejectedWith
    ["T-MISSING-CONSTRAINT"]
    (joinNl [sizeable, "g : a -> Int", "g x = sz x"])

test "a given's superclass closure answers a goal on the super" =
  expectChecks
    """
\{sizeable}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
h : Sz2 a => a -> Int
h x = sz x
"""

test "a given of the super does not answer a goal on the sub" =
  expectRejectedWith
    ["T-MISSING-CONSTRAINT"]
    """
\{sizeable}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
h : Sz a => a -> Int
h x = sz2 x
"""

test "an impl's requires slot is a given for the impl's methods" =
  expectChecks
    """
\{sizeable}
data Box a = Box a
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
"""

test "a requires the impl does not declare is rejected at the use" =
  expectRejectedWith
    ["T-MISSING-CONSTRAINT"]
    """
\{sizeable}
data Box a = Box a
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
k : a -> Int
k v = sz (Box v)
"""

-- ── what an instance, a given and a superclass entail, through one check ──

sizeableShapes : String
sizeableShapes =
  joinNl [sizeable, "data Box a = Box a", "data Pair a b = Pair a b"]

test "a goal an instance answers is entailed" =
  expectChecks (joinNl [sizeableShapes, "f : Int", "f = sz 1"])

test "a goal no instance answers is rejected as having no impl" =
  expectRejectedWith
    ["T-NO-IMPL"]
    (joinNl [sizeableShapes, "f : Int", "f = sz True"])

test "an instance's prerequisite is owed at the use, and is met by the instance of its argument" = expectEach
  [
    (
      "prerequisite met",
      expectChecks
        """
\{sizeableShapes}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
f : Int
f = sz (Box 1)
""",
    ),
    (
      "prerequisite absent",
      expectRejectedWith
        ["T-NO-IMPL"]
        """
\{sizeableShapes}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
f : Int
f = sz (Box True)
""",
    ),
  ]

test "a given discharges the prerequisite of the instance a goal selects" =
  expectChecks
    """
\{sizeableShapes}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
h : Sz a => Box a -> Int
h b = sz b
"""

test "an instance of a sub-interface without the instance of its super is rejected" =
  expectRejectedWith
    ["T-MISSING-SUPER-IMPL"]
    """
\{sizeableShapes}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
impl Sz2 Bool where
  sz2 _ = 1
"""

test "an instance of a sub-interface beside its super's instance is entailed" =
  expectChecks
    """
\{sizeableShapes}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
impl Sz2 Int where
  sz2 _ = 1
f : Int
f = sz2 1 + sz 2
"""

overlapping : String
overlapping =
  """
\{sizeableShapes}
impl Sz (Box a) where
  sz _ = 2
impl Sz (Box Int) where
  sz _ = 3
"""

test "of two instances that both match, the strictly more specific one is the route" =
  let specificOnly =
    routeWordsOf
      (joinNl [
        sizeableShapes, "impl Sz (Box Int) where", "  sz _ = 3", "f : Int",
        "f = sz (Box 1)"
      ])
  expectAll [
    expectChecks (joinNl [overlapping, "f : Int", "f = sz (Box 1)"]),
    expectEqual
      specificOnly
      (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box 1)"])),
  ]

test "the general instance is the route for a goal only it matches" =
  let generalOnly =
    routeWordsOf
      (joinNl [
        sizeableShapes, "impl Sz (Box a) where", "  sz _ = 2", "f : Int",
        "f = sz (Box True)"
      ])
  expectEqual
    generalOnly
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box True)"]))

test "the specific and the general instance name different routes" =
  expectNotEqual
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box 1)"]))
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box True)"]))

incomparable : String
incomparable =
  """
\{sizeableShapes}
impl Sz (Pair a Int) where
  sz _ = 2
impl Sz (Pair Int b) where
  sz _ = 3
"""

test "two matching instances neither of which is more specific are an ambiguous instance" =
  expectRejectedWith
    ["T-AMBIGUOUS-INSTANCE"]
    (joinNl [incomparable, "f : Int", "f = sz (Pair 1 2)"])

test "a goal only one of two incomparable instances matches is not ambiguous" =
  expectChecks (joinNl [incomparable, "f : Int", "f = sz (Pair True 2)"])

-- ── the law ───────────────────────────────────────────────────────────────

-- The instance heads and goals of the property, as source text.  Each head overlaps some of
-- the goals; `Pair a Int` and `Pair Int b` are incomparable where both match.
headPool : List String
headPool = ["Box a", "Box Int", "Pair a Int", "Pair Int b", "Box Bool"]

goalPool : List String
goalPool = ["Box 1", "Box True", "Pair 1 2", "Pair True 2", "Pair 1 True"]

data RouteCase = RouteCase (List Int) Int

impl Arbitrary RouteCase where
  arbitrary () = RouteCase (pickHeads (randomInt 1 5) []) (randomInt 0 4)
  shrink (RouteCase heads goal) = match heads
    _ :: rest@(_ :: _) => [RouteCase rest goal]
    _ => []

-- Up to [n] distinct pool indices, in draw order.
pickHeads : Int -> List Int -> <Rand> List Int
pickHeads n acc
  | n <= 0 = acc
  | otherwise =
    let i = randomInt 0 4
    if elem i acc then pickHeads (n - 1) acc else pickHeads (n - 1) (i :: acc)

-- The program that declares the pool heads [heads] in order and asks for the pool goal
-- [goal]; `None` when an index lies outside its pool, which fails the property instead of
-- reading as an empty head.
programOf : List Int -> Int -> Option String
programOf heads goal = match (get goal goalPool, implSources heads)
  (Some g, Some impls) =>
    Some (joinNl ([sizeableShapes] ++ impls ++ ["f : Int", "f = sz (\{g})"]))
  _ => None

implSources : List Int -> Option (List String)
implSources [] = Some []
implSources (i :: rest) = match (get i headPool, implSources rest)
  (Some head, Some more) => Some (implSource head i :: more)
  _ => None

implSource : String -> Int -> String
implSource head i = """
impl Sz (\{head}) where
  sz _ = \{intToString (i + 2)}
"""

-- Law: the route a goal is stamped with, and whether it is accepted, do not depend on the
-- order the instances are declared in.  Precondition: the goal is accepted, so that a
-- route exists to compare; ambiguous draws check the verdict alone.
prop "a goal's route and verdict do not depend on the order its instances are declared in" (c : RouteCase) =
  let (RouteCase heads goal) = c
  match (programOf heads goal, programOf (reverse heads) goal)
    (Some forward, Some backward) =>
      checkCodes forward == checkCodes backward
        && (checkCodes forward /= []
          || routeWordsOf forward == routeWordsOf backward)
    _ => False

-- ── what the obligation checks accept and reject through one check ──

base : String
base = joinNl [
  "interface Sz a where",
  "  sz : a -> Int",
  "interface Make a where",
  "  make : Unit -> a",
  "impl Make Int where",
  "  make _ = 1",
  "impl Sz Int where",
  "  sz _ = 1",
  "data Box a = Box a",
]

test "a call at a type with no instance is rejected as having no impl" =
  expectRejectedWith ["T-NO-IMPL"] (joinNl [base, "h : Int", "h = sz True"])

test "a goal on an undetermined type no instance can fix is rejected as having no impl" =
  expectRejectedWith
    ["T-NO-IMPL"]
    (joinNl [
      "interface Sz a where",
      "  sz : a -> Int",
      "interface Make a where",
      "  make : Unit -> a",
      "impl Make Int where",
      "  make _ = 1",
      "f : Int",
      "f = sz (make ())",
    ])

test "a body that uses an interface its signature omits is rejected as a missing constraint" = expectEach
  [
    (
      "a bare variable",
      expectRejectedWith
        ["T-MISSING-CONSTRAINT"]
        (joinNl [base, "k : a -> Int", "k v = sz v"]),
    ),
    (
      "a variable under a constructor",
      expectRejectedWith
        ["T-MISSING-CONSTRAINT"]
        (joinNl [base, "k : Box a -> Int", "k v = sz v"]),
    ),
  ]

test "a signature that declares the constraint is accepted" =
  expectChecks (joinNl [base, "k : Sz a => a -> Int", "k v = sz v"])

test "an inferred constraint is promoted to the binder and met at a use with an instance" =
  expectChecks (joinNl [base, "g x = sz x", "h : Int", "h = g 1"])

test "an inferred constraint is owed at every use, and unmet at a type with no instance" =
  expectRejectedWith
    ["T-NO-IMPL"]
    (joinNl [base, "g x = sz x", "h : Int", "h = g True"])

test "two instances that can match the same type are a conflicting impl" = expectEach
  [
    (
      "the same head",
      expectRejectedWith
        ["T-CONFLICTING-IMPL"]
        (joinNl [base, "impl Sz Int where", "  sz _ = 2"]),
    ),
    (
      "the same head over a variable",
      expectRejectedWith
        ["T-CONFLICTING-IMPL"]
        (joinNl [
          base, "impl Sz (Box a) where", "  sz _ = 1", "impl Sz (Box b) where",
          "  sz _ = 2"
        ]),
    ),
  ]

test "instances whose heads are disjoint do not conflict" =
  expectChecks (joinNl [base, "impl Sz Bool where", "  sz _ = 2"])

test "an impl whose head variable needs an interface it does not require is rejected" =
  expectRejectedWith
    ["T-IMPL-MISSING-REQUIRES"]
    (joinNl [base, "impl Sz (Box a) where", "  sz (Box x) = sz x"])

test "an impl that declares the requirement is accepted" =
  expectChecks
    (joinNl [
      base, "impl Sz (Box a) requires Sz a where", "  sz (Box x) = sz x"
    ])

test "two instances that fit one goal and neither is more specific are an ambiguous instance" =
  expectRejectedWith
    ["T-AMBIGUOUS-INSTANCE"]
    (joinNl [
      base,
      "data Pair a b = Pair a b",
      "impl Sz (Pair a Int) where",
      "  sz _ = 2",
      "impl Sz (Pair Int b) where",
      "  sz _ = 3",
      "f : Int",
      "f = sz (Pair 1 2)",
    ])

test "an unconstrained literal defaults to Int and is accepted" =
  let source = joinNl ["y = 1", "z = (1, 2)"]
  let (_, own) = checkOneSchemeFullK defaultDriveInputs None [] (desugar
    (parse numericPreludeSource)) (
    "probe",
    desugar (parseLocated source),
  )
  expectAll [
    expectEqual [] (map fst (checkDiagsOver numericPreludeSource source)),
    expectEqual ["y : Int", "z : (Int, Int)"] (rendered own),
  ]

test "a body that needs Num its signature omits is rejected as a missing constraint" =
  expectEqual
    ["T-MISSING-CONSTRAINT"]
    (map
      fst
      (checkDiagsOver numericPreludeSource (joinNl ["f : a -> a", "f x = 1"])))

test "a body whose signature declares Num is accepted" =
  expectEqual
    []
    (map
      fst
      (checkDiagsOver
        numericPreludeSource
        (joinNl ["f : Num a => a -> a", "f x = 1"])))

test "a local literal is defaulted at its own boundary and checks" =
  expectEqual
    []
    (map
      fst
      (checkDiagsOver numericPreludeSource (joinNl ["main = let z = 2 in z"])))

-- ── the method-return solver, the discharge memo and the route stamps through one check ──

-- `elaborateOne`'s decls beside the evidence table of the drive that built them.
elaborateOneEvidence : DriveInputs ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  (List Decl, EvTable)
elaborateOneEvidence inputs runtimeDecls coreDecls prog =
  let (coreE, modulesE, _, _, evidence, _, _) =
    elaborateModules inputs runtimeDecls coreDecls [prog]
  (coreE ++ flatMap snd modulesE, evidence)

-- The evidence table a check drive's report carries; an ill-typed drive's report
-- carries none.
reportEvidence : TcReport -> EvTable
reportEvidence report = match report.trChecked
  Some checked => checked.cpEvidence
  None => []

returnIdentitySource : String
returnIdentitySource = joinNl [
  "data Pair a b = Pair a b",
  "interface Choose a b where",
  "  choose : Unit -> Pair b a",
  "impl Choose Int Bool where",
  "  choose _ = Pair True 41",
  "value : Pair Bool Int",
  "value = choose ()",
]

evIdText : EvId -> String
evIdText (EvId moduleId ordinal) = "\{moduleId}:\{ordinal}"

methodTraceGoalText : MethodReturnTraceEntry -> String
methodTraceGoalText entry = match entry.mrtGoal
  Some ev => evIdText ev
  None => "none"

methodTraceArgs : MethodReturnTraceEntry -> Option (List String)
methodTraceArgs entry = map (map ppMono) entry.mrtArguments

methodTracePublishedOne : MethodReturnTraceEntry -> Bool
methodTracePublishedOne entry = match entry.mrtPublished
  Some (EvOne _) => True
  _ => False

data MethodWantedView = MethodWantedView {
  mwvBody : String,
  mwvInterface : String,
  mwvArguments : List String,
  mwvDestinationShared : Bool,
  mwvScopeShared : Bool,
} deriving (Eq, Debug)

data MethodOutcomeView =
  | MOVGiven EvidenceBinderId
  | MOVInstance Int (List String) (List (String, List String))
  | MOVDeferred
  | MOVInsoluble
  deriving (Eq, Debug)

methodPrerequisiteView : PrerequisiteEvidence -> (String, List String)
methodPrerequisiteView prerequisite = (
  prerequisite.prerequisiteInterface.irName,
  map ppMono prerequisite.prerequisiteArguments,
)

methodOutcomeView : MethodReturnTraceEntry -> Option MethodOutcomeView
methodOutcomeView entry = match entry.mrtOutcome
  Some (Solved (GivenEvidence binder)) => Some (MOVGiven binder)
  Some (Solved (InstanceEvidence (RequestInstanceId identity) args prerequisites _)) =>
    Some
      (MOVInstance
        identity
        (map ppMono args)
        (map methodPrerequisiteView prerequisites))
  Some (Solved (SuperclassEvidence _ _)) => None
  Some (Deferred _ _) => Some MOVDeferred
  Some (Insoluble _ _) => Some MOVInsoluble
  None => None

methodTraceUsesOneOutcome : List MethodReturnTraceEntry -> Bool
methodTraceUsesOneOutcome trace = match map methodOutcomeView trace
  [None, Some checked, Some stamped] => checked == stamped
  _ => False

methodWantedView : MethodReturnTraceEntry -> Option MethodWantedView
methodWantedView entry = match (entry.mrtQualifiedBody, entry.mrtWanted)
  (Some body, Some wanted) => Some MethodWantedView {
    mwvBody = ppMono body,
    mwvInterface = wanted.predicate.predicateInterface.irName,
    mwvArguments = map ppMono wanted.predicate.predicateArguments,
    mwvDestinationShared =
      methodTraceGoalText entry == evIdText wanted.destination,
    mwvScopeShared = wanted.scope == entry.mrtScope,
  }
  _ => None

wantedArgumentStrings : Wanted -> List String
wantedArgumentStrings wanted = map ppMono wanted.predicate.predicateArguments

methodEvInExpr : String -> Expr -> Option EvId
methodEvInExpr target (EMethodAt name _ ev)
  | target == name = Some ev
  | otherwise = None
methodEvInExpr target (ELoc _ expr) = methodEvInExpr target expr
methodEvInExpr target (EApp fn arg) = match methodEvInExpr target fn
  Some ev => Some ev
  None => methodEvInExpr target arg
methodEvInExpr _ _ = None

methodEvInDecls : String -> List Decl -> Option EvId
methodEvInDecls _ [] = None
methodEvInDecls target ((DFunDef _ _ _ body _ _) :: rest) =
  match methodEvInExpr target body
    Some ev => Some ev
    None => methodEvInDecls target rest
methodEvInDecls target (_ :: rest) = methodEvInDecls target rest

test "ordinary return shares declaration identity vector and goal destination" =
  let sink = beginMethodReturnTrace ()
  let (typed, evidence) = elaborateOneEvidence (traced sink) [] (desugar
    (parse numericPreludeSource)) (
    "identity_return",
    desugar (parseLocated returnIdentitySource),
  )
  let trace =
    filter
      (entry => entry.mrtMethod == "choose")
      (finishMethodReturnTrace sink evidence)
  let goals = map methodTraceGoalText trace
  let aggregate = map evIdText (methodEvInDecls "choose" typed)
  let wanted = map methodWantedView trace
  let goalDiffers = match (goals, aggregate)
    (goal :: _, Some methodGoal) => expectNotEqual methodGoal goal
    _ => fail "expected at least one goal and an aggregate method-level goal"
  let goalsAgree = match goals
    first :: second :: third :: [] => expectEach [
      ("the first and second goals agree", expectEqual first second),
      ("the second and third goals agree", expectEqual second third),
    ]
    _ => fail "expected exactly three return goals in the trace"
  expectEach [
    (
      "trace stages are Produced, Checked, Stamped",
      expectEqual
        [MRTProduced, MRTChecked, MRTStamped]
        (map (entry => entry.mrtStage) trace),
    ),
    (
      "every clause's interface origin is this module",
      expectEqual
        ["identity_return", "identity_return", "identity_return"]
        (map
          (entry => match entry.mrtInterface.irOrigin
            OriginModule moduleId => moduleId
            _ => "<unresolved>")
          trace),
    ),
    (
      "every clause's method args are Int, Bool",
      expectEqual
        [Some ["Int", "Bool"], Some ["Int", "Bool"], Some ["Int", "Bool"]]
        (map methodTraceArgs trace),
    ),
    ("all three goals agree", goalsAgree),
    ("the goal differs from the aggregate method-level goal", goalDiffers),
    (
      "every clause published exactly one outcome",
      expectEqual [True, True, True] (map methodTracePublishedOne trace),
    ),
    (
      "the trace uses one outcome",
      expectTrue (methodTraceUsesOneOutcome trace),
    ),
    (
      "outcomes are None, an instance, then given",
      expectTrue (match map methodOutcomeView trace
        [None, Some (MOVInstance _ ["Int", "Bool"] []), Some _] => True
        _ => False),
    ),
    (
      "every clause wants the same Choose view",
      expectEqual
        [
          Some MethodWantedView {
            mwvBody = "Unit -> Pair Bool Int",
            mwvInterface = "Choose",
            mwvArguments = ["Int", "Bool"],
            mwvDestinationShared = True,
            mwvScopeShared = True,
          },
          Some MethodWantedView {
            mwvBody = "Unit -> Pair Bool Int",
            mwvInterface = "Choose",
            mwvArguments = ["Int", "Bool"],
            mwvDestinationShared = True,
            mwvScopeShared = True,
          },
          Some MethodWantedView {
            mwvBody = "Unit -> Pair Bool Int",
            mwvInterface = "Choose",
            mwvArguments = ["Int", "Bool"],
            mwvDestinationShared = True,
            mwvScopeShared = True,
          },
        ]
        wanted,
    ),
  ]

methodCarrierStages : String -> String -> List MethodReturnTraceEntry
methodCarrierStages method source =
  let sink = beginMethodReturnTrace ()
  let (_, evidence) = elaborateOneEvidence (traced sink) [] (desugar
    (parse numericPreludeSource)) (
    "method_carrier",
    desugar (parseLocated source),
  )
  filter
    (entry => entry.mrtMethod == method)
    (finishMethodReturnTrace sink evidence)

test "ordinary return given evidence feeds checking and route publication" =
  let trace =
    methodCarrierStages
      "choose"
      (joinNl [
        "interface GivenChoice a where",
        "  choose : Unit -> a",
        "use : GivenChoice a => Unit -> a",
        "use _ = choose ()",
      ])
  expectAll [
    expectTrue (methodTraceUsesOneOutcome trace),
    expectTrue (match map methodOutcomeView trace
      [None, Some (MOVGiven checked), Some (MOVGiven stamped)] =>
        checked == stamped
      _ => False),
    expectTrue (match trace
      [_, _, stamped] => match stamped.mrtRoute
        Some (RDictFwd _) => listLen stamped.mrtPrerequisites == 0
        _ => False
      _ => False),
  ]

test "return-position standalone shadow bypasses the method-return trace" =
  let trace =
    methodCarrierStages
      "zed"
      (joinNl [
        "interface Zed a where",
        "  zed : a",
        "impl Zed Int where",
        "  zed = 777",
        "zed : Bool",
        "zed = True",
        "value : Bool",
        "value = zed",
      ])
  expectEqual 0 (listLen trace)

test "ordinary return instance evidence retains selected prerequisites" =
  let trace =
    methodCarrierStages
      "make"
      (joinNl [
        "data Box a = Box a",
        "interface Need a where",
        "  need : a -> Int",
        "impl Need Int where",
        "  need n = n",
        "interface Build a where",
        "  make : Unit -> a",
        "impl Build (Box a) requires Need a where",
        "  make _ = Box (need 1)",
        "value : Box Int",
        "value = make ()",
      ])
  expectAll [
    expectTrue (methodTraceUsesOneOutcome trace),
    expectTrue (match map methodOutcomeView trace
      [None, Some (MOVInstance _ ["Box Int"] [("Need", ["Int"])]), Some (MOVInstance _ ["Box Int"] [("Need", ["Int"])])] =>
        True
      _ => False),
    expectTrue (match trace
      [_, _, stamped] => match stamped.mrtRoute
        Some (RKey _ _ _) => listLen stamped.mrtPrerequisites == 1
        _ => False
      _ => False),
  ]

test "ordinary return carrier distinguishes empty and absent-formal boundaries" =
  let empty =
    methodCarrierStages
      "token"
      (joinNl [
        "interface Token where",
        "  token : b -> Int",
        "impl Token where",
        "  token _ = 7",
        "value : Int",
        "value = token ()",
      ])
  let absent =
    methodCarrierStages
      "choose"
      (joinNl [
        "data Pair a b = Pair a b",
        "interface Partial a b where",
        "  choose : Unit -> a",
        "impl Partial Int Bool where",
        "  choose _ = 7",
        "value : Int",
        "value = choose ()",
      ])
  expectAll [
    expectEqual
      [Some [], Some [], Some []]
      (map (entry => map (map ppMono) entry.mrtArguments) empty),
    expectEqual
      [Some [], Some [], Some []]
      (map (entry => map wantedArgumentStrings entry.mrtWanted) empty),
    expectEqual
      [MRTProduced, MRTChecked, MRTStamped]
      (map (entry => entry.mrtStage) absent),
    expectEqual
      [Some ["Int", "Bool"], Some ["Int", "Bool"], Some ["Int", "Bool"]]
      (map methodTraceArgs absent),
  ]

test "absent return formal completes from the exact enclosing given" =
  let trace = methodCarrierStages "hidden" (absentReturnSource False True)
  expectEach [
    (
      "arg trace is complete at every stage",
      expectEqual
        [Some ["a", "a"], Some ["a", "a"], Some ["a", "a"]]
        (map methodTraceArgs trace),
    ),
    (
      "the trace uses one outcome",
      expectTrue (methodTraceUsesOneOutcome trace),
    ),
    (
      "the given and stamped outcomes agree",
      expectTrue (match map methodOutcomeView trace
        [None, Some (MOVGiven checked), Some (MOVGiven stamped)] =>
          checked == stamped
        _ => False),
    ),
    (
      "the stamped clause routes through a dict-forward",
      expectTrue (match trace
        [_, _, stamped] => match stamped.mrtRoute
          Some (RDictFwd _) => True
          _ => False
        _ => False),
    ),
  ]

test "absent return completion cannot leak from a sibling scope" =
  let source = joinNl [
    "interface Hidden a b where",
    "  hidden : Unit -> a",
    "useBool : Hidden a Bool => Bool -> a",
    "useBool witness = hidden ()",
    "useChar : Hidden a Char => Char -> a",
    "useChar witness = hidden ()",
  ]
  let checkedArgs =
    map
      methodTraceSecondArg
      (filter
        (entry => entry.mrtStage == MRTChecked)
        (methodCarrierStages "hidden" source))
  expectAll [
    expectEqual 2 (listLen checkedArgs),
    expectTrue
      (checkedArgs == ["Bool", "Char"] || checkedArgs == ["Char", "Bool"]),
  ]

methodTraceSecondArg : MethodReturnTraceEntry -> String
methodTraceSecondArg entry = match methodTraceArgs entry
  Some [_, argument] => argument
  _ => ""

methodTraceOrigin : MethodReturnTraceEntry -> String
methodTraceOrigin entry = match entry.mrtInterface.irOrigin
  OriginModule moduleId => moduleId
  _ => "<unresolved>"

methodOutcomeSemanticView : MethodReturnTraceEntry ->
  (String, List String, List (String, List String))
methodOutcomeSemanticView entry = match methodOutcomeView entry
  None => ("pending", [], [])
  Some (MOVGiven _) => ("given", [], [])
  Some (MOVInstance _ args prerequisites) => ("instance", args, prerequisites)
  Some MOVDeferred => ("deferred", [], [])
  Some MOVInsoluble => ("insoluble", [], [])

methodRouteKind : MethodReturnTraceEntry -> String
methodRouteKind entry = match entry.mrtRoute
  Some (RKey _ _ _) => "instance"
  Some (RDict _) => "given"
  Some (RDictFwd _) => "given-forwarded"
  Some (RProj _ _) => "given-projected"
  Some (RLocal _ _) => "local"
  Some (RScalar _) => "scalar"
  Some RNone => "none"
  None => "pending"

methodTraceIdentityView : MethodReturnTraceEntry ->
  (MethodReturnTraceStage, String, Option (List String), (String, List String, List (String, List String)), String)
methodTraceIdentityView entry = (
  entry.mrtStage,
  methodTraceOrigin entry,
  methodTraceArgs entry,
  methodOutcomeSemanticView entry,
  methodRouteKind entry,
)

importedReturnObserved : Bool ->
  (Int, List (MethodReturnTraceStage, String, Option (List String), (String, List String, List (String, List String)), String))
importedReturnObserved reverseOrder =
  let owner = (
    "return_owner",
    joinNl [
      "export interface OwnerChoice a where",
      "  choose : Unit -> a",
      "impl OwnerChoice Int where",
      "  choose _ = 41",
    ],
  )
  let foreign = (
    "return_foreign",
    joinNl [
      "export interface ForeignChoice a where",
      "  choose : Unit -> a",
      "impl ForeignChoice Bool where",
      "  choose _ = True",
    ],
  )
  let imports =
    if reverseOrder then
      ["import return_foreign.{choose}", "import return_owner as O"]
    else
      ["import return_owner as O", "import return_foreign.{choose}"]
  let entry = (
    "return_importer",
    joinNl (imports ++ ["value : Int", "value = O.choose ()"]),
  )
  let sources =
    if reverseOrder then [foreign, owner, entry] else [owner, foreign, entry]
  let sink = beginMethodReturnTrace ()
  let (report, _) =
    checkModulesChainReportFor
      (traced sink)
      False
      None
      ""
      []
      []
      (desugar (parse numericPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let results = report.trDiagnostics
  let trace =
    map
      methodTraceIdentityView
      (filter
        (item => item.mrtMethod == "choose")
        (finishMethodReturnTrace sink (reportEvidence report)))
  (modErrorCount results, trace)

test "alias-qualified ordinary returns keep owner identity across import orders" =
  let forward = importedReturnObserved False
  let backward = importedReturnObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [
        (
          MRTProduced,
          "return_owner",
          Some ["Int"],
          ("pending", [], []),
          "pending",
        ),
        (
          MRTChecked,
          "return_owner",
          Some ["Int"],
          ("instance", ["Int"], []),
          "pending",
        ),
        (
          MRTStamped,
          "return_owner",
          Some ["Int"],
          ("instance", ["Int"], []),
          "instance",
        ),
      ]
      (snd forward),
  ]

freshMethodReturnStages : String -> List MethodReturnTraceStage
freshMethodReturnStages moduleId =
  let sink = beginMethodReturnTrace ()
  let (_, evidence) = elaborateOneEvidence (traced sink) [] (desugar
    (parse numericPreludeSource)) (
    moduleId,
    desugar (parseLocated returnIdentitySource),
  )
  map
    (entry => entry.mrtStage)
    (filter
      (entry => entry.mrtMethod == "choose")
      (finishMethodReturnTrace sink evidence))

cachedMethodReturnObserved : String -> (Int, List MethodReturnTraceStage)
cachedMethodReturnObserved entrySource =
  let prefix = joinNl [
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice Int where",
    "  cachedChoose _ = 41",
    "export cached : Int",
    "cached = cachedChoose ()",
  ]
  let sink = beginMethodReturnTrace ()
  let (report, _) =
    checkModulesChainReportFor
      (traced sink)
      False
      (Some (991, 997))
      "method-return-identity-cache"
      [Some "stable-method-return-prefix-v1", None]
      []
      (desugar (parse numericPreludeSource))
      [
        ("return_cache_prefix", desugar (parseLocated prefix)),
        ("return_cache_entry", desugar (parseLocated entrySource)),
      ]
  let stages =
    map
      (entry => entry.mrtStage)
      (filter
        (entry => entry.mrtMethod == "cachedChoose")
        (finishMethodReturnTrace sink (reportEvidence report)))
  (modErrorCount report.trDiagnostics, stages)

test "ordinary return traces are fresh while cache hits replay no events" =
  let first = freshMethodReturnStages "return_fresh"
  let (failedErrors, _) = checkOneDiags defaultDriveInputs [] [] (
    "return_failed",
    desugar (parseLocated "value : Int\nvalue = \"wrong\"\n"),
  )
  let afterFailure = freshMethodReturnStages "return_fresh"
  let success = "import return_cache_prefix.{cached}\nentry = cached\n"
  let cold = cachedMethodReturnObserved success
  let hit = cachedMethodReturnObserved success
  let failedHit = cachedMethodReturnObserved "entry : Int\nentry = \"wrong\"\n"
  let afterFailedHit = cachedMethodReturnObserved success
  expectEach [
    (
      "first's stages are Produced, Checked, Stamped",
      expectEqual [MRTProduced, MRTChecked, MRTStamped] first,
    ),
    ("first == afterFailure", expectEqual first afterFailure),
    (
      "a failing declaration produces at least one error",
      expectGreaterThan 0 (listLen failedErrors),
    ),
    (
      "cold is a fresh 0-error trace",
      expectEqual (0, [MRTProduced, MRTChecked, MRTStamped]) cold,
    ),
    ("hit is a fresh 0-error trace with no stages", expectEqual (0, []) hit),
    (
      "the failed hit records its own error and no stages",
      expectEach [
        ("fst failedHit > 0", expectGreaterThan 0 (fst failedHit)),
        ("snd failedHit == []", expectEqual [] (snd failedHit)),
      ],
    ),
    (
      "afterFailedHit is a fresh 0-error trace",
      expectEqual (0, []) afterFailedHit,
    ),
  ]

data ReturnMemoRequestView = ReturnMemoRequestView {
  rmrvModules : List (String, List (String, String), List (String, String)),
  rmrvReturns : List MethodReturnMemoView,
  rmrvServed : Int,
} deriving (Eq, Debug)

returnMemoModuleView : ModDiags ->
  (String, List (String, String), List (String, String))
returnMemoModuleView (moduleId, (schemes, errors, warnings)) = (
  moduleId,
  map (entry => (fst entry, ppScheme (snd entry).psScheme)) schemes,
  map (diag => (tcCode diag, tcMsg diag)) (errors ++ warnings),
)

returnMemoRelevant : MethodReturnMemoView -> Bool
returnMemoRelevant view =
  view.mrmvMethod == "cachedChoose" || view.mrmvMethod == "hidden"

returnMemoPrefix : Bool -> String
returnMemoPrefix useBool =
  let head = if useBool then "Bool" else "Int"
  let value = if useBool then "True" else "41"
  joinNl [
    "export interface Need a where",
    "  need : a -> Int",
    "impl Need \{head} where",
    "  need _ = 1",
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice \{head} requires Need \{head} where",
    "  cachedChoose _ = \{value}",
    "export cached : \{head}",
    "cached = cachedChoose ()",
    "export interface Hidden a b where",
    "  hidden : Unit -> a",
    "export useHidden : Hidden a b => b -> a",
    "useHidden witness = hidden ()",
  ]

returnMemoEntry : String
returnMemoEntry =
  "import return_memo_prefix.{cached, useHidden}\nentry = cached\n"

returnMemoConflictPrefix : String
returnMemoConflictPrefix = joinNl [
  returnMemoPrefix False,
  "impl CachedChoice Int requires Need Int where",
  "  cachedChoose _ = 99",
]

returnMemoObserved : String -> String -> String -> ReturnMemoRequestView
returnMemoObserved prefixSource entrySource stepKey =
  fst (returnMemoObservedGraph prefixSource entrySource stepKey)

returnMemoObservedGraph : String ->
  String ->
  String ->
  (ReturnMemoRequestView, GraphCtx)
returnMemoObservedGraph prefixSource entrySource stepKey =
  let ((report, outputs), gctx) =
    checkModulesChainReportForGraph
      (chainArgs
        defaultDriveInputs
        noValueMain
        (Some (1091, 1093))
        "method-return-request-fence"
        [Some stepKey, None]
        []
        (desugar (parse numericPreludeSource))
        [
          ("return_memo_prefix", desugar (parseLocated prefixSource)),
          ("return_memo_entry", desugar (parseLocated entrySource)),
        ])
  (
    ReturnMemoRequestView {
      rmrvModules = map returnMemoModuleView report.trDiagnostics,
      rmrvReturns =
        filter returnMemoRelevant (methodReturnMemoCurrentViews gctx),
      rmrvServed = outputs.doServedModules,
    },
    gctx,
  )

returnMemoErrorCount : ReturnMemoRequestView -> Int
returnMemoErrorCount view = returnMemoErrorCountRows view.rmrvModules

returnMemoErrorCountRows : List (String, List (String, String), List (String, String)) ->
  Int
returnMemoErrorCountRows [] = 0
returnMemoErrorCountRows ((_, _, diagnostics) :: rest) =
  listLen diagnostics + returnMemoErrorCountRows rest

returnMemoMethod : String ->
  ReturnMemoRequestView ->
  Option MethodReturnMemoView
returnMemoMethod method view =
  match filter (entry => entry.mrmvMethod == method) view.rmrvReturns
    entry :: _ => Some entry
    [] => None

test "a served prefix reports as the checked one across requests" =
  let pSource = returnMemoPrefix False
  let changedSource = returnMemoPrefix True
  let cold = returnMemoObserved pSource returnMemoEntry pSource
  let hit = returnMemoObserved pSource returnMemoEntry pSource
  let failed =
    returnMemoObserved pSource "entry : Int\nentry = \"wrong\"\n" pSource
  let afterFailed = returnMemoObserved pSource returnMemoEntry pSource
  let conflict =
    returnMemoObserved
      returnMemoConflictPrefix
      returnMemoEntry
      returnMemoConflictPrefix
  let afterConflict = returnMemoObserved pSource returnMemoEntry pSource
  let changed = returnMemoObserved changedSource returnMemoEntry changedSource
  let backToP = returnMemoObserved pSource returnMemoEntry pSource
  let forcedStale = returnMemoObserved changedSource returnMemoEntry pSource
  let coldInstance = returnMemoMethod "cachedChoose" cold
  let changedInstance = returnMemoMethod "cachedChoose" changed
  let coldGiven = returnMemoMethod "hidden" cold
  let instancesDiffer = match (coldInstance, changedInstance)
    (Some before, Some after) => expectEach [
      (
        "the cold request recorded an instance",
        expectEqual "instance" before.mrmvOutcome,
      ),
      (
        "the changed request recorded an instance",
        expectEqual "instance" after.mrmvOutcome,
      ),
      (
        "the cold instance's prerequisite is Need Int",
        expectEqual
          [("return_memo_prefix::Need", ["Int"])]
          before.mrmvPrerequisites,
      ),
      (
        "the changed instance's prerequisite is Need Bool",
        expectEqual
          [("return_memo_prefix::Need", ["Bool"])]
          after.mrmvPrerequisites,
      ),
      (
        "the cold instance published its evidence",
        expectNotEqual "unpublished" before.mrmvEvidence,
      ),
      (
        "the changed instance published its evidence",
        expectNotEqual "unpublished" after.mrmvEvidence,
      ),
      (
        "the two instances rest on different evidence",
        expectNotEqual before.mrmvEvidence after.mrmvEvidence,
      ),
    ]
    _ => fail "expected both requests to record a cachedChoose memo"
  let givenMemo = match coldGiven
    Some given => expectEach [
      (
        "the given memo's method arguments are a, a",
        expectEqual (Some ["a", "a"]) given.mrmvArguments,
      ),
      (
        "it was resolved as a given, not an instance",
        expectEqual "given" given.mrmvOutcome,
      ),
      ("it carries no prerequisites", expectEqual [] given.mrmvPrerequisites),
      (
        "it published its evidence",
        expectNotEqual "unpublished" given.mrmvEvidence,
      ),
    ]
    _ => fail "expected a return memo for the given method 'hidden'"
  expectEach [
    ("cold has no errors", expectEqual 0 (returnMemoErrorCount cold)),
    ("cold checked the prefix", expectEqual 0 cold.rmrvServed),
    ("hit served the prefix", expectEqual 1 hit.rmrvServed),
    ("cold == hit", expectEqual cold.rmrvModules hit.rmrvModules),
    (
      "cold == afterFailed",
      expectEqual cold.rmrvModules afterFailed.rmrvModules,
    ),
    (
      "cold == afterConflict",
      expectEqual cold.rmrvModules afterConflict.rmrvModules,
    ),
    ("cold == backToP", expectEqual cold.rmrvModules backToP.rmrvModules),
    (
      "a failing entry produces at least one error",
      expectGreaterThan 0 (returnMemoErrorCount failed),
    ),
    (
      "a conflicting prefix produces at least one error",
      expectGreaterThan 0 (returnMemoErrorCount conflict),
    ),
    (
      "the changed request re-derives with no errors",
      expectEach [
        ("changed /= cold", expectNotEqual cold changed),
        (
          "returnMemoErrorCount changed == 0",
          expectEqual 0 (returnMemoErrorCount changed),
        ),
      ],
    ),
    (
      "a reused step key over changed impl heads re-derives, because the chain key fingerprints instance heads",
      expectEqual changed forcedStale,
    ),
    (
      "cold and changed instances have distinct prerequisites and evidence",
      instancesDiffer,
    ),
    (
      "the given memo carries the expected arguments and no prerequisites",
      givenMemo,
    ),
  ]

-- #2095: production-path observation of `evidenceObservation`'s
-- entries, one program per family the mission asks for. `elaborateOne`'s two-
-- module shape mirrors `methodCarrierStages` above; the coreDecls half stays the
-- numeric prelude so `intToString` and friends are the same environment those
-- tests already exercise.
evidenceObservationTrace : String -> List EvidenceObservationEntry
evidenceObservationTrace source =
  let sink = beginEvidenceObservation ()
  let _ = elaborateOne (traced sink) [] (desugar (parse numericPreludeSource)) (
    "evidence_observation",
    desugar (parseLocated source),
  )
  finishEvidenceObservation sink

evidenceEntriesWithPredicate : String ->
  List EvidenceObservationEntry ->
  List EvidenceObservationEntry
evidenceEntriesWithPredicate pred = filter (e => e.eoePredicate == Some pred)

scopeOrdinal : ScopeId -> Int
scopeOrdinal (ScopeId n) = n

-- The comparison the pin below is built on: outcome, instance identity,
-- prerequisite identities, and binder scope, exactly the four the mission's
-- mutation checks name. Correct on the real entry; each mutation test shows it
-- FALSE on one deliberately wrong field.
evidenceEntryMatches : (EvidenceOutcomeKind, Option String, List String, Int) ->
  EvidenceObservationEntry ->
  Bool
evidenceEntryMatches (outcome, instanceKey, prerequisites, scopeN) e =
  e.eoeOutcome == outcome
    && e.eoeInstanceKey == instanceKey
    && e.eoePrerequisites == prerequisites
    && scopeOrdinal e.eoeScope == scopeN

test "a nested constrained call forwards the enclosing given (#2095 given forwarding)" =
  let trace =
    evidenceObservationTrace
      (joinNl [
        "interface Give a where",
        "  give : Unit -> a",
        "callGive : Give a => Unit -> a",
        "callGive _ = give ()",
        "useGive : Give a => Unit -> a",
        "useGive _ = callGive ()",
      ])
  let forwarded = evidenceEntriesOfKind "GKDictApp" trace
  expectTrue (match forwarded
    [e] =>
      e.eoeOutcome == EOKGiven
        && e.eoeGivenBinder == Some "$dict_useGive_0"
        && e.eoeArity == 1
    _ => False)

test "a construction goal packs its prerequisite into the instance route (#2095 instance + prerequisites)" =
  let trace =
    evidenceObservationTrace
      (joinNl [
        "data Box a = Box a",
        "interface Need a where",
        "  need : a -> Int",
        "impl Need Int where",
        "  need n = n",
        "interface Build a where",
        "  make : Unit -> a",
        "impl Build (Box a) requires Need a where",
        "  make _ = Box (need 1)",
        "topCall : Build a => Unit -> a",
        "topCall _ = make ()",
        "useTop : Box Int",
        "useTop = topCall ()",
      ])
  let constructed = evidenceEntriesWithPredicate "Box Int" trace
  expectTrue (match constructed
    [e] =>
      e.eoeOutcome == EOKInstance
        && e.eoeInstanceKey
          == Some "evidence_observation::Build|(evidence_observation.Box a)|"
        && e.eoePrerequisites == ["RKey evidence_observation::Need|Int|"]
    _ => False)

test "the construction goal's pin is sensitive to identity, prerequisites, and scope (#2095 mutation)" =
  let trace =
    evidenceObservationTrace
      (joinNl [
        "data Box a = Box a",
        "interface Need a where",
        "  need : a -> Int",
        "impl Need Int where",
        "  need n = n",
        "interface Build a where",
        "  make : Unit -> a",
        "impl Build (Box a) requires Need a where",
        "  make _ = Box (need 1)",
        "topCall : Build a => Unit -> a",
        "topCall _ = make ()",
        "useTop : Box Int",
        "useTop = topCall ()",
      ])
  match evidenceEntriesWithPredicate "Box Int" trace
    [e] =>
      let scopeN = scopeOrdinal e.eoeScope
      expectAll [
        expectTrue
          (evidenceEntryMatches
            (
              EOKInstance,
              Some "evidence_observation::Build|(evidence_observation.Box a)|",
              ["RKey evidence_observation::Need|Int|"],
              scopeN,
            )
            e),
        expectFalse
          (evidenceEntryMatches
            (
              EOKInstance,
              Some "SomethingElse",
              ["RKey evidence_observation::Need|Int|"],
              scopeN,
            )
            e),
        expectFalse
          (evidenceEntryMatches
            (
              EOKInstance,
              Some "evidence_observation::Build|(evidence_observation.Box a)|",
              [],
              scopeN,
            )
            e),
        expectFalse
          (evidenceEntryMatches
            (
              EOKInstance,
              Some "evidence_observation::Build|(evidence_observation.Box a)|",
              ["RKey evidence_observation::Need|Int|"],
              scopeN + 1,
            )
            e),
      ]
    _ => fail "expected exactly one Box Int construction goal"

-- The super `A Int` takes no slot of its own: it is solved at this same goal and
-- carried inside the `B Int` dictionary (#993), which `dict_semantics_ir` pins as the
-- constant's super segment.
test "a super at an instance construction goal rides inside that goal's one slot (#2095, #993, DICT §3 construction)" =
  let trace =
    evidenceObservationTrace
      (joinNl [
        "interface A a where",
        "  m1 : a -> Int",
        "interface B a requires A a where",
        "  m2 : a -> Int",
        "impl A Int where",
        "  m1 _ = 1",
        "impl B Int where",
        "  m2 _ = 2",
        "callB : B a => a -> Int",
        "callB x = m2 x",
        "useB : Int",
        "useB = callB 5",
      ])
  let slots = evidenceEntriesOfKind "GKDictApp" trace
  expectAll [
    expectEqual 1 (listLen slots),
    expectTrue
      (all
        (e =>
          e.eoeArity == 1
            && e.eoeOutcome == EOKInstance
            && e.eoeInstanceKey == Some "evidence_observation::B|Int|")
        slots),
  ]

test "a default body's sibling call is answered by the body's receiver (#2095)" =
  let trace =
    evidenceObservationTrace
      (joinNl [
        "interface Sz a where",
        "  sib : a -> Int",
        "  sz : a -> String",
        "  sz x = \"sz=\" ++ intToString (sib x)",
        "impl Sz Int where",
        "  sib x = x",
      ])
  let abstractSibling = evidenceEntriesWithPredicate "a" trace
  expectEqual
    [(EOKGiven, Some "$self_sz")]
    (map (e => (e.eoeOutcome, e.eoeGivenBinder)) abstractSibling)

-- A drain finding is live when its span is a live goal's.  Goals built after a
-- drain (`pushArithGoal` and its siblings) carry no location, so an unlocated live
-- goal must not make every unlocated finding live.
test "an unlocated drain finding is never live, even beside an unlocated live goal" =
  let at = Some (Loc "m.mdk" 3 4 3 9)
  let live = omFromNames (spanKeys [None, at]) omEmpty
  expectAll [
    expectEqual ["m.mdk:3:4"] (spanKeys [None, at, None]),
    expectFalse (isLiveSpan live None),
    expectTrue (isLiveSpan live at),
    expectFalse (isLiveSpan live (Some (Loc "m.mdk" 3 5 3 9))),
  ]

-- Exports a ground value, a declared-context binding and an inferred-context
-- binding, so the published context rides three routes.
accPrefix : Bool -> String
accPrefix useBool =
  let head = if useBool then "Bool" else "Int"
  let value = if useBool then "True" else "41"
  joinNl [
    "export interface Need a where",
    "  need : a -> Int",
    "impl Need \{head} where",
    "  need _ = 1",
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice \{head} requires Need \{head} where",
    "  cachedChoose _ = \{value}",
    "export cached : \{head}",
    "cached = cachedChoose ()",
    "export interface Hidden a b where",
    "  hidden : Unit -> a",
    "export useHidden : Hidden a b => b -> a",
    "useHidden witness = hidden ()",
    "export useNeed x = need x",
    "export useLocal : Need a => a -> Int",
    "useLocal x =",
    "  let g y = need y",
    "  g x",
  ]

accEntry : String
accEntry = "import acc_prefix.{cached, useHidden, useNeed}\nentry = cached\n"

accConflict : String
accConflict = joinNl [
  accPrefix False,
  "impl CachedChoice Int requires Need Int where",
  "  cachedChoose _ = 99",
]

-- (the keyed chain's report, method-return views taken right after the drive)
accDrive : String ->
  String ->
  String ->
  String ->
  (TcReport, List MethodReturnMemoView)
accDrive chainKey prefixSource entrySource stepKey =
  let (report, views, _) =
    accDriveServed chainKey prefixSource entrySource stepKey
  (report, views)

-- `accDrive` beside the number of modules the drive served.
accDriveServed : String ->
  String ->
  String ->
  String ->
  (TcReport, List MethodReturnMemoView, Int)
accDriveServed chainKey prefixSource entrySource stepKey =
  let ((report, outputs), gctx) =
    checkModulesChainReportForGraph
      (chainArgs
        defaultDriveInputs
        False
        (Some (4053, 4055))
        chainKey
        [Some stepKey, None]
        []
        (desugar (parse numericPreludeSource))
        [
          ("acc_prefix", desugar (parseLocated prefixSource)),
          ("acc_entry", desugar (parseLocated entrySource)),
        ])
  (report, methodReturnMemoCurrentViews gctx, outputs.doServedModules)

-- Schemes WITH their context, diagnostics, the memo views, and the checked
-- program's evidence and dispositions, rendered at the moment of the call.
accRender : (TcReport, List MethodReturnMemoView) -> List String
accRender (r, views) =
  flatMap accRenderMod r.trDiagnostics
    ++ map debug views
    ++ accRenderChecked r.trChecked

accRenderMod : ModDiags -> List String
accRenderMod (mid, (ss, errs, warns)) =
  ["module \{mid}"]
    ++ rendered ss
    ++ map (d => "diag \{tcCode d}: \{tcMsg d}") (errs ++ warns)

-- Each module's schemes and diagnostics alone: what a served module reports as
-- the checked one does.  Its evidence cells are not carried, so the checked
-- program's evidence differs.
accRenderRows : (TcReport, List MethodReturnMemoView) -> List String
accRenderRows (r, _) = flatMap accRenderMod r.trDiagnostics

accLinks : (TcReport, List MethodReturnMemoView) -> Int
accLinks (r, _) =
  fold
    (acc (_, (ss, _, _)) =>
      acc + fold (a e => a + linkCount (snd e).psScheme) 0 ss)
    0
    r.trDiagnostics

data QKind = QKind String (Unit -> Int)

accQs : List QKind
accQs = [
  QKind "clean" (_ =>
    let _ = accDrive "acc-q" (accPrefix False) "entry = 1\n" (accPrefix False)
    0),
  QKind "failing" (_ =>
    let _ =
      accDrive
        "acc-q"
        (accPrefix False)
        "entry : Int\nentry = \"wrong\"\n"
        (accPrefix False)
    0),
  QKind "conflicting" (_ =>
    let _ = accDrive "acc-q" accConflict accEntry accConflict
    0),
  QKind "keyed hit over a ground prefix" (_ =>
    let (_, _, served) =
      accDriveServed "acc-p" (accPrefix False) accEntry (accPrefix False)
    served),
  QKind "keyed miss" (_ =>
    let _ = accDrive "acc-p" (accPrefix True) accEntry (accPrefix True)
    0),
]

accCheck : QKind -> (String, Expectation)
accCheck (QKind name run) =
  let pSrc2 = accPrefix False
  let coldDrive = accDrive "acc-cold-\{name}" pSrc2 accEntry "cold-\{name}"
  let cold = accRender coldDrive
  let held = accDrive "acc-p" pSrc2 accEntry pSrc2
  let heldBefore = accRender held
  let steps = run ()
  let after = accRender held
  let warm = accDrive "acc-p" pSrc2 accEntry pSrc2
  let recold = accDrive "acc-recold-\{name}" pSrc2 accEntry "recold-\{name}"
  let hitRetained =
    if name == "keyed hit over a ground prefix" then
      expectGreaterThan 0 steps
    else
      pass
  (
    name,
    expectEach [
      ("held P renders as it did", expectEqual heldBefore after),
      (
        "re-driven P equals cold P",
        expectEqual (accRenderRows coldDrive) (accRenderRows warm),
      ),
      (
        "P carries an inferred context",
        expectEqual
          ["useNeed : Need a => a -> Int"]
          (filter (== "useNeed : Need a => a -> Int") cold),
      ),
      (
        "a second cold P, after Q, names its local binders as the first did",
        expectEqual cold (accRender recold),
      ),
      ("a hit really served P", hitRetained),
      ("held P publishes no Link", expectEqual 0 (accLinks held)),
      (
        "cold P is checked",
        expectEqual ["checked"] (filter (== "checked") cold),
      ),
      (
        "cold P has evidence and dispositions",
        expectEqual
          (True, True)
          (
            not (isEmpty (filter (startsWith "ev ") cold)),
            not (isEmpty (filter (startsWith "disp ") cold)),
          ),
      ),
    ],
  )

test "P -> Q -> P: P rendered after Q equals cold P, for every kind of Q" =
  expectEach (map accCheck accQs)

test "the keyed chain's report: withheld on an ill-typed graph, checked on a clean one" =
  let pSrc2 = accPrefix False
  let (bad, _) =
    accDrive "acc-chain-bad" pSrc2 "entry : Int\nentry = \"wrong\"\n" pSrc2
  let (good, _) = accDrive "acc-chain-good" pSrc2 accEntry pSrc2
  expectEach [
    ("ill-typed: withheld", expectTrue (isNone bad.trChecked)),
    ("clean: checked", expectTrue (isSome good.trChecked)),
  ]

-- The same-module variant: the instance sits in the prefix module whose own step
-- key changes, so its step misses.  This is a different case from the one above.
test "a graph-visible instance added to the prefix: warm P' equals cold P'" =
  let noInst = joinNl [
    "export interface Speak a where",
    "  speak : a -> String",
    "export useSpeak x = speak x",
  ]
  let withInst = joinNl [noInst, "impl Speak Int where", "  speak _ = \"int\""]
  let entry = "import acc_prefix.{useSpeak}\nentry = useSpeak 1\n"
  let _ = accDrive "acc-inst" noInst entry noInst
  let warm = accRender (accDrive "acc-inst" withInst entry withInst)
  let _ = accDrive "acc-inst-other" (accPrefix False) accEntry (accPrefix False)
  let cold = accRender (accDrive "acc-inst-cold" withInst entry withInst)
  expectEqual cold warm

makeable : String
makeable = joinNl [
  "interface Make a where",
  "  make : Unit -> a",
  "impl Make Int where",
  "  make _ = 1",
  "impl Make Bool where",
  "  make _ = True",
  "interface Sz a where",
  "  sz : a -> Int",
  "impl Sz Int where",
  "  sz _ = 1",
  "impl Sz Bool where",
  "  sz _ = 2",
]

test "a return-position method is routed to the instance its annotation selects" = expectAll
  [
    expectChecks (joinNl [makeable, "f : Int", "f = make ()"]),
    expectEqual
      (routeWordsOf (joinNl [makeable, "f : Int", "f = make ()"]))
      (routeWordsOf (joinNl [makeable, "g : Int", "g = make ()"])),
    expectNotEqual
      (routeWordsOf (joinNl [makeable, "f : Int", "f = make ()"]))
      (routeWordsOf (joinNl [makeable, "f : Bool", "f = make ()"])),
  ]

test "a return-position goal that two instances answer is an ambiguous instance" =
  expectRejectedWith
    ["T-AMBIGUOUS-INSTANCE"]
    (joinNl [makeable, "f : Int", "f = sz (make ())"])

test "a return-position goal is settled by the one instance a consumer allows" =
  expectChecks
    (joinNl [
      "interface Make a where",
      "  make : Unit -> a",
      "impl Make Int where",
      "  make _ = 1",
      "impl Make Bool where",
      "  make _ = True",
      "interface Sz a where",
      "  sz : a -> Int",
      "impl Sz Int where",
      "  sz _ = 1",
      "f : Int",
      "f = sz (make ())",
    ])

numeric : String
numeric = joinNl [
  "interface Num a where",
  "  fromInt : Int -> a",
  "impl Num Int where",
  "  fromInt n = n",
  "data N = N Int",
  "impl Num N where",
  "  fromInt n = N n",
]

-- The binding of [name] at type [ty] to the integer literal [value].
literalAt : String -> String -> Int -> String
literalAt name ty value =
  joinNl ["\{name} : \{ty}", "\{name} = \{intToString value}"]

test "an integer literal is routed to the Num instance of the type it is used at" = expectAll
  [
    expectEqual
      (routeWordsOver numeric (literalAt "y" "N" 1))
      (routeWordsOver numeric (literalAt "z" "N" 2)),
    expectNotEqual
      (routeWordsOver numeric (literalAt "y" "N" 1))
      (routeWordsOver numeric (literalAt "y" "Int" 1)),
  ]

test "an integer literal at a type with no Num instance is a type mismatch" =
  expectEqual
    ["T-TYPE-MISMATCH"]
    (map fst (checkDiagsOver numeric (literalAt "y" "Bool" 1)))

test "the span keys of goals skip an unlocated goal and keep the located ones in order" =
  let first = Some (Loc "probe.mdk" 3 1 3 5)
  let second = Some (Loc "probe.mdk" 9 1 9 5)
  expectAll [
    expectEqual [] (spanKeys [None, None]),
    expectEqual (spanKeys [first]) (spanKeys [None, first, None]),
    expectNotEqual (spanKeys [first]) (spanKeys [second]),
    expectEqual
      (spanKeys [first] ++ spanKeys [second])
      (spanKeys [first, None, second]),
  ]
