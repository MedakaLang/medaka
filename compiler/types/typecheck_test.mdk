blockRecEvalValue : Float
blockRecEvalValue =
  let source = localNumBlockRecSource ++ "\nmain : Float\nmain = value 1.5\n"
  let core = desugar (parse arithmeticPreludeSource)
  let program = desugar (parseLocated source)
  let elaborated = elaborateOne [] core ("block_rec_eval", program)
  let bindings = evalOne [] ("block_rec_eval", elaborated)
  match lookupAssoc "main" bindings
    Some value => match force value
      VFloat result => result
      _ => 0.0
    _ => 0.0

test "block recursive let executes with its captured Num dictionary" =
  expectEqual 1.5 blockRecEvalValue

test "block recursive arithmetic retains the outer predicate and route" =
  let (errors, trace, assumptions) =
    arithmeticTraceObserved localNumBlockRecSource
  let arithmetic = filter (view => view.ntvStage == NPTArithmetic) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", ["a"], "binding:value", True, [])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvArguments,
          view.ntvOwner,
          view.ntvGiven,
          view.ntvPrerequisites,
        ))
        arithmetic),
    expectEqual
      [
        ("binding:value", "binding:value", 0),
        ("binding:value", "binding:value", 0),
      ]
      assumptions,
  ]

wrappedReturnSource : Bool -> Bool -> String
wrappedReturnSource hasInt hasBox =
  joinNl
    ([
        "data Box a = Box a",
        "interface Seed a where",
        "  seed : a",
      ]
      ++ (if hasInt then ["impl Seed Int where", "  seed = 41"] else [])
      ++ (if hasBox then
        ["impl Seed (Box Int) where", "  seed = Box 99"]
      else
        [])
      ++ [
        "interface Produce a where",
        "  produce : Unit -> Box a",
        "impl Produce a requires Seed a where",
        "  produce _ = Box seed",
        "value : Box Int",
        "value = produce ()",
      ])

returnMethodRoutes : CExpr -> Option (List String)
returnMethodRoutes (CApp fn _) = returnMethodRoutes fn
returnMethodRoutes (CMethod "produce" _ _ prerequisites _) =
  Some (map numericRouteView prerequisites)
returnMethodRoutes _ = None

returnBindRoutes : List CBind -> Option (List String)
returnBindRoutes [] = None
returnBindRoutes ((CBind "value" [CClause _ body]) :: _) =
  returnMethodRoutes body
returnBindRoutes (_ :: rest) = returnBindRoutes rest

wrappedReturnRoutes : String -> Option (List String)
wrappedReturnRoutes source =
  let core = desugar (parse numericPreludeSource)
  let program = desugar (parseLocated source)
  let elaborated = elaborateOne [] core ("wrapped_return", program)
  let (CProgram binds _ _ _) = lowerProgram elaborated
  returnBindRoutes binds

wrappedReturnFlatRoutes : String -> Option (List String)
wrappedReturnFlatRoutes source =
  let program = desugar (parseLocated "\{numericPreludeSource}\n\{source}")
  let elaborated = elaborateOne [] [] ("wrapped_return_flat", program)
  let (CProgram binds _ _ _) = lowerProgram elaborated
  returnBindRoutes binds

test "wrapped return prerequisites use the class parameter, not the result type" =
  expectEqual
    [Some ["Int[]"], Some ["Int[]"], Some ["Int[]"], Some ["Int[]"]]
    [
      wrappedReturnRoutes (wrappedReturnSource True True),
      wrappedReturnRoutes (wrappedReturnSource True False),
      wrappedReturnFlatRoutes (wrappedReturnSource True True),
      wrappedReturnFlatRoutes (wrappedReturnSource True False),
    ]

test "wrapped return checking rejects an instance for only the result wrapper" =
  let source = wrappedReturnSource False True
  let core = desugar (parse numericPreludeSource)
  let program = desugar (parseLocated source)
  let (moduleErrors, _) = checkOneDiags [] core ("wrapped_return", program)
  let (flatErrors, _) = checkOneDiags [] core ("__user__", program)
  expectAll [
    expectEqual
      True
      (contains "No impl of Seed for Int" (map tcMsg moduleErrors)),
    expectEqual True (contains "No impl of Seed for Int" (map tcMsg flatErrors)),
  ]

test "wrapped return routes use the specific instance's empty context" =
  let source = joinNl [
    wrappedReturnSource True True,
    "impl Produce Int where",
    "  produce _ = Box 73",
  ]
  expectEqual
    [Some [], Some []]
    [wrappedReturnRoutes source, wrappedReturnFlatRoutes source]

test "wrapped return routes survive an intervening failed request" =
  let before = wrappedReturnRoutes (wrappedReturnSource True True)
  let core = desugar (parse numericPreludeSource)
  let (errors, _) = checkOneDiags [] core (
    "wrapped_return_failure",
    desugar (parseLocated (wrappedReturnSource False True)),
  )
  let after = wrappedReturnRoutes (wrappedReturnSource True True)
  expectAll [
    expectEqual True (listLen errors > 0),
    expectEqual (Some ["Int[]"]) before,
    expectEqual before after,
  ]

returnIdentitySource : String
returnIdentitySource = joinNl [
  "data Pair a b = Pair a b",
  "interface Choose a b where",
  "  choose : Unit -> Pair b a",
  "impl Choose Int Bool where",
  "  choose _ = Pair True 41",
  "value : Pair Bool Int",
  "value = choose ()",
]

evIdText : EvId -> String
evIdText (EvId moduleId ordinal) = "\{moduleId}:\{ordinal}"

methodTraceGoalText : MethodReturnTraceEntry -> String
methodTraceGoalText entry = match entry.mrtGoal
  Some ev => evIdText ev
  None => "none"

methodTraceArgs : MethodReturnTraceEntry -> Option (List String)
methodTraceArgs entry = map (map ppMono) entry.mrtArguments

methodTracePublishedOne : MethodReturnTraceEntry -> Bool
methodTracePublishedOne entry = match entry.mrtPublished
  Some (EvOne _) => True
  _ => False

data MethodWantedView = MethodWantedView {
  mwvBody : String,
  mwvInterface : String,
  mwvArguments : List String,
  mwvDestinationShared : Bool,
  mwvScopeShared : Bool,
}
  deriving (Eq, Debug)

data MethodOutcomeView =
  | MOVGiven EvidenceBinderId
  | MOVInstance Int (List String) (List (String, List String))
  | MOVDeferred
  | MOVInsoluble
  deriving (Eq, Debug)

methodPrerequisiteView : PrerequisiteEvidence -> (String, List String)
methodPrerequisiteView prerequisite = (
  prerequisite.prerequisiteInterface.irName,
  map ppMono prerequisite.prerequisiteArguments,
)

methodOutcomeView : MethodReturnTraceEntry -> Option MethodOutcomeView
methodOutcomeView entry = match entry.mrtOutcome
  Some (Solved (GivenEvidence binder)) => Some (MOVGiven binder)
  Some (Solved (InstanceEvidence (RequestInstanceId identity) args prerequisites)) =>
    Some
      (MOVInstance
        identity
        (map ppMono args)
        (map methodPrerequisiteView prerequisites))
  Some (Solved (SuperclassEvidence _ _)) => None
  Some (Deferred _ _) => Some MOVDeferred
  Some (Insoluble _ _) => Some MOVInsoluble
  None => None

methodTraceUsesOneOutcome : List MethodReturnTraceEntry -> Bool
methodTraceUsesOneOutcome trace = match map methodOutcomeView trace
  [None, Some checked, Some stamped] => checked == stamped
  _ => False

methodWantedView : MethodReturnTraceEntry -> Option MethodWantedView
methodWantedView entry = match (entry.mrtQualifiedBody, entry.mrtWanted)
  (Some body, Some wanted) => Some MethodWantedView {
    mwvBody = ppMono body,
    mwvInterface = wanted.predicate.predicateInterface.irName,
    mwvArguments = map ppMono wanted.predicate.predicateArguments,
    mwvDestinationShared =
      methodTraceGoalText entry == evIdText wanted.destination,
    mwvScopeShared = wanted.scope == entry.mrtScope,
  }
  _ => None

wantedArgumentStrings : Wanted -> List String
wantedArgumentStrings wanted = map ppMono wanted.predicate.predicateArguments

methodEvInExpr : String -> Expr -> Option EvId
methodEvInExpr target (EMethodAt name _ ev)
  | target == name = Some ev
  | otherwise = None
methodEvInExpr target (ELoc _ expr) = methodEvInExpr target expr
methodEvInExpr target (EApp fn arg) = match methodEvInExpr target fn
  Some ev => Some ev
  None => methodEvInExpr target arg
methodEvInExpr _ _ = None

methodEvInDecls : String -> List Decl -> Option EvId
methodEvInDecls _ [] = None
methodEvInDecls target ((DFunDef _ _ _ body) :: rest) =
  match methodEvInExpr target body
    Some ev => Some ev
    None => methodEvInDecls target rest
methodEvInDecls target (_ :: rest) = methodEvInDecls target rest

test "ordinary return shares declaration identity vector and goal destination" =
  beginMethodReturnTrace ()
  let typed = elaborateOne [] (desugar (parse numericPreludeSource)) (
    "identity_return",
    desugar (parseLocated returnIdentitySource),
  )
  let trace =
    filter (entry => entry.mrtMethod == "choose") (finishMethodReturnTrace ())
  let goals = map methodTraceGoalText trace
  let aggregate = map evIdText (methodEvInDecls "choose" typed)
  let wanted = map methodWantedView trace
  expectAll [
    expectEqual
      [MRTProduced, MRTChecked, MRTStamped]
      (map (entry => entry.mrtStage) trace),
    expectEqual
      ["identity_return", "identity_return", "identity_return"]
      (map
        (entry => match entry.mrtInterface.irOrigin
          OriginModule moduleId => moduleId
          _ => "<unresolved>")
        trace),
    expectEqual
      [Some ["Int", "Bool"], Some ["Int", "Bool"], Some ["Int", "Bool"]]
      (map methodTraceArgs trace),
    expectEqual True (match goals
      first :: second :: third :: [] => first == second && second == third
      _ => False),
    expectEqual True (match (goals, aggregate)
      (goal :: _, Some methodGoal) => goal /= methodGoal
      _ => False),
    expectEqual [True, True, True] (map methodTracePublishedOne trace),
    expectEqual True (methodTraceUsesOneOutcome trace),
    expectEqual True (match map methodOutcomeView trace
      [None, Some (MOVInstance _ ["Int", "Bool"] []), Some _] => True
      _ => False),
    expectEqual
      [
        Some MethodWantedView {
          mwvBody = "Unit -> Pair Bool Int",
          mwvInterface = "Choose",
          mwvArguments = ["Int", "Bool"],
          mwvDestinationShared = True,
          mwvScopeShared = True,
        },
        Some MethodWantedView {
          mwvBody = "Unit -> Pair Bool Int",
          mwvInterface = "Choose",
          mwvArguments = ["Int", "Bool"],
          mwvDestinationShared = True,
          mwvScopeShared = True,
        },
        Some MethodWantedView {
          mwvBody = "Unit -> Pair Bool Int",
          mwvInterface = "Choose",
          mwvArguments = ["Int", "Bool"],
          mwvDestinationShared = True,
          mwvScopeShared = True,
        },
      ]
      wanted,
  ]

methodCarrierStages : String -> String -> List MethodReturnTraceEntry
methodCarrierStages method source =
  beginMethodReturnTrace ()
  let _ = elaborateOne [] (desugar (parse numericPreludeSource)) (
    "method_carrier",
    desugar (parseLocated source),
  )
  filter (entry => entry.mrtMethod == method) (finishMethodReturnTrace ())

test "ordinary return given evidence feeds checking and route publication" =
  let trace =
    methodCarrierStages
      "choose"
      (joinNl [
        "interface GivenChoice a where",
        "  choose : Unit -> a",
        "use : GivenChoice a => Unit -> a",
        "use _ = choose ()",
      ])
  expectAll [
    expectEqual True (methodTraceUsesOneOutcome trace),
    expectEqual True (match map methodOutcomeView trace
      [None, Some (MOVGiven checked), Some (MOVGiven stamped)] =>
        checked == stamped
      _ => False),
    expectEqual True (match trace
      [_, _, stamped] => match stamped.mrtRoute
        Some (RDictFwd _) => listLen stamped.mrtPrerequisites == 0
        _ => False
      _ => False),
  ]

test "return-position standalone shadow bypasses the method-return trace" =
  let trace =
    methodCarrierStages
      "zed"
      (joinNl [
        "interface Zed a where",
        "  zed : a",
        "impl Zed Int where",
        "  zed = 777",
        "zed : Bool",
        "zed = True",
        "value : Bool",
        "value = zed",
      ])
  expectEqual 0 (listLen trace)

test "ordinary return instance evidence retains selected prerequisites" =
  let trace =
    methodCarrierStages
      "make"
      (joinNl [
        "data Box a = Box a",
        "interface Need a where",
        "  need : a -> Int",
        "impl Need Int where",
        "  need n = n",
        "interface Build a where",
        "  make : Unit -> a",
        "impl Build (Box a) requires Need a where",
        "  make _ = Box (need 1)",
        "value : Box Int",
        "value = make ()",
      ])
  expectAll [
    expectEqual True (methodTraceUsesOneOutcome trace),
    expectEqual True (match map methodOutcomeView trace
      [None, Some (MOVInstance _ ["Box Int"] [("Need", ["Int"])]), Some (MOVInstance _ ["Box Int"] [("Need", ["Int"])])] =>
        True
      _ => False),
    expectEqual True (match trace
      [_, _, stamped] => match stamped.mrtRoute
        Some (RKey _ _) => listLen stamped.mrtPrerequisites == 1
        _ => False
      _ => False),
  ]

test "ordinary return validation rejects wrong selected instance" =
  let (_, rejected, _, _) = methodReturnResolutionMutationProbe ()
  expectEqual True rejected

test "ordinary return validation rejects wrong prerequisites" =
  let (_, _, rejected, _) = methodReturnResolutionMutationProbe ()
  expectEqual True rejected

test "ordinary return validation rejects checker evidence disagreement" =
  let (_, _, _, rejected) = methodReturnResolutionMutationProbe ()
  expectEqual True rejected

test "ordinary return template records present and absent interface formals" =
  expectEqual
    ([True, True], [True, False])
    (methodReturnTemplatePresenceProbe ())

test "ordinary return carrier distinguishes empty and absent-formal boundaries" =
  let empty =
    methodCarrierStages
      "token"
      (joinNl [
        "interface Token where",
        "  token : b -> Int",
        "impl Token where",
        "  token _ = 7",
        "value : Int",
        "value = token ()",
      ])
  let absent =
    methodCarrierStages
      "choose"
      (joinNl [
        "data Pair a b = Pair a b",
        "interface Partial a b where",
        "  choose : Unit -> a",
        "impl Partial Int Bool where",
        "  choose _ = 7",
        "value : Int",
        "value = choose ()",
      ])
  expectAll [
    expectEqual
      [Some [], Some [], Some []]
      (map (entry => map (map ppMono) entry.mrtArguments) empty),
    expectEqual
      [Some [], Some [], Some []]
      (map (entry => map wantedArgumentStrings entry.mrtWanted) empty),
    expectEqual
      [MRTProduced, MRTChecked, MRTStamped]
      (map (entry => entry.mrtStage) absent),
    expectEqual [None, None, None] (map methodTraceArgs absent),
  ]

absentReturnSource : Bool -> Bool -> String
absentReturnSource reverseImpls ambient =
  let charImpl = joinNl [
    "impl Hidden Int Char where",
    "  hidden _ = 22",
  ]
  let boolImpl = joinNl [
    "impl Hidden Int Bool where",
    "  hidden _ = 12",
  ]
  let impls =
    if reverseImpls then [boolImpl, charImpl] else [charImpl, boolImpl]
  joinNl
    ([
        "interface Hidden a b where",
        "  hidden : Unit -> a",
      ]
      ++ impls
      ++ (if ambient then
        [
          "useHidden : Hidden a b => b -> a",
          "useHidden witness = hidden ()",
          "value : Int",
          "value = useHidden True : Int",
        ]
      else
        [
          "value : Int",
          "value = hidden ()",
        ]))

test "absent return formal completes from the exact enclosing given" =
  let trace = methodCarrierStages "hidden" (absentReturnSource False True)
  expectAll [
    expectEqual
      [None, Some ["a", "a"], Some ["a", "a"]]
      (map methodTraceArgs trace),
    expectEqual True (methodTraceUsesOneOutcome trace),
    expectEqual True (match map methodOutcomeView trace
      [None, Some (MOVGiven checked), Some (MOVGiven stamped)] =>
        checked == stamped
      _ => False),
    expectEqual True (match trace
      [_, _, stamped] => match stamped.mrtRoute
        Some (RDictFwd _) => True
        _ => False
      _ => False),
  ]

absentReturnCodes : Bool -> List String
absentReturnCodes reverseImpls =
  let (errors, _) = checkOneDiags [] (desugar (parse numericPreludeSource)) (
    "absent_return_ambiguity",
    desugar (parseLocated (absentReturnSource reverseImpls False)),
  )
  map tcCode errors

test "absent return formal never fabricates a fresh instance parameter" = expectAll
  [
    expectEqual
      True
      (contains "T-AMBIGUOUS-INSTANCE" (absentReturnCodes False)),
    expectEqual True (contains "T-AMBIGUOUS-INSTANCE" (absentReturnCodes True)),
  ]

methodBodyThingDecls : Bool -> List String
methodBodyThingDecls twoImpls =
  [
      "data One = One",
      "data Two = Two",
      "interface Thing a where",
      "  make : Unit -> a",
      "  reveal : a -> Unit",
      "impl Thing One where",
      "  make _ = One",
      "  reveal _ = ()",
    ]
    ++ (if twoImpls then
      [
        "impl Thing Two where",
        "  make _ = Two",
        "  reveal _ = ()",
      ]
    else
      [])

methodBodyAmbiguitySource : Bool -> String
methodBodyAmbiguitySource genericDefault =
  joinNl
    (methodBodyThingDecls True
      ++ [
        "interface Host a where",
        "  host : a -> Unit",
      ]
      ++ (if genericDefault then
        [
          "  host _ = reveal (make ())",
          "impl Host Unit where",
        ]
      else
        [
          "impl Host Unit where",
          "  host _ = reveal (make ())",
        ]))

methodBodyCheck : String -> String -> List (String, Bool)
methodBodyCheck name source =
  let (errors, _) = checkOneDiags [] [] (
    name,
    desugar (parseLocated source),
  )
  map (diag => (tcCode diag, methodBodyDiagLocated diag)) errors

methodBodyDiagLocated : TcDiag -> Bool
methodBodyDiagLocated (TcDiag _ _ loc _ _ _) = isSome loc

test "explicit and generic method bodies locate unanchored goals" = expectAll [
  expectEqual
    [("T-AMBIGUOUS-INSTANCE", True)]
    (methodBodyCheck
      "explicit_method_body_ambiguity"
      (methodBodyAmbiguitySource False)),
  expectEqual
    [("T-AMBIGUOUS-INSTANCE", True)]
    (methodBodyCheck
      "generic_default_body_ambiguity"
      (methodBodyAmbiguitySource True)),
]

methodBodySoleImplSource : String
methodBodySoleImplSource =
  joinNl
    (methodBodyThingDecls False
      ++ [
        "interface Host a where",
        "  host : a -> Unit",
        "impl Host Unit where",
        "  host _ = reveal (make ())",
      ])

methodBodyActiveDictSource : String
methodBodyActiveDictSource =
  joinNl
    (methodBodyThingDecls True
      ++ [
        "interface Host a where",
        "  host : Thing b => a -> b -> Unit",
        "impl Host Unit where",
        "  host _ x = reveal x",
      ])

methodBodyImplHeadSource : String
methodBodyImplHeadSource =
  joinNl
    (methodBodyThingDecls True
      ++ [
        "interface Host a where",
        "  host : a -> Unit",
        "impl Host One where",
        "  host x = reveal x",
      ])

methodBodyInnerGeneralizedSource : String
methodBodyInnerGeneralizedSource =
  joinNl
    (methodBodyThingDecls True
      ++ [
        "interface Host a where",
        "  host : a -> Unit",
        "impl Host Unit where",
        "  host _ =",
        "    let inner x = reveal x",
        "    inner One",
      ])

test "method-body ownership preserves every surviving determination channel" = expectAll
  [
    expectEqual
      []
      (methodBodyCheck "method_body_sole_impl" methodBodySoleImplSource),
    expectEqual
      []
      (methodBodyCheck "method_body_active_dict" methodBodyActiveDictSource),
    expectEqual
      []
      (methodBodyCheck "method_body_impl_head" methodBodyImplHeadSource),
    expectEqual
      []
      (methodBodyCheck
        "method_body_inner_generalized"
        methodBodyInnerGeneralizedSource),
  ]

test "method-body levels reset across failure then success" =
  let p1 = methodBodyCheck "method_body_level_p1" methodBodySoleImplSource
  let q =
    methodBodyCheck "method_body_level_q" (methodBodyAmbiguitySource False)
  let p2 = methodBodyCheck "method_body_level_p2" methodBodySoleImplSource
  expectEqual ([], [("T-AMBIGUOUS-INSTANCE", True)], []) (p1, q, p2)

test "absent return completion cannot leak from a sibling scope" =
  let source = joinNl [
    "interface Hidden a b where",
    "  hidden : Unit -> a",
    "useBool : Hidden a Bool => Bool -> a",
    "useBool witness = hidden ()",
    "useChar : Hidden a Char => Char -> a",
    "useChar witness = hidden ()",
  ]
  let checkedArgs =
    map
      methodTraceSecondArg
      (filter
        (entry => entry.mrtStage == MRTChecked)
        (methodCarrierStages "hidden" source))
  expectAll [
    expectEqual 2 (listLen checkedArgs),
    expectEqual
      True
      (checkedArgs == ["Bool", "Char"] || checkedArgs == ["Char", "Bool"]),
  ]

methodTraceSecondArg : MethodReturnTraceEntry -> String
methodTraceSecondArg entry = match methodTraceArgs entry
  Some [_, argument] => argument
  _ => ""

methodTraceOrigin : MethodReturnTraceEntry -> String
methodTraceOrigin entry = match entry.mrtInterface.irOrigin
  OriginModule moduleId => moduleId
  _ => "<unresolved>"

methodOutcomeSemanticView : MethodReturnTraceEntry ->
  (String, List String, List (String, List String))
methodOutcomeSemanticView entry = match methodOutcomeView entry
  None => ("pending", [], [])
  Some (MOVGiven _) => ("given", [], [])
  Some (MOVInstance _ args prerequisites) => ("instance", args, prerequisites)
  Some MOVDeferred => ("deferred", [], [])
  Some MOVInsoluble => ("insoluble", [], [])

methodRouteKind : MethodReturnTraceEntry -> String
methodRouteKind entry = match entry.mrtRoute
  Some (RKey _ _) => "instance"
  Some (RDict _) => "given"
  Some (RDictFwd _) => "given-forwarded"
  Some (RLocal _ _) => "local"
  Some (RScalar _) => "scalar"
  Some RNone => "none"
  None => "pending"

methodTraceIdentityView : MethodReturnTraceEntry ->
  (MethodReturnTraceStage, String, Option (List String), (String, List String, List (String, List String)), String)
methodTraceIdentityView entry = (
  entry.mrtStage,
  methodTraceOrigin entry,
  methodTraceArgs entry,
  methodOutcomeSemanticView entry,
  methodRouteKind entry,
)

importedReturnObserved : Bool ->
  (Int, List (MethodReturnTraceStage, String, Option (List String), (String, List String, List (String, List String)), String))
importedReturnObserved reverseOrder =
  let owner = (
    "return_owner",
    joinNl [
      "export interface OwnerChoice a where",
      "  choose : Unit -> a",
      "impl OwnerChoice Int where",
      "  choose _ = 41",
    ],
  )
  let foreign = (
    "return_foreign",
    joinNl [
      "export interface ForeignChoice a where",
      "  choose : Unit -> a",
      "impl ForeignChoice Bool where",
      "  choose _ = True",
    ],
  )
  let imports =
    if reverseOrder then
      ["import return_foreign.{choose}", "import return_owner as O"]
    else
      ["import return_owner as O", "import return_foreign.{choose}"]
  let entry = (
    "return_importer",
    joinNl (imports ++ ["value : Int", "value = O.choose ()"]),
  )
  let sources =
    if reverseOrder then [foreign, owner, entry] else [owner, foreign, entry]
  beginMethodReturnTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      (desugar (parse numericPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace =
    map
      methodTraceIdentityView
      (filter (item => item.mrtMethod == "choose") (finishMethodReturnTrace ()))
  (modErrorCount results, trace)

test "alias-qualified ordinary returns keep owner identity across import orders" =
  let forward = importedReturnObserved False
  let backward = importedReturnObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [
        (
          MRTProduced,
          "return_owner",
          Some ["Int"],
          ("pending", [], []),
          "pending",
        ),
        (
          MRTChecked,
          "return_owner",
          Some ["Int"],
          ("instance", ["Int"], []),
          "pending",
        ),
        (
          MRTStamped,
          "return_owner",
          Some ["Int"],
          ("instance", ["Int"], []),
          "instance",
        ),
      ]
      (snd forward),
  ]

freshMethodReturnStages : String -> List MethodReturnTraceStage
freshMethodReturnStages moduleId =
  beginMethodReturnTrace ()
  let _ = elaborateOne [] (desugar (parse numericPreludeSource)) (
    moduleId,
    desugar (parseLocated returnIdentitySource),
  )
  map
    (entry => entry.mrtStage)
    (filter (entry => entry.mrtMethod == "choose") (finishMethodReturnTrace ()))

cachedMethodReturnObserved : String -> (Int, List MethodReturnTraceStage)
cachedMethodReturnObserved entrySource =
  let prefix = joinNl [
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice Int where",
    "  cachedChoose _ = 41",
    "export cached : Int",
    "cached = cachedChoose ()",
  ]
  beginMethodReturnTrace ()
  let results =
    checkModulesDiagsChain
      (Some (991, 997))
      "method-return-identity-cache"
      [Some "stable-method-return-prefix-v1", None]
      []
      (desugar (parse numericPreludeSource))
      [
        ("return_cache_prefix", desugar (parseLocated prefix)),
        ("return_cache_entry", desugar (parseLocated entrySource)),
      ]
  let stages =
    map
      (entry => entry.mrtStage)
      (filter
        (entry => entry.mrtMethod == "cachedChoose")
        (finishMethodReturnTrace ()))
  (modErrorCount results, stages)

test "ordinary return traces are fresh while cache hits replay no events" =
  let first = freshMethodReturnStages "return_fresh"
  let (failedErrors, _) = checkOneDiags [] [] (
    "return_failed",
    desugar (parseLocated "value : Int\nvalue = \"wrong\"\n"),
  )
  let afterFailure = freshMethodReturnStages "return_fresh"
  let success = "import return_cache_prefix.{cached}\nentry = cached\n"
  let cold = cachedMethodReturnObserved success
  let hit = cachedMethodReturnObserved success
  let failedHit = cachedMethodReturnObserved "entry : Int\nentry = \"wrong\"\n"
  let afterFailedHit = cachedMethodReturnObserved success
  expectAll [
    expectEqual [MRTProduced, MRTChecked, MRTStamped] first,
    expectEqual first afterFailure,
    expectEqual True (listLen failedErrors > 0),
    expectEqual (0, [MRTProduced, MRTChecked, MRTStamped]) cold,
    expectEqual (0, []) hit,
    expectEqual True (fst failedHit > 0 && snd failedHit == []),
    expectEqual (0, []) afterFailedHit,
  ]

data ReturnMemoRequestView = ReturnMemoRequestView {
  rmrvModules : List (String, List (String, String), List (String, String)),
  rmrvReturns : List MethodReturnMemoView,
}
  deriving (Eq, Debug)

returnMemoModuleView : ModDiags ->
  (String, List (String, String), List (String, String))
returnMemoModuleView (moduleId, (schemes, errors, warnings)) = (
  moduleId,
  map (entry => (fst entry, ppScheme (snd entry))) schemes,
  map (diag => (tcCode diag, tcMsg diag)) (errors ++ warnings),
)

returnMemoRelevant : MethodReturnMemoView -> Bool
returnMemoRelevant view =
  view.mrmvMethod == "cachedChoose" || view.mrmvMethod == "hidden"

returnMemoPrefix : Bool -> String
returnMemoPrefix useBool =
  let head = if useBool then "Bool" else "Int"
  let value = if useBool then "True" else "41"
  joinNl [
    "export interface Need a where",
    "  need : a -> Int",
    "impl Need \{head} where",
    "  need _ = 1",
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice \{head} requires Need \{head} where",
    "  cachedChoose _ = \{value}",
    "export cached : \{head}",
    "cached = cachedChoose ()",
    "export interface Hidden a b where",
    "  hidden : Unit -> a",
    "export useHidden : Hidden a b => b -> a",
    "useHidden witness = hidden ()",
  ]

returnMemoEntry : String
returnMemoEntry =
  "import return_memo_prefix.{cached, useHidden}\nentry = cached\n"

returnMemoConflictPrefix : String
returnMemoConflictPrefix = joinNl [
  returnMemoPrefix False,
  "impl CachedChoice Int requires Need Int where",
  "  cachedChoose _ = 99",
]

returnMemoObserved : String -> String -> String -> ReturnMemoRequestView
returnMemoObserved prefixSource entrySource stepKey =
  let results =
    checkModulesDiagsChain
      (Some (1091, 1093))
      "method-return-request-fence"
      [Some stepKey, None]
      []
      (desugar (parse numericPreludeSource))
      [
        ("return_memo_prefix", desugar (parseLocated prefixSource)),
        ("return_memo_entry", desugar (parseLocated entrySource)),
      ]
  ReturnMemoRequestView {
    rmrvModules = map returnMemoModuleView results,
    rmrvReturns = filter returnMemoRelevant (methodReturnMemoCurrentViews ()),
  }

returnMemoErrorCount : ReturnMemoRequestView -> Int
returnMemoErrorCount view = returnMemoErrorCountRows view.rmrvModules

returnMemoErrorCountRows : List (String, List (String, String), List (String, String)) ->
  Int
returnMemoErrorCountRows [] = 0
returnMemoErrorCountRows ((_, _, diagnostics) :: rest) =
  listLen diagnostics + returnMemoErrorCountRows rest

returnMemoMethod : String ->
  ReturnMemoRequestView ->
  Option MethodReturnMemoView
returnMemoMethod method view =
  match filter (entry => entry.mrmvMethod == method) view.rmrvReturns
    entry :: _ => Some entry
    [] => None

test "ordinary return memo fence preserves outcomes and evidence across requests" =
  let pSource = returnMemoPrefix False
  let changedSource = returnMemoPrefix True
  let cold = returnMemoObserved pSource returnMemoEntry pSource
  let hit = returnMemoObserved pSource returnMemoEntry pSource
  let failed =
    returnMemoObserved pSource "entry : Int\nentry = \"wrong\"\n" pSource
  let afterFailed = returnMemoObserved pSource returnMemoEntry pSource
  let conflict =
    returnMemoObserved
      returnMemoConflictPrefix
      returnMemoEntry
      returnMemoConflictPrefix
  let afterConflict = returnMemoObserved pSource returnMemoEntry pSource
  let changed = returnMemoObserved changedSource returnMemoEntry changedSource
  let backToP = returnMemoObserved pSource returnMemoEntry pSource
  let mutations = methodReturnMemoFenceMutationProbe ()
  let retained = methodReturnMemoRetentionStats ()
  let teardown = methodReturnMemoTeardownStats ()
  let forcedStale = returnMemoObserved changedSource returnMemoEntry pSource
  let coldInstance = returnMemoMethod "cachedChoose" cold
  let changedInstance = returnMemoMethod "cachedChoose" changed
  let coldGiven = returnMemoMethod "hidden" cold
  expectAll [
    expectEqual 0 (returnMemoErrorCount cold),
    expectEqual cold hit,
    expectEqual cold afterFailed,
    expectEqual cold afterConflict,
    expectEqual cold backToP,
    expectEqual True (returnMemoErrorCount failed > 0),
    expectEqual True (returnMemoErrorCount conflict > 0),
    expectEqual True (changed /= cold && returnMemoErrorCount changed == 0),
    expectEqual True (forcedStale /= changed),
    expectEqual True (match (coldInstance, changedInstance)
      (Some before, Some after) =>
        before.mrmvOutcome == "instance"
          && after.mrmvOutcome == "instance"
          && before.mrmvPrerequisites == [("return_memo_prefix::Need", ["Int"])]
          && after.mrmvPrerequisites == [("return_memo_prefix::Need", ["Bool"])]
          && before.mrmvEvidence /= "unpublished"
          && after.mrmvEvidence /= "unpublished"
          && before.mrmvEvidence /= after.mrmvEvidence
      _ => False),
    expectEqual True (match coldGiven
      Some given =>
        given.mrmvArguments == Some ["a", "a"]
          && given.mrmvOutcome == "given"
          && given.mrmvPrerequisites == []
          && given.mrmvEvidence /= "unpublished"
      None => False),
    expectEqual (True, True, True) mutations,
    expectEqual (0, 2, 1) retained,
    expectEqual (0, 0, 0) teardown,
  ]

data LocalCoreFacts = LocalCoreFacts Bool (List String) (List String) Int

methodHeadArity : String -> CExpr -> Option Int
methodHeadArity target (CMethod name arity _ _ _)
  | name == target = Some arity
  | otherwise = None
methodHeadArity target (CApp f _) = methodHeadArity target f
methodHeadArity _ _ = None

bindMethodArity : String -> String -> List CBind -> Option Int
bindMethodArity _ _ [] = None
bindMethodArity bindName method ((CBind name clauses) :: rest)
  | name == bindName = match clauses
    (CClause _ body) :: _ => methodHeadArity method body
    [] => None
  | otherwise = bindMethodArity bindName method rest

loweredMethodArity : String -> String -> String -> Option Int
loweredMethodArity source bindName method =
  let core = desugar (parse numericPreludeSource)
  let program = desugar (parseLocated source)
  let elaborated = elaborateOne [] core ("method_arity", program)
  let (CProgram binds _ _ _) = lowerProgram elaborated
  bindMethodArity bindName method binds

test "method occurrence freezes declared arity before higher-order specialization" =
  expectEqual
    (Some 1)
    (loweredMethodArity
      (joinNl [
        "interface ArityHo a where",
        "  ho : a -> a",
        "impl ArityHo (Int -> Int) where",
        "  ho f = f",
        "probe = ho (x => x)",
      ])
      "probe"
      "ho")

test "method occurrence arity stays distinct from tagged impl callable arity" =
  expectEqual
    (Some 2)
    (loweredMethodArity
      (joinNl [
        "data ArityDog = ArityDog",
        "interface ArityAct a where",
        "  arityAct : a -> Unit -> Unit",
        "impl ArityAct ArityDog where",
        "  arityAct _ = _ => ()",
        "observeArity : ArityAct a => a -> Unit -> Unit",
        "observeArity x = arityAct x",
      ])
      "observeArity"
      "arityAct")

test "qualified method constraints preserve a selected empty row" =
  let program =
    desugar
      (parseLocated
        (joinNl [
          "interface Plain a where",
          "  collide : a -> Int",
          "interface Rich a where",
          "  collide : Num b => a -> b -> Int",
        ]))
  let rows = methodConstraintIfaces program
  expectAll [
    expectEqual
      (Some [])
      (lookupAssoc (ifaceMethodArityKey "Plain" "collide") rows),
    expectEqual
      (Some ["Num"])
      (lookupAssoc (ifaceMethodArityKey "Rich" "collide") rows),
    expectEqual (Some ["Num"]) (lookupAssoc "collide" rows),
  ]

test "definer-shadow application publishes its selected arity" =
  expectEqual
    (Some 1)
    (loweredMethodArity
      (joinNl [
        "interface ArityShadow a where",
        "  shadow : a -> Int",
        "shadow : Int -> Int",
        "shadow x = x",
        "probe = shadow 1",
      ])
      "probe"
      "shadow")

test "value-position shadow publishes the selected standalone arity" =
  expectEqual
    (Some 2)
    (loweredMethodArity
      (joinNl [
        "interface ArityValueShadow a where",
        "  shadowValue : a -> Int",
        "shadowValue : Int -> Int -> Int",
        "shadowValue x _ = x",
        "probe = shadowValue",
      ])
      "probe"
      "shadowValue")

test "Core IR round-trip preserves method occurrence arity" =
  let original =
    CProgram
      [CBind "main" [CClause [] (CMethod "probe" 7 RNone [] [])]]
      []
      []
      []
  match parseCProgram (cprogramToSexp original)
    CProgram [CBind "main" [CClause [] (CMethod "probe" arity RNone [] [])]] _ _ _ =>
      expectEqual 7 arity
    _ => expectEqual True False

emptyLocalCoreFacts : LocalCoreFacts
emptyLocalCoreFacts = LocalCoreFacts False [] [] 0

mergeLocalCoreFacts : LocalCoreFacts -> LocalCoreFacts -> LocalCoreFacts
mergeLocalCoreFacts (LocalCoreFacts shapeA addA fromIntA primA) (LocalCoreFacts shapeB addB fromIntB primB) =
  LocalCoreFacts
    (shapeA || shapeB)
    (addA ++ addB)
    (fromIntA ++ fromIntB)
    (primA + primB)

localCoreExprFacts : CExpr -> LocalCoreFacts
localCoreExprFacts (CApp f x) =
  mergeLocalCoreFacts (localCoreExprFacts f) (localCoreExprFacts x)
localCoreExprFacts (CLam _ body) = localCoreExprFacts body
localCoreExprFacts (CLet _ _ rhs body) =
  mergeLocalCoreFacts (localCoreExprFacts rhs) (localCoreExprFacts body)
localCoreExprFacts (CBinPrim op lhs rhs _) =
  let nested =
    mergeLocalCoreFacts (localCoreExprFacts lhs) (localCoreExprFacts rhs)
  let (LocalCoreFacts shape addRoutes fromIntRoutes primCount) = nested
  LocalCoreFacts
    shape
    addRoutes
    fromIntRoutes
    (primCount + (if op == "+" then 1 else 0))
localCoreExprFacts (CMethod "add" _ (RDict binder) _ _) =
  LocalCoreFacts False [binder] [] 0
localCoreExprFacts (CMethod "fromInt" _ route _ _) = match route
  RDict binder => LocalCoreFacts False [] [binder] 0
  RDictFwd binder => LocalCoreFacts False [] [binder] 0
  _ => emptyLocalCoreFacts
localCoreExprFacts _ = emptyLocalCoreFacts

blockRecValueFacts : CBind -> LocalCoreFacts
blockRecValueFacts (CBind "value" [CClause _ (CBlock [CSLet False _ (CLam _ localBody), CSExpr (CApp _ _)])]) =
  let (LocalCoreFacts _ addRoutes fromIntRoutes primCount) =
    localCoreExprFacts localBody
  LocalCoreFacts True addRoutes fromIntRoutes primCount
blockRecValueFacts _ = emptyLocalCoreFacts

blockRecCoreFacts : LocalCoreFacts
blockRecCoreFacts =
  let source = localNumBlockRecSource ++ "\nmain : Float\nmain = value 1.5\n"
  let core = desugar (parse arithmeticPreludeSource)
  let program = desugar (parseLocated source)
  let elaborated = elaborateOne [] core ("block_rec_core", program)
  let (CProgram binds _ _ _) = lowerProgram elaborated
  fold
    (facts bind => mergeLocalCoreFacts facts (blockRecValueFacts bind))
    emptyLocalCoreFacts
    binds

test "block recursive Core keeps dictionary methods inside the captured closure" =
  let (LocalCoreFacts shape addRoutes fromIntRoutes primCount) =
    blockRecCoreFacts
  expectAll [
    expectEqual True shape,
    expectEqual 1 (listLen addRoutes),
    expectEqual addRoutes fromIntRoutes,
    expectEqual False (contains "" addRoutes),
    expectEqual 0 primCount,
  ]

lamThenGroupSource : String
lamThenGroupSource = joinNl [
  "lamThenGroup : Num a => a -> a",
  "lamThenGroup x = let f = _ => let rec g z = x + z in g x in f ()",
]

lamThenGroupBindFacts : CBind -> LocalCoreFacts
lamThenGroupBindFacts (CBind "lamThenGroup" [CClause _ (CLet _ _ (CLam _ (CLetGroup [CBind "g" [CClause _ gBody]] (CApp _ _))) (CApp _ _))]) =
  let (LocalCoreFacts _ addRoutes fromIntRoutes primCount) =
    localCoreExprFacts gBody
  LocalCoreFacts True addRoutes fromIntRoutes primCount
lamThenGroupBindFacts _ = emptyLocalCoreFacts

lamThenGroupCoreFacts : LocalCoreFacts
lamThenGroupCoreFacts =
  let core = desugar (parse arithmeticPreludeSource)
  let program = desugar (parseLocated lamThenGroupSource)
  let elaborated = elaborateOne [] core ("lam_then_group_core", program)
  let (CProgram binds _ _ _) = lowerProgram elaborated
  fold
    (facts bind => mergeLocalCoreFacts facts (lamThenGroupBindFacts bind))
    emptyLocalCoreFacts
    binds

test "nested lambda-group Core keeps dictionary dispatch in the group member" =
  let (LocalCoreFacts shape addRoutes fromIntRoutes primCount) =
    lamThenGroupCoreFacts
  expectAll [
    expectEqual True shape,
    expectEqual 1 (listLen addRoutes),
    expectEqual False (contains "" addRoutes),
    expectEqual [] fromIntRoutes,
    expectEqual 0 primCount,
  ]

localNumOwnSource : String
localNumOwnSource = joinNl [
  "blockRec _ =",
  "  let local _ = 1",
  "  local ()",
  "blockLet _ =",
  "  let local = 1",
  "  local",
  "inferRec _ = let local _ = 1 in local ()",
  "inferLet _ = let local = 1 in local",
  "group _ = local ()",
  "  where",
  "    local _ = 1",
]

test "each local boundary defaults its own numeric root to Int" =
  let (_, schemes) = checkOneSchemeFullK None [] (desugar
    (parse numericPreludeSource)) (
    "local_numeric_own",
    desugar (parseLocated localNumOwnSource),
  )
  let observed = map (entry => (fst entry, ppScheme (snd entry))) schemes
  expectEqual
    [
      ("blockRec", "a -> Int"),
      ("blockLet", "a -> Int"),
      ("inferRec", "a -> Int"),
      ("inferLet", "a -> Int"),
      ("group", "a -> Int"),
    ]
    observed

localNumMismatchCodes : String -> List String
localNumMismatchCodes body =
  declaredNumErrorCodes
    (joinNl [
      "value : Num a => a -> (a, Bool)",
      body,
    ])

test "local numeric ownership does not admit explicit result mismatches" =
  expectEqual
    [
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
      ["T-TYPE-MISMATCH"],
    ]
    [
      localNumMismatchCodes "value x =\n  let local _ = x + 0\n  (local (), 1)",
      localNumMismatchCodes "value x =\n  let local = x + 0\n  (local, 1)",
      localNumMismatchCodes "value x = let local _ = x + 0 in (local (), 1)",
      localNumMismatchCodes "value x = let local = x + 0 in (local, 1)",
      localNumMismatchCodes
        "value x = (local (), 1)\n  where\n    local _ = x + 0",
    ]

data TraceView = TraceView {
  tvKind : AssumptionTraceKind,
  tvGoalModule : String,
  tvGoalOwner : String,
  tvBinderModule : String,
  tvBinderOwner : String,
  tvSameScope : Bool,
  tvBinder : EvidenceBinderId,
}
  deriving (Eq, Debug)

data RequestView = RequestView {
  rvTrace : List TraceView,
  rvErrors : Int,
  rvFrameCount : Int,
  rvFrameCapacity : Int,
}
  deriving (Eq, Debug)

data DefaultTraceView = DefaultTraceView {
  dtvIfaceModule : String,
  dtvIfaceName : String,
  dtvMethod : String,
  dtvCallee : String,
  dtvKind : DefaultBodyRNoneKind,
  dtvScopeModule : String,
  dtvScopeOwner : String,
  dtvStartLine : Int,
}
  deriving (Eq, Debug)

data ModuleTraceView = ModuleTraceView {
  mtvDefaults : List DefaultTraceView,
  mtvAssumptions : List TraceView,
  mtvErrors : Int,
}

data ContextView = ContextView {
  cvKind : AssumptionTraceKind,
  cvGoalModule : String,
  cvGoalOwner : String,
  cvBinderModule : String,
  cvBinderOwner : String,
  cvSameScope : Bool,
}
  deriving (Eq, Debug)

traceView : AssumptionTraceEntry -> TraceView
traceView entry =
  let (EvidenceBinderId binderScope _) = entry.atBinder
  let (goalModule, goalOwner) = scopeTraceContext entry.atGoalScope
  let (binderModule, binderOwner) = scopeTraceContext binderScope
  TraceView {
    tvKind = entry.atKind,
    tvGoalModule = goalModule,
    tvGoalOwner = goalOwner,
    tvBinderModule = binderModule,
    tvBinderOwner = binderOwner,
    tvSameScope = entry.atGoalScope == binderScope,
    tvBinder = entry.atBinder,
  }

-- This recursion forces every context projection before the next request can
-- reset the graph that owns the request-local ScopeIds.
traceViewsNow : List AssumptionTraceEntry -> List TraceView
traceViewsNow entries = map traceView entries

defaultTraceView : DefaultBodyRNoneTraceEntry -> DefaultTraceView
defaultTraceView entry =
  let owner = entry.dbrOwner
  let ifaceModule = match owner.dbiIface.irOrigin
    OriginModule m => m
    OriginBuiltin => "<builtin>"
    OriginUnresolved => "<unresolved>"
  let (scopeModule, scopeOwner) = scopeTraceContext entry.dbrScope
  let startLine = match entry.dbrOrigin
    Some (Loc _ line _ _ _) => line
    None => 0
  DefaultTraceView {
    dtvIfaceModule = ifaceModule,
    dtvIfaceName = owner.dbiIface.irName,
    dtvMethod = owner.dbiMethod,
    dtvCallee = entry.dbrCallee,
    dtvKind = entry.dbrKind,
    dtvScopeModule = scopeModule,
    dtvScopeOwner = scopeOwner,
    dtvStartLine = startLine,
  }

runModulesObserved : List (String, String) -> ModuleTraceView
runModulesObserved sources =
  beginAssumptionTrace ()
  beginDefaultBodyRNoneTrace ()
  let results =
    checkModulesDiagsChain
      None
      ""
      []
      []
      []
      (map (entry => (fst entry, desugar (parseLocated (snd entry)))) sources)
  let defaultEntries = finishDefaultBodyRNoneTrace ()
  let assumptionEntries = finishAssumptionTrace ()
  ModuleTraceView {
    mtvDefaults = map defaultTraceView defaultEntries,
    mtvAssumptions = traceViewsNow assumptionEntries,
    mtvErrors = modErrorCount results,
  }

runObserved : String -> String -> RequestView
runObserved moduleId source =
  beginAssumptionTrace ()
  let (errors, _) = checkOneDiags [] [] (moduleId, desugar (parse source))
  let entries = finishAssumptionTrace ()
  let views = traceViewsNow entries
  let (count, capacity) = scopeFrameStats ()
  RequestView {
    rvTrace = views,
    rvErrors = listLen errors,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

modErrorCount : List ModDiags -> Int
modErrorCount [] = 0
modErrorCount ((_, (_, errors, _)) :: rest) =
  listLen errors + modErrorCount rest

runCachedObserved : String -> RequestView
runCachedObserved entrySource =
  beginAssumptionTrace ()
  let results =
    checkModulesDiagsChain
      (Some (731, 733))
      "typecheck-scope-cache"
      [Some "stable-prefix-v1", None]
      []
      []
      [
        ("cache_prefix", desugar (parse scalarSource)),
        ("cache_entry", desugar (parse entrySource)),
      ]
  let entries = finishAssumptionTrace ()
  let views = traceViewsNow entries
  let (count, capacity) = scopeFrameStats ()
  RequestView {
    rvTrace = views,
    rvErrors = modErrorCount results,
    rvFrameCount = count,
    rvFrameCapacity = capacity,
  }

withoutBinderIds : List TraceView -> List ContextView
withoutBinderIds views =
  map
    (view => ContextView {
      cvKind = view.tvKind,
      cvGoalModule = view.tvGoalModule,
      cvGoalOwner = view.tvGoalOwner,
      cvBinderModule = view.tvBinderModule,
      cvBinderOwner = view.tvBinderOwner,
      cvSameScope = view.tvSameScope,
    })
    views

context : AssumptionTraceKind -> String -> String -> ContextView
context kind moduleId owner = ContextView {
  cvKind = kind,
  cvGoalModule = moduleId,
  cvGoalOwner = owner,
  cvBinderModule = moduleId,
  cvBinderOwner = owner,
  cvSameScope = True,
}

directSource : String
directSource = joinNl [
  "data Wrap a = Wrap a",
  "data Box a = Box a",
  "data Other a = Other a",
  "interface D t where",
  "  d : t -> Int",
  "interface C t where",
  "  foo : t -> Int",
  "impl D (Wrap a) where",
  "  d _ = 99",
  "impl C (Box a) requires D (Wrap a) where",
  "  foo (Box x) = d (Wrap x)",
  "impl C (Other a) requires D (Wrap a) where",
  "  foo (Other x) = d (Wrap x)",
]

scalarSource : String
scalarSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "f : D a => a -> Int",
  "f x = d x",
]

superSource : String
superSource = joinNl [
  "data Wrap a = Wrap a",
  "interface Base t where",
  "  base : t -> Int",
  "interface Sub t requires Base t where",
  "  sub : t -> Int",
  "f : Sub (Wrap a) => Wrap a -> Int",
  "f x = base x",
]

failedSource : String
failedSource = "bad : Int\nbad = True\n"

conflictingSource : String
conflictingSource = joinNl [
  "interface D a where",
  "  d : a -> Int",
  "impl D Int where",
  "  d _ = 1",
  "impl D Int where",
  "  d _ = 2",
]

test "direct predicate evidence keeps same-rendering binders nominal" =
  let observed = runObserved "trace_direct" directSource
  let contexts = withoutBinderIds observed.rvTrace
  let binders = map (entry => entry.tvBinder) observed.rvTrace
  expectEqual
    (
      [
        context ATDirectPredicate "trace_direct" "binding:foo",
        context ATDirectPredicate "trace_direct" "binding:foo",
      ],
      True,
      0,
    )
    (
      contexts,
      match binders
        first :: second :: [] => first /= second
        _ => False,
      observed.rvErrors,
    )

test "scalar and superclass assumption paths remain explicit legacy kinds" =
  let scalar = runObserved "trace_scalar" scalarSource
  let super = runObserved "trace_super" superSource
  expectEqual
    (
      [context ATLegacyScalar "trace_scalar" "binding:f"],
      [context ATLegacySuperclass "trace_super" "binding:f"],
      0,
      0,
    )
    (
      withoutBinderIds scalar.rvTrace,
      withoutBinderIds super.rvTrace,
      scalar.rvErrors,
      super.rvErrors,
    )

requestProjection : RequestView -> (List ContextView, Int)
requestProjection view = (withoutBinderIds view.rvTrace, view.rvFrameCount)

sameProjection : RequestView -> RequestView -> Bool
sameProjection left right = requestProjection left == requestProjection right

test "fresh repeat and failed/conflicting intervening requests retain ownership" =
  let first = runObserved "trace_repeat" scalarSource
  let repeated = runObserved "trace_repeat" scalarSource
  let failed = runObserved "trace_failed" failedSource
  let afterFailed = runObserved "trace_repeat" scalarSource
  let conflicting = runObserved "trace_conflict" conflictingSource
  let afterConflict = runObserved "trace_repeat" scalarSource
  expectEqual
    [True, True, True, True, True, True]
    [
      sameProjection first repeated,
      sameProjection first afterFailed,
      sameProjection first afterConflict,
      failed.rvErrors > 0,
      conflicting.rvErrors > 0,
      first.rvFrameCount <= first.rvFrameCapacity
        && repeated.rvFrameCount <= repeated.rvFrameCapacity
        && afterFailed.rvFrameCount <= afterFailed.rvFrameCapacity
        && afterConflict.rvFrameCount <= afterConflict.rvFrameCapacity,
    ]

test "module-chain cache hits restore bounded scopes across failing suffixes" =
  let cold = runCachedObserved "entry = 0\n"
  let hit = runCachedObserved "entry = 0\n"
  let failed = runCachedObserved failedSource
  let afterFailed = runCachedObserved "entry = 0\n"
  let conflicting = runCachedObserved conflictingSource
  let afterConflict = runCachedObserved "entry = 0\n"
  expectEqual
    [True, True, True, True, True, True, True]
    [
      withoutBinderIds cold.rvTrace
        == [context ATLegacyScalar "cache_prefix" "binding:f"],
      hit.rvTrace == [],
      afterFailed.rvTrace == [],
      afterConflict.rvTrace == [],
      cold.rvFrameCount == hit.rvFrameCount
        && cold.rvFrameCount == afterFailed.rvFrameCount
        && cold.rvFrameCount == afterConflict.rvFrameCount,
      failed.rvErrors > 0 && conflicting.rvErrors > 0,
      cold.rvFrameCount <= cold.rvFrameCapacity
        && hit.rvFrameCount <= hit.rvFrameCapacity
        && afterFailed.rvFrameCount <= afterFailed.rvFrameCapacity
        && afterConflict.rvFrameCount <= afterConflict.rvFrameCapacity,
    ]

mixedAttrFirstSource : String
mixedAttrFirstSource = joinNl [
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "interface Num a b where",
  "  fromInt : String -> a",
  "main = 1",
]

mixedDirectFirstSource : String
mixedDirectFirstSource = joinNl [
  "interface Num a b where",
  "  fromInt : String -> a",
  "@inline",
  "interface Num a where",
  "  fromInt : Int -> a",
  "main = 1",
]

flatMessages : String -> List String
flatMessages source =
  let (errors, _) = checkOneDiags [] [] ("__user__", desugar (parse source))
  map tcMsg errors

test "attributed-direct Num declarations reject mismatches without cross-pairing rows" =
  expectEqual
    (
      ["Type mismatch: String vs Int"],
      ["Type mismatch: String vs Int"],
    )
    (flatMessages mixedAttrFirstSource, flatMessages mixedDirectFirstSource)

test "unresolved interface givens resolve as a direct predicate" =
  let source = joinNl [
    "data Wrap a = Wrap a",
    "interface D t where",
    "  d : t -> Int",
    "g : D (Wrap a) => a -> Int",
    "g _ = 5",
    "h : D (Wrap a) => a -> Int",
    "h x = g x",
  ]
  let resolved = runObserved "resolved_given" source
  expectEqual
    ([context ATDirectPredicate "resolved_given" "binding:h"], 0)
    (withoutBinderIds resolved.rvTrace, resolved.rvErrors)

test "id-witnessed impl givens remain legacy" =
  let source = joinNl [
    "interface D t where",
    "  d : t -> Int",
    "data Box a = Box a",
    "interface C t where",
    "  foo : t -> Int",
    "impl C (Box a) requires D a where",
    "  foo (Box x) = d x",
  ]
  let observed = runObserved "id_assisted" source
  expectEqual
    ([context ATLegacyPredicate "id_assisted" "binding:foo"], 0)
    (withoutBinderIds observed.rvTrace, observed.rvErrors)

binderOrdinal : EvidenceBinderId -> Int
binderOrdinal (EvidenceBinderId _ ordinal) = ordinal

assumptionShape : TraceView -> (AssumptionTraceKind, Int, String, String, Bool)
assumptionShape view = (
  view.tvKind,
  binderOrdinal view.tvBinder,
  view.tvGoalOwner,
  view.tvBinderOwner,
  view.tvSameScope,
)

supplySource : String
supplySource = joinNl [
  "export default interface Supply a where",
  "  seed : a",
  "  copy : a",
  "  copy = seed",
]

mixedDefaultSource : String
mixedDefaultSource = joinNl [
  "interface Base a where",
  "  base : a -> Int",
  "interface Other a where",
  "  other : a -> Int",
  "default interface Rich a requires Base a where",
  "  peer : a -> Int",
  "  mixed : Rich b => Other c => a -> b -> c -> Int",
  "  mixed x y z =",
  "    let local _ = peer x",
  "    let _ = local ()",
  "    let _ = peer y",
  "    let _ = other z",
  "    base y",
]

test "genuine inherited Supply return keeps full default owner and parser origin" =
  let observed = runModulesObserved [("supply_iface", supplySource)]
  expectEqual
    (
      [
        DefaultTraceView {
          dtvIfaceModule = "supply_iface",
          dtvIfaceName = "Supply",
          dtvMethod = "copy",
          dtvCallee = "seed",
          dtvKind = DBRKReturn,
          dtvScopeModule = "supply_iface",
          dtvScopeOwner = "default:copy",
          dtvStartLine = 4,
        },
      ],
      0,
    )
    (observed.mtvDefaults, observed.mtvErrors)

test "mixed default separates argument fallback from qualified givens" =
  let observed = runModulesObserved [("mixed_default", mixedDefaultSource)]
  expectEqual
    (
      [
        DefaultTraceView {
          dtvIfaceModule = "mixed_default",
          dtvIfaceName = "Rich",
          dtvMethod = "mixed",
          dtvCallee = "peer",
          dtvKind = DBRKArg,
          dtvScopeModule = "mixed_default",
          dtvScopeOwner = "default:mixed",
          dtvStartLine = 9,
        },
      ],
      [
        (ATLegacySuperclass, 0, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 1, "default:mixed", "default:mixed", True),
        (ATDirectPredicate, 0, "default:mixed", "default:mixed", True),
      ],
      0,
    )
    (
      observed.mtvDefaults,
      map assumptionShape observed.mtvAssumptions,
      observed.mtvErrors,
    )

test "same spelling retains module identity while impl bodies stay ordinary" =
  let colliding = runModulesObserved [
    ("owner_a", supplySource),
    ("owner_b", supplySource),
  ]
  let synthesized = runModulesObserved [
    (
      "owner_same",
      supplySource ++ "\nimpl Supply Int where\n  seed = 41\n",
    ),
  ]
  let explicit = runModulesObserved [
    (
      "ordinary_impl",
      joinNl [
        "interface Echo a where",
        "  echo : a -> a",
        "impl Echo Int where",
        "  echo x = echo x",
      ],
    ),
  ]
  let concrete = runModulesObserved [
    (
      "concrete_default",
      joinNl [
        "data Token = Token",
        "default interface Concrete a where",
        "  echo : a -> a",
        "  echo x = x",
        "  use : a -> Token",
        "  use _ = echo Token",
        "impl Concrete Token where",
      ],
    ),
  ]
  expectEqual
    (
      ["owner_a", "owner_b"],
      (1, [], []),
      [0, 0, 0, 0],
    )
    (
      map (entry => entry.dtvIfaceModule) colliding.mtvDefaults,
      (
        listLen synthesized.mtvDefaults,
        explicit.mtvDefaults,
        concrete.mtvDefaults,
      ),
      [
        colliding.mtvErrors,
        synthesized.mtvErrors,
        explicit.mtvErrors,
        concrete.mtvErrors,
      ],
    )

test "synthesized impl copy retains ordinary binding ownership" =
  let observed = runModulesObserved [
    (
      "specialized_default",
      joinNl [
        "interface Other a where",
        "  other : a -> Int",
        "impl Other Int where",
        "  other x = x",
        "default interface Supply a where",
        "  seed : a",
        "  use : Other b => a -> b -> Int",
        "  use x y = other y",
        "impl Supply Bool where",
        "  seed = False",
      ],
    ),
  ]
  expectEqual
    (
      [
        (ATDirectPredicate, 0, "default:use", "default:use", True),
        (ATDirectPredicate, 0, "binding:use", "binding:use", True),
      ],
      0,
    )
    (map assumptionShape observed.mtvAssumptions, observed.mtvErrors)
