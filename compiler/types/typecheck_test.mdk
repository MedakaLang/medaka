data NumericTraceView = NumericTraceView {
  ntvStage : NumericPredicateTraceStage,
  ntvInterface : String,
  ntvArguments : List String,
  ntvOwner : String,
  ntvOrigin : (Int, Int, Int, Int),
  ntvSelected : String,
  ntvSelectedIdentity : String,
  ntvRoute : String,
  ntvGiven : Bool,
  ntvForwarded : Bool,
  ntvPrerequisites : List String,
} deriving (Eq, Debug)

numericRouteView : Route -> String
numericRouteView RNone = "none"
numericRouteView (RKey key prerequisites _) =
  "\{key}[\{joinNl (map numericRouteView prerequisites)}]"
numericRouteView (RDict name) = "dict:" ++ name
numericRouteView (RDictFwd name) = "given:" ++ name
numericRouteView (RLocal name _) = "local:" ++ name
numericRouteView (RScalar name) = "scalar:" ++ name
numericRouteView (RProj route path) =
  "projected:\{numericRouteView route}.\{joinWith "." (map intToString path)}"

numericTraceView : GraphCtx -> NumericPredicateTraceEntry -> NumericTraceView
numericTraceView gctx entry =
  let predicate = entry.nptPredicate
  let iface = predicate.predicateInterface
  let origin = match iface.irOrigin
    OriginModule name => name
    _ => "<non-module>"
  let selected = match entry.nptSelectedInterface
    Some identity => identity.irName
    None => ""
  let selectedIdentity = match entry.nptSelectedInterface
    Some identity => match identity.irOrigin
      OriginModule name => "\{name}::\{identity.irName}"
      _ => "<non-module>::\{identity.irName}"
    None => ""
  let originSpan = match entry.nptOrigin
    Some (Loc _ startLine startCol endLine endCol) =>
      (startLine, startCol, endLine, endCol)
    None => (0, 0, 0, 0)
  let route = match entry.nptRoute
    Some answer => numericRouteView answer
    None => ""
  NumericTraceView {
    ntvStage = entry.nptStage,
    ntvInterface = "\{origin}::\{iface.irName}",
    ntvArguments = map ppMono predicate.predicateArguments,
    ntvOwner = snd (scopeTraceContext gctx entry.nptScope),
    ntvOrigin = originSpan,
    ntvSelected = selected,
    ntvSelectedIdentity = selectedIdentity,
    ntvRoute = route,
    ntvGiven = match entry.nptRoute
      Some (RDict _) => True
      Some (RDictFwd _) => True
      _ => False,
    ntvForwarded = match entry.nptRoute
      Some (RDictFwd _) => True
      _ => False,
    ntvPrerequisites = map numericRouteView entry.nptPrerequisites,
  }

numericValueSource : Bool -> String
numericValueSource collision = numericBodySource collision "N n"

numericBodySource : Bool -> String -> String
numericBodySource collision body =
  joinNl
    (["data N = N Int"]
      ++ (if collision then
        [
          "interface Forge a where",
          "  fromInt : Int -> a",
          "impl Forge N where",
          "  fromInt n = N n",
        ]
      else
        [])
      ++ [
        "impl Num N where",
        "  fromInt n = " ++ body,
        "value : N",
        "value = 1",
      ])

numericCheckObserved : String -> (List String, List NumericTraceView)
numericCheckObserved source =
  let sink = beginNumericPredicateTrace ()
  let ((errors, _), gctx) =
    checkOneDiagsGraph
      (driveArgs (traced sink) False None [] (desugar
        (parse numericPreludeSource)) [
        ("numeric_predicate", desugar (parseLocated source)),
      ])
  let trace = map (numericTraceView gctx) (finishNumericPredicateTrace sink)
  (map tcMsg errors, trace)

numericStages : List NumericTraceView -> List NumericPredicateTraceStage
numericStages views = map (view => view.ntvStage) views

test "a fromInt collision cannot hide an invalid Num constructor argument" =
  let collision = numericCheckObserved (numericBodySource True "N \"wrong\"")
  let control = numericCheckObserved (numericBodySource False "N \"wrong\"")
  expectEqual
    (["type mismatch: Int vs String"], ["type mismatch: Int vs String"])
    (fst collision, fst control)

test "a fromInt collision cannot hide an invalid Num method result" =
  let collision = numericCheckObserved (numericBodySource True "\"wrong\"")
  let control = numericCheckObserved (numericBodySource False "\"wrong\"")
  expectEqual
    (["type mismatch: N vs String"], ["type mismatch: N vs String"])
    (fst collision, fst control)

numericNestedBodySource : String
numericNestedBodySource = joinNl [
  "data Box a = Box a",
  "interface Forge a where",
  "  fromInt : Int -> a",
  "impl Num (Box a) requires Num a where",
  "  fromInt _ = Box 1",
  "value : Box Int",
  "value = 1",
]

-- An attribute above a signature leaves the signature binding the definition:
-- each attributed program reports exactly what the bare one does.
attributedSigErrors : String -> String -> List String
attributedSigErrors attrs sigAndDef =
  let (errors, _) = checkOneDiags defaultDriveInputs [] (desugar
    (parse numericPreludeSource)) (
    "attributed_sig",
    desugar (parseLocated (attrs ++ sigAndDef)),
  )
  map tcMsg errors

attributeSpellings : List String
attributeSpellings = [
  "@inline\n",
  "@must_use\n",
  "@deprecated \"old\"\n",
  "@noinline\n",
  "@must_use\n@noinline\n",
]

attributedSigCases : List String
attributedSigCases = [
  "f : Int -> Int\nf x = \"s\"\n",
  "g : Num a => a -> a\ng x = \"s\"\n",
]

test "an attribute above a signature keeps the signature binding the definition" =
  expectAll
    (flatMap
      (src =>
        let bare = attributedSigErrors "" src
        expectFalse (isEmptyL bare)
          :: map
            (attrs => expectEqual bare (attributedSigErrors attrs src))
            attributeSpellings)
      attributedSigCases)

test "a nested numeric literal may use the declared impl prerequisite" =
  let (errors, _) = numericCheckObserved numericNestedBodySource
  expectEqual [] errors

numericImplHeadSource : String -> String -> String
numericImplHeadSource methodType methodBody = joinNl [
  "data Acc b = MkAcc b",
  "interface Make a where",
  "  make : " ++ methodType,
  "impl Make (Acc b) where",
  "  " ++ methodBody,
]

test "numeric impl-head roots require an explicit prerequisite at nullary and return positions" =
  let nullary =
    fst (numericCheckObserved (numericImplHeadSource "a" "make = MkAcc 0"))
  let returns =
    fst
      (numericCheckObserved
        (numericImplHeadSource "Unit -> a" "make _ = MkAcc 0"))
  let declared = joinNl [
    "data Acc b = MkAcc b",
    "interface Make a where",
    "  make : a",
    "impl Make (Acc b) requires Num b where",
    "  make = MkAcc 0",
  ]
  expectAll [
    expectEqual
      [
        "impl of `make` for `Make` requires `Num` on the instance-head type variable `b`, which the impl does not declare; add `requires Num b` to the impl",
      ]
      nullary,
    expectEqual
      [
        "impl of `make` for `Make` requires `Num` on the instance-head type variable `b`, which the impl does not declare; add `requires Num b` to the impl",
      ]
      returns,
    expectEqual [] (fst (numericCheckObserved declared)),
  ]

test "numeric return keeps the Num predicate through production checking and stamping" =
  let (errors, trace) = numericCheckObserved (numericValueSource True)
  expectAll [
    expectEqual [] errors,
    expectEqual [NPTProduced, NPTChecked, NPTReturn] (numericStages trace),
    expectEqual
      [
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
        ("core::Num", ["N"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        trace),
    expectEqual
      [("Num", "core::Num|numeric_predicate.N|[]", [])]
      (map
        (view => (view.ntvSelected, view.ntvRoute, view.ntvPrerequisites))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return without a method collision stamps the same canonical key" =
  let (errors, trace) = numericCheckObserved (numericValueSource False)
  expectAll [
    expectEqual [] errors,
    expectEqual
      ["core::Num|numeric_predicate.N|[]"]
      (map
        (view => view.ntvRoute)
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "a Forge instance cannot discharge the numeric Num obligation" =
  let source = joinNl [
    "data N = N Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge N where",
    "  fromInt n = N n",
    "value : N",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectTrue (listLen errors > 0),
    expectTrue
      (any
        (view =>
          view.ntvStage == NPTChecked && view.ntvInterface == "core::Num")
        trace),
  ]

test "numeric return forwards the in-scope Num dictionary" =
  let source = joinNl [
    "interface Forge a where",
    "  fromInt : Int -> a",
    "value : Num a => Unit -> a",
    "value _ = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", "", True, [])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvSelected,
          view.ntvForwarded,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

test "numeric return selects prerequisites from the Num instance row" =
  let source = joinNl [
    "data Box a = Box Int",
    "interface Forge a where",
    "  fromInt : Int -> a",
    "impl Forge (Box a) where",
    "  fromInt n = Box n",
    "impl Num (Box a) requires Num a where",
    "  fromInt n = Box n",
    "value : Box Int",
    "value = 1",
  ]
  let (errors, trace) = numericCheckObserved source
  expectAll [
    expectEqual [] errors,
    expectEqual
      [("core::Num", ["Box Int"], "Num", ["core::Num|Int|[]"])]
      (map
        (view => (
          view.ntvInterface,
          view.ntvArguments,
          view.ntvSelected,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTReturn) trace)),
  ]

numericSchemeObserved : Option (Int, Int) ->
  String ->
  (List String, List NumericTraceView)
numericSchemeObserved key source =
  let sink = beginNumericPredicateTrace ()
  let ((_, schemes), gctx) =
    checkOneSchemeFullKGraph
      (driveArgs (traced sink) False key [] (desugar
        (parse numericPreludeSource)) [
        ("numeric_scheme", desugar (parseLocated source)),
      ])
  let values =
    map
      (entry => ppScheme (snd entry).psScheme)
      (filter (entry => fst entry == "value") schemes)
  let trace = map (numericTraceView gctx) (finishNumericPredicateTrace sink)
  (values, trace)

numericImportedObserved : Bool -> (Int, List NumericTraceView)
numericImportedObserved reverseOrder =
  let shape = ("numeric_shape", "public export data N = N Int")
  let numeric = (
    "numeric_impl",
    joinNl [
      "import numeric_shape.{N(..)}",
      "impl Num N where",
      "  fromInt n = N n",
    ],
  )
  let forge = (
    "numeric_forge",
    joinNl [
      "import numeric_shape.{N(..)}",
      "export interface Forge a where",
      "  fromInt : Int -> a",
      "impl Forge N where",
      "  fromInt n = N n",
    ],
  )
  let imports =
    if reverseOrder then
      ["import numeric_forge.{Forge, fromInt}", "import numeric_impl"]
    else
      ["import numeric_impl", "import numeric_forge.{Forge, fromInt}"]
  let entry = (
    "numeric_entry",
    joinNl
      (["import numeric_shape.{N}"] ++ imports ++ ["value : N", "value = 1"]),
  )
  let sources =
    if reverseOrder then
      [shape, forge, numeric, entry]
    else
      [shape, numeric, forge, entry]
  let sink = beginNumericPredicateTrace ()
  let (results, gctx) =
    chainDiagsGraph
      (traced sink)
      None
      ""
      []
      []
      (desugar (parse numericPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace = map (numericTraceView gctx) (finishNumericPredicateTrace sink)
  (modErrorCount results, trace)

test "numeric predicates survive module and import order permutations" =
  let forward = numericImportedObserved False
  let backward = numericImportedObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [NPTProduced, NPTChecked, NPTReturn]
      (numericStages (snd forward)),
    expectEqual
      [("core::Num", "Num", "core::Num|numeric_shape.N|[]")]
      (map
        (view => (view.ntvInterface, view.ntvSelected, view.ntvRoute))
        (filter (view => view.ntvStage == NPTReturn) (snd forward))),
  ]

test "prelude-free split graphs retain every builtin class identity" =
  let eqSource = joinNl [
    "export interface Eq a where",
    "  eq : a -> a -> Bool",
    "export impl Eq Int where",
    "  eq x y = x == y",
  ]
  let numSource = joinNl [
    "import eq.{Eq}",
    "export interface Num a requires Eq a where",
    "  fromInt : Int -> a",
    "export impl Num Int where",
    "  fromInt x = x",
  ]
  let useSource = joinNl [
    "import eq",
    "import num",
    "data Box = Box Int",
    "main = (Box 1) == (Box 2)",
  ]
  let oneSource = joinNl [
    "interface Eq a where",
    "  eq : a -> a -> Bool",
    "interface Num a requires Eq a where",
    "  fromInt : Int -> a",
    "impl Eq Int where",
    "  eq x y = x == y",
    "impl Num Int where",
    "  fromInt x = x",
    "data Box = Box Int",
    "main = (Box 1) == (Box 2)",
  ]
  let expected =
    "TYPE ERROR: no impl of Eq for Box; add `deriving Eq` to `Box` or write `impl Eq Box`"
  expectEqual
    (expected, expected)
    (
      checkModulesEntryReport defaultDriveInputs [] [] [
        ("one", desugar (parse oneSource)),
      ],
      checkModulesEntryReport defaultDriveInputs [] [] [
        ("eq", desugar (parse eqSource)),
        ("num", desugar (parse numSource)),
        ("use", desugar (parse useSource)),
      ],
    )

-- A type from a stdlib-owned module takes neither `deriving` (not the caller's to edit)
-- nor an orphan `impl` of a core interface, so the reject carries no hint.
test "no-impl hint is dropped for a stdlib-owned type" =
  let eqSource = joinNl [
    "export interface Eq a where",
    "  eq : a -> a -> Bool",
    "export impl Eq Int where",
    "  eq x y = x == y",
  ]
  let boxSource = "public export data Box = Box Int"
  let useSource = joinNl [
    "import eq",
    "import boxes.*",
    "main = (Box 1) == (Box 2)",
  ]
  let mods = [
    ("eq", desugar (parse eqSource)),
    ("boxes", desugar (parse boxSource)),
    ("use", desugar (parse useSource)),
  ]
  let ownedReport =
    checkModulesEntryReport
      (driveInputsFor None False ["eq", "boxes"])
      []
      []
      mods
  let userReport =
    checkModulesEntryReport (driveInputsFor None False ["eq"]) [] [] mods
  expectEqual
    (
      "TYPE ERROR: no impl of Eq for Box",
      "TYPE ERROR: no impl of Eq for Box; add `deriving Eq` to `Box` or write `impl Eq Box`",
    )
    (ownedReport, userReport)

test "finalized scheme queries drain numeric predicates on cold and keyed calls" =
  let source = numericValueSource True
  let cold = numericSchemeObserved None source
  let keyed = numericSchemeObserved (Some (977, 983)) source
  let repeated = numericSchemeObserved (Some (977, 983)) source
  let (failedErrors, _) =
    numericCheckObserved "value : Int\nvalue = \"wrong\"\n"
  let afterFailure = numericSchemeObserved (Some (977, 983)) source
  expectEach [
    (
      "a failing declaration produces at least one error",
      expectGreaterThan 0 (listLen failedErrors),
    ),
    (
      "each query keeps a distinct Num slot",
      expectEqual (["N"], ["N"], ["N"]) (fst cold, fst keyed, fst repeated),
    ),
    (
      "numeric stages agree across cold, keyed, and repeated",
      expectEqual
        [
          [NPTProduced, NPTChecked, NPTReturn],
          [NPTProduced, NPTChecked, NPTReturn],
          [NPTProduced, NPTChecked, NPTReturn],
        ]
        [
          numericStages (snd cold),
          numericStages (snd keyed),
          numericStages (snd repeated),
        ],
    ),
    ("cold == keyed", expectEqual (snd cold) (snd keyed)),
    ("keyed == repeated", expectEqual (snd keyed) (snd repeated)),
    ("repeated == afterFailure", expectEqual repeated afterFailure),
  ]

arithmeticPreludeSource : String
arithmeticPreludeSource = joinNl [
  "interface Num a where",
  "  add : a -> a -> a",
  "  sub : a -> a -> a",
  "  mul : a -> a -> a",
  "  div : a -> a -> a",
  "  negate : a -> a",
  "  abs : a -> a",
  "  signum : a -> a",
  "  fromInt : Int -> a",
  "  rem : a -> a -> a",
  "impl Num Int where",
  "  add x _ = x",
  "  sub x _ = x",
  "  mul x _ = x",
  "  div x _ = x",
  "  negate x = x",
  "  abs x = x",
  "  signum x = x",
  "  fromInt n = n",
  "  rem x _ = x",
  "impl Num Float where",
  "  add x _ = x",
  "  sub x _ = x",
  "  mul x _ = x",
  "  div x _ = x",
  "  negate x = x",
  "  abs x = x",
  "  signum x = x",
  "  fromInt _ = 0.0",
  "  rem x _ = x",
]

arithmeticFunctionsSource : String
arithmeticFunctionsSource = joinNl [
  "signedAdd : Num a => a -> a -> a",
  "signedAdd x y = x + y",
  "signedSub : Num a => a -> a -> a",
  "signedSub x y = x - y",
  "signedMul : Num a => a -> a -> a",
  "signedMul x y = x * y",
  "signedDiv : Num a => a -> a -> a",
  "signedDiv x y = x / y",
  "signedRem : Num a => a -> a -> a",
  "signedRem x y = x % y",
  "inferredAdd x y = x + y",
  "inferredSub x y = x - y",
  "inferredMul x y = x * y",
  "inferredDiv x y = x / y",
  "inferredRem x y = x % y",
]

isArithmeticFunction : String -> Bool
isArithmeticFunction name = contains name [
  "signedAdd",
  "signedSub",
  "signedMul",
  "signedDiv",
  "signedRem",
  "inferredAdd",
  "inferredSub",
  "inferredMul",
  "inferredDiv",
  "inferredRem",
]

arithmeticSchemeObserved : Option (Int, Int) ->
  String ->
  (List (String, Int, String), List (String, String, Int))
arithmeticSchemeObserved key source =
  let sink = beginAssumptionTrace ()
  let ((_, schemes), gctx) =
    checkOneSchemeFullKGraph
      (driveArgs (traced sink) False key [] (desugar
        (parse arithmeticPreludeSource)) [
        ("arithmetic_scheme", desugar (parseLocated source)),
      ])
  let values =
    map
      (entry => (
        fst entry,
        schemeVariableCount (snd entry).psScheme,
        ppScheme (snd entry).psScheme,
      ))
      (filter (entry => isArithmeticFunction (fst entry)) schemes)
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext gctx entry.atGoalScope),
          snd (scopeTraceContext gctx binderScope),
          slot,
        ))
      (finishAssumptionTrace sink)
  (values, assumptions)

arithmeticErrorCodes : String -> List String
arithmeticErrorCodes source =
  let (errors, _) = checkOneDiags defaultDriveInputs [] (desugar
    (parse arithmeticPreludeSource)) (
    "arithmetic_errors",
    desugar (parseLocated source),
  )
  map tcCode errors

test "declared and inferred arithmetic retain one Num slot at finalized queries" =
  let cold = arithmeticSchemeObserved None arithmeticFunctionsSource
  let keyed =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  let repeated =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  let failed = arithmeticErrorCodes "bad : Int\nbad = \"wrong\"\n"
  let afterFailure =
    arithmeticSchemeObserved (Some (1009, 1013)) arithmeticFunctionsSource
  expectEach [
    (
      "arities and schemes at the cold query",
      expectEqual
        [
          ("signedAdd", 1, "a -> a -> a"),
          ("signedSub", 1, "a -> a -> a"),
          ("signedMul", 1, "a -> a -> a"),
          ("signedDiv", 1, "a -> a -> a"),
          ("signedRem", 1, "a -> a -> a"),
          ("inferredAdd", 1, "a -> a -> a"),
          ("inferredSub", 1, "a -> a -> a"),
          ("inferredMul", 1, "a -> a -> a"),
          ("inferredDiv", 1, "a -> a -> a"),
          ("inferredRem", 1, "a -> a -> a"),
        ]
        (fst cold),
    ),
    ("cold == keyed", expectEqual cold keyed),
    ("keyed == repeated", expectEqual keyed repeated),
    ("repeated == afterFailure", expectEqual repeated afterFailure),
    (
      "a failing declaration produces at least one error code",
      expectGreaterThan 0 (listLen failed),
    ),
    (
      "arithmeticErrorCodes' bindings for the cold query",
      expectEqual
        [
          ("binding:inferredRem", "binding:inferredRem", 0),
          ("binding:inferredDiv", "binding:inferredDiv", 0),
          ("binding:inferredMul", "binding:inferredMul", 0),
          ("binding:inferredSub", "binding:inferredSub", 0),
          ("binding:inferredAdd", "binding:inferredAdd", 0),
          ("binding:signedRem", "binding:signedRem", 0),
          ("binding:signedDiv", "binding:signedDiv", 0),
          ("binding:signedMul", "binding:signedMul", 0),
          ("binding:signedSub", "binding:signedSub", 0),
          ("binding:signedAdd", "binding:signedAdd", 0),
        ]
        (snd cold),
    ),
  ]

arithmeticTraceObserved : String ->
  (List String, List NumericTraceView, List (String, String, Int))
arithmeticTraceObserved source =
  let sink = { beginNumericPredicateTrace () | tsAssumptionEnabled = True }
  let ((errors, _), gctx) =
    checkOneDiagsGraph
      (driveArgs (traced sink) False None [] (desugar
        (parse arithmeticPreludeSource)) [
        ("arithmetic_trace", desugar (parseLocated source)),
      ])
  let trace = map (numericTraceView gctx) (finishNumericPredicateTrace sink)
  let assumptions =
    map
      (entry =>
        let (EvidenceBinderId binderScope slot) = entry.atBinder
        (
          snd (scopeTraceContext gctx entry.atGoalScope),
          snd (scopeTraceContext gctx binderScope),
          slot,
        ))
      (finishAssumptionTrace sink)
  (map tcMsg errors, trace, assumptions)

test "operator events correlate by whole span scope and exact prelude Num predicate" =
  let (errors, trace, assumptions) =
    arithmeticTraceObserved "value : Num a => a -> a\nvalue x = x + 0\n"
  let operator = filter (view => view.ntvOrigin == (2, 10, 2, 15)) trace
  let literal = filter (view => view.ntvOrigin == (2, 14, 2, 15)) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [NPTProduced, NPTChecked, NPTArithmetic]
      (numericStages operator),
    expectEqual [NPTProduced, NPTChecked, NPTReturn] (numericStages literal),
    expectEqual
      [
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        operator),
    expectEqual
      [("", True, [])]
      (map
        (view => (
          view.ntvSelectedIdentity,
          view.ntvGiven,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTArithmetic) operator)),
    expectEqual
      [
        ("binding:value", "binding:value", 0),
        ("binding:value", "binding:value", 0),
      ]
      assumptions,
  ]

test "generic remainder uses the same scoped Num evidence route" =
  let (errors, trace, assumptions) =
    arithmeticTraceObserved "value : Num a => a -> a -> a\nvalue x y = x % y\n"
  let operator = filter (view => view.ntvOrigin == (2, 12, 2, 17)) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [NPTProduced, NPTChecked, NPTArithmetic]
      (numericStages operator),
    expectEqual
      [
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
        ("core::Num", ["a"], "binding:value"),
      ]
      (map
        (view => (view.ntvInterface, view.ntvArguments, view.ntvOwner))
        operator),
    expectEqual
      [("", True, [])]
      (map
        (view => (
          view.ntvSelectedIdentity,
          view.ntvGiven,
          view.ntvPrerequisites,
        ))
        (filter (view => view.ntvStage == NPTArithmetic) operator)),
    expectEqual [("binding:value", "binding:value", 0)] assumptions,
  ]

arithmeticImportedObserved : Bool -> (Int, List NumericTraceView)
arithmeticImportedObserved reverseOrder =
  let shape = ("arithmetic_shape", "public export data Box a = Box a")
  let numeric = (
    "arithmetic_numeric",
    joinNl [
      "import arithmetic_shape.{Box(..)}",
      "impl Num (Box a) requires Num a where",
      "  add x _ = x",
      "  sub x _ = x",
      "  mul x _ = x",
      "  div x _ = x",
      "  negate x = x",
      "  abs x = x",
      "  signum x = x",
      "  fromInt n = Box (fromInt n)",
      "  rem x _ = x",
    ],
  )
  let forge = (
    "arithmetic_forge",
    joinNl [
      "import arithmetic_shape.{Box}",
      "export interface Forge a where",
      "  add : a -> a -> a",
      "  rem : a -> a -> a",
      "impl Forge (Box a) where",
      "  add x _ = x",
      "  rem x _ = x",
    ],
  )
  let imports =
    if reverseOrder then
      [
        "import arithmetic_forge.{Forge, add, rem}",
        "import arithmetic_numeric",
      ]
    else
      [
        "import arithmetic_numeric",
        "import arithmetic_forge.{Forge, add, rem}",
      ]
  let entry = (
    "arithmetic_entry",
    joinNl
      (["import arithmetic_shape.{Box(..)}"]
        ++ imports
        ++ [
          "left : Box Int",
          "left = Box 12",
          "right : Box Int",
          "right = Box 3",
          "addValue : Box Int",
          "addValue = left + right",
          "subValue : Box Int",
          "subValue = left - right",
          "mulValue : Box Int",
          "mulValue = left * right",
          "divValue : Box Int",
          "divValue = left / right",
          "remValue : Box Int",
          "remValue = left % right",
        ]),
  )
  let sources =
    if reverseOrder then
      [shape, forge, numeric, entry]
    else
      [shape, numeric, forge, entry]
  let sink = beginNumericPredicateTrace ()
  let (results, gctx) =
    chainDiagsGraph
      (traced sink)
      None
      ""
      []
      []
      (desugar (parse arithmeticPreludeSource))
      (map (item => (fst item, desugar (parseLocated (snd item)))) sources)
  let trace = map (numericTraceView gctx) (finishNumericPredicateTrace sink)
  let arithmetic =
    filter
      (view =>
        view.ntvStage == NPTArithmetic
          && contains view.ntvOwner [
            "binding:addValue",
            "binding:subValue",
            "binding:mulValue",
            "binding:divValue",
            "binding:remValue",
          ])
      trace
  (modErrorCount results, arithmetic)

test "arithmetic collision imports select the exact Num row and prerequisites" =
  let forward = arithmeticImportedObserved False
  let backward = arithmeticImportedObserved True
  expectAll [
    expectEqual 0 (fst forward),
    expectEqual forward backward,
    expectEqual
      [
        (
          "binding:remValue",
          "core::Num",
          "core::Num",
          "core::Num|(arithmetic_shape.Box a)|[]",
          ["core::Num|Int|[]"],
        ),
        (
          "binding:divValue",
          "core::Num",
          "core::Num",
          "core::Num|(arithmetic_shape.Box a)|[]",
          ["core::Num|Int|[]"],
        ),
        (
          "binding:mulValue",
          "core::Num",
          "core::Num",
          "core::Num|(arithmetic_shape.Box a)|[]",
          ["core::Num|Int|[]"],
        ),
        (
          "binding:subValue",
          "core::Num",
          "core::Num",
          "core::Num|(arithmetic_shape.Box a)|[]",
          ["core::Num|Int|[]"],
        ),
        (
          "binding:addValue",
          "core::Num",
          "core::Num",
          "core::Num|(arithmetic_shape.Box a)|[]",
          ["core::Num|Int|[]"],
        ),
      ]
      (map
        (view => (
          view.ntvOwner,
          view.ntvInterface,
          view.ntvSelectedIdentity,
          view.ntvRoute,
          view.ntvPrerequisites,
        ))
        (snd forward)),
  ]

test "primitive arithmetic retains the Int and Float scalar routes" =
  let (errors, trace, _) =
    arithmeticTraceObserved
      (joinNl [
        "intValue : Int",
        "intValue = 12 + 3",
        "floatValue : Float",
        "floatValue = 7.5 / 2.0",
      ])
  let arithmetic = filter (view => view.ntvStage == NPTArithmetic) trace
  expectAll [
    expectEqual [] errors,
    expectEqual
      [
        ("binding:floatValue", ["Float"], "scalar:Float", "", []),
        ("binding:intValue", ["Int"], "scalar:Int", "", []),
      ]
      (map
        (view => (
          view.ntvOwner,
          view.ntvArguments,
          view.ntvRoute,
          view.ntvSelectedIdentity,
          view.ntvPrerequisites,
        ))
        arithmetic),
  ]

