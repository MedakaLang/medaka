-- The anti-laundering matrix for named authorities: every negative beside its
-- honest control, observed through production inference on tiny programs.
-- The rows come from docs/ops/EFFECTS-REARCHITECTURE-HANDOFF.md.
import test.{expectAll, expectEqual, expectTrue, expectFalse}
import frontend.desugar.{desugar}
import frontend.parser.{parseLocated}
import types.typecheck.{
  checkOneDiags, checkOneSchemeFullK, checkModulesDiagsChain, ModDiags, tcCode,
  tcMsg, TcDiag(..)
}
import types.repr.{Scheme(..), ppScheme}
import frontend.ast.{Loc(..)}
import types.effect_authority.{
  Authority(..), Authvar(..), authNorm, authSub, authJoin, renderAuthority,
  authSplit, authExtend, authAppend, authIsTop, authPatternClose, authIsPattern
}
import types.effect_domain.{Param(..)}
import support.util.{contains, lookupAssoc, anyList, listLen}
import tools.fmt.{formatSource}
import string as S

-- A prefix-domain label with a named-authority extern and a set-domain
-- label beside it, so the two domains can be crossed.
prelude : String
prelude =
  "effect Store Prefix\n"
    ++ "effect Var Set\n"
    ++ "extern load : (path : String) -> <Store path> Int\n"
    ++ "extern move : (src : String) -> (dst : String) -> <Store src, Store dst> Unit\n"
    ++ "extern lookup : (name : String) -> <Var name> Int\n"
    ++ "extern anyStore : Unit -> <Store> Int\n"

codes : String -> List String
codes source =
  let (errors, _) = checkOneDiags [] [] (
    "authority",
    desugar (parseLocated (prelude ++ source)),
  )
  map tcCode errors

schemeOf : String -> String -> String
schemeOf source name =
  let (_, schemes) = checkOneSchemeFullK None [] [] (
    "authority",
    desugar (parseLocated (prelude ++ source)),
  )
  match lookupAssoc name schemes
    Some s => ppScheme s
    None => "<missing>"

rejects : String -> Bool
rejects source = contains "T-AUTHORITY" (codes source)

accepts : String -> Bool
accepts source = match codes source
  [] => True
  _ => False

test "a literal must lie within the bound; raw dynamic input is top" = expectAll
  [
    expectTrue
      (accepts "ok : Unit -> <Store \"cfg/*\"> Int\nok _ = load \"cfg/app\"\n"),
    expectFalse
      (accepts
        "bad : Unit -> <Store \"cfg/*\"> Int\nbad _ = load \"/etc/x\"\n"),
    expectFalse
      (accepts "dyn : String -> <Store \"cfg/*\"> Int\ndyn p = load p\n"),
  ]

test "a named wrapper is checked against its own argument" = expectAll [
  expectTrue
    (accepts "honest : (p : String) -> <Store p> Int\nhonest p = load p\n"),
  expectTrue
    (rejects
      "extend : (p : String) -> <Store p> Int\nextend p = load (p ++ \"/x\")\n"),
  expectTrue
    (rejects
      "sneaky : (p : String) -> <Store p> Int\nsneaky p = load \"/etc/x\"\n"),
  expectTrue
    (rejects
      "rooted : (p : String) -> <Store p> Int\nrooted p = load (\"/\" ++ p)\n"),
  expectTrue
    (rejects "wide : (p : String) -> <Store p> Int\nwide p = anyStore ()\n"),
]

test "the implementation binder's spelling does not matter" = expectAll [
  expectTrue
    (accepts "honest : (p : String) -> <Store p> Int\nhonest q = load q\n"),
  expectTrue
    (rejects
      "sneaky : (p : String) -> <Store p> Int\nsneaky q = load \"/etc/x\"\n"),
]

test "both determining positions of a two-path extern are charged" = expectAll [
  expectTrue
    (accepts
      "mv : Unit -> <Store \"tmp/*\"> Unit\nmv _ = move \"tmp/a\" \"tmp/b\"\n"),
  expectFalse
    (accepts
      "mv : Unit -> <Store \"tmp/*\"> Unit\nmv _ = move \"tmp/a\" \"/etc/x\"\n"),
  expectFalse
    (accepts
      "mv : Unit -> <Store \"tmp/*\"> Unit\nmv _ = move \"/etc/x\" \"tmp/a\"\n"),
]

test "aliases, partial applications and higher-order application keep the relation" = expectAll
  [
    expectTrue
      (accepts
        "ld = load\nok : Unit -> <Store \"cfg/*\"> Int\nok _ = ld \"cfg/app\"\n"),
    expectFalse
      (accepts
        "ld = load\nbad : Unit -> <Store \"cfg/*\"> Int\nbad _ = ld \"/etc/x\"\n"),
    expectTrue
      (accepts
        "part : Unit -> <Store \"tmp/*\"> Unit\npart _ =\n  let from = move \"tmp/a\"\n  from \"tmp/b\"\n"),
    expectFalse
      (accepts
        "part : Unit -> <Store \"tmp/*\"> Unit\npart _ =\n  let from = move \"tmp/a\"\n  from \"/etc/x\"\n"),
    expectTrue
      (accepts
        "apply : (a -> <e> b) -> a -> <e> b\napply f x = f x\nok : Unit -> <Store \"cfg/*\"> Int\nok _ = apply load \"cfg/app\"\n"),
    expectFalse
      (accepts
        "apply : (a -> <e> b) -> a -> <e> b\napply f x = f x\nbad : Unit -> <Store \"cfg/*\"> Int\nbad _ = apply load \"/etc/x\"\n"),
    expectTrue
      (accepts
        "comp = load >> (n => n + 1)\nok : Unit -> <Store \"cfg/*\"> Int\nok _ = comp \"cfg/app\"\n"),
    expectFalse
      (accepts
        "comp = load >> (n => n + 1)\nbad : Unit -> <Store \"cfg/*\"> Int\nbad _ = comp \"/etc/x\"\n"),
  ]

test "a wrapper publishes its argument's authority, not a fresh universal" = expectAll
  [
    expectEqual
      "(p : String) -> <Store p> Int"
      (schemeOf
        "honest : (p : String) -> <Store p> Int\nhonest p = load p\n"
        "honest"),
    expectEqual
      "(path : String) -> <Store path> Int"
      (schemeOf "ld = load\n" "ld"),
    -- an unsigned wrapper of an unqualified argument reads any path
    expectEqual "String -> <Store> Int" (schemeOf "w p = load p\n" "w"),
  ]

test "branches join and a let-bound literal is seen through" = expectAll [
  expectTrue
    (accepts
      "ok : Bool -> <Store \"cfg/*\"> Int\nok b = load (if b then \"cfg/a\" else \"cfg/b\")\n"),
  expectFalse
    (accepts
      "bad : Bool -> <Store \"cfg/*\"> Int\nbad b = load (if b then \"cfg/a\" else \"/etc/x\")\n"),
  expectTrue
    (accepts
      "ok : Unit -> <Store \"cfg/*\"> Int\nok _ =\n  let dest = \"cfg/app\"\n  load dest\n"),
]

test "the set domain does not preserve concatenation" = expectAll [
  expectTrue
    (accepts "ok : Unit -> <Var {\"HOME\"}> Int\nok _ = lookup \"HOME\"\n"),
  expectFalse
    (accepts
      "bad : (n : String) -> <Var n> Int\nbad n = lookup (n ++ \"_X\")\n"),
  expectTrue (accepts "ok : (n : String) -> <Var n> Int\nok n = lookup n\n"),
]

test "a binder has one domain and a String type" = expectAll [
  expectTrue
    (contains
      "T-AUTHORITY-DOMAIN"
      (codes "two : (p : String) -> <Store p, Var p> Int\ntwo p = load p\n")),
  expectTrue
    (contains
      "T-AUTHORITY-BINDER"
      (codes "n : (k : Int) -> <Store k> Int\nn k = anyStore ()\n")),
]

test "a name is read by its binding: rebinding shadows the outer authority" = expectAll
  [
    expectTrue
      (rejects
        "arm : (p : String) -> <Store p> Int\narm p = load (match \"/etc/x\"\n  p => p)\n"),
    expectTrue
      (rejects
        "pat : (p : String) -> <Store p> Int\npat p = load (let (p, _) = (\"/etc/x\", 1) in p)\n"),
    expectFalse
      (accepts
        "outer : String -> <Store \"cfg/*\"> Int\nouter input =\n  let q = \"cfg/app\"\n  match Some input\n    Some q => load q\n    None => 0\n"),
    expectFalse
      (accepts
        "chain : Unit -> <Store \"cfg/*\"> Int\nchain _ =\n  let x = \"/etc/x\"\n  let q = x\n  let x = \"cfg/app\"\n  load q\n"),
    expectTrue
      (accepts
        "rename : (p : String) -> <Store p> Int\nrename p = load (match p\n  q => q)\n"),
    expectTrue
      (accepts
        "chain : Unit -> <Store \"cfg/*\"> Int\nchain _ =\n  let x = \"cfg/app\"\n  let q = x\n  let x = \"/etc/x\"\n  load q\n"),
  ]

test "a method contract's binder is rigid in every body that implements it" = expectAll
  [
    expectTrue
      (rejects
        "interface Loader a where\n  get : a -> (p : String) -> <Store p> Int\ndata X = X\ncomp = (f => f) load\nimpl Loader X where\n  get _ p = comp \"/etc/x\"\n"),
    expectTrue
      (accepts
        "interface Loader a where\n  get : a -> (p : String) -> <Store p> Int\ndata X = X\nimpl Loader X where\n  get _ p = load p\n"),
    expectTrue
      (rejects
        "interface Loader a where\n  get : a -> (p : String) -> <Store p> Int\n  get _ p = load (p ++ \"/x\")\ndata X = X\nimpl Loader X where\n"),
  ]

test "a lambda-form definition and a qualified result follow the signature" = expectAll
  [
    expectTrue
      (accepts "lam : (p : String) -> <Store p> Int\nlam = p => load p\n"),
    expectTrue
      (rejects
        "lam : (p : String) -> <Store p> Int\nlam = p => load \"/etc/x\"\n"),
    expectTrue
      (accepts
        "idp : (p : String) -> <Store p> String @p\nidp p = p\nvia : (p : String) -> <Store p> Int\nvia p = load (idp p)\n"),
  ]

test "a written prefix element without a star is exact" = expectAll [
  expectFalse
    (accepts
      "exact : Unit -> <Store \"/etc/host\"> Int\nexact _ = load \"/etc/hostname\"\n"),
  expectTrue
    (accepts
      "pat : Unit -> <Store \"/etc/host*\"> Int\npat _ = load \"/etc/hostname\"\n"),
  expectTrue
    (accepts
      "same : Unit -> <Store \"/etc/host\"> Int\nsame _ = load \"/etc/host\"\n"),
]

test "the authority algebra" =
  let top = AConst (PPrefix None)
  let a = AConst (PPrefix (Some "a/*"))
  let ab = AConst (PPrefix (Some "a/b/*"))
  let k = AVar (Ref (AUnbound 1 0 (PPrefix None) False (Some "k")))
  let j = AVar (Ref (AUnbound 2 0 (PPrefix None) False None))
  expectAll [
    expectTrue (authSub ab a),
    expectFalse (authSub a ab),
    expectTrue (authSub k top),
    expectFalse (authSub top k),
    expectTrue (authSub k k),
    expectFalse (authSub k j),
    expectTrue (authSub a (authJoin k a)),
    expectTrue (authSub (authJoin ab k) (authJoin a k)),
    expectFalse (authSub (authJoin a k) (authJoin ab k)),
    expectEqual " (\"a/*\" | k)" (renderAuthority (authJoin k a)),
    expectEqual "" (renderAuthority (authJoin top k)),
  ]

-- A pattern-ranging variable extends to itself; any other extends to the
-- top. The closure π takes a term to the least pattern above it.
test "a pattern-ranging variable is a fixed point of extension" =
  let k = AVar (Ref (AUnbound 1 0 (PPrefix None) True (Some "k")))
  let j = AVar (Ref (AUnbound 2 0 (PPrefix None) False (Some "j")))
  let exact = AConst (PPrefix (Some "data/app.db"))
  expectAll [
    expectEqual " k" (renderAuthority (authExtend k)),
    expectEqual " k" (renderAuthority (authAppend "/x" k)),
    expectTrue (authIsTop (authExtend j)),
    expectEqual " \"data/app.db*\"" (renderAuthority (authPatternClose exact)),
    expectEqual
      " (\"data/app.db*\" | k)"
      (renderAuthority (authPatternClose (authJoin exact k))),
    expectTrue (authIsPattern k),
    expectFalse (authIsPattern j),
    expectFalse (authIsPattern exact),
    expectTrue (authIsPattern (authPatternClose exact)),
    expectTrue (authIsPattern (AConst (PPrefix None))),
  ]

-- A Product tuple whose axes are terms: each axis is compared on its own, a
-- tuple of constants is a constant, and a cover is proven only by one element.
test "the Product tuple algebra" =
  let h = AVar (Ref (AUnbound 10 0 (PPrefix None) False (Some "h")))
  let m = AVar (Ref (AUnbound 11 0 (PSet None) False (Some "m")))
  let u = AVar (Ref (AUnbound 12 0 (PProduct []) False (Some "u")))
  let pre s = AConst (PPrefix (Some s))
  let set xs = AConst (PSet (Some xs))
  let tuple host method = AProduct [("Host", host), ("Method", method)]
  let elem host method =
    AConst (PProduct [("Host", PPrefix host), ("Method", PSet method)])
  expectAll
    [
      expectTrue (authSub (tuple h m) (tuple h m)),
      expectFalse (authSub (tuple h (set ["GET"])) (tuple h m)),
      expectFalse (authSub (elem (Some "a/x") (Some ["GET"])) (tuple h m)),
      expectTrue (authSub (tuple h m) (elem None None)),
      expectTrue (authSub (tuple h (set ["GET"])) (elem None (Some ["GET"]))),
      expectFalse (authSub (tuple h (set ["GET"])) (elem None (Some ["POST"]))),
      expectTrue
        (authSub
          (elem (Some "a/x") (Some ["GET"]))
          (tuple (pre "a/*") (AConst (PSet None)))),
      -- two elements cover this tuple only together: not proven
      expectFalse
        (authSub
          (tuple (authJoin (pre "a/x") (pre "b/x")) m)
          (authJoin (elem (Some "a/*") None) (elem (Some "b/*") None))),
      expectEqual " Host=h Method=m" (renderAuthority (tuple h m)),
      expectEqual " Host=h" (renderAuthority (tuple h (AConst (PSet None)))),
      expectEqual
        " Host=\"a/x\" Method={\"GET\"}"
        (renderAuthority (tuple (pre "a/x") (set ["GET"]))),
      expectEqual
        ["\"a/x\" <= h", "{\"GET\"} <= m"]
        (map
          (p =>
            "\{S.trim (renderAuthority (fst p))} <= \{S.trim (renderAuthority (snd p))}")
          (authSplit (elem (Some "a/x") (Some ["GET"])) (tuple h m))),
      -- a variable of the whole Product domain has no projection on an axis
      expectEqual 1 (listLen (authSplit u (tuple h m))),
      -- a variable may stand for an exact element: any suffix leaves it
      expectTrue (authIsTop (authExtend h)),
      expectTrue (authIsTop (authAppend "/x" h)),
      expectTrue (authIsTop (authExtend m)),
    ]

-- ── The data half (EFFECTS-SEMANTICS §4.1): fields, constructors, patterns ──

-- A handle whose one field is qualified by the head's authority parameter.
handle : String
handle = "data H (p : Authority Store) = H (String @p)\n"

test "a qualified field is a proof source: construction checks the stored value" = expectAll
  [
    expectTrue
      (accepts (handle ++ "mk : Unit -> H \"cfg/*\"\nmk _ = H \"cfg/app\"\n")),
    expectTrue
      (rejects (handle ++ "mk : Unit -> H \"cfg/*\"\nmk _ = H \"/etc/x\"\n")),
    expectTrue (rejects (handle ++ "mk : String -> H \"cfg/*\"\nmk s = H s\n")),
    expectTrue
      (accepts
        (handle ++ "open : (path : String) -> H path\nopen path = H path\n")),
    expectTrue
      (rejects
        (handle
          ++ "open : (path : String) -> H path\nopen path = H (path ++ \"/x\")\n")),
    expectTrue
      (rejects
        (handle
          ++ "open : (path : String) -> H path\nopen path = H \"/etc/x\"\n")),
    expectEqual
      "(path : String) -> H path"
      (schemeOf
        (handle ++ "open : (path : String) -> H path\nopen path = H path\n")
        "open"),
    expectEqual "String -> H *" (schemeOf (handle ++ "anyH s = H s\n") "anyH"),
  ]

test "matching recovers the declared qualifier and nothing more" = expectAll [
  expectTrue
    (accepts (handle ++ "read : H p -> <Store p> Int\nread (H s) = load s\n")),
  expectTrue
    (rejects
      (handle
        ++ "read : H p -> <Store p> Int\nread (H s) = load \"/etc/x\"\n")),
  expectFalse
    (accepts
      ("data U = U String\n"
        ++ "readU : U -> <Store \"cfg/*\"> Int\nreadU (U s) = load s\n")),
  expectTrue
    (accepts
      ("data U = U String\n"
        ++ "readU : U -> <Store> Int\nreadU (U s) = load s\n")),
  expectTrue
    (accepts
      ("data H2 (p : Authority Store) = A (String @p) | B Int\n"
        ++ "f : H2 p -> <Store p> Int\nf (A s) = load s\nf (B n) = n\n")),
  expectTrue
    (rejects
      ("data H2 (p : Authority Store) = A (String @p) | B Int\n"
        ++ "f : H2 p -> <Store p> Int\nf (A s) = load s\nf (B n) = load \"cfg/x\"\n")),
]

test "an index in a signature quantifies like a type variable" = expectAll [
  expectTrue
    (accepts
      (handle
        ++ "read : H p -> <Store p> Int\nread (H s) = load s\n"
        ++ "via : H p -> <Store p> Int\nvia h = read h\n")),
  expectTrue
    (accepts
      (handle
        ++ "read : H p -> <Store p> Int\nread (H s) = load s\n"
        ++ "viaTop : H p -> <Store> Int\nviaTop h = read h\n")),
  expectTrue
    (rejects
      (handle
        ++ "read : H p -> <Store p> Int\nread (H s) = load s\n"
        ++ "viaBad : H p -> <Store \"cfg/*\"> Int\nviaBad h = read h\n")),
  expectTrue
    (contains
      "T-AUTHORITY-KIND"
      (codes (handle ++ "bad : List p -> <Store p> Int\nbad _ = 1\n"))),
  expectTrue
    (contains
      "T-AUTHORITY-KIND"
      (codes (handle ++ "bad : H p -> List p -> Int\nbad _ _ = 1\n"))),
]

-- (the `Ref` cell rows live in effect_data_field_{ok,launder}: `:=` needs the
-- prelude this matrix runs without)
test "an index is invariant; `*` is the top" = expectAll [
  expectTrue
    (accepts (handle ++ "same : H \"cfg/*\" -> H \"cfg/*\"\nsame h = h\n")),
  expectEqual
    ["T-AUTHORITY-INDEX-MISMATCH"]
    (codes (handle ++ "widen : H \"cfg/app\" -> H \"cfg/*\"\nwiden h = h\n")),
  expectTrue (accepts (handle ++ "anyH : String -> H *\nanyH s = H s\n")),
  expectTrue
    (accepts
      (handle ++ "fromAny : H * -> <Store> Int\nfromAny (H s) = load s\n")),
  expectFalse
    (accepts
      (handle
        ++ "fromAny : H * -> <Store \"cfg/*\"> Int\nfromAny (H s) = load s\n")),
]

test "a phantom authority index is trusted only at home" = expectAll [
  expectTrue
    (contains
      "T-AUTHORITY-PHANTOM-EXPORT"
      (codes "public export data P (p : Authority Store) = P Int\n")),
  expectTrue (accepts "export data P (p : Authority Store) = P Int\n"),
  expectTrue
    (accepts "public export data Q (p : Authority Store) = Q (String @p)\n"),
  expectTrue
    (accepts
      ("data P (p : Authority Store) = P Int\n"
        ++ "mk : (path : String) -> P path\nmk _ = P 1\n")),
]

record : String
record = "data R (p : Authority Store) = R { path : String @p, n : Int }\n"

test "record fields: create, read, pattern and update follow the qualifier" = expectAll
  [
    expectTrue
      (accepts
        (record
          ++ "mk : Unit -> R \"cfg/*\"\nmk _ = R { path = \"cfg/a\", n = 1 }\n")),
    expectTrue
      (rejects
        (record
          ++ "mk : Unit -> R \"cfg/*\"\nmk _ = R { path = \"/etc/x\", n = 1 }\n")),
    expectTrue
      (accepts (record ++ "rd : R p -> <Store p> Int\nrd r = load r.path\n")),
    expectTrue
      (accepts
        (record
          ++ "rd : R p -> <Store p> Int\nrd (R { path = s }) = load s\n")),
    expectTrue
      (accepts
        (record ++ "rd : R p -> <Store p> Int\nrd (R { path }) = load path\n")),
    expectTrue
      (rejects
        (record
          ++ "rd : R p -> <Store p> Int\nrd (R { path }) = load \"/etc/x\"\n")),
    expectTrue
      (accepts (record ++ "upd : R p -> R p\nupd r = { r | n = 2 }\n")),
    expectTrue
      (rejects
        (record ++ "upd : R p -> R p\nupd r = { r | path = \"/etc/x\" }\n")),
  ]

existential : String
existential =
  handle
    ++ "data Any = Any (p : Authority Store) (H p)\n"
    ++ "read : H p -> <Store p> Int\nread (H s) = load s\n"
    ++ "write : H p -> String @p -> Unit\nwrite _ _ = ()\n"

test "an existential opens a rigid authority scoped to the arm" = expectAll [
  expectTrue
    (accepts
      (existential
        ++ "pack : (path : String) -> Any\npack path = Any (H path)\n")),
  expectTrue
    (accepts
      (existential
        ++ "use : Any -> <Store> Int\nuse a = match a\n  Any h => read h\n")),
  expectTrue
    (rejects
      (existential
        ++ "use : Any -> <Store \"cfg/*\"> Int\nuse a = match a\n  Any h => read h\n")),
  expectTrue
    (accepts
      (existential
        ++ "wr : Any -> Unit\nwr a = match a\n  Any h => match h\n    H s => write h s\n")),
  expectTrue
    (rejects
      (existential
        ++ "wr : Any -> Unit\nwr a = match a\n  Any h => write h \"/etc/x\"\n")),
  expectTrue
    (contains
      "T-AUTHORITY-ESCAPE"
      (codes
        (existential ++ "esc : Any -> H *\nesc a = match a\n  Any h => h\n"))),
  expectTrue
    (accepts
      (existential ++ "useC : Any -> <Store> Int\nuseC (Any h) = read h\n")),
  expectTrue
    (contains
      "T-AUTHORITY-ESCAPE"
      (codes (existential ++ "escC : Any -> H *\nescC (Any h) = h\n"))),
  expectTrue
    (contains
      "T-AUTHORITY-EXISTENTIAL-SCOPE"
      (codes
        (existential
          ++ "bad : Any -> <Store> Int\nbad a =\n  let Any h = a\n  read h\n"))),
  expectEqual
    "Any -> <Store> Int"
    (schemeOf (existential ++ "use a = match a\n  Any h => read h\n") "use"),
]

-- ── The whole-diff review's data-half findings, each beside its control ──

indexedD : String
indexedD = "data D (p : Authority Store) = D (String @p) Int\n"

test "an alias parameter substitutes; an impl head and a forward reference elaborate under declared kinds" = expectAll
  [
    expectEqual
      "H p -> H p"
      (schemeOf
        (handle
          ++ "type HA (q : Authority Store) = H q\nback : HA p -> H p\nback h = h\n")
        "back"),
    expectTrue
      (accepts
        (handle
          ++ "type HA (q : Authority Store) = H q\nmk : Unit -> HA \"cfg/*\"\nmk _ = H \"cfg/app\"\n")),
    expectTrue
      (rejects
        (handle
          ++ "type HA (q : Authority Store) = H q\nmk : Unit -> HA \"cfg/*\"\nmk _ = H \"/etc/x\"\n")),
    expectTrue
      (accepts
        (indexedD ++ "impl Eq (D p) where\n  eq (D _ a) (D _ b) = a == b\n")),
    expectTrue
      (accepts
        "data E (p : Authority Store) = E (String @p) Int deriving (Eq)\n"),
    expectTrue
      (contains
        "T-AUTHORITY-KIND"
        (codes
          (indexedD
            ++ "impl Eq (D Int) where\n  eq (D _ a) (D _ b) = a == b\n"))),
    expectTrue
      (accepts
        "data A (p : Authority Store) = A Int (B p)\ndata B (p : Authority Store) = B (String @p)\n"),
  ]

sealed : String
sealed =
  handle
    ++ "data Sealed = Sealed (p : Authority Store) { path : String @p, n : Int }\n"

test "a field read cannot open an existential: it recovers the top" = expectAll
  [
    expectEqual
      "Sealed -> H *"
      (schemeOf (sealed ++ "unseal s = H s.path\n") "unseal"),
    expectFalse
      (accepts (sealed ++ "at : Sealed -> H \"cfg/*\"\nat s = H s.path\n")),
    expectEqual
      "Sealed -> Int"
      (schemeOf (sealed ++ "count s = s.n\n") "count"),
    expectTrue
      (accepts
        (sealed
          ++ "open : Sealed -> <Store> Int\nopen s = match s\n  Sealed { path } => load path\n")),
  ]

raw : String
raw = "data Raw (p : Authority Store) = Raw Int\n"

test "an unsigned forwarder of a phantom constructor publishes the top" = expectAll
  [
    expectEqual "Int -> Raw *" (schemeOf (raw ++ "mk = Raw\n") "mk"),
    expectFalse
      (accepts
        (raw ++ "mk = Raw\nforge : Unit -> Raw \"cfg/*\"\nforge _ = mk 3\n")),
    expectTrue
      (accepts (raw ++ "home : Unit -> Raw \"cfg/*\"\nhome _ = Raw 3\n")),
    expectTrue
      (accepts (raw ++ "mk = Raw\nany : Unit -> Raw *\nany _ = mk 3\n")),
  ]

-- Two modules: the provider declares the heads and the importer applies
-- their constructors.  A public constructor must CARRY its parameter
-- (`tyCarries`): a field the importer can fill with a value that proves
-- nothing (`[]` at `List (H p)`, an idle closure at `Unit -> <Store p> Int`)
-- mentions the parameter and carries nothing, so such a head is refused at
-- its declaration; a carrying head is applied anywhere and proves its index
-- through the ordinary argument route.
provider : String
provider =
  "public export data H (p : Authority Store) = H (String @p)\n"
    ++ "public export data Tok (p : Authority Store) = Tok (H p) (List (H p))\n"
    ++ "public export data SealedR = SealedR (p : Authority Store) { h : H p, k : Int }\n"
    ++ "export data Raw (p : Authority Store) = Raw Int\n"
    ++ "export\nmkRaw = Raw\n"

moduleCodesOf : String -> String -> List String
moduleCodesOf prov body =
  flatMap
    moduleCodes
    (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
      ("provider", desugar (parseLocated prov)),
      (
        "entry",
        desugar
          (parseLocated
            ("import provider.{H(..), Tok(..), SealedR(..), Raw, mkRaw}\n"
              ++ body)),
      ),
    ])

claimCodes : String -> List String
claimCodes body = moduleCodesOf provider body

moduleCodes : ModDiags -> List String
moduleCodes (_, (_, errors, _)) = map tcCode errors

claimAccepts : String -> Bool
claimAccepts body = match claimCodes body
  [] => True
  _ => False

test "a public constructor carries its parameter, and an importer proves the index through the field" = expectAll
  [
    -- mention is not carrying: `[]` and an idle closure inhabit these at every index
    expectTrue
      (contains
        "T-AUTHORITY-PHANTOM-EXPORT"
        (codes
          (handle
            ++ "public export data Tok (p : Authority Store) = Tok Int (List (H p))\n"))),
    expectTrue
      (contains
        "T-AUTHORITY-PHANTOM-EXPORT"
        (codes
          "public export data Cb (p : Authority Store) = Cb Int (Unit -> <Store p> Int)\n")),
    expectTrue
      (accepts
        (handle
          ++ "public export data Pair (p : Authority Store) = Pair (H p) (List (H p))\n")),
    expectTrue
      (accepts
        (handle
          ++ "public export data Tup (p : Authority Store) = Tup (Int, H p)\n")),
    expectTrue
      (accepts
        (handle
          ++ "public export data Box a = Box a\n"
          ++ "public export data Boxed (p : Authority Store) = Boxed (Box (H p))\n")),
    expectTrue
      (contains
        "T-AUTHORITY-PHANTOM-EXPORT"
        (codes
          (handle
            ++ "public export data Opt (p : Authority Store) = Opt (Option (H p))\n"))),
    -- the importer proves the index through the carrying field
    expectTrue
      (claimAccepts
        "tokAt : (path : String) -> Tok path\ntokAt path = Tok (H path) []\n"),
    expectTrue
      (claimAccepts
        "cfg : Unit -> Tok \"cfg/*\"\ncfg _ = Tok (H \"cfg/app\") []\n"),
    expectFalse
      (claimAccepts
        "bad : Unit -> Tok \"cfg/*\"\nbad _ = Tok (H \"/etc/x\") []\n"),
    expectTrue (claimAccepts "re : Tok p -> Tok p\nre (Tok h hs) = Tok h hs\n"),
    expectTrue
      (claimAccepts
        "fromT t = Tok (hd t) (hsOf t)\nhd (Tok h _) = h\nhsOf (Tok _ hs) = hs\nuse : Tok \"cfg/*\" -> Tok \"cfg/*\"\nuse t = fromT t\n"),
    expectTrue
      (claimAccepts
        "ok h =\n  let t = Tok h [h]\n  t\nuse : Unit -> Tok \"cfg/*\"\nuse _ = ok (H \"cfg/a\")\n"),
    -- an unsigned forwarder of an abstract phantom head publishes the top
    expectTrue (claimAccepts "any : Unit -> Raw *\nany _ = mkRaw 3\n"),
    expectFalse
      (claimAccepts "forge : Unit -> Raw \"cfg/*\"\nforge _ = mkRaw 3\n"),
    -- a record read cannot open an imported existential either
    expectFalse
      (claimAccepts "unseal : SealedR -> H \"cfg/*\"\nunseal s = s.h\n"),
    expectTrue (claimAccepts "count : SealedR -> Int\ncount s = s.k\n"),
  ]

test "a signature's index publishes as written; impl heads abstract over an index and dispatch" = expectAll
  [
    expectEqual
      "Unit -> List (H p)"
      (schemeOf (handle ++ "none : Unit -> List (H p)\nnone _ = []\n") "none"),
    expectTrue
      (accepts
        (handle
          ++ "none : Unit -> List (H p)\nnone _ = []\nuse : Unit -> List (H \"cfg/*\")\nuse _ = none ()\n")),
    -- a return-position method at an indexed head, and a two-parameter interface
    expectTrue
      (accepts
        (raw
          ++ "interface Make a where\n  make : Int -> a\nimpl Make (Raw p) where\n  make n = Raw n\nforge : Unit -> Raw \"cfg/*\"\nforge _ = make 3\n")),
    expectTrue
      (accepts
        (raw
          ++ "interface Conv a b where\n  conv : a -> b\nimpl Conv (Raw p) Int where\n  conv _ = 1\nuse : Raw \"cfg/a\" -> Int\nuse b = conv b\n")),
    -- an impl head takes a name in an `Authority` slot, never a written term
    expectTrue
      (accepts
        (handle
          ++ "interface Describe a where\n  describe : a -> String\nimpl Describe (H p) where\n  describe _ = \"h\"\nuse : H \"cfg/*\" -> String\nuse h = describe h\n")),
    expectTrue
      (contains
        "T-AUTHORITY-KIND"
        (codes
          (handle
            ++ "interface Describe a where\n  describe : a -> String\nimpl Describe (H \"cfg/*\") where\n  describe _ = \"h\"\n"))),
    expectTrue
      (contains
        "T-AUTHORITY-KIND"
        (codes
          (handle
            ++ "interface Describe a where\n  describe : a -> String\nimpl Describe (H *) where\n  describe _ = \"h\"\n"))),
  ]

test "an existential record: a read is the top, an update repacks the binder whole or not at all" = expectAll
  [
    expectEqual
      "RU q -> String"
      (schemeOf
        (handle
          ++ "data RU (q : Authority Store) = RU (p : Authority Store) { a : String @p, b : String @q }\ngetA r = r.a\n")
        "getA"),
    expectEqual
      "RU q -> String @q"
      (schemeOf
        (handle
          ++ "data RU (q : Authority Store) = RU (p : Authority Store) { a : String @p, b : String @q }\ngetB r = r.b\n")
        "getB"),
    expectTrue
      (contains
        "T-AUTHORITY-EXISTENTIAL-SCOPE"
        (codes
          (handle
            ++ "data Two = Two (p : Authority Store) { a : H p, b : H p }\nf t = { t | a = H \"/etc/x\" }\n"))),
    expectTrue
      (accepts
        (handle
          ++ "data Two = Two (p : Authority Store) { a : H p, b : H p }\nf t = { t | a = H \"/etc/x\", b = H \"/etc/x\" }\n")),
    expectTrue
      (accepts
        (handle
          ++ "data Two = Two (p : Authority Store) { a : H p, n : Int }\nf t = { t | n = 2 }\n")),
    expectTrue
      (contains
        "T-AUTHORITY-ESCAPE"
        (codes
          (handle
            ++ "data SealedR = SealedR (p : Authority Store) { h : H p, k : Int }\nunsealP (SealedR { h }) = h\n"))),
  ]

-- The line a diagnostic is located at, in the source AFTER the six-line
-- prelude: a report at the site that matters, not at the walk's last leaf.
errorLines : String -> List Int
errorLines source =
  let (errors, _) = checkOneDiags [] [] (
    "authority",
    desugar (parseLocated (prelude ++ source)),
  )
  map diagLine errors

diagLine : TcDiag -> Int
diagLine (TcDiag _ _ (Some (Loc _ line _ _ _)) _ _ _) = line - 6
diagLine _ = 0

test "the review's S2 findings: one domain per binder, the offending site, distinct axes, a Set-first literal, a signature's own span" = expectAll
  [
    -- an index binder used at a second domain is reported, as a named one is
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes (handle ++ "two : H p -> <Var p> Int\ntwo (H s) = load s\n"))),
    expectTrue
      (accepts (handle ++ "one : H p -> <Store p> Int\none (H s) = load s\n")),
    -- two sites perform the label; the report lands on the one outside the
    -- bound (line 4), not the first (line 3)
    expectEqual
      [4]
      (errorLines
        "twice : Unit -> <Store \"cfg/*\"> Int\ntwice _ =\n  let _ = load \"cfg/a\"\n  load \"/etc/x\"\n"),
    -- a Product label's axes are distinct
    expectTrue
      (contains
        "T-EFFECT-PARAM"
        (codes "effect Dup Product (Host : Prefix, Host : Set)\n")),
    expectTrue (accepts "effect Two Product (Host : Prefix, Method : Set)\n"),
    -- a bare literal lifts into a Set first axis as a one-element set
    expectTrue
      (accepts
        ("effect M Product (Method : Set, Host : Prefix)\n"
          ++ "extern call : (m : String) -> <M m> Unit\n"
          ++ "ok : Unit -> <M \"GET\"> Unit\nok _ = call \"GET\"\n")),
    expectFalse
      (accepts
        ("effect M Product (Method : Set, Host : Prefix)\n"
          ++ "extern call : (m : String) -> <M m> Unit\n"
          ++ "bad : Unit -> <M \"GET\"> Unit\nbad _ = call \"POST\"\n")),
    -- a signature's own kind error is located at the signature (line 2)
    expectEqual
      [2]
      (errorLines (handle ++ "f : List p -> H p -> Int\nf _ _ = 1\n")),
  ]

-- The messages a program's diagnostics carry, for a row about wording.
messagesOf : String -> List String
messagesOf source =
  let (errors, _) = checkOneDiags [] [] (
    "authority",
    desugar (parseLocated (prelude ++ source)),
  )
  map tcMsg errors

anyMentions : String -> List String -> Bool
anyMentions needle msgs = anyList (m => S.contains needle m) msgs

test "a qualifier's authority has one domain; a joined qualifier is the join of its names" = expectAll
  [
    -- a qualifier naming an argument that no label or index gives a domain
    -- bounds nothing, and is reported at the qualifier (line 1)
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes "idQ : (a : String) -> String @a\nidQ a = a\n")),
    expectEqual [1] (errorLines "idQ : (a : String) -> String @a\nidQ a = a\n"),
    -- with a label naming it, the qualifier is a bound a caller relies on
    expectTrue
      (accepts
        "idR : (a : String) -> <Store a> String @a\nidR a = a\nuse : (a : String) -> <Store a> Int\nuse a = load (idR a)\n"),
    -- a joined qualifier admits either name, and its caller must admit both
    expectTrue
      (accepts
        "pick : (a : String) -> (b : String) -> Bool -> <Store a, Store b> String @(a | b)\npick a b c = if c then a else b\nboth : (a : String) -> (b : String) -> <Store a, Store b> Int\nboth a b = load (pick a b True)\n"),
    expectTrue
      (rejects
        "pickA : (a : String) -> (b : String) -> Bool -> <Store a, Store b> String @a\npickA a b c = if c then a else b\n"),
    expectTrue
      (rejects
        "pick : (a : String) -> (b : String) -> Bool -> <Store a, Store b> String @(a | b)\npick a b c = if c then a else b\nonly : (a : String) -> <Store a> Int\nonly a = load (pick a \"/etc/x\" True)\n"),
    -- a join is within one domain
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes
          "mix : (a : String) -> (b : String) -> <Store a, Var b> String @(a | b)\nmix a b = a\n")),
    -- a field joined over two parameters carries neither alone
    expectTrue
      (accepts
        "data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\nrd : Two p q -> <Store p, Store q> Int\nrd (Two s) = load s\n"),
    expectTrue
      (rejects
        "data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\nrd : Two p q -> <Store p> Int\nrd (Two s) = load s\n"),
    expectTrue
      (contains
        "T-AUTHORITY-PHANTOM-EXPORT"
        (codes
          "public export data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\n")),
  ]

test "an effect declaration and an authority kind are located, and an atomic label has no authorities" = expectAll
  [
    -- the axis diagnostics land on the declaration (line 1), not on whatever
    -- span the module's last inferred expression left (line 3)
    expectEqual [1] (errorLines "effect P Product\nx : Int\nx = 1\n"),
    expectTrue (accepts "x : Int\nx = 1\neffect P Product (Host : Prefix)\n"),
    -- `Authority L` ranges over L's domain, so an atomic L is refused at the label
    expectEqual
      [2]
      (errorLines "effect Beep\ndata B (p : Authority Beep) = B Int\n"),
    expectTrue
      (contains
        "T-AUTHORITY-KIND"
        (codes "data I (p : Authority IO) = I Int\n")),
    expectTrue (accepts "data S (p : Authority Store) = S Int\n"),
  ]

test "an index is an equality, reported once as one; an opened authority is named as what it is" = expectAll
  [
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (codes (handle ++ "f : H \"a/*\" -> H \"b/*\"\nf h = h\n")),
    -- containment is not equality at an index
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (codes (handle ++ "g : H \"a/x\" -> H \"a/*\"\ng h = h\n")),
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (codes (handle ++ "k : H p -> H \"a/*\"\nk h = h\n")),
    expectTrue (accepts (handle ++ "e : H \"a/*\" -> H \"a/*\"\ne h = h\n")),
    expectTrue (accepts (handle ++ "v : H p -> H p\nv h = h\n")),
    -- an opened existential is the authority of the opened value, not a
    -- caller's choice
    expectTrue
      (anyMentions
        "this arm or clause opened"
        (messagesOf
          (handle
            ++ "data AnyH = AnyH (p : Authority Store) (H p)\nsameAs : H p -> String @p -> Int\nsameAs _ _ = 1\nm (AnyH h) = sameAs h \"cfg/x\"\n"))),
    expectTrue
      (accepts
        (handle
          ++ "data AnyH = AnyH (p : Authority Store) (H p)\nsameAs : H p -> String @p -> Int\nsameAs _ _ = 1\npathOf : H p -> String @p\npathOf (H s) = s\nm (AnyH h) = sameAs h (pathOf h)\n")),
    expectFalse
      (anyMentions
        "this arm or clause opened"
        (messagesOf
          "sneaky : (p : String) -> <Store p> Int\nsneaky p = load \"/etc/x\"\n")),
  ]

-- #3327: a forward reference to an `(e : Effect)` head kinds the same in
-- either declaration order, and a genuinely mis-kinded use is reported at
-- the declaration that makes it, in either order.
test "a forward-referenced Effect-kinded head kinds the same in either order (#3327)" = expectAll
  [
    expectTrue
      (accepts
        "data W (e : Effect) = WUntil Int (Timer e)\ndata Timer (e : Effect) = Timer (Unit -> <e> Int)\nmk : Int -> W <Store | e>\nmk t = WUntil t (Timer (u => load \"cfg/x\"))\n"),
    expectTrue
      (accepts
        "data Timer (e : Effect) = Timer (Unit -> <e> Int)\ndata W (e : Effect) = WUntil Int (Timer e)\nmk : Int -> W <Store | e>\nmk t = WUntil t (Timer (u => load \"cfg/x\"))\n"),
    expectEqual
      [1]
      (errorLines
        "data Bad a = Bad (Timer a)\ndata Timer (e : Effect) = Timer (Unit -> <e> Int)\n"),
    expectEqual
      [2]
      (errorLines
        "data Timer (e : Effect) = Timer (Unit -> <e> Int)\ndata Bad a = Bad (Timer a)\n"),
  ]

-- #3304: a label re-exported through a member list arrives with its
-- declaring identity, as through a wildcard; a list that does not name the
-- label does not carry it.
reexportCodes : String -> String -> List String
reexportCodes facade body =
  flatMap
    moduleCodes
    (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
      (
        "eff",
        desugar
          (parseLocated
            "export effect Logging\nexport doLog : Int -> <Logging> Int\ndoLog x = x + 1\n"),
      ),
      ("facade", desugar (parseLocated facade)),
      ("entry", desugar (parseLocated body)),
    ])

test "an effect label crosses a member-list re-export with its identity (#3304)" = expectAll
  [
    expectEqual
      []
      (reexportCodes
        "export import eff.{Logging, doLog}\n"
        "import facade.{Logging, doLog}\nact : Int -> <Logging> Int\nact x = doLog x\n"),
    expectEqual
      []
      (reexportCodes
        "export import eff.*\n"
        "import facade.{Logging, doLog}\nact : Int -> <Logging> Int\nact x = doLog x\n"),
    expectFalse
      (isEmptyList
        (reexportCodes
          "export import eff.{doLog}\n"
          "import facade.{doLog}\nact : Int -> <> Int\nact x = doLog x\n")),
  ]

isEmptyList : List a -> Bool
isEmptyList [] = True
isEmptyList _ = False

-- The whole-diff review's findings, each beside its control.
test "a joined field is built against written indices, a join of one name carries it, a non-String name is refused" = expectAll
  [
    -- built against written indices, a value in `@(p | q)` must lie within
    -- their join (the Prefix join is the longest common prefix, "cfg/*")
    -- with inferred indices a join upper has no principal solution, so the
    -- construction is refused (a completeness gap the handoff lists)
    expectFalse
      (accepts
        "data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\nmk = Two \"cfg/x\"\n"),
    expectFalse
      (accepts
        "data AnyJ = AnyJ (p : Authority Store) (q : Authority Store) (String @(p | q))\nmk = AnyJ \"/etc/x\"\n"),
    expectTrue
      (accepts
        "data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\nmk : Unit -> Two \"cfg/a/*\" \"cfg/b/*\"\nmk _ = Two \"cfg/b/x\"\n"),
    expectFalse
      (accepts
        "data Two (p : Authority Store) (q : Authority Store) = Two (String @(p | q))\nmk : Unit -> Two \"cfg/a/*\" \"cfg/b/*\"\nmk _ = Two \"/etc/x\"\n"),
    -- `@(p | p)` is `@p`
    expectTrue
      (accepts
        "public export data One (p : Authority Store) = One (String @(p | p))\n"),
    -- a qualifier naming a non-String argument is refused, alone or joined
    expectTrue
      (contains
        "T-AUTHORITY-BINDER"
        (codes
          "g : (a : String) -> (n : Int) -> <Store a> String @(a | n)\ng a n = a\n")),
    expectTrue
      (accepts
        "g : (a : String) -> (b : String) -> <Store a, Store b> String @(a | b)\ng a b = a\n"),
  ]

test "an empty bare literal on a Product label is refused, not read as the whole domain" = expectAll
  [
    expectTrue
      (contains
        "T-EFFECT-PARAM"
        (codes
          ("effect Web Product (Host : Prefix, Method : Set)\n"
            ++ "hit : Int -> <Web Host=\"evil.com/x\"> Int\nhit n = n\n"
            ++ "f : Unit -> <Web \"\"> Int\nf _ = hit 1\n"))),
    expectTrue
      (accepts
        ("effect Web Product (Host : Prefix, Method : Set)\n"
          ++ "hit : Int -> <Web Host=\"a.com/x\"> Int\nhit n = n\n"
          ++ "f : Unit -> <Web \"a.com/*\"> Int\nf _ = hit 1\n")),
  ]

-- An opened existential cannot leave its arm through the authority solve: a
-- solution for a variable older than the arm widens it to the domain's top,
-- so the unsigned reader publishes the top and a caller admitting only
-- "cfg/*" is refused (as a row leak, which `rejects` does not count).
escapeByIndex : String
escapeByIndex =
  handle
    ++ "data E1 = E1 (p : Authority Store) (String @p)\n"
    ++ "pack : Unit -> E1\npack _ = E1 \"/etc/x\"\n"
    ++ "both : H p -> String @p -> <Store p> Int\nboth _ b = load b\n"
    ++ "peek h e = match e\n  E1 s => both h s\n"

-- the route through a row: the arm's instantiation of `run1`'s binder
-- reaches the clause parameter `f` only in an atom of its row
escapeByRow : String
escapeByRow =
  "data E1 = E1 (p : Authority Store) (String @p)\n"
    ++ "pack : Unit -> E1\npack _ = E1 \"/etc/x\"\n"
    ++ "run1 : (x : String) -> (Unit -> <Store x> Int) -> <Store x> Int\n"
    ++ "run1 x g =\n  let _ = g ()\n  load x\n"
    ++ "peek f e = match e\n  E1 s => run1 s f\n"

escapeByJoin : String
escapeByJoin =
  "data E (q : Authority Store) = E (p : Authority Store) (String @(p | q))\n"
    ++ "peek (E s) = load s\n"

test "an opened authority does not escape through the solve of an older variable" = expectAll
  [
    expectFalse
      (accepts
        (escapeByIndex
          ++ "only : Unit -> <Store \"cfg/*\"> Int\nonly _ = peek (H \"cfg/a\") (pack ())\n")),
    expectTrue
      (accepts
        (escapeByIndex
          ++ "anyAt : String -> H *\nanyAt s = H s\nwide : String -> <Store> Int\nwide x = peek (anyAt x) (pack ())\n")),
    expectFalse
      (accepts
        (escapeByJoin
          ++ "only : E \"cfg/*\" -> <Store \"cfg/*\"> Int\nonly e = peek e\n")),
    expectTrue
      (accepts
        (escapeByJoin ++ "wide : E q -> <Store> Int\nwide e = peek e\n")),
    expectFalse
      (accepts
        (escapeByRow
          ++ "only : Unit -> <Store \"cfg/*\"> Int\nonly _ = peek (_ => load \"cfg/a\") (pack ())\n")),
    expectTrue
      (accepts
        (escapeByRow
          ++ "wide : Unit -> <Store> Int\nwide _ = peek (_ => 1) (pack ())\n")),
  ]

-- #3462 (a): an unsigned binding keeps the obligations between its own
-- quantified authorities (and constants) as residuals of its scheme; every
-- use re-emits them under that use's instantiation.  Each refusal beside the
-- control that satisfies the same relation.
residualHead : String
residualHead =
  "data Dir (d : Authority Store) = Dir (String @d)\n"
    ++ "mk : (s : String) -> Dir s\nmk s = Dir s\n"
    ++ "sub : Dir d -> (p : String @d) -> Dir d\nsub h _ = h\n"
    ++ "cfg : Dir \"cfg/*\"\ncfg = mk \"cfg/*\"\n"
    ++ "app : Dir \"cfg/app\"\napp = mk \"cfg/app\"\n"
    ++ "etc : Dir \"/etc/x\"\netc = mk \"/etc/x\"\n"
    ++ "subIn h (Dir p) = sub h p\n"
    ++ "rdSub h (Dir p) =\n  let _ = sub h p\n  load p\n"

residual : String -> String
residual body = residualHead ++ body

test "a residual relates two quantified authorities and is checked at each use" = expectAll
  [
    expectEqual
      "(a <= d) => Dir d -> Dir a -> Dir d"
      (schemeOf residualHead "subIn"),
    expectEqual
      "(a <= d) => Dir d -> Dir a -> <Store a> Int"
      (schemeOf residualHead "rdSub"),
    expectTrue (accepts (residual "use _ = subIn cfg app\n")),
    expectTrue (rejects (residual "use _ = subIn cfg etc\n")),
    expectTrue (rejects (residual "use _ = subIn app cfg\n")),
    expectTrue
      (accepts
        (residual
          "cap : Unit -> <Store \"cfg/app\"> Int\ncap _ = rdSub cfg app\n")),
    expectFalse
      (accepts
        (residual
          "cap : Unit -> <Store \"cfg/*\"> Int\ncap _ = rdSub cfg etc\n")),
  ]

test "a residual names the binding whose scheme carried it" =
  expectTrue
    (anyList
      (m => S.contains "'subIn' needs" m)
      (messagesOf (residual "use _ = subIn cfg etc\n")))

test "a residual may bound a variable by a join of two others" = expectAll [
  expectEqual
    "(d <= (a | b)) => Dir a -> Dir b -> Dir d -> Dir a"
    (schemeOf
      (residual
        "sub2 : Dir a -> Dir b -> String @(a | b) -> Dir a\nsub2 h _ _ = h\neither h1 h2 (Dir p) = sub2 h1 h2 p\n")
      "either"),
  expectTrue
    (accepts
      (residual
        "sub2 : Dir a -> Dir b -> String @(a | b) -> Dir a\nsub2 h _ _ = h\neither h1 h2 (Dir p) = sub2 h1 h2 p\nuse _ = either cfg etc app\n")),
  expectTrue
    (rejects
      (residual
        "sub2 : Dir a -> Dir b -> String @(a | b) -> Dir a\nsub2 h _ _ = h\neither h1 h2 (Dir p) = sub2 h1 h2 p\nuse _ = either cfg cfg etc\n")),
]

test "a residual may relate a quantified authority to a constant" = expectAll [
  expectEqual
    "(\"cfg/app\" <= d) => Dir d -> Dir d"
    (schemeOf (residual "withApp h = sub h \"cfg/app\"\n") "withApp"),
  expectTrue
    (accepts (residual "withApp h = sub h \"cfg/app\"\nuse _ = withApp cfg\n")),
  expectTrue
    (rejects (residual "withApp h = sub h \"cfg/app\"\nuse _ = withApp etc\n")),
  expectEqual
    "(d <= \"cfg/*\") => Dir d -> Dir \"cfg/*\""
    (schemeOf (residual "inCfg (Dir p) = sub cfg p\n") "inCfg"),
  expectTrue
    (accepts (residual "inCfg (Dir p) = sub cfg p\nuse _ = inCfg app\n")),
  expectTrue
    (rejects (residual "inCfg (Dir p) = sub cfg p\nuse _ = inCfg etc\n")),
]

test "a local binding keeps its residuals like a top-level one" = expectAll [
  expectTrue
    (accepts
      (residual
        "outer _ =\n  let inner h (Dir p) = sub h p\n  inner cfg app\n")),
  expectTrue
    (rejects
      (residual
        "outer _ =\n  let inner h (Dir p) = sub h p\n  inner cfg etc\n")),
  expectTrue
    (accepts (residual "outer _ =\n  let inner = subIn\n  inner cfg app\n")),
  expectTrue
    (rejects (residual "outer _ =\n  let inner = subIn\n  inner cfg etc\n")),
]

test "a signature cannot yet state a residual, so it stays refused" = expectAll
  [
    expectTrue
      (rejects
        (residual
          "subInS : Dir d -> Dir q -> Dir d\nsubInS h (Dir p) = sub h p\n")),
    expectTrue
      (accepts
        (residual
          "subInS : Dir d -> Dir d -> Dir d\nsubInS h (Dir p) = sub h p\n")),
  ]

residualModuleCodes : String -> List String
residualModuleCodes body =
  flatMap
    moduleCodes
    (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
      (
        "dirs",
        desugar
          (parseLocated
            ("public export data Dir (d : Authority Store) = Dir (String @d)\n"
              ++ "export\nmk : (s : String) -> Dir s\nmk s = Dir s\n"
              ++ "sub : Dir d -> (p : String @d) -> Dir d\nsub h _ = h\n"
              ++ "export\nsubIn h (Dir p) = sub h p\n")),
      ),
      (
        "entry",
        desugar (parseLocated ("import dirs.{Dir(..), mk, subIn}\n" ++ body)),
      ),
    ])

-- The handle is pinned by a signature: `mk "cfg/*"` alone is a handle at a
-- flexible index, which the residual would honestly raise to the join.
test "a residual crosses a module boundary with its scheme" = expectAll [
  expectEqual
    []
    (residualModuleCodes
      "cfg : Dir \"cfg/*\"\ncfg = mk \"cfg/*\"\nuse _ = subIn cfg (mk \"cfg/app\")\n"),
  expectTrue
    (contains
      "T-AUTHORITY"
      (residualModuleCodes
        "cfg : Dir \"cfg/*\"\ncfg = mk \"cfg/*\"\nuse _ = subIn cfg (mk \"/etc/x\")\n")),
]

-- Review round 1 on #3462.  A local helper that uses a captured handle keeps
-- its obligation against the enclosing authority as a residual naming it as
-- it stands; a partial application the value restriction keeps monomorphic
-- owes its instance where it is used; a quantified authority bounded below by
-- the domain's top has no freedom and is solved to it.
test "a residual may name an authority outside the binding's scope" = expectAll
  [
    expectTrue
      (rejects
        (residual
          "via h s =\n  let inner (Dir p) = sub h p\n  inner s\nuse _ = via cfg etc\n")),
    expectTrue
      (accepts
        (residual
          "via h s =\n  let inner (Dir p) = sub h p\n  inner s\nuse _ = via cfg app\n")),
    expectEqual
      "(a <= d) => Dir d -> Dir a -> Dir d"
      (schemeOf
        (residual "via h s =\n  let inner (Dir p) = sub h p\n  inner s\n")
        "via"),
  ]

test "a monomorphic binding owes its residuals where it is used" = expectAll [
  expectTrue (accepts (residual "outer _ =\n  let p = subIn cfg\n  p app\n")),
  expectTrue (rejects (residual "outer _ =\n  let p = subIn cfg\n  p etc\n")),
  expectTrue (accepts (residual "partial = subIn cfg\nuse _ = partial app\n")),
]

-- A variable nothing bounds below takes its least solution, the empty
-- authority, which every bound admits (review round 2).  The control feeds
-- the same cell a value outside the bound.
test "a variable nothing bounds below takes the empty authority" = expectAll [
  expectTrue (accepts (residual "partial = subIn cfg\n")),
  expectTrue (accepts (residual "outer _ =\n  let p = subIn cfg\n  0\n")),
  expectTrue
    (accepts
      (residual
        "each f xs = match xs\n  [] => []\n  x :: r => f x :: each f r\nnone _ = each (subIn cfg) []\n")),
  expectTrue (rejects (residual "partial = subIn cfg\nuse _ = partial etc\n")),
  expectEqual
    "Dir {} -> Dir \"cfg/*\""
    (schemeOf (residual "partial = subIn cfg\n") "partial"),
  expectEqual
    "a -> <Store {}> List Int"
    (schemeOf
      (residual
        "each f xs = match xs\n  [] => []\n  x :: r => f x :: each f r\nnone _ = each (rdSub cfg) []\n")
      "none"),
]

-- An obligation naming a universal is decided in the universal's own scope:
-- handed outward with a monomorphic sibling's authority, the root would solve
-- the universal as a flexible variable and admit a read outside it (review
-- round 2).  The control widens the declared row to the whole label.
test "an obligation over a universal never leaves its scope" = expectAll [
  expectTrue
    (rejects
      (residual
        "readAt p = load p\nsecond a b = b\ng = second f readAt\nf : Dir d -> <Store d> Int\nf _ = g \"/tmp/x\"\n")),
  expectTrue
    (accepts
      (residual
        "readAt p = load p\nsecond a b = b\ng = second f readAt\nf : Dir d -> <Store> Int\nf _ = g \"/tmp/x\"\n")),
]

-- A monomorphic cell is outside the group that uses it: two members may each
-- owe a relation to it, and each keeps its own residual rather than linking
-- the two members' variables into one component (review round 2).
test "two members may each owe a residual to one monomorphic cell" =
  let group =
    "second a b = b\nh0 = second (q1, q2) cfg\nq1 (Dir p) = sub h0 p\nq2 (Dir p) = sub h0 p\n"
  expectAll [
    expectEqual
      "(d <= \"cfg/*\") => Dir d -> Dir \"cfg/*\""
      (schemeOf (residual group) "q1"),
    expectTrue (accepts (residual (group ++ "use _ = q1 app\n"))),
    expectTrue (rejects (residual (group ++ "use _ = q1 etc\n"))),
  ]

-- A relation another member of a recursive group would quantify with no
-- context is decided in the group: here the first solve links `q1`'s
-- authority to `q2`'s, and a residual on one member would leave the other a
-- launder (review round 3).  The control is the same body recursing on
-- itself, which keeps its residual.
test "a recursive group decides a relation two members' schemes share" = expectAll
  [
    expectTrue
      (rejects
        (residual
          "q1 n (Dir p) = if n then sub cfg p else q2 False (Dir p)\nq2 n (Dir p) = q1 n (Dir p)\n")),
    expectEqual
      "(d <= \"cfg/*\") => Bool -> Dir d -> Dir \"cfg/*\""
      (schemeOf
        (residual "q1 n (Dir p) = if n then sub cfg p else q1 False (Dir p)\n")
        "q1"),
    expectTrue
      (accepts
        (residual
          "q1 n (Dir p) = if n then sub cfg p else q1 False (Dir p)\nuse _ = q1 True app\n")),
    expectTrue
      (rejects
        (residual
          "q1 n (Dir p) = if n then sub cfg p else q1 False (Dir p)\nuse _ = q1 True etc\n")),
  ]

-- An exported binding the value restriction keeps monomorphic, whose type
-- holds an authority nothing in its module bounds below, is refused: an
-- importer cannot supply it later.  A private one takes the empty
-- authority; a use in the module, or a signature, determines it.
libCodes : String -> List String
libCodes body =
  flatMap
    (m => match m
      (_, (_, errors, _)) => map tcCode errors)
    (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
      (
        "lib",
        desugar
          (parseLocated
            ("public export data Dir (d : Authority Store) = Dir (String @d)\n"
              ++ "mk : (s : String) -> Dir s\nmk s = Dir s\n"
              ++ "sub : Dir d -> (p : String @d) -> Dir d\nsub h _ = h\n"
              ++ "cfg : Dir \"cfg/*\"\ncfg = mk \"cfg/*\"\n"
              ++ "app : Dir \"cfg/app\"\napp = mk \"cfg/app\"\n"
              ++ "subIn h (Dir p) = sub h p\n"
              ++ body)),
      ),
    ])

test "an exported authority nothing in its module determines is refused" = expectAll
  [
    expectEqual
      ["T-EXPORT-UNSOLVED-AUTHORITY"]
      (libCodes "export\npartial = subIn cfg\n"),
    expectEqual [] (libCodes "partial = subIn cfg\n"),
    expectEqual
      ["T-EXPORT-UNSOLVED-AUTHORITY"]
      (libCodes "export\npartial = subIn cfg\nexport\nwrap x = partial x\n"),
    expectEqual
      []
      (libCodes "export\npartial = subIn cfg\nuse _ = partial app\n"),
    expectEqual
      []
      (libCodes
        "export\npartial : Dir \"cfg/app\" -> Dir \"cfg/*\"\npartial = subIn cfg\n"),
  ]

-- A `where` block is checked one dependency component at a time (#3487), so
-- a helper a sibling only calls is generalized first and keeps its residual;
-- the sibling instantiates it.  The launder is the same program fed a handle
-- outside the bound.
test "a where helper a sibling calls keeps its residual" =
  let block =
    "outer h ds = go ds\n  where\n    rd (Dir p) = sub h p\n    go xs = match xs\n      [] => []\n      d :: rest => rd d :: go rest\n"
  expectAll [
    expectTrue (accepts (residual (block ++ "use _ = outer cfg [app]\n"))),
    expectTrue (rejects (residual (block ++ "use _ = outer cfg [etc]\n"))),
  ]

test "an authority bounded below by the top is solved, not kept" =
  expectEqual
    "Bool -> String -> String -> Dir * -> Dir *"
    (schemeOf
      (residual "pickPath c a b h = sub h (if c then a else b)\n")
      "pickPath")

aliasResidualLine : Option Int
aliasResidualLine =
  let diags =
    flatMap
      (m => match m
        (_, (_, errors, _)) => errors)
      (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
        (
          "dirs",
          desugar
            (parseLocated
              ("public export data Dir (d : Authority Store) = Dir (String @d)\n"
                ++ "export\nmk : (s : String) -> Dir s\nmk s = Dir s\n"
                ++ "sub : Dir d -> (p : String @d) -> Dir d\nsub h _ = h\n"
                ++ "export\nsubIn h (Dir p) = sub h p\n")),
        ),
        (
          "entry",
          desugar
            (parseLocated
              ("import dirs as D\n"
                ++ "cfg : D.Dir \"cfg/*\"\ncfg = D.mk \"cfg/*\"\n"
                ++ "etc : D.Dir \"/etc/x\"\netc = D.mk \"/etc/x\"\n"
                ++ "use _ = D.subIn cfg etc\n")),
        ),
      ])
  match filter (d => S.contains "needs" (tcMsg d)) diags
    (TcDiag _ _ (Some (Loc _ line _ _ _)) _ _ _) :: _ => Some line
    _ => None

test "an alias-qualified occurrence is located at its own name" =
  expectEqual (Some 6) aliasResidualLine

-- A concatenation denotes its left operand plus the suffix. An exact element
-- admits only itself, so an unknown suffix extends it to the pattern it
-- begins and a known one is appended; a pattern already admits both.
test "a concatenation extends an exact prefix; a literal suffix is appended" = expectAll
  [
    expectFalse
      (accepts
        "bad : String -> <Store \"cfg/\"> Int\nbad x = load (\"cfg/\" ++ x)\n"),
    expectTrue
      (accepts
        "ok : String -> <Store \"cfg/*\"> Int\nok x = load (\"cfg/\" ++ x)\n"),
    expectFalse
      (accepts
        "bad : String -> <Store \"cfg/\"> Int\nbad x =\n  let p = \"cfg/\" ++ x\n  load p\n"),
    expectTrue
      (accepts
        "ok : Unit -> <Store \"cfg/app.toml\"> Int\nok _ = load (\"cfg/\" ++ \"app\" ++ \".toml\")\n"),
    expectFalse
      (accepts
        "bad : Unit -> <Store \"cfg/app.toml\"> Int\nbad _ = load (\"cfg/\" ++ \"app\")\n"),
    expectTrue
      (accepts
        "ok : String -> <Store \"cfg/*\"> Int\nok x = load ((\"cfg/\" ++ x) ++ \".toml\")\n"),
    expectEqual
      "String -> <Store \"cfg/*\"> Int"
      (schemeOf "f x = load (\"cfg/\" ++ x)\n" "f"),
  ]

test "a concatenation extends a Product's primary axis; a literal chain is a literal" = expectAll
  [
    expectFalse
      (accepts
        ("effect Web Product (Host : Prefix, Method : Set)\n"
          ++ "extern call : (u : String) -> <Web u> Unit\n"
          ++ "bad : String -> <Web \"a.com/x\"> Unit\nbad s = call (\"a.com/x\" ++ s)\n")),
    expectTrue
      (accepts
        ("effect Web Product (Host : Prefix, Method : Set)\n"
          ++ "extern call : (u : String) -> <Web u> Unit\n"
          ++ "ok : String -> <Web \"a.com/*\"> Unit\nok s = call (\"a.com/\" ++ s)\n")),
    expectTrue
      (accepts
        ("effect M Product (Method : Set, Host : Prefix)\n"
          ++ "extern call : (m : String) -> <M m> Unit\n"
          ++ "ok : Unit -> <M \"GET\"> Unit\nok _ = call (\"GE\" ++ \"T\")\n")),
    expectFalse
      (accepts
        ("effect M Product (Method : Set, Host : Prefix)\n"
          ++ "extern call : (m : String) -> <M m> Unit\n"
          ++ "bad : String -> <M \"GET\"> Unit\nbad s = call (\"GE\" ++ s)\n")),
  ]

-- A label whose every axis an argument names, for the tests below.
httpPrelude : String
httpPrelude =
  "effect Http Product (Host : Prefix, Method : Set)\n"
    ++ "extern request : (host : String) -> (method : String) -> <Http Host=host Method=method> Int\n"
    ++ "extern whole : (u : String) -> <Http u> Int\n"

test "every axis takes a binder: each argument is charged on its own axis" = expectAll
  [
    expectTrue
      (accepts
        (httpPrelude
          ++ "get : Unit -> <Http Host=\"a.com/*\" Method={\"GET\"}> Int\nget _ = request \"a.com/x\" \"GET\"\n")),
    expectFalse
      (accepts
        (httpPrelude
          ++ "get : String -> <Http Host=\"a.com/*\" Method={\"GET\"}> Int\nget m = request \"a.com/x\" m\n")),
    expectTrue
      (accepts
        (httpPrelude
          ++ "fwd : (host : String) -> (method : String) -> <Http Host=host Method=method> Int\nfwd host method = request host method\n")),
    expectTrue
      (rejects
        (httpPrelude
          ++ "swap : (host : String) -> (method : String) -> <Http Host=host Method=method> Int\nswap host method = request method host\n")),
    expectEqual
      "(host : String) -> (method : String) -> <Http Host=host Method=method> Int"
      (schemeOf httpPrelude "request"),
  ]

test "an axis variable extends to its axis's top; a whole-domain binder is no axis's" = expectAll
  [
    -- `host ++ "/x"` may leave what the caller's exact host admits
    expectTrue
      (rejects
        (httpPrelude
          ++ "under : (host : String) -> (method : String) -> <Http Host=host Method=method> Int\nunder host method = request (host ++ \"/x\") method\n")),
    -- unless the host ranges over patterns of the primary axis (#3620)
    expectTrue
      (accepts
        (httpPrelude
          ++ "under : (host : String @Http*) -> (method : String) -> <Http Host=host Method=method> Int\nunder host method = request (host ++ \"/v1\") method\n")),
    expectTrue
      (accepts
        (httpPrelude
          ++ "lit : String -> <Http Host=\"a.com/*\" Method={\"GET\"}> Int\nlit s = request (\"a.com/\" ++ s) \"GET\"\n")),
    -- `u` is an element of the whole Product domain, so on the Host axis its
    -- value is that axis's top
    expectTrue
      (rejects
        (httpPrelude
          ++ "via : (u : String) -> (method : String) -> <Http u> Int\nvia u method = request u method\n")),
    -- one binder at an axis and at a label of another domain
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes
          (httpPrelude
            ++ "extern two : (m : String) -> <Http Method=m, Store m> Int\n"))),
  ]

-- #3501 and #3502: an authority variable may stand for an exact element,
-- which admits only itself, so appending to it reaches the whole domain. The
-- signature's own variable is refused at the definition, and a flexible one
-- still unbound when the arm is inferred is charged the whole domain.
test "an extension of an authority variable is the whole domain" = expectAll
  [
    expectEqual
      ["T-AUTHORITY"]
      (codes
        "readUnder : (p : String) -> String -> <Store p> Int\nreadUnder p suffix = load (p ++ suffix)\nonlyApp : Unit -> <Store \"cfg/app.toml\"> Int\nonlyApp _ = readUnder \"cfg/app.toml\" \".bak\"\n"),
    expectTrue
      (accepts
        "readUnder : (p : String) -> String -> <Store p> Int\nreadUnder p _ = load p\nonlyApp : Unit -> <Store \"cfg/app.toml\"> Int\nonlyApp _ = readUnder \"cfg/app.toml\" \".bak\"\n"),
    -- the pattern-ranging sibling (#3620): the extension stays within `p`, and
    -- the caller is charged the pattern its exact element begins
    expectTrue
      (accepts
        "readUnder : (p : String @Store*) -> String -> <Store p> Int\nreadUnder p suffix = load (p ++ suffix)\ncfg : Unit -> <Store \"cfg/*\"> Int\ncfg _ = readUnder \"cfg/\" \"app.toml\"\n"),
    expectTrue
      (accepts
        (handleP
          ++ "readH : H d -> String -> <Store d> Int\nreadH (H p) x = load (p ++ x)\n")),
    expectEqual
      ["T-AUTHORITY"]
      (codes
        (handle
          ++ "readH : H d -> String -> <Store d> Int\nreadH (H p) x = load (p ++ x)\n")),
    expectEqual
      ["T-EFFECT-LEAK"]
      (codes
        (handle
          ++ "readAny : String -> <Store \"/etc\"> Int\nreadAny x = match H \"/etc\"\n  H p => load (p ++ x)\n")),
    expectTrue
      (accepts
        (handle
          ++ "readAny : String -> <Store \"/etc\"> Int\nreadAny x = match H \"/etc\"\n  H p => load p\n")),
  ]

-- A named argument may write its domain, `(dir : String @Store)`, so a helper
-- that performs nothing can return a value at the argument's authority. The
-- domain belongs to the binder; the argument's type stays `String` (#3559).
test "a binder's written domain gives a qualifier a domain and charges nothing" = expectAll
  [
    expectTrue
      (accepts
        "same : (dir : String @Store) -> String @dir\nsame dir = dir\nuse : (a : String) -> <Store a> Int\nuse a = load (same a)\n"),
    -- the helper forwards its caller's authority, so it cannot launder one
    expectTrue
      (accepts
        "same : (dir : String @Store) -> String @dir\nsame dir = dir\ncfg : Unit -> <Store \"cfg/*\"> Int\ncfg _ = load (same \"cfg/app\")\n"),
    expectFalse
      (accepts
        "same : (dir : String @Store) -> String @dir\nsame dir = dir\ncfg : Unit -> <Store \"cfg/*\"> Int\ncfg _ = load (same \"/etc/x\")\n"),
    expectTrue
      (accepts
        "pick : (a : String @Store) -> (b : String @Store) -> Bool -> String @(a | b)\npick a b c = if c then a else b\n"),
    -- an annotated binder may still be an atom's parameter of its domain
    expectTrue
      (accepts
        "rd : (dir : String @Store) -> <Store dir> Int\nrd dir = load dir\n"),
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes
          "rd : (dir : String @Store) -> <Var dir> Int\nrd dir = lookup dir\n")),
    -- an extension of the argument in a result is still the whole domain
    expectTrue
      (anyMentions
        "reaches the whole domain"
        (messagesOf
          "withSuffix : (dir : String @Store) -> String @dir\nwithSuffix dir = dir ++ \"/index\"\n")),
    -- and the report points at the pattern-ranging spelling (#3574)
    expectTrue
      (anyMentions
        "`(p : String @FileWrite*)`"
        (messagesOf
          "withSuffix : (dir : String @Store) -> String @dir\nwithSuffix dir = dir ++ \"/index\"\n")),
    -- a pattern-ranging binder keeps its authority through the extension
    expectTrue
      (accepts
        "withSuffix : (dir : String @Store*) -> String @dir\nwithSuffix dir = dir ++ \"/index\"\n"),
    -- with no domain written, the qualifier's report names the binder form first
    expectTrue
      (anyMentions
        "Write the domain on the binder, `(a : String @FileRead)`"
        (messagesOf "idQ : (a : String) -> String @a\nidQ a = a\n")),
  ]

test "a Product label's binder domain is its primary axis" = expectAll
  [
    expectTrue
      (accepts
        (httpPrelude
          ++ "hostOf : (host : String @Http) -> String @host\nhostOf host = host\nget : (host : String @Http) -> (m : String) -> <Http Host=host Method=m> Int\nget host m = request (hostOf host) m\n")),
    -- the whole Product is a different domain from its primary axis
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes
          (httpPrelude
            ++ "all : (u : String @Http) -> <Http u> Int\nall u = whole u\n"))),
    -- a Set-first Product's primary axis is a Set
    expectTrue
      (accepts
        "effect M Product (Method : Set, Host : Prefix)\nm : (x : String @M) -> <Var x> Int\nm x = lookup x\n"),
    expectTrue
      (contains
        "T-AUTHORITY-DOMAIN"
        (codes
          "effect M Product (Method : Set, Host : Prefix)\nm : (x : String @M) -> <Store x> Int\nm x = load x\n")),
  ]

test "a binder's written domain needs a String binder and a parameterized label" = expectAll
  [
    expectTrue
      (contains
        "T-AUTHORITY-BINDER"
        (codes "n : (x : Int @Store) -> Int\nn x = x\n")),
    expectTrue
      (contains
        "T-EFFECT-PARAM"
        (codes "n : (x : String @Stdout) -> String @x\nn x = x\n")),
  ]

test "the formatter prints a binder's written domain back" =
  let source =
    "effect Store Prefix\n\nsame : (dir : String @Store) -> String @dir\nsame dir = dir\n"
  expectEqual source (formatSource source)

-- An effect-indexed container sequenced the way a `defer` block sequences
-- `Async` (`deferThen`), so its steps all share one index row, beside a
-- handle carrying a Store authority index.
jobPrelude : String
jobPrelude =
  "data Job (e : Effect) a =\n"
    ++ "  | Done a\n"
    ++ "  | Suspend (Unit -> <e> Job e a)\n"
    ++ "thenJob : Job e a -> (a -> <e> Job e b) -> Job e b\n"
    ++ "thenJob (Done a) k = Suspend (u => k a)\n"
    ++ "thenJob (Suspend t) k = Suspend (u => thenJob (t u) k)\n"
    ++ "data Key (k : Authority Store) = Key (String @k)\n"
    ++ "step : (p : String) -> Job <Store p | e> Int\n"
    ++ "step p = Suspend (u => Done (load p))\n"
    ++ "readKey : Key k -> Job <Store k | e> Int\n"
    ++ "readKey (Key p) = step p\n"
    ++ "varStep : (n : String) -> Job <Var n | e> Int\n"
    ++ "varStep n = Suspend (u => Done (lookup n))\n"

jobCodes : String -> List String
jobCodes source = codes (jobPrelude ++ source)

test "an index row is a set of atoms: one label at two authorities is two atoms" = expectAll
  [
    -- a variable atom and a literal atom, both declared
    expectEqual
      []
      (jobCodes
        "pairA : Key k -> Job <Store k, Store \"cfg/*\" | e> Int\npairA key = thenJob (readKey key) (a => step \"cfg/app\")\n"),
    -- a set-valued handle index and a step at one member
    expectEqual
      []
      (jobCodes
        "pairC : Key (\"cfg/*\" | \"data/*\") -> Job <Store \"cfg/*\", Store \"data/*\" | e> Int\npairC key = thenJob (readKey key) (a => step \"cfg/app\")\n"),
    -- the same literal on both steps
    expectEqual
      []
      (jobCodes
        "pairB : Key \"cfg/*\" -> Job <Store \"cfg/*\" | e> Int\npairB key = thenJob (readKey key) (a => step \"cfg/app\")\n"),
    -- two subtrees of a Prefix set, one step each
    expectEqual
      []
      (jobCodes
        "trees : Unit -> Job <Store \"cfg/*\", Store \"data/*\" | e> Int\ntrees _ = thenJob (step \"cfg/app\") (a => step \"data/x\")\n"),
  ]

test "a precise step under a bare label is covered by it" = expectAll [
  expectEqual
    []
    (jobCodes "bare : Key k -> Job <Store | e> Int\nbare key = readKey key\n"),
  expectEqual
    []
    (jobCodes
      "both : Key k -> Job <Store, Store k | e> Int\nboth key = readKey key\n"),
]

test "sequencing does not solve an authority variable to a literal it meets" =
  expectEqual
    "Key k -> Job <Store \"cfg/app\", Store k | a> Int"
    (schemeOf
      (jobPrelude
        ++ "inferred key = thenJob (readKey key) (a => step \"cfg/app\")\n")
      "inferred")

test "an index row still refuses an atom its declaration does not cover" = expectAll
  [
    -- a literal outside the declared literal
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (jobCodes
        "out : Unit -> Job <Store \"cfg/*\" | e> Int\nout _ = thenJob (step \"cfg/app\") (a => step \"data/x\")\n"),
    -- a third subtree beside the two a Prefix set declares
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (jobCodes
        "third : Unit -> Job <Store \"cfg/*\", Store \"data/*\" | e> Int\nthird _ = thenJob (step \"cfg/app\") (a => thenJob (step \"data/x\") (b => step \"tmp/x\"))\n"),
    -- a handle's authority the row does not declare
    expectEqual
      ["T-AUTHORITY-INDEX-MISMATCH"]
      (jobCodes
        "hide : Key k -> Job <Store \"cfg/*\" | e> Int\nhide key = thenJob (readKey key) (a => step \"cfg/app\")\n"),
    -- a label a closed index does not name
    expectEqual
      ["T-EFFECT-LEAK"]
      (jobCodes
        "closed : Unit -> Job <Store \"cfg/*\"> Int\nclosed _ = thenJob (step \"cfg/app\") (a => varStep \"x\")\n"),
  ]

test "two written index rows must still be equal" = expectAll [
  expectEqual
    ["T-EFFECT-INDEX-MISMATCH"]
    (jobCodes "quiet : Job <Stdout> Int -> Job <> Int\nquiet j = j\n"),
  expectEqual
    ["T-AUTHORITY-INDEX-MISMATCH"]
    (jobCodes
      "narrow : Job <Store \"cfg/*\"> Int -> Job <Store \"data/*\"> Int\nnarrow j = j\n"),
  expectTrue
    (contains
      "T-EFFECT-INDEX-MISMATCH"
      (jobCodes
        "launder : Job <Store \"cfg/*\" | e> Int -> Job e Int\nlaunder j = j\n")),
]

-- #3620: pattern-ranging authority binders. A binder written `@L*` or a
-- parameter of kind `Authority L*` ranges over the patterns of `L`'s domain
-- only, so a value within it extended on the right stays within it.
handleP : String
handleP = "data H (d : Authority Store*) = H (String @d)\n"

dir : String
dir =
  handleP
    ++ "readD : H d -> String -> <Store d> Int\nreadD (H root) x = load (root ++ \"blocks/\" ++ x)\n"

test "a pattern-ranging binder admits a right extension" = expectAll
  [
    expectTrue
      (accepts
        (dir
          ++ "cfg : H \"cfg/*\"\ncfg = H \"cfg/\"\nuse : String -> <Store \"cfg/*\"> Int\nuse x = readD cfg x\n")),
    -- a data index keeps its binder: `sub` returns the directory it was given
    expectTrue
      (accepts
        (dir
          ++ "sub : H d -> String -> H d\nsub (H root) n = H (root ++ n ++ \"/\")\n")),
    expectEqual
      "H d -> String -> H d"
      (schemeOf (dir ++ "sub (H root) n = H (root ++ n)\n") "sub"),
    -- a value-derived exact element closes to the pattern it begins
    expectEqual "H \"cfg/*\"" (schemeOf (dir ++ "d1 = H \"cfg/\"\n") "d1"),
    -- a runtime value is the whole domain, charged as the label bare
    expectTrue
      (accepts
        (dir
          ++ "mk : String -> H *\nmk s = H s\nuse : String -> <Store> Int\nuse s = readD (mk s) \"x\"\n")),
    -- a join of patterns is a pattern
    expectTrue
      (accepts (handleP ++ "j : H (\"a/*\" | \"b/*\")\nj = H \"a/x\"\n")),
    -- an opened pattern existential is charged the label bare
    expectTrue
      (accepts
        (dir
          ++ "data AnyH = AnyH (d : Authority Store*) (H d)\nuse : AnyH -> <Store> Int\nuse a = match a\n  AnyH h => readD h \"x\"\n")),
    -- a pattern forwards into an ordinary binder
    expectTrue
      (accepts
        (handleP
          ++ "data O (p : Authority Store) = O (String @p)\ntoO : H d -> O d\ntoO (H r) = O r\n")),
    -- an impl head's bare index inherits the slot's range
    expectTrue
      (accepts
        (handleP
          ++ "interface Named a where\n  nameOf : a -> String\nimpl Named (H d) where\n  nameOf (H r) = r\n")),
    -- the written spellings print back
    expectEqual
      "effect Store Prefix\n\ndata H (d : Authority Store*) = H (String @d)\n\nsame : (dir : String @Store*) -> String @dir\nsame dir = dir\n"
      (formatSource
        "effect Store Prefix\n\ndata H (d : Authority Store*) = H (String @d)\n\nsame : (dir : String @Store*) -> String @dir\nsame dir = dir\n"),
  ]

-- #3629: an interpolated part is read as its operand only when `display` is
-- the prelude's method, whose `String` impl is the identity. This harness
-- declares no prelude, so a `Display` written here is a program's own, and
-- its `String` impl may be anything: the part stays the whole domain. The
-- accepting rows are the abstraction's own, in `effect_infer_test.mdk`, and
-- `test/effect_builtin_param_fixtures/filewrite_interp_binder_manifest_accept.mdk`,
-- which is checked against the real prelude.
test "an interpolated binder is read through the prelude's display only" =
  let ownDisplay =
    "interface Display a where\n  display : a -> String\nimpl Display String where\n  display s = \"../\" ++ s\n"
  let under = "under : (d : String @Store*) -> String -> <Store d> Int\n"
  expectAll [
    expectEqual
      []
      (codes (ownDisplay ++ under ++ "under d x = load (d ++ \"/\" ++ x)\n")),
    expectEqual
      ["T-AUTHORITY"]
      (codes (ownDisplay ++ under ++ "under d x = load \"\\{d}/\\{x}\"\n")),
  ]

test "a pattern slot refuses what is not a pattern" = expectAll
  [
    -- a written exact element
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "bad : H \"cfg/app\"\nbad = H \"cfg/app\"\n")),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "bad : H (\"a/*\" | \"b/x\")\nbad = H \"a/x\"\n")),
    expectTrue
      (contains
        "T-AUTHORITY-PATTERN"
        (codes
          (handleP
            ++ "type Exact = H \"cfg/app\"\nbad : Exact\nbad = H \"cfg/app\"\n"))),
    -- a written ordinary binder: a named argument, a head parameter, an
    -- existential, whether its domain is written or not
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "mk : (p : String @Store) -> H p\nmk p = H p\n")),
    expectTrue
      (anyMentions
        "`(p : String @Store*)`"
        (messagesOf
          (handleP ++ "mk : (p : String @Store) -> H p\nmk p = H p\n"))),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "mk : (p : String) -> H p\nmk p = H p\n")),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "data W (p : Authority Store) = W (H p)\n")),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes (handleP ++ "data AnyH = AnyH (p : Authority Store) (H p)\n")),
    -- a rigid ordinary binder reaching a pattern slot at a use is the whole domain
    expectEqual
      ["T-AUTHORITY"]
      (codes
        (dir
          ++ "g : (p : String @Store) -> <Store p> Int\ng p = readD (H p) \"x\"\n")),
    -- a left extension is the whole domain
    expectEqual
      ["T-AUTHORITY"]
      (codes
        (handleP
          ++ "bad : H d -> String -> <Store d> Int\nbad (H root) x = load (x ++ root)\n")),
    -- a value outside the written pattern, and a runtime value laundered into a bound
    expectEqual
      ["T-AUTHORITY"]
      (codes (handleP ++ "bad : H \"cfg/*\"\nbad = H \"cfg\"\n")),
    expectFalse
      (accepts
        (dir
          ++ "f : String -> <Store \"cfg/*\"> Int\nf x = readD (H x) \"a\"\n")),
    expectFalse
      (accepts
        (dir ++ "f : H * -> <Store \"cfg/*\"> Int\nf h = readD h \"a\"\n")),
    -- a caller's exact element is charged the pattern it begins
    expectFalse
      (accepts
        "readUnder : (p : String @Store*) -> String -> <Store p> Int\nreadUnder p x = load (p ++ x)\nonlyApp : Unit -> <Store \"cfg/app.toml\"> Int\nonlyApp _ = readUnder \"cfg/app.toml\" \"\"\n"),
  ]

test "a pattern-ranging binder needs a domain with patterns" = expectAll
  [
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes "data V (d : Authority Var*) = V (String @d)\n"),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes "f : (x : String @Var*) -> String @x\nf x = x\n"),
    expectEqual
      ["T-AUTHORITY-PATTERN"]
      (codes
        "effect M Product (Method : Set, Host : Prefix)\ndata V (d : Authority M*) = V (String @d)\n"),
    -- a Product whose primary axis is a Prefix has patterns
    expectTrue
      (accepts
        "effect W Product (Host : Prefix, Method : Set)\ndata V (d : Authority W*) = V (String @d)\n"),
  ]

patternProvider : String
patternProvider =
  "export data H (d : Authority Store*) = H (String @d)\n"
    ++ "export\ncfg : H \"cfg/*\"\ncfg = H \"cfg/\"\n"
    ++ "export\nreadD : H d -> String -> <Store d> Int\nreadD (H root) x = load (root ++ x)\n"

patternModuleCodes : String -> List String
patternModuleCodes body =
  flatMap
    moduleCodes
    (checkModulesDiagsChain None "" [] [] (desugar (parseLocated prelude)) [
      ("provider", desugar (parseLocated patternProvider)),
      (
        "entry",
        desugar (parseLocated ("import provider.{H, cfg, readD}\n" ++ body)),
      ),
    ])

test "an abstract pattern-ranging head keeps its range across modules" = expectAll
  [
    expectEqual
      []
      (patternModuleCodes
        "use : String -> <Store \"cfg/*\"> Int\nuse x = readD cfg x\n"),
    expectTrue
      (contains
        "T-AUTHORITY-PATTERN"
        (patternModuleCodes
          "only : H \"cfg/app\" -> <Store \"cfg/app\"> Int\nonly h = readD h \"\"\n")),
  ]
