import test.{
  Expectation, expectAll, expectEach, expectEqual, expectFalse, expectTrue, fail
}
import frontend.ast.{EffParamTy(..)}
import toml.{parse}
import support.manifest.{targetProfile}
import types.target_profile.{
  TargetProfile,
  backendName,
  buildableNames,
  grantsLabel,
  ioJoinGrants,
  isGatedLabel,
  knownNames,
  lookupProfile,
  profileAbi,
  profileBackend,
  profileGrants,
  profileName,
  profileNames,
  runProfile,
  selectProfile,
}

isTop : (String, EffParamTy) -> Bool
isTop (_, EPTop) = True
isTop _ = False

-- The labels a profile grants, or the lookup error.
grantedBy : String -> Result String (List String)
grantedBy name = map (p => map fst (profileGrants p)) (lookupProfile name)

elevenLabels : List String
elevenLabels = [
  "Stdout",
  "Stderr",
  "Stdin",
  "Clock",
  "Env",
  "Exec",
  "Rand",
  "FileRead",
  "FileWrite",
  "Net",
  "Signal",
]

test "(a) the six grant sets are TARGETS-DESIGN 8.1" = expectEach [
  (
    "llvm/native-posix",
    expectEqual (Ok (elevenLabels ++ ["FFI"])) (grantedBy "llvm/native-posix"),
  ),
  ("eval/run", expectEqual (Ok elevenLabels) (grantedBy "eval/run")),
  (
    "wasmgc/node",
    expectEqual
      (Ok [
        "Stdout",
        "Stderr",
        "Stdin",
        "Clock",
        "Env",
        "Rand",
        "FileRead",
        "FileWrite",
        "FFI",
      ])
      (grantedBy "wasmgc/node"),
  ),
  (
    "wasmgc/browser-worker",
    expectEqual
      (Ok ["Stdout", "Stderr", "Clock", "Rand", "FileRead", "FileWrite", "FFI"])
      (grantedBy "wasmgc/browser-worker"),
  ),
  (
    "wasmgc/edge",
    expectEqual
      (Ok ["Stdout", "Stderr", "Clock", "Rand", "FFI"])
      (grantedBy "wasmgc/edge"),
  ),
  ("wasmgc/wasi-p2", expectEqual (Ok ["FFI"]) (grantedBy "wasmgc/wasi-p2")),
]

test "(a) every grant is a label's whole domain" =
  expectEach
    (map
      (n => (
        n,
        expectEqual
          (Ok True)
          (map (p => all isTop (profileGrants p)) (lookupProfile n)),
      ))
      profileNames)

test "(a) backend tags, host ABI and label lookup" = expectAll [
  expectEqual
    (Ok "llvm/C symbols")
    (map
      (p => backendName (profileBackend p) ++ "/" ++ profileAbi p)
      (lookupProfile "native")),
  expectEqual
    (Ok "eval")
    (map (p => backendName (profileBackend p)) (lookupProfile "eval/run")),
  expectEqual
    (Ok "wasmgc/WIT")
    (map
      (p => backendName (profileBackend p) ++ "/" ++ profileAbi p)
      (lookupProfile "wasmgc/wasi-p2")),
  expectEqual
    (Ok True)
    (map (p => grantsLabel p "Net") (lookupProfile "eval/run")),
  expectEqual
    (Ok False)
    (map (p => grantsLabel p "Net") (lookupProfile "wasmgc/edge")),
]

test "(b) aliases resolve to their profile" = expectAll [
  expectEqual
    (Ok "llvm/native-posix")
    (map profileName (lookupProfile "native")),
  expectEqual (Ok "wasmgc/node") (map profileName (lookupProfile "wasm")),
]

test "(b) an unknown name is an error naming every known name" =
  expectEqual
    (Err
      "unknown target `nosuch` (known: llvm/native-posix, eval/run, wasmgc/node, wasmgc/browser-worker, wasmgc/edge, wasmgc/wasi-p2, native, wasm)")
    (map profileName (lookupProfile "nosuch"))

test "(b) the known names are the profiles then the aliases" =
  expectEqual (profileNames ++ ["native", "wasm"]) knownNames

test "build can emit every non-eval name" =
  expectEqual
    [
      "llvm/native-posix",
      "wasmgc/node",
      "wasmgc/browser-worker",
      "wasmgc/edge",
      "wasmgc/wasi-p2",
      "native",
      "wasm",
    ]
    buildableNames

nameOf : Result String (Option TargetProfile) -> Result String (Option String)
nameOf = map (map profileName)

test "(b) the flag overrides the manifest, which overrides nothing" = expectAll
  [
    expectEqual
      (Ok (Some "eval/run"))
      (nameOf (selectProfile (Some "eval/run") (Some "wasmgc/edge"))),
    expectEqual
      (Ok (Some "wasmgc/edge"))
      (nameOf (selectProfile None (Some "wasmgc/edge"))),
    expectEqual (Ok None) (nameOf (selectProfile None None)),
    expectTrue (isErr (selectProfile (Some "nosuch") (Some "eval/run"))),
  ]

test "(b) the manifest's [target] profile is what the accessor reads" =
  match parse "[target]\nprofile = \"wasmgc/edge\"\n"
    Err e => expectEqual "parse" e
    Ok doc =>
      expectEqual
        (Ok (Some "wasmgc/edge"))
        (nameOf (andThen (targetProfile doc) (selectProfile None)))

-- The profile `run` checks against, as (name, granted labels).
runView : Option String -> Result String (String, List String)
runView sel =
  map
    (p => (profileName p, map fst (profileGrants p)))
    (map runProfile (selectProfile sel None))

test "run checks against eval/run, narrowed by the selected profile" = expectEach
  [
    ("none", expectEqual (Ok ("eval/run", elevenLabels)) (runView None)),
    (
      "eval/run",
      expectEqual (Ok ("eval/run", elevenLabels)) (runView (Some "eval/run")),
    ),
    (
      "native drops FFI",
      expectEqual
        (Ok ("eval/run ∩ llvm/native-posix", elevenLabels))
        (runView (Some "native")),
    ),
    (
      "edge",
      expectEqual
        (Ok ("eval/run ∩ wasmgc/edge", ["Stdout", "Stderr", "Clock", "Rand"]))
        (runView (Some "wasmgc/edge")),
    ),
  ]

test "a profile gates the host labels and FFI, and no other label" = expectAll [
  expectEqual (map (_ => True) elevenLabels) (map isGatedLabel elevenLabels),
  expectFalse (isGatedLabel "IO"),
  expectTrue (isGatedLabel "FFI"),
  expectFalse (isGatedLabel "Log"),
  expectFalse (isGatedLabel "Cache"),
]

-- What `IO` joins under a selection, as its labels and whether each is granted
-- over its whole domain.
ioJoinView : Option TargetProfile -> (List String, Bool)
ioJoinView sel =
  let grants = ioJoinGrants sel
  (map fst grants, all isTop grants)

-- `run` takes the join from the profile `check` selected: `runProfile` keeps
-- every host-label grant of it, since `eval/run` grants all eleven.
runJoinAgrees : String -> Expectation
runJoinAgrees name = match lookupProfile name
  Ok p =>
    expectEqual (ioJoinView (Some p)) (ioJoinView (Some (runProfile (Some p))))
  Err m => fail m

test "IO joins the selected profile's host-label grants" = expectEach [
  ("none", expectEqual (elevenLabels, True) (ioJoinView None)),
  (
    "native drops FFI",
    expectEqual
      (Ok (elevenLabels, True))
      (map (p => ioJoinView (Some p)) (lookupProfile "native")),
  ),
  (
    "wasm",
    expectEqual
      (Ok (
        [
          "Stdout",
          "Stderr",
          "Stdin",
          "Clock",
          "Env",
          "Rand",
          "FileRead",
          "FileWrite",
        ],
        True,
      ))
      (map (p => ioJoinView (Some p)) (lookupProfile "wasm")),
  ),
  (
    "wasi-p2",
    expectEqual
      (Ok ([], True))
      (map (p => ioJoinView (Some p)) (lookupProfile "wasmgc/wasi-p2")),
  ),
]

test "run's IO join is the selected profile's own" =
  expectEach
    ((
        "none",
        expectEqual (ioJoinView None) (ioJoinView (Some (runProfile None))),
      )
      :: map (n => (n, runJoinAgrees n)) profileNames)
