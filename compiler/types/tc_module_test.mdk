-- Tests of `types.tc_module`'s own API.  Modules are driven below the entry: a graph record
-- with its declaration envelope and mark sets installed by hand (`prepared`), then each module
-- checked with `checkModuleFullDiags`, `checkBodyImpl`, `checkModuleFull` or `elabModuleStamp`
-- and the queue drained with `drainStampQueue`.  Covered: the signed and unsigned bindings a
-- module publishes, the diagnostics of its bodies (binding, impl method, `test`, `prop`, extern),
-- the interface-cycle and impl-coherence checks that end the module, the import of an earlier
-- module's data, `externSchemesGo` and `settleClosedBody`.  The stamp queue and its drain are
-- tested in `tc_stamp_test`, which reuses the fixtures exported here.
-- Not driven here, because no export reaches them: the import-overlay rows.  Their effect is
-- observed as the module's errors and as the drain's unrouted-dispatch findings, and an overlay
-- that changes no verdict is not observable below the entry.  What a whole check elaborates is
-- observed through `types.typecheck` in `typecheck_test`.

import support.diag_codes.{DiagCode(..), codeText}
import test.{expectAll, expectEach, expectEqual, expectNotEqual}
import frontend.ast.{
  Decl(..), EvEntry(..), EvVal(..), Loc(..), Route(..), Ty(..), tyConBuiltin
}
import types.tc_state.{
  freshGraphRun, carryModuleCtx, probeGraphCtx, initialModuleCtx
}
import types.tc_solve.{
  methodReturnProbeScope, methodReturnProbeSpelling, methodReturnArgs,
  methodReturnProbeRouteKey, methodReturnProbeIface, methodReturnProbeImpl
}
import types.tc_occurrence.{
  methodReturnProbeRequest, firstMethodRow, methodReturnProbeCodes
}
import types.tc_env.{buildFlatImplEnv}
import types.tc_mono.{stripArrows}
import types.tc_elab.{resolveExactReturnSite}
import types.tc_types.{siteFor, MethodSchemeRow(..)}
import types.tc_solve_entail.{ieSelectRowByIface, rowRouteKey}
import types.tc_decls.{ifaceMethodSchemeRows}
import types.tc_elab.{drivenEvidence}
import support.ordmap.{omEmpty}
import types.repr.{Scheme(..), ppScheme}
import types.publish.{TcDiag(..), tcCode}
import types.tc_decls.{buildDeclEnvs, declEnvModulesFrom}
import types.tc_env.{declEnvModule, emptyDeclEnvAcc}
import types.tc_mono.{tconBuiltin}
import types.tc_occurrence.{markSetsOf}
import types.tc_state.{checkRunResidue, plainModuleSeed}
import types.tc_test_support.{codesOf, declsOf, fresh, routeTag, sizeable}
import types.tc_types.{
  DrainFinding(..), GraphCtx, ModuleCtx, PreludeMarkFacts(..)
}
import types.tc_module.{
  checkBodyImpl, checkModuleFull, checkModuleFullDiags, elabModuleStamp,
  externSchemesGo, settleClosedBody
}
import types.tc_stamp.{drainStampQueue}

-- ── fixtures ──────────────────────────────────────────────────────────────

-- What one module's check handed back: the schemes it published (rendered), its error codes
-- and its warning codes.
public export data Checked = Checked {
  chSchemes : List (String, String),
  chErrors : List String,
  chWarnings : List String,
} deriving (Eq, Debug)

-- The mark sets of a graph with no prelude facts: the driver preamble a module check reads.
noPreludeFacts : PreludeMarkFacts
noPreludeFacts = PreludeMarkFacts {
  pmfReturnPos = [],
  pmfMethodConstraints = [],
  pmfArgDispatch = [],
  pmfArgDispatchById = [],
  pmfConstrainedNames = [],
}

-- A graph record over the modules [mods] (id, source), in order after an empty prelude, with
-- the declaration envelope and the mark sets a driver's preamble installs.
export
prepared : List (String, String) -> (ModuleCtx, List (String, List Decl))
prepared mods =
  let m = fresh ()
  let g = m.mcGraph
  let decls = map (p => (fst p, declsOf (fst p) (snd p))) mods
  g.declEnvsRef :=
    buildDeclEnvs
      g
      emptyDeclEnvAcc
      (declEnvModule g 0 "core" [])
      (declEnvModulesFrom g 1 decls)
  let _ = markSetsOf g noPreludeFacts [] decls (flatMap snd decls)
  (m, decls)

-- The schemes [bs] as (name, rendered type).
rendered : List (String, Scheme) -> List (String, String)
rendered = map (q => (fst q, ppScheme (snd q)))

-- Each module checked in the graph, later ones seeded with the schemes of the earlier ones.
export
checkEach : GraphCtx ->
  List (String, Scheme) ->
  List (String, List Decl) ->
  List Checked
checkEach _ _ [] = []
checkEach g seed ((mid, ds) :: rest) =
  let (b, _, errs, warns, _) =
    checkModuleFullDiags g mid (plainModuleSeed seed) [] [] ds
  Checked {
      chSchemes = rendered b.mbSchemes,
      chErrors = map (d => codeText (tcCode d)) errs,
      chWarnings = map (d => codeText (tcCode d)) warns,
    }
    -- Bound: one step per fixture module, a few per test.
    -- lint-disable-next-line rule-accumulator-append
    :: checkEach g (seed ++ b.mbSchemes) rest

-- What a drain reported: the module and code of each finding, in the order reported.
export
findingsOf : List DrainFinding -> List (String, String)
findingsOf = map (f => (f.dfModule, codeText (tcCode f.dfDiag)))

-- The record of [m] after `checkBodyImpl` alone has checked the module "m" of [decls]: the
-- body check queues no stamping context.
export
bodyChecked : ModuleCtx -> List (String, List Decl) -> ModuleCtx
bodyChecked m decls =
  let (_, _, ctx) =
    checkBodyImpl
      m.mcGraph
      (checkRunResidue m)
      (plainModuleSeed [])
      "m"
      []
      (flatMap snd decls)
  ctx

-- The modules [mods] checked in one graph, then the graph drained.
export
driven : List (String, String) -> (List Checked, List (String, String))
driven mods =
  let (m, decls) = prepared mods
  let checked = checkEach m.mcGraph [] decls
  (checked, findingsOf (drainStampQueue m))

-- The one module "m" of source [src], checked and drained; a source that is not one module
-- reads as an error no test expects.
export
onlyModule : String -> (Checked, List (String, String))
onlyModule src = match driven [("m", src)]
  ([c], fs) => (c, fs)
  _ => (Checked [] ["not a single module"] [], [])

-- The route each method occurrence of the graph was published with.
export
methodRoutes : GraphCtx -> List String
methodRoutes g =
  flatMap
    (e => match e
      EvEntry _ (EvMethod _ _ route _ _) => [routeTag route]
      _ => [])
    (drivenEvidence g ())

-- The errors of the one module "m" of [src].
errorsOf : String -> List String
errorsOf src = (fst (onlyModule src)).chErrors

-- `sizeable` and a binding `y` that calls its method at [arg].
export
callingSz : String -> String
callingSz arg = sizeable ++ "y : Int\ny = sz \{arg}\n"

-- A module that imports the interface of the module "m" and a binding `y` that calls its method
-- at [arg].
export
importingSz : String -> String
importingSz arg = """
import m.{Sz(..)}
y : Int
y = sz \{arg}
"""

-- ── a module's published schemes ──────────────────────────────────────────

test "a signed binding publishes its declared type" =
  expectEqual
    (Checked [("x", "Int")] [] [])
    (fst (onlyModule """
x : Int
x = 1
"""))

test "an unsigned function is generalized and each use instantiates it" =
  expectEqual
    (Checked [("f", "a -> a"), ("g", "Int"), ("h", "Bool")] [] [])
    (fst (onlyModule """
f x = x
g = f 1
h = f True
"""))

test "a mutually recursive group is inferred together and both members are published" =
  let (c, _) = onlyModule """
ev n = od n
od n = ev n
"""
  expectEqual (["ev", "od"], []) (map fst c.chSchemes, c.chErrors)

test "an interface publishes its method at the interface's own type" =
  let (c, _) = onlyModule sizeable
  expectEqual ([("sz", "a -> Int")], []) (c.chSchemes, c.chErrors)

-- ── the diagnostics of a module's bodies ──────────────────────────────────

test "a body that disagrees with its signature is a type mismatch and the signature is still published" =
  expectEqual
    (Checked [("x", "Int")] ["T-TYPE-MISMATCH"] [])
    (fst (onlyModule """
x : Int
x = True
"""))

test "an impl method body is checked against the interface method's type" =
  expectEqual
    ["T-TYPE-MISMATCH"]
    (errorsOf
      """
interface Sz a where
  sz : a -> Int
impl Sz Bool where
  sz x = True
""")

test "a test body is inferred, so a body that cannot type is reported" = expectEach
  [
    (
      "ill-typed",
      expectEqual ["T-TYPE-MISMATCH"] (errorsOf "test \"t\" = 1 + True"),
    ),
  ]

test "a property body is inferred and must be a Bool" = expectEach [
  (
    "not a Bool",
    expectEqual ["T-TYPE-MISMATCH"] (errorsOf "prop \"p\" (x : Int) = x"),
  ),
  ("a Bool", expectEqual [] (errorsOf "prop \"p\" (x : Int) = True")),
]

test "a call of an extern is checked against its declared type, which the module publishes" =
  expectEqual
    (Checked [("foo", "Int -> Int"), ("y", "Int")] ["T-TYPE-MISMATCH"] [])
    (fst (onlyModule """
extern foo : Int -> Int
y : Int
y = foo True
"""))

-- ── the checks that end a module ──────────────────────────────────────────

test "interfaces that require each other are a cyclic superinterface and a chain is not" = expectEach
  [
    (
      "a cycle",
      expectEqual
        ["T-CYCLIC-SUPERINTERFACE"]
        (errorsOf
          """
interface A a requires B a where
  a : a -> Int
interface B a requires A a where
  b : a -> Int
"""),
    ),
    (
      "a chain",
      expectEqual
        []
        (errorsOf
          """
interface A a where
  a : a -> Int
interface B a requires A a where
  b : a -> Int
"""),
    ),
  ]

test "two impls of one interface at one type are a conflicting impl" =
  expectEqual
    ["T-CONFLICTING-IMPL"]
    (errorsOf (sizeable ++ """
impl Sz Int where
  sz x = x
"""))

test "an impl that defines no method the interface declares is an incomplete impl" =
  expectEqual
    ["T-INCOMPLETE-IMPL"]
    (errorsOf
      """
interface Sz a where
  sz : a -> Int
impl Sz Int where
  sy x = x
""")

-- ── importing an earlier module ───────────────────────────────────────────

test "a later module reads an imported constructor at its home type, and another type is a mismatch" =
  let (checked, _) = driven [
    ("m", "public export data T = A | B"),
    (
      "n",
      """
import m.{T(..)}
f : T -> Int
f A = 1
f B = 2
""",
    ),
    (
      "k",
      """
f : Int
f = A
""",
    ),
  ]
  expectEqual
    [([], []), ([("f", "T -> Int")], []), ([("f", "Int")], ["T-TYPE-MISMATCH"])]
    (map (c => (c.chSchemes, c.chErrors)) checked)

test "the elaborating check is the module check over an impl universe" =
  let src = callingSz "True"
  let (m, decls) = prepared [("m", src)]
  let prog = flatMap snd decls
  let (b, _, ctx) = elabModuleStamp m "m" [] [] prog prog
  expectEqual (onlyModule src) (
    Checked (rendered b.mbSchemes) (codesOf ctx) [],
    findingsOf (drainStampQueue ctx),
  )

test "the core pass publishes its declarations and raises no error" =
  let (m, decls) = prepared [("m", """
x : Int
x = 1
""")]
  let (b, _, ctx) = checkModuleFull m [] [] (flatMap snd decls)
  expectEqual ([("x", "Int")], []) (rendered b.mbSchemes, codesOf ctx)

-- ── what a graph is stamped with ──────────────────────────────────────────

test "the schemes of the externs among a module's declarations are those and no others" =
  expectEqual
    [("foo", "Int -> Int")]
    (rendered
      (externSchemesGo
        (fresh ())
        (declsOf "m" """
extern foo : Int -> Int
bar : Int
bar = 1
""")))

test "settling a closed body with nothing recorded raises no error" =
  let m = fresh ()
  settleClosedBody m (tconBuiltin "Unit") 0 0 0
  expectEqual [] (codesOf m)

-- Runs in a carry of [prev], the caller's record, in its graph record with a fresh
-- graph run.
methodReturnProbeStamp : ModuleCtx ->
  MethodSchemeRow ->
  MethodSchemeRow ->
  List Decl ->
  (String, Option String, Option String)
methodReturnProbeStamp prev ownedRow foreignRow impls =
  let gctx = GraphCtx { prev.mcGraph | graphRun = freshGraphRun () }
  let mctx = carryModuleCtx gctx prev
  let scope = methodReturnProbeScope mctx "return-owner-stamper"
  let request = methodReturnProbeRequest mctx ownedRow
  methodReturnProbeSpelling mctx foreignRow
  let env = buildFlatImplEnv impls
  mctx.mcCells.bodyImplEnvRef := env
  let tagRef = Ref RNone
  let implRef = Ref []
  let resultMono = stripArrows request.mrrOccurrence
  resolveExactReturnSite
    (siteFor mctx)
    omEmpty
    "make"
    tagRef
    implRef
    resultMono
    request
    ""
    None
    scope
  let goals = optionOr [] (methodReturnArgs gctx request)
  let ownedKey =
    map
      rowRouteKey
      (ieSelectRowByIface (siteFor mctx) env ownedRow.msrIface goals)
  let foreignKey =
    map
      rowRouteKey
      (ieSelectRowByIface (siteFor mctx) env foreignRow.msrIface goals)
  (methodReturnProbeRouteKey tagRef.value, ownedKey, foreignKey)

-- The request is created before the spelling table is pointed at Foreign.  The checker
-- must still reject a graph containing only Foreign's impl, its positive control must
-- accept Owner's impl, and the stamper must select Owner's distinct route.
-- What the ownership probe saw: the checker's error codes with only Foreign's impl
-- and with both impls, the route key the stamper wrote, and the keys of the rows
-- the owner's and the foreign interface select.
data ReturnOwnership = ReturnOwnership {
  roRejected : List String,
  roAccepted : List String,
  roStamped : String,
  roOwnedKey : Option String,
  roForeignKey : Option String,
}

methodReturnOwnershipProbe : Unit -> ReturnOwnership
methodReturnOwnershipProbe _ =
  let ownedGraph = probeGraphCtx ()
  let ownedDecl =
    methodReturnProbeIface
      "return-owner"
      "Owner"
      (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
  let foreignDecl =
    methodReturnProbeIface
      "return-foreign"
      "Foreign"
      (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
  let ownedCtx = initialModuleCtx ownedGraph
  let ownedRow = firstMethodRow (ifaceMethodSchemeRows ownedCtx [ownedDecl])
  let foreignGraph = GraphCtx { ownedGraph | graphRun = freshGraphRun () }
  let foreignCtx = carryModuleCtx foreignGraph ownedCtx
  let foreignRow =
    firstMethodRow (ifaceMethodSchemeRows foreignCtx [foreignDecl])
  let ownedImpl = methodReturnProbeImpl "return-owner" "Owner"
  let foreignImpl = methodReturnProbeImpl "return-foreign" "Foreign"
  let (rejected, rejectedCtx) =
    methodReturnProbeCodes foreignCtx ownedRow [foreignImpl]
  let (accepted, acceptedCtx) =
    methodReturnProbeCodes rejectedCtx ownedRow [foreignImpl, ownedImpl]
  let (actualKey, ownedKey, foreignKey) = methodReturnProbeStamp
    acceptedCtx
    ownedRow
    foreignRow
    [foreignImpl, ownedImpl]
  ReturnOwnership {
    roRejected = rejected,
    roAccepted = accepted,
    roStamped = actualKey,
    roOwnedKey = ownedKey,
    roForeignKey = foreignKey,
  }

test "a return-owner request selects the owner's impl and rejects the foreign one" =
  let seen = methodReturnOwnershipProbe ()
  expectAll [
    expectEqual ["T-NO-IMPL"] seen.roRejected,
    expectEqual [] seen.roAccepted,
    expectEqual (Some seen.roStamped) seen.roOwnedKey,
    expectNotEqual (Some seen.roStamped) seen.roForeignKey,
  ]
