-- Tests of `types.tc_unify`'s own API: fresh variables and levels, unification over the
-- row- and qualifier-free fragment (variables, constructors, applications, arrows), the
-- occurs check, level lowering, and generalization with instantiation.  The model type
-- language and its closed generator live in `tc_mono_test`, which this file reads; the
-- expected answer of each law is computed on the model or by a renaming-invariant reading
-- of the result, never taken back from the module under test.  Every test mints its own
-- module record in a fresh graph record, so none needs a doctest's shared fixture.

import list.{indexed, lookup, nub, zip}
import test.{
  expectAll,
  expectEqual,
  expectFalse,
}
import frontend.ast.{
  Decl(..), Loc(..), TyConOrigin(..), UseMember(..), UsePath(..)
}
import types.effect_rows.{pureRow}
import types.repr.{Mono(..), Scheme(..), Tyvar(..), normalize}
import types.tc_mono.{
  monoUnboundIds,
  tconBuiltin,
  tconFrom,
  tconUnresolved,
  tyvarId,
}
import types.tc_mono_test.{
  MTy(..),
  genClosed,
  genMTy,
  varsOf,
}
import types.tc_test_support.{codesOf, fresh, messagesOf}
import support.ordmap.{omEmpty, omInsert}
import types.tc_types.{DynCtx(..), ModuleCtx(..), dynFor}
import types.tc_unify.{
  enterLevel,
  exitLevel,
  freshVar,
  generalize,
  instantiate,
  lowerToCurrent,
  unify,
  unifyIn,
}

-- ── fixtures ──────────────────────────────────────────────────────────────

level : ModuleCtx -> Int
level m = m.mcCells.currentLevel.value

-- One fresh variable per distinct variable id of [t], minted at the current level.
varsFor : ModuleCtx -> MTy -> List (Int, Mono)
varsFor m t = map (k => (k, freshVar m ())) (nub (varsOf t))

build : List (Int, Mono) -> MTy -> Mono
build _ (MCon n) = tconFrom (OriginModule "gen") n
build vs (MVar k) = optionOr (tconUnresolved "no-var") (lookup k vs)
build vs (MApp a b) = TApp (build vs a) (build vs b)
build vs (MFun a b) = TFun (build vs a) pureRow (build vs b)

buildFresh : ModuleCtx -> MTy -> Mono
buildFresh m t = build (varsFor m t) t

-- A type read back through `normalize`, with variables numbered by first occurrence across
-- the whole list: two lists have the same reading exactly when they are equal up to a
-- consistent renaming of variables.
shapes : List Mono -> List String
shapes ms =
  let table = Ref []
  map (shape table) ms

shape : Ref (List (Int, Int)) -> Mono -> String
shape table m = match normalize m
  TVar cell => varName table (tyvarId cell)
  TCon n _ => n
  TRigid n => "!\{n}"
  TApp a b =>
    let l = shape table a
    let r = shape table b
    "(\{l} \{r})"
  TFun a _ b =>
    let l = shape table a
    let r = shape table b
    "(\{l} -> \{r})"
  TEff _ => "<row>"
  TAuth _ => "<auth>"
  TQual a _ => shape table a

varName : Ref (List (Int, Int)) -> Int -> String
varName table id = match lookup id table.value
  Some n => "v\{intToString n}"
  None =>
    let n = length table.value
    table := (id, n) :: table.value
    "v\{intToString n}"

-- The unbound variables of [m] with their levels, in order of occurrence.
levelsOf : Mono -> List (Int, Int)
levelsOf m = match normalize m
  TVar cell => match !cell
    Unbound id lvl => [(id, lvl)]
    Link _ => []
  TApp a b => levelsOf a ++ levelsOf b
  TFun a _ b => levelsOf a ++ levelsOf b
  TQual a _ => levelsOf a
  _ => []

-- Unify the types of [a] and [b] (variables of the two are distinct cells) and answer
-- whether it was accepted, with the joint reading of both operands afterwards.  [swap]
-- makes the call with the operands exchanged.
data PairRead = PairRead {
  accepted : Bool,
  readings : List String,
} deriving (Eq, Debug)

unifyPair : MTy -> MTy -> Bool -> PairRead
unifyPair a b swap =
  let m = fresh ()
  let ma = buildFresh m a
  let mb = buildFresh m b
  if swap then unify m mb ma else unify m ma mb
  PairRead { accepted = isEmpty (codesOf m), readings = shapes [ma, mb] }

-- A pair of model types to unify.  A quarter are independent draws, which clash or
-- unify by chance; the rest are two independent "blurs" of one closed type, in which
-- constructor leaves are replaced by variables, so they unify unless a repeated variable
-- meets two different constructors.
data UPair = UPair MTy MTy deriving (Eq, Debug)

blur : MTy -> <Rand> MTy
blur (MCon n) = if randomInt 0 1 == 0 then MVar (randomInt 0 3) else MCon n
blur (MVar k) = MVar k
blur (MApp a b) = MApp (blur a) (blur b)
blur (MFun a b) = MFun (blur a) (blur b)

genPair : Unit -> <Rand> UPair
genPair () = match randomInt 0 3
  0 => UPair (genMTy 3) (genMTy 3)
  _ =>
    let t = genClosed 2
    UPair (blur t) (blur t)

impl Arbitrary UPair where
  arbitrary () = genPair ()
  shrink (UPair a b) = [UPair a a, UPair b b]

-- ── fresh variables and levels ────────────────────────────────────────────

test "freshVar mints a new id each call, at the current level" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  expectAll [
    expectEqual 2 (length (nub (map fst (levelsOf (TApp a b))))),
    expectEqual [0, 0] (map snd (levelsOf (TApp a b))),
  ]

test "enterLevel deepens and exitLevel restores the level new variables are minted at" =
  let m = fresh ()
  enterLevel m ()
  let inner = freshVar m ()
  enterLevel m ()
  let innermost = freshVar m ()
  exitLevel m ()
  exitLevel m ()
  let outer = freshVar m ()
  expectAll [
    expectEqual [1] (map snd (levelsOf inner)),
    expectEqual [2] (map snd (levelsOf innermost)),
    expectEqual [0] (map snd (levelsOf outer)),
    expectEqual 0 (level m),
  ]

-- ── unification ───────────────────────────────────────────────────────────

test "a variable unifies with a type and reads as it afterwards, from either side" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  unify m a (tconBuiltin "Int")
  unify m (tconBuiltin "Bool") b
  expectAll [
    expectEqual ["Int"] (shapes [a]),
    expectEqual ["Bool"] (shapes [b]),
    expectEqual [] (codesOf m),
  ]

test "two variables unified become one: binding either binds both" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  unify m a b
  unify m b (TApp (tconBuiltin "List") (tconBuiltin "Int"))
  expectAll [
    expectEqual ["(List Int)", "(List Int)"] (shapes [a, b]),
    expectEqual [] (codesOf m),
  ]

test "a constructor clash is a type mismatch and binds nothing" =
  let m = fresh ()
  let a = freshVar m ()
  unify m (tconBuiltin "Int") (tconBuiltin "Bool")
  unify m (TApp (tconBuiltin "List") a) (TApp (tconUnresolved "Pair") a)
  expectAll [
    expectEqual ["T-TYPE-MISMATCH", "T-TYPE-MISMATCH"] (codesOf m),
    expectEqual ["v0"] (shapes [a]),
  ]

-- A module whose `take` is imported by name from `string`, with the cells the
-- module install leaves for `import string.{take}`.
importingTake : Bool -> ModuleCtx
importingTake stdlibOwned =
  let m = fresh ()
  let loc = Loc "t.mdk" 1 0 1 0
  m.mcCells.currentImportDefinersRef := omInsert "take" "string" omEmpty
  m.mcCells.currentImportOriginsRef := omInsert "take" "take" omEmpty
  m.mcCells.methodScopeCtxRef := Some (
    [DUse False (UseGroup ["string"] [UseMember "take" False loc None]) loc],
    0,
  )
  m.mcGraph.config := { m.mcGraph.config.value |
    tcStdlibOwned =
      if stdlibOwned then omInsert "string" () omEmpty else omEmpty,
  }
  m

test "a clash at the application of a selectively imported stdlib name says which module the name came from" =
  let m = importingTake True
  let dyn = { dynFor m | dcCallee = Some "take" }
  unifyIn dyn (tconBuiltin "Int") (tconBuiltin "Bool")
  unifyIn
    { dyn | dcCallee = Some "drop" }
    (tconBuiltin "Int")
    (tconBuiltin "Bool")
  unify m (tconBuiltin "Int") (tconBuiltin "Bool")
  expectEqual
    [
      "type mismatch: Int vs Bool; `take` here is `string.take` (selectively imported from `string`); an unqualified `take` from any other module needs its own import",
      "type mismatch: Int vs Bool",
      "type mismatch: Int vs Bool",
    ]
    (messagesOf m)

test "a clash at a head imported from a user module carries no import note" =
  let m = importingTake False
  unifyIn
    { dynFor m | dcCallee = Some "take" }
    (tconBuiltin "Int")
    (tconBuiltin "Bool")
  expectEqual ["type mismatch: Int vs Bool"] (messagesOf m)

test "unification descends applications and arrows and binds the variables it meets" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  let int = tconBuiltin "Int"
  unify
    m
    (TFun a pureRow (TApp (tconBuiltin "List") b))
    (TFun int pureRow (TApp (tconBuiltin "List") (tconBuiltin "Bool")))
  expectAll [
    expectEqual ["Int", "Bool"] (shapes [a, b]),
    expectEqual [] (codesOf m),
  ]

test "an arrow does not unify with an application" =
  let m = fresh ()
  let int = tconBuiltin "Int"
  unify m (TFun int pureRow int) (TApp (tconBuiltin "List") int)
  expectEqual ["T-TYPE-MISMATCH"] (codesOf m)

test "a rigid variable unifies with itself and with no constructor" =
  let m = fresh ()
  unify m (TRigid "a") (TRigid "a")
  let none = codesOf m
  unify m (TRigid "a") (tconBuiltin "Int")
  unify m (TRigid "a") (TRigid "b")
  expectAll [
    expectEqual [] none,
    expectEqual ["T-TYPE-MISMATCH", "T-TYPE-MISMATCH"] (codesOf m),
  ]

test "same-named types of two modules are different types; an absent origin makes no claim" =
  let m = fresh ()
  unify m (tconFrom (OriginModule "m1") "T") (tconFrom (OriginModule "m1") "T")
  unify m (tconUnresolved "T") (tconFrom (OriginModule "m1") "T")
  let accepted = codesOf m
  unify m (tconFrom (OriginModule "m1") "T") (tconFrom (OriginModule "m2") "T")
  expectAll [
    expectEqual [] accepted,
    expectEqual ["T-TYPE-MISMATCH"] (codesOf m),
  ]

-- ── the occurs check ──────────────────────────────────────────────────────

test "a variable is refused a type that contains it: T-INFINITE-TYPE" =
  let m = fresh ()
  let a = freshVar m ()
  unify m a (TApp (tconBuiltin "List") a)
  expectAll [
    expectEqual ["T-INFINITE-TYPE"] (codesOf m),
    expectEqual ["v0"] (shapes [a]),
  ]

test "the occurs check sees through an arrow, and a variable unifies with itself" =
  let m = fresh ()
  let a = freshVar m ()
  unify m a a
  let accepted = codesOf m
  unify m (TFun a pureRow (tconBuiltin "Int")) a
  expectAll [
    expectEqual [] accepted,
    expectEqual ["T-INFINITE-TYPE"] (codesOf m),
  ]

test "a variable bound to a type without it is accepted, whatever the type's size" =
  let m = fresh ()
  let a = freshVar m ()
  let b = freshVar m ()
  unify m a (TApp (tconBuiltin "List") (TApp (tconBuiltin "List") b))
  expectAll [
    expectEqual [] (codesOf m),
    expectEqual ["(List (List v0))"] (shapes [a]),
  ]

-- Law: refusing `a ~ C[a]` holds for any context that contains the variable (one diagnostic
-- per occurrence found, so the count is not the law).  Precondition:
-- the drawn type mentions a variable (otherwise there is nothing to place under the
-- constructor); closed draws are accepted, which the property also checks, so a draw
-- without a variable is not a vacuous pass.
prop "a variable is refused any type that strictly contains it, and accepted a closed one" (t : MTy) =
  let m = fresh ()
  let cells = varsFor m t
  match cells
    [] =>
      let v = freshVar m ()
      unify m v (TApp (tconBuiltin "List") (build [] t))
      isEmpty (codesOf m)
    (k, v) :: _ =>
      unify m v (TApp (tconBuiltin "List") (build cells t))
      not (isEmpty (codesOf m)) && all (== "T-INFINITE-TYPE") (codesOf m)

-- ── levels ────────────────────────────────────────────────────────────────

test "binding a variable lowers the variables of its target to the variable's level" =
  let m = fresh ()
  let outer = freshVar m ()
  enterLevel m ()
  let inner = freshVar m ()
  unify m outer (TApp (tconBuiltin "List") inner)
  expectAll [
    expectEqual [0] (map snd (levelsOf inner)),
    expectEqual [] (codesOf m),
  ]

test "binding a variable never raises the level of its target's variables" =
  let m = fresh ()
  enterLevel m ()
  let deep = freshVar m ()
  exitLevel m ()
  let shallow = freshVar m ()
  unify m deep (TApp (tconBuiltin "List") shallow)
  expectEqual [0] (map snd (levelsOf shallow))

test "lowerToCurrent lowers a deeper variable to the current level and leaves a shallower one" =
  let m = fresh ()
  let shallow = freshVar m ()
  enterLevel m ()
  enterLevel m ()
  let deep = freshVar m ()
  exitLevel m ()
  lowerToCurrent m (TApp shallow deep)
  expectAll [
    expectEqual [0] (map snd (levelsOf shallow)),
    expectEqual [1] (map snd (levelsOf deep)),
  ]

-- Law: lowering never raises a variable's level, and gives exactly the smaller of its level
-- and the current one.  The levels are drawn from 0..3 per variable and the current level
-- from 0..2, so a large share of draws have a variable deeper than the current level.
prop "lowerToCurrent gives each variable the smaller of its level and the current level" (t : MTy) (ls : List Int) (cur : Int) =
  let m = fresh ()
  let target = abs cur % 3
  repeatEnter m target
  let lvlOf = k => abs (optionOr 3 (lookup k (indexed ls))) % 4
  let cells =
    map (k => (k, TVar (Ref (Unbound (100 + k) (lvlOf k))))) (nub (varsOf t))
  let mono = build cells t
  let before = levelsOf mono
  lowerToCurrent m mono
  let after = levelsOf mono
  after == map (e => (fst e, min (snd e) target)) before
    && all (e => snd (fst e) <= snd (snd e)) (zip after before)
    && length after == length before

repeatEnter : ModuleCtx -> Int -> Unit
repeatEnter m n =
  if n <= 0 then
    ()
  else
    enterLevel m ()
    repeatEnter m (n - 1)

-- ── generalization and instantiation ──────────────────────────────────────

-- The scheme of [t]'s variables minted one level above the current one, then back at the
-- current level, so every free variable is generalizable.
generalizedAbove : ModuleCtx -> MTy -> (Mono, Scheme)
generalizedAbove m t =
  enterLevel m ()
  let mono = buildFresh m t
  exitLevel m ()
  (mono, generalize m mono)

quantified : Scheme -> Int
quantified (Forall ids _ _ _ _ _) = length ids

test "a closed type generalizes to a scheme that quantifies nothing" =
  let m = fresh ()
  let (_, s) = generalizedAbove m (MApp (MCon "List") (MCon "Int"))
  expectEqual 0 (quantified s)

test "variables above the current level are quantified, once each" =
  let m = fresh ()
  let (_, s) = generalizedAbove m (MFun (MVar 0) (MFun (MVar 1) (MVar 0)))
  expectEqual 2 (quantified s)

test "variables at the current level are not quantified, and instantiation shares them" =
  let m = fresh ()
  let mono = buildFresh m (MFun (MVar 0) (MVar 1))
  let s = generalize m mono
  let inst = instantiate m s
  expectAll [
    expectEqual 0 (quantified s),
    expectEqual (monoUnboundIds mono) (monoUnboundIds inst),
  ]

test "instantiation mints fresh variables, keeps a repeated variable as one, and leaves the scheme alone" =
  let m = fresh ()
  let (mono, s) = generalizedAbove m (MFun (MVar 0) (MFun (MVar 1) (MVar 0)))
  let first = instantiate m s
  let second = instantiate m s
  expectAll [
    expectEqual ["(v0 -> (v1 -> v0))"] (shapes [first]),
    expectEqual ["(v0 -> (v1 -> v0))"] (shapes [mono]),
    expectFalse (anyShared (monoUnboundIds first) (monoUnboundIds mono)),
    expectFalse (anyShared (monoUnboundIds second) (monoUnboundIds first)),
  ]

test "an instance is independent of the scheme: unifying it binds none of the scheme's variables" =
  let m = fresh ()
  let (mono, s) = generalizedAbove m (MFun (MVar 0) (MVar 0))
  let inst = instantiate m s
  unify m inst (TFun (tconBuiltin "Int") pureRow (tconBuiltin "Int"))
  expectAll [
    expectEqual ["(v0 -> v0)"] (shapes [mono]),
    expectEqual ["(Int -> Int)"] (shapes [inst]),
    expectEqual [] (codesOf m),
  ]

-- Law: `instantiate (generalize t)` is `t` up to a renaming of its variables.
-- Precondition: every free variable of `t` is above the current level, which the
-- construction guarantees; the property also checks that no variable of the instance is
-- one of `t`'s (the renaming is not the identity) and that `t` itself is unchanged.
prop "instantiate (generalize t) reads as t, with fresh variables, when t's variables are above the current level" (t : MTy) =
  let m = fresh ()
  let (mono, s) = generalizedAbove m t
  let before = shapes [mono]
  let inst = instantiate m s
  shapes [inst] == before
    && shapes [mono] == before
    && length (monoUnboundIds inst) == length (varsOf t)
    && not (anyShared (monoUnboundIds inst) (monoUnboundIds mono))

anyShared : List Int -> List Int -> Bool
anyShared xs ys = any (x => elem x ys) xs

-- Law: unification is symmetric over the row- and qualifier-free fragment: the same
-- verdict under operand swap, and when accepted the same resolved types up to renaming
-- (and both operands read alike).  Directed flows are not symmetric and are not here.
prop "unification gives the same verdict and the same resolved types under operand swap" (p : UPair) =
  let (UPair a b) = p
  let r1 = unifyPair a b False
  let r2 = unifyPair a b True
  r1.accepted == r2.accepted
    && (not r1.accepted
      || r1.readings == r2.readings && length (nub r1.readings) == 1)

test "the symmetry harness reads an accepted pair as one shared type and a refused pair as refused" = expectAll
  [
    expectEqual
      PairRead { accepted = True, readings = ["(Int v0)", "(Int v0)"] }
      (unifyPair (MApp (MCon "Int") (MVar 0)) (MApp (MVar 1) (MVar 2)) False),
    expectEqual
      PairRead { accepted = False, readings = ["Int", "Bool"] }
      (unifyPair (MCon "Int") (MCon "Bool") True),
  ]
