-- Tests of `types.tc_solve_entail`'s own API: the route walk's step judgment (`reqWalkEnter`:
-- a goal already on the path is a cycle, a smaller goal is free, a goal that does not shrink
-- spends the walk's fuel until it is exhausted), the head matching an instance is selected
-- by (`positionBindings`, `repeatedBindings`, `paramMonoOf`, `goalHeadCon`,
-- `goalIsProjection`), the identity word of an instance row (`rowRouteKey`); then the
-- judgment `P |- pi ~> e` through one whole check: an instance, a given and a superclass
-- each entail a goal, an absent instance or a prerequisite is rejected by code, the most
-- specific of overlapping instances is the one a route names, and two incomparable ones are
-- an ambiguous instance.  One property: the route of a goal does not depend on the order the
-- instances are declared in.

import types.tc_mono.{tconFrom, tconBuiltin}
import list.{drop, head, reverse}
import test.{
  expectAll, expectEach, expectFalse, expectEqual, expectNotEqual,
  expectSatisfies, expectTrue, pass
}
import frontend.ast.{Ty, TyConOrigin(..)}
import frontend.parser.{parse}
import support.util.{joinNl, splitOnChar}
import types.repr.{IfaceRef(..), Mono(..), Tyvar(..), ppMono}
import types.tc_solve_entail.{
  enteredGoalKey, goalHeadCon, goalIsProjection, paramMonoOf, positionBindings,
  reqWalkEnter, reqWalkSeed, reqWalkStart, repeatedBindings, rowRouteKey
}
import types.tc_solve_test_support.{
  checkCodes, expectChecks, expectRejectedWith, routeWordsOf
}
import types.tc_test_support.{sigsOf}
import types.tc_types.{ImplRow(..), InstRef(..), ReqStep(..), ReqWalk}

-- ── fixtures ──────────────────────────────────────────────────────────────

ifaceOf : String -> IfaceRef
ifaceOf name = IfaceRef { irName = name, irOrigin = OriginModule "probe" }

intM : Mono
intM = tconBuiltin "Int"

boxOf : Mono -> Mono
boxOf m = TApp (tconFrom (OriginModule "probe") "Box") m

varM : Int -> Mono
varM id = TVar (Ref (Unbound id 0))

-- The memo bucket key of the goal a step entered: interface, size and fuel left.
stepKey : ReqStep -> Option String
stepKey (ReqOn walk) = Some (enteredGoalKey walk)
stepKey _ = None

-- The fuel left in a bucket key, the last field.
fuelOf : String -> String
fuelOf key = match reverse (splitOnChar '#' key)
  fuel :: _ => fuel
  [] => ""

-- The walk a step continues with, when it continues.
onward : ReqStep -> Option ReqWalk
onward (ReqOn walk) = Some walk
onward _ = None

-- The walk after entering each goal of [goals] in turn, or nothing as soon as a step stops.
enterAll : ReqWalk -> List (IfaceRef, List Mono) -> Option ReqWalk
enterAll walk [] = Some walk
enterAll walk ((iface, args) :: rest) =
  match onward (reqWalkEnter walk iface args)
    Some next => enterAll next rest
    None => None

-- The head patterns of the types written in [src]'s signatures.
headsOf : String -> List Ty
headsOf src = sigsOf (parse src)

rowOf : Int -> String -> String -> ImplRow
rowOf ordinal iface src =
  ImplRow
    ordinal
    (InstRef "probe" ordinal ordinal)
    (ifaceOf iface)
    (headsOf src)
    []
    []
    None

-- ── the route walk ────────────────────────────────────────────────────────

test "a walk seeded with a goal reports that goal's interface with the full fuel" =
  let key = enteredGoalKey (reqWalkSeed (ifaceOf "A") [intM])
  expectAll [
    expectEqual (Some "A") (head (splitOnChar '#' key)),
    expectEqual (fuelOf (enteredGoalKey (reqWalkStart ()))) (fuelOf key),
  ]

test "the first goal entered on a walk with none is its seed, and costs no fuel" =
  let start = reqWalkStart ()
  expectEqual
    (Some (enteredGoalKey (reqWalkSeed (ifaceOf "A") [intM])))
    (stepKey (reqWalkEnter start (ifaceOf "A") [intM]))

test "a goal already on the path is a cycle that names the goal it closes on" =
  let seed = reqWalkSeed (ifaceOf "A") [intM]
  match reqWalkEnter seed (ifaceOf "A") [intM]
    ReqCycle parent parentArgs goal goalArgs =>
      expectEqual
        ("A", ["Int"], "A", ["Int"])
        (parent.irName, map ppMono parentArgs, goal.irName, map ppMono goalArgs)
    _ => expectEqual "a cycle" "another step"

test "the same arguments under another interface are a different goal, not a cycle" =
  let seed = reqWalkSeed (ifaceOf "A") [intM]
  expectTrue (isSome (onward (reqWalkEnter seed (ifaceOf "B") [intM])))

test "a goal smaller than the one before it is entered without spending fuel" =
  let seed = reqWalkSeed (ifaceOf "A") [boxOf intM]
  expectEqual
    (Some (fuelOf (enteredGoalKey seed)))
    (map fuelOf (stepKey (reqWalkEnter seed (ifaceOf "A") [intM])))

test "a goal that does not shrink spends one unit of fuel" =
  let seed = reqWalkSeed (ifaceOf "A") [intM]
  expectEqual
    (map (n => n - 1) (parseFuel (enteredGoalKey seed)))
    (stepKey (reqWalkEnter seed (ifaceOf "B") [intM]) |> bindOpt parseFuelOf)

parseFuelOf : String -> Option Int
parseFuelOf key = parseFuel key

bindOpt : (a -> Option b) -> Option a -> Option b
bindOpt f (Some x) = f x
bindOpt _ None = None

-- The goals `G0 .. G(n-1)` over one argument vector: none is smaller than the one before
-- it, and no two are the same goal.
flatGoals : Int -> List (IfaceRef, List Mono)
flatGoals n
  | n <= 0 = []
  | otherwise =
    flatGoals (n - 1) ++ [(ifaceOf "G\{intToString (n - 1)}", [intM])]

test "a chain of goals that never shrink is cut off by a step that names the goal" =
  expectTrue
    (isDeep (firstStop (reqWalkSeed (ifaceOf "Seed") [intM]) (flatGoals 200)))

firstStop : ReqWalk -> List (IfaceRef, List Mono) -> (Int, Option ReqStep)
firstStop walk goals = firstStopGo 0 walk goals

firstStopGo : Int ->
  ReqWalk ->
  List (IfaceRef, List Mono) ->
  (Int, Option ReqStep)
firstStopGo n _ [] = (n, None)
firstStopGo n walk ((iface, args) :: rest) = match reqWalkEnter walk iface args
  ReqOn next => firstStopGo (n + 1) next rest
  stop => (n, Some stop)

isDeep : (Int, Option ReqStep) -> Bool
isDeep (_, Some (ReqDeep _ _)) = True
isDeep _ = False

test "the steps taken before the cut-off are the fuel the walk starts with" =
  let (steps, _) =
    firstStop (reqWalkSeed (ifaceOf "Seed") [intM]) (flatGoals 200)
  expectEqual
    (parseFuel (enteredGoalKey (reqWalkSeed (ifaceOf "Seed") [intM])))
    (Some steps)

parseFuel : String -> Option Int
parseFuel key = stringToInt (fuelOf key)

test "a goal that closes on the path is a cycle even when fuel is gone" =
  match enterAll (reqWalkSeed (ifaceOf "Seed") [intM]) (flatGoals 20)
    Some walk => match reqWalkEnter walk (ifaceOf "G3") [intM]
      ReqCycle _ _ _ _ => pass
      _ => expectEqual "a cycle" "another step"
    None => expectEqual "a walk" "no walk"

-- ── head matching ─────────────────────────────────────────────────────────

test "a head variable binds the whole type at its position" =
  expectEqual
    (Some [("a", "Int")])
    (map
      (bs => map (b => (fst b, ppMono (snd b))) bs)
      (positionBindings (headsOf "x : a") [intM] []))

test "a head matches position by position and its bindings follow position order" =
  expectEqual
    (Some [("a", "Int"), ("b", "Bool")])
    (map
      (bs => map (b => (fst b, ppMono (snd b))) bs)
      (positionBindings
        (headsOf (joinNl ["x : a", "y : b"]))
        [intM, tconBuiltin "Bool"]
        []))

test "a head and a goal of different lengths do not match" =
  expectEqual
    None
    (map
      (bs => map (b => fst b) bs)
      (positionBindings (headsOf "x : a") [intM, intM] []))

test "a variable the head repeats pairs each later binding with its first" =
  let pairs =
    repeatedBindings
      [
        ("a", intM),
        ("b", tconBuiltin "Bool"),
        ("a", tconBuiltin "Bool"),
        ("a", tconBuiltin "String"),
      ]
      []
  expectEqual
    [("Int", "Bool"), ("Int", "String")]
    (map (p => (ppMono (fst p), ppMono (snd p))) pairs)

test "a head that repeats nothing leaves nothing to equate" =
  expectEqual
    0
    (length (repeatedBindings [("a", intM), ("b", tconBuiltin "Bool")] []))

test "a type parameter the head did not bind reads as a rigid variable of that name" = expectAll
  [
    expectEqual "Int" (ppMono (paramMonoOf [("a", intM)] "a")),
    expectEqual (ppMono (TRigid "b")) (ppMono (paramMonoOf [("a", intM)] "b")),
  ]

test "a goal is bucketed by the head of its first position" = expectAll [
  expectEqual None (goalHeadCon []),
  expectEqual None (goalHeadCon [varM 1]),
  expectEqual (goalHeadCon [boxOf intM]) (goalHeadCon [boxOf (varM 2), intM]),
  expectSatisfies "a head" isSome (goalHeadCon [intM]),
]

test "a goal with fewer positions than an instance head is a projection of a wider goal" =
  let wide = rowOf 0 "A" (joinNl ["x : a", "y : b"])
  expectAll [
    expectTrue (goalIsProjection [intM] [wide]),
    expectFalse (goalIsProjection [intM] [rowOf 1 "A" "x : Box a"]),
    expectFalse (goalIsProjection [intM] []),
  ]

-- ── an instance's identity word ───────────────────────────────────────────

test "an instance row's word is its interface and head, whichever rows surround it" =
  let first = rowOf 0 "Sz" "x : Box Int"
  let moved = rowOf 7 "Sz" "x : Box Int"
  expectAll [
    expectEqual (rowRouteKey first) (rowRouteKey moved),
    expectNotEqual
      (rowRouteKey first)
      (rowRouteKey (rowOf 0 "Sz" "x : Box Bool")),
    expectNotEqual
      (rowRouteKey first)
      (rowRouteKey (rowOf 0 "Other" "x : Box Int")),
  ]

-- ── what an instance, a given and a superclass entail ─────────────────────

sizeable : String
sizeable =
  """
interface Sz a where
  sz : a -> Int
impl Sz Int where
  sz _ = 1
data Box a = Box a
data Pair a b = Pair a b
"""

test "a goal an instance answers is entailed" =
  expectChecks (joinNl [sizeable, "f : Int", "f = sz 1"])

test "a goal no instance answers is rejected as having no impl" =
  expectRejectedWith ["T-NO-IMPL"] (joinNl [sizeable, "f : Int", "f = sz True"])

test "an instance's prerequisite is owed at the use, and is met by the instance of its argument" = expectEach
  [
    (
      "prerequisite met",
      expectChecks
        """
\{sizeable}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
f : Int
f = sz (Box 1)
""",
    ),
    (
      "prerequisite absent",
      expectRejectedWith
        ["T-NO-IMPL"]
        """
\{sizeable}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
f : Int
f = sz (Box True)
""",
    ),
  ]

test "a given discharges the prerequisite of the instance a goal selects" =
  expectChecks
    """
\{sizeable}
impl Sz (Box a) requires Sz a where
  sz (Box x) = sz x
h : Sz a => Box a -> Int
h b = sz b
"""

test "an instance of a sub-interface without the instance of its super is rejected" =
  expectRejectedWith
    ["T-MISSING-SUPER-IMPL"]
    """
\{sizeable}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
impl Sz2 Bool where
  sz2 _ = 1
"""

test "an instance of a sub-interface beside its super's instance is entailed" =
  expectChecks
    """
\{sizeable}
interface Sz2 a requires Sz a where
  sz2 : a -> Int
impl Sz2 Int where
  sz2 _ = 1
f : Int
f = sz2 1 + sz 2
"""

overlapping : String
overlapping =
  """
\{sizeable}
impl Sz (Box a) where
  sz _ = 2
impl Sz (Box Int) where
  sz _ = 3
"""

test "of two instances that both match, the strictly more specific one is the route" =
  let specificOnly =
    routeWordsOf
      (joinNl [
        sizeable, "impl Sz (Box Int) where", "  sz _ = 3", "f : Int",
        "f = sz (Box 1)"
      ])
  expectAll [
    expectChecks (joinNl [overlapping, "f : Int", "f = sz (Box 1)"]),
    expectEqual
      specificOnly
      (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box 1)"])),
  ]

test "the general instance is the route for a goal only it matches" =
  let generalOnly =
    routeWordsOf
      (joinNl [
        sizeable, "impl Sz (Box a) where", "  sz _ = 2", "f : Int",
        "f = sz (Box True)"
      ])
  expectEqual
    generalOnly
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box True)"]))

test "the specific and the general instance name different routes" =
  expectNotEqual
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box 1)"]))
    (routeWordsOf (joinNl [overlapping, "f : Int", "f = sz (Box True)"]))

incomparable : String
incomparable =
  """
\{sizeable}
impl Sz (Pair a Int) where
  sz _ = 2
impl Sz (Pair Int b) where
  sz _ = 3
"""

test "two matching instances neither of which is more specific are an ambiguous instance" =
  expectRejectedWith
    ["T-AMBIGUOUS-INSTANCE"]
    (joinNl [incomparable, "f : Int", "f = sz (Pair 1 2)"])

test "a goal only one of two incomparable instances matches is not ambiguous" =
  expectChecks (joinNl [incomparable, "f : Int", "f = sz (Pair True 2)"])

-- ── the law ───────────────────────────────────────────────────────────────

-- The instance heads and goals of the property, as source text.  Each head overlaps some of
-- the goals; `Pair a Int` and `Pair Int b` are incomparable where both match.
headPool : List String
headPool = ["Box a", "Box Int", "Pair a Int", "Pair Int b", "Box Bool"]

goalPool : List String
goalPool = ["Box 1", "Box True", "Pair 1 2", "Pair True 2", "Pair 1 True"]

data RouteCase = RouteCase (List Int) Int

impl Arbitrary RouteCase where
  arbitrary () = RouteCase (pickHeads (randomInt 1 5) []) (randomInt 0 4)
  shrink (RouteCase heads goal) = match heads
    _ :: rest@(_ :: _) => [RouteCase rest goal]
    _ => []

-- Up to [n] distinct pool indices, in draw order.
pickHeads : Int -> List Int -> <Rand> List Int
pickHeads n acc
  | n <= 0 = acc
  | otherwise =
    let i = randomInt 0 4
    if elem i acc then pickHeads (n - 1) acc else pickHeads (n - 1) (i :: acc)

programOf : List Int -> Int -> String
programOf heads goal =
  joinNl
    ([sizeable]
      ++ map implText heads
      ++ ["f : Int", "f = sz (\{nth goalPool goal})"])

implText : Int -> String
implText i =
  "impl Sz (\{nth headPool i}) where\n  sz _ = \{intToString (i + 2)}\n"

nth : List String -> Int -> String
nth xs i = match drop i xs
  x :: _ => x
  [] => ""

-- Law: the route a goal is stamped with, and whether it is accepted, do not depend on the
-- order the instances are declared in.  Precondition: the goal is accepted, so that a
-- route exists to compare; ambiguous draws check the verdict alone.
prop "a goal's route and verdict do not depend on the order its instances are declared in" (c : RouteCase) =
  let (RouteCase heads goal) = c
  let forward = programOf heads goal
  let backward = programOf (reverse heads) goal
  checkCodes forward == checkCodes backward
    && (checkCodes forward /= []
      || routeWordsOf forward == routeWordsOf backward)
