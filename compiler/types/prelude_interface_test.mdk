import types.invocation_basis.{publishInvocationView, frozenInvocationView}
import types.interface_sexp.{invocationViewSExp}
import support.sexp_value.{renderSExp}
import types.invocation_basis.{readInvocationView}
import types.tc_types.{InvocationView(..)}
-- Tests for the prelude interface value: freeze and thaw over a hand-built
-- core pass result, the key comparison, and the one-entry process cache.
--
-- No field of `PreludeInterface` has a type that carries a lineage id or a
-- binder ordinal: its types are `List`, `OrdMap`, `Map Int Unit`, `Int`,
-- `Bool`, `PubScheme`, `RecordInfo` and the frozen slot, prefix and
-- population forms, none of which names an `EvId` or `Ident` ordinal.
import test.{expectEqual, expectNone, expectAll, expectEach, fail}
import list.{zip}
import map as M
import support.ordmap.{
  omEmpty, omInsert, omKeys, omLookup, omFromNames, omHasKey
}
import types.effect_domain.{Param(..)}
import types.effect_rows.{EffRow(..), Atom, atomBuiltin}
import types.prelude_interface.{
  PreludeInterface(..), GraphRunSeed(..), freezeInterface, thawInterface,
  standaloneRows, seedPreludeInterface, preludeCacheHit,
  currentPreludeInterface, InterfaceKey(..), interfaceKeyOf, keysMatch
}
import types.publish.{PubScheme(..), liveCells, ppPubScheme, freezeRows}
import types.registry.{spFromFloor, spFloor}
import types.repr.{Mono(..), Tyvar(..), Scheme(..), VecObl(..), IfaceRef(..)}
import frontend.ast.{TyConOrigin(..), Decl, externDecls}
import types.tc_types.{
  GraphCtx(..), CrossRun(..), GraphRun(..), BuiltinClasses(..),
  PredicateSlot(..), MethodPredicateSlot(..), CDeclaredPrefix(..),
  RecordInfo(..)
}
import types.typecheck.{defaultDriveInputs, checkModulesChainReportForGraph}
import types.interface_sexp.{
  PreludeInterfaceFile(..), InterfaceSection(..), encodeInterface
}
import types.interface_sexp_test.{prelude, fileKey}
import frontend.desugar.{desugar, desugarIn}
import frontend.parser.{parse, parseLocated}

-- ── a small core pass result ────────────────────────────────────────────────

-- The graph record a drive of one tiny module over a tiny prelude ends in: real
-- cross-run and graph-run records, which typecheck does not export a mint for.
graphOf : Unit -> GraphCtx
graphOf _ =
  let (_, gctx) =
    checkModulesChainReportForGraph
      defaultDriveInputs
      False
      None
      ""
      [None]
      []
      (desugar (parse "data Option a = None | Some a"))
      [("m", desugar (parseLocated "export data Q = Q Int"))]
  gctx

identityPub : PubScheme
identityPub =
  let cell = Ref (Unbound 7 1)
  PubScheme {
    psScheme =
      Forall
        [7]
        []
        []
        []
        (EffRow [] None)
        (TFun (TVar cell) (EffRow [] None) (TVar cell)),
    psContext = [],
  }

-- A row that carries an obligation context, so a dropped or zeroed context
-- changes the rendering.
obligedPub : PubScheme
obligedPub = { identityPub |
  psContext = [
    VecObl {
      voIface = IfaceRef { irName = "Eq", irOrigin = OriginBuiltin },
      voIds = [7],
      voArgs = [],
    },
  ],
}

coreRows : List (String, PubScheme)
coreRows = [("id", identityPub), ("also", obligedPub)]

standaloneNames : M.Map String Unit
standaloneNames = omInsert "id" () omEmpty

-- A graph record whose cross-run universes and graph run carry the values the
-- core pass would have left, for `freezeInterface` to read.
primedCtx : Unit -> GraphCtx
primedCtx _ =
  let g = graphOf ()
  g.crossRun.universeCtorPop :=
    spFromFloor (omInsert "Foo" (thawed identityPub) omEmpty)
  g.graphRun.tyvarCounter := 41
  g.graphRun.effvarCounter := 5
  g.graphRun.anyExistentialsRef := True
  g

thawed : PubScheme -> Scheme
thawed p = p.psScheme

sampleInterface : Unit -> PreludeInterface
sampleInterface _ =
  let g = primedCtx ()
  freezeInterface
    g.crossRun
    g.graphRun
    g.builtinExternNamesRef.value
    coreRows
    standaloneNames
    (InvocationView [] [] [])

-- What two interfaces must agree on to count as equal: every field of the
-- record.  Schemes render with their context; a field whose type has no
-- renderer renders as its names, ids and counts.
renderInterface : PreludeInterface -> List String
renderInterface pi =
  map (row => "\{fst row} : \{ppPubScheme (snd row)}") pi.piCore
    ++ map (row => "ctor \{fst row} : \{ppPubScheme (snd row)}") (ctorRows pi)
    ++ [
      "funNames \{omKeys pi.piFunNames}",
      "dispatch \{map renderDispatch pi.piMethodDispatchIdx}",
      "dataCtors \{map renderDataCtor pi.piDataCtors}",
      "records \{map renderRecord (M.entries (spFloor pi.piRecordPop))}",
      "builtin \{renderBuiltin pi.piBuiltinClasses}",
      "funSlots \{map renderSlots pi.piFunPredicateSlots}",
      "funSlotsQual \{map renderSlotsQual pi.piFunPredicateSlotsQual}",
      "declared \{map renderDeclared pi.piFunConstraintDeclared}",
      "declaredQual \{map renderDeclaredQual pi.piFunConstraintDeclaredQual}",
      "methodSlots \{map renderMethodSlots pi.piMethodPredicateSlots}",
      "methodSlotsQual \{map renderMethodSlotsQual pi.piMethodPredicateSlotsQual}",
      "ctorExistentials \{map fst (M.entries pi.piCtorExistentials)}",
      "anyExistentials \{pi.piAnyExistentials}",
      "externs \{omKeys pi.piExternNames}",
      "tyvar \{pi.piTyvarNext}",
      "effvar \{pi.piEffvarNext}",
      "standalone \{omKeys pi.piStandaloneNames}",
      renderSExp (invocationViewSExp pi.piInvocationView),
    ]

renderDispatch : ((IfaceRef, String), Int) -> String
renderDispatch ((iface, name), idx) = "\{iface.irName}.\{name}@\{idx}"

renderDataCtor : (a, (b, List String, List c)) -> String
renderDataCtor (_, (_, names, variants)) = "\{names}/\{length variants}"

renderRecord : (String, RecordInfo) -> String
renderRecord (name, RecordInfo ids authIds _ fields index) =
  "\{name} \{ids} \{authIds} \{map fst fields} \{map fst (M.entries index)}"

renderBuiltin : BuiltinClasses -> String
renderBuiltin b =
  "\{b.bcNumPresent} \{b.bcEqPresent} \{b.bcOrdPresent} \{b.bcSemigroupPresent} \{b.bcPreludeSeeded}"

renderSlot : PredicateSlot -> String
renderSlot s = "\{s.psIface.irName}\{s.psBoundIds}"

renderSlots : (String, List PredicateSlot) -> String
renderSlots (k, slots) = "\{k} \{map renderSlot slots}"

renderSlotsQual : ((String, String), List PredicateSlot) -> String
renderSlotsQual ((m, k), slots) = "\{m}.\{k} \{map renderSlot slots}"

renderDeclaredPrefix : CDeclaredPrefix -> String
renderDeclaredPrefix CDPUnknown = "?"
renderDeclaredPrefix (CDPLen n) = "\{n}"

renderDeclared : (String, CDeclaredPrefix) -> String
renderDeclared (k, d) = "\{k} \{renderDeclaredPrefix d}"

renderDeclaredQual : ((String, String), CDeclaredPrefix) -> String
renderDeclaredQual ((m, k), d) = "\{m}.\{k} \{renderDeclaredPrefix d}"

renderMethodSlot : MethodPredicateSlot -> String
renderMethodSlot m = "\{renderSlot m.mpsPredicate}\{m.mpsPositions}"

renderMethodSlots : (String, List MethodPredicateSlot) -> String
renderMethodSlots (k, slots) = "\{k} \{map renderMethodSlot slots}"

renderMethodSlotsQual : ((String, String), List MethodPredicateSlot) -> String
renderMethodSlotsQual ((m, k), slots) =
  "\{m}.\{k} \{map renderMethodSlot slots}"

ctorRows : PreludeInterface -> List (String, PubScheme)
ctorRows pi = M.entries (spFloor pi.piCtorPop)

-- freeze, thaw into a fresh graph run, freeze again
roundTrip : PreludeInterface -> PreludeInterface
roundTrip pi =
  let g = graphOf ()
  let (bindings, core, cross, seed) = thawInterface g pi
  let run = (graphOf ()).graphRun
  run.tyvarCounter := seed.grsTyvarNext
  run.effvarCounter := seed.grsEffvarNext
  run.anyExistentialsRef := seed.grsAnyExistentials
  run.ctorExistentialsRef := seed.grsCtorExistentials
  freezeInterface
    cross
    run
    pi.piExternNames
    (freezeRows
      (map
        (pair => (
          fst (fst pair),
          PubScheme {
            psScheme = snd (fst pair),
            psContext = (snd (snd pair)).psContext,
          },
        ))
        (zip bindings.mbSchemes core)))
    pi.piStandaloneNames
    (readInvocationView pi.piInvocationView)

test "freeze after thaw after freeze renders equal" =
  let pi = sampleInterface ()
  expectEqual (renderInterface pi) (renderInterface (roundTrip pi))

test "a thawed interface holds no live cell" =
  let pi = sampleInterface ()
  let (bindings, _, _, _) = thawInterface (graphOf ()) pi
  expectAll
    (map
      (row => expectEqual [] (liveCells (fst row) (snd row)))
      (map
          (row => (fst row, PubScheme { psScheme = snd row, psContext = [] }))
          bindings.mbSchemes
        ++ ctorRows (roundTrip pi)))

test "standalone rows keep the first published row per name" =
  let row = n => Forall [] [] [] [] (EffRow [] None) (TCon n OriginBuiltin)
  let rendered = s => ppPubScheme PubScheme { psScheme = s, psContext = [] }
  let rows =
    standaloneRows standaloneNames [("id", row "First"), ("id", row "Second")]
  expectEqual
    (Some (rendered (row "First")))
    (map rendered (omLookup "id" rows))

test "thaw rebuilds the standalone schemes from the named rows" =
  let (bindings, _, _, _) = thawInterface (graphOf ()) (sampleInterface ())
  expectEqual ["id"] (omKeys bindings.mbStandaloneSchemes)

-- ── the key ─────────────────────────────────────────────────────────────────

keyA : InterfaceKey
keyA = interfaceKeyOf 1 [("core.mdk", "aa11"), ("list.mdk", "bb22")] "c1"

test "interface keys name the first differing component" =
  let edited =
    interfaceKeyOf 1 [("core.mdk", "aa12"), ("list.mdk", "bb22")] "c1"
  expectEach [
    (
      "equal",
      expectNone (keysMatch keyA (interfaceKeyOf 1 keyA.ikSources "c1")),
    ),
    ("one source byte", expectEqual (Some "sources") (keysMatch keyA edited)),
    (
      "compiler",
      expectEqual
        (Some "compiler")
        (keysMatch keyA (interfaceKeyOf 1 keyA.ikSources "c2")),
    ),
    (
      "format",
      expectEqual
        (Some "format")
        (keysMatch keyA (interfaceKeyOf 2 keyA.ikSources "c1")),
    ),
  ]

-- ── the cache ───────────────────────────────────────────────────────────────

ioNet : List Atom
ioNet = [atomBuiltin "Net" (PPrefix (Some "a"))]

ioFs : List Atom
ioFs = [atomBuiltin "Fs" (PPath None)]

tyvarsAt : (Int, Int) -> List Atom -> Option Int
tyvarsAt generation join =
  map (pi => pi.piTyvarNext) (preludeCacheHit generation join)

test "a listed join hits its section; an unlisted join and another generation miss" =
  let pi = sampleInterface ()
  let other = { pi | piTyvarNext = 99 }
  let _ = seedPreludeInterface (3, 4) [([[]], pi), ([ioNet], other)]
  expectAll [
    expectEqual (Some 41) (tyvarsAt (3, 4) []),
    expectEqual (Some 99) (tyvarsAt (3, 4) ioNet),
    expectNone (tyvarsAt (3, 4) ioFs),
    expectNone (tyvarsAt (3, 5) []),
    expectEqual 2 (length (currentPreludeInterface ())),
  ]

-- ── the extern catalog ──────────────────────────────────────────────────────

-- A runtime declaring one extern the real runtime does not, over a one-type core.
foreignPrelude : String -> (List Decl, List Decl)
foreignPrelude name = (
  desugar (parse "extern \{name} : Unit -> Int\n"),
  desugar (parse "data Option a = None | Some a\n"),
)

-- The graph record a drive of a one-line module ends in.  Under no prelude key the
-- drive neither reads nor writes the prelude cache.
driveWith : Option (Int, Int) -> (List Decl, List Decl) -> GraphCtx
driveWith key (runtimeDecls, coreDecls) =
  snd
    (checkModulesChainReportForGraph
      defaultDriveInputs
      False
      key
      ""
      []
      runtimeDecls
      coreDecls
      [("m", desugarIn "m" (parseLocated "x = 1"))])

-- The cache's interfaces after a drive under a prelude key no earlier drive used,
-- so the drive misses and freezes its own.
keyedDrive : Int -> (List Decl, List Decl) -> List PreludeInterface
keyedDrive n pre =
  let _ = driveWith (Some (6403, n)) pre
  map snd (currentPreludeInterface ())

externNamesOf : List Decl -> List String
externNamesOf decls =
  omKeys (omFromNames (map (d => d.edName) (externDecls decls)) omEmpty)

encodedSections : List PreludeInterface -> String
encodedSections pis = encodeInterface PreludeInterfaceFile {
  ifKey = fileKey,
  ifSections =
    map (pi => InterfaceSection { isJoins = [], isInterface = pi }) pis,
}

test "a prelude interface holds exactly the externs its own runtime declares" =
  match prelude
    Err e => fail e
    Ok real =>
      let _ = keyedDrive 1 (foreignPrelude "zzForeignExternA")
      expectEqual
        [externNamesOf (fst real)]
        (map (pi => omKeys pi.piExternNames) (keyedDrive 2 real))

test "the encoded real prelude does not depend on a runtime driven before it" =
  match prelude
    Err e => fail e
    Ok real =>
      let before = encodedSections (keyedDrive 3 real)
      let _ = keyedDrive 4 (foreignPrelude "zzForeignExternB")
      expectEqual before (encodedSections (keyedDrive 5 real))

-- The second keyed drive of the real prelude hits the interface the first one
-- cached, after an unkeyed drive of another runtime that left the cache alone.
test "a prelude interface hit keeps the externs of a runtime driven before it" =
  match prelude
    Err e => fail e
    Ok real =>
      let _ = keyedDrive 6 real
      let _ = driveWith None (foreignPrelude "zzForeignExternC")
      let catalog =
        (driveWith (Some (6403, 6)) real).builtinExternNamesRef.value
      expectEqual
        []
        (filter
          (n => not (omHasKey n catalog))
          ("zzForeignExternC" :: externNamesOf (fst real)))

test "the owning invocation declaration basis is copied on freeze and read" =
  let cell = Ref (Unbound 902 1)
  let original =
    InvocationView [Forall [] [] [] [] (EffRow [] None) (TVar cell)] [] []
  let published = publishInvocationView original
  let detached = readInvocationView published
  let encoded = renderSExp (invocationViewSExp published)
  cell := Link (TCon "Int" OriginBuiltin)
  let _ = graphOf ()
  let schemeText view = match view
    InvocationView ctors _ _ =>
      map (sc => ppPubScheme PubScheme { psScheme = sc, psContext = [] }) ctors
  let mutate copy = match copy
    InvocationView [Forall _ _ _ _ _ (TVar c)] _ _ =>
      c := Link (TCon "Bool" OriginBuiltin)
    _ => ()
  let before = schemeText detached
  let _ = mutate detached
  expectEach [
    ("source changed", expectEqual ["Int"] (schemeText original)),
    (
      "published scheme is detached",
      expectEqual before (schemeText (readInvocationView published)),
    ),
    (
      "copy mutation changed only the copy",
      expectEqual ["Bool"] (schemeText detached),
    ),
    (
      "serialized basis is stable",
      expectEqual encoded (renderSExp (invocationViewSExp published)),
    ),
    (
      "refreeze is equal",
      expectEqual
        encoded
        (renderSExp
          (invocationViewSExp
            (publishInvocationView (readInvocationView published)))),
    ),
  ]
