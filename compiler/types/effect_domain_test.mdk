import test.{expectAll, expectEqual, expectFalse, expectTrue}
import list.{drop as listDrop}
import types.effect_domain.{
  Param(..), djoin, drender, dsub, extendParam, appendParam, dantichain,
  setCardCap, writtenSetProblem, dsubAny
}
import types.effect_rows.{atomBuiltin, atomsDiff, atomsUnion, renderAtoms}
import types.effect_authority.{Authority(..), authSub, authJoinAll}

test "prefix coverage is directed and respects the host boundary" = expectAll [
  expectTrue
    (dsub
      (PPrefix (Some "good.example/api/"))
      (PPrefix (Some "good.example/*"))),
  expectFalse
    (dsub
      (PPrefix (Some "good.example.evil/api/"))
      (PPrefix (Some "good.example/*"))),
  expectFalse (dsub (PPrefix None) (PPrefix (Some "good.example/*"))),
]

test "the empty prefix is the domain top under join, coverage and rendering" = expectAll
  [
    expectTrue (dsub (PPrefix None) (PPrefix (Some ""))),
    expectTrue (dsub (PPrefix (Some "")) (PPrefix None)),
    expectEqual
      (drender (PPrefix None))
      (drender (djoin (PPrefix (Some "")) (PPrefix (Some "")))),
    expectEqual (drender (PPrefix None)) (drender (PPrefix (Some ""))),
    expectEqual
      "FileWrite"
      (renderAtoms
        (atomsUnion
          [atomBuiltin "FileWrite" (PPrefix (Some ""))]
          [atomBuiltin "FileWrite" (PPrefix (Some "/a"))])),
  ]

test "set coverage includes every possible authority" =
  let joined = djoin (PSet (Some ["HOME"])) (PSet (Some ["PATH"]))
  expectAll [
    expectEqual " {\"HOME\", \"PATH\"}" (drender joined),
    expectTrue (dsub (PSet (Some ["HOME"])) joined),
    expectFalse (dsub joined (PSet (Some ["HOME"]))),
  ]

test "a missing product axis is unconstrained rather than empty" =
  let host = PPrefix (Some "good.example/*")
  let readOnly = PProduct [("Host", host), ("Method", PSet (Some ["GET"]))]
  let anyMethod = PProduct [("Host", host)]
  expectAll [
    expectTrue (dsub readOnly anyMethod),
    expectFalse (dsub anyMethod readOnly),
    expectEqual (drender anyMethod) (drender (djoin readOnly anyMethod)),
  ]

test "a row retains a same-label authority which exceeds its bound" =
  let actual = [atomBuiltin "FileWrite" (PPrefix (Some "/etc/passwd"))]
  let bound = [atomBuiltin "FileWrite" (PPrefix (Some "tmp/*"))]
  expectEqual "FileWrite \"/etc/passwd\"" (renderAtoms (atomsDiff actual bound))

test "combining different capabilities never discards either label" =
  expectEqual
    "Clock, Env {\"HOME\"}"
    (renderAtoms
      (atomsUnion
        [atomBuiltin "Env" (PSet (Some ["HOME"]))]
        [atomBuiltin "Clock" PUnit]))

test "larger rows use the canonical label index without changing order" =
  let all =
    atomsUnion
      [atomBuiltin "F" PUnit, atomBuiltin "D" PUnit, atomBuiltin "B" PUnit]
      [atomBuiltin "E" PUnit, atomBuiltin "C" PUnit, atomBuiltin "A" PUnit]
  let remaining =
    atomsDiff
      [
        atomBuiltin "F" PUnit,
        atomBuiltin "D" PUnit,
        atomBuiltin "B" PUnit,
        atomBuiltin "A" PUnit,
      ]
      [atomBuiltin "D" PUnit, atomBuiltin "A" PUnit, atomBuiltin "C" PUnit]
  expectAll [
    expectEqual "A, B, C, D, E, F" (renderAtoms all),
    expectEqual "B, F" (renderAtoms remaining),
  ]

test "an extension keeps a pattern, extends an exact element, tops a Set member" =
  let schema = PProduct [("Host", PPrefix None), ("Method", PSet None)]
  expectAll [
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (extendParam (PPrefix None) (PPrefix (Some "cfg/")))),
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (extendParam (PPrefix None) (PPrefix (Some "cfg/*")))),
    expectEqual
      (drender (PSet None))
      (drender (extendParam (PSet None) (PSet (Some ["GET"])))),
    expectEqual
      (drender
        (PProduct [
          ("Host", PPrefix (Some "a.com/*")),
          ("Method", PSet (Some ["GET"])),
        ]))
      (drender
        (extendParam
          schema
          (PProduct [
            ("Host", PPrefix (Some "a.com/")),
            ("Method", PSet (Some ["GET"])),
          ]))),
    expectEqual
      (drender (PPrefix (Some "cfg/app.toml")))
      (drender (appendParam (PPrefix None) ".toml" (PPrefix (Some "cfg/app")))),
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (appendParam (PPrefix None) ".toml" (PPrefix (Some "cfg/*")))),
  ]

pat : String -> Param
pat s = PPrefix (Some s)

test "a written Prefix row keeps the set of its patterns, never their join" =
  let both =
    atomsUnion
      [atomBuiltin "FileRead" (pat "cfg/*")]
      [atomBuiltin "FileRead" (pat "tmp/*")]
  let siblings =
    atomsUnion
      [atomBuiltin "FileRead" (pat "cfg/a/*")]
      [atomBuiltin "FileRead" (pat "cfg/b/*")]
  expectAll
    [
      expectEqual "FileRead \"cfg/*\", FileRead \"tmp/*\"" (renderAtoms both),
      -- the join of two siblings would be `cfg/*`, admitting cfg/secret
      expectEqual
        "FileRead \"cfg/a/*\", FileRead \"cfg/b/*\""
        (renderAtoms siblings),
      expectEqual
        "FileRead \"cfg/secret\""
        (renderAtoms
          (atomsDiff [atomBuiltin "FileRead" (pat "cfg/secret")] siblings)),
      expectEqual
        ""
        (renderAtoms
          (atomsDiff [atomBuiltin "FileRead" (pat "cfg/b/key")] siblings)),
      -- a member another covers is dropped
      expectEqual
        "FileRead \"cfg/*\""
        (renderAtoms
          (atomsUnion
            [atomBuiltin "FileRead" (pat "cfg/app.toml")]
            [atomBuiltin "FileRead" (pat "cfg/*")])),
    ]

test "a set is covered when each member is covered by some element" = expectAll
  [
    expectTrue
      (authSub
        (authJoinAll [AConst (pat "a.com/x"), AConst (pat "a.com/y")])
        (AConst (pat "a.com/*"))),
    expectFalse
      (authSub
        (authJoinAll [AConst (pat "a.com/x"), AConst (pat "b.com/y")])
        (AConst (pat "a.com/*"))),
    expectTrue
      (authSub
        (AConst (pat "b.com/y"))
        (authJoinAll [AConst (pat "a.com/*"), AConst (pat "b.com/*")])),
    expectFalse
      (authSub
        (AConst (pat "evil.net/y"))
        (authJoinAll [AConst (pat "a.com/*"), AConst (pat "b.com/*")])),
  ]

test "Set members and Products differing in one Set axis merge exactly" =
  let get = PProduct [("Host", pat "a.com/*"), ("Method", PSet (Some ["GET"]))]
  let post =
    PProduct [("Host", pat "a.com/*"), ("Method", PSet (Some ["POST"]))]
  let otherHost =
    PProduct [("Host", pat "b.com/*"), ("Method", PSet (Some ["POST"]))]
  expectAll
    [
      expectEqual
        [" {\"HOME\", \"PATH\"}"]
        (map drender (dantichain [PSet (Some ["PATH"]), PSet (Some ["HOME"])])),
      expectEqual
        [" Host=\"a.com/*\" Method={\"GET\", \"POST\"}"]
        (map drender (dantichain [get, post])),
      -- a pointwise join would admit (a.com, POST); the set does not
      expectEqual 2 (length (dantichain [get, otherHost])),
      expectFalse
        (authSub
          (AConst
            (PProduct [
              ("Host", pat "a.com/*"),
              ("Method", PSet (Some ["POST"])),
            ]))
          (authJoinAll [AConst get, AConst otherHost])),
    ]

test "a set of any size stays exact; only a written bound is capped" =
  let many = map (i => pat "d\{intToString i}/*") [1..=setCardCap + 1]
  expectAll [
    expectEqual (setCardCap + 1) (length (dantichain many)),
    expectTrue (isSome (writtenSetProblem many)),
    expectEqual None (writtenSetProblem (listDrop 1 many)),
    expectTrue
      (isSome
        (writtenSetProblem
          (map (i => PSet (Some ["V\{intToString i}"])) [1..=setCardCap + 1]))),
  ]

test "a Product set is canonical in any order, and covers by its union" =
  let t x y = PProduct [("X", PSet (Some [x])), ("Y", PSet (Some [y]))]
  let host h m = PProduct [("Host", pat h), ("Method", PSet (Some [m]))]
  expectAll
    [
      expectEqual
        (map drender (dantichain [t "1" "1", t "2" "1", t "1" "2"]))
        (map drender (dantichain [t "1" "2", t "1" "1", t "2" "1"])),
      expectEqual
        (map drender (dantichain [t "1" "1", t "2" "1", t "1" "2"]))
        (map
          drender
          (dantichain
            [
              PProduct [
                ("X", PSet (Some ["1", "2"])),
                ("Y", PSet (Some ["1"])),
              ],
              t "1" "2",
            ])),
      -- GET and POST to a.com/x lie within the two bound tuples together
      expectTrue
        (dsubAny (PProduct [
          ("Host", pat "a.com/x/*"),
          ("Method", PSet (Some ["GET", "POST"])),
        ]) [
          host "a.com/*" "GET",
          host "a.com/x/*" "POST",
        ]),
      expectFalse
        (dsubAny (host "a.com/y/*" "POST") [
          host "a.com/*" "GET",
          host "a.com/x/*" "POST",
        ]),
    ]
