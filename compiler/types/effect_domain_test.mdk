import test.{expectAll, expectEqual, expectFalse, expectTrue}
import support.util.{allList}
import list.{drop as listDrop}
import types.effect_domain.{
  Param(..), djoin, drender, dsub, extendParam, appendParam, dantichain,
  setCardCap, writtenSetProblem, dsubAny, productPrimaryLift
}
import types.effect_rows.{atomBuiltin, atomsDiff, atomsUnion, renderAtoms}
import types.effect_authority.{Authority(..), authSub, authJoinAll}

test "prefix coverage is directed and respects the host boundary" = expectAll [
  expectTrue
    (dsub
      (PPrefix (Some "good.example/api/"))
      (PPrefix (Some "good.example/*"))),
  expectFalse
    (dsub
      (PPrefix (Some "good.example.evil/api/"))
      (PPrefix (Some "good.example/*"))),
  expectFalse (dsub (PPrefix None) (PPrefix (Some "good.example/*"))),
]

test "a path label's order compares canonical paths" = expectAll [
  expectFalse (dsub (PPath (Some "data/../x")) (PPath (Some "data/*"))),
  expectFalse (dsub (PPath (Some "data/./../x")) (PPath (Some "data/*"))),
  expectFalse (dsub (PPath (Some "data//../x")) (PPath (Some "data/*"))),
  expectFalse (dsub (PPath (Some "data/sub/../../x")) (PPath (Some "data/*"))),
  expectFalse
    (dsub (extendParam (PPath (Some "data/../"))) (PPath (Some "data/*"))),
  expectTrue (dsub (PPath (Some "data/./x")) (PPath (Some "data/*"))),
  expectTrue (dsub (PPath (Some "data/sub/../x")) (PPath (Some "data/*"))),
  expectTrue (dsub (PPath (Some "x")) (PPath (Some "data/../x"))),
  expectEqual " \"x\"" (drender (PPath (Some "data/../x"))),
  expectEqual " \"./*\"" (drender (PPath (Some "data/../*"))),
]

test "a path above the working directory is under no bound within it" = expectAll
  [
    expectFalse (dsub (PPath (Some "..")) (PPath (Some "./*"))),
    expectFalse (dsub (PPath (Some "../x")) (PPath (Some "./*"))),
    expectFalse (dsub (PPath (Some "data/../../x")) (PPath (Some ".*"))),
    expectFalse (dsub (PPath (Some "data/../../*")) (PPath (Some "./*"))),
    expectTrue (dsub (PPath (Some "data/../../x")) (PPath (Some "../*"))),
    expectTrue (dsub (PPath (Some "../x")) (PPath (Some "*"))),
  ]

test "a path keeps its last component as written, so a suffix extends it" = expectAll
  [
    expectEqual
      " \"data/x\""
      (drender (appendParam "x" (PPath (Some "data/./")))),
    expectEqual " \"datax\"" (drender (appendParam "x" (PPath (Some "data")))),
    expectEqual
      [" \"data\"", " \"data/\""]
      (map drender (dantichain [PPath (Some "data/"), PPath (Some "data")])),
    expectEqual
      [" \"./*\""]
      (map
        drender
        (dantichain [PPath (Some "data/*"), PPath (Some "data/../*")])),
  ]

test "a path join covers both paths canonically, else is the whole domain" = expectAll
  [
    expectEqual
      " \"data/*\""
      (drender (djoin (PPath (Some "data/a")) (PPath (Some "data/b")))),
    expectEqual
      ""
      (drender (djoin (PPath (Some "data/../x")) (PPath (Some "data/y")))),
  ]

test "a user Prefix label's order compares text" = expectAll [
  expectTrue (dsub (PPrefix (Some "cfg/../x")) (PPrefix (Some "cfg/*"))),
  expectEqual " \"cfg/../x\"" (drender (PPrefix (Some "cfg/../x"))),
]

test "the empty prefix is the domain top under join, coverage and rendering" = expectAll
  [
    expectTrue (dsub (PPrefix None) (PPrefix (Some ""))),
    expectTrue (dsub (PPrefix (Some "")) (PPrefix None)),
    expectEqual
      (drender (PPrefix None))
      (drender (djoin (PPrefix (Some "")) (PPrefix (Some "")))),
    expectEqual (drender (PPrefix None)) (drender (PPrefix (Some ""))),
    expectEqual
      "FileWrite"
      (renderAtoms
        (atomsUnion
          [atomBuiltin "FileWrite" (PPrefix (Some ""))]
          [atomBuiltin "FileWrite" (PPrefix (Some "/a"))])),
  ]

test "effect parameters escape quotes and backslashes in rendered rows" = expectAll
  [
    expectEqual " \"a\\\"\\\\b\"" (drender (PPrefix (Some "a\"\\b"))),
    expectEqual
      " {\"POST\\\"\\\\GET\"}"
      (drender (PSet (Some ["POST\"\\GET"]))),
    expectEqual
      " A=\"x/1\\\" B=\\\"y/*\" M={\"POST\"}"
      (drender
        (PProduct [
          ("A", PPrefix (Some "x/1\" B=\"y/*")),
          ("M", PSet (Some ["POST"])),
        ])),
  ]

test "set coverage includes every possible authority" =
  let joined = djoin (PSet (Some ["HOME"])) (PSet (Some ["PATH"]))
  expectAll [
    expectEqual " {\"HOME\", \"PATH\"}" (drender joined),
    expectTrue (dsub (PSet (Some ["HOME"])) joined),
    expectFalse (dsub joined (PSet (Some ["HOME"]))),
  ]

test "a missing product axis is unconstrained rather than empty" =
  let host = PPrefix (Some "good.example/*")
  let readOnly = PProduct [("Host", host), ("Method", PSet (Some ["GET"]))]
  let anyMethod = PProduct [("Host", host), ("Method", PSet None)]
  expectAll [
    expectTrue (dsub readOnly anyMethod),
    expectFalse (dsub anyMethod readOnly),
    expectEqual (drender anyMethod) (drender (djoin readOnly anyMethod)),
  ]

test "a row retains a same-label authority which exceeds its bound" =
  let actual = [atomBuiltin "FileWrite" (PPrefix (Some "/etc/passwd"))]
  let bound = [atomBuiltin "FileWrite" (PPrefix (Some "tmp/*"))]
  expectEqual "FileWrite \"/etc/passwd\"" (renderAtoms (atomsDiff actual bound))

test "combining different capabilities never discards either label" =
  expectEqual
    "Clock, Env {\"HOME\"}"
    (renderAtoms
      (atomsUnion
        [atomBuiltin "Env" (PSet (Some ["HOME"]))]
        [atomBuiltin "Clock" PUnit]))

test "larger rows use the canonical label index without changing order" =
  let all =
    atomsUnion
      [atomBuiltin "F" PUnit, atomBuiltin "D" PUnit, atomBuiltin "B" PUnit]
      [atomBuiltin "E" PUnit, atomBuiltin "C" PUnit, atomBuiltin "A" PUnit]
  let remaining =
    atomsDiff
      [
        atomBuiltin "F" PUnit,
        atomBuiltin "D" PUnit,
        atomBuiltin "B" PUnit,
        atomBuiltin "A" PUnit,
      ]
      [atomBuiltin "D" PUnit, atomBuiltin "A" PUnit, atomBuiltin "C" PUnit]
  expectAll [
    expectEqual "A, B, C, D, E, F" (renderAtoms all),
    expectEqual "B, F" (renderAtoms remaining),
  ]

test "an extension keeps a pattern, extends an exact element, tops a Set member" = expectAll
  [
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (extendParam (PPrefix (Some "cfg/")))),
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (extendParam (PPrefix (Some "cfg/*")))),
    expectEqual
      (drender (PSet None))
      (drender (extendParam (PSet (Some ["GET"])))),
    expectEqual
      (drender
        (PProduct [
          ("Host", PPrefix (Some "a.com/*")),
          ("Method", PSet (Some ["GET"])),
        ]))
      (drender
        (extendParam
          (PProduct [
            ("Host", PPrefix (Some "a.com/")),
            ("Method", PSet (Some ["GET"])),
          ]))),
    expectEqual
      (drender (PPrefix (Some "cfg/app.toml")))
      (drender (appendParam ".toml" (PPrefix (Some "cfg/app")))),
    expectEqual
      (drender (PPrefix (Some "cfg/*")))
      (drender (appendParam ".toml" (PPrefix (Some "cfg/*")))),
  ]

pat : String -> Param
pat s = PPrefix (Some s)

test "a written Prefix row keeps the set of its patterns, never their join" =
  let both =
    atomsUnion
      [atomBuiltin "FileRead" (pat "cfg/*")]
      [atomBuiltin "FileRead" (pat "tmp/*")]
  let siblings =
    atomsUnion
      [atomBuiltin "FileRead" (pat "cfg/a/*")]
      [atomBuiltin "FileRead" (pat "cfg/b/*")]
  expectAll
    [
      expectEqual "FileRead \"cfg/*\", FileRead \"tmp/*\"" (renderAtoms both),
      -- the join of two siblings would be `cfg/*`, admitting cfg/secret
      expectEqual
        "FileRead \"cfg/a/*\", FileRead \"cfg/b/*\""
        (renderAtoms siblings),
      expectEqual
        "FileRead \"cfg/secret\""
        (renderAtoms
          (atomsDiff [atomBuiltin "FileRead" (pat "cfg/secret")] siblings)),
      expectEqual
        ""
        (renderAtoms
          (atomsDiff [atomBuiltin "FileRead" (pat "cfg/b/key")] siblings)),
      -- a member another covers is dropped
      expectEqual
        "FileRead \"cfg/*\""
        (renderAtoms
          (atomsUnion
            [atomBuiltin "FileRead" (pat "cfg/app.toml")]
            [atomBuiltin "FileRead" (pat "cfg/*")])),
    ]

test "a set is covered when each member is covered by some element" = expectAll
  [
    expectTrue
      (authSub
        (authJoinAll [AConst (pat "a.com/x"), AConst (pat "a.com/y")])
        (AConst (pat "a.com/*"))),
    expectFalse
      (authSub
        (authJoinAll [AConst (pat "a.com/x"), AConst (pat "b.com/y")])
        (AConst (pat "a.com/*"))),
    expectTrue
      (authSub
        (AConst (pat "b.com/y"))
        (authJoinAll [AConst (pat "a.com/*"), AConst (pat "b.com/*")])),
    expectFalse
      (authSub
        (AConst (pat "evil.net/y"))
        (authJoinAll [AConst (pat "a.com/*"), AConst (pat "b.com/*")])),
  ]

test "Set members and Products differing in one Set axis merge exactly" =
  let get = PProduct [("Host", pat "a.com/*"), ("Method", PSet (Some ["GET"]))]
  let post =
    PProduct [("Host", pat "a.com/*"), ("Method", PSet (Some ["POST"]))]
  let otherHost =
    PProduct [("Host", pat "b.com/*"), ("Method", PSet (Some ["POST"]))]
  expectAll
    [
      expectEqual
        [" {\"HOME\", \"PATH\"}"]
        (map drender (dantichain [PSet (Some ["PATH"]), PSet (Some ["HOME"])])),
      expectEqual
        [" Host=\"a.com/*\" Method={\"GET\", \"POST\"}"]
        (map drender (dantichain [get, post])),
      -- a pointwise join would admit (a.com, POST); the set does not
      expectEqual 2 (length (dantichain [get, otherHost])),
      expectFalse
        (authSub
          (AConst
            (PProduct [
              ("Host", pat "a.com/*"),
              ("Method", PSet (Some ["POST"])),
            ]))
          (authJoinAll [AConst get, AConst otherHost])),
    ]

test "a set of any size stays exact; only a written bound is capped" =
  let many = map (i => pat "d\{intToString i}/*") [1..=setCardCap + 1]
  expectAll [
    expectEqual (setCardCap + 1) (length (dantichain many)),
    expectTrue (isSome (writtenSetProblem many)),
    expectEqual None (writtenSetProblem (listDrop 1 many)),
    expectTrue
      (isSome
        (writtenSetProblem
          (map (i => PSet (Some ["V\{intToString i}"])) [1..=setCardCap + 1]))),
  ]

test "a Product set's form is independent of order, and covers by its union" =
  let t x y = PProduct [("X", PSet (Some [x])), ("Y", PSet (Some [y]))]
  let host h m = PProduct [("Host", pat h), ("Method", PSet (Some [m]))]
  let split = [t "1" "1", t "2" "1", t "1" "2"]
  let joined = [
    PProduct [("X", PSet (Some ["1", "2"])), ("Y", PSet (Some ["1"]))],
    t "1" "2",
  ]
  expectAll
    [
      expectEqual
        (map drender (dantichain split))
        (map drender (dantichain [t "1" "2", t "1" "1", t "2" "1"])),
      -- two spellings of one set cover each other
      expectTrue
        (allList (e => dsubAny e (dantichain joined)) (dantichain split)),
      expectTrue
        (allList (e => dsubAny e (dantichain split)) (dantichain joined)),
      expectEqual
        (map drender (dantichain (dantichain joined)))
        (map drender (dantichain joined)),
      -- GET and POST to a.com/x lie within the two bound tuples together
      expectTrue
        (dsubAny (PProduct [
          ("Host", pat "a.com/x/*"),
          ("Method", PSet (Some ["GET", "POST"])),
        ]) [
          host "a.com/*" "GET",
          host "a.com/x/*" "POST",
        ]),
      expectFalse
        (dsubAny (host "a.com/y/*" "POST") [
          host "a.com/*" "GET",
          host "a.com/x/*" "POST",
        ]),
    ]

test "elements of different domains are the whole domain, never one of them" = expectAll
  [
    -- two Products whose Host axes differ in shape are two domains
    expectEqual
      (drender
        (djoin
          (PProduct [("Host", pat "a.com/*")])
          (PProduct [("Host", PSet (Some ["s"]))])))
      (drender (PProduct [])),
    expectEqual
      [drender (PSet None)]
      (map drender (dantichain [PSet (Some ["SECRET"]), pat "HO*"])),
    expectEqual
      [drender (PPrefix None)]
      (map
        drender
        (dantichain [pat "evil*", PProduct [("Host", pat "a.com/x")]])),
  ]

test "a Product carries its schema: axes of one name in two schemas are two domains" =
  let web1 = [("Host", PPrefix None), ("Method", PSet None)]
  let web2 = [("Method", PSet None), ("Host", PPrefix None)]
  let lifted1 = productPrimaryLift web1 "a.com/x"
  let bound2 = PProduct [("Method", PSet None), ("Host", pat "a.com/*")]
  expectAll
    [
      -- a literal lifts into the first declared axis, the others at their top
      expectEqual
        (drender (PProduct [("Host", pat "a.com/x")]))
        (drender lifted1),
      expectEqual
        (drender (PProduct [("Method", PSet (Some ["a.com/x"]))]))
        (drender (productPrimaryLift web2 "a.com/x")),
      -- Web1's Host is not Web2's: no containment, and the join is the top
      expectFalse (dsub lifted1 bound2),
      expectTrue
        (dsub
          (PProduct [("Method", PSet None), ("Host", pat "a.com/x")])
          bound2),
      expectEqual "" (drender (djoin lifted1 bound2)),
      -- an extension extends the element's own first axis
      expectEqual
        (drender (PProduct [("Host", pat "a.com/x*")]))
        (drender (extendParam lifted1)),
    ]
