-- Tests of `types.tc_infer`'s own API: the type and the diagnostics `infer` gives each arm of
-- the recursion (variable, lambda, application, let and let-group, if, match with its guards,
-- tuple, list, array, range, annotation, block statement, operator, and the record arms:
-- construction, field access, value field, update), the exhaustiveness and redundancy checks a
-- match schedules (`checkMatchChecks`, and the check deferred while the scrutinee type is
-- unknown), the wide-literal check (`checkWideLiterals`), the clause inference of a binding
-- group (`inferMemberClauses`, `inferBindingChecked`), the signature pre-unification
-- (`preunifySigsEx`, `declareRigidVars`, `closeScope`), the range check of a literal at a
-- fixed-width type (`checkFixedWidthLiterals`), the match checks a module defers to its end
-- (`checkDeferredMatches`), the span readers (`appArgLoc`,
-- `valueSpanLoc`), the applications of an importer shadow (a bare head, a marked head, and a
-- spine whose receiver is not its first argument) and of a definer shadow with a marked head.
-- The operator rows pair operands of different types, so an operator that stops unifying them
-- reports no mismatch, and read the obligations the operators record where the prelude's
-- classes are present (`withObligations`). Each test builds the module record and the
-- environment it reads and drives the recursion below the entry module. Three properties run
-- over generated programs: a name in a chain of lambdas means its innermost binder, an argument
-- flows into the parameter at its position, and a field read after an update has the type its
-- record was built at. Not driven here: the occurrences of an ordinary method or dictionary
-- (`EMethodAt`, `EDictAt`), which read method scheme rows only a drive builds; the definer
-- shadow spine and variable-head arms; the shadow verdicts that reject or defer to the
-- standalone when two interfaces declare one method name (`AdReject`, `AdStandalone`); and the
-- effect a standalone's arrow performs at its call. `typecheck_test` drives whole checks and
-- `drive_independence_test` the match-warning flag.

import support.diag_codes.{codeText}
import test.{Expectation, expectAll, expectEach, expectEqual, expectTrue}
import frontend.ast.{
  Decl(..),
  EvId(..),
  Route(..),
  Arm(..),
  DoStmt(..),
  Expr(..),
  Guard(..),
  Lit(..),
  Loc(..),
  Pat(..),
  Ty,
  TyConOrigin(..),
}
import frontend.desugar.{desugar}
import frontend.parser.{parse}
import list.{drop, nub, range, reverse, sort, zip}
import types.publish.{TcDiag(..), tcCode, tcLoc, tcMsg}
import types.repr.{IfaceRef(..), Mono(..), Scheme(..), ppMono}
import types.tc_env.{envFor, extendVars}
import types.tc_infer.{
  appArgLoc,
  checkDeferredMatches,
  checkFixedWidthLiterals,
  checkMatchChecks,
  checkWideLiterals,
  declareRigidVars,
  infer,
  inferBindingChecked,
  inferMemberClauses,
  preunifySigsEx,
  valueSpanLoc,
}
import types.tc_diag_text.{locKey}
import types.effect_bindings.{BindingSummary(..), newBindingSummary}
import types.effect_rows.{pureRow}
import types.tc_effects.{beginEffectSummaryScope, clausesOf, freshEffectSummary}
import types.tc_occurrence.{markGroupClauses}
import types.tc_mono.{monoScheme, tconBuiltin, tconFrom}
import types.tc_shadow.{methodCellOf}
import types.tc_unify.{captureScope, freshVar, closeScope}
import types.tc_test_support.{
  at,
  boolM,
  codesOf,
  envWithData,
  fst3,
  inRootScope,
  intM,
  genKinds,
  kindLit,
  kindName,
  nthInt,
  messagesOf,
  methodOccurrence,
  pvar,
  readerOfLib,
  scoped,
  scopedWith,
  shadowEnvOf,
  sizeScheme,
  varM,
  recordShapes,
  unitKind,
  withFirstSig,
}

import types.evidence.{ScopeId(..)}
import types.tc_types.{
  MarkCtx(..),
  ModuleCtx(..),
  ModuleMarking(..),
  ScopedMember(..),
  TcEnv,
}
import support.ordmap.{omEmpty, omInsert, omKeys, omLookup}
import map as IdMap
import types.scopes.{ScopeOwner(..), freshScope}
import types.tc_solve.{openScope}
import types.tc_state.{currentScopeStore, wAll}

import string.{contains}
import support.util.{isEmptyL, isNonEmptyL, joinWith, listLen}

-- ── fixtures ──────────────────────────────────────────────────────────────

-- Data the programs below match on.
shapes : String
shapes = """
data T = Ta | Tb
"""

-- The type `main` of [src] infers to, and the codes pushed on the way.
checks : String -> String -> List String -> Expectation
checks src ty codes =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m src (e =>
    let t = infer env e
    expectEqual (ty, codes) (ppMono t, codesOf m))

-- The same, with the messages in place of the codes.
says : String -> String -> List String -> Expectation
says src ty messages =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m src (e =>
    let t = infer env e
    expectEqual (ty, messages) (ppMono t, messagesOf m))

-- A marking that sends no name to a method, dictionary or shadow occurrence: the mark pass
-- over it only mints the evidence sites of the operators, literals and field accesses.
plainMarking : ModuleMarking
plainMarking = ModuleMarking {
  mmCtx = MarkCtx { mcRp = omEmpty, mcAn = omEmpty, mcSm = [] },
  mmTop = omEmpty,
  mmDictSet = Ref omEmpty,
  mmUserNames = omEmpty,
  mmExterns = omEmpty,
}

-- The right-hand side of `main = ...` in [src], parsed, desugared and run through the mark
-- pass in [m] so every site it names is minted, as the inference recursion reads it; `None`
-- when [src] defines no `main`.
export
mainOf : ModuleCtx -> String -> Option Expr
mainOf m src =
  let grouped =
    fold
      (acc (name, clause) =>
        omInsert name (clause :: optionOr [] (omLookup name acc)) acc)
      omEmpty
      (flatMap
        (d => match d
          DFunDef _ name pats body _ _ => [(name, (pats, body))]
          _ => [])
        (desugar (parse src)))
  let marked = markGroupClauses plainMarking (envFor m) ["main"] grouped
  match clausesOf "main" marked
    (_, body) :: _ => Some body
    [] => None

-- [k] applied to `mainOf m src`; a source with no `main` fails the test.
export
withMain : ModuleCtx -> String -> (Expr -> Expectation) -> Expectation
withMain m src k = match mainOf m src
  Some body => k body
  None => expectEqual "a source defining main" src

-- The codes of the match warnings [m] holds.
warningCodes : ModuleCtx -> List String
warningCodes m =
  reverse (map (d => codeText (tcCode d)) m.mcCells.matchWarnings.value)

-- The messages of the match warnings [m] holds.
warningMessages : ModuleCtx -> List String
warningMessages m = reverse (map tcMsg m.mcCells.matchWarnings.value)

-- The type `T` of `shapes`, and the arm `c` with an empty body.
tyT : Mono
tyT = tconFrom (OriginModule "m") "T"

armOf : String -> Arm
armOf c = Arm (PCon c []) [] (ELit LUnit)

-- ── variables and lambdas ─────────────────────────────────────────────────

test "a lambda is an arrow from its parameter's type to its body's" =
  checks "main = x => x" "a -> a" []

test "a lambda of two parameters is a curried arrow" =
  checks "main = x y => x" "a -> b -> a" []

test "an inner parameter shadows the outer one of the same name" = expectAll [
  checks "main = x => x => x" "a -> b -> b" [],
  checks "main = x => (y => (x, y))" "a -> b -> (a, b)" [],
]

test "an unbound variable is rejected by code and reads as a fresh type" =
  let m = scoped ()
  withMain m "main = y" (e =>
    expectEqual
      ("a", ["T-UNBOUND"], ["unbound variable `y`"])
      (ppMono (infer (envFor m) e), codesOf m, messagesOf m))

-- ── application ───────────────────────────────────────────────────────────

test "an application is the function's result at the argument's type" = expectAll
  [
    checks "main = (x => (x, x)) 'c'" "(Char, Char)" [],
    checks "main = 'c' |> (x => (x, x))" "(Char, Char)" [],
    checks "main = (x => (x, x)) >> (p => p)" "a -> (a, a)" [],
  ]

test "arguments flow into the parameters in order" = expectAll [
  checks "main = (x y => (y, x)) 'c' True" "(Bool, Char)" [],
  checks "main = (x y z => (z, y, x)) 'c' True \"s\"" "(String, Bool, Char)" [],
]

test "applying a value that is not a function is rejected by code" = expectAll [
  says "main = 'c' 'd'" "a" [
    "this expression has type Char and is not a function; it cannot be applied to an argument",
  ],
  checks "main = 'c' 'd'" "a" ["T-NOT-A-FUNCTION"],
]

test "an argument beyond the function's arity is rejected as an application of a non-function" =
  checks "main = (x => x) 'a' 'b'" "a" ["T-NOT-A-FUNCTION"]

test "an argument of the wrong type is a type mismatch naming both types" = says
  "main = (x => if x then 'a' else 'b') \"s\""
  "Char"
  ["type mismatch: Bool vs String"]

-- ── let and let-groups ────────────────────────────────────────────────────

test "a let binds its name for its body" = expectAll [
  checks """
main =
  let c = 'c'
  c
""" "Char" [],
  checks """
main =
  let a = 'c'
  let b = (a, a)
  b
""" "(Char, Char)" [],
]

test "a let-bound function is generalized, so each use takes its own type" =
  checks """
main =
  let id = x => x
  (id 'c', id True)
""" "(Char, Bool)" []

test "a lambda-bound function is monomorphic, so two uses at different types are rejected" = checks
  "main = f => (f 'c', f True)"
  "(Char -> <a> b) -> <a> (b, b)"
  ["T-TYPE-MISMATCH"]

test "a local function may call itself" =
  checks """
main =
  let f n = if n then f n else 'c'
  f True
""" "Char" []

test "where-bound functions that call each other form one group" =
  checks
    """
main = f True
  where
    f n = if n then g n else 'c'
    g n = f n
"""
    "Char"
    []

test "a rec let of a value that is not a function is rejected by code" = checks
  """
main =
  let rec f = n => if n then f n else 'c'
  f True
"""
  "Char"
  ["T-NONREC-VALUE-LET"]

-- ── if, match and their checks ────────────────────────────────────────────

test "the branches of an if join to one type" =
  checks "main = if True then 'a' else 'b'" "Char" []

test "branches of different types are a type mismatch" = says
  "main = if True then 'a' else True"
  "Char"
  ["type mismatch: Char vs Bool"]

test "the condition of an if must be a Bool" =
  says "main = if 'c' then 'a' else 'b'" "Char" ["type mismatch: Char vs Bool"]

test "an if without else is a Unit and names the missing branch" = expectAll [
  checks "main = if True then ()" "Unit" [],
  says "main = if True then 'a'" "Char" [
    "type mismatch: Char vs Unit; an `if` without `else` has type Unit, so add an `else` branch or make the `then` branch Unit",
  ],
]

test "the arms of a match join to one type" = expectAll [
  checks """
main = match 'c'
  'a' => True
  _ => False
""" "Bool" [],
  says """
main = match 'c'
  'a' => True
  _ => 'b'
""" "Bool" [
    "type mismatch: Bool vs Char",
  ],
]

test "a match binds the variables of its patterns in the arm" =
  checks """
main = match (Ta, 'c')
  (Ta, y) => y
  _ => 'd'
""" "Char" []

test "a match missing a constructor warns W-NONEXHAUSTIVE" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main = match Ta
  Ta => 'c'
""" (e =>
    let t = infer env e
    expectEqual ("Char", ["W-NONEXHAUSTIVE"]) (ppMono t, warningCodes m))

test "an exhaustive match warns nothing" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main = match Ta
  Ta => 'c'
  Tb => 'd'
""" (e =>
    let t = infer env e
    expectEqual ("Char", []) (ppMono t, warningCodes m))

test "an arm after a covering arm warns it is unreachable" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main = match Ta
  Ta => 'c'
  Tb => 'd'
  Ta => 'e'
""" (e =>
    let t = infer env e
    expectEqual ("Char", ["W-UNREACHABLE-ARM"]) (ppMono t, warningCodes m))

test "a match whose scrutinee is still unknown after its arms is left to the deferred check" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main = x => match x
  y => 'c'
""" (e =>
    let t = infer env e
    expectEqual
      ("a -> Char", [], ["a"])
      (
        ppMono t,
        warningCodes m,
        map (d => ppMono (fst3 d)) m.mcCells.matchChecksDeferred.value,
      ))

test "a match on a scrutinee known from its patterns is checked at once" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main = x => match x
  Ta => 'c'
""" (e =>
    let t = infer env e
    expectEqual
      ("T -> Char", ["W-NONEXHAUSTIVE"], [])
      (
        ppMono t,
        warningCodes m,
        map (d => ppMono (fst3 d)) m.mcCells.matchChecksDeferred.value,
      ))

test "checkMatchChecks warns of a missing constructor and of an arm that covers nothing new" = expectAll
  [
    checksOf [armOf "Ta"] ["W-NONEXHAUSTIVE"],
    checksOf [armOf "Ta", armOf "Tb"] [],
    checksOf [armOf "Ta", armOf "Tb", armOf "Ta"] ["W-UNREACHABLE-ARM"],
    checksOf
      [armOf "Ta", armOf "Tb", Arm PWild [] (ELit LUnit)]
      ["W-UNREACHABLE-ARM"],
  ]

-- The codes of the warnings the checks over [arms] push for a scrutinee of type `T`.
checksOf : List Arm -> List String -> Expectation
checksOf arms codes =
  let m = scopedWith shapes
  let _ = envWithData m shapes
  checkMatchChecks m tyT arms
  expectEqual codes (warningCodes m)

test "an arm with a guard does not cover its constructor" = expectAll [
  checksOf
    [Arm (PCon "Ta" []) [GBool (ELit (LBool True))] (ELit LUnit), armOf "Tb"]
    ["W-NONEXHAUSTIVE"],
  checksOf
    [
      Arm (PCon "Ta" []) [GBool (ELit (LBool True))] (ELit LUnit),
      armOf "Ta",
      armOf "Tb",
    ]
    [],
]

test "an or-pattern arm covers its alternatives, a guarded one covers none, and a covered alternative warns" = expectAll
  [
    checksOf [Arm (POr [PCon "Ta" [], PCon "Tb" []]) [] (ELit LUnit)] [],
    checksOf
      [
        Arm
          (POr [PCon "Ta" [], PCon "Tb" []])
          [GBool (ELit (LBool True))]
          (ELit LUnit),
      ]
      ["W-NONEXHAUSTIVE"],
    checksOf
      [
        Arm (POr [PCon "Ta" [], PCon "Ta" []]) [] (ELit LUnit),
        armOf "Tb",
      ]
      ["W-UNREACHABLE-ALT"],
    checksOf
      [armOf "Ta", Arm (POr [PCon "Ta" [], PCon "Tb" []]) [] (ELit LUnit)]
      ["W-UNREACHABLE-ALT"],
    checksOf
      [
        armOf "Ta",
        armOf "Tb",
        Arm (POr [PCon "Ta" [], PCon "Tb" []]) [] (ELit LUnit),
      ]
      ["W-UNREACHABLE-ARM"],
  ]

test "a guarded or-pattern arm re-tries later alternatives, so overlapping alternatives do not warn" = expectAll
  [
    checksOf
      [
        Arm
          (POr [PCon "Ta" [], PCon "Ta" []])
          [GBool (ELit (LBool True))]
          (ELit LUnit),
        armOf "Ta",
        armOf "Tb",
      ]
      [],
    checksOf
      [
        armOf "Ta",
        Arm
          (POr [PCon "Ta" [], PCon "Tb" []])
          [GBool (ELit (LBool True))]
          (ELit LUnit),
        armOf "Tb",
      ]
      ["W-UNREACHABLE-ALT"],
  ]

test "a refutable binding pattern warns in the words of a binding, not of a match" =
  let m = scopedWith shapes
  let _ = envWithData m shapes
  checkMatchChecks m tyT [Arm (PCon "Ta" []) [] (EVar "<binder>")]
  expectAll [
    expectEqual ["W-NONEXHAUSTIVE"] (warningCodes m),
    expectEqual
      [
        "Warning: refutable binding pattern on `T`: missing `Tb`; handle `Tb` with a `match` or an `if let` instead of binding the pattern directly",
      ]
      (warningMessages m),
  ]

-- ── lists, tuples, ranges, annotations and blocks ─────────────────────────

test "the elements of a list literal join to one element type" = expectAll [
  checks "main = ['a', 'b']" "List Char" [],
  says "main = ['a', True]" "List Char" ["type mismatch: Char vs Bool"],
]

test "an array literal is an array of its elements' type" =
  checks "main = [|'a', 'b'|]" "Array Char" []

test "a tuple is the tuple of its components' types in order" = expectAll [
  checks "main = ('c', True)" "(Char, Bool)" [],
  checks "main = ('c', True, \"s\")" "(Char, Bool, String)" [],
]

test "an integer range is a list of Int and its bounds must be Int" = expectAll
  [
    checks "main = [1..3]" "List Int" [],
    says "main = [1..'c']" "List Int" ["type mismatch: Char vs Int"],
  ]

test "a constructor has its data type" = checks "main = (Ta, Tb)" "(T, T)" []

test "a lambda argument is checked against the parameter type the function expects" =
  checks "main = (f => f 'c') (x => x)" "Char" []

test "the lambdas of a list literal join to one function type" =
  checks "main = [x => x, y => 'c']" "List (Char -> Char)" []

test "an annotation fixes the type of its expression and rejects another" = expectAll
  [
    checks "main = ('c' : Char)" "Char" [],
    checks "main = ((x => x) : Char -> Char)" "Char -> Char" [],
    says "main = ('c' : Bool)" "Bool" ["type mismatch: Char vs Bool"],
  ]

test "an annotation more general than its expression is rejected by code" = says
  "main = ('c' : a)"
  "Char"
  [
    "type annotation `a` is more polymorphic than the expression: a type variable in it is a specific type, or two of its variables are the same type",
  ]

test "a statement whose value is not Unit is rejected as discarded" = says
  """
main =
  'c'
  True
"""
  "Bool"
  [
    "this statement's value (`Char`) is discarded; only a `Unit` expression may stand alone as a statement",
  ]

test "a record-free block of lets and a final expression has the final expression's type" =
  checks """
main =
  let a = 'c'
  let b = True
  (b, a)
""" "(Bool, Char)" []

-- ── statements of a block ─────────────────────────────────────────────────

test "a let statement binds its name for the statements after it" = expectAll [
  checks """
main =
  let a = 'c'
  ()
  a
""" "Char" [],
  checks """
main =
  let (a, b) = ('c', True)
  (b, a)
""" "(Bool, Char)" [],
]

test "a later let statement shadows an earlier one of the same name" =
  checks """
main =
  let x = 'c'
  ()
  let x = True
  x
""" "Bool" []

test "a let statement of a function may call itself" =
  checks
    """
main =
  let f n = if n then f n else 'c'
  ()
  f True
"""
    "Char"
    []

test "a let statement of a refutable pattern warns of the case it misses" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m """
main =
  let Ta = Ta
  'c'
""" (e =>
    let t = infer env e
    expectEqual ("Char", ["W-NONEXHAUSTIVE"]) (ppMono t, warningCodes m))

test "a bind statement outside a do block is rejected by code" = says
  """
main =
  x <- 'c'
  x
"""
  "Char"
  [
    "`<-` is only valid inside a `do` block; outside one, bind the value with `let x = ...`",
  ]

-- ── calls, guards and groups ──────────────────────────────────────────────

-- [k] applied to the tuple-call hints [src] leaves behind as candidates for the call's
-- mismatch.
withTupleCallHints : String -> (List String -> Expectation) -> Expectation
withTupleCallHints src k =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m src (e =>
    let _ = infer env e
    k (map helpOf m.mcCells.tupleCallCandidates.value))

helpOf : (Mono, String, a) -> String
helpOf (_, h, _) = h

test "a call that passes a tuple to a function of that many parameters leaves a hint to use spaces" = expectAll
  [
    withTupleCallHints """
main =
  let f x y = x
  f ('a', 'b')
""" (hints =>
      expectTrue
        (any
          (contains "passes the single tuple `('a', 'b')`; did you mean")
          hints)),
    withTupleCallHints
      """
main =
  let f x y = x
  f ('a', 'b', 'c')
"""
      (hints => expectEqual [] hints),
    withTupleCallHints """
main =
  let g p = p
  g ('a', 'b')
""" (hints =>
      expectEqual [] hints),
  ]

test "a call with too many arguments names the function and how many it takes" = says
  """
main =
  let f x = x
  f 'a' 'b'
"""
  "a"
  ["`f` takes 1 argument but is applied to 2"]

test "applying a named value that is not a function names it and its type" = says
  """
main =
  let c = 'c'
  c 'd'
"""
  "a"
  [
    "`c` has type Char and is not a function; it cannot be applied to an argument",
  ]

test "an argument whose type is a container of the parameter's is a type mismatch" = says
  "main = (xs => 'c' :: xs) 'd'"
  "List Char"
  ["type mismatch: List Char vs Char"]

test "a where-bound function is generalized, so each use takes its own type" =
  checks """
main = (f 'c', f True)
  where
    f x = x
""" "(Char, Bool)" []

test "a guard of a match arm must be a Bool" = expectAll [
  checks """
main = match 'c'
  x if x == 'a' => True
  _ => False
""" "Bool" [],
  says """
main = match 'c'
  x if 'd' => 'e'
  _ => 'f'
""" "Char" [
    "type mismatch: Char vs Bool",
  ],
]

test "a pattern guard binds its variables for the arm's body and matches the type of its scrutinee" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  let bound = Arm (pvar "t") [GBind (pvar "u") (EVar "t")] (EVar "u")
  let t = infer env (EMatch (EVar "Ta") [bound, Arm PWild [] (EVar "Tb")])
  expectEqual ("T", []) (ppMono t, codesOf m)

test "a pattern guard whose pattern has another type than its scrutinee is a type mismatch" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  let bad = Arm (pvar "t") [GBind (PLit (LBool True)) (EVar "t")] (EVar "t")
  let t = infer env (EMatch (EVar "Ta") [bad, Arm PWild [] (EVar "Tb")])
  expectEqual ("T", ["T-TYPE-MISMATCH"]) (ppMono t, codesOf m)

test "operators relate their operands: comparison and boolean give Bool, append keeps the operand type" = expectAll
  [
    checks "main = 'a' < 'b'" "Bool" [],
    checks "main = True || False" "Bool" [],
    says "main = \"a\" ++ 'b'" "String" ["type mismatch: String vs Char"],
  ]

test "a pipe into a value that is not a function is a type mismatch" =
  says "main = 'c' |> 'd'" "a" ["type mismatch: Char vs Char -> <a> b"]

test "a list literal of three elements is rejected at the element that differs" =
  says "main = ['a', 'b', True]" "List Char" ["type mismatch: Char vs Bool"]

-- ── operators ─────────────────────────────────────────────────────────────

test "the operands of && are Bool" = expectAll [
  checks "main = True && False" "Bool" [],
  says "main = True && 'c'" "Bool" ["type mismatch: Char vs Bool"],
]

test "a cons joins an element to a list of its type" =
  checks "main = 'a' :: ['b']" "List Char" []

test "equality compares two operands of one type" =
  checks "main = 'a' == 'b'" "Bool" []

test "an append of two strings is a string" =
  checks "main = \"a\" ++ \"b\"" "String" []

-- Operands of different types make a missing unification visible: the result keeps the type of
-- the operator's own operand, and the disagreement is the mismatch the operator reports.

test "arithmetic unifies its operands and gives their type" = expectAll [
  checks "main = x => x + x" "a -> a" [],
  says "main = 'a' + True" "Char" ["type mismatch: Char vs Bool"],
  says "main = 'a' % True" "Char" ["type mismatch: Char vs Bool"],
]

test "an ordering comparison unifies its operands and gives Bool" = expectAll [
  checks "main = x => x < x" "a -> Bool" [],
  says "main = 'a' <= True" "Bool" ["type mismatch: Char vs Bool"],
  says "main = 'a' > True" "Bool" ["type mismatch: Char vs Bool"],
]

test "an equality comparison unifies its operands and gives Bool" = expectAll [
  checks "main = x => x == x" "a -> Bool" [],
  says "main = 'a' == True" "Bool" ["type mismatch: Char vs Bool"],
  says "main = 'a' /= True" "Bool" ["type mismatch: Char vs Bool"],
]

test "a cons unifies its tail with a list and joins the head with the tail's elements" = expectAll
  [
    says "main = 'a' :: True" "List Char" ["type mismatch: Bool vs List a"],
    says "main = 'a' :: [True]" "List Char" ["type mismatch: Char vs Bool"],
  ]

test "the left of >> runs first and the left of << runs last" = expectAll [
  checks "main = (x => True) >> (c => if c then 'a' else 'b')" "a -> Char" [],
  checks "main = (c => if c then 'a' else 'b') << (x => True)" "a -> Char" [],
  says "main = (x => 'c') >> (c => if c then 'a' else 'b')" "a -> Char" [
    "type mismatch: Bool vs Char",
  ],
  says "main = (c => if c then 'a' else 'b') << (x => 'c')" "a -> Char" [
    "type mismatch: Bool vs Char",
  ],
]

test "unary minus keeps its operand's type and a bang reads a reference" = expectAll
  [
    checks "main = x => -x" "a -> a" [],
    checks "main = r => !r" "Ref a -> a" [],
  ]

test "a bang on a Bool is rejected by code, naming `not`" = expectAll [
  checks "main = !True" "Bool" ["T-BANG-ON-BOOL"],
  says "main = !True" "Bool" [
    "`!` dereferences a `Ref` and does not negate a `Bool`; use `not x`",
  ],
]

-- The operator obligations [src] records, as a count, in a module where the prelude's
-- `Num`, `Eq`, `Ord` and `Semigroup` are present; without them an operator records none.
withObligations : String -> (Int -> Expectation) -> Expectation
withObligations src k =
  let m = scopedWith shapes
  let seeded = m.mcGraph.crossRun.builtinClassesRef.value
  m.mcGraph.crossRun.builtinClassesRef := { seeded |
    bcNumPresent = True,
    bcEqPresent = True,
    bcOrdPresent = True,
    bcSemigroupPresent = True,
  }
  let env = envWithData m shapes
  withMain m src (e =>
    let _ = infer env e
    k (listLen (wAll m.mcCells.implObls)))

test "each arithmetic, comparison and unary operator records one obligation on its operand" = expectAll
  [
    withObligations "main = x => -x" (n => expectEqual 1 n),
    withObligations "main = x => x + x" (n => expectEqual 1 n),
    withObligations "main = x => x == x" (n => expectEqual 1 n),
    withObligations "main = x => x < x" (n => expectEqual 1 n),
    withObligations "main = x => x ++ x" (n => expectEqual 1 n),
  ]

-- ── wide literals ─────────────────────────────────────────────────────────

-- Whether a wide literal is written with a minus sign in front.
data Sign = Positive | Negated deriving (Eq)

-- The messages checkWideLiterals pushes for one literal of type [t] with halves [hi] and [lo].
wideMessages : Mono -> String -> Int -> Int -> Sign -> List String
wideMessages t lx hi lo sign =
  let m = scoped ()
  checkWideLiterals m [(t, lx, hi, lo, sign == Negated, None)]
  messagesOf m

test "a literal of 2^62 does not fit Int and says so" =
  expectEqual
    ["integer literal too large for Int (max 4611686018427387903)"]
    (wideMessages intM "4611686018427387904" 1073741824 0 Positive)

test "a literal of 2^63 fits U64, and I64 only when negated" =
  expectEqual
    [
      [],
      [
        "integer literal -9223372036854775808 does not fit U64 (0..18446744073709551615)",
      ],
      [
        "integer literal 9223372036854775808 does not fit I64 (-9223372036854775808..9223372036854775807)",
      ],
      [],
    ]
    [
      wideMessages
        (tconBuiltin "U64")
        "9223372036854775808"
        2147483648
        0
        Positive,
      wideMessages
        (tconBuiltin "U64")
        "9223372036854775808"
        2147483648
        0
        Negated,
      wideMessages
        (tconBuiltin "I64")
        "9223372036854775808"
        2147483648
        0
        Positive,
      wideMessages
        (tconBuiltin "I64")
        "9223372036854775808"
        2147483648
        0
        Negated,
    ]

test "a wide literal at any other type or an undetermined one is rejected" =
  expectEqual
    [
      ["integer literal 9223372036854775808 does not fit Float"],
      [
        "integer literal 9223372036854775808 fits only `U64` or `I64`, and its type here is undetermined",
      ],
    ]
    [
      wideMessages
        (tconBuiltin "Float")
        "9223372036854775808"
        2147483648
        0
        Positive,
      wideMessages (varM 7) "9223372036854775808" 2147483648 0 Positive,
    ]

test "an expression holding a wide literal parks it for the range check" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  withMain m "main = 9223372036854775808" (e =>
    let t = infer env e
    expectEqual
      ("a", ["9223372036854775808"])
      (
        ppMono t,
        map (w => lexemeOf w) m.mcCells.wideLitRanges.value,
      ))

-- The lexeme of a parked wide literal.
lexemeOf : (Mono, String, Int, Int, Bool, Option Loc) -> String
lexemeOf (_, lx, _, _, _, _) = lx

-- ── spans ─────────────────────────────────────────────────────────────────

arg : Loc
arg = Loc "t.mdk" 2 3 2 9

-- The span [actual] reads as [expected], by its rendered key (a `Loc` has no `Eq`).
spanIs : Option Loc -> Option Loc -> Expectation
spanIs expected actual = expectEqual (locKey expected) (locKey actual)

test "appArgLoc reads the span of the outermost argument through a located head" = expectAll
  [
    spanIs (Some arg) (appArgLoc (EApp (EVar "f") (ELoc arg (EVar "x")))),
    spanIs
      (Some arg)
      (appArgLoc (ELoc at (EApp (EVar "f") (ELoc arg (EVar "x"))))),
    spanIs
      (Some arg)
      (appArgLoc
        (EApp (EApp (EVar "f") (ELoc at (EVar "y"))) (ELoc arg (EVar "x")))),
    spanIs None (appArgLoc (EVar "f")),
  ]

test "valueSpanLoc reads the span of the value a binding body ends in" = expectAll
  [
    spanIs (Some arg) (valueSpanLoc (ELoc arg (EVar "x"))),
    spanIs
      (Some arg)
      (valueSpanLoc
        (ELet at False (pvar "a") (EVar "b") (ELoc arg (EVar "x")))),
    spanIs
      (Some arg)
      (valueSpanLoc (EBlock [DoExpr (EVar "y"), DoExpr (ELoc arg (EVar "x"))])),
  ]

-- ── scopes and rigid variables ────────────────────────────────────────────

test "closeScope returns to the scope that was open before" =
  let m = scoped ()
  let outer = captureScope m ()
  let inner =
    freshScope
      (currentScopeStore m.mcGraph ())
      (Some outer)
      0
      "probe"
      ModuleOwner
  openScope m inner
  let during = captureScope m ()
  closeScope m ()
  expectEqual (inner, outer) (during, captureScope m ())

test "declareRigidVars records each key once and keeps the earlier ones" =
  let m = scoped ()
  declareRigidVars m []
  let none = omKeys m.mcCells.declaredSigVarIds.value
  declareRigidVars m ["a", "b"]
  declareRigidVars m ["b", "c"]
  expectEqual
    ([], ["a", "b", "c"])
    (none, sort (omKeys m.mcCells.declaredSigVarIds.value))

-- ── the clauses of a binding ──────────────────────────────────────────────

-- A module record in a root scope with an effect summary scope open, as a binding body is inferred.
summarized : Unit -> ModuleCtx
summarized _ =
  let m = scoped ()
  beginEffectSummaryScope m ()
  m

-- The binding summary of a binding of [arity] parameters, in [m].
summaryOf : ModuleCtx -> Int -> BindingSummary
summaryOf m arity = newBindingSummary arity (freshVar m) (freshEffectSummary m)

charPat : Pat
charPat = PLit (LChar "c")

charE : Expr
charE = ELit (LChar "c")

trueE : Expr
trueE = ELit (LBool True)

-- The type and diagnostics inferring [clauses] as one binding of [arity] parameters gives.
clausesGive : Int -> List (List Pat, Expr) -> (String, List String)
clausesGive arity clauses =
  let m = summarized ()
  let owned = summaryOf m arity
  let _ = inferMemberClauses (envFor m) None owned clauses
  (ppMono owned.bsValue, codesOf m)

test "the clauses of a function publish the arrow of their patterns to their result" = expectAll
  [
    expectEqual ("a -> <b> a", []) (clausesGive 1 [([pvar "x"], EVar "x")]),
    expectEqual
      ("Char -> <a> Bool", [])
      (clausesGive 1 [([charPat], trueE), ([PWild], ELit (LBool False))]),
    expectEqual
      ("a -> b -> <c> (a, b)", [])
      (clausesGive 2 [([pvar "x", pvar "y"], ETuple [EVar "x", EVar "y"])]),
  ]

test "a value binding without parameters publishes its body's type" =
  expectEqual ("Char", []) (clausesGive 0 [([], charE)])

test "clauses that return different types are a type mismatch" =
  expectEqual
    ("a -> <b> Char", ["T-TYPE-MISMATCH"])
    (clausesGive 1 [([PWild], charE), ([pvar "y"], trueE)])

test "clauses whose patterns have different types are a type mismatch" =
  expectEqual
    ("Char -> <a> Char", ["T-TYPE-MISMATCH"])
    (clausesGive 1 [([charPat], charE), ([PLit (LBool True)], charE)])

test "a binding with no clauses infers nothing" =
  let m = summarized ()
  let owned = summaryOf m 1
  expectAll [
    expectTrue (isEmptyL (inferMemberClauses (envFor m) None owned [])),
    expectEqual [] (codesOf m),
  ]

test "a peeled signature type fixes the parameters" =
  let m = summarized ()
  let owned = summaryOf m 1
  let want = TFun intM pureRow boolM
  let _ = inferMemberClauses (envFor m) (Some want) owned [([charPat], trueE)]
  expectEqual ["T-TYPE-MISMATCH"] (codesOf m)

test "a lambda checked against an expected arrow takes the expected parameter type" =
  let m = summarized ()
  let want = TFun intM pureRow boolM
  let (t, _) = inferBindingChecked True (envFor m) (Some want) [pvar "x"] trueE
  expectEqual ("Int -> Bool", []) (ppMono t, codesOf m)

test "a checked lambda's result is its body's own type, left to its caller to unify" =
  let m = summarized ()
  let want = TFun intM pureRow boolM
  let (t, _) = inferBindingChecked True (envFor m) (Some want) [pvar "x"] charE
  expectEqual ("Int -> Char", []) (ppMono t, codesOf m)

-- ── signature pre-unification ─────────────────────────────────────────────

-- A scoped member named [name] over a fresh type and a one-parameter binding summary.
memberOf : ModuleCtx -> String -> ScopedMember
memberOf m name = ScopedMember {
  smName = name,
  smMono = freshVar m (),
  smOwned = summaryOf m 1,
  smDeclaredRoots = Ref IdMap.Tip,
  smDeclaredAuths = Ref IdMap.Tip,
  smSigned = Ref False,
  smRecursive = Ref None,
  smForce = None,
  smForceBound = Ref None,
  smScope = ScopeId 0,
}

-- The variable names the third component of a pre-unified signature binds.
boundNames : (String, Ty, List (String, Mono)) -> (String, List String)
boundNames (name, _, tvs) = (name, map fst tvs)

test "a member with a signature is unified with the signature's type and registered by name" =
  let m = summarized ()
  withFirstSig "f : a -> Int" (ty =>
    m.mcCells.sigTyMapRef := omInsert "f" ty m.mcCells.sigTyMapRef.value
    let member = memberOf m "f"
    let (regs, tvs) = preunifySigsEx m [("f", ty)] [member]
    expectEqual
      (["f"], [("f", ["a"])], True, "a -> Int")
      (
        map (r => r.crName) regs,
        map boundNames tvs,
        member.smSigned.value,
        ppMono member.smMono,
      ))

test "a member without a signature is unified with the type its clauses own" =
  let m = summarized ()
  let member = memberOf m "g"
  let (regs, tvs) = preunifySigsEx m [] [member]
  expectEqual
    (True, True, False, ppMono member.smOwned.bsValue)
    (isEmptyL regs, isEmptyL tvs, member.smSigned.value, ppMono member.smMono)

test "pre-unification takes each member in order and collects their registrations" =
  let m = summarized ()
  withFirstSig "f : Int -> Int" (ty =>
    m.mcCells.sigTyMapRef := omInsert "f" ty m.mcCells.sigTyMapRef.value
    let (regs, tvs) =
      preunifySigsEx
        m
        [("f", ty)]
        [memberOf m "f", memberOf m "g", memberOf m "f"]
    expectEqual
      (["f", "f"], ["f", "f"])
      (map (r => r.crName) regs, map fst3 tvs))

-- ── let, written out ──────────────────────────────────────────────────────

-- The type of [e] in a module that declares `shapes`, and the codes pushed.
givesAt : Expr -> (String, List String)
givesAt e =
  let m = scopedWith shapes
  let env = envWithData m shapes
  let t = infer env e
  (ppMono t, codesOf m)

idLam : Expr
idLam = ELam [pvar "x"] (EVar "x")

test "an expression let binds its name for the body" =
  expectEqual ("Char", []) (givesAt (ELet at False (pvar "x") charE (EVar "x")))

test "an expression let generalizes a function, so each use takes its own type" =
  expectEqual
    ("(Char, Bool)", [])
    (givesAt
      (ELet
        at
        False
        (pvar "i")
        idLam
        (ETuple [EApp (EVar "i") charE, EApp (EVar "i") trueE])))

test "an expression let of a tuple pattern binds each component" =
  expectEqual
    ("(Bool, Char)", [])
    (givesAt
      (ELet
        at
        False
        (PTuple [pvar "a", pvar "b"])
        (ETuple [charE, trueE])
        (ETuple [EVar "b", EVar "a"])))

test "an expression let whose pattern has another type than its value is a type mismatch" =
  expectEqual
    ("Char", ["T-TYPE-MISMATCH"])
    (givesAt (ELet at False (PLit (LBool True)) charE charE))

test "an expression let of a refutable pattern warns of the case it misses" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  let t = infer env (ELet at False (PCon "Ta" []) (EVar "Ta") charE)
  expectEqual ("Char", ["W-NONEXHAUSTIVE"]) (ppMono t, warningCodes m)

test "a recursive expression let binds its function for its own body and for the let's" =
  expectEqual
    ("Char", [])
    (givesAt
      (ELet
        at
        True
        (pvar "f")
        (ELam [pvar "n"] (EIf (EVar "n") (EApp (EVar "f") (EVar "n")) charE))
        (EApp (EVar "f") trueE)))

test "a one-element tuple passed to a one-parameter function leaves no tuple-call hint" =
  let m = scopedWith shapes
  let env = envWithData m shapes
  let _ =
    infer
      env
      (ELet at False (pvar "f") idLam (EApp (EVar "f") (ETuple [charE])))
  expectEqual [] (map helpOf m.mcCells.tupleCallCandidates.value)

test "a tuple passed to a function whose first parameter is a tuple of that size leaves no hint" = withTupleCallHints
  """
main =
  let f (a, b) y = a
  f ('a', 'b')
"""
  (hints => expectEqual [] hints)

test "the elements of an array literal and the bounds of a range are checked" = expectAll
  [
    says "main = [|'a', True|]" "Array Char" ["type mismatch: Char vs Bool"],
    says "main = ['c'..3]" "List Int" ["type mismatch: Char vs Int"],
  ]

-- ── what the wide-literal check says ──────────────────────────────────────

-- The help of a diagnostic.
tcHelp : TcDiag -> Option String
tcHelp (TcDiag _ _ _ _ h _) = h

-- The diagnostics checkWideLiterals pushes for one literal, as (message, help).
wideDiags : Mono -> String -> Int -> Int -> Sign -> List (String, Option String)
wideDiags t lx hi lo sign =
  let m = scoped ()
  checkWideLiterals m [(t, lx, hi, lo, sign == Negated, None)]
  map (d => (tcMsg d, tcHelp d)) (reverse (wAll m.mcCells.typeErrors))

test "a literal just above 2^62 and one just above the I64 negative bound are named with their type" =
  expectEqual
    [
      [
        (
          "integer literal 4611686018427387905 does not fit Int",
          Some "only a `U64` or an `I64` holds a literal above 2^62",
        ),
      ],
      [
        (
          "integer literal -9223372036854775809 does not fit I64 (-9223372036854775808..9223372036854775807)",
          None,
        ),
      ],
    ]
    [
      wideDiags intM "4611686018427387905" 1073741824 1 Positive,
      wideDiags (tconBuiltin "I64") "9223372036854775809" 2147483648 1 Negated,
    ]

test "a wide literal at an undetermined type is told how to annotate it" =
  expectEqual
    [
      (
        "integer literal 9223372036854775808 fits only `U64` or `I64`, and its type here is undetermined",
        Some
          "only a `U64` or an `I64` holds a literal above 2^62; annotate it as `(9223372036854775808 : U64)`",
      ),
    ]
    (wideDiags (varM 7) "9223372036854775808" 2147483648 0 Positive)

-- ── binders that share a location ─────────────────────────────────────────

-- A module record whose current location is [loc].
atLoc : ModuleCtx -> Loc -> ModuleCtx
atLoc m loc = { m | mcLoc = Some loc }

binderArm : String -> Arm
binderArm c = Arm (PCon c []) [] (EVar "<binder>")

test "refutable binders at one location warn once, and at two locations warn twice" =
  let one = scopedWith shapes
  let _ = envWithData one shapes
  checkMatchChecks (atLoc one at) tyT [binderArm "Ta"]
  checkMatchChecks (atLoc one at) tyT [binderArm "Tb"]
  let two = scopedWith shapes
  let _ = envWithData two shapes
  checkMatchChecks (atLoc two at) tyT [binderArm "Ta"]
  checkMatchChecks (atLoc two arg) tyT [binderArm "Tb"]
  expectEqual
    (["W-NONEXHAUSTIVE"], ["W-NONEXHAUSTIVE", "W-NONEXHAUSTIVE"])
    (warningCodes one, warningCodes two)

-- ── pre-unification of several members ────────────────────────────────────

test "pre-unification keeps the members in order, one registration per signed member" =
  let m = summarized ()
  withFirstSig "f : Int -> Int" (fty => withFirstSig "h : Bool -> Bool" (hty =>
    let sigs = omInsert "h" hty (omInsert "f" fty omEmpty)
    m.mcCells.sigTyMapRef := sigs
    let (regs, tvs) =
      preunifySigsEx
        m
        [("f", fty), ("h", hty)]
        [memberOf m "f", memberOf m "g", memberOf m "h"]
    expectEqual
      (["f", "h"], ["f", "h"])
      (map (r => r.crName) regs, map fst3 tvs)))

-- ── applications of an importer shadow ────────────────────────────────────

-- The type [e] infers to and the codes pushed, in a reader of a module whose `Sizeable`
-- method `size : a -> Int` has an impl at Int, and which also imports a standalone
-- `size : Bool -> Bool`.
shadowedAt : Expr -> (String, List String)
shadowedAt e =
  let m = inRootScope (readerOfLib ())
  let env = shadowEnvOf sizeScheme (monoScheme (TFun boolM pureRow boolM)) m
  let t = infer env e
  (ppMono t, codesOf m)

test "an application of a shadowed name at a receiver a live impl answers is the method's" =
  expectEqual ("Int", []) (shadowedAt (EApp (EVar "size") (ELit (LInt 3))))

test "an application of a shadowed name at a receiver no impl answers is the standalone's" =
  expectEqual ("Bool", []) (shadowedAt (EApp (EVar "size") trueE))

test "an application of a shadowed name at a receiver no impl answers is checked against the standalone's parameter" =
  expectEqual
    ("Bool", ["T-TYPE-MISMATCH"])
    (shadowedAt (EApp (EVar "size") charE))

test "an application of a shadowed name at an unknown receiver grounds it at the standalone's parameter" =
  expectEqual
    ("Bool -> Bool", [])
    (shadowedAt (ELam [pvar "x"] (EApp (EVar "size") (EVar "x"))))

-- ── marked heads ──────────────────────────────────────────────────────────

-- What applying the marked occurrence of `size` to an argument gave: the type, the codes,
-- the arity stamped on the occurrence's cell and whether a route was stamped on it.
data Stamped =
  Stamped String (List String) (Option Int) Bool
  deriving (Eq, Debug)

isRouted : Route -> Bool
isRouted RNone = False
isRouted _ = True

-- [e], applied in [env] over [m], read back with the cell of the occurrence `methodOccurrence`
-- minted.
stampedBy : ModuleCtx -> TcEnv -> Expr -> Stamped
stampedBy m env e =
  let t = infer env e
  let cell = methodCellOf m.mcGraph (EvId "probe" 0)
  Stamped (ppMono t) (codesOf m) cell.ecArity.value (isRouted cell.ecTag.value)

-- The marked occurrence of an importer shadow `size` (method `a -> Int`, standalone
-- [standalone]) applied to [arg].
importerMarked : Mono -> Expr -> Stamped
importerMarked standalone arg =
  let m = inRootScope (readerOfLib ())
  let env = shadowEnvOf sizeScheme (monoScheme standalone) m
  stampedBy m env (EApp (methodOccurrence m "size") arg)

-- The marked occurrence of a definer shadow `size`, the module's own `m__size` of type
-- [standalone] beside the method, applied to [arg].
definerMarked : Mono -> Expr -> Stamped
definerMarked standalone arg =
  let m = inRootScope (readerOfLib ())
  m.mcCells.definerShadowNamesRef := omInsert "size" () omEmpty
  let env = extendVars (envFor m) [
    ("size", sizeScheme),
    ("m__size", monoScheme standalone),
  ]
  let head = methodOccurrence m "size"
  let cell = methodCellOf m.mcGraph (EvId "probe" 0)
  cell.ecTag := RLocal "m__size" []
  stampedBy m env (EApp head arg)

boolToBool : Mono
boolToBool = TFun boolM pureRow boolM

boolToBoolToBool : Mono
boolToBoolToBool = TFun boolM pureRow (TFun boolM pureRow boolM)

test "a marked importer shadow at a receiver no impl answers is typed and stamped as the standalone" = expectAll
  [
    expectEqual
      (Stamped "Bool" [] (Some 1) True)
      (importerMarked boolToBool trueE),
    expectEqual
      (Stamped "Bool -> Bool" [] (Some 2) True)
      (importerMarked boolToBoolToBool trueE),
  ]

test "a marked importer shadow at a receiver a live impl answers keeps the method's type and route" =
  expectEqual
    (Stamped "Int" [] (Some 1) False)
    (importerMarked boolToBool (ELit (LInt 3)))

test "a definer shadow is the standalone even at a receiver a live impl answers" = expectAll
  [
    expectEqual
      (Stamped "Bool" [] (Some 1) True)
      (definerMarked boolToBool trueE),
    expectEqual
      (Stamped "Bool" ["T-TYPE-MISMATCH"] (Some 1) True)
      (definerMarked boolToBool (ELit (LInt 3))),
    expectEqual
      (Stamped "Bool -> Bool" [] (Some 2) True)
      (definerMarked boolToBoolToBool trueE),
  ]

test "a definer shadow at an unknown receiver grounds it at the standalone's parameter" =
  let m = inRootScope (readerOfLib ())
  m.mcCells.definerShadowNamesRef := omInsert "size" () omEmpty
  let env = extendVars (envFor m) [
    ("size", sizeScheme),
    ("m__size", monoScheme boolToBool),
  ]
  let head = methodOccurrence m "size"
  let cell = methodCellOf m.mcGraph (EvId "probe" 0)
  cell.ecTag := RLocal "m__size" []
  let t = infer env (ELam [pvar "x"] (EApp head (EVar "x")))
  expectEqual ("Bool -> Bool", []) (ppMono t, codesOf m)

test "an application of a shadowed name at an unknown receiver the standalone cannot ground keeps the method's type" =
  let m = inRootScope (readerOfLib ())
  let env =
    shadowEnvOf
      sizeScheme
      (Forall [2] [] [] [] pureRow (TFun (varM 2) pureRow boolM))
      m
  let t = infer env (ELam [pvar "x"] (EApp (EVar "size") (EVar "x")))
  expectEqual ("a -> Int", []) (ppMono t, codesOf m)

-- ── spines of an importer shadow ──────────────────────────────────────────

-- A method `size : Int -> a -> Int` whose receiver is its second parameter, and an imported
-- standalone `size : Int -> Bool -> Bool`.
spineMethod : Scheme
spineMethod =
  Forall [1] [] [] [] pureRow (TFun intM pureRow (TFun (varM 1) pureRow intM))

spineStandalone : Mono
spineStandalone = TFun intM pureRow (TFun boolM pureRow boolM)

spinedWith : Scheme -> Expr -> (String, List String)
spinedWith standalone e =
  let m = inRootScope (readerOfLib ())
  m.mcCells.methodDispatchIdxByIdRef := [
    (
      (IfaceRef { irName = "Sizeable", irOrigin = OriginModule "lib" }, "size"),
      1,
    ),
  ]
  let env = shadowEnvOf spineMethod standalone m
  let t = infer env e
  (ppMono t, codesOf m)

spined : Expr -> (String, List String)
spined e = spinedWith (monoScheme spineStandalone) e

test "a shadowed name applied to the arguments before its receiver is typed as the standalone where no impl answers the receiver" = expectAll
  [
    expectEqual
      ("Bool", [])
      (spined (EApp (EApp (EVar "size") (ELit (LInt 1))) trueE)),
    expectEqual
      ("Bool", ["T-TYPE-MISMATCH"])
      (spined (EApp (EApp (EVar "size") trueE) trueE)),
  ]

test "a shadowed name applied to the arguments before its receiver keeps the method where a live impl answers the receiver" = expectAll
  [
    expectEqual
      ("Int", [])
      (spined (EApp (EApp (EVar "size") (ELit (LInt 1))) (ELit (LInt 2)))),
    expectEqual
      ("Int", ["T-TYPE-MISMATCH"])
      (spined (EApp (EApp (EVar "size") trueE) (ELit (LInt 2)))),
  ]

test "a shadowed name whose receiver is an unknown after its other arguments grounds it at the standalone's parameter" =
  expectEqual
    ("Bool -> Bool", [])
    (spined
      (ELam [pvar "y"] (EApp (EApp (EVar "size") (ELit (LInt 1))) (EVar "y"))))

-- ── properties ────────────────────────────────────────────────────────────

-- A chain of one-parameter lambdas applied to one literal each: the name and kind of each
-- binder, and the names its body's tuple uses.  A name may repeat, so a later binder shadows an
-- earlier one.
data ChainCase = ChainCase (List (Int, Int)) (List Int)

impl Arbitrary ChainCase where
  arbitrary () =
    let binders = genBinders (randomInt 2 4)
    ChainCase binders (genUses (nameSet binders) (randomInt 2 3))
  shrink (ChainCase binders uses) = match binders
    _ :: rest if listLen rest >= 2 => [ChainCase rest (filterUses rest uses)]
    _ => []

genBinders : Int -> <Rand> List (Int, Int)
genBinders n
  | n <= 0 = []
  | otherwise = (randomInt 0 1, randomInt 0 3) :: genBinders (n - 1)

-- The distinct names the binders use.
nameSet : List (Int, Int) -> List Int
nameSet binders = sort (nub (map fst binders))

genUses : List Int -> Int -> <Rand> List Int
genUses names n
  | n <= 0 = []
  | otherwise =
    nthInt (randomInt 0 (listLen names - 1)) names :: genUses names (n - 1)

filterUses : List (Int, Int) -> List Int -> List Int
filterUses binders uses = filter (u => any (== u) (nameSet binders)) uses

nameOf : Int -> String
nameOf 0 = "a"
nameOf _ = "b"

-- The program of a case: the lambdas, their tuple of uses, the literals applied.
chainSource : ChainCase -> String
chainSource (ChainCase binders uses) =
  let names = joinWith " => " (map (b => nameOf (fst b)) binders)
  let tuple = joinWith ", " (map nameOf uses)
  let args = joinWith " " (map (b => kindLit (snd b)) binders)
  "main = (\{names} => (\{tuple})) \{args}"

-- The kind a use of name [n] has: that of the LAST binder of the name, as its innermost.
innermostKind : List (Int, Int) -> Int -> Int
innermostKind binders n = match filter (b => fst b == n) (reverse binders)
  (_, k) :: _ => k
  [] => unitKind

-- Law: every use in the body of a chain of lambdas has the type of the literal its innermost
-- binder of that name was applied to.  Precondition (`shadowedUse`): some used name is bound
-- twice, with different kinds, so the innermost binder differs from an outer one.
prop "a name in a lambda chain means its innermost binder" (c : ChainCase) =
  let (ChainCase binders uses) = c
  let expected =
    "("
      ++ joinWith ", " (map (u => kindName (innermostKind binders u)) uses)
      ++ ")"
  let m = scopedWith shapes
  let env = envWithData m shapes
  match typeOfMain m env (chainSource c)
    Some t => t == expected
    None => False

-- Whether a case has a used name bound twice at different kinds.
shadowedUse : ChainCase -> Bool
shadowedUse (ChainCase binders uses) =
  any
    (u =>
      let ks = map snd (filter (b => fst b == u) binders)
      listLen (nub ks) >= 2)
    uses

-- The type of `main` in [src], rendered, or `None` when the source has no `main`.
typeOfMain : ModuleCtx -> TcEnv -> String -> Option String
typeOfMain m env src = map (e => ppMono (infer env e)) (mainOf m src)

-- A lambda of several parameters applied to one literal each: the kind of each argument, and
-- the parameters its body's tuple reads, by position.
data SpineCase = SpineCase (List Int) (List Int)

impl Arbitrary SpineCase where
  arbitrary () =
    let n = randomInt 2 4
    SpineCase (genKinds n) (genIndices n (randomInt 2 3))
  shrink (SpineCase kinds reads) = match kinds
    _ :: rest if listLen rest >= 2 =>
      [SpineCase rest (map (i => i % listLen rest) reads)]
    _ => []

genIndices : Int -> Int -> <Rand> List Int
genIndices n k
  | k <= 0 = []
  | otherwise = randomInt 0 (n - 1) :: genIndices n (k - 1)

paramName : Int -> String
paramName i = "p" ++ intToString i

spineSource : SpineCase -> String
spineSource (SpineCase kinds reads) =
  let params = joinWith " " (map paramName (range 0 (listLen kinds)))
  let tuple = joinWith ", " (map paramName reads)
  let args = joinWith " " (map kindLit kinds)
  "main = (\{params} => (\{tuple})) \{args}"

-- Law: the type of a lambda applied to arguments is the tuple of the kinds of the arguments
-- its body reads, whatever order it reads them in.  Precondition (`readsOutOfOrder`): the
-- body reads parameters of two different kinds, and not in parameter order, so an argument
-- flowing into the wrong parameter changes the type.
prop "an argument flows into the parameter at its position" (c : SpineCase) =
  let (SpineCase kinds reads) = c
  let expected =
    "(" ++ joinWith ", " (map (i => kindName (nthInt i kinds)) reads) ++ ")"
  let m = scoped ()
  match typeOfMain m (envWithData m shapes) (spineSource c)
    Some t => t == expected
    None => False

-- Whether a case reads two parameters of different kinds, the later one first.
readsOutOfOrder : SpineCase -> Bool
readsOutOfOrder (SpineCase kinds reads) =
  any
    (pair =>
      fst pair > snd pair && nthInt (fst pair) kinds /= nthInt (snd pair) kinds)
    (zip reads (drop 1 reads))

test "a chain that rebinds a used name at another kind is a shadowed use, and means the rebinding" =
  let rebinding = ChainCase [(0, 0), (0, 1)] [0, 0]
  let distinct = ChainCase [(0, 0), (1, 1)] [0, 1]
  let sameKind = ChainCase [(0, 0), (0, 0)] [0, 0]
  let m = scoped ()
  expectEqual
    ((True, False, False), Some "(Bool, Bool)")
    (
      (shadowedUse rebinding, shadowedUse distinct, shadowedUse sameKind),
      typeOfMain m (envWithData m shapes) (chainSource rebinding),
    )

test "a body that reads a later parameter before an earlier one of another kind reads out of order" =
  let swapped = SpineCase [0, 1, 2] [1, 0]
  let inOrder = SpineCase [0, 1, 2] [0, 1]
  let sameKind = SpineCase [0, 0, 2] [1, 0]
  let m = scoped ()
  expectEqual
    ((True, False, False), Some "(Bool, Char)")
    (
      (
        readsOutOfOrder swapped,
        readsOutOfOrder inOrder,
        readsOutOfOrder sameKind,
      ),
      typeOfMain m (envWithData m shapes) (spineSource swapped),
    )

test "a shadowed name whose receiver the standalone cannot ground keeps the method's type" =
  expectEqual
    ("a -> Int", [])
    (spinedWith
      (Forall
        [2]
        []
        []
        []
        pureRow
        (TFun intM pureRow (TFun (varM 2) pureRow boolM)))
      (ELam [pvar "y"] (EApp (EApp (EVar "size") (ELit (LInt 1))) (EVar "y"))))

-- ── the record arms of the recursion ──────────────────────────────────────

-- The type `main` of [src] infers to and the codes pushed, over the records of `recordShapes`
-- and [extra].
recShows : String -> String -> String -> List String -> Expectation
recShows extra src ty codes =
  let m = scopedWith (recordShapes ++ extra)
  let env = envWithData m (recordShapes ++ extra)
  withMain m src (e =>
    let t = infer env e
    expectEqual (ty, codes) (ppMono t, codesOf m))

-- The same, with the messages.
recSays : String -> String -> String -> List String -> Expectation
recSays extra src ty messages =
  let m = scopedWith (recordShapes ++ extra)
  let env = envWithData m (recordShapes ++ extra)
  withMain m src (e =>
    let t = infer env e
    expectEqual (ty, messages) (ppMono t, messagesOf m))

-- Two records that both declare `shared`.
twoShared : String
twoShared = """
data L = L { shared : Int }
data R = R { shared : Bool }
"""

-- A record with a constructor that withholds `x`, beside another record that declares it.
splitOwners : String
splitOwners =
  """
data A = A1 { x : Int } | A2 { z : Int }
data B = B1 { x : Bool }
"""

-- Two records that each declare `x`, one constructor apiece.
plainOwners : String
plainOwners = """
data A = A1 { x : Int }
data B = B1 { x : Bool }
"""

test "a record construction has the record's type" = expectAll [
  recShows "" "main = P { a = 1, b = True }" "P" [],
  recShows "" "main = Box { v = 'c' }" "Box Char" [],
  recShows "" "main = Pair { first = 'c', second = True }" "Pair Char Bool" [],
]

test "a field left out of a construction is rejected by code, naming the field" = expectAll
  [
    recSays "" "main = P { a = 1 }" "P" ["missing field `b` in `P`"],
    recShows "" "main = P { b = True }" "P" ["T-MISSING-FIELD"],
  ]

test "a field the record does not declare is rejected by code" =
  recSays "" "main = P { a = 1, b = True, c = 2 }" "P" ["no field `c` in `P`"]

test "a field value of the wrong type is a type mismatch" = recSays
  ""
  "main = P { a = True, b = True }"
  "P"
  ["type mismatch: Bool vs Int"]

test "a construction of a record that does not exist is rejected by code" =
  recSays "" "main = Nope { a = 1 }" "a" ["unknown record type `Nope`"]

-- ── field access ──────────────────────────────────────────────────────────

test "a field access has the field's type at the receiver's instantiation" = expectAll
  [
    recShows "" "main = (P { a = 1, b = True }).a" "Int" [],
    recShows "" "main = (P { a = 1, b = True }).b" "Bool" [],
    recShows "" "main = (Box { v = 'c' }).v" "Char" [],
    recShows "" "main = (Pair { first = 'c', second = True }).second" "Bool" [],
  ]

test "two accesses of one generic record take the field at their own receiver's type" =
  recShows
    ""
    "main = ((Box { v = 'c' }).v, (Box { v = True }).v)"
    "(Char, Bool)"
    []

test "a field the receiver's record does not declare is rejected by code" = expectAll
  [
    recSays "" "main = (P { a = 1, b = True }).z" "a" ["no field `z` in `P`"],
    recShows "" "main = (P { a = 1, b = True }).z" "a" ["T-UNKNOWN-FIELD"],
  ]

test "a near miss of a declared field is offered as the fix" = recSays
  ""
  "main = (Cfg { name = \"n\", count = 1 }).nmae"
  "a"
  ["no field `nmae` in `Cfg`; did you mean `name`?"]

test "a field that no record declares is unknown at an unknown receiver" =
  recSays "" "main = r => r.zzz" "a -> b" ["no field `zzz` in `<unknown>`"]

test "a field only one record declares selects that record at an unknown receiver" =
  recShows "" "main = r => r.count" "Cfg -> Int" []

test "a field that two records declare is ambiguous at an unknown receiver" =
  recShows twoShared "main = r => r.shared" "a -> b" ["T-AMBIGUOUS-FIELD"]

test "a field that two records declare is not ambiguous at a known receiver" = expectAll
  [
    recShows twoShared "main = (L { shared = 1 }).shared" "Int" [],
    recShows twoShared "main = (R { shared = True }).shared" "Bool" [],
  ]

test "the value field of a reference reads the stored type" =
  recShows "" "main = r => r.value" "Ref a -> a" []

-- ── record update ─────────────────────────────────────────────────────────

test "an update has the type of the record it updates" = expectAll [
  recShows
    ""
    """
main =
  let p = P { a = 1, b = True }
  { p | a = 2 }
"""
    "P"
    [],
  recShows
    ""
    """
main =
  let p = Pair { first = 'c', second = True }
  { p | first = 'd' }
"""
    "Pair Char Bool"
    [],
]

test "an update keeps the type of the fields it does not assign" =
  recShows
    ""
    """
main =
  let p = Pair { first = 'c', second = True }
  ({ p | first = 'd' }).second
"""
    "Bool"
    []

test "an update cannot change the type of the record" = recSays
  ""
  """
main =
  let p = Pair { first = 'c', second = True }
  { p | first = True }
"""
  "Pair Char Bool"
  ["type mismatch: Bool vs Char"]

test "an update of a field the record does not declare is rejected by code" = recSays
  ""
  """
main =
  let p = P { a = 1, b = True }
  { p | zz = 2 }
"""
  "P"
  ["no field `zz` in `P`"]

test "an update of a constructor names the record by that constructor" = expectAll
  [
    recShows
      ""
      """
main =
  let p = P { a = 1, b = True }
  P { p | a = 2 }
"""
      "P"
      [],
    recSays
      ""
      """
main =
  let p = P { a = 1, b = True }
  Nope { p | a = 2 }
"""
      "a"
      ["unknown record type `Nope`"],
  ]

-- ── constructors that disagree about a field ──────────────────────────────

test "a field a sibling constructor withholds is rejected by code" = recShows
  "data W = Wa { x : Int } | Wb { z : Int }"
  "main = (Wa { x = 1 }).x"
  "a"
  ["T-FIELD-NOT-IN-ALL-CTORS"]

test "a field the constructors place at different positions is rejected by code" = recShows
  "data W = Wa { x : Int, y : Int } | Wb { y : Int, x : Int }"
  "main = (Wa { x = 1, y = 2 }).x"
  "a"
  ["T-FIELD-POSITION-DIFFERS"]

test "a field the constructors declare at different types is rejected by code" = recShows
  "data W = Wa { x : Int } | Wb { x : Bool }"
  "main = (Wa { x = 1 }).x"
  "a"
  ["T-FIELD-TYPE-DIFFERS"]

test "a field every constructor declares at one position and one type is accepted" =
  recShows
    "data W t = Wa { x : t } | Wb { x : t, y : Int }"
    "main = (Wa { x = 'c' }).x"
    "Char"
    []

test "an update of a type with several constructors is rejected by code" = recShows
  "data W = Wa { x : Int } | Wb { x : Int }"
  """
main =
  let w = Wa { x = 1 }
  { w | x = 2 }
"""
  "W"
  ["T-UPDATE-MULTI-CTOR"]

test "an update of a type with one constructor is accepted" =
  recShows
    "data W = Wa { x : Int }"
    """
main =
  let w = Wa { x = 1 }
  { w | x = 2 }
"""
    "W"
    []

-- ── constructors that disagree about a field, by what the field holds ─────

test "function and application fields that agree are accepted, and ones that differ are rejected" = expectAll
  [
    recShows
      "data W = Wa { f : Int -> Int } | Wb { f : Int -> Int }"
      "main = (Wa { f = n => n }).f"
      "Int -> Int"
      [],
    recShows
      "data W = Wa { f : Int -> Int } | Wb { f : Bool -> Int }"
      "main = (Wa { f = n => n }).f"
      "a"
      ["T-FIELD-TYPE-DIFFERS"],
    recShows
      "data W = Wa { f : Int -> Int } | Wb { f : Int -> Bool }"
      "main = (Wa { f = n => n }).f"
      "a"
      ["T-FIELD-TYPE-DIFFERS"],
    recShows
      "data W = Wa { f : Box Int } | Wb { f : Box Bool }"
      "main = (Wa { f = Box { v = 1 } }).f"
      "a"
      ["T-FIELD-TYPE-DIFFERS"],
  ]

test "a narrowed owner whose sibling constructor withholds the field is still rejected" = recShows
  splitOwners
  "main = (A1 { x = 1 }).x"
  "a"
  ["T-FIELD-NOT-IN-ALL-CTORS"]

test "a field two records declare is narrowed to the record of a known receiver" =
  recShows plainOwners "main = (A1 { x = 1 }).x" "Int" []

test "an ambiguous field at an unknown receiver names the records that declare it" = recSays
  twoShared
  "main = r => r.shared"
  "a -> b"
  [
    "ambiguous field `.shared`: it is declared by `L` and `R` and the record type is undetermined; annotate the record, as in `(r : L).shared`",
  ]

test "a field type that differs only in its effect row is rejected by code" = recShows
  "data W = Wa { f : Int -> <IO> Int } | Wb { f : Int -> Int }"
  "main = (Wa { f = n => n }).f"
  "a"
  ["T-FIELD-TYPE-DIFFERS"]

-- ── properties ────────────────────────────────────────────────────────────

-- A record of three fields of generated kinds, the fields an update assigns, and the field a
-- read goes through afterwards.
data UpdateCase = UpdateCase (List Int) (List Int) Int

impl Arbitrary UpdateCase where
  arbitrary () =
    let assigned = genAssigned 3
    UpdateCase (genKinds 3) (ensureOne assigned) (randomInt 0 2)
  shrink (UpdateCase kinds assigned read) = match assigned
    _ :: rest if isNonEmptyL rest => [UpdateCase kinds rest read]
    _ => []

-- The fields (by index) an update assigns, each kept or left out by a draw.
genAssigned : Int -> <Rand> List Int
genAssigned n
  | n <= 0 = []
  | otherwise =
    let rest = genAssigned (n - 1)
    if randomInt 0 1 == 1 then n - 1 :: rest else rest

-- An update assigns at least one field.
ensureOne : List Int -> List Int
ensureOne [] = [0]
ensureOne fields = fields

-- The program of a case: the record declared over three type parameters, built from one
-- literal per field, updated at the assigned fields with a value of the field's own kind, and
-- read at one field.
updateSource : UpdateCase -> String
updateSource (UpdateCase kinds assigned read) =
  let built =
    joinWith
      ", "
      (map (i => "f\{intToString i} = \{kindLit (nthInt i kinds)}") [0, 1, 2])
  let updated =
    joinWith
      ", "
      (map (i => "f\{intToString i} = \{kindLit (nthInt i kinds)}") assigned)

  """
data G x y z = G { f0 : x, f1 : y, f2 : z }
main =
  let r = G { \{built} }
  ({ r | \{updated} }).f\{intToString read}
"""

-- Law: reading a field of an updated record has the type that field was built at, whether the
-- update assigned it or not.  Precondition (`readsUntouched`): the read field is not one the
-- update assigns, so its type can only come from the record being updated.
prop "a field read after an update has the type its record was built at" (c : UpdateCase) =
  let (UpdateCase kinds _ read) = c
  let m = scopedWith (updateSource c)
  let env = envWithData m (updateSource c)
  match mainOf m (updateSource c)
    Some e => ppMono (infer env e) == kindName (nthInt read kinds)
    None => False

-- Whether the read field of a case is one its update leaves alone.
readsUntouched : UpdateCase -> Bool
readsUntouched (UpdateCase _ assigned read) = not (any (== read) assigned)

test "a read of a field the update leaves alone is its record's, one it assigns is the assigned value's" =
  let untouched = UpdateCase [0, 1, 2] [1] 0
  let assigned = UpdateCase [0, 1, 2] [1] 1
  let m = scopedWith (updateSource untouched)
  let env = envWithData m (updateSource untouched)
  expectEqual
    ((True, False), Some "Char")
    (
      (readsUntouched untouched, readsUntouched assigned),
      map (e => ppMono (infer env e)) (mainOf m (updateSource untouched)),
    )

-- ── literals at a fixed-width type, and the matches deferred to a module's end ──

-- The codes and messages `checkFixedWidthLiterals` pushes for the literals [lits].
fixedWidthReport : List (Mono, Int, Option Loc) -> (List String, List String)
fixedWidthReport lits =
  let m = scoped ()
  checkFixedWidthLiterals m lits
  (codesOf m, messagesOf m)

test "a literal outside the range of its fixed-width type is an overflow naming the type and the range" = expectEach
  [
    (
      "above U8",
      expectEqual
        (["L-INT-OVERFLOW"], ["integer literal 256 does not fit U8 (0..255)"])
        (fixedWidthReport [(tconBuiltin "U8", 256, None)]),
    ),
    (
      "below U8",
      expectEqual
        (["L-INT-OVERFLOW"], ["integer literal -1 does not fit U8 (0..255)"])
        (fixedWidthReport [(tconBuiltin "U8", 0 - 1, None)]),
    ),
    (
      "below I32",
      expectEqual
        (
          ["L-INT-OVERFLOW"],
          [
            "integer literal -2147483649 does not fit I32 (-2147483648..2147483647)",
          ],
        )
        (fixedWidthReport [(tconBuiltin "I32", 0 - 2147483649, None)]),
    ),
  ]

test "a literal at the edge of its fixed-width range, or at a type with no fixed width, raises nothing" = expectEach
  [
    (
      "U8 top",
      expectEqual ([], []) (fixedWidthReport [(tconBuiltin "U8", 255, None)]),
    ),
    (
      "U8 bottom",
      expectEqual ([], []) (fixedWidthReport [(tconBuiltin "U8", 0, None)]),
    ),
    (
      "I32 bottom",
      expectEqual
        ([], [])
        (fixedWidthReport [(tconBuiltin "I32", 0 - 2147483648, None)]),
    ),
    ("Int", expectEqual ([], []) (fixedWidthReport [(intM, 1000000, None)])),
  ]

test "a negative literal at U64 is an overflow" =
  expectEqual
    (
      ["L-INT-OVERFLOW"],
      ["integer literal -1 does not fit U64 (0..18446744073709551615)"],
    )
    (fixedWidthReport [(tconBuiltin "U64", 0 - 1, None)])

test "each out-of-range literal is its own error, in source order, and one in range among them is skipped" =
  expectEqual
    [
      "integer literal 300 does not fit U8 (0..255)",
      "integer literal 301 does not fit U8 (0..255)",
    ]
    (snd
      (fixedWidthReport [
        (tconBuiltin "U8", 300, None),
        (tconBuiltin "U8", 7, None),
        (tconBuiltin "U8", 301, None),
      ]))

test "an overflow is reported at the literal's own location" =
  let m = scoped ()
  let loc = Some (Loc "lit.mdk" 4 2 4 5)
  checkFixedWidthLiterals m [(tconBuiltin "U8", 300, loc)]
  expectEqual
    ["lit.mdk:4:2"]
    (map (d => locKey (tcLoc d)) (reverse (wAll m.mcCells.typeErrors)))

-- The warning codes pushed by `checkDeferredMatches` over [entries], each a scrutinee type
-- and arms at no location.
deferredCodes : List (Mono, List Arm) -> List String
deferredCodes entries =
  let m = scopedWith shapes
  let _ = envWithData m shapes
  checkDeferredMatches m (map (e => (fst e, snd e, None)) entries)
  warningCodes m

test "a deferred match is checked as an immediate one is" = expectEach [
  (
    "missing",
    expectEqual ["W-NONEXHAUSTIVE"] (deferredCodes [(tyT, [armOf "Ta"])]),
  ),
  (
    "complete",
    expectEqual [] (deferredCodes [(tyT, [armOf "Ta", armOf "Tb"])]),
  ),
  (
    "unreachable",
    expectEqual
      ["W-UNREACHABLE-ARM"]
      (deferredCodes [(tyT, [armOf "Ta", armOf "Tb", armOf "Ta"])]),
  ),
]

test "every deferred match is checked, in the order they were deferred" =
  expectEqual
    ["W-NONEXHAUSTIVE", "W-UNREACHABLE-ARM"]
    (deferredCodes [
      (tyT, [armOf "Ta"]),
      (tyT, [armOf "Ta", armOf "Tb", armOf "Ta"]),
    ])

test "no deferred match raises no warning" = expectEqual [] (deferredCodes [])

test "a deferred match warns at the span it was deferred from" =
  let m = scopedWith shapes
  let _ = envWithData m shapes
  let loc = Some (Loc "m.mdk" 9 3 9 12)
  checkDeferredMatches m [(tyT, [armOf "Ta"], loc)]
  expectEqual
    ["m.mdk:9:3"]
    (map (d => locKey (tcLoc d)) m.mcCells.matchWarnings.value)
