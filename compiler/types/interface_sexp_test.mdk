-- Tests for the interface codec: every published row of every stdlib module,
-- of a battery of synthetic signatures and of a residual-bearing module, and
-- every field of the prelude's interface value, survives encode, render, parse
-- and decode with its text, its rendering and its ids intact; malformed text
-- is refused with its path.
import test.{
  Expectation, expectEqual, expectEach, expectAll, expectAtLeast, labelFail,
  fail
}
import list.{sort, indexed, take, drop}
import map as M
import string as S
import frontend.ast.{
  Decl, TyConOrigin(..), Ty(..), EffAtomTy(..), EffParamTy(..), Constraint(..),
  Variant(..), ConPayload(..), Field(..), Ns(..), TabKey(..), DataVis(..),
  Ident, Loc(..), mkIdent
}
