import test.{expectAll, expectEqual}
import types.effect_infer.{captureEffects, recordEffect, alphaOf}
import types.effect_rows.{
  EffRow(..), Effvar(..), effrowLabels, atomBuiltin, renderAtoms
}
import types.effect_domain.{Param(..)}
import types.effect_authority.{authIsTop}
import types.repr.{Mono(..), ppAuthority}
import frontend.ast.{
  Expr(..), Lit(..), Pat(..), DoStmt(..), Loc(..), TyConOrigin(..)
}
import support.util.{listLen}

-- α of [e] in the Prefix domain, with no names in scope.
alphaPrefix : Expr -> String
alphaPrefix e =
  let q = alphaOf (PPrefix None) (_ => None) [] e (TCon "String" OriginBuiltin)
  if authIsTop q then "top" else ppAuthority (Ref []) (Ref 0) q

at : Loc
at = Loc "t.mdk" 1 0 1 0

test "a block is abstracted as its last expression in the scope its lets build" =
  expectEqual
    "\"cfg/app\""
    (alphaPrefix
      (EBlock [
        DoLet False False (PVar "p" at) (ELit (LString "cfg/app")),
        DoExpr (EVar "p"),
      ]))

test "a patterned let in a block hides the names it binds" =
  expectEqual
    "top"
    (alphaPrefix
      (EBlock [
        DoLet False False (PVar "p" at) (ELit (LString "cfg/app")),
        DoLet False False (PTuple [PVar "p" at, PWild]) (EVar "pair"),
        DoExpr (EVar "p"),
      ]))

test "nested capture restores the parent without charging a stored computation" =
  let ambient = Ref []
  let makeJoin = cells => Ref (EJoin 1 0 cells)
  let (inside, outer) = captureEffects ambient makeJoin (_ =>
    recordEffect ambient (EffRow [atomBuiltin "Clock" PUnit] None)
    let (_, inner) = captureEffects ambient makeJoin (_ =>
      recordEffect ambient (EffRow [atomBuiltin "Audit" PUnit] None))
    renderAtoms (effrowLabels inner))
  expectAll [
    expectEqual "Audit" inside,
    expectEqual "Clock" (renderAtoms (effrowLabels outer)),
    expectEqual 0 (listLen !ambient),
  ]

test "pure occurrences do not grow the capture buffer" =
  let ambient = Ref []
  recordEffect ambient (EffRow [] None)
  recordEffect ambient (EffRow [] None)
  expectEqual 0 (listLen !ambient)
