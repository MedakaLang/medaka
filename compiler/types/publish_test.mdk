-- Unit tests for the published shapes' zonk, freeze, validator and graph report
-- over hand-built values; a scheme's context surviving a later drive and a
-- shadowing binding's context (#2054); published schemes holding no Link; and
-- the partial analysis a drive returns (locals, seed, module).
import test.{
  expectEqual, expectNotEqual, expectEach, expectTrue, expectFalse,
  expectGreaterThan, Expectation, fail
}
import frontend.ast.{
  TyConOrigin(..), EvId(..), EvVal(..), EvEntry(..), Route(..), Loc(..), Decl
}
import frontend.desugar.{desugar}
import frontend.parser.{parse, parseLocated}
import list.{zip, filter, takeWhile, dropWhile, sort, sortOn, indexed}
import string.{lines, startsWith}
import support.util.{joinNl, joinWith}
import types.repr.{
  Mono(..), Tyvar(..), Scheme(..), IfaceRef(..), VecObl(..), ppScheme
}
import types.effect_domain.{Param(..)}
import types.effect_rows.{EffRow(..), Effvar(..), effvarId, pureRow}
import types.effect_authority.{Authority(..), Authvar(..), authvarId}
import types.publish.{
  PubScheme(..), VarKind(..), LiveCell(..), emptyZonk, zonkMono, zonkScheme,
  freezePub, liveCells, atGraphEnd, graphReport, ppPubScheme, TcReport(..),
  CheckedProgram(..), PartialAnalysis(..), ModDiags, TcDiag(..), noEntryTables
}
import types.disposition.{
  MethodDisposition(..), emptyDispositionTable, dispositionRows, dispositionKey,
  dispositionInstance, dispositionMethod, dispositionIface
}
import types.evidence_coverage.{EvShape(..), evShapeOf}
import types.runtime_types.{binderOrdinal, emptyBinderTypes}
import map.{values}
import types.tc_types.{
  MethodReturnMemoView(..), DriveOutputs(..), InvocationView(..), TcConfig(..)
}
import types.typecheck.{
  defaultDriveInputs, checkOneSchemeFullK, checkModulesDiagsChain,
  checkModulesAllLines, elaborateModulesReport, checkModules,
  methodReturnMemoCurrentViews, methodReturnMemoRetentionStats,
  chainMemoReplayedSteps, tcCode, tcMsg, checkModulesChainReportFor,
  checkModulesChainReportForGraph, checkOneReportK, checkModulesPartialK,
  elaborateModulesWithReport, driveInputsFor, tcConfigOf
}
import driver.diagnostics.{analyzeProjectReport, noStdlibExports}
import tools.lsp.{typeAtPoint}
import test_process.{withScratchDir}

int : Mono
int = TCon "Int" OriginBuiltin

untouched : (Int, Int) -> Ref Tyvar -> Bool
untouched (id, lvl) cell = match !cell
  Unbound i l => i == id && l == lvl
  Link _ => False

tvar : Int -> Mono
tvar id = TVar (Ref (Unbound id 1))

scheme : List Int -> List Int -> List Int -> EffRow -> Mono -> Scheme
scheme ids effIds authIds row t = Forall ids effIds authIds [] row t

plainScheme : Mono -> Scheme
plainScheme t = scheme [] [] [] pureRow t

pub : Scheme -> PubScheme
pub s = PubScheme { psScheme = s, psContext = [] }

speakObl : List Int -> List Mono -> VecObl
speakObl ids args = VecObl {
  voIface = IfaceRef { irName = "Speak", irOrigin = OriginBuiltin },
  voIds = ids,
  voArgs = args,
}

arrowRow : Mono -> EffRow
arrowRow (TFun _ row _) = row
arrowRow _ = pureRow

joinMembers : EffRow -> List (Ref Effvar)
joinMembers (EffRow _ (Some cell)) = match !cell
  EJoin _ _ ms => ms
  _ => []
joinMembers _ = []

tailId : EffRow -> Option Int
tailId (EffRow _ (Some cell)) = Some (effvarId cell)
tailId _ = None

frozenBody : PubScheme -> Mono
frozenBody (PubScheme { psScheme = (Forall _ _ _ _ _ t) }) = t

test "a Link chain is followed and no live cell remains" =
  let inner = Ref (Link int)
  let outer = Ref (Link (TVar inner))
  let (_, s) = zonkScheme emptyZonk (plainScheme (TVar outer))
  expectEach [
    ("renders as the target", expectEqual "Int" (ppScheme s)),
    (
      "the source chain is untouched",
      expectEqual "Int" (ppScheme (plainScheme (TVar outer))),
    ),
    ("no live cell", expectEqual [] (liveCells "f" (pub s))),
  ]

test "a free Unbound is re-minted with its id and reported as FreeMeta" =
  let src = Ref (Unbound 7 3)
  let p = freezePub (plainScheme (TFun (TVar src) pureRow int)) []
  let reminted = match frozenBody p
    TFun (TVar c) _ _ => c
    _ => src
  let found = liveCells "f" p
  let _ = reminted := Link int
  expectEach [
    (
      "source cell not written",
      expectTrue (untouched (7, 3) src),
    ),
    ("reported", expectEqual [FreeMeta "f" TyVarK 7] found),
    (
      "weak at graph end",
      expectEqual [WeakVar "f" TyVarK 7] (atGraphEnd found),
    ),
  ]

test "a quantified id is not a live cell" =
  let p =
    freezePub (scheme [7] [] [] pureRow (TFun (tvar 7) pureRow (tvar 7))) []
  expectEqual [] (liveCells "f" p)

test "an ELink tail is followed to the unbound cell" =
  let leaf = Ref (EUnbound 4 1)
  let link = Ref (ELink 3 (EffRow [] (Some leaf)))
  let body = TFun int (EffRow [] (Some link)) int
  let (_, Forall _ _ _ _ _ t) = zonkScheme emptyZonk (plainScheme body)
  let p = freezePub (scheme [] [4] [] pureRow body) []
  expectEach [
    ("tail is the leaf id", expectEqual (Some 4) (tailId (arrowRow t))),
    ("no live cell", expectEqual [] (liveCells "f" p)),
  ]

test "an unlinked ELink in tail position is a LinkCell" =
  let link = Ref (ELink 3 (EffRow [] None))
  let p = pub (plainScheme (TFun int (EffRow [] (Some link)) int))
  expectEqual [LinkCell "f" EffVarK (Some 3)] (liveCells "f" p)

test "a type-variable Link left in a scheme is a LinkCell with no id" =
  let p = pub (plainScheme (TFun (TVar (Ref (Link int))) pureRow int))
  expectEqual [LinkCell "f" TyVarK None] (liveCells "f" p)

test "a rebuilt EJoin keeps one frozen cell per member id" =
  let m1 = Ref (EUnbound 1 1)
  let m2 = Ref (EUnbound 2 1)
  let j1 = Ref (EJoin 10 1 [m1, m2])
  let j2 = Ref (EJoin 11 1 [m2, m1])
  let body = TFun int (EffRow [] (Some j1)) (TFun int (EffRow [] (Some j2)) int)
  let p = freezePub (scheme [] [1, 2] [] pureRow body) []
  let (r1, r2) = match frozenBody p
    TFun _ a (TFun _ b _) => (a, b)
    _ => (pureRow, pureRow)
  let first = joinMembers r1
  let second = joinMembers r2
  let _ = match first
    c :: _ => c := EUnbound 1 99
    [] => ()
  let seenThroughOther = match second
    [_, c] => match !c
      EUnbound _ lvl => lvl
      _ => 0 - 1
    _ => 0 - 2
  expectEach [
    ("two members each", expectEqual (2, 2) (length first, length second)),
    ("member 1 is one cell across joins", expectEqual 99 seenThroughOther),
    ("source member untouched", expectEqual 1 (effvarId m1)),
    ("no live cell", expectEqual [] (liveCells "f" p)),
  ]

test "an AVar link is followed and an unbound AVar is re-minted" =
  let inner = Ref (AUnbound 6 1 PUnit False None)
  let linked = Ref (ALink 5 PUnit (AVar inner))
  let body = TQual int (AVar linked)
  let (_, Forall _ _ _ _ _ t) = zonkScheme emptyZonk (plainScheme body)
  let id = match t
    TQual _ (AVar c) => authvarId c
    _ => 0 - 1
  expectEach [
    ("follows to the unbound id", expectEqual 6 id),
    (
      "reported",
      expectEqual
        [FreeMeta "f" AuthVarK 6]
        (liveCells "f" (freezePub (plainScheme body) [])),
    ),
  ]

test "an unsolved ESummary is an OpenSummary" =
  let sum = Ref (ESummary 12 0 0)
  let p = freezePub (plainScheme (TFun int (EffRow [] (Some sum)) int)) []
  expectEqual [OpenSummary "f" 12] (liveCells "f" p)

test "freeze shares one cell per id between a scheme and its context" =
  let src = tvar 3
  let p = freezePub (scheme [3] [] [] pureRow (TFun src pureRow src)) [
    speakObl [3] [src],
  ]
  let schemeCell = match frozenBody p
    TFun (TVar c) _ _ => Some c
    _ => None
  let ctxCell = match p.psContext
    [VecObl { voArgs = [TVar c] }] => Some c
    _ => None
  let _ = match schemeCell
    Some c => c := Link int
    None => ()
  let seen = match ctxCell
    Some c => match !c
      Link _ => True
      _ => False
    None => False
  expectEach [
    ("context shares the scheme's cell", expectTrue seen),
    (
      "context renders against the scheme's variable",
      expectEqual "Speak Int => Int -> Int" (ppPubScheme p),
    ),
  ]

-- ── pins ───────────────────────────────────────────────────────────────────

pSrc : String
pSrc = joinNl [
  "interface Speak a where",
  "  speak : a -> String",
  "impl Speak Int where",
  "  speak _ = \"int\"",
  "useSpeak x = speak x",
  "pairUp x y = (speak x, y)",
]

-- Q also binds `useSpeak`, with a different shape, so the obligation table
-- the second drive leaves holds a same-named entry over other tyvar ids.
qSrc : String
qSrc = joinNl [
  "interface Speak a where",
  "  speak : a -> String",
  "useSpeak f y x = speak x",
  "other = 1",
]

drive : String -> String -> List (String, PubScheme)
drive mid src =
  let (_, own) = checkOneSchemeFullK defaultDriveInputs None [] [] (
    mid,
    desugar (parseLocated src),
  )
  own

rendered : List (String, PubScheme) -> List String
rendered ss = map (e => "\{fst e} : \{ppPubScheme (snd e)}") ss

linkCount : Scheme -> Int
linkCount (Forall _ _ _ _ _ t) = monoLinks t

monoLinks : Mono -> Int
monoLinks (TVar cell) = match !cell
  Link t2 => 1 + monoLinks t2
  Unbound _ _ => 0
monoLinks (TApp a b) = monoLinks a + monoLinks b
monoLinks (TFun a _ b) = monoLinks a + monoLinks b
monoLinks (TQual a _) = monoLinks a
monoLinks _ = 0

test "#4053: P's scheme renders the same after Q's drive" =
  let p = drive "p" pSrc
  let before = rendered p
  let _ = drive "q" qSrc
  expectEqual
    0
    (length (filter (pr => fst pr /= snd pr) (zip before (rendered p))))

test "published schemes hold no Link" =
  let p = drive "p" pSrc
  expectEqual 0 (fold (acc e => acc + linkCount (snd e).psScheme) 0 p)

-- A prelude binding with a declared context, shadowed by a buffer binding.
shadowedPrelude : String
shadowedPrelude = joinNl [
  "interface Speak a where",
  "  speak : a -> String",
  "isEven : Speak a => a -> String",
  "isEven x = speak x",
]

test "#2054: a shadowing buffer binding carries its own context, not the prelude's" =
  let (core, own) = checkOneSchemeFullK defaultDriveInputs None [] (desugar
    (parse shadowedPrelude)) (
    "buffer",
    desugar (parseLocated "isEven x = \"s\""),
  )
  let named = ss => rendered (filter (e => fst e == "isEven") ss)
  expectEqual
    (["isEven : a -> String"], ["isEven : Speak a => a -> String"])
    (named own, named core)

-- ── same-process P -> Q -> P (the V2 acceptance) ───────────────────────────

numPrelude : String
numPrelude = joinNl [
  "interface Num a where",
  "  fromInt : Int -> a",
  "impl Num Int where",
  "  fromInt _ = 0",
]

-- Exports a ground value, a declared-context binding and an inferred-context
-- binding, so the published context rides three routes.
accPrefix : Bool -> String
accPrefix useBool =
  let head = if useBool then "Bool" else "Int"
  let value = if useBool then "True" else "41"
  joinNl [
    "export interface Need a where",
    "  need : a -> Int",
    "impl Need \{head} where",
    "  need _ = 1",
    "export interface CachedChoice a where",
    "  cachedChoose : Unit -> a",
    "impl CachedChoice \{head} requires Need \{head} where",
    "  cachedChoose _ = \{value}",
    "export cached : \{head}",
    "cached = cachedChoose ()",
    "export interface Hidden a b where",
    "  hidden : Unit -> a",
    "export useHidden : Hidden a b => b -> a",
    "useHidden witness = hidden ()",
    "export useNeed x = need x",
  ]

accEntry : String
accEntry = "import acc_prefix.{cached, useHidden, useNeed}\nentry = cached\n"

accConflict : String
accConflict = joinNl [
  accPrefix False,
  "impl CachedChoice Int requires Need Int where",
  "  cachedChoose _ = 99",
]

-- (the keyed chain's report, memo views taken right after the drive)
accDrive : String ->
  String ->
  String ->
  String ->
  (TcReport, List MethodReturnMemoView)
accDrive chainKey prefixSource entrySource stepKey =
  let ((report, _), gctx) =
    checkModulesChainReportForGraph
      defaultDriveInputs
      False
      (Some (4053, 4055))
      chainKey
      [Some stepKey, None]
      []
      (desugar (parse numPrelude))
      [
        ("acc_prefix", desugar (parseLocated prefixSource)),
        ("acc_entry", desugar (parseLocated entrySource)),
      ]
  (report, methodReturnMemoCurrentViews gctx)

-- Schemes WITH their context, diagnostics, the memo views, and the checked
-- program's evidence and dispositions, rendered at the moment of the call.
accRender : (TcReport, List MethodReturnMemoView) -> List String
accRender (r, views) =
  flatMap accRenderMod r.trDiagnostics
    ++ map debug views
    ++ accRenderChecked r.trChecked

-- The evidence in ordinal order, each id replaced by its rank, then the
-- disposition rows; `withheld` when there is no checked program.
accRenderChecked : Option CheckedProgram -> List String
accRenderChecked None = ["withheld"]
accRenderChecked (Some c) =
  let ordered =
    sortOn
      (e => match e
        EvEntry (EvId m i) _ => (m, i))
      c.cpEvidence
  "checked"
    :: map
        (ie => match ie
          (rank, EvEntry _ v) => "ev \{debug rank} \{valText v}")
        (indexed ordered)
      ++ map dispositionText (dispositionRows c.cpDispositions)

dispositionText : MethodDisposition -> String
dispositionText d =
  let kind = match d
    Supplied {  } => "supplied"
    InheritedDefault {  } => "inherited"
  let key = dispositionKey (dispositionInstance d) (dispositionMethod d)
  "disp \{kind} \{(dispositionIface d).irName} \{key}"

accRenderMod : ModDiags -> List String
accRenderMod (mid, (ss, errs, warns)) =
  ["module \{mid}"]
    ++ rendered ss
    ++ map (d => "diag \{tcCode d}: \{tcMsg d}") (errs ++ warns)

accLinks : (TcReport, List MethodReturnMemoView) -> Int
accLinks (r, _) =
  fold
    (acc (_, (ss, _, _)) =>
      acc + fold (a e => a + linkCount (snd e).psScheme) 0 ss)
    0
    r.trDiagnostics

accRetainedSteps : Unit -> Int
accRetainedSteps _ =
  let (_, _, n) = methodReturnMemoRetentionStats ()
  n

data QKind = QKind String (Unit -> Int)

accQs : List QKind
accQs = [
  QKind "clean" (_ =>
    let _ = accDrive "acc-q" (accPrefix False) "entry = 1\n" (accPrefix False)
    0),
  QKind "failing" (_ =>
    let _ =
      accDrive
        "acc-q"
        (accPrefix False)
        "entry : Int\nentry = \"wrong\"\n"
        (accPrefix False)
    0),
  QKind "conflicting" (_ =>
    let _ = accDrive "acc-q" accConflict accEntry accConflict
    0),
  QKind "keyed hit over a ground prefix" (_ =>
    let _ = accDrive "acc-p" (accPrefix False) accEntry (accPrefix False)
    accRetainedSteps ()),
  QKind "keyed miss" (_ =>
    let _ = accDrive "acc-p" (accPrefix True) accEntry (accPrefix True)
    0),
]

accCheck : QKind -> (String, Expectation)
accCheck (QKind name run) =
  let pSrc2 = accPrefix False
  let cold = accRender (accDrive "acc-cold-\{name}" pSrc2 accEntry pSrc2)
  let held = accDrive "acc-p" pSrc2 accEntry pSrc2
  let steps = run ()
  let after = accRender held
  let warm = accRender (accDrive "acc-p" pSrc2 accEntry pSrc2)
  let hitRetained =
    if name == "keyed hit over a ground prefix" then
      expectGreaterThan 0 steps
    else
      expectEqual 0 0
  (
    name,
    expectEach [
      ("held P renders as it did", expectEqual cold after),
      ("re-driven P equals cold P", expectEqual cold warm),
      (
        "P carries an inferred context",
        expectEqual
          ["useNeed : Need a => a -> Int"]
          (filter (== "useNeed : Need a => a -> Int") cold),
      ),
      ("a hit really retained a chain step", hitRetained),
      ("held P publishes no Link", expectEqual 0 (accLinks held)),
      (
        "cold P is checked",
        expectEqual ["checked"] (filter (== "checked") cold),
      ),
      (
        "cold P has evidence and dispositions",
        expectEqual
          (True, True)
          (
            not (isEmpty (filter (startsWith "ev ") cold)),
            not (isEmpty (filter (startsWith "disp ") cold)),
          ),
      ),
    ],
  )

test "P -> Q -> P: P rendered after Q equals cold P, for every kind of Q" =
  expectEach (map accCheck accQs)

test "the keyed chain's report: withheld on an ill-typed graph, checked on a clean one" =
  let pSrc2 = accPrefix False
  let (bad, _) =
    accDrive "acc-chain-bad" pSrc2 "entry : Int\nentry = \"wrong\"\n" pSrc2
  let (good, _) = accDrive "acc-chain-good" pSrc2 accEntry pSrc2
  expectEach [
    ("ill-typed: withheld", expectTrue (isNone bad.trChecked)),
    ("clean: checked", expectTrue (isSome good.trChecked)),
  ]

weakChainSteps : String -> Int
weakChainSteps held =
  let src = joinNl [
    "public export data Box a = Box a | Empty",
    "idf x = x",
    held,
  ]
  let mainSrc = joinNl [
    "import weak_a.{Box(..), held}",
    "use : Box Int -> Int",
    "use b = match b",
    "  Box _ => 1",
    "  Empty => 0",
    "entry = use held",
  ]
  let _ =
    checkModulesDiagsChain
      defaultDriveInputs
      (Some (4053, 4056))
      "acc-weak-\{held}"
      [Some src, None]
      []
      []
      [
        ("weak_a", desugar (parseLocated src)),
        ("weak_main", desugar (parseLocated mainSrc)),
      ]
  accRetainedSteps ()

test "a weak-variable prefix records no chain step; the ground twin records one" = expectEach
  [
    ("weak: none", expectEqual 0 (weakChainSteps "export held = idf Empty")),
    ("ground: one", expectEqual 1 (weakChainSteps "export held = Box 1")),
  ]

-- Contract section 7: an instance that becomes graph-visible in a prefix module
-- LATER than the module that resolves against it.  `a` uses `speak` at `Int`,
-- `b` holds (or drops) the `impl`, `e` imports both, so `a`'s own step key never
-- changes while its verdict depends on `b`.  #4266: a warm drive replays `a`'s
-- verdict from the memo.
instIface : String
instIface = "export interface Speak a where\n  speak : a -> String\n"

instUse : String
instUse =
  "import i.{Speak, speak}\nexport useA : Int -> String\nuseA n = speak n\n"

instHolder : Bool -> String
instHolder withImpl =
  let implSrc =
    if withImpl then
      "export impl Speak Int where\n  speak _ = \"int\"\n"
    else
      ""
  "import i.{Speak, speak}\n\{implSrc}export bval = 1\n"

instEntry : String
instEntry = "import a.{useA}\nimport b.{bval}\nentry = useA bval\n"

instErrors : String -> Bool -> List String
instErrors key withImpl =
  let bSrc = instHolder withImpl
  let mods =
    checkModulesDiagsChain
      defaultDriveInputs
      (Some (4266, 4267))
      key
      [Some instIface, Some instUse, Some bSrc, None]
      []
      (desugar (parse ""))
      [
        ("i", desugar (parseLocated instIface)),
        ("a", desugar (parseLocated instUse)),
        ("b", desugar (parseLocated bSrc)),
        ("e", desugar (parseLocated instEntry)),
      ]
  flatMap
    (m => match m
      (mid, (_, errs, _)) => map (d => "\{mid}: \{tcMsg d}") errs)
    mods

test "a graph-visible instance dropped from a later prefix module: warm equals cold" =
  let _ = instErrors "inst-k" True
  let warm = instErrors "inst-k" False
  let cold = instErrors "inst-cold" False
  expectEach [
    (
      "cold run reports the missing instance",
      expectGreaterThan 0 (length cold),
    ),
    (
      "warm run reports as many errors as cold",
      expectEqual (length cold) (length warm),
    ),
  ]

test "a graph-visible instance added to a later prefix module: warm equals cold" =
  let _ = instErrors "inst-k2" False
  let warm = instErrors "inst-k2" True
  let cold = instErrors "inst-cold2" True
  expectEqual cold warm

-- The mark set: a later module's `=>` signature names a binding that an earlier
-- module also declares, so the earlier module's occurrence is marked a dict
-- application.  Schemes and diagnostics do not move; the checked program's
-- evidence does.
markA : String
markA = "h : Int -> Int\nh x = x\nexport useA : Int -> Int\nuseA = h\n"

markB : Bool -> String
markB constrained =
  if constrained then
    "import i.{Speak, speak}\nexport h : Speak a => a -> String\nh x = speak x\nexport bval = 1\n"
  else
    "import i.{Speak, speak}\nexport bval = 1\n"

markEntry : String
markEntry = "import a.{useA}\nimport b.{bval}\nentry = bval\n"

markDrive : String -> Bool -> List String
markDrive key constrained =
  let bSrc = markB constrained
  let (report, _) =
    checkModulesChainReportFor
      defaultDriveInputs
      False
      (Some (4266, 4267))
      key
      [Some instIface, Some markA, Some bSrc, None]
      []
      (desugar (parse ""))
      [
        ("i", desugar (parseLocated instIface)),
        ("a", desugar (parseLocated markA)),
        ("b", desugar (parseLocated bSrc)),
        ("e", desugar (parseLocated markEntry)),
      ]
  accRenderChecked report.trChecked

test "a later module's constrained signature name: warm evidence equals cold" =
  let _ = markDrive "mark-k" True
  let warmRemoved = markDrive "mark-k" False
  let coldRemoved = markDrive "mark-cold" False
  let _ = markDrive "mark-k2" False
  let warmAdded = markDrive "mark-k2" True
  let coldAdded = markDrive "mark-cold2" True
  expectEach [
    ("removed", expectEqual coldRemoved warmRemoved),
    ("added", expectEqual coldAdded warmAdded),
  ]

-- Steps replayed by the last keyed drive, with the entry varied.  A body edit
-- touches no fingerprinted input and replays the whole prefix; an orphan impl in
-- the entry changes the graph key and replays none.
replayDrive : String -> String -> Int
replayDrive key entrySrc =
  let bSrc = instHolder True
  let _ =
    checkModulesChainReportFor
      defaultDriveInputs
      False
      (Some (4266, 4267))
      key
      [Some instIface, Some instUse, Some bSrc, None]
      []
      (desugar (parse ""))
      [
        ("i", desugar (parseLocated instIface)),
        ("a", desugar (parseLocated instUse)),
        ("b", desugar (parseLocated bSrc)),
        ("e", desugar (parseLocated entrySrc)),
      ]
  chainMemoReplayedSteps ()

test "the chain memo replays the prefix after a body edit and not after an orphan impl" =
  let _ = replayDrive "replay-k" instEntry
  let afterBody = replayDrive "replay-k" (instEntry ++ "extra = 42\n")
  let _ = replayDrive "replay-k2" instEntry
  let afterImpl =
    replayDrive
      "replay-k2"
      ("import i.{Speak}\n"
        ++ instEntry
        ++ "impl Speak Bool where\n  speak _ = \"b\"\n")
  expectEach [
    ("body edit replays the three prefix steps", expectEqual 3 afterBody),
    ("orphan impl replays none", expectEqual 0 afterImpl),
  ]

-- The same-module variant: the instance sits in the prefix module whose own step
-- key changes, so its step misses.  This is a different case from the one above.
test "a graph-visible instance added to the prefix: warm P' equals cold P'" =
  let noInst = joinNl [
    "export interface Speak a where",
    "  speak : a -> String",
    "export useSpeak x = speak x",
  ]
  let withInst = joinNl [noInst, "impl Speak Int where", "  speak _ = \"int\""]
  let entry = "import acc_prefix.{useSpeak}\nentry = useSpeak 1\n"
  let _ = accDrive "acc-inst" noInst entry noInst
  let warm = accRender (accDrive "acc-inst" withInst entry withInst)
  let _ = accDrive "acc-inst-other" (accPrefix False) accEntry (accPrefix False)
  let cold = accRender (accDrive "acc-inst-cold" withInst entry withInst)
  expectEqual cold warm

-- ── graphReport ────────────────────────────────────────────────────────────

modOf : List (String, PubScheme) -> List TcDiag -> ModDiags
modOf ss errs = ("m", (ss, errs, []))

-- The weak variables of the checked program, or None when it is withheld.
checkedWeak : List ModDiags -> List (String, TcDiag) -> Option (List LiveCell)
checkedWeak mods residual =
  map
    (c => c.cpWeak)
    (graphReport
      mods
      []
      residual
      (_ => [])
      emptyDispositionTable
      emptyBinderTypes
      None
      noEntryTables).trChecked

weakScheme : PubScheme
weakScheme = pub (plainScheme (TFun (tvar 7) pureRow int))

someDiag : TcDiag
someDiag = TcDiag "E0001" 1 None "boom" None None

test "graphReport: a clean graph is checked and lists its weak variables" =
  expectEqual
    (Some [WeakVar "f" TyVarK 7])
    (checkedWeak [modOf [("f", weakScheme)] []] [])

test "graphReport: a module error withholds the checked program" =
  expectEqual None (checkedWeak [modOf [("f", weakScheme)] [someDiag]] [])

test "graphReport: a residual diagnostic withholds the checked program" =
  expectEqual None (checkedWeak [modOf [] []] [("m", someDiag)])

test "graphReport: a left LinkCell withholds the checked program" =
  let linked = pub (plainScheme (TFun (TVar (Ref (Link int))) pureRow int))
  expectEqual None (checkedWeak [modOf [("f", linked)] []] [])

test "graphReport: an open summary withholds the checked program" =
  let unsolved =
    pub (plainScheme (TFun int (EffRow [] (Some (Ref (ESummary 12 0 0)))) int))
  expectEqual None (checkedWeak [modOf [("f", unsolved)] []] [])

-- ── checkModules freezes its result ────────────────────────────────────────

isLinkCell : LiveCell -> Bool
isLinkCell (LinkCell _ _ _) = True
isLinkCell _ = False

test "checkModules publishes no live Link" =
  let mods =
    checkModules defaultDriveInputs [] [] [("p", desugar (parseLocated pSrc))]
  let found =
    flatMap (m => flatMap (e => liveCells (fst e) (snd e)) (snd m)) mods
  expectEqual [] (filter isLinkCell found)

test "checkModulesAllLines shows useSpeak's context under its module" =
  let ls =
    lines
      (checkModulesAllLines defaultDriveInputs [] [] [
        ("p", desugar (parseLocated pSrc)),
        ("q", desugar (parseLocated "other = 1")),
      ])
  let inP =
    takeWhile (l => l /= "## MODULE q") (dropWhile (l => l /= "## MODULE p") ls)
  expectEqual
    ["useSpeak : Speak a => a -> String"]
    (filter (== "useSpeak : Speak a => a -> String") inP)

-- ── the report's evidence and the prelude's contexts on the tree arm ───────

talkPrelude : String
talkPrelude = joinNl [
  "interface Speak a where",
  "  speak : a -> String",
  "talk : Speak a => a -> String",
  "talk x = speak x",
  "impl Speak Int where",
  "  speak _ = \"i\"",
]

-- A method occurrence, a dictionary application, an operator and literals.
talkBuffer : String
talkBuffer = "own x = talk x\nuse = talk 1\nn = 1 + 2\n"

talkReport : Unit -> TcReport
talkReport _ = elaborateModulesReport defaultDriveInputs [] (desugar
  (parse talkPrelude)) [
  ("b", desugar (parseLocated talkBuffer)),
]

routeText : Route -> String
routeText RNone = "none"
routeText (RKey w ds sups) = "key(\{w};\{routesText ds};\{routesText sups})"
routeText (RDict d) = "dict(\{d})"
routeText (RDictFwd d) = "fwd(\{d})"
routeText (RLocal s ds) = "local(\{s};\{routesText ds})"
routeText (RScalar s) = "scalar(\{s})"
routeText (RProj r path) = "proj(\{routeText r};\{debug path})"

routesText : List Route -> String
routesText rs = joinWith "," (map routeText rs)

valText : EvVal -> String
valText (EvOne r) = routeText r
valText (EvMany rs) = routesText rs
valText (EvMethod iface arity r impls meths) =
  "\{iface}/\{debug arity} \{routeText r} \{routesText impls} \{routesText meths}"
valText (EvLit f r) = "\{debug f} \{routeText r}"
valText (EvHead h) = h

-- Which of [shapes] some entry of [table] has.
shapesPresent : List EvShape -> List EvEntry -> List Bool
shapesPresent shapes table =
  let have =
    map
      (e => match e
        EvEntry _ v => evShapeOf v)
      table
  map (k => not (isEmpty (filter (== k) have))) shapes

test "a driven program's cpEvidence carries every kind the program mints" =
  let r = talkReport ()
  let table = match r.trChecked
    Some c => c.cpEvidence
    None => []
  let kinds = [ShapeOne, ShapeMany, ShapeMethod, ShapeLit]
  expectEach [
    ("checked, with no fault", expectEqual [] r.trEvidenceFaults),
    (
      "every kind the program mints is present",
      expectEqual (map (_ => True) kinds) (shapesPresent kinds table),
    ),
  ]

test "a driven program's cpBinders carries one row per binder ordinal" =
  let r = talkReport ()
  let carried = match r.trChecked
    Some c => sort (map (b => binderOrdinal b.brId) (values c.cpBinders))
    None => []
  expectEach [
    ("carries rows", expectTrue (not (isEmpty carried))),
    ("ordinals are unique", expectEqual carried (dedupSorted carried)),
  ]

dedupSorted : List Int -> List Int
dedupSorted (a :: b :: rest) =
  if a == b then dedupSorted (b :: rest) else a :: dedupSorted (b :: rest)
dedupSorted xs = xs

-- ── a drive's outputs ────────────────────────────────────────────────────────
-- `DriveOutputs` is booleans, immutable tables and an `InvocationView`; the view's
-- schemes are the only fields whose type reaches a cell, so they are walked as a
-- `CheckedProgram`'s are.

outputsSrc : String
outputsSrc = joinNl [
  "data Box a = Box a | Hollow",
  "unbox : Box Int -> Int",
  "unbox (Box n) = n",
  "unbox Hollow = 0",
  "main = 1",
]

outputsOf : String -> String -> DriveOutputs
outputsOf mid src =
  match (elaborateModulesWithReport defaultDriveInputs False None [] [] [
    (mid, desugar (parseLocated src)),
  ])
    (_, _, outputs) => outputs

viewSchemes : InvocationView -> List Scheme
viewSchemes (InvocationView ctors _ _) = ctors

test "a drive's outputs hold no live cell and survive a later drive" =
  let outputs = outputsOf "o" outputsSrc
  let ctors = viewSchemes outputs.doInvocationView
  let rendered = map ppScheme ctors
  let found = flatMap (s => liveCells "ctor" (pub s)) ctors
  let _ = outputsOf "p" "data Other = A | B Int\nz = B 1\n"
  expectEach [
    (
      "the view lists the program's constructors",
      expectGreaterThan 0 (length ctors),
    ),
    ("no link and no free cell is reachable", expectEqual [] found),
    (
      "a later drive leaves the schemes as rendered",
      expectEqual rendered (map ppScheme ctors),
    ),
  ]

test "a drive's outputs answer for its own main and its own effect domains" =
  let outputs = outputsOf "o" outputsSrc
  let rejected = outputsOf "q" "bad : Int\nbad = \"x\"\n"
  expectEach [
    ("an Int main is not Unit", expectFalse outputs.doMainIsUnit),
    ("an Int main is not Float", expectFalse outputs.doMainIsFloat),
    ("an Int main is not Async", expectFalse outputs.doMainIsAsync),
    ("a clean program armed nothing", expectFalse outputs.doHadTypeErrors),
    (
      "a rejected program armed the sticky flag",
      expectTrue rejected.doHadTypeErrors,
    ),
    (
      "the builtin domains are registered",
      expectGreaterThan 0 (length outputs.doEffectDomains),
    ),
  ]

test "#4267: the tree arm publishes the prelude's context" =
  let core = (talkReport ()).trPartial.paCore
  expectEqual
    ["talk : Speak a => a -> String"]
    (rendered (filter (e => fst e == "talk") core))

-- ── the partial analysis: locals, seed and module ─────────────────────────

-- A local constrained binding and a prelude name with a context in the seed.
localBuffer : String
localBuffer = "own x =\n  let g y = talk y\n  g x\n"

locText : Option Loc -> String
locText (Some (Loc _ l1 c1 l2 c2)) =
  "\{debug l1}:\{debug c1}-\{debug l2}:\{debug c2}"
locText None = "-"

-- The local and seed names `localBuffer`'s drive captures, as the renderers the
-- hover surfaces used before the analysis carried them showed them (pinned from
-- the base binary).  An interface method in the seed and an unsigned local render
-- without their interface context.
pinnedLocals : List String
pinnedLocals = [
  "g 2:6-2:7 : a -> String",
  "y 2:8-2:9 : a",
  "x 1:4-1:5 : a",
]

pinnedSeed : List String
pinnedSeed = ["speak : a -> String", "talk : Speak a => a -> String"]

capturedTables : PartialAnalysis -> (List String, List String)
capturedTables pa = (
  map ((n, p, loc) => "\{n} \{locText loc} : \{ppPubScheme p}") pa.paLocals,
  rendered pa.paSeed,
)

talkCore : List Decl
talkCore = desugar (parse talkPrelude)

test "diags arm: the captured locals and seed render as the hover renderers did" =
  let one = checkOneReportK defaultDriveInputs False None [] talkCore (
    "b",
    desugar (parseLocated localBuffer),
  )
  let project = checkModulesPartialK defaultDriveInputs None [] talkCore [
    ("b", desugar (parseLocated localBuffer)),
  ]
  expectEach [
    (
      "single file",
      expectEqual (pinnedLocals, pinnedSeed) (capturedTables one.trPartial),
    ),
    (
      "project",
      expectEqual (pinnedLocals, pinnedSeed) (capturedTables project),
    ),
  ]

test "tree arm: the seed's talk renders with the prelude's context" =
  let pa = (talkReport ()).trPartial
  expectEach [
    (
      "talk",
      expectEqual
        ["talk : Speak a => a -> String"]
        (rendered (filter (e => fst e == "talk") pa.paSeed)),
    ),
    ("the module is the entry", expectEqual "b" pa.paModule),
  ]

-- An imported module and an entry that imports it, with a resolve error in the
-- entry when [broken].
hoverEntry : Bool -> String
hoverEntry broken =
  let tail = if broken then "\nbad = undefinedThing + 1\n" else ""
  "import m7.{base}\n\nexport\nlevel6 : Int\nlevel6 = base + 6\n\{tail}\nloc z = let w = z in w\n"

-- The report of the `m7`/`m6` project, projected by [view].
projectReport : (TcReport -> a) ->
  String ->
  String ->
  String ->
  Bool ->
  <Exec, IO, FileRead, FileWrite> Result String a
projectReport view rsrc csrc dir broken =
  let entry = "\{dir}/m6.mdk"
  match (
    writeFile "\{dir}/m7.mdk" "export\nbase : Int\nbase = 1\n",
    writeFile entry (hoverEntry broken),
  )
    (Ok _, Ok _) =>
      let (report, _) =
        analyzeProjectReport
          noStdlibExports
          True
          []
          (Ref [])
          (Ref [])
          (_ => None)
          entry
          [dir, "stdlib"]
          rsrc
          csrc
      match report
        Some r => Ok (view r)
        None => Err "no report"
    _ => Err "could not write the modules"

projectModule : String ->
  String ->
  String ->
  Bool ->
  <Exec, IO, FileRead, FileWrite> String
projectModule rsrc csrc dir broken =
  match projectReport (r => r.trPartial.paModule) rsrc csrc dir broken
    Ok m => m
    Err e => e

test "a resolve-rejected graph's report is not checked; its clean twin is" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) =>
      let isChecked = r => isSome r.trChecked
      let clean = withScratchDir (dir =>
        expectEqual (Ok True) (projectReport isChecked rsrc csrc dir False))
      let blocked = withScratchDir (dir =>
        expectEqual (Ok False) (projectReport isChecked rsrc csrc dir True))
      expectEach [("clean", clean), ("entry resolve-rejected", blocked)]
    _ => fail "could not read the prelude pair"

test "paModule is the entry, or the last module checked when resolve blocks the entry" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) =>
      let clean = withScratchDir (dir =>
        expectEqual "m6" (projectModule rsrc csrc dir False))
      let blocked = withScratchDir (dir =>
        expectEqual "m7" (projectModule rsrc csrc dir True))
      expectEach [("clean", clean), ("entry resolve-rejected", blocked)]
    _ => fail "could not read the prelude pair"

-- The hover answers of the project buffer with a resolve error (`level6`, the
-- imported `base`, the local `w`), as the base binary answered them.
hoverAnswers : String ->
  String ->
  String ->
  <Exec, IO, FileRead, FileWrite> Expectation
hoverAnswers rsrc csrc dir =
  let entry = "\{dir}/m6.mdk"
  let src = hoverEntry True
  match (
    writeFile "\{dir}/m7.mdk" "export\nbase : Int\nbase = 1\n",
    writeFile entry src,
  )
    (Ok _, Ok _) => expectEach [
      (
        "level6",
        expectEqual (Some "level6 : Int") (typeAtPoint rsrc csrc entry src 4 2),
      ),
      (
        "base, imported",
        expectEqual (Some "base : Int") (typeAtPoint rsrc csrc entry src 4 11),
      ),
      (
        "w, a local",
        expectEqual (Some "w : a") (typeAtPoint rsrc csrc entry src 8 21),
      ),
    ]
    _ => fail "could not write the modules"

test "hover answers on a project buffer with a resolve error" = match (
  readFile "stdlib/runtime.mdk",
  readFile "stdlib/core.mdk",
)
  (Ok rsrc, Ok csrc) => withScratchDir (hoverAnswers rsrc csrc)
  _ => fail "could not read the prelude pair"

-- A single-file buffer with a resolve error, and one with a type error.
resolveErrorBuffer : String
resolveErrorBuffer = "f x = let y = x in undefinedThing + y\n\ng = putStrLn\n"

typeErrorBuffer : String
typeErrorBuffer =
  "f x = let y = x in y\n\ng = putStrLn\n\ntype_err : Int\ntype_err = True\n"

test "hover answers on a single-file buffer with a resolve or type error" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok rsrc, Ok csrc) =>
      let at = src l c => typeAtPoint rsrc csrc "buf.mdk" src l c
      expectEach [
        (
          "resolve error, local y",
          expectEqual (Some "y : a") (at resolveErrorBuffer 0 10),
        ),
        (
          "resolve error, param x",
          expectEqual (Some "x : a") (at resolveErrorBuffer 0 2),
        ),
        (
          "resolve error, seed putStrLn",
          expectEqual
            (Some "putStrLn : String -> <Stdout> Unit")
            (at resolveErrorBuffer 2 5),
        ),
        (
          "type error, local y",
          expectEqual (Some "y : a") (at typeErrorBuffer 0 10),
        ),
        (
          "type error, signed binding",
          expectEqual (Some "type_err : Int") (at typeErrorBuffer 4 2),
        ),
      ]
    _ => fail "could not read the prelude pair"

ownRuntime : String
ownRuntime = "extern rtAdd : Int -> Int -> Int"

ownMod : String
ownMod = joinNl [
  "export",
  "extern userX : Int -> Int",
  "export",
  "useX : Int -> Int",
  "useX n = userX n",
]

ownDrive : List String -> List String
ownDrive owned =
  let (report, _) =
    checkModulesChainReportFor
      (driveInputsFor None False owned)
      False
      (Some (4337, 4338))
      "own-chain"
      [Some "m-step", None]
      (desugar (parse ownRuntime))
      (desugar (parse numPrelude))
      [
        ("m", desugar (parseLocated ownMod)),
        (
          "e",
          desugar (parseLocated "import m.{useX}\nentry = useX 1\n"),
        ),
      ]
  flatMap (md => map tcCode (ownErrs md)) report.trDiagnostics

ownErrs : ModDiags -> List TcDiag
ownErrs (_, (_, errs, _)) = errs

test "the chain memo does not serve a hit across a stdlib ownership change" =
  let owned = ownDrive ["m"]
  let user = ownDrive []
  expectEach [
    ("stdlib-owned extern is not stamped", expectEqual [] owned),
    (
      "the same chain under no ownership misses and reports",
      expectEqual ["T-FFI-UNLABELLED"] user,
    ),
  ]

test "equal configurations digest to equal memo keys" =
  let key = owned => (tcConfigOf [] (driveInputsFor None False owned)).tcKey
  expectEach [
    ("same ownership", expectEqual (key ["b", "a"]) (key ["a", "b"])),
    ("different ownership", expectNotEqual (key ["a"]) (key [])),
    (
      "flat flag",
      expectNotEqual
        (tcConfigOf [] (driveInputsFor None True [])).tcKey
        (key []),
    ),
  ]
