-- The module interface cache: what a recorded interface replays, when a key hits,
-- and the cases a served drive must not differ from a checked one in.  Drives run
-- through `keyedDrive` with source keys, as the keyed callers do;
-- each test uses module ids and chain keys of its own, because the cache is keyed
-- by module id and lives for the process.
import test.{
  expectEach, expectEqual, expectFalse, expectGreaterThan, expectSatisfies,
  expectTrue, fail
}
import frontend.ast.{Decl, EvEntry(..), EvId(..)}
import frontend.ast_codec.{declsSExp, evEntriesSExp}
import eval.eval.{evalModulesOutputFacts}
import types.program_facts.{factsOfChecked}
import frontend.desugar.{desugar}
import frontend.parser.{parse, parseLocated}
import list.{filter, drop, take, sort, indexed}
import support.ordmap.{OrdMap, omEmpty, omFromPairs, omHasKey, omLookup}
import types.module_interface.{
  ModuleInterface(..), FrozenExport(..), ModuleKey(..), applyModuleInterface,
  currentModuleInterfaces, retainModuleInterfaces
}
import types.module_interface_test_support.{
  bareDrive, chainDrive, entrySrc, keyedDrive, leafSrc, render, renderRow
}
import types.publish.{
  CheckedProgram(..), ModDiags, PubScheme(..), ppPubScheme, TcReport(..)
}
import types.capability_manifest.{
  CapabilityManifest, ManifestSelector(..), EntryKey(..), InvocationProtocol(..)
}
import types.interface_sexp.{invocationViewSExp}
import support.sexp_value.{SExp(..), renderSExp}
import types.invocation_basis.{readInvocationView}
import types.repr.{Mono(..), Tyvar(..)}
import frontend.ast.{TyConOrigin(..)}
extern allocBytes : Unit -> <IO> Float
import string as S
import types.repr.{ppSchemeCon, Scheme(..)}
import types.tc_types.{
  DriveOutputs(..), DriveInputs(..), ExportBinding(..), GraphCtx(..),
  CrossRun(..), InvocationView(..), PublishedInvocationView(..)
}
import types.typecheck.{
  defaultDriveInputs, checkModules, checkModulesChainReportFor,
  elaborateModulesWithReport, elaborateModulesChainReport
}
import support.util.{joinNl, contains, dedup}

-- ── fixtures ────────────────────────────────────────────────────────────────

export
interfaceOf : String -> Option ModuleInterface
interfaceOf mid =
  let found =
    filter (mi => mi.miKey.mkModule == mid) (currentModuleInterfaces ())
  match found
    [mi] => Some mi
    _ => None

-- ── freeze and apply ────────────────────────────────────────────────────────

renderFrozen : FrozenExport -> String
renderFrozen fe = ppPubScheme fe.feScheme

export
renderBinding : (String, ExportBinding) -> String
renderBinding (name, b) = "\{name} : \{ppSchemeCon [] b.xbScheme}"

export
renderFrozenBinding : (String, FrozenExport) -> String
renderFrozenBinding (name, fe) = "\{name} : \{renderFrozen fe}"

-- A graph record whose drive checked one unrelated module, so it holds none of the
-- fixture leaf's names.
export
freshGraph : String -> Int -> GraphCtx
freshGraph mid seed =
  snd (bareDrive seed "fresh-\{mid}" [(mid, "export unrelated = 1")])

hasNames : GraphCtx -> List String -> Bool
hasNames g names =
  all (n => omHasKey n g.crossRun.universeFunNamesRef.value) names

test "applying a frozen interface twice yields the recorded row and the same bindings" =
  let _ = chainDrive "rt" 4601 "rt-k" leafSrc (entrySrc "rt_mid")
  match interfaceOf "rt_leaf"
    None => fail "the leaf recorded no interface"
    Some mi =>
      let g1 = freshGraph "rtfresh1" 4602
      let g2 = freshGraph "rtfresh2" 4603
      let before = hasNames g1 mi.miFunNames
      let (row1, exports1) = applyModuleInterface g1 mi
      let (row2, exports2) = applyModuleInterface g2 mi
      expectEach [
        (
          "the interface names functions",
          expectGreaterThan 0 (length mi.miFunNames),
        ),
        ("the fresh record holds none of them", expectFalse before),
        (
          "the row is the recorded one",
          expectEqual (renderRow mi.miRow) (renderRow row1),
        ),
        (
          "a second application yields the same row",
          expectEqual (renderRow row1) (renderRow row2),
        ),
        (
          "the bindings are the frozen exports",
          expectEqual
            (map renderFrozenBinding mi.miExports)
            (map renderBinding exports1),
        ),
        (
          "a second application yields the same bindings",
          expectEqual (map renderBinding exports1) (map renderBinding exports2),
        ),
        (
          "the function names are registered in the record",
          expectTrue (hasNames g1 mi.miFunNames),
        ),
      ]

-- ── hit equals miss ─────────────────────────────────────────────────────────

test "a hit prints what the miss printed" =
  let (cold, coldServed, _) =
    chainDrive "hm" 4611 "hm-k" leafSrc (entrySrc "hm_mid")
  let (warm, warmServed, _) =
    chainDrive "hm" 4611 "hm-k" leafSrc (entrySrc "hm_mid")
  expectEach [
    ("the first drive serves nothing", expectEqual 0 coldServed),
    (
      "the second serves the leaf and the middle module",
      expectEqual 2 warmServed,
    ),
    ("both print the same report", expectEqual cold warm),
    (
      "the report is not empty",
      expectSatisfies "lists schemes" (r => length r > 3) cold,
    ),
  ]

-- ── the graph key ───────────────────────────────────────────────────────────

otherSrc : String -> String
otherSrc extra = joinNl [
  "export interface Speak a where",
  "  speak : a -> String",
  extra,
]

boolSpeakImpl : String
boolSpeakImpl = """impl Speak Bool where
  speak _ = "b"
"""

-- Modules sib_leaf and sib_other; the entry imports only the leaf.
sibDrive : String -> String -> Int
sibDrive chainKey otherText =
  let entryText = joinNl ["import sib_leaf.{Box(..), wrap}", "entry = wrap 1"]
  let ((_, outputs), _) = bareDrive 4621 chainKey [
    ("sib_leaf", leafSrc),
    ("sib_other", otherText),
    ("sib_entry", entryText),
  ]
  outputs.doServedModules

test "an impl in a module the importer does not import invalidates the leaf's interface" =
  let plain = otherSrc ""
  let _ = sibDrive "sib-k" plain
  let afterBody = sibDrive "sib-k" (plain ++ "extra = 42\n")
  let _ = sibDrive "sib-k2" plain
  let afterImpl = sibDrive "sib-k2" (plain ++ boolSpeakImpl)
  expectEach [
    ("a body edit elsewhere serves the leaf", expectEqual 1 afterBody),
    ("an impl elsewhere serves nothing", expectEqual 0 afterImpl),
  ]

-- ── the counter high-water ──────────────────────────────────────────────────

-- A leaf with many generic bindings, so its variable ids are well above a small
-- module's.
manySrc : String
manySrc = joinNl (map (n => "export f\{n} x = (x, x)") [1..12])

-- The quantified type-variable ids of a scheme.
quantified : PubScheme -> List Int
quantified p = match p.psScheme
  Forall ids _ _ _ _ _ => ids

rowIds : String -> List ModDiags -> List Int
rowIds mid rows =
  flatMap
    (r => match r
      (m, (schemes, _, _)) =>
        if m == mid then flatMap (s => quantified (snd s)) schemes else [])
    rows

hwDrive : String -> String -> (List Int, List Int, Int)
hwDrive chainKey midText =
  let ((report, outputs), _) = bareDrive 4631 chainKey [
    ("hw_leaf", manySrc),
    ("hw_mid", midText),
    ("hw_entry", entrySrc "hw_mid"),
  ]
  (
    rowIds "hw_leaf" report.trDiagnostics,
    rowIds "hw_mid" report.trDiagnostics,
    outputs.doServedModules,
  )

test "a serving drive after an elaboration mints no id below an earlier drive's high-water" =
  let midText = joinNl ["import hw_leaf.{f1}", "export g x = f1 x"]
  let (leafIds, _, _) = hwDrive "hw-k" midText
  let _ =
    length
      (checkModules defaultDriveInputs [] [] [
        ("hw_pre", desugar (parseLocated "pre = 1")),
      ])
  let (servedIds, midIds, served) =
    hwDrive "hw-k" (joinNl [midText, "export g2 x = f1 x"])
  expectEach [
    ("the leaf was served", expectEqual 1 served),
    ("the served leaf keeps its ids", expectEqual leafIds servedIds),
    ("the leaf has ids", expectGreaterThan 0 (length leafIds)),
    (
      "the middle module's ids are all above the leaf's",
      expectGreaterThan (maximum leafIds) (minimum midIds),
    ),
  ]

-- ── a module that cannot record ─────────────────────────────────────────────

-- The live-root fixture of `test/dict_fixtures`: `lr_lib`'s unannotated numeric
-- binding stays open until a later module grounds it, here with a type the user
-- module never imported.  [libText] is the library module's source.
liveDrive : String -> String -> String -> String -> String -> (List String, Int)
liveDrive runtime core chainKey libText userText =
  let entryText = joinNl ["import lr_user.{u}", "entry = u"]
  let ((report, outputs), _) = keyedDrive 4641 chainKey (desugar
    (parse runtime)) (desugar (parse core)) [
    ("lr_lib", libText),
    ("lr_user", userText),
    ("lr_entry", entryText),
  ]
  (render report, outputs.doServedModules)

openLib : String
openLib = joinNl [
  "double n = n + n",
  "inc n = n + 1",
  "export e20 = double >> inc",
]

groundedLib : String
groundedLib = joinNl [
  "double : Int -> Int",
  "double n = n + n",
  "inc : Int -> Int",
  "inc n = n + 1",
  "export e20 = double >> inc",
]

userSrc : String
userSrc = joinNl ["import lr_lib.{e20}", "export u = e20 (200 : U8)"]

test "a module whose live root is open records nothing; it and its importers are re-checked" =
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok runtime, Ok core) =>
      let (openFirst, openFirstServed) =
        liveDrive runtime core "lr-open" openLib userSrc
      let (openSecond, openSecondServed) =
        liveDrive runtime core "lr-open" openLib userSrc
      let (_, groundedFirstServed) =
        liveDrive runtime core "lr-ground" groundedLib userSrc
      let (_, groundedSecondServed) =
        liveDrive runtime core "lr-ground" groundedLib userSrc
      expectEach [
        ("open: the first drive serves nothing", expectEqual 0 openFirstServed),
        (
          "open: the second drive serves nothing",
          expectEqual 0 openSecondServed,
        ),
        ("open: the report is unchanged", expectEqual openFirst openSecond),
        (
          "grounded control: first serves nothing",
          expectEqual 0 groundedFirstServed,
        ),
        (
          "grounded control: second serves the library and the user module",
          expectEqual 2 groundedSecondServed,
        ),
      ]
    _ => fail "could not read the prelude pair"

-- ── modules after an unrecorded one ─────────────────────────────────────────

-- [lp_lib] stays open (`openLib`); [lp_a] and [lp_b] come after it and import
-- nothing; [lp_user] imports it and grounds it.
liveGraph : String -> String -> String -> Int -> String -> (List String, Int)
liveGraph runtime core chainKey seed userText =
  let entryText = joinNl [
    "import lp_user.{u}",
    "import lp_a.{fa}",
    "import lp_b.{fb}",
    "entry = (u, fa 1, fb 1)",
  ]
  let ((report, outputs), _) = keyedDrive seed chainKey (desugar
    (parse runtime)) (desugar (parse core)) [
    ("lp_lib", openLib),
    ("lp_a", "export fa x = (x, [x])"),
    ("lp_b", "export fb x = (x, [x], 2)"),
    ("lp_user", userText),
    ("lp_entry", entryText),
  ]
  (render report, outputs.doServedModules)

test "modules after an unrecorded module record and are served; its importers are re-checked" =
  let userText = joinNl ["import lp_lib.{e20}", "export u = e20 (200 : U8)"]
  match (readFile "stdlib/runtime.mdk", readFile "stdlib/core.mdk")
    (Ok runtime, Ok core) =>
      let (first, firstServed) = liveGraph runtime core "lp-k" 4651 userText
      let (second, secondServed) = liveGraph runtime core "lp-k" 4651 userText
      let (cold, _) = liveGraph runtime core "lp-cold" 4652 userText
      expectEach [
        ("the first drive serves nothing", expectEqual 0 firstServed),
        (
          "the second serves the two independent modules",
          expectEqual 2 secondServed,
        ),
        (
          "the second drive prints what the first did",
          expectEqual first second,
        ),
        ("a cold drive prints the same", expectEqual cold second),
      ]
    _ => fail "could not read the prelude pair"

-- ── an interface declared outside the importers ─────────────────────────────

-- [ix_m] uses the function [h] of [ix_d]; [ix_x] declares an interface with a
-- method of that name.  The entry's import order decides which the checker sees.
ifaceGraph : String -> Int -> Bool -> (List String, Int)
ifaceGraph chainKey seed mFirst =
  let dSrc = joinNl ["export h : a -> a", "h x = x"]
  let mSrc =
    joinNl ["import ix_d.{h}", "export useM : Int -> Int", "useM x = h x"]
  let xSrc = joinNl ["export interface Hh a where", "  h : a -> a"]
  let entryText =
    joinNl ["import ix_m.{useM}", "import ix_x.{Hh}", "entry = useM 1"]
  let mods =
    if mFirst then
      [("ix_d", dSrc), ("ix_m", mSrc), ("ix_x", xSrc), ("ix_entry", entryText)]
    else
      [("ix_d", dSrc), ("ix_x", xSrc), ("ix_m", mSrc), ("ix_entry", entryText)]
  let ((report, outputs), _) = bareDrive seed chainKey mods
  (render report, outputs.doServedModules)

test "an interface declared in a module the user does not import is part of the graph key" =
  let _ = ifaceGraph "ix-k" 4661 True
  let (warm, warmServed) = ifaceGraph "ix-k" 4661 False
  let (cold, _) = ifaceGraph "ix-cold" 4662 False
  expectEach [
    ("the x-first drive serves nothing", expectEqual 0 warmServed),
    ("it prints what a cold x-first drive prints", expectEqual cold warm),
  ]

export
ownerSelectors : List ManifestSelector
ownerSelectors = [
  ExactEntry
    EntryKey { moduleId = "basis_dep", binding = "make" }
    HostInvocation,
  ExactEntry
    EntryKey { moduleId = "basis_entry", binding = "main" }
    HostInvocation,
]

export
ownerDrive : List ManifestSelector -> (TcReport, DriveOutputs)
ownerDrive selectors =
  checkModulesChainReportFor
    { defaultDriveInputs | diManifestRequests = selectors }
    False
    (Some (4681, 4682))
    "basis-owner"
    [Some "basis-dep-source", None]
    []
    []
    ownerModules

ownerModules : List (String, List Decl)
ownerModules = [
  (
    "basis_dep",
    desugar
      (parseLocated
        """effect Clock
export data Box = Box (Unit -> <Clock> Unit)
export data Pair a = Pair a
tick : Unit -> <Clock> Unit
tick _ = ()
export make = Box tick
"""),
  ),
  (
    "basis_entry",
    desugar (parseLocated """import basis_dep.{Box, make}
main = make
"""),
  ),
]

export
ownerAtoms : DriveOutputs -> List (String, List String)
ownerAtoms outputs =
  map
    (m => (
      (m : CapabilityManifest).request.entry.moduleId,
      map (a => a.label) m.atoms,
    ))
    outputs.doManifests

test "recording without requests retains the exact owner for a later served request" =
  let (_, cold) = ownerDrive []
  let (warmReport, warm) = ownerDrive ownerSelectors
  let (_, again) = ownerDrive (drop 1 ownerSelectors)
  let (_, trees, treeOut) =
    elaborateModulesWithReport
      { defaultDriveInputs | diManifestRequests = ownerSelectors }
      False
      None
      []
      []
      ownerModules
  expectEach [
    ("cold serves zero", expectEqual 0 cold.doServedModules),
    ("cold publishes nothing", expectEqual [] (ownerAtoms cold)),
    ("warm serves owner", expectEqual 1 warm.doServedModules),
    ("warm checks", expectTrue (isSome warmReport.trChecked)),
    (
      "warm owner and importer",
      expectEqual
        [("basis_dep", ["Clock"]), ("basis_entry", [])]
        (ownerAtoms warm),
    ),
    ("changed request still serves", expectEqual 1 again.doServedModules),
    (
      "changed request only",
      expectEqual [("basis_entry", [])] (ownerAtoms again),
    ),
    ("tree checks", expectTrue (isSome trees.trChecked)),
    ("tree serves no diagnostic tree", expectEqual 0 treeOut.doServedModules),
    (
      "tree owner and importer",
      expectEqual (ownerAtoms warm) (ownerAtoms treeOut),
    ),
  ]

test "reading an owning basis copies constructor cells and teardown drops retained data" =
  let start = allocBytes ()
  let _ = ownerDrive []
  let coldBytes = allocBytes () - start
  match interfaceOf "basis_dep"
    None => fail "owner interface missing"
    Some mi =>
      let encoded = renderSExp (invocationViewSExp mi.miInvocationView)
      let (InvocationView ctors _ _) = readInvocationView mi.miInvocationView
      let changed =
        fold
          (n sc => match sc
            Forall _ _ _ _ _ (TFun (TVar cell) _ _) =>
              cell := Link (TCon "Bool" OriginBuiltin)
              n + 1
            _ => n)
          0
          ctors
      let (PublishedInvocationView frozen _ _) = mi.miInvocationView
      let warmStart = allocBytes ()
      let (_, warm) = ownerDrive ownerSelectors
      let warmBytes = allocBytes () - warmStart
      let afterRead = renderSExp (invocationViewSExp mi.miInvocationView)
      let _ = bareDrive 4683 "basis-unrelated" [("unrelated", "main = ()")]
      let _ = retainModuleInterfaces []
      let remaining = map (i => i.miKey.mkModule) (currentModuleInterfaces ())
      println
        "owner basis receipt: schemes=\{length frozen} bytes=\{S.length encoded} coldAlloc=\{coldBytes} warmAlloc=\{warmBytes} retainedAfterTeardown=\{length remaining}"
      expectEach [
        ("copied constructor exercised", expectGreaterThan 0 changed),
        ("basis detached", expectEqual encoded afterRead),
        (
          "replay after mutation",
          expectEqual
            [("basis_dep", ["Clock"]), ("basis_entry", [])]
            (ownerAtoms warm),
        ),
        ("teardown", expectEqual [] remaining),
      ]

-- ── a tree drive serves the modules' trees ──────────────────────────────────

-- One keyed tree drive over [mods], (module id, source) in dependency order, under
-- [chainKey] and the prelude key (seed, seed + 1): the passed trees of each module
-- before the entry, then the evidence entries of every fixture module, each rendered
-- with every evidence ordinal of a fixture module and every grant parameter number
-- replaced by its rank; the run output; and the number of modules the drive served.
-- The entry is checked by every drive, and its binder ordinals are the process's
-- next ones, so its tree is left out.
treeDrive : Int ->
  String ->
  List Decl ->
  List Decl ->
  List (String, String) ->
  (List String, String, Int)
treeDrive seed chainKey runtime core mods =
  let (_, report, outputs) =
    elaborateModulesChainReport
      defaultDriveInputs
      False
      (seed, seed + 1)
      chainKey
      (treeSteps mods)
      runtime
      core
      (map (m => (fst m, desugar (parseLocated (snd m)))) mods)
  let mids = map fst mods
  match report.trChecked
    Some c => match c.cpTrees
      Some (coreTrees, modTrees) =>
        let served = take (length modTrees - 1) modTrees
        let nodes =
          map (m => SList [SAtom (fst m), declsSExp (snd m)]) served
            ++ map (e => evEntriesSExp [e]) (ownEntries mids c.cpEvidence)
        let ordinals = rankOf (flatMap (ordinalsIn mids) nodes)
        let grants = rankOf (flatMap grantNumbersIn nodes)
        let rendered =
          map (n => renderSExp (ranked mids ordinals grants n)) nodes
        (
          take (length served) rendered ++ sort (drop (length served) rendered),
          evalModulesOutputFacts (factsOfChecked c) coreTrees modTrees,
          outputs.doServedModules,
        )
      None => (["no trees"], "", outputs.doServedModules)
    None => (["no checked program"], "", outputs.doServedModules)

-- Every module's source as its step key but the entry's.
treeSteps : List (String, String) -> List (Option String)
treeSteps [] = []
treeSteps [_] = [None]
treeSteps (m :: rest) = Some (snd m) :: treeSteps rest

ownEntries : List String -> List EvEntry -> List EvEntry
ownEntries mids entries =
  filter
    (e => match e
      EvEntry (EvId m _) _ => contains m mids)
    entries

-- The evidence ordinals of [mids]' ids in [node]: a two-atom list whose head is a
-- module id of the fixture.
ordinalsIn : List String -> SExp -> List Int
ordinalsIn mids (SList [SAtom m, SAtom n])
  | contains m mids = intsOf (stringToInt n)
ordinalsIn mids (SList items) = flatMap (ordinalsIn mids) items
ordinalsIn _ _ = []

grantNumbersIn : SExp -> List Int
grantNumbersIn (SAtom a) = match S.stripPrefix "$grant_arg_" a
  Some n => intsOf (stringToInt n)
  None => []
grantNumbersIn (SList items) = flatMap grantNumbersIn items

intsOf : Option Int -> List Int
intsOf (Some n) = [n]
intsOf None = []

-- Each number's rank among [ns], by its decimal text.
rankOf : List Int -> OrdMap String
rankOf ns =
  omFromPairs
    (map
      (p => (intToString (snd p), "#\{intToString (fst p)}"))
      (indexed (sort (dedupInts ns))))
    omEmpty

dedupInts : List Int -> List Int
dedupInts ns =
  map (n => optionOr 0 (stringToInt n)) (dedup (map intToString ns))

ranked : List String -> OrdMap String -> OrdMap String -> SExp -> SExp
ranked mids ordinals grants (SList [SAtom m, SAtom n])
  | contains m mids = SList [SAtom m, SAtom (optionOr n (omLookup n ordinals))]
ranked mids ordinals grants (SList items) =
  SList (map (ranked mids ordinals grants) items)
ranked _ _ grants (SAtom a) = match S.stripPrefix "$grant_arg_" a
  Some n => SAtom "$grant_arg_\{optionOr n (omLookup n grants)}"
  None => SAtom a

preludePair : Unit -> <FileRead> Option (List Decl, List Decl)
preludePair _ = match (
  readFile "stdlib/runtime.mdk",
  readFile "stdlib/core.mdk",
)
  (Ok runtime, Ok core) => Some (desugar (parse runtime), desugar (parse core))
  _ => None

-- A library with return-position methods, a module whose impl's only use of its
-- `requires` dictionary is an operator, an importer declaring a constrained function
-- of the library's name, and the entry.
servedTreeMods : List (String, String)
servedTreeMods = [
  (
    "st_lib",
    joinNl [
      "export",
      "pad : Monoid a => a -> a",
      "pad x = append x empty",
      "export",
      "wrap : Applicative f => a -> f a",
      "wrap x = pure x",
      "export",
      "twice x = append x x",
    ],
  ),
  (
    "st_box",
    joinNl [
      "public export data Box a = Box a",
      "impl Eq (Box a) requires Eq a where",
      "  eq (Box x) (Box y) = x == y",
      "export",
      "same : Eq a => Box a -> Box a -> String",
      "same a b = if a == b then \"same\" else \"differ\"",
    ],
  ),
  (
    "st_user",
    joinNl [
      "import st_lib.{wrap}",
      "import st_box.{Box(..), same}",
      "export",
      "pad : Display a => a -> String",
      "pad x = \"[\" ++ display x ++ \"]\"",
      "export",
      "both : Int -> (String, Option Int, String)",
      "both n = (pad n, wrap n, same (Box n) (Box n))",
    ],
  ),
  (
    "st_entry",
    joinNl [
      "import st_lib as L",
      "import st_user.{pad, both}",
      "main =",
      "  println (L.pad \"a\")",
      "  println (pad 3)",
      "  println (both 4)",
      "  println (L.twice \"ab\")",
    ],
  ),
]

test "a tree drive serves every module before the entry; the passed trees, evidence and output are the cold drive's" =
  match preludePair ()
    Some (runtime, core) =>
      let (cold, coldOut, coldServed) =
        treeDrive 4691 "st-k" runtime core servedTreeMods
      let (warm, warmOut, warmServed) =
        treeDrive 4691 "st-k" runtime core servedTreeMods
      expectEach [
        ("the first drive serves nothing", expectEqual 0 coldServed),
        ("the second serves the three libraries", expectEqual 3 warmServed),
        (
          "the passed trees and the evidence are the cold drive's",
          expectEqual cold warm,
        ),
        ("the output is the cold drive's", expectEqual coldOut warmOut),
        (
          "the program runs",
          expectEqual "a\n[3]\n([4], Some 4, same)\nabab\n" coldOut,
        ),
      ]
    None => fail "could not read the prelude pair"

-- An interface whose method takes an authority grant, used in every shape in the
-- module that declares it, and a reader that opens an existential authority.
grantTreeMods : List (String, String)
grantTreeMods = [
  (
    "gt_src",
    joinNl [
      "export interface Source s where",
      "  load : s -> (path : String) -> <FileRead path> Result String String",
      "  loadTwice : s -> (path : String) -> <FileRead path> Result String String",
      "  loadTwice src path = match load src path",
      "    Ok a => map (b => a ++ b) (load src path)",
      "    Err e => Err e",
      "public export data Disk = Disk",
      "public export data Echo = Echo",
      "impl Source Disk where",
      "  load _ path = readFile path",
      "impl Source Echo where",
      "  load _ = p => Ok (\"echo \" ++ p)",
      "export",
      "viaMethod : String -> <FileRead \"cfg/*\"> Result String String",
      "viaMethod name = load Disk (\"cfg/\" ++ name)",
      "export",
      "viaDefault : String -> <FileRead \"cfg/*\"> Result String String",
      "viaDefault name = loadTwice Disk (\"cfg/\" ++ name)",
      "export",
      "viaPartial : String -> <FileRead \"cfg/*\"> Result String String",
      "viaPartial name =",
      "  let f = load Disk",
      "  f (\"cfg/\" ++ name)",
    ],
  ),
  (
    "gt_any",
    joinNl [
      "public export data Handle (p : Authority FileRead) = Handle (String @p)",
      "public export data AnyHandle = AnyHandle (p : Authority FileRead) (Handle p)",
      "readIt : Handle p -> <FileRead p> Result String String",
      "readIt (Handle s) = readFile s",
      "export",
      "readAny : AnyHandle -> <FileRead> Result String String",
      "readAny a = match a",
      "  AnyHandle h => readIt h",
    ],
  ),
  (
    "gt_entry",
    joinNl [
      "import gt_src.{Source, load, Echo(..), viaMethod, viaDefault, viaPartial}",
      "import gt_any.{AnyHandle(..), Handle(..), readAny}",
      "main =",
      "  let readers = (viaMethod, viaDefault, viaPartial, readAny)",
      "  println (load Echo \"x\")",
    ],
  ),
]

test "a served module's grant-taking method occurrences publish the cold drive's arities and grants" =
  match preludePair ()
    Some (runtime, core) =>
      let (cold, coldOut, _) = treeDrive 4693 "gt-k" runtime core grantTreeMods
      let (warm, warmOut, warmServed) =
        treeDrive 4693 "gt-k" runtime core grantTreeMods
      expectEach [
        ("the second drive serves both libraries", expectEqual 2 warmServed),
        (
          "the passed trees and the evidence are the cold drive's",
          expectEqual cold warm,
        ),
        ("the output is the cold drive's", expectEqual coldOut warmOut),
        ("the program runs", expectEqual "Ok (echo x)\n" coldOut),
        (
          "the served reader of an opened existential passes the whole domain",
          expectTrue (any (S.contains "(1 readIt) (12 ())") warm),
        ),
      ]
    None => fail "could not read the prelude pair"
