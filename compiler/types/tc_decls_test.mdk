-- Tests of `types.tc_decls`'s own API: `buildDeclEnvs` over hand-built module rows (what
-- data, record, newtype, alias, interface and impl declarations register, the ordinal and
-- field-owner tables, the kind projection a later module reads), the data-env fold, the
-- registration helpers that put constructors, records and aliases into a module record,
-- alias head expansion, signature-to-scheme conversion with its kind and alias diagnostics,
-- cyclic-alias rejection, the graph pre-pass that writes impl heads in alias normal form
-- (`stampGraphDecls`) and the small predicates over declarations and constraints.  The
-- declarations are parsed from source so each row states the declaration it relies on.  The
-- variance tables are `tc_decls_variance`'s and are not read here.  Each test mints its own
-- graph and module records.

import list.{
  indexed,
  nub,
  sort,
}
import test.{
  expectAll,
  expectAtLeast,
  expectEqual,
  expectFalse,
  expectTrue,
}
import frontend.parser.{parse}
import frontend.resolve.{stampGraphTyOrigins}
import frontend.ast.{Decl(..), Ty(..), tabKeyName}
import support.ordmap.{omEmpty, omKeys, omLookup}
import types.repr.{ppMono, ppScheme}
import types.tc_types.{
  CeRow(..),
  DataEnv(..),
  DeclEnvModule(..),
  DeclEnvs(..),
  RecordInfo(..),
  ModuleCtx(..),
}
import types.tc_env.{
  declEnvKindEntries,
  declEnvModule,
  emptyDeclEnvAcc,
  envFor,
  lookupCtor,
  lookupRecordByName,
}
import types.tc_state.{probeGraphCtx}
import types.tc_test_support.{
  codesOf, declsOf, firstSig, fresh, sizeable, withFirstSig
}
import types.tc_decls_types.{
  sigConstraintsOf,
}
import types.tc_mono.{tconBuiltin}
import types.tc_decls.{
  addFieldOwners,
  buildDeclEnvs,
  constraintIface,
  constraintIsMethodLevel,
  constraintNameMonos,
  constraintVarNames,
  dataEnvFromDeclsGo,
  graphAliasRow,
  isAliasDecl,
  pubTopFnNames,
  registerAllData,
  rejectCyclicAliases,
  sigToScheme,
  stampGraphDecls,
  tyConNamesInTy,
  withDeclParamKinds,
}
import types.tc_decls.{
  dataEnvFinish,
  dataEnvFromRowsGo,
  declEnvDeclFieldOwners,
  declEnvRowKindEntries,
  declEnvSeedChain,
}
import frontend.ast.{
  Attr(..),
  ConPayload(..),
  DataVis(..),
  Expr(..),
  Lit(..),
  TyConOrigin(..),
}
import types.tc_types.{DeclEnvSeedAcc(..), GraphCtx, Kind(..)}
import frontend.ast.{
  Field(..), Ident(..), TabKey(..), Variant(..), noBinderId, noDeclLoc,
  tyConBuiltin
}
import support.ordmap.{OrdMap, omFromNames, omHasKey}
import types.tc_env.{aliasUniverseAt}
import types.tc_state.{emptyDataEnv}
import support.util.{listLen}

-- ── fixtures ──────────────────────────────────────────────────────────────

-- The declarations of the module at ordinal [ord], named [mid], parsed from [src].
rowOf : Int -> String -> String -> DeclEnvModule
rowOf ord mid src = declEnvModule (probeGraphCtx ()) ord mid (parse src)

-- The envelope of a prelude-free graph of the modules [mods] (id, source), in dependency
-- order, after the declarations are stamped with their module's identity as a loaded graph's
-- are.  Ordinals count from 1; the core row is empty.
envsOf : List (String, String) -> DeclEnvs
envsOf mods =
  let (_, stamped) =
    stampGraphTyOrigins [] [] (map (m => (fst m, parse (snd m))) mods)
  let g = probeGraphCtx ()
  let rows =
    map
      (e => declEnvModule g (fst e + 1) (fst (snd e)) (snd (snd e)))
      (indexed stamped)
  buildDeclEnvs g emptyDeclEnvAcc (rowOf 0 "" "") rows

typeNames : DeclEnvs -> List String
typeNames envs = map (t => tabKeyName (fst t)) envs.deData.deTypes

aliasNames : DeclEnvs -> List String
aliasNames envs = map (a => tabKeyName (fst a)) envs.deData.deAliases

ifaceNames : DeclEnvs -> List String
ifaceNames envs = map ifaceNameOf envs.deIfaces.ceRows

ifaceNameOf : CeRow -> String
ifaceNameOf (CeRow _ _ ref _ _ _ _ _ _) = ref.irName

recordFields : RecordInfo -> List String
recordFields (RecordInfo _ _ _ fields _) = map fst fields

-- The scheme of the first signature of [src] after [src]'s own aliases and kinds are
-- registered, rendered, with the diagnostics the conversion pushed; `None` when [src]
-- declares no signature.
schemeOf : String -> Option (String, List String)
schemeOf src =
  let ds = parse src
  let m = fresh ()
  m.mcCells.aliasTableRef := flatMap graphAliasRow ds
  withDeclParamKinds m ds (_ => match firstSig src
    Some t =>
      let rendered = ppScheme (sigToScheme m t)
      Some (rendered, codesOf m)
    None => None)

-- Public data, abstract data, private data and a public newtype.  The kind-public
-- projection keeps the first, second and fourth, so dropping its abstract-data arm or its
-- newtype arm lowers the count; the own-row projection keeps all four.
kindRowSrc : String
kindRowSrc =
  """
public export data Shown a = Shown a
export data Hidden a = Hidden a
data Private a = Private a
export newtype Wrap = Wrap Int
"""

-- ── the kind projection of a row ──────────────────────────────────────────

test "a row's kind projection drops private data, and the own-row projection keeps it" =
  let g = probeGraphCtx ()
  let ds = parse kindRowSrc
  expectAll [
    expectEqual 3 (length (declEnvModule g 0 "m" ds).demKindEntries),
    expectEqual 4 (length (declEnvKindEntries g ds)),
  ]

-- ── buildDeclEnvs: what each declaration registers ────────────────────────

test "data, newtype and alias declarations register their names" =
  let envs = envsOf [
    (
      "a",
      """
        export data Box a = Box a
        export newtype Id = Id Int
        export type Name = String
        """,
    ),
  ]
  expectAll [
    expectEqual ["Box", "Id"] (sort (typeNames envs)),
    expectEqual ["Name"] (aliasNames envs),
  ]

test "a record declaration registers its constructor and its field names" =
  let envs = envsOf [("a", "export data Pt = Pt { x : Int, y : Int }\n")]
  expectAll [
    expectEqual ["Pt"] (omKeys envs.deData.deCtorIdents),
    expectEqual ["Pt"] (omKeys envs.deData.deRecordIdents),
    expectEqual ["x", "y"] (sort (omKeys envs.deData.deFieldOwnerIdents)),
  ]

test "an interface registers its name, and each method its declaration" =
  let envs = envsOf [
    ("a", """
      export interface Sized a where
        size : a -> Int
        empty : a
      """),
  ]
  expectAll [
    expectEqual ["Sized"] (ifaceNames envs),
    expectEqual ["empty", "size"] (sort (omKeys envs.deMethods.meByName)),
  ]

test "an impl declaration adds a row to the impl env and no interface" =
  let envs = envsOf [
    ("a", """
      export interface Sized a where
        size : a -> Int
      """),
    (
      "b",
      """
        import a.{Sized}
        export data Box = Box
        impl Sized Box where
          size _ = 1
        """,
    ),
  ]
  expectAll [
    expectAtLeast 1 (length envs.deImpls.ieRows),
    expectEqual ["Sized"] (ifaceNames envs),
  ]

test "the envelope lists the core row first and indexes each module id by its ordinal" =
  let envs = envsOf [("a", "export data A = A\n"), ("b", "export data B = B\n")]
  expectAll [
    expectEqual [0, 1, 2] (map (m => m.demOrd) envs.deModules),
    expectEqual (Some 1) (omLookup "a" envs.deOrdIndex),
    expectEqual (Some 2) (omLookup "b" envs.deOrdIndex),
  ]

test "the envelope holds the declarations of every row" =
  let envs = envsOf [("a", "export data A = A\n"), ("b", "export data B = B\n")]
  expectEqual ["A", "B"] (sort (typeNames envs))

test "a record owner key lists every module that declares a record of that name" =
  let envs = envsOf [
    ("a", "export data P = P { x : Int }\n"),
    ("b", """
      export data P = P { x : Int }
      export data Q = Q { y : Int }
      """),
  ]
  expectAll [
    expectEqual (Some ["a", "b"]) (map sort (omLookup "P" envs.deOwnerModules)),
    expectEqual (Some ["b"]) (omLookup "Q" envs.deOwnerModules),
    expectEqual None (omLookup "x" envs.deOwnerModules),
  ]

test "a later module's kind seed holds the earlier modules' kinds, and not its own" =
  let envs = envsOf [
    ("a", "export data A (e : Effect) = A (Unit -> <e> Unit)\n"),
    ("b", "export data B = B\n"),
  ]
  let seedNames =
    m =>
      map
        (e => tabKeyName (fst e))
        (optionOr [] (omLookup m envs.deKindsBefore))
  expectAll [
    expectEqual [] (seedNames "a"),
    expectEqual ["A"] (seedNames "b"),
  ]

-- ── the data-env fold ─────────────────────────────────────────────────────

test "the data fold registers a private type too: visibility is read later" =
  let env =
    dataEnvFromDeclsGo
      1
      (parse """
        data Hid = Hid
        export data Pub = Pub
        """)
      (emptyData ())
  expectEqual ["Hid", "Pub"] (sort (map (t => tabKeyName (fst t)) env.deTypes))

emptyData : Unit -> DataEnv
emptyData _ = (envsOf []).deData

test "the data fold records an alias with its parameters and right-hand side" =
  let env =
    dataEnvFromDeclsGo
      1
      (parse "export type Pair a b = (a, b)\n")
      (emptyData ())
  expectEqual
    [("Pair", ["a", "b"])]
    (map (a => (tabKeyName (fst a), (snd a).adParams)) env.deAliases)

-- ── registration into a module record ─────────────────────────────────────

test "registerAllData gives each constructor a scheme the environment can look up" =
  let m = fresh ()
  let env =
    registerAllData
      (envFor m)
      (parse "data Shape = Circle Int | Square Int Int\n")
  expectAll [
    expectEqual (Some "Int -> Shape") (map ppScheme (lookupCtor env "Circle")),
    expectEqual
      (Some "Int -> Int -> Shape")
      (map ppScheme (lookupCtor env "Square")),
    expectEqual None (map ppScheme (lookupCtor env "Triangle")),
  ]

test "registerAllData records a record's fields and registers it by name" =
  let m = fresh ()
  let _ =
    registerAllData (envFor m) (parse "data Pt = Pt { x : Int, y : Int }\n")
  expectEqual (Some ["x", "y"]) (map recordFields (lookupRecordByName m "Pt"))

test "registerAllData of a type alias adds it to the alias table" =
  let m = fresh ()
  let _ = registerAllData (envFor m) (parse "type Name = String\n")
  expectEqual
    ["Name"]
    (map (a => tabKeyName (fst a)) m.mcCells.aliasTableRef.value)

test "addFieldOwners adds the key under each field and keeps earlier owners" =
  let m = addFieldOwners "Q" ["x", "z"] (addFieldOwners "P" ["x"] omEmpty)
  expectAll [
    expectEqual (Some ["Q", "P"]) (omLookup "x" m),
    expectEqual (Some ["Q"]) (omLookup "z" m),
  ]

-- ── aliases ───────────────────────────────────────────────────────────────

test "graphAliasRow reads an alias declaration, through an attribute, and nothing else" = expectAll
  [
    expectEqual
      ["A"]
      (map
        (r => tabKeyName (fst r))
        (flatMap graphAliasRow (parse "type A = Int\n"))),
    expectEqual
      ["C"]
      (map
        (r => tabKeyName (fst r))
        (flatMap
          graphAliasRow
          (parse """
            @deprecated "use A"
            type C = Int
            """))),
    expectEqual
      []
      (map
        (r => tabKeyName (fst r))
        (flatMap graphAliasRow (parse "data B = B\n"))),
  ]

test "isAliasDecl is true of an alias and false of data" = expectAll [
  expectTrue (all isAliasDecl (parse "type A = Int\n")),
  expectFalse (any isAliasDecl (parse "data B = B\n")),
]

test "rejectCyclicAliases reports a cycle of aliases and accepts a chain" =
  let cyc = parse """
    type A = B
    type B = A
    """
  let chain = parse """
    type A = B
    type B = Int
    """
  let m1 = fresh ()
  m1.mcCells.aliasTableRef := flatMap graphAliasRow cyc
  rejectCyclicAliases m1 cyc
  let m2 = fresh ()
  m2.mcCells.aliasTableRef := flatMap graphAliasRow chain
  rejectCyclicAliases m2 chain
  expectAll [
    expectEqual ["T-RECURSIVE-ALIAS"] (nub (codesOf m1)),
    expectEqual [] (codesOf m2),
  ]

-- ── signatures to schemes ─────────────────────────────────────────────────

test "a signature converts to the scheme it writes, with its variables quantified" = expectAll
  [
    expectEqual (Some ("Int -> Bool", [])) (schemeOf "f : Int -> Bool\n"),
    expectEqual (Some ("a -> a", [])) (schemeOf "f : a -> a\n"),
  ]

test "a signature over an alias converts through the alias" =
  expectEqual (Some ("Int -> Int", [])) (schemeOf """
    type N = Int
    f : N -> N
    """)

test "a signature's alias arity error is T-ALIAS-ARITY" =
  expectEqual
    (Some ["T-ALIAS-ARITY"])
    (map snd (schemeOf """
      type P a b = (a, b)
      f : P Int -> Int
      """))

test "a signature putting a type in a row-kinded slot is T-EFFECT-KIND-MISMATCH" =
  expectEqual
    (Some ["T-EFFECT-KIND-MISMATCH"])
    (map
      snd
      (schemeOf
        """
          data Box (e : Effect) a = Box (Unit -> <e> a)
          f : Box Int Int -> Int
          """))

test "a declared Effect parameter admits a row at its slot with no diagnostic" =
  expectEqual
    (Some [])
    (map
      snd
      (schemeOf
        """
          data Box (e : Effect) a = Box (Unit -> <e> a)
          f : Box <Stdout> Int -> Int
          """))

-- ── declaration and constraint predicates ─────────────────────────────────

test "pubTopFnNames lists the exported functions that have a definition" =
  expectEqual
    ["shown"]
    (nub
      (pubTopFnNames
        (parse
          """
            export shown : Int -> Int
            export shown x = x
            export lonely : Int
            hidden x = x
            """)))

test "tyConNamesInTy collects every constructor name of a written type, in order" = withFirstSig
  "f : Int -> List Bool\n"
  (t => expectEqual ["Int", "List", "Bool"] (tyConNamesInTy t))

test "a constraint exposes its interface and its variable names" = withFirstSig
  "f : (Eq a, Ord b) => a -> b -> Bool\n"
  (t => match sigConstraintsOf t
    cs => expectAll [
      expectEqual ["Eq", "Ord"] (map constraintIface cs),
      expectEqual [["a"], ["b"]] (map constraintVarNames cs),
    ])

test "a constraint is method-level when it mentions any variable, and not when it is ground" = withFirstSig
  "f : (Eq a, Ord b, Show Int) => a -> b -> Bool\n"
  (t => match sigConstraintsOf t
    cs =>
      expectEqual [True, True, False] (map (constraintIsMethodLevel ["a"]) cs))

test "constraintNameMonos keeps the monos of the names that have one, in the names' order" =
  expectEqual
    ["Int", "Bool"]
    (map
      ppMono
      (constraintNameMonos
        ["a", "z", "b"]
        [("b", tconBuiltin "Bool"), ("a", tconBuiltin "Int")]))

-- ── the graph pre-pass ────────────────────────────────────────────────────

-- The type constructor each impl head among the declarations names; a head that is not a bare
-- constructor reads as `None`.
implHeads : List Decl -> List (Option String)
implHeads [] = []
implHeads ((DImpl { tys = ts, ... }) :: rest) =
  map headName ts ++ implHeads rest
implHeads (_ :: rest) = implHeads rest

headName : Ty -> Option String
headName (TyCon { tyConName = c, ... }) = Some c
headName _ = None

test "an impl head that names an alias is rewritten to the type the alias stands for" =
  let (_, mods) = stampGraphDecls [] [] [
    (
      "m",
      declsOf
        "m"
        """
type A = Int
interface Sz a where
  sz : a -> Int
impl Sz A where
  sz x = x
""",
    ),
  ]
  expectEqual [Some "Int"] (implHeads (flatMap snd mods))

test "a graph with no alias keeps the heads it came with" =
  let (core, mods) = stampGraphDecls [] [] [("m", declsOf "m" sizeable)]
  expectEqual ([], [Some "Int"]) (implHeads core, implHeads (flatMap snd mods))

-- ── tests ─────────────────────────────────────────────────────────────
-- Both conjuncts, on the kind projection: own row ⇒ everything; earlier row ⇒ the
-- kind-public projection; later row ⇒ nothing.
test "the kind projection: own row sees everything, an earlier row its public part, a later row nothing" = expectAll
  [
    expectEqual
      4
      (listLen
        (declEnvRowKindEntries
          (probeGraphCtx ())
          0
          (deKindRow0 (probeGraphCtx ())))),
    expectEqual
      3
      (listLen
        (declEnvRowKindEntries
          (probeGraphCtx ())
          1
          (deKindRow0 (probeGraphCtx ())))),
    expectEqual
      0
      (listLen
        (declEnvRowKindEntries
          (probeGraphCtx ())
          0
          (deKindRow1 (probeGraphCtx ())))),
  ]

-- The field-owner population: only a `ConNamed` variant votes, and it votes under
-- its CONSTRUCTOR name.
test "only a ConNamed variant votes as a field owner, under its constructor name" = expectAll
  [
    expectEqual
      ["Pt"]
      (optionOr
        []
        (omLookup "x" (declEnvDeclFieldOwners [deFieldOwnerFixtureA] omEmpty))),
    expectEqual
      []
      (optionOr
        []
        (omLookup "x" (declEnvDeclFieldOwners [deKindNewtypeFixture] omEmpty))),
  ]

-- ── THE OWN-row exclusion, asserted rather than incidental ────
-- `declEnvSeedChain` stamps row [m]'s id with the accumulators as they stand
-- BEFORE [m] is folded in, so [m]'s seed is "every row strictly earlier than
-- [m]" and never [m] itself.  That is a STRUCTURAL property of the fold order —
-- there is no ordinal test to find and none to keep — and until now it was
-- asserted only in prose two hundred lines up.  Prose is not fail-capable, and
-- the exclusion is load-bearing in a way an ordinal statement is not: a module
-- registers its OWN decls a second time, immediately after this seed, through
-- `registerAllData … prog0`.  Seeding the own row here too would put the same
-- `cname` key in `fieldOwnersRef` twice (`addFieldOwners` does not dedupe) —
-- `fieldOwnerNames`, its only reader, dedupes on read, so the
-- doubling would not move an answer; the assertions below pin the seed's shape.
--
-- So these four lines are A TRIPWIRE ON A specific wrong edit, and it is one
-- an implementer can arrive here already instructed to make:
-- `test/registry_keying_ratchet.sh`'s `declEnvsRef` row tells A-3.6 to *"hand
-- every row the FINAL accumulator"*.  Doing that destroys the exclusion the same
-- row calls structural.  Every assertion below moves if it is done — that is the
-- fail-capability argument, and it is by construction, not by hope:
--   * `deSeedChainProbe` is a TWO-row chain, so the final accumulator differs
--     from every row's prefix.  Row "m" is FIRST, so its correct seed is EMPTY
--     while the final accumulator holds both rows: 0 → 6 kinds, `[]` → two
--     owners.  Row "n" is LAST, so its correct seed is row "m" alone while the
--     final accumulator adds "n"'s own identical `Pt`: 3 → 6 kinds, and
--     `["Pt"]` → `["Pt", "Pt"]` — the doubled key itself, named.
--   * A ONE-row chain could not discriminate any of that (prefix and final
--     accumulator coincide at the only row), which is why the probe carries two
--     rows with DISTINCT ids rather than reusing `deKindRow0`/`deKindRow1`.
test "a row's seed holds every earlier row and never its own" = expectAll [
  expectEqual
    0
    (listLen
      (optionOr [] (omLookup "m" (deSeedChainKinds (probeGraphCtx ()))))),
  expectEqual
    []
    (optionOr
      []
      (omLookup
        "x"
        (optionOr
          omEmpty
          (omLookup "m" (deSeedChainOwners (probeGraphCtx ())))))),
  expectEqual
    3
    (listLen
      (optionOr [] (omLookup "n" (deSeedChainKinds (probeGraphCtx ()))))),
  expectEqual
    ["Pt"]
    (optionOr
      []
      (omLookup
        "x"
        (optionOr
          omEmpty
          (omLookup "n" (deSeedChainOwners (probeGraphCtx ())))))),
]

-- #2158: the THIRD accumulator, on the SAME probe, so the own-row exclusion is
-- asserted on it too — row "m" is first, so its name index is EMPTY even though
-- "m" itself declares `Pt`/`Opq`/`Wrap`; row "n" sees exactly "m"'s three
-- kind-public names and NOT its own identical copies.  (`Priv` is absent from
-- both for the separate reason `declEnvRowKindEntries`' cross-module arm drops
-- a private decl — see the kind-count tests above.)
test "the name index excludes the own row at each seed" = expectAll [
  expectEqual
    []
    (omKeys
      (optionOr omEmpty (omLookup "m" (deSeedChainNames (probeGraphCtx ()))))),
  expectEqual
    ["Opq", "Pt", "Wrap"]
    (omKeys
      (optionOr omEmpty (omLookup "n" (deSeedChainNames (probeGraphCtx ()))))),
]

-- The parity assertion, and it is the one that pins the fix.  #2158 first
-- shipped the name index as a per-module REBUILD in `declEnvSeedDataUniverse`
-- (`omFromNames (map (p => tabKeyName (fst p)) kindsRef.value) omEmpty`), which
-- was quadratic in the module count.  The accumulator replaced it, so what must
-- stay true is that the accumulated set and the rebuilt set AGREE on every row.
-- This states that as an equation over the probe rather than as prose, so a
-- future edit to either half that breaks the agreement is loud here.
test "the accumulated name index agrees with the rebuilt one on every row" = expectAll
  [
    expectTrue (deSeedNameParity "m"),
    expectTrue (deSeedNameParity "n"),
  ]

-- ── tests ─────────────────────────────────────────────────────────────
-- (a) A name declared in an EARLIER module is visible at a later module's seed.
--     `modB` sees `modA`'s two names and no others.
test "a name declared in an earlier module is visible at a later module's seed" =
  expectEqual
    ["Alpha", "Shared"]
    (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modB")

-- (b) A name declared in the SAME module is NOT — own registrations go on TOP of
--     the universe later, via `recordParamKinds` under `registerAllData … prog0`.
--     `modB` declares `Beta`; `Beta` is absent from `modB`'s own seed and present
--     one row later.
test "a name declared in the same module is not visible at its own seed" = expectAll
  [
    expectFalse
      (omHasKey
        "Beta"
        (optionOr
          omEmpty
          (omLookup "modB" (deNameIdxChain (probeGraphCtx ()))))),
    expectTrue
      (omHasKey
        "Beta"
        (optionOr
          omEmpty
          (omLookup "modC" (deNameIdxChain (probeGraphCtx ()))))),
  ]

--     …and the first row's seed is empty, own-row exclusion at the boundary.
test "the first row's seed is empty" =
  expectEqual [] (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modA")

-- (c) Unrelated code — `modC`/`modD` declare no data type at all.  They
--     contribute NOTHING (the two rows' indexes are equal, so the row between
--     them added no name), and their presence perturbs NOTHING (`modA`/`modB`
--     read identically in a chain that does not contain them at all).
--     `Shared` appears ONCE across both declaring modules: bare-name by design.
test "unrelated modules leave every other row's name index untouched" = expectAll
  [
    expectEqual
      ["Alpha", "Beta", "Shared"]
      (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modC"),
    expectEqual
      (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modD")
      (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modC"),
    expectEqual
      (deNameIdxAt (deNameIdxChainNoUnrelated (probeGraphCtx ())) "modA")
      (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modA"),
    expectEqual
      (deNameIdxAt (deNameIdxChainNoUnrelated (probeGraphCtx ())) "modB")
      (deNameIdxAt (deNameIdxChain (probeGraphCtx ())) "modB"),
  ]

-- ── tests ─────────────────────────────────────────────────────────────
-- The prelude reader (ordinal 0) sees NOTHING — not even its own public alias.
test "the prelude reader sees no alias" = expectEqual [] (aliasNamesAt 0)

-- A reader at ordinal 1 sees the prelude's PUBLIC aliases — the plain one and the
-- ATTRIBUTED one (#1228/#1586: an attribute is metadata and no longer hides a
-- declaration) — and NOT its private one.  `AttribCore` comes first because
-- `deAliases` is built by PREPEND and it is the last of core's three decls.
test "a reader at ordinal 1 sees the prelude's public aliases" =
  expectEqual ["AttribCore", "PubCore"] (aliasNamesAt 1)

-- A reader at ordinal 2 sees every public alias, DESCENDING by ordinal — the
-- order `lookupTab`'s first-match depends on, which `lookupTab`'s first-match and
-- `emitCyclicAliasErrors`' render order both observe.
test "a reader at ordinal 2 sees every public alias in descending ordinal order" =
  expectEqual ["PubM", "AttribCore", "PubCore"] (aliasNamesAt 2)

-- Fail-CLOSED at `declEnvsOrdOf`'s miss sentinel, exactly as `declEnvVisibleAt`.
test "a reader at the miss sentinel sees no alias" =
  expectEqual [] (aliasNamesAt (0 - 1))

-- POPULATION NEUTRALITY: all FOUR aliases are in `deAliases` — including the
-- attributed one and the private one — and it is the READ that narrows.  This is
-- the assertion that fails if a later edit "tidies" a visibility question back into
-- the fold, re-creating the two-rows-one-record divergence `dataEnvAddDecl`'s note
-- exists to prevent.
test "alias population leaves the other tables alone" =
  expectEqual 4 (listLen (aliasFixtureEnv (probeGraphCtx ())).deAliases)

-- ── tests ─────────────────────────────────────────────────────────────
test "field owner idents: a collision keeps both, a single owner keeps one" = expectAll
  [
    expectEqual
      ["Pt", "Vec"]
      (map
        snd
        (optionOr
          []
          (omLookup
            "x"
            (deFieldOwnerCollisionEnv (probeGraphCtx ())).deFieldOwnerIdents))),
    expectEqual
      2
      (listLen
        (optionOr
          []
          (omLookup
            "x"
            (deFieldOwnerCollisionEnv (probeGraphCtx ())).deFieldOwnerIdents))),
    expectEqual
      ["Pt"]
      (map
        snd
        (optionOr
          []
          (omLookup
            "x"
            (deFieldOwnerSingleEnv (probeGraphCtx ())).deFieldOwnerIdents))),
  ]

-- The discriminating case: SAME declared name ("Pt") from two DIFFERENT
-- modules stays two DISTINCT identities, not one bare-name collision.
test "the same declared name from two modules stays two distinct identities" = expectAll
  [
    expectEqual
      ["Pt", "Pt"]
      (map
        snd
        (optionOr
          []
          (omLookup
            "x"
            (deFieldOwnerSameNameEnv (probeGraphCtx ())).deFieldOwnerIdents))),
    expectTrue
      (distinctIdentsIn2
        (optionOr
          []
          (omLookup
            "x"
            (deFieldOwnerSameNameEnv (probeGraphCtx ())).deFieldOwnerIdents))),
  ]

-- #2147's order half, on `deRecordIdents` rather than `deFieldOwnerIdents`:
-- DECLARATION order within the bucket, "P1" (module ordinal 0) before "P2"
-- (ordinal 1).  Remove `deRecordIdents`' `omMapValues reverseL` in
-- `buildDataEnv` and this reads `["P2", "P1"]`; the length assertion beside it
-- does not move, which is precisely why a length was never enough.
test "record idents keep declaration order within a bucket" = expectAll [
  expectEqual
    ["P1", "P2"]
    (deRecordIdentTyNames
      (optionOr
        []
        (omLookup "Pt" (deRecordOrderEnv (probeGraphCtx ())).deRecordIdents))),
  expectEqual
    2
    (listLen
      (optionOr
        []
        (omLookup "Pt" (deRecordOrderEnv (probeGraphCtx ())).deRecordIdents))),
]

-- Fixtures for the tests above.  `deKindRow1` is the SAME decls at ordinal 1,
-- which is how the later-row arm is exercised without a second decl set.
deKindAbstractFixture : Decl
deKindAbstractFixture = DData {
  dataVis = VisAbstract,
  dataName = "Opq",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkOpq" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "m",
  dataExtern = False,
  dataNameLoc = None,
}

deKindPrivateFixture : Decl
deKindPrivateFixture = DData {
  dataVis = VisPrivate,
  dataName = "Priv",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkPriv" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "m",
  dataExtern = False,
  dataNameLoc = None,
}

deKindNewtypeFixture : Decl
deKindNewtypeFixture = DNewtype {
  newtypePub = True,
  newtypeName = "Wrap",
  newtypeParams = [],
  newtypeParamKinds = [],
  newtypeCtor = "Wrap",
  newtypeFieldTy = tyConBuiltin "Int" None,
  newtypeCtorBinders = [],
  newtypeDerives = [],
  newtypeOrigin = OriginModule "m",
  newtypeNameLoc = None,
}

deKindFixtureDecls : List Decl
deKindFixtureDecls = [
  deFieldOwnerFixtureA,
  deKindAbstractFixture,
  deKindPrivateFixture,
  deKindNewtypeFixture,
]

deKindRow0 : GraphCtx -> DeclEnvModule
deKindRow0 gctx = declEnvModule gctx 0 "m" deKindFixtureDecls

deKindRow1 : GraphCtx -> DeclEnvModule
deKindRow1 gctx = declEnvModule gctx 1 "m" deKindFixtureDecls

-- Row "n" carries the SAME decls as `deKindRow0` at ordinal 1 under a DIFFERENT
-- module id.  Same decls is deliberate: it makes the own-row contribution and the
-- earlier row's contribution identical values, so the only thing the assertions
-- above can be reading is WHICH ROWS were folded, never which decls.
deSeedRowN : GraphCtx -> DeclEnvModule
deSeedRowN gctx = declEnvModule gctx 1 "n" deKindFixtureDecls

-- The bare zero, NOT `emptyDeclEnvSeedAcc`: these probes assert which ROWS were
-- folded, and the `""` core-pass seed would be an extra key in every assertion.
deSeedChainProbeZero : DeclEnvSeedAcc
deSeedChainProbeZero = DeclEnvSeedAcc {
  dsKAcc = [],
  dsOAcc = omEmpty,
  dsNAcc = omEmpty,
  dsKinds = omEmpty,
  dsOwners = omEmpty,
  dsNames = omEmpty,
}

deSeedChainProbe : GraphCtx -> DeclEnvSeedAcc
deSeedChainProbe gctx =
  declEnvSeedChain gctx [deKindRow0 gctx, deSeedRowN gctx] deSeedChainProbeZero

deSeedChainKinds : GraphCtx -> OrdMap (List (TabKey, List Kind))
deSeedChainKinds gctx = (deSeedChainProbe gctx).dsKinds

deSeedChainOwners : GraphCtx -> OrdMap (OrdMap (List String))
deSeedChainOwners gctx = (deSeedChainProbe gctx).dsOwners

deSeedChainNames : GraphCtx -> OrdMap (OrdMap Unit)
deSeedChainNames gctx = (deSeedChainProbe gctx).dsNames

-- The accumulated name set for [mid] vs. the retired rebuild, computed here off
-- the SAME row's kind seed.  `omKeys` is sorted ascending, so this compares KEY
-- SETS and is blind to tree shape and to insertion order — which is exactly the
-- equivalence class the only reader (`noImplHintFor`'s `omHasKey`) can observe.
deSeedNameParity : String -> Bool
deSeedNameParity mid =
  let gctx = probeGraphCtx ()
  let accumulated =
    omKeys (optionOr omEmpty (omLookup mid (deSeedChainNames gctx)))
  let rebuilt =
    omKeys
      (omFromNames
        (map
          (p => tabKeyName (fst p))
          (optionOr [] (omLookup mid (deSeedChainKinds gctx))))
        omEmpty)
  accumulated == rebuilt

-- ── #2158 F7: the name index as A PROGRAM-GLOBAL TABLE (T-GLOBAL-TABLE) ──────
-- `deNameIndexBefore` is a new whole-graph table, so `compiler/AGENTS.md`'s
-- T-GLOBAL-TABLE bar applies: the fixture that matters is not "the feature
-- works", it is "the feature is present and code that never touches it is
-- unaffected".  The four rows below are built for that shape specifically —
-- `deSeedChainProbe` above cannot state it, because both of its rows declare the
-- same data types, so nothing there distinguishes "row X contributed" from "row X
-- was skipped".
--
--   * `modA` declares `Alpha` and `Shared`.
--   * `modB` declares `Beta` and its OWN `Shared` — same declared NAME, different
--     module.  That pair is deliberate: the index is bare-name by construction
--     (`tabKeyName`, matching the `tabHasName` scan it replaced — see the
--     `ModuleCtx` field's comment), so the two `Shared` declarations must collapse
--     to ONE key.  A future edit that made the index identity-keyed would show up
--     as two entries here, which is the point of asserting the key LIST rather
--     than a membership Bool.
--   * `modC` and `modD` declare NO data type at all — just a value binding.  They
--     are the "unrelated code" half: their presence must leave every other row's
--     index untouched, and they must contribute nothing to any later row's.
deNameIdxAlpha : Decl
deNameIdxAlpha = DData {
  dataVis = VisPublic,
  dataName = "Alpha",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkAlpha" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "modA",
  dataExtern = False,
  dataNameLoc = None,
}

deNameIdxSharedA : Decl
deNameIdxSharedA = DData {
  dataVis = VisPublic,
  dataName = "Shared",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkSharedA" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "modA",
  dataExtern = False,
  dataNameLoc = None,
}

deNameIdxBeta : Decl
deNameIdxBeta = DData {
  dataVis = VisPublic,
  dataName = "Beta",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkBeta" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "modB",
  dataExtern = False,
  dataNameLoc = None,
}

deNameIdxSharedB : Decl
deNameIdxSharedB = DData {
  dataVis = VisPublic,
  dataName = "Shared",
  dataParams = [],
  dataParamKinds = [],
  dataCtors = [Variant "MkSharedB" (ConPos [tyConBuiltin "Int" None])],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "modB",
  dataExtern = False,
  dataNameLoc = None,
}

deNameIdxModA : GraphCtx -> DeclEnvModule
deNameIdxModA gctx =
  declEnvModule gctx 0 "modA" [deNameIdxAlpha, deNameIdxSharedA]

deNameIdxModB : GraphCtx -> DeclEnvModule
deNameIdxModB gctx =
  declEnvModule gctx 1 "modB" [deNameIdxBeta, deNameIdxSharedB]

-- No data declaration anywhere in these two — a plain value binding, the
-- "unrelated code" T-GLOBAL-TABLE asks for.
deNameIdxModC : GraphCtx -> DeclEnvModule
deNameIdxModC gctx = declEnvModule gctx 2 "modC" [
  DFunDef True "modCHelper" [] (ELit (LInt 1)) noDeclLoc noBinderId,
]

deNameIdxModD : GraphCtx -> DeclEnvModule
deNameIdxModD gctx = declEnvModule gctx 3 "modD" [
  DFunDef True "modDHelper" [] (ELit (LInt 2)) noDeclLoc noBinderId,
]

deNameIdxChain : GraphCtx -> OrdMap (OrdMap Unit)
deNameIdxChain gctx =
  let s =
    declEnvSeedChain
      gctx
      [
        deNameIdxModA gctx,
        deNameIdxModB gctx,
        deNameIdxModC gctx,
        deNameIdxModD gctx,
      ]
      deSeedChainProbeZero
  s.dsNames

-- The SAME chain with the two data-free rows removed.  Comparing against this is
-- what turns "unrelated code is unaffected" into an assertion rather than a hope.
deNameIdxChainNoUnrelated : GraphCtx -> OrdMap (OrdMap Unit)
deNameIdxChainNoUnrelated gctx =
  let s =
    declEnvSeedChain
      gctx
      [deNameIdxModA gctx, deNameIdxModB gctx]
      deSeedChainProbeZero
  s.dsNames

deNameIdxAt : OrdMap (OrdMap Unit) -> String -> List String
deNameIdxAt nm mid = omKeys (optionOr omEmpty (omLookup mid nm))

-- Build the whole-graph `DataEnv` from the per-module rows — the SAME rows
-- `deImpls`/`deIfaces` fold, visiting the same decls in the same order the
-- flattened `deAllDecls` holds them (`declEnvDeclsOf` is those rows' `demDecls`
-- concatenated in ordinal order), so nothing about the four bare-name-free
-- tables below moves by taking rows instead of the flat list.
--
-- `buildDataEnv` takes the rows for one reason: `deAliases` carries
-- the declaring module's ORDINAL, and the flattened list has no ordinal in it —
-- the same reason `buildImplEnv` has always read rows (see `buildDeclEnvs`).
buildDataEnv : List DeclEnvModule -> DataEnv
buildDataEnv rows = dataEnvFinish (dataEnvFromRowsGo rows emptyDataEnv)

-- Fixture for the tests below: a PUBLIC alias in the prelude row (ordinal 0),
-- a PRIVATE one beside it, and a public one in a later module (ordinal 1).
aliasFixturePubCore : Decl
aliasFixturePubCore = DTypeAlias {
  tyAliasPub = True,
  tyAliasName = "PubCore",
  tyAliasParams = [],
  tyAliasParamKinds = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "core",
  tyAliasNameLoc = None,
}

aliasFixturePrivCore : Decl
aliasFixturePrivCore = DTypeAlias {
  tyAliasPub = False,
  tyAliasName = "PrivCore",
  tyAliasParams = [],
  tyAliasParamKinds = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "core",
  tyAliasNameLoc = None,
}

aliasFixturePubM : Decl
aliasFixturePubM = DTypeAlias {
  tyAliasPub = True,
  tyAliasName = "PubM",
  tyAliasParams = [],
  tyAliasParamKinds = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "m",
  tyAliasNameLoc = None,
}

-- PUBLIC, but wrapped in an attribute.  SINCE #1228/#1586 this row is visible:
-- `registerData` unwraps `DAttrib`, so `aliasVisibleTo`'s third condition is gone
-- and this alias behaves like any other public one.  It is still in the population
-- (`deAliases` holds four rows, asserted below) — that half never changed.
aliasFixtureAttribCore : Decl
aliasFixtureAttribCore =
  DAttrib
    [AttrDeprecated (Some "old")]
    DTypeAlias {
      tyAliasPub = True,
      tyAliasName = "AttribCore",
      tyAliasParams = [],
      tyAliasParamKinds = [],
      tyAliasRhs = tyConBuiltin "Int" None,
      tyAliasOrigin = OriginModule "core",
      tyAliasNameLoc = None,
    }

aliasFixtureEnv : GraphCtx -> DataEnv
aliasFixtureEnv gctx = buildDataEnv [
  declEnvModule gctx 0 "core" [
    aliasFixturePubCore, aliasFixturePrivCore, aliasFixtureAttribCore
  ],
  declEnvModule gctx 1 "m" [aliasFixturePubM],
]

aliasNamesAt : Int -> List String
aliasNamesAt cur =
  map
    (e => tabKeyName (fst e))
    (aliasUniverseAt cur (aliasFixtureEnv (probeGraphCtx ())).deAliases)

-- Fixture for the tests below: two DIFFERENT modules ("m", "n") each
-- declaring a record named-field variant with field "x".
deFieldOwnerFixtureA : Decl
deFieldOwnerFixtureA = DData {
  dataVis = VisPublic,
  dataName = "Pt",
  dataParams = [],
  dataParamKinds = [],
  dataCtors =
    [Variant "Pt" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "m",
  dataExtern = False,
  dataNameLoc = None,
}

deFieldOwnerFixtureB : Decl
deFieldOwnerFixtureB = DData {
  dataVis = VisPublic,
  dataName = "Vec",
  dataParams = [],
  dataParamKinds = [],
  dataCtors =
    [Variant "Vec" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "n",
  dataExtern = False,
  dataNameLoc = None,
}

-- Same DECLARED NAME as fixture A ("Pt"), different module.  This is the case
-- the bare-name table (`universeFieldOwners`) genuinely cannot discriminate:
-- `addFieldOwners` is already a multimap, so it does NOT collapse fixture A/B
-- above (different ctor NAMES "Pt"/"Vec" — the bare table already shows two
-- rows for those).  What the bare table collapses is A vs C: both would
-- append the SAME bare string "Pt" to field "x"'s owner list, so a reader of
-- that list cannot tell "Pt" declared twice from one declaration counted
-- twice.  The identity table keeps them as two DISTINCT `Ident`s (different
-- `OriginModule`), which `distinctIdentsIn2` below asserts on directly.
deFieldOwnerFixtureC : Decl
deFieldOwnerFixtureC = DData {
  dataVis = VisPublic,
  dataName = "Pt",
  dataParams = [],
  dataParamKinds = [],
  dataCtors =
    [Variant "Pt" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "n",
  dataExtern = False,
  dataNameLoc = None,
}

deFieldOwnerCollisionEnv : GraphCtx -> DataEnv
deFieldOwnerCollisionEnv gctx = buildDataEnv [
  declEnvModule gctx 0 "m" [deFieldOwnerFixtureA, deFieldOwnerFixtureB],
]

deFieldOwnerSingleEnv : GraphCtx -> DataEnv
deFieldOwnerSingleEnv gctx =
  buildDataEnv [declEnvModule gctx 0 "m" [deFieldOwnerFixtureA]]

deFieldOwnerSameNameEnv : GraphCtx -> DataEnv
deFieldOwnerSameNameEnv gctx = buildDataEnv [
  declEnvModule gctx 0 "m" [deFieldOwnerFixtureA, deFieldOwnerFixtureC],
]

-- ── `deRecordIdents`' bucket order ───────────────
-- `deFieldOwnerIdents` has an ORDERED assertion (the `["Pt",
-- "Vec"]` test below states a list, not a length).  `deRecordIdents` — its
-- sibling under the same `omMapValues reverseL` finalisation in `buildDataEnv`,
-- rewritten from `++ [x]` to cons-and-reverse by #2147 — had only its VALUES
-- covered, never its ORDER.  So the one property #2147 had to preserve was the
-- one nothing asserted: drop `deRecordIdents`' half of that `omMapValues
-- reverseL` and every existing assertion in this file still passes.
--
-- The fixture needs 2+ entries under ONE key, and `deRecordIdents` is keyed by
-- CONSTRUCTOR name, so it takes two records sharing a ctor name under different
-- TYPE names — which is also what makes the assertion discriminating, since the
-- type name is then the thing that distinguishes first from second.
deRecordOrderFixtureA : Decl
deRecordOrderFixtureA = DData {
  dataVis = VisPublic,
  dataName = "P1",
  dataParams = [],
  dataParamKinds = [],
  dataCtors =
    [Variant "Pt" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "m",
  dataExtern = False,
  dataNameLoc = None,
}

deRecordOrderFixtureB : Decl
deRecordOrderFixtureB = DData {
  dataVis = VisPublic,
  dataName = "P2",
  dataParams = [],
  dataParamKinds = [],
  dataCtors =
    [Variant "Pt" (ConNamed [Field "y" (tyConBuiltin "Int" None)] False)],
  dataCtorBinders = [],
  dataDerives = [],
  dataOrigin = OriginModule "n",
  dataExtern = False,
  dataNameLoc = None,
}

-- Two modules in ORDINAL order, so "P1" is declared strictly before "P2".
deRecordOrderEnv : GraphCtx -> DataEnv
deRecordOrderEnv gctx = buildDataEnv [
  declEnvModule gctx 0 "m" [deRecordOrderFixtureA],
  declEnvModule gctx 1 "n" [deRecordOrderFixtureB],
]

deRecordIdentTyNames : List (Ident, String, List Field) -> List String
deRecordIdentTyNames [] = []
deRecordIdentTyNames ((_, tyName, _) :: rest) =
  tyName :: deRecordIdentTyNames rest

-- Two-element owner list, DISTINCT `Ident`s (never a fixed answer): the
-- property a bare-name multimap cannot state, since two `String`s "Pt"/"Pt"
-- carry no way to tell them apart.
distinctIdentsIn2 : List (Ident, String) -> Bool
distinctIdentsIn2 [(i1, _), (i2, _)] = i1 /= i2
distinctIdentsIn2 _ = False
