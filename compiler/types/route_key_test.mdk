-- Sibling tests for the published evidence table in `route_key.mdk`.
--
-- Only the answering arms are covered here.  A lookup that finds no entry panics, and
-- `stdlib/test.mdk` has no verb that observes a panic in-process, so the three miss arms
-- of `evDictRoutes` (no table, ordinal below or past the span, in-span hole) are not
-- pinned by this file.  Pinning them needs a shell gate that runs an entry calling `evDictRoutes`
-- on an empty table and expects the panic text, enrolled in `test/gates.toml`.

import test.{expectEqual, expectAll}
import types.route_key.{
  evDictRoutes,
  installEvidence,
  installedEvidenceEntries,
  installedEvidenceSlots,
  remapEvidence,
  withEvidencePreserved,
}
import frontend.ast.{EvId(..), EvVal(..), EvEntry(..), Route(..)}

test "an application of zero dictionaries is an explicit empty entry" =
  let _ = installEvidence [EvEntry (EvId "m" 0) (EvMany [])]
  expectEqual 0 (length (evDictRoutes (EvId "m" 0)))

test "entries are answered by ordinal, empty and non-empty side by side" =
  let _ = installEvidence [
    EvEntry (EvId "m" 0) (EvMany []),
    EvEntry (EvId "m" 2) (EvMany [RNone, RNone]),
    EvEntry (EvId "m" 1) (EvMany [RNone]),
  ]
  expectAll [
    expectEqual 0 (length (evDictRoutes (EvId "m" 0))),
    expectEqual 1 (length (evDictRoutes (EvId "m" 1))),
    expectEqual 2 (length (evDictRoutes (EvId "m" 2))),
  ]

-- A table is sized by its own entries' ordinals, lowest to highest, so a late graph's
-- table is as small as an early one's; the offset lookup, the restore around a helper
-- elaboration and the in-place rewrite all see the same entries.
test "a table whose ordinals start late is sized by its span" =
  let _ = installEvidence [
    EvEntry (EvId "m" 1000) (EvMany []),
    EvEntry (EvId "m" 1002) (EvMany [RNone, RNone]),
  ]
  let slots = installedEvidenceSlots ()
  let _ = withEvidencePreserved (_ => installEvidence [
    EvEntry (EvId "m" 5) (EvMany [RNone]),
  ])
  let _ = remapEvidence (e => match e
    EvEntry ev _ => EvEntry ev (EvMany [RNone]))
  expectAll [
    expectEqual 3 slots,
    expectEqual 3 (installedEvidenceSlots ()),
    expectEqual 2 (length (installedEvidenceEntries ())),
    expectEqual 1 (length (evDictRoutes (EvId "m" 1000))),
    expectEqual 1 (length (evDictRoutes (EvId "m" 1002))),
  ]
