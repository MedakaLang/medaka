-- Tests of `types.tc_mono`'s own API: the builtin tycon mints, variable ids, substitution,
-- one-sided matching and overlap, and the arrow/head projections.  Properties run over a
-- model type language (`MTy`) whose reading as a `Mono` is the generator; the expected
-- answer of each law is computed on the model, never read back from the module under test.

import list.{lookup, nub, zip}
import test.{
  expectAll,
  expectEqual,
  expectFalse,
  expectNotEqual,
  expectTrue,
}
import frontend.ast.{TyConOrigin(..)}
import types.effect_rows.{pureRow}
import types.repr.{Mono(..), Tyvar(..), ppMono, tupleSpine}
import types.tc_mono.{
  anyMember,
  arrowArity,
  cohApply,
  cohEqMono,
  cohOverlap,
  cohOverlapGo,
  headTyconNameMono,
  monoClosed,
  monoSameGiven,
  monoUnboundIds,
  peelArrows,
  resultAfterArrows,
  stripArrows,
  substMono,
  tconBuiltin,
  tconFrom,
  tconUnresolved,
  tupleMono,
}
import types.tc_state.{probeGraphCtx}

-- The model: a constructor leaf, a numbered variable leaf, an application, an arrow.
-- A term with no `MVar` is closed.
public export data MTy =
  | MCon String
  | MVar Int
  | MApp MTy MTy
  | MFun MTy MTy
  deriving (Eq, Debug)

export
conNames : List String
conNames = ["Int", "Bool", "List", "Pair"]

export
genLeaf : Unit -> <Rand> MTy
genLeaf () =
  let k = randomInt 0 7
  if k < 4 then
    optionOr (MCon "Int") (lookup k (zip [0, 1, 2, 3] (map MCon conNames)))
  else
    MVar (k - 4)

export
genMTy : Int -> <Rand> MTy
genMTy depth
  | depth <= 0 = genLeaf ()
  | otherwise = match randomInt 0 3
    0 => genLeaf ()
    1 => MApp (genMTy (depth - 1)) (genMTy (depth - 1))
    _ => MFun (genMTy (depth - 1)) (genMTy (depth - 1))

-- Variables are drawn from the four ids 0..3, so substitutions below have a domain to hit.
impl Arbitrary MTy where
  arbitrary () = genMTy 3
  shrink (MApp a b) = [a, b]
  shrink (MFun a b) = [a, b]
  shrink _ = []

-- A closed model type: constructor leaves only, so no precondition filter is needed
-- where a law requires closed ranges or closed targets.
public export data Closed = Closed MTy deriving (Eq, Debug)

export
genClosed : Int -> <Rand> MTy
genClosed depth
  | depth <= 0 =
    MCon (optionOr "Int" (lookup (randomInt 0 3) (zip [0, 1, 2, 3] conNames)))
  | otherwise = match randomInt 0 3
    0 => genClosed 0
    1 => MApp (genClosed (depth - 1)) (genClosed (depth - 1))
    _ => MFun (genClosed (depth - 1)) (genClosed (depth - 1))

export
closedTy : Closed -> MTy
closedTy (Closed t) = t

impl Arbitrary Closed where
  arbitrary () = Closed (genClosed 2)
  shrink (Closed (MApp a b)) = [Closed a, Closed b]
  shrink (Closed (MFun a b)) = [Closed a, Closed b]
  shrink _ = []

export
varsOf : MTy -> List Int
varsOf (MCon _) = []
varsOf (MVar k) = [k]
varsOf (MApp a b) = varsOf a ++ varsOf b
varsOf (MFun a b) = varsOf a ++ varsOf b

export
isClosed : MTy -> Bool
isClosed t = varsOf t == []

-- One shared unbound cell per distinct variable id, so a repeated variable is one cell.
cellsFor : List Int -> List (Int, Ref Tyvar)
cellsFor ids = map (k => (k, Ref (Unbound k 0))) ids

toMonoIn : List (Int, Ref Tyvar) -> MTy -> Mono
toMonoIn _ (MCon n) = tconBuiltin n
toMonoIn cells (MVar k) = match lookup k cells
  Some cell => TVar cell
  None => tconUnresolved "no-cell"
toMonoIn cells (MApp a b) = TApp (toMonoIn cells a) (toMonoIn cells b)
toMonoIn cells (MFun a b) = TFun (toMonoIn cells a) pureRow (toMonoIn cells b)

toMono : MTy -> Mono
toMono t =
  let cells = varsOf t |> nub |> cellsFor
  toMonoIn cells t

modelSubst : List (Int, MTy) -> MTy -> MTy
modelSubst _ (MCon n) = MCon n
modelSubst s (MVar k) = match lookup k s
  Some r => r
  None => MVar k
modelSubst s (MApp a b) = MApp (modelSubst s a) (modelSubst s b)
modelSubst s (MFun a b) = MFun (modelSubst s a) (modelSubst s b)

-- The monomorphic image of a model substitution: its closed ranges, read as monos.
monoSubst : List (Int, MTy) -> List (Int, Mono)
monoSubst s = map ((k, r) => (k, toMono r)) s

applySubst : List (Int, MTy) -> MTy -> Mono
applySubst s t = substMono (probeGraphCtx ()) (monoSubst s) [] [] (toMono t)

-- The arrows down the right spine, and what is left.
modelArity : MTy -> Int
modelArity (MFun _ b) = 1 + modelArity b
modelArity _ = 0

modelResult : MTy -> MTy
modelResult (MFun _ b) = modelResult b
modelResult t = t

modelArgs : MTy -> List MTy
modelArgs (MFun a b) = a :: modelArgs b
modelArgs _ = []

-- The head leaf of an application spine, when it is a constructor.
modelHead : MTy -> Option String
modelHead (MCon n) = Some n
modelHead (MApp f _) = modelHead f
modelHead _ = None

-- Every constructor leaf at an even preorder position becomes a distinct variable, so the
-- result is a pattern that the original closed term is an instance of.
abstractLeaves : Int -> MTy -> (Int, MTy)
abstractLeaves i (MCon n) =
  if isEven i then (i + 1, MVar (100 + i)) else (i + 1, MCon n)
abstractLeaves i (MVar k) = (i + 1, MVar k)
abstractLeaves i (MApp a b) =
  let (j, a2) = abstractLeaves (i + 1) a
  let (k, b2) = abstractLeaves j b
  (k, MApp a2 b2)
abstractLeaves i (MFun a b) =
  let (j, a2) = abstractLeaves (i + 1) a
  let (k, b2) = abstractLeaves j b
  (k, MFun a2 b2)

-- Law: the unbound ids of a monotype are exactly its variables, in order, so a closed
-- type has none and `monoClosed` agrees.  No precondition.
prop "monoUnboundIds lists the variables of a type, and a closed type has none" (t : MTy) =
  let m = toMono t
  monoUnboundIds m == varsOf t && monoClosed m == isClosed t

-- Law: substituting with an empty table changes nothing.  No precondition.
prop "the empty substitution is the identity" (t : MTy) =
  cohEqMono (applySubst [] t) (toMono t)
    && monoUnboundIds (applySubst [] t) == varsOf t

-- Law: substitution of closed terms agrees with the model's.  The ranges are closed by
-- construction, since `substMono` is one simultaneous pass and does not re-substitute;
-- the target is open, so the substitution has variables to hit.
prop "substituting closed monotypes agrees with the model substitution" (t : MTy) (c0 : Closed) (c1 : Closed) =
  let s = [(0, closedTy c0), (1, closedTy c1)]
  cohEqMono (applySubst s t) (toMono (modelSubst s t))

-- Law: two substitutions with disjoint domains and closed ranges compose, in either order
-- and as their union.  The domains {0} and {1} are disjoint (fixed here) and the ranges
-- are closed by construction.
prop "substitutions with disjoint domains and closed ranges compose in either order" (t : MTy) (c0 : Closed) (c1 : Closed) =
  let s0 = [(0, closedTy c0)]
  let s1 = [(1, closedTy c1)]
  let whole = applySubst (s0 ++ s1) t
  let viaS1 = applySubst s0 (modelSubst s1 t)
  let viaS0 = applySubst s1 (modelSubst s0 t)
  cohEqMono whole viaS1 && cohEqMono whole viaS0

-- Law: a pattern abstracted from a closed term unifies with the term, and applying the
-- recorded bindings to the pattern gives the term back.  Precondition: the target is
-- closed.
prop "matching a pattern against its closed target and applying the bindings gives the target" (c : Closed) =
  let t = closedTy c
  let (_, pat) = abstractLeaves 0 t
  let patMono = toMono pat
  let target = toMono t
  let bindings = Ref []
  cohOverlapGo bindings [(patMono, target)]
    && cohEqMono (cohApply bindings patMono) target

-- Law: for two closed types, overlap is structural equality (rows are not compared).
-- `same` makes the second type a copy of the first about half the time, since two
-- independent draws are almost never equal.
prop "two closed types overlap exactly when they are equal" (c0 : Closed) (c1 : Closed) (same : Bool) =
  let a = closedTy c0
  let b = if same then a else closedTy c1
  cohOverlap [toMono a] [toMono b] == (a == b)
    && cohEqMono (toMono a) (toMono b) == (a == b)

-- Law: the arrow projections read the right spine.  No precondition; variables are
-- unbound, so no link is followed.
prop "arrowArity, peelArrows and stripArrows read the arrow spine" (t : MTy) =
  let m = toMono t
  arrowArity m == modelArity t
    && length (peelArrows 100 m) == modelArity t
    && cohEqMono (stripArrows m) (toMono (modelResult t))
    && map ppMono (peelArrows 100 m)
      == map (a => ppMono (toMono a)) (modelArgs t)

-- Law: the head name of a spine is its leftmost constructor.  Precondition: the spine
-- head is a constructor (a variable head has no name).
prop "headTyconNameMono names the leftmost constructor of an application spine" (t : MTy) =
  match modelHead t
    Some n => headTyconNameMono (toMono t) == Some n
    None => True

-- Law: two name lists share a member exactly when some name is in both, symmetrically; the
-- empty list shares none and a non-empty list shares one with itself.  No precondition;
-- the names come from a four-name alphabet so shared members occur.
prop "anyMember is symmetric and is True exactly for a shared name" (xs : List Int) (ys : List Int) =
  let a = map (k => "v\{intToString (abs k % 4)}") xs
  let b = map (k => "v\{intToString (abs k % 4)}") ys
  anyMember a b == anyMember b a
    && anyMember a b == (length (filter (x => elem x b) a) > 0)
    && not (anyMember [] a)
    && anyMember a a == (a /= [])

test "two same-named types from different modules are different types" =
  let a = tconFrom (OriginModule "m1") "T"
  let b = tconFrom (OriginModule "m2") "T"
  expectAll [
    expectFalse (cohEqMono a b),
    expectTrue (cohEqMono a (tconFrom (OriginModule "m1") "T")),
  ]

test "an absent origin makes no claim against an identity of the same name" = expectAll
  [
    expectTrue
      (cohEqMono (tconUnresolved "T") (tconFrom (OriginModule "m1") "T")),
    expectFalse (cohEqMono (tconUnresolved "T") (tconUnresolved "U")),
  ]

test "a linked variable reads as its target, and an unbound one as itself" =
  let target = Ref (Unbound 7 0)
  let linked = Ref (Link (TVar target))
  let closed = Ref (Link (tconBuiltin "Int"))
  expectAll [
    expectEqual [7] (monoUnboundIds (TVar linked)),
    expectEqual [] (monoUnboundIds (TVar closed)),
    expectTrue (monoClosed (TVar closed)),
    expectFalse (monoClosed (TVar target)),
  ]

test "a rigid variable is not closed and is not the given of a distinct rigid one" = expectAll
  [
    expectFalse (monoClosed (TRigid "a")),
    expectFalse (monoSameGiven (TRigid "a") (TRigid "b")),
    expectTrue (monoClosed (TApp (tconBuiltin "List") (tconBuiltin "Int"))),
  ]

test "tupleMono builds the saturated tuple spine that tupleSpine reads back" =
  let parts = [tconBuiltin "Int", tconBuiltin "Bool", tconBuiltin "List"]
  let spine = tupleMono parts
  expectAll [
    expectEqual (Some "__tuple3__") (headTyconNameMono spine),
    expectEqual
      (Some ["Int", "Bool", "List"])
      (map (map ppMono) (tupleSpine spine)),
    expectNotEqual (Some "__tuple2__") (headTyconNameMono spine),
  ]

test "resultAfterArrows is None past the arrow spine and the rest within it" =
  let int = tconBuiltin "Int"
  let fn = TFun int pureRow (TFun int pureRow (tconBuiltin "Bool"))
  expectAll [
    expectEqual (Some "Bool") (map ppMono (resultAfterArrows 2 fn)),
    expectTrue (isNone (resultAfterArrows 3 fn)),
    expectEqual 2 (arrowArity fn),
  ]
