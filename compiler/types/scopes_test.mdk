-- Sibling tests for the nominal lexical scope store.  The production owner and
-- frame types intentionally have no Eq/Debug instances, so assertions compare
-- projected immutable views and booleans.

import test.{expectEqual, expectTrue}
import frontend.ast.{TyConOrigin(..)}
import types.evidence.{ScopeId(..)}
import types.repr.{IfaceRef(..)}
import types.scopes.{
  DefaultBodyIdentity(..),
  ScopeCursor(..),
  ScopeFrame(..),
  ScopeOwner(..),
  ScopeStore,
  binderAt,
  captureScopeCursor,
  closeScopeCursor,
  copyScopeStore,
  enclosingDefaultBody,
  freshScope,
  freshScopeStore,
  givenVisibleFrom,
  openScopeCursor,
  scopeFrame,
  scopeFrameStats,
  scopeOwnerLabel,
  visibleChain,
  visibleOnChain,
}
import support.util.{listLen}

data FrameView = FrameView {
  fvId : ScopeId,
  fvParent : Option ScopeId,
  fvLevel : Int,
  fvModule : String,
  fvOwner : String,
}
  deriving (Eq, Debug)

frameView : ScopeStore -> ScopeId -> FrameView
frameView store sid =
  let frame = scopeFrame store sid
  FrameView {
    fvId = frame.sfId,
    fvParent = frame.sfParent,
    fvLevel = frame.sfLevel,
    fvModule = frame.sfModuleId,
    fvOwner = scopeOwnerLabel frame.sfOwner,
  }

bindingOwner : ScopeStore -> ScopeId -> Option String
bindingOwner store sid = match (scopeFrame store sid).sfOwner
  BindingOwner name => Some name
  _ => None

data CopyView = CopyView {
  copyOriginalId : ScopeId,
  copyCopiedId : ScopeId,
  copyOriginalOwner : Option String,
  copyCopiedOwner : Option String,
  copyOriginalStats : (Int, Int),
  copyCopiedStats : (Int, Int),
}
  deriving (Eq, Debug)

data DefaultView =
  | NoDefault
  | DefaultView String String String
  deriving (Eq, Debug)

defaultView : ScopeStore -> ScopeId -> DefaultView
defaultView store sid = match enclosingDefaultBody store sid
  None => NoDefault
  Some owner => match owner.dbiIface.irOrigin
    OriginModule moduleId =>
      DefaultView moduleId owner.dbiIface.irName owner.dbiMethod
    OriginBuiltin =>
      DefaultView "<builtin>" owner.dbiIface.irName owner.dbiMethod
    OriginUnresolved =>
      DefaultView "<unresolved>" owner.dbiIface.irName owner.dbiMethod

cursorView : ScopeCursor -> Option ScopeId
cursorView ScopeClosed = None
cursorView (ScopeOpen sid) = Some sid

test "frames preserve identity ancestry level module owner and lexical visibility" =
  let store = freshScopeStore ()
  let initialStats = scopeFrameStats store
  let root = freshScope store None 0 "scope-test" ModuleOwner
  let left = freshScope store (Some root) 1 "scope-test" (BindingOwner "same")
  let inner = freshScope store (Some left) 2 "scope-test" (BindingOwner "inner")
  let right = freshScope store (Some root) 1 "scope-test" (BindingOwner "same")
  expectEqual
    (
      (0, 0),
      [
        FrameView {
          fvId = ScopeId 0,
          fvParent = None,
          fvLevel = 0,
          fvModule = "scope-test",
          fvOwner = "module",
        },
        FrameView {
          fvId = ScopeId 1,
          fvParent = Some (ScopeId 0),
          fvLevel = 1,
          fvModule = "scope-test",
          fvOwner = "binding:same",
        },
        FrameView {
          fvId = ScopeId 2,
          fvParent = Some (ScopeId 1),
          fvLevel = 2,
          fvModule = "scope-test",
          fvOwner = "binding:inner",
        },
        FrameView {
          fvId = ScopeId 3,
          fvParent = Some (ScopeId 0),
          fvLevel = 1,
          fvModule = "scope-test",
          fvOwner = "binding:same",
        },
      ],
      (4, 16),
      [True, True, True],
    )
    (
      initialStats,
      map (frameView store) [root, left, inner, right],
      scopeFrameStats store,
      [
        givenVisibleFrom store inner left,
        not (givenVisibleFrom store right left),
        binderAt left 0 /= binderAt right 0,
      ],
    )

test "the read-once chain answers every pair as the per-given walk does" =
  let store = freshScopeStore ()
  let root = freshScope store None 0 "chain-test" ModuleOwner
  let left = freshScope store (Some root) 1 "chain-test" (BindingOwner "left")
  let inner = freshScope store (Some left) 2 "chain-test" (BindingOwner "inner")
  let right = freshScope store (Some root) 1 "chain-test" (BindingOwner "right")
  let other = freshScope store None 0 "chain-other" ModuleOwner
  let scopes = [root, left, inner, right, other]
  let pairs = flatMap (u => map (b => (u, b)) scopes) scopes
  expectEqual
    (
      [2, 1, 0],
      map (pair => givenVisibleFrom store (fst pair) (snd pair)) pairs,
    )
    (
      visibleChain store inner,
      map
        (pair => visibleOnChain (visibleChain store (fst pair)) (snd pair))
        pairs,
    )

test "copy owns a detached counter and backing array" =
  let original = freshScopeStore ()
  let root = freshScope original None 0 "copy-test" ModuleOwner
  let left = freshScope original (Some root) 1 "copy-test" (BindingOwner "left")
  let _ = freshScope original (Some left) 2 "copy-test" (BindingOwner "inner")
  let right =
    freshScope original (Some root) 1 "copy-test" (BindingOwner "right")
  let copied = copyScopeStore original
  let originalId =
    freshScope original (Some right) 2 "copy-test" (BindingOwner "original-id4")
  let copiedId =
    freshScope copied (Some right) 2 "copy-test" (BindingOwner "copied-id4")
  expectEqual
    CopyView {
      copyOriginalId = ScopeId 4,
      copyCopiedId = ScopeId 4,
      copyOriginalOwner = Some "original-id4",
      copyCopiedOwner = Some "copied-id4",
      copyOriginalStats = (5, 16),
      copyCopiedStats = (5, 16),
    }
    CopyView {
      copyOriginalId = originalId,
      copyCopiedId = copiedId,
      copyOriginalOwner = bindingOwner original originalId,
      copyCopiedOwner = bindingOwner copied copiedId,
      copyOriginalStats = scopeFrameStats original,
      copyCopiedStats = scopeFrameStats copied,
    }

test "independent stores may reuse raw ids without sharing frames" =
  let first = freshScopeStore ()
  let second = freshScopeStore ()
  let firstRoot = freshScope first None 0 "first-module" (BindingOwner "first")
  let secondRoot =
    freshScope second None 7 "second-module" (BindingOwner "second")
  expectEqual
    (
      ScopeId 0,
      ScopeId 0,
      FrameView {
        fvId = ScopeId 0,
        fvParent = None,
        fvLevel = 0,
        fvModule = "first-module",
        fvOwner = "binding:first",
      },
      FrameView {
        fvId = ScopeId 0,
        fvParent = None,
        fvLevel = 7,
        fvModule = "second-module",
        fvOwner = "binding:second",
      },
    )
    (
      firstRoot,
      secondRoot,
      frameView first firstRoot,
      frameView second secondRoot,
    )

test "default ancestry keeps full interface identity and rejects siblings" =
  let store = freshScopeStore ()
  let root = freshScope store None 0 "defaults" ModuleOwner
  let ifaceA = IfaceRef {
    irName = "Supply",
    irOrigin = OriginModule "owner-a",
  }
  let ifaceB = IfaceRef {
    irName = "Supply",
    irOrigin = OriginModule "owner-b",
  }
  let bodyA =
    freshScope
      store
      (Some root)
      1
      "defaults"
      (DefaultBodyOwner DefaultBodyIdentity {
        dbiIface = ifaceA,
        dbiMethod = "copy",
      })
  let childA = freshScope store (Some bodyA) 2 "defaults" (BindingOwner "local")
  let sibling = freshScope store (Some root) 1 "defaults" (BindingOwner "copy")
  let bodyB =
    freshScope
      store
      (Some root)
      1
      "defaults"
      (DefaultBodyOwner DefaultBodyIdentity {
        dbiIface = ifaceB,
        dbiMethod = "copy",
      })
  let childB = freshScope store (Some bodyB) 2 "defaults" (BindingOwner "local")
  let unrelated = freshScope store None 0 "unrelated" ModuleOwner
  expectEqual
    [
      DefaultView "owner-a" "Supply" "copy",
      NoDefault,
      NoDefault,
      DefaultView "owner-b" "Supply" "copy",
    ]
    [
      defaultView store childA,
      defaultView store sibling,
      defaultView store unrelated,
      defaultView store childB,
    ]

test "cursor open capture and close restore the parent then closed" =
  let store = freshScopeStore ()
  let root = freshScope store None 0 "cursor-test" ModuleOwner
  let child =
    freshScope store (Some root) 1 "cursor-test" (BindingOwner "child")
  let atRoot = openScopeCursor root
  let atChild = openScopeCursor child
  let backAtRoot = closeScopeCursor store atChild
  let backClosed = closeScopeCursor store backAtRoot
  expectEqual
    (
      [Some root, Some child, Some root, None],
      [root, child],
    )
    (
      map cursorView [atRoot, atChild, backAtRoot, backClosed],
      [captureScopeCursor atRoot, captureScopeCursor atChild],
    )

-- ── Script properties ────────────────────────────────────────────────────
--
-- A prop parameter is structurally generated, so this turns `List Int` into a
-- bounded parent-choice script.  The production store is compared with an
-- independent association-list ancestry model; refs and frames are created in
-- the property body rather than generated.

boundedScope : Int -> Int -> Int
boundedScope n width = (n % width + width) % width

scopeInt : ScopeId -> Int
scopeInt (ScopeId n) = n

nthScope : List ScopeId -> Int -> ScopeId
nthScope (sid :: _) 0 = sid
nthScope (_ :: rest) n = nthScope rest (n - 1)
nthScope [] _ = ScopeId 0

scopeParentOf : Int -> List (Int, Option Int) -> Option Int
scopeParentOf _ [] = None
scopeParentOf sid ((other, parent) :: rest) =
  if sid == other then parent else scopeParentOf sid rest

modelVisible : List (Int, Option Int) -> Int -> Int -> Bool
modelVisible _ use binder
  | use == binder = True
modelVisible parents use binder = match scopeParentOf use parents
  None => False
  Some parent => modelVisible parents parent binder

buildScopeTree : ScopeStore ->
  List Int ->
  (List ScopeId, List (Int, Option Int))
buildScopeTree store raw =
  let root = freshScope store None 0 "property" ModuleOwner
  buildScopeTreeGo store raw [root] [(scopeInt root, None)]

buildScopeTreeGo : ScopeStore ->
  List Int ->
  List ScopeId ->
  List (Int, Option Int) ->
  (List ScopeId, List (Int, Option Int))
buildScopeTreeGo _ [] ids parents = (ids, parents)
buildScopeTreeGo store (raw :: rest) ids parents =
  let parent = nthScope ids (boundedScope raw (listLen ids))
  let sid =
    freshScope
      store
      (Some parent)
      (boundedScope (raw / 7) 4)
      "property"
      (BindingOwner "node")
  buildScopeTreeGo
    store
    rest
    (ids ++ [sid])
    (parents ++ [(scopeInt sid, Some (scopeInt parent))])

allScopePairsMatch : ScopeStore ->
  List ScopeId ->
  List (Int, Option Int) ->
  Bool
allScopePairsMatch store ids parents = allScopeUsesMatch store ids ids parents

allScopeUsesMatch : ScopeStore ->
  List ScopeId ->
  List ScopeId ->
  List (Int, Option Int) ->
  Bool
allScopeUsesMatch _ _ [] _ = True
allScopeUsesMatch store allIds (use :: rest) parents =
  allBindersMatch store use allIds parents
    && allScopeUsesMatch store allIds rest parents

allBindersMatch : ScopeStore ->
  ScopeId ->
  List ScopeId ->
  List (Int, Option Int) ->
  Bool
allBindersMatch _ _ [] _ = True
allBindersMatch store use (binder :: rest) parents =
  givenVisibleFrom store use binder
      == modelVisible parents (scopeInt use) (scopeInt binder)
    && visibleOnChain (visibleChain store use) binder
      == modelVisible parents (scopeInt use) (scopeInt binder)
    && allBindersMatch store use rest parents

scopeTreeLaw : List Int -> Bool
scopeTreeLaw raw =
  let store = freshScopeStore ()
  let (ids, parents) = buildScopeTree store raw
  allScopePairsMatch store ids parents

framesFollowFreshOrder : ScopeStore -> List ScopeId -> Int -> Bool
framesFollowFreshOrder _ [] _ = True
framesFollowFreshOrder store (sid :: rest) expected =
  let frame = scopeFrame store sid
  frame.sfId == ScopeId expected
    && scopeInt sid == expected
    && framesFollowFreshOrder store rest (expected + 1)

freshOrderLaw : List Int -> Bool
freshOrderLaw raw =
  let store = freshScopeStore ()
  let (ids, _) = buildScopeTree store raw
  let (count, _) = scopeFrameStats store
  count == listLen ids && framesFollowFreshOrder store ids 0

copyIsolationLaw : List Int -> Bool
copyIsolationLaw raw =
  let original = freshScopeStore ()
  let (ids, _) = buildScopeTree original raw
  let root = nthScope ids 0
  let copied = copyScopeStore original
  let originalFresh =
    freshScope original (Some root) 1 "property" (BindingOwner "original")
  let copiedFresh =
    freshScope copied (Some root) 1 "property" (BindingOwner "copied")
  let originalFrame = scopeFrame original originalFresh
  let copiedFrame = scopeFrame copied copiedFresh
  originalFresh == copiedFresh
    && scopeOwnerLabel originalFrame.sfOwner == "binding:original"
    && scopeOwnerLabel copiedFrame.sfOwner == "binding:copied"
    && scopeFrameStats original == scopeFrameStats copied
    && givenVisibleFrom original originalFresh root
    && givenVisibleFrom copied copiedFresh root

prop "scope visibility script agrees with an ancestor model" (raw : List Int) =
  scopeTreeLaw raw

prop "fresh scope ids are monotonic over a generated tree" (raw : List Int) =
  freshOrderLaw raw

prop "copied stores detach frames and counters over a generated tree" (raw : List Int) =
  copyIsolationLaw raw
