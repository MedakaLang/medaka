-- ── v2 Stage 3: the `IO` widening union alias (design §3.2) ─────────────────
-- `IO` is the coarse security alias: in a BOUND/annotation row it stands for
-- the join of the narrow security labels the selected profile grants, every one
-- at ⊤ when none is selected.  `hostLabels` lists them (every minted security
-- label EXCEPT IO itself); internal labels (Mut/Panic) are NOT members, so they
-- are tracked independently of IO.
-- NOTE: `FFI` is deliberately NOT a member. #2071/#2070 (epic, Layer 1, R1):
-- an `<IO>` bound must NOT subsume an `<FFI>`-performing body — FFI crosses a
-- trust boundary the IO alias is not meant to paper over. Do not "complete"
-- this list by adding FFI.

-- What `IO` joins in this drive: the selected profile's grants of the alias
-- labels, each at the parameter granted, in `hostLabels` order.  With no
-- profile that is all eleven at their tops.  Every module of the program is
-- judged against the one join, the shipped stdlib included.
export
ioJoinAtoms : List (String, Param) -> List (String, EffParamTy) -> List Atom
ioJoinAtoms domains grants =
  filterMap
    (l =>
      map
        (granted =>
          atomWith
            (builtinLabel l)
            (writtenParam (dtopIn domains (builtinLabel l)) granted))
        (lookupAssoc l grants))
    hostLabels

-- ── global inference state ────────────────────────────────────────────────

-- sorted + deduplicated string set (canonical effect-label order, matching the
-- OCaml `List.sort_uniq String.compare` so multi-label rows render identically)
-- sortUniqS / sortUniqSGo / sortInsertS moved to support/util.mdk (imported above).

-- ── effect propagation (Phase 79) ─────────────────────────────────────────
-- the latent effect of the function body currently being inferred: application
-- arms widen it; entering a lambda saves+reopens it, and the accumulated row
-- becomes the lambda's arrow effect. The accumulator begins at the empty row;
-- a closed row is an effect value, never a switch for discarding effects.

-- The site a binding performed a label at that the report is about: the
-- first, in source order, whose authority does not lie within the bound
-- the label was admitted at, else the first site.  Two reads under
-- `<FileRead "config/*">`, the second of `/etc/passwd`, report the second.
effectSiteOf : ModuleCtx ->
  String ->
  Option String ->
  Option Authority ->
  Option Loc
effectSiteOf mctx _ None _ = None
effectSiteOf mctx fn (Some label) bound =
  match omLookup (effectSiteKey fn label) mctx.mcCells.effectSitesRef.value
    Some sites =>
      let ordered = reverseL sites
      let offending = match bound
        Some hi => filterList (site => not (authSub (fst site) hi)) ordered
        None => []
      match offending ++ ordered
        site :: _ => snd site
        [] => None
    None => None

beginEffectSummaryScope : ModuleCtx -> Unit -> Unit
beginEffectSummaryScope mctx _ =
  mctx.mcCells.fileValueScopes :=
    wSnapshot mctx.mcCells.fileValueFlows :: mctx.mcCells.fileValueScopes.value
  EffectSolver.openSummaryScope
    mctx.mcCells.effectSummaries
    (newEffvarId mctx.mcGraph ())
    mctx.mcCells.currentLevel.value

freshEffectSummary : ModuleCtx -> Unit -> EffRow
freshEffectSummary mctx _ =
  EffectSolver.newSummary
    mctx.mcCells.effectSummaries
    (newEffvarId mctx.mcGraph ())

recordEffectBody : ModuleCtx -> EffRow -> EffRow -> Unit
recordEffectBody mctx summary lower =
  EffectSolver.recordBodyLower mctx.mcCells.effectSummaries summary lower

summaryEscape : GraphCtx -> Bool -> List Atom -> List Atom -> List Atom
summaryEscape gctx True lower upper = atomsDiff lower upper
summaryEscape gctx False lower upper = atomsEscape gctx lower upper

finishEffectSummaryScope : ModuleCtx ->
  Map Int Unit ->
  Map Int (Ref Effvar) ->
  Unit
finishEffectSummaryScope mctx retained borrowed =
  let _ = finishEffectSummaryScopeKeeping mctx noScopeRoles retained borrowed
  ()

-- Close the scope, keeping as residuals the unproven obligations over the
-- authorities [roles] quantifies at a member (`rlQuantified`, see
-- `closeSummaryScope`); each comes back with its member index.
finishEffectSummaryScopeKeeping : ModuleCtx ->
  ScopeRoles ->
  Map Int Unit ->
  Map Int (Ref Effvar) ->
  List (Int, AuthResidual)
finishEffectSummaryScopeKeeping mctx roles retained borrowed =
  let outcome =
    EffectSolver.closeSummaryScope
      mctx.mcCells.effectSummaries
      mctx.mcCells.rigidEffvarsRef.value
      mctx.mcCells.rigidAuthvarsRef.value
      roles
      retained
      borrowed
      (summaryEscape mctx.mcGraph)
      (joinCellOf mctx.mcGraph)
      (freshEffvarAt mctx.mcGraph)
      (widenOpenedFor mctx)
  let _ = reportEffectSummaryFailures mctx outcome.esoFailures
  let _ = finishFileValueScope mctx ()
  map
    ((member, w) => (
      member,
      AuthResidual {
        arLower = w.awLower,
        arUpper = w.awUpper,
        arExact = w.awExact,
      },
    ))
    outcome.esoResiduals

reportEffectSummaryFailures : ModuleCtx ->
  List (SummaryFailure ObligationSite) ->
  Unit
reportEffectSummaryFailures mctx [] = ()
reportEffectSummaryFailures outer (failure :: rest) =
  let fn = failure.esfContext.osFn
  let mctx =
    mctxAt
      (orElseLoc
        (effectSiteOf outer fn failure.esfLabel (failureBound failure))
        failure.esfContext.osLoc)
      outer
  let _ = match failure.esfAuthority
    Some (lo, hi) =>
      if mentionsEscaped mctx lo || mentionsEscaped mctx hi then
        ()
      else if failure.esfExact then
        reportIndexFailure mctx failure.esfContext.osCovering mctx.mcLoc lo hi
      else
        pushTypeErrorAt
          mctx
          "T-AUTHORITY"
          mctx.mcLoc
          (authorityFailureMsg
            mctx
            fn
            failure.esfLabel
            failure.esfResidualOf
            lo
            hi
            failure.esfWrittenUpper)
    None =>
      mctx.mcCells.rowFailureReportedRef :=
        omInsert fn () mctx.mcCells.rowFailureReportedRef.value
      reportRowFailure mctx failure
  reportEffectSummaryFailures outer rest

-- The authority the failing label was admitted at: the obligation's upper
-- term, or the upper row's atom of that label.
failureBound : SummaryFailure ObligationSite -> Option Authority
failureBound failure = match failure.esfAuthority
  Some (_, hi) => Some hi
  None => match failure.esfLabel
    Some label => map atomAuth (findAtom label (fst (rowFlat failure.esfUpper)))
    None => None

reportRowFailure : ModuleCtx -> SummaryFailure ObligationSite -> Unit
reportRowFailure mctx failure =
  let (upper, upperCells) = rowFlat failure.esfUpper
  let escaping = atomsEscape mctx.mcGraph (fst (rowFlat failure.esfLower)) upper
  let _ =
    if failure.esfExact then
      let rows = ppEachShared (Ref []) (Ref 0) [
        TEff failure.esfLower,
        TEff failure.esfUpper,
      ]
      pushTypeError
        mctx
        "T-EFFECT-INDEX-MISMATCH"
        ("effect index mismatch: "
          ++ joinWith " vs " rows
          ++ "; an effect row in a type argument is invariant, so write the same row on both sides")
    else if isNonEmptyL escaping && isEmptyL upperCells then
      effectLeakCheck mctx escaping upper
    else
      pushTypeError
        mctx
        "T-EFFECT-LAUNDER"
        (effectInclusionMsg
          failure.esfContext.osFn
          escaping
          (ppEachShared (Ref []) (Ref 0) [
            TEff failure.esfLower,
            TEff failure.esfUpper,
          ]))
  ()

-- Close a local binding scope over [members]: whether each generalizes, and
-- its type.  Joins recorded in the scope are decided first when a member
-- generalizes, since its type must not generalize over an undecided join;
-- otherwise they belong to the enclosing scope, where later uses of the
-- alternatives can still shape them.  Everything the close reads (roots,
-- quantifiable authorities) is taken after that.
finishValueEffectsKeeping : DynCtx ->
  List (Bool, Mono) ->
  List (Int, AuthResidual)
finishValueEffectsKeeping dyn generalizing =
  let members =
    map ((generalizes, mono) => (localRole generalizes, mono)) generalizing
  let level = dyn.dcModule.mcCells.currentLevel.value
  let _ =
    if anyList fst generalizing then
      settlePendingJoins dyn level
    else
      postponePendingJoins dyn.dcModule level
  let monos = map snd members
  finishEffectSummaryScopeKeeping
    dyn.dcModule
    (scopeRolesOf members)
    (fold (acc mono => effectRoots mono acc) Tip monos)
    (fold (acc mono => borrowedEffectCells dyn.dcModule mono acc) Tip monos)

borrowedEffectCells : ModuleCtx ->
  Mono ->
  Map Int (Ref Effvar) ->
  Map Int (Ref Effvar)
borrowedEffectCells mctx mono cells =
  fold
    (acc input => effectCells input acc)
    cells
    (producedInputTypes (producedSlotCovariants mctx) mono)

-- A contract's effect variables are universal throughout its body judgment.
-- The same boundary is used for supplied methods and generic default bodies.
beginEffectContract : ModuleCtx ->
  EffRow ->
  Mono ->
  (Map Int Unit, Map Int Unit)
beginEffectContract mctx force value =
  let saved = mctx.mcCells.rigidEffvarsRef.value
  let savedAuths = mctx.mcCells.rigidAuthvarsRef.value
  let _ = beginEffectSummaryScope mctx ()
  mctx.mcCells.rigidEffvarsRef := effectRoots value (effectRowRoots force saved)
  mctx.mcCells.rigidAuthvarsRef :=
    authRoots value (authRowRoots force savedAuths)
  (saved, savedAuths)

finishEffectContract : DynCtx -> (Map Int Unit, Map Int Unit) -> Unit
finishEffectContract dyn (saved, savedAuths) =
  let _ = resolvePendingJoins dyn dyn.dcModule.mcCells.currentLevel.value
  let _ = finishEffectSummaryScope dyn.dcModule Tip Tip
  dyn.dcModule.mcCells.rigidEffvarsRef := saved
  dyn.dcModule.mcCells.rigidAuthvarsRef := savedAuths

-- #784 (Option A): reject an interface method whose signature has a free effect
-- tail var in RETURN position but in NO ROW-KINDED argument position — it is
-- under-determined, so a caller can instantiate it to `<>` and LAUNDER the
-- dispatched impl's real effect (a pure-typed wrapper silently performs it).
-- SCOPED to interface methods (the ratified scope); a top-level return-only
-- effect var is #797's separate territory.
--
-- ⚠️ This runs as a SEPARATE pass from checkEffectParams, deliberately AFTER
-- registerAllData has populated `dataParamKindsRef` (see the call site in
-- checkBodyImpl). The predicate's kind-awareness (rowArgNames) consults that
-- table to tell a row-kinded ctor arg (`Async e a`) from a type-kinded one
-- (`List e`); running it in the early checkEffectParams pre-pass — before data
-- registration — would leave the table empty and spuriously reject `Async e a`.
checkUndeterminedRetEffVars : ModuleCtx -> List Decl -> Unit
checkUndeterminedRetEffVars mctx [] = ()
checkUndeterminedRetEffVars mctx (d :: rest) =
  let _ = checkUndeterminedRetEffVarsDecl mctx d
  checkUndeterminedRetEffVars mctx rest

checkUndeterminedRetEffVarsDecl : ModuleCtx -> Decl -> Unit
checkUndeterminedRetEffVarsDecl mctx (DInterface { name, typarams, typaramKinds, methods, ... }) =
  checkIfaceMethodEffs
    mctx
    name
    (declGradedScope mctx.mcGraph typarams typaramKinds methods)
    methods
-- #1103: the ARGUMENT-COVERAGE half of the rule is NOT method-only.  Its own
-- comment (below) says post-unify inspection cannot catch these shapes because
-- `unifyRowN`'s same-tail arm (`<e>` ~ `<Stdout | e>`) succeeds without
-- recording the atom anywhere — and that arm is reached from an ORDINARY
-- top-level arrow just as readily as from a method.  `launderArrow : (Unit ->
-- <Stdout | e> Unit) -> (Unit -> <e> Unit)` was accepted, and applying it to an
-- effectful callback produced a `Unit -> Unit` scheme that prints.  So the
-- coverage check runs over plain `DTypeSig` signatures too, with an EMPTY graded
-- scope (a non-interface signature has no graded typaram table — `scope` is the
-- only channel by which an abstract head can be row-kinded, see `rowArgNamesIn`).
-- ⚠️ Deliberately NOT widened alongside it: `undeterminedRetEffVars` (#784's
-- RETURN-only rule) stays interface-scoped — a top-level return-only effect var
-- is #797's separate territory, and the comment above says so.
checkUndeterminedRetEffVarsDecl mctx (DTypeSig _ n t _) =
  checkArgEffVarCoverage mctx None [] n t
checkUndeterminedRetEffVarsDecl mctx (DAttrib _ d) =
  checkUndeterminedRetEffVarsDecl mctx d
checkUndeterminedRetEffVarsDecl mctx _ = ()

checkIfaceMethodEffs : ModuleCtx ->
  String ->
  List (String, List Kind) ->
  List IfaceMethod ->
  Unit
checkIfaceMethodEffs mctx _ _ [] = ()
checkIfaceMethodEffs mctx iface scope ((IfaceMethod mname mty _ _) :: rest) =
  let _ = match undeterminedRetEffVars mctx scope mty
    [] => ()
    bad =>
      pushTypeErrorOnceAt
        mctx
        "T-EFFECT-UNDETERMINED"
        (firstTyLoc mty)
        (effectUndeterminedMsg iface mname bad)
  let _ = checkArgEffVarCoverage mctx (Some iface) scope mname mty
  checkIfaceMethodEffs mctx iface scope rest

-- The DUAL of the #784 rule, closing the adversarial review's break 4 (and the
-- argument-only variant): an effect var's ARGUMENT-position occurrences are
-- rows an impl can PERFORM by using that argument, so the method's own rows
-- must account for them.  Two ill-formed shapes, both rejected at the
-- interface declaration:
--   * argument-only — `use : a -> (Unit -> <e> Unit) -> Int`: e rides an
--     argument but no non-argument row, so an impl applying the callback
--     performs e with no row charging it (verified launder: a pure-typed
--     wrapper prints);
--   * uncovered atoms — `act1 : a -> (Unit -> <Stdout | e> Unit) -> <e> Unit`:
--     the callback's concrete <Stdout> pours into a row declared bare <e>,
--     which a caller instantiates to <> (verified launder).  Sound iff every
--     non-argument occurrence of e covers the union of its argument-side
--     atoms, IO-expanded (`<Stdout | e>` callback with `<Stdout | e>` return
--     is accepted; so is an `<IO | e>` return).
-- Post-unify inspection CANNOT catch these: the same-tail row-unification arm
-- (`<e>` ~ `<Stdout | e>`) succeeds without recording the atom anywhere, so
-- the declaration is the only seam with the information intact.
-- [iface] is `Some` the enclosing interface for a method signature and `None`
-- for an ordinary top-level `DTypeSig` (#1103); it selects the diagnostic's
-- wording and nothing else — the RULE is identical either way.
checkArgEffVarCoverage : ModuleCtx ->
  Option String ->
  List (String, List Kind) ->
  String ->
  Ty ->
  Unit
checkArgEffVarCoverage mctx iface scope mname mty =
  checkArgEffVars
    mctx
    iface
    mname
    mty
    (methodEffArgOccs mctx scope mty)
    (methodEffRetOccs mctx scope mty)
    (dedup (map fst (methodEffArgOccs mctx scope mty)))

-- 🚨 THE TWO ARMS HAVE DIFFERENT SCOPES, and [iface] is what selects between
-- them.  Both arms apply to an interface method (`Some iface`); only the
-- UNCOVERED-ATOMS arm applies to an ordinary top-level signature (`None`).
--
-- Why the ARGUMENT-ONLY arm is method-only.  Its hazard is "an impl uses the
-- argument and performs <e> with no row charging it", and at an INTERFACE
-- declaration the declaration really is the only seam — the impl arrives later,
-- and #1100's `gtake : f e a -> a` launders for exactly that reason.  A
-- DIRECT call to a top-level function does not get there: the CALL SITE rejects
-- it.  MEASURED, both shapes, on this build — the reason is the call site, NOT
-- the callee's body (a first pass at this comment claimed the body check caught
-- it and that was falsified: `use : (Unit -> <e> Unit) -> Int` with a body that
-- calls `f ()` checks CLEAN, reported as `use : (Unit -> Unit) -> Int`):
--   * callback arg — `use : (Unit -> <e> Unit) -> Int`, body `let _ = f ()`,
--     applied to an effectful `shout`: "Effectful value used where <> is
--     allowed, but it performs <Stdout>", at `use shout`;
--   * row-kinded ctor arg — `force : Box e a -> a` forcing its `Susp` thunk,
--     applied to `Susp loud`: the same diagnostic, at `force (Susp loud)`.
-- Applying the arm to top-level signatures anyway buys no soundness and rejects
-- every honest INSPECTOR of a row-kinded value — also measured: 34 declarations
-- in this compiler's own sources (`unInt : Value e -> Int`, `isPartial : Value e
-- -> Bool`, … which pattern-match a `Value e` and never invoke the closure
-- inside it) plus `stdlib/async.mdk`'s `isDone`/`forceVal`.  Nothing at a
-- declaration tells an inspector from a forcer; for a method that uncertainty IS
-- the hazard, for a directly-called function the call site settles it.
--
-- Why the UNCOVERED-ATOMS arm is NOT method-only (#1103).  Its hazard survives
-- the body check: `launderArrow : (Unit -> <Stdout | e> Unit) -> (Unit -> <e>
-- Unit)` with body `launderArrow f = f` type-checks, because `unifyRowN`'s
-- same-tail arm accepts `<Stdout | e>` against `<e>` without recording <Stdout>
-- anywhere (see this function's header comment).  Effect inference therefore
-- CANNOT catch it, and the declaration is the only seam here too.
checkArgEffVars : ModuleCtx ->
  Option String ->
  String ->
  Ty ->
  List (String, List Atom) ->
  List (String, List Atom) ->
  List String ->
  Unit
checkArgEffVars mctx _ _ _ _ _ [] = ()
checkArgEffVars mctx iface mname mty argOccs retOccs (v :: rest) =
  let vrets = filterList (o => fst o == v) retOccs
  let vatoms = flatMap snd (filterList (o => fst o == v) argOccs)
  let _ =
    if isEmptyL vrets then match iface
      Some i =>
        pushTypeErrorOnceAt
          mctx
          "T-EFFECT-ARG-UNCOVERED"
          (firstTyLoc mty)
          (argOnlyEffVarMsg i mname v)
      None => ()
    else match retOccsEscape mctx.mcGraph vatoms vrets
      [] => ()
      esc =>
        pushTypeErrorOnceAt
          mctx
          "T-EFFECT-ARG-UNCOVERED"
          (firstTyLoc mty)
          (argAtomsMsgFor iface mname v esc)
  checkArgEffVars mctx iface mname mty argOccs retOccs rest

-- first non-empty escape of the argument-side atoms against a non-argument
-- occurrence's declared atoms (IO-expanded via atomsEscape)
retOccsEscape : GraphCtx -> List Atom -> List (String, List Atom) -> List Atom
retOccsEscape gctx _ [] = []
retOccsEscape gctx vatoms ((_, declAtoms) :: rest) =
  if isNonEmptyL (atomsEscape gctx vatoms declAtoms) then
    atomsEscape gctx vatoms declAtoms
  else
    retOccsEscape gctx vatoms rest

-- effect-var occurrences (name, written atoms) inside ARGUMENT positions of a
-- method signature that an impl can PERFORM: rows of functions the impl can
-- CALL (odd contravariant depth) and row-kinded values it can RUN.  The
-- arrow's own row is NOT an argument position, and — round-2 adversarial
-- FP 7 — a row at EVEN depth (`((Unit -> <e> Unit) -> Int)` argument: the
-- impl receives a CONSUMER of e-callbacks and can only SUPPLY callbacks) is
-- excluded: the impl cannot perform e there, and a malicious effectful supply
-- pours its atoms into e's own cell where the post-unify atom check reads
-- them.
-- [scope] mirrors `methodEffRetOccs`' parameter of the same name exactly: the
-- graded typaram map of the interface whose method signature this type IS
-- (`declGradedScope`), and `[]` for every non-method signature.  Before #1100 the
-- ARGUMENT half took no scope at all, so an abstract head (`gtake : f e a -> a`)
-- resolved no row-kinded slot and raised no obligation, while the RETURN half —
-- which has had the scope channel since #822 — did.
methodEffArgOccs : ModuleCtx ->
  List (String, List Kind) ->
  Ty ->
  List (String, List Atom)
methodEffArgOccs mctx scope (TyConstrained _ t) = methodEffArgOccs mctx scope t
methodEffArgOccs mctx scope (TyEffect _ _ t) = methodEffArgOccs mctx scope t
methodEffArgOccs mctx scope (TyFun a b) =
  argPerformableOccs mctx scope True a ++ methodEffArgOccs mctx scope b
methodEffArgOccs mctx _ _ = []

-- One `(tail var, the row's written atoms)` occurrence per tail variable.  A
-- row is a JOIN when it names several (#821, `<Stdout | e | e2>`), and every
-- collector below reports them all: a caller reads the row at each var
-- independently, so a var left out would be a var nothing constrains.
occsOfTails : GraphCtx ->
  List String ->
  List EffAtomTy ->
  List (String, List Atom)
occsOfTails gctx tails labels =
  let atoms = atomsOfWritten gctx labels
  map (n => (n, atoms)) tails

-- rows in an argument subtree, collected only where [perf] (the impl can call
-- or run the value at this position); each arrow-LHS descent flips it.
argPerformableOccs : ModuleCtx ->
  List (String, List Kind) ->
  Bool ->
  Ty ->
  List (String, List Atom)
argPerformableOccs mctx scope perf (TyEffect labels tails t) =
  (if perf then occsOfTails mctx.mcGraph tails labels else [])
    ++ argPerformableOccs mctx scope perf t
-- A bare row atom (#997) carries its own tail var + labels directly (no
-- wrapped type to recurse into) — same treatment as the `TyEffect` arms
-- above.  Without this, a KRow ctor-arg written as `Box <Stdout | e> Int`
-- (as opposed to a bare `Box e Int`) was invisible to this collector, which
-- made the impl-body T-EFFECT-LAUNDER check over-fire on it (see
-- `effVarOccAtoms` below, which shares this gap).
argPerformableOccs mctx _ perf (TyRow labels tails _) =
  if perf then occsOfTails mctx.mcGraph tails labels else []
argPerformableOccs mctx scope perf (TyFun a b) =
  argPerformableOccs mctx scope (not perf) a
    ++ argPerformableOccs mctx scope perf b
argPerformableOccs mctx scope perf (TyTuple ts) =
  flatMap (argPerformableOccs mctx scope perf) ts
argPerformableOccs mctx scope perf (TyApp a b) = match tyAppSpine (TyApp a b)
  -- OCCURRENCE MINT (#1110/#1111 A-2.3): the head's acquired identity, read off
  -- the same record pattern as its name so the two cannot drift apart.
  (TyCon { tyConName = n, tyConOrigin = o }, args) =>
    krowSlotOccs mctx scope perf o n args
  -- #1100, the abstract-head half — symmetric with `rowArgNamesVarApp` on the
  -- RETURN side.  An interface typaram of graded kind, in scope, is row-kinded
  -- in exactly the same way a registered ctor's KRow slot is; without this arm
  -- `gtake : f e a -> a` collected NOTHING and the coverage rule never fired.
  (TyVar h, args) => krowSlotVarOccs mctx scope perf h args
  _ =>
    argPerformableOccs mctx scope perf a ++ argPerformableOccs mctx scope perf b
argPerformableOccs mctx scope perf (TyConstrained _ t) =
  argPerformableOccs mctx scope perf t
argPerformableOccs mctx _ _ _ = []

-- one ctor node: its bare row-kinded slots (if performable) + recurse the args
--
-- 🚨 THE SLOT'S ATOMS COME FROM THE HEAD'S DECLARATION, not from the use site.
-- This used to pad every performable KRow slot to `(e, [])` — "the impl can
-- perform `e` here and nothing else is guaranteed" — the ARGUMENT-side twin of
-- the blind pad #2110 removed from `methodEffRetOccs`.  On this side the pad is
-- not an over-rejection but a LAUNDER: for
--   `data Slot e = Slot (Unit -> <Stdout | e> Unit)`
-- a `Slot e` ARGUMENT lets the callee run a field the declaration guarantees
-- performs <Stdout> at EVERY instantiation, `Slot <>` included, so
--   `unslot : Slot e -> (Unit -> <e> Unit)`
-- under-claims: it hands back a function typed `<e>` that really performs
-- <Stdout>, and at `e := <>` the caller gets a pure-typed printer (measured —
-- `check` and `run` both exited 0 and the program printed).  Reading the
-- guarantee out of `dataParamRowAtomsRef` through `krowArgVarAtoms` — the same
-- table and the same walker the RETURN side already consults — makes those
-- <Stdout> atoms argument-side evidence, and the coverage rule ("every
-- non-argument occurrence of `e` covers the union of its argument-side atoms")
-- then rejects `unslot` while still accepting `widen : Slot e -> Slot e`, whose
-- return occurrence carries the same atoms.  Both halves are pinned:
-- `test/typecheck_error_fixtures/effect_arg_slot_launder.mdk` and its
-- `effect_arg_slot_unrelated_ok.mdk` accept-side twin.
-- ⚠️ A written-row slot (`Slot <Log | e>`) has its WRITTEN labels reported
-- twice — once here by `krowArgVarAtoms`, once by the `flatMap` below through
-- `argPerformableOccs`' `TyRow` arm.  Harmless, and NOT the return side's
-- double-count hazard: `checkArgEffVars` UNIONS the argument-side atoms
-- (`flatMap snd`), where the return side takes a first-non-empty escape and so
-- lets an atom-less copy veto a faithful one.
krowSlotOccs : ModuleCtx ->
  List (String, List Kind) ->
  Bool ->
  TyConOrigin ->
  String ->
  List Ty ->
  List (String, List Atom)
krowSlotOccs mctx scope perf o n args =
  match lookupTab (tyTabKey o n) mctx.mcCells.dataParamKindsRef.value
    Some kinds if listLen kinds == listLen args =>
      (if perf then
          krowArgVarAtoms
            mctx.mcGraph
            kinds
            (optionOr [] (paramRowAtomsOf mctx (tyTabKey o n)))
            args
        else
          [])
        ++ flatMap (argPerformableOccs mctx scope perf) args
    _ => flatMap (argPerformableOccs mctx scope perf) args

-- the ABSTRACT-HEAD sibling of `krowSlotOccs` (#1100): same shape, but the
-- kinds come from the graded typaram [scope] instead of `dataParamKindsRef`.
-- This is `rowArgNamesVarApp`'s counterpart on the argument side; a miss falls
-- through to the args exactly as `krowSlotOccs`' miss does.
-- An abstract head has no declaration to read, so its guarantee list is `[]`
-- and every slot still reports `(e, [])` — `krowArgVarAtoms kinds []` is the
-- old blind pad, occurrence for occurrence.  It is written this way rather than
-- left as the `map`, so the two arms stay ONE walker: the next atom fact an
-- abstract head can offer (a graded typaram's declared row, #820) lands in one
-- place instead of two.
krowSlotVarOccs : ModuleCtx ->
  List (String, List Kind) ->
  Bool ->
  String ->
  List Ty ->
  List (String, List Atom)
krowSlotVarOccs mctx scope perf h args = match lookupAssoc h scope
  Some kinds if listLen kinds == listLen args =>
    (if perf then krowArgVarAtoms mctx.mcGraph kinds [] args else [])
      ++ flatMap (argPerformableOccs mctx scope perf) args
  _ => flatMap (argPerformableOccs mctx scope perf) args

-- effect-var occurrences in NON-argument positions: each spine arrow's own row,
-- plus every occurrence inside the final return type (nested rows and bare
-- row-kinded ctor-arg slots).
--
-- 🚨 THE TWO TERMS OF THE LAST ARM CAN DESCRIBE THE SAME OCCURRENCE, and only
-- one of them carries its atoms.  For a return `Box <Stdout | e> Unit`,
-- `effVarOccAtoms` descends into the KRow slot's written row and reports
-- `(e, [Stdout])`; `rowArgAtomsIn` reports the same occurrence again, carrying
-- only what the HEAD'S DECLARATION guarantees at that slot (`(e, [])` for a
-- `Box` declared bare).  `retOccsEscape` takes the FIRST NON-EMPTY escape
-- over this list and does not dedupe, so the atom-less copy vetoes the faithful
-- one and an HONESTLY CHARGED declaration is rejected:
--   `widen : Box <Stdout | e> Unit -> Box <Stdout | e> Unit`
-- covers <Stdout> on both sides and must be ACCEPTED — it is the named
-- over-correction control in `test/typecheck_error_fixtures/
-- effect_index_unrelated_ok.mdk` (its header, "rejecting those instead would be
-- the obvious over-correction").  So a name `effVarOccAtoms` has already
-- reported is DROPPED from the padded term rather than added beside it.
-- ⚠️ This does NOT weaken any real rejection: the dropped entry is a strictly
-- less informative record of an occurrence still in the list, never an
-- occurrence the list would otherwise lose.  The rule stays "every non-argument
-- occurrence of e covers the union of its argument-side atoms"; this only stops
-- one occurrence from being counted twice, once with its labels erased.
-- Latent since the padded term was introduced — it mis-rejected interface
-- methods of this shape too, and #1103's widening to ordinary signatures is
-- merely what made it reachable from `effect_index_unrelated_ok.mdk`.
methodEffRetOccs : ModuleCtx ->
  List (String, List Kind) ->
  Ty ->
  List (String, List Atom)
methodEffRetOccs mctx scope (TyConstrained _ t) = methodEffRetOccs mctx scope t
methodEffRetOccs mctx scope (TyEffect labels tails t) =
  occsOfTails mctx.mcGraph tails labels ++ methodEffRetOccs mctx scope t
methodEffRetOccs mctx scope (TyFun _ b) = methodEffRetOccs mctx scope b
methodEffRetOccs mctx scope t =
  let occs = effVarOccAtoms mctx.mcGraph t
  occs
    ++ filterList
      (o2 => not (anyList (o => fst o == fst o2) occs))
      (rowArgAtomsIn mctx scope t)

-- The predicate: return-position effect tail vars minus argument-carried ones.
-- An effect var is argument-carried — hence soundly pinned at every call site —
-- ONLY by a ROW-KINDED occurrence in an argument. The test is kind-aware, NOT
-- name-based: a Row-kinded effect var and a Type-kinded type var may share a
-- spelling yet be independent variables, so a Type-kinded `e` in `List e` /
-- `Box e` pins NOTHING about the return row `<e>` — counting it would relaunder
-- the effect (#784). The two sound argument-carriers:
--   * a callback's latent arrow effect (`(a -> <e> b)`) — a Row-kinded effect
--     row, captured by effTailNames over each arg;
--   * a row-kinded type-CONSTRUCTOR argument (`Async e a`, where Async's first
--     param has kind Row) — captured by rowArgNames, which consults the ctor's
--     recorded param kinds (dataParamKindsRef) and takes ONLY the tyvars sitting
--     in a KRow slot. `List e`/`Box e` (Type-kinded param) contribute nothing.
-- An effect tail var in the RETURN row and in no such Row-kinded argument slot
-- is the laundering hazard (map/fold/traverse/`Async e a` are pinned;
-- `speak : a -> <e> String` and `speak : a -> List e -> <e> String` are not).
-- An abstract row-ctor arg (`r e a`, `r` a type variable) is conservatively
-- rejected — no real interface method has that shape, and matching it soundly
-- would need per-argument kind inference we do not run here.
undeterminedRetEffVars : ModuleCtx ->
  List (String, List Kind) ->
  Ty ->
  List String
undeterminedRetEffVars mctx scope sig =
  let args = methodArgs sig
  let argCarried =
    dedup (flatMap effTailNames args ++ flatMap (rowArgNamesIn mctx scope) args)
  let retTail = dedup (effTailNames (methodRet sig))
  removeAllS argCarried retTail

-- return type of a method: strip leading constraint wrappers and arrows, but
-- KEEP a trailing effect row so its tail var is visible (unlike methodArgs,
-- which peels it).
methodRet : Ty -> Ty
methodRet (TyConstrained _ t) = methodRet t
methodRet (TyFun _ b) = methodRet b
methodRet t = t

-- #822 (graded interfaces): an instance head must have the KIND the interface's
-- corresponding type parameter has.  A graded interface binds the whole row-indexed
-- FAMILY — `impl GThenable Async`, never a fixed row like `impl GThenable (Async e)`
-- (EFFECTS-SEMANTICS §6, DICT-SEMANTICS §3) — so the head's REMAINING parameter
-- kinds (its declared kinds minus the ones the head already applied) must equal the
-- interface slot's kinds.
--
-- This is a soundness guard, not polish.  A kind-mismatched head elaborates the
-- method type's KRow slot to a `TEff` row while the constructor's own scheme has a
-- plain tyvar in that position, and `unify` binds a tyvar to a TEff without
-- complaint: the impl would be ACCEPTED and its grade would mean nothing — every
-- index a caller reads off the result would be a fabrication.
--
-- Only interfaces that actually HAVE a graded slot are JUDGED — the `anyKRow want`
-- guard below is what does that, not the table: every slot of every interface is
-- recorded (it always was, and `ceRowParamKinds` keeps doing so), and an all-`KType`
-- row falls into the same `_ => ()` arm an outright miss does.  ⚠️ This paragraph
-- read *"only interfaces that actually HAVE a graded slot are inspected
-- (ifaceParamKindsRef records nothing else)"* until #1557 A-3.5c, and the
-- parenthetical was false of the retired table too.  Runs on BOTH whole-program
-- paths: its one call site is in checkBodyImpl, shared by Flat and Module,
-- immediately after `dataEnv` has populated the head-constructor kind table.
--
-- 🚨 #1557 A-3.5c: IT STILL ITERATES `prog`, AND THAT IS THE UNIT'S DEFINING
-- CONDITION, not an implementation detail.  The owner ruling that split A-3.5c
-- out of the A-3b lane (issue #1557, 2026-08-12) is CONDITIONAL: this check
-- qualifies as CE-only *"only if the graded impl-head kind check keeps
-- iterating `prog` rather than `IE.ieRows`"*.  The impl HEADS come from the
-- decl list; only the interface's declared slot kinds come from stage K's `CE`.
-- Whoever re-points this walk at `IE.ieRows` has re-classified the unit as A-3b
-- by construction — that is a routing decision, not a refactor.
checkGradedImplHeads : ModuleCtx -> ClassEnv -> Int -> List Decl -> Unit
checkGradedImplHeads mctx _ _ [] = ()
checkGradedImplHeads mctx ce cur (d :: rest) =
  let _ = checkGradedImplHeadDecl mctx ce cur d
  checkGradedImplHeads mctx ce cur rest

-- OCCURRENCE MINT (#1110/#1111 A-2.4): `implOrigin` is the identity the
-- interface NAME in `impl <iface> …` acquired at resolve — read off the same record
-- pattern as the name itself so the two cannot drift apart, exactly as A-2.3 reads
-- `tyConOrigin` beside `tyConName`.
checkGradedImplHeadDecl : ModuleCtx -> ClassEnv -> Int -> Decl -> Unit
checkGradedImplHeadDecl mctx ce cur (DAttrib _ d) =
  checkGradedImplHeadDecl mctx ce cur d
checkGradedImplHeadDecl mctx ce cur (DImpl { iface, tys, implOrigin = o, ... }) =
  checkGradedImplTys mctx ce cur o iface 0 tys
checkGradedImplHeadDecl mctx _ _ _ = ()

-- The `CE` lookup via `ceSlotKindsAt` uses ordinal filtering — the key is a RegKey
-- (`ifaceTabKey o iface` + slot position), identity-based not bare-name, preserving
-- the identity mint from A-2.4. Ordinals are assigned in dependency-first order,
-- matching the order the accumulator is grown in, so ordinal filtering and the
-- previous marshalled population agree. See
-- compiler/TYPECHECK-TARGET-ARCHITECTURE.md § "5. Decisions reopened, and decisions
-- deliberately kept" (A-3.5c) for the prior bare-name table this replaced and the
-- #1257 defect class it drains.
checkGradedImplTys : ModuleCtx ->
  ClassEnv ->
  Int ->
  TyConOrigin ->
  String ->
  Int ->
  List Ty ->
  Unit
checkGradedImplTys mctx _ _ _ _ _ [] = ()
checkGradedImplTys mctx ce cur o iface i (t :: rest) =
  let _ = match ceSlotKindsAt (regKeyOfTab (ifaceTabKey o iface)) cur i ce
    Some want if anyKRow want => checkGradedImplHead mctx iface t want
    _ => ()
  checkGradedImplTys mctx ce cur o iface (i + 1) rest

-- [want] is the interface slot's kind list.
--
-- Only a head whose kind is actually KNOWN is judged, and the two ways it can be
-- unknown are BOTH deliberate abstentions, not oversights:
--   * a type ALIAS head lives in aliasTableRef, never in dataParamKindsRef, and its
--     saturation is already policed by T-ALIAS-ARITY — a kind complaint here would be
--     a second, worse-worded report of the same defect;
--   * a head absent from dataParamKindsRef entirely — a builtin like `Int`, whose kinds
--     this compiler records nowhere.  Abstaining costs nothing real: a genuinely wrong
--     head still fails on its method bodies, where the mismatch is concrete and located.
--     ⚠️ An ABSTRACTLY-exported data type (`export data Asy e a`) USED to land here too,
--     cross-module, and the abstention was load-bearing for it: judging it reported a
--     correct program rejected and told the author to add a `Row` parameter the type
--     ALREADY HAD.  #804/#1028 fixed that at the source — an opaque type's kinds are
--     published cross-module (`kindPublicDataDecl`'s `VisAbstract` arm; it was
--     `registerOpaqueParamKinds` until A-3.2b retired the kind universe) — so an
--     abstract head is now judged on its REAL kinds like any other, and this arm no
--     longer covers for it.
-- A head that is not a TyCon spine at all is judged where it can be: a saturated
-- TUPLE is kind `Type`, which is never a graded slot's kind, so it is reported; a bare
-- tyvar head carries no kind and is left to the checks that already reject it.
checkGradedImplHead : ModuleCtx -> String -> Ty -> List Kind -> Unit
checkGradedImplHead mctx iface t want = match tyAppSpine t
  (TyCon { tyConName = n, tyConLoc = loc, tyConOrigin = o }, applied) =>
    checkGradedImplHeadCon mctx iface o n loc (listLen applied) want
  -- A saturated tuple is kind `Type`, which is never a graded slot's kind.  It gets its
  -- OWN remedy: the generic "give it a Row parameter" advice is nonsense for a tuple —
  -- you cannot add one.  ⚠️ The span is best-effort: `TyTuple` carries no loc of its own
  -- and `TyVar` carries none either, so `impl I (a, b)` genuinely has no span to point at
  -- and reports unlocated.  Fabricating a nearby one would be worse than saying nothing.
  (TyTuple ts, _) =>
    pushTypeErrorOncePerSite
      mctx
      "T-IMPL-KIND-MISMATCH"
      (firstTyLocList ts)
      (implTupleHeadKindMsg iface (listLen ts) want)
  _ => ()

checkGradedImplHeadCon : ModuleCtx ->
  String ->
  TyConOrigin ->
  String ->
  Option Loc ->
  Int ->
  List Kind ->
  Unit
checkGradedImplHeadCon mctx iface o n loc nApplied want =
  match headRemainingKinds mctx o n nApplied
    None => ()
    Some got => checkGradedImplHeadKinds mctx iface n loc nApplied want got

-- The head constructor's declared parameter kinds MINUS the ones the head already
-- applies (`impl I (Async e)` supplies one).  `None` = "this head's kind is not
-- knowable here" (an alias or a builtin), which the caller treats as an abstention.
-- ⚠️ An abstractly-exported type was in that bucket until #804/#1028 and is NOT any
-- more — `kindPublicDataDecl`'s `VisAbstract` arm gives it a real `dataParamKindsRef`
-- entry (via `declEnvSeedChain`), so it returns `Some` and is judged exactly like
-- a `public export` one.
-- `key` is minted ONCE and shared by both guard arms via the `where` (#1111
-- A-2.3 follow-up): the first guard ALWAYS evaluates it (Medaka is strict, and
-- a `where` scoping over guard arms lowers to `ELetGroup (..key..) (EGuards
-- arms)`, so the binding runs once before either arm is tested), so hoisting
-- adds nothing on the alias arm and removes the previously-redundant second
-- mint on the common `otherwise` arm.  A redundant-allocation removal, not a
-- measured perf win (`test/bench.sh` doesn't run on this box, #1187; the
-- perf-scaling gate grades a growth ratio, blind to a constant factor).
headRemainingKinds : ModuleCtx ->
  TyConOrigin ->
  String ->
  Int ->
  Option (List Kind)
headRemainingKinds mctx o n nApplied
  | isSome (lookupTab key mctx.mcCells.aliasTableRef.value) = None
  | otherwise =
    map (drop nApplied) (lookupTab key mctx.mcCells.dataParamKindsRef.value)
  where
    key = tyTabKey o n

checkGradedImplHeadKinds : ModuleCtx ->
  String ->
  String ->
  Option Loc ->
  Int ->
  List Kind ->
  List Kind ->
  Unit
checkGradedImplHeadKinds mctx iface n loc nApplied want got
  | kindsEq got want = ()
  | otherwise =
    pushTypeErrorOncePerSite
      mctx
      "T-IMPL-KIND-MISMATCH"
      loc
      (implKindMismatchMsg iface n nApplied want got)

-- Closure construction is pure; only the source body's final application runs it.
arrowsWithLastEffect : List Mono -> EffRow -> Mono -> Mono
arrowsWithLastEffect params eff result = bodyArrows params eff result

-- The signature the declared-row walks below read: every alias on the return
-- spine expanded, so the declared row is the row `fromAstTypeE` elaborates.
-- `d : Tick` with `type Tick = Int -> <Stdout> Unit` declares `<Stdout>`, and
-- so do `v : S` and `f : Int -> S` with `type S = <Stdout> Int`
-- (`writtenBindingForce`, `returnRowE`).  An alias that expands to any other
-- type stays unexpanded, since it carries no row to read.
expandReturnSpine : ModuleCtx -> Ty -> Ty
expandReturnSpine mctx ty = match expandAliasHeadTy mctx ty
  TyFun a ret => TyFun a (expandReturnSpine mctx ret)
  TyConstrained cs t => TyConstrained cs (expandReturnSpine mctx t)
  row@(TyEffect _ _ _) => row
  _ => ty

-- the declared concrete effect set of a signature: labels on the first `<…>`
-- reached walking down the return side (Phase 79e escape check)
declaredEffects : GraphCtx -> Ty -> List Atom
declaredEffects gctx (TyFun _ ret) = declaredEffects gctx ret
declaredEffects gctx (TyEffect effs _ _) = atomsOfWritten gctx effs
declaredEffects gctx (TyConstrained _ t) = declaredEffects gctx t
declaredEffects gctx _ = []

-- #797: the TAIL of that same first `<…>` — the field `declaredEffects` drops.
-- No names is a genuinely CLOSED row (`<>`, `<Stdout>`); one or more is an OPEN
-- one (`<e>`, `<Stdout | e>`, `<Stdout | e | e2>`).  Arms mirror
-- `declaredEffects` exactly, stopping at the same node, so the two always
-- describe ONE row.
declaredEffectTail : Ty -> List String
declaredEffectTail (TyFun _ ret) = declaredEffectTail ret
declaredEffectTail (TyEffect _ tail _) = tail
declaredEffectTail (TyConstrained _ t) = declaredEffectTail t
declaredEffectTail _ = []

-- #797: effect-tail names occurring in ARGUMENT positions of the signature,
-- walking the same return spine `declaredEffects` walks and stopping at the same
-- node.  A name here is one the CALLER also constrains, so the declared return
-- row is not free even though it is syntactically open.
--
-- ⚠️ Deliberately BROADER than `methodEffArgOccs`: that collector answers "can
-- the BODY perform this row" and so excludes an even-contravariant-depth
-- occurrence (`((Unit -> <e> Unit) -> Int)`).  The question here is the
-- different one "does the caller pin this var", for which ANY argument-side
-- occurrence counts — an even-depth `e` is still unified with the caller's
-- chosen row.  `effTailNames`' documented name-based over-counting (`List <e>`)
-- is likewise conservative in the safe direction here: it can only make a row
-- read as argument-carried, i.e. keep the pre-#797 rejection, never widen.
declaredArgEffNames : ModuleCtx -> Ty -> List String
declaredArgEffNames mctx (TyFun a ret) =
  effTailNames a ++ rowArgNames mctx a ++ declaredArgEffNames mctx ret
declaredArgEffNames mctx (TyConstrained _ t) = declaredArgEffNames mctx t
declaredArgEffNames mctx _ = []

-- #797: is the declared return row genuinely OPEN — a free tail var that appears
-- NOWHERE on the argument side?  Such a var is chosen by nothing but the callee's
-- own body: `f : Int -> <e> String` means "f performs whatever it performs", so a
-- body performing <Stdout> is not an escape and must not be reported as one.
-- An argument-carried var (`g : (Int -> <e> Int) -> <e> Int`) is NOT open in this
-- sense — the caller instantiates it, so a body adding <Stdout> would launder,
-- and the pre-existing escape rejection stands unchanged.
-- A JOIN is open when SOME member is free of the argument side: that member
-- alone already admits whatever the body performs.
declaredEffectsOpen : ModuleCtx -> Ty -> Bool
declaredEffectsOpen mctx ty =
  let argNames = declaredArgEffNames mctx ty
  anyList (v => not (contains v argNames)) (declaredEffectTail ty)

-- Keyed indices — so the hot per-field-access read paths never walk a linear registry
-- (issue #149).  #415 item 3: `registerRecordInfoKeyed` is the sole REGISTRATION writer of
-- both; they are cleared together by `freshModuleCtx`; and the cross-module record floor is
-- loaded by `loadDataUniverse` from `universeRecordPop`.
--
-- 🚨 THE LOCKSTEP WAS "STRUCTURAL, NOT AN OBLIGATION" UNTIL #1111 A-2.12 (#1319 unit 2),
-- AND IT IS NOW AN OBLIGATION.  `applyRecordScopeOverrides` re-points `recordByNameRef`
-- for a collided key and does NOT touch `fieldOwnersRef`, so the two are no longer written
-- only in pairs and nothing enforces that they agree.  Re-pointing key `K` cannot change
-- which KEYS own a field name, but it does change which FIELDS `K` declares — so with two
-- same-named records having DISJOINT field sets, `fieldOwnersRef` can name `K` as the owner
-- of a field the newly-selected `K` does not declare.
-- ⚠️ THAT IS NOT HYPOTHETICAL AND AN EARLIER DRAFT OF THIS NOTE SAID IT WAS.  It called the
-- divergence "an obligation with no observed consequence" on the strength of one probe that
-- kept every projection inside the module which NAMED the record — where the overlay and the
-- floor agree by construction, so the probe could not have shown anything.  **#1377 was the
-- consequence**: a module naming one `Cfg` and holding a value of the other was refused.
-- 🚨 #1319 UNIT 3 DRAINED #1377, AND THE OBLIGATION SURVIVES IT.  Unit 3 did not reconcile
-- the two tables; it stopped ASKING the overlay a question the overlay could not answer —
-- `resolveFieldRecord`'s arm (a) now selects by the receiver's identity (see
-- `lookupRecordForReceiver`).  So the one observed consequence is gone and the write
-- asymmetry is not.  ⚠️ Do NOT restate this as "no observed consequence today": that exact
-- sentence has now been wrong twice here, and what is true is narrower — the consequence
-- that was found has been removed, and nobody has established that it was the only one.
-- Anything added here must state which of the two it writes and why the other is safe.
--   recordByNameRef : registry KEY → RecordInfo.  omInsert is last-write-wins and
--     the register site inserts in registration order, so it reproduces the old
--     prepend-list first-match (latest-registered wins) for lookupRecordByName.
--   fieldOwnersRef  : field name → the registry keys whose RecordInfo declares it
--     (a multimap).  fieldOwnerNames still `sortUniqS`es this so the owner-list
--     order that feeds ambiguousFieldMsg/head stays byte-identical.

-- Transparent type aliases (`type Foo = Int`, `type Pair a = (a, a)`).  Keyed by
-- alias name → (params, RHS surface type).  Populated in a pre-pass by
-- `registerData`'s DTypeAlias arm (mirrors `dataParamKindsRef`); consulted
-- on-demand at the `Ty→Mono` seam (`fromAstTypeE`) to expand an alias to its RHS.
-- The param list is stored even though stage 2 only expands the zero-param case,
-- so parameterized expansion (stage 3) can extend this without reshaping the table.

-- Names of record/named-field types exported ABSTRACTLY (`export data`/`export
-- record` without `public`).  Seeded ONCE (over EVERY module's decls, prelude
-- included) by the multi-module check drivers, BEFORE per-module checking, and
-- deliberately NOT cleared by `freshModuleCtx` — it is whole-program metadata, not a
-- per-module accumulator.  An abstract export brings the type NAME into scope but
-- never registers its fields (publicDataDecls drops VisAbstract decls, so they never
-- reach the record registry in an importer — its PARAM KINDS do travel, since #804/#1028, via
-- kindPublicDataDecl's VisAbstract arm, but a kind is not a field).  A dot-access on
-- such a type therefore lands at resolveFieldRecord's `head known but no record
-- info` branch with the type name still recoverable as the receiver's head tycon;
-- membership here distinguishes that case (clear abstract-export diagnostic) from a
-- genuinely-unknown field on an unbound receiver (the `<unknown>` message).  This
-- mirrors resolve's destructure-side AbstractFieldAccess signal (env.types ∋ owner
-- ∧ owner owns no field) without threading anything new through the import seed.

-- collect the names of all VisAbstract record-shaped (a DData whose variants
-- carry named fields) decls across the given decl list.  Only
-- record-shaped abstract types can be a dot-access receiver, but harvesting any
-- abstract DData name too is harmless (a positional ADT can't reach the abstract
-- branch with a field access — its fields never exist).
collectAbstractRecordTypes : List Decl -> List String
collectAbstractRecordTypes [] = []
collectAbstractRecordTypes ((DData { dataVis = VisAbstract, dataName = n }) :: rest) =
  n :: collectAbstractRecordTypes rest
collectAbstractRecordTypes (_ :: rest) = collectAbstractRecordTypes rest

-- seed abstractRecordTypesRef from every module's decls (the per-module progs plus
-- the prelude/core decls), once, before checking begins.  Keyed by the type
-- word (`typeTagOf`), so a program's own type that shares an abstract export's
-- name is not mistaken for it.
seedAbstractRecordTypes : GraphCtx ->
  List Decl ->
  List (String, List Decl) ->
  Unit
seedAbstractRecordTypes gctx coreDecls modules =
  let abstracts =
    collectAbstractRecordTypes coreDecls
      ++ flatMap (m => abstractTypeWords (fst m) (snd m)) modules
  gctx.abstractRecordTypesRef := namesToSet abstracts omEmpty

abstractTypeWords : String -> List Decl -> List String
abstractTypeWords mid decls =
  map (n => typeTagOf (OriginModule mid) n) (collectAbstractRecordTypes decls)

siteObligation : GoalKind -> Ref Inner -> PendingEntry -> Obligation
siteObligation k inner (PendingEntry name tagRef m encl site loc scope ev) = Obligation {
  oKind = k,
  oDest = EvRoute tagRef,
  oEv = ev,
  oEncl = encl,
  oLoc = loc,
  oScope = scope,
  oPayload = GPSite name m site,
  oInner = inner,
}

-- [inner] is the destination's summary: the method cell's `ecInner` when [e]'s route
-- ref is a cell's, a fresh one otherwise.
pushSiteGoal : GraphCtx -> GoalKind -> Ref Inner -> PendingEntry -> Unit
pushSiteGoal gctx k inner e = pushGoal gctx (siteObligation k inner e)

-- an arithmetic operator site: only its operand mono and its route cell
pushArithGoal : ModuleCtx -> Ref Route -> Mono -> EvId -> Unit
pushArithGoal mctx dref m ev = pushGoal mctx.mcGraph Obligation {
  oKind = GKArithSite,
  oDest = EvRoute dref,
  oEv = ev,
  oEncl = "",
  oLoc = None,
  oScope = captureScope mctx (),
  oPayload = GPArith m,
  oInner = Ref innerNone,
}

pushMethodDictGoal : GraphCtx -> PendingMethodDict -> Unit
pushMethodDictGoal gctx pmd = pushGoal gctx Obligation {
  oKind = GKMethodDict,
  oDest = EvRoutes pmd.pmdRoutesRef,
  oEv = pmd.pmdEv,
  oEncl = pmd.pmdEncl,
  oLoc = None,
  oScope = pmd.pmdScope,
  oPayload = GPMethodDict pmd,
  oInner = pmd.pmdInner,
}

pushRecDictAppGoal : GraphCtx -> RecDictApp -> Unit
pushRecDictAppGoal gctx (r@(RecDictApp routesRef _ encl _ scope ev)) = pushGoal
  gctx
  Obligation {
    oKind = GKRecDictApp,
    oDest = EvRoutes routesRef,
    oEv = ev,
    oEncl = encl,
    oLoc = None,
    oScope = scope,
    oPayload = GPRecDictApp r,
    oInner = Ref innerNone,
  }

-- return-position method sites discovered during inference: (method name, the
-- EMethodAt route ref to fill, the EMethodAt impl-dicts ref to fill, the method's
-- result mono).  After the whole program is inferred, each result mono's head
-- tycon is the concrete impl tag the site dispatches to (RKey) — or, when it is a
-- constrained function's constraint variable, that function's dict parameter
-- (RDict).  The impl-dicts ref is filled (single-module elaborate path only) when
-- the route is a parametric impl with a `requires` — one route per requires.
-- #156 S3a: entries are `PendingEntry`s of kind `SKReturn`.

-- Phase 151 / Gap G: comparison/equality OPERATOR sites discovered during
-- inference: (method name, the EBinOp route ref to fill, the operand mono).
-- After inference resolveBinopSites stamps each ref with the resolved Eq/Ord impl
-- route (RKey) — but ONLY when the operand grounds to a NON-primitive type; the
-- structural-builtin EBinOp eval path handles primitive / ungroundable operands
-- (so `eq a b = a == b` on Int never recurses).  dictPass then rewrites the
-- stamped node into the method application.
-- (method, route ref, operand mono, inImpl-flag, enclosing-fn name).  The 5th
-- field is currentFn at record time: for a TOP-LEVEL constrained fn an operator on
-- its own constraint var routes RDict $dict_<encl>_<slot> (via enclDictVarOf), the
-- operator analogue of the direct `eq x y` arg-stamp path.
-- #156 S3a: entries are `PendingEntry`s of kind `SKOp`.

-- Roadmap #18c: the EUnOp analogue of pendingBinopSites — `-` (Num's `negate`)
-- sites discovered during inference.  Same tuple shape/fields, same resolve/
-- rewrite seam (resolveUnopSites / rewriteUnopExpr), one operand instead of two.

-- Arithmetic EBinOp sites whose operand type may ground to a concrete primitive.
-- Recorded during inference (operand Mono + the node's route ref);
-- resolveArithSites reads each solved Mono after the whole module is inferred and
-- stamps its supported scalar tag so lowering carries the result type into
-- CBinPrim and the native emitter need not recover it from operand structure. A still-
-- polymorphic (Num a) operand never grounds → stays RNone → today's dict path
-- (mirrors resolveBinopSite's grounded-only guard, so dict-routed arithmetic is
-- untouched).

-- Error-path BLOCKER B4 (audit finding D3): missing-impl dispatch obligations.
-- `methodEntryHere` maps each interface method NAME → (iface, the iface's typarams,
-- the method's declared AST type), as the reading module's scope resolves it
-- (`methodScopeAt`).  At each EVar/EMethodAt occurrence of a
-- registered method, recordImplObligation captures the OCCURRENCE mono so that,
-- after inference, checkImplObligations can read what the interface params
-- resolved to (parallel-walking the declared type against the normalized
-- occurrence mono) and reject the call when those concrete head types have NO
-- matching impl in the program (the `No impl of … for …` reject).  Skips while a param is still a
-- polymorphic tyvar (deferred to the caller).
-- A bare-name collision between two unrelated interfaces is decided by the reading
-- module's scope, never by registration order (#1092) — see `MethodEnv`.

-- C5 (TYPECHECK-AUDIT / Phase 112): names that are BOTH an interface method AND a
-- cross-module-imported standalone top-level function (e.g. box's `toList`/`isEmpty`
-- shadowing Foldable's).  Populated per module by elabModuleStamp from the full graph
-- (a top-level funDef name that is also a method name and is NOT defined in the
-- current module).  resolveSite consults it: a method site at a concrete receiver
-- with NO impl, whose name is here, routes RLocal (eval reads the standalone) instead
-- of RKey<head> (which would panic with no impl).
-- `freshModuleCtx` starts it empty; `checkBodyImpl` rebuilds it per module.

-- DEFINER-shadow names (facet 2): the names THIS module declares as a top-level
-- funDef that ALSO name an interface method (buildDefinerShadows) — e.g. a user
-- `eq : List Int -> List Int -> Bool`.  A DIRECT call `eq [1] [2]` in user code
-- must resolve to the user's OWN definition (RLocal), NOT to a method impl, even
-- when the receiver's head HAS an impl of the interface (`List` has `Eq`).  The
-- arg-stamp pass would otherwise stamp `RKey:List` (the impl), making the eval path
-- dispatch to the prelude `Eq (List a)` impl (`[1] ≠ [2]` → False) instead of the
-- user's fn (True) — a run≠build divergence (the EMIT path already routes to the
-- user's def).  resolveRLocalSite stamps these RLocal unconditionally.  Populated
-- per-module in checkModuleFullImpl from buildDefinerShadows; reset by `freshModuleCtx`.

-- P0-19: the declared top-level SIGNATURES of definer-shadow standalones
-- (`size : Int -> Int`), keyed by name.  When a definer-shadow occurrence resolves
-- to the STANDALONE (no visible impl for the grounded receiver, or an ungrounded
-- receiver), inferDefinerShadowApp enforces this declared domain against the actual
-- argument — closing the S2/S5 "must then type against the standalone's domain" hole
-- that let `size "hi"` / a poly wrapper `useIt x = size x; useIt (Box 3)` type against
-- the permissive method scheme and reach codegen as garbage.  Set per-path from
-- `sigsOf prog`; empty for an unsignatured standalone (no domain to enforce → the old
-- permissive behavior, unchanged).

-- P0-19 d4b (S4): True while inferring the HEAD of a definer-shadow APPLICATION
-- (`size (Box 3)`) — set around the head-infer call in inferDefinerShadowVarApp /
-- inferDefinerShadowApp.  A shadow occurrence reaches inferVar / inferMethodAt in
-- two shapes: as an application head (dispatch-vs-standalone decided per-receiver by
-- the surrounding shadow-app machinery, so the head must keep the permissive METHOD
-- scheme `a -> Int`) OR in bare VALUE position (`map size xs`, `let f = size`), which
-- S4 says ALWAYS denotes the standalone.  This flag distinguishes the two so only the
-- value-position occurrence is pinned to the standalone scheme.  Default/reset False.

-- P0-18 (EMIT path only): the mangler (`mangleUnits`) renames a definer-shadow
-- standalone def + its call sites to `<mid>__name` BEFORE marking, but (correctly)
-- leaves the interface method name bare — so the mark pass's NAME-based shadow
-- detector (buildStandaloneShadowsGraph / buildDefinerShadows, keyed on
-- funDef-name ∩ iface-method-name) no longer sees a shadow and the occurrence never
-- becomes an `EMethodAt` dispatch site (→ a silent direct call to the standalone =
-- the build miscompile).  elaborateModules recovers the shadow post-mangle by
-- forward-constructing `mangledName mid method` for every (module, iface-method)
-- pair and checking it against the module's actual funDef names; each hit is a
-- `(mangledSymbol ↦ bareMethod)` entry recorded here.  The mark pass then (a) marks
-- the mangled occurrence `EMethodAt` with the BARE dispatch name (so `implFor` finds
-- the impl for a receiver that HAS one) and (b) carries the mangled symbol in the
-- route's `RLocal <symbol>` fallback for a receiver that does NOT.
-- #2809 RETIRED THE "EMPTY OFF THE EMIT PATH" INVARIANT.  Mangling now runs AFTER
-- elaboration, so NO path reaches this map with mangled funDefs and the rows every path
-- gets are the BARE ones `unitMangledShadows` adds: `(name ↦ name)` for a definer
-- shadow, in every module of the graph.  Both spellings are still recorded there, so
-- (a) and (b) above read the same way; what changed is that the SYMBOL half is now the
-- bare standalone name and the rename that moves it runs later.  A consumer must no
-- longer treat a non-empty map as "this is the emit path".
-- Set once at the top of elaborateModules;
-- deliberately NOT cleared by `freshModuleCtx` (checkModuleFullImpl's per-module `freshModuleCtx`
-- must not wipe it mid-graph) — the forward-construction membership check makes a
-- stale value inert (no funDef matches → no entry).

-- ── #2809: the seed's ROUTE half and its TYPING half are different questions ──
-- `routeLocalSym` above is the ROUTE half: the symbol the emitter must call, which
-- `mangleRoute` renames once mangling runs.  Every reader below that instead asked
-- "is this occurrence a standalone shadow whose bare name no longer denotes the
-- standalone?" used a non-empty `routeLocalSym` as its answer, and that reading was
-- sound only while the seed was `<mid>__name` — a spelling that existed on the emit
-- path and nowhere else.  With mangling moved after elaboration the seed is the BARE
-- standalone name on EVERY path, so a seed equal to the occurrence's own method name
-- recovers nothing: the un-mangled classifiers (`definerShadowNamesRef`,
-- the standalone scheme carried by the env binding) already answer it, and reading
-- it as the old signal changed what `check` reports — measured on
-- `test/run_check_agreement_fixtures/s1_constrained_shadow_dispatch.mdk`, whose
-- specified `No impl of Num for Box` (clause S9's reject direction, named in the
-- fixture's own header) became `Type mismatch: Int literal vs Box` because the
-- standalone-domain enforcement below is gated on this test.
-- So: this is the RECOVERED-SYMBOL half — "" whenever the seed is just the bare name —
-- and every TYPING decision keys on it, while the route stamp keeps `routeLocalSym`.
recoveredShadowSym : String -> Ref Route -> String
recoveredShadowSym name tagRef =
  let s = routeLocalSym !tagRef
  if s == name then "" else s

-- one entry per occurrence of a registered interface method: (iface, typarams,
-- declared method Ty, the occurrence's instantiated mono).  Resolved post-inference.
-- B.10.2c: the 5th element is the enclosing construct's span (`mcLoc`) snapshotted
-- at the RECORD site (during inference, when the construct is live), so the post-HM
-- obligation check (checkImplObligations) can pair a `No impl of …` reject with
-- the offending expression's range — captured at record time
-- rather than reading the stale global at the post-HM raise.

-- PERF: the obligation list's length, in O(1).  That list grows with every
-- constrained occurrence in the program and is NEVER trimmed, yet each top-level
-- group brackets its inference with a length-before / length-after pair to recover
-- the obligations IT added (they are consed on the front, so `wWindow` recovers
-- them).  Measuring that length by walking the list was O(N) over an O(N) list once
-- per group — O(N²), and the single hottest symbol in the typecheck stage on a large
-- file.  #841 ports this channel onto `Windowed` (see `implObls` below): `wPush`,
-- the per-module `ModuleCtx` mint, and `wRestore` (checkMethodBodyAgainst's error
-- rollback) are its only mutators, so the list and its length can no longer drift.

-- The one and only way to add an obligation.  #991: this channel now stores the SAME
-- `UObligation` record the call channel does, with a real `Provenance` and an
-- `OpMethodOcc` projection carrying the (typarams, declared method type, occurrence
-- mono) triple the check-time `dispatchMonosOf` needs (see `OblProjection`).  The
-- pre-#838 5-tuple, and the `implOblToU` bridge that converted it, are gone.
pushPendingObl : ModuleCtx ->
  IfaceRef ->
  List String ->
  Ty ->
  Mono ->
  List (String, Mono) ->
  Provenance ->
  Option Loc ->
  Unit
pushPendingObl mctx iface typarams mty occ omitted prov loc =
  wPush
    mctx.mcCells.implObls
    (mkMethodOccObl
      iface
      typarams
      mty
      occ
      omitted
      prov
      loc
      (captureScope mctx ()))

pushExactReturnObl : ModuleCtx -> MethodReturnRequest -> Unit
pushExactReturnObl mctx request = wPush mctx.mcCells.implObls UObligation {
  pred = Predicate { iface = request.mrrIface, args = [] },
  originId = 0,
  prov = PMethodOcc,
  loc = request.mrrLoc,
  uoScope = request.mrrScope,
  oblProj = OpExactReturn request,
}

methodReturnRequest : ModuleCtx ->
  MethodSchemeRow ->
  Mono ->
  MethodInstantiationSubst ->
  Option EvId ->
  MethodReturnRequest
methodReturnRequest mctx row occurrence subst goalEv =
  let loc = mctx.mcLoc
  let scope = captureScope mctx ()
  let qualifiedBody = match row.msrScheme
    Forall _ _ _ _ _ body =>
      substMono
        mctx.mcGraph
        subst.misTypeSubst
        subst.misEffectSubst
        subst.misAuthSubst
        body
  let omitted =
    if methodPredicateTemplateHasAbsent row.msrPredicateTemplate then
      omittedParamVars mctx row.msrTyparams row.msrType
    else
      []
  MethodReturnRequest {
    mrrIface = row.msrIface,
    mrrName = row.msrName,
    mrrTyparams = row.msrTyparams,
    mrrType = row.msrType,
    mrrOccurrence = occurrence,
    mrrEnclosing = mctx.mcCells.currentFn.value,
    mrrLoc = loc,
    mrrScope = scope,
    mrrGoalEv = goalEv,
    mrrQualifiedBody = qualifiedBody,
    mrrPredicateTemplate =
      instantiateMethodPredicateTemplate
        mctx.mcGraph
        row.msrPredicateTemplate
        subst,
    mrrOmitted = omitted,
    mrrResolution = Ref None,
  }

-- the mint for an impl-channel obligation.  `pred.args` is EMPTY and must stay so:
-- the dispatch vector is `OpMethodOcc`'s to project, at check time, via `uOblArgs`.
mkMethodOccObl : IfaceRef ->
  List String ->
  Ty ->
  Mono ->
  List (String, Mono) ->
  Provenance ->
  Option Loc ->
  ScopeId ->
  UObligation
mkMethodOccObl iface typarams mty occ omitted prov loc scope = UObligation {
  pred = Predicate { iface = iface, args = [] },
  originId = 0,
  prov = prov,
  loc = loc,
  uoScope = scope,
  oblProj = OpMethodOcc typarams mty occ omitted,
}

pushNumLitObl : ModuleCtx ->
  ClassPredicate ->
  Mono ->
  Option Loc ->
  ScopeId ->
  Unit
pushNumLitObl mctx predicate occurrence loc scope = wPush
  mctx.mcCells.implObls
  UObligation {
    pred = Predicate {
      iface = predicate.predicateInterface,
      args = predicate.predicateArguments,
    },
    originId = 0,
    prov = PNumLit,
    loc = loc,
    uoScope = scope,
    oblProj = OpNumLit occurrence,
  }

-- PLAN.md #11: one entry per source integer literal (ENumLit):
-- (litVar, fref, n, dref).  [litVar] is the literal's fresh Num-obligated type var;
-- [fref] is the node's own Option Float cell; [n] the int value; [dref] is the
-- node's `fromInt`-route cell (filled by resolveSites — the literal is modelled as a
-- `fromInt n` method occurrence).  After defaulting + grounding, the post-HM pass
-- setNumlitFloats decides the runtime rep: litVar ground Float ⇒ fref Some, dref cleared ⇒ ELit (LFloat f);
-- litVar ground Int ⇒ both cleared ⇒ ELit (LInt n); litVar still polymorphic `Num a`
-- (the soundness case — `1` in `inc x = x + 1`) ⇒ dref KEPT (RDictFwd onto the
-- enclosing Num dict) ⇒ dictPass emits `EApp (EMethodAt "fromInt" …) (ELit (LInt n))`.

-- Chunk A (error framing): the union-find root ids of every type var that took
-- part in a unification failure (`typeMismatch`).  Consulted ONLY by
-- `undeterminedGoalExempt` to SUPPRESS a secondary `ambiguous instance`
-- cascade on a var the primary mismatch already explained — never read on the
-- inference path, so a well-typed program (no mismatch) never poisons anything
-- and behaves identically.

-- Chunk D (Num mis-framing): (litVar, loc) for every numeric literal whose var
-- carried a Num obligation — captured at inferNumLit/inferNumLitBare record time
-- while the var is still unbound.  Lets checkOneImplObligation reframe a purely
-- literal Num obligation forced to a concrete non-Num type (`Type mismatch: Int vs
-- T`) while an OPERATOR-sourced one (`x + 1`) keeps `No impl of Num for T`.  Storing
-- the VAR (not just the loc) lets the operator-taint pass below share a root through
-- `normalize`, so `1 + x` and `x + 1` are both recognised as operator-sourced
-- regardless of unify direction.  Error-path only; reset per run.

-- PERF: the literals that are NOT YET operator-tainted.  `markNumlitOpTaint` scans
-- THIS instead of the full `numlitVarLocs` (which is never trimmed).  Sound because
-- tainting is idempotent: it appends a loc to `numlitOpLocs`, whose only reader
-- (`numlitReframeLoc`) does a membership test — so re-tainting an already-tainted
-- literal cannot change any outcome, and a tainted literal may leave the worklist.
-- Scanning EVERY literal ever recorded on EVERY arithmetic operand was O(N²), and
-- after the allocation fix (see `rootIdOf`) it was still the typecheck stage's
-- dominant remaining cost on a large file.
--
-- `numlitVarLocs` itself keeps every literal — `numlitReframeLoc` and
-- `tagLitLocsWithRoot` both still need the complete list.

-- Chunk D: locs of literals whose var was ALSO an operand of an arithmetic op
-- (recordIfaceObligation).  Such a literal keeps the Num message — the operator is the
-- real culprit — so the reframe skips it (it reframes `litLocs \ opLocs`).

-- Chunk D: (literalLoc, contextKind) recorded when inferIf / inferListLit / consOp
-- is about to force a still-unbound literal var against a concrete sibling type —
-- lets the reframe pick site-specific wording (if-branches / list elements / cons
-- head-vs-element) over the bare `Type mismatch: Int vs T`.

-- Every local binding (let-bound name, lambda param, function-clause param,
-- match-arm binder) flows through inferPat's PVar/PAs arms, which capture
-- (name, mono var) here.  The mono var is union-find-solved by the time inference
-- ends; the module checker then generalizes each into `localSchemesOut`, and
-- `captureEntryTables` freezes them into the drive's `PartialAnalysis`.  The seed
-- (runtime.mdk externs: putStrLn, readLine, …) stays in scope for inference but
-- is excluded from the returned env, so `seedSchemesOut` is frozen the same way.
-- Neither enters the returned env.

-- `loc` is the BINDER's own source span (#2092) — `None` only where the binding
-- site genuinely has none to give.  Discarding it is what made the hover tier
-- order unfixable: without a position there is no way to tell a local that is
-- in scope at the cursor from one bound in an unrelated declaration.
recordLocalBind : ModuleCtx -> String -> Option Loc -> BinderId -> Mono -> Unit
recordLocalBind mctx name loc bid v =
  let _ = recordBinderType mctx.mcGraph bid name v None False
  mctx.mcCells.localBindRefs :=
    (localSourceName name, loc, v) :: mctx.mcCells.localBindRefs.value

-- Queue binder [bid]'s type for the runtime-type table.  [arity] is `Some n` for
-- a function binder, whose return type is read after its n declared parameters;
-- [signed] is whether that function has a declared type signature.
-- A binder no minting pass visited (a node the typechecker or a later pass
-- synthesized) has no id to publish under and is skipped.
recordBinderType : GraphCtx ->
  BinderId ->
  String ->
  Mono ->
  Option Int ->
  Bool ->
  Unit
recordBinderType gctx bid name v arity signed = match bid
  BinderId _ i =>
    if i < 0 then
      ()
    else
      let g = gctx.graphRun
      g.binderPending :=
        PendingBinder bid (localSourceName name) v arity signed
          :: g.binderPending.value

hasPredicateSlots : String -> OrdMap (List PredicateSlot) -> Bool
hasPredicateSlots k idx = omHasKey k idx

-- #1114 (DICT-SEMANTICS §4.2 D1): would `checkOneCallObligation` reach a VERDICT on this
-- recorded predicate right now?  That — not groundness — is the question the D1-preserving
-- window in `inferUserImplBodies` has to ask, and getting it wrong is silent by
-- construction (see the warning at the end of this comment).
--
-- The gate decides a goal now exactly when every argument has a constructed head
-- (`allConcreteHeads`), and that verdict cannot change later: grounding is monotone, so
-- a constructed head (a type constructor, a rigid, or an arrow) never becomes a variable.
-- A predicate this filter drops while the gate would decide it vanishes with no verdict
-- from any channel (D4 exempts the impl channel from D3), which is #792's three-verdict
-- signature (`check` 0 / `run` `intToString: not an Int` / `build` `arg-tag dispatch on
-- impl type that owns no constructors`).
-- `numUnimplementableHead`'s `TApp` arm (a spine head that is an unbound tyvar) is NOT
-- kept: that head can still bind, so its verdict is not stable and the predicate belongs
-- to D2's deferred population.  An EMPTY argument vector is inert at the gate
-- (`if isEmptyL args then ()`), so dropping it loses no verdict.
--
-- The set is closed, enumerated from the type rather than sampled.  `Mono` has six
-- constructors and `headMonoNode` peels `TApp`, so a head is one of `TVar`, `TCon`,
-- `TRigid`, `TFun`, `TEff`.  `TCon`/`TRigid`/`TFun` are the constructed heads
-- `headTyconMono` answers, so `allConcreteHeads` keeps them; `TVar` can still bind, so
-- gate and filter agree to defer it; and `TEff` is decided by neither (the gate reaches
-- its own `allConcreteHeads` arm and defers).  A vector mixing a constructed head with a
-- variable defers in both, whatever the constructed head is.
--
-- ⚠️ NO GATE CAN CATCH A REGRESSION HERE.  A predicate this filter drops is one no channel
-- ever reports, so it produces silence, and silence is what every golden in the corpus
-- already records for a program the compiler accepts.  If you narrow this predicate, the
-- suite stays green.  The obligation is on the reader: any arm added to
-- `checkOneCallObligation` ABOVE its `allConcreteHeads` test must be mirrored here, or it
-- becomes unreachable for every parametric impl body in the language.
uOblIsDecidableNow : GraphCtx -> UObligation -> Bool
uOblIsDecidableNow gctx o =
  let args = map normalize (uOblArgs gctx o)
  isNonEmptyL args && allConcreteHeads args

-- the top-level fn whose body is currently being inferred ("" = none); captured
-- into a deferred RecDictApp so its recursive calls forward the right dict param.

-- G4: True while inferring an impl method BODY (set around inferImplMethod).  A
-- comparison/equality OPERATOR site records this flag so resolveBinopSite consults
-- `activeDictVarOf` (→ route the impl's threaded element dict, RDict) ONLY for sites
-- genuinely inside an impl body.  A TOP-LEVEL `<=`/`==` must NOT — its operand could
-- normalize to an unsolved tyvar whose id collides with a stale activeDictVars entry
-- left by a previously-inferred impl, spuriously routing it RDict (which flipped the
-- repl's String-keyed `:browse` sort).  activeDictVars is global + uncleared, so the
-- flag is the scope gate the id-lookup alone cannot provide.

-- INFERRED (unsignatured) `=>`-constraint promotion (the reference's two-pass
-- Elaborate / Phase 83/84/115).  An unsignatured fn whose body uses a
-- return-position method — or calls a constrained fn — at one of its OWN
-- generalized tyvars carries a constraint only AFTER inference.  We discover this
-- by recording, per occurrence, the enclosing fn (currentFn) and the live mono,
-- then (post-generalization) intersecting with the fn's quantified ids.
--   methodSiteFns : (enclosing fn, a return-position method site's result mono)
--   dictAppFns    : (enclosing fn, a constrained-fn call's instantiated constraint
--                   monos) — propagates a constraint to an unsignatured CALLER
--   promotedRef   : fns discovered THIS pass to carry an inferred constraint; read
--                   by the retired promotion fixpoint to grow the dict-passed set
--   dictEligibleRef: the USER fn names eligible for promotion (the prelude's
--                   constrained fns stay arg-tag/RKey — out of scope).  Set by
--                   the old elaborator; NOT cleared by `freshModuleCtx` (constant per run).
--
-- PERF: both are INDEXED BY ENCLOSING FN rather than kept as flat (fn, mono) assoc
-- lists.  Their sole reader, `inferredConstraintIds`, selects the entries of ONE fn,
-- and it runs once per member of every top-level group — so scanning a flat list that
-- accumulates a site for every constrained occurrence in the whole file was O(N²).
-- Each key's list is built by consing, exactly like the flat lists were, so a fn's
-- sites keep the same most-recent-first order the old scan produced.

-- The graph's promoted names so far, in load order.  `freshModuleCtx` clears
-- `promotedRef` per module, so `graphModuleWorker`'s `GOutTrees` arm unions each
-- module's `promotedRef.value` into here right after that module's check (before
-- the next module's `freshModuleCtx` wipes it).  Its reader is `beginModuleMarking`: a
-- module's dict-name set is the bare set plus THIS list, which is what lets one
-- sweep mark a promoted callee's cross-module call sites (ARCH §E).  Cleared at
-- every Module-arm driver entry (`elaborateModules`, `checkModulesPreambleK`) so an
-- earlier elaboration in the process cannot leak promoted names into a later mark
-- set; NOT touched by `freshModuleCtx`.  `elaborateModules` reads it once more at the
-- end, for the set `dictPass` prepends dict params over (`markDictNames`).

-- O(log n) membership index of dictEligibleRef.  #415 item 3: DERIVED from the list by
-- `setDictEligible`, the single writer of both — not mirrored at each set site, so the
-- two cannot drift.  maybeInferConstraint tests it per SCC member per discovery pass —
-- an O(members × eligible) scan over the whole program when it was a list.

-- Whether the retired single-program checker also inferred each parametric impl's
-- method bodies (instance-`requires` dict-passing, Phase 83/84 single-level).  ON
-- only for the old elaborate/dict path; off for the
-- `=== TYPES ===` golden path (checkProgram) and the multi-module path
-- (elaborateModules) so their scheme output stays byte-identical.  Deliberately
-- NOT reset by `freshModuleCtx` — the entrypoint that owns the path sets it.

-- ── D0.5 arg-position dispatch MEASUREMENT (probe-only) ─────────────────────
-- Classify every ARGUMENT-position interface-method occurrence (the bare-EVar
-- arg-tag population D0 counted, upper bound 1065) by the inferred type of its
-- DISCRIMINATING argument: concrete-primitive / concrete-ADT / type-variable.
-- Mirrors recordSite/resolveSites (which stamp RETURN-position sites) but for
-- arg-position sites it MEASURES, never stamps.  An arg-position method is exactly
-- one that reached inferVar (return-position + method-constrained methods were
-- already rewritten to EMethodAt/EDictAt by prePassDict, so they never arrive there).

-- method name → 0-based index of its first argument mentioning the interface
-- typaram (its dispatch position).  Set by the probe before elaboration; absence
-- of a name means "not an arg-position interface method" → not measured.

-- ── D3a arg-position dispatch STAMPING (Native backend, ALL elaboration paths) ──
-- The action analog of the D0.5 measurement: instead of classifying each
-- ARGUMENT-position interface-method occurrence, STAMP a static `RKey <head>` for
-- every one whose discriminating-argument type resolves to a concrete head (the
-- 903 concrete sites = 25 primitive + 878 ADT).  Type-variable occurrences (the
-- 110 D3b sites) stay RNone → the emitter falls back to runtime arg-tag dispatch.
-- Stamping is UNCONDITIONAL: emit, eval, and the `=== TYPES ===` / Core-IR golden +
-- ceval-oracle drivers all elaborate identically — one single elaboration mode
-- (#157).  Measured byte-identical across the 204/204 fixtures, so the unification
-- is representation-neutral, not a behaviour change.

-- the route refs awaiting an arg-position stamp + their discriminating-argument
-- mono (captured during inference, resolved by resolveArgStamps while the tyvar
-- cells are still bound).  Recorded as `GKArgStamp` goals on `GraphRun.goals`,
-- drained per module like the return-position sites.
-- D3b-1: also carries the method name + the EMethodAt impl-dicts ref, so a
-- concrete site whose head names a parametric `requires` impl can thread the
-- element dict (resolveArgStamp → argImplDictRoutesForEncl), exactly as the
-- return-position sites carry implRef for resolveSite.
-- #156 S3a: entries are `PendingEntry`s of kind `SKArg`.

-- the dispatch-index registry: each interface method → index of its first arg
-- mentioning the interface typaram.  Methods with NO such arg (return-position)
-- contribute nothing.  Computed structurally from interface decls.
argDispatchIndices : List Decl -> List (String, Int)
argDispatchIndices prog = flatMap argDispatchOfDecl prog

argDispatchOfDecl : Decl -> List (String, Int)
argDispatchOfDecl (DAttrib _ d) = argDispatchOfDecl d
argDispatchOfDecl (DInterface { typarams, methods, ... }) =
  flatMap (argDispatchOfMethod typarams) methods
argDispatchOfDecl _ = []

argDispatchOfMethod : List String -> IfaceMethod -> List (String, Int)
argDispatchOfMethod typarams (IfaceMethod mname mty _ _) =
  match firstDispatchIdx (dispatchTyparams typarams) 0 (methodArgs mty)
    Some i => [(mname, i)]
    None => []

-- #1351 L1 (EXPAND): the IDENTITY-CARRYING sibling of `argDispatchIndices` above.  Same
-- walk, same arms, same `firstDispatchIdx` classification — the ONLY difference is the
-- key: `(IfaceRef, method name)` instead of the bare method name.  `IfaceRef` is this
-- file's existing module-qualified interface identity (`irName` spelling + `irOrigin` I4
-- identity); it is already minted at the peer population site
-- `methodRowsInto` out of the SAME two `DInterface` fields, so this adds
-- no new notion of identity, only a second key-shape for an existing one.
--
-- Readers: its result is installed into `GraphCtx.argDispatchIdxByIdRef` by the
-- two drivers, and `argDispatchOf` reads that ref through `dispatchIdxScoped` (L3
-- MIGRATE, landed).  Derive the set — `grep -n argDispatchIdxByIdRef` — rather than
-- trusting a list here.
--
-- 🔒 Purity note, load-bearing for L1's zero-behaviour-change property:
-- `argDispatchIndices` and everything it reaches (`argDispatchOfDecl`,
-- `argDispatchOfMethod`, `dispatchTyparams`, `firstDispatchIdx`, `argMentions`,
-- `methodArgs`) is pure and structural, so running this second walk beside it advances
-- no counter, mints no id and registers nothing.  The scheme-bearing method-row walk is
-- intentionally effectful and therefore constructs identity and scheme together.
argDispatchIndicesById : List Decl -> List ((IfaceRef, String), Int)
argDispatchIndicesById prog = flatMap argDispatchOfDeclById prog

argDispatchOfDeclById : Decl -> List ((IfaceRef, String), Int)
argDispatchOfDeclById (DAttrib _ d) = argDispatchOfDeclById d
argDispatchOfDeclById (DInterface { name, typarams, methods, ifaceOrigin, ... }) =
  flatMap
    (argDispatchOfMethodById
      IfaceRef { irName = name, irOrigin = ifaceOrigin }
      typarams)
    methods
argDispatchOfDeclById _ = []

argDispatchOfMethodById : IfaceRef ->
  List String ->
  IfaceMethod ->
  List ((IfaceRef, String), Int)
argDispatchOfMethodById iface typarams (IfaceMethod mname mty _ _) =
  match firstDispatchIdx (dispatchTyparams typarams) 0 (methodArgs mty)
    Some i => [((iface, mname), i)]
    None => []

firstDispatchIdx : List String -> Int -> List Ty -> Option Int
firstDispatchIdx _ _ [] = None
firstDispatchIdx typarams i (ty :: rest)
  | argMentions typarams ty = Some i
  | otherwise = firstDispatchIdx typarams (i + 1) rest

-- D3a: queue an arg-position occurrence's route ref for stamping, keyed on the
-- inferred type of its discriminating argument (the dispatch-position arg mono).
-- The cell is read later (resolveArgStamps), once inference has solved it.  D3b-1:
-- also carry [name] + the impl-dicts ref so a concrete-head site can thread the
-- element dict for a parametric `requires` impl.  [suppressed] is the caller's
-- `dcSuppressArgStamp`: a definer-shadow application head records its argument
-- itself.
recordArgStamp : ModuleCtx ->
  Bool ->
  String ->
  Ref Route ->
  Ref (List Route) ->
  Ref Inner ->
  Int ->
  Mono ->
  List (String, Mono) ->
  Unit
recordArgStamp mctx suppressed name tagRef implRef innerRef idx mono omitted
  | suppressed = ()
  | otherwise = match nthArgMono idx mono
    Some am =>
      pushSiteGoal
        mctx.mcGraph
        GKArgStamp
        innerRef
        (PendingEntry
          name
          tagRef
          am
          mctx.mcCells.currentFn.value
          (SKArg implRef mono omitted)
          mctx.mcLoc
          (captureScope mctx ())
          (freshEvId mctx ()))
    None => ()

-- Cause-A prerequisite: an ARG-position method occurrence's discriminating-arg
-- mono, keyed by the enclosing fn (currentFn), pushed into methodSiteFns — the
-- arg-position analogue of recordSite's return-position push.  inferredConstraintIds
-- reads methodSiteFns to discover the enclosing fn's INFERRED constraint, so this
-- lets `f s = display s` promote `f` to a dict-passed fn (it had no signature, so
-- the constraint is inferred, not declared).  Idx-th arg mono = the receiver whose
-- (constraint) tyvar must be discovered.
recordArgSiteFn : ModuleCtx -> String -> Int -> Mono -> Unit
recordArgSiteFn mctx _ idx mono = match nthArgMono idx mono
  Some am =>
    mctx.mcCells.methodSiteFns :=
      consSiteFn
        mctx.mcCells.currentFn.value
        am
        mctx.mcCells.methodSiteFns.value
  None => ()

-- Native Gap C (parametric default-method dict-synthesis, 2026-06-12): a BY-NAME
-- relational method (`lt`/`gt`/…) at a parametric Ord head (tuple/`List a`/`Box a`)
-- has NO own impl, so its element `requires` dicts must be keyed off the inner
-- `compare` (whose impl carries them).  emitDefaultDefine eta-prepends matching
-- dict params; emitDefaultRKey forwards these words.  Concrete head / a method
-- with its own impl ⇒ same key as before (empty for non-parametric), unchanged.

-- ── type-error accumulator ─────────────────────────────────────────────────
-- Unification failures record diagnostics here instead of panicking, so
-- ill-typed programs emit matching `TYPE ERROR: …` lines.  occursCheckFailed
-- is a per-bindVar flag: occursAdjustUnbound sets it so bindVar can skip the
-- actual link (preventing a cyclic union-find entry).
-- Each accumulated error carries the span of the construct around its push site
-- (the record's `mcLoc`, see `mctxAt`) unless the push names one.  severity = 1.
--
-- issue 1146 — THE CHANNEL IS SPLIT BY ROLE.  "Which diagnostics are REPORTED"
-- is OUTPUT and lives in `ModuleCells.mcCells.typeErrors`, a `Windowed TcDiag` like its
-- obligation-channel siblings (see `Windowed` above — `wPush`/`wRestore` are
-- its sole WRITERS, so its list and its count cannot drift apart).  "An error
-- OCCURRED" is CONTROL and lives in `ModuleCells.mcCells.errorsDetected`, a monotone-per-module
-- occurrence counter that is not a diagnostics channel at all.
--
-- The counter counts errors DETECTED, not errors STORED (PR2).  The three dedup
-- helpers below still read the list by CONTENT to decide whether to store, but a
-- short-circuit bumps the counter anyway (`noteTypeErrorDetected`), so "was an error
-- detected here" and "is this diagnostic worth printing" are now independent
-- judgments.  That is the property the whole split exists for: NO diagnostics
-- decision — dedup key, rendering, ordering, loc selection, code selection — can
-- reach a control decision, because the only thing control reads is a count of
-- detections and none of those choices changes whether a detection happened.
--
-- PR1 stopped short of this: it bumped only on a real store, so the counter's delta
-- equalled `listLen typeErrors`'s delta exactly (which is what let PR1 land without
-- moving a golden), and a deduped push therefore answered `erredDuring` False and let
-- a gated `unify` run that a non-deduped push would have suppressed.  PR2 gives that
-- equality up on purpose; it is no longer an invariant and must not be restored.
--
-- See `recordTypeError` / `noteTypeErrorDetected` (the counter's sole writers) and
-- `erredDuring` (its sole reader) below.

-- G1 (SOUNDNESS): `GraphCtx.typeErrorsSticky` is a sticky mirror of typeErrors that
-- `freshModuleCtx` does not clear.  The multi-module elaborate path
-- (elaborateModules → checkModuleFullImpl) calls `freshModuleCtx` at the start of each
-- module, wiping `typeErrors`, so after the whole graph only the last module's errors
-- survive there.  build/run must abort on a type error in any module, so
-- `pushTypeError` also records into this accumulator, which the drive's mint
-- starts `False`.  Read via `hadTypeErrors` to gate the CLI exit code before
-- emit/eval.
--
-- #2089 / #2544 (M4): `GraphCtx.typeErrorsStickyDiags` holds the diagnostics behind
-- the flag, newest first, across every module of the graph.  `ModuleCells.mcCells.typeErrors` is
-- wiped per module, so this is the only place a caller with no per-module hook can
-- read what armed the sticky flag rather than merely that it was armed — it is what
-- `elaborateModules` returns as its residual, each entry with its own `Loc`.  Written
-- only by `recordTypeError`, started empty by the drive's mint, and rolled back
-- wherever the flag is (`checkGraphFinish`) — the same pairing obligation the
-- detection counter states.  Both are the drive's own.

-- #2544 (M4): every diagnostic that armed the sticky gate in the drive, each tagged
-- with the module it was recorded in, in push order, deduplicated PER GOAL —
-- module, code, location and text together — never by text alone (a text key would
-- re-introduce the suppressed-check shape OD5 forbids: two goals at two sites with
-- the same rendering are two findings).
export
stickyTypeErrorDiags : DriveOutputs -> List (String, TcDiag)
stickyTypeErrorDiags o = stickyDiagsInPushOrder o.doStickyDiags

-- True iff the drive recorded a type error, as the drive left it.
export
hadTypeErrors : DriveOutputs -> Bool
hadTypeErrors o = o.doHadTypeErrors

-- Whether the `main` binding recorded obligations remains inference-private; the
-- publication module receives its Boolean answer rather than this side table.
mainHasObligations : ModuleCtx -> Bool
mainHasObligations mctx =
  let id = optionOr 0 (omLookup "main" mctx.mcCells.schemeDefIdsRef.value)
  match lookupSchemeObls "main" id mctx.mcCells.schemeObligationsRef.value
    Some (_ :: _) => True
    _ => False

-- ── non-exhaustive-match warning accumulator (the type-aware `check_match`) ──
-- `inferMatch` pushes a warning here for every `match` whose non-guarded arms
-- don't cover the scrutinee's type.  `matchOracle` is the ctor oracle the matrix
-- recursion consults; `checkOneMatchToLines` seeds it from the program's
-- data decls (so it sees the same user + builtin ctors check_match does) before
-- inference runs.  `freshModuleCtx` installs both from the `CheckRunSeed` and the driver
-- reads `matchWarnings` after the typecheck pass; runs that ignore match warnings
-- (the schemes/selfproc paths) simply never read it.
-- #159: element type is now `TcDiag` (severity 2), carrying the span (formerly the
-- parallel `matchWarningLocs`) and the actionable-fix help (formerly the message-
-- keyed `matchWarningHelp`) INLINE — no parallel lists, no lookup-by-message.  The
-- `TcDiag.msg` holds the FULL "Warning: …"-prefixed string exactly as the old
-- `List String` did, so the text-rendering paths (`checkOneMatchToLines`,
-- checkToLinesWithRuntime, checkModulesEntryReport) stay byte-identical; only the
-- prefix strip happens on the driver/diagnostics.mdk side.
--
-- ⚠️ THE `W-*` CODE IS AUTHORED AT THE PUSH SITE — write it into the `TcDiag`, never
-- leave it `""` for a downstream reader to guess.  `driver/diagnostics.mdk`'s
-- `diagOfTypeWarning` carries whatever code it finds here straight through to
-- `--json`; it used to re-derive one by prefix-matching this message text, which
-- silently relabelled any third warning `W-NONEXHAUSTIVE` (see that function's own
-- note, and DIAGNOSTIC-CODES-DESIGN.md — "*No chokepoint can infer these*").
-- Register the code in DIAGNOSTIC-CODES-DESIGN.md's warning table in the same change.
--
-- ⚠️ THE `W-` PREFIX IS LOAD-BEARING, not a naming convention.  The JSON `kind` is
-- DERIVED from the code's prefix (`codeKind`), so the code you write here decides
-- how every consumer classifies the diagnostic.  A demoted error that KEEPS its
-- `T-*` code is the trap: it reads as a type error to anything filtering the
-- per-stage taxonomy.  `diagKind` now stops that from rendering an incoherent
-- `{"kind":"type","severity":2}`, but it deliberately does NOT rewrite your code —
-- inventing `W-FOO` from `T-FOO` would be the same derive-identity-from-spelling
-- mistake in the other direction.  Author a `W-*` code; do not reuse the error's.
--
-- This is THE channel for a typecheck-stage warning — including one that used to be
-- an error.  Do NOT demote an error by pushing a severity-2 `TcDiag` through
-- `recordTypeError` instead: it arms `typeErrorsSticky` (aborts `build`/`run`) and
-- bumps `errorsDetected` (steers `erredDuring`-gated inference, issue 1146)
-- UNCONDITIONALLY, without reading severity at all — so the "warning" keeps both of
-- an error's side effects.  It does not even RENDER as a warning: `diagOfTypeError`
-- binds the severity field to `_` and prints severity 1.  (Removing that hardcode
-- would not rescue the idea — it would print severity 2 and still abort the build.
-- The side effects are the reason, not the rendering.)  `matchWarnings` has neither.

-- True iff the last typecheck pass pushed any match warning.  Read by the snapshot
-- runner (`tools/snapshot.mdk`) to decide whether a rendered `# TYPES` section carries
-- diagnostic prose — a `W-*` warning is graded by `compiler/ERROR-QUALITY.md` exactly
-- like an error is, so a `# TYPES` section holding one is NOT `--bless`-able.  Keyed on
-- the accumulator rather than sniffing the rendered text: the renderer must not have to
-- guess which of its own lines are diagnostics.
export
hadMatchWarnings : DriveOutputs -> Bool
hadMatchWarnings o = o.doHadMatchWarnings

-- `hadMatchWarnings` of the last module checked: the only read of a drive that returns no
-- outputs (the projections).
export
matchWarningsNow : ModuleCtx -> Bool
matchWarningsNow mctx = match mctx.mcCells.matchWarnings.value
  [] => False
  _ => True

-- The drive inputs of a driver that loads no stdlib ownership and selects no
-- profile: no module stdlib-owned, the flat entry not stdlib, every trace off, and
-- the `IO` join of no profile.  A pure value (it holds no `Ref`).
--
-- No ownership means every `extern` is stamped (#2072, `ffiStampModeOwned`), and that
-- direction is the safe one on purpose: a driver that passes no ownership suppresses
-- nothing, so the worst it can do is render an `FFI` atom on the stdlib catalog when
-- someone points it at stdlib source.  The inverse default would leave #2072's hole
-- (a user `extern f : Int -> <> Int` typing pure) open on every such path, which is
-- a soundness hole rather than a cosmetic one.
export
defaultDriveInputs : DriveInputs
defaultDriveInputs = DriveInputs {
  diExecutedMainDriver = None,
  diManifestRequests = [],
  diStdlibOwned = omEmpty,
  diFlatEntryIsStdlib = False,
  diTrace = None,
  diIoJoinGrants = ioJoinGrants None,
  diProfileName = "",
  diPreludeKey = None,
}

-- The drive inputs a driver builds from the profile it selected and the loader's
-- owning-root fact (`stdlibOwnership`, `driver/loader.mdk`): whether the flat entry
-- is a stdlib module, and the stdlib-owned module ids.  That fact is read by
-- `ffiStampMode`, which decides whether an `extern` DECLARATION in the program
-- under check is the stdlib's extern catalog (never stamped) or a user's FFI
-- declaration (always stamped).
--
-- Two ownership fields because graph checks carry different amounts of identity.
-- `Module mid _ _` has a module id, so the Module arm asks "is THIS module
-- stdlib-owned" of the set.  `Flat _` has no id at all (the flat driver has already
-- flattened the program into one anonymous decl list), so the entry's ownership
-- arrives as its own Bool.
--
-- NOT `projectTrustedMods` (`driver/loader.mdk`): that predicate answers a different
-- question (may module M *reference* an internal-only extern?) and is opt-in-able
-- from any `medaka.toml` via `allow-internal` (#1713).  Routing this through it would
-- let a user exempt their own externs from the stamp by writing one manifest line.
export
driveInputsFor : Option TargetProfile -> Bool -> List String -> DriveInputs
driveInputsFor profile flatEntry mods = { defaultDriveInputs |
  diStdlibOwned = namesToSet mods omEmpty,
  diFlatEntryIsStdlib = flatEntry,
  diIoJoinGrants = ioJoinGrants profile,
  diProfileName = match profile
    None => ""
    Some p => profileName p,
}

-- Test visibility (`typecheck_test.mdk`): each goal of [gctx]'s graph that writes a
-- method cell's route or dictionaries, by kind, with whether its `oInner` is that
-- cell's `ecInner`, so the stampers' notes reach the judgment (`judgeCells`).  Read
-- by writing a marker through the goal's refs and looking for it in the cells, then
-- restoring both.  A goal whose destination is no cell's (a throwaway) is skipped.
export
cellGoalInnerAliasing : GraphCtx -> List (String, Bool)
cellGoalInnerAliasing gctx =
  let g = gctx.graphRun
  let cells = cellsFrom g.evCells.value 0 []
  filterMap
    (o =>
      map (c => (goalKindName o.oKind, innerAliases o c)) (cellOfGoal cells o))
    g.goals.value

cellsFrom : Array (Option EvCell) -> Int -> List EvCell -> List EvCell
cellsFrom arr i acc
  | i >= arrayLength arr = reverseL acc
  | otherwise = match arrayGetUnsafe i arr
    Some c => cellsFrom arr (i + 1) (c :: acc)
    None => cellsFrom arr (i + 1) acc

cellOfGoal : List EvCell -> Obligation -> Option EvCell
cellOfGoal cells o = match o.oDest
  EvRoute r =>
    let saved = r.value
    r := RLocal aliasMarker []
    let hit = filterList (c => isAliasMarker c.ecTag.value) cells
    r := saved
    onlyCell hit
  EvRoutes rs =>
    let saved = rs.value
    rs := [RLocal aliasMarker []]
    let hit =
      filterList
        (c => anyList isAliasMarker (c.ecImpl.value ++ c.ecMeth.value))
        cells
    rs := saved
    onlyCell hit

onlyCell : List EvCell -> Option EvCell
onlyCell [c] = Some c
onlyCell _ = None

aliasMarker : String
aliasMarker = "<inner-alias-probe>"

isAliasMarker : Route -> Bool
isAliasMarker (RLocal sym _) = sym == aliasMarker
isAliasMarker _ = False

innerAliases : Obligation -> EvCell -> Bool
innerAliases o c =
  let savedGoal = o.oInner.value
  let savedCell = c.ecInner.value
  c.ecInner := innerNone
  o.oInner := Inner True True
  let hit = match c.ecInner.value
    Inner True True => True
    _ => False
  o.oInner := savedGoal
  c.ecInner := savedCell
  hit

-- Every route a goal carries, in slot order — one for a site, one per slot for
-- a dictionary application.
obligationRoutes : Obligation -> List Route
obligationRoutes o = match o.oDest
  EvRoute r => [r.value]
  EvRoutes rs => rs.value

-- The predicate mono behind each slot, aligned by position with
-- `obligationRoutes`'s answer for the SAME obligation. `GKMethodDict`'s slots
-- carry an `IfaceRef`/`PredicateSlotArgs` pair rather than a `Mono` (#8251), so
-- it answers `None` per slot rather than reconstructing one.
obligationPredicateMonos : Obligation -> List (Option Mono)
obligationPredicateMonos o = match o.oPayload
  GPSite _ m _ => [Some m]
  GPArith m => [Some m]
  GPDictApp app => map Some app.pdaMonos
  GPMethodDict pmd => map (_ => None) pmd.pmdSlots
  GPRecDictApp (RecDictApp _ _ _ m _ _) => [Some m]

routeOutcomeKind : Route -> EvidenceOutcomeKind
routeOutcomeKind RNone = EOKNone
routeOutcomeKind (RKey _ _ _) = EOKInstance
routeOutcomeKind (RDict _) = EOKGiven
routeOutcomeKind (RDictFwd _) = EOKGiven
routeOutcomeKind (RLocal _ _) = EOKLocal
routeOutcomeKind (RScalar _) = EOKScalar
routeOutcomeKind (RProj r _) = routeOutcomeKind r

routeGivenBinder : Route -> Option String
routeGivenBinder (RDict n) = Some n
routeGivenBinder (RDictFwd n) = Some n
routeGivenBinder (RProj r _) = routeGivenBinder r
routeGivenBinder _ = None

routeInstanceKey : Route -> Option String
routeInstanceKey (RKey k _ _) = Some k
routeInstanceKey _ = None

-- The nested route list an `RKey`/`RLocal` packs at this slot: the packed
-- `requires`, exactly as `entailInst` produces them.
routePrerequisiteRoutes : Route -> List Route
routePrerequisiteRoutes (RKey _ rs _) = rs
routePrerequisiteRoutes (RLocal _ rs) = rs
routePrerequisiteRoutes _ = []

renderRouteIdentity : Route -> String
renderRouteIdentity RNone = "RNone"
renderRouteIdentity (RKey k _ _) = "RKey " ++ k
renderRouteIdentity (RDict n) = "RDict " ++ n
renderRouteIdentity (RDictFwd n) = "RDictFwd " ++ n
renderRouteIdentity (RLocal n _) = "RLocal " ++ n
renderRouteIdentity (RScalar n) = "RScalar " ++ n
renderRouteIdentity (RProj r path) =
  "RProj (\{renderRouteIdentity r}) \{joinWith "." (map intToString path)}"

noteEvidenceObservation : GraphCtx -> Obligation -> Unit
noteEvidenceObservation gctx o = match gctx.trace
  Some sink =>
    if sink.tsEvidenceObservationEnabled then
      let routes = obligationRoutes o
      let predicates = obligationPredicateMonos o
      let arity = listLen routes
      sink.tsEvidenceObservationEntries :=
        evidenceObservationEntriesGo o routes predicates arity 0
          ++ sink.tsEvidenceObservationEntries.value
  None => ()

evidenceObservationEntriesGo : Obligation ->
  List Route ->
  List (Option Mono) ->
  Int ->
  Int ->
  List EvidenceObservationEntry
evidenceObservationEntriesGo _ [] _ _ _ = []
evidenceObservationEntriesGo o (r :: rs) preds arity slot =
  let (predHere, predsRest) = match preds
    p :: ptail => (p, ptail)
    [] => (None, [])
  EvidenceObservationEntry {
      eoeEv = o.oEv,
      eoeGoalKind = goalKindName o.oKind,
      eoeSlot = slot,
      eoeArity = arity,
      eoePredicate = map ppMono predHere,
      eoeOutcome = routeOutcomeKind r,
      eoeGivenBinder = routeGivenBinder r,
      eoeInstanceKey = routeInstanceKey r,
      eoePrerequisites = map renderRouteIdentity (routePrerequisiteRoutes r),
      eoeScope = o.oScope,
    }
    :: evidenceObservationEntriesGo o rs predsRest arity (slot + 1)

closeScope : ModuleCtx -> Unit -> Unit
closeScope mctx _ =
  mctx.mcCells.currentScope :=
    Scopes.closeScopeCursor
      (currentScopeStore mctx.mcGraph ())
      mctx.mcCells.currentScope.value

-- #2705: mint the cells for one `EMethodAt` node and return the id the node
-- carries.  [seed] is the pre-pass seed (the mangled definer-shadow symbol, or
-- ""): a non-empty seed becomes the `RLocal <seed> []` fallback the stampers and
-- every seed reader (`routeLocalSym`) expect to find on the dispatch cell.
mintMethodCell : ModuleCtx -> String -> EvId
mintMethodCell mctx seed =
  mintMethodCellRaw
    mctx
    ""
    None
    (if seed == "" then RNone else RLocal seed [])
    []

-- The `dictPass` mints: a node constructed AFTER the drain, from a route another
-- node already solved, so its cells start at their final values.  The entry is
-- recorded in [pe] as well: the index the pass reads was taken before the node
-- existed.
mintMethodCellWith : ModuleCtx ->
  PassEvidence ->
  String ->
  Int ->
  Route ->
  List Route ->
  EvId
mintMethodCellWith mctx (PassEvidence _ minted) iface arity tag impls =
  let ev = mintMethodCellRaw mctx iface (Some arity) tag impls
  minted :=
    omInsert
      (intToString (evOrdinal ev))
      (EvMethod iface arity tag impls [])
      minted.value
  ev

mintMethodCellRaw : ModuleCtx ->
  String ->
  Option Int ->
  Route ->
  List Route ->
  EvId
mintMethodCellRaw mctx iface arity tag impls =
  let ev = freshEvId mctx ()
  let g = mctx.mcGraph.graphRun
  let i = evOrdinal ev - g.evBase
  let arr = indexWithSlot g.evCells i
  -- An occupied slot would mean two nodes minted under one ordinal — the same
  -- collision `fillEvidence` refuses at publish time — and a memo restore that
  -- rewound the counter without rewinding this index is the one way to reach it.
  -- Fail closed here, where the second mint happens, rather than at publish.
  let _ = match arrayGetUnsafe i arr
    None => ()
    Some _ => panic "method cell #\{intToString (evOrdinal ev)} minted twice"
  let _ =
    arraySetUnsafe
      i
      (Some EvCell {
        ecId = ev,
        ecIface = Ref iface,
        ecArity = Ref arity,
        ecTag = Ref tag,
        ecImpl = Ref impls,
        ecMeth = Ref [],
        ecLoc = Ref None,
        ecName = Ref "",
        ecInner = Ref innerNone,
      })
      arr
  ev

evOrdinal : EvId -> Int
evOrdinal (EvId _ i) = i

-- The array [index] holds, grown by doubling until slot [i] exists.
indexWithSlot : Ref (Array (Option a)) -> Int -> Array (Option a)
indexWithSlot index i =
  let arr0 = index.value
  if i < arrayLength arr0 then
    arr0
  else
    let grown = arrayMake (max 16 (2 * (i + 1))) None
    let _ = arrayBlit arr0 0 grown 0 (arrayLength arr0)
    index := grown
    grown

-- Mint the cell for one operator site, starting unrouted, and return its id.
mintOpSite : ModuleCtx -> Unit -> EvId
mintOpSite mctx _ = mintSite mctx (OpSite (Ref RNone))

-- Mint the cells for one numeric literal site: an unset float and an unrouted
-- `fromInt` route.
mintLitSite : ModuleCtx -> Unit -> EvId
mintLitSite mctx _ = mintSite mctx (LitSite (Ref None) (Ref RNone))

-- Mint the cell for one field access or record update, starting with the unknown
-- head "".
mintHeadSite : ModuleCtx -> Unit -> EvId
mintHeadSite mctx _ = mintSite mctx (HeadSite (Ref ""))

-- [ev] if it already has a site, else a freshly minted one: a body re-marked after
-- inference keeps the ids inference wrote through.
mintedOr : (Unit -> EvId) -> EvId -> EvId
mintedOr mint ev = if isUnminted ev then mint () else ev

mintSite : ModuleCtx -> SiteCell -> EvId
mintSite mctx cell =
  let ev = freshEvId mctx ()
  let g = mctx.mcGraph.graphRun
  let i = evOrdinal ev - g.evBase
  let arr = indexWithSlot g.siteCells i
  let _ = match arrayGetUnsafe i arr
    None => arraySetUnsafe i (Some (ev, cell)) arr
    Some _ => panic "site cell #\{intToString (evOrdinal ev)} minted twice"
  ev

-- The cell minted for site [ev].  Inference reaching a site the mark pass never
-- visited is a gap in marking coverage, so it panics rather than writing a cell no
-- reader would find.
siteCellOf : GraphCtx -> EvId -> SiteCell
siteCellOf gctx ev = match siteCellLookup gctx ev
  Ok c => c
  Err message => panic message

-- `siteCellOf`'s answer, or the reason it has none.
siteCellLookup : GraphCtx -> EvId -> Result String SiteCell
siteCellLookup gctx ev =
  let (EvId m n) = ev
  let g = gctx.graphRun
  let i = n - g.evBase
  let arr = g.siteCells.value
  if isUnminted ev then
    Err "site reached inference unminted"
  else if i < 0 then
    Err "site cell \{m}#\{intToString n} is from an earlier graph"
  else if i >= arrayLength arr then
    Err "site cell \{m}#\{intToString n} was never minted"
  else match arrayGetUnsafe i arr
    Some (_, c) => Ok c
    None => Err "site cell \{m}#\{intToString n} was never minted"

-- The route cell of operator or literal site [ev].
siteRouteCell : GraphCtx -> EvId -> Ref Route
siteRouteCell gctx ev = match siteCellOf gctx ev
  OpSite r => r
  LitSite _ r => r
  HeadSite _ => notAnOpSite ev

-- The resolved-record-head cell of field access or record update site [ev].
siteHeadCell : GraphCtx -> EvId -> Ref String
siteHeadCell gctx ev = match siteCellOf gctx ev
  HeadSite h => h
  OpSite _ => notAnOpSite ev
  LitSite _ _ => notAnOpSite ev

-- The defaulted-float cell of numeric literal site [ev].
siteFloatCell : GraphCtx -> EvId -> Ref (Option Float)
siteFloatCell gctx ev = match siteCellOf gctx ev
  LitSite f _ => f
  OpSite _ => notAnOpSite ev
  HeadSite _ => notAnOpSite ev

notAnOpSite : EvId -> a
notAnOpSite ev =
  panic
    "site cell \{evIdModule ev}#\{intToString (evOrdinal ev)} is not an operator site"

-- The cells minted for [ev].  A miss is a bug in this file (every `EMethodAt` is
-- minted through `mintMethodCell`), so it panics rather than answering unrouted.
methodCellOf : GraphCtx -> EvId -> EvCell
methodCellOf gctx ev = match methodCellLookup gctx ev
  Ok c => c
  Err message => panic message

-- `methodCellOf`'s answer, or the reason it has none.
methodCellLookup : GraphCtx -> EvId -> Result String EvCell
methodCellLookup gctx (EvId m n) =
  let g = gctx.graphRun
  let i = n - g.evBase
  let arr = g.evCells.value
  if i < 0 then
    Err "method cell \{m}#\{intToString n} is from an earlier graph"
  else if i >= arrayLength arr then
    Err "method cell \{m}#\{intToString n} was never minted"
  else match arrayGetUnsafe i arr
    Some c => Ok c
    None => Err "method cell \{m}#\{intToString n} was never minted"

-- Test visibility (`typecheck_test.mdk`): why [gctx]'s site and method cell stores
-- hold no cell for [ev], each "" where one does.
export
cellStoreMisses : GraphCtx -> EvId -> (String, String)
cellStoreMisses gctx ev = (
  missText (siteCellLookup gctx ev),
  missText (methodCellLookup gctx ev),
)

missText : Result String a -> String
missText (Ok _) = ""
missText (Err message) = message

-- The whole evidence table of this graph: one entry per method occurrence and per
-- minted site, plus the per-goal entries the drain recorded and the entries of the
-- modules a tree drive served (`applyModuleTrees`).
drivenEvidence : GraphCtx -> Unit -> EvTable
drivenEvidence gctx _ =
  cellEntriesFrom gctx.graphRun gctx.graphRun.evBase
    ++ gctx.graphRun.evTable.value

-- #2549 M2: the next evidence id for the module currently being inferred.  The
-- module component comes from the module's record, which `checkBodyImpl` mints once per
-- module before any body of it is inferred; the ordinal is this run's counter.
-- `evCounter` is graph-global, and `graphLineageRun` carries it across every new
-- lineage, so the ordinal alone is what makes an id unique; the module half does not
-- scope it, and `evDictRoutesIn` indexes on the ordinal without consulting it.
-- The module half is a tripwire for that lookup (see `EvId` in `frontend/ast.mdk`):
-- do not make ordinals per-module in the belief that the pair still separates them.
freshEvId : ModuleCtx -> Unit -> EvId
freshEvId mctx _ =
  let g = mctx.mcGraph.graphRun
  let n = g.evCounter.value
  g.evCounter := n + 1
  EvId mctx.mcCells.currentModuleRef.value n

-- Each channel's length as this module begins.
graphMarksNow : GraphCtx -> Unit -> GraphMarks
graphMarksNow gctx _ = GraphMarks {
  mGoals = gctx.graphRun.goalsN.value,
  mNumlit = gctx.graphRun.numlitN.value,
}

recordModuleStart : GraphCtx -> String -> Unit
recordModuleStart gctx mid =
  gctx.graphRun.moduleRanges :=
    (mid, graphMarksNow gctx ()) :: gctx.graphRun.moduleRanges.value

-- The ONE numlit write, so the channel and its counter cannot drift apart.
pushNumlit : GraphCtx -> (Mono, Ref (Option Float), Int, Ref Route) -> Unit
pushNumlit gctx e =
  let g = gctx.graphRun
  g.numlitRefs := e :: g.numlitRefs.value
  g.numlitN := g.numlitN.value + 1

idSetInsertAll : List Int -> Map Int Unit -> Map Int Unit
idSetInsertAll [] m = m
idSetInsertAll (i :: rest) m = idSetInsertAll rest (IdMap.set i () m)

mentionsEscaped : ModuleCtx -> Authority -> Bool
mentionsEscaped mctx q =
  anyList
    (cell =>
      IdMap.has (authvarId cell) mctx.mcCells.escapedExistentialsRef.value)
    (authVars q)

-- The summary's operations over the view of the entry the drive [o] checked.  The
-- field instantiation runs in a graph record of its own, whose effect-variable
-- counter continues from the drive's (`doEffvarNext`).
export
lastInvocationOps : DriveOutputs -> InvocationOps
lastInvocationOps o = match o.doInvocationView
  InvocationView ctors pols kinds =>
    let byHead = ctorsByHead invocationHeadKey ctors
    let gctx = initialGraphCtx builtinCtors (freshGraphRun ())
    gctx.graphRun.effvarCounter := o.doEffvarNext
    InvocationOps {
      headVariances =
        h => match headTyconMono h
          Some (HkDecl key) =>
            slotVariances (paramPolaritiesIn pols key) (lookupTab key kinds)
          _ => None,
      appliedFields =
        applied =>
          let (h, args) = spineParts applied
          flatMap
            (c => instantiateFields gctx args c)
            (optionOr [] (omLookup (invocationHeadKey h) byHead)),
      headKey = invocationHeadKey,
    }

-- Generalize each captured local binding's (now-solved) mono into a Scheme for
-- the LSP hover fallback (see localBindRefs).  Runs at the end of inference when
-- currentLevel is back at the top, so a still-free local var quantifies cleanly
-- to `a`; a ground var (e.g. a `let` bound to a String) renders concretely.
mapLocalSchemes : ModuleCtx ->
  List (String, Option Loc, Mono) ->
  List (String, Option Loc, Scheme)
mapLocalSchemes mctx [] = []
mapLocalSchemes mctx ((n, l, m) :: rest) =
  (n, l, generalize mctx m) :: mapLocalSchemes mctx rest

-- ── value restriction (T1) ────────────────────────────────────────────────
-- A binding RHS is *non-expansive* (a syntactic value) iff it cannot allocate a
-- mutable cell: literals, variables and lambdas are values; annotations are
-- transparent; tuples/lists are values iff their elements are.  Constructor
-- applications of non-expansive arguments are non-expansive (SML value
-- restriction relaxation, Phase 66 extension) EXCEPT `Ref`, excluded by name in
-- `isCtorAppSpine` below: generalizing `Ref x` would be unsound (polymorphic
-- reference: write at one type, read at another).
--
-- 🔒 THE HEAD TEST IS AN ACTUAL CONSTRUCTOR LOOKUP, NOT A SPELLING TEST —
-- issue 1150 (S0, memory-safety), fixed 2026-08-26.  `isCtorAppSpine`'s head
-- arms ask `lookupCtor env name`, so the predicate now answers "is this name a
-- REAL, DECLARED constructor?" instead of "does this name start with a capital
-- letter?".  Threading the `TcEnv` this needs is why `isNonexpansive`,
-- `isCtorAppSpine`, `clausesAreValue`/`clauseIsValue`,
-- `memberClauseIsValue` and `sccSchemes` all take an env parameter.
--
-- What the old first-character heuristic (`ctorHeadShaped`, retained below
-- only as a cheap pre-filter) got wrong: a MODULE ALIAS is REQUIRED to be
-- uppercase (`aliasNameFor`, frontend/parser.mdk — lowercase is a hard parse
-- error) and an alias-qualified value desugars to a FLAT `EVar` carrying the
-- dotted name (`rewriteAliasQual`, frontend/desugar.mdk, via `qualifiedLocal`
-- in frontend/ast.mdk: `"\{alias}.\{n}"`).  So `ctorHeadIsUpper "H.new"` (its first form) read
-- `'H'` and said True: EVERY alias-qualified call in the language was
-- CLASSIFIED as a constructor application.  Classification is not the whole
-- test — `isCtorAppSpine (EApp f x) = isCtorAppSpine f && isNonexpansive x`
-- still rejects the spine if any argument is expansive, so `H.f (g 1)` was
-- classified but NOT generalized.  It was enough for the repro, whose argument
-- is a value: `let m = H.new ()` over `stdlib/hash_map.mdk` yielded a
-- polymorphic mutable table — `check` exit 0, `run` E-NOT-A-FUNCTION, built
-- binary SEGFAULT.  Under the lookup, `"H.new"` is absent from the ctor map and
-- the binding is value-restricted: `check` REJECTS the program.
--
-- Why the lookup is sound (i.e. why "present in the ctor map" implies "really a
-- constructor").  `lookupCtor` reads `TcEnv`'s 2nd `OrdMap`, and that map is
-- written in exactly TWO places — `addCtor` (sole call site, inside
-- `addVariants`, reached only from `registerVariants`, itself called only from
-- `registerData`'s `DData` and `DNewtype` arms) and the two prelude ctors
-- `True`/`False`, hand-seeded straight into the map by `builtinCtors`, bypassing
-- `addCtor` entirely.  Both writers are constructor-only.  ("Populated only by
-- `addCtor`", which this comment asserted until 2026-07-31, was false — hence
-- the second clause.)  Re-derive with
-- `grep -n 'addCtor\|builtinCtors' compiler/types/typecheck.mdk`.
--
-- The uppercase-mutable-cell-extern hazard this comment used to warn about is
-- retired BY CONSTRUCTION rather than by audit: the grammar still permits an
-- uppercase extern NAME (`externNameFor (TUpper x) = emit x`,
-- frontend/parser.mdk, vs `identNameFor`, which accepts only `TIdent`), but an
-- extern is never passed to `addCtor`, so no extern — uppercase or not — can
-- pass the head test any more.  `Ref` (`extern Ref : a -> Ref a`,
-- stdlib/runtime.mdk) is exactly such an extern; its by-name exclusion is kept
-- below purely as defense-in-depth, since the lookup alone already rejects it.
-- See issue 1150 and docs/spec/DICT-SEMANTICS.md §4.1 G2.
--
-- Record creates are non-expansive iff all field expressions are.
-- Note: this ignores the `mut` flag (like the oracle), so `let mut x = []`
-- generalizes — the separate `mut`-gen hole is a both-sides follow-up (T1b).
isNonexpansive : TcEnv -> Expr -> Bool
isNonexpansive env (ELoc _ e) = isNonexpansive env e
isNonexpansive env (EDoOrigin _ e) = isNonexpansive env e
isNonexpansive env (ELit _) = True
isNonexpansive env (EVar _) = True
isNonexpansive env (EVarId _ _) = True
-- `run`/`build` rewrite a method reference into a dictionary-marked node before
-- typechecking (`prePassDict`); the marked node is still a variable, so the value
-- predicate must answer as it does for the `EVar` that `check` sees — otherwise
-- `callMin = min` is a value under one verb and expansive under another
-- (check green, build panics on an unbound dictionary witness).
isNonexpansive env (EMethodAt _ _ _) = True
isNonexpansive env (EDictAt _ _) = True
isNonexpansive env (EMethodRef _) = True
isNonexpansive env (ELam _ _) = True
isNonexpansive env (EAnnot e _) = isNonexpansive env e
isNonexpansive env (EHeadAnnot e _) = isNonexpansive env e
isNonexpansive env (ETuple es) = allList (isNonexpansive env) es
isNonexpansive env (EListLit es) = allList (isNonexpansive env) es
-- Constructor application: non-expansive iff the spine head is an EVar naming a
-- REAL, DECLARED constructor (`lookupCtor env`, see the 🔒 above and issue
-- 1150) — that is NOT `Ref`, and every spine argument is itself non-expansive.
-- Partial ctor applications (e.g. `MkTwo []`) are also non-expansive — they are
-- closures, not mutable cells.  `isCtorAppSpine` strips ELoc/EDoOrigin wrappers
-- before testing.
isNonexpansive env (app@(EApp _ _)) = isCtorAppSpine env app
-- Record creation: non-expansive iff every field expression is non-expansive.
isNonexpansive env (ERecordCreate _ fs) =
  allList
    (fa => match fa
      FieldAssign _ e => isNonexpansive env e)
    fs
isNonexpansive env _ = False

-- Walk the left spine of an application to its head, testing EVERY argument met
-- on the way, and finally test whether the head IS a constructor that is safe to
-- generalize: an EVar naming a constructor DECLARED in this `TcEnv`, asked of
-- the environment via `lookupCtor` rather than guessed from the name's spelling
-- (issue 1150, fixed 2026-08-26 — see the 🔒 on `isNonexpansive` above for why
-- the ctor map's two writers make the lookup sound).  `Ref` stays excluded by
-- name as defense-in-depth: it is an extern FUNCTION, never passed to
-- `addCtor`, so `lookupCtor` already rejects it on its own.
--
-- `ctorHeadShaped` is retained as a pure FAST PATH in front of the lookup: an
-- ordinary function-application head — the overwhelmingly common `let` RHS —
-- fails on a character read instead of an `OrdMap` probe.  It can only ever
-- narrow, never widen.  It DID narrow on the emit path (#2089's census): the
-- emitter's tree carries constructors mangled to `<mid>__<Ctor>`
-- (`types/private_mangle.mdk`), so a first-character-uppercase test judged every
-- constructor CAF (`regEmpty = Registry omEmpty`) expansive there, narrowed it at
-- first use, and every later use at another element type was a type mismatch —
-- discarded, because nothing read them.  The fast path now accepts both spellings.
--
-- The arguments are tested HERE, on the single walk to the head, rather than by
-- re-entering `isNonexpansive` at each `EApp` level: re-entering would re-walk
-- the whole spine per level, i.e. quadratic in the constructor's arity.  Testing
-- only the LAST argument was issue 1139 — a `Ref` in any non-final position
-- escaped the exclusion entirely, so `let b = BR (Ref []) True` generalized and
-- a cell written at `Int` could be read at `Int -> Int`.
--
-- The head is tested BEFORE the argument: `&&` short-circuits, and the common
-- RHS at a `let` is an ordinary function application, whose head fails the test
-- immediately.  Testing the argument first would walk its whole subtree before
-- discovering the spine was never a constructor application at all.  Both
-- operands are pure `Bool`, so the order is semantically invisible.
isCtorAppSpine : TcEnv -> Expr -> Bool
isCtorAppSpine env (ELoc _ e) = isCtorAppSpine env e
isCtorAppSpine env (EDoOrigin _ e) = isCtorAppSpine env e
isCtorAppSpine env (EApp f x) = isCtorAppSpine env f && isNonexpansive env x
isCtorAppSpine env (EVar name) = isDeclaredCtorHead env name
isCtorAppSpine env (EVarId name _) = isDeclaredCtorHead env name
isCtorAppSpine env _ = False

-- The head test itself: `name` is a real, declared constructor and is not the
-- `Ref` extern.  See `isCtorAppSpine`'s docblock for why `lookupCtor` is the
-- authority, why `ctorHeadShaped` is only a fast path in front of it, and why
-- the `Ref` exclusion is redundant-but-kept.
isDeclaredCtorHead : TcEnv -> String -> Bool
isDeclaredCtorHead env name =
  name /= "Ref" && ctorHeadShaped name && isSome (lookupCtor env name)

-- Spelled like a data constructor: uppercase-initial, or a mangled `<mid>__<Ctor>`
-- whose segment after the FIRST `__` is uppercase-initial (`private_mangle` joins
-- with one `__`, and a module id never contains one).  A spelling pre-filter only;
-- `lookupCtor` decides.
ctorHeadShaped : String -> Bool
ctorHeadShaped name =
  let cs = stringToChars name
  let n = arrayLength cs
  n > 0 && (isUpper (arrayGetUnsafe 0 cs) || mangledCtorShaped cs n 0)

mangledCtorShaped : Array Char -> Int -> Int -> Bool
mangledCtorShaped cs n i
  | i + 2 >= n = False
  | arrayGetUnsafe i cs == '_'
    && arrayGetUnsafe (i + 1) cs == '_'
    && isUpper (arrayGetUnsafe (i + 2) cs) = True
  | otherwise = mangledCtorShaped cs n (i + 1)

-- Generalize a value RHS; value-restrict (monomorphize, lowering free vars)
-- otherwise.  monoScheme leaves the mono ungeneralized.
genBindingRestricted : DynCtx ->
  Map Int Unit ->
  List AuthResidual ->
  Bool ->
  EffRow ->
  Mono ->
  Scheme
genBindingRestricted dyn declared residual isValue force t
  | isValue = generalizeBindingDeclared dyn declared residual force t
  | otherwise =
    let _ = lowerToCurrent dyn.dcModule t
    let _ = lowerRowLevels dyn.dcModule.mcCells.currentLevel.value force
    -- a binding that turns out monomorphic after its scope kept residuals
    -- (a local pinned for dictionary forwarding) owes them where it lives
    let _ =
      fold
        (_ r =>
          let _ =
            lowerAuthLevels dyn.dcModule.mcCells.currentLevel.value r.arLower
          let _ =
            lowerAuthLevels dyn.dcModule.mcCells.currentLevel.value r.arUpper
          wantAuthorityWith dyn.dcModule r.arExact r.arLower r.arUpper)
        ()
        residual
    Forall [] [] [] [] force t

-- A constructor in PATTERN position: its universals freshen as at any use,
-- but an existential binder (§4.1) is OPENED — a fresh RIGID authority the
-- arm may relate values by and never solve — and parked for the pattern
-- site (`takePatLits`/`settlePatLits`), which decides whether it may open one.
instantiateCtorPattern : ModuleCtx -> Scheme -> Mono
instantiateCtorPattern mctx (Forall ids evars avars _ _ t) =
  let (asub, opened) = freshAuthSubstOpening mctx avars t
  let _ = openExistentials mctx opened
  substMono mctx.mcGraph (freshSubst mctx ids) (freshEffSubst mctx evars) asub t

openExistentials : ModuleCtx -> List (Ref Authvar) -> Unit
openExistentials mctx [] = ()
openExistentials mctx cells =
  let _ = markSourceless mctx.mcGraph (map authvarId cells)
  mctx.mcCells.openedExistentialsRef :=
    cells ++ mctx.mcCells.openedExistentialsRef.value

-- The context the module last checked recorded for its binding [n].
ownContext : ModuleCtx -> String -> List VecObl
ownContext mctx n =
  -- #837: key the obligation lookup by (name, binding-id), exactly as the check-path
  -- reader does — recovering the id from schemeDefIdsRef (top-level binders of the
  -- module last checked).  With the leak-guard windows retired this is what stops a
  -- where-helper `g`'s obligation rendering on an unrelated top-level `g`; a binder
  -- absent from schemeDefIdsRef (id 0) falls to the bare-name scan (today's path).
  let id = optionOr 0 (omLookup n mctx.mcCells.schemeDefIdsRef.value)
  optionOr [] (lookupSchemeObls n id mctx.mcCells.schemeObligationsRef.value)

-- A module's own schemes, each with its context, taken when the module closes:
-- [mctx] still holds that module's tables, and the next module's check
-- mints its own record.
publishOwn : ModuleCtx -> List (String, Scheme) -> List (String, PubScheme)
publishOwn mctx = publishWithContexts (ownContext mctx)

-- Core's own obligations, keyed by bare name (#837: the binding-id half of each
-- key is dropped, as every cross-module reader looks a prelude name up by name).
-- Read right after the core pass, from the record [mctx] core was checked in.
coreOwnContexts : ModuleCtx -> OrdMap (List VecObl)
coreOwnContexts mctx =
  omFromPairs
    (map (kv => (fst (fst kv), snd kv)) mctx.mcCells.schemeObligationsRef.value)
    omEmpty

-- The context a seed name renders with, by three steps in order.  A name the
-- module last checked BINDS takes that module's own context, or none, and never
-- reaches the prelude store, so a buffer's own `isEven x = "s"` cannot pick up the
-- prelude `isEven`'s context (#2054's shape).  The prelude's contexts are consulted
-- ONLY for a name this module does not bind and whose per-run table has no entry
-- at all: on the module arm each module gets its own `freshModuleCtx`, so the
-- prelude's obligations are not in [mctx], and a prelude scheme would otherwise
-- render without its `=>`.
-- The third step reads [coreContexts], the prelude's contexts keyed by bare name.
seedContext : ModuleCtx -> OrdMap (List VecObl) -> String -> List VecObl
seedContext mctx coreContexts n =
  match omLookup n mctx.mcCells.schemeDefIdsRef.value
    Some _ => ownContext mctx n
    None => match lookupSchemeObls n 0 mctx.mcCells.schemeObligationsRef.value
      Some obs => obs
      None => optionOr [] (omLookup n coreContexts)

-- The last module of [modules], checked in [mctx]: its locals and its import seed,
-- frozen with their contexts.  The seed's prelude contexts come from
-- [coreContexts], `graphPreamble`'s snapshot.
captureEntryTables : ModuleCtx ->
  OrdMap (List VecObl) ->
  List (String, List Decl) ->
  EntryTables
captureEntryTables mctx coreContexts modules = match last modules
  None => noEntryTables
  Some (mid, _) => EntryTables {
    etModule = mid,
    etLocals =
      map
        ((n, loc, s) => (n, freezePub s (ownContext mctx n), loc))
        mctx.mcCells.localSchemesOut.value,
    etSeed =
      map
        (b => (
          fst b,
          freezePub (snd b) (seedContext mctx coreContexts (fst b)),
        ))
        mctx.mcCells.seedSchemesOut.value,
  }

lookupImportedStandalone : TcEnv -> String -> Option Scheme
lookupImportedStandalone env name = match lookupBinding env name
  Some binding => match binding.ebStandalone
    Some (ImportedStandalone, value) => Some value.vsScheme
    _ => None
  None => None

bindingDeclaredAt : TcEnv ->
  String ->
  MethodTrackedInstantiation ->
  Option CDeclared
bindingDeclaredAt env name inst =
  declaredEffectsAt env.teDyn.dcModule.mcGraph inst (bindingDeclared env name)

-- Slot projection below applies the type substitution after superclass expansion;
-- effect-index arguments use the same occurrence's row substitution here.
declaredEffectsAt : GraphCtx ->
  MethodTrackedInstantiation ->
  Option CDeclared ->
  Option CDeclared
declaredEffectsAt gctx inst declared =
  map
    (dc => CDeclared {
      cdSlots = dc.cdSlots,
      cdPrefix = dc.cdPrefix,
      cdArgs =
        map
          (map
            (substMono
              gctx
              []
              inst.mtiSubstitution.misEffectSubst
              inst.mtiSubstitution.misAuthSubst))
          dc.cdArgs,
    })
    declared

recordDeclaredBindingCall : ModuleCtx -> CDeclared -> List (Int, Mono) -> Unit
recordDeclaredBindingCall mctx dc subst =
  let expanded = dedupSlotVecs (zipSlotVecs dc.cdSlots dc.cdArgs)
  recordCallObligations
    mctx
    (map fst expanded)
    (constraintMonosOf (map (pair => (fst pair).csId) expanded) subst)
    (callArgVecsV mctx.mcGraph expanded subst)

-- ── pattern inference: returns the pattern's type + the bindings it adds ───
inferPat : TcEnv -> Pat -> (Mono, List (String, Scheme))
inferPat env (PVar x xloc bid) =
  let v = freshVar env.teDyn.dcModule ()
  let _ = recordLocalBind env.teDyn.dcModule x (Some xloc) bid v
  (v, [(x, monoScheme v)])
inferPat env PWild = (freshVar env.teDyn.dcModule (), [])
inferPat env (PLit (LInt n)) = inferIntLitPat env.teDyn.dcModule n
inferPat env (PLit (LU64 hi lo)) = inferU64LitPat env.teDyn.dcModule hi lo
inferPat env (PLit (LI64 hi lo)) =
  let _ =
    refuseBoxedLitPat
      env.teDyn.dcModule
      "I64"
      (i64HalvesLiteral hi lo)
      env.teDyn.dcModule.mcLoc
  (tconBuiltin "I64", [])
inferPat env (PLit l) = (litType l, [])
inferPat env (PCon name pats) = inferPatCon env name pats
inferPat env (PTuple pats) = inferPatTuple env pats
inferPat env (PCons h t) = inferPatCons env h t
inferPat env (PList pats) = inferPatList env pats
inferPat env (PAs x xloc bid p) = inferPatAs env x xloc bid p
inferPat env (PRec name fields _) = inferPatRec env name fields
inferPat env (PRng lo hi _) = inferPatRng env.teDyn.dcModule lo hi
inferPat env _ = panic "typecheck: unsupported pattern"

-- range pattern `lo..hi` / `lo..=hi`: only Int and Char bounds are valid
-- binds no variables
inferPatRng : ModuleCtx -> Lit -> Lit -> (Mono, List (String, Scheme))
inferPatRng mctx (LInt _) (LInt _) = (tconBuiltin "Int", [])
inferPatRng mctx (LChar _) (LChar _) = (tconBuiltin "Char", [])
inferPatRng mctx lo hi =
  let _ =
    pushTypeError
      mctx
      "T-TYPE-MISMATCH"
      "type mismatch: \{ppMono (litType lo)} vs \{ppMono (litType hi)}"
  (tconBuiltin "Int", [])

inferPatRec : TcEnv ->
  String ->
  List RecPatField ->
  (Mono, List (String, Scheme))
inferPatRec env name fields = match lookupRecordByName env.teDyn.dcModule name
  None =>
    let _ =
      pushTypeError
        env.teDyn.dcModule
        "T-UNKNOWN-RECORD"
        (unknownRecordMsg name)
    (freshVar env.teDyn.dcModule (), bindRecPatFieldsFresh env fields)
  Some ri => inferPatRecWith env name ri fields
-- bind the field pattern vars with fresh types (no field-type info) so the
-- arm body still typechecks; the oracle fails fast on the unknown record, we
-- accumulate, so dropping the bindings would raise spurious unbound-var errors

-- bind a record pattern's fields against fresh types, NO unknown-field check
-- (the record itself is already-reported unknown; see inferPatRec error path)
bindRecPatFieldsFresh : TcEnv -> List RecPatField -> List (String, Scheme)
bindRecPatFieldsFresh env [] = []
bindRecPatFieldsFresh env ((RecPatField fname _ bid mp) :: rest) =
  inferRecPatFieldWith env (freshVar env.teDyn.dcModule ()) fname bid mp
    ++ bindRecPatFieldsFresh env rest

inferPatRecWith : TcEnv ->
  String ->
  RecordInfo ->
  List RecPatField ->
  (Mono, List (String, Scheme))
inferPatRecWith env rname ri fields =
  let (ir, opened) = instantiateRecordOpening env.teDyn.dcModule ri
  let _ = openExistentials env.teDyn.dcModule opened
  (fst ir, inferRecPatFields env rname (snd ir) fields)

inferRecPatFields : TcEnv ->
  String ->
  List (String, Mono) ->
  List RecPatField ->
  List (String, Scheme)
inferRecPatFields env _ _ [] = []
inferRecPatFields env rname fieldTypes ((RecPatField fname _ bid mp) :: rest) =
  inferRecPatField env rname fieldTypes fname bid mp
    ++ inferRecPatFields env rname fieldTypes rest

inferRecPatField : TcEnv ->
  String ->
  List (String, Mono) ->
  String ->
  BinderId ->
  Option Pat ->
  List (String, Scheme)
inferRecPatField env rname fieldTypes fname bid mp =
  match lookupAssoc fname fieldTypes
    None =>
      let _ =
        pushTypeError
          env.teDyn.dcModule
          "T-UNKNOWN-FIELD"
          (unknownFieldMsg fname rname)
      inferRecPatFieldWith env (freshVar env.teDyn.dcModule ()) fname bid mp
    Some ft => inferRecPatFieldWith env ft fname bid mp
-- bind the field's pattern vars against a fresh type so the arm body still
-- typechecks (the oracle fails fast on the unknown field; we accumulate, so
-- skipping the binding would raise spurious downstream unbound-variable errors)

-- A pun binds the field's own type.  It is published to the runtime-type table
-- but not to the LSP hover list, which has never carried puns.
inferRecPatFieldWith : TcEnv ->
  Mono ->
  String ->
  BinderId ->
  Option Pat ->
  List (String, Scheme)
inferRecPatFieldWith env ft fname bid None =
  let _ = recordBinderType env.teDyn.dcModule.mcGraph bid fname ft None False
  [(fname, monoScheme ft)]
inferRecPatFieldWith env ft _ _ (Some p) =
  let pr = inferPat env p
  let _ = bindFrom env.teDyn (fst pr) ft
  snd pr

-- INTEGER-TYPES-DESIGN §3.2 item 5: an integer literal PATTERN takes its type from
-- the scrutinee when that is a builtin integer head, and is `Int` otherwise.  It is
-- inferred as a fresh var and parked on `patLitPending`; the pattern site that
-- unifies the pattern with its scrutinee (or a signature's domain) then settles it
-- with `settlePatLits`, or defers it to `generalize` when the scrutinee's type is
-- not known yet.  Either way the var is settled before anything can quantify it,
-- so a literal pattern never makes a binding polymorphic.
inferIntLitPat : ModuleCtx -> Int -> (Mono, List (String, Scheme))
inferIntLitPat mctx n =
  let a = freshVar mctx ()
  mctx.mcCells.patLitPending :=
    (a, n, mctx.mcLoc) :: mctx.mcCells.patLitPending.value
  (a, [])

-- Open a pattern site: park the literals of any enclosing site and start
-- empty.  The existentials a pattern opens are parked the same way; a match
-- arm or a clause takes them (`takeOpenedExistentials`) before settling, every
-- other site finds them still parked at `settlePatLits` and refuses them,
-- since only an arm or a clause has a scope to close them in.
takePatLits : ModuleCtx -> Unit -> List (Mono, Int, Option Loc)
takePatLits mctx _ =
  let _ = parkOpenedExistentials mctx ()
  let saved = mctx.mcCells.patLitPending.value
  mctx.mcCells.patLitPending := []
  saved

-- Close a pattern site, after its pattern met its scrutinee.  A literal whose var
-- is now a fixed-width head keeps that type and joins the literal range check; one
-- whose var is any other type is `Int`, exactly as a literal pattern always was (a
-- non-integer scrutinee is the same `Int vs T` mismatch).  A var still unknown here
-- (a lambda's parameter, typed only by a later argument) is deferred: `generalize`
-- defaults it to `Int` before it could be quantified, and the module's end settles
-- whatever remains (`settleDeferredPatLits`).
settlePatLits : DynCtx -> List (Mono, Int, Option Loc) -> Unit
settlePatLits dyn saved =
  let _ = refuseOpenedExistentials dyn.dcModule ()
  settlePatLitsOnly dyn saved

parkOpenedExistentials : ModuleCtx -> Unit -> Unit
parkOpenedExistentials mctx _ =
  mctx.mcCells.openedExistentialsStackRef :=
    mctx.mcCells.openedExistentialsRef.value
      :: mctx.mcCells.openedExistentialsStackRef.value
  mctx.mcCells.openedExistentialsRef := []

-- The existentials the current pattern site opened, handed to the site that
-- may close them; the site's accumulator is left empty for `settlePatLits`.
takeOpenedExistentials : ModuleCtx -> Unit -> List (Ref Authvar)
takeOpenedExistentials mctx _ =
  let opened = mctx.mcCells.openedExistentialsRef.value
  mctx.mcCells.openedExistentialsRef := []
  opened

refuseOpenedExistentials : ModuleCtx -> Unit -> Unit
refuseOpenedExistentials mctx _ =
  let opened = mctx.mcCells.openedExistentialsRef.value
  let _ = match opened
    [] => ()
    cell :: _ =>
      pushTypeErrorAt
        mctx
        "T-AUTHORITY-EXISTENTIAL-SCOPE"
        mctx.mcLoc
        (existentialScopeMsg (authvarName cell))
  match mctx.mcCells.openedExistentialsStackRef.value
    outer :: rest =>
      mctx.mcCells.openedExistentialsRef := outer
      mctx.mcCells.openedExistentialsStackRef := rest
    [] => mctx.mcCells.openedExistentialsRef := []

settlePatLitsOnly : DynCtx -> List (Mono, Int, Option Loc) -> Unit
settlePatLitsOnly dyn saved =
  let _ = settlePatLitsGo dyn False dyn.dcModule.mcCells.patLitPending.value
  dyn.dcModule.mcCells.patLitPending := saved

-- [final]: the module is done, so an unknown var defaults instead of deferring.
settlePatLitsGo : DynCtx -> Bool -> List (Mono, Int, Option Loc) -> Unit
settlePatLitsGo dyn _ [] = ()
settlePatLitsGo dyn final ((a, n, loc) :: rest) =
  let _ = match normalize a
    TCon tag _ if isTaggedFixedHead tag =>
      dyn.dcModule.mcCells.numlitRanges :=
        (a, n, loc) :: dyn.dcModule.mcCells.numlitRanges.value
    TCon tag _ if isBoxed64Head tag =>
      refuseBoxedLitPat dyn.dcModule tag (intToString n) loc
    TVar _ if not final =>
      dyn.dcModule.mcCells.patLitDeferred :=
        (a, n, loc) :: dyn.dcModule.mcCells.patLitDeferred.value
    _ => unifyIn (dynAtIfSome loc dyn) (tconBuiltin "Int") a
  settlePatLitsGo dyn final rest

-- The module's inference is complete: every deferred literal pattern takes the
-- type its scrutinee finally got, or `Int`.
settleDeferredPatLits : ModuleCtx -> Unit -> Unit
settleDeferredPatLits mctx _ =
  let deferred = mctx.mcCells.patLitDeferred.value
  mctx.mcCells.patLitDeferred := []
  settlePatLitsGo (dynFor mctx) True deferred

-- A `U64` or `I64` is a boxed cell, and no engine's pattern matcher compares one
-- against a constant, so a literal pattern cannot match it (INTEGER-TYPES-DESIGN
-- §3.2 item 5 builds the tagged heads only).  Refused, never compiled to an arm
-- that silently never matches: an ordinary literal whose scrutinee grounded to
-- `U64` or `I64` (`settlePatLitsGo`), and a wide one wherever it is written
-- (`exprToPat` keeps it as `LU64`).
refuseBoxedLitPat : ModuleCtx -> String -> String -> Option Loc -> Unit
refuseBoxedLitPat mctx tag lit loc =
  recordTypeError
    mctx
    (TcDiag
      "T-TYPE-MISMATCH"
      1
      (orElseLoc loc mctx.mcLoc)
      "the literal pattern `\{lit}` cannot match \{if isI64Head tag then "an" else "a"} `\{tag}`; compare in a guard instead"
      (Some "compare in a guard instead: `x if x == \{lit}`")
      None)

inferU64LitPat : ModuleCtx -> Int -> Int -> (Mono, List (String, Scheme))
inferU64LitPat mctx hi lo =
  let _ = refuseBoxedLitPat mctx "U64" ("0x" ++ u64HalvesHex hi lo) mctx.mcLoc
  (tconBuiltin "U64", [])

inferPatCon : TcEnv -> String -> List Pat -> (Mono, List (String, Scheme))
inferPatCon env name pats = match lookupCtor env name
  None =>
    let _ =
      pushTypeError env.teDyn.dcModule "T-UNKNOWN-CTOR" (unknownCtorMsg name)
    let pr = inferPats env pats
    (freshVar env.teDyn.dcModule (), snd pr)
  Some scheme => inferPatConWith env scheme pats
-- still infer the sub-patterns so their bindings reach the arm body
-- (else the continued path raises spurious unbound-variable errors the
-- oracle never reaches — it fails fast on the unknown constructor)

inferPatConWith : TcEnv -> Scheme -> List Pat -> (Mono, List (String, Scheme))
inferPatConWith env scheme pats =
  let ctorType = instantiateCtorPattern env.teDyn.dcModule scheme
  let pr = inferPats env pats
  let resultVar = freshVar env.teDyn.dcModule ()
  let _ = unifyIn env.teDyn ctorType (foldrFun (fst pr) resultVar)
  (resultVar, snd pr)

inferPats : TcEnv -> List Pat -> (List Mono, List (String, Scheme))
inferPats env [] = ([], [])
inferPats env (p :: ps) =
  let pr = inferPat env p
  let rest = inferPats env ps
  (fst pr :: fst rest, snd pr ++ snd rest)

inferPatTuple : TcEnv -> List Pat -> (Mono, List (String, Scheme))
inferPatTuple env pats =
  let pr = inferPats env pats
  (tupleMono (fst pr), snd pr)

inferPatCons : TcEnv -> Pat -> Pat -> (Mono, List (String, Scheme))
inferPatCons env h t =
  let hr = inferPat env h
  let tr = inferPat env t
  let listTy = TApp (tconBuiltin "List") (fst hr)
  let _ = unifyIn env.teDyn (fst tr) listTy
  (listTy, snd hr ++ snd tr)

inferPatList : TcEnv -> List Pat -> (Mono, List (String, Scheme))
inferPatList env pats =
  let elem = freshVar env.teDyn.dcModule ()
  let pr = inferPats env pats
  let _ = unifyAll env.teDyn elem (fst pr)
  (TApp (tconBuiltin "List") elem, snd pr)

inferPatAs : TcEnv ->
  String ->
  Loc ->
  BinderId ->
  Pat ->
  (Mono, List (String, Scheme))
inferPatAs env x xloc bid p =
  let pr = inferPat env p
  let _ = recordLocalBind env.teDyn.dcModule x (Some xloc) bid (fst pr)
  (fst pr, (x, monoScheme (fst pr)) :: snd pr)

-- ── expression inference ──────────────────────────────────────────────────
infer : TcEnv -> Expr -> Mono
infer env (ELit l) = litType l
-- PLAN.md #11: a source integer literal is `Num a` for a fresh `a`.  With the
-- prelude loaded (Num registered + `fromInt` in scope), model the literal exactly
-- as `fromInt n`.  inferMethodAt
-- "fromInt" records the Num impl obligation AND a pendingSite keyed on [dref] (the
-- node's route cell), so resolveSites later stamps [dref]: RKey when the literal's
-- type grounds to a concrete Num head, RDictFwd onto the enclosing `Num a` dict when
-- it stays polymorphic (the soundness case, `1` in `inc x = x + 1` — exactly the
-- route `fromInt 0` in `sum` gets).  Apply the `Int -> a` method type to an Int arg
-- (mirror OCaml's `unify from_int_ty (TFun t_int … a)`) to recover the result var
-- [a], and stash (a, fref, n, dref) in numlitRefs so the post-HM setNumlitFloats can
-- decide concrete-Float / concrete-Int / still-poly.  Recording the obligation here
-- AND (when under `+`) in numArithOp is harmless: both unify the same var, both
-- demand `Num`.  Without the prelude (bare-HM oracle, `builtinClassPresent BNum` False)
-- `fromInt` is unbound: fall back to a plain fresh var, dref stays RNone (⇒ Int).
infer env (ENumLit n ev _) = inferNumLit env n ev
infer env (EWideLit hi lo ev lx) = inferWideLit env hi lo ev lx
infer env (EVar x) = inferVar env x
-- #837: EVarId carries the resolve-minted binding id; thread it to
-- instantiateVarTracked so obligation lookup keys by (name, id).
infer env (EVarId x id) = inferVarId env x id
infer env (EApp f x) = inferAppExpr env f x
infer env (ELam pats body) = inferLam env pats body
infer env (ELet _ isFun pat e1 e2) = inferLet env isFun pat e1 e2
infer env (ELetGroup binds body) = inferLetGroup env binds body
infer env (EIf c t e) = inferIf env c t e
infer env (EMatch scrut arms) = inferMatch env (infer env scrut) arms
infer env (ETuple es) = tupleMono (inferEach env es)
infer env (EListLit es) = inferListLit env es
infer env (EAnnot e ty) = inferAnnot env e ty
infer env (EBinOp op l r ev) =
  inferBinopE env op l r (siteRouteCell env.teDyn.dcModule.mcGraph ev)
-- An operator or a field access the parser leaves unwrapped names its own span
-- (its operand's: the operator and the field name carry none).
infer env (EUnOp op e ev) =
  inferUnopE
    (envAtIfSome (exprSpanLoc e) env)
    op
    e
    (siteRouteCell env.teDyn.dcModule.mcGraph ev)
infer env (EInfix op l r) = inferInfix env op l r
infer env (ERecordCreate name fields) = inferRecordCreate env name fields
infer env (EFieldAccess e fname ev) =
  inferFieldAccess (envAtIfSome (exprSpanLoc e) env) e fname ev
infer env (ERecordUpdate base fields ev) = inferRecordUpdate env base fields ev
infer env (EVariantUpdate cname base fields) =
  inferVariantUpdate env cname base fields
infer env (EBlock stmts) = inferBlock env stmts
infer env (EMethodAt name _ ev) =
  inferMethodAtCell env name (methodCellOf env.teDyn.dcModule.mcGraph ev)
infer env (EDictAt name ev) = inferGrantedAt env name ev
infer env (EArrayLit es) = inferArrayLit env es
infer env (ERangeList lo hi _) = inferIntRange env lo hi (tconBuiltin "List")
infer env (ERangeArray lo hi _) = inferIntRange env lo hi (tconBuiltin "Array")
-- EIndex is desugared to an `index` method call before typecheck (Phase #16b);
-- the built-in index-inference path is retired, so no `EIndex` arm here.  ESlice
-- is likewise desugared to a `slice` method call before typecheck (#670), so
-- no `ESlice` arm here -- a surviving one is a desugar-ordering bug and hits the
-- loud "unsupported expression" catch-all, and a non-container receiver becomes a
-- "no impl of Slice" constraint error via normal method dispatch.
infer env (EHeadAnnot e ty) = inferHeadAnnot env e ty
-- ELoc is transparent: the wrapped expression and every check inside it are
-- located at this span, until a nested construct names its own.
infer env (ELoc l e) = infer (envAt (Some l) env) e
-- Phase 150: a do-lowered chain.  Record the do-block loc so a monad-shape
-- mismatch during inference is retargeted to the tailored "do requires a monad"
-- error (see typeMismatch).  The chain's walk gets its own context; an inline
-- nested `do` block (`a <- (do ...)`) mints another, so its first report never
-- un-blames a LATER statement of the outer chain (#894 review finding 2).
infer env (EDoOrigin l e) =
  -- #824: the lowered chain's synthesized callee names the herald
  -- (`deferThen` for a `defer` block), so the "requires a monad" reframe can
  -- name the right interface.
  let doCtx = DoCtx {
    doLoc = l,
    doDeferred = doChainIsDeferred e,
    doReported = Ref False,
  }
  infer { env | teDyn = { env.teDyn | dcDo = Some doCtx } } e

infer env _ = panic "typecheck: unsupported expression"

-- is this lowered do-chain a `defer` block?  Its head callee is the tagged
-- `deferThen` (see `callAndThen` in desugar.mdk).
doChainIsDeferred : Expr -> Bool
doChainIsDeferred (EApp f _) = doChainIsDeferred f
doChainIsDeferred (ELoc _ e) = doChainIsDeferred e
doChainIsDeferred (EDoOrigin _ (EVar "deferThen")) = True
doChainIsDeferred (EDoOrigin _ (EVarId "deferThen" _)) = True
doChainIsDeferred _ = False

inferArrayLit : TcEnv -> List Expr -> Mono
inferArrayLit env es =
  let elem = joinValueTypes env.teDyn JoinArray (inferProduced env es)
  TApp (tconBuiltin "Array") elem

-- [lo..hi] : List Int, [|lo..hi|] : Array Int
inferIntRange : TcEnv -> Expr -> Expr -> Mono -> Mono
inferIntRange env lo hi container =
  let _ = unifyIn env.teDyn (infer env lo) (tconBuiltin "Int")
  let _ = unifyIn env.teDyn (infer env hi) (tconBuiltin "Int")
  TApp container (tconBuiltin "Int")

-- (ESlice's `inferSlice`/`indexKind` were retired with #670: `a.[lo..hi]` now
-- desugars to a `slice` method call before typecheck, so slicing infers
-- through normal interface dispatch on `Slice`, not a bespoke arm here.)

-- a method occurrence.  Return-position: record (routeRef, result mono) so
-- resolveSites can stamp RKey/RDict.  D3a arg-position (name in
-- argDispatchIdxByIdRef): the dispatch is decided by the DISCRIMINATING-ARGUMENT type,
-- not the result, so queue recordArgStamp on the arg-position mono instead — it is
-- NOT a pendingSites/methodSiteFns return-position site.
inferMethodAt : TcEnv ->
  String ->
  Ref String ->
  Ref (Option Int) ->
  Ref Route ->
  Ref (List Route) ->
  Ref (List Route) ->
  Ref Inner ->
  Mono
inferMethodAtCell : TcEnv -> String -> EvCell -> Mono
inferMethodAtCell env name c =
  let st = env.teDyn.dcModule.mcGraph.graphRun.grants
  st.gsLastMethodInst := None
  st.gsLastStandalone := None
  c.ecLoc := env.teDyn.dcModule.mcLoc
  c.ecName := name
  let t =
    inferMethodAt
      env
      name
      c.ecIface
      c.ecArity
      c.ecTag
      c.ecImpl
      c.ecMeth
      c.ecInner
  let _ = match (st.gsLastStandalone.value, st.gsLastMethodInst.value)
    (Some (scheme, subst), _) =>
      recordStandaloneGrantOcc
        env.teDyn.dcModule
        name
        c.ecId
        scheme
        subst
        (optionOr 0 c.ecArity.value)
    (None, Some (scheme, subst)) =>
      recordMethodGrantOcc env.teDyn.dcModule name c.ecId scheme subst
    (None, None) => ()
  t

-- #2705: a standalone-shadow occurrence (a user fn spelled like an interface
-- method — `add x y = x + y` beside `Num`'s `add`) DENOTES THE STANDALONE, whose
-- scheme may carry an inferred or declared context.  Instantiate that context as
-- call obligations exactly as the plain-`EVar` path does
-- (`instantiateVarTrackedId`), so the verdict — `No impl of Num for String` on
-- `add "a" "b"` — is the obligation channel's on every driver, not something the
-- check pass supplies for the emit pass.  The shadow-dict recorders beside this
-- carry SLOTS only; obligations were never theirs.  MEASURED: without this,
-- marking the check drivers let that program through at exit 0.
-- A non-shadow method occurrence records nothing here: `lookupSchemeObls` keys by
-- binding name and a method is not a binding, and the cross-module store is only
-- consulted behind the same shadow gate.
recordShadowStandaloneObls : TcEnv -> String -> List (Int, Mono) -> Unit
recordShadowStandaloneObls env name subst
  | isDefinerShadow env.teDyn.dcModule name
    || isShadowStandalone
      env
      name =
    match (lookupSchemeObls
      name
      0
      env.teDyn.dcModule.mcCells.schemeObligationsRef.value)
      Some obs => recordSchemeCallObligations env.teDyn.dcModule 0 obs subst
      None => match declaredCrossModuleObls env.teDyn.dcModule name
        Some obs => recordSchemeCallObligations env.teDyn.dcModule 0 obs subst
        None => ()
  | otherwise = ()

inferMethodAt env name ifaceRef arityRef tagRef implRef methodRef innerRef =
  let selected = match standaloneValueBinding env name
    Some scheme => Some scheme
    None => standaloneValueBindingEmit env name tagRef
  match selected
    Some value =>
      let _ = rejectAdmittedValueOccurrence env.teDyn.dcModule name
      let sym = routeLocalSym !tagRef
      let occurrence =
        instantiateStandaloneOccurrence
          env
          name
          sym
          env.teDyn.dcModule.mcLoc
          value
      let inst = occurrence.svoInstance
      let dicts = occurrence.svoDicts
      env.teDyn.dcModule.mcGraph.graphRun.grants.gsLastStandalone :=
        Some (occurrence.svoScheme, inst.mtiSubstitution.misAuthSubst)
      arityRef := Some (funArity inst.mtiBody)
      let receiver = match methodDispatchIdx env.teDyn.dcModule name
        Some idx => optionOr inst.mtiBody (nthArgMono idx inst.mtiBody)
        None => inst.mtiBody
      let _ =
        pushSiteGoal
          env.teDyn.dcModule.mcGraph
          GKRLocalSite
          innerRef
          (PendingEntry
            name
            tagRef
            receiver
            env.teDyn.dcModule.mcCells.currentFn.value
            (SKRLocal sym True dicts.sdMonos dicts.sdIfaces dicts.sdArgVecs)
            env.teDyn.dcModule.mcLoc
            (captureScope env.teDyn.dcModule ())
            (freshEvId env.teDyn.dcModule ()))
      inst.mtiBody
    None =>
      inferMethodCandidateAt
        env
        name
        ifaceRef
        arityRef
        tagRef
        implRef
        methodRef
        innerRef

-- Selection precedes instantiation: the returned value, forcing row, obligations,
-- and route slots above share one occurrence's substitution. A discarded method
-- candidate must not supply a standalone value's receiver or dictionary cells.
inferMethodCandidateAt : TcEnv ->
  String ->
  Ref String ->
  Ref (Option Int) ->
  Ref Route ->
  Ref (List Route) ->
  Ref (List Route) ->
  Ref Inner ->
  Mono
inferMethodCandidateAt env name ifaceRef arityRef tagRef implRef methodRef innerRef =
  match lookupVar env name
    -- Routed standalone recovery already ran before candidate selection.
    None => panic ("unbound method: " ++ name)
    Some s =>
      let inst = instantiateMethodTracked env.teDyn.dcModule s
      let occurrence = inst.mtiBody
      let subst = inst.mtiSubstitution
      env.teDyn.dcModule.mcGraph.graphRun.grants.gsLastMethodInst :=
        Some (s, subst.misAuthSubst)
      arityRef := Some (funArity occurrence)
      ifaceRef := admittedIfaceWord env.teDyn.dcModule name
      let _ = recordRLocalSite env name tagRef innerRef occurrence
      let ret = match argDispatchOf env.teDyn.dcModule name
        Some idx =>
          let _ =
            recordMethodDicts
              env.teDyn.dcModule
              name
              methodRef
              innerRef
              subst.misTypeSubst
          -- One variable per omitted typaram, shared by the goal and the route.
          let omitted = methodOmittedVars env.teDyn.dcModule name
          let _ = recordMethodObligationGuarded env name s occurrence omitted
          let _ =
            recordArgStamp
              env.teDyn.dcModule
              env.teDyn.dcSuppressArgStamp
              name
              tagRef
              implRef
              innerRef
              idx
              occurrence
              omitted
          let _ = recordArgSiteFn env.teDyn.dcModule name idx occurrence
          occurrence
        None =>
          recordSite
            env
            name
            s
            ifaceRef
            tagRef
            implRef
            methodRef
            innerRef
            occurrence
            subst
      let _ = forceInstantiation env.teDyn.dcModule name inst
      ret
-- C5: if [name] is a standalone-shadow method, record its discriminating-arg
-- mono cell UNGATED so resolveRLocalSites can route RLocal when the receiver
-- grounds to a no-impl head (the arg-stamp path would otherwise leave it RNone
-- → arg-tag panic on a receiver with no impl).

-- Cause-A prerequisite: ALSO record the discriminating-arg mono into
-- methodSiteFns keyed by currentFn (mirroring recordSite, which only fires
-- for return-position).  Without this, an unsignatured fn whose body
-- dispatches a method in ARGUMENT position (`f s = display s`) never
-- surfaces its inferred constraint to inferredConstraintIds → never gets
-- promoted → no leading dict param on the build path → dict word 0 (SIGSEGV/
-- silent).  Inert unless promotion (`registerInferredConstraints`, whose result the
-- schedule marks with) consumes it.

-- C5: queue a standalone-shadow method occurrence's discriminating-arg mono cell so
-- resolveRLocalSites can stamp RLocal once inference grounds the receiver.  Only
-- shadows (standaloneValuesRef) are recorded — every other method occurrence is
-- untouched (no entry → byte-identical).  The dispatch index comes from the method's
-- declared interface type (methodDispatchIdx).
-- S-1: this is the GENERAL shadow-occurrence recorder, and it is the path that a
-- VALUE-position shadow (`map size [1,2,3]`) and an IMPORTER shadow on an UNGROUNDED
-- receiver (`size 3`, where the Num literal is not yet grounded so inferShadowApp's
-- standalone arm is never reached) both take.  Both must carry the standalone's dicts or
-- they under-apply exactly like the headline bug.  Slots only — NOT obligations; see
-- shadowStandaloneDictSlotsAt.
recordRLocalSite : TcEnv -> String -> Ref Route -> Ref Inner -> Mono -> Unit
recordRLocalSite env name tagRef innerRef inst
  | env.teDyn.dcSuppressRLocalRecord = ()
  -- #1430 (S2, row 39): a RETURN-POSITION method has NO dispatch argument, so
  -- `methodDispatchIdx` answers None and every arm below declined — no pending site, no
  -- route stamp, and the occurrence kept the method's dispatching route while
  -- `maybeStandaloneValueMono` had already pinned its TYPE to the standalone.  That is
  -- exactly the invariant `standaloneValuePinned`'s header states in bold ("⭐ THE ROUTE
  -- MUST FOLLOW THE ARM"), violated at the one cell the dispatch-index gate hides.
  -- Measured at the parent commit on a two-verb split that cannot be read any other way:
  -- for `interface Zed a where zed : a` + `impl Zed Int` + a module-local `zed : Bool`,
  -- `check --types` reported `zed : Bool` (the standalone — the TYPE arm) at exit 0 while
  -- `run` E-PANICked `no matching impl for dispatch` (the ROUTE arm asked `Zed Bool`).
  -- With `zed : Int` the same split is SILENT: `run` printed the impl's 777.
  -- forceLocal (`True`) rather than a receiver query: under S4 there is no receiver to
  -- dispatch on, which is the same argument `standaloneValuePinned` already makes for the
  -- arg-position value cell.  Empty dict slots: `shadowStandaloneDictSlotsAt` resolves a
  -- constrained standalone's slots by unifying its scheme against `TFun receiver …`, and a
  -- return-position value standalone has no such arrow to match — an unconstrained one
  -- (the whole cell #1430 pins) short-circuits to `emptyShadowDicts` there anyway.
  | isNone (methodDispatchIdx env.teDyn.dcModule name)
    && standaloneValuePinned env name =
    pushSiteGoal
      env.teDyn.dcModule.mcGraph
      GKRLocalSite
      innerRef
      (PendingEntry
        name
        tagRef
        inst
        env.teDyn.dcModule.mcCells.currentFn.value
        (SKRLocal (routeLocalSym !tagRef) True [] [] [])
        env.teDyn.dcModule.mcLoc
        (captureScope env.teDyn.dcModule ())
        (freshEvId env.teDyn.dcModule ()))
  | not (omHasKey name env.teDyn.dcModule.mcCells.standaloneValuesRef.value) =
    ()
  | otherwise = match methodDispatchIdx env.teDyn.dcModule name
    None => ()
    Some idx => match nthArgMono idx inst
      Some am =>
        let sym = routeLocalSym !tagRef
        let dicts =
          shadowStandaloneDictSlotsAt
            env.teDyn
            (standaloneValueFor env name sym)
            name
            (if sym == "" then name else sym)
            am
        pushSiteGoal
          env.teDyn.dcModule.mcGraph
          GKRLocalSite
          innerRef
          (PendingEntry
            name
            tagRef
            am
            env.teDyn.dcModule.mcCells.currentFn.value
            (SKRLocal
              sym
              (standaloneValuePinned env name)
              dicts.sdMonos
              dicts.sdIfaces
              dicts.sdArgVecs)
            env.teDyn.dcModule.mcLoc
            (captureScope env.teDyn.dcModule ())
            (freshEvId env.teDyn.dcModule ()))
      None => ()

-- A method-layer binding retains the standalone scheme it masks. Recover that
-- exact scheme, including forcing effects, before trying a routed symbol.
standaloneSchemeFor : TcEnv -> String -> String -> Option Scheme
standaloneSchemeFor env name sym =
  map (value => value.vsScheme) (standaloneValueFor env name sym)

standaloneOccurrence : TcEnv ->
  String ->
  String ->
  Option Loc ->
  Option SelectedValueOccurrence
standaloneOccurrence env name sym origin =
  map
    (instantiateStandaloneOccurrence env name sym origin)
    (standaloneValueFor env name sym)

-- Phase 69.x-e: if [name] is a method with method-level constraints (foldMap's
-- `Monoid m`), map each constraint's scheme id through this occurrence's
-- instantiation subst to its concrete mono and record the (methodRef, monos) so
-- resolveMethodDicts can route them after inference.  A method with no method-level
-- constraint records nothing — methodRef stays [], eval's fold is a no-op.
recordMethodDicts : ModuleCtx ->
  String ->
  Ref (List Route) ->
  Ref Inner ->
  List (Int, Mono) ->
  Unit
recordMethodDicts mctx name methodRef innerRef subst =
  match methodIfaceHere mctx name
    None => ()
    Some iface =>
      match (lookupAssoc
        (methodSlotKey iface (originMethodName mctx name))
        mctx.mcCells.methodPredicateSlotsRef.value)
        None => ()
        Some slots =>
          recordMethodDictsFromSlots mctx slots methodRef innerRef subst

-- Instantiate the authoritative method carrier for THIS occurrence.  The carrier's
-- stable positions index the occurrence's ordered substitution, avoiding any reliance
-- on allocation-local ids from an earlier discovery sweep.  A re-exported method keeps
-- its original scheme order, so the same positional projection is diamond-safe.
recordMethodDictsFromSlots : ModuleCtx ->
  List MethodPredicateSlot ->
  Ref (List Route) ->
  Ref Inner ->
  List (Int, Mono) ->
  Unit
recordMethodDictsFromSlots mctx slots methodRef innerRef subst = pushMethodDictGoal
  mctx.mcGraph
  PendingMethodDict {
    pmdRoutesRef = methodRef,
    pmdEv = freshEvId mctx (),
    pmdSlots = instantiateMethodPredicateSlots mctx.mcGraph slots subst,
    pmdEncl = mctx.mcCells.currentFn.value,
    pmdScope = captureScope mctx (),
    pmdInner = innerRef,
  }

instantiateMethodPredicateSlots : GraphCtx ->
  List MethodPredicateSlot ->
  List (Int, Mono) ->
  List PredicateSlot
instantiateMethodPredicateSlots gctx [] _ = []
instantiateMethodPredicateSlots gctx (slot :: rest) subst =
  match instantiateMethodPredicateSlot gctx slot subst
    Some pred => pred :: instantiateMethodPredicateSlots gctx rest subst
    None => instantiateMethodPredicateSlots gctx rest subst

instantiateMethodPredicateSlot : GraphCtx ->
  MethodPredicateSlot ->
  List (Int, Mono) ->
  Option PredicateSlot
instantiateMethodPredicateSlot gctx slot subst =
  map
    (instantiatedMethodPredicate gctx slot subst)
    (methodSlotSubst slot.mpsPredicate.psBoundIds slot.mpsPositions subst)

instantiatedMethodPredicate : GraphCtx ->
  MethodPredicateSlot ->
  List (Int, Mono) ->
  List (Int, Mono) ->
  PredicateSlot
instantiatedMethodPredicate gctx slot subst slotSubst =
  let args2 =
    instantiatedMethodPredicateArgs gctx slot.mpsPredicate.psArgs slotSubst
  PredicateSlot {
    psIface = slot.mpsPredicate.psIface,
    psArgs = args2,
    psBoundIds =
      map (p => optionOr (0 - 1) (get p (map fst subst))) slot.mpsPositions,
  }

instantiatedMethodPredicateArgs : GraphCtx ->
  PredicateSlotArgs ->
  List (Int, Mono) ->
  PredicateSlotArgs
instantiatedMethodPredicateArgs gctx PSArgsUnknown _ = PSArgsUnknown
instantiatedMethodPredicateArgs gctx (PSArgsKnown args) subst =
  PSArgsKnown (map (substMono gctx subst [] []) args)

methodSlotSubst : List Int ->
  List Int ->
  List (Int, Mono) ->
  Option (List (Int, Mono))
methodSlotSubst ids positions subst =
  let vals = map snd subst
  let n = listLen subst
  if listLen ids == listLen positions && allInRange positions n then
    Some (zipMethodSlotSubst ids positions vals)
  else
    None

zipMethodSlotSubst : List Int -> List Int -> List Mono -> List (Int, Mono)
zipMethodSlotSubst [] _ _ = []
zipMethodSlotSubst _ [] _ = []
zipMethodSlotSubst (id :: ids) (pos :: positions) vals =
  (id, nthMethodMono pos vals) :: zipMethodSlotSubst ids positions vals

allInRange : List Int -> Int -> Bool
allInRange [] _ = True
allInRange (p :: rest) n = p >= 0 && p < n && allInRange rest n

nthMethodMono : Int -> List Mono -> Mono
nthMethodMono _ [] = tconUnresolved "__missing_method_slot__"
nthMethodMono 0 (x :: _) = x
nthMethodMono i (_ :: xs) = nthMethodMono (i - 1) xs

-- record a return-position method occurrence: resolveSite later stamps its route
-- (RKey/RDict) once inference grounds the result mono.  An admitted-set occurrence
-- (`admittedSetOccurrence`) records the set's obligation and a site its commit
-- stamps (`resolveAdmittedSite`), both decided by the one test here.
recordSite : TcEnv ->
  String ->
  Scheme ->
  Ref String ->
  Ref Route ->
  Ref (List Route) ->
  Ref (List Route) ->
  Ref Inner ->
  Mono ->
  MethodInstantiationSubst ->
  Mono
recordSite env name scheme ifaceRef tagRef implRef methodRef innerRef methodType subst =
  let stripped = stripArrows methodType
  let ev = freshEvId env.teDyn.dcModule ()
  let exactRow = exactReturnRow env name scheme
  let admitted = isNone exactRow && admittedSetOccurrence env name scheme
  let exact =
    map
      (row =>
        methodReturnRequest env.teDyn.dcModule row methodType subst (Some ev))
      exactRow
  let _ = match (exact, exactRow)
    (Some request, Some row) =>
      let _ =
        recordMethodLevelSlotsOwned
          env.teDyn.dcModule
          row
          subst.misTypeSubst
          request.mrrLoc
          request.mrrScope
      let _ = recordExactMethodObligation env.teDyn.dcModule request
      if isEmptyL row.msrMethodSlots then
        ()
      else
        recordMethodDictsFromSlots
          env.teDyn.dcModule
          row.msrMethodSlots
          methodRef
          innerRef
          subst.misTypeSubst
    _ =>
      let _ =
        if admitted then
          pushAdmittedOccObl env.teDyn.dcModule name methodType
        else
          let _ = recordMethodObligationGuarded env name scheme methodType []
          ()
      recordMethodDicts
        env.teDyn.dcModule
        name
        methodRef
        innerRef
        subst.misTypeSubst
  let siteEv = match exact
    Some request => optionOr ev request.mrrGoalEv
    None => ev
  pushSiteGoal
    env.teDyn.dcModule.mcGraph
    GKReturnSite
    innerRef
    (PendingEntry
      name
      tagRef
      stripped
      env.teDyn.dcModule.mcCells.currentFn.value
      (match exact
        Some request => SKExactReturn implRef request
        None =>
          if admitted then
            SKAdmittedReturn ifaceRef implRef methodType
          else
            SKReturn implRef methodType)
      env.teDyn.dcModule.mcLoc
      (captureScope env.teDyn.dcModule ())
      siteEv)
  env.teDyn.dcModule.mcCells.methodSiteFns :=
    consSiteFn
      env.teDyn.dcModule.mcCells.currentFn.value
      stripped
      env.teDyn.dcModule.mcCells.methodSiteFns.value
  methodType

recordNumLitSite : ModuleCtx ->
  ClassPredicate ->
  Ref Route ->
  Mono ->
  Option Loc ->
  ScopeId ->
  Mono
recordNumLitSite mctx predicate tagRef occurrence origin scope =
  let stripped = stripArrows occurrence
  pushSiteGoal
    mctx.mcGraph
    GKReturnSite
    (Ref innerNone)
    (PendingEntry
      "fromInt"
      tagRef
      stripped
      mctx.mcCells.currentFn.value
      (SKNumReturn predicate occurrence)
      origin
      scope
      (freshEvId mctx ()))
  mctx.mcCells.methodSiteFns :=
    consSiteFn
      mctx.mcCells.currentFn.value
      stripped
      mctx.mcCells.methodSiteFns.value
  occurrence

freshLocalAbsName : GraphCtx -> String -> String
freshLocalAbsName gctx x =
  let st = gctx.graphRun.localAbs
  let (mid, k) = st.lasNext.value
  let name = "\{x}$\{mid}$\{intToString k}$lb"
  st.lasNext := (mid, k + 1)
  st.lasMinted := name :: st.lasMinted.value
  name

localAbsFor : GraphCtx -> String -> Option LocalAbs
localAbsFor gctx name =
  match omLookup name gctx.graphRun.localAbs.lasBinders.value
    Some found => found
    None => None

-- Forget what a previous inference of the same binder left, before any member of
-- its group is inferred (a group member's body records its siblings' uses): an
-- earlier inference in this drive, or a check of the module id in an earlier one.
forgetLocalAbs : GraphCtx -> String -> Unit
forgetLocalAbs gctx name =
  forgetLocalRows gctx.graphRun.localAbs gctx.graphRun.grants name

-- Enter a candidate local binder's own scope before its right-hand side is
-- inferred.
openLocalScope : ModuleCtx -> String -> ScopeId
openLocalScope mctx name =
  let parent = captureScope mctx ()
  let sid =
    Scopes.freshScope
      (currentScopeStore mctx.mcGraph ())
      (Some parent)
      mctx.mcCells.currentLevel.value
      (Scopes.scopeFrame (currentScopeStore mctx.mcGraph ()) parent).sfModuleId
      (LocalBindingOwner name)
  let _ = openScope mctx sid
  sid

-- The candidate local's scope, opened when the binder is a candidate.
openLocalScopeIf : ModuleCtx -> String -> Option ScopeId
openLocalScopeIf mctx name
  | isLocalAbsName name =
    let _ = forgetLocalAbs mctx.mcGraph name
    Some (openLocalScope mctx name)
  | otherwise = None

closeLocalScope : ModuleCtx -> Option ScopeId -> Unit
closeLocalScope mctx (Some _) = closeScope mctx ()
closeLocalScope mctx None = ()

registerLocalAbsIf : ModuleCtx ->
  String ->
  Option ScopeId ->
  Scheme ->
  Int ->
  Int ->
  Unit
registerLocalAbsIf mctx name lscope sch oblN0 callN0 =
  let _ = recordLocalQuantified mctx.mcGraph sch
  match lscope
    Some scope =>
      let _ = registerLocalGrants mctx.mcGraph name sch
      registerLocalAbs mctx name scope sch oblN0 callN0
    None => ()

-- A generalized local's quantified variables stay in the enclosing binding's
-- obligation window, but they are the scheme's now: each use instantiates them
-- afresh, and the enclosing boundary's defaulting must reach those instances,
-- never the scheme's own variables.  Grounding one would fix the local at one
-- type behind every use and select one dictionary for two predicates (#3516).
recordLocalQuantified : GraphCtx -> Scheme -> Unit
recordLocalQuantified gctx sch = match schemeIds sch
  [] => ()
  ids =>
    let st = gctx.graphRun.localAbs
    st.lasQuantified := omFromNames (map intToString ids) st.lasQuantified.value

-- An occurrence of a candidate local.  Once its binder has generalized with
-- predicates the occurrence instantiates them; before that (a recursive use) it is
-- recorded for `registerLocalAbs`.
inferLocalDictAt : TcEnv -> String -> EvId -> Mono
inferLocalDictAt env name ev =
  match (omLookup
    name
    env.teDyn.dcModule.mcGraph.graphRun.localAbs.lasBinders.value)
    Some (Some la) => match lookupVar env name
      Some s =>
        let inst = instantiateVarTrackedWithSubst env name 0 s
        let _ =
          pushLocalDictApp
            env.teDyn.dcModule
            name
            ev
            la
            inst.mtiSubstitution.misTypeSubst
            (captureScope env.teDyn.dcModule ())
        inst.mtiBody
      None => unboundVarFresh env.teDyn.dcModule name
    Some None => inferVarId env name 0
    None =>
      let _ = recordLocalRecOcc env.teDyn.dcModule name ev
      inferVarId env name 0

recordLocalRecOcc : ModuleCtx -> String -> EvId -> Unit
recordLocalRecOcc mctx name ev =
  let st = mctx.mcGraph.graphRun.localAbs
  let occs =
    (ev, captureScope mctx ())
      :: optionOr [] (omLookup name st.lasRecOccs.value)
  st.lasRecOccs := omInsert name occs st.lasRecOccs.value

-- dict_pass for locals: an abstracted binder takes its dictionary parameters, and an
-- occurrence of a binder that abstracted nothing is a plain variable again.
rewriteLocalDictExpr : GraphCtx -> Expr -> Expr
rewriteLocalDictExpr gctx (EDictAt n ev)
  | isLocalAbsName n = match localAbsFor gctx n
    Some _ => EDictAt n ev
    None => EVar n
  | otherwise = EDictAt n ev
rewriteLocalDictExpr gctx (ELet m r (PVar x xloc bid) e1 e2) =
  match localAbsFor gctx x
    Some la => ELet m r (PVar x xloc bid) (prependLocalDicts la.laParams e1) e2
    None => ELet m r (PVar x xloc bid) e1 e2
rewriteLocalDictExpr gctx (ELetGroup binds body) =
  ELetGroup (map (rewriteLocalLetBind gctx) binds) body
rewriteLocalDictExpr gctx (EBlock stmts) =
  EBlock (map (rewriteLocalDoStmt gctx) stmts)
rewriteLocalDictExpr gctx e = e

rewriteLocalLetBind : GraphCtx -> LetBind -> LetBind
rewriteLocalLetBind gctx (LetBind n clauses site bid) = match localAbsFor gctx n
  Some la =>
    LetBind n (map (prependLocalDictClause la.laParams) clauses) site bid
  None => LetBind n clauses site bid

prependLocalDictClause : List String -> FunClause -> FunClause
prependLocalDictClause params (FunClause pats body) =
  FunClause (map localDictPat params ++ pats) body

rewriteLocalDoStmt : GraphCtx -> DoStmt -> DoStmt
rewriteLocalDoStmt gctx (DoLet m r (PVar x xloc bid) e site) =
  match localAbsFor gctx x
    Some la =>
      DoLet m r (PVar x xloc bid) (prependLocalDicts la.laParams e) site
    None => DoLet m r (PVar x xloc bid) e site
rewriteLocalDoStmt gctx stmt = stmt

prependLocalDicts : List String -> Expr -> Expr
prependLocalDicts params (ELoc l e) = ELoc l (prependLocalDicts params e)
prependLocalDicts params (ELam pats body) =
  ELam (map localDictPat params ++ pats) body
prependLocalDicts params e = ELam (map localDictPat params) e

localDictPat : String -> Pat
localDictPat n = PVar n (Loc "" 0 0 0 0) noBinderId

inferDictAt : TcEnv -> String -> EvId -> Mono
inferDictAt env name ev
  | isLocalAbsName name = inferLocalDictAt env name ev
  | otherwise = inferGlobalDictAt env name ev

inferGlobalDictAt : TcEnv -> String -> EvId -> Mono
inferGlobalDictAt env name ev = match lookupVar env name
  None => panic ("unbound constrained fn: " ++ name)
  Some scheme =>
    let inst = instantiateValueTracked env.teDyn.dcModule name scheme
    let occurrence = (inst.mtiBody, inst.mtiSubstitution.misTypeSubst)
    match bindingDeclaredAt env name inst
      Some dc => inferDeclaredDictAt env.teDyn.dcModule name ev dc occurrence
      None => inferDictAtFound env.teDyn.dcModule name ev occurrence

-- The catalog externs whose authority parameter names a file path
-- (`stdlib/runtime.mdk`), each with its value arity and the number of paths it
-- names.  No other extern takes a grant: a foreign function is not a
-- parameterized file extern.
fileGrantExterns : OrdMap (Int, Int)
fileGrantExterns = RuntimeGrants.fileGrantExterns

-- A program lowered without elaboration (the prelude-free emitter probes) has no
-- inference to solve a grant from: each file extern it names is granted the
-- whole domain, and saturated as elaboration saturates it.  The parameter names
-- come from the process's grant counter (the interners' lineage), which the next
-- drive continues.
export
grantWholeDomain : List Decl -> List Decl
grantWholeDomain prog =
  map (mapDeclBodies (wholeDomainExpr interners.value.lineage.lnGrants)) prog

wholeDomainExpr : GrantState -> Expr -> Expr
wholeDomainExpr st (e@(EApp _ _)) = match grantSpine e []
  (EVar n, args) => match omLookup n fileGrantExterns
    Some (arity, paths) =>
      saturateGrants
        st
        (EVar n)
        arity
        (replicate paths (EListLit []))
        (map (wholeDomainExpr st) args)
    None => mapChildren (wholeDomainExpr st) e
  _ => mapChildren (wholeDomainExpr st) e
wholeDomainExpr st (EVar n) = match omLookup n fileGrantExterns
  Some (arity, paths) =>
    saturateGrants st (EVar n) arity (replicate paths (EListLit [])) []
  None => EVar n
-- every other node: its children, through the one traversal every pass shares
wholeDomainExpr st e = mapChildren (wholeDomainExpr st) e

-- Apply [f] once to the root of every expression a declaration holds.
export
mapDeclBodies : (Expr -> Expr) -> Decl -> Decl
mapDeclBodies f (DFunDef pub n ps e site bid) = DFunDef pub n ps (f e) site bid
mapDeclBodies f (DLetGroup pub binds) =
  DLetGroup
    pub
    (map
      (b => match b
        LetBind n clauses site bid =>
          LetBind
            n
            (map
              (c => match c
                FunClause ps e => FunClause ps (f e))
              clauses)
            site
            bid)
      binds)
mapDeclBodies f (d@(DInterface { methods, ... })) = DInterface { d |
  methods =
    map
      (m => match m
        IfaceMethod n ty def mloc =>
          IfaceMethod
            n
            ty
            (map
              (dm => match dm
                MethodDefault ps e => MethodDefault ps (f e))
              def)
            mloc)
      methods,
}
mapDeclBodies f (d@(DImpl { methods, ... })) = DImpl { d |
  methods =
    map
      (m => match m
        ImplMethod n ps e => ImplMethod n ps (f e))
      methods,
}
mapDeclBodies f (DProp pub name params body) = DProp pub name params (f body)
mapDeclBodies f (DTest pub name body) = DTest pub name (f body)
mapDeclBodies f (DAttrib attrs d) = DAttrib attrs (mapDeclBodies f d)
-- a declaration with no expression body (data, signatures, imports, externs)
mapDeclBodies _ d = d

-- Grants are passed only on a graph whose driver ran the marking preamble: a
-- driver that never marks has no use that could carry one.
grantsEnabled : GraphCtx -> Unit -> Bool
grantsEnabled gctx _ = isSome gctx.markSetsRef.value

-- What a use of [name] in the module being marked denotes.  An extern the module
-- declares or imports is a foreign declaration, and one spelled like a catalog
-- file extern binds that same runtime operation (a redeclaration must agree with
-- the catalog row); any other value the module defines or imports is a source
-- binding; a name the module neither defines nor imports is the catalog extern
-- when the catalog declares it.
grantCalleeOf : ModuleCtx -> String -> GrantCallee
grantCalleeOf mctx name
  | isLocalAbsName name = SourceCallee
  | otherwise = match mctx.mcCells.markingRef.value
    Some mm =>
      if omHasKey name mm.mmExterns then
        externCallee name
      else if omHasKey name mm.mmUserNames then
        SourceCallee
      else
        catalogCallee mctx.mcGraph name
    None => catalogCallee mctx.mcGraph name

catalogCallee : GraphCtx -> String -> GrantCallee
catalogCallee gctx name =
  if omHasKey name gctx.builtinExternNamesRef.value then
    externCallee name
  else
    SourceCallee

externCallee : String -> GrantCallee
externCallee name =
  if omHasKey name fileGrantExterns then FileExternCallee else NoGrantCallee

-- Whether the marker gives a use of [n] a grant identity: the binding [n] denotes
-- in [env] is a value, not an interface method (whose uses are method
-- occurrences), that takes grants, and its own scheme quantifies an authority.
grantNameIn : TcEnv -> String -> Bool
grantNameIn env n
  | not (grantsEnabled env.teDyn.dcModule.mcGraph ()) = False
  | otherwise = match lookupBinding env n
    Some b => match b.ebMethodRow
      Some _ => False
      None =>
        calleeTakesGrants (grantCalleeOf env.teDyn.dcModule n)
          && isNonEmptyL (schemeAuthIds b.ebValue.vsScheme)
    None => False

calleeTakesGrants : GrantCallee -> Bool
calleeTakesGrants SourceCallee = True
calleeTakesGrants FileExternCallee = True
calleeTakesGrants NoGrantCallee = False

-- A scheme's quantified authorities in grant order: first occurrence in the
-- type read left to right (an arrow's domain, its row, its result), so a
-- scheme and every copy of it list them alike whatever ids they carry.
grantOrder : Scheme -> List Int
grantOrder (Forall _ _ [] _ _ _) = []
grantOrder (Forall _ _ avars _ force body) =
  let seen = reverseL (authOrderRow force (authOrderIn body []))
  let quantified = filterList (i => containsI i avars) seen
  quantified ++ filterList (i => not (containsI i quantified)) avars

-- How many grants a top-level binding with this scheme takes ahead of its value
-- arguments.
export
bindingGrantArity : DriveOutputs -> String -> Scheme -> Int
bindingGrantArity o _ sch =
  if o.doGrantsEnabled then listLen (grantOrder sch) else 0

-- Mint a use node for a name that takes no dictionary, so its grants have an
-- identity to be recorded under.
mintGrantOnly : ModuleCtx -> String -> Expr
mintGrantOnly mctx n =
  let ev = freshEvId mctx ()
  let st = mctx.mcGraph.graphRun.grants
  st.gsGrantOnly := IdMap.set (evOrdinal ev) () st.gsGrantOnly.value
  EDictAt n ev

isGrantOnlyEv : GraphCtx -> EvId -> Bool
isGrantOnlyEv gctx ev =
  IdMap.has (evOrdinal ev) gctx.graphRun.grants.gsGrantOnly.value

-- A grant-only use that became a dictionary application (a recursive use of a
-- member its group just promoted).
unmarkGrantOnly : GraphCtx -> EvId -> Unit
unmarkGrantOnly gctx ev =
  let st = gctx.graphRun.grants
  st.gsGrantOnly := IdMap.delete (evOrdinal ev) st.gsGrantOnly.value

grantOccOf : GraphCtx -> EvId -> Option GrantOcc
grantOccOf gctx ev = IdMap.get (evOrdinal ev) gctx.graphRun.grants.gsOccs.value

setGrantOcc : GraphCtx -> EvId -> GrantOcc -> Unit
setGrantOcc gctx ev occ =
  let st = gctx.graphRun.grants
  st.gsOccs := IdMap.set (evOrdinal ev) occ st.gsOccs.value

-- An `EDictAt` use: a dictionary application, a grant-only use, or both.  The
-- instantiation inference makes for it is recorded for its grants; a grant-only
-- use is inferred exactly as the stamped variable it stands for.
inferGrantedAt : TcEnv -> String -> EvId -> Mono
inferGrantedAt env name ev =
  let st = env.teDyn.dcModule.mcGraph.graphRun.grants
  st.gsLastInst := None
  let t =
    if isGrantOnlyEv env.teDyn.dcModule.mcGraph ev then
      inferVarId env name (grantOnlyBindingId env.teDyn.dcModule name)
    else
      inferDictAt env name ev
  let _ = match st.gsLastInst.value
    Some (scheme, subst) =>
      recordGrantOcc env.teDyn.dcModule name ev scheme subst
    None => ()
  t

-- The binding id resolve's stamp would have given this use: its top-level
-- binder's, or 0 for an imported name.
grantOnlyBindingId : ModuleCtx -> String -> Int
grantOnlyBindingId mctx name = match mctx.mcCells.markingRef.value
  Some mm => optionOr 0 (omLookup name mm.mmTop)
  None => 0

recordGrantOcc : ModuleCtx ->
  String ->
  EvId ->
  Scheme ->
  List (Int, Authority) ->
  Unit
recordGrantOcc mctx name ev (scheme@(Forall _ _ _ _ _ body)) subst =
  match grantCalleeOf mctx name
    NoGrantCallee => ()
    SourceCallee => recordOccWith mctx name ev scheme subst None False
    FileExternCallee =>
      recordOccWith mctx name ev scheme subst (Some (arrowArity body)) False

-- A method candidate's use: its grants follow its value arguments.
recordMethodGrantOcc : ModuleCtx ->
  String ->
  EvId ->
  Scheme ->
  List (Int, Authority) ->
  Unit
recordMethodGrantOcc mctx name ev (scheme@(Forall _ _ _ _ _ body)) subst =
  recordOccWith mctx name ev scheme subst (Some (arrowArity body)) False

-- A method occurrence typed as the standalone binding its name shadows: that
-- binding's grants, leading its arguments.
recordStandaloneGrantOcc : ModuleCtx ->
  String ->
  EvId ->
  Scheme ->
  List (Int, Authority) ->
  Int ->
  Unit
recordStandaloneGrantOcc mctx name ev scheme subst arity =
  recordOccWith mctx name ev scheme subst (Some arity) True

recordOccWith : ModuleCtx ->
  String ->
  EvId ->
  Scheme ->
  List (Int, Authority) ->
  Option Int ->
  Bool ->
  Unit
recordOccWith mctx name ev scheme subst trailing standalone =
  match grantOrder scheme
    [] => ()
    ids => setGrantOcc mctx.mcGraph ev GrantOcc {
      goCallee = name,
      goCells = map (i => optionOr (AJoin []) (lookupAssocI i subst)) ids,
      goRecIds = [],
      goTrailing = trailing,
      goChain = grantChainAt mctx.mcGraph (captureScope mctx ()),
      goStandalone = standalone,
    }

-- The evidence id of the method occurrence heading an application spine.
spineHeadEv : Expr -> Option EvId
spineHeadEv (ELoc _ e) = spineHeadEv e
spineHeadEv (EApp f _) = spineHeadEv f
spineHeadEv (EMethodAt _ _ ev) = Some ev
-- any other head is not a method occurrence
spineHeadEv _ = None

-- A shadow application's head, typed as the standalone [occurrence] selected.
recordStandaloneAt : ModuleCtx ->
  String ->
  Expr ->
  SelectedValueOccurrence ->
  Unit
recordStandaloneAt mctx name hd occurrence = match spineHeadEv hd
  Some ev =>
    recordStandaloneGrantOcc
      mctx
      name
      ev
      occurrence.svoScheme
      occurrence.svoInstance.mtiSubstitution.misAuthSubst
      (funArity occurrence.svoInstance.mtiBody)
  None => ()

methodGrantOf : GraphCtx -> String -> String -> Option MethodGrant
methodGrantOf gctx ifaceWord method =
  omLookup
    (methodGrantKey ifaceWord method)
    gctx.graphRun.grants.gsMethods.value

-- The interface methods a module declares whose type quantifies authorities; any
-- other method it declares has no row, whatever an earlier check of the module id
-- left.  The grants follow the arrows the written type spells, since that declared
-- arity is what the backends read; a result an alias names a function stays the
-- result.
recordMethodGrants : GraphCtx -> List MethodSchemeRow -> Unit
recordMethodGrants gctx rows =
  let st = gctx.graphRun.grants
  st.gsMethods :=
    fold
      (acc row =>
        let key =
          methodGrantKey
            (ifaceWordOf row.msrIface.irOrigin row.msrIface.irName)
            row.msrName
        match methodGrantOfRow row
          Some mg => omInsert key mg acc
          None => omDelete key acc)
      st.gsMethods.value
      rows

methodGrantOfRow : MethodSchemeRow -> Option MethodGrant
methodGrantOfRow row = match row.msrScheme
  Forall _ _ _ _ force body => match grantOrder row.msrScheme
    [] => None
    ids =>
      let cells = authCellsIn body (authRowCells force Tip)
      Some MethodGrant {
        mgArity = tyArrowCount row.msrType,
        mgNames =
          map
            (i => match IdMap.get i cells
              Some cell => optionOr "" (authvarName cell)
              None => "")
            ids,
      }

-- A method body's own authority binders, bound by the body's grant parameters.
-- The instance head's cells are no caller's to supply.  Every other authority
-- variable of the instantiated type is the method's own, and they occur in the
-- order `grantOrder` reads the method's scheme in, since both are the one written
-- type read left to right: the k-th of them is the k-th grant, whatever it is
-- called.
registerMethodBodyGrants : GraphCtx ->
  IfaceRef ->
  String ->
  List Mono ->
  MethodBodyInstance ->
  ScopeId ->
  Unit
registerMethodBodyGrants gctx iface mname heads inst (ScopeId sid) =
  let headIds = IdMap.keys (fold (acc h => authCellsIn h acc) Tip heads)
  let _ = markSourceless gctx headIds
  match methodGrantOf gctx (ifaceWordOf iface.irOrigin iface.irName) mname
    None => ()
    Some mg =>
      let own =
        filterList
          (i => not (containsI i headIds))
          (reverseL
            (authOrderRow
              inst.mbiContractForce
              (authOrderIn inst.mbiExpected [])))
      let ids =
        map (k => optionOr (0 - 1) (get k own)) (range 0 (listLen mg.mgNames))
      let st = gctx.graphRun.grants
      st.gsBodies := IdMap.set sid (BodyGrantBinder mname ids) st.gsBodies.value

-- Authority variables no caller supplies, whose grant is the whole domain: the
-- escape check has already held every declaration they reach to its label's top.
markSourceless : GraphCtx -> List Int -> Unit
markSourceless gctx ids =
  let st = gctx.graphRun.grants
  st.gsSourceless := fold (m i => IdMap.set i () m) st.gsSourceless.value ids

isSourceless : GraphCtx -> Int -> Bool
isSourceless gctx i = IdMap.has i gctx.graphRun.grants.gsSourceless.value

-- The binders around [sid] whose authority parameters a grant may forward,
-- innermost first.
grantChainAt : GraphCtx -> ScopeId -> List GrantBinder
grantChainAt gctx (sid@(ScopeId i)) =
  let frame = Scopes.scopeFrame (currentScopeStore gctx ()) sid
  let outer = match frame.sfParent
    Some parent => grantChainAt gctx parent
    None => []
  let own = match frame.sfOwner
    BindingOwner n => TopGrantBinder frame.sfModuleId n :: outer
    LocalBindingOwner n => LocalGrantBinder n :: outer
    _ => outer
  match IdMap.get i gctx.graphRun.grants.gsBodies.value
    Some body => body :: own
    None => own

-- A generalized top-level group: each member whose scheme quantifies
-- authorities takes them as parameters, and each use of such a member inside
-- the group that instantiated nothing (its type was the member's own) forwards
-- them.  A member that takes none has no row, whatever an earlier check of the
-- module id left.
recordTopGrants : GraphCtx ->
  String ->
  List (String, Scheme) ->
  OrdMap (List (List Pat, Expr)) ->
  Unit
recordTopGrants gctx mid schemes grouped =
  let st = gctx.graphRun.grants
  let enabled = grantsEnabled gctx ()
  let granted =
    map ((n, sch) => (n, if enabled then grantOrder sch else [])) schemes
  let _ =
    each (e => setGrantIds st.gsTopIds (grantTopKey mid (fst e), snd e)) granted
  let taking = filterList (e => isNonEmptyL (snd e)) granted
  match taking
    [] => ()
    _ =>
      st.gsTakers := omFromNames (map fst taking) st.gsTakers.value
      fold
        (_ (m, _) =>
          fold
            (_ clause => recordRecursiveGrants gctx mid m taking (snd clause))
            ()
            (clausesOf m grouped))
        ()
        schemes

recordRecursiveGrants : GraphCtx ->
  String ->
  String ->
  List (String, List Int) ->
  Expr ->
  Unit
recordRecursiveGrants gctx mid m taking body =
  let visit =
    e => match e
      EDictAt n ev => match (lookupAssoc n taking, grantOccOf gctx ev)
        (Some ids, None) =>
          let _ = setGrantOcc gctx ev GrantOcc {
            goCallee = n,
            goCells = [],
            goRecIds = ids,
            goTrailing = None,
            goChain = [TopGrantBinder mid m],
            goStandalone = False,
          }
          e
        _ => e
      _ => e
  let _ = mapExpr visit body
  ()

-- A generalized candidate local: its quantified authorities become its
-- parameters, and its uses inside its own right-hand side forward them.
registerLocalGrants : GraphCtx -> String -> Scheme -> Unit
registerLocalGrants gctx name sch = match grantOrder sch
  [] => ()
  ids =>
    let st = gctx.graphRun.grants
    st.gsLocalIds := omInsert name ids st.gsLocalIds.value
    let recOccs =
      optionOr [] (omLookup name gctx.graphRun.localAbs.lasRecOccs.value)
    fold
      (_ occ => setGrantOcc gctx (fst occ) GrantOcc {
        goCallee = name,
        goCells = [],
        goRecIds = ids,
        goTrailing = None,
        goChain = grantChainAt gctx (snd occ),
        goStandalone = False,
      })
      ()
      recOccs

-- The callee's constraints are registered (funConstraintsRef has it) ⇒ a normal
-- call: map each constraint id through the instantiation subst to this call's
-- monos.  Absent ⇒ a self/mutually-recursive call (the callee is still inferring
-- in the same group); defer it for realizeRecDictApps to forward the enclosing
-- fn's dict.
-- A constrained callee in funConstraintsRef is reached two ways: (1) a NORMAL call
-- to an already-generalized fn — instantiateTracked pins each of its constraint ids
-- to a fresh occurrence var, so `snd inst` carries them; route via pendingDictApps.
-- (2) a SELF/MUTUALLY-RECURSIVE call — the callee is still the group's monomorphic
-- PLACEHOLDER (Forall [] [] v), so `snd inst` is empty (none of [ids] appear).  Here
-- the constraint var lives in the ENCLOSING fn's own type and the callee's REGISTERED
-- ids only become valid after this pass's registerInferredConstraints re-registers
-- them; defer to realizeRecDictApps (which forwards the enclosing dict).  We MUST NOT
-- take the normal branch here (as a stale cross-module funConstraintsRef seed makes us
-- do): constraintMonosOf maps the registered ids through the empty subst → [] → the
-- recursive call's route ref stays empty while dictPass still prepends the param → the
-- call under-applies → dispatch fails.  Detect (2) as "no registered id is pinned by
-- the instantiation subst" (mirrors the oracle's empty-`sub` self-recursion case).
-- WS-2/D2: a cross-module constrained callee's dict SLOTS (id + interface, paired) by
-- MODULE IDENTITY.  When [name] is an EXPLICITLY-imported value (currentImportDefinersRef)
-- whose import SOURCE module owns a (source,name) entry in the qualified arity tables,
-- return that entry — the definer-keyed arity, immune to the bare-name most-recent-prepend
-- collision in the jointly-seeded funConstraintsRef.  None ⇒ local fn / wildcard import /
-- re-export / check path (mid ""): inferDictAtFound falls back to the bare funConstraintsRef
-- + funConstraintIfacesRef path (today's behavior; same slots when no collision, since
-- the qual entry is the same module's same ids the bare first-match returns sans collision).
-- S-xmod-vector-supply (#1868/#1867): a PROJECTION of `qualConstraintDecl`, which is the
-- ONE qual-entry resolution.  It was the whole body until this slice; a third reader
-- (`declaredCrossModuleObls`) needed the same entry's ARGUMENT VECTORS as well as its
-- slots, and two readers re-deriving which entry a name resolves to is the drift
-- `qualConstraintKey` was factored out to remove.
qualConstraintFor : ModuleCtx -> String -> Option (List CSlot)
qualConstraintFor mctx name =
  map (d => d.cdSlots) (qualConstraintDecl mctx name)

-- the callee's registered dict-slot IDS, UNPAIRED and UNTRUNCATED — the exact list the
-- pre-U1b `declaredConstraintFor` returned as its first component.
--
-- 🚨 WHY THIS EXISTS, AND WHY IT IS NOT THE PARALLEL-LIST HAZARD `CSlot` REMOVED.
-- `pairSlots` truncates to the SHORTER of (ids, ifaces), which is correct everywhere the
-- result decides dict SLOTS — that is exactly what the zips it replaced did.  But two
-- guards in `inferDictAtFound` and one in `shadowStandaloneDictSlotsAt` do not ask about
-- slots; they ask *"is this callee registered as constrained at all"* and *"did the
-- instantiation pin any of its constraint vars"*.  Reading a TRUNCATED list there changes
-- the answer whenever the arity table HITS and the iface table MISSES — a mismatch this
-- seam can manufacture by construction (see `CSlot`) — and the two arms then differ:
-- one records an empty dict app, the other skips routing (and, at the standalone site,
-- skips a `unify` side effect).  Nobody has built a witness, so the difference is
-- unmeasured, which is precisely why this unit does not take it: an obligation-identity
-- change must not smuggle in a routing change nobody asked for.
--
-- It is NOT zipped against an interface list anywhere — its only consumers are
-- `isEmptyL` and `anyIdPinned` — so it cannot mispair with one.  That is the property
-- `CSlot` protects, and it is preserved.
declaredConstraintIds : ModuleCtx -> String -> List Int
declaredConstraintIds mctx name = match qualConstraintIds mctx name
  Some ids => ids
  -- same #739 source-exact discipline as `declaredConstraintFor`'s `None` arm below:
  -- a known import with no qual entry is genuinely unconstrained, and must NOT fall
  -- through to the source-blind bare-name table.
  None =>
    if hasImportDefiner mctx name then
      []
    else
      predicateSlotIdsAt name mctx.mcCells.funPredicateSlotsIdxRef.value

qualConstraintIds : ModuleCtx -> String -> Option (List Int)
qualConstraintIds mctx name = match qualConstraintKey mctx name
  None => None
  Some (src, origin) =>
    map
      predicateSlotIds
      (lookupQualPayload
        src
        origin
        mctx.mcGraph.crossRun.crossModuleFunPredicateSlotsQualRef.value)

-- WS-2/D2 + B-2.2-f (#1113): the slots-only projection `declaredConstraintSlots` is
-- RETIRED.  It had exactly two readers — `inferDictAtFound` and the shadow route — and
-- FIX-shadow-arity-skew is what a slots-only projection costs: slice 3 widened what
-- `cdSlots` is keyed by (whole predicate, vector included), the call sides that had a
-- vector agreed with the widened definition side, and the one reader still taking the
-- bare-slots projection expanded against a constant `[]` and collapsed two slots into
-- one.  Take `declaredConstraintFor` and project BOTH halves off the one entry decision,
-- or you are re-opening this bug by construction.  (The same argument that removed
-- `declaredConstraintK`: two readers re-deriving which entry a name resolves to is the
-- drift `qualConstraintKey` was factored out to remove.)
--
-- B-2.2-f (#1113): the ONE resolution — a constrained callee's declared dict slots AND
-- how many of them its own `=>` context declared (the rest being super slots
-- `expandSupersPairs` appends downstream).  Arms mirror the retired `declaredConstraintSlots`'
-- former body exactly, keyed once through `qualConstraintKey`.
--
-- 🚨 The prefix is CLAMPED against the slots actually returned (`clampPrefix`).
-- `pairSlots` truncates to the shorter of (ids, ifaces), a mismatch this seam can
-- manufacture by construction (see `CSlot`), and an unclamped `index < k` past the end
-- of a truncated list marks APPENDED slots declared — the unsafe direction.  UNWITNESSED
-- (instrumented over a full compiler build and a two-module probe; it never fired), so
-- the clamp is defensive, not measured — it is one token and it fails closed.
--
-- S-xmod-vector-supply (#1868/#1867): the qual arm is now `qualConstraintDecl`, shared
-- with `qualConstraintFor` and `declaredCrossModuleObls`.  The two arms that used to be
-- spelled out here — a qual KEY hit whose ids payload MISSES, and no qual key at all with
-- the name still an import — collapse into the one `hasImportDefiner` test below: a
-- `qualConstraintKey` hit IS a `currentImportDefinersRef` hit (same ref, same lookup), so
-- the empty `CDeclared` both arms produced is unchanged.
declaredConstraintFor : ModuleCtx -> String -> CDeclared
declaredConstraintFor mctx name = match qualConstraintDecl mctx name
  Some d => d
  -- #739: source-exact fallback.  An EXPLICITLY-imported name (present in
  -- currentImportDefinersRef) whose (import-source, name) qual entry is ABSENT is
  -- genuinely UNCONSTRAINED in its source module — every module's constrained fns ARE
  -- attributed into crossModuleFunConstraintsQualRef when it is processed, so a MISS for a
  -- known import means "no constraint", not "look elsewhere".  Do NOT fall back to the
  -- bare-name funConstraintsRef here: on the emit path that table is JOINTLY seeded across
  -- every module (aliasConstraintEntries), so a DIFFERENT module's same-named CONSTRAINED
  -- fn (`p.f : Display a => …`) would be misattributed to this unconstrained callee
  -- (`q.f`), and per-module tyvarCounter reset makes its constraint id collide with a fresh
  -- instantiation var → the call site records a phantom `Display Z` obligation and
  -- run/build OVER-REJECT a valid program (#739).  Mirrors the check-path
  -- declaredCrossModuleObls source-exact discipline (#673/#738).  Only local / wildcard /
  -- re-export / check-path (mid "") names — absent from currentImportDefinersRef — still
  -- take the bare-name path (byte-identical when there is no collision).
  None =>
    if hasImportDefiner mctx name then
      CDeclared { cdSlots = [], cdPrefix = CDPLen 0, cdArgs = [] }
    else
      localDeclaredConstraintFor mctx name

-- the LOCAL / wildcard / re-export / check-path arm of `declaredConstraintFor`, named so
-- that a reader who has ALREADY established the binding is this module's own can take it
-- directly instead of re-entering the import-keyed dispatch above.  The one such reader
-- is `shadowDeclaredFor` (a definer shadow's own standalone), whose bare name is in
-- `currentImportDefinersRef` by construction and so cannot reach this arm through
-- `declaredConstraintFor`.
--
-- The vector table is `funPredicateSlotsRef`, projected by `predicateSlotArgs` — the same
-- lookup `enclPreds` uses for the ENCLOSING fn.  Both halves come off ONE `stored`
-- resolution, which is the invariant `declaredConstraintFor`'s own header states.
localDeclaredConstraintFor : ModuleCtx -> String -> CDeclared
localDeclaredConstraintFor mctx name =
  let stored =
    optionOr
      []
      (lookupPredicateSlots name mctx.mcCells.funPredicateSlotsIdxRef.value)
  let slots = predicateSlotCSlots stored
  CDeclared {
    cdSlots = slots,
    cdPrefix =
      clampPrefix
        slots
        (lookupAssoc name mctx.mcCells.funConstraintDeclaredRef.value),
    cdArgs = predicateSlotArgs stored,
  }

-- #739: is [name] an explicitly-imported value (has a known source module)?  A miss in
-- the qual constraint table for such a name is authoritative ("unconstrained in its
-- source"), so `declaredConstraintFor` must NOT fall through to the source-blind bare-name
-- table for it.  A local / wildcard / re-export name is absent here and keeps the old path.
hasImportDefiner : ModuleCtx -> String -> Bool
hasImportDefiner mctx name =
  match omLookup name mctx.mcCells.currentImportDefinersRef.value
    Some _ => True
    None => False

inferDictAtFound : ModuleCtx ->
  String ->
  EvId ->
  (Mono, List (Int, Mono)) ->
  Mono
inferDictAtFound mctx name ev inst =
  let q = qualConstraintFor mctx name
  -- S-xmod-vector-supply (#1868/#1867): ONE resolution, two projections.  The slots and
  -- the argument vectors `zipSlotVecs` pairs them with below MUST come from the same
  -- entry decision — reading the slots qual-resolved and the vectors off the bare-name
  -- table is precisely the cross-module gap this slice closes.
  let dc = declaredConstraintFor mctx name
  -- ⚠️ UNTRUNCATED on purpose — `map (s => s.csId) slots` is NOT the same list when the
  -- arity table hits and the iface table misses.  See `declaredConstraintIds`.
  let declaredIds = declaredConstraintIds mctx name
  let known = match q
    Some _ => True
    None => hasPredicateSlots name mctx.mcCells.funPredicateSlotsIdxRef.value
  -- #739: an explicitly-imported callee with NO cross-module constraint (declaredIds empty
  -- and source-exact per Fix A above) is genuinely UNCONSTRAINED — it only reached this
  -- EDictAt path because the marker's dict-name set is source-blind and a DIFFERENT module
  -- exports a same-named CONSTRAINED fn (`p.f`).  It needs NO dict routing, so [ev] is
  -- published as an application of ZERO dictionaries (a goal with no slots, which solves
  -- to `EvMany []`): `evDictRoutesIn` panics on an id with no entry, so every `EDictAt` must
  -- be represented.  Neither branch below is safe here — the
  -- `if` branch would record a phantom obligation off the bare-name collision, and the
  -- `else` (recursive) branch's realizeRecDictApps does its OWN source-blind bare-name
  -- funConstraintsRef lookup and would forward the wrong module's dict slot.
  if isEmptyL declaredIds && hasImportDefiner mctx name then
    let _ = pushDictApp mctx.mcGraph PendingDictApp {
      pdaRoutesRef = Ref [],
      pdaEv = ev,
      pdaMonos = [],
      pdaIfaces = [],
      pdaArgVecs = [],
      pdaEncl = mctx.mcCells.currentFn.value,
      pdaLoc = mctx.mcLoc,
      pdaScope = captureScope mctx (),
      pdaCallee = localSourceName name,
    }
    fst inst
  else if known
    && (anyIdPinned declaredIds (snd inst)
      || calleeIsGeneralized mctx name q (snd inst)) then
    inferDeclaredDictAt mctx name ev dc (
      fst inst,
      pinUnboundIds mctx declaredIds (snd inst),
    )
  else
    pushRecDictAppGoal
      mctx.mcGraph
      (RecDictApp
        (Ref [])
        name
        mctx.mcCells.currentFn.value
        (fst inst)
        (captureScope mctx ())
        ev)
    fst inst

inferDeclaredDictAt : ModuleCtx ->
  String ->
  EvId ->
  CDeclared ->
  (Mono, List (Int, Mono)) ->
  Mono
inferDeclaredDictAt mctx name ev dc inst =
  -- One dict per distinct declared slot (`dedupSlotVecs`), each carrying its argument
  -- vector — the same sequence `dedupPredicateSlotsTable` leaves on the define side,
  -- so the dict params `dictArityOf`/dictPass prepend agree slot for slot.  A slot's
  -- supers take no dict of their own: the route built for the slot carries them.
  let expandedV = dedupSlotVecs (zipSlotVecs dc.cdSlots dc.cdArgs)
  let expanded = map fst expandedV
  let ids = map (s => s.csId) expanded
  let monos = constraintMonosOf ids (snd inst)
  let argVecs = callArgVecsV mctx.mcGraph expandedV (snd inst)
  -- the ROUTING goal stays a spelling (`resolveDictApps` asks the SPELLING-keyed
  -- `KeyBuckets` a route-word question — see `dispHeadTab`); only the OBLIGATION goal
  -- below carries identity.
  let _ = pushDictApp mctx.mcGraph PendingDictApp {
    pdaRoutesRef = Ref [],
    pdaEv = ev,
    pdaMonos = monos,
    pdaIfaces = map (s => s.csIface) expanded,
    pdaArgVecs = argVecs,
    pdaEncl = mctx.mcCells.currentFn.value,
    pdaLoc = mctx.mcLoc,
    pdaScope = captureScope mctx (),
    pdaCallee = localSourceName name,
  }
  mctx.mcCells.dictAppFns :=
    consSiteFn
      mctx.mcCells.currentFn.value
      (bareVectorLeads monos argVecs)
      mctx.mcCells.dictAppFns.value
  -- #11 soundness: record this call's instantiated impl obligations (iface paired
  -- with the call's constraint mono), checked after inference by checkCallObligations.
  -- The iface list is slot-parallel to [monos]; a concrete-head mono with no impl
  -- (`Num String` from `f "hello"` where `f : Num a => a -> a`) becomes an error.
  let _ = recordCallObligations mctx expanded monos argVecs
  fst inst

-- The callee is not a member of the group being inferred: a signed binding of this
-- module is reached in its own group through its declared scheme
-- (`bindingDeclaredAt`), never here, and an imported one is never in the group.
-- So a declared constraint id its instantiation does not bind is a variable its
-- type does not mention (`plain : Sz a => Int -> Int`), not a recursive call.
-- Unless the value restriction kept the signed binding monomorphic: then its
-- signature's type mentions a variable that its scheme [subst] does not quantify,
-- and its constraints are on its own variables, posed in its own group.
calleeIsGeneralized : ModuleCtx ->
  String ->
  Option (List CSlot) ->
  List (Int, Mono) ->
  Bool
calleeIsGeneralized mctx name q subst
  | isSome q = True
  | otherwise = match omLookup name mctx.mcCells.sigTyMapRef.value
    Some ty => isNonEmptyL subst || isEmptyL (tyVarNames ty)
    None => False

-- [subst] with a fresh variable for each of [ids] it does not bind.  A declared
-- constraint whose variable the callee's type does not mention is instantiated at
-- every call all the same, so the call poses its goal and the goal gets its
-- verdict whether or not the callee's body reads the dictionary.
pinUnboundIds : ModuleCtx -> List Int -> List (Int, Mono) -> List (Int, Mono)
pinUnboundIds mctx ids subst =
  subst
    ++ map
      (id => (id, freshVar mctx ()))
      (filterList (id => isNone (lookupAssocI id subst)) ids)

-- True iff at least one of [ids] (the callee's registered constraint tyvar ids) is
-- a key of the instantiation subst — i.e. instantiateTracked actually quantified it,
-- so this is a normal generalized call.  False ⇒ the callee is a monomorphic
-- placeholder (self/mutual recursion); subst can't carry its constraint occurrence.
anyIdPinned : List Int -> List (Int, Mono) -> Bool
anyIdPinned [] _ = False
anyIdPinned (id :: rest) subst = match lookupAssocI id subst
  Some _ => True
  None => anyIdPinned rest subst

-- pair each iface with its slot-parallel instantiated constraint mono, pushing onto
-- pendingCallObligations.  Length-zips defensively (an iface list shorter than the
-- mono list — e.g. a multi-param constraint whose ifaces weren't recorded — just
-- stops, never over-rejecting).
recordCallObligations : ModuleCtx ->
  List CSlot ->
  List Mono ->
  List (List Mono) ->
  Unit
recordCallObligations mctx [] _ _ = ()
recordCallObligations mctx _ [] _ = ()
recordCallObligations mctx (s :: ss) (mono :: ms) []
  | s.csIface.irName == "" = recordCallObligations mctx ss ms []
  | otherwise =
    let _ =
      recordObl
        mctx
        Predicate {
          iface = s.csIface,
          args = [mono],
        }
        0
        PCallSlot
        mctx.mcLoc
    recordCallObligations mctx ss ms []
recordCallObligations mctx (s :: ss) (mono :: ms) (args :: rest)
  | s.csIface.irName == "" = recordCallObligations mctx ss ms rest
  | otherwise =
    -- 1-ary by construction: these slots are funConstraintsRef's SHATTERED
    -- per-tyvar dict slots (`Ix a i` => two slots), so each carries one mono.
    -- Widening this to a joint vector is the dict-slot=predicate change (#607
    -- punch-list item 3), which moves emitted arity and is deliberately NOT
    -- done here.  The joint obligation for such a predicate is supplied by the
    -- declared-context path (declaredSchemeOblsFor); this path stays as-is.
    -- ⚠️ #1161 (F-3a-ii) widened the ROUTING goal (pushDictApp's 4th component) but
    -- deliberately NOT this OBLIGATION channel — measured: making this site n-ary from
    -- the same vector still ACCEPTED an unsatisfiable `Ix a Bool =>` at exit 0, because
    -- the acceptance decision is made upstream in `declaredSchemeOblsFor` →
    -- `declaredOblOne` → `constraintArgMonos`, which returned `None` for a non-tyvar
    -- argument on an ids-only payload.  That was #1161 symptom 2, and it is CLOSED: the
    -- payload now carries the whole vector (`VecObl.voArgs`) and `declaredOblMixed`
    -- records the predicate.  ⚠️ THIS SITE IS STILL 1-ARY AND STILL DELIBERATELY SO —
    -- the fix landed upstream precisely so that emitted dict arity did not move.
    -- Regression: test/dict_fixtures/s3-sig-constraint-unsatisfiable-rejects.mdk.
    -- P1 (#1446) / U1b (#1482): `funConstraintIfacesRef`'s payload is `List IfaceRef`,
    -- so this site records the interface OCCURRENCE's identity instead of
    -- `OriginUnresolved`.  It was one of the two `ifaceRefBare` producers.
    let goalArgs = if isEmptyL args then [mono] else args
    let _ =
      recordObl
        mctx
        Predicate { iface = s.csIface, args = goalArgs }
        0
        PCallSlot
        mctx.mcLoc
    recordCallObligations mctx ss ms rest

-- Slot-parallel to constraintMonosOf's OUTPUT, and it must stay that way: it walks the
-- SAME slot list against the SAME [subst] and applies the SAME drop rule (an id absent
-- from the instantiation is skipped on both sides), so slot i of the result describes
-- slot i of [monos].
-- S-dict-arity-contract: each slot now arrives PAIRED with its own vector — the stored
-- signature vector of the declared slot.  A slot whose vector is empty — an
-- inferred/promoted fn — still yields the singleton `[m]`, the scalar
-- goal `routesOfMonosTop` already used.  ⚠️ A CROSS-MODULE CALLEE IS NO LONGER IN THAT
-- LIST: S-xmod-vector-supply (#1868/#1867) gave it a real vector — see the `cdArgs`
-- arms of `declaredConstraintFor` (`grep -n 'cdArgs = predicateSlotArgs'`).
callArgVecsV : GraphCtx ->
  List (CSlot, List Mono) ->
  List (Int, Mono) ->
  List (List Mono)
callArgVecsV gctx [] _ = []
callArgVecsV gctx ((s, v) :: rest) subst = match lookupAssocI s.csId subst
  Some m => substArgVec gctx subst m v :: callArgVecsV gctx rest subst
  None => callArgVecsV gctx rest subst

-- 🚨 STRUCTURAL, not top-level-only.  The stored vector is in the SIGNATURE's
-- instantiation vars; the call's [subst] maps the scheme's quantified ids to THIS
-- call's monos.  A vector argument like `List b` therefore has to have its INTERIOR
-- tyvar rewritten too, which is what `substMono` does and a top-level id lookup does
-- not: leave `List b` as a stale signature var and `matchTyMonos` fails against every
-- `impl Ix Int (List Char)`-shaped head, the candidate set comes back EMPTY, and the
-- route silently degrades to the bare head tag — i.e. first-declared-wins, the very bug
-- this closes, at a different shape.  ⚠️ F-3c cannot catch that class either:
-- `pickMostSpecificEntry []` returns None, not the ambiguity arm.  Regression:
-- test/dict_fixtures/s3-nary-sig-constraint-structured-arg.mdk, graded on its
-- value by diff_compiler_dict_semantics_test.mdk and on its order-freedom by
-- diff_compiler_dict_semantics_permute.sh (no _swapped file needed).
substArgVec : GraphCtx -> List (Int, Mono) -> Mono -> List Mono -> List Mono
substArgVec gctx _ m [] = [m]
substArgVec gctx subst _ v = map (substMono gctx subst [] []) v

-- The leads of a dictionary application that `dictAppFns` may record for the caller.
-- `inferredConstraintIds` reads a recorded lead as the predicate `iface lead`, which is
-- that slot's predicate only when every argument of its vector is a type variable.  A
-- slot with a structured argument (`Sub (Box b)`) reaches the caller whole on the call
-- channel (`recordCallObligations`), where it is reduced, so its lead is not recorded.
-- [monos] and [argVecs] are slot-parallel; a lead with no vector is kept.
bareVectorLeads : List Mono -> List (List Mono) -> List Mono
bareVectorLeads monos [] = monos
bareVectorLeads [] _ = []
bareVectorLeads (m :: ms) (v :: vs)
  | allList isBareTyvarMono v = m :: bareVectorLeads ms vs
  | otherwise = bareVectorLeads ms vs

constraintMonosOf : List Int -> List (Int, Mono) -> List Mono
constraintMonosOf [] _ = []
constraintMonosOf (id :: rest) subst = match lookupAssocI id subst
  Some m => m :: constraintMonosOf rest subst
  None => constraintMonosOf rest subst

-- bare sequential block: value of the last statement; earlier statements typed
-- for effect; let/assign extend the env
inferBlock : TcEnv -> List DoStmt -> Mono
inferBlock env [] = tconBuiltin "Unit"
inferBlock env [s] = inferLastStmt env s
inferBlock env (s :: rest) = inferBlock (inferStmt env s) rest

inferLastStmt : TcEnv -> DoStmt -> Mono
inferLastStmt env (DoExpr e) = infer env e
inferLastStmt env s =
  let _ = inferStmt env s
  tconBuiltin "Unit"

-- A statement's own checks are located at its expression; the statements after
-- it are the enclosing construct's again.
inferStmt : TcEnv -> DoStmt -> TcEnv
inferStmt outer s =
  envAt
    outer.teDyn.dcModule.mcLoc
    (inferStmtAt (envAtIfSome (stmtSpanLoc s) outer) s)

stmtSpanLoc : DoStmt -> Option Loc
stmtSpanLoc (DoExpr e) = exprSpanLoc e
stmtSpanLoc (DoLet _ _ _ e _) = exprSpanLoc e
stmtSpanLoc (DoAssign _ e) = exprSpanLoc e
stmtSpanLoc (DoBind _ e) = exprSpanLoc e
stmtSpanLoc _ = None

inferStmtAt : TcEnv -> DoStmt -> TcEnv
inferStmtAt env (DoExpr e) =
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let t = infer env e
  let _ =
    checkStmtNotDiscarded
      env.teDyn
      (wWindow env.teDyn.dcModule.mcCells.implObls oblN0)
      t
      e
  env
-- #866: the binder's own Loc is threaded to blockRecLet for the pin note.  A
-- FUNCTION-FORM block let (`let h a p q = …`) parses with rec=True and lands HERE, not
-- in blockLet — so a pin note built from `exprLoc` of the curried lambda (which carries
-- no ELoc wrapper) had no location and the diagnostic silently never fired for the most
-- ordinary spelling of a local helper.  The binder pattern always has a real Loc.
inferStmtAt env (DoLet _ True (PVar x xloc bid) e _) =
  blockRecLet env x (Some xloc) bid e
inferStmtAt env (DoLet _ _ pat e _) = blockLet env pat e
inferStmtAt env (DoAssign x e) = extendLocalVar env x (monoScheme (infer env e))
-- A `<-` bind (DoBind) reaching a bare block is a user error: `<-` is
-- monadic-`do`-only, and a monadic `do` lowers to EDo (desugared before
-- typecheck), so only a bare-block `<-` arrives here.  Emit a clean LOCATED
-- error (symmetric with doRequiresMonadMsg) instead of panicking; infer the RHS
-- for effect (surfacing its own errors + snapshotting its ELoc span for the
-- caret) and bind the pattern's vars into env so downstream statements don't
-- cascade spurious `Unbound variable` errors (mirrors inferRecPatField).
inferStmtAt env (DoBind pat e) =
  let t = infer env e
  let _ = pushTypeError env.teDyn.dcModule "T-BIND-OUTSIDE-DO" bindOutsideDoMsg
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPat env pat
  let _ = bindFrom env.teDyn (fst pr) t
  let _ = settlePatLits env.teDyn lits
  extendLocalVars env (snd pr)
inferStmtAt env _ = panic "typecheck: unsupported block statement"

-- A bare (non-final, non-`let`) block statement discards its value.  A free
-- result var (nothing downstream constrained it) is pinned to `Unit` via plain
-- `unify` — always succeeds, and is exactly what "this value goes unused"
-- means for an otherwise-unconstrained type.  A CONCRETE non-`Unit` type is a
-- real mismatch, but routing it through bare `unify` would render the generic
-- `Type mismatch: Int vs Unit` (ERROR-QUALITY.md dim 3/5: doesn't name the rule
-- or offer the fix), so it is reported here instead with its own code and a
-- one-token `fix` (`let _ = `) for the intentional-discard case.
checkStmtNotDiscarded : DynCtx -> List UObligation -> Mono -> Expr -> Unit
checkStmtNotDiscarded dyn stmtObls t e
  | isExemptInPlaceSetIndex t e = ()
  | otherwise = match normalize t
    TCon "Unit" _ => ()
    TVar cell => match !cell
      Unbound id _ =>
        -- A variable a pending `Num` obligation constrains is a number of a
        -- kind a later statement may still fix (`Float`), so the report says
        -- "a number"; pinning it to `Unit` instead fails as `No impl of Num for Unit`.
        if containsI id (numConstrainedIds stmtObls) then
          pushDiscardedValueDesc dyn.dcModule "a number" e
        else
          unifyIn dyn t (tconBuiltin "Unit")
      Link _ => panic "checkStmtNotDiscarded: normalize left a Link"
    nt => pushDiscardedValueError dyn.dcModule nt e

-- `a[i] := v` desugars to `setIndex a i v` (`rewriteAssignIndex`, desugar.mdk), and
-- `IndexMut.setIndex : c -> k -> v -> c` (core.mdk) returns the container BY
-- INTERFACE CONTRACT so a caller can chain — but every current impl (`Array`,
-- `Vector` in vector.mdk) mutates in place and returns the SAME value, so the
-- bare-statement idiom `arr[i] := v` (real code: sqlite/lib/dbwriter.mdk,
-- gzip/lib/{huffman,inflate}.mdk) never actually loses anything by discarding it.
--
-- ⚠️ NOT exempted by callee name alone: `setIndex` is not a reserved word and
-- method names are not globally unique (#1111 A-2.5) — a user's OWN unrelated
-- binding named `setIndex` (e.g. `setIndex : HashMap -> String -> Int -> Bool`,
-- an existed-already probe) would silently dodge the discard check too, which
-- is exactly the bug this check exists to catch. `isExemptInPlaceSetIndex`
-- therefore also requires the DISCARDED VALUE's own head type constructor to be
-- one of the two real in-place `IndexMut` impls (`Array`/`Vector`) — since
-- `setIndex : c -> k -> v -> c`, that head IS the receiver's head, so this reads
-- the receiver's type off the statement's own already-inferred `t` for free,
-- no separate route/interface lookup needed. A future persistent-container
-- `IndexMut` impl (`setIndex` returning a NEW value) would need EXCLUDING from
-- `exemptInPlaceIndexMutHeads`, not just narrowing further.
-- `setIndex` is an `IndexMut` interface method, so which node shape this walk
-- is handed depends on the driver: this file has two output selections of the one
-- graph driver, `driveGraphK` (`checkModulesDiagsChain`'s `None` arm, for `check`, vs
-- `elaborateModules` for `build`/`run`; see harden-typechecker skill).  Both run the dict pre-pass
-- `prePassDictArg` now (#2705), which rewrites the call to
-- `EMethodAt "setIndex" …` BEFORE this check runs; before that only the
-- elaborate driver marked, and a bare-`EVar` node reached here under `check` —
-- reproduced: `medaka check` on
-- sqlite/lib/dbwriter.mdk was clean while `medaka build` rejected the same
-- file, because `stmtCalleeName` didn't yet cover `EMethodAt`/`EDictAt`. So it
-- must cover the stamped forms alongside the bare ones, where `appSpineName`
-- (this file's other spine-name walk, used elsewhere) covers neither.
stmtCalleeName : Expr -> Option String
stmtCalleeName (ELoc _ e) = stmtCalleeName e
stmtCalleeName (EDoOrigin _ e) = stmtCalleeName e
stmtCalleeName (EAnnot e _) = stmtCalleeName e
stmtCalleeName (EApp f _) = stmtCalleeName f
stmtCalleeName (EVar n) = Some n
stmtCalleeName (EVarId n _) = Some n
stmtCalleeName (EVarAt n _) = Some n
stmtCalleeName (EMethodRef n) = Some n
stmtCalleeName (EMethodAt n _ _) = Some n
stmtCalleeName (EDictAt n _) = Some n
stmtCalleeName _ = None

exemptInPlaceIndexMutHeads : List String
exemptInPlaceIndexMutHeads = ["Array", "Vector"]

isExemptInPlaceSetIndex : Mono -> Expr -> Bool
isExemptInPlaceSetIndex t e = match headTyconNameMono t
  Some hd =>
    stmtCalleeName e == Some "setIndex"
      && contains hd exemptInPlaceIndexMutHeads
  None => False

pushDiscardedValueError : ModuleCtx -> Mono -> Expr -> Unit
pushDiscardedValueError mctx nt e =
  pushDiscardedValueDesc mctx "`\{ppMono nt}`" e

pushDiscardedValueDesc : ModuleCtx -> String -> Expr -> Unit
pushDiscardedValueDesc mctx desc e =
  pushTypeErrorHelpFixAt
    mctx
    "T-DISCARDED-VALUE"
    (exprSpanLoc e)
    (discardedValueMsg desc)
    "bind it with `let _ = ...` if dropping the value is intentional"
    (discardedValueFix (exprLoc e))

blockRecLet : TcEnv -> String -> Option Loc -> BinderId -> Expr -> TcEnv
blockRecLet env x xloc bid e =
  let _ = checkRecBindNonFunction env.teDyn.dcModule x e  -- #799
  let _ = enterLevel env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let lscope = openLocalScopeIf env.teDyn.dcModule x
  let (t1, residuals) = inferRecursiveValue env x e
  let _ = closeLocalScope env.teDyn.dcModule lscope
  let _ = exitLevel env.teDyn.dcModule ()
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let _ = improveLocalGoals env.teDyn addedObls callN0
  let _ = finalizeNumBoundary env.teDyn NumBoundary {
    nbDisposition =
      NumBoundaryOwnedMember
        (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
    nbMembers = [t1],
    nbSurvivingIds = memberTiedSurvivors env.teDyn.dcModule t1 addedObls callN0,
    nbDefaultObls = addedObls,
    nbAmbiguityObls = addedObls,
    nbGuard = localNumGuard env.teDyn.dcModule addedObls callN0,
  }  -- PLAN.md #11 / RETPOS soundness
  let _ = recordLocalBind env.teDyn.dcModule x xloc bid t1  -- LSP hover (block rec-let bypasses inferPat)
  let sch =
    genBindingRestricted env.teDyn Tip (residualsOf 0 residuals) True pureRow t1  -- #866
  let _ = registerLocalScheme env.teDyn.dcModule x sch oblN0 callN0 dictN0
  let _ = registerLocalAbsIf env.teDyn.dcModule x lscope sch oblN0 callN0
  seedAlphaLets (extendLocalVar env x sch) x e  -- WS-2: α scope-seed

blockLet : TcEnv -> Pat -> Expr -> TcEnv
blockLet env (PVar x xloc bid) e =
  let _ = enterLevel env.teDyn.dcModule ()
  let _ = beginEffectSummaryScope env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let lscope = openLocalScopeIf env.teDyn.dcModule x
  let t = infer env e
  let _ = closeLocalScope env.teDyn.dcModule lscope
  let residuals =
    finishValueEffectsKeeping env.teDyn [(isNonexpansive env e, t)]
  let _ = exitLevel env.teDyn.dcModule ()
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let _ = improveLocalGoals env.teDyn addedObls callN0
  let _ = finalizeNumBoundary env.teDyn NumBoundary {
    nbDisposition =
      NumBoundaryOwnedMember
        (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
    nbMembers = [t],
    nbSurvivingIds = memberTiedSurvivors env.teDyn.dcModule t addedObls callN0,
    nbDefaultObls = addedObls,
    nbAmbiguityObls = addedObls,
    nbGuard = localNumGuard env.teDyn.dcModule addedObls callN0,
  }  -- PLAN.md #11 / RETPOS soundness
  let _ = recordLocalBind env.teDyn.dcModule x (Some xloc) bid t  -- LSP hover (block let bypasses inferPat)
  let sch =
    genBindingRestricted
      env.teDyn
      Tip
      (residualsOf 0 residuals)
      (isNonexpansive env e)
      pureRow
      t  -- #866
  let _ = registerLocalScheme env.teDyn.dcModule x sch oblN0 callN0 dictN0
  let _ = registerLocalAbsIf env.teDyn.dcModule x lscope sch oblN0 callN0
  -- WS-2: α scope-seed — bindings are immutable, so the prefix is stable.
  seedAlphaLets (extendLocalVar env x sch) x e
blockLet env pat e =
  let t = infer env e
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPat env pat
  let _ = bindFrom env.teDyn (fst pr) t
  let _ = settlePatLits env.teDyn lits
  let _ = checkBinderPat env (fst pr) pat
  extendLocalVars env (snd pr)

inferRecordCreate : TcEnv -> String -> List FieldAssign -> Mono
inferRecordCreate env name fields =
  match lookupRecordByName env.teDyn.dcModule name
    None => unknownRecordFresh env.teDyn.dcModule name
    Some ri => inferRecordCreateWith env name ri fields

-- Record CREATE.  A construction supplies EVERY field, so a single `R { … }` with
-- N fields is itself O(N x N): each supplied field did a `lookupAssoc fn` over the N
-- declared field types.  Same fix as the access/update paths (issue #980): instantiate
-- the result + each supplied field via the O(log N) index, and check missing fields
-- against the declared NAME list.  `checkMissingFields` walks declared order (identical
-- to the old `snd ir` order, which is `map fst fields`), so the missing-field errors are
-- pushed in the same order; the per-supplied-field unify is byte-identical (same subst).
inferRecordCreateWith : TcEnv ->
  String ->
  RecordInfo ->
  List FieldAssign ->
  Mono
inferRecordCreateWith env rname ri fields =
  let sr = instantiateRecordShared env.teDyn.dcModule ri
  let _ =
    checkMissingFields
      env.teDyn.dcModule
      rname
      (recordFieldNames ri)
      (omFromPairs (map fieldAssignNamePair fields) omEmpty)
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

fieldAssignNamePair : FieldAssign -> (String, Unit)
fieldAssignNamePair (FieldAssign fn _) = (fn, ())

assignedFieldNames : List FieldAssign -> List String
assignedFieldNames fields = map (fa => fst (fieldAssignNamePair fa)) fields

-- Index-based field-assignment unify for the record CREATE and UPDATE paths: instead of
-- instantiating all N declared fields and linearly `lookupAssoc`-ing each supplied
-- field, look the supplied field up in the record's O(log N) index and instantiate
-- ONLY it with the shared param substitution (issue #980).  Byte-identical: same field
-- Mono (same `subst`, same `substMono`), same error + order (per supplied field, in
-- supplied order), `infer env val` is still the only fresh-var allocator in each step.
unifyFieldAssignsIdx : TcEnv ->
  String ->
  RecordInfo ->
  RecordSubst ->
  List FieldAssign ->
  Unit
unifyFieldAssignsIdx env _ _ _ [] = ()
unifyFieldAssignsIdx env rname ri subst ((FieldAssign fn val) :: rest) =
  let _ = unifyFieldAssignIdx env rname ri subst fn val
  unifyFieldAssignsIdx env rname ri subst rest

unifyFieldAssignIdx : TcEnv ->
  String ->
  RecordInfo ->
  RecordSubst ->
  String ->
  Expr ->
  Unit
unifyFieldAssignIdx env rname ri subst fn val =
  match omLookup fn (recordFieldMap ri)
    None =>
      pushTypeError
        env.teDyn.dcModule
        "T-UNKNOWN-FIELD"
        (unknownFieldMsg fn rname)
    Some fm =>
      -- A supplied field flows into its slot at the value's span.
      let at = envAtIfSome (exprSpanLoc val) env
      let vt = infer at val
      argumentIntoOrd
        True
        at
        (Some val)
        (substRecordField env.teDyn.dcModule.mcGraph subst fm)
        vt

-- TYPECHECK-AUDIT OBS4: every declared field must be supplied in a record
-- construction.  Walk `declaredFields`, check each name is present
-- among the supplied `FieldAssign` list; push MissingField for any absent one.
-- `supplied` is the SET of supplied field names (built once by the caller), so the
-- membership test is O(log N) instead of a per-declared-field O(N) list scan — a single
-- N-field construction was O(N x N) here (issue #980).  Declared order is still walked
-- in order, so the missing-field errors are pushed in exactly the old order.
checkMissingFields : ModuleCtx -> String -> List String -> OrdMap Unit -> Unit
checkMissingFields mctx _ [] _ = ()
checkMissingFields mctx rname (fname :: rest) supplied
  | omHasKey fname supplied = checkMissingFields mctx rname rest supplied
  | otherwise =
    let _ = pushTypeError mctx "T-MISSING-FIELD" (missingFieldMsg fname rname)
    checkMissingFields mctx rname rest supplied

-- Phase 72 / TYPECHECK-AUDIT C2: receiver-directed field resolution.  Infer the
-- receiver FIRST, then pick the owning record by its head tycon when known; if
-- the receiver is still an unbound var and the field is owned by several
-- records, the access is ambiguous.  `value` keeps the Ref-projection special case (no
-- record in compiler/stdlib declares a `value` field, so this matches the
-- oracle's structural `(Ref a).value → a`).
inferFieldAccess : TcEnv -> Expr -> String -> EvId -> Mono
inferFieldAccess env e fname ev
  | fname == "value" = inferValueField env e
  | otherwise =
    let te = normalize (infer env e)
    match resolveFieldRecord env.teDyn.dcModule te fname
      None => freshVar env.teDyn.dcModule ()
      Some (rname, ri) =>
        siteHeadCell env.teDyn.dcModule.mcGraph ev := stampedRecordHead rname ri
        let ft = inferFieldOfRecord env.teDyn te rname ri fname
        -- #1468: the WELL-TYPEDNESS half, and it runs AFTER `inferFieldOfRecord`
        -- on purpose — that call is what unifies `te` with the record's result
        -- type, so only here does the receiver's head name the type whose
        -- constructor set has to be asked about.
        fieldSelectionWellTyped env.teDyn.dcModule te rname ri fname ft

-- ── #2839: the stamp names the record by IDENTITY, not by a spelling ─────────
-- The head this node carries downstream is the selected record's
-- OWNER-QUALIFIED name (`<owner module>__<record name>`), never the bare
-- registry key.
--
-- Both emitters pick a field's offset by `(record head, label)`, so two modules
-- declaring same-named records with their fields in opposite orders are
-- distinguishable at the emitter only if this stamp distinguishes them.  The
-- registry key alone does not: it is the record's DECL name, which is bare
-- unless `types/private_mangle.mdk` renamed it first.  Deriving the
-- qualification from the record's OWN declaring module makes the stamp's
-- cross-module identity a property of the declaration instead of a side effect
-- of the mangler having run before elaboration
-- (`compiler/TYPECHECK-TARGET-ARCHITECTURE.md` §1 L2).
--
-- The spelling is the MANGLER'S, and it reuses the mangler's own rename decision
-- rather than restating it, so the two cannot drift: a reserved fixed-tag
-- constructor is never renamed, every other one is qualified with its owner.
--
-- THE QUALIFICATION HAPPENS EXACTLY ONCE, AND HERE IS WHERE.  This is the only
-- writer of the head a downstream reader sees: `types/private_mangle.mdk`'s
-- `renameScoped` deliberately passes the `EFieldAccess`/`ERecordUpdate` site ids
-- through (see its note there).  A second application would have to guess whether
-- the first had already run, and a prefix test is not that fact: a record whose
-- SOURCE name already carries its own module's prefix (`data Mm__Cfg` beside
-- `data Cfg` in module `Mm`) reads as "already qualified" and collides with its
-- sibling — measured, the built binary projected the sibling's slot at exit 0 on
-- a program the parent commit REFUSED.
--
-- The one pass that still renames a constructor BEFORE elaboration,
-- `mangleCtorCollisions`, cannot be observed through this cell: its drivers are
-- `eval`, `core_ir_eval` and `test`, and all three discard the record-name field
-- (`eval (EFieldAccess e field _)`, `ceval (CFieldAccess e field _)`).  The sole
-- reader is the emitter, reached only through drivers that elaborate unmangled.
stampedRecordHead : String -> RecordInfo -> String
stampedRecordHead rname ri = match recordOwnerModule ri
  None => rname
  Some mid => ownerQualifiedHead mid rname

-- The name the mangler gives a record head owned by `mid` — the same two-case
-- decision `buildUnitCtorRenameMap` makes, and nothing else.  NOT idempotent, and
-- deliberately so: idempotence would require a test for "has this already been
-- qualified?", the only available test is a prefix guess, and the guess is wrong
-- for a record the author named `<mid>__<something>`.  Applied once, from the
-- record's own declaring module, it needs no such test — see `stampedRecordHead`.
ownerQualifiedHead : String -> String -> String
ownerQualifiedHead mid name
  | isReservedCtor name = name
  | otherwise = mangledName mid name

-- `cell.value` projects a Ref's contents.  Unify the receiver with `Ref a`
-- (forcing it, like the reference's `(Ref a).value → a` special case) and return
-- `a` — done by unification, not a structural match, so it also works when the
-- receiver's type is still an unsolved tyvar at this point (the self-hosted
-- typecheck infers function params as fresh vars, not yet pinned to their sig).
inferValueField : TcEnv -> Expr -> Mono
inferValueField env e = refStored env.teDyn (infer env e)

-- the field's type from a resolved record `rname`, given the (already-inferred)
-- receiver type `te` to unify against the record's instantiated result type.  A
-- field absent from a KNOWN record names it (mirrors the oracle's `resolve_in`,
-- which raises UnknownField with the resolved record name).
inferFieldOfRecord : DynCtx -> Mono -> String -> RecordInfo -> String -> Mono
inferFieldOfRecord dyn te rname ri fname =
  let sr = instantiateRecordShared dyn.dcModule ri
  let _ = unifyIn dyn te (snd sr)
  match omLookup fname (recordFieldMap ri)
    Some fm => substRecordField dyn.dcModule.mcGraph (fst sr) fm
    None => unknownFieldFresh dyn.dcModule fname rname (recordFieldNames ri)

-- ── #1468: `.f` on a type whose constructors DISAGREE about `f` is rejected ──
--
-- The resolution ladder above answers "WHICH declaration does `.f` mean"; it never
-- asked whether the receiver's TYPE entitles anyone to ask.  For
-- `data T = | A { x : Int } | B { z : Int }`, `x` has exactly ONE owner, so
-- `resolveFieldByOwners`' singleton arm hands back `A` with full confidence and the
-- later unify is SATISFIED — the receiver really is a `T` — and `check` exits 0.
-- A `T` value carries no static constructor tag, so the emitted code reads slot 0
-- unconditionally: measured on this base, `getX (B { z = 99 })` printed `v=99`, and
-- with `B { z : String }` the same program printed a heap address as an `Int`.
-- `medaka run` already refuses (`E-PANIC unknown field: x`) because the interpreter
-- resolves fields BY NAME; this restores agreement by refusing EARLIER, at typecheck.
--
-- The guard answers three questions about `f` across the receiver type's
-- constructors (`ctorFieldConflict`): does some constructor withhold `f`, do
-- two constructors that declare it place it at different positions, and do two
-- declare it with different types?  Both emitters read `.f` at the selected
-- constructor's declaration-order index with no tag test, and the access is
-- typed by that constructor's declaration, so any disagreement reads the wrong
-- slot, or reads the right slot at the wrong type, for some value of the type
-- (#1468, #1465, #3726).  A field every constructor declares at ONE position
-- with ONE type has one slot and one type for every value, so the access stays
-- legal.
--
-- ⚠️ THE HEAD EQUALITY IS A CASCADE GUARD, NOT A CORRECTNESS ONE.  `te`'s head is
-- compared against the SELECTED record's own result head, so the guard speaks only
-- when the receiver genuinely IS a value of the declaring type.  A receiver of some
-- OTHER type reached this arm through the owner ladder's deliberate
-- "pick-one-so-unify-complains" fall-through and already has its mismatch; adding a
-- constructor-set error on top of it would be noise.  `headTyconMono`'s `None` (an
-- unstamped or non-`TCon` head) decides nothing, per the absence rule
-- `recordCandIsReceiverDecl` documents.
fieldSelectionWellTyped : ModuleCtx ->
  Mono ->
  String ->
  RecordInfo ->
  String ->
  Mono ->
  Mono
fieldSelectionWellTyped mctx te rname ri fname ft =
  match ctorFieldConflictHere mctx te rname ri fname
    None => ft
    Some conflict =>
      let _ =
        pushCtorFieldConflict
          mctx
          fname
          (optionOr rname (headTyconNameMono te))
          conflict
      -- Same poisoned placeholder `unknownFieldFresh` returns: the access is already
      -- explained, so don't let its result var pile a second cascade on top.
      let v = freshVar mctx ()
      let _ = poisonMismatchVars mctx v v
      v

-- The conflict, if any, among the constructors sharing the receiver's head.
-- `ctorSiblingWithholdingName` is the SAME withheld test
-- `narrowingBlockedByCtorSibling` asks in the multi-owner arm, so the two paths
-- cannot drift about what "a sibling withholds it" means.
ctorFieldConflictHere : ModuleCtx ->
  Mono ->
  String ->
  RecordInfo ->
  String ->
  Option CtorFieldConflict
ctorFieldConflictHere mctx te rname ri fname = match headTyconMono te
  None => None
  Some hk =>
    if Some hk == headTyconMono (recordResultMono ri) then
      ctorFieldConflict mctx hk fname rname
    else
      None

ctorFieldConflict : ModuleCtx ->
  HeadKey ->
  String ->
  String ->
  Option CtorFieldConflict
ctorFieldConflict mctx hk fname rname =
  match ctorSiblingWithholdingName mctx (Some hk) fname rname
    Some sib => Some (CtorWithholds sib)
    None => match ctorsOfHead mctx hk
      Some (ctors@(_ :: _ :: _)) =>
        let held = ctorFieldSlots mctx hk fname ctors
        orElseOpt
          (firstSlotDisagreement held)
          (firstTypeDisagreement mctx.mcGraph fname held)
      _ => None

ctorsOfHead : ModuleCtx -> HeadKey -> Option (List String)
ctorsOfHead mctx hk = match ctorOracleKeyOf (Some hk)
  None => None
  Some tk => oGetCtors mctx.mcCells.matchOracle.value tk

-- Each constructor that declares `fname`, with the field's index in that
-- constructor's declaration-order field list — the index both emitters read —
-- and the constructor's record.
ctorFieldSlots : ModuleCtx ->
  HeadKey ->
  String ->
  List String ->
  List (String, Int, RecordInfo)
ctorFieldSlots mctx hk fname ctors =
  filterMap (ctorFieldSlot mctx hk fname) ctors

ctorFieldSlot : ModuleCtx ->
  HeadKey ->
  String ->
  String ->
  Option (String, Int, RecordInfo)
ctorFieldSlot mctx hk fname k = match ctorRecordOfType mctx hk k
  None => None
  Some ri => map (i => (k, i, ri)) (elemIndex fname (recordFieldNames ri))

firstSlotDisagreement : List (String, Int, RecordInfo) ->
  Option CtorFieldConflict
firstSlotDisagreement [] = None
firstSlotDisagreement ((a, i, _) :: rest) =
  map ((b, j) => CtorSlotsDiffer a i b j) (slotOtherThan i rest)

slotOtherThan : Int -> List (String, Int, RecordInfo) -> Option (String, Int)
slotOtherThan _ [] = None
slotOtherThan i ((b, j, _) :: rest)
  | j /= i = Some (b, j)
  | otherwise = slotOtherThan i rest

-- The first constructor whose declared type for `fname` is not the first
-- constructor's.  Each constructor's record is registered over its OWN
-- parameter variables, so the other constructor's field type is restated over
-- the first's parameters before the two are compared; `data T a = A { x : a } |
-- B { x : a }` agrees.
firstTypeDisagreement : GraphCtx ->
  String ->
  List (String, Int, RecordInfo) ->
  Option CtorFieldConflict
firstTypeDisagreement gctx _ [] = None
firstTypeDisagreement gctx fname ((a, _, ra) :: rest) =
  match omLookup fname (recordFieldMap ra)
    None => None
    Some ta => typeOtherThan gctx fname a ra ta rest

typeOtherThan : GraphCtx ->
  String ->
  String ->
  RecordInfo ->
  Mono ->
  List (String, Int, RecordInfo) ->
  Option CtorFieldConflict
typeOtherThan gctx _ _ _ _ [] = None
typeOtherThan gctx fname a ra ta ((b, _, rb) :: rest) =
  match omLookup fname (recordFieldMap rb)
    Some tb =>
      let (tsub, esub, asub) =
        paramRenaming (recordResultMono rb) (recordResultMono ra) ([], [], [])
      let tbOverA = substMono gctx tsub esub asub tb
      if fieldTypeSame ta tbOverA then
        typeOtherThan gctx fname a ra ta rest
      else
        Some (CtorTypesDiffer a ta b tbOverA)
    None => typeOtherThan gctx fname a ra ta rest

-- Pairs each parameter of `from`'s head application with the argument at the
-- same position of `to`'s — a type, row or authority parameter, each into its
-- own substitution — so substituting restates a type written over `from`'s
-- parameters over `to`'s.
paramRenaming : Mono ->
  Mono ->
  (List (Int, Mono), List (Int, Ref Effvar), List (Int, Authority)) ->
  (List (Int, Mono), List (Int, Ref Effvar), List (Int, Authority))
paramRenaming from to acc = match normalize from
  TApp f1 a1 => match normalize to
    TApp f2 a2 => paramRenaming f1 f2 (renameParam (normalize a1) a2 acc)
    _ => acc
  _ => acc

renameParam : Mono ->
  Mono ->
  (List (Int, Mono), List (Int, Ref Effvar), List (Int, Authority)) ->
  (List (Int, Mono), List (Int, Ref Effvar), List (Int, Authority))
renameParam (TVar c) to (ts, es, qs) = ((tyvarId c, to) :: ts, es, qs)
renameParam (TEff (EffRow [] (Some e1))) (TEff (EffRow [] (Some e2))) (ts, es, qs) =
  (ts, (effvarId e1, e2) :: es, qs)
renameParam (TAuth (AVar q1)) (TAuth q2) (ts, es, qs) =
  (ts, es, (authvarId q1, q2) :: qs)
renameParam _ _ acc = acc

-- One declared type, read the way a field's value is used: the same shape,
-- the same declarations and variables (`monoSameGiven` at the leaves), and the
-- same effect rows and authorities, since a function field read at another
-- constructor's row performs effects its type does not show.  A qualifier on
-- one side only is peeled here rather than in `monoSameGiven`, which erases
-- rows and so is reached only once the left side is a leaf.
fieldTypeSame : Mono -> Mono -> Bool
fieldTypeSame x y = match (normalize x, normalize y)
  (TFun a1 r1 b1, TFun a2 r2 b2) =>
    fieldTypeSame a1 a2 && rowSame r1 r2 && fieldTypeSame b1 b2
  (TApp a1 b1, TApp a2 b2) => fieldTypeSame a1 a2 && fieldTypeSame b1 b2
  (TEff r1, TEff r2) => rowSame r1 r2
  (TQual t1 q1, TQual t2 q2) => fieldTypeSame t1 t2 && authSame q1 q2
  (TAuth q1, TAuth q2) => authSame q1 q2
  (TFun _ _ _, _) => False
  (TApp _ _, _) => False
  (TEff _, _) => False
  (TAuth _, _) => False
  (TQual t1 _, b) => fieldTypeSame t1 b
  (a, TQual t2 _) => fieldTypeSame a t2
  (a, b) => monoSameGiven a b

pushCtorFieldConflict : ModuleCtx ->
  String ->
  String ->
  CtorFieldConflict ->
  Unit
pushCtorFieldConflict mctx fname tname (CtorWithholds sib) =
  pushTypeError
    mctx
    "T-FIELD-NOT-IN-ALL-CTORS"
    (fieldNotInAllCtorsMsg fname tname sib)
pushCtorFieldConflict mctx fname tname (CtorSlotsDiffer a i b j) =
  pushTypeError
    mctx
    "T-FIELD-POSITION-DIFFERS"
    (fieldPositionDiffersMsg fname tname (a, i) (b, j))
pushCtorFieldConflict mctx fname tname (CtorTypesDiffer a ta b tb) =
  pushTypeError
    mctx
    "T-FIELD-TYPE-DIFFERS"
    (fieldTypeDiffersMsg fname tname a ta b tb)

-- ── #3727/#3726: `{ v | f = e }` on a type with more than one constructor ──
--
-- Both emitters rebuild an update as the constructor the typechecker selected,
-- copying the other fields by that constructor's layout; the receiver's own tag
-- is never read.  When the receiver's type has two or more constructors, a value
-- built by any other one comes back as the selected constructor, whatever the
-- field offsets.  `Con { v | f = e }` names the constructor and is not this path.
-- Same cascade guard as `fieldSelectionWellTyped`: only a receiver that really is
-- a value of the selected record's type is asked about.
recordUpdateWellTyped : ModuleCtx ->
  Mono ->
  String ->
  RecordInfo ->
  String ->
  Unit
recordUpdateWellTyped mctx bt rname ri fn = match headTyconMono bt
  None => ()
  Some hk =>
    if Some hk
      == headTyconMono (recordResultMono ri) then match ctorsOfHead mctx hk
      Some (ctors@(_ :: _ :: _)) =>
        pushTypeError
          mctx
          "T-UPDATE-MULTI-CTOR"
          (updateMultiCtorMsg
            fn
            (optionOr rname (headTyconNameMono bt))
            rname
            (filterList (/= fn) (recordFieldNames ri))
            ctors)
      _ => ()

-- field_owners (Phase 72): every registry KEY whose RecordInfo declares `fname`,
-- sorted + deduped.  For a plain record the key is its type name; for a
-- named-field variant it's the constructor name, whose
-- field_owners maps to the record's type name and the variant's con_name.
-- The field→owners multimap (fieldOwnersRef) already holds exactly this set of
-- keys, maintained at registration; `sortUniqS` canonicalizes it so the rendered
-- owner-list order (ambiguousFieldMsg / head) is byte-identical to the old walk.
--
-- #1597: the owner list is then REACHABILITY-FILTERED — see `fieldOwnerReachFilter`.
-- This is the one reader of the field→owners multimap that decides ACCEPTANCE, and it
-- is the only one this filter touches.
fieldOwnerNames : ModuleCtx -> String -> List String
fieldOwnerNames mctx fname =
  fieldOwnerReachFilter
    mctx
    (sortUniqS (optionOr [] (omLookup fname mctx.mcCells.fieldOwnersRef.value)))

-- 🚨 #1597, AND IT FAILS OPEN TWICE OVER — deliberately, because the owner half of
-- the seed is the LOUD one (zero owners ⇒ `pushUnknownField`, exit 1), so a filter
-- that could empty a non-empty owner set would convert a silent-wrongness family into
-- a false-reject one.
--   1. An owner key the index does not know is KEPT.  Locally minted keys (mangled
--      re-registrations, `where`-scoped records, the flat/single-file driver where
--      `buildDeclEnvs` never ran) have no `deOwnerModules` row and therefore no vote
--      to lose.
--   2. If the filter would remove EVERY owner, the UNFILTERED list is returned.
-- So this predicate can only ever collapse a spurious AMBIGUITY down towards the
-- reader's own candidates; no program that resolved before can stop resolving here.
fieldOwnerReachFilter : ModuleCtx -> List String -> List String
fieldOwnerReachFilter mctx owners =
  match filterList (fieldOwnerReachable mctx) owners
    [] => owners
    kept => kept

fieldOwnerReachable : ModuleCtx -> String -> Bool
fieldOwnerReachable mctx key =
  match omLookup key mctx.mcCells.fieldOwnerModulesRef.value
    None => True
    Some mids => fieldOwnerAnyReachable mctx mids

fieldOwnerAnyReachable : ModuleCtx -> List String -> Bool
fieldOwnerAnyReachable mctx [] = False
fieldOwnerAnyReachable mctx (m :: rest) =
  omHasKey m mctx.mcCells.fieldOwnerReachRef.value
    || fieldOwnerAnyReachable mctx rest

-- Resolve the record (name + info) that owns `fname` for a receiver of type `te`
-- (normalized).
-- (a) receiver head tycon is a known record → that record;
-- (b) receiver is an undetermined var → 0 owners = unknown field, 1 = that one,
--     >1 = ambiguous (push AmbiguousField, return None);
-- (c) receiver is a concrete non-record → first owner (so the later unify raises
--     the usual mismatch), or unknown field if none.
-- On error it pushes the matching type error and returns None.
--
-- ⚠️ ARM (a) DOES NOT ASK A SPELLING QUESTION, AND THAT IS WHY IT ALONE CALLS
-- `lookupRecordForReceiver` INSTEAD OF `lookupRecordByName` — see that function.
resolveFieldRecord : ModuleCtx -> Mono -> String -> Option (String, RecordInfo)
resolveFieldRecord mctx te fname = match headTyconNameMono te
  Some r => match lookupRecordForReceiver mctx te r
    Some ri => Some (r, ri)
    None =>
      if omHasKey
        (receiverTypeWord te r)
        mctx.mcGraph.abstractRecordTypesRef.value then
        let _ = pushTypeError mctx "T-ABSTRACT-FIELD" (abstractFieldMsg r fname)
        None
      else
        resolveFieldByOwners mctx te fname
  None => resolveFieldByOwners mctx te fname

-- ── #1111 Stage A-2 unit A-2.13 (#1319 unit 3): ONE ENTRY, TWO QUESTIONS ────
--
-- `recordByNameRef` is asked two questions that a single bare-`String` key
-- cannot answer separately, and #1376 / #1377 are the two halves of that:
--
--   (1) a SPELLING question — "which declaration does the `Cfg` written in THIS
--       module's source denote?"  Asked by `inferPatRec`, `inferRecordCreate`
--       and `inferVariantUpdate`, each of which starts from a name the module
--       wrote.  The bare key plus unit 2's per-module scope overlay
--       (`applyRecordScopeOverrides`) is the RIGHT instrument for it: the answer
--       is a property of what this module imported and declared.
--   (2) an IDENTITY question — "given a receiver whose type is already inferred
--       and already carries its origin, which `RecordInfo` describes it?"  Asked
--       by `resolveFieldRecord`'s arm (a) ONLY.  Nothing the module spelled is
--       an input: `mkZ.beta` is decided entirely by `mkZ`'s type.
--
-- Before this unit both questions read `lookupRecordByName`, so whatever decided
-- the single entry answered both the same way — and a module that NAMES one
-- declaration while HOLDING a value of the other cannot get both right.
--
-- ⚠️ THE SPLIT IS NOT MINE — IT IS THE SPEC'S, AND THE IMPLEMENTATION WAS NOT
-- FOLLOWING IT.  `docs/spec/DICT-SEMANTICS.md` §8 I4 qualification 2 draws exactly
-- this line, in one sentence, and names both sides:
--
--     "It applies only to occurrences resolved BY NAME.  A record-field selection
--      `r.f` is resolved by the *type* of `r`, not by the spelling `f` … Record
--      *construction* and record *patterns* name the record, and are ambiguous
--      exactly when that name is."
--
-- So arm (a) is spec'd to resolve by the receiver's TYPE and was resolving by a
-- per-module decision over a bare spelling; the other three readers are spec'd to
-- resolve by name and do.  The diagnostic the collision produced was itself the
-- evidence the information was in hand at the point of failure — it could name
-- BOTH modules ("one comes from module 'zrmod', the other from 'armod'") while
-- selecting by neither.
--
-- 🚨 THIS IS A SPLIT, NOT A GUARD AT A READ SITE, and the distinction is the one
-- `.claude/workstreams/TYPECHECK.md`'s standing gate asks about (its
-- "does the fix change the KEY, or add a guard at ONE READ SITE?"
-- discriminator).  Question (2) now has its OWN key — the receiver's `Ident`,
-- selected out of the identity-keyed rows of `universeRecordPop` — and
-- question (1) keeps the spelling key it always had.  One read site moves
-- because exactly one read site asks question (2); a second site asking it would
-- call this same function.  What is NOT claimed: `recordByNameRef` is still
-- bare-keyed, and it is still the floor whenever the receiver carries no
-- identity.  This unit does not retire the overlay (that is #1319 unit 4) nor
-- the duplication (#1288 is the deleter, as for units 1 and 2).
--
-- ⚠️ THE FLOOR IS REACHED BY MISS, NEVER BY FALLBACK-ON-AMBIGUITY.  Three
-- honest-absence cases fall through to `lookupRecordByName`, all of them
-- "no identity was available", none of them "two candidates matched":
--   * the receiver head carries no identity (`headKeyIdent` = `None`) — the
--     flat/loader-less driver path, where NO declaration is stamped (#1115 /
--     E-1), and the `HkRigid` §8 I6.1 residual;
--   * the key has no companion row — the module's OWN records (the companion is
--     grown from `pubDecls` at the END of a module's arm, so a module never sees
--     itself in it) and every non-`ConNamed` declaration;
--   * no candidate's type identity equals the receiver's — e.g. a receiver whose
--     head is the TYPE of a named-field variant (`data T = | Cfg { … }`, key
--     `Cfg`, type `T`), which arm (a) misses today too and which the
--     field→owners path answers.
-- Two candidates can never BOTH match: a match requires equal
-- `(module, type name)`, and one module declaring two types of one name is a
-- duplicate-definition error.  So this cannot invent an ambiguity resolution.
lookupRecordForReceiver : ModuleCtx -> Mono -> String -> Option RecordInfo
lookupRecordForReceiver mctx te r =
  match recordForReceiverIdent mctx.mcGraph te r
    Some ri => Some ri
    None => match lookupRecordByName mctx r
      Some ri => if recordOfOtherType te ri then None else Some ri
      None => None

-- The floor answers by the record's NAME, and a program's own type may share a
-- prelude record's name (#3465: a program's `RField` beside the prelude's).  A
-- receiver whose type carries an identity is never given a record of a
-- different type; it falls to the field-owner path, which finds its own.  With
-- no identity on either side (the flat path) the floor stands.
recordOfOtherType : Mono -> RecordInfo -> Bool
recordOfOtherType te (RecordInfo _ _ res _ _) = match (
  receiverTypeIdent te,
  receiverTypeIdent res,
)
  (Some (Ident _ wo wn), Some (Ident _ ro rn)) => not (wn == rn && wo == ro)
  _ => False

-- The identity half.  `universeRecordPop`'s rows are indexed by the bare registry
-- key — an INDEX into a candidate list, not the selector; the selector is the
-- identity comparison below, which is why a collided key keeps both rows here
-- where `recordByNameRef` keeps one.
--
-- ⚠️ THE CHEAP LOOKUP RUNS FIRST, DELIBERATELY.  This is on the path of EVERY
-- `.field` access whose receiver head is a known record — not only the colliding
-- ones — so the ordering is a cost decision, not a style one: `omLookup`
-- allocates nothing, while `receiverTypeIdent` mints a `HeadKey` (and, inside it,
-- an `Ident`).  A key with no companion row therefore pays one map lookup and
-- allocates nothing at all.  Do not "simplify" by projecting the head first.
recordForReceiverIdent : GraphCtx -> Mono -> String -> Option RecordInfo
recordForReceiverIdent gctx te r =
  match omLookup r (spRows gctx.crossRun.universeRecordPop.value)
    None => None
    Some cs => match receiverTypeIdent te
      None => None
      Some ident => recordCandForType ident cs

-- ⚠️ ROUTED THROUGH `headTyconMono`, NOT A FRESH `Mono.TCon` PATTERN.  Reading
-- the origin field directly here would add a second site to the `Mono.TCon`
-- origin-read ratchet in `test/typecheck_compiler_source.sh` and duplicate the
-- head-node classification `headTyconMono`/`headTyconNameMono` owe each other.
-- `headKeyIdent` (`types/registry.mdk`) is the accessor; its `None` collapses
-- "rigid" and "no module id yet" because at a ROW lookup both mean the same
-- thing — the derivation is written at that function.
-- The receiver's type word (`headKeyTag`), else its bare head name.
receiverTypeWord : Mono -> String -> String
receiverTypeWord te r = match headTyconMono te
  Some hk => headKeyTag hk
  None => r

receiverTypeIdent : Mono -> Option Ident
receiverTypeIdent te = match headTyconMono te
  Some hk => headKeyIdent hk
  None => None

recordCandForType : Ident ->
  List (Ident, String, RecordInfo) ->
  Option RecordInfo
recordCandForType _ [] = None
recordCandForType want ((ci, tyName, ri) :: rest)
  | recordCandIsType want ci tyName = Some ri
  | otherwise = recordCandForType want rest

-- Is candidate `ci` (stored under its CONSTRUCTOR identity, beside the name of
-- the TYPE it builds) the declaration the receiver identity `want` names?
--
-- A candidate carries `Ident NsCtor o cn` plus `tyName`, because that is what
-- `insertRecordRow` has in hand; the receiver's head names the TYPE, so the
-- comparison is `(owning type name, declaring module)`.  `o` is the same
-- `dataOrigin` `registerRecordInfoKeyed` put in the record's result type, which
-- is what `headTyconMono` projects back out of a value of that record — so this
-- compares the two ends of one declaration.
--
-- 🚨 RETRACTION (#1381 round-2 review, finding 1).  THE TWO CONJUNCTS ARE NOT
-- SEPARATELY MEASURED, AND THE TYPE-NAME ONE CANNOT BE — by any fixture that
-- asserts a VALUE or an ACCEPTANCE.  An earlier version of this comment claimed
-- "each conjunct is measured, by a different fixture, and neither is measured by
-- the other's"; the counterfactual that would have shown it false is the one
-- that was never run.  What IS measured, by a separate cold rebuild each:
--   * drop `cio == wio` (type name only) → `record_receiver_ident_named_vs_held/`
--     goes RED; `…_value_only/` and `…_bystander/` stay GREEN.  So the
--     DECLARING-MODULE conjunct is load-bearing and is measured.
--   * drop BOTH (first candidate wins) → `…_bystander/` goes RED at `mkP.px`.
--   * drop `tyName == wname` (module only) → NOTHING IN THE TREE GOES RED.  All
--     52 `diff_compiler_llvm_modules` cells pass, `make check-self` is clean, and
--     five purpose-built probes with ≥2 differently-ordered fields (so a wrong
--     pick is observable rather than index-0-invisible) print the hand-derived
--     value on the EXECUTED native binary.
--   * stub the whole selection to `None` → both drain fixtures RED, bystander
--     GREEN (which is what makes it a bystander and not a second drain).
--
-- WHY NO FIXTURE CAN DISCRIMINATE IT — the derivation, so the next reader does
-- not re-run the rebuild.  The caller looks the candidate list up under
-- `r = headTyconNameMono te`, while `wname` comes from `headTyconMono te` →
-- `headKeyOfCon o n` → `Ident NsType o n`: the SAME `n`.  So `wname == r == the
-- outer key`, always, and `tyName == wname` reduces to "this candidate's owning
-- type name equals the registry key it is filed under" — i.e. "this candidate is
-- a plain record, not a named-field variant of a differently-named type".  When
-- the two conjuncts disagree the candidate is `(M, tyName = Y)` under key `r`
-- with `Y /= r` while the receiver's head is `(M, r)`; that candidate's result
-- head is `(M, Y)`, which can never unify with `(M, r)`.  And the floor
-- `lookupRecordByName r` can only return a record whose CONSTRUCTOR is `r`,
-- which is likewise never the receiver's own record.  BOTH ARMS REJECT.  So the
-- conjunct can change neither an accepted program's value nor accept vs reject.
--
-- IT IS OBSERVABLE IN DIAGNOSTIC TEXT, IN EXACTLY ONE SHAPE, AND THERE IT MAKES
-- THE MESSAGE WORSE.  Measured: `amod` declaring BOTH `data Tag = TA | TB` and
-- `data Box = | Tag { bx : Int }`, `zmod` declaring `data Tag = { tx : Int }`,
-- receiver `aTag : amod.Tag`, access `aTag.bx`.  Exit 1 either way.  With both
-- conjuncts: `Type mismatch: Tag vs Tag — … 'amod' … 'zmod'` plus a spurious
-- `Field 'bx' does not belong to record 'Tag'`.  With the module conjunct alone:
-- one `Type mismatch: Tag vs Box`, naming the record actually selected.  No
-- fixture pins this, deliberately — a golden here would enshrine the worse
-- message as the expected one.
--
-- SO WHY KEEP IT.  Deleting it moves the whole correctness of the selector onto
-- "a module contributes at most one candidate per registry key", which is true
-- only because two constructors of one name in one module is a `Duplicate
-- constructor` error — a property enforced by a DIFFERENT subsystem and asserted
-- nowhere near here.  Keeping the conjunct costs one monomorphic string compare
-- and keeps the comparison a direct expression of the question being asked.  It
-- is belt-and-braces, and this comment says so instead of claiming a measurement.
--
-- ⚠️ NAME FIRST, AND MONOMORPHIC — the discipline `tabKeyEq` states at its own
-- definition and `compiler/AGENTS.md` states for hot helpers.  It also allocates
-- nothing, which is why the candidate identity is compared component-wise rather
-- than rebuilt as an `Ident NsType …` and `==`-ed: this runs per candidate, per
-- field access.
--
-- ⚠️ THIS IS STRICTER THAN `unify`'s HEAD TEST, AND THE DIRECTION IS THE POINT.
-- `sameTyConHead` (`frontend/ast.mdk`) lets an ABSENT origin match anything,
-- because it answers an ACCEPTANCE question where a false reject refuses a valid
-- program.  This answers a LOOKUP, where a false hit is silent wrongness — so
-- absence must never match, and it cannot: `headKeyIdent` yields no `Ident` for
-- an unstamped head, and this function is not reached.  That inversion is the
-- same one `ifaceIdMatches` and `sameTyConHead` document at each other.
recordCandIsType : Ident -> Ident -> String -> Bool
recordCandIsType (Ident _ wio wname) (Ident _ cio _) tyName =
  tyName == wname && cio == wio

-- Does this candidate's `RecordInfo` describe the declaration the RECEIVER's head
-- names?  `rk` is the receiver's key, projected once by the caller rather than per
-- candidate; `headTyconMono` produces both sides rather than a bespoke match, so
-- no new origin-binding `Mono.TCon` pattern enters the set
-- `test/typecheck_compiler_source.sh` pins.
--
-- The equality is `HeadKey`'s DERIVED one, and that is the fail-safe: `HeadKey`
-- embeds `TabKey`, whose `TkIdent`/`TkBare` split `types/registry.mdk` defines so a
-- key with identity can never equal one without.  So a receiver whose head was never
-- stamped matches ZERO candidates — not "the first one" — and the caller falls back
-- to today's ladder unchanged.  An absent identity therefore decides nothing, which
-- is the same absence-makes-no-claim rule `sameTyConHead` owns one layer down.
recordCandIsReceiverDecl : Option HeadKey -> (String, RecordInfo) -> Bool
recordCandIsReceiverDecl rk (_, ri) = rk == headTyconMono (recordResultMono ri)

resolveFieldByOwners : ModuleCtx ->
  Mono ->
  String ->
  Option (String, RecordInfo)
resolveFieldByOwners mctx te fname =
  let owners = fieldOwnerNames mctx fname
  match ownerDeclOfReceiver mctx te fname owners
    Some pair => Some pair
    None => match owners
      [] =>
        let _ = pushUnknownField mctx fname "<unknown>"
        None
      _ => match normalize te
        TVar _ => resolveFieldUnknownReceiver mctx fname owners
        _ => resolveFieldAmbiguous mctx te fname owners

-- An unannotated receiver says nothing about its type, so the candidates are the
-- record declarations visible here that declare `fname`.  An owner key names a
-- SPELLING, and `recordByNameRef` holds one declaration per spelling: the one this
-- module's own source means.  A value reaching `.fname` need not be of that
-- declaration (a named-field variant may share its constructor's spelling with
-- another module's record), so each key is expanded to every declaration filed
-- under it, and a declaration that does not declare `fname` is dropped.
--
-- The constructors of one type count once: the selection is a TYPE question, and
-- `fieldSelectionWellTyped` decides afterwards whether that type's constructors
-- agree about the field's slot.  Two types left is an ambiguity, reported at the
-- access.  No candidate at all keeps the owner-list answer.
resolveFieldUnknownReceiver : ModuleCtx ->
  String ->
  List String ->
  Option (String, RecordInfo)
resolveFieldUnknownReceiver mctx fname owners =
  match visibleFieldDecls mctx fname owners
    [pair] => Some pair
    [] => match owners
      [r] => pairRecordByName mctx r
      _ =>
        let _ =
          pushTypeError
            mctx
            "T-AMBIGUOUS-FIELD"
            (ambiguousFieldMsg fname owners)
        None
    cands =>
      let _ =
        pushTypeError
          mctx
          "T-AMBIGUOUS-FIELD"
          (ambiguousFieldDeclsMsg fname owners cands)
      None

-- The declarations under the owner keys that declare `fname`, reachable from this
-- module, one per type.  The floor row comes first under each key so that, when it
-- is one of the population's rows, the `RecordInfo` this module registered is the
-- one kept.
visibleFieldDecls : ModuleCtx ->
  String ->
  List String ->
  List (String, RecordInfo)
visibleFieldDecls mctx fname owners =
  dedupBy
    fieldDeclTypeKey
    (fieldDeclReachFilter mctx (flatMap (keyFieldDecls mctx fname) owners))

keyFieldDecls : ModuleCtx -> String -> String -> List (String, RecordInfo)
keyFieldDecls mctx fname k =
  let rows =
    map
      (c => (k, recordCandInfo c))
      (spCandsOf k mctx.mcGraph.crossRun.universeRecordPop.value)
  let floor = match pairRecordByName mctx k
    Some pair => [pair]
    None => []
  filterList (c => omHasKey fname (recordFieldMap (snd c))) (floor ++ rows)

-- Same fail-open shape as `fieldOwnerReachFilter`: a declaration whose module is
-- unknown is kept, and a filter that would remove every candidate removes none.
fieldDeclReachFilter : ModuleCtx ->
  List (String, RecordInfo) ->
  List (String, RecordInfo)
fieldDeclReachFilter mctx cands =
  match filterList (fieldDeclReachable mctx) cands
    [] => cands
    kept => kept

fieldDeclReachable : ModuleCtx -> (String, RecordInfo) -> Bool
fieldDeclReachable mctx (_, ri) = match recordOwnerModule ri
  None => True
  Some mid =>
    let reach = mctx.mcCells.fieldOwnerReachRef.value
    omSize reach == 0 || omHasKey mid reach

-- The declaring type's tag, so two named-field constructors of one type collapse.
fieldDeclTypeKey : (String, RecordInfo) -> String
fieldDeclTypeKey (k, ri) = match headTyconMono (recordResultMono ri)
  Some hk => headKeyTag hk
  None => k

-- #1383: a concrete receiver's field is answered by the receiver's own
-- declaration.  The floor `recordByNameRef` keeps one row per bare key, so when a
-- named-field variant (`data Holder = | Plain { hx }`) shares its key with
-- another module's record (`data Plain = { px }`), the floor can hold the other
-- declaration and the ladder below would pick it by registration order.  The
-- identity companion keeps every module's row under that key; the receiver's
-- `(declaring module, type name)` picks among them.
--
-- The answer is `(k, ri)` with `ri` read from the companion row filed under `k`,
-- so the stamp `stampedRecordHead k ri` names the selected declaration's own
-- module: the emitters apply that declaration's layout.
--
-- The matches are collapsed by declaring type (`fieldDeclTypeKey`): every match
-- is a constructor of the receiver's one type, so two owner keys naming two of its
-- constructors are one answer, and `fieldSelectionWellTyped` decides afterwards
-- whether they agree about the field's slot.
--
-- Declines (answers `None`, so the ladder runs unchanged) when the receiver
-- carries no identity, when no owner key holds the receiver's declaration, or when
-- a sibling constructor of the receiver's type withholds the field.  The sibling
-- case is the multi-`ConNamed`-variant shape `narrowedPick` refuses: the
-- receiver's type does not say which layout applies.
ownerDeclOfReceiver : ModuleCtx ->
  Mono ->
  String ->
  List String ->
  Option (String, RecordInfo)
ownerDeclOfReceiver mctx _ _ [] = None
ownerDeclOfReceiver mctx te fname owners = match receiverTypeIdent te
  None => None
  Some ident =>
    match dedupBy fieldDeclTypeKey (ownerDeclMatches mctx.mcGraph ident owners)
      [(k, ri)] =>
        if narrowingBlockedByCtorSibling mctx (headTyconMono te) fname k then
          None
        else
          Some (k, ri)
      _ => None

-- Every owner key whose companion rows hold the declaration `ident` names, with
-- that row's `RecordInfo`.
ownerDeclMatches : GraphCtx -> Ident -> List String -> List (String, RecordInfo)
ownerDeclMatches gctx _ [] = []
ownerDeclMatches gctx ident (k :: rest) =
  match omLookup k (spRows gctx.crossRun.universeRecordPop.value)
    None => ownerDeclMatches gctx ident rest
    Some cs => match recordCandForType ident cs
      None => ownerDeclMatches gctx ident rest
      Some ri => (k, ri) :: ownerDeclMatches gctx ident rest

-- A concrete receiver that is not itself a known record: one owner is that owner;
-- several are narrowed by the receiver's own declaration identity, and only if that
-- does not land on exactly one owner fall back to picking the first owner so the
-- later unify surfaces the type mismatch (mirrors the oracle's two `_` sub-branches).
resolveFieldAmbiguous : ModuleCtx ->
  Mono ->
  String ->
  List String ->
  Option (String, RecordInfo)
resolveFieldAmbiguous mctx _ _ [r] = pairRecordByName mctx r
resolveFieldAmbiguous mctx te fname owners =
  resolveFieldOwnersNarrowed mctx te fname owners

-- ── #1216 / #1382: the multi-owner arm stops answering by sort order ──────────
-- `sortUniqS` makes `head owners` a MODULE-NAME SORT, so before this the concrete
-- arm decided which record a `.field` access means by the alphabetical order of the
-- declaring modules — measured on the emit path as `CFieldAccess (CVar
-- "zwrap__mkZ") "a" "awrap__Cfg"`: zwrap's value, awrap's record, applied
-- faithfully by the backend.
--
-- The narrowing asks the one question the bare key cannot: which DECLARATION does
-- the receiver's own head name?  It ADOPTS `recordCandIsReceiverDecl` — the same
-- comparator the receiver-declaration lookups share — so both sides go
-- through `headTyconMono` and the comparison is on `HeadKey`, not on the string
-- every candidate here spells identically by construction.
--
-- WHAT THIS HAS, AND WHAT IT MEASURABLY DOES NOT — the second and third bullets
-- below replace three claims that shipped with the original narrowing and were
-- **measured false** by the adversarial review of `S-record-pairing-identity`.
-- Keep them stated as measurements; the false versions cost a reviewer a round and
-- were the stated reason the flat path carried no test cell.
--   * ABSENCE DECIDES NOTHING.  `HeadKey` embeds `TabKey`, whose `TkIdent`/`TkBare`
--     split means a key carrying identity can never equal one that does not.  A
--     receiver whose head was never stamped at all matches ZERO candidates and
--     falls through to exactly today's answer — never "the first one".
--   * ⚠️ IT IS LIVE ON THE FLAT/SINGLE-FILE DRIVER.  The retracted claim was that
--     the retired unstamped driver, where every decl was `TkBare`, matched zero candidates.
--     FALSE: `TkBare Ns String` CARRIES the type name, so two bare keys naming the
--     same type ARE equal, and the narrowing selects there.  Measured: `flat/p.mdk`
--     (two single-ctor records sharing field `tag`, concrete receiver) goes from a
--     base-arm `Type mismatch: Beta vs Alpha` to the hand-derived correct `42`.
--     That direction is CORRECT and is kept; `test/llvm_fixtures_modules/
--     record_owner_ctor_ambiguity/` carries the flat cell so it stays graded.
--   * ⚠️ IT CAN WIDEN AN ACCEPT, WHICH IS WHY THE SIBLING GUARD EXISTS.  The
--     retracted claim was that "anything other than exactly one surviving candidate
--     returns today's answer, so it can never widen an accept" — the premise is
--     true and the conclusion does not follow: a singleton survivor is itself a new
--     accept where the old ladder's `head` pick reached a unify mismatch.  For
--     SINGLE-constructor records that widening is the fix (`flat`, `#1216`).  For a
--     MULTI-`ConNamed`-variant type it was unsound, exactly as the `#1319 UNIT 2`
--     note above predicted for a type-keyed record index: `recordCandIsReceiverDecl`
--     compares RESULT-TYPE heads while `registerRecordInfoKeyed` registers one
--     `RecordInfo` per named-field CONSTRUCTOR, so for
--     `data T = Zed { x } | Oth { y }` every candidate of type `T` compares equal to
--     an `Oth` receiver and the filter lands on `Zed` with full confidence.
--     Measured on `ada2bd57`: `(Oth …).x` went from a base-arm `exit 1` on
--     check/run/build to `check` exit 0 and a BUILT BINARY printing `99` — a
--     loud→silent transition.  `narrowingBlockedByCtorSibling` below is the repair.
--   * IT CANNOT TURN NOTHING INTO SOMETHING.  Every candidate is built by a
--     SUCCESSFUL `lookupRecordByName`, and the fall-through is byte-for-byte the
--     old expression, so no program that resolved to `None` here can now resolve to
--     `Some`.
--
-- The survivors are collapsed by declaring type (`fieldDeclTypeKey`, as in the
-- unannotated-receiver path): the named-field constructors of the receiver's type
-- are one candidate, and `fieldSelectionWellTyped` decides afterwards whether they
-- agree about the field's slot and type.  Left uncollapsed, two constructors of
-- one type are two survivors, and the answer becomes the sorted `head owners`,
-- which depends on how an unrelated type's constructor is spelled.
--
-- One mint of the receiver's key for the whole filter, not one per candidate, for the
-- reason `types/registry.mdk` gives against re-minting a `TabKey` per lookup
-- (`tabKeyOf` → `mkIdent` → `identOriginOf` allocates on the way).
resolveFieldOwnersNarrowed : ModuleCtx ->
  Mono ->
  String ->
  List String ->
  Option (String, RecordInfo)
resolveFieldOwnersNarrowed mctx te fname owners =
  let rk = headTyconMono te
  narrowedPick
    mctx
    rk
    fname
    owners
    (dedupBy
      fieldDeclTypeKey
      (filterList (recordCandIsReceiverDecl rk) (ownerCandidates mctx owners)))

-- The singleton gate, plus the guard the comparator's granularity requires.  A
-- lone survivor is trusted ONLY when the receiver's type does not also have a
-- named-field constructor that withholds this field: a value of type `T` carries no
-- static constructor tag, so where two constructors of `T` disagree about `fname`
-- the receiver's TYPE cannot say which layout applies, and selecting is guessing.
-- Anything else — zero survivors, several survivors, or a blocked singleton —
-- returns the pre-narrowing answer byte-for-byte, the same `_ =>` fall-through the
-- original arm had.
narrowedPick : ModuleCtx ->
  Option HeadKey ->
  String ->
  List String ->
  List (String, RecordInfo) ->
  Option (String, RecordInfo)
narrowedPick mctx rk fname _ [(k, ri)]
  | not (narrowingBlockedByCtorSibling mctx rk fname k) = Some (k, ri)
narrowedPick mctx _ _ owners _ =
  pairRecordByName mctx (optionOr "" (head owners))

-- Is there ANOTHER registered named-field constructor sharing the survivor's
-- RESULT head that does NOT declare `fname`?  That is precisely the
-- multi-`ConNamed`-variant shape whose layout the receiver's type underdetermines.
-- A record re-registered under a second key is excluded by construction: it
-- declares `fname` too, so it fails the withholds test (and it would already be a
-- second survivor, since `fieldOwnersRef` is written in lockstep with
-- `recordByNameRef` by `registerRecordInfoKeyed`).
-- Cost: one pass over the record registry, taken ONLY when the filter produced a
-- singleton — i.e. in the give-up arm of a multi-owner field access, never on the
-- exact-hit path.
narrowingBlockedByCtorSibling : ModuleCtx ->
  Option HeadKey ->
  String ->
  String ->
  Bool
narrowingBlockedByCtorSibling mctx rk fname survivorKey =
  isSome (ctorSiblingWithholdingName mctx rk fname survivorKey)

-- The same walk, answering with the offending key rather than a bare `Bool` — #1468's
-- diagnostic has to NAME the constructor, and the Bool above is now `isSome` of this
-- so the two callers cannot drift about what "a sibling withholds it" means.
--
-- #1468 residual fix: the candidate list used to be sourced from
-- `recordByNameRef`, which `registerRecordInfoKeyed` only ever populates for
-- `ConNamed` variants — a positional (`ConPos`) or nullary sibling of the SAME
-- type could never appear there, so it could never be found "withholding" the
-- field even though it declares no named field at all.  Source the FULL
-- constructor list of the receiver's type instead, from the compiler's own
-- ctor oracle (`matchOracle`'s `typeCtors`, built from every `Variant` of every
-- `data` decl regardless of shape) via `oGetCtors`, keyed by `TabKey` — not by
-- bare name — and reachable from `rk : Option HeadKey` through `ctorOracleKeyOf`.
ctorSiblingWithholdingName : ModuleCtx ->
  Option HeadKey ->
  String ->
  String ->
  Option String
ctorSiblingWithholdingName mctx None _ _ = None
ctorSiblingWithholdingName mctx (Some hk) fname survivorKey =
  match ctorsOfHead mctx hk
    None => None
    Some ctors => firstCtorSiblingWithholding mctx hk fname survivorKey ctors

-- 🚨 THE READER'S KEY MINT FOR `matchOracle`'s `typeCtors`, AND IT IS **NOT**
-- `headTabOf`.  `typeCtors` is the one oracle table keyed by DECLARATION
-- IDENTITY (`frontend/exhaust.mdk`, oracle-identity leaf L1): its rows are
-- minted `tabKeyOf NsType <that decl's own dataOrigin> <tyname>`, so a
-- module-stamped `data T` writes a `TkIdent` row.  `headTabOf` goes through
-- `dispHeadTab hk = TkBare NsType (headKeyName hk)`, which flattens EVERY head
-- to `TkBare` — deliberately, because the dispatch head-buckets it was built
-- for are SPELLING-keyed (the #1317 T1 rule, the closed S0 #1277).  `tabKeyEq`
-- never equates a `TkBare` lookup with a `TkIdent` row, so keying this table
-- through `headTabOf` MISSED on every module-stamped type — and both `None`
-- arms above fail OPEN, i.e. "no sibling withholds the field", i.e. the
-- narrowing is trusted and the singleton survivor is accepted.
--
-- MEASURED (F4, this branch, on `44be8191`):
-- `test/analyze_project_fixtures/record_ctor_sibling_blocks_narrowing/`
-- `main_rejects.mdk` — #1468's ORIGINAL cross-module repro — went to `check`
-- exit 0 with ZERO diagnostics where the pinned oracle expects
-- `T-TYPE-MISMATCH: Type mismatch: T vs U`, while the byte-identical program
-- written as ONE file still rejected: single-file decls are unstamped, so
-- `tabKeyOf NsType OriginUnresolved "T"` is itself `TkBare` and the wrong mint
-- accidentally agreed.  That is why F1's own single-file acceptance checks
-- could not see this.  Instrumenting the two `None` arms apart (a marker
-- `Some` scoped to `fname == "x" && survivorKey == "Zed"`, so the compiler's
-- own source stayed unaffected) pinned it to the `oGetCtors` arm specifically:
-- `headTabOf` answered `Some`, the `TabKey` lookup missed.  Same
-- writer/reader `TkBare`-vs-`TkIdent` mismatch already documented at
-- `seedAndCheckSplit`, one table over.
--
-- The mint below is `matchCol0Type`'s — the OTHER `oGetCtors` reader in this
-- file — minus the arms it needs only because it starts from a `Mono`: keep
-- `HkDecl`'s own `TabKey` (which already distinguishes an identity-bearing
-- `TkIdent` from the flat path's `TkBare`), and refuse to key a rigid head at
-- all.  §8 I6.1: a type PARAMETER is not a declaration; `matchCol0Type`'s
-- `TkBare NsType n` for that case is a key no writer can ever have filled, so
-- `None` here is the same miss without minting a forgery to reach it.
ctorOracleKeyOf : Option HeadKey -> Option TabKey
ctorOracleKeyOf None = None
ctorOracleKeyOf (Some hk) = headKeyDecl hk

firstCtorSiblingWithholding : ModuleCtx ->
  HeadKey ->
  String ->
  String ->
  List String ->
  Option String
firstCtorSiblingWithholding mctx _ _ _ [] = None
firstCtorSiblingWithholding mctx hk fname skey (k :: rest)
  | k == skey = firstCtorSiblingWithholding mctx hk fname skey rest
  | ctorSiblingWithholds mctx hk fname k = Some k
  | otherwise = firstCtorSiblingWithholding mctx hk fname skey rest

-- `oGetCtors` already scopes the candidate list to the receiver's own type
-- (via the `TabKey` lookup above), so this no longer needs to re-check the
-- head itself — only whether THIS constructor declares `fname`.  A name with
-- no `RecordInfo` of this type is a positional or nullary constructor: it
-- declares no named field, so it unconditionally withholds `fname`.
ctorSiblingWithholds : ModuleCtx -> HeadKey -> String -> String -> Bool
ctorSiblingWithholds mctx hk fname k = match ctorRecordOfType mctx hk k
  Some ri => isNone (omLookup fname (recordFieldMap ri))
  None => True

-- The `RecordInfo` constructor `k` of the type `hk` declares.  `k` is a
-- spelling, and the bare-keyed floor `recordByNameRef` keeps one row per
-- spelling, so a same-spelled constructor of another module's type can own it.
-- The identity companion is asked first (as `ownerDeclMatches` does), and a
-- floor row is accepted only when its result head IS `hk`.
ctorRecordOfType : ModuleCtx -> HeadKey -> String -> Option RecordInfo
ctorRecordOfType mctx hk k = match ctorRecordFromCompanion mctx.mcGraph hk k
  Some ri => Some ri
  None => match lookupRecordByName mctx k
    Some ri =>
      if recordCandIsReceiverDecl (Some hk) (k, ri) then Some ri else None
    None => None

ctorRecordFromCompanion : GraphCtx -> HeadKey -> String -> Option RecordInfo
ctorRecordFromCompanion gctx hk k = match headKeyIdent hk
  None => None
  Some ident => match omLookup k (spRows gctx.crossRun.universeRecordPop.value)
    None => None
    Some cs => recordCandForType ident cs

-- Each owner key paired with its `RecordInfo`; a key with no entry is dropped
-- rather than defaulted, so the filter above only ever sees real declarations.
ownerCandidates : ModuleCtx -> List String -> List (String, RecordInfo)
ownerCandidates mctx [] = []
ownerCandidates mctx (key :: rest) = match lookupRecordByName mctx key
  Some ri => (key, ri) :: ownerCandidates mctx rest
  None => ownerCandidates mctx rest

pairRecordByName : ModuleCtx -> String -> Option (String, RecordInfo)
pairRecordByName mctx r = map (ri => (r, ri)) (lookupRecordByName mctx r)

pushUnknownField : ModuleCtx -> String -> String -> Unit
pushUnknownField mctx fname rname =
  pushTypeError mctx "T-UNKNOWN-FIELD" (unknownFieldMsg fname rname)

-- `declared`: the record's own field names, so a genuine typo (`aeg` for
-- `age`) can be suggested (ERROR-QUALITY dim F).  When a close-enough
-- candidate exists the error gets a structured `help` + a machine `fix` that
-- replaces the bad field name's span with the suggestion; otherwise unchanged.
unknownFieldFresh : ModuleCtx -> String -> String -> List String -> Mono
unknownFieldFresh mctx fname rname declared =
  let _ = pushUnknownFieldMaybeSuggest mctx fname rname declared
  let v = freshVar mctx ()
  -- Chunk A: the field error already explained this access; poison its result
  -- var so a downstream `debug`/method use doesn't pile on a secondary
  -- `ambiguous instance` cascade (record_wrong_field).
  let _ = poisonMismatchVars mctx v v
  v

pushUnknownFieldMaybeSuggest : ModuleCtx ->
  String ->
  String ->
  List String ->
  Unit
pushUnknownFieldMaybeSuggest mctx fname rname declared =
  match suggestField fname declared
    None => pushTypeError mctx "T-UNKNOWN-FIELD" (unknownFieldMsg fname rname)
    Some sug =>
      pushTypeErrorHelpFixAt
        mctx
        "T-UNKNOWN-FIELD"
        mctx.mcLoc
        (unknownFieldMsg fname rname ++ "; did you mean `\{sug}`?")
        "did you mean `\{sug}`?"
        (fieldFixFrom mctx.mcLoc fname sug)

-- "did you mean" for a record field: nearest declared field name by
-- Levenshtein distance, within a fixed distance of 2.  Skip names < 3 chars
-- (too noisy at that length, same floor as resolve.mdk's `suggestName`).
-- Unlike `suggestName` — which searches EVERY in-scope name and so scales its
-- threshold down with length to avoid noise in a large candidate pool — the
-- candidate pool here is one record's OWN declared fields (typically a
-- handful), so a flat distance-2 budget is safe: it's what's needed to catch
-- a two-letter transposition (`aeg` vs `age`, distance 2) without the
-- length-scaled cap resolve.mdk uses (which would reject that exact case:
-- min(2, max(1, 3/3)) = 1).  Ties favor the lexicographically-first candidate.
-- A small local copy rather than importing resolve.mdk's `suggestName`, which
-- would cycle (nothing here imports resolve.mdk today, and this file is a
-- dependency of the pipeline stage that runs after it).
suggestField : String -> List String -> Option String
suggestField fname declared
  | stringLength fname < 3 = None
  | otherwise = map fst (bestFieldCandidate fname 2 declared None)

bestFieldCandidate : String ->
  Int ->
  List String ->
  Option (String, Int) ->
  Option (String, Int)
bestFieldCandidate _ _ [] acc = acc
bestFieldCandidate fname lim (c :: cs) acc
  | c == fname = bestFieldCandidate fname lim cs acc
  | editDistance fname c > lim = bestFieldCandidate fname lim cs acc
  | otherwise =
    bestFieldCandidate
      fname
      lim
      cs
      (keepBetterField c (editDistance fname c) acc)

keepBetterField : String -> Int -> Option (String, Int) -> Option (String, Int)
keepBetterField c d None = Some (c, d)
keepBetterField c d (Some (bc, bd)) =
  if d < bd || d == bd && c < bc then Some (c, d) else Some (bc, bd)

-- push the message + return a fresh placeholder type so the continued path stays
-- in a valid state (the oracle accumulate-and-continue analog for these shapes).
unknownRecordFresh : ModuleCtx -> String -> Mono
unknownRecordFresh mctx name =
  let _ = pushTypeError mctx "T-UNKNOWN-RECORD" (unknownRecordMsg name)
  freshVar mctx ()

unboundVarFresh : ModuleCtx -> String -> Mono
unboundVarFresh mctx name =
  let _ = pushTypeError mctx "T-UNBOUND" (unboundVarMsg name)
  freshVar mctx ()

inferRecordUpdate : TcEnv -> Expr -> List FieldAssign -> EvId -> Mono
inferRecordUpdate env base fields ev = match firstFieldName fields
  None => panic "empty record update"
  Some fn => inferRecordUpdateField env base fields fn ev

-- `Con { base | f = v, … }` — a named-field-variant update (e.g. desugar's
-- `DInterface { d | methods = … }`).  Resolve the variant's field layout by the
-- CONSTRUCTOR name (registered via registerNamedFieldVariants); both `base` and
-- the result have the variant's DATA type, only the provided fields are typed.
inferVariantUpdate : TcEnv -> String -> Expr -> List FieldAssign -> Mono
inferVariantUpdate env cname base fields =
  match lookupRecordByName env.teDyn.dcModule cname
    None => unknownRecordFresh env.teDyn.dcModule cname
    Some ri => inferRecordUpdateWith env cname base fields ri

firstFieldName : List FieldAssign -> Option String
firstFieldName [] = None
firstFieldName ((FieldAssign fn _) :: _) = Some fn

-- receiver-directed (Phase 72), like inferFieldAccess: infer base first, then
-- pick the owning record by the base's head tycon, falling back to the first
-- update field's owners.
inferRecordUpdateField : TcEnv ->
  Expr ->
  List FieldAssign ->
  String ->
  EvId ->
  Mono
inferRecordUpdateField env base fields fn ev =
  let bt = normalize (infer env base)
  match resolveFieldRecord env.teDyn.dcModule bt fn
    None => freshVar env.teDyn.dcModule ()
    Some (rname, ri) =>
      -- stamp the RESOLVED receiver record onto the node (bug #38): both emitters
      -- read it to pick the record by name, instead of guessing from the first
      -- update label (which picks the wrong record — and so the wrong slot — when
      -- two records share a field name at different indices).
      siteHeadCell env.teDyn.dcModule.mcGraph ev := stampedRecordHead rname ri
      inferRecordUpdatePicked rname bt env fields ri

inferRecordUpdatePicked : String ->
  Mono ->
  TcEnv ->
  List FieldAssign ->
  RecordInfo ->
  Mono
inferRecordUpdatePicked rname bt env fields ri =
  let sr =
    instantiateRecordUpdate
      env.teDyn.dcModule
      rname
      ri
      (assignedFieldNames fields)
  let _ = unifyIn env.teDyn bt (snd sr)
  -- Before the field values are inferred, so the error sits on the receiver.
  let _ = match firstFieldName fields
    Some fn => recordUpdateWellTyped env.teDyn.dcModule bt rname ri fn
    None => ()
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

inferRecordUpdateWith : TcEnv ->
  String ->
  Expr ->
  List FieldAssign ->
  RecordInfo ->
  Mono
inferRecordUpdateWith env rname base fields ri =
  let sr =
    instantiateRecordUpdate
      env.teDyn.dcModule
      rname
      ri
      (assignedFieldNames fields)
  let _ = unifyIn env.teDyn (infer env base) (snd sr)
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

-- Operator predicates use language-fixed prelude interfaces, independent of
-- term-level method lookup. Their residuals can appear in inferred schemes.
inferBinopE : TcEnv -> String -> Expr -> Expr -> Ref Route -> Mono
inferBinopE env op l r dref =
  let lt = infer env l
  let rt = infer env r
  -- The binop node carries no `ELoc` (the parser wraps its operands), so its
  -- own checks name the whole `l <op> r` span (l's start .. r's end): the
  -- Num-obligation errors and the comparison/Eq/Ord `typeMismatch` binop
  -- errors squiggle the operator expression rather than a lone operand.
  let at = envAtIfSome (binopSpanLoc l r) env
  let _ = recordBinopGoals at.teDyn.dcModule op dref lt
  if op == "|>" then pipeOp at l r lt rt else inferBinop at.teDyn op lt rt

-- Synthesize the whole-binop span from its operand Exprs: file + start of the
-- left operand, end of the right operand.  Falls back to whichever single
-- operand loc is available (None only when neither operand is ELoc-wrapped).
binopSpanLoc : Expr -> Expr -> Option Loc
binopSpanLoc l r = match (exprLoc l, exprLoc r)
  (Some (Loc f sl sc _ _), Some (Loc _ _ _ el ec)) => Some (Loc f sl sc el ec)
  (Some ll, None) => Some ll
  (None, Some rr) => Some rr
  (None, None) => None
-- Phase 151 / Gap G: record a binop site for the comparison/equality operators
-- so resolveBinopSites can stamp [dref] once the operand type grounds.  The
-- operand mono is [lt] (unified with [rt] by eqCompareOp/ordCompareOp below).

-- Map a comparison/equality operator to its Eq/Ord method and stash a pending
-- binop site; non-comparison operators record nothing.  G4: snapshot
-- currentImplBody so resolveBinopSite gates the RDict element-dict route to genuine
-- in-impl-body sites (a top-level operand may collide with stale activeDictVars ids).
recordBinopSite : ModuleCtx -> String -> Ref Route -> Mono -> Unit
recordBinopSite mctx op dref m = match binopMethod op
  Some method =>
    pushSiteGoal
      mctx.mcGraph
      GKBinopSite
      (Ref innerNone)
      (PendingEntry
        method
        dref
        m
        mctx.mcCells.currentFn.value
        (SKOp mctx.mcCells.currentImplBody.value)
        mctx.mcLoc
        (captureScope mctx ())
        (freshEvId mctx ()))
  None => ()

-- Arithmetic produces one predicate-aware route goal and destination when the
-- prelude Num declaration is present; UObligation remains the checker channel.
-- Without the prelude, the same method arm retains the scalar deferred stamp.
-- Non-arithmetic operators use the legacy comparison/append recorder.
arithDispatchMethod : String -> Option String
arithDispatchMethod "+" = Some "add"
arithDispatchMethod "-" = Some "sub"
arithDispatchMethod "*" = Some "mul"
arithDispatchMethod "/" = Some "div"
arithDispatchMethod "%" = Some "rem"
arithDispatchMethod _ = None

recordBinopGoals : ModuleCtx -> String -> Ref Route -> Mono -> Unit
recordBinopGoals mctx op dref m = match arithDispatchMethod op
  Some method =>
    if builtinClassPresent mctx.mcGraph BNum then
      let predicate = ClassPredicate {
        predicateInterface = builtinIfaceRef mctx.mcGraph BNum,
        predicateArguments = [m],
      }
      let scope = captureScope mctx ()
      let _ =
        noteNumericPredicateTrace
          mctx.mcGraph
          NPTProduced
          predicate
          scope
          mctx.mcLoc
          None
          None
          []
      let _ =
        pushSiteGoal
          mctx.mcGraph
          GKBinopSite
          (Ref innerNone)
          (PendingEntry
            method
            dref
            m
            mctx.mcCells.currentFn.value
            (SKPredicateOp mctx.mcCells.currentImplBody.value predicate)
            mctx.mcLoc
            scope
            (freshEvId mctx ()))
      ()
    else
      pushArithGoal mctx dref m (freshEvId mctx ())
  None => recordBinopSite mctx op dref m

-- Roadmap #18a: `++` is the surface operator for `Semigroup`'s `append`, so it
-- joins the comparison operators on the recordBinopSite/resolveBinopSites seam —
-- a ground non-builtin operand (a user `impl Semigroup MyRope`) gets its route
-- stamped and rewriteBinopExpr turns the EBinOp into an `EMethodAt "append"`
-- application.  The builtin String/List appends never route (binopBuiltinHead) —
-- see the recursion note there.
binopMethod : String -> Option String
binopMethod "==" = Some "eq"
binopMethod "/=" = Some "eq"
binopMethod "<" = Some "lt"
binopMethod ">" = Some "gt"
binopMethod "<=" = Some "lte"
binopMethod ">=" = Some "gte"
binopMethod "++" = Some "append"
binopMethod _ = None

-- Roadmap #18c: `-` (unary minus) is the surface operator for `Num`'s `negate`,
-- joining `++`/comparisons on the record*Site/resolve*Sites/rewrite*Expr seam.
-- `!` never routes — Bool negation is not a typeclass method.
unopMethod : String -> Option String
unopMethod "-" = Some "negate"
unopMethod _ = None

-- The EUnOp analogue of recordBinopGoals: stash a pending unop site for `-`
-- (nothing for `!`).  `-` is `Num`'s `negate`, so like binary arithmetic it carries
-- its complete `Num` predicate and is answered by predicate identity, which also
-- reaches a dictionary-abstracted local's generalized operand.
recordUnopSite : ModuleCtx -> String -> Ref Route -> Mono -> Unit
recordUnopSite mctx op dref m = match unopMethod op
  Some method =>
    let inImpl = mctx.mcCells.currentImplBody.value
    let kind =
      if builtinClassPresent mctx.mcGraph BNum then
        SKPredicateOp inImpl ClassPredicate {
          predicateInterface = builtinIfaceRef mctx.mcGraph BNum,
          predicateArguments = [m],
        }
      else
        SKOp inImpl
    pushSiteGoal
      mctx.mcGraph
      GKUnopSite
      (Ref innerNone)
      (PendingEntry
        method
        dref
        m
        mctx.mcCells.currentFn.value
        kind
        mctx.mcLoc
        (captureScope mctx ())
        (freshEvId mctx ()))
  None => ()

-- The EUnOp analogue of inferBinopE: infer the single operand, record its
-- pending unop site (for `-`), then dispatch to inferUnop for the actual
-- obligation/unification work (negateOp for `-`, Bool-unify for `!`).
inferUnopE : TcEnv -> String -> Expr -> Ref Route -> Mono
inferUnopE env op e dref =
  let t = infer env e
  let _ = recordUnopSite env.teDyn.dcModule op dref t
  let _ = if op == "-" then recordNegatedLitRange env.teDyn.dcModule t e
  inferUnop env.teDyn op t

-- `-2` is usually `negate 2`, not one fused literal (the parser fuses only a tight
-- argument and the 2^62 minimum), so the fixed-width range check would see only the
-- in-range `2`.  A negated literal is checked as the negative value it spells: its
-- var is the result's var, so `-2 : U8` is `L-INT-OVERFLOW` like any other literal.
-- The negated value REPLACES the literal's own entry (the one `infer` just pushed),
-- so `-300 : U8` is one error, not a second one for `300`.  The catch-all arm is
-- deliberate: any operand other than a (located) literal is ordinary arithmetic.
recordNegatedLitRange : ModuleCtx -> Mono -> Expr -> Unit
recordNegatedLitRange mctx t (ELoc _ e) = recordNegatedLitRange mctx t e
recordNegatedLitRange mctx t (ENumLit n _ _) =
  match mctx.mcCells.numlitRanges.value
    (_, m, loc) :: rest if m == n =>
      mctx.mcCells.numlitRanges := (t, negateLiteral n, loc) :: rest
    _ => recordNumlitRange mctx t (negateLiteral n)
recordNegatedLitRange mctx t (EWideLit _ _ _ lx) =
  match mctx.mcCells.wideLitRanges.value
    (_, l, hi, lo, _, loc) :: rest if l == lx =>
      mctx.mcCells.wideLitRanges := (t, lx, hi, lo, True, loc) :: rest
    _ => ()
recordNegatedLitRange mctx _ _ = ()

inferBinop : DynCtx -> String -> Mono -> Mono -> Mono
inferBinop dyn "+" lt rt = numArithOp dyn lt rt
inferBinop dyn "-" lt rt = numArithOp dyn lt rt
inferBinop dyn "*" lt rt = numArithOp dyn lt rt
inferBinop dyn "/" lt rt = numArithOp dyn lt rt
inferBinop dyn "%" lt rt = numArithOp dyn lt rt
inferBinop dyn "++" lt rt = appendOp dyn lt rt
inferBinop dyn "==" lt rt = eqCompareOp dyn lt rt
inferBinop dyn "/=" lt rt = eqCompareOp dyn lt rt
inferBinop dyn "<" lt rt = ordCompareOp dyn lt rt
inferBinop dyn ">" lt rt = ordCompareOp dyn lt rt
inferBinop dyn "<=" lt rt = ordCompareOp dyn lt rt
inferBinop dyn ">=" lt rt = ordCompareOp dyn lt rt
inferBinop dyn "&&" lt rt = boolOp dyn lt rt
inferBinop dyn "||" lt rt = boolOp dyn lt rt
inferBinop dyn "::" lt rt = consOp dyn lt rt
inferBinop dyn ">>" lt rt = composeOp dyn lt rt False
inferBinop dyn "<<" lt rt = composeOp dyn lt rt True
inferBinop dyn op _ _ = panic ("typecheck: unsupported operator " ++ op)

-- Roadmap #18a: `++` (append) carries a `Semigroup` obligation on its (unified)
-- operand type — a verbatim mirror of `eqCompareOp`/`recordIfaceObligation` for `==`,
-- and the reason `"x" ++ Box 1` is now a located `No impl of Semigroup for Box`
-- reject at CHECK time rather than an eval-time `E-PANIC`.  Reuses the same
-- pendingImplObligations / checkImplObligations path: a synthetic Semigroup
-- obligation with a bare iface-param declared type (`TyVar "a"`, typaram ["a"]) so
-- dispatchMonosOf recovers exactly the operand mono.  `Monoid a requires Semigroup
-- a`, so a declared `Monoid a =>` constraint superclass-closes to satisfy it (this
-- is what keeps core.mdk's `foldMap f = fold (acc x => acc ++ f x) empty` typing).
-- A still-polymorphic operand defers to the caller, exactly like Num/Eq/Ord.
--
-- Gated on the PRELUDE's `Semigroup` being present, via `builtinClassPresent` (#1539;
-- it was `ifaceRegistered "Semigroup"` before): the bare-HM no-prelude oracle (tc_probe
-- / typecheck_main.mdk) has no `Semigroup` class, so recording the obligation only when
-- it exists keeps those drivers byte-identical while `medaka check` rejects.
-- The result is a new value of the operands' value type; what it may reach
-- is the abstraction's business (`alphaOf`), never inherited from an operand.
appendOp : DynCtx -> Mono -> Mono -> Mono
appendOp dyn lt rt =
  let plain = peelQual lt
  let _ = unifyIn dyn plain rt
  let _ = recordIfaceObligation dyn.dcModule BSemigroup plain
  plain

-- #146: unified operator-obligation recorder.  The arithmetic (`+ - * / %`, unary
-- `-`), comparison (`== /= < > <= >=`) and append (`++`) operators each carry an
-- interface obligation on their (unified) operand type via pushPendingObl — a
-- synthetic obligation with a bare iface-param declared type (`TyVar "a"`, typaram
-- ["a"]) so dispatchMonosOf recovers exactly the operand mono.  Gated on the PRELUDE's
-- copy of that class being present: the bare-HM no-prelude oracle (tc_probe /
-- typecheck_main.mdk) declares none of Num/Eq/Ord/Semigroup, so recording only when the
-- class exists keeps those drivers byte-identical while full check_main (prelude)
-- rejects, matching `medaka check`.  Callers: numArithOp/negateOp (BNum), eqCompareOp
-- (BEq), ordCompareOp (BOrd), appendOp (BSemigroup).
--
-- #1539 / DICT §8 I7 qualification 4: the gate is `builtinClassPresent c`, NOT
-- `ifaceRegistered (builtinClassName c)`.  The latter asked whether SOME interface
-- spelled `Num` is registered — a table any user declaration writes to — so under §7.1
-- U1 (prelude becomes a node, and a user `interface Num` stops being a within-module
-- duplicate) a user's class would be the thing that TRIGGERS the operator's obligation.
-- That is the capture I7 qualification 4 forbids, reached through the gate rather than
-- through the payload, and it is the same reason the payload half already refuses to
-- read that table (see the `§8 I7` section below, and `ModuleCtx.registeredIfacesRef`'s
-- retirement note — #1569 removed the table itself once `ifaceRegistered` had no
-- callers left).
recordIfaceObligation : ModuleCtx -> BuiltinClass -> Mono -> Unit
recordIfaceObligation mctx c lt
  | builtinClassPresent mctx.mcGraph c =
    pushPendingObl
      mctx
      (builtinIfaceRef mctx.mcGraph c)
      ["a"]
      (TyVar "a")
      lt
      []
      POperator
      mctx.mcLoc
  | otherwise = ()

-- The interface word of the built-in class declaring an operator's method.  An
-- operator denotes the prelude's method whatever a module names in scope, so the
-- method nodes `dictPass` mints for operators and literals take their identity from
-- here rather than from the module's admission.
builtinMethodIfaceWord : GraphCtx -> String -> String
builtinMethodIfaceWord gctx method = match builtinClassOfMethod method
  Some c => ifaceWordOf (builtinClassOrigin gctx c) (builtinClassName c)
  None => ""

builtinClassOfMethod : String -> Option BuiltinClass
builtinClassOfMethod "eq" = Some BEq
builtinClassOfMethod "append" = Some BSemigroup
builtinClassOfMethod m
  | contains m ["compare", "lt", "gt", "lte", "gte"] = Some BOrd
  | contains m ["add", "sub", "mul", "div", "rem", "negate", "fromInt"] =
    Some BNum
  | otherwise = None

-- Seed the table from the declaration list THIS pass treats as the prelude, so that a
-- synthetic occurrence's key and the prelude's own `impl Num Int` key agree.
--
-- 🚨 THE SOURCE LIST IS CHOSEN FOR SYMMETRY WITH `insertUnivImpl`, WHICH IS WHAT
-- CORRECTNESS DEPENDS ON — not for tidiness.  `insertUnivImpl` keys the impl side off
-- `DImpl.implOrigin`, so this side must read the origin of the interface declaration
-- that lives in the SAME universe:
--   * With a real prelude, the prelude pass installs all four identities from `core`.
--   * Once a non-empty prelude has been seeded, a later module contributes nothing: a
--     program interface spelled `Eq` is not the prelude's, whatever the prelude lacks.
--   * In a prelude-free graph, builtin declarations can be split across modules.
--     Each module contributes only identities not already present, so Eq→Num and
--     Num→Eq module orders retain both identities without allowing a later duplicate
--     declaration to replace an earlier one.
seedBuiltinClasses : GraphCtx -> String -> List Decl -> Unit
-- ⚠️ BOTH SPELLINGS of the prelude's module id are tested, for the same reason
-- `declEnvsOrdOf` indexes it twice: the export indexes (`meExports`,
-- `deCtorExports`) key the prelude under `"core"`, but the `mid` `graphPreamble`
-- actually PASSES for the core pass is `""` on both output selections
-- (`GOutDiags`: `checkModuleFull` → `checkModuleFullImpl ""`;
-- `GOutTrees`: `elabModuleStamp ""`).  Testing
-- only `"core"` would silently never fire on either selection — and the miss is silent
-- because an unseeded table yields `OriginUnresolved`, i.e. a `TkBare` goal key against
-- `TkIdent` impls: a false REJECT of the prelude, which is the #1112 prototype's
-- 634-diagnostic signature.
seedBuiltinClasses gctx mid prog =
  if isPreludeMid mid then
    let seeded = builtinClassesOf prog
    gctx.crossRun.builtinClassesRef :=
      BuiltinClasses { seeded | bcPreludeSeeded = isNonEmptyL prog }
  else if gctx.crossRun.builtinClassesRef.value.bcPreludeSeeded then
    ()
  else
    gctx.crossRun.builtinClassesRef :=
      builtinClassesGo prog gctx.crossRun.builtinClassesRef.value

-- G2: arithmetic `+ - * / %` carry a `Num` obligation on their (unified) operand
-- type — a `No impl of Num for <T>` reject.
-- `++` (append) is NOT Num — it carries a `Semigroup` obligation instead (appendOp
-- above).  We reuse the
-- existing pendingImplObligations / checkImplObligations path: a synthetic Num
-- obligation with a bare iface-param declared type (`TyVar "a"`, typaram ["a"]) so
-- dispatchMonosOf recovers exactly the operand mono.  When it grounds to a concrete
-- non-Num head (String/Bool) with no `impl Num`, the post-inference check rejects;
-- while still a polymorphic var (a `Num a =>` site) allConcreteHeads defers it to
-- the caller — exactly the oracle's behaviour.
--
-- Gated on the `Num` interface being REGISTERED (prelude loaded): the bare-HM,
-- no-prelude oracle (tc_probe / typecheck_main.mdk) imposes NO class constraint on
-- `+`, so `1 + 2 : Int` and `"a" - "b" : String` both type there.  Recording the
-- obligation only when Num exists keeps the no-prelude drivers byte-identical to
-- that oracle while the full check_main (prelude) path rejects, matching `medaka
-- check`.
numArithOp : DynCtx -> Mono -> Mono -> Mono
numArithOp dyn lt rt =
  -- Chunk D: taint any literal operand BEFORE the unify grounds it — so a literal
  -- fed to an arithmetic op (`1 + "x"`, `x + 1`, `1 + x`) keeps `No impl of Num for
  -- T` (the `+` is the culprit) rather than being reframed as a bare mismatch.
  let _ = markNumlitOpTaint dyn.dcModule lt
  let _ = markNumlitOpTaint dyn.dcModule rt
  let _ = unifyIn dyn lt rt
  let _ = recordIfaceObligation dyn.dcModule BNum lt
  lt

-- PLAN.md #11 soundness arm: model an integer literal as a `fromInt n` method
-- occurrence so its route cell [dref] gets stamped (RKey ground / RDictFwd poly) by
-- resolveSites — exactly like core.mdk's `fromInt 0` in `sum`.
-- Gated on the prelude (the PRELUDE's `Num`
-- present — `builtinClassPresent BNum` since #1539, was `ifaceRegistered "Num"` — AND
-- `fromInt` bound): with no prelude (bare-HM oracle) fall back to a plain fresh
-- Num-obligated var, leaving [dref] RNone (⇒ a static Int literal at rewrite time).
-- ⚠️ #1539 converted the GATE; #259 converts the ANCHOR, which was the larger half of
-- the same I7 divergence (§11's "I7 (literals)" row).  Both halves now ask the PRELUDE
-- and nothing else: the gate is `builtinClassPresent BNum`, the method is the scheme
-- `seedNumLitFromIntAnchor` selected out of the prelude `Num` DECLARATION by identity.
-- A binding spelled `fromInt` in the user's term scope is no longer consulted, so it can
-- no longer re-anchor the literals around it (#259: `fromInt : Int -> Float` made
-- `println (7 / 2)` print `3.5` under `run` and `3` from the built binary, exit 0).
inferNumLit : TcEnv -> Int -> EvId -> Mono
inferNumLit env n ev =
  let a =
    inferNumLitVar
      env
      n
      (siteFloatCell env.teDyn.dcModule.mcGraph ev)
      (siteRouteCell env.teDyn.dcModule.mcGraph ev)
  let _ = recordNumlitRange env.teDyn.dcModule a n
  a

-- INTEGER-TYPES-DESIGN §3.2 item 4: a literal above 2^62 is inferred exactly as an
-- ordinary one, a `fromInt` occurrence whose type comes from context, and is
-- recorded for `checkWideLiterals` instead of the narrow range check, which accepts
-- it only where that type grounded to `U64`.  The `Int` the shared route carries is
-- a stand-in (the low half) that nothing reads for a wide literal:
-- `rewriteBinopExpr` builds its `LU64` from the node's own halves.
inferWideLit : TcEnv -> Int -> Int -> EvId -> String -> Mono
inferWideLit env hi lo ev lx =
  let a =
    inferNumLitVar
      env
      lo
      (Ref None)
      (siteRouteCell env.teDyn.dcModule.mcGraph ev)
  env.teDyn.dcModule.mcCells.wideLitRanges :=
    (a, lx, hi, lo, False, env.teDyn.dcModule.mcLoc)
      :: env.teDyn.dcModule.mcCells.wideLitRanges.value
  a

inferNumLitVar : TcEnv -> Int -> Ref (Option Float) -> Ref Route -> Mono
inferNumLitVar env n fref dref
  | builtinClassPresent
    env.teDyn.dcModule.mcGraph
    BNum = match env.teDyn.dcModule.mcCells.numLitFromIntAnchorRef.value
    None => inferNumLitBare env.teDyn.dcModule n fref
    Some anchor =>
      -- records the Num impl obligation + a pendingSite on [dref].
      let fromIntTy = inferNumLitMethod env.teDyn.dcModule anchor dref
      let a = freshVar env.teDyn.dcModule ()
      let _ =
        unifyIn
          env.teDyn
          fromIntTy
          (TFun (tconBuiltin "Int") (openRow env.teDyn.dcModule ()) a)
      let _ = pushNumlit env.teDyn.dcModule.mcGraph (a, fref, n, dref)
      let _ = recordNumlitLoc env.teDyn.dcModule a  -- Chunk D: literal provenance for Num mis-framing
      a
  | otherwise = inferNumLitBare env.teDyn.dcModule n fref

-- #259: the literal's own occurrence recorder — `inferMethodAt`'s `Some` arm MINUS every
-- shadow arm, because a numeric literal is not a shadow occurrence and cannot be one:
-- `1 + 1` mentions no identifier, so nothing about it can denote a user standalone.
--
-- Dropped, deliberately, and each is INERT on a program with no `fromInt` shadow (so this
-- is byte-identical to the old route everywhere the defect was absent):
--   • `recordRLocalSite` — gated on `standaloneValuesRef` membership / `standaloneValuePinned`,
--     both empty for an unshadowed `fromInt`.  Under a shadow it stamped the literal's route
--     RLocal at the user's binding.
--   • `maybeStandaloneValueMono` / `maybeStandaloneValueMonoEmit` — the value-position pins,
--     keyed on `definerShadowNamesRef` / the route sym; both `None` unshadowed.  These are
--     what re-typed the literal to the user binding's own scheme on the emit path.
--   • `argDispatchOf` — `fromInt` is return-position (no dispatch argument), so this answered
--     `None` and fell to `recordSite` on every path already.
--
-- A literal always records the prelude `Num` obligation (DICT §8 I7); no binding
-- spelled `fromInt`, local or standalone, suppresses it.  Only a mono-scheme anchor
-- (nothing to instantiate) skips it.
inferNumLitMethod : ModuleCtx -> MethodSchemeRow -> Ref Route -> Mono
inferNumLitMethod mctx anchor tagRef =
  let inst = instantiateTracked mctx anchor.msrScheme
  let occurrence = fst inst
  let predicate = ClassPredicate {
    predicateInterface = anchor.msrIface,
    predicateArguments =
      dispatchMonosOf anchor.msrTyparams anchor.msrType occurrence,
  }
  let origin = mctx.mcLoc
  let scope = captureScope mctx ()
  let _ =
    noteNumericPredicateTrace
      mctx.mcGraph
      NPTProduced
      predicate
      scope
      origin
      None
      None
      []
  let _ =
    recordMethodDictsFromSlots
      mctx
      anchor.msrMethodSlots
      (Ref [])
      (Ref innerNone)
      (snd inst)
  let _ =
    recordNumLitObligationGuarded mctx anchor predicate occurrence origin scope
  recordNumLitSite mctx predicate tagRef occurrence origin scope

-- no-prelude fallback: a fresh var, no route (dref untouched ⇒ stays RNone ⇒ Int).
-- PLAN.md #11 (locked §0.2): a numeric literal is ALWAYS a `fromInt n` occurrence,
-- so it carries a `Num` obligation on its var unconditionally — exactly the OCaml
-- oracle, whose ENumLit infer arm `infer env (EVar "fromInt")` records the Num
-- usage even no-prelude (`initial_env` seeds `fromInt`/`Num`).  Recording it here
-- (vs. the prelude-gated `recordIfaceObligation`) lets value-level defaulting ground
-- an AMBIGUOUS literal var to Int (`nums = [1,2,3] : List Int`) so the no-prelude
-- `typecheck_main` matches the prelude-aware oracle golden.  The matching reject is
-- SUPPRESSED no-prelude in checkOneImplObligation (no-prelude imposes no Num impl
-- constraint — see its `builtinClassPresent BNum` guard), so a literal still types Int
-- without a spurious `No impl of Num for Int`.
inferNumLitBare : ModuleCtx -> Int -> Ref (Option Float) -> Mono
inferNumLitBare mctx n fref =
  let a = freshVar mctx ()
  let predicate = ClassPredicate {
    predicateInterface = builtinIfaceRef mctx.mcGraph BNum,
    predicateArguments = [a],
  }
  let origin = mctx.mcLoc
  let scope = captureScope mctx ()
  let _ =
    noteNumericPredicateTrace
      mctx.mcGraph
      NPTProduced
      predicate
      scope
      origin
      None
      None
      []
  let _ = pushNumLitObl mctx predicate a origin scope
  let _ = pushNumlit mctx.mcGraph (a, fref, n, Ref RNone)
  let _ = recordNumlitLoc mctx a  -- Chunk D: literal provenance for Num mis-framing
  a

-- ── Chunk D: Num mis-framing provenance (error-path only) ──────────────────
-- Record a literal's (var, loc) so a later Num-obligation reframe can tell a bare
-- literal from an arithmetic-operator operand.  [mcLoc] is the ENumLit span.
recordNumlitRange : ModuleCtx -> Mono -> Int -> Unit
recordNumlitRange mctx a n =
  mctx.mcCells.numlitRanges :=
    (a, n, mctx.mcLoc) :: mctx.mcCells.numlitRanges.value

-- INTEGER-TYPES-DESIGN §3.2 item 2: a literal whose type grounded to a fixed-width
-- head must lie in that head's range, or it is `L-INT-OVERFLOW` naming the type and
-- the range.  Runs once per module after inference, on every driver, so `check`,
-- `run` and `build` all refuse `(300 : U8)`.  `-2 : U8` is caught here too, as the
-- negative value `recordNegatedLitRange` records for it.  Each literal reports at its
-- own location (no message dedup: two `300`s are two errors).
checkFixedWidthLiterals : ModuleCtx -> List (Mono, Int, Option Loc) -> Unit
checkFixedWidthLiterals mctx [] = ()
checkFixedWidthLiterals mctx ((m, n, loc) :: rest) =
  let _ = match normalize m
    TCon tag _ => match taggedFixedRange tag
      Some (lo, hi) =>
        if n < lo || n > hi then
          recordTypeError
            mctx
            (TcDiag
              "L-INT-OVERFLOW"
              1
              (orElseLoc loc mctx.mcLoc)
              "integer literal \{n} does not fit \{tag} (\{lo}..\{hi})"
              None
              None)
      None =>
        if isU64Head tag && n < 0 then
          recordTypeError
            mctx
            (TcDiag
              "L-INT-OVERFLOW"
              1
              (orElseLoc loc mctx.mcLoc)
              "integer literal \{n} does not fit U64 (\{u64RangeText})"
              None
              None)
    _ => ()
  checkFixedWidthLiterals mctx rest

-- A wide literal's magnitude (its halves) fits `I64`: below 2^63, or exactly 2^63
-- when it is negated.
wideFitsI64 : Int -> Int -> Bool -> Bool
wideFitsI64 hi lo negated =
  hi < 2147483648 || negated && hi == 2147483648 && lo == 0

-- A wide literal is a `U64` literal or an error: at any other ground type, and at a
-- type still polymorphic when the module ends (whose `fromInt` would receive a value
-- no `Int` can carry), it is `L-INT-OVERFLOW`, exactly as the lexer's cap refused it
-- before wide literals existed.  At `I64` it fits up to `2^63 - 1`, and negated
-- (`-9223372036854775808`, which the parser reads as `-` applied to the wide
-- literal) down to `-2^63`: the literal is `I64`'s bit pattern of the magnitude,
-- and the `-` is `I64`'s wrapping negation, so `-2^63` is `minBound`.  Negated,
-- it fits no other type.
checkWideLiterals : ModuleCtx ->
  List (Mono, String, Int, Int, Bool, Option Loc) ->
  Unit
checkWideLiterals mctx [] = ()
checkWideLiterals mctx ((m, lx, hi, lo, negated, loc) :: rest) =
  let at = orElseLoc loc mctx.mcLoc
  let shown = if negated then "-" ++ lx else lx
  let pow62 = hi == 1073741824 && lo == 0
  let _ = match normalize m
    -- A positive 2^62 is the one wide literal the lexer admits as an `Int` (for
    -- `-4611686018427387904`'s sake); at `Int` it gets the diagnostic that says so.
    TCon "Int" _ if pow62 && not negated =>
      recordTypeError
        mctx
        (TcDiag
          "L-INT-OVERFLOW"
          1
          at
          intMinLiteralMsg
          (Some intMinLiteralHelp)
          None)
    TCon tag _ if isU64Head tag =>
      if negated then
        recordTypeError
          mctx
          (TcDiag
            "L-INT-OVERFLOW"
            1
            at
            "integer literal \{shown} does not fit U64 (\{u64RangeText})"
            None
            None)
    TCon tag _ if isI64Head tag =>
      if not (wideFitsI64 hi lo negated) then
        recordTypeError
          mctx
          (TcDiag
            "L-INT-OVERFLOW"
            1
            at
            "integer literal \{shown} does not fit I64 (\{i64RangeText})"
            None
            None)
    TCon tag _ =>
      recordTypeError
        mctx
        (TcDiag
          "L-INT-OVERFLOW"
          1
          at
          "integer literal \{shown} does not fit \{tag}"
          (Some "only a `U64` or an `I64` holds a literal above 2^62")
          None)
    _ =>
      recordTypeError
        mctx
        (TcDiag
          "L-INT-OVERFLOW"
          1
          at
          "integer literal \{shown} fits only `U64` or `I64`, and its type here is undetermined"
          (Some (wideAnnotateHelp shown negated))
          None)
  checkWideLiterals mctx rest

recordNumlitLoc : ModuleCtx -> Mono -> Unit
recordNumlitLoc mctx a = match mctx.mcLoc
  Some l =>
    mctx.mcCells.numlitVarLocs := (a, l) :: mctx.mcCells.numlitVarLocs.value
    mctx.mcCells.numlitUntainted := (a, l) :: mctx.mcCells.numlitUntainted.value
  None => ()

-- Called from recordIfaceObligation (arithmetic `+`/`-`/`*`/`/`/`%`): any recorded
-- literal whose var shares a union-find root with [m] was an operand of an op, so
-- mark its loc — the reframe then keeps `No impl of Num for T` for it.  Runs during
-- inference (vars still unbound), so `normalize` reveals the shared root regardless
-- of which operand became the root at unify time.
markNumlitOpTaint : ModuleCtx -> Mono -> Unit
markNumlitOpTaint mctx m =
  let id = rootIdOf m
  if id < 0 || not (anyRootMatch id mctx.mcCells.numlitUntainted.value) then
    ()
  else
    mctx.mcCells.numlitUntainted :=
      taintAndDrop mctx id mctx.mcCells.numlitUntainted.value

-- True iff SOME worklist literal shares the union-find root [id].  Short-circuits via
-- `||` and allocates nothing, so the common case (this operand taints no literal)
-- leaves the worklist alone — rebuilding it unconditionally would put back an O(N)
-- allocation per operand, which is the very thing `rootIdOf` removed.
anyRootMatch : Int -> List (Mono, Loc) -> Bool
anyRootMatch _ [] = False
anyRootMatch id ((v, _) :: rest) = sameRootId id v || anyRootMatch id rest

-- Taint every worklist literal sharing the root [id] (record its loc as
-- operator-tainted) and DROP it from the worklist; keep the others.
taintAndDrop : ModuleCtx -> Int -> List (Mono, Loc) -> List (Mono, Loc)
taintAndDrop mctx _ [] = []
taintAndDrop mctx id ((v, l) :: rest)
  | sameRootId id v =
    mctx.mcCells.numlitOpLocs := l :: mctx.mcCells.numlitOpLocs.value
    taintAndDrop mctx id rest
  | otherwise = (v, l) :: taintAndDrop mctx id rest

-- Stage-1 Eq dispatch (EQ-DISPATCH-DESIGN.md §2.1): `==`/`/=` carry an `Eq`
-- obligation on their (unified) operand type — a verbatim mirror of
-- `recordIfaceObligation` for `+`.  We reuse the existing pendingImplObligations /
-- checkImplObligations path: a synthetic Eq obligation with a bare iface-param
-- declared type (`TyVar "a"`, typaram ["a"]) so dispatchMonosOf recovers exactly
-- the operand mono.  When it grounds to a concrete non-Eq head (a function, an
-- un-derived ADT) with no `impl Eq`, the post-inference check rejects; while still
-- a polymorphic var (an `Eq a =>` site) allConcreteHeads defers it to the caller
-- — exactly the Num behaviour.  `<`/`>`/`<=`/`>=` carry the sibling `Ord`
-- obligation via `ordCompareOp` below.  `/=` shares this seam and lowers to
-- `not (eq …)` at the dict layer (binopMethodApp), so it does not double-report.
--
-- Gated on the PRELUDE's `Eq` being present (`builtinClassPresent BEq`, #1539): the
-- bare-HM no-prelude oracle (tc_probe / typecheck_main)
-- has no `Eq` class, so recording the obligation only when Eq exists keeps those
-- drivers byte-identical while full check_main (prelude) rejects.
eqCompareOp : DynCtx -> Mono -> Mono -> Mono
eqCompareOp dyn lt rt =
  let _ = unifyIn dyn lt rt
  let _ = recordIfaceObligation dyn.dcModule BEq lt
  tconBuiltin "Bool"

-- Stage-1 Ord dispatch (EQ-DISPATCH-DESIGN.md §"sibling Ord follow-up"): the four
-- ordering comparisons `<`/`>`/`<=`/`>=` carry an `Ord` obligation on their
-- (unified) operand type — a verbatim mirror of `eqCompareOp` for `==`.  Reuses the
-- same pendingImplObligations / checkImplObligations path.  `Ord` supersets `Eq`
-- (`interface Ord a requires Eq a`), so a declared `Ord a =>` constraint already
-- superclass-closes to satisfy BOTH the `<`→Ord and a sibling `==`→Eq obligation;
-- an `Eq a =>` declaration does NOT close upward, so a bare `<` under `Eq a =>` is
-- correctly rejected as needing `Ord a`.  When the operand grounds to a concrete
-- non-Ord head (a function, an un-derived ADT) with no `impl Ord`, the
-- post-inference check rejects; while still a polymorphic var it defers to the
-- caller — exactly the Eq/Num behaviour.  NO change to eval/emit: `<` still lowers
-- to `EMethodAt "lt"` at the dict layer, so runtime/emit dispatch is unchanged.
--
-- Gated on the PRELUDE's `Ord` being present (`builtinClassPresent BOrd`, #1539).
ordCompareOp : DynCtx -> Mono -> Mono -> Mono
ordCompareOp dyn lt rt =
  let _ = unifyIn dyn lt rt
  let _ = recordIfaceObligation dyn.dcModule BOrd lt
  tconBuiltin "Bool"

boolOp : DynCtx -> Mono -> Mono -> Mono
boolOp dyn lt rt =
  let _ = unifyIn dyn lt (tconBuiltin "Bool")
  let _ = unifyIn dyn rt (tconBuiltin "Bool")
  tconBuiltin "Bool"

consOp : DynCtx -> Mono -> Mono -> Mono
consOp dyn lt rt =
  let tailElem = freshVar dyn.dcModule ()
  let _ = noteNumlitCtx dyn.dcModule lt rt JoinCons  -- Chunk D: tag cons head-vs-list Num mismatch
  let _ = unifyIn dyn rt (TApp (tconBuiltin "List") tailElem)
  TApp
    (tconBuiltin "List")
    (joinValueTypes dyn JoinCons [
      (dyn.dcModule.mcLoc, lt),
      (dyn.dcModule.mcLoc, tailElem),
    ])

-- `x |> f` is `f x` spelled backwards, and the argument's syntax reaches the
-- abstraction the same way.
pipeOp : TcEnv -> Expr -> Expr -> Mono -> Mono -> Mono
pipeOp env l r lt rt =
  let res = freshVar env.teDyn.dcModule ()
  let eff = applicationRow env (EApp r l) rt lt res
  let _ =
    performEffect env.teDyn.dcModule env.teDyn.dcModule.mcCells.curEffect eff
  let _ = notePerformSite env eff
  res

-- g >> h : (a->b) -> (b->c) -> (a->c)  [flipped=False]
-- g << h : (a->b) -> (c->a) -> (c->b)  [flipped=True]
-- The composite takes g's own domain, qualifier included: nothing is applied
-- to g here, so there is no argument to abstract.  g's result then flows into
-- h as an ordinary argument.
composeOp : DynCtx -> Mono -> Mono -> Bool -> Mono
composeOp dyn gt ht False =
  let (a, first, b) = calleeArrow dyn gt
  let c = freshVar dyn.dcModule ()
  let second = applicationRowTyped dyn ht b c
  TFun a (joinRows (joinCellOf dyn.dcModule.mcGraph) first second) c
composeOp dyn gt ht True = composeOp dyn ht gt False

inferUnop : DynCtx -> String -> Mono -> Mono
inferUnop dyn "-" t = negateOp dyn.dcModule t
inferUnop dyn "!" t = derefOp dyn t
inferUnop dyn op _ = panic ("typecheck: unsupported unary op " ++ op)

-- #1739 half A: `!x` is Ref-DEREFERENCE, not boolean negation — `not` is the sole
-- boolean negation (it is already a prelude fn).  The unify is the same one
-- `inferValueField` does for `x.value`, and deliberately so: the two spellings must
-- infer identically, since desugar-free lowering sends both to `CFieldAccess _
-- "value"`.  Unification rather than a structural match, so it also works when the
-- receiver is still an unsolved tyvar (a param not yet pinned to its signature).
--
-- The `Bool` arm is the REQUIRED diagnostic (user, 2026-07-10).  `!aBool` is the OLD
-- boolean-not use, and left to unification it fails as a bare `Ref a vs Bool`
-- mismatch that says nothing about what changed — so the Bool shape is INTERCEPTED
-- here, before unify, and answered with a message naming `not`.
--
-- ⚠️ The "use `not x`" advice is IN THE MESSAGE, not only in `help`.  ERROR-QUALITY
-- §4.5 puts actionable advice on a `help:` line, but `help` is a JSON-ONLY channel
-- here — the CLI renderer never prints it — so advice that lives only there is
-- invisible to the human this diagnostic exists for.  The did-you-mean precedent
-- does the same ("Unbound variable: greetng. Did you mean 'greeting'"), and this is
-- the wording the user specified for this bite (2026-07-10).  `help` still carries
-- the longer WHY for the structured consumers.
--
-- It returns `Bool` on that path rather than a fresh var: the operand was a Bool and
-- the author meant negation, so `Bool` is the type the surrounding expression was
-- written to expect (`if !flag then …`), and handing it back keeps ONE located error
-- instead of a cascade of downstream mismatches — the Chunk-D recovery shape the
-- literal-provenance arms already use.
derefOp : DynCtx -> Mono -> Mono
derefOp dyn t =
  if monoIsBool (normalize t) then
    let _ =
      pushTypeErrorHelpFixAt
        dyn.dcModule
        "T-BANG-ON-BOOL"
        None
        bangOnBoolMsg
        bangOnBoolHelp
        None
    tconBuiltin "Bool"
  else
    refStored dyn t

-- Roadmap #18c: unary minus `-x` carries a `Num` obligation on its operand type —
-- a verbatim mirror of `numArithOp`/`recordIfaceObligation` for binary `+`/`-`/…,
-- and the reason `-"x"` is now a located `No impl of Num for String` reject at
-- CHECK time rather than an eval-time `panic "unary minus on non-number"`.
-- markNumlitOpTaint keeps the same Chunk-D literal-provenance error framing as
-- the binary arithmetic operators (`-"x"` blames the operator, not a bare
-- literal-vs-String mismatch).
negateOp : ModuleCtx -> Mono -> Mono
negateOp mctx t =
  let _ = markNumlitOpTaint mctx t
  let _ = recordIfaceObligation mctx BNum t
  t

-- backtick infix `x `f` y` is just f applied to x then y
inferInfix : TcEnv -> String -> Expr -> Expr -> Mono
inferInfix env op l r =
  let ft = inferVar env op
  let lt = infer env l
  let rt = infer env r
  -- reconstruct the equivalent app spine so a hole-bearing extern fills from
  -- its FIRST arg (l) — mirror of the EApp path (v2 Stage 2b).
  let inner = EApp (EVar op) l
  inferApp env (EApp inner r) (inferApp env inner ft lt) rt

inferVar : TcEnv -> String -> Mono
inferVar env x = inferVarId env x 0

-- #837: the id-carrying entry point.  id 0 (every non-EVarId caller, e.g.
-- inferInfix) is the bare-name fallback — byte-identical to the pre-#837 path.
inferVarId : TcEnv -> String -> Int -> Mono
inferVarId env x id = match maybeStandaloneValueMono env x
  -- P0-19 d4b (S4): bare value-position definer shadow → the standalone scheme.
  Some m => m
  None => inferVarPlainId env x id

inferVarPlainId : TcEnv -> String -> Int -> Mono
inferVarPlainId env x id = match lookupVar env x
  Some s => match lookupMethodRow env x
    Some _ =>
      let inst = instantiateVarTrackedWithSubst env x id s
      recordMethodObligationOwned env x s inst.mtiBody inst.mtiSubstitution None
    None =>
      let mono = instantiateVarTrackedId env x id s
      recordMethodObligationGuarded
        env
        x
        s
        mono
        (methodOmittedVars env.teDyn.dcModule x)
  None => unboundVarFresh env.teDyn.dcModule x

-- #11 soundness (native obligation hole, plain check path): a constrained binding used
-- as a plain EVar (`g = f "hello"`) instantiates its DEFERRED obligations at the call.
-- schemeObligationsRef (always-on, unlike funConstraintsRef) records each binding's
-- (iface, quantified-var-id); here we instantiate TRACKED so each obligation var maps
-- to this call's fresh mono, recorded as a call obligation checked after inference.
-- A binding with no recorded obligations takes the plain instantiate path (identical
-- mono).  Re-checks inferred constraints at every use.
-- #837: [id] is the occurrence's binding id (from EVarId).  When id /= 0 the
-- lookup keys EXACTLY (x, id) — so a top-level `g`'s use can never pick up a
-- where-helper `g`'s obligations.  id == 0 (local/where/cross-module/global, or
-- any non-EVarId caller) falls to the bare-name scan — byte-identical to today.
instantiateVarTrackedId : TcEnv -> String -> Int -> Scheme -> Mono
instantiateVarTrackedId env x id s =
  let inst = instantiateVarTrackedWithSubst env x id s
  inst.mtiBody

instantiateVarTrackedWithSubst : TcEnv ->
  String ->
  Int ->
  Scheme ->
  MethodTrackedInstantiation
instantiateVarTrackedWithSubst env x id s = match bindingDeclared env x
  Some _ =>
    let inst = instantiateValueTracked env.teDyn.dcModule x s
    let _ = match bindingDeclaredAt env x inst
      Some dc =>
        recordDeclaredBindingCall
          env.teDyn.dcModule
          dc
          inst.mtiSubstitution.misTypeSubst
      None => ()
    inst
  None => instantiateLegacyVarTracked env.teDyn.dcModule x id s

-- Error-path B4: if [x] is a registered interface method, record this occurrence's
-- (post-instantiation) mono so checkImplObligations can verify a matching impl
-- exists once the dispatch type is resolved.  Returns the mono unchanged.  A
-- non-method name records nothing (the common case).  The marked path records the
-- same via inferMethodAt; the bare typecheck_main path records here.
recordImplObligation : ModuleCtx ->
  String ->
  Mono ->
  List (String, Mono) ->
  Mono
recordImplObligation mctx x mono omitted
  -- A standalone shadow (a top-level funDef that reuses an interface-method name)
  -- resolves in-scope to that standalone, not the method — the scope-blind marker
  -- still rewrites its occurrences to EMethodAt, but a NO-IMPL receiver legitimately
  -- falls back to the standalone (resolveRLocalSite stamps RLocal), so there is no
  -- impl obligation.  Recording one surfaces a spurious `No impl of <Iface> for <T>`
  -- under checkImplObligations (the build path skips that check, so it only bites
  -- `check`).  Skip for EVERY standalone shadow — definer (`definerShadowNamesRef`)
  -- AND importer (an imported standalone; `standaloneValuesRef` holds both).  P0-18:
  -- this closes the `check`-side of the importer-shadow-on-a-no-impl-receiver residual
  -- (`size 3` where `size` is imported) which was REJECTED while `run` correctly
  -- returned the standalone.  Sound: the name genuinely has a standalone fallback, so
  -- a no-impl receiver is not an error — the route decides impl-vs-standalone per
  -- receiver; a receiver WITH an impl still dispatches (and that impl exists).
  -- Check BOTH refs: the single-file check path (checkProgram) sets only
  -- `definerShadowNamesRef`, while the multi-module path sets `standaloneValuesRef`
  -- (importer ∪ definer) — so either alone would miss one path's shadows.
  | omHasKey x mctx.mcCells.definerShadowNamesRef.value
    || omHasKey x mctx.mcCells.standaloneValuesRef.value = mono
  -- A bare spelling with TWO OR MORE admitted declarations in this module's scope
  -- (S2-DECL (d), `methodAdmittedHere`) names no single interface, and
  -- `methodEntryHere` answers no declaration for it: an obligation against any one
  -- of them would be a choice the scope did not make — and the impl channel checks
  -- it on every driver (#2705).  MEASURED:
  -- `A.ff (A.mkA 0)` beside `import x1277_b as B`, both interfaces declaring `ff`,
  -- rejected `No impl of Fb for H` on `run`/`build` once the alias renamer fanned
  -- both aliases into bare `ff`.  The obligation is recorded against the whole
  -- admitted SET instead (`pushAdmittedOccObl`) and decided by (d) at module end.
  -- Dispatch is unaffected (the route is decided by receiver identity, not by
  -- this row); the occurrence carrying the identity it resolved to is #1898's.
  | listLen (methodAdmittedHere mctx x) >= 2 =
    let _ = pushAdmittedOccObl mctx x mono
    mono
  | otherwise = match methodEntryHere mctx x
    None => mono
    Some (iface, typarams, mty, _) =>
      -- U1c (#1507): pass `iface`, NOT `ifaceRefBare iface.irName`.  ⚠️ THE LIVE RULE,
      -- not merely a citation: the class a method-occurrence goal names is the interface
      -- that DECLARES the method the occurrence resolved to, carrying that `interface`
      -- declaration's I4 identity `(originModule, name)` (`docs/spec/DICT-SEMANTICS.md`
      -- §8 I4 — identity is assigned once where it is declared, and every occurrence is
      -- resolved to one such identity before entailment runs).  There is no competing
      -- "occurrence layer": `DImpl.implOrigin` and `DInterface.ifaceOrigin` are the SAME
      -- layer — one ASSIGNED at the `interface` decl, one RESOLVED-TO at each occurrence
      -- — so comparing them is not a category error.  Discarding the identity here
      -- silently accepts #1438's cross-module collision shape; carrying it REJECTS that
      -- shape, discriminating METHOD-OCCURRENCE goals the same way the other three
      -- goal-producer call sites always did.
      --
      -- ⚠️ #1288 IS A SEPARATE FACT, AND POINTS THE OTHER WAY — do not weld the two.
      -- It is what carrying identity COSTS: when a re-export merge (`mid.mdk` doing
      -- `export import p.*` + `export import g.*` over two unrelated `Same` interfaces)
      -- gives an importer's `impl Same P` an `implOrigin` of `g` while the method it
      -- defines belongs to `p.Same`, the identity-carrying goal `TkIdent p Same` misses
      -- the impl's `TkIdent g Same` bucket.  That is a FALSE REJECT at exit 1 —
      -- `No impl of Same for P` on a program whose `impl Same P` is three lines up, with
      -- no syntax available to say which `Same` was meant.  #1438: identity turns a
      -- silent accept into a reject (good).  #1288: identity turns a valid program into
      -- a rejection (bad, and open).  Both are live; both belong here.
      --
      -- 🚨 A DO-NOT-RESTORE ban stood at this exact site from #1480 until U1c retired it.
      -- Do NOT reinstate it on a bare assertion that the two layers are "different" — and
      -- do NOT cite "resolve already rejects the ambiguous case" as cover either: MEASURED,
      -- resolve catches a DIRECT double import of a colliding method name but does NOT
      -- diagnose a RE-EXPORT MERGE of the same collision, which reaches this line as
      -- `methodScopeAt` as two admitted declarations (the guard above), with no
      -- diagnostic either way.
      --
      -- ⚠️ THIS IS NOT THE ONLY DECL-LAYER GOAL SITE.  Four more
      -- (`recordIfaceObligation`, `inferNumLitBare`, `numCallObls`, `numDictObls`) build
      -- their goal from `builtinIfaceRef`; the STANDING CONDITION that keeps them safe
      -- lives at that function's own definition, where it is about them.  And "the third
      -- and last of the `ifaceRefBare` producers" (U1b retired the other two,
      -- `schemeObligationsRef` and `funConstraintIfacesRef`) is a claim about
      -- `ifaceRefBare` MINTS ONLY — the `ImplUniverse` channel has at least six goal
      -- producers in total.  Re-derive with `grep -n ifaceRefBare` rather than trust a
      -- count, and do not read the narrow claim as the broad one.
      --
      -- The retired ban's premise and why it was wrong, the re-export-merge measurement,
      -- the `builtinIfaceRef` census, and #1288's verbatim repro:
      -- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` §10.7.  Positive pair:
      -- `test/dict_fixtures/i4-xmod-method-occurrence-{foreign-iface-rejected,
      -- own-iface-control}`.
      let _ =
        pushPendingObl
          mctx
          iface
          typarams
          mty
          mono
          omitted
          PMethodOcc
          mctx.mcLoc
      -- #818 (#838 I3): also record each method-level `=>` constraint slot (e.g.
      -- `Ord b` on `peer : Ord b => a -> b -> b -> Bool`) as its OWN obligation, so an
      -- unsatisfiable slot (`Ord NoOrd`) is rejected by the unified checker at check
      -- time instead of silently becoming an RNone route (a wrong answer / segfault
      -- at run/build).  Recorded here so BOTH the check path (inferVarPlainId) and the
      -- emit path (inferMethodAt) — the two recordImplObligation callers — cover it.
      let _ = recordMethodLevelObls mctx typarams mty mono
      mono

-- #816/#818 (#840 step 1): the shared shadow guard around method-occurrence
-- obligation recording.  A LAMBDA/PATTERN-BOUND local shadowing a method name
-- resolves to a MONOMORPHIC local scheme (`Forall [] []`); the scope-blind marker
-- still rewrote the occurrence to EMethodAt (emit path) — or it reaches
-- inferVarPlainId as a bare EVar (check path) — but it denotes the local, and
-- recording a method obligation for it invents a predicate on whatever the local's
-- var unifies with (a prelude default `filter p t = …` under a user `interface P`
-- whose method is named `p` recorded a phantom `P elem` obligation — which the #816
-- W3 survivor check then rejected as an undeclared constraint on the method's
-- element var).  Every genuine interface method quantifies at least its interface
-- parameter, so a mono scheme is never a real method occurrence.  (Top-LEVEL shadows
-- are already suppressed INSIDE recordImplObligation via
-- definerShadowNamesRef/standaloneValuesRef; this is the local-binding sibling.)
-- BOTH occurrence recorders — inferMethodAt (emit) and inferVarPlainId (check), the
-- only two recordImplObligation callers — share this guard so the #816 predicate
-- lands ONCE.  Takes the caller's ALREADY-INSTANTIATED [mono]; it must NOT
-- re-instantiate, because each caller's own instantiation carries tracked
-- side-effects (recordMethodDicts, recordSchemeCallObligations) that must fire
-- exactly once, at the call site.  [s] is that caller's own lookupVar scheme, tested
-- for monomorphism.  Returns [mono] unchanged in every case (recordImplObligation
-- always returns its argument), so the check path's return value is byte-identical.
-- #2705 / S2-DECL (d) for OBLIGATIONS.  An occurrence whose bare spelling has two or
-- more admitted declarations records no single-interface obligation
-- (`recordImplObligation`); it is decided at the graph-end drain, after every module
-- has grounded what it can and live `Num` roots are defaulted (DICT-SEMANTICS §6.2
-- T5), by `admittedSelection`, the function its route commits through in the same
-- drain (`resolveAdmittedSite`).  Exactly one declaration selecting an instance is
-- the accept; none is the no-impl reject; two or more, or a declaration whose
-- receiver cannot be asked, is the located ambiguity reject, so no accepted
-- occurrence is left without a committed route.
pushAdmittedOccObl : ModuleCtx -> String -> Mono -> Unit
pushAdmittedOccObl mctx name mono =
  mctx.mcCells.admittedOccObls :=
    (name, mono, mctx.mcLoc) :: mctx.mcCells.admittedOccObls.value

checkAdmittedOccObls : ModuleCtx -> Unit -> Unit
checkAdmittedOccObls mctx _ =
  let env = mctx.mcCells.bodyImplEnvRef.value
  let _ =
    map
      (o => checkAdmittedOccObl mctx env o)
      (reverseL mctx.mcCells.admittedOccObls.value)
  ()

checkAdmittedOccObl : ModuleCtx -> ImplEnv -> (String, Mono, Option Loc) -> Unit
checkAdmittedOccObl mctx env (name, mono, loc) =
  let ifs = methodAdmittedHere mctx name
  match admittedSelection (siteFor mctx) env name mono
    Selects _ _ _ => ()
    Undecided => pushAmbiguousMethod mctx name ifs loc
    Unroutable sel => pushUnroutableAdmitted mctx name ifs sel loc
    SelectsNothing =>
      let recv = match admittedReceiverMono mctx name ifs mono
        Some at => ppMono at
        None => "this receiver"
      pushTypeErrorAt
        mctx
        "T-NO-IMPL"
        loc
        "no impl of \{joinWith " or " (map (ir => ir.irName) ifs)} for \{recv}; write an impl of one of them for it"

-- The receiver named in the no-impl reject: the first admitted declaration's own
-- receiver argument.
admittedReceiverMono : ModuleCtx ->
  String ->
  List IfaceRef ->
  Mono ->
  Option Mono
admittedReceiverMono mctx _ [] _ = None
admittedReceiverMono mctx name (ir :: _) mono = do
  k <- lookupIdxById ir name mctx.mcCells.methodDispatchIdxByIdRef.value
  nthArgMono k mono

-- An occurrence whose obligation is its admitted set's rather than one
-- declaration's: a spelling with two or more admitted declarations, written where
-- neither a local (`recordMethodObligationGuarded`) nor a standalone shadow
-- (`recordImplObligation`) binds it.
admittedSetOccurrence : TcEnv -> String -> Scheme -> Bool
admittedSetOccurrence env name s =
  not
      (lookupLocalFlag env name
        || isMonoScheme s
        || omHasKey name env.teDyn.dcModule.mcCells.definerShadowNamesRef.value
        || omHasKey name env.teDyn.dcModule.mcCells.standaloneValuesRef.value)
    && listLen (methodAdmittedHere env.teDyn.dcModule name) >= 2

recordMethodObligationGuarded : TcEnv ->
  String ->
  Scheme ->
  Mono ->
  List (String, Mono) ->
  Mono
recordMethodObligationGuarded env name s mono omitted =
  if lookupLocalFlag env name || isMonoScheme s then
    mono
  else
    recordImplObligation env.teDyn.dcModule name mono omitted

exactReturnRow : TcEnv -> String -> Scheme -> Option MethodSchemeRow
exactReturnRow env name scheme = match lookupMethodRow env name
  None => None
  Some row =>
    if lookupLocalFlag env name
      || isMonoScheme scheme
      || omHasKey name env.teDyn.dcModule.mcCells.definerShadowNamesRef.value
      || omHasKey name env.teDyn.dcModule.mcCells.standaloneValuesRef.value
      || isSome
        (Scopes.enclosingDefaultBody
          (currentScopeStore env.teDyn.dcModule.mcGraph ())
          (captureScope env.teDyn.dcModule ()))
      || listLen (methodAdmittedHere env.teDyn.dcModule name) >= 2 then
      None
    else
      Some row

recordMethodObligationOwned : TcEnv ->
  String ->
  Scheme ->
  Mono ->
  MethodInstantiationSubst ->
  Option EvId ->
  Mono
recordMethodObligationOwned env name scheme occurrence subst goalEv =
  match exactReturnRow env name scheme
    Some row =>
      let request =
        methodReturnRequest env.teDyn.dcModule row occurrence subst goalEv
      let _ =
        recordMethodLevelSlotsOwned
          env.teDyn.dcModule
          row
          subst.misTypeSubst
          request.mrrLoc
          request.mrrScope
      recordExactMethodObligation env.teDyn.dcModule request
    None => recordMethodObligationGuarded env name scheme occurrence []

recordExactMethodObligation : ModuleCtx -> MethodReturnRequest -> Mono
recordExactMethodObligation mctx request =
  let _ = noteMethodReturnTrace mctx MRTProduced request None []
  let _ = pushExactReturnObl mctx request
  request.mrrOccurrence

recordMethodLevelSlotsOwned : ModuleCtx ->
  MethodSchemeRow ->
  List (Int, Mono) ->
  Option Loc ->
  ScopeId ->
  Unit
recordMethodLevelSlotsOwned mctx row subst loc scope =
  recordInstantiatedMethodLevelSlots
    mctx
    (instantiateMethodPredicateSlots mctx.mcGraph row.msrMethodSlots subst)
    loc
    scope

recordInstantiatedMethodLevelSlots : ModuleCtx ->
  List PredicateSlot ->
  Option Loc ->
  ScopeId ->
  Unit
recordInstantiatedMethodLevelSlots mctx [] _ _ = ()
recordInstantiatedMethodLevelSlots mctx (slot :: rest) loc scope =
  let _ = match slot.psArgs
    PSArgsUnknown => ()
    PSArgsKnown args =>
      recordOblAt
        mctx
        Predicate { iface = slot.psIface, args = args }
        0
        PMethodLevel
        loc
        scope
  recordInstantiatedMethodLevelSlots mctx rest loc scope

-- A numeric literal's checking obligation and method-level slots come from its
-- identity-selected method row; no bare-name table reconstructs the class and no
-- binding's spelling suppresses it.
recordNumLitObligationGuarded : ModuleCtx ->
  MethodSchemeRow ->
  ClassPredicate ->
  Mono ->
  Option Loc ->
  ScopeId ->
  Mono
recordNumLitObligationGuarded mctx anchor predicate occurrence origin scope =
  if isMonoScheme anchor.msrScheme then
    occurrence
  else
    recordNumLitImplObligation mctx anchor predicate occurrence origin scope

recordNumLitImplObligation : ModuleCtx ->
  MethodSchemeRow ->
  ClassPredicate ->
  Mono ->
  Option Loc ->
  ScopeId ->
  Mono
recordNumLitImplObligation mctx anchor predicate occurrence origin scope =
  let _ = pushNumLitObl mctx predicate occurrence origin scope
  let _ =
    recordMethodLevelObls mctx anchor.msrTyparams anchor.msrType occurrence
  occurrence

-- #818 (#838 I3): record one PMethodLevel obligation per method-level `=>` constraint
-- slot of a method occurrence.  [mty] is the method's DECLARED type (with its `=>`);
-- [occMono] is THIS occurrence's instantiated (constraint-free) type.  Align the
-- declared function spine (constraints/effects stripped) against [occMono] with
-- matchTyMono to recover each constraint var's concrete mono, then record the
-- constraint's whole argument vector under that substitution (`Show2 (f Int)` at
-- `f := Box` poses `Show2 (Box Int)`, not `Show2 Box`).  matchTyMono captures the
-- live tyvar cell, so a slot still a fresh var at record time normalizes to its
-- solved head at check time — a ground head (`NoOrd`) with no impl is rejected
-- `T-NO-IMPL`; a still-generalized var defers into the scheme
-- (`undeterminedGoalExempt`), uniform with every other obligation.  No slots ⇒ nothing
-- recorded (the receiver-only-method common case), and a shape mismatch (matchTyMono
-- None) records nothing — never a false reject.
recordMethodLevelObls : ModuleCtx -> List String -> Ty -> Mono -> Unit
recordMethodLevelObls mctx typarams mty occMono =
  let slots = methodLevelConstraintSlots typarams mty
  if isEmptyL slots then
    ()
  else match matchTyMono (stripLeadingMethodConstraints mty) occMono
    None => ()
    Some subst => recordMethodLevelSlotObls mctx slots subst

recordMethodLevelSlotObls : ModuleCtx ->
  List Constraint ->
  List (String, Mono) ->
  Unit
recordMethodLevelSlotObls mctx [] _ = ()
recordMethodLevelSlotObls mctx (c :: rest) subst =
  let _ =
    if allList (v => isSome (lookupAssoc v subst)) (constraintVarNames c) then
      recordObl
        mctx
        Predicate {
          iface = IfaceRef {
            irName = constraintIface c,
            irOrigin = c.constraintOrigin,
          },
          args = map (fromAstType mctx subst) c.constraintArgs,
        }
        0
        PMethodLevel
        mctx.mcLoc
  recordMethodLevelSlotObls mctx rest subst

-- Expected-type propagation for an application whose argument is a lambda.
-- Inferring `andThen e (stream => Ok [JArray stream])` naively infers the lambda
-- BODY first with `stream : freshVar`, so a downstream conflicting use inside the
-- body (`JArray stream` wants `Array Json`) pins `stream` to the WRONG type before
-- the function's declared param type (`List Json`) is ever reconciled — the later
-- reconciliation then fails at the application with no good site, and the hover
-- side-channel records the wrong `stream` type.  Fix (bidirectional "checking"
-- mode, the do-bind/higher-order case): infer `f` first, peel its parameter type,
-- and unify it onto the lambda's parameter BEFORE inferring the body.  Then the
-- body sees `stream : List Json` and the type error localizes to the `JArray`
-- USE, and recordLocalBind captures the right hover type.  Purely additive: the
-- final `unify ft (TFun xt …)` in inferApp imposes the same equality regardless,
-- so the solution is unchanged — we only make it available earlier.
exprLoc : Expr -> Option Loc
exprLoc (ELoc l _) = Some l
exprLoc (EDoOrigin l _) = Some l
exprLoc _ = None

-- The span of an application's outermost argument (Bite 3): peel any ELoc
-- wrapper on the `EApp` head, then read the argument Expr's span (an unwrapped
-- argument included).  Non-EApp shapes (never passed as `appExpr`) return None.
appArgLoc : Expr -> Option Loc
appArgLoc (ELoc _ e) = appArgLoc e
appArgLoc (EApp _ x) = exprSpanLoc x
appArgLoc _ = None

-- The span of a check about the application [app] itself: its own span, head
-- through last argument, or the [enclosing] construct's when that construct
-- begins with the application (at its first column, or one before it: an
-- opening bracket), so it does not start on unrelated code.
appSpanLoc : Option Loc -> Expr -> Option Loc
appSpanLoc enclosing app = match exprSpanLoc app
  None => enclosing
  Some own => if beginsWithSpan enclosing own then enclosing else Some own

-- Does [outer] start where [inner] starts, or one column before it, and reach
-- at least as far?
beginsWithSpan : Option Loc -> Loc -> Bool
beginsWithSpan (Some (Loc _ sl sc el ec)) (Loc _ isl isc iel iec) =
  sl == isl
    && isc - sc >= 0
    && isc - sc <= 1
    && (el > iel || el == iel && ec >= iec)
beginsWithSpan None _ = False

-- ── #1815: application spines ───────────────────────────────────────────────
-- The ultimate head of an application spine, ELoc wrappers peeled.  A non-application
-- expression is its own head (so `appSpineNodes` below answers [] for it, which is what
-- makes every spine-keyed predicate decline at dispatch index 0 and leave the existing
-- bare-head paths byte-unchanged).
appSpineHead : Expr -> Expr
appSpineHead (ELoc _ e) = appSpineHead e
appSpineHead (EApp f _) = appSpineHead f
appSpineHead e = e

-- The type/route classifier strips locations from the head. Its occurrence
-- obligations still belong to that head, including at a later dispatch argument.
appSpineHeadLoc : Expr -> Option Loc
appSpineHeadLoc (ELoc loc e) = orElseLoc (appSpineHeadLoc e) (Some loc)
appSpineHeadLoc (EApp f _) = appSpineHeadLoc f
appSpineHeadLoc e = exprLoc e

-- The `EApp` nodes of a spine in APPLICATION ORDER — node i is the one supplying
-- argument i.  ELoc wrappers are peeled off the nodes themselves (the argument keeps
-- its own, which is what `appArgLoc` reads for the error span).
appSpineNodes : Expr -> List Expr
appSpineNodes e = appSpineNodesGo e []

-- Walks from the outermost node inward, prepending, so the list comes out in
-- application order with no reverse.
appSpineNodesGo : Expr -> List Expr -> List Expr
appSpineNodesGo (ELoc _ e) acc = appSpineNodesGo e acc
appSpineNodesGo (EApp f x) acc = appSpineNodesGo f (EApp f x :: acc)
appSpineNodesGo _ acc = acc

-- the argument an application node supplies.  Total only over nodes `appSpineNodes`
-- returned; anything else has no argument and yields itself, which cannot happen.
appNodeArg : Expr -> Expr
appNodeArg (ELoc _ e) = appNodeArg e
appNodeArg (EApp _ x) = x
appNodeArg e = e

-- infer a spine's already-applied arguments, LEFT TO RIGHT (source order — the same
-- order the recursive `infer env f` walk used to visit them), pairing each with the
-- node that supplies it so `inferApp` can still localize its own error span.
inferSpineArgs : TcEnv -> List Expr -> List (Expr, Mono)
inferSpineArgs env [] = []
inferSpineArgs env (n :: rest) =
  let t = infer env (appNodeArg n)
  (n, t) :: inferSpineArgs env rest

-- fold `inferApp` over a spine's (node, argument-type) pairs, left to right.  One
-- pair is exactly the single `inferApp` call the bare-head paths make.
inferAppNodes : TcEnv -> Mono -> List (Expr, Mono) -> Mono
inferAppNodes env ft [] = ft
inferAppNodes env ft ((node, at) :: rest) =
  inferAppNodes env (inferApp env node ft at) rest

-- Apply [ft] to the spine's argument nodes in order and return the residual
-- result.  `[]` is the identity.  Each argument flows in through
-- `applicationRow` with its own syntax, so a standalone selected in place of a
-- method is proved exactly like any other callee.
unifySpineResult : TcEnv -> Expr -> Mono -> List (Expr, Mono) -> Mono
unifySpineResult env _ ft [] = ft
unifySpineResult env f ft ((node, at) :: rest) =
  let r = freshVar env.teDyn.dcModule ()
  let eff = applicationRow env (EApp f node) ft at r
  let _ =
    performEffect env.teDyn.dcModule env.teDyn.dcModule.mcCells.curEffect eff
  let _ = notePerformSite env eff
  unifySpineResult env f r rest

-- ── #2109: RESULT-FIRST inference against a known expected type ───────────
-- `paramVarianceGuard` (the D-2 variance gate) fires only when BOTH rows at a
-- non-covariant slot are closed, and abstains while either is still a
-- metavariable.  That is the whole lever here.  Inferring an application
-- ARGUMENT-FIRST (`Ref noop`: `noop`'s closed `<>` row is pinned into `Ref ?a`
-- before the result ever meets the declaration) presents two closed rows and
-- the safe write-side narrowing is rejected; inferring it RESULT-FIRST
-- (`Ref ?a` meets `Ref (String -> <Stdout> Unit)` while `?a` is fresh) lets
-- the declaration pin the slot, and the argument is then checked against the
-- DECLARED field type by the ordinary arrow-row rule, which accepts a purer
-- function where a more effectful one is allowed.
--
-- Why this is sound for ANY callee, not only a constructor: the guard still
-- fires exactly when the callee's result at the slot is CLOSED independently
-- of the expectation — `idr : Ref a -> Ref a` applied to an already-typed cell
-- (`alias = idr box`, the #1098 launder) unifies its result first, which pins
-- `a := String -> <Stdout> Unit`, and the argument `box : Ref (String -> <>
-- Unit)` then meets that as closed~closed and is rejected as before.  A callee
-- whose result slot is a metavariable cannot have aliased the cell at any
-- particular row (parametricity), so nothing but a fresh value ever reaches
-- the accepting order.  The value this admits therefore has no other alias
-- yet, which is the one condition under which narrowing at a write is safe.
--
-- Scope, deliberately narrow: the expected type must contain a non-covariant
-- slot at all (`monoHasNonCovariantSlot`), the expression must be a plain
-- application spine (no lambda-argument or shadow-head special case, which
-- keep `inferAppExpr`'s arms), and only then does the order change.  Every
-- other program is inferred exactly as before, so no diagnostic moves.
inferExpected : TcEnv -> Expr -> Mono -> Mono
inferExpected env (ELoc l e) expected =
  inferExpected (envAt (Some l) env) e expected
-- A lambda meeting a known arrow takes the arrow's domains as its parameters
-- before its body is inferred, so a signed `f = p => …` sees `String @κ` the
-- way a clause `f p = …` does.
inferExpected env (ELam pats body) expected = match normalize expected
  TFun _ _ _ =>
    inferLamChecked
      (envAtIfSome (exprLoc body) env)
      (Some (normalize expected))
      pats
      body
  _ => infer env (ELam pats body)
inferExpected env e expected =
  -- The order only matters when an ARROW ROW sits inside a type-constructor
  -- slot (that is the only thing the variance gate compares), so a purely
  -- structural pre-check (`monoHasArrowInSlot`) runs first; the polarity
  -- table (a list, scanned per lookup) is consulted only for the rare
  -- expected types that have such a slot.  Measured: the unconditional table
  -- walk per signed clause cost ~1% Ir on hello-world `check`.
  if monoHasArrowInSlot expected
    && monoHasNonCovariantSlot
      env.teDyn.dcModule
      expected then match appSpineExpr e
    (hd, args) =>
      if isEmptyL args || not (plainAppHead env hd) then
        infer env e
      else
        inferAppResultFirst env hd args expected
  else
    infer env e

-- the application spine of [e]: its head and its arguments in order, looking
-- through the location wrappers that sit between one application node and
-- the next.  A non-application returns itself with no arguments.
appSpineExpr : Expr -> (Expr, List Expr)
appSpineExpr e = appSpineExprGo e []

-- Outermost node first, so each argument is prepended as it is met and the list
-- is already in application order.
appSpineExprGo : Expr -> List Expr -> (Expr, List Expr)
appSpineExprGo (EApp f x) args = appSpineExprGo f (x :: args)
appSpineExprGo (ELoc _ (EApp f x)) args = appSpineExprGo (EApp f x) args
appSpineExprGo e args = (e, args)

-- a head `inferAppExpr` would take through its plain arm: an ordinary variable
-- that is neither a standalone shadow nor a definer shadow.  Anything else
-- keeps its dedicated arm and the argument-first order.
plainAppHead : TcEnv -> Expr -> Bool
plainAppHead env (ELoc _ inner) = plainAppHead env inner
plainAppHead env (hd@(EVar _)) = plainAppHeadVar env hd
plainAppHead env (hd@(EVarId _ _)) = plainAppHeadVar env hd
plainAppHead env (EDictAt _ _) = True
plainAppHead env _ = False

plainAppHeadVar : TcEnv -> Expr -> Bool
plainAppHeadVar env hd = match shadowStandaloneHead env hd
  Some _ => False
  None => match definerShadowArgHead env.teDyn.dcModule hd
    Some _ => False
    None => match definerShadowVarHead env.teDyn.dcModule hd
      Some _ => False
      None => True

-- the arrows of [ft] peeled [n] deep, then the result unified with [expected]
-- BEFORE any argument is looked at; each argument is then inferred against
-- the (now pinned) domain and applied through the ordinary `inferApp`, so the
-- effect bookkeeping and every diagnostic of the plain path are unchanged.
-- A callee with fewer than [n] arrows skips the pre-unification (the arity
-- error surfaces from `inferApp` exactly as before).
inferAppResultFirst : TcEnv -> Expr -> List Expr -> Mono -> Mono
inferAppResultFirst env hd args expected =
  let ft = infer env hd
  let _ = match resultAfterArrows (listLen args) ft
    Some res => unifyIn env.teDyn res expected
    None => ()
  inferAppArgsAgainst env hd ft args

inferAppArgsAgainst : TcEnv -> Expr -> Mono -> List Expr -> Mono
inferAppArgsAgainst env _ ft [] = ft
inferAppArgsAgainst env appSoFar ft (x :: rest) =
  let xt = match lamUnderLoc x
    Some (loc, pats, body) =>
      inferLamChecked
        (envAtIfSome loc env)
        (Some (funDomain env.teDyn.dcModule (normalize ft)))
        pats
        body
    None => inferExpected env x (funDomain env.teDyn.dcModule (normalize ft))
  let res = inferApp env (EApp appSoFar x) ft xt
  inferAppArgsAgainst env (EApp appSoFar x) res rest

inferAppExpr : TcEnv -> Expr -> Expr -> Mono
inferAppExpr env f x = match lamUnderLoc x
  Some (loc, pats, body) =>
    let ft = infer env f
    -- ft is `(lamType) -> result`; its FIRST domain is the lambda's expected
    -- type.  Peel that, then peel the lambda type itself for its per-param types.
    let lamExpected = funDomain env.teDyn.dcModule (normalize ft)
    let xt = inferLamChecked (envAtIfSome loc env) (Some lamExpected) pats body
    inferApp env (EApp f x) ft xt
  None => match shadowStandaloneSpineHeadAt env f
    -- #2154: the IMPORTER-side spine arm, mirroring #1815's definer spine arms — it
    -- must run BEFORE the bare-head shadowStandaloneHead/inferShadowApp arm below for
    -- the same reason: an importer shadow whose interface dispatches at index k > 0
    -- has its receiver at the OUTER spine node, not the inner node the bare-head arm
    -- would otherwise ask about.  Declines (None) at k == 0, so the bare-head arm
    -- stays byte-identical.
    Some (mname, arityRefs, tagRefs, hd, nodes) =>
      inferShadowAppAt env mname arityRefs tagRefs hd nodes f x
    None => match shadowStandaloneHead env f
      Some (mname, arityRefs, tagRefs) =>
        inferShadowApp env mname arityRefs tagRefs f x
      -- #1815: the SPINE arms come FIRST, and they are the same two definer-shadow arms
      -- one node further out.  A definer shadow whose interface dispatches on argument
      -- k > 0 (`mth : Int -> b -> Int`) reaches its dispatch argument at the OUTER node
      -- of `EApp (EApp mth n) x` — the inner node supplies argument 0, which is not the
      -- receiver at all.  Without these arms the inner node fired the index-0 arms, asked
      -- the dispatch question about argument 0, and imposed the standalone's whole
      -- declared type on the enclosing annotated function.  They decline at k == 0 (a
      -- bare head has no applied nodes), so the index-0 path below is byte-unchanged.
      None => match definerShadowSpineArgAt env.teDyn.dcModule f
        Some (dname, darityRef, dtagRef, dimplRef, dinnerRef, dhd, dnodes) =>
          inferDefinerShadowAppAt
            env
            dname
            darityRef
            dtagRef
            dimplRef
            dinnerRef
            dhd
            dnodes
            f
            x
        None => match definerShadowSpineVarAt env.teDyn.dcModule f
          Some (dname, dhd, dnodes) =>
            inferDefinerShadowVarAppAt env dname dhd dnodes f x
          None => match definerShadowArgHead env.teDyn.dcModule f
            Some (dname, darityRef, dtagRef, dimplRef, dinnerRef) =>
              inferDefinerShadowApp
                env
                dname
                darityRef
                dtagRef
                dimplRef
                dinnerRef
                f
                x
            None => match definerShadowVarHead env.teDyn.dcModule f
              Some dname => inferDefinerShadowVarApp env dname f x
              None =>
                let ft = infer env f
                let xt = infer env x
                -- P0-16: detect `f(1, 2)` on the PRISTINE ft (before inferApp unifies
                -- its domain with the tuple), then record the residual result so a
                -- downstream no-impl / mismatch can surface the tailored hint.
                let pend = tupleCallShapeHint f x ft
                let res = inferApp env (EApp f x) ft xt
                let _ = match pend
                  Some (help, fix) =>
                    env.teDyn.dcModule.mcCells.tupleCallCandidates :=
                      (res, help, fix)
                        :: env.teDyn.dcModule.mcCells.tupleCallCandidates.value
                  None => ()
                res

-- @Impl: if [x] is an `@Name` disambiguation hint (a bare `EVar "@Name"`, possibly
-- under an ELoc wrapper), return the name with the leading `@` stripped.  Mirrors
-- the two oracle arms `EApp(f, EVar h)` and `EApp(f, ELoc(_, EVar h))` with
-- `h.[0]='@'`.  Anything else → None → the ordinary application path.

-- Bug C: peel a single-argument application's
-- head to a standalone-shadow interface-method reference (`size b` where `size`
-- is BOTH a `Sizeable` method AND an imported standalone —
-- `test/shadow_fixtures/i7_importer_value_pos_liveimpl/`).  Handles BOTH the
-- MARKED form (`EMethodAt`, the eval/build path — carries a route ref to stamp RLocal)
-- and the UNMARKED form (`EVar`, the `check` path — no route ref; the empty list).
-- Only fires for a SINGLE-param interface method whose name is a registered importer
-- shadow with a stashed standalone scheme — exactly the oracle's guard.  Everything
-- else (no shadow, multi-param iface, non-method head) returns None → the ordinary path.
shadowStandaloneHead : TcEnv ->
  Expr ->
  Option (String, List (Ref (Option Int)), List (Ref Route, Ref Inner))
shadowStandaloneHead env (ELoc _ f) = shadowStandaloneHead env f
shadowStandaloneHead env (EMethodAt name _ ev)
  | isShadowStandalone env name =
    let c = methodCellOf env.teDyn.dcModule.mcGraph ev
    Some (name, [c.ecArity], [(c.ecTag, c.ecInner)])
  | otherwise = None
shadowStandaloneHead env (EVar name)
  | isShadowStandalone env name = Some (name, [], [])
  | otherwise = None
shadowStandaloneHead env (EVarId name _)
  | isShadowStandalone env name = Some (name, [], [])
  | otherwise = None
shadowStandaloneHead env _ = None

-- #2154: the IMPORTER-side spine arm — the peer of definerShadowSpineArgAt /
-- definerShadowSpineVarAt for an imported standalone shadowing a method whose
-- interface dispatches at argument k > 0.  Peels the spine's ultimate head with the
-- SAME test shadowStandaloneHead already applies to a bare head (so a marked
-- EMethodAt receiver and an unmarked EVar/EVarId receiver both fire, exactly as
-- shadowStandaloneHead's own two arms do), then gates on `shadowSpineNodesAt`, which
-- declines (`None`) for a bare head (k == 0, nodes == []) — the existing
-- shadowStandaloneHead / inferShadowApp path stays byte-identical.
shadowStandaloneSpineHeadAt : TcEnv ->
  Expr ->
  Option (String, List (Ref (Option Int)), List (Ref Route, Ref Inner), Expr, List Expr)
shadowStandaloneSpineHeadAt env f =
  match shadowStandaloneHead env (appSpineHead f)
    None => None
    Some (name, arityRefs, tagRefs) =>
      map
        (nodes => (name, arityRefs, tagRefs, appSpineHead f, nodes))
        (shadowSpineNodesAtImporter env.teDyn.dcModule name f)

-- a name that is BOTH a registered importer shadow (standaloneValuesRef), has a
-- stashed standalone scheme, and names a single-TYPARAM interface's method.
--
-- ⚠️ IMPORTER side ⇒ singleTyparamIfaceMethod, NOT ifaceMethodName (#54).  Fork 1 keeps
-- the per-receiver rule here, and that rule keys the impl query on the receiver's head
-- tycon standing at the interface's ONE typaram.  A multi-typaram interface has no such
-- correspondence to key on -- `FromEntries c e`'s `fromEntries : List e -> c` does not
-- even take its first typaram as an argument -- so the importer arms stay scoped to the
-- single-typaram case.  The DEFINER arms do not: under the S2 inversion they never query
-- the impl universe at all, so they are typaram-agnostic (ifaceMethodName).
isShadowStandalone : TcEnv -> String -> Bool
isShadowStandalone env name =
  omHasKey name env.teDyn.dcModule.mcCells.standaloneValuesRef.value
    && isSome (lookupImportedStandalone env name)
    && singleTyparamIfaceMethod env.teDyn.dcModule name

-- True iff [name]'s interface (in methodEntryHere) takes exactly ONE type
-- parameter -- the receiver-directed case the per-receiver IMPORTER rule (Fork 1) is
-- scoped to.  When two or more declarations are admitted it answers over the whole
-- set (every admitted interface takes one), never by the absence of a single winner:
-- `False` would skip the importer route and with it S2-DECL (d)'s cardinality
-- decision (`importerAdmittedVerdict`).
--
-- ⚠️ RENAMED from `singleParamIfaceMethod` (#54).  The old name said "single-PARAM
-- method" while the body counts interface TYPE PARAMS; it stated the opposite of what it
-- does and sent one agent down a wrong hypothesis (issue #54; SHADOW-SEMANTICS.md S8).
-- A two-PARAM method of a one-typaram interface (`comb : a -> a -> Int`, cell d7) passes
-- this predicate, and always did.
singleTyparamIfaceMethod : ModuleCtx -> String -> Bool
singleTyparamIfaceMethod mctx name = match methodEntryHere mctx name
  Some (_, typarams, _, _) => listLen typarams == 1
  None => match methodAdmittedHere mctx name
    [] => False
    ifs =>
      allList
        (r => match r.mrEntry
          (_, typarams, _, _) => listLen typarams == 1)
        (filterList
          (r =>
            let key = ifaceSortKey (methodRowIface r)
            anyList (ir => ifaceSortKey ir == key) ifs)
          (methodVisibleHere mctx name))

-- True iff [name] is a method of SOME visible interface, whatever its typaram arity --
-- the DEFINER-side gate (#54, closing S-3 / SHADOW-SEMANTICS.md row 26).
--
-- Under the S2 inversion a definer shadow denotes its module's own standalone
-- unconditionally: the impl universe is never consulted, so there is no receiver-to-
-- typaram correspondence to require, and gating the definer entry points on the typaram
-- COUNT only excused `interface Ix a i` from the machinery.  That excusal was the S-3
-- bug: d11 typed+emitted per-receiver (the OLD, pre-inversion semantics) while eval, which
-- has no route stamp to follow, resolved the bare name lexically to the standalone and
-- E-PANICked `unknown op '*'` on a `Box` -- an S7 path-agreement violation.
-- Two or more admitted declarations are each a method of a visible interface, so the
-- admitted set answers True as well.
ifaceMethodName : ModuleCtx -> String -> Bool
ifaceMethodName mctx name =
  isSome (methodEntryHere mctx name)
    || isNonEmptyL (methodAdmittedHere mctx name)

-- Bug C: type `toList m` for a no-impl receiver against the imported STANDALONE
-- scheme (giving the concrete result element type, e.g. `List (String, Int)`) and
-- stamp the route RLocal (when marked); if the receiver DOES have an impl (or its head
-- is not yet concrete) fall through to ordinary dispatch (typed against the method
-- scheme the env rebound the name to).
--
-- ✅ S1-RESIDUAL-B CLOSED (2026-07-14).  This function used to have NO groundShadowReceiver
-- call, unlike its definer peer inferDefinerShadowApp (which P0-20 gave one).  An UNGROUNDED
-- receiver — a bare `Num` LITERAL is the everyday case, it is `Num a => a`, not `Int` — so
-- never reached the standalone arm below (headTyconMono is None) and fell to the
-- ordinary-app arm, which types against the METHOD scheme the env rebound the name to.
--
--   -- lib/prov.mdk:  export isEmpty : Int -> Bool
--   import lib.prov.{isEmpty}
--   main = println (debug (isEmpty 0))     -- Type mismatch: Int literal vs Int Int
--
-- The `Int Int` in that message is the tell: the PRELUDE's `Foldable.isEmpty : t a -> Bool`
-- is higher-kinded, so unifying `t a` with the literal's tyvar solved `t := Int, a := Int`.
-- The user's imported `isEmpty : Int -> Bool` was never consulted.  (Filed as "under-applies
-- on run" for a CONSTRAINED standalone; the root is broader — it breaks an UNCONSTRAINED one
-- at `check` too, whenever the shadowed method is higher-kinded.)
--
-- Fix, exactly as filed: ground an ungrounded receiver to the IMPORTED standalone's declared
-- domain BEFORE asking the S2 impl question, so typecheck and the post-inference route
-- resolver ask it about the SAME head.  That symmetry is the whole P0-20 lesson — a decision
-- derived twice, at two different times, over a receiver that changed in between.
--
-- ⚠️ NOT affected by the S2 inversion: an IMPORTER shadow keeps the per-receiver rule
-- (Fork 1).  Grounding only decides WHICH head the rule is applied to; a grounded head with
-- a live impl still dispatches (`isEmpty [1, 2]` → `Foldable.isEmpty`, fixture i4).
inferShadowApp : TcEnv ->
  String ->
  List (Ref (Option Int)) ->
  List (Ref Route, Ref Inner) ->
  Expr ->
  Expr ->
  Mono
inferShadowApp env mname arityRefs tagRefs f x =
  -- the application's loc, so a domain mismatch localizes to the call site, not
  -- the argument.
  let dloc = appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)
  let tx = infer env x
  -- The dict-var carve-out (S5/Fork 2) applies to importer shadows too: a receiver that is
  -- the enclosing fn's `=>`-bound constraint var DISPATCHES through that dict, so it must
  -- NOT be ground to the standalone's domain (that would monomorphise the written signature).
  -- groundShadowReceiver is also inert on an already-grounded receiver, so i1/i3/i4 (all
  -- concrete receivers) are byte-identical.
  let _ =
    groundShadowReceiver
      env.teDyn
      (importerShadowDomain env mname)
      tx
      (definerReceiverIsDictVar env.teDyn mname tx)
      dloc
  -- #2188 / S2-DECL (d): the cardinality decision, asked BEFORE the single-winner impl
  -- question below.  Inert (`AdDefer`, and `groundAdmittedReceivers` a no-op) for every
  -- name with fewer than two admitted declarations — see `importerAdmittedVerdict`.
  let _ = groundAdmittedReceivers env mname [tx] dloc
  match (importerAdmittedVerdict
    env.teDyn.dcModule
    env.teDyn.dcModule.mcCells.bodyImplEnvRef.value
    mname
    [tx])
    AdReject ifs =>
      let _ =
        pushAmbiguousShadowDecl
          env.teDyn.dcModule
          mname
          ifs
          (orElseLoc (appSpineHeadLoc f) dloc)
      -- T-ERRORS-ACCUM: the diagnostic is the verdict; inference still has to produce a
      -- type for the occurrence, and the standalone is the only denotation this call has
      -- that no admitted declaration disputes the SHAPE of.
      inferShadowStandaloneArm env mname arityRefs tagRefs f x tx
    AdStandalone => inferShadowStandaloneArm env mname arityRefs tagRefs f x tx
    AdDefer => match headTyconMono tx
      -- ARCH B-2.1-g: the S2 impl question, off the GRAPH-GLOBAL substrate — see
      -- `ieImplExistsForHead`.  It used to read the cumulative topological PREFIX
      -- (`shadowKeyTableRef`), which made this answer depend on where in the module order
      -- the receiver's impl happened to sit.
      Some head =>
        if ieImplExistsForHead
          env.teDyn.dcModule
          env.teDyn.dcModule.mcCells.bodyImplEnvRef.value
          mname
          head then
          inferApp env (EApp f x) (inferShadowAppHead env f) tx
        else
          inferShadowStandaloneArm env mname arityRefs tagRefs f x tx
      None => inferApp env (EApp f x) (inferShadowAppHead env f) tx

-- stamp every route ref (one for the marked EMethodAt form, none for the unmarked
-- check-path EVar form) RLocal.  S-1: the standalone's own constraint dicts are NOT
-- resolvable here (inference has not solved the receiver yet) — the caller ALSO pushes
-- an RLocalSite so resolveRLocalSites re-stamps the same ref with the filled dicts
-- post-inference.  An unconstrained standalone never gets a second stamp that differs.
export
stampRoutes : List (Ref Route) -> Unit
stampRoutes [] = ()
stampRoutes (r :: rest) =
  r := RLocal (routeLocalSym !r) []
  stampRoutes rest

export
stampMethodArities : List (Ref (Option Int)) -> Int -> Unit
stampMethodArities [] _ = ()
stampMethodArities (r :: rest) arity =
  r := Some arity
  stampMethodArities rest arity

-- The STANDALONE arm of `inferShadowApp`, factored out verbatim so S2-DECL (d)'s
-- `AdStandalone` and `AdReject` verdicts reach exactly the arm the impl-query miss
-- already reached — one arm, three callers, no second copy to drift.
inferShadowStandaloneArm : TcEnv ->
  String ->
  List (Ref (Option Int)) ->
  List (Ref Route, Ref Inner) ->
  Expr ->
  Expr ->
  Mono ->
  Mono
inferShadowStandaloneArm env mname arityRefs tagRefs f x tx =
  match lookupStandaloneValue env mname
    Some value =>
      let occurrence =
        instantiateStandaloneOccurrence
          env
          mname
          ""
          (orElseLoc (appSpineHeadLoc f) env.teDyn.dcModule.mcLoc)
          value
      let _ = recordStandaloneAt env.teDyn.dcModule mname f occurrence
      let smono = occurrence.svoInstance.mtiBody
      let _ = stampMethodArities arityRefs (funArity smono)
      let r = freshVar env.teDyn.dcModule ()
      -- At the call site, as `inferShadowApp`'s domain check.
      let eff =
        applicationRow
          (envAtIfSome (appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)) env)
          (EApp f x)
          smono
          tx
          r
      let _ =
        performEffect
          env.teDyn.dcModule
          env.teDyn.dcModule.mcCells.curEffect
          eff
      let _ = stampRoutes (map fst tagRefs)
      -- S-1 (Fork D — the importer half): an IMPORTED constrained standalone shadowing
      -- a method breaks identically to a local one (its def is dict-passed in its own
      -- module; this call must supply the dicts).  Compute them off the head type we
      -- just unified, and defer the ROUTE stamp to resolveRLocalSites — stampRoutes
      -- above ran mid-inference, when the receiver is not yet solved, so it could only
      -- write `RLocal sym []`.  forceLocal=True: this arm has already committed the
      -- site's TYPE to the standalone, so its route is not open to re-derivation.
      let _ =
        recordSelectedStandaloneRoutes
          env.teDyn.dcModule
          mname
          occurrence.svoDicts
          tagRefs
          tx
      r
    None => inferApp env (EApp f x) (inferShadowAppHead env f) tx

-- #411: infer an IMPORTER-shadow application's head with `dcShadowHeadCtx` set, so
-- maybeStandaloneValueMono's new importer arm does not pin an APPLIED occurrence to the
-- standalone scheme (which would kill per-receiver dispatch — Fork 1 / i4).  The definer
-- path has always typed its head this way (inferDefinerShadowApp); this is the peer
-- the importer path was missing, and the reason it could be missing before is that
-- nothing pinned importer value positions at all — which IS the #411 bug.
inferShadowAppHead : TcEnv -> Expr -> Mono
inferShadowAppHead env f = infer (shadowHeadEnv env) f

-- [env] for typing a shadow occurrence that heads its own application.
shadowHeadEnv : TcEnv -> TcEnv
shadowHeadEnv env = { env | teDyn = { env.teDyn | dcShadowHeadCtx = True } }

-- #2154: the spine-generalized twin of inferShadowApp — the peer of
-- inferDefinerShadowAppAt for the IMPORTER path.  [hd] is the spine's ultimate head
-- ([f] itself at index 0, unreachable here since shadowStandaloneSpineHeadAt declines
-- at k == 0) and [nodes] the application nodes already applied to it; [pre] is those
-- nodes' inferred (node, mono) pairs in source order, exactly as inferDefinerShadowAppAt
-- computes them.  Performs the SAME S2 impl-exists-vs-standalone-scheme branch
-- inferShadowApp does, at the outer node, folding inferApp/unification over the whole
-- applied prefix via inferSpineArgs/inferAppNodes/unifySpineResult.
inferShadowAppAt : TcEnv ->
  String ->
  List (Ref (Option Int)) ->
  List (Ref Route, Ref Inner) ->
  Expr ->
  List Expr ->
  Expr ->
  Expr ->
  Mono
inferShadowAppAt env mname arityRefs tagRefs hd nodes f x =
  -- the application's loc, as in `inferShadowApp`.
  let dloc = appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)
  let pre = inferSpineArgs env nodes
  let k = listLen pre
  let tx = infer env x
  let _ =
    groundShadowReceiver
      env.teDyn
      (importerShadowDomainAt env mname k)
      tx
      (definerReceiverIsDictVar env.teDyn mname tx)
      dloc
  -- #2188 / S2-DECL (d): [ats] is every argument up to and including THIS node's, so at
  -- the OUTERMOST admitted dispatch index (`importerDispatchIdxOuter`, the index this arm
  -- is gated on) every admitted declaration's own receiver argument is in it — which is
  -- what makes (b)'s per-declaration pairs jointly evaluable here and nowhere else.
  let ats = map snd pre ++ [tx]
  let _ = groundAdmittedReceivers env mname ats dloc
  match (importerAdmittedVerdict
    env.teDyn.dcModule
    env.teDyn.dcModule.mcCells.bodyImplEnvRef.value
    mname
    ats)
    AdReject ifs =>
      let _ =
        pushAmbiguousShadowDecl
          env.teDyn.dcModule
          mname
          ifs
          (orElseLoc (appSpineHeadLoc f) dloc)
      inferShadowStandaloneArmAt env mname arityRefs tagRefs hd pre f x tx
    AdStandalone =>
      inferShadowStandaloneArmAt env mname arityRefs tagRefs hd pre f x tx
    AdDefer => match headTyconMono tx
      Some head =>
        if ieImplExistsForHead
          env.teDyn.dcModule
          env.teDyn.dcModule.mcCells.bodyImplEnvRef.value
          mname
          head then
          inferAppNodes
            env
            (inferShadowAppHead env hd)
            (pre ++ [(EApp f x, tx)])
        else
          inferShadowStandaloneArmAt env mname arityRefs tagRefs hd pre f x tx
      None =>
        inferAppNodes env (inferShadowAppHead env hd) (pre ++ [(EApp f x, tx)])

-- The STANDALONE arm of `inferShadowAppAt`, factored out verbatim — the peer of
-- `inferShadowStandaloneArm` at dispatch index k > 0, and reached from the same three
-- verdicts.
inferShadowStandaloneArmAt : TcEnv ->
  String ->
  List (Ref (Option Int)) ->
  List (Ref Route, Ref Inner) ->
  Expr ->
  List (Expr, Mono) ->
  Expr ->
  Expr ->
  Mono ->
  Mono
inferShadowStandaloneArmAt env mname arityRefs tagRefs hd pre f x tx =
  match lookupStandaloneValue env mname
    Some value =>
      let occurrence =
        instantiateStandaloneOccurrence
          env
          mname
          ""
          (orElseLoc (appSpineHeadLoc f) env.teDyn.dcModule.mcLoc)
          value
      let _ = recordStandaloneAt env.teDyn.dcModule mname hd occurrence
      let smono = occurrence.svoInstance.mtiBody
      let _ = stampMethodArities arityRefs (funArity smono)
      -- At the call site, as `inferShadowApp`'s domain check.
      let r =
        unifySpineResult
          (envAtIfSome (appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)) env)
          f
          smono
          (pre ++ [(x, tx)])
      let _ = stampRoutes (map fst tagRefs)
      let _ =
        recordSelectedStandaloneRoutes
          env.teDyn.dcModule
          mname
          occurrence.svoDicts
          tagRefs
          tx
      r
    None =>
      inferAppNodes env (inferShadowAppHead env hd) (pre ++ [(EApp f x, tx)])

-- S1-RESIDUAL-B: the IMPORTED standalone's declared domain — the first arrow domain of the
-- scheme retained by the lexical binding descriptor. The importer peer of
-- shadowDomainFor's mangled arm, and it must NOT
-- be `lookupVar env mname`: env1 rebound the bare name to the interface METHOD, which is the
-- very scheme whose higher-kinded domain caused the bug.
--
-- None (⇒ grounding is a no-op) when the name has no stashed standalone scheme, or when that
-- standalone's own first parameter is itself polymorphic (`f : a -> Bool`) — unifying a bare
-- tyvar domain with an ungrounded receiver leaves it ungrounded anyway, so the caller's
-- headTyconMono still says None and the old ordinary-app arm runs, byte-identically.
importerShadowDomain : TcEnv -> String -> Option Mono
importerShadowDomain env mname = match lookupStandaloneVar env mname
  None => None
  Some s => match normalize (instantiate env.teDyn.dcModule s)
    TFun a _ _ => Some a
    _ => None

-- #2154: as importerShadowDomain, but the standalone's k-th declared parameter — the
-- one the receiver occupies when the interface dispatches at argument k > 0.  Peer of
-- shadowDomainForAt / standaloneShadowDomainAt (#1815).  `k = 0` is importerShadowDomain
-- verbatim (nthFunDomain 0 on a TFun matches its first arm exactly).
importerShadowDomainAt : TcEnv -> String -> Int -> Option Mono
importerShadowDomainAt env mname k = match lookupStandaloneVar env mname
  None => None
  Some s => nthFunDomain k (instantiate env.teDyn.dcModule s)

-- S-1 (importer half): re-record each of the importer shadow's route refs as an
-- RLocalSite carrying the imported standalone's own constraint dicts, so
-- resolveRLocalSites re-stamps the ref post-inference with the dicts filled in.
-- forceLocal=True — inferShadowApp's standalone arm already committed the site's type.
-- Inert (no dicts, same RLocal stamp) for an unconstrained imported standalone.
recordSelectedStandaloneRoutes : ModuleCtx ->
  String ->
  ShadowDicts ->
  List (Ref Route, Ref Inner) ->
  Mono ->
  Unit
recordSelectedStandaloneRoutes mctx _ _ [] _ = ()
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
recordSelectedStandaloneRoutes mctx mname dicts ((r, inner) :: rest) tx =
  let _ =
    pushSiteGoal
      mctx.mcGraph
      GKRLocalSite
      inner
      (PendingEntry
        mname
        r
        tx
        mctx.mcCells.currentFn.value
        (SKRLocal
          (routeLocalSym !r)
          True
          dicts.sdMonos
          dicts.sdIfaces
          dicts.sdArgVecs)
        mctx.mcLoc
        (captureScope mctx ())
        (freshEvId mctx ()))
  recordSelectedStandaloneRoutes mctx mname dicts rest tx

-- P0-18: peel a single-argument application's head to a DEFINER-shadow interface-
-- method occurrence (the user's OWN top-level fn reuses a single-param interface
-- method name, e.g. this module's `size : Int -> Int` shadowing `Sizeable`'s
-- `size`).  Unlike importer shadows (shadowStandaloneHead / inferShadowApp), the
-- user's definition SHADOWS the method in scope, so the occurrence is typed against
-- the standalone scheme whose declared domain (`Int`) is NOT the actual receiver.
-- Returning the route ref lets inferDefinerShadowApp record the REAL argument mono
-- for per-receiver routing (`Box` has a `Sizeable` impl → method; `Int` → standalone).
-- P0-18 (importer residual): on the EMIT path a definer shadow's bare name is NOT
-- in definerShadowNamesRef when the standalone is IMPORTED from another module (that
-- ref is keyed on module-local funDefs).  But the mark pass ALREADY seeded such an
-- occurrence's route with the mangled standalone symbol (`RLocal <sym>`), so a
-- non-empty route symbol is an equally-good "this is a shadow" signal that works
-- cross-module.  Firing here routes the occurrence through inferDefinerShadowApp,
-- which types it against the standalone scheme and records the per-receiver mono —
-- so an importer shadow on a live-impl receiver dispatches to the impl, and one on a
-- no-impl receiver falls back to the standalone (RLocal <sym>), exactly like a
-- definer shadow.  On the un-mangled run/check path the route is RNone (sym ""), so
-- this branch is inert there and the ordinary definerShadowNames branch governs.
definerShadowArgHead : ModuleCtx ->
  Expr ->
  Option (String, Ref (Option Int), Ref Route, Ref (List Route), Ref Inner)
definerShadowArgHead mctx (ELoc _ f) = definerShadowArgHead mctx f
-- ⚠️ #54: the two disjuncts carry DIFFERENT gates, because they serve different shadow
-- KINDS — this predicate is a Fork-1 boundary, not an arity test.  `isDefinerShadow` is
-- typaram-agnostic; `importerShadowOnEmitPath` is scoped to single-typaram interfaces (see
-- its header).  Spelling the definer disjunct as `isDefinerShadow` — rather than inlining
-- its conjuncts here — is deliberate: that function is ALSO what resolveRLocalSite routes
-- on, and "the typing entry point and the route stamper must apply the same gate" is the
-- P0-20 invariant.  Sharing the symbol makes them impossible to drift.
definerShadowArgHead mctx (EMethodAt name _ ev) =
  definerShadowArgHeadCell mctx name (methodCellOf mctx.mcGraph ev)
definerShadowArgHead mctx _ = None

definerShadowArgHeadCell : ModuleCtx ->
  String ->
  EvCell ->
  Option (String, Ref (Option Int), Ref Route, Ref (List Route), Ref Inner)
definerShadowArgHeadCell mctx name c
  | isDefinerShadow mctx name
    || importerShadowOnEmitPath mctx name c.ecTag =
    Some (name, c.ecArity, c.ecTag, c.ecImpl, c.ecInner)
  | otherwise = None

-- L4 (xmod-identity #1351 spine, RUN-XMOD-022/026): the mark pass's own per-occurrence
-- verdict, named rather than left as an anonymous `routeLocalSym … /= ""` idiom.
-- `rewriteArgScoped`'s `sm` arm is the SOLE origin of a non-empty RLocal symbol on an
-- EMethodAt route (F8); every other RLocal stamp propagates that origin symbol
-- unchanged.  This is NOT a graph-wide fact and is NOT interchangeable with one: "The
-- signal is PER-OCCURRENCE, not graph-wide … keying on it (not on the whole-graph
-- standaloneValuesRef) is what keeps this from pinning the compiler's genuine
-- method-values and breaking dispatch" (this file, historically beside this site).
-- #2809: the seed is the BARE standalone name on every path now, so "non-empty" no
-- longer says "the mangler moved the name" — `recoveredShadowSym` is what does.
occurrenceCarriesMangledShadowSym : String -> Ref Route -> Bool
occurrenceCarriesMangledShadowSym name tagRef =
  recoveredShadowSym name tagRef /= ""

-- #54: the SECOND disjunct of definerShadowArgHead — the IMPORTER-on-emit signal, kept
-- separate because it carries a DIFFERENT gate from the definer one.  The mark pass seeds
-- an importer shadow's route with the provider's mangled standalone symbol, so a non-empty
-- route symbol says "this is a shadow" cross-module, where definerShadowNamesRef (keyed on
-- module-local funDefs) cannot.  It stays scoped to singleTyparamIfaceMethod because what
-- it feeds is Fork 1's per-receiver rule; the definer disjunct (isDefinerShadow) does not,
-- because the S2 inversion never queries the impl universe.  On the un-mangled run/check
-- path the route is RNone (sym ""), so this is inert there.
--
-- L4: this predicate now names its two conjuncts separately instead of conflating them in
-- one `routeLocalSym … /= ""` test.  `gctx.mangledFunDefsPresentRef.value`
-- (L3) is the GRAPH-level fact "this compile's decls carry mangled funDefs at all";
-- `occurrenceCarriesMangledShadowSym tagRef` is the mark pass's own PER-OCCURRENCE verdict
-- for THIS route.  The new graph-level conjunct is ADDED, not substituted for the
-- occurrence test — F7 (this file) forbids replacing the per-occurrence route test with a
-- graph-wide one: doing so would fire for occurrences the mark pass never marked, and
-- would pin genuine method-values, breaking dispatch.
--
-- 🚨 RUN-XMOD-045 CORRECTION (post-landing, slice-breaker finding) — REPLACES the
-- original "redundant-by-construction, F8" safety narrative below with the actual one.
-- F8's implication chain ("a non-empty route symbol implies the graph fact is True") is
-- still literally true, but it undersold what actually holds: `mangledFunDefsPresentRef`
-- is not merely implied True in that case, it is CONSTANT TRUE on every emit path,
-- unconditionally — see `graphCarriesMangledFunDefs`'s header for the mechanism
-- (`private_mangle.mdk:14-16` mangles core's own funDefs unconditionally, before this
-- flag is ever computed; measured ~70 `@mdk_<mid>__*` symbols in a feature-free build's
-- IR with zero shadows).  F8's phrasing hid its own precondition: it is only a
-- meaningful narrowing test if the flag CAN be False on some occurrence's compile, and
-- on the emit path it never is.  The actual safety property is therefore simpler and
-- stronger than "redundant, measured by a negative control": THE FLAG IS CONSTANT TRUE
-- THE MOMENT MANGLING RAN AT ALL, so its conjunct can never be what rejects an
-- occurrence the un-mangled reading of `occurrenceCarriesMangledShadowSym` would have
-- accepted — the predicate's real discriminator is still, and only, the
-- per-occurrence route symbol.
--
-- 🚨 THIS FACT CURRENTLY HAS NO DISCRIMINATING CONSUMER — L4's conjunct
-- (`mangledFunDefsPresentRef`) is constant-True on emit and its partner
-- (`occurrenceCarriesMangledShadowSym`) is always-empty off emit.  It is explicit
-- documentation of an implicit invariant, not a live condition.  Do not migrate a
-- reader onto it expecting it to select.  KEPT rather than reverted (owner ruling,
-- RUN-XMOD-045): provably zero-risk, and "this graph was mangled" is more readable
-- than the anonymous `routeLocalSym … /= ""` idiom it replaced, even though it cannot
-- currently narrow anything a build-time `medaka check`/`run`/`build` differential
-- could observe from outside the compiler.
importerShadowOnEmitPath : ModuleCtx -> String -> Ref Route -> Bool
importerShadowOnEmitPath mctx name tagRef =
  singleTyparamIfaceMethod mctx name
    && mctx.mcGraph.mangledFunDefsPresentRef.value
    && occurrenceCarriesMangledShadowSym name tagRef

-- P0-18: type `size (Box 3)` exactly as the ordinary path (against the standalone
-- scheme the env rebound `size` to, preserving program types), but record the
-- ACTUAL argument mono (`Box`) as this site's receiver so resolveRLocalSite routes
-- per-receiver: a receiver head WITH an impl of the shadowed interface dispatches to
-- the method (route left untouched → eval arg-tag / emit RKey), one WITHOUT an impl
-- stays the standalone (RLocal).  dcSuppressRLocalRecord stops recordRLocalSite from
-- ALSO pushing the standalone's declared domain (which would mis-route `Box`→`Int`).
inferDefinerShadowApp : TcEnv ->
  String ->
  Ref (Option Int) ->
  Ref Route ->
  Ref (List Route) ->
  Ref Inner ->
  Expr ->
  Expr ->
  Mono
inferDefinerShadowApp env name arityRef tagRef implRef innerRef f x =
  inferDefinerShadowAppAt env name arityRef tagRef implRef innerRef f [] f x

-- #1815: the marked twin at an arbitrary dispatch index — the peer of
-- inferDefinerShadowVarAppAt, and the two must still agree cell-for-cell (S7).  [hd] is
-- the spine's ultimate head ([f] itself at index 0) and [nodes] the application nodes
-- already applied to it.  BOTH decision layers move together here: the TYPE arm reads
-- the receiver at index k, and the ROUTE stamps (pendingRLocalSites / pendingArgStamps)
-- are pushed at THIS node with THAT receiver — "the route must follow the arm".
inferDefinerShadowAppAt : TcEnv ->
  String ->
  Ref (Option Int) ->
  Ref Route ->
  Ref (List Route) ->
  Ref Inner ->
  Expr ->
  List Expr ->
  Expr ->
  Expr ->
  Mono
inferDefinerShadowAppAt env name arityRef tagRef implRef innerRef hd nodes f x =
  -- #2809: the RECOVERED symbol, not the raw route seed — every use of [sym] below is
  -- a typing decision that presumes "the bare name no longer denotes the standalone"
  -- (see `recoveredShadowSym`).  The two `SKRLocal (routeLocalSym !tagRef)` stamps
  -- keep the raw seed: that is the route the emitter follows.
  let sym = recoveredShadowSym name tagRef
  -- P0-19: the application's location, so a standalone-domain mismatch reports at
  -- the call site.
  let dloc = appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)
  -- #1815: the arguments the spine already applied, inferred in source order (exactly
  -- the order the recursive walk visited them in before).
  let pre = inferSpineArgs env nodes
  let k = listLen pre
  -- P0-19 d8 (S2/S6): infer the argument FIRST so the head scheme is chosen PER
  -- RECEIVER.  A receiver with a VISIBLE impl of the shadowed interface (impl universe
  -- is GRAPH-GLOBAL: ARCH B-2.1-g reads `bodyImplEnvRef` via `ieImplExistsForHead`)
  -- DISPATCHES → type
  -- 🚨 This note used to say "shadowKeyTableRef spans local ∪ imported ∪ prelude", and
  -- BOTH halves were wrong.  `SHADOW-SEMANTICS.md:242-245` RETIRES that phrase — "'local
  -- ∪ imported ∪ prelude' is NOT a synonym for graph-global … an older wording of S2 used
  -- it as one anyway" — and the table was narrower still: on the Module arm
  -- `shadowKeyTableRef` was the CUMULATIVE TOPOLOGICAL PREFIX, so it did not even span
  -- "imported" once the impl sat in a topologically later module.  Do not re-derive the
  -- retired claim from the old wording.
  -- the head against the METHOD scheme; else it is the STANDALONE.  Without this the
  -- mangled emit path (sym /= "") ALWAYS typed against the standalone scheme
  -- (`Int -> Int`), so a definer shadow whose impl is IMPORTED (`size (Box 3)`, d8)
  -- rejected `Int vs Box` at build/run instead of dispatching to the imported impl.
  let xt = infer env x
  -- P0-19 (constrained-receiver arm): an ungrounded receiver that is a dict-bound
  -- constraint var dispatches through that dict — it must neither be typed against the
  -- standalone scheme nor stamped RLocal (which would send eval/emit to the standalone
  -- and, e.g., apply `sz n = n + 1` to a Bool).
  let isDictVar = definerReceiverIsDictVar env.teDyn name xt
  -- P0-20: ground an ungrounded receiver to the standalone's declared domain BEFORE the
  -- dispatch decision, so typecheck asks the impl question about the SAME head the
  -- post-inference route resolver will.  See groundShadowReceiver.
  let _ =
    groundShadowReceiver
      env.teDyn
      (shadowDomainForAt env name sym k)
      xt
      isDictVar
      dloc
  let dispatches = definerReceiverDispatches env.teDyn name xt
  -- A dispatching occurrence names the interface whose method it selects, as an
  -- ordinary method occurrence does (`inferMethodCandidateAt`); the standalone arm
  -- names none.
  let _ =
    if dispatches || isDictVar then match spineHeadEv hd
      Some ev =>
        let cell = methodCellOf env.teDyn.dcModule.mcGraph ev
        cell.ecIface := admittedIfaceWord env.teDyn.dcModule name
      None => ()
  -- The head is typed in `headEnv`: the two default pushes are suppressed, and, as an
  -- application head (marked EMethodAt on run/build, P0-19 d4b), it keeps the method
  -- scheme for per-receiver dispatch rather than the value-position standalone pin.
  let headEnv = { env |
    teDyn = { env.teDyn |
      dcSuppressRLocalRecord = True,
      dcSuppressArgStamp = True,
      dcShadowHeadCtx = True,
    },
  }
  -- P0-18: for the STANDALONE arm, type the head against the STANDALONE scheme.  On the
  -- un-mangled run/check path `infer env f` already resolves the bare name to the
  -- standalone (which shadows the method in scope).  On the EMIT path the bare name
  -- resolves to the interface METHOD scheme instead (the standalone was renamed to
  -- `<mid>__name`), whose result loses the concrete element type — e.g. Map's `toList`
  -- would type `List a` not `List (k, v)`, so a downstream `debug (toList m)` resolves
  -- the WRONG element dict and SIGSEGVs.  When we carry the mangled symbol, instantiate
  -- its (standalone) scheme directly so the impl-body types exactly as the run path
  -- does. For the DISPATCH arm, type against the METHOD scheme so a live-impl
  -- receiver unifies and the result comes from the method.
  -- DISPATCH arm: the interface METHOD scheme, fetched EXPLICITLY from
  -- methodEntryHere (which spans imported interfaces) — NOT `infer env f`, because
  -- on the multi-module path the env rebinds the bare method name to the LOCAL
  -- standalone (`Int -> Int`), so inferMethodAt's lookupVar would hand back `Int -> Int`
  -- and reject a live-impl receiver (`Box`).  STANDALONE arm: the standalone scheme
  -- (mangled sym on the emit path preserves the concrete result type).
  let selected =
    if dispatches then
      None
    else
      standaloneOccurrence headEnv name sym (orElseLoc (appSpineHeadLoc f) dloc)
  let ft =
    if dispatches then
      shadowVarHeadMethodScheme headEnv name hd
    else match selected
      Some occurrence =>
        let _ = recordStandaloneAt env.teDyn.dcModule name hd occurrence
        occurrence.svoInstance.mtiBody
      None => infer headEnv hd
  arityRef := Some (funArity ft)
  -- S-1: on the STANDALONE arm ONLY, compute that standalone's own `=>`-constraint
  -- dicts (and record its call obligations).  The DISPATCH arm typed `ft` against the
  -- interface METHOD scheme, whose dicts are the method's, not the standalone's — asking
  -- there would be meaningless.  A dict-var receiver dispatches through its dict and is
  -- likewise not the standalone.  ([], []) for an unconstrained standalone.
  let dicts =
    if dispatches || isDictVar then
      emptyShadowDicts
    else
      optionOr
        emptyShadowDicts
        (map (occurrence => occurrence.svoDicts) selected)
  -- Route by the ACTUAL argument type on BOTH the eval path (pendingRLocalSites,
  -- read by resolveRLocalSites) and the emit path (pendingArgStamps, read by
  -- resolveArgStamps — only recorded when this method arg-dispatches, i.e. on the
  -- build path).  xt grounds to the real receiver post-inference; the two default
  -- pushes (recordRLocalSite / recordArgStamp) that would carry the standalone's
  -- declared domain are suppressed above.
  -- ...EXCEPT for a dict-bound constraint-var receiver: resolveRLocalSite's ungrounded
  -- arm stamps RLocal unconditionally, which would route a genuine dict dispatch to the
  -- shadowing standalone.  Not recording the site leaves the route for ordinary dispatch
  -- (RNone → eval arg-tag / emit RKey via resolveArgStamps).
  -- P0-20: the route FOLLOWS THE ARM (`not dispatches` ⇒ forceLocal).  `ft` above has
  -- already committed this site's TYPE, so re-deriving its route from a receiver mono
  -- that may ground LATER (Num defaulting on an unsignatured standalone) is exactly how
  -- `check` and the binary came to disagree.  A dispatching receiver still re-derives
  -- (its head is already ground; RKey comes from resolveArgStamps on the emit path).
  let _ =
    if isDictVar then
      ()
    else
      pushSiteGoal
        env.teDyn.dcModule.mcGraph
        GKRLocalSite
        innerRef
        (PendingEntry
          name
          tagRef
          xt
          env.teDyn.dcModule.mcCells.currentFn.value
          (SKRLocal
            (routeLocalSym !tagRef)
            (not dispatches)
            dicts.sdMonos
            dicts.sdIfaces
            dicts.sdArgVecs)
          env.teDyn.dcModule.mcLoc
          (captureScope env.teDyn.dcModule ())
          (freshEvId env.teDyn.dcModule ()))
  let _ = match argDispatchOf env.teDyn.dcModule name
    -- #609: the SKArg full mono is the DISPATCH arm's method scheme (`ft`) — the
    -- only arm whose route this stamp decides.  On the STANDALONE arm `ft` is the
    -- standalone's own scheme, which is not an interface-method occurrence at all;
    -- pass the receiver mono `xt` so ifaceParamMonos fails its shape match and the
    -- selector falls back to the singleton goal, exactly as before #609.
    Some _ =>
      pushSiteGoal
        env.teDyn.dcModule.mcGraph
        GKArgStamp
        innerRef
        (PendingEntry
          name
          tagRef
          xt
          env.teDyn.dcModule.mcCells.currentFn.value
          (SKArg implRef (if dispatches then ft else xt) [])
          env.teDyn.dcModule.mcLoc
          (captureScope env.teDyn.dcModule ())
          (freshEvId env.teDyn.dcModule ()))
    None => ()
  -- P0-19: on the UN-MANGLED path (sym == "") `ft` is the permissive METHOD scheme
  -- (`a -> Int`), so `inferApp ft xt` would accept ANY receiver.  When this
  -- occurrence resolves to the STANDALONE — a grounded receiver head with no visible
  -- impl of the shadowed interface, or an ungrounded receiver (S5) — impose the
  -- standalone's DECLARED domain on the argument, so a domain mismatch (`size "hi"`,
  -- or a wrapper generalized over the shadow receiver then called at a live-impl type)
  -- becomes a located reject instead of build-time garbage.  A grounded receiver WITH
  -- an impl still dispatches (no enforcement) — that arm is untouched.  On the mangled
  -- emit path (sym /= "") `ft` is already the selected standalone instance,
  -- which enforces the domain itself, so this stays inert there.
  -- The STANDALONE arm with a written signature mirrors its unmarked twin
  -- (`inferDefinerStandaloneVarAppAt`'s `Some smono` branch): ONE unification of the
  -- standalone's type against the applied spine, at the call site.  Running the
  -- domain enforcement AND `inferApp` here raises the same mismatch twice (once at
  -- the call site, once at the receiver), and every driver reports from this arm
  -- now. `ft` IS the standalone's retained occurrence on this arm, so nothing is
  -- lost by not re-deriving it from the signature.
  match (if dispatches || isDictVar then
    None
  else
    standaloneSchemeFor env name sym)
    Some _ => unifySpineResult (envAtIfSome dloc env) f ft (pre ++ [(x, xt)])
    None =>
      let _ = if sym == "" then enforceStandaloneDomainAt env name xt dloc k
      inferAppNodes env ft (pre ++ [(EApp f x, xt)])

-- S1/S2 (THE INVERSION, 2026-07-14): is [name] a DEFINER shadow — a top-level fn defined in
-- THIS module that reuses a single-param interface method's name?  This is the exact
-- predicate that decides whether the inversion applies (Fork 1: definer-only).
--
-- ⚠️ It is NOT the same question as "did we reach inferDefinerShadowApp".  That entry point
-- (definerShadowArgHead) ALSO fires for an IMPORTER shadow on the mangled emit path, where
-- the mark pass seeded the route with the provider's mangled symbol (`routeLocalSym /= ""`)
-- — see its header.  Inverting on that signal would invert importer shadows too, which
-- Fork 1 forbids: it breaks the everyday `import map` pattern (`isEmpty [1,2]` must still
-- reach `Foldable.isEmpty`).  definerShadowNamesRef holds bare names on EVERY path — the
-- emit path recovers a mangled local funDef through the mangle map (buildDefinerShadows) —
-- and never holds an imported standalone, so it is the reliable definer/importer test.
--
-- The ifaceMethodName conjunct mirrors definerShadowVarHead / definerShadowArgHead's
-- definer disjunct verbatim, so every entry point agrees on which occurrences the
-- machinery owns.  ✅ S-3 / row 26 CLOSED (#54): a multi-TYPARAM interface
-- (`interface Ix a i`) is now IN scope.  The gate used to be singleParamIfaceMethod (a
-- typaram COUNT test), which excused `Ix a i` from every typing entry point and left its
-- occurrences to ordinary dispatch — check/build kept the pre-inversion per-receiver
-- answer while eval resolved the bare name lexically and E-PANICked (SHADOW-SEMANTICS.md
-- S8; the S7 violation d11 pinned).
isDefinerShadow : ModuleCtx -> String -> Bool
isDefinerShadow mctx name =
  ifaceMethodName mctx name
    && omHasKey name mctx.mcCells.definerShadowNamesRef.value

-- S2 (THE INVERSION, 2026-07-14; SHADOW-INVERSION-DESIGN.md): True iff the shadow [name]
-- applied to a receiver of type [xt] should DISPATCH to the interface method rather than
-- call the standalone.
--
-- ⚠️ FOR A DEFINER SHADOW THE IMPL UNIVERSE IS NO LONGER CONSULTED.  It used to be: a
-- receiver whose head tycon had a visible impl of the shadowed interface dispatched, and the
-- standalone was only a FALLBACK for a no-impl head.  That rule silently ERASED the user's
-- function —
--
--   eq : List Int -> List Int -> Bool
--   eq a b = True
--   main = println (debug (eq [1] [2]))   -- printed False: `impl Eq List` won
--
-- — and `check --types` did not even report the user's signature.  Since the prelude declares
-- ~49 method names over every common type (`map`, `filter`, `length`, `compare`, `eq`, `min`,
-- `empty`, `toList`, `display`, …), that made the most natural names in the language into
-- landmines.  A top-level name written in a module is now THAT MODULE'S NAME: a definer
-- shadow is the standalone, unconditionally, and the argument must type against the
-- standalone's declared domain (a mismatch is a located reject — S2/S3/S6).
--
-- The ONE carve-out (S5, Fork 2): a receiver that is a dict-bound `=>` constraint var of the
-- enclosing function still DISPATCHES.  Writing `Sz a => …` is an explicit, written-down
-- request to resolve through the interface, and there is currently no other way to name the
-- method inside a shadowing module (SHADOW-SEMANTICS.md §1.1).  A grounded head never
-- normalizes to a TVar, so it correctly answers False for every concrete receiver.
--
-- An IMPORTER shadow reaching here (via definerShadowArgHead's mangled-sym arm) keeps the
-- OLD per-receiver rule — Fork 1.
definerReceiverDispatches : DynCtx -> String -> Mono -> Bool
definerReceiverDispatches dyn name xt
  | isDefinerShadow dyn.dcModule name = definerReceiverIsDictVar dyn name xt
  | otherwise = match headTyconMono xt
    -- ARCH B-2.1-g: graph-global, off `bodyImplEnvRef` — see `ieImplExistsForHead`.
    -- The guard above means only the Fork-1 IMPORTER arm reaches here.
    Some head =>
      ieImplExistsForHead
        dyn.dcModule
        dyn.dcModule.mcCells.bodyImplEnvRef.value
        name
        head
    None => definerReceiverIsDictVar dyn name xt

-- P0-19 (constrained-receiver arm): True iff an UNGROUNDED definer-shadow receiver is
-- one of the ENCLOSING group's `=>`-constraint variables for the SHADOWED interface (or
-- a superinterface of it).  Such an occurrence dispatches through that dict — it is a
-- METHOD call, not the standalone — so it must be typed against the method scheme and
-- must NOT have the standalone's declared domain imposed on it.
--
-- Without this, ANY constrained function that calls the method on its own dict-bound
-- var, in a program where some top-level fn shadows that method's name, is silently
-- monomorphised to the shadow's domain.  That includes the PRELUDE's own bodies: on the
-- flat single-file path `prog` is core ++ user, so a user `eq : Int -> Int -> Int`
-- made core's `neq : Eq a => a -> a -> Bool` (`neq x y = not (eq x y)`) infer `eq x y :
-- Int` and reject with `Type mismatch: Bool vs Int` at the top of the user's file.
-- A higher-kinded receiver `t a` reads the written constraint on `t`.
definerReceiverIsDictVar : DynCtx -> String -> Mono -> Bool
definerReceiverIsDictVar dyn name xt = match headMonoNode xt
  TVar cell => match methodEntryHere dyn.dcModule name
    Some (mIface, _, _, _) =>
      dictVarSatisfiesIface
        dyn.dcModule
        mIface.irName
        (tyvarId cell)
        (groupMonos dyn)
    None => False
  _ => False

-- The enclosing group's constraint monos; empty outside a group (a tail body).
groupMonos : DynCtx -> List (String, Mono)
groupMonos dyn = match dyn.dcGroup
  None => []
  Some group => group.gcMonos

-- does any of the group's constraint vars BOTH normalize to tyvar [id] AND carry an
-- interface whose (self + transitive supers) closure includes [mIface]?
dictVarSatisfiesIface : ModuleCtx ->
  String ->
  Int ->
  List (String, Mono) ->
  Bool
dictVarSatisfiesIface mctx _ _ [] = False
dictVarSatisfiesIface mctx mIface id ((cIface, cm) :: rest)
  | monoIsTyvarId cm id && contains mIface (ifaceSelfAndSupers mctx cIface) =
    True
  | otherwise = dictVarSatisfiesIface mctx mIface id rest

-- P0-19: impose a definer-shadow standalone's declared domain on the actual argument
-- [xt] WHEN the occurrence resolves to the standalone (RLocal).  No declared signature ⇒
-- nothing to enforce (permissive fallback, unchanged).  [dloc] locates the check at the
-- application so a mismatch localizes to the call, not the argument.
--
-- S2 (THE INVERSION): a definer shadow now ALWAYS resolves to the standalone, so its domain
-- is ALWAYS enforced.  This used to skip enforcement whenever the receiver's grounded head
-- had a visible impl of the shadowed interface — that head dispatched, so no domain applied.
-- That skip is precisely what let `eq [1] [2]` sail through `check` against the PRELUDE's
-- `Eq.eq` while the user's `eq : List Int -> List Int -> Bool` was discarded.  The only
-- surviving exemption is the Fork-2 dict-var carve-out: imposing a concrete domain on the
-- enclosing group's `=>`-constraint var would monomorphise its written signature.
-- #1815: [k] is the interface's dispatch index, so the domain imposed on the receiver is
-- the standalone's k-th parameter.  `k = 0` is the pre-#1815 behavior verbatim (the
-- bare-head arms pass it, and both of this function's callers now name the index).
enforceStandaloneDomainAt : TcEnv -> String -> Mono -> Option Loc -> Int -> Unit
enforceStandaloneDomainAt env name xt dloc k =
  match standaloneShadowDomainAt env.teDyn.dcModule name k
    None => ()
    Some dom =>
      if definerReceiverIsDictVar env.teDyn name xt then
        ()
      else
        unifyStandaloneDomain env.teDyn dom xt dloc

-- P0-20 (SILENT WRONG ANSWER, `eq 1 2` → the binary printed 0): typecheck's
-- dispatch-vs-standalone decision and the POST-inference route resolver
-- (resolveRLocalSite) must ask the S2 impl question about the SAME receiver head.
--
-- They did not.  A definer-shadow receiver that is not yet grounded AT INFERENCE TIME —
-- a NUMERIC LITERAL is the everyday case, it is `Num a => a`, not `Int` — took the
-- ungrounded arm (S5 ⇒ standalone) and was typed against the standalone's scheme.  That
-- typing then UNIFIES the standalone's declared domain into the receiver, so by the time
-- resolveRLocalSite runs the receiver IS grounded — to `Int` — and `Int` has `impl Eq
-- Int`, so the route resolver left the site to DISPATCH.  Result: `check` typed
-- `eq 1 2 : Int` (the user's `eq : Int -> Int -> Int`) while eval/emit called the
-- interface method and produced a `Bool` — `run` panicked (`intToString: not an Int`)
-- and `build` SILENTLY PRINTED 0.  Only literal receivers were affected: `f k = eq k 1`
-- (k : Int, already grounded) dispatched consistently on all three paths.
--
-- Fix: perform S5's monomorphisation FIRST (it is the same unification the standalone
-- arm would have done, only earlier), then decide.  With the receiver grounded to `Int`,
-- S2 sees the impl and DISPATCHES on every path — check == run == build.  A grounded
-- receiver, a dict-bound one, and an unsignatured standalone (no domain to ground to)
-- are all untouched; so is a standalone whose domain head has NO impl of the shadowed
-- interface (`compiler/frontend/parser.mdk`'s `orElse : Parser a -> Parser a -> Parser a`
-- against `Alternative.orElse` — the compiler declares no `impl Alternative Parser`).
--
-- [dom] MUST come from shadowDomainFor, not standaloneShadowDomain: on the MANGLED emit
-- path the standalone was renamed `<mid>__eq`, so the bare-name sig table is empty there
-- and grounding would be silently inert — which is not a no-op, it flips the emit path to
-- the STANDALONE arm while check/run dispatch.  (Observed: `build` printed 3, `run`
-- printed False.)  Same bug, other direction.
groundShadowReceiver : DynCtx ->
  Option Mono ->
  Mono ->
  Bool ->
  Option Loc ->
  Unit
groundShadowReceiver dyn dom xt isDictVar dloc
  | isDictVar = ()
  | isSome (headTyconMono xt) = ()
  | otherwise = match dom
    None => ()
    Some d => unifyStandaloneDomain dyn d xt dloc

-- P0-20: the definer-shadow standalone's declared domain, resolved on EITHER path.
-- Un-mangled run/check (sym == ""): the module's own sig table, keyed by the bare name.
-- Mangled emit (sym /= ""): private_mangle renamed the standalone to `<mid>__name`, so
-- definerShadowSigsRef has no `name` entry — take the domain off the env binding for the
-- mangled symbol, whose value descriptor also supplies the selected occurrence.
-- #1815: [k] is the interface's dispatch index; `k = 0` is the pre-#1815 behavior.
shadowDomainForAt : TcEnv -> String -> String -> Int -> Option Mono
shadowDomainForAt env name "" k =
  standaloneShadowDomainAt env.teDyn.dcModule name k
shadowDomainForAt env _ sym k = match lookupVar env sym
  None => None
  Some s => nthFunDomain k (instantiate env.teDyn.dcModule s)

-- unify the standalone domain against the argument at the call's location.
unifyStandaloneDomain : DynCtx -> Mono -> Mono -> Option Loc -> Unit
unifyStandaloneDomain dyn dom xt dloc = unifyIn (dynAt dloc dyn) dom xt

-- a definer-shadow standalone's declared parameter type, freshly instantiated (so a
-- polymorphic standalone domain does not leak vars across sites).  None when there is
-- no top-level signature, or the signature is not a function type.
-- #1815: [k] is the interface's dispatch index — the standalone's k-th declared
-- parameter is the one the receiver occupies.  `k = 0` is the pre-#1815 behavior.
standaloneShadowDomainAt : ModuleCtx -> String -> Int -> Option Mono
standaloneShadowDomainAt mctx name k =
  match omLookup name mctx.mcCells.definerShadowSigsRef.value
    None => None
    Some ty => nthFunDomain k (instantiate mctx (sigToScheme mctx ty))

-- P0-19 d4b (S4): a definer-shadow occurrence in bare VALUE position (NOT the head of
-- its own application — dcShadowHeadCtx is False) denotes the STANDALONE.  Returns the
-- standalone's declared scheme freshly instantiated so a HOF sees `Int -> Int`, not the
-- permissive method scheme `a -> Int` — making `map size [Box …]` a located reject
-- (Box vs Int) while `map size [1,2,3]` still accepts.  Only fires for a single-param
-- interface-method name that is a module-local standalone WITH a declared signature;
-- everything else (app head, non-shadow, unsignatured standalone) returns None → the
-- ordinary env lookup / method scheme, unchanged.
-- #411 (row 21, S4): the IMPORTER half of the same cell.  S4 is not keyed on where the
-- standalone lives — a value-position shadow denotes the standalone whether this module
-- DEFINED it or IMPORTED it — so the definer arm below is followed by the importer arm,
-- reading the imported standalone's scheme from the lexical binding descriptor
-- (the same scheme inferShadowApp's standalone arm uses).
--
-- Fork 1 is not touched.  This arm is gated on dcShadowHeadCtx = False, i.e. bare
-- VALUE position only; every APPLIED importer occurrence goes through inferShadowApp,
-- which now flags its head (inferShadowAppHead) exactly as the definer path always did.
-- So per-receiver importer dispatch (i4's `isEmpty [1, 2]` → `Foldable.isEmpty`) is
-- unchanged — rows 15-20/22 do not move.
--
-- #54: the definer arm is gated on ifaceMethodName (typaram-agnostic) and the importer arm
-- on singleTyparamIfaceMethod (Fork 1's per-receiver scope) — the guards are now per-arm,
-- where they used to share one leading singleParamIfaceMethod test.
maybeStandaloneValueMono : TcEnv -> String -> Option Mono
maybeStandaloneValueMono env name =
  map
    (value =>
      let _ = rejectAdmittedValueOccurrence env.teDyn.dcModule name
      (instantiateStandaloneOccurrence
        env
        name
        ""
        env.teDyn.dcModule.mcLoc
        value).svoInstance.mtiBody)
    (standaloneValueBinding env name)

-- S2-DECL (d) for a VALUE occurrence of an importer shadow (`ap2 mth`, `g = mth`,
-- `flip mth`): no argument is applied, so no admitted declaration's own receiver can be
-- evaluated, and with two or more admitted the declarations have not been shown to
-- agree.  That is the located reject, in every import order.  The standalone still
-- types the occurrence, as at the applied arms' reject.  A definer shadow denotes its
-- own module's standalone and is never ambiguous.
rejectAdmittedValueOccurrence : ModuleCtx -> String -> Unit
rejectAdmittedValueOccurrence mctx name
  | isDefinerShadow mctx name = ()
  | otherwise =
    let ifs = methodAdmittedHere mctx name
    if listLen ifs >= 2 then pushAmbiguousShadowDecl mctx name ifs mctx.mcLoc

instantiateStandaloneOccurrence : TcEnv ->
  String ->
  String ->
  Option Loc ->
  ValueScheme ->
  SelectedValueOccurrence
instantiateStandaloneOccurrence outer name sym origin value =
  let env = envAt origin outer
  let inst = instantiateValueTracked env.teDyn.dcModule name value.vsScheme
  let declared =
    declaredEffectsAt env.teDyn.dcModule.mcGraph inst value.vsDeclared
  let _ = match declared
    Some dc =>
      recordDeclaredBindingCall
        env.teDyn.dcModule
        dc
        inst.mtiSubstitution.misTypeSubst
    None =>
      recordShadowStandaloneObls env name inst.mtiSubstitution.misTypeSubst
  let key = if sym == "" then name else sym
  let dc = optionOr (shadowDeclaredFor env.teDyn.dcModule name key) declared
  SelectedValueOccurrence {
    svoScheme = value.vsScheme,
    svoInstance = inst,
    svoDicts =
      shadowStandaloneDictSlots
        env.teDyn.dcModule.mcGraph
        dc.cdSlots
        dc.cdArgs
        inst.mtiSubstitution.misTypeSubst,
  }

standaloneValueBinding : TcEnv -> String -> Option ValueScheme
standaloneValueBinding env name
  | env.teDyn.dcShadowHeadCtx = None
  | ifaceMethodName env.teDyn.dcModule name
    && omHasKey name env.teDyn.dcModule.mcCells.definerShadowNamesRef.value =
    lookupStandaloneValue env name
  | not (singleTyparamIfaceMethod env.teDyn.dcModule name) = None
  | otherwise = lookupStandaloneValue env name

-- #410/#669 (S4, EMIT path only): the sym-recovering peer of maybeStandaloneValueMono,
-- for the marked (EMethodAt) value-position occurrence whose bare name maybeStandaloneValueMono
-- can no longer see because the mangler renamed the definer standalone's funDef to
-- `<mid>__name`.  The signal is PER-OCCURRENCE, not graph-wide: rewriteArgScoped (:7937)
-- seeds the tagRef route with `RLocal <mangled>` for EXACTLY the value-position standalone
-- shadows (the `sm` mangled-shadow map), while an ordinary return/arg-position method value
-- gets `RNone` — so a non-empty routeLocalSym is the mark pass's own "this occurrence is a
-- standalone shadow" verdict, and keying on it (not on the whole-graph `standaloneValuesRef`)
-- is what keeps this from pinning the compiler's genuine method-values and breaking dispatch.
-- The scheme is recovered by `standaloneSchemeFor`: an IMPORTER shadow via
-- its lexical binding descriptor, a DEFINER shadow via the env under that mangled sym — the same
-- accessor recordRLocalSite already trusts to compute this site's RLocal dicts.  Value-position
-- ONLY (dcShadowHeadCtx False, mirroring maybeStandaloneValueMono's first guard); an
-- application head is bracketed True by inferShadowAppHead / inferDefinerShadowApp and keeps
-- ordinary per-receiver dispatch.  None (⇒ caller keeps the method scheme) when the route
-- carries no mangled sym, or when the standalone scheme is unavailable.
-- ⚠️ #724: the gate is PER SHADOW KIND (emitValueShadowGate), mirroring the check-path
-- maybeStandaloneValueMono's per-arm split exactly — NOT one blanket singleTyparamIfaceMethod.
-- The classifier is isDefinerShadow (`omHasKey name definerShadowNamesRef`, the SAME test the
-- check path uses), NOT standalone-scheme availability: that is a
-- scheme-SOURCE question and an importer occurrence may have a scheme here, so keying
-- on it mis-grounds i10's multi-typaram importer app head to a garbage-pointer build.
--   • DEFINER arm (isDefinerShadow): typaram-agnostic, mirroring the check-path definer arm
--     (which grounds a MULTI-typaram definer value position — #724's exact skew: check grounded,
--     emit declined, so `map size [1,2,3]` stamped a null Display element dict and SIGSEGVd).
--     Safe at multi-typaram width because a DEFINER app head is ALWAYS bracketed: it is caught
--     by definerShadowArgHead's isDefinerShadow disjunct (typaram-agnostic) →
--     inferDefinerShadowApp, which sets dcShadowHeadCtx True and types the head via
--     the method scheme or selected standalone occurrence, never inferMethodAt. So the
--     only definer occurrence reaching here with dcShadowHeadCtx False is a genuine value
--     position, which is precisely what must ground (d22z is the app-head control).
--   • otherwise (importer / non-shadow): singleTyparamIfaceMethod is REQUIRED, not incidental.
--     At MULTI-typaram width the importer app-head path (`get (Box 3) 1`, interface `Ix a i`,
--     i10) uses ORDINARY dispatch, so an app head can reach inferMethodAt with dcShadowHeadCtx
--     False AND a mangled route sym — indistinguishable from a value position by those two
--     signals alone.  The check-path importer arm is singleTyparamIfaceMethod-gated (Fork 1)
--     for exactly this reason; keeping the guard here leaves i10's per-receiver dispatch
--     (4 then 3) intact.  Sz/Sizeable are single-typaram, so #410/#669 still pin.
--
-- #410/#669 DIRECTION-2 (deliberately NOT taken): the alternative floor was to leave the type
-- alone and instead make a container element route that resolves to RNone from a genuinely-free
-- var a LOUD `T-AMBIGUOUS-INSTANCE` rather than a silent null dict.  Rejected: an empty
-- container's RNone element is BENIGN (never dereferenced) — `main = println []` is a VALID
-- program that stamps exactly that RNone element — so a fail-loud rule would reject valid code,
-- and the `Undetermined`/KeepNone design (:9899) forbids element-position errors for this reason.
-- Grounding the shadow occurrence's TYPE here (direction 1) closes the actual SIGSEGV vector at
-- its source without that hazard, so the loud-floor was not needed.
standaloneValueBindingEmit : TcEnv -> String -> Ref Route -> Option ValueScheme
-- #2809: keyed on `recoveredShadowSym`, not on the raw seed.  This pin exists to
-- recover a shadow the MANGLER hid; a bare seed hides nothing, and reading one as the
-- old signal fires this emit-only pin on `check`/`run`.
standaloneValueBindingEmit env name tagRef
  | env.teDyn.dcShadowHeadCtx = None
  | recoveredShadowSym name tagRef == "" = None
  | not (emitValueShadowGate env.teDyn.dcModule name) = None
  | otherwise = standaloneValueFor env name (recoveredShadowSym name tagRef)

-- #724: the per-shadow-kind gate for the emit-path value-position pin, mirroring the
-- check-path maybeStandaloneValueMono's per-arm split (definer arm typaram-agnostic; importer
-- arm singleTyparam-scoped, Fork 1).  The definer/importer classifier is isDefinerShadow —
-- `omHasKey name definerShadowNamesRef`, which holds BARE names on EVERY path (the emit path
-- recovers the mangled local funDef through the mangle map, buildDefinerShadows) and NEVER
-- holds an imported standalone, so it is the reliable test (its header, :5717).  ⚠️ It is NOT
-- standalone-scheme availability: that answers a SCHEME-SOURCE question,
-- not a definer/importer classifier — an importer occurrence may have a scheme
-- at this pin, so keying on it mis-grounded i10's multi-typaram importer APP head to a
-- garbage-pointer build (the P0-20 shape).
--   • DEFINER shadow (isDefinerShadow): admit typaram-agnostically.  Safe at multi-typaram
--     width because a definer app head is ALWAYS bracketed by inferDefinerShadowApp
--     (definerShadowArgHead's isDefinerShadow disjunct fires typaram-agnostically), so it
--     reaches standaloneValueBindingEmit with dcShadowHeadCtx True and is declined by that
--     function's first guard — the ONLY definer occurrence reaching the pin with
--     dcShadowHeadCtx False is a genuine value position, which is what must ground.
--   • otherwise (importer or non-shadow): keep singleTyparamIfaceMethod — a MULTI-typaram
--     importer app head (`get (Box 3) 1`, i10) uses ORDINARY dispatch and is NOT bracketed,
--     so it too can reach the pin with dcShadowHeadCtx False and a mangled route sym; the
--     singleTyparam gate is what keeps it (and its per-receiver dispatch, 4 then 3) intact,
--     exactly as the check-path importer arm does.
emitValueShadowGate : ModuleCtx -> String -> Bool
emitValueShadowGate mctx name
  | isDefinerShadow mctx name = True
  | otherwise = singleTyparamIfaceMethod mctx name

-- #411: is [name] an occurrence whose TYPE maybeStandaloneValueMono pins to the
-- standalone?  ⭐ THE ROUTE MUST FOLLOW THE ARM (the P0-20 lesson): a site typed against
-- the standalone must ROUTE to the standalone, or type and route disagree — which is this
-- arc's recurring bug class.  So recordRLocalSite stamps such a site forceLocal, skipping
-- resolveRLocalSite's per-receiver query entirely.  Under S4 there is no receiver to
-- dispatch on, so the query was never meaningful for a value position in the first place.
--
-- For a DEFINER shadow this is behavior-preserving both ways: resolveRLocalSite's grounded
-- arm already forced RLocal, and its ungrounded arm already stamped RLocal for
-- definerShadowNamesRef members.
-- For an IMPORTER shadow it is the #411 fix: the grounded arm used to let a live impl steal
-- the value (row 21b), and the ungrounded arm left the route UNSTAMPED (row 21a) — which is
-- why eval arg-tag-dispatched into the Box impl and the emitter, having no standalone
-- fallback, panicked `no impl of method 'size' for type 'Int'`.
--
-- Mirrors maybeStandaloneValueMono's guards exactly; keep the two in lockstep.
standaloneValuePinned : TcEnv -> String -> Bool
standaloneValuePinned env name = isSome (standaloneValueBinding env name)

-- P0-19: peel an application head to a definer-shadow interface-method occurrence on
-- the UN-MARKED path (the `check` pipeline runs no marker, so the head is a bare
-- `EVar`, not the `EMethodAt` that definerShadowArgHead matches on run/build).  Same
-- guard as definerShadowArgHead's DEFINER disjunct: an interface method (of an interface
-- of ANY typaram arity, #54) whose name is a module-local standalone
-- (definerShadowNamesRef).
definerShadowVarHead : ModuleCtx -> Expr -> Option String
definerShadowVarHead mctx (ELoc _ f) = definerShadowVarHead mctx f
definerShadowVarHead mctx (EVar name)
  | ifaceMethodName mctx name
    && omHasKey name mctx.mcCells.definerShadowNamesRef.value = Some name
  | otherwise = None
definerShadowVarHead mctx (EVarId name _)
  | ifaceMethodName mctx name
    && omHasKey name mctx.mcCells.definerShadowNamesRef.value = Some name
  | otherwise = None
definerShadowVarHead mctx _ = None

-- ── #1815: the dispatch argument is not always argument 0 ───────────────────
-- The two predicates above peel a BARE head, so they only ever fire on the node that
-- supplies argument 0.  For an interface that dispatches at index k > 0 that node is
-- not the dispatch site: `mth n x` is `EApp (EApp mth n) x`, and the receiver is `x`,
-- one node further out.  These two answer the SAME question as their bare-head peers —
-- "is this node a definer shadow's dispatch site?" — for k > 0.
--
-- `shadowSpineNodesAt` is the whole discriminator, and it declines in two ways that
-- keep the pre-existing behavior byte-identical: `[]` nodes (a bare head, k == 0 —
-- the peers below handle it), and a spine whose depth is not the interface's dispatch
-- index (over-applied `mth n x y`, whose OWN inner node is the dispatch site and fires
-- there; or under-applied `mth n` at k == 1, which has no receiver to decide on at all
-- and is left exactly as it is today).
shadowSpineNodesAt : ModuleCtx -> String -> Expr -> Option (List Expr)
shadowSpineNodesAt mctx name f =
  let nodes = appSpineNodes f
  if isEmptyL nodes then
    None
  else match methodDispatchIdx mctx name
    Some k => if k == listLen nodes then Some nodes else None
    None => None

-- #2188: the IMPORTER-path twin, differing in ONE respect — the index it gates on is
-- `importerDispatchIdxOuter`, the OUTERMOST index over the admitted SET, rather than the
-- single admitted winner's.  With two admitted declarations dispatching at different
-- argument positions there are two candidate dispatch NODES, and S2-DECL (b)'s
-- per-declaration (receiver, impl-query) pairs can only be evaluated jointly at the
-- outer one — the inner node has not inferred the outer argument yet.
--
-- ⚠️ The DEFINER arms keep `shadowSpineNodesAt`, deliberately: under the S2 inversion a
-- definer shadow never consults the impl universe, so it has no per-declaration query to
-- evaluate and no reason to move its node.  `importerDispatchIdxOuter` falls back to
-- `methodDispatchIdx` for every name with fewer than two admitted declarations, so this
-- function is `shadowSpineNodesAt` verbatim on every program that exists today.
shadowSpineNodesAtImporter : ModuleCtx -> String -> Expr -> Option (List Expr)
shadowSpineNodesAtImporter mctx name f =
  let nodes = appSpineNodes f
  if isEmptyL nodes then
    None
  else match importerDispatchIdxOuter mctx name
    Some k => if k == listLen nodes then Some nodes else None
    None => None

-- the MARKED (run/build) spine arm — peer of definerShadowArgHead.
definerShadowSpineArgAt : ModuleCtx ->
  Expr ->
  Option (String, Ref (Option Int), Ref Route, Ref (List Route), Ref Inner, Expr, List Expr)
definerShadowSpineArgAt mctx f =
  match definerShadowArgHead mctx (appSpineHead f)
    None => None
    Some (name, arityRef, tagRef, implRef, innerRef) =>
      map
        (nodes =>
          (name, arityRef, tagRef, implRef, innerRef, appSpineHead f, nodes))
        (shadowSpineNodesAt mctx name f)

-- the UNMARKED (`check`) spine arm — peer of definerShadowVarHead.
definerShadowSpineVarAt : ModuleCtx -> Expr -> Option (String, Expr, List Expr)
definerShadowSpineVarAt mctx f =
  match definerShadowVarHead mctx (appSpineHead f)
    None => None
    Some name =>
      map
        (nodes => (name, appSpineHead f, nodes))
        (shadowSpineNodesAt mctx name f)

-- S2 (THE INVERSION): type an un-marked (check-path) definer-shadow application against
-- the module's OWN standalone, unconditionally.  Peer of inferDefinerShadowApp (the marked
-- run/build path); the two must agree cell-for-cell or `check` and the binary diverge (S7),
-- which is the bug class this whole arc keeps producing.
--
-- The receiver's impl universe is no longer consulted (see definerReceiverDispatches).  The
-- sole dispatch arm left is the Fork-2 carve-out: a dict-bound `=>` constraint var, which is
-- an explicit written request to resolve through the interface.  Everything else — grounded
-- live-impl head included — types against the LOCAL standalone scheme, so a domain mismatch
-- (`size (Box 3)` against `size : Int -> Int`) is a located reject at the call, not a silent
-- dispatch that erases the user's function.
inferDefinerShadowVarApp : TcEnv -> String -> Expr -> Expr -> Mono
inferDefinerShadowVarApp env name f x =
  inferDefinerShadowVarAppAt env name f [] f x

-- #1815: the same arm at an arbitrary dispatch index.  [hd] is the spine's ultimate head
-- (which is [f] itself at index 0) and [nodes] the application nodes already applied to
-- it, so `nodes ++ [this node]` is every argument up to and including the receiver.  The
-- head is typed ONCE, here, against the chosen scheme and `inferApp` is folded over the
-- whole prefix — deliberately NOT `infer env f`, which would walk back into the inner
-- node and re-ask the dispatch question about argument 0.
inferDefinerShadowVarAppAt : TcEnv ->
  String ->
  Expr ->
  List Expr ->
  Expr ->
  Expr ->
  Mono
inferDefinerShadowVarAppAt env name hd nodes f x =
  -- the application's location, as in `inferDefinerShadowAppAt`.
  let dloc = appSpanLoc env.teDyn.dcModule.mcLoc (EApp f x)
  let pre = inferSpineArgs env nodes
  let xt = infer env x
  let isDictVar = definerReceiverIsDictVar env.teDyn name xt
  -- P0-20: ground an ungrounded receiver to the standalone's declared domain BEFORE the
  -- dispatch decision (see groundShadowReceiver).  Still load-bearing under the inversion:
  -- it is what gives a bare `Num` literal receiver (`eq 1 2`) the standalone's domain
  -- rather than leaving it open for Num-defaulting to ground LATER, behind typecheck's back.
  -- #1815: the DECLARED DOMAIN THE RECEIVER GROUNDS TO IS THE k-TH ONE, not the first.
  let _ =
    groundShadowReceiver
      env.teDyn
      (standaloneShadowDomainAt env.teDyn.dcModule name (listLen pre))
      xt
      isDictVar
      dloc
  if isDictVar then
    inferAppNodes
      env
      (shadowVarHeadMethodScheme env name hd)
      (pre ++ [(EApp f x, xt)])
  else
    inferDefinerStandaloneVarAppAt env name hd pre f x xt dloc

-- P0-19 (d8 dispatch arm): the interface METHOD scheme for [name], from
-- methodEntryHere (which spans imported interfaces) so per-receiver dispatch works
-- even when the multi-module env has rebound the bare name to the local standalone.
-- Falls back to `infer env f` (flagged as an app head so maybeStandaloneValueMono does
-- not pin it) when the method type is unavailable.
shadowVarHeadMethodScheme : TcEnv -> String -> Expr -> Mono
shadowVarHeadMethodScheme env name f =
  match methodEntryHere env.teDyn.dcModule name
    -- #822: this elaborates an interface METHOD type, so it must use the stored graded
    -- scope.  Unscoped (`sigToScheme ty`) a graded method's index came out as a plain
    -- tyvar here while its real scheme has a row there, and `unify` binds the two without
    -- complaint — a silent divergence between two elaborations of the SAME signature.
    -- Co-locating the scope with `ty` is what makes this a one-token fix instead of a
    -- second lookup that could disagree.
    Some (_, _, ty, scope) =>
      forceInstantiation
        env.teDyn.dcModule
        name
        (instantiateMethodTracked
          env.teDyn.dcModule
          (fst (sigToSchemeTvsIn env.teDyn.dcModule scope ty)))
    None => infer (shadowHeadEnv env) f

-- P0-19 (standalone arm): type the application against the LOCAL standalone scheme so
-- the result is the standalone's (S2/S5); a domain mismatch (`size "hi"`) or a wrapper
-- generalized over the shadow receiver then called at a foreign type localizes to the
-- call [dloc].  No declared signature ⇒ fall back to the permissive method-scheme head
-- + enforceStandaloneDomain (the pre-P0-19 permissive behavior, unchanged).
-- #1815: [pre] is the spine's already-applied (node, type) prefix — `[]` at dispatch
-- index 0, where every line below reduces to the single-argument form it had before.
inferDefinerStandaloneVarAppAt : TcEnv ->
  String ->
  Expr ->
  List (Expr, Mono) ->
  Expr ->
  Expr ->
  Mono ->
  Option Loc ->
  Mono
inferDefinerStandaloneVarAppAt env name hd pre f x xt dloc =
  match standaloneOccurrence env name "" (orElseLoc (appSpineHeadLoc f) dloc)
    Some occurrence =>
      let _ = recordStandaloneAt env.teDyn.dcModule name hd occurrence
      -- #1815: consume the WHOLE applied prefix, not just the receiver.  Unifying the
      -- standalone's declared type against `TFun xt … r` when the receiver is argument 1
      -- is what equated `Int -> Int -> Int` (the standalone) with `b -> r` (the annotated
      -- `wrap`'s second parameter) and monomorphised the user's written signature.
      unifySpineResult
        (envAtIfSome dloc env)
        f
        occurrence.svoInstance.mtiBody
        (pre ++ [(x, xt)])
    None =>
      let ft = infer (shadowHeadEnv env) hd
      let _ = enforceStandaloneDomainAt env name xt dloc (listLen pre)
      inferAppNodes env ft (pre ++ [(EApp f x, xt)])

-- the dict slots ONLY — no call obligations.
-- recordRLocalSite needs this: it fires for EVERY shadow method occurrence, at a point
-- where the standalone-vs-dispatch choice is NOT yet made (resolveRLocalSite decides it
-- post-inference from the grounded receiver).  Recording an obligation here would fire on
-- the DISPATCH arm too and spuriously reject `size (Box 3)` with `Num Box`.  When the
-- receiver does turn out to have an impl, resolveRLocalSite leaves these slots
-- unsolved and the route dispatches as before.
--
-- [name] is the BARE name and [key] the binding symbol (mangled on the emit path).
-- Both are needed: the tables below are keyed by the binding, while the definer/importer
-- classifier `isDefinerShadow` reads `definerShadowNamesRef`, which holds bare names on
-- every path.  Passing [key] to that classifier makes it silently answer False for every
-- mangled occurrence — see `shadowDeclaredFor`.
shadowStandaloneDictSlotsAt : DynCtx ->
  Option ValueScheme ->
  String ->
  String ->
  Mono ->
  ShadowDicts
shadowStandaloneDictSlotsAt dyn None _ _ _ = emptyShadowDicts
shadowStandaloneDictSlotsAt dyn (Some value) name key xt =
  let inst = instantiateMethodTracked dyn.dcModule value.vsScheme
  let dc =
    optionOr
      (shadowDeclaredFor dyn.dcModule name key)
      (declaredEffectsAt dyn.dcModule.mcGraph inst value.vsDeclared)
  if isEmptyL dc.cdSlots then
    emptyShadowDicts
  else
    let _ = unifySpineProbe dyn inst.mtiBody [xt]
    shadowStandaloneDictSlots
      dyn.dcModule.mcGraph
      dc.cdSlots
      dc.cdArgs
      inst.mtiSubstitution.misTypeSubst

-- #2722: a DEFINER SHADOW's own standalone, resolved from ITS module's table rather than
-- through the import-keyed dispatch.  `declaredConstraintFor` / `declaredConstraintIds`
-- cannot answer this case: a definer shadow's bare name is in `currentImportDefinersRef`
-- BY CONSTRUCTION (selectively importing the method it shadows is what makes it a shadow),
-- so #739's source-exact arm fires and reports "genuinely unconstrained in its source
-- module" — the right answer about the IMPORT, the wrong answer about the local binding
-- the occurrence already resolved to.  The result was `[]` dict slots against a definition
-- that takes one, i.e. a call under-applied by exactly its dict parameter: `run` E-PANICked
-- `intToString: not an Int` and the built binary printed a partial-application POINTER, a
-- different one every execution, at exit 0.
--
-- Scoped to the definer-shadow case only: one bare name with two bindings is the missing
-- per-occurrence discriminator #1898/#1899 name, and this does not re-key anything.
--
-- [P-NO-MARK-PASS]: [key] is only ever mangled post-mark-pass, which no production verb
-- runs, so [name] and [key] coincide on every reachable caller today — the [name]/[key]
-- split above is correct by construction but currently unwitnessable by any gate.
shadowDeclaredFor : ModuleCtx -> String -> String -> CDeclared
shadowDeclaredFor mctx name key
  | isDefinerShadow mctx name = localDeclaredConstraintFor mctx key
  | otherwise = declaredConstraintFor mctx key

-- the standalone's dict ROUTE slots for this call: its declared constraint ids mapped
-- through the call's instantiation subst.  Deduplicated EXACTLY as inferDictAtFound
-- does — dictArityOf sizes the DEFINITION's leading dict params from the same
-- declared table, so call and def must agree slot-for-slot or we have
-- merely moved the arity disagreement.  Empty on the plain `check` path
-- (funConstraintsRef is empty there) — check stamps no routes, so that is correct;
-- recordStandaloneSigObligations is what gives `check` its reject direction.
--
-- 🚨 FIX-shadow-arity-skew: "EXACTLY as inferDictAtFound does" is a claim about the
-- (slot, VECTOR) pairs fed to the fixpoint, NOT about the slot list alone, and this is
-- where that distinction was paid for.  This expanded via `expandSupersPairs`, which
-- pairs every slot with a constant `[]`; once S-slot-key-vector (#1866) re-keyed
-- `dedupSlotVecs` on the WHOLE PREDICATE, `(Ix a Char, Ix a Bool) => …` opened TWO slots
-- on the definition side (`expandSupersEntry`, which `dictArityOf` sizes from) and this
-- call side still collapsed them to ONE — 1 dict passed to a 2-dict definition.  Measured
-- on the packet's reproducer at `e19298f5`: `check` exit 0, `run` E-PANIC
-- "intToString: not an Int", `build` exit 0 printing a DIFFERENT heap pointer every
-- execution, wasm "illegal cast".  Take the vectors from the same `declaredConstraintFor`
-- entry the slots came from, or re-open it.
shadowStandaloneDictSlots : GraphCtx ->
  List CSlot ->
  List (List Mono) ->
  List (Int, Mono) ->
  ShadowDicts
shadowStandaloneDictSlots gctx slots args subst =
  if isEmptyL slots then
    emptyShadowDicts
  else
    let expandedV = dedupSlotVecs (zipSlotVecs slots args)
    let expanded = map fst expandedV
    -- the ROUTE half stays a SPELLING, exactly as `inferDictAtFound`'s `pushDictApp`
    -- does — route words, not identities (see `dispHeadTab`).
    -- [sdArgVecs] is `callArgVecsV` over the SAME expansion against the SAME subst, so it
    -- is slot-parallel to [sdMonos] by construction (that function's own header states
    -- the invariant and the shared drop rule that preserves it).
    ShadowDicts {
      sdMonos = constraintMonosOf (map (sl => sl.csId) expanded) subst,
      sdIfaces = map (sl => sl.csIface) expanded,
      sdArgVecs = callArgVecsV gctx expandedV subst,
    }

-- the tyvar NAME a constraint argument mentions (`Num a` → "a"); None for a non-tyvar
-- argument (a concrete head), which carries no per-call obligation here.
constraintArgVarName : Ty -> Option String
constraintArgVarName (TyVar v) = Some v
constraintArgVarName _ = None

-- peek through an ELoc wrapper to a lambda; returns its loc, params and body.
-- Non-lambda arguments (the common case) take the ordinary inference path.
lamUnderLoc : Expr -> Option (Option Loc, List Pat, Expr)
lamUnderLoc (ELam pats body) = Some (None, pats, body)
lamUnderLoc (ELoc l (ELam pats body)) = Some (Some l, pats, body)
lamUnderLoc _ = None

-- the function's first parameter type (the lambda's expected type), or a fresh
-- var when `ft` is not yet a concrete arrow (then nothing is pushed; the trailing
-- `unify ft (TFun xt …)` reconciles).
funDomain : ModuleCtx -> Mono -> Mono
funDomain mctx (TFun a _ _) = a
funDomain mctx _ = freshVar mctx ()

-- like inferLam, but checked against the arrow [expected] it flows into, when
-- one is known: each lambda param is unified with the corresponding expected
-- param type right after inferPat — so the body and the hover side-channel see
-- the expected type, not a bare fresh var — and the body flows into the
-- expected result (`checkedInto`).
inferLamChecked : TcEnv -> Option Mono -> List Pat -> Expr -> Mono
inferLamChecked env expected pats body =
  fst (inferBindingChecked True env expected pats body)

-- [judge] says the patterns are a lambda's own; a method clause's patterns are
-- one row of its method's clauses, which are judged together.
inferBindingChecked : Bool ->
  TcEnv ->
  Option Mono ->
  List Pat ->
  Expr ->
  (Mono, EffRow)
inferBindingChecked judge env expected pats body =
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPats env pats
  let arity = listLen pats
  let _ = match expected
    Some want =>
      unifyParamsExpected env.teDyn (fst pr) (expectedParamTypes want arity)
    None => ()
  let scope =
    openExistentialScope
      env.teDyn.dcModule
      (takeOpenedExistentials env.teDyn.dcModule ())
  let _ = settlePatLits env.teDyn lits
  let _ = if judge then checkBinderPats env (fst pr) pats
  let _ = match expected
    Some want => recordClauseFileBound env.teDyn.dcModule body arity want
    None => ()
  let (bodyTy, bodyEff) = captureEffects
    env.teDyn.dcModule.mcCells.curEffect
    (joinCellOf env.teDyn.dcModule.mcGraph)
    (_ =>
      let bodyEnv = extendLocalVars env (snd pr)
      let actual = infer bodyEnv body
      match expected
        Some want => match resultAfterArrows arity want
          Some result => checkedInto bodyEnv body result actual
          None => actual
        None => actual)
  let _ = closeExistentialScope env.teDyn.dcModule scope bodyTy (exprLoc body)
  let force = if isEmptyL pats then bodyEff else pureRow
  (arrowsWithLastEffect (fst pr) bodyEff bodyTy, force)

-- Chunk C: number of arguments applied in this spine (`f a b c` ⇒ 3).
appSpineArgCount : Expr -> Int
appSpineArgCount (ELoc _ e) = appSpineArgCount e
appSpineArgCount (EDoOrigin _ e) = appSpineArgCount e
appSpineArgCount (EAnnot e _) = appSpineArgCount e
appSpineArgCount (EApp f _) = 1 + appSpineArgCount f
appSpineArgCount _ = 0

-- #894 review finding 1: is `appExpr`'s own callee EXACTLY the synthesized
-- `andThen` `lowerDo` builds for a `do`-bind (`callAndThen`,
-- `compiler/frontend/desugar.mdk`)?  A STRUCTURAL check off the one node
-- `inferApp` was actually called for — no ambient/dynamic flag (the first cut
-- of this fix used callee-name + the do-origin context, which also lit up on a
-- user's own explicit `andThen` call textually nested inside a do-bind's
-- scrutinee, e.g. `x <- andThen b f`; that call is neither `lowerDo`'s callee
-- nor wants the `let`-instead-of-`<-` advice).  `callAndThen` tags ONLY the
-- callee it itself constructs, so no user-authored `andThen` occurrence — no
-- matter where it sits — can ever carry this wrapper.
isDoLoweredAndThenCallee : Expr -> Bool
isDoLoweredAndThenCallee (EApp callee _) = isDoLoweredAndThenCalleeExpr callee
isDoLoweredAndThenCallee _ = False

isDoLoweredAndThenCalleeExpr : Expr -> Bool
isDoLoweredAndThenCalleeExpr (ELoc _ e) = isDoLoweredAndThenCalleeExpr e
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVar "andThen")) = True
-- `defer` blocks (#824) lower through the same `callAndThen` with `deferThen`
-- as the bind method, so they get the same tailored reframing.
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVar "deferThen")) = True
-- `resolve` rewrites every surviving `EVar` to `EVarId name id` (a stable
-- per-binding identity) — by the time `inferApp` runs, the callee `lowerDo`
-- tagged is `EVarId "andThen" _`, not the raw `EVar` it started as. Debugged
-- with `medaka check` + a one-off shape dump: the untagged-`EVar` arm above
-- never actually fires post-resolve; keep it anyway as the honest pre-resolve
-- shape (harmless — `EDoOrigin _ (EVar "andThen")` just never matches here).
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVarId "andThen" _)) = True
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVarId "deferThen" _)) = True
-- #2705: the mark pass runs on every driver before inference, and `andThen` /
-- `deferThen` are interface methods, so `lowerDo`'s callee reaches `inferApp` as
-- the marked occurrence shape; the wrapper is the same.
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EMethodAt "andThen" _ _)) = True
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EMethodAt "deferThen" _ _)) = True
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EDictAt "andThen" _)) = True
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EDictAt "deferThen" _)) = True
isDoLoweredAndThenCalleeExpr _ = False

-- P0-16 beginner call-syntax hint.  A newcomer writes `add(1, 2)` (C/Python/JS
-- call syntax) meaning `add 1 2`; in Medaka `(1, 2)` is a TUPLE, so `add(1, 2)`
-- applies `add` to ONE tuple argument → a partial application / no-impl error
-- whose message ("No impl of Display for ((Int, Int) -> (Int, Int))") is
-- inscrutable.  We DETECT the shape at the application site — a curried arity-N
-- function applied to a single arity-N tuple literal whose first param is NOT
-- itself an N-tuple — and record the residual result type as a candidate; the
-- no-impl + type-mismatch surface sites then append the tailored hint when the
-- offending type IS that residual.  Recording is generous (a legitimate partial
-- application like `map (const (1, 2)) xs` also records) but the hint is only
-- ever ATTACHED to a genuine downstream error, so a legit partial application —
-- whose residual is consumed WITHOUT error — never shows it.  (residualMono,
-- help, optional (span, replacement) fix); reset by `freshModuleCtx`.

-- the elements of a tuple-literal argument (through the transparent ELoc wrapper).
tupleArgElems : Expr -> Option (List Expr)
tupleArgElems (ELoc _ e) = tupleArgElems e
tupleArgElems (ETuple es) = Some es
tupleArgElems _ = None

-- source span covering the whole `name(args)` call: callee start → tuple end.
tupleCallSpanLoc : Expr -> Expr -> Option Loc
tupleCallSpanLoc f x = match (exprLoc f, exprLoc x)
  (Some (Loc file sl sc _ _), Some (Loc _ _ _ el ec)) =>
    Some (Loc file sl sc el ec)
  _ => None

-- build the (help, optional fix) for a detected tuple-call.  The help names the
-- rule (Medaka calls with spaces, `(…)` is a tuple) and gives the exact rewrite;
-- when every element renders, a machine-applicable `fix` rewrites `add(1, 2)` →
-- `add 1 2` verbatim.  ERROR-QUALITY: located (caller sets loc), names the issue,
-- actionable fix, carries a code (T-NO-IMPL / T-TYPE-MISMATCH at the surface site).
buildTupleCallHint : String ->
  List Expr ->
  Expr ->
  Expr ->
  (String, Option (Loc, String))
buildTupleCallHint name es f x = match renderCallArgs es
  Some parts =>
    let argsCsv = joinWith ", " parts
    let argsSpaced = joinWith " " parts
    let spread = "\{name} \{argsSpaced}"
    let help =
      "Medaka calls functions with spaces, not parentheses: `\{name}(\{argsCsv})` passes the single tuple `(\{argsCsv})`; did you mean `\{spread}`?"
    let fix = map (span => (span, spread)) (tupleCallSpanLoc f x)
    (help, fix)
  None =>
    let n = listLen es
    let help =
      "Medaka calls functions with spaces, not parentheses: `\{name}(...)` passes one \{intToString n}-tuple, not \{intToString n} arguments; separate them with spaces, as in `\{name} x y`"
    (help, None)

-- detect the tuple-call shape on the PRISTINE ft (before inferApp) and return the
-- (help, fix) to record against the residual result type, else None.  Fires only
-- when the argument is a tuple literal of arity N ≥ 2, the callee has curried arity
-- EXACTLY N (spreading the tuple would saturate it), and its first param is not
-- itself an N-tuple (the genuine tuple-arg case), and the callee is a named spine.
tupleCallShapeHint : Expr ->
  Expr ->
  Mono ->
  Option (String, Option (Loc, String))
tupleCallShapeHint f x ft = match tupleArgElems x
  None => None
  Some es =>
    let n = listLen es
    if n < 2 then
      None
    else if funArity ft /= n then
      None
    else if domainIsTupleOfArity ft n then
      None
    else
      map (name => buildTupleCallHint name es f x) (appSpineName f)

inferApp : TcEnv -> Expr -> Mono -> Mono -> Mono
inferApp env appExpr ft xt =
  let r = freshVar env.teDyn.dcModule ()
  -- Chunk C: if the callee normalizes to a concrete NON-arrow head (a known type
  -- constructor like `Int`/`List Int`, never a tyvar or an arrow), applying it
  -- is genuinely impossible.  Emit a context-aware `T-NOT-A-FUNCTION` instead of
  -- letting `unify ft (TFun …)` render a leaked `Int vs a -> b` mismatch, and
  -- poison the fresh result var so no secondary obligation cascade fires (reuses
  -- Chunk A's poisoned-var set).  Fires ONLY on a ground non-arrow head: a real
  -- function (`TFun`) or an as-yet-unresolved var (`TVar`) is unaffected.
  match headTyconNameMono ft
    Some _ => inferAppNotFunction env.teDyn.dcModule appExpr ft r
    None => match containerParamScalarArg ft xt
      Some scalarTy =>
        -- Batch B #6: container-consuming HOF handed a scalar.  Reframe here
        -- (callee name + arg loc in scope) instead of letting the generic sink
        -- leak `a b vs String`.  Skip the unify (it would push the leaked
        -- mismatch as a SECOND diagnostic) and poison `r` to suppress cascade.
        --
        -- #894: the SAME shape also fires when this application is a `do`-lowered
        -- `andThen` call (`x <- b` / a bare statement line — `lowerDo`,
        -- `compiler/frontend/desugar.mdk`) whose bound value isn't monadic. That
        -- is not "pass a List or Array" — it is "use `let`, not `<-`". Detected
        -- by AST SHAPE off `appExpr`'s own callee (`isDoLoweredAndThenCallee`,
        -- `callAndThen` tags exactly its synthesized callee), NOT by name +
        -- the do-origin context — review finding 1 on the first cut of this fix: a
        -- name+ambient-state heuristic false-positives on a user's OWN explicit
        -- `andThen` call textually nested inside a do-bind's scrutinee
        -- (`x <- andThen b f`), which is neither `lowerDo`'s callee nor
        -- expecting the `let`-instead-of-`<-` advice.  The shape check can't:
        -- the wrapper is only ever placed on the exact node `lowerDo` builds.
        let isDoBind = isDoLoweredAndThenCallee appExpr
        let msg =
          if isDoBind then
            doBindArgMsg scalarTy
          else
            containerArgMsg (appSpineName appExpr) scalarTy
        let hint =
          if isDoBind then doBindArgHint scalarTy else containerArgHint scalarTy
        let _ =
          pushTypeErrorHelpFixAt
            env.teDyn.dcModule
            "T-TYPE-MISMATCH"
            (orElseLoc (appArgLoc appExpr) env.teDyn.dcModule.mcLoc)
            msg
            hint
            None
        -- Poison the container tyvar + element vars (in ft) exactly as the generic
        -- unify sink would (`monoUnboundIds a ++ b`), so the dangling `Mappable f`
        -- obligation sees a poisoned var and suppresses its own cascade.
        let _ = poisonMismatchVars env.teDyn.dcModule ft xt
        let _ = poisonMismatchVars env.teDyn.dcModule r r
        r
      None =>
        -- Type-error span (Bite 3, fork 3 = ARGUMENT): a wrong-arg-type
        -- mismatch is located at the argument expression rather than the
        -- callee, so `len 5` (len : String -> Int) squiggles the `5`.
        let at = envAtIfSome (appArgLoc appExpr) env
        -- The argument flows INTO the callee's domain, so a closed~closed row
        -- pair there is checked directionally (`unifyInto`): a purer argument in
        -- an effect-allowing slot is accepted, the reverse is not.  A callee whose
        -- type is still a variable has no domain to direct against yet.
        let eff = applicationRow at appExpr ft xt r
        let _ =
          performEffect
            at.teDyn.dcModule
            at.teDyn.dcModule.mcCells.curEffect
            eff
        let _ = notePerformSite env eff
        r

-- Inside a body that collects them (`dcPerformSites`), each variable tail of the
-- row a call runs, with the span of the call: [env] is located at the call.
notePerformSite : TcEnv -> EffRow -> Unit
notePerformSite env eff = match env.teDyn.dcPerformSites
  None => ()
  Some sites =>
    sites :=
      map (cell => (cell, env.teDyn.dcModule.mcLoc)) (snd (rowFlat eff))
        ++ sites.value

-- The argument flows into the callee's domain.  A qualified domain also
-- receives the argument's abstraction as a lower bound of its authority: this
-- is the one route by which an argument determines an effect's parameter,
-- whatever the callee's name, position or implementation.
argumentInto : TcEnv -> Option Expr -> Mono -> Mono -> Unit
argumentInto env arg dom xt = argumentIntoOrd False env arg dom xt

-- [valueFirst] is only the operand order a plain type mismatch names the two
-- sides in: a call argument names the slot first, a supplied record field the
-- value first, as their `unify`s did.
argumentIntoOrd : Bool -> TcEnv -> Option Expr -> Mono -> Mono -> Unit
argumentIntoOrd valueFirst env arg dom xt =
  let _ = match arg
    Some e => recordValueFileBound env.teDyn.dcModule e dom
    None => ()
  match normalize dom
    TQual d q =>
      let _ = unifyIntoOrd env.teDyn valueFirst True d xt
      wantAuthority
        env.teDyn.dcModule
        (argumentAuthority env (authDomainTop q) arg xt)
        q
    _ => unifyIntoOrd env.teDyn valueFirst True dom xt
-- The same judgment for an expression that flows into a declared type rather
-- than a parameter: a signed body into its result, a lambda or method body into
-- the arrow it is checked against. A qualified declared type bounds the
-- expression's abstraction, and the expression then has the declared type, so
-- every use reads the declared qualifier. Any other declared type is left to
-- the caller's own directed check, and [actual] is returned unchanged.
checkedInto : TcEnv -> Expr -> Mono -> Mono -> Mono
checkedInto env e expected actual =
  let _ = recordValueFileBound env.teDyn.dcModule e expected
  match normalize expected
    TQual _ _ =>
      let _ =
        argumentInto (envAtIfSome (exprLoc e) env) (Some e) expected actual
      expected
    _ => actual
argumentAuthority : TcEnv -> Param -> Option Expr -> Mono -> Authority
argumentAuthority env top (Some e) xt =
  let prelude = displayIsPrelude env
  let q = alphaOf top (envVarType env) prelude (envAlphaLets env) e xt
  let _ = noteArgumentShape env top prelude q e xt
  q
argumentAuthority env top None xt = typeAuthority top xt

-- Record, for a report of a bound this argument fails (`boundFailureMsg`),
-- the authority variables it extends on the right, and those it would reach
-- through an interpolated part were `display` the prelude's.
noteArgumentShape : TcEnv -> Param -> Bool -> Authority -> Expr -> Mono -> Unit
noteArgumentShape env top prelude q e xt =
  let lets = envAlphaLets env
  let _ = match extensionBase e
    Some base =>
      markBinders
        env.teDyn.dcModule.mcCells.extendedBindersRef
        (authVars
          (alphaOf
            top
            (envVarType env)
            prelude
            lets
            base
            (tconBuiltin "String")))
    None => ()
  if prelude then
    ()
  else
    let seen = fold (m c => IdMap.set (authvarId c) () m) Tip (authVars q)
    markBinders
      env.teDyn.dcModule.mcCells.displayHiddenBindersRef
      (filterList
        (c => not (IdMap.has (authvarId c) seen))
        (flatMap
          (x => authVars (alphaOf top (envVarType env) prelude lets x xt))
          (displayOperands e)))

markBinders : Ref (Map Int Unit) -> List (Ref Authvar) -> Unit
markBinders table cells =
  table := fold (m c => IdMap.set (authvarId c) () m) table.value cells

-- The operand a concatenation extends on the right: its leftmost part, past
-- the empty literal an interpolation begins with.
extensionBase : Expr -> Option Expr
extensionBase (ELoc _ e) = extensionBase e
extensionBase (e@(EBinOp op _ _ _))
  | op == "++" = Some (leftmostPart e)
extensionBase _ = None

leftmostPart : Expr -> Expr
leftmostPart (ELoc _ e) = leftmostPart e
leftmostPart (e@(EBinOp op a b _))
  | op == "++" = if isEmptyStringLit a then leftmostPart b else leftmostPart a
  | otherwise = e
leftmostPart e = e

-- The operands of the `display` applications a concatenation's parts are,
-- the parts an interpolation converts.
displayOperands : Expr -> List Expr
displayOperands (ELoc _ e) = displayOperands e
displayOperands (EBinOp op a b _)
  | op == "++" = displayOperands a ++ displayOperands b
displayOperands (EApp f x) = if isDisplayHead f then [x] else []
displayOperands _ = []

isDisplayHead : Expr -> Bool
isDisplayHead (ELoc _ f) = isDisplayHead f
isDisplayHead (EVar x) = x == "display"
isDisplayHead (EVarId x _) = x == "display"
isDisplayHead (EVarAt x _) = x == "display"
isDisplayHead (EDictAt x _) = x == "display"
isDisplayHead (EMethodAt x _ _) = x == "display"
isDisplayHead _ = False

isEmptyStringLit : Expr -> Bool
isEmptyStringLit (ELoc _ e) = isEmptyStringLit e
isEmptyStringLit (ELit (LString s)) = s == ""
isEmptyStringLit _ = False

-- Whether `display` in [env] is the prelude `Display` method, the one an
-- interpolated part applies: no local binder, no standalone this module
-- defines or imports, and the method's interface is the prelude's.
displayIsPrelude : TcEnv -> Bool
displayIsPrelude env =
  not (lookupLocalFlag env "display")
    && isNone (lookupStandaloneValue env "display")
    && not
      (omHasKey
        "display"
        env.teDyn.dcModule.mcCells.definerShadowNamesRef.value)
    && (match methodEntryHere env.teDyn.dcModule "display"
      Some (iface, _, _, _) => isPreludeDisplayIface iface
      None => False)

isPreludeDisplayIface : IfaceRef -> Bool
isPreludeDisplayIface iface =
  iface.irName == "Display" && isPreludeOrigin iface.irOrigin

-- The argument node of an application, when the callee's syntax is an
-- application at all; every other node is not one and has no argument to
-- abstract (the catch-all is the projection's negative answer, not an
-- unhandled constructor).
appArgExpr : Expr -> Option Expr
appArgExpr (ELoc _ e) = appArgExpr e
appArgExpr (EApp _ x) = Some x
appArgExpr _ = None

-- All callable eliminations recover the selected arrow's row unchanged.
-- Inference introduces a new row only while the callee's shape is unknown.
-- The caller decides whether invocation happens now or in a composed closure.
applicationRow : TcEnv -> Expr -> Mono -> Mono -> Mono -> EffRow
applicationRow env appExpr ft xt result = match normalize ft
  TFun dom row res =>
    let _ = argumentInto env (appArgExpr appExpr) dom xt
    let _ = bindFrom env.teDyn result res
    row
  _ =>
    let unknown = openRow env.teDyn.dcModule ()
    let _ = unifyIn env.teDyn ft (TFun xt unknown result)
    unknown

-- Chunk C: the applied head is a ground non-function.  If the spine over-applies
-- a named function (callee name known AND at least one arg was consumed before
-- the type went non-arrow) use the arity-aware wording; otherwise fall back to
-- naming the non-function type.  Poison `r` to suppress downstream cascade.
inferAppNotFunction : ModuleCtx -> Expr -> Mono -> Mono -> Mono
inferAppNotFunction mctx appExpr ft r =
  let applied = appSpineArgCount appExpr
  let takes = applied - 1
  -- Reported at the application, not at a construct around it.
  let loc = appSpanLoc mctx.mcLoc appExpr
  let _ = match appSpineName appExpr
    Some name =>
      if takes >= 1 then
        pushTypeError
          (mctxAt loc mctx)
          "T-NOT-A-FUNCTION"
          (overAppliedMsg name takes applied)
      else
        pushTypeErrorHelpFixAt
          mctx
          "T-NOT-A-FUNCTION"
          loc
          (notAFunctionMsgFor (Some name) (ppMono (normalize ft)))
          (notAFunctionHint (Some name))
          None
    None =>
      pushTypeErrorHelpFixAt
        mctx
        "T-NOT-A-FUNCTION"
        loc
        (notAFunctionMsg (ppMono (normalize ft)))
        (notAFunctionHint None)
        None
  let _ = poisonMismatchVars mctx r r
  r

inferLam : TcEnv -> List Pat -> Expr -> Mono
inferLam env pats body =
  -- Patterns carry no source Loc, so a pattern-level type error (e.g. an
  -- over-applied nullary constructor `A _`) is located at THIS clause's body.
  inferLamChecked (envAtIfSome (exprLoc body) env) None pats body

inferLet : TcEnv -> Bool -> Pat -> Expr -> Expr -> Mono
inferLet env isFun pat e1 e2
  | isFun = match pat
    PVar x xloc bid => inferRecLet env x (Some xloc) bid e1 e2  -- #866: binder loc for the pin note
    _ => inferLetSimple env pat e1 e2
  | otherwise = inferLetSimple env pat e1 e2

-- T2: a recursive inline function binding (`let go n = … in …`) must
-- pre-bind `go` with a monomorphic placeholder so the RHS can reference
-- itself, then generalize (a function is a value — oracle `:1668-1681`).

-- Self-recursive inline `let` binding (mirrors blockRecLet + the oracle is_fun
-- arm): placeholder pre-bind, infer body, unify, generalize through the body.
inferRecLet : TcEnv -> String -> Option Loc -> BinderId -> Expr -> Expr -> Mono
inferRecLet outer x xloc bid e1 e2 =
  -- Located at the right-hand side, as `inferLetSimple`.
  let env = envAtIfSome (exprSpanLoc e1) outer
  let _ = checkRecBindNonFunction env.teDyn.dcModule x e1  -- #799
  let _ = enterLevel env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let lscope = openLocalScopeIf env.teDyn.dcModule x
  let (t1, residuals) = inferRecursiveValue env x e1
  let _ = closeLocalScope env.teDyn.dcModule lscope
  let _ = exitLevel env.teDyn.dcModule ()
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let _ = improveLocalGoals env.teDyn addedObls callN0
  let _ = finalizeNumBoundary env.teDyn NumBoundary {
    nbDisposition =
      NumBoundaryOwnedMember
        (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
    nbMembers = [t1],
    nbSurvivingIds = memberTiedSurvivors env.teDyn.dcModule t1 addedObls callN0,
    nbDefaultObls = addedObls,
    nbAmbiguityObls = addedObls,
    nbGuard = localNumGuard env.teDyn.dcModule addedObls callN0,
  }  -- PLAN.md #11 / RETPOS soundness
  let _ = recordLocalBind env.teDyn.dcModule x xloc bid t1  -- LSP hover (recursive PVar let bypasses inferPat)
  let sch =
    genBindingRestricted env.teDyn Tip (residualsOf 0 residuals) True pureRow t1  -- #866
  let _ = registerLocalScheme env.teDyn.dcModule x sch oblN0 callN0 dictN0
  let _ = registerLocalAbsIf env.teDyn.dcModule x lscope sch oblN0 callN0
  infer
    (envAt
      outer.teDyn.dcModule.mcLoc
      (seedAlphaLets (extendLocalVar env x sch) x e1))
    e2  -- WS-2: α scope-seed

-- Recursive local bindings are strict. Their initializer is charged here;
-- recursive occurrences read only the value, never a lazy forcing descriptor.
-- A recursive local is a function, so it generalizes, and its scope keeps
-- residuals over its own quantified authorities.
inferRecursiveValue : TcEnv ->
  String ->
  Expr ->
  (Mono, List (Int, AuthResidual))
inferRecursiveValue env name expr =
  let _ = beginEffectSummaryScope env.teDyn.dcModule ()
  let arity = sourceBindingArity expr
  let owned =
    newBindingSummary
      arity
      (freshVar env.teDyn.dcModule)
      (freshEffectSummary env.teDyn.dcModule)
  let envSelf = extendLocalVar env name (monoScheme owned.bsRecursiveValue)
  let (actual, immediate) = captureEffects
    env.teDyn.dcModule.mcCells.curEffect
    (joinCellOf env.teDyn.dcModule.mcGraph)
    (_ => infer envSelf expr)
  let _ = unifySourceDomains env.teDyn arity owned.bsValue actual
  let _ = publishProducedResults env.teDyn owned [(exprLoc expr, actual)]
  let _ = recordEffectBody env.teDyn.dcModule owned.bsBody (if arity == 0 then
    immediate
  else
    bodyRowAt arity actual)
  let _ = checkRecursiveValue env.teDyn owned
  let residuals = finishValueEffectsKeeping env.teDyn [(True, owned.bsValue)]
  let _ =
    performEffect
      env.teDyn.dcModule
      env.teDyn.dcModule.mcCells.curEffect
      immediate
  (owned.bsValue, residuals)

-- Source arity is the count of syntactic lambda parameters under the transparent
-- wrappers; every other expression is a computation that yields its value when
-- forced, so it has arity 0 even when that value turns out to be a function
-- (a conditional between two lambdas is a thunk producing a closure). The
-- catch-all is that rule, not a set of unhandled constructors.
sourceBindingArity : Expr -> Int
sourceBindingArity (ELoc _ expr) = sourceBindingArity expr
sourceBindingArity (EDoOrigin _ expr) = sourceBindingArity expr
sourceBindingArity (EAnnot expr _) = sourceBindingArity expr
sourceBindingArity (EHeadAnnot expr _) = sourceBindingArity expr
sourceBindingArity (ELetGroup _ expr) = sourceBindingArity expr
sourceBindingArity (ELam pats _) = listLen pats
sourceBindingArity _ = 0

-- Round-2 adversarial break "let-alias evasion" (#816): register a LOCAL
-- binding's generalized scheme obligations exactly as processSCC does for
-- top-level members, so a later use re-instantiates them into the
-- call-obligation window every checker reads.  Before this, `let f = hh`
-- (re-generalizing `hh : Num x => x -> x`) registered NOTHING: the RHS
-- occurrence's obligation stayed on a var generalization then orphaned, Int
-- defaulting satisfied it quietly, and `f x` at a method-scheme var sailed
-- through check into an eval panic / native SEGFAULT.  Name collisions across
-- bodies are safe: obligations are keyed by the scheme's own quantified ids,
-- and substMonos skips ids a different scheme's instantiation does not map.
--
-- A local binding whose scheme keeps class predicates is dictionary-abstracted
-- (`registerLocalAbs`): each use applies it to dictionaries solved at the use, so its
-- constrained vars generalize and defer exactly as described above.
registerLocalScheme : ModuleCtx -> String -> Scheme -> Int -> Int -> Int -> Unit
registerLocalScheme mctx x sch oblN0 callN0 dictN0 =
  let _ = declareQuantified mctx sch
  -- Obligations registered universally (#827/#838 I2); do not gate to IMPL/DEFAULT
  -- bodies only. See docs/spec/DICT-SEMANTICS.md § "4.1 `gen` at a local binder".
  let addedObls = wWindow mctx.mcCells.implObls oblN0
  let callOblsDelta = callOblsWindow mctx callN0
  -- #838 I5: the dict-slot's forwarded obligation is ALREADY in callOblsDelta as the
  -- mirroring PCallSlot obligation recorded at inferDictAtFound (recordCallObligations,
  -- beside pushDictApp), reaching schemeOblsForMember via forwardedVecObls; the old
  -- `allDictObls` re-derivation was a redundant second source (deduped away). Retired.
  registerSchemeObligations mctx omEmpty [] callOblsDelta addedObls [(x, sch)]

-- A generalized local's quantified variables are its uses' to choose, as a
-- signature's are its callers' (DICT-SEMANTICS §3), so they are declared before
-- its context is read off its goals: an instance that answers a goal only by
-- binding one does not discharge it, the goal stays in the scheme, and each use
-- poses it at its own instantiation to the binder enclosing that use.
declareQuantified : ModuleCtx -> Scheme -> Unit
declareQuantified mctx sch =
  declareRigidVars mctx (map intToString (schemeIds sch))

inferLetSimple : TcEnv -> Pat -> Expr -> Expr -> Mono
inferLetSimple outer pat e1 e2 =
  -- The binding's own checks are located at its right-hand side; the body is
  -- the enclosing construct's.
  let env = envAtIfSome (exprSpanLoc e1) outer
  let _ = enterLevel env.teDyn.dcModule ()
  let _ = beginEffectSummaryScope env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let lscope = match pat
    PVar x _ _ => openLocalScopeIf env.teDyn.dcModule x
    _ => None
  let t1 = infer env e1
  let _ = closeLocalScope env.teDyn.dcModule lscope
  let residuals = finishValueEffectsKeeping env.teDyn [
    (patIsVar pat && isNonexpansive env e1, t1),
  ]
  let _ = exitLevel env.teDyn.dcModule ()
  -- PLAN.md #11 / D4: ground an ambiguous Num-only var owned by this inner let
  -- before it generalizes, so `let z = 2 in y + z` (y:Float) is a clean type
  -- error and never leaks an unbound Num var.  Scoped to this binding's new obligations.
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let _ = improveLocalGoals env.teDyn addedObls callN0
  let _ = finalizeNumBoundary env.teDyn NumBoundary {
    nbDisposition =
      NumBoundaryOwnedMember
        (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
    nbMembers = [t1],
    nbSurvivingIds = memberTiedSurvivors env.teDyn.dcModule t1 addedObls callN0,
    nbDefaultObls = addedObls,
    nbAmbiguityObls = addedObls,
    nbGuard = localNumGuard env.teDyn.dcModule addedObls callN0,
  }
  inferLetBody
    env
    outer.teDyn.dcModule.mcLoc
    pat
    t1
    residuals
    e1
    e2
    oblN0
    callN0
    dictN0
    lscope

patIsVar : Pat -> Bool
patIsVar (PVar _ _ _) = True
patIsVar _ = False

-- [env] is located at the binding, [bodyLoc] is the span the body is inferred at.
inferLetBody : TcEnv ->
  Option Loc ->
  Pat ->
  Mono ->
  List (Int, AuthResidual) ->
  Expr ->
  Expr ->
  Int ->
  Int ->
  Int ->
  Option ScopeId ->
  Mono
inferLetBody env bodyLoc (PVar x xloc bid) t1 residuals e1 e2 oblN0 callN0 dictN0 lscope =
  let _ = recordLocalBind env.teDyn.dcModule x (Some xloc) bid t1  -- LSP hover (PVar let bypasses inferPat)
  let sch =
    genBindingRestricted
      env.teDyn
      Tip
      (residualsOf 0 residuals)
      (isNonexpansive env e1)
      pureRow
      t1  -- #866
  let _ = registerLocalScheme env.teDyn.dcModule x sch oblN0 callN0 dictN0
  let _ = registerLocalAbsIf env.teDyn.dcModule x lscope sch oblN0 callN0
  infer (envAt bodyLoc (seedAlphaLets (extendLocalVar env x sch) x e1)) e2  -- WS-2: α scope-seed
inferLetBody env bodyLoc pat t1 _ _ e2 _ _ _ _ =
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPat env pat
  let _ = unifyIn env.teDyn (fst pr) t1
  let _ = settlePatLits env.teDyn lits
  let _ = checkBinderPat env (fst pr) pat
  infer (envAt bodyLoc (extendLocalVars env (snd pr))) e2

inferIf : TcEnv -> Expr -> Expr -> Expr -> Mono
inferIf env c t e =
  -- A condition that is not a `Bool` is reported at the condition.
  let _ =
    unifyIn
      (dynAtIfSome (exprSpanLoc c) env.teDyn)
      (infer env c)
      (tconBuiltin "Bool")
  let tt = infer env t
  let ee = infer env e
  let context = if isOmittedElse e then JoinElselessIf else JoinIf
  joinValueTypes env.teDyn context [(exprLoc t, tt), (exprLoc e, ee)]

-- The parser builds an omitted `else` as a bare unit literal (`elseBranch`,
-- `compiler/frontend/parser.mdk`) and wraps every atom it reads in `ELoc`, a
-- written `()` included, so only an omitted branch arrives unwrapped.  The
-- final clause is a deliberate catch-all: the question is whether the branch is
-- exactly that one parser-built shape, and every other constructor, including
-- one added to `Expr` later, is a written branch.
isOmittedElse : Expr -> Bool
isOmittedElse (ELit LUnit) = True
isOmittedElse _ = False

collectProducedSummary : ModuleCtx -> List EffRow -> EffRow
collectProducedSummary mctx rows =
  let summary = freshEffectSummary mctx ()
  let _ = fold (_ row => recordEffectBody mctx summary row) () rows
  summary

publishProducedResults : DynCtx ->
  BindingSummary ->
  List (Option Loc, Mono) ->
  Unit
publishProducedResults dyn owned values =
  let results = map (clauseResult owned.bsArity) values
  let produced =
    optionOrFresh
      dyn.dcModule
      (joinProducedEnvelope
        (valueJoinOps dyn JoinClause (_ => collectProducedSummary dyn.dcModule))
        results)
  let _ =
    map
      ((loc, lower) => recordFileValueFlow dyn.dcModule loc produced lower)
      results
  match resultAfterArrows owned.bsArity owned.bsValue
    Some expected => bindFrom dyn expected produced
    None => panic "binding source arity differs from its allocated shape"

clauseResult : Int -> (Option Loc, Mono) -> (Option Loc, Mono)
clauseResult arity (loc, value) = match resultAfterArrows arity value
  Some result => (loc, result)
  None => (loc, value)

checkRecursiveValue : DynCtx -> BindingSummary -> Unit
checkRecursiveValue dyn owned =
  unifyInto dyn True owned.bsRecursiveValue owned.bsValue

inferProduced : TcEnv -> List Expr -> List (Option Loc, Mono)
inferProduced env [] = []
inferProduced env (e :: es) =
  let value = infer env e
  (exprLoc e, value) :: inferProduced env es

inferEach : TcEnv -> List Expr -> List Mono
inferEach env [] = []
inferEach env (e :: es) =
  let t = infer env e
  t :: inferEach env es

inferListLit : TcEnv -> List Expr -> Mono
inferListLit env es =
  let elem = joinValueTypes env.teDyn JoinList (inferProduced env es)
  TApp (tconBuiltin "List") elem

inferAnnot : TcEnv -> Expr -> Ty -> Mono
inferAnnot env e ty =
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let t = infer env e
  let pair = astTypeFreshTbl env.teDyn.dcModule ty
  let annot = fst pair
  -- The annotated expression flows into the written type as an argument
  -- into its parameter: a qualified annotation bounds its abstraction.
  let _ = argumentIntoOrd True env (Some e) annot t
  let _ = checkAnnotTooGeneral env.teDyn.dcModule ty (map snd (snd pair))
  -- The written variables are declared for the annotated expression's goals.
  -- Past it they are not: an annotated local that generalizes declares them as
  -- its quantified variables, and one that does not leaves them to its binder.
  let annotation = [("", ty, snd pair)]
  let declared = sccProtectedSignatureIds annotation
  let _ =
    if omSize declared == 0 then
      ()
    else
      checkSigVarGoals
        env.teDyn.dcModule
        DeclaredByAnnotation
        declared
        annotation
        (wWindow env.teDyn.dcModule.mcCells.implObls oblN0
          ++ callUOblsWindow env.teDyn.dcModule callN0)
  annot

-- Phase 108 head-pin (`:~`, EHeadAnnot): like inferAnnot but WITHOUT the
-- checkAnnotTooGeneral skolemization guard — the pin's type variables are MEANT
-- to ground (the container literal's element types).  Fixes `e`'s head tycon to
-- the named container so `fromEntries`'s return-position dispatch resolves to
-- that container's impl.
--
-- Phase 114 (was wrongly dropped here): ignore the *arity* the lowering happened
-- to supply and apply the head tycon to its *declared* arity of fresh vars.  The
-- parser can't tell empty `Map { }` from `Set { }` — both have no entries, so
-- classifyBrace falls through to `ESetLit name []` and the desugar pins a UNARY
-- `Map _a`, the wrong arity for `Map k v` (→ `Map vs Map …`).  Looking the arity
-- up by the head tycon makes empty literals work regardless of the lowering's
-- guess; element vars stay free and ground via inference as before.
inferHeadAnnot : TcEnv -> Expr -> Ty -> Mono
inferHeadAnnot env e ty =
  let t = infer env e
  let annot = headAnnotTy env.teDyn.dcModule ty
  let _ = unifyIn env.teDyn t annot
  t

-- The head-pin's target type: if the annotation's head is a TyCon with a known
-- declared arity (from `dataParamKindsRef`), rebuild it at that arity with fresh
-- vars (so an empty literal's wrong-arity pin is corrected); otherwise fall back
-- to the literal annotation type.
headAnnotTy : ModuleCtx -> Ty -> Mono
headAnnotTy mctx ty = match tyAppSpine ty
  -- OCCURRENCE MINT (#1110): same source as `fromAstTypeE`'s — the identity of
  -- the annotation head being rebuilt at its declared arity.
  (TyCon { tyConName = n, tyConOrigin = o }, _) =>
    match lookupTab (tyTabKey o n) mctx.mcCells.dataParamKindsRef.value
      Some kinds => applyParams (tconFrom o n) (freshVars mctx (listLen kinds))
      None => fst (astTypeFreshTbl mctx ty)
  _ => fst (astTypeFreshTbl mctx ty)

-- C3: each type variable named in the
-- annotation asserts polymorphism, so after unification it must still be a
-- DISTINCT, unbound variable.  If one ground to a concrete type, or two
-- annotation variables collapsed to the same variable, the annotation is more
-- polymorphic than the expression — reject.  `sigTvarIds` keeps only the entries
-- that normalize to a TVar, so a grounded var drops out (count shrinks) and a
-- collapse shows as a duplicate id.  EHeadAnnot is exempt (no call to this).
checkAnnotTooGeneral : ModuleCtx -> Ty -> List Mono -> Unit
checkAnnotTooGeneral mctx ty resolved =
  let ids = sigTvarIds resolved
  if listLen ids < listLen resolved || hasDupI ids then
    pushTypeError mctx "T-TYPE-TOO-GENERAL" (annotTooGeneralMsg ty)

inferMatch : TcEnv -> Mono -> List Arm -> Mono
inferMatch env scrutTy arms =
  let result = joinValueTypes env.teDyn JoinMatch (inferArms env scrutTy arms)
  let _ =
    scheduleMatchChecks
      env
      scrutTy
      arms
      (matchWarningLoc env.teDyn.dcModule.mcLoc arms)
  result

scheduleMatchChecks : TcEnv -> Mono -> List Arm -> Option Loc -> Unit
scheduleMatchChecks env scrutTy arms loc = match normalize scrutTy
  TVar _ =>
    env.teDyn.dcModule.mcCells.matchChecksDeferred :=
      (scrutTy, arms, loc)
        :: env.teDyn.dcModule.mcCells.matchChecksDeferred.value
  _ => checkMatchChecks (mctxAt loc env.teDyn.dcModule) scrutTy arms

-- A `let` pattern or lambda parameter is judged as the single arm of a match
-- on its own type, at the binding.  The parameters of one binding are judged as
-- one tuple pattern, so a binding with several refutable parameters warns once,
-- not once per parameter.
checkBinderPats : TcEnv -> List Mono -> List Pat -> Unit
checkBinderPats env [t] [p] = checkBinderPat env t p
checkBinderPats env ts ps
  | allList patIsVar ps = ()
  | otherwise = checkBinderPat env (tupleMono ts) (PTuple ps)

-- The variable that is the body of a binder's one arm: it marks the check as a binder's, whose
-- warning is worded for a pattern with no match to add an arm to.
binderMarker : String
binderMarker = "<binder>"

isBinderArms : List Arm -> Bool
isBinderArms [Arm _ [] (EVar n)] = n == binderMarker
isBinderArms _ = False

checkBinderPat : TcEnv -> Mono -> Pat -> Unit
checkBinderPat env ty pat =
  if patIsVar pat then
    ()
  else
    scheduleMatchChecks
      env
      ty
      [Arm pat [] (EVar binderMarker)]
      env.teDyn.dcModule.mcLoc

-- A match's warnings are located at the match through its last arm.  The
-- match's own span runs on over any comment or blank line that follows, on the
-- last arm's line or after it, so it is cut at the end of the last arm.  On
-- that arm's own line the cut takes the body's own span (its `ELoc`): the
-- parts of an unwrapped body do not reach its end (a field access's name has
-- no span).
matchWarningLoc : Option Loc -> List Arm -> Option Loc
matchWarningLoc (Some (Loc f sl sc el ec)) arms = match last arms
  Some (Arm _ _ body) => match exprSpanLoc body
    Some (Loc _ _ _ bel bec) if bel < el => Some (Loc f sl sc bel bec)
    _ => match exprLoc body
      Some (Loc _ _ _ bel bec) if bel == el && bec < ec =>
        Some (Loc f sl sc bel bec)
      _ => Some (Loc f sl sc el ec)
  None => Some (Loc f sl sc el ec)
matchWarningLoc None _ = None

-- A scrutinee whose type is still unknown after its arms (only literal, variable
-- and wildcard patterns, e.g. a lambda's parameter matched against integer
-- literals) is checked at the module's end instead, once `settleDeferredPatLits`
-- has given it its type, so the warning names it (`non-exhaustive match on U8`).
checkMatchChecks : ModuleCtx -> Mono -> List Arm -> Unit
checkMatchChecks mctx scrutTy arms =
  let _ = checkMatchExhaustive mctx scrutTy arms
  checkMatchRedundant mctx scrutTy arms

checkDeferredMatches : ModuleCtx -> List (Mono, List Arm, Option Loc) -> Unit
checkDeferredMatches mctx [] = ()
checkDeferredMatches mctx ((scrutTy, arms, loc) :: rest) =
  let _ = checkMatchChecks (mctxAt loc mctx) scrutTy arms
  checkDeferredMatches mctx rest
-- Type-aware exhaustiveness (`check_match`): run AFTER the arms have unified
-- the scrutinee type, so `scrutTy` is fully resolved when we read its head.

-- Warn if an all-wildcard query is still useful against the matrix of the
-- non-guarded arms — i.e. some scrutinee value escapes every arm.  Guarded arms
-- are excluded (their guard may fail at runtime), matching the reference.
checkMatchExhaustive : ModuleCtx -> Mono -> List Arm -> Unit
checkMatchExhaustive mctx scrutTy arms =
  let rows = nonGuardedRows mctx arms
  if useful
    mctx.mcCells.matchOracle.value
    (matchCol0Type scrutTy)
    rows
    [PWild] then
    let binder = isBinderArms arms
    let (msg, help) = nonExhaustiveMsg mctx scrutTy rows binder
    -- A let-bound function is nested one-parameter lambdas that share the
    -- binding's location; the first refutable parameter's warning is the one.
    if binder
      && anyList (warnedAt mctx.mcLoc) mctx.mcCells.matchWarnings.value then
      ()
    else
      mctx.mcCells.matchWarnings :=
        writtenDiag (TcDiag "W-NONEXHAUSTIVE" 2 mctx.mcLoc msg help None)
          :: mctx.mcCells.matchWarnings.value

warnedAt : Option Loc -> TcDiag -> Bool
warnedAt loc (TcDiag code _ at _ _ _) =
  code == "W-NONEXHAUSTIVE" && locKey loc /= "" && locKey at == locKey loc

checkMatchRedundant : ModuleCtx -> Mono -> List Arm -> Unit
checkMatchRedundant mctx scrutTy arms =
  checkRedundantGo mctx (matchCol0Type scrutTy) [] omEmpty False arms

-- PERF: `prec` accumulates the preceding arms' patterns and is PREPENDED to, so
-- it holds them in REVERSE arm order.  It used to be built with `prec ++ [[dp]]`,
-- which copies the whole accumulator once per arm — O(N²) allocation on a match
-- with many arms, and the dominant allocation source in the redundancy check.
--
-- Reversing the rows is sound because `useful` is a PREDICATE OVER THE SET of
-- matrix rows ("does some value match the query and no row?"): `specializeCon` /
-- `specializeLit` / `defaultMatrix` are row-wise filters, and the only decision
-- that reads rows in order is `columnCtors`, which just needs SOME column-0
-- constructor to name the column's type — and it is consulted only when `col0`
-- is `None`, i.e. when the scrutinee type has no concrete head, in which case no
-- arm carries a constructor pattern and there is no head constructor to find in
-- either order.
checkRedundantGo : ModuleCtx ->
  Option TabKey ->
  List (List Pat) ->
  OrdMap Unit ->
  Bool ->
  List Arm ->
  Unit
checkRedundantGo mctx _ _ _ _ [] = ()
checkRedundantGo mctx col0 prec heads offCol ((Arm pat gs body) :: rest) =
  let dp = desugarPat mctx.mcCells.matchOracle.value pat
  let _ =
    if armUnreachable mctx col0 prec heads offCol dp then
      mctx.mcCells.matchWarnings :=
        TcDiag
            "W-UNREACHABLE-ARM"
            2
            (orElseLoc (exprLoc body) mctx.mcLoc)
            unreachableArmWarning
            None
            None
          :: mctx.mcCells.matchWarnings.value
  -- Only UNGUARDED, range-free arms contribute to the covered set: a guarded arm
  -- may not fire, and a range collapses to a wildcard that over-states coverage
  -- (patHasRange) — either would produce a false "redundant" on a later arm.
  let contributes = armIsUnguarded gs && not (patHasRange pat)
  let prec2 = if contributes then [dp] :: prec else prec
  let heads2 = if contributes then noteHeadCtor dp heads else heads
  let offCol2 = offCol || contributes && not (isConPat dp)
  checkRedundantGo mctx col0 prec2 heads2 offCol2 rest

-- PERF fast path.  `patUnreachable` runs the full Maranget `useful` recursion, which
-- re-scans EVERY preceding row — so the fold as a whole is O(arms²) on a wide match.
-- But a constructor arm `C …` can only be unreachable if some preceding row could
-- match a `C` value, and the only rows that can are (a) rows headed by `C` itself and
-- (b) rows with a WILDCARD head, which match anything.  When neither exists,
-- `specializeCon C` yields the EMPTY matrix and `useful _ _ [] _` is `True` by
-- definition — the arm is reachable — so the recursion is guaranteed to say
-- "reachable" and we can skip it outright.
--
-- `heads` is the set of head constructors of the preceding contributing rows and
-- `offCol` records whether any of them has a NON-constructor head.  `offCol` is a
-- deliberate over-approximation of "has a wildcard head" (it also trips on a literal
-- head, which `specializeCon` would in fact discard): erring towards `True` only ever
-- costs us the fast path and falls back to the exact check, never an answer.
armUnreachable : ModuleCtx ->
  Option TabKey ->
  List (List Pat) ->
  OrdMap Unit ->
  Bool ->
  Pat ->
  Bool
armUnreachable mctx col0 prec heads offCol (PCon c args)
  | not offCol && not (omHasKey c heads) = False
  | otherwise =
    patUnreachable mctx.mcCells.matchOracle.value col0 prec (PCon c args)
armUnreachable mctx col0 prec _ _ dp =
  patUnreachable mctx.mcCells.matchOracle.value col0 prec dp

noteHeadCtor : Pat -> OrdMap Unit -> OrdMap Unit
noteHeadCtor (PCon c _) heads = omInsert c () heads
noteHeadCtor _ heads = heads

isConPat : Pat -> Bool
isConPat (PCon _ _) = True
isConPat _ = False

-- Only UNGUARDED arms contribute to the covered set (a guarded arm may not fire).
armIsUnguarded : List Guard -> Bool
armIsUnguarded [] = True
armIsUnguarded (_ :: _) = False

-- Build the specialised warning: recover a concrete uncovered pattern (the
-- Maranget witness) and name it, plus the scrutinee type when it has a real
-- head name.  Falls back to the generic wording if no witness is recoverable
-- (keeps the warning firing whenever `useful` should, never naming a wrong
-- constructor).  Actionable-fix hint (F dimension): when a witness IS
-- recoverable, append a concrete-edit suggestion using the witness string
-- VERBATIM (so `Triangle _` reads as `Triangle _`, not `Triangle`) and return it
-- as the `Some` help so `--json`'s `help` field carries it too.  #159: returns
-- `(message, Option help)` so the caller can stash both in the warning's TcDiag —
-- no more message-keyed `matchWarningHelp` side channel.
nonExhaustiveMsg : ModuleCtx ->
  Mono ->
  List (List Pat) ->
  Bool ->
  (String, Option String)
nonExhaustiveMsg mctx scrutTy rows binder =
  match (usefulWitness
    mctx.mcCells.matchOracle.value
    (matchCol0Type scrutTy)
    rows
    1)
    Some (w :: _) =>
      let witnessStr = renderWitness w
      if binder then
        let (msg, hint) =
          binderNonExhaustiveMsg (matchCol0Type scrutTy) witnessStr
        (msg, Some hint)
      else
        let hint =
          if witnessStr == "_" then
            "add a `_ => ...` arm"
          else
            "add a `\{witnessStr} => ...` arm or a `_` wildcard"
        let msg =
          "Warning: non-exhaustive match\{tyOfMsg (matchCol0Type scrutTy)}: missing `\{witnessStr}`; \{hint}"
        (msg, Some hint)
    _ => (nonExhaustiveMatchWarning, None)

-- one single-column matrix row per non-guarded arm (its desugared pattern)
nonGuardedRows : ModuleCtx -> List Arm -> List (List Pat)
nonGuardedRows mctx [] = []
nonGuardedRows mctx ((Arm pat [] _) :: rest) =
  [desugarPat mctx.mcCells.matchOracle.value pat] :: nonGuardedRows mctx rest
nonGuardedRows mctx ((Arm _ _ _) :: rest) = nonGuardedRows mctx rest

inferArms : TcEnv -> Mono -> List Arm -> List (Option Loc, Mono)
inferArms env _ [] = []
inferArms env scrutTy ((Arm pat gs body) :: rest) =
  let value = inferArm env scrutTy pat gs body
  (exprLoc body, value) :: inferArms env scrutTy rest

inferArm : TcEnv -> Mono -> Pat -> List Guard -> Expr -> Mono
inferArm env scrutTy pat gs body
  | env.teDyn.dcModule.mcGraph.graphRun.anyExistentialsRef.value
    && patOpensExistentials env pat = inferArmOpening env scrutTy pat gs body
  | otherwise =
    let lits = takePatLits env.teDyn.dcModule ()
    let pr = inferPat env pat
    let _ = bindFrom env.teDyn (fst pr) scrutTy
    let _ = settlePatLits env.teDyn lits
    let envBody = inferArmGuards (extendLocalVars env (snd pr)) gs
    infer envBody body

-- Does the pattern name a constructor with an existential binder?  Decided
-- before inference so the arm can enter its level first.
patOpensExistentials : TcEnv -> Pat -> Bool
patOpensExistentials env (PCon name pats) =
  ctorHasExistentials env.teDyn.dcModule.mcGraph (lookupCtor env name)
    || anyList (patOpensExistentials env) pats
patOpensExistentials env (PRec name fields _) =
  recordHasExistentials
      env.teDyn.dcModule.mcGraph
      (lookupRecordByName env.teDyn.dcModule name)
    || anyList (recPatFieldOpens env) fields
patOpensExistentials env (PTuple pats) = anyList (patOpensExistentials env) pats
patOpensExistentials env (PList pats) = anyList (patOpensExistentials env) pats
patOpensExistentials env (PCons h t) =
  patOpensExistentials env h || patOpensExistentials env t
patOpensExistentials env (PAs _ _ _ p) = patOpensExistentials env p
patOpensExistentials env _ = False

recPatFieldOpens : TcEnv -> RecPatField -> Bool
recPatFieldOpens env (RecPatField _ _ _ (Some p)) = patOpensExistentials env p
recPatFieldOpens env _ = False

ctorHasExistentials : GraphCtx -> Option Scheme -> Bool
ctorHasExistentials gctx (Some (Forall _ _ avars _ _ _)) =
  anyExistential gctx avars
ctorHasExistentials gctx None = False

recordHasExistentials : GraphCtx -> Option RecordInfo -> Bool
recordHasExistentials gctx (Some (RecordInfo _ authIds _ _ _)) =
  anyExistential gctx authIds
recordHasExistentials gctx None = False

anyExistential : GraphCtx -> List Int -> Bool
anyExistential gctx ids =
  anyList (id => IdMap.has id gctx.graphRun.ctorExistentialsRef.value) ids

-- An arm whose pattern opened existential authorities (§4.1) is their scope.
-- The body runs one level deeper, so a cell bound into anything the arm did
-- not create is lowered by the ordinary level discipline and found at the
-- end; a cell in the arm's own value type is found there.  Either is an
-- escape (`T-AUTHORITY-ESCAPE`): the arm's value cannot carry an authority
-- nothing outside it can name.  A row the arm performs at the authority is
-- checked against the enclosing declaration as any row is (rigid: only the
-- label bare admits it), and an inferred row publishes it as the domain's
-- top (`defaultSourcelessAuthorities`).
inferArmOpening : TcEnv -> Mono -> Pat -> List Guard -> Expr -> Mono
inferArmOpening env scrutTy pat gs body =
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPat env pat
  let _ = bindFrom env.teDyn (fst pr) scrutTy
  let scope =
    openExistentialScope
      env.teDyn.dcModule
      (takeOpenedExistentials env.teDyn.dcModule ())
  let _ = settlePatLits env.teDyn lits
  let envBody = inferArmGuards (extendLocalVars env (snd pr)) gs
  let t = infer envBody body
  let _ = closeExistentialScope env.teDyn.dcModule scope t (exprLoc body)
  t

openExistentialScope : ModuleCtx -> List (Ref Authvar) -> ExistentialScope
openExistentialScope mctx [] = ExistentialScope [] 0
openExistentialScope mctx opened =
  let _ = enterLevel mctx ()
  let level = mctx.mcCells.currentLevel.value
  let _ = fold (_ cell => raiseAuthvarLevel level cell) () opened
  ExistentialScope opened level

-- A cell in the scope's value, or lowered below the scope's level, escaped
-- (`T-AUTHORITY-ESCAPE`): the value cannot carry an authority nothing outside
-- the scope can name.  A row the scope performed at the authority is checked
-- against the enclosing declaration as any row is (rigid: only the label bare
-- admits it), and an inferred row publishes it as the domain's top
-- (`defaultSourcelessAuthorities`).
closeExistentialScope : ModuleCtx ->
  ExistentialScope ->
  Mono ->
  Option Loc ->
  Unit
closeExistentialScope mctx (ExistentialScope [] _) _ _ = ()
closeExistentialScope mctx (ExistentialScope opened level) t loc =
  let _ = exitLevel mctx ()
  let inValue = authCellsIn t Tip
  fold
    (_ cell =>
      if IdMap.has (authvarId cell) inValue || authvarLevel cell < level then
        mctx.mcCells.escapedExistentialsRef :=
          IdMap.set
            (authvarId cell)
            ()
            mctx.mcCells.escapedExistentialsRef.value
        pushTypeErrorAt
          mctx
          "T-AUTHORITY-ESCAPE"
          loc
          (existentialEscapeMsg (authvarName cell)))
    ()
    opened

-- Thread an arm's guard qualifiers left-to-right: a `GBool` must be `Bool` and leaves the env unchanged; a
-- `GBind p e` infers `e`, binds `p` against it, and extends the env so the bound
-- vars are in scope for LATER qualifiers and the arm body.  A qualifier's own
-- check is located at its expression.
inferArmGuards : TcEnv -> List Guard -> TcEnv
inferArmGuards env [] = env
inferArmGuards env ((GBool g) :: rest) =
  let _ =
    unifyIn
      (dynAtIfSome (exprSpanLoc g) env.teDyn)
      (infer env g)
      (tconBuiltin "Bool")
  inferArmGuards env rest
inferArmGuards env ((GBind p e) :: rest) =
  let te = infer env e
  let at = envAtIfSome (exprSpanLoc e) env
  let lits = takePatLits at.teDyn.dcModule ()
  let pr = inferPat at p
  let _ = bindFrom at.teDyn (fst pr) te
  let _ = settlePatLits at.teDyn lits
  inferArmGuards (extendLocalVars env (snd pr)) rest

inferLetGroup : TcEnv -> List LetBind -> Expr -> Mono
inferLetGroup env binds body =
  let _ = checkLetGroupBindsLocated env.teDyn.dcModule binds  -- #799
  let env2 = fold processLetGroup env (letGroupComponents binds)
  infer env2 body

-- A `where` block is checked one dependency component at a time, a
-- component's dependencies first, as a module's top level is: a binding that
-- only USES a sibling sees it generalized, rather than sharing its type
-- variables as a member of one recursive group would, so a helper may be used
-- at two types and keeps its own authority residual (#3487).  Members keep
-- their source order inside a component.  A block that repeats a name stays
-- one group: its components are not well defined.
letGroupComponents : List LetBind -> List (List LetBind)
letGroupComponents binds =
  let names = map letBindName binds
  let nameSet = namesToSet names omEmpty
  if omSize nameSet < listLen names then
    [binds]
  else
    let grouped =
      fold
        (m (LetBind n clauses _ _) => omInsert n (map funClausePair clauses) m)
        omEmpty
        binds
    map
      (component =>
        let members = namesToSet component omEmpty
        filterList (b => omHasKey (letBindName b) members) binds)
      (tarjanSCCs names (depGraphMap names grouped))

-- instantiate a record's quantified params with fresh vars.  Rebuilds ALL fields —
-- used by the record-CREATE and record-PATTERN paths, which must see every declared
-- field (missing-field check / binding each pattern field).  The single-field access
-- and record-update paths use `instantiateRecordShared` + the field index instead so
-- they never rebuild all N fields per access (issue #980).

-- A record's params and authorities freshened together; the constructor's
-- existentials are OPENED (rigid cells, parked at the pattern site) rather
-- than freshened flexible — the record-pattern twin of `instantiateCtorPattern`.
-- A record CREATE goes through `instantiateRecordShared`, which freshens every
-- authority flexible, since packing takes the value's own index.
instantiateRecordOpening : ModuleCtx ->
  RecordInfo ->
  ((Mono, List (String, Mono)), List (Ref Authvar))
instantiateRecordOpening mctx (RecordInfo paramIds authIds result fields _) =
  let subst = freshSubst mctx paramIds
  let (asub, opened) =
    freshAuthSubstOpeningIn mctx authIds (recordAuthCells authIds result fields)
  (
    (
      substMono mctx.mcGraph subst [] asub result,
      map (substField mctx.mcGraph subst asub) fields,
    ),
    opened,
  )

-- Instantiate ONLY the result type, returning the shared param substitution so the
-- caller can instantiate individual fields on demand (via the field index).  The
-- fresh-var allocation is identical to `instantiateRecordOpening` (both call `freshSubst
-- paramIds`); only the per-field `substMono` trees for UNACCESSED fields are skipped,
-- and those allocate no fresh tyvars, so tyvar numbering is byte-identical.
instantiateRecordShared : ModuleCtx -> RecordInfo -> (RecordSubst, Mono)
instantiateRecordShared mctx (RecordInfo paramIds authIds result fields _) =
  let subst = freshSubst mctx paramIds
  let cells = recordAuthCells authIds result fields
  let asub =
    map (id => (id, sharedAuthority mctx id (IdMap.get id cells))) authIds
  (RecordSubst subst asub, substMono mctx.mcGraph subst [] asub result)

-- An update repacks a field under an existential binder only where it
-- replaces every field that mentions the binder: the value's index is then
-- the replacement's own.  Replacing some of them would leave one binder
-- naming two values at different authorities, so that is refused.  A binder
-- none of the assigned fields mentions is untouched and, as at a read,
-- recovers the top.
instantiateRecordUpdate : ModuleCtx ->
  String ->
  RecordInfo ->
  List String ->
  (RecordSubst, Mono)
instantiateRecordUpdate mctx rname (RecordInfo paramIds authIds result fields _) assigned =
  let subst = freshSubst mctx paramIds
  let cells = recordAuthCells authIds result fields
  let asub =
    map
      (id => (
        id,
        updateAuthority mctx rname fields assigned id (IdMap.get id cells),
      ))
      authIds
  (RecordSubst subst asub, substMono mctx.mcGraph subst [] asub result)

updateAuthority : ModuleCtx ->
  String ->
  List (String, Mono) ->
  List String ->
  Int ->
  Option (Ref Authvar) ->
  Authority
updateAuthority mctx rname fields assigned id source
  | IdMap.has id mctx.mcGraph.graphRun.ctorExistentialsRef.value =
    let mentioning =
      map fst (filterList (f => IdMap.has id (authCellsIn (snd f) Tip)) fields)
    let replaced = filterList (n => contains n assigned) mentioning
    if isEmptyL replaced then
      sharedAuthority mctx id source
    else if listLen replaced == listLen mentioning then
      AVar (freshInferenceAuthvar mctx id source)
    else
      let _ =
        pushTypeError
          mctx
          "T-AUTHORITY-EXISTENTIAL-SCOPE"
          (partialExistentialUpdateMsg rname mentioning)
      AVar (freshInferenceAuthvar mctx id source)
  | otherwise = AVar (freshInferenceAuthvar mctx id source)

-- A universal freshens flexible, as at any use.  An existential binder is
-- opened only by a pattern; a field read or update sees the value without
-- opening it, so what it recovers is the domain's top: the value proves
-- nothing about an authority the read cannot name.
sharedAuthority : ModuleCtx -> Int -> Option (Ref Authvar) -> Authority
sharedAuthority mctx id source
  | IdMap.has id mctx.mcGraph.graphRun.ctorExistentialsRef.value = match source
    Some cell => authTop (authvarDomain cell)
    None => authTop PUnit
  | otherwise = AVar (freshInferenceAuthvar mctx id source)

substRecordField : GraphCtx -> RecordSubst -> Mono -> Mono
substRecordField gctx (RecordSubst subst asub) fm =
  substMono gctx subst [] asub fm

recordFieldMap : RecordInfo -> OrdMap Mono
recordFieldMap (RecordInfo _ _ _ _ idx) = idx

recordFieldNames : RecordInfo -> List String
recordFieldNames (RecordInfo _ _ _ fields _) = map fst fields

substField : GraphCtx ->
  List (Int, Mono) ->
  List (Int, Authority) ->
  (String, Mono) ->
  (String, Mono)
substField gctx subst asub (fn, fm) = (fn, substMono gctx subst [] asub fm)

-- Publish every top-level function clause and top-level let-group member under
-- the scheme its group generalized to, mirroring the decl shapes `funDefs`
-- flattens.  Each clause of a multi-clause function has its own id and records
-- the one scheme, and whether the module declares a signature for its name.
recordTopBinderTypes : GraphCtx -> OrdMap Scheme -> List Decl -> Unit
recordTopBinderTypes gctx schemes decls =
  let signed = signedTopNames decls omEmpty
  fold (_ d => recordTopDeclBinderTypes gctx schemes signed d) () decls

-- The names a top-level type signature declares, an annotated one included.
signedTopNames : List Decl -> OrdMap Unit -> OrdMap Unit
signedTopNames [] acc = acc
signedTopNames ((DTypeSig _ n _ _) :: rest) acc =
  signedTopNames rest (omInsert n () acc)
signedTopNames ((DAttrib _ d) :: rest) acc = signedTopNames (d :: rest) acc
signedTopNames (_ :: rest) acc = signedTopNames rest acc

recordTopDeclBinderTypes : GraphCtx ->
  OrdMap Scheme ->
  OrdMap Unit ->
  Decl ->
  Unit
recordTopDeclBinderTypes gctx schemes signed (DFunDef _ n ps _ _ bid) =
  recordTopFunBinderType gctx schemes signed n bid (listLen ps)
recordTopDeclBinderTypes gctx schemes signed (DLetGroup _ binds) =
  fold
    (_ b => match b
      LetBind n clauses _ bid => match clauses
        (FunClause ps _) :: _ =>
          recordTopFunBinderType gctx schemes signed n bid (listLen ps)
        [] => recordTopFunBinderType gctx schemes signed n bid 0)
    ()
    binds
recordTopDeclBinderTypes gctx schemes signed (DAttrib _ d) =
  recordTopDeclBinderTypes gctx schemes signed d
recordTopDeclBinderTypes gctx _ _ _ = ()

recordTopFunBinderType : GraphCtx ->
  OrdMap Scheme ->
  OrdMap Unit ->
  String ->
  BinderId ->
  Int ->
  Unit
recordTopFunBinderType gctx schemes signed n bid arity =
  match omLookup n schemes
    Some sch =>
      recordBinderType
        gctx
        bid
        n
        (schemeMono sch)
        (Some arity)
        (omHasKey n signed)
    None => ()

-- True iff the expression is an explicit lambda at the top level.
-- ⚠️ #807 (pre-existing, out of scope here): does NOT see through an ELoc
-- wrapper, so a zero-param `let rec f = x => …` clause — whose RHS the parser
-- wraps in ELoc — is WRONGLY rejected as non-function even though it plainly
-- is one. Confirmed this predates #799's fix (reproduces identically against
-- pre-#799 top-level `let rec`, the only call site old enough to hit it) —
-- not something introduced by the block/expr-level guards added here.
isSyntacticLambda : Expr -> Bool
isSyntacticLambda (ELam _ _) = True
isSyntacticLambda _ = False

-- D2 fix: check all top-level DLetGroup declarations for non-function recursive
-- bindings.  A binding is illegal
-- when ALL its clauses have zero params AND none is a syntactic lambda.
-- Pushes the error into typeErrors for each violating member.
checkLetRecDecls : ModuleCtx -> List Decl -> Unit
checkLetRecDecls mctx [] = ()
checkLetRecDecls mctx ((DLetGroup _ binds) :: rest) =
  let _ = checkLetBinds mctx binds
  checkLetRecDecls mctx rest
checkLetRecDecls mctx (_ :: rest) = checkLetRecDecls mctx rest

checkLetBinds : ModuleCtx -> List LetBind -> Unit
checkLetBinds mctx [] = ()
checkLetBinds mctx ((LetBind name clauses _ _) :: rest) =
  let _ = checkLetBind mctx name clauses
  checkLetBinds mctx rest

checkLetBind : ModuleCtx -> String -> List FunClause -> Unit
checkLetBind mctx name clauses
  | allList clauseIsNonFunction clauses =
    pushTypeError
      (mctxAtIfSome (clausesSpanLoc clauses) mctx)
      "T-NONREC-VALUE-LET"
      (letRecNonFunctionMsg name)
  | otherwise = ()

clauseIsNonFunction : FunClause -> Bool
clauseIsNonFunction (FunClause [] rhs) = not (isSyntacticLambda rhs)
clauseIsNonFunction (FunClause _ _) = False

-- #799: the guard above (checkLetRecDecls/checkLetBind) only walks TOP-LEVEL
-- DLetGroup declarations. BLOCK-level (`let rec x = v` as a DoStmt) and
-- EXPRESSION-level (`let rec x = v in e2`, an ELetGroup) `let rec` reach
-- blockRecLet/inferRecLet/inferLetGroup directly, with no non-function check at
-- all — a non-function binding (e.g. `let rec loop = loop`) silently pre-binds
-- the name to a placeholder Ref and evaluates to it, never erroring.

-- blockRecLet/inferRecLet already have the bound name's (possibly-curried) RHS
-- expr in hand: `curryLam pats e1` for a function-form clause is always an
-- ELam, so this only ever flags the genuinely zero-param, non-lambda case —
-- identical discrimination to clauseIsNonFunction, just on the curried form.
-- Both call sites are ELet, produced ONLY from a singleton binding (a plain
-- `let f a… = e1 [in e2]` or an explicit `let rec` — "with" mutual-grouping was
-- removed), so — unlike ELetGroup below — there is no risk of an innocent
-- bystander binding riding along; mirroring the top-level "not a syntactic
-- lambda ⇒ reject" rule verbatim is safe here. Unlike the top-level call site
-- (which has no expression in hand to locate against), this DOES have the RHS
-- expr and passes it to pushTypeErrorAt via exprLoc (ERROR-QUALITY.md) — but
-- that is a BEST-EFFORT location, not a guaranteed one: exprLoc only recognizes
-- an ELoc/EDoOrigin wrapper, and not every Expr shape the parser produces is
-- wrapped in one (e.g. a bare `EBinOp` RHS like `let rec x = x + 1` has no
-- ELoc, so exprLoc returns None and the diagnostic falls back to the zero
-- range — same as the top-level guard's own unlocated call). A wrapped RHS
-- (the common case — most expressions ARE ELoc-wrapped) gets a real range.
checkRecBindNonFunction : ModuleCtx -> String -> Expr -> Unit
checkRecBindNonFunction mctx name e
  | isSyntacticLambda e = ()
  | otherwise =
    pushTypeErrorAt
      mctx
      "T-NONREC-VALUE-LET"
      (exprLoc e)
      (letRecNonFunctionMsg name)

-- inferLetGroup's ELetGroup is DIFFERENT: it is the SAME node `where` clauses
-- desugar to (parser.mdk whereEol/whereTail/guard-arm-where — verified: no
-- `rec` keyword involved, no AST field distinguishing the two), and a `where`
-- group routinely bundles plain, NON-recursive value helpers alongside real
-- functions (e.g. stdlib/list.mdk's `split`: `where sepLen = length sep; go
-- ys = …` — sepLen never mentions itself or any sibling). Applying
-- checkRecBindNonFunction's blunt "not a lambda ⇒ reject" rule here false-
-- positived on exactly that (confirmed against the tree before landing this).
--
-- So this check is narrower and more precise instead of broader: a zero-param,
-- non-lambda clause is illegal only if its RHS EAGERLY (i.e. not deferred
-- behind a nested lambda) mentions itself or a NOT-YET-INSTALLED sibling — the
-- actual hazard (evalLetGroup pre-binds every member's cell to Ref VUnit and
-- installs each member's value in SOURCE ORDER, so an eager reference to a
-- cell installed BEFORE this one is already set — safe — while a reference to
-- itself or a cell installed AFTER this one reads stale VUnit — unsafe).
--
-- Concretely: for the clause at index i, only a self-or-FORWARD reference
-- (index >= i) is illegal; a BACKWARD reference (index < i) is the ordinary,
-- safe `where`-clause shape (`f x = b where a = x + 1; b = a + 100` — `b`
-- referencing the earlier `a` is fine, `a` referencing the later `b` would not
-- be). checkLetGroupBindsGo threads exactly that suffix: at each step the
-- current binding's own name is prepended to the REST of the list (every
-- sibling that installs after it), so "names" passed down is always "self +
-- forward", never "self + every sibling" — an earlier false-positive this
-- fixed (confirmed against the tree: it rejected working `where`-bound values
-- that only referenced an EARLIER sibling).
checkLetGroupBindsLocated : ModuleCtx -> List LetBind -> Unit
checkLetGroupBindsLocated mctx = checkLetGroupBindsGo mctx

checkLetGroupBindsGo : ModuleCtx -> List LetBind -> Unit
checkLetGroupBindsGo mctx [] = ()
checkLetGroupBindsGo mctx ((LetBind name clauses _ _) :: rest) =
  let selfAndForward = name :: map letBindName rest
  let _ = checkClausesNonFunctionLocated mctx selfAndForward name clauses
  checkLetGroupBindsGo mctx rest

checkClausesNonFunctionLocated : ModuleCtx ->
  List String ->
  String ->
  List FunClause ->
  Unit
checkClausesNonFunctionLocated mctx names name clauses
  | allList clauseIsNonFunction clauses
    && anyClauseEagerlyRefsGroup names clauses =
    pushTypeErrorAt
      mctx
      "T-NONREC-VALUE-LET"
      (clausesLoc clauses)
      (letRecNonFunctionMsg name)
  | otherwise = ()

anyClauseEagerlyRefsGroup : List String -> List FunClause -> Bool
anyClauseEagerlyRefsGroup names clauses =
  anyList (clauseEagerlyRefsGroup names) clauses

clauseEagerlyRefsGroup : List String -> FunClause -> Bool
clauseEagerlyRefsGroup names (FunClause _ rhs) = anyMember names (eagerRefs rhs)

clausesLoc : List FunClause -> Option Loc
clausesLoc [] = None
clausesLoc ((FunClause _ rhs) :: _) = exprLoc rhs

-- The span of the first clause's right-hand side, unwrapped nodes included.
clausesSpanLoc : List FunClause -> Option Loc
clausesSpanLoc [] = None
clausesSpanLoc ((FunClause _ rhs) :: _) = exprSpanLoc rhs

-- Names `e` reads WITHOUT first going under a lambda (a lambda DEFERS
-- evaluation, so a reference inside one cannot observe a still-uninstalled
-- letrec-group cell). Deliberately UNDER-approximates: an Expr shape not
-- explicitly handled falls to the catch-all `[]` (no eager reference
-- detected) rather than guessing — that can only make this check MORE
-- permissive than exhaustive coverage would, never less, so an unhandled
-- shape is a missed catch (no worse than status quo before #799's fix), not a
-- new false positive. Mirrors marker.mdk's collectVars (the DCE reference
-- walk) with ONE change: collectVars descends into ELam bodies (DCE needs
-- every eventually-reachable name); this stops at ELam (its body is deferred,
-- not eager).
eagerRefs : Expr -> List String
eagerRefs (EVar x) = [x]
eagerRefs (EVarId x _) = [x]
-- #2705: a marked occurrence is still a reference to the name (every driver marks
-- before inference now); dropping it here would make this check more permissive
-- than the un-marked tree it mirrors.
eagerRefs (EMethodAt x _ _) = [x]
eagerRefs (EDictAt x _) = [x]
eagerRefs (EApp a b) = eagerRefs a ++ eagerRefs b
eagerRefs (ELam _ _) = []
eagerRefs (ELet _ _ _ e1 e2) = eagerRefs e1 ++ eagerRefs e2
eagerRefs (ELetGroup bs e2) = flatMap eagerRefsLetBind bs ++ eagerRefs e2
eagerRefs (EMatch e0 arms) = eagerRefs e0 ++ flatMap eagerRefsArm arms
eagerRefs (EIf c t el) = eagerRefs c ++ eagerRefs t ++ eagerRefs el
eagerRefs (EBinOp _ a b _) = eagerRefs a ++ eagerRefs b
eagerRefs (EUnOp _ a _) = eagerRefs a
eagerRefs (EInfix op a b) = op :: eagerRefs a ++ eagerRefs b
eagerRefs (EFieldAccess e0 _ _) = eagerRefs e0
eagerRefs (ERecordCreate _ fs) = flatMap eagerRefsFieldAssign fs
eagerRefs (ERecordUpdate e0 fs _) =
  eagerRefs e0 ++ flatMap eagerRefsFieldAssign fs
eagerRefs (EVariantUpdate _ e0 fs) =
  eagerRefs e0 ++ flatMap eagerRefsFieldAssign fs
eagerRefs (EArrayLit es) = flatMap eagerRefs es
eagerRefs (EListLit es) = flatMap eagerRefs es
eagerRefs (ETuple es) = flatMap eagerRefs es
eagerRefs (EIndex e0 i) = eagerRefs e0 ++ eagerRefs i
eagerRefs (ERangeList lo hi _) = eagerRefs lo ++ eagerRefs hi
eagerRefs (ERangeArray lo hi _) = eagerRefs lo ++ eagerRefs hi
eagerRefs (ESlice e0 lo hi _) = eagerRefs e0 ++ eagerRefs lo ++ eagerRefs hi
eagerRefs (EBlock stmts) = flatMap eagerRefsDoStmt stmts
eagerRefs (EDo _ stmts) = flatMap eagerRefsDoStmt stmts
eagerRefs (EAnnot e0 _) = eagerRefs e0
eagerRefs (EHeadAnnot e0 _) = eagerRefs e0
eagerRefs (EStringInterp parts) = flatMap eagerRefsInterp parts
eagerRefs (EGuards arms) = flatMap eagerRefsGuardArm arms
eagerRefs (ESection (SecRight _ e0)) = eagerRefs e0
eagerRefs (ESection (SecLeft e0 _)) = eagerRefs e0
eagerRefs (EAsPat _ e0) = eagerRefs e0
eagerRefs (EMapLit _ kvs) = flatMap eagerRefsPair kvs
eagerRefs (ESetLit _ es) = flatMap eagerRefs es
eagerRefs (ELoc _ e) = eagerRefs e
eagerRefs (EDoOrigin _ e) = eagerRefs e
eagerRefs _ = []

eagerRefsLetBind : LetBind -> List String
eagerRefsLetBind (LetBind _ clauses _ _) =
  flatMap eagerRefsClauseAllPats clauses

-- Unlike the group-membership test above (which only examines zero-param
-- clauses), a NESTED ELetGroup's own function-form members are legitimately
-- deferred (their body only runs once applied) — so only fold in a nested
-- zero-param clause's refs eagerly; a nested function clause's body is safe
-- to skip, matching the ELam short-circuit above.
eagerRefsClauseAllPats : FunClause -> List String
eagerRefsClauseAllPats (FunClause [] rhs) = eagerRefs rhs
eagerRefsClauseAllPats (FunClause _ _) = []

eagerRefsArm : Arm -> List String
eagerRefsArm (Arm _ gs body) = flatMap eagerRefsGuard gs ++ eagerRefs body

eagerRefsGuard : Guard -> List String
eagerRefsGuard (GBool e) = eagerRefs e
eagerRefsGuard (GBind _ e) = eagerRefs e

eagerRefsGuardArm : GuardArm -> List String
eagerRefsGuardArm (GuardArm gs body) =
  flatMap eagerRefsGuard gs ++ eagerRefs body

eagerRefsFieldAssign : FieldAssign -> List String
eagerRefsFieldAssign (FieldAssign _ e) = eagerRefs e

eagerRefsDoStmt : DoStmt -> List String
eagerRefsDoStmt (DoExpr e) = eagerRefs e
eagerRefsDoStmt (DoBind _ e) = eagerRefs e
eagerRefsDoStmt (DoLet _ _ _ e _) = eagerRefs e
eagerRefsDoStmt _ = []

eagerRefsInterp : InterpPart -> List String
eagerRefsInterp (InterpExpr e) = eagerRefs e
eagerRefsInterp _ = []

eagerRefsPair : (Expr, Expr) -> List String
eagerRefsPair (k, v) = eagerRefs k ++ eagerRefs v

groupNames : List (String, (List Pat, Expr)) -> OrdMap Unit -> List String
groupNames [] _ = []
groupNames ((n, _) :: rest) seen = match omLookup n seen
  Some _ => groupNames rest seen
  None => n :: groupNames rest (omInsert n () seen)

-- process one dependency component of a where block: bind names, infer,
-- generalize
processLetGroup : TcEnv -> List LetBind -> TcEnv
processLetGroup env binds =
  let _ = enterLevel env.teDyn.dcModule ()
  let _ = beginEffectSummaryScope env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let summaries = map (localBindingSummary env.teDyn.dcModule) binds
  let _ =
    fold
      (_ entry => recordLetBindType env.teDyn.dcModule.mcGraph entry)
      ()
      (zipL binds summaries)
  let placeholders = map (p => (fst p, monoScheme (snd p).bsValue)) summaries
  let recursive =
    map (p => (fst p, monoScheme (snd p).bsRecursiveValue)) summaries
  let env2 = extendLocalVars env recursive
  let _ =
    fold
      (_ bind => forgetLocalAbs env.teDyn.dcModule.mcGraph (letBindName bind))
      ()
      binds
  let lscopes = inferLetBinds env2 (zipL binds summaries)
  let _ =
    fold (_ entry => checkRecursiveValue env.teDyn (snd entry)) () summaries
  let residuals =
    finishValueEffectsKeeping
      env.teDyn
      (map (letBindGeneralizes env) (zipL binds summaries))
  let _ = flushPendingEscapes env.teDyn.dcModule env.teDyn.dcGroup
  let _ = exitLevel env.teDyn.dcModule ()
  -- PLAN.md #11 / D4, as a where block narrows it (#3487): ground the Num-only
  -- vars owned by this just-exited component that no member's type mentions
  -- (nothing can generalize them).  One a member's type does mention, even in
  -- return position, generalizes with its constraint, so a sibling or the
  -- enclosing body instantiates it (`two _ = 2` beside `go y = y / two ()`);
  -- the enclosing binding's boundary decides what its uses leave ambiguous.
  -- Scoped to this group's newly added obligations.
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let _ = improveLocalGoals env.teDyn addedObls callN0
  let memberMonos = map (p => schemeMono (snd p)) placeholders
  let _ = finalizeNumBoundary env.teDyn NumBoundary {
    nbDisposition =
      NumBoundaryOwnedGroup (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
    nbMembers = memberMonos,
    nbSurvivingIds = omEmpty,
    nbDefaultObls = addedObls,
    nbAmbiguityObls = addedObls,
    nbGuard = localNumGuard env.teDyn.dcModule addedObls callN0,
  }  -- RETPOS soundness
  let genv = generalizeGroup env residuals 0 (zipL binds placeholders)
  -- Round-2 adversarial break "let-alias evasion" (#816): a LOCAL constrained
  -- binding (`let f = hh` re-generalizing `hh : Num x => x -> x`) previously
  -- registered NOTHING in schemeObligationsRef — only top-level SCCs did — so a
  -- later use `f x` instantiated no obligation at all: the one recorded at the
  -- RHS occurrence stayed on a var the generalization then orphaned, Int
  -- defaulting quietly satisfied it, and a scheme-var instantiation sailed
  -- through check into an eval panic / native SEGFAULT.  Register the group
  -- exactly as processSCC does; instantiateVarTracked's per-use re-recording
  -- then feeds the same call-obligation window every checker reads.  Name
  -- collisions across bodies are safe: the obligation ids are the scheme's own
  -- quantified ids, and substMonos skips entries whose ids a different scheme's
  -- instantiation does not map.
  let callOblsDelta = callOblsWindow env.teDyn.dcModule callN0
  let schemes = groupSchemesOf genv binds
  let _ = fold (_ p => declareQuantified env.teDyn.dcModule (snd p)) () schemes
  -- #827/#838 I2: register EVERYWHERE, not only inside a method body.  The
  -- uniform deferral (`undeterminedGoalExempt`'s OD2 test) makes a generalizable
  -- where/let var defer into the enclosing scheme rather than trip an ambiguity
  -- reject, closing the orphaned-local-constraint S0 (#827).  See registerLocalScheme.
  -- #838 I5: dict-slot forwarding rides callOblsDelta's PCallSlot obligations (see
  -- registerLocalScheme); the redundant `allDictObls` re-derivation is retired.
  let _ =
    registerSchemeObligations
      env.teDyn.dcModule
      omEmpty
      []
      callOblsDelta
      addedObls
      schemes
  let _ = registerLocalGroupAbs genv oblN0 callN0 (zipL binds lscopes)
  genv

-- A where/let group member's own type cell, the one its clauses are inferred
-- into, published with the member's declared parameter count.  A member is never
-- signed: a `LetBind` carries no type signature.
recordLetBindType : GraphCtx -> (LetBind, (String, BindingSummary)) -> Unit
recordLetBindType gctx (LetBind name _ _ bid, (_, summary)) =
  recordBinderType gctx bid name summary.bsValue (Some summary.bsArity) False

-- Whether a where/let group member generalizes, and its type.
letBindGeneralizes : TcEnv ->
  (LetBind, (String, BindingSummary)) ->
  (Bool, Mono)
letBindGeneralizes env (LetBind _ clauses _ _, (_, summary)) =
  (clausesAreValue env clauses, summary.bsValue)

registerLocalGroupAbs : TcEnv ->
  Int ->
  Int ->
  List (LetBind, Option ScopeId) ->
  Unit
registerLocalGroupAbs env _ _ [] = ()
registerLocalGroupAbs genv oblN0 callN0 ((bind@(LetBind name _ _ _), lscope) :: rest) =
  let _ = match lookupVar genv name
    Some sch =>
      registerLocalAbsIf genv.teDyn.dcModule name lscope sch oblN0 callN0
    None => ()
  registerLocalGroupAbs genv oblN0 callN0 rest

-- the generalized (name, scheme) pairs of a just-closed local group
groupSchemesOf : TcEnv -> List LetBind -> List (String, Scheme)
groupSchemesOf env [] = []
groupSchemesOf genv ((LetBind name _ _ _) :: rest) = match lookupVar genv name
  Some sch => (name, sch) :: groupSchemesOf genv rest
  None => groupSchemesOf genv rest

localBindingSummary : ModuleCtx -> LetBind -> (String, BindingSummary)
localBindingSummary mctx (LetBind name clauses _ _) =
  let arity = match map funClausePair clauses
    (pats, _) :: _ => listLen pats
    [] => 0
  (name, newBindingSummary arity (freshVar mctx) (freshEffectSummary mctx))

inferLetBinds : TcEnv ->
  List (LetBind, (String, BindingSummary)) ->
  List (Option ScopeId)
inferLetBinds env [] = []
inferLetBinds env ((bind@(LetBind name clauses _ _), (_, owned)) :: rest) =
  let pairs = map funClausePair clauses
  let lscope =
    if isLocalAbsName name then
      Some (openLocalScope env.teDyn.dcModule name)
    else
      None
  let _ = inferMemberClauses env None owned pairs
  let _ = closeLocalScope env.teDyn.dcModule lscope
  let _ = match pairs
    [([], _)] =>
      performEffect
        env.teDyn.dcModule
        env.teDyn.dcModule.mcCells.curEffect
        owned.bsForce
    _ => ()
  lscope :: inferLetBinds env rest

-- The D3 channel rule is an identity intersection, not whole-type reachability:
-- only roots constrained by this boundary's own Num obligations can survive, and
-- only when the supplied head/dictionary channels carry that exact live root.
numChannelRootSet : List UObligation -> List Mono -> OrdMap Unit
numChannelRootSet obls channels =
  let channelIds = monoRootIdSet channels
  omFromNames
    (filterList
      (name => omHasKey name channelIds)
      (map intToString (dedupI (numConstrainedIds obls))))
    omEmpty

generalizeGroup : TcEnv ->
  List (Int, AuthResidual) ->
  Int ->
  List (LetBind, (String, Scheme)) ->
  TcEnv
generalizeGroup env _ _ [] = env
generalizeGroup env residuals index ((LetBind name clauses _ _, (_, sch)) :: rest) =
  let mono = schemeMono sch
  let isVal = clausesAreValue env clauses
  -- WS-2: α scope-seed — single-clause zero-param bindings only (mirror α's
  -- alphaCollectBinds rule); a multi-clause / parameterized binding is not a
  -- known prefix.
  let env1 =
    extendLocalVar
      env
      name
      (genBindingRestricted
        env.teDyn
        Tip
        (residualsOf index residuals)
        isVal
        pureRow
        mono)
  let env2 = match clauses
    [FunClause [] rhs] => seedAlphaLets env1 name rhs
    _ => env1
  generalizeGroup env2 residuals (index + 1) rest

-- A where-clause binding is a value (generalizable) iff every clause has params
-- (it's a function) or its zero-arg RHS is non-expansive.
clausesAreValue : TcEnv -> List FunClause -> Bool
clausesAreValue env clauses = allList (clauseIsValue env) clauses

clauseIsValue : TcEnv -> FunClause -> Bool
clauseIsValue env (FunClause [] rhs) = isNonexpansive env rhs
clauseIsValue env (FunClause _ _) = True

-- ── elaboration: resolve return-position method dispatch (RKey) ────────────
-- Rewrite each return-position method occurrence to EMethodAt (with a fresh route
-- ref), type-check (recording the sites), then stamp each site's route from its
-- now-resolved result type.  Returns the SAME tree (refs filled) for eval.
-- There is no flat elaboration driver left: every caller goes through the
-- 1-module `elaborateOne` (the typed/dict tree of the degenerate 1-module multi
-- path).

-- ── 1-module wrapper over the multi-module path ────────────────────────────
-- elaborateOne runs the SINGLE program [prog] (the user's decls, the live prelude
-- ALREADY shadow-dropped by the caller) through elaborateModules as the degenerate
-- 1-module list [(rootId, prog)], returning the flat shape its callers consume:
-- core2 (dict-passed core) ++ the dict-passed module's decls.
--
-- The 1-module case automatically satisfies that shape's invariants — one
-- `freshModuleCtx` (one module ⇒ one checkModuleFullImpl), zero imports ⇒ the full
-- constraint set, and elaborateModules runs the eval-dict layer unconditionally
-- (ARGSTAMP-UNIFY Phase 4), so the return-position constrained-fn dict layer is
-- present here too.
--
-- The dict-name set is the module path's own: elaborateModules computes it via
-- `moduleDictNames` (the prelude's constrained names followed by the module graph's
-- FULL `constrainedSigNames`), rather than taking an externally built list.  This
-- wrapper therefore takes `coreDecls` SEPARATE (not pre-flattened into prog),
-- exactly as elaborateModules expects.  The grader for the Flat-vs-Module relation
-- is test/diff_compiler_flat_vs_onemodule.sh (ARCH B-2.1-a): it now pins the
-- own acceptance and diagnostics, and grades the relation only through a clause
-- true on both sides of the #1564 fix — every arm that ACCEPTS must compute the
-- same value.  Read its header before changing either arm.
export
elaborateOne : DriveInputs ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  List Decl
elaborateOne inputs runtimeDecls coreDecls prog =
  fst (elaborateOneFacts inputs runtimeDecls coreDecls prog)

-- `elaborateOne` with the `ProgramFacts` value its elaboration built, for a caller that lowers
-- the flat decls.
export
elaborateOneFacts : DriveInputs ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  (List Decl, ProgramFacts)
elaborateOneFacts inputs runtimeDecls coreDecls (rootId, prog) =
  let elab = elaborateModules inputs runtimeDecls coreDecls [(rootId, prog)]
  let (coreD, modules, _, _, _, _, _) = elab
  (coreD ++ flatMap snd modules, factsOfElab elab)

-- #415 item 3: the ONLY writer of dictEligibleRef / dictEligibleSetRef.  The set is
-- DERIVED from the list here rather than mirrored at each set site, so the two cannot
-- drift: there is no longer a second side for a future edit to be absent from.  (Both
-- former sites hand-wrote `namesToSet <names> omEmpty` next to the list store; the
-- module site additionally recomputed `moduleUserFnNames modules` for the mirror.)
setDictEligible : GraphCtx -> List String -> Unit
setDictEligible gctx names =
  gctx.dictEligibleRef := names
  gctx.dictEligibleSetRef := namesToSet names omEmpty

-- the USER modules' top-level fn names (NOT core/prelude) — the promotion-eligible
-- set on the build path. Mirrors the retired elaborator's user-function eligibility.
moduleUserFnNames : List (String, List Decl) -> List String
moduleUserFnNames modules =
  dedup (flatMap (p => map fst (funDefs (snd p))) modules)

-- the user program's top-level functions carrying a `=>` constraint in their
-- signature — the set the graph driver dictionary-passes
export
constrainedSigNames : List Decl -> List String
constrainedSigNames prog = flatMap constrainedSigName prog

-- The PRELUDE's own `=>`-constrained fns that must ALSO be dict-passed: those
-- whose body uses a return-position method (`when`/`unless` use `pure`), so
-- arg-tag dispatch can't resolve it at a constraint variable's type.  Every OTHER
-- constrained prelude fn (sum/any/elem/clamp/…) uses only arg-position methods —
-- arg-tag already resolves those, and the goldens type-check with them on RKey, so
-- they stay OUT.  [allDecls] supplies the interface set for returnPosMethodNames;
-- bodies come from [preludeDecls] (the shadow-dropped prelude).
export
preludeReturnPosDictNames : List Decl -> List Decl -> List String
preludeReturnPosDictNames preludeDecls allDecls =
  let rpNames = returnPosMethodNames allDecls
  filterList
    (n => anyMember (declBodyVars n preludeDecls) rpNames)
    (constrainedSigNames preludeDecls)

-- D3b-2: the PRELUDE's `=>`-constrained fns that dispatch a method in ARGUMENT
-- position (the ~23 helpers: neq/elem/any/all/find/count/sum/product/maximum/
-- minimum/clamp/flatMap/flat/debugListItems/displayListItems/hashListItems/print/
-- println).  These stay OUT of the eval/golden dict set — arg-tag resolves them in
-- ceval (tagged values) and the goldens type-check with them on RKey — but the
-- NATIVE emit path MUST dict-pass them: arg-tag cannot dispatch on a PRIMITIVE
-- element (an `Int`/`String` immediate carries no cell tag).  The arg-position
-- analogue of preludeReturnPosDictNames: every constrained prelude fn that is NOT
-- already return-position.  Wired (alongside preludeReturnPosDictNames) into the
-- emit + dict_pp-oracle drivers ONLY (llvm_emit_typed_main / core_ir_dict_pp_main),
-- which no golden driver shares — so module/`=== TYPES ===`/eval goldens stay
-- byte-identical; the body sites route RDict $dict_<method>_<slot> through the same
-- activeDictVars layer registerConstraintRegs already builds for return-position.
export
preludeArgPosDictNames : List Decl -> List Decl -> List String
preludeArgPosDictNames preludeDecls allDecls =
  let rpSet = preludeReturnPosDictNames preludeDecls allDecls
  filterList (n => not (contains n rpSet)) (constrainedSigNames preludeDecls)

-- the EVars referenced anywhere in [n]'s definition body (multi-clause: union)
declBodyVars : String -> List Decl -> List String
declBodyVars n decls = flatMap (declBodyVarsOf n) decls

declBodyVarsOf : String -> Decl -> List String
declBodyVarsOf n (DFunDef _ m _ body _ _)
  | n == m = allEVars body
  | otherwise = []
declBodyVarsOf _ _ = []

-- The `ArgRw` hook that records nothing: every marker but the group-recursive one
-- (`markRecursiveOccurrences`) reads the dict application's route out of the goal
-- inference pushes for it, so it has nothing to do at mark time.
noDictHook : String -> EvId -> Unit
noDictHook _ _ = ()

-- Mint one dict-application node and tell the hook about it.
mintDictAt : ModuleCtx -> (String -> EvId -> Unit) -> String -> Expr
mintDictAt mctx onDict n =
  let ev = freshEvId mctx ()
  let _ = onDict n ev
  EDictAt n ev

-- rewrite a decl body with its own parameters seeded into the bound set.  Mirrors
-- desugar's mapDecl coverage exactly (DFunDef / DInterface / DImpl / DProp /
-- DTest / DAttrib; everything else — incl. DLetGroup — left unchanged),
-- so with the emit path off this would degenerate to the same node set mapProg
-- visits.
prePassDeclScoped : ModuleCtx -> ArgRw -> Decl -> Decl
prePassDeclScoped mctx rw (DFunDef pub n ps e site bid) =
  DFunDef
    pub
    n
    ps
    (rewriteArgScoped mctx rw (boundOfList (patVarsListTc ps)) e)
    site
    bid
prePassDeclScoped mctx rw (d@(DInterface { methods, ... })) =
  DInterface { d | methods = map (prePassIfaceMethodScoped mctx rw) methods }
prePassDeclScoped mctx rw (d@(DImpl { methods, ... })) =
  DImpl { d | methods = map (prePassImplMethodScoped mctx rw) methods }
prePassDeclScoped mctx rw (DProp pub name params body) =
  DProp
    pub
    name
    params
    (rewriteArgScoped mctx rw (boundOfList (propParamNamesTc params)) body)
prePassDeclScoped mctx rw (DTest pub name body) =
  DTest pub name (rewriteArgScoped mctx rw omEmpty body)
prePassDeclScoped mctx rw (DAttrib attrs d) =
  DAttrib attrs (prePassDeclScoped mctx rw d)
-- Top-level `let rec … with …` (DLetGroup): mapDecl/the catch-all skip its bodies,
-- so a constrained-fn occurrence inside a group body would never be rewritten to
-- EDictAt/EMethodAt → its call site gets no dict route → the dict-passed callee is
-- under-applied at eval.  Rewrite each clause body with that clause's params scoped
-- in, exactly like the DFunDef arm.
prePassDeclScoped mctx rw (DLetGroup pub binds) =
  DLetGroup pub (map (prePassLetBindScoped mctx rw) binds)
prePassDeclScoped mctx _ d = d

prePassLetBindScoped : ModuleCtx -> ArgRw -> LetBind -> LetBind
prePassLetBindScoped mctx rw (LetBind n clauses site bid) =
  LetBind n (map (prePassFunClauseScoped mctx rw) clauses) site bid

prePassFunClauseScoped : ModuleCtx -> ArgRw -> FunClause -> FunClause
prePassFunClauseScoped mctx rw (FunClause ps e) =
  FunClause ps (rewriteArgScoped mctx rw (boundOfList (patVarsListTc ps)) e)

prePassIfaceMethodScoped : ModuleCtx -> ArgRw -> IfaceMethod -> IfaceMethod
prePassIfaceMethodScoped mctx _ (IfaceMethod n ty None mloc) =
  IfaceMethod n ty None mloc
prePassIfaceMethodScoped mctx rw (IfaceMethod n ty (Some (MethodDefault ps e)) mloc) =
  IfaceMethod
    n
    ty
    (Some
      (MethodDefault
        ps
        (rewriteArgScoped mctx rw (boundOfList (patVarsListTc ps)) e)))
    mloc

prePassImplMethodScoped : ModuleCtx -> ArgRw -> ImplMethod -> ImplMethod
prePassImplMethodScoped mctx rw (ImplMethod n ps e) =
  ImplMethod n ps (rewriteArgScoped mctx rw (boundOfList (patVarsListTc ps)) e)

-- #1031: `bound` is an OrdMap-backed SET (name -> ()), not a `List String`
-- scanned by `contains` — a deep local nesting (N sequential lets, a reference
-- to an outer binding) made `contains n bound` an O(depth) scan per EVar,
-- O(depth²) over the body (the `scoperefs` shape).  `boundInsert`/`boundOfList`
-- extend it; membership is `omHasKey`.  A name maps to "" for an ordinary binder
-- and to the renamed binder for a candidate let binder (`letPatRename`).
boundInsert : List String -> OrdMap String -> OrdMap String
boundInsert [] b = b
boundInsert (n :: rest) b = boundInsert rest (omInsert n "" b)

-- A let binder that `isNonexpansive` may generalize: every such binder must be able
-- to take dictionary parameters, since generalizing one over a class predicate without
-- abstracting it would share one dictionary between uses at different types.  This
-- runs before inference, without the constructor table, so it over-approximates
-- `isCtorAppSpine` by the head's spelling alone.  A candidate that does not generalize
-- with predicates abstracts nothing and its uses stay plain variables.
localAbsCandidate : Expr -> Bool
localAbsCandidate (ELoc _ e) = localAbsCandidate e
localAbsCandidate (EDoOrigin _ e) = localAbsCandidate e
localAbsCandidate (EAnnot e _) = localAbsCandidate e
localAbsCandidate (EHeadAnnot e _) = localAbsCandidate e
localAbsCandidate (ELit _) = True
localAbsCandidate (EVar _) = True
localAbsCandidate (EVarId _ _) = True
localAbsCandidate (EMethodAt _ _ _) = True
localAbsCandidate (EDictAt _ _) = True
localAbsCandidate (EMethodRef _) = True
localAbsCandidate (ELam _ _) = True
localAbsCandidate (ETuple es) = allList localAbsCandidate es
localAbsCandidate (EListLit es) = allList localAbsCandidate es
localAbsCandidate (app@(EApp _ _)) = localAbsCtorSpine app
localAbsCandidate (ERecordCreate _ fs) =
  allList
    (fa => match fa
      FieldAssign _ e => localAbsCandidate e)
    fs
localAbsCandidate _ = False

localAbsCtorSpine : Expr -> Bool
localAbsCtorSpine (ELoc _ e) = localAbsCtorSpine e
localAbsCtorSpine (EDoOrigin _ e) = localAbsCtorSpine e
localAbsCtorSpine (EApp f x) = localAbsCtorSpine f && localAbsCandidate x
localAbsCtorSpine (EVar name) = ctorHeadShaped name
localAbsCtorSpine (EVarId name _) = ctorHeadShaped name
localAbsCtorSpine _ = False

localAbsCandidateBind : LetBind -> Bool
localAbsCandidateBind (LetBind _ clauses _ _) =
  anyList localAbsCandidateClause clauses

localAbsCandidateClause : FunClause -> Bool
localAbsCandidateClause (FunClause [] body) = localAbsCandidate body
localAbsCandidateClause (FunClause _ _) = True

-- A candidate let binder is renamed to a name no other binder carries, so the
-- binder and every occurrence of it name ONE binding for the rest of the pipeline;
-- the bound map sends the source name to the new one, and its occurrences are
-- marked `EDictAt` so a use can carry the dictionaries the binder abstracts.  A
-- name that is already one (a tree marked a second time) is an ordinary binder.
letPatRename : GraphCtx -> Pat -> Expr -> OrdMap String -> (Pat, OrdMap String)
letPatRename gctx (PVar x l bid) e1 b
  | localAbsCandidate e1 && not (isLocalAbsName x) =
    let fresh = freshLocalAbsName gctx x
    (PVar fresh l bid, omInsert x fresh b)
letPatRename gctx p _ b = (p, boundInsert (patVarsTc p) b)

bindsRename : GraphCtx ->
  List LetBind ->
  OrdMap String ->
  (List LetBind, OrdMap String)
bindsRename gctx [] b = ([], b)
bindsRename gctx ((bind@(LetBind n clauses site bid)) :: rest) b =
  let (n2, b1) =
    if localAbsCandidateBind bind && not (isLocalAbsName n) then
      let fresh = freshLocalAbsName gctx n
      (fresh, omInsert n fresh b)
    else
      (n, boundInsert [n] b)
  let (rest2, b2) = bindsRename gctx rest b1
  (LetBind n2 clauses site bid :: rest2, b2)

boundOfList : List String -> OrdMap String
boundOfList ns = boundInsert ns omEmpty

-- the core scope-threaded rewrite.  `bound` is the set of names in scope as
-- locals at this node.  At an EVar: the rp arm is scope-blind (unchanged); the
-- arg-position (`an`) and constrained-fn (`dn`) arms fire only when the name is
-- NOT shadowed by a local.  Binders
-- (ELam/ELet/ELetGroup/EMatch arms/EBlock/EDo + the where/do/guard
-- binders) extend `bound`; every other node recurses into its children with the
-- same `bound`.
rewriteArgScoped : ModuleCtx -> ArgRw -> OrdMap String -> Expr -> Expr
rewriteArgScoped mctx (ArgRw rp dn an sm onDict granted) bound (EVar n)
  -- P0-18: `n` is a MANGLED definer-shadow standalone (`<mid>__size`).  Mark it
  -- `EMethodAt` with the BARE dispatch name (so `implFor` finds the impl when the
  -- receiver has one) and seed the route's `RLocal <n>` fallback with the mangled
  -- symbol (so a no-impl receiver still reaches the standalone `@mdk_<mid>__size`).
  | omHasKey n bound = match omLookup n bound
    Some "" => EVar n
    Some renamed => EDictAt renamed (freshEvId mctx ())
    None => EVar n
  | otherwise = match lookupAssoc n sm
    Some bare => EMethodAt bare n (mintMethodCell mctx n)
    None =>
      if omHasKey n rp || omHasKey n an then
        EMethodAt n "" (mintMethodCell mctx "")
      else if omHasKey n dn then
        mintDictAt mctx onDict n
      else if granted n then
        mintGrantOnly mctx n
      else
        EVar n
-- A grant-only use of a member its group has just promoted becomes that member's
-- dictionary application, under the same id.
rewriteArgScoped mctx (ArgRw _ dn _ _ onDict _) _ (EDictAt n ev)
  | isGrantOnlyEv mctx.mcGraph ev && omHasKey n dn =
    let _ = unmarkGrantOnly mctx.mcGraph ev
    let _ = onDict n ev
    EDictAt n ev
  | otherwise = EDictAt n ev
-- No `EVarId` arm: every marker runs BEFORE resolve's binding-id stamp (the Flat
-- arm's whole-program pre-pass, and the schedule's per-group `markGroupClauses` →
-- `stampGroupClauses`), so a stamped occurrence never reaches this rewrite.
-- binders
rewriteArgScoped mctx rw bound (ELam ps body) =
  ELam ps (rewriteArgScoped mctx rw (boundInsert (patVarsListTc ps) bound) body)
rewriteArgScoped mctx rw bound (ELet m r p e1 e2) =
  let (p2, after) = letPatRename mctx.mcGraph p e1 bound
  let b1 = if r then after else bound
  ELet
    m
    r
    p2
    (rewriteArgScoped mctx rw b1 e1)
    (rewriteArgScoped mctx rw after e2)
rewriteArgScoped mctx rw bound (ELetGroup binds e2) =
  let (binds2, bnd) = bindsRename mctx.mcGraph binds bound
  ELetGroup
    (map (rewriteArgLetBind mctx rw bnd) binds2)
    (rewriteArgScoped mctx rw bnd e2)
rewriteArgScoped mctx rw bound (EMatch e0 arms) =
  EMatch
    (rewriteArgScoped mctx rw bound e0)
    (map (rewriteArgArm mctx rw bound) arms)
rewriteArgScoped mctx rw bound (EBlock stmts) =
  EBlock (rewriteArgStmts mctx rw bound stmts)
rewriteArgScoped mctx rw bound (EDo d stmts) =
  EDo d (rewriteArgStmts mctx rw bound stmts)
-- non-binder composites: recurse children with the same bound
rewriteArgScoped mctx rw bound (ELoc l e) =
  ELoc l (rewriteArgScoped mctx rw bound e)
rewriteArgScoped mctx rw bound (EDoOrigin l e) =
  EDoOrigin l (rewriteArgScoped mctx rw bound e)
rewriteArgScoped mctx rw bound (EApp f x) =
  EApp (rewriteArgScoped mctx rw bound f) (rewriteArgScoped mctx rw bound x)
rewriteArgScoped mctx rw bound (EIf c t e) =
  EIf
    (rewriteArgScoped mctx rw bound c)
    (rewriteArgScoped mctx rw bound t)
    (rewriteArgScoped mctx rw bound e)
-- An operator site is minted once: `markRecursiveOccurrences` re-marks bodies
-- inference already wrote through these ids, so a minted id passes through.
rewriteArgScoped mctx rw bound (EBinOp op l r ev) =
  let l2 = rewriteArgScoped mctx rw bound l
  let r2 = rewriteArgScoped mctx rw bound r
  EBinOp op l2 r2 (mintedOr (mintOpSite mctx) ev)
rewriteArgScoped mctx rw bound (EUnOp op x ev) =
  let x2 = rewriteArgScoped mctx rw bound x
  EUnOp op x2 (mintedOr (mintOpSite mctx) ev)
rewriteArgScoped mctx rw bound (EInfix op l r) =
  EInfix
    op
    (rewriteArgScoped mctx rw bound l)
    (rewriteArgScoped mctx rw bound r)
rewriteArgScoped mctx rw bound (EFieldAccess e0 n ev) =
  EFieldAccess
    (rewriteArgScoped mctx rw bound e0)
    n
    (mintedOr (mintHeadSite mctx) ev)
rewriteArgScoped mctx rw bound (ETuple es) =
  ETuple (map (rewriteArgScoped mctx rw bound) es)
rewriteArgScoped mctx rw bound (EListLit es) =
  EListLit (map (rewriteArgScoped mctx rw bound) es)
rewriteArgScoped mctx rw bound (EArrayLit es) =
  EArrayLit (map (rewriteArgScoped mctx rw bound) es)
rewriteArgScoped mctx rw bound (ERangeList lo hi i) =
  ERangeList
    (rewriteArgScoped mctx rw bound lo)
    (rewriteArgScoped mctx rw bound hi)
    i
rewriteArgScoped mctx rw bound (ERangeArray lo hi i) =
  ERangeArray
    (rewriteArgScoped mctx rw bound lo)
    (rewriteArgScoped mctx rw bound hi)
    i
rewriteArgScoped mctx rw bound (ESlice e0 lo hi i) =
  ESlice
    (rewriteArgScoped mctx rw bound e0)
    (rewriteArgScoped mctx rw bound lo)
    (rewriteArgScoped mctx rw bound hi)
    i
rewriteArgScoped mctx rw bound (EIndex e0 i) =
  EIndex (rewriteArgScoped mctx rw bound e0) (rewriteArgScoped mctx rw bound i)
rewriteArgScoped mctx rw bound (EAnnot e0 t) =
  EAnnot (rewriteArgScoped mctx rw bound e0) t
rewriteArgScoped mctx rw bound (EHeadAnnot e0 t) =
  EHeadAnnot (rewriteArgScoped mctx rw bound e0) t
rewriteArgScoped mctx rw bound (ERecordCreate n fs) =
  ERecordCreate n (map (rewriteArgField mctx rw bound) fs)
rewriteArgScoped mctx rw bound (ERecordUpdate e0 fs ev) =
  ERecordUpdate
    (rewriteArgScoped mctx rw bound e0)
    (map (rewriteArgField mctx rw bound) fs)
    (mintedOr (mintHeadSite mctx) ev)
rewriteArgScoped mctx rw bound (EVariantUpdate c e0 fs) =
  EVariantUpdate
    c
    (rewriteArgScoped mctx rw bound e0)
    (map (rewriteArgField mctx rw bound) fs)
rewriteArgScoped mctx rw bound (EStringInterp parts) =
  EStringInterp (map (rewriteArgInterp mctx rw bound) parts)
rewriteArgScoped mctx rw bound (EGuards arms) =
  EGuards (map (rewriteArgGuardArm mctx rw bound) arms)
rewriteArgScoped mctx rw bound (ESection (SecRight op e0)) =
  ESection (SecRight op (rewriteArgScoped mctx rw bound e0))
rewriteArgScoped mctx rw bound (ESection (SecLeft e0 op)) =
  ESection (SecLeft (rewriteArgScoped mctx rw bound e0) op)
rewriteArgScoped mctx rw bound (EMapLit n kvs) =
  EMapLit n (map (rewriteArgKv mctx rw bound) kvs)
rewriteArgScoped mctx rw bound (ESetLit n es) =
  ESetLit n (map (rewriteArgScoped mctx rw bound) es)
rewriteArgScoped mctx rw bound (EAsPat x sub) =
  EAsPat x (rewriteArgScoped mctx rw bound sub)
-- Numeric literals carry a site id that is minted here, like operators.
rewriteArgScoped mctx _ _ (ENumLit n ev lx) =
  ENumLit n (mintedOr (mintLitSite mctx) ev) lx
rewriteArgScoped mctx _ _ (EWideLit hi lo ev lx) =
  EWideLit hi lo (mintedOr (mintOpSite mctx) ev) lx
-- leaves (ELit / EMethodRef / EDictApp / EVarAt / EMethodAt / EDictAt / SecBare)
rewriteArgScoped mctx _ _ e = e

rewriteArgField : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  FieldAssign ->
  FieldAssign
rewriteArgField mctx rw bound (FieldAssign n e) =
  FieldAssign n (rewriteArgScoped mctx rw bound e)

rewriteArgKv : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  (Expr, Expr) ->
  (Expr, Expr)
rewriteArgKv mctx rw bound (k, v) =
  (rewriteArgScoped mctx rw bound k, rewriteArgScoped mctx rw bound v)

rewriteArgInterp : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  InterpPart ->
  InterpPart
rewriteArgInterp mctx _ _ (InterpStr s) = InterpStr s
rewriteArgInterp mctx rw bound (InterpExpr e) =
  InterpExpr (rewriteArgScoped mctx rw bound e)

rewriteArgLetBind : ModuleCtx -> ArgRw -> OrdMap String -> LetBind -> LetBind
rewriteArgLetBind mctx rw bound (LetBind n clauses site bid) =
  LetBind n (map (rewriteArgFunClause mctx rw bound) clauses) site bid

rewriteArgFunClause : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  FunClause ->
  FunClause
rewriteArgFunClause mctx rw bound (FunClause ps body) =
  FunClause
    ps
    (rewriteArgScoped mctx rw (boundInsert (patVarsListTc ps) bound) body)

-- a match/function arm: the pattern binds for the guards + body; a `| p <- e`
-- guard binds for later guards + the body (threaded left-to-right).
rewriteArgArm : ModuleCtx -> ArgRw -> OrdMap String -> Arm -> Arm
rewriteArgArm mctx rw bound (Arm p gs body) =
  let b0 = boundInsert (patVarsTc p) bound
  let (gs2, bnd) = rewriteArgGuards mctx rw b0 gs
  Arm p gs2 (rewriteArgScoped mctx rw bnd body)

rewriteArgGuardArm : ModuleCtx -> ArgRw -> OrdMap String -> GuardArm -> GuardArm
rewriteArgGuardArm mctx rw bound (GuardArm gs body) =
  let (gs2, bnd) = rewriteArgGuards mctx rw bound gs
  GuardArm gs2 (rewriteArgScoped mctx rw bnd body)

rewriteArgGuards : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  List Guard ->
  (List Guard, OrdMap String)
rewriteArgGuards mctx _ bound [] = ([], bound)
rewriteArgGuards mctx rw bound ((GBool e) :: rest) =
  let e2 = rewriteArgScoped mctx rw bound e
  let (rest2, bnd) = rewriteArgGuards mctx rw bound rest
  (GBool e2 :: rest2, bnd)
rewriteArgGuards mctx rw bound ((GBind p e) :: rest) =
  let e2 = rewriteArgScoped mctx rw bound e
  let (rest2, bnd) =
    rewriteArgGuards mctx rw (boundInsert (patVarsTc p) bound) rest
  (GBind p e2 :: rest2, bnd)

-- do/block statements: a DoBind/DoLet pattern binds for SUBSEQUENT
-- statements (a recursive DoLet also for its own RHS).
rewriteArgStmts : ModuleCtx ->
  ArgRw ->
  OrdMap String ->
  List DoStmt ->
  List DoStmt
rewriteArgStmts mctx _ _ [] = []
rewriteArgStmts mctx rw bound ((DoExpr e) :: rest) =
  DoExpr (rewriteArgScoped mctx rw bound e)
    :: rewriteArgStmts mctx rw bound rest
rewriteArgStmts mctx rw bound ((DoBind p e) :: rest) =
  DoBind p (rewriteArgScoped mctx rw bound e)
    :: rewriteArgStmts mctx rw (boundInsert (patVarsTc p) bound) rest
rewriteArgStmts mctx rw bound ((DoLet m r p e site) :: rest) =
  let (p2, after) = letPatRename mctx.mcGraph p e bound
  let b1 = if r then after else bound
  DoLet m r p2 (rewriteArgScoped mctx rw b1 e) site
    :: rewriteArgStmts mctx rw after rest
rewriteArgStmts mctx rw bound ((DoAssign x e) :: rest) =
  DoAssign x (rewriteArgScoped mctx rw bound e)
    :: rewriteArgStmts mctx rw bound rest
rewriteArgStmts mctx rw bound ((DoFieldAssign x fs e) :: rest) =
  DoFieldAssign x fs (rewriteArgScoped mctx rw bound e)
    :: rewriteArgStmts mctx rw bound rest

-- interface methods carrying a method-level constraint (a `=>` in the method's own
-- signature over any tyvar, e.g. foldMap's `Monoid m`) — rewritten to EMethodAt
-- alongside the return-position methods so the method-level dict can be folded on.
-- Computed structurally before `checkBodyImpl` populates `methodPredicateSlotsRef`.
methodConstraintNames : List Decl -> List String
methodConstraintNames prog = flatMap methodConstraintNamesOfDecl prog

methodConstraintNamesOfDecl : Decl -> List String
methodConstraintNamesOfDecl (DAttrib _ d) = methodConstraintNamesOfDecl d
methodConstraintNamesOfDecl (DInterface { typarams, methods, ... }) =
  flatMap (methodConstraintNameOf typarams) methods
methodConstraintNamesOfDecl _ = []

methodConstraintNameOf : List String -> IfaceMethod -> List String
methodConstraintNameOf typarams (IfaceMethod mname mty _ _)
  | hasMethodLevelConstraint typarams mty = [mname]
  | otherwise = []

-- does this method type carry a leading `=>` constraint over some tyvar? (a
-- method-LEVEL constraint: the method's own context, as opposed to an impl `requires`)
hasMethodLevelConstraint : List String -> Ty -> Bool
hasMethodLevelConstraint typarams (TyConstrained cs t) =
  constraintsHaveMethodLevel typarams cs || hasMethodLevelConstraint typarams t
hasMethodLevelConstraint typarams (TyEffect _ _ t) =
  hasMethodLevelConstraint typarams t
hasMethodLevelConstraint _ _ = False

constraintsHaveMethodLevel : List String -> List Constraint -> Bool
constraintsHaveMethodLevel _ [] = False
constraintsHaveMethodLevel typarams (c :: rest) =
  constraintIsMethodLevel typarams c || constraintsHaveMethodLevel typarams rest

resolveSites : SiteCtx -> OrdMap Unit -> List PendingEntry -> Unit
resolveSites sx _ [] = ()
resolveSites sx rpNames ((PendingEntry name tagRef resultMono encl kind loc scope _) :: rest) =
  let sx = { sx | sxSite = loc }
  let _ = match kind
    SKReturn implRef fullMono =>
      resolveSite
        sx
        rpNames
        name
        tagRef
        implRef
        resultMono
        fullMono
        encl
        loc
        scope
    SKAdmittedReturn ifaceRef implRef fullMono =>
      resolveAdmittedSite sx name ifaceRef tagRef implRef fullMono encl scope
    SKExactReturn implRef request =>
      resolveExactReturnSite
        sx
        rpNames
        name
        tagRef
        implRef
        resultMono
        request
        encl
        loc
        scope
    SKNumReturn predicate fullMono =>
      resolveNumLitSite
        sx
        rpNames
        name
        tagRef
        resultMono
        fullMono
        predicate
        encl
        loc
        scope
    _ => ()
  resolveSites sx rpNames rest

importerAdmittedVerdict : ModuleCtx ->
  ImplEnv ->
  String ->
  List Mono ->
  AdmittedVerdict
importerAdmittedVerdict mctx env name ats = match methodAdmittedHere mctx name
  [] => AdDefer
  ifs =>
    if listLen ifs < 2 then
      AdDefer
    else match admittedDeclHitters mctx env name ifs ats
      None => AdReject ifs
      Some hits => if isEmptyL hits then AdStandalone else AdReject ifs

-- The admitted declarations whose OWN (receiver argument, impl query) pair — S2-DECL
-- (b), both halves from the same declaration — HITS.  `None` if any declaration's pair
-- cannot be evaluated at all, which `importerAdmittedVerdict` reads as an ambiguity.
admittedDeclHitters : ModuleCtx ->
  ImplEnv ->
  String ->
  List IfaceRef ->
  List Mono ->
  Option (List IfaceRef)
admittedDeclHitters mctx _ _ [] _ = Some []
admittedDeclHitters mctx env name (ir :: rest) ats =
  match admittedDeclHits mctx env name ir ats
    None => None
    Some hit =>
      map
        (hs => if hit then ir :: hs else hs)
        (admittedDeclHitters mctx env name rest ats)

-- S2-DECL (a)+(b) for ONE declaration: its receiver argument is the applied argument at
-- ITS OWN dispatch index (not the occurrence's first argument), and the impl query asks
-- about an impl of THAT interface at that receiver's head — over the unchanged
-- graph-global row set (`ieImplExistsForHeadOf` is `ieImplExistsForHead`'s own body).
admittedDeclHits : ModuleCtx ->
  ImplEnv ->
  String ->
  IfaceRef ->
  List Mono ->
  Option Bool
admittedDeclHits mctx env name ir ats = do
  k <- lookupIdxById ir name mctx.mcCells.methodDispatchIdxByIdRef.value
  at <- nthMono k ats
  hk <- headTyconMono at
  Some (ieImplExistsForHeadOf mctx env name hk (Some [ir]))

-- The OUTERMOST dispatch index over the admitted set — the spine node at which every
-- admitted declaration's receiver argument is already inferred, and therefore the only
-- node at which (b)'s per-declaration pairs can be evaluated JOINTLY.  Falls back to
-- `methodDispatchIdx` (the single-winner index) for every name with fewer than two
-- admitted declarations, i.e. for every program that exists today.
importerDispatchIdxOuter : ModuleCtx -> String -> Option Int
importerDispatchIdxOuter mctx name =
  match admittedIdxMax mctx name (methodAdmittedHere mctx name)
    Some k => Some k
    None => methodDispatchIdx mctx name

admittedIdxMax : ModuleCtx -> String -> List IfaceRef -> Option Int
admittedIdxMax mctx _ [] = None
admittedIdxMax mctx name (ir :: rest) =
  let here = lookupIdxById ir name mctx.mcCells.methodDispatchIdxByIdRef.value
  match admittedIdxMax mctx name rest
    None => here
    Some k => match here
      None => Some k
      Some j => Some (maxI j k)

-- Ground each admitted declaration's OWN receiver argument to the standalone's declared
-- domain at that index, before the impl queries are asked — the P0-20 symmetry rule
-- ("ask the impl question about the SAME head the route resolver will") applied once per
-- declaration instead of once per occurrence.  A no-op for every name with fewer than
-- two admitted declarations, since `methodAdmittedHere` answers `[]` there.
groundAdmittedReceivers : TcEnv -> String -> List Mono -> Option Loc -> Unit
groundAdmittedReceivers env mname ats dloc =
  groundAdmittedGo
    env
    mname
    (methodAdmittedHere env.teDyn.dcModule mname)
    ats
    dloc

groundAdmittedGo : TcEnv ->
  String ->
  List IfaceRef ->
  List Mono ->
  Option Loc ->
  Unit
groundAdmittedGo env _ [] _ _ = ()
groundAdmittedGo env mname (ir :: rest) ats dloc =
  let _ =
    match (lookupIdxById
      ir
      mname
      env.teDyn.dcModule.mcCells.methodDispatchIdxByIdRef.value)
      None => ()
      Some k => match nthMono k ats
        None => ()
        Some at =>
          groundShadowReceiver
            env.teDyn
            (importerShadowDomainAt env mname k)
            at
            (definerReceiverIsDictVar env.teDyn mname at)
            dloc
  groundAdmittedGo env mname rest ats dloc

-- ERROR-QUALITY: name the two things that collide, say what the collision costs, then
-- name the fixes.  Callers locate it at the occurrence's head (`appSpineHeadLoc`): an
-- application carries no location of its own, and the location current when the
-- occurrence is reached can belong to whichever module was checked last.  Phrased after `aliasAmbiguityMsg`, the nearest neighbour in this file.
-- The interface list is the SORTED admitted set, so the prose does not encode import
-- order any more than the verdict does (S2-DECL (e)).
pushAmbiguousShadowDecl : ModuleCtx ->
  String ->
  List IfaceRef ->
  Option Loc ->
  Unit
pushAmbiguousShadowDecl mctx name ifs dloc =
  pushTypeErrorHelpFixAt
    mctx
    "T-AMBIGUOUS-SHADOW-DECL"
    dloc
    "`\{name}` is ambiguous here: \{joinWith " and " (map shadowIfaceLabel ifs)} each declare a method `\{name}` and are both in scope; \{ambiguousShadowHelp}"
    ambiguousShadowHelp
    None

-- The method-only sibling of `pushAmbiguousShadowDecl`: no standalone is in scope,
-- so the admitted declarations are the only candidates, and the occurrence decides
-- none of them (`admittedSelection`).  Same sorted interface list, same help.
pushAmbiguousMethod : ModuleCtx -> String -> List IfaceRef -> Option Loc -> Unit
pushAmbiguousMethod mctx name ifs loc =
  pushTypeErrorHelpFixAt
    mctx
    "T-AMBIGUOUS-METHOD"
    loc
    "`\{name}` is ambiguous here: \{joinWith " and " (map shadowIfaceLabel ifs)} each declare a method `\{name}`, and this use does not decide which one it means; bring only one of those interfaces into scope"
    ambiguousShadowHelp
    None

-- The admitted set's one selecting declaration [sel] has method-level constraints,
-- which an admitted-set occurrence records no dictionaries for (`routableSelection`).
-- Same code and help as `pushAmbiguousMethod`: the ambiguity of the spelling is
-- what withholds those dictionaries.
pushUnroutableAdmitted : ModuleCtx ->
  String ->
  List IfaceRef ->
  IfaceRef ->
  Option Loc ->
  Unit
pushUnroutableAdmitted mctx name ifs sel loc =
  pushTypeErrorHelpFixAt
    mctx
    "T-AMBIGUOUS-METHOD"
    loc
    "`\{name}` names a method of more than one interface here (\{joinWith " and " (map shadowIfaceLabel ifs)}); the one this use selects, `\{sel.irName}.\{name}`, has method-level constraints, and a use of a name that more than one interface declares cannot supply their dictionaries; bring only one of those interfaces into scope"
    ambiguousShadowHelp
    None

-- C5: stamp RLocal on each recorded standalone-shadow arg-position site whose
-- receiver mono now grounds to a concrete head tycon with NO impl of the method.
-- The receiver HAS an impl (the genuine-method case, e.g. `toList (Some 7)`) → leave
-- the route untouched (RNone → eval arg-tag-dispatches to the real impl).  An
-- ungrounded receiver (still a tyvar) → leave it (polymorphic, deferred).
-- RLocal only when no impl exists.
-- S-1: the stamp calls routesOfMonosTop — a PURE
-- function of the (union-find-solved) constraint monos — to fill the standalone's own
-- dict routes IN PLACE.  Deliberately NOT routed through pendingDictApps: that list is
-- resolved by resolveDictApps, which runs AFTER this in `moduleStampOrder`, so the stamp
-- would read `[]`.  Resolving inside the stamp is ordering-immune.  An unconstrained
-- standalone has no monos ⇒ routesOfMonosTop returns [] immediately (it cannot even
-- reach its AmbiguousImpl arm) ⇒ `RLocal sym []` ⇒ byte-identical to the pre-S1 stamp.
-- #156 S3d — resolveRLocalSites is DELIBERATELY NOT routed through `entail`, and DICT-
-- SEMANTICS §3 conformance REQUIRES that, rather than merely permitting it.  This pass
-- implements §4 `(var)`'s FIRST premise — binding selection: does this occurrence denote the
-- module's own standalone `sym` or a shadowed interface method?  (Keyed on the solved receiver
-- mono, which is why it runs post-inference.)  That decision reads shadow facts — isDefinerShadow,
-- definerShadowNamesRef — that are NOT components of entailment's domain `(IE, CE, P, π)` (§3
-- resolution-determinism); they are facts about Γ.  Folding them into the one entailment function
-- would make it depend on inputs outside its spec-given domain — violating the very law a merge
-- would invoke.  The tell: the `Some tag` arm treats "a live impl exists" as DO-NOTHING (the name
-- is a genuine method, dispatched elsewhere) and emits RLocal for the NO-impl case — the inverse of
-- `entailInst`'s success condition.  "No π to discharge; the name denotes another binding" is not an
-- evidence statement.  §4 `(var)`'s SECOND premise — the chosen standalone's actual entailment
-- obligations — IS routed through the one engine: every RLocal payload is filled by routesOfMonosTop
-- → entail (EKNestedTop).  So the single-entailment-function law holds at 4-of-5 BY CONSTRUCTION; what
-- stays out is exactly the binding-selection axis §3 never claimed (cf. §8 I1: identity keyed by
-- binding, not bare name).  "Does an impl exist" and "which impl entails" must agree on ONE
-- impl table — a drift between them would be a real dispatch bug.  #415 item 2: that
-- agreement is STRUCTURAL, not a standing obligation.
-- Arch B-2.1-g rebased both reads, together, onto `ModuleCells.mcCells.bodyImplEnvRef`, and the
-- sentence that stood here — "There is no second table in scope to drift TO" — WAS ALREADY
-- FALSE and is what licensed a bad scoping.  `bodyImplEnvRef` has been a second impl table,
-- in scope from anywhere, since B-2.1-a2, and B-2.1-b2 moved three SELECTION legs onto it
-- while this site's two reads stayed on the threaded prefix `[keyTable]`.  `B-2.1-c` then
-- moved the sibling SHADOW existence reads and deferred this one, which produced exactly the
-- drift this block claimed was unreachable: existence answered True off the whole graph while
-- `routesOfMonosTop … keyTable`, one line below, had no row to select — a located reject
-- became exit 0 printing a garbage pointer.  So the agreement is restored the only way it can
-- be, by moving BOTH: `ieImplExistsForHead …bodyImplEnvRef…` directly, and `keyForSite` (also
-- repointed onto `bodyImplEnvRef`) via routesOfMonosTop → routeOf → entail (EKNestedTop) →
-- entailInst.  ⚠️ THE INVARIANT IS UNCHANGED AND IS STILL THE ONE THAT MATTERS: these two
-- reads must name ONE population.  It is no longer enforced by a shared parameter, so it is
-- now enforced by a shared REF — and the check on any future edit here is "does the thing I
-- am reading answer over the same population `keyForSite` selects from?", not "am I using
-- [keyTable]?".  No impl list is threaded through this signature or through
-- `routesOfMonosTop`'s subtree any more.
-- (The inference-time existence reads in `inferShadowApp` / `definerReceiverDispatches` are
-- the same decision at an earlier PHASE and are now on the same ref for the same reason —
-- B-2.1-c's measurement is that a phase split of one decision is as fatal as a table split.
-- ⚠️ Do not re-derive the retired defence "GLOBAL by design — local ∪ imported ∪ prelude":
-- `SHADOW-SEMANTICS.md:242-245` retires that phrase as a false synonym for graph-global, and
-- `shadowKeyTableRef` was in fact the cumulative topological PREFIX on the Module arm.)
resolveRLocalSites : SiteCtx -> List PendingEntry -> Unit
resolveRLocalSites sx [] = ()
resolveRLocalSites sx ((PendingEntry name tagRef am encl kind loc scope _) :: rest) =
  let sx = { sx | sxSite = loc }
  let _ = match kind
    SKRLocal sym forceLocal monos ifaces argVecs =>
      if forceLocal then
        tagRef :=
          RLocal sym (routesOfMonosTopV sx encl scope monos ifaces argVecs)
      else
        resolveRLocalSite sx name tagRef am encl scope sym monos ifaces argVecs
    _ => ()
  resolveRLocalSites sx rest

-- C5: stamp RLocal on each recorded standalone-shadow arg-position site whose
-- receiver mono now grounds to a concrete head tycon with NO impl of the method.
-- The receiver HAS an impl (the genuine-method case, e.g. `toList (Some 7)`):
-- leave the route untouched — eval arg-tag-dispatches on RNone; emit already
-- stamped the correct RKey<receiverHead> via resolveArgStamps.
-- An ungrounded receiver (still a tyvar) → leave it.  The
-- RLocal-vs-ordinary-dispatch split keys the genuine case off the receiver.
resolveRLocalSite : SiteCtx ->
  String ->
  Ref Route ->
  Mono ->
  String ->
  ScopeId ->
  String ->
  List Mono ->
  List IfaceRef ->
  List (List Mono) ->
  Unit
resolveRLocalSite sx name tagRef am encl scope sym monos ifaces argVecs =
  match headTyconMono am
    -- S2 (THE INVERSION): route by SHADOW KIND first, receiver second.
    --   * DEFINER shadow (the name is this module's own top-level fn) → the standalone,
    --     UNCONDITIONALLY.  The impl universe is not consulted; a grounded head with a live
    --     impl no longer steals the call.  (The APP path already forces this via the
    --     RLocalSite `forceLocal` flag; this arm is what carries the other recorders —
    --     notably the VALUE-position sites pushed by the generic recordRLocalSite, which is
    --     gated on standaloneValuesRef and that set holds definer AND importer shadows.)
    --   * IMPORTER shadow (Fork 1) → the OLD per-receiver rule, unchanged: a live impl at the
    --     receiver head dispatches, else the standalone.  An `import` is a SIBLING scope, not
    --     an inner one, so it does not shadow; inverting it too would break the everyday
    --     `import map` pattern (`isEmpty [1,2]` must still reach `Foldable.isEmpty`).
    -- am is the ACTUAL argument type (inferDefinerShadowApp records it), not the standalone's
    -- declared domain, so the importer arm's impl query is still meaningful.
    --
    -- ⚠️ isDefinerShadow — NOT a bare definerShadowNamesRef membership test.  It carries the
    -- SAME gate every typing entry point applies (ifaceMethodName, #54; it was the typaram-
    -- COUNT test singleParamIfaceMethod until S-3 / row 26 was closed).  Routing here on a
    -- gate the typing entry points do not share would route a site whose TYPE came from the
    -- dispatch path — route and type disagreeing is exactly the P0-20 bug class.  Keep the
    -- two gates identical.
    -- ARCH B-2.1-g: graph-global, off `bodyImplEnvRef` — see `ieImplExistsForHead`, and
    -- see the `#415 item 2` block above for why this read could only move TOGETHER with
    -- its sibling selection leg (`routesOfMonosTop … keyTable` → `keyForSite`, likewise
    -- repointed by this bite).  Both now read ONE table again, and it is the same table
    -- the emitter counts over.
    Some tag =>
      -- Route construction solves dictionary obligations. Do it only after
      -- committing to the standalone, never for a discarded method alternative.
      if not (isDefinerShadow sx.sxModule name)
        && ieImplExistsForHead
          sx.sxModule
          sx.sxModule.mcCells.bodyImplEnvRef.value
          name
          tag then
        ()
      else
        tagRef :=
          RLocal sym (routesOfMonosTopV sx encl scope monos ifaces argVecs)
    -- An UNGROUNDED definer-shadow receiver keeps the old default (RLocal → standalone);
    -- other (importer) ungrounded sites stay untouched (deferred/polymorphic).
    None =>
      if omHasKey name sx.sxModule.mcCells.definerShadowNamesRef.value then
        tagRef :=
          RLocal sym (routesOfMonosTopV sx encl scope monos ifaces argVecs)

instantiateMethodPredicateTemplate : GraphCtx ->
  MethodPredicateTemplate ->
  MethodInstantiationSubst ->
  MethodPredicateTemplate
instantiateMethodPredicateTemplate gctx template subst = MethodPredicateTemplate {
  mptInterface = template.mptInterface,
  mptArguments =
    map (instantiateMethodPredicateArgument gctx subst) template.mptArguments,
}

instantiateMethodPredicateArgument : GraphCtx ->
  MethodInstantiationSubst ->
  Option Mono ->
  Option Mono
instantiateMethodPredicateArgument gctx subst argument =
  map
    (substMono gctx subst.misTypeSubst subst.misEffectSubst subst.misAuthSubst)
    argument

-- After the module is inferred, classify each recorded arithmetic operand mono and
-- stamp the supported concrete scalar tag on the node's route. Grounded-only,
-- exactly like resolveBinopSite: a still-
-- polymorphic operand (headTyconMono None) is left untouched (RNone → dict path),
-- so polymorphic-Num arithmetic keeps routing through the runtime Num dict. Never
-- overwrite a route another pass already set (a comparison op has a different
-- node/ref; an arithmetic route starts RNone).
resolveArithSites : List (Ref Route, Mono) -> Unit
resolveArithSites [] = ()
resolveArithSites ((dref, m) :: rest) =
  let _ = resolveArithSite dref m
  resolveArithSites rest

-- EBinOp and EUnOp share ONE dict-route resolution family
-- (resolveOpSites/resolveOpSite/stampOpRouteVal/opDictVarOf), selected by an `isBinop`
-- flag (Roadmap #18c collapsed the binop/unop mirror pair — unopMethodApp already
-- reused binopRouteSplit, proving the shapes unify).  The two paths differ in exactly
-- two flag-keyed places: the dict-var-of policy (opDictVarOf) and the RKey stamp
-- (stampOpRouteVal — its builtin-head guard and Ord-style innerDefaultMethod reduction).
-- #156 S3c: resolveOpSite is now a thin adapter over `entail` (EKOp kind); the inst
-- route is stampOpRouteVal, a pure Route-returning extraction of the old stampOpRoute.
resolveOpSites : SiteCtx -> Bool -> List PendingEntry -> Unit
resolveOpSites sx _ [] = ()
resolveOpSites sx isBinop ((PendingEntry method tagRef operandMono encl kind loc scope _) :: rest) =
  let sx = { sx | sxSite = loc }
  let _ = match kind
    SKOp inImpl =>
      resolveOpSite sx isBinop method tagRef operandMono inImpl encl scope
    SKPredicateOp inImpl predicate =>
      resolvePredicateOpSite
        sx
        isBinop
        method
        tagRef
        operandMono
        inImpl
        predicate
        encl
        scope
    _ => ()
  resolveOpSites sx isBinop rest

-- Gap #21 (CLOSED): element reqs are now forwarded unconditionally on both eval and
-- emit paths.  The impl method `eq`/`compare` carries leading `$dict_*` params
-- (resolveArgStamps runs on both paths); emitter applies them; eval's methodAtNarrow
-- forwards dict reqs (like RDictFwd) truncated to the matched impl's reqCount.

-- ── coherence check (TYPECHECK-AUDIT S3) ───────────────────────────────────
-- Phase 68: reject incoherent USER
-- impl sets at declaration time.  Two impls of the SAME interface whose head
-- types can match the same concrete type (impls_overlap) are unresolvable unless
-- one strictly specializes the other (most-specific-wins).  Genuinely incoherent:
--   • two overlapping impls that are NOT a strict specialization → OverlappingImpls.
-- (Named impls + `@Name` selection + `default impl` were removed 2026-07-11; the
-- newtype-wrapper approach is the answer for a second instance.)
-- Prelude/seeded impls are excluded entirely (the driver passes USER decls only):
-- user impls are meant to override prelude impls (e.g. single-file `impl Ord Int`),
-- so they must not pair with a prelude `impl Ord Int`.  At most ONE error is
-- emitted (mirrors the oracle raising Type_error on the first conflict).

-- 🪦 RETIRED 2026-08-12 (#1559 A-3.7 bite 3.7-9): `cohImplsOf` / `cohImplsOfMid` —
-- the decl-walking adapters that built `CohImpl`s straight off `DImpl` nodes, and
-- `cohCollectImpls` / `cohCollectModuleImpls`, their two list drivers.  Coherence's
-- input is now a projection of `IE`'s rows (`cohImplOfRow`), so both sweeps read the
-- registry the rest of stage K reads instead of re-walking decls.  Zero tree-wide
-- callers at deletion time (`grep -rn 'cohCollectImpls\|cohCollectModuleImpls\|
-- cohImplsOf' --include=*.mdk .` → definitions and comments only).  The `#414` span
-- derivation they carried is preserved below, because `cohImplOfRow` still calls
-- `firstTyLocList` on the row's head and inherits every word of it.
--
-- #414: the span to blame for an impl comes from its head types, via
-- `firstTyLocList` (`frontend/ast.mdk`), which folds `firstTyLoc` — that inner
-- walk is the one shared with resolve (`dupSigOf`); resolve does not call
-- `firstTyLocList` itself (issue 480).
-- A `DImpl` has no `Loc` of its own (`DUse` is the only `Decl` variant
-- carrying one inline) — but the parser stamps every `TyCon` leaf with its span
-- (`parser.mdk`'s parseTyAtom: `tyConUnresolved c (Some (locOfSpan s q))`), so the head's
-- own tycon IS the impl's location.  Pre-order, so `impl C (Pair a Int)` blames
-- `Pair` — the head — not the argument.  An alias head's expansion is located at
-- the alias occurrence (`locateTyAt`), so `impl C LB` still blames `LB`.
--
-- ⚠️ RESIDUAL (#414): only `TyCon` leaves carry spans, so a head with NO tycon —
-- the fully-parametric `impl Foo a` — still yields `None` and falls back to the
-- file-start caret.  That is the degenerate overlap case (`test/
-- typecheck_error_fixtures/overlapping_impls.mdk`).  Closing it needs a span on
-- `TyVar` (an ast.mdk change rippling through every `Ty` consumer) or the parser's
-- `DeclPos` side-table threaded into typecheck; both are out of proportion to an
-- S3 diagnostic-quality fix.  Every head naming a CONCRETE type is covered.
--
-- #1559 A-3.7 OCCURRENCE MINT, and the retirement above is the reason it worked:
-- the deleted adapter destructured `implOrigin` in the SAME record pattern as `iface`
-- and built the `IfaceRef` from that pair on the spot, using the identical expression
-- `implDeclFact` uses to build `ImplRow`'s interface half.  Because the two
-- constructions could not drift, replacing the adapter with a projection of `IE`'s
-- rows yields the same interface half by construction rather than by assertion.
--
-- the impl's head args → monos under ONE shared fresh-var map (so a var reused
-- across args, e.g. `Conv a a`, is the SAME fresh tyvar — the oracle shares one
-- tbl across the whole impl head; distinct impls get distinct ids).
cohFreshTys : ModuleCtx -> List Ty -> List Mono
cohFreshTys mctx tys = snd (implHeadMonos mctx tys)

-- An impl head's variables under their declared kinds: a name in an
-- `Authority`-kinded slot (`impl Eq (Handle p)`) is an authority binder, as
-- in a signature; every other bare name is a type variable.  One map is
-- shared across the head's arguments, so a name reused across them is one
-- variable.
implHeadMonos : ModuleCtx -> List Ty -> (List (String, Mono), List Mono)
implHeadMonos mctx tys =
  let _ = fold (_ ty => checkImplHeadIndices mctx ty) () tys
  let auths = dedupBinders (flatMap (authArgBindersIn mctx) tys) []
  let pats = flatMap (patternSlotNamesIn mctx) tys
  let tvMap =
    freshTvMap
      mctx
      (removeAllS (map fst auths) (dedup (flatMap tyVarNames tys)))
  let etbl =
    sigVarsWithAuths
      (map (b => freshAuthBinderRanged mctx (contains (fst b) pats) b) auths)
      emptySigVars
  (tvMap, map (fromAstTypeE mctx etbl tvMap) tys)

-- An instance is chosen by its head's type constructor and the index is
-- erased, so an impl covers every index of the head: an `Authority` slot of
-- an impl head takes a name, never a written term.
checkImplHeadIndices : ModuleCtx -> Ty -> Unit
checkImplHeadIndices mctx (TyApp a b) = match tyAppSpine (TyApp a b)
  (TyCon { tyConName = n, tyConOrigin = o }, args) =>
    match lookupTab (tyTabKey o n) mctx.mcCells.dataParamKindsRef.value
      Some kinds if listLen kinds == listLen args =>
        fold
          (_ ka => match ka
            (KAuth _ _, TyAuth ps loc) =>
              pushTypeErrorOncePerSite
                mctx
                "T-AUTHORITY-KIND"
                loc
                (implHeadIndexMsg n (ppTy (TyAuth ps loc)))
            _ => ())
          ()
          (zipL kinds args)
      _ => ()
  _ => ()
checkImplHeadIndices mctx _ = ()

-- #1559 A-3.7: THE `IE`→`CohImpl` ADAPTER — coherence's input, relocated off the decl
-- walk.  Every one of the four things coherence judges on comes out of the row:
--   * the interface half is `ieRowTriple`'s `IfaceRef` — the SAME value
--     `cohImplsOfMid` built by hand from `iface`+`implOrigin`, because `implDeclFact`
--     builds it with the identical expression.  That is why this relocation is not an
--     acceptance change: `cohSameIface` (3.7-4) sees the same pair of `IfaceRef`s.
--   * the head is `cohFreshTys` of the row's `List Ty`, the same call the decl
--     adapter made.  Effectful (fresh tyvars), exactly as the decl adapter was.
--     The head is already in alias normal form (`stampGraphDecls`), so
--     coherence compares the head selection reads, and `fromAstTypeE` finds no
--     alias left on it to expand with the checked module's alias table (the
--     wrong table for another module's head).
--   * the owner module id is `instRefMid` of the row's `InstRef` — this is where
--     `InstRef` acquires its FIRST judgment reader in this tree.
--   * the blame span is `firstTyLocList` of that same head.
-- ⚠️ `ieLoc` IS NOT OWED FOR THIS.  `ImplRow`'s "no location field" note argues from
-- `Decl` carrying no `Loc`, which is true and beside the point: the row carries the
-- head's `List Ty`, and the parser stamps every `TyCon` leaf with its span, so the span
-- coherence uses today is recoverable with no new field and no `DImpl` change.
cohImplOfRow : ModuleCtx -> ImplRow -> CohImpl
cohImplOfRow mctx r = match ieRowTriple r
  (ir, tys, _) =>
    CohImpl
      ir
      (cohFreshTys mctx tys)
      (instRefMid (ieRowInst r))
      (orElseLoc (firstTyLocList tys) (ieRowLoc r))

-- The prelude is ordinal 0 on the Module arm, structurally: `buildDeclEnvs` builds
-- `declEnvModulesFrom 0 (("core", coreDecls)::modules)`, so nothing else can be.
-- Coherence compares a program's impls with the prelude's (DICT-SEMANTICS §6.1), but
-- never the prelude's with itself: the prelude is trusted and cannot be edited.
cohPreludeOrd : Int
cohPreludeOrd = 0

-- the prelude's own rows: the second population of the per-module sweep.
cohPreludeRows : ImplEnv -> List ImplRow
cohPreludeRows env = ieRowsOwnedBy cohPreludeOrd env

-- every USER module's rows, for the whole-graph sweep.  The prelude is absent here
-- because a program-vs-prelude pair is owned by the per-module sweep (which sees the
-- prelude and reports with the impl's own span); the whole-graph sweep would report
-- the same pair a second time, span-less.
cohRowsOf : ImplEnv -> List ImplRow
cohRowsOf env = filterList (r => ieRowOrd r /= cohPreludeOrd) (ieRowsAll env)

-- the per-module sweep's own population.  The prelude module itself checks nothing:
-- its rows are the second population, never the first.
cohRowsOwnedBy : Int -> ImplEnv -> List ImplRow
cohRowsOwnedBy cur env
  | cur == cohPreludeOrd = []
  | otherwise = ieRowsOwnedBy cur env

-- subsumes ~general ~specific: is [specific] an instance of [general]?  Only the
-- general side's vars bind (consistently: a var bound twice must see structurally
-- equal types); the specific side's vars are rigid (match only the same id).
cohSubsumes : List Mono -> List Mono -> Bool
cohSubsumes general specific
  | listLen general == listLen specific =
    isSome (matchOneSided cohStep eqInt cohEqMono (zipL general specific) [])
  | otherwise = False

-- Mono-space step: normalize BOTH sides (chasing links), then classify the general
-- node.  Effect rows are row-blind (TEff/TEff ⇒ MOk; TFun's row slot ignored).
cohStep : Mono -> Mono -> MStep Int Mono Mono
cohStep g0 s0 =
  let g = peelQual (normalize g0)
  let s = peelQual (normalize s0)
  match g
    TVar c => MVar (tyvarId c)
    -- #1111 A-2.10 on the `TCon`/`TCon` pairing only (`sameTyConHead`); the
    -- cross-population arms stay name-only for the reason `cohGoR` gives.
    -- ⚠️ The cross-population ones are NOT SEPARATELY PROBED — armed
    -- because the pre-split arm answered them, and because a rigid and a real
    -- head CAN both spell `__tupleN__` (see `Mono.TRigid`).  Measured instances
    -- of that forgery: `unifyN`, `matchStep` (§8 I6.2(b), OWED-#1243).
    TCon a oa => match s
      TCon b ob => if sameTyConHead a oa b ob then MOk else MFail
      TRigid b => if a == b then MOk else MFail
      _ => MFail
    TRigid a => match s
      TRigid b => if a == b then MOk else MFail
      TCon b _ => if a == b then MOk else MFail
      _ => MFail
    TApp f1 a1 => match s
      TApp f2 a2 => MKids [(f1, f2), (a1, a2)]
      _ => MFail
    TFun a1 _ b1 => match s
      TFun a2 _ b2 => MKids [(a1, a2), (b1, b2)]
      _ => MFail
    TEff _ => match s
      TEff _ => MOk
      _ => MFail
    TAuth _ => match s
      TAuth _ => MOk
      _ => MFail

eqInt : Int -> Int -> Bool
eqInt a b = a == b

-- [a] strictly more specific than [b]: b subsumes a but not a subsumes b
cohStrictlyMoreSpecific : List Mono -> List Mono -> Bool
cohStrictlyMoreSpecific a b = cohSubsumes b a && not (cohSubsumes a b)

-- [impls] are paired with each other; each is also paired with every one of [fixed]
-- (the prelude's impls), which are never paired with one another.
cohScan : CohSweep -> List CohImpl -> List CohImpl -> CohScan
cohScan sweep impls fixed = cohScanOuter sweep impls fixed (CohScan None None)

cohScanOuter : CohSweep -> List CohImpl -> List CohImpl -> CohScan -> CohScan
cohScanOuter _ [] _ acc = acc
cohScanOuter sweep (e :: rest) fixed acc
  | cohScanDone acc = acc
  | otherwise =
    cohScanOuter
      sweep
      rest
      fixed
      (cohScanInner sweep e fixed (cohScanInner sweep e rest acc))

-- both classes already witnessed ⇒ nothing later can change what is reported.
cohScanDone : CohScan -> Bool
cohScanDone (CohScan (Some _) (Some _)) = True
cohScanDone _ = False

-- #1559 A-3.7: DO TWO IMPL OCCURRENCES NAME THE SAME INTERFACE?
--
-- 🚨 `sameTyConHead`, NEVER `ifaceIdMatches`, AND THE TWO ARE EXACT INVERSES.  This
-- is the whole substance of the bite, so the derivation is here rather than in a
-- ledger:
--   * `sameTyConHead n1 o1 n2 o2 = n1 == n2 && not (tyConIdsConflict o1 o2)`
--     (`frontend/ast.mdk`) — name equality, and an ABSENT origin makes NO CLAIM, so
--     it matches anything.
--   * `ifaceIdMatches a b = a /= "" && a == b` (`frontend/ast.mdk`) — absence NEVER
--     matches, not even itself.
-- `recordCandIsType`'s header states which to use when, and the rule is about the
-- QUESTION being asked, not about the table: `sameTyConHead` belongs where a false
-- REJECT would refuse a valid program (an ACCEPTANCE question); `ifaceIdMatches`
-- belongs where a false HIT is silent wrongness (a LOOKUP).
--
-- Coherence is an ACCEPTANCE question — it decides whether to reject a program — so
-- `sameTyConHead` is correct, and it is also the FAIL-LOUD direction here: an impl
-- whose `implOrigin` is still `OriginUnresolved` compares by name exactly as it did
-- before this unit, so no live rejection can silently vanish.  `ifaceIdMatches` in
-- this position would turn every unstamped-origin conflict into a SILENT ACCEPT,
-- which is a severity INCREASE and one no fixture in the tree would catch.
--
-- ⚠️ NOT a re-keying of the HEAD half.  Coherence's head comparison already routes
-- through `sameTyConHead` (`cohGoR`'s `TCon` arm, A-2.10) and is untouched, so the
-- #1317 T1 rule and closed S0 #1277 are not in scope for this unit.
cohSameIface : IfaceRef -> IfaceRef -> Bool
cohSameIface a b = sameTyConHead a.irName a.irOrigin b.irName b.irOrigin

cohScanInner : CohSweep -> CohImpl -> List CohImpl -> CohScan -> CohScan
cohScanInner _ _ [] acc = acc
cohScanInner sweep (e1@(CohImpl if1 xs mid1 _)) ((CohImpl if2 ys mid2 _) :: rest) acc
  | cohScanDone acc = acc
  | cohSameIface if1 if2 && cohOverlap xs ys =
    cohScanInner sweep e1 rest (cohClassify sweep e1 xs ys mid1 mid2 acc)
  | otherwise = cohScanInner sweep e1 rest acc

-- classify ONE overlapping pair.  A strict specialization either way is coherent
-- (most-specific-wins ranks it) and contributes nothing.  The remaining two cases
-- are exhaustive and disjoint: `cohStrictlyMoreSpecific a b = cohSubsumes b a && not
-- (cohSubsumes a b)`, so if neither direction is strict then `cohSubsumes` holds
-- BOTH ways (mutual ⇒ HARD) or NEITHER way (incomparable ⇒ SOFT).
-- Keep-first per class mirrors the old "first conflict wins" reporting.
--
-- ⚠️ WHY THE HARD ARM CANNOT SIMPLY MOVE TO THE GOAL SITE, stated because "then fix
-- it there" is the obvious review question and the answer is not "we didn't try".
-- The root is one level up from `entryCovers`: `entryCoversAllOthers` /
-- `findMostSpecificEntry` test for a ⊑-MINIMUM, where §6 C1 requires **at most one
-- ⊑-MINIMAL element**.  In a preorder that is not antisymmetric those two coincide
-- everywhere EXCEPT at α-equal heads — precisely this arm's class.  (`entryCovers`
-- itself is fine: with `S = tySubsumesV`, `tyHeadEqV a b || S b a` is exactly ⊑;
-- it does not conflate ⊒ with =.)  Tightening `entryCoversAllOthers` to demand
-- STRICT specificity was built and measured: it finds 6 true positives and then
-- breaks `stdlib/core.mdk`, which stops typechecking with "the goal `Num Int`
-- matches `impl Num Int` and `impl Num Int`" — checking core as a user program
-- registers the same instance twice, and deduping needs INSTANCE IDENTITY this tree
-- does not have (`bucketKeyEntriesFrom` restarts its numbering at 0 per module, so
-- two distinct impls in different modules share an index).  That is L2 / A-3 / B-2
-- work.  Until it exists, the declaration site is the only place this class is
-- caught at all.
--
-- A program impl α-equal to a PRELUDE impl is this arm's class too: the per-module
-- sweep pairs each program impl with the prelude's impls (DICT-SEMANTICS §6.1), so a
-- user `impl Display String` is rejected at the program's impl.  A strictly more
-- specific program impl is coherent and wins on every engine.
cohClassify : CohSweep ->
  CohImpl ->
  List Mono ->
  List Mono ->
  String ->
  String ->
  CohScan ->
  CohScan
cohClassify sweep e1 xs ys mid1 mid2 (CohScan hard soft)
  | cohStrictlyMoreSpecific xs ys = CohScan hard soft
  | cohStrictlyMoreSpecific ys xs = CohScan hard soft
  | cohMutuallySubsumes xs ys && cohHardInScope sweep mid1 mid2 =
    CohScan
      (cohKeepFirst hard (Some (cohHardMsg e1 xs ys mid1 mid2, cohImplLoc e1)))
      soft
  -- A mutually-subsuming pair the sweep does NOT own contributes nothing at all --
  -- it must not fall through to the soft arm below, because HARD and SOFT are
  -- disjoint classes (mutual subsumption is the exact complement of
  -- ⊑-incomparability here), and reporting it as `W-INCOMPARABLE-IMPLS`
  -- would be a wrong classification, not a quieter one.
  | cohMutuallySubsumes xs ys = CohScan hard soft
  | not (cohSoftInScope sweep mid1 mid2) = CohScan hard soft
  | otherwise =
    CohScan
      hard
      (cohKeepFirst
        soft
        (Some (
          cohIncomparableMsg (cohImplIfaceName e1) xs ys mid1 mid2,
          cohImplLoc e1,
        )))

-- Which sweep OWNS a soft (⊑-incomparable) pair.  Two sweeps run over overlapping
-- inputs: `checkCoherence` over ONE module's own impls and `globalCoherenceConflict`
-- over every user module's impls (real mids).  A pair
-- whose two impls live in the SAME module is seen by BOTH — the per-module one with a
-- real span, the global one span-less (#414) — so recording it in both makes
-- `run`/`build` print it TWICE where `check` prints it once.  The global sweep's
-- unique contribution is the pair that SPANS two modules, which no per-module sweep
-- can see; that is the only soft pair it should claim.
--
-- ⚠️ Scoped to the SOFT class deliberately.  The HARD class double-reports the same
-- way, and that is PRE-EXISTING — it did so as a `T-CONFLICTING-IMPL` error before
-- F-3d, on these same two paths — so narrowing it here would be an unrelated
-- behaviour change riding this one, and one that moves error goldens.
-- 🚨 #1559 A-3.7: SWEEP-SCOPED, NOT MID-SHAPE-SCOPED, AND THE DIFFERENCE IS A
-- LOUD→SILENT REGRESSION THIS FUNCTION USED TO BE ONE COMMIT AWAY FROM.
-- The body was:
--     cohSoftInScope "" ""   = True
--     cohSoftInScope m1 m2   = cohIsCrossModule m1 m2
-- i.e. it asked "are both mids empty?" as a stand-in for "am I the per-module
-- sweep?".  That proxy held only because the per-module sweep's input came from
-- `cohImplsOf`, which had no module id to stamp and so stamped `""`.  Pointing that
-- sweep at `IE` gives every row a REAL id (`instRefMid`), so an intra-module pair
-- arrives as `(m, m)` with `m /= ""` — the first arm stops matching, `cohIsCrossModule
-- m m` is `False`, and EVERY intra-module `W-INCOMPARABLE-IMPLS` silently stops being
-- reported.  Diagnostic-only, so no value golden in this tree could see it.
--
-- The sweep tag says outright what the mid shapes were being read to infer:
--   * `CohSweepOwn` — the per-module sweep.  Its input is ONE module's own rows, so
--     every pair it sees is intra-module BY CONSTRUCTION and it owns all of them.
--     Answering `True` unconditionally is exactly what the old `"" ""` arm did for
--     the only input that sweep ever had.
--   * `CohSweepGlobal` — the whole-graph sweep.  It owns only the pair that SPANS two
--     modules; the intra-module ones already belong to the sweep above.  The `"" ""`
--     arm is retained HERE (and only here) because it is behaviour-preserving for a
--     degenerate global input in which both ids are blank — a shape this function
--     answered `True` for before A-3.7, and one this bite deliberately does not
--     re-adjudicate.
cohSoftInScope : CohSweep -> String -> String -> Bool
cohSoftInScope CohSweepOwn _ _ = True
cohSoftInScope CohSweepGlobal "" "" = True
cohSoftInScope CohSweepGlobal mid1 mid2 = cohIsCrossModule mid1 mid2

-- Which sweep OWNS a HARD (mutually-subsuming) pair.  #1449 / F8: the SAME rule as
-- `cohSoftInScope`, and it is a delegation rather than a copy so the two classes can
-- never drift apart silently.
--
-- 🚨 THIS IS THE NARROWING `cohSoftInScope`'s header DECLINED TO MAKE, now made
-- deliberately.  That header said, of the hard class: "The HARD class double-reports
-- the same way, and that is PRE-EXISTING … so narrowing it here would be an unrelated
-- behaviour change riding this one, and one that moves error goldens."  It is no
-- longer unrelated: the double report IS #1449's shape, and it is user-visible on the
-- most ordinary program there is.  Measured before this change, on a single file with
-- two `impl Foo Int`, `medaka check --json` emitted the identical
-- `T-CONFLICTING-IMPL` message TWICE — once with the declaration's real span (from the
-- per-module sweep, `checkCoherence` / `CohSweepOwn`) and once span-less (from this
-- whole-graph sweep, prepended by `attachCoherenceConflict`, which `driveGraphK` and
-- the keyed arm of `checkModulesDiagsChain` both call.  An IMPORT-BEARING two-module
-- program whose overlap is entry-module-local double-reports identically, so the
-- double report is not specific to one module.  Per-module sweep and whole-graph
-- sweep each report the pair: one with the declaration span, one without it.
--
-- ⚠️ NOT loud→silent, and here is why that is a claim and not a hope.  The pair this
-- now declines is INTRA-module, and the per-module sweep's population
-- (`cohRowsOwnedBy cur`) contains every one of that module's own rows by
-- construction, with `foldModules` running the worker for EVERY module in the graph.
-- So the union of the per-module sweeps already covers every intra-module pair the
-- whole-graph sweep could see, WITH a span, which is strictly the better diagnostic.
-- The whole-graph sweep's unique contribution -- the pair that SPANS two modules, which
-- no per-module sweep can see -- is exactly what this predicate keeps.  Control
-- measured across the change: two modules each declaring `impl Foo Int` for a third
-- module's interface still reports `Conflicting `impl Foo`. Defined in amod and main`,
-- once.
--
-- The one residual hole is `runFinalChecks`' documented `-1` ordinal sentinel, at which
-- `checkCoherence` sweeps no rows: an intra-module hard pair would then be reported by
-- NEITHER sweep.  That path is unreachable today and `ordinalSentinelGuard` already
-- pushes a loud `T-INTERNAL-ORDINAL` error when it is taken, so the failure announces
-- itself rather than accepting silently.
cohHardInScope : CohSweep -> String -> String -> Bool
cohHardInScope sweep mid1 mid2 = cohSoftInScope sweep mid1 mid2

-- each head matches the other, i.e. they are α-equal up to renaming (`cohSubsumes`
-- is one-sided matching, so mutual matching means each is an instance of the other).
cohMutuallySubsumes : List Mono -> List Mono -> Bool
cohMutuallySubsumes xs ys = cohSubsumes xs ys && cohSubsumes ys xs

cohKeepFirst : Option a -> Option a -> Option a
cohKeepFirst (Some x) _ = Some x
cohKeepFirst None y = y

-- HARD wording.  When the two impls come from DIFFERENT modules (mid1 /= mid2, both
-- non-empty), the message names BOTH owning modules (the cross-module global-
-- coherence case, D3/WS-2 — which is exactly the duplicate-instance class).
cohHardMsg : CohImpl -> List Mono -> List Mono -> String -> String -> String
cohHardMsg e1 xs ys mid1 mid2
  | cohPairsPrelude mid1 mid2 = cohPreludeOverlapMsg (cohImplIfaceName e1) xs ys
  | cohIsCrossModule mid1 mid2 =
    cohCrossModuleMsg (cohImplIfaceName e1) mid1 mid2
  | otherwise = cohOverlapMsg (cohImplIfaceName e1) xs ys

-- the prelude's module id in `buildDeclEnvs`' module list.
cohPreludeMid : String
cohPreludeMid = "core"

-- Whether one impl of the pair is the prelude's.  The per-module sweep pairs a
-- module's own rows (first) with the prelude's (second), so the prelude's is [mid2].
cohPairsPrelude : String -> String -> Bool
cohPairsPrelude mid1 mid2 = mid1 == cohPreludeMid || mid2 == cohPreludeMid

cohIsCrossModule : String -> String -> Bool
cohIsCrossModule mid1 mid2 = mid1 /= "" && mid2 /= "" && mid1 /= mid2

-- SOFT wording (`W-INCOMPARABLE-IMPLS`).  Carries the "Warning: " prefix the
-- `matchWarnings` channel's text renderers expect and `stripWarnPrefix` removes for
-- the structured `--json` form.  ERROR-QUALITY: it states the rule that was violated
-- in the user's own vocabulary (these two heads, this interface), says the acceptance
-- consequence rather than asserting the program is wrong — because under (c) it may
-- not be — and puts the SPEC's remedy first.  The old error's advice ("make them
-- disjoint, or wrap one type in a newtype") is #614's S2: it is the wrong fix here
-- and, as that issue's own control shows, adding the ranking impl changed nothing.
-- A pair with the prelude names the prelude's impl as such rather than by module id,
-- as `cohPreludeOverlapMsg` does: the program's own module id differs between verbs.
cohIncomparableMsg : String ->
  List Mono ->
  List Mono ->
  String ->
  String ->
  String
cohIncomparableMsg iface xs ys mid1 mid2 = match cohPpPair xs ys
  (s1, s2) =>
    if cohPairsPrelude mid1 mid2 then
      "Warning: overlapping impls of \{iface}: neither \{s1} nor the prelude's \{s2} is more specific than the other, so a goal matching both has no impl to pick"
    else
      "Warning: overlapping impls of \{iface}\{cohWhereSuffix mid1 mid2}: neither \{s1} nor \{s2} is more specific than the other, so a goal matching both has no impl to pick"

cohWhereSuffix : String -> String -> String
cohWhereSuffix mid1 mid2
  | cohIsCrossModule mid1 mid2 = " (defined in `\{mid2}` and `\{mid1}`)"
  | otherwise = ""

cohImplIface : CohImpl -> IfaceRef
cohImplIface (CohImpl i _ _ _) = i

-- #1559 A-3.7: the SPELLING, for the message renderers alone.  Every `coh*Msg`
-- below keeps its `String` parameter deliberately — the rendered wording is pinned
-- byte-for-byte by error goldens, and this unit moves no diagnostic text.  Reading
-- `.irName` through a named projection rather than at each call site keeps the
-- "identity decides, spelling only prints" split visible.
cohImplIfaceName : CohImpl -> String
cohImplIfaceName e = (cohImplIface e).irName

cohImplLoc : CohImpl -> Option Loc
cohImplLoc (CohImpl _ _ _ l) = l

-- push the SOFT (condition-(a)-only) coherence finding onto the typecheck WARNING
-- channel.  ⚠️ `matchWarnings`, NOT `recordTypeError` with severity 2 — see
-- `matchWarnings`' own note: `recordTypeError` arms `typeErrorsSticky` (aborts
-- build/run) and bumps `errorsDetected` (steers `erredDuring`-gated inference)
-- unconditionally, without reading severity, so a severity-2 push there keeps BOTH of
-- an error's side effects and still renders as severity 1.  A demotion has to change
-- channel, not just the number.
pushCoherenceWarning : ModuleCtx -> Option Loc -> String -> Unit
pushCoherenceWarning mctx loc msg =
  let warning =
    TcDiag
      "W-INCOMPARABLE-IMPLS"
      2
      (orElseLoc loc mctx.mcLoc)
      msg
      (Some cohIncomparableHelp)
      None
  mctx.mcCells.matchWarnings := warning :: mctx.mcCells.matchWarnings.value

-- run coherence over USER decls; push at most one HARD conflict into typeErrors and
-- at most one SOFT one onto the warning channel.  The impls are scanned in REVERSE
-- declaration order to mirror the oracle, whose env.impls is built by prepending each
-- entry (`entry :: !(env.impls)`) — so the conflict message names the later-declared
-- impl as the first head, byte-identical.
-- #1559 A-3.7: the input is `IE`'s rows for THIS module, not a decl list.
-- [cur] is the reading module's ordinal.  Its own rows are paired with each other and
-- with the prelude's rows (`cohPreludeRows`), never prelude with prelude.
--
-- POPULATION EQUALITY, derived rather than assumed (it is the one thing that could
-- silently change what gets checked).  The Module caller used to pass `prog`, the
-- module's own desugared decls as `foldModules` holds them.  `ieRowsOwnedBy ordHere`
-- returns the rows `implRowsOf` built from `demDecls` at that ordinal.  Those are the
-- same list VALUE: `driveGraphK` stamps once (`stampGraphDecls`) and hands
-- the SAME `modules` to `graphPreamble` → `buildDeclEnvs` and to `foldModules`,
-- and `foldModules` passes each `(mid, prog)` pair's `prog` to the worker verbatim —
-- no transform on either side.  Harvest equality holds too: `implDeclFact` and the
-- retired `cohImplsOfMid` match arm-for-arm (unwrap `DAttrib`, take `DImpl`, drop
-- everything else) and both are a `flatMap` in decl order.
checkCoherence : ModuleCtx -> ImplEnv -> Int -> Unit
checkCoherence mctx env cur =
  match (cohScan
    CohSweepOwn
    (reverseL (map (cohImplOfRow mctx) (cohRowsOwnedBy cur env)))
    (map (cohImplOfRow mctx) (cohPreludeRows env)))
    CohScan hard soft =>
      let _ = cohPushHard mctx hard
      cohPushSoft mctx soft

cohPushHard : ModuleCtx -> Option (String, Option Loc) -> Unit
cohPushHard mctx None = ()
cohPushHard mctx (Some (msg, loc)) =
  pushTypeErrorAt mctx "T-CONFLICTING-IMPL" loc msg

cohPushSoft : ModuleCtx -> Option (String, Option Loc) -> Unit
cohPushSoft mctx None = ()
cohPushSoft mctx (Some (msg, loc)) = pushCoherenceWarning mctx loc msg

-- ── the superinterface rule for impl declarations (DICT-SEMANTICS §3 W-super) ──
-- Checks each impl in [userDecls] against every direct super of its interface; see
-- `checkImplSuperContexts`.  The supers come from `CE` at the reading ordinal [cur],
-- keyed by the impl's `implOrigin`.  Existence of a super impl is asked of every
-- `IE` row in the graph (`ieRowsVisibleAt` reads `ieCandidacyVisibleAt`, the
-- predicate instance candidacy reads), so a super impl declared in a later module
-- counts, as it does for dispatch; a row counts only when its own interface identity
-- is the super's `superOrigin`, never a same-spelled interface.
--
-- The row list is bound here, once: it is O(rows), and the existence test runs per
-- (impl x super).
checkSuperImpls : ModuleCtx -> List Decl -> ClassEnv -> ImplEnv -> Int -> Unit
checkSuperImpls mctx userDecls ce ie cur =
  let rows = ieRowsVisibleAt cur ie
  foreachUnit (checkImplSuperContexts mctx userDecls ce cur rows) userDecls

-- DICT-SEMANTICS §3, the declaration rule for supers: a dictionary for `C ts` carries
-- one for each direct super `D` of `C` at the same arguments, built by the instance
-- `D ts` selects, so that instance's `requires` is part of what `C ts` owes.  The impl
-- must entail it from its own `requires` (with their supers), at its head with the
-- head variables rigid, or every binder that reduces `C ts` drops it.  A goal of the
-- selected instance's context is reduced through the instances as W3-inst's are; a
-- leaf that is no given is reported at the impl.  A super goal no given answers and
-- no impl row covers (`superRowExists`) is a missing super impl, reported at the impl
-- whether its head is concrete or parametric.  Direct supers suffice because every
-- impl is checked, the super's own impl included.
--
-- A parsed `impl` always records its interface token's span; a derived one records
-- none, so it is reported at the `data`/`newtype` declaration that produced it, and
-- its remedies are a `deriving` clause or a hand-written impl, since a `deriving`
-- clause takes no `requires`.
checkImplSuperContexts : ModuleCtx ->
  List Decl ->
  ClassEnv ->
  Int ->
  List ImplRow ->
  Decl ->
  Unit
checkImplSuperContexts mctx decls ce cur rows (DAttrib _ d) =
  checkImplSuperContexts mctx decls ce cur rows d
checkImplSuperContexts mctx decls ce cur rows (DImpl { iface, tys, reqs, implOrigin = o, implIfaceLoc = ifaceLoc, ... }) =
  let derived = isNone ifaceLoc
  let loc = if derived then derivedImplDeclLoc decls tys else ifaceLoc
  match ceLookupAt (regKeyOfTab (ifaceTabKey o iface)) cur ce
    Some r if listLen (ceRowTyparams r) == listLen tys =>
      let (implTvMap, headMonos) = implHeadMonos mctx tys
      let roots = implHeadTypeVarRoots implTvMap
      let headIds = omFromNames (map (p => intToString (snd p)) roots) omEmpty
      let declared = map (requirePredicateSlot mctx implTvMap) reqs
      let givens =
        declared
          ++ flatMap
            (s => map fst (predicateSlotKnownSupers mctx.mcGraph s))
            declared
      let subject = "impl \{iface} \{joinWith " " (map ppTyAtom tys)}"
      let subst = zipL (ceRowTyparams r) tys
      let argsOf =
        sup =>
          mapAll
            (p => lookupPos p (ceRowTyparams r) headMonos)
            (superParamsOf sup)
      fold
        (_ sup => match argsOf sup
          Some supArgs => checkSuperInstanceContext
            mctx
            subject
            roots
            headIds
            givens
            loc
            derived
            (superIfaceRef sup)
            supArgs
            (_ => superRowExists rows subst sup)
          None => ())
        ()
        (ceRowSupers r)
    _ => ()
checkImplSuperContexts mctx _ _ _ _ _ = ()

-- The span of the `data`/`newtype` declaration a derived impl's head names.
derivedImplDeclLoc : List Decl -> List Ty -> Option Loc
derivedImplDeclLoc decls tys = match flatMap tyConNamesInTy tys
  [n] => match flatMap (declNameLocs n) decls
    l :: _ => Some l
    [] => None
  _ => None

declNameLocs : String -> Decl -> List Loc
declNameLocs n (DAttrib _ d) = declNameLocs n d
declNameLocs n (DData { dataName, dataNameLoc = (Some l), ... })
  | dataName == n = [l]
declNameLocs n (DNewtype { newtypeName, newtypeNameLoc = (Some l), ... })
  | newtypeName == n = [l]
declNameLocs _ _ = []

checkSuperInstanceContext : ModuleCtx ->
  String ->
  List (String, Int) ->
  OrdMap Unit ->
  List PredicateSlot ->
  Option Loc ->
  Bool ->
  IfaceRef ->
  List Mono ->
  (Unit -> Bool) ->
  Unit
checkSuperInstanceContext mctx subject roots headIds givens loc derived sup supArgs covered
  | anyList (givenAnswers sup supArgs) givens = ()
  | otherwise =
    match rigidHeadInstanceContext (siteFor mctx) headIds sup supArgs
      None =>
        if not (covered ()) then
          reportMissingSuperImpl mctx subject roots loc derived sup supArgs
      Some ctx =>
        let walk = reqWalkStart ()
        let leaves =
          flatMap
            (g =>
              superContextLeaves mctx walk headIds givens loc (fst g) (snd g))
            ctx
        fold
          (_ leaf =>
            reportSuperContextLeaf
              mctx
              subject
              roots
              loc
              derived
              sup
              supArgs
              leaf)
          ()
          leaves

-- Whether some impl row of the super covers the super goal at the impl's head
-- (`superHeadCovers`).  Rows are graph-wide, so a super impl declared downstream
-- counts.
superRowExists : List ImplRow -> List (String, Ty) -> Super -> Bool
superRowExists rows subst (Super { superHead = n, superParams = ps, superOrigin = so }) =
  let tys = substParams ps subst
  listLen tys /= listLen ps || superImplExists rows (ifaceTabKey so n) n tys

-- The super is named by its spelling, as the checked impl's own interface is, so
-- the text is the same on every verb and at every head.  A derived impl's remedy is
-- the `deriving` clause when the super is derivable, else the hand-written impl.
reportMissingSuperImpl : ModuleCtx ->
  String ->
  List (String, Int) ->
  Option Loc ->
  Bool ->
  IfaceRef ->
  List Mono ->
  Unit
reportMissingSuperImpl mctx subject roots loc derived sup supArgs =
  let named = Ref (map (p => (snd p, fst p)) roots)
  let goal = "\{sup.irName} \{joinWith " " (ppEach named (Ref 0) 3 supArgs)}"
  let missing = "requires the superinterface `\{goal}`, which no impl covers"
  pushTypeErrorOnceAt mctx "T-MISSING-SUPER-IMPL" loc (if not derived then
    "`\{subject}` \{missing}; add an `impl \{goal}` covering it, or add `requires \{goal}` to the impl"
  else if derivableIface sup.irName then
    "`\{subject}` (derived) \{missing}; add `\{sup.irName}` to the type's `deriving` clause, or add an `impl \{goal}`"
  else
    "`\{subject}` (derived) \{missing}; add an `impl \{goal}`")

-- The goals below [iface] [args] that no given answers: a goal over variables alone,
-- or one no instance selects with the head variables rigid.  Bounded by the shared
-- `requires` measure, a cycle or a runaway chain reported at [loc].  Each goal is
-- solved once per walk (`solvedOnWalk`); [headIds], [givens] and [loc] are fixed for
-- the walk `checkSuperInstanceContext` starts.
superContextLeaves : ModuleCtx ->
  ReqWalk ->
  OrdMap Unit ->
  List PredicateSlot ->
  Option Loc ->
  IfaceRef ->
  List Mono ->
  List (IfaceRef, List Mono)
superContextLeaves mctx walk headIds givens loc iface args
  | anyList (givenAnswers iface args) givens = []
  | not (anyConcreteHead args) = [(iface, args)]
  | otherwise = match reqWalkReported mctx loc (reqWalkEnter walk iface args)
    None => []
    Some next => solvedOnWalk
      mctx
      next
      iface
      args
      (_ => match rigidHeadInstanceContext (siteFor mctx) headIds iface args
        None => [(iface, args)]
        Some ctx =>
          flatMap
            (g =>
              superContextLeaves mctx next headIds givens loc (fst g) (snd g))
            ctx)

-- A leaf over head variables names the `requires` to add; a ground one names the
-- missing instance.  A leaf mentioning a variable the head does not bind has no
-- `requires` to name and is left to the goal's use.
reportSuperContextLeaf : ModuleCtx ->
  String ->
  List (String, Int) ->
  Option Loc ->
  Bool ->
  IfaceRef ->
  List Mono ->
  (IfaceRef, List Mono) ->
  Unit
reportSuperContextLeaf mctx subject roots loc derived sup supArgs (iface, args) =
  let ids = flatMap monoUnboundIds args
  let named = Ref (map (p => (snd p, fst p)) roots)
  let argsText = joinWith " " (ppEach named (Ref 0) 3 args)
  let superGoal =
    "\{qualifiedIfaceLabel sup} \{joinWith " " (ppEach named (Ref 0) 3 supArgs)}"
  let pred = "\{qualifiedIfaceLabel iface} \{argsText}"
  let predBare = "\{iface.irName} \{argsText}"
  if isEmptyL ids then
    pushTypeErrorOnceAt
      mctx
      "T-NO-IMPL"
      loc
      (superContextNoImplMsg subject derived superGoal pred predBare)
  else if allList (i => containsI i (map snd roots)) ids then
    pushTypeErrorOnceAt
      mctx
      "T-IMPL-MISSING-REQUIRES"
      loc
      (superContextUndeclaredMsg subject derived superGoal pred predBare)

foreachUnit : (a -> Unit) -> List a -> Unit
foreachUnit _ [] = ()
foreachUnit f (x :: xs) =
  let _ = f x
  foreachUnit f xs

-- ── P0-17: impl-completeness check ─────────────────────────────────────────
-- Beta finding P0-17 (qa-beta-2026-07-07): an `impl Iface Ty…` that defines only
-- SOME of the interface's methods used to `check` clean, then PANIC at runtime
-- (`E-PANIC: unbound identifier: <method>`) when a missing method is dispatched —
-- a run≠check hole.  For each impl, verify every REQUIRED interface method (one
-- declared WITHOUT a default body) is defined by the impl body; each missing one
-- is a located `T-INCOMPLETE-IMPL` error, so check/run/build all reject instead of
-- deferring to a runtime panic.
--
-- Runs POST-desugar (from the typecheck cores), which is the ONLY stage where both
-- sets are cleanly visible with defaults distinguishable:
--   • desugar's mergeIfaceDefaults has coalesced each interface method's split
--     signature-entry (`lt : …`, default None) and body-entry (`lt x y = …`,
--     default Some) into ONE `IfaceMethod` carrying the merged Option MethodDefault.
--     PRE-merge the sig-only `None` entry would make every defaulted method (Ord's
--     lt/gt/…) look REQUIRED → hundreds of false positives across core/stdlib.
--   • an impl's defined set is exactly what it writes: a method it leaves to its
--     interface's default is a disposition row, not a clause, so the defined set
--     cannot mask a genuinely-missing required method.
-- The interface decl is resolved out of stage K's `CE` at the reading module's
-- ordinal (`ceRequiredAt`), so an IMPORTED interface resolves exactly as a local one
-- does; [iterDecls] (this module's own decls) are the impls to check.  Unknown
-- interface (not in scope) → skip (a distinct error is reported elsewhere), as
-- `checkImplSuperContexts` skips one.
--
-- #1557 A-3.5a: there is now ONE checker for both driver modes.  There used to be
-- two — `checkImplCompleteness`, whose retired arm looked the interface up by a bare
-- first-match scan over the decl list, and `checkImplCompletenessMap` below.  The
-- retired arm's deletion was the unit's only genuine re-key (owner ruling on #1557 owed
-- 1, 2026-08-12: re-key, accept the acceptance delta, no bare-spelling compatibility
-- leg on CE).  Its one observable consequence: on a flat program where a USER
-- interface shadows a prelude one by spelling, the bare scan walked
-- `coreProg ++ userProg` head-first and returned the PRELUDE's required set for a
-- user impl; under identity the impl's own `implOrigin` decides, which is the
-- correct answer.
pushIncompleteImpl : ModuleCtx -> (Option Loc, String) -> Unit
pushIncompleteImpl mctx (loc, msg) =
  pushTypeErrorOnceAt mctx "T-INCOMPLETE-IMPL" loc msg

-- The span a missing-method error is attributed to: the first impl method's
-- body, read from its parsed AST whether or not the body was ever inferred.
-- `exprLoc` sees only an outermost `ELoc`/`EDoOrigin` wrapper, and a body shaped
-- `f x` (an application) has none, so `appArgLoc` gives its argument's span, a
-- location inside the impl block.  `None` for an impl with no method body or a
-- body neither form locates; the caller then reports at the impl's interface
-- name (`implIfaceLoc`).
firstImplMethodLoc : List ImplMethod -> Option Loc
firstImplMethodLoc [] = None
firstImplMethodLoc ((ImplMethod _ _ body) :: _) =
  orElseLoc (exprLoc body) (appArgLoc body)

-- The `Map` suffix is retained because it is cited from
-- compiler/frontend/resolve.mdk, compiler/TYPECHECK-TARGET-ARCHITECTURE.md, and
-- other comments in this file (see TYPECHECK-TARGET-ARCHITECTURE.md § "9.6 The
-- subsumption enumeration — derived by SHAPE, not by prefix", the
-- `implCompletenessMsgsOf` row, for the #1258 bug and the #1111/#1557 migration
-- history). Since A-3.5a there is no non-`Map` sibling; this is the ONE
-- impl-completeness checker, for both driver modes.
--
-- Required-ness is prePass-INVARIANT: `requiredMethodNames` reads only the presence
-- of `IfaceMethod`'s third position, and the prePass rewrite touches only a
-- `Some (…, e)` arm's body, so building `CE` from raw `demDecls` cannot change the
-- required-ness.
checkImplCompletenessMap : ModuleCtx -> ClassEnv -> Int -> List Decl -> Unit
checkImplCompletenessMap mctx ce cur iterDecls =
  foreachUnit
    (pushIncompleteImpl mctx)
    (flatMap (implCompletenessMsgsOfMap ce cur) iterDecls)

-- OCCURRENCE MINT (#1110/#1111 A-2.4): `implOrigin` beside `iface` in the same
-- record pattern, so the identity and the name it qualifies cannot drift apart.
implCompletenessMsgsOfMap : ClassEnv -> Int -> Decl -> List (Option Loc, String)
implCompletenessMsgsOfMap ce cur (DAttrib _ d) =
  implCompletenessMsgsOfMap ce cur d
implCompletenessMsgsOfMap ce cur (DImpl { iface, tys, methods, implOrigin = o, implIfaceLoc = ifaceLoc, ... }) =
  match ceRequiredAt (regKeyOfTab (ifaceTabKey o iface)) cur ce
    None => []  -- unknown interface (reported elsewhere) → skip
    Some required =>
      let defined = map implMethodName methods
      -- An impl with no method body of its own is located at its interface name.
      let loc = orElseLoc (firstImplMethodLoc methods) ifaceLoc
      map
        (m => (loc, missingImplMethodMsg iface tys m))
        (filter (m => not (contains m defined)) required)
implCompletenessMsgsOfMap _ _ _ = []

-- `insertIfaceRequired`, the retired writer of `universeIfaceRequiredRef` (see that
-- cell's tombstone in `CrossRun`), is superseded by `classEnvRowsOf`, which mints the
-- SAME key from the SAME `ifaceOrigin` and stores the SAME `requiredMethodNames
-- methods` value on `CeRow`; its DAttrib-unwrapping is preserved by
-- `classEnvDeclFact`, which unwraps `DAttrib` on the way into `CE`.

-- ── #1111 Stage A-2 unit A-2.11 (#1319 unit 1): the CONSTRUCTOR-namespace peer ──
--
-- Everything from here to `ctorExportsInto` (in `tc_decls`) is the constructor twin of the METHOD
-- method machinery (`MethodEnv` … `exportsIdentFor`).  It is a
-- deliberate near-copy and it is NAMED SCAFFOLDING, not an oversight:
--
--   * the METHOD index is already, by its own admission, a THIRD implementation of a
--     fact `resolve.mdk` derives, with **#1288** named as the absorbing stage that
--     deletes it.  This makes a FOURTH.  #1288's scope names the constructor peer, so
--     the deleter is real rather than asserted;
--   * B2 (resolve owns the fact and typecheck consumes it) is the target-conformant
--     answer under L2's identity-at-resolve law, and was REJECTED FOR NOW for a stated
--     reason: resolve's only delivery channel to typecheck is the AST, so B2 implies a
--     decl-adjacent carrier whose cost across printer / sexp / fmt / lower / mangle was
--     never costed.  See #1319's adjudication comment.
--
-- ⚠️ MIRROR DISCIPLINE IS LIVE between the two families until #1288 lands: a fix to the
-- scope ladder, the witness, or the export index on ONE side is silently absent from the
-- other.  They are kept together on purpose (this file and `tc_decls`).
--
-- ── WHAT THIS FIXES, AND WHAT IT DELIBERATELY DOES NOT ──────────────────────
-- The ctor floor (`universeCtorPop`'s `spFloor`) is keyed by the BARE constructor name and is
-- last-write-wins, so when two unrelated modules each declare a `Dup` the whole loaded
-- program has ONE entry for `Dup` and load order picks the winner.  #1111 A-2.6 attacked
-- that with an import-scoped DECL overlay (`importedCtorTypeDecls`), and the boundary
-- moved one hop out twice: a member reached through a RE-EXPORT is not identity-matched
-- (#1283), and a ride-along SIBLING constructor of an overlaid decl out-ranks a ctor the
-- unit imports BY NAME from an earlier clause (#1284).
--
-- This unit keeps the overlay (unit 4 retires it) and adds the A-2.5-shaped answer on
-- top: an identity-keyed COMPANION of the bare map, plus a per-module SCOPE DECISION for
-- the colliding names only.  The overlay's unit is the DECL; a scope decision's unit is
-- the NAME, which is why a ride-along sibling cannot win here.
--
-- 🚨 IT MUST NOT RE-DECIDE AMBIGUITY.  Constructor-name ambiguity is provenance-based
-- (`ctorAmbiguousSet` → `keepAmbiguous` in `frontend/resolve.mdk`: ≥2 distinct
-- declarations in scope), and that rule is deliberately ONE rule across the value / type /
-- interface / ctor namespaces — resolve's own note says a change there must change all
-- four at once.  This is a different question on the same data: "which declaration does
-- this module mean" is asked only where resolve has already ACCEPTED the program.  Two
-- witnesses decline to the floor here rather than picking one, so a genuinely ambiguous
-- import is still resolve's to reject and nothing here can quietly accept it.
--
-- ⚠️ MODULE-PATH-ONLY, exactly as A-2.5: a flat/single-file declaration carries
-- `OriginUnresolved`, `mkIdent` refuses it, no candidate is recorded, and the override
-- site is on the `Module` arm alone.
--
-- No prelude rung, unlike the method ladder's `methodUndecided` — and that asymmetry is measured, not
-- assumed.  A module that declares OR imports a constructor spelled like a prelude
-- constructor is rejected outright (`Duplicate constructor: Lt`), so `core` can never be
-- one of two candidates for one ctor name and there is no rung for it to be.

-- The two tables `registerRecordInfoKeyed` writes in lockstep — `recordByNameRef`
-- (registry key → RecordInfo) and `fieldOwnersRef` (field name → owning registry keys) —
-- are the constructor namespace's other half; a record literal / record pattern /
-- `.field` access never reads the constructor scheme env, so
-- `applyCtorScopeOverrides` cannot reach them. Only `recordByNameRef` is fixed here: an
-- identity-keyed COMPANION plus a per-module SCOPE DECISION for the collided keys.
-- `fieldOwnersRef` stays a graph-global multimap, open on #1070 / #1319 — its value (the
-- candidate owner set) needs a REACHABILITY predicate (can a value of this record type
-- be obtained here at all, including transitively), not a constructor-witness test; a
-- prior attempt at the witness-predicate shape was reverted for producing accept→reject
-- regressions on legitimate value-only imports, a quadratic memory cost, and
-- non-monotonic ambiguity decisions — do not re-attempt that shape here.
--
-- The witness half is deliberately NOT re-implemented here: `declaresCtorNamed` and
-- `anyUsePathBindsCtor` are SHARED with unit 1, because a record's name IS its
-- constructor and a named-field variant is keyed by its constructor; only the candidate
-- ROW type differs (RecordInfo instead of Scheme), so only the two projections below are
-- new. It must not re-decide ambiguity, for the same reason as unit 1: two witnesses
-- decline to the floor rather than picking one, so a genuinely ambiguous import stays
-- resolve's to reject. Scaffolding with a named deleter, same as unit 1: this is a
-- further implementation of a fact `resolve.mdk` derives; #1288 owns the consolidation.
--
-- A DECL-level scope decision is the right instrument and no node carrier is needed:
-- neither an interface-default specialization's copied body nor another module's impl
-- body re-resolves a record occurrence in the importer's own record scope, so the
-- occurrence is decided once, at the declaration, not per node. This is falsifiable by a
-- future change: a driver that hands `desugar` a concatenation of modules would reopen
-- it.

-- ── WS-5: phantom interface method detection ──────────────────────────────
-- A method whose declared type mentions NONE of the interface's type parameters
-- (neither in argument position nor in the result) cannot be dispatched: there
-- is no argument or return type to select an impl from.  Reject at check time
-- so the silent mis-dispatch at runtime is caught early.
--
-- Examples:
--   interface Phantom a where
--     name : String          -- PHANTOM: `a` appears nowhere in the type
--   interface Show a where
--     show : a -> String     -- OK: `a` appears in argument position
--   interface Pure f where
--     pure : a -> f a        -- OK: `f` appears in result position
--
-- The check uses the full method type (args AND result via tyVarNames), so
-- return-position methods like `pure : a -> f a` or `minBound : a` are NOT
-- flagged.  Multi-param interfaces: phantom iff ALL params absent.

-- #1557 A-3.5c: relocated onto stage K's `CE`.  The row set is
-- `ceRowsOwnedBy` — the READING module's OWN interfaces, which is exactly the
-- decl list this check was handed before (`prog` on the Module arm, the
-- driver-staged USER decls on Flat), NOT the visible prefix: an imported
-- interface's phantom method is reported once, at the module that declares it,
-- not once per importer.  See `ceRowsVisibleAt`/`ceRowsOwnedBy` for why the two
-- populations are kept apart.
--
-- Reading `CE` rather than re-destructuring `DInterface` also drops the
-- `DAttrib` unwrapping this check used to open with: `classEnvDeclFact` already
-- peels it, so an attributed interface reaches `CE` as a row like any other.
checkPhantomMethods : ModuleCtx -> ClassEnv -> Int -> Unit
checkPhantomMethods mctx ce cur =
  foreachUnit
    ((loc, msg) => pushTypeError (mctxAtIfSome loc mctx) "T-PHANTOM-METHOD" msg)
    (flatMap phantomMethodMsgs (ceRowsOwnedBy cur ce))

-- Each message with the span of the method's declared type it is about, or of
-- the interface's name when that type carries none (a default with no signature).
phantomMethodMsgs : CeRow -> List (Option Loc, String)
phantomMethodMsgs r =
  map
    (m => (orElseLoc (fst m) (ceRowLoc r), snd m))
    (flatMap
      (phantomMethodMsg (ceRowIfaceName r) (ceRowTyparams r))
      (ceRowMethods r))

phantomMethodMsg : String ->
  List String ->
  (String, Ty, List (String, List Kind)) ->
  List (Option Loc, String)
phantomMethodMsg ifaceName typarams (mname, mty, _) =
  if isEmptyL typarams then
    []
  else if anyMember (tyVarNames mty) typarams then
    []
  else
    let noun = if listLen typarams == 1 then "parameter" else "parameters"
    [
      (
        firstTyLoc mty,
        "method `\{mname}` of interface `\{ifaceName}` does not mention the interface \{noun} \{joinWith ", " (map (t => "'" ++ backticked t ++ "'") typarams)}, so it cannot be dispatched",
      ),
    ]

-- ── WS-4a: cyclic superinterface detection ────────────────────────────────
-- A cyclic `interface A requires B; interface B requires A` is ill-formed: no
-- impl can ever be constructed (each demands the other) and the transitive
-- evidence resolver would diverge.  DFS over the `requires` graph; if any node
-- is re-encountered on the current DFS stack, report the cycle.
-- Runs over ALL interfaces in scope (prelude + user) — a prelude cycle would
-- be equally ill-formed.  The `done` ref tracks fully-explored nodes to avoid
-- redundant traversal and re-reporting multi-root cycles.
-- 🚨 #1557 A-3.5c: relocated onto stage K's `CE`, AND RE-KEYED — this is the
-- unit's #1258-class acceptance delta, the one the owner ruling of 2026-08-12
-- accepts by name (*"re-keying a bare-name table does not create wrongness, it
-- creates VISIBILITY"*).
--
-- WAS: `collectIfaceNames allDecls` for the roots and `ifaceSupersOf allDecls
-- <name>` for every edge — BOTH bare-name scans of a decl list, so a superinterface
-- edge resolved to whichever same-spelled interface appeared FIRST in
-- the concatenation of every module's decls.  Two unrelated modules each declaring `Same` collapsed
-- into one node: `mod_a.Same requires mod_b.Same` could be reported as a self-cycle it
-- is not, and a genuine cycle could be masked by the other module's row winning the
-- scan.  Import order selected the symptom, exactly as it did for `#1257`'s kind rows.
--
-- NOW: nodes are `CeRow`s and an edge is followed by IDENTITY —
-- `ceLookupAt (regKeyOfTab (ifaceTabKey superOrigin superHead))`.  `Super` has carried
-- `superOrigin` since #1110 Stage A-1 and `resolve.mdk` stamps it through the SAME
-- `mapSuperOcc`/`tyOriginScope` walk that stamps a `DImpl`'s `implOrigin`, so the
-- occurrence and the `DInterface`'s `ifaceOrigin` declaration layer meet for the same
-- reason `ifaceTabKey`'s header argues for the impl-head key.  The `done` set and the
-- DFS `path` are keyed on `regKeyRender` rather than the bare name for the identical
-- reason.
--
-- ⚠️ THE MISS ARM IS AN ABSTENTION, AND IT IS THE ONE PLACE THIS COULD GO
-- LOUD→SILENT.  An edge whose target is not in `CE` at this ordinal yields `None` and
-- the walk stops — the same disposition `ifaceSupersOf`'s `None` arm already had
-- ("unknown interface, reported elsewhere"), and resolve rejects an interface naming
-- an unknown superinterface before typecheck runs.  What is NEW is that a super whose
-- identity failed to resolve would now MISS where a bare name used to hit.  That is
-- why the abstention arm needs a POSITIVE control -- a shape whose edge MUST still be
-- followed -- rather than only a negative one.
--
-- Cite fixtures that exist, and check what actually consumes them.  The gate
-- for this arm is `test/diff_compiler_fmt_test.mdk`'s `typecheckErrorFailures`,
-- which walks its fixture directory RECURSIVELY via `fixtureFiles` -- so a
-- directory-nested fixture IS discovered and consumed.  No gate catches a wrong
-- citation here: `make docs-links` and `make agent-doc-symbols` do not scan
-- compiler comments.  It matters more than a typo because this is the one
-- sentence answering "is the abstention arm covered?", and a citation like
-- that gets relayed into the next unit's design as an established fact.  The
-- real controls, both verified to reject on this binary:
--   * MULTI-MODULE: `test/analyze_project_fixtures/1557_a35c_cycle_masked_by_samespelled/`
--     (consumed by `test/diff_compiler_fmt_test.mdk`'s `analyzeProjectFixtureFailures`)
--     -- its edge must resolve BY IDENTITY for the fixture to pass at all, so
--     an abstention that swallowed a real edge reds it.
--   * FLAT: `test/dict_fixtures/s3-w1-cyclic-superinterface-rejected.mdk` (no imports)
--     and `test/typecheck_error_fixtures/cyclic_superinterface.mdk`.
-- The negative direction -- an edge that must NOT be followed -- is
-- `1557_a35c_samespelled_iface_bystander/`.  The set is the assertion; no member is.
--
-- ROOTS are `ceRowsVisibleAt` — the reading module's whole ordinal prefix: {prelude} ∪
-- {every earlier module in full} ∪ {this module}, members and order.  `accAll` is
-- seeded with the WHOLE `coreDecls` and grown `accAll ++ prog` (not `publicDataDecls
-- prog`; only `accData` is public-filtered) and every Module-arm driver runs
-- `AccumulateBoth`, so the prefix is the full set.  `CE` at this ordinal is that set in
-- ordinal order.
--
-- ⚠️ AN EARLIER CUT OF THIS COMMENT CLAIMED A DELIBERATE WIDENING HERE — *"`accAll`/
-- `accData` carry only `publicDataDecls`, so a PRIVATE interface of an earlier module
-- was never a root"* — and it was simply WRONG about `accAll`, so the widening it
-- conceded does not exist.  Measured on two binaries rather than argued: a module
-- declaring a PRIVATE cyclic interface pair has that cycle reported in a sibling
-- module with NO import path to it, on the pre-relocation arm too, byte-identical.
-- Do not reinstate the hedge; the relocation is root-set-preserving.
checkInterfaceCycles : ModuleCtx -> List Decl -> ClassEnv -> Int -> Unit
checkInterfaceCycles mctx prog ce cur =
  -- #973: `done` is an OrdMap-backed SET (omHasKey/omInsert), NOT a growing `List` scanned
  -- by `contains`.  The membership test ran once per interface over the fully-explored
  -- set, which grows to the interface count → O(interfaces^2), the flat-path
  -- `manyifaces:typecheck` op-count quadratic (independent of use sites — it surfaces on a
  -- file of N cycle-free interfaces).  Keyed into a set it is O(log n): `done` only prunes
  -- already-explored nodes (set membership is order-insensitive), and the DFS order +
  -- cycle messages are driven by `path`/the root list.  A-3.5c keeps the shape and only
  -- changes the KEY from a bare name to `regKeyRender`.
  let done = Ref omEmpty
  foreachUnit
    (checkOneIfaceCycle mctx prog ce cur done)
    (ceRowsVisibleAt cur ce)

-- #152: the whole-program final-checks tail, shared by all five entry points
-- (the `checkOne*` projections and `checkModuleFullDiags`). [cohDecls] feeds coherence and
-- checkSuperImpls's impl-iteration argument.
-- ⚠️ trap #5: coherence must see USER decls only, so
-- this helper has NO access to `prog` — the caller decides [cohDecls] explicitly
-- (never a `prog` fallback).  Call ORDER is load-bearing (all push into typeErrors).
--
-- #1557 A-3.5c: two of the four members now read stage K's `CE` instead of a decl
-- list.  [ownCe]/[cycCe] are the class environments the caller is entitled to read
-- and [cur] is the READING module's ordinal — Module passes the whole-graph
-- `deIfaces` twice with its own ordinal; Flat passes two single-module envs built
-- from the very lists it used to hand `checkPhantomMethods`/`checkInterfaceCycles`,
-- at ordinal 0 in the standalone-list compatibility helper; reading a graph envelope there
-- would switch both checks silently OFF.
--
-- ⚠️ CALL ORDER IS UNCHANGED AND THAT IS DELIBERATE.  A-3.5c moves two members'
-- SOURCE, not their position: coherence still runs first, then cycles, then phantom,
-- then super-impls, so no diagnostic changes rank against another family.  Whichever
-- unit lands A-3.5a/A-3.5b inherits this constraint — pulling a member OUT of this
-- sequence re-orders every accumulated diagnostic after it.
-- #1557 A-3.5b: the super-impl check reads stage K, taking [cycCe] and [cycIe] at the
-- same ordinal.  Both envs must be built over the same population: the whole-graph
-- `deImpls` with the reader's own ordinal on the Module arm, `flatImplEnvOf` of the
-- one list the Flat callers hand `cycCe`'s peer.
-- #1559 A-3.7: coherence reads stage K too, so this helper carries TWO `IE`s for
-- the same reason A-3.5c gave it two `CE`s — [cohIe] is the env over the population
-- [cohDecls] names (the USER boundary, trap #5) and [cycIe] is built over the
-- whole-graph population.  They are the same env only on the paths where those two
-- populations were already the same.  [cohIe] must contain the prelude at
-- ordinal 0, since coherence pairs the module's own rows with the prelude's.
--
-- 🚨 SA-6 (sprint repair round): THE `-1` SENTINEL IS FAIL-CLOSED HERE, AND IT HAS TO BE
-- ANNOUNCED AT THIS READER.  [cur] is `declEnvsOrdOf mid` on the Module arm, whose miss
-- value is `0 - 1` (see that function: a miss is documented fail-CLOSED, and it says in
-- so many words that the remedy for a stray id is at the READER — "abstain loudly / fail
-- the pass" — never a sentinel that means "everything").  All four members below take
-- [cur], and at `-1` they abstain in OPPOSITE directions: `checkCoherence` takes
-- `cohRowsOwnedBy -1` → no rows → **it checks nothing, silently**, where pre-A-3.7 it
-- walked the decl list unconditionally; `checkInterfaceCycles`/`checkPhantomMethods` take
-- `ceRowsVisibleAt -1`/`ceRowsOwnedBy -1` → likewise nothing; and `checkSuperImpls`,
-- whose row read SA-3 just widened to `ieCandidacyVisibleAt`, still finds no SUPERS
-- (`ceLookupAt … -1`) and so also reports nothing.  So the whole tail degrades to a
-- SILENT ACCEPT — a loud→silent transition, which this repo ranks as a severity increase
-- even while unreachable.
-- ⚠️ UNREACHABLE TODAY, AND THE GUARD IS STILL RIGHT.  The three drivers pass either a
-- literal `0` (both Flat entries) or `declEnvsOrdOf mid` over the very list
-- `buildDeclEnvs` indexed, so no live path can arrive at `-1`; a fourth Module-mode
-- driver, or any path stamping a mid `buildDeclEnvs` did not index, makes it live.  It
-- cannot fire spuriously, because `cur < 0` is exactly and only the miss sentinel and no
-- caller can construct a negative ordinal otherwise.
-- 🎯 WHAT THIS DOES *NOT* COVER, stated because it is the near miss: a driver that
-- threads a VALID-but-WRONG ordinal (some other module's) is undetectable here — the
-- sentinel is the only self-identifying failure — and `globalCoherenceConflict` takes no
-- ordinal at all (`cohRowsOf`, whole graph), so it is outside this guard entirely.
runFinalChecks : ModuleCtx ->
  List Decl ->
  ClassEnv ->
  ClassEnv ->
  ImplEnv ->
  ImplEnv ->
  Int ->
  Unit
runFinalChecks mctx cohDecls ownCe cycCe cohIe cycIe cur =
  let _ = ordinalSentinelGuard mctx cur
  let _ = checkCoherence mctx cohIe cur
  let _ = checkInterfaceCycles mctx cohDecls cycCe cur
  let _ = checkPhantomMethods mctx ownCe cur
  checkSuperImpls mctx cohDecls cycCe cycIe cur

-- SA-6's guard, split out so the arm is a GUARD and not a `whenL`.  ⚠️ Medaka is strict:
-- `whenL (cur < 0) (pushTypeError …)` would evaluate the push on EVERY call — the
-- documented not-a-stub trap.  A guarded function does not.
ordinalSentinelGuard : ModuleCtx -> Int -> Unit
ordinalSentinelGuard mctx cur
  | ordinalIsSentinel cur =
    pushTypeError mctx "T-INTERNAL-ORDINAL" ordinalSentinelMsg
  | otherwise = ()

-- is [cur] `declEnvsOrdOf`'s miss sentinel?  A real ordinal is an index into the list
-- `buildDeclEnvs` was handed, so it is >= 0 by construction; `0 - 1` is the only negative
-- value any producer in this file yields.
-- > ordinalIsSentinel (0 - 1)
-- True
-- > ordinalIsSentinel 0
-- False
-- > ordinalIsSentinel 3
-- False
ordinalIsSentinel : Int -> Bool
ordinalIsSentinel cur = cur < 0

checkOneIfaceCycle : ModuleCtx ->
  List Decl ->
  ClassEnv ->
  Int ->
  Ref (OrdMap Unit) ->
  CeRow ->
  Unit
checkOneIfaceCycle mctx prog ce cur done row =
  if not (omHasKey (ceRowDoneKey row) !done) then
    foreachUnit
      (pushTypeError
        (mctxAt
          (cycleReportLoc mctx.mcGraph.declEnvsRef.value.deReach prog cur row)
          mctx)
        "T-CYCLIC-SUPERINTERFACE")
      (ifaceDfsCycle ce cur done [row] row)

-- A cycle is reported at the name of the interface its walk started from when
-- the reading module [cur] declares it.  A module that only sees it reports it
-- at its import of the declaring module, or else at its first import of a
-- module that reaches the declaring one ([reach], each module's import
-- closure): the interface's span is in another file.  A module with no import
-- path to it reports it with no span.
cycleReportLoc : OrdMap (OrdMap Unit) -> List Decl -> Int -> CeRow -> Option Loc
cycleReportLoc reach prog cur row
  | ceRowOrd row == cur = ceRowLoc row
  | otherwise = match (ceRowIface row).irOrigin
    OriginModule owner => importLocFor reach prog owner
    _ => None

-- DFS from [current]; [path] is the stack of ROWS visited so far (including
-- [current] as its last element, used to reconstruct the cycle message).
-- Marks [current] as done after all its supers are explored.
ifaceDfsCycle : ClassEnv ->
  Int ->
  Ref (OrdMap Unit) ->
  List CeRow ->
  CeRow ->
  List String
ifaceDfsCycle ce cur done path current =
  let msgs = ifaceDfsCycleSupers ce cur done path (ceRowSupers current)
  done := omInsert (ceRowDoneKey current) () !done
  msgs

ifaceDfsCycleSupers : ClassEnv ->
  Int ->
  Ref (OrdMap Unit) ->
  List CeRow ->
  List Super ->
  List String
ifaceDfsCycleSupers _ _ _ _ [] = []
ifaceDfsCycleSupers ce cur done path ((Super { superHead = superName, superOrigin = so }) :: rest) =
  let msgs1 = ifaceDfsCycleOneSuper ce cur done path so superName
  msgs1 ++ ifaceDfsCycleSupers ce cur done path rest

-- check one super edge: cycle if the super's IDENTITY is on the DFS path; skip if
-- done; else recurse into the row that identity names.  A super naming no visible
-- interface abstains (see the miss-arm note at `checkInterfaceCycles`).
ifaceDfsCycleOneSuper : ClassEnv ->
  Int ->
  Ref (OrdMap Unit) ->
  List CeRow ->
  TyConOrigin ->
  String ->
  List String
ifaceDfsCycleOneSuper ce cur done path so superName =
  let key = regKeyOfTab (ifaceTabKey so superName)
  let rendered = regKeyRender key
  if containsRowKey rendered path then
    [cyclicSuperIfaceMsg (map ceRowIfaceName path ++ [superName])]
  else if omHasKey rendered !done then
    []
  else match ceLookupAt key cur ce
    None => []
    Some r => ifaceDfsCycle ce cur done (path ++ [r]) r

containsRowKey : String -> List CeRow -> Bool
containsRowKey _ [] = False
containsRowKey k (r :: rest)
  | ceRowDoneKey r == k = True
  | otherwise = containsRowKey k rest

-- map each super-param NAME through [subst] to its Ty, dropping any unmapped (so a
-- short result vs [params] signals an incomplete substitution → caller skips).
substParams : List String -> List (String, Ty) -> List Ty
substParams [] _ = []
substParams (p :: rest) subst = match lookupAssoc p subst
  Some t => t :: substParams rest subst
  None => substParams rest subst

-- does an `impl superName <head>` covering [goal] exist among [rows]?  [rows] are
-- `IE`'s rows, bound once by `checkSuperImpls`; [superKey] is the super's identity and
-- [superName] its bare spelling.
--
-- It compares the identity leg, never the buckets.  `ieInsertRow` indexes every row
-- under `oblIfaceKeys`, which mints two keys: the identity key and a bare-spelling
-- compatibility leg that #1438 still rides on.  Looking [superKey] up in
-- `ieConcrete`/`ieHeadless` would therefore answer with both same-spelled interfaces'
-- rows.  Reading `ieRows` and testing each row's own `IfaceRef` cannot reach the bare
-- bucket.
superImplExists : List ImplRow -> TabKey -> String -> List Ty -> Bool
superImplExists rows superKey superName goal =
  anyList (implRowMatchesSuper superKey superName goal) rows

-- Name first, then identity: `ifaceTabKey` allocates (it goes through `mkIdent`), and
-- this runs once per row per (impl x super) in a GC-bound stage.  Bare-name equality
-- is a necessary condition for key equality (`tabKeyOf` puts the same name into both
-- the `TkIdent` and the `TkBare` arm), so gating on it is sound; the identity compare
-- decides.
implRowMatchesSuper : TabKey -> String -> List Ty -> ImplRow -> Bool
implRowMatchesSuper superKey superName goal (ImplRow _ _ ir tys _ _ _) =
  ir.irName == superName
    && listLen tys == listLen goal
    && ifaceTabKey ir.irOrigin ir.irName == superKey
    && superHeadCovers tys goal

-- Whether the impl head [pats] covers the super goal [goal], which is the checked
-- impl's own head with its variables rigid: one substitution for the whole vector
-- (`matchOneSided`, as the min⊑ selector's `tySubsumesV` and the use site's
-- `implHeadSubst` match), so a variable [pats] repeats must bind equal types, and a
-- variable of [goal] matches only a variable of [pats].  `impl D (Pair a a)` does not
-- cover `D (Pair a b)` or `D (Pair Int Bool)`.  Effect rows are transparent on both
-- sides.  Type constructors compare by identity (`tyStep`), as at the use site.
superHeadCovers : List Ty -> List Ty -> Bool
superHeadCovers pats goal =
  isSome (matchOneSided superHeadStep eqStr tyStructEq (zipL pats goal) [])

superHeadStep : Ty -> Ty -> MStep String Ty Ty
superHeadStep pat t = tyStep pat (stripTyWrap t)

-- ── D3 / WS-2 part-2: GLOBAL (cross-module) coherence ──────────────────────
-- Per-module coherence accepts two DIFFERENT modules that
-- each define `impl C T` for the SAME instance — each module is locally coherent,
-- but jointly they are incoherent (silent dispatch ambiguity).  This pass scans
-- the joint impl set over ALL USER modules (the prelude is paired by the per-module
-- sweep, which reports with the impl's own span).
-- Each CohImpl carries the id of the module that PHYSICALLY declares it; imports do
-- NOT copy impl decls, so the joint set has exactly one entry per definition and a
-- structural (iface, head-tys) overlap already distinguishes distinct definitions —
-- no occurrence-dedup needed.  A conflict between two distinct modules is reported
-- naming BOTH (cohCrossModuleMsg via cohHardMsg's cross-module branch, or the
-- `(defined in …)` suffix `cohWhereSuffix` adds to the F-3d soft warning).
-- The joint impl set is `cohRowsOf` over the whole-graph `IE`, which leaves out the
-- prelude's rows, and the one-entry-per-definition property is `ieRows`' by
-- construction (imports copy no rows either).
--
-- the first cross-module coherence conflict of EACH CLASS (if any) as bare messages
-- — `(hard, soft)`, the same split `checkCoherence` reports, so the cross-module path
-- demotes the ⊑-incomparable class exactly as the per-module one does (F-3d).
-- Callers that thread errs as a VALUE (`checkModulesEntryFromDiags`) prepend these
-- themselves,
-- rather than relying on the typeErrors ref (cleared per-module by `freshModuleCtx`).
--
-- ⚠️ #414: this deliberately DROPS the blame-span `cohScan` returns.
-- Both consumers attach the diagnostic to the ENTRY module, but the span belongs to
-- whichever module declares the offending impl — and the `--json`/human renderers
-- key a diagnostic's file by the GROUP it is filed under, NOT by the filename
-- inside its own `Loc`.  Attaching a foreign span therefore renders a caret at that
-- line/col in the WRONG file.  Measured, with the impl 40 lines into a dependency:
--     ./main.mdk:42:7: Conflicting `impl C`. Defined in amod and bmod
-- — main.mdk is 5 lines long, so the caret block cannot even render.  That is worse
-- than the file-start default: a confidently wrong location beats an obviously
-- fabricated one only at misleading the reader.  The cross-module wording already
-- names BOTH owning modules, which is the locating information that actually helps
-- here.  Attaching a real span needs the renderers to honour `Loc`'s own filename
-- (a driver/diagnostics.mdk change, well beyond an S3 caret fix).
-- #1559 A-3.7: the input is the whole-graph `IE`, prelude carved out, not the driver's
-- per-module decl pairs.
--
-- ORDER IS THE THING THIS BITE COULD MOVE, because `cohScanInner` keeps the FIRST pair
-- per class over a `reverseL`-ed list and the wording names `e1` first.  The two orders
-- agree, term by term: the old list was `flatMap (cohImplsOfMid mid) prog` over the
-- driver's `modules` in dependency-first order; `ieRows` is built by `buildImplEnvGo`
-- over the same modules in ORDINAL order (which is that same order, offset by the
-- prelude at 0) and within a module by `implDeclFacts = flatMap implDeclFact prog`, in
-- decl order.  The one difference is the prelude, which `cohRowsOf` removes
-- BEFORE the `reverseL` below — so the filtered list's head is the first user module,
-- which is exactly what the old list's head was.
globalCoherenceConflict : ModuleCtx -> ImplEnv -> (Option String, Option String)
globalCoherenceConflict mctx env =
  match (cohScan
    CohSweepGlobal
    (reverseL (map (cohImplOfRow mctx) (cohRowsOf env)))
    [])
    CohScan hard soft => (map fst hard, map fst soft)

-- This recursion is aware (constraint-dictionary-routed) and bounded by the shared
-- `requires` measure (`reqWalkEnter`): a mono pinned to a concrete head routes RKey,
-- an in-scope constraint var routes RDict, per DICT-SEMANTICS §3 `assum`.

-- fill each constrained-fn call site's routes: one route per constraint mono.  A
-- mono pinned to a concrete head → RKey; still a constraint variable (a nested
-- constrained call) → RDict; otherwise RNone.
resolveDictApps : SiteCtx -> List PendingDictApp -> Unit
resolveDictApps sx [] = ()
resolveDictApps sx (app :: rest) =
  let sx = { sx | sxSite = app.pdaLoc }
  let routes =
    routesOfMonosTopV
      sx
      app.pdaEncl
      app.pdaScope
      app.pdaMonos
      app.pdaIfaces
      app.pdaArgVecs
  app.pdaRoutesRef := routes
  resolveDictApps sx rest

-- ── dict_pass: prepend dict parameters to constrained function definitions ──
-- For each top-level def of a name in [dictNames], prepend one `$dict_<fn>_<slot>`
-- parameter per constraint (arity from `funPredicateSlotsRef`, populated during
-- inference), matching the dicts EDictAt applies at call sites.  Multi-clause
-- functions are several DFunDef decls; each clause gets the same leading params.
-- #2189: [names] is the dict-passed set, which grows with the program, and this
-- maps over every decl, so a `contains n names` scan inside `dictPassDecl` is
-- O(decls x names).  The set is indexed once here; `dictPassDecl`/`dictPassLetBind`
-- probe it with `omHasKey`.
dictPass : ModuleCtx ->
  EvIndex ->
  String ->
  List String ->
  List Decl ->
  List Decl
dictPass mctx idx mid names prog =
  let pe = PassEvidence idx (Ref omEmpty)
  map
    (dictPassDecl
      mctx
      pe
      (omFromNames names omEmpty)
      (returnPosMethodNames prog))
    (mapProg
      (e => rewriteLocalDictExpr mctx.mcGraph (rewriteBinopExpr mctx pe e))
      (grantPass mctx.mcGraph pe mid prog))

passIndex : PassEvidence -> EvIndex
passIndex (PassEvidence idx _) = idx

-- The entry published for method occurrence [ev].  A miss in both is the index's
-- miss.
passMethodOf : PassEvidence -> EvId -> PassMethod
passMethodOf (PassEvidence idx minted) ev =
  match evidenceLookup (Some idx) "method occurrence" ev
    Ok v => passMethodFacts v
    Err message => match omLookup (intToString (evOrdinal ev)) minted.value
      Some v => passMethodFacts v
      None => panic message

passMethodFacts : EvVal -> PassMethod
passMethodFacts (EvMethod iface _ tag impls meths) =
  PassMethod iface tag (impls ++ meths)
passMethodFacts _ =
  panic "evidence table: a method occurrence answered by another kind of entry"

-- ── grant passing: the authority analogue of the dictionary pass ─────────────
-- Runs before the dictionary rewrites of module [mid], so a binder's authority
-- parameters land after the dictionary parameters those rewrites prepend, and
-- each recorded use is applied to its grants while it still carries its id.
grantPass : GraphCtx -> PassEvidence -> String -> List Decl -> List Decl
grantPass gctx pe mid prog =
  let st = gctx.graphRun.grants
  let saved = st.gsPassingModule.value
  st.gsPassingModule := mid
  let result = map (grantDecl gctx pe mid) prog
  st.gsPassingModule := saved
  result

grantDecl : GraphCtx -> PassEvidence -> String -> Decl -> Decl
grantDecl gctx pe mid (DFunDef pub n pats body site bid) =
  DFunDef
    pub
    n
    (grantParamPats (topGrantIds gctx mid n) n ++ pats)
    (grantBody gctx pe body)
    site
    bid
grantDecl gctx pe mid (DLetGroup pub binds) =
  DLetGroup
    pub
    (map
      (b => match b
        LetBind n clauses site bid =>
          grantLetBind
            gctx
            pe
            (grantParamPats (topGrantIds gctx mid n) n)
            (LetBind n clauses site bid))
      binds)
grantDecl gctx pe _ (d@(DInterface { name, ifaceOrigin, methods, ... })) = DInterface { d |
  methods =
    map (grantIfaceMethod gctx pe (ifaceWordOf ifaceOrigin name)) methods,
}
grantDecl gctx pe _ (d@(DImpl { iface, implOrigin, methods, ... })) = DImpl { d |
  methods = map (grantImplMethod gctx pe (ifaceWordOf implOrigin iface)) methods,
}
grantDecl gctx pe _ (DProp pub name params body) =
  DProp pub name params (grantExpr gctx pe body)
grantDecl gctx pe _ (DTest pub name body) =
  DTest pub name (grantExpr gctx pe body)
grantDecl gctx pe mid (DAttrib attrs d) =
  DAttrib attrs (grantDecl gctx pe mid d)
-- a declaration with no expression body (data, signatures, imports, externs)
grantDecl gctx _ _ d = d

-- A method that takes grants declares them after its value arguments, so the
-- arity every backend reads off the declaration counts them.
grantIfaceMethod : GraphCtx ->
  PassEvidence ->
  String ->
  IfaceMethod ->
  IfaceMethod
grantIfaceMethod gctx pe word (IfaceMethod n ty def mloc) =
  match methodGrantOf gctx word n
    None =>
      IfaceMethod
        n
        ty
        (map
          (d => match d
            MethodDefault ps e => MethodDefault ps (grantBody gctx pe e))
          def)
        mloc
    Some mg =>
      IfaceMethod
        n
        (insertGrantArrows mg.mgArity (listLen mg.mgNames) ty)
        (map
          (d => match d
            MethodDefault ps e =>
              let (ps2, e2) =
                grantMethodParams gctx mg n ps (grantBody gctx pe e)
              MethodDefault ps2 e2)
          def)
        mloc

grantImplMethod : GraphCtx -> PassEvidence -> String -> ImplMethod -> ImplMethod
grantImplMethod gctx pe word (ImplMethod n ps e) =
  match methodGrantOf gctx word n
    None => ImplMethod n ps (grantBody gctx pe e)
    Some mg =>
      let (ps2, e2) = grantMethodParams gctx mg n ps (grantBody gctx pe e)
      ImplMethod n ps2 e2

-- A method clause's grant parameters, after its value parameters; a clause
-- written with fewer parameters than the method's arity takes the missing ones
-- first and applies its body to them.
grantMethodParams : GraphCtx ->
  MethodGrant ->
  String ->
  List Pat ->
  Expr ->
  (List Pat, Expr)
grantMethodParams gctx mg n ps body =
  let grants = grantParamPats mg.mgNames n
  let given = listLen ps
  if given >= mg.mgArity then
    (take mg.mgArity ps ++ grants ++ drop mg.mgArity ps, body)
  else
    let missing =
      map (_ => freshGrantName gctx.graphRun.grants ()) (range given mg.mgArity)
    (
      ps ++ map (x => PVar x (Loc "" 0 0 0 0) noBinderId) missing ++ grants,
      applyExprs body (map EVar missing),
    )

-- [g] `List String` arguments after the first [k] arrows of a method's type.
insertGrantArrows : Int -> Int -> Ty -> Ty
insertGrantArrows k g (TyConstrained cs t) =
  TyConstrained cs (insertGrantArrows k g t)
insertGrantArrows k g (TyEffect effs tails t)
  | k > 0 = TyEffect effs tails (insertGrantArrows k g t)
insertGrantArrows k g (TyFun a b)
  | k > 0 = TyFun a (insertGrantArrows (k - 1) g b)
insertGrantArrows _ g t = grantArrows g t

grantArrows : Int -> Ty -> Ty
grantArrows g t
  | g <= 0 = t
  | otherwise =
    TyFun
      (TyApp (tyConBuiltin "List" None) (tyConBuiltin "String" None))
      (grantArrows (g - 1) t)

grantLetBind : GraphCtx -> PassEvidence -> List Pat -> LetBind -> LetBind
grantLetBind gctx pe params (LetBind n clauses site bid) =
  LetBind
    n
    (map
      (c => match c
        FunClause ps body => FunClause (params ++ ps) (grantBody gctx pe body))
      clauses)
    site
    bid

topGrantIds : GraphCtx -> String -> String -> List Int
topGrantIds gctx mid n =
  optionOr [] (omLookup (grantTopKey mid n) gctx.graphRun.grants.gsTopIds.value)

localGrantIds : GraphCtx -> String -> List Int
localGrantIds gctx n =
  optionOr [] (omLookup n gctx.graphRun.grants.gsLocalIds.value)

grantParamName : String -> Int -> String
grantParamName n i = "$auth_\{n}_\{intToString i}"

grantParamPats : List a -> String -> List Pat
grantParamPats ids n =
  map
    (i => PVar (grantParamName n i) (Loc "" 0 0 0 0) noBinderId)
    (range 0 (listLen ids))

-- The top-down walk: a use of a file extern or a method is rebuilt with every
-- argument it takes, so it sees its whole application spine before its
-- arguments do.
grantExpr : GraphCtx -> PassEvidence -> Expr -> Expr
grantExpr gctx pe e =
  let inner = grantExprInner gctx pe e
  let st = gctx.graphRun.grants
  match st.gsValueBounds.value
    Tip => inner
    _ => match fileValueKey st.gsPassingModule.value e
      Some key =>
        let bounds = optionOr [] (omLookup key st.gsValueBounds.value)
        fold
          (result (ty, chain) => fileBoundValue gctx chain ty result)
          inner
          bounds
      None => inner

grantExprInner : GraphCtx -> PassEvidence -> Expr -> Expr
grantExprInner gctx pe (ELam pats body) = ELam pats (grantBody gctx pe body)
grantExprInner gctx pe (e@(EApp _ _)) = match grantSpine e []
  (EDictAt n ev, args) => match grantOccOf gctx ev
    Some occ => match occ.goTrailing
      Some arity =>
        saturateGrants
          gctx.graphRun.grants
          (EVar n)
          arity
          (grantTerms gctx occ)
          (map (grantExpr gctx pe) args)
      None => mapChildren (grantExpr gctx pe) e
    None => mapChildren (grantExpr gctx pe) e
  (EMethodAt n seed ev, args) => match methodGrantUse gctx pe n ev
    MethodGrants arity grants =>
      saturateGrants
        gctx.graphRun.grants
        (EMethodAt n seed ev)
        arity
        grants
        (map (grantExpr gctx pe) args)
    LeadingGrants _ grants =>
      applyExprs
        (applyExprs (EMethodAt n seed ev) grants)
        (map (grantExpr gctx pe) args)
    NoGrants => mapChildren (grantExpr gctx pe) e
  _ => mapChildren (grantExpr gctx pe) e
grantExprInner gctx _ (EDictAt n ev) = grantUse gctx n ev
grantExprInner gctx pe (EMethodAt n seed ev) = match methodGrantUse gctx pe n ev
  MethodGrants arity grants =>
    saturateGrants gctx.graphRun.grants (EMethodAt n seed ev) arity grants []
  LeadingGrants _ grants => applyExprs (EMethodAt n seed ev) grants
  NoGrants => EMethodAt n seed ev
grantExprInner gctx pe (ELet m r (PVar x xloc bid) e1 e2) =
  ELet
    m
    r
    (PVar x xloc bid)
    (grantLocalRhs gctx x (grantExpr gctx pe e1))
    (grantExpr gctx pe e2)
grantExprInner gctx pe (ELetGroup binds body) =
  ELetGroup
    (map
      (b => match b
        LetBind x clauses site bid =>
          grantLetBind
            gctx
            pe
            (grantParamPats (localGrantIds gctx x) x)
            (LetBind x clauses site bid))
      binds)
    (grantExpr gctx pe body)
grantExprInner gctx pe (EBlock stmts) = EBlock (map (grantStmt gctx pe) stmts)
-- every other node: its children, through the one traversal every pass shares
grantExprInner gctx pe e = mapChildren (grantExpr gctx pe) e

grantStmt : GraphCtx -> PassEvidence -> DoStmt -> DoStmt
grantStmt gctx pe (DoLet m r (PVar x xloc bid) e site) =
  DoLet m r (PVar x xloc bid) (grantLocalRhs gctx x (grantExpr gctx pe e)) site
grantStmt gctx pe (DoExpr e) = DoExpr (grantExpr gctx pe e)
grantStmt gctx pe (DoBind p e) = DoBind p (grantExpr gctx pe e)
grantStmt gctx pe (DoLet m r p e site) = DoLet m r p (grantExpr gctx pe e) site
grantStmt gctx pe (DoAssign x e) = DoAssign x (grantExpr gctx pe e)
grantStmt gctx pe (DoFieldAssign x fs e) =
  DoFieldAssign x fs (grantExpr gctx pe e)

-- A local that quantifies authorities takes them ahead of its own parameters.
grantLocalRhs : GraphCtx -> String -> Expr -> Expr
grantLocalRhs gctx x e = match localGrantIds gctx x
  [] => e
  ids =>
    prependLocalDicts (map (i => grantParamName x i) (range 0 (listLen ids))) e

-- An application spine's head and its arguments, through source-location
-- wrappers.
grantSpine : Expr -> List Expr -> (Expr, List Expr)
grantSpine (EApp f x) args = grantSpine f (x :: args)
grantSpine (ELoc _ e) args = grantSpine e args
-- any other node is the head
grantSpine e args = (e, args)

-- A use of a source binding: the head applied to its grants.  A grant-only use
-- of a binding that quantifies nothing is the plain variable it stood for.
grantUse : GraphCtx -> String -> EvId -> Expr
grantUse gctx n ev =
  let head = if isGrantOnlyEv gctx ev then EVar n else EDictAt n ev
  match grantOccOf gctx ev
    None => head
    Some occ => match occ.goTrailing
      Some arity =>
        saturateGrants
          gctx.graphRun.grants
          (EVar n)
          arity
          (grantTerms gctx occ)
          []
      None => applyExprs head (grantTerms gctx occ)

-- A method occurrence's grants.  One that dispatches passes the method's, after
-- the value arity its written type spells; a use that inference did not record
-- (its denotation was settled by a path that instantiates no method scheme) passes
-- the empty authority, so the method's arity still agrees with every body and the
-- use is refused rather than admitted.  One routed to the standalone its name
-- shadows passes that binding's grants, which inference recorded when it typed
-- the occurrence as the standalone; a grant-taking standalone reached without that
-- record has no grants to pass, and is a compile-time failure.  The occurrence's
-- published arity counts the grants, as the backends read it; the published table
-- is read out of the cells after the pass, so that count is written to the
-- occurrence's cell (`setOccurrenceArity`).
methodGrantUse : GraphCtx -> PassEvidence -> String -> EvId -> MethodGrantUse
methodGrantUse gctx pe n ev =
  let (PassMethod iface tag _) = passMethodOf pe ev
  let recorded = grantOccOf gctx ev
  let use = match tag
    RLocal sym _ => match standaloneOcc recorded
      Some (arity, occ) => LeadingGrants arity (grantTerms gctx occ)
      None =>
        if omHasKey
          (if sym == "" then n else sym)
          gctx.graphRun.grants.gsTakers.value then
          panic
            "grant pass: '\{n}' is routed to a standalone binding that takes authority grants, but inference did not type this use as that binding"
        else
          NoGrants
    _ => match methodGrantOf gctx iface n
      None => NoGrants
      Some mg => match recorded
        Some occ =>
          if occ.goStandalone then
            MethodGrants mg.mgArity (map (_ => bottomGrant) mg.mgNames)
          else
            MethodGrants mg.mgArity (methodTerms gctx n mg occ)
        None => MethodGrants mg.mgArity (map (_ => bottomGrant) mg.mgNames)
  let _ = match use
    MethodGrants arity grants =>
      setOccurrenceArity gctx pe ev (arity + listLen grants)
    LeadingGrants arity grants =>
      setOccurrenceArity gctx pe ev (arity + listLen grants)
    NoGrants => ()
  use

-- An occurrence in a module the drive served has no cell in this lineage: its
-- entry in the index takes the count (`setServedArity`).
setOccurrenceArity : GraphCtx -> PassEvidence -> EvId -> Int -> Unit
setOccurrenceArity gctx pe ev arity
  | evOrdinal ev < gctx.graphRun.evBase = setServedArity (passIndex pe) ev arity
  | otherwise =
    let cell = methodCellOf gctx ev
    cell.ecArity := Some arity

-- A use recorded as the standalone binding a method occurrence shadows, with its
-- value arity.
standaloneOcc : Option GrantOcc -> Option (Int, GrantOcc)
standaloneOcc (Some occ) = match (occ.goStandalone, occ.goTrailing)
  (True, Some arity) => Some (arity, occ)
  _ => None
standaloneOcc None = None

-- A recorded method use's grants, one per authority the method quantifies.
methodTerms : GraphCtx -> String -> MethodGrant -> GrantOcc -> List Expr
methodTerms gctx n mg occ =
  let terms = grantTerms gctx occ
  if listLen terms == listLen mg.mgNames then
    terms
  else
    panic
      "grant pass: a use of method '\{n}' instantiated \{intToString (listLen terms)} authorities, but the method takes \{intToString (listLen mg.mgNames)} grants"

-- The empty authority: a grant that admits no path.
bottomGrant : Expr
bottomGrant = EListLit [ELit (LString "")]

applyExprs : Expr -> List Expr -> Expr
applyExprs f args = fold (acc a => EApp acc a) f args

-- A head applied to all [arity] value arguments and then its grants.  A partial
-- or value use becomes a function of the arguments still missing; the arguments
-- it was given are bound first, so each is evaluated once, where the program
-- wrote it.
saturateGrants : GrantState -> Expr -> Int -> List Expr -> List Expr -> Expr
saturateGrants st head arity grants args =
  let given = listLen args
  if given >= arity then
    applyExprs (applyExprs head (take arity args ++ grants)) (drop arity args)
  else
    let bound = map (a => (freshGrantName st (), a)) args
    let missing = map (_ => freshGrantName st ()) (range given arity)
    let call =
      applyExprs
        head
        (map (b => EVar (fst b)) bound ++ map EVar missing ++ grants)
    fold
      (body b =>
        ELet
          noDeclLoc
          False
          (PVar (fst b) (Loc "" 0 0 0 0) noBinderId)
          (snd b)
          body)
      (ELam (map (x => PVar x (Loc "" 0 0 0 0) noBinderId) missing) call)
      (reverseL bound)

freshGrantName : GrantState -> Unit -> String
freshGrantName st _ =
  let k = st.gsFresh.value
  st.gsFresh := k + 1
  "$grant_arg_\{intToString k}"

-- A declared file row bounds every operation performed while its body runs,
-- including operations in helpers and callbacks. The bound is checked in
-- addition to each extern's own grant; a statically named symlink can change
-- the physical order between the two authorities.
fileBoundKey : Loc -> String
fileBoundKey (Loc file line col endLine endCol) =
  "\{file}:\{intToString line}:\{intToString col}:\{intToString endLine}:\{intToString endCol}"

-- Some application and block roots carry locations only on their children.
-- Key the body by its first source node, and guard the whole body at its
-- binding/lambda seam, rather than guarding that child alone.
fileBodyLoc : Expr -> Option Loc
fileBodyLoc (ELoc l _) = Some l
fileBodyLoc e =
  let found = Ref None
  let _ =
    mapChildren
      (child =>
        let _ = match found.value
          None => found := fileBodyLoc child
          Some _ => ()
        child)
      e
  found.value

fileBoundSite : String -> Loc -> String
-- Parsed locations may have an empty file field; the module keeps equal
-- source spans in different modules from sharing a bound.
fileBoundSite mid loc =
  "\{intToString (stringLength mid)}:\{mid}:\{fileBoundKey loc}"

scopeFileBoundModule : ModuleCtx -> Unit -> String
scopeFileBoundModule mctx _ =
  (Scopes.scopeFrame
    (currentScopeStore mctx.mcGraph ())
    (captureScope mctx ())).sfModuleId

fileValueKey : String -> Expr -> Option String
fileValueKey mid e =
  map (loc => "\{fileBoundSite mid loc}:\{fileValueShape e}") (fileBodyLoc e)

fileValueShape : Expr -> String
fileValueShape (ELoc _ _) = "loc"
fileValueShape (EApp f _) = "app" ++ intToString (appSpineArgCount f + 1)
fileValueShape (ELam _ _) = "lambda"
fileValueShape _ = "value"

finishFileValueScope : ModuleCtx -> Unit -> Unit
finishFileValueScope mctx _ = match mctx.mcCells.fileValueScopes.value
  saved :: rest =>
    mctx.mcCells.fileValueScopes := rest
    let flows = wWindow mctx.mcCells.fileValueFlows (snd saved)
    let _ = wRestore mctx.mcCells.fileValueFlows saved
    let _ =
      map
        (flow =>
          if isEmptyL rest || not (unsettledFileValueFlow flow) then
            checkFileValueFlow mctx flow)
        flows
    -- A local result can be shaped by a later use in its enclosing scope.
    -- Keep its producer evidence until that receiving type is determined.
    let _ = match rest
      [] => ()
      _ =>
        wPushAll
          mctx.mcCells.fileValueFlows
          (reverseL (filterList unsettledFileValueFlow flows))
    ()
  [] => ()

unsettledFileValueFlow : (Option Loc, Mono, Mono) -> Bool
unsettledFileValueFlow (_, upper, lower) =
  unsettledPackedFileBound False upper lower

unsettledPackedFileBound : Bool -> Mono -> Mono -> Bool
unsettledPackedFileBound packed upper lower = match (
  normalize upper,
  normalize lower,
)
  (TVar _, _) => True
  (_, TVar _) => True
  (TQual u _, l) => unsettledPackedFileBound packed u l
  (u, TQual l _) => unsettledPackedFileBound packed u l
  (TApp uf ux, TApp lf lx) =>
    unsettledPackedFileBound True uf lf || unsettledPackedFileBound True ux lx
  (TFun ud ur ux, TFun ld lr lx) =>
    packed && unsettledFileRow ur lr
      || unsettledPackedFileBound packed ld ud
      || unsettledPackedFileBound packed ux lx
  _ => False

unsettledFileRow : EffRow -> EffRow -> Bool
unsettledFileRow upper lower =
  let (ua, ut) = rowFlat upper
  let (la, lt) = rowFlat lower
  isNonEmptyL ut
    || isNonEmptyL lt
    || anyList (a => narrowFileAtom a && authHasVars (atomAuth a)) (ua ++ la)

checkFileValueFlow : ModuleCtx -> (Option Loc, Mono, Mono) -> Unit
checkFileValueFlow mctx (loc, upper, lower) =
  if changesPackedFileBound False upper lower then
    pushTypeErrorOncePerSite
      mctx
      "T-FILE-BOUND-VALUE"
      loc
      ("a function's file bound cannot change inside a container: "
        ++ ppMonosShared [lower, upper]
        ++ "; annotate the function with the container's FileRead or FileWrite bound before packing it")

changesPackedFileBound : Bool -> Mono -> Mono -> Bool
changesPackedFileBound packed upper lower = match (
  normalize upper,
  normalize lower,
)
  (TQual u _, l) => changesPackedFileBound packed u l
  (u, TQual l _) => changesPackedFileBound packed u l
  (TApp uf ux, TApp lf lx) =>
    changesPackedFileBound True uf lf || changesPackedFileBound True ux lx
  (TFun ud ur ux, TFun ld lr lx) =>
    packed && changesFileRow ur lr
      || changesPackedFileBound packed ld ud
      || changesPackedFileBound packed ux lx
  _ => False

changesFileRow : EffRow -> EffRow -> Bool
changesFileRow upper lower =
  let (ua, ut) = rowFlat upper
  let (la, lt) = rowFlat lower
  isEmptyL ut
    && anyList
      (u =>
        narrowFileAtom u
          && (isNonEmptyL lt
            || anyList
              (l =>
                atomKey l == atomKey u
                  && not
                    (authSub (atomAuth l) (atomAuth u)
                      && authSub (atomAuth u) (atomAuth l)))
              la))
      ua

hasFileBoundValue : Mono -> Bool
hasFileBoundValue t = match normalize t
  TFun _ row result =>
    let (atoms, tails) = rowFlat row
    isEmptyL tails && anyList narrowFileAtom atoms || hasFileBoundValue result
  TQual inner _ => hasFileBoundValue inner
  _ => False

recordValueFileBound : ModuleCtx -> Expr -> Mono -> Unit
recordValueFileBound mctx e ty =
  if hasFileBoundValue
    ty then match fileValueKey (scopeFileBoundModule mctx ()) e
    Some key =>
      let st = mctx.mcGraph.graphRun.grants
      st.gsValueBounds :=
        omInsert
          key
          ((ty, grantChainAt mctx.mcGraph (captureScope mctx ()))
            :: optionOr [] (omLookup key st.gsValueBounds.value))
          st.gsValueBounds.value
    None => ()

-- Evaluate a function-valued expression once. Its bound becomes active on
-- application, and the returned function (if any) retains its own arrow rows.
fileBoundValue : GraphCtx -> List GrantBinder -> Mono -> Expr -> Expr
fileBoundValue gctx chain ty e =
  if hasFileBoundValue ty then match normalize ty
    TFun _ row result =>
      let fn = freshGrantName gctx.graphRun.grants ()
      let arg = freshGrantName gctx.graphRun.grants ()
      ELet
        noDeclLoc
        False
        (PVar fn (Loc "" 0 0 0 0) noBinderId)
        e
        (ELam
          [PVar arg (Loc "" 0 0 0 0) noBinderId]
          (fileBoundExpr
            gctx
            chain
            row
            (fileBoundValue gctx chain result (EApp (EVar fn) (EVar arg)))))
    TQual inner _ => fileBoundValue gctx chain inner e
    _ => e
  else
    e

recordFileBound : ModuleCtx -> Expr -> EffRow -> Unit
recordFileBound mctx body row =
  let (atoms, tails) = rowFlat row
  if isEmptyL tails && anyList narrowFileAtom atoms then match fileBodyLoc body
    None => ()
    Some loc =>
      let st = mctx.mcGraph.graphRun.grants
      let key = fileBoundSite (scopeFileBoundModule mctx ()) loc
      st.gsBounds :=
        omInsert
          key
          ((row, grantChainAt mctx.mcGraph (captureScope mctx ()))
            :: optionOr [] (omLookup key st.gsBounds.value))
          st.gsBounds.value

grantBody : GraphCtx -> PassEvidence -> Expr -> Expr
grantBody gctx pe body =
  let inner = grantExpr gctx pe body
  match gctx.graphRun.grants.gsBounds.value
    Tip => inner
    boundsBySite =>
      let bounds = match fileBodyLoc body
        Some loc =>
          optionOr
            []
            (omLookup
              (fileBoundSite gctx.graphRun.grants.gsPassingModule.value loc)
              boundsBySite)
        None => []
      fold
        (result (row, chain) => fileBoundExpr gctx chain row result)
        inner
        bounds

narrowFileAtom : Atom -> Bool
narrowFileAtom atom = match atomLabelOf atom
  EffLabel label OriginBuiltin =>
    (label == "FileRead" || label == "FileWrite")
      && not (authIsTop (atomAuth atom))
  _ => False

recordClauseFileBound : ModuleCtx -> Expr -> Int -> Mono -> Unit
recordClauseFileBound mctx body arity ty
  | arity <= 0 = ()
  | otherwise = match normalize ty
    TFun _ row result =>
      if arity == 1 then
        recordFileBound mctx body row
      else
        recordClauseFileBound mctx body (arity - 1) result
    TQual inner _ => recordClauseFileBound mctx body arity inner
    _ => ()

fileBoundExpr : GraphCtx -> List GrantBinder -> EffRow -> Expr -> Expr
fileBoundExpr gctx chain row body =
  let (atoms, tails) = rowFlat row
  if isNonEmptyL tails then
    body
  else
    fold
      (result atom =>
        let label = atomLabel atom
        if narrowFileAtom atom then
          applyExprs (EVar ("$with" ++ label ++ "Bound")) [
            grantTerm gctx chain (atomAuth atom),
            ELam [PWild] result,
          ]
        else
          result)
      body
      atoms

-- The grant terms of one use, one per authority the callee quantifies.
grantTerms : GraphCtx -> GrantOcc -> List Expr
grantTerms gctx occ = match occ.goRecIds
  [] => map (grantTerm gctx occ.goChain) occ.goCells
  ids => map (i => grantIdTerm gctx occ.goChain i) ids

-- The whole domain is the empty list, the empty authority a list holding only the
-- empty element (it admits no path), and a set of elements joined with the
-- parameters of enclosing binders is their concatenation.  A variable is the
-- parameter of the innermost enclosing binder that quantifies it.  Two kinds of
-- variable have no caller to supply them, an opened existential and an instance
-- head's index (`markSourceless`), and each is the whole domain: the escape check
-- has held the declaration it reaches to its label's top.  Any other variable
-- whose binder is not found contributes the empty authority, so a lost binder is
-- a refusal at run time rather than an unconfined operation.
grantTerm : GraphCtx -> List GrantBinder -> Authority -> Expr
grantTerm gctx chain a = match authGrantShape a
  GrantTop => EListLit []
  GrantBottom => bottomGrant
  GrantParts elems vars => match grantVarParams gctx chain vars []
    None => EListLit []
    Some params =>
      let parts =
        (if isEmptyL elems then
            []
          else
            [EListLit (map (s => ELit (LString s)) elems)])
          ++ map EVar (dedup params)
      match parts
        [] => bottomGrant
        [p] => p
        p :: rest =>
          fold
            (acc param => topAbsorbs param acc)
            -- Generated after inference: the list identity supplies the operand
            -- representation that a hidden grant parameter alone cannot carry.
            (fold
              (acc q => EBinOp "++" acc q unminted)
              (EListLit [])
              (p :: rest))
            (dedup params)

-- The parameters a join's variables are, or None when one of them has no caller
-- to supply it and so makes the join the whole domain.  A variable whose binder
-- is not found contributes nothing.
grantVarParams : GraphCtx ->
  List GrantBinder ->
  List (Ref Authvar) ->
  List String ->
  Option (List String)
grantVarParams gctx _ [] acc = Some (reverseL acc)
grantVarParams gctx chain (v :: rest) acc =
  match grantParamFor gctx chain (authvarId v)
    Some p => grantVarParams gctx chain rest (p :: acc)
    None =>
      if isSourceless gctx (authvarId v) then
        None
      else
        grantVarParams gctx chain rest acc

-- A parameter holding the whole domain makes a join it is part of the whole
-- domain; concatenation alone would narrow it to the other parts.
topAbsorbs : String -> Expr -> Expr
topAbsorbs param join =
  EMatch (EVar param) [Arm (PList []) [] (EListLit []), Arm PWild [] join]

-- A recursive use forwards its enclosing binder's parameters; one whose binder is
-- not found is the empty authority, as in `grantTerm`.
grantIdTerm : GraphCtx -> List GrantBinder -> Int -> Expr
grantIdTerm gctx chain i = match grantParamFor gctx chain i
  Some p => EVar p
  None => bottomGrant

-- The parameter of the innermost enclosing binder that quantifies authority [i].
grantParamFor : GraphCtx -> List GrantBinder -> Int -> Option String
grantParamFor gctx [] _ = None
grantParamFor gctx (b :: rest) i =
  let (name, ids) = match b
    TopGrantBinder mid n => (n, topGrantIds gctx mid n)
    LocalGrantBinder n => (n, localGrantIds gctx n)
    BodyGrantBinder n bound => (n, bound)
  match elemIndex i ids
    Some k => Some (grantParamName name k)
    None => grantParamFor gctx rest i

-- Routed operators become method applications, including generic arithmetic.
-- Packed instance prerequisites move into EMethodAt's implementation-dictionary
-- routes. RNone and scalar routes preserve primitive operations, so primitive
-- Num method bodies do not recursively call their own dictionary methods.
rewriteBinopExpr : ModuleCtx -> PassEvidence -> Expr -> Expr
rewriteBinopExpr mctx pe (EBinOp op l r ev) =
  match evSiteRouteIn (passIndex pe) ev
    RNone => EBinOp op l r ev
    -- SHARED-FLOAT-RESIDUAL §3(C): an RScalar route is NOT a typeclass dispatch — it
    -- is the scalar-type tag typecheck stamped on a monomorphic binop
    -- (its primitive head on arithmetic, an allowed comparison tag on comparison).
    -- Lowering does not read the
    -- EBinOp's site id, so we carry the scalar type in a NODE by wrapping the binop
    -- in `EAnnot … (TyCon tag)`.  Eval ignores the
    -- annotation (`eval (EAnnot e _) = eval e`) and evaluates the binop dynamically
    -- (Float-correct); lowering reads the annotation to stamp CBinPrim's scalar tag so
    -- the native emitter picks that type's primitive without reading the operands'
    -- structure.  This is the dispatch route READ-OUT the design names, relocated
    -- from the (lost) ref cell to a (surviving) node.
    --
    -- #1110 (was a residual, DRAINED by the stamping PR): `tag` is a SCALAR-TYPE
    -- TAG this pass synthesises (never a head the user wrote), and this runs AFTER
    -- resolve, so nothing downstream would ever stamp it.  It takes the same
    -- treatment as `parser.mdk`'s tuple head — the reserved BUILTIN origin, not the
    -- module under elaboration, which resolve does not know and this pass would be
    -- inventing.  Its only reader is `ir/core_ir_lower.mdk`'s
    -- `lower (EAnnot (EBinOp …) (TyCon { tyConName }))`, which takes the NAME and
    -- nothing else, so the origin is unobserved either way — but `OriginBuiltin` is
    -- the TRUE identity of a scalar tag, and leaving `OriginUnresolved` on a
    -- post-resolve node would keep the §8 I6.3 sentinel alive for no reason.
    RScalar tag => EAnnot (EBinOp op l r ev) (tyConBuiltin tag None)
    route => binopMethodApp mctx pe op l r route
-- PLAN.md #11: re-tag a source integer literal to its inferred runtime rep, a 3-way
-- decision.  setNumlitFloats already
-- decided: float cell `Some f` ⇒ concrete Float ⇒ `ELit (LFloat f)`; otherwise the
-- route cell [dref] distinguishes concrete-Int (RNone, cleared) from a surviving
-- polymorphic `Num a` (a non-RNone RDictFwd/RKey route, the soundness case) — the
-- latter dispatches through the runtime Num dict via `fromInt n` (the SAME dict the
-- enclosing `Num a => …` function threads), closing the hole where `inc x = x + 1`
-- instantiated at Float crashed `VFloat + VInt`.  A selected Num impl's prerequisite
-- routes are packed in [dref] and split onto the EMethodAt impl-dict carrier here.
-- Done in the same mapProg walk that rewrites binops, so
-- eval/lower never see ENumLit and eval_arith / the emitter get matching tags.
rewriteBinopExpr mctx pe (ENumLit n ev _) = match evSiteLitIn (passIndex pe) ev
  (Some f, _) => ELit (LFloat f)
  (None, dref) => match dref
    RNone => ELit (LInt n)
    route if fixedWidthLiteralFits route n => ELit (LInt n)
    route if u64LiteralFits route n =>
      ELit (LU64 (n / 4294967296) (n % 4294967296))
    RKey word _ _ if isI64Head (literalRouteHead word) =>
      let halves = int64Halves n
      ELit (LI64 (fst halves) (snd halves))
    route =>
      let split = binopRouteSplit route
      EApp
        (EMethodAt
          "fromInt"
          ""
          (mintMethodCellWith
            mctx
            pe
            (builtinMethodIfaceWord mctx.mcGraph "fromInt")
            1
            (fst split)
            (snd split)))
        (ELit (LInt n))
-- Roadmap #18c: rewrite each *stamped* EUnOp (`-` → `negate`) into its Num
-- method application via EMethodAt, exactly like the EBinOp arm above.  A site
-- whose operand is a non-primitive instance or a dictionary carries a dispatch
-- route; Int/Float (RNone or a scalar tag) stay the literal EUnOp the eval builtin handles
-- structurally (no recursion — Int's own `negate` body uses the BINOP `0 - a`, and
-- Float's unary minus has a scalar operand).  `!` never routes (stays RNone).
rewriteBinopExpr mctx pe (EUnOp op e ev) = match evSiteRouteIn (passIndex pe) ev
  RNone => EUnOp op e ev
  -- a primitive operand's scalar tag: the builtin negation, as for an unrouted site
  RScalar _ => EUnOp op e ev
  RKey word _ _ if op == "-"
    && isI32Head (literalRouteHead word)
    && isSome (negatedI32Lit e) => ELit (LInt (optionOr 0 (negatedI32Lit e)))
  route => unopMethodApp mctx pe op e route
-- A wide literal is a `U64` or `I64` constant (`checkWideLiterals` has refused it
-- at any other type, so a program that reaches eval/emit only has it at those).
-- At `I64` the halves are the pattern of the magnitude; a `-` around it is the
-- wrapping negation that makes `-2^63` `minBound`.
rewriteBinopExpr mctx pe (EWideLit hi lo ev _) =
  match evSiteRouteIn (passIndex pe) ev
    RKey word _ _ if isI64Head (literalRouteHead word) => ELit (LI64 hi lo)
    _ => ELit (LU64 hi lo)
rewriteBinopExpr mctx _ e = e

-- `-N` at `I32` is the constant `-N`: `-2147483648` is the one literal whose
-- magnitude alone does not fit, so negating `fromInt 2147483648` would panic
-- where the literal range check (which reads the negated value) accepted it.  The
-- operand is the literal already rewritten below it: a word, or the `fromInt`
-- call an out-of-range magnitude keeps.
negatedI32Lit : Expr -> Option Int
negatedI32Lit (ELoc _ e) = negatedI32Lit e
negatedI32Lit (ELit (LInt n)) = negatedInI32 n
negatedI32Lit (EApp (EMethodAt "fromInt" _ _) (ELit (LInt n))) = negatedInI32 n
-- Every other operand is ordinary negation, which `Num I32` wraps.
negatedI32Lit _ = None

-- The range is tested on `n` before it is negated, so no `Int` negation traps.
negatedInI32 : Int -> Option Int
negatedInI32 n =
  if n >= -2147483647 && n <= 2147483648 then Some (0 - n) else None

-- A literal routed to `U64`'s `fromInt` is a `U64` constant when it is not negative;
-- a negative one keeps its `fromInt` call, which panics, exactly as
-- `fixedWidthLiteralFits` leaves an out-of-range tagged literal.
u64LiteralFits : Route -> Int -> Bool
u64LiteralFits (RKey word _ _) n = isU64Head (literalRouteHead word) && n >= 0
u64LiteralFits _ _ = False

-- A literal routed to a fixed-width head's `fromInt` is that head's word already
-- when it is in range (the heads share Int's tagged word), so it needs no call.  The
-- range is checked HERE, on the value, not assumed from the module check: an
-- out-of-range literal keeps its `fromInt` call, which panics rather than storing it.
fixedWidthLiteralFits : Route -> Int -> Bool
fixedWidthLiteralFits (RKey word _ _) n =
  let head = literalRouteHead word
  match taggedFixedRange head
    Some (lo, hi) => n >= lo && n <= hi
    None => False
fixedWidthLiteralFits _ _ = False

-- The head type a literal's `fromInt` dictionary word names: the type field of the
-- instance's canonical key (`Num|I64|`).  The readers above test it only against the
-- builtin fixed-width heads, whose type field is the head's own name.
literalRouteHead : String -> String
literalRouteHead word = match splitOnChar '|' word
  _ :: ty :: _ => ty
  _ => word

-- split the stamped RKey route into a bare-tag route (reqs dropped) + the element
-- dict routes, so the dicts ride on the EMethodAt impl-dict ref (where emitMethod /
-- eval read leading dict words) rather than the route reqs (which the RKey call
-- path ignores).  A non-RKey / empty-reqs route forwards no dicts.
binopRouteSplit : Route -> (Route, List Route)
binopRouteSplit (RKey tag reqs sups) = (RKey tag [] sups, reqs)
binopRouteSplit r = (r, [])

binopMethodApp : ModuleCtx ->
  PassEvidence ->
  String ->
  Expr ->
  Expr ->
  Route ->
  Expr
binopMethodApp mctx pe op l r route =
  let method = optionOr "eq" (binopDispatchMethod op)
  let split = binopRouteSplit route
  let call =
    EApp
      (EApp
        (EMethodAt
          method
          ""
          (mintMethodCellWith
            mctx
            pe
            (builtinMethodIfaceWord mctx.mcGraph method)
            2
            (fst split)
            (snd split)))
        l)
      r
  if op == "/=" then EApp (EVar "not") call else call

binopDispatchMethod : String -> Option String
binopDispatchMethod op = match arithDispatchMethod op
  Some method => Some method
  None => binopMethod op

-- The EUnOp analogue of binopMethodApp: one operand, no `/=`-style postfix
-- (unopMethod only ever routes `-`).  Reuses binopRouteSplit (a generic
-- Route-ripping helper — nothing about it is binop-specific).
unopMethodApp : ModuleCtx -> PassEvidence -> String -> Expr -> Route -> Expr
unopMethodApp mctx pe op e route =
  let method = optionOr "negate" (unopMethod op)
  let split = binopRouteSplit route
  EApp
    (EMethodAt
      method
      ""
      (mintMethodCellWith
        mctx
        pe
        (builtinMethodIfaceWord mctx.mcGraph method)
        1
        (fst split)
        (snd split)))
    e

dictPassDecl : ModuleCtx ->
  PassEvidence ->
  OrdMap Unit ->
  List String ->
  Decl ->
  Decl
dictPassDecl mctx _ names _ (DFunDef pub n pats body site bid)
  | omHasKey n names =
    DFunDef pub n (dictParams n (dictArityOf mctx n) ++ pats) body site bid
  | otherwise = DFunDef pub n pats body site bid
-- Top-level `let rec … with …` (DLetGroup): each binding is dict-passed exactly
-- like a DFunDef — a constrained member gets `dictParams n (dictArityOf n)`
-- prepended to every clause's params, so the dict-passed call sites (which DO get
-- rewritten) line up with the definition.  (Without this, a `Num a => a -> a` group member's call site
-- supplies a leading dict the body never binds → the dict lands in the first user
-- param → arithmetic over a dict value panics `unknown op`.)
dictPassDecl mctx _ names _ (DLetGroup pub binds) =
  DLetGroup pub (map (dictPassLetBind mctx names) binds)
-- Phase 83/84 single-level + D3b-1: a parametric impl with `requires` gets one
-- leading `$dict_<method>_<slot>` param on each method (return- OR argument-
-- position) whose body actually reads an impl dict (so a terminal body like
-- `eq Nil Nil = True` would take none — but see implDictPassMethods: the param is
-- added UNIFORMLY across all clauses of a method when ANY clause uses the dict, so
-- a multi-clause method keeps one arity).  The routes resolveSite/resolveArgStamp
-- filled on the call-site EMethodAt's impl-dicts ref line up with these params.
dictPassDecl mctx pe _ _ (d@(DImpl { iface, implOrigin, reqs, methods, ... })) = DImpl { d |
  methods =
    implDictPassMethods
      mctx
      pe
      IfaceRef { irName = iface, irOrigin = implOrigin }
      (listLen reqs)
      methods,
}
-- Phase 69.x-e: a method with method-level constraints (foldMap's `Monoid m`) gets
-- one leading `$dict_<method>_<slot>` param per constraint on its DEFAULT body, so a
-- caller can supply the dictionary the body's `empty`/… reads (routed RDict by
-- inferDefaultMethod).
dictPassDecl mctx _ _ _ (d@(DInterface { typarams, methods, ... })) =
  DInterface { d | methods = map (ifaceDictPassMethod typarams) methods }
dictPassDecl mctx pe names ret (DAttrib attrs d) =
  DAttrib attrs (dictPassDecl mctx pe names ret d)
dictPassDecl mctx _ _ _ d = d

-- DLetGroup binding dict-pass: prepend the member's dict params to every clause.
-- `dictArityOf n` is 0 for an unconstrained member (no change), matching the
-- oracle's `if k = 0 then (n, clauses)` guard.  Gated on `names` (the constrained
-- set) so an unconstrained member with a coincidental arity entry is untouched.
dictPassLetBind : ModuleCtx -> OrdMap Unit -> LetBind -> LetBind
dictPassLetBind mctx names (LetBind n clauses site bid)
  | omHasKey n names =
    LetBind n (map (prependDictClause n (dictArityOf mctx n)) clauses) site bid
  | otherwise = LetBind n clauses site bid

prependDictClause : String -> Int -> FunClause -> FunClause
prependDictClause n k (FunClause pats body) =
  FunClause (dictParams n k ++ pats) body

ifaceDictPassMethod : List String -> IfaceMethod -> IfaceMethod
ifaceDictPassMethod typarams (IfaceMethod n ty (Some (MethodDefault pats body)) mloc) =
  ifaceDictPassDefault
    n
    ty
    pats
    body
    mloc
    (listLen (methodLevelConstraintVarNames typarams ty))
ifaceDictPassMethod _ m = m

ifaceDictPassDefault : String ->
  Ty ->
  List Pat ->
  Expr ->
  Option Loc ->
  Int ->
  IfaceMethod
ifaceDictPassDefault n ty pats body mloc k
  | k > 0 =
    IfaceMethod n ty (Some (MethodDefault (dictParams n k ++ pats) body)) mloc
  | otherwise = IfaceMethod n ty (Some (MethodDefault pats body)) mloc

-- D3b-1: add the leading `$dict_<method>_<slot>` params UNIFORMLY across all
-- clauses of a method.  An impl method is many ImplMethod entries (one per
-- clause), so a per-clause `usesImplDict` test would give clauses different
-- arities (`eq Nil Nil = True` uses no dict; `eq (Cons …) (Cons …) = … eq x y …`
-- does) and break coalescing.  Compute the set of method NAMES any of whose
-- clauses reads the dict, then prepend the params to every clause of those names.
-- No rpNames gate: usesImplDict already requires an in-body RDict route to one of
-- these params, which on the non-emit path no arg-position site ever has (its
-- occurrences stay bare EVar), so return-position goldens are unaffected.
-- TYPECHECK-AUDIT S2: each method gets, in oracle slot order, its selected
-- interface declaration's METHOD-LEVEL dict params (`dictParams n k` — e.g.
-- `build`'s `Num e`) FOLLOWED BY the impl-`requires` element-dict params (at slots
-- k..k+nReq-1, only when the body reads one), then the original pats.  The final
-- pass reads k through `DImpl.implOrigin`; body inference derives the same k from
-- its selected ClassEnv row.  This is a direct mirror of
-- `dict_pats n k @ impl_pats @ pats` shape and the
-- `method_off + slot` impl-dict naming.  Eval applies
-- method dicts unconditionally first (eval.mdk), so dropping the leading method-level
-- params (the old `match reqs []=>d` early-out) mis-bound the dict into the first
-- value parameter.
implDictPassMethods : ModuleCtx ->
  PassEvidence ->
  IfaceRef ->
  Int ->
  List ImplMethod ->
  List ImplMethod
implDictPassMethods mctx pe iface nReq methods =
  let users = dedup (flatMap (clauseImplDictUser mctx pe iface nReq) methods)
  map (prependImplDictIfUser mctx iface nReq users) methods

clauseImplDictUser : ModuleCtx ->
  PassEvidence ->
  IfaceRef ->
  Int ->
  ImplMethod ->
  List String
clauseImplDictUser mctx pe iface nReq (ImplMethod n _ body)
  | usesImplDict pe n (implMethodDictArity mctx iface n) nReq body = [n]
  | otherwise = []

-- params = method-level dicts (slots 0..k-1) ++ impl-`requires` dicts (slots
-- k..k+nReq-1, only when this method's body consumes one) ++ original pats.  Skip
-- entirely only when there are neither (k = 0 and no impl-dict use), matching the
-- oracle's `if k = 0 && not uses_impl_dict then (n, pats, body)`.
prependImplDictIfUser : ModuleCtx ->
  IfaceRef ->
  Int ->
  List String ->
  ImplMethod ->
  ImplMethod
prependImplDictIfUser mctx iface nReq users (ImplMethod n pats body) =
  let k = implMethodDictArity mctx iface n
  let implPats = if contains n users then dictParamsFrom n k nReq else []
  if k == 0 && isEmptyL implPats then
    ImplMethod n pats body
  else
    ImplMethod n (dictParams n k ++ implPats ++ pats) body

-- does [body] reference an in-body return-position method already routed RDict to
-- one of THIS method's would-be impl-dict params? (the gate that distinguishes a
-- body that consumes the element dict from a terminal one that doesn't).  Impl-dict
-- slots are offset by the method's own method-level arity (S2), so probe at k..k+nReq-1.
usesImplDict : PassEvidence -> String -> Int -> Int -> Expr -> Bool
usesImplDict pe mname methodArity nReq body =
  anyMember (collectDictSites pe body) (implDictNames mname methodArity nReq)

implDictNames : String -> Int -> Int -> List String
implDictNames mname methodArity nReq =
  map (dictParamName mname) (range methodArity (methodArity + nReq))

implMethodDictArity : ModuleCtx -> IfaceRef -> String -> Int
implMethodDictArity mctx iface method =
  methodDictArityAtOrigin mctx iface.irOrigin (methodSlotKey iface method)

-- [key] is a `methodSlotKey`; [origin] is its interface's declaring module.
methodDictArityAtOrigin : ModuleCtx -> TyConOrigin -> String -> Int
methodDictArityAtOrigin mctx (OriginModule mid) key =
  match (lookupQualPayload
    mid
    key
    mctx.mcGraph.crossRun.crossModuleMethodPredicateSlotsQualRef.value)
    Some slots => listLen slots
    None => methodDictArityOf mctx key
methodDictArityAtOrigin mctx _ key = methodDictArityOf mctx key

siteRDictName : Route -> List String
siteRDictName (RDict d) = [d]
siteRDictName (RDictFwd d) = [d]
siteRDictName (RProj inner _) = routeRDictName inner
siteRDictName _ = []

siteRDictNamesL : List Route -> List String
siteRDictNamesL rs = flatMap routeRDictName rs

routeRDictName : Route -> List String
routeRDictName (RDict d) = [d]
routeRDictName (RDictFwd d) = [d]
-- Native #54/#21 residual: an element-dict RKey route can NEST an RDict forwarding
-- the enclosing impl's `requires` dict (e.g. `RKey "$tuple" [RDict $dict_debug_0,
-- RDict $dict_debug_1]` for `debug (toList m)` in a `Debug (Map k v)` body).  The
-- gate that decides whether to PREPEND those impl-dict params (usesImplDict) must
-- see the nested name, else the route references a param the clause never declares
-- → emitter panics "unbound dict witness".  Recurse into the nested reqs.
routeRDictName (RKey _ reqs sups) =
  flatMap routeRDictName reqs ++ flatMap routeRDictName sups
routeRDictName (RProj r _) = routeRDictName r
routeRDictName _ = []

-- The dict-param names the method occurrences and dictionary applications in [e]
-- route to: an `EMethodAt`'s dispatch route (RDict/RDictFwd, post-resolveSites)
-- and its impl-/method-dict route LISTS, and every `EDictAt` route list that
-- forwards RDict/RDictFwd to an impl param (a `=>`-constrained helper call that
-- threads the impl dict through, e.g. `debug xs = "[\{debugListItems xs}]"` where
-- `debugListItems` is an EDictAt).
--
-- An EMethodAt arg-position site carries its element-dict routes in the
-- impl-/method-dict lists, not its dispatch route.  A nested `requires` impl whose
-- body dispatches a method on its own element tyvar routes RDict $dict_<m>_<slot>
-- there, so both are scanned for implDictPassMethods' usesImplDict gate to prepend
-- the matching param.
collectDictSites : PassEvidence -> Expr -> List String
collectDictSites pe (EDictAt _ ev) =
  siteRDictNamesL (evDictRoutesIn (passIndex pe) ev)
collectDictSites pe (EMethodAt _ _ ev) =
  let (PassMethod _ tag dicts) = passMethodOf pe ev
  siteRDictName tag ++ siteRDictNamesL dicts
collectDictSites pe (ELoc _ e) = collectDictSites pe e
collectDictSites pe (EDoOrigin _ e) = collectDictSites pe e
collectDictSites pe (EApp f x) = collectDictSites pe f ++ collectDictSites pe x
collectDictSites pe (ELam _ b) = collectDictSites pe b
collectDictSites pe (ELet _ _ _ e1 e2) =
  collectDictSites pe e1 ++ collectDictSites pe e2
collectDictSites pe (ELetGroup binds body) =
  flatMap (letBindDictSites pe) binds ++ collectDictSites pe body
collectDictSites pe (EMatch e arms) =
  collectDictSites pe e ++ flatMap (armDictSites pe) arms
collectDictSites pe (EIf c t e) =
  collectDictSites pe c ++ collectDictSites pe t ++ collectDictSites pe e
collectDictSites pe (EBinOp _ l r _) =
  collectDictSites pe l ++ collectDictSites pe r
collectDictSites pe (EUnOp _ e _) = collectDictSites pe e
collectDictSites pe (EInfix _ l r) =
  collectDictSites pe l ++ collectDictSites pe r
collectDictSites pe (EFieldAccess e _ _) = collectDictSites pe e
collectDictSites pe (ETuple es) = flatMap (collectDictSites pe) es
collectDictSites pe (EListLit es) = flatMap (collectDictSites pe) es
collectDictSites pe (EArrayLit es) = flatMap (collectDictSites pe) es
collectDictSites pe (ERangeList a b _) =
  collectDictSites pe a ++ collectDictSites pe b
collectDictSites pe (ERangeArray a b _) =
  collectDictSites pe a ++ collectDictSites pe b
collectDictSites pe (ESlice e a b _) =
  collectDictSites pe e ++ collectDictSites pe a ++ collectDictSites pe b
collectDictSites pe (EIndex e i) =
  collectDictSites pe e ++ collectDictSites pe i
collectDictSites pe (EAnnot e _) = collectDictSites pe e
collectDictSites pe (EBlock stmts) = flatMap (doStmtDictSites pe) stmts
collectDictSites pe (ERecordCreate _ fs) = flatMap (fieldAssignDictSites pe) fs
collectDictSites pe (ERecordUpdate e fs _) =
  collectDictSites pe e ++ flatMap (fieldAssignDictSites pe) fs
collectDictSites pe (EVariantUpdate _ e fs) =
  collectDictSites pe e ++ flatMap (fieldAssignDictSites pe) fs
collectDictSites _ _ = []

letBindDictSites : PassEvidence -> LetBind -> List String
letBindDictSites pe (LetBind _ clauses _ _) =
  flatMap (funClauseDictSites pe) clauses

funClauseDictSites : PassEvidence -> FunClause -> List String
funClauseDictSites pe (FunClause _ body) = collectDictSites pe body

armDictSites : PassEvidence -> Arm -> List String
armDictSites pe (Arm _ guards body) =
  flatMap (guardDictSites pe) guards ++ collectDictSites pe body

guardDictSites : PassEvidence -> Guard -> List String
guardDictSites pe (GBool e) = collectDictSites pe e
guardDictSites pe (GBind _ e) = collectDictSites pe e

doStmtDictSites : PassEvidence -> DoStmt -> List String
doStmtDictSites pe (DoExpr e) = collectDictSites pe e
doStmtDictSites pe (DoLet _ _ _ e _) = collectDictSites pe e
doStmtDictSites pe (DoBind _ e) = collectDictSites pe e
doStmtDictSites pe (DoAssign _ e) = collectDictSites pe e
doStmtDictSites pe (DoFieldAssign _ _ e) = collectDictSites pe e

fieldAssignDictSites : PassEvidence -> FieldAssign -> List String
fieldAssignDictSites pe (FieldAssign _ e) = collectDictSites pe e

dictArityOf : ModuleCtx -> String -> Int
dictArityOf mctx n =
  listLen
    (optionOr
      []
      (lookupPredicateSlots n mctx.mcCells.funPredicateSlotsIdxRef.value))

dictParams : String -> Int -> List Pat
dictParams n k = dictParamsGo n 0 k

dictParamsGo : String -> Int -> Int -> List Pat
dictParamsGo n slot k
  | slot >= k = []
  | otherwise =
    PVar (dictParamName n slot) (Loc "" 0 0 0 0) noBinderId
      :: dictParamsGo n (slot + 1) k

-- [count] dict params for [n] starting at slot [start]: $dict_n_start ..
-- $dict_n_(start+count-1).  Used for impl-`requires` element-dict params, which
-- follow the method's own method-level params (S2 offset = methodDictArityOf).
dictParamsFrom : String -> Int -> Int -> List Pat
dictParamsFrom n start count
  | count <= 0 = []
  | otherwise =
    PVar (dictParamName n start) (Loc "" 0 0 0 0) noBinderId
      :: dictParamsFrom n (start + 1) (count - 1)

-- #80: the single per-module typecheck body, reached from the graph driver through
-- `checkModuleFullImpl`. DICT-SEMANTICS §7's single-evaluator law means one
-- elaboration decision serves check, run, and emit. `mid` and `implDecls` carry the
-- current module's identity and graph-visible impl universe; single-file callers use
-- the same function through the one-module graph projections.
--
-- The module's `ModuleCtx` is minted here, before anything else runs, and returned
-- beside the bindings: the driver continues from it.  [gctx] is the drive's graph
-- record, which the driver passes (the previous record's `mcGraph`).  [runSeed] is its
-- match oracle and warnings (`seedCheckRun`); a driver that does not seed
-- (`cmCheckWorker`, the core passes) passes the previous record's (`checkRunResidue`).
checkBodyImpl : GraphCtx ->
  CheckRunSeed ->
  ModuleSeed ->
  String ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List Decl, ModuleCtx)
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
checkBodyImpl gctx runSeed moduleSeed mid implDecls prog0 =
  let seed = moduleSeed.msSchemes
  let mctx = freshModuleCtx gctx runSeed mid
  let moduleScope =
    Scopes.freshScope
      (currentScopeStore gctx ())
      None
      mctx.mcCells.currentLevel.value
      mid
      ModuleOwner
  let _ = openScope mctx moduleScope
  let _ = recordModuleStart gctx mid
  -- #1675: this module's own `import`/`export import` decls, checked for a name the
  -- named dependency exports under two different definitions.  Here rather than in
  -- `importSeed` because the seed is built BEFORE this `freshModuleCtx` — see
  -- `reportAmbiguousImports`.  Reads only `deAmbigValues`, so a driver with no graph
  -- envelope (Flat, single-file) is a no-op.
  let _ = reportAmbiguousImports mctx prog0
  let prog = prog0
  let aliasSpellings = aliasMethodSpellings gctx prog
  -- P1 (#1446) / DICT §8 I7: the four operator-and-literal classes' identities, read
  -- off the PRELUDE's own `DInterface` decls before any body is inferred (the operator
  -- handlers consult them during inference).  See `seedBuiltinClasses`.
  let _ = seedBuiltinClasses gctx mid prog
  -- #837: stamp binding ids on the program the bodies are INFERRED from.  `prog`
  -- itself stays unstamped for the pre-inference analyses (shadows/key table/…),
  -- which do not need ids; only the inferred bodies (defs + impl/default/prop/test)
  -- carry EVarId, and schemeDefIdsRef feeds registerSchemeObligations the top-level
  -- members' ids.  Flat: a single walk (top-level frame built over the whole `prog`,
  -- so a user body referencing a prelude fn gets the prelude fn's id), then split
  -- back into core/user slices for the two-phase Flat inference.  Module: the
  -- scope alone is minted here; each binding group is MARKED and then stamped as the
  -- schedule reaches it (`processSCC`), and the tail bodies after the groups, so
  -- `progS` is the module's UNMARKED, unstamped tree and `progT` below its inferred
  -- twin.  The Flat callers marked their whole program before this call.
  let stampRes =
    let (top, ids) = stampTopScope prog
    let _ = beginModuleMarking mctx mid prog top moduleSeed
    (prog, ids)
  let progS = fst stampRes
  -- #907: index name→id as an OrdMap (was a List scanned linearly per rendered
  -- scheme in ownContext / per SCC member in registerSchemeObligations → O(decls²)).
  -- Built from the REVERSED pairs so omFromPairs' last-write-wins reproduces the old
  -- `lookupAssoc` first-match-wins on a duplicated binder name (same pattern as sigTyMapRef).
  mctx.mcCells.schemeDefIdsRef := omFromPairs (reverseL (snd stampRes)) omEmpty
  -- the full visible universe (shadows / key table /
  -- completeness / obligations): Flat = whole flattened program; Module = imported
  -- data + impl universe + this module.
  -- #154 PR-A: every consumer of `fullUniverse` is a `Flat _ =>` arm (grep confirms:
  -- buildDefinerShadows
  -- / checkImplObligations / checkCallObligations — all Flat).  #1557 A-3.5a removed
  -- `checkImplCompleteness` from that list: impl-completeness no longer takes a decl
  -- list, it reads `classEnvHere`,
  -- which IS this binding on that arm).  Medaka is STRICT, so the
  -- Module arm's `accData ++ implDecls ++ prog0` allocated an O(|accData|) list every module
  -- and discarded it unread — a dead per-module O(N) concat.  Bind `[]` on Module.
  -- registerAllData universe (#154 PR-A): the Module path no longer builds `accData ++ prog0`
  -- here — prior modules' public data lives in the persistent DATA-universe accumulators
  -- (universeCtorPop/universeRecordPop), loaded+overlaid at the `dataEnv` binding below.
  -- (#6, #1457) superDeclsRef: unified body OWNS it — Flat = coreProg ++ userProg, Module =
  -- `prog ++ implDecls`.  [implDecls] is core + every EARLIER module ONLY (foldModules never
  -- folds a module into its own universe), so binding it alone EXCLUDED this module's own
  -- `interface F t requires L t` decl from ifaceSelfAndSupers/survivorObligationEntailed and
  -- false-rejected every legal superclass-default body (#1457).  Folding `prog` in matches the
  -- graph path, whose universe includes this module itself.
  -- ⚠️ Operand order is load-bearing, BOTH ways:
  --   * cost — Medaka is strict, so `xs ++ ys` copies xs and shares ys.  [implDecls] is the
  --     growing accumulator, so it MUST be the right operand: `prog ++ implDecls` is O(|prog|)
  --     per module = O(N) overall, whereas `implDecls ++ prog` would resurrect #154 PR-C's
  --     O(modules²) per-module concat.
  --   * meaning — ifaceSupersOf/ifaceSelfAndSupers is a FIRST-MATCH scan, so `prog` first makes
  --     THIS module's own same-spelled interface decl outrank an earlier module's, which is the
  --     precedence the old single-program path had.
  let superDecls = prog ++ implDecls
  mctx.mcCells.superDeclsRef := superDecls
  -- (BREAK #3) effect domains: FLAT populates inline; MODULE relies on the driver
  -- preamble (checkModulesPreambleK / elaborateModules) populating ONCE over the whole
  -- import graph — a per-module populate would wipe another module's domains.
  let _ = checkEffectParams mctx prog
  let _ = checkLetRecDecls mctx prog
  -- #154 PR1: on the Module path, grow the persistent universe accumulators by THIS
  -- module's decls BEFORE the shadow/key reads below consult them — so they see the
  -- same universe `fullUniverse` (which appended prog0) did.
  -- untouched and rebuilds over its whole `prog` (already O(N)).
  -- #1112 A-3.4 PR2: `ieShadowCompare mid prog0` stood here, and the hard `panic`
  -- surface it put in the released compiler is GONE with it — that instrument had
  -- exactly one job, measuring the §9.5 equality before the flip committed to it,
  -- and the flip has now been made on a strictly stronger measurement (see
  -- `moduleImplUniv` just below for what was measured and how it was shown
  -- fail-capable).  `appendUniverseAccums` no longer grows an impl universe either,
  -- so there is nothing left here for `IE` to be compared against.
  -- #1499 clause (b) / S1-PRELUDE (a): `mid` is BOUND here now — `appendUniverseAccums`
  -- must know whether this pass is the PRELUDE's, because the prelude contributes to
  -- S1's INTERFACE operand but NOT to its STANDALONE one.  See its header.
  let _ = appendUniverseAccums gctx mid prog0
  -- 🚨 #1112 A-3.4 PR2 — THE `IE` READER FLIP.  A production read of stage K's `IE`
  -- (A-3.5b added a second, `ieRowsVisibleAt`; do NOT re-instate "the ONE place" here).
  -- It replaced the three `obUniv*` `CrossRun` accumulators, which are GONE rather than
  -- merely unread — two sources of truth for "what impls exist" is what design law L1
  -- removes.  The WAS/NOW migration narrative, and the whole-prefix equality MEASUREMENT
  -- that licensed deleting the `ieShadowCompare` instrument, live in
  -- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` §9.5a; what stays here are the facts a
  -- reader OF THIS LINE needs.
  --
  -- 🚨 SINCE A-3.6 (#1558) THIS IS NOT FILTERED TO THIS MODULE'S ORDINAL PREFIX.
  -- `ieSnapAt` routes through `ieCandidacyVisibleAt`, which is `True`, so this binding is
  -- the WHOLE GRAPH's impl universe regardless of `mid`'s ordinal.  This line is where
  -- A-3's C4/I2 claim is cashed: every obligation check on the multi-module path knows the
  -- same impl population in every module — *"import scoping never decides which instances
  -- exist"* (`docs/spec/DICT-SEMANTICS.md` §8 I5).  It WIDENS #1438's same-spelled-
  -- interface reach (#1482 measured that topological prefix scoping was accidentally
  -- load-bearing for it); expected and licensed, but an acceptance delta.  ⚠️ The pin that
  -- used to grade that delta, `test/must_fail_fixtures/1072-overlap-xmod-bare-head-arm-
  -- order`, IS GONE FROM THE TREE (derive: `ls test/must_fail_fixtures | grep 1072`) — see
  -- §9.5a; do not read its absence as "already drained".
  --
  -- ⚠️ `declEnvsOrdOf mid` IS STILL PASSED AND IS NOW INERT ON THIS PATH.  It is
  -- kept so the call site does not move and so re-scoping candidacy later is a
  -- one-line change; do not "simplify" it away, and do not read its presence as
  -- evidence a filter is still applied.  Its `-1` miss sentinel is likewise vacuous
  -- here — an unknown module id now gains the whole graph rather than losing
  -- everything, the opposite of the fail-CLOSED story `declEnvsOrdOf` documents for
  -- the NAME axis.
  --
  -- 🚨 BOUND ONCE, READ TWICE, AND THE "ONCE" IS LOAD-BEARING.  There are TWO Module-arm
  -- consumers — `residualUnivRef` (#1549) just below, and the end-of-body obligation
  -- `obUniv` — and A-3.4's own design was written when there was only ONE.  Do not
  -- re-derive the projection at the second site: it is a whole-prefix rebuild, so a
  -- second call doubles this unit's already-measured per-module cost for a value that
  -- cannot have changed (both `ord` and `IE` are immutable for the whole module; the
  -- accumulator these replaced was likewise grown once, above, and read at both sites).
  -- A third consumer should take this binding too, or say in writing why it needs a
  -- different ordinal.
  let moduleImplUniv =
    let envs = gctx.declEnvsRef.value
    ieUniverseAt (declEnvsOrdOf mid envs) envs.deImpls
  -- #1549: stash the impl universe the RESIDUAL REDUCER entails against
  -- (`residualPredsOf`, called from each generalizing group's close).  This is NOT a
  -- third source: it is the SAME two arm-gated sources the end-of-body obligation
  -- checkers consume — `buildImplUniverse prog` on Flat, and since A-3.4 PR2 the `IE`
  -- projection on Module (which carries this module's own impls, its ordinal being
  -- included by `declEnvVisibleAt`, exactly as the retired accumulator did after the
  -- `appendUniverseAccums` above).  Built ONCE per module rather than per group:
  -- rebuilding it inside the reducer would be O(decls) per SCC, i.e. quadratic.
  let _ = setRef mctx.mcCells.residualUnivRef moduleImplUniv
  -- (#4) shadows.  definerShadows uses the SHARED form — buildDefinerShadows over the
  -- full visible universe, scoped to THIS module's decls (prog0).  On Flat, prog0 =
  -- userProg and fullUniverse = prog, so this is exactly the old flat `buildDefinerShadows
  -- prog userProg`.  The method-name test, `isMethod`, reads `deMethods` at this module's
  -- ordinal: every interface method a module at or before it declares, whatever its
  -- export.  importerShadows exist only across a module boundary; the `Module _ _ []` arm
  -- (cmCheckWorker / core pass, implDecls = []) keeps the old empty result — `funDefs []
  -- = []` gave no imported fns there.
  -- #1354 unit A (#1353): that test is not scoped to what this module can name, so the
  -- intersection alone implements only S1's LEFT operand.  `nameableIfaceShadows` supplies
  -- the RIGHT one — the interface must be nameable in THIS module.  Applied to the RESULT,
  -- never inside either filter (the result is single-digit; `fnSet` is every fn name in
  -- the graph), and fail-open when the graph index is absent.  See `nameableIfaceShadows`.
  -- The Flat arms are untouched: a single file is one module and its own interfaces are
  -- nameable in it.
  let isMethod =
    let envs = gctx.declEnvsRef.value
    methodNameDeclaredAt (declEnvsOrdOf mid envs) envs.deMethods
  let definerShadows =
    nameableIfaceShadows gctx prog0 (definerShadowsFromSet gctx isMethod prog0)
  let importerShadows =
    if isEmptyL implDecls then
      []
    else
      nameableIfaceShadows
        gctx
        prog0
        (standaloneShadowsFromSet
          gctx
          isMethod
          (omMapValues (_ => ()) moduleSeed.msImportedValues)
          prog0)
  let sigs = sigsOf prog
  mctx.mcCells.definerShadowNamesRef := namesToSet definerShadows omEmpty
  mctx.mcCells.definerShadowSigsRef := omFromPairs (reverseL sigs) omEmpty
  -- #154 PR1 seeded a SECOND impl-existence table here — `shadowKeyTableRef`, from
  -- `buildKeyTable fullUniverse` on Flat and from the cumulative `universeKeyBucketsRef`
  -- on Module.  ARCH B-2.1-g repointed all three of its boolean existence reads onto the
  -- graph-global `bodyImplEnvRef` seeded just below (`ieImplExistsForHead`), and B-2.1-d
  -- deleted both refs.  🚨 DO NOT RE-ADD A PREFIX-KEYED EXISTENCE TABLE HERE.  The Module
  -- arm's source was a cumulative TOPOLOGICAL PREFIX while S2's impl universe is
  -- graph-global (`SHADOW-SEMANTICS.md:183-186`, `:226`), so an importer shadow whose
  -- receiver's impl sat in a topologically later module answered "no impl" and called the
  -- standalone — a located reject became exit 0 printing a `Box` pointer fed to `n + 1`,
  -- discriminated by the order of two `import` lines.  One substrate, one decision.
  -- ARCH B-2.1-a2: the SAME impl population, seated on `IE`'s shape, on BOTH arms —
  -- one ref, so the evidence reader B-2.1-b repoints has one substrate rather than an
  -- arm gate.  It landed ADDITIVE AND BEHAVIOUR-NEUTRAL, so the repoints that followed got
  -- a substrate they could trust on a path where `IE` was empty (see `buildFlatImplEnv`
  -- for the measured hazard, RUN-B-017 probe 3).
  -- ⚠️ "nothing reads `bodyImplEnvRef` yet" was true only at a2 and is now FALSE: B-2.1-b2's
  -- three selection legs, and B-2.1-g's route word plus three shadow existence reads, all
  -- read this ref.  Derive the set: `grep -n bodyImplEnvRef compiler/types/typecheck.mdk`.
  -- The Module arm is a pointer copy of the env `buildDeclEnvs` already built; it
  -- deliberately does NOT re-derive, for the reason `moduleImplUniv` gives above.
  mctx.mcCells.bodyImplEnvRef := gctx.declEnvsRef.value.deImpls
  -- (#4 + #3-restore) mode-specific pre-inference ref setup (all pure/independent of the
  -- register+globalS block below, so order-safe).  Module installs importer-shadow state and restores the cross-module dict
  -- accumulators `freshModuleCtx` just wiped.
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op

  -- #1425 site 2: `mid` is BOUND here now — the three lockstep re-keys at the end of this
  -- arm need this module's identity, and the arm can no longer discard it.

  let _ =
    mctx.mcCells.standaloneValuesRef :=
      namesToSet (importerShadows ++ definerShadows) omEmpty
    -- #1351: the per-module copy of the identity-keyed dispatch-index universe, read by
    -- `methodDispatchIdx` through `dispatchIdxScoped`.  Its bare-name peer was retired at L5.
    mctx.mcCells.methodDispatchIdxByIdRef :=
      gctx.crossRun.universeMethodDispatchIdxByIdRef.value
    -- The list alone is seeded here and re-keyed twice below; nothing reads the
    -- name index until the final `setFunPredicateSlots` of this arm rebuilds it.
    mctx.mcCells.funPredicateSlotsRef :=
      gctx.crossRun.crossModuleFunPredicateSlotsRef.value
    -- B-2.2-f (#1113): the declared-prefix sidecar rides the IDS table — every
    -- whole-table replacement of `funConstraintsRef` owes one of these.
    mctx.mcCells.funConstraintDeclaredRef :=
      gctx.crossRun.crossModuleFunConstraintDeclaredRef.value
    -- A module alias (`import m as A`) has no `currentImportDefinersRef` row for
    -- each dotted member, so its call sites resolve through these alias-local rows.
    -- The source is nevertheless exact: `aliasConstraintEntries` selects only the
    -- `(defining module, exported name)` row admitted by that alias. Preserve the
    -- complete predicate vectors here; stripping them reduces distinct predicates
    -- such as `Tweak a Int` and `Tweak a Bool` to the ambiguous goal `Tweak a`.
    -- The graph-wide bare-name snapshot below remains vector-free because it lacks
    -- this source identity.
    let _ =
      setRef
        mctx.mcCells.funPredicateSlotsRef
        (aliasConstraintEntries
            gctx
            prog
            gctx.crossRun.crossModuleFunPredicateSlotsQualRef.value
          ++ mctx.mcCells.funPredicateSlotsRef.value)
    let _ =
      setRef
        mctx.mcCells.funConstraintDeclaredRef
        (aliasConstraintEntries
            gctx
            prog
            gctx.crossRun.crossModuleFunConstraintDeclaredQualRef.value
          ++ mctx.mcCells.funConstraintDeclaredRef.value)
    -- #1425 site 2: the three tables above were just seeded WHOLESALE from graph-wide
    -- BARE-NAME accumulators, so every name this module declares is currently answered by
    -- whichever module's same-named binding the topological order happened to put first.
    -- Re-key those names — and only those — onto this module's own `(mid, name)` rows.
    -- Three writes, in lockstep, per B-2.2-f (#1113): the declared-prefix sidecar rides the
    -- IDS table, and this is a whole-table replacement of all three.
    let _ =
      setFunPredicateSlots
        mctx
        (selfDeclArities
          mid
          prog
          gctx.crossRun.crossModuleFunPredicateSlotsQualRef.value
          mctx.mcCells.funPredicateSlotsRef.value)
    let _ =
      setRef
        mctx.mcCells.funConstraintDeclaredRef
        (selfDeclArities
          mid
          prog
          gctx.crossRun.crossModuleFunConstraintDeclaredQualRef.value
          mctx.mcCells.funConstraintDeclaredRef.value)
    -- RUN-XMOD-062: ONE derivation, two projections.  The two refs are read together
    -- (`qualConstraintKey` assembles a `(definer, origin)` key out of both), so they
    -- must not be derived by two independent walks that could admit different rows.
    let admitted = importDefinersOf gctx prog
    mctx.mcCells.currentImportDefinersRef :=
      omFromPairs (reverseL (definerRowsOf admitted)) omEmpty
    mctx.mcCells.currentImportOriginsRef :=
      omFromPairs (reverseL (originRowsOf admitted)) omEmpty
    -- #1114 (#845): this module's imported SCHEME CONTEXTS, keyed by local spelling.
    -- `reverseL` before `omFromPairs` so the FIRST entry wins a duplicate key, matching
    -- the first-match policy of the sibling tables set just above
    -- (`omFromPairs` is last-write-wins; see its own note in support/ordmap.mdk).
    let _ =
      setRef
        mctx.mcCells.importedSchemeOblsRef
        (omFromPairs
          (reverseL
            (importedSchemeOblEntries
              prog
              gctx.crossRun.crossModuleSchemeOblsQualRef.value))
          omEmpty)
    ()
  -- #2563: install THIS module's method scope — its decls and ordinal, the inputs
  -- `methodScopeHere` answers from on first read of each spelling (stage K's
  -- `deMethods` is the whole graph; nothing is copied per module).

  let _ =
    mctx.mcCells.methodScopeCtxRef :=
      Some (prog, declEnvsOrdOf mid gctx.declEnvsRef.value)
    -- #1386: the alias-qualified spellings (`A.mth`) this module's imports supply.
    -- Built eagerly, here, because a key that names two declarations is reported
    -- (`T-AMBIGUOUS-ALIAS-METHOD`) whether or not the module ever spells it.
    mctx.mcCells.methodAliasEntriesRef :=
      aliasQualifiedMethodEntries mctx prog omEmpty
    -- #1386: the ORIGIN name behind each of those alias-qualified keys, from the
    -- same rows, in the same module scope, on the same line as the supply they
    -- accompany — `originMethodName`'s source.
    mctx.mcCells.aliasMethodOriginsRef := omFromPairs aliasSpellings omEmpty
  -- Module arm: copy the seven persistent DATA-universe accumulators (prior modules'
  -- public data + ctor env, each minted exactly once) into the `freshModuleCtx`-wiped
  -- working refs, then register ONLY this module's `prog0` as a transient FRONT
  -- overlay — O(|prog0|) per module, O(N) total. Ordering must stay [prog0,
  -- pub_{k-1}..pub_1] to preserve lookupAssoc (first-wins) / omInsert (last-write-wins)
  -- semantics.
  let dataEnv =
    -- A-3.2b (#1512): `mid` is BOUND here now — the overlay pool below is read at this
    -- module's own ordinal, so the arm can no longer discard it.
    -- A-3.2b residual (#1512): `envs`/`cur` are bound BEFORE the reload, not
    -- after, because the reload's alias half is now a projection of `envs` at
    -- `cur`.  Both bindings are pure reads of `GraphCtx`, so hoisting them
    -- above `loadDataUniverse` changes nothing else.
    let envs = gctx.declEnvsRef.value
    let cur = declEnvsOrdOf mid envs
    let _ = loadDataUniverse mctx cur
    -- #674: OVERLAY the ctors of the types THIS module imports so a bare ctor name
    -- resolves to the module the unit imports it from, not the universe's load-order
    -- winner.  Reads the persistent universe DECLS (not the Module `accData` field —
    -- that is dead `[]` on the elaborate/emit path, #154 PR-C), so the overlay fires
    -- on the run/build gate too, not just `check`.
    --
    --     universe  <  imported-ctor overlay  <  this module's OWN `prog0`.
    -- The overlay registers AFTER the universe (that is #674's requirement — it must
    -- win the `omInsert` tie-break over the load-order winner) and BEFORE `prog0`
    -- (this module's own declarations outrank anything it imports — ordinary
    -- shadowing, and the SHADOW spec's S1 per-module scoping).
    --
    -- one: an imported decl's constructors then beat locally-declared ones, so
    -- `import json.{Json, JNull}` + a local `data Tok = JString String` was rejected
    -- `Type mismatch: Json vs Tok` — clobbered by a SIBLING constructor of `Json`
    -- that the program never imported.  It reaches the stdlib and it is not narrow:
    -- every selective constructor-naming import carries it.  Pinned by
    -- `test/engine_fixtures/ctor_scope_local_ctor_beats_stdlib_import.mdk` (the
    -- stdlib `json` shape, on all three engines) and
    -- `test/llvm_fixtures_modules/ctor_scope_local_decl_wins/` (`{Ext, Other}` plus
    -- a local decl, prelude-free).
    --
    -- cause was exactly two of them disagreeing, and a FUTURE edit re-creates that by
    -- moving ONE.  This note used to name a PAIR ("both structures agree"), and the
    -- pair it named was the one that cannot disagree — while omitting the one that can.
    --
    -- Registration order here is  universe < overlay < prog0.  Under it:
    --   * the `TcEnv` ctor scheme map (`addCtor` → `omInsert`, BARE ctor name) —
    --     LAST-write-wins → prog0.  BARE-keyed, so two modules genuinely collide here;
    --     this is #1259's table and the one the overlay exists for.
    --   * `recordByNameRef` (`registerRecordInfoKeyed` → `omInsert`, BARE ctor name) —
    --     LAST-write-wins → prog0.  #1256's table, same keying, same hazard.
    --   * `dataParamKindsRef` (`recordParamKinds`, a consed list read FIRST-match) —
    --     IDENTITY-keyed since A-2.3 (`tyTabKey o name`), so two modules' same-named
    --     types get DIFFERENT keys and registration order cannot decide between them
    --     at all.  It is order-observable only for a decl registered twice, where it
    --     agrees.  It is NOT evidence about the bare-keyed tables above.
    --     (`checkModuleFullDiags`: `seedCheckRun (prog ++ importedCtorTypeDeclsFirstWins prog …
    --     ++ accData)`), from a LIST, with `oracleMap` = `omFromPairs (reverseL …)`,
    --     i.e. FIRST-wins on that list → prog0 > overlay > universe.  Same verdict,
    --     opposite mechanism, and reached through none of the code on this line.
    --     THIS is the one a future edit can silently flip, so check it too.
    -- All four land on prog0 > overlay > universe.  Getting any two to disagree is
    -- #674's root cause.
    -- #1111 A-2.11 (#1319 unit 1): a FIFTH layer, and it is a per-NAME overlay rather
    -- than a fifth registration — `applyCtorScopeOverrides` re-points the (normally
    -- empty) set of COLLIDED constructor names at the declaration THIS module's import
    -- scope selects.  It sits ABOVE prog0 and declines for any name prog0 declares, so
    -- the ladder above is unchanged: own > import scope > import overlay > universe.
    -- A collision-free program returns this very env unchanged and unallocated.
    -- #1111 A-2.12 (#1319 unit 2): the two RECORD-table overlays are the same fifth
    -- layer one namespace-half over, and they must run HERE — after `registerAllData …
    -- prog0` has written the floor into `recordByNameRef` / `fieldOwnersRef` — for the
    -- same reason `applyCtorScopeOverrides` wraps that call.  They are statements rather
    -- than an env transform only because those two tables are per-run REFS, not `TcEnv`
    -- fields; the ladder they implement is identical.  See applyRecordScopeOverrides.
    -- `CrossRun.universeDataDecls` — a positional `List Decl` accumulated by
    -- `appendDataUniverse`, carrying no key at all — is RETIRED; the pool is the
    -- whole-graph envelope read at THIS module's ordinal through
    -- `declEnvRowVisible`/`declEnvVisibleTo`.
    --
    -- `buildDeclEnvs` indexed the row under, threaded here by the driver
    -- (`elabModuleStamp mid` on the emit path; `cmCheckWorker mid` since #1508).  It
    -- is NOT re-derived from import syntax, which is why the emit path's
    -- `private_mangle` rewriting cannot break it: mangling renames top-level
    -- bindings, never a loader module id, and the decls in the pool are the very
    -- objects the accumulator held before.  (Re-deriving a read key by re-walking
    -- `DUse` syntax is what made #1425's four-site change resolve on eval and MISS on
    -- emit — `DUse` decls are never mangled.  This key does not go through that
    -- channel.)
    -- #1112 A-3.2b (#1512) slices 2+3: the KIND and FIELD-OWNER halves of the seed
    -- `loadDataUniverse` used to copy out of two `GraphCtx.crossRun` accumulators.  Same
    -- position in the ladder (it is the UNIVERSE layer, under the overlay and under
    -- `prog0`), same content, one ordinal-aware source.  See `declEnvSeedChain` for
    -- why the reader's OWN row is excluded here and registered by the two
    -- `registerAllData` calls below instead.
    let _ = declEnvSeedDataUniverse mctx mid envs
    -- `omInsert` tables, so the LAST row wins, and the overlay's named-outranks-wildcard
    -- rule therefore needs the `UseGroup` rows LAST.  The oracle call site takes the
    -- opposite order for the opposite reason — see the partition note at
    -- `importedCtorTypeDeclsFirstWins`.  Swapping these two inverts the rule silently.
    let base =
      registerImportOverlay
        (withCtors mctx (spFloor gctx.crossRun.universeCtorPop.value))
        prog0
        (importedCtorTypeDeclsLastWins prog0 cur envs.deModules)
    let env0 = registerAllData base prog0
    let _ = applyRecordScopeOverrides mctx prog0
    applyCtorScopeOverrides prog0 env0
  let _ = recordInvocationView dataEnv
  -- #784: reject under-determined return-only effect vars on interface methods.
  -- MUST run AFTER `dataEnv` above populated `dataParamKindsRef` — the kind-aware
  -- predicate (rowArgNames) reads that table to distinguish a row-kinded ctor arg
  -- (`Async e a`, pins the effect) from a type-kinded one (`List e`, does not).
  let _ = checkUndeterminedRetEffVars mctx prog
  -- EFFECTS-SEMANTICS §6.4/§6.5: declared-kind consistency.  Same placement — the
  -- slot-kind reads consult the table `dataEnv` just populated.
  let _ = checkDeclaredKinds mctx prog
  -- One authority, one domain, for a declaration's `Authority` parameters.
  -- Same placement: an index slot's domain is read from that table.
  let _ = checkDeclAuthorityUses mctx prog
  -- #822: instance-head kind check for graded interfaces.  Same placement rationale
  -- as the line above for the HEAD-constructor half, which still reads
  -- `dataParamKindsRef` that `dataEnv` above has just populated.
  -- #1557 A-3.5c: the INTERFACE-slot half no longer reads a per-run table at all —
  -- it reads stage K's `CE` at this module's ordinal, mirroring `moduleImplUniv`'s
  -- arm-gated shape exactly. Standalone-list helpers build a single-module `CE` from
  -- `prog`, the very list `registerAllData (envFor mctx) prog` walked to fill the
  -- retired table, so the check does not go silent on a no-import `medaka check`.
  -- #1557 A-3.5a: this pair is now BOUND ONCE and read by TWO consumers — the graded
  -- impl-head check here and impl-completeness at the end of the body — hence the
  -- neutral name.  Binding once is not a style choice: `flatClassEnvOf` folds the whole
  -- decl list into a registry, so a second construction at the completeness site would
  -- pay that fold twice per flat compile, and the two copies could drift.  On Flat
  -- `fullUniverse = prog` (see its binding above), so `flatClassEnvOf prog` IS the
  -- `flatClassEnvOf fullUniverse` the completeness relocation calls for.
  let classEnvHere =
    let envs = gctx.declEnvsRef.value
    (envs.deIfaces, declEnvsOrdOf mid envs)
  let _ = checkGradedImplHeads mctx (fst classEnvHere) (snd classEnvHere) prog
  let _ = rejectCyclicAliases mctx prog
  -- #1280: `prog` reached here through a driver's stamping walk already, and
  -- `stampTyHead` is first-write-immune, so the builtins-only scope can only fill
  -- a head no driver could attribute — an `extern` written in a FLAT user file,
  -- where there is no module id and the primitive heads are all that is knowable.
  -- #2072: `userExternSchemes`, not `externSchemes` — this is the extern
  -- DECLARATION site (the program under check).  It builds the declared type
  -- verbatim; the two guards below are what hold a user extern to its row.
  let currentMethodRows = ifaceMethodSchemeRows mctx prog
  let _ = recordMethodGrants gctx currentMethodRows
  let visibleMethodRows = ifaceMethodSchemeRows mctx implDecls
  let visibleMethodRowIndex =
    methodRowsByIdentity
      (isNonEmptyL importerShadows)
      visibleMethodRows
      regEmpty
  let externS = userExternSchemes mctx (externTyOriginScope []) prog
  let globalS = legacyMethodSchemes currentMethodRows ++ externS
  -- #2074 / F1 (epic #2070): the USER-EXTERN DECLARATION guards, all gated on
  -- the same `ffiStampMode` ownership Bool — a stdlib-owned program's externs ARE
  -- the vocabulary and none of these rules owns them.  They run AFTER
  -- `rejectCyclicAliases` (`tc_decls`) so `expandAliasHeadTy` cannot recurse forever on a
  -- cyclic alias.  Order between them is not significant: diagnostics
  -- accumulate ([T-ERRORS-ACCUM]) and a signature can honestly fail more than one.
  --
  -- Four sibling loops rather than four arms inside one walk: each has its own
  -- exemption discipline (the crossable rule exempts a catalog-name
  -- redeclaration, the label and binding rules hold one to its `bind` clauses
  -- only, the shadow rule IS that exemption's admission test, and the
  -- catalog-row rule fires ONLY on a catalog name), and folding them together
  -- would force one `if` to speak for four notions of "this declaration is not
  -- mine".
  let _ = ffiCheckExternsCrossable mctx (ffiStampMode gctx mid) prog
  let _ = ffiCheckExternsLabelled mctx (ffiStampMode gctx mid) prog
  let _ = ffiCheckExternsShadow mctx (ffiStampMode gctx mid) prog
  let _ = ffiCheckExternsCatalogRow mctx (ffiStampMode gctx mid) prog
  -- (#4 cont) post-globalS mode setup.  Module: shadowMethodSchemes env layer (rebinding
  -- imported method names to the interface-method scheme) + the method-constraint cross
  -- seed (AFTER globalS's row registration, per installMethodPredicateSlots).
  let envSeed = extendVars dataEnv seed
  let shadowLayer =
    -- The rows remain local: they carry live scheme cells needed only by setup and
    -- must not become another graph-lived authority.
    let ifaceSchemes = legacyMethodSchemes visibleMethodRows
    -- #259/#2157: seed both halves from the same already-minted row selection.
    let _ = seedNumLitFromIntAnchor mctx visibleMethodRows
    -- #1351 L2 MIGRATE.  The importer-shadow layer now binds each shadowed method
    -- name to the scheme of the declaration THIS module's import scope admits
    -- (`methodScopeAt`), not to `lookupAssoc`'s decl-walk first match.
    -- Falls back to the bare-name answer on a miss — see `pickSchemesByDecl`.
    let sm =
      pickSchemesByDecl
        mctx
        importerShadows
        ifaceSchemes
        visibleMethodRowIndex
        moduleSeed.msImportedValues
    mctx.mcCells.methodPredicateSlotsRef :=
      mctx.mcCells.methodPredicateSlotsRef.value
        ++ gctx.crossRun.crossModuleMethodPredicateSlotsRef.value
    attachStandaloneSources moduleSeed.msImportedValues sm
  let envImported =
    annotateImportedMethodRows
      envSeed
      (importedMethodBindingNames gctx prog0 aliasSpellings)
      (nameableIfaceMethodSet gctx prog0)
      (namesToSet importerShadows omEmpty)
      visibleMethodRowIndex
  let envGlobal =
    extendVars (extendMethodRows envImported currentMethodRows) externS
  let env1 = extendBindings envGlobal shadowLayer
  let defs = funDefs progS
  let (topSchemes, groupedOut) =
    processTopGroups
      env1
      sigs
      defs
      (groupNames defs omEmpty)
      (namesToSet (publicValNames prog) omEmpty)
  let _ = recordTopBinderTypes gctx (omFromPairs topSchemes omEmpty) progS
  -- The tail bodies (impl, default, prop and test bodies) see the top-level
  -- bindings as the binding groups do (`processTopGroups`' result env): each
  -- binding keeps its standalone descriptor, so an occurrence of a top-level value
  -- spelled like a method resolves to the value in a tail body too.  Marking and
  -- inference read this one env.
  let tailEnv = extendTermBindings env1 topSchemes
  -- Module: the marked tree this call returns (the groups' marked clauses written
  -- back, the tail bodies marked with the module's final dict-name set) and its
  -- stamped twin, which the tail-body inference below reads.  Flat: `progS` is both.
  let progOut = match mctx.mcCells.markingRef.value
    Some mm => finishModuleMarking mm tailEnv groupedOut progS
    None => progS
  let progT = match mctx.mcCells.markingRef.value
    Some mm => stampTailDecls mm.mmTop progOut
    None => progS
  -- The module path runs a single inference pass; core is checked as its own
  -- invocation, which isolates the prelude's method bodies from a user binding
  -- that shadows an interface method (List Int vs Int).

  -- Unified impl-body inference form (Module arm, both drivers): inferUserImplBodies
  -- infers parametric heads and preserves diagnostics. allProg = implDecls
  -- (interfaces + accumulated impls) grounds the field types. See
  -- compiler/TYPECHECK-TARGET-ARCHITECTURE.md § "SA-10a. Landing log" (#2546, ARCH Q3a).

  let _ =
    let _ =
      inferUserImplBodies
        tailEnv
        implDecls
        (fst classEnvHere)
        (snd classEnvHere)
        progT
    let _ = inferDefaultBodiesIfEnabled tailEnv progT
    let _ = inferPropBodies tailEnv progT
    let _ = inferTestBodies tailEnv progT
    ()
  -- (#3) cross-module dict-threading SNAPSHOT — MODULE ONLY (flat SKIPS: running it would
  -- pollute the cross-module accumulators with a phantom single-file attribution).
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op

  let _ =
    let _ = dedupPredicateSlotsTable mctx ()
    -- #1425: restore the rows the per-module view masked (see `selfNameRows`) — the view
    -- must not propagate as a graph-wide deletion into the next module's seed.
    let _ =
      setRef
        gctx.crossRun.crossModuleFunPredicateSlotsRef
        (predicateSlotTableWithoutArgs
          (mctx.mcCells.funPredicateSlotsRef.value
            ++ selfNameRows
              prog
              gctx.crossRun.crossModuleFunPredicateSlotsRef.value))
    let _ =
      setRef
        gctx.crossRun.crossModuleFunPredicateSlotsQualRef
        (attributeModuleEntries mid prog mctx.mcCells.funPredicateSlotsRef.value
          ++ gctx.crossRun.crossModuleFunPredicateSlotsQualRef.value)
    -- B-2.2-f (#1113): the sidecar's two snapshots, paired with the ids snapshots above.
    let _ =
      setRef
        gctx.crossRun.crossModuleFunConstraintDeclaredRef
        (mctx.mcCells.funConstraintDeclaredRef.value
          ++ selfNameRows
            prog
            gctx.crossRun.crossModuleFunConstraintDeclaredRef.value)
    let _ =
      setRef
        gctx.crossRun.crossModuleFunConstraintDeclaredQualRef
        (attributeModuleEntries
            mid
            prog
            mctx.mcCells.funConstraintDeclaredRef.value
          ++ gctx.crossRun.crossModuleFunConstraintDeclaredQualRef.value)
    gctx.crossRun.crossModuleMethodPredicateSlotsRef :=
      mctx.mcCells.methodPredicateSlotsRef.value
    let _ =
      setRef
        gctx.crossRun.crossModuleMethodPredicateSlotsQualRef
        (emptyMethodModulePredicateSlots mid prog
          ++ attributeMethodModulePredicateSlots
            mid
            prog
            mctx.mcCells.methodPredicateSlotsRef.value
          ++ gctx.crossRun.crossModuleMethodPredicateSlotsQualRef.value)
    -- #1114 (#845, DICT-SEMANTICS §4.2 D6(a)): snapshot THIS module's scheme contexts
    -- alongside the three arity tables above.  The arity tables carry only what
    -- `funConstraintsRef` holds, whose INFERRED half is gated on `dictEligibleSetRef`
    -- and is therefore EMPTY on the check path (see that ref's comment) — so an
    -- UNSIGNATURED constrained export was invisible to every importer at check time
    -- while `run`/`build` threaded its dict anyway.  `schemeObligationsRef` is the
    -- always-on store of the same fact and is what the SAME-module use site already
    -- reads; this makes the cross-module use site read it too, under the same
    -- source-exact (mid, name) key.
    let _ =
      setRef
        gctx.crossRun.crossModuleSchemeOblsQualRef
        (attributeModuleSchemeObls
            mid
            prog
            gctx.crossRun.crossModuleSchemeOblsQualRef.value
            mctx.mcCells.schemeObligationsRef.value
          ++ gctx.crossRun.crossModuleSchemeOblsQualRef.value)
    ()
  -- P0-17: impl missing a required method.  #1557 A-3.5a: ONE call, both modes — the
  -- arm split is gone because `classEnvHere` above already carries the mode's `CE` and
  -- its reading ordinal (Flat: a single-module `CE` over `prog`, which IS `fullUniverse`
  -- on that arm, at ordinal 0; Module: stage K's whole-graph `deIfaces` at this module's
  -- ordinal).  🚨 It must NOT read `declEnvsRef` unconditionally: that envelope is
  -- `emptyDeclEnvs` in compatibility helpers, so reading it there would make `ceRequiredAt` miss on
  -- every interface, and the miss arm is `[]` — every live rejection here would become a
  -- silent accept.  `classEnvHere`'s `Flat _` arm is what prevents that.
  let _ =
    checkImplCompletenessMap mctx (fst classEnvHere) (snd classEnvHere) prog
  -- (#5 / BREAK #2) obligation channels.  FLAT runs both channels + setNumlitFloats
  -- here so the per-module pass can
  -- stamp the Float-typed int literals, and a Flat consumer that read them unstamped
  -- would get Int cells where the inference said Float.  MODULE runs both channels
  -- here and leaves the Float stamp to the graph-end drain (`SSNumlitFloats`), on
  -- every driver (#2705).

  -- #1112 A-3.4 PR2: the obligation universe is now the `IE` projection bound ONCE
  -- as `moduleImplUniv` far above (see its block for the flip, the measurement, and
  -- why re-deriving it here would be a second whole-prefix rebuild for a value that
  -- cannot have changed).  The three `obUniv*` accumulators this used to read are
  -- deleted from `CrossRun`.

  let _ =
    let obUniv = moduleImplUniv
    -- #838 I4: unified checker, same `obUniv`.  Impl channel = (deferNonGround=True);
    -- call channel = (deferNonGround=False).
    -- #2705: BOTH channels run on EVERY driver.  A driver that infers impl
    -- bodies without checking their obligations lets a program `check` rejects
    -- reach codegen through `build`'s own elaboration.  `setNumlitFloats` is not called
    -- here on any driver any more: the Float literal stamp is `SSNumlitFloats`,
    -- first step of the graph-end drain every Module-arm driver now runs.
    let _ = recordLiveRoots mctx ()
    let _ = judgeQuiescentGoals mctx ()
    let _ = refileDeterminedRows mctx ()
    let _ =
      checkCallObligationsU mctx True obUniv mctx.mcCells.implObls.items.value
    let _ =
      checkCallObligationsU mctx False obUniv mctx.mcCells.obls.items.value
    let _ = settleDeferredPatLits mctx ()
    let _ =
      checkDeferredMatches
        mctx
        (reverseL mctx.mcCells.matchChecksDeferred.value)
    let _ = checkFixedWidthLiterals mctx mctx.mcCells.numlitRanges.value
    let _ = checkWideLiterals mctx mctx.mcCells.wideLitRanges.value
    ()
  mctx.mcCells.localSchemesOut :=
    mapLocalSchemes mctx mctx.mcCells.localBindRefs.value
  mctx.mcCells.seedSchemesOut := seed
  -- #154 PR-A: grow the persistent DATA-universe by THIS module's PUBLIC data, AFTER the
  -- module's inference is complete (so the copy+overlay above saw pub 1..k-1 and NEVER this
  -- module's own pub twice) — the register-time mirror of foldModules' `accData ++
  -- publicDataDecls prog` threading.  appendDataUniverse clobbers the working table refs,
  -- which are DEAD here (the next module's `freshModuleCtx` wipes them).  Flat leaves it untouched.
  let _ =
    -- A-3.2b residual (#1512): `mid` is BOUND here now — `appendDataUniverse`'s
    -- reload reads the alias universe at this module's own ordinal.
    appendDataUniverse mctx mid prog0
  let result = (
    ModuleBindings {
      mbSchemes = globalS ++ topSchemes,
      mbStandaloneSchemes = omFromPairs (reverseL topSchemes) omEmpty,
    },
    progOut,
    mctx,
  )
  let _ = closeScope mctx ()
  result
-- D2: check top-level `let rec` bindings for non-function members before
-- type-checking the DFunDef groups (the LetRecNonFunction guard,
-- which fires for
-- is_letrec=true groups — i.e. those coming from DLetGroup).

-- Phase 83/84 single-level: AFTER top-level inference (so the scheme output is
-- unchanged), and ONLY on the elaborate/dict path, infer each parametric impl's
-- return-position method bodies, registering the requires' element dict so the
-- inner ref routes RDict and the call site routes RKey + impl dicts.

-- Phase 69.x-e: likewise infer each interface DEFAULT body that carries a
-- method-level constraint (foldMap's default), registering the constraint var so
-- the in-body return-position ref (`empty`) routes RDict to `$dict_<method>_<slot>`.

-- Phase 4.55: type-check each prop body with
-- its declared params in scope.  This is what RESOLVES the EDictAt/EMethodAt route
-- refs the prepass marked inside a prop body — without it the routes stay empty,
-- and on the dict-passed eval path (DRIVER-COLLAPSE Phase 2 promotes the file's own
-- `=>`-constrained fns) the prop body would call a now-dict-passed `wf`/`fromList`
-- with no dict argument → under-application → `force` a partial closure → not VBool
-- → every prop "fails" (set's `fromList []` reported ill-formed).  The compiler
-- typechecker previously skipped props entirely (funDefs ignores DProp), so this
-- gap was latent until Phase 2's promotion exposed it.

-- Shape A (gap #44): ground a container literal's free result-element var THROUGH
-- the impl's method type, BEFORE the resolve* passes read the cells.

-- Error-path B4: now every method occurrence's dispatch type is fully resolved;
-- reject any whose concrete head type has no matching impl (the
-- `No impl of … for …` check).

-- Phase 4.55: infer each prop body with its declared params in scope, so the
-- prepass-marked EDictAt/EMethodAt route refs inside resolve.
-- Runs unconditionally (props are eval-only; the
-- emit/golden paths have no props): infer prop_body; unify t_bool.
-- A prop body is eval-only and is NOT dict-passed for operator dispatch: like the
-- OCaml oracle (which evals raw prop bodies against the marked env), its comparison
-- operators must stay PRIMITIVE EBinOps the eval builtin handles structurally, not
-- get stamped and rewritten to eq/lt method apps (whose dict route would then be
-- applied to a non-dict-passed comparison, panic: applied non-function).  So
-- bracket the goal channel around prop inference (`dropGoalsSince`): the routes
-- the prop body NEEDS (EDictAt for the file's promoted constrained fns, via the
-- dictionary-application and return-site goals) are still collected; only the
-- operator-rewrite goals the prop body would otherwise contribute are dropped.
inferPropBodies : TcEnv -> List Decl -> Unit
inferPropBodies env prog =
  let mark = goalsMark env.teDyn.dcModule.mcGraph ()
  let _ = inferPropBodiesGo env prog
  dropGoalsSince env.teDyn.dcModule.mcGraph mark [
    GKBinopSite, GKUnopSite, GKArithSite
  ]

inferPropBodiesGo : TcEnv -> List Decl -> Unit
inferPropBodiesGo env [] = ()
inferPropBodiesGo outer ((DProp _ name params body) :: rest) =
  -- The body's checks are located at the body (the declaration has no span),
  -- and its type at the value it returns.
  let env = envAtIfSome (exprSpanLoc body) outer
  let local = extendPropParams env params
  let _ = enterLevel env.teDyn.dcModule ()
  let parentScope = captureScope env.teDyn.dcModule ()
  let bodyScope =
    Scopes.freshScope
      (currentScopeStore env.teDyn.dcModule.mcGraph ())
      (Some parentScope)
      env.teDyn.dcModule.mcCells.currentLevel.value
      (Scopes.scopeFrame
        (currentScopeStore env.teDyn.dcModule.mcGraph ())
        parentScope).sfModuleId
      (PropOwner name)
  let _ = openScope env.teDyn.dcModule bodyScope
  let oblMark = wMark env.teDyn.dcModule.mcCells.implObls
  let callMark = wMark env.teDyn.dcModule.mcCells.obls
  let dictMark = goalsMark env.teDyn.dcModule.mcGraph ()
  let _ =
    unifyIn
      (dynAtIfSome (valueSpanLoc body) env.teDyn)
      (infer local body)
      (tconBuiltin "Bool")
  let _ = exitLevel env.teDyn.dcModule ()
  let _ =
    settleClosedBody
      env.teDyn.dcModule
      (tconBuiltin "Bool")
      oblMark
      callMark
      dictMark
  let _ = closeScope env.teDyn.dcModule ()
  inferPropBodiesGo outer rest
inferPropBodiesGo env (_ :: rest) = inferPropBodiesGo env rest

-- Phase 127 (restored 2026-07-11): typecheck each `test "…" = body` body,
-- requiring it to have type `Expectation` (a nullary TCon, so a plain nominal
-- unify).  Unlike props, test bodies ARE dict-passed (their `expectEqual`/… calls
-- come from `import test`), so this runs on the normal inference path with binop
-- stamping enabled (no snapshot/restore).  Without this, `test "x" = 1 + "str"`
-- and `test "x" = 42` slipped through `check` with zero diagnostics.
inferTestBodies : TcEnv -> List Decl -> Unit
inferTestBodies env [] = ()
inferTestBodies outer ((DTest _ name body) :: rest) =
  -- The body's checks are located at the body (the declaration has no span),
  -- and its type at the value it returns.
  let env = envAtIfSome (exprSpanLoc body) outer
  let _ = enterLevel env.teDyn.dcModule ()
  let parentScope = captureScope env.teDyn.dcModule ()
  let bodyScope =
    Scopes.freshScope
      (currentScopeStore env.teDyn.dcModule.mcGraph ())
      (Some parentScope)
      env.teDyn.dcModule.mcCells.currentLevel.value
      (Scopes.scopeFrame
        (currentScopeStore env.teDyn.dcModule.mcGraph ())
        parentScope).sfModuleId
      (TestOwner name)
  let _ = openScope env.teDyn.dcModule bodyScope
  let oblMark = wMark env.teDyn.dcModule.mcCells.implObls
  let callMark = wMark env.teDyn.dcModule.mcCells.obls
  let dictMark = goalsMark env.teDyn.dcModule.mcGraph ()
  -- #1110: `Expectation` is declared by `stdlib/test.mdk`, a USER-SPACE module —
  -- the checker fabricates this head from a literal and has no decl in view, so
  -- there is no identity to acquire.  `tconUnresolved`, not `tconBuiltin`: the
  -- language does not provide `Expectation`, and claiming §8 I6.2's
  -- program-global identity for a type some module declares would be a lie the
  -- shared carrier type cannot object to.
  let _ =
    unifyIn
      (dynAtIfSome (valueSpanLoc body) env.teDyn)
      (infer env body)
      (tconUnresolved "Expectation")
  let _ = exitLevel env.teDyn.dcModule ()
  let _ =
    settleClosedBody
      env.teDyn.dcModule
      (tconUnresolved "Expectation")
      oblMark
      callMark
      dictMark
  let _ = closeScope env.teDyn.dcModule ()
  inferTestBodies outer rest
inferTestBodies env (_ :: rest) = inferTestBodies env rest

-- A test or property body is a numeric boundary that publishes no polymorphic
-- result: nothing after it can determine its variables.  A variable below the
-- body's level (a property parameter, a value-restricted outer binding) belongs
-- to its enclosing binder and is held rigid, judged where it lives.  The body runs
-- the method-body settle sequence with an empty surviving set, then the verdict,
-- so a goal the body leaves open is judged here as a top-level binding's is.
-- [bodyTy] is the closed type the body was unified with.
settleClosedBody : ModuleCtx -> Mono -> Int -> Int -> Int -> Unit
settleClosedBody mctx bodyTy oblMark callMark dictMark =
  let level = mctx.mcCells.currentLevel.value + 1
  let addedObls = wWindow mctx.mcCells.implObls oblMark
  let bodyObls = addedObls ++ callUOblsWindow mctx callMark
  let rigidIds =
    outerRigidIds
      (Some level)
      (flatMap (uOblArgs mctx.mcGraph) bodyObls)
      omEmpty
  let _ = improveByUniqueImpl (dynFor mctx) rigidIds bodyObls
  let _ = determineByUniqueInstance mctx rigidIds bodyObls
  let withheld = finalizeNumBoundary (dynFor mctx) NumBoundary {
    nbDisposition = NumBoundaryOwnedMethodBody level,
    nbMembers = [bodyTy],
    nbSurvivingIds = omEmpty,
    nbDefaultObls = addedObls ++ calleeNumObls mctx callMark dictMark,
    nbAmbiguityObls = addedObls,
    nbGuard = NumGuard {
      ngGoals = bodyObls,
      ngRigidIds = rigidIds,
      ngOuterBelow = Some level,
    },
  }
  let _ = improveByUniqueImpl (dynFor mctx) rigidIds bodyObls
  let _ = determineByUniqueInstance mctx rigidIds bodyObls
  let _ =
    rejectUndeterminedVectors
      mctx
      rigidIds
      omEmpty
      addedObls
      (callUOblsWindow mctx callMark
        ++ nestedRequireGoals mctx rigidIds omEmpty bodyObls)
  rejectWithheldAmbiguity mctx rigidIds withheld bodyObls

-- bind each prop param `x : ty` as a monomorphic scheme in the env (fresh tyvars
-- for any free type variable in ty; props are normally concrete, e.g. `List Int`).
extendPropParams : TcEnv -> List PropParam -> TcEnv
extendPropParams env [] = env
extendPropParams env ((PropParam x _ ty) :: rest) =
  let scheme =
    monoScheme
      (fromAstType
        env.teDyn.dcModule
        (freshTvMap env.teDyn.dcModule (dedup (tyVarNames ty)))
        ty)
  extendPropParams (extendLocalVar env x scheme) rest

-- #760 (S1, check-vs-emit soundness): infer the USER program's impl-method bodies on
-- EVERY path, and check their obligations on every path (#2705).  A path that
-- inferred an impl body without checking its obligations, or checked without
-- inferring, lets a `deriving (Eq)`/`(Debug)` (or a hand-written impl) over a field
-- whose type lacks that instance `check` clean and `build` panic ("no impl of method
-- 'eq' for type 'Inner'").  Inferring the body records the field's `Eq Inner`
-- obligation via recordImplObligation, which the impl channel then rejects with the
-- SAME diagnostic a direct `==` already emits.
--
-- SCOPED TO THE USER decls (`prog0`), NOT the prelude (`coreProg`): re-inferring CORE's
-- own parametric impl bodies on the check path is heavier and pointless — core is
-- known-good (it builds + self-compiles), so only user impls need check-path inference.
--
-- SCOPED TO GROUND-HEADED impls (no type variable in the impl head).  A ground impl —
-- `impl Eq Outer`, the derived instance for a non-parametric type — only ever calls
-- methods on its fields' CONCRETE types, so every obligation it records is concrete:
-- checkImplObligations/checkCallObligations either finds the impl or emits the genuine
-- `No impl of Eq for Inner`.  A PARAMETRIC impl (`impl Eq (List a) requires Eq a`) instead
-- records obligations on its abstract element tyvar; those never ground on the check path
-- and would reach checkUndeterminedObligations, which reports a spurious `Ambiguous instance`
-- for any iface with >= 2 impls (it fired on EVERY program the moment core's own parametric
-- impls were inferred standalone — the prelude snapshot).  The emit path never exercised
-- that because it SKIPS the obligation gate.  Inferring only ground impls records the
-- concrete missing-instance rejects (the whole point of #760) while structurally avoiding
-- the abstract-element ambiguity.  A parametric impl over a concrete field (a rarer nesting)
-- stays deferred to `build` exactly as it was before #760 — a residual, not a regression.
--
-- DIAGNOSTICS PUSHED *DURING* body inference: #760 originally DROPPED all of them (snapshot +
-- restore typeErrors / typeErrorsSticky), because it only wanted the missing-INSTANCE rejects,
-- which are recorded as pendingImpl/CallObligations (side effects) that
-- checkImplObligations/checkCallObligations gate LATER — AFTER this returns — so dropping the
-- error accumulators did not lose a single missing-instance reject.  #777 (type mismatch) and
-- #782 (effect leak) then established that the type/effect errors the body inference itself
-- raises (e.g. an EFFECT LEAK: `putStr` in a pure-typed method body, or a body type mismatch)
-- are genuine soundness bugs that must reject symmetrically with top-level functions — so those
-- are now KEPT — and since issue 1146 they are kept because NOTHING REMOVES THEM: the
-- window that used to rebuild this list is retired (see the retirement note at the end
-- of inferUserImplBodies below).  Per-axis history follows.
-- #777 (S0, silent wrongness): a GENUINE type mismatch inside a ground impl-method
-- body (`sig _ = idInt "str"` where `idInt : Int -> Int` but `sig`'s declared return
-- is `String`) is a `unify`/`typeMismatch` error pushed DURING body inference, not an
-- obligation.  Blanket-restoring `typeErrors` here (as this did before #777) discarded
-- it, and because every driver that decides a build reaches this same body inference —
-- `check`'s directly, `build`'s through the `medaka_emitter` child's `elaborateModules` —
-- discarding it here makes `check` and `build` accept the program together: the built binary
-- then printed a wrong value at exit 0 or SEGFAULTED (an impl method returning a
-- differently-typed field/value).  We now KEEP those body clash errors so both paths
-- reject.
-- #782 (S2, ratified 2026-07-20): the effect axis is now enforced HERE too, symmetric
-- with top-level functions.  An effect leak in an impl-method body (`putStr` in a body
-- whose method signature declares no effect row) is a `T-EFFECT-LEAK`/`T-EFFECT-PARAM`
-- pushed DURING body inference, exactly like a body type mismatch.  Previously these two
-- codes were SUPPRESSED here (isSuppressedImplBodyErr) to spare the intentionally-effectful
-- `impl Speak Dog` in test/engine_fixtures/nullary_memo_with_args — but that made the
-- effect discipline the spec commits to (EFFECTS-SEMANTICS §method: an impl's latent row is
-- bounded by the signature) hold for top-level functions yet silently NOT for impl bodies.
-- The ratified fix is to STOP suppressing: the fixture's method now declares its concrete
-- `<Stdout>` row (`speak : a -> <Stdout> String`), so its body is bounded-by-signature and
-- stays valid, while a pure-signatured method that leaks an effect is now a real error.
-- Missing-instance rejects are unaffected regardless: they are recorded as
-- pendingImpl/CallObligations (side channel) and gated LATER, so they were never in this
-- window.

inferUserImplBodies : TcEnv -> List Decl -> ClassEnv -> Int -> List Decl -> Unit
inferUserImplBodies env allProg ce cur decls =
  let rpNames = returnPosMethodNames allProg
  -- GROUND heads (#760/#777): infer their bodies and KEEP the obligations they record
  -- — a ground impl only calls methods on CONCRETE field types, so every obligation is
  -- concrete and checkImplObligations either finds the impl or emits a genuine
  -- `No impl of <iface> for <field>` reject.
  let impls = locatedImpls None decls
  let _ =
    inferImplBodies
      env
      rpNames
      ce
      cur
      (filterList (i => implHeadGround (snd i)) impls)
  -- PARAMETRIC heads (#781, S0): a parametric impl head (`impl Sig (List a)`) is never
  -- reached by the ground filter, so a genuine non-literal type mismatch inside its
  -- method body (`sig _ = idInt "str"`, `idInt : Int -> Int` in a String-returning
  -- method) went unenforced end-to-end — `check`/`build` exit 0 and the built binary
  -- printed a wrong value.  Infer these bodies too so the `unify`/`typeMismatch` clash
  -- is surfaced (it is pushed to `typeErrors`, and kept because nothing removes it —
  -- see the retirement note at the end of this function), mirroring the
  -- ground-head fix.  BUT a parametric impl also records obligations on its ABSTRACT
  -- element tyvar (`impl Eq (List a) requires Eq a` → an `Eq a` obligation over an
  -- unground var); those never ground on the check path and would reach
  -- checkUndeterminedObligations as a SPURIOUS `Ambiguous instance` for any iface with
  -- >= 2 impls (it fired on every program the moment core's own parametric impls were
  -- inferred — the prelude snapshot).  So WINDOW the obligation channel across this
  -- pass and restore it afterward: the body-clash errors go through `typeErrors`, NOT
  -- the obligation channel, so windowing keeps the #781 reject while dropping the
  -- abstract-var false positives.
  --
  -- 🚨 #1114 (#792): THE ROLLBACK IS GROUND-PRESERVING, and it did not used to be.
  -- The two `wRestore`s below used to run bare, which threw away EVERY obligation the
  -- parametric pass recorded — including the GROUND ones, which are exactly the ones
  -- the abstract-var argument above does not cover.  `impl Foo (List a)` whose body
  -- calls `debug Bar` records a fully-ground `Debug Bar`; nothing about it is abstract,
  -- the gate would have rejected it on the spot, and the blanket rollback deleted it —
  -- so `check` exited 0 while `build` PANICKED (`no impl of method 'debug' for type
  -- 'Bar'`).  That is a `run_check_agreement` break, and the sentence this comment
  -- replaced ("stays deferred to `build` exactly as before — a residual, not a
  -- regression") named it as a known residual without naming its cost.
  --
  -- The policy is now written down: DICT-SEMANTICS §4.2 **D1** (a predicate the gate can
  -- decide where it is recorded is discharged there — no window may discard it) and
  -- **D6(b)** (a window that exists to suppress D3 false positives must filter by what is
  -- DECIDABLE, not discard wholesale).  So: window as before, then re-push exactly the
  -- obligations `uOblIsDecidableNow` accepts.  The abstract element tyvar of a parametric
  -- head is decidable by nothing, so every false positive the window was built to stop is
  -- still stopped.
  --
  -- ⚠️ The predicate is "the GATE can decide it now", NOT "it is ground" — those differ,
  -- and this site is where believing otherwise costs a verdict.  `uOblIsDecidableNow`
  -- carries the derivation and the counterexample (`Debug (Int -> Int)`); read it before
  -- touching either side.
  -- Re-pushed in `reverseL` order because `wWindow` yields newest-first (items are
  -- consed): reversing restores the original record order, which the gate reports in.
  let implOblsSnap = wSnapshot env.teDyn.dcModule.mcCells.implObls
  let callSnap = wSnapshot env.teDyn.dcModule.mcCells.obls
  let _ =
    inferImplBodies
      env
      rpNames
      ce
      cur
      (filterList (i => implHeadParametric (snd i)) impls)
  let keptImpl =
    filterList
      (uOblIsDecidableNow env.teDyn.dcModule.mcGraph)
      (wWindow env.teDyn.dcModule.mcCells.implObls (snd implOblsSnap))
  let keptCall =
    filterList
      (uOblIsDecidableNow env.teDyn.dcModule.mcGraph)
      (wWindow env.teDyn.dcModule.mcCells.obls (snd callSnap))
  let _ = wRestore env.teDyn.dcModule.mcCells.implObls implOblsSnap
  let _ = wRestore env.teDyn.dcModule.mcCells.obls callSnap
  let _ = wPushAll env.teDyn.dcModule.mcCells.implObls (reverseL keptImpl)
  let _ = wPushAll env.teDyn.dcModule.mcCells.obls (reverseL keptCall)
  ()

-- True for a DImpl whose head types carry NO type variable (a monomorphic receiver like
-- `Eq Outer` / `Debug (List Int)`); False for a parametric head (`Eq (List a)`) and every
-- non-impl decl (which contributes no impl body regardless).
implHeadGround : Decl -> Bool
implHeadGround (DAttrib _ d) = implHeadGround d
implHeadGround (DImpl { tys, ... }) = isEmptyL (flatMap tyVarNames tys)
implHeadGround _ = False

-- True for a DImpl whose head types carry AT LEAST ONE type variable (a parametric
-- receiver like `Eq (List a)`); False for a ground head and every non-impl decl.  The
-- exact complement of implHeadGround over DImpl decls, so the two filters partition the
-- impls without double-inferring any (and both skip non-impl decls).
implHeadParametric : Decl -> Bool
implHeadParametric (DAttrib _ d) = implHeadParametric d
implHeadParametric (DImpl { tys, ... }) = isNonEmptyL (flatMap tyVarNames tys)
implHeadParametric _ = False

-- C8b: default-body type-checking runs UNCONDITIONALLY (checks
-- ALL default bodies regardless of whether they carry method-level constraints),
-- on every driver — a driver that skipped the unconstrained defaults
-- (Ord.lt/gt/min/max, Foldable.length/isEmpty, Filterable.filter, …) would
-- silently accept a bad default body.  The constrained branch still registers dict slots (needed
-- for the emit/dict path); the unconstrained branch only type-checks — safe on
-- the plain-check path (activeDictVars mutation is harmless; reset by `freshModuleCtx`).
inferDefaultBodiesIfEnabled : TcEnv -> List Decl -> Unit
inferDefaultBodiesIfEnabled env prog = inferDefaultBodies env prog

inferDefaultBodies : TcEnv -> List Decl -> Unit
inferDefaultBodies env [] = ()
inferDefaultBodies env (d :: rest) =
  let _ = inferOneIfaceDefaults env d
  inferDefaultBodies env rest

inferOneIfaceDefaults : TcEnv -> Decl -> Unit
inferOneIfaceDefaults env (DAttrib _ d) = inferOneIfaceDefaults env d
-- Type each default body against the
-- interface's OWN method scheme (built from [typarams]+[methods]), NOT
-- `lookupVar env mname`.  On the flat single-file check path a user top-level
-- funDef can SHADOW a method name (e.g. map.mdk's `isEmpty : Map k v -> Bool`
-- shadowing Foldable's `isEmpty`); looking the name up in env would instantiate
-- that Map-typed shadow and infer the default `isEmpty t = match toList t`
-- against it, grounding the default body's container var to `Map` — so a default
-- every `Foldable` shares would be typed for ONE container.  The interface scheme is
-- shadow-free.  (Until #2769 gave `Map` a real `impl Foldable`, that grounding also
-- raised a spurious `No impl of Foldable for Map`; the mis-typing is the part that
-- does not depend on which impls happen to exist.)
-- Also extend env with these schemes so PEER-method refs in a default body
-- resolve to the interface methods (oracle's env_with_methods), not user shadows.
inferOneIfaceDefaults env (DInterface { name, typarams, typaramKinds, methods, ifaceOrigin, ... }) =
  -- #822: derived from THIS declaration, not from a name key (declGradedScope), and
  -- threaded down so the default bodies see the same Row slots the schemes were built
  -- with.  Computed ONCE per interface rather than per method.
  let dscope =
    declGradedScope env.teDyn.dcModule.mcGraph typarams typaramKinds methods
  let ifaceSchemes = methodSchemesPure env.teDyn.dcModule dscope methods
  let iface = IfaceRef { irName = name, irOrigin = ifaceOrigin }
  inferDefaultMethods
    (extendVars env ifaceSchemes)
    iface
    dscope
    typarams
    methods
inferOneIfaceDefaults env _ = ()

inferDefaultMethods : TcEnv ->
  IfaceRef ->
  List (String, List Kind) ->
  List String ->
  List IfaceMethod ->
  Unit
inferDefaultMethods env _ _ _ [] = ()
inferDefaultMethods env iface dscope typarams (m :: rest) =
  let _ = inferDefaultMethod env iface dscope typarams m
  inferDefaultMethods env iface dscope typarams rest

-- C8b: every interface default body is type-checked, constrained or not, by the
-- one method-body driver, against the interface's own signature for the method.
inferDefaultMethod : TcEnv ->
  IfaceRef ->
  List (String, List Kind) ->
  List String ->
  IfaceMethod ->
  Unit
inferDefaultMethod env iface dscope typarams (IfaceMethod mname mty (Some (MethodDefault pats body)) _) =
  inferMethodBody env iface DefaultBody (typarams, mty, dscope) mname pats body
inferDefaultMethod env _ _ _ _ = ()

-- ── PR3 keyed lookups (replace implMatches / implMatchesReceiver / findMatchingImplReqs /
-- implCountForIface).  Each first scans the concrete "iface|tag" bucket, then the iface's
-- headless bucket.  implMatchesU / bucketRecvMatch are EXISTENCE tests, so the
-- concrete-then-headless order is byte-identical to the old flat scan.  findMatchingImplReqsU
-- is first-MATCH and DOES depend on that order — a deliberate soundness/conformance fix,
-- documented on it below. ────────────────────────────────────────────────────────────────

-- ── Error-path B4: missing-impl dispatch-obligation check ──────────────────
-- The `No impl of … for …` reject.  For each recorded interface-method occurrence, recover the types the
-- interface params resolved to at this site (dispatchMonosOf), and — ONLY when
-- they are all CONCRETE (a resolved head tycon, no remaining polymorphic var, so
-- a constrained-generic `Ord a =>` site whose receiver is still `a` is correctly
-- deferred to the caller) — verify the program declares a matching impl.  None →
-- `No impl of <iface> for <args>`.
-- #838 I4: the second obligation checker (checkImplObligations/checkImplObligationsU/
-- checkOneImplObligation) is RETIRED — impl obligations now route through the unified
-- checkOneCallObligation (so a rule lands ONCE).
-- #991: the `implOblToU` bridge that used to project a surviving
-- `pendingImplObligations` 5-tuple onto `UObligation` is GONE — both channels store
-- `UObligation` directly.  The projection it performed still happens at CHECK time and
-- in the same place: `uOblArgs`, via the `OpMethodOcc` arm (NOT `oblDispatchMonos`,
-- which special-cases Num → [] and would drop a numeric literal's operand).
-- Improvement, determination and defaulting at each group's close run BEFORE the gate
-- and ground the shared mono cells, so a determined multi-param goal's projected args
-- are already ground here.

-- PLAN.md #11: after HM + defaulting every source integer literal's type var is
-- ground (or a genuine `Num a` survivor).  Decide each literal's runtime rep
-- (3-way):
--   • ground Float ⇒ stamp the float cell + CLEAR the fromInt route (dref RNone) ⇒
--     dictPass emits `ELit (LFloat f)` (eval is value-tagged; eval_arith rejects
--     mixed int/float tags, so a Float literal must carry a real float).
--   • ground Int (incl. via ambiguous→Int defaulting) ⇒ clear both cells ⇒
--     `ELit (LInt n)`, no dict dispatch.
--   • NOT a primitive head (a still-polymorphic `Num a` — the soundness case, `1`
--     in `inc x = x + 1` — or an exotic user numeric type) ⇒ leave [dref]'s
--     resolveSites-stamped route in place ⇒ dictPass emits
--     `EApp (EMethodAt "fromInt" …) (ELit (LInt n))` so the literal dispatches
--     through the runtime Num dict (Int→identity, Float→intToFloat).  A dref left
--     RNone (route never filled, e.g. unreachable position) falls to Int below.
-- Reads numlitRefs (populated by inferNumLit during THIS run/module's inference).
setNumlitFloatsGo : List (Mono, Ref (Option Float), Int, Ref Route) -> Unit
setNumlitFloatsGo [] = ()
setNumlitFloatsGo ((var, fref, n, dref) :: rest) =
  let _ = match normalize var
    TCon "Float" _ =>
      fref := Some (intToFloat n)
      dref := RNone
    TCon "Int" _ => dref := RNone
    _ => ()
  setNumlitFloatsGo rest

-- Files every commit again under the variable now heading its goal.  A later group
-- or module that unified the committed variable moved its representative, and a
-- lookup reads the representative.  Called where the lookups run: the module's end
-- and each module's stamping in the drain.
refileDeterminedRows : ModuleCtx -> Unit -> Unit
refileDeterminedRows mctx _ =
  let table = mctx.mcCells.determinedRowsRef.value
  if not (IdMap.isEmpty table) then
    let entries = reverseL (flatMap identity (IdMap.values table))
    mctx.mcCells.determinedRowsRef := Tip
    fold (_ entry => fileDeterminedRow mctx (fst entry) (snd entry)) () entries

-- Records, at the module's end, the variables its non-generalized members still
-- leave open, for the graph-end drain (`GraphRun.liveRoots`).
recordLiveRoots : ModuleCtx -> Unit -> Unit
recordLiveRoots mctx _ =
  let members = mctx.mcCells.liveMemberMonosRef.value
  let liveIds = dedupI (flatMap (liveVarIdsOf mctx) members)
  if isNonEmptyL liveIds then
    let goals =
      mctx.mcCells.implObls.items.value ++ mctx.mcCells.obls.items.value
    let numObls =
      mctx.mcCells.implObls.items.value
        ++ numCallObls mctx.mcGraph mctx.mcCells.obls.items.value
    let numIds =
      filterList (i => containsI i liveIds) (numConstrainedIds numObls)
    let numRoots = filterMap (i => liveNumVarGo i numObls) (dedupI numIds)
    let g = mctx.mcGraph.graphRun
    g.liveRoots :=
      filterMap (findTvarInMonos members) liveIds ++ g.liveRoots.value
    g.liveGoals := reverseL (liveGoalsOf mctx members) ++ g.liveGoals.value
    if isNonEmptyL numRoots then
      g.liveNumRoots := numRoots ++ g.liveNumRoots.value
      g.liveNumGoals :=
        filterList
            (o =>
              any
                (i => elem i numIds)
                (flatMap monoUnboundIds (uOblArgs mctx.mcGraph o)))
            goals
          ++ g.liveNumGoals.value

-- The module's held goals that a live root still leaves open, in the order they
-- were held, each under the first of [members] whose type mentions one of its live
-- variables.  A goal a later group grounded is the module's obligation check's.
liveGoalsOf : ModuleCtx -> List Mono -> List LiveGoal
liveGoalsOf mctx members =
  let mid = mctx.mcCells.currentModuleRef.value
  let owners = memberOfIds mctx members
  filterMap
    ((rigidIds, window, o) =>
      let ids = flatMap monoUnboundIds (uOblArgs mctx.mcGraph o)
      map
        (k => LiveGoal {
          lgModule = mid,
          lgBinding = k,
          lgRigidIds =
            fold
              (acc i =>
                if IdMap.has i owners then
                  omDelete (intToString i) acc
                else
                  acc)
              rigidIds
              ids,
          lgWindow = window,
          lgGoal = o,
        })
        (findMap (i => IdMap.get i owners) ids))
    (reverseL mctx.mcCells.heldLiveGoalsRef.value)

-- Each live variable of [members] under the index of the first member whose type
-- mentions it.
memberOfIds : ModuleCtx -> List Mono -> Map Int Int
memberOfIds mctx members =
  fst
    (fold
      ((owners, k) m => (
        fold
          (acc i => if IdMap.has i acc then acc else IdMap.set i k acc)
          owners
          (liveVarIdsOf mctx m),
        k + 1,
      ))
      (Tip, 0)
      members)

-- The verdict on the goals boundaries held for live roots, at the drain, after the
-- live `Num` roots are defaulted: every module has closed, so nothing is left to
-- ground them, and each is judged as its boundary would have judged it had it owned
-- the live variables (DICT-SEMANTICS §6.2 T4, R-SC3), in its own module's context.
-- A binding gets one verdict: the first of its goals that draws one.
judgeLiveGoals : ModuleCtx -> List StampCtx -> List DrainFinding
judgeLiveGoals saved ctxs =
  let g = saved.mcGraph.graphRun
  let goals = reverseL g.liveGoals.value
  g.liveGoals := []
  if isEmptyL goals then
    []
  else
    let byModule = omFromPairs (map (c => (c.scModule, c)) ctxs) omEmpty
    reverseL (fst (fold (judgeLiveGoal saved byModule) ([], omEmpty) goals))

-- [saved] is the record the drain began with, which each entered stamp context takes
-- its drain tables from (`enterStampCtx`).
judgeLiveGoal : ModuleCtx ->
  OrdMap StampCtx ->
  (List DrainFinding, OrdMap Unit) ->
  LiveGoal ->
  (List DrainFinding, OrdMap Unit)
judgeLiveGoal saved byModule (found, judged) lg =
  let binding = "\{lg.lgModule}\t\{intToString lg.lgBinding}"
  match (omHasKey binding judged, omLookup lg.lgModule byModule)
    (False, Some ctx) =>
      let stamp = enterStampCtx saved ctx
      let rigidIds = lg.lgRigidIds
      let diags = captureTypeErrors stamp (_ =>
        fold
          (_ o =>
            undeterminedVectorVerdict stamp rigidIds omEmpty lg.lgWindow o)
          ()
          (lg.lgGoal :: nestedRequireGoals stamp rigidIds omEmpty [lg.lgGoal]))
      match diags
        [] => (found, judged)
        _ => (
          reverseL (map (verdictFinding lg.lgModule True) diags) ++ found,
          omInsert binding () judged,
        )
    _ => (found, judged)

-- The verdict on the goals boundaries left to quiescence, once every group of the
-- module has closed: no later group is left to ground their variables, so each is
-- judged as its boundary would have judged it, and so are the prerequisites its
-- boundary left to this point (`nestedRequireGoals`).
judgeQuiescentGoals : ModuleCtx -> Unit -> Unit
judgeQuiescentGoals mctx _ =
  let goals = reverseL mctx.mcCells.quiescentGoalsRef.value
  mctx.mcCells.quiescentGoalsRef := []
  fold
    (_ (rigidIds, window, o) =>
      fold
        (_ g => undeterminedVectorVerdict mctx rigidIds omEmpty window g)
        ()
        (o :: nestedRequireGoals mctx rigidIds omEmpty [o]))
    ()
    goals

-- The variables a later group can still ground (§6.2 T2): those no scheme
-- quantifies in the types of this group's members [monos] and of every earlier
-- top-level member of the module.  The members that still carry one are kept for
-- the groups after this one; a member grounded since is dropped.
liveMemberIds : ModuleCtx -> List Mono -> OrdMap Unit
liveMemberIds mctx monos =
  let open =
    filterList
      (m => isNonEmptyL (liveVarIdsOf mctx m))
      (monos ++ mctx.mcCells.liveMemberMonosRef.value)
  mctx.mcCells.liveMemberMonosRef := open
  omFromNames
    (map intToString (dedupI (flatMap (liveVarIdsOf mctx) open)))
    omEmpty

liveVarIdsOf : ModuleCtx -> Mono -> List Int
liveVarIdsOf mctx m =
  filterList
    (i => not (IdMap.has i mctx.mcCells.deferrableVarIds.value))
    (monoUnboundIds m)

-- The prerequisites of the instances [obls]' goals select, as goals of the same
-- boundary at their parents' sites (DICT-SEMANTICS §3).  An instance answers a goal
-- only once its `requires` is answered too, so a prerequisite left open is judged
-- like a goal the boundary posed itself.  It is not determined: an open sibling
-- refutes no candidate, so a commit through a prerequisite could choose a
-- structural instance whose open sibling no instance meets (`Num (MyList ?m)`).
-- A goal a given
-- answers whole selects no instance; a goal every variable of which is held rigid
-- leaves its prerequisites to the enclosing scope; a closed goal's are closed, and
-- the obligation gate's.  A goal whose verdict waits for quiescence, on a variable
-- of [liveIds], is walked there with it (`judgeQuiescentGoals`), after a later
-- group could ground that variable.  Each prerequisite continues its parent's walk
-- under the shared `requires` measure (`reqWalkEnter`), which bounds a chain that does
-- not shrink; a repeated or out-of-fuel prerequisite is reported at its site.
-- The goals come level by level, in the order the walk reaches them.  A goal one
-- seed's walk reaches again, at the same fuel, after following it cleanly is the same
-- goal with the same prerequisites, so it is kept and followed once (`wmFollowed`).
-- That pass reports nothing; when a step of it repeats a goal or runs out of fuel,
-- the goals come from a second pass that follows every path and reports each such
-- step, because the walk's path then decides what is reported.
nestedRequireGoals : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  List UObligation ->
  List UObligation
nestedRequireGoals mctx rigidIds liveIds obls =
  let seeds = requireGoalSeeds mctx.mcGraph obls
  let goals =
    nestedRequireGoalsOnce
      mctx
      rigidIds
      liveIds
      (flatMap (followRequireGoal mctx rigidIds liveIds) seeds)
  if anyList (s => (reqWalkMemo (snd s)).wmStopped.value) seeds then
    nestedRequireGoalsGo
      mctx
      rigidIds
      liveIds
      (requireGoalSeeds mctx.mcGraph obls)
  else
    goals

-- Each goal of [obls] as the seed of its own walk.
requireGoalSeeds : GraphCtx -> List UObligation -> List (UObligation, ReqWalk)
requireGoalSeeds gctx obls =
  map
    (o => (o, reqWalkSeed o.pred.iface (map normalize (uOblArgs gctx o))))
    obls

nestedRequireGoalsGo : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  List (UObligation, ReqWalk) ->
  List UObligation
nestedRequireGoalsGo mctx rigidIds liveIds walks =
  match flatMap (selectedRequireGoals mctx rigidIds liveIds) walks
    [] => []
    derived =>
      map fst derived ++ nestedRequireGoalsGo mctx rigidIds liveIds derived

-- The goals from level [walks] down, each goal its walk has already followed left out.
nestedRequireGoalsOnce : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  List (UObligation, ReqWalk) ->
  List UObligation
nestedRequireGoalsOnce mctx _ _ [] = []
nestedRequireGoalsOnce mctx rigidIds liveIds walks =
  let (kept, derived) = followRequireLevel mctx rigidIds liveIds walks [] []
  kept ++ nestedRequireGoalsOnce mctx rigidIds liveIds derived

-- One level, in order: a goal its walk has already followed is left out,
-- each other is kept and followed, and the goals it selects form the next level.
followRequireLevel : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  List (UObligation, ReqWalk) ->
  List UObligation ->
  List (List (UObligation, ReqWalk)) ->
  (List UObligation, List (UObligation, ReqWalk))
followRequireLevel mctx _ _ [] kept derived =
  (reverseL kept, flatMap identity (reverseL derived))
followRequireLevel mctx rigidIds liveIds ((o, walk) :: rest) kept derived =
  if walkGoalFollowed walk o.pred.iface (uOblGoalArgs mctx.mcGraph o) then
    followRequireLevel mctx rigidIds liveIds rest kept derived
  else
    let below = followRequireGoal mctx rigidIds liveIds (o, walk)
    followRequireLevel mctx rigidIds liveIds rest (o :: kept) (below :: derived)

-- [o]'s prerequisites on the pass that reports nothing; [o] is recorded as followed
-- when selecting them detected no error and minted none of their variables
-- (`solvedCleanly`).
followRequireGoal : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  (UObligation, ReqWalk) ->
  List (UObligation, ReqWalk)
followRequireGoal mctx rigidIds liveIds (o, walk) =
  let (clean, below) =
    solvedCleanly
      mctx
      (goals => flatMap (g => uOblArgs mctx.mcGraph (fst g)) goals)
      (_ => requireGoalsBelow mctx prerequisiteUnreported rigidIds liveIds (
        o,
        walk,
      ))
  let _ =
    if clean then
      noteWalkGoalFollowed walk o.pred.iface (uOblGoalArgs mctx.mcGraph o)
  below

uOblGoalArgs : GraphCtx -> UObligation -> List Mono
uOblGoalArgs gctx o = map normalize (uOblArgs gctx o)

-- [o]'s prerequisites under the one instance its goal selects as it stands, each
-- with the walk that reaches it from [o]'s.
selectedRequireGoals : ModuleCtx ->
  OrdMap Unit ->
  OrdMap Unit ->
  (UObligation, ReqWalk) ->
  List (UObligation, ReqWalk)
selectedRequireGoals mctx rigidIds liveIds walk =
  requireGoalsBelow mctx (prerequisiteOnWalk mctx) rigidIds liveIds walk

-- [o]'s prerequisites, each entered on [o]'s walk by [enter].
requireGoalsBelow : ModuleCtx ->
  (ReqWalk -> UObligation -> List (UObligation, ReqWalk)) ->
  OrdMap Unit ->
  OrdMap Unit ->
  (UObligation, ReqWalk) ->
  List (UObligation, ReqWalk)
requireGoalsBelow mctx enter rigidIds liveIds (o, walk) =
  let args = map normalize (uOblArgs mctx.mcGraph o)
  let iface = o.pred.iface
  let parentIds = flatMap monoUnboundIds args
  if isEmptyL args
    || monoVectorClosed args
    || goalVarsAllHeld rigidIds args
    || goalGivenAt mctx.mcGraph iface args o.uoScope
    || anyList (i => omHasKey (intToString i) liveIds) parentIds
      && not (undeterminedGoalExempt mctx iface args o.uoScope) then
    []
  else
    let rows = goalRows mctx iface args
    let reach =
      if goalIsProjection args rows then
        ReachMany
      else
        goalReach mctx args (goalCandidates mctx rigidIds args rows)
    match reach
      ReachOne row =>
        let goalsOf =
          ids subst reqs =>
            flatMap
              (req =>
                flatMap
                  (enter walk)
                  (requireGoalAt o ids (reqToObligation mctx subst req)))
              reqs
        match selectedRowReqMatch mctx args row
          Some (subst, reqs) => goalsOf parentIds subst reqs
          None => match unifiedRowReqs mctx rigidIds args row
            Some (subst, fresh, reqs) => goalsOf (parentIds ++ fresh) subst reqs
            None => []
      _ => []

-- A prerequisite entered on its parent's walk without a report: a repeated or
-- out-of-fuel one stops the walk (`wmStopped`), which `nestedRequireGoals` then runs
-- again with `prerequisiteOnWalk`.
prerequisiteUnreported : ReqWalk -> UObligation -> List (UObligation, ReqWalk)
prerequisiteUnreported walk g =
  match reqWalkEnter walk g.pred.iface (map normalize g.pred.args)
    ReqOn next => [(g, next)]
    _ =>
      let memo = reqWalkMemo walk
      memo.wmStopped := True
      []

-- The prerequisites of [row] under the unifier of its heads with [args] (every
-- variable in [rigidIds] held rigid), for a goal the row's head determines without
-- matching it as it stands (`B ?a` under `impl B (List b)`).  The unifier is not
-- committed, so the head variable it introduces (`?b` in `?a := List ?b`) stands
-- for a part of the goal's variable only while nothing outside the boundary can
-- still bind that variable: every goal variable it binds must be the boundary's.
-- One a scheme quantifies makes the goal the caller's, and the caller walks it on
-- its own variables.  The substitution keeps the goal's own variables where the
-- unifier held them rigid, and the variables it introduces are returned beside it.
unifiedRowReqs : ModuleCtx ->
  OrdMap Unit ->
  List Mono ->
  ImplRow ->
  Option (List (String, Mono), List Int, List Require)
unifiedRowReqs mctx rigidIds args (row@(ImplRow _ _ _ _ reqs _ _)) =
  let (tvs, heads) = freshRowHeadsTvs mctx row
  let goalIds = flatMap monoUnboundIds args
  match headsUnifier mctx.mcGraph rigidIds args heads
    Some scratch =>
      if allList
        (b =>
          not (containsI (fst b) goalIds)
            || boundaryOwnsOpen mctx rigidIds (fst b))
        !scratch then
        let sigCells = sigCellsOf rigidIds (flatMap monoVarCells args)
        let bound =
          map
            (nv => (fst nv, unrigidSig sigCells (cohApply scratch (snd nv))))
            tvs
        Some (bound, flatMap (nv => monoUnboundIds (snd nv)) bound, reqs)
      else
        None
    None => None

-- A prerequisite as a goal at [o]'s site.  One that mentions a variable the
-- instance's head does not fix is left to the module's obligation check.
requireGoalAt : UObligation ->
  List Int ->
  (IfaceRef, List Mono) ->
  List UObligation
requireGoalAt o parentIds (iface, args)
  | not (allList (i => containsI i parentIds) (flatMap monoUnboundIds args)) =
    []
  | otherwise = [
    UObligation {
      pred = Predicate { iface = iface, args = args },
      originId = o.originId,
      prov = o.prov,
      loc = o.loc,
      uoScope = o.uoScope,
      oblProj = OpProjected,
    },
  ]

-- A binder's declared variables join the set every instance-head matcher holds
-- rigid (`matchEqPairs`), from the binder's close on.
declareRigidVars : ModuleCtx -> List String -> Unit
declareRigidVars mctx [] = ()
declareRigidVars mctx keys =
  mctx.mcCells.declaredSigVarIds :=
    omFromNames keys mctx.mcCells.declaredSigVarIds.value

-- One fresh variable per interface parameter [mty] never mentions.  DICT-SEMANTICS
-- §5: the dispatch vector is fixed by the use site's instantiation of the whole
-- interface, wherever (or whether) a parameter appears in the method's type, so the
-- occurrence poses that position at a variable of its own for §3 to determine.
omittedParamVars : ModuleCtx -> List String -> Ty -> List (String, Mono)
omittedParamVars mctx typarams mty =
  let named = tyVarNames (stripTyConstraints mty)
  map
    (tp => (tp, freshVar mctx ()))
    (filterList (tp => not (contains tp named)) typarams)

-- `omittedParamVars` for the method [name] resolves to here, when it dispatches on
-- an argument.  None for a name with no single declaring interface, nor for a
-- return-dispatched method, whose occurrence mints its own beside its predicate
-- template (`methodReturnRequest`).
methodOmittedVars : ModuleCtx -> String -> List (String, Mono)
methodOmittedVars mctx name = match (
  argDispatchOf mctx name,
  methodEntryHere mctx name,
)
  (Some _, Some (_, typarams, mty, _)) => omittedParamVars mctx typarams mty
  _ => []

-- infer each impl-with-`requires`' return-position method bodies; the interface
-- method declarations come from the identity-keyed ClassEnv row at [cur].
-- Each impl is inferred at the span `locatedImpls` paired it with.
inferImplBodies : TcEnv ->
  List String ->
  ClassEnv ->
  Int ->
  List (Option Loc, Decl) ->
  Unit
inferImplBodies env _ _ _ [] = ()
inferImplBodies env rpNames ce cur ((loc, d) :: rest) =
  let _ = inferOneImpl (envAtIfSome loc env) rpNames ce cur d
  inferImplBodies env rpNames ce cur rest

-- The impls of [decls], each with the span a check in it that names no construct
-- takes: the impl's interface name, or for an impl `deriving` generated (it has
-- none), the name of the type declared before it (`expandDecl` places a type's
-- derived impls right after it).
locatedImpls : Option Loc -> List Decl -> List (Option Loc, Decl)
locatedImpls _ [] = []
locatedImpls derivedFrom (d :: rest) = match implDeclLoc d
  Some here => (orElseLoc here derivedFrom, d) :: locatedImpls derivedFrom rest
  None => locatedImpls (derivingTypeLoc d) rest

-- `Some` for an impl, holding its interface name's span.
implDeclLoc : Decl -> Option (Option Loc)
implDeclLoc (DAttrib _ d) = implDeclLoc d
implDeclLoc (DImpl { implIfaceLoc, ... }) = Some implIfaceLoc
implDeclLoc _ = None

derivingTypeLoc : Decl -> Option Loc
derivingTypeLoc (DAttrib _ d) = derivingTypeLoc d
derivingTypeLoc (DData { dataNameLoc, ... }) = dataNameLoc
derivingTypeLoc (DNewtype { newtypeNameLoc, ... }) = newtypeNameLoc
derivingTypeLoc _ = None

inferOneImpl : TcEnv -> List String -> ClassEnv -> Int -> Decl -> Unit
inferOneImpl env rpNames ce cur (DAttrib _ d) =
  inferOneImpl env rpNames ce cur d
-- #1647 (S1): [implOrigin] is bound here, NOT dropped by the `...`.  The impl-body
-- signature lookup below used to receive the interface's
-- bare SPELLING, so two modules each declaring an interface spelled `Speak` sent
-- every impl body of either one to whichever `DInterface` the joint decl list
-- happened to list FIRST — attributing module B's body to module A's declared
-- method type, per import order.  DICT-SEMANTICS §8 I4: an interface is a
-- (module, name) pair, so the lookup takes the IDENTITY the `impl` head already
-- carries.  Same construction as `implDeclFact`, from the same two fields.
inferOneImpl env rpNames ce cur (DImpl { iface, tys, reqs, methods, implOrigin, ... }) =
  let iref = IfaceRef { irName = iface, irOrigin = implOrigin }
  match reqs
    [] => inferPlainImpl env ce cur iref tys methods
    _ => inferRequiresImpl env rpNames ce cur iref tys reqs methods
inferOneImpl env _ _ _ _ = ()

-- D3a: a NON-`requires` impl body, inferred on every path (single elaboration mode)
-- so its ARG-position method occurrences (e.g. `display` of a String field inside a
-- `Display`/`Debug` impl — the 19 `display@String` sites) reach inferMethodAt and
-- get stamped.  Mirrors inferRequiresImpl's head-mono substitution but with no
-- requires to register (an unconstrained impl threads no element dict).
inferPlainImpl : TcEnv ->
  ClassEnv ->
  Int ->
  IfaceRef ->
  List Ty ->
  List ImplMethod ->
  Unit
inferPlainImpl env ce cur iface tys methods =
  let (implTvMap, headMonos) = implHeadMonos env.teDyn.dcModule tys
  inferImplMethods
    env
    ce
    cur
    iface
    implTvMap
    headMonos
    []
    (scopeImplMethods
      env.teDyn.dcModule
      (captureScope env.teDyn.dcModule ())
      methods)

-- one impl `impl Iface (List a) requires Iface a where …`: build ONE tyvar map
-- shared between the head (`List a`) and the requires (`Iface a`) so the body's
-- inner method ref unifies its discriminating var to the head's `a`; infer each
-- method body against the method type instantiated at the head; THEN register the
-- requires' post-unification ids in activeDictVars keyed to `$dict_<method>_<slot>`.
inferRequiresImpl : TcEnv ->
  List String ->
  ClassEnv ->
  Int ->
  IfaceRef ->
  List Ty ->
  List Require ->
  List ImplMethod ->
  Unit
inferRequiresImpl env rpNames ce cur iface tys reqs methods =
  let (implTvMap, headMonos) = implHeadMonos env.teDyn.dcModule tys
  let scopedMethods =
    scopeImplMethods
      env.teDyn.dcModule
      (captureScope env.teDyn.dcModule ())
      methods
  let _ =
    inferImplMethods env ce cur iface implTvMap headMonos reqs scopedMethods
  registerImplRequires
    env.teDyn.dcModule
    ce
    cur
    iface
    implTvMap
    rpNames
    reqs
    scopedMethods

scopeImplMethods : ModuleCtx ->
  ScopeId ->
  List ImplMethod ->
  List ScopedImplMethod
scopeImplMethods mctx _ [] = []
scopeImplMethods mctx parent (method :: rest) =
  let name = implMethodName method
  let scope =
    Scopes.freshScope
      (currentScopeStore mctx.mcGraph ())
      (Some parent)
      mctx.mcCells.currentLevel.value
      (Scopes.scopeFrame (currentScopeStore mctx.mcGraph ()) parent).sfModuleId
      (BindingOwner name)
  ScopedImplMethod { simMethod = method, simScope = scope }
    :: scopeImplMethods mctx parent rest

inferImplMethods : TcEnv ->
  ClassEnv ->
  Int ->
  IfaceRef ->
  List (String, Mono) ->
  List Mono ->
  List Require ->
  List ScopedImplMethod ->
  Unit
inferImplMethods env _ _ _ _ _ _ [] = ()
inferImplMethods env ce cur iface implTvMap headMonos reqs (m :: rest) =
  let _ = inferImplMethod env ce cur iface implTvMap headMonos reqs m
  inferImplMethods env ce cur iface implTvMap headMonos reqs rest

inferImplMethod : TcEnv ->
  ClassEnv ->
  Int ->
  IfaceRef ->
  List (String, Mono) ->
  List Mono ->
  List Require ->
  ScopedImplMethod ->
  Unit
inferImplMethod env ce cur iface implTvMap headMonos reqs scoped =
  match scoped.simMethod
    ImplMethod mname pats body => match ceMethodTyAt iface mname cur ce
      None => ()
      Some sig =>
        inferMethodBody
          env
          iface
          (ImplBody ImplBodySite {
            ibImplTvMap = implTvMap,
            ibHeadMonos = headMonos,
            ibRequires = reqs,
            ibScope = scoped.simScope,
          })
          sig
          mname
          pats
          body

-- The one method-body judgment: an impl method body, or an interface default
-- body, checked against the method's declared signature [sig] (the interface
-- params, the method type, and the graded scope the method's own scheme was built
-- under).  Both kinds instantiate the signature, infer the body against it under
-- one effect contract, query the launder trail, check W3 rigidity, run the
-- body-local numeric boundary and publish the method-level givens.  Each step at
-- which the kinds differ reads [kind] explicitly, and no flag governs two
-- unrelated steps.  In order:
--   * scope and currentFn: `openMethodBodyScope`; an impl body also sets
--     currentImplBody and resets currentFn to "" afterwards, where a default body
--     restores the caller's.
--   * instantiation: `instantiateMethodBody`.  A default body's rigidity reads the
--     same instantiation as its body and forcing row; a second signature would
--     disconnect force-only variables from the body being checked (guard fixture:
--     test/run_check_agreement_fixtures/reject_offspine_closed_row_launder_crossmodule.mdk).
--   * cascade suppression: `gatesBodyCascade`, default bodies only.
--   * where the forcing row is checked and the effect contract closes, and the
--     launder message: `checkMethodBodyAgainst`.
--   * effect-variable rigidity: one call, `checkMethodEffVarRigidity`.  An impl body
--     runs it after the type-variable half, with the launder query's verdict and its
--     index-only variables; a default body runs it before, with False and [], and
--     skips it when the body erred.  The two halves' diagnostics print in the order
--     they are pushed.
--   * the numeric channel: an impl body intersects the head and declared-dictionary
--     roots and checks its head's numeric prerequisites; a default body's surviving
--     roots are its declared type's.
--   * givens: `registerMethodBodyGivens`.
inferMethodBody : TcEnv ->
  IfaceRef ->
  MethodBodyKind ->
  (List String, Ty, List (String, List Kind)) ->
  String ->
  List Pat ->
  Expr ->
  Unit
inferMethodBody outer iface kind (params, mty, gscope) mname pats body =
  -- The body's own checks (its rigidity, its effect contract) are located at
  -- the body; its type meets the signature at the value it returns.
  let env = envAtIfSome (exprSpanLoc body) outer
  let _ = enterLevel env.teDyn.dcModule ()
  let bodyLevel = env.teDyn.dcModule.mcCells.currentLevel.value
  let bodyScope = openMethodBodyScope env.teDyn.dcModule iface mname kind
  let savedCurrentFn = env.teDyn.dcModule.mcCells.currentFn.value
  -- currentFn = the method name (NOT "") so arg-/return-position sites in THIS
  -- body record `encl = mname`.  registerImplRequires keys every method of an impl
  -- under the SAME impl tyvar id (`impl Ord (List a)` registers `a` once per
  -- compare/lt/min/max/…), so the global first-match route resolution returns the
  -- LAST-registered method's `$dict_<m>_<slot>` for ALL bodies — corrupting e.g.
  -- compare's element dispatch to `$dict_max_0` (unbound in compare's scope).  With
  -- encl = mname, activeDictVarOfEncl/argImplDictRoutesForEncl prefer THIS method's
  -- own `$dict_<mname>_<slot>`.  Pre-specialization each Ord impl defined only
  -- compare so there was no collision; universal default specialization exposes it.
  env.teDyn.dcModule.mcCells.currentFn := mname
  let _ = match kind
    ImplBody _ => env.teDyn.dcModule.mcCells.currentImplBody := True
    DefaultBody => ()
  -- #518: window this body's newly-added obligations, exactly as processLetGroup /
  -- `checkBodyImpl` does for a let-group, so the Num defaulting below is scoped to
  -- THIS method and can never touch an already-generalized outer var.
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let inst = instantiateMethodBody env.teDyn.dcModule kind params mty gscope
  let headBefore = match kind
    ImplBody site => implHeadVarRoots site.ibImplTvMap
    DefaultBody => []
  let _ =
    registerMethodBodyGrants
      env.teDyn.dcModule.mcGraph
      iface
      mname
      (methodBodyHeadMonos kind)
      inst
      bodyScope
  let _ =
    recordClauseFileBound
      env.teDyn.dcModule
      body
      (listLen pats)
      inst.mbiExpected
  let loc = orElseLoc (implBodyLoc body) (firstTyLoc mty)
  let subject = methodBodySubject kind iface.irName mname
  -- #821: the method's effect variables are RIGID for the body — two of them
  -- meeting in an ambient row join rather than being identified.
  let contract =
    beginEffectContract
      env.teDyn.dcModule
      inst.mbiContractForce
      inst.mbiExpected
  -- issue 1146: "did the body DETECT an error" is a CONTROL judgment, so it is read
  -- off the occurrence counter, not off `listLen typeErrors`.  The region is the
  -- whole body check, which also pushes T-EFFECT-LAUNDER and contains its own gated
  -- unify, so no unify-level failure signal could answer it.
  let (bodyErred, check) = erredDuring env.teDyn.dcModule (_ =>
    checkMethodBodyAgainst
      env
      iface
      kind
      mname
      mty
      gscope
      inst
      contract
      loc
      pats
      body)
  let headMonos = methodBodyHeadMonos kind
  -- The launder query's verdict silences the atom half of an impl body's
  -- effect-variable check (same defect, one report).  A default body passes False,
  -- so a default body that launders can be reported by both.
  let launderFlagged = match kind
    ImplBody _ => check.mbcLaunderFlagged
    DefaultBody => False
  let effVarRigidity =
    _ =>
      checkMethodEffVarRigidity
        env.teDyn.dcModule
        subject
        headMonos
        gscope
        mty
        inst.mbiEffVars
        launderFlagged
        check.mbcEagerIndexed
        (orElseLoc loc check.mbcPerformedAt)
  -- Cascade gate S1 (ERROR-QUALITY.md §6): a default body that detected an error
  -- skips its effect-variable check.
  let _ = match kind
    DefaultBody => if bodyErred then () else effVarRigidity ()
    ImplBody _ => ()
  -- #814 (S0): W3 method-scheme fidelity (DICT-SEMANTICS §3).  The method's
  -- non-head quantified variables — type AND effect — belong to the CALLER
  -- (every use site re-instantiates them freshly), so the body must be checked
  -- at full generality.  [mbiSurvivors]/[mbiEffVars] were fresh flexible vars for
  -- the unify; verifying they SURVIVED unification as distinct unbound
  -- variables (types) / atom-free rows with distinct tails (effects) is
  -- equivalent to having checked the body against skolems, at the cost of one
  -- post-unify inspection (the same discipline as checkAnnotTooGeneral's C3).
  -- Without it a body can pin `b` in `mk : a -> b` — to Int (caller
  -- instantiates b := String, evaluation crashes) or to an effect-bearing
  -- arrow, alone or nested in a tuple/data arg (caller pins b to the pure
  -- arrow: a certified-pure value performs IO — the #814 laundering vein the
  -- per-arrow #803 walk is structurally blind to).  Runs BEFORE body-local
  -- defaulting so a Num default can never mask a pin.
  -- [addedObls] (this body's obligation window, also fed to the numeric boundary
  -- below) carries the CONSTRAINT axis: a body whose pin is a *constrained
  -- var* rather than a constructed type (`mk d = 42` pins b to a Num-obligated
  -- var, still a TVar) escapes the distinctness check, but its obligation on a
  -- caller-owned var is the same lie — gen-sig's `Q_sig ⊩ P'` on the impl side.
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  -- ALSO the CALL-obligation window: a predicate reaching a scheme var through
  -- a constrained HELPER call (`hh : Num x => x -> x`; body `meth d x = hh x`)
  -- is recorded by recordCallObligations, never by recordImplObligation — the
  -- adversarial review's break 2: without this window the Num rides a channel
  -- the survivor check never read, and `check` stayed green on a program whose
  -- built binary printed garbage.
  let addedCallObls = callOblsWindow env.teDyn.dcModule callN0
  -- The settle sequence at the method-body boundary (DICT-SEMANTICS §3).  The body
  -- owns neither the instance head's variables nor its declared signature's: a
  -- construction site instantiates both, so both are held rigid, and every other
  -- variable of a goal is the body's.  An impl body's head monos and method type
  -- carry them; a default body has no head, and its method type carries the
  -- receiver's variables too.  It runs before the rigidity and head-prerequisite
  -- checks so that a predicate determination moves onto a head variable is read
  -- by them, and before the surviving roots are snapshotted.
  let bodyRigidIds =
    monoRootIdSet (headMonos ++ [inst.mbiExpected] ++ map snd inst.mbiNamedVars)
  let bodyObls = addedObls ++ callUOblsWindow env.teDyn.dcModule callN0
  let _ = improveByUniqueImpl env.teDyn bodyRigidIds bodyObls
  let _ = determineByUniqueInstance env.teDyn.dcModule bodyRigidIds bodyObls
  let _ =
    checkMethodRigidityCore
      env.teDyn.dcModule
      subject
      iface.irName
      mty
      headMonos
      inst.mbiSurvivors
      (methodBodyOwnTyparams kind params)
      addedObls
      addedCallObls
      loc
  let _ = match kind
    ImplBody site =>
      checkImplHeadRigidity
        env.teDyn.dcModule
        subject
        iface.irName
        site
        headBefore
        (orElseLoc (firstExprLoc body) loc)
    DefaultBody => ()
  let _ = match kind
    ImplBody _ => effVarRigidity ()
    DefaultBody => ()
  -- The rigidity read above can normalize/alias union-find roots. Snapshot
  -- channels only afterward so this set and every obligation use the same
  -- final root identities.
  let survivingNumIds = match kind
    ImplBody site =>
      numChannelRootSet
        addedObls
        (site.ibHeadMonos
          ++ methodLevelConstraintMonos params mty inst.mbiNamedVars)
    DefaultBody => monoRootIdSet [inst.mbiExpected]
  let _ = match kind
    ImplBody site =>
      checkImplHeadNumObligations
        env.teDyn.dcModule
        subject
        site.ibImplTvMap
        site.ibRequires
        survivingNumIds
        addedObls
    DefaultBody => ()
  let _ = match kind
    ImplBody site =>
      checkImplHeadPrerequisites
        env.teDyn.dcModule
        subject
        iface
        site
        inst.mbiNamedVars
        mty
        addedObls
        addedCallObls
    DefaultBody => ()
  let _ = exitLevel env.teDyn.dcModule ()
  -- #518 (S0, silent wrongness): PLAN.md #11 Num defaulting NEVER RAN over a method
  -- body — this path is not a let-group, so nothing grounded its ambiguous
  -- Num vars.  A literal consumed entirely inside the body (`t _ = s [1, 2]`) left
  -- its element var UNBOUND, so the receiver the route resolver saw was `List _a`,
  -- not `List Int` — and `List _a` matches only the GENERAL `impl S (List a)`, never
  -- the specific `impl S (List Int)`.  The min⊑ selector was never at fault: with one
  -- match there is nothing to select between.  It resolved to the general impl and
  -- routed its `requires S a` to RNone (a null dict) — hence `build` silently printing
  -- the general instance's answer and `run` panicking E-NOT-A-FUNCTION.
  -- The same expression at TOP LEVEL was always correct precisely because
  -- group defaulting grounded the var to Int first.  #873: a default body is inferred
  -- once and every inheriting instance reuses its routes, so it grounds here too, or
  -- module placement would decide which impl a body-local literal dispatches to.
  --
  -- MUST run AFTER the body's unify, when root identities are final. The
  -- surviving set is the intersection of this body's Num roots with head roots and
  -- declared method-dictionary roots. A return-position method variable (`lift :
  -- Num b => a -> Box b`) survives through the latter; `b` in `impl Mk (Acc b)`
  -- survives through the former and the rigidity owner above requires its impl-level
  -- prerequisite. An unrelated body-local root remains outside both and grounds.
  -- Group defaulting is still the wrong policy here: its arg-position-only filter
  -- measurably traded #518's S0 for a new one.
  --
  -- The just-exited method-body level owns both body-local defaulting and the
  -- ambiguity registration that follows it. Roots carried by the impl head or
  -- declared method dictionaries survive through [survivingNumIds]/[mbiExpected];
  -- deeper generalized locals remain outside this boundary by level.  A variable a
  -- multi-parameter goal ties to the head (`e` of `Index (Array a) k e`) is not in
  -- that set: D3 clause 3 withholds it when grounding it would leave the goal no
  -- instance, and the second determination below settles it.
  let withheld = finalizeNumBoundary
    env.teDyn
    NumBoundary {
      nbDisposition = NumBoundaryOwnedMethodBody bodyLevel,
      nbMembers = [inst.mbiExpected],
      nbSurvivingIds = survivingNumIds,
      nbDefaultObls =
        addedObls ++ calleeNumObls env.teDyn.dcModule callN0 dictN0,
      nbAmbiguityObls = addedObls,
      nbGuard = NumGuard {
        ngGoals = bodyObls,
        ngRigidIds = bodyRigidIds,
        ngOuterBelow = None,
      },
    }
  -- Defaulting is a substitution like any other, so the goals it changed are
  -- improved and determined once more.
  let _ = improveByUniqueImpl env.teDyn bodyRigidIds bodyObls
  let _ = determineByUniqueInstance env.teDyn.dcModule bodyRigidIds bodyObls
  -- The method signature's own variables are held at the body's close as a
  -- top-level signature's are at its group's.  A goal that fixes a head variable is
  -- W3-inst's (`checkImplHeadPrerequisites`), so only these are held.  The method's
  -- own `=>` context is given in the body's scope, with its supers, before they are
  -- (`publishMethodPredGivens`), so the check reads it through `goalGivenAt`.  They
  -- do not join `declaredSigVarIds`: the module-end verdict on a default body's
  -- open goal reads the instances its receiver variables reach
  -- (`test/dict_fixtures/undetermined-method-goal-default-body.mdk`).
  let methodSig = [(mname, mty, inst.mbiSurvivors)]
  let methodVarIds = sccProtectedSignatureIds methodSig
  let _ = publishMethodPredGivens env.teDyn.dcModule params mty inst bodyScope
  let _ =
    checkSigVarGoals
      env.teDyn.dcModule
      DeclaredBySignature
      methodVarIds
      methodSig
      bodyObls
  let _ =
    rejectUndeterminedVectors
      env.teDyn.dcModule
      bodyRigidIds
      omEmpty
      addedObls
      (callUOblsWindow env.teDyn.dcModule callN0
        ++ nestedRequireGoals env.teDyn.dcModule bodyRigidIds omEmpty bodyObls)
  let _ =
    rejectWithheldAmbiguity env.teDyn.dcModule bodyRigidIds withheld bodyObls
  let _ =
    registerMethodBodyGivens
      env.teDyn.dcModule.mcGraph
      iface
      kind
      params
      mty
      inst
      bodyScope
  let _ = match kind
    ImplBody _ => env.teDyn.dcModule.mcCells.currentImplBody := False
    DefaultBody => ()
  let restoredFn = match kind
    ImplBody _ => ""
    DefaultBody => savedCurrentFn
  env.teDyn.dcModule.mcCells.currentFn := restoredFn
  closeScope env.teDyn.dcModule ()

-- An impl body's scope was minted beside its siblings' before any body ran; a
-- default body mints its own, owned by its (interface, method) identity, at the
-- level just entered.
openMethodBodyScope : ModuleCtx ->
  IfaceRef ->
  String ->
  MethodBodyKind ->
  ScopeId
openMethodBodyScope mctx _ _ (ImplBody site) =
  let _ = openScope mctx site.ibScope
  site.ibScope
openMethodBodyScope mctx iface mname DefaultBody =
  let parentScope = captureScope mctx ()
  let owner = DefaultBodyIdentity { dbiIface = iface, dbiMethod = mname }
  let bodyScope =
    Scopes.freshScope
      (currentScopeStore mctx.mcGraph ())
      (Some parentScope)
      mctx.mcCells.currentLevel.value
      (Scopes.scopeFrame
        (currentScopeStore mctx.mcGraph ())
        parentScope).sfModuleId
      (DefaultBodyOwner owner)
  let _ = openScope mctx bodyScope
  bodyScope

-- Instantiate the declared method type for one body.
instantiateMethodBody : ModuleCtx ->
  MethodBodyKind ->
  List String ->
  Ty ->
  List (String, List Kind) ->
  MethodBodyInstance
-- An impl body: the interface params are the head monos, every other signature
-- variable is fresh.  The tv map is built explicitly (instead of
-- expectedMethodType, which hides it) so the method's OWN method-level constraint
-- vars (`Thenable m => …`) can be registered after the body.
instantiateMethodBody mctx (ImplBody site) ifaceParams mty gscope =
  let baseMap = zipL ifaceParams site.ibHeadMonos
  -- #822: subtract rowArgNames too — the same split sigToSchemeTvs and
  -- astTypeFreshTbl already make.  A name sitting in a KRow type-app slot (`f e a`
  -- under a graded interface) is an EFFECT variable: it belongs to [effMap] below,
  -- and minting a TYPE var for it as well puts an entry in [extraMap] that
  -- [expected] never mentions.  Without the subtraction the graded fixtures still
  -- check, run and build identically, because the stray entry survives unification
  -- as an unbound, distinct var and so passes checkMethodRigidityCore's
  -- pinned/dup/head-disjointness tests vacuously; a survivor set containing a
  -- variable the method type does not mention would still be a false positive for
  -- the first rule that quantifies over all survivors.
  let extraMap =
    freshTvMap
      mctx
      (removeAllS
        ifaceParams
        (removeAllS (rowArgNamesIn mctx gscope mty) (dedup (tyVarNames mty))))
  -- #782/#784: build the method type's effect table the way sigToSchemeTvs does,
  -- so a free return-position effect var (`speak : a -> <e> String`) becomes a
  -- FRESH OPEN effvar that the impl body's actual effect instantiates (effect
  -- polymorphism: `Speak Dog`'s <Stdout> body sets e := <Stdout>), rather than
  -- collapsing to a CLOSED empty `<>` (fromAstType's empty etbl) and firing a
  -- spurious T-EFFECT-LEAK against a bound the method never declared.  A CONCRETE
  -- (`<Stdout>`) or PURE (`<>`) declared row still yields a closed row, so a genuine
  -- impl-body effect leak past a non-var bound is still enforced (#782).
  let effMap =
    sigVarsFor
      mctx
      mty
      (dedup (effTailNames mty ++ rowArgNamesIn mctx gscope mty))
  let mtvs = baseMap ++ extraMap
  let expected = fromAstTypeE mctx effMap mtvs mty
  let contractForce = bindingForceFromAst mctx effMap mtvs mty
  MethodBodyInstance {
    mbiExpected = expected,
    mbiContractForce = contractForce,
    mbiCheckedForce = _ => bindingForceFromAst mctx effMap mtvs mty,
    mbiEffVars = effMap.svRows,
    mbiSurvivors = extraMap,
    mbiNamedVars = mtvs,
    mbiDictSlots = [],
    mbiTypeSubst = [],
  }
-- A default body: the interface's own scheme for the method, instantiated once.
-- #822: [dscope] is the declaration-derived graded scope the method's scheme was
-- built under (inferOneIfaceDefaults → methodSchemesPure), so a default body of a
-- graded method sees its Row slots as rows, not as tyvars.
-- The constraint slot ids AND the instantiation MUST come from the SAME
-- sigToSchemeTvs build of this method's type.  Reading the ids from
-- methodPredicateSlotsRef (filled by a separate method-row build with its own
-- fresh tyvar ids) and instantiating an unrelated methodSchemesPure scheme gave ids
-- that did not appear in the instantiation subst → registerOneMethodDict's
-- `lookupAssocI id subst` returned None → activeDictVars got no entry → the in-body
-- `empty`/`++` routed RNone → eval's `++` saw a non-monoid acc and panicked
-- ('++' requires Semigroup).
-- The effect variables are read off the same substitution: sigToSchemeTvsIn
-- allocates its quantified rows in this name order, and the instantiation
-- preserves that order.
instantiateMethodBody mctx DefaultBody typarams mty dscope =
  let st = sigToSchemeTvsIn mctx dscope mty
  let descriptor = instantiateMethodTracked mctx (fst st)
  let subst = descriptor.mtiSubstitution.misTypeSubst
  MethodBodyInstance {
    mbiExpected = descriptor.mtiBody,
    mbiContractForce = descriptor.mtiForce,
    mbiCheckedForce = _ => effrowNorm descriptor.mtiForce,
    mbiEffVars =
      zipL
        (dedup (effTailNames mty ++ rowArgNamesIn mctx dscope mty))
        (map snd descriptor.mtiSubstitution.misEffectSubst),
    mbiSurvivors = defaultSurvivorMap (snd st) subst,
    mbiNamedVars = instantiateNamedMonos mctx.mcGraph (snd st) subst,
    mbiDictSlots = methodConstraintSlotIds typarams mty (snd st),
    mbiTypeSubst = subst,
  }

-- A default body has no instance head: the head-disjointness and head-row alias
-- tests then have nothing to compare against.
methodBodyHeadMonos : MethodBodyKind -> List Mono
methodBodyHeadMonos (ImplBody site) = site.ibHeadMonos
methodBodyHeadMonos DefaultBody = []

-- An obligation on a receiver typaram is entailed by the interface itself on a
-- default body; an impl body's receiver is its head, so it has none.
methodBodyOwnTyparams : MethodBodyKind -> List String -> List String
methodBodyOwnTyparams (ImplBody _) _ = []
methodBodyOwnTyparams DefaultBody typarams = typarams

-- The cascade gates of ERROR-QUALITY.md §6 (dim R: one root cause, no cascade; dim
-- X: one diagnostic per root cause), which a default body is checked under: S1
-- skips its effect-variable check when the body erred, S2 skips the method-boundary
-- unify and the launder query when inferring the body erred, and S3 drops the
-- body's own obligations when that unify fails.
gatesBodyCascade : MethodBodyKind -> Bool
gatesBodyCascade (ImplBody _) = False
gatesBodyCascade DefaultBody = True

-- Infer a method body against its declared type and query the launder trail.
--
-- The clause parameters are CHECKED against the declared domains (#821/#825,
-- Phase 73's peel) rather than inferred fresh, so a callback's row IS the
-- method's rigid `e` inside the body.  Performing it under a pure stored arrow
-- then meets `<>` as a rigid leftover — the #825 launder becomes a mismatch — and
-- two rigid rows performed together JOIN.
--
-- #803 (S0): the body's latent effect on EVERY arrow down to the method's declared
-- return is bounded by the effect the method declares at that same arrow.  An
-- effect a body legitimately performs by USING an argument (applying a callback
-- `a -> <e> b`, running a row-kinded `Async e` arg) enters the body row as that
-- argument's effect VARIABLE.  An INTRINSIC effect — `putStr`, or a call to a
-- concrete-effect helper, sourced from NO argument — instead lands as a CONCRETE
-- ATOM on whichever arrow evaluates it.  So per arrow, the body's concrete atoms
-- must be a subset of the method's declared concrete atoms; anything more
-- launders to pure at the call site.  Covering ALL declared arrows (not just the
-- `pats` count) is load-bearing: a curried / eta-reduced body (`speak d k = u =>
-- putStr …`) writes FEWER patterns and performs its intrinsic effect on a
-- RETURNED-lambda arrow BEYOND its pattern count — the arrow the declared return
-- still covers.
--
-- #839 2b: this is a POST-unify QUERY over the absorption event trail.  `unify`
-- merges an intrinsic atom into the shared open tail (both-open arm, runs no
-- effectLeakCheck), after which effrowLabels can no longer see it; the trail
-- records that merge.  So: snapshot the declared AND body arrow rows + MARK the
-- trail BEFORE the unify, run the unify (which RECORDS each absorbed atom against
-- the surviving tail), then query the window per arrow.  An OPEN body arrow's
-- absorbed atom is recovered from the trail; a CLOSED body arrow (a type
-- ANNOTATION or a point-free body) is checked directionally by `unifyInto` at the
-- seam itself — see launderEscapeFromLog.
--
-- Where the two kinds differ:
--   * an impl body checks its forcing row before the launder window opens and
--     closes the effect contract before the launder query; a default body checks
--     its forcing row inside the unify's error region and closes the contract
--     last.  Either order moves absorption events and diagnostics relative to the
--     other kind's, so each keeps its own.
--   * D-3 (#1095): an impl body reads its index-only effect variables BEFORE the
--     unify closes the declared-pure arrows.
--   * cascade gates S2/S3 (`gatesBodyCascade`), on a default body: when inferring
--     the body detected an error, the unify and the launder query are skipped, so
--     one root cause is not reported again as the shape mismatch it induces at the
--     method boundary.  The unify runs with `dcMethodMismatch = Some mname`, so
--     a leaf TypeMismatch reports the specialized line `Method '<mname>': expected
--     type <e> but got <a>` (dims C and J).  When that unify detects a mismatch,
--     the body's own added impl obligations are TRUNCATED back to the pre-body
--     snapshot: the method's type is already known wrong, so its body's induced
--     obligations (e.g. `(5 : Bool)` ⇒ `Num Bool`) are cascade victims.  All three
--     read `ModuleCells.mcCells.errorsDetected` via `erredDuring`, never the diagnostic list
--     (issue 1146).  The leaf mismatch the unify region expects is pushed
--     NON-deduped: `dcMethodMismatch` is `Some mname` across the whole region,
--     which selects typeMismatchReport's first arm.
checkMethodBodyAgainst : TcEnv ->
  IfaceRef ->
  MethodBodyKind ->
  String ->
  Ty ->
  List (String, List Kind) ->
  MethodBodyInstance ->
  (Map Int Unit, Map Int Unit) ->
  Option Loc ->
  List Pat ->
  Expr ->
  MethodBodyCheck
checkMethodBodyAgainst env iface kind mname mty gscope inst contract loc pats body =
  let oblSnapshot = wSnapshot env.teDyn.dcModule.mcCells.implObls
  let indexOnly = match kind
    ImplBody _ => indexOnlyEffVars env.teDyn.dcModule gscope mty
    DefaultBody => []
  -- A graded impl body collects the calls that run an effect variable, so the
  -- effect checks below can name the call rather than the whole body.
  let sites = if isEmptyL indexOnly then None else Some (Ref [])
  let envSites = { env | teDyn = { env.teDyn | dcPerformSites = sites } }
  let (inferErred, inferred) = erredDuring env.teDyn.dcModule (_ =>
    inferBindingChecked
      False
      envSites
      (Some (normalize inst.mbiExpected))
      pats
      body)
  let actual = fst inferred
  let check =
    if inferErred && gatesBodyCascade kind then
      MethodBodyCheck {
        mbcLaunderFlagged = False,
        mbcEagerIndexed = [],
        mbcPerformedAt = None,
      }
    else
      let _ = match kind
        ImplBody _ =>
          rowInto
            env.teDyn
            True
            (inst.mbiCheckedForce ())
            (effrowNorm (snd inferred))
        DefaultBody => ()
      let launderMark = wMark env.teDyn.dcModule.mcCells.absorptions
      let declArrows = allArrowEffs inst.mbiExpected
      let actualArrows = allArrowEffs actual
      let eager =
        eagerIndexOnlyVars
          indexOnly
          inst.mbiEffVars
          actualArrows
          inst.mbiExpected
          actual
      -- A body that runs, at call time, a variable its signature charges only in
      -- a result index is judged against its signature at the call that ran it.
      let performedAt =
        if isEmptyL eager then None else performSiteIn sites actual
      let bodyDyn = match kind
        DefaultBody => { env.teDyn | dcMethodMismatch = Some mname }
        ImplBody _ => env.teDyn
      -- The body's type meets the signature at the value the body returns.
      let valueDyn = dynAtIfSome (valueSpanLoc body) bodyDyn
      let unifyDyn = match kind
        DefaultBody => valueDyn
        ImplBody _ => dynAtIfSome performedAt valueDyn
      let unifyErred =
        fst
          (erredDuring env.teDyn.dcModule (_ =>
            let _ = match kind
              DefaultBody =>
                rowInto
                  bodyDyn
                  True
                  (inst.mbiCheckedForce ())
                  (effrowNorm (snd inferred))
              ImplBody _ => ()
            unifyInto unifyDyn True inst.mbiExpected actual))
      let _ = match kind
        DefaultBody => ()
        ImplBody _ => finishEffectContract env.teDyn contract
      let escaping =
        launderEscapeFromLog
          env.teDyn.dcModule.mcGraph
          declArrows
          actualArrows
          (wWindow env.teDyn.dcModule.mcCells.absorptions launderMark)
      -- `.irName`: a DIAGNOSTIC wants the spelling, not the identity (#1446 P1's
      -- rule — `irName` is kept alongside `irOrigin` for exactly this).
      let _ = match escaping
        [] => ()
        _ =>
          pushTypeErrorOnceAt
            env.teDyn.dcModule
            "T-EFFECT-LAUNDER"
            loc
            (methodBodyLaunderMsg kind iface.irName mname escaping)
      let _ =
        if unifyErred && gatesBodyCascade kind then
          wRestore env.teDyn.dcModule.mcCells.implObls oblSnapshot
      MethodBodyCheck {
        mbcLaunderFlagged = isNonEmptyL escaping,
        mbcEagerIndexed = eager,
        mbcPerformedAt = performedAt,
      }
  let _ = match kind
    DefaultBody => finishEffectContract env.teDyn contract
    ImplBody _ => ()
  check

-- Publish the method-level dictionary givens after body inference, so each
-- constraint var's id is its SURVIVING (normalized) union-find root — the same id
-- an in-body return-position site (`pure []`, `empty`, `++`) normalizes to
-- (activeDictVarOf reads that root).  Registering BEFORE inference recorded the
-- pre-unification id, the in-body site could become the surviving root instead,
-- and the route fell to RNone.  Mirrors registerImplRequires's ordering.
--   * the scalar slots: an impl body registers them by name over its tv map
--     (registerImplMethodDicts), a default body by slot id over its instantiation
--     (registerMethodDictSlots);
--   * the predicate-keyed twin, from this very instantiation, into the lexical
--     given registry before route resolution — a complete request miss is
--     terminal, so this carrier is not optional.  `inferMethodBody` publishes it
--     earlier, once the body's goals are settled (`publishMethodPredGivens`);
--   * a default body's receiver: the body answers for whichever instance inherits
--     it, so a sibling or superclass call inside it is discharged by the
--     receiver's evidence (directly, or projected onto a super) instead of being
--     left for an engine to select.  The binder is no parameter of the body — see
--     `defaultReceiverDict`.
registerMethodBodyGivens : GraphCtx ->
  IfaceRef ->
  MethodBodyKind ->
  List String ->
  Ty ->
  MethodBodyInstance ->
  ScopeId ->
  Unit
registerMethodBodyGivens gctx iface kind params mty inst scope =
  let _ = match kind
    ImplBody _ =>
      registerImplMethodDicts gctx scope params mty inst.mbiNamedVars
    DefaultBody =>
      registerMethodDictSlots gctx scope 0 inst.mbiDictSlots inst.mbiTypeSubst
  match kind
    DefaultBody =>
      let receiverArgs =
        map
          (tp => optionOr (TRigid tp) (lookupAssoc tp inst.mbiNamedVars))
          params
      registerFunPredGiven
        gctx
        PredicateSlot {
          psIface = iface,
          psArgs = PSArgsKnown receiverArgs,
          psBoundIds = dedupI (flatMap monoTyvarIds receiverArgs),
        }
        (Scopes.binderAt scope defaultReceiverOrdinal)
    ImplBody _ => ()

-- G4: mark binop sites recorded while inferring this impl body so resolveBinopSite
-- routes their element dict (RDict) — and ONLY theirs, not top-level operators.

-- #803 (S0, silent wrongness): the impl-body effect-LAUNDER check.  Sound rule, per
-- arrow of the method's DECLARED type down to its final return:
--
--     ∀ arrow i ≤ methodArity.  atoms(body_arrow_effect_i) ⊆ atoms(declared_effect_i)
--
-- i.e. the impl's concrete latent atoms at each arrow must be bounded by the method's
-- declared concrete atoms at that same arrow (the general form of
-- `body_latent ⊆ decl(φ) ∪ argContributable`).  Argument-contributed effects are free
-- and exact: at impl-check every parameter is still a fresh variable, so an effect the
-- body performs by USING an argument (applying a callback, running a row-kinded `Async e`
-- arg) appears as that VARIABLE — never a concrete atom — at every arrow.  Hence the
-- body's *concrete atoms* on any arrow are exactly the INTRINSIC effects, and per-arrow
-- `atomsEscape` against the declared row (IO-expanded via the same expandIoInBound the
-- binding-boundary check uses) is precisely the laundered set — a variable is
-- caller-visible and cannot lie, so only a concrete atom can launder.
--
-- #839 2b: sourced from the absorption event trail (increment 2a), POST-unify, rather
-- than arrowLaunderEscape's pre-unify walk over [expected]/[actual] arrow rows.  The
-- pre-unify walk existed only because `unify` then merges an intrinsic atom into the
-- shared open tail (both-open arm, no effectLeakCheck), after which effrowLabels can no
-- longer see it; 2a records that merge, so a post-unify query recovers it.
--
-- [declArrows]/[actualArrows] = the declared method type's and the inferred body's arrow
-- effect rows, BOTH captured PRE-unify and zipped (same spine, bounded at the shorter —
-- the methodArity bound arrowLaunderEscape had).  [evts] = the events `unify expected
-- actual` recorded in this body's trail window.  The per-arrow residual is
-- `atomsEscape (actual atoms) (declared WRITTEN atoms)`, recovered by two DISJOINT routes
-- keyed on whether the ACTUAL arrow is OPEN or CLOSED:
--
--  * OPEN actual arrow (the common inferred case): an intrinsic atom is ABSORBED at unify
--    (both-open / same-tail arm merges it into a shared tail, no effectLeakCheck), so
--    effrowLabels can no longer see it — recover it from the TRAIL.  Resolve the declared
--    arrow's tail LIVE (post-unify the fresh cell has ELinked into a shared v3 — a record-
--    time id names the old cell, not its current representative), gather atoms absorbed into that same
--    live tail (the per-cell key — risk 3, recovering arrowLaunderEscape's which-arrow
--    precision), and `atomsEscape` them against the declared row.  For a CLOSED declared
--    arrow met by an OPEN actual, the guarded closed~open arm already fired effectLeakCheck
--    (T-EFFECT-LEAK) during the SAME unify, so the trail route yields nothing and the leak
--    line stands alone (the pre-unify walk only ever DOUBLE-reported there).
--    WHY the trail equals the walk here: the both-open arm records the SYMMETRIC diff
--    (actual\declared ++ declared\actual) against the shared v3 both tails link to;
--    `atomsEscape absorbed declared` drops the declared\actual side (⊆ declared) and any
--    IO-covered atom, leaving actual \ expandIo(declared) — arrowLaunderEscape's residual.
--
--  * CLOSED actual arrow (a body type ANNOTATION — `(f : Unit -> <Stdout> Unit)` — or
--    a point-free body): nothing to recover here.  The seam's `unifyInto` checks a
--    closed~closed pair directionally as it meets it (T-EFFECT-LEAK when the actual's
--    atoms escape the declared row, nothing when the impl is PURER than declared), so
--    the query yields nothing for it and the one report stands alone.  (An annotated
--    closed actual met by an OPEN declared arrow lands in the open~closed arm and
--    reports the same launder the #816 effect-var rigidity check would — one report, via
--    launderFlagged suppression — matching the pre-unify walk.)
launderEscapeFromLog : GraphCtx ->
  List EffRow ->
  List EffRow ->
  List AbsorptionEvent ->
  List Atom
launderEscapeFromLog gctx [] _ _ = []
launderEscapeFromLog gctx _ [] _ = []
launderEscapeFromLog gctx (der :: dRest) (aer :: aRest) evts =
  let here = match aer
    EffRow _ None => []
    EffRow _ (Some _) => launderOpenActualArrow gctx der evts
  here ++ launderEscapeFromLog gctx dRest aRest evts

-- OPEN actual arrow: recover the absorbed launder atom from the trail, keyed on an OPEN
-- declared arrow's live tail; a CLOSED declared arrow's leak was already reported by the
-- closed~open arm's effectLeakCheck during the unify, so yield nothing.
launderOpenActualArrow : GraphCtx -> EffRow -> List AbsorptionEvent -> List Atom
launderOpenActualArrow gctx (EffRow declAtoms (Some cell)) evts =
  let tid = liveTailId cell
  if tid == 0 - 1 then
    []
  else
    atomsEscape gctx (atomsAbsorbedInto tid evts) declAtoms
launderOpenActualArrow gctx (EffRow _ None) _ = []

-- the concrete atoms the window recorded as absorbed into the live tail [tid]
-- (resolving each event's stored cell live, per risk 2).
atomsAbsorbedInto : Int -> List AbsorptionEvent -> List Atom
atomsAbsorbedInto _ [] = []
atomsAbsorbedInto tid (ev :: rest) =
  if liveTailId ev.cell == tid then
    ev.atom :: atomsAbsorbedInto tid rest
  else
    atomsAbsorbedInto tid rest

-- resolve an absorbing tail CELL to its live effvar id (post-unify the cell has ELinked
-- into a shared tail); -1 for a cell that resolved to a CLOSED row (no live tail).  Same
-- idiom as effVarTailIds.
liveTailId : Ref Effvar -> Int
liveTailId cell = match effrowNorm (EffRow [] (Some cell))
  EffRow _ (Some t) => effvarId t
  EffRow _ None => 0 - 1

-- the first source span inside an impl-method body, for locating T-EFFECT-LAUNDER
-- at the offending body rather than the shared interface signature.  Peels the
-- let-chain a `let _ = putStr …; body` body desugars to (a partial mirror of
-- resolve.mdk's firstExprLoc, which is not exported); falls back at the call site
-- to the method-signature loc when the body carries no span.
implBodyLoc : Expr -> Option Loc
implBodyLoc (ELoc l _) = Some l
implBodyLoc (ELam _ b) = implBodyLoc b
implBodyLoc (ELet _ _ _ e1 e2) = orElseLoc (implBodyLoc e1) (implBodyLoc e2)
implBodyLoc (ELetGroup _ b) = implBodyLoc b
implBodyLoc _ = None

-- #814 (S0): W3 method-scheme fidelity — the post-unify rigidity check, type-variable
-- and constraint axes (the effect axis is `checkMethodEffVarRigidity`).  The method
-- scheme's non-head quantifiers are re-instantiated freshly by every caller, so the
-- body may not constrain them.  Having unified the body against fresh flexible vars,
-- rigidity holds iff each survived untouched: every [extraMap] type var still
-- normalizes to a TVar (not pinned to a constructed type), and all their ids are
-- pairwise distinct and disjoint from the impl-head vars' ids (not identified with
-- each other or with a head variable).
-- Union-find bindings are monotone, so a var unbound-and-distinct AFTER unify
-- was never constrained DURING it: this is observationally the skolem check.
-- All lists here are the handful of quantified vars of one method signature.
-- One core for both kinds of method body; the per-kind values are parameters:
--   * [subject]      implSubject vs defaultSubject.
--   * [headMonos]    the instance-head monos of an impl body; a default body has no
--                    instance head and passes [], so the head-disjointness disjunct
--                    is vacuous (anyContainsI _ [] = False).
--   * [extraMap]     the survivor set: an impl body's non-head vars, every
--                    signature var of a default body (`defaultSurvivorMap`).
--   * [ownTyparams]  [] on an impl body, the interface typarams on a default body:
--                    a receiver-typaram obligation is self-entailed there.
checkMethodRigidityCore : ModuleCtx ->
  String ->
  String ->
  Ty ->
  List Mono ->
  List (String, Mono) ->
  List String ->
  List UObligation ->
  List (IfaceRef, List Mono, Option Loc) ->
  Option Loc ->
  Unit
checkMethodRigidityCore mctx subject iface mty headMonos extraMap ownTyparams addedObls addedCallObls loc =
  let pinned = map fst (filterList (p => not (isUnboundTvar (snd p))) extraMap)
  let _ =
    if isNonEmptyL pinned then
      pushTypeErrorOnceAt
        mctx
        "T-IMPL-TOO-SPECIFIC"
        loc
        (pinsTyvarMsg subject mty pinned)
    else
      let survivors = sigTvarIds (map snd extraMap)
      if hasDupI survivors
        || anyContainsI survivors (flatMap monoTyvarIds headMonos) then
        pushTypeErrorOnceAt
          mctx
          "T-IMPL-TOO-SPECIFIC"
          loc
          (collapsesTyvarsMsg subject mty)
  let _ =
    checkSurvivorObligations
      mctx
      subject
      iface
      ownTyparams
      mty
      extraMap
      addedObls
      loc
  checkSurvivorCallObligations
    mctx
    subject
    iface
    ownTyparams
    mty
    extraMap
    addedCallObls
    loc

-- The effect axis of W3 rigidity, one call shape for both kinds of method body:
-- every [effVars] effect var's row carries no concrete atom beyond what the
-- declared row at EVERY occurrence of that var in [mty] already covers
-- (IO-expanded, as the §5 escape check) — an atom unification poured into the var
-- from a position whose declared row lacks it is an intrinsic effect the caller
-- erases by instantiating the var to <> — and the vars' tails are pairwise
-- distinct; see checkImplEffVarRigidity.
-- #817 carve-out RETIRED (#823): a method effect variable may no longer alias an
-- INSTANCE-HEAD row parameter (`impl Mappable (Async e)`, whose `Suspend` arm
-- stored the callback and forced method `e'` ~ head `e`, charging the effect at
-- build time and performing it at force time).  With the `Deferred*` family the
-- head is the bare constructor and the callback row rides the index, so the
-- identification is never needed; the type-variable half never had the exception.
-- A default body has no instance head and passes [] for [headMonos].
checkMethodEffVarRigidity : ModuleCtx ->
  String ->
  List Mono ->
  List (String, List Kind) ->
  Ty ->
  List (String, Ref Effvar) ->
  Bool ->
  List String ->
  Option Loc ->
  Unit
checkMethodEffVarRigidity mctx subject headMonos gscope mty effVars launderFlagged eager loc =
  let _ =
    if anyContainsI
      (effVarTailIds effVars)
      (flatMap monoIndexEffvarIds headMonos) then
      pushTypeErrorOnceAt
        mctx
        "T-IMPL-TOO-SPECIFIC"
        loc
        (aliasesHeadRowMsg subject mty)
  checkImplEffVarRigidity
    mctx
    subject
    gscope
    mty
    effVars
    launderFlagged
    eager
    loc

-- A default body's survivor set: [tvs] is sigToSchemeTvs' name→scheme-var map and
-- [subst] instantiateTracked's scheme-var-id→fresh-mono subst; crossing them
-- recovers each declared name's post-unify mono, the shape an impl body's
-- non-head tv map already has.
defaultSurvivorMap : List (String, Mono) ->
  List (Int, Mono) ->
  List (String, Mono)
defaultSurvivorMap [] _ = []
defaultSurvivorMap ((name, m) :: rest) subst =
  match lookupAssocI (monoTyvarId m) subst
    Some fm => (name, fm) :: defaultSurvivorMap rest subst
    None => defaultSurvivorMap rest subst

-- #563's narrow instance-head prerequisite check. This reads the SAME protected
-- root set that body-local Num defaulting consumes, then asks only whether a root
-- carried by [implTvMap] has declared evidence in this impl's `requires`. Pinning is
-- `checkImplHeadRigidity`'s, and every other predicate on a head variable is
-- `checkImplHeadPrerequisites`'s, which renders a Num residual with this same
-- message, so the two report it once.
checkImplHeadNumObligations : ModuleCtx ->
  String ->
  List (String, Mono) ->
  List Require ->
  OrdMap Unit ->
  List UObligation ->
  Unit
checkImplHeadNumObligations mctx _ _ _ _ [] = ()
checkImplHeadNumObligations mctx subject implTvMap reqs survivingIds (o :: rest) =
  let _ =
    checkImplHeadNumIds
      mctx
      subject
      implTvMap
      reqs
      survivingIds
      o.loc
      (dedupI (numObligIds o))
  checkImplHeadNumObligations mctx subject implTvMap reqs survivingIds rest

checkImplHeadNumIds : ModuleCtx ->
  String ->
  List (String, Mono) ->
  List Require ->
  OrdMap Unit ->
  Option Loc ->
  List Int ->
  Unit
checkImplHeadNumIds mctx _ _ _ _ _ [] = ()
checkImplHeadNumIds mctx subject implTvMap reqs survivingIds loc (id :: rest) =
  let _ = match survivorNameOfId id implTvMap
    Some vname =>
      if omHasKey (intToString id) survivingIds
        && not (implRequiresRoot mctx "Num" id implTvMap reqs) then
        pushTypeErrorOnceAt
          mctx
          "T-IMPL-MISSING-REQUIRES"
          loc
          (undeclaredImplPrerequisiteMsg subject "Num" vname)
    None => ()
  checkImplHeadNumIds mctx subject implTvMap reqs survivingIds loc rest

implRequiresRoot : ModuleCtx ->
  String ->
  Int ->
  List (String, Mono) ->
  List Require ->
  Bool
implRequiresRoot mctx _ _ _ [] = False
implRequiresRoot mctx wanted id implTvMap ((Require { requireHead = iface, requireArgs = args, ... }) :: rest) =
  contains wanted (ifaceSelfAndSupers mctx iface)
      && requireArgsAreRoot id implTvMap args
    || implRequiresRoot mctx wanted id implTvMap rest

requireArgsAreRoot : Int -> List (String, Mono) -> List Ty -> Bool
requireArgsAreRoot id implTvMap [TyVar name] = match lookupAssoc name implTvMap
  Some m => match normalize m
    TVar cell => tyvarId cell == id
    _ => False
  None => False
requireArgsAreRoot _ _ _ = False

implHeadVarRoots : List (String, Mono) -> List (String, HeadVarRoot)
implHeadVarRoots implTvMap =
  flatMap
    (p => match headVarRootOf (snd p)
      Some root => [(fst p, root)]
      None => [])
    implTvMap

-- The head variables that are still type variables, by tyvar root.
implHeadTypeVarRoots : List (String, Mono) -> List (String, Int)
implHeadTypeVarRoots implTvMap =
  flatMap
    (p => match snd p
      TypeVarRoot id => [(fst p, id)]
      RowVarRoot _ => [])
    (implHeadVarRoots implTvMap)

-- The head variables this body narrowed: each one that was a variable before the
-- body and is now fixed to a constructed type or a row with atoms or a closed
-- tail, or now shares its root with another
-- head variable that was distinct before.  A variable an earlier sibling body
-- narrowed is not in [before], so it is reported once, by that body.
headVarsNarrowedBy : List (String, HeadVarRoot) ->
  List (String, Mono) ->
  List String
headVarsNarrowedBy before implTvMap =
  let after = implHeadVarRoots implTvMap
  map fst (filterList (headVarNarrowed before after) before)

headVarNarrowed : List (String, HeadVarRoot) ->
  List (String, HeadVarRoot) ->
  (String, HeadVarRoot) ->
  Bool
headVarNarrowed before after (name, root0) = match lookupAssoc name after
  None => True
  Some root =>
    anyList
      (other =>
        snd other /= root0 && lookupAssoc (fst other) after == Some root)
      before

-- A body that fixes a head variable holds only for the narrower head it implies,
-- yet the instance is registered for the written one, so a receiver the written
-- head admits and the body does not reaches the body with a value of another type.
checkImplHeadRigidity : ModuleCtx ->
  String ->
  String ->
  ImplBodySite ->
  List (String, HeadVarRoot) ->
  Option Loc ->
  Unit
checkImplHeadRigidity mctx subject iface site before loc =
  match headVarsNarrowedBy before site.ibImplTvMap
    [] => ()
    narrowed =>
      pushTypeErrorOnceAt
        mctx
        "T-IMPL-TOO-SPECIFIC"
        loc
        (narrowsImplHeadMsg subject narrowed (narrowedImplHead iface site))

-- The head the body actually supports, each still-free head variable under its
-- written name.
narrowedImplHead : String -> ImplBodySite -> String
narrowedImplHead iface site =
  let named = map (p => (snd p, fst p)) (implHeadTypeVarRoots site.ibImplTvMap)
  joinWith
    " "
    ("impl" :: iface :: ppEach (Ref named) (Ref 0) 3 site.ibHeadMonos)

-- The constraint axis of W3-inst: every predicate this body leaves on head variables
-- must be given by the impl.  Each goal mentioning a head variable is reduced through
-- the instances (§3 `inst`), a goal the impl gives ending the reduction (§3 `assum`
-- before `inst`), and a residual over head variables alone that no given answers is
-- reported at the goal's site.  The givens are the impl's own head, its `requires`
-- with their superinterfaces, and the method signature's own `=>` context.
-- A residual that an instance answers only by binding a head variable is reported
-- too, whatever other variables it mentions.  A goal no instance can answer even
-- with the head variables free is left to the obligation gate's no-impl verdict only
-- when the gate decides it (`allConcreteHeads`, as `uOblIsDecidableNow` asks).  A
-- vector the gate defers is a residual here: the head variable it waits on is rigid
-- for the body and never binds, so no later reader judges it.
checkImplHeadPrerequisites : ModuleCtx ->
  String ->
  IfaceRef ->
  ImplBodySite ->
  List (String, Mono) ->
  Ty ->
  List UObligation ->
  List (IfaceRef, List Mono, Option Loc) ->
  Unit
checkImplHeadPrerequisites mctx subject iface site methodTvs mty addedObls addedCallObls =
  match implHeadTypeVarRoots site.ibImplTvMap
    [] => ()
    roots =>
      let givens = implBodyGivens mctx iface site methodTvs mty
      let goals =
        flatMap (oblPredOf mctx.mcGraph) addedObls
          ++ flatMap callPredOf addedCallObls
      fold
        (_ g => checkImplHeadGoal (siteFor mctx) subject roots givens g)
        ()
        goals

checkImplHeadGoal : SiteCtx ->
  String ->
  List (String, Int) ->
  List PredicateSlot ->
  (IfaceRef, List Mono, Option Loc) ->
  Unit
checkImplHeadGoal sx subject roots givens (iface, ds, loc) =
  let args = map normalize ds
  let rootIds = map snd roots
  if any (i => elem i rootIds) (flatMap monoUnboundIds args) then
    let headIds = omFromNames (map (r => intToString (snd r)) roots) omEmpty
    let leaves =
      implGoalResiduals
        { sx | sxSite = loc }
        (reqWalkStart ())
        headIds
        givens
        iface
        args
    fold
      (_ leaf => reportImplHeadResidual sx.sxModule subject roots loc leaf)
      ()
      leaves

-- The impl's own head is given as written: its superinterfaces are separate
-- instances whose own contexts must hold, so they are not given with it.
implBodyGivens : ModuleCtx ->
  IfaceRef ->
  ImplBodySite ->
  List (String, Mono) ->
  Ty ->
  List PredicateSlot
implBodyGivens mctx iface site methodTvs mty =
  let declared =
    map (requirePredicateSlot mctx site.ibImplTvMap) site.ibRequires
      ++ map (constraintPredicateSlot mctx methodTvs) (sigConstraintsOf mty)
  knownPredicateSlot iface site.ibHeadMonos
    :: declared
      ++ flatMap
        (s => map fst (predicateSlotKnownSupers mctx.mcGraph s))
        declared

requirePredicateSlot : ModuleCtx ->
  List (String, Mono) ->
  Require ->
  PredicateSlot
requirePredicateSlot mctx implTvMap (Require { requireHead = h, requireArgs = rargs, requireOrigin = o }) =
  knownPredicateSlot
    IfaceRef { irName = h, irOrigin = o }
    (map (fromAstType mctx implTvMap) rargs)

constraintPredicateSlot : ModuleCtx ->
  List (String, Mono) ->
  Constraint ->
  PredicateSlot
constraintPredicateSlot mctx tvs (Constraint { constraintHead = h, constraintArgs = cargs, constraintOrigin = o }) =
  knownPredicateSlot
    IfaceRef { irName = h, irOrigin = o }
    (map (fromAstType mctx tvs) cargs)

knownPredicateSlot : IfaceRef -> List Mono -> PredicateSlot
knownPredicateSlot iface args = PredicateSlot {
  psIface = iface,
  psArgs = PSArgsKnown args,
  psBoundIds = dedupI (flatMap monoTyvarIds args),
}

-- A residual over head variables alone names the `requires` to add.  One that also
-- mentions a variable of the body's own has no `requires` to name, so it is
-- reported when an instance answers it only by fixing a head variable, and as
-- `T-NO-IMPL` when no instance unifies with it at all: the head variable is rigid,
-- so no later binding can give it an instance.
reportImplHeadResidual : ModuleCtx ->
  String ->
  List (String, Int) ->
  Option Loc ->
  (IfaceRef, List Mono) ->
  Unit
reportImplHeadResidual mctx subject roots loc (iface, args) =
  let ids = flatMap monoUnboundIds args
  let headIds = map snd roots
  let named = map (p => (snd p, fst p)) roots
  let rendered = ppEach (Ref named) (Ref 0) 3 args
  let pred = "\{iface.irName} \{joinWith " " rendered}"
  if isEmptyL ids || not (anyList (i => containsI i headIds) ids) then
    ()
  else if allList (i => containsI i headIds) ids then
    let msg = match (map normalize args, rendered)
      ([TVar _], [vname]) =>
        undeclaredImplPrerequisiteMsg subject iface.irName vname
      _ => undeclaredImplPredicateMsg subject pred
    pushTypeErrorOnceAt mctx "T-IMPL-MISSING-REQUIRES" loc msg
  else if answeredOnlyByBindingHead
    mctx
    (omFromNames (map (r => intToString (snd r)) roots) omEmpty)
    iface
    args then
    let fixed =
      dedup (flatMap (r => if containsI (snd r) ids then [fst r] else []) roots)
    pushTypeErrorOnceAt
      mctx
      "T-IMPL-MISSING-REQUIRES"
      loc
      (implGoalFixesHeadMsg subject pred fixed)
  else if isEmptyL
    (goalCandidates mctx omEmpty args (goalRows mctx iface args)) then
    reportUndeterminedNoImpl mctx iface args loc

-- the CALL-obligation half of the constraint axis: recordCallObligations pushes
-- (iface, [constraint-var mono], loc) for each dict slot a constrained CALLEE
-- discharges at a call site, so the monos here are the dispatch monos directly
-- (no declared-type walk needed).  Same rule as checkSurvivorObligations: a
-- predicate landing on a method-scheme var must be entailed by a declared
-- method-level constraint under requires-closure.
checkSurvivorCallObligations : ModuleCtx ->
  String ->
  String ->
  List String ->
  Ty ->
  List (String, Mono) ->
  List (IfaceRef, List Mono, Option Loc) ->
  Option Loc ->
  Unit
checkSurvivorCallObligations mctx _ _ _ _ _ [] _ = ()
checkSurvivorCallObligations mctx subject ownIface ownTyparams mty extraMap ((oiface, monos, _) :: rest) loc =
  let _ =
    checkSurvivorDispatchMonos
      mctx
      subject
      ownIface
      ownTyparams
      mty
      extraMap
      oiface.irName
      monos
      loc
  checkSurvivorCallObligations
    mctx
    subject
    ownIface
    ownTyparams
    mty
    extraMap
    rest
    loc

-- any member of [xs] present in [ys] (tiny per-method var lists)
anyContainsI : List Int -> List Int -> Bool
anyContainsI [] _ = False
anyContainsI (x :: xs) ys = containsI x ys || anyContainsI xs ys

-- the effect half of the rigidity check: atom containment per declared
-- occurrence, then tail distinctness among the METHOD's own effect vars.
-- A method effect var aliasing an INSTANCE-HEAD row parameter is REJECTED, not
-- admitted: `checkMethodRigidityCore` pushes `T-IMPL-TOO-SPECIFIC` when a
-- method effect var's tail is among `monoIndexEffvarIds` of the head monos,
-- before it calls this function.  What used to need the exception was Async
-- v1's `impl Mappable (Async e)`, whose `Suspend` arm stored the callback and
-- so forced method `e'` ~ head `e`; with the `Deferred*` family the head is the
-- bare constructor and the callback row rides the index, so no legal impl needs
-- that identification.  This function's own dup set is therefore the METHOD's
-- own effect vars only — impl-head row tails never enter it.  (The TYPE-var
-- half never had an exception either: a method type var may never alias an
-- impl-head type var.)
checkImplEffVarRigidity : ModuleCtx ->
  String ->
  List (String, List Kind) ->
  Ty ->
  List (String, Ref Effvar) ->
  Bool ->
  List String ->
  Option Loc ->
  Unit
checkImplEffVarRigidity mctx subject scope mty effMap launderFlagged eager loc =
  let occs =
    effVarOccAtoms mctx.mcGraph mty
      ++ map (n => (n, [])) (rowArgNamesIn mctx scope mty)
  let _ =
    if launderFlagged then () else checkEffVarAtoms mctx subject occs effMap loc
  let _ = checkIndexOnlyEffVarsOpen mctx subject effMap loc eager
  -- ⚠️ DEFERRED-PERFORMANCE residual (round-2 break 4; tracked, NOT enforced):
  -- a method effect var forced CLOSED post-unify is in truth a PIN — an impl
  -- that applies its <e>-callback inside a value whose declared row is pure
  -- (`act d k = (u => k ())` under `-> <e> (Unit -> Unit)`) closes e := <>,
  -- and a caller's effectful callback then runs inside a pure-typed thunk.
  -- Rejecting it here is CORRECT but outlaws the compiler's own Parser monad
  -- (`impl Mappable Parser` stores the callback under Parser's pure arrows —
  -- the identical shape, latent because the compiler only passes pure
  -- callbacks) and every pure-container deferred-application impl with it.
  -- Like #817, the honest result type needs grading (`Parser e a`, #820), so
  -- the channel is admitted for now and owned by #825 (pinned).
  if hasDupI (effVarTailIds effMap) then
    pushTypeErrorOnceAt
      mctx
      "T-IMPL-TOO-SPECIFIC"
      loc
      (collapsesEffvarsMsg subject mty)

-- ── D-3 (#1095): a result-INDEX occurrence is a PROMISE, not a CHARGE ──────
-- `checkArgEffVarCoverage` lets a row-kinded occurrence in the method's RESULT
-- (`f e b`) discharge the argument-only obligation the callback's `<e>` raises.
-- That is right for the DECLARATION — `f e b` says "performs <e> when forced"
-- — but it says nothing about the CALL, so an impl that APPLIES its callback
-- (`gmap g (Done a) = Done (g a)`) performs <e> at call time on an arrow the
-- signature declares pure, and nothing charges it: `check` is green and a
-- value typed `Int` prints (both engines).  The declaration cannot see it
-- (the caller sees only the index) and the #803 per-arrow bound cannot see it
-- (applying the callback contributes the VARIABLE `e`, never an atom).  The
-- seam with the information intact is the IMPL BODY: under a signature whose
-- only non-argument occurrences of `e` are indices, the body must leave `e`
-- OPEN.  Performing it — or forcing an `e`-indexed argument — meets the
-- declared-pure arrow and CLOSES `e := <>`, which is exactly the pin
-- `effVarTailIds` documents as "the safe direction" for a var the method's
-- own arrow charges, and is a launder for one it does not.  Storing the
-- callback (`Susp (u => g a)`) unifies `e` with the container's own thunk row
-- and leaves it open, so the deferred arm the spec requires stays legal.
--
-- Scoped to INDEX-ONLY variables on purpose: a var the method's own arrow
-- charges (`map : (a -> <e> b) -> f a -> <e> f b`) may still close — the
-- compiler's own `impl Mappable Parser` stores its callback under a pure
-- arrow and does, which is #825's channel, out of scope here and pinned.
-- ⚠️ CLOSED ALONE IS NOT THE SIGNAL.  An index-only variable can also close
-- through an INDEX unification with no effect performed: `deferAp mf ma =
-- deferThen mf (g => deferMap g ma)` maps a PURE `g` (from `f e (a -> b)`,
-- whose arrow is `<>`), so `deferMap g ma : f <> b` meets the result `f e b`
-- and pins `e := <>` — honest, and sound (the value built carries `mf`'s real
-- row).  What distinguishes the eager arm is that the body PERFORMS `e` on one
-- of the method's own arrows.  So [eager] is computed at the impl seam from the
-- body's arrow rows BEFORE they are unified with the declared (pure) arrows —
-- the same pre-unify snapshot the #803 launder query takes — and only a var in
-- that set is reported here.  (An interface DEFAULT body has no such snapshot
-- available at its rigidity read and passes `[]`: a residual, not a rule.)
checkIndexOnlyEffVarsOpen : ModuleCtx ->
  String ->
  List (String, Ref Effvar) ->
  Option Loc ->
  List String ->
  Unit
checkIndexOnlyEffVarsOpen mctx subject effMap loc eager =
  checkIndexOnlyGo mctx subject effMap loc eager

-- the index-only vars of [mty] that some body arrow row (pre-unify) carries as
-- its tail — i.e. the body performs them at call time.
-- ⚠️ THE BODY'S CELLS ARE NOT THE SIGNATURE'S CELLS.  At the impl seam the
-- clause parameters are inferred fresh (`g : a -> <ρ> b`), and `ρ` is only
-- identified with the declared `<e>` by the final `unify expected actual`.
-- So the pre-unify arrow rows carry `ρ` (or whatever it has been linked to
-- meanwhile), never `e` itself.  [expected]/[actual] are walked in parallel
-- to pair each declared row cell with the actual cell at the same position
-- (`pairRowCells`), and the scan asks whether any of a var's actual
-- counterparts is a tail of some body arrow row.
eagerIndexOnlyVars : List String ->
  List (String, Ref Effvar) ->
  List EffRow ->
  Mono ->
  Mono ->
  List String
eagerIndexOnlyVars [] _ _ _ _ = []
eagerIndexOnlyVars idx effMap actualArrows expected actual =
  let tails = flatMap rowTailId actualArrows
  let pairs = pairRowCells expected actual
  filterList (v => effVarCellPerformed v effMap pairs tails) idx

-- (declared cell id, actual cell id) for every row found at the same
-- structural position of the two types — arrow latent rows and index rows,
-- under applications and arrows.  Ids are read AFTER normalization, so a cell
-- already linked during body inference reports its live representative.
pairRowCells : Mono -> Mono -> List (Int, Int)
pairRowCells d a = match peelQual d
  TFun d1 dr d2 => match peelQual a
    TFun a1 ar a2 => pairRows dr ar ++ pairRowCells d1 a1 ++ pairRowCells d2 a2
    _ => []
  TApp d1 d2 => match peelQual a
    TApp a1 a2 => pairRowCells d1 a1 ++ pairRowCells d2 a2
    _ => []
  TEff dr => match peelQual a
    TEff ar => pairRows dr ar
    _ => []
  _ => []

pairRows : EffRow -> EffRow -> List (Int, Int)
pairRows dr ar = match rowTailId dr
  [did] => map (aid => (did, aid)) (rowTailId ar)
  _ => []

effVarCellPerformed : String ->
  List (String, Ref Effvar) ->
  List (Int, Int) ->
  List Int ->
  Bool
effVarCellPerformed v effMap pairs tails = match lookupAssoc v effMap
  Some cell =>
    -- Compare live representatives, not the stable identity of an earlier
    -- linked cell: pairs/tails were recorded through normalization.
    let dids = rowTailId (EffRow [] (Some cell))
    anyList
      (did =>
        containsI did tails
          || anyList (p => fst p == did && containsI (snd p) tails) pairs)
      dids
  None => False

checkIndexOnlyGo : ModuleCtx ->
  String ->
  List (String, Ref Effvar) ->
  Option Loc ->
  List String ->
  Unit
checkIndexOnlyGo mctx _ _ _ [] = ()
checkIndexOnlyGo mctx subject effMap loc (v :: rest) =
  -- [eager] already holds only the vars the body performed on a method arrow
  -- (`eagerIndexOnlyVars`); whether the cell then closed (the pre-#821 unify)
  -- or the ambient became a join (#821) is not the signal, the performing is.
  let _ =
    pushTypeErrorOnceAt
      mctx
      "T-EFFECT-INDEX-EAGER"
      loc
      (indexEagerMsg subject v)
  checkIndexOnlyGo mctx subject effMap loc rest

-- The earliest collected call that ran a variable now on one of [actual]'s arrows.
performSiteIn : Option (Ref (List (Ref Effvar, Option Loc))) ->
  Mono ->
  Option Loc
performSiteIn None _ = None
performSiteIn (Some sites) actual =
  let tails = flatMap rowTailId (allArrowEffs actual)
  findMap
    (site =>
      if anyList
        (id => containsI id tails)
        (rowTailId (EffRow [] (Some (fst site)))) then
        snd site
      else
        None)
    (reverseL sites.value)

-- the method effect vars that ride an ARGUMENT (a callback row or a row-kinded
-- argument) and occur on NO row the method's own type charges — every
-- non-argument occurrence is a result index.
indexOnlyEffVars : ModuleCtx -> List (String, List Kind) -> Ty -> List String
indexOnlyEffVars mctx scope mty =
  let argNames = dedup (map fst (methodEffArgOccs mctx scope mty))
  let charged = map fst (methodEffChargedOccs mctx.mcGraph mty)
  filterList (v => not (contains v charged)) argNames

-- effect-var occurrences on rows the method's type CHARGES: each spine arrow's
-- own latent row, and every arrow row written inside the final return type.
-- The `effVarOccAtoms` half of `methodEffRetOccs` minus the two INDEX forms —
-- the row-kinded-slot padding (`rowArgAtomsIn`) and a bare row written in a
-- slot (`TyRow`, `Box <Stdout | e> Unit`) — which promise rather than charge.
methodEffChargedOccs : GraphCtx -> Ty -> List (String, List Atom)
methodEffChargedOccs gctx (TyConstrained _ t) = methodEffChargedOccs gctx t
methodEffChargedOccs gctx (TyEffect labels tails t) =
  occsOfTails gctx tails labels ++ methodEffChargedOccs gctx t
methodEffChargedOccs gctx (TyFun _ b) = methodEffChargedOccs gctx b
methodEffChargedOccs gctx t = effVarChargedOccs gctx t

effVarChargedOccs : GraphCtx -> Ty -> List (String, List Atom)
effVarChargedOccs gctx (TyEffect labels tails t) =
  occsOfTails gctx tails labels ++ effVarChargedOccs gctx t
effVarChargedOccs gctx (TyApp a b) =
  effVarChargedOccs gctx a ++ effVarChargedOccs gctx b
effVarChargedOccs gctx (TyFun a b) =
  effVarChargedOccs gctx a ++ effVarChargedOccs gctx b
effVarChargedOccs gctx (TyTuple ts) = flatMap (effVarChargedOccs gctx) ts
effVarChargedOccs gctx (TyConstrained _ t) = effVarChargedOccs gctx t
effVarChargedOccs gctx _ = []

checkEffVarAtoms : ModuleCtx ->
  String ->
  List (String, List Atom) ->
  List (String, Ref Effvar) ->
  Option Loc ->
  Unit
checkEffVarAtoms mctx _ _ [] _ = ()
checkEffVarAtoms mctx subject occs ((n, cell) :: rest) loc =
  let esc =
    effVarOccEscape mctx.mcGraph n (effrowLabels (EffRow [] (Some cell))) occs
  let _ =
    if isNonEmptyL esc then
      pushTypeErrorOnceAt
        mctx
        "T-EFFECT-LAUNDER"
        loc
        (effVarLaunderMsg subject n esc)
  checkEffVarAtoms mctx subject occs rest loc

-- the first occurrence of var [n] whose declared atoms fail to cover
-- [instAtoms]: laundering demands EVERY occurrence cover the instantiation,
-- since the caller reads the var's row at each of them independently.
effVarOccEscape : GraphCtx ->
  String ->
  List Atom ->
  List (String, List Atom) ->
  List Atom
effVarOccEscape gctx _ [] _ = []
effVarOccEscape gctx _ _ [] = []
effVarOccEscape gctx n instAtoms ((m, declAtoms) :: rest) =
  if m == n && isNonEmptyL (atomsEscape gctx instAtoms declAtoms) then
    atomsEscape gctx instAtoms declAtoms
  else
    effVarOccEscape gctx n instAtoms rest

-- (name, written atoms) for each named-tail row occurrence in a method's AST
-- type — every TyEffect node, on the arrow spine or nested (tuples, callback
-- rows, data-arg rows).  Bare row-kinded ctor-arg slots (`Async e a`) carry no
-- written atoms and are contributed by rowArgNames at the call site.
effVarOccAtoms : GraphCtx -> Ty -> List (String, List Atom)
effVarOccAtoms gctx (TyEffect labels tails t) =
  occsOfTails gctx tails labels ++ effVarOccAtoms gctx t
-- A bare row atom (#997) is a named-tail row occurrence exactly like
-- `TyEffect` above, just with no wrapped type. Without this arm, a KRow
-- ctor-arg written as `Box <Stdout | e> Int` was invisible to
-- `checkImplEffVarRigidity`'s coverage set, so the impl-body T-EFFECT-LAUNDER
-- check over-fired ("not sourced from any argument") on an argument that
-- demonstrably DOES declare the atom.
effVarOccAtoms gctx (TyRow labels tails _) = occsOfTails gctx tails labels
effVarOccAtoms gctx (TyApp a b) = effVarOccAtoms gctx a ++ effVarOccAtoms gctx b
effVarOccAtoms gctx (TyFun a b) = effVarOccAtoms gctx a ++ effVarOccAtoms gctx b
effVarOccAtoms gctx (TyTuple ts) = flatMap (effVarOccAtoms gctx) ts
effVarOccAtoms gctx (TyConstrained _ t) = effVarOccAtoms gctx t
effVarOccAtoms gctx _ = []

-- the still-open tail id of each method effect var's row, post-unify (a closed
-- row contributes nothing: closing a var to the empty row performs LESS than
-- any caller instantiation — the safe direction, not a pin).
effVarTailIds : List (String, Ref Effvar) -> List Int
effVarTailIds [] = []
effVarTailIds ((_, cell) :: rest) = match effrowNorm (EffRow [] (Some cell))
  -- #821: a var whose cell became a JOIN is still its own (unidentified)
  -- variable; only a plain single surviving tail counts toward the dup set.
  EffRow _ (Some t) =>
    if isJoinCell t then
      effVarTailIds rest
    else
      effvarId t :: effVarTailIds rest
  EffRow _ None => effVarTailIds rest

methodLevelConstraintMonos : List String ->
  Ty ->
  List (String, Mono) ->
  List Mono
methodLevelConstraintMonos ifaceParams mty tvMap =
  flatMap
    (name => match lookupAssoc name tvMap
      Some m => [m]
      None => [])
    (methodLevelConstraintVarNames ifaceParams mty)

-- #818 (#838 I3): the method-level `=>` constraints, one per slot, in the declaration
-- order methodLevelConstraintVarNames enumerates.  recordMethodLevelObls poses each as
-- its own obligation; the slot's interface identity is the `Constraint` occurrence's
-- resolve stamp (`constraintOrigin`, #1110, P1 #1446).
methodLevelConstraintSlots : List String -> Ty -> List Constraint
methodLevelConstraintSlots typarams (TyConstrained cs t) =
  filterList (constraintIsMethodLevel typarams) cs
    ++ methodLevelConstraintSlots typarams t
methodLevelConstraintSlots typarams (TyEffect _ _ t) =
  methodLevelConstraintSlots typarams t
methodLevelConstraintSlots _ _ = []

-- #818 (#838 I3): strip the leading `=>`/effect wrappers off a method's declared type,
-- leaving the bare function spine so matchTyMono can align it against a constraint-free
-- occurrence mono (mirrors the TyConstrained/TyEffect peel in methodLevelConstraintVarNames).
stripLeadingMethodConstraints : Ty -> Ty
stripLeadingMethodConstraints (TyConstrained _ t) =
  stripLeadingMethodConstraints t
stripLeadingMethodConstraints (TyEffect _ _ t) = stripLeadingMethodConstraints t
stripLeadingMethodConstraints t = t

-- extern declarations become top-level schemes (like interface methods)
--
-- 🚨 #1280: THE STAMPING WALK IS PART OF THIS FUNCTION, NOT OF ITS CALLERS, AND
-- THAT IS THE FIX.  Every other tree that reaches typecheck has already been
-- through `stampTyOrigins` at a driver (`stampGraphTyOrigins` on the module arm,
-- the retired single-program stamping path).
-- `runtimeDecls` was the one tree that reached a `Scheme` without ever entering
-- that walk on EITHER arm, so every `Mono` `fromAstTypeE` built out of an extern's
-- declared type carried `OriginUnresolved` — the SUPPLY half of the dispatch-key
-- blocker recorded at `dispHeadTab`, and the absent head #1279 bridges two
-- distinct identities through.
--
-- The scope is a parameter and not a `List Decl` prelude on purpose: two
-- `List Decl` arguments are positionally interchangeable and `stampTyHead`'s
-- immunity rule makes a wrong first stamp PERMANENT (`stampFlatTyOrigins`'
-- comment in `frontend/resolve.mdk` records that hazard costing a defect once
-- already).  Build it with `externTyOriginScope`, which owns the derivation of
-- WHY one scope is right for this population on both arms.
--
-- ⚠️ `externTyOriginScope []` at a call site is not a shrug: it is the same
-- historical "prelude boundary unknown" answer from that path when its
-- `coreProg0` is `[]` — those callers have already FLATTENED the prelude into the
-- program they check, so the prelude's own `Option`/`Ordering`/`Result`
-- declarations are unstamped on that path too and the two sides stay symmetric.
-- The builtin layer is still supplied there, so it is strictly more identity than
-- before, never a claim the driver cannot justify.
--
-- 🚨 FILTER BEFORE STAMPING, AND THAT ORDER IS PERFORMANCE, NOT STYLE.  The first
-- cut here was `externSchemesGo (stampTyOrigins scope decls)`, which is a no-op
-- difference for `runtimeDecls` (every element IS a `DExtern`) and wrong-shaped at
-- the `checkBodyImpl` call site, where `decls` is the WHOLE MODULE.  Read the
-- chain rather than take this on trust: `stampTyOrigins` is `map
-- (stampDeclTyOrigins scope)`, and `stampDeclTyOrigins` is `mapOriginsInDecl`,
-- i.e. a full `mapTyInDecl` REBUILD of the decl — so that shape reconstructs every
-- declaration in the program and then discards all but the externs, in a stage
-- `compiler/AGENTS.md` calls GC-bound.  Filtering first makes the walk
-- proportional to the externs, which is all this function reads.
--
-- ⚠️ THE MECHANISM ABOVE IS READ OFF THE SOURCE; THE MAGNITUDE WAS NOT MEASURED.
-- No before/after allocation number was taken, so this is a shape argument, not a
-- perf result — do not cite it as one.  It needs no number to be the right shape:
-- rebuilding what you are about to throw away is never the cheaper branch.
externSchemes : ModuleCtx ->
  OrdMap TyConOrigin ->
  List Decl ->
  List (String, Scheme)
externSchemes mctx scope decls =
  let ds = externDecls decls
  -- #2074: THIS function is the stdlib extern CATALOG builder — its eight call
  -- sites all pass `runtimeDecls`, and `userExternSchemes` (below) is the
  -- declaration-site sibling that handles the program under check.  So this is
  -- the one seam where the set of names the emitter's `isAnyExtern` ladder will
  -- answer for is known, and it is recorded here rather than re-derived.  See
  -- `ffiIsBuiltinExternName` for what reads it and why.
  let _ = noteBuiltinExternNames mctx.mcGraph ds
  externSchemesGo mctx (stampTyOrigins scope ds)

-- Union, never replace: a driver may build the catalog seed more than once per
-- process (`medaka test` runs several engines), and a later call carrying a
-- shorter list must not shrink the set a guard is reading.
--
-- Each row records the catalog's written signature and the positions of its
-- argument binders, which `ffiCheckExternsShadow` and
-- `ffiCheckExternsCatalogRow` (#2163) both read: one map, so the two rules about
-- the same declaration cannot read two tables that fell out of step.
--
-- The signature's rows stay as written labels, not `List Atom`.  `atomsOfWritten`
-- resolves each bare label against `GraphCtx.effectDomains`, and this seam can
-- run before that registry is populated, so both sides are lifted at the check
-- seam, where the registry is the same for both.
--
-- Union means a re-seed REWRITES an existing row rather than skipping it — the two
-- seeds are the same `runtimeDecls` list, so the value is the same pair either
-- way, and preferring the later write keeps the map's contents a function of the
-- last seed rather than of call order.
noteBuiltinExternNames : GraphCtx -> List Decl -> Unit
noteBuiltinExternNames gctx ds =
  gctx.builtinExternNamesRef :=
    externSigsToMap ds gctx.builtinExternNamesRef.value

-- #2072 (epic #2070, R2): the DECLARATION-site sibling of `externSchemes`.
--
-- The eight `externSchemes … runtimeDecls` call sites above build the STDLIB EXTERN
-- CATALOG's schemes: `stdlib/runtime.mdk`'s 138 `extern` lines (derived: `grep -c
-- '^extern ' stdlib/runtime.mdk`), whose written rows ARE the effect vocabulary.
-- They must stay byte-identical.
--
-- THIS one is the `checkBodyImpl` call, which processes whichever program is under
-- check — normally a USER file, where an `extern f : Int -> <> Int` used to type as
-- a pure `Int -> Int`: a one-line escape hatch through the whole effect system.
--
-- 🚨 THIS FUNCTION NO LONGER REWRITES A DECLARED ROW (F1, epic #2070).  Its
-- predecessor STAMPED `FFI` into the terminal row whenever the label was absent,
-- which meant the declared row was never checked against what is enforced —
-- `<Net "a.com/*">` silently became `<FFI, Net "a.com/*">` exactly as `<>`
-- silently became `<FFI>`.  A signature that says one thing and types as another
-- is the defect, not the missing atom.  The honesty requirement is now a CHECK
-- (`ffiCheckExternsLabelled`, run beside the crossable guard at the same
-- `checkBodyImpl` seam): a user extern's terminal row must ALREADY name `FFI`,
-- whatever else it names, or the declaration is a located type error.  The scheme
-- built here is the declaration verbatim.
--
-- `mode` is still taken because every caller has one and the sibling guards read
-- it; the ownership gate now lives entirely on those guards.
userExternSchemes : ModuleCtx ->
  OrdMap TyConOrigin ->
  List Decl ->
  List (String, Scheme)
userExternSchemes mctx scope decls =
  externSchemesGo mctx (stampTyOrigins scope (externDecls decls))

-- ── canonical checked FFI rows for backend input (#2174/#2135) ─────────────
--
-- A typed emitter must not reinterpret the written heads of `DExtern`: the five
-- declaration guards above have already expanded aliases through the current
-- module's alias table, and accepting one shape while lowering another is exactly
-- #2174's check/build split.  These two exported producers reuse the SAME helper
-- body (`expandAliasHeadTyWith`) against the alias carrier that survives the
-- relevant typed path:
--
--   * flat typed probes derive one side-effect-free stage-K `DataEnv` from their
--     already-stamped declaration list;
--   * module emitters read `DeclEnvs.deData.deAliases`, projected at each module's
--     own ordinal by the same visibility machinery the live typecheck used.
--
-- The builtin subtraction is a lookup in the extern catalog `noteBuiltinExternNames`
-- seeds.  These producers run after their drive, so they read the catalog from the
-- interners, which hold the catalog of the graph record most recently minted or restored.  Lowering
-- therefore no longer independently scans `runtimeDecls` to decide whether a checked
-- declaration routes as a builtin.
-- Typed emitters use these canonical producers for checked extern facts.
export
checkedFfiExternTypeNames : List Decl ->
  List (String, (List (String, String), (List String, String)))
checkedFfiExternTypeNames decls =
  let denv = dataEnvFromDeclsGo 0 decls emptyDataEnv
  ffiExternTypeRowsWith
    interners.value.externCatalog.value
    (aliasOwnAt 0 denv.deAliases)
    decls

export
checkedFfiExternTypeNamesModules : DriveOutputs ->
  List (String, List Decl) ->
  List (String, (List (String, String), (List String, String)))
checkedFfiExternTypeNamesModules o modules =
  flatMap
    (checkedFfiExternTypeNamesModule interners.value.externCatalog.value o)
    modules

checkedFfiExternTypeNamesModule : OrdMap (Ty, List (String, Int)) ->
  DriveOutputs ->
  (String, List Decl) ->
  List (String, (List (String, String), (List String, String)))
checkedFfiExternTypeNamesModule catalog o (mid, decls) =
  let cur = ordOfIndex mid o.doOrdIndex
  let aliases =
    aliasOwnAt cur o.doFfiAliases ++ aliasUniverseAt cur o.doFfiAliases
  ffiExternTypeRowsWith catalog aliases decls

-- The current module's aliases arrive in front of its imported alias universe in
-- `checkBodyImpl`.  `DataEnv.deAliases` is already reverse declaration order, so
-- this filter preserves the exact first-match lookup order without rebuilding a
-- second registry.
aliasOwnAt : Int -> List (TabKey, AliasDecl) -> List (TabKey, (List String, Ty))
aliasOwnAt _ [] = []
aliasOwnAt cur ((key, ad) :: rest)
  | ad.adOrd == cur = (key, (ad.adParams, ad.adRhs)) :: aliasOwnAt cur rest
  | otherwise = aliasOwnAt cur rest

-- The pre-#1280 body, unchanged, over the ORIGIN-STAMPED list.  It is split out
-- rather than folded into `externSchemes` so that the recursion cannot re-enter
-- the origin-stamping walk on its own tail — the shape that turns a one-pass `map`
-- into a quadratic, which is the defect class `compiler/AGENTS.md` opens with.
--
-- It took a `stamp : Bool` until F1 (epic #2070), selecting whether to rewrite the
-- declared type with an `FFI` atom.  Both call sites now pass the declaration
-- through verbatim — the stdlib catalog always did, and the user-declaration site
-- checks the row instead of rewriting it (`ffiCheckExternsLabelled`) — so the
-- parameter is gone rather than left as a constant nobody may vary.
externSchemesGo : ModuleCtx -> List Decl -> List (String, Scheme)
externSchemesGo mctx decls =
  map ((n, ty) => (n, sigToScheme mctx ty)) (directExternSigs decls)

directExternSigs : List Decl -> List (String, Ty)
directExternSigs [] = []
directExternSigs ((DExtern (ExternDecl { edName = n, edTy = ty, ... })) :: rest) =
  (n, ty) :: directExternSigs rest
directExternSigs (_ :: rest) = directExternSigs rest

declExternNames : List Decl -> List String
declExternNames decls = map fst (directExternSigs decls)

-- DRIVER-COLLAPSE Phase 2: skip when [mname] is ALREADY registered in THIS pass.
-- The ids must be the SAME quantified ids the call-site instantiation maps through
-- its subst (see the method carrier doc).  The module path's checkModuleFullImpl
-- can construct method rows more than once per pass (env setup + Flat name discovery
-- inference re-resolving schemes), and a SECOND registration prepends DIFFERENT
-- freshly-instantiated carrier → first-match would select metadata from the wrong
-- scheme build.  Keeping the FIRST (env-setup) registration — whose scheme is the one
-- lookupVar returns at call sites — restores the flat path's single-registration
-- invariant.  `freshModuleCtx` clears methodPredicateSlotsRef between modules, so this only
-- de-dups WITHIN a pass.

methodConstraintSlotIds : List String -> Ty -> List (String, Mono) -> List Int
methodConstraintSlotIds typarams (TyConstrained cs t) tvs =
  flatMap (constraintSlotId typarams tvs) cs
    ++ methodConstraintSlotIds typarams t tvs
methodConstraintSlotIds typarams (TyEffect _ _ t) tvs =
  methodConstraintSlotIds typarams t tvs
methodConstraintSlotIds _ _ _ = []

-- one slot per method-level constraint: the id of its dispatch var
-- (constraintSlotDispatchVar), which the supplied dict narrows by.
constraintSlotId : List String -> List (String, Mono) -> Constraint -> List Int
constraintSlotId typarams tvs c = match constraintSlotDispatchVar typarams c
  [] => []
  n :: _ => match lookupAssoc n tvs
    Some m => [monoTyvarId m]
    None => []

sigsOf : List Decl -> List (String, Ty)
sigsOf [] = []
sigsOf ((DTypeSig _ n ty _) :: rest) = (n, ty) :: sigsOf rest
sigsOf ((DAttrib _ d) :: rest) = sigsOf (d :: rest)
sigsOf (_ :: rest) = sigsOf rest

-- every variable reference in an expr, bound ones included (an over-approximation
-- of its free references); the dependency graph uses `freeEVars` instead
allEVars : Expr -> List String
allEVars (EVar x) = [x]
allEVars (EVarId x _) = [x]
allEVars (EMethodAt n _ _) = [n]
allEVars (EDictAt n _) = [n]
allEVars (ELit _) = []
allEVars (EApp f x) = allEVars f ++ allEVars x
allEVars (ELam _ b) = allEVars b
allEVars (ELet _ _ _ e1 e2) = allEVars e1 ++ allEVars e2
allEVars (ELetGroup binds body) = flatMap letBindEVars binds ++ allEVars body
allEVars (EMatch e arms) = allEVars e ++ flatMap armEVars arms
allEVars (EIf c t e) = allEVars c ++ allEVars t ++ allEVars e
allEVars (EBinOp _ l r _) = allEVars l ++ allEVars r
allEVars (EUnOp _ e _) = allEVars e
allEVars (EInfix op l r) = op :: allEVars l ++ allEVars r
allEVars (EFieldAccess e _ _) = allEVars e
allEVars (ETuple es) = flatMap allEVars es
allEVars (EListLit es) = flatMap allEVars es
allEVars (EArrayLit es) = flatMap allEVars es
allEVars (ERangeList a b _) = allEVars a ++ allEVars b
allEVars (ERangeArray a b _) = allEVars a ++ allEVars b
allEVars (ESlice e a b _) = allEVars e ++ allEVars a ++ allEVars b
allEVars (EIndex e i) = allEVars e ++ allEVars i
allEVars (EAnnot e _) = allEVars e
allEVars (EBlock stmts) = flatMap doStmtEVars stmts
allEVars (ERecordCreate _ fs) = flatMap fieldAssignEVars fs
allEVars (ERecordUpdate e fs _) = allEVars e ++ flatMap fieldAssignEVars fs
allEVars (EVariantUpdate _ e fs) = allEVars e ++ flatMap fieldAssignEVars fs
allEVars (ELoc _ e) = allEVars e
allEVars (EDoOrigin _ e) = allEVars e
allEVars (EHeadAnnot e _) = allEVars e
allEVars (EAsPat _ e) = allEVars e
allEVars (EMapLit _ kvs) = flatMap kvEVars kvs
allEVars (ESetLit _ es) = flatMap allEVars es
allEVars (EDo _ stmts) = flatMap doStmtEVars stmts
allEVars (EStringInterp parts) = flatMap interpEVars parts
allEVars (EGuards arms) = flatMap guardArmEVars arms
allEVars (ESection s) = sectionEVars s
-- The arms above mirror `rewriteArgScoped`'s traversal (children only, binders
-- ignored).  What is left for the catch-all, derived against `Expr`'s full
-- constructor set, is exactly four
-- constructors that carry no sub-`Expr` reachable here:
--   ENumLit, EDictApp  — leaves;
--   EMethodRef         — no production verb mints one (see `declRefNames` below);
--   EVarAt             — minted by `annotateProgram`, which runs after typecheck.
-- A new reference-bearing constructor therefore needs an arm above: falling to the
-- catch-all silently drops a dependency edge rather than erroring.
allEVars _ = []

kvEVars : (Expr, Expr) -> List String
kvEVars (k, v) = allEVars k ++ allEVars v

interpEVars : InterpPart -> List String
interpEVars (InterpStr _) = []
interpEVars (InterpExpr e) = allEVars e

guardArmEVars : GuardArm -> List String
guardArmEVars (GuardArm guards body) =
  flatMap guardEVars guards ++ allEVars body

sectionEVars : Section -> List String
sectionEVars (SecBare op) = [op]
sectionEVars (SecRight op e) = op :: allEVars e
sectionEVars (SecLeft e op) = op :: allEVars e

letBindEVars : LetBind -> List String
letBindEVars (LetBind _ clauses _ _) = flatMap funClauseEVars clauses

funClauseEVars : FunClause -> List String
funClauseEVars (FunClause _ body) = allEVars body

armEVars : Arm -> List String
armEVars (Arm _ guards body) = flatMap guardEVars guards ++ allEVars body

guardEVars : Guard -> List String
guardEVars (GBool e) = allEVars e
guardEVars (GBind _ e) = allEVars e

doStmtEVars : DoStmt -> List String
doStmtEVars (DoExpr e) = allEVars e
doStmtEVars (DoLet _ _ _ e _) = allEVars e
doStmtEVars (DoBind _ e) = allEVars e
doStmtEVars (DoAssign _ e) = allEVars e
doStmtEVars (DoFieldAssign _ _ e) = allEVars e

fieldAssignEVars : FieldAssign -> List String
fieldAssignEVars (FieldAssign _ e) = allEVars e

-- The names `e` reads that are not bound by a binder inside `e` or in `bound`:
-- `allEVars` with the binders subtracted, for the dependency graph (`clauseRefs`).
-- Scoping follows resolve's `stampExpr`, the walk that decides which binding an
-- occurrence names: a lambda's and a clause's params, a let's pattern (in its own
-- right-hand side too when recursive), a let group's names, an arm's pattern and
-- its `<-` guards, and a statement's pattern for the statements after it.  An
-- `EVarId` is read by its name: a local letrec's bodies are stamped before they
-- are grouped, and every local occurrence carries the same id 0.
-- A recursive `DoLet` and a recursive non-`PVar` `ELet` bind the pattern in their own
-- right-hand side here, wider than `stampExpr`; the worst case is a group split that
-- could have stayed merged.
freeEVars : OrdMap Unit -> Expr -> List String
freeEVars bound (EVar x) = freeName bound x
freeEVars bound (EVarId x _) = freeName bound x
freeEVars _ (EMethodAt n _ _) = [n]
freeEVars _ (EDictAt n _) = [n]
freeEVars bound (EApp f x) = freeEVars bound f ++ freeEVars bound x
freeEVars bound (ELam ps b) = freeEVars (namesToSet (patVarsListTc ps) bound) b
freeEVars bound (ELet _ r p e1 e2) =
  let after = namesToSet (patVarsTc p) bound
  freeEVars (if r then after else bound) e1 ++ freeEVars after e2
freeEVars bound (ELetGroup binds body) =
  let inner = namesToSet (map letBindName binds) bound
  flatMap (freeLetBindEVars inner) binds ++ freeEVars inner body
freeEVars bound (EMatch e arms) =
  freeEVars bound e ++ flatMap (freeArmEVars bound) arms
freeEVars bound (EIf c t e) =
  freeEVars bound c ++ freeEVars bound t ++ freeEVars bound e
freeEVars bound (EBinOp _ l r _) = freeEVars bound l ++ freeEVars bound r
freeEVars bound (EUnOp _ e _) = freeEVars bound e
freeEVars bound (EInfix op l r) =
  freeName bound op ++ freeEVars bound l ++ freeEVars bound r
freeEVars bound (EFieldAccess e _ _) = freeEVars bound e
freeEVars bound (ETuple es) = flatMap (freeEVars bound) es
freeEVars bound (EListLit es) = flatMap (freeEVars bound) es
freeEVars bound (EArrayLit es) = flatMap (freeEVars bound) es
freeEVars bound (ERangeList a b _) = freeEVars bound a ++ freeEVars bound b
freeEVars bound (ERangeArray a b _) = freeEVars bound a ++ freeEVars bound b
freeEVars bound (ESlice e a b _) =
  freeEVars bound e ++ freeEVars bound a ++ freeEVars bound b
freeEVars bound (EIndex e i) = freeEVars bound e ++ freeEVars bound i
freeEVars bound (EAnnot e _) = freeEVars bound e
freeEVars bound (EBlock stmts) = freeStmtsEVars bound stmts
freeEVars bound (ERecordCreate _ fs) = flatMap (freeFieldEVars bound) fs
freeEVars bound (ERecordUpdate e fs _) =
  freeEVars bound e ++ flatMap (freeFieldEVars bound) fs
freeEVars bound (EVariantUpdate _ e fs) =
  freeEVars bound e ++ flatMap (freeFieldEVars bound) fs
freeEVars bound (ELoc _ e) = freeEVars bound e
freeEVars bound (EDoOrigin _ e) = freeEVars bound e
freeEVars bound (EHeadAnnot e _) = freeEVars bound e
freeEVars bound (EAsPat _ e) = freeEVars bound e
freeEVars bound (EMapLit _ kvs) = flatMap (freeKvEVars bound) kvs
freeEVars bound (ESetLit _ es) = flatMap (freeEVars bound) es
freeEVars bound (EDo _ stmts) = freeStmtsEVars bound stmts
freeEVars bound (EStringInterp parts) = flatMap (freeInterpEVars bound) parts
freeEVars bound (EGuards arms) = flatMap (freeGuardArmEVars bound) arms
freeEVars bound (ESection (SecBare op)) = freeName bound op
freeEVars bound (ESection (SecRight op e)) =
  freeName bound op ++ freeEVars bound e
freeEVars bound (ESection (SecLeft e op)) =
  freeName bound op ++ freeEVars bound e
-- Leaves.  `EMethodRef` and `EVarAt` never reach the dependency graph (see
-- `allEVars`'s catch-all), and are not counted there either.
freeEVars _ (ELit _) = []
freeEVars _ (ENumLit _ _ _) = []
freeEVars _ (EWideLit _ _ _ _) = []
freeEVars _ (EDictApp _) = []
freeEVars _ (EMethodRef _) = []
freeEVars _ (EVarAt _ _) = []

freeKvEVars : OrdMap Unit -> (Expr, Expr) -> List String
freeKvEVars bound (k, v) = freeEVars bound k ++ freeEVars bound v

freeName : OrdMap Unit -> String -> List String
freeName bound x = if omHasKey x bound then [] else [x]

freeInterpEVars : OrdMap Unit -> InterpPart -> List String
freeInterpEVars _ (InterpStr _) = []
freeInterpEVars bound (InterpExpr e) = freeEVars bound e

freeFieldEVars : OrdMap Unit -> FieldAssign -> List String
freeFieldEVars bound (FieldAssign _ e) = freeEVars bound e

freeLetBindEVars : OrdMap Unit -> LetBind -> List String
freeLetBindEVars bound (LetBind _ clauses _ _) =
  flatMap (c => clauseRefsUnder bound (funClausePair c)) clauses

clauseRefsUnder : OrdMap Unit -> (List Pat, Expr) -> List String
clauseRefsUnder bound (ps, body) =
  freeEVars (namesToSet (patVarsListTc ps) bound) body

freeArmEVars : OrdMap Unit -> Arm -> List String
freeArmEVars bound (Arm p guards body) =
  freeGuardsEVars (namesToSet (patVarsTc p) bound) guards body

freeGuardArmEVars : OrdMap Unit -> GuardArm -> List String
freeGuardArmEVars bound (GuardArm guards body) =
  freeGuardsEVars bound guards body

-- guards left to right, a `p <- e` guard binding `p` for the guards after it and
-- for the body
freeGuardsEVars : OrdMap Unit -> List Guard -> Expr -> List String
freeGuardsEVars bound [] body = freeEVars bound body
freeGuardsEVars bound ((GBool e) :: rest) body =
  freeEVars bound e ++ freeGuardsEVars bound rest body
freeGuardsEVars bound ((GBind p e) :: rest) body =
  freeEVars bound e
    ++ freeGuardsEVars (namesToSet (patVarsTc p) bound) rest body

freeStmtsEVars : OrdMap Unit -> List DoStmt -> List String
freeStmtsEVars _ [] = []
freeStmtsEVars bound ((DoExpr e) :: rest) =
  freeEVars bound e ++ freeStmtsEVars bound rest
freeStmtsEVars bound ((DoLet _ r p e _) :: rest) =
  let after = namesToSet (patVarsTc p) bound
  freeEVars (if r then after else bound) e ++ freeStmtsEVars after rest
freeStmtsEVars bound ((DoBind p e) :: rest) =
  freeEVars bound e ++ freeStmtsEVars (namesToSet (patVarsTc p) bound) rest
freeStmtsEVars bound ((DoAssign x e) :: rest) =
  freeEVars bound e ++ freeStmtsEVars (namesToSet [x] bound) rest
freeStmtsEVars bound ((DoFieldAssign _ _ e) :: rest) =
  freeEVars bound e ++ freeStmtsEVars bound rest

-- The Module arm's import overlay, registered over [env] without elaborating a
-- second time what the populations already hold.  A public data declaration is
-- elaborated once, by `appendDataUniverse` at the end of its own module's arm, and
-- an importer reads that payload back by declaration identity.  The overlay's other
-- decls (aliases, newtypes, attributed or private data, a declaration with no
-- identity) are registered exactly as `registerAllData` registers them.
--
-- A served declaration skips `recordDeclKinds` and `registerVariants`' kind, atom
-- and variance rows: it is public data of an earlier module, so stage K's seed
-- (`declEnvSeedDataUniverse`) already holds those rows under the same identity keys.
-- Its field-owner keys are still added, as `registerRecordInfoKeyed` adds them.
-- The overlay is folded in list order, because its tables are last-write-wins and
-- its named rows come last (`importedCtorTypeDeclsLastWins`).
-- [prog] is the reading module's own declarations.
registerImportOverlay : TcEnv -> List Decl -> List Decl -> TcEnv
registerImportOverlay env prog overlay =
  let _ = seedParamPolarityFixpointScoped env.teDyn.dcModule overlay overlay
  let ctorPop = env.teDyn.dcModule.mcGraph.crossRun.universeCtorPop.value
  let recordPop = env.teDyn.dcModule.mcGraph.crossRun.universeRecordPop.value
  let served = map (d => (d, overlayCachedRows ctorPop recordPop d)) overlay
  let _ =
    fold
      (_ p => match snd p
        None => recordDeclKinds env.teDyn.dcModule (fst p)
        Some _ => ())
      ()
      served
  let env1 =
    fold
      (e p => if isAliasDecl (fst p) then registerData e (fst p) else e)
      env
      served
  -- Cycles out before any field elaborates, as in `registerDeclsAliasesFirst`.
  let _ = rejectCyclicAliases env.teDyn.dcModule prog
  fold
    (e p => match snd p
      None => if isAliasDecl (fst p) then e else registerData e (fst p)
      Some rows => registerCachedRows e rows)
    env1
    served

-- The cached constructor schemes and record infos of [d], in variant order, when
-- every one of its constructors has a population row under its own identity; any
-- miss declines for the whole declaration.  Only `DData` has rows to serve, and
-- declining is never wrong: a declined decl is registered by `registerData`,
-- which is where a new `Decl` constructor has to be decided, so the final
-- clause covers every other constructor rather than naming each.
overlayCachedRows : SpellingPop Scheme ->
  SpellingPop RecordInfo ->
  Decl ->
  Option (List (String, Scheme), List (String, RecordInfo))
overlayCachedRows ctorPop recordPop (DData { dataCtors, dataOrigin, ... }) =
  cachedVariantRows ctorPop recordPop dataOrigin dataCtors
overlayCachedRows _ _ _ = None

cachedVariantRows : SpellingPop Scheme ->
  SpellingPop RecordInfo ->
  TyConOrigin ->
  List Variant ->
  Option (List (String, Scheme), List (String, RecordInfo))
cachedVariantRows _ _ _ [] = Some ([], [])
cachedVariantRows ctorPop recordPop o ((Variant cn payload) :: rest) = do
  ident <- mkIdent NsCtor o cn
  s <- spLookupIdent ident cn ctorPop
  recs <- cachedRecordRow recordPop ident cn payload
  later <- cachedVariantRows ctorPop recordPop o rest
  Some ((cn, s) :: fst later, recs ++ snd later)

-- A named-field variant's cached `RecordInfo`, as a zero- or one-row list; a
-- positional variant has none to look up.
cachedRecordRow : SpellingPop RecordInfo ->
  Ident ->
  String ->
  ConPayload ->
  Option (List (String, RecordInfo))
cachedRecordRow recordPop ident cn (ConNamed _ _) =
  map (ri => [(cn, ri)]) (spLookupIdent ident cn recordPop)
cachedRecordRow _ _ _ _ = Some []

registerCachedRows : TcEnv ->
  (List (String, Scheme), List (String, RecordInfo)) ->
  TcEnv
registerCachedRows env (ctors, recs) =
  let _ =
    fold
      (_ r => registerCachedRecord env.teDyn.dcModule (fst r) (snd r))
      ()
      recs
  fold (e c => addCtor e (fst c) (snd c)) env ctors

registerCachedRecord : ModuleCtx -> String -> RecordInfo -> Unit
registerCachedRecord mctx key ri =
  mctx.mcCells.recordByNameRef :=
    omInsert key ri mctx.mcCells.recordByNameRef.value
  mctx.mcCells.fieldOwnersRef :=
    addFieldOwners key (recordFieldNames ri) mctx.mcCells.fieldOwnersRef.value

-- ── dependency-ordered, SCC-merged letrec processing ──────────────────────
-- The prelude has forward references and mutual recursion throughout, so groups
-- must be type-checked in dependency order (a callee generalized before its
-- callers instantiate it polymorphically) with mutually-recursive cycles merged
-- into one letrec group (generalized together).  Mirrors the reference's
-- order_groups_by_deps + process_letrec_group (Phase 136).

-- ── Tarjan strongly-connected components (O(V+E)) ─────────────────────────
-- Replaces the former all-pairs-reachability + mutual-reachability SCC + topo
-- sort, which was O(n^3) in a module's top-level binding count and dominated
-- the multi-module typecheck (check_modules).  Emits SCCs in dependency-first
-- order (a "sink" component — no outside dependencies — finishes and is emitted
-- first), exactly what processSCCs needs.  State is held in module-level refs,
-- reset at the start of each run (processTopGroups runs sequentially per module).

depGraphMap : List String ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List String)
depGraphMap names grouped =
  buildAdj names (namesToSet names omEmpty) grouped omEmpty

-- defs grouped by name ONCE (name -> its clauses, in defs order), so `depsOf`
-- does an O(log n) lookup instead of re-scanning all defs per name (was
-- O(names·defs)). Built by prepend (O(1)); `clausesOf` reverses on read to
-- restore defs order — so the per-name clause list is identical to the old
-- `clausesFor name defs`, keeping dep lists / SCC order / output byte-identical.
groupClauses : List (String, (List Pat, Expr)) -> OrdMap (List (List Pat, Expr))
groupClauses defs = groupClausesGo defs omEmpty
groupClausesGo : List (String, (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
groupClausesGo [] m = m
groupClausesGo ((n, c) :: rest) m =
  groupClausesGo rest (omInsert n (c :: clausesAt n m) m)

clausesAt : String -> OrdMap (List (List Pat, Expr)) -> List (List Pat, Expr)
clausesAt n m = match omLookup n m
  Some xs => xs
  None => []

clausesOf : String -> OrdMap (List (List Pat, Expr)) -> List (List Pat, Expr)
clausesOf n m = revClauses (clausesAt n m) []

revClauses : List (List Pat, Expr) ->
  List (List Pat, Expr) ->
  List (List Pat, Expr)
revClauses [] acc = acc
revClauses (x :: xs) acc = revClauses xs (x :: acc)

buildAdj : List String ->
  OrdMap Unit ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List String) ->
  OrdMap (List String)
buildAdj [] _ _ m = m
buildAdj (n :: rest) nameSet cbn m =
  buildAdj rest nameSet cbn (omInsert n (depsOf n nameSet cbn) m)

-- sig-name presence set (which top-level names carry a type signature), set once
-- per module in `processTopGroups` so `memberPeelSource` does an
-- O(log n) presence check instead of an O(sigs) `lookupAssoc` scan per SCC member
-- (was O(members·sigs) over the whole compiler). Module-level ref, matching the
-- `currentFn`/`curEffect` idiom; processing is sequential per module.

sigNamesToSet : List (String, Ty) -> OrdMap Unit -> OrdMap Unit
sigNamesToSet [] m = m
sigNamesToSet ((n, _) :: rest) m = sigNamesToSet rest (omInsert n () m)

-- PERF: name → declared signature, the same `sigs` assoc list as an index.  Three
-- sites (preunifySigsEx, checkEffectEscape, checkSigConstraintOne) did
-- `lookupAssoc m sigs` — an O(N) scan of EVERY top-level signature, run per member
-- of every group, so O(N²) over a large file.  Companion to `sigNameSetRef`, seeded
-- from the same `sigs` in processTopGroups.
--
-- Built from the REVERSED list: `omFromPairs` is last-write-wins, while the
-- `lookupAssoc` it replaces was first-match-wins, so reversing preserves which
-- signature a duplicated name resolves to.

processTopGroups : TcEnv ->
  List (String, Ty) ->
  List (String, (List Pat, Expr)) ->
  List String ->
  OrdMap Unit ->
  (List (String, Scheme), OrdMap (List (List Pat, Expr)))
processTopGroups env sigs defs names exported =
  env.teDyn.dcModule.mcCells.sigNameSetRef := sigNamesToSet sigs omEmpty
  env.teDyn.dcModule.mcCells.sigTyMapRef := omFromPairs (reverseL sigs) omEmpty
  let grouped = groupClauses defs
  let ordered = tarjanSCCs names (depGraphMap names grouped)
  let result = processSCCs env sigs grouped ordered
  let _ = resolvePendingJoins env.teDyn 0
  let failures =
    EffectSolver.closeRootAuthorities
      env.teDyn.dcModule.mcCells.effectSummaries
      env.teDyn.dcModule.mcCells.rigidAuthvarsRef.value
      (exportedRootCells exported (fst result))
      (widenOpenedFor env.teDyn.dcModule)
  -- read again after the close: a cell the root solved no longer appears
  let unsolved = rootCellsOf exported (fst result)
  let unsolvedIds = fold (acc (_, ids) => IdMap.union acc ids) Tip unsolved
  let _ =
    reportEffectSummaryFailures
      env.teDyn.dcModule
      (filterList (f => not (failureMentions unsolvedIds f)) failures)
  let _ =
    fold
      (seen u => reportUnsolvedExport env.teDyn.dcModule grouped seen u)
      Tip
      unsolved
  result

-- The authority cells an exported binding's published type holds unquantified:
-- a binding the value restriction keeps monomorphic leaves its type's cells to
-- the module root.
exportedRootCells : OrdMap Unit -> List (String, Scheme) -> Map Int Unit
exportedRootCells exported schemes =
  fold (acc (_, ids) => IdMap.union acc ids) Tip (rootCellsOf exported schemes)

rootCellsOf : OrdMap Unit ->
  List (String, Scheme) ->
  List (String, Map Int Unit)
rootCellsOf exported schemes =
  flatMap
    ((name, scheme) =>
      if omHasKey name exported then match unquantifiedAuthIds scheme
        Tip => []
        ids => [(name, ids)]
      else
        [])
    schemes

failureMentions : Map Int Unit -> SummaryFailure ObligationSite -> Bool
failureMentions Tip _ = False
failureMentions ids failure = match failure.esfAuthority
  Some (lo, hi) =>
    anyList (c => IdMap.has (authvarId c) ids) (authVars lo ++ authVars hi)
  None => False

-- An exported binding whose published type (or residual context) still holds
-- a cell after the root solved: nothing in its module bounds it below, and an
-- importer cannot supply it later.  Each cell is reported once, at the first
-- exported binding that holds it; the obligations over it are this failure,
-- not separate ones.  Located at the binding's first located expression.
reportUnsolvedExport : ModuleCtx ->
  OrdMap (List (List Pat, Expr)) ->
  Map Int Unit ->
  (String, Map Int Unit) ->
  Map Int Unit
reportUnsolvedExport mctx grouped seen (name, ids) =
  if IdMap.foldlWithKey (acc id _ => acc && IdMap.has id seen) True ids then
    seen
  else
    let loc = match clausesOf name grouped
      (_, body) :: _ => firstExprLoc body
      [] => None
    let _ =
      pushTypeErrorAt
        mctx
        "T-EXPORT-UNSOLVED-AUTHORITY"
        loc
        "exported binding `\{name}` has an authority in its type that nothing in this module determines; give `\{name}`, or the value it uses, a type signature that names the authority"
    IdMap.union seen ids
-- per-name dependencies: the other group names a binding's bodies reference FREE.
-- Consumed by depGraphMap → Tarjan.  An over-approximated edge is not harmless:
-- it merges two bindings into one SCC, which infers them monomorphically together
-- and can leak one member's constraints into the other's scheme.  So a local
-- binder or parameter that shadows a group name must not count as a reference to
-- it (`clauseRefs` → `freeEVars`).
depsOf : String -> OrdMap Unit -> OrdMap (List (List Pat, Expr)) -> List String
depsOf name nameSet cbn =
  filterNonSelf
    name
    (keepGroupNames nameSet (dedup (groupRefs (clausesOf name cbn))))

groupRefs : List (List Pat, Expr) -> List String
groupRefs clauses = flatMap clauseRefs clauses

clauseRefs : (List Pat, Expr) -> List String
clauseRefs clause = clauseRefsUnder omEmpty clause

keepGroupNames : OrdMap Unit -> List String -> List String
keepGroupNames nameSet refs = filterList (r => omHasKey r nameSet) refs

filterNonSelf : String -> List String -> List String
filterNonSelf name xs = filterList (/= name) xs

-- process each SCC as a letrec group in topological order.  The clause map is
-- threaded through and returned: a Module-arm group's clauses come back MARKED
-- (`processSCC`), and `checkBodyImpl` writes them back into the module's tree.
processSCCs : TcEnv ->
  List (String, Ty) ->
  OrdMap (List (List Pat, Expr)) ->
  List (List String) ->
  (List (String, Scheme), OrdMap (List (List Pat, Expr)))
processSCCs env _ grouped [] = ([], grouped)
processSCCs env sigs grouped (scc :: rest) =
  let (env2, schemes, grouped2) = processSCC env sigs grouped scc
  let (restSchemes, grouped3) = processSCCs env2 sigs grouped2 rest
  (schemes ++ restSchemes, grouped3)

-- The Num obligations of variables that reach a boundary only through a
-- constrained callee's instantiation (a where helper generalized as
-- `Num r => a -> r`, used as `debug (two ())`).  They are on the call and
-- dictionary-application windows, not the boundary's own (#23); a top-level
-- group and a method body default them like any other candidate.
calleeNumObls : ModuleCtx -> Int -> Int -> List UObligation
calleeNumObls mctx callN0 dictN0 =
  numCallObls mctx.mcGraph (callUOblsWindow mctx callN0)
    ++ numDictObls mctx.mcGraph (dictAppsSince mctx.mcGraph dictN0)

-- #23 support: synthesize impl-obligation-shaped Num entries from a group's
-- pendingCallObligations / pendingDictApps deltas.  The Num constraint of an
-- ambiguous var reaching a group ONLY through a constrained-callee instantiation
-- (`main = println (app2 (==))`) is recorded on those refs, never on
-- pendingImplObligations, so group-level Num defaulting (defaultGroupNumWith /
-- groundNumVarsWith, which both reads candidate ids AND finds the live var to ground
-- from impl-shaped entries) never saw it — leaving an ungrounded var whose Num dict
-- route resolves RNone → a NULL dict word → build-time SIGTRAP (run is correct).
-- Only field 0 (iface) and field 3 (the live operand mono) are read downstream;
-- the rest mirror inferNumLitBare's placeholder shape.
-- Num is 1-param, so its obligation vector is a singleton; a wider predicate can
-- never be "Num" and is filtered out anyway.
numCallObls : GraphCtx -> List UObligation -> List UObligation
numCallObls gctx [] = []
numCallObls gctx (o :: rest) = match (o.pred.iface.irName, uOblArgs gctx o)
  ("Num", [mono]) =>
    mkMethodOccObl
        (builtinIfaceRef gctx BNum)
        ["a"]
        (TyVar "a")
        mono
        []
        PNumLit
        o.loc
        o.uoScope
      :: numCallObls gctx rest
  _ => numCallObls gctx rest

numDictObls : GraphCtx -> List PendingDictApp -> List UObligation
-- #1155: the loc comes from the ENTRY's own snapshot.  This runs at a generalized
-- group close, well after inference left the call site, where the record's `mcLoc`
-- names no construct of the entry.
-- Behaviour-neutral by inspection rather than by hope: these synthetic entries feed
-- ONLY the Num-defaulting search (`NumBoundaryOwnedScc` →
-- `numConstrainedIds`/`groundNumVarsWith` → `numObligIds`/`liveNumVarGo`), and every one
-- of those readers destructures the 5th element as `_`.  Nothing renders it today;
-- the point is that the tuple stops carrying a span it knows to be wrong.
numDictObls gctx [] = []
-- B-4b-iii: SPELLING consumer of the widened route carrier — the `"Num"` test is a
-- name test against the prelude spelling, unchanged, so `.irName` is projected here.
numDictObls gctx (app :: rest) =
  flatMap
      (p =>
        if fst p == "Num" then
          [
            mkMethodOccObl
              (builtinIfaceRef gctx BNum)
              ["a"]
              (TyVar "a")
              (snd p)
              []
              PNumLit
              app.pdaLoc
              app.pdaScope,
          ]
        else
          [])
      (zipL (map (i => i.irName) app.pdaIfaces) app.pdaMonos)
    ++ numDictObls gctx rest

-- #23 (two-hop forward): the impl-obligation-shaped entries for EVERY iface (not
-- just Num) a group's constrained-callee instantiations recorded on the call/dict
-- deltas.  Unlike numCallObls/numDictObls (which feed only Num-defaulting), these
-- feed registerSchemeObligations so a constraint FORWARDED from a constrained callee
-- (`useApp g = app2 g`, whose Num lives on the call/dict deltas, never on
-- pendingImplObligations) is recorded in schemeObligationsRef — so a caller of the
-- forwarder (`main = println (useApp (==))`) re-instantiates it (instantiateVarTracked),
-- surfacing the constraint on the caller's own delta where group Num-defaulting can
-- ground the shared ambiguous var.  Without this the forwarded var never grounds on
-- the check path and a downstream Eq/Ord obligation on it is falsely ambiguous.
-- #23 two-hop forward, VECTOR-PRESERVING.  A constraint forwarded from a constrained
-- callee lives on the pendingCallObligations delta, never in addedObls, so a caller of
-- this group must re-instantiate it from schemeObligationsRef.
--
-- This used to detour through a SYNTHETIC addedObls entry (iface, ["a"], TyVar "a",
-- mono, loc) that schemeObligationOne re-read via dispatchMonosOf.  That entry
-- structurally carries ONE Mono, so a joint predicate could not pass through it: it was
-- flat-mapped per ARGUMENT, and because each 1-ary shard lands on a bound tyvar,
-- boundTyvarIds SUCCEEDED and FABRICATED `Ix a` + `Ix i` alongside the real `Ix a i`
-- (one violation reported three times; `(Ix a, Ix a b, Ix b) =>` displayed).
--
-- The detour was pure overhead: dispatchMonosOf ["a"] (TyVar "a") m is an IDENTITY —
-- walkDispatch hits `contains "a" ["a"]` giving [("a", normalize m)], and collectByParam
-- reads it straight back out as [normalize m].  A pendingCallObligations entry ALREADY
-- carries its joint `List Mono`, so map it to bound tyvar ids DIRECTLY and the vector
-- survives at every arity.  Identical at arity 1 (boundTyvarIds normalizes too), and it
-- closes the UNSIGNED forwarding hole, which the declared-context path cannot reach
-- (lookupSigTvMap is None for an unsigned binding).
-- #1549: both scheme-obligation channels now project their entry to a PREDICATE
-- (`callPredOf` / `oblPredOf`) and map it through the ONE `vecOblOfPred` — so the
-- residual reduction §4 `gen` requires cannot be present on one channel and absent
-- from the other (this file's signature failure mode).
forwardedVecObls : ModuleCtx ->
  Bool ->
  List Int ->
  List (IfaceRef, List Mono, Option Loc) ->
  List VecObl
forwardedVecObls mctx generalizing boundIds callObls =
  flatMap
    (vecOblOfPred mctx generalizing boundIds)
    (flatMap callPredOf callObls)

processSCC : TcEnv ->
  List (String, Ty) ->
  OrdMap (List (List Pat, Expr)) ->
  List String ->
  (TcEnv, List (String, Scheme), OrdMap (List (List Pat, Expr)))
processSCC outer sigs grouped0 members =
  -- The group's own checks (generalization, defaulting, its signatures'
  -- coverage) are located at its members' clause bodies.
  let env = envAtIfSome (membersSpanLoc grouped0 members) outer
  -- Marking on the schedule (ARCH §E): a Module-arm group is marked HERE, after
  -- every group it depends on has generalized, with the dict-name set as it stands;
  -- inference reads the stamped twin of the marked clauses.  Flat (`None`): the
  -- caller marked and stamped the whole program, the map is used as given.
  let marking = env.teDyn.dcModule.mcCells.markingRef.value
  let grouped = match marking
    Some mm => markGroupClauses mm env members grouped0
    None => grouped0
  let groupedStamped = match marking
    Some mm => stampGroupClauses mm members grouped
    None => grouped
  let _ = enterLevel env.teDyn.dcModule ()
  let _ = beginEffectSummaryScope env.teDyn.dcModule ()
  let oblN0 = wMark env.teDyn.dcModule.mcCells.implObls
  let callN0 = wMark env.teDyn.dcModule.mcCells.obls
  let dictN0 = goalsMark env.teDyn.dcModule.mcGraph ()
  let placeholders = map (m => (m, freshVar env.teDyn.dcModule ())) members
  let scopedMembers =
    scopeMembers
      env.teDyn.dcModule
      (captureScope env.teDyn.dcModule ())
      groupedStamped
      placeholders
  let (regs, sigTvMaps) = preunifySigsEx env.teDyn.dcModule sigs scopedMembers
  let savedRigidEffects = env.teDyn.dcModule.mcCells.rigidEffvarsRef.value
  let savedRigidAuths = env.teDyn.dcModule.mcCells.rigidAuthvarsRef.value
  env.teDyn.dcModule.mcCells.rigidEffvarsRef :=
    fold
      (roots member =>
        IdMap.foldlWithKey
          (acc id _ => IdMap.set id () acc)
          roots
          member.smDeclaredRoots.value)
      savedRigidEffects
      scopedMembers
  env.teDyn.dcModule.mcCells.rigidAuthvarsRef :=
    fold
      (roots member =>
        IdMap.foldlWithKey
          (acc id _ => IdMap.set id () acc)
          roots
          member.smDeclaredAuths.value)
      savedRigidAuths
      scopedMembers
  let env2 = extendBindings env (map scopedMemberBinding scopedMembers)
  -- P0-19 (constrained-receiver arm): publish THIS group's `=>`-constraint vars for
  -- the duration of body inference, so a definer-shadow method occurrence on one of
  -- them (`neq x y = not (eq x y)` under `neq : Eq a => …`) is seen as a DISPATCH and
  -- not monomorphised to the shadowing standalone's declared domain.
  -- `gcMonos` answers a SPELLING question (`dictVarSatisfiesIface`
  -- compares interface NAMES), so U1b (#1482) projects back to the name here rather than
  -- widening a second ref for a reader that would only throw the identity away.
  let groupCtx = GroupCtx {
    gcMonos = flatMap (r => flatMap ifaceMonoName (regIfaceMonosOf r)) regs,
    gcPendingEscapes = Ref [],
  }
  let groupEnv = { env2 | teDyn = { env2.teDyn | dcGroup = Some groupCtx } }
  -- #837: the schemeObligationsRef snapshot/restore window is RETIRED.  It existed
  -- because registerLocalScheme entries were NAME-KEYED and body-scoped: a prelude
  -- where-helper named `g` (core's `find`) leaked obligations onto an unrelated
  -- top-level `g` in a later body (a phantom `Num a =>` on types/numlit_bidir's
  -- signed fn).  Registration/lookup now key by (name, binding-id), so a top-level
  -- `g`'s use keys (g, its-id) and can never match a where-helper `g`'s (g, 0) entry.
  let _ = inferMembers groupEnv sigs groupedStamped scopedMembers
  let _ =
    fold
      (_ member => checkRecursiveValue env.teDyn member.smOwned)
      ()
      scopedMembers
  let _ =
    resolvePendingJoins env.teDyn env.teDyn.dcModule.mcCells.currentLevel.value
  let residuals =
    finishEffectSummaryScopeKeeping
      env.teDyn.dcModule
      (quantifiableAuthorities env2 groupedStamped scopedMembers)
      (fold (acc member => memberEffectRoots member acc) Tip scopedMembers)
      (fold
        (acc member =>
          borrowedEffectCells env.teDyn.dcModule member.smOwned.bsValue acc)
        Tip
        scopedMembers)
  env.teDyn.dcModule.mcCells.rigidEffvarsRef := savedRigidEffects
  env.teDyn.dcModule.mcCells.rigidAuthvarsRef := savedRigidAuths
  let _ = checkSigsTooGeneral env.teDyn.dcModule sigTvMaps
  let _ = checkSigsFixedByExpansive env2 groupedStamped scopedMembers sigTvMaps
  let _ = registerConstraintRegs env.teDyn.dcModule regs
  let _ = flushPendingEscapes env.teDyn.dcModule (Some groupCtx)
  let _ = exitLevel env.teDyn.dcModule ()
  -- PLAN.md #11 (locked §0.2): GROUP-LEVEL + per-binding Num defaulting.  Ground
  -- every ambiguous Num-only var to Int before this group generalizes.  A live var
  -- carried by a declared signature stays caller-determined across both passes;
  -- an argument-reachable var also stays polymorphic.  Body-only vars (`n = tag [1,2,3]`) still ground.  Scoped to
  -- THIS group's newly-added obligations (prepended at the front) so an earlier
  -- group's already-generalized var is never touched.
  let protectedSigIds = sccProtectedSignatureIds sigTvMaps
  let addedObls = wWindow env.teDyn.dcModule.mcCells.implObls oblN0
  let groupObls = addedObls ++ callUOblsWindow env.teDyn.dcModule callN0
  -- Determination holds rigid exactly the variables this group does not own: the
  -- declared ones and those in an argument position of a member's type, which the
  -- caller supplies.  A result-position or body-local variable is the group's.
  let unownedIds =
    omFromNames
      (map intToString (flatMap monoArgUnboundIds (map snd placeholders)))
      protectedSigIds
  let _ = improveByUniqueImpl env.teDyn protectedSigIds addedObls
  let _ =
    improveByUniqueImpl
      env.teDyn
      protectedSigIds
      (callUOblsWindow env.teDyn.dcModule callN0)
  let _ = determineByUniqueInstance env.teDyn.dcModule unownedIds groupObls
  -- #23: also ground an ambiguous Num var that reaches this group ONLY through a
  -- constrained-callee instantiation (its Num obligation lives on the call/dict deltas,
  -- not pendingImplObligations).  See numCallObls/numDictObls.  The synthetic entries
  -- feed ONLY the Num-defaulting search; addedObls alone still drives the
  -- ambiguous-constraint/scheme-obligation registration below.
  let defaultObls = addedObls ++ calleeNumObls env.teDyn.dcModule callN0 dictN0
  let sccGuard = NumGuard {
    ngGoals = groupObls,
    ngRigidIds = protectedSigIds,
    ngOuterBelow = None,
  }
  let withheld = finalizeNumBoundary
    env.teDyn
    NumBoundary {
      nbDisposition =
        NumBoundaryOwnedScc (env.teDyn.dcModule.mcCells.currentLevel.value + 1),
      nbMembers = map snd placeholders,
      nbSurvivingIds =
        tiedSurvivors
          env.teDyn.dcModule.mcGraph
          (map snd placeholders)
          sccGuard
          protectedSigIds,
      nbDefaultObls = defaultObls,
      nbAmbiguityObls = addedObls,
      nbGuard = sccGuard,
    }  -- RETPOS soundness
  -- Defaulting is a substitution like any other, so the goals it changed are
  -- improved and determined once more.
  let _ = improveByUniqueImpl env.teDyn protectedSigIds groupObls
  let _ = determineByUniqueInstance env.teDyn.dcModule unownedIds groupObls
  let _ =
    checkSigVarGoals
      env.teDyn.dcModule
      DeclaredBySignature
      protectedSigIds
      sigTvMaps
      groupObls
  let schemes =
    sccSchemes
      env2
      sigs
      groupedStamped
      (isLetrecGroup members)
      residuals
      0
      scopedMembers
  let scopedSchemes = alignScopedSchemes scopedMembers schemes
  let _ = checkSigsOverExpansive env2 groupedStamped sigTvMaps
  -- #23 two-hop forward: also record constraints FORWARDED from a constrained
  -- callee (living on the call delta, never in addedObls) into schemeObligationsRef,
  -- so a caller of this group re-instantiates them and its own group can ground the
  -- shared ambiguous var.
  -- The CALL delta is passed RAW (it already carries each predicate's joint `List
  -- Mono`); registerSchemeObligations maps it with forwardedVecObls so a multi-param
  -- predicate survives whole.  #838 I5: a constrained callee's DICT slot is forwarded
  -- through THIS same call delta — inferDictAtFound records it as a 1-ary PCallSlot
  -- obligation (recordCallObligations, beside pushDictApp), so the old `allDictObls`
  -- re-derivation off the dict delta was a redundant duplicate (deduped away) and is
  -- retired; addedObls now carries only the real pendingImplObligations delta.
  let callOblsDelta = callOblsWindow env.teDyn.dcModule callN0
  let _ =
    registerSchemeObligations
      env.teDyn.dcModule
      env.teDyn.dcModule.mcCells.schemeDefIdsRef.value
      sigTvMaps
      callOblsDelta
      addedObls
      schemes
  let liveIds = liveMemberIds env.teDyn.dcModule (map snd placeholders)
  let _ =
    rejectUndeterminedVectors
      env.teDyn.dcModule
      unownedIds
      liveIds
      addedObls
      (callUOblsWindow env.teDyn.dcModule callN0
        ++ nestedRequireGoals env.teDyn.dcModule unownedIds liveIds groupObls)
  let _ =
    rejectWithheldAmbiguity env.teDyn.dcModule unownedIds withheld groupObls
  -- SIGNATURE CONSTRAINT SOUNDNESS: a signed member whose body induces an
  -- interface constraint on one of its own quantified vars that its declared `=>`
  -- context (superclass-closed) does NOT cover severs the constraint for callers
  -- → wrong-dictionary dispatch (a silent wrong answer).  Reject at the def-site.
  -- Runs on every path; the census over compiler+stdlib+sqlite was 0 new failures.
  let _ =
    checkSigConstraintCoverage
      env.teDyn.dcModule
      regs
      sigs
      sigTvMaps
      callOblsDelta
      addedObls
      schemes
  let _ =
    registerInferredConstraints
      env.teDyn.dcModule
      sigs
      callOblsDelta
      addedObls
      scopedSchemes
  -- From here on every instance-head matcher holds this group's declared variables
  -- rigid; the group's own generalization above reads them as free variables, so a
  -- goal `checkSigVarGoals` rejected is not reported a second time.
  let _ = declareRigidVars env.teDyn.dcModule (omKeys protectedSigIds)
  -- The group's own occurrences of the members it just promoted (see
  -- `markRecursiveOccurrences`); Flat marks nothing here.
  let groupedOut = match marking
    Some mm =>
      markRecursiveOccurrences
        env.teDyn.dcModule
        mm
        placeholders
        scopedMembers
        grouped
    None => grouped
  let _ = match marking
    Some _ =>
      recordTopGrants
        env.teDyn.dcModule.mcGraph
        env.teDyn.dcModule.mcCells.currentModuleRef.value
        schemes
        groupedOut
    None => ()
  (extendTermBindings outer schemes, schemes, groupedOut)

-- A multi-member SCC is a mutually-recursive group (always a function group, like
-- the oracle's DLetGroup); a singleton is a plain binding gated on its RHS.  Self-
-- recursive singletons have had their self-edge stripped (filterNonSelf) so they
-- arrive as size-1 SCCs — strict evaluation rules out a self-recursive zero-arg
-- value, so gating them on the RHS is sound and matches the oracle's DFunDef path.
isLetrecGroup : List String -> Bool
isLetrecGroup [] = False
isLetrecGroup [_] = False
isLetrecGroup _ = True

scopedMemberBinding : ScopedMember -> (String, EnvBinding)
scopedMemberBinding member =
  let binding =
    optionOr
      (ordinaryEnvBinding
        (Forall
          []
          []
          []
          []
          (memberForce member)
          member.smOwned.bsRecursiveValue))
      member.smRecursive.value
  (
    member.smName,
    bindingWithStandalone binding (LocalStandalone, binding.ebValue),
  )

memberForce : ScopedMember -> EffRow
memberForce member =
  optionOr (optionOr pureRow member.smForce) member.smForceBound.value

memberEffectRoots : ScopedMember -> Map Int Unit -> Map Int Unit
memberEffectRoots member roots =
  let inputs =
    if member.smSigned.value then
      roots
    else
      effectRoots member.smOwned.bsValue roots
  IdMap.foldlWithKey
    (acc id _ => IdMap.set id () acc)
    inputs
    member.smDeclaredRoots.value

scopeMembers : ModuleCtx ->
  ScopeId ->
  OrdMap (List (List Pat, Expr)) ->
  List (String, Mono) ->
  List ScopedMember
scopeMembers mctx _ _ [] = []
scopeMembers mctx parent grouped ((name, mono) :: rest) =
  let sid =
    Scopes.freshScope
      (currentScopeStore mctx.mcGraph ())
      (Some parent)
      mctx.mcCells.currentLevel.value
      (Scopes.scopeFrame (currentScopeStore mctx.mcGraph ()) parent).sfModuleId
      (BindingOwner name)
  -- This is the evaluator's topGroupValue distinction: a singleton nullary
  -- clause is a thunk, including a thunk whose result happens to be a function.
  let clauses = clausesOf name grouped
  let arity = match clauses
    (pats, _) :: _ => listLen pats
    [] => 0
  let owned = newBindingSummary arity (freshVar mctx) (freshEffectSummary mctx)
  let force = match clauses
    [([], _)] => Some owned.bsForce
    _ => None
  ScopedMember {
      smName = name,
      smMono = mono,
      smOwned = owned,
      smDeclaredRoots = Ref Tip,
      smDeclaredAuths = Ref Tip,
      smSigned = Ref False,
      smRecursive = Ref None,
      smForce = force,
      smForceBound = Ref None,
      smScope = sid,
    }
    :: scopeMembers mctx parent grouped rest

alignScopedSchemes : List ScopedMember ->
  List (String, Scheme) ->
  List ScopedScheme
alignScopedSchemes [] [] = []
alignScopedSchemes (member :: members) ((name, scheme) :: schemes)
  | member.smName == name =
    ScopedScheme {
        ssName = name,
        ssScheme = scheme,
        ssScope = member.smScope,
      }
      :: alignScopedSchemes members schemes
  | otherwise = panic "scope/member scheme alignment mismatch"
alignScopedSchemes _ _ = panic "scope/member scheme arity mismatch"

-- Extended Pass A: same as preunifySigs but also returns the tyvar maps (for
-- the signature-too-general check after body inference).  Returns a pair:
-- (constraintRegs, sigTvMaps) where sigTvMaps is [(name, sig_ast, tvs)] for
-- each signed member.
-- #1161 (F-3a-ii): each reg is now a TRIPLE — (name, slot-parallel (iface, mono) pairs,
-- slot-parallel predicate argument VECTORS).  The first two components are unchanged;
-- the third is carried alongside, never instead of, so nothing downstream that sizes or
-- orders dict slots can move.
preunifySigsEx : ModuleCtx ->
  List (String, Ty) ->
  List ScopedMember ->
  (List ConstraintReg, List (String, Ty, List (String, Mono)))
preunifySigsEx mctx _ [] = ([], [])
preunifySigsEx mctx sigs (member :: rest) =
  let m = member.smName
  let v = member.smMono
  let (restRegs, restTvs) = preunifySigsEx mctx sigs rest
  match omLookup m mctx.mcCells.sigTyMapRef.value
    Some ty =>
      member.smSigned := True
      let (signedMono, tvs, forceBound) = instantiateSigTracked mctx ty
      member.smDeclaredRoots :=
        effectRowRoots
          (optionOr pureRow forceBound)
          (effectRoots signedMono Tip)
      member.smDeclaredAuths :=
        authRowRoots (optionOr pureRow forceBound) (authRoots signedMono Tip)
      member.smForceBound := forceBound
      let (declaredScheme, declaredTvs) = sigToSchemeTvs mctx ty
      let (Forall ids eids aids _ declaredForce declaredValue) = declaredScheme
      let slots =
        declaredPredicateSlots
          (constraintVarIfaceMonos (sigConstraints ty) declaredTvs)
          (constraintVarArgMonos
            mctx
            (sigConstraints ty)
            (sigConstraintArgTys ty)
            declaredTvs)
      member.smRecursive := Some EnvBinding {
        ebValue = ValueScheme {
          vsScheme =
            Forall
              ids
              eids
              aids
              []
              (match forceBound
                Some _ => declaredForce
                None => optionOr pureRow member.smForce)
              declaredValue,
          vsDeclared = Some CDeclared {
            cdSlots = predicateSlotCSlots slots,
            cdPrefix =
              CDPLen (listLen (dedupSlotVecs (map predicateSlotView slots))),
            cdArgs = predicateSlotArgs slots,
          },
        },
        ebMethodRow = None,
        ebStandalone = None,
      }
      let _ = bindFrom (dynFor mctx) v signedMono
      let regs = [
        ConstraintReg {
          crName = m,
          crScope = member.smScope,
          crIfaceMonos = constraintVarIfaceMonos (sigConstraints ty) tvs,
          crArgVecs =
            constraintVarArgMonos
              mctx
              (sigConstraints ty)
              (sigConstraintArgTys ty)
              tvs,
        },
      ]
      (regs ++ restRegs, (m, ty, tvs) :: restTvs)
    None =>
      let _ = unify mctx v member.smOwned.bsValue
      (restRegs, restTvs)

sigTvMapUnboundIds : (String, Ty, List (String, Mono)) -> List Int
sigTvMapUnboundIds (_, _, tvs) = flatMap (p => monoUnboundIds (snd p)) tvs

-- A declared signature variable is a caller-chosen universal, so Num defaulting
-- never grounds it, whatever the group's shape. Every recursive occurrence of a
-- signed member instantiates its written contract afresh (`preunifySigsEx` installs
-- the declared scheme as `smRecursive`), so a declared variable never appears in
-- another member's type: an unsigned sibling's copy is its own inference variable
-- and defaults or generalizes under the ordinary rules. The former "shared by every
-- generalizable member" bound assumed monomorphic recursion, under which the
-- declared variable and the sibling's copy were one cell; with fresh contracts that
-- bound protected nothing, and both members of a signed mutual group defaulted to
-- Int without any too-general diagnostic.
sccProtectedSignatureIds : List (String, Ty, List (String, Mono)) -> OrdMap Unit
sccProtectedSignatureIds sigTvMaps =
  omFromNames (map intToString (flatMap sigTvMapUnboundIds sigTvMaps)) omEmpty

-- 🚨 ONE ENTRY PER PREDICATE (S-dict-arity-contract, #1318/B-4) — the (iface, bare
-- tyvar NAMES) pairs of a signature's `=>` constraints, ONE per constraint that has at
-- least one bare type variable ANYWHERE in its argument types, direct or NESTED
-- (`tyVarArgNames`'s `dedup (flatMap tyVarNames tys)` walks into `TyApp`/`TyFun`/`TyTuple`
-- spines, not just top-level `TyVar` arguments — S-structured-predicate-carry). So a
-- STRUCTURED-only constraint (`Tag (Wrap a) =>`, no bare argument, `a` only reachable by
-- descending into `Wrap a`) DOES carry a dict slot now.  Only a constraint whose
-- arguments are entirely ground/closed — no bare type variable anywhere in them, nested
-- or not — carries no dict slot and contributes nothing.
--
-- This list IS the dict-param cardinality of a `=>`-constrained top-level fn: it feeds
-- `registerMemberSlots` → `funConstraintsRef`, which `dictArityOf` (define side) and
-- `inferDictAtFound` (call side) both size from.  It used to emit one entry per bare
-- tyvar ARGUMENT — `Ix a b =>` shattered into TWO dict params for ONE predicate, both
-- routed from the same single-argument goal — so the emitted convention disagreed with
-- the METHOD-level channel (`methodLevelConstraintVarNames`/`constraintSlotDispatchVar`,
-- one slot per constraint since #818) and with the impl-`requires` channel
-- (`registerReqSlots`, one slot per ENTRY).  All three channels now agree: one dict per
-- predicate.  ⚠️ The names are kept as a LIST, not collapsed to the first one here,
-- because WHICH of them is still an abstract tyvar after body inference is not knowable
-- until `registerMemberSlots` normalizes the instantiated monos — and every abstract one
-- must still reach `activeDictVars`, or a body use dispatching on the predicate's SECOND
-- variable loses its route.
sigConstraints : Ty -> List (IfaceRef, List String)
sigConstraints (TyConstrained cs _) = flatMap constraintTyVars cs
sigConstraints _ = []

-- U1b (#1482): carries `constraintOrigin` (the #1110 interface-occurrence identity)
-- alongside the spelling, so `registerMember`'s slot-parallel iface list — and hence
-- every obligation `recordCallObligations` later mints from it — is identity-carrying.
constraintTyVars : Constraint -> List (IfaceRef, List String)
constraintTyVars (Constraint { constraintHead = iface, constraintArgs = tys, constraintOrigin = co }) =
  match tyVarArgNames tys
    [] => []
    ns => [(IfaceRef { irName = iface, irOrigin = co }, ns)]

tyVarArgNames : List Ty -> List String
tyVarArgNames tys = dedup (flatMap tyVarNames tys)

-- #1161 (F-3a-ii): slot-parallel to `sigConstraints` — the WHOLE predicate's argument
-- type list, ONE per slot.  `Ix a Char` and `Ix a b` are each ONE slot carrying their
-- full argument list (`[TyVar a, TyCon Char]` / `[TyVar a, TyVar b]`) — evidence for one
-- predicate, so one goal.
-- Length-parallel to sigConstraints by construction: both are `flatMap … cs` over the
-- SAME constraint list, and both emit one element per constraint that has at least one
-- bare tyvar argument.
-- Matches sigConstraints' TOP-LEVEL-`TyConstrained`-only shape deliberately, so the two
-- cannot desynchronize on a nested-constraint spine.
sigConstraintArgTys : Ty -> List (List Ty)
sigConstraintArgTys (TyConstrained cs _) = flatMap constraintTyVarArgs cs
sigConstraintArgTys _ = []

constraintTyVarArgs : Constraint -> List (List Ty)
constraintTyVarArgs (Constraint { constraintArgs = tys }) =
  match tyVarArgNames tys
    [] => []
    _ => [tys]

-- like constraintVarMonos but KEEPS the iface name paired with each constraint var's
-- mono (slot order preserved), so registerMember can register call-obligation ifaces.
-- S-dict-arity-contract: the payload is now the predicate's WHOLE bare-tyvar mono list,
-- one entry per predicate.  An entry survives when AT LEAST ONE of its names is in
-- [tvMap] (the drop rule `constraintVarArgMonos` mirrors exactly); the monos of the
-- names that are absent are simply not carried, which is what the per-name walk did.
constraintVarIfaceMonos : List (IfaceRef, List String) ->
  List (String, Mono) ->
  List (IfaceRef, List Mono)
constraintVarIfaceMonos [] _ = []
constraintVarIfaceMonos ((iface, names) :: rest) tvMap =
  match constraintNameMonos names tvMap
    [] => constraintVarIfaceMonos rest tvMap
    monos => (iface, monos) :: constraintVarIfaceMonos rest tvMap

-- #1161 (F-3a-ii): as constraintVarIfaceMonos, but yields each kept slot's predicate
-- argument vector as MONOS at the signature instantiation.  Drops exactly the slots
-- constraintVarIfaceMonos drops (same `lookupAssoc name tvMap` test, same walk), so the
-- two lists stay slot-parallel.
-- ⚠️ Resolves arguments with `fromAstType tvMap`, NOT `constraintArgMonos` — the latter
-- returns `None` for any argument that is not a bare type variable, i.e. exactly the
-- concrete `Char` in `Ix a Char` that is the whole point of recording the vector.
-- Every tyvar NAME reachable inside an argument is in [tvMap]: instantiateSigTracked
-- builds it from `tyVarNamesWithConstraints`, whose constraint half
-- (`constraintArgVarNames`) is a full structural `tyVarNames` walk of each argument —
-- so the interior `b` of `List b` is mapped, and fromAstType's unmapped-var → `TCon n`
-- fallback is unreachable here.
constraintVarArgMonos : ModuleCtx ->
  List (IfaceRef, List String) ->
  List (List Ty) ->
  List (String, Mono) ->
  List (List Mono)
constraintVarArgMonos mctx [] _ _ = []
constraintVarArgMonos mctx _ [] _ = []
constraintVarArgMonos mctx ((_, names) :: rest) (args :: argsRest) tvMap =
  match constraintNameMonos names tvMap
    [] => constraintVarArgMonos mctx rest argsRest tvMap
    _ =>
      map (fromAstType mctx tvMap) args
        :: constraintVarArgMonos mctx rest argsRest tvMap

-- Pass B: infer each member's clauses, unifying with its placeholder.
-- Phase 73 (bidirectional, signature-driven parameter typing): a member WITH a
-- signature peels its declared arrow types onto the clause parameter patterns
-- BEFORE inferring the body, so the body sees concrete parameter types (a
-- receiver-directed field access `f p = p.x` or a `String`-indexed `s.[0]`
-- resolves from the signature alone).  [peel] is Some(placeholder) for a signed
-- member, None otherwise; the placeholder already holds the sig instantiation
-- (preunifySigsEx unified it), and its shared tyvars accumulate unifications
-- across clauses exactly as the oracle's `sig_t` does.  Purely additive: the
-- per-clause `unify v arrow` below imposes the same equalities anyway.
inferMembers : TcEnv ->
  List (String, Ty) ->
  OrdMap (List (List Pat, Expr)) ->
  List ScopedMember ->
  Unit
inferMembers env _ _ [] = ()
inferMembers outer sigs grouped (member :: rest) =
  let m = member.smName
  -- A member's own checks (its signature against its value, its forcing
  -- bound, its effect escape) are located at its clauses' bodies.
  let env = envAtIfSome (membersSpanLoc grouped [m]) outer
  let v = member.smMono
  let _ = openScope env.teDyn.dcModule member.smScope
  env.teDyn.dcModule.mcCells.currentFn := m
  let peel = memberPeelSource env.teDyn.dcModule sigs m v
  let effs = inferMemberClauses env peel member.smOwned (clausesOf m grouped)
  -- The signature is checked against the value the clauses return.
  let _ =
    if member.smSigned.value then
      unifyInto
        (dynAtIfSome
          (joinLocs (clauseSpans valueSpanLoc grouped [m]))
          env.teDyn)
        True
        member.smMono
        member.smOwned.bsValue
  let _ = match member.smForceBound.value
    Some bound =>
      let _ =
        fold
          (_ cl => recordFileBound env.teDyn.dcModule (snd cl) bound)
          ()
          (clausesOf m grouped)
      rowInto
        env.teDyn
        True
        (effrowNorm bound)
        (effrowNorm (optionOr pureRow member.smForce))
    None => ()
  env.teDyn.dcModule.mcCells.currentFn := ""
  let _ = closeScope env.teDyn.dcModule ()
  -- A value signature constrains the returned value, not the cost of forcing
  -- its initializer. That cost travels on the binding and is checked at uses.
  let _ = match member.smForce
    None => checkEffectEscape env.teDyn sigs m effs
    Some _ => ()
  inferMembers outer sigs grouped rest

-- The span of the named members' clause bodies (`exprSpanLoc`), joined.
membersSpanLoc : OrdMap (List (List Pat, Expr)) -> List String -> Option Loc
membersSpanLoc grouped names = joinLocs (clauseSpans exprSpanLoc grouped names)

-- [span] of each clause body of the named members.
clauseSpans : (Expr -> Option Loc) ->
  OrdMap (List (List Pat, Expr)) ->
  List String ->
  List Loc
clauseSpans span grouped names =
  flatMap
    (m =>
      flatMap
        (cl => option [] (l => [l]) (span (snd cl)))
        (clausesOf m grouped))
    names

-- The span of the expression whose value [e] is: a `let … in`, which has no
-- span of its own, returns its body's value, and a block returns its last
-- statement's.
valueSpanLoc : Expr -> Option Loc
valueSpanLoc (ELoc l _) = Some l
valueSpanLoc (ELet _ _ _ _ body) = valueSpanLoc body
valueSpanLoc (ELetGroup _ body) = valueSpanLoc body
valueSpanLoc (EBlock stmts) = match last stmts
  Some (DoExpr e) => valueSpanLoc e
  _ => exprSpanLoc (EBlock stmts)
valueSpanLoc e = exprSpanLoc e

-- the peel source for a member: Some placeholder if it has a signature (peel the
-- declared arrow domains onto the clause params), None otherwise
memberPeelSource : ModuleCtx ->
  List (String, Ty) ->
  String ->
  Mono ->
  Option Mono
memberPeelSource mctx sigs m v =
  map (_ => v) (omLookup m mctx.mcCells.sigNameSetRef.value)

-- zip-unify the equal-length prefix of param types and peeled sig domains; a
-- shorter [qs] (partial sig) pushes nothing past its end
-- Domains constrain the recursive placeholder as each clause is inferred.
-- Produced results join once after all alternatives are known: the first
-- clause must not fix a returned callback's row for its siblings.
inferMemberClauses : TcEnv ->
  Option Mono ->
  BindingSummary ->
  List (List Pat, Expr) ->
  List Atom
inferMemberClauses env _ _ [] = []
inferMemberClauses env peel owned clauses =
  let (values, effects) = inferClauseValues env peel owned clauses
  let _ = publishProducedResults env.teDyn owned values
  effrowLabels (collectRows (joinCellOf env.teDyn.dcModule.mcGraph) effects)

inferClauseValues : TcEnv ->
  Option Mono ->
  BindingSummary ->
  List (List Pat, Expr) ->
  (List (Option Loc, Mono), List EffRow)
inferClauseValues env _ _ [] = ([], [])
inferClauseValues env peel owned (cl :: rest) =
  let ce = inferClauseEff env peel cl
  -- A clause that does not fit the member's type is reported at the value it
  -- returns.
  let value = valueSpanLoc (snd cl)
  let _ =
    unifySourceDomains
      (dynAtIfSome value env.teDyn)
      (listLen (fst cl))
      owned.bsValue
      (fst ce)
  let _ = recordEffectBody env.teDyn.dcModule owned.bsBody (snd ce)
  let (values, effects) = inferClauseValues env peel owned rest
  ((value, fst ce) :: values, snd ce :: effects)

-- infer one clause, returning its arrow type AND the concrete effect labels its
-- body performs (captured in a fresh collection, then the ambient restored —
-- building a closure performs nothing).  Mirrors inferLam but exposes the effect.
-- Phase 73: when [peel] is Some(sig source) and the clause has params, peel the
-- signature's arrow domains and zip-unify them onto the clause param types BEFORE
-- inferring the body (bidirectional checking mode).
inferClauseEff : TcEnv -> Option Mono -> (List Pat, Expr) -> (Mono, EffRow)
inferClauseEff outer peel (pats, body) =
  -- The clause is located at its body: patterns carry no source Loc, so an
  -- over-applied-constructor / arity pattern error lands on this clause, and a
  -- body the parser leaves unwrapped (an application, an operator) is still
  -- located.  See the twin note in inferLam.
  let env = envAtIfSome (exprSpanLoc body) outer
  let lits = takePatLits env.teDyn.dcModule ()
  let pr = inferPats env pats
  let _ = peelOntoParams env.teDyn peel (fst pr) pats
  let scope =
    openExistentialScope
      env.teDyn.dcModule
      (takeOpenedExistentials env.teDyn.dcModule ())
  let _ = settlePatLits env.teDyn lits
  let _ = match peel
    Some src => recordClauseFileBound env.teDyn.dcModule body (listLen pats) src
    None => ()
  -- #2109: a signed clause's body is inferred AGAINST the signature's result
  -- type (result-first), so a fresh construction at a non-covariant slot meets
  -- the declaration while its own slot is still a metavariable.  See
  -- `inferExpected`.  An unsigned clause is byte-identical to before.
  let (bodyTy, bodyEff) = captureEffects
    env.teDyn.dcModule.mcCells.curEffect
    (joinCellOf env.teDyn.dcModule.mcGraph)
    (_ => match peel
      Some src => match resultAfterArrows (listLen pats) src
        Some expected =>
          let bodyEnv = extendLocalVars env (snd pr)
          checkedInto
            bodyEnv
            body
            expected
            (inferExpected bodyEnv body expected)
        None => infer (extendLocalVars env (snd pr)) body
      None => infer (extendLocalVars env (snd pr)) body)
  let _ = closeExistentialScope env.teDyn.dcModule scope bodyTy (exprLoc body)
  (arrowsWithLastEffect (fst pr) bodyEff bodyTy, bodyEff)

-- Phase 73 peel: for a signed clause with params, zip-unify the peeled sig
-- domains onto the inferred param types.  No-op for an unsigned member, a value
-- binding (no params), or a sig with no remaining arrows.
peelOntoParams : DynCtx -> Option Mono -> List Mono -> List Pat -> Unit
peelOntoParams dyn None _ _ = ()
peelOntoParams dyn (Some _) _ [] = ()
peelOntoParams dyn (Some src) patTypes pats =
  zipBindFrom dyn patTypes (peelArrows (listLen pats) src)

-- a signatured binding's body must not perform a concrete effect its signature
-- doesn't declare; effect *variables* (polymorphic `<e>`) carry no labels and so
-- never escape (Phase 79e)
checkEffectEscape : DynCtx -> List (String, Ty) -> String -> List Atom -> Unit
checkEffectEscape dyn sigs m effs = match dyn.dcGroup
  None => ()
  Some group => checkEffectEscapeIn dyn.dcModule group sigs m effs

checkEffectEscapeIn : ModuleCtx ->
  GroupCtx ->
  List (String, Ty) ->
  String ->
  List Atom ->
  Unit
checkEffectEscapeIn mctx group sigs m effs =
  match omLookup m mctx.mcCells.sigTyMapRef.value
    None => ()
    -- #797: a genuinely open declared row (free return-position tail var, no
    -- argument-side occurrence) has nothing to escape FROM — the row admits
    -- whatever the body performs, which is what a free tail var MEANS.  Skipping
    -- here rather than widening `declaredEffects` keeps the CLOSED-row rejection
    -- (and its wording) byte-identical.
    Some written =>
      let ty = expandReturnSpine mctx written
      if declaredEffectsOpen mctx ty then
        ()
      else match (atomsEscape
        mctx.mcGraph
        (filterList concreteAtom effs)
        (declaredEffects mctx.mcGraph ty))
        -- An atom whose authority is still symbolic is the scoped solver's to
        -- decide once the binding's arguments have bounded it; comparing it
        -- here would report a variable a later solution resolves.

        [] => ()
        extras =>
          group.gcPendingEscapes :=
            (
                m,
                mctx.mcLoc,
                effectEscapeMsg
                  m
                  (declaredEffects mctx.mcGraph ty)
                  (declaredEffectTail ty)
                  extras,
              )
              :: group.gcPendingEscapes.value

-- After a group's solver scope has closed: report the walk's finding for a
-- member the solver said nothing about, and drop it for one it reported.
flushPendingEscapes : ModuleCtx -> Option GroupCtx -> Unit
flushPendingEscapes mctx None = ()
flushPendingEscapes mctx (Some group) =
  let pending = reverseL group.gcPendingEscapes.value
  group.gcPendingEscapes := []
  fold
    (_ entry =>
      let (m, loc, msg) = entry
      if omHasKey m mctx.mcCells.rowFailureReportedRef.value then
        ()
      else
        pushTypeErrorAt mctx "T-EFFECT-LEAK" loc msg)
    ()
    pending

concreteAtom : Atom -> Bool
concreteAtom a = not (authHasVars (atomAuth a))

-- generalize each member's (sig-and-body-unified) placeholder.  A signature was
-- already unified into the placeholder by preunifySigs, so generalizing the
-- result respects it AND any further specialization the body forces (e.g.
-- sum : t a -> a with body `fold (+) 0` reports a Int -> Int, not the raw sig).
-- Value restriction (DICT-SEMANTICS §4.1 G2): generalize a member only if it is
-- a syntactic *value* — every one of its clauses has params, or its zero-arg RHS
-- is non-expansive (`isNonexpansive`).  The decision is per MEMBER and purely
-- syntactic, on every group shape:
--   * a multi-member SCC gets no exemption (#2554): a zero-arg expansive member
--     such as `cell = Ref (helper 0)` inside a mutually-recursive group is a
--     polymorphic reference if generalized, and its siblings with params are
--     values on their own account, so "a group is always a function group" was
--     never the premise that made generalizing it safe;
--   * a signed binding gets no exemption from its type (#2556): the old
--     "post-unify type is an arrow" reading admitted `weird : a -> a ;
--     weird = mk ()`, whose RHS allocates a Ref before returning the arrow, so
--     one cell was read at two types.  A point-free binding is a value only
--     if G2 says so — write `maximum xs = fold step None xs`, not
--     `maximum = fold step None`.
-- A non-function expansive binding (`r = Ref []`) is value-restricted and stays
-- monomorphic whether or not it is signed.  The `isLetrec` argument is retained
-- for the (unchanged) caller signature; it no longer influences the decision.
sccSchemes : TcEnv ->
  List (String, Ty) ->
  OrdMap (List (List Pat, Expr)) ->
  Bool ->
  List (Int, AuthResidual) ->
  Int ->
  List ScopedMember ->
  List (String, Scheme)
sccSchemes env _ _ _ _ _ [] = []
sccSchemes env sigs grouped isLetrec residuals index (member :: rest) =
  let m = member.smName
  let isVal = allList (memberClauseIsValue env) (clausesOf m grouped)
  (
      m,
      genBindingRestricted
        env.teDyn
        member.smDeclaredAuths.value
        (residualsOf index residuals)
        isVal
        (memberForce member)
        member.smMono,
    )
    :: sccSchemes env sigs grouped isLetrec residuals (index + 1) rest

-- The authority variables each member of a group will quantify, keyed to the
-- member's index: the argument-position authorities of an unsigned value
-- member (`qualifierAuthIds`, the ones publication keeps).  A variable two
-- members' types share is a recursive group's monomorphic link and is solved
-- as before; a signed member publishes its signature, so it keeps none.
quantifiableAuthorities : TcEnv ->
  OrdMap (List (List Pat, Expr)) ->
  List ScopedMember ->
  ScopeRoles
quantifiableAuthorities env grouped members =
  scopeRolesOf
    (map
      (member => (
        memberRole
          -- the presence set, not a scan of every signature: this runs once
          -- per binding group (`sigNameSetRef`)
          (omHasKey
            member.smName
            env.teDyn.dcModule.mcCells.sigNameSetRef.value)
          (allList (memberClauseIsValue env) (clausesOf member.smName grouped)),
        member.smMono,
      ))
      members)

memberRole : Bool -> Bool -> BindingRole
memberRole True _ = RoleDeclared
memberRole False True = RoleQuantifies
memberRole False False = RoleMonomorphic

-- A local binding carries no signature of its own.
localRole : Bool -> BindingRole
localRole True = RoleQuantifies
localRole False = RoleMonomorphic

-- [members] in group order, each with its role and type.  A quantifying
-- member's argument-position authorities are quantified (a variable two
-- members share is a recursive group's monomorphic link and is solved as
-- before); a monomorphic member hands every authority of its type outward.
scopeRolesOf : List (BindingRole, Mono) -> ScopeRoles
scopeRolesOf members =
  let owners =
    fold
      ((acc, index) (role, mono) =>
        let ids = match role
          RoleQuantifies => IdMap.keys (qualifierAuthIds mono Tip)
          _ => []
        (
          fold
            (m id => IdMap.set id (index :: optionOr [] (IdMap.get id m)) m)
            acc
            ids,
          index + 1,
        ))
      (Tip, 0)
      members
  ScopeRoles {
    rlQuantified =
      IdMap.foldlWithKey
        (acc id indices => match indices
          [index] => IdMap.set id index acc
          _ => acc)
        Tip
        (fst owners),
    rlOutward =
      fold
        (acc (role, mono) => match role
          RoleMonomorphic => authIdsIn mono acc
          _ => acc)
        Tip
        members,
    rlTyped = Some (fold (acc (_, mono) => authIdsIn mono acc) Tip members),
    rlMemberAuths = _ => map ((_, mono) => authIdsIn mono Tip) members,
  }

residualsOf : Int -> List (Int, AuthResidual) -> List AuthResidual
residualsOf index residuals =
  flatMap ((owner, r) => if owner == index then [r] else []) residuals

-- a top-level clause is a value if it has params (function) or a non-expansive RHS
memberClauseIsValue : TcEnv -> (List Pat, Expr) -> Bool
memberClauseIsValue env ([], rhs) = isNonexpansive env rhs
memberClauseIsValue env (_, _) = True

-- ── polymorphic signature over an expansive body ─────────────────────────────
-- HM-CORE-SEMANTICS §1 clause 4 / DICT-SEMANTICS §4.1 G2.  A signed member whose
-- signature quantifies a type variable but whose clauses are not syntactic values
-- cannot generalize to what it declares: `sccSchemes` keeps it monomorphic, and
-- the declared scheme would otherwise be exported over a body that carries no
-- dictionary parameter — `check` narrowed it silently to its first use while
-- `build` panicked on an unbound witness (the former "point-free constrained
-- CAF", `sumOf : (Foldable t, Num a) => t a -> a ; sumOf = fold (+) 0`).  Reject
-- at the definition and name the remedy.
checkSigsOverExpansive : TcEnv ->
  OrdMap (List (List Pat, Expr)) ->
  List (String, Ty, List (String, Mono)) ->
  Unit
checkSigsOverExpansive env _ [] = ()
checkSigsOverExpansive env grouped ((m, ty, tvs) :: rest) =
  let _ =
    if not (isEmpty tvs)
      && not (allList (memberClauseIsValue env) (clausesOf m grouped)) then
      pushTypeError
        env.teDyn.dcModule
        "T-SIG-OVER-EXPANSIVE"
        (sigOverExpansiveMsg m ty)
  checkSigsOverExpansive env grouped rest

-- ── signature-too-general check ──────────────────────────────────────────────
-- After body inference, the declared signature's type variables must map to
-- DISTINCT TVar refs.  If two declared tyvars (e.g. `a` and `b` in `a -> b`)
-- collapse to the SAME TVar or become a concrete type, the body is not universal.
-- Recursive calls instantiate the written contract, so silently narrowing its
-- definition can also change dictionary arity underneath those calls.
checkSigsTooGeneral : ModuleCtx ->
  List (String, Ty, List (String, Mono)) ->
  Unit
checkSigsTooGeneral mctx [] = ()
checkSigsTooGeneral mctx ((m, ty, tvs) :: rest) =
  let _ = checkSigTooGeneral mctx m ty tvs
  checkSigsTooGeneral mctx rest

checkSigTooGeneral : ModuleCtx -> String -> Ty -> List (String, Mono) -> Unit
checkSigTooGeneral mctx name ty tvs =
  let tvarIds = sigTvarIds (map snd tvs)
  match groundedSignatureVariable tvs
    Some (vname, actual) =>
      pushTypeErrorOnceAt
        mctx
        "T-TYPE-TOO-GENERAL"
        (firstTyLoc ty)
        "type variable `\{vname}` in the signature of `\{name}` must remain universal, but the body requires `\{ppMono actual}`; write that type in the signature or make the body work for every `\{vname}`"
    None =>
      if hasDupI tvarIds then
        pushTypeError mctx "T-TYPE-TOO-GENERAL" (sigTooGeneralMsg name ty)

groundedSignatureVariable : List (String, Mono) -> Option (String, Mono)
groundedSignatureVariable [] = None
groundedSignatureVariable ((name, mono) :: rest) = match normalize mono
  TVar _ => groundedSignatureVariable rest
  actual => Some (name, actual)

-- The third way a declared variable stops being universal: a value-restricted
-- sibling in the same group shares it.  `sccSchemes` keeps that sibling
-- monomorphic (it is evaluated once, so it has one type), which fixes the signed
-- member's declared variable to that one evaluation; the group can neither
-- generalize the variable for the sibling nor default it for the signed member,
-- and publishing the sibling with the variable free would let a later use pick
-- the type after the shared value already ran.  Reported at the signature, like
-- the grounded and collapsed forms, because the contract is what the body fails.
-- A signed expansive member is `checkSigsOverExpansive`'s case and is skipped here.
checkSigsFixedByExpansive : TcEnv ->
  OrdMap (List (List Pat, Expr)) ->
  List ScopedMember ->
  List (String, Ty, List (String, Mono)) ->
  Unit
checkSigsFixedByExpansive env grouped members sigTvMaps =
  let fixed =
    flatMap
      (member =>
        if member.smSigned.value
          || allList
            (memberClauseIsValue env)
            (clausesOf member.smName grouped) then
          []
        else
          map (id => (id, member.smName)) (monoUnboundIds member.smMono))
      members
  match fixed
    [] => ()
    _ => checkSigsFixedBy env.teDyn.dcModule fixed sigTvMaps

checkSigsFixedBy : ModuleCtx ->
  List (Int, String) ->
  List (String, Ty, List (String, Mono)) ->
  Unit
checkSigsFixedBy mctx _ [] = ()
checkSigsFixedBy mctx fixed ((name, ty, tvs) :: rest) =
  let _ = match sigVarFixedBy fixed tvs
    Some (vname, sibling) =>
      pushTypeErrorOnceAt
        mctx
        "T-TYPE-TOO-GENERAL"
        (firstTyLoc ty)
        "type variable `\{vname}` in the signature of `\{name}` must remain universal, but the zero-argument sibling `\{sibling}` shares it and is evaluated once; give `\{sibling}` a parameter or declare its monomorphic type"
    None => ()
  checkSigsFixedBy mctx fixed rest

sigVarFixedBy : List (Int, String) ->
  List (String, Mono) ->
  Option (String, String)
sigVarFixedBy _ [] = None
sigVarFixedBy fixed ((vname, mono) :: rest) = match normalize mono
  TVar cell => match fixedSibling (tyvarId cell) fixed
    Some sibling => Some (vname, sibling)
    None => sigVarFixedBy fixed rest
  _ => sigVarFixedBy fixed rest

fixedSibling : Int -> List (Int, String) -> Option String
fixedSibling _ [] = None
fixedSibling id ((i, sibling) :: rest)
  | i == id = Some sibling
  | otherwise = fixedSibling id rest

-- true if the list has any duplicate Int
hasDupI : List Int -> Bool
hasDupI [] = False
hasDupI (x :: xs) = containsI x xs || hasDupI xs

-- #11 soundness (ALWAYS-ON): for each generalized member, record the deferred impl
-- obligations it quantifies over — an addedObls entry whose discriminating mono is a
-- TVar among the member's scheme ids becomes (iface, that id).  A signed member's
-- declared `=>` constraints come from its sig instead (registered via funConstraints);
-- but recording the inferred obligation list here too is harmless (a satisfiable
-- concrete instantiation passes; an unsatisfiable one SHOULD error).  Runs on every
-- path (NOT gated on dictEligibleSetRef), so the plain check path catches the hole.
-- SOURCING (#619 DECLARED-ONLY; supersedes the #607/#610 UNION): the predicates a
-- binding abstracts are its PRINCIPAL context, and per DICT-SEMANTICS §4 `gen`/`var`
-- an ASCRIBED signature IS that context — a contract the body must satisfy, not a
-- floor it can raise (Jones; Hall-Peyton-Jones-Wadler; Haskell).  So:
--   • SIGNED binding   → obligations come SOLELY from the declared `=>` context
--       (declaredSchemeOblsFor).  The body's inferred obligations
--       (schemeObligationsOf / forwardedVecObls) are NOT merged in — they are
--       CHECKED as entailed by the declared context (checkSigConstraintCoverage);
--       a body that genuinely needs MORE than the signature declares is a def-site
--       type error (T-MISSING-CONSTRAINT), not a silent widening.
--   • UNSIGNED binding → no declared context exists, so the inferred principal
--       context stands: direct body dispatch (schemeObligationsOf) plus any
--       constraint forwarded from a constrained callee (forwardedVecObls).  Its
--       inferred constraints are promoted, not checked (see checkSigConstraintOne).
-- #610 stays satisfied: a declared constraint the body never dispatches on
-- (`sz2 : Sz a => a -> Int; sz2 x = 9`) is still sourced from declaredSchemeOblsFor,
-- so the scheme keeps `Sz a` and every caller discharges it.  #619 additionally drops
-- the union's redundant superclass display — `when : Thenable m => …` whose body's
-- `pure` infers Applicative now renders just `Thenable a =>` (Applicative is entailed
-- by `Thenable requires Applicative`, so it is checked-and-dropped, not merged).
-- #837: [memberDefIds] carries each TOP-LEVEL member's binding id (processSCC passes
-- schemeDefIdsRef); the local/where call sites pass omEmpty so their members key under
-- the sentinel id 0.  A member absent from [memberDefIds] is a local/where binder → 0.
registerSchemeObligations : ModuleCtx ->
  OrdMap Int ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, List Mono, Option Loc) ->
  List UObligation ->
  List (String, Scheme) ->
  Unit
registerSchemeObligations mctx _ _ _ _ [] = ()
registerSchemeObligations mctx memberDefIds sigTvMaps callObls addedObls ((m, sch) :: rest) =
  -- #838 I2 / #827: record this binding's QUANTIFIED (generalized) var ids as
  -- caller-deferrable.  A var this binding ∀-quantifies is FORWARDED to its callers
  -- (each use re-instantiates it fresh), so an end-of-run call obligation carrying
  -- that exact id is this binding's own deferred predicate — undeterminedGoalExempt
  -- defers it into the scheme instead of a spurious `Ambiguous instance` reject.
  -- CRITICAL (S0 #855-review): this uses the POST-generalization `schemeIds`, NOT the
  -- pre-generalization member monos.  A value-restricted intermediate (`let x = mk n`,
  -- `mk : Int -> a`) does NOT quantify its var (`Forall []`), so an escaped ambiguous
  -- var never enters this set and the undetermined-goal verdict rejects it (a1_greet/a1_letleak).
  mctx.mcCells.deferrableVarIds :=
    idSetInsertAll (schemeIds sch) mctx.mcCells.deferrableVarIds.value
  let obs =
    dedupVecObls (schemeOblsForMember mctx sigTvMaps callObls addedObls m sch)
  let _ =
    if isEmptyL obs then
      ()
    else
      let defId = optionOr 0 (omLookup m memberDefIds)
      mctx.mcCells.schemeObligationsRef :=
        ((m, defId), obs) :: mctx.mcCells.schemeObligationsRef.value
  registerSchemeObligations mctx memberDefIds sigTvMaps callObls addedObls rest

-- #619: a SIGNED binding's scheme context is EXACTLY its declared `=>` predicates
-- (authoritative); an UNSIGNED binding's is its inferred principal context (direct
-- dispatch + forwarded).  Signedness is `lookupSigTvMap … = Some` — true for any
-- signed member, including a signed binding with an EMPTY `=>` (whose declared
-- context is correctly empty), which is what distinguishes it from an unsigned one.
schemeOblsForMember : ModuleCtx ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, List Mono, Option Loc) ->
  List UObligation ->
  String ->
  Scheme ->
  List VecObl
schemeOblsForMember mctx sigTvMaps callObls addedObls m sch =
  match lookupSigTvMap m sigTvMaps
    Some _ => declaredSchemeOblsFor mctx sigTvMaps m (schemeIds sch)
    None =>
      schemeObligationsOf mctx True (schemeIds sch) addedObls
        ++ forwardedVecObls mctx True (schemeIds sch) callObls

-- the DECLARED `=>` predicates of signed member [m], each as its argument vector of
-- scheme-quantified tyvar ids.  A predicate is kept only if EVERY argument is a plain
-- tyvar that instantiated to one of this scheme's quantified vars: a concrete-grounded
-- argument (`Sz Int =>`) carries no per-use obligation here, and a partial vector would
-- be a different predicate.  An unsigned member contributes nothing.
declaredSchemeOblsFor : ModuleCtx ->
  List (String, Ty, List (String, Mono)) ->
  String ->
  List Int ->
  List VecObl
declaredSchemeOblsFor mctx sigTvMaps m boundIds =
  match lookupSigTvMap m sigTvMaps
    None => []
    Some (ty, tvMap) =>
      flatMap (declaredOblOne mctx boundIds tvMap) (sigConstraintsOf ty)

declaredOblOne : ModuleCtx ->
  List Int ->
  List (String, Mono) ->
  Constraint ->
  List VecObl
declaredOblOne mctx boundIds tvMap (Constraint { constraintHead = iface, constraintArgs = args, constraintOrigin = co }) =
  -- U1b (#1482): `constraintOrigin` is the #1110 interface-OCCURRENCE identity of the
  -- `=>` predicate as written in this module's scope — the same layer `DImpl.implOrigin`
  -- is stamped in, which is what makes the goal and the impl comparable.
  let ifref = IfaceRef { irName = iface, irOrigin = co }
  match constraintArgMonos args tvMap
    None => declaredOblMixed mctx boundIds ifref tvMap args
    Some monos => match boundTyvarIds boundIds monos
      Some ids => [VecObl { voIface = ifref, voIds = ids, voArgs = [] }]
      None => []

-- #1161 SYMPTOM 2: the predicate has an argument that is not a bare tyvar, so
-- `constraintArgMonos` answered `None` and the WHOLE predicate used to be discarded —
-- `Ix a Bool =>` with no `impl Ix _ Bool` anywhere reached neither the displayed scheme
-- nor any caller's obligation list, and `check` accepted it at exit 0 while the call
-- dispatched to an unrelated impl.  DICT-SEMANTICS §3 makes `match(IE, Ix Int Bool)`
-- empty and the goal a missing-instance rejection, so the predicate must survive the
-- channel: record its WHOLE argument vector in `voArgs`, and the ids of its bare-tyvar
-- positions in `voIds` (one dict slot per deferred variable, unchanged cardinality).
--
-- 🚨 THE ADMISSION TEST IS DELIBERATELY NARROW, AND EVERY CLAUSE OF IT IS LOAD-BEARING —
-- this is a NARROWING (programs that were accepted now reject), so an argument this
-- function admits without being able to instantiate CORRECTLY would substitute to a
-- wrong-but-CONCRETE goal, which is strictly worse than the missing one it replaces:
--   * a BARE tyvar bound by this scheme — `recordSchemeCallObligations` maps it through
--     the call's instantiation subst, exactly as the ids-only path always did;
--   * a GROUND argument (no tyvars anywhere, `monoTyvarIds` empty) — it needs no
--     substitution, so the signature's mono IS the call's mono;
--   * #1937: a STRUCTURED argument whose tyvar leaves are ALL bound by this scheme
--     (`Conv (Wrap a) b =>`) — `substOblArgs` now walks `TApp`/`TFun` structurally and
--     substitutes at each leaf, so the caller's goal is `Conv (Wrap Char) Bool`, not the
--     signature's own cell.  Before that walk existed this class HAD to be dropped, and
--     the two halves must stay together: admitting without the structural walk
--     substitutes to a wrong-but-CONCRETE goal;
--   * nothing else.  An unbound tyvar — bare, or as a leaf of a structured argument —
--     has no id to defer on and is dropped exactly as before.
-- At least one bare bound tyvar is REQUIRED: a fully ground declared context (`Sz Int =>`)
-- carries no per-use obligation on this channel and stays dropped, which keeps the
-- narrowing to the shape the issue is about.
declaredOblMixed : ModuleCtx ->
  List Int ->
  IfaceRef ->
  List (String, Mono) ->
  List Ty ->
  List VecObl
declaredOblMixed mctx boundIds ifref tvMap args =
  let monos = map (fromAstType mctx tvMap) args
  let ids = flatMap (declaredOblArgId boundIds) monos
  if isEmptyL ids
    || not (allList (declaredOblArgOk (i => containsI i boundIds)) monos) then
    []
  else
    [VecObl { voIface = ifref, voIds = ids, voArgs = monos }]

-- the monos a predicate's arguments resolve to under a tyvar-name -> mono map, in
-- declaration order; None if ANY argument is not a plain tyvar or is absent from the
-- map (a partial vector is a DIFFERENT predicate, so the whole thing is dropped).
-- Shared by the declared-context sourcing and recordSigConstraintArgs.
constraintArgMonos : List Ty -> List (String, Mono) -> Option (List Mono)
constraintArgMonos [] _ = Some []
constraintArgMonos (a :: rest) tvMap = match constraintArgMono a tvMap
  None => None
  Some mono => map (mono :: _) (constraintArgMonos rest tvMap)

-- the mono ONE predicate argument resolves to: None unless it is a plain tyvar
-- present in [tvMap] (a concrete-grounded argument like `Sz Int =>` carries no
-- per-use obligation here).
constraintArgMono : Ty -> List (String, Mono) -> Option Mono
constraintArgMono a tvMap = match constraintArgVarName a
  None => None
  Some v => lookupAssoc v tvMap

lookupSigTvMap : String ->
  List (String, Ty, List (String, Mono)) ->
  Option (Ty, List (String, Mono))
lookupSigTvMap _ [] = None
lookupSigTvMap m ((n, ty, tvMap) :: rest)
  | m == n = Some (ty, tvMap)
  | otherwise = lookupSigTvMap m rest

-- #242: routed through the canonical O(n·log n) `support.util.dedupBy` (was a
-- private O(n²) `List`-as-a-set scan).  The iface name is length-prefixed and
-- the id VECTOR is comma-joined — ints carry no comma, so the encoding is
-- injective over both components.
-- ⚠️ Keyed on the SPELLING (`voIface.irName`), deliberately: this dedup decides what a
-- binding's DISPLAYED and re-instantiated scheme context is, and keying it on identity
-- would split one printed `Num a =>` into two.  U1b (#1482) carries identity through the
-- payload without changing what counts as the same entry.
dedupVecObls : List VecObl -> List VecObl
dedupVecObls xs = dedupBy vecOblKey xs

-- #1161: the GROUND half of the vector joins the key.  `(Ix a Bool, Ix a Char)` is two
-- predicates sharing one interface AND one id vector — without the ground positions the
-- dedup would collapse them into one, silently dropping half a declared context.  An
-- ids-only entry contributes a constant empty suffix, so its key is order-equivalent to
-- the pre-widening one.
-- S-nonlead-arg-identity (#1904) made `oblArgKey` structural and id-carrying.  On THIS
-- channel that is mostly redundant — `voIds` already carries every position's id — but
-- not entirely: `voIds` is a FLATTENED concatenation with no position boundaries, so
-- `Ix (Pair a b) (Pair c d)` and `Ix (Pair a c) (Pair b d)` shared both `voIds` and the
-- old head-name-only suffix.  The partition this key induces is strictly FINER than
-- before and identical on bare-tyvar vectors (the shape `dedupVecObls`' spelling caveat
-- above is about), so a printed `Num a =>` still does not split.
vecOblKey : VecObl -> String
vecOblKey o =
  "\{lenKey o.voIface.irName}\{joinWith "," (map intToString o.voIds)}|\{joinWith "," (map oblArgKey o.voArgs)}"

-- membership of ONE vector in the DECLARED set (reportUncoveredVec) — not a
-- dedup, and the declared set is a handful of entries, so it stays a scan.
containsVecObl : VecObl -> List VecObl -> Bool
containsVecObl _ [] = False
containsVecObl o (o2 :: rest) =
  sameIfaceDecl o.voIface o2.voIface && eqIntList o.voIds o2.voIds
    || containsVecObl o rest

eqIntList : List Int -> List Int -> Bool
eqIntList [] [] = True
eqIntList (a :: xs) (b :: ys) = a == b && eqIntList xs ys
eqIntList _ _ = False

-- the (iface, var-id VECTOR) entries of the obligations whose discriminating monos are
-- all quantified ids of this scheme.  Deduped on (iface, ids).
schemeObligationsOf : ModuleCtx ->
  Bool ->
  List Int ->
  List UObligation ->
  List VecObl
schemeObligationsOf mctx generalizing boundIds obls =
  flatMap
    (vecOblOfPred mctx generalizing boundIds)
    (flatMap (oblPredOf mctx.mcGraph) obls)

-- a single recorded predicate contributes ONE joint (iface, ids) entry iff EVERY one of
-- its dispatch monos is a bound tyvar of the scheme.  Before #607 the multi-mono case
-- fell into a `_ => []` wildcard and the obligation was DISCARDED — which is why an
-- unsatisfiable `Ix a i =>` reached neither the displayed scheme nor any caller's
-- obligation list, and `check` accepted it at exit 0 while the built binary did raw
-- pointer arithmetic.
-- #1549: a predicate whose argument vector is NOT all bare bound tyvars is no longer
-- simply discarded — it is first REDUCED by §3 entailment (`residualVecObls`), and the
-- residual that reduction leaves over this scheme's own quantified vars is deferred
-- here.  Dropping it outright is what severed `nest x = tagOf (Wrap x)` from its
-- `Tag a` (DICT-SEMANTICS §4 `gen` / §4.2 OD2).
vecOblOfPred : ModuleCtx ->
  Bool ->
  List Int ->
  (IfaceRef, List Mono, Option Loc) ->
  List VecObl
vecOblOfPred mctx generalizing boundIds (iface, ds, loc) =
  match boundTyvarIds boundIds ds
    Some ids => [VecObl { voIface = iface, voIds = ids, voArgs = [] }]
    None => residualVecObls mctx generalizing boundIds iface ds loc

-- ── #1549: residual reduction at `gen` ──────────────────────────────────────
-- DICT-SEMANTICS §4 `gen` makes a binding's principal context `P'` = "the predicates
-- DEFERRED to this binding", and §4.2 OD2 says a non-ground predicate defers to the
-- binder that quantifies its variables.  A predicate like `Tag (Wrap t)` is neither
-- deferrable as written (its head is concrete, so it is not `P'`) nor dischargeable
-- (its `t` is generalizable): §3 `inst` reduces it against `impl Tag (Wrap a) requires
-- Tag a`, and the RESIDUAL `Tag t` is what defers.  Reducing here is what makes the
-- deferral OD2 already performs on the CHECK side (`undeterminedGoalExempt`
-- defers `Tag t` "to the caller") actually reach a caller: without the residual in the
-- scheme there is no context for `(var)` to discharge and no `λd̄.` for `gen` to
-- abstract, so `check` was silent, `run` fell back to declaration order, and the built
-- binary read a dict word that was never passed (issue 1549, S0).
--
-- Deliberately the FALLBACK arm only: when every argument is already a bound tyvar the
-- predicate IS its own residual and the direct path above owns it, so this returns []
-- for that case and the behaviour of every predicate that reached a VecObl before is
-- unchanged.  A predicate mentioning none of this scheme's quantified vars can have no
-- residual over them either (grounding is monotone), and is rejected by the cheap guard
-- before any impl lookup — that keeps the common ground obligation (`Display String`)
-- off the reduction path entirely.
--
-- 🚨 [loc] IS LOAD-BEARING AND IS NOT DECORATION — DROPPING IT MOVES A DIAGNOSTIC.
-- `residualPredsOf` reaches `findMatchingImplReqsU`, which asks the min⊑ selector WHICH
-- impl matched — so this is a SECOND goal-posing site outside the five resolver drains
-- (the first is `checkNestedReqs`, whose header says the same thing).  When the goal is
-- ambiguous the selector calls `reportAmbiguousOverlap`, which reads the context's `sxSite` and
-- falls back to the record's `mcLoc` when it is `None`.  At a generalized group's close
-- that is the construct around the close, not the site that recorded the
-- predicate; and because `pushTypeErrorOnceAt` dedups on the message, that badly-located
-- push WINS over the well-located one a later resolver drain would emit.
-- MEASURED on `test/dict_fixtures/s6-c1-rigid-goal-no-call-discriminator.mdk`
-- (`firstRow xss = index xss 0`): with the recorded loc dropped, the caret moved off the
-- `index` call at 29:15 onto the literal `0` at 29:25 — same code, same message, worse
-- span, and NO gate saw it because the dict-semantics gate asserted the code alone.
-- So hand the reduction a context whose `sxSite` is the obligation's OWN snapshotted span,
-- as `checkNestedReqs` does; a walk outside a drain gets no site and the selector falls
-- back rather than inheriting a stale span.
residualVecObls : ModuleCtx ->
  Bool ->
  List Int ->
  IfaceRef ->
  List Mono ->
  Option Loc ->
  List VecObl
residualVecObls mctx generalizing boundIds iface ds loc =
  map
    keepBoundResidual
    (residualBoundPreds (siteFor mctx) generalizing boundIds iface ds loc)

-- ⚠️ `voArgs` IS THE ids-only `[]` FOR AN ALL-BARE RESIDUAL AND THE WHOLE VECTOR FOR A
-- MIXED ONE — the same split `declaredOblOne` makes between its own arm and
-- `declaredOblMixed`, so the OBLIGATION channel's readers (`substVecOblArgs`,
-- `dedupVecObls`, `reportUncoveredVec`) see, for each shape, precisely the shape they
-- have always seen from the declared channel.  Every residual that reached a `VecObl`
-- before this change is all-bare by construction (it came through `boundTyvarIds`), so
-- its entry is byte-identical; the mixed entries are the ones #1905 adds.
-- The argument vector the DICT channel consumes (`funConstraintArgsRef`) is the third
-- component of the triple and is unaffected by this projection.
keepBoundResidual : (IfaceRef, List Int, List Mono) -> VecObl
keepBoundResidual (iface, ids, args) =
  VecObl { voIface = iface, voIds = ids, voArgs = residualOblArgs ids args }

-- 🚨 #1937: THIS TEST USED TO BE `listLen ids == listLen args`, AND THAT EQUIVALENCE DIED
-- WITH THE ADMISSION WIDENING.  It relied on `declaredOblArgId` contributing exactly one
-- id per BARE-tyvar position and none for anything else, so equal lengths meant "every
-- position is a bare tyvar".  Now that a STRUCTURED argument contributes its own bound
-- leaves, `Conv (Wrap a) b` has two ids for two arguments and would have taken the
-- ids-only `[]` arm — instantiating through `substMonos o.voIds` to the goal `Conv a b`,
-- i.e. silently DROPPING the `Wrap`.  Ask the structural question directly instead:
-- every position a bare tyvar, and each of them one of [ids] (a bare variable the
-- scheme does not quantify contributes no id, and the ids-only arm would drop it).
residualOblArgs : List Int -> List Mono -> List Mono
residualOblArgs ids args
  | allList isBareTyvarMono args && listLen ids == listLen args = []
  | otherwise = args

firstMethodRow : List MethodSchemeRow -> MethodSchemeRow
firstMethodRow (row :: _) = row
firstMethodRow [] = panic "method-row observer expected a row"

observeMethodSchemeRowsForTest : Unit -> MethodRowTestObservation
observeMethodSchemeRowsForTest _ =
  let graph1 = probeGraphCtx ()

  let rows1 = initialModuleCtx graph1
  let constrainedRow =
    firstMethodRow (ifaceMethodSchemeRows rows1 [methodRowTestFoldMapDecl])
  let constrainedIds = schemeIds constrainedRow.msrScheme
  let constrainedSlots = constrainedRow.msrMethodSlots
  let constrainedBoundIds = methodSlotBoundIds constrainedSlots
  let constrainedPositions = methodSlotPositions constrainedSlots
  let constrainedIdsAtPositions =
    methodSlotIdsAtPositions constrainedIds constrainedSlots
  let constrainedArgumentIds = methodSlotArgumentIds constrainedSlots

  let graph2 = freshSubRecordsOf graph1
  let rows2 = carryModuleCtx graph2 rows1
  let counterBefore = graph2.graphRun.tyvarCounter.value
  let firstRow =
    firstMethodRow (ifaceMethodSchemeRows rows2 [methodRowTestFoldMapDecl])
  let counterAfterFirst = graph2.graphRun.tyvarCounter.value
  let secondRow =
    firstMethodRow (ifaceMethodSchemeRows rows2 [methodRowTestFoldMapDecl])
  let counterAfterSecond = graph2.graphRun.tyvarCounter.value
  let firstSchemeIds = schemeIds firstRow.msrScheme
  let secondSchemeIds = schemeIds secondRow.msrScheme
  let firstRowSlotIds = methodSlotBoundIds firstRow.msrMethodSlots
  let secondRowSlotIds = methodSlotBoundIds secondRow.msrMethodSlots
  let registryAfterSecondSlotIds =
    methodRowRegistrySlotIds rows2 (methodSlotKey firstRow.msrIface "foldMap")

  let graph3 = freshSubRecordsOf graph1
  let rows3 = carryModuleCtx graph3 rows2
  let sameNameForward =
    methodRowSameNameView
      (ifaceMethodSchemeRows rows3 [methodRowTestSameA, methodRowTestSameB])
  let graph4 = freshSubRecordsOf graph1
  let rows4 = carryModuleCtx graph4 rows3
  let sameNameReverse =
    methodRowSameNameView
      (ifaceMethodSchemeRows rows4 [methodRowTestSameB, methodRowTestSameA])

  let graph5 = freshSubRecordsOf graph1
  let rows5 = carryModuleCtx graph5 rows4
  let constantRows = ifaceMethodSchemeRows rows5 [methodRowTestConstantDecl]
  let constantRow = firstMethodRow constantRows
  let constantBodyIsFunction =
    match normalize (schemeBodyOf constantRow.msrScheme)
      TFun _ _ _ => True
      _ => False

  let graph6 = freshSubRecordsOf graph1
  let rows6 = carryModuleCtx graph6 rows5
  let attributed = DAttrib [] methodRowTestFoldMapDecl
  let attributedRows = ifaceMethodSchemeRows rows6 [attributed]
  let attributedMethods =
    methodEnvGo
      graph6
      [declEnvModule graph6 0 "foldable-test" [attributed]]
      emptyMethodEnv
  let (attributedParamIface, attributedParamTyparams) =
    match optionOr [] (omLookup "foldMap" attributedMethods.meByName)
      [] => ("", [])
      r :: _ => match r.mrEntry
        (iface, typarams, _, _) => (iface.irName, typarams)

  let directNum =
    methodRowTestNum
      "direct-num"
      (TyFun (tyConBuiltin "String" None) (TyVar "a"))
  let attributedNum =
    DAttrib
      []
      (methodRowTestNum
        "attributed-num"
        (TyFun (tyConBuiltin "Int" None) (TyVar "a")))
  let builtinNum =
    methodRowTestNum "builtin-num" (TyFun (tyConBuiltin "Int" None) (TyVar "a"))
  let numAnchors = [
    methodRowNumObservation rows6 "attrOnly" [attributedNum] [attributedNum],
    methodRowNumObservation rows6 "directOnly" [directNum] [directNum],
    methodRowNumObservation
      rows6
      "attrThenDirect"
      [attributedNum, directNum]
      [attributedNum, directNum],
    methodRowNumObservation
      rows6
      "directThenAttr"
      [directNum, attributedNum]
      [directNum, attributedNum],
    methodRowNumObservation
      rows6
      "builtinThenUser"
      [builtinNum]
      [builtinNum, methodRowTestUserFromInt],
    methodRowNumObservation
      rows6
      "userThenBuiltin"
      [builtinNum]
      [methodRowTestUserFromInt, builtinNum],
  ]

  let observation = MethodRowTestObservation {
    mrtoSchemeIds = constrainedIds,
    mrtoSlotBoundIds = constrainedBoundIds,
    mrtoSlotPositions = constrainedPositions,
    mrtoSlotIdsAtPositions = constrainedIdsAtPositions,
    mrtoSlotArgumentIds = constrainedArgumentIds,
    mrtoCounterBefore = counterBefore,
    mrtoCounterAfterFirst = counterAfterFirst,
    mrtoCounterAfterSecond = counterAfterSecond,
    mrtoFirstSchemeIds = firstSchemeIds,
    mrtoSecondSchemeIds = secondSchemeIds,
    mrtoFirstRowSlotIds = firstRowSlotIds,
    mrtoSecondRowSlotIds = secondRowSlotIds,
    mrtoRegistryAfterSecondSlotIds = registryAfterSecondSlotIds,
    mrtoSameNameForward = sameNameForward,
    mrtoSameNameReverse = sameNameReverse,
    mrtoConstantRowCount = listLen constantRows,
    mrtoConstantSchemeIdCount = listLen (schemeIds constantRow.msrScheme),
    mrtoConstantBodyIsFunction = constantBodyIsFunction,
    mrtoConstantSlotCount = listLen constantRow.msrMethodSlots,
    mrtoAttributedRowCount = listLen attributedRows,
    mrtoAttributedParamIface = attributedParamIface,
    mrtoAttributedParamTyparams = attributedParamTyparams,
    mrtoNumAnchors = numAnchors,
  }
  observation

methodRowSlotAllocationProbe : Unit ->
  (List Int, List (List Int), List (List Int), List (List Int), List (List Int))
methodRowSlotAllocationProbe _ =
  let observed = observeMethodSchemeRowsForTest ()
  (
    observed.mrtoSchemeIds,
    observed.mrtoSlotBoundIds,
    observed.mrtoSlotPositions,
    observed.mrtoSlotIdsAtPositions,
    observed.mrtoSlotArgumentIds,
  )

-- > methodRowSlotAllocationProbe ()
-- ([0, 1, 2], [[1]], [[1]], [[1]], [[1]])

methodRowFreshnessProbe : Unit ->
  ((Int, Int, Int, List Int, List Int), (List (List Int), List (List Int), List (List Int)))
methodRowFreshnessProbe _ =
  let observed = observeMethodSchemeRowsForTest ()
  (
    (
      observed.mrtoCounterBefore,
      observed.mrtoCounterAfterFirst,
      observed.mrtoCounterAfterSecond,
      observed.mrtoFirstSchemeIds,
      observed.mrtoSecondSchemeIds,
    ),
    (
      observed.mrtoFirstRowSlotIds,
      observed.mrtoSecondRowSlotIds,
      observed.mrtoRegistryAfterSecondSlotIds,
    ),
  )

-- > methodRowFreshnessProbe ()
-- ((0, 3, 6, [0, 1, 2], [3, 4, 5]), ([[1]], [[4]], [[1]]))

methodRowDeclarationProbe : Unit ->
  (List (String, String, Int, Int), List (String, String, Int, Int), (Int, Int, Bool, Int))
methodRowDeclarationProbe _ =
  let observed = observeMethodSchemeRowsForTest ()
  (
    observed.mrtoSameNameForward,
    observed.mrtoSameNameReverse,
    (
      observed.mrtoConstantRowCount,
      observed.mrtoConstantSchemeIdCount,
      observed.mrtoConstantBodyIsFunction,
      observed.mrtoConstantSlotCount,
    ),
  )

-- > methodRowDeclarationProbe ()
-- ([("A", "same", 0, 0), ("A", "extra", 0, 0), ("B", "same", 1, 1)], [("B", "same", 1, 1), ("A", "same", 0, 0), ("A", "extra", 0, 0)], (1, 0, False, 0))

methodRowNumericAnchorProbe : Unit ->
  (Int, String, List String, List (String, Bool, Bool, String, String))
methodRowNumericAnchorProbe _ =
  let observed = observeMethodSchemeRowsForTest ()
  (
    observed.mrtoAttributedRowCount,
    observed.mrtoAttributedParamIface,
    observed.mrtoAttributedParamTyparams,
    map numAnchorObservationView observed.mrtoNumAnchors,
  )

-- > methodRowNumericAnchorProbe ()
-- (0, "Foldable", ["t"], [("attrOnly", False, False, "", ""), ("directOnly", True, True, "String -> a", "String -> a"), ("attrThenDirect", False, False, "", ""), ("directThenAttr", True, True, "String -> a", "String -> a"), ("builtinThenUser", True, True, "Int -> a", "Int -> a"), ("userThenBuiltin", True, True, "Int -> a", "Int -> a")])

methodReturnProbeRequest : ModuleCtx -> MethodSchemeRow -> MethodReturnRequest
methodReturnProbeRequest mctx row =
  let inst = methodReturnProbeOccurrence mctx row
  methodReturnRequest
    mctx
    row
    inst.mtiBody
    inst.mtiSubstitution
    (Some (freshEvId mctx ()))

methodReturnVectorCompletenessProbe : Unit ->
  (Option (List String), Option (List String), Bool, Bool)
methodReturnVectorCompletenessProbe _ =
  let gctx = probeGraphCtx ()
  let mctx = initialModuleCtx gctx
  let _ = methodReturnProbeScope mctx "return-vector"
  let zeroRow =
    firstMethodRow
      (ifaceMethodSchemeRows mctx [
        methodRowTestIface "return-zero" "Zero" [] [
          IfaceMethod
            "make"
            (TyFun (tyConBuiltin "Unit" None) (tyConBuiltin "Int" None))
            None
            None,
        ],
      ])
  let partialRow =
    firstMethodRow
      (ifaceMethodSchemeRows mctx [
        methodRowTestIface
          "return-partial"
          "Partial"
          ["a", "b"]
          [
            IfaceMethod
              "make"
              (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
              None
              None,
          ],
      ])
  let zeroArgs =
    map
      (map ppMono)
      (methodReturnArgs gctx (methodReturnProbeRequest mctx zeroRow))
  let partialArgs =
    map
      (map ppMono)
      (methodReturnArgs gctx (methodReturnProbeRequest mctx partialRow))
  let observed = (
    zeroArgs,
    partialArgs,
    allMethodParamsMentioned zeroRow.msrTyparams zeroRow.msrType,
    allMethodParamsMentioned partialRow.msrTyparams partialRow.msrType,
  )
  observed

-- The absent `b` of `Partial` reads the occurrence's own unbound variable.
-- > methodReturnVectorCompletenessProbe ()
-- (Some [], Some ["Int", "a"], True, False)

export
methodReturnTemplatePresenceProbe : Unit -> (List Bool, List Bool)
methodReturnTemplatePresenceProbe _ =
  let gctx = probeGraphCtx ()
  let mctx = initialModuleCtx gctx
  let present =
    firstMethodRow
      (ifaceMethodSchemeRows mctx [
        methodRowTestIface
          "return-template-present"
          "Present"
          ["a", "b"]
          [
            IfaceMethod
              "make"
              (TyFun
                (tyConBuiltin "Unit" None)
                (TyTuple [TyVar "a", TyVar "b"]))
              None
              None,
          ],
      ])
  let absent =
    firstMethodRow
      (ifaceMethodSchemeRows mctx [
        methodRowTestIface
          "return-template-absent"
          "Absent"
          ["a", "b"]
          [
            IfaceMethod
              "make"
              (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
              None
              None,
          ],
      ])
  let observed = (
    map isSome present.msrPredicateTemplate.mptArguments,
    map isSome absent.msrPredicateTemplate.mptArguments,
  )
  observed

-- Runs in a carry of [prev], the caller's record, in its graph record with a fresh
-- graph run, and returns it beside the codes: it is the record left current.
methodReturnProbeCodes : ModuleCtx ->
  MethodSchemeRow ->
  List Decl ->
  (List String, ModuleCtx)
methodReturnProbeCodes prev ownedRow impls =
  let gctx = GraphCtx { prev.mcGraph | graphRun = freshGraphRun () }
  let mctx = carryModuleCtx gctx prev
  let _ = methodReturnProbeScope mctx "return-owner-checker"
  let foreignRow =
    firstMethodRow
      (ifaceMethodSchemeRows mctx [
        methodReturnProbeIface
          "return-foreign"
          "Foreign"
          (TyFun (tyConBuiltin "Unit" None) (TyVar "a")),
      ])
  let request = methodReturnProbeRequest mctx ownedRow
  let _ = methodReturnProbeSpelling mctx foreignRow
  let _ = recordExactMethodObligation mctx request
  let universe = buildImplUniverse impls
  mctx.mcCells.bodyImplEnvRef := buildFlatImplEnv impls
  let _ = checkCallObligationsU mctx True universe (wAll mctx.mcCells.implObls)
  (map tcCode (reverseL mctx.mcCells.typeErrors.items.value), mctx)

-- Runs in a carry of [prev], the caller's record, in its graph record with a fresh
-- graph run.
methodReturnProbeStamp : ModuleCtx ->
  MethodSchemeRow ->
  MethodSchemeRow ->
  List Decl ->
  (String, String, String)
methodReturnProbeStamp prev ownedRow foreignRow impls =
  let gctx = GraphCtx { prev.mcGraph | graphRun = freshGraphRun () }
  let mctx = carryModuleCtx gctx prev
  let scope = methodReturnProbeScope mctx "return-owner-stamper"
  let request = methodReturnProbeRequest mctx ownedRow
  let _ = methodReturnProbeSpelling mctx foreignRow
  let env = buildFlatImplEnv impls
  mctx.mcCells.bodyImplEnvRef := env
  let tagRef = Ref RNone
  let implRef = Ref []
  let resultMono = stripArrows request.mrrOccurrence
  let _ =
    resolveExactReturnSite
      (siteFor mctx)
      omEmpty
      "make"
      tagRef
      implRef
      resultMono
      request
      ""
      None
      scope
  let goals = optionOr [] (methodReturnArgs gctx request)
  let ownedKey =
    match ieSelectRowByIface (siteFor mctx) env ownedRow.msrIface goals
      Some selected => rowRouteKey selected
      None => ""
  let foreignKey =
    match ieSelectRowByIface (siteFor mctx) env foreignRow.msrIface goals
      Some selected => rowRouteKey selected
      None => ""
  (methodReturnProbeRouteKey tagRef.value, ownedKey, foreignKey)

-- The request is created before the spelling table is pointed at Foreign.  The checker
-- must still reject a graph containing only Foreign's impl, its positive control must
-- accept Owner's impl, and the stamper must select Owner's distinct route.
methodReturnOwnershipProbe : Unit -> (List String, List String, Bool, Bool)
methodReturnOwnershipProbe _ =
  let ownedGraph = probeGraphCtx ()
  let ownedDecl =
    methodReturnProbeIface
      "return-owner"
      "Owner"
      (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
  let foreignDecl =
    methodReturnProbeIface
      "return-foreign"
      "Foreign"
      (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
  let ownedCtx = initialModuleCtx ownedGraph
  let ownedRow = firstMethodRow (ifaceMethodSchemeRows ownedCtx [ownedDecl])
  let foreignGraph = GraphCtx { ownedGraph | graphRun = freshGraphRun () }
  let foreignCtx = carryModuleCtx foreignGraph ownedCtx
  let foreignRow =
    firstMethodRow (ifaceMethodSchemeRows foreignCtx [foreignDecl])
  let ownedImpl = methodReturnProbeImpl "return-owner" "Owner"
  let foreignImpl = methodReturnProbeImpl "return-foreign" "Foreign"
  let (rejected, rejectedCtx) =
    methodReturnProbeCodes foreignCtx ownedRow [foreignImpl]
  let (accepted, acceptedCtx) =
    methodReturnProbeCodes rejectedCtx ownedRow [foreignImpl, ownedImpl]
  let (actualKey, ownedKey, foreignKey) = methodReturnProbeStamp
    acceptedCtx
    ownedRow
    foreignRow
    [foreignImpl, ownedImpl]
  let observed = (
    rejected,
    accepted,
    actualKey == ownedKey,
    actualKey /= foreignKey,
  )
  observed

-- > methodReturnOwnershipProbe ()
-- (["T-NO-IMPL"], [], True, True)

export
methodReturnResolutionMutationProbe : Unit -> (Bool, Bool, Bool, Bool)
methodReturnResolutionMutationProbe _ =
  let gctx = probeGraphCtx ()
  let mctx = initialModuleCtx gctx
  let _ = methodReturnProbeScope mctx "return-outcome-validation"
  let ownedDecl =
    methodReturnProbeIface
      "return-owner"
      "Owner"
      (TyFun (tyConBuiltin "Unit" None) (TyVar "a"))
  let ownedRow = firstMethodRow (ifaceMethodSchemeRows mctx [ownedDecl])
  let ownedImpl = methodReturnProbeImpl "return-owner" "Owner"
  mctx.mcCells.bodyImplEnvRef := buildFlatImplEnv [ownedImpl]
  let request = methodReturnProbeRequest mctx ownedRow
  let resolution = solveExactReturnOnce (siteFor mctx) request
  let valid = methodReturnResolutionValid mctx request resolution
  let (wrongSelection, wrongPrerequisites) = match resolution.mrrOutcome
    Solved (InstanceEvidence _ args prerequisites supers) => (
      MethodReturnResolution {
        mrrWanted = resolution.mrrWanted,
        mrrOutcome =
          Solved
            (InstanceEvidence
              (RequestInstanceId (-1))
              args
              prerequisites
              supers),
        mrrSelectedRow = resolution.mrrSelectedRow,
      },
      MethodReturnResolution {
        mrrWanted = resolution.mrrWanted,
        mrrOutcome =
          Solved
            (InstanceEvidence
              (RequestInstanceId (methodReturnSelectedIdentity resolution))
              args
              (PrerequisiteEvidence {
                  prerequisiteInterface =
                    resolution.mrrWanted.predicate.predicateInterface,
                  prerequisiteArguments = args,
                }
                :: prerequisites)
              supers),
        mrrSelectedRow = resolution.mrrSelectedRow,
      },
    )
    _ => panic "ordinary return mutation probe expected instance evidence"
  let wanted = resolution.mrrWanted
  let wrongWanted = Wanted {
    id = wanted.id,
    predicate = wanted.predicate,
    origin = wanted.origin,
    scope = ScopeId 999999,
    destination = wanted.destination,
  }
  let disagreement = MethodReturnResolution {
    mrrWanted = wrongWanted,
    mrrOutcome = resolution.mrrOutcome,
    mrrSelectedRow = resolution.mrrSelectedRow,
  }
  let observed = (
    valid,
    not (methodReturnResolutionValid mctx request wrongSelection),
    not (methodReturnResolutionValid mctx request wrongPrerequisites),
    not (methodReturnResolutionValid mctx request disagreement),
  )
  observed

-- Runs in a carry of [prev], the caller's record, in its graph record with a fresh
-- graph run, and returns it beside the observation: it is the record left current.
methodReturnProbeSlotCase : ModuleCtx ->
  MethodSchemeRow ->
  MethodSchemeRow ->
  Bool ->
  ((List String, List String), ModuleCtx)
methodReturnProbeSlotCase prev ownedRow foreignRow retainOwner =
  let gctx = GraphCtx { prev.mcGraph | graphRun = freshGraphRun () }
  let mctx = carryModuleCtx gctx prev
  let _ = methodReturnProbeScope mctx "return-owner-slots"
  mctx.mcCells.methodPredicateSlotsRef :=
    [(methodSlotKey foreignRow.msrIface "make", foreignRow.msrMethodSlots)]
  let _ = methodReturnProbeSpelling mctx foreignRow
  let env =
    if retainOwner then
      extendMethodRow (envFor mctx) "make" ownedRow
    else
      extendVar (envFor mctx) "make" ownedRow.msrScheme
  let inst = instantiateMethodTracked mctx ownedRow.msrScheme
  let _ =
    unify
      mctx
      (stripArrows inst.mtiBody)
      (tupleMono [tconBuiltin "Int", tconBuiltin "Int"])
  let _ =
    recordSite
      env
      "make"
      ownedRow.msrScheme
      (Ref "")
      (Ref RNone)
      (Ref [])
      (Ref [])
      (Ref innerNone)
      inst.mtiBody
      inst.mtiSubstitution
  (
    (
      methodReturnProbeOblIfaces (wAll mctx.mcCells.obls),
      methodReturnProbeGoalIfaces gctx.graphRun.goals.value,
    ),
    mctx,
  )

-- The retained row owns Seed, the same-name legacy table owns Decoy, and an empty
-- retained row is a known empty answer.  Only the missing-row compatibility control
-- may fall back to Decoy.
methodReturnSlotOwnershipProbe : Unit ->
  ((List String, List String), (List String, List String), (List String, List String))
methodReturnSlotOwnershipProbe _ =
  let ownedGraph = probeGraphCtx ()
  let ownedCtx = initialModuleCtx ownedGraph
  let ownedRow =
    firstMethodRow
      (ifaceMethodSchemeRows ownedCtx [
        methodReturnProbeIface
          "return-owner-slots"
          "OwnedSlots"
          (TyConstrained
            [methodRowTestConstraint "return-seed" "Seed" [TyVar "b"]]
            (TyFun (tyConBuiltin "Unit" None) (TyTuple [TyVar "b", TyVar "a"]))),
      ])
  let emptyGraph = GraphCtx { ownedGraph | graphRun = freshGraphRun () }
  let emptyCtx = carryModuleCtx emptyGraph ownedCtx
  let emptyRow =
    firstMethodRow
      (ifaceMethodSchemeRows emptyCtx [
        methodReturnProbeIface
          "return-empty-slots"
          "EmptySlots"
          (TyFun (tyConBuiltin "Unit" None) (TyVar "a")),
      ])
  let foreignGraph = GraphCtx { ownedGraph | graphRun = freshGraphRun () }
  let foreignCtx = carryModuleCtx foreignGraph emptyCtx
  let foreignRow =
    firstMethodRow
      (ifaceMethodSchemeRows foreignCtx [
        methodReturnProbeIface
          "return-foreign-slots"
          "ForeignSlots"
          (TyConstrained
            [methodRowTestConstraint "return-decoy" "Decoy" [TyVar "b"]]
            (TyFun (tyConBuiltin "Unit" None) (TyTuple [TyVar "b", TyVar "a"]))),
      ])
  let (retained, retainedCtx) =
    methodReturnProbeSlotCase foreignCtx ownedRow foreignRow True
  let (emptied, emptiedCtx) =
    methodReturnProbeSlotCase retainedCtx emptyRow foreignRow True
  let (missing, _) =
    methodReturnProbeSlotCase emptiedCtx ownedRow foreignRow False
  let observed = (retained, emptied, missing)
  observed

-- > methodReturnSlotOwnershipProbe ()
-- ((["Seed"], ["Seed"]), ([], []), (["Decoy"], ["Decoy"]))

-- shatter vector obligations into (interface declaration, id) pairs — the currency of the
-- coverage subset test.  See checkSigConstraintCoverage's header.
-- A signed body's inferred predicate is covered only by the same interface declaration;
-- same spelling from a foreign module is not evidence.
pairsOfVecObls : List VecObl -> List (IfaceRef, Int)
pairsOfVecObls [] = []
pairsOfVecObls (o :: rest) =
  map (id => (o.voIface, id)) o.voIds ++ pairsOfVecObls rest

-- ── signature-constraint soundness check ─────────────────────────────────────
-- For each SIGNED member, the interface constraints its body INFERS on the
-- member's own quantified vars must be covered by the DECLARED `=>` context,
-- closed under the interface `requires` (superclass) graph.  An uncovered
-- inferred constraint ⇒ def-site type_error (the constraint analogue of
-- checkEffectEscape).  Under #619 DECLARED-ONLY this is the SOLE enforcement of the
-- body's inferred obligations: registerSchemeObligations no longer merges them into
-- the scheme, so a body needing more than its signature declares is caught HERE or
-- silently severed.  The inferred obligations are the UNION of the flat-path
-- (schemeObligationsOf over addedObls), the FORWARDED path (forwardedVecObls over the
-- constrained-callee call delta — #619: a signed forwarder that under-declares is no
-- longer backstopped by the union, so it must be checked here), and the marked-path
-- (inferredConstraintIds + ifaceForInferredId) sources — a return-position-method
-- constraint lands only in the last.
-- #607: the PAIR test runs in (iface, var-id) currency on both sides — a multi-param
-- predicate is shattered per argument before the subset test (pairsOfVecObls /
-- declaredPairsFor).  Shattering both sides is sound for a COVERAGE (subset) question
-- — declared `Ix a i` covers inferred `Ix a` and `Ix i` — and it makes the reject
-- direction live at n>=2.  On its own it UNDER-rejects the exotic cross-pairing
-- (declared `Ix a b, Ix c d` vs inferred `Ix a d`: all four pairs a,b,c,d are declared,
-- so pair coverage passes though the JOINT `Ix a d` is undeclared).
-- #619/#607 item 4: reportUncoveredVec closes that gap — an inferred JOINT vector
-- (arity >= 2) whose EXACT argument vector is not among the declared vectors
-- (vector-valued superclass closure, censusSuperCloseVec) is
-- uncovered, and is reported when the pair test did not already flag one of its args.
checkSigConstraintCoverage : ModuleCtx ->
  List ConstraintReg ->
  List (String, Ty) ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, List Mono, Option Loc) ->
  List UObligation ->
  List (String, Scheme) ->
  Unit
checkSigConstraintCoverage mctx _ _ _ _ _ [] = ()
checkSigConstraintCoverage mctx regs sigs sigTvMaps callObls addedObls ((m, sch) :: rest) =
  let _ =
    checkSigConstraintOne mctx regs sigs sigTvMaps callObls addedObls m sch
  checkSigConstraintCoverage mctx regs sigs sigTvMaps callObls addedObls rest

checkSigConstraintOne : ModuleCtx ->
  List ConstraintReg ->
  List (String, Ty) ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, List Mono, Option Loc) ->
  List UObligation ->
  String ->
  Scheme ->
  Unit
checkSigConstraintOne mctx regs sigs sigTvMaps callObls addedObls m sch =
  match omLookup m mctx.mcCells.sigTyMapRef.value
    None => ()  -- unsigned member: its inferred constraints are promoted, not checked
    Some _ =>
      let declaredPairs =
        censusSuperClose mctx.mcGraph (declaredPairsFor m regs)
      let boundIds = schemeIds sch
      let bodyVecs =
        quantifiedVecObls
          boundIds
          (schemeObligationsOf mctx False boundIds addedObls)
      let fwdVecs =
        quantifiedVecObls
          boundIds
          (forwardedVecObls mctx False boundIds callObls)
      let inferredB = inferredIfacePairs mctx m boundIds
      let inferred =
        dedupIfacePairs
          (pairsOfVecObls bodyVecs ++ pairsOfVecObls fwdVecs ++ inferredB)
      let _ = reportUncovered mctx m sigTvMaps declaredPairs inferred
      let declaredVecs =
        censusSuperCloseVec
          mctx.mcGraph
          (declaredSchemeOblsFor mctx sigTvMaps m boundIds)
      reportUncoveredVec
        mctx
        m
        sigTvMaps
        declaredPairs
        declaredVecs
        (bodyVecs ++ fwdVecs)

-- The vectors over [boundIds] alone.  A signature can declare no predicate on a
-- variable it does not quantify, so a residual that mentions one is never this
-- check's to cover: its verdict is the undetermined goal's, or `checkSigVarGoals`'.
quantifiedVecObls : List Int -> List VecObl -> List VecObl
quantifiedVecObls boundIds vecs =
  filterList
    (o =>
      allList (id => containsI id boundIds) (flatMap monoUnboundIds o.voArgs))
    vecs

-- inferred (iface, id) pairs from the marked path: each inferred constraint var id
-- paired with its recovered iface (skip an id whose iface can't be recovered).
inferredIfacePairs : ModuleCtx -> String -> List Int -> List (IfaceRef, Int)
inferredIfacePairs mctx m boundIds =
  flatMap (pairIface mctx m) (inferredConstraintIds mctx m boundIds)

pairIface : ModuleCtx -> String -> Int -> List (IfaceRef, Int)
pairIface mctx m id =
  let ir = ifaceForInferredId mctx m id
  match ir.irName
    "" => []
    _ => [(ir, id)]

-- the declared (iface, id) constraint pairs of member m: each declared constraint
-- mono normalized to its surviving tyvar id (single-param shape; concrete-grounded
-- constraints — no tyvar — carry no dict slot and are skipped).
declaredPairsFor : String -> List ConstraintReg -> List (IfaceRef, Int)
declaredPairsFor m regs = flatMap declaredPairOne (regIfaceMonosFor m regs)

-- #1161 (F-3a-ii): a reg is a triple, so its (iface, mono) component needs a named
-- accessor (`snd`/`lookupAssoc` no longer apply).  Both spellings — first-match by name,
-- and the whole-list projection — are exactly what the two consumers used before.
regIfaceMonosFor : String -> List ConstraintReg -> List (IfaceRef, List Mono)
regIfaceMonosFor _ [] = []
regIfaceMonosFor m (reg :: rest)
  | m == reg.crName = reg.crIfaceMonos
  | otherwise = regIfaceMonosFor m rest

regIfaceMonosOf : ConstraintReg -> List (IfaceRef, List Mono)
regIfaceMonosOf reg = reg.crIfaceMonos

-- U1b (#1482): project a reg's (interface occurrence, mono) pair back to the SPELLING
-- for `gcMonos`, whose only reader (`dictVarSatisfiesIface`) compares
-- interface NAMES.
-- ⚠️ S-dict-arity-contract: a reg entry is now ONE PREDICATE carrying ALL its bare-tyvar
-- monos, so this fans back out to one (name, mono) pair per variable.  Collapsing the
-- SLOT must not collapse the READ-ONLY census this and `declaredPairOne` feed: they
-- answer "is this variable declared at this interface", not "how many dicts", and
-- dropping `b` from `Ix a b =>` would make a body use at `b` UNCOVERED — an
-- over-rejection of a program that type-checks today.
ifaceMonoName : (IfaceRef, List Mono) -> List (String, Mono)
ifaceMonoName (ir, monos) = map (mono => (ir.irName, mono)) monos

declaredPairOne : (IfaceRef, List Mono) -> List (IfaceRef, Int)
declaredPairOne (iface, monos) = map (id => (iface, id)) (abstractSlotIds monos)

-- Superclass closure over declared (iface, id) slots, so prelude super chains
-- (Applicative requires Mappable, Thenable requires Applicative, …) are included.  It
-- only feeds the read-only subset test; no dict slot comes from it.
censusSuperClose : GraphCtx -> List (IfaceRef, Int) -> List (IfaceRef, Int)
censusSuperClose gctx declared =
  map
    (n => (n.superIface, n.superPayload))
    (superClosure
      (superLookup gctx)
      censusSuperStep
      (iface id => ifacePairKey (iface, id))
      declared)

-- A super shares the sub-predicate's lead id (0 for a nullary super) when every one of
-- its parameters is one of the sub's type parameters.
censusSuperStep : List String -> Int -> Super -> Option Int
censusSuperStep typarams id (Super { superParams = params, ... })
  | not (all (p => contains p typarams) params) = None
  | isEmptyL params = Some 0
  | otherwise = Some id

-- #619/#607 item 4: VECTOR-valued superclass closure over declared constraint vectors.
-- Unlike censusSuperClose (which collapses each predicate to per-arg pairs), this
-- preserves the whole argument vector, so an inferred JOINT predicate can be tested for
-- membership as a unit — the exotic cross-pairing `Ix a d` is NOT a member of
-- {`Ix a b`, `Ix c d`} even though every one of its args appears in some declared
-- predicate.  Ungated, like censusSuperClose.  The interface's type parameters map
-- POSITIONALLY onto a predicate's ids, so a multi-param super carries the right per-arg
-- ids; a super's ground argument positions are not recovered.
censusSuperCloseVec : GraphCtx -> List VecObl -> List VecObl
censusSuperCloseVec gctx declared =
  map
    vecOblOfNode
    (superClosure
      (superLookup gctx)
      censusVecSuperStep
      (iface payload =>
        vecOblKey
          (vecOblOfNode SuperNode {
            superPath = [],
            superIface = iface,
            superPayload = payload,
          }))
      (map (o => (o.voIface, (o.voIds, o.voArgs))) declared))

censusVecSuperStep : List String ->
  (List Int, List Mono) ->
  Super ->
  Option (List Int, List Mono)
censusVecSuperStep typarams (ids, _) (Super { superParams = params, ... }) =
  map (mapped => (mapped, [])) (mapAll (p => lookupPos p typarams ids) params)

vecOblOfNode : SuperNode (List Int, List Mono) -> VecObl
vecOblOfNode n =
  let (ids, args) = n.superPayload
  VecObl { voIface = n.superIface, voIds = ids, voArgs = args }

-- one type_error per inferred JOINT vector (arity >= 2) whose exact vector the declared
-- (super-closed) set does not contain.  Skipped when the pair test already flagged one
-- of the vector's args (allPairsIn False) — so a genuinely absent constraint reports
-- ONCE, via reportUncovered, and only the cross-pairing (all args present, joint
-- vector absent) reports here.  Arity < 2 is fully handled by the pair test.
reportUncoveredVec : ModuleCtx ->
  String ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, Int) ->
  List VecObl ->
  List VecObl ->
  Unit
reportUncoveredVec mctx _ _ _ _ [] = ()
reportUncoveredVec mctx m sigTvMaps declaredPairs declaredVecs (o :: rest) =
  let _ =
    if listLen o.voIds < 2 then
      ()
    else if containsVecObl o declaredVecs then
      ()
    else if not (allPairsIn o.voIface o.voIds declaredPairs) then
      ()
    else
      pushTypeError
        mctx
        "T-MISSING-CONSTRAINT"
        (missingConstraintVecMsg
          m
          o.voIface.irName
          (map (varNameForId sigTvMaps m) o.voIds))
  reportUncoveredVec mctx m sigTvMaps declaredPairs declaredVecs rest

allPairsIn : IfaceRef -> List Int -> List (IfaceRef, Int) -> Bool
allPairsIn iface ids declaredPairs =
  allList (id => containsIfacePair (iface, id) declaredPairs) ids

-- one type_error per inferred (iface, id) not covered by the declared-closed set.
reportUncovered : ModuleCtx ->
  String ->
  List (String, Ty, List (String, Mono)) ->
  List (IfaceRef, Int) ->
  List (IfaceRef, Int) ->
  Unit
reportUncovered mctx _ _ _ [] = ()
reportUncovered mctx m sigTvMaps declared ((iface, id) :: rest) =
  let _ =
    if containsIfacePair (iface, id) declared then
      ()
    else
      pushTypeError
        mctx
        "T-MISSING-CONSTRAINT"
        (missingConstraintMsg m iface.irName (varNameForId sigTvMaps m id))
  reportUncovered mctx m sigTvMaps declared rest

containsIfacePair : (IfaceRef, Int) -> List (IfaceRef, Int) -> Bool
containsIfacePair _ [] = False
containsIfacePair (i, d) ((i2, d2) :: rest) =
  sameIfaceDecl i i2 && d == d2 || containsIfacePair (i, d) rest

dedupIfacePairs : List (IfaceRef, Int) -> List (IfaceRef, Int)
dedupIfacePairs xs = dedupBy ifacePairKey xs

ifacePairKey : (IfaceRef, Int) -> String
ifacePairKey (iface, id) =
  regKeyRender (regKeyOfTab (oblIfaceKey iface)) ++ intToString id

-- Render accumulated type errors as `TYPE ERROR: <msg>` lines (in order of
-- occurrence — typeErrors accumulates newest-first, so reverse).
typeErrorLines : List String -> List String
typeErrorLines [] = []
typeErrorLines (e :: rest) = "TYPE ERROR: " ++ e :: typeErrorLines rest

-- #415 item 1: the seeding PREAMBLE every runtime-seeded entry point runs before its
-- typecheck pass — the head half of the sandwich whose tail is `runFinalChecks`.
-- [oracleDecls] is the decl set the ctor oracle is built from: the ONE axis the callers
-- legitimately differ on (the flat paths pass `prog`; checkModuleFullDiags passes
-- `prog ++ accData` own-module-FIRST — see the P0-9 note there, that order is load-bearing).
-- The module's mint (`checkBodyImpl`) installs the seed: this oracle and an empty
-- warnings list.
seedCheckRun : List Decl -> CheckRunSeed
seedCheckRun oracleDecls = CheckRunSeed {
  crsOracle = buildOracle oracleDecls,
  crsWarnings = [],
}

-- #415 item 1: seed-and-run for the three FLAT runtime-seeded entry points
-- (the `checkOne*` wrappers). They
-- used to repeat this body verbatim under a "Mirrors checkToLinesWithRuntime's
-- side-effects EXACTLY" comment — a mirror obligation enforced only by that comment.
-- They now differ ONLY in what they HARVEST from the accumulators afterwards, so the
-- seeding+coherence they share has exactly one body and cannot drift.
-- ⚠️ trap #5, same as runFinalChecks: coherence sees the driver-staged USER decls only,
-- NEVER `prog`.  A user impl deliberately overrides a seeded prelude impl, so feeding
-- the seeded set to checkCoherence false-positives on the stdlib itself.
-- ── type-aware non-exhaustive-match check (the `check_match` driver) ────────
-- Run the full typecheck pass over [prog] (runtime externs seeded, NO prelude —
-- mirrors the reference's check_program_no_prelude oracle) and return one
-- `Warning: non-exhaustive match …` line per `match` that isn't exhaustive.
-- The oracle is built from the program's own data decls + the syntactic builtins
-- (same set check_match's env-backed oracle has in the no-prelude path).  Diffs
-- against `dev/diagdump.exe --check-match` (the harness sorts).
-- ── diagnostics entry point (compiler/driver/diagnostics.mdk bridge) ────────────
-- Run the full typecheck pass (runtime-seeded) over [prog] and return the
-- accumulated errors and non-exhaustive-match warnings as `TcDiag`s — each
-- carrying its own code, span (B.10.2b / S4), message, and optional help/fix —
-- so diagnostics.mdk maps them straight to structured `Diag` values.
-- ── multi-module typecheck (bootstrap front-end) ───────────────────────────
-- Threads per-module exports in dependency order.  The prelude (core) is checked
-- ONCE and ALL its schemes + ctors seed every module (it's implicitly visible);
-- each compiler module then contributes only its PUBLIC value schemes — private
-- helpers stay module-local, so same-named helpers across modules never collide
-- (the per-module-frame property, without a frame) — plus its public ctors.
-- Returns each module's OWN value schemes, in load order.

-- typecheck one program with seeded value schemes + accumulated data decls, as
-- the prelude's core pass.  Re-registers prior modules' public data declarations
-- (`accData ++ prog`) so imported constructors AND named-field-variant record
-- info (e.g. ast's DInterface) resolve.  The program's own impls are its impl
-- universe, as the tree arm's core pass (`elabModuleStamp`) has them: an impl
-- body's occurrence then routes through the impl's `requires` given on both arms.
-- Returns the module's own value schemes.  [prev] is the record current before the
-- pass, whose oracle and warnings the unseeded pass carries.
checkModuleFull : ModuleCtx ->
  List (String, Scheme) ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List Decl, ModuleCtx)
checkModuleFull prev seedVars accData prog =
  checkModuleFullImpl
    prev.mcGraph
    (checkRunResidue prev)
    ""
    (plainModuleSeed seedVars)
    accData
    prog
    prog

-- E5: like checkModuleFull but takes [implDecls] (core + every EARLIER module — NOT this
-- module: foldModules only grows the accumulator for LATER modules, so a module is never in
-- its own [implDecls]; a caller that needs this module's own decls too must fold [prog] in
-- itself, as the `superDecls` binding in checkBodyImpl does for #1457) as the impl-body
-- inference universe.  It ALSO infers THIS module's parametric impl
-- bodies, so their
-- ARG-position ELEMENT dispatch (`eq`/`compare`/… on the impl head tyvar) reaches
-- inferMethodAt and lands in pendingArgStamps, which elabModuleStamp's
-- resolveArgStamps then stamps RDict (via the requires dict registered by
-- registerImplRequires).  The stage-K ClassEnv gives body inference the interface
-- declarations, while [implDecls] lets a body dispatch against an earlier module's impl.
-- [gctx] and [runSeed] are the drive's graph record and the module's check-run seed,
-- passed to its mint (see `checkBodyImpl`), and the module's record is returned beside
-- its bindings.
checkModuleFullImpl : GraphCtx ->
  CheckRunSeed ->
  String ->
  ModuleSeed ->
  List Decl ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List Decl, ModuleCtx)
checkModuleFullImpl gctx runSeed mid seedVars _accData implDecls prog =
  let (schemes, marked, mctx) =
    checkBodyImpl gctx runSeed seedVars mid implDecls prog
  -- #2705 (M2 phase 2): solving is not optional.  Every module a Module-arm driver
  -- checks — `check`, `run`, `build`, the LSP alike — cuts its stamping context
  -- here, at the point its stampers used to run, for the one graph-end drain
  -- (`drainStampQueue`, DICT §6.2 T4).  A driver that queues and never drains
  -- leaves the queue for the next driver entry, so every Module-arm driver ends
  -- with a drain (`driveGraphK`'s, or `checkGraphFinish` on a memo path).
  let _ = enqueueStampCtx mctx mid implDecls
  (schemes, marked, mctx)
-- C5: compute this module's standalone-shadow set BEFORE inference, so the
-- inferMethodAt arg-position record can gate on it (`freshModuleCtx` cleared it via
-- pendingRLocalSites, but standaloneValuesRef is set fresh here per module).
--
-- Two flavours of standalone-shadow, BOTH needing RLocal recording so a method
-- call on a no-impl receiver routes to the standalone instead of mis-dispatching:
--   • IMPORTER shadow (`importerShadows`): a name imported from a sibling that is
--     also an interface method (box importing map's `toList`).  Its scheme must be
--     REBOUND to the interface-method scheme (`shadowMethodSchemes`) so the call
--     site types polymorphically; RLocal then redirects the no-impl receiver back.
--   • DEFINER shadow (`definerShadows`): a name THIS module defines as a top-level
--     funDef that ALSO names an interface method (map-as-root's own `toList` /
--     `isEmpty`).  The MARK pass (`buildStandaloneShadowsGraph`) rewrites these to
--     `EMethodAt`, so without a matching RLocal record the route falls back to the
--     result-type `RKey` (e.g. `toList`'s `List` result), dispatching the method on
--     the WRONG impl (List's `toList = identity`) → `debug`/`display` recurse on the
--     unchanged receiver forever (Map Debug/Eq/Ord impl bodies call standalone
--     `toList`).  These must be RECORDED for RLocal but must NOT be rebound to the
--     method scheme — their local standalone scheme (`Map k v -> …`) is what the
--     impl body types against.

-- E6: re-install the cross-module constraint accumulator that `freshModuleCtx` just
-- wiped, so this module's `=>`-constrained call sites into EARLIER modules resolve.
-- Post-ARGSTAMP-UNIFY (Phase 4): eval and emit both thread dicts, so this runs
-- UNCONDITIONALLY on every path (single elaboration mode).

-- `methodEntryHere` answers from stage K's whole-graph `deMethods` (core, earlier
-- modules and this prog), so resolveSite's ifaceParamMonos can recover a multi-param
-- interface's full param monos (the element grounding `e` for `FromEntries c e`).
-- An empty table on the module path would make ifaceParamMonos return None → a
-- Set/Map-literal return-position `fromEntries` route drops its `Ord` element dict →
-- null dict → SIGSEGV.

-- C5: a standalone-shadow method name (box's `toList`/`isEmpty`) is bound in
-- seedVars to its imported MONOMORPHIC standalone scheme (`Box k v -> …`), which
-- would shadow the polymorphic interface-method scheme and mis-type a genuine
-- method call (`isEmpty [1,2,3]` unifying List with Box).  Re-bind those names to
-- the graph-wide METHOD scheme so the call site types against the method; RLocal then redirects only the no-impl receiver back to the standalone
-- at eval: the EApp method-head arm types against the
-- method scheme even when a standalone value holds the name.
-- DEFINER shadows are EXCLUDED here: the module's OWN funDef (map-root's `toList`)
-- must type against its local standalone scheme (`Map k v -> List (k, v)`), not the
-- imported method scheme — the impl bodies call it ON a Map.  Only IMPORTER shadows
-- (imported-from-sibling method names) get the method-scheme rebind.

-- E5: infer this module's parametric impl bodies (gated, emit path only), seeing
-- [implDecls] for interface method types + cross-module impl dispatch.  The sites
-- it records stay in pendingArgStamps/pendingSites for elabModuleStamp to resolve.

-- C8(b): also infer THIS module's interface DEFAULT bodies (gated identically to
-- the single-file path's inferDefaultBodiesIfEnabled) so a default body's type
-- error is caught on every path.

-- Phase 4.55: infer this
-- module's prop bodies so their prepass-marked EDictAt/EMethodAt routes resolve.
-- The multi-module test path (runPropsMulti) evaluates the ELABORATED prop body
-- against the dict-passed env, so the body's calls into the file's own promoted
-- `=>`-constrained fns (set's `wellFormed`/`fromList`) need their dict-arg routes
-- filled here — otherwise the call under-applies the dict-passed callee → not VBool
-- → every prop "fails".  funDefs ignores DProp, so without this the module path
-- never typed props at all.

-- E6: fold THIS module's freshly-registered fn-constraints into the cross-module
-- accumulator so a LATER module's call site finds them after its own reset.
-- Post-ARGSTAMP-UNIFY (Phase 4): unconditional on every path (single elaboration mode).

-- Shape A (gap #44): ground a container literal's free result-element var THROUGH
-- the unique impl's method type, so this module's pending sites/arg-stamps resolve
-- against the GROUNDED element (Set Int, not Set _a).  [implDecls] is the full impl
-- universe (core ++ earlier modules ++ prog), so the Set/Map impls are visible.

-- public top-level value names (the pub flag may sit on the sig, def, or extern).
-- C8(a): a PUBLIC interface ALSO exports its method names so an importer can see
-- their schemes — methods of an
-- `is_pub = true` interface are appended to the exported value schemes.
publicValNames : List Decl -> List String
publicValNames [] = []
publicValNames ((DAttrib _ d) :: rest) =
  publicValNames [d] ++ publicValNames rest
publicValNames ((DFunDef True n _ _ _ _) :: rest) = n :: publicValNames rest
publicValNames ((DTypeSig True n _ _) :: rest) = n :: publicValNames rest
publicValNames ((DExtern (ExternDecl { edPub = True, edName = n, ... })) :: rest) =
  n :: publicValNames rest
publicValNames ((DInterface { pub = True, methods, ... }) :: rest) =
  ifaceMethodNames methods ++ publicValNames rest
publicValNames (_ :: rest) = publicValNames rest

-- C5: every interface method name declared anywhere in [decls] (unwrapping DAttrib).
allIfaceMethodNames : List Decl -> List String
allIfaceMethodNames [] = []
allIfaceMethodNames ((DAttrib _ d) :: rest) =
  allIfaceMethodNames [d] ++ allIfaceMethodNames rest
allIfaceMethodNames ((DInterface { methods, ... }) :: rest) =
  ifaceMethodNames methods ++ allIfaceMethodNames rest
allIfaceMethodNames (_ :: rest) = allIfaceMethodNames rest

-- C5 (DEFINER shadow): the names THIS module declares as a top-level funDef that
-- ALSO name an interface method visible in [implDecls] (the imported prelude/core).
-- E.g. map-as-root defines `isEmpty`, which shadows Foldable's method of that name.
-- The
-- MARK pass (`buildStandaloneShadowsGraph`) rewrites occurrences of these to
-- `EMethodAt`, so they MUST be in `standaloneValuesRef` for `recordRLocalSite` to
-- record an RLocal candidate — otherwise the route falls back to the method's
-- RESULT-type RKey and the method dispatches on the WRONG impl.
-- Unlike importer shadows these keep their LOCAL standalone scheme (NOT rebound to the
-- method scheme), since the impl bodies apply them to the concrete receiver.
-- #154 PR1: fold THIS module's decls into the persistent universe accumulators
-- (declared in `CrossRun`).  Called from checkBodyImpl's Module arm BEFORE the shadow
-- reads, so this module's own decls are visible there — exactly as `fullUniverse` (which
-- appended prog0) was.
-- ⚠️ ARCH B-2.1-d REMOVED THE KEY-BUCKET LINE from this fold, with the
-- `universeKeyBucketsRef` cell it grew.  That line re-entered `bucketKeyEntries` once per
-- module with a NON-EMPTY accumulator, which is what duplicated declaration indices across
-- modules and left each module's slice descending; at the time, `buildKeyTable` was
-- `bucketKeyEntries`' sole caller and passed `omEmpty` (see `mergeByDeclIdx`).  Both
-- `buildKeyTable` and `bucketKeyEntries` (and the whole key-bucket table, `KeyBuckets`) were
-- deleted by `S-keytable-payoff`.  Do not re-add a cumulative key-bucket accumulator here:
-- impl EXISTENCE and impl SELECTION both read the graph-global `bodyImplEnvRef` now, and a
-- prefix-keyed second population is the shape B-2.1-c/-f/-g each measured an S0 out of.
-- BOTH SPELLINGS of the prelude's module id under `Module` mode, in one place.  The
-- export indexes (`meExports`, `deCtorExports`) key the prelude under `"core"`, but
-- the `mid` `graphPreamble` actually PASSES for the core pass is `""` on both output
-- selections (`GOutDiags`:
-- `checkCoreMemoized` → `checkModuleFull` → `checkModuleFullImpl ""`; `GOutTrees`:
-- `elabModuleStamp ""`).  A test of one spelling alone silently never fires on either
-- selection.  Two callers — `seedBuiltinClasses` and
-- `appendUniverseAccums` (below) — and they must not drift apart, since both ask the
-- same question: "is the unit being folded the implicit prelude?"
isPreludeMid : String -> Bool
isPreludeMid mid = mid == "core" || mid == ""

-- ⚠️ #1557 A-3.5a REMOVED THE COMPLETENESS LINE from this fold, with the
-- `universeIfaceRequiredRef` cell and its `insertIfaceRequired` writer.  The ordering
-- guarantee this comment records ("this module's own decls are visible at the read")
-- is no longer what impl-completeness depends on: it reads stage K's `CE`, whose rows
-- carry their declaring module's ordinal, and `declEnvVisibleAt cur o` (`o <= cur`)
-- admits the reader's OWN row — the same 0..cur-inclusive prefix the accumulator held
-- here.  Do not re-add a completeness accumulator to restore an ordering property that
-- has moved onto the ordinal predicate.
appendUniverseAccums : GraphCtx -> String -> List Decl -> Unit
appendUniverseAccums gctx mid prog =
  -- 🚨 SHADOW-SEMANTICS S1-PRELUDE (a), RULED 2026-08-10 (#1375 item 2, #1499 clause (b)):
  -- The prelude is not S1's left (standalone) operand.  The asymmetry with the shadow
  -- builders' interface-method test, `methodNameDeclaredAt`, which counts the prelude's
  -- interfaces at ordinal 0, is deliberate and is S1-PRELUDE's own
  -- (`SHADOW-SEMANTICS.md:225`): S1's INTERFACE operand is the wider "nameable in M",
  -- which INCLUDES the prelude, while its STANDALONE operand is pinned by the
  -- definer/importer kind partition — and a standalone reaching M only as an implicit
  -- prelude export is NEITHER kind, so it creates no shadow in M.
  -- This ref's ONE reader is the `importerShadows` binding in `checkBodyImpl`
  -- (`standaloneShadowsFromSet`'s `fnSet`), i.e. exactly that left operand; folding the
  -- prelude's own funDefs in admitted every prelude standalone as an IMPORTER shadow —
  -- the reading S1-PRELUDE names and REJECTS by consequence — so a user interface method
  -- colliding with `isEven`/`count` fell back to the prelude function at any receiver head
  -- carrying no impl, ACCEPTING at exit 0 where the ruling requires a located reject
  -- (`test/shadow_fixtures/x1_prelude_standalone_not_left_operand.mdk`, x2, matrix rows
  -- 46-48).  ⚠️ SUBTRACTING the prelude's names at the READ site instead would be WRONG:
  -- a name the prelude AND a real user module both define IS imported into M by the user
  -- module and DOES create a shadow there.  Not folding is what expresses "contributes
  -- nothing"; the union still carries the name via whichever user module defines it.
  let _ =
    if isPreludeMid mid then
      ()
    else
      gctx.crossRun.universeFunNamesRef :=
        namesToSet
          (map fst (funDefs prog))
          gctx.crossRun.universeFunNamesRef.value
  -- #154 PR-B: grow the dispatch-index accumulator by THIS module's interface indices.
  -- APPEND (universe first) so the accumulated list stays in the same core-first order the
  -- old `argDispatchIndices (accAll ++ prog)` flatMap produced.  #1351 L5 (CONTRACT) deleted
  -- the bare-name accumulator that used to be grown alongside this one: its only reader was
  -- `dispatchIdxScoped`'s fall-back arm, and the reader is now identity-keyed only, so a
  -- prior-module entry this module never names cannot be queried by spelling at all.
  gctx.crossRun.universeMethodDispatchIdxByIdRef :=
    gctx.crossRun.universeMethodDispatchIdxByIdRef.value
      ++ argDispatchIndicesById prog
  -- #1112 A-3.4 PR2: the #154 PR3 leg that grew the three `obUniv*` obligation-universe
  -- accumulators here is GONE.  Its consumer — the Module arm's `obUniv` — now projects
  -- stage K's `IE` at the reader's ordinal instead (`ieUniverseAt`), so this fold was
  -- building a second copy of a table nothing reads.  Note what that makes this function:
  -- it no longer answers "what impls exist" at all; every remaining line here is an
  -- interface/method/name-side accumulator.  Do not re-add an impl accumulator — the whole
  -- point of the flip is that `IE` is the one answer, and a second one is design law L1's
  -- divergence.
  ()

-- Takes this module's whole decl list, not a pre-filtered one.  The polarity
-- fixpoint runs over all of it (#2112), and filtering at the CALL SITE is what once let
-- the opaque-kind half go missing.
--
-- `fieldOwnersRef` arrives holding the K seed PLUS everything this module registered
-- during inference, and `registerAllDataScoped … pubDecls` below registers this module's
-- PUBLIC records a SECOND time.  `addFieldOwners` conses without dedupe, so every own
-- public record is DOUBLE-listed in `fieldOwnersRef` from that line until the next
-- `freshModuleCtx`.  Unobservable today only because nothing reads the multimap in between
-- (the two population walkers read `env2` and `recordByNameRef`).  A doubled owner key is
-- the shape `declEnvSeedChain`'s own-row note exists to prevent.  `fieldOwnerNames`
-- `sortUniqS`es on read, so the doubling does not move an answer; a new reader of
-- `fieldOwnersRef` after this point must de-duplicate first or restore a reset.
-- (`dataParamKindsRef` gets the same
-- doubling; it is inert there because `lookupTab` is first-match over identity-bearing
-- keys whose two copies are equal.)
appendDataUniverse : ModuleCtx -> String -> List Decl -> Unit
appendDataUniverse mctx mid prog0 =
  let pubDecls = publicDataDecls prog0
  -- The alias half of the reload is a stage-K projection, so it takes THIS module's
  -- ordinal, strictly BELOW-this-module (`aliasUniverseAt`'s `<`): the registration
  -- below is what puts this module's own aliases, public and private, in front.
  let _ =
    loadDataUniverse mctx (declEnvsOrdOf mid mctx.mcGraph.declEnvsRef.value)
  -- #2112: the polarity fixpoint sees the WHOLE module (`prog0`), the universe
  -- receives only the public keys — see `registerAllDataScoped`.
  let env2 =
    registerAllDataScoped
      (withCtors mctx (spFloor mctx.mcGraph.crossRun.universeCtorPop.value))
      (publicDataScopeDecls prog0)
      prog0
  -- Both walkers read the payloads this registration just made back out of `env2` and
  -- `recordByNameRef`, so each population row holds the very object its floor holds.
  mctx.mcGraph.crossRun.universeCtorPop :=
    insertCtorPop env2 pubDecls mctx.mcGraph.crossRun.universeCtorPop.value
  mctx.mcGraph.crossRun.universeRecordPop :=
    insertRecordPop mctx pubDecls mctx.mcGraph.crossRun.universeRecordPop.value
  mctx.mcCells.ownPopsRef :=
    (insertCtorPop env2 pubDecls spEmpty, insertRecordPop mctx pubDecls spEmpty)

-- What `appendDataUniverse` registers to elaborate a module's public data: the
-- public declarations plus every alias the module declares, private ones
-- included.  A public field may name a private alias, and the scheme it
-- elaborates to here is the one every importer reads back, so it expands under
-- the declaring module's aliases.  The private aliases reach only the working
-- alias table, which the next module's arm reloads; the populations take
-- `pubDecls` alone.
publicDataScopeDecls : List Decl -> List Decl
publicDataScopeDecls prog0 =
  filterList (d => publicDataDecl d || isAliasDecl d) prog0

-- #154 PR1: buildDefinerShadows with the `allIfaceMethodNames fullUniverse` scan
-- replaced by a membership test, `isMethod` (`methodNameDeclaredAt` at the module's
-- ordinal).  `direct` still filters THIS module's localNames in declaration order, so
-- `isMethod n` is a point-for-point substitute for `contains n methodNames` — same
-- set, same order, byte-identical output.
definerShadowsFromSet : GraphCtx -> (String -> Bool) -> List Decl -> List String
definerShadowsFromSet gctx isMethod prog =
  let localNames = dedup (map fst (funDefs prog))
  let direct = filter isMethod localNames
  let sm = gctx.mangledShadowMapRef.value
  let bares =
    flatMap
      (n => match lookupAssoc n sm
        Some bare => [bare]
        None => [])
      localNames
  removeAllS (localBoundNames prog) (dedup (direct ++ bares))

-- A name qualifies as an importer shadow when it is a universe fn, an interface
-- method, and NOT defined in this module; `not (contains n localNames)` drops this
-- module's own funDefs.  The `mangled` arm recovers the bare method name via
-- mangledShadowMapRef: on the EMIT path every funDef is mangled, so `direct` — which
-- intersects mangled universe-fn names against bare interface-method names — matches
-- nothing on its own, and without recovery the standalone/method dispatch decision
-- (Fork-1's importer rule) silently loses its site. Empty on the un-mangled run/check
-- path (the map is empty there) → `direct` alone → byte-identical. See
-- docs/spec/SHADOW-SEMANTICS.md § "2. Decision matrix (re-observed 2026-07-14,
-- post-`eb92cdff`; now GATED)" rows 21a/21b for the fixed bug and its fixtures.
standaloneShadowsFromSet : GraphCtx ->
  (String -> Bool) ->
  OrdMap Unit ->
  List Decl ->
  List String
standaloneShadowsFromSet gctx isMethod fnSet prog =
  -- Both probes below run once per GRAPH-WIDE fn name, so both of their tables are
  -- sets: a `contains` over the module's own names and a `lookupAssoc` over the
  -- definer-shadow map were each O(names x table) here.
  let localNames = namesToSet (map fst (funDefs prog)) omEmpty
  let direct =
    filter (n => isMethod n && not (omHasKey n localNames)) (omKeys fnSet)
  let sm = gctx.mangledShadowMapRef.value
  let mangled =
    flatMap
      (n => match lookupAssoc n sm
        Some bare => if omHasKey n localNames then [] else [bare]
        None => [])
      (omKeys fnSet)
  dedup (direct ++ mangled)

-- ── #1354 unit A (#1353): SHADOW-SEMANTICS S1's `nameable in M` interface operand ──
-- `docs/spec/SHADOW-SEMANTICS.md` S1 (SCOPE RULED 2026-08-06, #1375) intersects
-- funDef-names(standalones defined in or imported into `M`) with
-- iface-method-names(interfaces **nameable in `M`**).  `methodNameDeclaredAt` answers
-- for the method names of EVERY module at or before `M`'s ordinal, so the two builders
-- above implement the LEFT operand's scope (the `fnSet`/`localNames` guards) and give the
-- RIGHT one none: an interface reachable only transitively, through a module that
-- re-exports nothing, captured a standalone the occurrence's module had explicitly
-- imported (#1353, S0 — `7` instead of `99`, at exit 0, no diagnostic).
--
-- The remedy is a SUPPLY, not a re-scope: the membership test is correct and narrowing
-- it would answer a question nobody asks of it.  This is the missing predicate, applied to
-- the ALREADY-COMPUTED intersection rather than inside either operand's filter — the
-- intersection is single-digit in practice (over `compiler/**` + `stdlib/*` it is 3:
-- `toList`, `isEmpty`, `orElse`) while `fnSet` holds every top-level fn name in the graph,
-- so filtering the result is cheap and filtering the operand is not.
--
-- ⚠️ THE PREDICATE ASKS A TYPE-NAMESPACE QUESTION, and getting that wrong is how the first
-- cut of this fix shipped two defects at once — see `meIfaceExports` for both, measured.
-- §1.0's row says `nameable in M` qualifies **S1's INTERFACE operand**; asking instead
-- whether the METHOD NAME is exported along the import path is a different question that
-- answers differently in BOTH directions.
--
-- 🚨 IT FAILS OPEN, DELIBERATELY, AND THAT DIRECTION IS LOAD-BEARING.  Dropping shadow-hood
-- from an occurrence that IS one makes it dispatch unconditionally (`recordRLocalSite`'s
-- `standaloneValuesRef` guard declines, so no pending site exists for
-- `resolveRLocalSites` to stamp and the route stays the method's RKey) — the S4/#410
-- class, up to `no impl of method … for type …` on a valid program and a SIGSEGV variant.
-- Adding shadow-hood is the pre-existing behaviour.  So an ABSENT index answers True for
-- every name rather than False: `meIfaceExports` rides `declEnvsRef`, written
-- unconditionally at the one Module-mode driver entry, `graphPreamble`
-- (`checkModulesPreambleK` is its projection — the conjunction stated in full on
-- `meExports`, which shares that write), and a driver
-- that ever omits that write must degrade to today's graph-global answer, not to "nothing
-- is a shadow anywhere".
--
-- ⚠️ SCOPE, stated so it is not over-read.  The predicate is `nameable in M` as §1.0 defines
-- it, applied to S1's INTERFACE operand — so it covers BOTH failures S1 names, the
-- reachability one (#1353: no import path reaches the declaring module) and the one where a
-- path exists but does not carry the interface.  What it does NOT decide is #1302's axis:
-- `meIfaceExports` has no `pub` filter, so a module that imports a dependency BY NAME can
-- still be told about that dependency's PRIVATE interface.  That is the fail-open direction
-- and it is left exactly where #1302 and `declMethodIdentsOf`'s F3 already own it.
nameableIfaceShadows : GraphCtx -> List Decl -> List String -> List String
nameableIfaceShadows gctx _ [] = []
nameableIfaceShadows gctx prog names
  -- fail OPEN on an absent index — see the paragraph above; `names` unchanged is exactly
  -- the pre-#1353 graph-global answer.
  | omSize (ifaceExportsIndex gctx ()) == 0 = names
  | otherwise =
    let nameable = nameableIfaceMethodSet gctx prog
    filterList (n => omHasKey n nameable) names

-- The bare method names of every interface NAMEABLE in module [prog] — S1's three
-- nameable-in-`M` positions, built ONCE per module: the implicit prelude (`core`'s row),
-- this module's own interfaces, and, for each `DUse`, the interfaces THAT USE-PATH ADMITS
-- out of the dependency's row (which already carries what the dependency re-exports, at any
-- chain depth — S1-CHAIN, #1380).
--
-- 🚨 THE USE-PATH FILTER IS THE WHOLE POINT, and its absence was this fix's first defect.
-- Taking a dependency's WHOLE row on any import makes `import smod.{sf}` — one unrelated
-- function — enough to make `smod`'s interface "nameable", which it demonstrably is not:
-- `impl Sizeable Blob` in that module is rejected `Unknown interface: Sizeable`.  That left
-- #1353 narrowed rather than fixed (its own repro with the bridge hop removed still printed
-- the impl's value).  `selectIfaceRows` is shared with the re-export side so the import and
-- chain answers cannot drift apart.
--
-- Name-level rather than identity-level ON PURPOSE.  S1's intersection is over NAMES, so
-- when two interfaces declare `n` and only one is nameable here, `n` is a shadow either
-- way; which declaration an occurrence then means is `methodScopeAt`'s question
-- about a different table (`MethodEnv`'s rows), and answering it here would be
-- a second resolver free to disagree with that one.
--
-- 🔒 THIS IS S1's RIGHT OPERAND UNDER S1-NS (RULED 2026-08-08), and it is the ONLY predicate
-- in the compiler that answers it — `checkBodyImpl`'s shadow-hood and EVERY filter in the
-- mark pass read THIS set.  Named rather than counted, because a count rots silently and
-- this sentence already did (it said "all three" for a week after `rpNames` became the
-- fourth): `moduleMarkCtx` filters `rpNames`, `shadowNames` (through
-- `shadowBareName`), `argNames` and `shadowMap` — its own `otherwise` arm enumerates them
-- against what `rewriteArgScoped` can turn into an `EMethodAt`.  S1-NS (b) requires
-- shadow-hood to be a superset of dispatch
-- eligibility and rules two different predicates at the two sites non-conformant; one set
-- makes them equal, so the invariant holds by construction rather than by test.  Do not
-- introduce a second, wider set for marking: two earlier cuts of this unit did exactly that
-- and each shipped an S0 (a `run`-vs-built-binary split, and a `build`-only E-PANIC).
--
-- The per-METHOD union of the two namespaces lives in `selectIfaceRows`, applied on the
-- import arm here and on the re-export arm in `meIfaceExports`.
nameableIfaceMethodSet : GraphCtx -> List Decl -> OrdMap Unit
nameableIfaceMethodSet gctx prog =
  namesToSet (flatMap snd (nameableIfaceRows gctx prog)) omEmpty

-- The same operand ONE level less flattened: the (interface name, its method names)
-- ROWS, not just the union of their method names.  `nameableIfaceMethodSet` above is
-- defined as this list's flattening, so there is still exactly ONE derivation of S1's
-- right operand — a diagnostic that needs to name WHICH interface owns a colliding
-- method (#2738's `W-IMPORT-METHOD-SHADOW`) must not answer that from a second,
-- independently-scoped walk, which is what S1-NS (b) rules non-conformant.
--
-- `ifaceMethodRows prog` is `allIfaceMethodNames prog` grouped by declaration: both walk
-- `DAttrib`/`DInterface` in the same order and take `ifaceMethodNames methods`, so the
-- flattening above is the previous expression term for term.
nameableIfaceRows : GraphCtx -> List Decl -> List (String, List String)
nameableIfaceRows gctx prog =
  nameableIfaceRowsIn (ifaceExportsIndex gctx ()) prog

-- `nameableIfaceRows` over the interface-row index [idx].
nameableIfaceRowsIn : OrdMap (List (String, List String)) ->
  List Decl ->
  List (String, List String)
nameableIfaceRowsIn idx prog =
  optionOr [] (omLookup "core" idx)
    ++ ifaceMethodRows prog
    ++ importedIfaceRows idx prog

importedIfaceRows : OrdMap (List (String, List String)) ->
  List Decl ->
  List (String, List String)
importedIfaceRows _ [] = []
importedIfaceRows idx ((DAttrib _ d) :: rest) =
  importedIfaceRows idx [d] ++ importedIfaceRows idx rest
importedIfaceRows idx ((DUse _ path _) :: rest) =
  (match omLookup (useModId path) idx
      None => []
      Some src => selectIfaceRows path src)
    ++ importedIfaceRows idx rest
importedIfaceRows idx (_ :: rest) = importedIfaceRows idx rest

-- ── #2738: a selectively imported standalone displaced by a nameable method ──
-- The peer of `frontend/marker.mdk`'s `preludeStandaloneShadows` for the IMPORTER
-- direction, and it is sited here rather than beside it because the two operands it
-- needs live here: S1's right operand (`nameableIfaceRows`, the only predicate in the
-- compiler that answers `nameable in M`) and, through it, the interface a colliding
-- method name belongs to.  `compiler/frontend/marker.mdk` cannot reach either —
-- `types/typecheck.mdk` imports `frontend.marker`, so the edge does not run the other
-- way — and re-deriving the operand there is what S1-NS (b) rules non-conformant.
--
-- Yields one entry per DIFFERING-scheme collision, in declaration order:
--   (bound name, the interface declaring it, the standalone's declared signature,
--    the method's declared signature, the import member's own span).
-- The standalone signature is `None` when the defining module declares the function
-- without a signature: a scheme that cannot be read cannot be shown harmless, so it
-- counts as differing.  Identical (alpha-equivalent) signatures yield nothing, which is
-- what keeps the everyday `import m.{f}` silent.
--
-- SELECTIVE imports only (`UseGroup`).  A wildcard or bare import makes no statement
-- about the name, and a module alias binds a DOTTED local (`A.f`) that no bare method
-- name can collide with; the ruling is scoped to the explicit member list, which is the
-- strongest statement the language offers about which binding is meant.
--
-- Fails CLOSED on an absent index, the opposite of `nameableIfaceShadows` above and for
-- the opposite reason: that predicate decides resolution, where dropping shadow-hood
-- miscompiles, while this one only decides a warning, where a graph-global operand would
-- fire on collisions the module cannot name.
export
importedStandaloneShadows : DriveOutputs ->
  List (String, List Decl) ->
  List Decl ->
  List (String, String, Option Ty, Ty, Loc)
importedStandaloneShadows o graph prog =
  importedStandaloneShadowsIn o.doIfaceExports graph prog

-- `importedStandaloneShadows` over the interface-row index [idx], for a caller whose
-- index is not the last drive's: a single file analysed before its drive passes
-- `omEmpty`, which answers nothing.
export
importedStandaloneShadowsIn : OrdMap (List (String, List String)) ->
  List (String, List Decl) ->
  List Decl ->
  List (String, String, Option Ty, Ty, Loc)
importedStandaloneShadowsIn idx graph prog
  | omSize idx == 0 = []
  | otherwise =
    let rows = nameableIfaceRowsIn idx prog
    let nameable = namesToSet (flatMap snd rows) omEmpty
    let universe = flatMap snd graph ++ prog
    flatMap (importShadowsOfDecl graph rows nameable universe) prog

-- The catch-all arms here are exhaustive by construction, not by omission: a shadow can
-- only arise from an explicit member list, so every non-`DUse` declaration and every
-- non-`UseGroup` use path contributes nothing by the scoping rule stated above.
importShadowsOfDecl : List (String, List Decl) ->
  List (String, List String) ->
  OrdMap Unit ->
  List Decl ->
  Decl ->
  List (String, String, Option Ty, Ty, Loc)
importShadowsOfDecl graph rows nameable universe (DAttrib _ d) =
  importShadowsOfDecl graph rows nameable universe d
importShadowsOfDecl graph rows nameable universe (DUse _ path _) = match path
  UseGroup _ ms => match lookupAssoc (useModId path) graph
    None => []
    Some depDecls =>
      flatMap (importMemberShadow graph rows nameable universe depDecls) ms
  _ => []
importShadowsOfDecl _ _ _ _ _ = []

importMemberShadow : List (String, List Decl) ->
  List (String, List String) ->
  OrdMap Unit ->
  List Decl ->
  List Decl ->
  UseMember ->
  List (String, String, Option Ty, Ty, Loc)
importMemberShadow graph rows nameable universe depDecls (UseMember origin _ mloc alias) =
  let local = match alias
    Some a => a
    None => origin
  if not (omHasKey local nameable) then
    []
  else match reachableStandaloneSig graph (listLen graph) depDecls origin
    None => []
    Some sty => match ifaceMethodSigFor local sty rows universe
      None => []
      Some (iface, mty) => [(local, iface, sty, mty, mloc)]

schemesAgree : Option Ty -> Ty -> Bool
schemesAgree None _ = False
schemesAgree (Some sty) mty = tyAlphaEq sty mty

-- A NAMEABLE interface declaring [name] whose signature differs from the standalone's
-- [sty], with that signature.  When two or more differ, the least by interface name and
-- then by rendered signature, so the warning reads the same in every import order
-- (S2-DECL (e)).  Rows whose declaration is not in [universe] are skipped rather than
-- guessed at.
ifaceMethodSigFor : String ->
  Option Ty ->
  List (String, List String) ->
  List Decl ->
  Option (String, Ty)
ifaceMethodSigFor _ _ [] _ = None
ifaceMethodSigFor name sty ((iface, ms) :: rest) universe =
  let later = ifaceMethodSigFor name sty rest universe
  if not (contains name ms) then
    later
  else match ifaceMethodTyIn iface name universe
    Some ty =>
      if schemesAgree sty ty then later else leastIfaceSig (iface, ty) later
    None => later

leastIfaceSig : (String, Ty) -> Option (String, Ty) -> Option (String, Ty)
leastIfaceSig a None = Some a
leastIfaceSig (a@(ia, ta)) (Some (b@(ib, tb)))
  | ia < ib = Some a
  | ib < ia = Some b
  | ppTy ta <= ppTy tb = Some a
  | otherwise = Some b

ifaceMethodTyIn : String -> String -> List Decl -> Option Ty
ifaceMethodTyIn _ _ [] = None
ifaceMethodTyIn iface name ((DAttrib _ d) :: rest) =
  let inner = ifaceMethodTyIn iface name [d]
  match inner
    Some ty => Some ty
    None => ifaceMethodTyIn iface name rest
ifaceMethodTyIn iface name ((DInterface { name = n, methods, ... }) :: rest)
  | n == iface = match ifaceMethodTyOf name methods
    Some ty => Some ty
    None => ifaceMethodTyIn iface name rest
  | otherwise = ifaceMethodTyIn iface name rest
ifaceMethodTyIn iface name (_ :: rest) = ifaceMethodTyIn iface name rest

ifaceMethodTyOf : String -> List IfaceMethod -> Option Ty
ifaceMethodTyOf _ [] = None
ifaceMethodTyOf name ((IfaceMethod n ty _ _) :: rest)
  | n == name = Some ty
  | otherwise = ifaceMethodTyOf name rest

-- The standalone the imported member actually names, THROUGH `export import` hops:
-- `Some sig` when a module reachable from [decls] declares [name] as a top-level
-- function (`sig` being its declared signature, or `None` when it has none — a scheme
-- that cannot be read cannot be shown harmless, which is what `schemesAgree` then does
-- with it), and `None` when no such standalone exists at all.
--
-- The hop is not optional; it is what the spec asks for.  Reading only the DIRECTLY
-- imported module's own `DFunDef`s made the detector silent for a standalone that
-- reaches the importer through a re-exporter, which is the same silent displacement
-- #2738 names — `SHADOW-SEMANTICS.md`'s `nameable in M` row puts re-export chains in
-- scope (#1380) and S1-NS (a) rules the re-export arm SYMMETRIC with the import arm, so
-- a detector that answers only the direct case contradicts its own right operand, which
-- `meIfaceExports` already folds over chains of any depth.
--
-- The member list is followed the same way the re-export side follows it — through
-- `importedBindings`, the one place a use-path's (origin, local) bindings are derived —
-- so `export import m.{f as g}` re-exported as `g` looks `f` up in `m`, and a wildcard
-- re-export passes the name through unchanged.  A second walker keyed on a
-- hand-enumerated set of `UsePath` forms would drift from that one the first time a form
-- is added.
--
-- [fuel] bounds the chain at the number of modules in the compile, so a re-export cycle
-- terminates here rather than relying on the loader having rejected it upstream.
reachableStandaloneSig : List (String, List Decl) ->
  Int ->
  List Decl ->
  String ->
  Option (Option Ty)
reachableStandaloneSig graph fuel decls name
  | declaresStandalone name decls = Some (standaloneSigOf name decls)
  | fuel <= 0 = None
  | otherwise =
    reachableStandaloneSigGo graph (fuel - 1) (reexportedOrigins decls name)

reachableStandaloneSigGo : List (String, List Decl) ->
  Int ->
  List (String, String) ->
  Option (Option Ty)
reachableStandaloneSigGo _ _ [] = None
reachableStandaloneSigGo graph fuel ((mid, n) :: rest) =
  match lookupAssoc mid graph
    None => reachableStandaloneSigGo graph fuel rest
    Some ds => match reachableStandaloneSig graph fuel ds n
      Some sig => Some sig
      None => reachableStandaloneSigGo graph fuel rest

-- Every (dependency module id, name in THAT module) an `export import` in [decls] could
-- have re-exported [name] from.  A non-exporting `import` contributes nothing: it puts
-- no name into the re-exporter's own exports, so nothing downstream can reach through
-- it.
--
-- The catch-all arm is exhaustive by that rule rather than by omission — a re-export is
-- representable only as a `DUse True`, wrapped in `DAttrib` or not, so no other `Decl`
-- constructor can contribute a hop and a new one never will.  Its ledgered peer
-- `reexportedIfaceMethodsOf` (the interface-row half of the same walk) carries the same
-- two arms for the same reason.
reexportedOrigins : List Decl -> String -> List (String, String)
reexportedOrigins decls name = flatMap (d => reexportedOriginsOf d name) decls

reexportedOriginsOf : Decl -> String -> List (String, String)
reexportedOriginsOf (DAttrib _ d) name = reexportedOriginsOf d name
reexportedOriginsOf (DUse True path _) name = match importedBindings path
  None => [(useModId path, name)]
  Some bs =>
    map (b => (useModId path, fst b)) (filterList (b => snd b == name) bs)
reexportedOriginsOf _ _ = []

declaresStandalone : String -> List Decl -> Bool
declaresStandalone _ [] = False
declaresStandalone n ((DAttrib _ d) :: rest) =
  declaresStandalone n [d] || declaresStandalone n rest
declaresStandalone n ((DFunDef _ m _ _ _ _) :: rest) =
  m == n || declaresStandalone n rest
declaresStandalone n (_ :: rest) = declaresStandalone n rest

standaloneSigOf : String -> List Decl -> Option Ty
standaloneSigOf _ [] = None
standaloneSigOf n ((DAttrib _ d) :: rest) = match standaloneSigOf n [d]
  Some t => Some t
  None => standaloneSigOf n rest
standaloneSigOf n ((DTypeSig _ m ty _) :: rest)
  | m == n = Some ty
  | otherwise = standaloneSigOf n rest
standaloneSigOf n (_ :: rest) = standaloneSigOf n rest

-- Alpha-equivalence of two SURFACE signatures: equal up to a consistent renaming of
-- type variables, so `Box a -> a` and `Box b -> b` agree while `Box a -> (String, a)`
-- and `t a -> a` do not.  The bijection is carried both ways, so `a -> b` and `a -> a`
-- do not agree either.  Any shape not matched pairwise below is treated as DIFFERING,
-- which is the direction that warns, and every arm that IS matched pairwise compares
-- every field that can carry a type variable — a field skipped there errs toward
-- AGREEING, the silent direction, which is what a `listLen`-only `TyConstrained` arm did
-- (`Eq a => b -> a -> String` and `Debug a => t -> a -> String` compared equal, and the
-- displacement they name went unreported at exit 0).  The two fields deliberately not
-- compared are `TyCon`'s `tyConOrigin` and `TyRow`'s `Option Loc`: neither is part of the
-- written scheme, and `Constraint`'s `constraintOrigin` is skipped for the same reason.
export
tyAlphaEq : Ty -> Ty -> Bool
tyAlphaEq a b = match tyAlphaGo [] a b
  Some _ => True
  None => False

tyAlphaGo : List (String, String) -> Ty -> Ty -> Option (List (String, String))
tyAlphaGo m (TyVar x) (TyVar y) = bindTyName m x y
tyAlphaGo m (TyCon { tyConName = x }) (TyCon { tyConName = y })
  | x == y = Some m
  | otherwise = None
tyAlphaGo m (TyApp f x) (TyApp g y) = match tyAlphaGo m f g
  None => None
  Some m2 => tyAlphaGo m2 x y
tyAlphaGo m (TyFun a b) (TyFun c d) = match tyAlphaGo m a c
  None => None
  Some m2 => tyAlphaGo m2 b d
tyAlphaGo m (TyTuple xs) (TyTuple ys) = tyAlphaList m xs ys
tyAlphaGo m (TyEffect e1 t1 a) (TyEffect e2 t2 b)
  | sameWrittenAtoms e1 e2 && t1 == t2 = tyAlphaGo m a b
  | otherwise = None
-- BODY FIRST, then the constraints, and the order is load-bearing rather than
-- stylistic: the body is where a scheme's type variables are pinned, so matching it
-- first fixes the bijection the constraint comparison then only has to check.  The
-- reverse order has to GUESS which of two same-head constraints (`Eq a, Eq b => a -> b`
-- vs `Eq d, Eq c => c -> d`) pairs with which, and a wrong greedy guess reports a
-- false difference on two schemes that are the same.
tyAlphaGo m (TyConstrained c1 a) (TyConstrained c2 b)
  | listLen c1 /= listLen c2 = None
  | otherwise = match tyAlphaGo m a b
    None => None
    Some m2 => tyAlphaConstraints m2 c1 c2
tyAlphaGo m (TyRow e1 t1 _) (TyRow e2 t2 _)
  | sameWrittenAtoms e1 e2 && t1 == t2 = Some m
  | otherwise = None
tyAlphaGo _ _ _ = None

-- Two written rows agree when their atoms spell the same; the declaration
-- identity is not part of alpha-equivalence, which compares source shapes.
sameWrittenAtoms : List EffAtomTy -> List EffAtomTy -> Bool
sameWrittenAtoms e1 e2 =
  map (effAtomSurface escStr) e1 == map (effAtomSurface escStr) e2

tyAlphaList : List (String, String) ->
  List Ty ->
  List Ty ->
  Option (List (String, String))
tyAlphaList m [] [] = Some m
tyAlphaList m (x :: xs) (y :: ys) = match tyAlphaGo m x y
  None => None
  Some m2 => tyAlphaList m2 xs ys
tyAlphaList _ _ _ = None

-- A constraint SET, not a constraint list: `Eq a, Debug b =>` and `Debug b, Eq a =>`
-- are the same scheme, so a positional comparison would warn on two declarations that
-- differ only in the order the author wrote them — a false positive on correct code.
-- Each constraint of [c1] is therefore matched against any still-unconsumed member of
-- [c2].  The lists are equal-length at entry (the caller's guard), so consuming one per
-- step leaves nothing over.
tyAlphaConstraints : List (String, String) ->
  List Constraint ->
  List Constraint ->
  Option (List (String, String))
tyAlphaConstraints m [] _ = Some m
tyAlphaConstraints m (c :: rest) cs2 = match takeAlphaConstraint m c cs2 []
  None => None
  Some (m2, left) => tyAlphaConstraints m2 rest left

-- the first member of [cs] that matches [c], paired with the REMAINING members.  Their
-- order in that remainder is immaterial — this is a set comparison — so the rejected
-- prefix is simply appended back.
takeAlphaConstraint : List (String, String) ->
  Constraint ->
  List Constraint ->
  List Constraint ->
  Option (List (String, String), List Constraint)
takeAlphaConstraint _ _ [] _ = None
takeAlphaConstraint m c (d :: rest) tried = match tyAlphaConstraint m c d
  Some m2 => Some (m2, tried ++ rest)
  None => takeAlphaConstraint m c rest (d :: tried)

-- Same interface, and pairwise alpha-equal arguments under the map the body already
-- pinned.  `constraintOrigin` is identity metadata the surface signature does not carry
-- — the peer of `tyConOrigin`, skipped by the `TyCon` arm for the same reason.
tyAlphaConstraint : List (String, String) ->
  Constraint ->
  Constraint ->
  Option (List (String, String))
tyAlphaConstraint m (Constraint { constraintHead = h1, constraintArgs = as1, ... }) (Constraint { constraintHead = h2, constraintArgs = as2, ... })
  | h1 == h2 = tyAlphaList m as1 as2
  | otherwise = None

bindTyName : List (String, String) ->
  String ->
  String ->
  Option (List (String, String))
bindTyName m x y = match lookupAssoc x m
  Some y2 => if y2 == y then Some m else None
  None => if anyList (e => snd e == y) m then None else Some ((x, y) :: m)

-- C5: graph-wide standalone-shadow names — every top-level funDef name in [userDecls]
-- (the user modules, NOT core) that is also an interface method name anywhere in
-- [allDecls].  Used by the MARK pass to rewrite such occurrences to EMethodAt (so the
-- route ref exists for resolveRLocalSites to stamp).  Excludes core's own decls as the
-- funDef source so core's elaboration (no standalone shadows there) is untouched.
-- P0-18: recover, per (module, iface-method) pair, the mangled standalone symbol the
-- mangler produced for a definer-shadow funDef.  Forward-constructs `mangledName mid
-- method` (using the KNOWN mid — exact, not lossy prefix-stripping) and checks it
-- against the module's actual funDef names; a hit is a `(mangledSymbol ↦ bareMethod)`
-- entry.  On the un-mangled path no funDef matches → [] → every consumer unchanged.
computeMangledShadowMap : List Decl ->
  List (String, List Decl) ->
  List (String, String)
computeMangledShadowMap allDecls units =
  -- DEDUPED: `allIfaceMethodNames` walks every `DInterface` in the graph and a method
  -- name declared by two interfaces appears twice, so an undeduped list mints the SAME
  -- `(sym ↦ bare)` row twice per unit.  The rows are identical, so no reader's answer
  -- changes; what changes is the size of the table every reader below walks or indexes.
  let methodNames = dedup (allIfaceMethodNames allDecls)
  flatMap (unitMangledShadows methodNames) units

-- The unit's funDef names are an INDEX, not a list: this probes once per interface
-- method, so a `contains` here is O(methods x funDefs) — a shape where both grow
-- together (N interfaces beside N top-level bindings) makes it quadratic.  Same
-- treatment as `prePassDictArg`'s name sets (#2189).
-- #2809: THE BARE ROW.  Mangling now runs AFTER elaboration, so a definer shadow's
-- funDef carries the name its author wrote and the forward-constructed `<mid>__m` matches
-- nothing.  The row is what `rewriteArgScoped`'s `sm` arm reads to seed the occurrence
-- with its standalone SYMBOL, and that symbol is what the later rename moves
-- (`private_mangle`'s `EMethodAt` seed arm and `mangleRoute`) into the emitted direct
-- call.  Without it the route names the bare METHOD, whose define the rename has already
-- moved, and the emitter calls a symbol DCE pruned: `use of undefined value
-- '@mdk_orElse'`, on the compiler's own `frontend.parser`.
-- On the bare row `sym == bare`, so `moduleSpellsShadowBare`'s definer arm admits it in
-- the module that defines the standalone and its import arm in a module that spells the
-- bare name -- the same two admitting cases #1684 ruled for the mangled row.
-- THE PRELUDE UNIT CONTRIBUTES NO ROW: SHADOW-SEMANTICS S1-PRELUDE (a) puts the implicit
-- prelude in neither half of S1's standalone operand, so no `core.mdk` occurrence is a
-- user interface method's shadow -- the asymmetry `appendUniverseAccums` states, and the
-- direction #2153's `core__not ↦ not` incident was paid for.
unitMangledShadows : List String -> (String, List Decl) -> List (String, String)
unitMangledShadows methodNames (mid, decls) =
  let fns = omFromNames (map fst (funDefs decls)) omEmpty
  flatMap
    (m =>
      let sym = mangledName mid m
      if omHasKey sym fns then
        [(sym, m)]
      else if not (isPreludeMid mid) && omHasKey m fns then
        [(m, m)]
      else
        [])
    methodNames

-- L3 (xmod-identity #1351 spine, RUN-XMOD-022/026): the graph-level fact "this
-- compile's decls carry at least one top-level funDef with its own module's
-- mangle prefix" — the DENOTATION the new GraphCtx flag below actually
-- records (F12).  NOT literally "a mangler ran": a hand-written `m__foo` in
-- module `m` on the un-mangled (check/run) path also satisfies it, harmlessly
-- (see that flag's callers).  Reuses `isMangledFor` (F6) rather than a second
-- prefix test, and `funDefs` rather than a second decl walk.
-- Monomorphic, explicit-recursion, short-circuits on the first hit — do NOT
-- delegate to prelude `any`/`elem` here (AGENTS.md: costed +56% self-compile
-- on this file's hot helpers).
--
-- 🚨 RUN-XMOD-045 CORRECTION (post-landing, slice-breaker finding): on EVERY
-- emit path this flag is CONSTANT TRUE, not merely "true when some module
-- shadows an interface method."  `private_mangle.mdk:14-16` states the
-- mangler's actual scope: "EVERY top-level FUNCTION binding (in core + every
-- module) is renamed to a module-qualified unique symbol," unconditionally,
-- BEFORE `elaborateModules` (and therefore this function) ever runs.  So
-- `core`'s own funDefs already carry the `core__` prefix by the time this
-- walks them, and the very first unit checked (`("core", coreDecls)`, see
-- both call sites below) already satisfies `unitCarriesMangledFunDefs` —
-- MEASURED: a feature-free `main = println 1` build emits ~70 distinct
-- `@mdk_core__*`/`@mdk_<mid>__*` symbols in its own IR with zero user
-- modules, zero shadows, zero interfaces.  The ORIGINAL packet's inertness
-- argument (F8: "a non-empty route symbol implies this flag is True") is
-- still literally correct but was read as "this flag is sometimes False,"
-- which is false — it is NEVER False on the emit path, so F8's implication
-- is vacuously satisfied rather than doing narrowing work.  The precondition
-- F8's phrasing hid: BOTH writers (this flag AND the route-symbol conjunct
-- in `importerShadowOnEmitPath`) are stamped by the SAME compile, and on
-- that compile this flag is always True the moment mangling has run at all —
-- see `importerShadowOnEmitPath`'s own header for the consequence.
--
-- 🚨 THIS FACT CURRENTLY HAS NO DISCRIMINATING CONSUMER — L4's conjunct is
-- constant-True on emit and its partner (`occurrenceCarriesMangledShadowSym`)
-- is always-empty off emit.  It is explicit documentation of an implicit
-- invariant, not a live condition.  Do not migrate a reader onto it
-- expecting it to select.  KEPT (not reverted) by owner ruling because it is
-- provably zero-risk and reads better than the anonymous test it replaced —
-- see `importerShadowOnEmitPath`.
graphCarriesMangledFunDefs : List (String, List Decl) -> Bool
graphCarriesMangledFunDefs [] = False
graphCarriesMangledFunDefs ((mid, decls) :: rest) =
  if unitCarriesMangledFunDefs mid (funDefs decls) then
    True
  else
    graphCarriesMangledFunDefs rest

unitCarriesMangledFunDefs : String -> List (String, (List Pat, Expr)) -> Bool
unitCarriesMangledFunDefs mid [] = False
unitCarriesMangledFunDefs mid ((n, _) :: rest) =
  if isMangledFor mid n then True else unitCarriesMangledFunDefs mid rest

buildStandaloneShadowsGraph : List (String, String) ->
  List Decl ->
  List Decl ->
  List String
buildStandaloneShadowsGraph sm allDecls userDecls =
  -- INDEX, not a list: this probes once per user funDef, so a `contains` over the
  -- interface-method names is O(funDefs x methods) — quadratic on a program whose
  -- interface count and top-level binding count grow together.
  let methodNames = omFromNames (allIfaceMethodNames allDecls) omEmpty
  let fns = dedup (map fst (funDefs userDecls))
  let direct = filter (n => omHasKey n methodNames) fns
  -- P0-18: written for the order where the EMIT path's funDef names were MANGLED
  -- (`<mid>__toList`), which the `direct` name-intersection misses; the map recovered
  -- them so the prePass marked their occurrences `EMethodAt`.
  -- #2809: no path reaches this with mangled funDefs any more, and the map is non-empty
  -- on ALL of them — the rows are `(name ↦ name)`, so this filter selects the funDef
  -- names `direct` already selected and the union is unchanged.  The header 25 lines up
  -- states that retirement; this line used to contradict it by claiming the map is empty
  -- off the emit path.  Kept rather than deleted because it is what would recover a
  -- genuinely mangled row if one appeared (a hand-written `<mid>__toList` mints one), and
  -- because `dedup` makes the redundancy free.
  let mangled = filter (n => isSome (lookupAssoc n sm)) fns
  dedup (direct ++ mangled)

-- WS-1a fix: every impl in scope, EXPORT OR NOT.  Instances are GLOBAL (coherence
-- + dispatch leak across module boundaries regardless of `export`), so the
-- superinterface existence query (checkSuperImpls/superImplExists) must see an
-- imported module's `impl Semigroup T` even when it isn't `export`-marked — else
-- `impl Monoid T` in an importer is falsely rejected for a "missing" super impl.
pickSchemes : List String -> OrdMap Scheme -> List (String, Scheme)
pickSchemes [] _ = []
pickSchemes (n :: ns) table = match omLookup n table
  Some s => (n, s) :: pickSchemes ns table
  None => pickSchemes ns table

-- Candidate spellings come from the same three binding sources the environment sees:
-- nameable bare methods (including the implicit core row), selective-import local
-- names, and module-alias-qualified names.  `lookupBinding` below remains the final
-- no-new-name gate, while this bounded list avoids walking every ordinary seed binding.
importedMethodBindingNames : GraphCtx ->
  List Decl ->
  List (String, String) ->
  List String
importedMethodBindingNames gctx prog aliases =
  flatMap snd (nameableIfaceRows gctx prog)
    ++ importedMemberBindingNames prog
    ++ map fst aliases

plainModuleSeed : List (String, Scheme) -> ModuleSeed
plainModuleSeed schemes = ModuleSeed {
  msSchemes = schemes,
  msImportedValues = omEmpty,
  msImportedNames = omEmpty,
  msImportedExterns = omEmpty,
}

-- The ordinary winner and standalone alternative travel together through
-- import selection, aliases, re-exports, and graph memoization.
tagModuleExports : OrdMap Scheme ->
  List (String, Scheme) ->
  List (String, ExportBinding)
tagModuleExports standalones schemes =
  map
    ((name, scheme) => (
      name,
      ExportBinding {
        xbScheme = scheme,
        xbStandalone = omLookup name standalones,
        xbExtern = False,
      },
    ))
    schemes

publicModuleExports : List Decl ->
  ModuleBindings ->
  List (String, ExportBinding)
publicModuleExports prog bindings =
  let standalones =
    omFromPairs
      (flatMap
        (name => match omLookup name bindings.mbStandaloneSchemes
          Some scheme => [(name, scheme)]
          None => [])
        (pubTopFnNames prog))
      omEmpty
  let externs =
    omFromNames (map fst (directExternSigs (externDecls prog))) omEmpty
  map
    ((name, binding) => (
      name,
      ExportBinding { binding | xbExtern = omHasKey name externs },
    ))
    (tagModuleExports
      standalones
      (pickSchemes
        (publicValNames prog)
        (omFromPairs (reverseL bindings.mbSchemes) omEmpty)))

-- The first row for a name wins, unless a second import supplies a different
-- declaration of the same name: then the occurrence is the ambiguity the
-- resolver reports as R-AMBIGUOUS-OCCURRENCE (`ambiguousSet`, keyed by
-- declaration through `importValueDecls`, whichever module each import names;
-- a local definition, which it exempts, shadows the seed here anyway).
-- Choosing either supplier would type the use against a definition the program
-- never named, and the cascade would change with the order the imports were
-- written.
importedBindingWinners : ModuleCtx ->
  List (String, (Option String, ExportBinding)) ->
  OrdMap Unit ->
  OrdMap Unit ->
  List (String, ExportBinding)
importedBindingWinners mctx [] _ _ = []
importedBindingWinners mctx ((name, (_, binding)) :: rest) seen ambiguous =
  if omHasKey name seen then
    importedBindingWinners mctx rest seen ambiguous
  else
    let chosen =
      if omHasKey name ambiguous then
        ambiguousImportBinding mctx ()
      else
        binding
    (name, chosen)
      :: importedBindingWinners mctx rest (omInsert name () seen) ambiguous

ambiguousImports : List (String, (Option String, a)) -> OrdMap Unit
ambiguousImports rows = ambiguousImportsGo rows omEmpty omEmpty

ambiguousImportsGo : List (String, (Option String, a)) ->
  OrdMap String ->
  OrdMap Unit ->
  OrdMap Unit
ambiguousImportsGo [] _ acc = acc
ambiguousImportsGo ((_, (None, _)) :: rest) firstMid acc =
  ambiguousImportsGo rest firstMid acc
ambiguousImportsGo ((name, (Some mid, _)) :: rest) firstMid acc =
  match omLookup name firstMid
    None => ambiguousImportsGo rest (omInsert name mid firstMid) acc
    Some seen => ambiguousImportsGo rest firstMid (if seen == mid then
      acc
    else
      omInsert name () acc)

-- An ambiguous name types as a fresh, poisoned variable at every occurrence
-- (`freshSubst` recognises the reserved quantifier), so the resolver's
-- rejection stays the only diagnostic on the drivers that keep typechecking
-- after a resolve error (`check --json`, the LSP).
ambiguousImportBinding : ModuleCtx -> Unit -> ExportBinding
ambiguousImportBinding mctx _ =
  let cell =
    Ref (Unbound ambiguousImportTyvarId mctx.mcCells.currentLevel.value)
  ExportBinding {
    xbScheme = Forall [ambiguousImportTyvarId] [] [] [] pureRow (TVar cell),
    xbStandalone = None,
    xbExtern = False,
  }

moduleImportSeed : ModuleCtx ->
  List (String, Scheme) ->
  List (String, (Option String, ExportBinding)) ->
  ModuleSeed
moduleImportSeed mctx base imported =
  let selected =
    importedBindingWinners mctx imported omEmpty (ambiguousImports imported)
  ModuleSeed {
    msSchemes =
      base ++ map ((name, binding) => (name, binding.xbScheme)) selected,
    msImportedValues =
      omFromPairs
        (flatMap
          ((name, binding) => match binding.xbStandalone
            Some scheme => [(name, scheme)]
            None => [])
          selected)
        omEmpty,
    msImportedNames = omFromNames (map fst selected) omEmpty,
    msImportedExterns =
      omFromNames
        (flatMap
          ((name, binding) => if binding.xbExtern then [name] else [])
          selected)
        omEmpty,
  }

-- `import m as A` binds EVERY value m exports under `A.name` — so it enumerates the
-- dependency's schemes rather than a fixed member list.
--
-- Same golden/mangled split as above: on the emit path the reference is already
-- `<definer>__name`, so the key must stay mangled; on the golden path the reference is
-- the flat `A.name` that desugar produced, so bind it under that.
--
-- #1337/#1427/#1472: the mangle test asks the LOADED MODULE-ID SET, not just the module
-- the importer spelled.  A key reached through `export import` is mangled for its
-- DEFINER, not for the re-exporter `m` that the importer named — so a spelled-mid-only
-- prefix test answered False for it and re-bound `lib_plain__g` as `A.lib_plain__g`,
-- while types/private_mangle (which chases re-exports to the definer) had already
-- rewritten the body's reference to the bare `lib_plain__g`.  The lookup then missed:
-- for a constrained callee that reaches inferDictAt's panic and `build` fails outright
-- (#1427); for an unconstrained one the enclosing prelude call's dict route resolves to
-- nothing, the emitter writes a null dict operand, and the BINARY segfaults (#1472).
--
-- Conservatism (the property this rests on): a BARE key — one no loaded module exports
-- under that exact name with that module's own mangle prefix — is still re-bound under
-- the alias.  That population is exactly the interface METHODS (publicValNames admits
-- them; private_mangle's rename map, built from unitDefNames/pubFnNames, never renames
-- them), which is the occurrence-carrier question #1276/#1386 own — deliberately NOT
-- moved here.  The only keys whose binding changes are those a DIFFERENT loaded module
-- actually exports under its mangled name, i.e. precisely the re-exported ones, i.e.
-- precisely the defect.
--
-- 🚨 THE TEST IS AN IDENTITY TEST, NOT A STRING-SHAPE TEST (RUN-XMOD-039 F2), and it
-- must stay one.  A first version asked only "does `k` carry SOME loaded module's mangle
-- prefix?" — a pure spelling question — and that regressed a program base accepted: with
-- a module `lib.plain` loaded, an unrelated module's ordinary exported binding literally
-- named `lib_plain__g` was misread as already-mangled and rejected `Unbound variable:
-- O.lib_plain__g` at exit 1.  That surface is UNBOUNDED AND GROWS WITH THE MODULE GRAPH
-- (every module `a.b` makes `a_b__x` a landmine), and a sprint whose thesis is "identity
-- must not be derived from spelling" cannot decide identity by spelling, even in a guard.
-- ⚠️ So do NOT repair a future false positive here by TIGHTENING THE PREFIX PATTERN — a
-- narrower heuristic has a smaller unbounded surface, not a bounded one.  The conjunct
-- below is what bounds it: `k` must be a name the candidate module ACTUALLY EXPORTS, so
-- a false positive now requires two modules to genuinely export the same symbol rather
-- than one identifier to merely look like a mangled one.
aliasSchemes : List (String, List (String, a)) ->
  String ->
  List (String, a) ->
  List (String, a)
aliasSchemes deps alias depSchemes =
  map (aliasSchemeEntry deps alias) depSchemes

aliasSchemeEntry : List (String, List (String, a)) ->
  String ->
  (String, a) ->
  (String, a)
aliasSchemeEntry deps alias (k, s) =
  if isMangledExportOfAny deps k then (k, s) else (qualifiedLocal alias k, s)

-- does `k` carry the `<sanitized mid>__` prefix the mangler would have given it?
isMangledFor : String -> String -> Bool
isMangledFor mid k =
  let pre = mangledName mid ""
  let lp = stringLength pre
  lp <= stringLength k && stringSlice 0 lp k == pre

-- is `k` a symbol some loaded module ACTUALLY EXPORTS under that module's own mangled
-- name?  Both halves are load-bearing and the ORDER is deliberate: the cheap spelling
-- test gates the assoc lookup, so the scan below runs only for the rare key that already
-- looks mangled.  Short-circuiting and monomorphic on purpose (a dict-passed `any` over
-- a closure is the measured anti-pattern here).
--
-- 🚨 THE HONEST RESIDUAL, RECORDED SO THE NEXT READER DOES NOT HAVE TO RE-DERIVE IT
-- (RUN-XMOD-042).  This is "SHAPE **AND** ACTUALLY-EXPORTED", **not** pure identity, and
-- the distinction matters if you are auditing it against the sprint's own thesis that
-- identity must not be derived from spelling.  `isMangledFor` is still a string test; it
-- has simply stopped being the *whole* decision.  What the `isSome (lookupAssoc k pubV)`
-- conjunct buys is that the surface becomes BOUNDED BY THE PROGRAM'S REAL EXPORT SET: a
-- false positive now needs a GENUINE SYMBOL COLLISION -- module `m` must actually export
-- something named exactly `k`, where `k` also carries `m`'s mangle prefix -- instead of
-- merely a similar-LOOKING name.  Before the conjunct, the surface grew with the module
-- graph (every module `a.b` made `a_b__x` a landmine, which is what regressed `core__foo`
-- and `lib_plain__g`); now it does not grow with the graph at all.
--
-- ⚠️ WHY NOT DROP THE SHAPE HALF AND MAKE IT PURE IDENTITY?  Because that is measurably
-- WRONG here, not merely purer: a re-exported interface METHOD key is also a key of its
-- declaring module's `pubV`, so "is `k` a key of some other loaded module?" alone answers
-- True for methods and would re-bind them -- moving the bare-key population that
-- #1276/#1386 own and that this slice must not touch.  The shape half is precisely what
-- holds methods out (a bare method name carries no `<mid>__` prefix).  So the two halves
-- are not redundant and neither may be removed on tidiness grounds.
--
-- ⚠️ The residual's true root is one level down and is NOT fixed here: private_mangle's
-- `(module, name) -> symbol` encoding is not injective -- a module `lib.plain` and a
-- module literally named `lib_plain` both yield `lib_plain__g`.  That is the common root
-- of both regressions above and is bigger than this function; do not try to repair it by
-- editing this test.
isMangledExportOfAny : List (String, List (String, a)) -> String -> Bool
isMangledExportOfAny [] _ = False
isMangledExportOfAny ((m, pubV) :: rest) k =
  isMangledFor m k && isSome (lookupAssoc k pubV) || isMangledExportOfAny rest k

-- the (key, scheme) pairs a single `import` form brings into scope, resolving each
-- member to its (possibly mangled) key in the dependency's schemes.  `deps` is the
-- loaded dependency environment — module id PLUS that module's public schemes, because
-- the alias arm's test needs the exported NAMES, not just the ids (see aliasSchemes).
-- The non-alias arms ignore it — their resolution is definer-agnostic by construction
-- (a `__<name>` SUFFIX test, and the wildcard form performs no mangle test at all).
--
-- Passing `depEnv` WHOLE is also what supplies the spelled `depId` itself: both callers
-- reach this only through a successful `lookupAssoc depId depEnv`, so the spelled module
-- is in the list by construction and needs no separate term.
--
-- 🚨 `"core"` IS DELIBERATELY **NOT** IN `mids`, AND MUST NOT BE ADDED BACK
-- (RUN-XMOD-039).  It was, briefly.  The argument for it reads well — `reexportSeed`'s
-- own comment records core as the one source NOT in depEnv, and private_mangle *does*
-- mangle core's exports to `core__<name>` — but it was DERIVED, never witnessed: a
-- `export import core.{…}` reached through an alias is green on every verb with or
-- without the term, because core's names are seeded via `baseSeed` and resolve before
-- the alias binding is ever consulted.  Meanwhile the term has a MEASURED cost: it made
-- `mangledName "core" "" == "core__"` a live prefix, so an ordinary user binding named
-- `core__foo` reached through an alias import was misread as already-mangled and left
-- un-rebound — `Unbound variable: O.core__foo`, exit 1, on a program that compiled and
-- printed correctly before.  Zero measured benefit, measured cost.
importFormSchemes : List (String, List (String, a)) ->
  UsePath ->
  List (String, a) ->
  List (String, a)
importFormSchemes deps (UseAlias _ alias) depSchemes =
  aliasSchemes deps alias depSchemes
importFormSchemes _ path depSchemes = importFormRows path depSchemes

-- ── import aliasing: re-key the dict-arity / dict-iface tables ───────────────────
-- Both tables (funConstraintsRef, funConstraintIfacesRef) are keyed by the name a CALL
-- SITE writes.  An alias makes that name differ from the definition's, so without this
-- an aliased constrained callee gets zero dict routes and under-applies.  Generic over
-- the payload so the arity table (List Int) and the iface table (List String) share it.
--
-- [qual] is the (definerMid, name)-keyed table, which is what makes this PRECISE: an
-- entry is copied only when its DEFINER is the very module the alias names.
-- #1114 (#845): THIS module's imported bindings' SCHEME CONTEXTS, keyed by the local
-- spelling the importer writes.  Structurally the sibling of `aliasConstraintEntries`
-- below — same `DUse` walk, same "copy an entry only when its DEFINER is the very module
-- this import names" precision, and the payload is likewise taken from the
-- `(definerMid, name)`-keyed qual table.
--
-- TWO deliberate differences from `aliasConstraintEntries`, both because that function
-- serves the DICT-ARITY tables on the emit path and this one serves the CHECK-time
-- obligation channel:
--   * it has a `UseWild` arm.  `aliasConstraintEntries` needs none — on the emit path a
--     wildcard-imported name keeps its own spelling and `funConstraintsRef` is re-seeded
--     from the bare `crossModuleFunConstraintsRef` accumulator, which already covers it.
--     The check path has no such bare re-seed (that ref is the emit path's), so without
--     this arm `import m.*` would be the one spelling that still dropped the obligation.
--   * it emits the UNALIASED member of a `UseGroup` too (`useMemberLocal`, not
--     `useMemberAlias`), because plain `import m.{f}` is the common spelling and is
--     exactly what #845 pins.
--
-- ⚠️ Kept SEPARATE from `aliasConstraintEntries` rather than generalizing it. Adding a
-- `UseWild` arm there would change what `funConstraintsRef` holds on the emit path, i.e.
-- dict-passing arity — a different judgment, with a different blast radius, reached from
-- here only by the coincidence that both read the same qual-table shape.
importedSchemeOblEntries : List Decl ->
  List ((String, String), List VecObl) ->
  List (String, List VecObl)
importedSchemeOblEntries [] _ = []
importedSchemeOblEntries ((DAttrib _ d) :: rest) qual =
  importedSchemeOblEntries [d] qual ++ importedSchemeOblEntries rest qual
importedSchemeOblEntries ((DUse _ path _) :: rest) qual =
  schemeOblEntriesFor (importTableMid path) path qual
    ++ importedSchemeOblEntries rest qual
importedSchemeOblEntries (_ :: rest) qual = importedSchemeOblEntries rest qual

-- ── import aliasing of an interface/impl METHOD ─────────────────────────────────
-- A method is GLOBAL-BY-NAME.  Impl coalescing, dispatch routing, the emitter's method
-- tables and the METHOD-side dict-arity tables are every one of them keyed by the
-- method's own name, and there is exactly ONE cell per name — a method is deliberately
-- NOT a per-module binding (eval.mdk's globalCells / coalesceImpls).  So an alias of a
-- method is not a new binding at all: it is a second SPELLING of the same method.
--
-- No alias spelling is resolved here, module or member.  The alias spelling is what
-- makes the occurrence decidable.  Erasing `A.area` makes it the same name as an
-- unrelated imported standalone `area`, and the standalone shadow wins (#1386 Repro B);
-- erasing a member alias `import m.{area as computeArea}` makes `computeArea` and a bare
-- `area` one name, so the import's method captures an `area` that resolve bound to
-- another declaration (#3708).  Inference gets the spelling supplied to it
-- (`aliasQualifiedMethodEntries`, `moduleMarkCtx`, `originMethodName`) and
-- `resolveAliasMethodSpellings` puts the occurrence back under its origin name once
-- inference is done, so every stage after elaboration still sees an ordinary method
-- reference and needs no alias awareness.
--
-- That is also precisely why the METHOD-side predicate carrier and its qualified
-- scoped projection need no alias re-keying the
-- way funConstraintsRef did: by the time they are built, no aliased method name survives.
-- The standalone `=>`-constrained functions are the opposite case — they ARE per-module
-- bindings that keep their local name, which is why they needed the re-keying.
--
-- What this pass does rewrite is a module alias's `DUse`: it keeps its own non-method
-- values and an `import m.{…m's methods…}` is appended beside it, so the origin name is
-- in scope for the occurrence `resolveAliasMethodSpellings` resolves it to.  A member
-- alias's `DUse` is rewritten to its origin name by that same restore, after inference.
-- Beside the rewritten modules it returns each module's admissions, which the drive's
-- mint installs (`GraphCtx.graphAdmittedMethodsRef`, read by `admittedIn`).
renameAliasedMethods : List Decl ->
  List (String, List Decl) ->
  (OrdMap (List (String, String)), List (String, List Decl))
renameAliasedMethods coreDecls modules =
  let coreEntry = ("core", declMethodNames coreDecls)
  let methodsPerMid = coreEntry :: methodsPerMidGo [coreEntry] modules
  let admitted =
    omFromPairs
      (map
        ((mid, prog) => (mid, synthesizedAdmissions methodsPerMid prog))
        modules)
      omEmpty
  (admitted, map (renameAliasedMethodsIn methodsPerMid) modules)

admittedIn : GraphCtx -> String -> List (String, String)
admittedIn gctx mid =
  optionOr [] (omLookup mid gctx.graphAdmittedMethodsRef.value)

-- The method names `deAliasMethodImports` admits WITHOUT a binding the resolver
-- counted: every method of an alias-imported module.  `importSeed` reads this so
-- such a row never makes a bare name look supplied twice.
synthesizedAdmissions : List (String, List String) ->
  List Decl ->
  List (String, String)
synthesizedAdmissions _ [] = []
synthesizedAdmissions mm ((DAttrib _ d) :: rest) =
  synthesizedAdmissions mm (d :: rest)
synthesizedAdmissions mm ((DUse _ path _) :: rest) =
  let mid = useModId path
  let here = match lookupAssoc mid mm
    None => []
    Some methods => match path
      UseAlias _ _ => map (n => (mid, n)) methods
      _ => []
  here ++ synthesizedAdmissions mm rest
synthesizedAdmissions mm (_ :: rest) = synthesizedAdmissions mm rest

-- A module's method set is what it DECLARES *plus what it RE-EXPORTS*, folded in
-- dependency-first (loader) order so a re-export resolves against its source's
-- already-computed set (and a >1-hop chain still resolves).
--
-- The `++ reexportedMethodNames` half closes a run≠build divergence that predates
-- core re-exports and is NOT core-specific: with a module's set limited to its own
-- `declMethodNames`, a module that re-exports a method did not list it, so at an
-- importer's `import reExporter.{method as alias}` neither half of the rewrite fired
-- — the alias was not dropped from the DUse (b) and references were not renamed to the
-- origin (a).  `run` still worked (eval's import frame binds the alias to the origin's
-- cell), but a method is global-by-name with no per-module symbol, so EMIT had nothing
-- to bind `alias` to and died with `unbound variable '<alias>'`.  Observed on a pure
-- user-module chain (b defines `area`; c re-exports it; main imports `area as surface`
-- → run prints 16, build fails), and on `import list.{filter as f}` once
-- `export import core.{filter}` began re-exporting at all.
methodsPerMidGo : List (String, List String) ->
  List (String, List Decl) ->
  List (String, List String)
methodsPerMidGo _ [] = []
methodsPerMidGo acc ((mid, decls) :: rest) =
  let entry =
    (mid, dedup (declMethodNames decls ++ reexportedMethodNames acc decls))
  entry :: methodsPerMidGo (entry :: acc) rest

-- method names a module re-exports via `export import src.{…}` (`DUse True`), taken
-- from `acc` — the dependency's already-folded method set.
reexportedMethodNames : List (String, List String) -> List Decl -> List String
reexportedMethodNames acc decls = flatMap (reexportedMethodsOf acc) decls

reexportedMethodsOf : List (String, List String) -> Decl -> List String
reexportedMethodsOf acc (DAttrib _ d) = reexportedMethodsOf acc d
reexportedMethodsOf acc (DUse True path _) =
  match lookupAssoc (useModId path) acc
    None => []
    Some srcMethods => match importedBindings path
      -- `export import src.*` re-exports every one of src's methods
      None => srcMethods
      Some bs => filterList (n => contains n srcMethods) (map fst bs)
reexportedMethodsOf _ _ = []

-- Only a MODULE alias is rewritten before inference (`deAliasMethodImports`).  A
-- member alias reaches inference as written, so `import m.{mth as loc}` binds `loc`
-- and not `mth`; `resolveAliasMethodSpellings` restores the origin name afterwards.
-- The pass is a no-op on a module whose imports name no method.
renameAliasedMethodsIn : List (String, List String) ->
  (String, List Decl) ->
  (String, List Decl)
renameAliasedMethodsIn methodsPerMid (mid, prog) =
  (mid, flatMap (deAliasMethodImports methodsPerMid) prog)

-- `import m as A` is kept (its non-method values are still `A.f`) and gains a sibling
-- `import m.{…m's methods…}`, the origin name `resolveAliasMethodSpellings` resolves
-- `A.area` to once inference is done.  The rewrite is recorded in
-- `graphAdmittedMethodsRef` (`synthesizedAdmissions`), because the resolver never saw
-- it.  The added import keeps the alias import's path and location, which is how the
-- method scope ladder tells it from a written one (`writtenImportsOf`).
deAliasMethodImports : List (String, List String) -> Decl -> List Decl
deAliasMethodImports mm (DAttrib attrs d) =
  map (DAttrib attrs) (deAliasMethodImports mm d)
deAliasMethodImports mm (d@(DUse pub path loc)) =
  match lookupAssoc (useModId path) mm
    None => [d]
    Some methods => match path
      UseAlias quals _ => match methodMembersOf methods loc
        [] => [d]
        mems => [d, DUse pub (UseGroup quals mems) loc]
      _ => [d]
deAliasMethodImports _ d = [d]

methodMembersOf : List String -> Loc -> List UseMember
methodMembersOf methods loc = map (n => UseMember n False loc None) methods

-- [qualified] holds the `A.mth` spellings: nothing but the method can be spelled that
-- way, so every occurrence moves.  [members] holds the member-alias locals no own
-- top-level value takes (`memberAliasCands`), which a local binder can still spell;
-- only a MARKED occurrence is the import's, since the marker leaves a locally-bound
-- name unmarked (`rewriteArgScoped`).
renameMethodVar : List (String, String) -> List (String, String) -> Expr -> Expr
renameMethodVar qualified _ (e@(EVar x)) = match lookupAssoc x qualified
  Some origin => EVar origin
  None => e
renameMethodVar qualified _ (e@(EVarId x _)) = match lookupAssoc x qualified
  Some origin => EVar origin
  None => e
-- A marked occurrence: `resolveAliasMethodSpellings` runs after inference, on a tree
-- the schedule has already marked.  Only the NAME moves — the route cell carries the
-- dispatch decision inference reached under the alias spelling.
renameMethodVar qualified members (e@(EMethodAt x sym ev)) =
  match lookupAssoc x qualified
    Some origin => EMethodAt origin sym ev
    None => match lookupAssoc x members
      Some origin => EMethodAt origin sym ev
      None => e
renameMethodVar _ _ e = e

-- ── #1386: the alias-qualified spelling, resolved AFTER inference ───────────────
-- `A.mth`, and a member alias `loc` from `import m.{mth as loc}`, reach inference
-- spelled as written, because that spelling is what makes the occurrence decidable:
-- rewriting either to a bare `mth` up front merges it with whatever else a bare `mth`
-- names in this module (`renameAliasedMethods`' header, #1386 Repro B, #3708).  Every
-- reader inference needs is supplied under that spelling — the obligation table, the
-- mark sets, the dispatch index — so the distinction survives exactly as long as it
-- decides something.
--
-- It must not survive further.  Everything DOWNSTREAM of elaboration keys a method by
-- its origin name and only its origin name: eval's coalesced method cells and its
-- per-(method, tag) `requires` counts (`methodReqCountRef`, whose miss would turn a
-- dispatch into the inherited-default path), the Core-IR interpreter's twin, and the
-- emitter's method tables.  Resolving the spelling here leaves all of them the tree
-- they get today, so the fix is a VERDICT change and nothing else.
resolveAliasMethodSpellings : GraphCtx ->
  (String, List Decl) ->
  (String, List Decl)
resolveAliasMethodSpellings gctx (mid, prog) =
  let qualified = map aliasRowSpelling (useKeyCands (moduleAliasKeys gctx) prog)
  let members = map aliasRowSpelling (memberAliasCands gctx prog)
  match (qualified, members)
    ([], []) => (mid, prog)
    _ => (
      mid,
      mapProg
        (renameMethodVar qualified members)
        (map (deAliasMethodMembers members) prog),
    )

-- `import m.{mth as loc}` → `import m.{mth}`, once every `loc` occurrence carries `mth`:
-- downstream of elaboration a method is bound by its origin name only.  Only a
-- `DUse` names import members, so every other decl passes through unchanged.
deAliasMethodMembers : List (String, String) -> Decl -> Decl
deAliasMethodMembers rows (DAttrib attrs d) =
  DAttrib attrs (deAliasMethodMembers rows d)
deAliasMethodMembers rows (DUse pub (UseGroup quals ms) loc) =
  DUse pub (UseGroup quals (map (deAliasMethodMember rows) ms)) loc
deAliasMethodMembers _ d = d

deAliasMethodMember : List (String, String) -> UseMember -> UseMember
deAliasMethodMember rows (m@(UseMember n allCtors loc (Some local)))
  | containsPair (local, n) rows = UseMember n allCtors loc None
  | otherwise = m
deAliasMethodMember _ m = m

-- every interface/impl method name a decl list declares (interface methods with or
-- without a default, plus impl method names).
declMethodNames : List Decl -> List String
declMethodNames decls = dedup (flatMap declMethodNamesOf decls)

declMethodNamesOf : Decl -> List String
declMethodNamesOf (DAttrib _ d) = declMethodNamesOf d
declMethodNamesOf (DInterface { methods, ... }) = ifaceMethodNames methods
declMethodNamesOf (DImpl { methods, ... }) = map implMethodName methods
declMethodNamesOf _ = []

-- build THIS module's import-scoped seed: walk its DUse decls, and for each one
-- pick the imported names out of the named dependency's public schemes (held in
-- depEnv, keyed by the dotted module id that useModId yields == the loader's
-- mid).  `core` DUse decls are skipped — core is always seeded via baseSeed.
-- ── #1675: reject an import that admits a name with more than one denotation ──────
-- The hub `export import lib.pa.{g}` + `export import lib.pb.{g}` exports ONE spelling
-- `g` standing for TWO definitions.  Downstream, `resolveMemberRows`' `lookupAssoc`
-- took the first of them and every verb exited 0, so which function ran was decided by
-- the ORDER OF TWO `export import` LINES — a semantically null edit moving the printed
-- value from `2` to `10`.  This is the reject.
--
-- ⚠️ THE MECHANISM IS THE EXACT-KEY ARM, NOT THE `__<name>` SUFFIX FALLBACK, and the
-- distinction decides where the check can live.  #1675's body cites the suffix `filter`
-- ("cited, not instrumented", per its own pin's claim) — but `types/private_mangle`
-- runs ONLY in the emit drivers, so on `check`/`run` the hub's rows are keyed by the
-- BARE name, `lookupAssoc origin` HITS, and the fallback is never reached.  A guard
-- written on "the filter returned more than one candidate" is green on the whole repro.
-- The ambiguity is a property of the DEPENDENCY'S EXPORT TABLE, which is where
-- `deAmbigValues` records it, on both paths at once.
--
-- Reported at the IMPORT DECL (that is where the location points, and where the fix
-- belongs), but keyed on an OCCURRENCE: a name is rejected only if this module actually
-- WRITES it, in the spelling the form binds it under — bare for `import m.*` and for a
-- selective `{g}`, alias-qualified (`A.g`) for `import m as A`.  A hub may re-export a
-- hundred names under two denotations; an importer that never mentions any of them has
-- no ambiguity to resolve and must not be rejected.  This is the USE-SITE model taken
-- literally (#1070's reject-at-declaration stays superseded; the hub itself is still
-- legal).  It also keeps the verdict from depending on which definer came first: the
-- moment the name IS written, the import is rejected rather than silently resolved.
--
-- ⚠️ CORRECTED (sprint-review F2, from #1675's own landed behavior): the first cut
-- rejected at ADMISSION — `import lib.hub.*` / `import lib.hub as H` failed even when
-- the importer never mentioned the colliding name, while the selective form correctly
-- did not.  The precedent cited for that, `T-AMBIGUOUS-ALIAS-METHOD`, is a DIFFERENT
-- namespace: methods are dispatched by argument type, where "admitted into scope" and
-- "used" are hard to pull apart because having the method callable is often the point.
-- Whether the method side wants the same narrowing is a separate question, deliberately
-- not answered here.
--
-- ⚠️ THE CHAIN IS NOT WEAKENED by narrowing to an occurrence.  `reexportDefiners` takes
-- a wildcard `export import`'s rows WHOLESALE, so a module that re-exports an ambiguous
-- hub without mentioning the name carries the ambiguity into its OWN export table, and
-- the first module downstream that does write the name is rejected there.  Nothing is
-- laundered clean by passing through a silent hop.
--
-- Called from `checkBodyImpl`, after its module mint, and not from `importSeed`.
-- `importSeed` is where the member resolution lives and was the first home for this, but
-- the seed is computed in `foldModules` BEFORE the module's worker runs, and
-- `checkBodyImpl` opens with `freshModuleCtx` — which clears `typeErrors`.  MEASURED on
-- that version: `run` exited 1 with the unlocated "detected during elaboration … see
-- issue #1812" fallback (the sticky flag survives the reset, the diagnostic does not)
-- and `check`/`check --json` were both still SILENT at exit 0 on the whole repro.  A
-- diagnostic pushed while a seed is being built cannot be reported.  Everything this
-- needs is on the module's own `DUse` decls plus the graph table, so nothing is lost by
-- moving it inside the window; `checkBodyImpl` is the ONE body all four drivers share
-- (`checkModuleFullImpl` and `elabModuleStamp` both route through it), which is what
-- keeps `check` and the run/build elaboration pass answering alike.
reportAmbiguousImports : ModuleCtx -> List Decl -> Unit
reportAmbiguousImports mctx prog0 =
  reportAmbiguousImportsIn mctx (moduleRefNameSet prog0) prog0

-- every name this module's own decl bodies REFERENCE, as a set.  Parallels `groupRefs`'
-- collector (`freeEVars`, which skips locally bound names; `allEVars` here keeps every
-- occurrence) one level up, at the decl layer: the top-level clause bodies plus
-- the impl/default/prop/test bodies, which is every place a user program can spell
-- an imported value.  Alias-qualified references arrive here already flattened into a
-- single dotted `EVar "A.g"` by desugar's `rewriteAliasQual` (via `qualifiedLocal`), so
-- the alias spelling is a plain string lookup and needs no separate walk.
--
-- `allEVars` has no `EMethodRef` arm and does not need one: no production verb ever
-- constructs that node (it does carry `EMethodAt`/`EDictAt`, the shapes the elaborate
-- driver's dict pre-pass actually mints).  Independently of shape, the rows being filtered
-- come from `ambiguousExportRows` → `modulePubDefiners` → `pubTopFnNames`, i.e.
-- `declTopFnNames` ∩ exports — so an interface method name can never be in `amb` at all.
moduleRefNameSet : List Decl -> OrdMap Unit
moduleRefNameSet decls = namesToSet (flatMap declRefNames decls) omEmpty

declRefNames : Decl -> List String
declRefNames (DAttrib _ d) = declRefNames d
declRefNames (DFunDef _ _ _ body _ _) = allEVars body
declRefNames (DProp _ _ _ body) = allEVars body
declRefNames (DTest _ _ body) = allEVars body
declRefNames (DLetGroup _ binds) = flatMap letBindEVars binds
declRefNames (DImpl { methods, ... }) = flatMap implMethodEVars methods
declRefNames (DInterface { methods, ... }) = flatMap ifaceMethodEVars methods
declRefNames _ = []

implMethodEVars : ImplMethod -> List String
implMethodEVars (ImplMethod _ _ body) = allEVars body

ifaceMethodEVars : IfaceMethod -> List String
ifaceMethodEVars (IfaceMethod _ _ d _) = match d
  Some (MethodDefault _ body) => allEVars body
  None => []

-- `core` is never in `depEnv` (it is the implicit prelude — `reexportSeed`'s comment
-- carries the full reason), so it is passed separately as `coreV`, and it contributes
-- ONE thing: the keys an ALIAS introduces.  A plain `import core.{f}` still seeds
-- nothing, because `f` is already in `baseSeed` under that very spelling and seeding it
-- twice only adds a duplicate assoc entry — but `import core as C` and
-- `import core.{f as g}` ask for `C.f` / `g`, which `baseSeed` does not hold under any
-- spelling.  `resolve.mdk`'s `coreAliasNames` binds exactly the same two forms, and the
-- two must agree: a key bound in scope with no scheme here is a `T-UNBOUND` at the use
-- site, which is what #95 measured for six years.
-- Each row a use-path BINDS carries the declaration it denotes
-- (`importSupplierKey`), the same identity the resolver's value ambiguity check
-- keys on (`importValueDecls`), so `moduleImportSeed` can refuse to pick a winner
-- by import order for a name the resolver has already rejected, and still
-- accept one declaration reached through two imports. A row the form admits
-- without binding its name (a bare method row admitted for dispatch, a mangled
-- twin) carries no supplier, and core is exempt there as it is in the resolver.
-- The key is looked up by local name, so one member list binding a local twice
-- (`import m.{a as b, b}`) gives both rows one key and the first row wins here;
-- the resolver rejects that occurrence by declaration all the same.
importSeed : GraphCtx ->
  List (String, a) ->
  List (String, String) ->
  List Decl ->
  List (String, List (String, a)) ->
  List (String, (Option String, a))
importSeed gctx _ _ [] _ = []
importSeed gctx coreV admitted ((DAttrib _ d) :: rest) depEnv =
  importSeed gctx coreV admitted (d :: rest) depEnv
importSeed gctx coreV admitted ((DUse _ path _) :: rest) depEnv =
  let depId = useModId path
  if depId == "core" then
    map (suppliedBy None) (coreAliasSchemes path coreV)
      ++ importSeed gctx coreV admitted rest depEnv
  else match lookupAssoc depId depEnv
    None => importSeed gctx coreV admitted rest depEnv
    Some depSchemes =>
      let bound = boundNames path
      let decls =
        omFromPairs
          (reverseL (importFormRows path (graphPubDefiners gctx depId)))
          omEmpty
      let methods =
        identKeysByName
          omEmpty
          (importFormRows
            path
            (match omLookup depId (methodExportsIndex gctx ())
              Some rows => rows
              None => []))
      map
          (row =>
            suppliedBy
              (if bindsName bound (fst row)
                && not (containsPair (depId, fst row) admitted) then
                Some (importSupplierKey depId decls methods (fst row))
              else
                None)
              row)
          (importFormSchemes depEnv path depSchemes)
        ++ importSeed gctx coreV admitted rest depEnv
importSeed gctx coreV admitted (_ :: rest) depEnv =
  importSeed gctx coreV admitted rest depEnv

-- The identity one import's binding of `name` is compared by: the declaration
-- it denotes.  A standalone value is `(defining module, name there)` from
-- `graphPubDefiners`, first row winning as it does there; an interface method
-- is the set of method declarations the import carries under that name
-- (`meExports`).  A driver without an import graph knows neither, so the
-- binding falls back to the importing module's id.  The three key shapes are
-- two, a multiple of four, and one netstring long, so no two can coincide.
importSupplierKey : String ->
  OrdMap (String, String) ->
  OrdMap (List String) ->
  String ->
  String
importSupplierKey depId decls methods name = match omLookup name decls
  Some (defMid, origin) => "\{lenKey defMid}\{lenKey origin}"
  None => match omLookup name methods
    Some keys => joinWith "" (sortUniqS keys)
    None => lenKey depId

identKeysByName : OrdMap (List String) ->
  List (String, Ident) ->
  OrdMap (List String)
identKeysByName acc [] = acc
identKeysByName acc ((n, ident) :: rest) =
  let seen = match omLookup n acc
    Some keys => keys
    None => []
  identKeysByName (omInsert n (identKey ident :: seen) acc) rest

suppliedBy : Option String -> (String, a) -> (String, (Option String, a))
suppliedBy mid (name, row) = (name, (mid, row))

containsPair : (String, String) -> List (String, String) -> Bool
containsPair _ [] = False
containsPair (a, b) ((x, y) :: rest) =
  a == x && b == y || containsPair (a, b) rest

-- The names an import form binds, as the resolver counts them
-- (`importedNamesMM`): a member list binds its locals, a single dotted name its
-- last component, an alias nothing bare, and a wildcard (`None`) every name it
-- reaches.
boundNames : UsePath -> Option (OrdMap Unit)
boundNames (UseGroup _ ms) = Some (omFromNames (map useMemberLocal ms) omEmpty)
boundNames (UseName ns) =
  Some (omFromNames (if listLen ns > 1 then [lastComponent ns] else []) omEmpty)
boundNames (UseWild _) = None
boundNames (UseAlias _ _) = Some omEmpty

bindsName : Option (OrdMap Unit) -> String -> Bool
bindsName None _ = True
bindsName (Some names) name = omHasKey name names

-- the schemes a `core` use-path binds under a spelling the prelude did not supply.
coreAliasSchemes : UsePath -> List (String, a) -> List (String, a)
coreAliasSchemes (UseAlias _ a) coreV = map (coreQualScheme a) coreV
coreAliasSchemes (UseGroup _ ms) coreV = flatMap (coreRenameScheme coreV) ms
coreAliasSchemes _ _ = []

coreQualScheme : String -> (String, a) -> (String, a)
coreQualScheme a (k, s) = (qualifiedLocal a k, s)

coreRenameScheme : List (String, a) -> UseMember -> List (String, a)
coreRenameScheme coreV m = match useMemberAlias m
  None => []
  Some local => match lookupAssoc (useMemberOrigin m) coreV
    None => []
    Some s => [(local, s)]

-- WS-2/D2: THIS module's imported value name → import-source module id, from its DUse
-- decls.  Mirrors importSeed's walk but records (localName, depId) for EXPLICIT imports
-- only (importedBindings = Some bindings); a wildcard `import mod.*` (None) is skipped —
-- it can't enumerate names here, so those names fall back to the bare arity table at the
-- call site.  `core` is skipped (core fns route via the prelude dict machinery, never the
-- cross-module qual tables).  depId == useModId == the loader mid == the qual
-- tables' definer key for a DIRECT import; a re-exported fn's depId is the intermediate
-- (≠ definer), so its qual lookup misses and it too falls back to bare (correct).
--
-- Keyed by the LOCAL name, because that is the name the CALL SITE writes: under a member
-- alias (`import m.{a as b}`) the call site says `b`, so `b` is what must map to m.
--
-- A whole-module alias (`import m as A`) contributes nothing, for the same reason a
-- wildcard doesn't: its locals are one-per-export and this walk has no depEnv to
-- enumerate them.  Those call sites take the same documented bare-table fallback as
-- every wildcard import does today.  The dict ARGS themselves are unaffected — they are
-- stamped from the callee's SCHEME, which importSeed binds under the alias local — so
-- this costs only the cross-module arity DISAMBIGUATION, and only when two modules
-- export same-named constrained fns of differing dict arity.
-- ── #674 / #1111 A-2.6: import-scoped constructor overlay ──────────────────
-- The `data`/`newtype` decls (from the surrounding universe `pool`) whose
-- CONSTRUCTORS this module binds by name, read from its own DUse decls.  They
-- OVERLAY the whole-universe ctor tables (the typecheck scheme table, the
-- record-info table AND the exhaust oracle) so a bare ctor / record name resolves
-- to the SPECIFIC module this unit imports it from — instead of the universe's
-- arbitrary load-order winner, the #674 root cause where the check side
-- (last-loaded-wins) and the native mangler (first-import-wins) DISAGREED.
--
-- A `UseGroup` member contributes its owning decl when EITHER
--   (a) it carries the `(..)` flag and names the decl's TYPE (`import m.{T(..)}`) —
--       the original #674 rule; or
--   (b) it NAMES ONE OF THE DECL'S CONSTRUCTORS (`import m.{T, C}` — and, because a
--       record's sole variant carries the type's own name, `import m.{Cfg}` for a
--       `data Cfg = { … }`).  #1111 A-2.6: (b) is the half that drains #1259 (the
--       ctor-scheme env) and #1256 (the record-info table).
--
-- ⚠️ Rule (b) is a CONSTRUCTOR-name test, not a "not a type name" test, and the
-- difference is observable.  A member spelled like a TYPE contributes nothing only when
-- no decl of `mid` happens to have a constructor of that spelling; if one does, the
-- member matches by rule (b) and that SIBLING decl is overlaid.  Measured: `pmod` with
-- `data Wrap = T Int`, `import pmod.{T, pf}`, and a local `data Loc = T String` —
-- pinned as `test/llvm_fixtures_modules/ctor_scope_type_only_sibling_decl/`.
-- (An earlier revision of this note claimed such a member "contributes NOTHING"; it was
-- measured false and the paragraph is rewritten rather than re-pointed.)
--
-- That contribution is harmless BECAUSE of the layering at the registration site
-- (`dataEnv`, `Module` arm): the overlay sits BELOW this module's own `prog0`, so a
-- sibling decl riding along can never clobber a locally-declared constructor.  What it
-- can still do is out-rank a ctor the unit names from a DIFFERENT module in an EARLIER
-- import clause, decided by source order — the residual this note used to claim was
-- prevented outright.  It is the pre-existing `(..)` hazard (#674's remainder) now also
-- reachable via (b), and it is order-dependent on `main` too.
--
-- 🚨 IT IS **#1284**, and that number is the point of this paragraph.  The note used to
-- end "it is tracked, not fixed here" while NOTHING tracked it — #1283 is the RE-EXPORT
-- spelling, #733 item 1a is marked FIXED and item 1c is wildcards only.  A declared-
-- but-unfiled residual is indistinguishable from an unnoticed one.  Pinned self-
-- drainingly by `test/must_fail_fixtures/1284-a26-overlay-sibling-ctor-beats-named-
-- import/`, whose CONTROL is the discriminator that dates it: the NON-sibling case is
-- rejected on `main` and accepted here, so A-2.6 repairs that one and leaves exactly
-- the sibling one.
--
-- 🚨 The pool lookup is IDENTITY-scoped, not bare-name.  The pool is the WHOLE
-- universe, so two modules declaring the same TYPE name (#1256's two `Cfg`s) made the
-- old bare-name first-match a LOAD-ORDER coin flip inside the very overlay that exists
-- to defeat load order.  The pool is appended in LOAD order and searched FIRST-match
-- while the tables it overlays are `omInsert` LAST-write-wins, so the two orders are
-- OPPOSITE: an unscoped lookup picks right only when the wanted module is loaded
-- FIRST, and `test/eval_typed_modules_fixtures/ctor_scope_load_order/` is the measured
-- counterexample (stubbing `declOwnedBy` to `True` regresses it to `7.0`, an answer
-- pristine `main` gets right).  `declOwnedBy` compares the decl's own identity against
-- `OriginModule <this import's module id>`; `useModId` yields exactly the loader
-- mid that `stampDeclOrigins` stamped with (see `aliasDictNamesOfPath`'s note, which
-- states the same equality for the qual tables).
--
-- ⚠️ PERF (issue #154) — THE REAL BOUND, stated for the WORK and not just the RESULT.
-- The RESULT is bounded by IMPORT COUNT x PER-MODULE PUBLIC DECL COUNT: at most one
-- overlay decl per UseGroup member, and — since `wildOverlayDecls` — the wildcard-named
-- module's whole published row per `UseWild`.  It is still a per-module VIEW (the row is
-- the envelope's own memoized `demPubDecls`, not a copy), never a per-module rebuild of
-- the global universe.  A module importing no constructors AND no wildcard overlays
-- NOTHING and stays byte-identical.  A bare `import mod` (UseName) still contributes no
-- overlay: the bare form binds no ctors at all, so no ctor occurrence in the reader can
-- mean that module's declaration by that import.  A wildcard `import mod.*` DOES
-- contribute, as of `wildOverlayDecls` below — it cannot name its owning type, but it
-- does not need to: every decl the module publishes is in scope by construction, and
-- leaving it to the universe-fallback made import-clause ORDER decide which declaration
-- a ctor occurrence meant, in both the spurious-warning and the lost-warning direction.
--
-- The WORK is NOT import-count bounded, and saying it is has already shipped a
-- regression.  `pool` is the WHOLE accumulated universe and it is SCANNED — so the cost
-- is O(members x |pool|) per module, i.e. O(modules x universe) across a run, the same
-- shape `main` has paid since #674 for its `(..)` members.  What keeps that acceptable
-- is entirely the CONSTANT, and the constant has exactly two load-bearing parts, both
-- enforced downstream and both measured:
--   * ONE traversal per member, not three (see `findOverlayDecl`/`overlayScan`); and
--   * ZERO allocation per visited decl (see `overlayNote` — name tests before the
--     identity mint).
-- Break either and the perf gate's `modules` shape goes superlinear: this comment
-- previously asserted the universe-independence outright, the first cut of A-2.6 broke
-- both parts, and the gate read typecheck TIME r2=3.24 (hard threshold 3.0) with net
-- allocation 306/744/2013 MB against `main`'s 242/491/1010.  A cheaper bound is
-- available if it is ever needed — index `pool` by owning module id, which would make
-- the owned passes O(log n) — but it does not exist today, so do not cite one.
--
-- 🚨 A-3.2b (#1512, absorbing #1319 unit 4): THE POOL IS NO LONGER A MATERIALISED
-- ACCUMULATOR.  It used to be `CrossRun.universeDataDecls` — a bare `List Decl`
-- grown by `appendDataUniverse` one module at a time, with NO record of which module
-- contributed what and no key at all beyond list position.  It is now the whole-graph
-- envelope (`DeclEnvs.deModules`, stage K) read at the READER'S OWN ORDINAL through
-- `declEnvRowVisible`, i.e. through `declEnvVisibleTo`'s two conjuncts.  `cur` is
-- `declEnvsOrdOf mid` for the module being checked — a LOADER-derived identity, not a
-- spelling re-derived from import syntax, which is what makes it survive the emit path
-- (see the call site in `checkBodyImpl`).
--
-- ⚠️ THE POPULATION IS NOT BYTE-IDENTICAL TO THE OLD ACCUMULATOR, and the difference
-- is exactly one row: the READER'S OWN module.  The accumulator held only STRICTLY
-- EARLIER modules' public decls (`appendDataUniverse` runs at the END of a module's
-- own pass); `declEnvVisibleTo` admits the reader's own row too, privately, because
-- `entryOrd == cur` short-circuits the publicity conjunct.  That is the ruled
-- predicate and it is deliberately not special-cased away here.  Its reach is
-- bounded: `ownedType`/`ownedCtor` are scoped by `declOwnedBy mid` where `mid` comes
-- from a `DUse` path, and no module imports itself, so an own-module decl can only
-- ever fill the `bareType` fallback — LAST in a FIRST-wins walk, so it can only add a
-- candidate where every earlier row supplied none, never displace one.
-- 🚨 THE RESULT IS PARTITIONED: NAMED (`UseGroup`) ROWS AND WILDCARD (`UseWild`) ROWS
-- ARE TWO SEPARATE HALVES, and which half a consumer must see FIRST depends on that
-- consumer's own tie-break direction.  This is not a style choice; a single flat
-- source-ordered list shipped an S1.
--
-- WHY.  Before `wildOverlayDecls`, only `UseGroup` contributed, and every row was ONE
-- precisely-named decl.  A wildcard row is the module's WHOLE published set, so once
-- `UseWild` was enrolled the flat `flatMap` over the unit's decls in SOURCE ORDER made
-- import-clause order decide same-named-type collisions BETWEEN the two spellings: with
-- `import zzcol.*` written above `import aacol.{Red, Blue}`, a non-exhaustive match over
-- `aacol.Col` was reported as `Missing case: 'Green'` — a constructor of `zzcol.Col`,
-- the wrong type entirely — and the real missing case went unreported, so the program
-- then died at runtime on the case nobody warned about.  Swapping the two clauses fixed
-- it.  Measured on af6e0414 (broken) vs c7c879b7 (correct in BOTH orders).
--
-- THE RULE, and it is the ordinary scoping one: AN EXPLICITLY NAMED MEMBER OUTRANKS A
-- WILDCARD.  "You named this type" beats "you imported everything and it happened to be
-- in there", whichever clause is written first.
--
-- 🚨 THE TWO CONSUMERS TIE-BREAK IN OPPOSITE DIRECTIONS, so they take opposite orders.
-- Enumerated, because a future edit that routes one of them through the other's wrapper
-- silently inverts the rule for that consumer with no diagnostic anywhere:
--   * `registerAllData` (the `dataEnv` overlay) folds the list LEFT and its bare-keyed
--     tables are `omInsert`, i.e. LAST-WRITE-WINS  -> named rows must come LAST
--     -> `importedCtorTypeDeclsLastWins`.
--   * `seedCheckRun` (the exhaustiveness ctor ORACLE) builds `oracleMap` =
--     `omFromPairs (reverseL …)`, i.e. FIRST-WINS   -> named rows must come FIRST
--     -> `importedCtorTypeDeclsFirstWins`.
-- Same rule, both sites; only the list order differs.  The big note at the `dataEnv`
-- call site enumerates the full set of order-observable structures — this pair is the
-- overlay's own contribution to it.
--
-- ⚠️ WHAT THIS DELIBERATELY DOES **NOT** DECIDE: named-vs-named.  Two `UseGroup` clauses
-- each naming a same-spelled type from a different module are still resolved by
-- import-clause order, exactly as before this partition — within each half the walk is
-- the same `flatMap` over `unitDecls` in source order, and neither consumer's tie-break
-- direction moved.  That case is a SEPARATE, PRE-EXISTING defect (it reproduces on
-- c7c879b7, before the wildcard arm existed) and fixing it needs the overlay keyed by
-- RESOLVED DECLARATION IDENTITY rather than by bare type name — #1319/#1185 territory,
-- not an ordering change.  Do not "while you are here" it: an ordering answer for
-- named-vs-named would freeze a guess into the oracle.
--
-- ⚠️ PERF: the unit's decl list is walked TWICE (once per half) instead of once, but the
-- POOL — the expensive part, see `THE REAL BOUND` above — is scanned exactly as many
-- times as before: each clause yields its rows in whichever half claims it and `[]` in
-- the other, so the total member/wildcard lookups are unchanged.  The extra cost is one
-- linear pass over `unitDecls`, which is import-clause bounded, not universe bounded.
importedCtorTypeDeclsFirstWins : List Decl ->
  Int ->
  List DeclEnvModule ->
  List Decl
importedCtorTypeDeclsFirstWins unitDecls cur rows =
  overlayHalf False unitDecls cur rows ++ overlayHalf True unitDecls cur rows

importedCtorTypeDeclsLastWins : List Decl ->
  Int ->
  List DeclEnvModule ->
  List Decl
importedCtorTypeDeclsLastWins unitDecls cur rows =
  overlayHalf True unitDecls cur rows ++ overlayHalf False unitDecls cur rows

-- One half of the partition, in the unit's own source order.  `wildHalf` selects which:
-- True = `UseWild` rows only, False = `UseGroup` rows only.
overlayHalf : Bool -> List Decl -> Int -> List DeclEnvModule -> List Decl
overlayHalf wildHalf unitDecls cur rows =
  flatMap (importOverlayDecls wildHalf cur rows) unitDecls

importOverlayDecls : Bool -> Int -> List DeclEnvModule -> Decl -> List Decl
importOverlayDecls wildHalf cur rows (DAttrib _ d) =
  importOverlayDecls wildHalf cur rows d
importOverlayDecls wildHalf cur rows (DUse _ (p@(UseGroup _ ms)) _) =
  if wildHalf then [] else flatMap (memberOverlayDecl cur rows (useModId p)) ms
importOverlayDecls wildHalf cur rows (DUse _ (p@(UseWild _)) _) =
  if wildHalf then wildOverlayDecls cur rows (useModId p) else []
importOverlayDecls _ _ _ _ = []

-- The exhaustiveness oracle's import rows beyond `importedCtorTypeDeclsFirstWins`:
-- every decl a module ALIAS import's module publishes, and the declarations of the
-- constructors a wildcard or alias import reaches through that module's own
-- `export import`.  The oracle reads constructors by bare name (resolve strips `A.`
-- before inference), so without these rows a same-spelled constructor of a module
-- loaded earlier answers for them (#1185).  They follow both halves of
-- `importedCtorTypeDeclsFirstWins` because a bare occurrence means an unaliased
-- import's constructor.  Kept out of `importOverlayDecls`, whose other reader is the
-- `dataEnv` overlay.  A selective `import m.{…}` is already one of those rows, and no
-- decl other than a `DUse` imports anything, so `oracleImportDeclsOf` adds nothing for
-- either.
oracleImportDecls : GraphCtx ->
  List Decl ->
  Int ->
  List DeclEnvModule ->
  List Decl
oracleImportDecls gctx unitDecls cur rows =
  flatMap (oracleImportDeclsOf gctx cur rows) unitDecls

oracleImportDeclsOf : GraphCtx -> Int -> List DeclEnvModule -> Decl -> List Decl
oracleImportDeclsOf gctx cur rows (DAttrib _ d) =
  oracleImportDeclsOf gctx cur rows d
oracleImportDeclsOf gctx cur rows (DUse _ (p@(UseAlias _ _)) _) =
  let dep = useModId p
  wildOverlayDecls cur rows dep ++ reexportedCtorDecls gctx cur rows dep
oracleImportDeclsOf gctx cur rows (DUse _ (p@(UseWild _)) _) =
  reexportedCtorDecls gctx cur rows (useModId p)
oracleImportDeclsOf gctx _ _ _ = []

-- The decls declaring the constructors `dep` re-exports from other modules, found
-- through the graph's constructor export index, whose rows carry each constructor's
-- declaring identity across any chain of `export import`.  One decl per (declaring
-- module, type), however many of its constructors are re-exported.
reexportedCtorDecls : GraphCtx ->
  Int ->
  List DeclEnvModule ->
  String ->
  List Decl
reexportedCtorDecls gctx cur rows dep =
  match omLookup dep (ctorExportsIndex gctx ())
    None => []
    Some es =>
      flatMap
        (k => reexportedTypeDecl cur rows (fst k) (snd k))
        (dedupBy (k => "\{fst k}.\{snd k}") (flatMap (reexportedOwner dep) es))

-- (declaring module, owning type) of an export row declared outside `dep`.
reexportedOwner : String -> (String, String, Ident) -> List (String, String)
reexportedOwner dep (_, owner, Ident _ io _) =
  identOriginFold [] (m => if m == dep then [] else [(m, owner)]) io

reexportedTypeDecl : Int -> List DeclEnvModule -> String -> String -> List Decl
reexportedTypeDecl _ [] _ _ = []
reexportedTypeDecl cur (m :: rest) declarer tyName =
  if m.demId == declarer then
    filterList (declIsOwnedType declarer tyName) (declEnvRowVisible cur m)
  else
    reexportedTypeDecl cur rest declarer tyName

-- Only a `data` or `newtype` declaration declares constructors, so no other decl owns
-- a type whose constructors a re-export reaches.
declIsOwnedType : String -> String -> Decl -> Bool
declIsOwnedType mid tyName (DAttrib _ d) = declIsOwnedType mid tyName d
declIsOwnedType mid tyName (DData { dataName = tn, dataOrigin = o }) =
  tn == tyName && declOwnedBy mid tn o
declIsOwnedType mid tyName (DNewtype { newtypeName = tn, newtypeOrigin = o }) =
  tn == tyName && declOwnedBy mid tn o
declIsOwnedType _ _ _ = False

-- A wildcard import's overlay: EVERY decl the named module publishes, as the reader at
-- ordinal `cur` may see it.  A wildcard names no member, so there is nothing to look up
-- by name — the whole published row IS the answer, and one row is all a module id can
-- have (`deOrdIndex` keys rows by `demId`), hence the stop at the first match.
--
-- 🚨 `declEnvRowVisible`, NEVER `m.demDecls`.  The visible projection is what confines
-- this to `publicDataDecl`s — public `DData`/`DInterface`/`DImpl`/`DTypeAlias` — and
-- `DNewtype`'s ABSENCE from that predicate is deliberate (see `publicDataDecl`): reading
-- `demDecls` here would leak a wildcard-imported module's PRIVATE and NEWTYPE
-- constructors across the module boundary, draining #1311/#1305 in the loud→silent
-- direction, i.e. a severity INCREASE.  A wildcard-imported `newtype`'s ctors are
-- consequently NOT overlaid; that is the ruled behaviour, not an oversight.
--
-- The private branch of `declEnvRowVisible` (`entryOrd == cur`, the reader's own row) is
-- UNREACHABLE from here for the reason the pool note above already gives: `mid` comes
-- from a `DUse` path, and no module imports itself.
--
-- ⚠️ PERF: this returns the row's OWN memoized `demPubDecls` list — no filtered copy is
-- materialised, per `declEnvRowVisible`'s zero-allocation contract.  It does move the
-- RESULT bound: see the `THE REAL BOUND` note above.
wildOverlayDecls : Int -> List DeclEnvModule -> String -> List Decl
wildOverlayDecls _ [] _ = []
wildOverlayDecls cur (m :: rest) mid =
  if m.demId == mid then
    declEnvRowVisible cur m
  else
    wildOverlayDecls cur rest mid

-- One member's overlay decl.  The bare-name fallback is kept for the `(..)` spelling
-- ALONE, so no overlay that fired before #1111 A-2.6 is lost where the identity cannot
-- match — a RE-EXPORTED type's decl names the ORIGINAL module, not the re-exporter
-- this import path names.  The (b) spellings are new, so they get no fallback: an
-- unscoped guess there would be the load-order coin flip this unit is removing.
-- (The fallback is not a second pass over `pool` — `overlayScan` collects it in the
-- same walk as the two identity-scoped candidates; see `findOverlayDecl`.)
memberOverlayDecl : Int ->
  List DeclEnvModule ->
  String ->
  UseMember ->
  List Decl
memberOverlayDecl cur rows mid (UseMember n ctors _ _) =
  match findOverlayDecl mid n ctors cur rows
    Some d => [d]
    None => []

-- The pool decl DECLARED BY `mid` that this member names.
--
-- 🚨 TWO PASSES, not one first-match, and the order between them is the point.  A
-- module may declare BOTH a type `T` and, in an earlier decl, a constructor spelled
-- `T` (`data Wrap = T Int` above `data T = A | B`).  For `import m.{T(..)}` the member
-- means the TYPE — `(..)` is what makes it a type spelling — so the type-name match
-- must be tried over the WHOLE pool before any constructor-name match is considered.
--
-- ⚠️ A single first-match pass that accepted `variantNamed n vs || ctors && tn == n`
-- shipped and was wrong: `import m.{T(..)}` selected `Wrap` (whose ctor is `T`), so
-- `T`'s own `A`/`B` were never overlaid and a universe collision on `A` won instead —
-- `Type mismatch: T vs Other`.  `declOwnedBy` had removed the CROSS-module first-match
-- hazard; this WITHIN-module one is what `variantNamed` newly made reachable.  Pinned
-- by `test/llvm_fixtures_modules/ctor_scope_ctors_prefer_type_name/`.
--
-- The constructor pass is still the fallback for `(..)`, not dead: `import m.{C(..)}`
-- where `C` is a constructor and not a type name of `m` keeps its pre-A-2.6 meaning.
--
-- 🚨 THE THREE PASSES SHARE ONE TRAVERSAL, and that is a MEASURED PERF CONTRACT.
-- `pool` is the WHOLE accumulated universe and this runs once per UseGroup member of
-- every module, so each independent pass over it is an O(modules x universe) term.
-- The first cut of A-2.6 ran three (type-owned, then ctor-owned, then the bare
-- fallback) where `main` ran ONE, and that alone put the perf gate's `modules` shape
-- at typecheck TIME r2=3.24 — over the hard 3.0 threshold.  `overlayScan` collects all
-- three candidates in a SINGLE walk (their predicates are independent, so first-wins
-- per candidate is unchanged) and stops the instant the DECIDING candidate is found,
-- which is the early exit the three-pass form had.  See `overlayScan`.
findOverlayDecl : String ->
  String ->
  Bool ->
  Int ->
  List DeclEnvModule ->
  Option Decl
findOverlayDecl mid n ctors cur rows =
  match overlayScanRows mid n ctors cur (None, None, None) rows
    (ownedType, ownedCtor, bareType) =>
      if ctors then
        orElseOpt (orElseOpt ownedType ownedCtor) bareType
      else
        ownedCtor

-- ONE walk of the pool, THREE first-wins candidates, in the precedence order
-- `findOverlayDecl` applies:
--
--   ownedType — first decl DECLARED BY `mid` whose TYPE name is `n`   (the `(..)` rule)
--   ownedCtor — first decl DECLARED BY `mid` with a CONSTRUCTOR named `n`  (rule (b))
--   bareType  — first decl of ANY owner whose TYPE name is `n`  (the `(..)` fallback,
--               `dataDeclForType`'s old job: a RE-EXPORTED type's decl names the
--               ORIGINAL module, so no identity-scoped pass can ever match it)
--
-- Each is recorded independently and FIRST-wins, which is exactly what three separate
-- first-match passes computed; a decl can legitimately fill two of them at once (a
-- record's sole variant carries the type's own name), so they are collected with
-- INDEPENDENT tests and never with an `else`.
--
-- ⚠️ THE EARLY EXIT IS `ctors`-DEPENDENT AND MUST STAY THAT WAY.  With `(..)` the
-- deciding candidate is `ownedType` (it outranks both others), so finding it ends the
-- walk; WITHOUT `(..)` only `ownedCtor` is ever read, so exiting on `ownedType` would
-- abandon the walk before the answer was found.  Exiting on "all three filled" is
-- likewise wrong for the second case.
-- A-3.2b (#1512): the OUTER half of the same one-traversal walk, over the envelope's
-- per-module rows in ORDINAL order — which is the identical decl order the old
-- accumulator was appended in (`appendDataUniverse` ran once per module, dependency
-- first), so every FIRST-wins candidate below sees the same sequence it saw before.
--
-- 🚨 THE EARLY EXIT MUST BE CHECKED AT BOTH LEVELS.  `overlayScan` stops mid-row on
-- the deciding candidate; without the identical test here the walk would continue into
-- every LATER row having already decided, which is the O(modules x universe) term this
-- whole neighbourhood is written to avoid.  `declEnvRowVisible` allocates nothing, so
-- a skipped row costs one comparison.
overlayScanRows : String ->
  String ->
  Bool ->
  Int ->
  (Option Decl, Option Decl, Option Decl) ->
  List DeclEnvModule ->
  (Option Decl, Option Decl, Option Decl)
overlayScanRows _ _ _ _ acc [] = acc
overlayScanRows mid n ctors cur acc (m :: rest) =
  let acc2 = overlayScan mid n ctors acc (declEnvRowVisible cur m)
  if overlayDecided ctors acc2 then
    acc2
  else
    overlayScanRows mid n ctors cur acc2 rest

overlayScan : String ->
  String ->
  Bool ->
  (Option Decl, Option Decl, Option Decl) ->
  List Decl ->
  (Option Decl, Option Decl, Option Decl)
overlayScan _ _ _ acc [] = acc
overlayScan mid n ctors acc (d :: rest) =
  let acc2 = overlayScanOne mid n acc d
  if overlayDecided ctors acc2 then acc2 else overlayScan mid n ctors acc2 rest

overlayDecided : Bool -> (Option Decl, Option Decl, Option Decl) -> Bool
overlayDecided ctors (ownedType, ownedCtor, _) =
  if ctors then isSome ownedType else isSome ownedCtor

overlayScanOne : String ->
  String ->
  (Option Decl, Option Decl, Option Decl) ->
  Decl ->
  (Option Decl, Option Decl, Option Decl)
overlayScanOne mid n acc (DAttrib _ d) = overlayScanOne mid n acc d
overlayScanOne mid n acc (d@(DData { dataName = tn, dataOrigin = o })) =
  overlayNote mid n tn o d acc
overlayScanOne mid n acc (d@(DNewtype { newtypeName = tn, newtypeOrigin = o })) =
  overlayNote mid n tn o d acc
overlayScanOne _ _ acc _ = acc

-- 🚨 NAME TESTS FIRST, IDENTITY SECOND — a MEASURED perf contract, not style.
-- `tn == n` / `declCtorNamed` are string compares over fields already in hand and
-- ALLOCATE NOTHING; `declOwnedBy` MINTS an identity on both sides (`OriginModule`,
-- `IdentModule`, the `map` closure, the `Ident`, the `Some` — five objects per call).
-- This runs ONCE PER POOL DECL, i.e. over the whole universe per member per module, so
-- minting unconditionally is O(modules x universe) ALLOCATION — `compiler/AGENTS.md`'s
-- named exception ("when the KEY PROJECTION allocates"), and it re-created the #154
-- quadratic that `modules` was promoted out of `KNOWN_SUPERLINEAR` for.  Measured on
-- the gate's own `modules` shape (N=100/200/400, K=8, one worktree, one emitter,
-- interleaved): mint-first 306/744/2013 MB net (r2=2.71) vs name-first 242/491/1010 MB
-- (r2=2.06), which is `main`'s figure to 0.1 MB.  A name test matches at most the
-- handful of pool decls sharing that spelling, so the mint is O(1) per member.
--
-- The unchanged `acc` is returned BY IDENTITY when neither name matches — the common
-- case — so the walk allocates nothing at all until it actually finds something.
overlayNote : String ->
  String ->
  String ->
  TyConOrigin ->
  Decl ->
  (Option Decl, Option Decl, Option Decl) ->
  (Option Decl, Option Decl, Option Decl)
overlayNote mid n tn o d acc = match acc
  (ownedType, ownedCtor, bareType) =>
    let hitType = tn == n
    let hitCtor = declCtorNamed n d
    if hitType || hitCtor then
      let owned = declOwnedBy mid tn o
      (
        if hitType && owned then orElseOpt ownedType (Some d) else ownedType,
        if hitCtor && owned then orElseOpt ownedCtor (Some d) else ownedCtor,
        if hitType then orElseOpt bareType (Some d) else bareType,
      )
    else
      acc

-- Does this decl's DECLARATION identity name module `mid`?  Both sides go through
-- `mkIdent`, so an ABSENT identity matches NOTHING — not even another absence.  That
-- polarity is deliberate and is A-2.3's, not A-2.10's: this answers a LOOKUP, where a
-- miss is recoverable (the universe fallback stands, i.e. today's behaviour) and a
-- false hit would silently overlay the wrong module's constructors.  It is why `mid`
-- being `""` (the I6.3 "origin not recorded" sentinel, which `identOriginOf` refuses)
-- cannot pair with an `OriginUnresolved` decl.
declOwnedBy : String -> String -> TyConOrigin -> Bool
declOwnedBy mid tyName o = match mkIdent NsType (OriginModule mid) tyName
  Some want => mkIdent NsType o tyName == Some want
  None => False

-- ── the local-spelling → DEFINER map, for EVERY import form ─────────────────────
-- This is the ONE representation the dict-arity identity seam resolves through:
-- `qualConstraintKey` turns a name into a `(definer, origin)` key with it, and
-- `hasImportDefiner` reads the same rows to decide that a qual MISS means "genuinely
-- unconstrained in its source module" rather than "look in the source-blind bare
-- table".  Every reader of that decision — `declaredConstraintFor`,
-- `declaredConstraintIds`, the pinned-var guard — takes its answer from here, and
-- none of them knows which import FORM produced a row.  So the forms are normalized
-- here, once, and a form whose rows are missing is not a gap in one arm: it is a
-- silent fall-through to bare-name first-match for that whole spelling.
--
-- 🚨 `import m.*` USED TO CONTRIBUTE NOTHING, and that hole is #1425's F1.
-- `importedBindings` answers `None` for `UseWild` because a wildcard's member list
-- cannot be read off the `DUse` decl alone — it is every public top-level binding the
-- DEPENDENCY declares — so this walk simply skipped it and every wildcard-imported
-- name fell to the bare table.  While the bare table happened to be wrong on BOTH
-- sides of a same-name collision (a foreign constrained row sized the define AND the
-- call), the two errors cancelled and the spelling looked correct.  `selfDeclArities`
-- then repaired the DEFINE side by identity; the call side, still on the bare table,
-- began applying a dict its callee no longer abstracts —
-- `E-NOT-A-FUNCTION: applied non-function: <dict:>` on nine ordinary 3-line stdlib
-- programs, in BOTH import orders, behind a `check` that exits 0.  The defect did not
-- move because the repair was wrong; it moved because the repair was applied at one
-- arm of a seam whose other arm had no rows at all.
--
-- The graph is what supplies the missing member list, and it is already built and
-- already keyed by module id: `declEnvsRef.deModules`.  On the Flat/loader-less paths
-- that envelope is EMPTY, so the wildcard rows are empty and this is byte-identically
-- today's behaviour — the same fail-closed-on-absent-identity discipline
-- `selfDeclArities` takes for `mid == ""`.
--
-- ORDER AND SHADOWING.  Named-form rows come FIRST (every reader is first-match), and a
-- wildcard row is dropped when the name is already spoken for — by a named import of
-- this module, or by this module's OWN top-level declaration, which shadows the
-- wildcard binding and whose arity `selfDeclArities` answers from its own qual row.
--
-- 🚨 THE SUPPLY SIDE DOES NOT ENUMERATE (RUN-XMOD-062).  It used to, twice over — one
-- walk for the named forms, one for the wildcard form, each deciding for itself what a
-- dependency "makes available".  Both walks answered that with the names a dependency
-- DECLARES, so a name it RE-EXPORTS (`export import u.{pick}` / `export import u.*`,
-- at any depth) got no row and fell to the source-blind bare table — the same
-- `E-NOT-A-FUNCTION: applied non-function: <dict:>` on a well-typed program, one hop
-- further out.  That was the THIRD enumeration in this seam to miss a member.  The rows
-- are now DERIVED: `graphPubDefiners` answers "what does module m export, and who
-- DEFINED each of those names" (declared publics, plus re-exports resolved through the
-- same predicate, transitively), and `importFormRows` — the one admission predicate,
-- shared with `importFormSchemes` — answers "which of those does this import form
-- admit, under which local key".  A form or a re-export shape this seam has never seen
-- is covered by construction, not by a case.
--
-- Also, the payload is now a PAIR: `(definer module, origin name at the definer)`,
-- because an IMPORTER can rename a re-exported member (`import r1.{pick as pk}` — an
-- ordinary import with an as-alias on a name that happens to be re-exported).  A
-- RE-EXPORT hop itself cannot rename: `export import u.{pick as pk}` is a hard parse
-- error (`parser.mdk:2379`), so that is not the motivating shape.  The qual tables are
-- keyed `(definer, ORIGINAL exported name)`, so carrying only the definer would key them
-- with the local spelling, MISS, and — via `hasImportDefiner` — read that miss as
-- "genuinely unconstrained", silently dropping the callee's dict.  Both halves of the
-- key come out of one derivation; they cannot disagree.
importDefinersOf : GraphCtx -> List Decl -> List (String, (String, String))
importDefinersOf gctx prog =
  let named = useAdmittedRows gctx False prog
  let taken = namesToSet (map fst named ++ declTopFnNames prog) omEmpty
  named
    ++ filterList
      (e => not (omHasKey (fst e) taken))
      (useAdmittedRows gctx True prog)

-- one precedence TIER of the walk above — [wild] selects the wildcard-form rows or the
-- named-form rows.  This is a precedence split, not a re-enumeration of the forms:
-- WHICH names a form admits is `importFormRows`' answer in both tiers.
useAdmittedRows : GraphCtx ->
  Bool ->
  List Decl ->
  List (String, (String, String))
useAdmittedRows gctx _ [] = []
useAdmittedRows gctx wild ((DAttrib _ d) :: rest) =
  useAdmittedRows gctx wild [d] ++ useAdmittedRows gctx wild rest
useAdmittedRows gctx wild ((DUse _ path _) :: rest) =
  useDefinerRows gctx wild path ++ useAdmittedRows gctx wild rest
useAdmittedRows gctx wild (_ :: rest) = useAdmittedRows gctx wild rest

-- `core` is skipped: the implicit prelude is never an explicit provenance (every reader
-- of these rows relies on that — see `declaredConstraintFor`).
useDefinerRows : GraphCtx -> Bool -> UsePath -> List (String, (String, String))
useDefinerRows gctx wild path =
  let depId = useModId path
  if depId == "core" then
    []
  else match importedBindings path
    None => if wild then graphPubDefiners gctx depId else []
    Some bindings =>
      if wild then
        []
      else
        flatMap (memberDefinerRow depId (graphPubDefiners gctx depId)) bindings

-- resolve ONE named member against the dependency's export table.  The fallback is the
-- load-bearing part: on the Flat / loader-less drivers `deModules` is EMPTY, so the
-- table is silent about every dependency, and a named import must keep contributing its
-- row (attributed to the SPELLED module, which is what it contributed before this
-- derivation existed) rather than vanish.  The wildcard form has no such fallback — it
-- cannot enumerate without the graph — which is the same fail-closed-on-absent-identity
-- discipline `selfDeclArities` takes for `mid == ""`.
memberDefinerRow : String ->
  List (String, (String, String)) ->
  (String, String) ->
  List (String, (String, String))
memberDefinerRow depId pubs (origin, local) =
  match resolveMemberRows (origin, local) pubs
    [] => [(local, (depId, origin))]
    rows => rows

-- #739 fix follow-up: local-import-name → ORIGINAL exported name.  `importedBindings`
-- yields (origin, local) pairs, so an aliased member `{x as y}` gives (y ↦ x) and a plain
-- `{f}` gives (f ↦ f).  qualConstraintFor keys the (source, name) qual tables by the ORIGIN,
-- not the surface alias — the tables are attributed under the DEFINING name — so a constrained
-- aliased import (`hash_map.{set as hmSet}`) resolves its `Hash`/`Eq` dict instead of being
-- misclassified as unconstrained and short-circuited (which DROPPED the dict → dispatch panic).
--
-- RUN-XMOD-062: this is now a PROJECTION of `importDefinersOf`'s rows rather than its own
-- `DUse` walk.  Two walks over the import forms could disagree about which rows exist —
-- and a `(definer, origin)` key assembled from two disagreeing walks is exactly the
-- silent misroute this seam pays for.  `definerRowsOf` is its sibling projection; both
-- take the SAME rows, computed once at the single write site.
originRowsOf : List (String, (String, String)) -> List (String, String)
originRowsOf rows = map (e => (fst e, snd (snd e))) rows

definerRowsOf : List (String, (String, String)) -> List (String, String)
definerRowsOf rows = map (e => (fst e, fst (snd e))) rows

-- the (key, scheme) pairs a module RE-EXPORTS via `export import` (`DUse True`).
-- Mirrors resolve's re-export set (resolve.pubUsePaths filters the same `DUse True`)
-- into the typecheck seed: walk the export-flagged DUse decls and, for each, pick the
-- re-exported member names out of the SOURCE dependency's public schemes already in
-- depEnv — the exact member resolution importSeed uses (importFormSchemes /
-- resolveMemberRows), so it works on both golden and mangled emit paths.  Schemes
-- come from depEnv by IDENTITY (the definer's original schemes, never re-generalized),
-- which preserves the original-definer constraint ids (D2 diamond-safety).  ONLY
-- `DUse True` is threaded, so a plain `import` never leaks the importer's names
-- downstream.  Transitivity is automatic: pubV accumulates these and is carried
-- forward as depEnv, so a second `export import` hop re-resolves against the enriched
-- pubV.  Methods need no special case — the source module's pubV already holds the
-- method scheme (publicValNames includes DInterface method names).
--
-- `core` is the one source that is NOT in depEnv: it is the implicit prelude, so its
-- schemes go into `baseSeed`, not into the per-module dep chain.  It is therefore
-- passed separately as `coreV` — without it, `lookupAssoc "core" depEnv` missed and
-- `export import core.{filter}` re-exported nothing (in silence, and forever).
-- `coreV` is consulted ONLY here, on `DUse True`: `importSeed` keeps taking the plain
-- depEnv, so a plain `import core.{…}` still seeds nothing (its names are already in
-- baseSeed — seeding them twice would only add duplicate assoc entries).
reexportSeed : List (String, a) ->
  List Decl ->
  List (String, List (String, a)) ->
  List (String, a)
reexportSeed _ [] _ = []
reexportSeed coreV ((DAttrib _ d) :: rest) depEnv =
  reexportSeed coreV [d] depEnv ++ reexportSeed coreV rest depEnv
reexportSeed coreV ((DUse True path _) :: rest) depEnv =
  let depId = useModId path
  let src = if depId == "core" then Some coreV else lookupAssoc depId depEnv
  match src
    None => reexportSeed coreV rest depEnv
    Some depSchemes =>
      importFormSchemes depEnv path depSchemes ++ reexportSeed coreV rest depEnv
reexportSeed coreV (_ :: rest) depEnv = reexportSeed coreV rest depEnv

foldModules : Accumulate ->
  (ModuleCtx -> String -> ModuleSeed -> List Decl -> List Decl -> List Decl -> (ModuleBindings, e, ModuleCtx)) ->
  Option (ModuleServe e) ->
  (Bool -> String -> e -> acc -> acc) ->
  acc ->
  List (String, Scheme) ->
  List (String, ExportBinding) ->
  List (String, List (String, ExportBinding)) ->
  List Decl ->
  List Decl ->
  ModuleCtx ->
  List (String, List Decl) ->
  (acc, Option (ModuleServe e), ModuleCtx)
foldModules acc worker serve collect base baseSeed coreV depEnv accData accAll prev modules =
  let (done, served, last) =
    workModules
      acc
      worker
      serve
      baseSeed
      coreV
      depEnv
      accData
      accAll
      []
      prev
      modules
  (collectModules collect base done, served, last)

-- `foldModules`' loop: runs the worker over [modules] head-first, threading the
-- accumulators, the record and the serve policy, and returns each module's payload,
-- newest first.  The recursive call is a tail call: a frame waiting on the rest would
-- keep its module's record reachable until the graph end.
workModules : Accumulate ->
  (ModuleCtx -> String -> ModuleSeed -> List Decl -> List Decl -> List Decl -> (ModuleBindings, e, ModuleCtx)) ->
  Option (ModuleServe e) ->
  List (String, Scheme) ->
  List (String, ExportBinding) ->
  List (String, List (String, ExportBinding)) ->
  List Decl ->
  List Decl ->
  List (String, e) ->
  ModuleCtx ->
  List (String, List Decl) ->
  (List (String, e), Option (ModuleServe e), ModuleCtx)
workModules _ _ serve _ _ _ _ _ done prev [] = (done, serve, prev)
workModules _ worker serve baseSeed coreV depEnv accData accAll done prev [(mid, prog)] =
  let seed = moduleSeedFor prev baseSeed coreV mid prog depEnv
  let (_, extra, next) = worker prev mid seed accData accAll prog
  ((mid, extra) :: done, serve, next)
workModules acc worker serve baseSeed coreV depEnv accData accAll done prev ((mid, prog) :: rest) =
  let step = map (policy => policy.msStep mid prog prev) serve
  let (own, done2, serve2, next) = match step
    Some (ServeHit own extra policy) =>
      (own, (mid, extra) :: done, Some policy, prev)
    _ =>
      let seed = moduleSeedFor prev baseSeed coreV mid prog depEnv
      let (schemes, extra, next) = worker prev mid seed accData accAll prog
      let own = publicModuleExports prog schemes
      match step
        Some (ServeCheck after) =>
          let (done3, policy) = after next own ((mid, extra) :: done)
          (own, done3, Some policy, next)
        _ => (own, (mid, extra) :: done, serve, next)
  workModules
    acc
    worker
    serve2
    baseSeed
    coreV
    ((mid, own ++ reexportSeed coreV prog depEnv) :: depEnv)
    (match acc
      AccumulateBoth => accData ++ publicDataDecls prog
      AccumulateNone => accData)
    (match acc
      AccumulateBoth => accAll ++ prog
      AccumulateNone => accAll)
    done2
    next
    rest

-- The import-scoped seed [mid] is checked from: [baseSeed] and what [prog]'s imports
-- select from [depEnv].
moduleSeedFor : ModuleCtx ->
  List (String, Scheme) ->
  List (String, ExportBinding) ->
  String ->
  List Decl ->
  List (String, List (String, ExportBinding)) ->
  ModuleSeed
moduleSeedFor prev baseSeed coreV mid prog depEnv =
  moduleImportSeed
    prev
    baseSeed
    (importSeed prev.mcGraph coreV (admittedIn prev.mcGraph mid) prog depEnv)

-- The right fold of `collect` over the payloads [done] (newest first): the last module
-- first, the only one `collect` sees as last, onto [base].
collectModules : (Bool -> String -> e -> acc -> acc) ->
  acc ->
  List (String, e) ->
  acc
collectModules _ base [] = base
collectModules collect base ((mid, extra) :: older) =
  fold (acc (m, x) => collect False m x acc) (collect True mid extra base) older

-- The core pass, through the prelude interface (`types/prelude_interface.mdk`).
-- Under the caller's prelude key a hit is the cached interface whose section lists
-- this drive's IO join.  A miss checks core, drains it, freezes the result, caches
-- it when keyed, and continues from that frozen value as a hit does, so the record
-- past core is one shape however the drive came by it: core's evidence, binder rows,
-- scope frames and goals stay in the run core was checked in, and its schemes reach
-- inference as fresh cells.
-- The interface's extern catalog is the one [runtimeDecls] alone build, not the
-- process's union, which holds whatever runtimes earlier drives declared.
-- Returns the bindings inference reads, the prelude's published rows and the module
-- record to continue from, whose `mcGraph` is the graph record.
checkCoreMemoized : ModuleCtx ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, Scheme) ->
  (ModuleBindings, List (String, PubScheme), ModuleCtx)
checkCoreMemoized prev key runtimeDecls coreDecls runtimeSeed =
  let gctx = prev.mcGraph
  let join = gctx.config.value.tcIoJoin
  let cached = match key
    Some k => preludeCacheHit k join
    None => None
  match cached
    Some pi => continueFromInterface gctx gctx.graphRun pi
    None =>
      -- #2705: core is marked inside the pass, with the unsplit set
      -- (`moduleMarkCtx`'s core arm), in the run the continuation below leaves.
      let (coreSchemes, _, coreCtx) =
        checkModuleFull prev runtimeSeed [] coreDecls
      -- #2705: drain core's stamping context before the freeze, so core is solved
      -- once per process rather than once per analyze.  This treats core as closed
      -- at its own end.  The prelude has no diagnostics list for a hole to land in.
      let _ = match checkGraphFinish coreCtx
        [] => ()
        f :: _ => panic "evidence hole in the prelude: \{tcMsg f.dfDiag}"
      -- #673/#837: the published rows carry core's own obligations, keyed by bare
      -- name; the thaw derives `coreSchemeObligationsRef` from them.
      let pi =
        freezeInterface
          gctx.crossRun
          gctx.graphRun
          (externSigsToMap runtimeDecls omEmpty)
          (publishCore (coreOwnContexts coreCtx) coreSchemes.mbSchemes)
          (omMapValues (_ => ()) coreSchemes.mbStandaloneSchemes)
          coreCtx.mcCells.invocationViewRef.value
      let _ = match key
        Some k => seedPreludeInterface k [([join], pi)]
        None => ()
      continueFromInterface gctx (graphLineageRun (internersOf gctx).lineage) pi

-- The record a drive continues from past the core pass: [gctx] with [pi] thawed
-- into it.  [run] is a graph run core was not checked in; it takes the interface's
-- id counters and existential cells and nothing else of core's.  Core's module
-- record is not carried: the diagnostics worker seeds each module from its own
-- decls (`seedCheckRun`), and `cmCheckWorker` seeds its first module from this
-- blank record, an empty oracle (the one core was checked from) and no warning.
-- The interface's externs join the drive's catalog, whose own rows lose to them on
-- a collision, so a hit leaves the catalog a miss would and never shrinks it.
continueFromInterface : GraphCtx ->
  GraphRun ->
  PreludeInterface ->
  (ModuleBindings, List (String, PubScheme), ModuleCtx)
continueFromInterface gctx run pi =
  let (bindings, corePub, cross, seed) = thawInterface gctx pi
  run.tyvarCounter := seed.grsTyvarNext
  run.effvarCounter := seed.grsEffvarNext
  run.ctorExistentialsRef := seed.grsCtorExistentials
  run.anyExistentialsRef := seed.grsAnyExistentials
  let restored = GraphCtx { gctx |
    crossRun = cross,
    graphRun = run,
    builtinExternNamesRef =
      Ref (IdMap.union pi.piExternNames gctx.builtinExternNamesRef.value),
  }
  let mctx = initialModuleCtx restored
  mctx.mcCells.invocationViewRef := readInvocationView pi.piInvocationView
  (bindings, corePub, mctx)

preludePreambleMemoRef : Ref (Option (((Int, Int), String), PreludePreamble))
preludePreambleMemoRef = Ref None

preludePreambleOf : GraphCtx -> List Decl -> DeclEnvModule -> PreludePreamble
preludePreambleOf gctx coreDecls coreRow = PreludePreamble {
  ppEnvAcc = declEnvAccOf gctx [coreRow] emptyDeclEnvAcc,
  ppMangledFunDefs = unitCarriesMangledFunDefs "core" (funDefs coreDecls),
  ppMarkFacts = preludeMarkFactsOf coreDecls,
}

preludePreambleFor : GraphCtx ->
  Option (Int, Int) ->
  List Decl ->
  DeclEnvModule ->
  PreludePreamble
preludePreambleFor gctx None coreDecls coreRow =
  preludePreambleOf gctx coreDecls coreRow
preludePreambleFor gctx (Some k) coreDecls coreRow =
  match !preludePreambleMemoRef
    Some entry =>
      if fst entry == (k, gctx.config.value.tcIoJoinProfile) then
        snd entry
      else
        preludePreambleStore gctx k coreDecls coreRow
    None => preludePreambleStore gctx k coreDecls coreRow

-- One entry only (the prelude does not change under a process); a different
-- prelude simply misses and replaces it.
preludePreambleStore : GraphCtx ->
  (Int, Int) ->
  List Decl ->
  DeclEnvModule ->
  PreludePreamble
preludePreambleStore gctx k coreDecls coreRow =
  let p = preludePreambleOf gctx coreDecls coreRow
  preludePreambleMemoRef := Some ((k, gctx.config.value.tcIoJoinProfile), p)
  p

-- The drive's configuration: the IO join of the selected profile's grants (after the
-- effect domains it reads), the profile's name, and the stdlib ownership.
export
tcConfigOf : List (String, Param) -> DriveInputs -> TcConfig
tcConfigOf domains inputs = TcConfig {
  tcIoJoin = ioJoinAtoms domains inputs.diIoJoinGrants,
  tcIoJoinProfile = inputs.diProfileName,
  tcStdlibOwned = inputs.diStdlibOwned,
  tcFlatEntryIsStdlib = inputs.diFlatEntryIsStdlib,
  tcKey =
    "\{inputs.diProfileName}\n\{inputs.diFlatEntryIsStdlib}\n\{joinWith "," (omKeys inputs.diStdlibOwned)}",
}

-- [admitted]: the per-module method admissions `renameAliasedMethods` computed for
-- the drive's graph, or `omEmpty` on a drive that does not rename.  The last
-- component is the record the core pass leaves current, which the drive's first
-- module starts from.
graphPreamble : DriveInputs ->
  OrdMap (List (String, String)) ->
  GraphOut ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List (String, Scheme), ModuleBindings, Option (List (String, PubScheme)), OrdMap (List VecObl), List Decl, MarkSets, ModuleCtx)
graphPreamble inputs admitted sel preludeKey runtimeDecls coreDecls modules =
  -- S-emit-interleave-leak (#2049), TREES only: THE EMIT DRIVER OWNS ITS OWN
  -- (empty) ctor oracle.  A module checked without a `CheckRunSeed` carries the
  -- previous module record's `matchOracle`, and the tree arm's core pass is one
  -- (the seed is `seedCheckRun`'s, reached from `checkModuleFullDiags`
  -- only).  So every `oGetCtors`
  -- reader the tree arm reaches — `ctorSiblingWithholdingName`, `matchCol0Type` —
  -- would read whatever the LAST CHECK RUN IN THIS PROCESS left behind.
  --
  -- That residue used to be unreachable by accident rather than absent: `typeCtors`
  -- is keyed by DECLARATION IDENTITY (`tabKeyOf NsType <dataOrigin> <tyname>`), the
  -- flat entries build it from UNSTAMPED decls (`TkBare` rows), and this arm's
  -- readers mint `TkIdent` for a module-stamped head — so every lookup MISSED and
  -- every reader fell through its fail-open `None` arm.  A `Module`-arm re-check
  -- interleaved between two elaborations (the emit path's async-wrap re-check)
  -- writes rows under the entry module's OWN identity, i.e. under exactly the key
  -- these readers mint — so the lookups start HITTING, against rows built from the
  -- UN-MANGLED tree while the drive walks the MANGLED one.  MEASURED:
  -- `ctorSiblingWithholdingName` then reads the un-mangled ctor `A` as a sibling of
  -- the mangled survivor and false-rejects `a.k` with `Field 'k' is not declared by
  -- every constructor of 'A'`; `Display` cannot ground, the `println` route stays
  -- RNone, and the emitter writes a NULL dict word (`i64 0`) — SILENTLY on
  -- `runEmitWith`'s own path (`compiler/entries/entry_support.mdk`), which never
  -- reads `hadTypeErrors` after the call.  Clean exit 0, SIGSEGV at runtime.
  --
  -- The module record starts from `initialModuleCtx` of the minted graph record,
  -- whose oracle is empty, so no reader can see a previous run's residue, no matter
  -- which arm (or none) ran before.  It is what the core pass below runs against; each
  -- user module then overwrites it from its own decls (`checkModuleFullDiags` →
  -- `seedCheckRun`).
  --
  -- A process holding the prelude's elaborated trees (`types/prelude_elab.mdk`)
  -- starts every lineage past the evidence ordinals those trees carry, so no drive
  -- of it mints one again, whichever arm it takes.  Local binder names need no such
  -- raise: they carry their module's id.
  let _ = match heldPreludeEvCounter ()
    Some k =>
      let lineage = interners.value.lineage
      lineage.lnEvCounter := max lineage.lnEvCounter.value k
    None => ()
  let gctx = mintGraphCtx inputs admitted
  let initial = initialModuleCtx gctx
  -- #80/#201: populate effect domains ONCE over the WHOLE import graph (builtins +
  -- every `effect …` decl in core or any module), BEFORE the per-module foldModules
  -- loop, so a module using an effect declared in ANOTHER module sees its domain.
  -- `freshModuleCtx` no longer re-seeds, so this survives every per-module reset below.
  -- Must precede the core checkModuleFull (it runs checkEffectParams, reading these).
  --
  -- It must also precede the declaration ENVELOPE below, and that ordering is the
  -- newer half of the constraint: the envelope's atom-guarantee seed
  -- (`declEnvRowAtomsEntries` → `dtopFor`) READS this table, so an envelope built
  -- first degrades every parameterized label to its ⊤ and over-rejects an honest
  -- relay into an abstractly-exported wrapper.
  --
  -- #1112 A-3.1: the units here are what `deAllDecls` flattens (`declEnvDeclsOf`),
  -- in the same order; `populateEffectDomainsGraph` walks them without building
  -- that concatenation a second time.
  let _ = populateEffectDomainsGraph gctx coreDecls modules
  -- What `IO` joins, from the grants of the profile the verb selected, after the
  -- domains the atoms take their tops from.  `run` checks against `runProfile` of
  -- that profile, whose host-label grants are the selected profile's own.
  gctx.config := tcConfigOf gctx.effectDomains.value inputs
  -- the prelude's own contribution to every derivation below, from the memo when
  -- the caller supplied a prelude key -- see `PreludePreamble`.  The row is built
  -- HERE, not inside the memo, because it carries THIS analyze's decls.
  let coreRow = declEnvModule gctx 0 "core" coreDecls
  let modRows = declEnvModulesFrom gctx 1 modules
  let prelude = preludePreambleFor gctx preludeKey coreDecls coreRow
  -- L3 (xmod-identity #1351 spine): the graph-level mangled-funDefs fact, under the
  -- two-part safety property stated on `meExports` (F3: unconditional
  -- whole-value overwrite at the Module-mode driver entry + no reset point after it
  -- is what keeps compile N's flag from leaking into compile N+1).  The two terms
  -- are the `("core", coreDecls) :: modules` unit list split on its head, which
  -- `graphCarriesMangledFunDefs` folds with `||`.
  gctx.mangledFunDefsPresentRef :=
    prelude.ppMangledFunDefs || graphCarriesMangledFunDefs modules
  -- #1112 A-3.1: the whole-graph declaration envelope, under the same two-part
  -- property as the line above (nothing resets it within the drive, and the
  -- Module-mode driver entry writes it unconditionally).  See `buildDeclEnvs`.  It
  -- carries the method namespace (`deMethods`) and the constructor export index
  -- (`deData.deCtorExports`), so it is written before any module — the core pass
  -- included — reads a method's scope or a constructor's import witness.
  let declEnvs = buildDeclEnvs gctx prelude.ppEnvAcc coreRow modRows
  gctx.declEnvsRef := declEnvs
  -- #1280: `coreDecls` arrives here ALREADY STAMPED (the caller's
  -- `stampGraphTyOrigins` line), but the scope is derived from its type
  -- NAMES, not its origins, so it is the same map either way.
  -- An extern's signature may index a prelude head by an authority
  -- (`netSend : Socket h -> … <Net h> …`), and a name in an index slot is an
  -- authority binder only by the head's declared kind.
  let runtimeSeed = withDeclParamKinds initial coreDecls (u =>
    externSchemes initial (runtimeExternTyOriginScope coreDecls) runtimeDecls)
  let _ = seedAbstractRecordTypes gctx coreDecls modules
  -- #2705: BOTH arms MARK (solving is not optional), with the same sets, and each
  -- module is marked on the schedule inside `checkBodyImpl` — after any memo
  -- restore of `GraphCtx.graphRun`, never before, which is what keeps a minted cell indexing
  -- the table it was minted into.  `markSetsOf` publishes the sets to
  -- `checkBodyImpl` and writes `mangledShadowMapRef`/`argDispatchIdxByIdRef`.
  -- The split of the mark set (`msMarkRpNames` vs `msMarkSharedNames`) and every
  -- input that can become an `EMethodAt` are enumerated in `moduleMarkCtx`; the
  -- return-position/non-nameable axis it scopes is expressed by
  -- `test/shadow_fixtures/d24_definer_return_pos_not_nameable/`.
  let ms =
    markSetsOf gctx prelude.ppMarkFacts coreDecls modules declEnvs.deAllDecls
  -- Both arms PROMOTE: an unsignatured user fn whose body dispatches a method gets
  -- an inferred constraint and joins the dict-name set, so its occurrences route
  -- through its own dictionary parameter on every verb.  The completeness judgment
  -- reads those routes, and a check driver that left such a body unpromoted would
  -- see `RNone` where the tree arm sees `RDict`.  The eligible set is written and
  -- the harvest cleared at the entry of every drive, which `maybeInferConstraint`
  -- reads.
  let _ = setDictEligible gctx (moduleUserFnNames modules)
  gctx.promotionHarvestRef := []
  -- The core pass.  The diags arm continues from the prelude interface, cached
  -- under the caller's prelude key (see `checkCoreMemoized`, which drains core's
  -- stamping context before it freezes).  The tree arm needs core's dict-passed
  -- decls as well, which an interface does not hold: it continues from the
  -- interface only when the process also holds the prelude's shipped trees for
  -- the drive's key (`treeArmHit`), and otherwise runs the pass outright and
  -- drains only at graph end.
  -- The prelude's published rows come back here only when this pass closed core
  -- (the diags arm, and the tree arm's hit); otherwise the tree arm publishes them
  -- after its graph-end drain.  Both arms return core's own contexts as a value.
  -- The tree arm's snapshot is never written to
  -- `CrossRun.coreSchemeObligationsRef`, which inference reads.
  let (coreSchemes, corePub, coreContexts, coreTree, coreCtx) = match sel
    GOutDiags =>
      let (bindings, published, coreCtx) =
        checkCoreMemoized initial preludeKey runtimeDecls coreDecls runtimeSeed
      -- The graph record the drive continues from, with the interface thawed into
      -- it.  Nothing holds `initial` past this point.
      noteInterners coreCtx.mcGraph
      (
        bindings,
        Some published,
        coreCtx.mcGraph.crossRun.coreSchemeObligationsRef.value,
        [],
        coreCtx,
      )
    GOutTrees => match treeArmHit inputs coreDecls gctx
      Some (pe, pi) =>
        let (bindings, published, coreCtx) =
          continueFromInterface gctx gctx.graphRun pi
        noteInterners coreCtx.mcGraph
        (
          bindings,
          Some published,
          coreCtx.mcGraph.crossRun.coreSchemeObligationsRef.value,
          pe.peDecls,
          coreCtx,
        )
      None =>
        let (bindings, tree, coreCtx) =
          elabModuleStamp initial "" runtimeSeed [] coreDecls coreDecls
        (bindings, None, coreOwnContexts coreCtx, tree, coreCtx)
  (runtimeSeed, coreSchemes, corePub, coreContexts, coreTree, ms, coreCtx)

-- The prelude's shipped trees for a tree-arm drive (`types/prelude_elab.mdk`), moved
-- onto the binders of [coreDecls], the drive's own desugar of core: held for the
-- drive's prelude key.
treeArmElab : DriveInputs -> List Decl -> Option PreludeElab
treeArmElab inputs coreDecls = match inputs.diPreludeKey
  Some k => preludeElabFor k coreDecls
  None => None

-- Those trees with the interface of the same key cached for the drive's IO join:
-- a drive takes both or neither.
treeArmHit : DriveInputs ->
  List Decl ->
  GraphCtx ->
  Option (PreludeElab, PreludeInterface)
treeArmHit inputs coreDecls gctx = do
  k <- inputs.diPreludeKey
  pi <- preludeCacheHit k gctx.config.value.tcIoJoin
  pe <- treeArmElab inputs coreDecls
  Some (pe, pi)

-- `graphPreamble`'s `(runtimeSeed, coreSchemes, record)` projection, for the
-- schemes-only driver (`checkModulesK`), which neither marks trees nor reads the mark
-- sets back.
checkModulesPreambleK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List (String, Scheme), ModuleBindings, ModuleCtx)
checkModulesPreambleK inputs preludeKey runtimeDecls coreDecls modules =
  let (runtimeSeed, coreSchemes, _, _, _, _, coreCtx) =
    graphPreamble
      inputs
      omEmpty
      GOutDiags
      preludeKey
      runtimeDecls
      coreDecls
      modules
  (runtimeSeed, coreSchemes, coreCtx)

-- worker: plain per-module typecheck (no diagnostics harvest, no accAll).  Surfaces
-- `schemes` twice — once as the pubV source foldModules needs, once as the payload
-- checkModules collects.
--
-- #1508 (U2a): it calls `checkModuleFullImpl` with the module id `foldModules` hands
-- it, so every user module reaches `checkBodyImpl`'s Module arm under its own id
-- (`declEnvsOrdOf`), as `graphModuleWorker` does through `checkModuleFullDiags`; only
-- the prelude is `""`, and a user module keyed `""` loses the qualified cross-module
-- tables (below).  It passes `accData` and `[]` implDecls (the perf-gate
-- path reads neither accumulator).
--
-- 🚨 THIS IS NOT ATTRIBUTION-ONLY, AND THE FIRST DRAFT OF THIS COMMENT SAID IT WAS.
-- The `""` key made `crossModuleSchemeOblsQualRef` and its three sibling qual tables
-- unreadable on this driver — their readers derive `src` from a real import path
-- (`useModId`), so they missed universally — which means an INFERRED
-- cross-module obligation was SILENTLY DROPPED from the importer's scheme.  MEASURED,
-- two arms, same fixture and `MEDAKA_ROOT`, only the probe differing:
--
--   p.mdk      export f x = "\{x}!"        -- Display a, INFERRED (no signature)
--   entry.mdk  import p.{f} / g v = f v
--
--   before:  g : a -> String              ← the `Display a =>` context is GONE
--   after:   g : Display a => a -> String  (and `medaka check`, an untouched driver
--                                           routing through `analyzeProject`, agrees)
--
-- That reached users through `projectEntrySchemes` — LSP project hover reported the
-- unconstrained type.  Pinned at
-- `test/check_module_fixtures/inferred_cross_module_obligation/`, whose header records
-- why the other eight fixtures were blind to the shape (all signatured or
-- interface-method-typed, so their contexts are DECLARED and ride the module seed).
-- An under-claimed fix is one nobody writes a test for, which is exactly what happened
-- between this comment's first draft and adversarial review.
cmCheckWorker : ModuleCtx ->
  String ->
  ModuleSeed ->
  List Decl ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List (String, PubScheme), ModuleCtx)
cmCheckWorker prev mid seed _accData _accAll prog =
  -- #2705: this is the SCHEMES-ONLY query driver — LSP hover/completion
  -- (`projectEntrySchemes`) and the linear-time perf gate — and it does NOT solve:
  -- it types the marked tree (`checkBodyImpl` directly, so no stamping context is
  -- queued) and reads schemes off inference.  A solve here would need the impl
  -- universe (`accAll ++ prog`, the concat #154 PR-C removed from this path; MEASURED
  -- to red `diff_compiler_perf_scaling`'s `modules` row at 4.48 against a 4.2
  -- ceiling) and would re-solve the whole graph per hover.  The memoized solve that
  -- makes this path one driver with the others is #2719.
  let (schemes, _, mctx) =
    checkBodyImpl prev.mcGraph (checkRunResidue prev) seed mid [] prog
  (schemes, publishOwn mctx schemes.mbSchemes, mctx)

-- The graph every Module-mode driver typechecks: type-constructor identity
-- acquired over the whole graph (`stampGraphTyOrigins`), then every impl head in
-- alias normal form (`tyAliasNormalForm`).  An impl head enters the instance
-- environment here, once, as the type it denotes, so instance selection,
-- coherence, the super-context checks and both engines read the same head, and
-- none of them expands an alias on it.  The alias table is the whole graph's,
-- keyed by declaration identity, so a head expands with the aliases of the
-- module that wrote it.
stampGraphDecls : List Decl ->
  List (String, List Decl) ->
  (List Decl, List (String, List Decl))
stampGraphDecls coreDecls0 modules0 =
  let (coreDecls, modules) = stampGraphTyOrigins coreDecls0 modules0
  let aliases = flatMap graphAliasRow (coreDecls ++ flatMap snd modules)
  if isEmptyL aliases then
    (coreDecls, modules)
  else
    (
      map (implHeadNormalDecl aliases) coreDecls,
      map (m => (fst m, map (implHeadNormalDecl aliases) (snd m))) modules,
    )

-- check every module in dependency order against a shared prelude + runtime.
-- modules = (moduleId, desugared program) in dependency-first order.
export
checkModules : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  List (String, List (String, PubScheme))
checkModules inputs runtimeDecls coreDecls0 modules0 =
  checkModulesK inputs None runtimeDecls coreDecls0 modules0

-- Keyed form of `checkModules`.  `preludeKey` is the desugar-cache generation pair
-- identifying `runtimeDecls`/`coreDecls0`; passing it lets `checkCoreMemoized` hit
-- the process-wide prelude interface instead of re-typechecking AND re-solving the
-- whole prelude on every call.  `None` reproduces the unkeyed behavior exactly.
--
-- #2719 (a1): the LSP hover/completion driver (`projectEntrySchemes`) used the
-- unkeyed `checkModules`, so an unkeyed lookup never hit and every hover paid
-- a cold prelude check-and-solve.  Caching the interface from HERE cannot poison a
-- later analyze: the miss arm computes the identical thing either way
-- (`checkModuleFull` over core, then `checkGraphFinish`), and this driver's own
-- worker (`cmCheckWorker`) queues no stamping context, so no drain interacts.
export
checkModulesK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  List (String, List (String, PubScheme))
checkModulesK inputs preludeKey runtimeDecls coreDecls0 modules0 =
  -- #1110: acquire type-constructor identity over the whole graph before anything
  -- typechecks; the rebind shadows the raw params so no line below can read the
  -- unstamped tree.  See `checkModulesPreambleK` for why it is here and not there.
  let (coreDecls, modules) = stampGraphDecls coreDecls0 modules0
  let (runtimeSeed, coreSchemes, coreCtx) =
    checkModulesPreambleK inputs preludeKey runtimeDecls coreDecls modules
  fst (cmFold runtimeSeed coreSchemes coreCtx modules)

-- `checkModulesK` also handing back what its drive left for the last module it
-- checked (its locals and import seed), taken at the drive's end.  It returns no
-- `TcReport`: the drive harvests no diagnostics, so it judges nothing.
export
checkModulesPartialK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  PartialAnalysis
checkModulesPartialK inputs preludeKey runtimeDecls coreDecls0 modules0 =
  fst
    (checkModulesPartialLast inputs preludeKey runtimeDecls coreDecls0 modules0)

-- `checkModulesPartialK` beside the record its drive ends in, for the callers that
-- read what the drive left (`matchWarningsNow`).
export
checkModulesPartialLast : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (PartialAnalysis, ModuleCtx)
checkModulesPartialLast inputs preludeKey runtimeDecls coreDecls0 modules0 =
  let (coreDecls, modules) = stampGraphDecls coreDecls0 modules0
  let (runtimeSeed, coreSchemes, coreClosed, coreContexts, _, _, coreCtx) =
    graphPreamble
      inputs
      omEmpty
      GOutDiags
      preludeKey
      runtimeDecls
      coreDecls
      modules
  let (rows, lastCtx) = cmFold runtimeSeed coreSchemes coreCtx modules
  (
    partialAnalysis
      rows
      (publishedCore coreClosed coreContexts coreSchemes.mbSchemes)
      (captureEntryTables lastCtx coreContexts modules),
    lastCtx,
  )

-- [coreCtx] is the record the core pass left current; the last module's record comes
-- back beside the rows.
cmFold : List (String, Scheme) ->
  ModuleBindings ->
  ModuleCtx ->
  List (String, List Decl) ->
  (List (String, List (String, PubScheme)), ModuleCtx)
cmFold runtimeSeed coreSchemes coreCtx modules =
  -- cmCheckWorker reads NEITHER accData (checkModuleFull → Module path, where
  -- checkBodyImpl binds it `_` and never reads it) NOR accAll (its `_accAll` param),
  -- so AccumulateNone threads them unchanged (no copy) and the `[] []` initials keep
  -- the dead values empty → the whole perf-gate `checkModules` path is O(N).  #2705: this
  -- driver marks but does not solve — see `cmCheckWorker` — so it queues nothing and
  -- drains nothing.
  let (rows, _, lastCtx) =
    foldModules
      AccumulateNone
      cmCheckWorker
      None
      (_last mid schemes rest => (mid, schemes) :: rest)
      []
      (runtimeSeed ++ coreSchemes.mbSchemes)
      (tagModuleExports coreSchemes.mbStandaloneSchemes coreSchemes.mbSchemes)
      []
      []
      []
      coreCtx
      modules
  (map (m => (fst m, freezeRows (snd m))) rows, lastCtx)

-- ── per-module ISOLATED diagnostics (the analyzeProject typecheck stage) ────
-- Like checkModuleFull but ALSO harvests THIS module's type diagnostics: it shares the
-- flat paths' seeding via `seedCheckRun` (#415 item 1 — matchOracle/matchWarnings)
-- and runs coherence over the module's OWN decls, while keeping the
-- module ISOLATED — only
-- PUBLIC schemes/data of earlier modules are seeded (via seedVars/accData), so a
-- private same-named helper in another module never collides (the bug the old
-- flat prefix-concat diagnostics path had).  checkModuleFull calls `freshModuleCtx`,
-- which clears typeErrors at module start, so the post-call typeErrors snapshot is
-- exactly this module's contribution; matchWarnings starts from the seed's empty list
-- (`seedCheckRun`).  Returns (own value schemes, errs, warns) so the
-- driver can thread accV/accData exactly as foldModules does.
--
-- Precondition (#154 PR1/PR2): this is per-module, and the Module path consults the
-- persistent universe accumulators (`universeFunNamesRef` / …), which survive the
-- per-module `freshModuleCtx`.  They are grown by `appendUniverseAccums prog0` per module but
-- must be cleared once per run by `mintGraphCtx` (and seeded by the core pass)
-- before the first module.  Every existing caller goes through a driver that does exactly
-- that (`driveGraphK`, via `graphPreamble`'s `mintGraphCtx`); a future standalone
-- caller that skips it would leak the previous run's universe into this one.
--
-- The stage-K envelope (`GraphCtx.declEnvsRef`, which carries the method namespace
-- `deMethods`) runs the other way (#1111 A-2.5b): it is not a `CrossRun` accumulator and
-- `mintGraphCtx` does not clear it, deliberately — it is derived once from the
-- whole graph with no per-module re-seed, so clearing it mid-run is the defect that put
-- the method index on `GraphCtx` (F1: `check` clean while `run`/`build` reported a
-- type error).  For it the precondition is "overwrite with this run's graph before the
-- first module":
--     gctx.declEnvsRef := declEnvs
-- which `graphPreamble` — the one Module-mode driver entry — does.  The failure modes
-- differ in kind: skipping `mintGraphCtx` leaks the previous run's universe;
-- skipping this write leaves the previous run's envelope in place, and a stale method
-- namespace can pick a wrong interface where an empty one finds nothing.  A standalone
-- caller must do both.
checkModuleFullDiags : GraphCtx ->
  String ->
  ModuleSeed ->
  List Decl ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List Decl, List TcDiag, List TcDiag, ModuleCtx)
checkModuleFullDiags gctx mid seedVars accData accAll prog =
  -- #415 item 1: same seeding preamble as the flat entry points (one body), but the
  -- oracle decls are THIS module's own first.
  -- P0-9: THIS module's own decls (`prog`) come FIRST so its constructors win
  -- the oracle's first-wins bare-name tables.  Another loaded module (in accData)
  -- can define a same-named ctor at a different arity (`map`'s arity-5 `Bin` vs
  -- `set`'s arity-4 `Bin`); with accData first, the type-aware `check_match` reads
  -- the WRONG arity/type for this module's own `Bin` in a match and false-warns
  -- W-NONEXHAUSTIVE.  buildOracle is duplicate-tolerant, and accData still
  -- supplies prelude Option/Result ctors (this module never redefines them).
  -- #674 / #1111 A-2.6: the decls whose CONSTRUCTORS this module binds by name are
  -- prepended BEFORE accData so their ctors win the oracle's first-wins bare-name
  -- tables over any same-named ctor a non-imported module contributes by load order —
  -- the exhaustiveness peer of the typecheck-scheme overlay.  Own-module `prog` still
  -- wins first.  The overlay decls come from the persistent universe (same source the
  -- dataEnv overlay uses), which equals accData here but keeps the two overlays in
  -- lockstep.
  --
  -- ⚠️ TWO CLAIMS THAT USED TO STAND HERE ARE FALSE SINCE A-2.6's RULE (b), which is
  -- why they are written out rather than re-pointed:
  --   * NOT "the types this module imports with `(..)`" — EVERY selective
  --     constructor-naming member contributes now (`import m.{T, C}`, and a record's
  --     `import m.{Cfg}`), not only the `(..)` spelling.
  --   * NOT "a module with no `T(..)` import is byte-identical" — only a module that
  --     names no constructor at all AND carries no wildcard import is.  A wildcard
  --     (`import m.*`) contributes m's whole published row without naming any
  --     constructor, since `wildOverlayDecls`; before that arm existed it fell to the
  --     universe fallback and import-clause ORDER decided the oracle's answer.
  -- The PERF claim is corrected at `importedCtorTypeDeclsFirstWins` itself (the result is bounded
  -- by import count x per-module public decl count; the WORK is O(members x |universe|),
  -- held down by one zero-allocation traversal per member).  Do not restate it as "no
  -- O(N²)" here: this
  -- call site is the SECOND per-module scan of the same pool, so it doubles whatever
  -- that constant is.
  -- A-3.2b (#1512): the SECOND consumer of the retired `universeDataDecls`, re-pointed
  -- at stage K in lockstep with the `dataEnv` overlay — the two must stay on the same
  -- pool ("keeps the two overlays in lockstep", above), and `mid` is this function's
  -- own parameter, so the same loader-derived key reaches both.
  let declEnvsHere = gctx.declEnvsRef.value
  -- 🚨 `…FirstWins`: `oracleMap` is `omFromPairs (reverseL …)`, so the FIRST row wins and
  -- the `UseGroup` rows must come FIRST for an explicitly named member to outrank a
  -- wildcard.  The `dataEnv` overlay takes `…LastWins` — opposite order, same rule,
  -- because that consumer is last-write-wins.  See `importedCtorTypeDeclsFirstWins`.
  let runSeed =
    seedCheckRun
      (prog
        ++ importedCtorTypeDeclsFirstWins
          prog
          (declEnvsOrdOf mid declEnvsHere)
          declEnvsHere.deModules
        ++ oracleImportDecls
          gctx
          prog
          (declEnvsOrdOf mid declEnvsHere)
          declEnvsHere.deModules
        ++ accData)
  -- Bug C: pass the cumulative full impl universe (core + earlier modules) as
  -- implDecls so buildStandaloneShadows sees
  -- an imported standalone funDef that shadows an interface method (`map`'s `isEmpty`
  -- vs Foldable's): without it the importer-shadow set is EMPTY on the CHECK path and
  -- `isEmpty m` routes to method dispatch rather than to the standalone the importer
  -- named.
  -- It feeds the shadow/dispatch-index/key tables and the impl-body inference
  -- universe alike, matching the eval path's elabModuleStamp (which passes
  -- accAll ++ prog too).
  -- #749: thread the REAL module id (not "") so this module's constrained fns are
  -- attributed into crossModuleFunConstraintsQualRef under their OWN source module —
  -- SOURCE-EXACT, exactly as the emit path (elabModuleStamp mid) does.  With mid=""
  -- every module attributed under "", so qualConstraintFor (which keys by the import's
  -- real source module via currentImportDefinersRef) always MISSED for a user-module
  -- constrained callee → declaredCrossModuleObls dropped its obligation → `check`
  -- false-greened on `p.f Z` (Display Z missing) while run/build rejected (the #673
  -- residual #738 fixed only for the prelude/core coreSchemeObligationsRef flow).  The
  -- source-exact keying makes it MISS for a genuinely-unconstrained same-name import
  -- (#739's `q.f`, attributed nowhere), so no over-rejection is reintroduced.
  let (schemes, marked, mctx) =
    checkModuleFullImpl gctx runSeed mid seedVars accData accAll prog
  -- #1557 A-3.5c: the whole-graph `CE`, read at THIS module's ordinal — the same
  -- `declEnvsOrdOf mid` key `seedCheckRun`'s overlay pool above and `moduleImplUniv`
  -- (`checkBodyImpl`) already read at.  ONE env for both members; they differ only in
  -- which population they take from it (`ceRowsOwnedBy` vs `ceRowsVisibleAt`).
  let ceHere = declEnvsHere.deIfaces
  let ordHere = declEnvsOrdOf mid declEnvsHere
  -- #1557 A-3.5b: the whole-graph `IE`, read at the SAME `ordHere` — the same key
  -- `ceHere` and `moduleImplUniv` (`checkBodyImpl`) already read at.
  -- #1559 A-3.7: coherence reads the SAME whole-graph `IE` at the SAME `ordHere`, and
  -- takes this module's OWN rows from it (`cohRowsOwnedBy`) — the population `prog`
  -- named, derived in `checkCoherence`'s header.  This env came
  -- from `buildDeclEnvs`, which seats the prelude at ordinal 0, so the module's rows
  -- are also paired with the prelude's.
  let _ =
    runFinalChecks
      mctx
      prog
      ceHere
      ceHere
      declEnvsHere.deImpls
      declEnvsHere.deImpls
      ordHere
  (
    schemes,
    marked,
    reverseL mctx.mcCells.typeErrors.items.value,
    reverseL mctx.mcCells.matchWarnings.value,
    mctx,
  )
-- Seed the ctor oracle over ALL data decls in scope (prelude + every imported
-- module via accData, plus this module's own prog), NOT just `prog`.  The
-- one-module path sees the same module-scoped dump, so
-- its `buildOracle prog` already includes Option/Result; the multi-module path
-- keeps modules separate, so prelude ADTs live in accData.  Seeding with only
-- `prog` left the oracle missing Some/None|Ok/Err → exhaustive matches on
-- Option/Result false-warned "non-exhaustive".  buildOracle reads only DData
-- and is duplicate-tolerant, so accData ++ prog is safe.

-- checkModuleFull → checkModuleFullImpl runs `freshModuleCtx` first (clears
-- typeErrors + currentLevel), so the snapshot below is this module's own errors.

-- coherence over this module's own impls runs in `runFinalChecks` above: its
-- `checkCoherence` sweeps this module's rows of the whole-graph `IE` (`cohRowsOwnedBy`),
-- and a hard conflict is pushed into typeErrors AFTER the `freshModuleCtx` above.

-- multi-module diagnostics driver: threads the runtime+core seed and per-module
-- PUBLIC accumulators exactly as foldModules threads, but at each module harvests its
-- ISOLATED diagnostics via checkModuleFullDiags.  Returns one
-- (mid, (errs, warns)) per module in load order.  Core is checked ONCE (its
-- diagnostics are not surfaced — it is the trusted prelude, as in checkModules).
-- IMPORT-SCOPED seed (baseSeed ++ importSeed prog depEnv), exactly like
-- foldModules — NOT a flat union of every earlier module's publics, which let
-- a same-named function from a non-imported module win by load order (e.g.
-- string.reverse shadowing the list.reverse a module imports → spurious errors).
-- worker: ISOLATED per-module diagnostics harvest (checkModuleFullDiags — see its
-- doc above).  Surfaces this module's own `schemes` (for pubV) plus the
-- (marked tree, schemes, errs, warns) payload.  IMPORT-SCOPED seed exactly like
-- cmCheckWorker; NOT a flat union.  ONE worker serves EVERY graph consumer — the
-- per-module diagnostics fold behind `analyzeProject` and the LSP, the entry report (`checkModulesEntryFullSplitK`), and the elaboration behind
-- `run`/`build`/`test`/the emit entries.  They differ in what they PROJECT from the
-- payload, never in what a module is checked against.  Keeping it one function is
-- what makes that a property of the code rather than of a comment: the consumers
-- CANNOT drift on the universe or the seed.
--
-- The `GOutTrees` writes are the only per-module divergence, and each is a
-- consequence of dict-passing rather than of checking: `mainSchemeRef` is written
-- Some-only so the last module binding
-- `main` wins (the diags arm's `collect` writes it SET-OR-CLEAR on the entry module
-- instead), and the promotion harvest unions THIS module's inferred-constraint
-- promotions before the next module's `freshModuleCtx` wipes `promotedRef` —
-- `foldModules` calls the worker HEAD-first, which is what makes that read safe.
--
-- The impl universe is `accAll ++ prog`, NOT bare `accAll` — it includes THIS module.
-- `foldModules` never folds a module into its own
-- `accAll` (see `checkModuleFullImpl`'s E5 note: "a caller that needs this module's own
-- decls too must fold [prog] in itself"), so the readers of `checkBodyImpl`'s
-- `implDecls` on this arm — `visibleMethodRows`, `inferUserImplBodies`' field-type
-- universe, `superDecls` and the `importerShadows` emptiness test — see this
-- module's own declarations only through this fold.  Return-only dispatch on an
-- own-module impl (`test/engine_fixtures/return_only_param_dispatch.mdk`, and
-- `test/run_check_agreement_fixtures/accept_own_module_impl_return_only_dispatch.mdk`
-- for the entry module of a graph) does not depend on it: determination reads the
-- whole-graph `IE` through `improvementPool`.
-- Cost: `accAll ++ prog` copies the accumulator, so O(|accAll|) per module and
-- quadratic over the graph; this is not the perf-gated `checkModules` path, which is
-- `cmCheckWorker`'s.  Each copy is short-lived only while nothing holds it until graph
-- end, which is why a module's stamping context keeps the interface decls alone.
--
-- #2246: the payload carries `schemes` a SECOND time.  `foldModules` hands the worker's
-- FIRST component to the NEXT module (it is the fold's seed, never `collect`'s), so the
-- only way the terminal module's own bindings reach `graphCollect` — which owes
-- `mainSchemeRef` its SET-OR-CLEAR write — is inside the payload, and the entry-report
-- projection needs the same triple to keep the terminal module's OWN schemes/warns.
-- Costs nothing: `checkModuleFullDiags` already computed them, and the marked tree is
-- the same list value the module was marked in, not a copy. The diagnostics
-- payload omits trees because the fold retains payloads until graph completion.
graphModuleWorker : OrdMap Unit ->
  GraphOut ->
  ModuleCtx ->
  String ->
  ModuleSeed ->
  List Decl ->
  List Decl ->
  List Decl ->
  (ModuleBindings, (List Decl, List (String, PubScheme), List TcDiag, List TcDiag, Option InvocationView), ModuleCtx)
graphModuleWorker capture sel prev mid seed accData accAll prog =
  let implDecls = accAll ++ prog
  let (schemes, marked, errs, warns, mctx) =
    checkModuleFullDiags prev.mcGraph mid seed accData implDecls prog
  let published = publishOwn mctx schemes.mbSchemes
  let tree = match sel
    GOutTrees =>
      let _ = match lookupAssoc "main" schemes.mbSchemes
        Some sc => prev.mcGraph.mainSchemeRef := Some sc
        None => ()
      prev.mcGraph.promotionHarvestRef :=
        dedup
          (prev.mcGraph.promotionHarvestRef.value
            ++ mctx.mcCells.promotedRef.value)
      marked
    GOutDiags => []
  let view =
    if omHasKey mid capture then
      Some mctx.mcCells.invocationViewRef.value
    else
      None
  (schemes, (tree, published, errs, warns, view), mctx)

-- collect: keeps the worker's marked tree and its `(schemes, errs, warns)` payload
-- per module in load order, and on the DIAGS selection's TERMINAL module records
-- that module's `main` scheme.  Two accumulators rather than two folds — the worker
-- computes both in one per-module pass, and the tree arm's `dictPassModulesIfEnabled`
-- consumes the first while every arm's caller consumes the second.  The tree arm
-- does NOT write `mainSchemeRef` here: its worker already wrote it per module,
-- Some-only.  The `schemes` half is what lets a caller derive the ENTRY REPORT — the
-- terminal module's own schemes and warnings, plus every module's errors — from this
-- one pass instead of from a second, entry-only driver over the same graph
-- (`checkModulesEntryFromDiags` below is that projection, and it is the old
-- entry-only `collect` written as a fold over this list).  `checkModulesDiagsChain`'s
-- exported signature (a selfproc LEG A row) keeps the narrower `(errs, warns)` shape:
-- it projects.
--
-- #2246: this is the multi-module `analyzeProject` path's ONLY producer of
-- `mainSchemeRef`.  S-3 (#2234) made `mainShapeWarnings` pure — it now READS the ref
-- rather than re-elaborating — which was correct for every caller that had a
-- producer, but `checkJsonFile`'s multi-module arm (driver/diagnostics.mdk) had NONE:
-- `analyzeProject` → `typecheckPassFull` → here, and nothing on that chain wrote it.
-- Both directions of that hole are pinned:
--   * fresh process — the ref is `None`, `mainIsUnitNow` answers False on `None`,
--     so W-MAIN-SHAPE FIRED on a clean Unit main (false positive on every
--     `check --json` / MCP `medaka_check` of a multi-module project);
--   * long-lived process (`medaka mcp`, `medaka lsp`) — the ref held whatever an
--     EARLIER request left, so a genuinely non-Unit `main` had its real warning
--     SILENTLY VANISH behind a previous request's Unit scheme.  [W-QUIETER]: that
--     direction is the more dangerous one.
-- SET-OR-CLEAR in ONE write, never a conditional/partial one: `lookupAssoc` yields
-- `None` when the terminal module has no `main`, and writing that `None` is what
-- clears a previous run's leftover.  Mirrors `checkModulesEntryFullSplit`'s write
-- (same last-wins entry-module rule; dependency-first order puts the entry last).
graphCollect : GraphCtx ->
  GraphOut ->
  Bool ->
  String ->
  (List Decl, List (String, PubScheme), List TcDiag, List TcDiag, Option InvocationView) ->
  (List (String, List Decl), List ModDiags, List (String, InvocationView)) ->
  (List (String, List Decl), List ModDiags, List (String, InvocationView))
graphCollect gctx sel isLast mid (marked, schemes, errs, warns, view) (markedRest, diagsRest, views) =
  let _ = match sel
    GOutDiags => setMainSchemeIfEntry gctx isLast schemes
    GOutTrees => ()
  -- The DIAGS selection keeps no tree: its `driveGraphK` arm returns
  -- `gdModules = []`, and its worker puts none in the payload (`graphModuleWorker`).
  let markedOut = match sel
    GOutDiags => markedRest
    GOutTrees => (mid, marked) :: markedRest
  (
    markedOut,
    (mid, (schemes, errs, warns)) :: diagsRest,
    option views (v => (mid, v) :: views) view,
  )

-- the `(errs, warns)` projection of one full per-module entry, for the exported
-- drivers whose contract is the narrower pair.
export
dropModSchemes : ModDiags -> (String, (List TcDiag, List TcDiag))
dropModSchemes (mid, (_, errs, warns)) = (mid, (errs, warns))

-- The ENTRY REPORT as a projection over the full per-module list: the TERMINAL
-- module's own schemes and warnings, and every module's errors accumulated
-- dependency-first — a type error in an IMPORTED module is still a hard error of
-- `check`ing the entry graph and must surface (else it silently reaches codegen, the
-- G1-class soundness hole).  This is what makes the entry report and the diagnostics
-- fold ONE typecheck rather than two.
--
-- The whole-graph coherence verdict is already attached by the driver
-- (`attachCoherenceConflict`): the soft half sits at the front of the terminal
-- module's warnings, exactly where `checkModulesEntryFullSplitK` prepends it.  The
-- hard half sits at the front of the terminal module's ERRORS rather than at the
-- front of the accumulated list, which differs only on a graph that has both a
-- conflict and an imported-module type error — a graph whose caller has already
-- reported errors and exited.
export
checkModulesEntryFromDiags : List ModDiags ->
  (List (String, PubScheme), List TcDiag, List TcDiag)
checkModulesEntryFromDiags [] = ([], [], [])
checkModulesEntryFromDiags [(_, (s, e, w))] = (s, e, w)
checkModulesEntryFromDiags ((_, (_, e, _)) :: rest) =
  let (eS, eE, eW) = checkModulesEntryFromDiags rest
  (eS, e ++ eE, eW)

-- `checkModulesEntryReport`'s renderer, over per-module diagnostics a driver already
-- produced.  Both must render identically or `check`'s multi-module report changes
-- shape, which is why the match below is `checkModulesEntryReport`'s verbatim.
export
entryReportFromDiags : List ModDiags -> String
entryReportFromDiags perMod = match checkModulesEntryFromDiags perMod
  (schemes, [], warns) => joinNl (schemeLines schemes ++ map tcMsg warns)
  (_, errs, _) => joinNl (typeErrorLines (map tcMsg errs))

-- The SET-OR-CLEAR write itself, on the terminal (entry) module only.  Split out of
-- `graphCollect` so the "never a partial write" property is one two-clause
-- function rather than an inline conditional.
setMainSchemeIfEntry : GraphCtx -> Bool -> List (String, PubScheme) -> Unit
setMainSchemeIfEntry gctx False _ = ()
setMainSchemeIfEntry gctx True schemes =
  gctx.mainSchemeRef := map (p => p.psScheme) (lookupAssoc "main" schemes)

-- The prelude generation pair plus the chain key: the driver's pass caches
-- (`driver/diagnostics.mdk`) carry it whole, and the module interfaces' graph key
-- (`serveStateOf`) only its first line, the generation, never the entry or roots.
export
chainFullKey : Int -> Int -> String -> String
chainFullKey rk ck chainKey = "\{intToString rk},\{intToString ck}\n\{chainKey}"

-- `driveGraphK GOutDiags` over [modules0].  Under a prelude key the drive serves the
-- modules before the entry from their interfaces (`diagsServe`), with [stepKeys]
-- pairing one source key with each module positionally.  The per-module payload is
-- the worker's whole `(schemes, errs, warns)` triple: a caller that also needs the
-- graph's ENTRY REPORT derives it from this list (`entryReportFromDiags`) instead of
-- running a second, entry-only driver over the same graph.  `dropModSchemes` is the
-- narrower `(errs, warns)` projection the bucketing fold consumes.
export
checkModulesDiagsChain : DriveInputs ->
  Option (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  List ModDiags
checkModulesDiagsChain inputs preludeKey chainKey stepKeys runtimeDecls coreDecls0 modules0 =
  checkModulesDiagsChainFor
    inputs
    False
    preludeKey
    chainKey
    stepKeys
    runtimeDecls
    coreDecls0
    modules0

-- `checkModulesDiagsChain` for a caller that passes its value-main candidate
-- (`autoPrintWanted`).
export
checkModulesDiagsChainFor : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  List ModDiags
checkModulesDiagsChainFor inputs valueMain preludeKey chainKey stepKeys runtimeDecls coreDecls0 modules0 =
  (fst
    (checkModulesChainReportFor
      inputs
      valueMain
      preludeKey
      chainKey
      stepKeys
      runtimeDecls
      coreDecls0
      modules0)).trDiagnostics

-- `checkModulesDiagsChainFor` returning the drive's whole report beside its
-- outputs.
export
checkModulesChainReportFor : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (TcReport, DriveOutputs)
checkModulesChainReportFor inputs valueMain preludeKey chainKey stepKeys runtimeDecls coreDecls0 modules0 =
  fst
    (checkModulesChainReportForGraph
      (chainArgs
        inputs
        valueMain
        preludeKey
        chainKey
        stepKeys
        runtimeDecls
        coreDecls0
        modules0))

-- The arguments of a drive keyed under the prelude generation pair [preludeKey] and
-- [chainKey], with one source key per module in [stepKeys]; unkeyed under `None`.
export
chainArgs : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  DriveArgs
chainArgs inputs valueMain preludeKey chainKey stepKeys runtimeDecls coreDecls0 modules0 =
  let base =
    driveArgs inputs valueMain preludeKey runtimeDecls coreDecls0 modules0
  { base |
    daKeyed =
      map ((rk, ck) => (chainFullKey rk ck chainKey, stepKeys)) preludeKey,
  }

-- The arguments of an unkeyed drive that executes nothing.
export
driveArgs : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  DriveArgs
driveArgs inputs valueMain preludeKey runtimeDecls coreDecls0 modules0 =
  DriveArgs
    inputs
    valueMain
    None
    preludeKey
    None
    runtimeDecls
    coreDecls0
    modules0

-- `checkModulesChainReportFor` beside the graph record its drive ends in, for a test
-- that observes that record after the drive.
export
checkModulesChainReportForGraph : DriveArgs ->
  ((TcReport, DriveOutputs), GraphCtx)
checkModulesChainReportForGraph args =
  let g = driveGraphK GOutDiags args
  ((g.gdReport, g.gdOutputs), g.gdGraph)

-- ── serving modules from their interfaces ───────────────────────────────────

-- The drain and open-variable test the serve policy (`types/serve_policy.mdk`) calls.
serveOps : ServeOps
serveOps = ServeOps {
  soDrain =
    mctx rows => match checkGraphFinish mctx
      [] => rows
      findings => attachDrainFindings findings rows,
  soUnboundIds = monoUnboundIds,
}

-- [lo, hi) less the ranges a scoped drain judged, as sub-ranges in order.
unjudgedRanges : Int -> Int -> List (Int, Int) -> List (Int, Int)
unjudgedRanges lo hi skips =
  cutRanges lo hi (sortOn fst (filterList ((a, b) => b > lo && a < hi) skips))

cutRanges : Int -> Int -> List (Int, Int) -> List (Int, Int)
cutRanges lo hi [] = if lo < hi then [(lo, hi)] else []
cutRanges lo hi ((a, b) :: rest) =
  (if a > lo then [(lo, a)] else []) ++ cutRanges (max lo b) hi rest

-- A serving drive's type and effect variables start above every id a serving drive
-- before it ended at, so no variable it mints shares an id with one a served
-- interface holds: the existential and pattern-authority tables are keyed by those
-- ids.
raiseToHighWater : GraphCtx -> Unit
raiseToHighWater gctx =
  let lineage = interners.value.lineage
  let r = gctx.graphRun
  r.tyvarCounter := max r.tyvarCounter.value lineage.lnTyvarHigh.value
  r.effvarCounter := max r.effvarCounter.value lineage.lnEffvarHigh.value

noteHighWater : GraphCtx -> Unit
noteHighWater gctx =
  let lineage = interners.value.lineage
  let r = gctx.graphRun
  lineage.lnTyvarHigh := max lineage.lnTyvarHigh.value r.tyvarCounter.value
  lineage.lnEffvarHigh := max lineage.lnEffvarHigh.value r.effvarCounter.value

-- [rows] with every row past the oldest [n] frozen: the oldest [n] were frozen when
-- they were recorded or served.
freezeFrom : Int -> List ModDiags -> List ModDiags
freezeFrom n rows = take n rows ++ map freezeModDiags (drop n rows)

-- #1112 A-3: the disposition producer.  For every accepted instance
-- (`ieRowsAll` — every impl row in the whole-graph `IE`, prelude included) and
-- every method of its interface's `CeRow`, exactly one row: `Supplied` when the
-- impl names the method, `InheritedDefault` when it does not and the method is
-- not in `ceRowRequired` (a required method with no default and no override is
-- rejected upstream, M1 — never reaches this walk at all).
buildDispositions : GraphCtx -> DeclEnvs -> DispositionTable
buildDispositions gctx envs =
  let impls = ieRowsAll envs.deImpls
  let table =
    buildDispositionTableWithShapes
      (dispositionRowsOfImpls envs.deImpls impls envs.deIfaces)
      (map (ifaceSuperCountOfRow gctx) impls)
  let _ =
    validateDispositionTable (dispositionSlotsOfImpls impls envs.deIfaces) table
  table

-- Every slot an accepted instance must have exactly one disposition for: each
-- method of its interface that it names, or that has a default to inherit.
dispositionSlotsOfImpls : List ImplRow ->
  ClassEnv ->
  List (InstId, IfaceRef, String)
dispositionSlotsOfImpls [] _ = []
dispositionSlotsOfImpls (r :: rest) ce =
  let (iface, _, _) = ieRowTriple r
  let inst = InstId (instRefMid (ieRowInst r)) (instRefSeq (ieRowInst r))
  let supplied = ieRowMethodNames r
  let here =
    match (ceLookupAt
      (regKeyOfTab (ifaceTabKey iface.irOrigin iface.irName))
      (ieRowOrd r)
      ce)
      None => []
      Some ceRow =>
        map
          (m => (inst, iface, m))
          (filter
            (m => contains m supplied || not (contains m (ceRowRequired ceRow)))
            (ceRowMethodNames ceRow))
  here ++ dispositionSlotsOfImpls rest ce

dispositionRowsOfImpls : ImplEnv ->
  List ImplRow ->
  ClassEnv ->
  List (InstanceShape, String, MethodDisposition)
dispositionRowsOfImpls _ [] _ = []
dispositionRowsOfImpls ie (r :: rest) ce =
  dispositionRowsOfImpl ie r ce ++ dispositionRowsOfImpls ie rest ce

-- Each row carries its instance's shape and its interface's word.  The shape's
-- route word is minted by the same call the lowering and eval install passes make
-- on the impl's declaration (`implRouteKeyWord` over the impl's own origin and type
-- arguments), so an inherited slot's entry is named and reached exactly as the
-- instance's supplied methods are.
dispositionRowsOfImpl : ImplEnv ->
  ImplRow ->
  ClassEnv ->
  List (InstanceShape, String, MethodDisposition)
dispositionRowsOfImpl _ r ce =
  let (iface, tys, _) = ieRowTriple r
  let inst = InstId (instRefMid (ieRowInst r)) (instRefSeq (ieRowInst r))
  let ifaceWord = ifaceWordOf iface.irOrigin iface.irName
  let supplied = ieRowMethodNames r
  let shape = InstanceShape {
    isWord = implRouteKeyWord iface.irOrigin iface.irName tys None,
    isTys = tys,
  }
  match (ceLookupAt
    (regKeyOfTab (ifaceTabKey iface.irOrigin iface.irName))
    (ieRowOrd r)
    ce)
    -- An impl whose interface is not visible has already been reported, and
    -- `dispositionSlotsOfImpls` expects no slot for it either.
    None => []
    Some ceRow =>
      map
        (d => (shape, ifaceWord, d))
        (dispositionRowsOfMethods
          inst
          iface
          supplied
          (ceRowRequired ceRow)
          (ceRowMethodNames ceRow))

-- The interface word of [r]'s interface with its direct superinterface count: the
-- super segment every dictionary of that interface stores.
ifaceSuperCountOfRow : GraphCtx -> ImplRow -> (String, Int)
ifaceSuperCountOfRow gctx r =
  let (iface, _, _) = ieRowTriple r
  (
    ifaceWordOf iface.irOrigin iface.irName,
    listLen (directSuperGoals gctx iface []),
  )

dispositionRowsOfMethods : InstId ->
  IfaceRef ->
  List String ->
  List String ->
  List String ->
  List MethodDisposition
dispositionRowsOfMethods _ _ _ _ [] = []
dispositionRowsOfMethods inst iface supplied required (m :: rest) =
  let restRows = dispositionRowsOfMethods inst iface supplied required rest
  if contains m supplied then
    Supplied { instance = inst, iface = iface, method = m } :: restRows
  else if not (contains m required) then
    InheritedDefault { instance = inst, iface = iface, method = m } :: restRows
  else
    -- A required method with no default and no override: M1 pushes a
    -- diagnostic (accumulate-errors, never an abort — T-ERRORS-ACCUM), so
    -- elaboration still reaches this walk on an already-ill-typed program.
    -- No disposition is correct for a slot the program will not compile
    -- with, so it is skipped rather than fabricated — panicking here turned
    -- a clean REJECT into a crash on
    -- test/run_check_agreement_fixtures/p0_17_missing_impl_method.mdk.
    restRows

-- Drive the whole module graph ONCE: stamp type-constructor identity, run the
-- shared preamble, check every module dependency-first through one worker, drain
-- at graph end, and attach the whole-graph coherence verdict.  `sel` chooses what
-- comes back (see `GraphOut`).  Every whole-graph entry point below is a projection
-- of this function.
--
-- [keyed] is a keyed drive's chain key (`chainFullKey`) and one source key per
-- module, `None` for every other drive.  Under it the fold serves each unchanged
-- module before the entry from its recorded interface and records the modules it
-- checks (`diagsServe`); a tree drive also serves and records each module's marked
-- trees, which `dictPass` then passes with the rest of the graph (`treeServe`).
-- Whether a drive is keyed is its caller's choice: a one-shot process passes no
-- source keys, so it neither serves nor records, and a session (the LSP, the
-- playground, `medaka test`) keeps the interfaces between drives.
--
-- `preludeKey` is the desugar-cache generation pair for the prelude interface (see
-- `checkCoreMemoized`); the tree arm ignores it and reads the drive's own
-- `diPreludeKey` (`treeArmHit`), since it also needs core's dict-passed decls,
-- which an interface does not hold.  `valueMain` is the caller's
-- value-main candidate and `executes` names the `async` driver of a caller that
-- runs the trees, `None` for one that does not (`autoPrintWanted`).
driveGraphK : GraphOut -> DriveArgs -> GraphDrive
driveGraphK sel (DriveArgs inputs valueMain executes preludeKey keyed runtimeDecls coreDecls0 modulesIn) =
  -- IMPORT ALIASING of an interface/impl METHOD — a method is global-by-name, so an
  -- alias of one is a second SPELLING, not a second binding.  A member alias and a
  -- module alias both keep their spelling through inference and are resolved at the
  -- end of the tree arm (`resolveAliasMethodSpellings`).  See
  -- `renameAliasedMethods`.  BOTH selections rename: that rewrite makes
  -- `import m as A` bind `m`'s methods under their ORIGIN name as well, which decides
  -- WHICH declaration a bare occurrence of that name resolves to — a binding change,
  -- not a spelling one, so a selection that skips it typechecks a different program.
  -- Only the RESTORE (`resolveAliasMethodSpellings`) is tree-arm-only: it rewrites
  -- occurrences in trees the diags arm does not emit.
  let (admitted, modulesAliased) = renameAliasedMethods coreDecls0 modulesIn
  -- #1110: acquire type-constructor identity over the whole graph before anything
  -- typechecks; the rebind shadows the raw params so no line below can read the
  -- unstamped tree.  It is HERE, not in the preamble, because this is the seam the
  -- RUN path and the separate `medaka_emitter` BUILD process share — the emitter
  -- never runs resolve, so acquiring identity anywhere upstream would give `check`
  -- and `build` different trees.  Method-alias renaming comes first: it is a name
  -- rewrite on VALUES and cannot move a type head, so the graph reaches identity
  -- minting in its final shape and no later pass has to re-mint.
  let (coreDecls, modules) = stampGraphDecls coreDecls0 modulesAliased
  let (runtimeSeed, coreSchemes, coreClosed, coreContexts, coreTree, ms, coreCtx) =
    graphPreamble inputs admitted sel preludeKey runtimeDecls coreDecls modules
  let capture =
    requestedWrapperViewModules
      inputs.diManifestRequests
      (manifestDriverFor inputs executes)
  let serve =
    map
      (k =>
        let st = serveStateOf serveOps capture coreCtx.mcGraph modules k
        match sel
          GOutDiags => diagsServe st
          GOutTrees => treeServe st)
      keyed
  if isSome serve then raiseToHighWater coreCtx.mcGraph
  -- The worker reads BOTH accData (buildOracle `prog ++ accData`) and
  -- accAll (checkModuleFullImpl implDecls), and
  -- both are order-observable (oracle first-wins, implDecls scan order), so both
  -- concats are RETAINED — this is not the perf-gate path, which is `cmCheckWorker`'s.
  let coreView = coreCtx.mcCells.invocationViewRef.value
  let ((modules2, perModRaw, views), served, lastCtx) =
    foldModules
      AccumulateBoth
      (graphModuleWorker capture sel)
      serve
      (graphCollect coreCtx.mcGraph sel)
      ([], [], [])
      (runtimeSeed ++ coreSchemes.mbSchemes)
      (tagModuleExports coreSchemes.mbStandaloneSchemes coreSchemes.mbSchemes)
      []
      (publicDataDecls coreDecls)
      coreDecls
      coreCtx
      modules
  -- #2548: quiescence.  Every module (core first) has been inferred and has queued
  -- its stamping context; drain them all now, in module order, before any tree goes
  -- to `dictPassModulesIfEnabled`.  The drive ends in the last module's record.  A
  -- keyed drive's drains, its recording modules' and this one, restore the sticky
  -- type-error cells (`checkGraphFinish`), so a served module's recorded sticky rows
  -- are the ones a check of it leaves.
  let findings =
    if isSome serve then checkGraphFinish lastCtx else drainStampQueue lastCtx
  if isSome serve then noteHighWater lastCtx.mcGraph
  let servedCount = optionOr 0 (map (policy => policy.msServed) served)
  -- D3 / WS-2 part-2: attach any cross-module coherence conflict to the ENTRY
  -- module's diagnostics (last in dependency-first order), so LSP/analyzeProject
  -- surfaces it too.  User modules only (prelude excluded).
  -- #414: no span — see globalCoherenceConflict (the entry module it attaches to is
  -- not the module the span would name, and the renderer keys the file by group).
  -- F-3d: the ⊑-incomparable half rides the WARNING list of the same module.
  -- #1559 A-3.7: the whole-graph `IE` the preamble built above; `cohRowsOf` is
  -- what excludes the prelude, replacing "walk the user `modules` list".
  -- It reads `deImpls` only, which nothing between here and the tree arm's return
  -- writes, so attaching once here serves both selections.
  let (wanted, autoPrint) =
    autoPrintWanted
      lastCtx
      valueMain
      executes
      findings
      perModRaw
      coreDecls
      modules
  let outcome = entryOutcomeNow lastCtx (mainHasObligations lastCtx) autoPrint
  -- The graph is closed: the drain, its defaulting and the auto-print verdict
  -- have run, so the published rows are frozen now, once.
  let perMod =
    attachCoherenceConflict
      lastCtx
      (attachDrainFindings
        (findings ++ wanted)
        (freezeFrom
          (optionOr 0 (map (policy => policy.msFrozen) served))
          perModRaw))
  -- Before the tree arm's `dictPass`, which writes the record's slot tables.
  let entryTables = captureEntryTables lastCtx coreContexts modules
  let corePub = publishedCore coreClosed coreContexts coreSchemes.mbSchemes
  let (requests, manifests, manifestDiags) =
    publishSelected
      lastCtx.mcGraph.effectDomains.value
      (invocationResolver
        (frozenInvocationOps
          lastInvocationOps
          (driveOutputsNow lastCtx outcome))
        (completionInvocationViews lastCtx coreView views))
      inputs.diManifestRequests
      perMod
      corePub
      outcome
      (manifestDriverFor inputs executes)
      valueMain
  -- #1112 A-3: the whole-graph IE/CE `buildDeclEnvs` filled in the preamble
  -- above is already complete at this point, on both arms alike.
  let dispositions =
    buildDispositions lastCtx.mcGraph lastCtx.mcGraph.declEnvsRef.value
  match sel
    -- A served module's evidence cells are not carried (`types/module_interface.mdk`),
    -- so a keyed drive's `cpEvidence` holds the checked modules' cells only.  No
    -- diagnostics-arm consumer reads it.
    GOutDiags => GraphDrive {
      gdPerMod = perMod,
      gdCoreSchemes = corePub,
      gdCoreContexts = coreContexts,
      gdCore = [],
      gdModules = [],
      gdResidual = [],
      gdEvTable = lastCtx.mcGraph.graphRun.evTable.value,
      gdDispositions = dispositions,
      gdBinders = lastCtx.mcGraph.graphRun.binderRows.value,
      gdReport =
        graphReportWithOutcome
          outcome
          manifests
          manifestDiags
          perMod
          corePub
          []
          (drivenEvidence lastCtx.mcGraph)
          dispositions
          lastCtx.mcGraph.graphRun.binderRows.value
          None
          entryTables,
      gdGraph = lastCtx.mcGraph,
      gdOutputs = withPublishedManifests
        requests
        manifests
        { driveOutputsNow lastCtx outcome | doServedModules = servedCount },
    }
    GOutTrees =>
      -- The set `dictPass` prepends dict params for: the bare set plus every
      -- promotion the sweep made, with the import aliases of both — the union of
      -- what every module was marked with (`beginModuleMarking`,
      -- `markRecursiveOccurrences`).
      let dictNames =
        markDictNames
          lastCtx.mcGraph
          (dedup
            (ms.msBareDictNames ++ lastCtx.mcGraph.promotionHarvestRef.value))
          coreDecls
          modules
      -- On a hit (`treeArmHit`: the core pass closed core) core's trees arrive
      -- dict-passed, and core's evidence and binder rows join the drive's.
      let shipped = match coreClosed
        Some _ => treeArmElab inputs coreDecls
        None => None
      let (coreD, modules3) =
        dictPassModulesIfEnabled
          lastCtx
          dictNames
          (isSome shipped)
          coreTree
          modules2
      -- `resolveAliasMethodSpellings` restores the origin name behind every
      -- alias-qualified method occurrence (`A.mth` -> `mth`) that inference kept.
      -- Only the user modules go through it: core imports nothing, so it holds no
      -- alias-qualified spelling to restore.
      let modulesOut =
        map (resolveAliasMethodSpellings lastCtx.mcGraph) modules3
      let residual =
        stickyDiagsInPushOrder lastCtx.mcGraph.typeErrorsStickyDiags.value
      -- read after `dictPass`, so it carries the `EMethodAt` nodes `dictPass` minted
      let (evidence, binders) =
        withShippedRows
          shipped
          (drivenEvidence lastCtx.mcGraph ())
          lastCtx.mcGraph.graphRun.binderRows.value
      GraphDrive {
        gdPerMod = perMod,
        gdCoreSchemes = corePub,
        gdCoreContexts = coreContexts,
        gdCore = coreD,
        gdModules = modulesOut,
        gdResidual = residual,
        gdEvTable = evidence,
        gdDispositions = dispositions,
        gdBinders = binders,
        gdReport =
          graphReportWithOutcome
            outcome
            manifests
            manifestDiags
            perMod
            corePub
            residual
            (_ => evidence)
            dispositions
            binders
            (Some (coreD, modulesOut))
            entryTables,
        gdGraph = lastCtx.mcGraph,
        gdOutputs = withPublishedManifests
          requests
          manifests
          { driveOutputsNow lastCtx outcome | doServedModules = servedCount },
      }

-- The whole-graph coherence verdict, attached to the entry module's diagnostics —
-- the tail `driveGraphK` ends with.  The narrower
-- `(errs, warns)` view is `map dropModSchemes` OVER this result: `cohOntoFull`
-- passes `schemes` through untouched and `attachEntryPayload` rewrites one entry,
-- so dropping the schemes commutes with attaching.
attachCoherenceConflict : ModuleCtx -> List ModDiags -> List ModDiags
attachCoherenceConflict mctx perMod =
  match globalCoherenceConflict mctx mctx.mcGraph.declEnvsRef.value.deImpls
    (None, None) => perMod
    (hard, soft) => attachEntryPayload (cohOntoFull hard soft) perMod

cohOntoFull : Option String ->
  Option String ->
  (List (String, PubScheme), List TcDiag, List TcDiag) ->
  (List (String, PubScheme), List TcDiag, List TcDiag)
cohOntoFull hard soft (schemes, errs, warns) =
  (schemes, cohHardOnto hard errs, cohSoftOnto soft warns)

cohHardOnto : Option String -> List TcDiag -> List TcDiag
cohHardOnto hard errs = prependDiagOpt "T-CONFLICTING-IMPL" 1 None hard errs

cohSoftOnto : Option String -> List TcDiag -> List TcDiag
cohSoftOnto soft warns =
  prependDiagOpt "W-INCOMPARABLE-IMPLS" 2 (Some cohIncomparableHelp) soft warns

-- rewrite the LAST module's payload in a per-module diag list (the entry module is
-- last in dependency-first order).
attachEntryPayload : (p -> p) -> List (String, p) -> List (String, p)
attachEntryPayload _ [] = []
attachEntryPayload f [(mid, p)] = [(mid, f p)]
attachEntryPayload f (m :: rest) = m :: attachEntryPayload f rest

-- The auto-print obligation of a value `main` (driver/main_autoprint.mdk), posed
-- at graph end by the drive that checks the entry module.  [valueMain] is the
-- caller's syntactic candidate (a parameterless `main` with `println` in scope);
-- whether `main` is printed at all is decided here from its own scheme, so a
-- Unit-shaped or `Async` main poses nothing.  The obligation is the `println`
-- signature's own context at τ_main, `main`'s scheme as the entry module left it:
-- the declared type under a signature, else the inferred one.  It joins the entry
-- module's errors whether or not the drive already has some, except that an
-- ambiguity verdict is dropped when one of [reported] lies in `main`'s binding:
-- that error already explains the undetermined type.  It runs after the drain, which can still default a numeric `main`, and before anything later
-- reads `main`'s variables, since the verdict can ground them.  An [executes]
-- drive, whose trees the driver wraps and runs, also returns the evidence of a
-- use judged clean (`autoPrintEvidence`); a check-only drive mints none.  Such a
-- drive judges an `Async` main's application to the driver it names instead
-- (`asyncDriverFindings`).  [mctx] is the record current after the drain, whose
-- type-error channel the verdict is taken from.
autoPrintWanted : ModuleCtx ->
  Bool ->
  Option String ->
  List DrainFinding ->
  List ModDiags ->
  List Decl ->
  List (String, List Decl) ->
  (List DrainFinding, Option EvId)
autoPrintWanted mctx False _ _ _ _ _ = ([], None)
autoPrintWanted mctx True executes findings perMod coreDecls modules =
  let decls = coreDecls ++ flatMap snd modules
  match (
    mctx.mcGraph.mainSchemeRef.value,
    last modules,
    printlnIface decls,
  )
    (Some scheme, Some (mid, entry), Some iface) =>
      if mainIsUnitNow mctx.mcGraph (mainHasObligations mctx) () then
        ([], None)
      else if mainIsAsyncNow mctx.mcGraph () then
        (asyncDriverFindings mctx executes mid entry scheme perMod, None)
      else
        -- A top-level `main` has no givens: the use is judged in a module scope
        -- of its own.
        let scope =
          Scopes.freshScope
            (currentScopeStore mctx.mcGraph ())
            None
            0
            mid
            ModuleOwner
        let _ = openScope mctx scope
        let loc = mainBodySpan entry
        let atMain = mctxAt loc mctx
        let posed = Ref None
        let diags = captureTypeErrors atMain (_ =>
          posed := Some (judgeAutoPrintUse atMain iface scheme loc))
        let ev = match (executes, diags, posed.value)
          (Some _, [], Some tau) =>
            Some (autoPrintEvidence atMain mid scope iface tau)
          _ => None
        let _ = closeScope mctx ()
        let reported = driveErrs findings perMod
        let kept =
          if anyList (d => inMainBinding entry (tcLoc d)) reported then
            filterList (d => tcCode d /= "T-AMBIGUOUS-INSTANCE") diags
          else
            diags
        (map (verdictFinding mid False) (mainUseDiags loc entry ++ kept), ev)
    _ => ([], None)

-- Every error a drive has reported so far, the drain's included.
driveErrs : List DrainFinding -> List ModDiags -> List TcDiag
driveErrs findings perMod =
  map (f => f.dfDiag) findings ++ flatMap modDiagErrs perMod

-- The printing use of `main` is a closed boundary, as a test body is (see
-- `settleClosedBody`): it instantiates `main`'s scheme with its context, poses
-- `iface` at the instance, and publishes no polymorphic result.  So a numeric
-- variable defaults as at any such boundary, a variable nothing determines is
-- ambiguous, and a closed goal gets the call channel's verdict, `requires`
-- included.  The instance the goal was posed at is returned.
judgeAutoPrintUse : ModuleCtx -> IfaceRef -> Scheme -> Option Loc -> Mono
judgeAutoPrintUse mctx iface scheme loc =
  judgeMainUse
    mctx
    (tau =>
      recordObl mctx Predicate { iface = iface, args = [tau] } 0 PCallSlot loc)
    scheme

-- The `async` driver [executes] names applied to an `Async` main, judged as the
-- printing use is (`judgeMainUse`) against the driver's scheme as the `async`
-- module published it: the drivers wrap exactly this application
-- (driver/main_autoprint.mdk's `shouldAsyncWrapMain`), after the drive.
asyncDriverFindings : ModuleCtx ->
  Option String ->
  String ->
  List Decl ->
  Scheme ->
  List ModDiags ->
  List DrainFinding
asyncDriverFindings mctx executes mid entry scheme perMod =
  let published = match lookupAssoc "async" perMod
    Some (rows, _, _) => rows
    None => []
  match option None (d => lookupAssoc d published) executes
    Some driver if mainAsyncPayloadIsUnitNow mctx.mcGraph () =>
      let scope =
        Scopes.freshScope
          (currentScopeStore mctx.mcGraph ())
          None
          0
          mid
          ModuleOwner
      let _ = openScope mctx scope
      let atMain = mctxAt (mainBodySpan entry) mctx
      let diags = captureTypeErrors atMain (_ =>
        let _ = judgeMainUse atMain (asyncDriverUse atMain driver) scheme
        ())
      let _ = closeScope mctx ()
      map (verdictFinding mid False) diags
    _ => []

-- The driver's parameter unified with `main`'s instance, the driver's context
-- posed at its own.
asyncDriverUse : ModuleCtx -> PubScheme -> Mono -> Unit
asyncDriverUse mctx driver tau =
  let (driverTy, subst) = instantiateTracked mctx driver.psScheme
  let _ = recordSchemeCallObligations mctx 0 driver.psContext subst
  match normalize driverTy
    TFun param _ _ => unify mctx param tau
    _ => ()

-- A use of `main` judged as a closed boundary: [pose] states the use's goal at
-- `main`'s instance before `main`'s own context is posed there.
judgeMainUse : ModuleCtx -> (Mono -> Unit) -> Scheme -> Mono
judgeMainUse mctx pose scheme =
  let _ = enterLevel mctx ()
  let oblMark = wMark mctx.mcCells.implObls
  let callMark = wMark mctx.mcCells.obls
  let dictMark = goalsMark mctx.mcGraph ()
  let (tau0, subst) = instantiateTracked mctx scheme
  -- A variable the value restriction left in `main`'s type is a live root, and
  -- the drain that could bind it has run: at this use it is the boundary's own,
  -- as a quantified one is.
  let fresh = flatMap (p => monoUnboundIds (snd p)) subst
  let held =
    filterList (i => not (anyList (== i) fresh)) (dedupI (monoUnboundIds tau0))
  let tau =
    substMono mctx.mcGraph (map (i => (i, freshVar mctx ())) held) [] [] tau0
  let id = optionOr 0 (omLookup "main" mctx.mcCells.schemeDefIdsRef.value)
  let context =
    lookupSchemeObls "main" id mctx.mcCells.schemeObligationsRef.value
  let _ = pose tau
  let _ = recordSchemeCallObligations mctx id (optionOr [] context) subst
  let _ = exitLevel mctx ()
  let _ = settleClosedBody mctx (tconBuiltin "Unit") oblMark callMark dictMark
  let _ =
    checkCallObligationsU
      mctx
      False
      mctx.mcCells.residualUnivRef.value
      (callUOblsWindow mctx callMark)
  tau

-- The evidence of the auto-print's one `Display τ_main` goal, published beside the
-- goals the drive solved so the driver's printing wrap can name it.
autoPrintEvidence : ModuleCtx -> String -> ScopeId -> IfaceRef -> Mono -> EvId
autoPrintEvidence mctx mid scope iface tau =
  let routes = routesOfMonosTopV (siteFor mctx) "" scope [tau] [iface] [[tau]]
  let g = mctx.mcGraph.graphRun
  let n = g.evCounter.value
  g.evCounter := n + 1
  let ev = EvId mid n
  g.evTable := EvEntry ev (EvMany routes) :: g.evTable.value
  ev

-- the entry module is last in dependency-first order
export
entryOwnSchemes : List (String, List (String, a)) -> List (String, a)
entryOwnSchemes = publishedEntrySchemes

-- ── multi-module `check` CLI report (DRIVER-COLLAPSE Phase 4, OPTION A) ─────
-- The unified `medaka check` path for IMPORT-BEARING files: the caller loads the
-- entry + its transitive imports (loadProgram), then this typechecks the whole
-- graph in dependency order (checkModuleFullDiags per module: per-module-frame,
-- prelude seeded once) and harvests the ENTRY module's OWN (schemes, errs, warns).
-- Imports are RESOLVED (their public schemes seed the entry), so a valid cross-
-- module reference no longer falls through to `UnknownModule` — the known "native
-- check is single-file" limitation, fixed.  The entry is last in dependency-first
-- order.
--
-- ⚠️ ROUTING, corrected 2026-08-26: this comment used to say "no-import (1-module)
-- files still route through runCheck … this path is reached ONLY when the load
-- returned more than one module."  FALSE since S-migrate-check-route (E-1 #1115).
-- A no-import file now reaches HERE too, via the 1-module wrappers
-- `checkOneScheme` / `checkOneDiags` / `checkOneToLinesWithRuntime` /
-- `checkOneErrorsWithRuntime`, each of which calls this function with a SINGLETON
-- module list.  So every clause below must be correct on a 1-module graph, not
-- merely defensible on one: `foldModules`' singleton clause is a genuinely
-- user-reachable path (it is where #2024's `accAll` = initial-value defect lives),
-- and so is the whole-graph coherence prepend at the bottom.
checkModulesEntryFull : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List (String, PubScheme), List TcDiag, List TcDiag)
checkModulesEntryFull inputs runtimeDecls coreDecls modules =
  checkModulesEntryFullK inputs None runtimeDecls coreDecls modules

checkModulesEntryFullK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List (String, PubScheme), List TcDiag, List TcDiag)
checkModulesEntryFullK inputs preludeKey runtimeDecls coreDecls modules =
  let (_, schemes, errs, warns) =
    checkModulesEntryFullSplitK
      inputs
      False
      preludeKey
      runtimeDecls
      coreDecls
      modules
  (schemes, errs, warns)

-- S-full-env-scheme-entry (#1116): the SAME driver, but ALSO returning the
-- prelude's own schemes — the `coreSchemes` `checkModulesPreambleK` already
-- computes and this function has always had in scope but dropped on the floor.
-- Nothing else changes: `checkModulesEntryFull` above is this minus the first
-- component, so every existing caller is byte-identical.
--
-- 🚨 The two lists are returned SEPARATE, and in this order — `(coreSchemes,
-- entryOwnSchemes, …)` — precisely so a caller CANNOT accidentally get #2054's
-- shape.  A consumer that wants one flat env for a first-match lookup
-- (`lookupSchemeL`, `lookupAssoc`) must concat OWN FIRST: `own ++ core`.  With
-- the prelude first, a user top-level binding that shadows a prelude name
-- (`isEven x = "s"`) would lose the linear-scan race to the prelude's
-- `Int -> Bool`, which is exactly the class of defect #2054 pins on the Flat
-- arm.  The Module arm's own fold is NOT affected — `checkModulesEntryFromDiags`'
-- terminal clause still returns only the terminal module's own schemes, and no
-- re-checking or re-unification against `coreSchemes` happens here: the
-- prelude list is carried out for LOOKUP only, alongside (never merged with)
-- the module's own entry for the same bare name.
-- `preludeKey`: the prelude key for the prelude interface (see `checkCoreMemoized`);
-- `None` = unkeyed, no cache.
export
checkModulesEntryFullSplitK : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (List (String, PubScheme), List (String, PubScheme), List TcDiag, List TcDiag)
checkModulesEntryFullSplitK inputs valueMain preludeKey runtimeDecls coreDecls0 modules0 =
  entrySplit
    (fst
      (checkModulesEntryFullReportK
        inputs
        valueMain
        preludeKey
        runtimeDecls
        coreDecls0
        modules0))

-- `checkModulesEntryFullSplitK`'s four parts, read off its drive's report.
export
entrySplit : TcReport ->
  (List (String, PubScheme), List (String, PubScheme), List TcDiag, List TcDiag)
entrySplit r =
  let (schemes, errs, warns) = checkModulesEntryFromDiags r.trDiagnostics
  (r.trPartial.paCore, schemes, errs, warns)

-- `checkModulesEntryFullSplitK` returning its drive's whole report beside its
-- outputs.
export
checkModulesEntryFullReportK : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (TcReport, DriveOutputs)
checkModulesEntryFullReportK inputs valueMain preludeKey runtimeDecls coreDecls0 modules0 =
  fst
    (checkModulesEntryFullReportKGraph
      (driveArgs inputs valueMain preludeKey runtimeDecls coreDecls0 modules0))

-- `checkModulesEntryFullReportK` beside the graph record its drive ends in.
checkModulesEntryFullReportKGraph : DriveArgs ->
  ((TcReport, DriveOutputs), GraphCtx)
checkModulesEntryFullReportKGraph (DriveArgs inputs valueMain _ preludeKey _ runtimeDecls coreDecls0 modules0) =
  -- The single-file front door loads stdlib/core.mdk twice: once as its prelude and
  -- once as the singleton `__user__` module.  Resolve already owns the syntactic
  -- self-test that prevents double-seeding core.  Apply that same authority before
  -- identity stamping, so one declaration graph is not stamped once as `core` and
  -- again as `__user__`.  `None` also prevents the empty prelude pass from sharing a
  -- memo key with the separately loaded declarations we deliberately dropped.
  -- Partial lookalikes remain ordinary because `programIsCore` requires BOTH halves.
  let (effectivePreludeKey, effectiveCoreDecls0, effectiveModules0) =
    match modules0
      [(_, prog)] =>
        if programIsCore prog then
          (None, [], [("core", prog)])
        else
          (preludeKey, coreDecls0, modules0)
      _ => (preludeKey, coreDecls0, modules0)
  let g =
    driveGraphK
      GOutDiags
      (driveArgs
        inputs
        valueMain
        effectivePreludeKey
        runtimeDecls
        effectiveCoreDecls0
        effectiveModules0)
  ((g.gdReport, g.gdOutputs), g.gdGraph)

-- render the entry report: type errors win (each `TYPE ERROR: …`), else the
-- entry's `name : scheme` lines followed by its non-exhaustive-match warnings.
-- The harness sorts, so scheme/warn relative order is not load-bearing.  Mirrors
-- runCheck's single-file shape, but over the entry module of a resolved graph.
export
checkModulesEntryReport : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  String
checkModulesEntryReport inputs runtimeDecls coreDecls modules =
  fst (checkModulesEntryReportOut inputs runtimeDecls coreDecls modules)

-- `checkModulesEntryReport` beside the outputs of its drive.
checkModulesEntryReportOut : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (String, DriveOutputs)
checkModulesEntryReportOut inputs runtimeDecls coreDecls modules =
  let (report, outputs) =
    checkModulesEntryFullReportK
      inputs
      False
      None
      runtimeDecls
      coreDecls
      modules
  let (_, schemes, errs, warns) = entrySplit report
  match errs
    [] => (joinNl (schemeLines schemes ++ map tcMsg warns), outputs)
    _ => (joinNl (typeErrorLines (map tcMsg errs)), outputs)

-- exit-code predicate analog of checkHasErrors: any type error in ANY module of
-- the resolved graph (entry or imported — see checkModulesEntryFromDiags).
export
checkModulesEntryHasErrors : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  Bool
checkModulesEntryHasErrors inputs runtimeDecls coreDecls modules =
  let (_, errs, _) = checkModulesEntryFull inputs runtimeDecls coreDecls modules
  match errs
    [] => False
    _ => True

-- ── ONE-MODULE Module-arm wrapper (S-check-one-wrapper, E-1 #1115) ─────────
-- The scheme/diagnostic-tree analogue of `elaborateOne` (above): runs a SINGLE
-- program through the `Module` arm as a degenerate one-entry module list, the
-- same way `elaborateOne` runs it through `elaborateModules`.  `checkModulesEntryFull`
-- is the entry-report projection of the one whole-graph driver (see the file header
-- and `driveGraphK`) — it therefore performs BOTH halves of the
-- two-part safety property a standalone `Module`-arm caller must uphold
-- (`mintGraphCtx` and the unconditional `mangledFunDefsPresentRef`/
-- `declEnvsRef` overwrites, the last carrying the method and constructor export
-- indices — see `checkModuleFullDiags`'s header comment just above its `export`).
-- Delegating to it (rather than hand-assembling a bare `checkModuleFullDiags` call
-- with an invented module id / degenerate accData/implDecls) gets that property for
-- free and needs no "empty module id" convention of its own — `foldModules`'s own
-- singleton-list clause (`[(mid, prog)]`) already IS the degenerate one-entry case,
-- run through the identical preamble every N-module call gets.  `rootId` names the
-- program's own module id (analogous to `elaborateOne`'s `rootId`); `checkModulesEntryFull`
-- has previously only been reached with 2+-module graphs (`checkModulesEntryReport`/
-- `checkModulesEntryHasErrors`, both import-bearing-only per its own header comment) —
-- this is its first 1-module caller.
export
checkOneScheme : DriveInputs ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  List (String, Scheme)
checkOneScheme inputs runtimeDecls coreDecls (rootId, prog) =
  let (schemes, _, _) =
    checkModulesEntryFull inputs runtimeDecls coreDecls [(rootId, prog)]
  pubSchemes schemes

-- FULL-ENVIRONMENT sibling of `checkOneScheme` (S-full-env-scheme-entry, #1116),
-- `checkOneSchemeFullK`:
-- `(preludeSchemes, ownSchemes)` for a ONE-MODULE program, the Module-arm
-- replacement for the retired single-program environment that the
-- introspection consumers (LSP hover/completion/inlayHint, the playground's
-- hover/complete query, `check-policy --fn <name>`) need: they look names up by
-- BARE NAME with no idea whether the name is the user's or the prelude's, so
-- `checkOneScheme`'s terminal-module-own-only answer is not enough for them.
--
-- The two halves are handed back SEPARATE, not pre-concatenated, so the caller
-- states the precedence it wants explicitly.  Every current consumer wants
-- `own ++ prelude` (first match wins ⇒ a user redefinition shadows the prelude's
-- binding of the same name) — see `checkModulesEntryFullSplit`'s 🚨 note.  This
-- is NOT a widening of the `medaka check` front door, whose narrowed
-- own-schemes-only report is deliberate and unchanged.
--
-- The prelude key is for the prelude interface (see
-- `checkCoreMemoized`): pass `Some (desugaredPreludeKey runtimeSrc,
-- desugaredPreludeKey coreSrc)` when `runtimeDecls`/`coreDecls` are exactly what
-- `desugaredPrelude` returned for those sources; `None` otherwise.
export
checkOneSchemeFullK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  (List (String, PubScheme), List (String, PubScheme))
checkOneSchemeFullK inputs preludeKey runtimeDecls coreDecls prog =
  fst
    (checkOneSchemeFullKGraph
      (driveArgs inputs False preludeKey runtimeDecls coreDecls [prog]))

-- `checkOneSchemeFullK` beside the graph record its drive ends in, for a test that
-- observes that record after the drive.
export
checkOneSchemeFullKGraph : DriveArgs ->
  ((List (String, PubScheme), List (String, PubScheme)), GraphCtx)
checkOneSchemeFullKGraph args =
  let (report, gctx) = checkOneReportKGraph args
  let (coreSchemes, schemes, _, _) = entrySplit report
  ((coreSchemes, schemes), gctx)

-- diagnostics-returning sibling of `checkOneScheme`, matching the former wrapper's
-- return shape (`(errs, warns)`) exactly, so a call site can swap targets with no
-- shape change (this slice's own acceptance bar — see the packet).
export
checkOneDiags : DriveInputs ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  (List TcDiag, List TcDiag)
checkOneDiags inputs runtimeDecls coreDecls prog =
  checkOneDiagsK inputs False None runtimeDecls coreDecls prog

-- `checkOneDiags` beside the graph record its drive ends in, for a test that observes
-- that record after the drive.
export
checkOneDiagsGraph : DriveArgs -> ((List TcDiag, List TcDiag), GraphCtx)
checkOneDiagsGraph args =
  let (report, gctx) = checkOneReportKGraph args
  let (_, _, errs, warns) = entrySplit report
  ((errs, warns), gctx)

-- `checkOneDiags` with the prelude key for the prelude interface — same contract as
-- `checkOneSchemeFullK` — and the caller's value-main candidate (`autoPrintWanted`).
export
checkOneDiagsK : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  (List TcDiag, List TcDiag)
checkOneDiagsK inputs valueMain preludeKey runtimeDecls coreDecls prog =
  let (_, _, errs, warns) =
    entrySplit
      (checkOneReportK inputs valueMain preludeKey runtimeDecls coreDecls prog)
  (errs, warns)

-- The report-returning sibling of both `checkOneSchemeFullK` and `checkOneDiagsK`:
-- the one-module drive's whole report, which each of them projects.
export
checkOneReportK : DriveInputs ->
  Bool ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  (String, List Decl) ->
  TcReport
checkOneReportK inputs valueMain preludeKey runtimeDecls coreDecls prog =
  fst
    (checkOneReportKGraph
      (driveArgs inputs valueMain preludeKey runtimeDecls coreDecls [prog]))

-- `checkOneReportK` beside the graph record its drive ends in.
checkOneReportKGraph : DriveArgs -> (TcReport, GraphCtx)
checkOneReportKGraph args =
  let ((report, _), gctx) = checkModulesEntryFullReportKGraph args
  (report, gctx)

-- S-migrate-check-route (E-1 #1115): thin ONE-MODULE String/Bool wrappers, matching
-- `checkToLinesWithRuntime`'s / `checkErrorsWithRuntime`'s (runtimeDecls, coreProg,
-- userProg) shape exactly, so `compiler/tools/check.mdk`'s two rendering/bool call
-- sites can swap targets with no shape change.  Delegate to the EXISTING entry-report/
-- -hasErrors functions above (already byte-identical in render logic to
-- checkToLinesWithRuntime/checkErrorsWithRuntime — `joinNl (schemeLines ++ warns)` on
-- success, `typeErrorLines` on error) over a singleton module list, rather than
-- duplicating that rendering logic here.  `"__user__"` mirrors `elaborateOne`'s own
-- rootId convention for a bare/no-import file (`entry_support.mdk`).
export
checkOneToLinesWithRuntime : DriveInputs ->
  List Decl ->
  List Decl ->
  List Decl ->
  (String, DriveOutputs)
checkOneToLinesWithRuntime inputs runtimeDecls coreProg userProg = checkModulesEntryReportOut
  inputs
  runtimeDecls
  coreProg
  [("__user__", userProg)]

-- `checkOneToLinesWithRuntime` with the prelude key for the prelude interface (see
-- `checkCoreMemoized`): same contract as `checkOneSchemeFullK`.  Same render as
-- `checkModulesEntryReport`, over the keyed driver.
export
checkOneToLinesWithRuntimeK : DriveInputs ->
  Option (Int, Int) ->
  List Decl ->
  List Decl ->
  List Decl ->
  String
checkOneToLinesWithRuntimeK inputs preludeKey runtimeDecls coreProg userProg =
  let (schemes, errs, warns) = checkModulesEntryFullK
    inputs
    preludeKey
    runtimeDecls
    coreProg
    [("__user__", userProg)]
  match errs
    [] => joinNl (schemeLines schemes ++ map tcMsg warns)
    _ => joinNl (typeErrorLines (map tcMsg errs))

export
checkOneToLines : DriveInputs -> List Decl -> String
checkOneToLines inputs userProg =
  fst (checkOneToLinesWithRuntime inputs [] [] userProg)

export
checkOneErrorsWithRuntime : DriveInputs ->
  List Decl ->
  List Decl ->
  List Decl ->
  Bool
checkOneErrorsWithRuntime inputs runtimeDecls coreProg userProg = checkModulesEntryHasErrors
  inputs
  runtimeDecls
  coreProg
  [("__user__", userProg)]

-- One-module match-report wrapper: the type-aware
-- non-exhaustive-match report for ONE module, runtime externs seeded and NO
-- prelude, rendered as one `Warning: non-exhaustive match …` line per warning.
--
-- WARNINGS ONLY — type errors are dropped on the floor rather than rendered, which
-- is this report's contract, not an oversight: the caller
-- (`compiler/entries/check_match_main.mdk`) diffs against
-- `dev/diagdump.exe --check-match`, which reports match warnings and nothing else.
-- `checkOneDiags` is the wrapper this delegates to precisely because it hands the
-- two halves back SEPARATE, so the split needs no new projection.
--
-- The empty `coreDecls` is what makes the seed identical to the `Flat` wrapper's
-- hand-built `externSchemes (runtimeExternTyOriginScope []) runtimeDecls`: `graphPreamble`
-- computes `externSchemes (runtimeExternTyOriginScope coreDecls) runtimeDecls`, which
-- collapses to the same expression at `coreDecls = []`.  `"__user__"` mirrors
-- `checkOneToLinesWithRuntime`'s rootId convention just above.
export
checkOneMatchToLines : DriveInputs -> List Decl -> List Decl -> String
checkOneMatchToLines inputs runtimeDecls prog =
  let (_, warns) = checkOneDiags inputs runtimeDecls [] ("__user__", prog)
  joinNl (map tcMsg warns)

-- run the multi-module front-end and render the ENTRY module's own bindings as
-- `name : scheme` per line (the harness sorts) — diffs vs dev/tc_module_probe.
export
checkModulesEntryLines : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  String
checkModulesEntryLines inputs runtimeDecls coreDecls modules =
  joinNl
    (schemeLines
      (entryOwnSchemes (checkModules inputs runtimeDecls coreDecls modules)))

-- Emit EVERY module's bindings in one pass, each section preceded by a
-- `## MODULE <mid>` marker line.  A single full-closure run can then cover many
-- modules at once (the batch harness splits on the marker and diffs each
-- section vs its per-module oracle).  Scheme of a module depends only on its
-- dependency-closure (which precedes it in topo order), so a module's section
-- is identical whether checked alone or inside a larger union closure.
export
checkModulesAllLines : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  String
checkModulesAllLines inputs runtimeDecls coreDecls modules =
  joinNl (allModuleLines (checkModules inputs runtimeDecls coreDecls modules))

allModuleLines : List (String, List (String, PubScheme)) -> List String
allModuleLines [] = []
allModuleLines ((mid, ss) :: rest) =
  "## MODULE " ++ mid :: schemeLines ss ++ allModuleLines rest

-- The multi-module analog of `elaborate`: the composition of `checkModules`
-- (per-module-frame typecheck, dependency-first) and the EMethodAt route-
-- stamping `elaborate` does single-module.  prePasses the prelude + every module
-- (rewriting return-position method occurrences to EMethodAt over the WHOLE
-- program's RP method set), typechecks each module in dependency order (seeded
-- like checkModules), and STAMPS each module's route refs from its now-resolved
-- result types.  Returns the SAME trees (refs filled) so evalModulesWith can route
-- return-position dispatch (`pure`/`andThen` — the Parser monad) by RKey instead
-- of the untyped arg-tag fallback.  RKey-only (dictNames = []): the bootstrap
-- source uses no `=>`-constrained user polymorphism, so no EDictAt / dict params
-- and no pendingDictApps / pendingRecDictApps to resolve.  Return shape: `ElabResult`.
export
elaborateModules : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  ElabResult
-- E4: D3b's ARG-position dict-passing per module runs inside the drive
-- (`dictPassModulesIfEnabled`), on every path (single elaboration mode, #157).
--
-- Impl-body inference runs on every driver, so a standalone-shadow method call
-- INSIDE an impl body (map's `Debug`/`Eq`/`Ord`/`Display (Map k v)` bodies all call
-- standalone `toList m`) RECORDS its RLocal site (recordRLocalSite -> the goal
-- channel) for resolveRLocalSites to stamp.  Without it the impl-body `toList` route
-- stays at its default RNone -> eval arg-tag-dispatches a Map through the
-- no-matching-tag `keepOrAll` fallback to Foldable List's `toList = identity` ->
-- returns the Map unchanged -> `debug`/`display` recurse forever (SIGBUS on
-- `medaka test stdlib/map.mdk`).
--
-- #2705: what distinguishes this projection from the diagnostics one is no longer
-- WHAT is solved — the same driver, the same preamble, the same worker, the same
-- graph-end drain — but that `GOutTrees` sets the promotion-eligible set (so its
-- groups PROMOTE and their call sites are marked as dict applications), publishes
-- the evidence table and dict-passes the marked trees, and that it returns the
-- diagnostics the drive raised as its residual.
elaborateModules inputs runtimeDecls coreDecls0 modulesIn =
  match (elaborateModulesWithSchemes
    inputs
    False
    runtimeDecls
    coreDecls0
    modulesIn)
    (result, _, _) => result

-- `elaborateModules` beside the graph record its drive ends in, for a test that
-- observes that record after the drive.
export
elaborateModulesGraph : DriveArgs -> (ElabResult, GraphCtx)
elaborateModulesGraph args =
  let ((result, _, _), gctx) = elabTreesDrive args
  (result, gctx)

-- `elaborateModules` together with the prelude's schemes and the entry module's own
-- schemes, from the SAME drive: a verb that both reads types and evaluates the
-- elaborated program (`check-policy`) typechecks once.  `valueMain` is the caller's
-- value-main candidate (`autoPrintWanted`).
export
elaborateModulesWithSchemes : DriveInputs ->
  Bool ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (ElabResult, List (String, PubScheme), List (String, PubScheme))
elaborateModulesWithSchemes inputs valueMain runtimeDecls coreDecls0 modulesIn =
  let (result, r, _) =
    elaborateModulesWithReport
      inputs
      valueMain
      None
      runtimeDecls
      coreDecls0
      modulesIn
  let (core, entrySchemes, _, _) = entrySplit r
  (result, core, entrySchemes)

-- `elaborateModulesWithSchemes` returning its drive's whole report and outputs
-- beside the elaboration.  `executes` names the `async` driver of a caller that runs or
-- emits the trees: its checked program then carries the auto-print evidence.
export
elaborateModulesWithReport : DriveInputs ->
  Bool ->
  Option String ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (ElabResult, TcReport, DriveOutputs)
elaborateModulesWithReport inputs valueMain executes runtimeDecls coreDecls0 modulesIn =
  fst
    (elabTreesDrive
      (DriveArgs
        inputs
        valueMain
        executes
        None
        None
        runtimeDecls
        coreDecls0
        modulesIn))

-- `elaborateModulesWithReport` keyed as `checkModulesChainReportFor` is: under the
-- prelude generation pair and [chainKey], with one source key per module in
-- [stepKeys], each module before the entry that is unchanged since it was recorded
-- is served from its recorded trees, and each module the drive checks records them.
export
elaborateModulesChainReport : DriveInputs ->
  Bool ->
  (Int, Int) ->
  String ->
  List (Option String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (ElabResult, TcReport, DriveOutputs)
elaborateModulesChainReport inputs valueMain (rk, ck) chainKey stepKeys runtimeDecls coreDecls0 modulesIn =
  fst
    (elabTreesDrive
      (DriveArgs
        inputs
        valueMain
        None
        None
        (Some (chainFullKey rk ck chainKey, stepKeys))
        runtimeDecls
        coreDecls0
        modulesIn))

-- The tree-producing drive of [args], as `elaborateModules` projects it.
elabTreesDrive : DriveArgs -> ((ElabResult, TcReport, DriveOutputs), GraphCtx)
elabTreesDrive args = elabDriveResult (driveGraphK GOutTrees args)

elabDriveResult : GraphDrive -> ((ElabResult, TcReport, DriveOutputs), GraphCtx)
elabDriveResult g = (
  (
    (
      g.gdCore,
      g.gdModules,
      map dropModSchemes g.gdPerMod,
      g.gdResidual,
      g.gdEvTable,
      g.gdDispositions,
      ElabFacts {
        efManifests = g.gdOutputs.doManifests,
        efBinders = g.gdBinders,
        efEntryOutcome = g.gdOutputs.doEntryOutcome,
      },
    ),
    g.gdReport,
    g.gdOutputs,
  ),
  g.gdGraph,
)

-- The report of `elaborateModules`' drive, for a test that reads it.
export
elaborateModulesReport : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  TcReport
elaborateModulesReport inputs runtimeDecls coreDecls0 modulesIn =
  match (elaborateModulesWithReport
    inputs
    False
    None
    runtimeDecls
    coreDecls0
    modulesIn)
    (_, report, _) => report
-- arg-position interface-method names whose route resolveArgStamps may stamp
-- (populated on every path; an empty set would degenerate prePassDictArg to prePassDict)

-- DRIVER-COLLAPSE Phase 2 (global): seed the promotion-eligible set with the USER
-- modules' top-level fn names (NOT core/prelude — those keep arg-tag / RKey
-- dispatch, which type-checks the goldens).  Seeded on every path (single
-- elaboration mode) so
-- elaborateModules promotes INFERRED-constraint user fns exactly as flat
-- the retired promotion fixpoint did (it reran discovery whenever the eligible set was
-- non-empty).  The TYPECHECK golden module drivers
-- (checkModulesEntryLines/checkModulesDiagsChain) never reach elaborateModules, so their
-- goldens are unaffected; the eval goldens are captured from the OCaml oracle's
-- run, which dict-passes prelude+modules unconditionally — so promotion-on-eval
-- matches them. Mirrors the graph driver's dictionary-eligibility seed.

-- Cause A / Phase 2: promotion discovery — an unsignatured fn whose body dispatches
-- a method in ARG position (`f s = println s` → inferred `Display a => …`) OR uses a
-- return-position method (`doubleEmpty x = append (append x empty) empty` → inferred
-- `Monoid a => …`) is discovered + registered in promotedRef/funConstraintsRef/
-- activeDictVars, and the promoted names join the dict-name set so their call sites
-- are marked EDictAt (caller supplies the dict ARGUMENT) and their defs get the
-- leading dict PARAM.  The discovery is `registerInferredConstraints` at each
-- group's close, and the schedule marks with its result (`markRecursiveOccurrences`
-- for the group's own occurrences, `beginModuleMarking` for every later group and
-- module); the joint-flattened Flat-arm scratch pass survives only in
-- the retired single-program promotion discovery.

-- E6: dict-name set for the `=>`-constrained-function layer, mirroring the
-- single-file emit driver's assembly (llvm_emit_typed_main.runEmit): prelude
-- return- AND arg-position `=>`-constrained fns (clamp/debugListItems/…) plus the
-- modules' own constrained signatures.  Computed on every path (single elaboration
-- mode).
-- Used to MARK constrained-fn call sites EDictAt in the prePass (so the caller
-- supplies the dict ARGUMENT) AND to add the leading dict PARAM in the final
-- dictPass (so the callee body's witness binds).  BOTH halves are required: marking
-- alone under-defines the param; param alone under-applies the call (ABI mismatch).
-- Cause A: promoted (inferred-constraint) user fns join the set.

-- ARGSTAMP-UNIFY Phase 4: the eval-dict layer is now PERMANENTLY active on both
-- paths (flag retired). The former elaborator ran its resolve chain and dict pass
-- UNCONDITIONALLY; the 1-module / multi-module eval path matches, so method-level
-- constraints (`build : Num e =>`) and parametric-impl `requires` (`impl Default
-- (List a) requires Default a`) — which leave dictNames EMPTY (no top-level
-- constrained FUNCTION) but still need resolveMethodDicts / the DImpl dict-pass —
-- get serviced.  The dictPass/resolve passes are no-ops when nothing was marked, so
-- this leaves the golden eval trees byte-identical where there is nothing to
-- dict-pass.
-- C5: ALSO mark cross-module standalone-shadow method occurrences (box's
-- `toList`/`isEmpty`) as EMethodAt, so they carry a route ref for elabModuleStamp's
-- resolveRLocalSites to stamp RLocal.  Without this they stay EVar (arg-position)
-- → no route ref → arg-tag panic on a no-impl
-- receiver.  Only added to the MARK set (not rpNames proper, which discoverPromoted
-- etc. consume) so other passes are unchanged.
-- DRIVER-COLLAPSE Phase 2: ALSO include methodConstraintNames (methods with their OWN
-- method-level `=>` constraint, e.g. `build : Num e => e -> t`), mirroring flat
-- the former pre-pass mark set (`returnPosMethodNames prog ++ methodConstraintNames
-- prog`).  Without it the method-constraint occurrence stays unmarked → its impl
-- clause's leading method-dict param is dropped/mis-bound → `non-exhaustive match`
-- (method_constraint_impl_offset).

-- impl table accumulates across modules (dependency order): a module's
-- arg-position dispatch can thread an EARLIER module's / core's parametric
-- `requires` element dict.  core2 seeds it.

-- E5: dict-pass each module's now-stamped
-- trees, preserving the former final `dictPass`. A parametric `requires`
-- impl whose body element-dispatch E5 routed RDict needs its leading
-- `$dict_<m>_<slot>` PARAM (dictPassDecl's DImpl arm) so the emitter can bind the
-- witness the route references; the call site's impl-dict route (filled by
-- resolveArgStamp) supplies the matching ARGUMENT.  E6: dictNames now carries the
-- prelude/module `=>`-constrained fns (clamp/debugListItems/displayListItems/…),
-- so dictPassDecl's DFunDef arm ALSO prepends their `$dict_<fn>_<slot>` params —
-- closing the "unbound dict witness" residual.  Runs on every path (single
-- elaboration mode); when nothing is marked the pass is a no-op returning
-- core2/modules2 verbatim.

-- E5/E6: final dict-pass of the stamped module trees, on every path.
-- [dictNames] is the prelude + module `=>`-constrained fn set.
-- E6: each module's typecheck calls `freshModuleCtx`, which clears funConstraintsRef,
-- so by this final pass only the LAST module's constraint arities survive — a
-- core-level constrained fn like `clamp` would get `dictArityOf` = 0 and NO leading
-- param.  Re-seed funConstraintsRef from every constrained signature (core +
-- modules) so dictPassDecl's DFunDef arm prepends the right number of
-- `$dict_<fn>_<slot>` params.  Only the COUNT is read here (the body's EDictAt/RDict
-- routes were already stamped, with real ids, during each module's own pass), so a
-- placeholder id list of the correct length is sufficient.  Prepended → wins the
-- lookupPredicateSlots first-match over any stale last-module entry.  (Golden module
-- drivers never reach elaborateModules, so their trees are untouched.)
-- Step 4 (Phase-134 fix): per-module importer-scoped arity, mirroring the oracle
-- eval.ml:2104-2164 collect_arities-per-scope.  The pre-fix JOINT
-- seedDictAritiesFromSigs keyed arity by BARE NAME, so a constrained fn in module A
-- forced spurious leading dict params onto an unconstrained same-named fn in module
-- B (whose call sites then under-applied → silent partial closure).  Core
-- (≈ the oracle's prelude) is imported by every module, so it keeps the FULL joint
-- scope.  Each module's scope = its own decls ∪ the decls of its transitive
-- importers ∪ core (the importer part covers a PUBLIC constrained fn referenced only
-- by its importers; mangleUnits already de-collided PRIVATES).  promotedC = the
-- joint-discovered promoted-fn slots (unsignatured, so constrainedSigPredicateSlots misses
-- them) carried across `freshModuleCtx` in the cross-module function carrier.
-- [mctx] is the record the drive's last module left current, whose slot tables the
-- pass rewrites.  [corePassed]: [core2] arrives dict-passed already (the prelude's
-- shipped trees), so only the user modules are passed.
dictPassModulesIfEnabled : ModuleCtx ->
  List String ->
  Bool ->
  List Decl ->
  List (String, List Decl) ->
  (List Decl, List (String, List Decl))
dictPassModulesIfEnabled mctx dictNames corePassed core2 modules2 =
  -- #2549 M2: index this sweep's solved evidence before anything reads a route
  -- out of it.  Here because `dictPass` is itself a reader (`collectDictSites`,
  -- `methodGrantUse`), and this is the Module arm's one funnel into it.
  let idx = evIndexOf (drivenEvidence mctx.mcGraph ())
  let promotedQ =
    mctx.mcGraph.crossRun.crossModuleFunPredicateSlotsQualRef.value
  let allMods = namesToSet (map fst modules2) omEmpty
  -- core imports nothing, so its definitions take their dict parameters from core's
  -- own signatures: a user fn sharing a bare name with a core private is another fn.
  setFunPredicateSlots mctx (scopePredicateSlots [] omEmpty core2)
  -- 🚨 B-2.2-b1: THE SIDECAR IS CLEARED, NOT LEFT ALONE.  `f` shipped arguing that
  -- writing no companion here is "absence, which is correct"; it is not — FAIL-CLOSED
  -- REQUIRES WRITING `[]`.  No module record is minted
  -- between the last `checkBodyImpl` and this call, so not writing leaves the PREVIOUS
  -- module's entries live: a reader in this phase would get a PRESENT, WRONG `CDPLen`,
  -- resolved by bare-name first-match against a differently-populated table, with no
  -- `CDPUnknown` to trip on.  Empty ⇒ `clampPrefix`'s `None` arm ⇒ `CDPUnknown` ⇒
  -- withhold, which is the honest answer for a table this phase does not repopulate.
  mctx.mcCells.funConstraintDeclaredRef := []
  mctx.mcCells.methodPredicateSlotsRef :=
    scopeMethodPredicateSlots
      mctx.mcGraph.crossRun.crossModuleMethodPredicateSlotsQualRef.value
      allMods
  let core2' =
    if corePassed then
      core2
    else
      dictPass mctx idx "" (constrainedSigNames core2) core2
  -- ONE reverse-reachability index for the whole run: `dictPassModulesScoped` asks the
  -- importer question once per module, and re-deriving it there re-walked the graph
  -- (twice — ids and decls) with a decl-list scan at every visited node.
  let importerReach = importerReachIndex modules2
  let modules2' =
    dictPassModulesScoped
      mctx
      idx
      dictNames
      promotedQ
      importerReach
      core2
      modules2
      modules2
  let r = mctx.mcGraph.graphRun
  r.evTable := servedEntriesFrom idx r.evBase r.evTable.value
  (core2', modules2')
-- Post-ARGSTAMP-UNIFY (Phase 4): ALWAYS run on every path (single elaboration mode).
-- Emit:
-- the DImpl arm prepends parametric impl-body element-dict params even when no
-- top-level `=>`-constrained FUNCTION is in [dictNames] (e.g. the empty-prelude
-- nested_dict_dispatch fixture: a parametric `Cmp (Box a) requires Cmp a` with no
-- constrained fn).  Eval: same — a parametric-impl `requires` whose DImpl body needs
-- its leading element-dict param (nested_instance_dicts: `impl Default (List a)
-- requires Default a`) gets dict-passed even with no top-level constrained FUNCTION.
-- Runs the unconditional final dict pass. No-op when nothing was
-- marked → byte-identical golden trees.  scopePredicateSlots sizes each define's leading
-- dict params to its surviving-constraint count.

-- per-module: set funConstraintsRef to the module's importer-scoped arities, then
-- dict-pass that module.  [allModules] is the full set (for the transitive-importer
-- walk); [modules2] is the remaining suffix to process.  core2 is always in scope.
-- [importerReach] is the run's one reachability index; it answers the importer
-- question for every module, so nothing here re-walks the import graph.
dictPassModulesScoped : ModuleCtx ->
  EvIndex ->
  List String ->
  List ((String, String), List PredicateSlot) ->
  OrdMap (OrdMap Unit) ->
  List Decl ->
  List (String, List Decl) ->
  List (String, List Decl) ->
  List (String, List Decl)
dictPassModulesScoped mctx _ _ _ _ _ _ [] = []
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
dictPassModulesScoped mctx idx dictNames promotedQ importerReach core2 allModules ((mid, prog) :: rest) =
  let importers = transitiveImporters importerReach mid allModules
  let importerDecls = flatMap snd importers
  let scope = core2 ++ prog ++ importerDecls
  let scopeMods = namesToSet (mid :: map fst importers) omEmpty
  -- IMPORT ALIASING: scopePredicateSlots keys arity by the DEFINITION's name, but an aliased
  -- call site in THIS module writes the LOCAL name.  Re-key this module's own aliases
  -- (from its DUse decls) onto the origin's arity, else the aliased call under-applies
  -- its dicts.  This is the RUN/eval path's counterpart to the same fix in
  -- checkModuleFullImpl — the EMIT path never needs it, because private_mangle has
  -- already rewritten `A.name` to the origin's real symbol before this point.
  -- #1425 site 3: re-key the names THIS module declares onto its own qual rows before the
  -- table is handed to `dictPass`.  `scopePredicateSlots` reduces `(mid, name)` to a bare name and
  -- throws the module id away, which is where a foreign module's constrained row becomes
  -- this module's phantom dict param; `selfDeclArities` is what puts the identity back for
  -- the one set of names this module can answer authoritatively — its own.
  let _ =
    setFunPredicateSlots
      mctx
      (selfDeclArities
        mid
        prog
        promotedQ
        (aliasConstraintEntries mctx.mcGraph prog promotedQ
          ++ scopePredicateSlots promotedQ scopeMods scope))
  -- B-2.2-b1: cleared for the same reason as in `dictPassModulesIfEnabled` — a stale
  -- prefix table is worse than an empty one, because only the empty one answers
  -- `CDPUnknown`.
  mctx.mcCells.funConstraintDeclaredRef := []
  mctx.mcCells.methodPredicateSlotsRef :=
    scopeMethodPredicateSlots
      mctx.mcGraph.crossRun.crossModuleMethodPredicateSlotsQualRef.value
      scopeMods
  (mid, dictPass mctx idx mid dictNames prog)
    :: dictPassModulesScoped
      mctx
      idx
      dictNames
      promotedQ
      importerReach
      core2
      allModules
      rest

-- the arity table for a scope: every `=>`-constrained signature in [scope]
-- (constrainedSigPredicateSlots) PLUS the joint-discovered promoted-fn slots whose fn is
-- DEFINED in [scope] (so a promoted fn out of scope doesn't leak a param count in).
-- #55: the signature count (`constrainedSigPredicateSlots`) is the syntactic predicate
-- count; the inferred count in the cross-module carrier (the
-- surviving generalized constraint vars from each body's inference) is what every
-- CALL site computes (constraintMonosOf over the call's instantiated scheme).  These
-- diverge for a point-free fn whose body MONOMORPHIZES a constraint var — e.g.
-- `sum = fold (+) 0`: the `0` literal is typed `Int` (litType), pinning `Num a`'s `a`
-- to `Int`, so `a` is NOT generalized → the scheme keeps only `Foldable t` (1
-- constraint) while the signature still lists 2.  If the define were sized off the
-- 2-count sig it would take 2 leading dict params while call sites pass 1 (dict +
-- container) → the container arg lands in an unpassed register → garbage deref /
-- SIGSEGV at -O2.  So for a fn WITH an inferred entry, the inferred arity WINS (drop
-- its sig entry); the sig count is the fallback for fns the body-inference path never
-- registered (unreached/never-called constrained fns).  `elem` is unaffected: both
-- its `Eq a` and `Foldable t` vars survive (no literal pins them) → inferred == sig == 2.
-- WS-2/D2: [promotedQ] is the module-attributed inferred arities
-- (crossModuleFunConstraintsQualRef); [scopeMods] is the set of module ids in this
-- dict-pass scope (this module ∪ its transitive importers ∪ "" for core, which is in
-- every scope).  An inferred entry survives when its fn NAME is in scope (as before).
-- For the SUBSET of names that collide (same bare name from ≥2 modules), prefer the
-- entry whose OWNING module is in scope — that disambiguation is the WS-2/D2 fix.
-- A non-colliding name, or a colliding name with NO in-scope-module entry, keeps the
-- old bare behavior (every same-name entry retained; first-match downstream).  This
-- is intentionally minimal: it changes arity ONLY for the cross-module bare-name
-- collision, so non-colliding programs (every golden) are byte-identical.
-- Reduces the qualified entries to the bare (name,ids) form downstream readers expect.
scopePredicateSlots : List ((String, String), List PredicateSlot) ->
  OrdMap Unit ->
  List Decl ->
  List (String, List PredicateSlot)
scopePredicateSlots promotedQ scopeMods scope =
  let scopeNames = namesToSet (declTopFnNames scope) omEmpty
  let nameInScope =
    filterList (e => omHasKey (snd (fst e)) scopeNames) promotedQ
  -- names that have at least one in-scope-module entry → drop their out-of-scope-module twins
  let resolvedNames =
    namesToSet
      (map
        (e => snd (fst e))
        (filterList (e => modInScope (fst (fst e)) scopeMods) nameInScope))
      omEmpty
  let inferredQ =
    filterList
      (e =>
        modInScope (fst (fst e)) scopeMods
          || not (omHasKey (snd (fst e)) resolvedNames))
      nameInScope
  let inferred = map (e => (snd (fst e), snd e)) inferredQ
  let inferredNames = namesToSet (map fst inferred) omEmpty
  let sigEntries =
    filterList
      (e => not (omHasKey (fst e) inferredNames))
      (flatMap constrainedSigPredicateSlots scope)
  inferred ++ sigEntries

-- ── #1425 / #1351: a module's OWN declarations take their arity from their OWN row ──
-- A bare-name arity table cannot say WHOSE `f` an entry is.  When two modules each declare
-- a top-level `f` — one `=>`-constrained, one not — the graph-wide bare accumulator carries
-- only the CONSTRAINED one's row, because an unconstrained binding contributes none at all.
-- So the unconstrained module's OWN `f` is sized with the OTHER module's dict arity: its
-- `define` takes a phantom dict parameter that its call sites never pass, and the argument
-- lands in the dict slot.  Which of the two import orderings breaks is decided by the order
-- of two `import` lines, because that decides the topological order the bare accumulator is
-- grown in — a wrong answer selected by source-file layout.
--
-- ⚠️ THIS IS THE CASE `scopePredicateSlots`' own in-scope preference cannot reach, and it is why
-- that preference is not enough on its own.  Its ladder prefers "an entry whose owning
-- module is in scope", and an unconstrained binding HAS NO ENTRY — it can never win a
-- preference it does not enter.  Worse, `scopeMods` is the IMPORTER direction (`mid` ∪ the
-- modules that transitively import it), so a foreign definer is never "in scope" and its row
-- survives by the `not (omHasKey … resolvedNames)` arm precisely when it is most wrong.
--
-- The repair supplies the DECLARATION's identity where it is already available and nowhere
-- else.  For each name THIS module declares at top level, the entry is THIS module's
-- `(mid, name)` qual row — and ABSENT when there is none, which is the accurate reading of
-- an unconstrained binding, not a missing fact: `declaredConstraintFor`'s `None` arm already
-- reads a qual miss for a known import exactly that way ("a MISS for a known import means
-- 'no constraint', not 'look elsewhere'"), and this is the same discipline applied to the
-- module's own declarations instead of to its imports.  A name the module does NOT declare
-- keeps the incoming table's answer byte-identical, so a program with no same-name collision
-- across modules is unaffected.
--
-- ⚠️ FAILS CLOSED ON ABSENT IDENTITY.  `mid == ""` is the "no module id" sentinel of the
-- loader-less drivers (single-file `check`, lsp, repl, doc); there the incoming table is
-- returned untouched, i.e. today's behaviour.  A supply that turned absence into a dropped
-- dict would be a severity increase, and absence is common on those paths by construction.
--
-- Keyed on `elaborateModules`' OWN inputs — the module's decls and the qual accumulator,
-- both already in hand at every site that calls this — never on which driver invoked it.
selfDeclArities : String ->
  List Decl ->
  List ((String, String), a) ->
  List (String, a) ->
  List (String, a)
selfDeclArities mid prog qual bare =
  if mid == "" then
    bare
  else
    let own = namesToSet (declTopFnNames prog) omEmpty
    selfQualEntries mid own qual
      ++ filterList (e => not (omHasKey (fst e) own)) bare

-- ── the other half of `selfDeclArities`, and it is NOT optional ──────────────
-- `selfDeclArities` is a per-module VIEW; the ref it is written to is ALSO the ref the
-- cross-module accumulator is snapshotted FROM at the end of the same body
-- (`crossModuleFunConstraintsRef` ← `ModuleCtx.funConstraintsRef`).  Without this restore the
-- view becomes a graph-wide LOSS: the rows masked while checking module `mid` never reach
-- the modules processed after it.
--
-- 🚨 MEASURED, not hypothetical — this is what the first cut of #1425's fix did.  Masking
-- `count` while checking `vector` (which declares an unconstrained `count`) deleted the
-- PRELUDE's constrained `count` row from the accumulator, so every later module lost it and
-- an ordinary `count (x => x > 1) [1, 2, 3]` in the entry panicked at `run`.  Prelude names
-- are the ones that expose it, because `importDefinersOf` skips `core` — a prelude name is
-- never an "explicit import", so it can only ever be answered by this bare table.
--
-- Restores by NAME from the accumulator's own previous value (still unwritten at the
-- snapshot, which is this ref's only writer), appended AFTER the module's rows so
-- first-match still prefers the identity-resolved answer.  Content-preserving: the view
-- removed exactly these rows, so appending them back is not duplication.
selfNameRows : List Decl -> List (String, a) -> List (String, a)
selfNameRows prog old =
  let own = namesToSet (declTopFnNames prog) omEmpty
  filterList (e => omHasKey (fst e) own) old

-- this module's own qual rows, reduced to the bare (name, payload) shape readers expect.
selfQualEntries : String ->
  OrdMap Unit ->
  List ((String, String), a) ->
  List (String, a)
selfQualEntries mid own qual =
  map
    (e => (snd (fst e), snd e))
    (filterList (e => fst (fst e) == mid && omHasKey (snd (fst e)) own) qual)

-- WS-2/D2 method analog of scopePredicateSlots, WITHOUT the sig-fallback: every method-level
-- constraint is registered during its interface module's typecheck
-- (installMethodPredicateSlots during method-row construction), so there is no
-- unsignatured-promoted residual to seed from signatures.  No method scope filter
-- either: keep every entry whose `methodSlotKey` no in-scope module also carries (so a
-- method whose impl lives in a different module than its interface is never dropped),
-- and for a key that some in-scope module does carry, keep only the in-scope entries.
-- The key already names the declaring interface, so one key has one owning module and
-- this keeps every entry.
scopeMethodPredicateSlots : List ((String, String), List MethodPredicateSlot) ->
  OrdMap Unit ->
  List (String, List MethodPredicateSlot)
scopeMethodPredicateSlots promotedMQ scopeMods =
  let resolvedNames =
    namesToSet
      (map
        (e => snd (fst e))
        (filterList (e => modInScope (fst (fst e)) scopeMods) promotedMQ))
      omEmpty
  let kept =
    filterList
      (e =>
        modInScope (fst (fst e)) scopeMods
          || not (omHasKey (snd (fst e)) resolvedNames))
      promotedMQ
  map (e => (snd (fst e), snd e)) kept

-- core (mid "") is in every scope; otherwise membership in the scope-module set.
modInScope : String -> OrdMap Unit -> Bool
modInScope mid scopeMods = mid == "" || omHasKey mid scopeMods

-- attribute each fn DEFINED in [prog] that carries a per-fn table entry to [mid] —
-- the source-exact `(mid, name)` key every cross-module fn table is read under.
--
-- Used for all three of the fn-side qual snapshots: the constraint ARITIES
-- (`funConstraintsRef`), the slot-parallel IFACES (`funConstraintIfacesRef`) and, since
-- B-2.2-f (#1113), the per-entry DECLARED-PREFIX scalar.  It was two byte-identical
-- monomorphic copies (`attributeModuleArities` / `attributeModuleArrIfaces`), each
-- carrying a `rule-duplicate-body` disable deferred to #1201; the sidecar's SCALAR
-- payload does not fit a `List X` signature at all, so the payload is now `a` and both
-- disables are gone rather than joined by a third.
attributeModuleEntries : String ->
  List Decl ->
  List (String, a) ->
  List ((String, String), a)
attributeModuleEntries mid prog entries =
  let progNames = namesToSet (declTopFnNames prog) omEmpty
  map
    (e => ((mid, fst e), snd e))
    (filterList (e => omHasKey (fst e) progNames) entries)

-- #1114 (#845): attribute each TOP-LEVEL binding of [prog] that carries a
-- `schemeObligationsRef` entry to [mid], source-exactly keyed `(mid, name)` — the same
-- key discipline as `attributeModuleEntries` above, and for the same #739 reason (a
-- bare-name cross-module table misattributes a same-named export of another module).
--
-- ⚠️ Unlike the arity tables, `schemeObligationsRef` is keyed `(name, binding-id)` and
-- holds LOCAL/`where` binders too (registerSchemeObligations is called from the local
-- sites with `omEmpty` member ids, so those key under id 0).  Two filters make the
-- projection to a bare exported name safe:
--   (1) [progNames] keeps only names this module defines at TOP LEVEL, so a `where`
--       helper whose name matches nothing at top level never enters the table at all;
--   (2) FIRST-occurrence-wins within a name, which resolves the one residual case — a
--       `where` helper that happens to SHARE a top-level name.  `schemeObligationsRef`
--       is consed, and a group's top-level members are registered AFTER the locals
--       inferred inside their bodies, so the head-most entry for a name is the
--       top-level one.  That is byte-identically the policy the SAME-module use site
--       already applies (`lookupSchemeOblsByName`'s first match), which is the point:
--       an importer must see what a same-module caller sees.
--
-- 🚨 A MODULE'S CONTRIBUTION IS WHAT IT DECLARES *PLUS WHAT IT RE-EXPORTS*, and the second
-- half is not optional — it is the recurrence `.claude/workstreams/TYPECHECK.md` records for
-- #1283 and `renameAliasedMethods` (below) already learned for the METHOD tables: "the
-- decl's origin names the DECLARING module and the import path names the RE-EXPORTER, so
-- the identity test misses."  Attributing only `declTopFnNames prog` means a pure
-- re-exporter (`export import lib.def.{f}`, whose `prog` has no function definitions at
-- all) contributes NOTHING, so `import lib.reexp.{f}` found no entry and #845's whole
-- failure came back one hop out — `check` 0, `build` 0, and the built binary SEGFAULTED.
-- Adversarial review produced exactly that program; this arm is the answer to it.
--
-- [qual] is the ALREADY-ACCUMULATED cross-module table, and dependency-first module order
-- is what makes reading it correct here: every module this one re-exports FROM has been
-- processed already, so its entries are present. That also makes a multi-hop chain resolve
-- without special-casing — each hop re-attributes under its own mid as it is processed,
-- exactly as `reexportedMethodNames` folds the method sets.
--
-- Re-export entries come SECOND so the module's own top-level binding wins the first-match
-- dedup below if a module somehow both defines and re-exports one name.
attributeModuleSchemeObls : String ->
  List Decl ->
  List ((String, String), List VecObl) ->
  List ((String, Int), List VecObl) ->
  List ((String, String), List VecObl)
attributeModuleSchemeObls mid prog qual entries =
  attributeSchemeOblsGo
      mid
      (namesToSet (publicValNames prog) omEmpty)
      omEmpty
      entries
    ++ map (e => ((mid, fst e), snd e)) (reexportSchemeOblEntries prog qual)

-- ⚠️ The export test is `publicValNames`, the module's own canonical one — NOT a
-- hand-rolled `DFunDef True` scan.  A first cut used the latter and REGRESSED two of this
-- PR's own fixtures: `export g : Num a => a -> a` on one line with `g x = x + 1` on the
-- next parses as a PUBLIC `DTypeSig` plus a PRIVATE `DFunDef`, so a scan that only reads
-- the `DFunDef` flag calls an exported binding private and drops it from the store.
-- `publicValNames` already answers this (its `DTypeSig True` arm), and reusing it is what
-- keeps this table's notion of "exported" from drifting from the module seed's.

-- the scheme contexts a module RE-EXPORTS (`export import src.{…}` / `export import src.*`),
-- each under the name it re-exports it as.  Reuses `schemeOblEntriesFor` — the same
-- spelling table the IMPORT side uses — so re-export and import can never disagree about
-- what a spelling binds; that is one table, not two kept in step by hand.
-- ⚠️ `export import src as A` contributes entries keyed `A.<name>`, which no importer of
-- THIS module can name (an alias is local to the file that writes it).  They are inert
-- rather than wrong, and excluding them would mean a second spelling table.
reexportSchemeOblEntries : List Decl ->
  List ((String, String), List VecObl) ->
  List (String, List VecObl)
reexportSchemeOblEntries [] _ = []
reexportSchemeOblEntries ((DAttrib _ d) :: rest) qual =
  reexportSchemeOblEntries [d] qual ++ reexportSchemeOblEntries rest qual
reexportSchemeOblEntries ((DUse True path _) :: rest) qual =
  schemeOblEntriesFor (useModId path) path qual
    ++ reexportSchemeOblEntries rest qual
reexportSchemeOblEntries (_ :: rest) qual = reexportSchemeOblEntries rest qual

attributeSchemeOblsGo : String ->
  OrdMap Unit ->
  OrdMap Unit ->
  List ((String, Int), List VecObl) ->
  List ((String, String), List VecObl)
attributeSchemeOblsGo _ _ _ [] = []
attributeSchemeOblsGo mid progNames seen (e :: rest)
  | not (omHasKey (fst (fst e)) progNames) =
    attributeSchemeOblsGo mid progNames seen rest
  | omHasKey (fst (fst e)) seen = attributeSchemeOblsGo mid progNames seen rest
  | otherwise =
    ((mid, fst (fst e)), snd e)
      :: attributeSchemeOblsGo
        mid
        progNames
        (omInsert (fst (fst e)) () seen)
        rest

-- WS-2/D2 method analog: attribute each method whose INTERFACE is declared in [prog]
-- (carrying a methodPredicateSlotsRef entry) to [mid].  Keyed by the interface's module —
-- the arity is a property of the method signature, registered during that module's
-- method-row construction pass.  The per-run table also holds the rows imported
-- modules contributed; only keys of [prog]'s own interfaces are attributed here.
attributeMethodModulePredicateSlots : String ->
  List Decl ->
  List (String, List MethodPredicateSlot) ->
  List ((String, String), List MethodPredicateSlot)
attributeMethodModulePredicateSlots mid prog entries =
  let progMethods = namesToSet (ifaceMethodSlotKeys prog) omEmpty
  map
    (e => ((mid, fst e), snd e))
    (filterList (e => omHasKey (fst e) progMethods) entries)

-- The `methodSlotKey` of every method of every interface [prog] declares.
ifaceMethodSlotKeys : List Decl -> List String
ifaceMethodSlotKeys [] = []
ifaceMethodSlotKeys ((DAttrib _ d) :: rest) =
  ifaceMethodSlotKeys [d] ++ ifaceMethodSlotKeys rest
ifaceMethodSlotKeys ((DInterface { name, methods, ifaceOrigin, ... }) :: rest) =
  map
      (methodSlotKey IfaceRef { irName = name, irOrigin = ifaceOrigin })
      (ifaceMethodNames methods)
    ++ ifaceMethodSlotKeys rest
ifaceMethodSlotKeys (_ :: rest) = ifaceMethodSlotKeys rest

-- the modules that transitively import [mid] (excluding [mid]), in module-list order.
-- Their decls are the importer half of [mid]'s dict-pass scope — a public
-- constrained/promoted fn defined in [mid] but referenced only by an importer must be
-- in scope when [mid] is dict-passed — and their ids are the owning-module set
-- `scopePredicateSlots` filters on.  Both halves read the SAME row, so the two can no
-- longer disagree about who the importers are.
transitiveImporters : OrdMap (OrdMap Unit) ->
  String ->
  List (String, List Decl) ->
  List (String, List Decl)
transitiveImporters reach mid modules =
  filterList
    (p =>
      fst p /= mid && omHasKey mid (optionOr omEmpty (omLookup (fst p) reach)))
    modules

-- The `=>`-constrained-function dict-name set `elaborateModules` hands to prePass and
-- dictPass, which must see the same set: the prelude's constrained names, then the
-- full `constrainedSigNames` of every module (not the return-position subset:
-- dictPass gives a leading dict parameter to every function whose signature is
-- constrained, so a mark set that omitted `quad : Monoid a => a -> a` would leave
-- its call sites unmarked).  The prelude's names are the one prelude-only input, so
-- a driver with a prelude key derives them once per process.
moduleDictNames : List String -> List (String, List Decl) -> List String
moduleDictNames preludeNames modules =
  preludeNames ++ constrainedSigNames (flatMap snd modules)

constrainedSigPredicateSlots : Decl -> List (String, List PredicateSlot)
constrainedSigPredicateSlots (DTypeSig _ n ty _)
  | isConstrainedTy ty = [(n, map sigPredicateSlot (sigConstraints ty))]
  | otherwise = []
constrainedSigPredicateSlots (DAttrib _ d) = constrainedSigPredicateSlots d
constrainedSigPredicateSlots _ = []

sigPredicateSlot : (IfaceRef, List String) -> PredicateSlot
sigPredicateSlot (iface, _) =
  PredicateSlot { psIface = iface, psArgs = PSArgsUnknown, psBoundIds = [] }

argRwOf : MarkCtx ->
  OrdMap Unit ->
  (String -> EvId -> Unit) ->
  (String -> Bool) ->
  ArgRw
argRwOf mc dn onDict granted = ArgRw mc.mcRp dn mc.mcAn mc.mcSm onDict granted

-- Mark the declarations of one module that are not binding groups (impl, default,
-- prop and test bodies) with the module's final dict-name set.  Binding
-- groups were marked on the schedule (`markGroupClauses`) and are left alone.
markTailDecls : ModuleCtx ->
  MarkCtx ->
  OrdMap Unit ->
  (String -> Bool) ->
  List Decl ->
  List Decl
markTailDecls mctx mc dn granted decls =
  map (markTailDecl mctx (argRwOf mc dn noDictHook granted)) decls

markTailDecl : ModuleCtx -> ArgRw -> Decl -> Decl
markTailDecl mctx _ (d@(DFunDef _ _ _ _ _ _)) = d
markTailDecl mctx _ (d@(DLetGroup _ _)) = d
markTailDecl mctx rw (DAttrib attrs d) = DAttrib attrs (markTailDecl mctx rw d)
markTailDecl mctx rw d = prePassDeclScoped mctx rw d

markClauseWith : ModuleCtx -> ArgRw -> (List Pat, Expr) -> (List Pat, Expr)
markClauseWith mctx rw (ps, e) =
  (ps, rewriteArgScoped mctx rw (boundOfList (patVarsListTc ps)) e)

-- `moduleMarkCtx ms mid prog`: core (`mid == ""`) is marked with the unsplit set and
-- the core-scoped shadow map (#2153).  A user module gets the split set, scoped by the
-- filter below.
--
-- CORE'S rp/arg SETS ARE S1-FILTERED TOO, and the argument that they need not be is
-- retired.  It read: "core's references to its own standalones are all mangled
-- `core__<n>` by the time this runs, so neither set can match one."  #2809 moved
-- mangling AFTER elaboration, so core's references now carry the names its author
-- wrote and a USER interface method spelled like a core standalone matches them.
-- MEASURED on `test/prelude_shadow_census.ledger`'s own probe shape — `interface Ifc c
-- where identity : c -> Int` beside `impl Ifc Int`, in a module that defines no
-- `identity` — `check` and `run` accept and print 1 while `build` died `E-PANIC: no
-- impl of method 'identity' for type 'List'`: core's own `identity` call, on a `List`,
-- had been rewritten to a dispatch on the USER's interface.  Four ledger rows
-- (`identity`, `otherwise`, `arbitraryList`, `arbitraryString`) moved PASS -> FAIL_BUILD
-- that way.  The rule applied is the one `coreShadowMapFor` already applies to the
-- shadow map for the same reason: an interface declared in a USER module is not
-- nameable in `core`, so no `core.mdk` occurrence is one of its method occurrences.
-- Same fail-OPEN guard as `nameableIfaceShadows`: an absent graph index leaves the sets
-- unfiltered rather than emptying them.
moduleMarkCtx : GraphCtx ->
  MarkSets ->
  String ->
  List Decl ->
  OrdMap Scheme ->
  MarkCtx
moduleMarkCtx gctx ms mid prog imported =
  let candidates = methodMarkCtx gctx ms mid prog
  let local = namesToSet (declTopFnNames prog) omEmpty
  -- A module's own extern denotes itself wherever the module spells it, as its
  -- own function named like an interface method does (SHADOW-SEMANTICS S2's
  -- definer arm), so its occurrences are never method occurrences.
  let externs = namesToSet (declExternNames prog) omEmpty
  MarkCtx {
    mcRp = IdMap.difference candidates.mcRp externs,
    mcAn = IdMap.difference candidates.mcAn externs,
    mcSm =
      filterList
        (entry => omHasKey (fst entry) local || omHasKey (snd entry) imported)
        candidates.mcSm,
  }

-- Method nameability and standalone availability are independent. The wrapper
-- admits standalone routes only for this module's definitions or actual imported
-- standalone descriptors, never for private functions elsewhere in the graph.
methodMarkCtx : GraphCtx -> MarkSets -> String -> List Decl -> MarkCtx
methodMarkCtx gctx ms "" coreProg
  | omSize (ifaceExportsIndex gctx ()) == 0 = MarkCtx {
    mcRp = omFromNames ms.msMarkRpNames omEmpty,
    mcAn = omFromNames ms.msArgNames omEmpty,
    mcSm = ms.msCoreShadowMap,
  }
  | otherwise =
    let nameable = nameableIfaceMethodSet gctx coreProg
    let keep = n => omHasKey n nameable
    MarkCtx {
      mcRp = omFromNames (filterList keep ms.msMarkRpNames) omEmpty,
      mcAn = omFromNames (filterList keep ms.msArgNames) omEmpty,
      mcSm = ms.msCoreShadowMap,
    }
methodMarkCtx gctx ms _ prog
  -- fail OPEN when the graph index is absent, for the reason stated on
  -- `nameableIfaceShadows`: an unscoped mark set is today's behaviour, an empty one is the
  -- S4/#410 class.
  -- Guard the index this arm actually reads: the body reads `meIfaceExports`, so the
  -- guard tests that and not its sibling `meExports` — testing one while reading the
  -- other is an implicit conjunction of exactly the kind `registry_keying_ratchet`
  -- exists to forbid.  Run with an empty iface index, the other arm would filter out
  -- every imported and prelude shadow name, failing closed into the S4/#410 class that
  -- `nameableIfaceShadows` says must never happen.
  | omSize (ifaceExportsIndex gctx ()) == 0 =
    let aliasRows = aliasMethodSpellings gctx prog
    MarkCtx {
      mcRp =
        withAliasMethodNames
          aliasRows
          (omFromNames
            (dedup (ms.msMarkSharedNames ++ ms.msGraphShadowNames))
            omEmpty),
      mcAn = withAliasMethodNames aliasRows (omFromNames ms.msArgNames omEmpty),
      mcSm = gctx.mangledShadowMapRef.value,
    }
  | otherwise =
    -- 🔒 S1-NS (b), THE CLOSURE INVARIANT.  The spec requires the predicate deciding
    -- SHADOW-HOOD to be a SUPERSET of the one deciding DISPATCH ELIGIBILITY, and rules two
    -- different predicates at the two sites non-conformant WHICHEVER WAY THEY DIFFER.
    --
    -- 🚨 THE INVARIANT IS ABOUT INPUTS TO DISPATCH, NOT ABOUT SETS OR SELECTORS, AND
    -- COUNTING THE WRONG THING SHIPPED AN S0.  An earlier revision of this comment said
    -- "there is exactly ONE predicate here … the two sets are EQUAL … the gap is
    -- unrepresentable" — and was false four lines above itself, because `rpNames` was
    -- concatenated RAW into the first argument while the other three lists were filtered.
    -- `rewriteArgScoped` dispatches on `rp`, `an` AND `sm`, so dispatch-eligibility was
    -- `rpNames ∪ filtered(…)` — a strict superset of shadow-hood, which is S1-NS's own
    -- "Newly NON-CONFORMANT (1)".  Measured: a return-position method of a non-nameable
    -- interface gave `run` 777 against a built binary of 42, both exit 0, no diagnostic.
    --
    -- THE ENUMERATION, so the next reader checks the SET rather than trusting a sentence.
    -- Every input `rewriteArgScoped` can turn into an `EMethodAt` is filtered here:
    --   * `rpNames`   — return-position method names AND method-level-constraint method
    --                   names (`markSharedNames` concatenates both).  BOTH are interface
    --                   METHOD names — each walks `DInterface`'s `methods` — so both are the
    --                   same kind of set as `argNames` and both are filtered.
    --   * `shadowNames` — via `shadowBareName`, because on the emit path these are mangled.
    --   * `argNames`  — arg-position dispatch indices.
    --   * `shadowMap` — the emit-path peer of `argNames`.
    -- `dictNames` is the ONE input deliberately NOT filtered, and it is not an input to
    -- dispatch at all: it produces `EDictAt`, a dict application of a `=>`-constrained
    -- FUNCTION, which selects no impl from a receiver.  Filtering it would drop a dict
    -- argument and UNDER-APPLY the callee (`unbound identifier: $dict_…`, the Phase-134
    -- shape) — so it is disjoint by node kind, not by name, and that is probed rather than
    -- argued (see `test/shadow_fixtures/`'s return-position cells and the PR body).
    let nameable = nameableIfaceMethodSet gctx prog
    let keep = n => omHasKey n nameable
    let shadowMap = gctx.mangledShadowMapRef.value
    -- The occurrence-spelling context, taken ONCE for this module rather than rebuilt
    -- inside each filter below — per row it was most of this cell's measured
    -- regression; see `SpellCtx`.
    let sc = spellCtxOf gctx prog
    let aliasRows = aliasMethodSpellings gctx prog
    MarkCtx {
      mcRp =
        withAliasMethodNames
          aliasRows
          (omFromNames
            (dedup
              (filterList keep ms.msMarkSharedNames
                ++ filterList
                  (n =>
                    omHasKey (shadowBareName shadowMap n) nameable
                      && shadowSymSpelledBare sc shadowMap n)
                  ms.msGraphShadowNames))
            omEmpty),
      mcAn =
        withAliasMethodNames
          aliasRows
          (omFromNames (filterList keep ms.msArgNames) omEmpty),
      mcSm =
        filterList
          (e =>
            omHasKey (snd e) nameable
              && moduleSpellsShadowBare sc (fst e) (snd e))
          shadowMap,
    }

-- ── #2153: S1's `nameable in M` for the PRELUDE unit ─────────────────────────
-- `moduleMarkCtx` (above) filters the definer-shadow map at the CONSUMING module.
-- `core` is the one unit that never goes through that filter: its context is built
-- from the RAW graph-wide map.  That is
-- fine for `rpNames`/`argNames` — they are BARE method names, and core's references to its
-- own standalones are all mangled `core__<n>` by the time this runs, so neither set can
-- match one (the P0-21 argument `elaborateModules` states at `markRpNames`).  It is NOT
-- fine for the shadow map, which is keyed by exactly those mangled symbols.
--
-- 🚨 MEASURED (#2153): `computeMangledShadowMap` walks `("core", coreDecls)` against the
-- GRAPH-WIDE method-name list, so a USER module declaring `interface Ifc c where not : …`
-- mints `core__not ↦ not`.  `rewriteArgScoped`'s `sm` arm then rewrote CORE's OWN
-- `core__not` occurrence (in `neq`, `notElem`, a core prop, …) to `EMethodAt "not"`, and
-- core's env has no `not` — so `medaka build` died `E-PANIC: unbound method: not` on a
-- program `check` and `run` both accept, and even on one that never mentions the method.
-- That is the whole 22-name FAIL_BUILD class in `test/prelude_shadow_census.ledger`: a
-- prelude standalone reaches this arm only when ANOTHER prelude decl references it, which
-- is the very split `frontend/marker.mdk`'s `droppablePreludeFns` names (`clamp` yes,
-- `count`/`find` no) — and it is why the fix `types/private_mangle.mdk` landed for the
-- module's OWN occurrences could not reach these: the surviving occurrence is core's.
--
-- The rule applied is S1's own: an interface method declared in a USER module is not
-- nameable in `core`, so no `core.mdk` occurrence can be its shadow.  Same predicate and
-- same fail-OPEN guard as the per-module filter above — sited beside it so the two stay
-- auditable as a SET rather than as two independent answers to one question.
--
-- #2809 ADDED THE SECOND CONJUNCT, and its absence was measured.  With mangling moved
-- after elaboration a definer-shadow row is `(name ↦ name)`, so `map`'s standalone
-- `toList` and the prelude's OWN `Foldable.toList` occurrence in a specialized default
-- body (`impl Foldable Option`'s `isEmpty`) spell the same key: the nameable test alone
-- admitted the row, `rewriteArgScoped`'s `sm` arm seeded core's method occurrence with
-- `RLocal "toList"`, and the emitter turned a dispatch into a direct call to a symbol
-- core does not define — `use of undefined value '@mdk_toList'`, i.e. #2153's incident
-- with the bare spelling as the key.  `moduleSpellsShadowBare` is the SAME occurrence-
-- spelling test the per-module filter applies, so core is scoped by one rule, not two.
coreShadowMapFor : GraphCtx ->
  List Decl ->
  List (String, String) ->
  List (String, String)
coreShadowMapFor gctx coreProg shadowMap
  | omSize (ifaceExportsIndex gctx ()) == 0 = shadowMap
  | otherwise =
    let nameable = nameableIfaceMethodSet gctx coreProg
    let sc = spellCtxOf gctx coreProg
    filterList
      (e =>
        omHasKey (snd e) nameable && moduleSpellsShadowBare sc (fst e) (snd e))
      shadowMap

-- ── #1684: S1's STANDALONE operand, at the OCCURRENCE spelling ───────────────
-- The two filters above answer S1's INTERFACE operand (`nameable in M`) and nothing
-- else.  That is sufficient on the un-mangled check/run path, where an occurrence
-- carries the spelling the author wrote — but NOT on the emit path, where
-- `types/private_mangle.mdk` has already collapsed BOTH spellings of an imported
-- standalone onto ONE symbol:
--
--   import amod.{shrink}  → `shrink`    ⎫
--   import amod as A      → `A.shrink`  ⎭ → both become `EVar "amod__shrink"`
--
-- `computeMangledShadowMap` then recovers `amod__shrink ↦ shrink` from the DEFINING
-- module's funDefs and `rewriteArgScoped`'s `sm` arm rewrites EVERY occurrence of that
-- symbol to `EMethodAt "shrink"` — including the alias-qualified one, which was never
-- an S1 occurrence at all.  §1.0's standalone-operand row is *"defined in `M` or
-- imported into `M`"*, and `import amod as A` imports the standalone into `M` under the
-- local name `A.shrink`; bare `shrink` is bound by no import form there, so it names
-- nothing in `M` and can shadow nothing in `M`.
--
-- MEASURED (#1684, S0): a two-file program whose only interface is the PRELUDE's
-- `Arbitrary` — no `impl` and no `interface` written anywhere in it — had `A.shrink 5`
-- emitted as a call to `@mdk_impl_Int_shrink`, so the built binary printed
-- `Arbitrary.shrink`'s list default `[0, 2]` while `run` printed the standalone's `6`.
-- Both at exit 0, no diagnostic on any channel.
--
-- So the emit path must reconstruct what the mangle erased: admit a mangled shadow
-- symbol only where `M` actually spells its BARE name.  Two admitting cases, and the
-- test is over IMPORT FORMS rather than over the symbol's origin module, so a name
-- reaching `M` through a re-export chain (whose `useModId` is the re-exporter,
-- not the definer) is admitted exactly as it is today:
--   * `M` DEFINES the symbol itself — the definer shadow (P0-18), unchanged.
--   * some import form in `M` binds the LOCAL name `bare`: a member list naming it, or
--     a wildcard.  A module alias (`Some []`) and a member alias (`{size as sz}`, whose
--     local is `sz`) bind it under a different spelling, so neither admits it — and
--     both then agree with what the un-mangled path already does with that spelling.
-- Empty shadowMap ⇒ `lookupAssoc` misses ⇒ True ⇒ the check/run path is untouched.
shadowSymSpelledBare : SpellCtx -> List (String, String) -> String -> Bool
shadowSymSpelledBare sc sm n = match lookupAssoc n sm
  None => True
  Some bare => moduleSpellsShadowBare sc n bare

spellCtxOf : GraphCtx -> List Decl -> SpellCtx
spellCtxOf gctx prog = SpellCtx {
  scTopFns = declTopFnNames prog,
  scBare = declBareLocals gctx prog BareLocals { blAll = False, blSet = [] },
  scCorePfx = mangledName "core" "",
}

moduleSpellsShadowBare : SpellCtx -> String -> String -> Bool
moduleSpellsShadowBare sc sym bare =
  contains sym sc.scTopFns
    || startsWith sc.scCorePfx sym && sym == "\{sc.scCorePfx}\{bare}"
    || bareLocalBound sc.scBare bare

-- ⚠️ THE IMPLICIT-PRELUDE ARM ABOVE IS LOAD-BEARING, AND ITS ABSENCE WAS MEASURED.
-- The prelude is in scope in EVERY module under BARE names and contributes NO `DUse`
-- decl, so a walk over the module's imports cannot see it: a
-- prelude standalone shadowed by a USER interface method (S1-PRELUDE (a), the
-- `x4_prelude_standalone_live_impl_receiver` / `x5_prelude_constrained_standalone_live_impl`
-- cells) mangles to `core__isEven` with no import form naming `isEven`, so without this
-- arm the entry was dropped and both cells went `DIFF`/FAIL — the prelude standalone's
-- `False` where the ruling requires the interface method's `True`. The prelude is also
-- the one module that CANNOT be alias-imported (`import core as C` → `Unbound variable:
-- C.eq`, SHADOW-SEMANTICS.md §1.1's table), so bare is its only spelling and this arm
-- admits nothing the alias case could have written differently.

bareLocalBound : BareLocals -> String -> Bool
bareLocalBound bl bare = bl.blAll || contains bare bl.blSet

declBareLocals : GraphCtx -> List Decl -> BareLocals -> BareLocals
declBareLocals gctx [] acc = acc
declBareLocals gctx ((DAttrib _ d) :: rest) acc =
  declBareLocals gctx rest (declBareLocals gctx [d] acc)
declBareLocals gctx ((DUse _ path _) :: rest) acc =
  declBareLocals gctx rest (formBareLocals gctx path acc)
declBareLocals gctx (_ :: rest) acc = declBareLocals gctx rest acc

-- one form's contribution.  `None` is the wildcard `import m.*`, which binds every export
-- of `m` under its own name; a module alias (`Some []`) and a member alias
-- (`{size as sz}`, whose local is `sz`) bind under a different spelling and so contribute
-- that spelling, not `size`.  Each contribution is intersected with what the dependency
-- actually EXPORTS AS A STANDALONE — S1's second conjunct, stated on
-- `depExportsStandalone` below.
formBareLocals : GraphCtx -> UsePath -> BareLocals -> BareLocals
formBareLocals gctx path acc =
  let depId = useModId path
  match importedBindings path
    None =>
      if depExportsUnknown gctx depId then
        { acc | blAll = True }
      else
        { acc | blSet = map fst (graphPubDefiners gctx depId) ++ acc.blSet }
    Some bindings => { acc |
      blSet =
        filterList (l => depExportsStandalone gctx depId l) (map snd bindings)
          ++ acc.blSet,
    }

-- the BARE interface-method name a (possibly mangled) standalone-shadow symbol stands for.
-- Identity on the un-mangled run/check path, where the map is empty.
shadowBareName : List (String, String) -> String -> String
shadowBareName sm n = match lookupAssoc n sm
  Some bare => bare
  None => n

-- typecheck one module (seeded like checkModuleFull) AND immediately stamp the
-- EMethodAt route refs it just recorded.  `recordModuleStart` marks the goal channel
-- before inference, so on return the module's window holds exactly THIS module's
-- sites; the tyvar cells are still bound (the next module's `freshModuleCtx` hasn't run
-- yet), so resolveSites reads each site's resolved result type.
-- E4: ALSO stamp this module's ARG-position sites
-- (the `GKArgStamp` goals in the same window) from their now-
-- resolved discriminating-argument monos — the multi-module analogue of
-- the shared `resolveArgStamps`. [implDecls] is core + every earlier module +
-- this module, so a cross-module parametric `requires` element dict resolves; a
-- still-unresolvable case stays RNone (arg-tag fallback).  activeDictVars (the
-- constraint-var → dict-param map registerConstraintRegs built in checkModuleFull)
-- is also still bound, so a tyvar receiver routes RDict.
elabModuleStamp : ModuleCtx ->
  String ->
  List (String, Scheme) ->
  List Decl ->
  List Decl ->
  List Decl ->
  (ModuleBindings, List Decl, ModuleCtx)
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
elabModuleStamp prev mid seedVars accData implDecls prog =
  -- Stampers execute after graph inference via `drainStampQueue`, not here.
  -- See `StampCtx` and `moduleStampOrder` for the replay mechanism.
  checkModuleFullImpl
    prev.mcGraph
    (checkRunResidue prev)
    mid
    (plainModuleSeed seedVars)
    accData
    implDecls
    prog

-- USER modules do NOT come through `elabModuleStamp`: `graphModuleWorker` runs
-- `checkModuleFullDiags` for them on both selections, so a user module's
-- constructor/match ORACLE is seeded from its own decls and `runFinalChecks`
-- (coherence, interface cycles, phantom methods, super impls) runs, identically for
-- `check` and for `build`.  The CORE pass stays here: neither selection runs
-- `checkModuleFullDiags` over the prelude, so seeding an oracle from core or running
-- coherence over it would be a new population, not a shared one.
-- DRIVER-COLLAPSE Phase 2: pass the return-position method names (was `[]`) so
-- resolveSite's RDict-case routes a RETURN-position method site RDictFwd (forward the
-- enclosing dict's nested reqs) rather than RDict (arg-position). The former path
-- passes `returnPosMethodNames prog2`; the empty list mis-stamped a parametric-impl
-- body's inner return-position method (`impl Default (List a) requires Default a where
-- def = [def]` — the inner `def` must be RDictFwd:$dict_def_0, not RDict) → eval
-- `no matching impl for dispatch` (nested_instance_dicts).  `implDecls` is this
-- module's full impl universe (core/earlier-modules ++ prog), the analogue of flat's
-- whole-program `prog2`.

-- Phase 151 / Gap G: stamp this module's comparison-operator binop sites.
-- ungated (preserving the former path's call to `resolveBinopSites`
-- unconditionally) so the EVAL path also dispatches `==`/`<`/… to user/derived
-- Eq/Ord impls (adt_deriving_ord / record_deriving_ord).  No-op when
-- pendingBinopSites is empty (no comparison-operator site) → golden type-only
-- path leaves them RNone → dictPass-skipped → byte-identical.  Gap #21: binop route
-- stamping emits `RKey key []` (empty element reqs), which only narrows the method
-- VMulti and applies ZERO dicts,
-- so even a RECURSIVE user Eq impl (json's `impl Eq Json`) dispatches inner
-- operands by arg-tag without over-applying — no suppression needed.

-- C5: LAST among the route-stampers (after resolveSites AND resolveArgStamps) so the
-- receiver-grounded RLocal/RNone overrides whatever those stamped on the SAME ref —
-- resolveSites mis-stamps RKey<resultType> (eval path) and resolveArgStamps stamps
-- RKey<receiverHead> (emit path), both wrong for a standalone-shadow site.

-- E6: fill THIS module's `=>`-constrained-fn EDictAt routes (the call sites
-- prePassDictArg marked) so the emitter supplies the matching dict ARGUMENT —
-- realizeRecDictApps for self/mutually-recursive calls, resolveDictApps for the
-- normal ones.  ARGSTAMP-UNIFY Phase 4: unconditional on BOTH paths — the eval path
-- also marks the RETURN-position constrained fns (sum/product/when/unless) EDictAt
-- via moduleDictNames, so their call-site routes must resolve here too.  No-op when
-- nothing was marked (pendingDictApps/pendingRecDictApps empty → golden drivers
-- byte-identical).

-- G7: fill each foldMap-style method occurrence's methRoutes from the monos its
-- `Monoid m` constraint resolved to at the call site (List vs String), so the
-- default's entry receives the right per-call method dictionary.
-- Independent of the body-side dict routing (the emitter restamps the body's
-- cross-interface `empty` to its `$dict_<method>_<slot>` param directly).
-- ARGSTAMP-UNIFY Phase 4: run unconditionally on every path (single elaboration
-- mode), preserving the former path (which
-- calls resolveMethodDicts unconditionally) — a method with its OWN method-level
-- constraint (`build : Num e => e -> t`) needs its method-dict route filled so its
-- impl clause binds the leading dict param instead of mis-binding it into the first
-- value param (method_constraint_impl_offset: was `non-exhaustive match`).  No-op
-- when pendingMethodDicts is empty → golden drivers byte-identical.

-- THE stamper order, run once per module by `drainStampQueue`.
moduleStampOrder : List StampStep
moduleStampOrder = [
  SSNumlitFloats,
  SSReturnSites,
  SSBinopSites,
  SSUnopSites,
  SSArithSites,
  SSArgStamps,
  SSRLocalSites,
  SSRecDictApps,
  SSDictApps,
  SSMethodDicts,
]

-- Whether a finding at [loc] is live: it is located, at one of [live]'s spans.
export
isLiveSpan : OrdMap Unit -> Option Loc -> Bool
isLiveSpan _ None = False
isLiveSpan live loc = omHasKey (locKey loc) live

-- [stamp] is the record the drain entered for [ctx].
runStampSteps : ModuleCtx -> StampCtx -> List StampStep -> Unit
runStampSteps stamp ctx steps = each (runStampStep stamp ctx) steps

runStampStep : ModuleCtx -> StampCtx -> StampStep -> Unit
runStampStep mctx ctx SSNumlitFloats = setNumlitFloatsGo ctx.scNumlits
runStampStep stamp ctx SSReturnSites =
  let rpNames = omFromNames ctx.scRpNames omEmpty
  stampEach
    stamp
    (sx o => resolveSites sx rpNames (siteEntry o))
    GKReturnSite
    ctx
runStampStep stamp ctx SSBinopSites =
  stampEach stamp (sx o => resolveOpSites sx True (siteEntry o)) GKBinopSite ctx
runStampStep stamp ctx SSUnopSites =
  stampEach stamp (sx o => resolveOpSites sx False (siteEntry o)) GKUnopSite ctx
runStampStep stamp ctx SSArithSites =
  stampEach stamp (_ o => resolveArithSites (arithEntry o)) GKArithSite ctx
runStampStep stamp ctx SSArgStamps =
  stampEach stamp (sx o => resolveArgStamps sx (siteEntry o)) GKArgStamp ctx
runStampStep stamp ctx SSRLocalSites =
  stampEach stamp (sx o => resolveRLocalSites sx (siteEntry o)) GKRLocalSite ctx
runStampStep stamp ctx SSRecDictApps =
  stampEach
    stamp
    (sx o => realizeRecDictApps sx (recDictAppEntry o))
    GKRecDictApp
    ctx
runStampStep stamp ctx SSDictApps =
  stampEach stamp (sx o => resolveDictApps sx (dictAppEntry o)) GKDictApp ctx
runStampStep stamp ctx SSMethodDicts =
  stampEach
    stamp
    (sx o => resolveMethodDicts sx (methodDictEntry o))
    GKMethodDict
    ctx

-- Stamps [ctx]'s goals of kind [k] one at a time, in channel order, and ORs what
-- each stamp noted below its destination's top level into that goal's `oInner`.
stampEach : ModuleCtx ->
  (SiteCtx -> Obligation -> Unit) ->
  GoalKind ->
  StampCtx ->
  Unit
stampEach stamp resolve k ctx =
  fold (_ o => stampNoting stamp resolve o) () (goalsOfKindIn k ctx.scGoals)

-- #2548 (ARCH M3/Q2, DICT §6.2 T4): ONE ordered resolve pass over the whole graph,
-- at quiescence.  Every module's goals are stamped after every module has been
-- inferred, so a goal in an early module is decided against the final solution
-- rather than against the solution as it stood when that module closed.
--
-- The per-module context is REPLAYED, not re-derived (see `StampCtx`), and restored
-- afterwards so `dictPassModulesIfEnabled` — which runs next — sees the state the
-- last module left, exactly as it does today.
-- #2705: the drain at the core pass's freeze (`checkCoreMemoized`), at a recording
-- module's end and at a keyed drive's graph end (`diagsServe`).  Nothing is
-- published: a check driver has no reader of the evidence table.
--
-- The sticky type-error cells are saved before the drain and restored after it, so
-- a recorded interface never carries a drain's diagnostics.  An unkeyed drive
-- (`driveGraphK`) keeps them instead; the two agree because the drain raises none on
-- an accepted program.  The drain's evidence holes are returned, not recorded: a
-- per-module diagnostics list is closed before any drain, so the caller attaches
-- them to it (`attachEvidenceHoles`).
checkGraphFinish : ModuleCtx -> List DrainFinding
checkGraphFinish mctx =
  let savedSticky = mctx.mcGraph.typeErrorsSticky.value
  let savedStickyDiags = mctx.mcGraph.typeErrorsStickyDiags.value
  let holes = drainStampQueue mctx
  mctx.mcGraph.typeErrorsSticky := savedSticky
  mctx.mcGraph.typeErrorsStickyDiags := savedStickyDiags
  holes

verdictFinding : String -> Bool -> TcDiag -> DrainFinding
verdictFinding mid live d = DrainFinding {
  dfModule = mid,
  dfDiag = d,
  dfVerdict = True,
  dfLive = live,
}

-- What [act] records in the type-error channel of [mctx], the current record, taken
-- back out of it and out of the sticky one: a drain runs after every module's
-- diagnostics list closed, so its caller attaches them (`attachDrainFindings`).  The
-- dedup state [act] reads and writes stays, so a verdict the module already reported is
-- not repeated.
captureTypeErrors : ModuleCtx -> (Unit -> Unit) -> List TcDiag
captureTypeErrors mctx act =
  let w = mctx.mcCells.typeErrors
  let items = w.items.value
  let mark = wMark w
  let sticky = mctx.mcGraph.typeErrorsSticky.value
  let stickyDiags = mctx.mcGraph.typeErrorsStickyDiags.value
  let _ = act ()
  let added = wWindow w mark
  w.items := items
  w.n := mark
  mctx.mcGraph.typeErrorsSticky := sticky
  mctx.mcGraph.typeErrorsStickyDiags := stickyDiags
  reverseL added

-- Runs every queued stamping context, then judges the evidence they finished.
-- Returns the verdicts the drain decides (held live-root goals, admitted-set
-- occurrences) and one `T-UNROUTED-DISPATCH` per hole, each under its module.
-- [saved] is the record the drain begins with; each stamp context's walk runs in the
-- record the drain enters for it (`enterStampCtx`).
drainStampQueue : ModuleCtx -> List DrainFinding
drainStampQueue saved =
  let ctxs = reverseL saved.mcGraph.graphRun.stampCtxs.value
  let _ = defaultLiveNumRoots saved
  let held = judgeLiveGoals saved ctxs
  let verdicts = runStampCtxs saved ctxs
  let liveLocs = omFromNames (flatMap (c => c.scLiveLocs) ctxs) omEmpty
  let holes =
    map
      ((mid, d) => DrainFinding {
        dfModule = mid,
        dfDiag = d,
        dfVerdict = False,
        dfLive = isLiveSpan liveLocs (tcLoc d),
      })
      (judgeEvidence saved.mcGraph ctxs)
  let _ = materializeBinderTypes saved.mcGraph ()
  saved.mcGraph.graphRun.stampCtxs := []
  held ++ verdicts ++ holes

-- The completeness judgment (`types/evidence_complete.mdk`) over the evidence this
-- drain finished: every method cell minted since the last drain, and the goals of
-- [ctxs] whose destination is not a method cell.  A return-site, arg-stamp or
-- RLocal goal writes its cell's dispatch route and a method-dict goal its method
-- dictionaries, so those are judged once, as the cell.
judgeEvidence : GraphCtx -> List StampCtx -> List (String, TcDiag)
judgeEvidence gctx ctxs =
  let g = gctx.graphRun
  let lo = g.evJudged.value
  g.evJudged := g.evCounter.value
  let base = g.evBase
  let cellHoles =
    flatMap
      ((a, b) => judgeCells g.evCells.value (a - base) (b - base) [])
      (unjudgedRanges lo g.evCounter.value g.evScopedJudged.value)
  let goalHoles = flatMap (c => flatMap (judgeGoal c.scModule) c.scGoals) ctxs
  dedupBy holeKey (cellHoles ++ goalHoles)

holeKey : (String, TcDiag) -> String
holeKey (m, TcDiag _ _ loc msg _ _) =
  "\{lenKey m}\{lenKey (locGoalKey loc)}\{msg}"

-- The cells in slots [i, hi) (ordinals less `evBase`), last first onto [acc].  A
-- cell no inference reached (no arity) carries no answer to judge.
judgeCells : Array (Option EvCell) ->
  Int ->
  Int ->
  List (String, TcDiag) ->
  List (String, TcDiag)
judgeCells arr i hi acc
  | i >= hi || i >= arrayLength arr = acc
  | otherwise = match arrayGetUnsafe i arr
    Some c => match c.ecArity.value
      Some _ =>
        let row =
          OccurrenceRow
            c.ecName.value
            c.ecIface.value
            c.ecTag.value
            c.ecImpl.value
            c.ecMeth.value
        judgeCells
          arr
          (i + 1)
          hi
          (holeDiags (evIdModule c.ecId) c.ecLoc.value c.ecInner.value row
            ++ acc)
      None => judgeCells arr (i + 1) hi acc
    None => judgeCells arr (i + 1) hi acc

evIdModule : EvId -> String
evIdModule (EvId m _) = m

judgeGoal : String -> Obligation -> List (String, TcDiag)
judgeGoal mid o = match (o.oPayload, evValueOf o.oDest)
  (GPDictApp app, EvMany rs) =>
    holeDiags
      mid
      o.oLoc
      o.oInner.value
      (DictAppRow app.pdaCallee (map (r => r.irName) app.pdaIfaces) rs)
  (GPRecDictApp (RecDictApp _ callee _ _ _ _), EvMany rs) =>
    holeDiags mid o.oLoc o.oInner.value (DictAppRow callee [] rs)
  (GPArith _, EvOne r) => holeDiags mid o.oLoc o.oInner.value (SiteRow r)
  (GPSite _ _ _, EvOne r) =>
    if goalKindTag o.oKind == goalKindTag GKBinopSite
      || goalKindTag o.oKind == goalKindTag GKUnopSite then
      holeDiags mid o.oLoc o.oInner.value (SiteRow r)
    else
      []
  _ => []

holeDiags : String ->
  Option Loc ->
  Inner ->
  EvidenceRow ->
  List (String, TcDiag)
holeDiags mid loc inner row = match rowHoleWith inner row
  None => []
  Some (_, msg) => [(mid, TcDiag "T-UNROUTED-DISPATCH" 1 loc msg None None)]

-- Each drain verdict joins the errors of the module it belongs to, and each hole
-- does unless that module then has errors: a hole beside a type error is usually its
-- consequence.  A live finding is dropped when any module of [perMod] has errors,
-- since the live root it rests on may be one an erroneous importer grounded or left
-- open.  A finding in no module of [perMod] is a module the drive has no list for,
-- which only the prelude is.
attachDrainFindings : List DrainFinding -> List ModDiags -> List ModDiags
attachDrainFindings [] perMod = perMod
attachDrainFindings findings perMod =
  let orphans =
    filterList (f => not (anyList (pm => fst pm == f.dfModule) perMod)) findings
  let _ = match orphans
    [] => ()
    f :: _ =>
      panic
        "evidence hole in module `\{f.dfModule}`, which has no diagnostics list: \{tcMsg f.dfDiag}"
  let erred = anyList (pm => isNonEmptyL (modDiagErrs pm)) perMod
  let kept = if erred then filterList (f => not f.dfLive) findings else findings
  map (pm => findingsOnto kept pm) perMod

modDiagErrs : ModDiags -> List TcDiag
modDiagErrs (_, (_, errs, _)) = errs

findingsOnto : List DrainFinding -> ModDiags -> ModDiags
findingsOnto findings (mid, (schemes, errs, warns)) =
  let mine = filterList (f => f.dfModule == mid) findings
  let verdicts = map (f => f.dfDiag) (filterList (f => f.dfVerdict) mine)
  match errs ++ verdicts
    [] => (mid, (schemes, map (f => f.dfDiag) mine, warns))
    all => (mid, (schemes, all, warns))

-- Read every queued binder's type cell into the graph's runtime-type table, now
-- that the stampers have run and nothing left in the graph can refine a drained
-- module's types.  Runs at every drain, including the one before a memo snapshot,
-- so a snapshot carries only materialized rows.
materializeBinderTypes : GraphCtx -> Unit -> Unit
materializeBinderTypes gctx _ =
  let g = gctx.graphRun
  match g.binderPending.value
    [] => ()
    pending =>
      let cells = cellTypeHeads gctx.declEnvsRef.value.deAllDecls
      let isCell = n o => omHasKey (cellHeadKey n o) cells
      g.binderRows :=
        fold
          (acc p => addBinderRow (materializeBinder isCell p) acc)
          g.binderRows.value
          (reverseL pending)
      g.binderPending := []

materializeBinder : (String -> TyConOrigin -> Bool) ->
  PendingBinder ->
  BinderRow
materializeBinder isCell (PendingBinder bid name t arity signed) = BinderRow {
  brId = bid,
  brName = name,
  brType = runtimeTypeOf isCell t,
  -- A solved type with fewer arrows than the declared parameters fixes nothing.
  brReturns =
    map
      (n =>
        optionOr RTValue (map (runtimeTypeOf isCell) (resultAfterArrows n t)))
      arity,
  brSigned = signed,
}

-- The type heads whose values are constructor cells: every `data` and `newtype`
-- declaration in the graph except an `extern data` one, keyed by identity.
cellTypeHeads : List Decl -> OrdMap Unit
cellTypeHeads decls = fold (acc d => addCellHead d acc) omEmpty decls

addCellHead : Decl -> OrdMap Unit -> OrdMap Unit
addCellHead (DData { dataName = n, dataOrigin = o, dataExtern = ext, ... }) acc =
  if ext then acc else omInsert (cellHeadKey n o) () acc
addCellHead (DNewtype { newtypeName = n, newtypeOrigin = o, ... }) acc =
  omInsert (cellHeadKey n o) () acc
addCellHead (DAttrib _ d) acc = addCellHead d acc
addCellHead _ acc = acc

cellHeadKey : String -> TyConOrigin -> String
cellHeadKey n OriginBuiltin = "builtin|\{n}"
cellHeadKey n OriginUnresolved = "unresolved|\{n}"
cellHeadKey n (OriginModule m) = "module \{m}|\{n}"

-- Stamps each context in turn and decides its admitted-set occurrences
-- (`checkAdmittedOccObls`), with the selector their routes commit through, against
-- the same final solution.
runStampCtxs : ModuleCtx -> List StampCtx -> List DrainFinding
runStampCtxs saved ctxs =
  reverseL (fold (acc ctx => reverseL (runStampCtx saved ctx) ++ acc) [] ctxs)

runStampCtx : ModuleCtx -> StampCtx -> List DrainFinding
runStampCtx saved ctx =
  let stamp = enterStampCtx saved ctx
  let _ = refileDeterminedRows stamp ()
  let _ = runStampSteps stamp ctx moduleStampOrder
  let _ = recordEvidence saved.mcGraph ctx.scGoals
  let liveSpans = omFromNames ctx.scLiveLocs omEmpty
  map
    (d => verdictFinding ctx.scModule (isLiveSpan liveSpans (tcLoc d)) d)
    (captureTypeErrors stamp (_ => checkAdmittedOccObls stamp ()))

-- #2549 M2: publish this module's solved evidence, AFTER its stampers have run and
-- READ BACK OUT OF THE CELLS THEY WROTE.  Deriving the table any other way would make
-- it a second answer that can disagree with the cells; derived this way it cannot.
recordEvidence : GraphCtx -> List Obligation -> Unit
recordEvidence gctx gs =
  let g = gctx.graphRun
  let _ = map (noteEvidenceObservation gctx) gs
  g.evTable := evEntriesOf gs ++ g.evTable.value

evEntriesOf : List Obligation -> EvTable
evEntriesOf gs = map (o => EvEntry o.oEv (evValueOf o.oDest)) gs

evValueOf : EvDest -> EvVal
evValueOf (EvRoute r) = EvOne !r
evValueOf (EvRoutes rs) = EvMany !rs

-- Writes `mangledShadowMapRef`, `argDispatchIdxByIdRef` and `markSetsRef` as a side
-- effect: the first two are read by the inference of a marked tree (P0-18 shadow
-- recovery, `argDispatchOf`), the third by `checkBodyImpl`, which marks each module's
-- groups on the schedule — so the driver that marks must be the driver that sets
-- them.  Empty / index-only on the un-mangled check path, exactly as the emit path
-- derives them.  `markSetsOf` below is the function; unkeyed, its prelude half is
-- `preludeMarkFactsOf coreDecls`.

preludeMarkFactsOf : List Decl -> PreludeMarkFacts
preludeMarkFactsOf coreDecls = PreludeMarkFacts {
  pmfReturnPos = returnPosMethodNames coreDecls,
  pmfMethodConstraints = methodConstraintNames coreDecls,
  pmfArgDispatch = argDispatchIndices coreDecls,
  pmfArgDispatchById = argDispatchIndicesById coreDecls,
  pmfConstrainedNames = constrainedSigNames coreDecls,
}

-- `allDecls` IS `coreDecls ++ flatMap snd modules` -- the envelope's
-- `deAllDecls`, see `declEnvDeclsOf` -- and every list split on that seam here is
-- a `flatMap` over decls (`returnPosMethodNames`, `methodConstraintNames`,
-- `argDispatchIndices`, `argDispatchIndicesById`), so `f (xs ++ ys)` is
-- `f xs ++ f ys` for each.  That is what makes the prelude half separable WITHOUT
-- changing the order any of them produces, and the order is observable: `dedup`
-- keeps the first occurrence.
markSetsOf : GraphCtx ->
  PreludeMarkFacts ->
  List Decl ->
  List (String, List Decl) ->
  List Decl ->
  MarkSets
markSetsOf gctx pmf coreDecls modules allDecls =
  -- P0-18: recover the definer-shadow map from the (already-mangled on the emit path)
  -- decls BEFORE marking/typecheck reads it.  Empty on the un-mangled path.  Set once
  -- here; per-module `freshModuleCtx` (in checkModuleFullImpl) does NOT clear it.
  let units = ("core", coreDecls) :: modules
  let userDecls = flatMap snd modules
  let shadowMap = computeMangledShadowMap allDecls units
  gctx.mangledShadowMapRef := shadowMap
  gctx.argDispatchIdxByIdRef :=
    pmf.pmfArgDispatchById ++ argDispatchIndicesById userDecls
  let rpNames = pmf.pmfReturnPos ++ returnPosMethodNames userDecls
  let markSharedNames =
    dedup
      (rpNames ++ pmf.pmfMethodConstraints ++ methodConstraintNames userDecls)
  let graphShadowNames =
    buildStandaloneShadowsGraph shadowMap allDecls userDecls
  let ms = MarkSets {
    msMarkRpNames = dedup (markSharedNames ++ graphShadowNames),
    msMarkSharedNames = markSharedNames,
    msGraphShadowNames = graphShadowNames,
    msArgNames = map fst (pmf.pmfArgDispatch ++ argDispatchIndices userDecls),
    msCoreShadowMap = coreShadowMapFor gctx coreDecls shadowMap,
    msBareDictNames = dedup (moduleDictNames pmf.pmfConstrainedNames modules),
    msUnits = units,
  }
  gctx.markSetsRef := Some ms
  ms

-- The dict-name set `dictPass` consumes: [names] (the bare set plus every promotion
-- the graph made) and its import aliases across every module.  The same names, per
-- module, are what `beginModuleMarking` marked with — the def side and the call side
-- must agree on this set or the callee is under-applied (`unbound identifier:
-- $dict_…`, the Phase-134 shape).
--
-- IMPORT ALIASING: the marker rewrites a call site `EVar n` into a dict application
-- only when `n` is in the dict-name set — a set of DEFINITION names.  An aliased call
-- site writes the LOCAL name, so unless the alias locals are added the call is never
-- marked, receives no dict arguments, and silently UNDER-APPLIES: `check` stays
-- green and `run` dies downstream with a type-confused value.
markDictNames : GraphCtx ->
  List String ->
  List Decl ->
  List (String, List Decl) ->
  List String
markDictNames gctx names coreDecls modules =
  dedup
    (names
      ++ aliasDictNames gctx names (("core", coreDecls) :: modules) modules)

-- Install the module's marking state at module start.  Reads the graph's mark sets
-- off the driver preamble; a Module arm reached without one is a driver bug, and
-- fails loud rather than marking nothing.
beginModuleMarking : ModuleCtx ->
  String ->
  List Decl ->
  OrdMap Int ->
  ModuleSeed ->
  Unit
beginModuleMarking mctx mid prog top seed =
  let ms = match mctx.mcGraph.markSetsRef.value
    Some s => s
    None =>
      panic
        "checkBodyImpl: Module arm entered with no mark sets (no driver preamble ran)"
  -- Core imports nothing, so the dict names nameable in it are its own `=>`
  -- signatures, the set its `dictPass` gives parameters to.  A user definition that
  -- shares a bare name with a core one is a different definition.
  let known = match mid
    "" => constrainedSigNames prog
    _ => dedup (ms.msBareDictNames ++ mctx.mcGraph.promotionHarvestRef.value)
  let aliases = aliasDictNames mctx.mcGraph known ms.msUnits [(mid, prog)]
  mctx.mcGraph.graphRun.localAbs.lasNext := (mid, 0)
  mctx.mcGraph.graphRun.localAbs.lasMinted := []
  mctx.mcCells.markingRef := Some ModuleMarking {
    mmCtx = moduleMarkCtx mctx.mcGraph ms mid prog seed.msImportedValues,
    mmTop = top,
    mmDictSet = Ref (omFromNames (known ++ aliases) omEmpty),
    mmUserNames = omFromNames (declTopFnNames prog) seed.msImportedNames,
    mmExterns = omFromNames (declExternNames prog) seed.msImportedExterns,
  }

-- Mark one binding group's clauses (in the stored, newest-first order the map keeps)
-- with the dict-name set as it stands when the schedule reaches the group.  A use
-- of a member, or of a name whose scheme in [env] quantifies an authority, is
-- given a grant identity: a member's scheme is not known until the group closes.
markGroupClauses : ModuleMarking ->
  TcEnv ->
  List String ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
markGroupClauses mm env members grouped =
  let own = omFromNames members omEmpty
  mapGroupClauses
    (markClauseWith
      env.teDyn.dcModule
      (argRwOf mm.mmCtx mm.mmDictSet.value noDictHook (n =>
        omHasKey n own || grantNameIn env n)))
    members
    grouped

-- The stamped twin of the group's marked clauses — what inference reads.  Binding
-- ids are minted over the module's declaration heads (`stampTopScope`), so stamping
-- one group at a time yields the ids `stampBindingIds` would have.
stampGroupClauses : ModuleMarking ->
  List String ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
stampGroupClauses mm members grouped =
  mapGroupClauses (stampClauseWith mm.mmTop) members grouped

mapGroupClauses : ((List Pat, Expr) -> (List Pat, Expr)) ->
  List String ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
-- The map keeps a name's clauses newest-first (`groupClausesGo`); `f` is applied in
-- SOURCE order (`clausesOf`) so the evidence ids it mints follow the source, and the
-- result is stored back in the map's own order.
mapGroupClauses _ [] grouped = grouped
mapGroupClauses f (m :: rest) grouped =
  mapGroupClauses
    f
    rest
    (omInsert m (revClauses (map f (clausesOf m grouped)) []) grouped)

-- At group close: the members this group promoted join the dict-name set, and the
-- group's own occurrences of them — the recursive calls, which were still `EVar`
-- when the group was marked because their callee had not generalized — become
-- dict applications.  Each carries the goal `inferDictAtFound`'s recursive arm
-- pushes for a callee that is a placeholder of the current group (`RecDictApp`,
-- realized at the graph-end drain against the callee's now-registered slots): the
-- callee's placeholder mono is the occurrence's instantiated type, the enclosing
-- member is the clause's own.  That arm is the ONLY effect the recursive arm has
-- beyond returning the instantiated type, which the `EVar` path returned too, so
-- rewriting after inference leaves the group's inference unchanged.
markRecursiveOccurrences : ModuleCtx ->
  ModuleMarking ->
  List (String, Mono) ->
  List ScopedMember ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
markRecursiveOccurrences mctx mm placeholders scopedMembers grouped =
  -- `promotedRef` is this module's promoted names so far (cumulative within the
  -- module); a member already in the dict-name set — a bare-name collision with a
  -- signatured graph name or an earlier module's promotion — was marked before
  -- inference and needs nothing here.
  let promoted = omFromNames mctx.mcCells.promotedRef.value omEmpty
  let fresh =
    filterList
      (m => omHasKey m promoted && not (omHasKey m mm.mmDictSet.value))
      (map (member => member.smName) scopedMembers)
  match fresh
    [] => grouped
    _ =>
      mm.mmDictSet := omFromNames fresh mm.mmDictSet.value
      recMarkMembers
        mctx
        (omFromNames fresh omEmpty)
        placeholders
        scopedMembers
        grouped

recMarkMembers : ModuleCtx ->
  OrdMap Unit ->
  List (String, Mono) ->
  List ScopedMember ->
  OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr))
recMarkMembers mctx _ _ [] grouped = grouped
recMarkMembers mctx dn placeholders (member :: rest) grouped =
  let m = member.smName
  let onDict =
    callee ev =>
      pushRecDictAppGoal
        mctx.mcGraph
        (RecDictApp
          (Ref [])
          callee
          m
          (placeholderMonoOf callee placeholders)
          member.smScope
          ev)
  let rw = ArgRw omEmpty dn omEmpty [] onDict (_ => False)
  recMarkMembers
    mctx
    dn
    placeholders
    rest
    (mapGroupClauses (markClauseWith mctx rw) [m] grouped)

placeholderMonoOf : String -> List (String, Mono) -> Mono
placeholderMonoOf callee placeholders = match lookupAssoc callee placeholders
  Some v => v
  None =>
    panic "markRecursiveOccurrences: \{callee} is not a member of the group"

-- The module's marked tree: its binding groups' marked clauses written back into the
-- declarations in source order, then the remaining bodies (impl, default, prop,
-- test) marked with the module's final dict-name set — they are inferred
-- after every group, so every promotion the module made is in the set by then.
finishModuleMarking : ModuleMarking ->
  TcEnv ->
  OrdMap (List (List Pat, Expr)) ->
  List Decl ->
  List Decl
finishModuleMarking mm env grouped prog =
  markTailDecls
    env.teDyn.dcModule
    mm.mmCtx
    mm.mmDictSet.value
    (grantNameIn env)
    (rebuildGroupDecls grouped prog)

-- The stamped twin of the tail declarations, for their inference; binding groups
-- were stamped as the schedule reached them and are not walked again.
stampTailDecls : OrdMap Int -> List Decl -> List Decl
stampTailDecls top decls = map (stampTailDecl top) decls

stampTailDecl : OrdMap Int -> Decl -> Decl
stampTailDecl _ (d@(DFunDef _ _ _ _ _ _)) = d
stampTailDecl _ (d@(DLetGroup _ _)) = d
stampTailDecl top (DAttrib attrs d) = DAttrib attrs (stampTailDecl top d)
stampTailDecl top d = stampDeclWith top d

-- Write each group's marked clauses back over the declarations that produced them.
-- `funDefs` flattens `DFunDef` clauses and `DLetGroup` bindings in declaration
-- order and `clausesOf` returns a name's clauses in that order, so consuming them
-- head-first as the declarations are walked restores every clause to its own slot.
-- The arms below are `funDefs`' arms, and must stay that set: a declaration shape
-- `funDefs` collects clauses from but this walk passes through would drop those
-- clauses' marks from the returned tree without a panic (the reverse direction
-- panics in `popMarkedClause`).
rebuildGroupDecls : OrdMap (List (List Pat, Expr)) -> List Decl -> List Decl
rebuildGroupDecls grouped prog = fst (rebuildGroupDeclsGo grouped omEmpty prog)

rebuildGroupDeclsGo : OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr)) ->
  List Decl ->
  (List Decl, OrdMap (List (List Pat, Expr)))
rebuildGroupDeclsGo _ pending [] = ([], pending)
rebuildGroupDeclsGo grouped pending ((DFunDef pub n _ _ site bid) :: rest) =
  let ((ps, e), pending2) = popMarkedClause grouped pending n
  let (ds, pending3) = rebuildGroupDeclsGo grouped pending2 rest
  (DFunDef pub n ps e site bid :: ds, pending3)
rebuildGroupDeclsGo grouped pending ((DLetGroup pub binds) :: rest) =
  let (binds2, pending2) = rebuildLetBinds grouped pending binds
  let (ds, pending3) = rebuildGroupDeclsGo grouped pending2 rest
  (DLetGroup pub binds2 :: ds, pending3)
rebuildGroupDeclsGo grouped pending ((DAttrib attrs d) :: rest) =
  let (inner, pending2) = rebuildGroupDeclsGo grouped pending [d]
  let (ds, pending3) = rebuildGroupDeclsGo grouped pending2 rest
  (map (d2 => DAttrib attrs d2) inner ++ ds, pending3)
rebuildGroupDeclsGo grouped pending (d :: rest) =
  let (ds, pending2) = rebuildGroupDeclsGo grouped pending rest
  (d :: ds, pending2)

rebuildLetBinds : OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr)) ->
  List LetBind ->
  (List LetBind, OrdMap (List (List Pat, Expr)))
rebuildLetBinds _ pending [] = ([], pending)
rebuildLetBinds grouped pending ((LetBind n clauses site bid) :: rest) =
  let (clauses2, pending2) = rebuildFunClauses grouped pending n clauses
  let (binds, pending3) = rebuildLetBinds grouped pending2 rest
  (LetBind n clauses2 site bid :: binds, pending3)

rebuildFunClauses : OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr)) ->
  String ->
  List FunClause ->
  (List FunClause, OrdMap (List (List Pat, Expr)))
rebuildFunClauses _ pending _ [] = ([], pending)
rebuildFunClauses grouped pending n (_ :: rest) =
  let ((ps, e), pending2) = popMarkedClause grouped pending n
  let (cs, pending3) = rebuildFunClauses grouped pending2 n rest
  (FunClause ps e :: cs, pending3)

-- The next unconsumed marked clause of [n]: `pending` holds the clauses not yet
-- written back, in source order, minted from `clausesOf` on first use.
popMarkedClause : OrdMap (List (List Pat, Expr)) ->
  OrdMap (List (List Pat, Expr)) ->
  String ->
  ((List Pat, Expr), OrdMap (List (List Pat, Expr)))
popMarkedClause grouped pending n =
  let remaining = match omLookup n pending
    Some cs => cs
    None => clausesOf n grouped
  match remaining
    c :: cs => (c, omInsert n cs pending)
    [] => panic "rebuildGroupDecls: no marked clause left for \{n}"

export
schemeLines : List (String, PubScheme) -> List String
schemeLines [] = []
schemeLines ((n, p) :: rest) = "\{n} : \{ppPubScheme p}" :: schemeLines rest
