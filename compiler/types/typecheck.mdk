-- Stage A-2 unit A-2.2 (#1111): the head-tycon projections below return a key
-- that CAN carry identity.  `HeadKey`'s declaration half is A-2.3's `TabKey`
-- itself; why it has a second inhabitant anyway, and why the `Option` around
-- it stays, are derived at the type in that file.
import types.registry.{
  HeadKey(..),
  headKeyOfCon,
  headKeyName,
  -- A-2.13 (#1319 unit 3): the IDENTITY inside a projected head, for the one
  -- record lookup that selects a row by the receiver rather than by a spelling.
  headKeyIdent,
  -- A-2.2b (#1111): the dispatch-key layer.  `headBucketKey`/`RegKey` key the
  -- head-tycon buckets — ⚠️ by SPELLING, not by identity: this line said "by
  -- IDENTITY" until B-2.1-a3, and `dispHeadTab hk = TkBare NsType (headKeyName hk)`
  -- (the #1317 T1 rule, and the closed S0 #1277) says otherwise at the mint.  The
  -- head's identity rides inside the `HeadKey` VALUE; the KEY it is filed under is
  -- bare.  `dispKeyRender` renders a whole obligation ARGUMENT VECTOR, carrying its
  -- §8 I6.1 rigid positions in a separate group.
  RegKey,
  regKeyOfTab,
  regKeyNTab,
  regKeyRender,
  dispKeyRender,
  -- the three registry types the obligation impl universe is now built from.
  Registry,
  regEmpty,
  regInsertK,
  regLookupK,
  MultiRegistry,
  mregEmpty,
  mregAppendK,
  mregLookupK,
  SetRegistry,
  sregEmpty,
  sregAddK,
  sregSize,
}
-- B-2.2-e: THE route-word mint, shared with `eval/eval.mdk` and
-- `ir/core_ir_lower.mdk`.  Before this bite each of those spelled its own copy
-- (`implKeyTc` here, `implKeyOf` there) over its own `Ty` printer; they are now
-- one function, so the caller side and the definition side of the dict-word seam
-- agree BY CONSTRUCTION rather than by two mirrors staying in lockstep.
import types.route_key.{implRouteKeyWord, funHeadTag}

-- ── monotypes & schemes ───────────────────────────────────────────────────
public export data Mono =
  | TVar (Ref Tyvar)
  | TCon String TyConOrigin
  -- The GOAL-SIDE dispatch head, and the second field is #1110's module identity
  -- for it (DICT-SEMANTICS §8 I4's `(originModule, name)`).  Same three
  -- inhabitants as `Ty.TyCon`'s `tyConOrigin` and the four decl-layer carriers,
  -- for the reason `frontend/ast.mdk` gives at the type: the layers name the SAME
  -- fact, and a parallel ADT would buy a conversion at every seam relating a
  -- declaration to a head that spells it.
  --
  -- ⚠️ THIS FIELD IS READ, AND IT DECIDES ACCEPTANCE (#1111 Stage A-2 unit
  -- A-2.10).  It said "CARRIER ONLY — NOTHING READS IT YET, and no answer
  -- changes" until A-2.2b, then "IT IS READ, AND STILL NO ANSWER CHANGES" until
  -- this unit.  The first was already FALSE on `main` when it was written
  -- (`headTyconMono` read the field from A-2.2 onward), and a reviewer traced a
  -- shipped S0 to someone believing it — the retained `hd == Some hk` guard in
  -- `implExistsForHeadGo`, which compared an origin-carrying impl head against a
  -- frequently-origin-less goal head inside a bucket keyed by spelling, and so
  -- answered `False` wherever they differed.  The lesson survives both
  -- corrections and is worth more than either: a "nothing reads this" / "no
  -- answer changes" claim is a NEGATIVE ABOUT THE WHOLE FILE, it expires the
  -- moment any unit adds a reader, and no gate notices.
  --
  -- WHAT IS TRUE NOW, in the two halves A-2.2b separated (they are INDEPENDENT
  -- facts and collapsing them is what the wording above kept getting wrong):
  --
  --   * THE COMPARISONS READ IT AND ACCEPTANCE MOVED.  The six "are these the
  --     same type?" tests — `unifyN`, `cohGoR`, `cohStep`, `cohEqR`,
  --     `matchStep`, `monoSameGiven` — all read the field, all through the
  --     single seam `sameTyConHead` (`frontend/ast.mdk`), whose doc-comment owns
  --     the absent-origin rule and its derivation.  Two modules' same-named
  --     types no longer unify (#1208, #1209).
  --   * THE DISPATCH KEY STILL DOES NOT.  `headTyconMono`'s `TCon n o` arm hands
  --     `o` to `headKeyOfCon`, so every goal-side `HeadKey` CARRIES the
  --     identity — and every consumer of that `HeadKey` then projects it BACK to
  --     the bare spelling before comparing: `dispHeadTab` (the bucket key,
  --     `implExistsForHeadGo`'s retest, `countHeadGo` / `ieCountHeadByIfaceGo`,
  --     the obligation universes) or `headKeyName` / `headKeyNameOr` (the
  --     emitted route word).  `headTyconNameMono`, the name-only residual, still
  --     hands out a bare name outright.  (A-2.10's draft of this paragraph also
  --     named `monoHeadCon`; A-2.2b DELETED that projection on `main` — see its
  --     obituary above `mainTypeIsAsync` — and the merge of the two units is
  --     where that was caught.)  The discard is LEDGERED, not incidental:
  --     `dispHeadTab` IS the list of sites whose answer would move the day the
  --     goal side becomes supplied and canonical
  --     (`grep -nw dispHeadTab compiler/types/typecheck.mdk`).
  --
  -- 🚨 SO A LEDGERED RETEST IS STILL NOT AN IDENTITY COMPARISON, AND PROMOTING
  -- ONE AS A TIDY-UP STILL CHANGES ACCEPTANCE — that is exactly what A-2.2b did
  -- three times before review caught it, and A-2.10 narrowing the COMPARISONS
  -- does not license it on the DISPATCH side.  Derive the reader set rather than
  -- trusting this prose; the grep finds a reader whatever it is called:
  --
  --     grep -n TCon compiler/types/typecheck.mdk \
  --       | grep -vE '^[0-9]+:[[:space:]]*--' | grep -vE 'TCon [^ )]+ _'
  --
  -- 🚨 THE CONSTRUCTOR IS NEVER APPLIED OUTSIDE THE FOUR MINTS BELOW
  -- (`tconBuiltin` / `tconTupleHead` / `tconFrom` / `tconUnresolved`), and that is
  -- the property this widening rests on rather than "every construction site is
  -- individually right".  There is no stamping pass at this layer and no
  -- first-write immunity rule to lean on — `stampTyHead`'s filter protects the
  -- `Ty` layer only — so identity has to be correct AT CONSTRUCTION.  Funnelling
  -- every construction through four one-line helpers makes that four decisions,
  -- each named after the identity class it claims, and
  -- `test/typecheck_compiler_source.sh` pins the set.  Everything else that
  -- mentions `TCon` in this file is a PATTERN — most with `_` in the origin
  -- slot, and (since A-2.10) a set of them that BIND it.  The ratchet's own
  -- remedy predicted exactly that ("a pattern that legitimately BINDS the origin
  -- is the expected first false positive; list it, and the list stays the
  -- audit"), so THE BINDING SET IS ENUMERATED THERE AND THE ENUMERATION IS THE
  -- AUDIT.  Derive it, do not read it here:
  --
  --   sh test/typecheck_compiler_source.sh   # prints "N Mono.TCon mint(s) +
  --                                          # M origin-binding pattern(s)"
  --   grep -n 'mono_tcon_allowed' -A20 test/typecheck_compiler_source.sh
  --
  -- ⚠️ THIS PARAGRAPH SAID "SEVEN that BIND it: `headTyconMono` plus the six
  -- comparisons above" AND WAS WRONG BY ONE ON ITS FIRST DAY — it omitted
  -- `firstIdConflict` (the diagnostic-side reader that pairs the two conflicting
  -- identities so `Type mismatch: T vs T` can name both modules), which binds
  -- BOTH origins.  A count of the binding sites is an encoded fact with no
  -- derivation, and the number of PATTERN LINES is not even the number of
  -- FUNCTIONS (`cohStep` and `monoSameGiven` contribute two lines each), so the
  -- reader has to pick which is meant.  Do not re-describe this population with a
  -- rule of thumb — `_`-shaped or numeric.
  --
  -- ⚠️ AND NOTHING REBUILDS ONE FROM ITS NAME.  `substMono`/`substMonoP` (reached
  -- from `instantiate`, i.e. every use of every imported binding) used to answer
  -- `TCon n => TCon n`; they now return the MATCHED NODE, so preservation is
  -- structural rather than a per-site promise — and one allocation per head per
  -- instantiation goes away with it.  `unifyN`'s mismatch arms likewise hand
  -- `typeMismatch` the node they matched.
  | TRigid String
  -- A RIGID type variable: a head fabricated from a type-PARAMETER name, not
  -- from any declaration.  It has exactly two producers — `fromAstTypeE`'s
  -- `TyVar` fallback and `paramMonoOf` — and both mint it from a name the
  -- parser already routed through `TIdent` (`parseTyAtom`,
  -- `compiler/frontend/parser.mdk:2049`).
  --
  -- 🚨 THE NAMING RULE, STATED CORRECTLY — it is the safety argument for every
  -- consumer that does NOT carry a `TRigid` arm, so getting it wrong silently
  -- changes answers:
  --   * a RIGID name never starts with an UPPERCASE letter.  It is not
  --     necessarily lowercase: `identStartLower` (`frontend/lexer.mdk:1638`) is
  --     `isLower … || … == '_'`, so `_k`/`_v`/`_a` (synthesized by
  --     `frontend/desugar.mdk:964,967`), `_` (`frontend/parser.mdk:2720`) and
  --     `__tuple2__` are all legal rigid spellings.
  --   * a REAL head is uppercase-initial, OR one of the reserved `__tupleN__`
  --     builtin tags (`tupleCtorTyName`, `frontend/parser.mdk:2137`;
  --     `tupleHeadTagTc` below).
  -- So the two populations are disjoint on the UPPERCASE test alone, and they
  -- DO collide on `__tupleN__` — which is why `tupleSpine` and `matchStep` each
  -- carry an explicit answer-preserving `TRigid` arm rather than relying on a
  -- wildcard.  An earlier version of this comment claimed "rigid = lowercase,
  -- real = uppercase"; both halves are false at the edges and the claim is what
  -- let the `matchStep` case through review.  DICT-SEMANTICS §8 I6.2(b) tracks
  -- the `__tupleN__` forgery as OWED-#1110.
  --
  -- WHY IT IS ITS OWN CONSTRUCTOR (#1110, DICT-SEMANTICS §8 I6.1 ∧ I6.3):
  -- a rigid variable must carry NO module identity, a real head MUST carry
  -- one.  While both lived in `TCon String` that field could not be added at
  -- all.  This split is the carrier step only — every arm below reproduces
  -- the answer the shared `TCon` gave, byte for byte.  The field has since
  -- landed on `TCon` (above); `TRigid` deliberately did NOT grow one, which is
  -- the I6.1 half — "a rigid carries no identity" is now unrepresentable-wrong
  -- rather than merely unwritten.
  --
  -- ⚠️ It does NOT yet satisfy I6.1: a rigid is still usable as a dispatch
  -- key wherever `headTyconMono`/`headTyconNameMono` hand one out (both keep an
  -- explicit answer-preserving `TRigid` arm, deliberately).  The gain is that
  -- the violation is now GREPPABLE — `grep -nw TRigid` — instead of invisible
  -- inside `TCon`.  Eliminating it is the follow-on step, not this one.
  | TApp Mono Mono
  | TFun Mono EffRow Mono
  -- arg -> <effect row> result
  | TEff EffRow
-- An effect row occupying a type-CONSTRUCTOR ARGUMENT slot, for a data type
-- with an effect-row parameter (`data Async e a = … <e> …`).  Produced ONLY
-- by kind-directed elaboration at a Row-kinded param position; consumed only
-- by unifyN's TApp~TApp recursion.  Never appears in code lacking an
-- effect-poly data type, so its addition is purely additive.

public export data Tyvar =
  | Unbound Int Int  -- Unbound id level | Link
  | Link Mono

-- ── the FOUR mints of `Mono.TCon` (#1110) ─────────────────────────────────
-- These four one-line bodies are the ONLY applications of the `TCon`
-- constructor in this file; `test/typecheck_compiler_source.sh` pins that set,
-- and `Mono`'s own comment says why the property is worth buying.  Each name
-- states the identity class it claims, so a reviewer grades a CALL rather than
-- re-deriving what a bare third argument meant.

-- A head the LANGUAGE provides, written here as a string literal.  §8 I6.2(a):
-- ONE program-global identity, NOT the identity of whichever module wrote it,
-- or two modules' `(Int, Int)` stop being the same type — silently.  Every name
-- passed here must be in `frontend/resolve.mdk`'s `primitiveTypes`; the gate
-- pins that.
--
-- ⚠️ WHY THAT MEMBERSHIP IS ENOUGH — and it is NOT "the `Ty` layer answers from
-- the same list", which is what this comment said first and is false.  The `Ty`
-- layer answers from `tyOriginScope`, a LAST-WINS fold in which the builtin layer
-- has the LOWEST precedence (`frontend/resolve.mdk`) — so membership alone would
-- not stop an own/prelude/import layer from overriding a name this mint still
-- calls builtin.  What actually closes it is that `primitiveTypes` is ALSO the
-- duplicate-type seed: `duplicateErrors`'s `typeSeed = primitiveTypes ++ …`
-- (unconditionally, `programIsCore` gates only the prelude term), so NO module —
-- not even `stdlib/core.mdk` — can declare a TYPE of that name.  Measured:
-- `data List a = …`, `data Int = Foo`, `data Ref a = …` each give `Duplicate
-- type: <N>`.  The higher layers are therefore empty at these keys, which is
-- exactly what resolve's own comment means by *"the prelude beats builtins only
-- vacuously (they are disjoint today)"*.
--
-- ⚠️ "A TYPE of that name" is the load-bearing narrowing, and it needs a SECOND
-- leg.  `primitiveTypes` seeds only `typeSeed`, not `ifaceSeed` — so an
-- `interface Int a where …` is ACCEPTED (measured: exit 0, no diagnostic).  It
-- cannot reach this key anyway, because interfaces are keyed `iface:<Name>`
-- (`ifaceKey`/`ownIfaceOrigin`) while the builtin layer holds the BARE name, and
-- the two namespaces are disjoint by construction.  In-tree witness:
-- `test/references_fixtures/iface_ty_collide/`.
--
-- 🚨 SO THE PROPERTY IS CONDITIONAL ON THAT REJECTION.  Relax duplicate-type
-- rejection — resolve's comment already contemplates *"a future prelude `data
-- List`"* — and an occurrence of `List` carries `OriginModule "core"` while this
-- mint still hands out `OriginBuiltin`.  The gate stays GREEN, because it checks
-- MEMBERSHIP, not AGREEMENT.  Whoever relaxes it owes this site.
tconBuiltin : String -> Mono
tconBuiltin n = TCon n OriginBuiltin

-- The builtin unsaturated tuple head (`__tupleN__`).  `OriginBuiltin` for the
-- same reason and by the same authority as the parser's own
-- `tyConBuiltin (tupleCtorTyName n)` (`frontend/parser.mdk:2132`) — the tuple
-- heads sit beside `primitiveTypes` in resolve's `builtinTyOrigins`.
tconTupleHead : Int -> Mono
tconTupleHead n = TCon (tupleHeadTagTc n) OriginBuiltin

-- A head minted from an identity that was ACQUIRED — read off a `Ty.TyCon`'s
-- `tyConOrigin` (an occurrence resolve stamped) or off a `DData`/`DNewtype`'s
-- decl-layer carrier.  The origin argument comes FIRST so that the call site
-- reads as "from <this identity>, the head <name>" and a swapped pair does not
-- typecheck.
tconFrom : TyConOrigin -> String -> Mono
tconFrom o n = TCon n o

-- A head this site genuinely has NO identity source for — the `Ty` that carried
-- one was already projected to a bare `String` frames above, or the name is
-- fabricated by the checker itself.  Exactly two callers, both commented at the
-- call.  Deliberately NOT spelled `tconBuiltin`: these heads are not builtin,
-- and collapsing "no identity available" into "program-global identity" is the
-- empty-string-sentinel defect with a nicer type (§8 I6.3).
tconUnresolved : String -> Mono
tconUnresolved n = TCon n OriginUnresolved

-- An effect row (Phase 79/146): a set of concrete effect labels plus an optional
-- tail variable.
--   tail = None    ⇒ closed row, exactly [labels].
--   tail = Some v  ⇒ open row <labels | v>: v can absorb further effects.
-- Inference-synthesized arrows use open rows so effect-subsumption survives
-- equality unification; user annotations are closed unless they name a tail.
public export data EffRow = EffRow (List Atom) (Option (Ref Effvar))
public export data Effvar =
  | EUnbound Int Int  -- EUnbound id level | link
  | ELink EffRow

-- ── Effect refinement domains (capability-effects v2, Stage 1) ─────────────
-- An effect label may carry a PARAMETER drawn from its declared refinement
-- DOMAIN — a small lattice of data-shaped values with a top ⊤ (unconstrained).
-- Stage 1 is the REPRESENTATION only: every param is built at ⊤, so the row is
-- byte-identical to the v1 set-of-bare-labels.  Stage 2 adds the Prefix domain's
-- analysis with NO change to this row code.  (Mirror of lib/typecheck.ml.)
-- WS-4: a PRODUCT refinement domain — a label refined on several named AXES at
-- once, each axis a value in an existing sub-domain (e.g. structured `Net` =
-- `Host(Prefix) × Method(Set)`).  Represented as a sorted assoc-list keyed by
-- axis name; an axis ABSENT from the list is ⊤ on that axis, and `PProduct []`
-- is the product ⊤ (no axis constrained).  The lattice ops are POINTWISE
-- (`dsubN`/`djoinN`/`drenderN` below).  No `dmeetN`/⊥ arm: the escape check and
-- policy compare only ever call `dsub`/`djoin` — ⊓ is unreachable today and is
-- deliberately omitted (model ⊥ as `Option Param`→`None` if ever needed).
public export data Param =
  | PUnit
  | PPrefix (Option String)
  | PSet (Option (List String))
  | PProduct (List (String, Param))

-- v2 Stage 2b inferred-hole marker (mirror of lib/typecheck.ml).  A leaf
-- extern's `<Net _>` parses to the param string "_" (`effHoleSrc`), which
-- `atomOfWritten` keeps as `PPrefix (Some "_")` — the hole the call-site α
-- overwrites.  "_" is unambiguous: it can never be a valid written pattern
-- (fails `prefixPatternOk`).  An un-filled hole degrades to ⊤ for all domain
-- ops (sound over-approximation), so a surviving hole never leaks.
effHoleSrc : String
effHoleSrc = "_"

isHoleStr : String -> Bool
isHoleStr s = s == effHoleSrc

isHoleParam : Param -> Bool
isHoleParam (PPrefix (Some s)) = isHoleStr s
isHoleParam _ = False

normHole : Param -> Param
normHole (PPrefix (Some s)) =
  if isHoleStr s then
    PPrefix None
  else
    PPrefix (Some s)
normHole p = p
-- WS-4: per-axis holes are out of scope (the hole marker stays at the whole-atom
-- `Param` level, not per axis), so `normHole (PProduct …)` is the identity — the
-- explicit clause above (`normHole p = p`) already covers it.  Documented so a
-- reader doesn't mistake the absence for an oversight.
-- an atom = a label applied to a domain parameter.  A v1 atomic label `Foo` is
-- exactly `Atom "Foo" (dtopFor "Foo")` (= PUnit in Stage 1).
public export data Atom = Atom String Param

export
atomLabel : Atom -> String
atomLabel (Atom l _) = l

export
atomParam : Atom -> Param
atomParam (Atom _ p) = p

-- ── effect-label DOMAIN registry (v2 Stage 2a) ─────────────────────────────
-- Maps a label to the ⊤-param of its declared domain.  A `PPrefix None` entry
-- means "Prefix-domain (carries a pattern)"; absence ⇒ atomic (Unit).  Seeded
-- with the builtin Prefix labels (Net/FileRead/FileWrite) and extended per
-- program from `effect Net Prefix` decls.  An assoc-list Ref (the label set is
-- tiny).  (Mirror of lib/typecheck.ml's effect_domains Hashtbl.)

seedEffectDomains : Unit -> Unit
seedEffectDomains _ =
  let builtins = [
    ("Net", PPrefix None),
    ("FileRead", PPrefix None),
    ("FileWrite", PPrefix None),
    ("Env", PSet None),
    ("Exec", PPrefix None),
  ]
  driverState.value.effectDomains := builtins

-- register a label's domain from its `effect` decl: Some "Prefix" ⇒ Prefix;
-- None ⇒ atomic.
registerEffectDomain : String -> Option String -> Unit
registerEffectDomain name domain =
  let entry = (name, domainParam domain)
  driverState.value.effectDomains := entry::driverState.value.effectDomains.value

-- the ⊤-param a declared label carries: atomic ⇒ PUnit; Prefix ⇒ PPrefix None.
domainParam : Option String -> Param
domainParam (Some "Prefix") = PPrefix None
domainParam (Some "Set") = PSet None
domainParam (Some "Product") = PProduct []  -- WS-4: structured (multi-axis) domain ⊤
domainParam _ = PUnit

-- re-seed to the builtins, then register every `effect …` decl in the program.
populateEffectDomains : List Decl -> Unit
populateEffectDomains decls =
  let _ = seedEffectDomains ()
  populateGo decls

populateGo : List Decl -> Unit
populateGo [] = ()
populateGo ((DEffect _ name domain)::rest) =
  let _ = registerEffectDomain name domain
  populateGo rest
populateGo (_::rest) = populateGo rest

lookupDomain : String -> List (String, Param) -> Param
lookupDomain _ [] = PUnit
lookupDomain l ((k, p)::rest) = if l == k then p else lookupDomain l rest

-- ── RefinementDomain interface (design §2.1): dtop/dsub/djoin/dmeet/drender ──
-- Stage 1: only ⊤ params (PUnit / PPrefix None) ever occur; the STRUCTURE is
-- what Stage 2's Prefix analysis plugs into.  A label's domain is fixed by its
-- declaration; dtopFor picks the ⊤ of the label's domain (all PUnit in Stage 1).
-- ⊤ parameter for a label's domain (design §2.1): consults the registry;
-- labels with no Prefix entry are atomic ⇒ PUnit.
dtopFor : String -> Param
dtopFor label = match lookupDomain label driverState.value.effectDomains.value
  PPrefix None => PPrefix None
  PSet None => PSet None
  PProduct _ => PProduct []     -- WS-4: product domain ⊤ (no axis constrained)
  _ => PUnit

-- the concrete (literal) part of a Prefix pattern: drop a single trailing `*`
-- wildcard ("a.com/*" → "a.com/"); a pattern with no `*` is concrete as-is.
prefixConcrete : String -> String
prefixConcrete s =
  let n = stringLength s
  if n > 0 && stringSlice (n - 1) n s == "*" then stringSlice 0 (n - 1) s else s

-- p1 ⊑ p2 : is p1 at least as constrained (more specific) as p2?  In the Prefix
-- domain, p1 ⊑ p2 iff p1's concrete part starts with p2's concrete part.
export
dsub : Param -> Param -> Bool
dsub p1 p2 = dsubN (normHole p1) (normHole p2)

dsubN : Param -> Param -> Bool
dsubN PUnit PUnit = True
dsubN _ (PPrefix None) = True  -- anything ⊑ ⊤
dsubN (PPrefix (Some a)) (PPrefix (Some b)) =
  startsWith (prefixConcrete b) (prefixConcrete a)
dsubN (PPrefix None) (PPrefix (Some _)) = False
dsubN _ (PSet None) = True  -- anything ⊑ ⊤ (Set domain)
dsubN (PSet (Some a)) (PSet (Some b)) = subsetStr a b  -- a ⊆ b
dsubN (PSet None) (PSet (Some _)) = False
-- WS-4: PRODUCT subsumption is POINTWISE.  `a ⊑ b` iff for EVERY axis CONSTRAINED
-- in `b`, a's value on that axis ⊑ b's value.  SOUNDNESS-CRITICAL: an axis absent
-- from `a` means a is UNCONSTRAINED (⊤) on that axis, which is NOT ⊑ a constrained
-- b-axis — so a missing a-axis must be looked up against the SUB-DOMAIN ⊤ of the
-- b-axis (`subTopOf bp`), not silently skipped.  (Skipping it would under-
-- approximate the escape check ⇒ unsound: an `a` silent on Method would falsely
-- subsume a `b` that confines Method.)  Axes constrained in `a` but ⊤ in `b` need
-- no check (anything ⊑ ⊤), so we iterate b's axes only.
dsubN _ (PProduct []) = True  -- anything ⊑ product-⊤
dsubN (PProduct ax) (PProduct bx) = allList (axisSub ax) bx
dsubN _ _ = False  -- domain mismatch — never happens (one domain per label)

-- one b-axis ⊑ check: a's value on `name` (its sub-domain ⊤ when a is silent) ⊑ bp.
axisSub : List (String, Param) -> (String, Param) -> Bool
axisSub ax (name, bp) = dsubN (lookupAxisOrTop name ax bp) bp

-- a's value for axis `name`, or the SUB-DOMAIN ⊤ of `bp` when `a` is silent (the
-- soundness default — a missing axis is ⊤ on that axis, NOT ⊑ a constrained bound).
lookupAxisOrTop : String -> List (String, Param) -> Param -> Param
lookupAxisOrTop name ax bp = match lookupAxis name ax
  Some v => v
  None => subTopOf bp

-- the ⊤ of a sub-domain param's domain.
subTopOf : Param -> Param
subTopOf (PPrefix _) = PPrefix None
subTopOf (PSet _) = PSet None
subTopOf (PProduct _) = PProduct []
subTopOf _ = PUnit

lookupAxis : String -> List (String, Param) -> Option Param
lookupAxis _ [] = None
lookupAxis name ((k, v)::rest) =
  if name == k then
    Some v
  else
    lookupAxis name rest

-- total `all` over a list (avoids relying on a stdlib import in compiler).
allList : (a -> Bool) -> List a -> Bool
allList _ [] = True
allList f (x::xs) = if f x then allList f xs else False

-- a ⊆ b for string sets (lists treated as sets)
subsetStr : List String -> List String -> Bool
subsetStr [] _ = True
subsetStr (x::xs) b = if contains x b then subsetStr xs b else False

-- least upper bound (over-approximation)
djoin : Param -> Param -> Param
djoin p1 p2 = djoinN (normHole p1) (normHole p2)

djoinN : Param -> Param -> Param
djoinN PUnit PUnit = PUnit
djoinN (PPrefix None) _ = PPrefix None
djoinN _ (PPrefix None) = PPrefix None
djoinN (PPrefix (Some a)) (PPrefix (Some b)) =
  let k = commonPrefixLen a b 0
  if k == 0 then PPrefix None else PPrefix (Some (stringSlice 0 k a))
djoinN (PSet None) _ = PSet None
djoinN _ (PSet None) = PSet None
djoinN (PSet (Some a)) (PSet (Some b)) =
  -- ∪, saturating to ⊤ (PSet None) past the cardinality cap (setCardCap = 16)
  let u = sortUniqS (a ++ b)
  if listLen u > setCardCap then PSet None else PSet (Some u)
-- WS-4: PRODUCT join is POINTWISE — for every axis present in EITHER side, join
-- the two sub-params (a side silent on an axis = sub-⊤ there, which makes the join
-- ⊤ on that axis — correct over-approximation).  `productNorm` then drops axes
-- that joined to sub-⊤ and re-sorts; all-⊤ collapses to `PProduct []`.  Component
-- saturation (prefix→LCP→⊤, set→card-cap→⊤) is inherited from the recursive calls.
djoinN (PProduct ax) (PProduct bx) =
  productNorm (map (joinAxis ax bx) (axisUnion ax bx))
djoinN p _ = p  -- domain mismatch — never happens

-- join the two sides' values on axis `name` (missing side = sub-⊤).  The sub-⊤
-- to use is taken from whichever side HAS the axis (both sides' axes are sub-⊤
-- compatible since one label has one product shape).
joinAxis : List (String, Param) -> List (String, Param) -> String -> (String, Param)
joinAxis ax bx name = match (lookupAxis name ax, lookupAxis name bx)
  (Some pa, Some pb) => (name, djoinN pa pb)
  (Some pa, None) => (name, djoinN pa (subTopOf pa))
  (None, Some pb) => (name, djoinN (subTopOf pb) pb)
  (None, None) => (name, PUnit)  -- unreachable (name ∈ union)

-- the sorted union of axis NAMES present in either side.
axisUnion : List (String, Param) -> List (String, Param) -> List String
axisUnion ax bx = sortUniqS (map fst ax ++ map fst bx)

-- canonicalize a product: drop axes whose value is its sub-domain ⊤ (unconstrained
-- ⇒ omit), sort by axis name; all-⊤ ⇒ `PProduct []` (the product ⊤).
productNorm : List (String, Param) -> Param
productNorm axes =
  PProduct (sortAxes (filterList (p => not (isSubTop (snd p))) axes))

-- is a sub-param the ⊤ of its sub-domain?
isSubTop : Param -> Bool
isSubTop (PPrefix None) = True
isSubTop (PSet None) = True
isSubTop (PProduct []) = True
isSubTop PUnit = True
isSubTop _ = False

-- sort an axis assoc-list by axis name (insertion sort — the axis count is tiny).
sortAxes : List (String, Param) -> List (String, Param)
sortAxes [] = []
sortAxes (x::xs) = insertAxis x (sortAxes xs)

insertAxis : (String, Param) -> List (String, Param) -> List (String, Param)
insertAxis x [] = [x]
insertAxis x (y::ys) = match stringCompare (fst x) (fst y)
  Gt => y :: insertAxis x ys
  _ => x :: y::ys

-- Set-domain cardinality cap: a join whose union exceeds this many distinct
-- authority elements saturates to ⊤ (PSet None), bounding the lattice height.
setCardCap : Int
setCardCap = 16

-- length of the longest common prefix of two strings (Stage-2 djoin support)
commonPrefixLen : String -> String -> Int -> Int
commonPrefixLen a b i =
  if i >= stringLength a || i >= stringLength b then
    i
  else if stringSlice i (i + 1) a == stringSlice i (i + 1) b then
    commonPrefixLen a b (i + 1)
  else
    i

-- manifest / error text for a param.  ⊤ renders as empty so a ⊤-param atom
-- renders as JUST its label — byte-identical to v1.
export
drender : Param -> String
drender p = drenderN (normHole p)

drenderN : Param -> String
drenderN PUnit = ""
drenderN (PPrefix None) = ""
drenderN (PPrefix (Some s)) = " \"" ++ s ++ "\""
drenderN (PSet None) = ""  -- ⊤ renders empty (like the others)
drenderN (PSet (Some xs)) = " {" ++ joinWith ", " (map quoteStr xs) ++ "}"
-- WS-4: render a product as the chosen USER SURFACE (keyword-axes, capitalized:
-- `Host="…" Method={…}`) so error/manifest text round-trips back through the
-- parser.  Product-⊤ (`PProduct []`) renders empty, like every other ⊤.
drenderN (PProduct []) = ""
drenderN (PProduct ax) = " " ++ renderProductLit ax

quoteStr : String -> String
quoteStr s = "\"" ++ s ++ "\""

-- WS-4: render a product's constrained axes as `Host="…" Method={…}` (space-
-- separated, axis-sorted) — the Option-A keyword-axes user surface.  Each axis
-- value renders via its sub-domain (`drenderN` drops the leading space, which we
-- supply per axis as `Name=`).  Only constrained axes appear (⊤ axes are absent
-- by `productNorm`), so the surface is minimal.
renderProductLit : List (String, Param) -> String
renderProductLit ax = joinWith " " (map renderAxis ax)

renderAxis : (String, Param) -> String
renderAxis (name, p) = "\{name}=\{renderAxisVal p}"

-- an axis value WITHOUT the leading-space that `drenderN` prefixes (we reuse the
-- sub-domain rendering but strip the space, so Host="a/*" / Method={"GET"}).
renderAxisVal : Param -> String
renderAxisVal (PPrefix (Some s)) = "\"" ++ s ++ "\""
renderAxisVal (PSet (Some xs)) = "{" ++ joinWith ", " (map quoteStr xs) ++ "}"
renderAxisVal _ = ""  -- a ⊤ axis never reaches here (productNorm drops it)

-- ── atom-set helpers (replace the v1 String-set ops) ───────────────────────
-- render one atom: label + domain refinement text (⊤ ⇒ just the label)
renderAtom : Atom -> String
renderAtom a = atomLabel a ++ drender (atomParam a)

-- render a set of atoms as the comma-separated body of a `<…>`, label-sorted —
-- byte-identical to v1 when all params are ⊤.
renderAtoms : List Atom -> String
renderAtoms atoms = joinWith ", " (map renderAtom (atomsNorm atoms))

-- insert an atom into a label-sorted set, joining same-label params (djoin).
-- With all-⊤ params this is exactly v1's sortInsertS over labels.
atomInsert : Atom -> List Atom -> List Atom
atomInsert x [] = [x]
atomInsert x (y::ys) = match stringCompare (atomLabel x) (atomLabel y)
  Lt => x :: y::ys
  Eq => Atom (atomLabel y) (djoin (atomParam x) (atomParam y)) :: ys
  Gt => y :: atomInsert x ys

-- canonical form: ≤ one atom per label (same-label params joined), label-sorted.
atomsNorm : List Atom -> List Atom
atomsNorm xs = atomsNormGo xs []

atomsNormGo : List Atom -> List Atom -> List Atom
atomsNormGo [] acc = acc
atomsNormGo (x::xs) acc = atomsNormGo xs (atomInsert x acc)

-- union of two atom sets, joining same-label params
atomsUnion : List Atom -> List Atom -> List Atom
atomsUnion a b = atomsNorm (a ++ b)

-- set difference: atoms of [a] whose label is absent from [b], OR present but
-- NOT subsumed (`not (dsub pa pb)`) — the Stage-2 escape direction.  In Stage 1
-- (all ⊤) "present" always means subsumed ⇒ pure label-set diff.
atomsDiff : List Atom -> List Atom -> List Atom
atomsDiff [] _ = []
atomsDiff (x::xs) ys = match findAtom (atomLabel x) ys
  None => x :: atomsDiff xs ys
  Some y =>
    if dsub (atomParam x) (atomParam y) then
      atomsDiff xs ys
    else
      x :: atomsDiff xs ys

findAtom : String -> List Atom -> Option Atom
findAtom _ [] = None
findAtom l (y::ys) = if l == atomLabel y then Some y else findAtom l ys

-- lift a bare AST label to a ⊤-param atom (Stage 1: every annotation atomic)
atomOfLabel : String -> Atom
atomOfLabel l = Atom l (dtopFor l)

-- ── v2 Stage 3: the `IO` widening union alias (design §3.2) ─────────────────
-- `IO` is the coarse security alias: in a BOUND/annotation row it stands for
-- the join of every narrow security label at ⊤.  ioAliasLabels lists them
-- (every minted security label EXCEPT IO itself); internal labels (Mut/Panic)
-- are NOT members, so they are tracked independently of IO.  (Mirror of
-- lib/typecheck.ml's io_alias_labels.)
ioAliasLabels : List String
ioAliasLabels = [
  "Stdout",
  "Stderr",
  "Stdin",
  "Clock",
  "Env",
  "Exec",
  "Rand",
  "Net",
  "FileRead",
  "FileWrite",
]

-- expand a bound `IO` atom into the security-label alias before an escape
-- check, so a NARROW inferred row is subsumed by an `<IO>` bound (narrow ⊑ IO
-- accepts).  Sound in reverse: an inferred raw `IO` against a NARROW bound is
-- never expanded (the bound has no IO) ⇒ escapes (IO ⊑ narrow rejects).  `IO`
-- stays in the expansion (atomsNorm keeps it) so inferred IO-vs-IO matches.
expandIoInBound : List Atom -> List Atom
expandIoInBound b = match findAtom "IO" b
  None => b
  Some _ => atomsNorm (b ++ map atomOfLabel ioAliasLabels)

-- escape-direction difference: inferred [a] not permitted by bound [b], with
-- the bound's `IO` widened to its security-label alias first.
atomsEscape : List Atom -> List Atom -> List Atom
atomsEscape a b = atomsDiff a (expandIoInBound b)

-- build an atom from a WRITTEN annotation label, threading its optional param.
-- A bare label takes the domain ⊤; a written param becomes PPrefix (Some pat)
-- when the label's domain is Prefix, else (atomic label) stays ⊤ (the param is
-- diagnosed + dropped by checkEffectParams).  Pure: validation is a separate pass.
atomOfWritten : (String, Option String) -> Atom
atomOfWritten (l, None) = Atom l (dtopFor l)
atomOfWritten (l, Some pat) =
  -- the universal inferred-hole marker `_`: recognized REGARDLESS of the label's
  -- domain (a Set-domain `<Env _>` must stay a hole, not become `PSet ["_"]`).
  -- The domain-directed fillHoleAtom replaces it with the correct domain param.
  if isHoleStr pat then Atom l (PPrefix (Some pat))
  else match dtopFor l
    PPrefix None => Atom l (PPrefix (Some pat))
    PSet None => Atom l (PSet (Some (decodeSetParam pat)))
    PProduct _ => Atom l (decodeProductParam pat)
    _ => Atom l (dtopFor l)

-- A Set-domain written param is carried in the `Option String` carrier as a
-- brace-delimited, comma-separated literal `{a,b,c}` (the parser's `effParamFor`
-- TLBrace clause builds exactly this).  Decode it back to the element list.
-- (Keeps the carrier type `Option String`, so no AST `TyEffect` ripple.)
export
decodeSetParam : String -> List String
decodeSetParam s =
  let n = stringLength s
  if n >= 2 && stringSlice 0 1 s == "{" && stringSlice (n - 1) n s == "}" then
    sortUniqS (filterList (/= "") (splitOnComma (stringSlice 1 (n - 1) s)))
  else
    sortUniqS (filterList (/= "") (splitOnComma s))

-- WS-4: a PRODUCT written param is carried in the `Option String` carrier as a
-- structured SENTINEL string the parser's `effParamFor` product clause builds:
--
--   @P{Host="idp.example.com/*";Method={GET,POST}}
--
-- Grammar (internal wire form, NOT user syntax — that is §4 of WS-4-DESIGN.md):
--   @P{                         -- product sentinel prefix
--     <Axis>=<val>              -- one or more axes, ';'-separated
--   }                           -- closing brace
-- where <val> is either `"…"` (a Prefix sub-param) or `{a,b}` (a Set sub-param).
-- A PLAIN string with NO `@P{` sentinel is the §3 "host-axis lift": a bare
-- `<Net "a.com/*">` under a Product-registered Net means Host=a.com/*, Method=⊤.
-- (A *third* nested level would make this encoding fiddly — WS-4 is the natural
-- stopping point for the carrier hack; widen the AST carrier THEN, not piecemeal.)
export
decodeProductParam : String -> Param
decodeProductParam s =
  let n = stringLength s
  if n >= 4 && stringSlice 0 3 s == "@P{" && stringSlice (n - 1) n s == "}" then
    productNorm (map decodeAxis (splitOnSemi (stringSlice 3 (n - 1) s)))
  else
    productNorm [("Host", PPrefix (Some s))]

-- decode one `Axis=val` axis spec.  val = `"…"` ⇒ Prefix; `{a,b}` ⇒ Set.
decodeAxis : String -> (String, Param)
decodeAxis spec = match splitOnFirstEqStr spec
  None => (spec, PUnit)          -- malformed (no '='): treated as ⊤ ⇒ dropped by productNorm
  Some i =>
    let name = stringSlice 0 i spec
    let rhs = stringSlice (i + 1) (stringLength spec) spec
    (name, decodeAxisVal rhs)

decodeAxisVal : String -> Param
decodeAxisVal rhs =
  let n = stringLength rhs
  if n >= 2 && stringSlice 0 1 rhs == "{" && stringSlice (n - 1) n rhs == "}" then
    PSet (Some (decodeSetParam rhs))
  else if n >= 2 && stringSlice 0 1 rhs == "\"" && stringSlice (n - 1) n rhs == "\"" then
    PPrefix (Some (stringSlice 1 (n - 1) rhs))
  else
    PPrefix (Some rhs)

-- index of the first '=' in a string, or None.
splitOnFirstEqStr : String -> Option Int
splitOnFirstEqStr s = splitOnFirstEqGo s 0 (stringLength s)

splitOnFirstEqGo : String -> Int -> Int -> Option Int
splitOnFirstEqGo s i n =
  if i >= n then
    None
  else if stringSlice i (i + 1) s == "=" then
    Some i
  else
    splitOnFirstEqGo s (i + 1) n

-- split a string on ';' (product-axis separator).
splitOnSemi : String -> List String
splitOnSemi s = splitOnSemiGo s 0 0 []

splitOnSemiGo : String -> Int -> Int -> List String -> List String
splitOnSemiGo s start i acc =
  let n = stringLength s
  if i >= n then
    reverseL (stringSlice start n s :: acc)
  else if stringSlice i (i + 1) s == ";" then
    splitOnSemiGo s (i + 1) (i + 1) (stringSlice start i s :: acc)
  else
    splitOnSemiGo s start (i + 1) acc

-- split a string on ',' (Set-element separator; authority tokens contain none)
splitOnComma : String -> List String
splitOnComma s = splitOnCommaGo s 0 0 []

splitOnCommaGo : String -> Int -> Int -> List String -> List String
splitOnCommaGo s start i acc =
  let n = stringLength s
  if i >= n then
    reverseL (stringSlice start n s :: acc)
  else if stringSlice i (i + 1) s == "," then
    splitOnCommaGo s (i + 1) (i + 1) (stringSlice start i s :: acc)
  else
    splitOnCommaGo s start (i + 1) acc

atomsOfWritten : List (String, Option String) -> List Atom
atomsOfWritten ls = atomsNorm (map atomOfWritten ls)

-- ── v2 Stage 2b: known-literal-prefix abstract analysis α (design §2.4) ─────
-- Abstract a DESUGARED core string-producing expr to a known literal prefix or
-- Unknown.  Intraprocedural (fork (c)): EApp results, fn-parameter EVars, field
-- access ⇒ Unknown ⇒ ⊤.  `lets` carries let-bound RHSs in scope for the EVar
-- rule.  (Mirror of lib/typecheck.ml's `alpha`.)
data KP = Known String | Unknown

-- longest common prefix as a KP (Unknown if empty)
kpLcp : String -> String -> KP
kpLcp a b =
  let k = commonPrefixLen a b 0
  if k == 0 then Unknown else Known (stringSlice 0 k a)

-- `++`: the left operand's known prefix is fixed regardless of the right (§2.4)
alphaLeftPrefix : KP -> KP
alphaLeftPrefix (Known pa) = Known pa
alphaLeftPrefix Unknown = Unknown

alpha : List (String, Expr) -> Expr -> KP
alpha lets (ELoc _ e) = alpha lets e
alpha lets (EDoOrigin _ e) = alpha lets e
alpha lets (EAnnot e _) = alpha lets e
alpha lets (EHeadAnnot e _) = alpha lets e
alpha _ (ELit (LString s)) = Known s
alpha lets (EBinOp op a _ _)
  | op == "++" = alphaLeftPrefix (alpha lets a)
alpha _ (EBinOp _ _ _ _) = Unknown
alpha lets (EVar x) = match lookupAssoc x lets
  Some rhs => alpha lets rhs
  None => Unknown
alpha lets (EVarId x _) = match lookupAssoc x lets
  Some rhs => alpha lets rhs
  None => Unknown
alpha lets (ELet _ _ (PVar x _) e1 e2) = alpha ((x, e1)::lets) e2
alpha lets (ELet _ _ _ _ e2) = alpha lets e2
alpha lets (ELetGroup binds body) = alpha (alphaCollectBinds binds lets) body
alpha lets (EIf _ t f) = match alpha lets t
  Known a => match alpha lets f
    Known b => kpLcp a b
    Unknown => Unknown
  Unknown => Unknown
alpha lets (EMatch _ arms) = alphaArms lets None arms
alpha _ _ = Unknown

-- propagate single-clause zero-param where-bindings (`x = e`) into scope
alphaCollectBinds : List LetBind -> List (String, Expr) -> List (String, Expr)
alphaCollectBinds [] acc = acc
alphaCollectBinds ((LetBind n clauses)::rest) acc = match clauses
  [FunClause [] rhs] => alphaCollectBinds rest ((n, rhs)::acc)
  _ => alphaCollectBinds rest acc

-- LCP of all arm results if every arm is Known; else Unknown
alphaArms : List (String, Expr) -> Option String -> List Arm -> KP
alphaArms _ (Some s) [] = Known s
alphaArms _ None [] = Unknown
alphaArms lets acc ((Arm _ _ rhs)::rest) = match alpha lets rhs
  Unknown => Unknown
  Known s => match acc
    None => alphaArms lets (Some s) rest
    Some a => match kpLcp a s
      Known c => alphaArms lets (Some c) rest
      Unknown => Unknown

-- the FIRST argument of an application spine: `f a b c` ⇒ Some a (locked dec 1)
spineFirstArg : Expr -> Option Expr
spineFirstArg (ELoc _ e) = spineFirstArg e
spineFirstArg (EDoOrigin _ e) = spineFirstArg e
spineFirstArg (EApp f x) = match spineHeadIsApp f
  True => spineFirstArg f
  False => Some x
spineFirstArg _ = None

-- is the application head itself a (curried) application?  `EApp (EApp ..) _`
-- ⇒ recurse left; `EApp (EVar/leaf) x` ⇒ x is the first arg.
spineHeadIsApp : Expr -> Bool
spineHeadIsApp (ELoc _ e) = spineHeadIsApp e
spineHeadIsApp (EDoOrigin _ e) = spineHeadIsApp e
spineHeadIsApp (EApp _ _) = True
spineHeadIsApp _ = False

-- the delimiter footgun guard (design §2.5 / fork (b)): a written Prefix pattern
-- must end in `*` or contain a `/` delimiter; a bare prefix is ambiguous.
prefixPatternOk : String -> Bool
prefixPatternOk s =
  let n = stringLength s
  n > 0 && (stringSlice (n - 1) n s == "*" || strHasSlash s)

strHasSlash : String -> Bool
strHasSlash s = strHasSlashGo s 0 (stringLength s)

strHasSlashGo : String -> Int -> Int -> Bool
strHasSlashGo s i n =
  if i >= n then
    False
  else if stringSlice i (i + 1) s == "/" then
    True
  else
    strHasSlashGo s (i + 1) n

-- forall <quantified tyvar ids> <quantified effvar ids>. mono
public export data Scheme = Forall (List Int) (List Int) Mono

-- ── global inference state ────────────────────────────────────────────────

newTyvarId : Unit -> Int
newTyvarId _ =
  let n = perRun.value.tyvarCounter.value
  perRun.value.tyvarCounter := n + 1
  n

freshVar : Unit -> Mono
freshVar _ =
  TVar (Ref (Unbound (newTyvarId ()) perRun.value.currentLevel.value))

-- ── effect variables + rows (Phase 79/146) ────────────────────────────────

newEffvarId : Unit -> Int
newEffvarId _ =
  let n = perRun.value.effvarCounter.value
  perRun.value.effvarCounter := n + 1
  n

-- the empty closed row — a pure arrow
pureRow : EffRow
pureRow = EffRow [] None

freshEffvar : Unit -> Ref Effvar
freshEffvar _ = Ref (EUnbound (newEffvarId ()) perRun.value.currentLevel.value)

freshEffvarAt : Int -> Ref Effvar
freshEffvarAt lvl = Ref (EUnbound (newEffvarId ()) lvl)

-- an open row with a fresh tail variable
openRow : Unit -> EffRow
openRow _ = EffRow [] (Some (freshEffvar ()))

-- follow ELink tails (merging labels) to a canonical row whose tail, if present,
-- is an unbound effvar
effrowNorm : EffRow -> EffRow
effrowNorm (EffRow labels tail) = match tail
  Some cell => match !cell
    ELink r2 =>
      let nr = effrowNorm r2
      match nr
        EffRow ls2 t2 => EffRow (atomsUnion labels ls2) t2
    EUnbound _ _ => EffRow labels tail
  None => EffRow labels tail

-- the concrete labels (atoms) currently known for a row (ignores the open tail)
export
effrowLabels : EffRow -> List Atom
effrowLabels r = match effrowNorm r
  EffRow labels _ => labels

-- v2 Stage 2b: fill inferred-hole atoms in a freshly-incurred call effect row.
-- Returns a row whose head labels have every hole atom replaced by α of the
-- call's first spine argument (Unknown / no-arg ⇒ ⊤); non-hole atoms and the
-- open tail are preserved.  When no hole is present the row is unchanged.
-- `lets` is the enclosing function body's α-let scope (EFFECTS WS-2): seeded into
-- α so an outer-body `let dest = "…"; fetch dest` recovers the literal prefix.
-- (Mirror of lib/typecheck.ml's fill_holes_in_row.)
fillHolesInRow : List (String, Expr) -> EffRow -> Option Expr -> EffRow
fillHolesInRow lets eff firstArg = match effrowNorm eff
  EffRow labels tail =>
    if anyHoleAtom labels then
      EffRow (map (fillHoleAtom lets firstArg) labels) tail
    else
      eff

anyHoleAtom : List Atom -> Bool
anyHoleAtom [] = False
anyHoleAtom (a::rest) =
  if isHoleParam (atomParam a) then
    True
  else
    anyHoleAtom rest

fillHoleAtom : List (String, Expr) -> Option Expr -> Atom -> Atom
fillHoleAtom lets firstArg a =
  if isHoleParam (atomParam a) then
    Atom (atomLabel a) (holeFillParam (atomLabel a) lets firstArg)
  else
    a

-- DOMAIN-DIRECTED hole fill (WS-3b): the recovered literal becomes the right
-- shape for the LABEL's domain.  Prefix-domain (Net/Exec) ⇒ `PPrefix (Some s)`;
-- Set-domain (Env) ⇒ a singleton authority set `PSet (Some [s])`.  No recovery
-- (no arg / Unknown) ⇒ the domain's ⊤ (`dtopFor label`), NOT a hardcoded
-- `PPrefix None` — an unfilled Env hole must degrade to `PSet None`, not Prefix-⊤.
-- WS-4: Product-domain (Net) ⇒ Host=recovered-literal, Method=⊤ (α has no method
-- info — a sound over-approximation).
holeFillParam : String -> List (String, Expr) -> Option Expr -> Param
holeFillParam label lets (Some e) = match alpha lets e
  Known s => match dtopFor label
    PSet None => PSet (Some (sortUniqS [s]))
    PPrefix None => PPrefix (Some s)
    PProduct _ => productNorm [("Host", PPrefix (Some s))]
    _ => dtopFor label
  Unknown => dtopFor label
holeFillParam label _ None = dtopFor label

effvarLevel : Ref Effvar -> Int
effvarLevel cell = match !cell
  EUnbound _ l => l
  ELink _ => 0

-- sorted + deduplicated string set (canonical effect-label order, matching the
-- OCaml `List.sort_uniq String.compare` so multi-label rows render identically)
-- sortUniqS / sortUniqSGo / sortInsertS moved to support/util.mdk (imported above).

enterLevel : Unit -> Unit
enterLevel _ = perRun.value.currentLevel := perRun.value.currentLevel.value + 1

exitLevel : Unit -> Unit
exitLevel _ = perRun.value.currentLevel := perRun.value.currentLevel.value - 1

-- ── effect propagation (Phase 79) ─────────────────────────────────────────
-- the latent effect of the function body currently being inferred: application
-- arms widen it; entering a lambda saves+reopens it, and the accumulated row
-- becomes the lambda's arrow effect.  A closed (tail=None) ambient is a SINK that
-- discards effects — the top-level state where a value binding's effects drop.

-- the unbound-tail id of an effvar cell (-1 once linked); unique like tyvar ids,
-- so id-equality stands in for the reference's physical `==` on effvars
effvarId : Ref Effvar -> Int
effvarId cell = match !cell
  EUnbound id _ => id
  ELink _ => 0 - 1

-- record that the current context performs row [eff]'s effects, widening ambient
-- [cur] WITHOUT closing its tail (so the next performed effect can still be
-- absorbed).  A closed ambient is a sink and discards.  An open [eff] is tied to
-- the ambient through a shared fresh tail.
performEffect : Ref EffRow -> EffRow -> Unit
performEffect cur eff = match effrowNorm !cur
  EffRow _ None => ()
  EffRow curLabels (Some ct) => match effrowNorm eff
    EffRow effLabels effTail =>
      cur := EffRow (atomsUnion curLabels effLabels) (Some ct)
      match effTail
        Some et => if effvarId et == effvarId ct then () else performLink ct et
        None => ()

performLink : Ref Effvar -> Ref Effvar -> Unit
performLink ct et =
  let v3 = freshEffvarAt (minI (effvarLevel ct) (effvarLevel et))
  ct := ELink (EffRow [] (Some v3))
  et := ELink (EffRow [] (Some v3))

-- unify two effect rows.  PERMISSIVE (Phase 79): an open row absorbs the other
-- side's labels by binding its tail; two open rows route through one shared fresh
-- tail.  Differing closed rows / an open row whose labels exceed a closed bound
-- are left as-is (the laundering subset check lands in Phase 146, Stage D).
unifyRow : EffRow -> EffRow -> Unit
unifyRow r1 r2 = unifyRowN (effrowNorm r1) (effrowNorm r2)

-- #839 STRICTNESS AUDIT.  The four arms below are classified against
-- EFFECTS-SEMANTICS §5 (docs/spec/EFFECTS-SEMANTICS.md:335-371) and §6
-- (:406-451).  Each open-tailed arm can ABSORB or DISCARD a concrete effect
-- atom; whether that loss is load-bearing subtyping-via-reopen or accidental
-- leniency decides whether a downstream soundness check must RACE this unifier
-- (run pre-unify) or may inspect its result.  This records that relevance AT
-- the arm rather than only ~12k lines away in checkImplEffectLaunder's comment.
-- Per-arm verdicts inline.  The eventual fix (#839 increments 2a-2c) is an
-- absorption event trail so a post-unify QUERY can substitute for the pre-unify
-- races; a post-unify cell inspection alone CANNOT recover an absorbed atom
-- (see the both-open note), which is the whole reason the trail is needed.
-- (Intra-file refs below name SYMBOLS, not line numbers — the latter rot; the
-- §N (:lines) spec cites point into EFFECTS-SEMANTICS.md, verified current.)
unifyRowN : EffRow -> EffRow -> Unit
unifyRowN (EffRow l1 (Some v1)) (EffRow l2 (Some v2))
  -- SAME-TAIL arm (v1 == v2): the SAME physical effvar on both sides carrying
  -- possibly DIFFERENT concrete prefixes (`<e>` ~ `<Stdout | e>`).  Returns ()
  -- and DISCARDS the prefix mismatch (symmetric diff of l1,l2) — no link, no
  -- error, no note; the atom evaporates.  ACCIDENTAL leniency, NOT load-bearing:
  -- §6 (:448-451) names exactly this arm as the seam where "no post-hoc
  -- inspection can recover the loss", which is why the covering rule is pushed
  -- to DECLARATION time (T-EFFECT-ARG-UNCOVERED, checkArgEffVars, whose own
  -- comment cites this arm).  Do NOT tighten to an error: a benign
  -- self-unify `e ~ e` (l1 == l2, prefixes genuinely equal) also lands here.
  -- The #839 event trail (increment 2a) RECORDS this discard against v1 (the
  -- symmetric difference of l1,l2 — recorded identically regardless of arg order,
  -- risk 4).  The benign self-unify `e ~ e` (l1 == l2) has an EMPTY diff ⇒ zero
  -- pushes, so the hot same-cell path stays allocation-free and behaviour-neutral.
  | effvarId v1 == effvarId v2 = recordAbsorptions (atomsDiff l1 l2 ++ atomsDiff l2 l1) v1
  -- BOTH-OPEN arm (v1 /= v2): two distinct open tails.  Merges each side's
  -- missing atoms (atomsDiff l2 l1, atomsDiff l1 l2) into a shared fresh tail v3
  -- and links both old tails to it — after this, effrowLabels on either cell
  -- resolves THROUGH v3 and no longer distinguishes intrinsic vs argument-borne
  -- atoms; the atoms are ABSORBED into the shared tail.  LOAD-BEARING: this is
  -- the standard subtyping-via-row-polymorphism encoding §5 (:361) relies on and
  -- the effect-parametricity of map/andThen/fold/traverse §6 (:388-396) — an
  -- open row "can absorb further atoms".  KEEP.  Note it deliberately runs NO
  -- effectLeakCheck (contrast the two closed-side arms just below, which DO): an
  -- open tail has not committed to a bound, so nothing can escape PAST it yet.
  -- That asymmetry is why #803's intrinsic-atom bound used to run PRE-unify — a
  -- naive post-unify effrowLabels inspection CANNOT recover the absorbed atom.  It
  -- now runs POST-unify instead (#839 2b, launderEscapeFromLog), by recording the
  -- absorbed atoms HERE (recordAbsorptions, increment 2a) so the trail carries what
  -- effrowLabels no longer can — the whole point of the event trail.
  | otherwise =
    let v3 = freshEffvarAt (minI (effvarLevel v1) (effvarLevel v2))
    let d21 = atomsDiff l2 l1
    let d12 = atomsDiff l1 l2
    v1 := (ELink (EffRow d21 (Some v3)))
    v2 := (ELink (EffRow d12 (Some v3)))
    -- #839 2a: both diffs vanish into the shared fresh tail v3; record them
    -- against v3 (the surviving tail).  The setRef links above are UNCHANGED —
    -- d21/d12 are the same values inlined before, so unification is byte-identical.
    recordAbsorptions (d21 ++ d12) v3
-- OPEN~CLOSED / CLOSED~OPEN arms: GUARDED — each runs effectLeakCheck (atomsEscape …),
-- §5's binding-boundary escape check (:339-351), checking the OPEN side's labels against
-- the CLOSED side's bound at the open-meets-closed seam.  (Absorbing into a CLOSED tail is
-- the guarded direction.)
unifyRowN (EffRow l1 (Some v1)) (EffRow l2 None) =
  let _ = effectLeakCheck (atomsEscape l1 l2) l2
  v1 := ELink (EffRow (atomsDiff l2 l1) None)
unifyRowN (EffRow l1 None) (EffRow l2 (Some v2)) =
  let _ = effectLeakCheck (atomsEscape l2 l1) l1
  v2 := ELink (EffRow (atomsDiff l1 l2) None)
-- CLOSED~CLOSED arm: a SILENT no-op — and NOT effect-guarded (unlike the two arms just
-- above; the #839 increment-1 audit wrongly lumped all three closed-side arms as "already
-- run effectLeakCheck", which is FALSE here — the gap the 2b review's S0 exposed).  It
-- cannot itself become effect-sound: with no open tail there is no subtyping-via-reopen, so
-- soundness would demand the atom SETS be EQUAL — but this arm has NO expected/actual role
-- (unify is symmetric and called with either order across thousands of sites), so a strict
-- check here would wrongly reject an impl that is legitimately PURER than its declared
-- effect (actual `<>` ~ declared `<Stdout>`), and would fire on unrelated non-launder
-- unifications main never checked.  DIRECTION lives only where expected/actual are known:
-- the impl/default effect-launder check reads the STABLE closed body-arrow atoms straight
-- off the pre-unify snapshot and checks them directionally there (launderEscapeFromLog's
-- closed-actual branch), which is exactly what the retired pre-unify walk did.  Absent that
-- consumer this arm stays lenient (a genuine mismatch elsewhere surfaces as a caller-level
-- type mismatch, as before).
-- ⚠️ EVERY WORD ABOVE IS SCOPED TO AN ARROW'S LATENT ROW.  It does NOT transfer to a row
-- sitting in an `Effect`-kinded type-ARGUMENT slot (`Async <Stdout> Int`): an index is
-- INVARIANT, has no expected/actual asymmetry to worry about, and has no downstream
-- launder consumer to recover the direction — so "a genuine mismatch surfaces elsewhere"
-- is simply false there and the atoms are discarded for good (#1094, an S0).  Index rows
-- therefore route to `unifyIndexRow` below, NOT here.  Do not re-point `unifyN`'s
-- `TEff`/`TEff` arm at `unifyRow`.
unifyRowN (EffRow _ None) (EffRow _ None) = ()

-- ── the INDEX row unifier (#1094) ──────────────────────────────────────────
-- `Mono` carries two different kinds of row and they obey different rules:
--   * `TFun _ EffRow _` — an arrow's LATENT row.  Sub-effecting via row-polymorphic
--     re-open (§5) is load-bearing; `unifyRow` above is written for it.
--   * `TEff EffRow`     — a row in an `Effect`-kinded type-argument (INDEX) slot.
--     EFFECTS-SEMANTICS §9 "Index fidelity": `F φ₁ τ̄` and `F φ₂ τ̄` are interchangeable
--     only when `φ₁ = φ₂`.  INVARIANT — no direction of `≤` is licensed here.  A
--     parameter's polarity is not knowable without a variance analysis, which this
--     compiler does not have, and a CONTRAVARIANT index is writable today
--     (`data Sink e = MkSink ((Unit -> <e> Unit) -> Int)`), so widening in EITHER
--     direction launders an effect.  Only equality is sound.
-- `substMonoP` already encodes this distinction (it wraps an arrow row in `reopenRow`
-- and passes a `TEff` row through UNCHANGED); routing both through one unifier threw
-- that decision away.  This restores the agreement.
--
-- ⚠️ INVARIANCE IS NOT "BOTH SIDES CLOSED AND EQUAL" CHECKED AT THE TOP.  Solving an
-- index METAVARIABLE against a written row is instantiation, not interchange, and must
-- keep working — `test/typecheck_error_fixtures/graded_closed_row_grade_ok.mdk:17`
-- (`mkPure : a -> Async <> a`, body `Done x`) unifies a FRESH OPEN effvar against the
-- written closed `<>`.  So the OPEN-tailed cases are not blanket-rejected.
--
-- ⚠️ BUT "every open-tailed arm of `unifyRowN` is already invariance-correct" is FALSE,
-- and an earlier revision of this comment said it.  Exactly TWO of the three open-tailed
-- shapes are:
--   * open~closed / closed~open — binds the tail to the exact difference and
--     `effectLeakCheck`s the residue.  Correct: there is a metavariable to solve.
--   * BOTH-OPEN with DISTINCT tails — ordinary Rémy/Wand unification into a shared fresh
--     tail.  Correct: two metavariable-tailed rows CAN be made equal, and the join is the
--     most general row equal to both.
--   * SAME-TAIL with DIFFERING PREFIXES (`<Stdout | e>` ~ `<e>`, the same physical
--     effvar) — NOT correct.  `unifyRowN`'s own arm DISCARDS the symmetric difference
--     ("the atom evaporates … ACCIDENTAL leniency, NOT load-bearing", ~60 lines above).
--     There is nothing left to solve — the tails are already the same cell — so the
--     differing prefixes are two genuinely different rows, and dropping the difference is
--     precisely the widening invariance forbids.  `launderBox : Box <Stdout | e> a ->
--     Box e a` was accepted, and a value typed `Int` printed.  Hence the same-tail arm
--     below, BEFORE the delegation.
--     The benign self-unify `e ~ e` (equal prefixes, including two empty ones) has an
--     EMPTY diff in both directions, so `relay : Box e a -> Box e a` stays green.
--     Nothing is lost by intercepting here: the arm this pre-empts would have called
--     `recordAbsorptions` on exactly this symmetric difference, and a non-empty
--     difference is now an error instead of a silently-absorbed atom, while an empty one
--     recorded nothing to begin with.
--     🚨 DO NOT COPY THIS ARM ONTO `unifyRowN`'s ARROW same-tail arm.  The same discard
--     launders there too (`launderArrow : (Unit -> <Stdout | e> Unit) -> (Unit -> <e>
--     Unit)` is accepted), but that arm's leniency is NOT the same call: the covering
--     rule for it was deliberately pushed to DECLARATION time (T-EFFECT-ARG-UNCOVERED /
--     `checkArgEffVars`, whose own comment cites that arm), and the recordAbsorptions →
--     `launderEscapeFromLog` trail depends on it.  Tightening the arrow side is a design
--     decision with its own blast radius, tracked separately — not a copy-paste of this.
unifyIndexRow : EffRow -> EffRow -> Unit
unifyIndexRow r1 r2 = unifyIndexRowN (effrowNorm r1) (effrowNorm r2)

unifyIndexRowN : EffRow -> EffRow -> Unit
unifyIndexRowN (EffRow l1 None) (EffRow l2 None) =
  indexRowEqCheck (atomsDiff l1 l2) (atomsDiff l2 l1) l1 l2
unifyIndexRowN (EffRow l1 (Some v1)) (EffRow l2 (Some v2))
  | effvarId v1 == effvarId v2 =
    indexRowEqCheck (atomsDiff l1 l2) (atomsDiff l2 l1) l1 l2
unifyIndexRowN r1 r2 = unifyRowN r1 r2

-- Two index rows with nothing left to solve — both closed, or both already ending in the
-- SAME effvar cell — are the same type iff neither side carries an atom the other lacks.
-- `atomsDiff` (not `atomsEscape`) on purpose: `expandIoInBound` widens a bound's
-- `IO` into the security-label alias, which is a SUBSUMPTION step — exactly the ≤ that
-- invariance forbids here, so `<IO>` and `<Stdout>` are different index rows.
indexRowEqCheck : List Atom -> List Atom -> List Atom -> List Atom -> Unit
indexRowEqCheck [] [] _ _ = ()
indexRowEqCheck _ _ l1 l2 =
  pushTypeError "T-EFFECT-INDEX-MISMATCH" (indexRowMismatchMsg l1 l2)

-- ERROR-QUALITY.md: deliberately NOT `effectLeakMsg`'s wording.  "Effectful value used
-- where <> is allowed, but it performs <Stdout>" is the ARROW message and reads as a lie
-- here — nothing is being performed at the point of mismatch; two types simply differ.
-- Symmetric phrasing because `unify` has no expected/actual role.
indexRowMismatchMsg : List Atom -> List Atom -> String
indexRowMismatchMsg l1 l2 = "Effect index mismatch: <\{renderAtoms l1}> vs <\{renderAtoms l2}>. An effect row written as a type argument is invariant — the two rows must be EQUAL, not merely compatible, so no sub-effecting step is allowed here (unlike a function's own effect row). Write the same row on both sides, or make the type row-polymorphic there (e.g. \{openRowHint l1}) if it really should accept more."

-- The "make it row-polymorphic" spelling for a row that may be EMPTY: `<>` has no
-- labels, so the naive `<\{renderAtoms l1} | e>` renders the un-writable `< | e>`.
openRowHint : List Atom -> String
openRowHint [] = "`e`"
openRowHint atoms = "`<\{renderAtoms atoms} | e>`"

-- SOUNDNESS (Phase 146): an open row (an inference-synthesized arrow, i.e. a
-- concrete value's latent effect) meeting a closed bound — its own labels must
-- not exceed the bound, else they escape.  [escaping] = open labels \ bound.
effectLeakCheck : List Atom -> List Atom -> Unit
effectLeakCheck [] bound = ()
effectLeakCheck escaping bound =
  pushTypeError "T-EFFECT-LEAK" (effectLeakMsg bound escaping)

effectLeakMsg : List Atom -> List Atom -> String
effectLeakMsg bound extras = "Effectful value used where <\{renderAtoms bound}> is allowed, but it performs <\{renderAtoms extras}>"

-- v2 Stage 2a: diagnostic for a rejected written effect param (mirror of
-- lib/typecheck.ml's EffectParam message).
effectParamMsg : String -> String -> String
effectParamMsg label why = "Invalid effect parameter on <\{label}>: \{why}"

-- Runtime B1 dedup: the shared "must end in '*' or contain a '/'…" rationale for
-- a bare prefix param, parameterized by the noun (`pattern` for a top-level
-- Prefix param, `Host pattern` for a product's Host axis).
prefixPatternErrMsg : String -> String -> String
prefixPatternErrMsg noun pat = "\{noun} \"\{pat}\" must end in '*' or contain a '/' delimiter (a bare prefix would admit a sibling host/path)"

-- validate every written effect param in a program's type annotations against
-- the registry: a Prefix label's pattern must pass prefixPatternOk; an atomic
-- label rejects a param outright.  Runs as a <Mut> pass (errors via
-- pushTypeError) — the OCaml side does this inline in atom_of_written.
checkEffectParams : List Decl -> Unit
checkEffectParams [] = ()
checkEffectParams (d::rest) =
  let _ = checkEffectParamsDecl d
  checkEffectParams rest

checkEffectParamsDecl : Decl -> Unit
checkEffectParamsDecl (DTypeSig _ _ t) = checkEffectParamsTy t
checkEffectParamsDecl (DExtern _ _ t) = checkEffectParamsTy t
checkEffectParamsDecl (DAttrib _ d) = checkEffectParamsDecl d
checkEffectParamsDecl _ = ()

-- #784 (Option A): reject an interface method whose signature has a free effect
-- tail var in RETURN position but in NO ROW-KINDED argument position — it is
-- under-determined, so a caller can instantiate it to `<>` and LAUNDER the
-- dispatched impl's real effect (a pure-typed wrapper silently performs it).
-- SCOPED to interface methods (the ratified scope); a top-level return-only
-- effect var is #797's separate territory.
--
-- ⚠️ This runs as a SEPARATE pass from checkEffectParams, deliberately AFTER
-- registerAllData has populated `dataParamKindsRef` (see the call site in
-- checkBodyImpl). The predicate's kind-awareness (rowArgNames) consults that
-- table to tell a row-kinded ctor arg (`Async e a`) from a type-kinded one
-- (`List e`); running it in the early checkEffectParams pre-pass — before data
-- registration — would leave the table empty and spuriously reject `Async e a`.
checkUndeterminedRetEffVars : List Decl -> Unit
checkUndeterminedRetEffVars [] = ()
checkUndeterminedRetEffVars (d::rest) =
  let _ = checkUndeterminedRetEffVarsDecl d
  checkUndeterminedRetEffVars rest

checkUndeterminedRetEffVarsDecl : Decl -> Unit
checkUndeterminedRetEffVarsDecl (DInterface { name, typarams, methods, ... }) =
  checkIfaceMethodEffs name (declGradedScope typarams methods) methods
checkUndeterminedRetEffVarsDecl (DAttrib _ d) =
  checkUndeterminedRetEffVarsDecl d
checkUndeterminedRetEffVarsDecl _ = ()

checkIfaceMethodEffs : String -> List (String, List Kind) -> List IfaceMethod -> Unit
checkIfaceMethodEffs _ _ [] = ()
checkIfaceMethodEffs iface scope ((IfaceMethod mname mty _)::rest) =
  let _ = match undeterminedRetEffVars scope mty
    [] => ()
    bad => pushTypeErrorOnceAt "T-EFFECT-UNDETERMINED" (firstTyLoc mty) (effectUndeterminedMsg iface mname bad)
  let _ = checkArgEffVarCoverage iface scope mname mty
  checkIfaceMethodEffs iface scope rest

-- The DUAL of the #784 rule, closing the adversarial review's break 4 (and the
-- argument-only variant): an effect var's ARGUMENT-position occurrences are
-- rows an impl can PERFORM by using that argument, so the method's own rows
-- must account for them.  Two ill-formed shapes, both rejected at the
-- interface declaration:
--   * argument-only — `use : a -> (Unit -> <e> Unit) -> Int`: e rides an
--     argument but no non-argument row, so an impl applying the callback
--     performs e with no row charging it (verified launder: a pure-typed
--     wrapper prints);
--   * uncovered atoms — `act1 : a -> (Unit -> <Stdout | e> Unit) -> <e> Unit`:
--     the callback's concrete <Stdout> pours into a row declared bare <e>,
--     which a caller instantiates to <> (verified launder).  Sound iff every
--     non-argument occurrence of e covers the union of its argument-side
--     atoms, IO-expanded (`<Stdout | e>` callback with `<Stdout | e>` return
--     is accepted; so is an `<IO | e>` return).
-- Post-unify inspection CANNOT catch these: the same-tail row-unification arm
-- (`<e>` ~ `<Stdout | e>`) succeeds without recording the atom anywhere, so
-- the declaration is the only seam with the information intact.
checkArgEffVarCoverage : String -> List (String, List Kind) -> String -> Ty -> Unit
checkArgEffVarCoverage iface scope mname mty =
  checkArgEffVars
    iface
    mname
    mty
    (methodEffArgOccs mty)
    (methodEffRetOccs scope mty)
    (dedup (map fst (methodEffArgOccs mty)))

checkArgEffVars : String -> String -> Ty -> List (String, List Atom) -> List (String, List Atom) -> List String -> Unit
checkArgEffVars _ _ _ _ _ [] = ()
checkArgEffVars iface mname mty argOccs retOccs (v::rest) =
  let vrets = filterList (o => fst o == v) retOccs
  let vatoms = flatMap snd (filterList (o => fst o == v) argOccs)
  let _ = if isEmptyL vrets then pushTypeErrorOnceAt "T-EFFECT-ARG-UNCOVERED" (firstTyLoc mty) (argOnlyEffVarMsg iface mname v)
  else match retOccsEscape vatoms vrets
    [] => ()
    esc => pushTypeErrorOnceAt "T-EFFECT-ARG-UNCOVERED" (firstTyLoc mty) (argAtomsUncoveredMsg iface mname v esc)
  checkArgEffVars iface mname mty argOccs retOccs rest

-- first non-empty escape of the argument-side atoms against a non-argument
-- occurrence's declared atoms (IO-expanded via atomsEscape)
retOccsEscape : List Atom -> List (String, List Atom) -> List Atom
retOccsEscape _ [] = []
retOccsEscape vatoms ((_, declAtoms)::rest) =
  if isNonEmptyL (atomsEscape vatoms declAtoms) then
    atomsEscape vatoms declAtoms
  else
    retOccsEscape vatoms rest

-- effect-var occurrences (name, written atoms) inside ARGUMENT positions of a
-- method signature that an impl can PERFORM: rows of functions the impl can
-- CALL (odd contravariant depth) and row-kinded values it can RUN.  The
-- arrow's own row is NOT an argument position, and — round-2 adversarial
-- FP 7 — a row at EVEN depth (`((Unit -> <e> Unit) -> Int)` argument: the
-- impl receives a CONSUMER of e-callbacks and can only SUPPLY callbacks) is
-- excluded: the impl cannot perform e there, and a malicious effectful supply
-- pours its atoms into e's own cell where the post-unify atom check reads
-- them.
methodEffArgOccs : Ty -> List (String, List Atom)
methodEffArgOccs (TyConstrained _ t) = methodEffArgOccs t
methodEffArgOccs (TyEffect _ _ t) = methodEffArgOccs t
methodEffArgOccs (TyFun a b) = argPerformableOccs True a ++ methodEffArgOccs b
methodEffArgOccs _ = []

-- rows in an argument subtree, collected only where [perf] (the impl can call
-- or run the value at this position); each arrow-LHS descent flips it.
argPerformableOccs : Bool -> Ty -> List (String, List Atom)
argPerformableOccs perf (TyEffect labels (Some n) t) = (if perf then [(n, atomsOfWritten labels)] else [])
  ++ argPerformableOccs perf t
argPerformableOccs perf (TyEffect _ None t) = argPerformableOccs perf t
-- A bare row atom (#997) carries its own tail var + labels directly (no
-- wrapped type to recurse into) — same treatment as the `TyEffect` arms
-- above.  Without this, a KRow ctor-arg written as `Box <Stdout | e> Int`
-- (as opposed to a bare `Box e Int`) was invisible to this collector, which
-- made the impl-body T-EFFECT-LAUNDER check over-fire on it (see
-- `effVarOccAtoms` below, which shares this gap).
argPerformableOccs perf (TyRow labels (Some n) _) =
  if perf then
    [(n, atomsOfWritten labels)]
  else
    []
argPerformableOccs perf (TyRow _ None _) = []
argPerformableOccs perf (TyFun a b) = argPerformableOccs (not perf) a
  ++ argPerformableOccs perf b
argPerformableOccs perf (TyTuple ts) = flatMap (argPerformableOccs perf) ts
argPerformableOccs perf (TyApp a b) = match tyAppSpine (TyApp a b)
  -- OCCURRENCE MINT (#1110/#1111 A-2.3): the head's acquired identity, read off
  -- the same record pattern as its name so the two cannot drift apart.
  (TyCon { tyConName = n, tyConOrigin = o }, args) => krowSlotOccs perf o n args
  _ => argPerformableOccs perf a ++ argPerformableOccs perf b
argPerformableOccs perf (TyConstrained _ t) = argPerformableOccs perf t
argPerformableOccs _ _ = []

-- ── #1111 A-2.3: the TYPE-namespace table key, and the MISS POLICY ────────
-- The ONE place a key for `aliasTableRef` / `dataParamKindsRef` is minted, on
-- both the write side and the read side.  `o` is always the `TyConOrigin` the
-- `Ty.TyCon` being registered or elaborated carries — never ambient state (see
-- `registerVariants`' 🚨 note: `registerAllData` runs over OTHER modules'
-- decls, so a "current module" id would attribute every imported type to the
-- importer).
--
-- ── What changed, and what drains ─────────────────────────────────────────
-- Both tables are grown per-module across the WHOLE import graph and used to
-- be read by BARE NAME, so `lookupAssoc`'s first-match over a prepend meant
-- THE MODULE THAT REGISTERED LAST WON for every importer, regardless of which
-- module's type was actually in scope at the use site.  Three tracked defects
-- were that one sentence: #1069 (a written row erased to its wrapped type,
-- silently, exit 0), #1090 (the same table rejecting a VALID signature with
-- T-ROW-KIND-MISMATCH — same collision, opposite symptom, selected by the
-- row's SPELLING at the use site, not by arity) and #1070's alias row (`v : T`
-- resolving to the wrong module's `Float`, wrong VALUE at run time, all three
-- engines agreeing).
--
-- ── MISS POLICY: a miss stays a silent `appFallback`.  Derivation ─────────
-- Every path that reaches `appFallback` (or the equivalent abstention at the
-- other readers) after this change, enumerated:
--   1. A BUILTIN HEAD.  `Int`/`Float`/`String`/`Char`/`Bool`/`Unit`/`List`/
--      `Ref`/`Array` and the tuple heads have NO declaration anywhere (checked
--      tree-wide, not assumed: no `data`/`newtype`/`type` declares any of those
--      names in `stdlib/`, `compiler/` or `sqlite/`), so they have no row in
--      either table and never had one.  This is the case the pre-existing
--      comment on `checkGradedImplHead` already names ("a builtin like `Int`,
--      whose kinds this compiler records nowhere").  It is COMMON and CORRECT.
--   2. AN ALIAS HEAD looked up in `dataParamKindsRef` — an alias lives in the
--      other table, and its saturation is already policed by T-ALIAS-ARITY.
--   3. AN ARITY MISMATCH (`listLen kinds /= listLen args`) — a guard the hot
--      readers apply AFTER the lookup; unchanged by this unit.
--   4. A NAME WITH NO DECLARATION AT ALL, in a program resolve has already
--      rejected — errors accumulate here rather than exiting, so typecheck
--      still runs over the broken tree.
--   5. NEW WITH THIS UNIT: a head whose identity names a module that declares
--      no such type, while some OTHER module in the graph does.  That is
--      exactly #1069/#1090/#1070, and abstaining is the FIX, not a residual.
-- So "miss ⇒ hard diagnostic" is not available: case 1 alone would reject
-- every `x : List Int` ever written, and nothing at the read site can tell
-- case 1 from case 5 — the compiler records no kinds for builtins, which is
-- the very reason case 1 exists.  Cases 2–4 are equally legitimate.  A miss
-- therefore keeps doing what it does today.
-- ⚠️ Note what this does NOT say: the drains above do not come from the miss
-- policy, they come from the KEY.  Under bare-name keying #1069's lookup HIT
-- the wrong module's row; under identity keying it HITS ITS OWN row.  Case 5
-- is the residue (a genuinely absent type), not the mechanism.
--
-- ── THE IDENTITY-LESS PATH, and why it is not a bare-name fallback ────────
-- 🚨 RESIDUAL, and A-2's stated bound — but NOT "no identity is built at all":
-- on the FLAT / single-file driver path the table holds BOTH populations at
-- once.  `checkProgramSeededSplit` (`:14219`) runs `stampDeclOrigins "core"
-- coreProgTy`, so the PRELUDE's own `DData`/`DNewtype`/`DTypeAlias`/
-- `DInterface` decls carry `OriginModule "core"` and register through
-- `registerAllData` → `recordParamKinds` → `tyTabKey` as identity-bearing
-- `TkIdent` rows.  Every FLAT **USER** declaration, by contrast, carries
-- `OriginUnresolved` (`stampFlatTyOrigins`, `frontend/resolve.mdk`) — for
-- those `mkIdent` returns `None`, so they key as `TkBare`.  That path is
-- `medaka check` on a no-import file, the LSP, `doc`, `repl` and the
-- playground.  A-2's MODULE-PATH-ONLY bound is specifically about the USER
-- half: giving the flat path's own declarations identity is drained by #1115
-- (E-1), which gives that path module ids.  Greppable here and in
-- `frontend/ast.mdk` as the Module-path-only bound.
--
-- What makes a table holding both populations SAFE is per-population
-- STAMPING AGREEMENT, not the miss policy: an occurrence and the declaration
-- it names are always stamped by the SAME pass reading the SAME scope, so a
-- `TkIdent` occurrence never meets a `TkBare` declaration of the same name,
-- or vice versa.  Checked, not asserted: `flatTyOriginScope`
-- (`frontend/resolve.mdk:4111-4117`) derives its scope from exactly
-- `dataRecordNames coreDecls ++ interfaceNamesOf coreDecls` — precisely the
-- decl set `stampDeclOrigin` covers (`dataRecordNames` reaches
-- `DData`/`DNewtype`/`DTypeAlias`; `interfaceNamesOf` reaches `DInterface`).
-- That agreement is what is verified here; it says nothing about whether the
-- flat USER half ever gets identity, which is the #1115 residual above, not
-- this paragraph's claim.
--
-- ⚠️ `TkBare` IS NOT A FALLBACK THE MODULE PATH CAN REACH.  `tabKeyEq`
-- (`types/registry.mdk`) never equates a `TkIdent` with a `TkBare`, in either
-- direction, so an identity-bearing lookup can neither hit a bare row nor be
-- hit by one — re-creating the bug "with extra steps" is structurally
-- excluded rather than avoided by care.  What makes that safe rather than a
-- new silent hole is that the two halves cannot MIX within one run: an
-- occurrence acquires identity only from `tyOriginScope`/`flatTyOriginScope`,
-- whose every layer is derived from declarations that the SAME pass stamps
-- (own / imported / prelude), plus a builtin layer whose names have no
-- declarations (case 1 above).  So "identity-bearing occurrence, unstamped
-- declaration" — the one shape that would turn a former hit into a miss —
-- has no producer.
tyTabKey : TyConOrigin -> String -> TabKey
tyTabKey o n = tabKeyOf NsType o n

-- ── #1111 A-2.4: the INTERFACE-namespace table key ────────────────────────
-- `tyTabKey`'s peer for the `NsIface` namespace, and the ONE place a key in that
-- namespace is minted — on both the write side and the read side.  ⚠️ #1557 A-3.5c:
-- `ifaceParamKindsRef` was one of the two tables named here and is RETIRED; the
-- other was `universeIfaceRequiredRef`, RETIRED in turn by #1557 A-3.5a.  The
-- surviving consumer is stage K's `CE` alone — `ceRowKey`/`ceLookupAt`, and through
-- it `ceRequiredAt` (impl completeness), `ceSlotKindsAt` (graded impl heads) and
-- `ifaceDfsCycleOneSuper`'s superinterface edge.
--
-- ── The two sides, and WHY they meet ──────────────────────────────────────
-- The WRITE side always passes a `DInterface`'s `ifaceOrigin`: the DECLARATION
-- layer, stamped by `stampDeclOrigins mid` (`frontend/resolve.mdk`) with the
-- module that declared it.  The READ side always passes a `DImpl`'s
-- `implOrigin`: the OCCURRENCE layer, stamped by `stampTyOrigins` from
-- `tyOriginScope`, which maps an interface NAME to the module that DECLARED
-- it (own layer `ownIfaceOrigin mid`, imported layer `importedTypeOrigins`).
-- So both sides name the DECLARING module and the two meet — that agreement,
-- not the miss policy, is what makes this key work.  It is the same
-- per-population stamping-agreement argument A-2.3 wrote onto `tyTabKey`,
-- one namespace over; both layers are produced by `stampOneModule`
-- (`resolve.mdk`), in one function, so they cannot drift apart.
-- Checked, not assumed: `test/origin_fixtures/graph/agreement.golden` records
-- `alpha iface:Weighable … graph=mod:alpha` for a user interface and
-- `iface:<Name> 1 mod:core` for every prelude one.
--
-- ── MISS POLICY: a miss ABSTAINS.  Derivation ─────────────────────────────
-- Both readers already abstain on a miss and this unit does not change that:
--   * `implCompletenessMsgsOfMap`'s `None` arm is `[]` with the pre-existing
--     comment "unknown interface (reported elsewhere) → skip".  An `impl` of
--     an interface that is genuinely not in scope is reported by RESOLVE
--     (`R-*`), so a second complaint here would be a worse-worded duplicate.
--   * `checkGradedImplTys`' `_ =>` arm is `()`, and its own doc-comment
--     already enumerates the legitimate misses (a NON-graded interface, which
--     records an all-`KType` row and is filtered by `anyKRow`; an interface
--     with fewer parameters than the impl has type arguments).
-- "Miss ⇒ hard diagnostic" is therefore not available for either, and it is
-- not a residual: with an identity key the ONLY new miss is "this impl's
-- interface resolved to a module that declares no such interface", which
-- cannot happen for an accepted program — resolve rejects the impl first.
--
-- ── THE IDENTITY-LESS PATH ────────────────────────────────────────────────
-- 🚨 Same MODULE-PATH-ONLY bound A-2.3 recorded, and for the interface
-- namespace it bites HARDER, because this key is minted on BOTH driver arms:
-- `checkGradedImplHeads` is called from `checkBodyImpl`, which Flat and Module
-- share, and since #1557 A-3.5c the relocated cycle walk mints it on both arms too
-- (`flatClassEnvOf` on Flat, `deIfaces` on Module).  On the FLAT path `checkProgramSeededSplit` runs
-- `stampDeclOrigins "core" coreProgTy`, so the PRELUDE's interfaces are
-- `TkIdent`; every flat USER interface is `OriginUnresolved` and keys
-- `TkBare`, and so does a flat user `impl`'s `implOrigin` — the two halves
-- still meet, because they are stamped by the same pass over the same scope.
-- That is why `RegKey` had to grow a bare half for this unit (see its
-- doc-comment in `types/registry.mdk`): an `Ident`-only key would have made
-- every flat interface unregisterable, silently switching the graded
-- instance-head kind check OFF for `medaka check` on a no-import file.
-- Giving the flat path real identity is #1115 (E-1), not this unit.
--
-- ⚠️ ONE CROSS-POPULATION SHAPE EXISTS AND IT IS UNREACHABLE, NOT MERELY
-- UNLIKELY: a FLAT program declaring `impl <prelude iface> T`.  Its
-- `implOrigin` is stamped from `flatTyOriginScope`, which DOES carry the
-- prelude's own interfaces as `mod:core` (`resolve.mdk`, the `ifaceDeclaredIn
-- "core"` term), so such an impl keys `TkIdent … core` and meets the
-- prelude's own `TkIdent … core` declaration row.  The mismatch shape would
-- need a flat impl of a prelude interface whose occurrence was NOT in that
-- scope, and there is no such producer: the scope is built from exactly
-- `interfaceNamesOf coreDecls`, the same decl list `stampDeclOrigins "core"`
-- stamps.
--
-- ⚠️ AND THAT ARGUMENT IS STRUCTURAL, ONLY STRUCTURAL.  This paragraph used to
-- end "Verified behaviourally, not only by reading", citing
-- `test/typecheck_error_fixtures/graded_head_wrong_kind_flat.mdk`.  That
-- fixture cannot witness it: it declares its OWN `interface Graded`, so what it
-- exercises is a `TkBare` ↔ `TkBare` meeting, not the `TkIdent … core` ↔
-- `TkIdent … core` one this paragraph is about.  No fixture witnesses this
-- shape, and today none CAN: the FLAT arm reads only the graded slot kinds (the
-- completeness table is Module-only — see the mode switch feeding
-- `checkImplCompletenessMap`), and there a HIT on a non-graded prelude row and
-- an outright MISS both take `checkGradedImplTys`' `_ => ()` arm.  A prelude
-- interface would have to become GRADED for the difference to be observable at
-- all.  None is — DERIVE that, do not trust this sentence: a single file with
-- `impl <each higher-kinded prelude iface> Q` over `data Q a b = MkQ a b`, plus
-- one locally-declared graded interface as a POSITIVE CONTROL, yields exactly
-- ONE T-IMPL-KIND-MISMATCH and it names the LOCAL interface (run against this
-- HEAD, `medaka check --json`).  So the unreachability claim above rests on
-- reading `resolve.mdk`; the residual risk is this comment rotting, not a
-- missing gate.
ifaceTabKey : TyConOrigin -> String -> TabKey
ifaceTabKey o n = tabKeyOf NsIface o n

-- one ctor node: its bare row-kinded slots (if performable) + recurse the args
krowSlotOccs : Bool -> TyConOrigin -> String -> List Ty -> List (String, List Atom)
krowSlotOccs perf o n args = match lookupTab (tyTabKey o n) perRun.value.dataParamKindsRef.value
  Some kinds if listLen kinds == listLen args => (if perf then map (n2 => (n2, [])) (krowArgVarNames kinds args) else [])
    ++ flatMap (argPerformableOccs perf) args
  _ => flatMap (argPerformableOccs perf) args

-- effect-var occurrences in NON-argument positions: each spine arrow's own row,
-- plus every occurrence inside the final return type (nested rows and bare
-- row-kinded ctor-arg slots).
methodEffRetOccs : List (String, List Kind) -> Ty -> List (String, List Atom)
methodEffRetOccs scope (TyConstrained _ t) = methodEffRetOccs scope t
methodEffRetOccs scope (TyEffect labels (Some n) t) =
  (n, atomsOfWritten labels) :: methodEffRetOccs scope t
methodEffRetOccs scope (TyEffect _ None t) = methodEffRetOccs scope t
methodEffRetOccs scope (TyFun _ b) = methodEffRetOccs scope b
methodEffRetOccs scope t = effVarOccAtoms t
  ++ map (n => (n, [])) (rowArgNamesIn scope t)

argOnlyEffVarMsg : String -> String -> String -> String
argOnlyEffVarMsg iface mname v = "Argument-only effect variable <\{v}> in method '\{mname}' of interface '\{iface}': <\{v}> rides an argument (a callback or row-kinded value) but appears in none of the method's own effect rows, so an impl that uses that argument performs <\{v}> with no row charging it — a caller can pass an effectful callback to a method typed pure and it silently runs. Thread <\{v}> through the method's row (e.g. `-> <\{v}> …`), or drop it from the argument."

argAtomsUncoveredMsg : String -> String -> String -> List Atom -> String
argAtomsUncoveredMsg iface mname v esc = "Effect variable <\{v}> in method '\{mname}' of interface '\{iface}' carries <\{renderAtoms esc}> at an argument position, but a method row carrying <\{v}> does not include it: an impl that uses that argument performs <\{renderAtoms esc}> on a row a caller can instantiate to <>, laundering it. Declare <\{renderAtoms esc}> (or `<IO | \{v}>`) at every row where <\{v}> appears, or remove the concrete label from the argument's row."

-- The predicate: return-position effect tail vars minus argument-carried ones.
-- An effect var is argument-carried — hence soundly pinned at every call site —
-- ONLY by a ROW-KINDED occurrence in an argument. The test is kind-aware, NOT
-- name-based: a Row-kinded effect var and a Type-kinded type var may share a
-- spelling yet be independent variables, so a Type-kinded `e` in `List e` /
-- `Box e` pins NOTHING about the return row `<e>` — counting it would relaunder
-- the effect (#784). The two sound argument-carriers:
--   * a callback's latent arrow effect (`(a -> <e> b)`) — a Row-kinded effect
--     row, captured by effTailNames over each arg;
--   * a row-kinded type-CONSTRUCTOR argument (`Async e a`, where Async's first
--     param has kind Row) — captured by rowArgNames, which consults the ctor's
--     recorded param kinds (dataParamKindsRef) and takes ONLY the tyvars sitting
--     in a KRow slot. `List e`/`Box e` (Type-kinded param) contribute nothing.
-- An effect tail var in the RETURN row and in no such Row-kinded argument slot
-- is the laundering hazard (map/fold/traverse/`Async e a` are pinned;
-- `speak : a -> <e> String` and `speak : a -> List e -> <e> String` are not).
-- An abstract row-ctor arg (`r e a`, `r` a type variable) is conservatively
-- rejected — no real interface method has that shape, and matching it soundly
-- would need per-argument kind inference we do not run here.
undeterminedRetEffVars : List (String, List Kind) -> Ty -> List String
undeterminedRetEffVars scope sig =
  let args = methodArgs sig
  let argCarried = dedup (flatMap effTailNames args ++ flatMap (rowArgNamesIn scope) args)
  let retTail = dedup (effTailNames (methodRet sig))
  removeAllS argCarried retTail

-- return type of a method: strip leading constraint wrappers and arrows, but
-- KEEP a trailing effect row so its tail var is visible (unlike methodArgs,
-- which peels it).
methodRet : Ty -> Ty
methodRet (TyConstrained _ t) = methodRet t
methodRet (TyFun _ b) = methodRet b
methodRet t = t

renderEffTailVars : List String -> String
renderEffTailVars vs = joinWith ", " (map (v => "<\{v}>") vs)

effectUndeterminedMsg : String -> String -> List String -> String
effectUndeterminedMsg iface mname vars = "Under-determined effect variable \{renderEffTailVars vars} in method '\{mname}' of interface '\{iface}': the effect appears only in the method's return type, pinned by no argument, so a caller can instantiate it to <> and launder the real effect (a function typed pure would silently perform it). Use a concrete effect row (e.g. `<Stdout>`) or thread the effect through an argument (e.g. a callback `a -> <e> b`)."

-- #822 (graded interfaces): an instance head must have the KIND the interface's
-- corresponding type parameter has.  A graded interface binds the whole row-indexed
-- FAMILY — `impl GThenable Async`, never a fixed row like `impl GThenable (Async e)`
-- (EFFECTS-SEMANTICS §6, DICT-SEMANTICS §3) — so the head's REMAINING parameter
-- kinds (its declared kinds minus the ones the head already applied) must equal the
-- interface slot's kinds.
--
-- This is a soundness guard, not polish.  A kind-mismatched head elaborates the
-- method type's KRow slot to a `TEff` row while the constructor's own scheme has a
-- plain tyvar in that position, and `unify` binds a tyvar to a TEff without
-- complaint: the impl would be ACCEPTED and its grade would mean nothing — every
-- index a caller reads off the result would be a fabrication.
--
-- Only interfaces that actually HAVE a graded slot are JUDGED — the `anyKRow want`
-- guard below is what does that, not the table: every slot of every interface is
-- recorded (it always was, and `ceRowParamKinds` keeps doing so), and an all-`KType`
-- row falls into the same `_ => ()` arm an outright miss does.  ⚠️ This paragraph
-- read *"only interfaces that actually HAVE a graded slot are inspected
-- (ifaceParamKindsRef records nothing else)"* until #1557 A-3.5c, and the
-- parenthetical was false of the retired table too.  Runs on BOTH whole-program
-- paths: its one call site is in checkBodyImpl, shared by Flat and Module,
-- immediately after `dataEnv` has populated the head-constructor kind table.
--
-- 🚨 #1557 A-3.5c: IT STILL ITERATES `prog`, AND THAT IS THE UNIT'S DEFINING
-- CONDITION, not an implementation detail.  The owner ruling that split A-3.5c
-- out of the A-3b lane (issue #1557, 2026-08-12) is CONDITIONAL: this check
-- qualifies as CE-only *"only if the graded impl-head kind check keeps
-- iterating `prog` rather than `IE.ieRows`"*.  The impl HEADS come from the
-- decl list; only the interface's declared slot kinds come from stage K's `CE`.
-- Whoever re-points this walk at `IE.ieRows` has re-classified the unit as A-3b
-- by construction — that is a routing decision, not a refactor.
checkGradedImplHeads : ClassEnv -> Int -> List Decl -> Unit
checkGradedImplHeads _ _ [] = ()
checkGradedImplHeads ce cur (d::rest) =
  let _ = checkGradedImplHeadDecl ce cur d
  checkGradedImplHeads ce cur rest

-- OCCURRENCE MINT (#1110/#1111 A-2.4): `implOrigin` is the identity the
-- interface NAME in `impl <iface> …` acquired at resolve — read off the same record
-- pattern as the name itself so the two cannot drift apart, exactly as A-2.3 reads
-- `tyConOrigin` beside `tyConName`.
checkGradedImplHeadDecl : ClassEnv -> Int -> Decl -> Unit
checkGradedImplHeadDecl ce cur (DAttrib _ d) = checkGradedImplHeadDecl ce cur d
checkGradedImplHeadDecl ce cur (DImpl { iface, tys, implOrigin = o, ... }) =
  checkGradedImplTys ce cur o iface 0 tys
checkGradedImplHeadDecl _ _ _ = ()

-- 🚨 #1557 A-3.5c — THE `CE` READER FLIP, and the retirement it pays for.
--
-- WAS: `lookupReg (ifaceSlotKey o iface i) perRun.ifaceParamKindsRef.value` — a
-- per-run assoc list grown by `registerIfaceParamKindsGo` during each module's own
-- pass and carried ACROSS modules by `crossRun.universeIfaceParamKinds`, one of the
-- five tables `loadDataUniverse`/`storeDataUniverse` marshalled in lockstep AT THE
-- TIME THIS UNIT LANDED.  ⚠️ THAT "five" IS HISTORY, NOT THE LIVE SHAPE — #1512
-- slices 2+3 retired two more cells immediately afterwards.  DERIVE the survivors
-- from the two bodies (see their own header, which says the same thing).  Both
-- of those cells are GONE, not merely unread: this was their ONLY reader, so leaving
-- them would have left two sources of truth for "what kind is this interface's slot"
-- (design law L1) and the `cross_allowed` ratchet would still carry the row this
-- unit exists to retire.  The `CE` block's own header assigned that retirement to
-- *"whatever PR first gives `ceParamKinds` a live reader"* — this line is it, and
-- `CE` stops being shelf-ware here.
--
-- NOW: `ceSlotKindsAt` — the whole-graph `CE`, filtered to THIS module's ordinal
-- prefix through `ceLookupAt`, the ONE `CE` read accessor and the ONE place
-- `declEnvVisibleAt` is applied to `CE`.  ⚠️ This said "A-3.6 remains the deletion
-- of that predicate's body"; A-3.6 (#1558) SPLIT the predicate instead and `CE`
-- KEPT ITS ORDINAL FILTER — `CE` is an interface-IDENTITY axis, not I5's instance
-- axis, and only the latter was licensed to go graph-global.  The filter stays ON
-- here, now permanently rather than transitionally.
--
-- WHY THIS IS JUDGMENT-PRESERVING, and where it is NOT.  The KEY does not move:
-- `ifaceSlotKey` was already `regKeyTabAt (ifaceTabKey o iface) i` since A-2.4, and
-- `ceRowKey` is `regKeyOfTab (ifaceTabKey o name)` with the slot supplied
-- positionally — same identity, same mint, so this relocation carries NO #1258-class
-- acceptance delta of its own (unlike A-3.5b's, whose lookup is bare-name today).
-- The CONTENT does not move either: `ceRowParamKinds` is `map (p => ifaceParamKindsOf
-- p methods) typarams`, the identical pure computation the retired writer performed
-- per slot.  What DOES move is the POPULATION's provenance — the marshalled prefix
-- becomes the ordinal-filtered prefix — and those two agree because ordinals are
-- assigned in the loader's dependency-first order, the same order `foldModules`
-- grows the accumulator in.  The `Flat` arm keeps its own single-module `CE` built
-- from the very decl list `registerAllData` used to walk, so nothing switched off
-- there: see `classEnvHere` at the call site (named `gradedClassEnv` until #1557
-- A-3.5a gave it a second consumer, impl-completeness), and note that silently switching this
-- check OFF for a no-import `medaka check` is exactly the loud→silent regression the
-- ordinal machinery would otherwise have caused (`declEnvsRef` is EMPTY on Flat).
--
-- ⚠️ THE PARAGRAPH THAT USED TO BE HERE IS NOW WRONG IN ITS CONCLUSION, so it is
-- corrected rather than deleted — a reader who remembers it would otherwise think
-- this table is still bare-name-keyed.  It said the key is `<iface>@<slot>` with "no
-- module qualifier", that keying it properly "would need a resolved module identity,
-- and typecheck.mdk carries none for an interface", and that this was "#1047's
-- territory".  All three are now false: `DImpl` carries `implOrigin` and `DInterface`
-- carries `ifaceOrigin` (#1110 Stage A-1), the key is a `RegKey` minted by
-- `ifaceTabKey` + `regKeyTabAt`, and #1047 was closed by PR #1264 in the BACKEND
-- (`CImplDefault`'s interface identity), not here.  What REMAINS true and is worth
-- keeping: the reason no elaboration seam may read this table.  A flat table keyed by
-- a bare `String` and populated across module boundaries is last-write-wins with a
-- SILENT loss — the root cause behind the eval-frame ctor collision, #1044, #1047, and
-- the first cut of #822 itself, where this table was ALSO keyed by the bare typaram
-- name and re-kinded every arity-matching application in the program.  Choosing a
-- namespace that is merely *less likely* to clash is not a fix: #1044 was CREATED by
-- relocating exactly this defect to a rarer namespace.  So every seam that turns a
-- method signature into a Mono still takes its scope from the DECLARATION
-- (`declGradedScope`) or from the very resolution result that produced the signature
-- (`ifaceMethodTyResolved`, which carries the scope in the same tuple as `mty` so the
-- two cannot be resolved differently).  Identity-keying this table does not license
-- an elaboration seam to start reading it.
--
-- What the re-key DRAINS is #1257: two same-named interfaces, one graded, one not,
-- in unrelated modules — the impl was judged against whichever registered LAST, so
-- `impl Same P` (naming `pmod.Same`, ungraded) was rejected with T-IMPL-KIND-MISMATCH
-- for failing `gmod.Same`'s `Row -> Type -> Type`.  Import order selected the symptom.
checkGradedImplTys : ClassEnv -> Int -> TyConOrigin -> String -> Int -> List Ty -> Unit
checkGradedImplTys _ _ _ _ _ [] = ()
checkGradedImplTys ce cur o iface i (t::rest) =
  let _ = match ceSlotKindsAt (regKeyOfTab (ifaceTabKey o iface)) cur i ce
    Some want if anyKRow want => checkGradedImplHead iface t want
    _ => ()
  checkGradedImplTys ce cur o iface (i + 1) rest

-- [want] is the interface slot's kind list.
--
-- Only a head whose kind is actually KNOWN is judged, and the two ways it can be
-- unknown are BOTH deliberate abstentions, not oversights:
--   * a type ALIAS head lives in aliasTableRef, never in dataParamKindsRef, and its
--     saturation is already policed by T-ALIAS-ARITY — a kind complaint here would be
--     a second, worse-worded report of the same defect;
--   * a head absent from dataParamKindsRef entirely — a builtin like `Int`, whose kinds
--     this compiler records nowhere.  Abstaining costs nothing real: a genuinely wrong
--     head still fails on its method bodies, where the mismatch is concrete and located.
--     ⚠️ An ABSTRACTLY-exported data type (`export data Asy e a`) USED to land here too,
--     cross-module, and the abstention was load-bearing for it: judging it reported a
--     correct program rejected and told the author to add a `Row` parameter the type
--     ALREADY HAD.  #804/#1028 fixed that at the source — an opaque type's kinds are
--     published cross-module (`kindPublicDataDecl`'s `VisAbstract` arm; it was
--     `registerOpaqueParamKinds` until A-3.2b retired the kind universe) — so an
--     abstract head is now judged on its REAL kinds like any other, and this arm no
--     longer covers for it.
-- A head that is not a TyCon spine at all is judged where it can be: a saturated
-- TUPLE is kind `Type`, which is never a graded slot's kind, so it is reported; a bare
-- tyvar head carries no kind and is left to the checks that already reject it.
checkGradedImplHead : String -> Ty -> List Kind -> Unit
checkGradedImplHead iface t want = match tyAppSpine t
  (TyCon { tyConName = n, tyConLoc = loc, tyConOrigin = o }, applied) =>
    checkGradedImplHeadCon iface o n loc (listLen applied) want
  -- A saturated tuple is kind `Type`, which is never a graded slot's kind.  It gets its
  -- OWN remedy: the generic "give it a Row parameter" advice is nonsense for a tuple —
  -- you cannot add one.  ⚠️ The span is best-effort: `TyTuple` carries no loc of its own
  -- and `TyVar` carries none either, so `impl I (a, b)` genuinely has no span to point at
  -- and reports unlocated.  Fabricating a nearby one would be worse than saying nothing.
  (TyTuple ts, _) => pushTypeErrorOnceAt
    "T-IMPL-KIND-MISMATCH"
    (firstTyLocList ts)
    (implTupleHeadKindMsg iface (listLen ts) want)
  _ => ()

checkGradedImplHeadCon : String -> TyConOrigin -> String -> Option Loc -> Int -> List Kind -> Unit
checkGradedImplHeadCon iface o n loc nApplied want = match headRemainingKinds o n nApplied
  None => ()
  Some got => checkGradedImplHeadKinds iface n loc nApplied want got

-- The head constructor's declared parameter kinds MINUS the ones the head already
-- applies (`impl I (Async e)` supplies one).  `None` = "this head's kind is not
-- knowable here" (an alias or a builtin), which the caller treats as an abstention.
-- ⚠️ An abstractly-exported type was in that bucket until #804/#1028 and is NOT any
-- more — `kindPublicDataDecl`'s `VisAbstract` arm gives it a real `dataParamKindsRef`
-- entry (via `declEnvSeedChain`), so it returns `Some` and is judged exactly like
-- a `public export` one.
-- `key` is minted ONCE and shared by both guard arms via the `where` (#1111
-- A-2.3 follow-up): the first guard ALWAYS evaluates it (Medaka is strict, and
-- a `where` scoping over guard arms lowers to `ELetGroup (..key..) (EGuards
-- arms)`, so the binding runs once before either arm is tested), so hoisting
-- adds nothing on the alias arm and removes the previously-redundant second
-- mint on the common `otherwise` arm.  A redundant-allocation removal, not a
-- measured perf win (`test/bench.sh` doesn't run on this box, #1187; the
-- perf-scaling gate grades a growth ratio, blind to a constant factor).
headRemainingKinds : TyConOrigin -> String -> Int -> Option (List Kind)
headRemainingKinds o n nApplied
  | isSome (lookupTab key perRun.value.aliasTableRef.value) = None
  | otherwise = map (dropFirst nApplied) (lookupTab key perRun.value.dataParamKindsRef.value)
  where
    key = tyTabKey o n

checkGradedImplHeadKinds : String -> String -> Option Loc -> Int -> List Kind -> List Kind -> Unit
checkGradedImplHeadKinds iface n loc nApplied want got
  | kindsEq got want = ()
  | otherwise = pushTypeErrorOnceAt "T-IMPL-KIND-MISMATCH" loc (implKindMismatchMsg iface n nApplied want got)

renderKindArrow : List Kind -> String
renderKindArrow ks = joinWith " -> " (map kindName ks ++ ["Type"])

kindName : Kind -> String
kindName KType = "Type"
kindName KRow = "Row"

-- ⚠️ [ctor] is a RAW head tag and must reach the reader through `ppConName` — a tuple
-- head arrives as `__tuple2__`, and leaking that is exactly what ppConName exists to
-- prevent.
implKindMismatchMsg : String -> String -> Int -> List Kind -> List Kind -> String
implKindMismatchMsg iface ctor nApplied want got = "Instance head has the wrong kind for interface '\{iface}': the interface's type parameter is graded — kind `\{renderKindArrow want}` — but \{implHeadKindClause ctor nApplied got}, so the grade the methods index by has nowhere to live and every index a caller reads off a result would be fabricated. \{implKindMismatchFix iface ctor nApplied}"

-- The "but …" clause: an UNAPPLIED head states its own kind; a partially applied one
-- (`impl I (Async e)` — the fixed-row shape a graded interface forbids) must say so,
-- because the leftover kind is NOT the constructor's kind and reporting it as such is
-- simply false (`Async` is `Row -> Type -> Type`; `Async e` is `Type -> Type`).
implHeadKindClause : String -> Int -> List Kind -> String
implHeadKindClause ctor nApplied got
  | nApplied <= 0 = "`\{ppConName ctor}` has kind `\{renderKindArrow got}`"
  | otherwise = "this head already applies \{intToString nApplied} argument(s) to `\{ppConName ctor}`, leaving kind `\{renderKindArrow got}`"

-- The remedy, conditioned on which mistake was actually made.  Telling an author who
-- wrote `impl GThenable Box` to "write `impl GThenable Box`" is a tautology — that
-- advice is only useful when the head was APPLIED, where dropping the argument is
-- literally the fix.
implKindMismatchFix : String -> String -> Int -> String
implKindMismatchFix iface ctor nApplied
  | nApplied > 0 = "A graded interface binds the whole row-indexed FAMILY, never a fixed-row application: drop the argument(s) and write `impl \{iface} \{ppConName ctor}`."
  | otherwise = "Give `\{ppConName ctor}` a parameter used in an effect position at each `Row` slot — a constructor field of the shape `Unit -> <e> a` is what makes a parameter row-kinded — or implement a non-graded interface for it instead."

-- A saturated TUPLE head, which needs its own message: a tuple is kind `Type` and cannot
-- be given a row parameter, so the ordinary "add a `Unit -> <e> a` field" remedy would
-- send the author after something that does not exist.
implTupleHeadKindMsg : String -> Int -> List Kind -> String
implTupleHeadKindMsg iface n want = "Instance head `\{ppConName (tupleHeadTagTc n)}` has the wrong kind for interface '\{iface}': the interface's type parameter is graded — kind `\{renderKindArrow want}` — but a saturated tuple type is always kind `Type`, so there is no slot for the grade the methods index by. A tuple cannot be given a row parameter; implement a non-graded interface for it, or use a row-indexed data type (one with a constructor field of the shape `Unit -> <e> a`) as the instance head."

checkEffectParamsTy : Ty -> Unit
checkEffectParamsTy (TyFun a b) =
  let _ = checkEffectParamsTy a
  checkEffectParamsTy b
checkEffectParamsTy (TyApp a b) =
  let _ = checkEffectParamsTy a
  checkEffectParamsTy b
checkEffectParamsTy (TyTuple ts) = checkEffectParamsTys ts
checkEffectParamsTy (TyEffect labels _ t) =
  let _ = checkEffectAtoms labels
  checkEffectParamsTy t
-- A bare row atom (#997) carries written effect params exactly like
-- `TyEffect` above (`Async <Net "example.com"> Unit` must be domain-checked
-- the same as the degenerate `Async (<Net "example.com"> Unit) Unit`) —
-- without this arm the bare spelling silently skipped `T-EFFECT-PARAM`
-- domain validation entirely (S1: a way to mint an invalid `Net` capability
-- no other spelling admits).
checkEffectParamsTy (TyRow labels _ _) = checkEffectAtoms labels
checkEffectParamsTy (TyConstrained _ t) = checkEffectParamsTy t
checkEffectParamsTy _ = ()

checkEffectParamsTys : List Ty -> Unit
checkEffectParamsTys [] = ()
checkEffectParamsTys (t::ts) =
  let _ = checkEffectParamsTy t
  checkEffectParamsTys ts

checkEffectAtoms : List (String, Option String) -> Unit
checkEffectAtoms [] = ()
checkEffectAtoms ((_, None)::rest) = checkEffectAtoms rest
checkEffectAtoms ((l, Some pat)::rest) =
  let _ = checkOneEffectParam l pat
  checkEffectAtoms rest

checkOneEffectParam : String -> String -> Unit
checkOneEffectParam l pat = match dtopFor l
  PPrefix None =>
    -- v2 Stage 2b: the inferred hole "_" carries no written pattern to validate.
    if isHoleStr pat then ()
    else if prefixPatternOk pat then ()
    else pushTypeError "T-EFFECT-PARAM" (effectParamMsg l (prefixPatternErrMsg "pattern" pat))
  PSet None =>
    -- Set-domain param is a brace-set literal `{a,b}` (parser-encoded); always well-formed.
    ()
  PProduct _ =>
    checkProductAxes l (decodeProductParam pat)
  _ => pushTypeError "T-EFFECT-PARAM" (effectParamMsg l
    "label '\{l}' is atomic and takes no parameter (declare it `effect \{l} Prefix` to parameterize)")

-- WS-4: validate a decoded product's axes: a Host (Prefix) axis must pass
-- prefixPatternOk; a Method (Set) axis is always well-formed; any other axis name
-- is rejected (only Host/Method are known product axes for Net).
checkProductAxes : String -> Param -> Unit
checkProductAxes l (PProduct axes) = checkProductAxesGo l axes
checkProductAxes _ _ = ()

checkProductAxesGo : String -> List (String, Param) -> Unit
checkProductAxesGo _ [] = ()
checkProductAxesGo l ((name, p)::rest) =
  let _ = checkOneAxis l name p
  checkProductAxesGo l rest

checkOneAxis : String -> String -> Param -> Unit
checkOneAxis l "Host" (PPrefix (Some pat)) =
  if prefixPatternOk pat then
    ()
  else
    pushTypeError "T-EFFECT-PARAM" (effectParamMsg l (prefixPatternErrMsg "Host pattern" pat))
checkOneAxis _ "Method" _ = ()
checkOneAxis l name _ =
  pushTypeError
    "T-EFFECT-PARAM"
    (effectParamMsg
      l
      ("unknown product axis '" ++ name ++ "' (known axes: Host, Method)"))

-- replace a row's bound tail effvar with its fresh instance from [esub], so each
-- call site of a polymorphic HOF gets its own effect variable
substRow : List (Int, Ref Effvar) -> EffRow -> EffRow
substRow esub r = match effrowNorm r
  EffRow labels (Some v) => match !v
    EUnbound id _ => match lookupAssocI id esub
      Some v2 => EffRow labels (Some v2)
      None => EffRow labels (Some v)
    ELink _ => EffRow labels (Some v)
  EffRow labels None => EffRow labels None

-- lower a row's tail effvar level to <= [level] alongside the tyvar being bound
lowerRowLevels : Int -> EffRow -> Unit
lowerRowLevels level r = match effrowNorm r
  EffRow _ (Some v) => match !v
    EUnbound id lvl => if lvl > level then v := EUnbound id level else ()
    ELink _ => ()
  EffRow _ None => ()

-- build a curried arrow carrying the body's latent effect [eff] on the LAST arrow
-- only; intermediate arrows stay pure-open (partial application performs nothing)
arrowsWithLastEffect : List Mono -> EffRow -> Mono -> Mono
arrowsWithLastEffect [] _ ret = ret
arrowsWithLastEffect [pt] eff ret = TFun pt eff ret
arrowsWithLastEffect (pt::rest) eff ret =
  TFun pt (openRow ()) (arrowsWithLastEffect rest eff ret)

-- free generalizable effect variables: a row tail effvar deeper than the current
-- scope (deduped by the caller, mirroring freeGenVars)
freeEffvars : Mono -> List Int
freeEffvars t = match normalize t
  TVar cell => match !cell
    Link t2 => freeEffvars t2
    Unbound _ _ => []
  TCon _ _ => []
  TRigid _ => []
  TApp a b => freeEffvars a ++ freeEffvars b
  TFun a r b => freeEffvars a ++ rowFreeEffvars r ++ freeEffvars b
  TEff r => rowFreeEffvars r

rowFreeEffvars : EffRow -> List Int
rowFreeEffvars r = match effrowNorm r
  EffRow _ (Some v) => match !v
    EUnbound id lvl =>
      if lvl > perRun.value.currentLevel.value then
        [id]
      else
        []
    ELink _ => []
  EffRow _ None => []

-- the declared concrete effect set of a signature: labels on the first `<…>`
-- reached walking down the return side (Phase 79e escape check)
declaredEffects : Ty -> List Atom
declaredEffects (TyFun _ ret) = declaredEffects ret
declaredEffects (TyEffect effs _ _) = atomsOfWritten effs
declaredEffects (TyConstrained _ t) = declaredEffects t
declaredEffects _ = []

-- record metadata: name → (quantified param ids, result mono, field types).  A
-- global Ref (like the reference's record table) so field access / create /
-- update / patterns can look records up without threading an env field.
-- `RecordInfo params result fields fieldIndex`.  `fields` keeps DECLARATION ORDER
-- (record construction / exhaustiveness / owner rendering read it); `fieldIndex`
-- is a name→raw-Mono OrdMap built ONCE at registration so the hot per-access read
-- paths (field access + record update) do an O(log N) lookup instead of an O(N)
-- `lookupAssoc` scan, and instantiate ONLY the accessed field rather than rebuilding
-- all N fields per access (issue #980 — the typecheck sibling of resolve's ownersOf
-- record quadratic).  The two views are kept in lockstep by the sole constructor
-- site (`registerRecordInfoKeyed`); on a duplicate field name the OrdMap is built
-- from the REVERSED list so the FIRST declared entry wins, matching `lookupAssoc`.
public export data RecordInfo =
  | RecordInfo (List Int) Mono (List (String, Mono)) (OrdMap Mono)

-- Keyed indices — so the hot per-field-access read paths never walk a linear registry
-- (issue #149).  #415 item 3: `registerRecordInfoKeyed` is the sole REGISTRATION writer of
-- both; they are cleared together by resetState; and the cross-module universe copy goes
-- through the single loadDataUniverse/storeDataUniverse inverse pair.
--
-- 🚨 THE LOCKSTEP WAS "STRUCTURAL, NOT AN OBLIGATION" UNTIL #1111 A-2.12 (#1319 unit 2),
-- AND IT IS NOW AN OBLIGATION.  `applyRecordScopeOverrides` re-points `recordByNameRef`
-- for a collided key and does NOT touch `fieldOwnersRef`, so the two are no longer written
-- only in pairs and nothing enforces that they agree.  Re-pointing key `K` cannot change
-- which KEYS own a field name, but it does change which FIELDS `K` declares — so with two
-- same-named records having DISJOINT field sets, `fieldOwnersRef` can name `K` as the owner
-- of a field the newly-selected `K` does not declare.
-- ⚠️ THAT IS NOT HYPOTHETICAL AND AN EARLIER DRAFT OF THIS NOTE SAID IT WAS.  It called the
-- divergence "an obligation with no observed consequence" on the strength of one probe that
-- kept every projection inside the module which NAMED the record — where the overlay and the
-- floor agree by construction, so the probe could not have shown anything.  **#1377 was the
-- consequence**: a module naming one `Cfg` and holding a value of the other was refused.
-- 🚨 #1319 UNIT 3 DRAINED #1377, AND THE OBLIGATION SURVIVES IT.  Unit 3 did not reconcile
-- the two tables; it stopped ASKING the overlay a question the overlay could not answer —
-- `resolveFieldRecord`'s arm (a) now selects by the receiver's identity (see
-- `lookupRecordForReceiver`).  So the one observed consequence is gone and the write
-- asymmetry is not.  ⚠️ Do NOT restate this as "no observed consequence today": that exact
-- sentence has now been wrong twice here, and what is true is narrower — the consequence
-- that was found has been removed, and nobody has established that it was the only one.
-- Anything added here must state which of the two it writes and why the other is safe.
--   recordByNameRef : registry KEY → RecordInfo.  omInsert is last-write-wins and
--     the register site inserts in registration order, so it reproduces the old
--     prepend-list first-match (latest-registered wins) for lookupRecordByName.
--   fieldOwnersRef  : field name → the registry keys whose RecordInfo declares it
--     (a multimap).  fieldOwnerNames still `sortUniqS`es this so the owner-list
--     order that feeds ambiguousFieldMsg/headL stays byte-identical.

-- Kind of a data-type parameter, inferred from usage: KRow iff the param name
-- appears in a field's effect-tail position (`<e>`), else KType.  Drives
-- kind-aware type-app elaboration (a KRow arg becomes a TEff row, not a TApp
-- tyvar) and ctor-result-type construction.  Per-type, positional.
public export data Kind = KType | KRow

-- Transparent type aliases (`type Foo = Int`, `type Pair a = (a, a)`).  Keyed by
-- alias name → (params, RHS surface type).  Populated in a pre-pass by
-- `registerData`'s DTypeAlias arm (mirrors `dataParamKindsRef`); consulted
-- on-demand at the `Ty→Mono` seam (`fromAstTypeE`) to expand an alias to its RHS.
-- The param list is stored even though stage 2 only expands the zero-param case,
-- so parameterized expansion (stage 3) can extend this without reshaping the table.

-- Names of record/named-field types exported ABSTRACTLY (`export data`/`export
-- record` without `public`).  Seeded ONCE (over EVERY module's decls, prelude
-- included) by the multi-module check drivers, BEFORE per-module checking, and
-- deliberately NOT cleared by resetState — it is whole-program metadata, not a
-- per-module accumulator.  An abstract export brings the type NAME into scope but
-- never registers its fields (publicDataDecls drops VisAbstract decls, so they never
-- reach the record registry in an importer — its PARAM KINDS do travel, since #804/#1028, via
-- kindPublicDataDecl's VisAbstract arm, but a kind is not a field).  A dot-access on
-- such a type therefore lands at resolveFieldRecord's `head known but no record
-- info` branch with the type name still recoverable as the receiver's head tycon;
-- membership here distinguishes that case (clear abstract-export diagnostic) from a
-- genuinely-unknown field on an unbound receiver (the `<unknown>` message).  This
-- mirrors resolve's destructure-side AbstractFieldAccess signal (env.types ∋ owner
-- ∧ owner owns no field) without threading anything new through the import seed.

-- collect the names of all VisAbstract record-shaped (a DData whose variants
-- carry named fields) decls across the given decl list.  Only
-- record-shaped abstract types can be a dot-access receiver, but harvesting any
-- abstract DData name too is harmless (a positional ADT can't reach the abstract
-- branch with a field access — its fields never exist).
collectAbstractRecordTypes : List Decl -> List String
collectAbstractRecordTypes [] = []
collectAbstractRecordTypes ((DData { dataVis = VisAbstract, dataName = n })::rest) = n :: collectAbstractRecordTypes rest
collectAbstractRecordTypes (_::rest) = collectAbstractRecordTypes rest

-- seed abstractRecordTypesRef from every module's decls (the per-module progs plus
-- the prelude/core decls), once, before checking begins.
seedAbstractRecordTypes : List Decl -> List (String, List Decl) -> Unit
seedAbstractRecordTypes coreDecls modules =
  let abstracts = collectAbstractRecordTypes coreDecls ++ flatMap (m => collectAbstractRecordTypes (snd m)) modules
  driverState.value.abstractRecordTypesRef := abstracts

-- #156 S3a: ONE record for every pending dispatch-site shape.  The four historical
-- tuple/record shapes (return-position sites, arg-position stamps, operator sites,
-- standalone-shadow RLocal sites) collapse into `PendingEntry`; `kind` (a
-- payload-carrying `SiteKind`) records which recorder built it and carries the
-- fields unique to that shape.  The common fields are: the method/name, the route
-- ref the resolver stamps, the primary discriminating mono, and the enclosing-fn
-- name (`currentFn` at record time; "" for RLocal sites, which carry no encl).  The
-- five pending lists stay SEPARATE (the drain schedule is unchanged — this is a
-- pure data-representation change): each recorder builds a `PendingEntry` with its
-- own `kind`, and each resolver reads the fields instead of destructuring a tuple.
public export data SiteKind =
  -- return-position site: the EMethodAt impl-dicts ref to fill + the method's full
  -- (un-stripped) type.  The primary mono is the result mono.
  | SKReturn (Ref (List Route)) Mono
  -- arg-position stamp: the EMethodAt impl-dicts ref + the method's full
  -- (un-stripped) occurrence mono.  Primary mono = arg mono.  #609: the full mono is
  -- what lets resolveArgStamp recover the interface's WHOLE param vector
  -- (ifaceParamMonos) — the arg mono alone is only the receiver, and selecting on it
  -- made a multi-param dispatch order-dependent.  Mirrors SKReturn, which has
  -- carried the method's full type for the same reason since #156 S3a.
  | SKArg (Ref (List Route)) Mono
  -- operator (EBinOp/EUnOp) site: the inImpl-body flag.  Primary mono = operand mono.
  -- (binop vs unop is carried by WHICH list holds it / the resolveOpSites flag, not here.)
  | SKOp Bool
  -- standalone-shadow RLocal site: mangled standalone symbol, forceLocal (P0-20),
  -- and the shadowing standalone's own `=>`-constraint dict monos + iface names
  -- (S-1).  Primary mono = receiver mono; encl is unused ("").
  -- FIX-shadow-arity-skew: the 5th field is the slot-parallel predicate ARGUMENT VECTOR
  -- list, so `resolveRLocalSites` can select each slot with `routesOfMonosTopV`'s vector
  -- goal instead of the scalar `Ix Int _`.  It is `ShadowDicts`' third projection and
  -- must stay aligned with the other two — see that record.  Empty ⇒ the scalar router,
  -- term for term.  ⚠️ #1909 falsified this comment's second half, which used to add
  -- "which is every 1-ary `=>` constraint in compiler + stdlib + sqlite": a 1-ary vector
  -- is no longer pinned to the scalar router, it routes on its own recorded argument.
  -- That is still byte-identical for a bare-tyvar constraint (the compiler's own), and
  -- deliberately not for a structured one — see `routesOfMonosTopV`'s header.
  | SKRLocal String Bool (List Mono) (List String) (List (List Mono))

public export data PendingEntry =
  -- fields: name/method, route ref to stamp, primary mono, enclosing-fn name, kind,
  -- and the site's own source span.
  -- #1155 (F-3c): the 6th field is the `currentLoc` span snapshotted at the RECORD
  -- site — during inference, while the ELoc context is live — exactly as `implObls`'
  -- 5th element is (see `pushPendingObl`).  The resolvers run POST-HM, long after
  -- inference left this expression, so the live `currentLoc` there names whatever
  -- ELoc was entered last (observed: the body of an unrelated impl three lines away).
  -- Each resolver loop republishes this span into `goalSiteLoc` so the min⊑ selector's
  -- ambiguity reject can point at the goal it was actually posed by.
  | PendingEntry String (Ref Route) Mono String SiteKind (Option Loc)

-- return-position method sites discovered during inference: (method name, the
-- EMethodAt route ref to fill, the EMethodAt impl-dicts ref to fill, the method's
-- result mono).  After the whole program is inferred, each result mono's head
-- tycon is the concrete impl tag the site dispatches to (RKey) — or, when it is a
-- constrained function's constraint variable, that function's dict parameter
-- (RDict).  The impl-dicts ref is filled (single-module elaborate path only) when
-- the route is a parametric impl with a `requires` — one route per requires.
-- #156 S3a: entries are `PendingEntry`s of kind `SKReturn`.

-- Phase 151 / Gap G: comparison/equality OPERATOR sites discovered during
-- inference: (method name, the EBinOp route ref to fill, the operand mono).
-- After inference resolveBinopSites stamps each ref with the resolved Eq/Ord impl
-- route (RKey) — but ONLY when the operand grounds to a NON-primitive type; the
-- structural-builtin EBinOp eval path handles primitive / ungroundable operands
-- (so `eq a b = a == b` on Int never recurses).  dictPass then rewrites the
-- stamped node into the method application.
-- (method, route ref, operand mono, inImpl-flag, enclosing-fn name).  The 5th
-- field is currentFn at record time: for a TOP-LEVEL constrained fn an operator on
-- its own constraint var routes RDict $dict_<encl>_<slot> (via enclDictVarOf), the
-- operator analogue of the direct `eq x y` arg-stamp path.
-- #156 S3a: entries are `PendingEntry`s of kind `SKOp`.

-- Roadmap #18c: the EUnOp analogue of pendingBinopSites — `-` (Num's `negate`)
-- sites discovered during inference.  Same tuple shape/fields, same resolve/
-- rewrite seam (resolveUnopSites / rewriteUnopExpr), one operand instead of two.

-- SHARED-FLOAT-RESIDUAL §3(C): arithmetic EBinOp sites whose operand type may
-- ground to a concrete primitive.  Recorded during inference (operand Mono + the
-- node's route ref); resolveArithSites zonks each Mono after the whole module is
-- inferred and, ONLY when it grounds to concrete Float, stamps RScalar "Float" so
-- lowering carries the scalar type into CBinPrim and the native emitter picks the
-- Float primitive without re-deriving the operand LTy structurally.  A still-
-- polymorphic (Num a) operand never grounds → stays RNone → today's dict path
-- (mirrors resolveBinopSite's grounded-only guard, so dict-routed arithmetic is
-- untouched).  Int operands are left unstamped (RNone ⇒ the Int primitive is the
-- default anyway) to avoid perturbing every integer binop's IR.

-- Error-path BLOCKER B4 (audit finding D3): missing-impl dispatch obligations.
-- methodIfaceParamsRef maps each interface method NAME → (iface name, the iface's
-- typarams, the method's declared AST type).  Built once per checkProgramSeeded
-- from the program's DInterface decls.  At each EVar/EMethodAt occurrence of a
-- registered method, recordImplObligation captures the OCCURRENCE mono so that,
-- after inference, checkImplObligations can read what the interface params
-- resolved to (parallel-walking the declared type against the normalized
-- occurrence mono) and reject the call when those concrete head types have NO
-- matching impl in the program — mirroring lib/typecheck.ml's check_method_usages
-- (`No impl of … for …`, lib/typecheck.ml:3845).  Skips while a param is still a
-- polymorphic tyvar (deferred to the caller, exactly like the oracle).
-- #147: keyed by method NAME (was a program-sized assoc List scanned linearly on
-- hot per-node paths).  omInsert is last-write-wins and the register site inserts
-- in the SAME order the old List prepended, so on a method-name collision the
-- latest-registered entry wins — identical to the old `lookupAssoc` first-match.
--
-- 🚨 #1111 A-2.5 (#1092): "identical to the old first-match" is TRUE and was never the
-- point.  BOTH forms pick by REGISTRATION ORDER, and neither picks by what the
-- occurrence resolved to — so on a bare-name collision between two unrelated
-- interfaces this table hands `recordImplObligation` / `ifaceParamMonos` the WRONG
-- INTERFACE, silently, in either direction (S0).  The table stays name-keyed here (it
-- is per-module state and a module's scope binds a bare method name to at most one
-- declaration — resolve rejects the ambiguous case outright).  What is new is that on
-- the MODULE path the map installed into it is the universe's map OVERLAID with this
-- module's own scope for exactly the colliding names — see `applyMethodScopeOverrides`
-- and the identity-keyed companion `universeMethodIdentsRef`.  The FLAT path is
-- unchanged and still last-write-wins; a flat program has one user module, so its
-- names cannot collide across modules (#1115 / E-1 is what would change that).

-- #147: cached SET of iface names with ≥1 method registered above, so
-- `ifaceRegistered` was an O(log n) membership test instead of a full linear scan
-- of the method table per operator/numeric-literal.  ⚠️ #1539 deleted that reader —
-- this set is WRITE-ONLY now; see the `ifaceRegistered` TOMBSTONE.  A separate key (iface name,
-- not method name) and NOT derived from the method map: two interfaces sharing a
-- method name collapse to one entry in the (name-keyed) map, but BOTH must stay
-- registered here — matching the old full-List scan.  Maintained in lockstep at
-- the two mutation sites (registerMethodIfaceParamsMethods and resetState).

-- C5 (TYPECHECK-AUDIT / Phase 112): names that are BOTH an interface method AND a
-- cross-module-imported standalone top-level function (e.g. box's `toList`/`isEmpty`
-- shadowing Foldable's).  Populated per module by elabModuleStamp from the full graph
-- (a top-level funDef name that is also a method name and is NOT defined in the
-- current module).  resolveSite consults it: a method site at a concrete receiver
-- with NO impl, whose name is here, routes RLocal (eval reads the standalone) instead
-- of RKey<head> (which would panic with no impl).  Mirrors lib/typecheck.ml's
-- env.standalone_values + the EApp RLocal stamp (typecheck.ml:1603-1640,4585).
-- NOT cleared by resetState — elabModuleStamp rebuilds it per module.

-- DEFINER-shadow names (facet 2): the names THIS module declares as a top-level
-- funDef that ALSO name an interface method (buildDefinerShadows) — e.g. a user
-- `eq : List Int -> List Int -> Bool`.  A DIRECT call `eq [1] [2]` in user code
-- must resolve to the user's OWN definition (RLocal), NOT to a method impl, even
-- when the receiver's head HAS an impl of the interface (`List` has `Eq`).  The
-- arg-stamp pass would otherwise stamp `RKey:List` (the impl), making the eval path
-- dispatch to the prelude `Eq (List a)` impl (`[1] ≠ [2]` → False) instead of the
-- user's fn (True) — a run≠build divergence (the EMIT path already routes to the
-- user's def).  resolveRLocalSite stamps these RLocal unconditionally.  Populated
-- per-module in checkModuleFullImpl from buildDefinerShadows; reset by resetState.

-- P0-19: the declared top-level SIGNATURES of definer-shadow standalones
-- (`size : Int -> Int`), keyed by name.  When a definer-shadow occurrence resolves
-- to the STANDALONE (no visible impl for the grounded receiver, or an ungrounded
-- receiver), inferDefinerShadowApp enforces this declared domain against the actual
-- argument — closing the S2/S5 "must then type against the standalone's domain" hole
-- that let `size "hi"` / a poly wrapper `useIt x = size x; useIt (Box 3)` type against
-- the permissive method scheme and reach codegen as garbage.  Set per-path from
-- `sigsOf prog`; empty for an unsignatured standalone (no domain to enforce → the old
-- permissive behavior, unchanged).

-- P0-19 d4b (S4): True while inferring the HEAD of a definer-shadow APPLICATION
-- (`size (Box 3)`) — set around the head-infer call in inferDefinerShadowVarApp /
-- inferDefinerShadowApp.  A shadow occurrence reaches inferVar / inferMethodAt in
-- two shapes: as an application head (dispatch-vs-standalone decided per-receiver by
-- the surrounding shadow-app machinery, so the head must keep the permissive METHOD
-- scheme `a -> Int`) OR in bare VALUE position (`map size xs`, `let f = size`), which
-- S4 says ALWAYS denotes the standalone.  This flag distinguishes the two so only the
-- value-position occurrence is pinned to the standalone scheme.  Default/reset False.

-- P0-18 (EMIT path only): the mangler (`mangleUnits`) renames a definer-shadow
-- standalone def + its call sites to `<mid>__name` BEFORE marking, but (correctly)
-- leaves the interface method name bare — so the mark pass's NAME-based shadow
-- detector (buildStandaloneShadowsGraph / buildDefinerShadows, keyed on
-- funDef-name ∩ iface-method-name) no longer sees a shadow and the occurrence never
-- becomes an `EMethodAt` dispatch site (→ a silent direct call to the standalone =
-- the build miscompile).  elaborateModules recovers the shadow post-mangle by
-- forward-constructing `mangledName mid method` for every (module, iface-method)
-- pair and checking it against the module's actual funDef names; each hit is a
-- `(mangledSymbol ↦ bareMethod)` entry recorded here.  The mark pass then (a) marks
-- the mangled occurrence `EMethodAt` with the BARE dispatch name (so `implFor` finds
-- the impl for a receiver that HAS one) and (b) carries the mangled symbol in the
-- route's `RLocal <symbol>` fallback for a receiver that does NOT.  EMPTY on the
-- un-mangled run/check path (forward-construction never matches a bare funDef), so
-- every non-emit path is byte-identical.  Set once at the top of elaborateModules;
-- deliberately NOT cleared by resetState (checkModuleFullImpl's per-module resetState
-- must not wipe it mid-graph) — the forward-construction membership check makes a
-- stale value inert (no funDef matches → no entry).

-- the MANGLED standalone symbol a route's RLocal fallback should call, or "" for
-- the bare-name (un-mangled) case.  Read off the marked EMethodAt route at record
-- time (before resolveArgStamps may overwrite the ref with an RKey) so the mangled
-- symbol survives into the pendingRLocalSites entry.
routeLocalSym : Route -> String
routeLocalSym (RLocal s _) = s
routeLocalSym _ = ""

-- Bug C: importer-shadow method names → their IMPORTED STANDALONE scheme (e.g.
-- `toList` → `Map k v -> List (k, v)`).  env1 rebinds these names to the polymorphic
-- INTERFACE-METHOD scheme (so a genuine method call types polymorphically), which
-- loses the standalone's concrete result element type — typing `toList m : List a`
-- (a free) instead of `List (String, Int)`, so a downstream `debug` dispatches on the
-- ungrounded element and renders garbage.  inferAppExpr's standalone-shadow arm reads
-- THIS to recover the standalone result type when the receiver has no impl, mirroring
-- lib/typecheck.ml:2312 (`instantiate_raw (lookup_var env mname)`, where the oracle's
-- env.standalone_values keeps the var bound to the standalone).  Populated per module
-- in checkModuleFullImpl from seedVars (the import seed, pre-rebind).

-- Bug C: the impl key table for the CURRENT module's full impl universe, stashed at
-- module start so inferAppExpr's standalone-shadow arm can ask, DURING inference,
-- whether a concrete receiver head has an impl of the method's interface (the static
-- analogue of resolveRLocalSite's post-inference check, but needed eagerly so the
-- call's RESULT type unifies against the standalone — not the method scheme — before
-- a downstream `debug` dispatches on it).  Set in checkModuleFullImpl from implDecls.

-- #154 PR1: PERSISTENT per-run universe accumulators for the multi-module path.
-- checkBodyImpl's Module arm used to REBUILD, from the whole growing `fullUniverse`,
-- four structures ONCE PER MODULE — the O(N²) the perf `modules` shape charted.  These
-- four grow the same structures ONE module at a time instead (appended in
-- checkBodyImpl's Module arm from that module's own decls, consulted right after).
-- Each is read by MEMBERSHIP / EXISTENCE / by-unique-key LOOKUP only, so appending a
-- module's contribution to the running table is byte-identical to rebuilding it over
-- `fullUniverse` (which included prog0), AND idempotent — the accData/accAll overlap
-- and the two elaborate sweeps re-append the same entries harmlessly.  They SURVIVE the
-- per-module `resetState` (like the crossModule* accumulators) and are cleared per RUN
-- by `resetCrossModuleState`; the core pass (also Module mode) seeds them.  The Flat
-- path never touches them (it rebuilds over its whole `prog` — already O(N)).
--   • the SET of every in-scope interface-method name (buildDefinerShadows / buildStandaloneShadows)--   • the SET of every in-scope top-level funDef name (buildStandaloneShadows' importedFns)--   • (⚠️ ARCH B-2.1-g/-d: an impl KEY-BUCKET accumulator used to sit here, grown per module
--     and copied into `shadowKeyTableRef` for the impl-existence test.  All three boolean
--     existence reads moved to the graph-global `bodyImplEnvRef` (`ieImplExistsForHead`),
--     which left both refs write-only, and B-2.1-d deleted them with the accumulator line.
--     Do not re-add one: a cumulative topological PREFIX is the wrong universe for that
--     test — `SHADOW-SEMANTICS.md:183-186`.)--   • interface name → its REQUIRED-method names (checkImplCompleteness' ifaceRequiredMethods).
--     Interface names are globally unique, so last-write-wins omInsert == first-match scan.-- #154 PR2 adds two more of the same shape (site #3 — registerMethodIfaceParamsAll's
-- per-module rebuild over `fullUniverse`).  Same lifecycle: survive `resetState`, cleared
-- by `resetCrossModuleState`, seeded by the core pass, appended in `appendUniverseAccums`,
-- and — because they are the two refs registerMethodIfaceParamsAll writes — COPIED into
-- methodIfaceParamsRef / registeredIfacesRef in the Module arm (which resetState wiped),
-- exactly as PR1 used to copy universeKeyBucketsRef into shadowKeyTableRef (both deleted by
-- ARCH B-2.1-d; the SHAPE described here is this pair's, not theirs).  The Flat path still
-- rebuilds those two refs over its whole `prog`, so it never touches these accumulators.
--   • interface-method NAME → (iface name, iface typarams, declared method Ty).  Method
--     🚨 #1111 A-2.5 (#1092): this bullet used to read "Method names are globally unique
--     (coherence), so last-write-wins omInsert accumulates to the same map the per-module
--     `fullUniverse` rebuild produced.  EVERY reader is a by-method-NAME omLookup … so an
--     extra prior-module entry that this module never names is never queried — byte-
--     identical output."  BOTH halves are FALSE.  Method names are NOT globally unique —
--     two unrelated interfaces may each declare `mth` — and the final clause is the one
--     that mattered: on such a collision the entry a prior module wrote IS queried, by
--     every by-method-NAME omLookup reader (singleTyparamIfaceMethod / ifaceParamMonos /
--     shadowVarHeadMethodScheme / inferAppExpr / …), which then takes the WRONG INTERFACE
--     out of it.  That is #1092 (S0).  The per-module rebuild agreed only because it made
--     the identical wrong choice, which is why nothing caught it.  What is true post-A-2.5:
--     the Module arm OVERLAYS this map, for the (normally zero) COLLIDED names only, with
--     what each name resolves to in THIS module's scope (applyMethodScopeOverrides); every
--     other name still takes the shared map unchanged.  Spellings the overlay does not
--     reach are open and derived, not a closed set — #1272 / #1275 / #1276.--   • the SET of interface names with ≥1 method registered.  Was read only by
--     ifaceRegistered's omHasKey existence check (core's Num/Eq/Ord are seeded on both
--     paths, so identical); #1539 deleted that reader and the set is now WRITE-ONLY.
-- #154 PR3 (sites #6/#7): the PERSISTENT keyed impl universe for the obligation
-- checkers (checkImplObligations / checkCallObligations).  The Module arm used to
-- REBUILD `implDeclsWithReqs fullUniverse` + `implHeadsOf fullUniverse` (two flatMaps
-- over the whole growing universe) once per module, then the `*Go` checkers scanned
-- those growing lists per obligation — an O(modules²) rebuild AND an O(modules²) scan
-- (the perf `modules` shape's dominant remaining quadratic).  These three refs hold
-- the same impls keyed for O(1)/O(log N) lookup, grown ONE module at a time in
-- `appendUniverseAccums` (like PR1/PR2's accumulators) and consumed by the KEYED
-- checkers (implMatchesU / implMatchesReceiverU / findMatchingImplReqsU /
-- implCountForIfaceU).  Same lifecycle: survive per-module `resetState`, cleared per
-- RUN by `resetCrossModuleState`, seeded by the core pass.  The head-tag alignment
-- `headTyconTy` (impl side, via `univReceiverTag`) == `headTyconMono` (mono side,
-- via `univConcreteBucket`'s caller) makes existence/count/tag reads (implMatchesU /
-- implMatchesReceiverU / implCountForIfaceU) BYTE-IDENTICAL to the old flat scans.
-- ⚠️ THAT IS *THIS* TABLE'S PAIR, and since A-2.2b it is also `KeyBuckets`'.
-- This sentence read "the invariant KeyBuckets already relies on" until A-2.2,
-- and it named a function `KeyBuckets` did not then call on its goal side; A-2.2b
-- deleted the third projection (`monoHeadCon`) and pointed `goalHeadCon` at
-- `headTyconMono`, so BOTH tables now pair `headTyconTy` (impl) with
-- `headTyconMono` (goal).  ⚠️ Those two do NOT agree on ORIGIN — only on the
-- head's SPELLING, which is all either table keys on.  The measurement and the
-- two reasons are on `dispHeadTab`; read it before assuming a shared identity.
-- The one deliberate NON-identity is `findMatchingImplReqsU`'s first-match: see its
-- doc-comment — it canonicalizes overlapping-impl requires-selection to the MOST-
-- SPECIFIC impl (a soundness/conformance fix over the old declaration-order scan),
-- NOT an order-immaterial coherence argument (coherence ACCEPTS specific-vs-parametric
-- overlap, so two impls CAN match one concrete mono).
--   • concrete-head impls, keyed by the (interface, receiver-head) PAIR, each
--     bucket in forward declaration order → (head tys, requires).
--     ⚠️ A-2.2b (#1111): that key is a structured two-component `RegKey`, not the
--     `"iface|tag"` string splice this line used to name, and the buckets are a
--     `MultiRegistry`.  Both components are still keyed by SPELLING — see
--     `dispHeadTab` for the measurement that blocks the head half, and
--     `oblIfaceKey` for the interface half.--   • HEADLESS-receiver impls (receiver head is a TyVar / function / empty — no head
--     tycon, so keyEntry-style tag bucketing can't reach them), keyed by iface.  These
--     match ANY receiver (matchTyMono wildcard), so every lookup consults them in
--     addition to the tag bucket.  Almost always empty (`impl Foo a` — the overlapping-
--     impls / parse fixtures are the only corpus sources), but MUST be kept: dropping
--     them would change `implMatches` from True to False on such a program.--   • iface name → SET of its impls' concrete head tags (headless impls contribute no
--     tag, exactly as `implHeadTagsFromHeads` skipped them — and since #1617/#1618,
--     ⚠️ NEITHER DO ARROW- OR EFFECT-HEADED IMPLS, which the other two buckets DO
--     file: this one is the ACCEPTANCE census, guarded by `univHeadCountsInCensus`,
--     and it is the only one of the three that is not a dispatch table).
--     `implCountForIfaceU`
--     reads its size — byte-identical to `listLen (dedup (implHeadTagsFromHeads …))`.
--     ⚠️ A-2.2b: a `Registry SetRegistry`; the count is `sregSize`, the combinator
--     A-2.0 added for exactly this reader.
-- #154 PR-A: PERSISTENT per-run DATA-universe accumulators for the multi-module path.
-- checkBodyImpl's Module arm used to `registerAllData initialEnv (accData ++ prog0)`,
-- RE-REGISTERING every earlier module's public data (and RE-MINTING its tyvars) once per
-- module — the dominant remaining O(N²) the perf `modules` shape charts.  `registerData` /
-- `registerVariants` / `registerRecordInfoKeyed` side-effect FOUR tables wiped by resetState
-- (recordByName / fieldOwners / dataParamKinds / aliasTable) PLUS the ctor ENV; an
-- env-only accumulator would silently drop the 4-table side effects and the compiler would
-- fail to self-typecheck, so all FIVE persist.  Seeded by the core pass (also Module mode),
-- grown ONE module at a time by `appendDataUniverse prog0` AFTER the module
-- (so module k sees pub 1..k-1, never its own pub twice), copied into the resetState-wiped
-- working refs and OVERLAID with prog0 at the `dataEnv` binding.  First-wins order preserved:
-- persistent [pub_{k-1}..pub_1] + overlay conses prog0 → [prog0, pub_{k-1}..pub_1], the same
-- winner the old left fold over `accData ++ prog0` yielded.  Stored tyvar ids never leak —
-- every reader (instantiateRecord / ctor-scheme instantiation) refreshes them; only the
-- COUNT of tyvars minted shifts (registered once, not per module), argued invisible via the
-- ppMono/ppScheme normalization (the TYPE-dump goldens + fixpoint are the oracle).  Survive
-- per-module `resetState`; cleared per RUN by `resetCrossModuleState`.
-- P0-19 (constrained-receiver arm): the `=>`-constraint variables of the top-level
-- group CURRENTLY being inferred, as (interface name, the constraint's instantiated
-- mono).  Set by processSCC between preunifySigsEx (which instantiates the sigs) and
-- inferMembers (which infers the bodies), cleared right after — funConstraintsRef /
-- activeDictVars are only registered AFTER inference (they need the surviving
-- union-find root), so the bodies themselves cannot ask those which of their tyvars
-- are dict-bound.  Read by definerReceiverIsDictVar: a definer-shadow occurrence whose
-- receiver is one of these vars DISPATCHES through the dict and is NOT a standalone.

-- C5: method name → dispatch-arg index, built graph-wide from ALL interface decls
-- (so a PRELUDE method like Foldable's `toList` — absent from a user module's own
-- decls — still resolves its index during that module's check).  Set per module by
-- checkModuleFullImpl from [implDecls].  Independent of methodIfaceParamsRef (which
-- the module path populates only for the module's OWN interfaces).

-- #154 PR-B: PERSISTENT per-run dispatch-index accumulator for the multi-module path.
-- checkBodyImpl's Module arm used to `argDispatchIndices implDecls` (= `accAll ++ prog`) —
-- a flatMap over EVERY earlier module's decls once per module, an O(N²) rebuild on the
-- emit path (elabWorker / elabModuleStamp).  The scan is pure and structural (no tyvars,
-- no side effects) and distributes over `++`, so the accumulator grown ONE module at a
-- time in `appendUniverseAccums` (BEFORE the Module arm copies it, so module k sees
-- interfaces 1..k INCLUDING its own — the same membership `accAll ++ prog` gave) holds
-- exactly what the per-module rebuild held.
--
-- ✅ #1351 L5 (CONTRACT): the accumulator this paragraph described is now the
-- IDENTITY-KEYED one, `universeMethodDispatchIdxByIdRef`, copied into
-- `methodDispatchIdxByIdRef`.  Its bare-name predecessor is DELETED, and with it the
-- whole hazard the rest of this comment used to carry: the pick between two same-named
-- methods' dispatch indices is no longer made by a first-wins `lookupAssoc` over
-- registration order, because the key now carries the declaring interface's identity
-- (`IfaceRef`, `irOrigin` included) and `dispatchIdxScoped` asks for ONE declaration —
-- the one `admittedIfaceFor` says this module admits.  A prior module's entry that this
-- module cannot name is unreachable by construction rather than merely unqueried.
-- Survives per-module `resetState`; cleared per
-- RUN by `resetCrossModuleState`; seeded by the core pass (also Module mode).
-- FLAT-PATH SHADOW FIX (facet 1): interface-method names that a USER top-level fn
-- shadows on the single-file flat check path.  processSCC drops a scheme with one
-- of these names from the env it THREADS FORWARD, so a later prelude binding
-- (`neq x y = not (eq x y)`) resolves the name to the METHOD scheme (kept in the
-- base env / globalS) rather than the user's shadowing fn.  Set by checkProgramSeeded
-- right before processTopGroups; empty everywhere else (multi-module path checks
-- core in isolation and never needs this).  See checkProgramSeeded for rationale.

-- FLAT-PATH SHADOW SCOPING (SHADOW-SEMANTICS S1: shadow-hood is per-module, per-name).
-- The flat path hands checkProgramSeededSplit ONE program, `core ++ user`, and then
-- applied the definer-shadow name set to EVERY occurrence in it — INCLUDING the
-- prelude's own bodies.  So a user file that merely DEFINES (and never uses)
-- `map : Int -> Int` made core's `map2`/`map3`/`replaceWith`/`discard` type their own
-- `map` calls against the USER's `map`, yielding 14 errors — all inside core, all
-- reported at a fabricated `1:0` on the user's signature.  (Once SHADOW-SEMANTICS S2 is
-- inverted so a standalone WINS over a same-named method, the same leak stops merely
-- mistyping and starts ROUTING the prelude's calls into user code — a silent miscompile
-- of the prelude.)  The multi-module path never had this: checkModuleFullImpl seeds the
-- shadow set PER MODULE and checks core in ISOLATION.
--
-- These three refs reproduce that isolation on the flat path WITHOUT splitting the
-- inference: definerShadowNamesRef is toggled OFF while a CORE-owned letrec group (and
-- core's impl/default/prop/test bodies) is inferred and back ON for the user's, so every
-- consumer of that ref (definerShadowVarHead / definerShadowArgHead /
-- maybeStandaloneValueMono / recordImplObligation / resolveRLocalSite) becomes
-- per-module for free.  Empty/False on every other path — resetState clears them and
-- ONLY a checkProgramSeededSplit with a NON-EMPTY prelude sets them — so the
-- multi-module path and the prelude-free probe paths are byte-identical.

-- the prelude's own top-level fn names (a set: this is consulted once per letrec group).

-- the definer-shadow names of the USER module only — what definerShadowNamesRef holds
-- whenever a user-owned group/body is being inferred.

-- C5: arg-position method occurrences whose name is a standalone-shadow, recorded
-- UNGATED (the ordinary arg-stamp machinery is emit-path-only, but eval also
-- arg-tag-dispatches and panics on a receiver with no impl — box's `toList b`).
-- Each entry is (name, route ref, the discriminating-argument mono CELL);
-- resolveRLocalSites reads the cell post-inference and stamps RLocal when the
-- receiver grounds to a head with no impl.
-- Mirrors lib/typecheck.ml's EApp-receiver RLocal stamp.  Reset by resetState.
-- (name, routeRef, receiverMono, mangledSym, forceLocal) — mangledSym (P0-18) is the
-- mangled standalone symbol read off the marked route at record time; resolveRLocalSite
-- stamps `RLocal mangledSym` for a no-impl receiver.  "" on the un-mangled path.
-- P0-20: forceLocal — the definer-shadow APP path (inferDefinerShadowApp) has ALREADY
-- committed the site's TYPE to the standalone's scheme, so its route is not open to
-- re-derivation: post-inference the receiver can ground to a head that HAS an impl (Num
-- defaulting on an unsignatured standalone) and resolveRLocalSite would dispatch a site
-- typed as the standalone — check says one thing, the binary does another.  True pins
-- the route to RLocal.  recordRLocalSite (value position / importer shadows) pushes
-- False and keeps the old per-receiver re-derivation.
-- S-1: `dictMonos`/`dictIfaces` are the SHADOWING STANDALONE's own `=>`-constraint
-- slots (slot-parallel, expanded-supers, from shadowStandaloneDicts), carried here so
-- the stamp can turn them into dict Routes.  They are read INSIDE resolveRLocalSites
-- via routesOfMonosTop — a PURE function of the union-find-solved monos — rather than
-- pushed through pendingDictApps, because resolveRLocalSites runs BEFORE
-- resolveDictApps in elabModuleStamp: routing them through pendingDictApps would read
-- `[]` and reproduce the S-1 bug with more code.  This way the fix is ordering-immune
-- and the route has a single writer.  Empty for an unconstrained standalone.
-- #156 S3a: these fields now live in `PendingEntry`'s `SKRLocal` kind (mangledSym,
-- forceLocal, dictMonos, dictIfaces); the name/route/receiver-mono are the shared
-- PendingEntry fields, and encl is unused ("") for RLocal sites.

-- #158 PR4: the NON-REENTRANT global toggles — booleans a caller flips True around a
-- sub-computation and restores after, so a reader lower in the SAME inference sees the
-- flag.  Unlike the PerRun accumulators these are not per-push state, they are a dynamic
-- context; bundled here as a record OF Refs and driven by SAVE/RESTORE brackets, NOT
-- unconditional set-False:
--   let saved = toggles.value.X.value in setRef toggles.value.X True; <body>; setRef toggles.value.X saved
-- so a nested definer-shadow head that re-enters the same bracket inside <body> no longer
-- clobbers the outer True on its way out (a bare set-False did).  Reset per-module in
-- resetState alongside PerRun (shadowHeadCtxRef was a PerRun field before this PR — its
-- resetState clearing is preserved by freshToggles being minted in the same reset).
--   suppressRLocalRecord — P0-18: while typing a definer-shadow method occurrence that
--     heads a single-arg application (`size (Box 3)`), suppress recordRLocalSite's default
--     push: the standalone scheme's declared domain (`Int`) is NOT the actual receiver
--     type.  inferDefinerShadowApp instead records the ACTUAL argument mono so per-receiver
--     routing sees `Box` (which has a `Sizeable` impl → method) vs `Int` (no impl →
--     standalone).  True only around that occurrence's head; false everywhere else.
--   suppressArgStamp — P0-18: same idea for the EMIT path — suppress recordArgStamp's
--     default push (standalone declared domain) so inferDefinerShadowApp can record the
--     ACTUAL argument mono into pendingArgStamps instead.
--   shadowHeadCtxRef — P0-19 d4b: True while typing a definer-shadow occurrence that is the
--     HEAD of its own application (marked EMethodAt on run/build), so maybeStandaloneValueMono
--     does NOT pin it to the value-position standalone scheme.
data Toggles =
  | Toggles {
      suppressRLocalRecord : Ref Bool,
      suppressArgStamp : Ref Bool,
      shadowHeadCtxRef : Ref Bool,
    }

-- Construct all 3 toggle-Refs fresh (each reproduces its former initial — all False).
freshToggles : Unit -> Toggles
freshToggles _ = Toggles {
  suppressRLocalRecord = Ref False,
  suppressArgStamp = Ref False,
  shadowHeadCtxRef = Ref False,
}

-- The single module-level cell holding the current run's dynamic-context toggles.
toggles : Ref Toggles
toggles = Ref (freshToggles ())

-- ── A-3.1 (#1112): the whole-graph declaration ENVELOPE ──────────────────────
-- Stage A-3's `K` is ONE declaration analysis over the whole loaded module graph,
-- assembled once in the driver preamble instead of marshalled per module
-- (`compiler/TYPECHECK-TARGET-ARCHITECTURE.md` §2 K).  This unit lands the
-- ENVELOPE ONLY — the ordinal-tagged carrier, its whole-graph builder, and the one
-- ordinal filter.  It carries NO `CE`, `IE` or `DataEnv` contents: those are
-- A-3.2 / A-3.3 / A-3.4, which add fields to `DeclEnvs` and populate them inside
-- `buildDeclEnvs`.  Nothing here retires a `universe*`/`obUniv*` marshalling cell,
-- and nothing here re-keys one.
--
-- WHY AN ORDINAL.  §2 K's whole-graph environments are language-VISIBLE: an impl
-- declared in a topo-LATER module becomes usable by an earlier one (an
-- orphan-instance-style acceptance widening, which §5 R2 owns).  The #1112
-- decomposition (2026-08-08) therefore stages that: every entry carries the
-- ordinal of the module that declared it, and every read filters
-- `entryOrd <= currentOrd`, which reproduces today's prior-modules-plus-me
-- universe.  ⚠️ THIS PARAGRAPH THEN PREDICTED THE SEMANTICS CHANGE WOULD BE "THE
-- DELETION OF ONE FILTER — `declEnvVisibleAt`, AND NOTHING ELSE", AND THAT
-- PREDICTION WAS WRONG.  A-3.6 (#1558) found the one predicate had grown readers on
-- structurally different subjects — instance candidacy, but also the alias table,
-- the ctor overlay pool, the field-owner multimap, the data param-kind table and
-- `CE` — so one deletion would have widened five things where the spec licenses
-- one.  By owner ruling the predicate SPLIT: `ieCandidacyVisibleAt` carries the
-- instance axis (graph-global, C4/I2), this one keeps the ordinal body for the name
-- axis.  What survives of the design is the ROUTING rule, which is what made the
-- split cheap: route every ordinal test through the predicate matching its SUBJECT,
-- and never open-code `<=` at a read site.
--
-- ⚠️ WHAT IS LIVE TODAY, AND WHAT IS NOT — this unit's bar is BYTE-IDENTICAL, so
-- it may not move a judgment.  LIVE: `buildDeclEnvs` runs at both Module-mode
-- driver entries, and `deAllDecls` supplies the whole-graph decl list each of them
-- previously concatenated inline, so a mis-built envelope is LOUD
-- (`populateEffectDomains` would miss a module's `effect` decls) rather than
-- silent.  NOT LIVE IN THIS UNIT: the filter.  ⚠️ THE ROW ACCESSOR THIS PARAGRAPH
-- USED TO TRACK IS GONE — `declEnvsVisible`/`declEnvsUpTo`/`declEnvsUpToGo` were
-- RETIRED 2026-08-12 (bite C-0, see their tombstone further down) with zero callers,
-- ever: A-3.2a read `deAllDecls` unfiltered, and A-3.2b/A-3.4/A-3.5c each built their
-- own read-side path (`declEnvRowVisible`, `ieSnapAt`, `ceLookupAt`) instead.  The
-- filter itself IS live now, through those readers — but never through a pre-filtered
-- row list.  (This paragraph originally named "A-3.2/A-3.3/A-3.4's table reads" as the
-- accessor's future callers.  Every one of them declined it; the prediction was wrong
-- four times running, which is why the accessor is a tombstone rather than a TODO.)
--
-- ORDINALS.  The prelude is 0; then each module of the loader's dependency-first
-- list, in that order.  The prelude is indexed under BOTH `"core"` — the spelling
-- its `graph*Exports` peers key it under — and `""`, which is the `mid` both
-- drivers actually pass for the core pass (`checkModuleFull` → `checkModuleFullImpl
-- ""`; `elabModuleStamp ""`), so `declEnvsOrdOf` cannot miss on either spelling.
--
-- 🚨 A-3.2+ WILL ADD FIELDS TO `DeclEnvs`, SO READ THIS BEFORE YOU DO.  The one
-- interior comment on each record below is LOAD-BEARING against #829 (REOPENED),
-- and MEASURED on this binary rather than relayed: `medaka fmt --write` renders a
-- multi-line record with NO interior comment as `data X =` / `| X { … }`, and that
-- two-line header is exactly #829's trigger shape — adding one interior comment to
-- a record already in it moved that comment onto the NEXT field (probed on a
-- 5-field synthetic record: the comment written beside field 3 came back beside
-- field 4), and `fmt --check` then reports the damage as clean.  A record that
-- already carries an interior
-- comment formats to the one-line `data X = X {` header instead, which is the safe
-- shape.  Keep at least one interior comment here; do not "tidy" them away.
data DeclEnvModule = DeclEnvModule {
    demOrd : Int,  -- 0 = the prelude; then the loader's dependency-first order
    demId : String,
    demDecls : List Decl,
    demPubDecls : List Decl,  -- A-3.2b (#1512): `publicDataDecls demDecls`, MEMOIZED — see `declEnvRowVisible`
    demKindEntries : List (TabKey, List Kind),  -- A-3.2b slice 2 (#1512): the KIND-public projection's entries, MEMOIZED — see `declEnvRowKindEntries`
  }

data DeclEnvs = DeclEnvs {
    deModules : List DeclEnvModule,  -- ordinal order, prelude first
    deOrdIndex : OrdMap Int,
    deDefiners : OrdMap (List (String, (String, String))),  -- RUN-XMOD-066: `graphPubDefiners`' answer, per module id — see `declEnvDefinerIndex`
    deAllDecls : List Decl,
    deData : DataEnv,  -- A-3.2a (#1112) built it; A-3.2b residual 1 (#1512) made it LIVE — `aliasUniverseAt` reads `deAliases`
    deImpls : ImplEnv,
    deIfaces : ClassEnv,  -- A-3.3 (#1519) built it; A-3.5c (#1557) made it LIVE — three readers, see the `CE` block
    deKindsBefore : OrdMap (List (TabKey, List Kind)),
    deOwnersBefore : OrdMap (OrdMap (List String)),
  }

-- INITIAL construction only, exactly as `freshDriverState` is: a driver that never
-- calls `buildDeclEnvs` reads an empty graph, on which every `declEnvsOrdOf`
-- misses.  See `declEnvsOrdOf` for why a miss is fail-CLOSED.
emptyDeclEnvs : DeclEnvs
emptyDeclEnvs = DeclEnvs {
  deModules = [],
  deOrdIndex = omEmpty,
  deDefiners = omEmpty,
  deAllDecls = [],
  deData = emptyDataEnv,
  deImpls = emptyImplEnv,
  deIfaces = emptyClassEnv,
  deKindsBefore = omEmpty,
  deOwnersBefore = omEmpty,
}

-- Build the envelope from the prelude + the loader's dependency-first module list.
-- ⚠️ Must run AFTER the driver's `stampGraphTyOrigins`, for the same reason
-- `graphMethodExports` must: identity lives on the decls, so an envelope built
-- from the unstamped tree would carry a different one.  Both current call sites
-- (`checkModulesPreamble`, `elaborateModules`) sit after their driver's stamp.
buildDeclEnvs : List Decl -> List (String, List Decl) -> DeclEnvs
buildDeclEnvs coreDecls modules =
  let mods = declEnvModulesFrom 0 (("core", coreDecls)::modules)
  let allDecls = declEnvDeclsOf mods
  -- A-3.2b (#1512) slices 2+3: the DATA-UNIVERSE SEED CHAIN, built once here for the
  -- whole graph so the per-module read is one `omLookup` and allocates nothing.  The
  -- `""` seeds mirror `declEnvOrdIndex`'s: the core pass arrives under that spelling
  -- and its seed is empty because nothing precedes ordinal 0.  See `declEnvSeedChain`.
  let seeds = declEnvSeedChain mods [] omEmpty (omInsert "" [] omEmpty) (omInsert "" omEmpty omEmpty)
  DeclEnvs {
    deModules = mods,
    deOrdIndex = declEnvOrdIndex (omInsert "" 0 omEmpty) mods,
    deDefiners = declEnvDefinerIndex omEmpty mods,
    deAllDecls = allDecls,
    deData = buildDataEnv mods,
    -- #1112 A-3.4: `IE`, built here so it inherits this function's ordering and its
    -- must-run-after-`stampGraphTyOrigins` precondition.  See the IE block header.
    --
    -- ⚠️ A-3.2a's `deData` and this field landed independently and now share this
    -- one constructor; they COMPOSE rather than interact, and that is a property
    -- worth stating because nothing here would fail loudly if it stopped holding.
    -- Both read the per-module `mods` rows (A-3.2b's residual moved `buildDataEnv`
    -- off the flattened `allDecls`, because `deAliases` now carries the declaring
    -- module's ORDINAL and the flattened list has none — the very reason `IE` took
    -- rows from the start).  Both are pure folds over the same `declEnvModulesFrom`
    -- result, neither mutates a ref, and neither reads the other's output — so the
    -- order of these two initialisers is not observable.
    -- If a later unit gives either builder a side effect, that stops being true
    -- and this comment is the thing it invalidates.
    deImpls = buildImplEnv mods,
    -- #1519 A-3.3: `CE`, same shape as `deImpls` immediately above — a pure fold
    -- over the SAME `mods` (per-module rows, ordinal-tagged), composing rather
    -- than interacting with the other two initialisers for the identical reason.
    deIfaces = buildClassEnv mods,
    deKindsBefore = fst seeds,
    deOwnersBefore = snd seeds,
  }

declEnvModulesFrom : Int -> List (String, List Decl) -> List DeclEnvModule
declEnvModulesFrom _ [] = []
declEnvModulesFrom k ((mid, decls)::rest) =
  declEnvModule k mid decls :: declEnvModulesFrom (k + 1) rest

-- 🚨 THE ONLY WAY TO BUILD A ROW.  A-3.2b (#1512) added `demPubDecls`, which is a
-- MEMO of `demDecls` and must never disagree with it; a record literal at a second
-- site is exactly how the two would come to.  Every construction — the graph builder
-- above and the `CE`/`IE` doctest probes below — goes through here.
--
-- `demPubDecls` is the publicity conjunct of `declEnvVisibleTo`, evaluated ONCE per
-- module rather than per decl at every read.  It is a MEMO, not a filtered
-- population: `demDecls` still holds the row's decls unfiltered, which is what the
-- ruling's "K is the whole graph, visibility is a predicate at the READ" requires —
-- the two projections sit side by side and `declEnvRowVisible` picks between them.
--
-- `demKindEntries` is the SAME discipline for the THIRD projection A-3.2b slice 2
-- needed (see `kindPublicDataDecl`): a memo of the row's kind-public entries, not a
-- filtered population.  It is entries rather than decls because the read side wants
-- `(TabKey, List Kind)` pairs and `inferParamKinds` is pure — computing it here runs
-- it ONCE PER DECL for the whole run instead of once per (decl, reading module).
declEnvModule : Int -> String -> List Decl -> DeclEnvModule
declEnvModule k mid decls = DeclEnvModule {
  demOrd = k,
  demId = mid,
  demDecls = decls,
  demPubDecls = publicDataDecls decls,
  demKindEntries = declEnvKindEntries (filterList kindPublicDataDecl decls),
}

declEnvOrdIndex : OrdMap Int -> List DeclEnvModule -> OrdMap Int
declEnvOrdIndex acc [] = acc
declEnvOrdIndex acc (m::rest) =
  declEnvOrdIndex (omInsert m.demId m.demOrd acc) rest

-- The graph's decls in ordinal order.  `++` is associative, so this is the same
-- LIST VALUE the two drivers built as `coreDecls ++ flatMap snd modules` — that
-- equality is what makes replacing their inline concats byte-identical.
declEnvDeclsOf : List DeclEnvModule -> List Decl
declEnvDeclsOf [] = []
declEnvDeclsOf (m::rest) = m.demDecls ++ declEnvDeclsOf rest

-- 🚨 THE ORDINAL FILTER FOR THE **NAME/DECLARATION** AXIS.  It is LIVE and it is
-- STAYING — A-3.6 did NOT delete it.
--
-- ⚠️ THIS BLOCK SAID "THE ONE ORDINAL FILTER … A-3.6 is the deletion of this
-- predicate's body and nothing else" UNTIL 2026-08-12, AND THAT DESIGN WAS
-- OVERRULED.  The arc had assumed one body, one semantics change.  It is not:
-- this one predicate is read by an instance-candidacy path AND by four
-- name/data-scoping tables (the alias table, the ctor overlay pool, the
-- field-owner multimap, the data param-kind table, plus `CE`'s two lookups).
-- Deleting the body would have applied an INSTANCE-candidacy licence to all of
-- them, and `docs/spec/DICT-SEMANTICS.md` forbids exactly that reading by name:
-- *"I5 does NOT extend that price to NAMES … I5's subject is `match(IE, C τ̄)`."*
-- Worse, one of the four is a NARROWING, not a widening — the paragraph on
-- `declEnvVisibleTo` below records it MEASURED on this tree — and §5 R2's two
-- enumerated exceptions are both widenings.  A narrowing cannot meet that bar.
--
-- So the predicate SPLIT, by owner ruling: A-3.6 flips the instance axis through
-- `ieCandidacyVisibleAt` below, and this one keeps its ordinal body for every
-- name-scoping reader.  The invariant that survives is NOT "there is one body" —
-- it is "there is one body PER AXIS, and no read site open-codes `<=`".  Route a
-- new ordinal test through whichever of the two matches its SUBJECT, and if you
-- cannot tell which, that is the question to escalate rather than the choice to
-- guess.  Widening any of this predicate's readers is a separate unit with its
-- own fixtures; it is not a side effect of anything.
declEnvVisibleAt : Int -> Int -> Bool
declEnvVisibleAt cur entryOrd = entryOrd <= cur

-- 🚨 THE INSTANCE-CANDIDACY AXIS — A-3.6 (#1558), and this is the C4/I2 flip.
-- Which impls may be CANDIDATES for a goal at a reading ordinal.  Graph-global by
-- construction: every instance declared in every loaded module is a candidate
-- everywhere, so this predicate holds unconditionally and the ordinal arguments
-- exist only so the read sites do not move.
--
-- WHY IT IS `True` RATHER THAN DELETED.  `DICT-SEMANTICS.md` §8 I5 / §7 C4 / I2:
-- *"`match(IE, C τ̄)` ranges over every instance declared in every module … Import
-- scoping decides which NAMES a module may write.  It never decides which
-- instances exist."*  Keeping a named predicate rather than open-coding `True` at
-- the read site keeps the axis greppable and keeps the C4/I2 guarantee attached
-- to a symbol a later unit can find; it is the same discipline the name axis
-- above is under, pointed the other way.
--
-- ⚠️ THE PARAMETERS ARE DELIBERATELY UNUSED AND MUST STAY.  `ieSnapAt` walks
-- ordinal-ordered snapshots and keeps the LAST one this admits; with `True` that
-- is the final snapshot, i.e. the whole graph, which is exactly the intended
-- semantics.  Re-introducing an ordinal test here re-instates the prefix rule and
-- silently un-does A-3.6 — the cheapest structural check that the flip is still
-- landed is that `grep 'entryOrd <= cur'` finds the name axis and NOT this one.
--
-- 🚨 THE SECOND READER, AND IT IS NOW RULED.  `ieRowsVisibleAt` (A-3.5b) is the
-- other `IE` reader; it answers a DECL-TIME EXISTENCE question (`checkSuperImpls`)
-- rather than a candidacy one, and when A-3.6 landed it was left on
-- `declEnvVisibleAt` with that question recorded as OPEN.  It was then MEASURED
-- open: with candidacy graph-global and existence prefix-scoped, an `impl Sup T` in
-- a topologically LATER module satisfies dispatch in the very module where
-- `checkSuperImpls` reports the same impl missing — one program, two channels, one
-- of them wrong.  ⚖️ OWNER RULING (Val, 2026-08-12, sprint `DECISIONS.md` RUN-055,
-- finding SA-3): WIDEN the existence check to match candidacy.  `ieRowsVisibleAt`
-- now reads THIS predicate, so both `IE` reads answer at the same scope and the
-- diagnostic cannot contradict the engine.
-- ⚠️ THE NAME AXIS IS UNTOUCHED BY THAT RULING.  RUN-010 split the predicate
-- precisely so the name-scoping tables keep their ordinal filter, and
-- `DICT-SEMANTICS.md:2025-2033` forbids extending I5's licence to names.  The
-- SUPERS themselves still come from `CE` at the reading ordinal (`ceLookupAt` in
-- `superImplMsgsOf`); only the row set the existence query scans moved.
ieCandidacyVisibleAt : Int -> Int -> Bool
ieCandidacyVisibleAt _ _ = True

-- The ordinal of [mid], or `0 - 1` when the envelope holds no row for it.
-- FAIL-CLOSED deliberately: at `-1` `declEnvVisibleAt` rejects every entry, so a
-- reader arriving with an unknown module id LOSES declarations and produces a
-- reject (loud), instead of gaining the whole graph early and producing a silent
-- accept.  `buildDeclEnvs` registers the prelude's `""` spelling, so the miss is
-- unreachable from the two drivers that exist today.
--
-- 🚨 "FAIL-CLOSED" IS A CLAIM ABOUT THE READER, NOT ABOUT THIS FUNCTION, AND SINCE
-- #1557 A-3.5c THERE ARE READERS OF THE OPPOSITE POLARITY.  The argument above holds
-- for a reader that CONSUMES declarations to build something — losing them shrinks a
-- universe and the missing entry is reported.  It INVERTS for a reader that consumes
-- declarations to CHECK them: at `cur = -1`, `ceRowsVisibleAt`/`ceRowsOwnedBy` return
-- `[]` and `ceLookupAt` misses everything, so W1 acyclicity, phantom-method rejection
-- and the graded impl-head kind check all have nothing to iterate and become SILENT
-- ACCEPTS.  Same `-1`, opposite severity direction.
--
-- SUSPECTED-UNPROVEN, and recorded rather than fixed because it is not reachable
-- today: the ids come from the very list `buildDeclEnvs` indexed, within one driver
-- invocation, so a checking reader cannot arrive with an id the envelope never saw.
-- Probed against the #1223 nested-root shape (`test/origin_fixtures/nested`) — the
-- one place a module id has historically disagreed with itself — and all three checks
-- fire identically on both arms.  A-3.5a/A-3.5b relocate MORE checking readers behind
-- this same ordinal; whoever writes them must not read the paragraph above as a
-- blanket safety property.  If a driver ever threads an id `buildDeclEnvs` did not
-- index, the remedy is at the READER (abstain loudly / fail the pass), not here — a
-- sentinel that means "everything" would break the consuming readers symmetrically.
declEnvsOrdOf : String -> DeclEnvs -> Int
declEnvsOrdOf mid envs = match omLookup mid envs.deOrdIndex
  Some k => k
  None => 0 - 1

-- 🪦 RETIRED 2026-08-12 (A-3.6 bite C-0): `declEnvsVisible` / `declEnvsUpTo` /
-- `declEnvsUpToGo` — the whole-ROW accessor path ("the graph as [mid] may see it").
-- A-3.1 shipped them speculatively and `export`ed `declEnvsVisible` only to keep
-- `rule-dead-code` off the unreached block; A-3.2a, A-3.2b, A-3.4 and A-3.5c each
-- then built their own visibility path and NONE of them used it.  Zero tree-wide
-- callers at deletion time (`grep -rn 'declEnvsVisible\|declEnvsUpTo' --include=*.mdk .`
-- → definitions and comments only).  It was also one of the direct call sites of
-- `declEnvVisibleAt`, so removing it makes that predicate's reader set entirely LIVE
-- before A-3.6 reasons about it — which is the point of retiring it first.
-- Do NOT re-add: the live shape is a predicate applied at the READ
-- (`declEnvVisibleTo` / `declEnvRowVisible` below), not a pre-filtered row list.

-- 🚨 THE SECOND VISIBILITY PREDICATE — A-3.2b (#1512), the interim rule RATIFIED by
-- the repo owner on that issue for K's declaration environments.  `DataEnv` keeps its
-- unfiltered whole-graph population (K is the whole graph, that is the point) and
-- visibility is applied HERE, at the READ, never open-coded at a read site — exactly
-- the discipline `declEnvVisibleAt` already imposes for the ordinal axis.
--
-- 🚨 THE TWO CONJUNCTS MUST STAY SEPARABLE, and that is the whole reason this is one
-- function taking `entryIsPublic` rather than a widened `declEnvVisibleAt`:
--   * the ORDINAL conjunct was described here as "transitional scaffolding for a
--     spec'd widening (§5 R2 / C4-I2 global candidacy)" that **A-3.6 deletes**.
--     ⚠️ IT DID NOT.  A-3.6 (#1558) split the predicate and flipped the INSTANCE
--     axis only (`ieCandidacyVisibleAt`); this conjunct reads `declEnvVisibleAt`,
--     which kept its body, so the ordinal conjunct here is LIVE and not scheduled
--     for deletion by any unit that currently exists.  The MEASURED paragraph two
--     down is why — it is this reader's own narrowing that made the split
--     necessary.  If a later unit does widen the name axis, it is that unit's
--     acceptance delta with that unit's fixtures.
--   * the PUBLICITY conjunct is NOT transitional either — it is the language's
--     export semantics, and under the target it MIGRATES TO R (§3 row L7), it does
--     not vanish.
-- The factoring is still what keeps the two answerable separately, and that is now
-- a permanent property rather than a deletion-safety measure: the two
-- `declEnvRowVisible` arms below read "own row ⇒ every decl, any other row ⇒ its
-- public projection", which is what R inherits, and neither conjunct can be widened
-- by editing the other.
--
-- WHY A PREDICATE IS NEEDED AT ALL (MEASURED on this tree, not argued): an unfiltered
-- whole-graph population used as the field-owner source turns a program that compiles
-- into `T-AMBIGUOUS-FIELD`, because a PRIVATE record in an unrelated module starts
-- voting in `resolveFieldByOwners`' ambiguity test.  That is a silent acceptance
-- NARROWING — false rejects on legal programs — and §5 R2's two enumerated exceptions
-- are both WIDENINGS carried by a could-not-pass-before fixture.  A narrowing cannot
-- meet that bar.
declEnvVisibleTo : Int -> Int -> Bool -> Bool
declEnvVisibleTo cur entryOrd entryIsPublic = declEnvVisibleAt cur entryOrd
  && (entryOrd == cur || entryIsPublic)

-- The decls of row [m] that a reader at ordinal [cur] may see — `declEnvVisibleTo`
-- applied at the only granularity at which its publicity conjunct is CONSTANT over a
-- row: the reader's own row (publicity irrelevant, every decl visible) versus any
-- earlier row (visible only in its public projection).  Both arms go through the
-- predicate; neither open-codes `<=` or a `pub` test.
--
-- ZERO ALLOCATION: both arms return a list the envelope already holds
-- (`demDecls` / the `demPubDecls` memo).  That is a MEASURED perf contract, not
-- style — see `importedCtorTypeDecls`, whose walk over this result runs once per
-- ctor-naming import member of every module, i.e. O(modules x universe).
-- Materialising a filtered pool here would convert that TIME term into an
-- ALLOCATION term of the same order, which is what the perf gate's `modules` shape
-- grades.
declEnvRowVisible : Int -> DeclEnvModule -> List Decl
declEnvRowVisible cur m
  | declEnvVisibleTo cur m.demOrd False = m.demDecls
  | declEnvVisibleTo cur m.demOrd True = m.demPubDecls
  | otherwise = []

-- ── doctests ─────────────────────────────────────────────────────────────
-- Both conjuncts, each shown to be separately load-bearing: a LATER row is invisible
-- whatever its publicity (ordinal conjunct), and an EARLIER row is visible only
-- publicly while the reader's OWN row is visible privately (publicity conjunct).
-- > declEnvVisibleTo 1 2 True
-- False
-- > declEnvVisibleTo 1 0 False
-- False
-- > declEnvVisibleTo 1 0 True
-- True
-- > declEnvVisibleTo 1 1 False
-- True

-- ── A-3.2b (#1512) slices 2+3: THE DATA-UNIVERSE SEED, READ OUT OF K ─────────
-- `crossRun.universeDataParamKinds` and `crossRun.universeFieldOwners` are
-- RETIRED.  Both were the same machine: a cell grown one module at a time by
-- `appendDataUniverse` and copied into a per-run working ref by
-- `loadDataUniverse` at the top of every module's `checkBodyImpl` Module arm.
-- Neither carried a module id or an ordinal, so neither could answer "as seen by
-- WHOM" — the question §2 K exists to make askable.  The seed now comes from the
-- whole-graph envelope, projected at the reading module's own ordinal through the
-- SAME two predicates the overlay pool reads (`declEnvVisibleAt` /
-- `declEnvVisibleTo`).  ⚠️ This clause used to end "so A-3.6 keeps its one-body
-- deletion"; A-3.6 (#1558) SPLIT the predicate rather than deleting it, and this
-- seed — a NAME/data-scoping table — kept its ordinal filter unchanged.
--
-- 🚨 THE SEED EXCLUDES THE READER'S OWN ROW, AND THAT IS NOT AN ORDINAL
-- STATEMENT.  A module registers its own decls directly, immediately after this
-- seed, via `registerAllData … prog0` — which is also what the retired
-- accumulator did (`appendDataUniverse` runs at the END of a module's arm, so the
-- universe a module LOADS holds every EARLIER module and never itself).  Seeding
-- the own row a second time would not merely duplicate work: `addFieldOwners`
-- does not dedupe, and `mangledHeadCandidates` reads that multimap RAW (no
-- `sortUniqS`), so a doubled owner key turns its `[pair]` singleton gate into the
-- give-up arm — `Some pair` becomes `None`.
--
-- 🚨 IT IS A CHAIN, NOT A PER-READ FOLD, AND THAT IS A MEASURED REQUIREMENT.  The
-- first cut of this unit folded the visible rows AT EVERY READ: O(universe) work
-- and allocation once per module, i.e. the "rebuild the whole thing once per
-- element" shape `compiler/AGENTS.md` opens with.  CI caught it —
-- `diff_compiler_perf_scaling`'s `modules` shape put `typecheck` TIME at
-- 0.299s/0.675s/1.872s over N=100/200/400 where the row's own note says the stage
-- has been UNDER the 200 ms floor since #154 PR-C, and the shape's climbing rule
-- (`r2 > r1 * 1.15 && r2 > 2.45`) failed it.  The ALLOC arm called the same run
-- `ok` at 2.24/2.42, which is exactly the second rule in `compiler/AGENTS.md`: a
-- quadratic that allocates little is invisible to the allocation arm.
--
-- So the seeds are built ONCE, in `buildDeclEnvs`, as a PREFIX CHAIN: reader k's
-- seed is reader (k-1)'s seed with row (k-1)'s public projection folded in, which
-- shares structure and costs O(whole graph) for the entire run.  The read is one
-- `omLookup` and allocates nothing.
--
-- 🚨 A-3.6 DID NOT EDIT HERE, AND THE INSTRUCTION THIS NOTE USED TO CARRY WAS A
-- LIVE REGRESSION.  It read: *"When A-3.6 makes `declEnvVisibleAt ≡ True`, every
-- reader must see the WHOLE chain instead of its own prefix: hand every row the
-- FINAL accumulator in `declEnvSeedChain` below."*  `test/registry_keying_ratchet.sh`
-- still says the same thing in its `declEnvsRef` and `deKindsBefore` rows.  **Do
-- not do it**, for two independent reasons:
--
--   1. THE FINAL ACCUMULATOR INCLUDES THE READER'S OWN ROW, and the own-row
--      exclusion is structural and mandatory — the 🚨 note above says so, and the
--      SAME ratchet row says so two sentences before instructing the edit that
--      destroys it.  A module re-registers its own decls immediately after this
--      seed via `registerAllData … prog0`, so seeding them here too doubles an
--      owner key that `mangledHeadCandidates` reads RAW, turning its singleton
--      gate into the give-up arm — live during inference.  That is now PINNED:
--      see the four `deSeedChainProbe` doctests below `deKindRow1`, which were
--      added by A-3.6 bite C-1 specifically as a tripwire on this edit and which
--      were confirmed to be the only assertions in this file that fire on it.
--   2. THE PREMISE IS FALSE ANYWAY.  A-3.6 (#1558) did not make
--      `declEnvVisibleAt ≡ True`; it split the predicate and flipped only the
--      instance axis (`ieCandidacyVisibleAt`).  These two seeds are name/data
--      scoping and keep the prefix rule.  Widening the field-owner half was in
--      fact the specific thing the owner ruling declined, because
--      `declEnvVisibleTo`'s MEASURED paragraph shows it NARROWS acceptance.
--
-- What the chain is, unchanged: it ENCODES `declEnvVisibleAt`'s prefix shape —
-- that is the whole source of the structure sharing — while each step still routes
-- its PROJECTION through `declEnvRowKindEntries`/`declEnvRowVisible`, hence through
-- `declEnvVisibleTo`'s two conjuncts.

-- The kind entries of row [m] that a reader at ordinal [cur] may see — the exact
-- peer of `declEnvRowVisible` one projection over, and composed from the same two
-- predicates rather than from an open-coded `<=` (see `declEnvVisibleTo`'s 🚨
-- note: an open-coded comparison here would be invisible to any future re-scoping
-- of the name axis, exactly as it would have been to A-3.6's had it landed here).
-- The own-row arm is unfiltered because a module's own kinds are: `registerData`'s
-- `DData` arm calls `recordParamKinds` regardless of `dataVis`.
declEnvRowKindEntries : Int -> DeclEnvModule -> List (TabKey, List Kind)
declEnvRowKindEntries cur m
  | declEnvVisibleTo cur m.demOrd False = declEnvKindEntries m.demDecls
  | declEnvVisibleTo cur m.demOrd True = m.demKindEntries
  | otherwise = []

-- 🚨 THE POPULATION HALF, AND IT MIRRORS `registerData`/`registerVariants` ARM FOR
-- ARM — including the arms they DO NOT have.  There is no `DAttrib` arm, because
-- `registerData` has none either (it falls through its `registerData env _ = env`
-- catch-all).  That gap is a real defect — #1586, S0 — but it spans resolve and
-- typecheck and is a deliberate behaviour change; a RETIREMENT whose bar is
-- neutrality must inherit it, not drain it.  Adding a `DAttrib` arm here would
-- give an attributed data type param kinds it does not have today and move
-- judgments (#1069/#1090 territory) inside a PR that claims to move none.
declEnvKindEntries : List Decl -> List (TabKey, List Kind)
declEnvKindEntries [] = []
declEnvKindEntries ((DData { dataName = n, dataParams = ps, dataCtors = vs, dataOrigin = o })::rest) = (tyTabKey o n, inferParamKinds ps vs) :: declEnvKindEntries rest
declEnvKindEntries ((DNewtype { newtypeName = n, newtypeParams = ps, newtypeCtor = con, newtypeFieldTy = fty, newtypeOrigin = o })::rest) = (tyTabKey o n, inferParamKinds ps [Variant con (ConPos [fty])]) :: declEnvKindEntries rest
declEnvKindEntries (_::rest) = declEnvKindEntries rest

-- `dataParamKindsRef`'s cross-module seed.  `deModules` is ASCENDING, and each
-- row's entries go on the LEFT of the accumulator, so the highest visible ordinal
-- ends up FIRST — which is what `recordParamKinds`' prepend / `lookupTab`'s
-- first-match ordering means (the reader's own registrations are then prepended
-- ON TOP of this by `registerAllData … prog0`, so the live list still reads
-- [prog0, overlay, universe]).
--
-- ⚠️ THAT ORDERING IS CURRENTLY UNOBSERVABLE, AND IS REPRODUCED ANYWAY.  Since
-- A-2.3 a `TabKey` is identity-bearing and `tabKeyEq` never equates `TkIdent` with
-- `TkBare`, so two modules' same-named types cannot share a key: the only
-- duplicate key is ONE declaration seen twice, whose two values are equal because
-- `inferParamKinds` is pure over the same inputs.  It goes live the moment a BARE
-- key can enter the same list — the flat-path population, drained by #1115 (E-1) —
-- at which point first-match means "last registered wins" again and the
-- #1069/#1070/#1090 family returns.  It costs a fold direction.  (INFERRED, argued
-- from the keying and the purity, not from a differential run.)
-- The chain itself, walked ONCE over the ordinal-ascending rows.  Before folding
-- row [m] in, both accumulators hold exactly "every row strictly earlier than
-- [m]", which IS [m]'s own seed — so it is stamped under [m]'s module id here and
-- read back by one `omLookup` per module.
--
-- ⚠️ THE PROJECTION IS READ AT `m.demOrd + 1`, THE ORDINAL OF THE NEXT READER, and
-- that is not a trick: `declEnvVisibleTo`'s publicity conjunct is CONSTANT over
-- every `cur > m.demOrd` (all of them take the non-own arm), so one evaluation at
-- the smallest such reader is the projection every later reader sees.  Doing it
-- this way keeps the projection defined in exactly one place —
-- `declEnvRowKindEntries` / `declEnvRowVisible` — instead of open-coding
-- `m.demKindEntries` / `m.demPubDecls` here, which is drift a later re-scoping of
-- the name axis would then have to find twice.
--
-- The field-owner population is `declEnvRowVisible` walked through the SAME
-- `Variant`/`ConNamed` filter `registerVariants` → `registerNamedFieldVariants` →
-- `registerRecordInfoKeyed` applies, so the owner string is the same `Variant`
-- constructor name off the same `Decl` node.  `DNewtype` contributes nothing (its
-- payload is always a synthesised `ConPos`), which is why there is no arm for it,
-- and `DAttrib` has none for the #1586 reason recorded on `declEnvKindEntries`.
declEnvSeedChain : List DeclEnvModule -> List (TabKey, List Kind) -> OrdMap (List String) -> OrdMap (List (TabKey, List Kind)) -> OrdMap (OrdMap (List String)) -> (OrdMap (List (TabKey, List Kind)), OrdMap (OrdMap (List String)))
declEnvSeedChain [] _ _ km om = (km, om)
declEnvSeedChain (m::rest) kacc oacc km om =
  declEnvSeedChain
    rest
    (declEnvRowKindEntries (m.demOrd + 1) m ++ kacc)
    (declEnvDeclFieldOwners (declEnvRowVisible (m.demOrd + 1) m) oacc)
    (omInsert m.demId kacc km)
    (omInsert m.demId oacc om)

declEnvDeclFieldOwners : List Decl -> OrdMap (List String) -> OrdMap (List String)
declEnvDeclFieldOwners [] acc = acc
declEnvDeclFieldOwners ((DData { dataCtors = vs })::rest) acc =
  declEnvDeclFieldOwners rest (declEnvVariantFieldOwners vs acc)
declEnvDeclFieldOwners (_::rest) acc = declEnvDeclFieldOwners rest acc

declEnvVariantFieldOwners : List Variant -> OrdMap (List String) -> OrdMap (List String)
declEnvVariantFieldOwners [] acc = acc
declEnvVariantFieldOwners ((Variant cn (ConNamed fields _))::rest) acc =
  declEnvVariantFieldOwners
    rest
    (addFieldOwners cn (map fieldNameOf fields) acc)
declEnvVariantFieldOwners (_::rest) acc = declEnvVariantFieldOwners rest acc

fieldNameOf : Field -> String
fieldNameOf (Field fn _) = fn

-- The ONE call site of the two seeds, so a future third table cannot be added on
-- one side only — the same "one body per direction" property `loadDataUniverse`
-- was factored for, which is what these two lines LEFT.
--
-- Keyed by the loader MODULE ID, the same string `buildDeclEnvs` stamped the chain
-- under, so no ordinal arithmetic happens at the read.  The core pass arrives as
-- `""` — the spelling both drivers pass for it — and `buildDeclEnvs` registers that
-- key explicitly, exactly as `declEnvOrdIndex` does, so ordinal 0's empty seed is a
-- HIT rather than a miss that happens to agree.
--
-- 🚨 A MISS YIELDS THE EMPTY SEED, AND THE TWO HALVES THEN FAIL IN OPPOSITE
-- DIRECTIONS.  Do not read this as one fail-CLOSED story — an earlier version of
-- this comment did, and it contradicted this same PR's own analysis two functions
-- up:
--   * OWNERS — fail-CLOSED, loud.  Zero owners makes `resolveFieldByOwners` take its
--     `[]` arm, `pushUnknownField`, exit 1.  A reader with an unknown id LOSES
--     cross-module owners and REJECTS; it cannot silently accept.
--   * KINDS — fail-SILENT.  A missing param-kind entry makes `fromAstTypeApp` fall
--     to `appFallback` instead of `foldAppKinds`, so a written row in a `KRow` slot
--     elaborates as an ordinary TYPE and the effect is erased at exit 0.  That is
--     #1069, the silent face of #804/#1028, and `opaque_export_row_kind_import`'s
--     own header calls it out.
--
-- ⚠️ THE SILENT DIRECTION IS NEW HERE, and saying so is the point of this note.
-- Before A-3.2b, `loadDataUniverse` copied the kind universe with NO KEY AT ALL, so
-- an unknown `mid` could not lose kinds — there was nothing to miss.  This unit
-- converted a key-free copy into a keyed lookup whose miss is `[]`.  The
-- REACHABILITY of an unknown `mid` is SUSPECTED-UNPROVEN in both directions
-- (nobody has constructed one, and the identical `declEnvsOrdOf` → `-1` dependency
-- already gates #1553's shipped ctor overlay, so the exposure is shared rather than
-- created here) — but the exposure's SEVERITY on the kind half is not the same as
-- the owner half's, and a future reader must not infer "loud" from this site.
declEnvSeedDataUniverse : String -> DeclEnvs -> Unit
declEnvSeedDataUniverse mid envs =
  perRun.value.dataParamKindsRef := fromOption [] (omLookup mid envs.deKindsBefore)
  perRun.value.fieldOwnersRef := fromOption omEmpty (omLookup mid envs.deOwnersBefore)

-- ── doctests ─────────────────────────────────────────────────────────────
-- The three arms of `kindPublicDataDecl` that `publicDataDecl` does NOT have are
-- each load-bearing here: `deKindRow0`'s decls are public data, ABSTRACT data,
-- PRIVATE data and a PUBLIC NEWTYPE, so the kind-public projection is 3 (drop the
-- private one) while the own-row projection is all 4.  Drop the `VisAbstract` arm
-- or the `DNewtype` arm and the first number falls to 2 or 1.
-- > listLen deKindRow0.demKindEntries
-- 3
-- > listLen (declEnvKindEntries deKindRow0.demDecls)
-- 4

-- Both conjuncts, on the kind projection: own row ⇒ everything; earlier row ⇒ the
-- kind-public projection; later row ⇒ nothing.
-- > listLen (declEnvRowKindEntries 0 deKindRow0)
-- 4
-- > listLen (declEnvRowKindEntries 1 deKindRow0)
-- 3
-- > listLen (declEnvRowKindEntries 0 deKindRow1)
-- 0

-- The field-owner population: only a `ConNamed` variant votes, and it votes under
-- its CONSTRUCTOR name.
-- > fromOption [] (omLookup "x" (declEnvDeclFieldOwners [deFieldOwnerFixtureA] omEmpty))
-- ["Pt"]
-- > fromOption [] (omLookup "x" (declEnvDeclFieldOwners [deKindNewtypeFixture] omEmpty))
-- []

-- Fixtures for the doctests above.  `deKindRow1` is the SAME decls at ordinal 1,
-- which is how the later-row arm is exercised without a second decl set.
deKindAbstractFixture : Decl
deKindAbstractFixture = DData {
  dataVis = VisAbstract,
  dataName = "Opq",
  dataParams = [],
  dataCtors = [Variant "MkOpq" (ConPos [tyConBuiltin "Int" None])],
  dataDerives = [],
  dataOrigin = OriginModule "m",
}

deKindPrivateFixture : Decl
deKindPrivateFixture = DData {
  dataVis = VisPrivate,
  dataName = "Priv",
  dataParams = [],
  dataCtors = [Variant "MkPriv" (ConPos [tyConBuiltin "Int" None])],
  dataDerives = [],
  dataOrigin = OriginModule "m",
}

deKindNewtypeFixture : Decl
deKindNewtypeFixture = DNewtype {
  newtypePub = True,
  newtypeName = "Wrap",
  newtypeParams = [],
  newtypeCtor = "Wrap",
  newtypeFieldTy = tyConBuiltin "Int" None,
  newtypeDerives = [],
  newtypeOrigin = OriginModule "m",
}

deKindFixtureDecls : List Decl
deKindFixtureDecls = [
  deFieldOwnerFixtureA,
  deKindAbstractFixture,
  deKindPrivateFixture,
  deKindNewtypeFixture,
]

deKindRow0 : DeclEnvModule
deKindRow0 = declEnvModule 0 "m" deKindFixtureDecls

deKindRow1 : DeclEnvModule
deKindRow1 = declEnvModule 1 "m" deKindFixtureDecls

-- ── A-3.6 bite C-1: THE OWN-ROW EXCLUSION, ASSERTED RATHER THAN INCIDENTAL ────
-- `declEnvSeedChain` stamps row [m]'s id with the accumulators as they stand
-- BEFORE [m] is folded in, so [m]'s seed is "every row strictly earlier than
-- [m]" and never [m] itself.  That is a STRUCTURAL property of the fold order —
-- there is no ordinal test to find and none to keep — and until now it was
-- asserted only in prose two hundred lines up.  Prose is not fail-capable, and
-- the exclusion is load-bearing in a way an ordinal statement is not: a module
-- registers its OWN decls a second time, immediately after this seed, through
-- `registerAllData … prog0`.  Seeding the own row here too would put the same
-- `cname` key in `fieldOwnersRef` twice, `addFieldOwners` does not dedupe, and
-- `mangledHeadCandidates` reads that multimap RAW — so a doubled owner key turns
-- `lookupRecordByMangledHead`'s `[pair]` singleton gate into its give-up arm,
-- LIVE during inference rather than inertly after it.
--
-- 🚨 SO THESE FOUR LINES ARE A TRIPWIRE ON A SPECIFIC WRONG EDIT, and it is one
-- an implementer can arrive here already instructed to make:
-- `test/registry_keying_ratchet.sh`'s `declEnvsRef` row tells A-3.6 to *"hand
-- every row the FINAL accumulator"*.  Doing that destroys the exclusion the same
-- row calls structural.  Every assertion below moves if it is done — that is the
-- fail-capability argument, and it is by construction, not by hope:
--   * `deSeedChainProbe` is a TWO-row chain, so the final accumulator differs
--     from every row's prefix.  Row "m" is FIRST, so its correct seed is EMPTY
--     while the final accumulator holds both rows: 0 → 6 kinds, `[]` → two
--     owners.  Row "n" is LAST, so its correct seed is row "m" alone while the
--     final accumulator adds "n"'s own identical `Pt`: 3 → 6 kinds, and
--     `["Pt"]` → `["Pt", "Pt"]` — the doubled key itself, named.
--   * A ONE-row chain could not discriminate any of that (prefix and final
--     accumulator coincide at the only row), which is why the probe carries two
--     rows with DISTINCT ids rather than reusing `deKindRow0`/`deKindRow1`.
-- > listLen (fromOption [] (omLookup "m" (fst deSeedChainProbe)))
-- 0
-- > fromOption [] (omLookup "x" (fromOption omEmpty (omLookup "m" (snd deSeedChainProbe))))
-- []
-- > listLen (fromOption [] (omLookup "n" (fst deSeedChainProbe)))
-- 3
-- > fromOption [] (omLookup "x" (fromOption omEmpty (omLookup "n" (snd deSeedChainProbe))))
-- ["Pt"]

-- Row "n" carries the SAME decls as `deKindRow0` at ordinal 1 under a DIFFERENT
-- module id.  Same decls is deliberate: it makes the own-row contribution and the
-- earlier row's contribution identical values, so the only thing the assertions
-- above can be reading is WHICH ROWS were folded, never which decls.
deSeedRowN : DeclEnvModule
deSeedRowN = declEnvModule 1 "n" deKindFixtureDecls

deSeedChainProbe : (OrdMap (List (TabKey, List Kind)), OrdMap (OrdMap (List String)))
deSeedChainProbe =
  declEnvSeedChain [deKindRow0, deSeedRowN] [] omEmpty omEmpty omEmpty

-- ── A-3.2a (#1112): the `DataEnv` slice ─────────────────────────────────────
-- ⚠️ This banner read "CONSTRUCTION ONLY, NOT LIVE" and that lapsed with A-3.2b
-- residual 1 (#1512), which gave `deAliases` a production reader (`aliasUniverseAt`,
-- called from `loadDataUniverse`).  The prose below is A-3.2a's own bar, kept as the
-- derivation of why this slice is SYNTACTIC; it is no longer a statement about
-- liveness.  Corrected here by #1557 A-3.5c because its sibling `deIfaces` was being
-- fixed one line over and leaving this one would have made the record read
-- "DataEnv inert, CE live" — inverted in the other direction.
-- §2 K: *"`DataEnv`: datatypes, constructor schemes, records and field
-- ownership, aliases with cycle rejection."*  #1112's own decomposition table
-- describes A-3.2 as retiring `load`/`store` (`loadDataUniverse`/
-- `storeDataUniverse`) plus the `importedCtorTypeDecls` overlay ladder onto
-- #1319's identity keys — i.e. it names BOTH construction AND retirement.
-- Those two are incompatible under one bar: retiring a live table can only be
-- judged by running the program differently, and this PR's bar is
-- BYTE-IDENTICAL.  So this slice, A-3.2a, does CONSTRUCTION ONLY: it builds
-- `DataEnv` and wires it into `DeclEnvs`/`buildDeclEnvs`, and retires NOTHING
-- — no `universe*`/`obUniv*` row, no `load`/`store` call, no overlay.  The
-- retirement (absorbing #1319 unit 4) is a follow-on PR, A-3.2b.
--
-- This unit lands the SYNTACTIC half only — an identity-keyed index over the
-- RAW declarations, built once from `DeclEnvs`'s own ordinal-tagged decl
-- list.  It carries NO elaborated `Scheme`/`RecordInfo`/`Mono` — see why
-- below — and it is NOT LIVE: no caller outside this block populates or
-- reads `deData`, for the identical reason the retired `declEnvsVisible`
-- accessor above had no caller (bite C-0, 2026-08-12 — it never gained one and
-- was deleted).  "Byte-identical" is therefore WEAK evidence for this PR — nothing
-- reads the new field, so nothing could have moved a judgment even if the
-- construction were wrong.  The load-bearing checks are the STATIC ones (the
-- doctests below) and the additive-only golden diffs, not the differential
-- gates.
--
-- ⚠️ VISIBILITY DIVERGENCE, and A-3.2b ANSWERED IT AT THE READ SITE rather
-- than here: `buildDataEnv` still folds EVERY decl in `deAllDecls`, private
-- included, and `deFieldOwnerIdents` is therefore a SUPERSET of what the
-- retired `universeFieldOwners` ever held (which accumulated only `pubDecls`,
-- plus a separate opaque-kind-only pass for the kind half).  That is why the
-- field-owner seed (`declEnvSeedChain`) is built from `declEnvRowVisible`
-- over the per-module ROWS and NOT from this flat table: `DataEnv` is
-- ordinal-free, so it cannot answer a visibility question at all, and reading
-- it unfiltered would let a PRIVATE record in an unrelated module vote in
-- `resolveFieldByOwners`' ambiguity test — a `T-AMBIGUOUS-FIELD` on a program
-- that compiles today, i.e. an acceptance NARROWING.  `deFieldOwnerIdents`
-- still has no reader; what it uniquely states (two SAME-NAMED owners kept
-- apart by identity) is the thing the bare seed cannot, and it is owed to the
-- unit that re-keys the owner list rather than to this retirement.
--
-- ⚠️ LATENT DIVERGENCE, noted rather than fixed: `addCtorIdentRaw` (below)
-- upserts unconditionally, unlike `addCtorIdentCand`'s upsert-by-identity
-- (`dropCtorIdentCand`) which exists to keep a RE-REGISTERED declaration from
-- self-colliding when the same decl list is folded more than once.
-- `buildDataEnv` folds `deAllDecls` exactly ONCE, so no producer re-presents
-- the same identity today and the divergence is inert — but a future caller
-- that folds a decl list twice (mirroring how `appendDataUniverse` can run
-- per module) would need the same guard `addCtorIdentCand` has.
--
-- 🚨 WHY NOT JUST CALL `registerAllData`/`insertCtorIdents`/`insertRecordIdents`.
-- Every one of those reads or writes `perRun`/`crossRun` REFS as a side effect
-- (`recordParamKinds`, `registerRecordInfoKeyed`, `lookupCtor`,
-- `lookupRecordByName`), and elaborating a ctor's field types
-- (`fromAstTypeE`) resolves aliases through `perRun.value.aliasTableRef`.
--
-- 🚨 THE TYVAR-COUNTER ARGUMENT THAT USED TO STAND HERE IS FALSE — DELETED
-- 2026-08-12, and recorded rather than silently dropped because `:4254` below
-- routes every future `CE`/`DataEnv` implementer to THIS block as "the full
-- derivation", so the falsified version was steering them into a wall that is
-- not there.  It said tyvar ids are minted "from a global monotonic counter"
-- owned by the per-module walk.  DERIVED false: `tyvarCounter` is a `PerRun`
-- field (see `data PerRun`), `freshPerRun` initialises it `Ref 0`, and
-- `resetState` mints a whole fresh `PerRun` PER MODULE.  The counter is
-- per-module.  Schemes in the data universe already cross module boundaries
-- carrying ids minted under a different counter epoch, and that is already
-- tolerated, because every consumer re-instantiates (`freshSubst`,
-- `instantiateRecord`) — a `Scheme`'s quantified ids are scheme-local.
--
-- THE WALLS THAT ARE REAL, AND THEY ARE WHY THE CONCLUSION BELOW IS UNCHANGED:
--   (a) EFFECTS.  Those functions WRITE `perRun` refs — `registerData`'s
--       `DTypeAlias` arm (`aliasTableRef`), `recordParamKinds`
--       (`dataParamKindsRef`), `registerRecordInfoKeyed` (`recordByNameRef` +
--       `fieldOwnersRef`).  `buildDeclEnvs` runs in the driver PREAMBLE, so
--       calling them here corrupts the tables the live per-module walk depends
--       on unless each write is separately isolated.
--   (b) DIAGNOSTICS — RELAYED from P0-A (`.claude/sprint/phase0/`), NOT
--       re-derived at this line; treat as the first thing to check, not as
--       established.  `fromAstTypeE` EMITS type errors: `T-ALIAS-ARITY` and
--       `T-ROW-KIND-MISMATCH`, both through `pushTypeErrorOnce`/`…At`, whose
--       `Once` dedupe reads `perRun.typeErrors` — a bundle `resetState`
--       re-mints per module.  Elaborating in the preamble would MERGE that
--       dedupe scope across the whole module graph (one diagnostic per compile
--       where there is one per importing module today) and RELOCATE the push
--       outside any module's harvest window.  Both directions are strictly
--       FEWER diagnostics on a program that is rejected today — loud → silent,
--       which this repo's ladder counts as a severity INCREASE.
--
-- So this index is deliberately SYNTACTIC: raw
-- `Variant`/`Field`/`Ty` nodes, keyed by identity, no elaboration performed.
data DataTypeDecl = DataTypeDecl {
    dtKey : TabKey,
    dtName : String,  -- identity key, `tyTabKey dtOrigin dtName` — same family as `universeDataParamKinds`
    dtOrigin : TyConOrigin,
    dtParams : List String,
    dtVariants : List Variant,
  }

-- A-3.2b residual (#1512): `adOrd`/`adPub` are the two INPUTS `declEnvVisibleTo`
-- takes, carried ON THE ROW rather than re-derived at the read.  They are here —
-- and not on `DataTypeDecl` — because THIS is the row that has a production
-- reader: `aliasUniverseAt` is the whole-graph replacement for the retired
-- `crossRun.universeAliasTable`, and it must answer "which aliases can a reader
-- at ordinal k see" without walking every module's decls again (the per-module ×
-- per-decl shape `importedCtorTypeDecls` already pays once).
--
-- 🚨 THEY ARE THE PREDICATE'S ARGUMENTS, NOT A SECOND COPY OF ITS BODY.  Both
-- are consumed by `aliasUniverseAt` through `declEnvVisibleTo` itself; nothing
-- here open-codes `<=` or a `pub` test, which this file prohibits in four places
-- (`grep -n 'open-cod' compiler/types/typecheck.mdk`) — see `declEnvRowVisible`,
-- whose own comment is *"Both arms go through the predicate; neither open-codes
-- `<=` or a `pub` test."*
--
-- ⚠️ `adPub` IS A CALL, NOT A COPIED FIELD.  It is `publicDataDecl` applied to
-- the alias's own `Decl` — the SAME predicate `demPubDecls`
-- (`publicDataDecls decls`) routes through, and deliberately not a verbatim
-- `tyAliasPub` read.  `declEnvModule`'s note says a second construction site
-- *"is exactly how the two would come to disagree"*; storing the field would
-- make `deAliases` the one publicity decision in `DeclEnvs` that a future edit
-- to `publicDataDecl`'s `DTypeAlias` arm silently leaves behind.
--
-- `adAttrib` records that this alias was reached THROUGH a `DAttrib` wrapper.
-- It is POPULATION-NEUTRAL on purpose — see `aliasUniverseAt`, which applies it
-- at the READ, and the 🚨 note on `dataEnvAddDecl`.
data AliasDecl = AliasDecl {
    adKey : TabKey,
    adName : String,  -- identity key, `tyTabKey o adName` — same family as the retired `universeAliasTable`
    adParams : List String,
    adRhs : Ty,
    adOrd : Int,
    adPub : Bool,
    adAttrib : Bool,
  }

-- `deFieldOwnerIdents` is the NEW identity-keyed table: `universeFieldOwners`
-- (`crossRun`) is bare-String-keyed only and has no identity companion today
-- (unlike the ctor/record tables, which A-2.11/A-2.12 (#1319 units 1/2)
-- already gave one).  Mirrors `deCtorIdents`/`deRecordIdents`'s shape: field
-- name -> every (owning ctor Ident, owning ctor name) that declares it, in
-- declaration order.
--
-- ⚠️ `universeFieldOwners`'s `addFieldOwners` is ALREADY a multimap, so two
-- DIFFERENT ctor names sharing a field are NOT the case this table adds
-- anything for — the bare table shows both rows already.  What only THIS
-- table can state is the case where the OWNING CTOR NAME REPEATS: two
-- records both named "Pt" (in different modules) sharing a field "x" append
-- the SAME bare string "Pt" twice to the bare table's owner list, which a
-- reader cannot tell apart from one declaration counted twice.
-- `deFieldOwnerIdents` keeps the two as distinct `Ident`s (different
-- `TyConOrigin`) — see `distinctIdentsIn2` and the doctests below.
data DataEnv = DataEnv {
    deTypes : List (TabKey, DataTypeDecl),
    deCtorIdents : OrdMap (List (Ident, String, Variant)),
    deRecordIdents : OrdMap (List (Ident, String, List Field)),
    deFieldOwnerIdents : OrdMap (List (Ident, String)),
    deAliases : List (TabKey, AliasDecl),  -- A-3.2b residual (#1512): LIVE — the sole cross-module alias source, read by `aliasUniverseAt`
  }

emptyDataEnv : DataEnv
emptyDataEnv = DataEnv {
  deTypes = [],
  deCtorIdents = omEmpty,
  deRecordIdents = omEmpty,
  deFieldOwnerIdents = omEmpty,
  deAliases = [],
}

-- Build the whole-graph `DataEnv` from the per-module rows — the SAME rows
-- `deImpls`/`deIfaces` fold, visiting the same decls in the same order the
-- flattened `deAllDecls` holds them (`declEnvDeclsOf` is those rows' `demDecls`
-- concatenated in ordinal order), so nothing about the four bare-name-free
-- tables below moves by taking rows instead of the flat list.
--
-- A-3.2b residual (#1512) TOOK THE ROWS for one reason: `deAliases` now carries
-- the declaring module's ORDINAL, and the flattened list has no ordinal in it —
-- the same reason `buildImplEnv` has always read rows (see `buildDeclEnvs`).
buildDataEnv : List DeclEnvModule -> DataEnv
buildDataEnv rows = dataEnvFromRowsGo rows emptyDataEnv

dataEnvFromRowsGo : List DeclEnvModule -> DataEnv -> DataEnv
dataEnvFromRowsGo [] acc = acc
dataEnvFromRowsGo (m::rest) acc =
  dataEnvFromRowsGo rest (dataEnvFromDeclsGo m.demOrd m.demDecls acc)

dataEnvFromDeclsGo : Int -> List Decl -> DataEnv -> DataEnv
dataEnvFromDeclsGo _ [] acc = acc
dataEnvFromDeclsGo ord (d::rest) acc =
  dataEnvFromDeclsGo ord rest (dataEnvAddDecl ord False d acc)

-- ONE decl into the index.  [att] is True once a `DAttrib` wrapper has been
-- unwrapped on the way here; nested wrappers recurse (the parser can produce
-- `DAttrib [a] (DAttrib [b] d)`).
--
-- 🚨 THE `DAttrib` UNWRAP IS UNIFORM ACROSS ALL FIVE TABLES, AND THE ATTRIBUTED
-- ALIAS IS DROPPED AT THE *READ*, NOT HERE.  That split is the point, and an
-- earlier draft of this unit got it backwards.
--
-- The fact being recorded: `registerData` has no `DAttrib` arm (it falls to
-- `registerData env _ = env`) and neither does `publicDataDecl`, so an
-- ATTRIBUTED type alias — `@deprecated "…"` / `type X = Int` — is invisible to
-- the LIVE alias table in both directions today.  MEASURED on this tree: that
-- program is rejected `Type mismatch: Int vs X` + `No impl of Num for X`, i.e.
-- `X` stays an opaque `TCon`.  Letting it into `aliasUniverseAt`'s result would
-- expand it in IMPORTERS while it stayed opaque where it was declared — an
-- acceptance WIDENING, incoherent besides, and not one this unit may make.
--
-- ⚠️ WHY THE POPULATION KEEPS IT ANYWAY.  `deTypes`/`deCtorIdents`/
-- `deRecordIdents`/`deFieldOwnerIdents` all keep A-3.2a's unwrap and are strict
-- supersets on this axis.  Filtering the alias row out of the POPULATION would
-- make two rows of one record answer "does an attributed decl count?" by
-- opposite mechanisms, which is worse than either choice alone — and #1512's
-- own precondition comment requires slice 3 to solve the identical problem with
-- a READ-side guard.  So `adAttrib` is recorded here and applied there.
--
-- 🚨 THE RE-ADD CONDITION, STATED SO A LATER FIXER CANNOT GET IT HALF-RIGHT.
-- This drop exists ONLY because the live table has no attributed aliases in it.
-- #1228/#1586 are the issues that would change that: whoever gives `registerData`
-- (and `publicDataDecl`) a `DAttrib` arm so an attributed alias expands where it
-- is DECLARED **must delete `adAttrib`'s conjunct in `aliasUniverseAt` in the
-- same diff.** Leaving this guard in place then produces the MIRROR of the
-- widening it was added to prevent — expands locally, opaque in importers — and
-- no fixture in the tree would catch that, because every fixture here asserts the
-- current, both-directions-invisible state.
dataEnvAddDecl : Int -> Bool -> Decl -> DataEnv -> DataEnv
dataEnvAddDecl ord _ (DAttrib _ d) acc = dataEnvAddDecl ord True d acc
dataEnvAddDecl ord _ (DData { dataName, dataParams, dataCtors, dataOrigin, ... }) acc = addDataTypeDecl dataName dataOrigin dataParams dataCtors acc
dataEnvAddDecl ord _ (DNewtype { newtypeName, newtypeParams, newtypeCtor, newtypeFieldTy, newtypeOrigin, ... }) acc = addDataTypeDecl newtypeName newtypeOrigin newtypeParams [Variant newtypeCtor (ConPos [newtypeFieldTy])] acc
-- `publicDataDecl d` — the shared predicate applied to the alias's own decl, not
-- a `tyAliasPub` read.  See `AliasDecl`'s ⚠️ note.
dataEnvAddDecl ord att (d@(DTypeAlias { tyAliasName, tyAliasParams, tyAliasRhs, tyAliasOrigin, ... })) acc = addAliasDecl tyAliasName tyAliasOrigin tyAliasParams tyAliasRhs ord (publicDataDecl d) att acc
dataEnvAddDecl _ _ _ acc = acc

addDataTypeDecl : String -> TyConOrigin -> List String -> List Variant -> DataEnv -> DataEnv
addDataTypeDecl name o params variants env =
  let key = tyTabKey o name
  let dt = DataTypeDecl {
    dtKey = key,
    dtName = name,
    dtOrigin = o,
    dtParams = params,
    dtVariants = variants,
  }
  addVariantIdentsRaw
    name
    o
    variants
    DataEnv { env | deTypes = (key, dt)::env.deTypes }

addVariantIdentsRaw : String -> TyConOrigin -> List Variant -> DataEnv -> DataEnv
addVariantIdentsRaw _ _ [] env = env
addVariantIdentsRaw tyName o ((Variant cn payload)::rest) env =
  addVariantIdentsRaw tyName o rest (addCtorIdentRaw tyName o cn payload env)

-- Honest absence, exactly as `addCtorIdentCand`: no module id ⇒ no identity ⇒
-- no candidate — `mkIdent` refuses `OriginUnresolved`/`OriginModule ""`.
addCtorIdentRaw : String -> TyConOrigin -> String -> ConPayload -> DataEnv -> DataEnv
addCtorIdentRaw tyName o cn payload env = match mkIdent NsCtor o cn
  None => env
  Some ident =>
    let next = fromOption [] (omLookup cn env.deCtorIdents) ++ [(ident, tyName, Variant cn payload)]
    let env2 = DataEnv { env | deCtorIdents = omInsert cn next env.deCtorIdents }
    match payload
      ConNamed fields _ => addRecordIdentRaw tyName cn ident fields env2
      ConPos _ => env2

addRecordIdentRaw : String -> String -> Ident -> List Field -> DataEnv -> DataEnv
addRecordIdentRaw tyName cn ident fields env =
  let next = fromOption [] (omLookup cn env.deRecordIdents) ++ [(ident, tyName, fields)]
  addFieldOwnerIdents
    ident
    cn
    fields
    DataEnv { env | deRecordIdents = omInsert cn next env.deRecordIdents }

addFieldOwnerIdents : Ident -> String -> List Field -> DataEnv -> DataEnv
addFieldOwnerIdents _ _ [] env = env
addFieldOwnerIdents ident cn ((Field fn _)::rest) env =
  let next = fromOption [] (omLookup fn env.deFieldOwnerIdents) ++ [(ident, cn)]
  addFieldOwnerIdents
    ident
    cn
    rest
    DataEnv { env | deFieldOwnerIdents = omInsert fn next env.deFieldOwnerIdents }

-- 🚨 THE PREPEND IS THE ORDER CONTRACT, not an implementation detail.  Rows are
-- folded in ASCENDING ordinal, decls in declaration order, and each row is
-- CONSED — so `deAliases` reads back DESCENDING by ordinal, and within one
-- module in reverse declaration order.  That is byte-for-byte the order the
-- retired `crossRun.universeAliasTable` had: `loadDataUniverse` seeded module
-- k's working table from the universe and `registerAllData` consed module k's
-- own public aliases onto its FRONT before `storeDataUniverse` wrote it back,
-- so the accumulator was `[k rev] ++ [k-1 rev] ++ … ++ [0 rev]` too.
-- Order is observable twice over: `lookupTab` is FIRST-match, and
-- `rejectCyclicAliases` builds its graph from this list in list order and
-- `emitCyclicAliasErrors` renders in that order into goldens.  See
-- `aliasUniverseAt`, which filters this list and therefore preserves it.
addAliasDecl : String -> TyConOrigin -> List String -> Ty -> Int -> Bool -> Bool -> DataEnv -> DataEnv
addAliasDecl name o params rhs ord pub att env =
  let key = tyTabKey o name
  let ad = AliasDecl {
    adKey = key,
    adName = name,
    adParams = params,
    adRhs = rhs,
    adOrd = ord,
    adPub = pub,
    adAttrib = att,
  }
  DataEnv { env | deAliases = (key, ad)::env.deAliases }

-- ── A-3.2b residual (#1512): the alias universe, sourced from stage K ──────
--
-- THE RETIREMENT.  `crossRun.universeAliasTable` was a cross-run accumulator
-- grown one module at a time by `appendDataUniverse`'s load/register/store
-- round trip.  It is GONE; this is its whole-graph replacement, and it is a
-- projection of K rather than a second copy of the same fact.
--
-- 🚨 THREE SEPARATELY NAMED CONDITIONS, AND THE SPLIT IS THE WHOLE DESIGN.
-- They are NOT one fused `adPub && adOrd < cur` test — this file prohibits
-- open-coding the filter in four places (`grep -n 'open-cod'`), and
-- `declEnvRowVisible`'s own comment is *"Both arms go through the predicate;
-- neither open-codes `<=` or a `pub` test."*
--
--   1. `declEnvVisibleTo cur ad.adOrd ad.adPub` — BOTH ratified conjuncts, the
--      ordinal one and the publicity one, applied through the ONE predicate.
--      This is a production reader of `declEnvVisibleAt`.  ⚠️ It used to say "the
--      THIRD (after `declEnvRowVisible` and `ieSnapAt`); the ratchet's
--      `declEnvsRef` row records all three".  BOTH halves are now wrong: the
--      ratchet's count was measured wrong in both directions (RUN-007/RUN-013 —
--      it is eight leaf read paths, not three), and `ieSnapAt` is no longer a
--      reader of this predicate at all, having moved to `ieCandidacyVisibleAt` at
--      A-3.6.  DERIVE the set; do not carry a count.
--   2. `ad.adOrd /= cur` — the OWN-ROW EXCLUSION.  ⚠️ THIS ONE IS STRUCTURAL, NOT
--      TRANSITIONAL.  This clause used to justify itself by "A-3.6 deletes
--      `declEnvVisibleAt`'s body, at which point condition 1 reduces to the
--      publicity conjunct alone and this line is the only thing still keeping the
--      reader's own row out."  A-3.6 did NOT delete that body (it split the
--      predicate and flipped the instance axis only), so condition 1 still
--      carries the ordinal — but the conclusion is UNCHANGED and does not depend
--      on the premise: this condition is structural on its own terms.  It is not
--      an ordinal FILTER wearing an
--      ordinal's clothes: the retired accumulator held the public aliases of
--      every module whose arm had ALREADY FINISHED (`appendDataUniverse` is the
--      last statement of a module's arm), so a reader at ordinal k saw
--      0..k-1 and never itself, and its own aliases — public AND private —
--      arrive by a route this unit does not touch (`registerAllData … prog0`
--      conses them onto the front of the working `aliasTableRef`).  Dropping
--      this would double-register every public alias the reader declares.
--      Conditions 1 ∧ 2 are exactly the `<` the accumulator had (`<=` ∧ `/=`).
--      ⚠️ This used to add "under A-3.6 they reduce to `adPub && adOrd /= cur`,
--      which is the intended end state".  They do NOT: A-3.6 left the alias table
--      — a NAME-scoping table — on `declEnvVisibleAt`, deliberately, because
--      `DICT-SEMANTICS.md`'s I5 boundary clause says its price does not extend to
--      names.  That reduction is owed to whichever unit widens the name axis, if
--      one ever is; it is not scheduled.
--   3. `not ad.adAttrib` — the attributed-alias drop, applied HERE at the read
--      rather than in the population.  See the 🚨 note on `dataEnvAddDecl` for
--      why, and for the condition under which #1228/#1586 must delete it.
--
-- ⚠️ THE CYCLIC-ALIAS REMOVAL IS PRESERVED BY DOING NOTHING.
-- `rejectCyclicAliases` DELETES cyclic entries from the per-run
-- `aliasTableRef`, and that deletion never reached the accumulator either:
-- `appendDataUniverse` opens by RELOADING the working ref from the universe,
-- discarding the filtered value, before it registers and stores.  So the
-- cross-module alias source has always held cyclic entries and every module
-- re-detects them through its own `rejectCyclicAliases` call.  This function
-- reproduces that exactly — it filters on visibility only.  A future edit that
-- "helpfully" pre-drops cyclic aliases here would silence the second and later
-- modules' `T-RECURSIVE-ALIAS`, which is a loud → silent severity increase.
-- Pinned by the `1512-A32b/alias-cycle-importer` leg of
-- `test/diff_compiler_check_cli_modules.sh`, which requires the diagnostic to
-- name BOTH the declaring module and the importer.
-- ⚠️ ALLOCATION SHAPE, RECORDED BECAUSE THE PERF GATE CANNOT SEE IT.  The line
-- this replaced in `loadDataUniverse` was a pointer copy (`setRef … .value`);
-- this MATERIALISES a filtered list, and it runs twice per module (the arm's
-- own reload and `appendDataUniverse`'s).  That is the allocation term
-- `declEnvRowVisible`'s "ZERO ALLOCATION … MEASURED perf contract" note forbids
-- for its sibling — and `diff_compiler_perf_scaling.sh`'s `gen_modules` shape
-- declares no type aliases at all, so the gate is BLIND to it (derive, don't
-- trust: `grep -n 'type ' test/diff_compiler_perf_scaling.sh`).
-- It is immaterial at this size and that was MEASURED, not assumed — but by PR
-- #1588's independent reviewer, not by me, so it is RELAYED: with 24 aliases,
-- 40 modules 864 → 824 ms and 80 modules 3489 → 3462 ms (interleaved, min of 3),
-- i.e. inside the noise.  The reason it stays immaterial is that `deAliases` is
-- SMALL — 11 type aliases in the whole tree today.  If a future graph makes
-- aliases numerous, the fix is the per-ordinal snapshot `ieUnivSnaps` already
-- uses for `IE`, not a wider filter.
aliasUniverseAt : Int -> List (TabKey, AliasDecl) -> List (TabKey, (List String, Ty))
aliasUniverseAt _ [] = []
aliasUniverseAt cur ((key, ad)::rest)
  | aliasVisibleTo cur ad =
    (key, (ad.adParams, ad.adRhs)) :: aliasUniverseAt cur rest
  | otherwise = aliasUniverseAt cur rest

-- The three conditions of the block above, in that order.  Split out so each is
-- separately readable and separately greppable.  ⚠️ This said "A-3.6 edits
-- condition 1's predicate and must leave conditions 2 and 3 standing".  A-3.6
-- (#1558) edited NONE of the three — the alias table is a NAME-scoping table and
-- the split ruling left the whole name axis alone.  All three conditions stand as
-- written; the split-out shape is what will make a future name-axis unit cheap, and
-- conditions 2 and 3 remain structural whatever happens to condition 1.
aliasVisibleTo : Int -> AliasDecl -> Bool
aliasVisibleTo cur ad = declEnvVisibleTo cur ad.adOrd ad.adPub
  && ad.adOrd /= cur
  && not ad.adAttrib

-- Fixture for the doctests below: a PUBLIC alias in the prelude row (ordinal 0),
-- a PRIVATE one beside it, and a public one in a later module (ordinal 1).
aliasFixturePubCore : Decl
aliasFixturePubCore = DTypeAlias {
  tyAliasPub = True,
  tyAliasName = "PubCore",
  tyAliasParams = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "core",
}

aliasFixturePrivCore : Decl
aliasFixturePrivCore = DTypeAlias {
  tyAliasPub = False,
  tyAliasName = "PrivCore",
  tyAliasParams = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "core",
}

aliasFixturePubM : Decl
aliasFixturePubM = DTypeAlias {
  tyAliasPub = True,
  tyAliasName = "PubM",
  tyAliasParams = [],
  tyAliasRhs = tyConBuiltin "Int" None,
  tyAliasOrigin = OriginModule "m",
}

-- PUBLIC, but wrapped in an attribute — the shape `registerData` and
-- `publicDataDecl` both drop.  It IS in the population (`deAliases` holds four
-- rows, asserted below) and is dropped at the READ by `aliasVisibleTo`'s third
-- condition.  See the 🚨 note on `dataEnvAddDecl`.
aliasFixtureAttribCore : Decl
aliasFixtureAttribCore = DAttrib
  [AttrDeprecated "old"]
  DTypeAlias {
    tyAliasPub = True,
    tyAliasName = "AttribCore",
    tyAliasParams = [],
    tyAliasRhs = tyConBuiltin "Int" None,
    tyAliasOrigin = OriginModule "core",
  }

aliasFixtureEnv : DataEnv
aliasFixtureEnv = buildDataEnv
  [
    declEnvModule 0 "core" [aliasFixturePubCore, aliasFixturePrivCore, aliasFixtureAttribCore],
    declEnvModule 1 "m" [aliasFixturePubM],
  ]

aliasNamesAt : Int -> List String
aliasNamesAt cur =
  map (e => tabKeyName (fst e)) (aliasUniverseAt cur aliasFixtureEnv.deAliases)

-- ── doctests ─────────────────────────────────────────────────────────────
-- The prelude reader (ordinal 0) sees NOTHING — not even its own public alias.
-- > aliasNamesAt 0
-- []

-- A reader at ordinal 1 sees the prelude's PUBLIC alias — and NOT its private
-- one, and NOT its ATTRIBUTED public one, which the live table never held in
-- either direction.
-- > aliasNamesAt 1
-- ["PubCore"]

-- A reader at ordinal 2 sees both public aliases, DESCENDING by ordinal — the
-- order the retired accumulator produced, which `lookupTab`'s first-match and
-- `emitCyclicAliasErrors`' render order both observe.
-- > aliasNamesAt 2
-- ["PubM", "PubCore"]

-- Fail-CLOSED at `declEnvsOrdOf`'s miss sentinel, exactly as `declEnvVisibleAt`.
-- > aliasNamesAt (0 - 1)
-- []

-- POPULATION NEUTRALITY of the attributed-alias drop: all FOUR aliases are in
-- `deAliases` — including the attributed one and the private one — and it is the
-- READ that narrows.  This is the assertion that fails if a later edit "tidies"
-- the guard back into the fold, re-creating the two-rows-one-record divergence
-- `dataEnvAddDecl`'s note exists to prevent.
-- > listLen aliasFixtureEnv.deAliases
-- 4

-- Fixture for the doctests below: two DIFFERENT modules ("m", "n") each
-- declaring a record named-field variant with field "x".
deFieldOwnerFixtureA : Decl
deFieldOwnerFixtureA = DData {
  dataVis = VisPublic,
  dataName = "Pt",
  dataParams = [],
  dataCtors = [Variant "Pt" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataDerives = [],
  dataOrigin = OriginModule "m",
}

deFieldOwnerFixtureB : Decl
deFieldOwnerFixtureB = DData {
  dataVis = VisPublic,
  dataName = "Vec",
  dataParams = [],
  dataCtors = [Variant "Vec" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataDerives = [],
  dataOrigin = OriginModule "n",
}

-- Same DECLARED NAME as fixture A ("Pt"), different module.  This is the case
-- the bare-name table (`universeFieldOwners`) genuinely cannot discriminate:
-- `addFieldOwners` is already a multimap, so it does NOT collapse fixture A/B
-- above (different ctor NAMES "Pt"/"Vec" — the bare table already shows two
-- rows for those).  What the bare table collapses is A vs C: both would
-- append the SAME bare string "Pt" to field "x"'s owner list, so a reader of
-- that list cannot tell "Pt" declared twice from one declaration counted
-- twice.  The identity table keeps them as two DISTINCT `Ident`s (different
-- `OriginModule`), which `distinctIdentsIn2` below asserts on directly.
deFieldOwnerFixtureC : Decl
deFieldOwnerFixtureC = DData {
  dataVis = VisPublic,
  dataName = "Pt",
  dataParams = [],
  dataCtors = [Variant "Pt" (ConNamed [Field "x" (tyConBuiltin "Int" None)] False)],
  dataDerives = [],
  dataOrigin = OriginModule "n",
}

deFieldOwnerCollisionEnv : DataEnv
deFieldOwnerCollisionEnv = buildDataEnv
  [declEnvModule 0 "m" [deFieldOwnerFixtureA, deFieldOwnerFixtureB]]

deFieldOwnerSingleEnv : DataEnv
deFieldOwnerSingleEnv =
  buildDataEnv [declEnvModule 0 "m" [deFieldOwnerFixtureA]]

deFieldOwnerSameNameEnv : DataEnv
deFieldOwnerSameNameEnv = buildDataEnv
  [declEnvModule 0 "m" [deFieldOwnerFixtureA, deFieldOwnerFixtureC]]

-- Two-element owner list, DISTINCT `Ident`s (never a fixed answer): the
-- property a bare-name multimap cannot state, since two `String`s "Pt"/"Pt"
-- carry no way to tell them apart.
distinctIdentsIn2 : List (Ident, String) -> Bool
distinctIdentsIn2 [(i1, _), (i2, _)] = i1 /= i2
distinctIdentsIn2 _ = False

-- ── doctests ─────────────────────────────────────────────────────────────
-- > map snd (fromOption [] (omLookup "x" deFieldOwnerCollisionEnv.deFieldOwnerIdents))
-- ["Pt", "Vec"]
-- > listLen (fromOption [] (omLookup "x" deFieldOwnerCollisionEnv.deFieldOwnerIdents))
-- 2
-- > map snd (fromOption [] (omLookup "x" deFieldOwnerSingleEnv.deFieldOwnerIdents))
-- ["Pt"]

-- The discriminating case: SAME declared name ("Pt") from two DIFFERENT
-- modules stays two DISTINCT identities, not one bare-name collision.
-- > map snd (fromOption [] (omLookup "x" deFieldOwnerSameNameEnv.deFieldOwnerIdents))
-- ["Pt", "Pt"]
-- > distinctIdentsIn2 (fromOption [] (omLookup "x" deFieldOwnerSameNameEnv.deFieldOwnerIdents))
-- True

-- 🚨 THE BLANK LINE ABOVE IS LOAD-BEARING — DO NOT CLOSE THE GAP.  A doctest's
-- EXPECTED OUTPUT runs to the end of the contiguous comment run, so without it
-- this banner is absorbed into A-3.2a's last doctest's expected value and that
-- doctest FAILS with `expected: True / actual: True` plus this text spliced in.
-- MEASURED when A-3.2a and A-3.4 first met in one tree: 13/14, and neither PR
-- could have seen it alone — no conflict marker, two adjacent comment blocks,
-- each correct in isolation.
-- ═══ #1112 A-3.4: THE `IE` REGISTRY — IE-BLOCK-BEGIN ════════════════════════════
-- 🚨 THE TWO BANNER LINES BOUNDING THIS BLOCK ARE READ BY A GATE.  Check 4
-- of `test/registry_keying_ratchet.sh` (which runs inside
-- `test/typecheck_compiler_source.sh`, inside the required `soundness` job)
-- extracts exactly the text between them and FAILS if the extraction is EMPTY —
-- so renaming or deleting either banner is loud, never a green that examined
-- nothing.  Do not reword them without editing that check.
--
-- WHAT THIS IS.  Stage K's `IE`: one registry answering "what impls exist",
-- replacing the three separate answers enumerated in
-- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` §9.6.  Built once, whole-graph,
-- inside `buildDeclEnvs`.  ⚠️ This said "every read filters through
-- `declEnvVisibleAt` (the ONE ordinal predicate, whose body A-3.6 deletes)".
-- Since A-3.6 (#1558) `IE`'s two reads went through TWO predicates, and under
-- RUN-055 (SA-3) they are back on ONE: both the candidacy read (`ieUniverseAt` →
-- `ieSnapAt`) and the decl-time existence read (`ieRowsVisibleAt`) go through
-- `ieCandidacyVisibleAt` and are GRAPH-GLOBAL — that is C4/I2 on the first and the
-- ruled agreement of diagnostic-with-engine on the second.  `declEnvVisibleAt` is
-- now the NAME axis alone and has no `IE` reader.  See all three headers.
--
-- 🚨 THE CONSTRAINT (§9.3), MECHANICALLY ENFORCED BY CHECK 4 ABOVE.  `IE` is
-- keyed by IMPL IDENTITY.  An interface's default-method arm is a property of the
-- INTERFACE declaration (`CE`, A-3a) and the emit-side method/default *word*
-- namespace belongs to B-2 (#1113).  NO `IE` KEY COMPONENT MAY BE A METHOD NAME:
-- a `(method, tag)`-keyed default registry here would rebuild #1265 in the new
-- substrate, since that pair is exactly the key #1265 is the first-match over.
-- A method name enters an `IE` row only as PAYLOAD (`ieMethods`).
--
-- 🚨 LIVE SINCE A-3.4 PR2 — `IE` IS NOW READ, AND IT DECIDES ACCEPTANCE.  This
-- block said "ZERO READERS TODAY, deliberately" through PR1; that is no longer
-- true and the distinction is worth a sentence, because "the registry exists" and
-- "the registry answers" are the two halves the arc's progress metric separates.
-- The Module arm's obligation universe — the table `checkCallObligationsU` asks
-- "does an impl exist for this goal", i.e. the table behind every `No impl of X
-- for Y` on the multi-module path — is a projection of `IE` at the reader's
-- ordinal, through the ONE accessor `ieUniverseAt`.  The three `obUniv*`
-- accumulators that used to answer it are RETIRED (deleted from `CrossRun`, not
-- left unread), which is this unit's `cross_allowed` shrink.
--
-- WHAT IS STILL NOT READ: `ieInst`/`InstRef` and `ieMethods`, both payload for
-- A-3.7 (coherence) and B-2.  The Flat path is untouched and still builds its own
-- `buildImplUniverse` over its whole program — that shim retires at E-4, not here.

-- The INSTANCE IDENTITY this tree does not otherwise have.  `cohClassify`'s ledger
-- records the gap verbatim — `bucketKeyEntriesFrom` restarts its numbering at 0 per
-- module, so two distinct impls in different modules share an index.  Minted in
-- exactly ONE place (`implRowsOf`, from the declaring module's id + ordinal + a
-- sequence number within the whole-graph build), so two impls can never share one.
-- READ BY NO JUDGMENT in this unit: it is A-3.7's (coherence) and B-2's (`InstId`)
-- declared input, and it is a deliverable, not a behaviour change.
-- 🚨 POSITIONAL, NOT A NAMED RECORD, AND THE REASON IS A MEASURED EMITTER TRAP —
-- see `ImplRow` below, which carries the full derivation.  Fields, in order:
-- the declaring module's loader id (the SCOPE), its ordinal, and the sequence
-- number within the whole-graph build.
--
-- 🚨 UNIQUE WITHIN ONE COMPILE — AND **NOT STABLE ACROSS COMPILES**.  State both
-- halves or the next author will read the first as the second, because this thing
-- is advertised as "the instance identity this tree does not otherwise have" and
-- is named as B-2's `InstId` input.
--   * `seq` is a WHOLE-GRAPH running counter, so adding one `impl` to ANY earlier
--     module renumbers every later impl in the program.
--   * `ord` is the loader's dependency-first position, so reordering imports moves
--     both components.
-- Uniqueness within a compile is all that is claimed, and it is all A-3.7's
-- coherence needs (it compares two rows of ONE graph).  ⚠️ B-2 is a different
-- matter: it owns the emit-side WORD namespace, where an ordinal-derived serial is
-- a poor name source — a symbol named from `seq` changes when an unrelated earlier
-- module gains an impl, which is a reproducible-build and incremental-rebuild
-- hazard, not a correctness one.  If B-2 wants a NAME, derive it from
-- `(module id, interface identity, head)` — content, not position — and use
-- `InstRef` only as the within-compile discriminator it is.
data InstRef = InstRef String Int Int

instRefMid : InstRef -> String
instRefMid (InstRef m _ _) = m

instRefSeq : InstRef -> Int
instRefSeq (InstRef _ _ s) = s

-- One impl, with what §2 K specifies — full head, context, method table — plus its
-- identity and the scope its visibility is filtered on.
--
-- ⚠️ NO `ieLoc` FIELD, and that is a DEPARTURE from the §9.4 data shape with a
-- derived reason rather than an omission: `Decl` carries no source location at all
-- (`compiler/frontend/ast.mdk` has no `declLoc`/`dLoc`; `DImpl`'s six labels are
-- `pub`/`iface`/`tys`/`reqs`/`methods`/`implOrigin`), so an `ieLoc : Option Loc`
-- here could only ever be `None`.  A field that is structurally always-`None` is
-- worse than an absent one — it reads as available to A-3.7 and is not.  Whoever
-- needs it must first give `DImpl` a location (or derive one from a method body's
-- `Expr`), which is its own unit.
-- 🚨 POSITIONAL, NOT A NAMED RECORD — AND THIS IS A MEASURED EMITTER CONSTRAINT,
-- NOT A STYLE CHOICE.  §9.4 spells the row with named fields; this is the one place
-- that spelling cannot be honoured, so the reason is written here rather than left
-- for the next reader to rediscover.
--
-- The LLVM emitter resolves a record field label to a positional index from a table
-- it builds by SCANNING THE LOWERED PROGRAM FOR CONSTRUCTION SITES —
-- `scanExprRecords` collects `(name, labels)` from `CRecord` nodes only, never from
-- the `DData` declaration (`compiler/backend/llvm_emit.mdk:10178-10193`,
-- `findFieldIdx`/`findRecordByLabel` at `:10148-10163`).  So a record whose
-- CONSTRUCTION is dead-code-eliminated from an entry's closure while a FIELD ACCESS
-- on it survives panics: `llvm: CFieldAccess: unknown field '<label>'`.
--
-- MEASURED on this branch, with the named-record spelling:
--   ./medaka build compiler/entries/wasm_emit_typed_main.mdk   -> exit 1,
--   runtime error [E-PANIC]: llvm: CFieldAccess: unknown field 'ieOrd'
-- reproduced in CI on the `wasm` job, which cascaded `gates (backend)` into a
-- phantom-skipped `diff_compiler_tmc_parity`.  That entry reaches `elaborateDict`
-- (the FLAT path) and therefore `checkBodyImpl` — which contains the `IE` accessor
-- (`ieShadowCompare` at the time this was measured, `ieUniverseAt` since A-3.4 PR2;
-- either way `checkBodyImpl` mentions `ImplRow`'s fields and the entry's closure
-- therefore contains the field ACCESS) — but it never reaches `buildDeclEnvs`, hence never
-- `implRowsOf`, the only `ImplRow` construction site.  A positional constructor is
-- destructured by pattern match and consults no label table, so it cannot hit this.
--
-- ⚠️ `ImplEnv` below KEEPS its named fields, and that is not an inconsistency: its
-- construction site `emptyImplEnv` is reachable from `emptyDeclEnvs` ←
-- `freshDriverState`, which every driver builds — which is exactly why the panic
-- named `ieOrd` and not `ieRows`.  A later editor who makes `emptyImplEnv`
-- unreachable re-arms the same trap on `ImplEnv`.
--
-- Fields, in order: the declaring module's ordinal (A-3.1's `demOrd` — the scope);
-- the instance identity; the interface identity; the full head; the context; and
-- the method table, which is PAYLOAD ONLY (§9.3) and never a key component.
--
-- ⚠️ NO `Loc`, and that is a second DEPARTURE from the §9.4 data shape with a
-- derived reason rather than an omission: `Decl` carries no source location at all
-- (`compiler/frontend/ast.mdk` has no `declLoc`/`dLoc`; `DImpl`'s six labels are
-- `pub`/`iface`/`tys`/`reqs`/`methods`/`implOrigin`), so an `Option Loc` here could
-- only ever be `None`.  A field that is structurally always-`None` is worse than an
-- absent one — it reads as available to A-3.7 and is not.  Whoever needs it must
-- first give `DImpl` a location (or derive one from a method body's `Expr`), which
-- is its own unit.
data ImplRow =
  | ImplRow Int InstRef IfaceRef (List Ty) (List Require) (List String)

ieRowOrd : ImplRow -> Int
ieRowOrd (ImplRow o _ _ _ _ _) = o

ieRowInst : ImplRow -> InstRef
ieRowInst (ImplRow _ i _ _ _ _) = i

ieRowTriple : ImplRow -> (IfaceRef, List Ty, List Require)
ieRowTriple (ImplRow _ _ ir tys reqs _) = (ir, tys, reqs)

-- The registry.  `ieRows` is the POPULATION in build order (ordinal order across
-- modules, `implDeclsWithReqs` order within one); the rest are INDEXES over it.
-- `ieConcrete`/`ieHeadless`/`ieIfaceTags` are the obligation channel's own three,
-- with the SAME keys, minted through the SAME `oblIfaceKeys`/`dispHeadTab` calls
-- (see `ieInsertRow`), so `IE` mints no parallel keying scheme; `ieByHead` is
-- `KeyBuckets`' partition, minted through the SAME `headBucketKey` (see
-- `ieFileRowByHead`).  Derive the set rather than trusting a count here — this
-- sentence said "the three buckets" while there were four, which is how
-- `stampKeyTable`'s "five stampers" comment came to be wrong about seven.
data ImplEnv = ImplEnv {
    ieRows : List ImplRow,  -- whole-graph, build order; the snapshot fold reads this
    ieConcrete : MultiRegistry ImplRow,
    ieHeadless : MultiRegistry ImplRow,
    ieByHead : MultiRegistry ImplRow,
    ieIfaceTags : Registry SetRegistry,
    -- 🚨 A-3.4 PR2, AND IT IS A PERFORMANCE INVARIANT, NOT A CACHE.  One entry per
    -- distinct module ordinal, in ordinal order: `(o, universe of every row with
    -- ordinal <= o)`.  `ieUniverseAt` SELECTS from this; it does not rebuild.
    --
    -- WHY IT EXISTS — MEASURED, and it is the tree's signature mistake caught in its
    -- own gate.  The first cut of this unit had `ieUniverseAt` fold the whole visible
    -- prefix on EVERY read, i.e. once per module: O(modules x impls) where the
    -- accumulator it replaced was O(impls) TOTAL.  That is exactly the
    -- "rescan the accumulated universe once per module" quadratic #154 PR-C removed
    -- and `diff_compiler_perf_scaling.sh` promoted the `modules` shape OUT of its
    -- ledger for — and it put it straight back: net alloc 730 MB -> 2191 MB -> 7345 MB,
    -- r1=3.00 r2=3.35, ** SUPERLINEAR (ALLOC) ** against a 3.0 ceiling and a
    -- documented FLAT ~2.0 expectation.
    --
    -- The fix costs nothing because the registries are PERSISTENT: a snapshot retains
    -- structure that is already shared, so this is M pointers, not M copies.  Built by
    -- ONE left fold over `ieRows` (already in ordinal order), so the whole table is
    -- O(impls) to construct and a read is a walk of visible ordinals with no
    -- allocation at all.
    --
    -- ⚠️ The values are IDENTICAL to the per-read rebuild, by construction rather than
    -- by assertion: `ieRows` is in ordinal order, so "every row with ordinal <= cur" is
    -- a PREFIX of `ieRows`, and inserting a prefix in order through the same
    -- `growImplUniverse` writer is the same value the filtered rebuild produced.
    ieUnivSnaps : List (Int, ImplUniverse),
  }

emptyImplEnv : ImplEnv
emptyImplEnv = ImplEnv {
  ieRows = [],
  ieConcrete = mregEmpty,
  ieHeadless = mregEmpty,
  ieByHead = mregEmpty,
  ieIfaceTags = regEmpty,
  ieUnivSnaps = [],
}

-- Fold the envelope's modules, in ordinal order, into one whole-graph registry.
-- The sequence number runs across the WHOLE build (not per module), which is what
-- makes `InstRef` unique without relying on `(mid, ord)` being injective.
buildImplEnv : List DeclEnvModule -> ImplEnv
buildImplEnv mods =
  let env = buildImplEnvGo mods 0 emptyImplEnv
  ImplEnv { env | ieUnivSnaps = ieBuildSnaps env.ieRows }

buildImplEnvGo : List DeclEnvModule -> Int -> ImplEnv -> ImplEnv
buildImplEnvGo [] _ env = env
buildImplEnvGo (m::rest) seq env =
  let rows = implRowsOf m.demId m.demOrd seq (implDeclFacts m.demDecls)
  buildImplEnvGo rest (seq + listLen rows) (ieAddRows rows env)

-- ── ARCH B-2.1-a2 (Stage B sprint): the FLAT arm's `ImplEnv` ─────────────────
--
-- `buildImplEnv` above needs an ENVELOPE (`List DeclEnvModule`), which only the
-- graph drivers build (`buildDeclEnvs` ← `checkModulesPreamble` / `elaborateModules`).
-- The FLAT path — `checkProgramSeededSplit` → `checkBodyImpl (Flat coreProg)`, reached
-- by `medaka check <no-import file>`, `lsp`, `repl`, `doc`, `lint`'s policy pass,
-- `snapshot`, and the `llvm_emit_typed_main` / `wasm_emit_typed_main` entries via
-- `elaborateDict` — never calls it, so `declEnvsRef.deImpls` is `emptyImplEnv` there.
-- That emptiness is the hazard DECISIONS.md RUN-B-017 probe 3 MEASURED: FLAT is
-- already whole-program and already CORRECT on #1564's shape (it accepts and prints
-- `wrap(int)` where the four-module program rejects), so a later bite that repoints
-- the evidence reader onto an EMPTY Flat `IE` is a correct→broken regression on the
-- busiest verbs in the CLI.  This function removes that emptiness FIRST, additively.
-- ⚠️ This sentence used to end "nothing reads `bodyImplEnvRef` yet", which is FALSE from
-- B-2.1-b2 on: three SELECTION legs read it (`concreteReqMatchByIface`,
-- `selectReqImpl`/`keyForSiteByIface`, `implDictRoutesForFull`/`argImplDictRoutesForEncl`),
-- and B-2.1-g added the METHOD-keyed route word (`keyForSite`) plus all three shadow
-- existence reads (`ieImplExistsForHead`).  Derive the set, do not trust a list:
-- `grep -n bodyImplEnvRef compiler/types/typecheck.mdk`.
--
-- One flat program is ONE scope, so every row takes ordinal 0 and mid `""` — there
-- is no loader module id on this path (the prelude prefix carries `core` *origins*
-- on its decls, but no module id), and `""` is the same spelling `declEnvOrdIndex`
-- already seeds ordinal 0 with.  `InstRef`'s `seq` still runs across the whole
-- program, so identities stay unique within the compile, exactly as on Module.
-- ⚠️ Consequence, stated rather than left to be found: `instRefMid` cannot
-- distinguish a prelude impl from a user impl on FLAT.  B-2's route naming must not
-- key on `mid` for that reason — which is what the `InstRef` header already says
-- ("derive a NAME from (module id, interface identity, head) — content, not
-- position"), one path further.
--
-- 🚨 LINEAR BY DESIGN, AND THAT IS WHY IT DOES NOT CALL `ieAddRows`.  `ieInsertRow`
-- does `env.ieRows ++ [r]` per row — O(rows²) over the build, self-documented as
-- OWED at `ieInsertRow` — and `compiler/AGENTS.md` forbids importing a known
-- quadratic into a new path ("thirteen quadratics, all the same shape").  The rows
-- are already in hand as one forward-ordered list here, so `ieRows` is SET once and
-- only the three index buckets are folded, through the SAME `ieInsertRowKeys` /
-- `ieInsertRowAt` the Module arm uses.  `ieInsertRow` is left exactly as it is: it
-- is the Module arm's shared path, and RUN-B-007's declaration-index ruling depends
-- on `ieRows` and every bucket being ASCENDING by `instRefSeq`, so a cons+reverse
-- rewrite of that function would put a load-bearing order on the line for no gain
-- here.  This construction yields the same value `ieAddRows rows emptyImplEnv`
-- would: appending left-to-right produces `rows`, and the bucket writer is
-- unchanged and still `mregAppendK` (forward order within a bucket).
--
-- ⚠️ `ieUnivSnaps` IS RE-DERIVED, per `ieAddRows`'s 🚨: it is a second
-- representation of `ieRows` maintained in exactly one place, and `ieUniverseAt`
-- reads the SNAPSHOT.  All rows share ordinal 0, so `ieBuildSnaps` emits exactly one
-- entry and `ieUniverseAt` returns the whole flat program's universe for any
-- argument — which is the correct answer on a path that has no import graph to scope.
buildFlatImplEnv : List Decl -> ImplEnv
buildFlatImplEnv prog =
  let rows = implRowsOf "" 0 0 (implDeclFacts prog)
  let indexed = ieIndexRows rows emptyImplEnv
  ImplEnv { indexed | ieRows = rows, ieUnivSnaps = ieBuildSnaps rows }

-- The index-only half of `ieInsertRow`: same keys, same writer, no `ieRows` append.
-- ARCH B-2.1-a3: both halves now go through the ONE once-per-row seam `ieFileRow`,
-- so an index added on either arm reaches both.  See its header — this pair is the
-- two-parallel-drivers shape, and the seam is what keeps them from drifting.
ieIndexRows : List ImplRow -> ImplEnv -> ImplEnv
ieIndexRows [] env = env
ieIndexRows (r::rest) env = ieIndexRows rest (ieFileRow r env)

-- The per-ordinal prefix universes, in ONE left fold over the ordinal-ordered rows.
-- See `ieUnivSnaps` for why this is a performance invariant rather than a cache.
-- Emits one entry per DISTINCT ordinal (a module declaring no impl contributes no
-- entry, which is why `ieSnapAt` selects the LAST visible entry rather than indexing).
ieBuildSnaps : List ImplRow -> List (Int, ImplUniverse)
ieBuildSnaps rows = ieBuildSnapsGo rows emptyImplUniverse

ieBuildSnapsGo : List ImplRow -> ImplUniverse -> List (Int, ImplUniverse)
ieBuildSnapsGo [] _ = []
ieBuildSnapsGo (r::rest) univ =
  ieBuildSnapsEmit r rest (insertUnivImpl univ (ieRowTriple r))

-- Emit a snapshot only when the NEXT row starts a new ordinal (or there is none), so
-- one module's several impls fold into a single entry.
ieBuildSnapsEmit : ImplRow -> List ImplRow -> ImplUniverse -> List (Int, ImplUniverse)
ieBuildSnapsEmit r [] univ = [(ieRowOrd r, univ)]
ieBuildSnapsEmit r (r2::rest2) univ
  | ieRowOrd r2 == ieRowOrd r = ieBuildSnapsGo (r2::rest2) univ
  | otherwise = (ieRowOrd r, univ) :: ieBuildSnapsGo (r2::rest2) univ

-- ⚠️ LOCKSTEP WITH `implDeclsWithReqs` / `implDeclWithReqs`: same `DAttrib` unwrap,
-- same single-`DImpl` arm, same order.  The two are kept separate rather than one
-- being defined via the other because `implDeclsWithReqs` runs per module on the
-- hot Module path and `check` is GC-bound — deriving it from this 4-tuple form
-- would allocate a method-name list per impl on every compile.  The agreement is
-- not left to the comment: A-3.4 PR1's `ieShadowCompare` measured it per module
-- slice, and PR2 measured it again at the whole-prefix level over the compiler's
-- own graph and 193 multi-module fixture projects before flipping the reader.  Both
-- instruments are now deleted, so the standing defence is the flip itself: a
-- divergence between these two walks is no longer a silent second table, it is the
-- obligation universe being wrong, which the differential gates grade directly.
--
-- ⚠️ OWED, and it is an inconsistency in the paragraph above rather than a
-- separate point: the reason given for keeping the two functions apart is "do not
-- allocate a method-name list per impl on every compile" — and this function then
-- allocates exactly that list, per impl, per compile, into `ieMethods`, which
-- **nothing reads today**.  It is there because §2 K specifies the method table as
-- `IE` content and A-3.5's impl-completeness relocation is its named consumer.  If
-- A-3.5 slips, drop the field rather than carrying a per-compile allocation for a
-- reader that never arrives.
implDeclFacts : List Decl -> List (IfaceRef, List Ty, List Require, List String)
implDeclFacts prog = flatMap implDeclFact prog

implDeclFact : Decl -> List (IfaceRef, List Ty, List Require, List String)
implDeclFact (DAttrib _ d) = implDeclFact d
implDeclFact (DImpl { iface, tys, reqs, methods, implOrigin, ... }) = [
  (
    IfaceRef { irName = iface, irOrigin = implOrigin },
    tys,
    reqs,
    map implMethodNameTc methods,
  )
]
implDeclFact _ = []

implRowsOf : String -> Int -> Int -> List (IfaceRef, List Ty, List Require, List String) -> List ImplRow
implRowsOf _ _ _ [] = []
implRowsOf mid ord seq ((iface, tys, reqs, ms)::rest) =
  ImplRow ord (InstRef mid ord seq) iface tys reqs ms ::
    implRowsOf mid ord (seq + 1) rest

-- 🚨 UPDATES `ieRows` AND THE THREE INDEX BUCKETS. DOES **NOT** UPDATE `ieUnivSnaps`.
-- Read that as the design-law hazard it is, not as a note.
--
-- `ieUnivSnaps` is a SECOND REPRESENTATION of `ieRows` — the per-ordinal prefix
-- universes `ieUniverseAt` selects from — and it is maintained in exactly ONE place,
-- `buildImplEnv`, AFTER this fold has finished. Inserting into an already-built
-- `ImplEnv` therefore leaves a snapshot table that silently disagrees with the rows,
-- and because `ieUniverseAt` reads the SNAPSHOT, the consequence is a wrong
-- obligation universe with no diagnostic: an impl that exists is invisible to
-- dispatch, or a retired one still answers. That is a silent-wrongness shape.
--
-- ⚠️ It is INERT TODAY only because there is exactly one construction site
-- (`buildImplEnv`, called once per driver from `buildDeclEnvs`) — derive that before
-- trusting it: `grep -n 'ieAddRows\|ieInsertRow' compiler/types/typecheck.mdk`.
--
-- 🚨 AND IT IS THIS UNIT'S OWN DESIGN LAW, ONE FIELD OVER. A-3.4 PR2 deleted three
-- `CrossRun` fields precisely to stop two structures answering "what impls exist"
-- (law L1), and this pair is that same shape at a smaller scale. It is accepted here
-- because the alternative — folding a snapshot per insert — is the O(modules x impls)
-- quadratic this unit was reddened by `diff_compiler_perf_scaling.sh` for and fixed.
-- So: if you need to insert into a built `ImplEnv`, RE-DERIVE the snapshots
-- (`ieUnivSnaps = ieBuildSnaps env.ieRows`) once at the end of your fold, exactly as
-- `buildImplEnv` does. Do not add a second maintainer, and do not insert without one.
ieAddRows : List ImplRow -> ImplEnv -> ImplEnv
ieAddRows [] env = env
ieAddRows (r::rest) env = ieAddRows rest (ieInsertRow r env)

-- The index insert, mirroring `insertUnivImplAt` arm-for-arm: the identity key plus
-- the bare compatibility leg (`oblIfaceKeys`), concrete head → the `[ifk, hd]`
-- bucket + the tag set, headless → the iface's headless bucket.  `mregAppendK`, not
-- `mregAddK`: within one bucket the FORWARD declaration order is semantic.
--
-- 🚨 ONCE PER `oblIfaceKeys` ELEMENT, i.e. TWICE PER ROW for every origin-bearing
-- interface.  ONLY interface-keyed indexes belong here; anything else DOUBLE-FILES.
-- The once-per-row seam is `ieFileRow` — read its header before adding a bucket.
--
-- ⚠️ OWED, RECORDED RATHER THAN FIXED UNDER REVIEW: `env.ieRows ++ [r]` is an
-- append PER ROW, i.e. O(rows²) over the build.  It is small today — a tree-wide
-- `impl` count in the low hundreds — but it is precisely the shape
-- `compiler/AGENTS.md` forbids ("thirteen quadratics, all the same shape"), and
-- §9.8 item 8's timing A/B is still OWED, so nothing has actually measured its
-- cost.  The fix is one line: cons and `reverseL` once in `buildImplEnv`, which
-- preserves build order.  Deliberately not done in a review round that is
-- otherwise comment-only, so that the byte-identical claim keeps its evidence.
-- 🚨 DOES NOT MAINTAIN `ieUnivSnaps` — the table `ieUniverseAt` actually reads.  Only
-- `buildImplEnv` derives that, after all inserts are done.  Full hazard, and what to do
-- if you need to insert into a built `ImplEnv`, at `ieAddRows` above.
ieInsertRow : ImplRow -> ImplEnv -> ImplEnv
ieInsertRow r env = ieFileRow r { env | ieRows = env.ieRows ++ [r] }

-- ── ARCH B-2.1-a3 (Stage B sprint): THE ONE ONCE-PER-ROW FILING SEAM ──────────
-- 🚨 EVERY PER-ROW INDEX GOES HERE, AND THE REASON IS A CORRECTNESS CONSTRAINT,
-- NOT TIDINESS.  `ieInsertRowAt` below is entered ONCE PER `oblIfaceKeys`
-- ELEMENT — i.e. TWICE for every row whose interface carries an origin, which is
-- every row but an `OriginUnresolved` one (`oblIfaceKeys`: identity key + bare
-- compatibility leg).  An index keyed by anything OTHER than the interface, filed
-- there, DOUBLE-FILES: the bucket inflates, and every count, `min⊑` and
-- declaration-order merge taken over it is silently wrong.  That is why
-- `ieByHead` — keyed by HEAD, ACROSS interfaces — is filed here and not there.
-- The doctests at `ieHeadProbeEnv` assert exactly-once and are fail-capable in
-- that direction (a filing moved into `ieInsertRowAt` doubles their expected
-- lists).
--
-- 🚨 AND IT EXISTS BECAUSE THERE ARE **TWO** ONCE-PER-ROW PATHS.  `ieInsertRow`
-- (Module, via `ieAddRows`) and `ieIndexRows` (Flat, B-2.1-a2's index-only half)
-- both spelled `ieInsertRowKeys (oblIfaceKeys ir) r` independently, so a new index
-- added to one was silently absent from the other — the `evalModules` /
-- `cevalModules` divergence shape `AGENTS.md` records ("a fix landed in one
-- parallel driver and left the other broken for months").  With this seam the two
-- arms cannot drift: the ONLY per-row difference left between them is the
-- `ieRows` append, which is exactly the difference that is supposed to be there.
ieFileRow : ImplRow -> ImplEnv -> ImplEnv
ieFileRow (r@(ImplRow _ _ ir _ _ _)) env =
  ieInsertRowKeys (oblIfaceKeys ir) r (ieFileRowByHead r env)

-- The HEAD-keyed, interface-BLIND index: every row filed under its receiver head's
-- bucket, or the headless bucket for a fully-general `impl C a`.  This is
-- `KeyBuckets`' OWN partition (`bucketKeyEntriesFrom` → `headBucketRender`) over
-- `IE`'s rows, and the key is minted by the SAME `headBucketKey` both tables now
-- share, so the two cannot drift in keying — only in population, which is the
-- whole point: `KeyBuckets` reaches its reader as a TOPOLOGICAL PREFIX
-- (`universeKeyBucketsRef` / `stampKeyTable`), while this is GRAPH-GLOBAL.
--
-- 🚨 WHY AN INDEX AT ALL, MEASURED: the method-keyed selection leg (then
-- `matchedEntry` → `matchingEntries` → `candidateBucket`, all three deleted by
-- B-2.1-d) is *the checker's
-- hottest selector*, and answering it graph-globally by SCANNING `ieRows` cost
-- `check-self` 21.5 s -> 25.1 s (+17%) — an O(rows) scan per goal, the exact
-- `List`-as-a-map shape `compiler/AGENTS.md` forbids (DECISIONS.md RUN-B-023,
-- which is why this bite exists and precedes the repoint).
--
-- ⚠️ ASCENDING BY `instRefSeq`, BY CONSTRUCTION, AND THAT IS LOAD-BEARING.  Both
-- filing paths fold rows in forward order (`buildImplEnvGo` threads one whole-graph
-- `seq` across modules in ordinal order; `buildFlatImplEnv` folds one forward list),
-- and `mregAppendK` APPENDS — so every bucket is in graph-global forward
-- declaration order.  That is `mergeByDeclIdx`'s documented ascending precondition,
-- which `universeKeyBucketsRef` VIOLATED (`bucketKeyEntriesFrom` restarts at 0 per
-- module, so its indices duplicated and each module's slice was prepended) until ARCH
-- B-2.1-d deleted it, and it is
-- the property RUN-B-007's declaration-index ruling rests on.  A prepend +
-- reverse-at-finalize would file in O(1) instead of `mregAppendK`'s O(bucket), and
-- it is deliberately NOT taken: it makes the ascending invariant true only AFTER a
-- finalize step, which is precisely the second-maintainer hazard `ieAddRows`'s
-- header forbids for `ieUnivSnaps` ("do not add a second maintainer, and do not
-- insert without one").  The cost is per-BUCKET, not per-population — this is not
-- `ieRows`' `++ [r]` — and it is measured, not asserted: see DEBT.md B-2.1-a3.
ieFileRowByHead : ImplRow -> ImplEnv -> ImplEnv
ieFileRowByHead (r@(ImplRow _ _ _ tys _ _)) env = ImplEnv { env | ieByHead = mregAppendK (headBucketKey (univReceiverTag tys)) r env.ieByHead }

-- 🚨 THE `IE` HEAD-BUCKET READ ACCESSOR — the successor of `bucketOfHead`, the
-- `KeyBuckets` lookup B-2.1-d deleted.  Goal side and impl side project through the SAME `headBucketKey`,
-- so a lookup cannot silently miss the bucket its rows were filed under (which is
-- what `dispHeadTab`'s derivation is about).  Returns the rows ASCENDING by
-- `instRefSeq` — see `ieFileRowByHead`; a consumer feeding `mergeByDeclIdx` depends
-- on that and must not re-order them.
--
-- ⚠️ NO PRODUCTION CALLER YET, deliberately: `B-2.1-a3` is additive and
-- behaviour-neutral, and `B-2.1-b2` is the repoint that consumes it.  It is bound
-- here rather than left for that bite to open-code, for the reason `ieUniverseAt`
-- gives: one read site is one place to re-scope.
ieHeadRows : Option HeadKey -> ImplEnv -> List ImplRow
ieHeadRows hd env = mregLookupK (headBucketKey hd) env.ieByHead

ieInsertRowKeys : List TabKey -> ImplRow -> ImplEnv -> ImplEnv
ieInsertRowKeys [] _ env = env
ieInsertRowKeys (ifk::rest) r env =
  ieInsertRowKeys rest r (ieInsertRowAt ifk r env)

ieInsertRowAt : TabKey -> ImplRow -> ImplEnv -> ImplEnv
ieInsertRowAt ifk (r@(ImplRow _ _ _ tys _ _)) env = match univReceiverTag tys
  Some hk =>
    let ifkey = regKeyOfTab ifk
    let hd = dispHeadTab hk
    -- ⚠️ `ieIfaceTags` is the ACCEPTANCE census (`ieUniverseAt` hands it to
    -- `implCountForIfaceU`), so it is guarded — `univHeadCountsInCensus`.  This
    -- writer and `insertUnivImplAt` must move in LOCKSTEP.
    ImplEnv { env | ieConcrete = mregAppendK (regKeyNTab [ifk, hd]) r env.ieConcrete, ieIfaceTags = univAddIfaceTag (univHeadCountsInCensus tys) ifkey hd env.ieIfaceTags }
  None => ImplEnv { env | ieHeadless = mregAppendK (regKeyOfTab ifk) r env.ieHeadless }

-- 🚨 THE `IE` *UNIVERSE* READ ACCESSOR.  Every consumer that wants an
-- `ImplUniverse` goes through here.  Open-coding `<=` at a read site is the one
-- thing this unit must not do.
--
-- ⚠️ THIS IS NO LONGER THE ONLY `IE` READ, and it is no longer ordinal-filtered.
-- There are TWO `IE` reads and they answer different questions — this one (via
-- `ieSnapAt`) selects a candidacy UNIVERSE; `ieRowsVisibleAt` below selects rows for
-- a decl-time existence check.  They shared a predicate before A-3.6 (#1558), which
-- SPLIT it by owner ruling and moved this one alone to `ieCandidacyVisibleAt`; under
-- RUN-055 (SA-3) the existence read followed, so the two share a predicate again —
-- `ieCandidacyVisibleAt`, the WIDE one.  They are still two functions answering two
-- questions over two shapes (`ImplUniverse` vs `ImplRow`), and re-scoping either one
-- is still a one-line, one-name change.  "One body to delete" was never the
-- invariant that mattered; "no read site open-codes `<=`" is, and it still holds.  DERIVE the current set rather than trusting this
-- sentence: `grep -n 'declEnvVisibleAt\|ieCandidacyVisibleAt' compiler/types/typecheck.mdk`
-- and separate code from commentary; the ratchet's `declEnvsRef` row has been measured
-- wrong on this count in both directions (RUN-007/RUN-013).
--
-- The snapshots this SELECTS from are built by `insertUnivImpl` — the SAME writer
-- `growImplUniverse` (and so the retired accumulator) uses — so the two cannot drift
-- in key minting, and the equality reduces to population and order (§9.5's algebra +
-- `DL`) — which A-3.4 PR1's `ieShadowCompare` measured per module slice, and which
-- PR2 re-measured at the whole-prefix level, at the read site, before flipping onto
-- this function.
--
-- 🚨 IT SELECTS, IT DOES NOT REBUILD, AND THAT IS A MEASURED REQUIREMENT.  The first
-- cut folded the visible prefix on every read — once per module — and put back the
-- exact O(modules x impls) quadratic #154 PR-C removed, reddening
-- `diff_compiler_perf_scaling.sh`'s `modules` shape at r2=3.35 against a documented
-- FLAT ~2.0.  See `ieUnivSnaps`.  A future reader "simplifying" this back into a fold
-- over `ieRows` re-introduces that; the gate will catch it, but the comment is cheaper.
--
-- 🚨 THE PRODUCTION CALLERS (A-3.4 PR2) ARE `checkBodyImpl`'s Module arm — the
-- end-of-body obligation universe and #1549's `residualUnivRef`, which share ONE
-- binding (`moduleImplUniv`). Everything an obligation check on the multi-module path
-- knows about which impls exist comes through here. Add a caller only if it genuinely
-- needs the same ordinal-filtered answer — and never open-code the filter to get it.
ieUniverseAt : Int -> ImplEnv -> ImplUniverse
ieUniverseAt cur env = ieSnapAt cur env.ieUnivSnaps emptyImplUniverse

-- Walk the ordinal-ordered snapshots and keep the LAST admitted one.  This is THE
-- instance-candidacy read, and since A-3.6 (#1558) it goes through
-- `ieCandidacyVisibleAt` — not `declEnvVisibleAt`, which kept its ordinal body for
-- the name axis when the predicate split (see both headers).  The predicate is `True`,
-- so this selects the FINAL snapshot — the whole graph — which is C4/I2's global
-- instance environment reached without changing the shape of the walk.
--
-- ⚠️ IT IS STILL A WALK, AND THAT IS NOT AN OVERSIGHT.  A constant predicate makes
-- `last` the obvious "simplification", and the two are equal only while
-- `ieUnivSnaps` is ordinal-ordered and non-empty-tailed.  The walk keeps this
-- function's shape identical to its pre-flip self, so the flip's diff is one
-- predicate name and the acceptance delta is attributable to that alone; and it
-- leaves one line to change if candidacy is ever scoped again.  Allocates nothing.
ieSnapAt : Int -> List (Int, ImplUniverse) -> ImplUniverse -> ImplUniverse
ieSnapAt _ [] acc = acc
ieSnapAt cur ((o, u)::rest) acc
  | ieCandidacyVisibleAt cur o = ieSnapAt cur rest u
  | otherwise = acc

-- #1557 A-3.5b: the ROW-SET read for the decl-time EXISTENCE check — built as the
-- peer of `CE`'s `ceRowsVisibleAt` on the NAME/declaration axis.
-- ⚠️ IT IS NO LONGER ON THAT AXIS.  Two retractions, in order, because the second
-- only makes sense against the first: A-3.5b's original claim that this read is
-- "routed through the SAME ONE predicate so A-3.6 still has a single body to
-- delete" died when A-3.6 (#1558) SPLIT the predicate instead of deleting it; the
-- successor claim — that this read "stayed on `declEnvVisibleAt`", because a
-- decl-time EXISTENCE query is not I5's subject — is retired by ⚖️ OWNER RULING
-- (Val, 2026-08-12, sprint `DECISIONS.md` RUN-055, finding SA-3).  The two-scope
-- arrangement was measured to make the diagnostic contradict the engine inside ONE
-- program (an `impl Sup T` in a topologically LATER module dispatches while this
-- check calls it missing), so this read now takes `ieCandidacyVisibleAt` — the same
-- graph-global predicate `ieSnapAt` takes.  Both `IE` reads are back on ONE
-- predicate, but by widening this one, not by narrowing that one.
-- ⚠️ THE NAME STAYS `…VisibleAt`, AND THE PARAMETER STAYS.  Same reason
-- `ieCandidacyVisibleAt` keeps its two unused arguments: the flip's whole diff is
-- one predicate name, so the acceptance delta is attributable to that alone, and
-- one line changes back if super-existence is ever re-scoped.  `cur` is still LIVE
-- in this check's other half — `superImplMsgsOf` resolves the interface and its
-- supers through `ceLookupAt … cur`, which is name-scoped and did NOT move.
-- ⚠️ WHAT DID NOT MOVE EITHER, and must not: this returns `ImplRow`s, not an
-- `ImplUniverse`.  `ieUniverseAt` above answers "what does the obligation channel
-- know about impls here"; this answers "which impl DECLARATIONS exist", and its
-- consumer matches AST `Ty`s with `tyMatchesAst` where an `ImplUniverse` holds
-- `Mono`s matched by `matchStep`.  Routing this through `ieUniverseAt` to reach the
-- same scope would swap the MATCHER as well as the table — a second, unbudgeted
-- acceptance delta riding on the ruled one.  Widen the PREDICATE, never the table.
-- ⚠️ AND IT READS `ieRows`, NEVER THE BUCKETS — see `ieRowsAll` for why the bucket
-- walk rebuilds #1438 in this substrate.
--
-- 🚨 PERF: THIS IS O(rows) PER CALL AND ITS CALLER RUNS PER (impl x super).  Bind it
-- ONCE per whole-module check and thread the list; calling it inside `superMsgFor`
-- would be O(user impls x supers x all impls) — the same class as A-3.4 PR2's first
-- cut, which `diff_compiler_perf_scaling.sh` caught at r2=3.35 on the `modules` shape
-- (see `ieUnivSnaps`).  `checkSuperImpls` is the one binding site; keep it that way.
ieRowsVisibleAt : Int -> ImplEnv -> List ImplRow
ieRowsVisibleAt cur env =
  filterList (r => ieCandidacyVisibleAt cur (ieRowOrd r)) env.ieRows

-- #1559 A-3.7: the POPULATION reads coherence takes — the whole graph, and one
-- module's OWN rows.  Peers of `CE`'s `ceRowsVisibleAt`/`ceRowsOwnedBy`, and they read
-- `ieRows` for the same reason the snapshot fold does.
--
-- 🚨 READ `ieRows`.  NEVER THE BUCKETS.  `ieConcrete`/`ieHeadless` already group rows
-- by (interface, head), so "iterate the buckets instead of the O(pairs) scan" is the
-- obvious optimization and it is a BUG: `ieInsertRow` indexes every row under
-- `oblIfaceKeys`, which is TWO keys — the identity key AND the bare-spelling
-- compatibility leg — so a bucket walk sees every row TWICE and, in the bare bucket,
-- pairs impls of two DIFFERENT interfaces that merely share a spelling.  That
-- rebuilds #1438's false reject (the one `cohSameIface` was added to fix) inside the
-- new substrate, and double-reports every pair besides.  The collapse is asserted
-- live by this block's own doctests — the bare bucket reads 2, deliberately.  Only
-- `ieRows` is keyless, and only a keyless population can be scanned pairwise.
ieRowsAll : ImplEnv -> List ImplRow
ieRowsAll env = env.ieRows

-- ⚠️ `ieRowOrd r == cur`, NOT `declEnvVisibleAt cur (ieRowOrd r)`.  The latter is the
-- ordinal PREFIX — every earlier module too — which is a different set and the wrong
-- one for a per-module sweep; it would also hand `declEnvVisibleAt` another reader,
-- which A-3.6 (#1558) is counting.  `ceRowsOwnedBy` writes `== cur` for the identical
-- reason; keep the two spellings the same.
ieRowsOwnedBy : Int -> ImplEnv -> List ImplRow
ieRowsOwnedBy cur env = filterList (r => ieRowOrd r == cur) env.ieRows

-- ── §9.7's scoping proofs, as ASSERTIONS rather than sentences ────────────────
--
-- 🚨 READ THIS BEFORE THE ASSERTIONS, OR THEY WILL TELL YOU SOMETHING FALSE.
-- These doctests look ONLY at the IDENTITY leg, which is the leg that does not
-- collapse.  **`IE` DOES STILL COLLAPSE SAME-SPELLED INTERFACES ON ITS OTHER
-- LEG, DELIBERATELY.**  `ieInsertRow` indexes every row under `oblIfaceKeys`,
-- which is TWO keys — the identity key AND the bare-spelling compatibility leg —
-- so `amod.Same` and `zmod.Same` below share the bare bucket, exactly as the
-- obligation channel does today.  That is inherited on purpose (see
-- `insertUnivImplKeys` for the `ifaceRefBare` goal producers that require it —
-- U1b (#1482) retired two of the three; the METHOD-OCCURRENCE one is #1507's, and
-- removing the leg is that unit's drain, not this one's), which is why #1438's
-- pin still reproduces after A-3.4 and after U1b.
--
-- So do not read the assertions below as "IE has no collapse".  They assert the
-- narrower true thing: the identity key is a SCOPE — it resolves to exactly one
-- row where a bare key would answer with two — which is what A-3 is building
-- toward and what `InstRef` and A-3.7 will consume.
--
-- `AGENTS.md` names the program-global table as this tree's most expensive shape
-- and demands the key's scope be PROVEN.  The corpus below is the adversarial
-- case: TWO UNRELATED MODULES that declare the same-spelled interface `Same` and
-- each impl it at the same-spelled type `Blob`.  Under a bare-name key the two
-- collapse into one bucket and one index — which is exactly the collapse A-3 is
-- removing — so every assertion here is fail-capable in the direction that
-- matters.
ieTyBlob : String -> Ty
ieTyBlob m =
  TyCon { tyConName = "Blob", tyConLoc = None, tyConOrigin = OriginModule m }

ieSameImplIn : String -> Decl
ieSameImplIn m = DImpl {
  pub = True,
  iface = "Same",
  tys = [ieTyBlob m],
  reqs = [],
  methods = [],
  implOrigin = OriginModule m,
}

-- the concrete-bucket key module [m]'s own `impl Same Blob` is indexed under.
-- Minted by the SAME calls `ieInsertRowAt` makes, so the assertions below test
-- the real key rather than a re-spelling of it.
ieProbeKey : String -> RegKey
ieProbeKey m = regKeyNTab
  [
    oblIfaceKey IfaceRef { irName = "Same", irOrigin = OriginModule m },
    dispHeadTab (headKeyOfCon (OriginModule m) "Blob"),
  ]

-- The COMPATIBILITY leg's key: bare interface spelling, and a head that is bare
-- anyway (`dispHeadTab` is spelling-keyed by the #1317 T1 rule), so it is the
-- SAME key for both modules — which is exactly why both rows land in it.
ieProbeBareKey : RegKey
ieProbeBareKey = regKeyNTab
  [
    TkBare NsIface "Same",
    dispHeadTab (headKeyOfCon (OriginModule "amod") "Blob"),
  ]

-- ordinal 0 = `amod`, ordinal 1 = `zmod`; no import edge between them is needed
-- or expressible here — that is the point of the shape.
ieProbeEnv : ImplEnv
ieProbeEnv = buildImplEnv
  [
    declEnvModule 0 "amod" [ieSameImplIn "amod"],
    declEnvModule 1 "zmod" [ieSameImplIn "zmod"],
  ]

-- 1. THE INTERFACE HALF IS A SCOPE.  Two same-spelled interfaces in two modules
--    land in DIFFERENT buckets: each identity key resolves to exactly ONE row.
-- > listLen (mregLookupK (ieProbeKey "amod") ieProbeEnv.ieConcrete)
-- 1
-- > listLen (mregLookupK (ieProbeKey "zmod") ieProbeEnv.ieConcrete)
-- 1
--
-- 1b. 🚨 AND THE BARE LEG STILL COLLAPSES THEM — asserted, not just admitted in
--     the header above, because an assertion is fail-capable and prose is not.
--     The SAME two rows also sit together under the bare-spelling key, which is
--     the compatibility leg `oblIfaceKeys` mints for goals that cannot carry an
--     identity.  Two rows, one bucket: that is #1438's shape, inherited on
--     purpose, and #1482's to drain.  If this ever reads `1`, the leg was dropped
--     and #1438's pin must have flipped with it.
-- > listLen (mregLookupK ieProbeBareKey ieProbeEnv.ieConcrete)
-- 2
--
-- 2. ROW IDENTITY.  The two same-spelled impls get DISTINCT `InstRef`s — the
--    property `bucketKeyEntriesFrom`'s restart-at-0 numbering lacks, and the one
--    A-3.7 and B-2 are waiting on.  Distinct in BOTH components, so neither the
--    module scope nor the sequence is carrying it alone.
--    ⚠️ OWED — this pair CANNOT discriminate an `ord`/`seq` swap: in a corpus of
--    one impl per module `ord == seq == [0, 1]`, so a builder that wrote the two
--    components the wrong way round would pass.  A discriminating corpus needs a
--    module contributing TWO impls (then `ord = [0,0,1]` while `seq = [0,1,2]`).
--    Not added here because it would also move the ordinal-filter counts in
--    assertion 3, and this round is comment-only.
-- > map (r => instRefMid (ieRowInst r)) ieProbeEnv.ieRows
-- ["amod", "zmod"]
-- > map (r => instRefSeq (ieRowInst r)) ieProbeEnv.ieRows
-- [0, 1]
--
-- 3. 🚨 TABLE SCOPE — AND SINCE A-3.6 (#1558) THE ASSERTION IS THE OPPOSITE ONE.
--    This item used to pin the prefix rule: `zmod` invisible at ordinal 0, visible at
--    1, and nothing at all at `declEnvsOrdOf`'s `-1` miss.  A-3.6 flipped candidacy
--    onto `ieCandidacyVisibleAt`, so what is asserted now is the C4/I2 property
--    itself: **the selected universe is INVARIANT IN THE READING ORDINAL.**  Every
--    impl declared anywhere in the graph is a candidate everywhere, which is what
--    *"import scoping never decides which instances exist"* means operationally.
--    ⚠️ WHICH LINE DISCRIMINATES WHAT, kept from the pre-flip version because the
--    hazard it names inverted rather than went away.  The pairs that grade the flip
--    are the ones whose expected value CHANGED: `zmod` at ordinal 0 (1, was 0) and
--    `amod` at the `-1` miss (1, was 0).  If the prefix filter is ever re-instated on
--    this path — by re-pointing `ieSnapAt` at `declEnvVisibleAt`, or by giving
--    `ieCandidacyVisibleAt` an ordinal body — both of those fall back to 0 and this
--    block goes red.  The unchanged lines (`amod` at 0 and 1, `zmod` at 1) grade
--    nothing about the flip on their own and are kept only as the monotonicity floor:
--    they are what a candidacy predicate that is accidentally too NARROW breaks.
--    ⚠️ The `-1` line is no longer a fail-CLOSED assertion.  It cannot be: an
--    unknown module id now sees the WHOLE graph instead of nothing, so on this axis
--    the miss sentinel is VACUOUS.  That is a real severity change and it is
--    A-3.6's, recorded here rather than left for someone to rediscover from a `0`
--    that quietly became a `1`.  The sentinel is still live and still fail-CLOSED for
--    the NAME axis — see `declEnvsOrdOf`, and the `declEnvVisibleTo` doctests far
--    above, which assert the ordinal conjunct is still doing work there.
-- > listLen ieProbeEnv.ieUnivSnaps
-- 2
-- > listLen (mregLookupK (ieProbeKey "amod") (ieUnivConcreteOf (ieUniverseAt 0 ieProbeEnv)))
-- 1
-- > listLen (mregLookupK (ieProbeKey "amod") (ieUnivConcreteOf (ieUniverseAt 1 ieProbeEnv)))
-- 1
-- > listLen (mregLookupK (ieProbeKey "zmod") (ieUnivConcreteOf (ieUniverseAt 0 ieProbeEnv)))
-- 1
-- > listLen (mregLookupK (ieProbeKey "zmod") (ieUnivConcreteOf (ieUniverseAt 1 ieProbeEnv)))
-- 1
-- > listLen (mregLookupK (ieProbeKey "amod") (ieUnivConcreteOf (ieUniverseAt (0 - 1) ieProbeEnv)))
-- 1
--
-- 4. THE PROJECTION IS THE OBLIGATION CHANNEL'S OWN UNIVERSE, built by the SAME
--    writer — so A-3.4 PR2's flip could not drift in key minting, only in
--    population and order, which is what both shadow instruments measured.  Since
--    that flip this is no longer a claim about a table nobody reads: it exercises the
--    projection the compiler actually dispatches on.
--    ⚠️ This item used to assert `zmod` at ordinals 1 and 0 as `1` and `0`.  Post-flip
--    both read `1`, i.e. the same value twice — which by item 3's own rule grades
--    nothing — so the redundant line is DELETED rather than left in place looking like
--    a test.  The surviving line still discriminates key minting: a row indexed under a
--    mis-minted concrete key answers `0` here at every ordinal.
-- > listLen (mregLookupK (ieProbeKey "zmod") (ieUnivConcreteOf (ieUniverseAt 1 ieProbeEnv)))
-- 1
ieUnivConcreteOf : ImplUniverse -> MultiRegistry (List Ty, List Require)
ieUnivConcreteOf (ImplUniverse conc _ _) = conc

-- ── ARCH B-2.1-a3: the HEAD-keyed index's corpus, built to DISCRIMINATE ────────
-- `ieProbeEnv` above cannot grade `ieByHead`: one impl per module means "exactly
-- once", "ascending" and "interface-blind" all read the same value, so an index that
-- double-filed, prepended, or was keyed on the interface would pass it.  This corpus
-- separates the three.  Four of its five impls carry an ORIGIN-BEARING interface, so
-- `oblIfaceKeys` mints TWO keys for each — which is what makes the double-file
-- hazard reachable at all (an all-`OriginUnresolved` corpus would mint one apiece and
-- grade nothing about the placement).
--
--   `amod` (ordinal 0): `impl Same Blob`, `impl Other Blob` — two DIFFERENT
--                       interfaces at the SAME head, which is the case `ieConcrete`
--                       separates and `ieByHead` must not.
--   `zmod` (ordinal 1): `impl Same Blob` (its own same-spelled head — `dispHeadTab`
--                       is spelling-keyed, #1317 T1, so it shares the bucket); a
--                       fully-general `impl Gen a`, which has no head tycon and must
--                       land in the HEADLESS bucket instead; and one impl whose
--                       interface is `OriginUnresolved` (below).
--
-- 🚨 THE `OriginUnresolved` ROW IS THE `ieByHead`-IS-IMMUNE-TO-F1 PROBE, and it is
-- the reason this corpus has a fifth member.  RUN-B-025's review finding F1: the
-- interface keying of `a2`'s shared ref is ARM-ASYMMETRIC — `oblIfaceKeys` branches
-- on `irOrigin`, and a user-declared interface has no `flatTyOriginScope` entry on
-- Flat, so its impls file under ONE key there and TWO on Module.  `ieByHead` cannot
-- inherit that, because its key has no interface component AT ALL: it is
-- `headBucketKey (univReceiverTag tys)`, and `dispHeadTab hk = TkBare NsType
-- (headKeyName hk)` — bare spelling, origin-blind (#1317 T1).  This row asserts that
-- rather than arguing it: it lands in the SAME head bucket as its origin-bearing
-- siblings while minting half as many interface keys.
ieOtherImplIn : String -> Decl
ieOtherImplIn m = DImpl {
  pub = True,
  iface = "Other",
  tys = [ieTyBlob m],
  reqs = [],
  methods = [],
  implOrigin = OriginModule m,
}

-- a fully-general `impl Gen a`: `univReceiverTag` answers `None` for a `TyVar` head,
-- so this row is the headless-bucket case (#1128's shape).
ieGenImplIn : String -> Decl
ieGenImplIn m = DImpl {
  pub = True,
  iface = "Gen",
  tys = [TyVar "a"],
  reqs = [],
  methods = [],
  implOrigin = OriginModule m,
}

-- `impl Loose Blob` with an IDENTITY-LESS interface: `oblIfaceKeys` mints ONE key for
-- it (the bare leg) where every sibling above gets two.  Its HEAD is an ordinary
-- concrete `Blob`, so a head-keyed index must file it beside them regardless — see the
-- F1 paragraph above.
ieLooseImplIn : String -> Decl
ieLooseImplIn m = DImpl {
  pub = True,
  iface = "Loose",
  tys = [ieTyBlob m],
  reqs = [],
  methods = [],
  implOrigin = OriginUnresolved,
}

ieHeadProbeAmod : List Decl
ieHeadProbeAmod = [ieSameImplIn "amod", ieOtherImplIn "amod"]

ieHeadProbeZmod : List Decl
ieHeadProbeZmod =
  [ieSameImplIn "zmod", ieGenImplIn "zmod", ieLooseImplIn "zmod"]

-- the SAME four decls as one flat program — the Flat arm's input, so both once-per-row
-- filing paths are graded over one corpus and a drift between them is visible.
ieHeadProbeDecls : List Decl
ieHeadProbeDecls = ieHeadProbeAmod ++ ieHeadProbeZmod

ieHeadProbeEnv : ImplEnv
ieHeadProbeEnv = buildImplEnv
  [
    declEnvModule 0 "amod" ieHeadProbeAmod,
    declEnvModule 1 "zmod" ieHeadProbeZmod,
  ]

-- 5. THE POSITIVE CONTROL: the corpus is populated and numbered as claimed.  Read
--    this first — every assertion below is a projection of it, so if this line is
--    wrong they are all measuring the wrong thing.
-- > map (r => instRefSeq (ieRowInst r)) ieHeadProbeEnv.ieRows
-- [0, 1, 2, 3, 4]
--
-- 6. `ieByHead` — four properties, one line, each independently fail-capable:
--    6a. EXACTLY ONCE PER ROW.  Filed in `ieFileRow` (once per row), NOT in
--        `ieInsertRowAt` (once per `oblIfaceKeys` element).  Move the filing there
--        and this reads `[0, 0, 1, 1, 2, 2, 4]` — the inflated bucket that would
--        corrupt every count and `min⊑` taken over it.  ⚠️ Note seq 4 appears ONCE
--        even then: its interface is `OriginUnresolved`, so it mints one key.  A
--        double-file audit that only looked at ONE row could pick that one and see
--        nothing.
--    6b. INTERFACE-BLIND, ACROSS MODULES.  `Same`@amod, `Other`@amod, `Same`@zmod
--        and `Loose` share the bucket: this is `KeyBuckets`' head partition, not
--        `ieConcrete`'s `[iface, head]` one.  An index keyed on the interface reads
--        `[0]` or `[0, 2]`, never `[0, 1, 2, 4]`.
--    6c. ASCENDING BY `instRefSeq` — `mergeByDeclIdx`'s precondition (RUN-B-007's
--        declaration-index ruling).  `mregAddK` in place of `mregAppendK` reads
--        `[4, 2, 1, 0]`.
--    6d. IMMUNE TO THE ARM-KEYING ASYMMETRY (RUN-B-025 F1).  Seq 4's interface mints
--        ONE `oblIfaceKeys` leg where 0/1/2 mint two, and it is in the bucket all the
--        same — because this key has no interface component.  An index that grew one
--        (or that keyed the head through anything origin-bearing) drops seq 4 here.
-- > map (r => instRefSeq (ieRowInst r)) (ieHeadRows (Some ieProbeBlobHead) ieHeadProbeEnv)
-- [0, 1, 2, 4]
--
-- 7. THE HEADLESS ROW IS IN THE HEADLESS BUCKET AND NOWHERE ELSE.  `impl Gen a` is
--    seq 3, and item 6 shows it is absent from the concrete bucket — so the two
--    arms of `headBucketKey` are not collapsing into one.
-- > map (r => instRefSeq (ieRowInst r)) (ieHeadRows None ieHeadProbeEnv)
-- [3]
--
-- 8. THE CONTROL FOR 6b, and it is what proves that line tests something: the
--    INTERFACE-keyed bucket over the SAME env answers with ONE row where the head
--    bucket answers with three.  If `ieByHead` were a re-spelling of `ieConcrete`,
--    item 6 would read this value instead.
-- > listLen (mregLookupK (ieProbeKey "amod") ieHeadProbeEnv.ieConcrete)
-- 1
--
-- ⚠️ ITEM 9'S LAST EXPECTATION LINE IS FOLLOWED DIRECTLY BY A DECLARATION
--    (`ieProbeBlobHead`), AND IT HAS TO BE.  `medaka test` absorbs an ADJACENT
--    COMMENT into a doctest's expected output, so a comment there — the block-end
--    banner, where this block first ended — makes the last assertion FAIL with
--    `expected: [3]` / `actual: [3]` and the banner spliced between them: a real
--    failure that reads like a tooling bug.  Measured on this binary while writing
--    these tests.  A decl terminates the block; do not move it or interpose a
--    comment.
--
-- 9. 🚨 BOTH ONCE-PER-ROW ARMS FILE IT.  `buildImplEnv` (Module, via `ieAddRows` →
--    `ieInsertRow`) and `buildFlatImplEnv` (Flat, via `ieIndexRows`) are the two
--    paths B-2.1-a2 left in parallel, and the failure shape for a parallel pair in
--    this tree is a fix landing in one and not the other (`evalModules` /
--    `cevalModules`, `AGENTS.md`).  The same five decls through the FLAT builder must
--    give the same buckets.  A future index added to only one arm leaves every line
--    above green and reddens this one.
--    ⚠️ This is ALSO the arm-symmetry assertion F1 does not have for the interface
--    keying: identical head buckets on both arms, over a corpus that deliberately
--    mixes origin-bearing and identity-less interfaces.  It says nothing about
--    `ieConcrete`/`ieHeadless`, which is where F1 lives and which stays open.
-- > map (r => instRefSeq (ieRowInst r)) (ieHeadRows (Some ieProbeBlobHead) (buildFlatImplEnv ieHeadProbeDecls))
-- [0, 1, 2, 4]
-- > map (r => instRefSeq (ieRowInst r)) (ieHeadRows None (buildFlatImplEnv ieHeadProbeDecls))
-- [3]
ieProbeBlobHead : HeadKey
ieProbeBlobHead = headKeyOfCon (OriginModule "amod") "Blob"
-- ═══ #1112 A-3.4: IE-BLOCK-END ═════════════════════════════════════════════════

-- ═══ #1519 A-3.3: THE `CE` REGISTRY — CE-BLOCK-BEGIN ═══════════════════════════
-- §2 K: *"CE (class environment): interfaces with declared parameter kinds …,
-- method schemes, superclass predicates …"*  Built once, whole-graph, inside
-- `buildDeclEnvs`; every read filters through `declEnvVisibleAt`.  ⚠️ This used to
-- add "(A-3.6 deletes its body)".  It does not: A-3.6 (#1558) split the predicate
-- and flipped the INSTANCE axis only.  `CE` is interface IDENTITY, not instance
-- candidacy, so every `CE` read keeps its ordinal filter — permanently, unless some
-- later unit argues the name/identity axis on its own merits.
--
-- 🚨 SYNTACTIC, NOT ELABORATED — the Step 0 ruling this unit inherits rather
-- than re-derives: *"CE's declaration environments hold the DECLARATION as
-- declared, not as elaborated.  CE stores raw Ty/Variant/Field keyed by
-- identity.  Elaboration to Scheme/Mono/RecordInfo stays where it is today."*
-- Re-confirmed against this tree before writing a line of this block: every
-- LIVE CE-side table already stores raw `Ty` —  ⚠️ THE LIST BELOW IS A DATED
-- SNAPSHOT, NOT A LIVE INVENTORY: `universeIfaceParamKinds` was retired by A-3.5c
-- and `universeIfaceRequiredRef` by A-3.5a (both #1557).  It is kept unedited
-- because the CLAIM it supports — no CE-side table stores an elaborated
-- `Scheme`/`Mono`/`RecordInfo` — is what mattered and is still true of the
-- survivors; derive the live set from `CrossRun` rather than reading it here.
-- `universeMethodIfaceParamsRef : Ref (OrdMap (IfaceRef, List String, Ty, List
-- (String, List Kind)))`, `universeMethodIdentsRef`, `universeIfaceRequiredRef
-- : Ref (Registry (List String))`, `universeIfaceParamKinds : Ref (List
-- (RegKey, List Kind))`, `universeRegisteredIfacesRef : Ref (OrdMap Unit)`,
-- `superDeclsRef : Ref (List Decl)` — zero `Scheme`, zero `Mono`, zero
-- `RecordInfo`.  `ifaceMethodTy` (§ elsewhere in this file) returns raw `Ty`
-- and every use site elaborates on demand via `fromAstTypeE`.  This
-- construction mirrors that exactly, and hits the identical wall A-3.2a's
-- `DataEnv` construction hit: elaborating a method signature would call
-- `fromAstTypeE`/`registerRecordInfoKeyed`-shaped machinery, which MUTATES
-- `perRun` refs and EMITS diagnostics through a `perRun`-scoped dedupe —
-- machinery that does not exist yet in the driver PREAMBLE.  ⚠️ This sentence
-- used to say that machinery "mints fresh tyvar ids off the global counter";
-- that is FALSE (`tyvarCounter` is a `PerRun` field, reset per module) and it
-- was corrected 2026-08-12 — see the "WHY NOT JUST CALL registerAllData/…"
-- block above `DataEnv` for the corrected walls.
-- So this index is deliberately SYNTACTIC: raw `Ty`/
-- `Super`/`Kind` values, keyed by identity, no elaboration performed — see the
-- "WHY NOT JUST CALL registerAllData/…" block above `DataEnv` for the full
-- derivation, which applies here unchanged.
--
-- EXCLUDES `universeMethodDispatchIdxByIdRef` and `universeIfaceMethodsRef` —
-- lifted bare and unchanged, NEVER keyed here (#1112's decomposition row,
-- re-grounded in #1519's own bookkeeping comment 2026-08-11 after #1353
-- closed): `universeIfaceMethodsRef` belongs to #1354's method-namespace unit
-- (OPEN) — its own inventory table names this table *"never touched by any
-- unit"*, and the S1-NS ruling (#1353, ADOPTED 2026-08-08) is implemented as a
-- FILTER AT THE READ (`nameableIfaceShadows` narrowing the graph-global set
-- per module), not a re-keying of the table, so keying it here would build a
-- second, differently-shaped answer to a question that already has one live
-- decision point.  `universeMethodDispatchIdxByIdRef` is #1351's (OPEN S0; its
-- bare-name predecessor `universeMethodDispatchIdxRef` was retired at L5), and
-- `TYPECHECK-TARGET-ARCHITECTURE.md` §9 independently routes it to `IE`/
-- RLocal-site channels, not `CE`.
--
-- ✅ `universeIfaceParamKinds` COORDINATION — DISCHARGED by #1557 A-3.5c, which is
-- the PR this paragraph was addressed to.  A-3.3 wrote: *"its eventual retirement is
-- this unit's (`CE`'s) to route, on whatever PR first gives `ceParamKinds` a live
-- reader, not A-3.2b's to fold in by accident of which function happens to marshal it
-- today."*  A-3.5c is that PR.  `ceParamKinds` has a production reader
-- (`ceSlotKindsAt` ← `checkGradedImplTys`), and BOTH the `universeIfaceParamKinds`
-- CrossRun cell and the `ifaceParamKindsRef` PerRun ref it marshalled are DELETED,
-- along with their writer — so `loadDataUniverse`/`storeDataUniverse` marshal one
-- fewer table than before this unit.  ⚠️ DO NOT WRITE THE COUNT HERE: this line said
-- *"THREE tables (recordByName, fieldOwners, dataParamKinds)"* and #1512 slices 2+3
-- retired two of those three the same day.  DERIVE the survivors from the two bodies,
-- whose own header (`loadDataUniverse`) states the same rule.  A-3.2b's residual slice 1
-- took `aliasTable` out just before this unit took `ifaceParamKinds`, and
-- the `DataEnv`-by-CO-LOCATION confusion the original note was guarding against no
-- longer has a table to attach to.  A-3.2b's slices retire the remaining rows under
-- `DataEnv`'s own name.
--
-- ⚠️ ZERO READERS NO LONGER HOLDS, and that is the whole point of A-3.5c under
-- RULING 1 (*"A-3a is complete when `CE` and `DataEnv` each have at least one
-- PRODUCTION reader AND the corresponding `universe*` rows are retired"*).  #1519
-- landed this block construction-only and therefore INERT; the three readers are now
-- `ceSlotKindsAt` (graded impl-head kinds), `ceRowsOwnedBy` (phantom methods) and
-- `ceRowsVisibleAt` + `ceLookupAt` (W1 acyclicity, following superinterface edges by
-- identity).  What follows was written when nothing read `deIfaces`; the caveat it
-- states is now historical, kept because the doctests it justifies are still the
-- sharpest evidence this block has:
--
-- ZERO READERS, deliberately (construction only, per #1519's bar) — nothing
-- outside this block populates or reads `deIfaces`.  "Byte-identical" is
-- therefore WEAK evidence for this PR, exactly as A-3.2a's own header says of
-- `deData`: nothing reads the new field, so nothing could have moved a
-- judgment even if the construction were wrong.  The load-bearing checks are
-- the doctests below, which exercise the fold's output directly against a
-- discriminating two-module same-spelled-interface corpus (mirroring `IE`'s
-- `ieProbeEnv`), not the differential gates.
--
-- 🚨 THE `DL` MEASUREMENT §9.5 OWES — DISCHARGED, not cited-and-skipped.  A-3.4's
-- own block above says A-3.2/A-3.3 "must measure their own projections; they
-- may not cite 'DL is discharged'".  This unit's projection over `demDecls` is
-- prePass-INVARIANT, so there is nothing for the elaborate path's
-- `prePassModulePairArg` rewrite to disagree with: `prePassDeclScoped`'s
-- `DInterface` arm rewrites only `methods`, via `prePassIfaceMethodScoped`,
-- which itself rewrites only a method's `MethodDefault` BODY (the `Some (…, e)`
-- arm's `e`) — never `n`/`ty`, and the `None` (no default) arm is untouched
-- outright.  `ceMethodOf`'s `(IfaceMethod n ty _)` pattern discards exactly
-- that third position.  `name`/`typarams`/`supers`/`ifaceOrigin` are untouched
-- by the same arm (only `methods` is record-updated).  So CE's projection over
-- the raw `demDecls` and over the prePass-rewritten `modules2a`/`modules2`
-- agree by construction — the rewrite touches nothing CE reads.
--
-- 🚨 POSITIONAL, NOT A NAMED RECORD — the SAME measured emitter constraint
-- `ImplRow` documents above, not a style echo of it.  `CeRow`'s construction
-- site (`buildDeclEnvs` → `buildClassEnv`) is reachable from every driver
-- entry exactly as `implRowsOf`'s is, while a named-record spelling's field
-- ACCESS can still be linked into an entry whose construction was DCE'd (the
-- `ieOrd`/`wasm_emit_typed_main.mdk` panic `ImplRow`'s comment reproduces).  A
-- positional constructor is destructured by pattern match and consults no
-- label table, so it cannot hit this.  `ClassEnv` below KEEPS named fields,
-- for the identical reason `ImplEnv` does: its construction site
-- (`emptyClassEnv`) is reachable from `emptyDeclEnvs` ← `freshDriverState`,
-- which every driver builds.
--
-- Fields, in order: this interface's identity key (`ifaceTabKey` lifted
-- through `regKeyOfTab`, the same mint `oblIfaceKeys`/`ifaceSlotKey` use);
-- the declaring module's ordinal (A-3.1's `demOrd`, the scope); the interface
-- reference (spelling + identity); its declared type parameters, by name and
-- position; its methods as `(name, raw Ty, graded scope)` triples — the scope
-- is `declGradedScope typarams methods`, computed ONCE per interface exactly
-- as `insertMethodIfaceParams`/`insertMethodIdents` already do, not re-derived
-- per method; its raw `Super` list, unelaborated; its per-typaram kind
-- signature, POSITIONAL with `ceTyparams` — `ifaceParamKindsOf p methods` for
-- each `p`, the SAME pure computation `registerIfaceParamKindsGo` performs
-- per slot, so a graded interface's `KRow` inference cannot drift between the
-- live universe and this table; and, since #1557 A-3.5a, its REQUIRED-method
-- names — `requiredMethodNames methods`, the SAME pure computation the retired
-- `universeIfaceRequiredRef` writer (`insertIfaceRequired`) stored under the
-- SAME `regKeyOfTab (ifaceTabKey ifaceOrigin name)` key, so relocating
-- impl-completeness onto this row is a population/lifetime move on the Module
-- arm and not a re-key (the re-key is confined to the Flat arm, which was on a
-- bare first-match scan).
--
-- ⚠️ NO `ceLoc` FIELD, and that is a deliberate departure from a literal
-- reading of this unit's row sketch, for the SAME reason `ImplRow` carries no
-- `ieLoc`: `DInterface` has no `Loc` field at all
-- (`compiler/frontend/ast.mdk`'s `DInterface` record — `pub`/`def`/`name`/
-- `typarams`/`supers`/`methods`/`ifaceOrigin`, nothing carrying a source
-- position), so a `ceLoc : Option Loc` here could only ever be `None`.  A
-- field that is structurally always-`None` is worse than an absent one — it
-- reads as available to a consumer and is not.  Whoever needs it must first
-- give `DInterface` a location, which is its own unit.
--
-- ⚠️ COVERAGE HONESTY, recorded rather than left for a reader to assume: the
-- SCOPE component of each `ceMethods` triple (the third position, `declGradedScope
-- typarams methods` — shared across every method of one interface) is NOT
-- independently asserted by any doctest below.  It is exercised only
-- TRANSITIVELY, through the graded/ungraded `ceRowParamKinds` doctests, which
-- read the row-level per-typaram computation the scope is filtered from
-- (`declGradedScopeAdd`'s `anyKRow` filter over the SAME `ifaceParamKindsOf`
-- calls).  A mutation that corrupted ONLY the per-method scope tuple (leaving
-- `ceRowParamKinds` correct) would go undetected by this suite.  This is a
-- DECIDED gap, not an oversight: `ceMethods`' scope position has no reader yet
-- either (construction only, per this unit's bar), so there is no live
-- consumer to derive an independent assertion from beyond re-stating
-- `declGradedScope`'s own definition under a different name.
data CeRow =
  | CeRow RegKey Int IfaceRef (List String) (List (String, Ty, List (String, List Kind))) (List Super) (List (List Kind)) (List String)

ceRowKey : CeRow -> RegKey
ceRowKey (CeRow k _ _ _ _ _ _ _) = k

ceRowOrd : CeRow -> Int
ceRowOrd (CeRow _ o _ _ _ _ _ _) = o

ceRowIface : CeRow -> IfaceRef
ceRowIface (CeRow _ _ ir _ _ _ _ _) = ir

ceRowTyparams : CeRow -> List String
ceRowTyparams (CeRow _ _ _ tp _ _ _ _) = tp

ceRowMethods : CeRow -> List (String, Ty, List (String, List Kind))
ceRowMethods (CeRow _ _ _ _ ms _ _ _) = ms

ceRowSupers : CeRow -> List Super
ceRowSupers (CeRow _ _ _ _ _ sups _ _) = sups

ceRowParamKinds : CeRow -> List (List Kind)
ceRowParamKinds (CeRow _ _ _ _ _ _ pk _) = pk

ceRowRequired : CeRow -> List String
ceRowRequired (CeRow _ _ _ _ _ _ _ req) = req

-- The registry.  `ceRows` is the population in build order (ordinal order
-- across modules, declaration order within one); `ceByKey` is the single
-- identity-keyed index — CE's read shape is "what does interface I mean
-- here", a single-row lookup, not IE's "every impl matching a goal"
-- candidate-set collection, so ONE `Registry` (not a `MultiRegistry`)
-- suffices: an interface identity resolves to exactly one declaration.
data ClassEnv = ClassEnv { ceRows : List CeRow, ceByKey : Registry CeRow }

emptyClassEnv : ClassEnv
emptyClassEnv = ClassEnv { ceRows = [], ceByKey = regEmpty }

-- Fold the envelope's modules, in ordinal order, into one whole-graph
-- registry.  Builds in REVERSE and reverses once at the end — unlike
-- `ieInsertRow`'s per-row `++`, which that block's own comment records as an
-- OWED O(rows²) cost — because this is new code with no byte-identical
-- history to preserve, so there is no reason to start it with the same
-- quadratic shape `compiler/AGENTS.md` names as this tree's most expensive.
buildClassEnv : List DeclEnvModule -> ClassEnv
buildClassEnv mods = classEnvFinish (buildClassEnvGo mods emptyClassEnv)

classEnvFinish : ClassEnv -> ClassEnv
classEnvFinish env = ClassEnv { env | ceRows = reverseL env.ceRows }

buildClassEnvGo : List DeclEnvModule -> ClassEnv -> ClassEnv
buildClassEnvGo [] env = env
buildClassEnvGo (m::rest) env =
  let rows = classEnvRowsOf m.demOrd (classEnvDeclFacts m.demDecls)
  buildClassEnvGo rest (ceAddRows rows env)

-- One interface decl's raw facts: name, typarams, methods, supers, identity.
classEnvDeclFacts : List Decl -> List (String, List String, List IfaceMethod, List Super, TyConOrigin)
classEnvDeclFacts prog = flatMap classEnvDeclFact prog

classEnvDeclFact : Decl -> List (String, List String, List IfaceMethod, List Super, TyConOrigin)
classEnvDeclFact (DAttrib _ d) = classEnvDeclFact d
classEnvDeclFact (DInterface { name, typarams, supers, methods, ifaceOrigin, ... }) = [(name, typarams, methods, supers, ifaceOrigin)]
classEnvDeclFact _ = []

classEnvRowsOf : Int -> List (String, List String, List IfaceMethod, List Super, TyConOrigin) -> List CeRow
classEnvRowsOf _ [] = []
classEnvRowsOf ord ((name, typarams, methods, supers, o)::rest) =
  let scope = declGradedScope typarams methods
  let row = CeRow (regKeyOfTab (ifaceTabKey o name)) ord IfaceRef {
    irName = name,
    irOrigin = o,
  } typarams (map (ceMethodOf scope) methods) supers (map (p => ifaceParamKindsOf p methods) typarams) (requiredMethodNames methods)
  row :: classEnvRowsOf ord rest

ceMethodOf : List (String, List Kind) -> IfaceMethod -> (String, Ty, List (String, List Kind))
ceMethodOf scope (IfaceMethod n ty _) = (n, ty, scope)

ceAddRows : List CeRow -> ClassEnv -> ClassEnv
ceAddRows [] env = env
ceAddRows (r::rest) env = ceAddRows rest (ceInsertRow r env)

ceInsertRow : CeRow -> ClassEnv -> ClassEnv
ceInsertRow r env = ClassEnv { env | ceRows = r::env.ceRows, ceByKey = regInsertK (ceRowKey r) r env.ceByKey }

-- 🚨 THE ONE `CE` READ ACCESSOR — the ordinal-filtered lookup routed through
-- `declEnvVisibleAt`.  ⚠️ It is the ordinal filter's LAST substrate: `IE`'s two
-- reads (`ieUniverseAt`/`ieSnapAt` under A-3.6, `ieRowsVisibleAt` under RUN-055)
-- have both moved to `ieCandidacyVisibleAt`, so `CE` and the name tables are what
-- keeps this predicate live.  Looks up by IDENTITY rather than collecting a
-- candidate set, per the shape argued at `ClassEnv` above.
--
-- ⚠️ This said "NO CALLER TODAY — construction only, per this unit's bar" while it was
-- #1519's.  Since #1557 A-3.5c it has THREE production callers: `ceSlotKindsAt`
-- (graded impl-head kinds), and `ifaceDfsCycleOneSuper` following a superinterface
-- edge by identity; `ceRowsVisibleAt`/`ceRowsOwnedBy` are its population peers on the
-- same ordinal predicate.  Anything reaching `ceByKey` directly instead of through
-- here would bypass `declEnvVisibleAt` and silently widen the `CE` axis — which
-- A-3.6 deliberately did NOT widen, so there is now no unit such a bypass could be
-- mistaken for finishing early.
ceLookupAt : RegKey -> Int -> ClassEnv -> Option CeRow
ceLookupAt key cur env = match regLookupK key env.ceByKey
  None => None
  Some r => if declEnvVisibleAt cur (ceRowOrd r) then Some r else None

-- ── #1557 A-3.5c: the ROW-SET reads, and why there are exactly two ─────────
-- `ceLookupAt` above answers "what does interface I mean here"; the two
-- relocated SCANS (W1 acyclicity, phantom methods) instead need a POPULATION,
-- and they need two DIFFERENT ones.  Both go through `declEnvVisibleAt` — the
-- name-axis ordinal predicate, per A-3.1's routing rule.  ⚠️ This used to end "so
-- A-3.6 still has a single body to delete"; A-3.6 (#1558) split the predicate
-- instead, and `CE` stayed on this one.  The routing rule is what survived and it
-- is why the split cost nothing here.
--
-- 🚨 THE TWO ARE NOT INTERCHANGEABLE, and picking the wrong one is a silent
-- widening rather than a loud one.  `ceRowsVisibleAt` is the reading module's
-- whole PREFIX (prelude + every earlier module + itself) — it reproduces what
-- `checkInterfaceCycles` is handed today (`accAll ++ accData ++ prog`).
-- `ceRowsOwnedBy` is the reading module ALONE — it reproduces what
-- `checkPhantomMethods` is handed today (`prog` on the Module arm, the
-- driver-staged USER decls on Flat).  Feeding the prefix to phantom-methods
-- would re-report every imported interface's phantom method once per importing
-- module; feeding own-only to the cycle scan would drop a cycle that closes
-- through an imported superinterface.
ceRowsVisibleAt : Int -> ClassEnv -> List CeRow
ceRowsVisibleAt cur env =
  filterList (r => declEnvVisibleAt cur (ceRowOrd r)) env.ceRows

ceRowsOwnedBy : Int -> ClassEnv -> List CeRow
ceRowsOwnedBy cur env = filterList (r => ceRowOrd r == cur) env.ceRows

-- Slot [i]'s declared kind signature for interface [key], at the reading
-- module's ordinal.  `ceRowParamKinds` is POSITIONAL with `ceTyparams` and
-- holds `ifaceParamKindsOf p methods` per slot — the SAME pure computation the
-- retired `ifaceParamKindsRef` writer (`registerIfaceParamKindsGo`) performed
-- per slot under an `ifaceSlotKey o iface i` key, so indexing this list by `i`
-- and looking that key up are the same question.  An out-of-range slot ABSTAINS
-- (`None`), which is the pre-existing miss policy: `checkGradedImplTys`' own
-- `_ => ()` arm already covered "an interface with fewer parameters than the
-- impl has type arguments".
ceSlotKindsAt : RegKey -> Int -> Int -> ClassEnv -> Option (List Kind)
ceSlotKindsAt key cur i env = match ceLookupAt key cur env
  None => None
  Some r => nthKindList i (ceRowParamKinds r)

-- #1557 A-3.5a: interface [key]'s REQUIRED-method names at the reading module's
-- ordinal — the relocation target of `universeIfaceRequiredRef`'s registry lookup
-- (Module arm) and of `ifaceRequiredMethods`' bare first-match scan (Flat arm).
--
-- 🚨 IT MUST GO THROUGH `ceLookupAt`, NOT `regLookupK … env.ceByKey`.  A second
-- open-coded path to `ceByKey` would bypass `declEnvVisibleAt` and silently widen
-- the `CE` axis.  ⚠️ This said "perform A-3.6's widening early, and A-3.6 depends on
-- there being exactly ONE ordinal predicate to split".  A-3.6 (#1558) has landed and
-- split the predicate; `CE` was NOT the axis it flipped, so the hazard is now an
-- unlicensed widening with no unit behind it at all.  `ceLookupAt`'s own header
-- states the rule.
--
-- MISS POLICY, and it is the unit's primary hazard: `None` means "no interface of
-- that IDENTITY is visible here", and `implCompletenessMsgsOf`'s `None` arm is `[]`
-- — i.e. a miss produces NO diagnostic, a silent accept.  That is a severity
-- INCREASE relative to a wrong-but-loud answer, so the population equality this
-- lookup rests on is what the unit owes evidence for, not the key (which does not
-- move on the Module arm — see `CeRow`'s field paragraph).
ceRequiredAt : RegKey -> Int -> ClassEnv -> Option (List String)
ceRequiredAt key cur env = map ceRowRequired (ceLookupAt key cur env)

nthKindList : Int -> List (List Kind) -> Option (List Kind)
nthKindList _ [] = None
nthKindList i (k::rest)
  | i == 0 = Some k
  | otherwise = nthKindList (i - 1) rest

-- ── doctests — a discriminating two-module, same-spelled-interface corpus ───
-- Mirrors `IE`'s `ieProbeEnv` shape deliberately: `AGENTS.md` demands a program
-- -global table's key be PROVEN scoped, and the proof is the adversarial case —
-- TWO UNRELATED MODULES declaring the SAME-SPELLED interface `Same`, each with
-- DIFFERENT content, so a bare-name (last-write-wins) construction would
-- collapse them and every assertion below would read the WRONG module's
-- content.  Every assertion here is fail-capable in that direction.
ceMethodFoo : IfaceMethod
ceMethodFoo =
  IfaceMethod "foo" (TyFun (TyVar "a") (tyConBuiltin "Int" None)) None

ceMethodBar : IfaceMethod
ceMethodBar =
  IfaceMethod "bar" (TyFun (TyVar "a") (tyConBuiltin "String" None)) None

ceSuperEq : Super
ceSuperEq = Super {
  superHead = "Eq",
  superParams = ["a"],
  superOrigin = OriginModule "core",
}

ceSameDeclIn : String -> List IfaceMethod -> Decl
ceSameDeclIn m methods = DInterface {
  pub = True,
  def = False,
  name = "Same",
  typarams = ["a"],
  supers = [ceSuperEq],
  methods = methods,
  ifaceOrigin = OriginModule m,
}

-- ordinal 0 = amod, ordinal 1 = zmod; no import edge between them, exactly as
-- `ieProbeEnv` needs none — the point of the shape is that identity alone,
-- not any resolve-level relationship, keeps the two rows apart.
ceProbeEnv : ClassEnv
ceProbeEnv = buildClassEnv
  [
    declEnvModule 0 "amod" [ceSameDeclIn "amod" [ceMethodFoo]],
    declEnvModule 1 "zmod" [ceSameDeclIn "zmod" [ceMethodBar]],
  ]

ceProbeKey : String -> RegKey
ceProbeKey m = regKeyOfTab (ifaceTabKey (OriginModule m) "Same")

ceRowMethodNames : CeRow -> List String
ceRowMethodNames r = map ceMethodName (ceRowMethods r)

ceMethodName : (String, Ty, List (String, List Kind)) -> String
ceMethodName (n, _, _) = n

-- Observes the raw `Ty` itself, via the existing renderer (`ppTy`) rather than
-- a bespoke one — this is what the WHOLE Step 0 ruling is about: a mutation
-- that replaced every method's `Ty` with a bogus constant while leaving names
-- correct would be invisible to `ceRowMethodNames` alone and must not be
-- invisible here too.
ceMethodTyStr : (String, Ty, List (String, List Kind)) -> String
ceMethodTyStr (_, ty, _) = ppTy ty

ceSuperHead : Super -> String
ceSuperHead (Super { superHead = h, ... }) = h

-- The module id, for a ROW rather than a lookup result — the row-ORDER
-- assertion below needs the identity of EACH row in `ceRows`, not a
-- single keyed lookup, exactly as `instRefMid`/`ieRowInst` give `IE`'s
-- doctests the same thing.  The non-module arms never occur on a `CeRow`
-- built from a real `DInterface` (its `ifaceOrigin` is threaded straight
-- from the decl, and this doctest corpus stamps every fixture
-- `OriginModule _`).
--
-- ⚠️ NAMED, NOT A WILDCARD — this tree's documented convention for a closed
-- sum like `TyConOrigin`, not a style preference of this block's.
-- `resolve.mdk:3783/3894/4087` and `originPhrase` (`typecheck.mdk`, pinned in
-- `tc_originun_allowed` below) all enumerate `TyConOrigin`'s three
-- inhabitants explicitly *"so a fourth inhabitant is MADE TO SHOW UP"* at
-- every match, rather than being silently absorbed by a wildcard — a
-- wildcard here would still be TOTAL, but totality is not what the
-- convention is protecting; DISCOVERABILITY of a future fourth constructor
-- is.  (An earlier revision of this comment argued the wildcard on totality
-- grounds and left the convention unstated — wrong question: the tree
-- already answers it the other way in five places, and a comment settling
-- it unilaterally forecloses the one a future editor needs to see.)  Per the
-- documented remedy those five sites use, these two eliminator arms are
-- listed in `test/typecheck_compiler_source.sh`'s `tc_originun_allowed`
-- rather than the ratchet's grep being widened.
ceRowOriginTag : CeRow -> String
ceRowOriginTag r = match (ceRowIface r).irOrigin
  OriginModule m => m
  OriginBuiltin => "<builtin>"
  OriginUnresolved => "<unresolved>"

-- lookup-and-project in one call, so the doctest lines below stay one
-- expression each (this file's doctest extraction is single-line-per-`>`).
ceRowMethodNamesAt : String -> Int -> ClassEnv -> List String
ceRowMethodNamesAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => []
  Some r => ceRowMethodNames r

ceRowMethodTysAt : String -> Int -> ClassEnv -> List String
ceRowMethodTysAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => []
  Some r => map ceMethodTyStr (ceRowMethods r)

ceRowTyparamsAt : String -> Int -> ClassEnv -> List String
ceRowTyparamsAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => []
  Some r => ceRowTyparams r

ceRowSuperHeadsAt : String -> Int -> ClassEnv -> List String
ceRowSuperHeadsAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => []
  Some r => map ceSuperHead (ceRowSupers r)

-- `superParams`/`superOrigin` are asserted SEPARATELY from `superHead` above
-- (rather than folded into one combined string) so a mutation to any one of
-- the three `Super` fields fails a doctest naming that field, not a
-- catch-all — same discipline as the per-field `ceRow*At` accessors.
ceSuperParams : Super -> List String
ceSuperParams (Super { superParams = ps, ... }) = ps

-- NAMED, NOT A WILDCARD — same convention, same reason, as `ceRowOriginTag`
-- above; see its comment. Both eliminator arms are pinned in
-- `tc_originun_allowed` alongside `ceRowOriginTag`'s.
ceSuperOrigin : Super -> String
ceSuperOrigin (Super { superOrigin = (OriginModule m), ... }) = m
ceSuperOrigin (Super { superOrigin = OriginBuiltin, ... }) = "<builtin>"
ceSuperOrigin (Super { superOrigin = OriginUnresolved, ... }) = "<unresolved>"

ceRowSuperParamsAt : String -> Int -> ClassEnv -> List String
ceRowSuperParamsAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => []
  Some r => flatMap ceSuperParams (ceRowSupers r)

ceRowSuperOriginAt : String -> Int -> ClassEnv -> String
ceRowSuperOriginAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => ""
  Some r => match ceRowSupers r
    [] => ""
    s::_ => ceSuperOrigin s

ceRowIfaceNameAt : String -> Int -> ClassEnv -> String
ceRowIfaceNameAt m cur env = match ceLookupAt (ceProbeKey m) cur env
  None => ""
  Some r => (ceRowIface r).irName

-- One row's param-kind signature, rendered through `kindName` (the EXISTING
-- `Kind -> String` total function, `:1904` — reused rather than shadowed by a
-- doctest-only shortener) — takes a bare `RegKey` + ordinal rather than a
-- module id, so it serves both the `ceProbeEnv` corpus below (via `ceProbeKey`)
-- and the graded/ungraded fixtures further down, whose identities are minted
-- directly rather than through `ceProbeKey`.
ceRowParamKindNamesAt : RegKey -> Int -> ClassEnv -> List (List String)
ceRowParamKindNamesAt key cur env = match ceLookupAt key cur env
  None => []
  Some r => map (ks => map kindName ks) (ceRowParamKinds r)

-- 1. WHOLE-GRAPH POPULATION: two rows, build order.
-- > listLen ceProbeEnv.ceRows
-- 2

-- 1b. ROW ORDER, asserted directly — not merely implied by the identity-keyed
--     lookups below.  Mirrors `IE`'s own row-order doctest
--     (`map (r => instRefMid (ieRowInst r)) ieProbeEnv.ieRows`), which this
--     unit's corpus otherwise mirrors everywhere except here.  Deleting
--     `classEnvFinish`'s `reverseL` leaves every OTHER doctest in this block
--     green (they all look up by identity, never by position) and is caught
--     ONLY by this one.
-- > map ceRowOriginTag ceProbeEnv.ceRows
-- ["amod", "zmod"]

-- 2. THE INTERFACE HALF IS A SCOPE — amod's identity-keyed lookup returns
--    amod's OWN row (method "foo"), never zmod's (method "bar").  Under a
--    bare-name key this would read ["bar"] for BOTH modules, since zmod is
--    registered last.
-- > ceRowMethodNamesAt "amod" 1 ceProbeEnv
-- ["foo"]
-- > ceRowMethodNamesAt "zmod" 1 ceProbeEnv
-- ["bar"]

-- 2b. THE RAW `Ty` ITSELF, not just the method's name — the content Step 0
--     is about.  `foo : a -> Int`, `bar : a -> String`; a mutation that
--     replaced either with a bogus constant type is caught here, not by the
--     name-only assertions above.
-- > ceRowMethodTysAt "amod" 1 ceProbeEnv
-- ["a -> Int"]
-- > ceRowMethodTysAt "zmod" 1 ceProbeEnv
-- ["a -> String"]

-- 3. TABLE SCOPE — the ordinal, applied through `declEnvVisibleAt` and
--    nothing else.  At ordinal 0 only amod is visible; zmod's row (declared
--    at ordinal 1) is not yet in scope.  ⚠️ This said "the filter A-3.6 deletes".
--    A-3.6 (#1558) did not delete it: `CE` kept its ordinal filter when the
--    predicate split, so these two lines are a LIVE assertion of a live rule, not
--    a countdown.  The `IE` block's item 3 asserts the OPPOSITE property for the
--    same shape — that is the split, visible as two doctests that disagree on
--    purpose.
-- > ceRowMethodNamesAt "zmod" 0 ceProbeEnv
-- []
-- > ceRowMethodNamesAt "zmod" 1 ceProbeEnv
-- ["bar"]

-- 4. TYPARAMS and SUPERS are carried unelaborated, per-row, per-module (not
--    shared or collapsed either) — `superParams`/`superOrigin` too, not only
--    `superHead`: `ceSuperEq`'s params are `["a"]` and its origin is the
--    PRELUDE (`OriginModule "core"`), both distinct from the enclosing
--    interface's own module — a mutation that garbled either would not be
--    caught by `ceRowSuperHeadsAt` alone.
-- > ceRowTyparamsAt "amod" 1 ceProbeEnv
-- ["a"]
-- > ceRowSuperHeadsAt "zmod" 1 ceProbeEnv
-- ["Eq"]
-- > ceRowSuperParamsAt "zmod" 1 ceProbeEnv
-- ["a"]
-- > ceRowSuperOriginAt "zmod" 1 ceProbeEnv
-- "core"
-- > ceRowIfaceNameAt "zmod" 1 ceProbeEnv
-- "Same"

-- ── a graded fixture: KRow inference must match `ifaceParamKindsOf` ──────────
-- `run : f e a -> <e> a` — typaram `f`'s slot-0 argument is the bare tyvar
-- `e`, which the SAME signature's return type also uses in an effect-tail
-- position (`<e> a`), so slot 0 must infer `KRow` and slot 1 (`a`, never a
-- tail) must infer `KType`.  Until #1557 A-3.5c this asserted agreement with the
-- live `universeIfaceParamKinds` table; that table is retired and `ceParamKinds` IS
-- the answer now, so these doctests grade the production computation directly.
ceGradedMethod : IfaceMethod
ceGradedMethod =
  IfaceMethod
    "run"
    (TyFun
      (TyApp (TyApp (TyVar "f") (TyVar "e")) (TyVar "a"))
      (TyEffect [] (Some "e") (TyVar "a")))
    None

ceGradedIface : Decl
ceGradedIface = DInterface {
  pub = True,
  def = False,
  name = "Async",
  typarams = ["f"],
  supers = [],
  methods = [ceGradedMethod],
  ifaceOrigin = OriginModule "gmod",
}

ceGradedEnv : ClassEnv
ceGradedEnv = buildClassEnv [declEnvModule 0 "gmod" [ceGradedIface]]

ceGradedKey : RegKey
ceGradedKey = regKeyOfTab (ifaceTabKey (OriginModule "gmod") "Async")

-- 5. GRADED KIND INFERENCE, positional with `ceTyparams` (here `["f"]`):
--    slot 0 (f's first argument, `e`) is `KRow`; slot 1 (`a`) is `KType`.
-- > ceRowParamKindNamesAt ceGradedKey 0 ceGradedEnv
-- [["Row", "Type"]]

-- ── an UNGRADED fixture: every slot is still RECORDED ("EVERY slot is recorded,
-- graded or not" — the retired writer's rule, which `ceParamKinds` keeps because
-- `checkGradedImplTys`' `anyKRow` guard, not the table, is what filters).  ⚠️ #1557
-- A-3.5c makes this fixture LOAD-BEARING rather than descriptive: `ceParamKinds` is
-- now the production answer, so dropping non-`KRow` rows would shift every later
-- slot's index and mis-judge a graded impl head.  `fmap : f a -> f a` applies `f` but never puts its argument in an
-- effect-tail position anywhere in the signature, so slot 0 must infer
-- `KType`, not be DROPPED from the row.  This is the fixture the reviewer's
-- mutation (b) — deleting non-`KRow` rows from `ceParamKinds` — needs to be
-- caught by: that mutation leaves the graded doctest above untouched (its one
-- slot IS `KRow`) and is invisible without a fixture whose only slot is NOT.
ceFunctorMethod : IfaceMethod
ceFunctorMethod =
  IfaceMethod
    "fmap"
    (TyFun (TyApp (TyVar "f") (TyVar "a")) (TyApp (TyVar "f") (TyVar "a")))
    None

ceFunctorIface : Decl
ceFunctorIface = DInterface {
  pub = True,
  def = False,
  name = "Functor",
  typarams = ["f"],
  supers = [],
  methods = [ceFunctorMethod],
  ifaceOrigin = OriginModule "fmod",
}

ceFunctorEnv : ClassEnv
ceFunctorEnv = buildClassEnv [declEnvModule 0 "fmod" [ceFunctorIface]]

ceFunctorKey : RegKey
ceFunctorKey = regKeyOfTab (ifaceTabKey (OriginModule "fmod") "Functor")

-- 6. UNGRADED KIND INFERENCE: `f`'s one applied slot is `KType`, present and
--    correct — not dropped, not defaulted to empty.
-- > ceRowParamKindNamesAt ceFunctorKey 0 ceFunctorEnv
-- [["Type"]]

-- 🚨 THE BLANK LINE ABOVE IS LOAD-BEARING — DO NOT CLOSE THE GAP.  Same trap
-- A-3.2a's own banner documents: a doctest's expected output runs to the end
-- of the contiguous comment run, so without this blank line the CE-BLOCK-END
-- banner is absorbed into the ungraded-kind doctest's expected value and it
-- FAILS with `expected == actual` plus the banner spliced in.  MEASURED on
-- this branch while writing this unit — not a borrowed warning.
-- ── #1519 A-3.3: CE-BLOCK-END ─────────────────────────────────────────────────

-- #158 PR5 / #176 closure: the ~18 RESIDUAL survivor Refs — governed until now by
-- per-ref prose and clustered in NEITHER `resetState` (PerRun/Toggles) NOR
-- `resetCrossModuleState` (CrossRun).  They have HETEROGENEOUS lifecycles
-- (driver-set-once preamble state like `effectDomains`/`mainSchemeRef`; module-path
-- scratch set fresh per module like `standaloneValuesRef`/`methodDispatchIdxByIdRef`;
-- group-scoped state reset before each check group like `matchOracle`/`matchWarnings`),
-- so there is NO single `freshDriverState` reset point: `freshDriverState` is the
-- INITIAL construction only, and every field is (re)written at its OWN current site,
-- exactly as before.  Re-homing them here does NOT change any write/reset timing — it
-- makes the #143/#144-style silent clobber STRUCTURALLY VISIBLE: a residual survivor is
-- now a named field on ONE cell (a type fact, not prose), the last piece of #158/#176.
-- A record OF Refs (fields stay `Ref …`): every writer mutates a field-Ref in place, so
-- no whole-record copy is allocated per set.
--
-- ⚠️ NO TRAILING `--` COMMENT ON ANY FIELD BELOW (#829/[T-PERRUN-COMMENTS] corrupts
-- this header shape) — field prose lives on the reader, e.g. `dispatchIdxScoped`.
data DriverState =
  | DriverState {
      effectDomains : Ref (List (String, Param)),
      graphMethodExportsRef : Ref (OrdMap (List (String, Ident))),
      graphIfaceMethodsRef : Ref (OrdMap (List (String, List String))),
      graphCtorExportsRef : Ref (OrdMap (List (String, String, Ident))),
      declEnvsRef : Ref DeclEnvs,
      abstractRecordTypesRef : Ref (List String),
      argDispatchIdxByIdRef : Ref (List ((IfaceRef, String), Int)),
      dictEligibleRef : Ref (List String),
      dictEligibleSetRef : Ref (OrdMap Unit),
      mangledShadowMapRef : Ref (List (String, String)),
      mangledFunDefsPresentRef : Ref Bool,
      userIfaceNamesRef : Ref (List String),
      coherenceUserDecls : Ref (List Decl),
      superDeclsRef : Ref (List Decl),
      standaloneValuesRef : Ref (List String),
      methodDispatchIdxByIdRef : Ref (List ((IfaceRef, String), Int)),
      matchOracle : Ref Oracle,
      matchWarnings : Ref (List TcDiag),
      promotionHarvestRef : Ref (List String),
      mainSchemeRef : Ref (Option Scheme),
      sigNameSetRef : Ref (OrdMap Unit),
      sigTyMapRef : Ref (OrdMap Ty),
      implInferEnabled : Ref Bool,
    }

-- INITIAL construction only (NOT a per-module reset): each field reproduces its former
-- top-level ref's initial.  The driver/per-module/per-group sites write each field at
-- their own current point afterward, unchanged.
freshDriverState : Unit -> DriverState
freshDriverState _ = DriverState {
  effectDomains = Ref [],
  graphMethodExportsRef = Ref omEmpty,
  graphIfaceMethodsRef = Ref omEmpty,
  graphCtorExportsRef = Ref omEmpty,
  declEnvsRef = Ref emptyDeclEnvs,
  abstractRecordTypesRef = Ref [],
  argDispatchIdxByIdRef = Ref [],
  dictEligibleRef = Ref [],
  dictEligibleSetRef = Ref omEmpty,
  mangledShadowMapRef = Ref [],
  mangledFunDefsPresentRef = Ref False,
  userIfaceNamesRef = Ref [],
  coherenceUserDecls = Ref [],
  superDeclsRef = Ref [],
  standaloneValuesRef = Ref [],
  methodDispatchIdxByIdRef = Ref [],
  matchOracle = Ref (buildOracle []),
  matchWarnings = Ref [],
  promotionHarvestRef = Ref [],
  mainSchemeRef = Ref None,
  sigNameSetRef = Ref omEmpty,
  sigTyMapRef = Ref omEmpty,
  implInferEnabled = Ref False,
}

-- The single module-level cell holding the residual driver/module/group survivors.
driverState : Ref DriverState
driverState = Ref (freshDriverState ())

-- one entry per occurrence of a registered interface method: (iface, typarams,
-- declared method Ty, the occurrence's instantiated mono).  Resolved post-inference.
-- B.10.2c: the 5th element is the `currentLoc` span snapshotted at the RECORD
-- site (during inference, when the ELoc context is live), so the post-HM
-- obligation check (checkImplObligations) can pair a `No impl of …` reject with
-- the offending expression's range — mirror of lib/typecheck.ml capturing
-- `!current_loc` into method_usages / constraint_obligations at record time
-- rather than reading the stale global at the post-HM raise.

-- PERF: the obligation list's length, in O(1).  That list grows with every
-- constrained occurrence in the program and is NEVER trimmed, yet each top-level
-- group brackets its inference with a length-before / length-after pair to recover
-- the obligations IT added (they are consed on the front, so `wWindow` recovers
-- them).  Measuring that length by walking the list was O(N) over an O(N) list once
-- per group — O(N²), and the single hottest symbol in the typecheck stage on a large
-- file.  #841 ports this channel onto `Windowed` (see `implObls` below): `wPush`,
-- `resetState` (whole-PerRun re-mint), and `wRestore` (inferDefaultMethodBody's error
-- rollback) are its only mutators, so the list and its length can no longer drift.

-- The one and only way to add an obligation.  #991: this channel now stores the SAME
-- `UObligation` record the call channel does, with a real `Provenance` and an
-- `OpMethodOcc` projection carrying the (typarams, declared method type, occurrence
-- mono) triple the check-time `dispatchMonosOf` needs (see `OblProjection`).  The
-- pre-#838 5-tuple, and the `implOblToU` bridge that converted it, are gone.
pushPendingObl : IfaceRef -> List String -> Ty -> Mono -> Provenance -> Option Loc -> Unit
pushPendingObl iface typarams mty occ prov loc =
  wPush perRun.value.implObls (mkMethodOccObl iface typarams mty occ prov loc)

-- the mint for an impl-channel obligation.  `pred.args` is EMPTY and must stay so:
-- the dispatch vector is `OpMethodOcc`'s to project, at check time, via `uOblArgs`.
mkMethodOccObl : IfaceRef -> List String -> Ty -> Mono -> Provenance -> Option Loc -> UObligation
mkMethodOccObl iface typarams mty occ prov loc = UObligation {
  pred = Predicate { iface = iface, args = [] },
  originId = 0,
  prov = prov,
  loc = loc,
  oblProj = OpMethodOcc typarams mty occ,
}

-- PLAN.md #11: one entry per source integer literal (ENumLit):
-- (litVar, fref, n, dref).  [litVar] is the literal's fresh Num-obligated type var;
-- [fref] is the node's own Option Float cell; [n] the int value; [dref] is the
-- node's `fromInt`-route cell (filled by resolveSites — the literal is modelled as a
-- `fromInt n` method occurrence).  After defaulting + grounding, the post-HM pass
-- setNumlitFloats decides the runtime rep (mirror of lib/typecheck.ml's
-- set_numlit_floats): litVar ground Float ⇒ fref Some, dref cleared ⇒ ELit (LFloat f);
-- litVar ground Int ⇒ both cleared ⇒ ELit (LInt n); litVar still polymorphic `Num a`
-- (the soundness case — `1` in `inc x = x + 1`) ⇒ dref KEPT (RDictFwd onto the
-- enclosing Num dict) ⇒ dictPass emits `EApp (EMethodAt "fromInt" …) (ELit (LInt n))`.

-- Chunk A (error framing): the union-find root ids of every type var that took
-- part in a unification failure (`typeMismatch`).  Consulted ONLY by
-- `checkUndeterminedObligation` to SUPPRESS a secondary `ambiguous instance`
-- cascade on a var the primary mismatch already explained — never read on the
-- inference path, so a well-typed program (no mismatch) never poisons anything
-- and behaves identically.

-- Chunk D (Num mis-framing): (litVar, loc) for every numeric literal whose var
-- carried a Num obligation — captured at inferNumLit/inferNumLitBare record time
-- while the var is still unbound.  Lets checkOneImplObligation reframe a purely
-- literal Num obligation forced to a concrete non-Num type (`Type mismatch: Int vs
-- T`) while an OPERATOR-sourced one (`x + 1`) keeps `No impl of Num for T`.  Storing
-- the VAR (not just the loc) lets the operator-taint pass below share a root through
-- `normalize`, so `1 + x` and `x + 1` are both recognised as operator-sourced
-- regardless of unify direction.  Error-path only; reset per run.

-- PERF: the literals that are NOT YET operator-tainted.  `markNumlitOpTaint` scans
-- THIS instead of the full `numlitVarLocs` (which is never trimmed).  Sound because
-- tainting is idempotent: it appends a loc to `numlitOpLocs`, whose only reader
-- (`numlitReframeLoc`) does a membership test — so re-tainting an already-tainted
-- literal cannot change any outcome, and a tainted literal may leave the worklist.
-- Scanning EVERY literal ever recorded on EVERY arithmetic operand was O(N²), and
-- after the allocation fix (see `rootIdOf`) it was still the typecheck stage's
-- dominant remaining cost on a large file.
--
-- `numlitVarLocs` itself keeps every literal — `numlitReframeLoc` and
-- `tagLitLocsWithRoot` both still need the complete list.

-- Chunk D: locs of literals whose var was ALSO an operand of an arithmetic op
-- (recordIfaceObligation).  Such a literal keeps the Num message — the operator is the
-- real culprit — so the reframe skips it (it reframes `litLocs \ opLocs`).

-- Chunk D: (literalLoc, contextKind) recorded when inferIf / inferListLit / consOp
-- is about to force a still-unbound literal var against a concrete sibling type —
-- lets the reframe pick site-specific wording (if-branches / list elements / cons
-- head-vs-element) over the bare `Type mismatch: Int vs T`.

-- LSP hover: every local binding (let-bound name, lambda param, function-clause
-- param, match-arm binder) flows through inferPat's PVar/PAs arms.  Capture
-- (name, mono var) here so hover can render a *local* variable's inferred type:
-- `checkProgramSchemes` only returns top-level + global schemes, so without this
-- a hover over e.g. a `let input = …` name finds nothing and returns null.  The
-- mono var is union-find-solved by the time inference ends; checkProgramSeeded
-- then generalizes each into `localSchemesOut`, which the LSP reads as a hover
-- fallback.  This side-channel does NOT enter the returned env, so completion and
-- inlay-hint output (which consume the env directly) are unaffected.

-- Hover side-channel for the SEED (runtime.mdk externs: putStrLn, readLine, …).
-- checkProgramSeeded keeps the seed in scope for inference but excludes it from
-- the returned env (see its comment), so externs aren't otherwise hoverable.

-- Getters for the LSP (cross-module).  The raw Refs are nullary value globals
-- (@mdk_g_), which the import-aware mangling map doesn't carry, so expose them
-- through functions — the form every other tools→typecheck import already uses.
export
currentLocalSchemes : Unit -> List (String, Scheme)
currentLocalSchemes _ = perRun.value.localSchemesOut.value

export
currentSeedSchemes : Unit -> List (String, Scheme)
currentSeedSchemes _ = perRun.value.seedSchemesOut.value

recordLocalBind : String -> Mono -> Unit
recordLocalBind name v =
  perRun.value.localBindRefs := (name, v)::perRun.value.localBindRefs.value

-- dict-passing state (the typed pipeline's `=>`-constraint layer):
--   activeDictVars   : constraint tyvar id → the dict parameter name a method
--                      occurrence at that variable's type reads (RDict).
--   funConstraintsRef: constrained fn name → its constraints' quantified tyvar
--                      ids (one per `=>` constraint, in slot order) — a call site
--                      maps each to its fresh instantiation var to pick a route.
--   pendingDictApps  : a constrained-fn occurrence's routes ref + the instantiated
--                      constraint monos, resolved to RKey/RDict after inference.

-- WS-1b: the program decls (interfaces) the supers-expansion reads.  Set by each
-- driver (elaborateDict / the module path) BEFORE inference; read by inferDictAtFound
-- to expand a call site's constraint slots with their transitive supers.  Read-only
-- during inference, so it needs no reset-lifecycle care.

-- WS-1b: the USER-module interface names (NOT core/prelude).  Super-expansion is
-- gated to user interfaces only: a prelude super chain (Ord requires Eq) is already
-- serviced by arg-tag dispatch and is NOT dict-passed on the eval path, so adding an
-- Eq slot to `clamp : Ord a =>` would desync its def arity from its arg-tag call sites
-- (the prior-attempt clamp regression).  User interfaces (Sub requires Sup) ARE
-- dict-passed and need the super slot.  Set by elaborateModules.

-- #11 soundness (native obligation hole): the INTERFACE names of a constrained
-- fn's `=>` constraints, slot-parallel to funConstraintsRef's ids.  funConstraintsRef
-- keeps only the tyvar ids (enough to pick a dict route); but to record a real impl
-- obligation when a constrained fn is INSTANTIATED at a concrete type (`g = f "hello"`
-- where `f : Num a => a -> a`), the call site needs the iface ("Num") so it can check
-- `Num String` against the impl table.  Mirrors lib/typecheck.ml's fun_constraints
-- carrying the iface name into check_constraint_obligations.  Populated at the SAME
-- three sites as funConstraintsRef (registerMember / registerInferredFor /
-- seedDictAritiesFromSigs), with the SAME cross-module accumulate+reseed lifecycle.

-- a constrained-fn CALL site's instantiated constraint obligations: (iface, the
-- call's instantiated constraint mono).  Resolved after inference (when the mono is
-- ground) by checkCallObligations — a CONCRETE-head mono with no matching impl is an
-- ERROR; a still-polymorphic head is DEFERRED (left to a further-out caller).  This
-- is the compiler analog of the oracle's constraint_obligations + check_constraint_
-- obligations: pendingDictApps routes the dict, this list checks the impl exists.

-- #841/#838 I1: `Windowed a` — a list+counter pair (formerly kept in step "by
-- convention" across resetState/push/error-rollback, per-channel) as ONE value whose
-- ONLY mutators are its own six ops.  wPush/wReset/wRestore are the sole writers, so
-- the invariant cannot drift; wMark/wWindow replace the `N0 = …N.value` snapshot +
-- `takeFirst (…N.value - N0) …value` bracket pattern every channel repeats.  #838 I1
-- ports `pendingCallObligations`/`pendingCallObligationsN` onto this — see
-- `compiler/types/typecheck.mdk`'s `obls` field below.  #841 ports the remaining two
-- channels, `pendingImplObligations` and `pendingDictApps`, onto it too — see the
-- `implObls`/`dictApps` fields below.
data Windowed a = Windowed { items : Ref (List a), n : Ref Int }

wNew : Unit -> Windowed a
wNew _ = Windowed { items = Ref [], n = Ref 0 }

-- the ONLY reset.  Unused — `freshPerRun` re-mints `obls`/`implObls`/`dictApps` via
-- `wNew` rather than resetting an existing one (per-module reset is a whole-PerRun
-- re-mint here, not a per-field reset), so none of these channels ever needs a
-- reset-in-place.  Kept as part of the `Windowed` API surface for a future channel
-- whose reset lifecycle is narrower than a whole-PerRun re-mint.
wReset : Windowed a -> Unit
-- lint-disable-next-line rule-dead-code
wReset w =
  w.items := []
  w.n := 0

-- the ONLY extend.
wPush : Windowed a -> a -> Unit
wPush w x =
  w.items := x :: !w.items
  w.n := !w.n + 1

-- O(1) length snapshot, replacing a channel's `…N.value` read.
wMark : Windowed a -> Int
wMark w = !w.n

-- recover exactly the items pushed since [mark] (consed on the front, so
-- `takeFirst` recovers them in push order).
wWindow : Windowed a -> Int -> List a
wWindow w mark = takeFirst (!w.n - mark) !w.items

-- for an error-rollback window (inferUserImplBodies): capture both refs together.
wSnapshot : Windowed a -> (List a, Int)
wSnapshot w = (!w.items, !w.n)

-- the ONLY rollback.
wRestore : Windowed a -> (List a, Int) -> Unit
wRestore w snap =
  w.items := fst snap
  w.n := snd snap

-- #1114: re-push a list of items in order, for a GROUND-PRESERVING rollback (DICT
-- §4.2 D6(b)) — `wRestore` to the snapshot, then `wPushAll` the subset the policy
-- keeps.  Monomorphic recursion, not a fold over a prelude method: this runs inside
-- the per-module inference path (compiler/AGENTS.md's hot-helper rule).
wPushAll : Windowed a -> List a -> Unit
wPushAll _ [] = ()
wPushAll w (x::rest) =
  let _ = wPush w x
  wPushAll w rest

-- #838 I1 (DESIGN.md §2.2): the unified obligation record.  `pred.args` is the
-- ALREADY-PROJECTED dispatch/argument vector — exactly the call channel's existing
-- shape (contrast the impl channel's un-projected method type, out of scope this
-- increment).  `originId` is the #837 binding id of the binding this obligation was
-- DEFERRED BY (0 = anchorless/local/cross-module, mirroring incr1's id-0 fallback);
-- populated now so a later increment does not re-key every record (#838 §2.2).
-- `prov` is documentary in I1 — the checker below does not yet branch on it (that is
-- I2's uniform-deferral work); it is carried now so I2 does not need a second
-- migration to add it.
-- ── P1 (#1446): THE INTERFACE HALF OF AN OBLIGATION IS AN IDENTITY, NOT A NAME ──
-- DICT-SEMANTICS §8 I4: a class is a `(module, name)` pair.  `Predicate.iface` used
-- to be a bare `String`, so the whole entailment/obligation channel could not tell
-- two same-spelled interfaces from different modules apart — an imported, unrelated
-- `Sizer` silently satisfied a locally-declared `Sizer` constraint (#1438: `check`
-- clean, `run` panics, the built binary segfaults at 139).
--
-- `irOrigin` is the `TyConOrigin` of the DECLARATION this occurrence denotes, read
-- off whichever carrier the site already has (`Constraint.constraintOrigin`,
-- `Require.requireOrigin`, `DInterface.ifaceOrigin` via `methodIfaceParamsRef`,
-- `DImpl.implOrigin`).  `irName` is kept ALONGSIDE it, not derived from it: every
-- diagnostic in this channel prints the spelling, and `concreteReqMatchByIface`
-- still asks the SPELLING-keyed `KeyBuckets` registry a route-word question that
-- must NOT become an identity question (#1317 T1 / the closed S0 #1277 — see
-- `dispHeadTab`).  One value carrying both halves is what keeps those two questions
-- from drifting apart.
--
-- 🚨 `OriginUnresolved` IS A LEGAL INHABITANT AND MUST STAY ONE.  A flat user
-- module's own interface is unstamped on BOTH sides (its `interface` decl and its
-- `impl` alike), so it keys `TkBare`/`TkBare` symmetrically and is unaffected by the
-- re-key — that symmetry is why this change is not a mass false-reject.  A TOTAL
-- identity would require #1115 (E-1) to land first, and `stampTyHead`'s immunity
-- rule makes an invented one PERMANENT.  `tabKeyOf`'s `None => TkBare` arm and
-- `tabKeyEq`'s refusal to equate `TkBare` with `TkIdent` are the representation
-- built for exactly this.
public export data IfaceRef = IfaceRef {
    irName : String,  -- the SPELLING; still needed for diagnostics and for the spelling-keyed KeyBuckets question
    irOrigin : TyConOrigin,  -- the I4 identity of the declaration this occurrence denotes
  }

-- an interface occurrence whose identity is not (yet) recoverable at the site.
--
-- ⚠️ U1b (#1482) RETIRED the two sites this comment used to name.
-- `recordCallObligations` and `recordSchemeCallObligations` now carry an `IfaceRef`
-- end to end (`funConstraintIfacesRef`'s payload is `List IfaceRef`,
-- `schemeObligationsRef`'s is `List VecObl`), so neither mints a bare goal any more.
-- What is LEFT — grep this name for the live worklist, do not trust this list:
--   * `recordImplObligation`'s METHOD-OCCURRENCE goal, which is a decl-layer /
--     occurrence-layer reconciliation and not a table widening.  Owned by #1507, and
--     it is the LAST condition on deleting the bare compatibility leg;
--   * `ifaceForInferredId`'s third fallback, which recovers a slot's interface from
--     `pendingDictApps` — a SPELLING-keyed routing channel (see `resolveDictApps` /
--     `dispHeadTab`) whose iface component must stay a route word, so the recovery is
--     bare by construction rather than by omission.
ifaceRefBare : String -> IfaceRef
ifaceRefBare n = IfaceRef { irName = n, irOrigin = OriginUnresolved }

-- U1b (#1482): the ABSENT-interface sentinel for the slot-parallel iface channels.
-- `funConstraintIfacesRef` has always used `""` to mean "this slot has no recoverable
-- interface" (see `ifaceForInferredId`), and every reader tests it and skips.  It is
-- deliberately NOT spelled `ifaceRefBare ""`: that name is the residual worklist for a
-- goal whose identity is UNRECOVERABLE, and "no interface at all" is a different fact
-- that must not pollute the grep.
ifaceRefNone : IfaceRef
ifaceRefNone = IfaceRef { irName = "", irOrigin = OriginUnresolved }

-- U1b (#1482): ONE vector obligation — one interface OCCURRENCE (identity-carrying,
-- #1446 P1) applied to one vector of scheme-quantified tyvar ids.  This is the payload
-- of `schemeObligationsRef` and of its three cross-module mirrors.
--
-- ⚠️ The point of the record is not ergonomics.  Before it, this payload was
-- `(String, List Int)` — the SAME shape as `funConstraintsRef`'s `(fn name, slot ids)`
-- entries, 58 lines of the file apart, with nothing but a convention keeping the two
-- meanings from being passed to each other's readers.  Widening the interface half to
-- `IfaceRef` removes M1 from that shape, which leaves the fn-name meaning as its only
-- inhabitant: a cross-family mixup is now an ordinary type error in the compiler's own
-- typechecker, defended by `make check-self` / `typecheck_compiler_source.sh` rather
-- than by care.  The widening IS the disambiguation.
--
-- #1161 (S-obligation-nary-payload): [voArgs] is the predicate's WHOLE argument
-- vector as monos, at the recording site's instantiation — the `Predicate.args`
-- shape, carried here so a predicate with a GROUND argument (`Ix a Bool =>`)
-- survives the channel at all.  `[]` means "no vector was recoverable", exactly
-- the convention `zipSlotArgs`/`enclPreds` already use for the slot channel, and
-- it reproduces the pre-widening ids-only behaviour byte for byte.
--
-- ⚠️ [voIds] IS NOT REDUNDANT WITH IT, AND MUST NOT BE DERIVED FROM IT.  Two
-- producers have only an id (`vecOblsOfSlots` lifts a `CSlot`, whose payload is
-- `csId : Int`; `superSlotVecOf` maps typaram names positionally onto ids), and a
-- `Mono` is a `Ref Tyvar` that cannot be minted from an id.  [voIds] also remains
-- the currency of the dict-slot cardinality (`leadInferredPred`) and of the coverage
-- subset test (`pairsOfVecObls`), neither of which has anything to say about a
-- ground argument.  When [voArgs] is non-empty, [voIds] holds the ids of exactly
-- its BARE-TYVAR positions, in order.
data VecObl =
  | VecObl { voIface : IfaceRef, voIds : List Int, voArgs : List Mono }

-- U1b (#1482): ONE dict slot of a constrained callee — the interface the slot
-- discharges, paired with the scheme-var id it is keyed on.
--
-- ⚠️ This exists so that NO consumer of a callee's constraint slots ever holds two
-- parallel lists again.  `qualConstraintFor` used to return `(List Int, List String)`
-- built from two INDEPENDENT table lookups each defaulting to `[]` — a hit on the ids
-- table with a miss on the ifaces table produced a length mismatch BY CONSTRUCTION, not
-- by corruption, which the downstream zips then silently truncated away.  `pairSlots`
-- is now the single place an id list meets an iface list, and the mismatch policy lives
-- there, once.
data CSlot = CSlot { csIface : IfaceRef, csId : Int }

-- B-2.2-f (#1113): how many of a constrained callee's slots were PRESENT BEFORE
-- `expandSupersPairs`' transitive super expansion APPENDED any.
-- ⚠️ THAT WORDING IS THE CORRECTION, and the direction of the old one matters.  This
-- comment used to say "DECLARED by its own `=>` context", which is FALSE on a live
-- path: `setFunConstraintEntry`'s second caller mints slots from INFERRED constraint
-- ids, with no `=>` context anywhere, and those are recorded as `CDPLen` too.  The
-- BEHAVIOUR is right — the operative property is "not appended by
-- `expandSupersPairs`", and an inferred slot is not appended — but a reader taking the
-- old definition literally would conclude the inferred path OVER-records and "fix" it
-- by lowering the count, withholding identity from real slots.  Do not.
-- Carried per ENTRY, beside the ids table (never inside `CSlot`) — the
-- recursive-call arm (`realizeRecDictApps` -> `recRoutes` -> `resolveRecMono`) reads
-- `funConstraintsRef` as a bare `List Int` and constructs no `CSlot` at all, so a
-- per-slot field could not serve it.
--
-- ⚠️ TWO-VALUED ON PURPOSE.  Absence is NOT `0` and NOT `Option Int`:
--   * `0` is a genuinely RECORDED state (`registerMember` guards on the constraint
--     list, not on the surviving slots, so an entry with zero declared slots is real),
--     so spelling absence `0` makes the two indistinguishable;
--   * `Option Int` collapses at the read site through one invisible `fromOption 0`
--     (99 uses of `fromOption` in `compiler/`), which is exactly the erasure this
--     distinction exists to survive.
-- `CDPUnknown` has no prelude eliminator and the token exists nowhere else in the
-- tree, so "is any site collapsing absence into a length?" is one grep.
--
-- 🚨 FAIL-CLOSED: `CDPUnknown` means WITHHOLD identity (behaves as prefix 0).  The
-- opposite default stamps identity onto APPENDED super slots, which is the defect this
-- sidecar exists to prevent.
data CDeclaredPrefix = CDPUnknown | CDPLen Int

-- B-2.2-f (#1113): the result of the ONE declared-slot resolution.  The slots and the
-- declared prefix must come from the SAME entry decision (qual hit / known-import miss
-- / bare fallback) — a second accessor re-deriving that choice is the drift
-- `qualConstraintKey` was factored out to remove.  See `declaredConstraintFor`.
--
-- S-xmod-vector-supply (#1868/#1867): [cdArgs] joins the SAME entry decision for the
-- same reason.  It is the callee's slot-parallel predicate ARGUMENT VECTORS — a
-- legitimate PREFIX of [cdSlots], never a parallel list a reader must re-align (a slot
-- past its end reads `[]`, i.e. "no vector recoverable", via `zipSlotVecs`).  Resolving
-- it through a SECOND `qualConstraintKey` call was the available alternative and is
-- exactly the drift this record exists to prevent: the vectors and the slots they
-- describe would then be free to come from different modules' entries.
data CDeclared =
  | CDeclared {
      cdSlots : List CSlot,
      cdPrefix : CDeclaredPrefix,
      cdArgs : List (List Mono),
    }

-- FIX-shadow-arity-skew: the shadow route's expanded dict slots, the SAME three
-- slot-parallel projections `inferDictAtFound` hands `pushDictApp` — monos, route WORDS
-- (iface spellings), and each slot's call-instantiated predicate ARGUMENT VECTOR.  The
-- vectors were the residual `declaredConstraintArgs`' header named as "STILL LIVE, same
-- shape": `SKRLocal` carried only the first two, so `resolveRLocalSites` selected every
-- shadow-route slot with the SCALAR `routesOfMonosTop` goal and a multi-argument
-- predicate shattered into `Ix Int _`, first-declared-wins.  They travel as ONE record
-- for the reason `CDeclared` does: three parallel lists a reader must re-align is the
-- hazard `CSlot` was introduced to remove, and `callArgVecsV` only guarantees
-- slot-parallelism with the `constraintMonosOf` output computed from the same expansion.
-- [sdArgVecs] empty ⇒ `routesOfMonosTopV` IS `routesOfMonosTop`, term for term.
data ShadowDicts =
  | ShadowDicts {
      sdMonos : List Mono,
      sdIfaces : List String,
      sdArgVecs : List (List Mono),
    }

-- the empty shadow-dict stamp: an unconstrained standalone, or a route that resolves to
-- nothing.  Byte-identical to the `([], [])` this returned before the vectors joined it.
emptyShadowDicts : ShadowDicts
emptyShadowDicts = ShadowDicts { sdMonos = [], sdIfaces = [], sdArgVecs = [] }

-- THE pairing point — the only place in the tree where a slot-id list meets a
-- slot-parallel interface list.
--
-- ⚠️ POLICY: truncate, exactly as the three zips it replaces did
-- (`shatterVecObls`, `recordCallObligations`, `expandSupersEntry`'s `zipL`).  This is
-- BEHAVIOUR, not tidiness: per the paragraph on `CSlot` a real mismatch is reachable,
-- and today's answer is "drop the unpaired tail, never over-reject".  Diagnosing
-- instead is only safe once someone has MEASURED that no real program reaches a
-- mismatch (an instrumented build over the compiler's own source + `stdlib/`); until
-- then the default is byte-identical truncation, and changing it is a separate,
-- evidence-bearing change.
pairSlots : List Int -> List IfaceRef -> List CSlot
pairSlots [] _ = []
pairSlots _ [] = []
pairSlots (id::ids) (iface::ifs) =
  CSlot { csIface = iface, csId = id } :: pairSlots ids ifs

data Predicate = Predicate { iface : IfaceRef, args : List Mono }

-- #991: every arm below is now LIVE — stamped by the producer that records the
-- obligation, on the ONE storage shape (`UObligation`).  The three arms that read
-- "impl channel, not yet ported" until #991 were dead because that channel stored a
-- bare 5-tuple with no provenance slot at all; it does not any more (see
-- `OblProjection`).  `prov` is still documentary — no checker branches on it (§2.3(a));
-- it is stamped so the I2 uniform-deferral work does not need a second migration.
data Provenance =
  -- +,-,*,/,%, ==,/=,<,>,<=,>=, ++, unary -  (recordIfaceObligation)
  | POperator
  -- a numeric literal's Num obligation  (inferNumLitBare)
  | PNumLit
  -- a registered interface-method occurrence  (recordImplObligation)
  | PMethodOcc
  -- a constrained-fn call's shattered dict slot / signature constraint occurrence
  | PCallSlot
  -- re-instantiation of a binding's deferred predicate (schemeObligationsRef)
  | PSchemeReinst
  -- a method-level `=>` constraint slot  (#818, I3)
  | PMethodLevel

-- ── #991: HOW an obligation's DISPATCH VECTOR is obtained ────────────────────────
-- The call channel projects its vector at RECORD time (the producer already has the
-- instantiated monos).  The impl channel CANNOT: `recordImplObligation` records a
-- method OCCURRENCE mono against the method's DECLARED type, and the projection
-- `dispatchMonosOf typarams mty occ` is only meaningful once inference has grounded
-- the shared cells — `groundMultiParamObligations` runs over this very channel
-- immediately before the check and unifies through them.  Projecting at record time
-- would therefore read a vector that is empty or under-determined.
--
-- 🚨 THIS IS THE FACT #991'S BODY DID NOT HAVE.  It predicted "byte-identical target:
-- checker semantics are already unified, this changes only the record shape" and
-- proposed dropping the tuple onto `UObligation` outright.  A straight port would have
-- moved a CHECK-time projection to RECORD time — a semantics change, not a shape
-- change.  Carrying the deferral as an explicit arm keeps the projection where it was
-- (`uOblArgs`, called by the checker) while still giving both channels ONE record.
--
-- ⚠️ `pred.args` IS EMPTY on an `OpMethodOcc` obligation, and reading it directly is
-- the one way to get a wrong answer here.  `uOblArgs` is the ONLY legal reader of an
-- obligation's dispatch vector; it is total over both arms.  (An empty vector is inert
-- at the gate — `checkOneCallObligation` returns on `isEmptyL args` — so a stray direct
-- read would be SILENT, which is why there is a single accessor rather than a rule.)
data OblProjection = OpProjected | OpMethodOcc (List String) Ty Mono

data UObligation =
  | UObligation {
      pred : Predicate,
      originId : Int,
      prov : Provenance,
      loc : Option Loc,
      oblProj : OblProjection,
    }

-- #839 increment 2a: the absorption event trail (write-only in 2a — no consumer
-- yet; the post-unify launder/rigidity QUERIES land in 2b/2c).  When unifyRowN's
-- SAME-TAIL arm DISCARDS a prefix mismatch, or its BOTH-OPEN arm ABSORBS each
-- side's atoms into a shared fresh tail (see that fn's per-arm audit), it appends
-- one event per atom so a post-unify query can recover what a post-hoc cell
-- inspection cannot (effrowLabels resolves THROUGH the merged tail).  CRUX: store
-- the absorbing tail CELL, not its `effvarId` — the id goes to -1 the instant the
-- cell ELinks (effvarId's ELink arm), so an id snapshotted here is stale by query
-- time.  The 2b/2c consumer normalizes the cell live via effrowNorm / the
-- effVarTailIds idiom.  Mirrors the `obls`/Windowed channel (per-body-windowed by
-- the existing wMark/wWindow brackets — NOT a flat log; #838-I2 over-defer trap).
data AbsorptionEvent = AbsorptionEvent {
    atom : Atom,  -- the concrete atom absorbed (both-open) / discarded (same-tail)
    cell : Ref Effvar,  -- the ABSORBING tail: v3 (both-open) / v1 (same-tail).  Resolve LIVE at query time.
    loc : Option Loc,  -- currentLoc at the unify, for the diagnostic seam (None-safe)
  }

-- The single recorder for the (now-ported) call channel: every producer becomes a
-- thin caller stamping its own provenance.
recordObl : Predicate -> Int -> Provenance -> Option Loc -> Unit
recordObl p originId prov loc = wPush
  perRun.value.obls
  UObligation {
    pred = p,
    originId = originId,
    prov = prov,
    loc = loc,
    oblProj = OpProjected,
  }

-- #839 increment 2a: append one AbsorptionEvent per absorbed/discarded atom onto
-- the (write-only in 2a) trail, keyed on the surviving/absorbing tail [cell].
-- Recursive + []-short-circuits so the hot self-unify path (empty prefixes ⇒
-- empty diff) pushes NOTHING and allocates nothing.  Records the cell Ref, not
-- effvarId (see AbsorptionEvent), and snapshots the ambient currentLoc.
recordAbsorptions : List Atom -> Ref Effvar -> Unit
recordAbsorptions [] _ = ()
recordAbsorptions (a::rest) cell =
  let _ = wPush perRun.value.absorptions AbsorptionEvent {
    atom = a,
    cell = cell,
    loc = !currentLoc,
  }
  recordAbsorptions rest cell

-- #838 I1: project a ported UObligation back to the pre-#838 tuple shape
-- `(iface, argument vector, loc)`, for the many downstream consumers
-- (registerLocalScheme/registerSchemeObligations/checkSigConstraintCoverage/
-- checkDefaultMethodRigidity/checkImplMethodRigidity/numCallObls/…) that stay on the
-- old shape this increment — only the storage + its own checker move in I1 (#838 §5.2).
-- ⚠️ U1b (#1482): this used to project the interface back to its bare SPELLING, on
-- the stated ground that every consumer feeds `schemeObligationsRef` /
-- `funConstraintIfacesRef`, which were bare-name-keyed.  They are not any more, and
-- `forwardedVecObls` — an UNSIGNED constrained forwarder's whole scheme context —
-- reaches `schemeObligationsRef` through exactly this tuple.  Keeping the projection
-- would have left that one path minting bare goals inside a channel the rest of which
-- carries identity.  Consumers that ask a SPELLING question (`numCallObls`'s `"Num"`
-- test, the survivor-obligation diagnostics) read `.irName` at their own site.
oblAsTuple : UObligation -> (IfaceRef, List Mono, Option Loc)
oblAsTuple o = (o.pred.iface, uOblArgs o, o.loc)

-- THE ONLY legal reader of an obligation's dispatch vector — total over both
-- `OblProjection` arms.  See `OblProjection` for why the impl channel's projection
-- cannot be hoisted to record time.
uOblArgs : UObligation -> List Mono
uOblArgs o = match o.oblProj
  OpProjected => o.pred.args
  OpMethodOcc typarams mty occ => dispatchMonosOf typarams mty occ

-- the call channel's window, in the pre-#838 tuple shape (see oblAsTuple).
callOblsWindow : Int -> List (IfaceRef, List Mono, Option Loc)
callOblsWindow mark = map oblAsTuple (wWindow perRun.value.obls mark)

-- #1114 (DICT-SEMANTICS §4.2 D1): would `checkOneCallObligation` reach a VERDICT on this
-- recorded predicate right now?  That — not groundness — is the question the D1-preserving
-- window in `inferUserImplBodies` has to ask, and getting it wrong is silent by
-- construction (see the warning at the end of this comment).
--
-- 🚨 THE GATE'S DECIDABLE SET IS STRICTLY LARGER THAN `allConcreteHeads`.  This predicate
-- was `isNonEmptyL args && allConcreteHeads args` when #1114 first landed, on the stated
-- belief that it was "the SAME test the gate applies".  IT IS NOT, and adversarial review
-- produced the counterexample: `checkOneCallObligation` tests
-- `anyListM monoIsFunction args` in an arm that runs BEFORE its `allConcreteHeads` arm, so
-- a fully concrete FUNCTION-typed obligation (`Debug (Int -> Int)`, from `debug bumper`
-- where `bumper : Int -> Int`) is decided — and rejected — by the gate, while
-- `headTyconNameMono` answers `None` for a `TFun` (it enumerates `TCon`/`TRigid` only) and
-- so `allConcreteHeads` calls it non-concrete.  The window therefore dropped a predicate
-- the gate would have rejected, and D4's impl-channel exemption from D3 meant no ambiguity
-- fired either: the predicate vanished with NO verdict from any channel.  That is #792's
-- own three-verdict signature (`check` 0 / `run` `intToString: not an Int` / `build`
-- `arg-tag dispatch on impl type that owns no constructors`), one token away from the
-- shape #792 pinned.
--
-- The two populations kept here are exactly the ones whose verdict CANNOT CHANGE LATER,
-- which is what makes retaining them sound:
--   (a) `allConcreteHeads` — fully ground; grounding is monotone, a concrete head never
--       becomes abstract.
--   (b) `anyListM monoIsFunction` — a `TFun` argument; an arrow never becomes a non-arrow.
-- (b) is NOT a special case invented here: it is the third instance of a settled
-- convention.  `checkReqOne` already carries the same arm, in the same order, with a
-- comment that states the rule in general terms ("fully GROUND yet structurally
-- un-Ord/Eq/etc … Order the function-typed reject BEFORE the concreteness defer"), and
-- `checkOneCallObligation` is the second.  See `allConcreteHeads` for why the convention
-- is to order an arm rather than widen that predicate.
-- `numUnimplementableHead`'s OTHER arm (a `TApp` whose spine head is an unbound tyvar) is
-- deliberately NOT kept: that head can still bind, so its verdict is not stable and the
-- predicate belongs to D2's deferred population.  An EMPTY argument vector is inert at the
-- gate (`if isEmptyL args then ()`), so dropping it loses no verdict.
--
-- THE SET IS CLOSED, and it was enumerated rather than sampled — `TFun` was found by a
-- counterexample, so the question "what ELSE?" has to be answered from the type.  `Mono`
-- has six constructors and `headMonoNode` peels `TApp`, so a head is one of `TVar`, `TCon`,
-- `TRigid`, `TFun`, `TEff`.  `TCon`/`TRigid` are the two `headTyconNameMono` names, so (a)
-- covers them; `TFun` is (b); `TVar` can still bind, so gate and filter agree to defer it;
-- and `TEff` is decided by NEITHER (`monoIsFunction` and `numUnimplementableHead` are both
-- False for it, so the gate reaches its own `allConcreteHeads` arm and defers) — filter and
-- gate agree there too.  No third population remains.
--
-- ⚠️ NO GATE CAN CATCH A REGRESSION HERE.  A predicate this filter drops is one no channel
-- ever reports, so it produces silence, and silence is what every golden in the corpus
-- already records for a program the compiler accepts.  If you narrow this predicate, the
-- suite stays green.  The obligation is on the reader: any arm added to
-- `checkOneCallObligation` ABOVE its `allConcreteHeads` test must be mirrored here, or it
-- becomes unreachable for every parametric impl body in the language.
uOblIsDecidableNow : UObligation -> Bool
uOblIsDecidableNow o =
  let args = map normalize (uOblArgs o)
  isNonEmptyL args && (allConcreteHeads args || anyListM monoIsFunction args)

-- #11 soundness (native obligation hole, ALWAYS-ON, independent of the dict-
-- elaboration machinery): per top-level binding, the deferred impl obligations it
-- generalizes over — (iface, the quantified-var id the obligation discriminates on).
-- Populated UNCONDITIONALLY at generalization in processSCC/processTopGroups (unlike
-- funConstraintsRef, which the check path leaves empty because its inferred-constraint
-- registration is gated on dictEligibleSetRef).  At a USE site (inferVar) the binding's
-- entry is freshened through the call's instantiation subst and checked against the
-- impl table — the compiler analog of lib/typecheck.ml's inferred_constraints carried
-- on a scheme and re-checked at every instantiation.

-- E6 (module emit path only): funConstraintsRef is wiped by resetState at the start
-- of EACH module's typecheck, but a cross-module `=>`-constrained CALL site (entry
-- calling an imported `clampU`) must still find the callee's generalized constraint
-- ids so inferDictAt records a real pendingDictApp (→ the call gets its dict ARG).
-- This ref ACCUMULATES every module's registered fn-constraints across the graph and
-- is NOT cleared by resetState; checkModuleFullImpl re-seeds funConstraintsRef from
-- it after the per-module reset.  The DEFINING module's entry (real
-- ids, registered first) wins the lookupAssocSL2 first-match.
-- WS-2/D2: module-attributed mirror of crossModuleFunConstraintsRef.  Keyed by
-- (owning module id, fn name) so the FINAL dict-pass (scopeArities) can keep only
-- the inferred-arity entry whose DEFINING module is in the dict-passed module's
-- scope.  Without this, two distinct top-level fns sharing a bare name but with
-- different `=>`-constraint arity (e.g. `wrap : Tag a => …` in module A vs
-- `wrap : (P a, Q a) => …` in module B) both land in the bare cross-module table;
-- scopeArities keeps both (both pass the bare scopeNames membership), and
-- dictArityOf's first-match returns the WRONG module's arity → a call site in A's
-- importer is sized to B's 2 dict params (over-application) → run-path crash while
-- the emit path's arg-stamp recovers (the §1 D2 repro).  Populated per-module in
-- checkModuleFullImpl (each fn DEFINED in this module's `prog` is attributed to mid);
-- consumed by scopeAritiesQual.  The bare crossModuleFunConstraintsRef is KEPT — the
-- per-module reseed at checkModuleFullImpl:7546 needs the bare form for the current
-- module's E6 cross-module call-site discovery.
-- cross-module accumulator for funConstraintIfacesRef, mirroring
-- crossModuleFunConstraintsRef exactly (accumulate across the graph, NOT cleared by
-- resetState, re-seeded after the per-module reset).
-- WS-2/D2 (ifaces analog of crossModuleFunConstraintsQualRef): module-attributed
-- mirror of crossModuleFunConstraintIfacesRef, keyed by (DEFINER module id, fn name),
-- slot-parallel to crossModuleFunConstraintsQualRef.  inferDictAtFound reads the
-- callee's dict ids AND their ifaces from the SAME qualified (definer,name) source so
-- the two stay aligned across a bare-name cross-module collision (a foreign same-named
-- fn of different `=>`-arity must not contribute its ifaces).  Populated/reset in
-- lockstep with the ids qual ref (checkModuleFullImpl / elaborateModules).
-- WS-2/D2: the current module's imported VALUE name → its source module id (the dotted
-- id its `import` form names == the loader mid == the qual tables' DEFINER key for a
-- DIRECT import).  Lets inferDictAtFound resolve a cross-module constrained callee's
-- dict arity by MODULE IDENTITY (the (definer,name)-keyed qual tables) instead of the
-- bare-name first-match over the jointly-seeded funConstraintsRef — which picks the
-- MOST-RECENTLY-PREPENDED same-named entry, i.e. a FOREIGN module's `wrap` when the
-- importer merely imports a different `wrap`.  That bare-name collision is an
-- observable run-crash today (`applied non-function`) on `medaka run` of a direct
-- cross-module import of two same-named, different-`=>`-arity constrained fns, while
-- `check` accepts and `build` is saved by universal mangling.  Set per-module in
-- checkModuleFullImpl from `prog`'s DUse decls; only EXPLICIT imports
-- (UseName/UseGroup/UseAlias) are mapped — a wildcard `import mod.*` can't enumerate
-- names here, and a re-exported fn's import source ≠ its definer, so both fall back to
-- the bare table (correct, byte-identical; the qual path is the fix for the common
-- direct-import case).  Reset by resetState (per module).

-- WS-1c: the third field is the slot-parallel interface-name list (one per mono),
-- so resolveDictApps can resolve an UNDETERMINED top-level constraint (a constraint
-- tyvar pinned by neither arg nor result) by counting that interface's impls: sole
-- impl → a concrete RKey to it; ≥2 → an AmbiguousImpl error.  Recorded from the same
-- `expanded` (iface, id) pairing inferDictAtFound already builds for recordCallObligations.

-- #1161 (F-3a-ii): the FOURTH field is the slot-parallel GOAL VECTOR list — for each
-- slot, the whole predicate's instantiated argument vector (`Ix a Char` at `a = Int`
-- ⇒ `[Int, Char]`).  Slots 2/3 are unchanged and remain the authority on slot COUNT
-- and ORDER; this field only widens the GOAL each slot's route is selected with, so
-- emitted dict arity is untouched (dictArityOf/dictPass/scopeArities read
-- funConstraintsRef, not this).  A slot with nothing better to offer carries the
-- singleton `[its own mono]`, which reduces the vector path to the scalar one term
-- for term — see routesOfMonosTopV.

-- PERF: this channel's length in O(1) — same O(N²)-per-group length scan the call
-- channel had before #838 I1 ported it onto `Windowed` (see `wMark` above).  #841
-- ports `pendingDictApps` onto `Windowed` too (see `dictApps` below); mutated ONLY
-- by `resetState` and `pushDictApp`.

-- #1155 (F-3c): the 5th element is the `currentLoc` span snapshotted at the RECORD
-- site, the same reason and the same shape as `PendingEntry`'s 6th field and
-- `implObls`' 5th element — `resolveDictApps` runs post-HM, so the live `currentLoc`
-- there is stale.  `resolveDictApps` republishes it into `goalSiteLoc`.
pushDictApp : (Ref (List Route), List Mono, List String, List (List Mono), Option Loc) -> Unit
pushDictApp app = wPush perRun.value.dictApps app

-- method-level-constraint dict-passing (the reference's res_method_dicts, Phase
-- 69.x-e).  An interface method whose signature carries a `=>` constraint over a
-- tyvar that is NOT the interface param (canonically `foldMap : Monoid m => …`,
-- where `Monoid m` constrains the result monoid, not the container `t`):
--   methodConstraintsRef : method name → one tyvar id per such constraint, in slot
--                          order.  Captured while BUILDING the env method schemes
--                          (ifaceMethodSchemes) so the ids are the SAME quantified
--                          ids a call-site instantiation maps through its subst.
--   pendingMethodDicts   : a method occurrence's method-dicts ref to fill + the
--                          instantiated constraint monos (mirrors pendingDictApps),
--                          routed by resolveMethodDicts after inference.

-- Per method name, the POSITIONS (indices into the scheme's ordered quantified id
-- list) of its constraint slots.  Positions are allocation-INDEPENDENT: the env
-- scheme and the registry scheme are separate `sigToSchemeTvs mty` instantiations
-- with DIFFERENT fresh ids, but the SAME var order, so a slot's index is stable.
-- recordMethodDicts indexes THIS occurrence's ordered subst at these positions to
-- get the exact live constraint monos — sidestepping the cross-sweep/parametric-
-- sibling id-overlap that defeats countInSubst's overlap heuristic (a stale id can
-- land in the live range mapping to the container `t` instead of the applicative
-- `m`; the position never confuses the two).  One entry per method (dedup);
-- cleared in resetState.  Absent ⇒ fall back to alignedMethodConstraintIds.

-- Cross-module analog of methodConstraintsRef, mirroring crossModuleFunConstraintsRef
-- exactly.  resetState wipes methodConstraintsRef at each module start, then
-- checkModuleFullImpl re-registers via `ifaceMethodSchemes prog` over the CURRENT
-- module's decls only — so a method declared in an imported module (canonically
-- core's `foldMap : Monoid m =>` on `Foldable`) is absent during a later USER
-- module's pass, and its dict never gets recorded.  This ref ACCUMULATES every
-- module's registered method-constraints across the graph and is NOT cleared by
-- resetState; checkModuleFullImpl re-seeds methodConstraintsRef from it after the
-- per-module reset+registration (MERGE, the per-module entry wins first-match).
-- WS-2/D2 (method-level analog of crossModuleFunConstraintsQualRef): module-attributed
-- mirror of crossModuleMethodConstraintsRef, keyed by (owning interface's module id,
-- method name).  Without it, two modules declaring distinct interfaces that share a
-- bare METHOD name but with different method-level `=>`-constraint arity (e.g.
-- `shape : Num e => …` in module A vs `shape : (Num e, Num f) => …` in module B) both
-- land in the bare methodConstraintsRef; methodDictArityOf's first-match returns the
-- WRONG module's arity → an impl/default method in one module is sized to the other's
-- dict-param count → a dict is mis-bound into a value parameter (`unknown op '+'` /
-- garbage / run≠build — the method-level twin of the §1 D2 fn repro, which `check`
-- accepts).  Populated per-module in checkModuleFullImpl (each method whose INTERFACE
-- is declared in this module's `prog`); consumed by scopeMethodArities in the final
-- per-scope dict-pass.  The bare crossModuleMethodConstraintsRef is KEPT — the
-- per-module reseed at checkModuleFullImpl needs the bare form for the current module's
-- cross-module call-site discovery (recordMethodDicts), exactly like the fn side.
-- #158 PR2: the 22 per-run cross-module accumulators declared above (the six
-- crossModule* dict-arity mirrors of #143/#144, plus the #154 universe*/obUniv* universe
-- accumulators) are bundled into ONE typed record so their survive/clear lifecycle is a
-- TYPE FACT, not prose.  `freshCrossRun` constructs exactly the field-Refs that
-- `resetCrossModuleState` installs, so "what survives resetState" == "what CrossRun holds"
-- == "what a per-run reset clears" — enforced by the constructor: a new accumulator cannot
-- be added to the survive-set without appearing in freshCrossRun (and thus the reset).
-- This is a record OF Refs (fields stay `Ref …`), NOT a record of values: the grow helpers
-- (appendUniverseAccums / appendDataUniverse / growImplUniverse) and the Module-arm copies
-- mutate the field-Refs in place, so no whole-record copy is allocated per grow/push.
data CrossRun = CrossRun {
    universeIfaceMethodsRef : Ref (OrdMap Unit),
    universeFunNamesRef : Ref (OrdMap Unit),
    universeMethodIfaceParamsRef : Ref (OrdMap (IfaceRef, List String, Ty, List (String, List Kind))),
    universeMethodIdentsRef : Ref (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))))),  -- #1111 A-2.5 (#1092): the identity-keyed COMPANION of the line above — see methodIdentOf
    universeMethodCollidedRef : Ref (List String),  -- #1111 A-2.5: the method NAMES the line above holds ≥2 distinct identities for (normally EMPTY)
    universeRegisteredIfacesRef : Ref (OrdMap Unit),  -- #1111 A-2.4: DELIBERATELY still bare-name — a Unit-valued NAME-membership set, see ifaceRegistered
    universeMethodDispatchIdxByIdRef : Ref (List ((IfaceRef, String), Int)),  -- #1351: the interface dispatch-index universe, keyed ((IfaceRef, method name), Int).  Its bare-name-keyed predecessor `universeMethodDispatchIdxRef` was RETIRED by L5 (CONTRACT) once `dispatchIdxScoped` stopped falling back to it — read via `methodDispatchIdxByIdRef`.
    universeRecordByName : Ref (OrdMap RecordInfo),
    universeRecordIdentsRef : Ref (OrdMap (List (Ident, String, RecordInfo))),  -- #1111 A-2.12 (#1319 unit 2): the identity-keyed COMPANION of the line above — see insertRecordIdents
    universeRecordCollidedRef : Ref (List String),  -- #1111 A-2.12: the registry KEYS the line above holds ≥2 distinct identities for (normally EMPTY)
    -- ⚠️ `universeFieldOwners` was HERE and is RETIRED by A-3.2b slice 3 (#1512).
    -- It was the per-module-grown cross-run field-name → owning-registry-key multimap,
    -- marshalled by `loadDataUniverse`/`storeDataUniverse`.  The per-module seed now
    -- comes from stage K: `declEnvsRef.deOwnersBefore`, one `omLookup` by loader module
    -- id over the prefix chain `declEnvSeedChain` builds.  Do not re-add it — a cross-run
    -- copy beside K is two answers to "which records can this module see a field of", and
    -- the copy is the one whose population depends on marshalling order.
    -- ⚠️ `universeDataParamKinds` was HERE and is RETIRED by A-3.2b slice 2 (#1512).
    -- Same machine one projection over: the cross-run data-type param-KIND list
    -- (identity-keyed since #1111 A-2.3).  Its seed is `declEnvsRef.deKindsBefore`, and
    -- the projection that fills it is `kindPublicDataDecl` — a PEER of `publicDataDecl`,
    -- admitting `VisAbstract` and public `DNewtype` too, because those are the decls
    -- `registerOpaqueParamKinds` used to publish separately (#804/#1028).  That pass is
    -- gone with this cell; do not re-add either.
    -- ⚠️ `universeIfaceRequiredRef` was HERE and is RETIRED by A-3.5a (#1557).
    -- It was the per-module-grown iface → required-method-names `Registry` that
    -- impl-completeness read on the Module arm, identity-keyed since #1111 A-2.4
    -- (`regKeyOfTab (ifaceTabKey ifaceOrigin name)`).  Stage K's `CE` already holds
    -- exactly that value under exactly that key (`ceRowRequired`, minted by
    -- `classEnvRowsOf` from the same `requiredMethodNames`), so the cell was a second
    -- copy of a stage-K projection — the dual-write shape design law L1 removes.  Its
    -- one reader (`implCompletenessMsgsOfMap`) now calls `ceRequiredAt` at the reading
    -- module's ordinal, and the FLAT arm's separate bare-name scan
    -- (`ifaceRequiredMethods`) went with it: there is now ONE checker for both modes.
    -- Its writer `insertIfaceRequired` and that writer's `appendUniverseAccums` call
    -- are gone too.  ⚠️ It was NOT in the `loadDataUniverse`/`storeDataUniverse`
    -- ladder (it was written only from `appendUniverseAccums`), so unlike A-3.5c this
    -- retirement does not touch that marshalling pair and cannot desynchronize it.
    -- ⚠️ `universeIfaceParamKinds` was HERE and is RETIRED by A-3.5c (#1557).
    -- It was #822's iface half of the kind universe, identity×slot-keyed since
    -- #1111 A-2.4 and marshalled beside `universeAliasTable` above by the same
    -- `loadDataUniverse`/`storeDataUniverse` pair.  Its one reader
    -- (`checkGradedImplTys`) now sources from stage K: `declEnvsRef.deIfaces`,
    -- projected at the reader's own ordinal by `ceSlotKindsAt`.  Its `perRun` half
    -- (`ifaceParamKindsRef`) and its writer went with it -- do not re-add either.
    -- A cross-run copy beside K is two answers to "what kind is this interface's
    -- slot", and the copy is the one whose population depends on marshalling order.
    -- ⚠️ `universeAliasTable` was HERE and is RETIRED by A-3.2b's residual (#1512).
    -- It was the per-module-grown cross-run copy of the type-ALIAS table, marshalled
    -- by `loadDataUniverse`/`storeDataUniverse`.  Its readers now source from stage
    -- K: `declEnvsRef.deData.deAliases`, projected at the reader's own ordinal by
    -- `aliasUniverseAt`.  Do not re-add it — a cross-run copy beside K is two
    -- answers to "which aliases can this module see", and the copy is the one that
    -- would silently carry `rejectCyclicAliases`' per-module deletions.
    universeDataEnv : Ref TcEnv,
    universeCtorIdentsRef : Ref (OrdMap (List (Ident, String, Scheme))),  -- #1111 A-2.11 (#1319 unit 1): the identity-keyed COMPANION of universeDataEnv's ctor map — see insertCtorIdents
    universeCtorCollidedRef : Ref (List String),  -- #1111 A-2.11: the ctor NAMES the line above holds ≥2 distinct identities for (normally EMPTY)
    -- ⚠️ `universeDataDecls` was HERE and is RETIRED by A-3.2b (#1512, #1319 unit 4).
    -- It was #674's positional `List Decl` of prior modules' public data decls, the
    -- overlay pool; both its consumers now read stage K's `DeclEnvs.deModules` at the
    -- reader's own ordinal.  Do not re-add a cross-run decl accumulator: the envelope
    -- already holds the whole graph, keyed by loader module id and ordinal.
    --
    -- ⚠️ AND SO WERE `obUnivConcreteRef`/`obUnivHeadlessRef`/`obUnivIfaceTagsRef` —
    -- the per-module-grown obligation impl universe, RETIRED by A-3.4 PR2 (#1112).
    -- Not merely unread: stage K's `IE` (`declEnvsRef.deImpls`, projected at the
    -- reader's ordinal by `ieUniverseAt`) is now the single answer to "what impls
    -- exist" on the Module path, and keeping a second still-written copy is exactly
    -- the two-sources-of-truth divergence design law L1 removes.  Note the shape
    -- these two retirements share: BOTH replaced a cross-run accumulator with an
    -- ordinal-filtered read of the one whole-graph envelope.  That is the arc, and
    -- the `cross_allowed` count is what records it.
    builtinClassesRef : Ref BuiltinClasses,  -- #1446 P1 + #1539 / DICT §8 I7: the four operator/literal classes' identities AND presence, read off the PRELUDE's own DInterface decls — see seedBuiltinClasses
    crossModuleFunConstraintsRef : Ref (List (String, List Int)),
    crossModuleFunConstraintsQualRef : Ref (List ((String, String), List Int)),
    crossModuleFunConstraintIfacesRef : Ref (List (String, List IfaceRef)),
    crossModuleFunConstraintIfacesQualRef : Ref (List ((String, String), List IfaceRef)),
    -- S-xmod-vector-supply (#1868/#1867): the (definer module, exported name)-keyed twin
    -- of `funConstraintArgsRef`, seeded and consumed exactly like the ids/ifaces/prefix
    -- qual tables beside it.  ⚠️ THERE IS DELIBERATELY NO BARE-NAME PEER: a stored vector
    -- carries the DEFINING signature's instantiation tyvars, and only the source-exact
    -- key guarantees the call site substitutes them through THAT signature's own
    -- instantiation subst — see `declaredConstraintArgs`' header for why a vector read
    -- off another module's entry is strictly worse than no vector at all.
    crossModuleFunConstraintArgsQualRef : Ref (List ((String, String), List (List Mono))),
    crossModuleFunConstraintDeclaredRef : Ref (List (String, CDeclaredPrefix)),
    crossModuleFunConstraintDeclaredQualRef : Ref (List ((String, String), CDeclaredPrefix)),
    crossModuleMethodConstraintsRef : Ref (List (String, List Int)),
    crossModuleMethodConstraintsQualRef : Ref (List ((String, String), List Int)),
    coreSchemeObligationsRef : Ref (OrdMap (List VecObl)),  -- #673: core's OWN schemeObligationsRef, snapshotted after the core pass (see declaredCrossModuleObls)
    crossModuleSchemeOblsQualRef : Ref (List ((String, String), List VecObl)),  -- #1114/#845: every USER module's schemeObligationsRef, (mid, name)-attributed (see attributeModuleSchemeObls)
  }

-- Construct every field-Ref fresh (each reproduces its former top-level ref's initial).
-- (This line used to carry a COUNT.  It was an encoded fact with no derivation and no
-- expiry — `grep -c ' = Ref ' `'s answer is one command away — so it is gone rather than
-- bumped; the constructor is exhaustive, which is the property that actually matters.)
-- ⚠️ `env` is the initial TcEnv (always `initialEnv`) and is a PARAMETER rather than a
-- direct `initialEnv` reference on purpose — do NOT "simplify" it back to a `Unit` arg.
-- `crossRun` below is a nullary top-level binding, i.e. a wasm value GLOBAL eagerly
-- initialized in `$__init`, and the WasmGC backend orders those globals with a topo sort
-- whose edges come from `eagerVars` (backend/emit_support.mdk) — a DIRECT free-var scan of
-- the binding's body that does NOT follow calls into a callee's body.  So a global read
-- that hides inside this function is INVISIBLE to that sort: `crossRun = Ref (freshCrossRun
-- ())` yielded the single edge `freshCrossRun` (a function, not a value bind ⇒ no edge at
-- all), `crossRun` was emitted before `initialEnv`, and `$__init` read a `ref.null` →
-- "dereferencing a null pointer" at instantiate, which killed the whole playground (#543).
-- Taking the env as an ARG puts `initialEnv` back in `crossRun`'s own body, where
-- `eagerVars` can see it and order the two globals correctly.
--
-- ⚠️ NATIVE HAS THE SAME BUG — it is merely not EXPLOITED.  An earlier draft of this
-- comment claimed "native is unaffected (it does not eagerly init these)"; that was FALSE
-- and is corrected here with receipts, because it is exactly the kind of unproven claim
-- that steers a later general fix wrong.  `llvm_emit.mdk`'s `orderedValBinds` is fed by
-- `bindFreeVars` = the SAME shared `eagerVars`, with the same does-not-follow-calls blind
-- spot, and its own doc comment says an unordered eager forward ref "captures the
-- still-zero global cell".  Emitting the PRE-FIX source with the native emitter proves the
-- inversion was live there too: in the init prologue `crossRun` stored at IR line 1693
-- (calling `freshCrossRun` at 1687) while `initialEnv` stored at 1768 — 75 lines later —
-- and `@mdk_g_types_typecheck__initialEnv = global i64 0` with a `load` of it inside
-- `freshCrossRun`.  Native really did read a ZERO.
-- It never BIT because the zero is overwritten before anything dereferences it: the only
-- readers of `universeDataEnv` sit on the `Module` arm (`registerAllData
-- crossRun.value.universeDataEnv.value`), and every multi-module entry calls
-- `resetCrossModuleState ()` FIRST (`checkModulesPreamble`, `elaborateModules`), which
-- replaces the whole poisoned bundle once `initialEnv` is properly set.  That is luck, not
-- design — native's failure mode is a SILENT zero where wasm traps loudly, which is the
-- only reason #543 was noticed at all.  The general fix (an emitter-side eager-reachability
-- closure that follows calls) is #553 and MUST cover both backends.
freshCrossRun : TcEnv -> CrossRun
freshCrossRun env = CrossRun {
  universeIfaceMethodsRef = Ref omEmpty,
  universeFunNamesRef = Ref omEmpty,
  universeMethodIfaceParamsRef = Ref omEmpty,
  universeMethodIdentsRef = Ref omEmpty,
  universeMethodCollidedRef = Ref [],
  universeRegisteredIfacesRef = Ref omEmpty,
  universeMethodDispatchIdxByIdRef = Ref [],
  universeRecordByName = Ref omEmpty,
  universeRecordIdentsRef = Ref omEmpty,
  universeRecordCollidedRef = Ref [],
  universeDataEnv = Ref env,
  universeCtorIdentsRef = Ref omEmpty,
  universeCtorCollidedRef = Ref [],
  builtinClassesRef = Ref emptyBuiltinClasses,
  crossModuleFunConstraintsRef = Ref [],
  crossModuleFunConstraintsQualRef = Ref [],
  crossModuleFunConstraintIfacesRef = Ref [],
  crossModuleFunConstraintIfacesQualRef = Ref [],
  crossModuleFunConstraintArgsQualRef = Ref [],
  crossModuleFunConstraintDeclaredRef = Ref [],
  crossModuleFunConstraintDeclaredQualRef = Ref [],
  crossModuleMethodConstraintsRef = Ref [],
  crossModuleMethodConstraintsQualRef = Ref [],
  coreSchemeObligationsRef = Ref omEmpty,
  crossModuleSchemeOblsQualRef = Ref [],
}

-- The single module-level cell holding the current run's accumulator bundle.
crossRun : Ref CrossRun
crossRun = Ref (freshCrossRun initialEnv)

-- ── the ONE lifecycle owner for the 23 cross-module accumulators (#143/#144, #154) ──
-- These 23 deliberately SURVIVE the per-module `resetState` (so dict arities/ifaces and
-- the universe/data/impl accumulators cross module boundaries within one graph — see the
-- declaration comments above), but they must NOT survive a whole multi-module RUN: a
-- long-lived process (LSP, playground, snapshot runner) drives the analyze/elaborate path
-- repeatedly, and without a per-run reset run K+1 seeds `funConstraintsRef` /
-- `funConstraintIfacesRef` (and the universe accumulators) from run K's residue
-- (checkModuleFullImpl reads them for the FIRST module before any fresh snapshot lands),
-- while the `*Qual` mirrors are prepend-appended and never truncated → unbounded growth.
-- Give them exactly ONE reset owner, called at the top of EVERY multi-module entry
-- (`checkModules`, `checkModulesDiags`, `checkModulesEntryFull`, `elaborateModules`), so
-- the next entry added cannot silently miss one — and so all are cleared symmetrically.
-- Replacing `crossRun` with a fresh bundle IS the reset: freshCrossRun re-mints every
-- field, so the set that resets == the set in CrossRun, enforced by the constructor.
-- Scoped to exactly these 22; do NOT fold into `resetState` (they must survive THAT).
resetCrossModuleState : Unit -> Unit
resetCrossModuleState _ = crossRun := freshCrossRun initialEnv

-- self/mutually-recursive constrained-fn call sites.  At such a site the callee's
-- own constraints are not yet registered (its letrec group is still inferring),
-- so funConstraintsRef can't map its routes inline.  Defer them: RecDictApp holds
-- (routes ref to fill, callee name, the ENCLOSING fn's name, the live occurrence
-- mono).  realizeRecDictApps fills the routes after inference, forwarding the
-- enclosing fn's OWN dict parameter (RDict) for each constraint — the dict already
-- in scope in its body — rather than rebuilding one (which it cannot, the type is
-- still the constraint variable).  Mirrors the reference's recursive_promoted_usages
-- / realize_recursive_dict_apps (Phase 115/136).
public export data RecDictApp = RecDictApp (Ref (List Route)) String String Mono

-- the top-level fn whose body is currently being inferred ("" = none); captured
-- into a deferred RecDictApp so its recursive calls forward the right dict param.

-- G4: True while inferring an impl method BODY (set around inferImplMethod).  A
-- comparison/equality OPERATOR site records this flag so resolveBinopSite consults
-- `activeDictVarOf` (→ route the impl's threaded element dict, RDict) ONLY for sites
-- genuinely inside an impl body.  A TOP-LEVEL `<=`/`==` must NOT — its operand could
-- normalize to an unsolved tyvar whose id collides with a stale activeDictVars entry
-- left by a previously-inferred impl, spuriously routing it RDict (which flipped the
-- repl's String-keyed `:browse` sort).  activeDictVars is global + uncleared, so the
-- flag is the scope gate the id-lookup alone cannot provide.

-- INFERRED (unsignatured) `=>`-constraint promotion (the reference's two-pass
-- Elaborate / Phase 83/84/115).  An unsignatured fn whose body uses a
-- return-position method — or calls a constrained fn — at one of its OWN
-- generalized tyvars carries a constraint only AFTER inference.  We discover this
-- by recording, per occurrence, the enclosing fn (currentFn) and the live mono,
-- then (post-generalization) intersecting with the fn's quantified ids.
--   methodSiteFns : (enclosing fn, a return-position method site's result mono)
--   dictAppFns    : (enclosing fn, a constrained-fn call's instantiated constraint
--                   monos) — propagates a constraint to an unsignatured CALLER
--   promotedRef   : fns discovered THIS pass to carry an inferred constraint; read
--                   by elaborateDict to grow the dict-passed set on the next pass
--   dictEligibleRef: the USER fn names eligible for promotion (the prelude's
--                   constrained fns stay arg-tag/RKey — out of scope).  Set by
--                   elaborateDict; NOT cleared by resetState (constant per run).
--
-- PERF: both are INDEXED BY ENCLOSING FN rather than kept as flat (fn, mono) assoc
-- lists.  Their sole reader, `inferredConstraintIds`, selects the entries of ONE fn,
-- and it runs once per member of every top-level group — so scanning a flat list that
-- accumulates a site for every constrained occurrence in the whole file was O(N²).
-- Each key's list is built by consing, exactly like the flat lists were, so a fn's
-- sites keep the same most-recent-first order the old scan produced.

-- cons [x] onto the entry for [fn] (absent ⇒ a fresh single-element entry)
consSiteFn : String -> a -> OrdMap (List a) -> OrdMap (List a)
consSiteFn fn x idx = omInsert fn (x :: sitesFor fn idx) idx

-- the sites recorded for [fn], most-recent-first
sitesFor : String -> OrdMap (List a) -> List a
sitesFor fn idx = fromOption [] (omLookup fn idx)

-- #194: cross-module accumulator for the FIRST (bare-dict) elaboration sweep's
-- direct promotions.  resetState clears promotedRef per module, so elabHarvestWorker
-- unions each module's promotedRef.value into here right after that module's
-- elabModuleStamp (before the next module's resetState wipes it).  elaborateModules
-- reads it to decide the empty-case short-circuit vs the discard-and-fallback.  Set
-- to [] by elaborateModules before the sweep; NOT touched by resetState.

-- O(log n) membership index of dictEligibleRef.  #415 item 3: DERIVED from the list by
-- `setDictEligible`, the single writer of both — not mirrored at each set site, so the
-- two cannot drift.  maybeInferConstraint tests it per SCC member per discovery pass —
-- an O(members × eligible) scan over the whole program when it was a list.

-- Whether checkProgramSeeded ALSO infers each parametric impl's return-position
-- method bodies (instance-`requires` dict-passing, Phase 83/84 single-level).  ON
-- only for the elaborate / dict path (elaborateDict sets it); OFF for the
-- `=== TYPES ===` golden path (checkProgram) and the multi-module path
-- (elaborateModules) so their scheme output stays byte-identical.  Deliberately
-- NOT reset by resetState — the entrypoint that owns the path sets it.

-- ── D0.5 arg-position dispatch MEASUREMENT (probe-only) ─────────────────────
-- Classify every ARGUMENT-position interface-method occurrence (the bare-EVar
-- arg-tag population D0 counted, upper bound 1065) by the inferred type of its
-- DISCRIMINATING argument: concrete-primitive / concrete-ADT / type-variable.
-- Mirrors recordSite/resolveSites (which stamp RETURN-position sites) but for
-- arg-position sites it MEASURES, never stamps.  An arg-position method is exactly
-- one that reached inferVar (return-position + method-constrained methods were
-- already rewritten to EMethodAt/EDictAt by prePassDict, so they never arrive there).

-- method name → 0-based index of its first argument mentioning the interface
-- typaram (its dispatch position).  Set by the probe before elaboration; absence
-- of a name means "not an arg-position interface method" → not measured.

-- ── D3a arg-position dispatch STAMPING (Native backend, ALL elaboration paths) ──
-- The action analog of the D0.5 measurement: instead of classifying each
-- ARGUMENT-position interface-method occurrence, STAMP a static `RKey <head>` for
-- every one whose discriminating-argument type resolves to a concrete head (the
-- 903 concrete sites = 25 primitive + 878 ADT).  Type-variable occurrences (the
-- 110 D3b sites) stay RNone → the emitter falls back to runtime arg-tag dispatch.
-- Stamping is UNCONDITIONAL: emit, eval, and the `=== TYPES ===` / Core-IR golden +
-- ceval-oracle drivers all elaborate identically — one single elaboration mode
-- (#157).  Measured byte-identical across the 204/204 fixtures, so the unification
-- is representation-neutral, not a behaviour change.

-- the route refs awaiting an arg-position stamp + their discriminating-argument
-- mono (captured during inference, resolved by resolveArgStamps while the tyvar
-- cells are still bound).  Reset per pass by resetState, like pendingSites.
-- D3b-1: also carries the method name + the EMethodAt impl-dicts ref, so a
-- concrete site whose head names a parametric `requires` impl can thread the
-- element dict (resolveArgStamp → argImplDictRoutesFor), exactly as the
-- return-position pendingSites carry implRef for resolveSite.
-- #156 S3a: entries are `PendingEntry`s of kind `SKArg`.

-- the dispatch-index registry: each interface method → index of its first arg
-- mentioning the interface typaram.  Methods with NO such arg (return-position)
-- contribute nothing.  Computed structurally from interface decls.
export
argDispatchIndices : List Decl -> List (String, Int)
argDispatchIndices prog = flatMap argDispatchOfDecl prog

argDispatchOfDecl : Decl -> List (String, Int)
argDispatchOfDecl (DAttrib _ d) = argDispatchOfDecl d
argDispatchOfDecl (DInterface { typarams, methods, ... }) =
  flatMap (argDispatchOfMethod typarams) methods
argDispatchOfDecl _ = []

argDispatchOfMethod : List String -> IfaceMethod -> List (String, Int)
argDispatchOfMethod typarams (IfaceMethod mname mty _) = match firstDispatchIdx (dispatchTyparams typarams) 0 (methodArgs mty)
  Some i => [(mname, i)]
  None => []

-- #1351 L1 (EXPAND): the IDENTITY-CARRYING sibling of `argDispatchIndices` above.  Same
-- walk, same arms, same `firstDispatchIdx` classification — the ONLY difference is the
-- key: `(IfaceRef, method name)` instead of the bare method name.  `IfaceRef` is this
-- file's existing module-qualified interface identity (`irName` spelling + `irOrigin` I4
-- identity); it is already minted at the peer population site
-- `registerMethodIfaceParamsDecl` out of the SAME two `DInterface` fields, so this adds
-- no new notion of identity, only a second key-shape for an existing one.
--
-- ⚠️ NOTHING READS THIS YET, deliberately.  It is the substrate leaf L3 migrates
-- `methodDispatchIdx`/`argDispatchOf` onto; until then the bare-name tables stay
-- authoritative.  Do not add a reader here — adding a reader is a MIGRATE leaf, and
-- doing both at once is the partial-motion shape this family was cut to avoid.
--
-- 🔒 Purity note, load-bearing for L1's zero-behaviour-change property:
-- `argDispatchIndices` and everything it reaches (`argDispatchOfDecl`,
-- `argDispatchOfMethod`, `dispatchTyparams`, `firstDispatchIdx`, `argMentions`,
-- `methodArgs`) is pure and structural, so running this second walk beside it advances
-- no counter, mints no id and registers nothing.  Contrast `ifaceMethodSchemes`, which
-- is NOT pure — see `ifaceMethodSchemeIds` for what that forced there.
argDispatchIndicesById : List Decl -> List ((IfaceRef, String), Int)
argDispatchIndicesById prog = flatMap argDispatchOfDeclById prog

argDispatchOfDeclById : Decl -> List ((IfaceRef, String), Int)
argDispatchOfDeclById (DAttrib _ d) = argDispatchOfDeclById d
argDispatchOfDeclById (DInterface { name, typarams, methods, ifaceOrigin, ... }) = flatMap (argDispatchOfMethodById IfaceRef { irName = name, irOrigin = ifaceOrigin } typarams) methods
argDispatchOfDeclById _ = []

argDispatchOfMethodById : IfaceRef -> List String -> IfaceMethod -> List ((IfaceRef, String), Int)
argDispatchOfMethodById iface typarams (IfaceMethod mname mty _) = match firstDispatchIdx (dispatchTyparams typarams) 0 (methodArgs mty)
  Some i => [((iface, mname), i)]
  None => []

-- The DISCRIMINATING (receiver) typaram(s) of an interface — its FIRST typaram.
-- A multi-param interface (`FromEntries c e`) dispatches on its head/receiver
-- param `c`; the trailing `e` is a phantom element param that may appear in
-- argument types (`List e`) WITHOUT making the method arg-position dispatched.
-- Classifying by ALL typarams mis-routes `fromEntries : List e -> c` to its `List`
-- argument (an arg-tag site that has no `List` impl) instead of return-position
-- dispatch on `c`.  Single-param interfaces are unaffected (`take 1` is identity).
dispatchTyparams : List String -> List String
dispatchTyparams [] = []
dispatchTyparams (p::_) = [p]

firstDispatchIdx : List String -> Int -> List Ty -> Option Int
firstDispatchIdx _ _ [] = None
firstDispatchIdx typarams i (ty::rest)
  | argMentions typarams ty = Some i
  | otherwise = firstDispatchIdx typarams (i + 1) rest

nthArgMono : Int -> Mono -> Option Mono
nthArgMono 0 m = match normalize m
  TFun a _ _ => Some a
  _ => None
nthArgMono n m = match normalize m
  TFun _ _ b => nthArgMono (n - 1) b
  _ => None

-- D3a: queue an arg-position occurrence's route ref for stamping, keyed on the
-- inferred type of its discriminating argument (the dispatch-position arg mono).
-- The cell is read later (resolveArgStamps), once inference has solved it.  D3b-1:
-- also carry [name] + the impl-dicts ref so a concrete-head site can thread the
-- element dict for a parametric `requires` impl.
recordArgStamp : String -> Ref Route -> Ref (List Route) -> Int -> Mono -> Unit
recordArgStamp name tagRef implRef idx mono
  | toggles.value.suppressArgStamp.value = ()
  | otherwise = match nthArgMono idx mono
    Some am => perRun.value.pendingArgStamps := PendingEntry name tagRef am perRun.value.currentFn.value (SKArg implRef mono) !currentLoc :: perRun.value.pendingArgStamps.value
    None => ()

-- Cause-A prerequisite: an ARG-position method occurrence's discriminating-arg
-- mono, keyed by the enclosing fn (currentFn), pushed into methodSiteFns — the
-- arg-position analogue of recordSite's return-position push.  inferredConstraintIds
-- reads methodSiteFns to discover the enclosing fn's INFERRED constraint, so this
-- lets `f s = display s` promote `f` to a dict-passed fn (it had no signature, so
-- the constraint is inferred, not declared).  Idx-th arg mono = the receiver whose
-- (constraint) tyvar must be discovered.
recordArgSiteFn : String -> Int -> Mono -> Unit
recordArgSiteFn _ idx mono = match nthArgMono idx mono
  Some am => perRun.value.methodSiteFns := consSiteFn perRun.value.currentFn.value am perRun.value.methodSiteFns.value
  None => ()

-- D3a/D3b-1: stamp each queued arg-position route from its now-resolved
-- discriminating arg mono.  D3b-1 first: a mono pinned to an impl's `requires`
-- element tyvar (registered in activeDictVars by registerImplRequires) → the
-- element dict param RDict $dict_<method>_<slot> — the ARGUMENT-position analogue
-- of resolveSite's return-position RDict.  Else (D3a): a concrete head
-- (Int/String/Float/… or any ADT tycon) → a static `RKey tag …`, and when that
-- head names a parametric impl WITH a requires, fill the impl-dicts ref so the
-- call threads the element dict (concrete element → RKey Int; a recursive element
-- of the SAME parametric type → RDict forwarding the in-scope dict param).  A
-- still-unsolved free type variable → left RNone (the emitter arg-tag-dispatches).
resolveArgStamps : ImplBuckets -> List PendingEntry -> Unit
resolveArgStamps _ [] = goalSiteLoc := None
resolveArgStamps implTable ((PendingEntry name tagRef am encl kind loc)::rest) =
  goalSiteLoc := loc
  let _ = match kind
    SKArg implRef fullMono =>
      resolveArgStamp implTable name tagRef implRef am fullMono encl
    _ => ()
  resolveArgStamps implTable rest

-- #156 S3c: a thin adapter over `entail` (EKArg kind).  `entail` returns
-- `(primaryRoute, elementRoutes)`; stamp them into (tagRef, implRef).  Reproduces the
-- pre-S3c arm-by-arm body: assum → `(RDict dname, [])`, inst → `(RKey key [],
-- argImplDictRoutesForEncl …)`, fallback → `(RNone, [])`.
-- TYPECHECK-AUDIT C7 (arg-position): when ≥2 impls of this method share head tycon [tag]
-- but differ in type ARGS (e.g. `MyPair Int Bool` vs `MyPair Bool Int`), bare-head `RKey
-- tag` narrows to the FIRST impl (eval's hasTag matches the head `t`).  `keyForSite`
-- (inside entailInst) upgrades to the canonical full-type impl key so eval's hasTag
-- matches the right impl's `k`.  No collision → bare head, unchanged.
-- ⚠️ tagRef is NOT always RNone-seeded: rewriteArgScoped (~7438) seeds a standalone-shadow
-- arg site to `RLocal <sym> []`, and resolveRLocalSites (later) leaves an importer-shadow
-- site UNTOUCHED — so the pre-S3c None arm's `()` was load-bearing: it PRESERVED that
-- RLocal seed.  For EKArg `entail` yields RNone ONLY from its fallback (assum→RDict,
-- inst→RKey), so guarding the stamp on RNone reproduces that do-nothing None arm exactly
-- and never clobbers an RLocal seed.  implRef is []-seeded everywhere (every EMethodAt
-- construction — 7313/7355/7356/7438/7441/7443 — uses `(Ref [])`, and only this resolver
-- ever writes an arg-site's implRef), so []-over-[] needs no guard (matches resolveSite).
resolveArgStamp : ImplBuckets -> String -> Ref Route -> Ref (List Route) -> Mono -> Mono -> String -> Unit
resolveArgStamp implTable name tagRef implRef am fullMono encl =
  let (route, routes) = entail implTable name am encl (EKArg fullMono)
  let _ = match route
    RNone => ()
    _ => tagRef := route
  implRef := routes

-- Native Gap C (parametric default-method dict-synthesis, 2026-06-12): a BY-NAME
-- relational method (`lt`/`gt`/…) at a parametric Ord head (tuple/`List a`/`Box a`)
-- has NO own impl, so its element `requires` dicts must be keyed off the inner
-- `compare` (whose impl carries them).  emitDefaultDefine eta-prepends matching
-- dict params; emitDefaultRKey forwards these words.  Concrete head / a method
-- with its own impl ⇒ same key as before (empty for non-parametric), unchanged.

-- ── structured typecheck diagnostic (TcDiag) ───────────────────────────────
-- #159: ONE structured record replaces the old flat (code, msg, Option Loc)
-- triple PLUS its parallel message-keyed side channels — `typeErrorHelpFix` for
-- errors, and `matchWarningLocs` / `matchWarningHelp` for the non-exhaustive-match
-- warnings.  Every accumulated diagnostic (errors AND match warnings) now carries
-- its code, severity, span, message, and optional help/fix INLINE, so nothing
-- downstream has to zip parallel lists or look help up by message text.  The
-- observable output is unchanged: `driver/diagnostics.mdk` maps a TcDiag to its
-- `Diag` and thence to the `--json` shape (DIAGNOSTIC-CODES-DESIGN.md), byte for
-- byte as before.  `severity` is an Int (1 = error, 2 = warning — the same codes
-- `--json` emits) because the real `Severity` type lives in `driver/diagnostics.mdk`,
-- which imports THIS module, so importing it back would cycle.  `fix` is a plain
-- (Loc span, replacement) pair, converted to a real `Fix` on the diagnostics side.
public export data TcDiag =
  | TcDiag String Int (Option Loc) String (Option String) (Option (Loc, String))

export
tcCode : TcDiag -> String
tcCode (TcDiag c _ _ _ _ _) = c

export
tcSeverity : TcDiag -> Int
tcSeverity (TcDiag _ s _ _ _ _) = s

export
tcLoc : TcDiag -> Option Loc
tcLoc (TcDiag _ _ l _ _ _) = l

export
tcMsg : TcDiag -> String
tcMsg (TcDiag _ _ _ m _ _) = m

export
tcHelp : TcDiag -> Option String
tcHelp (TcDiag _ _ _ _ h _) = h

export
tcFix : TcDiag -> Option (Loc, String)
tcFix (TcDiag _ _ _ _ _ f) = f

-- ── type-error accumulator ─────────────────────────────────────────────────
-- Unification failures record diagnostics here instead of panicking, so
-- ill-typed programs emit matching `TYPE ERROR: …` lines.  occursCheckFailed
-- is a per-bindVar flag: occursAdjustUnbound sets it so bindVar can skip the
-- actual link (preventing a cyclic union-find entry).
-- B.10.2b: each accumulated error carries the `currentLoc` span in effect at the
-- push site (its `Option Loc`), mirroring lib/typecheck.ml binding `!current_loc`
-- into `Type_error (e, !current_loc)` at the RAISE site rather than reading the
-- global last-entered loc afterwards.  `pushTypeError` captures `currentLoc.value`
-- so locs don't drift as inference continues past the error.  severity = 1.
--
-- issue 1146 — THE CHANNEL IS SPLIT BY ROLE.  "Which diagnostics are REPORTED"
-- is OUTPUT and lives in `perRun.typeErrors`, a `Windowed TcDiag` like its
-- obligation-channel siblings (see `Windowed` above — `wPush`/`wReset`/`wRestore` are
-- its sole WRITERS, so its list and its count cannot drift apart).  "An error
-- OCCURRED" is CONTROL and lives in `perRun.errorsDetected`, a monotone-per-module
-- occurrence counter that is not a diagnostics channel at all.
--
-- The counter counts errors DETECTED, not errors STORED (PR2).  The three dedup
-- helpers below still read the list by CONTENT to decide whether to store, but a
-- short-circuit bumps the counter anyway (`noteTypeErrorDetected`), so "was an error
-- detected here" and "is this diagnostic worth printing" are now independent
-- judgments.  That is the property the whole split exists for: NO diagnostics
-- decision — dedup key, rendering, ordering, loc selection, code selection — can
-- reach a control decision, because the only thing control reads is a count of
-- detections and none of those choices changes whether a detection happened.
--
-- PR1 stopped short of this: it bumped only on a real store, so the counter's delta
-- equalled `listLen typeErrors`'s delta exactly (which is what let PR1 land without
-- moving a golden), and a deduped push therefore answered `erredDuring` False and let
-- a gated `unify` run that a non-deduped push would have suppressed.  PR2 gives that
-- equality up on purpose; it is no longer an invariant and must not be restored.
--
-- See `recordTypeError` / `noteTypeErrorDetected` (the counter's sole writers) and
-- `erredDuring` (its sole reader) below.

-- G1 (SOUNDNESS): a STICKY mirror of typeErrors that resetState does NOT clear.
-- The multi-module elaborate path (elaborateModules → checkModuleFullImpl) calls
-- resetState at the start of EACH module, wiping `typeErrors`, so after the whole
-- graph only the LAST module's errors survive there.  build/run must abort on a
-- type error in ANY module, so `pushTypeError` also records into this accumulator,
-- which only `resetTypeErrorsSticky` clears (the driver, once, before a run).  Read
-- via `hadTypeErrors` to gate the CLI exit code BEFORE emit/eval.
typeErrorsSticky : Ref Bool
typeErrorsSticky = Ref False

-- Clear the sticky accumulator.  Call once at the start of a build/run pipeline.
export
resetTypeErrorsSticky : Unit -> Unit
resetTypeErrorsSticky _ = typeErrorsSticky := False

-- #760: True only while inferUserImplBodies runs (the CHECK-path ground-impl obligation
-- pass).  It routes inferImplMethod's interface-method-type lookup through the O(log)
-- registered `methodIfaceParamsRef` (ifaceMethodTyResolved) instead of ifaceMethodTy's
-- O(program) scan — so re-checking N ground impls on the (multi-module) check path stays
-- LINEAR, not O(impls * program) (which would re-introduce the perf `modules`-shape
-- quadratic profile_modules_main measures).  The EMIT path keeps the exact scan (flag OFF).
useFastIfaceMethodTy : Ref Bool
useFastIfaceMethodTy = Ref False

-- True iff any type error was pushed since the last resetTypeErrorsSticky.
export
hadTypeErrors : Unit -> Bool
hadTypeErrors _ = !typeErrorsSticky

-- issue 1146 — THE SOLE WRITER of the `typeErrors` channel.  Every push, deduped
-- or not, helper-mediated or not, funnels through here, so the three facts one push
-- establishes cannot drift apart at one site and not another: the diagnostic is
-- STORED, the build/run sticky gate is ARMED, and an error OCCURRED.
--
-- ⚠️ It is NOT the sole writer of `perRun.errorsDetected` — that would put the
-- counter back in step with the list, which is exactly what PR2 removed.  The counter
-- is bumped by `noteTypeErrorDetected` below, from here AND from each dedup
-- short-circuit, so it counts errors DETECTED rather than errors STORED.  Do not
-- "restore" the equality: a region containing only a deduped push must still answer
-- `erredDuring` True, or a diagnostics decision reaches a control decision again.
--
-- ⚠️ ONE standing obligation, and it is not discharged here: anywhere the channel is
-- ROLLED BACK, this counter must be rolled back WITH it, or a region straddling the
-- rollback would see a detection that no longer has a diagnostic behind it.  There is
-- exactly one such site today — `discoverPromotedModules`, which snapshots both and
-- restores both.  Any future rollback of `typeErrors` owes the same pairing.
--
-- ⚠️ The funnel is not cosmetic.  Before it there were SIX push sites, not the five
-- named helpers: `recordDoMonadError` open-codes its own cons + sticky set.  A
-- hand-placed bump at "the five helpers" would have left that one silent, and the
-- counter would then have UNDER-counted exactly on the `do`-requires-a-monad path.
recordTypeError : TcDiag -> Unit
recordTypeError d =
  typeErrorsSticky := True
  let _ = noteTypeErrorDetected ()
  wPush perRun.value.typeErrors d

-- issue 1146 PR2 — the counter's ONLY incrementing statement, so "an error was
-- detected" is written in one place whether or not the diagnostic is stored.
-- Called from `recordTypeError` (stored) and from all three dedup short-circuits
-- (detected, suppressed as a duplicate).  It deliberately does NOT arm
-- `typeErrorsSticky`: a short-circuit means an identical message is already in the
-- channel, which armed it at its own push, and only `resetTypeErrorsSticky` (once per
-- build/run, before any inference) clears it.
noteTypeErrorDetected : Unit -> Unit
noteTypeErrorDetected _ =
  perRun.value.errorsDetected := perRun.value.errorsDetected.value + 1

-- issue 1146 — THE polling convention for "did region [act] DETECT an error".
--
-- Three inference sites used to answer that by measuring `listLen typeErrors` before
-- and after the region.  That made the diagnostic accumulator load-bearing CONTROL
-- FLOW rather than a report: any change to how many entries land in it — a dedup-key
-- change, a rendering change, a loc-selection change — could silently flip an
-- inference branch, and a gated `unify` that does not run is a type error that is not
-- caught.  They now read the occurrence COUNTER, through this ONE combinator, so the
-- judgment is implemented once and no diagnostics decision reaches a control decision:
-- the counter records DETECTIONS, and no dedup, rendering, ordering, loc-selection or
-- code-selection choice changes whether an error was detected.
--
-- Read the answer as "an error was detected in [act]", NOT as "[act] added a
-- diagnostic" — since PR2 those differ, and the difference is the point.  Do not
-- re-derive it from `typeErrors`; that reintroduces the coupling this removes.
--
-- ⚠️ Medaka is STRICT, so [act] must be a thunk: `erredDuring (_ => work)`.  Passing
-- the region's VALUE would evaluate it before the first read and always answer False.
erredDuring : (Unit -> a) -> (Bool, a)
erredDuring act =
  let before = perRun.value.errorsDetected.value
  let result = act ()
  (perRun.value.errorsDetected.value /= before, result)

-- Push one type-error message, snapshotting the current ELoc span (B.10.2b).
pushTypeError : String -> String -> Unit
pushTypeError code msg =
  recordTypeError (TcDiag code 1 !currentLoc msg None None)

-- Push one type-error message attributed to [loc] rather than the live
-- `currentLoc` (#414).  Same non-deduping semantics as `pushTypeError` — the
-- deduping `pushTypeErrorOnceAt` is for obligation errors, which two checkers can
-- each detect; a coherence conflict is pushed exactly once per run.  `None` falls
-- back to `currentLoc`, i.e. the old behaviour.
pushTypeErrorAt : String -> Option Loc -> String -> Unit
pushTypeErrorAt code loc msg =
  recordTypeError (TcDiag code 1 (orElseLoc loc !currentLoc) msg None None)

-- #11 soundness: REPORT an obligation error only if the SAME message isn't already
-- accumulated.  A single missing impl can be detected by both checkImplObligations
-- (the original deferred obligation, once it grounds) and checkCallObligations (the
-- call-site instantiation); ERROR-QUALITY dim R/X want one diagnostic per root cause,
-- so the second detection is suppressed from the REPORT.
--
-- issue 1146 PR2: suppressed from the report, NOT from the record of what happened —
-- the short-circuit still calls `noteTypeErrorDetected`.  Dedup is a presentation
-- judgment keyed on rendered text; letting it also decide "did an error occur here"
-- is what made a message-rendering change able to flip an inference branch.
pushTypeErrorOnce : String -> String -> Unit
pushTypeErrorOnce code msg =
  if anyList (e => tcMsg e == msg) perRun.value.typeErrors.items.value then
    noteTypeErrorDetected ()
  else
    pushTypeError code msg

-- B.10.2c: push a deduped type error attributing it to the supplied loc rather
-- than the live `currentLoc` (which is stale during the post-HM obligation
-- check — inference has long since left the offending ELoc).  The loc was
-- snapshotted into the obligation tuple at the record site.  `None` falls back
-- to the live `currentLoc` (the old behaviour) so an obligation that never
-- captured a span is unchanged.  issue 1146 PR2: the short-circuit bumps the
-- occurrence counter (see `pushTypeErrorOnce`) — dedup suppresses the REPORT only.
pushTypeErrorOnceAt : String -> Option Loc -> String -> Unit
pushTypeErrorOnceAt code loc msg =
  if anyList (e => tcMsg e == msg) perRun.value.typeErrors.items.value then
    noteTypeErrorDetected ()
  else
    recordTypeError (TcDiag code 1 (orElseLoc loc !currentLoc) msg None None)

-- Push a deduped type error (same dedup rule as pushTypeErrorOnceAt) that also
-- carries a human `help` string and an optional machine-applicable `fix`
-- (ERROR-QUALITY dim F).  #159: help/fix now ride INSIDE the TcDiag — no
-- message-keyed side channel.  `Fix`/`Diag` live in driver/diagnostics.mdk (which
-- imports this module), so the fix is carried as a plain (Loc, String)
-- span+replacement pair, converted to a real `Fix` on the diagnostics.mdk side.
-- issue 1146 PR2: the short-circuit bumps the occurrence counter (see
-- `pushTypeErrorOnce`) — dedup suppresses the REPORT only.
pushTypeErrorHelpFixAt : String -> Option Loc -> String -> String -> Option (Loc, String) -> Unit
pushTypeErrorHelpFixAt code loc msg help fix =
  if anyList (e => tcMsg e == msg) perRun.value.typeErrors.items.value then
    noteTypeErrorDetected ()
  else
    recordTypeError (TcDiag code 1 (orElseLoc loc !currentLoc) msg (Some help) fix)

-- Source-location attribution (Phase B.10.2): the innermost ELoc span the
-- `infer` walk has entered.  Set by infer's transparent ELoc arm before
-- recursing (mirror of lib/typecheck.ml's `current_loc` ref, set in its ELoc
-- arm; cf. `fail e = raise (Type_error (e, !current_loc))`).  Surfaced through
-- Diag / the LSP via `pushTypeError`.  `None` until the first ELoc is entered
-- (top-level decls aren't ELoc-wrapped).
currentLoc : Ref (Option Loc)
currentLoc = Ref None

-- #1155 (F-3c): the span of the dispatch SITE whose goal the post-HM resolvers are
-- currently entailing — republished from the `Option Loc` each `PendingEntry` /
-- `dictApps` entry snapshotted at its RECORD site.  `currentLoc` is useless in that
-- window: inference has long since left the offending expression, so it names
-- whichever ELoc happened to be entered last (observed on the #1155 rigid fixture:
-- the body of an unrelated impl three lines away).  This is the same problem
-- `pushTypeErrorOnceAt`'s `Option Loc` parameter exists for — a route-time reject
-- just has no argument to pass it through, so the span travels in a ref instead.
--
-- ⚠️ SCOPED TO A RESOLVER DRAIN, deliberately.  Each of the five resolver loops sets
-- it per entry and CLEARS it (`None`) in its own base case, so outside a drain the
-- selector falls back to `currentLoc` — the pre-#1155 behaviour — rather than
-- attributing a goal to some earlier site's span.  `concreteReqMatchByIface` (the
-- obligation-check reader of the same selector) runs outside every drain and is
-- exactly the caller that clearing protects.
goalSiteLoc : Ref (Option Loc)
goalSiteLoc = Ref None

currentDoOrigin : Ref (Option Loc)
currentDoOrigin = Ref None

-- C8b Gap 2 (diagnostic-quality parity): set to `Some methodName` around the
-- OUTER unify of an interface default body against its declared return type, so a
-- leaf TypeMismatch is reported as the oracle's specialized single line
-- `Method '<name>': expected type <e> but got <a>` (lib/typecheck.ml's
-- MethodTypeMismatch catch, :3904-3907) instead of a bare `Type mismatch: …`.
currentMethodMismatch : Ref (Option String)
currentMethodMismatch = Ref None

-- ASYNC-DESIGN Stage 2 (D5): the entry program's inferred `main` scheme, stashed
-- by elabWorker on the EVAL path so the native `run` driver can detect a
-- `main : Async _` and route it through `runAsync` (perform its row) instead of
-- forcing it to an inert Async value.  Last module wins (the entry is last in
-- dependency order), matching bin/main.ml's `final_schemes` lookup.  `None` until
-- a module binding `main` is elaborated; reset at the top of elaborateModules so a
-- prior run can't leak.  Type-level only → no emitted IR changes → fixpoint-safe.

-- ✅ `monoHeadCon` IS GONE — Stage A-2 unit A-2.2b (#1111), and its removal is
-- the *whole* of what A-2.2 owed the unit that would have re-keyed
-- `universeKeyBucketsRef` — a unit that never came: ARCH B-2.1-d DELETED that ref
-- instead, so the debt is discharged by deletion rather than by re-keying.
--
-- It was the THIRD head projection in this file, extensionally identical to
-- `headTyconNameMono` (same three arms, same `normalize`-at-every-spine-level
-- walk) and carrying its own copy of the §8 I6.1 rigid forgery.  A-2.2 widened
-- `headTyconMono`/`headTyconTy` to `Option HeadKey` and left this one
-- `Option String`, which left `KeyBuckets`' two sides speaking different
-- languages: `keyEntryOf` handed the table a `HeadKey` (immediately projected
-- back to a bare name) while `goalHeadCon` handed it a `String`.
--
-- A-2.2b closes that by DELETION rather than by a fourth widening:
--   * `goalHeadCon` — the GOAL side of `KeyBuckets` — now calls
--     `headTyconMono`, which A-2.2 already widened.  Impl side and goal side
--     are now the same two functions, `headTyconTy` and `headTyconMono`, both
--     `Option HeadKey`.
--   * ⚠️ `goalHeadCon` IS NOT THE ONLY DISPATCH-PATH CONSUMER THAT MOVED, and
--     an earlier draft of this obituary said it was.  THREE more were re-pointed
--     from `headTyconNameMono` to `headTyconMono` in the same commit, because
--     `implExistsForHead`'s third parameter widened with them — audit them as a
--     SET, they are the same decision three times:
--       - `inferShadowApp`            (importer shadow, inference time)
--       - `definerReceiverDispatches` (Fork-1 receiver test, inference time)
--       - `resolveRLocalSite`         (the post-inference route stamp)
--     Each projects a receiver `Mono` and feeds the result to NOTHING but an
--     existence test, so each SHOULD call `headTyconMono` — the name-only
--     residual can no longer express that argument.  ⚠️ ARCH B-2.1-g MOVED ALL
--     THREE ONTO `ieImplExistsForHead` (graph-global `bodyImplEnvRef`), together,
--     for the reason recorded there; the head projection is the SAME at all three,
--     so the widening argument is unchanged and only a grep for the old single
--     name no longer finds them.  Derive the set rather than trusting this list:
--
--       grep -nwE '(ie)?[Ii]mplExistsForHead' compiler/types/typecheck.mdk \
--         | grep -vE '^[0-9]+:[[:space:]]*--' | grep -vE '^[0-9]+:(ie)?[Ii]mplExistsForHead'
--
--     What the widening does NOT yet buy them is an identity comparison: the
--     retest inside `ieImplExistsForHeadGo` (and `implExistsForHeadGo`, the
--     prefix-table predecessor B-2.1-d deleted) projects both sides back through
--     `dispHeadTab`, deliberately.  ⚠️ NOT because the goal side "has no origin
--     to compare with" — an earlier draft said that, and the absolute is what
--     makes the defect unimaginable.  The goal side came back MIXED (the full
--     derivation is the 🚨 note on `headTabIs`, which every surviving retest shares):
--     `debug (2 : Int)` SUPPLIES an origin and matched the impl side even
--     before the fix, while `debug (stringLength "xy")` does not, because
--     `stdlib/runtime.mdk`'s extern signatures never pass through resolve's
--     head-stamping walk.  A retest that compares identities therefore does not
--     fail uniformly — it fails PER PROVENANCE, which is why it looked correct.
--     (See there, and `dispHeadTab`'s own derivation.)
--   * every other consumer wanted only the NAME or its presence
--     (`mainTypeIsAsync`, `tagNumlitCtxIf`, `containerParamScalarArg`,
--     `domainIsTupleOfArity`, `inferAppExpr`'s not-a-function reframe) and now
--     calls `headTyconNameMono`, the bare-name residual that already existed
--     for exactly this population.
--
-- The substitution is answer-preserving because the two functions agree arm for
-- arm: `monoHeadCon` matched `normalize m` against `TCon`/`TRigid`/`TApp`/`_`
-- and recursed on the `TApp` left spine; `headTyconNameMono` matches
-- `headMonoNode t` (which IS that recursion, `normalize`-ing at each level)
-- against `TCon`/`TRigid`/`_`.
--
-- 🚨 THIS IS A DELETION, NOT A CENSUS.  Three head projections became FOUR
-- minus one, not "two" — and the derivation an earlier draft offered,
-- `grep -nE '^(headTyconMono|headTyconTy) :'`, is a TAUTOLOGY: it hard-codes
-- the two names it wants and structurally cannot discover a third.  Use a
-- pattern that CAN:
--
--   grep -nE '^headTycon[A-Za-z]* :' compiler/types/typecheck.mdk
--
-- It prints FOUR, which are two orthogonal pairs — a new projection lands in
-- the output whatever it is called:
--
--   * by SIDE (the dispatch-key pair): `headTyconTy` = impl, `headTyconMono` =
--     goal.  These two, and only these two, return `Option HeadKey` and reach a
--     dispatch key.
--   * by SOURCE TYPE (the same-arms pair): `headTyconMono`/`headTyconNameMono`
--     over `Mono`, `headTyconTy`/`headTyconNameTy` over `Ty`.  Each `…Name…` is
--     the bare-name residual of the one above it, and each pair owes the
--     invariant that both members classify the SAME head nodes — stated at
--     `headTyconNameMono`, which is the pair THAT comment means.
--
-- Stage 2 query: did the last-elaborated `main` infer to an `Async`-headed type?
export
mainTypeIsAsync : Unit -> Bool
mainTypeIsAsync _ = match driverState.value.mainSchemeRef.value
  Some (Forall _ _ t) => headTyconNameMono t == Some "Async"
  None => False

-- Stage 3 query: did the last-elaborated `main` infer to a bare Unit return type
-- (with effects stripped at each arrow, mono resolves to TCon "Unit")?  Used by
-- the LLVM emitter to suppress the auto-print of Unit-returning mains even when no
-- explicit `main : <IO> Unit` annotation is present — e.g. `main = applyEff f 42`
-- where `applyEff : (a -> <IO> b) -> a -> <IO> b` and `f : Int -> <IO> Unit`.
export
mainTypeIsUnit : Unit -> Bool
mainTypeIsUnit _ = match driverState.value.mainSchemeRef.value
  Some (Forall _ _ t) => match normalize t
    TCon "Unit" _ => True
    _ => False
  None => False

-- Stage 4 query: did the last-elaborated `main` infer to a bare Float return type?
-- Used by the LLVM/WasmGC emitters to render a bare Float value main correctly
-- even when the structural `mainKind`/`refMainKind` can't see through a polymorphic
-- HOF's return type (e.g. `main = fold (acc x => acc + x) 0.0 [1.0, 2.0, 3.0]`).
export
mainTypeIsFloat : Unit -> Bool
mainTypeIsFloat _ = match driverState.value.mainSchemeRef.value
  Some (Forall _ _ t) => match normalize t
    TCon "Float" _ => True
    _ => False
  None => False

-- ── non-exhaustive-match warning accumulator (the type-aware `check_match`) ──
-- `inferMatch` pushes a warning here for every `match` whose non-guarded arms
-- don't cover the scrutinee's type.  `matchOracle` is the ctor oracle the matrix
-- recursion consults; the `checkMatchToLines` driver sets it from the program's
-- data decls (so it sees the same user + builtin ctors check_match does) before
-- inference runs.  Neither is touched by `resetState` — the driver seeds them and
-- reads `matchWarnings` after the typecheck pass; runs that ignore match warnings
-- (the schemes/selfproc paths) simply never read it.
-- #159: element type is now `TcDiag` (severity 2), carrying the span (formerly the
-- parallel `matchWarningLocs`) and the actionable-fix help (formerly the message-
-- keyed `matchWarningHelp`) INLINE — no parallel lists, no lookup-by-message.  The
-- `TcDiag.msg` holds the FULL "Warning: …"-prefixed string exactly as the old
-- `List String` did, so the text-rendering paths (checkMatchToLines,
-- checkToLinesWithRuntime, checkModulesEntryReport) stay byte-identical; only the
-- prefix strip happens on the driver/diagnostics.mdk side.
--
-- ⚠️ THE `W-*` CODE IS AUTHORED AT THE PUSH SITE — write it into the `TcDiag`, never
-- leave it `""` for a downstream reader to guess.  `driver/diagnostics.mdk`'s
-- `diagOfTypeWarning` carries whatever code it finds here straight through to
-- `--json`; it used to re-derive one by prefix-matching this message text, which
-- silently relabelled any third warning `W-NONEXHAUSTIVE` (see that function's own
-- note, and DIAGNOSTIC-CODES-DESIGN.md — "*No chokepoint can infer these*").
-- Register the code in DIAGNOSTIC-CODES-DESIGN.md's warning table in the same change.
--
-- ⚠️ THE `W-` PREFIX IS LOAD-BEARING, not a naming convention.  The JSON `kind` is
-- DERIVED from the code's prefix (`codeKind`), so the code you write here decides
-- how every consumer classifies the diagnostic.  A demoted error that KEEPS its
-- `T-*` code is the trap: it reads as a type error to anything filtering the
-- per-stage taxonomy.  `diagKind` now stops that from rendering an incoherent
-- `{"kind":"type","severity":2}`, but it deliberately does NOT rewrite your code —
-- inventing `W-FOO` from `T-FOO` would be the same derive-identity-from-spelling
-- mistake in the other direction.  Author a `W-*` code; do not reuse the error's.
--
-- This is THE channel for a typecheck-stage warning — including one that used to be
-- an error.  Do NOT demote an error by pushing a severity-2 `TcDiag` through
-- `recordTypeError` instead: it arms `typeErrorsSticky` (aborts `build`/`run`) and
-- bumps `errorsDetected` (steers `erredDuring`-gated inference, issue 1146)
-- UNCONDITIONALLY, without reading severity at all — so the "warning" keeps both of
-- an error's side effects.  It does not even RENDER as a warning: `diagOfTypeError`
-- binds the severity field to `_` and prints severity 1.  (Removing that hardcode
-- would not rescue the idea — it would print severity 2 and still abort the build.
-- The side effects are the reason, not the rendering.)  `matchWarnings` has neither.

-- True iff the last typecheck pass pushed any match warning.  Read by the snapshot
-- runner (`tools/snapshot.mdk`) to decide whether a rendered `# TYPES` section carries
-- diagnostic prose — a `W-*` warning is graded by `compiler/ERROR-QUALITY.md` exactly
-- like an error is, so a `# TYPES` section holding one is NOT `--bless`-able.  Keyed on
-- the accumulator rather than sniffing the rendered text: the renderer must not have to
-- guess which of its own lines are diagnostics.
export
hadMatchWarnings : Unit -> Bool
hadMatchWarnings _ = match driverState.value.matchWarnings.value
  [] => False
  _ => True

-- #158 PR3: the ~58 per-RUN accumulators/counters that `resetState` clears are bundled
-- into ONE typed record so their reset lifecycle is a TYPE FACT, not a hand-maintained
-- block.  `freshPerRun` constructs exactly the field-Refs `resetState` installs, so "what
-- resetState clears" == "what PerRun holds" — enforced by the constructor: a new per-module
-- accumulator cannot be added without appearing in freshPerRun (and thus the reset).  This
-- is a record OF Refs (fields stay `Ref …`), NOT a record of values: the hot accumulators
-- (pendingSites, typeErrors, activeDictVars, …) are pushed with
-- `setRef x (v :: x.value)`, so the field must be a Ref for that to stay one Ref-write — a
-- record of values would rebuild the whole 58-field record on every push.  (`obls`,
-- `implObls`, `dictApps` — #838 I1 / #841 — are the exceptions: each a small `Windowed
-- a` VALUE whose own two fields are Refs — see `wPush` — so pushing through one is
-- still one Ref-write, not a whole-record rebuild.)
-- (#158 PR4 extracted shadowHeadCtxRef OUT of here into `Toggles`; its resetState clearing is
-- preserved by freshToggles being minted in the same resetState — see resetState below.)
data PerRun = PerRun {
    tyvarCounter : Ref Int,
    inRigidityBodyRef : Ref Bool,  -- True while an IMPL or DEFAULT method body is being inferred — the scope
    effvarCounter : Ref Int,  -- in which registerLocalScheme records obligations (see its comment)
    curEffect : Ref EffRow,  -- names GENERALIZED inside the top-level body currently being inferred
    recordByNameRef : Ref (OrdMap RecordInfo),  -- (local `let`/`where` helpers), reset at each body start: an occurrence resolving
    fieldOwnersRef : Ref (OrdMap (List String)),  -- to one is a LOCAL shadow, never a method occurrence, so no method obligation is recorded for it (round-2 adversarial break 3).
    dataParamKindsRef : Ref (List (TabKey, List Kind)),  -- A tyvar-id watermark was tried first and is UNSAFE: freshness-skipping
    aliasTableRef : Ref (List (TabKey, (List String, Ty))),  -- broke a top-level literal's fromInt obligation and surfaced a phantom
    pendingSites : Ref (List PendingEntry),  -- `Num a =>` on an unrelated scheme (types/numlit_bidir).
    pendingRLocalSites : Ref (List PendingEntry),
    shadowStandaloneSchemesRef : Ref (List (String, Scheme)),
    ifaceMethodSchemesByIdRef : Ref (List ((IfaceRef, String), Scheme)),  -- #1351 L1 EXPAND: the Module arm's interface-method schemes under an identity key — the substrate leaf L2 migrates `pickSchemes` onto.  No reader yet.
    definerShadowNamesRef : Ref (List String),
    definerShadowSigsRef : Ref (List (String, Ty)),
    bodyImplEnvRef : Ref ImplEnv,
    pendingBinopSites : Ref (List PendingEntry),
    pendingUnopSites : Ref (List PendingEntry),
    pendingArithSites : Ref (List (Ref Route, Mono)),
    methodIfaceParamsRef : Ref (OrdMap (IfaceRef, List String, Ty, List (String, List Kind))),
    registeredIfacesRef : Ref (OrdMap Unit),
    implObls : Windowed UObligation,  -- #841: pendingImplObligations/N, ported onto Windowed; #991: onto UObligation
    numlitRefs : Ref (List (Mono, Ref (Option Float), Int, Ref Route)),  -- #991 ask 3, RULED: the numeric-literal channel STAYS BESPOKE — it is Float-DEFAULTING machinery (`setNumlitFloats`), not obligation checking, so it is deliberately NOT ported onto `UObligation` like `implObls` above was
    poisonedVars : Ref (List Int),
    deferrableVarIds : Ref (List Int),  -- #838 I2: QUANTIFIED (forwarded) var ids of every generalized scheme — RULE 2 defers these
    tupleCallCandidates : Ref (List (Mono, String, Option (Loc, String))),
    numlitVarLocs : Ref (List (Mono, Loc)),
    numlitUntainted : Ref (List (Mono, Loc)),
    numlitOpLocs : Ref (List Loc),
    numlitCtxTags : Ref (List (Loc, String)),
    localBindRefs : Ref (List (String, Mono)),
    localSchemesOut : Ref (List (String, Scheme)),
    seedSchemesOut : Ref (List (String, Scheme)),
    pendingArgStamps : Ref (List PendingEntry),
    activeDictVars : Ref (List (Int, String)),
    -- #1956: the given is keyed by the predicate's WHOLE argument VECTOR, not by its
    -- lead argument alone (iface name, arg vector, dict param name).  A vector is the
    -- same predicate as another iff they have equal length and `monoSameGiven` holds at
    -- every position, in order — see `monoVecSameGiven`.
    activeDictPreds : Ref (List (String, List Mono, String)),
    -- #1154 RESIDUAL: the impl-`requires` twin of `enclPreds`.  One entry per dict slot
    -- an impl's `requires` opens: the tyvar ids the slot is keyed on, and the WHOLE
    -- predicate that slot discharges.  `activeDictVars` above cannot answer a body's
    -- method site on its own — every entry of `requires Ix a Char, Dbg2 a` carries the
    -- SAME id `a`, so its first-match returns the LAST-registered slot for every method
    -- in the body.  See `implReqDictVarOf`.
    implReqPreds : Ref (List (String, List Int, Predicate)),
    funConstraintsRef : Ref (List (String, List Int)),
    funConstraintDeclaredRef : Ref (List (String, CDeclaredPrefix)),
    funConstraintArgsRef : Ref (List (String, List (List Mono))),
    funConstraintIfacesRef : Ref (List (String, List IfaceRef)),
    currentImportDefinersRef : Ref (List (String, String)),
    currentImportOriginsRef : Ref (List (String, String)),
    importedSchemeOblsRef : Ref (OrdMap (List VecObl)),  -- #1114/#845: this module's imported bindings' scheme contexts, keyed by LOCAL spelling (see importedSchemeOblEntries)
    dictApps : Windowed (Ref (List Route), List Mono, List String, List (List Mono), Option Loc),  -- #841: pendingDictApps/N, ported onto Windowed
    obls : Windowed UObligation,  -- #838 I1: the call channel (pendingCallObligations/N), ported onto Windowed
    absorptions : Windowed AbsorptionEvent,  -- #839 2a: row-unifier atom-discard trail (write-only in 2a); windowed per body by the existing obls brackets
    schemeObligationsRef : Ref (List ((String, Int), List VecObl)),  -- #837: keyed by (binding-name, binding-id) — the id from resolve's
    schemeDefIdsRef : Ref (OrdMap Int),  -- stampBindingIds, so a where-helper `g`'s obligations can no longer leak
    methodConstraintsRef : Ref (List (String, List Int)),  -- onto an unrelated top-level `g` (retires the three snapshot/restore windows).
    methodConstraintPositionsRef : Ref (List (String, List Int)),  -- id 0 = a local/where/cross-module binder → the bare-name fallback path.
    pendingMethodDicts : Ref (List (Ref (List Route), List Mono)),
    pendingRecDictApps : Ref (List RecDictApp),  -- #837: each TOP-LEVEL value binder → its stampBindingIds id, set once per
    currentFn : Ref String,  -- module (checkBodyImpl) right after stamping.  registerSchemeObligations
    currentImplBody : Ref Bool,  -- reads it to tag a top-level member's obligations with its binding id.
    methodSiteFns : Ref (OrdMap (List Mono)),
    dictAppFns : Ref (OrdMap (List (List Mono))),
    residualUnivRef : Ref ImplUniverse,
    promotedRef : Ref (List String),
    methodShadowNamesRef : Ref (OrdMap Unit),
    flatShadowScopingRef : Ref Bool,
    flatCoreFnNamesRef : Ref (OrdMap Unit),
    flatUserShadowNamesRef : Ref (List String),
    groupConstraintMonosRef : Ref (List (String, Mono)),
    typeErrors : Windowed TcDiag,  -- issue 1146: the diagnostic OUTPUT channel, on the Windowed discipline
    errorsDetected : Ref Int,  -- issue 1146: the CONTROL signal split out of it — see recordTypeError / erredDuring
    occursCheckFailed : Ref Bool,
    currentLevel : Ref Int,
    pinnedLocals : Ref (List (Mono, String, String, Option Loc)),  -- #866: one entry per LOCAL binding whose
  }  -- generalization dictForwardedIds declined, as (the pinned tyvar AS A MONO, binding name, the interface whose

-- ⚠️ #1557 A-3.5c REMOVED `ifaceParamKindsRef` from this record, and with it the
-- `universeIfaceParamKinds` CrossRun cell that marshalled it between modules.  Its
-- one reader (`checkGradedImplTys`) reads stage K's `CE` instead; the writer
-- (`registerIfaceParamKinds`) is gone too, since a table nobody reads is not a
-- second source of truth worth keeping (design law L1).

-- dict it forwards, the binding's own loc).  Read ONLY by pinnedLocalExplain,
-- to turn the downstream `Type mismatch` such a pin causes into a diagnostic
-- that points at the BINDING and says why.  The tyvar is stored as a Mono, not
-- an id, so `normalize` recovers what it was later unified to without any hook
-- on the (hot, allocation-sensitive) unify path.  Per-module by construction:
-- freshPerRun re-mints it, so a stale entry cannot label a later module.

-- Construct every field fresh (each reproduces its former top-level ref's initial).
-- ⚠️ NO COUNT HERE, deliberately.  This line read "all 64 field-Refs" and was wrong on
-- `main` before #1557 A-3.5c touched it (the record had 65 fields, only 60 of them
-- `Ref` — the other 5 are `Windowed`), so decrementing it to 63 propagated an
-- inherited error with a fresh-looking number.  Derive it instead:
--   sed -n '/^data PerRun = PerRun {$/,/^  }/p' compiler/types/typecheck.mdk \
--     | grep -cE '^    [a-zA-Z][A-Za-z0-9_]* : '            # fields
--   ... | grep -cE '^    [a-zA-Z][A-Za-z0-9_]* : Ref '      # of which Refs
-- ⚠️ `/^  }/`, NOT `/^  }$/` — this record's closing brace carries a trailing comment
-- (`}  -- generalization dictForwardedIds declined, as …`), so the anchored form does
-- not match it, the sed range runs on to the next record and the count comes back
-- inflated.  Measured while writing this comment: the anchored form says 73, the
-- correct one 65.  A derivation is only honest if someone ran it.
freshPerRun : Unit -> PerRun
freshPerRun _ = PerRun {
  tyvarCounter = Ref 0,
  inRigidityBodyRef = Ref False,
  effvarCounter = Ref 0,
  curEffect = Ref (EffRow [] None),
  recordByNameRef = Ref omEmpty,
  fieldOwnersRef = Ref omEmpty,
  dataParamKindsRef = Ref [],
  aliasTableRef = Ref [],
  pendingSites = Ref [],
  pendingRLocalSites = Ref [],
  shadowStandaloneSchemesRef = Ref [],
  ifaceMethodSchemesByIdRef = Ref [],
  definerShadowNamesRef = Ref [],
  definerShadowSigsRef = Ref [],
  bodyImplEnvRef = Ref emptyImplEnv,
  pendingBinopSites = Ref [],
  pendingUnopSites = Ref [],
  pendingArithSites = Ref [],
  methodIfaceParamsRef = Ref omEmpty,
  registeredIfacesRef = Ref omEmpty,
  implObls = wNew (),
  numlitRefs = Ref [],
  poisonedVars = Ref [],
  deferrableVarIds = Ref [],
  tupleCallCandidates = Ref [],
  numlitVarLocs = Ref [],
  numlitUntainted = Ref [],
  numlitOpLocs = Ref [],
  numlitCtxTags = Ref [],
  localBindRefs = Ref [],
  localSchemesOut = Ref [],
  seedSchemesOut = Ref [],
  pendingArgStamps = Ref [],
  activeDictVars = Ref [],
  activeDictPreds = Ref [],
  implReqPreds = Ref [],
  funConstraintsRef = Ref [],
  funConstraintDeclaredRef = Ref [],
  funConstraintArgsRef = Ref [],
  funConstraintIfacesRef = Ref [],
  currentImportDefinersRef = Ref [],
  currentImportOriginsRef = Ref [],
  importedSchemeOblsRef = Ref omEmpty,
  dictApps = wNew (),
  obls = wNew (),
  absorptions = wNew (),  -- #839 2a: resets per module for free via this whole-record re-mint
  schemeObligationsRef = Ref [],
  schemeDefIdsRef = Ref omEmpty,
  methodConstraintsRef = Ref [],
  methodConstraintPositionsRef = Ref [],
  pendingMethodDicts = Ref [],
  pendingRecDictApps = Ref [],
  currentFn = Ref "",
  currentImplBody = Ref False,
  methodSiteFns = Ref omEmpty,
  dictAppFns = Ref omEmpty,
  residualUnivRef = Ref emptyImplUniverse,
  promotedRef = Ref [],
  methodShadowNamesRef = Ref omEmpty,
  flatShadowScopingRef = Ref False,
  flatCoreFnNamesRef = Ref omEmpty,
  flatUserShadowNamesRef = Ref [],
  groupConstraintMonosRef = Ref [],
  typeErrors = wNew (),
  errorsDetected = Ref 0,
  occursCheckFailed = Ref False,
  currentLevel = Ref 0,
  pinnedLocals = Ref [],
}

-- The single module-level cell holding the current run's per-module accumulator bundle.
perRun : Ref PerRun
perRun = Ref (freshPerRun ())

-- Replacing `perRun` with a fresh bundle IS the per-module reset: freshPerRun re-mints
-- every field, so the set that resets == the set in PerRun, enforced by the constructor.
-- #80/#201: resetState does NOT (re-)seed effect domains.  effectDomains is now owned by
-- populateEffectDomains, called ONCE per compile over the WHOLE import graph
-- (checkProgramSeededSplit for the flat path; checkModulesPreamble / elaborateModules driver
-- preambles for the multi-module paths).  A per-module re-seed here would wipe module A's
-- declared effect domains before module B is checked — a module using an effect declared in A
-- would then see only builtins.  effectDomains has exactly ONE writer (populateEffectDomains →
-- seedEffectDomains + registerEffectDomain), so it persists untouched across the per-module
-- resets — and it is NOT a PerRun field, so freshPerRun cannot disturb it.
-- #158 PR4: mint a fresh Toggles in the SAME reset that mints freshPerRun, so
-- shadowHeadCtxRef (formerly a PerRun field) is still cleared per-module at exactly this
-- point.  The other two toggles are always False at a module boundary (their save/restore
-- brackets never straddle one), so re-minting them here is a no-op — byte-identical.
resetState : Unit -> Unit
resetState _ =
  perRun := freshPerRun ()
  toggles := freshToggles ()

-- ── small helpers ─────────────────────────────────────────────────────────
lookupAssocI : Int -> List (Int, b) -> Option b
lookupAssocI _ [] = None
lookupAssocI k ((k2, v)::rest)
  | k == k2 = Some v
  | otherwise = lookupAssocI k rest

containsI : Int -> List Int -> Bool
containsI _ [] = False
containsI x (y::ys) = x == y || containsI x ys

-- `support/util`'s `anyList` takes a PURE predicate, so it cannot carry the
-- path-compressing (hence `<Mut>`) mono predicates below — `monoIsFunction`,
-- `numUnimplementableHead`, … all normalize.  Same short-circuiting `||` fold, one
-- effect row wider.  (Medaka has no effect-polymorphic HOFs, so this must be a
-- second definition rather than a reuse of `anyList`.)
anyListM : (a -> Bool) -> List a -> Bool
anyListM _ [] = False
anyListM p (x::xs) = p x || anyListM p xs

-- ── union-find core ───────────────────────────────────────────────────────
-- PERF (issue #115): this is a union-find FIND, and it PATH-COMPRESSES.  Without
-- compression it was the compiler's worst performance defect: `unifyVars` links the
-- current root to the *fresh* var it meets (`bindVar c1 (TVar c2)`), so inferring a
-- single large declaration — an N-arm `match` whose arms all unify against one
-- result var, an N-element list literal — builds a Link chain of length N.  Every
-- later `normalize`/`rootIdOf` of any var in that class then walked O(N) links, and
-- the post-inference walkers (`walkDispatch`, `setNumlitFloatsGo`, `monoUnboundIds`)
-- plus the Chunk-D numlit scans do that once per literal ⇒ O(N²) link steps, on a
-- non-allocating hot loop that no allocation-graded gate could see.  Compression
-- makes it amortized near-O(1) and leaves the ROOT IDENTITY untouched — this is a
-- representation change only, so no program's inferred type moves.
--
-- Returns the ARGUMENT ITSELF (never a rebuilt `TVar`) when already at a root, so
-- the overwhelmingly common case allocates nothing — the old multi-clause form's
-- `Unbound _ _ => TVar cell` rebuilt a cell on every call.  That is why this matches
-- on the whole parameter instead of destructuring it in the head: a multi-clause
-- definition cannot name the value it matched, so it cannot give it back unchanged.
export
normalize : Mono -> Mono
-- lint-disable-next-line rule-match-on-param
normalize m = match m
  TVar cell => match !cell
    Link t => normalizeLink cell t
    Unbound _ _ => m
  _ => m

-- [cell] is a `Link` to [t]: resolve [t] to its root, re-point [cell] STRAIGHT at
-- that root, and return it.  The write happens only when the chain is longer than
-- one hop — a direct link is already compressed, so re-writing it would be pure cost.
-- Matches on the whole [t] for the same no-rebuild reason as `normalize` above.
normalizeLink : Ref Tyvar -> Mono -> Mono
-- lint-disable-next-line rule-match-on-param
normalizeLink cell t = match t
  TVar c2 => match !c2
    Unbound _ _ => t
    Link t2 =>
      let r = normalizeLink c2 t2
      cell := Link r
      r
  _ => t

-- #1576: the structural node count of a monotype.  Its ONLY consumer is the SHRINKING
-- test in `argImplRequiresRoutes` — it is a termination signal, not a semantic one, so
-- nothing here needs to agree with any other notion of type size.
--
-- Links are followed (`normalize`) so a solved tyvar is measured at what it stands for
-- rather than as one node; an unbound one is a leaf.  An EFFECT ROW counts as a single
-- node (`TFun` ignores its row, `TEff` is a leaf): the shrinking argument is about the
-- TYPE spine a `requires` chain walks down.  Under-counting a CHILD more than its parent —
-- exactly what the effect-row leaf above does — makes a step look shrinking (free), not
-- NON-shrinking; it is over-counting a child that would make a step look non-shrinking,
-- burning fuel and terminating.  Either way the measure stays a well-founded natural, so
-- termination does not depend on which direction the under-count goes.
monoSize : Mono -> Int
monoSize m = match normalize m
  TApp f a => 1 + monoSize f + monoSize a
  TFun a _ r => 1 + monoSize a + monoSize r
  _ => 1

-- A predicate's goal is its whole ARGUMENT VECTOR (§3 `match(IE, C τ̄)`), so the size
-- the shrinking test compares is the vector's, not arg 0's.
monoSizes : List Mono -> Int
monoSizes [] = 0
monoSizes (m::rest) = monoSize m + monoSizes rest

-- How many NON-SHRINKING `requires` steps a route chain may take before the fuse cuts
-- it.  Only a genuinely non-shrinking context (`impl C (T a) requires C (T (T a))`)
-- spends this; a shrinking chain spends one unit at its seed and nothing after, so the
-- constant bounds divergence WITHOUT bounding the depth of any valid program — it is now
-- the ONLY thing standing between a valid program and an unbounded search (#1924).  See
-- `argImplRequiresRoutes`.
requiresNonShrinkingFuel : Int
requiresNonShrinkingFuel = 32

tyvarId : Ref Tyvar -> Int
tyvarId cell = match !cell
  Unbound id _ => id
  Link _ => 0 - 1

tyvarLevel : Ref Tyvar -> Int
tyvarLevel cell = match !cell
  Unbound _ lvl => lvl
  Link _ => 0

-- occurs-check + lower the levels of vars in [t] to <= [level] (Phase: Rémy levels)
occursAdjust : Int -> Int -> Mono -> Unit
occursAdjust id level t = match normalize t
  TVar cell => occursAdjustVar id level cell
  TCon _ _ => ()
  TRigid _ => ()
  TApp a b =>
    let _ = occursAdjust id level a
    occursAdjust id level b
  TFun a r b =>
    let _ = occursAdjust id level a
    let _ = lowerRowLevels level r
    occursAdjust id level b
  TEff r => lowerRowLevels level r

occursAdjustVar : Int -> Int -> Ref Tyvar -> Unit
occursAdjustVar id level cell = match !cell
  Unbound id2 lvl2 => occursAdjustUnbound id level cell id2 lvl2
  Link t => occursAdjust id level t

occursAdjustUnbound : Int -> Int -> Ref Tyvar -> Int -> Int -> Unit
occursAdjustUnbound id level cell id2 lvl2
  | id2 == id =
    perRun.value.occursCheckFailed := True
    pushTypeError
      "T-INFINITE-TYPE"
      ("Cannot construct infinite type involving " ++ ppMono (TVar cell))
  | lvl2 > level = cell := Unbound id2 level
  | otherwise = ()

unify : Mono -> Mono -> Unit
unify a b = unifyN (normalize a) (normalize b)

unifyN : Mono -> Mono -> Unit
unifyN (TVar c1) (TVar c2) = unifyVars c1 c2
unifyN (TVar c) t = bindVar c t
unifyN t (TVar c) = bindVar c t
-- #1111 A-2.10: the head comparison READS THE IDENTITY Stage A-1 landed.  This
-- is the site the arc turned on — two modules' unrelated `T`s no longer unify
-- (#1208, #1209), and the origin surviving a link is no longer an artefact of
-- link direction, so a key computed from the field is a function of the type.
-- `sameTyConHead` (`frontend/ast.mdk`) owns the absent-origin rule; read its
-- derivation before changing either side of this.
unifyN (ta@(TCon a oa)) (tb@(TCon b ob)) =
  if sameTyConHead a oa b ob then
    ()
  else
    typeMismatch ta tb
-- #1110: rigid~rigid.  MANDATORY, not optional — without it a rigid variable
-- fails to unify with ITSELF (it would fall to the catch-all `typeMismatch`),
-- which the shared `TCon` constructor used to handle for free.
unifyN (TRigid a) (TRigid b) =
  if a == b then
    ()
  else
    typeMismatch (TRigid a) (TRigid b)
-- #1110 CROSS-POPULATION, and it is NOT dead code.  A rigid and a real head can
-- share a name — both spell `__tupleN__` (see `Mono.TRigid`) — so the pre-split
-- `TCon a == TCon b` test could be TRUE across the populations, and dropping
-- these two arms changes an answer: `data Bad = Bad __tuple2__; g : Bad -> (,)`
-- checked clean before the split and becomes `Type mismatch: (,) vs (,)` without
-- them — an error whose two sides render IDENTICALLY.  For every other name the
-- test is False and the message is byte-identical to the catch-all's, since
-- `ppMono` renders `TRigid` exactly as `TCon`.  Placed ABOVE the
-- `tupleUnifyClash` guard because the old `TCon`/`TCon` arm was above it too.
--
-- ⚠️ The preserved answer is a FORGERY (DICT-SEMANTICS §8 I6.2(b), OWED-#1110):
-- a rigid variable is not the builtin tuple head.  Carrier now, semantics later.
unifyN (ta@(TCon a _)) (tb@(TRigid b)) =
  if a == b then
    ()
  else
    typeMismatch ta tb
unifyN (ta@(TRigid a)) (tb@(TCon b _)) =
  if a == b then
    ()
  else
    typeMismatch ta tb
-- A tuple TYPE is now a `__tupleN__`-headed `TApp` spine; when it clashes with a
-- differing-arity tuple or with a concrete non-tuple head, report the FULL types
-- (which render `(a, b)` via ppGo) instead of letting the generic `TApp~TApp`
-- recursion bottom out on a partial sub-spine — preserving the pre-refactor
-- tuple mismatch wording.  Guard is False when the other side is a TVar-headed
-- spine (so `p a b` unifying with a tuple still flows through the generic arm).
unifyN t1 t2
  | tupleUnifyClash t1 t2 = typeMismatch t1 t2
unifyN (TApp a1 b1) (TApp a2 b2) =
  let _ = unify a1 a2
  unify b1 b2
unifyN (TFun a1 r1 b1) (TFun a2 r2 b2) =
  let _ = unify a1 a2
  let _ = unifyRow r1 r2
  unify b1 b2
-- #1094: an `Effect`-kinded type-ARGUMENT row is INVARIANT and gets its own unifier.
-- `unifyRow` is the ARROW-row unifier; its closed~closed leniency is justified for a
-- latent row and is a silent laundering hole for an index.  See `unifyIndexRow`.
unifyN (TEff r1) (TEff r2) = unifyIndexRow r1 r2
unifyN a b = typeMismatch a b

unifyVars : Ref Tyvar -> Ref Tyvar -> Unit
unifyVars c1 c2 = if tyvarId c1 == tyvarId c2 then () else bindVar c1 (TVar c2)

bindVar : Ref Tyvar -> Mono -> Unit
bindVar cell t =
  perRun.value.occursCheckFailed := False
  let _ = occursAdjust (tyvarId cell) (tyvarLevel cell) t
  if perRun.value.occursCheckFailed.value then () else cell := Link t

-- Chunk A: record the union-find roots of every free var on either side of a
-- unification failure so a later obligation check can suppress a secondary
-- `ambiguous instance` cascade on the same (already-errored) var.
poisonMismatchVars : Mono -> Mono -> Unit
poisonMismatchVars a b =
  let poisoned = monoUnboundIds a ++ monoUnboundIds b ++ perRun.value.poisonedVars.value
  perRun.value.poisonedVars := poisoned

typeMismatch : Mono -> Mono -> Unit
typeMismatch a b =
  let _ = poisonMismatchVars a b
  typeMismatchReport a b

typeMismatchReport : Mono -> Mono -> Unit
typeMismatchReport a b = match !currentMethodMismatch
  Some mname => pushTypeError "T-METHOD-MISMATCH" "Method '\{mname}': expected type \{ppMono a} but got \{ppMono b}"
  None => match pinnedLocalExplain a b
    -- #866: this mismatch IS the pin (see pinnedLocalExplain) — report the binding.
    Some entry => pinnedLocalMismatch entry a b
    None => typeMismatchReportRest a b

-- #866 Blocker 3.  ERROR-QUALITY.md: LOCATED at the binding (the token the user must
-- change, not the downstream victim), ROOT-CAUSE-HONEST (names the pin, not the
-- symptom), IN THE USER'S VOCABULARY (interface name and `let`/`where`, never "dict",
-- "route", "RNone" or a tyvar id), ACTIONABLE (two concrete edits, the first of which
-- always works), CATEGORIZED (its own code, registered in DIAGNOSTIC-CODES-DESIGN.md).
pinnedLocalMismatch : (Mono, String, String, Option Loc) -> Mono -> Mono -> Unit
pinnedLocalMismatch (_, name, iface, loc) a b =
  let help = "give '\{name}' a top-level definition instead — a top-level binding can be polymorphic in a constrained type, a local one cannot — or use it at one type only"
  pushTypeErrorHelpFixAt
    "T-LOCAL-CONSTRAINED-MONO"
    loc
    "local binding '\{name}' is used at two different types (\{ppMono a} and \{ppMono b}), but it cannot be polymorphic: \{constraintPhrase iface}, and only top-level definitions can carry that constraint"
    help
    None

-- Names the interface when we know it, and stays honest when we do not (the method
-- pin channel does not always carry one — see argStampPairs).  Never says "dict",
-- "route" or a tyvar id: ERROR-QUALITY.md §1, the user's vocabulary.
constraintPhrase : String -> String
constraintPhrase iface
  | iface == "" =
    "its body needs a type-class instance chosen from the type it is used at"
  | otherwise = "its body calls something that needs \{indefiniteArticle iface} '\{iface}' instance"

-- "a"/"an" for an interface name, so the message reads as English for both `Ord` and
-- `Debug`.  Interface names are ASCII identifiers, so first-letter vowel is the whole
-- rule; an empty name (unreachable — every constraint slot carries an iface) takes "a".
indefiniteArticle : String -> String
indefiniteArticle name
  | stringLength name == 0 = "a"
  | contains (stringSlice 0 1 name) ["A", "E", "I", "O", "U"] = "an"
  | otherwise = "a"

typeMismatchReportRest : Mono -> Mono -> Unit
typeMismatchReportRest a b = match !currentDoOrigin
    Some doLoc => typeMismatchInDo a b doLoc
    None => match firstTupleCallHint [a, b]
      -- P0-16: one side is a tuple-call residual (e.g. `z : Int; z = add(1, 2)`
      -- → `Type mismatch: Int vs (a, b) -> (a, b)`) — append the call-syntax hint.
      Some (help, fix) =>
        pushTypeErrorHelpFixAt "T-TYPE-MISMATCH" !currentLoc "Type mismatch: \{ppMono a} vs \{ppMono b} — \{help}" help fix
      None => match sameSpellingHint a b
        -- #1111 A-2.10: the mismatch this unit MAKES REACHABLE renders with two
        -- identical sides (`Type mismatch: T vs T`) — true, and useless without
        -- this.  Turning a silent accept into a message a user cannot act on
        -- would trade an S0 for an S2, which the severity ladder counts as a
        -- fix only for the first half.
        Some help =>
          pushTypeErrorHelpFixAt "T-TYPE-MISMATCH" !currentLoc "Type mismatch: \{ppMono a} vs \{ppMono b} — \{help}" help None
        None => pushTypeError "T-TYPE-MISMATCH" "Type mismatch: \{ppMono a} vs \{ppMono b}"

-- ── same-spelling mismatch hint (#1111 A-2.10) ─────────────────────────────
-- Fires ONLY when the two sides RENDER identically and some head inside them
-- carries two conflicting module identities — i.e. exactly the mismatch this
-- unit newly reports.  Both conditions matter: the render test is what makes
-- the hint appear where the message is otherwise unreadable, and the conflict
-- search is what lets it name the two modules instead of hand-waving.
--
-- ⚠️ IT CANNOT MOVE AN EXISTING GOLDEN, and that is structural rather than
-- lucky: `firstIdConflict` answers `Some` only where both origins are present
-- and differ, and before this unit every such pair UNIFIED — so no diagnostic
-- that exists today can reach this arm.  (The other in-tree source of two
-- identically-rendering sides, the `__tupleN__` rigid-vs-builtin forgery at
-- `unifyN`'s cross-population arms, is a `TRigid`: it carries no origin, so it
-- yields `None` here and its message is untouched.  That residual is #1243.)
sameSpellingHint : Mono -> Mono -> Option String
sameSpellingHint a b
  | ppMono a /= ppMono b = None
  | otherwise = map idConflictHelp (firstIdConflict a b)

idConflictHelp : (String, TyConOrigin, TyConOrigin) -> String
idConflictHelp (name, o1, o2) = "these are two DIFFERENT types that share the name '\{name}': one comes from \{originPhrase o1}, the other from \{originPhrase o2} — import the one you mean rather than declaring a second type of the same name"

-- User vocabulary, never a constructor spelling (ERROR-QUALITY.md §1).  The
-- unresolved case is unreachable from `firstIdConflict` (a conflict needs two
-- present identities) and is answered rather than omitted so this stays total.
originPhrase : TyConOrigin -> String
originPhrase (OriginModule m) = "module '\{m}'"
originPhrase OriginBuiltin = "the language itself"
originPhrase OriginUnresolved = "an unknown module"

-- The FIRST head, in a parallel structural walk of the two monos, whose name
-- agrees while its identity does not.  Parallel and shape-guarded on purpose:
-- the two sides render identically (the caller's precondition), so they have
-- the same shape, and walking them together is what pairs the conflicting head
-- with its counterpart rather than reporting some unrelated head.
firstIdConflict : Mono -> Mono -> Option (String, TyConOrigin, TyConOrigin)
firstIdConflict a b = match (normalize a, normalize b)
  (TCon n1 o1, TCon n2 o2) =>
    if n1 == n2 && not (sameTyConHead n1 o1 n2 o2) then
      Some (n1, o1, o2)
    else
      None
  (TApp f1 x1, TApp f2 x2) =>
    orElseOpt (firstIdConflict f1 f2) (firstIdConflict x1 x2)
  (TFun d1 _ r1, TFun d2 _ r2) =>
    orElseOpt (firstIdConflict d1 d2) (firstIdConflict r1 r2)
  _ => None

-- a mismatch inside a do-lowered chain: if it is the monad-shape (`m b`) vs
-- non-monad obligation, retarget to the tailored "do requires a monad" error;
-- otherwise fall back to the plain mismatch (the loc stays the do-block's).
typeMismatchInDo : Mono -> Mono -> Loc -> Unit
typeMismatchInDo a b doLoc
  | monoIsApp (normalize a) /= monoIsApp (normalize b) =
    recordDoMonadError doLoc
  | otherwise =
    pushTypeError "T-TYPE-MISMATCH" "Type mismatch: \{ppMono a} vs \{ppMono b}"

-- issue 1146 PR1: this is the SIXTH push site — it open-coded the cons + sticky set
-- rather than going through one of the five named `pushTypeError*` helpers, so it is
-- invisible to a grep for them.  It now routes through `recordTypeError` like every
-- other push, which is what makes this path's detection reach the counter too.
-- (It does NOT re-establish "counter delta == list-length delta": PR2 abolished that
-- equality on purpose — see `recordTypeError`.)
recordDoMonadError : Loc -> Unit
recordDoMonadError doLoc =
  currentDoOrigin := None
  recordTypeError (TcDiag
    "T-DO-NOT-MONAD"
    1
    (Some doLoc)
    doRequiresMonadMsg
    None
    None)

monoIsApp : Mono -> Bool
monoIsApp (TApp _ _) = True
monoIsApp _ = False

doRequiresMonadMsg : String
doRequiresMonadMsg = "`do` requires a Thenable impl (e.g. `Option`/`Result`). For IO sequencing use a bare indented block, not `do`"

-- SYMMETRIC complement of doRequiresMonadMsg: a `<-` bind reached a bare
-- (non-`do`) block.  `<-` is monadic-`do`-only; a bare indented block is IO
-- sequencing and does not allow it (language-design.md; "IO is not a monad").
bindOutsideDoMsg : String
bindOutsideDoMsg = "`<-` bind is only valid inside a `do` block. For IO sequencing use a bare indented block without `<-`"

-- ── generalization & instantiation ────────────────────────────────────────
generalize : Mono -> Scheme
generalize t =
  Forall
    (dedupI (freeGenVars perRun.value.currentLevel.value t))
    (dedupI (freeEffvars t))
    t

-- Generalize each captured local binding's (now-solved) mono into a Scheme for
-- the LSP hover fallback (see localBindRefs).  Runs at the end of inference when
-- currentLevel is back at the top, so a still-free local var quantifies cleanly
-- to `a`; a ground var (e.g. a `let` bound to a String) renders concretely.
mapLocalSchemes : List (String, Mono) -> List (String, Scheme)
mapLocalSchemes [] = []
mapLocalSchemes ((n, m)::rest) = (n, generalize m) :: mapLocalSchemes rest

-- ── value restriction (T1) ────────────────────────────────────────────────
-- A binding RHS is *non-expansive* (a syntactic value) iff it cannot allocate a
-- mutable cell: literals, variables and lambdas are values; annotations are
-- transparent; tuples/lists are values iff their elements are.  Constructor
-- applications of non-expansive arguments are non-expansive (SML value
-- restriction relaxation, Phase 66 extension) EXCEPT `Ref`, excluded by name in
-- `isCtorAppSpine` below: generalizing `Ref x` would be unsound (polymorphic
-- reference: write at one type, read at another).
--
-- 🔒 THE HEAD TEST IS AN ACTUAL CONSTRUCTOR LOOKUP, NOT A SPELLING TEST —
-- issue 1150 (S0, memory-safety), fixed 2026-08-26.  `isCtorAppSpine`'s head
-- arms ask `lookupCtor env name`, so the predicate now answers "is this name a
-- REAL, DECLARED constructor?" instead of "does this name start with a capital
-- letter?".  Threading the `TcEnv` this needs is why `isNonexpansive`,
-- `isCtorAppSpine`, `clausesAreValue`/`clauseIsValue`,
-- `memberClauseIsValue` and `sccSchemes` all take an env parameter.
--
-- What the old first-character heuristic (`ctorHeadIsUpper`, retained below
-- only as a cheap pre-filter) got wrong: a MODULE ALIAS is REQUIRED to be
-- uppercase (`aliasNameFor`, frontend/parser.mdk — lowercase is a hard parse
-- error) and an alias-qualified value desugars to a FLAT `EVar` carrying the
-- dotted name (`rewriteAliasQual`, frontend/desugar.mdk, via `qualifiedLocal`
-- in frontend/ast.mdk: `"\{alias}.\{n}"`).  So `ctorHeadIsUpper "H.new"` read
-- `'H'` and said True: EVERY alias-qualified call in the language was
-- CLASSIFIED as a constructor application.  Classification is not the whole
-- test — `isCtorAppSpine (EApp f x) = isCtorAppSpine f && isNonexpansive x`
-- still rejects the spine if any argument is expansive, so `H.f (g 1)` was
-- classified but NOT generalized.  It was enough for the repro, whose argument
-- is a value: `let m = H.new ()` over `stdlib/hash_map.mdk` yielded a
-- polymorphic mutable table — `check` exit 0, `run` E-NOT-A-FUNCTION, built
-- binary SEGFAULT.  Under the lookup, `"H.new"` is absent from the ctor map and
-- the binding is value-restricted: `check` REJECTS the program.
--
-- Why the lookup is sound (i.e. why "present in the ctor map" implies "really a
-- constructor").  `lookupCtor` reads `TcEnv`'s 2nd `OrdMap`, and that map is
-- written in exactly TWO places — `addCtor` (sole call site, inside
-- `addVariants`, reached only from `registerVariants`, itself called only from
-- `registerData`'s `DData` and `DNewtype` arms) and the two prelude ctors
-- `True`/`False`, hand-seeded straight into the map by `initialEnv`, bypassing
-- `addCtor` entirely.  Both writers are constructor-only.  ("Populated only by
-- `addCtor`", which this comment asserted until 2026-07-31, was false — hence
-- the second clause.)  Re-derive with
-- `grep -n 'addCtor\|initialEnv' compiler/types/typecheck.mdk`.
--
-- The uppercase-mutable-cell-extern hazard this comment used to warn about is
-- retired BY CONSTRUCTION rather than by audit: the grammar still permits an
-- uppercase extern NAME (`externNameFor (TUpper x) = emit x`,
-- frontend/parser.mdk, vs `identNameFor`, which accepts only `TIdent`), but an
-- extern is never passed to `addCtor`, so no extern — uppercase or not — can
-- pass the head test any more.  `Ref` (`extern Ref : a -> Ref a`,
-- stdlib/runtime.mdk) is exactly such an extern; its by-name exclusion is kept
-- below purely as defense-in-depth, since the lookup alone already rejects it.
-- See issue 1150 and docs/spec/DICT-SEMANTICS.md §4.1 G2.
--
-- Record creates are non-expansive iff all field expressions are.
-- Note: this ignores the `mut` flag (like the oracle), so `let mut x = []`
-- generalizes — the separate `mut`-gen hole is a both-sides follow-up (T1b).
isNonexpansive : TcEnv -> Expr -> Bool
isNonexpansive env (ELoc _ e) = isNonexpansive env e
isNonexpansive env (EDoOrigin _ e) = isNonexpansive env e
isNonexpansive _ (ELit _) = True
isNonexpansive _ (EVar _) = True
isNonexpansive _ (EVarId _ _) = True
isNonexpansive _ (ELam _ _) = True
isNonexpansive env (EAnnot e _) = isNonexpansive env e
isNonexpansive env (EHeadAnnot e _) = isNonexpansive env e
isNonexpansive env (ETuple es) = allList (isNonexpansive env) es
isNonexpansive env (EListLit es) = allList (isNonexpansive env) es
-- Constructor application: non-expansive iff the spine head is an EVar naming a
-- REAL, DECLARED constructor (`lookupCtor env`, see the 🔒 above and issue
-- 1150) — that is NOT `Ref`, and every spine argument is itself non-expansive.
-- Partial ctor applications (e.g. `MkTwo []`) are also non-expansive — they are
-- closures, not mutable cells.  `isCtorAppSpine` strips ELoc/EDoOrigin wrappers
-- before testing.
isNonexpansive env (app@(EApp _ _)) = isCtorAppSpine env app
-- Record creation: non-expansive iff every field expression is non-expansive.
isNonexpansive env (ERecordCreate _ fs) = allList
  (fa => match fa
    FieldAssign _ e => isNonexpansive env e)
  fs
isNonexpansive _ _ = False

-- Walk the left spine of an application to its head, testing EVERY argument met
-- on the way, and finally test whether the head IS a constructor that is safe to
-- generalize: an EVar naming a constructor DECLARED in this `TcEnv`, asked of
-- the environment via `lookupCtor` rather than guessed from the name's spelling
-- (issue 1150, fixed 2026-08-26 — see the 🔒 on `isNonexpansive` above for why
-- the ctor map's two writers make the lookup sound).  `Ref` stays excluded by
-- name as defense-in-depth: it is an extern FUNCTION, never passed to
-- `addCtor`, so `lookupCtor` already rejects it on its own.
--
-- `ctorHeadIsUpper` is retained as a pure FAST PATH in front of the lookup: an
-- ordinary function-application head — the overwhelmingly common `let` RHS —
-- fails on a single character read instead of an `OrdMap` probe.  It can only
-- ever narrow, never widen, and it narrows nothing today: every key in the ctor
-- map is uppercase-initial, because the parser requires a constructor name to
-- be `TUpper` and the two hand-seeded prelude ctors are `True`/`False`.  Were
-- that ever to change, the pre-filter would cost a generalization, not
-- soundness.
--
-- The arguments are tested HERE, on the single walk to the head, rather than by
-- re-entering `isNonexpansive` at each `EApp` level: re-entering would re-walk
-- the whole spine per level, i.e. quadratic in the constructor's arity.  Testing
-- only the LAST argument was issue 1139 — a `Ref` in any non-final position
-- escaped the exclusion entirely, so `let b = BR (Ref []) True` generalized and
-- a cell written at `Int` could be read at `Int -> Int`.
--
-- The head is tested BEFORE the argument: `&&` short-circuits, and the common
-- RHS at a `let` is an ordinary function application, whose head fails the test
-- immediately.  Testing the argument first would walk its whole subtree before
-- discovering the spine was never a constructor application at all.  Both
-- operands are pure `Bool`, so the order is semantically invisible.
isCtorAppSpine : TcEnv -> Expr -> Bool
isCtorAppSpine env (ELoc _ e) = isCtorAppSpine env e
isCtorAppSpine env (EDoOrigin _ e) = isCtorAppSpine env e
isCtorAppSpine env (EApp f x) = isCtorAppSpine env f && isNonexpansive env x
isCtorAppSpine env (EVar name) = isDeclaredCtorHead env name
isCtorAppSpine env (EVarId name _) = isDeclaredCtorHead env name
isCtorAppSpine _ _ = False

-- The head test itself: `name` is a real, declared constructor and is not the
-- `Ref` extern.  See `isCtorAppSpine`'s docblock for why `lookupCtor` is the
-- authority, why `ctorHeadIsUpper` is only a fast path in front of it, and why
-- the `Ref` exclusion is redundant-but-kept.
isDeclaredCtorHead : TcEnv -> String -> Bool
isDeclaredCtorHead env name = name /= "Ref"
  && ctorHeadIsUpper name
  && isSome (lookupCtor env name)

-- True iff the first character of a name is an ASCII uppercase letter,
-- i.e. the name looks like a data constructor or type name.
ctorHeadIsUpper : String -> Bool
ctorHeadIsUpper name =
  let cs = stringToChars name
  arrayLength cs > 0 && isUpper (arrayGetUnsafe 0 cs)

-- Lower every unbound var in [t] deeper than the current level down to the
-- current level, so a value-restricted (non-generalized) binding's vars can't be
-- picked up by an enclosing let's generalize.  Mirrors the lowering `unify`
-- performs via occursAdjust in the non-PVar pattern path (oracle
-- `lib/typecheck.ml:555-565`).
lowerToCurrent : Mono -> Unit
lowerToCurrent t = match normalize t
  TVar cell => match !cell
    Unbound id lvl =>
      if lvl > perRun.value.currentLevel.value then
        cell := Unbound id perRun.value.currentLevel.value
      else
        ()
    Link t2 => lowerToCurrent t2
  TCon _ _ => ()
  TRigid _ => ()
  TApp a b =>
    let _ = lowerToCurrent a
    lowerToCurrent b
  TFun a r b =>
    let _ = lowerToCurrent a
    let _ = lowerRowLevels perRun.value.currentLevel.value r
    lowerToCurrent b
  TEff r =>
    let _ = lowerRowLevels perRun.value.currentLevel.value r
    ()

-- Generalize a value RHS; value-restrict (monomorphize, lowering free vars)
-- otherwise.  monoScheme leaves the mono ungeneralized.  Oracle
-- `lib/typecheck.ml:569-571`.
genRestricted : Bool -> Mono -> Scheme
genRestricted isValue t
  | isValue = generalize t
  | otherwise =
    let _ = lowerToCurrent t
    monoScheme t

freeGenVars : Int -> Mono -> List Int
freeGenVars lvl t = match normalize t
  TVar cell => if tyvarLevel cell > lvl then [tyvarId cell] else []
  TCon _ _ => []
  TRigid _ => []
  TApp a b => freeGenVars lvl a ++ freeGenVars lvl b
  TFun a _ b => freeGenVars lvl a ++ freeGenVars lvl b
  TEff _ => []

dedupI : List Int -> List Int
dedupI xs = dedupIGo xs []

dedupIGo : List Int -> List Int -> List Int
dedupIGo [] _ = []
dedupIGo (x::xs) seen
  | containsI x seen = dedupIGo xs seen
  | otherwise = x :: dedupIGo xs (x::seen)

instantiate : Scheme -> Mono
instantiate (Forall ids evars t) =
  substMonoP True (freshSubst ids) (freshEffSubst evars) t

freshSubst : List Int -> List (Int, Mono)
freshSubst [] = []
freshSubst (id::rest) = (id, freshVar ()) :: freshSubst rest

freshEffSubst : List Int -> List (Int, Ref Effvar)
freshEffSubst [] = []
freshEffSubst (id::rest) = (id, freshEffvar ()) :: freshEffSubst rest

substMono : List (Int, Mono) -> List (Int, Ref Effvar) -> Mono -> Mono
substMono subst esub t = match normalize t
  TVar cell => fromOption (TVar cell) (lookupAssocI (tyvarId cell) subst)
  c@(TCon _ _) => c
  TRigid n => TRigid n
  TApp a b => TApp (substMono subst esub a) (substMono subst esub b)
  TFun a eff b =>
    TFun (substMono subst esub a) (substRow esub eff) (substMono subst esub b)
  TEff r => TEff (substRow esub r)

-- Phase 146 variance-aware re-open: when instantiating a generalized scheme,
-- re-open a CLOSED row carrying concrete labels (`EffRow labels None`) at a
-- COVARIANT (positive) position — an arrow the value itself produces.  This turns
-- a concrete effectful value (`putStrLn : String -> <IO> Unit`) meeting a pure
-- closed bound into the open-row subset check, rejecting the laundering escape.
-- Contravariant rows (a parameter / ctor field the scheme accepts) stay closed so
-- a legitimately pure argument in an effect-allowing slot still subsumes.  Pure
-- (label-less) rows are never re-opened — nothing to leak.
reopenRow : Bool -> EffRow -> EffRow
reopenRow pos r = reopenRowN pos (effrowNorm r)

reopenRowN : Bool -> EffRow -> EffRow
reopenRowN True (EffRow (l::ls) None) = EffRow (l::ls) (Some (freshEffvar ()))
reopenRowN _ r = r

-- positional twin of substMono used by scheme instantiation: flips variance on
-- the arrow domain and re-opens covariant closed-with-labels rows (start pos=True)
substMonoP : Bool -> List (Int, Mono) -> List (Int, Ref Effvar) -> Mono -> Mono
substMonoP pos subst esub t = match normalize t
  TVar cell => fromOption (TVar cell) (lookupAssocI (tyvarId cell) subst)
  c@(TCon _ _) => c
  TRigid n => TRigid n
  TApp a b => TApp (substMonoP pos subst esub a) (substMonoP pos subst esub b)
  TFun a eff b => TFun (substMonoP (not pos) subst esub a) (reopenRow pos (substRow esub eff)) (substMonoP pos subst esub b)
  TEff r => TEff (substRow esub r)

-- ── rendering (mirrors lib/typecheck.ml pp_mono byte-for-byte) ─────────────
export
ppScheme : Scheme -> String
ppScheme (Forall _ _ t) = ppMono t

-- Render a scheme WITH its constraint context (`Num a => a -> a -> a`).  The
-- constraint tyvar ids are threaded through the SAME ctx/cnt that renders the
-- body, so a constraint's letter matches the body's (id → letter shared).  The
-- body is rendered FIRST so ctx already carries the body's letter assignments
-- when the constraints reuse it via nameOf.  Constraints are rendered+sorted+
-- deduped for a stable display order.  Empty list ⇒ plain ppScheme (no `=>`).
-- Single-vs-multiple form mirrors ppConstrDoc in tools/doc.mdk (`Num a =>` /
-- `(Num a, Ord b) =>`).
export
ppSchemeCon : List VecObl -> Scheme -> String
ppSchemeCon [] s = ppScheme s
ppSchemeCon cons (Forall _ _ t) =
  let ctx = Ref []
  let cnt = Ref 0
  let body = ppGo ctx cnt 0 t
  let rendered = sortUniqS (renderConstraintCtx ctx cnt cons)
  let ctxStr = match rendered
    [c] => c
    _ => "(" ++ joinWith ", " rendered ++ ")"
  "\{ctxStr} => \{body}"

-- a predicate renders with its WHOLE argument vector — `Ix a i =>`, not the
-- `(Ix a, Ix i) =>` two-1-ary-facts rendering the shattered representation produced
-- before #607.
-- ⚠️ Renders the SPELLING (`voIface.irName`).  U1b (#1482) gave this payload an
-- identity-carrying interface half; every DISPLAY surface must keep printing the name
-- the user wrote, or every `Num a => …` in `check --types`, LSP hover, inlay hints and
-- the snapshot corpus moves.
renderConstraintCtx : Ref (List (Int, String)) -> Ref Int -> List VecObl -> List String
renderConstraintCtx _ _ [] = []
renderConstraintCtx ctx cnt (o::rest) =
  -- #1161: a vector-carrying entry renders its WHOLE argument vector under the SAME
  -- naming context as the body, so `Ix a Bool =>` prints with its ground argument
  -- instead of degrading to `Ix a`.  An ids-only entry renders exactly as before.
  -- #1952: ARGUMENT precedence (3), not 2.  At prec 2 `wrapIf (prec > 2)` leaves an
  -- application BARE, so a STRUCTURED predicate argument printed as `Conv Wrap a b =>` —
  -- which is not the same predicate: it reads as a four-argument context and does not
  -- round-trip through the parser.  This is SOURCE SYNTAX (`check --types`, LSP hover,
  -- inlay hints all show it as a signature), so it owes the parens unconditionally, at
  -- arity 1 as much as at arity 2.  Bare-tyvar and nullary-`TCon` arguments are atoms and
  -- render identically at either precedence, so `Num a =>` / `Ix a Bool =>` do not move —
  -- and the compiler's and stdlib's own declared contexts are all bare-tyvar 1-ary, so
  -- neither the snapshot corpus nor the self-compile fixpoint sees this at all.
  let s = if isEmptyL o.voArgs then
    joinWith " " (o.voIface.irName :: map (id => nameOf ctx cnt id) o.voIds)
  else
    joinWith " " (o.voIface.irName :: map (ppGo ctx cnt 3) o.voArgs)
  s :: renderConstraintCtx ctx cnt rest

-- Render a binding's scheme WITH its inferred/declared constraint context, looked
-- up by NAME from schemeObligationsRef (the always-on obligation side-channel the
-- most-recent typecheck left populated).  A name with no recorded obligations
-- renders as plain ppScheme.  Used by schemeLines (`check --types`) and the LSP
-- hover/completion/inlay renderers so all display surfaces show `Num a => …`.
export
ppSchemeNamed : String -> Scheme -> String
ppSchemeNamed n s =
  -- #837: key the obligation lookup by (name, binding-id), exactly as the check-path
  -- reader does — recovering the id from schemeDefIdsRef (top-level binders of the
  -- module last checked).  With the leak-guard windows retired this is what stops a
  -- where-helper `g`'s obligation rendering on an unrelated top-level `g`; a binder
  -- absent from schemeDefIdsRef (id 0) falls to the bare-name scan (today's path).
  let id = fromOption 0 (omLookup n perRun.value.schemeDefIdsRef.value)
  ppSchemeCon
    (fromOption [] (lookupSchemeObls n id perRun.value.schemeObligationsRef.value))
    s

ppMono : Mono -> String
ppMono t =
  let ctx = Ref []
  let cnt = Ref 0
  ppGo ctx cnt 0 t

letters : String
letters = "abcdefghijklmnopqrstuvwxyz"

nameOf : Ref (List (Int, String)) -> Ref Int -> Int -> String
nameOf ctx cnt id = match lookupAssocI id !ctx
  Some s => s
  None => assignName ctx cnt id

assignName : Ref (List (Int, String)) -> Ref Int -> Int -> String
assignName ctx cnt id =
  let n = !cnt
  cnt := n + 1
  let s = if n < 26 then stringSlice n (n + 1) letters else "t" ++ intToString n
  ctx := (id, s) :: !ctx
  s

ppGo : Ref (List (Int, String)) -> Ref Int -> Int -> Mono -> String
ppGo ctx cnt prec t = match normalize t
  TVar cell => ppVar ctx cnt cell
  TCon n _ => ppConName n
  -- Same renderer as `TCon`: a rigid prints as its own type-parameter name
  -- (`ppConName` is the tuple-tag de-mangler and is the identity on any name
  -- that is not a `__tupleN__` tag).  Byte-identical to the pre-split output.
  TRigid n => ppConName n
  TApp a b => ppApp ctx cnt prec a b
  TFun a eff b => ppFun ctx cnt prec a eff b
  TEff r => ppEffArg ctx cnt r

-- Render a row sitting in type-argument position (the `e` of `Async e a`).  Bare
-- open tail → the row var's name (reads `Async e a`); labels → `<IO>`/`<IO | e>`;
-- closed empty → `<>`.  Effvar ids are offset into a private letter namespace so
-- they never collide with tyvar letters.  Mirrors lib/typecheck.ml pp_mono TEff.
ppEffArg : Ref (List (Int, String)) -> Ref Int -> EffRow -> String
ppEffArg ctx cnt r = match effrowNorm r
  EffRow labels tail =>
    let lbl = match labels
      [] => ""
      ls => renderAtoms ls
    let tailS = match tail
      Some cell => match !cell
        EUnbound id _ => nameOf ctx cnt (id + 1000000)
        ELink _ => ""
      None => ""
    ppEffArgFmt lbl tailS

ppEffArgFmt : String -> String -> String
ppEffArgFmt l t
  | l == "" && t == "" = "<>"
  | l == "" = t
  | t == "" = "<" ++ l ++ ">"
  | otherwise = "<\{l} | \{t}>"

ppVar : Ref (List (Int, String)) -> Ref Int -> Ref Tyvar -> String
ppVar ctx cnt cell = match !cell
  Unbound id _ => nameOf ctx cnt id
  Link _ => "_"

ppApp : Ref (List (Int, String)) -> Ref Int -> Int -> Mono -> Mono -> String
ppApp ctx cnt prec a b = match tupleSpine (TApp a b)
  -- a fully-saturated `__tupleN__` spine renders back to surface `(e1, …, eN)`
  Some ts => "(" ++ joinWith ", " (ppEach ctx cnt 0 ts) ++ ")"
  None =>
    let sa = ppGo ctx cnt 2 a
    let sb = ppGo ctx cnt 3 b
    wrapIf (prec > 2) "\{sa} \{sb}"

ppFun : Ref (List (Int, String)) -> Ref Int -> Int -> Mono -> EffRow -> Mono -> String
ppFun ctx cnt prec a eff b =
  let sa = ppGo ctx cnt 2 a
  let sb = ppGo ctx cnt 1 b
  wrapIf (prec > 1) "\{sa} -> \{effStr (effrowLabels eff)}\{sb}"

effStr : List Atom -> String
effStr [] = ""
effStr labels = "<" ++ renderAtoms labels ++ "> "

stripEff : Ty -> Ty
stripEff (TyEffect _ _ t) = t
stripEff t = t

ppEach : Ref (List (Int, String)) -> Ref Int -> Int -> List Mono -> List String
ppEach _ _ _ [] = []
ppEach ctx cnt prec (t::ts) =
  let s = ppGo ctx cnt prec t
  s :: ppEach ctx cnt prec ts

wrapIf : Bool -> String -> String
wrapIf True s = "(" ++ s ++ ")"
wrapIf False s = s

-- ── AST type → mono (for ADT field types / annotations / signatures) ──────
-- free type-variable NAMES in the type map to fresh tyvars (a signature's `a`
-- is a variable, not a TCon)
tyVarNames : Ty -> List String
tyVarNames (TyVar n) = [n]
tyVarNames (TyCon { tyConName = _ }) = []
tyVarNames (TyApp a b) = tyVarNames a ++ tyVarNames b
tyVarNames (TyFun a b) = tyVarNames a ++ tyVarNames b
tyVarNames (TyTuple ts) = flatMap tyVarNames ts
tyVarNames (TyEffect _ _ t) = tyVarNames t
tyVarNames (TyConstrained _ t) = tyVarNames t
-- A bare row atom (#997) wraps no inner type, so it carries no ordinary
-- type-variable occurrence (its own tail var, if any, is a row-namespace
-- name captured by `effTailNames`/`rowArgNames`, not this one).
tyVarNames (TyRow _ _ _) = []

-- WS-1c: the tyvar names appearing in a signature's `=>` CONSTRAINTS (not the value
-- type).  `tyVarNames` deliberately skips TyConstrained's constraints, so a constraint
-- var that NEVER appears in the value type (`Mk a => Int -> Int` — `a` only in `Mk a`)
-- was dropped from the fresh-var map and the generalized scheme: the scheme didn't
-- quantify `a`, so a call-site instantiation couldn't pin it (anyIdPinned False), the
-- call fell to the recursive-app path with empty ids → an empty dict → runtime
-- `intToString: not an Int` / a null build dict.  Including these names (deduped
-- against tyVarNames, so a constraint var ALSO in the value type is unaffected) lets
-- the constraint var be freshened + quantified like any other, so the undetermined
-- call routes through the normal pendingDictApps path (routeUndeterminedTop).
constraintVarNamesTy : Ty -> List String
constraintVarNamesTy (TyConstrained cs t) = flatMap constraintArgVarNames cs
  ++ constraintVarNamesTy t
constraintVarNamesTy (TyEffect _ _ t) = constraintVarNamesTy t
constraintVarNamesTy _ = []

constraintArgVarNames : Constraint -> List String
constraintArgVarNames (Constraint { constraintArgs = tys }) =
  flatMap tyVarNames tys

-- tyVarNames PLUS the signature's constraint-only vars (deduped).
tyVarNamesWithConstraints : Ty -> List String
tyVarNamesWithConstraints ty = dedup (tyVarNames ty ++ constraintVarNamesTy ty)

-- ── alias cycle detection (stage 4) ──────────────────────────────────────────
-- Collect all TyCon (type-constructor) names referenced anywhere in a surface
-- Ty.  Mirrors tyVarNames but for constructor slots.  TyVar names are alias
-- params and never alias dependencies, so they are excluded.
tyConNamesInTy : Ty -> List String
tyConNamesInTy (TyCon { tyConName = n }) = [n]
tyConNamesInTy (TyVar _) = []
tyConNamesInTy (TyApp a b) = tyConNamesInTy a ++ tyConNamesInTy b
tyConNamesInTy (TyFun a b) = tyConNamesInTy a ++ tyConNamesInTy b
tyConNamesInTy (TyTuple ts) = flatMap tyConNamesInTy ts
tyConNamesInTy (TyEffect _ _ t) = tyConNamesInTy t
tyConNamesInTy (TyRow _ _ _) = []
tyConNamesInTy (TyConstrained cs t) = flatMap tyConNamesInConstraint cs
  ++ tyConNamesInTy t

tyConNamesInConstraint : Constraint -> List String
tyConNamesInConstraint (Constraint { constraintHead = iname, constraintArgs = tys }) = iname :: flatMap tyConNamesInTy tys

-- Collect all elements from the HEAD of a list up to and including `target`.
-- The on-stack list is newest-first; when a back-edge to `target` is detected,
-- everything from the head down to `target` (inclusive) is on the cycle path.
takeUntilInclusiveS : String -> List String -> List String
takeUntilInclusiveS _ [] = []
takeUntilInclusiveS target (x::xs) =
  if x == target then
    [x]
  else
    x :: takeUntilInclusiveS target xs

-- Build the alias-dependency entry for one table entry: alias name → list of
-- other alias keys mentioned in its RHS (the dependency edges).
--
-- ⚠️ #1111 A-2.3 DELIBERATELY LEFT THIS GRAPH BARE-NAME-KEYED, and it is the
-- one consumer of `aliasTableRef` that is not re-keyed.  Three reasons, in the
-- order that decided it:
--   * it is a DELETION pass, and its over-approximation is conservative in the
--     LOUD direction — two unrelated modules' aliases sharing a spelling, one
--     of them cyclic, drops both rows and reports `T-RECURSIVE-ALIAS` naming
--     the shared name.  Wrong-but-loud.  Re-keying could only ever make it
--     delete FEWER rows, and "recursive alias silently expanded" is the one
--     outcome this pass exists to prevent (it infinite-loops the expansion
--     seam);
--   * `tyConNamesInTy` yields bare `String`s from an arbitrary `Ty`, so an
--     identity-keyed graph needs an identity-carrying spine walk — the
--     comparison-reads-origin step the arc schedules as A-2.10, not a
--     re-key;
--   * it feeds `emitCyclicAliasErrors`, whose OUTPUT ORDER is observable in
--     goldens (see the enumeration-order bullet in `types/registry.mdk`).
-- `tabKeyName` is what makes the bare half explicit here rather than implicit.
buildAliasGraphEntry : List String -> (TabKey, (List String, Ty)) -> (String, List String)
buildAliasGraphEntry aliasKeys (key, paramsRhs) =
  let rhs = snd paramsRhs
  (
    tabKeyName key,
    filterList (k => contains k aliasKeys) (dedup (tyConNamesInTy rhs)),
  )

-- DFS over the alias dependency graph.  Detects back-edges (a node is reached
-- while it is already on the current path) → cycle.  On a back-edge to `target`,
-- marks every node on the stack from the head down to and including `target` as
-- cyclic (they are all on the same cycle path).
aliasDfsVisit : List (String, List String) -> Ref (List String) -> Ref (List String) -> Ref (List String) -> String -> Unit
aliasDfsVisit graph visitedRef onStackRef cyclicOut name =
  if contains name !visitedRef then ()
  else
    if contains name !onStackRef then cyclicOut := dedup (takeUntilInclusiveS name !onStackRef ++ !cyclicOut)
    else
      onStackRef := name :: !onStackRef
      let _ = aliasDfsVisitNeighbors graph visitedRef onStackRef cyclicOut (fromOption [] (lookupAssoc name graph))
      onStackRef := filterList (/= name) !onStackRef
      visitedRef := name :: !visitedRef

aliasDfsVisitNeighbors : List (String, List String) -> Ref (List String) -> Ref (List String) -> Ref (List String) -> List String -> Unit
aliasDfsVisitNeighbors _ _ _ _ [] = ()
aliasDfsVisitNeighbors graph visitedRef onStackRef cyclicOut (n::ns) =
  let _ = aliasDfsVisit graph visitedRef onStackRef cyclicOut n
  aliasDfsVisitNeighbors graph visitedRef onStackRef cyclicOut ns

aliasDfsVisitAll : List (String, List String) -> Ref (List String) -> Ref (List String) -> Ref (List String) -> List String -> Unit
aliasDfsVisitAll _ _ _ _ [] = ()
aliasDfsVisitAll graph visitedRef onStackRef cyclicOut (k::ks) =
  let _ = aliasDfsVisit graph visitedRef onStackRef cyclicOut k
  aliasDfsVisitAll graph visitedRef onStackRef cyclicOut ks

emitCyclicAliasErrors : List String -> Unit
emitCyclicAliasErrors [] = ()
emitCyclicAliasErrors (name::rest) =
  let _ = pushTypeErrorOnce "T-RECURSIVE-ALIAS" ("Recursive type alias `" ++ name ++ "`. Type aliases cannot be recursive or cyclic")
  emitCyclicAliasErrors rest

-- Cycle-detection pre-pass over aliasTableRef.  MUST run immediately after
-- registerAllData has fully populated the table and BEFORE any fromAstType*
-- call (which would infinite-loop on a cyclic alias via the recursive expansion
-- added in stages 2–3).  For each alias found on a cycle:
--   (1) emits a deduped type_error naming the offending alias;
--   (2) removes it from aliasTableRef so the expansion seam falls through to an
--       opaque TCon and cannot recurse → no stack overflow.
rejectCyclicAliases : Unit -> Unit
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
rejectCyclicAliases _ =
  let table = perRun.value.aliasTableRef.value
  -- BARE NAMES on purpose — see `buildAliasGraphEntry`.
  let aliasKeys = map (e => tabKeyName (fst e)) table
  let graph = map (buildAliasGraphEntry aliasKeys) table
  let visitedRef = Ref []
  let onStackRef = Ref []
  let cyclicOut = Ref []
  let _ = aliasDfsVisitAll graph visitedRef onStackRef cyclicOut aliasKeys
  let cyclic = !cyclicOut
  let _ = emitCyclicAliasErrors cyclic
  setRef
    perRun.value.aliasTableRef
    (filterList (entry => not (contains (tabKeyName (fst entry)) cyclic)) table)

-- like astTypeFresh but also returns the name→fresh-tyvar map (the same fresh
-- vars used in the Mono), so a caller can check post-unify whether each
-- annotation tyvar stayed a distinct unbound var (C3 AnnotationTooGeneral).
astTypeFreshTbl : Ty -> (Mono, List (String, Mono))
astTypeFreshTbl ty =
  let etbl = freshEffMap (dedup (effTailNames ty ++ rowArgNames ty))
  let tvs = freshTvMap (removeAllS (rowArgNames ty) (dedup (tyVarNames ty)))
  (fromAstTypeE etbl tvs ty, tvs)

freshTvMap : List String -> List (String, Mono)
freshTvMap [] = []
freshTvMap (n::rest) = (n, freshVar ()) :: freshTvMap rest

-- a signature → a scheme quantifying its free tyvars
sigToScheme : Ty -> Scheme
sigToScheme ty = fst (sigToSchemeTvs ty)

-- like sigToScheme but also returns the name→tyvar map it built, so a caller can
-- recover the id of a specific constraint variable (methodConstraintsRef) — the
-- SAME quantified ids the returned scheme carries, so a call-site instantiation's
-- subst maps them.
sigToSchemeTvs : Ty -> (Scheme, List (String, Mono))
sigToSchemeTvs ty = sigToSchemeTvsIn [] ty

-- #822: the graded-scope-carrying form.  An INTERFACE METHOD signature is built with
-- its interface's declGradedScope so an abstract head `f e a` gets its Row slot; every
-- other signature passes `[]` and is elaborated exactly as before.
sigToSchemeTvsIn : List (String, List Kind) -> Ty -> (Scheme, List (String, Mono))
sigToSchemeTvsIn scope ty =
  let rows = rowArgNamesIn scope ty
  let tvs = freshTvMap (removeAllS rows (tyVarNamesWithConstraints ty))
  let etbl = freshEffMap (dedup (effTailNames ty ++ rows))
  (
    Forall (map monoTyvarId (map snd tvs)) (map effvarIdOf etbl) (fromAstTypeE etbl tvs ty),
    tvs,
  )

-- tvs maps a declared type-parameter name to its tyvar
-- named effect-tail variables in a signature (`<IO | e>` → ["e"]); the same
-- source name must share one effvar across the whole signature, linking a HOF's
-- callback effect to its result effect
effTailNames : Ty -> List String
effTailNames (TyVar _) = []
effTailNames (TyCon { tyConName = _ }) = []
effTailNames (TyApp a b) = effTailNames a ++ effTailNames b
effTailNames (TyFun a b) = effTailNames a ++ effTailNames b
effTailNames (TyTuple ts) = flatMap effTailNames ts
effTailNames (TyEffect _ tail t) = tailNameList tail ++ effTailNames t
effTailNames (TyConstrained _ t) = effTailNames t
-- A bare row atom (#997) carries its own tail var directly (no wrapped type
-- to recurse into) — same tail-var-sharing contract as `TyEffect`'s arm
-- above (see the `effect_param.mdk` regression guard for why this matters:
-- a KRow arg's tail var must resolve to the SAME shared effvar cell
-- wherever it recurs in a signature).
-- ⚠️ Deliberately NAME-based, matching the pre-existing `TyEffect` arm above
-- (NOT new to this arm — a `TyEffect` nested in a non-KRow argument slot,
-- e.g. `List (<e> T)`, has always had the identical property): this walker
-- has no kind context, so it cannot tell a row sitting in a genuinely
-- KRow-kinded slot from one sitting in a Type-kinded slot that merely LOOKS
-- like a row syntactically (`List <e>`, `List (<e> T)`). `undeterminedRetEffVars`
-- (below) is documented as needing a KIND-AWARE argument-carrier test for
-- exactly this reason and pairs this with the actually-kind-aware
-- `rowArgNames`; this arm's over-counting is a residual channel of the same
-- shape as that pre-existing gap, not a new one — see #784.
effTailNames (TyRow _ tail _) = tailNameList tail

tailNameList : Option String -> List String
tailNameList None = []
tailNameList (Some n) = [n]

freshEffMap : List String -> List (String, Ref Effvar)
freshEffMap [] = []
freshEffMap (n::rest) = (n, freshEffvar ()) :: freshEffMap rest

effvarIdOf : (String, Ref Effvar) -> Int
effvarIdOf (_, cell) = effvarId cell

-- build a row from an arrow's return-position AST type; a named tail resolves
-- through [etbl] for sharing, an absent/anonymous one is closed
astEffrowE : List (String, Ref Effvar) -> Ty -> EffRow
astEffrowE etbl (TyEffect labels tail _) =
  EffRow (atomsOfWritten labels) (tailCell etbl tail)
astEffrowE _ _ = pureRow

tailCell : List (String, Ref Effvar) -> Option String -> Option (Ref Effvar)
tailCell _ None = None
tailCell etbl (Some n) = lookupAssoc n etbl

fromAstType : List (String, Mono) -> Ty -> Mono
fromAstType tvs ty = fromAstTypeE [] tvs ty

-- un-curry a left-nested TyApp chain into (head, args).  `headTyconTy` only
-- returns the head; this also keeps the spine for kind-directed elaboration.
tyAppSpine : Ty -> (Ty, List Ty)
tyAppSpine (TyApp a b) = match tyAppSpine a
  (head, args) => (head, args ++ [b])
tyAppSpine t = (t, [])

fromAstTypeE : List (String, Ref Effvar) -> List (String, Mono) -> Ty -> Mono
-- OCCURRENCE MINT (#1110): the head Mono's identity is the identity resolve
-- stamped on the `Ty.TyCon` this conversion is reading, and the record pattern
-- puts it in scope for free — there is nowhere else it could come from and no
-- ambient module id to get it wrong from.
fromAstTypeE etbl tvs (TyCon { tyConName = n, tyConOrigin = o }) = match lookupTab (tyTabKey o n) perRun.value.aliasTableRef.value
  -- Transparent non-parameterized alias (`type Foo = Int`): expand to its RHS,
  -- recursively so alias-of-alias (`type A = Int; type B = A`) flattens.  Cycle
  -- rejection is deferred (stage 4); the non-cyclic corpus terminates.
  Some (params, rhs) if listLen params == 0 => fromAstTypeE etbl tvs rhs
  -- A parameterized alias used UNAPPLIED (`x : Pair`): a type alias is not a
  -- first-class type constructor (DESIGN §3/§9 fork 2), so it must be saturated.
  -- Reject with an arity error and keep the bare TCon so inference continues.
  Some (params, _) =>
    let _ = pushTypeErrorOnce "T-ALIAS-ARITY" (aliasArityMsg n (listLen params) 0)
    tconFrom o n
  _ => tconFrom o n
-- RIGID PRODUCER 1 of 2 (#1110).  A `TyVar` bound by the enclosing scheme
-- resolves to its mono; the FALLBACK — an unbound type-parameter name — is a
-- rigid variable, not a type constructor.  See `Mono.TRigid`.
fromAstTypeE etbl tvs (TyVar n) = fromOption (TRigid n) (lookupAssoc n tvs)
fromAstTypeE etbl tvs (TyApp a b) = match tyAppSpine (TyApp a b)
  (TyCon { tyConName = n, tyConOrigin = o }, args) => fromAstTypeApp etbl tvs o n args
  -- #822: an ABSTRACT head with known kinds — an interface typaram of graded kind
  -- (`f e a`, `f : Row -> Type -> Type`).  Anything else stays opaque.
  (TyVar h, args) => fromAstTypeVarApp etbl tvs h args a b
  _ => TApp (fromAstTypeE etbl tvs a) (fromAstTypeE etbl tvs b)
fromAstTypeE etbl tvs (TyFun a b) =
  TFun
    (fromAstTypeE etbl tvs a)
    (astEffrowE etbl b)
    (fromAstTypeE etbl tvs (stripEff b))
fromAstTypeE etbl tvs (TyTuple ts) = tupleMono (map (fromAstTypeE etbl tvs) ts)
fromAstTypeE etbl tvs (TyEffect _ _ t) = fromAstTypeE etbl tvs t
fromAstTypeE etbl tvs (TyConstrained _ t) = fromAstTypeE etbl tvs t
-- A bare row atom (#997) reached here means it landed in an ordinary
-- (non-KRow) type slot — `kindArgMono`'s KRow branch (below) is what
-- normally consumes a `TyRow`, routing it through `rowArgOf` instead. Unlike
-- a misplaced `TyEffect` (which unwraps to a REAL user-written type and can
-- keep inferring silently), a `TyRow` has no wrapped type at all — inventing
-- one from nothing would turn what used to be a parse error (`List <Stdout>`,
-- `data Holder = Holder <Stdout>`) into a silent mistype (`List Unit`).  Push
-- a real diagnostic; `TCon "Unit"` is POST-ERROR RECOVERY ONLY, so inference
-- can keep going, not a value anything should rely on.
fromAstTypeE etbl tvs (TyRow labels tail loc) =
  let _ = pushTypeErrorOnceAt "T-ROW-KIND-MISMATCH" loc (rowKindMismatchMsg labels tail)
  tconBuiltin "Unit"

-- ppTy's own TyRow rendering (below, in the AST pretty-printer section) isn't
-- visible yet at this point in the file, so render the row body directly with
-- the SAME row-body renderer that feeds it (`ppEffInsideTy`, further down —
-- forward reference, fine: this module is resolved as a whole, not top-down).
rowKindMismatchMsg : List (String, Option String) -> Option String -> String
rowKindMismatchMsg labels tail = "A row <\{ppEffInsideTy labels tail}> was written here, but this type-argument position isn't row-kinded — it expects an ordinary type, not an effect row. Rows can only be written where a type constructor's parameter has row kind (e.g. the `e` of `Async e a`)."

-- A type alias applied to the wrong number of arguments — over-applied,
-- under-applied, or (got=0) used unapplied.  v1 requires a parameterized alias
-- to be saturated; an alias is not a first-class type constructor (DESIGN §3/§9
-- fork 2).  Deduped (pushTypeErrorOnce) since a signature's `Ty` is converted to
-- `Mono` repeatedly during inference.
aliasArityMsg : String -> Int -> Int -> String
aliasArityMsg n expected got = "Type alias `\{n}` expects \{intToString expected} argument(s), got \{intToString got}"

-- the opaque fall-through for a TyCon-headed spine: keep the head as a bare
-- `TCon n` and apply the (alias-expanded) argument Monos left-nested.  This is
-- byte-identical to the legacy `TApp (fromAstTypeE a) (fromAstTypeE b)` recursion
-- for a non-alias head, but it does NOT re-dispatch the head through
-- `fromAstTypeE` — critical now that the head being an *alias* has side-effects
-- (the unapplied-alias arity error), and Medaka is strict so a pre-built fallback
-- would fire that error even on the expansion path.
--
-- ⚠️ The `TyConOrigin` parameter (#1110) is the head's ACQUIRED identity, carried
-- from the `Ty.TyCon` `fromAstTypeE`/`fromAstTypeApp` destructured — it is not a
-- new fact and nothing here decides it.  It sits beside the head NAME because
-- that is the one argument it must never drift away from; the spine head is the
-- only `TCon` this function mints.
appFallback : List (String, Ref Effvar) -> List (String, Mono) -> TyConOrigin -> String -> List Ty -> Mono
appFallback _ _ o n [] = tconFrom o n
appFallback etbl tvs o n (a::as2) =
  foldAppFallback etbl tvs (TApp (tconFrom o n) (fromAstTypeE etbl tvs a)) as2

foldAppFallback : List (String, Ref Effvar) -> List (String, Mono) -> Mono -> List Ty -> Mono
foldAppFallback _ _ acc [] = acc
foldAppFallback etbl tvs acc (a::as2) =
  foldAppFallback etbl tvs (TApp acc (fromAstTypeE etbl tvs a)) as2

-- a TyCon-headed type-app: a parameterized type-ALIAS head is expanded by binding
-- its params to the supplied argument Monos and recursing on the RHS (transparent,
-- transitive — an alias RHS that names another alias re-expands).  Otherwise: when
-- the head is a data type with a KRow param, refold the spine kind-directed (KRow
-- arg → TEff row); else the opaque `appFallback`.
-- (`o` is the head's acquired identity — see `appFallback`'s note.)
-- `key` is minted ONCE and shared by both lookups below (#1111 A-2.3 follow-up):
-- `tyTabKey` → `mkIdent` → `identOriginOf` allocates on the way (an `Ident`, an
-- `Option`, the `TkIdent`/`TkBare` wrapper), so minting it twice per call — once
-- for `aliasTableRef`, again for `dataParamKindsRef` in the `_ =>` arm below —
-- doubled the allocation on the COMMON path (every non-alias type application)
-- for no reason: the alias arms above the `_ =>` arm never reach the second
-- lookup at all, so they pay for the hoisted `let` exactly what they always
-- paid for the first one. This is a redundant-allocation removal, not a
-- measured perf win — `test/bench.sh` does not run on this box (#1187) and
-- `diff_compiler_perf_scaling` grades a growth ratio, which cannot see a
-- constant factor either way.
fromAstTypeApp : List (String, Ref Effvar) -> List (String, Mono) -> TyConOrigin -> String -> List Ty -> Mono
fromAstTypeApp etbl tvs o n args =
  let key = tyTabKey o n
  match lookupTab key perRun.value.aliasTableRef.value
    -- Saturated parameterized alias: bind params → arg Monos (alias params shadow
    -- outer tvs of the same name) and expand the RHS through the same seam.
    Some (params, rhs) if listLen params == listLen args =>
      fromAstTypeE etbl (zipL params (map (fromAstTypeE etbl tvs) args) ++ tvs) rhs
    -- Alias applied to the wrong arity: reject, keep the opaque fallback.
    Some (params, _) =>
      let _ = pushTypeErrorOnce "T-ALIAS-ARITY" (aliasArityMsg n (listLen params) (listLen args))
      appFallback etbl tvs o n args
    _ => match lookupTab key perRun.value.dataParamKindsRef.value
      Some kinds if listLen kinds == listLen args =>
        foldAppKinds etbl tvs (tconFrom o n) kinds args
      _ => appFallback etbl tvs o n args

-- #822: a spine headed by an interface typaram of GRADED kind — `f e b` must yield
-- the SAME Mono shape a row-indexed data head does (`Async e b` =
-- `TApp (TApp (TCon Async) (TEff row)) b`), which is exactly what lets the instance
-- head unify with the method's abstract one.  The head itself still elaborates as an
-- ordinary tyvar: the grade rides the type INDEX, never the dictionary
-- (EFFECTS-SEMANTICS §6 "Erasure and dispatch are untouched").
--
-- ⚠️ This reads the CALLER'S OWN CLASSIFICATION out of [etbl]/[tvs] rather than
-- re-deriving it from a kind table, and that is the point.  Every seam builds the
-- pair as `etbl = freshEffMap (effTailNames ty ++ rowArgNamesIn scope ty)` and
-- `tvs = freshTvMap (tyVarNames ty MINUS rowArgNamesIn scope ty)`, so "seeded into
-- etbl AND withheld from tvs" is precisely "this seam called it a row" — the two
-- cannot disagree, and there is no name-keyed global to leak.
--
-- ⚠️ It fires at seams with NO graded scope, and that is CORRECT — an earlier version
-- of this comment claimed the opposite ("an unscoped seam withholds nothing, so this
-- arm never fires there"), which was simply false.  A KROW DATA slot withholds too:
-- `rowArgNamesIn` reports the `e` of `D e f` from `dataParamKindsRef` with no interface
-- in the file at all, and `registerVariants`' payload seam withholds by construction
-- (`tvs = ktypeTvs` is KType-only, `etbl = krowEtbl` is KRow-only).  So in
-- `data D e f = MkD (Unit -> <e> Unit) (f e Int)`, the `e` of the abstract-headed
-- `f e Int` reaches this arm unscoped.
-- The result is a FIX, not a leak: pre-#822 that `e` was withheld from tvs and then
-- elaborated by `fromAstTypeE (TyVar n)`'s `fromOption (TCon n)` fallback into a
-- FABRICATED RIGID `TCon "e"` — `getInner : D e f -> f e Int` inferred as
-- `D a b -> b e Int`, an opaque constant no caller can ever satisfy.  It now infers
-- `D a b -> b a Int`.  Pinned by typecheck_error_fixtures/graded_krow_data_slot_abstract_head.mdk.
fromAstTypeVarApp : List (String, Ref Effvar) -> List (String, Mono) -> String -> List Ty -> Ty -> Ty -> Mono
fromAstTypeVarApp etbl tvs h args a b
  | anyRowSlotArg etbl tvs args =
    foldRowSlotArgs etbl tvs (fromAstTypeE etbl tvs (TyVar h)) args
  | otherwise = TApp (fromAstTypeE etbl tvs a) (fromAstTypeE etbl tvs b)

-- A bare NAME is a row slot arg iff the caller seeded it into [etbl] and deliberately
-- kept it out of [tvs].
isRowSlotArg : List (String, Ref Effvar) -> List (String, Mono) -> Ty -> Bool
isRowSlotArg etbl tvs (TyVar n) = isSome (lookupAssoc n etbl)
  && isNone (lookupAssoc n tvs)
-- A WRITTEN row (#997) is a row, full stop — no name test, and in particular no `Some n`
-- test.  `<Stdout | e>` and `<>` are the same construct with and without a tail, and a
-- `TyRow` is only ever legal in a row-kinded position anyway (that is what
-- `fromAstTypeE`'s TyRow clause exists to say).
--
-- ⚠️ Requiring an open tail here was an S1: it made the SPEC'S OWN `gpure : a -> f <> a`
-- (EFFECTS-SEMANTICS §6, one of the four canonical graded signatures) unspellable — the
-- closed row fell to the opaque fallback and drew `T-ROW-KIND-MISMATCH`, a message
-- asserting the slot "isn't row-kinded" when slot 0 of `f` had just been INFERRED KRow
-- from a sibling method.  The same `<>` on a concrete head (`Async <> a`) was accepted,
-- so the two halves of the feature disagreed on one spelling with the abstract half
-- misdiagnosing why.  #823 cannot add the graded core interfaces without this.
isRowSlotArg _ _ (TyRow _ _ _) = True
isRowSlotArg _ _ _ = False

-- monomorphic and short-circuiting on purpose (compiler/AGENTS.md): this runs on
-- every var-headed type-application node the elaborator meets.
anyRowSlotArg : List (String, Ref Effvar) -> List (String, Mono) -> List Ty -> Bool
anyRowSlotArg _ _ [] = False
anyRowSlotArg etbl tvs (t::rest) = isRowSlotArg etbl tvs t
  || anyRowSlotArg etbl tvs rest

foldRowSlotArgs : List (String, Ref Effvar) -> List (String, Mono) -> Mono -> List Ty -> Mono
foldRowSlotArgs _ _ acc [] = acc
foldRowSlotArgs etbl tvs acc (arg::rest) =
  foldRowSlotArgs etbl tvs (TApp acc (rowSlotArgMono etbl tvs arg)) rest

rowSlotArgMono : List (String, Ref Effvar) -> List (String, Mono) -> Ty -> Mono
rowSlotArgMono etbl tvs arg
  | isRowSlotArg etbl tvs arg = TEff (rowArgOf etbl arg)
  | otherwise = fromAstTypeE etbl tvs arg

-- refold a kinded type-app spine: a KType arg recurses, a KRow arg becomes a
-- TEff row (resolved through the shared etbl, so it aliases the field/sig tail).
foldAppKinds : List (String, Ref Effvar) -> List (String, Mono) -> Mono -> List Kind -> List Ty -> Mono
foldAppKinds _ _ acc [] [] = acc
foldAppKinds etbl tvs acc (k::ks) (a::as2) =
  foldAppKinds etbl tvs (TApp acc (kindArgMono etbl tvs k a)) ks as2
foldAppKinds _ _ acc _ _ = acc

kindArgMono : List (String, Ref Effvar) -> List (String, Mono) -> Kind -> Ty -> Mono
kindArgMono etbl tvs KType arg = fromAstTypeE etbl tvs arg
kindArgMono etbl tvs KRow arg = TEff (rowArgOf etbl arg)

-- a row sitting in a KRow type-app slot: a bare name resolves through the shared
-- etbl (seeded by the caller so the cell aliases the field/sig tail); an explicit
-- `<…>` builds directly; anything else is the pure closed row.
rowArgOf : List (String, Ref Effvar) -> Ty -> EffRow
rowArgOf etbl (TyVar n) = match lookupAssoc n etbl
  Some cell => EffRow [] (Some cell)
  None => pureRow
rowArgOf etbl (TyEffect labels tail _) =
  EffRow (atomsOfWritten labels) (tailCell etbl tail)
-- The primary shape #997 exists for: `Async <Stdout> Unit`'s `<Stdout>` IS a
-- `TyRow`, not a `TyEffect` — this arm is what makes the bare row spelling
-- carry the SAME effect information as the pre-existing degenerate spelling
-- `Async (<Stdout> Unit) Unit` (a `TyEffect`, caught by the arm above).
-- Without it, a written row here would silently fall through to the
-- catch-all `pureRow` below and every bare-row-written effect would be
-- DISCARDED for dict-passing purposes.
rowArgOf etbl (TyRow labels tail _) =
  EffRow (atomsOfWritten labels) (tailCell etbl tail)
-- #1094: anything else here is an ordinary TYPE written into a row-kinded slot
-- (`Box Int Int`).  This used to return `pureRow` silently, so the written `Int` was
-- read back as `Box <> Int` with no diagnostic at all — the same "a row written in a
-- position the elaborator does not recognise is silently coerced instead of diagnosed"
-- root as the S0 above, one function apart, which is why it lands in the same change.
-- It is the MIRROR of the shipped use-site check (`fromAstTypeE`'s `TyRow` arm: a row
-- written where a type is expected), so it takes the same shipped code rather than
-- half-applying the decided `T-ROW-KIND-MISMATCH` → `T-EFFECT-KIND-MISMATCH` rename
-- (EFFECTS-SEMANTICS §6.4/§6.9 Q2) at one site out of three.  `pureRow` stays as the
-- inert continuation value so inference proceeds, exactly as `fromAstTypeE` continues
-- with `TCon "Unit"`.
rowArgOf _ ty =
  let _ = pushTypeErrorOnceAt "T-ROW-KIND-MISMATCH" (firstTyLoc ty) (typeInRowSlotMsg ty)
  pureRow

-- Names the offending type, so a signature elaborated twice folds into one diagnostic.
-- ⚠️ `pushTypeErrorOnceAt` keys on the MESSAGE TEXT ALONE — the loc is NOT part of the
-- key (see its body).  So two different bad slots holding the SAME offending type
-- (`weird : Box Int Int` and `alsoWeird : Box Int Unit`) collapse to ONE diagnostic and
-- the second is silently unreported.  That is the behaviour of both shipped
-- `T-ROW-KIND-MISMATCH` sites, matched here on purpose rather than fixed in passing —
-- but do not read the type name in the message as making the key per-slot.
typeInRowSlotMsg : Ty -> String
typeInRowSlotMsg ty = "The type `\{ppTy ty}` was written here, but this type-argument position is row-kinded — it expects an effect row, not an ordinary type. Write the row you mean (`<>` for no effects, `<Stdout>`, `<IO | e>`, …), or a row variable bound by the enclosing signature."

-- names a type uses in a KRow type-app argument slot (so a caller can seed them
-- into an etbl with shared effvars before elaborating).  Walks the whole type.
-- The unscoped entry point: a type that is NOT an interface method signature has no
-- graded head, so only the DATA half (dataParamKindsRef) can contribute.  Every
-- general elaborator seam calls this one.
rowArgNames : Ty -> List String
rowArgNames ty = rowArgNamesIn [] ty

-- [scope] is the graded typaram map of the interface whose method signature this
-- type IS (declGradedScope); `[]` everywhere else.  It is the ONLY channel by which an
-- abstract head can be row-kinded, which is what confines #822 to method signatures.
rowArgNamesIn : List (String, List Kind) -> Ty -> List String
rowArgNamesIn scope (TyApp a b) = match tyAppSpine (TyApp a b)
  -- OCCURRENCE MINT (#1110/#1111 A-2.3), same source as `fromAstTypeE`'s.
  (TyCon { tyConName = n, tyConOrigin = o }, args) => rowArgNamesApp scope o n args (rowArgNamesIn scope a ++ rowArgNamesIn scope b)
  -- #822: the abstract-head half — an interface typaram of graded kind, in scope.
  (TyVar h, args) => rowArgNamesVarApp scope h args (rowArgNamesIn scope a ++ rowArgNamesIn scope b)
  _ => rowArgNamesIn scope a ++ rowArgNamesIn scope b
rowArgNamesIn scope (TyFun a b) = rowArgNamesIn scope a ++ rowArgNamesIn scope b
rowArgNamesIn scope (TyTuple ts) = flatMap (rowArgNamesIn scope) ts
rowArgNamesIn scope (TyEffect _ _ t) = rowArgNamesIn scope t
rowArgNamesIn scope (TyConstrained _ t) = rowArgNamesIn scope t
rowArgNamesIn _ _ = []

rowArgNamesApp : List (String, List Kind) -> TyConOrigin -> String -> List Ty -> List String -> List String
rowArgNamesApp scope o n args fallback = match lookupTab (tyTabKey o n) perRun.value.dataParamKindsRef.value
  Some kinds if listLen kinds == listLen args => krowArgVarNames kinds args
    ++ flatMap (rowArgNamesIn scope) args
  _ => fallback

rowArgNamesVarApp : List (String, List Kind) -> String -> List Ty -> List String -> List String
rowArgNamesVarApp scope h args fallback = match lookupAssoc h scope
  Some kinds if listLen kinds == listLen args => krowArgVarNames kinds args
    ++ flatMap (rowArgNamesIn scope) args
  _ => fallback

krowArgVarNames : List Kind -> List Ty -> List String
krowArgVarNames [] _ = []
krowArgVarNames _ [] = []
krowArgVarNames (KRow::ks) ((TyVar n)::as2) = n :: krowArgVarNames ks as2
-- A KRow slot filled with a WRITTEN row carrying an open tail var (#997,
-- `Box <Stdout | e> Int`) pins `e` exactly like a bare `Box e Int` does —
-- same var-name contribution, just spelled with labels attached. A CLOSED
-- written row (`Box <Stdout> Int`, no tail var) pins no name and falls
-- through to the catch-all below, same as any other non-`TyVar` arg.
krowArgVarNames (KRow::ks) ((TyRow _ (Some n) _)::as2) =
  n :: krowArgVarNames ks as2
krowArgVarNames (_::ks) (_::as2) = krowArgVarNames ks as2

-- ── environment ───────────────────────────────────────────────────────────
-- The type environment uses the shared `OrdMap` (support.ordmap): a persistent
-- String-keyed weight-balanced tree.  The env is looked up on EVERY variable
-- occurrence and carries the whole prelude + every imported module's public
-- bindings, so an assoc-list env made inference O(n^2); OrdMap gives O(log n)
-- lookup and structure-sharing inserts (the branching/backtracking inference env
-- stays valid).  Insert OVERWRITES on equal keys, matching the old assoc-list
-- "newest binding shadows older" semantics (prepend + first-match).
-- alphaLets (3rd field, EFFECTS WS-2 / E3 precision): same-function-body
-- `let`-bound (name, rhs) pairs in scope, seeded into α's known-prefix analysis
-- so an outer-body `let dest = "idp.example.com/page"` then `fetch dest` recovers
-- the literal prefix instead of collapsing to ⊤.  Intraprocedural ONLY —
-- accumulated as infer descends ELet/ELetGroup/block lets (PVar / single-clause
-- zero-arg only, mirroring α's own binding rule); read at the fill site via α's
-- initial `lets`.  A literal laundered through a helper stays ⊤ (spec §5
-- non-goal).  Sound: only turns over-rejections into acceptances.  (Mirror of
-- lib/typecheck.ml's env.alpha_lets.)
-- #837 incr2 (Axis A): the 4th field is a name→is-local channel — a FAITHFUL
-- lexical-scope carrier for "does this name currently denote a body-local
-- binding?", replacing the reset-at-body-entry `bodyLocalSchemesRef` proxy.  It
-- is immutable and restored on inference return, so an out-of-scope local is
-- simply ABSENT — no stale entries, no lifetime management (the exact wish the
-- old `(name, schemeIds)` key worked around).  Only `extendLocalVar[s]` set it;
-- top-level / interface-method / ctor / SCC seeds use `extendVar[s]` and leave
-- it absent.  Read by `lookupLocalFlag` at the two `recordImplObligation` guards.
public export data TcEnv =
  | TcEnv (OrdMap Scheme) (OrdMap Scheme) (List (String, Expr)) (OrdMap Bool)  -- vars, ctors, alphaLets, isLocal

lookupVar : TcEnv -> String -> Option Scheme
lookupVar (TcEnv vs cs _ _) n = match omLookup n vs
  Some s => Some s
  None => omLookup n cs

lookupCtor : TcEnv -> String -> Option Scheme
lookupCtor (TcEnv _ cs _ _) n = omLookup n cs

extendVar : TcEnv -> String -> Scheme -> TcEnv
extendVar (TcEnv vs cs al lc) n s = TcEnv (omInsert n s vs) cs al lc

extendVars : TcEnv -> List (String, Scheme) -> TcEnv
extendVars env [] = env
extendVars env ((n, s)::rest) = extendVars (extendVar env n s) rest

-- #837 incr2: like extendVar/extendVars, but FLAG the introduced names local.
-- Route every genuine body-local binder (let/where/lambda/pattern/prop/do
-- binders) through these; the is-local flag then answers the two guard sites.
extendLocalVar : TcEnv -> String -> Scheme -> TcEnv
extendLocalVar (TcEnv vs cs al lc) n s =
  TcEnv (omInsert n s vs) cs al (omInsert n True lc)

extendLocalVars : TcEnv -> List (String, Scheme) -> TcEnv
extendLocalVars env [] = env
extendLocalVars env ((n, s)::rest) =
  extendLocalVars (extendLocalVar env n s) rest

-- #837 incr2: is `n` currently bound as a BODY-LOCAL binding?  Presence in the
-- is-local map means local (only `extendLocalVar[s]` insert, always True).
lookupLocalFlag : TcEnv -> String -> Bool
lookupLocalFlag (TcEnv _ _ _ lc) n = omHasKey n lc

addCtor : TcEnv -> String -> Scheme -> TcEnv
addCtor (TcEnv vs cs al lc) n s = TcEnv vs (omInsert n s cs) al lc

-- EFFECTS WS-2: seed α's known-prefix scope with a same-function-body let RHS.
-- Prepended (most-recent-first) to mirror α's own `(x,e1)::lets` accumulation.
seedAlphaLets : TcEnv -> String -> Expr -> TcEnv
seedAlphaLets (TcEnv vs cs al lc) n rhs = TcEnv vs cs ((n, rhs)::al) lc

-- read the accumulated α-let scope (for the hole-fill site)
envAlphaLets : TcEnv -> List (String, Expr)
envAlphaLets (TcEnv _ _ al _) = al

monoScheme : Mono -> Scheme
monoScheme t = Forall [] [] t

-- ── pattern inference: returns the pattern's type + the bindings it adds ───
inferPat : TcEnv -> Pat -> (Mono, List (String, Scheme))
inferPat _ (PVar x _) =
  let v = freshVar ()
  let _ = recordLocalBind x v
  (v, [(x, monoScheme v)])
inferPat _ PWild = (freshVar (), [])
inferPat _ (PLit l) = (litType l, [])
inferPat env (PCon name pats) = inferPatCon env name pats
inferPat env (PTuple pats) = inferPatTuple env pats
inferPat env (PCons h t) = inferPatCons env h t
inferPat env (PList pats) = inferPatList env pats
inferPat env (PAs x _ p) = inferPatAs env x p
inferPat env (PRec name fields _) = inferPatRec env name fields
inferPat _ (PRng lo hi _) = inferPatRng lo hi
inferPat _ _ = panic "typecheck: unsupported pattern"

-- range pattern `lo..hi` / `lo..=hi`: only Int and Char bounds are valid
-- (mirrors lib/typecheck.ml PRng arm); binds no variables
inferPatRng : Lit -> Lit -> (Mono, List (String, Scheme))
inferPatRng (LInt _) (LInt _) = (tconBuiltin "Int", [])
inferPatRng (LChar _) (LChar _) = (tconBuiltin "Char", [])
inferPatRng lo hi =
  let _ = pushTypeError "T-TYPE-MISMATCH" "Type mismatch: \{ppMono (litType lo)} vs \{ppMono (litType hi)}"
  (tconBuiltin "Int", [])

inferPatRec : TcEnv -> String -> List RecPatField -> (Mono, List (String, Scheme))
inferPatRec env name fields = match lookupRecordByName name
  None =>
    let _ = pushTypeError "T-UNKNOWN-RECORD" (unknownRecordMsg name)
    (freshVar (), bindRecPatFieldsFresh env fields)
  Some ri => inferPatRecWith env name ri fields
-- bind the field pattern vars with fresh types (no field-type info) so the
-- arm body still typechecks; the oracle fails fast on the unknown record, we
-- accumulate, so dropping the bindings would raise spurious unbound-var errors

-- bind a record pattern's fields against fresh types, NO unknown-field check
-- (the record itself is already-reported unknown; see inferPatRec error path)
bindRecPatFieldsFresh : TcEnv -> List RecPatField -> List (String, Scheme)
bindRecPatFieldsFresh _ [] = []
bindRecPatFieldsFresh env ((RecPatField fname _ mp)::rest) = inferRecPatFieldWith env (freshVar ()) fname mp
  ++ bindRecPatFieldsFresh env rest

inferPatRecWith : TcEnv -> String -> RecordInfo -> List RecPatField -> (Mono, List (String, Scheme))
inferPatRecWith env rname ri fields =
  let ir = instantiateRecord ri
  (fst ir, inferRecPatFields env rname (snd ir) fields)

inferRecPatFields : TcEnv -> String -> List (String, Mono) -> List RecPatField -> List (String, Scheme)
inferRecPatFields _ _ _ [] = []
inferRecPatFields env rname fieldTypes ((RecPatField fname _ mp)::rest) = inferRecPatField env rname fieldTypes fname mp
  ++ inferRecPatFields env rname fieldTypes rest

inferRecPatField : TcEnv -> String -> List (String, Mono) -> String -> Option Pat -> List (String, Scheme)
inferRecPatField env rname fieldTypes fname mp = match lookupAssoc fname fieldTypes
  None =>
    let _ = pushTypeError "T-UNKNOWN-FIELD" (unknownFieldMsg fname rname)
    inferRecPatFieldWith env (freshVar ()) fname mp
  Some ft => inferRecPatFieldWith env ft fname mp
-- bind the field's pattern vars against a fresh type so the arm body still
-- typechecks (the oracle fails fast on the unknown field; we accumulate, so
-- skipping the binding would raise spurious downstream unbound-variable errors)

inferRecPatFieldWith : TcEnv -> Mono -> String -> Option Pat -> List (String, Scheme)
inferRecPatFieldWith _ ft fname None = [(fname, monoScheme ft)]
inferRecPatFieldWith env ft _ (Some p) =
  let pr = inferPat env p
  let _ = unify (fst pr) ft
  snd pr

litType : Lit -> Mono
litType (LInt _) = tconBuiltin "Int"
litType (LFloat _) = tconBuiltin "Float"
litType (LString _) = tconBuiltin "String"
litType (LChar _) = tconBuiltin "Char"
litType (LBool _) = tconBuiltin "Bool"
litType LUnit = tconBuiltin "Unit"

inferPatCon : TcEnv -> String -> List Pat -> (Mono, List (String, Scheme))
inferPatCon env name pats = match lookupCtor env name
  None =>
    let _ = pushTypeError "T-UNKNOWN-CTOR" (unknownCtorMsg name)
    let pr = inferPats env pats
    (freshVar (), snd pr)
  Some scheme => inferPatConWith env scheme pats
-- still infer the sub-patterns so their bindings reach the arm body
-- (else the continued path raises spurious unbound-variable errors the
-- oracle never reaches — it fails fast on the unknown constructor)

inferPatConWith : TcEnv -> Scheme -> List Pat -> (Mono, List (String, Scheme))
inferPatConWith env scheme pats =
  let ctorType = instantiate scheme
  let pr = inferPats env pats
  let resultVar = freshVar ()
  let _ = unify ctorType (foldrFun (fst pr) resultVar)
  (resultVar, snd pr)

inferPats : TcEnv -> List Pat -> (List Mono, List (String, Scheme))
inferPats _ [] = ([], [])
inferPats env (p::ps) =
  let pr = inferPat env p
  let rest = inferPats env ps
  (fst pr :: fst rest, snd pr ++ snd rest)

foldrFun : List Mono -> Mono -> Mono
foldrFun [] result = result
foldrFun (a::rest) result = TFun a pureRow (foldrFun rest result)

inferPatTuple : TcEnv -> List Pat -> (Mono, List (String, Scheme))
inferPatTuple env pats =
  let pr = inferPats env pats
  (tupleMono (fst pr), snd pr)

inferPatCons : TcEnv -> Pat -> Pat -> (Mono, List (String, Scheme))
inferPatCons env h t =
  let hr = inferPat env h
  let tr = inferPat env t
  let listTy = TApp (tconBuiltin "List") (fst hr)
  let _ = unify (fst tr) listTy
  (listTy, snd hr ++ snd tr)

inferPatList : TcEnv -> List Pat -> (Mono, List (String, Scheme))
inferPatList env pats =
  let elem = freshVar ()
  let pr = inferPats env pats
  let _ = unifyAll elem (fst pr)
  (TApp (tconBuiltin "List") elem, snd pr)

inferPatAs : TcEnv -> String -> Pat -> (Mono, List (String, Scheme))
inferPatAs env x p =
  let pr = inferPat env p
  let _ = recordLocalBind x (fst pr)
  (fst pr, (x, monoScheme (fst pr)) :: snd pr)

unifyAll : Mono -> List Mono -> Unit
unifyAll _ [] = ()
unifyAll t (x::xs) =
  let _ = unify t x
  unifyAll t xs

-- ── expression inference ──────────────────────────────────────────────────
infer : TcEnv -> Expr -> Mono
infer _ (ELit l) = litType l
-- PLAN.md #11: a source integer literal is `Num a` for a fresh `a`.  With the
-- prelude loaded (Num registered + `fromInt` in scope), model the literal exactly
-- as `fromInt n` — mirror of lib/typecheck.ml's e7031e6 ENumLit arm.  inferMethodAt
-- "fromInt" records the Num impl obligation AND a pendingSite keyed on [dref] (the
-- node's route cell), so resolveSites later stamps [dref]: RKey when the literal's
-- type grounds to a concrete Num head, RDictFwd onto the enclosing `Num a` dict when
-- it stays polymorphic (the soundness case, `1` in `inc x = x + 1` — exactly the
-- route `fromInt 0` in `sum` gets).  Apply the `Int -> a` method type to an Int arg
-- (mirror OCaml's `unify from_int_ty (TFun t_int … a)`) to recover the result var
-- [a], and stash (a, fref, n, dref) in numlitRefs so the post-HM setNumlitFloats can
-- decide concrete-Float / concrete-Int / still-poly.  Recording the obligation here
-- AND (when under `+`) in numArithOp is harmless: both unify the same var, both
-- demand `Num`.  Without the prelude (bare-HM oracle, `builtinClassPresent BNum` False)
-- `fromInt` is unbound: fall back to a plain fresh var, dref stays RNone (⇒ Int).
infer env (ENumLit n fref dref _) = inferNumLit env n fref dref
infer env (EVar x) = inferVar env x
-- #837: EVarId carries the resolve-minted binding id; thread it to
-- instantiateVarTracked so obligation lookup keys by (name, id).
infer env (EVarId x id) = inferVarId env x id
infer env (EApp f x) = inferAppExpr env f x
infer env (ELam pats body) = inferLam env pats body
infer env (ELet isMut isFun pat e1 e2) = inferLet env isMut isFun pat e1 e2
infer env (ELetGroup binds body) = inferLetGroup env binds body
infer env (EIf c t e) = inferIf env c t e
infer env (EMatch scrut arms) = inferMatch env (infer env scrut) arms
infer env (ETuple es) = tupleMono (inferEach env es)
infer env (EListLit es) = inferListLit env es
infer env (EAnnot e ty) = inferAnnot env e ty
infer env (EBinOp op l r dref) = inferBinopE env op l r dref
infer env (EUnOp op e dref) = inferUnopE env op e dref
infer env (EInfix op l r) = inferInfix env op l r
infer env (ERecordCreate name fields) = inferRecordCreate env name fields
infer env (EFieldAccess e fname r) = inferFieldAccess env e fname r
infer env (ERecordUpdate base fields r) = inferRecordUpdate env base fields r
infer env (EVariantUpdate cname base fields) =
  inferVariantUpdate env cname base fields
infer env (EBlock stmts) = inferBlock env stmts
infer env (EMethodAt name tagRef implRef methodRef) =
  inferMethodAt env name tagRef implRef methodRef
infer env (EDictAt name routesRef) = inferDictAt env name routesRef
infer env (EArrayLit es) = inferArrayLit env es
infer env (ERangeList lo hi _) = inferIntRange env lo hi (tconBuiltin "List")
infer env (ERangeArray lo hi _) = inferIntRange env lo hi (tconBuiltin "Array")
-- EIndex is desugared to an `index` method call before typecheck (Phase #16b);
-- the built-in index-inference path is retired, so no `EIndex` arm here.  ESlice
-- is likewise desugared to a `slice` method call before typecheck (#670), so
-- no `ESlice` arm here -- a surviving one is a desugar-ordering bug and hits the
-- loud "unsupported expression" catch-all, and a non-container receiver becomes a
-- "no impl of Slice" constraint error via normal method dispatch.
infer env (EHeadAnnot e ty) = inferHeadAnnot env e ty
-- ELoc is transparent: capture the span in `currentLoc` (so any type error
-- recorded while inferring the wrapped expr is attributable to this position,
-- mirror of lib/typecheck.ml's ELoc arm), then infer the inner expr.
infer env (ELoc l e) =
  currentLoc := Some l
  infer env e
-- Phase 150: a do-lowered chain.  Record the do-block loc so a monad-shape
-- mismatch during inference is retargeted to the tailored "do requires a monad"
-- error (see typeMismatch); RESTORE the previous value afterwards, not a hard
-- `None` (#894 review finding 2) — an EARLIER statement in the SAME do-chain
-- can itself be an inline nested `do` block (`a <- (do ...)`), whose own
-- `EDoOrigin` used to unconditionally clear the flag to `None` on the way out
-- and so silently un-blame every LATER statement in the outer chain, reviving
-- the pre-fix container/List/Array message for a later `x <- <scalar>` bind.
-- Nesting is otherwise unremarkable (this node is already fully re-entrant
-- everywhere else it is handled — `mapKids`, `alpha`, `appSpineName`, …).
infer env (EDoOrigin l e) =
  let prevDoOrigin = !currentDoOrigin
  currentDoOrigin := Some l
  let t = infer env e
  currentDoOrigin := prevDoOrigin
  t
infer _ _ = panic "typecheck: unsupported expression"

inferArrayLit : TcEnv -> List Expr -> Mono
inferArrayLit env es =
  let elem = freshVar ()
  let _ = unifyAll elem (inferEach env es)
  TApp (tconBuiltin "Array") elem

-- [lo..hi] : List Int, [|lo..hi|] : Array Int
inferIntRange : TcEnv -> Expr -> Expr -> Mono -> Mono
inferIntRange env lo hi container =
  let _ = unify (infer env lo) (tconBuiltin "Int")
  let _ = unify (infer env hi) (tconBuiltin "Int")
  TApp container (tconBuiltin "Int")

-- (ESlice's `inferSlice`/`indexKind` were retired with #670: `a.[lo..hi]` now
-- desugars to a `slice` method call before typecheck, so slicing infers
-- through normal interface dispatch on `Slice`, not a bespoke arm here.)

-- a method occurrence.  Return-position: record (routeRef, result mono) so
-- resolveSites can stamp RKey/RDict.  D3a arg-position (name in
-- argDispatchIdxByIdRef): the dispatch is decided by the DISCRIMINATING-ARGUMENT type,
-- not the result, so queue recordArgStamp on the arg-position mono instead — it is
-- NOT a pendingSites/methodSiteFns return-position site.
inferMethodAt : TcEnv -> String -> Ref Route -> Ref (List Route) -> Ref (List Route) -> Mono
inferMethodAt env name tagRef implRef methodRef = match lookupVar env name
  None => panic ("unbound method: " ++ name)
  Some s =>
    let inst = instantiateTracked s
    let _ = recordMethodDicts name methodRef (snd inst)
    -- #816/#818 shadow guard — shared with inferVarPlainId (the check path); see
    -- recordMethodObligationGuarded for the full rationale.  The tracked
    -- instantiation `fst inst` is already computed (its recordMethodDicts side-effect
    -- fired above), so pass it in rather than re-instantiate.
    let _ = recordMethodObligationGuarded env name s (fst inst)
    let _ = recordRLocalSite env name tagRef (fst inst)
    let ret = match argDispatchOf name
      Some idx =>
        let _ = recordArgStamp name tagRef implRef idx (fst inst)
        let _ = recordArgSiteFn name idx (fst inst)
        fst inst
      None => recordSite name tagRef implRef (fst inst)
    -- P0-19 d4b (S4): a bare value-position definer shadow (`map size xs`, marked to
    -- `EMethodAt`) denotes the STANDALONE — return its declared scheme type so the type
    -- mismatches live-impl elements (Box vs Int) instead of dispatching, while the route
    -- side-effects above still stamp RLocal (ungrounded receiver) so `map size [1,2,3]`
    -- runs the standalone.  Inert for an application head (shadowHeadCtxRef True).
    match maybeStandaloneValueMono name
      Some m => m
      -- #410/#669 (S4, EMIT path): maybeStandaloneValueMono is keyed on the BARE name via
      -- `definerShadowNamesRef`, but the mangler (mangleUnits) has already renamed the
      -- definer standalone's funDef + call sites to `<mid>__name` before marking, so the
      -- bare name is no longer in that ref and the pin above misses — the occurrence then
      -- gets the permissive METHOD scheme (`a -> a -> Int`), so `map size` infers element
      -- type `Int -> Int` (a function) and `println`'s `Display (List (Int -> Int))`
      -- stamps a NULL element route (RNone → i64 0 dict word → the built binary SEGFAULTs,
      -- while `run` is correct because eval follows the RLocal route this same call already
      -- stamped).  Recover the shadow post-mangle exactly as the app-head path does (P0-18):
      -- the route sym seeded on `tagRef` names the mangled standalone, and
      -- `standaloneValuesRef` is the emit-path shadow set (definer ∪ importer) that stamped
      -- RLocal.  Pin the occurrence's TYPE to that standalone's scheme so the element var is
      -- grounded (`Int`/`String`) BEFORE resolveDictApps, closing the check-vs-build type
      -- skew.  Value-position ONLY (shadowHeadCtxRef False); an app head keeps `ret`.
      None => match maybeStandaloneValueMonoEmit env name tagRef
        Some m => m
        None => ret
-- C5: if [name] is a standalone-shadow method, record its discriminating-arg
-- mono cell UNGATED so resolveRLocalSites can route RLocal when the receiver
-- grounds to a no-impl head (the arg-stamp path would otherwise leave it RNone
-- → arg-tag panic on a receiver with no impl).

-- Cause-A prerequisite: ALSO record the discriminating-arg mono into
-- methodSiteFns keyed by currentFn (mirroring recordSite, which only fires
-- for return-position).  Without this, an unsignatured fn whose body
-- dispatches a method in ARGUMENT position (`f s = display s`) never
-- surfaces its inferred constraint to inferredConstraintIds → never gets
-- promoted → no leading dict param on the build path → dict word 0 (SIGSEGV/
-- silent).  Inert unless promotion (discoverPromotedModules) consumes it.

-- C5: queue a standalone-shadow method occurrence's discriminating-arg mono cell so
-- resolveRLocalSites can stamp RLocal once inference grounds the receiver.  Only
-- shadows (standaloneValuesRef) are recorded — every other method occurrence is
-- untouched (no entry → byte-identical).  The dispatch index comes from the method's
-- declared interface type (methodDispatchIdx).
-- S-1: this is the GENERAL shadow-occurrence recorder, and it is the path that a
-- VALUE-position shadow (`map size [1,2,3]`) and an IMPORTER shadow on an UNGROUNDED
-- receiver (`size 3`, where the Num literal is not yet grounded so inferShadowApp's
-- standalone arm is never reached) both take.  Both must carry the standalone's dicts or
-- they under-apply exactly like the headline bug.  Slots only — NOT obligations; see
-- shadowStandaloneDictSlotsAt.
recordRLocalSite : TcEnv -> String -> Ref Route -> Mono -> Unit
recordRLocalSite env name tagRef inst
  | toggles.value.suppressRLocalRecord.value = ()
  | not (contains name driverState.value.standaloneValuesRef.value) = ()
  | otherwise = match methodDispatchIdx name
    None => ()
    Some idx => match nthArgMono idx inst
      Some am =>
        let sym = routeLocalSym !tagRef
        let dicts = shadowStandaloneDictSlotsAt (standaloneSchemeFor env name sym) (if sym == "" then name else sym) am
        perRun.value.pendingRLocalSites := PendingEntry name tagRef am "" (SKRLocal sym (standaloneValuePinned name) dicts.sdMonos dicts.sdIfaces dicts.sdArgVecs) !currentLoc :: perRun.value.pendingRLocalSites.value
      None => ()

-- the SHADOWING STANDALONE's scheme.  An IMPORTER shadow's bare name is rebound by env1
-- to the interface-METHOD scheme, so it must come from shadowStandaloneSchemesRef; a
-- DEFINER shadow's comes from the env (under the mangled symbol on the emit path).
standaloneSchemeFor : TcEnv -> String -> String -> Option Scheme
standaloneSchemeFor env name sym = match lookupAssoc name perRun.value.shadowStandaloneSchemesRef.value
  Some s => Some s
  None => lookupVar env (if sym == "" then name else sym)

-- C5: the dispatch-arg index of an interface method, from the graph-wide map
-- methodDispatchIdxByIdRef (built by checkModuleFullImpl from every interface decl).
-- Ungated, unlike argDispatchOf — RLocal detection must run on the eval path too.
methodDispatchIdx : String -> Option Int
methodDispatchIdx name =
  dispatchIdxScoped name driverState.value.methodDispatchIdxByIdRef.value

-- the dispatch-arg index of an arg-position method, but only when stamping is
-- enabled (the emit path) — off, every EMethodAt is a return-position site.
argDispatchOf : String -> Option Int
argDispatchOf name =
  dispatchIdxScoped name driverState.value.argDispatchIdxByIdRef.value

-- ── #1351 L3 (MIGRATE Leg 1): the IDENTITY-SCOPED dispatch-index read ───────────
--
-- Both readers above used to answer "which argument position is dispatch-relevant
-- for the bare name [name]" with `lookupAssoc` — FIRST MATCH over the decl-walk
-- order of `argDispatchIndices`.  When two interfaces declare the same method name
-- at DIFFERENT dispatch indices, that order is module-processing order, so the
-- RECEIVER ARGUMENT of an occurrence was decided by import-clause order.  This is
-- Leg 1 of #1351, and it is MEASURED: on the flip direction of #1351's own corpus
-- the index read here is `idx=0` on three orderings and `idx=1` on the other three,
-- on all three arms (L3's clause-1 Leg-1 conflict probe).
--
-- The successor asks the SAME question L2's shadow layer already asked and takes the
-- SAME answer: the declaration `applyMethodScopeOverrides` admits for [name] in THIS
-- module, then that declaration's own row out of L1's identity-keyed table.  It is a
-- LOOKUP, not a second resolver — the resolution happened at `methodIfaceParamsRef`'s
-- population site (the named prohibition, RUN-METHID-056).
--
-- ⚠️ Both readers are re-keyed through ONE accessor on purpose.  `argDispatchOf` has
-- THREE callers (`inferMethodAt`'s return-route decision, `inferDefinerShadowApp`'s
-- arg-stamp push, and `stampWorthyMethod`'s predicate) and `methodDispatchIdx` has
-- one (`recordRLocalSite`).  They answer ONE question, so they move as a SET
-- (RUN-METHID-004/093); re-keying the shared accessor rather than each call site is
-- what makes a partial move unrepresentable here.  Their signatures are unchanged,
-- so no caller is edited.
--
-- ⚠️ A MISS IS NOW `None`, AND THAT IS L5 (CONTRACT), NOT A HEDGE REMOVED BY HAND.
-- Both arms used to fall back to `lookupAssoc name bare` — the bare-name-keyed table
-- whose first-match-over-decl-walk-order answer IS #1351's residual order-dependence.
-- Retiring it needed the precondition L3 wrote down here verbatim ("after `argNames`'
-- consumer joins the site set") to be TRUE, and L5 MEASURED it rather than assuming it:
--
--   * `methodIfaceParamsRef` is `applyMethodScopeOverrides`' output, and that is an
--     OVERLAY on the graph-wide universe floor, never a rebuild (its own ⚠️, and the
--     A-2.5 note at the Module-arm write site).  Scoping re-decides WHICH declaration a
--     colliding name maps to; it does not NARROW the key set.  So this reader's domain
--     is a SUPERSET of the retired bare tables' domain, not a subset of it — the
--     direction that makes the fall-back dead rather than load-bearing.
--   * `argNames`' consumer was ALREADY scoped: `prePassModulePairArg` hands
--     `filterList keep argNames` (keep = `nameableIfaceMethodSet` of the module's own
--     decls) to `prePassDictArg`, so a name this module cannot name is never marked
--     `EMethodAt` and never reaches here.
--   * MEASURED, panic-instrumented, before the edit: across 327 programs
--     (`shadow_fixtures`, `import_order_fixtures`, `must_fail_fixtures`) on `check`,
--     `run` AND `build` — the last being the only path where `argDispatchOf`'s stamping
--     gate is open — plus the compiler's own self-compile, the fall-back arm DECIDED
--     ZERO sites.  `admittedIfaceFor` never missed at all; the id-table miss did occur
--     (`fromInt`) and the bare table missed there too, so both spellings already
--     answered `None`.
--
-- The old prose said answering `None` would turn a dispatched site into an RLocal one.
-- That risk was real while the bare table could still answer; with the measurement
-- above it cannot, and keeping the arm would keep import order deciding a receiver
-- argument on any program the corpus does not yet contain.
--
-- ── The two fields this reader consumes (re-homed here by L3, RUN-METHID-054) ──
-- `argDispatchIdxByIdRef` / `methodDispatchIdxByIdRef` (`DriverState`) — #1351 L1
-- (EXPAND), keyed `(IfaceRef, method name)`.  The `IfaceRef` half carries `irOrigin`,
-- the module-identity component, so a bare method name shared by two interfaces in
-- different modules gets distinct rows instead of colliding.  L1 wrote them and nothing
-- read them; THIS function is the reader L1 was expanding for, and since L5 (CONTRACT)
-- they are the ONLY dispatch-index tables — the bare-name peers they were written in
-- lockstep with are deleted, so lockstep is no longer a property anything can break.
--
-- ⚠️ Their prose lives HERE, not on the fields, because `data DriverState` has the
-- two-line `data X =` / `  | X {` header shape that #829 ([T-PERRUN-COMMENTS])
-- corrupts: a trailing `--` comment on a field survives `fmt --write` only by moving
-- onto a DIFFERENT field, and `fmt --check` does not catch it — measured live at L1,
-- where one `fmt --write` silently relocated two field comments.
--
-- ✅ The bare-name tables are RETIRED (L5, CONTRACT).  `argDispatchIdxRef`,
-- `methodDispatchIdxRef` and the `CrossRun` accumulator behind the latter
-- (`universeMethodDispatchIdxRef`) are gone, along with this reader's `bare`
-- parameter.  `argNames` — the one use of the old table that was a NAME SET rather
-- than an index lookup — is now a pure local `map fst (argDispatchIndices …)` at both
-- of its sites (`elaborateDict`, `elabWorker`); it needed no table storage, only the
-- same structural walk, so no third copy of the universe survives.
dispatchIdxScoped : String -> List ((IfaceRef, String), Int) -> Option Int
dispatchIdxScoped name byId = match admittedIfaceFor name
  None => None
  Some iface => lookupIdxById iface name byId

-- ⚠️ ONE `admittedIfaceFor`, NOT TWO.  Leg 1 (this reader) and Leg 3
-- (`ieImplExistsForHead`) both need "which declaration does this module admit for
-- [name]", and they must get it from the SAME read — S2-DECL (b) is precisely the rule
-- that both halves come from one declaration, so two near-duplicate readers of
-- `methodIfaceParamsRef` would be the defect wearing the fix's clothes.  The definition
-- lives beside `ieImplExistsForHead`; this site consumes it.
--
-- ⚠️ `sameTyConHead`, not a bare `irName` compare — the same rule `lookupSchemeById`
-- states: this is a LOOKUP, where a false HIT is a wrong dispatch index (silent
-- wrongness) and a false MISS routes the call site to RLocal instead of falling back
-- to a bare-name answer — see `:9088-9101` for why that is a routing change, not a
-- free miss.
lookupIdxById : IfaceRef -> String -> List ((IfaceRef, String), Int) -> Option Int
lookupIdxById _ _ [] = None
lookupIdxById iface n (((ir, mn), i)::rest)
  | mn == n && sameTyConHead ir.irName ir.irOrigin iface.irName iface.irOrigin = Some i
  | otherwise = lookupIdxById iface n rest

-- Phase 69.x-e: if [name] is a method with method-level constraints (foldMap's
-- `Monoid m`), map each constraint's scheme id through this occurrence's
-- instantiation subst to its concrete mono and record the (methodRef, monos) so
-- resolveMethodDicts can route them after inference.  A method with no method-level
-- constraint records nothing — methodRef stays [], eval's fold is a no-op.
recordMethodDicts : String -> Ref (List Route) -> List (Int, Mono) -> Unit
recordMethodDicts name methodRef subst = match alignedMethodConstraintIds name subst
  None => ()
  Some ids => perRun.value.pendingMethodDicts := (methodRef, constraintMonosOf ids subst)::perRun.value.pendingMethodDicts.value

-- D2: the constraint-slot ids of method [name] that line up with THIS occurrence's
-- instantiation [subst].  methodConstraintsRef can hold MULTIPLE entries for one
-- (uniquely-named) method, each registered with its own FRESH ids by a different
-- elaborate sweep (discoverPromotedModules' discovery sweep, then the real
-- elabWorker sweep) — crossModuleMethodConstraintsRef accumulates them across
-- sweeps and is not re-keyed before recordMethodDicts reads it.  A plain bare-name
-- first-match (lookupAssocSL2) returns whichever entry is frontmost, which after the
-- discovery sweep is a STALE entry whose ids belong to a dead id range, disjoint from
-- the live [subst] keys → constraintMonosOf drops them all → empty route → the
-- cross-module method-level dict is never threaded ("no matching impl" at run /
-- SIGSEGV at build).  The LIVE entry is the one the call's instantiateTracked actually
-- quantified — i.e. whose ids are keys of [subst].  Pick the entry with the most ids
-- present in [subst] (>0); fall back to bare first-match when none overlap (preserves
-- the single-entry / no-instantiation goldens byte-for-byte).  Diamond-safe: a method
-- re-exported through an intermediate keeps the ORIGINAL definer's scheme ids (seedVars
-- threads the scheme object verbatim), so its [subst] keys match the original entry,
-- which alignment selects regardless of intermediate sweeps.
alignedMethodConstraintIds : String -> List (Int, Mono) -> Option (List Int)
alignedMethodConstraintIds name subst = match positionMatch name subst perRun.value.methodConstraintPositionsRef.value
  Some ids => Some ids
  None =>
    let entries = filterList (e => fst e == name) perRun.value.methodConstraintsRef.value
    match entries
      [] => None
      _ => match bestAlignedEntry subst entries (0 - 1) None
        Some ids => Some ids
        None => lookupAssocSL2 name perRun.value.methodConstraintsRef.value

-- The DEFINITIVE slot ids for THIS occurrence: index the occurrence's ORDERED subst
-- (instantiateTracked keys subst by the scheme's own ids via freshSubst, preserving
-- var order) at the method's stable constraint-slot POSITIONS.  Allocation-
-- independent, so it picks the applicative `m` slot regardless of cross-sweep id
-- overlap (where a stale id maps to the container `t` — both Thenable).  None when
-- the method has no recorded positions, or a position is out of range (e.g. an empty
-- subst from a monomorphic recursive call) ⇒ caller falls back to countInSubst.
positionMatch : String -> List (Int, Mono) -> List (String, List Int) -> Option (List Int)
positionMatch name subst positionsTbl = match lookupAssocSL2 name positionsTbl
  None => None
  Some positions =>
    let keys = map fst subst
    let n = listLen keys
    if allInRange positions n then
      Some (map (p => nthInt p keys) positions)
    else
      None

allInRange : List Int -> Int -> Bool
allInRange [] _ = True
allInRange (p::rest) n = p >= 0 && p < n && allInRange rest n

nthInt : Int -> List Int -> Int
nthInt _ [] = 0 - 1
nthInt 0 (x::_) = x
nthInt i (_::xs) = nthInt (i - 1) xs

-- among [entries] (all the same-named method-constraint records), the ids of the one
-- with the most slots present in [subst]; None until a positive-overlap entry is seen.
bestAlignedEntry : List (Int, Mono) -> List (String, List Int) -> Int -> Option (List Int) -> Option (List Int)
bestAlignedEntry _ [] _ best = best
bestAlignedEntry subst ((_, ids)::rest) bestN best =
  let n = countInSubst ids subst
  if n > 0 && n > bestN then
    bestAlignedEntry subst rest n (Some ids)
  else
    bestAlignedEntry subst rest bestN best

countInSubst : List Int -> List (Int, Mono) -> Int
countInSubst [] _ = 0
countInSubst (id::rest) subst =
  (match lookupAssocI id subst
      Some _ => 1
      None => 0) +
    countInSubst rest subst

-- record a return-position method occurrence: resolveSite later stamps its route
-- (RKey/RDict) once inference grounds the result mono.
recordSite : String -> Ref Route -> Ref (List Route) -> Mono -> Mono
recordSite name tagRef implRef methodType =
  let stripped = stripArrows methodType
  perRun.value.pendingSites := PendingEntry name tagRef stripped perRun.value.currentFn.value (SKReturn implRef methodType) !currentLoc :: perRun.value.pendingSites.value
  perRun.value.methodSiteFns := consSiteFn perRun.value.currentFn.value stripped perRun.value.methodSiteFns.value
  methodType

-- a constrained-function occurrence (`f` where `f : C a => …`): instantiate f's
-- scheme (the call's type), and record the routes ref + the instantiated
-- constraint monos so resolveDictApps can pick a dict route once the call's args
-- pin those monos.  funConstraintsRef[f] gives f's constraint tyvar ids, mapped
-- through the instantiation subst to this call's fresh vars.
inferDictAt : TcEnv -> String -> Ref (List Route) -> Mono
inferDictAt env name routesRef = match lookupVar env name
  None => panic ("unbound constrained fn: " ++ name)
  Some scheme => inferDictAtFound name routesRef (instantiateTracked scheme)

-- The callee's constraints are registered (funConstraintsRef has it) ⇒ a normal
-- call: map each constraint id through the instantiation subst to this call's
-- monos.  Absent ⇒ a self/mutually-recursive call (the callee is still inferring
-- in the same group); defer it for realizeRecDictApps to forward the enclosing
-- fn's dict.
-- A constrained callee in funConstraintsRef is reached two ways: (1) a NORMAL call
-- to an already-generalized fn — instantiateTracked pins each of its constraint ids
-- to a fresh occurrence var, so `snd inst` carries them; route via pendingDictApps.
-- (2) a SELF/MUTUALLY-RECURSIVE call — the callee is still the group's monomorphic
-- PLACEHOLDER (Forall [] [] v), so `snd inst` is empty (none of [ids] appear).  Here
-- the constraint var lives in the ENCLOSING fn's own type and the callee's REGISTERED
-- ids only become valid after this pass's registerInferredConstraints re-registers
-- them; defer to realizeRecDictApps (which forwards the enclosing dict).  We MUST NOT
-- take the normal branch here (as a stale cross-module funConstraintsRef seed makes us
-- do): constraintMonosOf maps the registered ids through the empty subst → [] → the
-- recursive call's route ref stays empty while dictPass still prepends the param → the
-- call under-applies → dispatch fails.  Detect (2) as "no registered id is pinned by
-- the instantiation subst" (mirrors the oracle's empty-`sub` self-recursion case).
-- WS-2/D2: a cross-module constrained callee's dict SLOTS (id + interface, paired) by
-- MODULE IDENTITY.  When [name] is an EXPLICITLY-imported value (currentImportDefinersRef)
-- whose import SOURCE module owns a (source,name) entry in the qualified arity tables,
-- return that entry — the definer-keyed arity, immune to the bare-name most-recent-prepend
-- collision in the jointly-seeded funConstraintsRef.  None ⇒ local fn / wildcard import /
-- re-export / check path (mid ""): inferDictAtFound falls back to the bare funConstraintsRef
-- + funConstraintIfacesRef path (today's behavior; same slots when no collision, since
-- the qual entry is the same module's same ids the bare first-match returns sans collision).
-- S-xmod-vector-supply (#1868/#1867): a PROJECTION of `qualConstraintDecl`, which is the
-- ONE qual-entry resolution.  It was the whole body until this slice; a third reader
-- (`declaredCrossModuleObls`) needed the same entry's ARGUMENT VECTORS as well as its
-- slots, and two readers re-deriving which entry a name resolves to is the drift
-- `qualConstraintKey` was factored out to remove.
qualConstraintFor : String -> Option (List CSlot)
qualConstraintFor name = map (d => d.cdSlots) (qualConstraintDecl name)

-- THE qual-entry resolution: a cross-module constrained callee's whole recorded
-- constraint fact — slots, declared prefix, and argument vectors — from ONE
-- `(definer module, exported name)` decision.  `None` ⇒ not an explicitly-imported name,
-- or that name owns no qual ids entry.
qualConstraintDecl : String -> Option CDeclared
qualConstraintDecl name = match qualConstraintKey name
  None => None
  Some (src, origin) =>
    -- U1b (#1482): the independent lookups still default to `[]` independently —
    -- that is the manufacturable mismatch described on `CSlot` — but they now meet in
    -- `pairSlots`, which owns the policy, instead of in three downstream zips.
    map (ids => qualDeclOf src origin ids)
      (lookupQualPayload src origin crossRun.value.crossModuleFunConstraintsQualRef.value)

qualDeclOf : String -> String -> List Int -> CDeclared
qualDeclOf src origin ids =
  let slots = pairSlots ids
    (fromOption [] (lookupQualPayload src origin crossRun.value.crossModuleFunConstraintIfacesQualRef.value))
  CDeclared {
    cdSlots = slots,
    cdPrefix = clampPrefix slots
      (lookupQualPayload src origin crossRun.value.crossModuleFunConstraintDeclaredQualRef.value),
    -- S-xmod-vector-supply (#1868/#1867): the vectors of the SAME entry.  An ABSENT row
    -- is `[]`, which `zipSlotVecs` reads as "no vector recoverable" for every slot —
    -- byte-identically the pre-slice cross-module behaviour, so a callee registered with
    -- ids but no args is unaffected.  S-inferred-vector-supply (#1869): an INFERRED callee
    -- is no longer automatically in that class — `registerInferredFor` writes a real row
    -- when it recovers one, and writes none (this arm) when it recovers nothing.
    cdArgs = fromOption [] (lookupQualPayload src origin crossRun.value.crossModuleFunConstraintArgsQualRef.value),
  }

-- the (import-source module, ORIGINAL exported name) key a cross-module callee's qual
-- entries live under; `None` ⇒ local fn / wildcard import / re-export / check path.
--
-- #739 fix follow-up: an aliased import's surface name is resolved to its ORIGINAL
-- exported name before keying the qual tables (they are attributed under the defining
-- name).  A plain import / non-alias defaults to the name itself.  Without this,
-- `{set as hmSet}` of a constrained `hash_map.set` misses (qual has `(hash_map, set)`,
-- not `(hash_map, hmSet)`), the slot lookup comes back empty and `inferDictAtFound`
-- DROPS the Hash dict → `no matching impl for dispatch` at run/build.
--
-- ⚠️ FACTORED OUT BY U1b (#1482) so `qualConstraintFor` (slots) and
-- `qualConstraintIds` (ids only) cannot drift on WHICH entry they resolve to.  Two
-- readers of one table that re-derive the key independently is the shape this seam
-- already pays for elsewhere; there is one derivation.
qualConstraintKey : String -> Option (String, String)
qualConstraintKey name = map
  (src => (
    src,
    fromOption name (lookupAssoc name perRun.value.currentImportOriginsRef.value),
  ))
  (lookupAssoc name perRun.value.currentImportDefinersRef.value)

-- the callee's registered dict-slot IDS, UNPAIRED and UNTRUNCATED — the exact list the
-- pre-U1b `declaredConstraintFor` returned as its first component.
--
-- 🚨 WHY THIS EXISTS, AND WHY IT IS NOT THE PARALLEL-LIST HAZARD `CSlot` REMOVED.
-- `pairSlots` truncates to the SHORTER of (ids, ifaces), which is correct everywhere the
-- result decides dict SLOTS — that is exactly what the zips it replaced did.  But two
-- guards in `inferDictAtFound` and one in `shadowStandaloneDictSlotsAt` do not ask about
-- slots; they ask *"is this callee registered as constrained at all"* and *"did the
-- instantiation pin any of its constraint vars"*.  Reading a TRUNCATED list there changes
-- the answer whenever the arity table HITS and the iface table MISSES — a mismatch this
-- seam can manufacture by construction (see `CSlot`) — and the two arms then differ:
-- one records an empty dict app, the other skips routing (and, at the standalone site,
-- skips a `unify` side effect).  Nobody has built a witness, so the difference is
-- unmeasured, which is precisely why this unit does not take it: an obligation-identity
-- change must not smuggle in a routing change nobody asked for.
--
-- It is NOT zipped against an interface list anywhere — its only consumers are
-- `isEmptyL` and `anyIdPinned` — so it cannot mispair with one.  That is the property
-- `CSlot` protects, and it is preserved.
declaredConstraintIds : String -> List Int
declaredConstraintIds name = match qualConstraintIds name
  Some ids => ids
  -- same #739 source-exact discipline as `declaredConstraintFor`'s `None` arm below:
  -- a known import with no qual entry is genuinely unconstrained, and must NOT fall
  -- through to the source-blind bare-name table.
  None =>
    if hasImportDefiner name then []
    else fromOption [] (lookupAssocSL2 name perRun.value.funConstraintsRef.value)

qualConstraintIds : String -> Option (List Int)
qualConstraintIds name = match qualConstraintKey name
  None => None
  Some (src, origin) => lookupQualPayload src origin crossRun.value.crossModuleFunConstraintsQualRef.value

-- first-match lookup in a `(definer module, exported name)`-keyed qual table.
--
-- B-2.2-f (#1113): ONE polymorphic function where there were two byte-identical
-- monomorphic copies (`lookupQualArity` / `lookupQualIfaces`).  The declared-prefix
-- sidecar's payload is a SCALAR, so a third copy could not have shared their `List X`
-- shape anyway — and three identical bodies is where `rule-duplicate-body` starts
-- collecting disables.
lookupQualPayload : String -> String -> List ((String, String), a) -> Option a
lookupQualPayload _ _ [] = None
lookupQualPayload src name (((m, n), v)::rest)
  | m == src && n == name = Some v
  | otherwise = lookupQualPayload src name rest

-- WS-2/D2 + B-2.2-f (#1113): the slots-only projection `declaredConstraintSlots` is
-- RETIRED.  It had exactly two readers — `inferDictAtFound` and the shadow route — and
-- FIX-shadow-arity-skew is what a slots-only projection costs: slice 3 widened what
-- `cdSlots` is keyed by (whole predicate, vector included), the call sides that had a
-- vector agreed with the widened definition side, and the one reader still taking the
-- bare-slots projection expanded against a constant `[]` and collapsed two slots into
-- one.  Take `declaredConstraintFor` and project BOTH halves off the one entry decision,
-- or you are re-opening this bug by construction.  (The same argument that removed
-- `declaredConstraintK`: two readers re-deriving which entry a name resolves to is the
-- drift `qualConstraintKey` was factored out to remove.)
--
-- B-2.2-f (#1113): the ONE resolution — a constrained callee's declared dict slots AND
-- how many of them its own `=>` context declared (the rest being super slots
-- `expandSupersPairs` appends downstream).  Arms mirror the retired `declaredConstraintSlots`'
-- former body exactly, keyed once through `qualConstraintKey`.
--
-- 🚨 The prefix is CLAMPED against the slots actually returned (`clampPrefix`).
-- `pairSlots` truncates to the shorter of (ids, ifaces), a mismatch this seam can
-- manufacture by construction (see `CSlot`), and an unclamped `index < k` past the end
-- of a truncated list marks APPENDED slots declared — the unsafe direction.  UNWITNESSED
-- (instrumented over a full compiler build and a two-module probe; it never fired), so
-- the clamp is defensive, not measured — it is one token and it fails closed.
--
-- S-xmod-vector-supply (#1868/#1867): the qual arm is now `qualConstraintDecl`, shared
-- with `qualConstraintFor` and `declaredCrossModuleObls`.  The two arms that used to be
-- spelled out here — a qual KEY hit whose ids payload MISSES, and no qual key at all with
-- the name still an import — collapse into the one `hasImportDefiner` test below: a
-- `qualConstraintKey` hit IS a `currentImportDefinersRef` hit (same ref, same lookup), so
-- the empty `CDeclared` both arms produced is unchanged.
declaredConstraintFor : String -> CDeclared
declaredConstraintFor name = match qualConstraintDecl name
  Some d => d
  -- #739: source-exact fallback.  An EXPLICITLY-imported name (present in
  -- currentImportDefinersRef) whose (import-source, name) qual entry is ABSENT is
  -- genuinely UNCONSTRAINED in its source module — every module's constrained fns ARE
  -- attributed into crossModuleFunConstraintsQualRef when it is processed, so a MISS for a
  -- known import means "no constraint", not "look elsewhere".  Do NOT fall back to the
  -- bare-name funConstraintsRef here: on the emit path that table is JOINTLY seeded across
  -- every module (aliasConstraintEntries), so a DIFFERENT module's same-named CONSTRAINED
  -- fn (`p.f : Display a => …`) would be misattributed to this unconstrained callee
  -- (`q.f`), and per-module tyvarCounter reset makes its constraint id collide with a fresh
  -- instantiation var → the call site records a phantom `Display Z` obligation and
  -- run/build OVER-REJECT a valid program (#739).  Mirrors the check-path
  -- declaredCrossModuleObls source-exact discipline (#673/#738).  Only local / wildcard /
  -- re-export / check-path (mid "") names — absent from currentImportDefinersRef — still
  -- take the bare-name path (byte-identical when there is no collision).
  None =>
    if hasImportDefiner name then CDeclared { cdSlots = [], cdPrefix = CDPLen 0, cdArgs = [] }
    else
      let slots = pairSlots
        (fromOption [] (lookupAssocSL2 name perRun.value.funConstraintsRef.value))
        (fromOption [] (lookupAssocS name perRun.value.funConstraintIfacesRef.value))
      CDeclared {
        cdSlots = slots,
        cdPrefix = clampPrefix slots (lookupAssoc name perRun.value.funConstraintDeclaredRef.value),
        -- the LOCAL / wildcard / re-export / check-path arm keeps the bare-name vector
        -- table this slice did not touch — `declaredConstraintArgs`, the same lookup
        -- `enclPreds` uses for the ENCLOSING fn.
        cdArgs = declaredConstraintArgs name,
      }

-- B-2.2-f (#1113): a recorded prefix, clamped to the slots it indexes into; an ABSENT
-- one stays `CDPUnknown`, which every reader must treat as WITHHOLD (prefix 0).  Do not
-- "simplify" the absent arm to `CDPLen 0` — `CDPLen 0` is a recorded state a real entry
-- can hold, and collapsing the two erases the only signal that a write site is missing.
clampPrefix : List CSlot -> Option CDeclaredPrefix -> CDeclaredPrefix
clampPrefix _ None = CDPUnknown
clampPrefix _ (Some CDPUnknown) = CDPUnknown
clampPrefix slots (Some (CDPLen k)) = CDPLen (minI k (listLen slots))

-- #739: is [name] an explicitly-imported value (has a known source module)?  A miss in
-- the qual constraint table for such a name is authoritative ("unconstrained in its
-- source"), so `declaredConstraintFor` must NOT fall through to the source-blind bare-name
-- table for it.  A local / wildcard / re-export name is absent here and keeps the old path.
hasImportDefiner : String -> Bool
hasImportDefiner name = match lookupAssoc name perRun.value.currentImportDefinersRef.value
  Some _ => True
  None => False

inferDictAtFound : String -> Ref (List Route) -> (Mono, List (Int, Mono)) -> Mono
inferDictAtFound name routesRef inst =
  let q = qualConstraintFor name
  -- S-xmod-vector-supply (#1868/#1867): ONE resolution, two projections.  The slots and
  -- the argument vectors `zipSlotVecs` pairs them with below MUST come from the same
  -- entry decision — reading the slots qual-resolved and the vectors off the bare-name
  -- table is precisely the cross-module gap this slice closes.
  let dc = declaredConstraintFor name
  let slots = dc.cdSlots
  -- ⚠️ UNTRUNCATED on purpose — `map (s => s.csId) slots` is NOT the same list when the
  -- arity table hits and the iface table misses.  See `declaredConstraintIds`.
  let declaredIds = declaredConstraintIds name
  let known = match q
        Some _ => True
        None => hasKeySL2 name perRun.value.funConstraintsRef.value
  -- #739: an explicitly-imported callee with NO cross-module constraint (declaredIds empty
  -- and source-exact per Fix A above) is genuinely UNCONSTRAINED — it only reached this
  -- EDictAt path because the marker's dict-name set is source-blind and a DIFFERENT module
  -- exports a same-named CONSTRAINED fn (`p.f`).  It needs NO dict routing: leave routesRef
  -- empty and return the plain instantiated type.  Neither branch below is safe here — the
  -- `if` branch would record a phantom obligation off the bare-name collision, and the
  -- `else` (recursive) branch's realizeRecDictApps does its OWN source-blind bare-name
  -- funConstraintsRef lookup and would forward the wrong module's dict slot.
  if isEmptyL declaredIds && hasImportDefiner name then fst inst
  else if known && anyIdPinned declaredIds (snd inst) then
    -- WS-1b: expand the callee's constraint slots with their transitive supers HERE
    -- (the global table isn't expanded until expandSupersTable runs after inference),
    -- so this call site applies one dict per EXPANDED slot — matching the def params
    -- dictArityOf/dictPass will prepend from the expanded table.  Each super slot's id
    -- equals its sub slot's id (shared type param), still pinned in [snd inst].
    -- S-dict-arity-contract: expand carrying each slot's argument vector, so an APPENDED
    -- super slot routes on the vector its `requires` clause names (`requires Ix a b` off
    -- a `Sub a b` slot ⇒ `Ix Int Char`, not `Ix Int`).  The slot sequence is identical to
    -- `expandSupersPairs`' — it is a projection of this call — so dict ARITY is untouched
    -- here and the define side (`expandSupersEntry`) still agrees slot for slot.
    let expandedV = expandSupersVecs driverState.value.superDeclsRef.value (zipSlotVecs slots dc.cdArgs)
    let expanded = map fst expandedV
    let ids = map (s => s.csId) expanded
    let monos = constraintMonosOf ids (snd inst)
    -- the ROUTING goal stays a spelling (`resolveDictApps` asks the SPELLING-keyed
    -- `KeyBuckets` a route-word question — see `dispHeadTab`); only the OBLIGATION goal
    -- below carries identity.
    let _ = pushDictApp (routesRef, monos, map (s => s.csIface.irName) expanded, callArgVecsV expandedV (snd inst), !currentLoc)
    perRun.value.dictAppFns := (consSiteFn perRun.value.currentFn.value monos perRun.value.dictAppFns.value)
    -- #11 soundness: record this call's instantiated impl obligations (iface paired
    -- with the call's constraint mono), checked after inference by checkCallObligations.
    -- The iface list is slot-parallel to [monos]; a concrete-head mono with no impl
    -- (`Num String` from `f "hello"` where `f : Num a => a -> a`) becomes an error.
    let _ = recordCallObligations expanded monos
    fst inst
  else
    perRun.value.pendingRecDictApps := (RecDictApp routesRef name perRun.value.currentFn.value (fst inst) :: perRun.value.pendingRecDictApps.value)
    fst inst

-- True iff at least one of [ids] (the callee's registered constraint tyvar ids) is
-- a key of the instantiation subst — i.e. instantiateTracked actually quantified it,
-- so this is a normal generalized call.  False ⇒ the callee is a monomorphic
-- placeholder (self/mutual recursion); subst can't carry its constraint occurrence.
anyIdPinned : List Int -> List (Int, Mono) -> Bool
anyIdPinned [] _ = False
anyIdPinned (id::rest) subst = match lookupAssocI id subst
  Some _ => True
  None => anyIdPinned rest subst

-- pair each iface with its slot-parallel instantiated constraint mono, pushing onto
-- pendingCallObligations.  Length-zips defensively (an iface list shorter than the
-- mono list — e.g. a multi-param constraint whose ifaces weren't recorded — just
-- stops, never over-rejecting).
recordCallObligations : List CSlot -> List Mono -> Unit
recordCallObligations [] _ = ()
recordCallObligations _ [] = ()
recordCallObligations (s::ss) (mono::ms)
  | s.csIface.irName == "" = recordCallObligations ss ms
  | otherwise =
    -- 1-ary by construction: these slots are funConstraintsRef's SHATTERED
    -- per-tyvar dict slots (`Ix a i` => two slots), so each carries one mono.
    -- Widening this to a joint vector is the dict-slot=predicate change (#607
    -- punch-list item 3), which moves emitted arity and is deliberately NOT
    -- done here.  The joint obligation for such a predicate is supplied by the
    -- declared-context path (declaredSchemeOblsFor); this path stays as-is.
    -- ⚠️ #1161 (F-3a-ii) widened the ROUTING goal (pushDictApp's 4th component) but
    -- deliberately NOT this OBLIGATION channel — measured: making this site n-ary from
    -- the same vector still ACCEPTED an unsatisfiable `Ix a Bool =>` at exit 0, because
    -- the acceptance decision is made upstream in `declaredSchemeOblsFor` →
    -- `declaredOblOne` → `constraintArgMonos`, which returned `None` for a non-tyvar
    -- argument on an ids-only payload.  That was #1161 symptom 2, and it is CLOSED: the
    -- payload now carries the whole vector (`VecObl.voArgs`) and `declaredOblMixed`
    -- records the predicate.  ⚠️ THIS SITE IS STILL 1-ARY AND STILL DELIBERATELY SO —
    -- the fix landed upstream precisely so that emitted dict arity did not move.
    -- Regression: test/dict_fixtures/s3-sig-constraint-unsatisfiable-rejects.mdk.
    -- P1 (#1446) / U1b (#1482): `funConstraintIfacesRef`'s payload is `List IfaceRef`,
    -- so this site records the interface OCCURRENCE's identity instead of
    -- `OriginUnresolved`.  It was one of the two `ifaceRefBare` producers.
    let _ = recordObl (Predicate { iface = s.csIface, args = [mono] }) 0 PCallSlot !currentLoc
    recordCallObligations ss ms

-- String-keyed assoc lookup over funConstraintIfacesRef (returns the iface name list).
lookupAssocS : String -> List (String, List IfaceRef) -> Option (List IfaceRef)
lookupAssocS _ [] = None
lookupAssocS k ((k2, v)::rest)
  | k == k2 = Some v
  | otherwise = lookupAssocS k rest

hasKeySL2 : String -> List (String, List Int) -> Bool
hasKeySL2 _ [] = False
hasKeySL2 k ((k2, _)::rest)
  | k == k2 = True
  | otherwise = hasKeySL2 k rest

-- instantiate a scheme, returning both the mono and the (quantified id → fresh
-- var) substitution, so a caller can recover specific quantified variables
instantiateTracked : Scheme -> (Mono, List (Int, Mono))
instantiateTracked (Forall ids evars t) =
  let subst = freshSubst ids
  (substMonoP True subst (freshEffSubst evars) t, subst)

-- #1161 (F-3a-ii): the callee's declared per-slot predicate ARGUMENT VECTORS, as
-- recorded at signature registration (registerMember).  Bare-name keyed, mirroring the
-- `None` arm of `declaredConstraintFor`.
-- ⚠️ THIS IS THE LOCAL LOOKUP ONLY, and that is now a NARROWER claim than it was.
-- S-xmod-vector-supply (#1868 silent / #1867 loud) CLOSED the cross-module residual this
-- header used to describe: `crossModuleFunConstraintArgsQualRef` is the `(definer module,
-- exported name)`-keyed twin, seeded beside the ids/ifaces/prefix snapshots and read
-- through `declaredConstraintFor`'s `cdArgs`, so an IMPORTED constrained callee's call
-- site now sees the same argument vector a local one does.  What still reads THIS bare
-- table is (a) `declaredConstraintFor`'s local/wildcard/re-export/check-path arm and
-- (b) `enclPreds`, whose subject is the ENCLOSING fn and therefore always local.
--
-- 🚨 WHY THE QUAL KEY IS WHAT MAKES THE VECTOR SAFE TO CROSS — the hazard this header
-- used to cite as the reason NOT to build the table, and the measurement that answers
-- it.  A stored vector's tyvars are not re-attributed by `attributeModuleEntries` (it
-- only re-keys by `(mid, name)`), and each module resets `tyvarCounter`, so a vector
-- read off the WRONG module's entry substitutes to a wrong-but-concrete goal — strictly
-- worse than missing.  The vector is safe because it never needs re-attribution in the
-- first place: `constraintVarIfaceMonos` (which mints the slot IDS) and
-- `constraintVarArgMonos` (which mints these VECTORS) are called on ONE signature
-- instantiation's `snd inst` in `preunifySigsEx`, so a slot's `csId` is literally one of
-- its own vector's tyvar ids.  The call site then maps BOTH through the same
-- `instantiateTracked` subst of that callee's own scheme, whose quantified ids are those
-- same signature vars.  So the vector lives in exactly the id space the already-shipped
-- ids table crosses in — no wider — and the ONLY way to leave it is to resolve the entry
-- by bare name.  Hence: qual key, no bare-name cross-module peer, no seed back into
-- `funConstraintArgsRef`.  The residual's cost is what drained with it: `useIx : Ix a
-- Char => a -> Int` printed 222 compiled alone and 111 imported — byte-identical source,
-- different answer, exit 0, both engines.
-- ✅ SECOND RESIDUAL — CLOSED by FIX-shadow-arity-skew, and the prose that stood here is
-- kept only as the record of why it had to be.  It read: `resolveRLocalSites` / `SKRLocal`
-- fill their dict routes with the SCALAR `routesOfMonosTop`, so an importer- or
-- definer-shadowed constrained standalone with a multi-argument predicate keeps the
-- per-tyvar goal; and S-xmod-vector-supply left it there deliberately, on the measured
-- ground that it changed only `cdArgs` while the shadow route read only `cdSlots`, so the
-- neighbour was "neither newly wrong nor newly reachable".
-- 🚨 That clearance was SOUND FOR ITS OWN SLICE AND FALSIFIED BY THE NEXT ONE.
-- S-slot-key-vector (#1866) re-keyed `cdSlots` ITSELF on the whole predicate, which is
-- precisely the premise the clearance rested on, and the shadow route — still expanding
-- against a constant `[]` — under-counted the definition's dict params: `run` E-PANIC,
-- `build` a per-execution heap pointer, wasm illegal cast, `check` exit 0.  The lesson is
-- not "that reasoning was careless"; it is that "reads only X, and I touched only Y" has
-- a HALF-LIFE OF ONE SLICE, and a comment recording such a clearance must be re-read by
-- whoever next moves X.  `SKRLocal` now carries the vectors and both resolvers select
-- through `routesOfMonosTopV`; empty vectors make that the scalar router term for term.
declaredConstraintArgs : String -> List (List Mono)
declaredConstraintArgs name =
  fromOption [] (lookupAssocVecs name perRun.value.funConstraintArgsRef.value)

lookupAssocVecs : String -> List (String, List (List Mono)) -> Option (List (List Mono))
lookupAssocVecs _ [] = None
lookupAssocVecs k ((k2, v)::rest)
  | k == k2 = Some v
  | otherwise = lookupAssocVecs k rest

-- Slot-parallel to constraintMonosOf's OUTPUT, and it must stay that way: it walks the
-- SAME slot list against the SAME [subst] and applies the SAME drop rule (an id absent
-- from the instantiation is skipped on both sides), so slot i of the result describes
-- slot i of [monos].
-- S-dict-arity-contract: each slot now arrives PAIRED with its own vector — the stored
-- signature vector for a declared slot, the `requires`-mapped one for an appended super
-- slot (`expandSupersVecs`).  A slot whose vector is empty — an inferred/promoted fn, a
-- super whose params did not all resolve — still yields the singleton `[m]`, the scalar
-- goal `routesOfMonosTop` already used.  ⚠️ A CROSS-MODULE CALLEE IS NO LONGER IN THAT
-- LIST: S-xmod-vector-supply (#1868/#1867) gave it a real vector — see
-- `declaredConstraintArgs`' header.
callArgVecsV : List (CSlot, List Mono) -> List (Int, Mono) -> List (List Mono)
callArgVecsV [] _ = []
callArgVecsV ((s, v)::rest) subst = match lookupAssocI s.csId subst
  Some m => substArgVec subst m v :: callArgVecsV rest subst
  None => callArgVecsV rest subst

-- 🚨 STRUCTURAL, not top-level-only.  The stored vector is in the SIGNATURE's
-- instantiation vars; the call's [subst] maps the scheme's quantified ids to THIS
-- call's monos.  A vector argument like `List b` therefore has to have its INTERIOR
-- tyvar rewritten too, which is what `substMono` does and a top-level id lookup does
-- not: leave `List b` as a stale signature var and `matchTyMonos` fails against every
-- `impl Ix Int (List Char)`-shaped head, the candidate set comes back EMPTY, and the
-- route silently degrades to the bare head tag — i.e. first-declared-wins, the very bug
-- this closes, at a different shape.  ⚠️ F-3c cannot catch that class either:
-- `pickMostSpecificEntry []` returns None, not the ambiguity arm.  Regression:
-- test/dict_fixtures/s3-nary-sig-constraint-structured-arg.mdk, graded on its
-- value by diff_compiler_dict_semantics.sh section 1 and on its order-freedom by
-- that gate's section 4 (which permutes the impl blocks, no _swapped file needed).
substArgVec : List (Int, Mono) -> Mono -> List Mono -> List Mono
substArgVec _ m [] = [m]
substArgVec subst _ v = map (substMono subst []) v

constraintMonosOf : List Int -> List (Int, Mono) -> List Mono
constraintMonosOf [] _ = []
constraintMonosOf (id::rest) subst = match lookupAssocI id subst
  Some m => m :: constraintMonosOf rest subst
  None => constraintMonosOf rest subst

lookupAssocSL2 : String -> List (String, List Int) -> Option (List Int)
lookupAssocSL2 _ [] = None
lookupAssocSL2 k ((k2, v)::rest)
  | k == k2 = Some v
  | otherwise = lookupAssocSL2 k rest

-- #994 (B-3-b): THE write op for the per-run fn-constraint table PAIR, and its
-- cross-module twin below.  `funConstraintsRef` and `funConstraintIfacesRef` are
-- slot-parallel per entry and index-parallel across entries; every whole-table
-- replacement of one owes the matching replacement of the other, and until this op
-- existed that pairing was a convention each site re-established by hand.
--
-- 🚨 It takes the two tables as ONE tuple — the shape `expandSupersCross` already
-- returns — because a "write both members simultaneously" fusion is FORBIDDEN for these
-- tables.  The id expansion READS the pre-expansion iface table (`expandSupersEntry`
-- pairs ids with ifaces before closing over supers), so expanding ids against an
-- ALREADY-expanded iface list appends every super slot a SECOND time and changes dict
-- ARITY: the define side (`dictArityOf`) would bind more dict params than the call side
-- (`recRoutes`/`recRoute`/`inferDictAtFound`) applies.  A pure function that consumes
-- both tables and returns both results makes both reads happen before either write, so
-- the ordering constraint is discharged by the TYPE rather than by statement order in a
-- caller that a later edit can reshuffle.
setFunConstraintTables : (List (String, List Int), List (String, List IfaceRef)) -> Unit
setFunConstraintTables tables =
  perRun.value.funConstraintsRef := fst tables
  perRun.value.funConstraintIfacesRef := snd tables

-- the same op for the CROSS-module snapshot pair (`crossModuleFunConstraintsRef` /
-- `crossModuleFunConstraintIfacesRef`), so the snapshot `expandSupersCross` produces is
-- never unbundled into two locals that a later edit could write independently.
setCrossFunConstraintTables : (List (String, List Int), List (String, List IfaceRef)) -> Unit
setCrossFunConstraintTables tables =
  crossRun.value.crossModuleFunConstraintsRef := fst tables
  crossRun.value.crossModuleFunConstraintIfacesRef := snd tables

-- ── WS-1b: superclass-evidence flatten (port of lib/typecheck.ml expand_supers) ──
-- A `=>`-constrained fn whose body calls a SUPERCLASS method (e.g. `build : Sub a =>`
-- calls `mk`, a Sup method, where `Sub a requires Sup a`) needs an honest super-dict
-- slot threaded through.  Inference registers only the DECLARED constraints in
-- funConstraintsRef/funConstraintIfacesRef; this pass APPENDS, per entry, one extra
-- slot for each (transitive) superinterface, mapping the super's decl param-names to
-- the constraint's instantiated tyvar ids positionally (`Sub a`/`Sup a` share `a`, so
-- the super id == the sub id).  Appended AFTER the declared slots so existing slot
-- indices are unchanged; deduped by (iface, id) within an entry.  Because the dict
-- VALUE is just a type tag (VDict "Widget"), the super slot's route is identical to
-- the sub slot's — no separate projection is needed; the slot just has to EXIST so the
-- call site applies a matching dict and the def binds a matching param.
--
-- Mutates the TABLE refs themselves at ONE finalization point (after inference, before
-- realizeRecDictApps/dictPass) so EVERY reader — define-side dictArityOf and call-side
-- recRoutes/recRoute/inferDictAtFound — sees identical expanded entries automatically.
-- Transitive: a fixpoint over the constraint set (the WS-4a acyclic-supers guard makes
-- it terminate), so `Top` reaches `Base` through `Mid` (chain3b).
--
-- #994 (B-3-b): the expansion itself is `expandSupersCross` — the SAME pure function the
-- cross-module snapshot uses — so the two forms cannot drift apart (they must stay in
-- lockstep or a cross-module constrained fn under-fills), and reading both tables as its
-- arguments is what keeps the old iface table visible to the id expansion.  See
-- `setFunConstraintTables` for why writing the two members simultaneously is forbidden.
expandSupersTable : List Decl -> Unit
expandSupersTable allDecls =
  setFunConstraintTables (expandSupersCross
    allDecls
    perRun.value.funConstraintsRef.value
    perRun.value.funConstraintIfacesRef.value
    perRun.value.funConstraintArgsRef.value)

-- as expandSupersTable but operates on the cross-module snapshot pair (so a
-- cross-module constrained fn gets the same expansion — else it under-fills).
-- S-slot-key-vector (#1866): [argsTbl] joins, for the ID entry only.  The id entry is the
-- one whose dedup decides emitted dict ARITY, and since the key is now the whole predicate
-- it needs the same argument vectors the CALL side already expands with
-- (`inferDictAtFound`'s `zipSlotVecs slots dc.cdArgs`) — otherwise define and call
-- disagree on the slot count for `(Ix a Char, Ix a Bool) => …`.  The IFACE entry
-- deliberately does NOT take it: it expands a SYNTHETIC id list purely to reproduce the
-- same iface SEQUENCE, and feeding it vectors it has no id space for would move that
-- sequence.  See `expandSupersIfaceEntry`.
expandSupersCross : List Decl -> List (String, List Int) -> List (String, List IfaceRef) -> List (String, List (List Mono)) -> (List (String, List Int), List (String, List IfaceRef))
expandSupersCross allDecls idsTbl ifacesTbl argsTbl = (
  map (expandSupersEntry allDecls ifacesTbl argsTbl) idsTbl,
  map (expandSupersIfaceEntry allDecls) ifacesTbl,
)

-- expand one (fn, ids) entry: the parallel iface list is looked up by fn name.
-- S-slot-key-vector (#1866): so is the parallel ARGUMENT-VECTOR list, which `zipSlotVecs`
-- pairs onto the slots (a legitimate PREFIX — a slot past its end reads `[]`, i.e. "no
-- vector recoverable", and keys exactly as it did before this widening).
expandSupersEntry : List Decl -> List (String, List IfaceRef) -> List (String, List (List Mono)) -> (String, List Int) -> (String, List Int)
expandSupersEntry allDecls ifacesTbl argsTbl (fn, ids) =
  let ifaces = fromOption [] (lookupAssocS fn ifacesTbl)
  let args = fromOption [] (lookupAssocVecs fn argsTbl)
  let pairs = expandSupersVecs allDecls (zipSlotVecs (pairSlots ids ifaces) args)
  (fn, map (s => (fst s).csId) pairs)

-- expand one (fn, ifaces) entry the SAME way, returning the parallel iface names.
expandSupersIfaceEntry : List Decl -> (String, List IfaceRef) -> (String, List IfaceRef)
expandSupersIfaceEntry allDecls (fn, ifaces) =
  let ids = idsForIfaceSlots ifaces
  let pairs = expandSupersPairs allDecls (pairSlots ids ifaces)
  (fn, map (s => s.csIface) pairs)

-- a synthetic id list parallel to the iface list when only the iface entry is in
-- hand (the iface-entry expansion must produce the same iface SEQUENCE as the id
-- entry; positions, not values, must agree).  Uses slot index as the id so the
-- super-name substitution + dedup walk identically.  NOTE: this works because in a
-- `requires` chain every slot in one fn's expansion shares its declared tyvar — but
-- DISTINCT declared constraints get distinct synthetic ids, so two unrelated
-- constraints sharing a super still dedup correctly per chain.
idsForIfaceSlots : List IfaceRef -> List Int
idsForIfaceSlots ifaces = idsForIfaceSlotsGo 0 ifaces

idsForIfaceSlotsGo : Int -> List IfaceRef -> List Int
idsForIfaceSlotsGo _ [] = []
idsForIfaceSlotsGo i (_::rest) = i :: idsForIfaceSlotsGo (i + 1) rest

-- transitive super-closure over the declared (iface, id) slots: start from the
-- declared slots, repeatedly append direct supers of every current slot until no
-- new (iface, id) pair appears.  Result is the declared slots first (order/indices
-- preserved) then the appended supers, deduped by (iface, id).
expandSupersPairs : List Decl -> List CSlot -> List CSlot
expandSupersPairs allDecls declared =
  map fst (expandSupersVecs allDecls (map (s => (s, [])) declared))

-- 🚨 S-dict-arity-contract: the SAME fixpoint, carrying each slot's PREDICATE ARGUMENT
-- VECTOR (in the callee signature's instantiation vars) alongside the slot.  `Ix a b`
-- reached as `requires Ix a b` from a `Sub a b` slot used to route on `a`'s mono ALONE
-- — `callArgVecs`' stored-vector list covers only the DECLARED prefix, so every appended
-- super slot took the singleton `[m]` arm, `Ix Int _` matched both `impl Ix Int Bool`
-- and `impl Ix Int Char`, and first-declared won.  Measured on `sup2.mdk`
-- (`S-predicate-representation` Note N2): 111 where the spec says 222, exit 0, silent.
--
-- 🚨 S-slot-key-vector (#1866) MOVED WHICH SLOTS EXIST HERE, deliberately — the sentence
-- that used to stand in this paragraph ("THIS DOES NOT MOVE WHICH SLOTS EXIST … AND IT
-- MUST NOT") is now FALSE and is retracted rather than left to mislead.  The dedup is
-- `dedupSlotVecs` over `cslotVecKey`, i.e. over the WHOLE PREDICATE, so
-- `(Ix a Char, Ix a Bool) => …` now opens TWO slots where it opened one.  The old wording
-- was right about the HAZARD and wrong about the remedy: what must not move is the
-- SYNTHETIC-id path.  `expandSupersIfaceEntry` expands `idsForIfaceSlots` (slot index)
-- purely to reproduce the same iface SEQUENCE, and it has no real tyvar ids and no vectors
-- at all — so it goes through `expandSupersPairs`, whose slots all carry `[]`, whose keys
-- therefore all gain the same constant empty suffix, and whose sequence is consequently
-- byte-identical to before.  Only the ID entry (`expandSupersEntry`) was given real
-- vectors, and it is the entry `dictArityOf` sizes from and the one the CALL side
-- (`inferDictAtFound`, which has expanded WITH vectors since S-dict-arity-contract)
-- already agreed with slot-for-slot.  `superSlotOf`'s `firstOrZero` id-collapse is
-- untouched and still owed.
--
-- 🚨 F7 / FIX-shadow-arity-skew: the sentence that stood here — "`expandSupersPairs` is a
-- projection of this, so there is ONE fixpoint and the sequence cannot drift between the
-- vector-carrying and vector-free readers" — is FALSE IN THE GENERAL CASE and is retracted.
-- One fixpoint does NOT imply one sequence: `expandSupersPairs` feeds it a constant `[]`
-- suffix, and since the dedup key is the WHOLE PREDICATE, a vector-free reader collapses
-- exactly the slots a vector-carrying reader keeps.  What actually holds is narrower:
-- the SYNTHETIC-id path (`expandSupersIfaceEntry`) never drifts, because it carries no
-- real tyvar ids and no vectors at all, so every one of its keys gains the SAME constant
-- empty suffix and its sequence is byte-unchanged.  Any OTHER vector-free reader of a
-- REAL slot list drifts against `expandSupersEntry` — which is the bug
-- `shadowStandaloneDictSlots` shipped, and the reason `expandSupersPairs` now has exactly
-- one caller.  Before adding a second, check whether its slots have vectors available: if
-- they do, it belongs on `expandSupersVecs`.
expandSupersVecs : List Decl -> List (CSlot, List Mono) -> List (CSlot, List Mono)
expandSupersVecs allDecls declared = expandSupersFix allDecls declared declared

expandSupersFix : List Decl -> List (CSlot, List Mono) -> List (CSlot, List Mono) -> List (CSlot, List Mono)
expandSupersFix allDecls acc frontier =
  let next = dedupSlotVecs (acc ++ flatMap (superSlotsOfV allDecls) frontier)
  if listLen next == listLen acc then
    acc
  else
    expandSupersFix allDecls next (dropN (listLen acc) next)

-- S-slot-key-vector (#1866): keyed on the WHOLE PREDICATE — slot AND argument vector — so
-- the vector DOES participate in the arity decision.  `(Ix a Char, Ix a Bool) => …` is two
-- predicates sharing one interface spelling and one lead tyvar id; keying on `cslotKey`
-- alone merged them into ONE dict slot and both `ix x 'z'` and `ix x True` routed through
-- it (444 where the spec says 333, silently, all three engines agreeing).  `(Shw a, Shw a)`
-- is the case this must still collapse — genuinely the SAME predicate written twice — and
-- it does, because its two vectors key identically.
-- ⚠️ The two id-free expansion entry points stay in step BECAUSE the widening is a SUFFIX:
-- `expandSupersIfaceEntry` carries no vectors at all (`expandSupersPairs`), so every one of
-- its keys gains the same constant empty suffix and its slot SEQUENCE is byte-unchanged.
dedupSlotVecs : List (CSlot, List Mono) -> List (CSlot, List Mono)
dedupSlotVecs xs = dedupBy cslotVecKey xs

-- pair each declared slot with the argument vector its signature recorded.  The vector
-- list is a PREFIX (`keptConstraintArgs`; and `registerInferredFor` records `[]` for a
-- slot whose predicate it could not recover — S-inferred-vector-supply, #1869), so a slot
-- past its end, or with an empty vector at its position, gets `[]`, which every consumer
-- reads as "no vector recoverable".
zipSlotVecs : List CSlot -> List (List Mono) -> List (CSlot, List Mono)
zipSlotVecs [] _ = []
zipSlotVecs (s::rest) [] = (s, []) :: zipSlotVecs rest []
zipSlotVecs (s::rest) (v::vs) = (s, v) :: zipSlotVecs rest vs

-- the direct super slots of one (iface, id) slot: look up iface's (typarams, supers);
-- the super-param NAMES index into typarams, which map positionally to [id] (a single
-- shared id since constraints in a `requires` chain are over the same type param).
-- ⚠️ Both the user-interface gate and the `ifaceSupersOf` lookup ask a SPELLING
-- question (`userIfaceNamesRef` is a name set, `ifaceSupersOf` scans `DInterface` by
-- name).  U1b (#1482) did not re-key either: doing so would change which slots exist,
-- i.e. dict ARITY, which is emitted-code shape and #1425's ground.  The slot's own
-- identity comes from the `Super` occurrence that produced it.
-- S-dict-arity-contract: it ALSO maps the sub-predicate's own argument vector
-- positionally onto its type parameters, so each super slot can carry the vector its
-- `requires` clause names.  [vec] empty (no vector recorded for this slot) ⇒ every super
-- gets `[]` too, i.e. exactly today's singleton-goal behaviour.
superSlotsOfV : List Decl -> (CSlot, List Mono) -> List (CSlot, List Mono)
superSlotsOfV allDecls (s, vec)
  | not (contains s.csIface.irName driverState.value.userIfaceNamesRef.value) = []   -- WS-1b: only expand USER interface supers (prelude chains stay arg-tag)
  | otherwise = match ifaceSupersOf allDecls s.csIface.irName
    None => []
    Some (typarams, supers) =>
      let subst = zipL typarams (replicate (listLen typarams) s.csId)
      let vsubst = if listLen vec == listLen typarams then zipL typarams vec else []
      flatMap (superSlotOfV subst vsubst) supers

-- one `Super superName params`: map each param name through subst → its id; emit the
-- super slot only if ALL params resolved (matches the oracle's length guard).
superSlotOf : List (String, Int) -> Super -> List CSlot
superSlotOf subst sup = map fst (superSlotOfV subst [] sup)

-- ⚠️ THE SLOT HALF IS UNCHANGED — same guard, same `firstOrZero` id.  Only the vector is
-- new: each super param name resolved through the sub-predicate's positional vector
-- [vsubst], and ONLY when every param resolves (a partial vector would route on a
-- shorter-than-declared argument list and match nothing, which degrades to the bare head
-- tag — worse than the singleton it replaces).
superSlotOfV : List (String, Int) -> List (String, Mono) -> Super -> List (CSlot, List Mono)
superSlotOfV subst vsubst (Super { superHead = superName, superParams = params, superOrigin = so }) =
  let mapped = filterMaybeIds (map (p => lookupAssoc p subst) params)
  let vmapped = filterMaybeMonos (map (p => lookupAssoc p vsubst) params)
  if listLen mapped == listLen params then
    (
      CSlot {
        csIface = IfaceRef { irName = superName, irOrigin = so },
        csId = firstOrZero mapped,
      },
      if listLen vmapped == listLen params then vmapped else [],
    )::[]
  else
    []

filterMaybeMonos : List (Option Mono) -> List Mono
filterMaybeMonos [] = []
filterMaybeMonos ((Some x)::rest) = x :: filterMaybeMonos rest
filterMaybeMonos (None::rest) = filterMaybeMonos rest

-- every super slot in a `requires` chain carries the SAME id; represent the slot by it.
firstOrZero : List Int -> Int
firstOrZero [] = 0
firstOrZero (x::_) = x

filterMaybeIds : List (Option Int) -> List Int
filterMaybeIds [] = []
filterMaybeIds ((Some x)::rest) = x :: filterMaybeIds rest
filterMaybeIds (None::rest) = filterMaybeIds rest

-- U1b (#1482): one polymorphic drop, replacing the byte-identical `dropPairs` /
-- `dropVecObls` pair (the payload widening would otherwise have made it three).
dropN : Int -> List a -> List a
dropN n xs
  | n <= 0 = xs
  | otherwise = match xs
    [] => []
    _::rest => dropN (n - 1) rest

-- dedup (iface, id) pairs, keeping first occurrence (so declared slots stay leading).
-- #242: routed through the canonical O(n·log n) `support.util.dedupBy` (was a
-- private O(n²) `List`-as-a-set scan).  The iface name is length-prefixed so the
-- key is injective for ANY name content.
dedupPairs : List (String, Int) -> List (String, Int)
dedupPairs xs = dedupBy slotKey xs

slotKey : (String, Int) -> String
slotKey (iface, id) = lenKey iface ++ intToString id

-- U1b (#1482): the `CSlot` analogue's key.  ⚠️ Keyed on the interface SPELLING,
-- deliberately — this key feeds the dedup that decides how many dict slots a constrained
-- fn has, so keying it on identity would give two same-spelled interfaces two slots where
-- today they share one, moving emitted dict ARITY.  That is a separate judgment with a
-- different blast radius (#1425's ground), and neither U1b nor S-slot-key-vector makes it:
-- the latter widens on the predicate's ARGUMENT VECTOR (`cslotVecKey`), never on identity.
-- ⚠️ NOT a dedup key on its own any more — the only `dedupBy` over slots is
-- `dedupSlotVecs`, over `cslotVecKey`.  The vector-free `dedupSlots` that used to live
-- here was deleted with #1866: keeping it would have let a reader dedup slots without
-- their vectors, which is exactly the collapse that slice removed.
cslotKey : CSlot -> String
cslotKey s = lenKey s.csIface.irName ++ intToString s.csId

-- S-slot-key-vector (#1866): THE dict-slot identity — `cslotKey` plus the predicate's
-- argument vector.  Exactly the widening `vecOblKey` already carries on the obligation
-- channel, for the same reason and with the same per-argument encoding (`oblArgKey`),
-- which since S-nonlead-arg-identity (#1904) renders each position STRUCTURALLY and keys
-- each tyvar on its IDENTITY.  ⚠️ That widening was load-bearing HERE and not on the
-- obligation channel: `cslotKey` carries only `csId`, the LEAD position's id, so before
-- it this key had no per-position id at all and `(Ix a b c, Ix a c b)` — one interface,
-- one lead id, two distinct vectors — collapsed to ONE slot.  `|` cannot appear in the
-- prefix (a `lenKey` netstring followed by decimal digits), so the encoding is injective
-- over the two components.
-- ⚠️ An EMPTY vector contributes a constant empty suffix, so a caller that carries no
-- vectors at all (`expandSupersPairs`, and hence `expandSupersIfaceEntry`'s synthetic-id
-- expansion) keys order-equivalently to the pre-widening `cslotKey` — which is what keeps
-- that path's slot sequence byte-identical.  It is also why widening on a PARTIAL vector
-- supply degrades to today's collapse rather than to a wrong slot count.
cslotVecKey : (CSlot, List Mono) -> String
cslotVecKey (s, vec) = "\{cslotKey s}|\{joinWith "," (map oblArgKey vec)}"

-- the type a method ultimately returns (strip its argument arrows); the impl is
-- chosen by this type's head tycon (pure : a -> f a → f a; empty : f a → f a)
stripArrows : Mono -> Mono
stripArrows (TFun _ _ b) = stripArrows b
stripArrows t = t

-- bare sequential block: value of the last statement; earlier statements typed
-- for effect; let/assign extend the env
inferBlock : TcEnv -> List DoStmt -> Mono
inferBlock _ [] = tconBuiltin "Unit"
inferBlock env [s] = inferLastStmt env s
inferBlock env (s::rest) = inferBlock (inferStmt env s) rest

inferLastStmt : TcEnv -> DoStmt -> Mono
inferLastStmt env (DoExpr e) = infer env e
inferLastStmt env s =
  let _ = inferStmt env s
  tconBuiltin "Unit"

inferStmt : TcEnv -> DoStmt -> TcEnv
inferStmt env (DoExpr e) =
  let t = infer env e
  let _ = checkStmtNotDiscarded t e
  env
-- #866: the binder's own Loc is threaded to blockRecLet for the pin note.  A
-- FUNCTION-FORM block let (`let h a p q = …`) parses with rec=True and lands HERE, not
-- in blockLet — so a pin note built from `exprLoc` of the curried lambda (which carries
-- no ELoc wrapper) had no location and the diagnostic silently never fired for the most
-- ordinary spelling of a local helper.  The binder pattern always has a real Loc.
inferStmt env (DoLet _ True (PVar x xloc) e) = blockRecLet env x (Some xloc) e
inferStmt env (DoLet _ _ pat e) = blockLet env pat e
inferStmt env (DoAssign x e) = extendLocalVar env x (monoScheme (infer env e))
-- A `<-` bind (DoBind) reaching a bare block is a user error: `<-` is
-- monadic-`do`-only, and a monadic `do` lowers to EDo (desugared before
-- typecheck), so only a bare-block `<-` arrives here.  Emit a clean LOCATED
-- error (symmetric with doRequiresMonadMsg) instead of panicking; infer the RHS
-- for effect (surfacing its own errors + snapshotting its ELoc span for the
-- caret) and bind the pattern's vars into env so downstream statements don't
-- cascade spurious `Unbound variable` errors (mirrors inferRecPatField).
inferStmt env (DoBind pat e) =
  let t = infer env e
  let _ = pushTypeError "T-BIND-OUTSIDE-DO" bindOutsideDoMsg
  let pr = inferPat env pat
  let _ = unify (fst pr) t
  extendLocalVars env (snd pr)
inferStmt _ _ = panic "typecheck: unsupported block statement"

-- A bare (non-final, non-`let`) block statement discards its value.  A free
-- result var (nothing downstream constrained it) is pinned to `Unit` via plain
-- `unify` — always succeeds, and is exactly what "this value goes unused"
-- means for an otherwise-unconstrained type.  A CONCRETE non-`Unit` type is a
-- real mismatch, but routing it through bare `unify` would render the generic
-- `Type mismatch: Int vs Unit` (ERROR-QUALITY.md dim 3/5: doesn't name the rule
-- or offer the fix), so it is reported here instead with its own code and a
-- one-token `fix` (`let _ = `) for the intentional-discard case.
checkStmtNotDiscarded : Mono -> Expr -> Unit
checkStmtNotDiscarded t e
  | isExemptInPlaceSetIndex t e = ()
  | otherwise = match normalize t
    TCon "Unit" _ => ()
    TVar cell => match !cell
      Unbound _ _ => unify t (tconBuiltin "Unit")
      Link _ => panic "checkStmtNotDiscarded: normalize left a Link"
    nt => pushDiscardedValueError nt e

-- `a[i] := v` desugars to `setIndex a i v` (`rewriteAssignIndex`, desugar.mdk), and
-- `IndexMut.setIndex : c -> k -> v -> c` (core.mdk) returns the container BY
-- INTERFACE CONTRACT so a caller can chain — but every current impl (`Array`,
-- `MutArray`, mut_array.mdk) mutates in place and returns the SAME value, so the
-- bare-statement idiom `arr[i] := v` (real code: sqlite/lib/dbwriter.mdk,
-- gzip/lib/{huffman,inflate}.mdk) never actually loses anything by discarding it.
--
-- ⚠️ NOT exempted by callee name alone: `setIndex` is not a reserved word and
-- method names are not globally unique (#1111 A-2.5) — a user's OWN unrelated
-- binding named `setIndex` (e.g. `setIndex : HashMap -> String -> Int -> Bool`,
-- an existed-already probe) would silently dodge the discard check too, which
-- is exactly the bug this check exists to catch. `isExemptInPlaceSetIndex`
-- therefore also requires the DISCARDED VALUE's own head type constructor to be
-- one of the two real in-place `IndexMut` impls (`Array`/`MutArray`) — since
-- `setIndex : c -> k -> v -> c`, that head IS the receiver's head, so this reads
-- the receiver's type off the statement's own already-inferred `t` for free,
-- no separate route/interface lookup needed. A future persistent-container
-- `IndexMut` impl (`setIndex` returning a NEW value) would need EXCLUDING from
-- `exemptInPlaceIndexMutHeads`, not just narrowing further.
-- `setIndex` is an `IndexMut` interface method, so `marker.mdk` rewrites every
-- `EVar` naming it to `EMethodRef` before typecheck ever sees it — except this
-- driver has TWO whole-program entry points (`checkModulesDiags`, used by
-- `check`, vs `elaborateModules`, used by `build`/`run`; see harden-typechecker
-- skill), and only the latter runs with `implInferEnabled` on, which stamps
-- the call's resolved dispatch route onto the node BEFORE this check runs,
-- turning `EMethodRef "setIndex"` into `EMethodAt "setIndex" …` — reproduced:
-- `medaka check` on sqlite/lib/dbwriter.mdk was clean while `medaka build`
-- rejected the same file, because `stmtCalleeName` didn't yet cover
-- `EMethodAt`/`EDictAt`. So `stmtCalleeName` must handle both stamped forms
-- alongside the unstamped `EMethodRef`, where `appSpineName` (this file's
-- other spine-name walk, used elsewhere) covers neither.
stmtCalleeName : Expr -> Option String
stmtCalleeName (ELoc _ e) = stmtCalleeName e
stmtCalleeName (EDoOrigin _ e) = stmtCalleeName e
stmtCalleeName (EAnnot e _) = stmtCalleeName e
stmtCalleeName (EApp f _) = stmtCalleeName f
stmtCalleeName (EVar n) = Some n
stmtCalleeName (EVarId n _) = Some n
stmtCalleeName (EVarAt n _) = Some n
stmtCalleeName (EMethodRef n) = Some n
stmtCalleeName (EMethodAt n _ _ _) = Some n
stmtCalleeName (EDictAt n _) = Some n
stmtCalleeName _ = None

exemptInPlaceIndexMutHeads : List String
exemptInPlaceIndexMutHeads = ["Array", "MutArray"]

isExemptInPlaceSetIndex : Mono -> Expr -> Bool
isExemptInPlaceSetIndex t e = match headTyconNameMono t
  Some hd => stmtCalleeName e == Some "setIndex"
    && contains hd exemptInPlaceIndexMutHeads
  None => False

pushDiscardedValueError : Mono -> Expr -> Unit
pushDiscardedValueError nt e =
  let loc = exprLoc e
  pushTypeErrorHelpFixAt
    "T-DISCARDED-VALUE"
    loc
    (discardedValueMsg nt)
    "bind it with 'let _ = …' if dropping the value is intentional, or use its value"
    (discardedValueFix loc)

discardedValueMsg : Mono -> String
discardedValueMsg nt = "this statement's value (\{ppMono nt}) is silently discarded — only a `Unit`-typed expression may stand alone as a statement"

discardedValueFix : Option Loc -> Option (Loc, String)
discardedValueFix (Some (Loc f sl sc _ _)) =
  Some (Loc f sl sc sl sc, "let _ = ")
discardedValueFix None = None

blockRecLet : TcEnv -> String -> Option Loc -> Expr -> TcEnv
blockRecLet env x xloc e =
  let _ = checkRecBindNonFunction x e  -- #799
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let placeholder = freshVar ()
  let envSelf = extendLocalVar env x (monoScheme placeholder)
  let t1 = infer envSelf e
  let _ = unify placeholder t1
  let _ = exitLevel ()
  let addedObls = wWindow perRun.value.implObls oblN0
  let _ = defaultAmbiguousNum addedObls t1  -- PLAN.md #11
  let _ = registerAmbiguousConstraints addedObls [t1]  -- RETPOS soundness
  let _ = recordLocalBind x t1  -- LSP hover (block rec-let bypasses inferPat)
  let sch = genRestricted (not (pinLocalIfDictForwarded callN0 dictN0 x xloc t1)) t1  -- #866
  let _ = registerLocalScheme x sch oblN0 callN0 dictN0
  seedAlphaLets (extendLocalVar env x sch) x e  -- WS-2: α scope-seed

blockLet : TcEnv -> Pat -> Expr -> TcEnv
blockLet env (PVar x xloc) e =
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let t = infer env e
  let _ = exitLevel ()
  let addedObls = wWindow perRun.value.implObls oblN0
  let _ = defaultAmbiguousNum addedObls t   -- PLAN.md #11
  let _ = registerAmbiguousConstraints addedObls [t]   -- RETPOS soundness
  let _ = recordLocalBind x t   -- LSP hover (block let bypasses inferPat)
  let sch = genRestricted (isNonexpansive env e && not (pinLocalIfDictForwarded callN0 dictN0 x (Some xloc) t)) t  -- #866
  let _ = registerLocalScheme x sch oblN0 callN0 dictN0
  -- WS-2: α scope-seed — bindings are immutable, so the prefix is stable.
  seedAlphaLets (extendLocalVar env x sch) x e
blockLet env pat e =
  let t = infer env e
  let pr = inferPat env pat
  let _ = unify (fst pr) t
  extendLocalVars env (snd pr)

inferRecordCreate : TcEnv -> String -> List FieldAssign -> Mono
inferRecordCreate env name fields = match lookupRecordByName name
  None => unknownRecordFresh name
  Some ri => inferRecordCreateWith env name ri fields

-- Record CREATE.  A construction supplies EVERY field, so a single `R { … }` with
-- N fields is itself O(N x N): each supplied field did a `lookupAssoc fn` over the N
-- declared field types.  Same fix as the access/update paths (issue #980): instantiate
-- the result + each supplied field via the O(log N) index, and check missing fields
-- against the declared NAME list.  `checkMissingFields` walks declared order (identical
-- to the old `snd ir` order, which is `map fst fields`), so the missing-field errors are
-- pushed in the same order; the per-supplied-field unify is byte-identical (same subst).
inferRecordCreateWith : TcEnv -> String -> RecordInfo -> List FieldAssign -> Mono
inferRecordCreateWith env rname ri fields =
  let sr = instantiateRecordShared ri
  let _ = checkMissingFields rname (recordFieldNames ri) (omFromPairs (map fieldAssignNamePair fields) omEmpty)
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

fieldAssignNamePair : FieldAssign -> (String, Unit)
fieldAssignNamePair (FieldAssign fn _) = (fn, ())

-- Index-based field-assignment unify for the record CREATE and UPDATE paths: instead of
-- instantiating all N declared fields and linearly `lookupAssoc`-ing each supplied
-- field, look the supplied field up in the record's O(log N) index and instantiate
-- ONLY it with the shared param substitution (issue #980).  Byte-identical: same field
-- Mono (same `subst`, same `substMono`), same error + order (per supplied field, in
-- supplied order), `infer env val` is still the only fresh-var allocator in each step.
unifyFieldAssignsIdx : TcEnv -> String -> RecordInfo -> List (Int, Mono) -> List FieldAssign -> Unit
unifyFieldAssignsIdx _ _ _ _ [] = ()
unifyFieldAssignsIdx env rname ri subst ((FieldAssign fn val)::rest) =
  let _ = unifyFieldAssignIdx env rname ri subst fn val
  unifyFieldAssignsIdx env rname ri subst rest

unifyFieldAssignIdx : TcEnv -> String -> RecordInfo -> List (Int, Mono) -> String -> Expr -> Unit
unifyFieldAssignIdx env rname ri subst fn val = match omLookup fn (recordFieldMap ri)
  None => pushTypeError "T-UNKNOWN-FIELD" (unknownFieldMsg fn rname)
  Some fm => unify (infer env val) (substMono subst [] fm)

-- TYPECHECK-AUDIT OBS4: every declared field must be supplied in a record
-- construction (mirrors lib/typecheck.ml ERecordCreate "Every declared field
-- must be supplied" loop).  Walk `declaredFields`, check each name is present
-- among the supplied `FieldAssign` list; push MissingField for any absent one.
-- `supplied` is the SET of supplied field names (built once by the caller), so the
-- membership test is O(log N) instead of a per-declared-field O(N) list scan — a single
-- N-field construction was O(N x N) here (issue #980).  Declared order is still walked
-- in order, so the missing-field errors are pushed in exactly the old order.
checkMissingFields : String -> List String -> OrdMap Unit -> Unit
checkMissingFields _ [] _ = ()
checkMissingFields rname (fname::rest) supplied
  | omHasKey fname supplied = checkMissingFields rname rest supplied
  | otherwise =
    let _ = pushTypeError "T-MISSING-FIELD" (missingFieldMsg fname rname)
    checkMissingFields rname rest supplied

-- Phase 72 / TYPECHECK-AUDIT C2: receiver-directed field resolution.  Infer the
-- receiver FIRST, then pick the owning record by its head tycon when known; if
-- the receiver is still an unbound var and the field is owned by several
-- records, the access is ambiguous (mirrors lib/typecheck.ml's EFieldAccess +
-- field_owners multimap).  `value` keeps the Ref-projection special case (no
-- record in compiler/stdlib declares a `value` field, so this matches the
-- oracle's structural `(Ref a).value → a`).
inferFieldAccess : TcEnv -> Expr -> String -> Ref String -> Mono
inferFieldAccess env e fname r
  | fname == "value" = inferValueField env e
  | otherwise =
    let te = normalize (infer env e)
    match resolveFieldRecord te fname
      None => freshVar ()
      Some (rname, ri) =>
        r := rname
        inferFieldOfRecord te rname ri fname

-- `cell.value` projects a Ref's contents.  Unify the receiver with `Ref a`
-- (forcing it, like the reference's `(Ref a).value → a` special case) and return
-- `a` — done by unification, not a structural match, so it also works when the
-- receiver's type is still an unsolved tyvar at this point (the self-hosted
-- typecheck infers function params as fresh vars, not yet pinned to their sig).
inferValueField : TcEnv -> Expr -> Mono
inferValueField env e =
  let et = infer env e
  let inner = freshVar ()
  let _ = unify et (TApp (tconBuiltin "Ref") inner)
  inner

-- the field's type from a resolved record `rname`, given the (already-inferred)
-- receiver type `te` to unify against the record's instantiated result type.  A
-- field absent from a KNOWN record names it (mirrors the oracle's `resolve_in`,
-- which raises UnknownField with the resolved record name).
inferFieldOfRecord : Mono -> String -> RecordInfo -> String -> Mono
inferFieldOfRecord te rname ri fname =
  let sr = instantiateRecordShared ri
  let _ = unify te (snd sr)
  match omLookup fname (recordFieldMap ri)
    Some fm => substMono (fst sr) [] fm
    None => unknownFieldFresh fname rname (recordFieldNames ri)

-- field_owners (Phase 72): every registry KEY whose RecordInfo declares `fname`,
-- sorted + deduped (mirrors lib/typecheck.ml's `field_candidates` +
-- `List.sort_uniq compare`).  For a plain record the key is its type name; for a
-- named-field variant it's the constructor name — matching the oracle, whose
-- field_owners maps to the record's type name and the variant's con_name.
-- The field→owners multimap (fieldOwnersRef) already holds exactly this set of
-- keys, maintained at registration; `sortUniqS` canonicalizes it so the rendered
-- owner-list order (ambiguousFieldMsg / headL) is byte-identical to the old walk.
fieldOwnerNames : String -> List String
fieldOwnerNames fname =
  sortUniqS (fromOption [] (omLookup fname perRun.value.fieldOwnersRef.value))

-- Resolve the record (name + info) that owns `fname` for a receiver of type `te`
-- (normalized).
-- (a) receiver head tycon is a known record → that record;
-- (b) receiver is an undetermined var → 0 owners = unknown field, 1 = that one,
--     >1 = ambiguous (push AmbiguousField, return None);
-- (c) receiver is a concrete non-record → first owner (so the later unify raises
--     the usual mismatch), or unknown field if none.
-- On error it pushes the matching type error and returns None.
--
-- ⚠️ ARM (a) DOES NOT ASK A SPELLING QUESTION, AND THAT IS WHY IT ALONE CALLS
-- `lookupRecordForReceiver` INSTEAD OF `lookupRecordByName` — see that function.
resolveFieldRecord : Mono -> String -> Option (String, RecordInfo)
resolveFieldRecord te fname = match headTyconNameMono te
  Some r => match lookupRecordForReceiver te r
    Some ri => Some (r, ri)
    None => match lookupRecordByMangledHead te r fname
      Some pair => Some pair
      None => if contains r driverState.value.abstractRecordTypesRef.value then
        let _ = pushTypeError "T-ABSTRACT-FIELD" (abstractFieldMsg r fname)
        None
      else resolveFieldByOwners te fname
  None => resolveFieldByOwners te fname

-- ── #1111 Stage A-2 unit A-2.13 (#1319 unit 3): ONE ENTRY, TWO QUESTIONS ────
--
-- `recordByNameRef` is asked two questions that a single bare-`String` key
-- cannot answer separately, and #1376 / #1377 are the two halves of that:
--
--   (1) a SPELLING question — "which declaration does the `Cfg` written in THIS
--       module's source denote?"  Asked by `inferPatRec`, `inferRecordCreate`
--       and `inferVariantUpdate`, each of which starts from a name the module
--       wrote.  The bare key plus unit 2's per-module scope overlay
--       (`applyRecordScopeOverrides`) is the RIGHT instrument for it: the answer
--       is a property of what this module imported and declared.
--   (2) an IDENTITY question — "given a receiver whose type is already inferred
--       and already carries its origin, which `RecordInfo` describes it?"  Asked
--       by `resolveFieldRecord`'s arm (a) ONLY.  Nothing the module spelled is
--       an input: `mkZ.beta` is decided entirely by `mkZ`'s type.
--
-- Before this unit both questions read `lookupRecordByName`, so whatever decided
-- the single entry answered both the same way — and a module that NAMES one
-- declaration while HOLDING a value of the other cannot get both right.
--
-- ⚠️ THE SPLIT IS NOT MINE — IT IS THE SPEC'S, AND THE IMPLEMENTATION WAS NOT
-- FOLLOWING IT.  `docs/spec/DICT-SEMANTICS.md` §8 I4 qualification 2 draws exactly
-- this line, in one sentence, and names both sides:
--
--     "It applies only to occurrences resolved BY NAME.  A record-field selection
--      `r.f` is resolved by the *type* of `r`, not by the spelling `f` … Record
--      *construction* and record *patterns* name the record, and are ambiguous
--      exactly when that name is."
--
-- So arm (a) is spec'd to resolve by the receiver's TYPE and was resolving by a
-- per-module decision over a bare spelling; the other three readers are spec'd to
-- resolve by name and do.  The diagnostic the collision produced was itself the
-- evidence the information was in hand at the point of failure — it could name
-- BOTH modules ("one comes from module 'zrmod', the other from 'armod'") while
-- selecting by neither.
--
-- 🚨 THIS IS A SPLIT, NOT A GUARD AT A READ SITE, and the distinction is the one
-- `.claude/workstreams/TYPECHECK.md`'s standing gate asks about (its
-- "does the fix change the KEY, or add a guard at ONE READ SITE?"
-- discriminator).  Question (2) now has its OWN key — the receiver's `Ident`,
-- selected out of the identity-keyed companion `universeRecordIdentsRef` — and
-- question (1) keeps the spelling key it always had.  One read site moves
-- because exactly one read site asks question (2); a second site asking it would
-- call this same function.  What is NOT claimed: `recordByNameRef` is still
-- bare-keyed, and it is still the floor whenever the receiver carries no
-- identity.  This unit does not retire the overlay (that is #1319 unit 4) nor
-- the duplication (#1288 is the deleter, as for units 1 and 2).
--
-- ⚠️ THE FLOOR IS REACHED BY MISS, NEVER BY FALLBACK-ON-AMBIGUITY.  Three
-- honest-absence cases fall through to `lookupRecordByName`, all of them
-- "no identity was available", none of them "two candidates matched":
--   * the receiver head carries no identity (`headKeyIdent` = `None`) — the
--     flat/loader-less driver path, where NO declaration is stamped (#1115 /
--     E-1), and the `HkRigid` §8 I6.1 residual;
--   * the key has no companion row — the module's OWN records (the companion is
--     grown from `pubDecls` at the END of a module's arm, so a module never sees
--     itself in it) and every non-`ConNamed` declaration;
--   * no candidate's type identity equals the receiver's — e.g. a receiver whose
--     head is the TYPE of a named-field variant (`data T = | Cfg { … }`, key
--     `Cfg`, type `T`), which arm (a) misses today too and which the
--     field→owners path answers.
-- Two candidates can never BOTH match: a match requires equal
-- `(module, type name)`, and one module declaring two types of one name is a
-- duplicate-definition error.  So this cannot invent an ambiguity resolution.
lookupRecordForReceiver : Mono -> String -> Option RecordInfo
lookupRecordForReceiver te r = match recordForReceiverIdent te r
  Some ri => Some ri
  None => lookupRecordByName r

-- The identity half.  `universeRecordIdentsRef`'s outer key is the bare registry
-- key — an INDEX into a candidate list, not the selector; the selector is the
-- identity comparison below, which is why a collided key keeps both rows here
-- where `recordByNameRef` keeps one.
--
-- ⚠️ THE CHEAP LOOKUP RUNS FIRST, DELIBERATELY.  This is on the path of EVERY
-- `.field` access whose receiver head is a known record — not only the colliding
-- ones — so the ordering is a cost decision, not a style one: `omLookup`
-- allocates nothing, while `receiverTypeIdent` mints a `HeadKey` (and, inside it,
-- an `Ident`).  A key with no companion row therefore pays one map lookup and
-- allocates nothing at all.  Do not "simplify" by projecting the head first.
recordForReceiverIdent : Mono -> String -> Option RecordInfo
recordForReceiverIdent te r = match omLookup r crossRun.value.universeRecordIdentsRef.value
  None => None
  Some cs => match receiverTypeIdent te
    None => None
    Some ident => recordCandForType ident cs

-- ⚠️ ROUTED THROUGH `headTyconMono`, NOT A FRESH `Mono.TCon` PATTERN.  Reading
-- the origin field directly here would add a second site to the `Mono.TCon`
-- origin-read ratchet in `test/typecheck_compiler_source.sh` and duplicate the
-- head-node classification `headTyconMono`/`headTyconNameMono` owe each other.
-- `headKeyIdent` (`types/registry.mdk`) is the accessor; its `None` collapses
-- "rigid" and "no module id yet" because at a ROW lookup both mean the same
-- thing — the derivation is written at that function.
receiverTypeIdent : Mono -> Option Ident
receiverTypeIdent te = match headTyconMono te
  Some hk => headKeyIdent hk
  None => None

recordCandForType : Ident -> List (Ident, String, RecordInfo) -> Option RecordInfo
recordCandForType _ [] = None
recordCandForType want ((ci, tyName, ri)::rest)
  | recordCandIsType want ci tyName = Some ri
  | otherwise = recordCandForType want rest

-- Is candidate `ci` (stored under its CONSTRUCTOR identity, beside the name of
-- the TYPE it builds) the declaration the receiver identity `want` names?
--
-- A candidate carries `Ident NsCtor o cn` plus `tyName`, because that is what
-- `insertRecordIdents` has in hand; the receiver's head names the TYPE, so the
-- comparison is `(owning type name, declaring module)`.  `o` is the same
-- `dataOrigin` `registerRecordInfoKeyed` put in the record's result type, which
-- is what `headTyconMono` projects back out of a value of that record — so this
-- compares the two ends of one declaration.
--
-- 🚨 RETRACTION (#1381 round-2 review, finding 1).  THE TWO CONJUNCTS ARE NOT
-- SEPARATELY MEASURED, AND THE TYPE-NAME ONE CANNOT BE — by any fixture that
-- asserts a VALUE or an ACCEPTANCE.  An earlier version of this comment claimed
-- "each conjunct is measured, by a different fixture, and neither is measured by
-- the other's"; the counterfactual that would have shown it false is the one
-- that was never run.  What IS measured, by a separate cold rebuild each:
--   * drop `cio == wio` (type name only) → `record_receiver_ident_named_vs_held/`
--     goes RED; `…_value_only/` and `…_bystander/` stay GREEN.  So the
--     DECLARING-MODULE conjunct is load-bearing and is measured.
--   * drop BOTH (first candidate wins) → `…_bystander/` goes RED at `mkP.px`.
--   * drop `tyName == wname` (module only) → NOTHING IN THE TREE GOES RED.  All
--     52 `diff_compiler_llvm_modules` cells pass, `make check-self` is clean, and
--     five purpose-built probes with ≥2 differently-ordered fields (so a wrong
--     pick is observable rather than index-0-invisible) print the hand-derived
--     value on the EXECUTED native binary.
--   * stub the whole selection to `None` → both drain fixtures RED, bystander
--     GREEN (which is what makes it a bystander and not a second drain).
--
-- WHY NO FIXTURE CAN DISCRIMINATE IT — the derivation, so the next reader does
-- not re-run the rebuild.  The caller looks the candidate list up under
-- `r = headTyconNameMono te`, while `wname` comes from `headTyconMono te` →
-- `headKeyOfCon o n` → `Ident NsType o n`: the SAME `n`.  So `wname == r == the
-- outer key`, always, and `tyName == wname` reduces to "this candidate's owning
-- type name equals the registry key it is filed under" — i.e. "this candidate is
-- a plain record, not a named-field variant of a differently-named type".  When
-- the two conjuncts disagree the candidate is `(M, tyName = Y)` under key `r`
-- with `Y /= r` while the receiver's head is `(M, r)`; that candidate's result
-- head is `(M, Y)`, which can never unify with `(M, r)`.  And the floor
-- `lookupRecordByName r` can only return a record whose CONSTRUCTOR is `r`,
-- which is likewise never the receiver's own record.  BOTH ARMS REJECT.  So the
-- conjunct can change neither an accepted program's value nor accept vs reject.
--
-- IT IS OBSERVABLE IN DIAGNOSTIC TEXT, IN EXACTLY ONE SHAPE, AND THERE IT MAKES
-- THE MESSAGE WORSE.  Measured: `amod` declaring BOTH `data Tag = TA | TB` and
-- `data Box = | Tag { bx : Int }`, `zmod` declaring `data Tag = { tx : Int }`,
-- receiver `aTag : amod.Tag`, access `aTag.bx`.  Exit 1 either way.  With both
-- conjuncts: `Type mismatch: Tag vs Tag — … 'amod' … 'zmod'` plus a spurious
-- `Field 'bx' does not belong to record 'Tag'`.  With the module conjunct alone:
-- one `Type mismatch: Tag vs Box`, naming the record actually selected.  No
-- fixture pins this, deliberately — a golden here would enshrine the worse
-- message as the expected one.
--
-- SO WHY KEEP IT.  Deleting it moves the whole correctness of the selector onto
-- "a module contributes at most one candidate per registry key", which is true
-- only because two constructors of one name in one module is a `Duplicate
-- constructor` error — a property enforced by a DIFFERENT subsystem and asserted
-- nowhere near here.  Keeping the conjunct costs one monomorphic string compare
-- and keeps the comparison a direct expression of the question being asked.  It
-- is belt-and-braces, and this comment says so instead of claiming a measurement.
--
-- ⚠️ NAME FIRST, AND MONOMORPHIC — the discipline `tabKeyEq` states at its own
-- definition and `compiler/AGENTS.md` states for hot helpers.  It also allocates
-- nothing, which is why the candidate identity is compared component-wise rather
-- than rebuilt as an `Ident NsType …` and `==`-ed: this runs per candidate, per
-- field access.
--
-- ⚠️ THIS IS STRICTER THAN `unify`'s HEAD TEST, AND THE DIRECTION IS THE POINT.
-- `sameTyConHead` (`frontend/ast.mdk`) lets an ABSENT origin match anything,
-- because it answers an ACCEPTANCE question where a false reject refuses a valid
-- program.  This answers a LOOKUP, where a false hit is silent wrongness — so
-- absence must never match, and it cannot: `headKeyIdent` yields no `Ident` for
-- an unstamped head, and this function is not reached.  That inversion is the
-- same one `ifaceIdMatches` and `sameTyConHead` document at each other.
recordCandIsType : Ident -> Ident -> String -> Bool
recordCandIsType (Ident _ wio wname) (Ident _ cio _) tyName = tyName == wname
  && cio == wio

-- Mangle-aware record lookup for the emit path.  `backend/private_mangle.mdk`
-- renames a record's DECL name (a record's name IS its constructor) to
-- `<mid>__<name>`, so `recordByNameRef` is keyed by the mangled name — but a TYPE
-- reference like `r : Rule` is NOT mangled, so the receiver's head tycon stays
-- `Rule` and the exact `lookupRecordByName` above misses.  Recover by finding the
-- registry entry whose key suffix-matches `__<head>` AND owns `fname`; only when
-- it is UNIQUE (else ambiguous → None, so the caller's owners path keeps today's
-- behavior).  No-op off the emit path (unmangled key hits the exact lookup).
--
-- 🚨 #1319 UNIT 2 WAS SCOPED TO RETIRE THIS AND DELIBERATELY DID NOT.  The scoping
-- pass's premise was *"a real identity key subsumes that hack"* — true, and the
-- adjudication then chose **B1**, which does NOT make `recordByNameRef` identity-keyed:
-- it keeps the bare key as a floor and decides collisions with a per-module scope
-- overlay, exactly as unit 1 kept `universeDataEnv` bare.  So the premise the retirement
-- rests on is not in the tree, and retiring the hack under B1 would need one of:
--
--   * the MANGLER fixed so a record's TYPE name is renamed in lockstep with its
--     constructor name.  `renameDecl` (`backend/private_mangle.mdk`) rewrites
--     `dataCtors` and leaves `dataName` alone — its own comment says so — while
--     `registerRecordInfoKeyed` is called with key = the (mangled) ctor name and
--     typeName = the (unmangled) `dataName`.  That mismatch IS the hack's whole reason,
--     and it is `ws:emitter`'s (#1300 / #1305 family), not this unit's.
--     ⚠️ #1300 IS NOW CLOSED (PR #1393) AND DID NOT DO THIS — re-derived 2026-08-07
--     against the merged tree, not inferred from the issue state: `renameDecl` still
--     rewrites `dataCtors` and still leaves `dataName` alone.  So the route stays
--     open and #1305 is the live half; do not read the closed issue as the mangler
--     having been fixed;
--   * or a SECOND record index keyed by the declaration's TYPE identity.  Rejected:
--     it is unsound for a multi-`ConNamed`-variant type — `data T = | A { x } | B { y }`
--     would map `(o, T)` to one of the two, and `r.y` at `r : T` would resolve to `A`,
--     where today the exact lookup misses and the field→owners path answers correctly.
--     Restricting it to single-variant types makes it serve ONLY the emit path, i.e. a
--     THIRD keying scheme in a table that already has two — the opposite of reconciling.
--
-- 🚨 IT IS LOAD-BEARING, AND THAT IS MEASURED, NOT INFERRED.  The paragraph above was
-- written as a derivation from `renameDecl`'s source; the adversarial review of PR #1372
-- then ran the counterfactual, and this sentence exists so the next reader does not have to
-- repeat it: **stubbed to `None`** — body replaced by a constant, nothing else changed —
-- **the compiler TYPECHECKS CLEAN and then MISCOMPILES ITSELF INTO A SEGFAULT.**  So the
-- suffix match is not dead code kept for safety; the self-compile depends on it, and it
-- fails in the worst available way: no diagnostic, no type error, a crash in the produced
-- binary.  Anyone retiring it must land the mangler fix in the SAME change.
--
-- ⚠️ THE MEASUREMENT IS THE REVIEWER'S, NOT MINE.  Recorded here rather than only in a PR
-- body, because a PR body is not where someone standing at this function will be looking —
-- which is the exact report-versus-artifact split that produced this note.
--
-- Left in place, with the reason written down, rather than half-migrated.
--
-- ── #1382: WHAT THE NON-SINGLETON ARM DOES NOW, AND WHY IT IS NOT A RETIREMENT ──
-- The two routes above are about RETIRING this function.  This is not one of them:
-- the function stays, the singleton gate is untouched, and the only thing that
-- changed is what happens when the gate ALREADY gave up.
--
-- Before, `_ => None` handed the question to `resolveFieldByOwners`, whose
-- concrete-receiver arm answers `pairRecordByName (headL owners)` — the FIRST key
-- in `sortUniqS` order.  On the emit path every key is `<mid>__<ctor>`, so that
-- ladder decides which record a projection means BY MODULE-NAME SORT ORDER.  That
-- is #1382, and it is memory-unsafe rather than merely wrong: two modules each
-- declaring `Cfg` with their fields in the opposite order make one module's
-- projections read the OTHER module's slots, so `medaka check` exits 0, `medaka
-- run` is correct (the interpreter resolves fields by name at run time), and the
-- BUILT BINARY prints a wrong value — or, when the swapped slots hold an `Int` and
-- a `String`, segfaults.  Measured on a cold build of `c5fda728`: the typed Core IR
-- carried `CFieldAccess (CVar "zrmod__mkZ" AGlobal) "a" "armod__Cfg"` — zrmod's
-- value, armod's record — and the emitter faithfully applied armod's layout to it.
--
-- The narrowing below asks the ONE question the bare spelling cannot: which
-- DECLARATION does the receiver's own head name?  Both sides go through
-- `headTyconMono`, so the comparison is on the `HeadKey` (§8 I4's `(originModule,
-- name)`) rather than on the string — which is the whole point, since every
-- candidate here spells the same bare `head` by construction.  The receiver's
-- identity comes from `stampGraphTyOrigins`, which `elaborateModules` calls
-- precisely so the separate `medaka_emitter` process has it (see its note there);
-- the candidate's comes from `registerRecordInfoKeyed`'s `tconFrom o typeName`.
--
-- 🚨 IT CANNOT MOVE AN ANSWER THAT WAS ALREADY DECIDED.  It runs only in the arm
-- that returned `None`, so every reachable change is `None` → `Some pair`, i.e. a
-- coin flip in `resolveFieldByOwners` replaced by the receiver's own declaration.
-- A one-candidate lookup still short-circuits on the untouched first arm, and a
-- narrowing that does not land on exactly one candidate still returns `None` and
-- still falls through to today's ladder.  So this is deliberately NOT the target
-- rule quoted at `applyRecordScopeOverrides` (*"the receiver's own identity selects
-- its record"*): that rule wants `lookupRecordByName` itself to take an identity,
-- which moves the EXACT-hit arm above and is a change to the check path too.  This
-- unit only makes the give-up arm stop guessing.
--
-- ⚠️ ON THE CHECK PATH THIS IS REACHED BUT INERT — it is NOT unreachable there, and
-- an earlier draft of this note said it was.  A named-field variant's HEAD is not its
-- registry KEY: `registerNamedFieldVariants` passes key = the CONSTRUCTOR and
-- typeName = the TYPE (`registerRecordInfoKeyed o cname tyName params fields`), so
-- `data WA = | CA { … }` registers key `CA` while the receiver's head is `WA`, the
-- exact `lookupRecordByName "WA"` misses, and this function IS called with no
-- mangling anywhere.  What makes it harmless is the candidate filter, not
-- unreachability: no UNMANGLED key suffix-matches `__<head>`, so the list is empty,
-- the narrowing runs over nothing, and the answer is the `None` it always was.
-- That weaker claim is the one the safety argument actually needs — reachability was
-- never the property doing the work — so stating it correctly strengthens the case
-- rather than weakening it.  `test/llvm_fixtures_modules/field_owner_no_narrowing/`
-- is a live cell of exactly this shape (head `RA`, key `Dup`).
lookupRecordByMangledHead : Mono -> String -> String -> Option (String, RecordInfo)
lookupRecordByMangledHead te head fname = match mangledHeadCandidates head fname
  [pair] => Some pair
  -- One mint of the receiver's key for the whole filter, not one per candidate:
  -- `types/registry.mdk` names re-minting a `TabKey` per lookup as the thing the
  -- #1111 A-2.3 follow-up hoisted, because `tabKeyOf` → `mkIdent` → `identOriginOf`
  -- allocates on the way (an `Option`, the `map` closure, the `Ident`, the
  -- `Some`/`None`, then the `TkIdent`/`TkBare` wrapper).  The cost here is small —
  -- this arm only runs when the candidate list length ≠ 1, and at length 0 the
  -- filter calls nothing — so this is about not borrowing an idiom from the file
  -- that warns about it by name, not about a measured regression.
  cands =>
    let rk = headTyconMono te
    match filterList (recordCandIsReceiverDecl rk) cands
      [pair] => Some pair
      _ => None

-- Does this candidate's `RecordInfo` describe the declaration the RECEIVER's head
-- names?  `rk` is the receiver's key, already projected by the caller (see the mint
-- note there); `headTyconMono` produces both sides rather than a bespoke match, so
-- no new origin-binding `Mono.TCon` pattern enters the set
-- `test/typecheck_compiler_source.sh` pins.
--
-- The equality is `HeadKey`'s DERIVED one, and that is the fail-safe: `HeadKey`
-- embeds `TabKey`, whose `TkIdent`/`TkBare` split `types/registry.mdk` defines so a
-- key with identity can never equal one without.  So a receiver whose head was never
-- stamped matches ZERO candidates — not "the first one" — and the caller falls back
-- to today's ladder unchanged.  An absent identity therefore decides nothing, which
-- is the same absence-makes-no-claim rule `sameTyConHead` owns one layer down.
recordCandIsReceiverDecl : Option HeadKey -> (String, RecordInfo) -> Bool
recordCandIsReceiverDecl rk (_, ri) = rk == headTyconMono (recordResultMono ri)

-- The record's RESULT type — the head `registerRecordInfoKeyed` minted from the
-- DECLARATION's origin (`applyParams (tconFrom o typeName) paramVars`), which is why
-- it is the identity to compare against.  Peer of `recordFieldMap` /
-- `recordFieldNames`; deliberately the RAW result, since instantiating fresh param
-- vars cannot change the head `headTyconMono` reads.
recordResultMono : RecordInfo -> Mono
recordResultMono (RecordInfo _ result _ _) = result

-- Candidates are the keys that already OWN `fname` (from the field→owners
-- multimap, which is the "declares this field" filter precomputed) whose key
-- suffix matches `__<head>`; each paired with its RecordInfo from
-- recordByNameRef.  The singleton gate in the caller is unchanged, so the order
-- here is irrelevant.
mangledHeadCandidates : String -> String -> List (String, RecordInfo)
mangledHeadCandidates head fname =
  mangledHeadCandidatesGo
    head
    (fromOption [] (omLookup fname perRun.value.fieldOwnersRef.value))

mangledHeadCandidatesGo : String -> List String -> List (String, RecordInfo)
mangledHeadCandidatesGo _ [] = []
mangledHeadCandidatesGo head (key::rest)
  | endsWith ("__" ++ head) key = match lookupRecordByName key
    Some ri => (key, ri) :: mangledHeadCandidatesGo head rest
    None => mangledHeadCandidatesGo head rest
  | otherwise = mangledHeadCandidatesGo head rest

resolveFieldByOwners : Mono -> String -> Option (String, RecordInfo)
resolveFieldByOwners te fname = match fieldOwnerNames fname
  [] =>
    let _ = pushUnknownField fname "<unknown>"
    None
  [r] => pairRecordByName r
  r::rest => resolveFieldAmbiguous te fname (r::rest)

-- multiple owners: receiver still an unbound var ⇒ genuinely ambiguous; a
-- concrete (non-record) receiver ⇒ narrow by the receiver's own declaration
-- identity, and only if that does not land on exactly one owner fall back to
-- picking the first owner so the later unify surfaces the type mismatch
-- (mirrors the oracle's two `_` sub-branches).
resolveFieldAmbiguous : Mono -> String -> List String -> Option (String, RecordInfo)
resolveFieldAmbiguous te fname owners = match normalize te
  TVar _ =>
    let _ = pushTypeError "T-AMBIGUOUS-FIELD" (ambiguousFieldMsg fname owners)
    None
  _ => resolveFieldOwnersNarrowed te fname owners

-- ── #1216 / #1382: the multi-owner arm stops answering by sort order ──────────
-- `sortUniqS` makes `headL owners` a MODULE-NAME SORT, so before this the concrete
-- arm decided which record a `.field` access means by the alphabetical order of the
-- declaring modules — measured on the emit path as `CFieldAccess (CVar
-- "zwrap__mkZ") "a" "awrap__Cfg"`: zwrap's value, awrap's record, applied
-- faithfully by the backend.
--
-- The narrowing asks the one question the bare key cannot: which DECLARATION does
-- the receiver's own head name?  It ADOPTS `recordCandIsReceiverDecl` — the same
-- landed comparator `lookupRecordByMangledHead` filters with — so both sides go
-- through `headTyconMono` and the comparison is on `HeadKey`, not on the string
-- every candidate here spells identically by construction.
--
-- WHAT THIS HAS, AND WHAT IT MEASURABLY DOES NOT — the second and third bullets
-- below replace three claims that shipped with the original narrowing and were
-- **measured false** by the adversarial review of `S-record-pairing-identity`.
-- Keep them stated as measurements; the false versions cost a reviewer a round and
-- were the stated reason the flat path carried no test cell.
--   * ABSENCE DECIDES NOTHING.  `HeadKey` embeds `TabKey`, whose `TkIdent`/`TkBare`
--     split means a key carrying identity can never equal one that does not.  A
--     receiver whose head was never stamped at all matches ZERO candidates and
--     falls through to exactly today's answer — never "the first one".
--   * ⚠️ IT IS LIVE ON THE FLAT/SINGLE-FILE DRIVER.  The retracted claim was that
--     the flat driver, where every decl is `TkBare`, "matches ZERO candidates".
--     FALSE: `TkBare Ns String` CARRIES the type name, so two bare keys naming the
--     same type ARE equal, and the narrowing selects there.  Measured: `flat/p.mdk`
--     (two single-ctor records sharing field `tag`, concrete receiver) goes from a
--     base-arm `Type mismatch: Beta vs Alpha` to the hand-derived correct `42`.
--     That direction is CORRECT and is kept; `test/llvm_fixtures_modules/
--     record_owner_ctor_ambiguity/` carries the flat cell so it stays graded.
--   * ⚠️ IT CAN WIDEN AN ACCEPT, WHICH IS WHY THE SIBLING GUARD EXISTS.  The
--     retracted claim was that "anything other than exactly one surviving candidate
--     returns today's answer, so it can never widen an accept" — the premise is
--     true and the conclusion does not follow: a singleton survivor is itself a new
--     accept where the old ladder's `headL` pick reached a unify mismatch.  For
--     SINGLE-constructor records that widening is the fix (`flat`, `#1216`).  For a
--     MULTI-`ConNamed`-variant type it was unsound, exactly as the `#1319 UNIT 2`
--     note above predicted for a type-keyed record index: `recordCandIsReceiverDecl`
--     compares RESULT-TYPE heads while `registerRecordInfoKeyed` registers one
--     `RecordInfo` per named-field CONSTRUCTOR, so for
--     `data T = Zed { x } | Oth { y }` every candidate of type `T` compares equal to
--     an `Oth` receiver and the filter lands on `Zed` with full confidence.
--     Measured on `ada2bd57`: `(Oth …).x` went from a base-arm `exit 1` on
--     check/run/build to `check` exit 0 and a BUILT BINARY printing `99` — a
--     loud→silent transition.  `narrowingBlockedByCtorSibling` below is the repair.
--   * IT CANNOT TURN NOTHING INTO SOMETHING.  Every candidate is built by a
--     SUCCESSFUL `lookupRecordByName`, and the fall-through is byte-for-byte the
--     old expression, so no program that resolved to `None` here can now resolve to
--     `Some`.
--
-- One mint of the receiver's key for the whole filter, not one per candidate — the
-- same hoist `lookupRecordByMangledHead` documents, for the same reason
-- (`tabKeyOf` → `mkIdent` → `identOriginOf` allocates on the way).
resolveFieldOwnersNarrowed : Mono -> String -> List String -> Option (String, RecordInfo)
resolveFieldOwnersNarrowed te fname owners =
  let rk = headTyconMono te
  narrowedPick
    rk
    fname
    owners
    (filterList (recordCandIsReceiverDecl rk) (ownerCandidates owners))

-- The singleton gate, plus the guard the comparator's granularity requires.  A
-- lone survivor is trusted ONLY when the receiver's type does not also have a
-- named-field constructor that withholds this field: a value of type `T` carries no
-- static constructor tag, so where two constructors of `T` disagree about `fname`
-- the receiver's TYPE cannot say which layout applies, and selecting is guessing.
-- Anything else — zero survivors, several survivors, or a blocked singleton —
-- returns the pre-narrowing answer byte-for-byte, the same `_ =>` fall-through the
-- original arm had.
narrowedPick : Option HeadKey -> String -> List String -> List (String, RecordInfo) -> Option (String, RecordInfo)
narrowedPick rk fname _ [(k, ri)]
  | not (narrowingBlockedByCtorSibling rk fname k) = Some (k, ri)
narrowedPick _ _ owners _ = pairRecordByName (headL owners)

-- Is there ANOTHER registered named-field constructor sharing the survivor's
-- RESULT head that does NOT declare `fname`?  That is precisely the
-- multi-`ConNamed`-variant shape whose layout the receiver's type underdetermines.
-- A record re-registered under a second key is excluded by construction: it
-- declares `fname` too, so it fails the withholds test (and it would already be a
-- second survivor, since `fieldOwnersRef` is written in lockstep with
-- `recordByNameRef` by `registerRecordInfoKeyed`).
-- Cost: one pass over the record registry, taken ONLY when the filter produced a
-- singleton — i.e. in the give-up arm of a multi-owner field access, never on the
-- exact-hit path.
narrowingBlockedByCtorSibling : Option HeadKey -> String -> String -> Bool
narrowingBlockedByCtorSibling rk fname survivorKey =
  anyCtorSiblingWithholds
    rk
    fname
    survivorKey
    (omKeys perRun.value.recordByNameRef.value)

anyCtorSiblingWithholds : Option HeadKey -> String -> String -> List String -> Bool
anyCtorSiblingWithholds _ _ _ [] = False
anyCtorSiblingWithholds rk fname skey (k::rest)
  | k == skey = anyCtorSiblingWithholds rk fname skey rest
  | ctorSiblingWithholds rk fname k = True
  | otherwise = anyCtorSiblingWithholds rk fname skey rest

ctorSiblingWithholds : Option HeadKey -> String -> String -> Bool
ctorSiblingWithholds rk fname k = match lookupRecordByName k
  Some ri => rk == headTyconMono (recordResultMono ri)
    && isNone (omLookup fname (recordFieldMap ri))
  None => False

-- Each owner key paired with its `RecordInfo`; a key with no entry is dropped
-- rather than defaulted, so the filter above only ever sees real declarations.
ownerCandidates : List String -> List (String, RecordInfo)
ownerCandidates [] = []
ownerCandidates (key::rest) = match lookupRecordByName key
  Some ri => (key, ri) :: ownerCandidates rest
  None => ownerCandidates rest

pairRecordByName : String -> Option (String, RecordInfo)
pairRecordByName r = map (ri => (r, ri)) (lookupRecordByName r)

headL : List String -> String
headL [] = ""
headL (x::_) = x

pushUnknownField : String -> String -> Unit
pushUnknownField fname rname =
  pushTypeError "T-UNKNOWN-FIELD" (unknownFieldMsg fname rname)

-- `declared`: the record's own field names, so a genuine typo (`aeg` for
-- `age`) can be suggested (ERROR-QUALITY dim F).  When a close-enough
-- candidate exists the error gets a structured `help` + a machine `fix` that
-- replaces the bad field name's span with the suggestion; otherwise unchanged.
unknownFieldFresh : String -> String -> List String -> Mono
unknownFieldFresh fname rname declared =
  let _ = pushUnknownFieldMaybeSuggest fname rname declared
  let v = freshVar ()
  -- Chunk A: the field error already explained this access; poison its result
  -- var so a downstream `debug`/method use doesn't pile on a secondary
  -- `ambiguous instance` cascade (record_wrong_field).
  let _ = poisonMismatchVars v v
  v

pushUnknownFieldMaybeSuggest : String -> String -> List String -> Unit
pushUnknownFieldMaybeSuggest fname rname declared = match suggestField fname declared
  None => pushTypeError "T-UNKNOWN-FIELD" (unknownFieldMsg fname rname)
  Some sug => pushTypeErrorHelpFixAt "T-UNKNOWN-FIELD" !currentLoc (unknownFieldMsg fname rname ++ ". Did you mean '\{sug}'?") "did you mean '\{sug}'?" (fieldFixFrom !currentLoc sug)

-- "did you mean" for a record field: nearest declared field name by
-- Levenshtein distance, within a fixed distance of 2.  Skip names < 3 chars
-- (too noisy at that length, same floor as resolve.mdk's `suggestName`).
-- Unlike `suggestName` — which searches EVERY in-scope name and so scales its
-- threshold down with length to avoid noise in a large candidate pool — the
-- candidate pool here is one record's OWN declared fields (typically a
-- handful), so a flat distance-2 budget is safe: it's what's needed to catch
-- a two-letter transposition (`aeg` vs `age`, distance 2) without the
-- length-scaled cap resolve.mdk uses (which would reject that exact case:
-- min(2, max(1, 3/3)) = 1).  Ties favor the lexicographically-first candidate.
-- A small local copy rather than importing resolve.mdk's `suggestName`, which
-- would cycle (nothing here imports resolve.mdk today, and this file is a
-- dependency of the pipeline stage that runs after it).
suggestField : String -> List String -> Option String
suggestField fname declared
  | stringLength fname < 3 = None
  | otherwise = map fst (bestFieldCandidate fname 2 declared None)

bestFieldCandidate : String -> Int -> List String -> Option (String, Int) -> Option (String, Int)
bestFieldCandidate _ _ [] acc = acc
bestFieldCandidate fname lim (c::cs) acc
  | c == fname = bestFieldCandidate fname lim cs acc
  | editDistance fname c > lim = bestFieldCandidate fname lim cs acc
  | otherwise = bestFieldCandidate fname lim cs (keepBetterField c (editDistance fname c) acc)

keepBetterField : String -> Int -> Option (String, Int) -> Option (String, Int)
keepBetterField c d None = Some (c, d)
keepBetterField c d (Some (bc, bd)) =
  if d < bd || d == bd && c < bc then
    Some (c, d)
  else
    Some (bc, bd)

-- The field name itself carries no Loc in the AST (`EFieldAccess Expr String
-- (Ref String)` — no per-field span).  `currentLoc` at the unknown-field site
-- is instead the RECEIVER's own span (infer walks into the receiver first,
-- and nothing re-enters an ELoc between there and here) — verified empirically:
-- `p.aeg` reports receiver span (sc, sc+1) for `p`, `somebody.aeg` reports
-- (sc, sc+8) for `somebody`.  The field name immediately follows the
-- receiver's end column + the `.`, so its span is computable from the
-- receiver's end column.  Valid for the common single-level `recv.field`
-- access; a chained `a.b.cty` receiver is itself a field access with no own
-- ELoc, so this would misplace the fix there — accepted for now (the
-- common-case gain is worth the narrow miss).
fieldFixFrom : Option Loc -> String -> Option (Loc, String)
fieldFixFrom (Some (Loc f _ _ el ec)) sug =
  Some (Loc f el (ec + 1) el (ec + 1 + stringLength sug), sug)
fieldFixFrom None _ = None

-- byte-for-byte with lib/typecheck.ml UnknownField / AmbiguousField / MissingField messages.
unknownFieldMsg : String -> String -> String
unknownFieldMsg fname rname =
  "Field '\{fname}' does not belong to record '\{rname}'"

-- Dot-access on a type exported abstractly: byte-identical to resolve.mdk's
-- AbstractFieldAccess ppResError, so a destructure (`Point { x }`, caught in
-- resolve) and a dot-access (`p.x`, caught here in typecheck) read the same.
abstractFieldMsg : String -> String -> String
abstractFieldMsg tname fname = "'\{tname}' is exported abstractly. Field '\{fname}' is not accessible; declare it `public export` to expose its fields"

-- TYPECHECK-AUDIT OBS4: mirrors lib/typecheck.ml MissingField message byte-for-byte.
missingFieldMsg : String -> String -> String
missingFieldMsg fname rname =
  "Missing field '\{fname}' in construction of record '\{rname}'"

ambiguousFieldMsg : String -> List String -> String
ambiguousFieldMsg fname owners = "Ambiguous field access: '.\{fname}' is declared by \{joinWith ", " owners}; the record type is undetermined. Add a type annotation (e.g. '(r : \{headL owners}).\{fname}')"

-- TYPECHECK-AUDIT D1: convert resolve-not-pre-screened error shapes (unknown
-- record / constructor, unbound variable) from uncatchable interpreter panics
-- into accumulated typeErrors + a fresh-var placeholder, so inference continues
-- (mirrors lib/typecheck.ml, which `fail`s with these byte-identical messages).
unknownRecordMsg : String -> String
unknownRecordMsg name = "Unknown record type: " ++ name

unknownCtorMsg : String -> String
unknownCtorMsg name = "Unknown constructor: " ++ name

unboundVarMsg : String -> String
unboundVarMsg name = "Unbound variable: " ++ name

-- push the message + return a fresh placeholder type so the continued path stays
-- in a valid state (the oracle accumulate-and-continue analog for these shapes).
unknownRecordFresh : String -> Mono
unknownRecordFresh name =
  let _ = pushTypeError "T-UNKNOWN-RECORD" (unknownRecordMsg name)
  freshVar ()

unboundVarFresh : String -> Mono
unboundVarFresh name =
  let _ = pushTypeError "T-UNBOUND" (unboundVarMsg name)
  freshVar ()

inferRecordUpdate : TcEnv -> Expr -> List FieldAssign -> Ref String -> Mono
inferRecordUpdate env base fields r = match firstFieldName fields
  None => panic "empty record update"
  Some fn => inferRecordUpdateField env base fields fn r

-- `Con { base | f = v, … }` — a named-field-variant update (e.g. desugar's
-- `DInterface { d | methods = … }`).  Resolve the variant's field layout by the
-- CONSTRUCTOR name (registered via registerNamedFieldVariants); both `base` and
-- the result have the variant's DATA type, only the provided fields are typed.
inferVariantUpdate : TcEnv -> String -> Expr -> List FieldAssign -> Mono
inferVariantUpdate env cname base fields = match lookupRecordByName cname
  None => unknownRecordFresh cname
  Some ri => inferRecordUpdateWith env cname base fields ri

firstFieldName : List FieldAssign -> Option String
firstFieldName [] = None
firstFieldName ((FieldAssign fn _)::_) = Some fn

-- receiver-directed (Phase 72), like inferFieldAccess: infer base first, then
-- pick the owning record by the base's head tycon, falling back to the first
-- update field's owners.
inferRecordUpdateField : TcEnv -> Expr -> List FieldAssign -> String -> Ref String -> Mono
inferRecordUpdateField env base fields fn r =
  let bt = normalize (infer env base)
  match resolveFieldRecord bt fn
    None => freshVar ()
    Some (rname, ri) =>
      -- stamp the RESOLVED receiver record onto the node (bug #38): both emitters
      -- read it to pick the record by name, instead of guessing from the first
      -- update label (which picks the wrong record — and so the wrong slot — when
      -- two records share a field name at different indices).
      r := rname
      inferRecordUpdatePicked rname bt env fields ri

inferRecordUpdatePicked : String -> Mono -> TcEnv -> List FieldAssign -> RecordInfo -> Mono
inferRecordUpdatePicked rname bt env fields ri =
  let sr = instantiateRecordShared ri
  let _ = unify bt (snd sr)
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

inferRecordUpdateWith : TcEnv -> String -> Expr -> List FieldAssign -> RecordInfo -> Mono
inferRecordUpdateWith env rname base fields ri =
  let sr = instantiateRecordShared ri
  let _ = unify (infer env base) (snd sr)
  let _ = unifyFieldAssignsIdx env rname ri (fst sr) fields
  snd sr

-- operators infer by SHAPE (the typeclass constraint they carry — Num/Eq/… — is
-- tracked at the value level but never rendered in a scheme, so it's irrelevant
-- to the === TYPES === output; numeric literals are Int, not polymorphic)
inferBinopE : TcEnv -> String -> Expr -> Expr -> Ref Route -> Mono
inferBinopE env op l r dref =
  let lt = infer env l
  let rt = infer env r
  -- Type-error span (Bite 2, fork 1 = WHOLE BINOP): after inferring both
  -- operands, the live `currentLoc` is the LAST operand atom (ELoc wraps
  -- leaves, not the binop level).  Point mismatches at the whole `l <op> r`
  -- span (l's start .. r's end) so both the Num-obligation errors and the
  -- comparison/Eq/Ord `typeMismatch` binop errors squiggle the operator
  -- expression rather than a lone operand.
  let _ = match binopSpanLoc l r
    Some sp => (currentLoc := (Some sp))
    None => ()
  let _ = recordBinopSite op dref lt
  let _ = recordArithSite op dref lt
  inferBinop op lt rt

-- Synthesize the whole-binop span from its operand Exprs: file + start of the
-- left operand, end of the right operand.  Falls back to whichever single
-- operand loc is available (None only when neither operand is ELoc-wrapped).
binopSpanLoc : Expr -> Expr -> Option Loc
binopSpanLoc l r = match (exprLoc l, exprLoc r)
  (Some (Loc f sl sc _ _), Some (Loc _ _ _ el ec)) => Some (Loc f sl sc el ec)
  (Some ll, None) => Some ll
  (None, Some rr) => Some rr
  (None, None) => None
-- Phase 151 / Gap G: record a binop site for the comparison/equality operators
-- so resolveBinopSites can stamp [dref] once the operand type grounds.  The
-- operand mono is [lt] (unified with [rt] by eqCompareOp/ordCompareOp below).

-- Map a comparison/equality operator to its Eq/Ord method and stash a pending
-- binop site; non-comparison operators record nothing.  G4: snapshot
-- currentImplBody so resolveBinopSite gates the RDict element-dict route to genuine
-- in-impl-body sites (a top-level operand may collide with stale activeDictVars ids).
recordBinopSite : String -> Ref Route -> Mono -> Unit
recordBinopSite op dref m = match binopMethod op
  Some method => perRun.value.pendingBinopSites := PendingEntry method dref m perRun.value.currentFn.value (SKOp perRun.value.currentImplBody.value) !currentLoc :: perRun.value.pendingBinopSites.value
  None => ()

-- SHARED-FLOAT-RESIDUAL §3(C): stash an arithmetic binop's operand mono + route
-- ref for the deferred scalar-type stamp.  Non-arithmetic operators record
-- nothing (their route is handled by recordBinopSite or left RNone).  The operand
-- mono is [lt] (unified with [rt] by inferBinop).
isArithBinop : String -> Bool
-- Intentional cross-file duplicate of the same helper in wasm_emit.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
isArithBinop op = contains op ["+", "-", "*", "/", "%"]

recordArithSite : String -> Ref Route -> Mono -> Unit
recordArithSite op dref m
  | isArithBinop op = perRun.value.pendingArithSites := (dref, m)::perRun.value.pendingArithSites.value
  | otherwise = ()

-- Roadmap #18a: `++` is the surface operator for `Semigroup`'s `append`, so it
-- joins the comparison operators on the recordBinopSite/resolveBinopSites seam —
-- a ground non-builtin operand (a user `impl Semigroup MyRope`) gets its route
-- stamped and rewriteBinopExpr turns the EBinOp into an `EMethodAt "append"`
-- application.  The builtin String/List appends never route (binopBuiltinHead) —
-- see the recursion note there.
binopMethod : String -> Option String
binopMethod "==" = Some "eq"
binopMethod "/=" = Some "eq"
binopMethod "<" = Some "lt"
binopMethod ">" = Some "gt"
binopMethod "<=" = Some "lte"
binopMethod ">=" = Some "gte"
binopMethod "++" = Some "append"
binopMethod _ = None

-- Roadmap #18c: `-` (unary minus) is the surface operator for `Num`'s `negate`,
-- joining `++`/comparisons on the record*Site/resolve*Sites/rewrite*Expr seam.
-- `!` never routes — Bool negation is not a typeclass method.
unopMethod : String -> Option String
unopMethod "-" = Some "negate"
unopMethod _ = None

-- The EUnOp analogue of recordBinopSite: stash a pending unop site for `-`
-- (nothing for `!`).  Same currentImplBody/currentFn snapshot, same reason.
recordUnopSite : String -> Ref Route -> Mono -> Unit
recordUnopSite op dref m = match unopMethod op
  Some method => perRun.value.pendingUnopSites := PendingEntry method dref m perRun.value.currentFn.value (SKOp perRun.value.currentImplBody.value) !currentLoc :: perRun.value.pendingUnopSites.value
  None => ()

-- The EUnOp analogue of inferBinopE: infer the single operand, record its
-- pending unop site (for `-`), then dispatch to inferUnop for the actual
-- obligation/unification work (negateOp for `-`, Bool-unify for `!`).
inferUnopE : TcEnv -> String -> Expr -> Ref Route -> Mono
inferUnopE env op e dref =
  let t = infer env e
  let _ = recordUnopSite op dref t
  inferUnop op t

inferBinop : String -> Mono -> Mono -> Mono
inferBinop "+" lt rt = numArithOp lt rt
inferBinop "-" lt rt = numArithOp lt rt
inferBinop "*" lt rt = numArithOp lt rt
inferBinop "/" lt rt = numArithOp lt rt
inferBinop "%" lt rt = numArithOp lt rt
inferBinop "++" lt rt = appendOp lt rt
inferBinop "==" lt rt = eqCompareOp lt rt
inferBinop "/=" lt rt = eqCompareOp lt rt
inferBinop "<" lt rt = ordCompareOp lt rt
inferBinop ">" lt rt = ordCompareOp lt rt
inferBinop "<=" lt rt = ordCompareOp lt rt
inferBinop ">=" lt rt = ordCompareOp lt rt
inferBinop "&&" lt rt = boolOp lt rt
inferBinop "||" lt rt = boolOp lt rt
inferBinop "::" lt rt = consOp lt rt
inferBinop "|>" lt rt = pipeOp lt rt
inferBinop ">>" lt rt = composeOp lt rt False
inferBinop "<<" lt rt = composeOp lt rt True
inferBinop op _ _ = panic ("typecheck: unsupported operator " ++ op)

-- Roadmap #18a: `++` (append) carries a `Semigroup` obligation on its (unified)
-- operand type — a verbatim mirror of `eqCompareOp`/`recordIfaceObligation` for `==`,
-- and the reason `"x" ++ Box 1` is now a located `No impl of Semigroup for Box`
-- reject at CHECK time rather than an eval-time `E-PANIC`.  Reuses the same
-- pendingImplObligations / checkImplObligations path: a synthetic Semigroup
-- obligation with a bare iface-param declared type (`TyVar "a"`, typaram ["a"]) so
-- dispatchMonosOf recovers exactly the operand mono.  `Monoid a requires Semigroup
-- a`, so a declared `Monoid a =>` constraint superclass-closes to satisfy it (this
-- is what keeps core.mdk's `foldMap f = fold (acc x => acc ++ f x) empty` typing).
-- A still-polymorphic operand defers to the caller, exactly like Num/Eq/Ord.
--
-- Gated on the PRELUDE's `Semigroup` being present, via `builtinClassPresent` (#1539;
-- it was `ifaceRegistered "Semigroup"` before): the bare-HM no-prelude oracle (tc_probe
-- / typecheck_main.mdk) has no `Semigroup` class, so recording the obligation only when
-- it exists keeps those drivers byte-identical while `medaka check` rejects.
appendOp : Mono -> Mono -> Mono
appendOp lt rt =
  let _ = unify lt rt
  let _ = recordIfaceObligation BSemigroup lt
  lt

-- #146: unified operator-obligation recorder.  The arithmetic (`+ - * / %`, unary
-- `-`), comparison (`== /= < > <= >=`) and append (`++`) operators each carry an
-- interface obligation on their (unified) operand type via pushPendingObl — a
-- synthetic obligation with a bare iface-param declared type (`TyVar "a"`, typaram
-- ["a"]) so dispatchMonosOf recovers exactly the operand mono.  Gated on the PRELUDE's
-- copy of that class being present: the bare-HM no-prelude oracle (tc_probe /
-- typecheck_main.mdk) declares none of Num/Eq/Ord/Semigroup, so recording only when the
-- class exists keeps those drivers byte-identical while full check_main (prelude)
-- rejects, matching `medaka check`.  Callers: numArithOp/negateOp (BNum), eqCompareOp
-- (BEq), ordCompareOp (BOrd), appendOp (BSemigroup).
--
-- #1539 / DICT §8 I7 qualification 4: the gate is `builtinClassPresent c`, NOT
-- `ifaceRegistered (builtinClassName c)`.  The latter asked whether SOME interface
-- spelled `Num` is registered — a table any user declaration writes to — so under §7.1
-- U1 (prelude becomes a node, and a user `interface Num` stops being a within-module
-- duplicate) a user's class would be the thing that TRIGGERS the operator's obligation.
-- That is the capture I7 qualification 4 forbids, reached through the gate rather than
-- through the payload, and it is the same reason the payload half already refuses to
-- read that table (see `ifaceRegistered`'s ledger).
recordIfaceObligation : BuiltinClass -> Mono -> Unit
recordIfaceObligation c lt
  | builtinClassPresent c = pushPendingObl (builtinIfaceRef c) ["a"] (TyVar "a") lt POperator !currentLoc
  | otherwise = ()

-- ── §8 I7: THE BUILT-IN CLASSES, AND WHY THEY ARE A CLOSED ENUM ─────────────────
-- `DICT-SEMANTICS.md` §8 I7 (ratified 2026-08-10): *an OPERATOR's class, and a numeric
-- literal's class, are fixed by the language definition.  They are not resolved by
-- name, and no user declaration can capture them.*  The eight synthetic occurrences in
-- this file (the five operator handlers, `inferNumLitBare`, and the two `Num` gates)
-- have no AST node and no declaration site to read an origin from, so P1 (#1446) needs
-- a supply route for them that is neither invented nor user-writable.
--
-- 🚨 THE KEY IS THIS ENUM, NOT A NAME, AND THAT IS THE WHOLE POINT.  The obvious route
-- — re-value `registeredIfacesRef` (`OrdMap Unit` → `OrdMap TyConOrigin`) and have the
-- operators read the origin they already gate on — was considered and REJECTED: that
-- table is written by `registerMethodIfaceParamsMethods` for EVERY interface, prelude
-- or user, so a user `interface Num` would both satisfy the gate and SUPPLY the origin.
-- That is exactly the capture I7 qualification 4 forbids, reached through the gate.
-- With a four-constructor enum the capture is not merely unlikely, it is
-- UNREPRESENTABLE: there is no way to name a fifth built-in class, and the only
-- population path reads a PRELUDE declaration list (`seedBuiltinClasses`).
--
-- The member set is DERIVED from the synthetic sites, not chosen:
--   grep -n 'recordIfaceObligation B' compiler/types/typecheck.mdk   -- the 5 operators
-- plus `inferNumLitBare`'s direct `Num`.  `Num`/`Eq`/`Ord`/`Semigroup`, and no others —
-- `Display`/`Mappable`/… are ordinary interfaces reached only through a named method
-- occurrence, which is an I4 occurrence resolved by name and needs nothing from here.
public export data BuiltinClass = BNum | BEq | BOrd | BSemigroup

-- the spelling each built-in class has in the prelude.  It is a CONSTANT of the
-- language, not a lookup key: nothing resolves this string against a scope.
builtinClassName : BuiltinClass -> String
builtinClassName BNum = "Num"
builtinClassName BEq = "Eq"
builtinClassName BOrd = "Ord"
builtinClassName BSemigroup = "Semigroup"

-- The four classes' identities AND their PRESENCE, read off the PRELUDE's own
-- `DInterface` declarations.  (Named `…Origins` until #1539; it carries the presence
-- half too now, so the name would have lied.)
--
-- Origin: plain `TyConOrigin` rather than `Option TyConOrigin` because
-- `OriginUnresolved` is the honest answer in both of the cases an `Option` would
-- distinguish — a prelude-free program (nothing declares the class, and nothing
-- implements it either, so any key answers the same) and a prelude whose declarations
-- this pass sees unstamped (the prelude-FLATTENED internal passes) — and in both the
-- impl side keys `TkBare` too, so writer and reader stay symmetric.  No sentinel, no
-- per-site decision about an empty origin (§8 I6.3).
--
-- 🚨 PRESENCE IS A SEPARATE FIELD AND CANNOT BE DERIVED FROM THE ORIGIN (#1539).  The
-- second bullet above is exactly why: on the prelude-FLATTENED arms a PRESENT prelude
-- declares `Num` with `OriginUnresolved`, so `bcNum == OriginUnresolved` does NOT mean
-- "no prelude".  A gate that read the origin as a presence test would answer False with
-- the prelude loaded and switch every operator's obligation OFF — no golden would move,
-- because a check that stops firing moves no output, which `AGENTS.md` grades as a
-- severity INCREASE.  The two questions are independent; keep two fields.
data BuiltinClasses = BuiltinClasses {
    bcNum : TyConOrigin,  -- one field per BuiltinClass constructor; keep these two comments (#829)
    bcEq : TyConOrigin,
    bcOrd : TyConOrigin,
    bcSemigroup : TyConOrigin,
    bcNumPresent : Bool,
    bcEqPresent : Bool,
    bcOrdPresent : Bool,
    bcSemigroupPresent : Bool,  -- adding a member means adding a constructor AND two fields here
  }

emptyBuiltinClasses : BuiltinClasses
emptyBuiltinClasses = BuiltinClasses {
  bcNum = OriginUnresolved,
  bcEq = OriginUnresolved,
  bcOrd = OriginUnresolved,
  bcSemigroup = OriginUnresolved,
  bcNumPresent = False,
  bcEqPresent = False,
  bcOrdPresent = False,
  bcSemigroupPresent = False,
}

builtinClassOrigin : BuiltinClass -> TyConOrigin
builtinClassOrigin BNum = crossRun.value.builtinClassesRef.value.bcNum
builtinClassOrigin BEq = crossRun.value.builtinClassesRef.value.bcEq
builtinClassOrigin BOrd = crossRun.value.builtinClassesRef.value.bcOrd
builtinClassOrigin BSemigroup =
  crossRun.value.builtinClassesRef.value.bcSemigroup

-- #1539 / DICT §8 I7 qualification 4: THE GATE.  True iff the declaration list this
-- pass treats as the PRELUDE declares this built-in class (with ≥1 method — see
-- `builtinClassesGo`).  This is the question I7 qualification 4 requires before a
-- synthetic operator/literal predicate may be synthesized at all; `ifaceRegistered`,
-- which the three gate sites asked until #1539, answers the *different* question "is
-- SOME interface spelled `Num` registered anywhere in this program", over a table any
-- user declaration writes to.
--
-- ⚠️ It is a record projection, so it is strictly CHEAPER than the `omHasKey` it
-- replaces — `ifaceRegistered`'s own doc-comment records that it is on the
-- per-operator / per-numeric-literal hot path (#147), and this change moves it from
-- O(log n) to O(1) rather than the other way.
builtinClassPresent : BuiltinClass -> Bool
builtinClassPresent BNum = crossRun.value.builtinClassesRef.value.bcNumPresent
builtinClassPresent BEq = crossRun.value.builtinClassesRef.value.bcEqPresent
builtinClassPresent BOrd = crossRun.value.builtinClassesRef.value.bcOrdPresent
builtinClassPresent BSemigroup =
  crossRun.value.builtinClassesRef.value.bcSemigroupPresent

-- the identity-carrying interface reference a synthetic occurrence records.
builtinIfaceRef : BuiltinClass -> IfaceRef
builtinIfaceRef c =
  IfaceRef { irName = builtinClassName c, irOrigin = builtinClassOrigin c }

-- ONE walk over a PRELUDE declaration list, picking up each built-in class's declared
-- origin and its presence.  Only `DInterface` decls contribute, and only the four fixed
-- spellings — so the population is closed even though the walk is over a decl list.
builtinClassesOf : List Decl -> BuiltinClasses
builtinClassesOf decls = builtinClassesGo decls emptyBuiltinClasses

-- 🚨 THE PRESENCE BIT MIRRORS `registerMethodIfaceParamsMethods` EXACTLY, and that is
-- what makes the #1539 gate switch behaviour-preserving rather than merely plausible.
-- That function — the sole writer of `registeredIfacesRef`, the table the three gates
-- read until #1539 — recurses over `methods` and inserts ONCE PER METHOD, so a
-- METHODLESS `interface Num a` registers NOTHING.  Reading `≥1 method` here rather than
-- `≥1 declaration` keeps the two populations equal decl-for-decl on the seed list; a
-- bare `declsNonEmpty`-shaped test would flip the gate ON for a methodless declaration
-- that today leaves it OFF.  The ORIGIN is still set unconditionally, because the origin
-- half's population is #1446's and is not what this issue re-decides.
builtinClassesGo : List Decl -> BuiltinClasses -> BuiltinClasses
builtinClassesGo [] acc = acc
builtinClassesGo ((DAttrib _ d)::rest) acc =
  builtinClassesGo rest (builtinClassesGo [d] acc)
builtinClassesGo ((DInterface { name, ifaceOrigin = o, methods, ... })::rest) acc = builtinClassesGo rest (builtinClassSet name o (isNonEmptyL methods) acc)
builtinClassesGo (_::rest) acc = builtinClassesGo rest acc

-- the CLOSED spelling→member map, written once.  A name that is not one of the four
-- contributes nothing, which is what makes `builtinClassesGo` safe to run over a decl
-- list that may contain user declarations (the flattened-prelude arm).
-- Presence accumulates with `||`: two declarations of one spelling can only ever ADD
-- presence, so a methodless second declaration cannot un-present a real one.
builtinClassSet : String -> TyConOrigin -> Bool -> BuiltinClasses -> BuiltinClasses
builtinClassSet "Num" o p acc =
  BuiltinClasses { acc | bcNum = o, bcNumPresent = acc.bcNumPresent || p }
builtinClassSet "Eq" o p acc =
  BuiltinClasses { acc | bcEq = o, bcEqPresent = acc.bcEqPresent || p }
builtinClassSet "Ord" o p acc =
  BuiltinClasses { acc | bcOrd = o, bcOrdPresent = acc.bcOrdPresent || p }
builtinClassSet "Semigroup" o p acc = BuiltinClasses { acc | bcSemigroup = o, bcSemigroupPresent = acc.bcSemigroupPresent || p }
builtinClassSet _ _ _ acc = acc

-- Seed the table from the declaration list THIS pass treats as the prelude, so that a
-- synthetic occurrence's key and the prelude's own `impl Num Int` key agree.
--
-- 🚨 THE SOURCE LIST IS CHOSEN FOR SYMMETRY WITH `insertUnivImpl`, WHICH IS WHAT
-- CORRECTNESS DEPENDS ON — not for tidiness.  `insertUnivImpl` keys the impl side off
-- `DImpl.implOrigin`, so this side must read the origin of the interface declaration
-- that lives in the SAME universe:
--   * `Flat coreProg` with a real prelude — `coreProg`, i.e. `mod:core`
--     (`test/origin_fixtures/graph/agreement.golden`: `core iface:Num AGREE AGREE
--     AGREE`, so the prelude's occurrences carry `mod:core` on the flat arm too).
--   * `Flat []` — the prelude is FLATTENED into `prog` (the `externTyOriginScope []`
--     internal passes: elaborateDict / discoverPromoted / discoverPromotedJoint /
--     checkBodyImpl / checkMatchToLines) or absent entirely (the bare-HM oracle).  Read
--     `prog`: whatever origin the flattened prelude's `interface Num` carries there is
--     the same one its `impl Num Int` carries, and an absent prelude yields
--     `OriginUnresolved` on both sides.  ⚠️ A user declaration CAN be the source in this
--     arm — and cannot capture anything, because a flattened program that declares a
--     second `Num` is rejected outright (`Duplicate interface: Num`) before any
--     obligation is recorded.  §7.1 U1 (prelude becomes a node) deletes this arm along
--     with the flatten.
--   * `Module` — only the PRELUDE's own pass writes, and it writes once; later modules
--     read the surviving `CrossRun` value.  A user module is never the source.
--     ⚠️ That last sentence became TRUE ON BOTH DRIVERS only with #1508 (U2a).  Before
--     it, `cmCheckWorker` handed every user module `mid = ""`, so on the `checkModules`
--     driver each one re-entered this arm and OVERWROTE the table with
--     `builtinClassesOf` of its own decls — normally `emptyBuiltinClasses`, i.e. it
--     wiped the prelude's four origins to `OriginUnresolved` for every module after the
--     first.  It was survivable — and therefore invisible to every gate — only because
--     `oblIfaceKeys` indexes each impl under its identity key AND a bare-spelling
--     COMPATIBILITY leg, so an `OriginUnresolved` synthetic goal keys `TkBare` and still
--     lands on the impl.  In other words the clobber was masked by the very leg U1b/#1507
--     are draining, which is precisely why it had to be fixed before that leg goes: the
--     fix simply stops the write, restoring the invariant this bullet always claimed.
--     ⚠️ There is a SECOND, independent reason it was unobservable, and it is the one
--     that bounds the severity: `checkModules` — the ONLY driver on which the clobber
--     occurred — harvests no diagnostics at all (`cmCheckWorker`, "no diagnostics
--     harvest"; `perRun.typeErrors` is discarded), so even a false reject produced by an
--     `OriginUnresolved` key had no channel to reach a caller. Both reasons are needed:
--     the compatibility leg explains why dispatch still resolved, the discarded error
--     list explains why a failure to resolve would have been silent anyway.
seedBuiltinClasses : CheckMode -> List Decl -> Unit
seedBuiltinClasses (Flat coreProg) prog =
  let classes = builtinClassesOf (if declsNonEmpty coreProg then coreProg else prog)
  crossRun.value.builtinClassesRef := classes
-- ⚠️ BOTH SPELLINGS of the prelude's module id are tested, for the same reason
-- `declEnvsOrdOf` indexes it twice: the `graph*Exports` peers key the prelude under
-- `"core"`, but the `mid` both Module-mode drivers actually PASS for the core pass is
-- `""` (`checkModuleFull` → `checkModuleFullImpl ""`; `elabModuleStamp ""`).  Testing
-- only `"core"` would silently never fire on either driver — and the miss is silent
-- because an unseeded table yields `OriginUnresolved`, i.e. a `TkBare` goal key against
-- `TkIdent` impls: a false REJECT of the prelude, which is the #1112 prototype's
-- 634-diagnostic signature.
seedBuiltinClasses (Module mid _ _) prog =
  if mid == "core" || mid == "" then
    crossRun.value.builtinClassesRef := builtinClassesOf prog
  else
    ()

-- ── TOMBSTONE: `ifaceRegistered`, the RETIRED I7 gate (#147 → #1539) ────────────
-- 🪦 THE FUNCTION IS GONE; THIS LEDGER IS NOT, because every reason below is a reason
-- about `registeredIfacesRef` — which still exists — and because the route it argues
-- against is the one a later reader will re-propose.  `ifaceRegistered iface = omHasKey
-- iface perRun.value.registeredIfacesRef.value` was True iff `iface` had ≥1 method
-- registered from the `DInterface` decls (present once core.mdk is loaded); #147 made it
-- an O(log n) membership test in place of a full linear scan of the method table per
-- operator / numeric literal.  Its only three callers were the I7 GATES, and #1539 moved
-- all three to `builtinClassPresent` (above), leaving it unreachable — `rule-dead-code`
-- says delete an unreachable private binding, so it is deleted rather than kept warm.
--
-- ⚠️ `registeredIfacesRef` / `universeRegisteredIfacesRef` are consequently WRITE-ONLY
-- as of #1539: `registerMethodIfaceParamsMethods` and `insertIfaceMethodsAcc` still
-- populate them, the Module arm still copies the universe one into the per-run one, and
-- NOTHING reads either.  Retiring the table is deliberately NOT in #1539's diff — that
-- edits the `PerRun`/`CrossRun` layout and the `insertMethodIfaceParams` accumulator
-- type, which two other in-flight `typecheck.mdk` branches sit on top of — and is filed
-- as its own atom, **#1569**.  Derive the claim rather than trusting this note:
--   grep -n 'registeredIfacesRef' compiler/types/typecheck.mdk
-- every hit should be a write, an init, a field declaration, or a comment.
--
-- 🚨 `registeredIfacesRef` / `universeRegisteredIfacesRef` STAY BARE-NAME-KEYED,
-- and this is a DERIVED refusal, not a gap for a later reader to "finish".  Two
-- units reached it independently — A-2.4, whose brief listed this table as its
-- third target, and A-2.2b, which re-derived it rather than inheriting it — and
-- their two write-ups are UNIONED here rather than left as two records of one
-- fact that can drift apart.  Three reasons, in the order that decided it:
--
--   1. THE VALUE IS `Unit`.  Two modules declaring `Same` collapse to one entry
--      today, and collapsing changes NOTHING OBSERVABLE — there is no row to
--      select and no payload to get wrong.  Every other table this arc re-keys
--      answers WHICH declaration; this one answers only WHETHER one exists.  It is
--      the `tabHasName` / `noImplHint` shape A-2.3 established: a name-membership
--      predicate, not a lookup.
--   2. NO CALLER HAS AN ORIGIN TO KEY WITH.  All three call sites pass a LITERAL
--      prelude interface name — `recordIfaceObligation` (above: "Num"/"Eq"/"Ord"/
--      "Semigroup", from the operator handlers), `inferNumLit` ("Num") and
--      `checkOneCallObligation` ("Num").  These are synthetic occurrences with no
--      `Ty` and no decl behind them, so there is no `TyConOrigin` to read; an
--      identity-keyed set would have to hardcode `OriginModule "core"`, which
--      invents the very ambient module id `stampFlatTyOrigins`' own doc-comment
--      forbids.  With a `TkBare "Num"` key instead, the lookup would MISS the
--      prelude's `TkIdent … core` entry and `ifaceRegistered` would answer False
--      everywhere — silently switching every operator's obligation OFF.  No golden
--      moves, because a check that stops firing moves no output: the
--      `loud → silent` transition `AGENTS.md` grades as a severity INCREASE.
--   3. THE QUESTION IT GATES IS NAME-KEYED DOWNSTREAM ANYWAY.  What it gates is
--      `pushPendingObl (iface, …)`, and the whole obligation channel — the three
--      `ImplUniverse` buckets, written by `insertUnivImplAt` and reached on the
--      Module path through `ieUniverseAt` and on the Flat path through
--      `buildImplUniverse` — still indexes its interface half under the bare NAME
--      as well as the identity one.  ⚠️ ANCHOR: this named the three
--      `obUnivConcreteRef`/`obUnivHeadlessRef`/`obUnivIfaceTagsRef` accumulators
--      until #1112 A-3.4 PR2 DELETED them; the buckets and the property survived
--      the carriers, so re-read this on the value, not on the retired refs.  ⚠️ A-2.4's own draft of this
--      reason said that channel is keyed `"<iface>|<tag>"`, and that "when A-2.2
--      lands, this gate is worth revisiting THEN".  BOTH are now out of date, and
--      by A-2.2b's own doing: the string splice is gone, replaced by a structured
--      `RegKey` whose iface half is nevertheless a bare `TkBare NsIface` for the
--      reason derived at `oblIfaceKey`.  So the payload did move — and the gate
--      still cannot follow it, because the payload did not become identity-keyed.
--      Identity-keying the GATE while the PAYLOAD stays name-keyed is still a
--      half-migration.
--
-- ✅ #1446 (P1) SUPPLIED THE MISSING IDENTITY — BUT NOT BY RE-VALUING THIS TABLE,
-- AND THAT DISTINCTION IS THE POINT.  The paragraph that used to stand here said the
-- blocker was "a resolved identity for a SYNTHETIC interface occurrence" and routed
-- the reader to #1115.  `Predicate` now carries one (`iface : IfaceRef`), and the
-- synthetic occurrences get theirs from `builtinClassesRef` — a CLOSED four-member
-- enum populated only from the prelude's own `DInterface` decls (DICT-SEMANTICS §8
-- I7, ratified 2026-08-10).
--
-- 🚨 RE-VALUING THIS TABLE TO `OrdMap TyConOrigin` WAS THE OBVIOUS ROUTE AND IT IS
-- THE WRONG ONE.  Its population is written by `registerMethodIfaceParamsMethods`
-- for EVERY interface, prelude or user, so an identity-bearing VALUE here would let
-- a user `interface Num` both satisfy the gate and SUPPLY the origin — I7
-- qualification 4's capture, reached through the gate.  A closed enum makes that
-- unrepresentable.  So reasons (1) and (2) above stay TRUE OF THIS TABLE, and
-- reason (3) is discharged elsewhere rather than retracted: the payload IS now
-- identity-keyed, and the six operator/literal payload sites no longer read this
-- table for their interface — they read `builtinIfaceRef`.  What this table still
-- answers, and answers correctly by a bare name, is the PRESENCE question ("is the
-- prelude loaded at all"), which is why it is not a half-migration.
-- ✅ #1539 DRAINED THE RESIDUAL, AND IT DID SO BY DELETING THE READER RATHER THAN
-- RE-KEYING THE TABLE.  All THREE gate sites (`recordIfaceObligation`, `inferNumLit`,
-- `checkOneCallObligation`) now ask `builtinClassPresent`.  The paragraph that stood
-- here said switching them is behaviour-preserving only if `builtinClassesRef`'s
-- population and this table's agree in every reachable configuration, "which #1446 did
-- not measure".  #1539 MEASURED it, two ways: (a) `builtinClassesGo` was made to mirror
-- this table's sole writer decl-for-decl on the seed list (`≥1 method` — see its own
-- note), and (b) a disagreement tripwire compiled into the checker reported ZERO
-- disagreements at any of the three sites across the whole gate corpus.
--
-- 🚨 DO NOT "RESTORE" A PRELUDE-PRESENCE READER OVER THIS TABLE.  Asking it "is the
-- prelude loaded" is the I7 qualification 4 mistake: it is a bare-NAME membership test
-- over a table `registerMethodIfaceParamsMethods` writes for EVERY interface, prelude or
-- user, so a user `interface Num` satisfies it.  The presence question has a closed,
-- prelude-only answer now — `builtinClassPresent`.
-- ────────────────────────────────────────────────────────────────────────────────

-- G2: arithmetic `+ - * / %` carry a `Num` obligation on their (unified) operand
-- type — mirrors the oracle's `No impl of Num for <T>` reject (lib/typecheck.ml).
-- `++` (append) is NOT Num — it carries a `Semigroup` obligation instead (appendOp
-- above).  We reuse the
-- existing pendingImplObligations / checkImplObligations path: a synthetic Num
-- obligation with a bare iface-param declared type (`TyVar "a"`, typaram ["a"]) so
-- dispatchMonosOf recovers exactly the operand mono.  When it grounds to a concrete
-- non-Num head (String/Bool) with no `impl Num`, the post-inference check rejects;
-- while still a polymorphic var (a `Num a =>` site) allConcreteHeads defers it to
-- the caller — exactly the oracle's behaviour.
--
-- Gated on the `Num` interface being REGISTERED (prelude loaded): the bare-HM,
-- no-prelude oracle (tc_probe / typecheck_main.mdk) imposes NO class constraint on
-- `+`, so `1 + 2 : Int` and `"a" - "b" : String` both type there.  Recording the
-- obligation only when Num exists keeps the no-prelude drivers byte-identical to
-- that oracle while the full check_main (prelude) path rejects, matching `medaka
-- check`.
numArithOp : Mono -> Mono -> Mono
numArithOp lt rt =
  -- Chunk D: taint any literal operand BEFORE the unify grounds it — so a literal
  -- fed to an arithmetic op (`1 + "x"`, `x + 1`, `1 + x`) keeps `No impl of Num for
  -- T` (the `+` is the culprit) rather than being reframed as a bare mismatch.
  let _ = markNumlitOpTaint lt
  let _ = markNumlitOpTaint rt
  let _ = unify lt rt
  let _ = recordIfaceObligation BNum lt
  lt

-- PLAN.md #11 soundness arm: model an integer literal as a `fromInt n` method
-- occurrence so its route cell [dref] gets stamped (RKey ground / RDictFwd poly) by
-- resolveSites — exactly like core.mdk's `fromInt 0` in `sum`.  Direct mirror of
-- lib/typecheck.ml's ENumLit infer arm.  Gated on the prelude (the PRELUDE's `Num`
-- present — `builtinClassPresent BNum` since #1539, was `ifaceRegistered "Num"` — AND
-- `fromInt` bound): with no prelude (bare-HM oracle) fall back to a plain fresh
-- Num-obligated var, leaving [dref] RNone (⇒ a static Int literal at rewrite time).
-- ⚠️ #1539 converts the GATE only.  The `lookupVar env "fromInt"` on the next line is
-- the OTHER, larger I7 divergence (§11's "I7 (literals)" row): the literal's method is
-- still anchored by a bare name in the USER's term scope, so a user binding spelled
-- `fromInt` still re-anchors every literal in the module.  That is untouched here.
inferNumLit : TcEnv -> Int -> Ref (Option Float) -> Ref Route -> Mono
inferNumLit env n fref dref
  | builtinClassPresent BNum = match lookupVar env "fromInt"
    None => inferNumLitBare n fref
    Some _ =>
      -- inferMethodAt records the Num impl obligation + a pendingSite on [dref].
      let fromIntTy = inferMethodAt env "fromInt" dref (Ref []) (Ref [])
      let a = freshVar ()
      let _ = unify fromIntTy (TFun (tconBuiltin "Int") (openRow ()) a)
      perRun.value.numlitRefs := ((a, fref, n, dref) :: perRun.value.numlitRefs.value)
      let _ = recordNumlitLoc a  -- Chunk D: literal provenance for Num mis-framing
      a
  | otherwise = inferNumLitBare n fref

-- no-prelude fallback: a fresh var, no route (dref untouched ⇒ stays RNone ⇒ Int).
-- PLAN.md #11 (locked §0.2): a numeric literal is ALWAYS a `fromInt n` occurrence,
-- so it carries a `Num` obligation on its var unconditionally — exactly the OCaml
-- oracle, whose ENumLit infer arm `infer env (EVar "fromInt")` records the Num
-- usage even no-prelude (`initial_env` seeds `fromInt`/`Num`).  Recording it here
-- (vs. the prelude-gated `recordIfaceObligation`) lets value-level defaulting ground
-- an AMBIGUOUS literal var to Int (`nums = [1,2,3] : List Int`) so the no-prelude
-- `typecheck_main` matches the prelude-aware oracle golden.  The matching reject is
-- SUPPRESSED no-prelude in checkOneImplObligation (no-prelude imposes no Num impl
-- constraint — see its `builtinClassPresent BNum` guard), so a literal still types Int
-- without a spurious `No impl of Num for Int`.
inferNumLitBare : Int -> Ref (Option Float) -> Mono
inferNumLitBare n fref =
  let a = freshVar ()
  let _ = pushPendingObl (builtinIfaceRef BNum) ["a"] (TyVar "a") a PNumLit !currentLoc
  perRun.value.numlitRefs := (a, fref, n, Ref RNone)::perRun.value.numlitRefs.value
  let _ = recordNumlitLoc a  -- Chunk D: literal provenance for Num mis-framing
  a

-- ── Chunk D: Num mis-framing provenance (error-path only) ──────────────────
-- Record a literal's (var, loc) so a later Num-obligation reframe can tell a bare
-- literal from an arithmetic-operator operand.  [currentLoc] is the ENumLit span.
recordNumlitLoc : Mono -> Unit
recordNumlitLoc a = match !currentLoc
  Some l =>
    perRun.value.numlitVarLocs := (a, l)::perRun.value.numlitVarLocs.value
    perRun.value.numlitUntainted := (a, l)::perRun.value.numlitUntainted.value
  None => ()

-- Called from recordIfaceObligation (arithmetic `+`/`-`/`*`/`/`/`%`): any recorded
-- literal whose var shares a union-find root with [m] was an operand of an op, so
-- mark its loc — the reframe then keeps `No impl of Num for T` for it.  Runs during
-- inference (vars still unbound), so `normalize` reveals the shared root regardless
-- of which operand became the root at unify time.
markNumlitOpTaint : Mono -> Unit
markNumlitOpTaint m =
  let id = rootIdOf m
  if id < 0 || not (anyRootMatch id perRun.value.numlitUntainted.value) then
    ()
  else
    perRun.value.numlitUntainted := taintAndDrop id perRun.value.numlitUntainted.value

-- True iff SOME worklist literal shares the union-find root [id].  Short-circuits via
-- `||` and allocates nothing, so the common case (this operand taints no literal)
-- leaves the worklist alone — rebuilding it unconditionally would put back an O(N)
-- allocation per operand, which is the very thing `rootIdOf` removed.
anyRootMatch : Int -> List (Mono, Loc) -> Bool
anyRootMatch _ [] = False
anyRootMatch id ((v, _)::rest) = sameRootId id v || anyRootMatch id rest

-- Taint every worklist literal sharing the root [id] (record its loc as
-- operator-tainted) and DROP it from the worklist; keep the others.
taintAndDrop : Int -> List (Mono, Loc) -> List (Mono, Loc)
taintAndDrop _ [] = []
taintAndDrop id ((v, l)::rest)
  | sameRootId id v =
    perRun.value.numlitOpLocs := l::perRun.value.numlitOpLocs.value
    taintAndDrop id rest
  | otherwise = (v, l) :: taintAndDrop id rest

-- The union-find ROOT id of [v]; -1 if it does not normalize to a type variable.
-- NON-ALLOCATING (it reads the root's id rather than rebuilding a `TVar` for it) and
-- PATH-COMPRESSING (it goes through `normalizeLink`, so a walked chain is flattened).
-- PERF: `sameRootId` is applied to EVERY recorded literal on EVERY arithmetic /
-- comparison operand (markNumlitOpTaint and tagLitLocsWithRoot each scan the whole,
-- never-trimmed `numlitVarLocs` list), so an uncompressed chain made this the single
-- hottest symbol in the compiler — 57% of a large-declaration typecheck (issue #115).
-- Tyvar ids come from a counter that starts at 0 (`newTyvarId`), so -1 can never
-- collide with a real id.
rootIdOf : Mono -> Int
rootIdOf (TVar cell) = match !cell
  Unbound id _ => id
  Link t => rootVarId (normalizeLink cell t)
rootIdOf _ = 0 - 1

-- The id of an ALREADY-NORMALIZED mono: its root tyvar's id, or -1 if it is not a
-- type variable at all.  (`normalizeLink` never returns a `Link`, so that arm is
-- unreachable; it folds into the not-a-tyvar answer.)
rootVarId : Mono -> Int
rootVarId (TVar cell) = match !cell
  Unbound id _ => id
  Link _ => 0 - 1
rootVarId _ = 0 - 1

-- True iff [v] normalizes to the unbound var [id] (same union-find root).
sameRootId : Int -> Mono -> Bool
sameRootId id v = rootIdOf v == id

-- Chunk D: if one of [a]/[b] is a still-unbound literal var and the other is
-- concrete-headed, tag that literal's loc with [kind] so the reframe can use
-- site-specific wording.  Pure state capture — never alters unification.
noteNumlitCtx : Mono -> Mono -> String -> Unit
noteNumlitCtx a b kind =
  let _ = tagNumlitCtxIf a b kind
  tagNumlitCtxIf b a kind

-- Tag EVERY literal whose var shares [v]'s root (not just the first) when [other]
-- has a concrete head — so a heterogeneous list forcing several literals to one
-- type tags them all with the same [kind], letting their reframed messages dedup to
-- a single "list elements have different types" line.
tagNumlitCtxIf : Mono -> Mono -> String -> Unit
tagNumlitCtxIf v other kind
  | isSome (headTyconNameMono other) = tagAllLitLocs v kind
  | otherwise = ()

tagAllLitLocs : Mono -> String -> Unit
tagAllLitLocs v kind = match normalize v
  TVar cell =>
    tagLitLocsWithRoot (tyvarId cell) kind perRun.value.numlitVarLocs.value
  _ => ()

tagLitLocsWithRoot : Int -> String -> List (Mono, Loc) -> Unit
tagLitLocsWithRoot _ _ [] = ()
tagLitLocsWithRoot id kind ((mv, l)::rest) =
  let _ = if sameRootId id mv then
    perRun.value.numlitCtxTags := (l, kind)::perRun.value.numlitCtxTags.value
  else
    ()
  tagLitLocsWithRoot id kind rest

-- Stage-1 Eq dispatch (EQ-DISPATCH-DESIGN.md §2.1): `==`/`/=` carry an `Eq`
-- obligation on their (unified) operand type — a verbatim mirror of
-- `recordIfaceObligation` for `+`.  We reuse the existing pendingImplObligations /
-- checkImplObligations path: a synthetic Eq obligation with a bare iface-param
-- declared type (`TyVar "a"`, typaram ["a"]) so dispatchMonosOf recovers exactly
-- the operand mono.  When it grounds to a concrete non-Eq head (a function, an
-- un-derived ADT) with no `impl Eq`, the post-inference check rejects; while still
-- a polymorphic var (an `Eq a =>` site) allConcreteHeads defers it to the caller
-- — exactly the Num behaviour.  `<`/`>`/`<=`/`>=` carry the sibling `Ord`
-- obligation via `ordCompareOp` below.  `/=` shares this seam and lowers to
-- `not (eq …)` at the dict layer (binopMethodApp), so it does not double-report.
--
-- Gated on the PRELUDE's `Eq` being present (`builtinClassPresent BEq`, #1539): the
-- bare-HM no-prelude oracle (tc_probe / typecheck_main)
-- has no `Eq` class, so recording the obligation only when Eq exists keeps those
-- drivers byte-identical while full check_main (prelude) rejects.
eqCompareOp : Mono -> Mono -> Mono
eqCompareOp lt rt =
  let _ = unify lt rt
  let _ = recordIfaceObligation BEq lt
  tconBuiltin "Bool"

-- Stage-1 Ord dispatch (EQ-DISPATCH-DESIGN.md §"sibling Ord follow-up"): the four
-- ordering comparisons `<`/`>`/`<=`/`>=` carry an `Ord` obligation on their
-- (unified) operand type — a verbatim mirror of `eqCompareOp` for `==`.  Reuses the
-- same pendingImplObligations / checkImplObligations path.  `Ord` supersets `Eq`
-- (`interface Ord a requires Eq a`), so a declared `Ord a =>` constraint already
-- superclass-closes to satisfy BOTH the `<`→Ord and a sibling `==`→Eq obligation;
-- an `Eq a =>` declaration does NOT close upward, so a bare `<` under `Eq a =>` is
-- correctly rejected as needing `Ord a`.  When the operand grounds to a concrete
-- non-Ord head (a function, an un-derived ADT) with no `impl Ord`, the
-- post-inference check rejects; while still a polymorphic var it defers to the
-- caller — exactly the Eq/Num behaviour.  NO change to eval/emit: `<` still lowers
-- to `EMethodAt "lt"` at the dict layer, so runtime/emit dispatch is unchanged.
--
-- Gated on the PRELUDE's `Ord` being present (`builtinClassPresent BOrd`, #1539).
ordCompareOp : Mono -> Mono -> Mono
ordCompareOp lt rt =
  let _ = unify lt rt
  let _ = recordIfaceObligation BOrd lt
  tconBuiltin "Bool"

boolOp : Mono -> Mono -> Mono
boolOp lt rt =
  let _ = unify lt (tconBuiltin "Bool")
  let _ = unify rt (tconBuiltin "Bool")
  tconBuiltin "Bool"

consOp : Mono -> Mono -> Mono
consOp lt rt =
  let listTy = TApp (tconBuiltin "List") lt
  let _ = noteNumlitCtx lt rt "cons"  -- Chunk D: tag cons head-vs-list Num mismatch
  let _ = unify rt listTy
  listTy

pipeOp : Mono -> Mono -> Mono
pipeOp lt rt =
  let res = freshVar ()
  let eff = openRow ()
  let _ = unify rt (TFun lt eff res)
  let _ = performEffect perRun.value.curEffect eff
  res

-- g >> h : (a->b) -> (b->c) -> (a->c)  [flipped=False]
-- g << h : (a->b) -> (c->a) -> (c->b)  [flipped=True]
composeOp : Mono -> Mono -> Bool -> Mono
composeOp gt ht False =
  let a = freshVar ()
  let b = freshVar ()
  let c = freshVar ()
  let _ = unify gt (TFun a (openRow ()) b)
  let _ = unify ht (TFun b (openRow ()) c)
  TFun a (openRow ()) c
composeOp gt ht True =
  let a = freshVar ()
  let b = freshVar ()
  let c = freshVar ()
  let _ = unify gt (TFun a (openRow ()) b)
  let _ = unify ht (TFun c (openRow ()) a)
  TFun c (openRow ()) b

inferUnop : String -> Mono -> Mono
inferUnop "-" t = negateOp t
inferUnop "!" t = derefOp t
inferUnop op _ = panic ("typecheck: unsupported unary op " ++ op)

-- #1739 half A: `!x` is Ref-DEREFERENCE, not boolean negation — `not` is the sole
-- boolean negation (it is already a prelude fn).  The unify is the same one
-- `inferValueField` does for `x.value`, and deliberately so: the two spellings must
-- infer identically, since desugar-free lowering sends both to `CFieldAccess _
-- "value"`.  Unification rather than a structural match, so it also works when the
-- receiver is still an unsolved tyvar (a param not yet pinned to its signature).
--
-- The `Bool` arm is the REQUIRED diagnostic (user, 2026-07-10).  `!aBool` is the OLD
-- boolean-not use, and left to unification it fails as a bare `Ref a vs Bool`
-- mismatch that says nothing about what changed — so the Bool shape is INTERCEPTED
-- here, before unify, and answered with a message naming `not`.
--
-- ⚠️ The "use `not x`" advice is IN THE MESSAGE, not only in `help`.  ERROR-QUALITY
-- §4.5 puts actionable advice on a `help:` line, but `help` is a JSON-ONLY channel
-- here — the CLI renderer never prints it — so advice that lives only there is
-- invisible to the human this diagnostic exists for.  The did-you-mean precedent
-- does the same ("Unbound variable: greetng. Did you mean 'greeting'"), and this is
-- the wording the user specified for this bite (2026-07-10).  `help` still carries
-- the longer WHY for the structured consumers.
--
-- It returns `Bool` on that path rather than a fresh var: the operand was a Bool and
-- the author meant negation, so `Bool` is the type the surrounding expression was
-- written to expect (`if !flag then …`), and handing it back keeps ONE located error
-- instead of a cascade of downstream mismatches — the Chunk-D recovery shape the
-- literal-provenance arms already use.
derefOp : Mono -> Mono
derefOp t =
  if monoIsBool (normalize t) then
    let _ = pushTypeErrorHelpFixAt "T-BANG-ON-BOOL" None bangOnBoolMsg bangOnBoolHelp None
    tconBuiltin "Bool"
  else
    let inner = freshVar ()
    let _ = unify t (TApp (tconBuiltin "Ref") inner)
    inner

-- `Bool` as a HEAD, ignoring origin: the prelude's Bool is builtin-origin, but a
-- normalized operand can carry a module origin, and the question here is only which
-- type constructor it is.
monoIsBool : Mono -> Bool
monoIsBool (TCon "Bool" _) = True
monoIsBool _ = False

bangOnBoolMsg : String
bangOnBoolMsg = "`!` is dereference (Ref), not boolean negation — use `not x`"

bangOnBoolHelp : String
bangOnBoolHelp = "use `not x` — `!x` reads the cell of a `Ref`, so it needs a `Ref a`, not a `Bool`"

-- Roadmap #18c: unary minus `-x` carries a `Num` obligation on its operand type —
-- a verbatim mirror of `numArithOp`/`recordIfaceObligation` for binary `+`/`-`/…,
-- and the reason `-"x"` is now a located `No impl of Num for String` reject at
-- CHECK time rather than an eval-time `panic "unary minus on non-number"`.
-- markNumlitOpTaint keeps the same Chunk-D literal-provenance error framing as
-- the binary arithmetic operators (`-"x"` blames the operator, not a bare
-- literal-vs-String mismatch).
negateOp : Mono -> Mono
negateOp t =
  let _ = markNumlitOpTaint t
  let _ = recordIfaceObligation BNum t
  t

-- backtick infix `x `f` y` is just f applied to x then y
inferInfix : TcEnv -> String -> Expr -> Expr -> Mono
inferInfix env op l r =
  let ft = inferVar env op
  let lt = infer env l
  let rt = infer env r
  -- reconstruct the equivalent app spine so a hole-bearing extern fills from
  -- its FIRST arg (l) — mirror of the EApp path (v2 Stage 2b).
  let inner = EApp (EVar op) l
  inferApp (envAlphaLets env) (EApp inner r) (inferApp (envAlphaLets env) inner ft lt) rt

inferVar : TcEnv -> String -> Mono
inferVar env x = inferVarId env x 0

-- #837: the id-carrying entry point.  id 0 (every non-EVarId caller, e.g.
-- inferInfix) is the bare-name fallback — byte-identical to the pre-#837 path.
inferVarId : TcEnv -> String -> Int -> Mono
inferVarId env x id = match maybeStandaloneValueMono x
  -- P0-19 d4b (S4): bare value-position definer shadow → the standalone scheme.
  Some m => m
  None => inferVarPlainId env x id

inferVarPlainId : TcEnv -> String -> Int -> Mono
inferVarPlainId env x id = match lookupVar env x
  Some s =>
    let mono = instantiateVarTrackedId x id s
    -- #816/#818 shadow guard — shared with inferMethodAt (the emit path); see
    -- recordMethodObligationGuarded.  [mono] is the already-tracked instantiation.
    recordMethodObligationGuarded env x s mono
  None => unboundVarFresh x

-- #11 soundness (native obligation hole, plain check path): a constrained binding used
-- as a plain EVar (`g = f "hello"`) instantiates its DEFERRED obligations at the call.
-- schemeObligationsRef (always-on, unlike funConstraintsRef) records each binding's
-- (iface, quantified-var-id); here we instantiate TRACKED so each obligation var maps
-- to this call's fresh mono, recorded as a call obligation checked after inference.
-- A binding with no recorded obligations takes the plain instantiate path (identical
-- mono).  Mirrors lib/typecheck.ml re-checking inferred_constraints at every use.
-- #837: [id] is the occurrence's binding id (from EVarId).  When id /= 0 the
-- lookup keys EXACTLY (x, id) — so a top-level `g`'s use can never pick up a
-- where-helper `g`'s obligations.  id == 0 (local/where/cross-module/global, or
-- any non-EVarId caller) falls to the bare-name scan — byte-identical to today.
instantiateVarTrackedId : String -> Int -> Scheme -> Mono
instantiateVarTrackedId x id s = match lookupSchemeObls x id perRun.value.schemeObligationsRef.value
  Some obs =>
    let inst = instantiateTracked s
    let _ = recordSchemeCallObligations id obs (snd inst)
    fst inst
  -- #673: schemeObligationsRef is a PER-MODULE ref (reset per module), so a CROSS-MODULE
  -- constrained binding used as a plain EVar has NO entry here.  For a PRELUDE binding
  -- (`println : Display a => …`, the #673 repro) the plain-`instantiate` fallback silently
  -- DROPPED its call obligation, so `check` false-greened on `println (Foo 1)` / a 6-tuple
  -- with no Display while `run`/`build` (dict elaboration is a separate net) rejected.
  None => match declaredCrossModuleObls x
    Some obs =>
      let inst = instantiateTracked s
      let _ = recordSchemeCallObligations id obs (snd inst)
      fst inst
    None => instantiate s

-- #673: the declared call obligations of a CROSS-MODULE constrained binding [x] used as a
-- plain EVar, in schemeObligations shape (`(iface, quantified-var-id VECTOR)` list) so the
-- caller records them exactly like the same-module `Some obs` branch.  TWO source-EXACT
-- lookups, NEVER a name-only whole-table scan (both correctness- and perf-unsound, #673 rework):
--
--   (1) qualConstraintFor x — a USER import resolves through currentImportDefinersRef to the
--       ACTUAL owning module's (src, name) qual entry, so a same-named import from a DIFFERENT
--       module (foo's constrained `bar` vs baz's unconstrained `bar`, where `x` resolves to
--       baz) can never be misattributed.  It also gates on the cheap currentImportDefinersRef
--       membership, so only a genuine import pays a scan — not every unconstrained/local var.
--   (2) coreSchemeObligationsRef — core's OWN captured schemeObligationsRef (snapshotted right
--       after the core pass, before the first module's resetState).  Prelude names are
--       deliberately excluded from currentImportDefinersRef (importDefinersOf skips `core`),
--       so qualConstraintFor cannot see them; this is the source-EXACT store for exactly that
--       set (`println`/`print`), an O(log n) OrdMap lookup with ZERO wrong-module surface.
--   (3) #1114/#845 — crossModuleSchemeOblsQualRef, the (module, name)-attributed
--       snapshot of every USER module's own schemeObligationsRef.  Lookups (1) and (2)
--       between them cover only DECLARED contexts (funConstraintsRef, whose inferred
--       half is `dictEligibleSetRef`-gated and empty on the check path) and CORE.  An
--       UNSIGNATURED constrained export of a user module — `export f x = go x where go
--       n = n + 1`, whose `Num a =>` is inferred, not written — is in NEITHER, so its
--       obligation was dropped at every importing call site and `check` false-greened
--       on `f "abc"` (`run` panicked `unknown op '+'`; `build` exited 0 and the binary
--       SEGFAULTED).  Per DICT-SEMANTICS §4.2 D6(a) a declared and an inferred context
--       defer identically — §4 `(gen)`/`(gen-sig)` put both on the SCHEME — so the
--       cross-module use site must read the store that holds the scheme context, which
--       is exactly what the same-module use site reads one branch up.
--
-- ORDER: (1) then (3) then (2).  (1) stays first, so every SIGNED callee resolves exactly
-- as it did.  (3) precedes (2) because (3) is IMPORT-SCOPED and (2) is a program-global
-- bare-NAME table.  ⚠️ This rationale used to say (3) "is source-exact" and to justify the
-- disjointness by `currentImportDefinersRef` — which is (1)'s gate, not (3)'s; (3) reads
-- `importedSchemeOblsRef`.  The conclusion held, the stated reason did not, so here is the
-- real one: (3)'s table is rebuilt per module from THIS module's own `DUse` decls, and
-- `importDefinersOf` skipping `core` is irrelevant to it — what keeps prelude names out of
-- (3) is that no module writes a `DUse` for the implicit prelude at all, so no arm of
-- `importedSchemeOblEntries` ever emits one.  The populations are therefore disjoint by
-- construction, and the one case where both could answer — a user module exporting a name
-- core also defines — is exactly the case where the import-scoped answer is the right one.
declaredCrossModuleObls : String -> Option (List VecObl)
declaredCrossModuleObls x = match qualConstraintDecl x
  -- S-xmod-vector-supply (#1868/#1867): lookup (1) reads the WHOLE qual entry, not just
  -- its slots.  Reading the slots alone is what made this lookup the truncation point:
  -- `vecOblsOfSlots` lifted each slot to a ONE-argument obligation, so an imported
  -- `Ix a Bool =>` was re-checked as the unary goal `Ix Int` — which matched `impl Ix
  -- Int Char` and ACCEPTED an unsatisfiable program (#1868), and matched two impls and
  -- REJECTED a legal one (#1867).  The same-module branch one level up
  -- (`schemeObligationsRef`) has carried the full vector since #1161; this is the
  -- cross-module twin of that fact, and `substVecOblArgs` already knows how to
  -- instantiate it.
  Some d => Some (vecOblsOfSlotVecs (zipSlotVecs d.cdSlots d.cdArgs))
  None => match qualSchemeOblsFor x
    Some obs => Some obs
    None => omLookup x crossRun.value.coreSchemeObligationsRef.value

-- #1114 (#845): lookup (3) of declaredCrossModuleObls — the SCHEME context of a
-- cross-module callee, keyed by the LOCAL spelling this module writes.  The table is
-- `importedSchemeOblsRef`, rebuilt per module from THIS module's own `DUse` decls (see
-- `importedSchemeOblEntries`), so a hit is already source-exact: an entry exists only
-- because one of this module's imports names the module that defines it.
--
-- ⚠️ SPELLING-COMPLETE ON PURPOSE, and that is the whole reason this is a per-module
-- table rather than another `currentImportDefinersRef` gate.  `importDefinersOf` is
-- populated only from `UseGroup` (`importedBindings` answers `None` for `UseWild` and
-- `Some []` for `UseAlias`), so anything gated on it is a rule about ONE of the three
-- import spellings.  Measured on the pre-fix binary, all three cross-module spellings
-- dropped the obligation for an unsignatured constrained callee, and `import m.*` /
-- `import m as A` dropped it for a SIGNATURED one too — so gating this lookup the same
-- way would have drained exactly one cell of a 2x3 matrix and left the rule
-- spelling-matched, which is the shape #674/#1070 warn about.  Keying by the local
-- spelling covers all three arms with one rule and no per-spelling branch at the
-- READ site.
qualSchemeOblsFor : String -> Option (List VecObl)
qualSchemeOblsFor name = omLookup name perRun.value.importedSchemeOblsRef.value

-- lift each already-paired dict slot, WITH its recorded predicate argument vector, to a
-- vector obligation, skipping slots with no interface.
--
-- ⚠️ U1b (#1482) DELETED `shatterVecObls`, which is what used to stand here.  It took
-- an iface list and an id list as two arguments and zipped them, truncating on a
-- mismatch; the pairing now happens once, in `pairSlots`, so this function cannot be
-- handed a mispaired input at all.
--
-- 🚨 S-xmod-vector-supply (#1868/#1867): THE VECTOR IS THE POINT, and its absence here
-- was the whole cross-module gap.  This used to emit `voArgs = []` unconditionally — the
-- "shattered per-tyvar dict slots" reading of `funConstraintsRef` — which
-- `substVecOblArgs` then instantiates through `substMonos o.voIds`, i.e. ONE argument per
-- slot.  For a binary predicate that is not a weaker obligation, it is a DIFFERENT one:
-- `Ix a Bool` re-checked as `Ix Int`.  An empty vector still means exactly what it meant
-- (`voArgs = []` ⇒ the historical ids-only path), so a slot past the args prefix — an
-- inferred callee whose vector `registerInferredFor` could not recover, a module with no
-- args row — is byte-identically unchanged.
vecOblsOfSlotVecs : List (CSlot, List Mono) -> List VecObl
vecOblsOfSlotVecs [] = []
vecOblsOfSlotVecs ((s, v)::rest)
  | s.csIface.irName == "" = vecOblsOfSlotVecs rest
  | otherwise = xmodVecObl s v :: vecOblsOfSlotVecs rest

-- ONE cross-module slot's obligation.  🚨 THE ADMISSION RULE IS `declaredOblMixed`'S,
-- DELIBERATELY AND ARGUMENT-FOR-ARGUMENT — this is the same fact for an IMPORTED callee
-- that that function records for a same-module one, and a channel that admitted a wider
-- argument class on one side of a module boundary than the other would be a new
-- divergence, not a fix.  Exactly two classes carry:
--   * a BARE tyvar — `substOblArgs` maps it through the call's instantiation subst, and
--     an id that subst does not carry skips the whole predicate (fails CLOSED, as the
--     ids-only path always did);
--   * a GROUND argument — no tyvars anywhere, so the signature's mono IS the call's mono.
-- #1937 adds a THIRD class, in lockstep with the same widening on the two same-module
-- channels (`declaredOblMixed`, `residualMixedPred`) — the header's own argument is why
-- it could not land on one side alone:
--   * a STRUCTURED argument mentioning a tyvar (`Ix a (List b)`) — `substOblArgs` now
--     recurses through `TApp`/`TFun` and substitutes at every tyvar LEAF, so the
--     importer's goal is the instantiated `Ix Int (List Bool)` rather than the defining
--     signature's cell carried across the boundary.  A leaf id the subst does not carry
--     still skips the whole predicate, exactly as the bare class does.
-- A slot past the args prefix still falls back to `voArgs = []`, today's per-tyvar goal.
-- [voIds] holds the deferred-on ids IN ORDER, per `VecObl`'s invariant — NOT `[s.csId]`,
-- which is only the LEAD one and would understate a `Ix a b =>` vector.
xmodVecObl : CSlot -> List Mono -> VecObl
xmodVecObl s v
  | isEmptyL v || isEmptyL (flatMap xmodOblArgId v) =
    VecObl { voIface = s.csIface, voIds = [s.csId], voArgs = [] }
  | otherwise =
    VecObl { voIface = s.csIface, voIds = flatMap xmodOblArgId v, voArgs = v }

-- the ids a cross-module argument defers on: the id itself for a bare tyvar, every
-- tyvar leaf for a structured one (#1937), none for a ground one.  There is no
-- scheme-bound-id set on this side of the boundary, so unlike `declaredOblArgId` this
-- cannot filter — `substOblArgs`' fail-closed lookup is what refuses an id the call's
-- instantiation does not carry.
xmodOblArgId : Mono -> List Int
xmodOblArgId m = match normalize m
  TVar cell => [tyvarId cell]
  _ => monoTyvarIds m

-- map each (iface, scheme-var-id VECTOR) through the instantiation subst to this
-- call's monos, pushing ONE joint obligation per predicate onto the call channel
-- (`Windowed UObligation`, #838 I1).  [originId] is the occurrence's own #837 binding
-- id (threaded from instantiateVarTrackedId's [id] — the binding this re-instantiation
-- was deferred by; 0 = anchorless), stored on the record so a later increment (I2) can
-- read it without a second migration.  If ANY id is absent from the subst (shouldn't
-- happen for a quantified var) the whole predicate is skipped — a partial vector would
-- be a different predicate (#607).
recordSchemeCallObligations : Int -> List VecObl -> List (Int, Mono) -> Unit
recordSchemeCallObligations _ [] _ = ()
recordSchemeCallObligations originId (o::rest) subst = match substVecOblArgs o subst
  Some monos =>
    -- P1 (#1446) / U1b (#1482): `schemeObligationsRef` and its cross-module mirrors
    -- store `VecObl`, whose interface half is an identity-carrying `IfaceRef`, so this
    -- site no longer records `OriginUnresolved`.  It was the second of the two
    -- `ifaceRefBare` producers this unit retired.
    let _ = recordObl Predicate {
      iface = o.voIface,
      args = monos,
    } originId PSchemeReinst !currentLoc
    recordSchemeCallObligations originId rest subst
  None => recordSchemeCallObligations originId rest subst

-- #1161: this predicate's goal at THIS call's instantiation.  An ids-only entry
-- (`voArgs == []`) takes the historical `substMonos` path unchanged; a vector-carrying
-- entry maps its tyvar LEAVES through [subst] and keeps everything else as written.
-- `None` (an unmapped quantified id) still skips the whole predicate: a partial vector
-- is a different predicate (#607).
substVecOblArgs : VecObl -> List (Int, Mono) -> Option (List Mono)
substVecOblArgs o subst
  | isEmptyL o.voArgs = substMonos o.voIds subst
  | otherwise = substOblArgs o.voArgs subst

-- #1937 (structured predicate carry): this walk used to substitute ONLY at a TOP-LEVEL
-- `TVar` and pass anything else through untouched, which is why the admission pair
-- (`declaredOblArgOk`) could not admit a structured argument: `Conv (Wrap a) b` would
-- have carried the DEFINING signature's `a` cell into the caller's goal unsubstituted,
-- the wrong-but-concrete goal its header calls strictly worse than a missing one.  It
-- now recurses through `TApp`/`TFun` and substitutes at every `TVar` LEAF, so
-- `Conv (Wrap a) b` at a call instantiating `a := Char, b := Bool` becomes the goal
-- `Conv (Wrap Char) Bool` — the shape #1937 is about.  A leaf id absent from [subst]
-- still fails CLOSED for the whole predicate, exactly as the top-level arm always did.
substOblArgs : List Mono -> List (Int, Mono) -> Option (List Mono)
substOblArgs [] _ = Some []
substOblArgs (m::rest) subst = match substOblArg m subst
  None => None
  Some m2 => map (m2 :: _) (substOblArgs rest subst)

-- ONE predicate argument under [subst]: every tyvar leaf mapped, structure preserved.
substOblArg : Mono -> List (Int, Mono) -> Option Mono
substOblArg m subst = match normalize m
  TVar cell => lookupAssocI (tyvarId cell) subst
  TApp a b => match substOblArg a subst
    None => None
    Some a2 => map (b2 => TApp a2 b2) (substOblArg b subst)
  TFun a eff b => match substOblArg a subst
    None => None
    Some a2 => map (b2 => TFun a2 eff b2) (substOblArg b subst)
  other => Some other

-- the monos [ids] map to under [subst], in order; None if any id is unmapped.
substMonos : List Int -> List (Int, Mono) -> Option (List Mono)
substMonos [] _ = Some []
substMonos (id::rest) subst = match lookupAssocI id subst
  Some mono => map (mono :: _) (substMonos rest subst)
  None => None

-- #837: (name, id)-keyed lookup over schemeObligationsRef.  id /= 0 keys the
-- occurrence's binding EXACTLY; id == 0 falls to the bare-name scan (today's path).
lookupSchemeObls : String -> Int -> List ((String, Int), List VecObl) -> Option (List VecObl)
lookupSchemeObls x 0 table = lookupSchemeOblsByName x table
lookupSchemeObls _ _ [] = None
lookupSchemeObls x id (((n2, i2), v)::rest)
  | n2 == x && i2 == id = Some v
  | otherwise = lookupSchemeObls x id rest

-- name-only scan (first match) — the bare-name fallback and the display readers
-- (ppSchemeNamed / lookupSchemeIface) keep exactly this pre-#837 behaviour.
lookupSchemeOblsByName : String -> List ((String, Int), List VecObl) -> Option (List VecObl)
lookupSchemeOblsByName _ [] = None
lookupSchemeOblsByName x (((n2, _), v)::rest)
  | n2 == x = Some v
  | otherwise = lookupSchemeOblsByName x rest

-- Error-path B4: if [x] is a registered interface method, record this occurrence's
-- (post-instantiation) mono so checkImplObligations can verify a matching impl
-- exists once the dispatch type is resolved.  Returns the mono unchanged.  A
-- non-method name records nothing (the common case).  The marked path records the
-- same via inferMethodAt; the bare typecheck_main path records here.
recordImplObligation : String -> Mono -> Mono
recordImplObligation x mono
  -- A standalone shadow (a top-level funDef that reuses an interface-method name)
  -- resolves in-scope to that standalone, not the method — the scope-blind marker
  -- still rewrites its occurrences to EMethodAt, but a NO-IMPL receiver legitimately
  -- falls back to the standalone (resolveRLocalSite stamps RLocal), so there is no
  -- impl obligation.  Recording one surfaces a spurious `No impl of <Iface> for <T>`
  -- under checkImplObligations (the build path skips that check, so it only bites
  -- `check`).  Skip for EVERY standalone shadow — definer (`definerShadowNamesRef`)
  -- AND importer (an imported standalone; `standaloneValuesRef` holds both).  P0-18:
  -- this closes the `check`-side of the importer-shadow-on-a-no-impl-receiver residual
  -- (`size 3` where `size` is imported) which was REJECTED while `run` correctly
  -- returned the standalone.  Sound: the name genuinely has a standalone fallback, so
  -- a no-impl receiver is not an error — the route decides impl-vs-standalone per
  -- receiver; a receiver WITH an impl still dispatches (and that impl exists).
  -- Check BOTH refs: the single-file check path (checkProgram) sets only
  -- `definerShadowNamesRef`, while the multi-module path sets `standaloneValuesRef`
  -- (importer ∪ definer) — so either alone would miss one path's shadows.
  | contains x perRun.value.definerShadowNamesRef.value || contains x driverState.value.standaloneValuesRef.value =
    mono
  | otherwise = match omLookup x perRun.value.methodIfaceParamsRef.value
    None => mono
    Some (iface, typarams, mty, _) =>
      -- U1c (#1507): `iface`, NOT `ifaceRefBare iface.irName` — RESTORED, per the repo
      -- owner's ratified ruling.  The class a method-occurrence goal names is the
      -- interface that DECLARES the method the occurrence resolved to, carrying that
      -- `interface` declaration's I4 identity `(originModule, name)`
      -- (`docs/spec/DICT-SEMANTICS.md` §8 I4, `:1864`: identity is "assigned once
      -- where it is declared", and every occurrence is "resolved to one such identity"
      -- before entailment runs).  There is no competing "occurrence layer": an
      -- interface-name occurrence is *resolved to* a declaration identity, so
      -- `DImpl.implOrigin` and `DInterface.ifaceOrigin` are the SAME layer — one
      -- ASSIGNED once at the interface's own `interface` decl, one RESOLVED-TO at each
      -- occurrence (including this method's declaring interface, right here) — and
      -- comparing them is not a category error.
      --
      -- 🚨 A DO-NOT-RESTORE ban stood at this exact site from #1480 (withdrawn
      -- deliberately) until U1c landed.  Its premise was that `stampDeclOrigin`
      -- ("which module DECLARES this interface") and `fillIfaceOccOrigin`
      -- ("what did this occurrence RESOLVE to") are two stampers answering two
      -- INCOMPARABLE questions.  That premise was wrong: they answer the SAME
      -- question — "which interface declaration does this name denote" — from two
      -- vantage points that PRODUCE THE SAME VALUE wherever resolution has a unique
      -- answer, which `fillIfaceOccOrigin` (via `mapOriginsInDecl`, run in the same
      -- scope as every other occurrence stamp) guarantees for exactly the programs
      -- that reach this line.
      --
      -- ⚠️ "RESOLVE diagnoses every ambiguous case" is FALSE AS A BLANKET CLAIM, and an
      -- earlier revision of this paragraph said it anyway — refuted in one experiment,
      -- which is exactly the shape that licenses reinstating the ban, so the carve-out
      -- has to be explicit. MEASURED, both arms, two modules each declaring an
      -- interface with the same method name (`p.IP.mth`, `g.IG.mth`), merged into a
      -- third module via `export import p.{IP,mth}` + `export import g.{IG,mth}`: a
      -- DIRECT double import of the same name is what resolve catches
      -- (`Ambiguous occurrence: 'mth' is exported by both …`, `importedMethodEntry`'s
      -- own comment below); a RE-EXPORT MERGE of the same collision is not caught by
      -- resolve at all — `check` exits 0 or 1 depending on nothing but which of the two
      -- `export import` lines comes first in the re-exporting module, with NO
      -- diagnostic from resolve either way. In that shape `scopedMethodEntry` cannot
      -- decide it (`importedMethodEntry` sees two import-witnessed candidates, which
      -- is the SAME two-candidates shape the direct-import case rejects — but nothing
      -- upstream rejects it here), so `overrideScopedMethods` keeps the FLOOR's
      -- arbitrary last-registered answer, and this site silently inherits it. So: the
      -- two values disagree only in the ambiguous case, unambiguous cases genuinely
      -- agree, and a DIRECT import ambiguity genuinely is rejected upstream — but a
      -- RE-EXPORT-MERGE ambiguity is not, and reaches this site as the floor's
      -- arbitrary identity rather than as a diagnostic. The RULING survives this
      -- carve-out (an unambiguous occurrence's identity is still correct here, which is
      -- the property U1c is about); the flat "already rejected upstream" sentence does
      -- not, and is corrected to say so. Do NOT reinstate the ban on a bare assertion
      -- that the two layers are "different" — but do not cite "resolve already
      -- rejects the ambiguous case" as blanket cover either; it doesn't, for this
      -- shape. (Adjacent to the open #1288 re-export-merge family; not this unit's to
      -- fix.)
      --
      -- ⚠️ THIS IS NOT THE ONLY DECL-LAYER GOAL SITE, AND AN EARLIER VERSION OF THIS
      -- COMMENT SAID IT WAS ("the ONE goal producer … the other three are all
      -- OCCURRENCE layer").  That was true of the sites examined and FALSE OF THE SET.
      -- Census, re-derived here rather than relayed -- `grep -n builtinIfaceRef`:
      -- `recordIfaceObligation`, `inferNumLitBare`, `numCallObls` and `numDictObls`
      -- all build their goal from `builtinIfaceRef` -> `builtinClassOrigin` ->
      -- `builtinClassesRef`, and `builtinClassesGo` populates that table by reading
      -- `DInterface { ifaceOrigin }`.  FOUR more decl-layer goals, making the same
      -- cross-layer comparison this site was just cured of.
      --
      -- They are unreachable TODAY, and the reason is NOT that they are occurrence-
      -- layer -- it is that no user declaration can reach that table's population.
      -- MEASURED on both arms:
      --   * a module IN the import graph redeclaring one of the four spellings is
      --     rejected `Duplicate interface: Semigroup`, exit 1;
      --   * a module NOT in the graph is never loaded at all (it can contain arbitrary
      --     garbage and `check` still exits 0), so it contributes no `DInterface` to
      --     `builtinClassesGo`'s walk either;
      --   * a user `core.mdk` cannot shadow the prelude -- `import core.{n}` for a name
      --     only the user's file declares is unresolvable, exit 1.
      --
      -- 🚨 STANDING CONDITION.  Defect 1 RETURNS at those four sites if ANY of these
      -- changes: the duplicate-interface guard is relaxed; §7.1 U1 makes the prelude a
      -- node (at which point §8 I4 makes two same-spelled declarations legal, which is
      -- precisely what removes the guard); or a fifth `BuiltinClass` is added whose
      -- spelling the guard does not cover.  The safety here is a property of the
      -- LANGUAGE's current namespace rules, not of this channel.
      --
      -- MEASURED, and it is #1288's own reproduction verbatim: a `mid.mdk` doing
      -- `export import p.*` + `export import g.*` merges two unrelated `Same`
      -- interfaces, an importer's `impl Same P` gets `implOrigin = g` while the method
      -- `pmth` it defines belongs to `p.Same`, and the goal `TkIdent p Same` misses the
      -- impl's `TkIdent g Same` bucket.  Result: `No impl of Same for P` on a program
      -- whose `impl Same P` is three lines up, with no syntax available to say which
      -- `Same` was meant.  The bare compatibility leg does NOT cover this -- it protects
      -- goal-WITHOUT-identity against impl-WITH-identity, and this is
      -- goal-with-identity against impl-with-a-DIFFERENT-identity.
      --
      -- Two OTHER goal producers (`recordSigConstraintObls`,
      -- `recordMethodLevelSlotObls` via `constraintOrigin`, `reqToObligation` via
      -- `requireOrigin`) already carried identity before U1c (they never went through
      -- the bare-name detour this site did) -- filled by the SAME walk in the SAME
      -- scope as `implOrigin`, so they agree with it by construction. This site is the
      -- THIRD, and last, of the `ifaceRefBare` producers -- U1b retired the other two
      -- (`schemeObligationsRef`, `funConstraintIfacesRef`); see the census a few lines
      -- above and re-derive it with `grep -n ifaceRefBare` rather than trust a count.
      -- ⚠️ THAT IS NOT A CLAIM THAT THE `ImplUniverse` CHANNEL HAS ONLY THREE OR FOUR
      -- GOAL PRODUCERS TOTAL. It does not: `recordCallObligations`'s `PCallSlot`
      -- predicate (:7205, above), the `builtinIfaceRef`-derived sites named a few
      -- paragraphs up, and others besides all push a `Predicate` into the same channel
      -- -- a derived count of the WHOLE set is at least six. "Last of the three" here
      -- means only "last of the sites that ever minted `ifaceRefBare`", the narrow
      -- claim the census actually supports -- do not read it as "last of N total
      -- producers" for any N not independently re-derived.
      --
      -- U1c (#1507) closes the capability gap the retired ban's COST paragraph
      -- recorded: this site now discriminates METHOD-OCCURRENCE goals the same way
      -- the other three always did, so the #1438 collision shape reached through a
      -- bare method call (`p/pl`, `p/po` in the review corpus) is REJECTED, not
      -- silently accepted.  See `test/dict_fixtures/i4-xmod-method-occurrence-*` for
      -- the positive pair and `test/must_fail_fixtures/1507-…` (drained, removed).
      let _ = pushPendingObl iface typarams mty mono PMethodOcc !currentLoc
      -- #818 (#838 I3): also record each method-level `=>` constraint slot (e.g.
      -- `Ord b` on `peer : Ord b => a -> b -> b -> Bool`) as its OWN obligation, so an
      -- unsatisfiable slot (`Ord NoOrd`) is rejected by the unified checker at check
      -- time instead of silently becoming an RNone route (a wrong answer / segfault
      -- at run/build).  Recorded here so BOTH the check path (inferVarPlainId) and the
      -- emit path (inferMethodAt) — the two recordImplObligation callers — cover it.
      let _ = recordMethodLevelObls typarams mty mono
      mono

-- #816/#818 (#840 step 1): the shared shadow guard around method-occurrence
-- obligation recording.  A LAMBDA/PATTERN-BOUND local shadowing a method name
-- resolves to a MONOMORPHIC local scheme (`Forall [] []`); the scope-blind marker
-- still rewrote the occurrence to EMethodAt (emit path) — or it reaches
-- inferVarPlainId as a bare EVar (check path) — but it denotes the local, and
-- recording a method obligation for it invents a predicate on whatever the local's
-- var unifies with (a prelude default `filter p t = …` under a user `interface P`
-- whose method is named `p` recorded a phantom `P elem` obligation — which the #816
-- W3 survivor check then rejected as an undeclared constraint on the method's
-- element var).  Every genuine interface method quantifies at least its interface
-- parameter, so a mono scheme is never a real method occurrence.  (Top-LEVEL shadows
-- are already suppressed INSIDE recordImplObligation via
-- definerShadowNamesRef/standaloneValuesRef; this is the local-binding sibling.)
-- BOTH occurrence recorders — inferMethodAt (emit) and inferVarPlainId (check), the
-- only two recordImplObligation callers — share this guard so the #816 predicate
-- lands ONCE.  Takes the caller's ALREADY-INSTANTIATED [mono]; it must NOT
-- re-instantiate, because each caller's own instantiation carries tracked
-- side-effects (recordMethodDicts, recordSchemeCallObligations) that must fire
-- exactly once, at the call site.  [s] is that caller's own lookupVar scheme, tested
-- for monomorphism.  Returns [mono] unchanged in every case (recordImplObligation
-- always returns its argument), so the check path's return value is byte-identical.
recordMethodObligationGuarded : TcEnv -> String -> Scheme -> Mono -> Mono
recordMethodObligationGuarded env name s mono =
  if lookupLocalFlag env name || isMonoScheme s then
    mono
  else
    recordImplObligation name mono

-- #818 (#838 I3): record one PMethodLevel obligation per method-level `=>` constraint
-- slot of a method occurrence.  [mty] is the method's DECLARED type (with its `=>`);
-- [occMono] is THIS occurrence's instantiated (constraint-free) type.  Align the
-- declared function spine (constraints/effects stripped) against [occMono] with
-- matchTyMono to recover each constraint var's concrete mono, then record
-- `iface mono`.  matchTyMono captures the live tyvar cell, so a slot still a fresh
-- var at record time normalizes to its solved head at check time — a ground head
-- (`NoOrd`) with no impl hits the checker's RULE 1 reject; a still-generalized var
-- defers via RULE 2, uniform with every other obligation.  No slots ⇒ nothing
-- recorded (the receiver-only-method common case), and a shape mismatch (matchTyMono
-- None) records nothing — never a false reject.
recordMethodLevelObls : List String -> Ty -> Mono -> Unit
recordMethodLevelObls typarams mty occMono =
  let slots = methodLevelConstraintSlots typarams mty
  if isEmptyL slots then ()
  else match matchTyMono (stripLeadingMethodConstraints mty) occMono
    None => ()
    Some subst => recordMethodLevelSlotObls slots subst

recordMethodLevelSlotObls : List (String, IfaceRef) -> List (String, Mono) -> Unit
recordMethodLevelSlotObls [] _ = ()
recordMethodLevelSlotObls ((vname, iface)::rest) subst =
  let _ = match lookupAssoc vname subst
    Some m => recordObl Predicate {
      iface = iface,
      args = [m],
    } 0 PMethodLevel !currentLoc
    None => ()
  recordMethodLevelSlotObls rest subst

-- Expected-type propagation for an application whose argument is a lambda.
-- Inferring `andThen e (stream => Ok [JArray stream])` naively infers the lambda
-- BODY first with `stream : freshVar`, so a downstream conflicting use inside the
-- body (`JArray stream` wants `Array Json`) pins `stream` to the WRONG type before
-- the function's declared param type (`List Json`) is ever reconciled — the later
-- reconciliation then fails at the application with no good site, and the hover
-- side-channel records the wrong `stream` type.  Fix (bidirectional "checking"
-- mode, the do-bind/higher-order case): infer `f` first, peel its parameter type,
-- and unify it onto the lambda's parameter BEFORE inferring the body.  Then the
-- body sees `stream : List Json` and the type error localizes to the `JArray`
-- USE, and recordLocalBind captures the right hover type.  Purely additive: the
-- final `unify ft (TFun xt …)` in inferApp imposes the same equality regardless,
-- so the solution is unchanged — we only make it available earlier.
exprLoc : Expr -> Option Loc
exprLoc (ELoc l _) = Some l
exprLoc (EDoOrigin l _) = Some l
exprLoc _ = None

-- The span of an application's outermost argument (Bite 3): peel any ELoc
-- wrapper on the `EApp` head, then read the argument Expr's loc.  Non-EApp
-- shapes (never passed as `appExpr`) return None.
appArgLoc : Expr -> Option Loc
appArgLoc (ELoc _ e) = appArgLoc e
appArgLoc (EApp _ x) = exprLoc x
appArgLoc _ = None

inferAppExpr : TcEnv -> Expr -> Expr -> Mono
inferAppExpr env f x = match lamUnderLoc x
    Some (loc, pats, body) =>
      let ft = infer env f
      let _ = setLocIfSome loc
      -- ft is `(lamType) -> result`; its FIRST domain is the lambda's expected
      -- type.  Peel that, then peel the lambda type itself for its per-param types.
      let lamExpected = funDomain (normalize ft)
      let xt = inferLamChecked env (expectedParamTypes lamExpected (listLen pats)) pats body
      inferApp (envAlphaLets env) (EApp f x) ft xt
    None => match shadowStandaloneHead env f
      Some (mname, tagRefs) => inferShadowApp env mname tagRefs f x
      None => match definerShadowArgHead f
       Some (dname, dtagRef, dimplRef) => inferDefinerShadowApp env dname dtagRef dimplRef f x
       None => match definerShadowVarHead f
        Some dname => inferDefinerShadowVarApp env dname f x
        None =>
         let ft = infer env f
         let xt = infer env x
         -- P0-16: detect `f(1, 2)` on the PRISTINE ft (before inferApp unifies
         -- its domain with the tuple), then record the residual result so a
         -- downstream no-impl / mismatch can surface the tailored hint.
         let pend = tupleCallShapeHint f x ft
         let res = inferApp (envAlphaLets env) (EApp f x) ft xt
         let _ = match pend
           Some (help, fix) => (perRun.value.tupleCallCandidates := ((res, help, fix)::perRun.value.tupleCallCandidates.value))
           None => ()
         res

-- @Impl: if [x] is an `@Name` disambiguation hint (a bare `EVar "@Name"`, possibly
-- under an ELoc wrapper), return the name with the leading `@` stripped.  Mirrors
-- the two oracle arms `EApp(f, EVar h)` and `EApp(f, ELoc(_, EVar h))` with
-- `h.[0]='@'`.  Anything else → None → the ordinary application path.

-- Bug C (mirror lib/typecheck.ml:2293-2329): peel a single-argument application's
-- head to a standalone-shadow interface-method reference (`toList m` where `toList`
-- is BOTH a Foldable method AND an imported `Map` standalone).  Handles BOTH the
-- MARKED form (`EMethodAt`, the eval/build path — carries a route ref to stamp RLocal)
-- and the UNMARKED form (`EVar`, the `check` path — no route ref; the empty list).
-- Only fires for a SINGLE-param interface method whose name is a registered importer
-- shadow with a stashed standalone scheme — exactly the oracle's guard.  Everything
-- else (no shadow, multi-param iface, non-method head) returns None → the ordinary path.
shadowStandaloneHead : TcEnv -> Expr -> Option (String, List (Ref Route))
shadowStandaloneHead env (ELoc _ f) = shadowStandaloneHead env f
shadowStandaloneHead env (EMethodAt name tagRef _ _)
  | isShadowStandalone name = Some (name, [tagRef])
  | otherwise = None
shadowStandaloneHead env (EVar name)
  | isShadowStandalone name = Some (name, [])
  | otherwise = None
shadowStandaloneHead env (EVarId name _)
  | isShadowStandalone name = Some (name, [])
  | otherwise = None
shadowStandaloneHead _ _ = None

-- a name that is BOTH a registered importer shadow (standaloneValuesRef), has a
-- stashed standalone scheme, and names a single-TYPARAM interface's method.
--
-- ⚠️ IMPORTER side ⇒ singleTyparamIfaceMethod, NOT ifaceMethodName (#54).  Fork 1 keeps
-- the per-receiver rule here, and that rule keys the impl query on the receiver's head
-- tycon standing at the interface's ONE typaram.  A multi-typaram interface has no such
-- correspondence to key on -- `FromEntries c e`'s `fromEntries : List e -> c` does not
-- even take its first typaram as an argument -- so the importer arms stay scoped to the
-- single-typaram case.  The DEFINER arms do not: under the S2 inversion they never query
-- the impl universe at all, so they are typaram-agnostic (ifaceMethodName).
isShadowStandalone : String -> Bool
isShadowStandalone name = contains name driverState.value.standaloneValuesRef.value
  && isSome (lookupAssoc name perRun.value.shadowStandaloneSchemesRef.value)
  && singleTyparamIfaceMethod name

-- True iff [name]'s interface (in methodIfaceParamsRef) takes exactly ONE type
-- parameter -- the receiver-directed case the per-receiver IMPORTER rule (Fork 1) is
-- scoped to.
--
-- ⚠️ RENAMED from `singleParamIfaceMethod` (#54).  The old name said "single-PARAM
-- method" while the body counts interface TYPE PARAMS; it stated the opposite of what it
-- does and sent one agent down a wrong hypothesis (issue #54; SHADOW-SEMANTICS.md S8).
-- A two-PARAM method of a one-typaram interface (`comb : a -> a -> Int`, cell d7) passes
-- this predicate, and always did.
singleTyparamIfaceMethod : String -> Bool
singleTyparamIfaceMethod name = match omLookup name perRun.value.methodIfaceParamsRef.value
  Some (_, typarams, _, _) => listLen typarams == 1
  None => False

-- True iff [name] is a method of SOME visible interface, whatever its typaram arity --
-- the DEFINER-side gate (#54, closing S-3 / SHADOW-SEMANTICS.md row 26).
--
-- Under the S2 inversion a definer shadow denotes its module's own standalone
-- unconditionally: the impl universe is never consulted, so there is no receiver-to-
-- typaram correspondence to require, and gating the definer entry points on the typaram
-- COUNT only excused `interface Ix a i` from the machinery.  That excusal was the S-3
-- bug: d11 typed+emitted per-receiver (the OLD, pre-inversion semantics) while eval, which
-- has no route stamp to follow, resolved the bare name lexically to the standalone and
-- E-PANICked `unknown op '*'` on a `Box` -- an S7 path-agreement violation.
ifaceMethodName : String -> Bool
ifaceMethodName name =
  isSome (omLookup name perRun.value.methodIfaceParamsRef.value)

-- Bug C: type `toList m` for a no-impl receiver against the imported STANDALONE
-- scheme (giving the concrete result element type, e.g. `List (String, Int)`) and
-- stamp the route RLocal (when marked); if the receiver DOES have an impl (or its head
-- is not yet concrete) fall through to ordinary dispatch (typed against the method
-- scheme the env rebound the name to).  Mirror of lib/typecheck.ml:2308-2329.
--
-- ✅ S1-RESIDUAL-B CLOSED (2026-07-14).  This function used to have NO groundShadowReceiver
-- call, unlike its definer peer inferDefinerShadowApp (which P0-20 gave one).  An UNGROUNDED
-- receiver — a bare `Num` LITERAL is the everyday case, it is `Num a => a`, not `Int` — so
-- never reached the standalone arm below (headTyconMono is None) and fell to the
-- ordinary-app arm, which types against the METHOD scheme the env rebound the name to.
--
--   -- lib/prov.mdk:  export isEmpty : Int -> Bool
--   import lib.prov.{isEmpty}
--   main = println (debug (isEmpty 0))     -- Type mismatch: Int literal vs Int Int
--
-- The `Int Int` in that message is the tell: the PRELUDE's `Foldable.isEmpty : t a -> Bool`
-- is higher-kinded, so unifying `t a` with the literal's tyvar solved `t := Int, a := Int`.
-- The user's imported `isEmpty : Int -> Bool` was never consulted.  (Filed as "under-applies
-- on run" for a CONSTRAINED standalone; the root is broader — it breaks an UNCONSTRAINED one
-- at `check` too, whenever the shadowed method is higher-kinded.)
--
-- Fix, exactly as filed: ground an ungrounded receiver to the IMPORTED standalone's declared
-- domain BEFORE asking the S2 impl question, so typecheck and the post-inference route
-- resolver ask it about the SAME head.  That symmetry is the whole P0-20 lesson — a decision
-- derived twice, at two different times, over a receiver that changed in between.
--
-- ⚠️ NOT affected by the S2 inversion: an IMPORTER shadow keeps the per-receiver rule
-- (Fork 1).  Grounding only decides WHICH head the rule is applied to; a grounded head with
-- a live impl still dispatches (`isEmpty [1, 2]` → `Foldable.isEmpty`, fixture i4).
inferShadowApp : TcEnv -> String -> List (Ref Route) -> Expr -> Expr -> Mono
inferShadowApp env mname tagRefs f x =
  -- capture the application's loc BEFORE inferring the argument (which moves currentLoc),
  -- so a domain mismatch localizes to the call site, not the argument.
  let dloc = !currentLoc
  let tx = infer env x
  -- The dict-var carve-out (S5/Fork 2) applies to importer shadows too: a receiver that is
  -- the enclosing fn's `=>`-bound constraint var DISPATCHES through that dict, so it must
  -- NOT be ground to the standalone's domain (that would monomorphise the written signature).
  -- groundShadowReceiver is also inert on an already-grounded receiver, so i1/i3/i4 (all
  -- concrete receivers) are byte-identical.
  let _ = groundShadowReceiver (importerShadowDomain mname) tx (definerReceiverIsDictVar mname tx) dloc
  match headTyconMono tx
    -- ARCH B-2.1-g: the S2 impl question, off the GRAPH-GLOBAL substrate — see
    -- `ieImplExistsForHead`.  It used to read the cumulative topological PREFIX
    -- (`shadowKeyTableRef`), which made this answer depend on where in the module order
    -- the receiver's impl happened to sit.
    Some head => if ieImplExistsForHead perRun.value.bodyImplEnvRef.value mname head then inferApp (envAlphaLets env) (EApp f x) (inferShadowAppHead env f) tx
    else match lookupAssoc mname perRun.value.shadowStandaloneSchemesRef.value
      Some sscheme =>
        let smono = instantiate sscheme
        let r = freshVar ()
        let eff = openRow ()
        let _ = unify smono (TFun tx eff r)
        let _ = performEffect perRun.value.curEffect eff
        let _ = stampRoutes tagRefs
        -- S-1 (Fork D — the importer half): an IMPORTED constrained standalone shadowing
        -- a method breaks identically to a local one (its def is dict-passed in its own
        -- module; this call must supply the dicts).  Compute them off the head type we
        -- just unified, and defer the ROUTE stamp to resolveRLocalSites — stampRoutes
        -- above ran mid-inference, when the receiver is not yet solved, so it could only
        -- write `RLocal sym []`.  forceLocal=True: this arm has already committed the
        -- site's TYPE to the standalone, so its route is not open to re-derivation.
        let _ = recordImporterShadowDicts env mname tagRefs tx
        r
      None => inferApp (envAlphaLets env) (EApp f x) (inferShadowAppHead env f) tx
    None => inferApp (envAlphaLets env) (EApp f x) (inferShadowAppHead env f) tx

-- #411: infer an IMPORTER-shadow application's head with shadowHeadCtxRef flagged, so
-- maybeStandaloneValueMono's new importer arm does not pin an APPLIED occurrence to the
-- standalone scheme (which would kill per-receiver dispatch — Fork 1 / i4).  The definer
-- path has always bracketed its head this way (inferDefinerShadowApp); this is the peer
-- the importer path was missing, and the reason it could be missing before is that
-- nothing pinned importer value positions at all — which IS the #411 bug.
-- Save/restore, not set-False: a nested shadow head inside [f] must not clobber an outer
-- True on its way out (see inferDefinerShadowApp's bracket).
inferShadowAppHead : TcEnv -> Expr -> Mono
inferShadowAppHead env f =
  let saved = toggles.value.shadowHeadCtxRef.value
  toggles.value.shadowHeadCtxRef := True
  let ft = infer env f
  toggles.value.shadowHeadCtxRef := saved
  ft

-- S1-RESIDUAL-B: the IMPORTED standalone's declared domain — the first arrow domain of the
-- scheme stashed in shadowStandaloneSchemesRef (the concrete-head pick made per module by
-- checkModuleFullImpl).  The importer peer of shadowDomainFor's mangled arm, and it must NOT
-- be `lookupVar env mname`: env1 rebound the bare name to the interface METHOD, which is the
-- very scheme whose higher-kinded domain caused the bug.
--
-- None (⇒ grounding is a no-op) when the name has no stashed standalone scheme, or when that
-- standalone's own first parameter is itself polymorphic (`f : a -> Bool`) — unifying a bare
-- tyvar domain with an ungrounded receiver leaves it ungrounded anyway, so the caller's
-- headTyconMono still says None and the old ordinary-app arm runs, byte-identically.
importerShadowDomain : String -> Option Mono
importerShadowDomain mname = match lookupAssoc mname perRun.value.shadowStandaloneSchemesRef.value
  None => None
  Some s => match normalize (instantiate s)
    TFun a _ _ => Some a
    _ => None

-- S-1 (importer half): re-record each of the importer shadow's route refs as an
-- RLocalSite carrying the imported standalone's own constraint dicts, so
-- resolveRLocalSites re-stamps the ref post-inference with the dicts filled in.
-- forceLocal=True — inferShadowApp's standalone arm already committed the site's type.
-- Inert (no dicts, same RLocal stamp) for an unconstrained imported standalone.
recordImporterShadowDicts : TcEnv -> String -> List (Ref Route) -> Mono -> Unit
recordImporterShadowDicts _ _ [] _ = ()
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
recordImporterShadowDicts env mname (r::rest) tx =
  -- the IMPORTED standalone's scheme, NOT `lookupVar env mname` (which env1 rebound to
  -- the interface method) — see shadowStandaloneDictsWith.
  let dicts = shadowStandaloneDictsWith
    (lookupAssoc mname perRun.value.shadowStandaloneSchemesRef.value)
    mname
    (routeLocalSym !r)
    tx
  let _ = setRef perRun.value.pendingRLocalSites
    (PendingEntry mname r tx "" (SKRLocal (routeLocalSym !r) True dicts.sdMonos dicts.sdIfaces dicts.sdArgVecs) !currentLoc
      ::perRun.value.pendingRLocalSites.value)
  recordImporterShadowDicts env mname rest tx

-- P0-18: peel a single-argument application's head to a DEFINER-shadow interface-
-- method occurrence (the user's OWN top-level fn reuses a single-param interface
-- method name, e.g. this module's `size : Int -> Int` shadowing `Sizeable`'s
-- `size`).  Unlike importer shadows (shadowStandaloneHead / inferShadowApp), the
-- user's definition SHADOWS the method in scope, so the occurrence is typed against
-- the standalone scheme whose declared domain (`Int`) is NOT the actual receiver.
-- Returning the route ref lets inferDefinerShadowApp record the REAL argument mono
-- for per-receiver routing (`Box` has a `Sizeable` impl → method; `Int` → standalone).
-- P0-18 (importer residual): on the EMIT path a definer shadow's bare name is NOT
-- in definerShadowNamesRef when the standalone is IMPORTED from another module (that
-- ref is keyed on module-local funDefs).  But the mark pass ALREADY seeded such an
-- occurrence's route with the mangled standalone symbol (`RLocal <sym>`), so a
-- non-empty route symbol is an equally-good "this is a shadow" signal that works
-- cross-module.  Firing here routes the occurrence through inferDefinerShadowApp,
-- which types it against the standalone scheme and records the per-receiver mono —
-- so an importer shadow on a live-impl receiver dispatches to the impl, and one on a
-- no-impl receiver falls back to the standalone (RLocal <sym>), exactly like a
-- definer shadow.  On the un-mangled run/check path the route is RNone (sym ""), so
-- this branch is inert there and the ordinary definerShadowNames branch governs.
definerShadowArgHead : Expr -> Option (String, Ref Route, Ref (List Route))
definerShadowArgHead (ELoc _ f) = definerShadowArgHead f
-- ⚠️ #54: the two disjuncts carry DIFFERENT gates, because they serve different shadow
-- KINDS — this predicate is a Fork-1 boundary, not an arity test.  `isDefinerShadow` is
-- typaram-agnostic; `importerShadowOnEmitPath` is scoped to single-typaram interfaces (see
-- its header).  Spelling the definer disjunct as `isDefinerShadow` — rather than inlining
-- its conjuncts here — is deliberate: that function is ALSO what resolveRLocalSite routes
-- on, and "the typing entry point and the route stamper must apply the same gate" is the
-- P0-20 invariant.  Sharing the symbol makes them impossible to drift.
definerShadowArgHead (EMethodAt name tagRef implRef _)
  | isDefinerShadow name || importerShadowOnEmitPath name tagRef =
    Some (name, tagRef, implRef)
  | otherwise = None
definerShadowArgHead _ = None

-- L4 (xmod-identity #1351 spine, RUN-XMOD-022/026): the mark pass's own per-occurrence
-- verdict, named rather than left as an anonymous `routeLocalSym … /= ""` idiom.
-- `rewriteArgScoped`'s `sm` arm is the SOLE origin of a non-empty RLocal symbol on an
-- EMethodAt route (F8); every other RLocal stamp propagates that origin symbol
-- unchanged.  This is NOT a graph-wide fact and is NOT interchangeable with one: "The
-- signal is PER-OCCURRENCE, not graph-wide … keying on it (not on the whole-graph
-- standaloneValuesRef) is what keeps this from pinning the compiler's genuine
-- method-values and breaking dispatch" (this file, historically beside this site).
occurrenceCarriesMangledShadowSym : Ref Route -> Bool
occurrenceCarriesMangledShadowSym tagRef = routeLocalSym !tagRef /= ""

-- #54: the SECOND disjunct of definerShadowArgHead — the IMPORTER-on-emit signal, kept
-- separate because it carries a DIFFERENT gate from the definer one.  The mark pass seeds
-- an importer shadow's route with the provider's mangled standalone symbol, so a non-empty
-- route symbol says "this is a shadow" cross-module, where definerShadowNamesRef (keyed on
-- module-local funDefs) cannot.  It stays scoped to singleTyparamIfaceMethod because what
-- it feeds is Fork 1's per-receiver rule; the definer disjunct (isDefinerShadow) does not,
-- because the S2 inversion never queries the impl universe.  On the un-mangled run/check
-- path the route is RNone (sym ""), so this is inert there.
--
-- L4: this predicate now names its two conjuncts separately instead of conflating them in
-- one `routeLocalSym … /= ""` test.  `driverState.value.mangledFunDefsPresentRef.value`
-- (L3) is the GRAPH-level fact "this compile's decls carry mangled funDefs at all";
-- `occurrenceCarriesMangledShadowSym tagRef` is the mark pass's own PER-OCCURRENCE verdict
-- for THIS route.  The new graph-level conjunct is ADDED, not substituted for the
-- occurrence test — F7 (this file) forbids replacing the per-occurrence route test with a
-- graph-wide one: doing so would fire for occurrences the mark pass never marked, and
-- would pin genuine method-values, breaking dispatch.
--
-- 🚨 RUN-XMOD-045 CORRECTION (post-landing, slice-breaker finding) — REPLACES the
-- original "redundant-by-construction, F8" safety narrative below with the actual one.
-- F8's implication chain ("a non-empty route symbol implies the graph fact is True") is
-- still literally true, but it undersold what actually holds: `mangledFunDefsPresentRef`
-- is not merely implied True in that case, it is CONSTANT TRUE on every emit path,
-- unconditionally — see `graphCarriesMangledFunDefs`'s header for the mechanism
-- (`private_mangle.mdk:14-16` mangles core's own funDefs unconditionally, before this
-- flag is ever computed; measured ~70 `@mdk_<mid>__*` symbols in a feature-free build's
-- IR with zero shadows).  F8's phrasing hid its own precondition: it is only a
-- meaningful narrowing test if the flag CAN be False on some occurrence's compile, and
-- on the emit path it never is.  The actual safety property is therefore simpler and
-- stronger than "redundant, measured by a negative control": THE FLAG IS CONSTANT TRUE
-- THE MOMENT MANGLING RAN AT ALL, so its conjunct can never be what rejects an
-- occurrence the un-mangled reading of `occurrenceCarriesMangledShadowSym` would have
-- accepted — the predicate's real discriminator is still, and only, the
-- per-occurrence route symbol.
--
-- 🚨 THIS FACT CURRENTLY HAS NO DISCRIMINATING CONSUMER — L4's conjunct
-- (`mangledFunDefsPresentRef`) is constant-True on emit and its partner
-- (`occurrenceCarriesMangledShadowSym`) is always-empty off emit.  It is explicit
-- documentation of an implicit invariant, not a live condition.  Do not migrate a
-- reader onto it expecting it to select.  KEPT rather than reverted (owner ruling,
-- RUN-XMOD-045): provably zero-risk, and "this graph was mangled" is more readable
-- than the anonymous `routeLocalSym … /= ""` idiom it replaced, even though it cannot
-- currently narrow anything a build-time `medaka check`/`run`/`build` differential
-- could observe from outside the compiler.
importerShadowOnEmitPath : String -> Ref Route -> Bool
importerShadowOnEmitPath name tagRef = singleTyparamIfaceMethod name
  && driverState.value.mangledFunDefsPresentRef.value
  && occurrenceCarriesMangledShadowSym tagRef

-- P0-18: type `size (Box 3)` exactly as the ordinary path (against the standalone
-- scheme the env rebound `size` to, preserving program types), but record the
-- ACTUAL argument mono (`Box`) as this site's receiver so resolveRLocalSite routes
-- per-receiver: a receiver head WITH an impl of the shadowed interface dispatches to
-- the method (route left untouched → eval arg-tag / emit RKey), one WITHOUT an impl
-- stays the standalone (RLocal).  suppressRLocalRecord stops recordRLocalSite from
-- ALSO pushing the standalone's declared domain (which would mis-route `Box`→`Int`).
inferDefinerShadowApp : TcEnv -> String -> Ref Route -> Ref (List Route) -> Expr -> Expr -> Mono
inferDefinerShadowApp env name tagRef implRef f x =
  let sym = routeLocalSym !tagRef
  -- P0-19: capture the application's location BEFORE inferring the argument (which
  -- moves currentLoc), so a standalone-domain mismatch reports at the call site.
  let dloc = !currentLoc
  -- P0-19 d8 (S2/S6): infer the argument FIRST so the head scheme is chosen PER
  -- RECEIVER.  A receiver with a VISIBLE impl of the shadowed interface (impl universe
  -- is GRAPH-GLOBAL: ARCH B-2.1-g reads `bodyImplEnvRef` via `ieImplExistsForHead`)
  -- DISPATCHES → type
  -- 🚨 This note used to say "shadowKeyTableRef spans local ∪ imported ∪ prelude", and
  -- BOTH halves were wrong.  `SHADOW-SEMANTICS.md:242-245` RETIRES that phrase — "'local
  -- ∪ imported ∪ prelude' is NOT a synonym for graph-global … an older wording of S2 used
  -- it as one anyway" — and the table was narrower still: on the Module arm
  -- `shadowKeyTableRef` was the CUMULATIVE TOPOLOGICAL PREFIX, so it did not even span
  -- "imported" once the impl sat in a topologically later module.  Do not re-derive the
  -- retired claim from the old wording.
  -- the head against the METHOD scheme; else it is the STANDALONE.  Without this the
  -- mangled emit path (sym /= "") ALWAYS typed against the standalone scheme
  -- (`Int -> Int`), so a definer shadow whose impl is IMPORTED (`size (Box 3)`, d8)
  -- rejected `Int vs Box` at build/run instead of dispatching to the imported impl.
  let xt = infer env x
  -- P0-19 (constrained-receiver arm): an ungrounded receiver that is a dict-bound
  -- constraint var dispatches through that dict — it must neither be typed against the
  -- standalone scheme nor stamped RLocal (which would send eval/emit to the standalone
  -- and, e.g., apply `sz n = n + 1` to a Bool).
  let isDictVar = definerReceiverIsDictVar name xt
  -- P0-20: ground an ungrounded receiver to the standalone's declared domain BEFORE the
  -- dispatch decision, so typecheck asks the impl question about the SAME head the
  -- post-inference route resolver will.  See groundShadowReceiver.
  let _ = groundShadowReceiver (shadowDomainFor env name sym) xt isDictVar dloc
  let dispatches = definerReceiverDispatches name xt
  -- #158 PR4: SAVE/RESTORE the three toggles around the head computation (restore to the
  -- saved value, NOT unconditional False) so a nested definer-shadow head re-entering this
  -- bracket inside `ft` cannot clobber an outer True on its way out.
  let savedRLocal = toggles.value.suppressRLocalRecord.value
  let savedArgStamp = toggles.value.suppressArgStamp.value
  let savedShadowHead = toggles.value.shadowHeadCtxRef.value
  toggles.value.suppressRLocalRecord := True
  toggles.value.suppressArgStamp := True
  -- P0-19 d4b: this is an application head (marked EMethodAt on run/build) → keep the
  -- method scheme for per-receiver dispatch; suppress the value-position standalone pin.
  toggles.value.shadowHeadCtxRef := True
  -- P0-18: for the STANDALONE arm, type the head against the STANDALONE scheme.  On the
  -- un-mangled run/check path `infer env f` already resolves the bare name to the
  -- standalone (which shadows the method in scope).  On the EMIT path the bare name
  -- resolves to the interface METHOD scheme instead (the standalone was renamed to
  -- `<mid>__name`), whose result loses the concrete element type — e.g. Map's `toList`
  -- would type `List a` not `List (k, v)`, so a downstream `debug (toList m)` resolves
  -- the WRONG element dict and SIGSEGVs.  When we carry the mangled symbol, instantiate
  -- its (standalone) scheme directly so the impl-body types exactly as the run path
  -- does.  For the DISPATCH arm, type against the METHOD scheme (`definerShadowHeadType
  -- env ""`) so a live-impl receiver unifies and the result comes from the method.
  -- DISPATCH arm: the interface METHOD scheme, fetched EXPLICITLY from
  -- methodIfaceParamsRef (which spans imported interfaces) — NOT `infer env f`, because
  -- on the multi-module path the env rebinds the bare method name to the LOCAL
  -- standalone (`Int -> Int`), so inferMethodAt's lookupVar would hand back `Int -> Int`
  -- and reject a live-impl receiver (`Box`).  STANDALONE arm: the standalone scheme
  -- (mangled sym on the emit path preserves the concrete result type).
  let ft = if dispatches then shadowVarHeadMethodScheme env name f else definerShadowHeadType env sym f
  toggles.value.shadowHeadCtxRef := savedShadowHead
  toggles.value.suppressRLocalRecord := savedRLocal
  toggles.value.suppressArgStamp := savedArgStamp
  -- S-1: on the STANDALONE arm ONLY, compute that standalone's own `=>`-constraint
  -- dicts (and record its call obligations).  The DISPATCH arm typed `ft` against the
  -- interface METHOD scheme, whose dicts are the method's, not the standalone's — asking
  -- there would be meaningless.  A dict-var receiver dispatches through its dict and is
  -- likewise not the standalone.  ([], []) for an unconstrained standalone.
  let dicts = if dispatches || isDictVar then emptyShadowDicts
    else shadowStandaloneDicts env name sym xt
  -- Route by the ACTUAL argument type on BOTH the eval path (pendingRLocalSites,
  -- read by resolveRLocalSites) and the emit path (pendingArgStamps, read by
  -- resolveArgStamps — only recorded when this method arg-dispatches, i.e. on the
  -- build path).  xt grounds to the real receiver post-inference; the two default
  -- pushes (recordRLocalSite / recordArgStamp) that would carry the standalone's
  -- declared domain are suppressed above.
  -- ...EXCEPT for a dict-bound constraint-var receiver: resolveRLocalSite's ungrounded
  -- arm stamps RLocal unconditionally, which would route a genuine dict dispatch to the
  -- shadowing standalone.  Not recording the site leaves the route for ordinary dispatch
  -- (RNone → eval arg-tag / emit RKey via resolveArgStamps).
  -- P0-20: the route FOLLOWS THE ARM (`not dispatches` ⇒ forceLocal).  `ft` above has
  -- already committed this site's TYPE, so re-deriving its route from a receiver mono
  -- that may ground LATER (Num defaulting on an unsignatured standalone) is exactly how
  -- `check` and the binary came to disagree.  A dispatching receiver still re-derives
  -- (its head is already ground; RKey comes from resolveArgStamps on the emit path).
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op
  let _ = if isDictVar then ()
    else setRef perRun.value.pendingRLocalSites
      (PendingEntry name tagRef xt "" (SKRLocal (routeLocalSym !tagRef) (not dispatches) dicts.sdMonos dicts.sdIfaces dicts.sdArgVecs) !currentLoc
        ::perRun.value.pendingRLocalSites.value)
  let _ = match argDispatchOf name
    -- #609: the SKArg full mono is the DISPATCH arm's method scheme (`ft`) — the
    -- only arm whose route this stamp decides.  On the STANDALONE arm `ft` is the
    -- standalone's own scheme, which is not an interface-method occurrence at all;
    -- pass the receiver mono `xt` so ifaceParamMonos fails its shape match and the
    -- selector falls back to the singleton goal, exactly as before #609.
    Some _ => (perRun.value.pendingArgStamps := (PendingEntry name tagRef xt perRun.value.currentFn.value (SKArg implRef (if dispatches then ft else xt)) !currentLoc::perRun.value.pendingArgStamps.value))
    None => ()
  -- P0-19: on the UN-MANGLED path (sym == "") `ft` is the permissive METHOD scheme
  -- (`a -> Int`), so `inferApp ft xt` would accept ANY receiver.  When this
  -- occurrence resolves to the STANDALONE — a grounded receiver head with no visible
  -- impl of the shadowed interface, or an ungrounded receiver (S5) — impose the
  -- standalone's DECLARED domain on the argument, so a domain mismatch (`size "hi"`,
  -- or a wrapper generalized over the shadow receiver then called at a live-impl type)
  -- becomes a located reject instead of build-time garbage.  A grounded receiver WITH
  -- an impl still dispatches (no enforcement) — that arm is untouched.  On the mangled
  -- emit path (sym /= "") `ft` is already the standalone scheme (definerShadowHeadType),
  -- which enforces the domain itself, so this stays inert there.
  let _ = if sym == "" then enforceStandaloneDomain env name xt dloc else ()
  inferApp (envAlphaLets env) (EApp f x) ft xt

-- S1/S2 (THE INVERSION, 2026-07-14): is [name] a DEFINER shadow — a top-level fn defined in
-- THIS module that reuses a single-param interface method's name?  This is the exact
-- predicate that decides whether the inversion applies (Fork 1: definer-only).
--
-- ⚠️ It is NOT the same question as "did we reach inferDefinerShadowApp".  That entry point
-- (definerShadowArgHead) ALSO fires for an IMPORTER shadow on the mangled emit path, where
-- the mark pass seeded the route with the provider's mangled symbol (`routeLocalSym /= ""`)
-- — see its header.  Inverting on that signal would invert importer shadows too, which
-- Fork 1 forbids: it breaks the everyday `import map` pattern (`isEmpty [1,2]` must still
-- reach `Foldable.isEmpty`).  definerShadowNamesRef holds bare names on EVERY path — the
-- emit path recovers a mangled local funDef through the mangle map (buildDefinerShadows) —
-- and never holds an imported standalone, so it is the reliable definer/importer test.
--
-- The ifaceMethodName conjunct mirrors definerShadowVarHead / definerShadowArgHead's
-- definer disjunct verbatim, so every entry point agrees on which occurrences the
-- machinery owns.  ✅ S-3 / row 26 CLOSED (#54): a multi-TYPARAM interface
-- (`interface Ix a i`) is now IN scope.  The gate used to be singleParamIfaceMethod (a
-- typaram COUNT test), which excused `Ix a i` from every typing entry point and left its
-- occurrences to ordinary dispatch — check/build kept the pre-inversion per-receiver
-- answer while eval resolved the bare name lexically and E-PANICked (SHADOW-SEMANTICS.md
-- S8; the S7 violation d11 pinned).
isDefinerShadow : String -> Bool
isDefinerShadow name = ifaceMethodName name
  && contains name perRun.value.definerShadowNamesRef.value

-- S2 (THE INVERSION, 2026-07-14; SHADOW-INVERSION-DESIGN.md): True iff the shadow [name]
-- applied to a receiver of type [xt] should DISPATCH to the interface method rather than
-- call the standalone.
--
-- ⚠️ FOR A DEFINER SHADOW THE IMPL UNIVERSE IS NO LONGER CONSULTED.  It used to be: a
-- receiver whose head tycon had a visible impl of the shadowed interface dispatched, and the
-- standalone was only a FALLBACK for a no-impl head.  That rule silently ERASED the user's
-- function —
--
--   eq : List Int -> List Int -> Bool
--   eq a b = True
--   main = println (debug (eq [1] [2]))   -- printed False: `impl Eq List` won
--
-- — and `check --types` did not even report the user's signature.  Since the prelude declares
-- ~49 method names over every common type (`map`, `filter`, `length`, `compare`, `eq`, `min`,
-- `empty`, `toList`, `display`, …), that made the most natural names in the language into
-- landmines.  A top-level name written in a module is now THAT MODULE'S NAME: a definer
-- shadow is the standalone, unconditionally, and the argument must type against the
-- standalone's declared domain (a mismatch is a located reject — S2/S3/S6).
--
-- The ONE carve-out (S5, Fork 2): a receiver that is a dict-bound `=>` constraint var of the
-- enclosing function still DISPATCHES.  Writing `Sz a => …` is an explicit, written-down
-- request to resolve through the interface, and there is currently no other way to name the
-- method inside a shadowing module (SHADOW-SEMANTICS.md §1.1).  A grounded head never
-- normalizes to a TVar, so it correctly answers False for every concrete receiver.
--
-- An IMPORTER shadow reaching here (via definerShadowArgHead's mangled-sym arm) keeps the
-- OLD per-receiver rule — Fork 1.
definerReceiverDispatches : String -> Mono -> Bool
definerReceiverDispatches name xt
  | isDefinerShadow name = definerReceiverIsDictVar name xt
  | otherwise = match headTyconMono xt
    -- ARCH B-2.1-g: graph-global, off `bodyImplEnvRef` — see `ieImplExistsForHead`.
    -- The guard above means only the Fork-1 IMPORTER arm reaches here.
    Some head =>
      ieImplExistsForHead perRun.value.bodyImplEnvRef.value name head
    None => definerReceiverIsDictVar name xt

-- P0-19 (constrained-receiver arm): True iff an UNGROUNDED definer-shadow receiver is
-- one of the ENCLOSING group's `=>`-constraint variables for the SHADOWED interface (or
-- a superinterface of it).  Such an occurrence dispatches through that dict — it is a
-- METHOD call, not the standalone — so it must be typed against the method scheme and
-- must NOT have the standalone's declared domain imposed on it.
--
-- Without this, ANY constrained function that calls the method on its own dict-bound
-- var, in a program where some top-level fn shadows that method's name, is silently
-- monomorphised to the shadow's domain.  That includes the PRELUDE's own bodies: on the
-- flat single-file path `prog` is core ++ user, so a user `eq : Int -> Int -> Int`
-- made core's `neq : Eq a => a -> a -> Bool` (`neq x y = not (eq x y)`) infer `eq x y :
-- Int` and reject with `Type mismatch: Bool vs Int` at the top of the user's file.
definerReceiverIsDictVar : String -> Mono -> Bool
definerReceiverIsDictVar name xt = match normalize xt
  TVar cell => match omLookup name perRun.value.methodIfaceParamsRef.value
    Some (mIface, _, _, _) => dictVarSatisfiesIface mIface.irName (tyvarId cell) perRun.value.groupConstraintMonosRef.value
    None => False
  _ => False

-- does any of the group's constraint vars BOTH normalize to tyvar [id] AND carry an
-- interface whose (self + transitive supers) closure includes [mIface]?
dictVarSatisfiesIface : String -> Int -> List (String, Mono) -> Bool
dictVarSatisfiesIface _ _ [] = False
dictVarSatisfiesIface mIface id ((cIface, cm)::rest)
  | monoIsTyvarId cm id && contains mIface (ifaceSelfAndSupers cIface) = True
  | otherwise = dictVarSatisfiesIface mIface id rest

monoIsTyvarId : Mono -> Int -> Bool
monoIsTyvarId m id = match normalize m
  TVar cell => tyvarId cell == id
  _ => False

-- [iface] plus its transitive `requires` supers (a `Ord a =>` constraint also supplies
-- the `Eq` dict).  Reads superDeclsRef, the program's interface decls; NOT gated on
-- userIfaceNamesRef (unlike superSlotsOf, whose gate is about dict SLOTS, not about
-- which interfaces a constraint satisfies) — a PRELUDE super chain satisfies the
-- superinterface just as much, it is simply serviced by arg-tag dispatch.
ifaceSelfAndSupers : String -> List String
ifaceSelfAndSupers iface = supersFix [iface] [iface]

supersFix : List String -> List String -> List String
supersFix acc [] = acc
supersFix acc frontier =
  let next = removeAllS acc (dedup (flatMap directSupers frontier))
  supersFix (acc ++ next) next

directSupers : String -> List String
directSupers iface = match ifaceSupersOf driverState.value.superDeclsRef.value iface
  None => []
  Some (_, supers) => map superIfaceName supers

superIfaceName : Super -> String
superIfaceName (Super { superHead = n }) = n

-- P0-19: impose a definer-shadow standalone's declared domain on the actual argument
-- [xt] WHEN the occurrence resolves to the standalone (RLocal).  No declared signature ⇒
-- nothing to enforce (permissive fallback, unchanged).  [dloc] re-points currentLoc at the
-- application so a mismatch localizes to the call, not the argument.
--
-- S2 (THE INVERSION): a definer shadow now ALWAYS resolves to the standalone, so its domain
-- is ALWAYS enforced.  This used to skip enforcement whenever the receiver's grounded head
-- had a visible impl of the shadowed interface — that head dispatched, so no domain applied.
-- That skip is precisely what let `eq [1] [2]` sail through `check` against the PRELUDE's
-- `Eq.eq` while the user's `eq : List Int -> List Int -> Bool` was discarded.  The only
-- surviving exemption is the Fork-2 dict-var carve-out: imposing a concrete domain on the
-- enclosing group's `=>`-constraint var would monomorphise its written signature.
enforceStandaloneDomain : TcEnv -> String -> Mono -> Option Loc -> Unit
enforceStandaloneDomain _ name xt dloc = match standaloneShadowDomain name
  None => ()
  Some dom =>
    if definerReceiverIsDictVar name xt then
      ()
    else
      unifyStandaloneDomain dom xt dloc

-- P0-20 (SILENT WRONG ANSWER, `eq 1 2` → the binary printed 0): typecheck's
-- dispatch-vs-standalone decision and the POST-inference route resolver
-- (resolveRLocalSite) must ask the S2 impl question about the SAME receiver head.
--
-- They did not.  A definer-shadow receiver that is not yet grounded AT INFERENCE TIME —
-- a NUMERIC LITERAL is the everyday case, it is `Num a => a`, not `Int` — took the
-- ungrounded arm (S5 ⇒ standalone) and was typed against the standalone's scheme.  That
-- typing then UNIFIES the standalone's declared domain into the receiver, so by the time
-- resolveRLocalSite runs the receiver IS grounded — to `Int` — and `Int` has `impl Eq
-- Int`, so the route resolver left the site to DISPATCH.  Result: `check` typed
-- `eq 1 2 : Int` (the user's `eq : Int -> Int -> Int`) while eval/emit called the
-- interface method and produced a `Bool` — `run` panicked (`intToString: not an Int`)
-- and `build` SILENTLY PRINTED 0.  Only literal receivers were affected: `f k = eq k 1`
-- (k : Int, already grounded) dispatched consistently on all three paths.
--
-- Fix: perform S5's monomorphisation FIRST (it is the same unification the standalone
-- arm would have done, only earlier), then decide.  With the receiver grounded to `Int`,
-- S2 sees the impl and DISPATCHES on every path — check == run == build.  A grounded
-- receiver, a dict-bound one, and an unsignatured standalone (no domain to ground to)
-- are all untouched; so is a standalone whose domain head has NO impl of the shadowed
-- interface (map's `toList : Map k v -> …` — there is deliberately no `impl Foldable
-- Map`), which is every definer shadow in the tree.
--
-- [dom] MUST come from shadowDomainFor, not standaloneShadowDomain: on the MANGLED emit
-- path the standalone was renamed `<mid>__eq`, so the bare-name sig table is empty there
-- and grounding would be silently inert — which is not a no-op, it flips the emit path to
-- the STANDALONE arm while check/run dispatch.  (Observed: `build` printed 3, `run`
-- printed False.)  Same bug, other direction.
groundShadowReceiver : Option Mono -> Mono -> Bool -> Option Loc -> Unit
groundShadowReceiver dom xt isDictVar dloc
  | isDictVar = ()
  | isSome (headTyconNameMono xt) = ()
  | otherwise = match dom
    None => ()
    Some d => unifyStandaloneDomain d xt dloc

-- P0-20: the definer-shadow standalone's declared domain, resolved on EITHER path.
-- Un-mangled run/check (sym == ""): the module's own sig table, keyed by the bare name.
-- Mangled emit (sym /= ""): private_mangle renamed the standalone to `<mid>__name`, so
-- definerShadowSigsRef has no `name` entry — take the domain off the env binding for the
-- mangled symbol, which is the very scheme definerShadowHeadType types this site against.
shadowDomainFor : TcEnv -> String -> String -> Option Mono
shadowDomainFor _ name "" = standaloneShadowDomain name
shadowDomainFor env _ sym = match lookupVar env sym
  None => None
  Some s => match normalize (instantiate s)
    TFun a _ _ => Some a
    _ => None

-- unify the standalone domain against the argument at the call's location.
unifyStandaloneDomain : Mono -> Mono -> Option Loc -> Unit
unifyStandaloneDomain dom xt dloc =
  currentLoc := dloc
  unify dom xt

-- a definer-shadow standalone's declared parameter type, freshly instantiated (so a
-- polymorphic standalone domain does not leak vars across sites).  None when there is
-- no top-level signature, or the signature is not a function type.
standaloneShadowDomain : String -> Option Mono
standaloneShadowDomain name = match lookupAssoc name perRun.value.definerShadowSigsRef.value
  None => None
  Some ty => match normalize (instantiate (sigToScheme ty))
    TFun a _ _ => Some a
    _ => None

-- P0-19 d4b (S4): a definer-shadow occurrence in bare VALUE position (NOT the head of
-- its own application — shadowHeadCtxRef is False) denotes the STANDALONE.  Returns the
-- standalone's declared scheme freshly instantiated so a HOF sees `Int -> Int`, not the
-- permissive method scheme `a -> Int` — making `map size [Box …]` a located reject
-- (Box vs Int) while `map size [1,2,3]` still accepts.  Only fires for a single-param
-- interface-method name that is a module-local standalone WITH a declared signature;
-- everything else (app head, non-shadow, unsignatured standalone) returns None → the
-- ordinary env lookup / method scheme, unchanged.
-- #411 (row 21, S4): the IMPORTER half of the same cell.  S4 is not keyed on where the
-- standalone lives — a value-position shadow denotes the standalone whether this module
-- DEFINED it or IMPORTED it — so the definer arm below is followed by the importer arm,
-- reading the imported standalone's scheme out of shadowStandaloneSchemesRef (the same
-- scheme inferShadowApp's standalone arm uses, so `check` and the applied path cannot
-- drift).  That ref is populated ONLY on the Module path (checkModuleFullImpl), so the
-- single-file Flat path finds it empty → None → byte-identical.
--
-- ⚠️ FORK 1 IS NOT TOUCHED.  This arm is gated on shadowHeadCtxRef = False, i.e. bare
-- VALUE position only; every APPLIED importer occurrence goes through inferShadowApp,
-- which now flags its head (inferShadowAppHead) exactly as the definer path always did.
-- So per-receiver importer dispatch (i4's `isEmpty [1, 2]` → `Foldable.isEmpty`) is
-- unchanged — rows 15-20/22 do not move.
--
-- #54: the definer arm is gated on ifaceMethodName (typaram-agnostic) and the importer arm
-- on singleTyparamIfaceMethod (Fork 1's per-receiver scope) — the guards are now per-arm,
-- where they used to share one leading singleParamIfaceMethod test.
maybeStandaloneValueMono : String -> Option Mono
maybeStandaloneValueMono name
  | toggles.value.shadowHeadCtxRef.value = None
  | ifaceMethodName name && contains name perRun.value.definerShadowNamesRef.value = standaloneShadowScheme name
  | not (singleTyparamIfaceMethod name) = None
  | otherwise = importerStandaloneValueScheme name

-- #410/#669 (S4, EMIT path only): the sym-recovering peer of maybeStandaloneValueMono,
-- for the marked (EMethodAt) value-position occurrence whose bare name maybeStandaloneValueMono
-- can no longer see because the mangler renamed the definer standalone's funDef to
-- `<mid>__name`.  The signal is PER-OCCURRENCE, not graph-wide: rewriteArgScoped (:7937)
-- seeds the tagRef route with `RLocal <mangled>` for EXACTLY the value-position standalone
-- shadows (the `sm` mangled-shadow map), while an ordinary return/arg-position method value
-- gets `RNone` — so a non-empty routeLocalSym is the mark pass's own "this occurrence is a
-- standalone shadow" verdict, and keying on it (not on the whole-graph `standaloneValuesRef`)
-- is what keeps this from pinning the compiler's genuine method-values and breaking dispatch.
-- The scheme is recovered by `standaloneSchemeFor`: an IMPORTER shadow via
-- shadowStandaloneSchemesRef, a DEFINER shadow via the env under that mangled sym — the same
-- accessor recordRLocalSite already trusts to compute this site's RLocal dicts.  Value-position
-- ONLY (shadowHeadCtxRef False, mirroring maybeStandaloneValueMono's first guard); an
-- application head is bracketed True by inferShadowAppHead / inferDefinerShadowApp and keeps
-- ordinary per-receiver dispatch.  None (⇒ caller keeps the method scheme) when the route
-- carries no mangled sym, or when the standalone scheme is unavailable.
-- ⚠️ #724: the gate is PER SHADOW KIND (emitValueShadowGate), mirroring the check-path
-- maybeStandaloneValueMono's per-arm split exactly — NOT one blanket singleTyparamIfaceMethod.
-- The classifier is isDefinerShadow (`contains name definerShadowNamesRef`, the SAME test the
-- check path uses), NOT shadowStandaloneSchemesRef membership: that ref is standaloneSchemeFor's
-- scheme-SOURCE selector and an importer occurrence is not reliably in it at this pin, so keying
-- on it mis-grounds i10's multi-typaram importer app head to a garbage-pointer build.
--   • DEFINER arm (isDefinerShadow): typaram-agnostic, mirroring the check-path definer arm
--     (which grounds a MULTI-typaram definer value position — #724's exact skew: check grounded,
--     emit declined, so `map size [1,2,3]` stamped a null Display element dict and SIGSEGVd).
--     Safe at multi-typaram width because a DEFINER app head is ALWAYS bracketed: it is caught
--     by definerShadowArgHead's isDefinerShadow disjunct (typaram-agnostic) →
--     inferDefinerShadowApp, which sets shadowHeadCtxRef True and types the head via
--     shadowVarHeadMethodScheme / definerShadowHeadType — NEVER through inferMethodAt.  So the
--     only definer occurrence reaching here with shadowHeadCtxRef False is a genuine value
--     position, which is precisely what must ground (d22z is the app-head control).
--   • otherwise (importer / non-shadow): singleTyparamIfaceMethod is REQUIRED, not incidental.
--     At MULTI-typaram width the importer app-head path (`get (Box 3) 1`, interface `Ix a i`,
--     i10) uses ORDINARY dispatch, so an app head can reach inferMethodAt with shadowHeadCtxRef
--     False AND a mangled route sym — indistinguishable from a value position by those two
--     signals alone.  The check-path importer arm is singleTyparamIfaceMethod-gated (Fork 1)
--     for exactly this reason; keeping the guard here leaves i10's per-receiver dispatch
--     (4 then 3) intact.  Sz/Sizeable are single-typaram, so #410/#669 still pin.
--
-- #410/#669 DIRECTION-2 (deliberately NOT taken): the alternative floor was to leave the type
-- alone and instead make a container element route that resolves to RNone from a genuinely-free
-- var a LOUD `T-AMBIGUOUS-INSTANCE` rather than a silent null dict.  Rejected: an empty
-- container's RNone element is BENIGN (never dereferenced) — `main = println []` is a VALID
-- program that stamps exactly that RNone element — so a fail-loud rule would reject valid code,
-- and the `Undetermined`/KeepNone design (:9899) forbids element-position errors for this reason.
-- Grounding the shadow occurrence's TYPE here (direction 1) closes the actual SIGSEGV vector at
-- its source without that hazard, so the loud-floor was not needed.
maybeStandaloneValueMonoEmit : TcEnv -> String -> Ref Route -> Option Mono
maybeStandaloneValueMonoEmit env name tagRef
  | toggles.value.shadowHeadCtxRef.value = None
  | routeLocalSym !tagRef == "" = None
  | not (emitValueShadowGate name) = None
  | otherwise =
    map instantiate (standaloneSchemeFor env name (routeLocalSym !tagRef))

-- #724: the per-shadow-kind gate for the emit-path value-position pin, mirroring the
-- check-path maybeStandaloneValueMono's per-arm split (definer arm typaram-agnostic; importer
-- arm singleTyparam-scoped, Fork 1).  The definer/importer classifier is isDefinerShadow —
-- `contains name definerShadowNamesRef`, which holds BARE names on EVERY path (the emit path
-- recovers the mangled local funDef through the mangle map, buildDefinerShadows) and NEVER
-- holds an imported standalone, so it is the reliable test (its header, :5717).  ⚠️ It is NOT
-- shadowStandaloneSchemesRef membership: that ref is standaloneSchemeFor's SCHEME-SOURCE
-- selector, not a definer/importer classifier — an importer occurrence is not reliably in it
-- at this pin, so keying on it mis-grounded i10's multi-typaram importer APP head to a
-- garbage-pointer build (the P0-20 shape).
--   • DEFINER shadow (isDefinerShadow): admit typaram-agnostically.  Safe at multi-typaram
--     width because a definer app head is ALWAYS bracketed by inferDefinerShadowApp
--     (definerShadowArgHead's isDefinerShadow disjunct fires typaram-agnostically), so it
--     reaches maybeStandaloneValueMonoEmit with shadowHeadCtxRef True and is declined by that
--     function's first guard — the ONLY definer occurrence reaching the pin with
--     shadowHeadCtxRef False is a genuine value position, which is what must ground.
--   • otherwise (importer or non-shadow): keep singleTyparamIfaceMethod — a MULTI-typaram
--     importer app head (`get (Box 3) 1`, i10) uses ORDINARY dispatch and is NOT bracketed,
--     so it too can reach the pin with shadowHeadCtxRef False and a mangled route sym; the
--     singleTyparam gate is what keeps it (and its per-receiver dispatch, 4 then 3) intact,
--     exactly as the check-path importer arm does.
emitValueShadowGate : String -> Bool
emitValueShadowGate name
  | isDefinerShadow name = True
  | otherwise = singleTyparamIfaceMethod name

-- #411: is [name] an occurrence whose TYPE maybeStandaloneValueMono pins to the
-- standalone?  ⭐ THE ROUTE MUST FOLLOW THE ARM (the P0-20 lesson): a site typed against
-- the standalone must ROUTE to the standalone, or type and route disagree — which is this
-- arc's recurring bug class.  So recordRLocalSite stamps such a site forceLocal, skipping
-- resolveRLocalSite's per-receiver query entirely.  Under S4 there is no receiver to
-- dispatch on, so the query was never meaningful for a value position in the first place.
--
-- For a DEFINER shadow this is behavior-preserving both ways: resolveRLocalSite's grounded
-- arm already forced RLocal (`not (isDefinerShadow name)` is False ⇒ stampRLocalOrFallback
-- False), and its ungrounded arm already stamped RLocal for definerShadowNamesRef members.
-- For an IMPORTER shadow it is the #411 fix: the grounded arm used to let a live impl steal
-- the value (row 21b), and the ungrounded arm left the route UNSTAMPED (row 21a) — which is
-- why eval arg-tag-dispatched into the Box impl and the emitter, having no standalone
-- fallback, panicked `no impl of method 'size' for type 'Int'`.
--
-- Mirrors maybeStandaloneValueMono's guards exactly; keep the two in lockstep.
standaloneValuePinned : String -> Bool
standaloneValuePinned name
  | toggles.value.shadowHeadCtxRef.value = False
  | ifaceMethodName name && contains name perRun.value.definerShadowNamesRef.value = isSome (standaloneShadowScheme name)
  | not (singleTyparamIfaceMethod name) = False
  | otherwise = isSome (importerStandaloneValueScheme name)

-- #411: the IMPORTED standalone's full scheme, freshly instantiated (`Int -> Int`), for a
-- bare value-position occurrence.  Peer of standaloneShadowScheme's definer arm; None when
-- the name is not an importer shadow of this module, leaving the ordinary env lookup (the
-- permissive method scheme) exactly as before.
importerStandaloneValueScheme : String -> Option Mono
importerStandaloneValueScheme name =
  map
    instantiate
    (lookupAssoc name perRun.value.shadowStandaloneSchemesRef.value)

-- P0-19: a definer-shadow standalone's full declared scheme (`Int -> Int`), freshly
-- instantiated.  None when the standalone has no top-level signature (nothing to pin —
-- the permissive fallback stays).  Used both for value-position pinning (d4b) and to
-- type a standalone-fallback application against the standalone's result type (d8).
standaloneShadowScheme : String -> Option Mono
standaloneShadowScheme name = map
  (ty => instantiate (sigToScheme ty))
  (lookupAssoc name perRun.value.definerShadowSigsRef.value)

-- P0-19: peel an application head to a definer-shadow interface-method occurrence on
-- the UN-MARKED path (the `check` pipeline runs no marker, so the head is a bare
-- `EVar`, not the `EMethodAt` that definerShadowArgHead matches on run/build).  Same
-- guard as definerShadowArgHead's DEFINER disjunct: an interface method (of an interface
-- of ANY typaram arity, #54) whose name is a module-local standalone
-- (definerShadowNamesRef).
definerShadowVarHead : Expr -> Option String
definerShadowVarHead (ELoc _ f) = definerShadowVarHead f
definerShadowVarHead (EVar name)
  | ifaceMethodName name && contains name perRun.value.definerShadowNamesRef.value = Some name
  | otherwise = None
definerShadowVarHead (EVarId name _)
  | ifaceMethodName name && contains name perRun.value.definerShadowNamesRef.value = Some name
  | otherwise = None
definerShadowVarHead _ = None

-- S2 (THE INVERSION): type an un-marked (check-path) definer-shadow application against
-- the module's OWN standalone, unconditionally.  Peer of inferDefinerShadowApp (the marked
-- run/build path); the two must agree cell-for-cell or `check` and the binary diverge (S7),
-- which is the bug class this whole arc keeps producing.
--
-- The receiver's impl universe is no longer consulted (see definerReceiverDispatches).  The
-- sole dispatch arm left is the Fork-2 carve-out: a dict-bound `=>` constraint var, which is
-- an explicit written request to resolve through the interface.  Everything else — grounded
-- live-impl head included — types against the LOCAL standalone scheme, so a domain mismatch
-- (`size (Box 3)` against `size : Int -> Int`) is a located reject at the call, not a silent
-- dispatch that erases the user's function.
inferDefinerShadowVarApp : TcEnv -> String -> Expr -> Expr -> Mono
inferDefinerShadowVarApp env name f x =
  let dloc = !currentLoc
  let xt = infer env x
  let isDictVar = definerReceiverIsDictVar name xt
  -- P0-20: ground an ungrounded receiver to the standalone's declared domain BEFORE the
  -- dispatch decision (see groundShadowReceiver).  Still load-bearing under the inversion:
  -- it is what gives a bare `Num` literal receiver (`eq 1 2`) the standalone's domain
  -- rather than leaving it open for Num-defaulting to ground LATER, behind typecheck's back.
  let _ = groundShadowReceiver (standaloneShadowDomain name) xt isDictVar dloc
  if isDictVar then
    inferApp (envAlphaLets env) (EApp f x) (shadowVarHeadMethodScheme env name f) xt
  else
    inferDefinerStandaloneVarApp env name f x xt dloc

-- P0-19 (d8 dispatch arm): the interface METHOD scheme for [name], from
-- methodIfaceParamsRef (which spans imported interfaces) so per-receiver dispatch works
-- even when the multi-module env has rebound the bare name to the local standalone.
-- Falls back to `infer env f` (flagged as an app head so maybeStandaloneValueMono does
-- not pin it) when the method type is unavailable.
shadowVarHeadMethodScheme : TcEnv -> String -> Expr -> Mono
shadowVarHeadMethodScheme env name f = match omLookup name perRun.value.methodIfaceParamsRef.value
  -- #822: this elaborates an interface METHOD type, so it must use the stored graded
  -- scope.  Unscoped (`sigToScheme ty`) a graded method's index came out as a plain
  -- tyvar here while its real scheme has a row there, and `unify` binds the two without
  -- complaint — a silent divergence between two elaborations of the SAME signature.
  -- Co-locating the scope with `ty` is what makes this a one-token fix instead of a
  -- second lookup that could disagree.
  Some (_, _, ty, scope) => instantiate (fst (sigToSchemeTvsIn scope ty))
  None =>
    -- #158 PR4: save/restore, not set-False (see inferDefinerShadowApp's bracket).
    let saved = toggles.value.shadowHeadCtxRef.value
    toggles.value.shadowHeadCtxRef := True
    let ft = infer env f
    toggles.value.shadowHeadCtxRef := saved
    ft

-- P0-19 (standalone arm): type the application against the LOCAL standalone scheme so
-- the result is the standalone's (S2/S5); a domain mismatch (`size "hi"`) or a wrapper
-- generalized over the shadow receiver then called at a foreign type localizes to the
-- call [dloc].  No declared signature ⇒ fall back to the permissive method-scheme head
-- + enforceStandaloneDomain (the pre-P0-19 permissive behavior, unchanged).
inferDefinerStandaloneVarApp : TcEnv -> String -> Expr -> Expr -> Mono -> Option Loc -> Mono
inferDefinerStandaloneVarApp env name f x xt dloc = match standaloneShadowScheme name
  Some smono =>
    let r = freshVar ()
    let eff = openRow ()
    currentLoc := dloc
    let _ = unify smono (TFun xt eff r)
    let _ = performEffect perRun.value.curEffect eff
    -- S-1 (REJECT direction).  standaloneShadowScheme instantiates the DECLARED SIG via
    -- sigToScheme, which DROPS the `=>` constraints entirely — so `Num String` was never
    -- asked and `check` ACCEPTED `size "hi"` against `size : Num a => a -> a`.  Re-read
    -- the constraints off the signature and record them as call obligations at the
    -- receiver, which makes it a located reject.  (This arm has a signature by
    -- construction; the no-signature arm below goes through `infer env f` → inferVarPlain
    -- → instantiateVarTracked, the ordinary obligation path.)
    let _ = recordStandaloneSigObligations name "" xt
    r
  None =>
    -- #158 PR4: save/restore, not set-False (see inferDefinerShadowApp's bracket).
    let saved = toggles.value.shadowHeadCtxRef.value
    toggles.value.shadowHeadCtxRef := True
    let ft = infer env f
    toggles.value.shadowHeadCtxRef := saved
    let _ = enforceStandaloneDomain env name xt dloc
    inferApp (envAlphaLets env) (EApp f x) ft xt

-- P0-18: the type of a definer-shadow application HEAD.  With a mangled symbol (the
-- emit path), instantiate the standalone's own scheme (bound under `<mid>__name`) so
-- the concrete result type survives; else infer the head node (the un-mangled path,
-- where the bare name already resolves to the standalone).
definerShadowHeadType : TcEnv -> String -> Expr -> Mono
definerShadowHeadType env "" f = infer env f
definerShadowHeadType env sym f = match lookupVar env sym
  Some s => instantiate s
  None => infer env f

-- stamp every route ref (one for the marked EMethodAt form, none for the unmarked
-- check-path EVar form) RLocal.  S-1: the standalone's own constraint dicts are NOT
-- resolvable here (inference has not solved the receiver yet) — the caller ALSO pushes
-- an RLocalSite so resolveRLocalSites re-stamps the same ref with the filled dicts
-- post-inference.  An unconstrained standalone never gets a second stamp that differs.
stampRoutes : List (Ref Route) -> Unit
stampRoutes [] = ()
stampRoutes (r::rest) =
  r := RLocal (routeLocalSym !r) []
  stampRoutes rest

-- ── S-1: the shadowing standalone's OWN constraint dicts ──────────────────────
-- A `=>`-constrained top-level fn whose name collides with a visible interface method
-- (`eq : Num a => a -> a` vs the prelude's `Eq.eq`) sits in BOTH the shadow name set
-- and the dict name set.  The marking prePass is a first-match guard chain whose shadow
-- arm is tested FIRST, so the occurrence becomes `EMethodAt`, never `EDictAt` — and no
-- dict is ever computed for it.  But `dictPassDecl` (keyed on the same dict name set)
-- still prepends the dict PARAM to the definition.  Def arity 2, call arity 1 ⇒ the
-- call silently UNDER-APPLIES and the first real argument lands in the dict slot.
--
-- So: when a shadow occurrence resolves to the STANDALONE arm, compute that
-- standalone's constraint slots here — the shadowed interface decides WHICH function,
-- the standalone's own constraints decide WHICH DICTS (clause S9).
--
-- [xt] is the RECEIVER's mono.  We take a tracked instantiation of the standalone's own
-- scheme and unify it with `xt -> <fresh>`, which pins the standalone's constraint
-- variable to the receiver exactly as inferApp will pin the site's real head — so the
-- subst maps each constraint id to whatever that constraint variable becomes at THIS
-- call.  The fresh result var is a throwaway: it does NOT re-type the site (the caller's
-- own `ft`/`inferApp` still owns the site's type), it only ties the dict to the receiver.
--
-- ⚠️ Unify against the RECEIVER, not against the caller's head type `ft`.  On the
-- UN-MANGLED path `ft` is the permissive interface-METHOD scheme, not the standalone's
-- (the two doc-comments in inferDefinerShadowApp contradict each other on this; `:5050`
-- is the correct one).  Unifying the standalone's `a -> a` against the method's
-- `a -> a -> Bool` is an OCCURS-CHECK failure — "Cannot construct infinite type" on the
-- perfectly legal `eq : Num a => a -> a`.  The receiver is common to both.
--
-- Returns the slot-ordered (monos, ifaces) that routesOfMonosTop turns into Routes, and
-- records the call's impl obligations so `size "hi"` (⇒ `Num String`, which has no
-- impl) becomes a LOCATED REJECT at `check` instead of build-time garbage — the second,
-- independent hole in this same arm.  ([] , []) for an unconstrained standalone, which
-- SHORT-CIRCUITS BEFORE THE UNIFY, so an unconstrained shadow (all 5 of the compiler's
-- own) does not even perturb the substitution — the fixpoint provably cannot move.
shadowStandaloneDicts : TcEnv -> String -> String -> Mono -> ShadowDicts
shadowStandaloneDicts env name sym xt =
  -- P0-20's sym-awareness lesson, mirrored: on the mangled emit path the standalone is
  -- bound under `<mid>__name`, so a BARE-name lookup here would be silently inert and
  -- `build` would emit the un-dicted call while run/check dicted correctly — the same
  -- bug, mirrored.  shadowDomainFor exists for exactly this reason.
  shadowStandaloneDictsWith (lookupVar env (if sym == "" then name else sym)) name sym xt

-- as shadowStandaloneDicts, but with the standalone's scheme supplied explicitly.
-- The IMPORTER shadow needs this: in the importing module `env1` deliberately rebinds the
-- bare name to the polymorphic INTERFACE-METHOD scheme (that rebinding is the entire
-- reason shadowStandaloneSchemesRef exists), so `lookupVar env name` hands back the
-- METHOD — whose quantified ids are not the ones funConstraintsRef recorded for the
-- imported standalone, so every dict slot silently resolves to nothing.  That is why the
-- importer shadow was correct on `build`/`wasm` (which reach the standalone through the
-- MANGLED symbol) and still under-applied on `run`.
shadowStandaloneDictsWith : Option Scheme -> String -> String -> Mono -> ShadowDicts
shadowStandaloneDictsWith mscheme name sym xt =
  let _ = recordStandaloneSigObligations name sym xt
  shadowStandaloneDictSlotsAt mscheme (if sym == "" then name else sym) xt

-- the dict slots ONLY — no call obligations.
-- recordRLocalSite needs this: it fires for EVERY shadow method occurrence, at a point
-- where the standalone-vs-dispatch choice is NOT yet made (resolveRLocalSite decides it
-- post-inference from the grounded receiver).  Recording an obligation here would fire on
-- the DISPATCH arm too and spuriously reject `size (Box 3)` with `Num Box`.  When the
-- receiver does turn out to have an impl, stampRLocalOrFallback simply discards these
-- slots and the route dispatches as before.
shadowStandaloneDictSlotsAt : Option Scheme -> String -> Mono -> ShadowDicts
shadowStandaloneDictSlotsAt mscheme key xt =
  -- FIX-shadow-arity-skew: ONE resolution, two projections — the slots AND the argument
  -- vectors must come from the same entry decision, exactly as `inferDictAtFound` does.
  let dc = declaredConstraintFor key
  let slots = dc.cdSlots
  -- REJECT direction — from the SIGNATURE, NOT from schemeObligationsRef.
  -- ⚠️ For a SIGNATURED binding the two obligation tables live in DIFFERENT ID SPACES:
  -- funConstraintsRef's ids (and the env scheme's quantified ids) come from
  -- sigToSchemeTvs over the declared signature, while schemeObligationsRef's come from
  -- GENERALIZATION.  Mapping the latter's ids through the former's substitution silently
  -- finds nothing — which is why the dict ROUTES resolved correctly (they use
  -- funConstraintsRef) while the obligation stayed unrecorded and `size "hi"` was
  -- ACCEPTED.  The signature is the one source both halves can agree on.
  -- the unconstrained standalone: nothing to solve, no unify, no perturbation at all.
  -- This short-circuit is what makes the change provably fixpoint-safe — all 5 of the
  -- compiler's own definer shadows are unconstrained and never reach the unify below.
  -- ⚠️ Gated on the UNTRUNCATED id list, not on `slots`: this guard also decides whether
  -- the `unify` below runs, so a truncation here would remove a unification side effect.
  -- See `declaredConstraintIds`.
  if isEmptyL (declaredConstraintIds key) then emptyShadowDicts
  else match mscheme
    None => emptyShadowDicts
    Some s =>
      let inst = instantiateTracked s
      let r = freshVar ()
      let eff = openRow ()
      let _ = unify (fst inst) (TFun xt eff r)
      shadowStandaloneDictSlots slots dc.cdArgs (snd inst)

-- the standalone's dict ROUTE slots for this call: its declared constraint ids mapped
-- through the call's instantiation subst.  Expanded with transitive supers EXACTLY as
-- inferDictAtFound does (WS-1b) — dictArityOf sizes the DEFINITION's leading dict params
-- from the same expanded table, so call and def must agree slot-for-slot or we have
-- merely moved the arity disagreement.  Empty on the plain `check` path
-- (funConstraintsRef is empty there) — check stamps no routes, so that is correct;
-- recordStandaloneSigObligations is what gives `check` its reject direction.
--
-- 🚨 FIX-shadow-arity-skew: "EXACTLY as inferDictAtFound does" is a claim about the
-- (slot, VECTOR) pairs fed to the fixpoint, NOT about the slot list alone, and this is
-- where that distinction was paid for.  This expanded via `expandSupersPairs`, which
-- pairs every slot with a constant `[]`; once S-slot-key-vector (#1866) re-keyed
-- `dedupSlotVecs` on the WHOLE PREDICATE, `(Ix a Char, Ix a Bool) => …` opened TWO slots
-- on the definition side (`expandSupersEntry`, which `dictArityOf` sizes from) and this
-- call side still collapsed them to ONE — 1 dict passed to a 2-dict definition.  Measured
-- on the packet's reproducer at `e19298f5`: `check` exit 0, `run` E-PANIC
-- "intToString: not an Int", `build` exit 0 printing a DIFFERENT heap pointer every
-- execution, wasm "illegal cast".  Take the vectors from the same `declaredConstraintFor`
-- entry the slots came from, or re-open it.
shadowStandaloneDictSlots : List CSlot -> List (List Mono) -> List (Int, Mono) -> ShadowDicts
shadowStandaloneDictSlots slots args subst =
  if isEmptyL slots then emptyShadowDicts
  else
    let expandedV = expandSupersVecs driverState.value.superDeclsRef.value (zipSlotVecs slots args)
    let expanded = map fst expandedV
    -- the ROUTE half stays a SPELLING, exactly as `inferDictAtFound`'s `pushDictApp`
    -- does — route words, not identities (see `dispHeadTab`).
    -- [sdArgVecs] is `callArgVecsV` over the SAME expansion against the SAME subst, so it
    -- is slot-parallel to [sdMonos] by construction (that function's own header states
    -- the invariant and the shared drop rule that preserves it).
    ShadowDicts {
      sdMonos = constraintMonosOf (map (sl => sl.csId) expanded) subst,
      sdIfaces = map (sl => sl.csIface.irName) expanded,
      sdArgVecs = callArgVecsV expandedV subst,
    }

-- ── S-1, REJECT direction on the plain `check` path ───────────────────────────
-- Record the standalone's declared `=>` constraints as CALL obligations, resolved from
-- its own SIGNATURE.
--
-- ⚠️ Why the SIGNATURE and not schemeObligationsRef: for a signatured binding those are
-- two different ID SPACES (sigToSchemeTvs's fresh quantification vs generalization's), so
-- schemeObligationsRef's ids are not keys of the env scheme's instantiation subst and
-- recordSchemeCallObligations silently records nothing.  That is exactly why the dict
-- ROUTES came out right (they key off funConstraintsRef, which IS the signature's id
-- space) while `check` still ACCEPTED `size "hi"` (⇒ `Num String`, which has no impl).
--
-- ⚠️ sigToSchemeTvs's `tvs` are the scheme's BOUND tyvars, and `instantiate` RE-freshens
-- them — so unifying the *instantiated* type against the receiver does not touch `tvs` at
-- all.  We must instantiateTracked and map each constraint tyvar's ID through the subst,
-- which is precisely what that function's own doc-comment prescribes ("so a caller can
-- recover the id of a specific constraint variable … a call-site instantiation's subst
-- maps them").  Getting this wrong records nothing and reads as "the fix does not work".
--
-- Keyed by the BARE name on the un-mangled run/check path and by the MANGLED symbol on
-- the emit path (sigsOf runs over the already-renamed decls there) — try both, exactly as
-- shadowDomainFor has to.
recordStandaloneSigObligations : String -> String -> Mono -> Unit
recordStandaloneSigObligations name sym xt = match standaloneShadowSigTy name sym
  None => ()
  Some ty => match sigConstraintsOf ty
    [] => ()
    cs =>
      let pr = sigToSchemeTvs ty
      let inst = instantiateTracked (fst pr)
      let r = freshVar ()
      let eff = openRow ()
      let _ = unify (fst inst) (TFun xt eff r)
      recordSigConstraintObls cs (snd pr) (snd inst)

-- the standalone's declared signature Ty, under whichever key this path stores it.
standaloneShadowSigTy : String -> String -> Option Ty
standaloneShadowSigTy name sym = match lookupAssoc name perRun.value.definerShadowSigsRef.value
  Some ty => Some ty
  None =>
    if sym == "" then
      None
    else
      lookupAssoc sym perRun.value.definerShadowSigsRef.value

-- every `=>` constraint in the signature.  Recurses the spine like constraintVarNamesTy
-- rather than matching only the top node, so an effect-annotated sig still yields them.
sigConstraintsOf : Ty -> List Constraint
sigConstraintsOf (TyConstrained cs t) = cs ++ sigConstraintsOf t
sigConstraintsOf (TyEffect _ _ t) = sigConstraintsOf t
sigConstraintsOf _ = []

-- one obligation per `=>` PREDICATE in the signature, carrying its whole argument
-- vector at THIS call's instantiation (`Ix a i` => ONE ("Ix", [ma, mi]) entry, not
-- two 1-ary entries that ask an unanswerable question about each var alone).  If ANY
-- argument fails to resolve (not a plain tyvar, or absent from either map) the whole
-- predicate records nothing — a partial vector is a DIFFERENT, wrong predicate, so
-- dropping it is the never-over-reject direction (#607).
recordSigConstraintObls : List Constraint -> List (String, Mono) -> List (Int, Mono) -> Unit
recordSigConstraintObls [] _ _ = ()
recordSigConstraintObls ((Constraint { constraintHead = iface, constraintArgs = args, constraintOrigin = o })::rest) tvs subst =
  let _ = match recordSigConstraintArgs args tvs subst
    Some monos => recordObl Predicate {
      iface = IfaceRef { irName = iface, irOrigin = o },
      args = monos,
    } 0 PCallSlot !currentLoc
    None => ()
  recordSigConstraintObls rest tvs subst

-- the constraint arguments' monos at THIS call's instantiation, in declaration order;
-- None if any argument does not resolve (see recordSigConstraintObls).  Two hops:
-- argument -> the signature's tyvar mono (constraintArgMonos), then that tyvar's id ->
-- this instantiation's mono (substMonos).  Both are all-or-nothing, so this is too.
recordSigConstraintArgs : List Ty -> List (String, Mono) -> List (Int, Mono) -> Option (List Mono)
recordSigConstraintArgs args tvs subst = match constraintArgMonos args tvs
  Some tvMonos => substMonos (map monoTyvarId tvMonos) subst
  None => None

-- the tyvar NAME a constraint argument mentions (`Num a` → "a"); None for a non-tyvar
-- argument (a concrete head), which carries no per-call obligation here.
constraintArgVarName : Ty -> Option String
constraintArgVarName (TyVar v) = Some v
constraintArgVarName _ = None

-- set currentLoc only when the lambda carried a span (mirror the ELoc arm), so
-- a bare unlocated lambda doesn't blank out an enclosing position.
setLocIfSome : Option Loc -> Unit
setLocIfSome None = ()
setLocIfSome (Some l) = currentLoc := Some l

-- peek through an ELoc wrapper to a lambda; returns its loc, params and body.
-- Non-lambda arguments (the common case) take the ordinary inference path.
lamUnderLoc : Expr -> Option (Option Loc, List Pat, Expr)
lamUnderLoc (ELam pats body) = Some (None, pats, body)
lamUnderLoc (ELoc l (ELam pats body)) = Some (Some l, pats, body)
lamUnderLoc _ = None

-- the function's first parameter type (the lambda's expected type), or a fresh
-- var when `ft` is not yet a concrete arrow (then nothing is pushed; the trailing
-- `unify ft (TFun xt …)` reconciles).
funDomain : Mono -> Mono
funDomain (TFun a _ _) = a
funDomain _ = freshVar ()

-- peel up to `n` arrow domains off the (normalized) lambda's expected type; those
-- domains are the lambda's expected PARAM types.  Stops early if it is not (yet)
-- an arrow — those params fall back to a fresh var in inferLamChecked, and the
-- trailing `unify ft (TFun xt …)` reconciles them.
expectedParamTypes : Mono -> Int -> List Mono
expectedParamTypes _ 0 = []
expectedParamTypes (TFun a _ b) n =
  a :: expectedParamTypes (normalize b) (n - 1)
expectedParamTypes _ _ = []

-- like inferLam, but each lambda param is unified with the corresponding expected
-- param type (from the function being applied) right after inferPat — so the body
-- and the hover side-channel see the expected type, not a bare fresh var.
inferLamChecked : TcEnv -> List Mono -> List Pat -> Expr -> Mono
inferLamChecked env expected pats body =
  let pr = inferPats env pats
  let _ = unifyParamsExpected (fst pr) expected
  let saved = perRun.value.curEffect.value
  perRun.value.curEffect := openRow ()
  let bodyTy = infer (extendLocalVars env (snd pr)) body
  let bodyEff = perRun.value.curEffect.value
  perRun.value.curEffect := saved
  arrowsWithLastEffect (fst pr) bodyEff bodyTy

-- unify each param type with its expected type, for the prefix both lists cover.
unifyParamsExpected : List Mono -> List Mono -> Unit
unifyParamsExpected (p::ps) (e::es) =
  let _ = unify p e
  unifyParamsExpected ps es
unifyParamsExpected _ _ = ()

-- Chunk C: recover the ultimate callee name of an application spine (the
-- leftmost head), stripping transparent wrappers.  `None` when the head is not
-- a plain variable (so no name to blame in an over-application message).
appSpineName : Expr -> Option String
appSpineName (ELoc _ e) = appSpineName e
appSpineName (EDoOrigin _ e) = appSpineName e
appSpineName (EAnnot e _) = appSpineName e
appSpineName (EApp f _) = appSpineName f
appSpineName (EVar n) = Some n
appSpineName (EVarId n _) = Some n
appSpineName (EVarAt n _) = Some n
appSpineName _ = None

-- Chunk C: number of arguments applied in this spine (`f a b c` ⇒ 3).
appSpineArgCount : Expr -> Int
appSpineArgCount (ELoc _ e) = appSpineArgCount e
appSpineArgCount (EDoOrigin _ e) = appSpineArgCount e
appSpineArgCount (EAnnot e _) = appSpineArgCount e
appSpineArgCount (EApp f _) = 1 + appSpineArgCount f
appSpineArgCount _ = 0

-- Chunk C messages (T-NOT-A-FUNCTION): a value of a ground non-function type is
-- being applied.  Base wording names the offending type; the context-aware
-- form names the over-applied callee and its arity.
notAFunctionMsg : String -> String
notAFunctionMsg tyName = "This expression has type \{tyName}, which is not a function, so it cannot be applied to an argument."

-- F-dimension actionable-fix hint appended to `notAFunctionMsg` (2026-07-04):
-- names the offending value when the spine head is a plain variable, else
-- falls back to a name-free phrasing.  No mechanical `fix` — the caller
-- decides whether to drop the argument or call a different function.
notAFunctionHint : Option String -> String
notAFunctionHint (Some name) = " '\{name}' is a value, not a function; remove the argument, or call a function here."
notAFunctionHint None = " This is a value, not a function; remove the argument, or call a function here."

overAppliedMsg : String -> Int -> Int -> String
overAppliedMsg name takes applied = "'\{name}' takes \{intToString takes} argument(s) but is applied to \{intToString applied}."

-- Batch B #6 reframe (2026-07-04): a container-consuming HOF whose next declared
-- parameter is a higher-kinded container `f a` (an unresolved tyvar head applied
-- to an element, i.e. `TApp (TVar …) elem`) is being handed a SCALAR argument —
-- a bare arity-0 type (`String`/`Int`/…) that has no element slot for `f` to
-- bind.  Left to the generic `unify (f a) String` sink it leaks a raw
-- tyvar-application `Type mismatch: a b vs String`.  This detector recognises the
-- shape UPSTREAM (in inferApp, where the callee name + arg loc are still in
-- scope) so the diagnostic can be reframed as container-vs-scalar.  SOUND: a
-- `TApp _ _ ~ TCon n` unification can only ever FAIL — a genuine container arg is
-- itself a `TApp` (`List a`, `Maybe a`, …) and would UNIFY the element, never
-- reaching a mismatch; the reframe therefore never hijacks a legitimate
-- higher-kinded mismatch.  Returns the scalar type's name when it fires.
containerParamScalarArg : Mono -> Mono -> Option String
containerParamScalarArg ft xt = match normalize ft
  TFun dom _ _ => match normalize dom
    TApp _ _ => match headTyconNameMono dom
      None => match normalize xt
        TCon n _ => Some n
        -- answer-preserving (#1110): a rigid used to arrive here as `TCon n`
        -- and named itself in the container-vs-scalar reframe.
        TRigid n => Some n
        _ => None
      Some _ => None
    _ => None
  _ => None

containerArgMsg : Option String -> String -> String
containerArgMsg fn argTy =
  let who = match fn
    Some n => "'\{n}'"
    None => "This function"
  "\{who} expects a container (like List or Array) here, but got \{argTy}\{containerArgHint argTy}"

-- Actionable-fix hint appended to `containerArgMsg`.  Special-cases `String`
-- (the most common scalar handed to `map`): a String's characters are reachable
-- via `string.toChars`, so name that conversion rather than a generic one.
containerArgHint : String -> String
containerArgHint "String" = ". Pass a List or Array; to work over a string's characters, convert it with `string.toChars` first."
containerArgHint argTy =
  ". Pass a List or Array, or convert the \{argTy} to one first."

-- #894: `containerArgMsg` above hard-codes "a container (like List or Array)",
-- which is right for a genuine container-consuming HOF (`map`, `filter`, …) but
-- actively WRONG for the SAME reframe firing on a `do`-lowered `andThen` call —
-- `x <- b` / a bare statement line inside `do` lowers to `andThen b (...)`
-- (`lowerDo`, `compiler/frontend/desugar.mdk`), so a non-monadic `b` (e.g. `Bool`
-- in a `Result` do-block) hits this same container-vs-scalar detector.  "Pass a
-- List or Array" tells the user to convert their `Bool` into a list, which is
-- not the fix — the fix is `let` instead of `<-`, because the value was never
-- meant to be a container at all.  The concrete monad (`Result`) is NOT yet known
-- here (its tyvar is still free — nothing has pinned it), so this stays honest by
-- naming the shape ("Thenable", `do`'s own vocabulary — see `doRequiresMonadMsg`)
-- rather than guessing a specific type.  Fires ONLY on the exact callee `lowerDo`
-- synthesizes (`isDoLoweredAndThenCallee`, below) — an explicit user call to
-- `andThen` on a scalar argument, even one textually nested inside a do-bind's
-- own scrutinee, keeps the original List/Array message, which is the right
-- advice there.
doBindArgMsg : String -> String
doBindArgMsg argTy = "this `do` block needs a Thenable value here (like `Option` or `Result`), but got \{argTy}\{doBindArgHint argTy}"

doBindArgHint : String -> String
doBindArgHint argTy =
  ". If \{argTy} isn't itself monadic, use 'let' instead of '<-' to bind it."

-- #894 review finding 1: is `appExpr`'s own callee EXACTLY the synthesized
-- `andThen` `lowerDo` builds for a `do`-bind (`callAndThen`,
-- `compiler/frontend/desugar.mdk`)?  A STRUCTURAL check off the one node
-- `inferApp` was actually called for — no ambient/dynamic flag (the first cut
-- of this fix used callee-name + `currentDoOrigin`, which also lit up on a
-- user's own explicit `andThen` call textually nested inside a do-bind's
-- scrutinee, e.g. `x <- andThen b f`; that call is neither `lowerDo`'s callee
-- nor wants the `let`-instead-of-`<-` advice).  `callAndThen` tags ONLY the
-- callee it itself constructs, so no user-authored `andThen` occurrence — no
-- matter where it sits — can ever carry this wrapper.
isDoLoweredAndThenCallee : Expr -> Bool
isDoLoweredAndThenCallee (EApp callee _) = isDoLoweredAndThenCalleeExpr callee
isDoLoweredAndThenCallee _ = False

isDoLoweredAndThenCalleeExpr : Expr -> Bool
isDoLoweredAndThenCalleeExpr (ELoc _ e) = isDoLoweredAndThenCalleeExpr e
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVar "andThen")) = True
-- `resolve` rewrites every surviving `EVar` to `EVarId name id` (a stable
-- per-binding identity) — by the time `inferApp` runs, the callee `lowerDo`
-- tagged is `EVarId "andThen" _`, not the raw `EVar` it started as. Debugged
-- with `medaka check` + a one-off shape dump: the untagged-`EVar` arm above
-- never actually fires post-resolve; keep it anyway as the honest pre-resolve
-- shape (harmless — `EDoOrigin _ (EVar "andThen")` just never matches here).
isDoLoweredAndThenCalleeExpr (EDoOrigin _ (EVarId "andThen" _)) = True
isDoLoweredAndThenCalleeExpr _ = False

-- P0-16 beginner call-syntax hint.  A newcomer writes `add(1, 2)` (C/Python/JS
-- call syntax) meaning `add 1 2`; in Medaka `(1, 2)` is a TUPLE, so `add(1, 2)`
-- applies `add` to ONE tuple argument → a partial application / no-impl error
-- whose message ("No impl of Display for ((Int, Int) -> (Int, Int))") is
-- inscrutable.  We DETECT the shape at the application site — a curried arity-N
-- function applied to a single arity-N tuple literal whose first param is NOT
-- itself an N-tuple — and record the residual result type as a candidate; the
-- no-impl + type-mismatch surface sites then append the tailored hint when the
-- offending type IS that residual.  Recording is generous (a legitimate partial
-- application like `map (const (1, 2)) xs` also records) but the hint is only
-- ever ATTACHED to a genuine downstream error, so a legit partial application —
-- whose residual is consumed WITHOUT error — never shows it.  (residualMono,
-- help, optional (span, replacement) fix); reset by resetState.

-- number of leading `->` arrows in a (normalized) type — its curried arity.
funArity : Mono -> Int
funArity m = match normalize m
  TFun _ _ r => 1 + funArity r
  _ => 0

-- the elements of a tuple-literal argument (through the transparent ELoc wrapper).
tupleArgElems : Expr -> Option (List Expr)
tupleArgElems (ELoc _ e) = tupleArgElems e
tupleArgElems (ETuple es) = Some es
tupleArgElems _ = None

-- True iff [ft]'s first parameter is itself an arity-[n] tuple type — the genuine
-- "the tuple IS the intended single argument" shape (e.g. `f (a, b) c = …`), which
-- must NOT be flagged.  Read on the PRISTINE ft (before inferApp unifies its domain
-- with the tuple arg), so the domain here is the declared param type.
domainIsTupleOfArity : Mono -> Int -> Bool
domainIsTupleOfArity ft n = match normalize ft
  TFun dom _ _ => match headTyconNameMono dom
    Some c => c == "__tuple\{intToString n}__"
    None => False
  _ => False

-- render a tuple element to source-ish text for the `add 1 2` fix, for the simple
-- literal/var/negation cases; None for anything a full printer would be needed for.
renderCallArg : Expr -> Option String
renderCallArg (ELoc _ e) = renderCallArg e
renderCallArg (EAnnot e _) = renderCallArg e
renderCallArg (ENumLit n _ _ _) = Some (intToString n)
renderCallArg (ELit (LInt n)) = Some (intToString n)
renderCallArg (ELit (LBool True)) = Some "True"
renderCallArg (ELit (LBool False)) = Some "False"
renderCallArg (ELit (LString s)) = Some ("\"" ++ s ++ "\"")
renderCallArg (ELit (LChar c)) = Some ("'" ++ c ++ "'")
renderCallArg (EVar n) = Some n
renderCallArg (EVarId n _) = Some n
renderCallArg (EUnOp "-" e _) = map ("-" ++ _) (renderCallArg e)
renderCallArg _ = None

-- all-or-nothing render of every tuple element.
renderCallArgs : List Expr -> Option (List String)
renderCallArgs [] = Some []
renderCallArgs (e::rest) = match renderCallArg e
  None => None
  Some s => map (s :: _) (renderCallArgs rest)

-- source span covering the whole `name(args)` call: callee start → tuple end.
tupleCallSpanLoc : Expr -> Expr -> Option Loc
tupleCallSpanLoc f x = match (exprLoc f, exprLoc x)
  (Some (Loc file sl sc _ _), Some (Loc _ _ _ el ec)) =>
    Some (Loc file sl sc el ec)
  _ => None

-- build the (help, optional fix) for a detected tuple-call.  The help names the
-- rule (Medaka calls with spaces, `(…)` is a tuple) and gives the exact rewrite;
-- when every element renders, a machine-applicable `fix` rewrites `add(1, 2)` →
-- `add 1 2` verbatim.  ERROR-QUALITY: located (caller sets loc), names the issue,
-- actionable fix, carries a code (T-NO-IMPL / T-TYPE-MISMATCH at the surface site).
buildTupleCallHint : String -> List Expr -> Expr -> Expr -> (String, Option (Loc, String))
buildTupleCallHint name es f x = match renderCallArgs es
  Some parts =>
    let argsCsv = joinWith ", " parts
    let argsSpaced = joinWith " " parts
    let spread = "\{name} \{argsSpaced}"
    let help = "Medaka calls functions with spaces, not parentheses: `\{name}(\{argsCsv})` applies `\{name}` to one tuple `(\{argsCsv})`. Did you mean `\{spread}`?"
    let fix = map (span => (span, spread)) (tupleCallSpanLoc f x)
    (help, fix)
  None =>
    let n = listLen es
    let help = "Medaka calls functions with spaces, not parentheses: `\{name}(…)` passes a single \{intToString n}-tuple, not \{intToString n} arguments. Separate them with spaces, e.g. `\{name} x y`."
    (help, None)

-- detect the tuple-call shape on the PRISTINE ft (before inferApp) and return the
-- (help, fix) to record against the residual result type, else None.  Fires only
-- when the argument is a tuple literal of arity N ≥ 2, the callee has curried arity
-- EXACTLY N (spreading the tuple would saturate it), and its first param is not
-- itself an N-tuple (the genuine tuple-arg case), and the callee is a named spine.
tupleCallShapeHint : Expr -> Expr -> Mono -> Option (String, Option (Loc, String))
tupleCallShapeHint f x ft = match tupleArgElems x
  None => None
  Some es =>
    let n = listLen es
    if n < 2 then
      None
    else if funArity ft /= n then
      None
    else if domainIsTupleOfArity ft n then
      None
    else
      map (name => buildTupleCallHint name es f x) (appSpineName f)

-- surface-site lookup: does [m] (a type appearing in a no-impl / mismatch error)
-- equal a recorded tuple-call residual?  Compared by normalized rendering — the
-- residual IS the very type that flows into the error, so they render identically.
tupleCallHintFor : Mono -> Option (String, Option (Loc, String))
tupleCallHintFor m =
  findTupleCand (ppMono (normalize m)) perRun.value.tupleCallCandidates.value

findTupleCand : String -> List (Mono, String, Option (Loc, String)) -> Option (String, Option (Loc, String))
findTupleCand _ [] = None
findTupleCand key ((res, help, fix)::rest)
  | ppMono (normalize res) == key = Some (help, fix)
  | otherwise = findTupleCand key rest

-- first tuple-call hint matching any of the offending types in an error.
firstTupleCallHint : List Mono -> Option (String, Option (Loc, String))
firstTupleCallHint [] = None
firstTupleCallHint (m::rest) = match tupleCallHintFor m
  Some hf => Some hf
  None => firstTupleCallHint rest

inferApp : List (String, Expr) -> Expr -> Mono -> Mono -> Mono
inferApp lets appExpr ft xt =
  let r = freshVar ()
  -- Chunk C: if the callee normalizes to a concrete NON-arrow head (a known type
  -- constructor like `Int`/`List Int`, never a tyvar or an arrow), applying it
  -- is genuinely impossible.  Emit a context-aware `T-NOT-A-FUNCTION` instead of
  -- letting `unify ft (TFun …)` render a leaked `Int vs a -> b` mismatch, and
  -- poison the fresh result var so no secondary obligation cascade fires (reuses
  -- Chunk A's poisoned-var set).  Fires ONLY on a ground non-arrow head: a real
  -- function (`TFun`) or an as-yet-unresolved var (`TVar`) is unaffected.
  match headTyconNameMono ft
    Some _ => inferAppNotFunction appExpr ft r
    None => match containerParamScalarArg ft xt
      Some scalarTy =>
        -- Batch B #6: container-consuming HOF handed a scalar.  Reframe here
        -- (callee name + arg loc in scope) instead of letting the generic sink
        -- leak `a b vs String`.  Skip the unify (it would push the leaked
        -- mismatch as a SECOND diagnostic) and poison `r` to suppress cascade.
        --
        -- #894: the SAME shape also fires when this application is a `do`-lowered
        -- `andThen` call (`x <- b` / a bare statement line — `lowerDo`,
        -- `compiler/frontend/desugar.mdk`) whose bound value isn't monadic. That
        -- is not "pass a List or Array" — it is "use `let`, not `<-`". Detected
        -- by AST SHAPE off `appExpr`'s own callee (`isDoLoweredAndThenCallee`,
        -- `callAndThen` tags exactly its synthesized callee), NOT by name +
        -- `currentDoOrigin` — review finding 1 on the first cut of this fix: a
        -- name+ambient-state heuristic false-positives on a user's OWN explicit
        -- `andThen` call textually nested inside a do-bind's scrutinee
        -- (`x <- andThen b f`), which is neither `lowerDo`'s callee nor
        -- expecting the `let`-instead-of-`<-` advice.  The shape check can't:
        -- the wrapper is only ever placed on the exact node `lowerDo` builds.
        let isDoBind = isDoLoweredAndThenCallee appExpr
        let msg = if isDoBind then doBindArgMsg scalarTy else containerArgMsg (appSpineName appExpr) scalarTy
        let hint = if isDoBind then doBindArgHint scalarTy else containerArgHint scalarTy
        let _ = pushTypeErrorHelpFixAt "T-TYPE-MISMATCH" !currentLoc msg hint None
        -- Poison the container tyvar + element vars (in ft) exactly as the generic
        -- unify sink would (`monoUnboundIds a ++ b`), so the dangling `Mappable f`
        -- obligation sees a poisoned var and suppresses its own cascade.
        let _ = poisonMismatchVars ft xt
        let _ = poisonMismatchVars r r
        r
      None =>
        let eff = openRow ()
        -- Type-error span (Bite 3, fork 3 = ARGUMENT): point a wrong-arg-type
        -- mismatch at the argument expression rather than the callee.  The live
        -- `currentLoc` after inferring the arg is its last atom; refine it to the
        -- whole argument span so `len 5` (len : String -> Int) squiggles the `5`.
        let _ = match appArgLoc appExpr
          Some al => (currentLoc := (Some al))
          None => ()
        let _ = unify ft (TFun xt eff r)
        -- v2 Stage 2b: if f resolves to a leaf extern carrying an inferred-hole
        -- Prefix atom (`<Net _>`), fill it by α of the application spine's FIRST
        -- argument before the row propagates / is checked against any bound.  `lets`
        -- seeds α with the enclosing body's let scope (EFFECTS WS-2).
        let eff2 = fillHolesInRow lets eff (spineFirstArg appExpr)
        let _ = performEffect perRun.value.curEffect eff2
        r

-- Chunk C: the applied head is a ground non-function.  If the spine over-applies
-- a named function (callee name known AND at least one arg was consumed before
-- the type went non-arrow) use the arity-aware wording; otherwise fall back to
-- naming the non-function type.  Poison `r` to suppress downstream cascade.
inferAppNotFunction : Expr -> Mono -> Mono -> Mono
inferAppNotFunction appExpr ft r =
  let applied = appSpineArgCount appExpr
  let takes = applied - 1
  let _ = match appSpineName appExpr
    Some name => if takes >= 1 then pushTypeError "T-NOT-A-FUNCTION" (overAppliedMsg name takes applied)
    else
      let hint = notAFunctionHint (Some name)
      pushTypeErrorHelpFixAt
        "T-NOT-A-FUNCTION"
        currentLoc.value
        (notAFunctionMsg (ppMono (normalize ft)) ++ hint)
        hint
        None
    None =>
      let hint = notAFunctionHint None
      pushTypeErrorHelpFixAt
        "T-NOT-A-FUNCTION"
        currentLoc.value
        (notAFunctionMsg (ppMono (normalize ft)) ++ hint)
        hint
        None
  let _ = poisonMismatchVars r r
  r

inferLam : TcEnv -> List Pat -> Expr -> Mono
inferLam env pats body =
  -- Patterns carry no source Loc, so a pattern-level type error (e.g. an
  -- over-applied nullary constructor `A _`) would otherwise be recorded at the
  -- STALE `currentLoc` left by the previous clause/function's body inference —
  -- mis-blaming an innocent sibling clause.  Anchor `currentLoc` to THIS clause's
  -- body loc before inferring the patterns, so the error lands on the right
  -- clause (the body re-sets `currentLoc` via its own ELoc arm afterwards).
  let _ = match exprLoc body
    Some l => (currentLoc := (Some l))
    None => ()
  let pr = inferPats env pats
  let saved = perRun.value.curEffect.value
  perRun.value.curEffect := (openRow ())
  let bodyTy = infer (extendLocalVars env (snd pr)) body
  let bodyEff = perRun.value.curEffect.value
  perRun.value.curEffect := saved
  arrowsWithLastEffect (fst pr) bodyEff bodyTy

-- The first Bool (`mut`) is always False — `let mut` is a parser error (beta
-- mutability model), so no inline mut-let path remains here.
inferLet : TcEnv -> Bool -> Bool -> Pat -> Expr -> Expr -> Mono
inferLet env _ isFun pat e1 e2
  | isFun = match pat
    PVar x xloc => inferRecLet env x (Some xloc) e1 e2  -- #866: binder loc for the pin note
    _ => inferLetSimple env pat e1 e2
  | otherwise = inferLetSimple env pat e1 e2

-- T2: a recursive inline function binding (`let go n = … in …`) must
-- pre-bind `go` with a monomorphic placeholder so the RHS can reference
-- itself, then generalize (a function is a value — oracle `:1668-1681`).

-- Self-recursive inline `let` binding (mirrors blockRecLet + the oracle is_fun
-- arm): placeholder pre-bind, infer body, unify, generalize through the body.
inferRecLet : TcEnv -> String -> Option Loc -> Expr -> Expr -> Mono
inferRecLet env x xloc e1 e2 =
  let _ = checkRecBindNonFunction x e1  -- #799
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let placeholder = freshVar ()
  let envSelf = extendLocalVar env x (monoScheme placeholder)
  let t1 = infer envSelf e1
  let _ = unify placeholder t1
  let _ = exitLevel ()
  let addedObls = wWindow perRun.value.implObls oblN0
  let _ = defaultAmbiguousNum addedObls t1  -- PLAN.md #11
  let _ = registerAmbiguousConstraints addedObls [t1]  -- RETPOS soundness
  let _ = recordLocalBind x t1  -- LSP hover (recursive PVar let bypasses inferPat)
  let sch = genRestricted (not (pinLocalIfDictForwarded callN0 dictN0 x xloc t1)) t1  -- #866
  let _ = registerLocalScheme x sch oblN0 callN0 dictN0
  infer (seedAlphaLets (extendLocalVar env x sch) x e1) e2  -- WS-2: α scope-seed

-- Round-2 adversarial break "let-alias evasion" (#816): register a LOCAL
-- binding's generalized scheme obligations exactly as processSCC does for
-- top-level members, so a later use re-instantiates them into the
-- call-obligation window every checker reads.  Before this, `let f = hh`
-- (re-generalizing `hh : Num x => x -> x`) registered NOTHING: the RHS
-- occurrence's obligation stayed on a var generalization then orphaned, Int
-- defaulting satisfied it quietly, and `f x` at a method-scheme var sailed
-- through check into an eval panic / native SEGFAULT.  Name collisions across
-- bodies are safe: obligations are keyed by the scheme's own quantified ids,
-- and substMonos skips ids a different scheme's instantiation does not map.
--
-- ⚠️ #866 NARROWED THE PREMISE OF EVERYTHING ABOVE — read this before relying on it.
-- The paragraphs above (and I2's below) describe a world in which a local binding's
-- constrained var GENERALIZES and its obligation is DEFERRED into the enclosing
-- scheme.  For a dict-FORWARDING local that is no longer true: the five local
-- generalization sites now decline to generalize over such a var
-- (pinLocalIfDictForwarded), so `let f = <a constrained fn>` is monomorphic in that
-- var and a second use at a different type is a T-LOCAL-CONSTRAINED-MONO error, not a
-- deferral.  This machinery is NOT dead — it still carries every OTHER local
-- obligation, and it is still what makes the pinned var's own constraint reach the
-- enclosing scheme when the binding is used at ONE type (`top a b = h a b where h x y
-- = needsOrd x y` still infers `top : Ord a => …`).  What changed is only the
-- multi-type case, and the reason is that a local binding is not dict-abstracted, so
-- generalizing it produced a null dict (SIGSEGV) or, for an alias, one dict baked from
-- the first use and silently reused for the second (#1045).  Dict-abstracting local
-- bindings is the real fix and would restore the deferral here; until then this is a
-- signed-off ergonomics-for-soundness trade (#1021).
registerLocalScheme : String -> Scheme -> Int -> Int -> Int -> Unit
registerLocalScheme x sch oblN0 callN0 dictN0 =
  -- #827/#838 I2: register local-scheme obligations EVERYWHERE, not just inside
  -- IMPL/DEFAULT bodies.  The old `inRigidityBodyRef` gate scoped this to the W3
  -- channel because registering universally re-routed constraints through the
  -- ambiguity machinery (an Ord-constrained where-helper's use tripped `Ambiguous
  -- instance` instead of deferring) — a top-level `where` helper's orphaned
  -- constraint (`f x = go x where go n = n + 1` typing `f : a -> a`, `f "abc"`
  -- panicking at run) was the resulting S0.  I2's uniform deferral (checkUndetermined-
  -- Obligation RULE 2, deferrableVarIds) now defers a generalizable var into the
  -- enclosing scheme instead of rejecting, so the gate is safe to flip open.
  let addedObls = wWindow perRun.value.implObls oblN0
  let callOblsDelta = callOblsWindow callN0
  -- #838 I5: the dict-slot's forwarded obligation is ALREADY in callOblsDelta as the
  -- mirroring PCallSlot obligation recorded at inferDictAtFound (recordCallObligations,
  -- beside pushDictApp), reaching schemeOblsForMember via forwardedVecObls; the old
  -- `allDictObls` re-derivation was a redundant second source (deduped away). Retired.
  registerSchemeObligations omEmpty [] callOblsDelta addedObls [(x, sch)]

inferLetSimple : TcEnv -> Pat -> Expr -> Expr -> Mono
inferLetSimple env pat e1 e2 =
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let t1 = infer env e1
  let _ = exitLevel ()
  -- PLAN.md #11: ground an ambiguous Num-only var before this inner let
  -- generalizes, so `let z = 2 in y + z` (y:Float) is a clean type error and
  -- never leaks an unbound Num var.  Scoped to this binding's new obligations.
  let addedObls = wWindow perRun.value.implObls oblN0
  let _ = defaultAmbiguousNum addedObls t1
  let _ = registerAmbiguousConstraints addedObls [t1]   -- RETPOS soundness
  inferLetBody env pat t1 e1 e2 oblN0 callN0 dictN0

inferLetBody : TcEnv -> Pat -> Mono -> Expr -> Expr -> Int -> Int -> Int -> Mono
inferLetBody env (PVar x xloc) t1 e1 e2 oblN0 callN0 dictN0 =
  let _ = recordLocalBind x t1  -- LSP hover (PVar let bypasses inferPat)
  let sch = genRestricted (isNonexpansive env e1 && not (pinLocalIfDictForwarded callN0 dictN0 x (Some xloc) t1)) t1  -- #866
  let _ = registerLocalScheme x sch oblN0 callN0 dictN0
  infer (seedAlphaLets (extendLocalVar env x sch) x e1) e2  -- WS-2: α scope-seed
inferLetBody env pat t1 _ e2 _ _ _ =
  let pr = inferPat env pat
  let _ = unify (fst pr) t1
  infer (extendLocalVars env (snd pr)) e2

inferIf : TcEnv -> Expr -> Expr -> Expr -> Mono
inferIf env c t e =
  let _ = unify (infer env c) (tconBuiltin "Bool")
  let tt = infer env t
  let ee = infer env e
  let _ = noteNumlitCtx tt ee "if"  -- Chunk D: site-specific Num mis-framing wording
  let _ = unify tt ee
  tt

inferEach : TcEnv -> List Expr -> List Mono
inferEach _ [] = []
inferEach env (e::es) =
  let t = infer env e
  t :: inferEach env es

inferListLit : TcEnv -> List Expr -> Mono
inferListLit env es =
  let elem = freshVar ()
  let _ = unifyAllNumlit elem (inferEach env es)  -- Chunk D: tag list-element Num mismatch
  TApp (tconBuiltin "List") elem

-- Chunk D: like unifyAll but tags each element that is a still-unbound literal var
-- being forced against a concrete accumulator (or vice-versa) with the "list" ctx.
unifyAllNumlit : Mono -> List Mono -> Unit
unifyAllNumlit _ [] = ()
unifyAllNumlit t (x::xs) =
  let _ = noteNumlitCtx t x "list"
  let _ = unify t x
  unifyAllNumlit t xs

inferAnnot : TcEnv -> Expr -> Ty -> Mono
inferAnnot env e ty =
  let t = infer env e
  let pair = astTypeFreshTbl ty
  let annot = fst pair
  let _ = unify t annot
  let _ = checkAnnotTooGeneral ty (map snd (snd pair))
  annot

-- Phase 108 head-pin (`:~`, EHeadAnnot): like inferAnnot but WITHOUT the
-- checkAnnotTooGeneral skolemization guard — the pin's type variables are MEANT
-- to ground (the container literal's element types).  Fixes `e`'s head tycon to
-- the named container so `fromEntries`'s return-position dispatch resolves to
-- that container's impl.  Mirror of lib/typecheck.ml's EHeadAnnot arm.
--
-- Phase 114 (was wrongly dropped here): ignore the *arity* the lowering happened
-- to supply and apply the head tycon to its *declared* arity of fresh vars.  The
-- parser can't tell empty `Map { }` from `Set { }` — both have no entries, so
-- classifyBrace falls through to `ESetLit name []` and the desugar pins a UNARY
-- `Map _a`, the wrong arity for `Map k v` (→ `Map vs Map …`).  Looking the arity
-- up by the head tycon makes empty literals work regardless of the lowering's
-- guess; element vars stay free and ground via inference as before.
inferHeadAnnot : TcEnv -> Expr -> Ty -> Mono
inferHeadAnnot env e ty =
  let t = infer env e
  let annot = headAnnotTy ty
  let _ = unify t annot
  t

-- The head-pin's target type: if the annotation's head is a TyCon with a known
-- declared arity (from `dataParamKindsRef`), rebuild it at that arity with fresh
-- vars (so an empty literal's wrong-arity pin is corrected); otherwise fall back
-- to the literal annotation type.
headAnnotTy : Ty -> Mono
headAnnotTy ty = match tyAppSpine ty
  -- OCCURRENCE MINT (#1110): same source as `fromAstTypeE`'s — the identity of
  -- the annotation head being rebuilt at its declared arity.
  (TyCon { tyConName = n, tyConOrigin = o }, _) => match lookupTab (tyTabKey o n) perRun.value.dataParamKindsRef.value
    Some kinds => applyParams (tconFrom o n) (freshVars (listLen kinds))
    None => fst (astTypeFreshTbl ty)
  _ => fst (astTypeFreshTbl ty)

-- C3 (mirrors lib/typecheck.ml:1821-1842): each type variable named in the
-- annotation asserts polymorphism, so after unification it must still be a
-- DISTINCT, unbound variable.  If one ground to a concrete type, or two
-- annotation variables collapsed to the same variable, the annotation is more
-- polymorphic than the expression — reject.  `sigTvarIds` keeps only the entries
-- that normalize to a TVar, so a grounded var drops out (count shrinks) and a
-- collapse shows as a duplicate id.  EHeadAnnot is exempt (no call to this).
checkAnnotTooGeneral : Ty -> List Mono -> Unit
checkAnnotTooGeneral ty resolved =
  let ids = sigTvarIds resolved
  if listLen ids < listLen resolved || hasDupI ids then
    pushTypeError "T-TYPE-TOO-GENERAL" (annotTooGeneralMsg ty)
  else
    ()

inferMatch : TcEnv -> Mono -> List Arm -> Mono
inferMatch env scrutTy arms =
  let result = freshVar ()
  let _ = inferArms env scrutTy result arms
  let _ = checkMatchExhaustive scrutTy arms
  let _ = checkMatchRedundant scrutTy arms
  result
-- Type-aware exhaustiveness (`check_match`): run AFTER the arms have unified
-- the scrutinee type, so `scrutTy` is fully resolved when we read its head.

-- The non-exhaustive-`match` warning (note the em-dash).  The redundancy pass
-- is not ported — only the exhaustiveness warning.  When the Maranget witness
-- algorithm can name the uncovered case (`nonExhaustiveMsg`) the message is
-- specialised to name the scrutinee type + the missing constructor; this
-- generic form is the fallback if no witness is recoverable.
nonExhaustiveMatchWarning : String
nonExhaustiveMatchWarning =
  "Warning: non-exhaustive match. Not all cases are covered"

-- Warn if an all-wildcard query is still useful against the matrix of the
-- non-guarded arms — i.e. some scrutinee value escapes every arm.  Guarded arms
-- are excluded (their guard may fail at runtime), matching the reference.
checkMatchExhaustive : Mono -> List Arm -> Unit
checkMatchExhaustive scrutTy arms =
  let rows = nonGuardedRows arms
  if useful driverState.value.matchOracle.value (matchCol0Type scrutTy) rows [PWild] then
    let (msg, help) = nonExhaustiveMsg scrutTy rows
    driverState.value.matchWarnings := TcDiag "W-NONEXHAUSTIVE" 2 !currentLoc msg help None :: driverState.value.matchWarnings.value
  else ()

-- ── unreachable / redundant match-arm warning (W-UNREACHABLE-ARM) ──────────
-- An arm is unreachable when its pattern is already fully covered by an EARLIER
-- *unguarded* arm: those arms fire unconditionally, so no value ever reaches
-- this one.  We fold arms left-to-right, accumulating a matrix of the preceding
-- UNGUARDED arm patterns, and flag any arm whose pattern is not `useful` against
-- it (`patUnreachable`).  Guarded predecessors are excluded (their guard may fail
-- at runtime, leaving a later same-shape arm reachable), which keeps the check
-- conservative — we flag only arms provably dead via unconditional predecessors.
-- The warning carries the ARM's own loc (its body span) so the caret points at
-- the dead arm, not the match head.
unreachableArmWarning : String
unreachableArmWarning = "Warning: unreachable match arm. This pattern is already covered by an earlier arm"

checkMatchRedundant : Mono -> List Arm -> Unit
checkMatchRedundant scrutTy arms =
  checkRedundantGo (matchCol0Type scrutTy) [] omEmpty False arms

-- PERF: `prec` accumulates the preceding arms' patterns and is PREPENDED to, so
-- it holds them in REVERSE arm order.  It used to be built with `prec ++ [[dp]]`,
-- which copies the whole accumulator once per arm — O(N²) allocation on a match
-- with many arms, and the dominant allocation source in the redundancy check.
--
-- Reversing the rows is sound because `useful` is a PREDICATE OVER THE SET of
-- matrix rows ("does some value match the query and no row?"): `specializeCon` /
-- `specializeLit` / `defaultMatrix` are row-wise filters, and the only decision
-- that reads rows in order is `inferCol0Type`, which just needs SOME column-0
-- constructor to name the column's type — and it is consulted only when `col0`
-- is `None`, i.e. when the scrutinee type has no concrete head, in which case no
-- arm carries a constructor pattern and there is no head constructor to find in
-- either order.
checkRedundantGo : Option TabKey -> List (List Pat) -> OrdMap Unit -> Bool -> List Arm -> Unit
checkRedundantGo _ _ _ _ [] = ()
checkRedundantGo col0 prec heads offCol ((Arm pat gs body)::rest) =
  let dp = desugarPat driverState.value.matchOracle.value pat
  let _ = if armUnreachable col0 prec heads offCol dp then
    driverState.value.matchWarnings := (TcDiag "W-UNREACHABLE-ARM" 2 (orElseLoc (exprLoc body) !currentLoc) unreachableArmWarning None None :: driverState.value.matchWarnings.value)
  else ()
  -- Only UNGUARDED, range-free arms contribute to the covered set: a guarded arm
  -- may not fire, and a range collapses to a wildcard that over-states coverage
  -- (patHasRange) — either would produce a false "redundant" on a later arm.
  let contributes = armIsUnguarded gs && not (patHasRange pat)
  let prec2 = if contributes then [dp] :: prec else prec
  let heads2 = if contributes then noteHeadCtor dp heads else heads
  let offCol2 = offCol || (contributes && not (isConPat dp))
  checkRedundantGo col0 prec2 heads2 offCol2 rest

-- PERF fast path.  `patUnreachable` runs the full Maranget `useful` recursion, which
-- re-scans EVERY preceding row — so the fold as a whole is O(arms²) on a wide match.
-- But a constructor arm `C …` can only be unreachable if some preceding row could
-- match a `C` value, and the only rows that can are (a) rows headed by `C` itself and
-- (b) rows with a WILDCARD head, which match anything.  When neither exists,
-- `specializeCon C` yields the EMPTY matrix and `useful _ _ [] _` is `True` by
-- definition — the arm is reachable — so the recursion is guaranteed to say
-- "reachable" and we can skip it outright.
--
-- `heads` is the set of head constructors of the preceding contributing rows and
-- `offCol` records whether any of them has a NON-constructor head.  `offCol` is a
-- deliberate over-approximation of "has a wildcard head" (it also trips on a literal
-- head, which `specializeCon` would in fact discard): erring towards `True` only ever
-- costs us the fast path and falls back to the exact check, never an answer.
armUnreachable : Option TabKey -> List (List Pat) -> OrdMap Unit -> Bool -> Pat -> Bool
armUnreachable col0 prec heads offCol (PCon c args)
  | not offCol && not (omHasKey c heads) = False
  | otherwise =
    patUnreachable driverState.value.matchOracle.value col0 prec (PCon c args)
armUnreachable col0 prec _ _ dp =
  patUnreachable driverState.value.matchOracle.value col0 prec dp

noteHeadCtor : Pat -> OrdMap Unit -> OrdMap Unit
noteHeadCtor (PCon c _) heads = omInsert c () heads
noteHeadCtor _ heads = heads

isConPat : Pat -> Bool
isConPat (PCon _ _) = True
isConPat _ = False

-- Only UNGUARDED arms contribute to the covered set (a guarded arm may not fire).
armIsUnguarded : List Guard -> Bool
armIsUnguarded [] = True
armIsUnguarded (_::_) = False

-- Build the specialised warning: recover a concrete uncovered pattern (the
-- Maranget witness) and name it, plus the scrutinee type when it has a real
-- head name.  Falls back to the generic wording if no witness is recoverable
-- (keeps the warning firing whenever `useful` should, never naming a wrong
-- constructor).  Actionable-fix hint (F dimension): when a witness IS
-- recoverable, append a concrete-edit suggestion using the witness string
-- VERBATIM (so `Triangle _` reads as `Triangle _`, not `Triangle`) and return it
-- as the `Some` help so `--json`'s `help` field carries it too.  #159: returns
-- `(message, Option help)` so the caller can stash both in the warning's TcDiag —
-- no more message-keyed `matchWarningHelp` side channel.
nonExhaustiveMsg : Mono -> List (List Pat) -> (String, Option String)
nonExhaustiveMsg scrutTy rows = match usefulWitness driverState.value.matchOracle.value (matchCol0Type scrutTy) rows 1
  Some (w::_) =>
    let witnessStr = renderWitness w
    let hint = "add a '\{witnessStr} => …' arm, or a '_' wildcard arm to catch the rest."
    let msg = "Warning: non-exhaustive match\{tyOfMsg (matchCol0Type scrutTy)}. Missing case: '\{witnessStr}'; \{hint}"
    (msg, Some hint)
  _ => (nonExhaustiveMatchWarning, None)

-- Name the scrutinee type (skip the synthetic tuple type names, which aren't
-- user-facing — the witness pattern already reads as a tuple).
-- ⚠️ Reads the bare NAME out of the key (`tabKeyName`) on purpose: this is
-- witness PROSE, not a lookup, and its text must not change for any program
-- whose diagnostic does not change.
tyOfMsg : Option TabKey -> String
tyOfMsg None = ""
tyOfMsg (Some k) =
  let t = tabKeyName k
  if isTupleTyName t then "" else " of '\{t}'"

isTupleTyName : String -> Bool
isTupleTyName t = stringLength t >= 7 && stringSlice 0 7 t == "__tuple"

-- one single-column matrix row per non-guarded arm (its desugared pattern)
nonGuardedRows : List Arm -> List (List Pat)
nonGuardedRows [] = []
nonGuardedRows ((Arm pat [] _)::rest) =
  [desugarPat driverState.value.matchOracle.value pat] :: nonGuardedRows rest
nonGuardedRows ((Arm _ _ _)::rest) = nonGuardedRows rest

-- the head type name of the scrutinee, for the matrix's column-0 oracle: a
-- TCon/TApp head gives the type name; a tuple has no TCon head, so it maps to a
-- synthetic per-arity tuple type (mirrors the reference's col0_type).
--
-- ⚠️ ANSWER-PRESERVING CLASSIFICATION, and it is a REQUIRED property rather
-- than a style choice.  `headTyconNameMono` is the gate — it decides `Some` vs
-- `None` on exactly the `Mono` head nodes it decided them on before, so `TFun`
-- stays `None` (#1617, deliberate) and falls through to `inferCol0Type`, and a
-- rigid head still produces a key that MISSES the table exactly as today's
-- bare `Some n` missed it.  `headTyconMono` is consulted only to UPGRADE a key
-- that is already going to be `Some`, never to change whether it is `Some`.
--
-- Composing the two existing projections is deliberate: they already owe each
-- other an arm for every new `Mono` head node, and a third independent
-- `match headMonoNode` arm set here is one more the next person would forget.
matchCol0Type : Mono -> Option TabKey
matchCol0Type ty = match headTyconNameMono ty
  None => None
  Some n => match headTyconMono ty
    Some (HkDecl k) => Some k
    Some (HkRigid _) => Some (TkBare NsType n)
    None => Some (TkBare NsType n)

inferArms : TcEnv -> Mono -> Mono -> List Arm -> Unit
inferArms _ _ _ [] = ()
inferArms env scrutTy result ((Arm pat gs body)::rest) =
  let _ = inferArm env scrutTy result pat gs body
  inferArms env scrutTy result rest

inferArm : TcEnv -> Mono -> Mono -> Pat -> List Guard -> Expr -> Unit
inferArm env scrutTy result pat gs body =
  let pr = inferPat env pat
  let _ = unify (fst pr) scrutTy
  let envBody = inferArmGuards (extendLocalVars env (snd pr)) gs
  unify result (infer envBody body)

-- Thread an arm's guard qualifiers left-to-right (mirror of lib/typecheck.ml's
-- EMatch guard fold): a `GBool` must be `Bool` and leaves the env unchanged; a
-- `GBind p e` infers `e`, binds `p` against it, and extends the env so the bound
-- vars are in scope for LATER qualifiers and the arm body.
inferArmGuards : TcEnv -> List Guard -> TcEnv
inferArmGuards env [] = env
inferArmGuards env ((GBool g)::rest) =
  let _ = unify (infer env g) (tconBuiltin "Bool")
  inferArmGuards env rest
inferArmGuards env ((GBind p e)::rest) =
  let te = infer env e
  let pr = inferPat env p
  let _ = unify (fst pr) te
  inferArmGuards (extendLocalVars env (snd pr)) rest

inferLetGroup : TcEnv -> List LetBind -> Expr -> Mono
inferLetGroup env binds body =
  let _ = checkLetGroupBindsLocated binds  -- #799
  let env2 = processLetGroup env binds
  infer env2 body

-- ── data declarations → constructor schemes ───────────────────────────────
registerData : TcEnv -> Decl -> TcEnv
registerData env (DData { dataName = name, dataParams = params, dataCtors = variants, dataOrigin = o }) = registerVariants o env name params variants
-- DECLARATION MINT (#1110/#1111 A-2.3): `tyAliasOrigin` is the alias's own
-- identity, stamped by `stampDeclOrigins` at the module that declared it — the
-- same source `registerVariants` takes `dataOrigin`/`newtypeOrigin` from, and
-- for the same reason (see its 🚨 note: it must not come from ambient state).
registerData env (DTypeAlias { tyAliasName = name, tyAliasParams = params, tyAliasRhs = rhs, tyAliasOrigin = o }) =
  perRun.value.aliasTableRef := (tyTabKey o name, (params, rhs))::perRun.value.aliasTableRef.value
  env
registerData env (DNewtype { newtypeName = name, newtypeParams = params, newtypeCtor = con, newtypeFieldTy = fty, newtypeOrigin = o }) = registerVariants o env name params [Variant con (ConPos [fty])]
-- ⚠️ #1557 A-3.5c: THE `DInterface` ARM IS GONE, and its absence is the point.
-- #822 registered each interface type-parameter's slot kinds here, into
-- `ifaceParamKindsRef`, *"because every consumer must see the table BEFORE the first
-- signature is elaborated, which is exactly registerAllData's slot"*.  That timing
-- constraint dissolved with the table: neither surviving consumer reads a ref at all
-- — `declGradedScope` computes the kinds from the very declaration it is elaborating,
-- and stage K's `CE` computes them once in the driver PREAMBLE, before any module
-- walks.  An interface therefore contributes nothing to `registerData` and falls
-- through to the catch-all below.
registerData env _ = env

-- ── record metadata registration & instantiation ──────────────────────────
-- registerRecordInfoKeyed uses a distinct registry KEY and result TYPE name:
-- for a record they coincide, but a named-field data variant is keyed by its
-- constructor (DInterface) while its values have the data type (Decl).
-- (`o` is the DECLARATION's identity, carried down from `registerVariants` — see
-- its note.  It belongs to `typeName`, not to `key`: the result type is the data
-- type, and a named-field variant is keyed by its constructor.)
registerRecordInfoKeyed : TyConOrigin -> String -> String -> List String -> List Field -> Unit
registerRecordInfoKeyed o key typeName params fields =
  let paramVars = freshVars (listLen params)
  let tvs = zipL params paramVars
  let result = applyParams (tconFrom o typeName) paramVars
  let fieldMonos = map (recFieldMono tvs) fields
  let ri = RecordInfo (map monoTyvarId paramVars) result fieldMonos (omFromPairs (reverseL fieldMonos) omEmpty)
  perRun.value.recordByNameRef := omInsert key ri perRun.value.recordByNameRef.value
  perRun.value.fieldOwnersRef := addFieldOwners key (map fst fieldMonos) perRun.value.fieldOwnersRef.value

-- Add `key` as an owner of each of its field names in the field→owners multimap.
-- Order/dedup is not maintained here — fieldOwnerNames `sortUniqS`es the value on
-- read — so this only needs to preserve the SET of owner keys per field.
addFieldOwners : String -> List String -> OrdMap (List String) -> OrdMap (List String)
addFieldOwners _ [] m = m
addFieldOwners key (fn::rest) m =
  addFieldOwners key rest (omInsert fn (key :: fromOption [] (omLookup fn m)) m)

recFieldMono : List (String, Mono) -> Field -> (String, Mono)
recFieldMono tvs (Field fn ty) = (fn, fromAstType tvs ty)

lookupRecordByName : String -> Option RecordInfo
lookupRecordByName name = omLookup name perRun.value.recordByNameRef.value

-- instantiate a record's quantified params with fresh vars.  Rebuilds ALL fields —
-- used by the record-CREATE and record-PATTERN paths, which must see every declared
-- field (missing-field check / binding each pattern field).  The single-field access
-- and record-update paths use `instantiateRecordShared` + the field index instead so
-- they never rebuild all N fields per access (issue #980).
instantiateRecord : RecordInfo -> (Mono, List (String, Mono))
instantiateRecord (RecordInfo paramIds result fields _) =
  let subst = freshSubst paramIds
  (substMono subst [] result, map (substField subst) fields)

-- Instantiate ONLY the result type, returning the shared param substitution so the
-- caller can instantiate individual fields on demand (via the field index).  The
-- fresh-var allocation is identical to `instantiateRecord` (both call `freshSubst
-- paramIds`); only the per-field `substMono` trees for UNACCESSED fields are skipped,
-- and those allocate no fresh tyvars, so tyvar numbering is byte-identical.
instantiateRecordShared : RecordInfo -> (List (Int, Mono), Mono)
instantiateRecordShared (RecordInfo paramIds result _ _) =
  let subst = freshSubst paramIds
  (subst, substMono subst [] result)

recordFieldMap : RecordInfo -> OrdMap Mono
recordFieldMap (RecordInfo _ _ _ idx) = idx

recordFieldNames : RecordInfo -> List String
recordFieldNames (RecordInfo _ _ fields _) = map fst fields

substField : List (Int, Mono) -> (String, Mono) -> (String, Mono)
substField subst (fn, fm) = (fn, substMono subst [] fm)

-- DECLARATION MINT (#1110).  This head Mono becomes every constructor's scheme
-- RETURN type, so it is the head `headTyconMono` reads at every dispatch goal —
-- the goal side of the key whose impl side (`headTyconTy`) has had identity
-- since resolve started stamping.  `o` is `DData.dataOrigin` /
-- `DNewtype.newtypeOrigin`, threaded from `registerData`'s record pattern.
--
-- 🚨 IT MUST COME FROM THE DECL, NOT FROM AMBIENT STATE.  `registerAllData` runs
-- over `importedCtorTypeDecls` — OTHER modules' decls — so a "current module"
-- id would attribute every imported type to the importer.  That is the same
-- class of wrongness #1219 eliminated on the flat path, and it is why this unit
-- was blocked until the decl-layer carriers landed (#1225).
registerVariants : TyConOrigin -> TcEnv -> String -> List String -> List Variant -> TcEnv
registerVariants o env name params variants =
  let kinds = inferParamKinds params variants
  let _ = recordParamKinds o name kinds
  let paramReprs = mintParamReprs kinds
  let tvs = ktypeTvs params kinds paramReprs
  let etbl = krowEtbl params kinds paramReprs
  let paramTyIds = collectTyIds paramReprs
  let rowEffvarIds = collectRowEffvarIds paramReprs
  let result = applyParams (tconFrom o name) paramReprs
  let _ = registerNamedFieldVariants o name params variants
  addVariants env tvs etbl paramTyIds rowEffvarIds result variants

-- The sole place that ADDS AN ENTRY to `dataParamKindsRef`.  (It is not the ref's only
-- writer: `declEnvSeedDataUniverse` replaces the whole list with stage K's projection at
-- the reading module's ordinal — it was `loadDataUniverse` copying a `crossRun`
-- accumulator until A-3.2b — and `freshPerRun`/`resetState` re-init it to `[]`.  Those set
-- the TABLE; this is the only thing that registers a TYPE.)  Prepends, so a later
-- registration shadows an earlier one
-- under `lookupAssoc`'s first-match — the module's own decls are registered as a FRONT
-- overlay over the data universe and therefore win, which is the ordering every reader
-- assumes (see the `dataEnv` binding in checkBodyImpl).
-- (`o` is the DECLARATION's identity — #1111 A-2.3; see `tyTabKey`.)
recordParamKinds : TyConOrigin -> String -> List Kind -> Unit
recordParamKinds o name kinds =
  let entry = (tyTabKey o name, kinds)
  perRun.value.dataParamKindsRef := entry::perRun.value.dataParamKindsRef.value

-- A data param is KRow iff its name appears in a field's effect-tail position
-- (`<e>`); else KType (the common case).  Inferred from usage — no syntax.
inferParamKinds : List String -> List Variant -> List Kind
inferParamKinds params variants =
  let tailNames = flatMap variantFieldTailNames variants
  map (p => if contains p tailNames then KRow else KType) params

variantFieldTailNames : Variant -> List String
variantFieldTailNames (Variant _ payload) =
  flatMap effTailNames (payloadAstTypes payload)

payloadAstTypes : ConPayload -> List Ty
payloadAstTypes (ConPos tys) = tys
payloadAstTypes (ConNamed fields _) = map fieldTyOf fields

fieldTyOf : Field -> Ty
fieldTyOf (Field _ ty) = ty

-- ── #822: interface type-parameter kinds (graded interfaces) ──────────────
-- EFFECTS-SEMANTICS §6 "Graded interfaces": an interface may abstract over a
-- ROW-INDEXED constructor (`f : Row -> Type -> Type`), so that its methods can
-- carry the grade in the type index (`gandThen : f e a -> (a -> <e> f e b) ->
-- f e b`, the graded-lite degenerate the spec admits today).  Data types already
-- have per-parameter kinds (dataParamKindsRef, inferred from a variant field's
-- effect tail by inferParamKinds); interfaces had NO kind source at all, so an
-- abstract head `f e a` elaborated to an opaque `TApp` in which `e` was a plain
-- TYPE variable — which is why the graded-lite signature was rejected outright
-- (T-EFFECT-ARG-UNCOVERED: `f e b` contributed no return-position occurrence).
--
-- Inference mirrors inferParamKinds one level up: slot i of typaram `p` is KRow
-- iff SOME application `p … a_i …` in a method signature puts a bare NAME at slot
-- i that the SAME signature also uses in an effect-tail position (`<e>`).  The
-- per-interface union matters: `gpure : a -> f e a` alone would infer slot 0 as
-- KType, and disagreeing slot kinds across two methods of one interface would
-- elaborate the same index to a row in one and a tyvar in the other.
--
-- ⚠️ #1557 A-3.5c RETIRED THE TABLE, NOT THE INFERENCE.  `registerIfaceParamKinds`/
-- `registerIfaceParamKindsGo` and the `ifaceParamKindsRef`/`universeIfaceParamKinds`
-- pair they wrote into are GONE.  The inference above is unchanged and now has
-- exactly two consumers, both of which call `ifaceParamKindsOf` directly on the
-- DECLARATION they are elaborating: `declGradedScope` (the per-method scope) and
-- `classEnvRowsOf`'s `ceParamKinds` (stage K's `CE`, which is what
-- `checkGradedImplTys` now reads).  The retired writer's own comment already said the
-- table was dead weight kept only because *"removing it is a separate
-- behaviour-preserving change with its own goldens"* — this is that change.
anyKRow : List Kind -> Bool
anyKRow [] = False
anyKRow (KRow::_) = True
anyKRow (_::rest) = anyKRow rest

kindsEq : List Kind -> List Kind -> Bool
kindsEq [] [] = True
kindsEq (KType::a) (KType::b) = kindsEq a b
kindsEq (KRow::a) (KRow::b) = kindsEq a b
kindsEq _ _ = False

-- ── #1557 A-3.5c: `insertIfaceParamKinds`/`ifaceSlotKey` STOOD HERE ──────────
-- The table they wrote is retired (see the note above `anyKRow`); the KEY SHAPE
-- they minted survives in stage K's `CE` — `ceRowKey` is `regKeyOfTab (ifaceTabKey
-- o name)` and the slot is supplied POSITIONALLY by `ceRowParamKinds`, which is
-- the same (identity, slot) pair without a composite key to mint.  The history
-- below is kept because it is the derivation behind `declGradedScope` carrying
-- its scope as an argument, and that is still live.
--
-- ONE key shape: the interface's IDENTITY plus the slot ORDINAL
-- (`regKeyTabAt (ifaceTabKey o iface) i`, #1111 A-2.4).  It was the bare string
-- `"\{iface}@\{i}"` until this unit, which is #1257: an ordinary interface and a
-- graded one, same bare name, unrelated modules, one shared key.
-- 🚨 THE SLOT IS AN ORDINAL AND STAYS ONE.  It is deliberately NOT spliced into the
-- identity's name field — `"Same@0"` is not the name of anything, and putting it
-- there re-creates a bare-string composite inside the very identity that exists to
-- remove one (see `RegKey`'s doc-comment in `types/registry.mdk`).
-- ⚠️ An earlier cut of #822 ALSO stored the bare typaram NAME, so that the
-- elaboration seams — which see a `TyVar h` spine head carrying no interface
-- context — could look it up.  That was an S0: `rowArgNames`/`fromAstTypeE` are the
-- GENERAL signature elaborators (sigToSchemeTvs, astTypeFreshTbl), not an
-- interface-method-only seam, so a program-global `f ↦ [KRow, KType]` was adopted by
-- every unrelated `f a b` in the program — a plain top-level signature
-- (`bad : f Int a -> f String a` type-checked, both arguments erased to `<>` by
-- rowArgOf's catch-all), every OTHER module through the data universe (which is not
-- import-scoped), and the prelude itself (arity-1 `[KRow]` collides with `Mappable`/
-- `Applicative`/`Thenable`/`Foldable`, turning one clean diagnostic into 45
-- mislocated ones).  Poisoning could not save it: an interface-local type-parameter
-- name is simply not a program-global key.  The scope now travels as an explicit
-- argument instead — see declGradedScope and rowArgNamesIn.
-- (`o` is the DECLARATION's identity — `DInterface.ifaceOrigin`, threaded from
-- `registerData`'s record pattern.  Same source, same reason, as
-- `recordParamKinds`' `dataOrigin`: it must not come from ambient state, because
-- `registerAllData` also runs over OTHER modules' decls.)
-- The scope derived STRAIGHT FROM THE DECLARATION being elaborated: the same
-- `ifaceParamKindsOf` inference stage K's `ceParamKinds` runs, on the very methods
-- whose signatures are about to be built.  No name, no table, no lookup — structurally unforgeable.
declGradedScope : List String -> List IfaceMethod -> List (String, List Kind)
declGradedScope [] _ = []
declGradedScope (p::ps) methods =
  declGradedScopeAdd
    p
    (ifaceParamKindsOf p methods)
    (declGradedScope ps methods)

declGradedScopeAdd : String -> List Kind -> List (String, List Kind) -> List (String, List Kind)
declGradedScopeAdd p kinds rest
  | anyKRow kinds = (p, kinds)::rest
  | otherwise = rest

-- Slot kinds of interface typaram [p].  Arity is the FIRST application's; an
-- application at any other arity is ignored (every lookup site guards on the arity
-- anyway, so a mixed-arity head simply stays opaque).
ifaceParamKindsOf : String -> List IfaceMethod -> List Kind
ifaceParamKindsOf p methods = match flatMap (ifaceMethodVarApps p) methods
  [] => []
  apps@((args0, _)::_) => ifaceSlotKinds (listLen args0) 0 (filterList (a => listLen (fst a) == listLen args0) apps)

-- every application of [p] in one method signature, paired with that signature's
-- effect-tail names (the "same signature" side of the KRow rule).
ifaceMethodVarApps : String -> IfaceMethod -> List (List Ty, List String)
ifaceMethodVarApps p (IfaceMethod _ mty _) =
  let tails = dedup (effTailNames mty)
  map (args => (args, tails)) (varHeadApps p mty)

ifaceSlotKinds : Int -> Int -> List (List Ty, List String) -> List Kind
ifaceSlotKinds arity i apps
  | i >= arity = []
  | otherwise = (if anySlotIsRow i apps then KRow else KType) :: ifaceSlotKinds arity (i + 1) apps

anySlotIsRow : Int -> List (List Ty, List String) -> Bool
anySlotIsRow _ [] = False
anySlotIsRow i ((args, tails)::rest) = match nthTy i args
  Some (TyVar n) => contains n tails || anySlotIsRow i rest
  _ => anySlotIsRow i rest

nthTy : Int -> List Ty -> Option Ty
nthTy _ [] = None
nthTy i (t::rest)
  | i <= 0 = Some t
  | otherwise = nthTy (i - 1) rest

-- every application whose SPINE HEAD is the type VARIABLE [p], as its argument
-- list.  The head of a spine is an atom (TyCon/TyVar), so recursing through the
-- arguments alone covers the whole tree.
varHeadApps : String -> Ty -> List (List Ty)
varHeadApps p (TyApp a b) =
  let sp = tyAppSpine (TyApp a b)
  varHeadHere p (fst sp) (snd sp) ++ flatMap (varHeadApps p) (snd sp)
varHeadApps p (TyFun a b) = varHeadApps p a ++ varHeadApps p b
varHeadApps p (TyTuple ts) = flatMap (varHeadApps p) ts
varHeadApps p (TyEffect _ _ t) = varHeadApps p t
varHeadApps p (TyConstrained _ t) = varHeadApps p t
varHeadApps _ _ = []

varHeadHere : String -> Ty -> List Ty -> List (List Ty)
varHeadHere p (TyVar h) args
  | h == p = [args]
  | otherwise = []
varHeadHere _ _ _ = []

-- one representation per param shared across all ctors: KType → fresh TVar,
-- KRow → a TEff wrapping a fresh effvar (the row the param stands for).
mintParamReprs : List Kind -> List Mono
mintParamReprs [] = []
mintParamReprs (KType::ks) = freshVar () :: mintParamReprs ks
mintParamReprs (KRow::ks) =
  TEff (EffRow [] (Some (freshEffvar ()))) :: mintParamReprs ks

-- KType param names → their TVar (the tvs map fromAstTypeE consults for tyvars)
ktypeTvs : List String -> List Kind -> List Mono -> List (String, Mono)
ktypeTvs (p::ps) (KType::ks) (r::rs) = (p, r) :: ktypeTvs ps ks rs
ktypeTvs (p::ps) (_::ks) (_::rs) = ktypeTvs ps ks rs
ktypeTvs _ _ _ = []

-- KRow param names → the effvar cell inside their TEff repr, so a field's `<e>`
-- and a nested `Async e a` row-arg resolve to the SAME cell the result carries.
krowEtbl : List String -> List Kind -> List Mono -> List (String, Ref Effvar)
krowEtbl (p::ps) (KRow::ks) ((TEff (EffRow _ (Some cell)))::rs) =
  (p, cell) :: krowEtbl ps ks rs
krowEtbl (p::ps) (_::ks) (_::rs) = krowEtbl ps ks rs
krowEtbl _ _ _ = []

collectTyIds : List Mono -> List Int
collectTyIds ((TVar cell)::rs) = tyvarId cell :: collectTyIds rs
collectTyIds (_::rs) = collectTyIds rs
collectTyIds [] = []

collectRowEffvarIds : List Mono -> List Int
collectRowEffvarIds ((TEff (EffRow _ (Some cell)))::rs) =
  effvarId cell :: collectRowEffvarIds rs
collectRowEffvarIds (_::rs) = collectRowEffvarIds rs
collectRowEffvarIds [] = []

-- a named-field data variant (`C { f : T, … }`, e.g. ast's DInterface) carries a
-- record-shaped payload: register its field layout keyed by the CONSTRUCTOR name
-- but with the DATA TYPE as result type, so `C { f, … }` patterns / `C { … }`
-- literals resolve (the positional ctor scheme is still added by addVariants).
-- (`o` is `tyName`'s declaration identity, carried from `registerVariants`.)
registerNamedFieldVariants : TyConOrigin -> String -> List String -> List Variant -> Unit
registerNamedFieldVariants _ _ _ [] = ()
registerNamedFieldVariants o tyName params ((Variant cname (ConNamed fields _))::rest) =
  let _ = registerRecordInfoKeyed o cname tyName params fields
  registerNamedFieldVariants o tyName params rest
registerNamedFieldVariants o tyName params (_::rest) =
  registerNamedFieldVariants o tyName params rest

freshVars : Int -> List Mono
freshVars n
  | n <= 0 = []
  | otherwise = freshVar () :: freshVars (n - 1)

monoTyvarId : Mono -> Int
monoTyvarId (TVar cell) = tyvarId cell
monoTyvarId _ = 0 - 1

applyParams : Mono -> List Mono -> Mono
applyParams head [] = head
applyParams head (p::ps) = applyParams (TApp head p) ps

addVariants : TcEnv -> List (String, Mono) -> List (String, Ref Effvar) -> List Int -> List Int -> Mono -> List Variant -> TcEnv
addVariants env _ _ _ _ _ [] = env
addVariants env tvs etbl paramTyIds rowEffvarIds result ((Variant cname payload)::rest) =
  let ctorType = foldrFun (payloadTypesE etbl tvs payload) result
  let env2 = addCtor env cname (Forall paramTyIds rowEffvarIds ctorType)
  addVariants env2 tvs etbl paramTyIds rowEffvarIds result rest

payloadTypesE : List (String, Ref Effvar) -> List (String, Mono) -> ConPayload -> List Mono
payloadTypesE etbl tvs (ConPos tys) = map (fromAstTypeE etbl tvs) tys
payloadTypesE etbl tvs (ConNamed fields _) = map (fieldTypeE etbl tvs) fields

fieldTypeE : List (String, Ref Effvar) -> List (String, Mono) -> Field -> Mono
fieldTypeE etbl tvs (Field _ ty) = fromAstTypeE etbl tvs ty

-- ── top-level driver ──────────────────────────────────────────────────────
funClausePair : FunClause -> (List Pat, Expr)
funClausePair (FunClause pats body) = (pats, body)

funDefs : List Decl -> List (String, (List Pat, Expr))
funDefs [] = []
funDefs ((DFunDef _ n pats body)::rest) = (n, (pats, body)) :: funDefs rest
-- Top-level `let rec … with …` (DLetGroup): flatten each binding's clauses to
-- (name, (pats, body)) entries, exactly like a multi-clause DFunDef, so the SCC
-- builder groups the mutually-recursive members and assigns them schemes.  Mirrors
-- lib/typecheck.ml, which feeds DLetGroup bindings into the same letrec-group path.
funDefs ((DLetGroup _ binds)::rest) = letGroupDefs binds ++ funDefs rest
funDefs ((DAttrib _ d)::rest) = funDefs (d::rest)
funDefs (_::rest) = funDefs rest

letGroupDefs : List LetBind -> List (String, (List Pat, Expr))
letGroupDefs [] = []
letGroupDefs ((LetBind n clauses)::rest) = map (tcClauseDef n) clauses
  ++ letGroupDefs rest

tcClauseDef : String -> FunClause -> (String, (List Pat, Expr))
tcClauseDef n c = (n, funClausePair c)

-- D2 fix: mirrors oracle is_syntactic_lambda (lib/typecheck.ml:2518-2521).
-- True iff the expression is an explicit lambda at the top level.
-- ⚠️ #807 (pre-existing, out of scope here): does NOT see through an ELoc
-- wrapper, so a zero-param `let rec f = x => …` clause — whose RHS the parser
-- wraps in ELoc — is WRONGLY rejected as non-function even though it plainly
-- is one. Confirmed this predates #799's fix (reproduces identically against
-- pre-#799 top-level `let rec`, the only call site old enough to hit it) —
-- not something introduced by the block/expr-level guards added here.
isSyntacticLambda : Expr -> Bool
isSyntacticLambda (ELam _ _) = True
isSyntacticLambda _ = False

-- D2 fix: check all top-level DLetGroup declarations for non-function recursive
-- bindings, mirroring the oracle's LetRecNonFunction guard
-- (lib/typecheck.ml:2596-2602, process_letrec_group).  A binding is illegal
-- when ALL its clauses have zero params AND none is a syntactic lambda.
-- Pushes the error into typeErrors for each violating member.
checkLetRecDecls : List Decl -> Unit
checkLetRecDecls [] = ()
checkLetRecDecls ((DLetGroup _ binds)::rest) =
  let _ = checkLetBinds binds
  checkLetRecDecls rest
checkLetRecDecls (_::rest) = checkLetRecDecls rest

checkLetBinds : List LetBind -> Unit
checkLetBinds [] = ()
checkLetBinds ((LetBind name clauses)::rest) =
  let _ = checkLetBind name clauses
  checkLetBinds rest

checkLetBind : String -> List FunClause -> Unit
checkLetBind name clauses
  | allList clauseIsNonFunction clauses =
    pushTypeError "T-NONREC-VALUE-LET" (letRecNonFunctionMsg name)
  | otherwise = ()

clauseIsNonFunction : FunClause -> Bool
clauseIsNonFunction (FunClause [] rhs) = not (isSyntacticLambda rhs)
clauseIsNonFunction (FunClause _ _) = False

letRecNonFunctionMsg : String -> String
letRecNonFunctionMsg name = "'"
  ++ name
  ++ "' is bound by 'let rec' but its right-hand side is not a function"

-- #799: the guard above (checkLetRecDecls/checkLetBind) only walks TOP-LEVEL
-- DLetGroup declarations. BLOCK-level (`let rec x = v` as a DoStmt) and
-- EXPRESSION-level (`let rec x = v in e2`, an ELetGroup) `let rec` reach
-- blockRecLet/inferRecLet/inferLetGroup directly, with no non-function check at
-- all — a non-function binding (e.g. `let rec loop = loop`) silently pre-binds
-- the name to a placeholder Ref and evaluates to it, never erroring.

-- blockRecLet/inferRecLet already have the bound name's (possibly-curried) RHS
-- expr in hand: `curryLam pats e1` for a function-form clause is always an
-- ELam, so this only ever flags the genuinely zero-param, non-lambda case —
-- identical discrimination to clauseIsNonFunction, just on the curried form.
-- Both call sites are ELet, produced ONLY from a singleton binding (a plain
-- `let f a… = e1 [in e2]` or an explicit `let rec` — "with" mutual-grouping was
-- removed), so — unlike ELetGroup below — there is no risk of an innocent
-- bystander binding riding along; mirroring the top-level "not a syntactic
-- lambda ⇒ reject" rule verbatim is safe here. Unlike the top-level call site
-- (which has no expression in hand to locate against), this DOES have the RHS
-- expr and passes it to pushTypeErrorAt via exprLoc (ERROR-QUALITY.md) — but
-- that is a BEST-EFFORT location, not a guaranteed one: exprLoc only recognizes
-- an ELoc/EDoOrigin wrapper, and not every Expr shape the parser produces is
-- wrapped in one (e.g. a bare `EBinOp` RHS like `let rec x = x + 1` has no
-- ELoc, so exprLoc returns None and the diagnostic falls back to the zero
-- range — same as the top-level guard's own unlocated call). A wrapped RHS
-- (the common case — most expressions ARE ELoc-wrapped) gets a real range.
checkRecBindNonFunction : String -> Expr -> Unit
checkRecBindNonFunction name e
  | isSyntacticLambda e = ()
  | otherwise = pushTypeErrorAt "T-NONREC-VALUE-LET" (exprLoc e) (letRecNonFunctionMsg name)

-- inferLetGroup's ELetGroup is DIFFERENT: it is the SAME node `where` clauses
-- desugar to (parser.mdk whereEol/whereTail/guard-arm-where — verified: no
-- `rec` keyword involved, no AST field distinguishing the two), and a `where`
-- group routinely bundles plain, NON-recursive value helpers alongside real
-- functions (e.g. stdlib/list.mdk's `split`: `where sepLen = length sep; go
-- ys = …` — sepLen never mentions itself or any sibling). Applying
-- checkRecBindNonFunction's blunt "not a lambda ⇒ reject" rule here false-
-- positived on exactly that (confirmed against the tree before landing this).
--
-- So this check is narrower and more precise instead of broader: a zero-param,
-- non-lambda clause is illegal only if its RHS EAGERLY (i.e. not deferred
-- behind a nested lambda) mentions itself or a NOT-YET-INSTALLED sibling — the
-- actual hazard (evalLetGroup pre-binds every member's cell to Ref VUnit and
-- installs each member's value in SOURCE ORDER, so an eager reference to a
-- cell installed BEFORE this one is already set — safe — while a reference to
-- itself or a cell installed AFTER this one reads stale VUnit — unsafe).
--
-- Concretely: for the clause at index i, only a self-or-FORWARD reference
-- (index >= i) is illegal; a BACKWARD reference (index < i) is the ordinary,
-- safe `where`-clause shape (`f x = b where a = x + 1; b = a + 100` — `b`
-- referencing the earlier `a` is fine, `a` referencing the later `b` would not
-- be). checkLetGroupBindsGo threads exactly that suffix: at each step the
-- current binding's own name is prepended to the REST of the list (every
-- sibling that installs after it), so "names" passed down is always "self +
-- forward", never "self + every sibling" — an earlier false-positive this
-- fixed (confirmed against the tree: it rejected working `where`-bound values
-- that only referenced an EARLIER sibling).
checkLetGroupBindsLocated : List LetBind -> Unit
checkLetGroupBindsLocated = checkLetGroupBindsGo

letBindName : LetBind -> String
letBindName (LetBind name _) = name

checkLetGroupBindsGo : List LetBind -> Unit
checkLetGroupBindsGo [] = ()
checkLetGroupBindsGo ((LetBind name clauses)::rest) =
  let selfAndForward = name :: map letBindName rest
  let _ = checkClausesNonFunctionLocated selfAndForward name clauses
  checkLetGroupBindsGo rest

checkClausesNonFunctionLocated : List String -> String -> List FunClause -> Unit
checkClausesNonFunctionLocated names name clauses
  | allList clauseIsNonFunction clauses && anyClauseEagerlyRefsGroup names clauses = pushTypeErrorAt "T-NONREC-VALUE-LET" (clausesLoc clauses) (letRecNonFunctionMsg name)
  | otherwise = ()

anyClauseEagerlyRefsGroup : List String -> List FunClause -> Bool
anyClauseEagerlyRefsGroup names clauses =
  anyList (clauseEagerlyRefsGroup names) clauses

clauseEagerlyRefsGroup : List String -> FunClause -> Bool
clauseEagerlyRefsGroup names (FunClause _ rhs) = anyMember names (eagerRefs rhs)

clausesLoc : List FunClause -> Option Loc
clausesLoc [] = None
clausesLoc ((FunClause _ rhs)::_) = exprLoc rhs

-- Names `e` reads WITHOUT first going under a lambda (a lambda DEFERS
-- evaluation, so a reference inside one cannot observe a still-uninstalled
-- letrec-group cell). Deliberately UNDER-approximates: an Expr shape not
-- explicitly handled falls to the catch-all `[]` (no eager reference
-- detected) rather than guessing — that can only make this check MORE
-- permissive than exhaustive coverage would, never less, so an unhandled
-- shape is a missed catch (no worse than status quo before #799's fix), not a
-- new false positive. Mirrors marker.mdk's collectVars (the DCE reference
-- walk) with ONE change: collectVars descends into ELam bodies (DCE needs
-- every eventually-reachable name); this stops at ELam (its body is deferred,
-- not eager).
eagerRefs : Expr -> List String
eagerRefs (EVar x) = [x]
eagerRefs (EVarId x _) = [x]
eagerRefs (EApp a b) = eagerRefs a ++ eagerRefs b
eagerRefs (ELam _ _) = []
eagerRefs (ELet _ _ _ e1 e2) = eagerRefs e1 ++ eagerRefs e2
eagerRefs (ELetGroup bs e2) = flatMap eagerRefsLetBind bs ++ eagerRefs e2
eagerRefs (EMatch e0 arms) = eagerRefs e0 ++ flatMap eagerRefsArm arms
eagerRefs (EIf c t el) = eagerRefs c ++ eagerRefs t ++ eagerRefs el
eagerRefs (EBinOp _ a b _) = eagerRefs a ++ eagerRefs b
eagerRefs (EUnOp _ a _) = eagerRefs a
eagerRefs (EInfix op a b) = op :: eagerRefs a ++ eagerRefs b
eagerRefs (EFieldAccess e0 _ _) = eagerRefs e0
eagerRefs (ERecordCreate _ fs) = flatMap eagerRefsFieldAssign fs
eagerRefs (ERecordUpdate e0 fs _) = eagerRefs e0
  ++ flatMap eagerRefsFieldAssign fs
eagerRefs (EVariantUpdate _ e0 fs) = eagerRefs e0
  ++ flatMap eagerRefsFieldAssign fs
eagerRefs (EArrayLit es) = flatMap eagerRefs es
eagerRefs (EListLit es) = flatMap eagerRefs es
eagerRefs (ETuple es) = flatMap eagerRefs es
eagerRefs (EIndex e0 i _) = eagerRefs e0 ++ eagerRefs i
eagerRefs (ERangeList lo hi _) = eagerRefs lo ++ eagerRefs hi
eagerRefs (ERangeArray lo hi _) = eagerRefs lo ++ eagerRefs hi
eagerRefs (ESlice e0 lo hi _ _) = eagerRefs e0 ++ eagerRefs lo ++ eagerRefs hi
eagerRefs (EBlock stmts) = flatMap eagerRefsDoStmt stmts
eagerRefs (EDo stmts) = flatMap eagerRefsDoStmt stmts
eagerRefs (EAnnot e0 _) = eagerRefs e0
eagerRefs (EHeadAnnot e0 _) = eagerRefs e0
eagerRefs (EStringInterp parts) = flatMap eagerRefsInterp parts
eagerRefs (EGuards arms) = flatMap eagerRefsGuardArm arms
eagerRefs (ESection (SecRight _ e0)) = eagerRefs e0
eagerRefs (ESection (SecLeft e0 _)) = eagerRefs e0
eagerRefs (EAsPat _ e0) = eagerRefs e0
eagerRefs (EMapLit _ kvs) = flatMap eagerRefsPair kvs
eagerRefs (ESetLit _ es) = flatMap eagerRefs es
eagerRefs (ELoc _ e) = eagerRefs e
eagerRefs (EDoOrigin _ e) = eagerRefs e
eagerRefs _ = []

eagerRefsLetBind : LetBind -> List String
eagerRefsLetBind (LetBind _ clauses) = flatMap eagerRefsClauseAllPats clauses

-- Unlike the group-membership test above (which only examines zero-param
-- clauses), a NESTED ELetGroup's own function-form members are legitimately
-- deferred (their body only runs once applied) — so only fold in a nested
-- zero-param clause's refs eagerly; a nested function clause's body is safe
-- to skip, matching the ELam short-circuit above.
eagerRefsClauseAllPats : FunClause -> List String
eagerRefsClauseAllPats (FunClause [] rhs) = eagerRefs rhs
eagerRefsClauseAllPats (FunClause _ _) = []

eagerRefsArm : Arm -> List String
eagerRefsArm (Arm _ gs body) = flatMap eagerRefsGuard gs ++ eagerRefs body

eagerRefsGuard : Guard -> List String
eagerRefsGuard (GBool e) = eagerRefs e
eagerRefsGuard (GBind _ e) = eagerRefs e

eagerRefsGuardArm : GuardArm -> List String
eagerRefsGuardArm (GuardArm gs body) = flatMap eagerRefsGuard gs
  ++ eagerRefs body

eagerRefsFieldAssign : FieldAssign -> List String
eagerRefsFieldAssign (FieldAssign _ e) = eagerRefs e

eagerRefsDoStmt : DoStmt -> List String
eagerRefsDoStmt (DoExpr e) = eagerRefs e
eagerRefsDoStmt (DoBind _ e) = eagerRefs e
eagerRefsDoStmt (DoLet _ _ _ e) = eagerRefs e
eagerRefsDoStmt _ = []

eagerRefsInterp : InterpPart -> List String
eagerRefsInterp (InterpExpr e) = eagerRefs e
eagerRefsInterp _ = []

eagerRefsPair : (Expr, Expr) -> List String
eagerRefsPair (k, v) = eagerRefs k ++ eagerRefs v

groupNames : List (String, (List Pat, Expr)) -> OrdMap Unit -> List String
groupNames [] _ = []
groupNames ((n, _)::rest) seen = match omLookup n seen
  Some _ => groupNames rest seen
  None => n :: groupNames rest (omInsert n () seen)

-- process a let-group (where clauses): bind names, infer, generalize
processLetGroup : TcEnv -> List LetBind -> TcEnv
processLetGroup env binds =
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let placeholders = map letBindPlaceholder binds
  let env2 = extendLocalVars env placeholders
  let _ = inferLetBinds env2 (zipL binds placeholders)
  let _ = exitLevel ()
  -- PLAN.md #11: ground ambiguous Num-only vars (not arg-reachable from any
  -- where-binding's type) before this group generalizes.  Scoped to this group's
  -- newly added obligations.
  let addedObls = wWindow perRun.value.implObls oblN0
  let _ = defaultGroupNum addedObls (map (p => schemeMono (snd p)) placeholders)
  let _ = registerAmbiguousConstraints addedObls (map (p => schemeMono (snd p)) placeholders)   -- RETPOS soundness
  -- #866: hoisted out of generalizeGroup's per-binding recursion (both sources are
  -- fixed for the whole group), so an N-member group scans the pin sets ONCE.  The
  -- dict half is kept in (id, iface) form so each member can record its own pin note
  -- (the diagnostic names the interface); the method half carries no interface and
  -- contributes ids only.
  let dictPairs = dictForwardedPairs callN0 dictN0
  let pinned = methodConstrainedIds () ++ map fst dictPairs
  -- Notes come from BOTH channels (methodConstrainedPairs is note-only and cannot
  -- change [pinned]); a where-helper is frequently pinned by the METHOD channel, and
  -- passing only the dict half left every such binding with no explanation.
  let notePairs = methodConstrainedPairs () ++ dictPairs
  let genv = generalizeGroup env pinned notePairs (zipL binds placeholders)
  -- Round-2 adversarial break "let-alias evasion" (#816): a LOCAL constrained
  -- binding (`let f = hh` re-generalizing `hh : Num x => x -> x`) previously
  -- registered NOTHING in schemeObligationsRef — only top-level SCCs did — so a
  -- later use `f x` instantiated no obligation at all: the one recorded at the
  -- RHS occurrence stayed on a var the generalization then orphaned, Int
  -- defaulting quietly satisfied it, and a scheme-var instantiation sailed
  -- through check into an eval panic / native SEGFAULT.  Register the group
  -- exactly as processSCC does; instantiateVarTracked's per-use re-recording
  -- then feeds the same call-obligation window every checker reads.  Name
  -- collisions across bodies are safe: the obligation ids are the scheme's own
  -- quantified ids, and substMonos skips entries whose ids a different scheme's
  -- instantiation does not map.
  let callOblsDelta = callOblsWindow callN0
  -- #827/#838 I2: register EVERYWHERE (gate flipped from `inRigidityBodyRef`).  The
  -- uniform deferral (checkUndeterminedObligation RULE 2) makes a generalizable
  -- where/let var defer into the enclosing scheme rather than trip an ambiguity
  -- reject, closing the orphaned-local-constraint S0 (#827).  See registerLocalScheme.
  -- #838 I5: dict-slot forwarding rides callOblsDelta's PCallSlot obligations (see
  -- registerLocalScheme); the redundant `allDictObls` re-derivation is retired.
  let _ = registerSchemeObligations omEmpty [] callOblsDelta addedObls (groupSchemesOf genv binds)
  genv

-- the generalized (name, scheme) pairs of a just-closed local group
groupSchemesOf : TcEnv -> List LetBind -> List (String, Scheme)
groupSchemesOf _ [] = []
groupSchemesOf genv ((LetBind name _)::rest) = match lookupVar genv name
  Some sch => (name, sch) :: groupSchemesOf genv rest
  None => groupSchemesOf genv rest

letBindPlaceholder : LetBind -> (String, Scheme)
letBindPlaceholder (LetBind name _) = (name, monoScheme (freshVar ()))

inferLetBinds : TcEnv -> List (LetBind, (String, Scheme)) -> Unit
inferLetBinds _ [] = ()
inferLetBinds env ((LetBind _ clauses, (_, sch))::rest) =
  let _ = unify (schemeMono sch) (inferClauses env (map funClausePair clauses))
  inferLetBinds env rest

schemeMono : Scheme -> Mono
schemeMono (Forall _ _ t) = t

-- Phase / GAP-2 phase-a: the tyvar ids that some ARG-position method occurrence
-- discriminates on (the receiver monos queued in pendingArgStamps).  A where-helper
-- whose own type shares one of these is *method-constrained by the enclosing fn's
-- dispatch* — its receiver var unifies (at the helper's call site) with the
-- enclosing fn's constraint var that activeDictVars maps to a dict param.  We must
-- NOT generalize over such a var, or the helper instantiates a fresh (id /= the
-- enclosing constraint var) so resolveArgStamp can't see the in-scope dict → the
-- in-body method route degrades to RNone → arg-tag → native panic on a primitive
-- receiver.  Keeping it monomorphic links the ids (normalize collapses them) so the
-- existing resolveArgStamp routes RDict and dict_pass threads the enclosing dict in.
-- Sound: an UNconstrained helper var (e.g. `pair x = (x,x)`) never appears in a
-- method-usage mono, so it still generalizes; only dispatch-constrained vars (which
-- compiler cannot dict-pass per-where-helper anyway) are pinned, matching their
-- single enclosing-typed use.
methodConstrainedIds : Unit -> List Int
methodConstrainedIds _ = flatMap
  (s => monoUnboundIds (argStampMono s))
  perRun.value.pendingArgStamps.value

argStampMono : PendingEntry -> Mono
argStampMono (PendingEntry _ _ am _ _ _) = am

-- #866: the same ids methodConstrainedIds yields, paired with the INTERFACE of the
-- method that discriminates on them, so a binding pinned by the METHOD channel gets the
-- same explanatory diagnostic as one pinned by the dict channel.  NOTE-ONLY — the pin
-- set itself still comes from methodConstrainedIds, so an entry whose method has no
-- registered interface silently contributes no note (and falls back to the plain
-- mismatch) rather than dropping out of the pin and changing what typechecks.
methodConstrainedPairs : Unit -> List (Int, String)
methodConstrainedPairs _ =
  flatMap argStampPairs perRun.value.pendingArgStamps.value

-- "" when the method's interface is not registered on this path — see
-- pinnedLocalMismatch, which degrades to interface-free wording rather than dropping
-- the explanation.  Dropping was the earlier behaviour and it is why a `where` helper
-- pinned by this channel got a bare mismatch with no help at all.
argStampPairs : PendingEntry -> List (Int, String)
argStampPairs (PendingEntry name _ am _ _ _) =
  map (id => (id, fromOption "" (ifaceOfMethodName name))) (monoUnboundIds am)

-- #866 — a SIBLING of methodConstrainedIds above, NOT the same pin.  Both decline a
-- local generalization for the same underlying reason, and the two sets are unioned by
-- processLetGroup, but they are not the same shape and should not be read as such:
--
--   methodConstrainedIds   ONE channel (pendingArgStamps), read UNWINDOWED — the whole
--                          module's arg-position METHOD dispatch sites.
--   dictForwardedIds       TWO channels (dictApps + the call-obligation window), each
--                          WINDOWED to this binding's own inference.  Two because the
--                          two typecheck entry points populate different ones (see the
--                          load-bearing note below); windowed because these channels are
--                          module-wide and an unwindowed read would be O(module) per
--                          binding — a quadratic in a file this size.
--
-- What it covers: a call to a constrained top-level FUNCTION (`needsOrd : Ord a => …`),
-- whose per-slot dict routes live in `dictApps`.  A local binding is
-- NOT dict-abstracted — dict_pass prepends `$dict_…` params to top-level defs and
-- impl methods only, never to a `where`/`let` member (which lowers to ONE lifted
-- lambda with ONE shared route ref, so it structurally cannot serve two
-- instantiations anyway).  So if the group generalizes over the very var such a call
-- site constrains, the site's mono is left an ORPHAN: at resolveDictApps time it is
-- neither pinned to a head tycon (→ RKey) nor registered in activeDictVars (→ RDict),
-- so it falls through to RNone and the emitter hands the callee a NULL dict (`call
-- @mdk_…needsOrd(i64 0, …)` → `inttoptr i64 0; load` → SIGSEGV), while `check` greens
-- and eval survives on its arg-tag fallback.  Declining to generalize keeps the var
-- the SAME cell the use site unifies (`h a b` → the enclosing `top`'s param var, or a
-- concrete `Int`), so the existing resolveDictApps stamps RDict/RKey and the dict
-- actually arrives.  Windowed to the binding's OWN inference (the marks every caller
-- already takes), so this is O(sites in this body), never O(module).
--
-- ⚠️ BOTH channels are read, and that is LOAD-BEARING, not belt-and-braces.  The two
-- typecheck entry points MARK DIFFERENT TREES: the run/emit path (elaborateModules)
-- marks constrained-fn occurrences EDictAt (`prePassDictArg … dictNames0 …`) so its
-- sites land in `dictApps`, while the CHECK path (markModules) passes `prePassDict
-- rpNames []` — an EMPTY dict-name set, deliberately, since check needs no routes — so
-- `dictApps` is empty there and only the CALL-OBLIGATION channel sees the constraint.
-- Pinning on `dictApps` alone declines generalization on the emit path while `check`
-- still generalizes, and the two then disagree: `check` greens a local helper used at
-- two types and the emitter silently commits to whichever it saw first (MEASURED: `let
-- sh v = shows v` at Bool then String printed `TrueTrue`).  That trades this issue's
-- loud SIGSEGV for a SILENT wrong answer — strictly worse.  Reading both keeps the two
-- entry points' generalization decisions identical, so an inconsistent use is an
-- ordinary unification error at CHECK time, where it belongs.
-- Each id is paired with the INTERFACE whose dict that slot forwards, so the
-- diagnostic can name it (`… needs an 'Ord' instance`) instead of saying
-- "a constraint".  ⚠️ A constrained callee contributes EVERY slot, not just the first:
-- `needsBoth : (Ord a, Eq b) => …` pushes ONE dict-app carrying BOTH monos, so both `a`
-- and `b` land here.  That is correct — a local binding can forward neither — and it is
-- why a per-VARIABLE pin (quantify `freeGenVars \ pinned`) is a no-op on exactly the
-- two-constraint shapes it looks like it should rescue: the subtracted set already
-- covers every constrained var.  Measured on a built binary during #1021 review.
dictForwardedPairs : Int -> Int -> List (Int, String)
dictForwardedPairs callN0 dictN0 = flatMap dictAppMonoIds (wWindow perRun.value.dictApps dictN0)
  ++ flatMap callOblMonoIds (callOblsWindow callN0)

dictAppMonoIds : (Ref (List Route), List Mono, List String, List (List Mono), Option Loc) -> List (Int, String)
dictAppMonoIds (_, monos, ifaces, _, _) =
  flatMap monoIdsWithIface (zipL monos ifaces)

callOblMonoIds : (IfaceRef, List Mono, Option Loc) -> List (Int, String)
callOblMonoIds (iface, monos, _) =
  flatMap (m => monoIdsWithIface (m, iface.irName)) monos

monoIdsWithIface : (Mono, String) -> List (Int, String)
monoIdsWithIface (m, iface) = map (id => (id, iface)) (monoUnboundIds m)

-- #866: the pin decision AND the note pinnedLocalExplain needs, in one pass, so the
-- two can never disagree about whether a binding was pinned.  [name]/[loc]
-- describe the BINDING (what the user must change), not the use site that will later
-- collide.  Records one entry per pinned var actually free in [t]; a binding with no
-- pinned var records nothing and returns False, leaving generalization untouched.
pinLocalIfDictForwarded : Int -> Int -> String -> Option Loc -> Mono -> Bool
pinLocalIfDictForwarded callN0 dictN0 name loc t =
  recordPinnedLocals
    name
    loc
    (freeGenVars perRun.value.currentLevel.value t)
    (dictForwardedPairs callN0 dictN0)
    t

-- Shared by all five pin sites: record one note per dict-forwarded var that is free
-- in [t], and report whether any fired.  Returns False (and records nothing) for a
-- binding with no dict-forwarded var, so generalization is untouched there.
recordPinnedLocals : String -> Option Loc -> List Int -> List (Int, String) -> Mono -> Bool
recordPinnedLocals name loc free pairs t =
  -- dedup by tyvar id: the two channels overlap, and a single constraint slot can be
  -- recorded by more than one path, so the same var arrives several times.  One note
  -- per VAR keeps pinnedLocalExplain's "how many bindings match" question meaningful.
  let hits = dedupPairsById (filterList (p => containsI (fst p) free) pairs)
  if isEmptyL hits then False
  else
    perRun.value.pinnedLocals := (map (p => (tvarMonoOfIn t (fst p), name, snd p, loc)) hits ++ perRun.value.pinnedLocals.value)
    True

-- The cause-agnostic fallback (see generalizeGroup): every free var this binding was
-- pinned on, with NO interface name, so the diagnostic still explains itself.
recordPinnedLocalsGeneric : String -> Option Loc -> List Int -> List Int -> Mono -> Bool
recordPinnedLocalsGeneric name loc free constrained t = recordPinnedLocals
  name
  loc
  free
  (map (id => (id, "")) (filterList (id => containsI id constrained) free))
  t

dedupPairsById : List (Int, String) -> List (Int, String)
dedupPairsById ps = dedupPairsByIdGo ps []

dedupPairsByIdGo : List (Int, String) -> List Int -> List (Int, String)
dedupPairsByIdGo [] _ = []
dedupPairsByIdGo (p::rest) seen
  | containsI (fst p) seen = dedupPairsByIdGo rest seen
  | otherwise = p :: dedupPairsByIdGo rest (fst p :: seen)

-- The `TVar` cell inside [t] carrying id [id], as a Mono, so a later `normalize` on it
-- recovers whatever the use sites unified it to.  [t] is known to contain it (the
-- caller filtered on freeGenVars t), so the fallback is unreachable in practice.
tvarMonoOfIn : Mono -> Int -> Mono
tvarMonoOfIn t id = fromOption t (findTvarInMono t id)

-- #866 / #1021 review — Blocker 3.  A `Type mismatch` between the two types a PINNED
-- local was used at is not a mistake the user made at the second use site; it is this
-- pin refusing to generalize the BINDING.  Reported as a bare `T-TYPE-MISMATCH` with a
-- caret on the second use, it reads as "your String is a Bool" and names no cause.
--
-- Matching is deliberately CONSERVATIVE — a wrong `help` is worse than none:
--   * the pinned var must have GROUNDED to a concrete head (still-free ⇒ this mismatch
--     is not about it);
--   * its grounded rendering must equal one of the two sides;
--   * the binding must be in the SAME FILE as the error;
--   * exactly ONE BINDING may qualify — if two DIFFERENT local bindings match we
--     cannot say which is responsible, so we say nothing and fall through to the plain
--     mismatch.  ⚠️ The test is on the binding NAME, not on the entry count: a binding
--     with several constrained slots (`needsBoth : (Ord a, Eq b) => …`) records one
--     note PER VAR, so an entry-count test read "2 candidates, bail" and silently
--     suppressed the diagnostic for every multi-constraint callee (measured).
--
-- ⚠️ It deliberately does NOT require the binding to come BEFORE the error. That guard
-- was here and was WRONG: a `where` group is written AFTER the body it serves, so
-- `top n = h n "x" … where h a p q = …` has its binding on a LATER line than the use
-- that collides, and the ordering test silently suppressed the diagnostic for every
-- `where` case (measured — it fell back to a bare `Type mismatch: String vs Bool`).
-- Same-file plus the grounding and uniqueness tests carry the precision instead.
pinnedLocalExplain : Mono -> Mono -> Option (Mono, String, String, Option Loc)
pinnedLocalExplain a b = match filterList (e => pinnedEntryMatches e a b) perRun.value.pinnedLocals.value
  [] => None
  first::rest =>
    if allList (e => pinnedEntryName e == pinnedEntryName first) rest then
      Some first
    else
      None

pinnedEntryName : (Mono, String, String, Option Loc) -> String
pinnedEntryName (_, name, _, _) = name

pinnedEntryMatches : (Mono, String, String, Option Loc) -> Mono -> Mono -> Bool
pinnedEntryMatches (stored, _, _, loc) a b =
  let g = normalize stored
  match headTyconNameMono g
    None => False
    Some _ => (ppMono g == ppMono a || ppMono g == ppMono b)
      && locSameFileAsError loc

-- the binding and the error are in the same file.  An absent loc on either side ⇒ we
-- cannot establish the relation ⇒ False (fall through to the plain mismatch).
locSameFileAsError : Option Loc -> Bool
locSameFileAsError (Some (Loc bf _ _ _ _)) = match !currentLoc
  Some (Loc ef _ _ _ _) => bf == ef
  None => False
-- No binding loc (an unwrapped where-clause RHS) ⇒ we cannot run the same-file test,
-- so we let the remaining guards (concrete grounding, rendering match, one responsible
-- binding) carry it and report at the use site rather than suppressing the explanation
-- entirely.  Suppressing was the earlier behaviour and it silently hid the diagnostic
-- for every `where` helper — a guard that fires on the common case is worse than a
-- guard that is slightly loose on a rare one.
locSameFileAsError None = True

monoUnboundIds : Mono -> List Int
monoUnboundIds t = match normalize t
  TVar cell => [tyvarId cell]
  TCon _ _ => []
  TRigid _ => []
  TApp a b => monoUnboundIds a ++ monoUnboundIds b
  TFun a _ b => monoUnboundIds a ++ monoUnboundIds b
  TEff _ => []

anyIn : List Int -> List Int -> Bool
anyIn xs ys = anyList (x => containsI x ys) xs

-- PLAN.md #11 (locked §0.2): monomorphism-for-Num defaulting.  Before a type [t]
-- is generalized at a let-binding boundary, ground every *ambiguous* tyvar carrying
-- a `Num` constraint to `Int`.  "Ambiguous" = the var is NOT reachable from an
-- ARGUMENT position of [t] (a caller can't fix it).  This stops a bare `n = 1` (or
-- an inner `let z = 2`) from generalizing to `Num a => a` / leaking an unbound
-- `Num a` to eval, while leaving a genuinely polymorphic var live: `sum`'s element
-- var in `t a -> a` is reachable from the argument `t a`, so it stays polymorphic
-- (`sum [1.0,…]` still works); `x : Float; x = 0`'s var is already concrete Float
-- (not a generalizable var), so it is untouched.  Mirrors lib/typecheck.ml's
-- default_ambiguous_num: a Num-constrained var (alone OR with another class) that is
-- ambiguous is grounded to Int — the literal's `Num`/`fromInt` representation IS
-- Int, so grounding keeps impl selection deterministic.
--
-- SCOPE (#518): "at a let-binding boundary" above is no longer the whole story — an
-- IMPL METHOD BODY is ALSO a defaulting boundary (inferImplMethod), for the same
-- reason a let-group is: it is a point past which an ambiguous Num var can never be
-- determined, so leaving it unbound hands an UNGROUNDED RECEIVER to the route
-- resolver, which then silently mis-selects an impl.  It is not a let-group, which is
-- why it needed its own call rather than inheriting one.  It defaults strictly LESS
-- than a let-group does — body-local vars only (defaultBodyLocalNum) — because an
-- impl method's vars can ALSO be caller-determined via a method DICT, a channel with
-- no let-group analogue.  This paragraph is the written scope extension; before #518
-- the widening would have existed only as a judgment call in code.
--
-- ⚠️ KNOWN GAP (pre-existing, NOT closed here): monoArgUnboundIds below walks only
-- the DOMAINS of the outermost arrow chain, so a var in RETURN position — or ANY var
-- of a nullary method like `Monoid.empty : a` (a non-TFun type ⇒ this returns [] and
-- protects nothing) — is invisible to defaultGroupNum's exclusion filter.  The two
-- pre-existing call sites (processLetGroup, processSCC) inherit that blind spot.
-- defaultBodyLocalNum sidesteps it at the impl-method site by testing membership in
-- the WHOLE type instead.  Tracked as #563 (which also records why tightening the
-- two let-group sites is NOT obviously safe: there, a return-only var frequently IS
-- ambiguous and SHOULD ground — `let n = 1` — so this filter is not simply wrong).
monoArgUnboundIds : Mono -> List Int
monoArgUnboundIds t = match normalize t
  TFun a _ b => monoUnboundIds a ++ monoArgUnboundIds b
  _ => []

-- the unbound var ids that any pending `Num` obligation in [obls] constrains (the
-- operand monos recorded by recordIfaceObligation / the literal infer arm)
numConstrainedIds : List UObligation -> List Int
numConstrainedIds obls = flatMap numObligIds obls

numObligIds : UObligation -> List Int
numObligIds o = match o.oblProj
  OpMethodOcc _ _ occ =>
    if o.pred.iface.irName == "Num" then
      monoUnboundIds occ
    else
      []
  OpProjected => []

defaultAmbiguousNum : List UObligation -> Mono -> Unit
defaultAmbiguousNum obls t =
  let argIds = monoArgUnboundIds t
  let inT = monoUnboundIds t
  let candidates = dedupI (numConstrainedIds obls)
  groundNumVars
    obls
    (filterList
      (id => containsI id inT && not (containsI id argIds))
      candidates)

-- group-level defaulting: ground every Num-constrained var NOT reachable from an
-- ARGUMENT position of ANY member's type.  [monos] = the group's member placeholder
-- monos; [obls] = ONLY this group's newly-added obligations (an earlier group's
-- already-generalized var must not be touched).  Unlike defaultAmbiguousNum this
-- does NOT require the var to appear in a member's type (a var consumed inside a
-- body surfaces in no type but must still ground — `let n = tag [1,2,3]`).  Mirrors
-- process_letrec_group's group_arg_ids over added_obligs/added_methods.
defaultGroupNum : List UObligation -> List Mono -> Unit
defaultGroupNum obls monos =
  let argIds = flatMap monoArgUnboundIds monos
  let candidates = dedupI (numConstrainedIds obls)
  groundNumVars obls (filterList (id => not (containsI id argIds)) candidates)

-- #518: BODY-LOCAL defaulting — ground only the Num-constrained vars that appear
-- NOWHERE in [memberMono].  Strictly narrower than defaultGroupNum, and the
-- distinction is SOUNDNESS-CRITICAL at an impl-method body, which is why this is a
-- separate primitive rather than a reuse.
--
-- defaultGroupNum's exclusion filter is monoArgUnboundIds, which walks ONLY the
-- domains of the outermost arrow chain.  A var living in RETURN position — including
-- nested inside a return application — is invisible to it and gets ZERO protection.
-- At a let-group that is (mostly) benign: the binding generalizes, so a return-only
-- var is usually ambiguous anyway.  At an IMPL METHOD BODY it is NOT, and the reason
-- is dict-passing: an impl method's OWN method-level constraint var
-- (`lift : Num b => a -> Box b`) is supplied by a DICT at the CALL SITE, so the
-- caller genuinely chooses it (`q : Box Float; q = lift 3` ⇒ b↦Float).  Grounding it
-- to Int here would permanently monomorphise a var the caller had already fixed —
-- MEASURED: `MkBox 0.0` before, `E-PANIC: floatToString: not a Float` after, i.e.
-- trading #518's S0 for a new one.  Return-position type params are exactly what
-- typeclass dispatch concentrates, so this site's density of the triggering shape is
-- far higher than a let-group's.
--
-- Membership in [memberMono] — arg position OR return position — therefore means
-- "determined by the caller (via an argument, an annotation, or a method dict)" and
-- is left alone.  #518's shape is the complement: the element var of `s [1, 2]` in
-- `t _ = s [1, 2]` is consumed entirely inside the body and surfaces nowhere in
-- `t : Option2 Int -> Int`, so nothing outside the body can ever determine it.  That
-- var, and only that var, is what this grounds.
--
-- (Note the membership test is the INVERSE of defaultAmbiguousNum's, which requires
-- the var to be IN the type — `containsI id inT` — and then excludes arg-reachable
-- ones.  Neither existing primitive expresses "in the type at all", hence this one.)
defaultBodyLocalNum : List UObligation -> Mono -> Unit
defaultBodyLocalNum obls memberMono =
  let inType = monoUnboundIds memberMono
  let candidates = dedupI (numConstrainedIds obls)
  groundNumVars obls (filterList (id => not (containsI id inType)) candidates)

-- per-binding defaulting: run defaultAmbiguousNum on each member's placeholder mono
defaultEachMember : List UObligation -> List (String, Mono) -> Unit
defaultEachMember _ [] = ()
defaultEachMember obls ((_, m)::rest) =
  let _ = defaultAmbiguousNum obls m
  defaultEachMember obls rest

-- RETPOS soundness — ambiguous interface constraint (run≠build hole).
-- A method obligation recorded inside a binding whose discriminating tyvar is
-- UNBOUND, UNANCHORED, and appears NOWHERE in the binding's generalized type is
-- genuinely ambiguous (`make`'s result var in `f x = reveal (make (reveal x))`,
-- `f : Thing a => a -> Int`: `make`'s var is tied to neither `a` nor the result).
-- No annotation determines the instance and, with ≥2 impls, eval vs emit default
-- to DIFFERENT impls — a silent run≠build miscompile (RETPOS-DISPATCH-DESIGN.md).
-- We REJECT it by handing the genuine ambiguous DISPATCH mono to the existing
-- undetermined-obligation path (registering it as a call obligation), which
-- rejects (ambiguousImplMsg) under the SAME `Num` / active-dict / impl-count≥2
-- guards an undetermined call site already uses (so a sole-impl interface is never
-- over-rejected and `Num` stays on its literal-defaulting path).  Three filters
-- keep this from firing on legitimately-deferred constraints:
--   • member-type membership (defaultGroupNum's `monoUnboundIds`) — a var IN the
--     binding's type is determined by a caller/annotation;
--   • group LEVEL — a DEEPER var belongs to an inner let/where binding that already
--     generalized + checked it (its obligation merely leaks into our addedObls
--     window, e.g. `maximum`'s `where step` comparing at step's own element var);
--   • ANCHORED vars — a var that also appears inside a CONCRETE-HEADED dispatch mono
--     of this binding (`Set _a` from a `Set {…}` literal's FromEntries/Display) is
--     ground at emit by head-pinning, so it is sound-but-deferred, NOT ambiguous.
-- The obligation's record-site loc rides along (currentLoc is stale post-HM).
registerAmbiguousConstraints : List UObligation -> List Mono -> Unit
registerAmbiguousConstraints obls monos =
  -- groupLevel = the level THIS group generalizes at (we run post-exitLevel, so the
  -- outer currentLevel + 1).  anchoredIds = every unbound var that appears inside a
  -- concrete-headed dispatch mono across this group's obligations (head-pinnable).
  let anchoredIds = flatMap concreteHeadVarIds (flatMap oblDispatchMonos obls)
  registerAmbiguousGo obls (perRun.value.currentLevel.value + 1) (flatMap monoUnboundIds monos) anchoredIds

-- the dispatch monos this obligation discriminates on (empty for Num, whose
-- ambiguity is handled by literal defaulting).
oblDispatchMonos : UObligation -> List Mono
oblDispatchMonos o = match o.oblProj
  OpProjected => []
  OpMethodOcc typarams mty occ =>
    oblDispatchMonosGo o.pred.iface.irName typarams mty occ

oblDispatchMonosGo : String -> List String -> Ty -> Mono -> List Mono
oblDispatchMonosGo iface typarams mty occ
  | iface == "Num" = []
  -- F0: dispatch/ambiguity keys off the RECEIVER (dispatch) typaram only, NOT every
  -- interface typaram.  A return-only typaram (`v` in `Get c v where get1 : c -> v`)
  -- is determined by the impl AFTER the receiver picks it, so it must never be
  -- registered as an independent impl-selection obligation — else the still-unbound
  -- `v`, grounded later by groundMultiParamObligations, is re-checked as a single-mono
  -- obligation with no matching impl (`No impl of Get for Int`).  dispatchTyparams
  -- = [first typaram], the same receiver classification argDispatchOfMethod uses.
  | otherwise = dispatchMonosOf (dispatchTyparams typarams) mty occ

-- the unbound var ids carried by a dispatch mono WITH a concrete head (`Set _a` →
-- [_a]); a bare-var dispatch (`t0`) anchors nothing.
concreteHeadVarIds : Mono -> List Int
concreteHeadVarIds dm = match headTyconNameMono dm
  Some _ => monoUnboundIds dm
  None => []

registerAmbiguousGo : List UObligation -> Int -> List Int -> List Int -> Unit
registerAmbiguousGo [] _ _ _ = ()
registerAmbiguousGo (o::rest) groupLevel memberIds anchoredIds =
  let _ = match o.oblProj
    OpMethodOcc typarams mty occ => registerOneAmbiguous o.pred.iface typarams mty occ o.loc groupLevel memberIds anchoredIds
    OpProjected => ()
  registerAmbiguousGo rest groupLevel memberIds anchoredIds

-- For each of this obligation's DISPATCH monos (the interface-param positions, via
-- dispatchMonosOf — NOT the whole method type), register it as a call obligation
-- when it carries an escaped, unanchored this-group var.  Pushing the dispatch mono
-- (not the method type) is essential: checkUndeterminedObligation's guards
-- (`headTyconMono`, `activeDictVarOf`, `allConcreteHeads`) inspect a bare dispatch
-- mono and do NOT traverse `TFun`, so a concrete-headed dispatch and a forwarded-
-- dict element var are correctly NOT flagged, while a bare-var dispatch with ≥2
-- impls and no anchor (`Thing t0` from `make`) IS rejected.
registerOneAmbiguous : IfaceRef -> List String -> Ty -> Mono -> Option Loc -> Int -> List Int -> List Int -> Unit
registerOneAmbiguous iface typarams mty occ loc groupLevel memberIds anchoredIds
  | iface.irName == "Num" = ()
  -- F0: register call obligations for the RECEIVER (dispatch) typaram only — a
  -- return-only typaram is impl-determined, not an impl-selection key (see
  -- oblDispatchMonos).
  | otherwise = registerDispatchMonos iface (dispatchMonosOf (dispatchTyparams typarams) mty occ) loc groupLevel memberIds anchoredIds

registerDispatchMonos : IfaceRef -> List Mono -> Option Loc -> Int -> List Int -> List Int -> Unit
registerDispatchMonos _ [] _ _ _ _ = ()
registerDispatchMonos iface (dm::rest) loc groupLevel memberIds anchoredIds =
  let ambig = filterList (p => snd p <= groupLevel && not (containsI (fst p) memberIds) && not (containsI (fst p) anchoredIds)) (monoUnboundVarLevels dm)
  let _ = if isEmptyL ambig then
    ()
  else
    recordObl Predicate { iface = iface, args = [dm] } 0 PCallSlot loc
  registerDispatchMonos iface rest loc groupLevel memberIds anchoredIds

-- the (id, level) of every UNBOUND tyvar in [t] (sibling of monoUnboundIds, but
-- carrying the level so registerOneAmbiguous can tell a this-group constraint var
-- from a deeper inner-generalized one that merely leaked into the obligation list).
monoUnboundVarLevels : Mono -> List (Int, Int)
monoUnboundVarLevels t = match normalize t
  TVar cell => [(tyvarId cell, tyvarLevel cell)]
  TCon _ _ => []
  TRigid _ => []
  TApp a b => monoUnboundVarLevels a ++ monoUnboundVarLevels b
  TFun a _ b => monoUnboundVarLevels a ++ monoUnboundVarLevels b
  TEff _ => []

-- ground each id to Int by unifying the live var carrying it (found among [obls]'
-- Num operand monos — refs alias post-unify, grounding any grounds all)
groundNumVars : List UObligation -> List Int -> Unit
groundNumVars _ [] = ()
groundNumVars obls (id::rest) =
  let _ = match liveNumVarGo id obls
    Some m => unify m (tconBuiltin "Int")
    None => ()
  groundNumVars obls rest

liveNumVarGo : Int -> List UObligation -> Option Mono
liveNumVarGo _ [] = None
liveNumVarGo id (o::rest) = match o.oblProj
  OpMethodOcc _ _ occ => if o.pred.iface.irName == "Num" then match findTvarInMono occ id
    Some m => Some m
    None => liveNumVarGo id rest
  else liveNumVarGo id rest
  OpProjected => liveNumVarGo id rest

-- the first [n] entries of a list (the newly-prepended obligations of a group)
takeFirst : Int -> List a -> List a
takeFirst n _
  | n <= 0 = []
takeFirst _ [] = []
takeFirst n (x::xs) = x :: takeFirst (n - 1) xs

-- #837: drop the first [n] entries (the complement of takeFirst) — splits a
-- stamped `coreProg ++ prog0` back into its core/user halves for Flat inference.
dropFirst : Int -> List a -> List a
dropFirst n xs
  | n <= 0 = xs
dropFirst _ [] = []
dropFirst n (_::xs) = dropFirst (n - 1) xs

-- [constrained] is the group's pin set, computed ONCE by processLetGroup:
-- methodConstrainedIds (arg-position method dispatch) ++ dictForwardedIds
-- (constrained-callee dict sites, #866).  Both name tyvars this group must not
-- generalize over — see those two functions for why.
generalizeGroup : TcEnv -> List Int -> List (Int, String) -> List (LetBind, (String, Scheme)) -> TcEnv
generalizeGroup env _ _ [] = env
generalizeGroup env constrained dictPairs (((LetBind name clauses), (_, sch))::rest) =
  let mono = schemeMono sch
  let free = freeGenVars perRun.value.currentLevel.value mono
  -- #866: clausesLoc is the existing idiom for "where this group member is"
  -- (T-NONREC-VALUE-LET uses it).  It is best-effort: exprLoc only recognizes an
  -- ELoc/EDoOrigin wrapper, so an unwrapped RHS yields None and the diagnostic falls
  -- back to reporting at the use site (pushTypeErrorHelpFixAt's orElseLoc) — still with
  -- its explanatory help, just a less precise caret.
  let pinnedHere = anyIn free constrained
  let noted = recordPinnedLocals name (clausesLoc clauses) free dictPairs mono
  -- #866 GUARANTEE: if the pin fired, a note EXISTS.  [dictPairs] carries an interface
  -- per id, but it does not necessarily cover every id in [constrained] — the two pin
  -- channels are populated by different machinery on different entry points, and a
  -- `where` helper is routinely pinned by an id the pair list has no interface for.
  -- Two earlier attempts tried to predict which channel would win and BOTH were wrong
  -- (measured); this is cause-agnostic instead — whatever pinned it, the user gets the
  -- explanation, with interface-free wording when the interface is unknown.
  let _ = if pinnedHere && not noted then
    recordPinnedLocalsGeneric name (clausesLoc clauses) free constrained mono
  else
    False
  let isVal = clausesAreValue env clauses && not pinnedHere
  -- WS-2: α scope-seed — single-clause zero-param bindings only (mirror α's
  -- alphaCollectBinds rule); a multi-clause / parameterized binding is not a
  -- known prefix.
  let env1 = extendLocalVar env name (genRestricted isVal mono)
  let env2 = match clauses
    [FunClause [] rhs] => seedAlphaLets env1 name rhs
    _ => env1
  generalizeGroup env2 constrained dictPairs rest

-- A where-clause binding is a value (generalizable) iff every clause has params
-- (it's a function) or its zero-arg RHS is non-expansive.  Mirrors the oracle
-- `ELetGroup` value test (lib/typecheck.ml:1715-1716).
clausesAreValue : TcEnv -> List FunClause -> Bool
clausesAreValue env clauses = allList (clauseIsValue env) clauses

clauseIsValue : TcEnv -> FunClause -> Bool
clauseIsValue env (FunClause [] rhs) = isNonexpansive env rhs
clauseIsValue _ (FunClause _ _) = True

-- infer a clause group (multi-clause function), unifying all clauses to one type
inferClauses : TcEnv -> List (List Pat, Expr) -> Mono
inferClauses env clauses =
  let v = freshVar ()
  let _ = unifyClauses env v clauses
  v

unifyClauses : TcEnv -> Mono -> List (List Pat, Expr) -> Unit
unifyClauses _ _ [] = ()
unifyClauses env v ((pats, body)::rest) =
  let _ = unify v (inferLam env pats body)
  unifyClauses env v rest

-- ── elaboration: resolve return-position method dispatch (RKey) ────────────
-- Rewrite each return-position method occurrence to EMethodAt (with a fresh route
-- ref), type-check (recording the sites), then stamp each site's route from its
-- now-resolved result type.  Returns the SAME tree (refs filled) for eval.
-- DRIVER-COLLAPSE Phase 5: the flat `elaborate` wrapper is DELETED; callers use
-- the 1-module `elaborateOne` (the typed/dict tree of the degenerate 1-module
-- multi path).  `elaborateDict` itself is RETAINED — the EMIT path
-- (core_ir_dict_pp_main / llvm_emit_*_main, argStamp mode) still uses it.

-- ── Phase 0 (DRIVER-COLLAPSE): 1-module wrapper over the multi-module path ──
-- elaborateOne runs the SINGLE flat program [prog] (the user's decls, the live
-- prelude ALREADY shadow-dropped by the caller — same `combined` the flat
-- elaborateDict callers build, minus the joint core) through elaborateModules as
-- the degenerate 1-module list [(rootId, prog)], returning the FLAT shape the flat
-- callers consume: core2 (dict-passed core) ++ the dict-passed module's decls.
--
-- The 1-module case automatically satisfies the flat path's invariants — one
-- resetState (one module ⇒ one checkModuleFullImpl), zero imports ⇒ the full
-- constraint set, and elaborateModules
-- runs the eval-dict layer unconditionally (ARGSTAMP-UNIFY Phase 4), so the
-- return-position constrained-fn dict layer matches the flat elaborateDict.
--
-- NOTE (Phase 0 is DISCOVERY): the dict-name set differs by construction —
-- elaborateModules computes its own via `moduleDictNames` (return-position subset:
-- `preludeReturnPosDictNames coreDecls allDecls ++ returnPosConstrainedSigNames …`)
-- whereas the flat callers pass an externally-built `dictNames`
-- (`preludeReturnPosDictNames livePrelude combined ++ constrainedSigNames userDecls`,
-- the FULL constrained-sig set).  This wrapper takes `coreDecls` SEPARATE (not
-- pre-flattened into prog), exactly as elaborateModules expects, and lets the
-- module path own the dict-set.  ⚠️ This line asserted that diff_flat_vs_onemodule.sh
-- "exists" until 2026-08-13; it did not.  That was a TEMPORARY Phase-0 equivalence
-- harness, DELETED with the rest of the Phase-5 scaffolding (DRIVER-COLLAPSE-PLAN.md,
-- Phase 5), and its property was flat-vs-1-module BYTE-IDENTITY, not this one.  The
-- live grader is test/diff_compiler_flat_vs_onemodule.sh (ARCH B-2.1-a): it PINS the
-- Flat arm's own acceptance and diagnostics, and grades the Flat-vs-Module relation
-- only through a clause true on both sides of the #1564 fix — every arm that ACCEPTS
-- must compute the same value.  Read its header before changing either arm.
export
elaborateOne : List Decl -> List Decl -> (String, List Decl) -> List Decl
elaborateOne runtimeDecls coreDecls (rootId, prog) =
  let (coreD, modules) = elaborateModules runtimeDecls coreDecls [(rootId, prog)]
  coreD ++ flatMap snd modules

-- Dict-passing elaboration (the `=>`-constraint layer).  [dictNames] are the
-- *signatured* constrained functions to dict-pass (the user program's — the
-- prelude keeps arg-tag / RKey dispatch, which already type-checks the goldens).
-- [eligibleNames] are the user fn names that may additionally be PROMOTED when an
-- INFERRED (unsignatured) constraint is discovered (see registerInferredConstraints).
--
-- Two-pass / fixpoint orchestration (mirrors the reference's mark → typecheck →
-- re-mark → typecheck → dict_pass): a mark+typecheck pass discovers each eligible
-- unsignatured fn's inferred constraints (promotedRef); we grow the dict-passed
-- set and re-run until it stabilizes (one layer of a call chain promotes per
-- pass), then mark + typecheck + route + dict_pass the final set.  In the RKey
-- rewrite, each occurrence of a name in the final set becomes an EDictAt (routes
-- filled after inference) and its def gets matching leading dict params.
-- #415 item 3: the ONLY writer of dictEligibleRef / dictEligibleSetRef.  The set is
-- DERIVED from the list here rather than mirrored at each set site, so the two cannot
-- drift: there is no longer a second side for a future edit to be absent from.  (Both
-- former sites hand-wrote `namesToSet <names> omEmpty` next to the list store; the
-- module site additionally recomputed `moduleUserFnNames modules` for the mirror.)
setDictEligible : List String -> Unit
setDictEligible names =
  driverState.value.dictEligibleRef := names
  driverState.value.dictEligibleSetRef := namesToSet names omEmpty

export
elaborateDict : List Decl -> List String -> List String -> List Decl -> List Decl
elaborateDict runtimeDecls dictNames eligibleNames prog =
  driverState.value.superDeclsRef := prog
  let _ = setDictEligible eligibleNames
  driverState.value.implInferEnabled := True
  let allNames = discoverAll runtimeDecls prog dictNames eligibleNames
  driverState.value.argDispatchIdxByIdRef := (argDispatchIndicesById prog)
  -- #1351 L5 (CONTRACT): the NAME SET only — `prePassDictArg` wants the names, not the
  -- indices, and the indices are now answered exclusively by the identity-keyed table above.
  let argNames = map fst (argDispatchIndices prog)
  -- P0-18: [] — the confirmed definer-shadow-emit path is elaborateModules; this
  -- single-file scratch elaborate stays shadow-map-free (byte-identical discovery).
  let prog2 = prePassDictArg (returnPosMethodNames prog ++ methodConstraintNames prog) allNames argNames [] prog
  -- #1280: prelude-FLATTENED path (`prog` already carries it), so the prelude
  -- boundary is unknown here and the scope is builtins-only — the same answer
  -- `checkProgramSeededSplit` gives its own `coreProg0 = []` callers.
  let _ = checkProgramSeeded (externSchemes (externTyOriginScope []) runtimeDecls) prog2
  let _ = expandSupersTable prog2
  let implTable = buildImplTable prog2
  let _ = resolveSites implTable (returnPosMethodNames prog2) perRun.value.pendingSites.value
  let _ = resolveOpSites True implTable perRun.value.pendingBinopSites.value
  let _ = resolveOpSites False implTable perRun.value.pendingUnopSites.value
  let _ = resolveArithSites perRun.value.pendingArithSites.value
  let _ = realizeRecDictApps perRun.value.pendingRecDictApps.value
  let _ = resolveDictApps prog2 implTable perRun.value.dictApps.items.value
  let _ = resolveMethodDicts implTable perRun.value.pendingMethodDicts.value
  let _ = resolveArgStamps implTable perRun.value.pendingArgStamps.value
  dictPass allNames prog2

-- With no eligible names (the RKey-only / typed path), there is nothing to
-- promote — skip discovery entirely so that path stays a single typecheck pass.
discoverAll : List Decl -> List Decl -> List String -> List String -> List String
discoverAll _ _ dictNames [] = dictNames
discoverAll runtimeDecls prog dictNames _ =
  discoverPromoted runtimeDecls prog dictNames

-- Grow the dict-passed set to a fixpoint.  Each pass marks occurrences of the
-- current set as EDictAt and typechecks; registerInferredConstraints populates
-- promotedRef (reset each pass by checkProgramSeeded) with eligible unsignatured
-- fns that picked up a constraint — including a CALLER that inherited one through
-- a now-marked constrained call.  Stop when no new name appears.
discoverPromoted : List Decl -> List Decl -> List String -> List String
discoverPromoted runtimeDecls prog current =
  let prog1 = prePassDict (returnPosMethodNames prog ++ methodConstraintNames prog) current prog
  -- #1280: prelude-flattened discovery pass — builtins-only scope, see `elaborateDict`.
  let _ = checkProgramSeeded (externSchemes (externTyOriginScope []) runtimeDecls) prog1
  discoverNext
    runtimeDecls
    prog
    current
    (dedup (current ++ perRun.value.promotedRef.value))

discoverNext : List Decl -> List Decl -> List String -> List String -> List String
discoverNext runtimeDecls prog current next
  | listLen next == listLen current = current
  | otherwise = discoverPromoted runtimeDecls prog next

-- ── Cause A: module-path promotion fixpoint ───────────────────────────────
-- The multi-module analogue of discoverPromoted/discoverAll.  elaborateModules
-- typechecks each module in its own frame (checkModuleFullImpl), but PROMOTION
-- (deciding which unsignatured fns carry an inferred constraint) needs to see the
-- whole graph at once so a caller in module B that uses a constrained fn from A is
-- discovered.  Mirror the oracle's joint mark→typecheck: flatten runtime ++ core ++
-- all modules into ONE program and run discoverPromoted's fixpoint on it.  The seed
-- is dictEligibleRef (already set to the user modules' fn names).  Returns the
-- promoted names and, as a side effect, seeds crossModuleFunConstraintsRef with the
-- joint-discovered constraint arities (count per promoted fn) so they survive the
-- per-module resetState and dictArityOf can read them at the final dictPass —
-- mirroring how each defining module's own pass re-registers REAL var-ids into
-- activeDictVars (the count must agree; the body routes carry the surviving ids).
-- argNames marks ARG-position method occurrences EMethodAt so inferMethodAt's
-- recordArgSiteFn surfaces an inferred arg-position constraint to inferredConstraintIds
-- (the Cause-A `f s = display s` shape, where the dispatch is the bare method itself).
discoverPromotedModules : List Decl -> List Decl -> List (String, List Decl) -> List String -> List String -> List String
discoverPromotedModules runtimeDecls coreDecls modules rpNames argNames =
  let joint = coreDecls ++ flatMap snd modules
  let dictSeed = moduleDictNames coreDecls joint modules
  let savedSticky = !typeErrorsSticky
  -- issue 1146: the hand-rolled save/restore of this channel is now the SAME
  -- wSnapshot/wRestore pair its obligation-channel siblings make in
  -- inferUserImplBodies.  The `resetState ()` below re-mints `perRun`, so both
  -- restores land on FRESH cells; wRestore reinstates the channel's list AND its
  -- count, where the old two-`setRef` form could only do the list.
  --
  -- ⚠️ THE COUNTER IS ROLLED BACK WITH THE CHANNEL, and must stay that way — the
  -- standing obligation `recordTypeError` states.  This is the ONLY site that rolls
  -- `typeErrors` back, and `freshPerRun` re-mints `errorsDetected` to 0, so restoring
  -- only the channel would leave `typeErrors.n == savedN` beside
  -- `errorsDetected == 0`: a region straddling this would see the speculative pass's
  -- detections vanish.  Nothing observes it today (every `erredDuring` region lives
  -- inside inferDefaultMethod/inferDefaultMethodBody, and `resetState`'s callers are
  -- top-of-pipeline drivers unreachable from inference, so no region straddles this
  -- re-mint) — but the `listLen typeErrors` signal this replaces WAS restored here,
  -- and the counter is now the SOLE control signal with no list to fall back on.
  -- Keep the pair in step rather than relying on the straddle staying impossible.
  --
  -- `typeErrorsSticky` is restored too (below), which is what keeps dedup honest ACROSS
  -- this rollback: a short-circuit can never fire against a message that was rolled out
  -- of the channel, so "a detection implies a stored diagnostic implies a rejected
  -- program" is intact for everything AFTER the window.
  --
  -- ⚠️ INSIDE the window it does not hold, and that is deliberate — this whole pass
  -- exists to typecheck speculatively and DISCARD the diagnostics.  A gate that fires
  -- in here (S1/S2/S3 all run within it, via the joint typecheck's default-method
  -- bodies) is un-stored, un-armed and un-counted afterwards, so it rejects nothing;
  -- what survives is the discovery result, `promoted` + the two `crossRun` snapshots.
  -- That matters because S1's gated block is NOT diagnostics-only: its
  -- `unify expected2 actualTy` mutates union-find state `defaultBodyLocalNum` later
  -- reads (#873), so skipping it moves grounding, hence impl selection.  Outside this
  -- window that is harmless because the program is rejected; here that premise is
  -- unavailable.  NOT DEMONSTRATED (it needs a spurious duplicate-message error inside
  -- a default body during the joint flatten, which no sweep has produced), and it
  -- WIDENS a hazard the pre-1146 `listLen` keying had identically rather than
  -- introducing one.  Full statement: compiler/ERROR-QUALITY.md §6.
  let savedErrSnap = wSnapshot perRun.value.typeErrors
  let savedDetected = perRun.value.errorsDetected.value
  -- Drop the prelude/core defs AND signatures shadowed by a same-named user-module
  -- fn before the SCRATCH joint typecheck.  The joint flatten is bare-name, so a
  -- core fn with a concrete signature (e.g. `isEven : Int -> Bool`) would otherwise
  -- PIN the user's same-named fn's inferred scheme to that concrete type — the
  -- user's genuinely-constrained `isEven x = x % 2 == 0` (inferred `Num a => …`)
  -- would NOT be discovered as promoted, so its define gets no leading dict param
  -- while its body still routes `$dict_isEven_0` (the real per-module pass, where the
  -- user fn shadows the prelude in its own scope, DOES infer the constraint) →
  -- `unbound identifier: $dict_isEven_0` on the run/loader path.  The real per-module
  -- pass already honours shadowing; mirror it here so discovery promotes the user fn.
  let discoveryJoint = dropShadowedCore (moduleUserFnNames modules) coreDecls ++ flatMap snd modules
  let grown = discoverPromotedJoint runtimeDecls discoveryJoint rpNames argNames dictSeed
  let promoted = filterList (n => not (contains n dictSeed)) grown
  let snapshot = promotedConstraints promoted perRun.value.funConstraintsRef.value
  let snapshotIfaces = promotedConstraintIfaces promoted perRun.value.funConstraintIfacesRef.value
  -- B-2.2-f (#1113): the declared-prefix sidecar for the SAME promoted entries.  Without
  -- it every promoted cross-module callee reaches a fill site with no recorded prefix
  -- (module 1 is seeded from this crossRun table), and the sidecar would be vacuous
  -- exactly where it matters.
  -- ⚠️ PRE-EXPANSION on purpose: `expandSupersCross` below APPENDS super slots to
  -- `snapshot`, and the prefix must count what was DECLARED before that append.  It is
  -- read here, before `resetState` re-mints `perRun`, and written after it with the pair.
  let snapshotDeclared = promotedConstraints promoted perRun.value.funConstraintDeclaredRef.value
  -- WS-1b: expand the cross-module snapshot's super slots too, so a cross-module
  -- constrained fn reached from another module under-fills exactly like clamp would.
  -- #994 (B-3-a): kept as ONE tuple from here to the write (`setCrossFunConstraintTables`)
  -- rather than unbundled into two locals.  ⚠️ The expansion must be computed HERE, before
  -- `resetState`, and only the WRITE moved past it.
  -- S-slot-key-vector (#1866): the same promoted filter over the VECTOR table, so the
  -- snapshot expansion keys its slots on the whole predicate exactly as the per-run one
  -- does.  Read here, before `resetState`, with the other three.
  let snapshotArgs = promotedConstraints promoted perRun.value.funConstraintArgsRef.value
  let expandedPair = expandSupersCross joint snapshot snapshotIfaces snapshotArgs
  let _ = resetState ()
  typeErrorsSticky := savedSticky
  let _ = wRestore perRun.value.typeErrors savedErrSnap
  perRun.value.errorsDetected := savedDetected
  let _ = setCrossFunConstraintTables expandedPair
  crossRun.value.crossModuleFunConstraintDeclaredRef := snapshotDeclared
  promoted
-- DRIVER-COLLAPSE Phase 2: discovery is a SCRATCH joint typecheck (see below); its
-- type-error side effects must NOT leak into the STICKY accumulator that gates the
-- build/run exit code.  The joint-flattened program can surface spurious errors
-- (cross-module names that resolve per-module but look ambiguous flattened) that
-- the REAL per-module pass (elabWorker) does not — so snapshot typeErrors +
-- typeErrorsSticky here and restore them after, leaving the gate to reflect only
-- the real per-module typecheck.  On the EMIT path discovery already ran, but
-- elaborateModules's caller (the emit driver) never reads hadTypeErrors, so this
-- was latent; the eval-path build/run gate (typecheckGate) DOES read it.

-- discoverPromotedJoint returns dictSeed GROWN by the newly-promoted user fns;
-- subtract the seed so [promoted] is ONLY the inferred-constraint user fns (the
-- prelude constrained fns in dictSeed are already handled by moduleDictNames +
-- constrainedSigArity — re-snapshotting THEIR joint-discovery arity into
-- crossModuleFunConstraintsRef would override each module's own sig-registered
-- arity and drop the prelude helpers' element-dict args → SIGSEGV).

-- Discovery is a SCRATCH typecheck purely to compute the promoted-name set; its
-- side effects on the shared inference refs (funConstraintsRef/activeDictVars/
-- pendingArgStamps/route refs left by the last checkProgramSeeded) must NOT leak
-- into the real per-module stamping that follows.  resetState wipes them; the
-- promoted arities survive in the snapshot, carried to the real pass via
-- crossModuleFunConstraintsRef.  dictEligibleRef is NOT touched
-- by resetState (set by the driver, constant).

-- Fixpoint body: prePass the joint program (return-position + constrained-fn names
-- → EMethodAt/EDictAt; arg-position method names → EMethodAt), typecheck it whole
-- (checkProgramSeeded resets promotedRef + funConstraintsRef each pass), grow the
-- set by the newly-promoted names, repeat until stable.  Uses prePassDictArg so
-- arg-position dispatch surfaces inferred constraints (recordArgSiteFn → methodSiteFns).
discoverPromotedJoint : List Decl -> List Decl -> List String -> List String -> List String -> List String
discoverPromotedJoint runtimeDecls joint rpNames argNames current =
  let prog1 = prePassDictArg (rpNames ++ methodConstraintNames joint) current argNames [] joint
  -- #1280: prelude-flattened discovery pass — builtins-only scope, see `elaborateDict`.
  let _ = checkProgramSeeded (externSchemes (externTyOriginScope []) runtimeDecls) prog1
  discoverNextJoint
    runtimeDecls
    joint
    rpNames
    argNames
    current
    (dedup (current ++ perRun.value.promotedRef.value))

discoverNextJoint : List Decl -> List Decl -> List String -> List String -> List String -> List String -> List String
discoverNextJoint runtimeDecls joint rpNames argNames current next
  | listLen next == listLen current = current
  | otherwise = discoverPromotedJoint runtimeDecls joint rpNames argNames next

-- the funConstraintsRef entries (name, ids) for the promoted user fns only —
-- snapshot of the joint discovery, carried across resetState by
-- crossModuleFunConstraintsRef so dictArityOf reads the right param count.
-- B-2.2-f (#1113): payload generalized to `a` so the declared-prefix sidecar's SCALAR
-- entries are filtered by the SAME `promoted` list, through the same function, rather
-- than by a third structural copy of this one-line body.
promotedConstraints : List String -> List (String, a) -> List (String, a)
promotedConstraints promoted entries =
  filterList (e => contains (fst e) promoted) entries

-- iface-list analog of promotedConstraints (parallel filter for funConstraintIfacesRef).
promotedConstraintIfaces : List String -> List (String, List IfaceRef) -> List (String, List IfaceRef)
promotedConstraintIfaces promoted entries =
  filterList (e => contains (fst e) promoted) entries

-- the USER modules' top-level fn names (NOT core/prelude) — the promotion-eligible
-- set on the build path.  Mirrors elaborateDict's eligibleNames = funNamesOf userDecls.
moduleUserFnNames : List (String, List Decl) -> List String
moduleUserFnNames modules =
  dedup (flatMap (p => map fst (funDefs (snd p))) modules)

-- Drop every core/prelude DEF and TYPE SIGNATURE whose name a user module
-- redefines, for the SCRATCH joint-discovery typecheck.  Unlike eval's
-- dropShadowed (DFunDef only), this ALSO drops the shadowed DTypeSig — the
-- signature is precisely what would pin the user fn's inferred scheme to the
-- prelude's concrete type and suppress its promotion.  Non-fn decls (impls,
-- interfaces, data) are kept (a user fn name can't shadow them).
dropShadowedCore : List String -> List Decl -> List Decl
dropShadowedCore _ [] = []
dropShadowedCore names ((DFunDef pub n pats body)::rest)
  | contains n names = dropShadowedCore names rest
  | otherwise = DFunDef pub n pats body :: dropShadowedCore names rest
dropShadowedCore names ((DTypeSig pub n ty)::rest)
  | contains n names = dropShadowedCore names rest
  | otherwise = DTypeSig pub n ty :: dropShadowedCore names rest
dropShadowedCore names (d::rest) = d :: dropShadowedCore names rest

-- the user program's top-level functions carrying a `=>` constraint in their
-- signature — the set elaborateDict dict-passes
export
constrainedSigNames : List Decl -> List String
constrainedSigNames prog = flatMap constrainedSigName prog

constrainedSigName : Decl -> List String
constrainedSigName (DTypeSig _ n ty)
  | isConstrainedTy ty = [n]
  | otherwise = []
constrainedSigName _ = []

isConstrainedTy : Ty -> Bool
isConstrainedTy (TyConstrained _ _) = True
isConstrainedTy _ = False

-- The PRELUDE's own `=>`-constrained fns that must ALSO be dict-passed: those
-- whose body uses a return-position method (`when`/`unless` use `pure`), so
-- arg-tag dispatch can't resolve it at a constraint variable's type.  Every OTHER
-- constrained prelude fn (sum/any/elem/clamp/…) uses only arg-position methods —
-- arg-tag already resolves those, and the goldens type-check with them on RKey, so
-- they stay OUT.  [allDecls] supplies the interface set for returnPosMethodNames;
-- bodies come from [preludeDecls] (the shadow-dropped prelude).
export
preludeReturnPosDictNames : List Decl -> List Decl -> List String
preludeReturnPosDictNames preludeDecls allDecls =
  let rpNames = returnPosMethodNames allDecls
  filterList
    (n => anyMember (declBodyVars n preludeDecls) rpNames)
    (constrainedSigNames preludeDecls)

-- D3b-2: the PRELUDE's `=>`-constrained fns that dispatch a method in ARGUMENT
-- position (the ~23 helpers: neq/elem/any/all/find/count/sum/product/maximum/
-- minimum/clamp/flatMap/flat/debugListItems/displayListItems/hashListItems/print/
-- println).  These stay OUT of the eval/golden dict set — arg-tag resolves them in
-- ceval (tagged values) and the goldens type-check with them on RKey — but the
-- NATIVE emit path MUST dict-pass them: arg-tag cannot dispatch on a PRIMITIVE
-- element (an `Int`/`String` immediate carries no cell tag).  The arg-position
-- analogue of preludeReturnPosDictNames: every constrained prelude fn that is NOT
-- already return-position.  Wired (alongside preludeReturnPosDictNames) into the
-- emit + dict_pp-oracle drivers ONLY (llvm_emit_typed_main / core_ir_dict_pp_main),
-- which no golden driver shares — so module/`=== TYPES ===`/eval goldens stay
-- byte-identical; the body sites route RDict $dict_<method>_<slot> through the same
-- activeDictVars layer registerConstraintRegs already builds for return-position.
export
preludeArgPosDictNames : List Decl -> List Decl -> List String
preludeArgPosDictNames preludeDecls allDecls =
  let rpSet = preludeReturnPosDictNames preludeDecls allDecls
  filterList (n => not (contains n rpSet)) (constrainedSigNames preludeDecls)

-- the EVars referenced anywhere in [n]'s definition body (multi-clause: union)
declBodyVars : String -> List Decl -> List String
declBodyVars n decls = flatMap (declBodyVarsOf n) decls

declBodyVarsOf : String -> Decl -> List String
declBodyVarsOf n (DFunDef _ m _ body)
  | n == m = allEVars body
  | otherwise = []
declBodyVarsOf _ _ = []

-- methods whose interface type param appears ONLY in the result (no argument
-- mentions it) — pure/empty/minBound/maxBound/fromInt/… — are return-position
returnPosMethodNames : List Decl -> List String
returnPosMethodNames prog = flatMap returnPosOfDecl prog

returnPosOfDecl : Decl -> List String
returnPosOfDecl (DInterface { typarams, methods, ... }) =
  flatMap (returnPosMethod typarams) methods
returnPosOfDecl _ = []

returnPosMethod : List String -> IfaceMethod -> List String
returnPosMethod typarams (IfaceMethod mname mty _)
  | not (anyArgMentions (dispatchTyparams typarams) (methodArgs mty)) = [mname]
  | otherwise = []

-- argument types of a method (strip leading constraint/effect wrappers + arrows)
methodArgs : Ty -> List Ty
methodArgs (TyConstrained _ t) = methodArgs t
methodArgs (TyEffect _ _ t) = methodArgs t
methodArgs (TyFun a b) = a :: methodArgs b
methodArgs _ = []

anyArgMentions : List String -> List Ty -> Bool
anyArgMentions _ [] = False
anyArgMentions typarams (ty::rest) = argMentions typarams ty
  || anyArgMentions typarams rest

argMentions : List String -> Ty -> Bool
argMentions typarams ty = anyMember (tyVarNames ty) typarams

anyMember : List String -> List String -> Bool
anyMember [] _ = False
anyMember (x::xs) ys = contains x ys || anyMember xs ys

-- rewrite each return-position method occurrence to EMethodAt, and each
-- constrained-fn occurrence (a name in [dictNames]) to EDictAt — both carry a
-- fresh ref the typechecker fills.  The two name sets are disjoint (interface
-- methods vs top-level functions).
prePassDict : List String -> List String -> List Decl -> List Decl
prePassDict rpNames dictNames prog =
  mapProg (rewriteRPDict rpNames dictNames) prog

-- [rpNames] here is the union of return-position methods AND method-level-
-- constrained methods (foldMap): both must become EMethodAt so eval can narrow by
-- the t-route and/or fold on the method-level dicts.
rewriteRPDict : List String -> List String -> Expr -> Expr
rewriteRPDict rpNames dictNames (EVar n)
  | contains n rpNames = EMethodAt n (Ref RNone) (Ref []) (Ref [])
  | contains n dictNames = EDictAt n (Ref [])
  | otherwise = EVar n
rewriteRPDict _ _ e = e

-- D3a: like prePassDict but ALSO rewrite ARG-position method occurrences (names in
-- [argNames]) to EMethodAt, so inferMethodAt can stamp their route from the
-- discriminating-argument type.  [argNames] is populated on EVERY path now (single
-- elaboration mode, #157) — an empty [argNames] would degenerate to the scope-BLIND
-- mapProg rewrite that prePassDict produced.  With argNames non-empty it instead
-- uses the SCOPE-AWARE rewriteArgScoped below:
-- an arg-position interface-method name (in argNames) that is shadowed by a local
-- binder (a parameter, let, lambda arg, or match-pattern variable) stays a plain
-- EVar rather than becoming an EMethodAt.  This mirrors the reference typecheck's
-- Phase-95 `env.locals` guard (lib/typecheck.ml's EVar arm): the OCaml marker is
-- likewise scope-blind and the reference RECOVERS at inference by skipping the
-- scope-blind method table for locally-bound names.  Without it, a compiler
-- function whose parameter happens to share a method name (`arithOp lt rt`,
-- `composeOp gt ht`, `exprToPat … sub`) has that parameter mis-marked as a method
-- occurrence → arg-tag dispatch with no impl groups at emit time.  Gated on
-- argNames so the golden path is provably unchanged.  The rp/an/dn arms are ALL
-- scope-aware on this (emit + run `elaborateDict`) path: a local binder shadowing
-- a return-position method name (`let debug = 99` inside a fn body) keeps the
-- reference a plain EVar so inference resolves it to the local instead of
-- mis-stamping RKey<resultType> and dispatching to the prelude impl.  Mirrors
-- lib/typecheck.ml's `env.locals` guard, which skips the method_iface table for
-- any locally-bound name (the OCaml EVar-arm recovery).  Byte-identical for the
-- corpus (no corpus rp/arg/constrained name is shadowed by a local — the guard
-- only changes behaviour for a genuinely-shadowing local: an arg-method
-- `lt`/`gt`/`sub`, a constrained fn `elem`, or a return-position method `debug`).
-- The non-emit `mapProg` path (argNames == []) stays scope-blind.
-- [shadowMap] (P0-18) is the mangle definer-shadow map — non-empty only on the emit
-- path (argNames non-empty).  The scope-blind `mapProg` path (argNames == []) never
-- has mangled shadows, so it ignores it and stays byte-identical.
prePassDictArg : List String -> List String -> List String -> List (String, String) -> List Decl -> List Decl
prePassDictArg rpNames dictNames [] _ prog =
  mapProg (rewriteRPDictArg rpNames dictNames []) prog
prePassDictArg rpNames dictNames argNames shadowMap prog =
  map (prePassDeclScoped (ArgRw rpNames dictNames argNames shadowMap)) prog

rewriteRPDictArg : List String -> List String -> List String -> Expr -> Expr
rewriteRPDictArg rpNames dictNames argNames (EVar n)
  | contains n rpNames = EMethodAt n (Ref RNone) (Ref []) (Ref [])
  | contains n argNames = EMethodAt n (Ref RNone) (Ref []) (Ref [])
  | contains n dictNames = EDictAt n (Ref [])
  | otherwise = EVar n
rewriteRPDictArg _ _ _ e = e

-- ── scope-aware arg-position prepass (emit path; D3a shadow guard) ───────────
-- The three name sets carried through the scope-threaded rewrite (rp = return-
-- position methods, dn = constrained-fn dict names, an = arg-position methods).
-- rp = return-position methods, dn = constrained-fn dict names, an = arg-position
-- methods, sm = the P0-18 mangle definer-shadow map (mangledSymbol ↦ bareMethod).
data ArgRw =
  | ArgRw (List String) (List String) (List String) (List (String, String))

-- rewrite a decl body with its own parameters seeded into the bound set.  Mirrors
-- desugar's mapDecl coverage exactly (DFunDef / DInterface / DImpl / DProp /
-- DTest / DBench / DAttrib; everything else — incl. DLetGroup — left unchanged),
-- so with the emit path off this would degenerate to the same node set mapProg
-- visits.
prePassDeclScoped : ArgRw -> Decl -> Decl
prePassDeclScoped rw (DFunDef pub n ps e) =
  DFunDef pub n ps (rewriteArgScoped rw (patVarsListTc ps) e)
prePassDeclScoped rw (d@(DInterface { methods, ... })) =
  DInterface { d | methods = map (prePassIfaceMethodScoped rw) methods }
prePassDeclScoped rw (d@(DImpl { methods, ... })) =
  DImpl { d | methods = map (prePassImplMethodScoped rw) methods }
prePassDeclScoped rw (DProp pub name params body) =
  DProp pub name params (rewriteArgScoped rw (propParamNamesTc params) body)
prePassDeclScoped rw (DTest pub name body) =
  DTest pub name (rewriteArgScoped rw [] body)
prePassDeclScoped rw (DBench pub name body) =
  DBench pub name (rewriteArgScoped rw [] body)
prePassDeclScoped rw (DAttrib attrs d) = DAttrib attrs (prePassDeclScoped rw d)
-- Top-level `let rec … with …` (DLetGroup): mapDecl/the catch-all skip its bodies,
-- so a constrained-fn occurrence inside a group body would never be rewritten to
-- EDictAt/EMethodAt → its call site gets no dict route → the dict-passed callee is
-- under-applied at eval.  Rewrite each clause body with that clause's params scoped
-- in, exactly like the DFunDef arm.
prePassDeclScoped rw (DLetGroup pub binds) =
  DLetGroup pub (map (prePassLetBindScoped rw) binds)
prePassDeclScoped _ d = d

prePassLetBindScoped : ArgRw -> LetBind -> LetBind
prePassLetBindScoped rw (LetBind n clauses) =
  LetBind n (map (prePassFunClauseScoped rw) clauses)

prePassFunClauseScoped : ArgRw -> FunClause -> FunClause
prePassFunClauseScoped rw (FunClause ps e) =
  FunClause ps (rewriteArgScoped rw (patVarsListTc ps) e)

prePassIfaceMethodScoped : ArgRw -> IfaceMethod -> IfaceMethod
prePassIfaceMethodScoped _ (IfaceMethod n ty None) = IfaceMethod n ty None
prePassIfaceMethodScoped rw (IfaceMethod n ty (Some (MethodDefault ps e))) =
  IfaceMethod
    n
    ty
    (Some (MethodDefault ps (rewriteArgScoped rw (patVarsListTc ps) e)))

prePassImplMethodScoped : ArgRw -> ImplMethod -> ImplMethod
prePassImplMethodScoped rw (ImplMethod n ps e) =
  ImplMethod n ps (rewriteArgScoped rw (patVarsListTc ps) e)

propParamNamesTc : List PropParam -> List String
propParamNamesTc ps = map propParamName ps

propParamName : PropParam -> String
propParamName (PropParam n _ _) = n

-- the core scope-threaded rewrite.  `bound` is the set of names in scope as
-- locals at this node.  At an EVar: the rp arm is scope-blind (unchanged); the
-- arg-position (`an`) and constrained-fn (`dn`) arms fire only when the name is
-- NOT shadowed by a local.  Binders
-- (ELam/ELet/ELetGroup/EMatch arms/EBlock/EDo + the where/do/guard
-- binders) extend `bound`; every other node recurses into its children with the
-- same `bound`.
rewriteArgScoped : ArgRw -> List String -> Expr -> Expr
rewriteArgScoped (ArgRw rp dn an sm) bound (EVar n)
  -- P0-18: `n` is a MANGLED definer-shadow standalone (`<mid>__size`).  Mark it
  -- `EMethodAt` with the BARE dispatch name (so `implFor` finds the impl when the
  -- receiver has one) and seed the route's `RLocal <n>` fallback with the mangled
  -- symbol (so a no-impl receiver still reaches the standalone `@mdk_<mid>__size`).
  | not (contains n bound) && isSome (lookupAssoc n sm) =
    match lookupAssoc n sm
      Some bare => EMethodAt bare (Ref (RLocal n [])) (Ref []) (Ref [])
      None => EVar n
  | contains n rp && not (contains n bound) =
    EMethodAt n (Ref RNone) (Ref []) (Ref [])
  | contains n an && not (contains n bound) =
    EMethodAt n (Ref RNone) (Ref []) (Ref [])
  | contains n dn && not (contains n bound) = EDictAt n (Ref [])
  | otherwise = EVar n
-- binders
rewriteArgScoped rw bound (ELam ps body) =
  ELam ps (rewriteArgScoped rw (patVarsListTc ps ++ bound) body)
rewriteArgScoped rw bound (ELet m r p e1 e2) =
  let pv = patVarsTc p
  let b1 = if r then pv ++ bound else bound
  ELet m r p (rewriteArgScoped rw b1 e1) (rewriteArgScoped rw (pv ++ bound) e2)
rewriteArgScoped rw bound (ELetGroup binds e2) =
  let bnd = letBindNamesTc binds ++ bound
  ELetGroup (map (rewriteArgLetBind rw bnd) binds) (rewriteArgScoped rw bnd e2)
rewriteArgScoped rw bound (EMatch e0 arms) =
  EMatch (rewriteArgScoped rw bound e0) (map (rewriteArgArm rw bound) arms)
rewriteArgScoped rw bound (EBlock stmts) =
  EBlock (rewriteArgStmts rw bound stmts)
rewriteArgScoped rw bound (EDo stmts) = EDo (rewriteArgStmts rw bound stmts)
-- non-binder composites: recurse children with the same bound
rewriteArgScoped rw bound (ELoc l e) = ELoc l (rewriteArgScoped rw bound e)
rewriteArgScoped rw bound (EDoOrigin l e) =
  EDoOrigin l (rewriteArgScoped rw bound e)
rewriteArgScoped rw bound (EApp f x) =
  EApp (rewriteArgScoped rw bound f) (rewriteArgScoped rw bound x)
rewriteArgScoped rw bound (EIf c t e) =
  EIf
    (rewriteArgScoped rw bound c)
    (rewriteArgScoped rw bound t)
    (rewriteArgScoped rw bound e)
rewriteArgScoped rw bound (EBinOp op l r dr) =
  EBinOp op (rewriteArgScoped rw bound l) (rewriteArgScoped rw bound r) dr
rewriteArgScoped rw bound (EUnOp op x dr) =
  EUnOp op (rewriteArgScoped rw bound x) dr
rewriteArgScoped rw bound (EInfix op l r) =
  EInfix op (rewriteArgScoped rw bound l) (rewriteArgScoped rw bound r)
rewriteArgScoped rw bound (EFieldAccess e0 n r) =
  EFieldAccess (rewriteArgScoped rw bound e0) n r
rewriteArgScoped rw bound (ETuple es) =
  ETuple (map (rewriteArgScoped rw bound) es)
rewriteArgScoped rw bound (EListLit es) =
  EListLit (map (rewriteArgScoped rw bound) es)
rewriteArgScoped rw bound (EArrayLit es) =
  EArrayLit (map (rewriteArgScoped rw bound) es)
rewriteArgScoped rw bound (ERangeList lo hi i) =
  ERangeList (rewriteArgScoped rw bound lo) (rewriteArgScoped rw bound hi) i
rewriteArgScoped rw bound (ERangeArray lo hi i) =
  ERangeArray (rewriteArgScoped rw bound lo) (rewriteArgScoped rw bound hi) i
rewriteArgScoped rw bound (ESlice e0 lo hi i r) =
  ESlice
    (rewriteArgScoped rw bound e0)
    (rewriteArgScoped rw bound lo)
    (rewriteArgScoped rw bound hi)
    i
    r
rewriteArgScoped rw bound (EIndex e0 i r) =
  EIndex (rewriteArgScoped rw bound e0) (rewriteArgScoped rw bound i) r
rewriteArgScoped rw bound (EAnnot e0 t) =
  EAnnot (rewriteArgScoped rw bound e0) t
rewriteArgScoped rw bound (EHeadAnnot e0 t) =
  EHeadAnnot (rewriteArgScoped rw bound e0) t
rewriteArgScoped rw bound (ERecordCreate n fs) =
  ERecordCreate n (map (rewriteArgField rw bound) fs)
rewriteArgScoped rw bound (ERecordUpdate e0 fs r) =
  ERecordUpdate
    (rewriteArgScoped rw bound e0)
    (map (rewriteArgField rw bound) fs)
    r
rewriteArgScoped rw bound (EVariantUpdate c e0 fs) =
  EVariantUpdate
    c
    (rewriteArgScoped rw bound e0)
    (map (rewriteArgField rw bound) fs)
rewriteArgScoped rw bound (EStringInterp parts) =
  EStringInterp (map (rewriteArgInterp rw bound) parts)
rewriteArgScoped rw bound (EGuards arms) =
  EGuards (map (rewriteArgGuardArm rw bound) arms)
rewriteArgScoped rw bound (ESection (SecRight op e0)) =
  ESection (SecRight op (rewriteArgScoped rw bound e0))
rewriteArgScoped rw bound (ESection (SecLeft e0 op)) =
  ESection (SecLeft (rewriteArgScoped rw bound e0) op)
rewriteArgScoped rw bound (EMapLit n kvs) =
  EMapLit n (map (rewriteArgKv rw bound) kvs)
rewriteArgScoped rw bound (ESetLit n es) =
  ESetLit n (map (rewriteArgScoped rw bound) es)
rewriteArgScoped rw bound (EAsPat x sub) =
  EAsPat x (rewriteArgScoped rw bound sub)
-- leaves (ELit / EMethodRef / EDictApp / EVarAt / EMethodAt / EDictAt / SecBare)
rewriteArgScoped _ _ e = e

rewriteArgField : ArgRw -> List String -> FieldAssign -> FieldAssign
rewriteArgField rw bound (FieldAssign n e) =
  FieldAssign n (rewriteArgScoped rw bound e)

rewriteArgKv : ArgRw -> List String -> (Expr, Expr) -> (Expr, Expr)
rewriteArgKv rw bound (k, v) =
  (rewriteArgScoped rw bound k, rewriteArgScoped rw bound v)

rewriteArgInterp : ArgRw -> List String -> InterpPart -> InterpPart
rewriteArgInterp _ _ (InterpStr s) = InterpStr s
rewriteArgInterp rw bound (InterpExpr e) =
  InterpExpr (rewriteArgScoped rw bound e)

rewriteArgLetBind : ArgRw -> List String -> LetBind -> LetBind
rewriteArgLetBind rw bound (LetBind n clauses) =
  LetBind n (map (rewriteArgFunClause rw bound) clauses)

rewriteArgFunClause : ArgRw -> List String -> FunClause -> FunClause
rewriteArgFunClause rw bound (FunClause ps body) =
  FunClause ps (rewriteArgScoped rw (patVarsListTc ps ++ bound) body)

-- a match/function arm: the pattern binds for the guards + body; a `| p <- e`
-- guard binds for later guards + the body (threaded left-to-right).
rewriteArgArm : ArgRw -> List String -> Arm -> Arm
rewriteArgArm rw bound (Arm p gs body) =
  let b0 = patVarsTc p ++ bound
  let (gs2, bnd) = rewriteArgGuards rw b0 gs
  Arm p gs2 (rewriteArgScoped rw bnd body)

rewriteArgGuardArm : ArgRw -> List String -> GuardArm -> GuardArm
rewriteArgGuardArm rw bound (GuardArm gs body) =
  let (gs2, bnd) = rewriteArgGuards rw bound gs
  GuardArm gs2 (rewriteArgScoped rw bnd body)

rewriteArgGuards : ArgRw -> List String -> List Guard -> (List Guard, List String)
rewriteArgGuards _ bound [] = ([], bound)
rewriteArgGuards rw bound ((GBool e)::rest) =
  let e2 = rewriteArgScoped rw bound e
  let (rest2, bnd) = rewriteArgGuards rw bound rest
  (GBool e2 :: rest2, bnd)
rewriteArgGuards rw bound ((GBind p e)::rest) =
  let e2 = rewriteArgScoped rw bound e
  let (rest2, bnd) = rewriteArgGuards rw (patVarsTc p ++ bound) rest
  (GBind p e2 :: rest2, bnd)

-- do/block statements: a DoBind/DoLet pattern binds for SUBSEQUENT
-- statements (a recursive DoLet also for its own RHS).
rewriteArgStmts : ArgRw -> List String -> List DoStmt -> List DoStmt
rewriteArgStmts _ _ [] = []
rewriteArgStmts rw bound ((DoExpr e)::rest) =
  DoExpr (rewriteArgScoped rw bound e) :: rewriteArgStmts rw bound rest
rewriteArgStmts rw bound ((DoBind p e)::rest) =
  DoBind p (rewriteArgScoped rw bound e) ::
    rewriteArgStmts rw (patVarsTc p ++ bound) rest
rewriteArgStmts rw bound ((DoLet m r p e)::rest) =
  let b1 = if r then patVarsTc p ++ bound else bound
  DoLet m r p (rewriteArgScoped rw b1 e) :: rewriteArgStmts rw (patVarsTc p ++ bound) rest
rewriteArgStmts rw bound ((DoAssign x e)::rest) =
  DoAssign x (rewriteArgScoped rw bound e) :: rewriteArgStmts rw bound rest
rewriteArgStmts rw bound ((DoFieldAssign x fs e)::rest) =
  DoFieldAssign x fs (rewriteArgScoped rw bound e) ::
    rewriteArgStmts rw bound rest

letBindNamesTc : List LetBind -> List String
letBindNamesTc binds = map letBindNameTc binds

letBindNameTc : LetBind -> String
letBindNameTc (LetBind n _) = n

-- the variables a pattern binds (local copy; llvm_emit's patVars isn't importable
-- here, and this one also covers PRec field/pun binders).
patVarsTc : Pat -> List String
patVarsTc (PVar x _) = [x]
patVarsTc (PCon _ args) = patVarsListTc args
patVarsTc (PCons h t) = patVarsTc h ++ patVarsTc t
patVarsTc (PTuple ps) = patVarsListTc ps
patVarsTc (PList ps) = patVarsListTc ps
patVarsTc (PAs x _ p) = x :: patVarsTc p
patVarsTc (PRec _ fields _) = flatMap recPatFieldVarsTc fields
patVarsTc _ = []

patVarsListTc : List Pat -> List String
patVarsListTc ps = flatMap patVarsTc ps

recPatFieldVarsTc : RecPatField -> List String
recPatFieldVarsTc (RecPatField label _ None) = [label]
recPatFieldVarsTc (RecPatField _ _ (Some p)) = patVarsTc p

-- interface methods carrying a method-level constraint (a `=>` over a tyvar that is
-- NOT the interface param, e.g. foldMap's `Monoid m`) — rewritten to EMethodAt
-- alongside the return-position methods so the method-level dict can be folded on.
-- Computed structurally (runs before checkProgramSeeded populates methodConstraintsRef).
methodConstraintNames : List Decl -> List String
methodConstraintNames prog = flatMap methodConstraintNamesOfDecl prog

methodConstraintNamesOfDecl : Decl -> List String
methodConstraintNamesOfDecl (DAttrib _ d) = methodConstraintNamesOfDecl d
methodConstraintNamesOfDecl (DInterface { typarams, methods, ... }) =
  flatMap (methodConstraintNameOf typarams) methods
methodConstraintNamesOfDecl _ = []

methodConstraintNameOf : List String -> IfaceMethod -> List String
methodConstraintNameOf typarams (IfaceMethod mname mty _)
  | hasMethodLevelConstraint typarams mty = [mname]
  | otherwise = []

-- does this method type carry a leading `=>` constraint whose tyvar is not an
-- interface param? (a method-LEVEL constraint, as opposed to one over the param)
hasMethodLevelConstraint : List String -> Ty -> Bool
hasMethodLevelConstraint typarams (TyConstrained cs t) = constraintsHaveMethodLevel typarams cs
  || hasMethodLevelConstraint typarams t
hasMethodLevelConstraint typarams (TyEffect _ _ t) =
  hasMethodLevelConstraint typarams t
hasMethodLevelConstraint _ _ = False

constraintsHaveMethodLevel : List String -> List Constraint -> Bool
constraintsHaveMethodLevel _ [] = False
constraintsHaveMethodLevel typarams (c::rest) = constraintIsMethodLevel typarams c
  || constraintsHaveMethodLevel typarams rest

-- a constraint is method-level iff it mentions at least one tyvar that is not an
-- interface param (so the dict is supplied per-call, not by the impl's dispatch)
constraintIsMethodLevel : List String -> Constraint -> Bool
constraintIsMethodLevel typarams c =
  isNonEmptyL (constraintNonParamVars typarams c)

constraintNonParamVars : List String -> Constraint -> List String
constraintNonParamVars typarams (Constraint { constraintArgs = args }) =
  removeAllS typarams (flatMap tyVarNames args)

resolveSites : ImplBuckets -> List String -> List PendingEntry -> Unit
resolveSites _ _ [] = goalSiteLoc := None
resolveSites implTable rpNames ((PendingEntry name tagRef resultMono encl kind loc)::rest) =
  goalSiteLoc := loc
  let _ = match kind
    SKReturn implRef fullMono => resolveSite implTable rpNames name tagRef implRef resultMono fullMono encl
    _ => ()
  resolveSites implTable rpNames rest

-- a method occurrence's route: if its discriminating type is a constrained
-- function's constraint variable, read that function's dict param (RDict);
-- otherwise the concrete impl head tag (RKey); an unresolved polymorphic type
-- stays RNone (arg-tag fallback).  When the route resolves to a concrete head
-- that names a parametric impl WITH a `requires`, also fill the impl-dicts ref so
-- eval threads the element dict(s) into the impl body (Phase 83/84 single-level).
-- Phase 83/84 #5: stamp the route for one pending method site.  At a concrete
-- result type (ground RKey case) the element dict routes are computed recursively
-- by implDictRoutesFor.  At a polymorphic result type (RDict case) the route is
-- RDictFwd for return-position methods — eval will extract and forward the
-- enclosing VDict's nested requires at runtime.  Arg-position methods (display/==)
-- stay RDict; their VMulti dispatch is by arg-tag, not by the forwarded reqs.
-- TYPECHECK-AUDIT C7: the ground RKey case prefers the canonical impl KEY (via
-- keyForSite) over the bare head tycon, so two non-overlapping impls sharing a
-- head tycon (Pair Int Bool vs Pair Bool Int) route to distinct keys; eval's
-- narrowMethod then matches the right VTypedImpl by its key field.  No matching
-- key entry (args-free / unknown) → fall back to the head tag, behaviour unchanged.
-- C5 NOTE: standalone-shadow RLocal routing is NOT done here — a return-position
-- site keys off the RESULT mono (`isEmpty`'s `Bool`), which never names the receiver's
-- impl, so this gate would mis-route every shadow method.  RLocal is stamped by the
-- arg-position resolveRLocalSites (keyed on the RECEIVER mono) AFTER resolveSites.
resolveSite : ImplBuckets -> List String -> String -> Ref Route -> Ref (List Route) -> Mono -> Mono -> String -> Unit
-- #156 S3b: a thin adapter over `entail` (EKReturn kind).  `entail` returns
-- `(primaryRoute, elementRoutes)`; stamp them into (tagRef, implRef).  Reproduces the
-- pre-S3b arm-by-arm body: assum → `(RDictFwd/RDict, [])`, inst → `(RKey key [],
-- implDictRoutesForFull …)`, fallback → `(RNone, [])`.
-- ⚠️ tagRef is NOT always RNone-seeded: a P0-18 standalone-shadow site seeds it to
-- `RLocal <sym> []` at rewriteArgScoped (~7438), and `resolveRLocalSites` (later) leaves
-- an importer-shadow / argDispatchOf-None / ungrounded-result site's ref UNTOUCHED — so
-- the pre-S3b None arm's `()` was load-bearing: it PRESERVED that RLocal seed.  For
-- EKReturn `entail` yields RNone ONLY from its fallback (assum→RDict/RDictFwd, inst→RKey),
-- so guarding the stamp on RNone reproduces that do-nothing None arm exactly and never
-- clobbers an RLocal seed.  implRef is []-seeded everywhere, so []-over-[] needs no guard.
resolveSite implTable rpNames name tagRef implRef resultMono fullMono encl =
  let (route, routes) = entail implTable name resultMono encl (EKReturn fullMono (contains name rpNames))
  let _ = match route
    RNone => ()
    _ => tagRef := route
  implRef := routes

-- Recover the FULL list of interface-type-parameter monos for a method occurrence,
-- ordered by the interface's typaram declaration.  Look up the method's interface
-- (methodIfaceParamsRef: iface, typarams, declared method Ty), match the declared Ty
-- against the occurrence's full mono to bind each typaram → its inferred mono, then
-- read them out in typaram order.  For `fromEntries : List e -> c` matched against the
-- occurrence `List Int -> Set _a`, this yields [Set _a, Int] (c then e) — the element
-- grounding (`e ↦ Int`) the result-only `resultMono` (= c = Set _a) had lost.  None
-- when the method has no registered interface (a plain `=>`-constrained fn) or the
-- declared/occurrence shapes do not match — resolveSite falls back to [resultMono].
ifaceParamMonos : String -> Mono -> Option (List Mono)
ifaceParamMonos name fullMono = match omLookup name perRun.value.methodIfaceParamsRef.value
  None => None
  Some (_, typarams, mty, _) =>
    map (subst => map (paramMonoOf subst) typarams) (matchTyMono mty fullMono)

-- RIGID PRODUCER 2 of 2 (#1110): [tp] is an interface type-PARAMETER name, so
-- the fallback when the head match bound nothing for it is a rigid variable,
-- not a type constructor.  See `Mono.TRigid`.
paramMonoOf : List (String, Mono) -> String -> Mono
paramMonoOf subst tp = fromOption (TRigid tp) (lookupAssoc tp subst)

-- 🚨 THE SHARED RETEST, AND IT IS SPELLING-KEYED THROUGH `dispHeadTab` ON PURPOSE —
-- IT MUST BE THE SAME PROJECTION THE BUCKETING APPLIES, NEVER A STRONGER ONE.
-- Every head comparison in this file bottoms out here (`headTabEq`,
-- `ieImplExistsForHeadGo`, `ieCountHeadByIfaceGo`, `ieCountHeadByMethodGo`), and the
-- buckets they scan are filed by `headBucketRender` / `ieFileRowByHead` =
-- `regKeyRender (regKeyOfTab (dispHeadTab …))`.  So a retest that compared `HeadKey`s
-- STRUCTURALLY (`hd == Some hk`, which `deriving Eq` makes an IDENTITY comparison)
-- would be strictly stronger than the bucket it is scanning, and would answer False
-- wherever the two sides' ORIGINS differ.
--
-- That is the normal case, not a corner.  Neither projection GUARANTEES an
-- identity — both bottom out in `tabKeyOf`, which answers `TkBare` for an
-- origin it cannot attribute — but they are not SYMMETRIC in practice, and that
-- was measured, not argued (#1111): the impl side (`headTyconTy`, off a
-- `Ty.TyCon`) came back `TkIdent … IdentBuiltin` for every primitive head on
-- both driver arms, while the goal side (`headTyconMono`) came back mixed,
-- because `stdlib/runtime.mdk`'s EXTERN signatures never pass through resolve's
-- head-stamping walk.  So the receiver of `debug (stringLength "xy")` projects
-- `HkDecl (TkBare NsType "Int")` against the prelude impl's
-- `HkDecl (TkIdent (Ident NsType IdentBuiltin "Int"))`.  A structural compare
-- says "no impl of this method at this head", and `inferShadowApp` /
-- `resolveRLocalSite` then silently route the call to a same-named standalone
-- (S0: `debug (stringLength "xy")` printed the standalone's answer at exit 0,
-- with `check` accepting).
--
-- This is exactly the asymmetry `dispHeadTab`'s own derivation records — the
-- goal side is neither SUPPLIED nor CANONICAL until the follow-on semantics
-- unit — which is why this site belongs IN that ledger and not outside it.
-- Corpus: `test/shadow_fixtures/i11_importer_extern_receiver`.
-- ⚠️ ARCH B-2.1-d: this derivation used to live on `implExistsForHeadGo`, the prefix-table
-- existence scan, and was cited from here, from `headTabOf` and from
-- `ieImplExistsForHeadGo`.  That whole read side is deleted; the RULE is unchanged and
-- now lives on the primitive every surviving retest shares.
--
-- `None` is a headless (fully-general) entry, which lives in the headless
-- bucket and so cannot be reached from a `Some hk` head lookup at all; False
-- is both the unreachable answer and the pre-A-2.2b one (`noneHeadTag` never
-- equalled a projected head name).
headTabIs : Option HeadKey -> TabKey -> Bool
headTabIs (Some hk) goal = dispHeadTab hk == goal
headTabIs None _ = False

-- `headTabIs` widened to a goal that may itself be HEADLESS, for the counting
-- scans (`ieCountHeadByIfaceGo`, `ieCountHeadByMethodGo`) whose goal is an
-- `Option HeadKey` rather than the bare `HeadKey` an existence test has.
-- Same rule, same reason: both sides go through `dispHeadTab`, so the retest is
-- exactly the partition the entries were filed under and never a stronger one
-- (see the 🚨 note on `headTabIs` for what a stronger one costs, and
-- `dispHeadTab`'s ledger for the enrolment rule).
--
-- The headless arm answers True on purpose: the headless bucket's every entry
-- carries `None`, and pre-A-2.2b this was the literal
-- `"__none__" == "__none__"` those entries were filed under.  The mixed arms are
-- False, which is likewise what a name-vs-`noneHeadTag` compare answered — minus
-- the forgery, since a head that SPELLS `__none__` can no longer reach the
-- headless bucket at all (`headBucketRender`).
headTabEq : Option HeadKey -> Option TabKey -> Bool
headTabEq hd (Some goal) = headTabIs hd goal
headTabEq None None = True
headTabEq (Some _) None = False

-- the goal-side projection, hoisted OUT of the scans above: Medaka is strict, so
-- projecting inside the per-entry arm would rebuild the same `TabKey` once per
-- entry in the bucket.
headTabOf : Option HeadKey -> Option TabKey
headTabOf None = None
headTabOf (Some hk) = Some (dispHeadTab hk)

-- ── ARCH B-2.1-g (Stage B sprint): THE SHADOW EXISTENCE TEST, GRAPH-GLOBAL ───
-- The SOLE impl-existence test, and it is a SEPARATE SPEC from B-2.1-b2's
-- three selection legs: #616 SHADOW semantics, not evidence.  (Its prefix-keyed
-- predecessor `implExistsForHead` was deleted by B-2.1-d once all three of its reads
-- had moved here.)  S2's impl universe is
-- `graph-global` — `SHADOW-SEMANTICS.md:226`, "ranges over EVERY module of the loaded
-- graph, whether or not any import path reaches it" — and the live-impl / no-impl test
-- is taken "against S2's graph-global impl universe (§1.0), never filtered by what `M`
-- can name" (`:183-186`).  The predecessor shadowKeyTableRef was NOT that: on the Module
-- arm it was `universeKeyBucketsRef`, the CUMULATIVE TOPOLOGICAL PREFIX, so an importer
-- shadow whose receiver's impl sat in a topologically later module answered "no impl" and
-- called the standalone.  This reads `perRun.bodyImplEnvRef` instead (B-2.1-a2 seats
-- the same population on BOTH driver arms; B-2.1-a3's `ieByHead` gives the same head
-- partition `bucketOfHead` did).  Both refs were deleted by B-2.1-d.
--
-- 🚨 ALL THREE EXISTENCE READS MOVED TOGETHER, AND THAT IS THE WHOLE SCOPING LESSON
-- OF THIS BITE.  `B-2.1-c` moved only the two INFERENCE-time reads (`inferShadowApp`,
-- `definerReceiverDispatches`) and deferred `resolveRLocalSite`'s, on the argument that
-- the first two have no sibling SELECTION read.  That argument was true and NOT
-- SUFFICIENT: `resolveRLocalSite` has a sibling EXISTENCE read at a different PHASE, so
-- deferring it left typecheck answering "an impl exists → type against the METHOD
-- scheme" while the route resolver answered "no impl in my prefix → stamp `RLocal` → the
-- standalone".  MEASURED: a located `Type mismatch: Int vs Box` reject became exit 0
-- printing `70018059149297` (a `Box` pointer fed to `n + 1`), discriminated by the ORDER
-- OF TWO `import` LINES.  That is the P0-20 class `resolveRLocalSite`'s own header warns
-- about — "keep the two gates identical" — so the three reads are ONE decision.
--
-- ⚠️ Reaches the DEFINER arm from neither shadow caller: both short-circuit on
-- `isDefinerShadow` first (S2's inversion routes a definer shadow to the standalone
-- unconditionally), so this widening cannot re-erase a user's own top-level function.
-- MEASURED as the control on `B-2.1-c`'s five-file corpus: the definer arm's located
-- reject is byte-identical before and after.
--
-- ── #1351/#1664 Leg 3: THE QUERY IS SCOPED TO THE ADMITTED DECLARATION ──────────
-- S2-DECL (b) (`docs/spec/SHADOW-SEMANTICS.md`): the importer arm is evaluated against
-- a DECLARATION, and that one declaration supplies BOTH halves — the receiver argument
-- AND the impl query, which asks *"does an `impl` of THAT interface exist at the
-- receiver's head tycon"*.  This test used to ask only *"does SOME impl declaring a
-- method spelled [name] exist at that head"*, with no declaration component, which is
-- verbatim S2-DECL (c)'s non-conformance: a module could receive `True` about an impl
-- of a declaration it cannot even name (`test/must_fail_fixtures/1664-decl-agreeing-
-- both-admitted/iz-unadmitted.mdk` — `IZ` UNADMITTED, `impl IZ String` still in the
-- graph, and the occurrence dispatched into it and printed `7`).
--
-- ⚠️ THE IMPL UNIVERSE IS UNCHANGED — `DICT-SEMANTICS.md` §8 I5 / S2-DECL's own "What it
-- does NOT change": this narrows what the query ASKS, never which modules' instances may
-- answer.  `ieHeadRows … env` is still the graph-global bucket, unfiltered.
--
-- ⚠️ ALL THREE EXISTENCE READS MOVE TOGETHER, BY CONSTRUCTION rather than by diligence
-- (RUN-METHID-004; the 🚨 block above records the MEASURED S0 a subset move produced).
-- The admitted declaration is read HERE, inside the one query, from [name] alone — so
-- `inferShadowApp`, `definerReceiverDispatches` and `resolveRLocalSite` are not edited
-- at all and a partial move is unrepresentable.  It is also the only correct place: all
-- three reads must name ONE population asked ONE question, and threading the scope
-- through three call sites would let a future edit give them three.
ieImplExistsForHead : ImplEnv -> String -> HeadKey -> Bool
ieImplExistsForHead env name hk =
  -- goal-side key AND the admitted declaration both projected ONCE, here — see
  -- `headTabOf` for why the goal key is hoisted; the `omLookup` is hoisted for the
  -- same reason ([T-PERF-HUNT]: Medaka is strict, so an in-loop projection is rebuilt
  -- once per row).  The scan itself stays the same single linear walk of `ieHeadRows`
  -- with one more conjunct per row — no rescan, no new bucket.
  ieImplExistsForHeadGo (ieHeadRows (Some hk) env) name (dispHeadTab hk) (admittedIfaceFor name)

-- The declaration THIS module's import scope admits for [name] — `methodIfaceParamsRef`
-- is `applyMethodScopeOverrides`' output, so this is L2's ALREADY-RESOLVED answer, re-read
-- rather than recomputed (RUN-METHID-056: no second resolver beside
-- `applyMethodScopeOverrides`).  Same lookup `admittedSchemeFor` and
-- `definerReceiverIsDictVar` already perform on the same table.
admittedIfaceFor : String -> Option IfaceRef
admittedIfaceFor name = map
  ((iface, _, _, _) => iface)
  (omLookup name perRun.value.methodIfaceParamsRef.value)

-- 🚨 STILL SPELLING-KEYED, THROUGH `dispHeadTab`/`headTabIs` — the retest keeps the
-- projection strength of the bucket it scans and NOT a stronger one.  The BUCKET moved
-- from a topological prefix to the whole graph; the RETEST did not change shape.  The
-- full derivation is the 🚨 note on `headTabIs`: a structural `HeadKey`
-- compare here re-opens #1111's S0 (`debug (stringLength "xy")` printing the
-- standalone's answer at exit 0), because the impl side and the goal side are measured
-- to disagree on ORIGIN per provenance.  `univReceiverTag tys` is the same head
-- projection `ieFileRowByHead` files each row under, so the two sides of `headTabIs`
-- are the partition, exactly as `ieCountHeadByIfaceGo` owes it.
-- The method table is `ImplRow`'s last field — payload, never a key component (§9.3) —
-- which is the same `methods` list `KeyEntry` carried and `keyEntryOfRow` copies out.
--
-- #1351/#1664 Leg 3: the row's 3rd field, `IfaceRef`, was ALREADY THERE and was
-- discarded by this pattern (`ImplRow _ _ _ tys _ ms`).  Nothing about `ImplRow`
-- widened; the retest stopped throwing away the identity it was already carrying.
ieImplExistsForHeadGo : List ImplRow -> String -> TabKey -> Option IfaceRef -> Bool
ieImplExistsForHeadGo [] _ _ _ = False
ieImplExistsForHeadGo ((ImplRow _ _ ir tys _ ms)::rest) name goal admitted
  | headTabIs (univReceiverTag tys) goal && contains name ms && ieRowAdmittedBy ir admitted = True
  | otherwise = ieImplExistsForHeadGo rest name goal admitted

-- Does this row's interface match the declaration the querying module admits?
--
-- ⚠️ `None` FALLS BACK TO THE BARE-NAME ANSWER — every row passes — and that is the
-- SETTLED reading, not a hedge.  S2-DECL (c) narrows the query to declarations `M` can
-- name; (d)'s `None` arm ("S1 already says `N` is not a shadow in `M`; the standalone
-- denotes.  Unchanged by this clause") hands the EMPTY-admitted-set case to S1, upstream
-- of this query, so S2-DECL gives this site no instruction for a table miss.  A miss here
-- is `methodIfaceParamsRef` holding no entry for [name] — "this module's scope does not
-- decide it" — and the file's own two precedents for exactly that miss both fall back:
-- `pickSchemesByDecl`'s ⚠️ block ("a miss must not DROP the binding") and
-- `admittedSchemeFor`'s ("never a guess").  Answering `False` unconditionally instead
-- would turn a dispatched occurrence into an `RLocal` one on every shape this slice does
-- not decide — a routing change, not a conservative one.
--
-- ⚠️ `ieRowIfaceMatches` (`sameTyConHead` over `irName`/`irOrigin`), NOT a bare `irName`
-- compare and NOT `ieCountHeadByIfaceGo`'s deliberately spelling-only test: this is a
-- LOOKUP where a false HIT is silent wrongness (an impl of an unnameable declaration
-- answering `True` — the #1664 defect) and a false MISS costs only the fall-through to
-- the standalone.  It is the one standing comparator for IfaceRef-vs-IfaceRef identity in
-- this family (`ieEntriesForIface`, `cohSameIface`, `lookupSchemeById`).
ieRowAdmittedBy : IfaceRef -> Option IfaceRef -> Bool
ieRowAdmittedBy _ None = True
ieRowAdmittedBy ir (Some iface) = ieRowIfaceMatches ir iface

-- C5: stamp RLocal on each recorded standalone-shadow arg-position site whose
-- receiver mono now grounds to a concrete head tycon with NO impl of the method.
-- The receiver HAS an impl (the genuine-method case, e.g. `toList (Some 7)`) → leave
-- the route untouched (RNone → eval arg-tag-dispatches to the real impl).  An
-- ungrounded receiver (still a tyvar) → leave it (polymorphic, deferred).  Mirrors
-- lib/typecheck.ml:1603-1640: RLocal only when impl_exists is false.
-- S-1: [prog]/[implTable] are here so the stamp can call routesOfMonosTop — a PURE
-- function of the (union-find-solved) constraint monos — and fill the standalone's own
-- dict routes IN PLACE.  Deliberately NOT routed through pendingDictApps: that list is
-- resolved by resolveDictApps, which runs AFTER this in elabModuleStamp, so the stamp
-- would read `[]`.  Resolving inside the stamp is ordering-immune.  An unconstrained
-- standalone has no monos ⇒ routesOfMonosTop returns [] immediately (it cannot even
-- reach its AmbiguousImpl arm) ⇒ `RLocal sym []` ⇒ byte-identical to the pre-S1 stamp.
-- #156 S3d — resolveRLocalSites is DELIBERATELY NOT routed through `entail`, and DICT-
-- SEMANTICS §3 conformance REQUIRES that, rather than merely permitting it.  This pass
-- implements §4 `(var)`'s FIRST premise — binding selection: does this occurrence denote the
-- module's own standalone `sym` or a shadowed interface method?  (Keyed on the solved receiver
-- mono, which is why it runs post-inference.)  That decision reads shadow facts — isDefinerShadow,
-- definerShadowNamesRef — that are NOT components of entailment's domain `(IE, CE, P, π)` (§3
-- resolution-determinism); they are facts about Γ.  Folding them into the one entailment function
-- would make it depend on inputs outside its spec-given domain — violating the very law a merge
-- would invoke.  The tell: the `Some tag` arm treats "a live impl exists" as DO-NOTHING (the name
-- is a genuine method, dispatched elsewhere) and emits RLocal for the NO-impl case — the inverse of
-- `entailInst`'s success condition.  "No π to discharge; the name denotes another binding" is not an
-- evidence statement.  §4 `(var)`'s SECOND premise — the chosen standalone's actual entailment
-- obligations — IS routed through the one engine: every RLocal payload is filled by routesOfMonosTop
-- → entail (EKNestedTop).  So the single-entailment-function law holds at 4-of-5 BY CONSTRUCTION; what
-- stays out is exactly the binding-selection axis §3 never claimed (cf. §8 I1: identity keyed by
-- binding, not bare name).  "Does an impl exist" and "which impl entails" must agree on ONE
-- impl table — a drift between them would be a real dispatch bug.  #415 item 2: that
-- agreement is STRUCTURAL, not a standing obligation.
-- 🚨 ARCH B-2.1-g REBASED BOTH READS, TOGETHER, ONTO `perRun.bodyImplEnvRef`, and the
-- sentence that stood here — "There is no second table in scope to drift TO" — WAS ALREADY
-- FALSE and is what licensed a bad scoping.  `bodyImplEnvRef` has been a second impl table,
-- in scope from anywhere, since B-2.1-a2, and B-2.1-b2 moved three SELECTION legs onto it
-- while this site's two reads stayed on the threaded prefix `[keyTable]`.  `B-2.1-c` then
-- moved the sibling SHADOW existence reads and deferred this one, which produced exactly the
-- drift this block claimed was unreachable: existence answered True off the whole graph while
-- `routesOfMonosTop … keyTable`, one line below, had no row to select — a located reject
-- became exit 0 printing a garbage pointer.  So the agreement is restored the only way it can
-- be, by moving BOTH: `ieImplExistsForHead …bodyImplEnvRef…` directly, and `keyForSite` (also
-- repointed onto `bodyImplEnvRef`) via routesOfMonosTop → routeOf → entail (EKNestedTop) →
-- entailInst.  ⚠️ THE INVARIANT IS UNCHANGED AND IS STILL THE ONE THAT MATTERS: these two
-- reads must name ONE population.  It is no longer enforced by a shared parameter, so it is
-- now enforced by a shared REF — and the check on any future edit here is "does the thing I
-- am reading answer over the same population `keyForSite` selects from?", not "am I using
-- [keyTable]?".  [keyTable] survives on this signature only for the parts of
-- `routesOfMonosTop`'s subtree that still thread it; no read AT THIS SITE consults it.
-- (The inference-time existence reads in `inferShadowApp` / `definerReceiverDispatches` are
-- the same decision at an earlier PHASE and are now on the same ref for the same reason —
-- B-2.1-c's measurement is that a phase split of one decision is as fatal as a table split.
-- ⚠️ Do not re-derive the retired defence "GLOBAL by design — local ∪ imported ∪ prelude":
-- `SHADOW-SEMANTICS.md:242-245` retires that phrase as a false synonym for graph-global, and
-- `shadowKeyTableRef` was in fact the cumulative topological PREFIX on the Module arm.)
resolveRLocalSites : List Decl -> ImplBuckets -> List PendingEntry -> Unit
resolveRLocalSites _ _ [] = goalSiteLoc := None
resolveRLocalSites prog implTable ((PendingEntry name tagRef am _ kind loc)::rest) =
  goalSiteLoc := loc
  let _ = match kind
    SKRLocal sym forceLocal monos ifaces argVecs =>
      if forceLocal then
        tagRef := RLocal sym (routesOfMonosTopV prog implTable monos ifaces argVecs)
      else
        resolveRLocalSite prog implTable name tagRef am sym monos ifaces argVecs
    _ => ()
  resolveRLocalSites prog implTable rest

-- C5: stamp RLocal on each recorded standalone-shadow arg-position site whose
-- receiver mono now grounds to a concrete head tycon with NO impl of the method.
-- The receiver HAS an impl (the genuine-method case, e.g. `toList (Some 7)`):
-- leave the route untouched — eval arg-tag-dispatches on RNone; emit already
-- stamped the correct RKey<receiverHead> via resolveArgStamps.
-- An ungrounded receiver (still a tyvar) → leave it.  Mirrors lib/typecheck.ml's
-- RLocal-vs-ordinary-dispatch split (the oracle keys the genuine case off the receiver).
resolveRLocalSite : List Decl -> ImplBuckets -> String -> Ref Route -> Mono -> String -> List Mono -> List String -> List (List Mono) -> Unit
resolveRLocalSite prog implTable name tagRef am sym monos ifaces argVecs = match headTyconMono am
  -- S2 (THE INVERSION): route by SHADOW KIND first, receiver second.
  --   * DEFINER shadow (the name is this module's own top-level fn) → the standalone,
  --     UNCONDITIONALLY.  The impl universe is not consulted; a grounded head with a live
  --     impl no longer steals the call.  (The APP path already forces this via the
  --     RLocalSite `forceLocal` flag; this arm is what carries the other recorders —
  --     notably the VALUE-position sites pushed by the generic recordRLocalSite, which is
  --     gated on standaloneValuesRef and that set holds definer AND importer shadows.)
  --   * IMPORTER shadow (Fork 1) → the OLD per-receiver rule, unchanged: a live impl at the
  --     receiver head dispatches, else the standalone.  An `import` is a SIBLING scope, not
  --     an inner one, so it does not shadow; inverting it too would break the everyday
  --     `import map` pattern (`isEmpty [1,2]` must still reach `Foldable.isEmpty`).
  -- am is the ACTUAL argument type (inferDefinerShadowApp records it), not the standalone's
  -- declared domain, so the importer arm's impl query is still meaningful.
  --
  -- ⚠️ isDefinerShadow — NOT a bare definerShadowNamesRef membership test.  It carries the
  -- SAME gate every typing entry point applies (ifaceMethodName, #54; it was the typaram-
  -- COUNT test singleParamIfaceMethod until S-3 / row 26 was closed).  Routing here on a
  -- gate the typing entry points do not share would route a site whose TYPE came from the
  -- dispatch path — route and type disagreeing is exactly the P0-20 bug class.  Keep the
  -- two gates identical.
  -- ARCH B-2.1-g: graph-global, off `bodyImplEnvRef` — see `ieImplExistsForHead`, and
  -- see the `#415 item 2` block above for why this read could only move TOGETHER with
  -- its sibling selection leg (`routesOfMonosTop … keyTable` → `keyForSite`, likewise
  -- repointed by this bite).  Both now read ONE table again, and it is the same table
  -- the emitter counts over.
  Some tag => stampRLocalOrFallback
    (not (isDefinerShadow name) && ieImplExistsForHead perRun.value.bodyImplEnvRef.value name tag)
    tagRef sym
    (routesOfMonosTopV prog implTable monos ifaces argVecs)
  -- An UNGROUNDED definer-shadow receiver keeps the old default (RLocal → standalone);
  -- other (importer) ungrounded sites stay untouched (deferred/polymorphic).
  None => if contains name perRun.value.definerShadowNamesRef.value then
    tagRef := (RLocal sym (routesOfMonosTopV prog implTable monos ifaces argVecs))
  else ()

-- C5: hasImpl ⇒ genuine method; route already correct (RNone for arg-tag eval,
-- or RKey stamped by resolveArgStamps on emit) — leave untouched.
-- no impl ⇒ standalone shadow ⇒ RLocal, carrying the standalone's own constraint
-- dicts (S-1; [] for an unconstrained standalone ⇒ the pre-S1 stamp exactly).
stampRLocalOrFallback : Bool -> Ref Route -> String -> List Route -> Unit
stampRLocalOrFallback True _ _ _ = ()
stampRLocalOrFallback False tagRef sym dicts = tagRef := RLocal sym dicts

-- if [m] normalizes to a registered constraint variable, the dict parameter name
-- a method at that type reads.  A return-position method at a HIGHER-KINDED
-- constraint var (`pure : a -> m a`, so the result mono is `m Unit` = TApp (TVar
-- m) Unit) carries the dict var in the application HEAD, not at top level — recurse
-- through TApp to find it.  (A concrete head, e.g. `Option Unit` after unification,
-- is a TCon and falls through to None → RKey, unchanged.)
activeDictVarOf : Mono -> Option String
activeDictVarOf m = match normalize m
  TVar cell => lookupAssocI (tyvarId cell) perRun.value.activeDictVars.value
  TApp a _ => activeDictVarOf a
  _ => None

-- activeDictVarOf, but PREFER the activeDictVars entry whose dict-param name belongs
-- to the enclosing method [encl] (`$dict_<encl>_<slot>`).  registerImplRequires
-- registers EVERY method of an impl under the SAME impl tyvar id (`impl Ord (List a)`
-- registers `a`'s id once per compare/lt/gt/min/max/… each to `$dict_<method>_<slot>`),
-- so the global first-match `activeDictVarOf` returns whichever method registered
-- LAST — inside `compare`'s body that wrongly yields `$dict_max_0` (out of compare's
-- scope → emitter "unbound dict witness").  Picking the [encl]-owned entry keeps each
-- method body's element-dict route bound to ITS OWN leading param.  encl == "" or no
-- match ⇒ fall back to the global lookup (genuine element dict from another impl).
activeDictVarForEncl : Mono -> String -> Option String
activeDictVarForEncl m encl
  | encl == "" = activeDictVarOf m
  | otherwise = match normalize m
    TVar cell => match firstDictForEncl (tyvarId cell) ("$dict_" ++ encl ++ "_") perRun.value.activeDictVars.value
      Some dname => Some dname
      None => activeDictVarOf m
    TApp a _ => activeDictVarForEncl a encl
    _ => None

firstDictForEncl : Int -> String -> List (Int, String) -> Option String
firstDictForEncl _ _ [] = None
firstDictForEncl id pfx ((eid, ename)::rest)
  | eid == id && startsWith pfx ename = Some ename
  | otherwise = firstDictForEncl id pfx rest

-- activeDictVarOf, but for a constraint var that is the ENCLOSING fn's OWN constraint
-- var, return [encl]'s in-scope dict param (the slot it sits at) rather than the
-- GLOBAL activeDictVars entry.  In a mutually-recursive group the constraint vars of
-- the siblings unify to one id; activeDictVars (global, uncleared) maps that id to
-- whichever sibling registered it LAST — so an arg-stamp inside `evenCat` would
-- forward `$dict_oddCat_0` (out of scope in evenCat's body).  Preferring encl's own
-- slot keeps the forwarded dict the one actually bound in the body.  Falls back to
-- the global lookup when the var is not one of encl's (a genuine element dict from a
-- different in-scope impl).
-- #1177: [goal] is the PREDICATE the use site has to discharge (its interface, and
-- the instantiated argument vector when the occurrence let one be recovered), NOT
-- just the constraint var — see `enclDictVarOf`.  `None` reproduces the pre-#1177
-- tyvar-keyed lookup exactly.
activeDictVarOfEncl : Option Predicate -> Mono -> String -> Option String
activeDictVarOfEncl goal m encl = match enclDictVarOf goal m encl
  Some dname => Some dname
  -- #1154 RESIDUAL: the impl-`requires` channel, asked by PREDICATE, between the
  -- signature channel and the historical tyvar-id scan.  It answers only where an impl
  -- `requires` slot of THIS method carries the goal's interface at the goal's variable;
  -- everything else falls through to `activeDictVarForEncl` unchanged.
  None => match implReqDictVarOf goal m encl
    Some dname => Some dname
    None => activeDictVarForEncl m encl

-- 🚨 #1154 RESIDUAL: AN IMPL-`requires` SITE IS RESOLVED BY ITS PREDICATE, NOT BY ITS
-- CONSTRAINT VAR'S ID — the same rule #1177 established for the SIGNATURE `=>` channel,
-- on the channel #1177 did not reach.  `registerReqSlots` opens one dict slot per
-- `requires` ENTRY but keys `activeDictVars` on the tyvar ids INSIDE the entry, so
-- `impl Sh (Box a) requires Ix a Char, Dbg2 a` registers `a`'s id TWICE — once per slot.
-- `firstDictForEncl` then scans a cons-list whose head is the LAST registration, so
-- EVERY method use in the body read the LAST slot: `ix x 'z'` read the `Dbg2` dict, its
-- route degraded, and first-declared-`impl Ix` won.  MEASURED on the typed Core IR dump
-- at this slice's base — `sh`'s body lowered to `CMethod "ix" (RDict "$dict_sh_1")` and
-- `CMethod "dbg2" (RDict "$dict_sh_1")`, with `$dict_sh_0` bound and never read — which
-- is why moving the `Ix` entry to the END of the `requires` list (a meaning-preserving
-- edit) moved the answer from 116 to the correct 227.
--
-- ⚠️ THIS IS NOT THE `argReqRoute`/`EKNestedTop` GOAL-VECTOR SEAM, AND THAT SEAM IS NOT
-- BROKEN.  The routes handed to the call site are already correct at every position
-- (`(RKey "Ix|Int Char|") (RKey "Int")`, in `requires` order); the loss is entirely on
-- the CONSUMPTION side, in which slot the impl BODY reads.  A fix aimed at the routing
-- ladder would have moved nothing.
--
-- ⚠️ FAILING TO MATCH FALLS BACK, deliberately, exactly as `enclSlotIndex` does: a goal
-- with no recoverable interface, a var no `requires` slot of this method is keyed on, or
-- an interface no entry names, all answer as they did before.  Two passes, most specific
-- first, for `enclSlotIndex`'s reason — a `requires` may name one interface twice at
-- different arguments (`Ix a Char, Ix a Bool`), where only the recorded vector separates
-- the two slots.
implReqDictVarOf : Option Predicate -> Mono -> String -> Option String
implReqDictVarOf None _ _ = None
implReqDictVarOf (Some p) m encl
  | encl == "" = None
  | otherwise = match normalize m
    TVar cell =>
      let entries = perRun.value.implReqPreds.value
      let pfx = "$dict_\{encl}_"
      match implReqPick (tyvarId cell) p pfx True entries
        Some dname => Some dname
        None => implReqPick (tyvarId cell) p pfx False entries
    TApp a _ => implReqDictVarOf (Some p) a encl
    _ => None

implReqPick : Int -> Predicate -> String -> Bool -> List (String, List Int, Predicate) -> Option String
implReqPick _ _ _ _ [] = None
implReqPick target p pfx needArgs ((dname, ids, sp)::rest)
  | startsWith pfx dname && containsI target ids && sp.iface.irName /= "" && sp.iface.irName == p.iface.irName && (not needArgs || predArgsAgree p.args sp.args) = Some dname
  | otherwise = implReqPick target p pfx needArgs rest

-- 🚨 #1177: A USE SITE IS RESOLVED BY ITS PREDICATE, NOT BY ITS CONSTRAINT VAR'S ID.
-- `funConstraintsRef` is the SHATTERED per-tyvar slot table, so a context naming two
-- interfaces over ONE type variable — `useIx : (Dbg a, Ix a Char) => a -> Int` —
-- registers TWO slots carrying the SAME id.  The old body asked `indexOfId (tyvarId
-- cell) ids`, whose FIRST match is slot 0 whichever predicate the site belongs to, so
-- EVERY method use in the body read slot 0: `ix` read the `Dbg` dict, its route
-- degraded to the bare head tag, and first-declared-`impl` won.  Swapping the two
-- predicates — a meaning-preserving edit — moved the answer from 116 to the correct
-- 227, on both engines, at exit 0, with `check --json` clean.
--
-- The slots are id-parallel to `funConstraintIfacesRef` (both projections come off ONE
-- `CSlot` list, `setFunConstraintEntry`) and prefix-parallel to `funConstraintArgsRef`
-- (#1161 F-3a-ii), so the whole predicate of each slot is recoverable HERE without any
-- new table — see `enclPreds`.
--
-- ⚠️ FAILING TO MATCH FALLS BACK TO THE HISTORICAL FIRST-ID SCAN, deliberately, and
-- that is what keeps this change narrow.  A goal with no recoverable interface (a
-- top-level constrained call routed through EKNestedTop, a method absent from
-- `methodIfaceParamsRef`), a slot registered by `registerInferredFor` with an
-- unrecoverable iface (`""`), and a super slot appended past `pairSlots`' truncation
-- all answer exactly as they did before.  The ONLY sites whose answer moves are those
-- where a LATER slot at the same id carries the goal's interface and an earlier one
-- does not — i.e. precisely the #1177 shape.
enclDictVarOf : Option Predicate -> Mono -> String -> Option String
enclDictVarOf goal m encl
  | encl == "" = None
  | otherwise = match normalize m
    TVar cell =>
      map (dictParamName encl) (enclSlotIndex goal (tyvarId cell) encl)
    TApp a _ => enclDictVarOf goal a encl
    _ => None

-- the slot index [target]'s dict param sits at in [encl]'s own constraint slots:
-- by PREDICATE when the goal supplies one and a slot answers it, else the historical
-- first-tyvar-id match.
enclSlotIndex : Option Predicate -> Int -> String -> Option Int
enclSlotIndex None target encl = indexOfId target (enclSlotIds encl)
enclSlotIndex (Some p) target encl = match indexOfPred target p (enclPreds encl)
  Some i => Some i
  None => indexOfId target (enclSlotIds encl)

enclSlotIds : String -> List Int
enclSlotIds encl =
  fromOption [] (lookupAssocSL2 encl perRun.value.funConstraintsRef.value)

-- [encl]'s own constraint slots as PREDICATES, in slot order: each slot's interface
-- and the argument vector its signature recorded, paired with the tyvar id the slot
-- is keyed on.  `Predicate` is reused rather than a second n-ary shape invented.
-- The vector list is a PREFIX of the slots (`keptConstraintArgs`, and
-- `registerInferredFor` records `[]` for an unrecovered slot), so a slot past its end —
-- or one whose recorded vector is empty — gets `args = []`
-- — which `predArgsAgreeEncl` reads as "no vector to disambiguate on", never as a match.
enclPreds : String -> List (Int, Predicate)
enclPreds encl =
  zipSlotArgs
    (pairSlots
      (enclSlotIds encl)
      (fromOption
        []
        (lookupAssocS encl perRun.value.funConstraintIfacesRef.value)))
    (declaredConstraintArgs encl)

zipSlotArgs : List CSlot -> List (List Mono) -> List (Int, Predicate)
zipSlotArgs [] _ = []
zipSlotArgs (s::rest) [] =
  (s.csId, Predicate { iface = s.csIface, args = [] }) :: zipSlotArgs rest []
zipSlotArgs (s::rest) (v::vs) =
  (s.csId, Predicate { iface = s.csIface, args = v }) :: zipSlotArgs rest vs

-- TWO PASSES, MOST SPECIFIC FIRST, and the order is behaviour: a context may name one
-- interface twice over one variable at different arguments (`(Ix a Char, Ix a Bool)`),
-- where the iface alone cannot tell the two slots apart and only the recorded argument
-- vector can.  Pass 1 requires both; pass 2 requires the interface alone, which is what
-- answers #1177's `(Dbg a, Ix a Char)`.
indexOfPred : Int -> Predicate -> List (Int, Predicate) -> Option Int
indexOfPred target p preds = match indexOfPredGo 0 target p True preds
  Some i => Some i
  None => indexOfPredGo 0 target p False preds

indexOfPredGo : Int -> Int -> Predicate -> Bool -> List (Int, Predicate) -> Option Int
indexOfPredGo _ _ _ _ [] = None
indexOfPredGo i target p needArgs ((id, sp)::rest)
  | id == target && sp.iface.irName /= "" && sp.iface.irName == p.iface.irName && (not needArgs || predArgsAgreeEncl p.args sp.args) = Some i
  | otherwise = indexOfPredGo (i + 1) target p needArgs rest

-- 🚨 S-nonlead-arg-identity (#1904) — THE ENCLOSING-SCOPE ROUTING RELATION, and it is
-- deliberately a SIBLING of `predArgsAgree` rather than a change to it.
--
-- THE CONTRACT ANSWER, for this channel: two argument vectors are the same predicate iff
-- they have equal length and, AT EVERY POSITION IN ORDER, either both sides normalize to
-- a type VARIABLE and those variables have the SAME tyvar id, or `monoHeadAgrees` holds
-- (head-tycon-wise, and only where both sides are ground).  The first disjunct is the new
-- half; the second is `predArgsAgree` unchanged.
--
-- WHY THE ID COMPARISON IS AVAILABLE HERE and not at `predArgsAgree`'s other caller.
-- `predArgsAgree`'s header states — correctly, for `implReqPick`'s impl-`requires`
-- channel — that its two vectors live in DIFFERENT instantiations, so a variable position
-- "carries no information here".  MEASURED, panic-instrumented at `indexOfPred`, on
-- `probes/p1904_both.mdk`: for a BODY occurrence of the ENCLOSING function's OWN declared
-- predicate the two vectors are in the SAME instantiation and the ids CORRESPOND —
-- `goal=Ix[v98,v100,v99] slots=[id98:Ix[v98,v99,v100]]`.  `declaredConstraintArgs`' own
-- header says why: `constraintVarIfaceMonos` (which mints the slot IDS) and
-- `constraintVarArgMonos` (which mints these VECTORS) are called on ONE signature
-- instantiation's `snd inst` in `preunifySigsEx`, so a slot's `csId` is literally one of
-- its own vector's tyvar ids — and `enclPreds`' subject is the ENCLOSING fn, always local,
-- so nothing re-instantiates between the recording and this lookup.
--
-- ⚠️ SCOPED NARROWER THAN `predArgsAgree` ON PURPOSE.  `indexOfPredGo` is reached only
-- from `indexOfPred` ← `enclSlotIndex` ← `enclDictVarOf`, i.e. only the enclosing-fn
-- channel the measurement covers.  `implReqPick`/`implReqDictVarOf` keep calling
-- `predArgsAgree`: that channel's vectors come from an impl's `requires` in the IMPL's
-- tyvar space, which this dispatch did NOT measure, and widening it on the unverified
-- assumption that the same correspondence holds is exactly what the header warns against.
--
-- WHAT IT FIXES: `(Ix a b c, Ix a c b)` is all-tyvar at every position, so
-- `monoHeadAgrees` returned `None`-agrees-with-everything at each one, pass 1 matched
-- SLOT 0 for both `ix n x y` and `ix n y x`, and the second dict slot the key half opens
-- was dead — `333 + 333 = 666` where the answer is `333 + 111 = 444`.
--
-- ⚠️ FAILING TO MATCH STILL FALLS BACK, exactly as before: a pass-1 miss drops to pass 2
-- (interface-only) and then to the historical first-id scan, so this can only ever move a
-- site that pass 1 was previously answering with a WRONG slot — never one it was
-- answering `None` for.  A goal whose position is an unsolved variable with an id from a
-- genuinely different instantiation stops matching in pass 1 and is answered by pass 2,
-- i.e. by the interface alone, which is where such a goal sat before `predArgsAgree`
-- existed at all.
predArgsAgreeEncl : List Mono -> List Mono -> Bool
predArgsAgreeEncl [] _ = False
predArgsAgreeEncl _ [] = False
predArgsAgreeEncl gs vs
  | listLen gs /= listLen vs = False
  | otherwise = argPosAgreeEncl gs vs

argPosAgreeEncl : List Mono -> List Mono -> Bool
argPosAgreeEncl (g::gs) (v::vs) = monoPosAgreesEncl g v && argPosAgreeEncl gs vs
argPosAgreeEncl _ _ = True

-- ONE position of the relation above: TWO VARIABLES compare by IDENTITY (the
-- `monoSameGiven` `TVar`/`TVar` arm, which is what makes this the same notion of "same
-- predicate" slice 2 landed on the given channel); every other pairing — including a
-- variable against a ground type, where the instantiations genuinely may not line up —
-- keeps `monoHeadAgrees`' permissive head-tycon rule verbatim.
monoPosAgreesEncl : Mono -> Mono -> Bool
monoPosAgreesEncl a b = match normalize a
  TVar c1 => match normalize b
    TVar c2 => tyvarId c1 == tyvarId c2
    _ => monoHeadAgrees a b
  _ => monoHeadAgrees a b

-- Does the goal's instantiated argument vector agree with a slot's recorded one?
-- ⚠️ SINCE #1904 THIS IS THE `implReqPick` CHANNEL'S RELATION ONLY.  The
-- enclosing-fn channel (`indexOfPredGo`) calls `predArgsAgreeEncl`, which adds a
-- tyvar-IDENTITY arm on the strength of a measurement that its two vectors share one
-- instantiation.  That measurement covers only that channel — the caution below is
-- unretracted here, and widening it to this one needs its own measurement.
-- ⚠️ EMPTY ON EITHER SIDE IS **NOT** AGREEMENT — an absent vector must not let pass 1
-- claim a slot it knows nothing about, or the two passes collapse into one and the
-- `(Ix a Char, Ix a Bool)` discrimination is lost.  Agreement is head-tycon-wise and
-- only where BOTH sides are ground: the recorded vector is in the SIGNATURE's
-- instantiation vars while the goal is in the call's, so a position that is a variable
-- on either side carries no information here and must not veto.
predArgsAgree : List Mono -> List Mono -> Bool
predArgsAgree [] _ = False
predArgsAgree _ [] = False
predArgsAgree gs vs
  | listLen gs /= listLen vs = False
  | otherwise = argHeadsAgree gs vs

argHeadsAgree : List Mono -> List Mono -> Bool
argHeadsAgree (g::gs) (v::vs) = monoHeadAgrees g v && argHeadsAgree gs vs
argHeadsAgree _ _ = True

monoHeadAgrees : Mono -> Mono -> Bool
monoHeadAgrees a b = match headTyconNameMono a
  None => True
  Some x => match headTyconNameMono b
    None => True
    Some y => x == y

-- #1177: the predicate a METHOD occurrence discharges — the interface [name] is
-- declared by, plus its full instantiated type-parameter vector when [fullMono] lets
-- `ifaceParamMonos` recover one.  `None` for a non-method name (a top-level
-- constrained call), which is what keeps those sites on the tyvar-keyed lookup.
--
-- SLICE-1 SUPPLY (#1182): the interface is read from `admittedIfaceFor`, NOT from
-- `ifaceOfMethodName` — the SAME `omLookup name perRun.value.methodIfaceParamsRef`,
-- with the `.irName` projection removed.  No new channel, no new parameter: the
-- identity was already in the tuple this lookup returns and was being thrown away one
-- line later by `ifaceRefBare`.  PURE SUPPLY: this predicate's only consumers are
-- `enclSlotIndex`/`indexOfPredGo` and `implReqDictVarOf`/`implReqPick`, both of which
-- compare `sp.iface.irName == p.iface.irName` — a NAME compare that cannot see an
-- origin — so nothing selects differently today.  What it buys is that the goal side
-- is no longer laundered through `OriginUnresolved`, which is the precondition for
-- re-keying those two comparators onto `sameTyConHead`.
goalPredOf : String -> Mono -> Option Predicate
goalPredOf name fullMono = map
  (ifr => Predicate {
    iface = ifr,
    args = fromOption [] (ifaceParamMonos name fullMono),
  })
  (admittedIfaceFor name)

-- the operator/unop form: the node carries one operand mono, not a method occurrence,
-- so no argument vector is recoverable (`stampOpRouteVal` says the same).  Every
-- operator interface is single-param anyway, so the interface alone is the predicate.
-- Same SLICE-1 supply as `goalPredOf` above, same table, same reasoning.
goalPredOfOp : String -> Option Predicate
goalPredOfOp name =
  map (ifr => Predicate { iface = ifr, args = [] }) (admittedIfaceFor name)

-- Phase 151 / Gap G: stamp each comparison/equality OPERATOR site's EBinOp route
-- ref with the resolved Eq/Ord impl key (RKey) — but ONLY when the operand type
-- grounds to a NON-primitive head tycon.  Primitive (Int/Float/String/Bool/Char)
-- and ungroundable operands stay RNone → the structural-builtin EBinOp eval path
-- (so `eq a b = a == b` on Int never recurses).  Mirrors resolveSite's concrete
-- branch (head tycon → canonical key) minus the impl-dicts: the rewritten `eq`/`lt`
-- is arg-position, so it narrows by arg tag and needs no forwarded element dict.
binopPrimitiveHead : String -> Bool
binopPrimitiveHead h = contains h ["Int", "Float", "String", "Bool", "Char"]

-- Roadmap #18a: the heads a binop lowers to a BUILTIN for, and must therefore never
-- route to a typeclass method.  For the comparison operators that is exactly the
-- scalar primitives.  For `++` (→ Semigroup's `append`) it is those PLUS `List`:
-- `++` on a String/List is lowered structurally (eval's `appendVal`; the emitter's
-- `mdk_string_append`/`mdk_list_append`), and core.mdk's own builtin impls are
-- written in terms of the operator —
--     impl Semigroup (List a) where append xs ys = xs ++ ys
--     impl Semigroup String   where append s1 s2 = s1 ++ s2
-- — so routing a List/String `++` to `append` would make those bodies call
-- themselves unboundedly.  Every OTHER head still routes, which is precisely what
-- makes a user `impl Semigroup MyRope` reachable from `a ++ b`.
binopBuiltinHead : String -> String -> Bool
binopBuiltinHead "append" tag = binopPrimitiveHead tag || tag == "List"
binopBuiltinHead _ tag = binopPrimitiveHead tag

-- SHARED-FLOAT-RESIDUAL §3(C): after the module is inferred, zonk each recorded
-- arithmetic operand mono; when it grounds to concrete Float, stamp RScalar
-- "Float" on the node's route so lowering carries it into CBinPrim and the native
-- emitter picks the Float primitive (bypassing the type-lost structural
-- staticIsFloat).  Grounded-only, exactly like resolveBinopSite: a still-
-- polymorphic operand (headTyconMono None) is left untouched (RNone → dict path),
-- so polymorphic-Num arithmetic keeps routing through the runtime Num dict.  Only
-- Float is stamped (Int is the primitive default already; leaving Int operands
-- RNone avoids perturbing every integer binop's emitted IR).  Never overwrites a
-- route another pass already set (a comparison op has a different node/ref; an
-- arithmetic route starts RNone) — the guard is: stamp only if the site is still
-- RNone AND grounds to Float.
resolveArithSites : List (Ref Route, Mono) -> Unit
resolveArithSites [] = ()
resolveArithSites ((dref, m)::rest) =
  let _ = resolveArithSite dref m
  resolveArithSites rest

resolveArithSite : Ref Route -> Mono -> Unit
resolveArithSite dref m = match !dref
  RNone => match headTyconNameMono m
    Some "Float" => dref := RScalar "Float"
    _ => ()
  _ => ()

-- EBinOp and EUnOp share ONE dict-route resolution family
-- (resolveOpSites/resolveOpSite/stampOpRouteVal/opDictVarOf), selected by an `isBinop`
-- flag (Roadmap #18c collapsed the binop/unop mirror pair — unopMethodApp already
-- reused binopRouteSplit, proving the shapes unify).  The two paths differ in exactly
-- two flag-keyed places: the dict-var-of policy (opDictVarOf) and the RKey stamp
-- (stampOpRouteVal — its builtin-head guard and Ord-style innerDefaultMethod reduction).
-- #156 S3c: resolveOpSite is now a thin adapter over `entail` (EKOp kind); the inst
-- route is stampOpRouteVal, a pure Route-returning extraction of the old stampOpRoute.
resolveOpSites : Bool -> ImplBuckets -> List PendingEntry -> Unit
resolveOpSites _ _ [] = goalSiteLoc := None
resolveOpSites isBinop implTable ((PendingEntry method tagRef operandMono encl kind loc)::rest) =
  goalSiteLoc := loc
  let _ = match kind
    SKOp inImpl =>
      resolveOpSite isBinop implTable method tagRef operandMono inImpl encl
    _ => ()
  resolveOpSites isBinop implTable rest

-- G4: an `==`/`<`/… INSIDE an impl body ([inImpl]) whose operand is the enclosing
-- impl's abstract `requires`-constrained tyvar routes RDict that impl's element dict
-- (`activeDictVarOf` maps the operand's surviving tyvar id → `$dict_<method>_<slot>`,
-- registered by registerImplRequires after body inference; this deferred batch sees
-- the populated table).  binopMethodApp then rewrites it to a dict-dispatched
-- `eq x y` and `usesImplDict` prepends the matching param.  Without this the abstract
-- operand never grounds to a head tycon → the route stayed RNone → the SHALLOW
-- structural builtin (`mdk_value_eq` / pointer-eq), silently mis-comparing any non-Int
-- element (List → False, nested Box → False) and crashing once the dicts were threaded.
-- The [inImpl] gate is REQUIRED for the GLOBAL activeDictVars route: activeDictVars
-- is global + uncleared, so a TOP-LEVEL comparison's operand tyvar id can collide
-- with a stale impl element-var entry → a spurious RDict (this flipped the repl's
-- String-keyed `:browse` sort).  But a legitimately-constrained TOP-LEVEL operator
-- (`f x y = x == y` under `Eq a =>`) must STILL forward the enclosing fn's own class
-- dict, exactly as the direct `eq x y` arg-stamp path does.  enclDictVarOf draws that
-- line PRECISELY: it consults `funConstraintsRef[encl]` (the enclosing fn's OWN
-- declared constraint slots, keyed by fn name) — NOT the global activeDictVars — so
-- it fires ONLY when the operand var is genuinely one of encl's constraint vars, and
-- can never pick up a stale cross-impl element-var id.  A concrete operand (no active
-- dict var / not a constraint var, grounds to Some tag) keeps the existing RKey path.
--
-- Roadmap #18a RESIDUAL — `++`/`append` does NOT take the IN-IMPL element-dict route.
-- `binopDictVarOf` sends `append` to `enclDictVarOf` even when inImpl, so an operand
-- that is an impl's abstract `requires` tyvar stays RNone (the structural builtin)
-- instead of routing the impl's threaded element dict.
--
-- WHY (measured, not assumed).  Taking that route for `append` regresses
-- `test/eval_typed_modules_fixtures/impl_requires_nonfunctor_sibling`:
--     impl Applicative (VT e) requires Semigroup e where
--       pure a = VS a
--       ap (VF e1) (VF e2) = VF (e1 ++ e2)
-- Routing `e1 ++ e2` to `$dict_ap_0` makes `usesImplDict "ap"` true for the FIRST
-- time, so `implDictPassMethods` PREPENDS an impl-`requires` dict param to `ap` —
-- which shifts `ap`'s arg-position dispatch index by one.  The VTypedImpl's recorded
-- discriminating indices are NOT re-offset to match, so the impl then tag-checks its
-- leading DICT argument instead of its receiver, rejects it, and every candidate
-- falls through → `no matching impl for dispatch`.  (Before #18a that
-- `requires Semigroup e` was effectively DEAD — nothing in the body consumed it —
-- which is why the latent hole never fired.)  Fixing it properly means re-offsetting
-- arg-dispatch indices when impl-dict params are prepended: Phase 83/84 territory,
-- across ast/typecheck/dict_pass/eval, and deliberately NOT attempted here.
--
-- What still works (all gated): a GROUND non-builtin operand (`Rope "a" ++ Rope "b"`)
-- routes RKey to the user impl — the whole point of #18a, and the fix for the `build`
-- SIGSEGV; a TOP-LEVEL declared `Semigroup a => a -> a` routes RDict through
-- `enclDictVarOf` (the enclosing fn's OWN declared constraint slot, a different and
-- already-sound dict source); and String/List stay on the structural builtin.
-- What does NOT: `++` on an impl's abstract `requires`-bound tyvar — it keeps the
-- pre-#18a builtin behaviour exactly (correct for List/String, which is every such
-- site in the tree today), so this is a residual, not a regression.
-- BINOP path (`isBinop`): `append` → enclDictVarOf even when inImpl (Roadmap #18a
-- residual, above); any other method → activeDictVarOf when inImpl, else enclDictVarOf.
-- UNOP path (not `isBinop`): ALWAYS enclDictVarOf.  Roadmap #18a/#45 landmine (same
-- shape as the `append` residual): routing `-x` through activeDictVarOf can make
-- usesImplDict true for a method for the FIRST time, prepending a dict param that
-- shifts the impl's arg-dispatch index without re-offsetting the VTypedImpl's
-- discriminating indices — dispatch then tag-checks the dict instead of the receiver.
-- So `-x` on an impl's own abstract `requires`-bound tyvar stays on the structural
-- builtin (RNone) via a top-level fn's own declared constraint slot, never
-- activeDictVarOf — a residual, not a regression (mirrors the `++` residual exactly).
opDictVarOf : Bool -> String -> Mono -> Bool -> String -> Option String
opDictVarOf True "append" m _ encl =
  enclDictVarOf (goalPredOfOp "append") m encl
opDictVarOf True name m inImpl encl
  | inImpl = activeDictVarOf m
  | otherwise = enclDictVarOf (goalPredOfOp name) m encl
opDictVarOf False name m _ encl = enclDictVarOf (goalPredOfOp name) m encl

-- #156 S3c: a thin adapter over `entail` (EKOp kind).  `entail`'s ladder IS this
-- resolver's ladder: assum = opDictVarOf → RDict; inst = stampOpRouteVal (builtin head →
-- RNone; else RKey with the element reqs PACKED in, so `snd` is empty and no separate
-- implRef exists); fallback = RNone.  Op-site route refs are ALWAYS `Ref RNone`-seeded
-- (parser 480/512/537/541/545 + desugar 171; rewriteArgScoped 7472-7475 recurses into
-- EBinOp/EUnOp keeping the same ref, never re-seeding it), so the two do-nothing arms
-- (builtin-inst, fallback) both yield RNone and the RNone guard preserves that seed
-- byte-identically — reproducing the pre-S3c `()` arms.
resolveOpSite : Bool -> ImplBuckets -> String -> Ref Route -> Mono -> Bool -> String -> Unit
resolveOpSite isBinop implTable method tagRef operandMono inImpl encl = match fst (entail implTable method operandMono encl (EKOp isBinop inImpl))
  RNone => ()
  route => tagRef := route

-- Native Gap C: a tuple (or other parametric-with-requires) Eq/Ord impl carries
-- element `requires` dicts (Eq a, Eq b) that the rewritten `eq`/`compare` method body
-- reads.  Stamp them into the RKey route's reqs so binopMethodApp can forward them
-- as the EMethodAt impl-dict routes — exactly as resolveArgStamp does for a direct
-- `eq`/`compare` call.  A concrete non-parametric impl (user `Eq MyType`) has no
-- requires → empty reqs → the plain direct call, behaviour unchanged.
--
-- PARAMETRIC DEFAULT CASE (now routed RKey, gap closed 2026-06-12): a comparison
-- OPERATOR (`<`/`>`/`<=`/`>=` → `lt`/`gt`/`lte`/`gte`) whose method is NOT itself
-- impl'd at this head (an Ord interface DEFAULT reducing to inner `compare`) AND the
-- head's Ord impl HAS `requires` (parametric, e.g. tuple / `List a` / `Box a`).  This
-- stamps the RKey route with the SAME element-dict reqs as the `==`/`eq` path, but
-- keyed on the INNER same-interface `compare` (the relational method has no own impl
-- at this head, so `argImplDictRoutesFor` keyed on it would find nothing).
-- binopMethodApp forwards them as the EMethodAt impl-dicts; emitDefaultRKey passes
-- them as leading words to `@mdk_default_<op>_<tag>`, whose emitDefaultDefine
-- eta-PREPENDS the matching dict params and threads them into the inner
-- `@mdk_impl_<tag>_compare(dict.., a, b)` call.  Previously this case BACKED OFF to
-- RNone, which the backend lowered as a raw pointer `icmp` (silently WRONG result) /
-- SIGSEGV on the by-name `lt` path.  Concrete Ord (no requires) keeps empty reqs →
-- the plain `@mdk_default_<op>_<tag>(a, b)` direct call, unchanged.
-- Flag-keyed differences between the two paths:
--   * builtin-head guard — BINOP: `binopBuiltinHead method tag` (append also treats
--     List as builtin); UNOP: `binopPrimitiveHead tag` (a ground Int/Float stays on
--     evalUnop's VInt/VFloat fast path, the unop analogue of the comparison guard).
--   * dictMethod — BINOP reduces an Ord-style interface DEFAULT to its inner
--     same-interface `compare` (innerDefaultMethod) when the head does not impl the
--     method directly; UNOP has no interface-level default to reduce through (every
--     `impl Num`, including Int/Float's own `negate a = 0 - a`, defines `negate`
--     directly), so dictMethod is just `method`.
-- #156 S3c: the PURE op-site inst route (called from entailInst's EKOp arm).  A builtin
-- head → RNone (the do-nothing case the old `if isBuiltin then ()` arm expressed; the
-- adapter's RNone guard turns it back into a no-op that preserves the ref's RNone seed).
-- Else a concrete non-builtin head → `RKey key reqs` with the element `requires` dicts
-- PACKED into the primary route's reqs (binopRouteSplit later rips them onto the
-- EMethodAt impl-dict ref).  Byte-identical to the pre-S3c stampOpRoute stamper.
stampOpRouteVal : Bool -> ImplBuckets -> String -> Mono -> String -> Route
stampOpRouteVal isBinop implTable method operandMono tag =
  let isBuiltin = if isBinop then
    binopBuiltinHead method tag
  else
    binopPrimitiveHead tag
  if isBuiltin then RNone
  else
    -- #609: no interface param vector is recoverable at an operator site (the
    -- node carries one operand mono, not a method occurrence), so the goal is the
    -- singleton — entryHeadMatches then takes its arg-0 fallback, byte-identical
    -- to the pre-#609 scan.  Every operator interface (Eq/Ord/Num) is single-param
    -- anyway, where the singleton IS the full vector.
    let key = fromOption tag (keyForSite method [operandMono])
    -- ARCH B-2.1-h: graph-global, off `bodyImplEnvRef` — see `ieDefinesReqMethodAt`.
    -- The head projection is `headTyconMono operandMono`, i.e. the `HeadKey` whose
    -- `headKeyName` IS the `tag` this arm was passed (`entail` derives both from the
    -- same mono, `headTyconNameMono`/`headTyconMono` classify the same nodes), so the
    -- LOOKUP is the same question at the same key strength — only the POPULATION moved.
    let dictMethod = if isBinop then
      if ieDefinesReqMethodAt perRun.value.bodyImplEnvRef.value method (headTyconMono operandMono) then method else innerDefaultMethod method
    else
      method
    let reqs = argImplDictRoutesFor implTable dictMethod tag operandMono
    RKey key reqs
-- Gap #21 (CLOSED): element reqs are now forwarded unconditionally on both eval and
-- emit paths.  The impl method `eq`/`compare` carries leading `$dict_*` params
-- (resolveArgStamps runs on both paths); emitter applies them; eval's methodAtNarrow
-- forwards dict reqs (like RDictFwd) truncated to the matched impl's reqCount.

-- The inner same-interface method an interface DEFAULT reduces to, supplying the
-- element `requires` dicts.  Ord's `lt`/`gt`/`lte`/`gte`/`min`/`max` defaults all
-- reduce to `compare`; any other relational/equality method has its own impl so the
-- `ieDefinesReqMethodAt` guard keeps it on `method`, never reaching here.
innerDefaultMethod : String -> String
innerDefaultMethod m =
  if contains m ["lt", "gt", "lte", "gte", "min", "max"] then
    "compare"
  else
    m

-- ── ARCH B-2.1-h (Stage B repair): THE METHOD-SET GUARD, GRAPH-GLOBAL ────────
-- 🚨 THE PREDECESSOR (`implDefinesMethodAt`, over the cumulative-prefix
-- `ImplBuckets`) WAS THE LAST "ONE DECISION, TWO SUBSTRATES" SITE, and it was
-- MEASURED, not inferred.  Its answer chooses the METHOD NAME
-- (`method` vs `innerDefaultMethod method`) that `argImplDictRoutesFor`/
-- `argImplDictRoutesForEncl` then SELECT ON over the graph-global `IE`
-- (`bodyImplEnvRef`) — so a prefix miss did not merely lose a route, it handed the
-- global selector a DIFFERENT GOAL for the same program.  Repro (`.claude/sprint-b/
-- repair/F1-verdicts.md` finding 6): an `impl Cmp (Box a) requires Cmp a` defining
-- `lt` and INHERITING `compare`, in a module the use site does not import.  Swapping
-- the two `import` lines in `main.mdk` moved that impl in and out of the use site's
-- topological prefix, so the guard answered True/False for the SAME program:
-- `lt` under one order, `compare` under the other, 589 lines of IR apart, and the
-- losing order BUILT AT EXIT 0 and died at `E-NONEXHAUSTIVE-MATCH`.  That is C4
-- (`docs/spec/DICT-SEMANTICS.md`: same predicate ⇒ same instance set ⇒ same
-- evidence) failing at the stamper, and `:19211-19217`'s "One substrate, one
-- decision" forbidding it by name two organs above the violation.
--
-- ⚠️ THE POPULATION MOVED AND NOTHING ELSE DID, deliberately — this is the same
-- shape as `B-2.1-g` and it keeps that bite's discipline:
--   • KEY STRENGTH is unchanged.  Both sides still project through `dispHeadTab`
--     (`headTabEq`), i.e. the head tycon SPELLING, exactly as `tag2 == tag`
--     compared two `headTyconNameTy`/`headTyconNameMono` names.  A structural
--     `HeadKey` compare here would re-open #1111 — see `headTabIs`' 🚨 note.
--   • THE `requires`-ONLY FILTER IS KEPT (`implRowHasReqs`).  `ImplBuckets` was
--     built by `implEntryOf`, whose `match reqs [] => []` arm drops every impl with
--     no context, so the predecessor could only ever answer True for a
--     `requires`-carrying impl.  Dropping that filter is a SECOND, independent
--     semantic change (it would stop reducing to `compare` for context-free impls
--     that define the method directly) and it is NOT what the S1 needs.  It is
--     recorded as owed rather than smuggled in here.
-- The net motion is therefore a pure WIDENING of the same predicate: every True the
-- prefix answered, this answers; the ones it adds are exactly the impls the global
-- selector could already see and the guard could not.
ieDefinesReqMethodAt : ImplEnv -> String -> Option HeadKey -> Bool
ieDefinesReqMethodAt env method hd =
  -- goal-side key projected ONCE, here — see `headTabOf` (Medaka is strict).
  ieDefinesReqMethodAtGo (ieHeadRows hd env) method (headTabOf hd)

ieDefinesReqMethodAtGo : List ImplRow -> String -> Option TabKey -> Bool
ieDefinesReqMethodAtGo [] _ _ = False
ieDefinesReqMethodAtGo ((ImplRow _ _ _ tys reqs ms)::rest) method goal
  | implRowHasReqs reqs && headTabEq (univReceiverTag tys) goal && contains method ms = True
  | otherwise = ieDefinesReqMethodAtGo rest method goal

-- `implEntryOf`'s `match reqs [] => []` arm, as a predicate over an `IE` row.
implRowHasReqs : List Require -> Bool
implRowHasReqs [] = False
implRowHasReqs _ = True

-- ── coherence check (TYPECHECK-AUDIT S3) ───────────────────────────────────
-- Mirror lib/typecheck.ml's check_coherence (Phase 68): reject incoherent USER
-- impl sets at declaration time.  Two impls of the SAME interface whose head
-- types can match the same concrete type (impls_overlap) are unresolvable unless
-- one strictly specializes the other (most-specific-wins).  Genuinely incoherent:
--   • two overlapping impls that are NOT a strict specialization → OverlappingImpls.
-- (Named impls + `@Name` selection + `default impl` were removed 2026-07-11; the
-- newtype-wrapper approach is the answer for a second instance.)
-- Prelude/seeded impls are excluded entirely (the driver passes USER decls only):
-- user impls are meant to override prelude impls (e.g. single-file `impl Ord Int`),
-- so they must not pair with a prelude `impl Ord Int`.  At most ONE error is
-- emitted (mirrors the oracle raising Type_error on the first conflict).

-- a user impl, reduced to what coherence needs: iface + head-arg monos (fresh
-- vars).
-- CohImpl iface head-tys ownerModuleId headLoc.  The 3rd field is the id of the
-- module that PHYSICALLY declares this impl ("" for the single-file / entry path, so
-- its goldens stay byte-identical — only the global cross-module check threads a real
-- module id and uses it to name BOTH modules in a conflict).  The 4th is the span of
-- the impl's head type constructor (#414), so a conflict can point AT an impl instead
-- of fabricating a file-start caret; `None` for a synthesized impl with no source
-- span (e.g. desugar's `deriving` lowering, which builds `tyConUnresolved tyName None`).
--
-- #1559 A-3.7: the 1st field is an `IfaceRef` — the interface's SPELLING plus its
-- I4 identity — not a bare `String`.  It was a bare `String` compared with
-- `if1 == if2` until this unit, which is why two UNRELATED modules that each
-- declared their own interface spelled `Same` and each impl'd it at a shared head
-- were reported as conflicting (#1438's coherence reach; the false reject is
-- pinned, pre-fix, at `test/must_fail_fixtures/1438-*`).  See `cohSameIface` for
-- WHICH identity predicate is correct here and why the other one is a severity
-- increase.
public export data CohImpl = CohImpl IfaceRef (List Mono) String (Option Loc)

-- 🪦 RETIRED 2026-08-12 (#1559 A-3.7 bite 3.7-9): `cohImplsOf` / `cohImplsOfMid` —
-- the decl-walking adapters that built `CohImpl`s straight off `DImpl` nodes, and
-- `cohCollectImpls` / `cohCollectModuleImpls`, their two list drivers.  Coherence's
-- input is now a projection of `IE`'s rows (`cohImplOfRow`), so both sweeps read the
-- registry the rest of stage K reads instead of re-walking decls.  Zero tree-wide
-- callers at deletion time (`grep -rn 'cohCollectImpls\|cohCollectModuleImpls\|
-- cohImplsOf' --include=*.mdk .` → definitions and comments only).  The `#414` span
-- derivation they carried is preserved below, because `cohImplOfRow` still calls
-- `firstTyLocList` on the row's raw head and inherits every word of it.
--
-- #414: the span to blame for an impl comes from its head types, via
-- `firstTyLocList` (`frontend/ast.mdk`), which folds `firstTyLoc` — that inner
-- walk is the one shared with resolve (`dupSigOf`); resolve does not call
-- `firstTyLocList` itself (issue 480).
-- A `DImpl` has no `Loc` of its own (`DUse` is the only `Decl` variant
-- carrying one inline) — but the parser stamps every `TyCon` leaf with its span
-- (`parser.mdk`'s parseTyAtom: `tyConUnresolved c (Some (locOfSpan s q))`), so the head's
-- own tycon IS the impl's location.  Pre-order, so `impl C (Pair a Int)` blames
-- `Pair` — the head — not the argument.
--
-- ⚠️ RESIDUAL (#414): only `TyCon` leaves carry spans, so a head with NO tycon —
-- the fully-parametric `impl Foo a` — still yields `None` and falls back to the
-- file-start caret.  That is the degenerate overlap case (`test/
-- typecheck_error_fixtures/overlapping_impls.mdk`).  Closing it needs a span on
-- `TyVar` (an ast.mdk change rippling through every `Ty` consumer) or the parser's
-- `DeclPos` side-table threaded into typecheck; both are out of proportion to an
-- S3 diagnostic-quality fix.  Every head naming a CONCRETE type is covered.
--
-- #1559 A-3.7 OCCURRENCE MINT, and the retirement above is the reason it worked:
-- the deleted adapter destructured `implOrigin` in the SAME record pattern as `iface`
-- and built the `IfaceRef` from that pair on the spot, using the identical expression
-- `implDeclFact` uses to build `ImplRow`'s interface half.  Because the two
-- constructions could not drift, replacing the adapter with a projection of `IE`'s
-- rows yields the same interface half by construction rather than by assertion.
--
-- the impl's head args → monos under ONE shared fresh-var map (so a var reused
-- across args, e.g. `Conv a a`, is the SAME fresh tyvar — the oracle shares one
-- tbl across the whole impl head; distinct impls get distinct ids).
cohFreshTys : List Ty -> List Mono
cohFreshTys tys =
  let names = dedup (flatMap tyVarNames tys)
  let tvs = freshTvMap names
  map (fromAstType tvs) tys

-- #1559 A-3.7: THE `IE`→`CohImpl` ADAPTER — coherence's input, relocated off the decl
-- walk.  Every one of the four things coherence judges on comes out of the row:
--   * the interface half is `ieRowTriple`'s `IfaceRef` — the SAME value
--     `cohImplsOfMid` built by hand from `iface`+`implOrigin`, because `implDeclFact`
--     builds it with the identical expression.  That is why this relocation is not an
--     acceptance change: `cohSameIface` (3.7-4) sees the same pair of `IfaceRef`s.
--   * the head is `cohFreshTys` of the row's raw `List Ty`, the same call the decl
--     adapter made.  Effectful (fresh tyvars), exactly as the decl adapter was.
--   * the owner module id is `instRefMid` of the row's `InstRef` — this is where
--     `InstRef` acquires its FIRST judgment reader in this tree.
--   * the blame span is `firstTyLocList` of that same raw head.
-- ⚠️ `ieLoc` IS NOT OWED FOR THIS.  `ImplRow`'s "no location field" note argues from
-- `Decl` carrying no `Loc`, which is true and beside the point: the row carries the
-- raw `List Ty`, and the parser stamps every `TyCon` leaf with its span, so the span
-- coherence uses today is recoverable with no new field and no `DImpl` change.
cohImplOfRow : ImplRow -> CohImpl
cohImplOfRow r = match ieRowTriple r
  (ir, tys, _) => CohImpl ir (cohFreshTys tys) (instRefMid (ieRowInst r)) (firstTyLocList tys)

-- #1559 A-3.7: 🚨 THE PRELUDE CARVE-OUT, AND [hasPrelude] IS THE WHOLE POINT OF IT.
-- Coherence has never seen prelude impls: a user `impl Eq Int` deliberately overrides
-- the prelude's and is α-equal to it, so pairing the two would reject
-- `test/lint_fixtures/derivable_needs_datadecl.mdk` and every program like it.  Both
-- old adapters got this for free — `checkCoherence` was handed the driver-staged USER
-- decls and `cohCollectModuleImpls` walked USER modules only.  An `IE` built by
-- `buildDeclEnvs` contains the prelude, so the exclusion has to be made explicit.
--
-- The prelude is ALWAYS ordinal 0 on the Module arm, structurally: `buildDeclEnvs`
-- builds `declEnvModulesFrom 0 (("core", coreDecls)::modules)`, so nothing else can be.
--
-- ⚠️ AND A HARDCODED `/= 0` WOULD BE WRONG — IT IS THE MOST DANGEROUS LINE IN THIS
-- UNIT.  `flatImplEnvOf` builds its ONE user module at ordinal 0, so on the Flat arm
-- `/= 0` drops EVERY row and turns every flat coherence rejection into a silent
-- accept.  Flat's prelude/user boundary is carried by the decl list the driver hands
-- in (`coherenceUserDecls`), not by an ordinal, so Flat passes `False` here and there
-- is nothing to filter.  Module passes `True`.
cohRowVisible : Bool -> ImplRow -> Bool
cohRowVisible hasPrelude r = not (hasPrelude && ieRowOrd r == 0)

-- the whole-graph sweep's population (`globalCoherenceConflict`).  The filter runs
-- BEFORE the caller's `reverseL`, so the surviving list's head is the first USER
-- module — which is exactly what the decl-walking adapter's list was.
cohRowsOf : Bool -> ImplEnv -> List ImplRow
cohRowsOf hasPrelude env = filterList (cohRowVisible hasPrelude) (ieRowsAll env)

-- the per-module sweep's population (`checkCoherence`).  The carve-out is composed in
-- rather than assumed away: on Module [cur] is a user module's ordinal and so never 0,
-- and on Flat [hasPrelude] is `False` — so this filter removes nothing on either live
-- arm.  It is written anyway because "0 is never both" is a property of the callers,
-- not of this function, and a fourth caller would not inherit it.
cohRowsOwnedBy : Int -> Bool -> ImplEnv -> List ImplRow
cohRowsOwnedBy cur hasPrelude env =
  filterList (cohRowVisible hasPrelude) (ieRowsOwnedBy cur env)

-- impls_overlap: do two impl head-arg lists share a common instance?  Every
-- TVar (fresh per impl, so distinct ids) is a unification wildcard with a shared
-- subst — `(List Int)` vs `(List a)` overlap via a:=Int; `a a` vs `Int Bool`
-- does NOT (resolve binds a:=Int, then Int vs Bool fails), mirroring the oracle.
cohOverlap : List Mono -> List Mono -> Bool
cohOverlap xs ys
  | listLen xs == listLen ys = cohOverlapGo (Ref []) (zipL xs ys)
  | otherwise = False

cohOverlapGo : Ref (List (Int, Mono)) -> List (Mono, Mono) -> Bool
cohOverlapGo _ [] = True
cohOverlapGo subst ((a, b)::rest)
  | cohGo subst a b = cohOverlapGo subst rest
  | otherwise = False

-- resolve a mono through the wildcard subst (chasing bound vars)
cohResolve : Ref (List (Int, Mono)) -> Mono -> Mono
cohResolve subst m = match normalize m
  TVar cell => match lookupAssocI (tyvarId cell) !subst
    Some m2 => cohResolve subst m2
    None => TVar cell
  other => other

cohGo : Ref (List (Int, Mono)) -> Mono -> Mono -> Bool
cohGo subst t1 t2 = cohGoR subst (cohResolve subst t1) (cohResolve subst t2)

cohGoR : Ref (List (Int, Mono)) -> Mono -> Mono -> Bool
cohGoR subst (TVar c1) (TVar c2)
  | tyvarId c1 == tyvarId c2 = True
  | otherwise = cohBind subst (tyvarId c1) (TVar c2)
cohGoR subst (TVar c1) t = cohBind subst (tyvarId c1) t
cohGoR subst t (TVar c2) = cohBind subst (tyvarId c2) t
-- #1111 A-2.10: identity-aware, same rule as `unifyN` (`sameTyConHead`).  Two
-- impl heads that merely SPELL the same type no longer overlap, so a coherence
-- conflict is no longer reported between `impl C a.T` and `impl C b.T` — which
-- is the correct answer: they are different types.
cohGoR _ (TCon a oa) (TCon b ob) = sameTyConHead a oa b ob
-- #1110: name equality, exactly as the shared `TCon` arm gave, for the
-- cross-population pairs ONLY — A-2.10 deliberately left these two alone.  A
-- `TRigid` carries no origin at all, so routing them through `sameTyConHead`
-- would compute "no conflict" and answer the same thing; the preserved forgery
-- is #1243 / §8 I6.2(b), a different clause.  ⚠️ NOT SEPARATELY PROBED — armed
-- because the pre-split `TCon` arm answered these pairings with the same
-- `a == b`, and a rigid and a real head CAN share the name `__tupleN__` (see
-- `Mono.TRigid`).  Whether a coherence sweep can actually be reached with such a
-- pair is unmeasured; the arm is answer-preserving either way.  Measured
-- instances of the same forgery are `unifyN` and `matchStep`.
cohGoR _ (TRigid a) (TRigid b) = a == b
cohGoR _ (TCon a _) (TRigid b) = a == b
cohGoR _ (TRigid a) (TCon b _) = a == b
cohGoR subst (TApp f1 a1) (TApp f2 a2) = cohGo subst f1 f2 && cohGo subst a1 a2
cohGoR subst (TFun a1 _ b1) (TFun a2 _ b2) = cohGo subst a1 a2
  && cohGo subst b1 b2
cohGoR _ (TEff _) (TEff _) = True
cohGoR _ _ _ = False

-- bind id := m in the wildcard subst and return True
cohBind : Ref (List (Int, Mono)) -> Int -> Mono -> Bool
cohBind subst id m =
  subst := (id, m) :: !subst
  True

-- ── shared one-sided matcher core (#156 S1) ────────────────────────────────
-- cohSubsumes (Mono-space), tySubsumes (AST-space) and matchTyMono (AST head-
-- pattern vs Mono) are the SAME one-sided, consistency-enforcing structural match
-- in three node spaces: only the GENERAL side's vars bind, a var bound twice must
-- be CONSISTENT (its two specific bindings structurally equal), and effect rows
-- are IGNORED (row-blind — §7's single-meaning law).  They differ only in (a) how
-- a node is destructured into a var / children / leaf and (b) the specific-side
-- equality used for the consistency check.  [matchOneSided] is that shared core:
-- it walks a worklist of (general, specific) pairs, threads a key→specific subst,
-- and returns it (None on a head-mismatch OR an inconsistent re-bind).  The Bool
-- frontends are `isSome ∘ matchOneSided`; matchTyMono returns the subst itself.
-- Enforcing consistency HERE is what makes matchTyMono a genuine SUBSTITUTION
-- (DICT-SEMANTICS §3 `inst`): the old `xs ++ ys` combine accepted an inconsistent
-- non-linear-head match (e.g. `Get (Box a) a` vs `Get (Box Int) Bool`) and so
-- could false-match and select the wrong impl's requires.  cohOverlap is NOT a
-- frontend of this core — it is two-sided unification (both sides' vars bind), the
-- coherence-overlap check, and stays separate.
--   MVar k   — the general node is a variable keyed [k]; bind/consistency-check it.
--   MKids ps — heads agree; recurse on these (general, specific) child pairs.
--   MOk      — leaf success (matching TCons, or two effect rows).
--   MFail    — head mismatch (no match).
data MStep k g s = MVar k | MKids (List (g, s)) | MOk | MFail

matchOneSided : (g -> s -> MStep k g s) -> (k -> k -> Bool) -> (s -> s -> Bool) -> List (g, s) -> List (k, s) -> Option (List (k, s))
matchOneSided _ _ _ [] acc = Some acc
matchOneSided step keyEq eqS ((g, s)::rest) acc = match step g s
  MFail => None
  MOk => matchOneSided step keyEq eqS rest acc
  MKids kids => matchOneSided step keyEq eqS (kids ++ rest) acc
  MVar k => match lookupBy keyEq k acc
    Some prev =>
      if eqS prev s then
        matchOneSided step keyEq eqS rest acc
      else
        None
    None => matchOneSided step keyEq eqS rest ((k, s)::acc)

-- NB: the comparison parameter must NOT be named `eq` — that is the prelude Eq
-- method, and the marker would rewrite the local reference into a method call,
-- importing a phantom `Eq k` constraint the signature can't discharge.
lookupBy : (k -> k -> Bool) -> k -> List (k, v) -> Option v
lookupBy _ _ [] = None
lookupBy keq k ((k2, v)::rest) =
  if keq k k2 then
    Some v
  else
    lookupBy keq k rest

-- subsumes ~general ~specific: is [specific] an instance of [general]?  Only the
-- general side's vars bind (consistently: a var bound twice must see structurally
-- equal types); the specific side's vars are rigid (match only the same id).
cohSubsumes : List Mono -> List Mono -> Bool
cohSubsumes general specific
  | listLen general == listLen specific =
    isSome (matchOneSided cohStep eqInt cohEqMono (zipL general specific) [])
  | otherwise = False

-- Mono-space step: normalize BOTH sides (chasing links), then classify the general
-- node.  Effect rows are row-blind (TEff/TEff ⇒ MOk; TFun's row slot ignored).
cohStep : Mono -> Mono -> MStep Int Mono Mono
cohStep g0 s0 =
  let g = normalize g0
  let s = normalize s0
  match g
    TVar c => MVar (tyvarId c)
    -- #1111 A-2.10 on the `TCon`/`TCon` pairing only (`sameTyConHead`); the
    -- cross-population arms stay name-only for the reason `cohGoR` gives.
    -- ⚠️ The cross-population ones are NOT SEPARATELY PROBED — armed
    -- because the pre-split arm answered them, and because a rigid and a real
    -- head CAN both spell `__tupleN__` (see `Mono.TRigid`).  Measured instances
    -- of that forgery: `unifyN`, `matchStep` (§8 I6.2(b), OWED-#1243).
    TCon a oa => match s
      TCon b ob => if sameTyConHead a oa b ob then MOk else MFail
      TRigid b => if a == b then MOk else MFail
      _ => MFail
    TRigid a => match s
      TRigid b => if a == b then MOk else MFail
      TCon b _ => if a == b then MOk else MFail
      _ => MFail
    TApp f1 a1 => match s
      TApp f2 a2 => MKids [(f1, f2), (a1, a2)]
      _ => MFail
    TFun a1 _ b1 => match s
      TFun a2 _ b2 => MKids [(a1, a2), (b1, b2)]
      _ => MFail
    TEff _ => match s
      TEff _ => MOk
      _ => MFail

eqInt : Int -> Int -> Bool
eqInt a b = a == b

-- rigid structural equality (the specific side's vars match only the same id)
cohEqMono : Mono -> Mono -> Bool
cohEqMono a b = cohEqR (normalize a) (normalize b)

cohEqR : Mono -> Mono -> Bool
cohEqR (TVar c1) (TVar c2) = tyvarId c1 == tyvarId c2
cohEqR (TCon a oa) (TCon b ob) = sameTyConHead a oa b ob
-- #1110: same shape as the `cohGoR` arms — name equality on the cross-population
-- pairings, which A-2.10 left alone for the reason given there.
-- Cross-population pairs NOT SEPARATELY PROBED; armed because the pre-split `TCon`
-- arm answered them.  Reached from `matchStep`'s consistency check, so it is not
-- independent of the measured `matchStep` case.  See `Mono.TRigid`.
cohEqR (TRigid a) (TRigid b) = a == b
cohEqR (TCon a _) (TRigid b) = a == b
cohEqR (TRigid a) (TCon b _) = a == b
cohEqR (TApp f1 a1) (TApp f2 a2) = cohEqMono f1 f2 && cohEqMono a1 a2
cohEqR (TFun a1 _ b1) (TFun a2 _ b2) = cohEqMono a1 a2 && cohEqMono b1 b2
cohEqR (TEff _) (TEff _) = True
cohEqR _ _ = False

-- [a] strictly more specific than [b]: b subsumes a but not a subsumes b
cohStrictlyMoreSpecific : List Mono -> List Mono -> Bool
cohStrictlyMoreSpecific a b = cohSubsumes b a && not (cohSubsumes a b)

-- render two impl head-arg lists against ONE shared naming ctx (so a var shared
-- across both prints identically and distinct vars never collide) — mirrors the
-- oracle's pp_monos_pair.
cohPpPair : List Mono -> List Mono -> (String, String)
cohPpPair xs ys =
  let ctx = Ref []
  let cnt = Ref 0
  let s1 = joinWith " " (cohPpEach ctx cnt xs)
  let s2 = joinWith " " (cohPpEach ctx cnt ys)
  (s1, s2)

cohPpEach : Ref (List (Int, String)) -> Ref Int -> List Mono -> List String
cohPpEach _ _ [] = []
cohPpEach ctx cnt (m::ms) = ppGo ctx cnt 0 m :: cohPpEach ctx cnt ms

-- the coherence error string for one conflicting pair (OverlappingImpls).  Reached
-- ONLY by the HARD class since F-3d — two mutually-⊑ (α-equal up to renaming) heads,
-- for which "make them disjoint" really is the fix, because no third impl can rank
-- them.  The ⊑-INCOMPARABLE class takes `cohIncomparableMsg` instead, whose remedy
-- is the opposite one (declare the common instance).  #614 filed the old wording as
-- an S2 precisely because it gave the disjointness advice to the incomparable class,
-- where it is both wrong and ineffective.
cohOverlapMsg : String -> List Mono -> List Mono -> String
cohOverlapMsg iface xs ys = match cohPpPair xs ys
  (s1, s2) => "Overlapping impls of \{iface}: \{s1} and \{s2} can match the same type. Make them disjoint, or wrap one type in a newtype"

-- ── F-3d (#614/#311): the declaration-time sweep is CLASSIFIED, not deleted ──
-- DICT-SEMANTICS §6.1 choice-point 2 commits to condition **(c)** — per-goal unique
-- ⊑-minimum — and licenses at most a WARNING at declaration time on (a)-violations
-- ("An implementation MAY additionally warn at declaration time on (a)-violations as
-- an early diagnostic, but acceptance is per-goal").  So the (a) sweep is demoted.
--
-- 🚨 BUT `cohAnonConflict`'s old `otherwise` arm WAS NOT (a).  It is STRICTLY
-- STRONGER, and the extra strength is exactly the class C1 requires rejecting — so
-- demoting the whole arm would have widened acceptance past the spec, silently.
-- §11's C1 row states the strength ("`cohAnonConflict` … falls through only on
-- `cohStrictlyMoreSpecific` … so mutually-subsuming heads reach its `otherwise` arm
-- and are rejected — closing, in the implementation, the ladder hole §6.1.2's ⚠️
-- records"), and §6.1.2 states why it matters: two **α-equal** heads are mutually ⊑,
-- hence **⊑-COMPARABLE**, hence they SATISFY (a) — while §6 C1 rejects them outright
-- ("so are α-equal duplicate heads (mutually ⊑, hence **two** ⊑-minimal elements,
-- not one)").  **(a) ⇏ (c).**  Demoting an (a)-violation is what the spec licenses;
-- demoting a C1 violation is not, and nothing downstream would catch it — F-3c's
-- goal-site reject cannot see this class either, because `entryCovers` is
-- `tyHeadEqV || tyStrictlyMoreSpecificV`, so two equal heads COVER EACH OTHER,
-- `findMostSpecificEntry` returns `Some`, and `reportAmbiguousOverlap` never runs
-- (that function's own ⚠️ says so: "Only ⊑-INCOMPARABLE OVERLAP lands here").
--
-- Hence the two classes, split on mutual subsumption:
--
--   HARD (`CohScan`'s first field, still `T-CONFLICTING-IMPL`) — the two heads are
--     mutually ⊑, i.e. α-equal up to renaming.  A §6 C1 violation at every goal that
--     matches them, and NO third impl can rank the pair.  Unchanged behaviour:
--     `test/typecheck_error_fixtures/{dup_impl,overlapping_impls}.mdk`,
--     `test/check_json_fixtures/conflicting_impl_duplicate.mdk`,
--     `test/dict_fixtures/s6-c1-duplicate-heads-rejected.mdk` and
--     `test/run_check_agreement_fixtures/p0_1_overlapping_impls.mdk` all still reject.
--     ⚠️ Strictly, (c) is per-GOAL, so a duplicate pair no goal ever poses is legal
--     under it; this site is goal-blind and keeps over-rejecting there exactly as it
--     did before F-3d.  That residue is deliberately UNCHANGED — F-3d is a widening
--     and this is the one place it declines to widen, because the widening would be
--     into a class nothing else rejects.
--
--   SOFT (`CohScan`'s second field, the new `W-INCOMPARABLE-IMPLS`) — the two heads
--     are ⊑-INCOMPARABLE.  A condition-(a) violation ALONE.  (c) may well accept the
--     program: the §6.1 separating case adds a third impl that is ⊑ both, and at the
--     goal that third impl is the unique minimum.  Acceptance now belongs to the
--     goal-site `min⊑` reject (F-3c / #1155), which is a HARD error at a closed goal.
--
-- ⚠️ THE SCAN NOW COLLECTS ONE OF EACH CLASS, not "the first conflict".  Returning a
-- single classified verdict would have made a soft pair found first HIDE a hard pair
-- found later — an error → nothing transition, i.e. the loud-to-silent regression
-- this whole stage is gated on not committing.  `cohScanDone` stops the sweep once
-- both slots are filled, so the clean-program cost (the only cost paid on a compile
-- that succeeds) is byte-for-byte the old full O(pairs) scan.
--
-- #414: each payload is the message PLUS the span to blame — the scan runs over a
-- `reverseL`-ed list, so the outer element `e1` is the LATER-declared impl of the
-- pair, which is also the head the message names FIRST.  Blaming it keeps caret and
-- wording consistent.  The two cross-module pushes deliberately drop the span (see
-- `globalCoherenceConflict`) — a span is only useful to a consumer that files the
-- diagnostic against the span's OWN file, which today only the single-file
-- `checkCoherence` path does.
data CohScan =
  | CohScan (Option (String, Option Loc)) (Option (String, Option Loc))

-- #1559 A-3.7: WHICH SWEEP IS RUNNING, threaded as a value instead of inferred from
-- the shape of the module ids.  `cohSoftInScope` used to answer "am I the per-module
-- sweep?" by testing `mid1 == "" && mid2 == ""`, which was only ever a PROXY: the
-- per-module input was built by `cohImplsOf`, which stamped `""` because it had no
-- module id to stamp.  The proxy is correct exactly while that holds and silently
-- wrong the moment the per-module sweep is fed rows that carry a real id — which is
-- what pointing it at `IE` does.  See `cohSoftInScope` for the failure it prevents.
data CohSweep = CohSweepOwn | CohSweepGlobal

cohScan : CohSweep -> List CohImpl -> CohScan
cohScan sweep impls = cohScanOuter sweep impls (CohScan None None)

cohScanOuter : CohSweep -> List CohImpl -> CohScan -> CohScan
cohScanOuter _ [] acc = acc
cohScanOuter sweep (e::rest) acc
  | cohScanDone acc = acc
  | otherwise = cohScanOuter sweep rest (cohScanInner sweep e rest acc)

-- both classes already witnessed ⇒ nothing later can change what is reported.
cohScanDone : CohScan -> Bool
cohScanDone (CohScan (Some _) (Some _)) = True
cohScanDone _ = False

-- #1559 A-3.7: DO TWO IMPL OCCURRENCES NAME THE SAME INTERFACE?
--
-- 🚨 `sameTyConHead`, NEVER `ifaceIdMatches`, AND THE TWO ARE EXACT INVERSES.  This
-- is the whole substance of the bite, so the derivation is here rather than in a
-- ledger:
--   * `sameTyConHead n1 o1 n2 o2 = n1 == n2 && not (tyConIdsConflict o1 o2)`
--     (`frontend/ast.mdk`) — name equality, and an ABSENT origin makes NO CLAIM, so
--     it matches anything.
--   * `ifaceIdMatches a b = a /= "" && a == b` (`frontend/ast.mdk`) — absence NEVER
--     matches, not even itself.
-- `recordCandIsType`'s header states which to use when, and the rule is about the
-- QUESTION being asked, not about the table: `sameTyConHead` belongs where a false
-- REJECT would refuse a valid program (an ACCEPTANCE question); `ifaceIdMatches`
-- belongs where a false HIT is silent wrongness (a LOOKUP).
--
-- Coherence is an ACCEPTANCE question — it decides whether to reject a program — so
-- `sameTyConHead` is correct, and it is also the FAIL-LOUD direction here: an impl
-- whose `implOrigin` is still `OriginUnresolved` compares by name exactly as it did
-- before this unit, so no live rejection can silently vanish.  `ifaceIdMatches` in
-- this position would turn every unstamped-origin conflict into a SILENT ACCEPT,
-- which is a severity INCREASE and one no fixture in the tree would catch.
--
-- ⚠️ NOT a re-keying of the HEAD half.  Coherence's head comparison already routes
-- through `sameTyConHead` (`cohGoR`'s `TCon` arm, A-2.10) and is untouched, so the
-- #1317 T1 rule and closed S0 #1277 are not in scope for this unit.
cohSameIface : IfaceRef -> IfaceRef -> Bool
cohSameIface a b = sameTyConHead a.irName a.irOrigin b.irName b.irOrigin

cohScanInner : CohSweep -> CohImpl -> List CohImpl -> CohScan -> CohScan
cohScanInner _ _ [] acc = acc
cohScanInner sweep (e1@(CohImpl if1 xs mid1 _)) ((CohImpl if2 ys mid2 _)::rest) acc
  | cohScanDone acc = acc
  | cohSameIface if1 if2 && cohOverlap xs ys =
    cohScanInner sweep e1 rest (cohClassify sweep e1 xs ys mid1 mid2 acc)
  | otherwise = cohScanInner sweep e1 rest acc

-- classify ONE overlapping pair.  A strict specialization either way is coherent
-- (most-specific-wins ranks it) and contributes nothing.  The remaining two cases
-- are exhaustive and disjoint: `cohStrictlyMoreSpecific a b = cohSubsumes b a && not
-- (cohSubsumes a b)`, so if neither direction is strict then `cohSubsumes` holds
-- BOTH ways (mutual ⇒ HARD) or NEITHER way (incomparable ⇒ SOFT).
-- Keep-first per class mirrors the old "first conflict wins" reporting.
--
-- ⚠️ WHY THE HARD ARM CANNOT SIMPLY MOVE TO THE GOAL SITE, stated because "then fix
-- it there" is the obvious review question and the answer is not "we didn't try".
-- The root is one level up from `entryCovers`: `entryCoversAllOthers` /
-- `findMostSpecificEntry` test for a ⊑-MINIMUM, where §6 C1 requires **at most one
-- ⊑-MINIMAL element**.  In a preorder that is not antisymmetric those two coincide
-- everywhere EXCEPT at α-equal heads — precisely this arm's class.  (`entryCovers`
-- itself is fine: with `S = tySubsumesV`, `tyHeadEqV a b || S b a` is exactly ⊑;
-- it does not conflate ⊒ with =.)  Tightening `entryCoversAllOthers` to demand
-- STRICT specificity was built and measured: it finds 6 true positives and then
-- breaks `stdlib/core.mdk`, which stops typechecking with "the goal `Num Int`
-- matches `impl Num Int` and `impl Num Int`" — checking core as a user program
-- registers the same instance twice, and deduping needs INSTANCE IDENTITY this tree
-- does not have (`bucketKeyEntriesFrom` restarts its numbering at 0 per module, so
-- two distinct impls in different modules share an index).  That is L2 / A-3 / B-2
-- work.  Until it exists, the declaration site is the only place this class is
-- caught at all.
--
-- 🚨 THE A-3 CARRY-FORWARD, DISCHARGED BY A-3.7 (#1559) — AND THE RESIDUE IT NAMES
-- SURVIVES, so this note is rewritten rather than deleted.
--
-- What it warned about: the HARD arm's reach is user-vs-user only, because
-- `checkCoherence`'s input was USER DECLS ONLY.  A user `impl Eq Int` shadowing the
-- PRELUDE's is α-equal to it and so is NOT rejected — `test/lint_fixtures/
-- derivable_needs_datadecl.mdk` checks clean at exit 0 (#1162's equal-head second
-- symptom, which F-3d neither fixes nor worsens).  Widening coherence's input to the
-- global `IE` would have made this arm reject every such program, including that
-- in-tree fixture: a mass NARROWING §5 R2 does not license.
--
-- How A-3.7 discharged it: coherence now DOES read `IE`, and `cohRowVisible` carves
-- the prelude out of both sweeps explicitly — `hasPrelude` on the Module arm drops
-- ordinal 0 (structurally the prelude, per `buildDeclEnvs`), and the Flat arm keeps
-- its prelude boundary in the decl list the driver stages (`coherenceUserDecls`),
-- which is why that field does NOT retire in this unit.  Both probes were measured
-- across the relocation: a user `impl Eq Int` α-equal to the prelude's checks at exit
-- 0 on the Flat path AND on the Module path, before and after.
--
-- ⚠️ THE RESIDUE IS DELIBERATELY PRESERVED, NOT FIXED.  With the carve-out in place a
-- user impl shadowing a prelude impl stays UNCHECKED rather than merely accepted.
-- Whether it SHOULD be rejected is a language question (#1162's equal-head second
-- symptom), not a substrate one, and A-3.7 relocated the input without re-adjudicating
-- it.  Do not "tidy" this by dropping the carve-out; that is the narrowing above.
cohClassify : CohSweep -> CohImpl -> List Mono -> List Mono -> String -> String -> CohScan -> CohScan
cohClassify sweep e1 xs ys mid1 mid2 (CohScan hard soft)
  | cohStrictlyMoreSpecific xs ys = CohScan hard soft
  | cohStrictlyMoreSpecific ys xs = CohScan hard soft
  | cohMutuallySubsumes xs ys = CohScan (cohKeepFirst hard (Some (cohHardMsg e1 xs ys mid1 mid2, cohImplLoc e1))) soft
  | not (cohSoftInScope sweep mid1 mid2) = CohScan hard soft
  | otherwise = CohScan hard (cohKeepFirst soft (Some (cohIncomparableMsg (cohImplIfaceName e1) xs ys mid1 mid2, cohImplLoc e1)))

-- Which sweep OWNS a soft (⊑-incomparable) pair.  Two sweeps run over overlapping
-- inputs: `checkCoherence` over ONE module's own impls and `globalCoherenceConflict`
-- over every user module's impls (real mids).  A pair
-- whose two impls live in the SAME module is seen by BOTH — the per-module one with a
-- real span, the global one span-less (#414) — so recording it in both makes
-- `run`/`build` print it TWICE where `check` prints it once.  The global sweep's
-- unique contribution is the pair that SPANS two modules, which no per-module sweep
-- can see; that is the only soft pair it should claim.
--
-- ⚠️ Scoped to the SOFT class deliberately.  The HARD class double-reports the same
-- way, and that is PRE-EXISTING — it did so as a `T-CONFLICTING-IMPL` error before
-- F-3d, on these same two paths — so narrowing it here would be an unrelated
-- behaviour change riding this one, and one that moves error goldens.
-- 🚨 #1559 A-3.7: SWEEP-SCOPED, NOT MID-SHAPE-SCOPED, AND THE DIFFERENCE IS A
-- LOUD→SILENT REGRESSION THIS FUNCTION USED TO BE ONE COMMIT AWAY FROM.
-- The body was:
--     cohSoftInScope "" ""   = True
--     cohSoftInScope m1 m2   = cohIsCrossModule m1 m2
-- i.e. it asked "are both mids empty?" as a stand-in for "am I the per-module
-- sweep?".  That proxy held only because the per-module sweep's input came from
-- `cohImplsOf`, which had no module id to stamp and so stamped `""`.  Pointing that
-- sweep at `IE` gives every row a REAL id (`instRefMid`), so an intra-module pair
-- arrives as `(m, m)` with `m /= ""` — the first arm stops matching, `cohIsCrossModule
-- m m` is `False`, and EVERY intra-module `W-INCOMPARABLE-IMPLS` silently stops being
-- reported.  Diagnostic-only, so no value golden in this tree could see it.
--
-- The sweep tag says outright what the mid shapes were being read to infer:
--   * `CohSweepOwn` — the per-module sweep.  Its input is ONE module's own rows, so
--     every pair it sees is intra-module BY CONSTRUCTION and it owns all of them.
--     Answering `True` unconditionally is exactly what the old `"" ""` arm did for
--     the only input that sweep ever had.
--   * `CohSweepGlobal` — the whole-graph sweep.  It owns only the pair that SPANS two
--     modules; the intra-module ones already belong to the sweep above.  The `"" ""`
--     arm is retained HERE (and only here) because it is behaviour-preserving for a
--     degenerate global input in which both ids are blank — a shape this function
--     answered `True` for before A-3.7, and one this bite deliberately does not
--     re-adjudicate.
cohSoftInScope : CohSweep -> String -> String -> Bool
cohSoftInScope CohSweepOwn _ _ = True
cohSoftInScope CohSweepGlobal "" "" = True
cohSoftInScope CohSweepGlobal mid1 mid2 = cohIsCrossModule mid1 mid2

-- each head matches the other, i.e. they are α-equal up to renaming (`cohSubsumes`
-- is one-sided matching, so mutual matching means each is an instance of the other).
cohMutuallySubsumes : List Mono -> List Mono -> Bool
cohMutuallySubsumes xs ys = cohSubsumes xs ys && cohSubsumes ys xs

cohKeepFirst : Option a -> Option a -> Option a
cohKeepFirst (Some x) _ = Some x
cohKeepFirst None y = y

-- HARD wording.  When the two impls come from DIFFERENT modules (mid1 /= mid2, both
-- non-empty), the message names BOTH owning modules (the cross-module global-
-- coherence case, D3/WS-2 — which is exactly the duplicate-instance class).
cohHardMsg : CohImpl -> List Mono -> List Mono -> String -> String -> String
cohHardMsg e1 xs ys mid1 mid2
  | cohIsCrossModule mid1 mid2 =
    cohCrossModuleMsg (cohImplIfaceName e1) mid1 mid2
  | otherwise = cohOverlapMsg (cohImplIfaceName e1) xs ys

cohIsCrossModule : String -> String -> Bool
cohIsCrossModule mid1 mid2 = mid1 /= "" && mid2 /= "" && mid1 /= mid2

-- SOFT wording (`W-INCOMPARABLE-IMPLS`).  Carries the "Warning: " prefix the
-- `matchWarnings` channel's text renderers expect and `stripWarnPrefix` removes for
-- the structured `--json` form.  ERROR-QUALITY: it states the rule that was violated
-- in the user's own vocabulary (these two heads, this interface), says the acceptance
-- consequence rather than asserting the program is wrong — because under (c) it may
-- not be — and puts the SPEC's remedy first.  The old error's advice ("make them
-- disjoint, or wrap one type in a newtype") is #614's S2: it is the wrong fix here
-- and, as that issue's own control shows, adding the ranking impl changed nothing.
cohIncomparableMsg : String -> List Mono -> List Mono -> String -> String -> String
cohIncomparableMsg iface xs ys mid1 mid2 = match cohPpPair xs ys
  (s1, s2) => "Warning: Overlapping impls of \{iface}\{cohWhereSuffix mid1 mid2}: \{s1} and \{s2} are not ordered by specificity — neither head is more specific than the other, so a goal matching both has no most-specific impl to pick"

cohWhereSuffix : String -> String -> String
cohWhereSuffix mid1 mid2
  | cohIsCrossModule mid1 mid2 = " (defined in \{mid2} and \{mid1})"
  | otherwise = ""

-- ERROR-QUALITY dim F: the actionable half, carried as structured `help` rather than
-- crammed into the message.  Both remedies are real and the FIRST one is the spec's
-- (§6.1's separating case): a third impl at the pair's common instance is ⊑ both, so
-- every goal matching both has a unique ⊑-minimum again.
-- ⚠️ The second clause is CONDITIONED on closedness, and that is not pedantry: the
-- first draft read "without one, a goal that matches both is rejected as ambiguous",
-- which is FALSE on exactly the shape this warning newly permits.  At a goal still
-- carrying an undetermined type the goal-site reject is gated off (§6.2 T3/T4) and
-- the selector COMMITS to the first-declared impl — `s6-2-t4-open-goal-deferred.mdk`
-- matches both and prints `1` at exit 0.  A reader told "is rejected" draws exactly
-- the wrong inference about the program in front of them.
cohIncomparableHelp : String
cohIncomparableHelp = "add an impl at the two heads' common instance so it is more specific than both, or make the two heads disjoint; without one, a goal matching both is rejected as ambiguous once its type is fully determined, and until then silently takes the first-declared impl (see issue 1183)"

-- cross-module conflict wording: names the interface and BOTH owning modules.
cohCrossModuleMsg : String -> String -> String -> String
cohCrossModuleMsg iface mid1 mid2 =
  "Conflicting `impl \{iface}`. Defined in \{mid2} and \{mid1}"

cohImplIface : CohImpl -> IfaceRef
cohImplIface (CohImpl i _ _ _) = i

-- #1559 A-3.7: the SPELLING, for the message renderers alone.  Every `coh*Msg`
-- below keeps its `String` parameter deliberately — the rendered wording is pinned
-- byte-for-byte by error goldens, and this unit moves no diagnostic text.  Reading
-- `.irName` through a named projection rather than at each call site keeps the
-- "identity decides, spelling only prints" split visible.
cohImplIfaceName : CohImpl -> String
cohImplIfaceName e = (cohImplIface e).irName

cohImplLoc : CohImpl -> Option Loc
cohImplLoc (CohImpl _ _ _ l) = l

-- push the SOFT (condition-(a)-only) coherence finding onto the typecheck WARNING
-- channel.  ⚠️ `matchWarnings`, NOT `recordTypeError` with severity 2 — see
-- `matchWarnings`' own note: `recordTypeError` arms `typeErrorsSticky` (aborts
-- build/run) and bumps `errorsDetected` (steers `erredDuring`-gated inference)
-- unconditionally, without reading severity, so a severity-2 push there keeps BOTH of
-- an error's side effects and still renders as severity 1.  A demotion has to change
-- channel, not just the number.
pushCoherenceWarning : Option Loc -> String -> Unit
pushCoherenceWarning loc msg =
  let warning = TcDiag "W-INCOMPARABLE-IMPLS" 2 (orElseLoc loc !currentLoc) msg (Some cohIncomparableHelp) None
  driverState.value.matchWarnings := warning::driverState.value.matchWarnings.value

-- run coherence over USER decls; push at most one HARD conflict into typeErrors and
-- at most one SOFT one onto the warning channel.  The impls are scanned in REVERSE
-- declaration order to mirror the oracle, whose env.impls is built by prepending each
-- entry (`entry :: !(env.impls)`) — so the conflict message names the later-declared
-- impl as the first head, byte-identical.
-- #1559 A-3.7: the input is `IE`'s rows for THIS module, not a decl list.
-- [cur] is the reading module's ordinal and [hasPrelude] says whether this env
-- contains the prelude at ordinal 0 — see `cohRowVisible`, whose header carries the
-- fail-direction for both arms.
--
-- POPULATION EQUALITY, derived rather than assumed (it is the one thing that could
-- silently change what gets checked).  The Module caller used to pass `prog`, the
-- module's own desugared decls as `foldModules` holds them.  `ieRowsOwnedBy ordHere`
-- returns the rows `implRowsOf` built from `demDecls` at that ordinal.  Those are the
-- same list VALUE: `checkModulesDiags` stamps once (`stampGraphTyOrigins`) and hands
-- the SAME `modules` to `checkModulesPreamble` → `buildDeclEnvs` and to `foldModules`,
-- and `foldModules` passes each `(mid, prog)` pair's `prog` to the worker verbatim —
-- no transform on either side.  Harvest equality holds too: `implDeclFact` and the
-- retired `cohImplsOfMid` match arm-for-arm (unwrap `DAttrib`, take `DImpl`, drop
-- everything else) and both are a `flatMap` in decl order.
checkCoherence : ImplEnv -> Int -> Bool -> Unit
checkCoherence env cur hasPrelude = match cohScan CohSweepOwn (reverseL (map cohImplOfRow (cohRowsOwnedBy cur hasPrelude env)))
  CohScan hard soft =>
    let _ = cohPushHard hard
    cohPushSoft soft

cohPushHard : Option (String, Option Loc) -> Unit
cohPushHard None = ()
cohPushHard (Some (msg, loc)) = pushTypeErrorAt "T-CONFLICTING-IMPL" loc msg

cohPushSoft : Option (String, Option Loc) -> Unit
cohPushSoft None = ()
cohPushSoft (Some (msg, loc)) = pushCoherenceWarning loc msg

-- ── D1 WS-1a: superinterface-existence gate ────────────────────────────────
-- Mirror of lib/typecheck.ml's `check_superinterface_obligations`.  An
-- `impl C T` whose interface declares `interface C a requires D a` is unsound
-- unless a matching `impl D T` also exists.  This post-pass iterates the USER
-- impls (so a user impl that overrides a prelude impl isn't double-flagged) and,
-- for each, looks up its interface's supers in the FULL decl universe
-- ([allDecls], prelude included — the SUPER impl it needs may be a prelude impl).
-- It fires ONLY when the impl head's type args are all CONCRETE/ground (mirrors
-- the oracle's `is_concrete` gate); a parametric head like `impl Monoid (Bag a)`
-- (free tyvar) is deferred exactly as the oracle defers it.  Error wording is
-- byte-identical to the oracle's MissingSuperImpl message.
-- [userDecls] = the impls to check.
--
-- #1557 A-3.5b: the two BARE-NAME lookups this check used to make over a decl list
-- are relocated onto stage K.  WAS: `ifaceSupersOf allDecls iface` (a first-match scan
-- keyed `name == target`) for the supers, and `superImplExists allDecls superName`
-- (whose impl test was the bare `iface == superName`) for existence.  NOW: the supers
-- come from `ceLookupAt` at the reading ordinal, keyed by the naming `DImpl`'s
-- `implOrigin` — the SAME mint `implCompletenessMsgsOfMap` (A-3.5a) and
-- `ifaceDfsCycleOneSuper` (A-3.5c) use — and existence is a query over `IE`'s rows,
-- comparing the row's own `IfaceRef` identity against the SUPER's `superOrigin`.
--
-- ⚖️ RUN-055 (SA-3), owner ruling, 2026-08-12: THE EXISTENCE QUERY IS GRAPH-GLOBAL.
-- It used to scan `IE`'s rows visible at the reading ORDINAL while A-3.6 had already
-- made instance CANDIDACY graph-global, and the two scopes were measured to
-- contradict each other inside one program: with `impl Sub W` in an earlier module
-- and `impl Sup W` in a later one, a `Sup W` goal RESOLVES beside this check
-- reporting that same impl missing.  Both channels now read `ieCandidacyVisibleAt`.
-- ⚠️ ONLY THE SCOPE MOVED.  The supers still come from `CE` at the reading ordinal
-- ([cur] → `ceLookupAt` in `superImplMsgsOf`), the head test is still `tyMatchesAst`
-- over `ImplRow`'s AST `Ty`s, and the interface test is still the IDENTITY leg.  The
-- widening therefore accepts exactly the programs whose super impl EXISTS in the
-- graph and matches by identity — never one that merely shares a spelling.
--
-- 🚨 THE ROW LIST IS BOUND HERE, ONCE, AND THAT IS A PERF REQUIREMENT.  It is
-- O(rows); `superImplExists` runs per (impl x super).  See its header.
--
-- ⚠️ The visible-row list replaces [allDecls] for EXISTENCE only.  `ifaceSupersOf`
-- itself is NOT deleted — it has four surviving callers outside this check
-- (constraint solving, `directSupers`, and the two census helpers), and re-keying or
-- removing it would silently move all four.
checkSuperImpls : List Decl -> ClassEnv -> ImplEnv -> Int -> Unit
checkSuperImpls userDecls ce ie cur =
  let rows = ieRowsVisibleAt cur ie
  foreachUnit
    (pushTypeError "T-MISSING-SUPER-IMPL")
    (flatMap (superImplMsgsOf ce cur rows) userDecls)

foreachUnit : (a -> Unit) -> List a -> Unit
foreachUnit _ [] = ()
foreachUnit f (x::xs) =
  let _ = f x
  foreachUnit f xs

-- ── P0-17: impl-completeness check ─────────────────────────────────────────
-- Beta finding P0-17 (qa-beta-2026-07-07): an `impl Iface Ty…` that defines only
-- SOME of the interface's methods used to `check` clean, then PANIC at runtime
-- (`E-PANIC: unbound identifier: <method>`) when a missing method is dispatched —
-- a run≠check hole.  For each impl, verify every REQUIRED interface method (one
-- declared WITHOUT a default body) is defined by the impl body; each missing one
-- is a located `T-INCOMPLETE-IMPL` error, so check/run/build all reject instead of
-- deferring to a runtime panic.
--
-- Runs POST-desugar (from the typecheck cores), which is the ONLY stage where both
-- sets are cleanly visible with defaults distinguishable:
--   • desugar's mergeIfaceDefaults has coalesced each interface method's split
--     signature-entry (`lt : …`, default None) and body-entry (`lt x y = …`,
--     default Some) into ONE `IfaceMethod` carrying the merged Option MethodDefault.
--     PRE-merge the sig-only `None` entry would make every defaulted method (Ord's
--     lt/gt/…) look REQUIRED → hundreds of false positives across core/stdlib.
--   • desugar's fillImplDefaults has synthesized same-module default clauses INTO
--     the impl — which only ADDS to the defined set, never removes a required one,
--     so it cannot mask a genuinely-missing required method.
-- The interface decl is resolved out of stage K's `CE` at the reading module's
-- ordinal (`ceRequiredAt`), so an IMPORTED interface resolves exactly as a local one
-- does; [iterDecls] (this module's own decls) are the impls to check.  Unknown
-- interface (not in scope) → skip (a distinct error is reported elsewhere),
-- mirroring superImplMsgsOf.
--
-- #1557 A-3.5a: there is now ONE checker for both driver modes.  There used to be
-- two — `checkImplCompleteness`, whose Flat arm looked the interface up by a BARE
-- first-match scan over the decl list, and `checkImplCompletenessMap` below.  The
-- Flat arm's deletion is the unit's only genuine RE-KEY (owner RULING on #1557 OWED
-- 1, 2026-08-12: re-key, accept the acceptance delta, no bare-spelling compatibility
-- leg on CE).  Its one observable consequence: on a flat program where a USER
-- interface shadows a prelude one by spelling, the bare scan walked
-- `coreProg ++ userProg` head-first and returned the PRELUDE's required set for a
-- user impl; under identity the impl's own `implOrigin` decides, which is the
-- correct answer.
pushIncompleteImpl : (Option Loc, String) -> Unit
pushIncompleteImpl (loc, msg) = pushTypeErrorOnceAt "T-INCOMPLETE-IMPL" loc msg

implMethodName : ImplMethod -> String
implMethodName (ImplMethod n _ _) = n

-- a loc to attribute the error to: the first present impl-method body's span (the
-- impl head carries no Loc of its own).  None for a wholly-empty impl body.
--
-- 🚨 [RUN-METHID-035, F6] Computed from the impl-method's OWN parsed AST body,
-- independent of whether that body was ever type-inferred.  `exprLoc` alone
-- only recognizes an OUTERMOST `ELoc`/`EDoOrigin` wrapper (by design — see its
-- own comment), and a body shaped `f x` (an application, e.g. `gandThen2 p =
-- gandThen2 p`) is NOT itself ELoc-wrapped at that outer node, so `exprLoc`
-- alone returns `None` for it.  Before this fix, `pushTypeErrorOnceAt`'s
-- `orElseLoc loc !currentLoc` fallback then anchored T-INCOMPLETE-IMPL at
-- whatever OTHER declaration the type-inference walk had most recently
-- entered — which was RIGHT, by ACCIDENT, only when a same-spelled-but-
-- unrelated sibling interface caused this method's body to be (wrongly)
-- type-inferred anyway, setting `currentLoc` as a side effect (#1647 removed
-- that accident; see RUN-METHID-035).  `appArgLoc` (Bite 3, above) peels one
-- application to the argument's own span, so `f x` resolves to `x`'s loc —
-- a location genuinely inside the impl block, sourced from the AST alone.
--
-- ⚠️ [RUN-METHID-161] THIS FIX IS CURRENTLY INERT, and that is expected: its
-- trigger is #1647 — the change that introduced the reachability guarded against
-- above — and #1647 was REVERTED in this same sprint at `f585bfbb`.  At the
-- resulting BASE the diagnostic still lands correctly, by the same accident this
-- comment already describes (the same-spelled sibling interface type-infers the
-- body and sets `currentLoc`), so nothing on the tree today can discriminate this
-- fix from its absence.  A discriminating test pin becomes CONSTRUCTIBLE — and is
-- OWED — the moment #1647 or anything in its class re-lands.  Do not delete this
-- as dead code on the strength of it being unexercised.
firstImplMethodLoc : List ImplMethod -> Option Loc
firstImplMethodLoc [] = None
firstImplMethodLoc ((ImplMethod _ _ body)::_) =
  orElseLoc (exprLoc body) (appArgLoc body)

-- the names of an interface's REQUIRED methods (those whose merged IfaceMethod
-- carries NO default body).  Since #1557 A-3.5a this is called ONCE PER INTERFACE at
-- `CeRow` construction (`classEnvRowsOf`) rather than once per impl-check, and it is
-- the same pure computation the retired `insertIfaceRequired` writer stored.
requiredMethodNames : List IfaceMethod -> List String
requiredMethodNames [] = []
requiredMethodNames ((IfaceMethod n _ None)::rest) =
  n :: requiredMethodNames rest
requiredMethodNames ((IfaceMethod _ _ (Some _))::rest) =
  requiredMethodNames rest

-- ⚠️ THE `Map` SUFFIX IS HISTORICAL and is kept deliberately: it named the
-- `Registry` this function used to take, which #1557 A-3.5a replaced with `CE`.  The
-- name is NOT renamed because it is cited from `compiler/frontend/resolve.mdk`, from
-- `compiler/TYPECHECK-TARGET-ARCHITECTURE.md` and from three comment blocks in this
-- file, and a rename would strand all of them — the stale-symbol failure this arc has
-- already paid for repeatedly.  Since A-3.5a there is no non-`Map` sibling; this is
-- the ONE impl-completeness checker, for both driver modes.
--
-- #154 PR1: the multi-module analogue of checkImplCompleteness — identical, but the
-- per-impl `ifaceRequiredMethods fullUniverse iface` O(N) scan is replaced by an O(log N)
-- lookup in the persistent iface→required-methods registry (universeIfaceRequiredRef).
-- The registry holds one entry per interface in the module universe (core + earlier
-- modules + this one), so a `None` here means the interface is genuinely out of scope
-- — exactly as the scan's `None` did.
--
-- 🚨 THE SENTENCE THAT USED TO END THIS PARAGRAPH WAS FALSE, AND IT IS WHY #1258
-- EXISTED.  It read: "Interface names are globally unique, so the map's
-- last-write-wins carries the same required-method list the scan's first-match
-- returned."  Interface names are NOT globally unique — nothing in resolve or the
-- loader enforces it across modules, only WITHIN one (`Duplicate interface: Eq`).
-- Two unrelated modules declaring `Same` shared one bare-name key, so whichever
-- registered LAST supplied the required-method list for BOTH, and an impl that
-- completely implemented its own `Same` was rejected as missing the OTHER one's
-- method.  Reproduced first-hand at #1258 before this unit changed anything:
-- `'impl Same ET' is missing method 'bar'`, exit 1, on a program whose only `Same`
-- in scope declares `foo` and nothing else.
--
-- Since #1111 A-2.4 the key is a `RegKey` carrying the interface's IDENTITY (see
-- `ifaceTabKey`): the WRITE side takes `DInterface.ifaceOrigin` and the READ side
-- takes the naming `DImpl`'s `implOrigin`, so the lookup answers with the required
-- methods of the interface the impl actually names.  `Registry` is still
-- last-write-wins and still O(log N) — what changed is only WHAT COUNTS AS THE SAME
-- KEY, which is the entire defect.
--
-- #1557 A-3.5a: the SOURCE of that lookup moves from the per-run
-- `universeIfaceRequiredRef` accumulator to stage K's whole-graph `CE`, read at the
-- reading module's ordinal through `ceRequiredAt`.  🚨 THE KEY DOES NOT MOVE — it is
-- `regKeyOfTab (ifaceTabKey o iface)` on both sides, and `CeRow`'s own key is minted
-- by `classEnvRowsOf` from the SAME `ifaceTabKey ifaceOrigin name`, so this arm
-- carries no re-keying acceptance delta.  What moves is the POPULATION's provenance:
-- an accumulator grown by `appendUniverseAccums prog0` earlier in this same body
-- (ordinals 0..cur inclusive) becomes the whole-graph table filtered by
-- `declEnvVisibleAt cur o`, which is `entryOrd <= cur` — the same prefix.
-- Required-ness is prePass-INVARIANT: `requiredMethodNames` reads only the
-- `Some`/`None` presence of `IfaceMethod`'s third position, and the prePass rewrite
-- touches only a `Some (…, e)` arm's body, so building `CE` from raw `demDecls` while
-- this body may hold prePass-rewritten decls cannot change the answer.
checkImplCompletenessMap : ClassEnv -> Int -> List Decl -> Unit
checkImplCompletenessMap ce cur iterDecls =
  foreachUnit
    pushIncompleteImpl
    (flatMap (implCompletenessMsgsOfMap ce cur) iterDecls)

-- OCCURRENCE MINT (#1110/#1111 A-2.4): `implOrigin` beside `iface` in the same
-- record pattern, so the identity and the name it qualifies cannot drift apart.
implCompletenessMsgsOfMap : ClassEnv -> Int -> Decl -> List (Option Loc, String)
implCompletenessMsgsOfMap ce cur (DAttrib _ d) =
  implCompletenessMsgsOfMap ce cur d
implCompletenessMsgsOfMap ce cur DImpl { iface, tys, methods, implOrigin = o, ... } =
  match ceRequiredAt (regKeyOfTab (ifaceTabKey o iface)) cur ce
    None => []   -- unknown interface (reported elsewhere) → skip
    Some required =>
      let defined = map implMethodName methods
      let loc = firstImplMethodLoc methods
      map
        (m => (loc, missingImplMethodMsg iface tys m))
        (filter (m => not (contains m defined)) required)
implCompletenessMsgsOfMap _ _ _ = []

-- 🪦 RETIRED 2026-08-12 (A-3.5a, #1557): `insertIfaceRequired`, the DECLARATION-MINT
-- writer of `universeIfaceRequiredRef` (see that cell's tombstone in `CrossRun`).  Its
-- job is done by `classEnvRowsOf`, which mints the SAME key from the SAME
-- `ifaceOrigin` and stores the SAME `requiredMethodNames methods` value on `CeRow`.
-- Its DAttrib-unwrapping is preserved too: `classEnvDeclFact` unwraps `DAttrib` on the
-- way into `CE`, so an attributed interface decl still contributes a row.
--
-- #154 PR2 (site #3): fold [prog]'s interface decls into the pair of accumulators that
-- feed methodIfaceParamsRef / registeredIfacesRef.  A PURE mirror of
-- registerMethodIfaceParamsAll (DAttrib-unwrap → per-method `omInsert mname (iface,
-- typarams, mty)` into the params map + `omInsert iface ()` into the registered-iface
-- set), updating the two passed maps in lockstep instead of the global refs, so the copy
-- in checkBodyImpl's Module arm lands the identical maps the per-module rebuild produced.
insertMethodIfaceParams : List Decl -> (OrdMap (IfaceRef, List String, Ty, List (String, List Kind)), OrdMap Unit) -> (OrdMap (IfaceRef, List String, Ty, List (String, List Kind)), OrdMap Unit)
insertMethodIfaceParams [] acc = acc
insertMethodIfaceParams ((DAttrib _ d)::rest) acc =
  insertMethodIfaceParams rest (insertMethodIfaceParams [d] acc)
-- #822: the graded scope is computed ONCE per declaration — the union over ALL of this
-- interface's methods — and threaded in, never re-derived per method.
insertMethodIfaceParams ((DInterface { name, typarams, methods, ifaceOrigin, ... })::rest) acc = insertMethodIfaceParams rest (insertIfaceMethodsAcc IfaceRef { irName = name, irOrigin = ifaceOrigin } typarams (declGradedScope typarams methods) methods acc)
insertMethodIfaceParams (_::rest) acc = insertMethodIfaceParams rest acc

insertIfaceMethodsAcc : IfaceRef -> List String -> List (String, List Kind) -> List IfaceMethod -> (OrdMap (IfaceRef, List String, Ty, List (String, List Kind)), OrdMap Unit) -> (OrdMap (IfaceRef, List String, Ty, List (String, List Kind)), OrdMap Unit)
insertIfaceMethodsAcc _ _ _ [] acc = acc
-- #822: the graded scope is stored ALONGSIDE (typarams, mty) rather than in a table of
-- its own, so the two are ONE resolution result and cannot be resolved differently —
-- see registerMethodIfaceParamsMethods for why that is the load-bearing invariant.
insertIfaceMethodsAcc iface typarams scope ((IfaceMethod mname mty _)::rest) (mp, ifs) = insertIfaceMethodsAcc iface typarams scope rest (omInsert mname (iface, typarams, mty, scope) mp, omInsert iface.irName () ifs)

-- ── #1111 Stage A-2 unit A-2.5 (#1092): the METHOD-namespace identity companion ──
-- The map above is keyed by the BARE method name and is last-write-wins, so when two
-- UNRELATED interfaces each declare a method called `mth` the whole loaded program has
-- ONE entry for `mth` and whichever interface was registered last owns it — decided by
-- module processing order, not by anything about the occurrence.  Every read site
-- (recordImplObligation, ifaceParamMonos, singleTyparamIfaceMethod, …) then takes the
-- INTERFACE out of that entry, so an occurrence that unambiguously names `IB.mth` can
-- have its impl obligation checked against `IA` — silently, in either direction (#1092).
--
-- This map is the collision-free half: one row per (declaring module, method name)
-- IDENTITY, so `IA.mth` and `IB.mth` both survive.  It does NOT replace the bare-name
-- map — that stays as the FLOOR, so no entry can be LOST by this unit (a dropped entry
-- would silently drop an impl obligation, which is the same S0 with the sign flipped).
-- `applyMethodScopeOverrides` overlays the floor per module, for colliding names only.
--
-- ⚠️ MODULE-PATH-ONLY, exactly as `IdentOrigin`'s doc-comment in `frontend/ast.mdk`
-- bounds the whole of Stage A-2: a flat/single-file declaration carries
-- `OriginUnresolved`, `mkIdent` refuses it, and no candidate is recorded.  The flat
-- writer (`registerMethodIfaceParamsMethods`) is deliberately untouched.
--
-- 🚨 The REASON for that carve-out, corrected.  It used to read "a flat program has exactly
-- one user module, so a name it declares cannot collide ACROSS modules, and its
-- own-declaration-wins answer is already the scoped one."  The second clause is FALSE and
-- was measured to be: in ONE file declaring two interfaces that share a method name there
-- is no single OWN declaration — both are own — so there is nothing for a ladder whose top
-- rung is "own declarations win" to select.  The flat answer is last-declared-wins.
-- MEASURED (identical on this build and on main, so nothing here regressed): one file with
-- `interface FA`/`interface FB` both declaring `mth`, `data Blob`, and `impl FA Blob` only —
-- with FA declared FIRST the program is REJECTED `No impl of FB for Blob`, and with the two
-- interface declarations SWAPPED (nothing else changed) it is ACCEPTED at exit 0 and prints
-- FA's body.  The obligation goes to the LAST-declared interface either way; an
-- interface-declaration reordering that changes no program meaning changes the verdict.
-- 🚨 THAT MEASUREMENT IS HISTORY AS OF 2026-08-15 — DO NOT RE-RUN THE RECIPE AND EXPECT IT.
-- The Q1 unit (`ifaceMethodCollisions`, compiler/frontend/resolve.mdk) now REJECTS a module
-- whose own declarations include two `interface`s sharing a METHOD name, so that exact file
-- is refused with `R-DUPLICATE-IFACE-METHOD` in BOTH orderings before typecheck ever sees
-- it.  The flip is no longer observable and the shape is no longer constructible in one
-- file.  It is kept, scoped, because it is the evidence for the corrected REASON below —
-- deleting it would leave that reasoning unsupported.
-- ⚠️ AND THE MECHANISM DOES NOT SIMPLY MOVE CROSS-MODULE — measured, not assumed, on one
-- posing: `fa.mdk`/`fb.mdk` each exporting an interface declaring `mth`, an entry doing
-- `import fa.{FA, mth}` + `import fb.{FB}` with `impl FA Blob` only, prints 11 at exit 0.
-- The obligation goes to FA, not to the other interface, because the entry binds exactly one
-- denotation of `mth`.  So do not restate the last-declared-wins claim on the cross-module
-- axis on the strength of this paragraph; that would need its own probe, and the one posing
-- measured contradicts it.  The intra-module claim was true when made and is now unreachable.
-- The carve-out itself still stands, on the FIRST clause plus a mechanism argument: this
-- unit's discriminator is the importing module's IMPORT SCOPE, and a single file has none
-- — every candidate is own, so no rung of `scopedMethodEntry` can separate them.  ⚠️ Nor
-- would #1115 (E-1)'s real module ids supply one: both declarations would carry the SAME
-- module id.  The flat path therefore has a live defect of this class whose fix needs a
-- WITHIN-module discriminator (or an ambiguity diagnostic at the occurrence) that neither
-- A-2.5 nor E-1 provides — it is owed a derivation, not covered.  Nearest tracked relative:
-- #1182 (same one-file two-interface collision, decided by impl-block order at dispatch).
--
-- A SEPARATE decl walk from `insertMethodIfaceParams` rather than a widened accumulator:
-- the pair-threading signature above is pinned by the selfproc LEG A scheme golden, and
-- the two walks are called from ONE place (`appendUniverseAccums`), which is what the
-- "lockstep" the pair comment asks for actually needs.
insertMethodIdents : List Decl -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String) -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String)
insertMethodIdents [] acc = acc
insertMethodIdents ((DAttrib _ d)::rest) acc =
  insertMethodIdents rest (insertMethodIdents [d] acc)
insertMethodIdents ((DInterface { name, typarams, methods, ifaceOrigin, ... })::rest) acc = insertMethodIdents rest (insertIfaceMethodIdents name typarams (declGradedScope typarams methods) ifaceOrigin methods acc)
insertMethodIdents (_::rest) acc = insertMethodIdents rest acc

insertIfaceMethodIdents : String -> List String -> List (String, List Kind) -> TyConOrigin -> List IfaceMethod -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String) -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String)
insertIfaceMethodIdents _ _ _ _ [] acc = acc
insertIfaceMethodIdents iface typarams scope origin ((IfaceMethod mname mty _)::rest) acc =
  let acc2 = match mkIdent NsMethod origin mname
    -- honest absence: no module id for this declaration, so it contributes NO identity
    -- rather than a constant one every unstamped declaration would collide on (§8 I6.3).
    None => acc
    Some ident => addMethodIdentCand mname ident (IfaceRef { irName = iface, irOrigin = origin }, typarams, mty, scope) acc
  insertIfaceMethodIdents iface typarams scope origin rest acc2

-- Upsert BY IDENTITY (an interface re-registered by a second pass replaces its own row
-- rather than appending a duplicate), so `listLen >= 2` means "two DISTINCT declarations
-- of this method name" and the collided list cannot fill with self-collisions.
addMethodIdentCand : String -> Ident -> (IfaceRef, List String, Ty, List (String, List Kind)) -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String) -> (OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))), List String)
addMethodIdentCand mname ident payload (cands, collided) =
  let prior = dropMethodIdentCand ident (fromOption [] (omLookup mname cands))
  let next = prior ++ [(ident, payload)]
  (
    omInsert mname next cands,
    if listLen next >= 2 && not (contains mname collided) then mname::collided else collided,
  )

dropMethodIdentCand : Ident -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))
dropMethodIdentCand _ [] = []
dropMethodIdentCand ident ((c@(i, _))::rest)
  | i == ident = dropMethodIdentCand ident rest
  | otherwise = c :: dropMethodIdentCand ident rest

-- ── #1092: THIS module's scoped view of the bare-name method table ──────────
-- Overlay [floor] (the universe's last-write-wins map) with the entry each COLLIDED
-- method name resolves to IN THIS MODULE'S SCOPE.  Iterates the collided list — not the
-- table — so a program with no method-name collision pays ONE `[]` match per module and
-- shares the floor map unchanged; a name with exactly one declaration cannot need an
-- override, because the floor already holds that one declaration's entry.
--
-- ⚠️ OVERLAY, never a rebuild.  Anything this cannot resolve keeps the floor's answer,
-- which is today's behaviour: the failure mode of a rebuild would be a MISSING entry,
-- i.e. an impl obligation silently not recorded — `exit 1 → exit 0`, a severity increase.
applyMethodScopeOverrides : List Decl -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind)) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind))
applyMethodScopeOverrides prog floor =
  overrideScopedMethods
    prog
    crossRun.value.universeMethodIdentsRef.value
    crossRun.value.universeMethodCollidedRef.value
    floor

-- ── #1386 / #1276: SUPPLY the ALIAS-QUALIFIED method spellings ──────────────────
-- `import m as A` … `A.mth` keeps its `A.mth` spelling on the diagnostic-producing
-- `check` path: only `elaborateModules` runs `renameAliasedMethods`, and the three
-- `check*` drivers do not, so every reader keyed by the OCCURRENCE name misses.
-- `recordImplObligation` is one of them, which is why an alias-qualified method call
-- has NO impl obligation recorded at all (#1386, S0 — `check` exits 0 on a program
-- with no matching impl anywhere).
--
-- The remedy is a SUPPLY, not a re-key and not a rewrite: add `A.<method>` → the entry
-- `m`'s OWN declaration identity gives, for every method `m` exports.  Additive against
-- the PRE-EXISTING bare-name floor (`applyMethodScopeOverrides`) — a bare method name
-- can never be spelled with a dot, so no name that already had an answer gets a
-- different one.
--
-- 🚨 NOT additive against THIS BLOCK'S OWN entries, and the sentence above used to claim
-- it was.  Two DIFFERENT modules aliased under the SAME name (`import ifa as A` beside
-- `import ifb as A`) that both export a method spelled `mth` mint the SAME key `A.mth`,
-- and the plain `omInsert` this block shipped with let the later `import` silently
-- overwrite the earlier one.  MEASURED: two interfaces `IA`/`IB` each declaring `mth`,
-- an entry with both aliases and `impl IA Blob` only — with `ifa as A` FIRST the program
-- is REJECTED `No impl of IB for Blob`, and with the two `import … as A` lines SWAPPED
-- (nothing else changed) it is ACCEPTED and prints 1.  Permuting two imports flipped the
-- accept/reject verdict, on `check`, `run` and `build` alike.
--
-- The fix is decided PER KEY, not per insertion: gather every (alias import × exported
-- method) candidate row first, group by the `A.<method>` key, and insert only where all
-- the rows under that key name ONE declaration IDENTITY.  Identity, not module id, is
-- the discriminator — a re-export hop reaches the same declaration through two module
-- ids and is NOT ambiguous.  A key that several distinct declarations claim gets
-- `T-AMBIGUOUS-ALIAS-METHOD` and NO entry at all, so the two orderings agree: both
-- reject, with the same message at the same span, and neither picks a winner.  Rejected
-- at the IMPORT rather than at the occurrence, for the reason `R-DUPLICATE-IFACE-METHOD`
-- (`frontend/resolve.mdk`) is: the ambiguity becomes unrepresentable rather than merely
-- unreported.  ⚠️ That is an acceptance NARROWING — a program carrying the colliding
-- alias pair but never spelling `A.mth` is rejected now too.
--
-- ⚠️ NOT a de-aliasing rewrite of the occurrence.  Rewriting `A.mth` to bare `mth` on
-- this path (the other candidate shape) ERASES the very distinction that makes the
-- occurrence decidable: `import fmod.{mth}` beside `import ifacea as A` then makes
-- `A.mth` and `mth` the same name, and the standalone shadow wins — #1386's Repro B,
-- measured to survive that shape unchanged.
aliasQualifiedMethodEntries : List Decl -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind)) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind))
aliasQualifiedMethodEntries prog tab =
  let grouped = aliasMethodKeyGroup (aliasMethodKeyCands prog) omEmpty
  aliasMethodKeyApply grouped (omKeys grouped) tab

-- one CANDIDATE row per (alias import × method the aliased module exports):
-- (the local `A.<method>` key, the bare method name, the aliased module id, that
-- method's own declaration identity, the `import … as A` span the row came from).
-- Gathering before inserting is what makes the answer independent of import order.
aliasMethodKeyCands : List Decl -> List (String, String, String, Ident, Loc)
aliasMethodKeyCands [] = []
aliasMethodKeyCands ((DAttrib _ d)::rest) = aliasMethodKeyCands [d]
  ++ aliasMethodKeyCands rest
aliasMethodKeyCands ((DUse _ path loc)::rest) = match path
  UseAlias _ a => aliasMethodKeysFor a (usePathModuleId path) loc
    ++ aliasMethodKeyCands rest
  _ => aliasMethodKeyCands rest
aliasMethodKeyCands (_::rest) = aliasMethodKeyCands rest

-- every method the aliased module EXPORTS, under the local `A.<method>` spelling and
-- carrying that method's own declaration identity, never a bare-name last-write-wins pick.
aliasMethodKeysFor : String -> String -> Loc -> List (String, String, String, Ident, Loc)
aliasMethodKeysFor a mid loc = match omLookup mid driverState.value.graphMethodExportsRef.value
  None => []
  Some rows => aliasMethodKeyRows a mid loc rows

aliasMethodKeyRows : String -> String -> Loc -> List (String, Ident) -> List (String, String, String, Ident, Loc)
aliasMethodKeyRows _ _ _ [] = []
aliasMethodKeyRows a mid loc ((mname, ident)::rest) =
  (qualifiedLocal a mname, mname, mid, ident, loc) ::
    aliasMethodKeyRows a mid loc rest

-- Group the candidate rows BY KEY.  An OrdMap rather than a per-key `filterList` over
-- the whole row list: aliases × exported methods is small but the pairwise shape is the
-- quadratic compiler/AGENTS.md keeps finding, and there is no reason to mint another.
aliasMethodKeyGroup : List (String, String, String, Ident, Loc) -> OrdMap (List (String, String, String, Ident, Loc)) -> OrdMap (List (String, String, String, Ident, Loc))
aliasMethodKeyGroup [] g = g
aliasMethodKeyGroup (r::rest) g =
  let k = aliasRowKey r
  aliasMethodKeyGroup rest (omInsert k (fromOption [] (omLookup k g) ++ [r]) g)

-- One decision per KEY.  Exactly one declaration identity behind it ⇒ supply the entry
-- (the #1386 / #1276 remedy, unchanged).  Two or more ⇒ no entry and a hard ambiguity
-- diagnostic; suppressing the entry is what keeps the follow-on `No impl of <the loser>`
-- message — which named an interface the occurrence never unambiguously picked — from
-- being reported instead of the real cause.
aliasMethodKeyApply : OrdMap (List (String, String, String, Ident, Loc)) -> List String -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind)) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind))
aliasMethodKeyApply _ [] tab = tab
aliasMethodKeyApply g (k::rest) tab =
  let hits = fromOption [] (omLookup k g)
  let tab2 = match aliasRowIdents hits []
    [] => tab
    [_] => aliasMethodKeyEntry k hits tab
    _ =>
      let _ = pushTypeErrorOnceAt "T-AMBIGUOUS-ALIAS-METHOD" (aliasRowLastLoc hits) (aliasAmbiguityMsg k hits)
      tab
  aliasMethodKeyApply g rest tab2

aliasMethodKeyEntry : String -> List (String, String, String, Ident, Loc) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind)) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind))
aliasMethodKeyEntry _ [] tab = tab
aliasMethodKeyEntry k ((_, mname, _, ident, _)::_) tab = match omLookup mname crossRun.value.universeMethodIdentsRef.value
  None => tab
  Some cs => match lookupMethodCand ident cs
    None => tab
    Some payload => omInsert k payload tab

aliasRowKey : (String, String, String, Ident, Loc) -> String
aliasRowKey (k, _, _, _, _) = k

aliasRowModule : (String, String, String, Ident, Loc) -> String
aliasRowModule (_, _, m, _, _) = m

-- The DISTINCT declaration identities behind one key.  ⚠️ IDENTITY, not module id: the
-- same declaration reached through a re-export hop arrives twice under two module ids
-- and must NOT read as ambiguous.
aliasRowIdents : List (String, String, String, Ident, Loc) -> List Ident -> List Ident
aliasRowIdents [] acc = acc
aliasRowIdents ((_, _, _, i, _)::rest) acc
  | anyList (== i) acc = aliasRowIdents rest acc
  | otherwise = aliasRowIdents rest (acc ++ [i])

-- The LAST colliding import's span — the one that used to silently overwrite.  Both
-- orderings of the same two imports land on the same line, so the diagnostic's span is
-- as order-independent as its verdict.
aliasRowLastLoc : List (String, String, String, Ident, Loc) -> Option Loc
aliasRowLastLoc [] = None
aliasRowLastLoc [(_, _, _, _, l)] = Some l
aliasRowLastLoc (_::rest) = aliasRowLastLoc rest

-- Phrased after `ppResError (DuplicateInterfaceMethod …)`: name the two things that
-- collide, say the occurrence cannot be attributed to either, then name both fixes.
-- The module list is `sortUniqS`-ordered so the message does not encode import order.
aliasAmbiguityMsg : String -> List (String, String, String, Ident, Loc) -> String
aliasAmbiguityMsg k hits =
  let mods = joinWith " and " (map (m => "'\{m}'") (sortUniqS (map aliasRowModule hits)))
  "'\{k}' is ambiguous: this alias names more than one module declaring a method '\{aliasRowMethodOf hits}' — \{mods}. An occurrence of '\{k}' could not be attributed to any of them. Give those imports different alias names, or import the method by name."

aliasRowMethodOf : List (String, String, String, Ident, Loc) -> String
aliasRowMethodOf [] = ""
aliasRowMethodOf ((_, m, _, _, _)::_) = m

overrideScopedMethods : List Decl -> OrdMap (List (Ident, (IfaceRef, List String, Ty, List (String, List Kind)))) -> List String -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind)) -> OrdMap (IfaceRef, List String, Ty, List (String, List Kind))
overrideScopedMethods _ _ [] floor = floor
overrideScopedMethods prog cands (n::rest) floor =
  let floor2 = match omLookup n cands
    None => floor
    Some cs => match scopedMethodEntry prog n cs
      None => floor
      Some payload => omInsert n payload floor
  overrideScopedMethods prog cands rest floor2

-- Which declaration of method [n] does THIS module mean?  Same precedence ladder
-- `tyOriginScope` (`frontend/resolve.mdk`) argues for the TYPE namespace, for the same
-- nearest-scope-wins reason: own declarations beat imports, imports beat the implicit
-- prelude.  `None` at any rung means "this module's scope does not decide it" and the
-- caller keeps the floor — never a guess.
scopedMethodEntry : List Decl -> String -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Option (IfaceRef, List String, Ty, List (String, List Kind))
scopedMethodEntry prog n cs = match ownMethodIdent prog n
  Some ident => match lookupMethodCand ident cs
    Some payload => Some payload
    None => importedMethodEntry prog n cs
  None => importedMethodEntry prog n cs

importedMethodEntry : List Decl -> String -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Option (IfaceRef, List String, Ty, List (String, List Kind))
importedMethodEntry prog n cs = match filterList (c => methodCandImported prog n c) cs
  -- exactly one of this name's declarations is reachable through an import of THIS
  -- module: that is what the occurrence names.  A DIRECT double import of the same
  -- name is an ambiguous occurrence resolve already rejects (`Ambiguous occurrence:
  -- 'mth' is exported by both …`), so falling back to the floor costs nothing an
  -- accepted program can observe THROUGH THAT PATH.
  --
  -- ⚠️ NOT EVERY TWO-CANDIDATE CASE IS CAUGHT UPSTREAM — MEASURED, both arms: a
  -- RE-EXPORT MERGE of the same collision (two modules each declaring an interface
  -- with method `n`, both re-exported into a third module via two `export import`
  -- lines) also lands here with two candidates, but resolve emits NOTHING for it —
  -- `check` silently accepts or rejects depending only on which `export import` line
  -- is declared first, with no diagnostic either way. This function still falls
  -- through to `preludeMethodEntry`/`None` and the caller keeps the FLOOR's
  -- arbitrary last-registered answer for that shape, exactly as it does for a
  -- genuinely 0-candidate case — the fallback is not wrong, but the comment above
  -- must not be read as "every 2+ candidate case is already an upstream reject".
  -- Adjacent to the open #1288 re-export-merge family; not owned here.
  --
  -- ── F23 (#1351 L2 repair): the admission test is a LADDER, not one widened test ──
  -- 🚨 L2 widened the member filter IN PLACE so that a path naming only the INTERFACE
  -- (`import zmodI.{IZ, zf}`, no `mth`) also witnesses that interface's candidate.
  -- That is right for #1351, where NO path binds the method name at all — but in
  -- every `import msifa.{MSIA, mth}` + `import msifb.{MSIB}` shape it promoted the
  -- second import from "brings in the TYPE only" to "witnesses a candidate", turning
  -- a 1-candidate override into a 2-candidate decline to the bare-name FLOOR.  That
  -- floor is last-write-wins over module order, so nine method_scope fixtures moved:
  -- four to a SILENT ACCEPT of an invalid program (the floor's interface happened to
  -- have an impl) and five to a reject naming the WRONG interface.  MEASURED, both
  -- shapes, nine for nine (F23 isolation: reverting this one filter and KEEPING
  -- `pickSchemesByDecl` restores all nine; keeping the filter and reverting
  -- `pickSchemesByDecl` restores none).
  --
  -- Both readings are wanted, in PRECEDENCE order — the same nearest-scope-wins
  -- ladder `scopedMethodEntry` above already runs, with one rung more:
  --
  --   rung 1  a path that binds the METHOD name and witnesses this declaration.
  --           When any candidate clears this rung, the method-name imports ARE the
  --           module's statement about which declaration it means, and a bare
  --           interface-name import must not dilute it.
  --   rung 2  only if rung 1 admits NOTHING: a path that names the candidate's
  --           INTERFACE and witnesses this declaration.  This is the 0-candidate
  --           fall-through L2 was fixing, and it is reached only where the narrow
  --           rung had already declined to the floor.
  --
  -- ── WHAT GROUNDS THE PRECEDENCE (RUN-METHID-116; supersedes the `S2-DECL (c)`
  -- grounding this comment used to assert) ────────────────────────────────────────
  -- ⚠️ S2-DECL DOES NOT GOVERN THIS CORPUS.  The method_scope fixtures have NO
  -- standalone of the colliding name (`mth` exists only as two interface methods), so
  -- S1's shadow-hood conjunct — `N ∈ funDef-names(standalones …)`,
  -- `docs/spec/SHADOW-SEMANTICS.md:249-253` — is vacuously FALSE and S2-DECL never
  -- fires, exactly as that document's ruled #1182/#1620/#1265 rows say.  Do not read
  -- this ladder as implementing S2-DECL (c).
  -- What it DOES instantiate is clause (d)'s RATIONALE, borrowed as a principle and
  -- not cited as a governing clause: a pick is legitimate exactly when the source
  -- carries a discriminator ((d) mandates its reject because there is *"no
  -- discriminator written in the source"*).  `import msa.{MA, mth}` names the method
  -- and `import msb.{MB}` does not — a distinction the author wrote down — so rung 1
  -- is not a tie-break supplied from outside the program.
  -- 🚨 KNOWN GAP (RUN-METHID-116): a WILDCARD import carries no discriminator yet
  -- reaches rung 1 — `usePathBindsName` answers True for every name under `UseWild` —
  -- so `import msb.*` witnesses `mth` at rung 1, rung 1 admits 2, and the ladder
  -- declines to the arbitrary bare-name floor.  Unfixed here.
  --
  -- So this can only turn "0 → floor" into "1 → the admitted declaration"; a shape
  -- the narrow rung decides is decided identically to before the widening, and a
  -- rung-1 tie (≥2) still declines to the floor rather than inventing a third
  -- answer.  `depExportsMethodIdent` is untouched at both rungs, so the #1275/#1272
  -- BYSTANDER stays refused by IDENTITY, never by spelling.  No second resolver:
  -- this is `importedMethodEntry`'s own filter, run twice at two admissions.
  [only] => Some (snd only)
  [] => match filterList (c => methodCandAdmitted prog n c) cs
    [only] => Some (snd only)
    _ => preludeMethodEntry n cs
  _ => preludeMethodEntry n cs

-- The implicit prelude is in scope in every module without a `DUse`, so it is the last
-- rung rather than a missing one: a USER interface that reuses a prelude method name
-- wins the floor (it registers later) in modules that never import it.
preludeMethodEntry : String -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Option (IfaceRef, List String, Ty, List (String, List Kind))
preludeMethodEntry n cs = match mkIdent NsMethod (OriginModule "core") n
  None => None
  Some ident => lookupMethodCand ident cs

-- This module's own interface declaring [n], as an identity.
ownMethodIdent : List Decl -> String -> Option Ident
ownMethodIdent [] _ = None
ownMethodIdent ((DAttrib _ d)::rest) n = match ownMethodIdent [d] n
  Some i => Some i
  None => ownMethodIdent rest n
ownMethodIdent ((DInterface { methods, ifaceOrigin, ... })::rest) n =
  if contains n (ifaceMethodNames methods) then
    mkIdent NsMethod ifaceOrigin n
  else
    ownMethodIdent rest n
ownMethodIdent (_::rest) n = ownMethodIdent rest n

-- Is candidate [c] the declaration of [n] that one of THIS module's imports brings in?
-- RUNG 1 of `importedMethodEntry`'s ladder: the METHOD name must come through the
-- path.  [wide] = False, so a path that names only the candidate's interface does
-- NOT witness it here.
methodCandImported : List Decl -> String -> (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Bool
methodCandImported prog n c = anyUsePathBinds prog False n c

-- RUNG 2 (F23): the same question with the INTERFACE-nameability reading also
-- admitted.  Reached only when rung 1 admitted nothing — see `importedMethodEntry`,
-- where the precedence between the two rungs is argued and grounded (RUN-METHID-116;
-- NOT in S2-DECL (c), which does not govern a corpus with no standalone).
methodCandAdmitted : List Decl -> String -> (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Bool
methodCandAdmitted prog n c = anyUsePathBinds prog True n c

anyUsePathBinds : List Decl -> Bool -> String -> (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Bool
anyUsePathBinds [] _ _ _ = False
anyUsePathBinds ((DAttrib _ d)::rest) wide n c = anyUsePathBinds [d] wide n c
  || anyUsePathBinds rest wide n c
anyUsePathBinds ((DUse _ path _)::rest) wide n c = usePathWitnesses path wide n c
  || anyUsePathBinds rest wide n c
anyUsePathBinds (_::rest) wide n c = anyUsePathBinds rest wide n c

-- ── #1111 A-2.5b (#1272 / #1275): the witness reads IDENTITY, not spelling ──
-- An import witnesses a candidate when TWO things hold:
--   * the path lets the name through — `usePathBindsName`, the member filter;
--   * the dependency's row CARRIES *that declaration* of the name — asked of
--     `graphMethodExportsRef`, the graph's (module id → name → declaring `Ident`)
--     index, so a re-export chain resolves transitively and by identity.
--     ⚠️ "carries", not "exports": the row has no `pub` filter (F3, `declMethodIdentsOf`).
--
-- 🚨 A-2.5 shipped the second conjunct as a bare-INTERFACE-NAME comparison
-- (`usePathNamesMember path iface`, now deleted), which reinstated the very premise
-- A-2.4 retired: interface names are NOT globally unique.  Two S0s came out of that one
-- string compare, both of them the second conjunct answered by spelling rather than by
-- the export graph:
--   #1275 — an unrelated BYSTANDER module declaring a same-named interface with the same
--           method name was witnessed by an import that names neither it nor anything of
--           it, so the guard saw two matches and the override declined to the floor;
--   #1272 — a WILDCARD import of a re-exporter (`import mid.*`) named no member, so the
--           old witness could not fire at all.  It could not simply be relaxed either:
--           letting a wildcard satisfy a NAME test makes it "name" every interface and
--           witness every candidate.  Under an EXPORT test that dilemma disappears —
--           a wildcard admits every name, and the index still admits only the
--           declarations `mid` really re-exports;
-- L2 (`compiler/TYPECHECK-TARGET-ARCHITECTURE.md`): identity is resolved, never
-- re-derived from spelling.  The candidate's `iface` string is no longer read here.
--
-- The old module-id witness (`mkIdent NsMethod (OriginModule dep) n == Some ident`) is
-- GONE rather than kept as a disjunct: it is exactly the case where `dep` declares the
-- method itself, and `graphMethodExports` seeds every module with its OWN declarations,
-- so the export test subsumes it.  Keeping both would be the parallel-near-copy shape
-- this workstream exists to remove.
--
-- 🚨 #1276 (the ALIAS spelling, `import m as A` … `A.mth`) is NOT fixed here, and its own
-- remedy sketch (1) — "give usePathWitnesses a UseAlias arm" — is REFUTED.  The primary
-- evidence is DIRECT, not inferential: that arm was written, built and probed on this
-- branch, and left #1276's repro printing `2` at exit 0, unchanged.  That measurement
-- alone covers every surface, and it is what the refutation rests on.
--
-- A SECOND, WEAKER observation bounds the `check` path specifically, and is scoped here
-- because it does not generalise: `renameAliasedMethods` has exactly one caller,
-- `elaborateModules` (`grep -n renameAliasedMethods compiler/types/typecheck.mdk`), so
-- the three `check*` drivers never perform the alias rewrite and `A.mth` never becomes a
-- bare-`mth` occurrence for this table on THAT path.  ⚠️ It says nothing about the
-- run/elaborate path, which DOES rename and DOES emit type errors — F1 was precisely a
-- case where `check` was clean and `run` reported one, so "check is silent" must never
-- again be read as "no surface reports anything".  CONTROL for the check half, on a
-- binary built from this branch: `import ifacea as A`, `data Blob`, NO impl anywhere —
-- `medaka check` exits 0 with no diagnostic while `medaka run` panics `unbound
-- identifier: mth`.  #1276's fix is a driver / AST-carrier change; the alias arm was
-- removed rather than shipped inert.
--
-- `core` is the implicit prelude, never an explicit provenance (importDefinersOf skips it
-- for the same reason); `preludeMethodEntry` is its rung.
--
-- CONVERGENCE UNDER #1280 (identity SUPPLY), stated because the direction is not
-- obvious: a declaration with no module id mints no `Ident` and so contributes NO row
-- (`ifaceMethodIdentPair`).  Every such gap today makes `depExportsMethodIdent` answer
-- False, i.e. the index is an UNDER-approximation and the overlay declines more often
-- than it should.  When #1280 makes supply total, rows appear that are missing now, so
-- the overlay STRENGTHENS — strictly more candidates witnessed, never fewer.  A shape
-- that silently keeps the floor today can therefore start being decided correctly then;
-- the change is monotone in the right direction, but it IS a behaviour change and this
-- unit's fixtures do not cover it.
usePathWitnesses : UsePath -> Bool -> String -> (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Bool
usePathWitnesses path wide n (ident, (iface, _, _, _)) =
  let dep = usePathModuleId path
  dep /= "core"
    && usePathAdmitsDecl path wide n iface
    && depExportsMethodIdent dep n ident

-- ── #1351 L2 (MIGRATE Leg 2b): the MEMBER filter admits an INTERFACE spelling ──
-- SHADOW-SEMANTICS S2-DECL clause (c) admits a declaration `I` in module `M` iff `I`
-- is NAMEABLE in `M` (S1-NS(a)) — an INTERFACE-name question.  The member filter used
-- to ask only `usePathBindsName path n`, the METHOD name, and those are different
-- tests: `import zmodI.{IZ, zf}` makes `IZ` nameable while binding no `mth`, so
-- `IZ`'s candidate went UNWITNESSED, `importedMethodEntry` saw zero candidates, and
-- the overlay declined to the bare-name last-write-wins FLOOR — whose winner is
-- module-processing order.  That fall-through IS #1351's order-dependence at Leg 2b,
-- MEASURED six-for-six (RUN-METHID-058).
--
-- 🚨 THIS IS NOT A-2.5's DELETED `usePathNamesMember`, AND THE DIFFERENCE IS THE WHOLE
-- SAFETY ARGUMENT.  A-2.5 put a bare interface-NAME compare in the SECOND conjunct,
-- i.e. it decided WHICH DECLARATION by spelling, and interface names are not globally
-- unique — that is what shipped #1275 and #1272.  Here the spelling only widens the
-- FIRST conjunct, the member filter, which is inherently a spelling question (an
-- import member list IS a list of spellings).  The identity conjunct
-- `depExportsMethodIdent dep n ident` is UNCHANGED and still pins which declaration is
-- witnessed, so #1275's BYSTANDER (a same-named interface in another module) is still
-- refused: its spelling passes the member filter, its `Ident` does not appear in
-- `dep`'s export row, and the witness is False.  No second resolver is introduced —
-- this is `applyMethodScopeOverrides`' own admission test, widened in place.
--
-- Failure direction: strictly MORE candidates can now be witnessed.  On 0 or ≥2 the
-- overlay still declines to the floor (today's answer); it overrides only on exactly
-- one.  So this can turn "0 → floor" into "1 → the admitted declaration", which is
-- the intended fix, and "1 → override" into "2 → floor", a fall-back to today's
-- behaviour, never a new third answer.
--
-- 🚨 F23 REPAIR: that last sentence was the defect.  "1 → override" becoming
-- "2 → floor" is NOT a harmless fall-back to today's behaviour when the ONE was the
-- correct answer and the floor is bare-name last-write-wins — MEASURED, it turned
-- nine method_scope fixtures into four silent accepts and five wrong-interface
-- rejects.  So [wide] is no longer always True: it is False at
-- `importedMethodEntry`'s rung 1 (method-name imports decide when they say anything)
-- and True only at rung 2, where rung 1 admitted nothing.  See the ladder argument at
-- `importedMethodEntry`.
usePathAdmitsDecl : UsePath -> Bool -> String -> IfaceRef -> Bool
usePathAdmitsDecl path wide n iface = usePathBindsName path n
  || wide && usePathBindsName path iface.irName

-- `None` from importedBindings is the WILDCARD form (`import m.*`), which binds every
-- name the dependency exports — and, unlike A-2.5's deleted `usePathNamesMember`, that
-- is now safe: the export test above still admits only the declarations the dependency
-- really provides.  `UseAlias` yields `Some []` and so witnesses nothing — see the #1276
-- paragraph above for why that is a different defect rather than this one's residue.
usePathBindsName : UsePath -> String -> Bool
usePathBindsName path n = match importedBindings path
  None => True
  Some bs => contains n (map snd bs)

-- Does [dep]'s row carry a method spelled [n] whose DECLARATION is [ident]?
--
-- ⚠️ "Row carries", NOT "dep exports" — the row has no `pub` filter, so it also holds a
-- PRIVATE interface's methods.  See `declMethodIdentsOf`, which owns that gap (F3).
--
-- 🚨 THE FAILURE DIRECTION IS DELIBERATE, BUT THE ARGUMENT THIS COMMENT USED TO GIVE FOR
-- IT WAS FALSE TWICE, AND BOTH HALVES POINTED AWAY FROM THE F1 BUG THAT WAS REALLY HERE.
-- It read: *"A miss answers False, which makes the candidate unwitnessed, which makes the
-- overlay decline and keep the floor — the pre-A-2.5 answer, never a new one."*
--   1. **The floor is not "the pre-A-2.5 answer".**  It is the pre-#1092 bare-name
--      last-write-wins map.  A-2.5's overlay already BEAT that floor for every shape it
--      fixed, so falling back to it is a REGRESSION for exactly the population A-2.5
--      exists to serve — not a safe no-op.  A wholesale miss is therefore a bug of the
--      first order, which is precisely what F1 turned out to be, and this sentence is
--      what made it read as harmless.
--   2. **A miss does not always decline.**  The overlay declines on 0 or ≥2 matches and
--      OVERRIDES on exactly 1.  Dropping one of two witnesses turns "2 → floor" into
--      "1 → override": the miss CAUSES a new answer rather than falling back to the old
--      one.  "Never a new one" was simply wrong.
-- What is actually true, and all that is claimed now: a *per-`dep`* miss is the honest
-- answer to "this dependency's row does not carry that declaration", and the overlay
-- stays an overlay rather than a rebuild (`applyMethodScopeOverrides`).  A *wholesale*
-- miss — the index absent — is a programming error, and the property that forbids it is
-- stated on `graphMethodExports` (the CONJUNCTION: overwritten at every driver entry AND
-- no reset point in between).
depExportsMethodIdent : String -> String -> Ident -> Bool
depExportsMethodIdent dep n ident = match omLookup dep driverState.value.graphMethodExportsRef.value
  None => False
  Some es => exportsIdentFor n ident es

-- Monomorphic and short-circuiting on purpose (`compiler/AGENTS.md`): this runs only for
-- a COLLIDED method name, but when it runs it walks one module's exported-method list.
exportsIdentFor : String -> Ident -> List (String, Ident) -> Bool
exportsIdentFor _ _ [] = False
exportsIdentFor n ident ((en, ei)::rest)
  | en == n && ei == ident = True
  | otherwise = exportsIdentFor n ident rest

lookupMethodCand : Ident -> List (Ident, (IfaceRef, List String, Ty, List (String, List Kind))) -> Option (IfaceRef, List String, Ty, List (String, List Kind))
lookupMethodCand _ [] = None
lookupMethodCand ident ((i, p)::rest)
  | i == ident = Some p
  | otherwise = lookupMethodCand ident rest

-- ── #1111 Stage A-2 unit A-2.11 (#1319 unit 1): the CONSTRUCTOR-namespace peer ──
--
-- Everything from here to `graphCtorExports` is the constructor twin of the METHOD
-- machinery immediately above (`insertMethodIdents` … `exportsIdentFor`).  It is a
-- deliberate near-copy and it is NAMED SCAFFOLDING, not an oversight:
--
--   * the METHOD index is already, by its own admission, a THIRD implementation of a
--     fact `resolve.mdk` derives, with **#1288** named as the absorbing stage that
--     deletes it.  This makes a FOURTH.  #1288's scope names the constructor peer, so
--     the deleter is real rather than asserted;
--   * B2 (resolve owns the fact and typecheck consumes it) is the target-conformant
--     answer under L2's identity-at-resolve law, and was REJECTED FOR NOW for a stated
--     reason: resolve's only delivery channel to typecheck is the AST, so B2 implies a
--     decl-adjacent carrier whose cost across printer / sexp / fmt / lower / mangle was
--     never costed.  See #1319's adjudication comment.
--
-- ⚠️ MIRROR DISCIPLINE IS LIVE between the two families until #1288 lands: a fix to the
-- scope ladder, the witness, or the export index on ONE side is silently absent from the
-- other.  They are adjacent in this file on purpose.
--
-- ── WHAT THIS FIXES, AND WHAT IT DELIBERATELY DOES NOT ──────────────────────
-- `universeDataEnv`'s ctor map is keyed by the BARE constructor name and is
-- last-write-wins, so when two unrelated modules each declare a `Dup` the whole loaded
-- program has ONE entry for `Dup` and load order picks the winner.  #1111 A-2.6 attacked
-- that with an import-scoped DECL overlay (`importedCtorTypeDecls`), and the boundary
-- moved one hop out twice: a member reached through a RE-EXPORT is not identity-matched
-- (#1283), and a ride-along SIBLING constructor of an overlaid decl out-ranks a ctor the
-- unit imports BY NAME from an earlier clause (#1284).
--
-- This unit keeps the overlay (unit 4 retires it) and adds the A-2.5-shaped answer on
-- top: an identity-keyed COMPANION of the bare map, plus a per-module SCOPE DECISION for
-- the colliding names only.  The overlay's unit is the DECL; a scope decision's unit is
-- the NAME, which is why a ride-along sibling cannot win here.
--
-- 🚨 IT MUST NOT RE-DECIDE AMBIGUITY.  Constructor-name ambiguity is provenance-based
-- (`ctorAmbiguousSet` → `keepAmbiguous` in `frontend/resolve.mdk`: ≥2 distinct DIRECTLY
-- IMPORTED modules), and that rule is deliberately ONE rule across the value / type /
-- interface / ctor namespaces — resolve's own note says a change there must change all
-- four at once.  This is a different question on the same data: "which declaration does
-- this module mean" is asked only where resolve has already ACCEPTED the program.  Two
-- witnesses decline to the floor here rather than picking one, so a genuinely ambiguous
-- import is still resolve's to reject and nothing here can quietly accept it.
--
-- ⚠️ MODULE-PATH-ONLY, exactly as A-2.5: a flat/single-file declaration carries
-- `OriginUnresolved`, `mkIdent` refuses it, no candidate is recorded, and the override
-- site is on the `Module` arm alone.
--
-- ⚠️ NO PRELUDE RUNG, unlike `preludeMethodEntry` — and that asymmetry is measured, not
-- assumed.  A module that declares OR imports a constructor spelled like a prelude
-- constructor is rejected outright (`Duplicate constructor: Lt`), so `core` can never be
-- one of two candidates for one ctor name and there is no rung for it to be.

-- Grow the identity-keyed companion by THIS module's PUBLIC data decls.
--
-- 🚨 THE SCHEME IS READ BACK OUT OF [env] RATHER THAN RE-DERIVED, and that is the whole
-- reason this lives in `appendDataUniverse` instead of anywhere else.  [env] is the
-- universe env immediately after `registerAllData … pubDecls`, so the companion holds
-- THE VERY SCHEME OBJECT the bare-name map holds — the two cannot come to hold different
-- types for one declaration, and no extra `registerVariants` call is made (which would
-- mint fresh tyvars, re-run `recordParamKinds`, and re-write `recordByNameRef`, i.e.
-- reach into unit 2's table from unit 1).
--
-- Within ONE module a constructor name is unique (a duplicate is rejected upstream), so
-- `lookupCtor env cn` after that registration is unambiguously THIS module's `cn`.
insertCtorIdents : TcEnv -> List Decl -> (OrdMap (List (Ident, String, Scheme)), List String) -> (OrdMap (List (Ident, String, Scheme)), List String)
insertCtorIdents _ [] acc = acc
insertCtorIdents env ((DAttrib _ d)::rest) acc =
  insertCtorIdents env rest (insertCtorIdents env [d] acc)
insertCtorIdents env ((DData { dataName, dataCtors, dataOrigin, ... })::rest) acc = insertCtorIdents env rest (insertVariantIdents env dataName dataOrigin dataCtors acc)
insertCtorIdents env ((DNewtype { newtypeName, newtypeCtor, newtypeOrigin, ... })::rest) acc = insertCtorIdents env rest (addCtorIdentCand env newtypeName newtypeOrigin newtypeCtor acc)
insertCtorIdents env (_::rest) acc = insertCtorIdents env rest acc

insertVariantIdents : TcEnv -> String -> TyConOrigin -> List Variant -> (OrdMap (List (Ident, String, Scheme)), List String) -> (OrdMap (List (Ident, String, Scheme)), List String)
insertVariantIdents _ _ _ [] acc = acc
insertVariantIdents env tyName o ((Variant cn _)::rest) acc =
  insertVariantIdents env tyName o rest (addCtorIdentCand env tyName o cn acc)

-- Upsert BY IDENTITY (a decl re-registered by a second pass replaces its own row rather
-- than appending a duplicate), so `listLen >= 2` means "two DISTINCT declarations of this
-- constructor name" and the collided list cannot fill with self-collisions.
--
-- Honest absence twice over (§8 I6.3): no module id ⇒ no identity ⇒ NO candidate, rather
-- than a constant every unstamped declaration would collide on; and no scheme in [env]
-- (an abstract/opaque decl whose ctors were never registered) ⇒ no candidate either,
-- because a candidate with no scheme could not be selected anyway.
addCtorIdentCand : TcEnv -> String -> TyConOrigin -> String -> (OrdMap (List (Ident, String, Scheme)), List String) -> (OrdMap (List (Ident, String, Scheme)), List String)
addCtorIdentCand env tyName o cn (cands, collided) = match mkIdent NsCtor o cn
  None => (cands, collided)
  Some ident => match lookupCtor env cn
    None => (cands, collided)
    Some s =>
      let prior = dropCtorIdentCand ident (fromOption [] (omLookup cn cands))
      let next = prior ++ [(ident, tyName, s)]
      (
        omInsert cn next cands,
        if listLen next >= 2 && not (contains cn collided) then cn::collided else collided,
      )

dropCtorIdentCand : Ident -> List (Ident, String, Scheme) -> List (Ident, String, Scheme)
dropCtorIdentCand _ [] = []
dropCtorIdentCand ident ((c@(i, _, _))::rest)
  | i == ident = dropCtorIdentCand ident rest
  | otherwise = c :: dropCtorIdentCand ident rest

-- ── THIS module's scoped view of the bare-name constructor env ─────────────
-- Overlay [env] (the fully-registered `dataEnv`: universe < import overlay < prog0) with
-- the declaration each COLLIDED constructor name resolves to IN THIS MODULE'S SCOPE.
-- Iterates the collided list — not the table — so a program with no constructor-name
-- collision pays ONE `[]` match per module and returns [env] itself, unchanged and
-- unallocated.
--
-- ⚠️ OVERLAY, never a rebuild, for the same reason `applyMethodScopeOverrides` is one:
-- anything this cannot resolve keeps [env]'s answer, which is today's behaviour.  It can
-- only ever REPLACE an entry, never add or remove one — a collided name has ≥2 candidates
-- in the universe, so it is registered in [env] by construction.
applyCtorScopeOverrides : List Decl -> TcEnv -> TcEnv
applyCtorScopeOverrides prog env =
  overrideScopedCtors
    prog
    crossRun.value.universeCtorIdentsRef.value
    crossRun.value.universeCtorCollidedRef.value
    env

overrideScopedCtors : List Decl -> OrdMap (List (Ident, String, Scheme)) -> List String -> TcEnv -> TcEnv
overrideScopedCtors _ _ [] env = env
overrideScopedCtors prog cands (n::rest) env =
  let env2 = match omLookup n cands
    None => env
    Some cs => match scopedCtorEntry prog n cs
      None => env
      Some s => addCtor env n s
  overrideScopedCtors prog cands rest env2

-- Which declaration of constructor [n] does THIS module mean?  Same nearest-scope-wins
-- ladder as `scopedMethodEntry` and `tyOriginScope`, with one rung fewer (see the
-- no-prelude-rung note above).  `None` at any rung means "this module's scope does not
-- decide it" and the caller keeps the floor — never a guess.
--
-- ⚠️ THE OWN-DECLARATION RUNG IS A DECLINE, NOT A LOOKUP, and the asymmetry with
-- `scopedMethodEntry` is deliberate: the companion is grown in `appendDataUniverse`,
-- which runs at the END of this module's own arm, so this module's declarations are not
-- in [cs] yet.  They do not need to be — `registerAllData base prog0` registered them
-- LAST at the call site, so the floor already holds the own-declaration answer and
-- overriding it could only make it worse.
scopedCtorEntry : List Decl -> String -> List (Ident, String, Scheme) -> Option Scheme
scopedCtorEntry prog n cs =
  if declaresCtorNamed prog n then
    None
  else
    importedCtorEntry prog n cs

-- Exactly one of this name's declarations is reachable through an import of THIS module:
-- that is what the occurrence names.  Two would be an ambiguous occurrence, which resolve
-- already rejects (`R-AMBIGUOUS-CTOR`), so declining there costs nothing an ACCEPTED
-- program can observe — and, per the ambiguity note above, it is what keeps this from
-- re-deciding a question resolve owns.
importedCtorEntry : List Decl -> String -> List (Ident, String, Scheme) -> Option Scheme
importedCtorEntry prog n cs = match filterList (c => ctorCandImported prog n c) cs
  [only] => Some (ctorCandScheme only)
  _ => None

ctorCandScheme : (Ident, String, Scheme) -> Scheme
ctorCandScheme (_, _, s) = s

-- Does THIS module declare a constructor spelled [n]?  Monomorphic and short-circuiting
-- on purpose (`compiler/AGENTS.md`); runs only for a COLLIDED name.
--
-- 🚨 THE `DAttrib` ARM RECURSES INTO ITSELF (`declaresCtorNamed [d] n`), it does NOT
-- unwrap one layer with `declCtorNamed n d`.  `DAttrib` CAN wrap another `DAttrib`
-- (`parseAttrib` calls `parseDecl` recursively — `frontend/parser.mdk`'s own comment
-- names the case), and `declCtorNamed`'s `_ => False` arm swallows a nested one
-- silently.  Both siblings on this path already recurse (`insertCtorIdents`,
-- `anyUsePathBindsCtor`); this one did not, and the divergence was caught in review
-- rather than by any gate.
--
-- ⚠️ IT IS LATENT TODAY, WHICH IS WHY IT IS WRITTEN DOWN INSTEAD OF SHRUGGED OFF: an
-- attribute on a `data` declaration currently destroys that declaration's constructors
-- (a separate, pre-existing S1), so no doubly-attributed data decl reaches here with
-- constructors to find.  When THAT is fixed this goes live, and its failure mode is
-- precisely the counterfactual `ctor_scope_ident_local_ctor_bystander/bystand.mdk`
-- measures: the own-declaration rung fails to decline, the single import witness wins,
-- and the module's own constructor is clobbered by an imported same-named one.
declaresCtorNamed : List Decl -> String -> Bool
declaresCtorNamed [] _ = False
declaresCtorNamed ((DAttrib _ d)::rest) n = declaresCtorNamed [d] n
  || declaresCtorNamed rest n
declaresCtorNamed (d::rest) n = declCtorNamed n d || declaresCtorNamed rest n

ctorCandImported : List Decl -> String -> (Ident, String, Scheme) -> Bool
ctorCandImported prog n (ident, owner, _) =
  anyUsePathBindsCtor prog n owner ident

anyUsePathBindsCtor : List Decl -> String -> String -> Ident -> Bool
anyUsePathBindsCtor [] _ _ _ = False
anyUsePathBindsCtor ((DAttrib _ d)::rest) n owner ident = anyUsePathBindsCtor [d] n owner ident
  || anyUsePathBindsCtor rest n owner ident
anyUsePathBindsCtor ((DUse _ path _)::rest) n owner ident = usePathWitnessesCtor path n owner ident
  || anyUsePathBindsCtor rest n owner ident
anyUsePathBindsCtor (_::rest) n owner ident =
  anyUsePathBindsCtor rest n owner ident

-- An import witnesses a candidate when TWO things hold — the identical conjunction
-- `usePathWitnesses` states for methods:
--   * the path lets the CONSTRUCTOR through — `usePathBindsCtor`;
--   * the dependency's row CARRIES *that declaration* of it — asked of
--     `graphCtorExportsRef`, so a re-export chain resolves transitively and BY IDENTITY.
--     That second conjunct is what drains #1283: the re-exporter's row carries the
--     DECLARING module's `Ident`, so naming the re-exporter and naming the definer are
--     the same question with the same answer.
usePathWitnessesCtor : UsePath -> String -> String -> Ident -> Bool
usePathWitnessesCtor path n owner ident =
  let dep = usePathModuleId path
  dep /= "core"
    && usePathBindsCtor path n owner
    && depExportsCtorIdent dep n ident

-- 🚨 `usePathBindsName` — A-2.5's member filter — IS NOT REUSABLE HERE, and reusing it
-- is how this unit would have reproduced the #1272 / #1275 class one namespace over.
-- It tests whether a member SPELLS the name; `import m.{T(..)}` binds constructor `C`
-- without spelling it anywhere.  So the ctor filter is given the candidate's OWNING TYPE
-- NAME alongside the ctor name, and `memberBindsCtorName` is the ONE predicate that
-- answers "does this member bind this constructor" — shared with the re-export expansion
-- (`rowBoundByMember`) so the two cannot drift into two rules.
--
-- `UseWild` (`import m.*`) binds every constructor `m` exports, and that is safe for the
-- same reason it is safe for methods: the export test still admits only the declarations
-- `m` really provides.  `UseName` (bare `import m`) binds NO names — it exists to bring
-- impls into scope for dispatch (`AGENTS.md`) — and `UseAlias` binds VALUES only (an
-- alias-qualified name in type or constructor position is a parse error), so both
-- witness nothing.
usePathBindsCtor : UsePath -> String -> String -> Bool
usePathBindsCtor (UseGroup _ ms) n owner = anyMemberBindsCtor n owner ms
usePathBindsCtor (UseWild _) _ _ = True
usePathBindsCtor _ _ _ = False

anyMemberBindsCtor : String -> String -> List UseMember -> Bool
anyMemberBindsCtor _ _ [] = False
anyMemberBindsCtor n owner (m::rest) = memberBindsCtorName n owner m
  || anyMemberBindsCtor n owner rest

-- The two spellings that bind a constructor: naming it, or naming its type with `(..)`.
-- The member's ORIGIN spelling is what is compared — `UseMember`'s first field, the name
-- in the EXPORTING module (`useMemberOrigin`) — because the candidate table is keyed by
-- the constructor's DECLARED name and no constructor is ever registered under an alias.
--
-- ⚠️ AN EARLIER VERSION OF THIS COMMENT DREW THE OPPOSITE CONSEQUENCE FROM THE SAME
-- (correct) premise, claiming that an aliased member `{C as D}` "therefore does not
-- witness".  It is the origin that is compared, so such a member WOULD witness.  The
-- point is moot either way — `import m.{C as D}` is REJECTED upstream ("is a type or
-- constructor and cannot be aliased"), so no aliased constructor member reaches here —
-- but a wrong consequence beside a right premise is exactly the sentence a later reader
-- builds on, so it is corrected rather than deleted.  The `UseAlias` claim on
-- `usePathBindsCtor` above is a different statement and is accurate.
memberBindsCtorName : String -> String -> UseMember -> Bool
memberBindsCtorName n owner (UseMember mn ctors _ _) = mn == n
  || ctors && mn == owner

-- Does [dep]'s row carry a constructor spelled [n] whose DECLARATION is [ident]?
--
-- A per-`dep` miss is the honest answer to "this dependency's row does not carry that
-- declaration"; a WHOLESALE miss — the index absent — is a programming error, and the
-- property that forbids it is the same two-part conjunction stated on
-- `graphMethodExports` (overwritten at every Module-mode driver entry AND no reset point
-- in between).  `graphCtorExports` carries the constructor half of that property.
depExportsCtorIdent : String -> String -> Ident -> Bool
depExportsCtorIdent dep n ident = match omLookup dep driverState.value.graphCtorExportsRef.value
  None => False
  Some es => exportsCtorIdentFor n ident es

exportsCtorIdentFor : String -> Ident -> List (String, String, Ident) -> Bool
exportsCtorIdentFor _ _ [] = False
exportsCtorIdentFor n ident ((cn, _, ci)::rest)
  | cn == n && ci == ident = True
  | otherwise = exportsCtorIdentFor n ident rest

-- ── #1111 Stage A-2 unit A-2.12 (#1319 unit 2): the RECORD-table peer ──────
--
-- The two tables `registerRecordInfoKeyed` writes in lockstep — `recordByNameRef`
-- (registry key → RecordInfo) and `fieldOwnersRef` (field name → owning registry keys) —
-- are the constructor namespace's OTHER half, and unit 1 deliberately did not touch them.
-- A record literal / record pattern / `.field` access never reads `universeDataEnv`'s
-- constructor SCHEME env at all, so unit 1's `applyCtorScopeOverrides` cannot reach them:
-- that is exactly why #1283 **Repro A** (the RECORD spelling of the re-export miss) stayed
-- open when Repro B drained.
--
-- Two DIFFERENT defects live in these two tables, and **only the first is addressed here.**
--
--   * `recordByNameRef` is BARE-KEYED and LAST-WRITE-WINS, exactly like `universeDataEnv`'s
--     ctor map.  Two modules each declaring `Cfg` leave ONE entry and load order picks it.
--     Answer, and what this unit implements: the A-2.5 / unit-1 shape, verbatim — an
--     identity-keyed COMPANION plus a per-module SCOPE DECISION for the collided keys only.
--   * `fieldOwnersRef` is a multimap and ACCUMULATES.  Its key (the field name) is already
--     right; what is wrong is that its VALUE — the candidate owner set — is graph-global,
--     so a record the module has no import path to still votes in the ambiguity test
--     (#1070's fourth row).  **NOT FIXED HERE, and the reason is a measurement, not a
--     preference.**
--
-- 🚨 WHY THE FIELD HALF IS NOT DONE WITH THIS MACHINERY.  A first cut of this unit did
-- narrow the owner set using the SAME witness predicates the record half uses.  Adversarial
-- review reproduced three defects in it, all confirmed against cold-built binaries:
--
--   1. **It is the WRONG QUESTION.**  `fieldOwnersRef` has two consumers, and the second —
--      `resolveFieldRecord`'s concrete-receiver fallback, reached by every `data T = | C
--      { … }` whose key `C` is not the type `T` — needs "could this module be HOLDING a
--      value of that record", not "is that record's CONSTRUCTOR in scope".  Those come
--      apart on ordinary code: `import amod.{RA, mkA}` (no `(..)`) witnesses no
--      constructor, yet `mkA.dx` is legitimate.  Measured: `8` at exit 0 before, `Type
--      mismatch: RA vs Wrec` at exit 1 after — an accept→reject regression on two
--      libraries that merely share a field name.  Importing only the VALUE (`{mkA}`) is
--      enough to reach it, so no constructor-spelling test can be the predicate.
--   2. **The collided-FIELD list is not rare.**  Two records anywhere in the graph sharing
--      `name`/`id`/`size` put a name on it, so the per-module walk is paid by real
--      programs: interleaved A/B, deterministic net allocation, N modules x 4 records —
--      60: 161→187 MB, 120: 261→399 MB, 240: **463→2583 MB (5.6x)**, r3 = 6.47 against a
--      hard 3.0.  A `List` used as a set, i.e. this tree's signature defect.
--   3. **It was non-monotonic and did not drain the common case anyway.**  The collided
--      list is grown in `appendDataUniverse`, the LAST thing in a module's arm, so a
--      module's own declarations are never in the list its own arm reads: local `MRec{fld}`
--      plus ONE unrelated collider stayed rejected, while adding a SECOND unrelated
--      collider made the same program compile.
--
-- The predicate the field half actually needs is a REACHABILITY question: can a value of
-- this record type be OBTAINED here at all.  ⚠️ NOT "does an imported binding's type
-- mention it" — that is one hop, and it is not enough.  A record reachable only
-- TRANSITIVELY — as a field of an imported record, an element of an imported `List`, a type
-- argument, a component of a returned tuple — is a value this module can hold and project
-- `.f` on, so it must count.  The predicate is a closure over the imported type surface,
-- which is a different analysis from anything this unit builds, and stating its true size
-- is the point: an under-stated version invites the next agent to reach for a spelling test
-- again.  Rather than widen into it, the row stays open on #1070 / #1319 with those three
-- findings recorded on it.
--
-- ⚠️ MIRROR DISCIPLINE, and it is now a THREE-way mirror (method / ctor / record) until
-- #1288 lands.  The witness half is deliberately NOT re-implemented here: `declaresCtorNamed`
-- and `anyUsePathBindsCtor` are SHARED with unit 1, because a record's name IS its
-- constructor and a named-field variant is keyed by its constructor — the question "does
-- this module declare, or import, a constructor spelled `n` owned by type `owner`" is
-- literally the same question.  Only the candidate ROW type differs (RecordInfo instead of
-- Scheme), so only the two projections below are new.
--
-- 🚨 IT MUST NOT RE-DECIDE AMBIGUITY, for the same reason and by the same construction as
-- unit 1: two witnesses decline to the floor rather than picking one, so a genuinely
-- ambiguous import stays resolve's to reject.
--
-- ⚠️ SCAFFOLDING WITH A NAMED DELETER, same as unit 1: this is a further implementation of
-- a fact `resolve.mdk` derives.  #1288 owns the consolidation.
--
-- ── THE NO-CARRIER RULING, RE-TESTED FOR THIS NAMESPACE RATHER THAN INHERITED ──
-- #1319's adjudication adopted "no AST occurrence carrier" but flagged the negative as
-- non-exhaustive and required the implementing PR to RE-TEST it.  Unit 1 discharged that
-- for constructor occurrences with a driver-level argument (`desugar : List Decl -> List
-- Decl` is applied per module, so no desugar pass is ever handed two modules).  That
-- argument covers record occurrences too — but it is an argument, so the two real
-- body-copy paths were re-run for RECORD occurrences specifically, first-hand:
--   * interface-default specialization: `ifc` declares `data Box = { bv : Int }` and an
--     interface whose default body is `boxOf (Box { bv = 1 })`; `user` declares its OWN
--     `Box` at `{ bv : String }`, writes a body-less `impl`, and uses its own.  Result
--     `ifc-1|mine`, exit 0 — the copied body keeps the interface module's `Box`.
--   * another module's impl body: `impmod`'s `impl` body builds `impmod`'s `Box`; the
--     importer declares its own at an unrelated field type.  Result `imp-5|mine`, exit 0.
-- Neither occurrence is re-resolved in the importer's record scope, so a DECL-level scope
-- decision is the right instrument and no node carrier is needed.  As with unit 1 this is
-- falsifiable by a future change: a driver that hands `desugar` a concatenation of modules
-- would reopen it.

-- Grow the identity-keyed companion by THIS module's PUBLIC record declarations.
--
-- 🚨 THE `RecordInfo` IS READ BACK OUT OF `recordByNameRef` RATHER THAN RE-DERIVED, for the
-- same reason `insertCtorIdents` reads its `Scheme` out of `env2`: this runs immediately
-- after `registerAllData … pubDecls` in `appendDataUniverse`, so `lookupRecordByName key`
-- is THIS module's just-registered entry and the companion holds the very object the bare
-- map holds.  Re-deriving would call `registerRecordInfoKeyed` a second time, minting a
-- second set of `freshVars` for the same declaration — two RecordInfos for one record, the
-- failure this placement exists to make impossible.
--
-- ⚠️ ONLY `ConNamed` VARIANTS ARE RECORDED, because only they are registered:
-- `registerNamedFieldVariants` skips a positional variant, so a positional constructor has
-- no `recordByNameRef` row to be a candidate for.  The short-form record `data X = { … }`
-- IS a `ConNamed` variant (its key and its type name coincide); a `DNewtype` is `ConPos`
-- and contributes nothing here.
insertRecordIdents : List Decl -> (OrdMap (List (Ident, String, RecordInfo)), List String) -> (OrdMap (List (Ident, String, RecordInfo)), List String)
insertRecordIdents [] acc = acc
insertRecordIdents ((DAttrib _ d)::rest) acc =
  insertRecordIdents rest (insertRecordIdents [d] acc)
insertRecordIdents ((DData { dataName, dataCtors, dataOrigin, ... })::rest) acc = insertRecordIdents rest (insertRecordVariantIdents dataName dataOrigin dataCtors acc)
insertRecordIdents (_::rest) acc = insertRecordIdents rest acc

insertRecordVariantIdents : String -> TyConOrigin -> List Variant -> (OrdMap (List (Ident, String, RecordInfo)), List String) -> (OrdMap (List (Ident, String, RecordInfo)), List String)
insertRecordVariantIdents _ _ [] acc = acc
insertRecordVariantIdents tyName o ((Variant cn (ConNamed _ _))::rest) acc =
  insertRecordVariantIdents tyName o rest (addRecordIdentCand tyName o cn acc)
insertRecordVariantIdents tyName o (_::rest) acc =
  insertRecordVariantIdents tyName o rest acc

-- Upsert BY IDENTITY, so `listLen >= 2` means "two DISTINCT declarations of this registry
-- key" and the collided list cannot fill with self-collisions.  Honest absence twice over,
-- exactly as `addCtorIdentCand`: no module id ⇒ no identity ⇒ no candidate; no row in
-- `recordByNameRef` ⇒ no candidate, since a candidate with no RecordInfo could not be
-- selected anyway.
addRecordIdentCand : String -> TyConOrigin -> String -> (OrdMap (List (Ident, String, RecordInfo)), List String) -> (OrdMap (List (Ident, String, RecordInfo)), List String)
addRecordIdentCand tyName o cn (cands, collided) = match mkIdent NsCtor o cn
  None => (cands, collided)
  Some ident => match lookupRecordByName cn
    None => (cands, collided)
    Some ri =>
      let prior = dropRecordIdentCand ident (fromOption [] (omLookup cn cands))
      let next = prior ++ [(ident, tyName, ri)]
      (
        omInsert cn next cands,
        if listLen next >= 2 && not (contains cn collided) then cn::collided else collided,
      )

dropRecordIdentCand : Ident -> List (Ident, String, RecordInfo) -> List (Ident, String, RecordInfo)
dropRecordIdentCand _ [] = []
dropRecordIdentCand ident ((c@(i, _, _))::rest)
  | i == ident = dropRecordIdentCand ident rest
  | otherwise = c :: dropRecordIdentCand ident rest

-- ── THIS module's scoped view of `recordByNameRef` ─────────────────────────
-- Runs at the `dataEnv` binding, immediately after `registerAllData … prog0` has written
-- the floor (universe < import overlay < prog0) into the per-run ref, and iterates the
-- collided-KEY list — a program in which no two modules declare the same record /
-- named-field-variant name pays one `[]` match per module and mutates nothing.
--
-- ⚠️ "NORMALLY EMPTY" IS A CLAIM ABOUT RECORD KEYS, NOT ABOUT FIELD NAMES, and the
-- distinction is load-bearing rather than pedantic.  An earlier cut of this unit built the
-- same machinery for `fieldOwnersRef` keyed on collided FIELD names; adversarial review
-- measured that list to be routinely non-empty (any two records anywhere in the graph
-- sharing `name`/`id`/`size` put a name on it), which turned the per-module walk into
-- 5.6x net allocation at 240 modules.  A collided record KEY means two modules declare a
-- record spelled the same, which is the collision this unit exists for and is genuinely
-- rare — but it is an empirical claim, so `gen_modules` in
-- `test/diff_compiler_perf_scaling.sh` now declares records per module, because before that
-- NO multi-module generator in the gate declared a single record or field and this code
-- path could not be seen at all.  Derive the generator set rather than trusting this
-- sentence: `grep -n '^gen_[a-z_]*() {' test/diff_compiler_perf_scaling.sh`.
--
-- ⚠️ OVERLAY, never a rebuild: anything a module's scope does not decide keeps the floor's
-- answer, which is today's behaviour.
--
-- 🚨 THE SCOPED VIEW MUST NOT REACH THE UNIVERSE, and it does not — but only because of
-- where `appendDataUniverse` reloads.  The overlay mutates the PER-RUN ref, and
-- `appendDataUniverse` (the end of this module's arm) opens with `loadDataUniverse`,
-- which overwrites that ref from the cross-run universe — and, for the alias table,
-- from stage K at this module's ordinal — BEFORE this module's public decls
-- are registered into it.  So one module's scope decision is invisible to the next.
-- Moving the reload, or growing the universe from the per-run refs as they stand at the
-- end of the arm, would make module A's import scope decide module B's records.
--
-- 🚨 THIS BREAKS THE `#415` LOCKSTEP AND THE OBLIGATION IS NOW REAL.  The note at
-- `registerRecordInfoKeyed` calls that function *"the SOLE registration writer of both"*
-- `recordByNameRef` and `fieldOwnersRef`, and calls their lockstep *"structural, not an
-- obligation"*.  That is no longer true: this overlay writes `recordByNameRef` ALONE.
-- Re-pointing key `K` does not change WHICH keys own a field name (the key is the same
-- string), but it does change which FIELDS `K` declares — so with two same-named records
-- having DISJOINT field sets, `fieldOwnersRef` can name `K` as the owner of a field the
-- newly-selected `K` does not have.
--
-- 🚨 AND THAT HAD A CONSEQUENCE.  An earlier draft of this note called it *"an obligation
-- with no observed consequence today"* on the strength of one probe; the probe kept both
-- projections inside the module that NAMED the record, so the overlay agreed with the floor
-- and could not show anything.  **#1377 was the consequence**: a module that names one `Cfg`
-- and holds a value of the OTHER `Cfg` was refused, `Field 'beta' does not belong to record
-- 'Cfg'`, exit 1, where `5` is correct.
--
-- ⚠️ #1319 UNIT 3 DRAINED #1377 WITHOUT RECONCILING THESE TWO TABLES, so the write asymmetry
-- above is unchanged and this paragraph must not be read as retired.  What unit 3 removed is
-- the QUESTION: `resolveFieldRecord`'s arm (a) no longer reads this overlay's answer for a
-- receiver whose type already carries an identity.  Do NOT restate the note as "no observed
-- consequence today" — that sentence has been wrong twice here already; the accurate
-- statement is that the consequence which was found is gone and nobody has shown it was the
-- only one.
--
-- ── THE RULE THIS OVERLAY NOW STATES, AND ITS BOUNDARY ──────────────────────
-- **The declaration this module NAMES wins for every occurrence of that name WRITTEN IN THIS
-- MODULE'S SOURCE** — a record literal, a record pattern, a variant update, an annotation.
--
-- 🚨 THE SECOND HALF OF THIS RULE WAS DELETED BY UNIT 3, AND THE OLD WORDING IS QUOTED HERE
-- SO A STALE COPY ELSEWHERE IS RECOGNISABLE.  It used to read *"… for EVERY projection of
-- that key in this module, including projections of values whose type the module never
-- named"*, which is exactly the sentence #1377 falsified.  That clause is gone: a projection
-- of a value whose type this module never named is now decided by the RECEIVER's identity
-- (`lookupRecordForReceiver`), not here.
--
-- What is left is the SPELLING question, and for that a per-module scope decision is the
-- right instrument rather than a stopgap — `docs/spec/DICT-SEMANTICS.md` §8 I4 qualification
-- 2 says record construction and record patterns *are* ambiguous exactly when the name is.
-- The overlay is still **scaffolding** for a different reason: it is a further implementation
-- of a fact `resolve.mdk` derives, and #1288 owns the consolidation.  Unit 4 owns retiring it.
applyRecordScopeOverrides : List Decl -> Unit
applyRecordScopeOverrides prog =
  overrideScopedRecords
    prog
    crossRun.value.universeRecordIdentsRef.value
    crossRun.value.universeRecordCollidedRef.value

overrideScopedRecords : List Decl -> OrdMap (List (Ident, String, RecordInfo)) -> List String -> Unit
overrideScopedRecords _ _ [] = ()
overrideScopedRecords prog cands (n::rest) =
  let _ = match omLookup n cands
    None => ()
    Some cs => match scopedRecordEntry prog n cs
      None => ()
      Some ri => perRun.value.recordByNameRef := omInsert n ri perRun.value.recordByNameRef.value
  overrideScopedRecords prog cands rest

-- Which declaration of registry key [n] does THIS module mean?  The same ladder as
-- `scopedCtorEntry`, using the SAME two predicates — see the mirror-discipline note above
-- for why they are shared rather than copied.  The own-declaration rung is a DECLINE for
-- the same reason it is there: `registerAllData base prog0` registered this module's own
-- records LAST, so the floor already holds the own-declaration answer.
scopedRecordEntry : List Decl -> String -> List (Ident, String, RecordInfo) -> Option RecordInfo
scopedRecordEntry prog n cs =
  if declaresCtorNamed prog n then
    None
  else
    importedRecordEntry prog n cs

importedRecordEntry : List Decl -> String -> List (Ident, String, RecordInfo) -> Option RecordInfo
importedRecordEntry prog n cs = match filterList (c => recordCandImported prog n c) cs
  [only] => Some (recordCandInfo only)
  _ => None

recordCandInfo : (Ident, String, RecordInfo) -> RecordInfo
recordCandInfo (_, _, ri) = ri

recordCandImported : List Decl -> String -> (Ident, String, RecordInfo) -> Bool
recordCandImported prog n (ident, owner, _) =
  anyUsePathBindsCtor prog n owner ident

missingImplMethodMsg : String -> List Ty -> String -> String
missingImplMethodMsg iface tys method = "'impl \{iface} \{joinWith " " (map ppTyAtom tys)}' is missing method '\{method}'. Every interface method without a default body must be implemented — define '\{method}' in the impl (or check for a typo in a method name)"

-- ── WS-5: phantom interface method detection ──────────────────────────────
-- A method whose declared type mentions NONE of the interface's type parameters
-- (neither in argument position nor in the result) cannot be dispatched: there
-- is no argument or return type to select an impl from.  Reject at check time
-- so the silent mis-dispatch at runtime is caught early.
--
-- Examples:
--   interface Phantom a where
--     name : String          -- PHANTOM: `a` appears nowhere in the type
--   interface Show a where
--     show : a -> String     -- OK: `a` appears in argument position
--   interface Pure f where
--     pure : a -> f a        -- OK: `f` appears in result position
--
-- The check uses the full method type (args AND result via tyVarNames), so
-- return-position methods like `pure : a -> f a` or `minBound : a` are NOT
-- flagged.  Multi-param interfaces: phantom iff ALL params absent.

-- #1557 A-3.5c: relocated onto stage K's `CE`.  The row set is
-- `ceRowsOwnedBy` — the READING module's OWN interfaces, which is exactly the
-- decl list this check was handed before (`prog` on the Module arm, the
-- driver-staged USER decls on Flat), NOT the visible prefix: an imported
-- interface's phantom method is reported once, at the module that declares it,
-- not once per importer.  See `ceRowsVisibleAt`/`ceRowsOwnedBy` for why the two
-- populations are kept apart.
--
-- Reading `CE` rather than re-destructuring `DInterface` also drops the
-- `DAttrib` unwrapping this check used to open with: `classEnvDeclFact` already
-- peels it, so an attributed interface reaches `CE` as a row like any other.
checkPhantomMethods : ClassEnv -> Int -> Unit
checkPhantomMethods ce cur =
  foreachUnit
    (pushTypeError "T-PHANTOM-METHOD")
    (flatMap phantomMethodMsgs (ceRowsOwnedBy cur ce))

phantomMethodMsgs : CeRow -> List String
phantomMethodMsgs r =
  flatMap
    (phantomMethodMsg (ceRowIfaceName r) (ceRowTyparams r))
    (ceRowMethods r)

ceRowIfaceName : CeRow -> String
ceRowIfaceName r = match ceRowIface r
  IfaceRef { irName = n, ... } => n

phantomMethodMsg : String -> List String -> (String, Ty, List (String, List Kind)) -> List String
phantomMethodMsg ifaceName typarams (mname, mty, _) =
  if isEmptyL typarams then
    []
  else if anyMember (tyVarNames mty) typarams then
    []
  else
    [
      "Method '\{mname}' in interface '\{ifaceName}' does not mention interface parameter(s) \{intercalateComma typarams}; cannot dispatch"
    ]

intercalateComma : List String -> String
intercalateComma [] = ""
intercalateComma [x] = "'" ++ x ++ "'"
intercalateComma (x::rest) = "'\{x}', \{intercalateComma rest}"

-- ── WS-4a: cyclic superinterface detection ────────────────────────────────
-- A cyclic `interface A requires B; interface B requires A` is ill-formed: no
-- impl can ever be constructed (each demands the other) and the transitive
-- evidence resolver would diverge.  DFS over the `requires` graph; if any node
-- is re-encountered on the current DFS stack, report the cycle.
-- Runs over ALL interfaces in scope (prelude + user) — a prelude cycle would
-- be equally ill-formed.  The `done` ref tracks fully-explored nodes to avoid
-- redundant traversal and re-reporting multi-root cycles.
-- 🚨 #1557 A-3.5c: relocated onto stage K's `CE`, AND RE-KEYED — this is the
-- unit's #1258-class acceptance delta, the one the owner ruling of 2026-08-12
-- accepts by name (*"re-keying a bare-name table does not create wrongness, it
-- creates VISIBILITY"*).
--
-- WAS: `collectIfaceNames allDecls` for the roots and `ifaceSupersOf allDecls
-- <name>` for every edge — BOTH bare-name scans of a decl list, so a superinterface
-- edge resolved to whichever same-spelled interface appeared FIRST in
-- `accAll ++ accData ++ prog`.  Two unrelated modules each declaring `Same` collapsed
-- into one node: `mod_a.Same requires mod_b.Same` could be reported as a self-cycle it
-- is not, and a genuine cycle could be masked by the other module's row winning the
-- scan.  Import order selected the symptom, exactly as it did for `#1257`'s kind rows.
--
-- NOW: nodes are `CeRow`s and an edge is followed by IDENTITY —
-- `ceLookupAt (regKeyOfTab (ifaceTabKey superOrigin superHead))`.  `Super` has carried
-- `superOrigin` since #1110 Stage A-1 and `resolve.mdk` stamps it through the SAME
-- `mapSuperOcc`/`tyOriginScope` walk that stamps a `DImpl`'s `implOrigin`, so the
-- occurrence and the `DInterface`'s `ifaceOrigin` declaration layer meet for the same
-- reason `ifaceTabKey`'s header argues for the impl-head key.  The `done` set and the
-- DFS `path` are keyed on `regKeyRender` rather than the bare name for the identical
-- reason.
--
-- ⚠️ THE MISS ARM IS AN ABSTENTION, AND IT IS THE ONE PLACE THIS COULD GO
-- LOUD→SILENT.  An edge whose target is not in `CE` at this ordinal yields `None` and
-- the walk stops — the same disposition `ifaceSupersOf`'s `None` arm already had
-- ("unknown interface, reported elsewhere"), and resolve rejects an interface naming
-- an unknown superinterface before typecheck runs.  What is NEW is that a super whose
-- identity failed to resolve would now MISS where a bare name used to hit.  That is
-- why the abstention arm needs a POSITIVE control -- a shape whose edge MUST still be
-- followed -- rather than only a negative one.
--
-- 🚨 CITE FIXTURES THAT EXIST, AND CHECK THE GATE CONSUMES THEM.  This sentence named
-- `test/typecheck_error_fixtures/cyclic_superinterface_modules/` until adversarial
-- review, and that path was wrong TWICE OVER: no such directory, and
-- `diff_compiler_typecheck_errors.sh` iterates `"$FIXDIR"/*.mdk` -- FILES -- so a
-- directory fixture there could not be consumed even if someone created one.  No gate
-- catches this: `make docs-links` and `make agent-doc-symbols` do not scan compiler
-- comments.  It matters more than a typo because this is the one sentence answering
-- "is the abstention arm covered?", and a citation like that gets relayed into the
-- next unit's design as an established fact.  The real controls, both verified to
-- reject on this binary:
--   * MULTI-MODULE: `test/analyze_project_fixtures/1557_a35c_cycle_masked_by_samespelled/`
--     (consumed by `diff_compiler_analyze_project.sh`) -- its edge must resolve BY
--     IDENTITY for the fixture to pass at all, so an abstention that swallowed a real
--     edge reds it.
--   * FLAT: `test/dict_fixtures/s3-w1-cyclic-superinterface-rejected.mdk` (no imports)
--     and `test/typecheck_error_fixtures/cyclic_superinterface.mdk`.
-- The negative direction -- an edge that must NOT be followed -- is
-- `1557_a35c_samespelled_iface_bystander/`.  The set is the assertion; no member is.
--
-- ROOTS are `ceRowsVisibleAt` — the reading module's whole ordinal prefix — and that
-- reproduces the OLD root set EXACTLY, members and order.  Derive it from
-- `foldModules` rather than from this sentence: `accAll` is seeded with the WHOLE
-- `coreDecls` and grown `accAll ++ prog` (not `publicDataDecls prog` — only `accData`
-- is public-filtered), and every driver that reaches `runFinalChecks` passes
-- `wantAll = True`, so `accAll ++ accData ++ prog` is exactly {prelude} ∪ {every
-- earlier module in full} ∪ {this module} — with `accData` contributing only
-- duplicates, which `done` prunes.  `CE` at this ordinal is the same set in the same
-- ordinal order.
--
-- ⚠️ AN EARLIER CUT OF THIS COMMENT CLAIMED A DELIBERATE WIDENING HERE — *"`accAll`/
-- `accData` carry only `publicDataDecls`, so a PRIVATE interface of an earlier module
-- was never a root"* — and it was simply WRONG about `accAll`, so the widening it
-- conceded does not exist.  Measured on two binaries rather than argued: a module
-- declaring a PRIVATE cyclic interface pair has that cycle reported in a sibling
-- module with NO import path to it, on the pre-relocation arm too, byte-identical.
-- Do not reinstate the hedge; the relocation is root-set-preserving.
checkInterfaceCycles : ClassEnv -> Int -> Unit
checkInterfaceCycles ce cur =
  -- #973: `done` is an OrdMap-backed SET (omHasKey/omInsert), NOT a growing `List` scanned
  -- by `contains`.  The membership test ran once per interface over the fully-explored
  -- set, which grows to the interface count → O(interfaces^2), the flat-path
  -- `manyifaces:typecheck` op-count quadratic (independent of use sites — it surfaces on a
  -- file of N cycle-free interfaces).  Keyed into a set it is O(log n): `done` only prunes
  -- already-explored nodes (set membership is order-insensitive), and the DFS order +
  -- cycle messages are driven by `path`/the root list.  A-3.5c keeps the shape and only
  -- changes the KEY from a bare name to `regKeyRender`.
  let done = Ref omEmpty
  foreachUnit (checkOneIfaceCycle ce cur done) (ceRowsVisibleAt cur ce)

-- #152: the whole-program final-checks tail, shared by all five entry points
-- (checkToLines / checkToLinesWithRuntime / checkErrorsWithRuntime /
-- checkProgramDiags / checkModuleFullDiags).  [cohDecls] feeds coherence AND
-- checkSuperImpls's impl-iteration argument; [cycDecls] USED to feed checkSuperImpls's
-- second (whole-universe) argument and no longer does — see the A-3.5b note below.
-- ⚠️ trap #5: coherence must see USER decls only, so
-- this helper has NO access to `prog` — the caller decides [cohDecls] explicitly
-- (never a `prog` fallback).  Call ORDER is load-bearing (all push into typeErrors).
--
-- #1557 A-3.5c: two of the four members now read stage K's `CE` instead of a decl
-- list.  [ownCe]/[cycCe] are the class environments the caller is entitled to read
-- and [cur] is the READING module's ordinal — Module passes the whole-graph
-- `deIfaces` twice with its own ordinal; Flat passes two single-module envs built
-- from the very lists it used to hand `checkPhantomMethods`/`checkInterfaceCycles`,
-- at ordinal 0, because `declEnvsRef` is EMPTY on the Flat arm and reading it there
-- would switch both checks silently OFF.
--
-- ⚠️ CALL ORDER IS UNCHANGED AND THAT IS DELIBERATE.  A-3.5c moves two members'
-- SOURCE, not their position: coherence still runs first, then cycles, then phantom,
-- then super-impls, so no diagnostic changes rank against another family.  Whichever
-- unit lands A-3.5a/A-3.5b inherits this constraint — pulling a member OUT of this
-- sequence re-orders every accumulated diagnostic after it.
-- #1557 A-3.5b: [cycDecls] is now consumed by coherence's peer alone — the
-- super-impl check reads stage K instead, taking [cycCe] (the CE peer of the very
-- list it used to be handed) and [cycIe] (the IE peer, at the same ordinal).  Both
-- envs must be built from the SAME decl population [cycDecls] carries, which is why
-- the Flat callers below pass `flatImplEnvOf` of exactly the list they pass as
-- [cycDecls] and the Module caller passes the whole-graph `deImpls` with its own
-- ordinal.  [cycDecls] itself is retained because `checkInterfaceCycles`' comment
-- above derives the root-set equality from it and a later unit will want that
-- derivation to still have its subject.
-- #1559 A-3.7: coherence now reads stage K too, so this helper carries TWO `IE`s for
-- the same reason A-3.5c gave it two `CE`s — [cohIe] is the env over the population
-- [cohDecls] names (the USER boundary, trap #5) and [cycIe] is the env over the
-- whole-universe population [cycDecls] names.  They are the same env only on the paths
-- where those two decl lists were already the same.  [hasPrelude] rides with [cohIe]:
-- it is a property of THAT env, not of the caller's mode, and `cohRowVisible` states
-- what each arm must pass and what happens if it passes the other one.
--
-- 🚨 SA-6 (sprint repair round): THE `-1` SENTINEL IS FAIL-CLOSED HERE, AND IT HAS TO BE
-- ANNOUNCED AT THIS READER.  [cur] is `declEnvsOrdOf mid` on the Module arm, whose miss
-- value is `0 - 1` (see that function: a miss is documented fail-CLOSED, and it says in
-- so many words that the remedy for a stray id is at the READER — "abstain loudly / fail
-- the pass" — never a sentinel that means "everything").  All four members below take
-- [cur], and at `-1` they abstain in OPPOSITE directions: `checkCoherence` takes
-- `cohRowsOwnedBy -1` → no rows → **it checks nothing, silently**, where pre-A-3.7 it
-- walked the decl list unconditionally; `checkInterfaceCycles`/`checkPhantomMethods` take
-- `ceRowsVisibleAt -1`/`ceRowsOwnedBy -1` → likewise nothing; and `checkSuperImpls`,
-- whose row read SA-3 just widened to `ieCandidacyVisibleAt`, still finds no SUPERS
-- (`ceLookupAt … -1`) and so also reports nothing.  So the whole tail degrades to a
-- SILENT ACCEPT — a loud→silent transition, which this repo ranks as a severity increase
-- even while unreachable.
-- ⚠️ UNREACHABLE TODAY, AND THE GUARD IS STILL RIGHT.  The three drivers pass either a
-- literal `0` (both Flat entries) or `declEnvsOrdOf mid` over the very list
-- `buildDeclEnvs` indexed, so no live path can arrive at `-1`; a fourth Module-mode
-- driver, or any path stamping a mid `buildDeclEnvs` did not index, makes it live.  It
-- cannot fire spuriously, because `cur < 0` is exactly and only the miss sentinel and no
-- caller can construct a negative ordinal otherwise.
-- 🎯 WHAT THIS DOES *NOT* COVER, stated because it is the near miss: a driver that
-- threads a VALID-but-WRONG ordinal (some other module's) is undetectable here — the
-- sentinel is the only self-identifying failure — and `globalCoherenceConflict` takes no
-- ordinal at all (`cohRowsOf True`, whole graph), so it is outside this guard entirely.
runFinalChecks : List Decl -> List Decl -> ClassEnv -> ClassEnv -> ImplEnv -> ImplEnv -> Int -> Bool -> Unit
runFinalChecks cohDecls _cycDecls ownCe cycCe cohIe cycIe cur hasPrelude =
  let _ = ordinalSentinelGuard cur
  let _ = checkCoherence cohIe cur hasPrelude
  let _ = checkInterfaceCycles cycCe cur
  let _ = checkPhantomMethods ownCe cur
  checkSuperImpls cohDecls cycCe cycIe cur

-- SA-6's guard, split out so the arm is a GUARD and not a `whenL`.  ⚠️ Medaka is strict:
-- `whenL (cur < 0) (pushTypeError …)` would evaluate the push on EVERY call — the
-- documented not-a-stub trap.  A guarded function does not.
ordinalSentinelGuard : Int -> Unit
ordinalSentinelGuard cur
  | ordinalIsSentinel cur =
    pushTypeError "T-INTERNAL-ORDINAL" ordinalSentinelMsg
  | otherwise = ()

-- is [cur] `declEnvsOrdOf`'s miss sentinel?  A real ordinal is an index into the list
-- `buildDeclEnvs` was handed, so it is >= 0 by construction; `0 - 1` is the only negative
-- value any producer in this file yields.
-- > ordinalIsSentinel (0 - 1)
-- True
-- > ordinalIsSentinel 0
-- False
-- > ordinalIsSentinel 3
-- False
ordinalIsSentinel : Int -> Bool
ordinalIsSentinel cur = cur < 0

ordinalSentinelMsg : String
ordinalSentinelMsg = "internal error: the whole-program final checks (coherence, interface cycles, phantom methods, superinterface existence) were reached with an unknown module ordinal, so they cannot say what is in scope here. This is a compiler bug, not a problem with this program — please report it. The checks below this point may be incomplete"

-- #1557 A-3.5c: the FLAT arm's single-module `CE`.  `buildDeclEnvs` runs only at the
-- two Module-mode driver entries, so `driverState.declEnvsRef` is `emptyDeclEnvs` on
-- every flat path — reading it here would make `ceLookupAt` miss on every interface
-- and turn two live rejections into silent accepts on `medaka check <one file>`.
-- Ordinal 0 with `cur = 0` makes "visible at" and "owned by" coincide, which is
-- correct: a flat program is exactly one module.
flatClassEnvOf : List Decl -> ClassEnv
flatClassEnvOf decls = buildClassEnv [declEnvModule 0 "" decls]

-- #1557 A-3.5b: `flatClassEnvOf`'s `IE` peer, and it exists for the SAME reason and
-- with the same fail-direction.  `buildDeclEnvs` runs only at the two Module-mode
-- driver entries, so `driverState.declEnvsRef.deImpls` is `emptyImplEnv` on every flat
-- path — handing that to `checkSuperImpls` would make every super-existence query miss,
-- and a miss there reports a superinterface as MISSING.  So the failure on Flat is a
-- false REJECT of every `impl Sub T`, not a silent accept; loud either way, but wrong.
-- Ordinal 0 with `cur = 0` makes "visible at" and "owned by" coincide, which is
-- correct: a flat program is exactly one module.
flatImplEnvOf : List Decl -> ImplEnv
flatImplEnvOf decls = buildImplEnv [declEnvModule 0 "" decls]

checkOneIfaceCycle : ClassEnv -> Int -> Ref (OrdMap Unit) -> CeRow -> Unit
checkOneIfaceCycle ce cur done row =
  if not (omHasKey (ceRowDoneKey row) !done) then
    foreachUnit (pushTypeError "T-CYCLIC-SUPERINTERFACE") (ifaceDfsCycle ce cur done [row] row)
  else
    ()

-- WS-1b: the user-interface name set (`userIfaceNamesRef`, which gates
-- super-expansion) still reads this bare-name collector.  A-3.5c stopped using it
-- for the CYCLE walk only; re-pointing that set at `CE` is not this unit's.
collectIfaceNames : List Decl -> List String
collectIfaceNames [] = []
collectIfaceNames ((DInterface { name, ... })::rest) =
  name :: collectIfaceNames rest
collectIfaceNames ((DAttrib _ d)::rest) = collectIfaceNames (d::rest)
collectIfaceNames (_::rest) = collectIfaceNames rest

-- The `done`/`path` identity, rendered once.  `regKeyRender` is `RegKey`'s own
-- collision-free renderer, so two same-spelled interfaces in unrelated modules
-- get DIFFERENT set members — which is the whole point of the re-key.
ceRowDoneKey : CeRow -> String
ceRowDoneKey r = regKeyRender (ceRowKey r)

-- DFS from [current]; [path] is the stack of ROWS visited so far (including
-- [current] as its last element, used to reconstruct the cycle message).
-- Marks [current] as done after all its supers are explored.
ifaceDfsCycle : ClassEnv -> Int -> Ref (OrdMap Unit) -> List CeRow -> CeRow -> List String
ifaceDfsCycle ce cur done path current =
  let msgs = ifaceDfsCycleSupers ce cur done path (ceRowSupers current)
  done := omInsert (ceRowDoneKey current) () !done
  msgs

ifaceDfsCycleSupers : ClassEnv -> Int -> Ref (OrdMap Unit) -> List CeRow -> List Super -> List String
ifaceDfsCycleSupers _ _ _ _ [] = []
ifaceDfsCycleSupers ce cur done path ((Super { superHead = superName, superOrigin = so })::rest) =
  let msgs1 = ifaceDfsCycleOneSuper ce cur done path so superName
  msgs1 ++ ifaceDfsCycleSupers ce cur done path rest

-- check one super edge: cycle if the super's IDENTITY is on the DFS path; skip if
-- done; else recurse into the row that identity names.  A super naming no visible
-- interface abstains (see the miss-arm note at `checkInterfaceCycles`).
ifaceDfsCycleOneSuper : ClassEnv -> Int -> Ref (OrdMap Unit) -> List CeRow -> TyConOrigin -> String -> List String
ifaceDfsCycleOneSuper ce cur done path so superName =
  let key = regKeyOfTab (ifaceTabKey so superName)
  let rendered = regKeyRender key
  if containsRowKey rendered path then [cyclicSuperIfaceMsg (map ceRowIfaceName path ++ [superName])]
  else
    if omHasKey rendered !done then []
    else match ceLookupAt key cur ce
      None => []
      Some r => ifaceDfsCycle ce cur done (path ++ [r]) r

containsRowKey : String -> List CeRow -> Bool
containsRowKey _ [] = False
containsRowKey k (r::rest)
  | ceRowDoneKey r == k = True
  | otherwise = containsRowKey k rest

-- e.g. ["A", "B", "A"] → "cyclic superinterface: A requires B requires A"
cyclicSuperIfaceMsg : List String -> String
cyclicSuperIfaceMsg path = "Cyclic superinterface: "
  ++ joinWith " requires " path

-- the missing-superinterface error messages for one user decl (a DImpl, possibly
-- wrapped in DAttrib); [] for any non-impl decl or when every super impl exists.
--
-- OCCURRENCE MINT (#1110/#1111 A-2.4, the `implCompletenessMsgsOfMap` discipline):
-- `implOrigin` is destructured beside `iface` in the SAME record pattern, so the
-- identity and the name it qualifies cannot drift apart.
--
-- ⚠️ THE MISS ARM IS AN ABSTENTION AND IT IS THE ONE LOUD→SILENT RISK HERE.  A
-- `ceLookupAt` miss yields `[]` — no diagnostic — where the bare scan found the
-- interface by spelling regardless.  This is deliberately the SAME disposition
-- `ifaceSupersOf`'s `None` arm had ("unknown interface, reported elsewhere") and the
-- same one A-3.5a/A-3.5c took at their peers; making it loud instead would be a new
-- rejection class (an acceptance NARROWING) that no ruling licenses.  What guards it
-- is that a super-bearing impl MUST still reject: flat and 2-module
-- `T-MISSING-SUPER-IMPL` were measured before and after this relocation, and an
-- identity miss turns both GREEN, which is the direction that matters.
superImplMsgsOf : ClassEnv -> Int -> List ImplRow -> Decl -> List String
superImplMsgsOf ce cur rows (DAttrib _ d) = superImplMsgsOf ce cur rows d
superImplMsgsOf ce cur rows DImpl { iface, tys, implOrigin = o, ... } =
  match ceLookupAt (regKeyOfTab (ifaceTabKey o iface)) cur ce
    None => []   -- unknown interface (already reported elsewhere) → skip
    Some r =>
      if listLen (ceRowTyparams r) == listLen tys && allList tyIsConcrete tys then
        flatMap (superMsgFor rows iface tys (zipL (ceRowTyparams r) tys)) (ceRowSupers r)
      else
        []   -- arity mismatch, or a non-concrete head (deferred, like the oracle)
superImplMsgsOf _ _ _ _ = []

-- check one `Super superName params` against the substitution: map each super
-- param name through [subst] to its concrete Ty; if every param mapped, all are
-- concrete, AND no matching `impl superName <concrete>` exists, emit the error.
--
-- #1557 A-3.5b: the super's IDENTITY key is minted ONCE here, from `superOrigin` —
-- the same field and the same `ifaceTabKey` mint A-3.5c's cycle walk uses, which is
-- the point: two units, one key discipline.  `Super` has carried `superOrigin` since
-- #1110 Stage A-1.
superMsgFor : List ImplRow -> String -> List Ty -> List (String, Ty) -> Super -> List String
superMsgFor rows iface implTys subst (Super { superHead = superName, superParams = params, superOrigin = so }) =
  let concrete = substParams params subst
  if listLen concrete == listLen params && allList tyIsConcrete concrete && not (superImplExists rows (ifaceTabKey so superName) superName concrete) then
    [missingSuperImplMsg iface implTys superName concrete]
  else
    []

-- map each super-param NAME through [subst] to its Ty, dropping any unmapped (so a
-- short result vs [params] signals an incomplete substitution → caller skips).
substParams : List String -> List (String, Ty) -> List Ty
substParams [] _ = []
substParams (p::rest) subst = match lookupAssoc p subst
  Some t => t :: substParams rest subst
  None => substParams rest subst

-- byte-identical to lib/typecheck.ml's MissingSuperImpl rendering: both the impl
-- head and the super are printed with the same space-joined atom-position args.
missingSuperImplMsg : String -> List Ty -> String -> List Ty -> String
missingSuperImplMsg iface implTys superName superTys = "'impl \{iface} \{joinWith " " (map ppTyAtom implTys)}' requires a superinterface 'impl \{superName} \{joinWith " " (map ppTyAtom superTys)}', which is missing"

-- the (typarams, supers) of interface [target], scanning DInterface decls; None if
-- no such interface is in scope.
ifaceSupersOf : List Decl -> String -> Option (List String, List Super)
ifaceSupersOf [] _ = None
ifaceSupersOf ((DAttrib _ d)::rest) target = match ifaceSupersOf [d] target
  Some r => Some r
  None => ifaceSupersOf rest target
ifaceSupersOf ((DInterface { pub, def, name, typarams, supers, methods })::rest) target
  | name == target = Some (typarams, supers)
  | otherwise = ifaceSupersOf rest target
ifaceSupersOf (_::rest) target = ifaceSupersOf rest target

-- does any `impl superName <head>` with a head matching [concrete] exist? (head
-- may be parametric — a free tyvar in the impl head matches any concrete arg,
-- mirroring the oracle's mono_matches: pattern=impl head, concrete=super args.)
--
-- #1557 A-3.5b: [rows] are `IE`'s rows, bound once by `checkSuperImpls`; [superKey]
-- is the super's identity and [superName] its bare spelling.  This replaced a scan of
-- the whole decl list whose interface test was the bare `iface == superName`.
-- ⚠️ [rows] WAS "the rows visible at the reading ordinal" until RUN-055 (SA-3) widened
-- the scope to the whole graph, to match instance candidacy.  Nothing in THIS function
-- changed: it was and is a scan of whatever population its caller binds, and the two
-- tests below (identity, then `tyMatchesAst`) are what keep the wider population from
-- admitting a super it should not.
--
-- 🚨 IT COMPARES THE IDENTITY LEG, NEVER THE BUCKETS.  `ieInsertRow` indexes every row
-- under `oblIfaceKeys`, which mints TWO keys — the identity key AND a bare-spelling
-- compatibility leg that #1438 still rides on.  Looking [superKey] up in
-- `ieConcrete`/`ieHeadless` would therefore answer with BOTH same-spelled interfaces'
-- rows, rebuilding in the new substrate exactly the collapse this relocation removes.
-- Reading `ieRows` and testing each row's own `IfaceRef` cannot reach the bare bucket.
--
-- ⚠️ AND IT KEEPS `tyMatchesAst`.  The head match is unchanged, deliberately: `IE`'s
-- rows carry AST `Ty`s (`ImplRow`'s 4th position), so the existing predicate applies
-- verbatim.  Routing this through `ImplUniverse`/`matchStep` instead would carry a
-- second, unbudgeted acceptance delta on top of the intended re-key.
superImplExists : List ImplRow -> TabKey -> String -> List Ty -> Bool
superImplExists rows superKey superName concrete =
  anyList (implRowMatchesSuper superKey superName concrete) rows

-- NAME FIRST, then IDENTITY — the discipline `tabKeyEq` states for itself in
-- `types/registry.mdk`, applied here for a second reason: `ifaceTabKey` ALLOCATES (it
-- goes through `mkIdent`), and this runs once per visible row per (impl x super) in a
-- GC-bound stage.  Bare-name equality is a NECESSARY condition for key equality —
-- `tabKeyOf` puts the same [name] into both the `TkIdent` and the `TkBare` arm — so
-- gating on it is sound, and it bounds the minting to the set the OLD bare scan already
-- let through.  The DECIDING test is still the identity compare; the name test decides
-- nothing on its own.
implRowMatchesSuper : TabKey -> String -> List Ty -> ImplRow -> Bool
implRowMatchesSuper superKey superName concrete (ImplRow _ _ ir tys _ _) = ir.irName == superName
  && listLen tys == listLen concrete
  && ifaceTabKey ir.irOrigin ir.irName == superKey
  && allList (p => tyMatchesAst (fst p) (snd p)) (zipL tys concrete)

-- a Ty is concrete iff it contains no TyVar (mirror of the oracle's is_concrete,
-- which treats effect rows as transparent — TyEffect ignores its row).
tyIsConcrete : Ty -> Bool
tyIsConcrete (TyVar _) = False
tyIsConcrete (TyCon { tyConName = _ }) = True
tyIsConcrete (TyApp a b) = tyIsConcrete a && tyIsConcrete b
tyIsConcrete (TyFun a b) = tyIsConcrete a && tyIsConcrete b
tyIsConcrete (TyTuple ts) = allList tyIsConcrete ts
tyIsConcrete (TyEffect _ _ t) = tyIsConcrete t
tyIsConcrete (TyConstrained _ t) = tyIsConcrete t
-- Same "effect rows are transparent" treatment as `TyEffect` above (the
-- comment on this function): a row's own tail var never counts against
-- concreteness even for a wrapping `TyEffect`, so a bare row atom — with no
-- wrapped type at all — is vacuously concrete too.
tyIsConcrete (TyRow _ _ _) = True

-- one-directional structural match (pattern may carry free TyVar wildcards;
-- concrete is fully ground).  Mirror of lib/typecheck.ml's mono_matches.
tyMatchesAst : Ty -> Ty -> Bool
tyMatchesAst (TyVar _) _ = True
tyMatchesAst (TyCon { tyConName = a }) (TyCon { tyConName = b }) = a == b
tyMatchesAst (TyApp f1 a1) (TyApp f2 a2) = tyMatchesAst f1 f2
  && tyMatchesAst a1 a2
tyMatchesAst (TyFun a1 b1) (TyFun a2 b2) = tyMatchesAst a1 a2
  && tyMatchesAst b1 b2
tyMatchesAst (TyTuple ts1) (TyTuple ts2) = listLen ts1 == listLen ts2
  && allList (p => tyMatchesAst (fst p) (snd p)) (zipL ts1 ts2)
tyMatchesAst (TyEffect _ _ t1) t2 = tyMatchesAst t1 t2
tyMatchesAst t1 (TyEffect _ _ t2) = tyMatchesAst t1 t2
tyMatchesAst (TyConstrained _ t1) t2 = tyMatchesAst t1 t2
tyMatchesAst t1 (TyConstrained _ t2) = tyMatchesAst t1 t2
tyMatchesAst _ _ = False

-- ── D3 / WS-2 part-2: GLOBAL (cross-module) coherence ──────────────────────
-- Per-module coherence accepts two DIFFERENT modules that
-- each define `impl C T` for the SAME instance — each module is locally coherent,
-- but jointly they are incoherent (silent dispatch ambiguity).  This pass scans
-- the joint impl set over ALL USER modules (prelude EXCLUDED — a user `impl Eq Int`
-- legitimately overrides the prelude one, so prelude impls must NOT be in the set).
-- Each CohImpl carries the id of the module that PHYSICALLY declares it; imports do
-- NOT copy impl decls, so the joint set has exactly one entry per definition and a
-- structural (iface, head-tys) overlap already distinguishes distinct definitions —
-- no occurrence-dedup needed.  A conflict between two distinct modules is reported
-- naming BOTH (cohCrossModuleMsg via cohHardMsg's cross-module branch, or the
-- `(defined in …)` suffix `cohWhereSuffix` adds to the F-3d soft warning).
-- #1559 A-3.7: "the joint impl set over ALL USER modules" is now `cohRowsOf True` over
-- the whole-graph `IE` — the prelude exclusion is the `True`, and the one-entry-per-
-- definition property is `ieRows`' by construction (imports copy no rows either).
--
-- the first cross-module coherence conflict of EACH CLASS (if any) as bare messages
-- — `(hard, soft)`, the same split `checkCoherence` reports, so the cross-module path
-- demotes the ⊑-incomparable class exactly as the per-module one does (F-3d).
-- Drivers that thread errs as a VALUE (cmEntryCollect) prepend these themselves,
-- rather than relying on the typeErrors ref (cleared per-module by resetState).
--
-- ⚠️ #414: this deliberately DROPS the blame-span `cohScan` returns.
-- Both consumers attach the diagnostic to the ENTRY module, but the span belongs to
-- whichever module declares the offending impl — and the `--json`/human renderers
-- key a diagnostic's file by the GROUP it is filed under, NOT by the filename
-- inside its own `Loc`.  Attaching a foreign span therefore renders a caret at that
-- line/col in the WRONG file.  Measured, with the impl 40 lines into a dependency:
--     ./main.mdk:42:7: Conflicting `impl C`. Defined in amod and bmod
-- — main.mdk is 5 lines long, so the caret block cannot even render.  That is worse
-- than the file-start default: a confidently wrong location beats an obviously
-- fabricated one only at misleading the reader.  The cross-module wording already
-- names BOTH owning modules, which is the locating information that actually helps
-- here.  Attaching a real span needs the renderers to honour `Loc`'s own filename
-- (a driver/diagnostics.mdk change, well beyond an S3 caret fix).
-- #1559 A-3.7: the input is the whole-graph `IE`, prelude carved out, not the driver's
-- per-module decl pairs.
--
-- ORDER IS THE THING THIS BITE COULD MOVE, because `cohScanInner` keeps the FIRST pair
-- per class over a `reverseL`-ed list and the wording names `e1` first.  The two orders
-- agree, term by term: the old list was `flatMap (cohImplsOfMid mid) prog` over the
-- driver's `modules` in dependency-first order; `ieRows` is built by `buildImplEnvGo`
-- over the same modules in ORDINAL order (which is that same order, offset by the
-- prelude at 0) and within a module by `implDeclFacts = flatMap implDeclFact prog`, in
-- decl order.  The one difference is the prelude, which `cohRowsOf True` removes
-- BEFORE the `reverseL` below — so the filtered list's head is the first user module,
-- which is exactly what the old list's head was.
globalCoherenceConflict : ImplEnv -> (Option String, Option String)
globalCoherenceConflict env = match cohScan CohSweepGlobal (reverseL (map cohImplOfRow (cohRowsOf True env)))
  CohScan hard soft => (map fst hard, map fst soft)

-- the USER decls a driver wants coherence-checked.  Set by single-file drivers
-- (check.mdk / typecheck_main.mdk / check_batch.mdk) to the desugared USER program
-- (NO prelude), so a user impl that overrides a prelude impl is not flagged.  []
-- (the golden/profile drivers and the no-runtime path) ⇒ checkToLines uses its own
-- prelude-free arg; checkToLinesWithRuntime runs no coherence (byte-identical).

-- exported so the single-file front-end drivers set the user boundary before check
export
setCoherenceUserDecls : List Decl -> Unit
setCoherenceUserDecls ds = driverState.value.coherenceUserDecls := ds

-- ── instance-`requires` impl-dict routing (Phase 83/84 single-level) ────────
-- One parametric impl that carries a `requires`: its head tag (the tycon eval
-- narrows by), the methods it defines (to disambiguate which impl a method site
-- picked), the head type pattern (matched against the call's concrete result mono
-- to recover the element type), and its requires constraints.
-- Fields: head tycon tag, defined method names, head type pattern, requires,
-- full impl type-args, and the INTERFACE this impl is for.  The iface field
-- disambiguates same-head impls: one type can carry several `requires`-bearing
-- impls at the same head tycon for DIFFERENT interfaces whose requires differ in
-- shape (e.g. `Applicative (VT e) requires Semigroup e` alongside
-- `Debug (VT e a) requires Debug e, Debug a`).  RKey element-dict routing must
-- pick the entry for the interface being dispatched, not merely the first by tag.
public export data ImplEntry =
  | ImplEntry String (List String) Ty (List Require) (List Ty) String

-- #148: the impl/key tables are keyed by head tycon TAG into a bucket of entries
-- kept in FORWARD declaration order (append; never re-sorted).  Every per-site
-- lookup filters `tag2 == tag` first, so it scans ONE bucket instead of the whole
-- impl universe — turning findImplEntry's O(impls) scan into O(bucket).  The
-- forward intra-bucket order is load-bearing for the RESIDUAL first-match consumer
-- (findImplEntry, the iface-unknown `""` fallback), so the earlier-declared of two
-- coherent siblings at the same head still wins there.  (#203: the element/requires
-- routers that USED to first-match this table — the former implDictRoutesIn /
-- argImplDictRoutesForGo — now select the most-specific impl over the graph-global
-- impl universe via `ieSelectRowByIface` (and `matchedEntry`, until B-2.1-d deleted it
-- along with `KeyBuckets`, the routers' prior source); forward order
-- still decides their tie-break when no unique min⊑ exists.)  This is NOT the coherence structure —
-- cohScan scans a separate reverseL-ed list; these buckets keep forward
-- order and coherence is not routed through them.
export type ImplBuckets = OrdMap (List ImplEntry)

-- the entries at head tycon [tag] (empty when no impl heads there), in declaration
-- order.  Shared by both bucket flavours (List ImplEntry / List KeyEntry).
bucketOf : String -> OrdMap (List a) -> List a
bucketOf tag buckets = fromOption [] (omLookup tag buckets)

-- build the table from the program's impls-with-requires (others need no dicts),
-- bucketed by head tycon tag with each bucket in forward declaration order.
buildImplTable : List Decl -> ImplBuckets
buildImplTable prog =
  omMapValues reverseL (bucketImplEntries (flatMap implEntryOf prog) omEmpty)

-- fold the flat, forward-ordered entry list into tag buckets by PREPENDING (O(1)
-- per entry, vs O(bucket) tail-append → O(k²) for k same-tag entries).  Each
-- bucket ends up in reverse declaration order; buildImplTable applies one
-- `reverseL` per bucket to restore declaration order (first-match semantics).
bucketImplEntries : List ImplEntry -> ImplBuckets -> ImplBuckets
bucketImplEntries [] acc = acc
bucketImplEntries ((ImplEntry tag ms hty reqs itys ifn)::rest) acc =
  let e = ImplEntry tag ms hty reqs itys ifn
  bucketImplEntries rest (omInsert tag (e :: bucketOf tag acc) acc)

implEntryOf : Decl -> List ImplEntry
implEntryOf (DAttrib _ d) = implEntryOf d
implEntryOf (DImpl { iface, tys, reqs, methods, ... }) = match reqs
  [] => []
  _ => implEntryFromTys iface tys reqs methods
implEntryOf _ = []

implEntryFromTys : String -> List Ty -> List Require -> List ImplMethod -> List ImplEntry
implEntryFromTys _ [] _ _ = []
implEntryFromTys iface (headTy::rest) reqs methods = match headTyconNameTy headTy
  Some tag => [
    ImplEntry tag (map implMethodNameTc methods) headTy reqs (headTy::rest) iface
  ]
  None => []

-- ⚠️ #1128 (F-3b) AUDIT — `implEntryFromTys`, `keyEntryOf` and `implHeadTagForIface`
-- all gate on a head projection answering `Some tag`, so all three DROP a fully-general
-- `impl C a`.  They were audited as a SET; only `keyEntryOf` was changed, deliberately:
--
-- ⚠️ THE THREE NO LONGER READ THE SAME PROJECTION (#1617/#1618).  `implEntryFromTys`
-- and `keyEntryOf` are dispatch registrars and read the projections that gained the
-- `TyFun` arm and the `TyEffect` peel (`headTyconNameTy` / `headTyconTy`);
-- `implHeadTagForIface` is an ACCEPTANCE census and reads `censusHeadNameTy`, which is
-- those projections as they were before that bite.  The `impl C a` argument below is
-- unaffected — a bare `TyVar` head answers `None` in all three — but do not re-derive
-- any of them from a sibling's projection.
--
--  • `keyEntryOf` / KeyBuckets WAS the registry every route selector read
--    (`matchedEntry`; since ARCH B-2.1-b2 the same shape is projected out of `IE`'s
--    rows via `keyEntryOfRow` for `ieSelectRowByIface`, and B-2.1-d deleted the
--    `KeyBuckets` selectors outright), so it is where the missing candidate
--    was actually costing a wrong answer.  Fixed.
--
--  • `implEntryFromTys` / ImplBuckets holds only requires-BEARING impls and is read
--    by `findImplEntry` (the iface-UNKNOWN `""` FIRST-MATCH fallback) and
--    `argImplDictRoutesFor`, each via `bucketOf tag` at the
--    GOAL's head.  (ARCH B-2.1-h moved the third reader, `implDefinesMethodAt`, onto
--    graph-global `IE` as `ieDefinesReqMethodAt` — it kept the requires-only filter,
--    so this bullet's argument still covers it, one substrate over.)  Registering a headless entry under `noneHeadTag` here without also
--    unioning those lookups is inert — nothing would ever look the bucket up — and
--    unioning them widens a FIRST-MATCH fallback, which is a different change with a
--    different failure mode.  It is also not NEEDED for a headless impl's own
--    `requires` to be discharged: that runs through `selectReqImpl` with the iface
--    known → `ieSelectRowByIface` over `IE` (was `selectImplEntryByIface` over
--    KeyBuckets until ARCH B-2.1-b2; the headless-bucket argument is unchanged,
--    because `ieHeadRows None` is that same partition), which returns the winner's own
--    `reqs`.  Verified end-to-end on a headless-impl-with-`requires` probe (a
--    `impl Tag a requires Dbg a` beside `impl Tag (Box Int)`), which went from
--    99/99/99 to the hand-derived 99/1007/1007 on run AND native build with only the
--    KeyBuckets change in place.
--
--  • `implHeadTagForIface` feeds ONLY `implHeadTagsForIface` → `routeUndeterminedTop`,
--    which counts an interface's impl HEADS to resolve an UNDETERMINED constraint:
--    one head → stamp it; two or more → `T-AMBIGUOUS-INSTANCE`.  Including headless
--    impls there changes an ACCEPT into a REJECT for the (headless + one concrete)
--    shape that today silently picks the concrete.  That may well be the right
--    answer under §3 — an undetermined goal with two candidate instances is
--    ambiguous — but it is an ACCEPTANCE NARROWING, and this stage is a bug fix.  The
--    narrowing arm of this arc is F-3c (#1155), which owns
--    `pickMostSpecificEntry`'s no-unique-minimum arm; this shape belongs on ITS
--    declared flip list, not smuggled in here.  Left unchanged, deliberately.
--
--    🚨 THIS BULLET WAS RIGHT AND WAS ALMOST OVERRUN SIX LINES AWAY.  #1617/#1618's
--    first cut gave the SHARED projection an arrow arm and an effect peel, which
--    reached this census through `headTyconNameTy` and narrowed acceptance for
--    exactly the reason written above — measured on both arms, `impl C Int` beside
--    `impl C (Int -> Int)` or `impl C (<Stdout> Bool)` went from a stamped route to
--    exit 1.  The fix is `censusHeadNameTy` (see `headTyNode`'s 🚨).  A projection
--    with an acceptance reader and a routing reader is not one projection.
--
-- ⚠️ THERE IS A SECOND SET, and the audit above did not enumerate it — recorded here
-- so the next reader inherits it rather than re-deriving it.  The set above is the
-- REGISTRARS (who writes a bucket).  The set below is the READERS that index a single
-- head bucket DIRECTLY, without the headless union `ieCandidatesFor*` applies:
-- `ieImplExistsForHead`, `ieCountHeadByIface`/`ieHeadCollidesByIface` and
-- `ieCountHeadByMethod`/`ieHeadCollidesByMethod`.  (ARCH B-2.1-b2 moved these onto
-- `ieHeadRows` and B-2.1-d deleted their `KeyBuckets` predecessors
-- `implExistsForHead`/`countHead`/`headCollides` — a different population, the SAME
-- out-of-step-with-the-union shape.)
--
-- The sharp one is the METHOD-keyed count.  It is keyed on the method NAME, and the
-- headless bucket holds the headless impls of EVERY interface, while two interfaces
-- declaring the same method name are accepted.  ⚠️ SCOPE, narrowed 2026-08-15: that
-- premise is now false INTRA-module — Q1 (`ifaceMethodCollisions`,
-- compiler/frontend/resolve.mdk) rejects a module declaring two such interfaces.  It
-- remains TRUE ACROSS MODULES, which is what keeps this branch reachable, so this note
-- does NOT describe dead code.  Measured rather than argued: `ha.mdk`/`hb.mdk` each
-- exporting an interface declaring `hm` WITH A HEADLESS `impl HA a` / `impl HB a`, and an
-- entry importing the method name from one and the interface name from the other, is
-- ACCEPTED at exit 0 (prints 1).  Both headless impls are registered, so the count still
-- reaches 2 by the route below.  So a headless method count can reach 2,
-- the collision test fires, and `keyForSite` takes its CANONICAL-KEY branch with a
-- `__none__` winner — a branch that was UNREACHABLE before this change, because that
-- bucket was always empty.
--
-- 🚨 NEWLY REACHABLE, UNREPRODUCED.  This is not a defect claim: adversarial review
-- could not materialise one from it (the direct-call form is byte-identical, and the
-- dict-forwarding form is rejected identically by the base and patched binaries).
-- Do not "fix" it on the strength of this note — reproduce first, or leave it.
-- `keyForSiteByIface` is NOT exposed: it is iface-keyed, and at most one headless
-- impl per interface survives coherence.
implMethodNameTc : ImplMethod -> String
implMethodNameTc (ImplMethod n _ _) = n

-- ── TYPECHECK-AUDIT C7: canonical-impl-key registry ────────────────────────
-- One entry per USER impl (regardless of `requires`): the methods it defines (to
-- match a method site), its head tycon (to detect a head-tag collision), its
-- head-arg type pattern (matched against the site's concrete result mono), and its
-- canonical impl key.  Mirrors lib/typecheck.ml's `matching_impls` + `entry.impl_key`.
-- The route normally keeps the bare head tycon (the established head-tag dispatch
-- the native Core-IR/LLVM backend keys symbols by); it is UPGRADED to the full
-- canonical key ONLY when two impls share that head tycon for the method (the C7
-- case, e.g. Pair Int Bool vs Pair Bool Int).  This keeps every single-impl-per-head
-- site — i.e. all existing code and the native backend — byte-identical, while
-- letting eval's narrowMethod pick the right VTypedImpl by its key field when the
-- heads genuinely collide.
-- #203: the last three fields (iface, full impl type-args, requires) were added so
-- this ALL-impls registry (every user impl, requires-bearing or not) can serve as the
-- single most-specific-wins selector for EVERY resolution position (§6 uniform
-- resolution).  ImplBuckets OMITS no-requires impls, so it cannot see the specific
-- `List Int` sibling next to a general `List a`; KeyBuckets carries every impl plus its
-- requires, so `ieSelectRowByIface` / `ieSelectRowByMethod` return the min⊑ winner's OWN
-- requires ([] for a no-requires specific impl — never the general sibling's).
-- #1128 (F-3b): the trailing Int is the entry's DECLARATION INDEX — its position in
-- the flat, forward-ordered entry list this table was built from.  It exists for one
-- reason: a fully-general `impl C a` has NO head tycon, so it buckets under
-- `noneHeadTag` rather than beside its concrete siblings, and every goal-head lookup
-- must now UNION two buckets.  A bare `bucketOf tag ++ bucketOf noneHeadTag` would
-- make "concrete always first" the tie-break `pickMostSpecificEntry` falls back on
-- when no unique min⊑ exists — i.e. an arbitrary internal constant, invisible to the
-- declaration-order permutation differential (which permutes SOURCE order and leaves
-- bucket order untouched, so both permutations agree and the row passes either way).
-- With the index the union is a stable merge on declaration order, which is the
-- tie-break the rest of this file already documents AND the one that gate can see.
-- A-2.2b (#1111): the second field is the entry's PROJECTED HEAD, not its head
-- tycon NAME.  `keyEntryOf` already computed a `HeadKey` (A-2.2) and threw it
-- away with `headKeyNameOr noneHeadTag`; keeping it is what lets this registry
-- be keyed by the head's IDENTITY instead of its spelling, so two same-named
-- types declared in two modules no longer share a bucket.
--
-- ⚠️ THE ROUTE WORD IS STILL A BARE NAME AND MUST STAY ONE.  `keyForSite` /
-- `keyForSiteByIface` hand this field's `headKeyNameOr noneHeadTag` projection
-- to the dict cell, and `core_ir_lower.declRouteKey` derives the impl's own
-- word the same way — the two must agree word for word or the dict skew is
-- live on the RDict path.  Re-keying the TABLE and renaming the emitted SYMBOL
-- are different changes; the second is #1113's.
public export data KeyEntry =
  | KeyEntry (List String) (Option HeadKey) Ty String String (List Ty) (List Require) Int

-- the entry's declaration index (see KeyEntry).
keyEntryIdx : KeyEntry -> Int
keyEntryIdx (KeyEntry _ _ _ _ _ _ _ i) = i

-- 🚨 THE `noneHeadTag` SENTINEL IS NO LONGER A BUCKET NAME — "this impl has no
-- head type constructor" is spelled STRUCTURALLY, as an EMPTY identity block.
-- That is the one place this unit strictly strengthens the table rather than
-- restructuring it: a reserved NAME can be forged by a head that spells it; an
-- empty identity block cannot be produced by any head at all, because every head
-- contributes exactly one `TabKey`.
--
-- ⚠️ WHAT THAT BOUGHT, recorded here because the selector it retired is gone (ARCH
-- B-2.1-d deleted `candidateBucket`, which carried this derivation).  A goal-head
-- bucket could once EQUAL the headless bucket, so the head-plus-headless union had to
-- carry an explicit `tag == noneHeadTag` guard against merging the headless bucket with
-- ITSELF and silently doubling every candidate.  That was live, not defensive:
-- `paramMonoOf` synthesises a head from a TYPE-PARAMETER NAME for any param an
-- occurrence leaves unbound, and `__none__` lexes as a legal type VARIABLE — `data
-- __none__ = N` is a parse error, but `impl Q __none__ where …` type-checks at exit 0,
-- so an interface declared `Ix __none__ e` put the sentinel at `goals[0]`.  The guard's
-- PRECONDITION is now UNREPRESENTABLE: the headless key is `headlessBucketKey`, an
-- EMPTY identity block, while a goal's key is exactly ONE `TabKey` whatever the head is,
-- and `regKeyRender` count-prefixes the block — so a one-element block can never render
-- as a zero-element one.  A `__none__`-spelled head now names the (empty) bucket of a
-- head that happens to be spelled `__none__`.  ⚠️ Do NOT read this as "the guard was
-- defensive after all"; what retires it is that ABSENCE stopped being spelled as a
-- reserved NAME.  A rigid is still keyed by its spelling here (`dispHeadTab`), so the §8
-- I6.1 residual is untouched.
--
-- ⚠️ `noneHeadTag` itself is NOT retired, and must not be: it is still the ROUTE
-- WORD a headless winner stamps (`keyForSite`), which `core_ir_lower.declRouteKey`,
-- `eval.mdk`, `llvm_emit.mdk` and `wasm_emit.mdk` each derive independently.  The
-- TABLE key moved; the emitted symbol did not.
-- ARCH B-2.1-a3: the key `IE`'s head-keyed index (`ieFileRowByHead`, which files
-- into a `MultiRegistry`) mints from a head — the SAME partition the retired
-- KeyBuckets table used to mint via `regKeyRender (headBucketKey hd)`.
headBucketKey : Option HeadKey -> RegKey
headBucketKey None = headlessBucketKey
headBucketKey (Some hk) = regKeyOfTab (dispHeadTab hk)

-- The key of the bucket holding the fully-general (`impl C a`) entries.
headlessBucketKey : RegKey
headlessBucketKey = regKeyNTab []

-- the canonical impl key.  B-2.2-e: no longer a mirror of eval.mdk's `implKeyOf`
-- — it IS that function (`route_key.implRouteKeyWord`), reached from both sides of
-- the seam.  ⚠️ B-2.2-b1: this spelling passes `OriginUnresolved`, i.e. the BARE
-- interface name, and it is the mint for exactly ONE thing: `KeyEntry`'s 4th field,
-- written by `keyEntryOfRow` and READ BY NOBODY (measured, not grepped:
-- replacing the word at both sites with a literal `"__DEAD__"` builds, passes
-- `make check-self` and passes all 163 assertions of
-- `test/diff_compiler_dict_semantics.sh`).  The LIVE route words — the ones that
-- reach a dict cell and an emitted symbol — are minted at `keyForSite` /
-- `keyForSiteByIface` from the winning ROW's own `irOrigin`, so they carry the
-- interface's identity and this one does not.  Do not "unify" them without first
-- giving that field a reader.
implKeyTc : String -> List Ty -> String
implKeyTc iface tys = implRouteKeyWord OriginUnresolved iface tys None

-- the canonical key to stamp for the impl of [name] matching the ground result
-- mono — but ONLY when another impl of the same method shares its head tycon (so
-- bare-head routing is ambiguous).  No collision (the common case) or no match →
-- None → the caller keeps the head tag, behaviour unchanged.
-- #609: [goals] is the interface's FULL param-mono vector `τ̄` at this site
-- (recovered by ifaceParamMonos), or the singleton [resultMono] when the caller
-- has no vector — see entryHeadMatches for the fallback.
-- #1128 (F-3b): the `else` arm was `None` — "no collision ⇒ the caller keeps the
-- GOAL's head tag".  That is only sound while the winner's head IS the goal's head,
-- which held by construction while every entry came out of `bucketOf (goalHeadCon
-- goals)`.  Once the headless bucket is unioned in, a `noneHeadTag` winner reaches
-- here and `None` threw it away one line later: `entailInst`'s `fromOption tag (…)`
-- fell back to the goal's head tycon and called the CONCRETE sibling — which is why
-- registering and unioning the general impl, on their own, changed nothing
-- observable (proved twice, two independent agents, both probes inert).
--
-- So the arm now returns the WINNER'S OWN route key rather than declining to speak.
--
-- ⚠️ DO NOT READ THIS AS "byte-identical at every pre-existing site".  An earlier
-- revision of this comment said exactly that, "BY CONSTRUCTION, not by measurement",
-- and it is FALSE — three pre-existing fixtures emit DIFFERENT IR under this change:
-- `test/engine_fixtures/general_instance_overlap.mdk` (three 1-word dict constants
-- become two) and `general_beats_default.mdk` / `default_when_omitted.mdk` (4 lines
-- each).  `useSz True` / `useSz "hi"` now carry the general instance's route word
-- instead of their goal's head tag.  That is the fix WORKING — the dict word names
-- the instance actually selected — but it is an IR change, and a claim of byte
-- identity would have made the next person dismiss a real diff as impossible.
--
-- What IS true by construction is narrower, and it is only about a NON-HEADLESS
-- winner: the candidate scan only ever yields entries from the goal head's own bucket
-- (whose members all carry `tag2 == tag`) or from the headless bucket, so a non-headless
-- winner's `tag` IS the `tag` the caller was about to fall back to, and `Some tag`
-- is that fallback spelled out.  The collision branch is untouched.  Every site whose
-- winner has a head tycon is therefore unmoved; the three fixtures above are the
-- sites whose winner is HEADLESS, which is the whole point of the change.
--
-- ⚠️ And BEHAVIOUR surviving that IR change is EMPIRICAL, not structural.  🚨 THIS
-- PARAGRAPH USED TO NAME THE WRONG TIER — *"it rests on `emitGeneralRKey` →
-- `findByTag noneHeadTag`"* — and that claim was relayed through two design
-- documents before anyone built it (RUN-P3-013).  MEASURED: a `Some noneHeadTag`
-- word is a DIRECT HIT, because the general impl is itself registered under
-- `__none__` (`call @mdk_impl___none___sz`), so `emitMethod`'s `implFor` arm
-- catches those three fixtures and `emitGeneralRKey` — the tier that used to be
-- needed, before F-3b moved the word — is not reached from here at all.  The tier
-- that DOES depend on this function is the one below it, `emitDefaultRKey`, and it
-- is reached from the `None` arm, not from here: `mdk_default_<method>_<TAG>` is
-- keyed on the `<TAG>` that `fromOption tag` supplies at the caller.  That is why
-- the `None` arm must keep the concrete head tag (see its own comment).
--
-- ⇒ `fromOption tag` is NOT a hedge over a selector result.  At the sites where it
-- fires it is the ONLY source of that TAG — nothing downstream re-derives one — so
-- deleting it breaks every cross-module method-less impl inheriting an interface
-- default.  And read a green suite here accordingly: it is evidence about the
-- DEFAULT tier, not about the route word.
--
-- The key/tag split deliberately mirrors `core_ir_lower.declRouteKey` (bare head when
-- that head is unique among the interface's declared impls, canonical full-type key
-- otherwise): the typechecker stamps this word into the caller's dict cell and the
-- emitter derives the impl's own from `declRouteKey`, so the two must agree word for
-- word.  Returning the canonical key for a UNIQUE headless head would have stamped
-- `Tag|a|` where the emitter computes `__none__` — a dict-word skew invisible on the
-- direct-call path this fixture exercises and live on the RDict path.
-- (Retiring `fromOption tag (…)` outright — B-2/#1113's end state, where the route
-- IS the selected instance's identity with no head-tag hedge at all — additionally
-- renames every single-impl-per-head symbol in the tree, which moves the seed and
-- every golden.  That is #1113's change, not this one; what F-3b needs is only that
-- the route stop LYING about the selected instance, and `Some tag` does that.)
-- 🚨 ARCH B-2.1-g: THE METHOD-KEYED ROUTE WORD IS NOW GRAPH-GLOBAL, and its
-- `KeyBuckets` parameter is GONE rather than ignored (an ignored table parameter
-- reads as "still consulted" at every call site — `keyForSiteByIface`'s precedent).
-- This is entry point 2's word half: selection through `ieSelectRowByMethod` and the
-- collision retest through `ieHeadCollidesByMethod`, both over
-- `perRun.bodyImplEnvRef` — the SAME substrate, so the word and the impl the checker
-- actually dispatches to can no longer be derived from two different populations.
--
-- WHY IT HAD TO MOVE, and it is not a tidiness point.  `B-2.1-b2` moved the three
-- SELECTION legs onto `IE` and left this word on the topological prefix table by
-- design (AM-1).  MEASURED, that split is a miscompile: the prefix at the goal's
-- module held NO impl at head `Wrap`, so `headCollides` was False and a BARE word
-- `Wrap` was stamped, while the emitter — which counts the whole program
-- (`core_ir_lower.ifaceDeclHeadUnique`) — found TWO impls at that head and resolved
-- the bare word by declaration order to the GENERAL, `requires`-carrying one.  The
-- site then emitted `call @mdk_impl_Tag__Wrap_a___tagOf(i64 %t2)`: an arity-2 define
-- called with ONE argument, the value cell landing in the dict slot.  `check` 0,
-- `build` 0, built binary **139** (`SA-4c`, RUN-B-031/032).  `B-2.1-f` made that
-- LOUD with `T-ROUTE-WORD-AMBIGUOUS` — a deliberate false-reject widening, standing
-- in for this repoint until it could be made — and this bite is the repoint, so that
-- guard became UNREACHABLE by construction (the two counts it compared are now one
-- count) and ARCH B-2.1-d deleted it with the rest of the prefix-table read side; the
-- history it carried is kept above `ieCountHeadByMethod`.
--
-- The word is a NAME three engines re-derive independently
-- (`core_ir_lower.declRouteKey`/`ifaceDeclHeadUnique`, `llvm_emit.headTagUnique`/
-- `distinctKeysAtHead`, `eval.pickTagFallback`), all three graph-globally — so this
-- change makes the checker AGREE with them rather than teaching them a new word.  It
-- does change which word is stamped wherever prefix and graph disagreed, i.e. it
-- CHANGES EMITTED IR; the fixpoint is the authority on that.
--
-- 🚨 THIS FUNCTION IS ELABORATE-ONLY, AND `medaka check` CANNOT SEE ANY DIAGNOSTIC
-- PUSHED FROM HERE.  Nothing is pushed from here today, so nothing is currently hidden
-- — but the split is STRUCTURAL and unfixed, so a future diagnostic added here would be
-- silently invisible to `check`.  Derived rather than guessed, two independent reasons,
-- either alone sufficient:
--  1. `keyForSite` is reached ONLY from the five `resolve*` stamp passes, and those run
--     in `elabModuleStamp`, i.e. inside `elaborateModules`.  `medaka check` on a
--     multi-module project goes `analyzeProject` → `typecheckPass` → `checkModulesDiags`
--     → `checkModuleFullDiags`, which typechecks and never stamps a route.  (Door 4's
--     two guards DO reach `check` because they fire during typecheck proper, in the
--     obligation channel.)
--  2. Even given the pass, there would be nothing to stamp: the pending route sites are
--     recorded by `inferMethodAt`, which only ever sees an `EMethodAt` node — and those
--     are minted by the MARK pass (`markModules`/`prePassDict`), also called only from
--     `elaborateModules`.  The check driver's method occurrences go through
--     `inferVarPlainId`, so `pendingSites`/`pendingArgStamps` are EMPTY on that path.
--     An audit at the tail of `checkBodyImpl` (the one function both drivers share) was
--     written, built and measured for exactly this: it is INERT, for this reason, and
--     was removed rather than left in place claiming to do something.
-- ⚠️ The check route DOES run `elaborateModules` once — inside `mainShapeWarnings`
-- (`driver/medaka_cli.mdk`, the `checkRoute` multi-module arm) — and DISCARDS its type
-- errors, keeping only warnings.  That is the same family as #1362, and it is the
-- cheapest-looking fix and the wrong one for a single bite: surfacing every
-- elaborate-only type error on the `check` route narrows acceptance for every program in
-- the tree.
keyForSite : String -> List Mono -> Option String
keyForSite name goals =
  let env = perRun.value.bodyImplEnvRef.value
  match ieSelectRowByMethod env name goals
    Some (ImplRow _ _ ir tys _ _) =>
      if ieHeadCollidesByMethod env name (univReceiverTag tys) then
        -- 🚨 B-2.2-b1: THE WORD NOW CARRIES THE WINNING ROW'S INTERFACE IDENTITY,
        -- `module::Iface` (`ir.irOrigin` is in hand here — `ImplRow`'s `IfaceRef`
        -- field carries the origin beside the name, so no selection work is added
        -- and the collision gate above is untouched).  Two same-spelled interfaces
        -- in two modules used to collapse onto one word (the #1047/#1265
        -- same-spelled-interface family — #1047 is CLOSED and #1265 records that
        -- only the interface-NAME half was fixed, leaving this word bare); they no
        -- longer do.  ⚠️ THIS IS NOT #1182: that bug is `ieCandidatesForMethod`'s
        -- interface-free candidate key, UPSTREAM of this word, and on its own
        -- one-file repro this substitution is a NO-OP (absent origin ⇒ bare name).  The DEFINITION side mints the same word from the same
        -- function (`eval.declImplIfaceIdRow`/`implMethodEntry`,
        -- `core_ir_lower.ifaceImplHeadEntries`/`lowerImplMethod`), which is what
        -- keeps the dict cell and the emitted symbol byte-equal.
        -- ⚠️ On the loader-less drivers (`check <single file>`, lsp, repl, doc)
        -- the origin is absent and `ifaceWordOf` falls back to the bare name — the
        -- pre-bite word exactly.  That fallback is load-bearing; see `route_key`.
        Some (implRouteKeyWord ir.irOrigin ir.irName tys None)
      else
        -- A-2.2b: the ROUTE WORD, projected back to a bare name on purpose — see
        -- `KeyEntry`.  ⚠️ The collision TEST is still spelling-keyed, through
        -- `headTabOf`/`headTabEq` inside `ieCountHeadByMethod`, deliberately (see
        -- `ieCountHeadByIface` for the derivation): what the checker stamps into the dict
        -- cell has to keep matching `core_ir_lower.declRouteKey` byte for byte, and
        -- that consumer is a bare-`String` namespace.  What moved onto identity is
        -- the FIELD, not the comparison.
        Some (headKeyNameOr noneHeadTag (univReceiverTag tys))
    -- No impl anywhere in the graph defines [name] at this goal's head (or the goal
    -- has no head tycon at all, `ieSelectRowByMethod`'s `None => None` arm).  Every
    -- caller answers `None` with `fromOption tag (…)`, i.e. the bare goal-head tag —
    -- unchanged, and now genuinely safe: the graph agreeing there is no impl means
    -- there is no second impl for that bare word to name.
    None => None

-- the head tycon that buckets a goal vector: the spine head of its FIRST component
-- (the receiver).  Unchanged from the pre-#609 scalar bucketing — widening the
-- BUCKET key to the whole vector is exactly where a 14th `List`-as-a-map quadratic
-- would appear (compiler/AGENTS.md), and it buys nothing: two impls of one
-- interface that differ past arg 0 still share arg 0's tycon, so they must land in
-- the same bucket for the min⊑ comparison to see them at all.  The vector is
-- consulted by the MATCH (entryHeadMatches) and by ⊑ (entryCovers), both O(head
-- size) per bucket entry — a constant factor on an unchanged O(bucket) scan.
-- A-2.2b (#1111): `headTyconMono`, not the deleted `monoHeadCon` — so the GOAL
-- side of this table now carries the same `HeadKey` the IMPL side (`keyEntryOf`
-- via `headTyconTy`) does, and the two can be compared as identities instead of
-- as spellings.  Extensionally unchanged: the two projections had identical
-- arms (see `monoHeadCon`'s obituary above `mainTypeIsAsync`).
goalHeadCon : List Mono -> Option HeadKey
goalHeadCon (g::_) = headTyconMono g
goalHeadCon [] = None

-- stable merge of two entry lists on the declaration index.  Ties keep the LEFT
-- operand (the goal's own head bucket) first.
--
-- WHY A MERGE AND NOT `++`.  `pickMostSpecificEntry` falls back to the head of the
-- list when the matching set has no unique min⊑, so operand order is a SEMANTIC
-- tie-break.  Concatenating buckets would make that tie-break "concrete first"
-- irrespective of where the impls appear in the source — an arbitrary internal
-- constant, and one the declaration-order permutation differential
-- (diff_compiler_dict_semantics.sh §4) is STRUCTURALLY BLIND to, because it permutes
-- source order while bucket order stays put.  Merging on the declaration index makes
-- the tie-break DECLARATION ORDER, which is what the rest of this file documents as
-- the fallback and which that gate CAN see.
--
-- ⚠️ The PRECONDITION — both operands ascending by index — is a property of the
-- CALLER'S table, not of this function.  That is still worth stating, because it is
-- what makes a future violation possible; but it now holds at every call site, and
-- structurally rather than by convention.  ENUMERATED, since there are only two:
-- `ieCandidatesForIface` and `ieCandidatesForMethod`, both merging `ieHeadRows`
-- buckets whose index is `instRefSeq` — a WHOLE-GRAPH counter appended in build
-- order, so both operands are ascending BY CONSTRUCTION and the tie-break is
-- graph-global declaration order.
--
-- ⚠️ IT DID NOT ALWAYS HOLD, and the history is what stops it being reintroduced.
-- `universeKeyBucketsRef` violated it: `appendUniverseAccums` re-entered
-- `bucketKeyEntries` once per module with a NON-EMPTY accumulator, so the numbering
-- RESTARTED AT 0 within one table (indices duplicated) and each module's slice was
-- prepended, never reversed (descending).  ARCH B-2.1-b2 moved the selectors off that
-- table and B-2.1-d deleted it, along with `candidateBucket` — the head-plus-headless
-- union that was this function's third caller.  So no `KeyBuckets` value reaches this
-- function at all any more.  Re-adding a cumulative, non-`omEmpty`-seeded accumulator
-- (see `bucketKeyEntriesFrom`) is the one edit that would break the precondition again.
--
-- On an unsorted operand this still terminates and is still deterministic; it is only
-- the "= declaration order" claim that would fail.
mergeByDeclIdx : List KeyEntry -> List KeyEntry -> List KeyEntry
mergeByDeclIdx [] ys = ys
mergeByDeclIdx xs [] = xs
mergeByDeclIdx (x::xs) (y::ys)
  | keyEntryIdx x <= keyEntryIdx y = x :: mergeByDeclIdx xs (y::ys)
  | otherwise = y :: mergeByDeclIdx (x::xs) ys

-- §3 `inst` = `min⊑(match(IE, π))`: pick the entry strictly more specific than (or
-- equal to) every OTHER matching entry.
--
-- ⚠️ WHAT REACHES THE `None` ARM, since the prose here was wrong about it until
-- #1155 and the error is expensive in BOTH directions.  It said the arm covers "≤1
-- match, equal heads, or incomparable overlap".  Two of those three never get here:
-- `entryCovers` is `tyHeadEqV … || tyStrictlyMoreSpecificV …`, so a single match
-- covers ITSELF and two EQUAL heads cover EACH OTHER — both make
-- `entryCoversAllOthers` true and return `Some` (see `entryCoversAllOthers`' own
-- comment, "Equal-head entries are covered trivially").  The description was
-- outcome-equivalent while every arm produced a first-match result, and became
-- load-bearing the moment one of them became a REJECT: keyed to the prose, this
-- would hard-reject every duplicate-instance and user-overrides-prelude program.
-- **Only ⊑-INCOMPARABLE OVERLAP lands here** (confirmed on
-- test/typecheck_error_fixtures/overlapping_impls.mdk, whose equal heads stay silent).
--
-- #1155 (F-3c): that arm used to return `Some e` in silence, so DECLARATION ORDER
-- decided the program's meaning — swap two `impl` blocks and the answer changes, at
-- exit 0 on every engine (#1154, #1162).  It now also REPORTS, under the goal-site
-- half of §6 C1: at most one ⊑-minimal matching instance, quantified over the goals
-- `inst` decides rather than over ground goals.
--
-- The winner is still `Some e`, deliberately.  `recordTypeError` arms
-- `typeErrorsSticky`, so `check` reports and `run`/`build` abort — the program is
-- rejected either way — while every route this compile stamps stays byte-identical.
-- Returning `None` instead would ALSO move every route on the rejected path (RKey →
-- the caller's fallback), which changes emitted IR on a program nobody can run and
-- buys nothing.
--
-- ⚠️ F-3c CLOSES THIS ONLY PARTWAY, AND THE RESIDUE IS THE LIST-ORDER ONE.  The reject
-- is gated on the goal being CLOSED, because §6.2 T4 defers a goal still carrying an
-- unbound metavariable rather than deciding it.  At a NON-closed goal the fallback
-- below is still a SILENT head-of-list pick, so operand order can still decide an
-- answer there — which is why `mergeByDeclIdx`'s ascending precondition is load-bearing
-- and not bookkeeping.  Closing that residue is T4's own work (defer to quiescence),
-- not this selector's; DICT §11 forbids implementing T4 before I5.  If it is ever fixed
-- here instead, this is the comment to revisit.  (Recorded here by ARCH B-2.1-d: it
-- previously lived on `candidateBucket`, deleted with the prefix-table read side.)
pickMostSpecificEntry : List Mono -> List KeyEntry -> Option KeyEntry
pickMostSpecificEntry _ [] = None
pickMostSpecificEntry goals (e::rest) = match findMostSpecificEntry (e::rest) (e::rest)
  Some best => Some best
  None =>
    let _ = reportAmbiguousOverlap goals (e::rest)
    Some e

-- #1155: the goal-site `T-AMBIGUOUS-INSTANCE`, with the two gates that keep it from
-- over-rejecting.  [cands] is always ≥2 entries with no ⊑-minimum among them.
--
--  🚦 CLOSEDNESS (§6.2 T3/T4).  `inst` may commit only at a goal every variable of
--     which is ground or rigid; a goal still carrying an unbound METAVARIABLE is
--     DEFERRED, not decided (T4), and C1 explicitly declines to quantify over it —
--     "a C1 quantified over commitment sites would reject it, while T4 and T6 say it
--     is well-formed and that deferral is the whole point."  Committing there is a T3
--     violation, and this compiler does commit there (§11's T3/T4 row records it).
--     So rejecting there would convert a latent T3 violation into a USER-VISIBLE
--     over-rejection of a legal program — the reject would be caused by our own early
--     commitment.
--
--     🚨 THIS GATE FIRES.  It has NO USER-VISIBLE EFFECT today, which is a much
--     weaker statement, and F-3c shipped the stronger one by mistake for one
--     review round.  The false argument, recorded because it is seductive: for the
--     arm to see a goal open at argument i EVERY candidate must carry a bare
--     `TyVar` at i (`matchStep` MFails on a `TyCon`/`TyApp` pattern against an
--     unbound var, and `matchOneSided`'s `cohEqR` re-check MFails once that var was
--     bound to a structure); two USER impls meeting that condition necessarily have
--     UNIFYING heads; coherence condition (a) rejects a ⊑-incomparable unifying
--     pair AT THE DECLARATION.  Every step is true and the conclusion "so the goal
--     never reaches the selector" DOES NOT FOLLOW — **a declaration-time rejection
--     is not an early exit.**  Errors accumulate here by design (see
--     `diagnostics.mdk`), so both impls are still registered in the graph-global impl
--     universe and the goal still reaches this arm.  The counterexample was already sitting in this
--     stage's own flip list: `check_json_fixtures/conflicting_impl_overlap.mdk`
--     emits `T-CONFLICTING-IMPL` **and** this diagnostic on one file.
--
--     Pinned by `test/dict_fixtures/s6-2-t3-closed-goal-reported.mdk` and its
--     one-token sibling `…/s6-2-t4-open-goal-deferred.mdk`: same two impls, same
--     candidate set, same no-unique-minimum arm; the ground goal gets this
--     diagnostic and the open goal must NOT.  Their verdict, exit code and stdout
--     are IDENTICAL, so the gate is graded by a NEGATIVE code assertion — the only
--     observable that separates them.
--
--     ✅ **AS OF F-3d (#614/#311) THIS GATE DECIDES A VERDICT.**  Until then the
--     sentence here was: "no program in the tree exercises this gate, and every
--     program that reaches it is already rejected by coherence (a) anyway, so today
--     it changes no verdict" (measured: `check --json` AND `run` over all 2389
--     `.mdk`, each gate replaced by a probe diagnostic — zero firings).  F-3d
--     DEMOTED the (a) reject to a `W-INCOMPARABLE-IMPLS` warning — it did NOT delete
--     it, per the 2026-08-01 owner decision on #311 — so the declaration no longer
--     rejects anything on the ⊑-incomparable class, and this gate is now the whole
--     of the verdict at such a goal: closed ⇒ reject here, open ⇒ ACCEPT.  The
--     one-token pair `test/dict_fixtures/s6-2-t{3,4}-*.mdk` therefore discriminates
--     REJECT from ACCEPT, not just a diagnostic set.  Without the gate the open half
--     would be a spec-violating over-rejection of a legal program.
--     ⚠️ The other side of that coin, accepted knowingly: the open half now
--     COMMITS to the head of the candidate list at exit 0, so declaration order
--     decides its value (it prints `1`; swap the two `impl` blocks and it prints
--     `2`), under a warning rather than in silence.  §6.2 T4's actual answer is to
--     DEFER such a goal to quiescence, which this compiler has no pass for; the
--     residue is pinned as a KNOWN-BAD row in
--     `test/diff_compiler_dict_semantics.sh` §4 and tracked at #1183.
--
--  🚦 ONE INTERFACE.  `ieEntriesForMethod` used to filter by METHOD NAME alone, so
--     two impls of two DIFFERENT interfaces that happen to share a method name could
--     arrive together.  Their head vectors are ⊑-incomparable for a reason that has
--     nothing to do with overlap, and §6 C1 is a condition on the instances of ONE
--     class (`match(IE, C τ̄)`).  Selecting across that set is a candidate-set
--     DEFORMATION of the method-keyed path, not an ambiguous program, so reporting
--     it as ambiguity would be the wrong message.  (The iface-keyed caller
--     `ieEntriesForIface` cannot produce such a set, so the gate is a no-op
--     there.)
--
--     🚨 #1182 HAS LANDED, AND THIS GATE IS *STILL NOT DELETABLE*.  The bug it was
--     declining to report is fixed — `ieEntriesForMethod` now admits on the
--     ADMITTED DECLARATION as well as the spelling — and the pinned repro
--     (`test/must_fail_fixtures/1182-two-ifaces-same-method-name-order-decides`)
--     drained: both impl-block orderings now answer `1` on `run` AND on the built
--     binary.  What is NOT true is the tempting corollary "every candidate set now
--     shares one interface by construction".  DERIVED, not assumed:
--       * on the `Some iface` arm the corollary HOLDS.  `ieRowAdmittedBy` →
--         `ieRowIfaceMatches` → `sameTyConHead n1 o1 n2 o2 = n1 == n2 && …`, so every
--         admitted row carries `ir.irName == iface.irName`; `keyEntryOfRow` writes
--         exactly that `ir.irName` into the `KeyEntry` field `keyEntryIface` reads.
--         Two admitted rows therefore cannot disagree, and `candsOneIface` is `Some`.
--       * on the `None` arm it DOES NOT.  `ieRowAdmittedBy _ None = True` is the
--         deliberate fall-back to the bare-name answer for a `methodIfaceParamsRef`
--         miss (its own doc-comment owns that derivation, and answering `False`
--         there would be a routing change, not a conservative one).  On that arm the
--         scan is byte-for-byte the pre-#1182 one, so a two-interface set is exactly
--         as constructible as it ever was.
--     ⇒ the disagree branch is NOT unreachable by construction; deleting it would
--     re-arm the wrong message on precisely the shape the fix does not reach.  It
--     stays.  What DID change is its extent: it can now only be reached through a
--     table miss, never through a scoped name.
--
-- ⚠️ NOT SUPPRESSED when the declaration-time coherence sweep already fired for the
-- same interface, and that was a considered call rather than an oversight.  The two
-- in-tree fixtures this arm newly reports on — check_json_fixtures/conflicting_impl_overlap
-- and dict_fixtures/s6-1c-incomparable-no-minimum-control — carry BOTH diagnostics.
-- They are two different RULES at two different SITES: the declaration-time one is
-- §6.1 condition (a) at the `impl`, and the corpus records it as an OVER-rejection
-- (its sibling s6-1c-per-goal-unique-min-rejected is a program the spec's condition
-- (c) accepts); this one is (c) at the goal.  The control fixture's own header says
-- both conditions reject it, so reporting both is the checker saying what it actually
-- did.  Suppressing would make this rule's extent depend on whether another rule
-- fired first — the implementation-relative extent §6 C1 rejects for its own
-- quantifier.  (The suppression was recommended on the premise that
-- `diff_compiler_dict_semantics.sh` §1 grades the FIRST code; it does not —
-- `grep -q '"code":"$code"'`, presence anywhere.  Verified.)
--
-- ⚠️ F-3d (#614/#311) changed the OTHER half of that pairing, and the earlier wording
-- here predicted it wrongly: it said F-3d "deletes (a)", so un-suppression would be
-- forced.  (a) was DEMOTED, not deleted — the companion diagnostic on both fixtures is
-- now a `W-INCOMPARABLE-IMPLS` WARNING, not `T-CONFLICTING-IMPL`.  The
-- non-suppression argument is unchanged, and the pairing improves ON THE `--json`
-- SURFACE ONLY: the two diagnostics now differ in SEVERITY, so a machine consumer
-- sees one error plus one advisory note about the declarations rather than two
-- same-severity errors with the same primary remedy printed out of source order (the
-- ERROR-QUALITY dim X/R cost F-3c accepted knowingly).  ⚠️ A HUMAN `medaka check` user
-- sees NO improvement, because they never saw the second diagnostic at all: the CLI's
-- error arm prints `filter isDiagError diags` and returns, so on any file with an
-- error the warnings are dropped — a pre-existing suppression this change neither
-- causes nor repairs.  Do not restate the improvement as general.
reportAmbiguousOverlap : List Mono -> List KeyEntry -> Unit
reportAmbiguousOverlap goals cands
  | not (goalsClosed goals) = ()
  | otherwise = match candsOneIface cands
    None => ()
    Some iface => pushTypeErrorOnceAt "T-AMBIGUOUS-INSTANCE" !goalSiteLoc (ambiguousOverlapMsg iface goals cands)

-- §6.2 T3's "closed": every variable of the goal is *"either quantified by the scheme
-- just produced or already ground"* — the ground goals PLUS the rigid-variable ones.
--
-- 🚨 `isEmptyL (flatMap monoUnboundIds goals)` is the WRONG test and it silently costs
-- #1155 its whole rigid half.  A rigid signature variable is NOT reified to a `TCon`
-- here: `firstRow : List (List a) -> List a` still carries `a` as an UNBOUND `TVar`
-- when the post-HM resolvers run (verified — under the unbound-ids test the #1155
-- rigid fixture is classified non-closed and the reject never fires).  The
-- rigid-vs-undetermined distinction is not visible in the `Mono` at all; it lives in
-- whether some enclosing scheme QUANTIFIED that id, which is exactly what
-- `deferrableVarIds` records (`schemeIds` at each generalized group close).  Same
-- test `checkUndeterminedObligation`'s RULE 2 uses, for the same reason.
--
-- Conservative in the safe direction: a var recorded outside any generalized-group-
-- close window is in NEITHER set (see checkCallObligations' #838 I4 note), so it reads
-- as non-closed and this diagnostic stays silent rather than over-rejecting.
--
-- ⚠️ One deliberate imprecision, so nobody has to spot it twice: T3 says "quantified
-- by the scheme JUST PRODUCED", whereas `deferrableVarIds` is a RUN-GLOBAL
-- accumulation over every scheme closed so far in this module.  That is a strictly
-- WIDER set than T3 names.  The two coincide in practice because tyvar ids are unique
-- per run, so a var quantified by some other binding's scheme cannot also be free in
-- this goal — but the coincidence is a property of id allocation, not of the test, and
-- it would stop holding if ids were ever recycled.
goalsClosed : List Mono -> Bool
goalsClosed goals = allList
  (i => containsI i perRun.value.deferrableVarIds.value)
  (flatMap monoUnboundIds goals)

-- the ONE interface all candidates implement, or None if they disagree (see the
-- second gate on reportAmbiguousOverlap).
candsOneIface : List KeyEntry -> Option String
candsOneIface [] = None
candsOneIface ((KeyEntry _ _ _ _ ifn _ _ _)::rest) =
  if allList (e => keyEntryIface e == ifn) rest then
    Some ifn
  else
    None

keyEntryIface : KeyEntry -> String
keyEntryIface (KeyEntry _ _ _ _ ifn _ _ _) = ifn

-- #1155: names the GOAL and every competing impl head.  `ambiguousImplMsg` — the
-- undetermined-VARIABLE reject, a different situation — names only the interface,
-- which here would leave the reader no way to find the impls that collided
-- (ERROR-QUALITY §1: "in the user's vocabulary", "actionable").  The goal's monos are
-- rendered through ONE shared naming context so a variable occurring in two argument
-- positions prints as the same letter, exactly as `cohOverlapMsg` does for the
-- declaration-time conflict.
--
-- ⚠️ ARITY-NEUTRAL WORDING, and it was NOT at first.  THREE mutually ⊑-incomparable
-- impls are constructible today (`C (T Int b c)` / `C (T a Int c)` / `C (T a b Int)`),
-- and the original text — `joinWith " and "`, then "neither … the other", then "make
-- these two disjoint" — rendered "matches A and B and C, and NEITHER is more specific
-- than the other … make THESE TWO disjoint" on it.  Every count-bearing word here is
-- now either derived from `listLen cands` or absent.
--
-- ⚠️ The last remedy clause exists because A COMPETING IMPL MAY NOT BE THE USER'S.
-- The flagship #1155 fixture collides a user impl with `stdlib/core.mdk`'s
-- `impl Index (List a) Int a`, where "make them disjoint" is not an action the reader
-- can take.  The message cannot SAY which one is the prelude's — `KeyEntry` carries no
-- module id and adding one re-signs the whole registry — so it names the one remedy
-- that always works instead of implying the reader owns both.
ambiguousOverlapMsg : String -> List Mono -> List KeyEntry -> String
ambiguousOverlapMsg iface goals cands = "Ambiguous instance for `\{iface}`. The goal `\{iface} \{ppPredArgsShared goals}` matches \{joinAnd (map (implHeadLabel iface) cands)}, and \{noMinimumClause (listLen cands)}. Overlapping impls are allowed only when one of them is more specific than every other match — make them disjoint, or add an impl more specific than all of them. If one of these is a prelude or imported impl you cannot edit, annotate this expression to a type only one of them matches"

-- "neither is more specific than the other" reads better than the general form at the
-- overwhelmingly common arity, and presupposes exactly two, so it is gated on two.
noMinimumClause : Int -> String
noMinimumClause n
  | n == 2 = "neither is more specific than the other"
  | otherwise = "none of them is more specific than all the others"

-- "A", "A and B", "A, B and C" — `joinWith " and "` gives "A and B and C" at n>=3.
joinAnd : List String -> String
joinAnd [] = ""
joinAnd [x] = x
joinAnd [x, y] = "\{x} and \{y}"
joinAnd (x::rest) = "\{x}, \{joinAnd rest}"

implHeadLabel : String -> KeyEntry -> String
implHeadLabel iface (KeyEntry _ _ _ _ _ itys _ _) =
  "`impl \{iface} \{joinWith " " (map ppTyAtom itys)}`"

-- render a PREDICATE's argument vector against one shared naming ctx, at ARGUMENT
-- precedence — so `List a` in an argument slot prints as `(List a)`.
-- ⚠️ NOT `ppMonosShared`, and not a candidate for merging with it: that one renders
-- the dispatch monos at prec 2, where `wrapIf (prec > 2)` leaves an application
-- BARE.  For a predicate whose arguments are themselves applications that is
-- ambiguous — `Index List a Int a` reads as either a 3-argument or a 5-argument
-- predicate — and the whole value of naming the goal is that the reader can match it
-- against the impl heads printed beside it.  `cohPpEach` (prec 0) has the same
-- problem.  Same shared-naming-context discipline as both, one precedence up.
ppPredArgsShared : List Mono -> String
ppPredArgsShared ms = joinWith " " (ppEach (Ref []) (Ref 0) 3 ms)

findMostSpecificEntry : List KeyEntry -> List KeyEntry -> Option KeyEntry
findMostSpecificEntry [] _ = None
findMostSpecificEntry (c::cs) all
  | entryCoversAllOthers c all = Some c
  | otherwise = findMostSpecificEntry cs all

-- is [cand]'s head pattern more specific than (or structurally equal to) every
-- entry in [all]?  Equal-head entries are covered trivially; a genuinely more-
-- general entry is NOT covered, so [cand] is rejected for it.
entryCoversAllOthers : KeyEntry -> List KeyEntry -> Bool
entryCoversAllOthers cand all = allList (entryCovers cand) all

-- #609: compares the entries' FULL head vectors (`itys`), not their arg-0 head
-- patterns.  Arg-0-only made `Ix Int Bool` and `Ix Int Char` mutually "tyHeadEq" —
-- ⊑-EQUAL, hence no unique min⊑ — so pickMostSpecificEntry fell to first-match and
-- DECLARATION ORDER decided the program's meaning.  For a single-param impl
-- `itys == [candTy]`, so this reduces to the old two lines algebraically (see
-- tySubsumesV).
entryCovers : KeyEntry -> KeyEntry -> Bool
entryCovers (KeyEntry _ _ _ _ _ candTys _ _) (KeyEntry _ _ _ _ _ otherTys _ _) = tyHeadEqV candTys otherTys || tyStrictlyMoreSpecificV candTys otherTys

-- ── #609: specificity over head VECTORS (DICT-SEMANTICS §3) ─────────────────
-- §3 defines a predicate as a class applied to a VECTOR (`π ::= C τ̄`) and
-- specificity as `I_A ⊑ I_B iff ∃σ. σ(C B̄) = C Ā` — ONE substitution σ matching
-- the WHOLE vector at once, NOT per-argument subsumption.  Per-argument would be a
-- plausible-looking wrong answer: it cannot see that a var bound in two argument
-- positions must receive the SAME type, so `Ix a a` would "subsume" `Ix Int Bool`.
-- Matching one worklist of pairs through matchOneSided is exactly σ: the shared
-- core binds each general-side TyVar once and re-checks (tyStructEq) every later
-- occurrence, so a non-linear pattern is only subsumed by a consistent instance.
-- Direction, as in the superseded scalar `tySubsumes`: is [specifics] an instance of
-- [generals]?  Only the GENERAL side's TyVars act as wildcards; the SPECIFIC side's
-- are rigid and match only the same name.  Mirrors lib/typecheck.ml's `subsumes`.
--
-- ⚠️ n=1 reduction is ALGEBRAIC, not a fixture claim: a KeyEntry's `itys` for a
-- single-param impl is exactly `[hty]` (keyEntryOfRow destructures `tys` as `headTy::_`
-- and stores the SAME `tys` as itys — `keyEntryOf`'s deleted predecessor did the same),
-- and `zipL [g] [s] == [(g, s)]`, so
--     tySubsumesV [g] [s] == matchOneSided tyStep eqStr tyStructEq [(g, s)] []
-- which is the REMOVED `tySubsumes g s` body term for term.  Every single-param
-- decision is therefore unchanged by construction, not by fixture census.  A length
-- mismatch is not a match (no σ can equate vectors of different arity); it is
-- unreachable between two impls of ONE interface, which share that interface's arity.
tySubsumesV : List Ty -> List Ty -> Bool
tySubsumesV generals specifics
  | listLen generals /= listLen specifics = False
  | otherwise =
    isSome (matchOneSided tyStep eqStr tyStructEq (zipL generals specifics) [])

-- the two head VECTORS are the SAME pattern up to var renaming (mutual subsumption)
-- — no ordering needed, the candidate trivially covers it.  Supersedes the scalar
-- `tyHeadEq`, which compared arg-0 patterns only.
tyHeadEqV : List Ty -> List Ty -> Bool
tyHeadEqV a b = tySubsumesV a b && tySubsumesV b a

-- [a] ⊑ [b] strictly: [b]'s vector subsumes [a]'s but not vice versa.  Supersedes
-- the scalar `tyStrictlyMoreSpecific`.
tyStrictlyMoreSpecificV : List Ty -> List Ty -> Bool
tyStrictlyMoreSpecificV a b = tySubsumesV b a && not (tySubsumesV a b)

-- AST-space step: rigid structural, NO normalize (raw AST patterns).  A TyEffect/
-- TyConstrained wrapper on the general side is transparent — recurse into its body
-- with the specific side's own wrappers stripped (stripTyWrap), preserving the old
-- tySubsumeGo behaviour.  Exhaustive over every `Ty` constructor (ast.mdk), so
-- no catch-all — a new constructor must add an arm here, not rely on a
-- wildcard (a hand-maintained count here would rot; see `TyRow`'s own arm
-- below for why: a bare row atom has no wrapped type to recurse into, so it
-- vacuously matches anything in this position).
tyStep : Ty -> Ty -> MStep String Ty Ty
tyStep (TyVar gn) _ = MVar gn
tyStep (TyCon { tyConName = a }) (TyCon { tyConName = b }) =
  if a == b then
    MOk
  else
    MFail
tyStep (TyCon { tyConName = _ }) _ = MFail
tyStep (TyApp f1 a1) (TyApp f2 a2) = MKids [(f1, f2), (a1, a2)]
tyStep (TyApp _ _) _ = MFail
tyStep (TyFun a1 b1) (TyFun a2 b2) = MKids [(a1, a2), (b1, b2)]
tyStep (TyFun _ _) _ = MFail
tyStep (TyTuple ts1) (TyTuple ts2) =
  if listLen ts1 == listLen ts2 then
    MKids (zipL ts1 ts2)
  else
    MFail
tyStep (TyTuple _) _ = MFail
tyStep (TyEffect _ _ t1) s = MKids [(t1, stripTyWrap s)]
tyStep (TyConstrained _ t1) s = MKids [(t1, stripTyWrap s)]
-- Same "rows are transparent" treatment used throughout this specificity
-- engine (a `TyEffect`'s row never participates — only its wrapped type
-- does). A bare row atom has no wrapped type to recurse into, so it
-- vacuously matches anything in this position.
tyStep (TyRow _ _ _) _ = MOk

eqStr : String -> String -> Bool
eqStr a b = a == b

stripTyWrap : Ty -> Ty
stripTyWrap (TyEffect _ _ t) = stripTyWrap t
stripTyWrap (TyConstrained _ t) = stripTyWrap t
stripTyWrap t = t

-- structural equality of two AST type patterns (rigid; TyVar names must match).
tyStructEq : Ty -> Ty -> Bool
tyStructEq (TyCon { tyConName = a }) (TyCon { tyConName = b }) = a == b
tyStructEq (TyVar a) (TyVar b) = a == b
tyStructEq (TyApp f1 a1) (TyApp f2 a2) = tyStructEq f1 f2 && tyStructEq a1 a2
tyStructEq (TyFun a1 b1) (TyFun a2 b2) = tyStructEq a1 a2 && tyStructEq b1 b2
tyStructEq (TyTuple ts1) (TyTuple ts2) = tyStructEqList ts1 ts2
tyStructEq (TyEffect _ _ t1) (TyEffect _ _ t2) = tyStructEq t1 t2
tyStructEq (TyConstrained _ t1) (TyConstrained _ t2) = tyStructEq t1 t2
tyStructEq _ _ = False

tyStructEqList : List Ty -> List Ty -> Bool
tyStructEqList [] [] = True
tyStructEqList (t1::ts1) (t2::ts2) = tyStructEq t1 t2 && tyStructEqList ts1 ts2
tyStructEqList _ _ = False

-- ── ARCH B-2.1-b2 (Stage B sprint): SELECTION ON THE GRAPH-GLOBAL SUBSTRATE ──
-- 🚨 THE FOUR `…ByIface` VARIANTS THAT LIVED HERE ARE DELETED, AND THAT IS THE
-- BITE — not a tidy-up.  `selectImplEntryByIface` / `matchingEntriesByIface` /
-- `headCollidesByIface` / `countHeadByIface` read a TOPOLOGICAL PREFIX of the
-- program's impls (`shadowKeyTableRef` on the checker leg, `stampKeyTable` on the
-- router leg), so a goal whose impl sits in a topologically LATER module could not
-- see that impl at all — it recovered no `requires`, no dict was threaded, and the
-- site rejected with `T-REQUIRES-UNROUTED` or (worse) under-applied.  That is
-- #1564/#1599/#1072/#1560/#1182.  The three selection legs now read the
-- GRAPH-GLOBAL `IE` that `B-2.1-a2` seats on `perRun.bodyImplEnvRef` (ONE ref,
-- both driver arms), indexed by head ACROSS interfaces by `B-2.1-a3`
-- (`ieByHead` / `ieHeadRows`).  DICT §8 I5: "instance candidacy is graph-global;
-- import scoping filters NAMES, never instances."
--
-- 🚨 THE THREE LEGS, NAMED, BECAUSE MOVING TWO OF THEM PRODUCES AN S0.  Measured
-- (DECISIONS.md RUN-B-023): repointing only the checker and the router took
-- #1564's fixture from a LOUD located reject to `check` exit 0 with a
-- **SEGFAULTING binary** (139) — the checker discharged the `requires` so the impl
-- gained a dict param, while the METHOD-keyed element-route leg still selected off
-- the prefix and passed none.  A `keyForSite`-shaped fix is not enough and the
-- must-fail pin cannot see the difference (it grades `check`).
--   1. CHECKER — `concreteReqMatchByIface` (evidence for the obligation channel).
--   2. ROUTER  — `selectReqImpl` AND `keyForSiteByIface` **with its collision
--      retest**: `entailInst`'s `EKNestedTop` arm computes the same selection
--      twice (route word + `requires`) on the same iface and goal vector, so
--      moving one without the other is a §6 C2 break by construction.
--   3. METHOD-keyed — the element dicts at `implDictRoutesForFull` /
--      `argImplDictRoutesForEncl`, which used `matchedEntry` over the prefix
--      `stampKeyTable`.  ⚠️ At b2, `matchedEntry` / `matchingEntries` /
--      `candidateBucket` / `countHead` / `headCollides` / `keyForSite` were left LIVE
--      on that prefix table, serving the method-keyed ROUTE WORD whose only
--      prefix-vs-global difference is a head-collision COUNT.  That residual was
--      stated as a `nearest miss` in DEBT.md `B-2.1-b2` rather than moved then,
--      because moving it renames route words and moves the seed.  ⚠️ ALL OF THAT IS
--      HISTORY: `B-2.1-g` repointed `keyForSite` onto `bodyImplEnvRef` and `B-2.1-d`
--      DELETED the other five with the whole prefix-table read side.
--      🚨 ARCH B-2.1-f: THAT RESIDUAL IS NOT A NAMING SKEW, IT IS A MISCOMPILE — an
--      arity-2 conditional impl called with ONE argument, `check` exit 0 and the built
--      binary at 139 (`SA-4c`, `test/diff_compiler_check_cli_modules.sh`).  The route
--      word is still prefix-read here, by design; what changed is that the
--      disagreement is now a LOUD located reject (`T-ROUTE-WORD-AMBIGUOUS`) instead of
--      a silent wrong call.  ⚠️ HISTORY: that guard (`reportRouteWordSkew`) was a
--      deliberate FALSE-REJECT widening standing in for the repoint; `B-2.1-g` made the
--      repoint and `B-2.1-d` deleted the guard.  The route word is graph-global now —
--      see `keyForSite`, and `ieCountHeadByMethod` for the surviving count's history.
--
-- ⚠️ ONE min⊑ SELECTOR, NOT TWO.  DICT §11 / §6 *uniform resolution* forbids a
-- second one, so every entry point below funnels through the SAME
-- `pickMostSpecificEntry` — hence the same `entryCovers`, the same closed-goal
-- `T-AMBIGUOUS-INSTANCE` report, the same first-match fallback — by projecting
-- rows into the `KeyEntry` that selector already speaks.  `keyEntryOfRow` is that
-- projection, and A-3.7's `cohImplOfRow` is its precedent one consumer over.
--
-- ⚠️ THE DECLARATION INDEX IS `instRefSeq`, WHICH FIXES RUN-B-007's DEFECT BY
-- DELETION RATHER THAN BY REPAIR.  `mergeByDeclIdx` requires both operands
-- ASCENDING by index; the prefix table VIOLATES that (`bucketKeyEntriesFrom`
-- restarts at 0 per module so indices DUPLICATE, and each module's slice is
-- prepended, hence descending — see `mergeByDeclIdx`, whose comment records the whole
-- history now that the violating table and its union are deleted).
-- `instRefSeq` is a WHOLE-GRAPH running counter and `ieFileRowByHead` APPENDS, so
-- every `ieHeadRows` bucket is ascending BY CONSTRUCTION: the tie-break at a
-- no-unique-minimum goal is graph-global declaration order, not an
-- arbitrary-but-deterministic order nothing could state.
--
-- The `KeyEntry` a row projects to, field for field what the deleted `keyEntryOf` built
-- from the same `DImpl` — same `headTyconTy` head projection, same `implKeyTc` key,
-- same `tys` as `itys` — with `instRefSeq` where `bucketKeyEntriesFrom` stamped a
-- per-table ordinal.  `[]` for a row with no head type at all (`tys = []`), which
-- is exactly `keyEntryOf`'s own `[] => []` arm: such a row is unselectable on both
-- substrates, so this is not a new exclusion.
keyEntryOfRow : ImplRow -> List KeyEntry
keyEntryOfRow (ImplRow _ inst ir tys reqs ms) = match tys
  headTy::_ => [
    KeyEntry ms (headTyconTy headTy) headTy (implKeyTc ir.irName tys) ir.irName tys reqs (instRefSeq inst)
  ]
  [] => []

-- `entryHeadMatches` against a row's head vector, without building the row's
-- `KeyEntry` first — the whole point is that the hot scan below allocates only for
-- a row that MATCHES.  A `tys = []` row matches nothing (it has no head pattern to
-- match with), which agrees with `keyEntryOfRow` dropping it.
ieRowHeadMatches : List Ty -> List Mono -> Bool
ieRowHeadMatches (tys@(headTy::_)) goals = entryHeadMatches headTy tys goals
ieRowHeadMatches [] _ = False

-- The iface-keyed candidate scan: every row of [rows] whose interface is [iface]
-- and whose head pattern matches [goals], as `KeyEntry`s, ORDER PRESERVED.  The
-- peer of the deleted `matchingEntriesByIfaceGo`, one substrate over — same
-- `ifn == iface` filter (NOT method-name membership, so a specific impl inheriting
-- a method via a DEFAULT is still seen) and the same `entryHeadMatches`.
-- `keyEntryOfRow r` is a ONE-element list on this arm (the guard proved `tys`
-- non-empty), so the `++` is a single cons.
--
-- 🚨 B-4b-i WIDENED THE QUERY SIDE TO `IfaceRef` AND CHANGED NOTHING ELSE — the
-- REPRESENTATION moved, the ANSWER did not, and the neutrality is STRUCTURAL rather
-- than measured.  The filter is now `sameTyConHead` (`frontend/ast.mdk`), the
-- ACCEPTANCE-direction rule: `n1 == n2 && not (tyConIdsConflict o1 o2)`, whose
-- `tyConIdsConflict` answers True only when BOTH origins are identities and they
-- differ.  Every caller in this tree still constructs its query with
-- `ifaceRefBare` (origin `OriginUnresolved` ⇒ `identOriginOf` = `None`), so the
-- conflict test's `(Some, Some)` arm is UNREACHABLE and the whole predicate
-- collapses to `ir.irName == iface.irName` — today's `==`, byte for byte.  That
-- also disposes of the `OriginBuiltin` asymmetry (`ifaceIdentity` maps it to
-- absence, `identOriginOf` maps it to `Some IdentBuiltin`): a row minted with
-- `OriginBuiltin` still cannot conflict with an ABSENT query, so this site does not
-- depend on the "no interface is builtin" invariant holding.
--
-- ⚠️ NOT `ifaceIdMatches`, and the choice is the whole point of the bite.  That is
-- the LOOKUP-direction rule (`a /= "" && a == b`) — absence NEVER matches — which
-- would make every flat-driver interface (single-file `check`, lsp, repl, doc: they
-- deliberately stamp nothing) a non-match and silently empty this scan.  The two
-- rules document each other at `frontend/ast.mdk`; neither may be copied to the
-- other's site.
--
-- 🚨 B-4b-ii SUPPLIED REAL IDENTITY, SO THE `(Some, Some)` ARM IS NOW REACHABLE AND
-- THE PARAGRAPH ABOVE IS HISTORY, NOT A CURRENT DESCRIPTION.  Exactly ONE of the
-- family's three entry points supplies it — `findMatchingImplReqsU` → `iface`, read
-- off `Require.requireOrigin` / `Predicate.iface`; see the derivation there, and the
-- per-site reasons the other two are still bare (`entailInst`'s `EKNestedTop` arm and
-- `argImplRequiresRoutes`, both fed by the deliberately SPELLING-keyed route-word
-- channel `shadowStandaloneDictSlots` / `pushDictApp` project into).
--
-- ⚠️ WHAT THAT MAKES REACHABLE, stated because B-4b-i's neutrality argument DEPENDED
-- on it being unreachable: a row whose interface carries `OriginBuiltin` would now
-- conflict with an origin-bearing query, since `ifaceIdentity` maps `OriginBuiltin` to
-- absence while `identOriginOf` maps it to `Some IdentBuiltin`.  DERIVED, not
-- inherited from the comments that assert it: the only `iface:`-tagged writers into
-- `tyOriginScope`/`flatTyOriginScope` are `ifaceDeclaredIn` and `ownIfaceOrigin`, and
-- BOTH mint `OriginModule`; `builtinTyOrigins` keys under the BARE name, i.e. the type
-- namespace, so `fillIfaceOccOrigin`'s `omLookup (ifaceKey n)` cannot return
-- `OriginBuiltin`.  Its other arm only preserves an origin the occurrence already had,
-- and no site in the tree mints `OriginBuiltin` into an interface-occurrence carrier
-- (`tyConBuiltin` builds a `Ty`; `tconBuiltin` / `tconTupleHead` / `headKeyOfCon
-- OriginBuiltin` build type heads).  Corroborated on the binary: every interface row
-- of the origin-agreement corpus reads `mod:…`, the prelude's `Eq`/`Ord`/`Debug`
-- included, and none reads `builtin`.  Re-derive rather than trust this:
--     grep -rn '^iface:.*builtin' test/origin_fixtures/    # must find nothing
--
-- The rule is factored into `ieRowIfaceMatches` rather than inlined so the SELECTION
-- family has exactly ONE seam a supply bite has to reason about — and so it cannot be
-- confused with `ieCountHeadByIfaceGo`'s deliberately spelling-only test, which is a
-- different question and stays where it is.
ieRowIfaceMatches : IfaceRef -> IfaceRef -> Bool
ieRowIfaceMatches ir iface =
  sameTyConHead ir.irName ir.irOrigin iface.irName iface.irOrigin

ieEntriesForIface : List ImplRow -> IfaceRef -> List Mono -> List KeyEntry
ieEntriesForIface [] _ _ = []
ieEntriesForIface ((r@(ImplRow _ _ ir tys _ _))::rest) iface goals
  | ieRowIfaceMatches ir iface && ieRowHeadMatches tys goals = keyEntryOfRow r
    ++ ieEntriesForIface rest iface goals
  | otherwise = ieEntriesForIface rest iface goals

-- The METHOD-keyed candidate scan — the successor of `matchingEntriesGo` (deleted by
-- B-2.1-d).  Same
-- method-name membership test, same head match, same order.
--
-- ── #1182: THE CANDIDATE KEY NOW HAS AN INTERFACE COMPONENT ──────────────────
-- 🚨 It used to admit a row on `contains name ms` ALONE, so two impls of two
-- DIFFERENT interfaces that merely share a method SPELLING landed in ONE candidate
-- set and were ranked against each other by `pickMostSpecificEntry`.  Their head
-- vectors are ⊑-incomparable for a reason that has nothing to do with overlap, so
-- the selector fell to the head of the list and THE DECLARATION ORDER OF THE TWO
-- `impl` BLOCKS decided which body ran — silently, at exit 0, on both engines
-- (`test/must_fail_fixtures/1182-two-ifaces-same-method-name-order-decides`: the
-- entry imports the method name from `a1` ONLY, so the occurrence has exactly one
-- binding, and it printed `2` — A2's body — under one ordering and `1` under the
-- other).  §6 C1 is a condition on the instances of ONE class (`match(IE, C τ̄)`);
-- a set drawn across two classes is a candidate-set DEFORMATION, not a program.
--
-- The admitted declaration is the SAME one `ieImplExistsForHeadGo` already tests
-- for the EXISTENCE read (`ieRowAdmittedBy`, `admittedIfaceFor`), through the same
-- comparator — `ieRowIfaceMatches` (`sameTyConHead` over `irName`/`irOrigin`), NOT a
-- bare `irName` compare and NOT `ieCountHeadByIfaceGo`'s deliberately spelling-only
-- test.  Selection is this shape's SECOND consumer; the existence read was its first.
--
-- ⚠️ `None` (this module's scope decides nothing for [name]) FALLS BACK TO THE
-- BARE-NAME ANSWER — every row passes, i.e. today's behaviour exactly.  The
-- derivation is `ieRowAdmittedBy`'s own doc-comment and is not restated here; the
-- consequence that IS specific to this site is recorded on `candsOneIface`.
--
-- ⚠️ BEHAVIOUR-NARROWING BY DESIGN ([W-QUIETER] in the opposite direction): supplying
-- identity REMOVES candidates, so a program that used to dispatch by accident can now
-- fail to find an impl.  That is the point — the removed candidates implement an
-- interface the occurrence does not name.
--
-- ⚠️ THE IMPL UNIVERSE IS UNCHANGED (`DICT-SEMANTICS.md` §8 I5): this narrows what the
-- scan ASKS, never which modules' instances may answer.  `ieHeadRows … env` is still
-- the graph-global bucket, unfiltered.
ieEntriesForMethod : List ImplRow -> String -> Option IfaceRef -> List Mono -> List KeyEntry
ieEntriesForMethod [] _ _ _ = []
ieEntriesForMethod ((r@(ImplRow _ _ ir tys _ ms))::rest) name admitted goals
  | contains name ms && ieRowAdmittedBy ir admitted && ieRowHeadMatches tys goals = keyEntryOfRow r ++ ieEntriesForMethod rest name admitted goals
  | otherwise = ieEntriesForMethod rest name admitted goals

-- The head-plus-headless union, on `IE`: the goal head's own bucket merged with the
-- headless one, since a fully-general `impl C a` matches every goal but heads at
-- none (#1128 F-3b).  Its `KeyBuckets` predecessor was `candidateBucket`, deleted by
-- B-2.1-d; the two properties below were derived against it and still hold here.
--
-- ⚠️ FILTER-THEN-MERGE, where `candidateBucket` merged-then-filtered, and the two
-- are the same list: `mergeByDeclIdx` is a stable merge on an index, and dropping
-- elements cannot reorder the ones that remain or change which side wins a tie
-- (ties keep the LEFT operand, and the left operand is the head bucket on both
-- spellings).  Filtering first is what keeps the scan allocation-free on the rows
-- it rejects.
--
-- ⚠️ AND IT PRESERVES THE EMPTY-HEADLESS FAST PATH, which is the
-- path essentially every real lookup takes (no module of compiler/, stdlib/ or
-- sqlite/ declares a bare-tyvar impl head).  Two clauses of `mergeByDeclIdx` do
-- it: `xs [] = xs` returns the left list ITSELF — no copy, no allocation — and
-- `ieEntriesFor*` on the empty headless bucket is its own `[] => []` clause.  So
-- the fast path costs one call and one match, not a bucket copy.
ieCandidatesForIface : ImplEnv -> HeadKey -> IfaceRef -> List Mono -> List KeyEntry
ieCandidatesForIface env hk iface goals =
  mergeByDeclIdx
    (ieEntriesForIface (ieHeadRows (Some hk) env) iface goals)
    (ieEntriesForIface (ieHeadRows None env) iface goals)

ieCandidatesForMethod : ImplEnv -> HeadKey -> String -> Option IfaceRef -> List Mono -> List KeyEntry
ieCandidatesForMethod env hk name admitted goals =
  mergeByDeclIdx
    (ieEntriesForMethod (ieHeadRows (Some hk) env) name admitted goals)
    (ieEntriesForMethod (ieHeadRows None env) name admitted goals)

-- 🚨 ENTRY POINT 1 of 3 — the INTERFACE-keyed row selector (§3 `inst` =
-- min⊑(match)), read by the checker leg and by BOTH halves of the router leg.
-- Replaces `selectImplEntryByIface` for those three sites.
--
-- 🆕 IT RETURNS THE ROW, NOT A KEY OR A STRING, AND THAT IS AN INTERFACE
-- OBLIGATION TO THE NEXT BITE.  The row carries `InstRef` — the instance identity
-- this tree does not otherwise have — so Phase 3′'s stamping bite can name the
-- selected instance at the site that selected it.  A `String`-returning selector
-- makes that bite unstatable, and a `KeyEntry`-returning one loses the identity on
-- the way out (`keyEntryOfRow` is lossy: it keeps `instRefSeq`, not `InstRef`).
--
-- A goal with no head tycon keys no bucket and selects nothing — the `None => None` arm
-- below, which is what `matchingEntries`' `None => []` arm did before B-2.1-d.
ieSelectRowByIface : ImplEnv -> IfaceRef -> List Mono -> Option ImplRow
ieSelectRowByIface env iface goals = match goalHeadCon goals
  Some hk => ieRowOfEntry env (pickMostSpecificEntry goals (ieCandidatesForIface env hk iface goals))
  None => None

-- 🚨 ENTRY POINT 2 of 3 — the METHOD-keyed row selector, read by leg 3's two
-- element-dict route sites AND (since ARCH B-2.1-g) by the route WORD itself, through
-- `keyForSite`.  It replaced `matchedEntry`, which B-2.1-d deleted.
--
-- ── #1182: the admitted declaration is read HERE, from [name] alone ───────────
-- ⚠️ DELIBERATELY NOT A NEW PARAMETER ON THIS FUNCTION, and the reason is
-- `ieImplExistsForHead`'s verbatim — its three existence readers move together "by
-- construction rather than by diligence" precisely because the scope is projected
-- inside the one query.  This selector has the SAME three real callers
-- (`keyForSite`, `implDictRoutesForFull`, `argImplDictRoutesForEncl`), each passing a
-- bare `name : String`; threading `admittedIfaceFor name` through them would let a
-- future edit give the three selection sites three different scopes, which is the
-- MEASURED S0 shape (RUN-METHID-004).  Reading it here makes a partial move
-- unrepresentable and leaves all three callers untouched.
--
-- ⚠️ ONE `omLookup` PER SELECTION, hoisted out of the row scan for the same reason
-- `ieImplExistsForHead` hoists its own ([T-PERF-HUNT]: Medaka is strict, so an in-loop
-- projection is rebuilt once per row).  It is inside the `Some hk` arm because a goal
-- with no head tycon selects nothing and must not pay for the lookup.
ieSelectRowByMethod : ImplEnv -> String -> List Mono -> Option ImplRow
ieSelectRowByMethod env name goals = match goalHeadCon goals
  Some hk => ieRowOfEntry env (pickMostSpecificEntry goals (ieCandidatesForMethod env hk name (admittedIfaceFor name) goals))
  None => None

-- The inverse of `keyEntryOfRow`, and it is EXACT rather than heuristic: the
-- winner's `idx` IS its row's `instRefSeq`, a whole-graph counter unique within one
-- compile (`InstRef`), and the winner's row is filed in the bucket of its OWN head
-- — which is the `KeyEntry`'s own second field, minted by the same `headTyconTy`
-- `ieFileRowByHead` files under.  So ONE bucket scan finds it, with no fallback
-- arm to be silently wrong in.
ieRowOfEntry : ImplEnv -> Option KeyEntry -> Option ImplRow
ieRowOfEntry _ None = None
ieRowOfEntry env (Some (KeyEntry _ hd _ _ _ _ _ idx)) =
  ieRowWithSeq (ieHeadRows hd env) idx

ieRowWithSeq : List ImplRow -> Int -> Option ImplRow
ieRowWithSeq [] _ = None
ieRowWithSeq ((r@(ImplRow _ inst _ _ _ _))::rest) s
  | instRefSeq inst == s = Some r
  | otherwise = ieRowWithSeq rest s

-- The three `KeyEntry` fields the deleted `selectImplEntryByIface` handed the
-- router and the element-route legs — head pattern, FULL head vector, and the
-- impl's OWN `requires` ([] for a no-requires specific impl).  Kept as one
-- projection so the three consumers cannot drift in what they read off a row.
-- `None` on a `tys = []` row: unselectable by construction (`keyEntryOfRow`), so
-- that arm is totality, not a live fallback.
ieRowHeadTriple : Option ImplRow -> Option (Ty, List Ty, List Require)
ieRowHeadTriple None = None
ieRowHeadTriple (Some (ImplRow _ _ _ (tys@(headTy::_)) reqs _)) =
  Some (headTy, tys, reqs)
ieRowHeadTriple (Some _) = None

-- the canonical impl key to stamp at an iface-keyed site (EKNestedTop primary route),
-- mirroring keyForSite: UPGRADE the bare head tag to the winning impl's full canonical
-- key ONLY when two+ impls of [iface] share the head tycon (so bare-head dispatch is
-- ambiguous).  No collision (the common, non-overlapping case) → the bare tag,
-- byte-identical.
-- #1128 (F-3b): the `else` arm returns the winner's own head tag rather than None,
-- for the reason spelled out in full on `keyForSite` — a `noneHeadTag` winner is
-- exactly the case where "the caller's fallback already equals the winner's head" is
-- false, and answering None there discards the correctly-selected candidate.
--
-- ARCH B-2.1-b2: repointed, not deleted (AM-1 still holds for the `keyForSite*`
-- family).  The `KeyBuckets` parameter is GONE rather than ignored — an ignored
-- table parameter reads as "still consulted" at every call site.  The winner's key
-- is minted here from the row's own `IfaceRef`.  ⚠️ B-2.2-b1: it is NO LONGER the
-- same word `keyEntryOf`/`keyEntryOfRow` write into a `KeyEntry`'s (unread) `key`
-- field — this one carries the interface IDENTITY, that one is bare.  The word this
-- must stay byte-equal to is the DEFINITION side's (`core_ir_lower`/`eval`), and it
-- does because both now call `route_key.implRouteKeyWord` with the same origin.
--
-- 🚨 THE COLLISION RETEST MOVED WITH THE SELECTOR, AND THAT NARROWS A REAL SKEW
-- RATHER THAN WIDENING ONE.  `core_ir_lower.ifaceDeclHeadUnique` — the emitter's
-- side of the same verdict, which must agree WORD FOR WORD with what this stamps
-- into the caller's dict cell — counts over `ifaceImplHeadTable`, installed by
-- `lowerImpls` from `lowerProgramEmit allDecls`, i.e. the WHOLE program.  It was
-- already graph-global while this side was a topological prefix; the two now count
-- the same population.  ⚠️ Not identical arithmetic: that side counts DISTINCT
-- canonical keys and this one counts rows, which is the pre-existing difference
-- `ifaceDeclHeadUnique`'s own comment records — unchanged by this bite.
--
-- 🚨 B-4b-i: `iface` is an `IfaceRef`, and THE TWO READS BELOW ARE ANSWERING
-- DIFFERENT QUESTIONS AT DIFFERENT KEYINGS — that asymmetry is deliberate and it is
-- the thing a supply bite must not flatten.  `ieSelectRowByIface` is SELECTION (§3
-- min⊑), an acceptance question, and it is identity-capable via `sameTyConHead`.
-- `ieHeadCollidesByIface` is "is the ROUTE WORD about to be stamped ambiguous at run
-- time", which `ieCountHeadByIface`'s own derivation shows is inherently
-- SPELLING-scoped: three engines re-derive the same uniqueness test from a bare
-- `String` tag, so answering it with identities is wrong at ANY supply level.  It is
-- therefore spelling-keyed on the interface half too.
--
-- Today both reads are spelling in effect (every caller supplies an absent origin),
-- so they cannot disagree.  The moment a bite supplies REAL identity, they can:
-- selection could pick a row the collision count no longer counts, flipping this
-- function between the canonical key and the bare head word.  That is a dict-cell
-- byte change that `core_ir_lower.ifaceDeclHeadUnique` does not follow — the exact
-- skew this file records as exit 0 plus a segfault.  Whoever supplies identity owns
-- that decision explicitly; it is NOT a free consequence of the widening.
keyForSiteByIface : IfaceRef -> List Mono -> Option String
keyForSiteByIface iface goals =
  let env = perRun.value.bodyImplEnvRef.value
  match ieSelectRowByIface env iface goals
    Some (ImplRow _ _ ir tys _ _) =>
      if ieHeadCollidesByIface env iface (univReceiverTag tys) then
        -- B-2.2-b1: identity-bearing, exactly as `keyForSite`'s collision arm —
        -- see the derivation there.
        Some (implRouteKeyWord ir.irOrigin ir.irName tys None)
      else
        -- A-2.2b: the ROUTE WORD, bare on purpose — see `keyForSite`.
        Some (headKeyNameOr noneHeadTag (univReceiverTag tys))
    None => None

-- 🚨 ENTRY POINT 3 of 3 — do two+ distinct impls of [iface] share head tycon
-- [tag]?  The `IE` peer of `headCollidesByIface`.
ieHeadCollidesByIface : ImplEnv -> IfaceRef -> Option HeadKey -> Bool
ieHeadCollidesByIface env iface hd = ieCountHeadByIface env iface hd > 1

-- 🚨 SPELLING-KEYED, THROUGH `headTabOf`/`headTabEq`, AND DELIBERATELY SO.  THIS IS THE
-- FULL DERIVATION FOR BOTH COUNTING SCANS (this one and `ieCountHeadByMethod`); the
-- BUCKET moved from a topological prefix to the whole graph, the RETEST did not change
-- shape.  ⚠️ ARCH B-2.1-d: this block previously lived on `countHead`, the prefix-table
-- counter, and was cited from here, from `ieCountHeadByMethod` and from `dispHeadTab`'s
-- ledger; that read side is deleted, so the derivation now sits on a live scan.
--
-- A-2.2b's first cut widened `KeyEntry`'s head field to an `Option HeadKey` and left the
-- retest as `hd2 == hd` — `deriving Eq`, hence an IDENTITY comparison — which is strictly
-- stronger than the bucket being scanned and answers False wherever two entries' ORIGINS
-- differ.  That is not hypothetical: on #1277's three-module repro the identity form
-- counts 1 where the spelling form (and every pre-A-2.2b binary) counts 2, measured with
-- a build instrumented to panic when the two disagree.  ⚠️ That line used to cite
-- `test/must_fail_fixtures/1277-xmod-head-spelling-collision-across-ifaces`; that
-- directory NO LONGER EXISTS.  A-2.10 drained the pin, and a drained must-fail leaves no
-- regression test behind, so the shape's assertion moved into
-- `test/diff_compiler_check_cli_modules.sh` (the `#1277, DRAINED BY A-2.10` block).
--
-- Why it MATTERS even though no gate moved: `ieHeadCollidesByIface` /
-- `ieHeadCollidesByMethod` going False where they were True makes `keyForSite` /
-- `keyForSiteByIface` stamp the BARE HEAD WORD instead of the winner's canonical key,
-- while `core_ir_lower.declRouteKey` derives the impl's own word from a spelling-based
-- uniqueness test.  That is a dict-word skew — by `keyForSite`'s own #1128 note,
-- "invisible on the direct-call path … and live on the RDict path".
--
-- 🚨 NO LONGER LATENT, AND NO LONGER A PREDICTION — MEASURED, #1317.  This paragraph
-- used to end "it is LATENT today because the one shape known to reach it, #1277's, is
-- itself an open S0 that swamps the difference — and it goes live the moment #1277 is
-- fixed, at which point the code looks correct and nothing in the corpus is watching."
-- ⚠️ #1277 IS FIXED — CLOSED, drained by A-2.10, whose permanent acceptance legs are
-- `A-2.10/1277-xmod-head-spelling-{run,build}` in
-- `test/diff_compiler_check_cli_modules.sh`.  So the swamping is gone and the warning has
-- come due; the sentence above stayed true right up until it wasn't, which is why it is
-- quoted here rather than deleted.
--
-- What #1317's scoping pass actually ran, on a cold-built `MEDAKA_STRICT=1` binary at
-- `7bf3165e`: THREE separate builds of this tree, probed against #1277's own three-module
-- repro.  Changing NOTHING but the two counting scans' retest to the identity form — the
-- existence test and BOTH `ImplUniverse` tables all left spelling-keyed — turned `(1, 2)`
-- into `(1, 1)`.  A valid program, exit 0, wrong answer, no diagnostic: #1277's own S0,
-- back.  Moving all of `dispHeadTab` reproduces it identically; moving ONLY the
-- `ImplUniverse`/obligation half (`insertUnivImpl`, `univConcreteBucket`, `oblKeyParts`)
-- does NOT — so the cause is isolated to these two scans.
--
-- ⇒ AND THE FIX IS NOT MORE SUPPLY.  These scans do not ask "are these two heads the same
-- type"; they ask "is the ROUTE WORD `keyForSite` is about to stamp ambiguous at run
-- time".  Route words are bare names by construction and three engines re-derive that
-- same uniqueness test from a bare `String` tag —
-- `core_ir_lower.declRouteKey`/`ifaceDeclHeadUnique`, `llvm_emit.headTagUnique`/
-- `distinctKeysAtHead`, and `eval.pickTagFallback`'s peer arm.  So the question is
-- inherently SPELLING-scoped and answering it with identities is wrong at ANY supply
-- level, total supply included.  These two scans are therefore NOT "spelling-keyed
-- pending #1280/#1115"; they are spelling-keyed because their consumer is a byte-for-byte
-- agreement with a namespace that has not moved.  They retire WITH #1113, alongside the
-- emitter word-set retirement — at which point they are DELETED rather than re-keyed,
-- there being no head-tag hedge left to disambiguate.  `keyForSite`'s own doc-comment
-- reaches the same conclusion from the other direction; read it before touching either.
--
-- ⚠️ THE EARLIER WITNESS IS STILL A WITNESS, NOT A CENSUS.  What had been run before
-- #1317: this file rebuilt with the retest reverted to the identity form and a panic on
-- disagreement, which fired `answer=1 spell=2 at ff` on #1277's `main.mdk` and stayed
-- SILENT on `main = println "hi"` and on #1277's own control (same program, head spelled
-- `G`) — so the instrument discriminates.  #1317 added an OBSERVABLE consequence for that
-- one shape; nobody has still run either build over the whole fixture corpus.  If you
-- need more than "as far as anyone looked", derive it: revert the retest, rebuild, and run
-- the gates.
--
-- Enrolment rule, from `dispHeadTab`: if a site's answer would CHANGE when the head half
-- becomes an identity, it goes through that function.
--
-- `univReceiverTag tys` is the same head projection `ieFileRowByHead` files each row
-- under and `keyEntryOfRow` puts in `hd`.
-- 🚨 B-4b-i: the `IfaceRef` param is threaded for UNIFORMITY WITH THE FAMILY, and its
-- ORIGIN IS DELIBERATELY UNREAD.  The comparison below stays `ir.irName ==
-- iface.irName` — a bare SPELLING test, NOT `sameTyConHead` — for exactly the reason
-- derived above about the head half: this scan's consumer (`keyForSiteByIface`'s
-- collision gate) is a byte-for-byte agreement with a bare-`String` route-word
-- namespace that three engines re-derive independently.  A supply bite that makes
-- this identity-aware changes which WORD gets stamped without moving the emitter's
-- side of the same verdict.  Widen the type here if you must; do not widen the RULE.
ieCountHeadByIface : ImplEnv -> IfaceRef -> Option HeadKey -> Int
ieCountHeadByIface env iface hd =
  -- goal-side key projected ONCE, here — see `headTabOf`.
  ieCountHeadByIfaceGo (ieHeadRows hd env) iface (headTabOf hd)

ieCountHeadByIfaceGo : List ImplRow -> IfaceRef -> Option TabKey -> Int
ieCountHeadByIfaceGo [] _ _ = 0
ieCountHeadByIfaceGo ((ImplRow _ _ ir tys _ _)::rest) iface goal
  | ir.irName == iface.irName && headTabEq (univReceiverTag tys) goal =
    1 + ieCountHeadByIfaceGo rest iface goal
  | otherwise = ieCountHeadByIfaceGo rest iface goal

-- ── HISTORY: THE METHOD-KEYED ROUTE WORD'S PREFIX-VS-GRAPH SKEW ──────────────
-- 🚨 WHY THE ROUTE WORD IS TAKEN GRAPH-GLOBALLY, AND WHAT IT COST TO LEARN.  Kept as
-- history because it is the argument against re-splitting this decision, not because any
-- code below still does it.  `B-2.1-b2` moved the three SELECTION legs onto the
-- graph-global `IE` and left the method-keyed ROUTE WORD on the topological prefix table,
-- by design (AM-1).  That residual was not a naming skew, it was a MISCOMPILE:
--
--   `test/diff_compiler_check_cli_modules.sh`'s `SA-4c` program — `impl Tag (Wrap a)
--   requires Tag a` plus the more specific `impl Tag (Wrap Int)`, both in a module the
--   goal's own module does not import, the goal ground at `Tag (Wrap Int)` — gave `check`
--   exit 0 (human AND `--json`), `build` exit 0, and a built binary at 139.  Read off
--   `build --keep-ir`: `define @mdk_impl_Tag__Wrap_a___tagOf(i64 %arg0, i64 %arg1)` is
--   arity 2 (its `requires` dict), `@mdk_impl_Tag__Wrap_Int___tagOf` is arity 1, and the
--   site emitted `call @mdk_impl_Tag__Wrap_a___tagOf(i64 %t2)` — an arity-2 call with ONE
--   argument, so the value cell lands in the dict slot and is dereferenced.  WRONG IMPL
--   and WRONG ARITY.
--
-- The mechanism was a count taken twice over two populations: the prefix table at the
-- goal's module held NO `Wrap`-headed impl, so the collision test was False and the BARE
-- head word `Wrap` was stamped; the emitter counts the whole program, finds TWO impls at
-- that head, and resolves the bare word by declaration order to the GENERAL one.  In the
-- accepting import order the same module's prefix DID contain both, the test was True, and
-- the canonical key of the min⊑ winner was stamped — which is why the discriminator was
-- the import ORDER and nothing else.
--
-- `B-2.1-f` made that state a loud located reject (`T-ROUTE-WORD-AMBIGUOUS`) rather than a
-- segfault, on the standing rule that a fix making a defect QUIETER is a severity
-- INCREASE.  `B-2.1-g` then did the real fix — `keyForSite` selects and counts over the
-- same graph-global `bodyImplEnvRef` — so the two counts became one count and the skew the
-- guard reported became unreachable.  `B-2.1-d` deleted the guard with the rest of the
-- prefix-table read side, which it was not separable from (it read
-- `headCollides` → `countHead` → `bucketOfHead`).  ⚠️ ATTRIBUTION CORRECTED, because it
-- was wrong in the brief that ordered the deletion: that guard never covered #1578.
-- #1578 is `residualPredsOf`'s no-match arm, named in `T-REQUIRES-UNROUTED`'s row and not
-- in `T-ROUTE-WORD-AMBIGUOUS`'s; it was measured REPRO both with the guard live and with
-- it dead, so retiring it cost #1578 nothing.  Its `T-ROUTE-WORD-AMBIGUOUS` row in
-- `compiler/DIAGNOSTIC-CODES-DESIGN.md` is marked RETIRED rather than removed.
--
-- ⚠️ THE ASYMMETRY THAT MADE THE GUARD SAFE, KEPT BECAUSE IT IS ALSO WHY THE THREE DRAINS
-- SURVIVED IT.  The unsafe state was only *prefix says unique → stamp a bare word* while
-- *the graph says the word names two or more impls*.  A program whose prefix and graph
-- counts are 0-vs-1, 1-vs-1, 2-vs-2 or 2-vs-3 was untouched — which is what kept #1564,
-- #1599 and #1072 drained across `f` and `g`.  ⚠️ Do NOT infer per-issue impl counts from
-- that sentence: `f`'s row claimed #1564's and #1599's programs each declare ONE impl at
-- the head, and #1599's declares `impl Show2 Box` in BOTH `gen.mdk` and `spec.mdk`.  The
-- guard is gone, so the claim no longer gates anything; the lesson is that the reasoning
-- was never re-derived.
--
-- 🚨 DO NOT ANSWER A FUTURE SKEW BY RE-DERIVING THIS COUNT IN THE OBLIGATION CHANNEL.
-- That channel is keyed by INTERFACE over a different substrate (`residualUnivRef`, the
-- universe projected at this module's ordinal) where the route word is keyed by METHOD
-- NAME; the two are not the same count (an impl inheriting the method via a DEFAULT is in
-- one population and not the other), so it would be a SECOND selector disagreeing with the
-- first.  DICT §11 forbids exactly that, and RUN-B-023 / B-2.1-c each produced an S0 by
-- splitting one decision across two reads.  One substrate, one decision.
--
-- The `IE` method-keyed counter: membership in the impl's METHOD set, NOT its interface —
-- so a specific impl that inherits the method via a DEFAULT is still counted, which is
-- what made the two counts comparable at all.  Spelling-keyed through
-- `headTabOf`/`headTabEq`, for the reason derived in full on `ieCountHeadByIface`.
ieCountHeadByMethod : ImplEnv -> String -> Option HeadKey -> Int
ieCountHeadByMethod env name hd =
  -- goal-side key projected ONCE, here — see `headTabOf`.
  ieCountHeadByMethodGo (ieHeadRows hd env) name (headTabOf hd)

ieCountHeadByMethodGo : List ImplRow -> String -> Option TabKey -> Int
ieCountHeadByMethodGo [] _ _ = 0
ieCountHeadByMethodGo ((ImplRow _ _ _ tys _ ms)::rest) name goal
  | contains name ms && headTabEq (univReceiverTag tys) goal =
    1 + ieCountHeadByMethodGo rest name goal
  | otherwise = ieCountHeadByMethodGo rest name goal

ieHeadCollidesByMethod : ImplEnv -> String -> Option HeadKey -> Bool
ieHeadCollidesByMethod env name hd = ieCountHeadByMethod env name hd > 1

-- the head node of an (unelaborated) AST type's left-nested `TyApp` spine.
-- Total (every `Ty` has a head) and ALLOCATION-FREE (it returns a node that
-- already exists).  Both projections below are written against it, so the
-- spine walk is shared and cannot drift between them; what they do NOT share
-- is the classification of that head node, which is the part that differs by
-- construction — see `headTyconMono`'s note on the same split.
--
-- 🚨 IT ALSO PEELS `TyEffect` — #1618, and the peel is NOT a `TyApp`-spine step.
-- `eval.headTycon` has peeled it since long before this projection existed, so an
-- `impl Sz (<Stdout> Int)` was filed by the DEFINITION side under tag `Int` while
-- this side answered `None` and stamped the route word `__none__`; the emitter
-- then looked `__none__` up, found nothing, and died with `no impl of method 'sz'
-- for type '__none__'` on a program `check` and `run` both accept.  Peeling here
-- makes the two sides name the same tag.  The peel belongs on the NODE walk, not
-- on one classifier, so `headTyconTy` and `headTyconNameTy` cannot disagree about
-- WHICH node they are classifying (they are only allowed to disagree about how).
--
-- 🚨 IT ALSO PEELS `TyConstrained` — #1630, and THIS PARAGRAPH USED TO SAY THE
-- OPPOSITE.  It read: *"`TyConstrained` is deliberately NOT peeled … peeling a
-- constraint yields a still-headless body (`impl Sz (Eq a => a)` → `a`), so both
-- sides already answer `None` and agree"*, and cited #1617 as bounding the class
-- at two.  That reasoning generalised from ONE body shape to ALL of them: it is
-- sound for `Eq a => a`, whose peeled body really is a bare `TyVar`, and simply
-- false for `Eq a => Int`, whose peeled body is a `TyCon`.  `eval.headTycon` has
-- peeled `TyConstrained` since long before this projection existed, so the
-- HEADED case reproduced #1618's exact failure with a different wrapper: the
-- definition side filed `impl Sz (Eq a => Int)` under tag `Int` while this side
-- answered `None` and stamped `__none__`, and `medaka build` died with `no impl
-- of method 'sz' for type '__none__'` on a program `check` accepts and `run`
-- answers correctly (measured: check 0, run `2`, build 1).
--
-- ⚠️ The HEADLESS body is unaffected and must stay that way: peeling
-- `Eq a => a` still lands on a `TyVar`, every arm below still falls through to
-- `_ => None`, and `impl Sz (Eq a => a)` remains a fully-general headless impl.
-- The peel does not decide headedness — it only stops the WRAPPER from hiding a
-- head that is there.  That is why the arm is on this NODE walk rather than in
-- one classifier: `headTyconTy` and `headTyconNameTy` must not disagree about
-- WHICH node they are classifying.
--
-- 🚨 IT IS THE **DISPATCH** WALK, AND THAT IS NOT A SYNONYM FOR "THE" WALK.  The
-- `TyEffect` peel and `headTyconTy`/`headTyconNameTy`'s `TyFun` arms are a
-- ROUTING fix (#1617/#1618): they make the impl side name the tag the goal side
-- already keys.  But `headTyconNameTy` also had two readers that decide
-- **ACCEPTANCE** rather than routing — `implHeadTagForIface` (the impl-head
-- census `routeUndeterminedTop` counts: one head → stamp it, two or more →
-- `T-AMBIGUOUS-INSTANCE`) and `implTysIfMatch` (`groundOneObligation`'s
-- candidate set, which gives up on more than one match).  Feeding the new arms
-- to THOSE turns an ACCEPT into a REJECT on programs that never dispatch to an
-- arrow or an effect head at all: `impl C Int` beside `impl C (Int -> Int)` or
-- `impl C (<Stdout> Bool)` went from a stamped route to *"Ambiguous instance"*,
-- exit 1, measured on both arms.  `implEntryFromTys`, the third reader, is a
-- dispatch registrar (`ImplBuckets` is looked up by `bucketOf` at the GOAL's
-- head) and correctly keeps the new arms.
--
-- So the acceptance pair reads `censusHeadNameTy` below, over `headTySpineNode`
-- — the walk this one WAS before #1618 — and the split is the point rather than
-- an accident of refactoring.  The narrowing may well be the right answer under
-- DICT-SEMANTICS §3, but it is a language-semantics decision owned by F-3c
-- (#1155), not a rider on a dispatch bug fix; the audit note above
-- `implEntryFromTys` said exactly that about this exact census before either
-- arm existed.  #1630's `TyConstrained` peel is the THIRD member of that same
-- routing set and is held to the same line: it lands here and NOT on
-- `headTySpineNode`, so a constrained-headed impl is still dropped from the
-- acceptance census exactly as it was.  That is a deliberate residual, and it is
-- an OBSERVABLE one — `censusHeadNameTy`'s own note carries the two-impl program
-- that reaches it, measured identically on this arm and on a peel-reverted base
-- arm.  It is PRE-EXISTING (it is the same residual the effect peel already
-- left), so it is not this fix's to close; it is this fix's to describe
-- correctly, which the note now does.
--
-- ⚠️ AND F-3c (#1155) IS **CLOSED**, so "F-3c owns the ruling" — written above
-- and at `implEntryFromTys`, both predating this PR — is no longer a live
-- deferral.  Those paragraphs are still right about WHY the walks are split (an
-- acceptance narrowing is not a rider on a dispatch bug fix); they are stale
-- only about who will decide it.  Nothing open owns it today.  Do not read the
-- citation as a scheduled ruling, and do not delete the split on the grounds
-- that its owner went away.
headTyNode : Ty -> Ty
headTyNode (TyApp a _) = headTyNode a
headTyNode (TyEffect _ _ t) = headTyNode t
headTyNode (TyConstrained _ t) = headTyNode t
headTyNode t = t

-- The `TyApp`-spine-only head walk: `headTyNode` MINUS the `TyEffect` peel and
-- (since #1630) MINUS the `TyConstrained` peel.
-- Read by `censusHeadNameTy` alone, and it exists so the acceptance readers keep
-- projecting exactly what they projected before #1617/#1618/#1630 — see the 🚨 above.
-- Do NOT "unify" the two: the sharing is what carried the routing fix into an
-- acceptance census in the first place.
headTySpineNode : Ty -> Ty
headTySpineNode (TyApp a _) = headTySpineNode a
headTySpineNode t = t

-- the head type constructor of an (unelaborated) AST type, as the IMPL-SIDE
-- dispatch key — Stage A-2 unit A-2.2 (#1111).  The result was `Option String`
-- until this unit, which threw away the `tyConOrigin` Stage A-1 put on the very
-- node this matches; `HeadKey` (`types/registry.mdk`) carries it, and its
-- doc-comment derives why `None` had to keep meaning exactly what it meant
-- before ("no head type constructor at all") rather than absorbing "a head with
-- no identity yet".
--
-- ⚠️ `TyTuple` is the one arm with no node to read an origin off: the head it
-- names is the synthetic `__tupleN__` tag, which the LANGUAGE provides.
-- `OriginBuiltin` is therefore the same answer, by the same authority, as the
-- two mints that build such a head — `tconTupleHead` above and the parser's own
-- `tyConBuiltin (tupleCtorTyName n)` (`frontend/parser.mdk`).  It is also what
-- keeps the impl side and the goal side agreeing on tuple heads, the invariant
-- the `ImplUniverse` comment above already relies on.
--
-- ⚠️ THE `TyFun` ARM IS #1617's FIX, and `OriginBuiltin` is the same answer by
-- the same authority as `TyTuple`'s: the arrow constructor is provided by the
-- LANGUAGE, not by a declaration.  Before it, two arrow-headed impls of one
-- interface both fell through to `None`, landed in the headless bucket, and —
-- because `goalHeadCon` answered `None` too — `ieSelectRowByMethod` selected
-- NOTHING, so the site was stamped `RNone` and the emitter fell back to arg-tag
-- dispatch over a receiver (a closure) that carries no cell tag.  See
-- `route_key.funHeadTag` for why ONE tag is enough here where tuples needed one
-- per arity.
--
-- ⚠️ #1630 ADDED NO ARM HERE, AND THAT IS THE POINT.  A constrained head is not
-- a new KIND of head — `Eq a => Int` is an `Int` head behind a wrapper — so the
-- fix is a peel on `headTyNode`, and every arm below classifies the peeled node
-- unchanged.  If you are tempted to add a `TyConstrained` arm here, the shape
-- you want is already handled; adding one would only let this projection and
-- `headTyconNameTy` disagree about which node they classify.
headTyconTy : Ty -> Option HeadKey
headTyconTy t = match headTyNode t
  TyCon { tyConName = n, tyConOrigin = o } => Some (headKeyOfCon o n)
  TyTuple ts => Some (headKeyOfCon OriginBuiltin (tupleHeadTagTc (listLen ts)))
  TyFun _ _ => Some (headKeyOfCon OriginBuiltin funHeadTag)
  _ => None

-- The BARE-NAME residual of the projection above: byte-identical to what
-- `headTyconTy` itself answered before A-2.2, and allocating exactly what it
-- allocated (one `Some`).  Every consumer that has not yet been re-keyed calls
-- THIS, so the IMPL-side half of the Stage A-2 ledger is what this prints —
-- a command, never a number copied down here:
--
--   grep -nw headTyconNameTy compiler/types/typecheck.mdk \
--     | grep -vE '^[0-9]+:[[:space:]]*--' \
--     | grep -vE '^[0-9]+:headTyconNameTy'
--
-- ⚠️ Both filters are load-bearing: the unfiltered command also prints every
-- COMMENT that names the function (including this one) and its own signature
-- and clauses, none of which is a residual call site.
--
-- ⚠️ Deliberately NOT `map headKeyName (headTyconTy t)`.  That spelling has no
-- duplication at all, and it is the one `compiler/AGENTS.md` warns about: it
-- would build a `HeadKey` (and an `Ident`, and a second `Option`) on every call
-- of a projection that runs per type-application node, on the GC-bound `check`
-- stage, purely to throw them away — and BOTH perf CI arms are structurally
-- blind to a constant factor.  The price paid instead is these three arms,
-- which must classify the same head nodes as the three above.
headTyconNameTy : Ty -> Option String
headTyconNameTy t = match headTyNode t
  TyCon { tyConName = n } => Some n
  TyTuple ts => Some (tupleHeadTagTc (listLen ts))
  -- kept in lockstep with `headTyconTy`'s new arm (#1617): this residual's
  -- remaining reader, `implEntryFromTys`, registers `ImplBuckets` rows that are
  -- looked up by `bucketOf` at a GOAL head the dispatch projection minted, so an
  -- arm present in one and absent from the other is a table that cannot be
  -- looked up.
  --
  -- ⚠️ IT HAD THREE READERS AND NOW HAS ONE.  The other two decided ACCEPTANCE,
  -- not routing, and read `censusHeadNameTy` below instead — `headTyNode`'s 🚨
  -- has the measurement.
  TyFun _ _ => Some funHeadTag
  _ => None

-- ── the ACCEPTANCE-census head name ───────────────────────────────────────
-- `headTyconNameTy` AS IT WAS BEFORE #1617/#1618: the `TyApp` spine only, no
-- `TyEffect` peel, no `TyFun` arm — so an arrow-headed or effect-headed impl
-- answers `None` and is DROPPED from the census, exactly as it was.
--
-- 🚨 THIS IS NOT A DUPLICATE OF THE PROJECTION ABOVE, IT IS THE OTHER QUESTION.
-- Above: *"which dispatch bucket does this impl head file into?"* — every impl
-- needs an answer, and a synthetic bucket name (`__fun__`, or the peeled inner
-- head of an effect row) is a fine one.  Here: *"does this impl head COUNT as a
-- candidate when the goal is still undetermined?"* — where an extra `Some`
-- turns a stamped route into `T-AMBIGUOUS-INSTANCE`, i.e. rejects a program.
--
-- Its two readers:
--   * `implHeadTagForIface` → `implHeadTagsForIface` → `routeUndeterminedTop`
--   * `implTysIfMatch` → `uniqueImplTysFor` → `groundOneObligation`
--
-- ⚠️ The second one is also UNREACHABLE at `__fun__` by construction, which is
-- the independent corroboration that this split is coherent rather than merely
-- conservative: its `tag` argument comes from `headTyconNameMono`, and that
-- residual deliberately did NOT gain a `TFun` arm (see its own 🚨), so no goal
-- can ever ask this census for `__fun__`.  Answering `Some funHeadTag` here
-- could therefore only ever ENLARGE a match set nothing queries — pure
-- narrowing, no routing gain.
--
-- Whoever flips this to the narrowing owns F-3c (#1155)'s flip list, an owner
-- ruling, and fixtures for the programs it stops accepting.  Do not fold it back
-- into `headTyconNameTy` to "remove duplication".
--
-- 🚨 #1630's `TyConstrained` peel STOPS HERE TOO — the census walks
-- `headTySpineNode`, which does not peel the wrapper, so `impl Sz (Eq a => Int)`
-- still answers `None` here and is still dropped from BOTH readers even though
-- its peeled head `Int` is perfectly ordinary.  That is deliberate: the same
-- ACCEPTANCE-narrowing argument the 🚨 above records for `__fun__` and for the
-- effect peel applies verbatim — a narrowing is not a rider on a dispatch bug
-- fix, and it should be taken once for all three wrappers rather than bolted on
-- per bug.  ⚠️ The 🚨 above defers that ruling to F-3c (**#1155, CLOSED**); read
-- the reasoning, not the owner.
--
-- 🚨 AND THE RESIDUAL IS **OBSERVABLE**.  This note used to read "STRUCTURAL,
-- NOT DEMONSTRATED", citing a program #1630 "tried and FAILED to build" — a
-- return-position method with the constrained impl as the interface's ONLY
-- impl.  That candidate was DISQUALIFIED BY CONSTRUCTION and the note did not
-- know it: `checkUndeterminedObligation`'s RULE 3 is guarded on
-- `implCountForIfaceU >= 2`, so a ONE-IMPL program can never reach the arm the
-- census residual disables.  A failed probe that could not have succeeded is not
-- evidence of absence.  With TWO impls it is observable in one `check` cell:
--
--   interface Zero a where
--     zero : a
--   impl Zero (Eq x => Int) where zero = 0    -- control: plain `impl Zero Int`
--   impl Zero Bool where zero = False
--   ignore2 : a -> Int
--   ignore2 _ = 5
--   main = println (ignore2 zero)
--
-- CONTROL (plain `Int` head): `check` exits **1**, *"Ambiguous instance for
-- `Zero`. Cannot determine which impl; add a type annotation"*.  CONSTRAINED
-- head: `check` exits **0**, `run` prints 5, `build` exits **1**
-- (`E-PANIC: arg-tag dispatch for method 'zero': discriminating arg position not
-- supplied`).  The constrained impl is invisible to the census, the count stays
-- at 1, RULE 3 never fires, and a genuinely ambiguous program is ACCEPTED.
--
-- ⚠️ IT IS PRE-EXISTING AND NOT #1630's TO FIX.  Measured cell-for-cell
-- identically on this branch's binary AND on a base arm built from this branch
-- with the one-line `headTyNode` peel deleted and both stages rebuilt —
-- arm-invariant, so the peel neither introduced it nor could have removed it.
-- The same shape with an EFFECT wrapper (`impl Zero (<Stdout> Int)` beside
-- `impl Zero Bool`) gives the same three cells on both arms, so "structural, not
-- demonstrated" was false for TWO of the three wrappers, not just this one.
--
-- ⚠️ AND NOTHING OPEN OWNS IT.  This note used to defer the ruling to F-3c
-- (#1155); **#1155 is CLOSED**, so that deferral pointed at nothing.  The
-- acceptance-narrowing argument the 🚨 above records is still the right reason
-- to keep the census walk split from the dispatch walk, but "F-3c will rule on
-- it" is no longer a live commitment and must not be cited as one.  Whoever
-- picks this up owns the flip list and the fixtures; do not downgrade it to
-- "benign", which is the exact over-generalisation #1630 was, and do not assume
-- an unfiled residual is an unimportant one.
censusHeadNameTy : Ty -> Option String
censusHeadNameTy t = match headTySpineNode t
  TyCon { tyConName = n } => Some n
  TyTuple ts => Some (tupleHeadTagTc (listLen ts))
  _ => None

-- The bare name of a head key, with [dflt] when there is NO head type
-- constructor — the `fromOption <placeholder> (headTycon… …)` shape the
-- dispatch-key sites already used, now spelled once so the projection happens
-- exactly once per call (Medaka is strict: `map headKeyName` over the `Option`
-- would allocate a second `Option` to throw away).  HOW MANY such sites there
-- are is a command, not a number written here — the same shape spelled
-- `fromOption` on the commit before A-2.2 is
-- `git show <pre-A-2.2>:compiler/types/typecheck.mdk
--  | grep -nE 'fromOption[^(]*\(headTycon'`, and the sites this covers now are:
--
--   grep -nw headKeyNameOr compiler/types/typecheck.mdk \
--     | grep -vE '^[0-9]+:[[:space:]]*--' \
--     | grep -vE '^[0-9]+:headKeyNameOr'
--
-- (the two filters drop the comments that name it — including this one — and
-- this definition's own signature and clauses).  Neither count is copied down,
-- because a count copied down has no derivation and no expiry.
--
-- ⚠️ The [dflt] is a PLACEHOLDER for "this position has no head", NOT a name,
-- and it is a DIFFERENT fact from `TkBare` ("a head with no identity yet") —
-- `types/registry.mdk`'s `HeadKey` derives the distinction, and
-- `checkCallObligationsU`'s `""` is the row where collapsing the two would lose
-- a diagnostic (#607).  Both are preserved verbatim here.
headKeyNameOr : String -> Option HeadKey -> String
headKeyNameOr _ (Some hk) = headKeyName hk
headKeyNameOr dflt None = dflt

-- Multi-param-interface variant: [paramMonos] is the FULL list of the interface's
-- type-parameter monos at this occurrence (recovered by ifaceParamMonos), e.g. for
-- `Set { 3,1,2 } : Set _a` the `FromEntries c e` occurrence has c↦Set _a, e↦Int.
-- The single-param result-only path lost the element grounding (`e`): matching the
-- impl head `Set a` against the result `Set _a` only binds a↦_a (a free var), so the
-- `requires Ord a` route fell to RNone → a null Ord dict → SIGSEGV.  Matching the
-- impl's FULL `implTys` (`[Set a, a]`) against ALL the param monos recovers a↦Int from
-- the second param, exactly as the OCaml oracle's impl_head_subst keys off the full
-- concrete_args (the interface's param_vars), not just the result.
-- #203 (G): the return-position element/requires routes.  Was a FIRST-MATCH scan of the
-- ImplBuckets [tag] bucket (which OMITS no-requires impls, so it could never see the
-- specific `List Int` sibling next to `List a` and always discharged `List a`'s requires).
-- Now selects the MOST-SPECIFIC matching impl over the graph-global impl universe (`IE`)
-- via the shared method-keyed selector (`ieSelectRowByMethod` since ARCH B-2.1-b2, which
-- replaced `matchedEntry`; §3 `inst` = min⊑) and discharges THAT impl's OWN
-- requires — [] for a no-requires specific impl.  Non-overlapping site (one match) → the
-- same impl the first-match scan returned ⇒ byte-identical routes.  [implTable] is a dead
-- parameter here (see the header a few lines below implDictRoutesForFull's body for the
-- measurement — it is NOT threaded for a live re-bucketing).
-- The OUTER head match still uses headSubstWithParams (multi-param augmentation).
implDictRoutesForFull : ImplBuckets -> String -> String -> String -> Mono -> List Mono -> List Route
-- #609: the impl is now selected on the SAME full param-mono vector the head subst
-- is built from (was: `matchedEntry … resultMono` — arg-0 only, so at n≥2 it could
-- hand headSubstWithParams the requires of an impl that does not match the goal).
-- ARCH B-2.1-b2 (LEG 3a, the METHOD-keyed ELEMENT DICTS): selection moved off the
-- prefix `stampKeyTable` onto the graph-global `IE`.  🚨 THIS IS THE LEG WHOSE
-- ABSENCE MAKES THE OTHER TWO AN S0: with legs 1/2 moved and this one left behind,
-- #1564's impl gained a dict param it was never passed — `check` exit 0, built
-- binary 139 (RUN-B-023).  This comment used to justify the parameter as *"still threaded for the
-- nested `requires` recursion, which re-buckets by each requires' own head"* — MEASURED
-- FALSE, and the recursion's own end point already says so: it terminates at
-- `selectReqImpl`, whose signature takes no `KeyBuckets` at all, and whose header
-- records why (*"the `KeyBuckets` parameter is REMOVED rather than ignored — it had
-- exactly one reader, this arm"*).  Nothing on the chain
-- (`argImplReqRoutes` → `argReqRoute` → `routeOfD` → `entail`'s `EKNestedTop` arms)
-- reads the table; each link only forwards it, and the one `KeyBuckets`-consuming
-- fallback (`undeterminedRoute`'s `CountImpls` arm) is unreachable because
-- `argReqRoute` seeds the recursion with `KeepNone`.
implDictRoutesForFull implTable encl name tag resultMono paramMonos = match ieRowHeadTriple (ieSelectRowByMethod perRun.value.bodyImplEnvRef.value name paramMonos)
  Some (headTy, implTys, reqs) => match headSubstWithParams headTy implTys resultMono paramMonos
    Some subst => argImplReqRoutes implTable encl subst reqs 0 0
    None => []
  None => []

-- Build the impl head substitution.  Always match the impl HEAD (`Set a`) against
-- the result mono (the historical single-param behaviour, byte-identical when no
-- extra param info is supplied).  THEN, when the caller has the interface's FULL
-- param monos (`[Set _a, Int]` for a multi-param interface) and they line up with
-- the impl's full type-arg patterns (`[Set a, a]`), additionally match the trailing
-- patterns against the trailing param monos and merge — preferring a concrete head
-- (Int) over a free var (_a) on a key collision.  This recovers the element grounding
-- (`a ↦ Int`) the head-only match lost.  When the param monos don't line up (a plain
-- result-only call, or a shape mismatch) the head match alone stands.
headSubstWithParams : Ty -> List Ty -> Mono -> List Mono -> Option (List (String, Mono))
headSubstWithParams headTy implTys resultMono paramMonos = map
  (headSub => augmentWithParams headSub implTys paramMonos)
  (matchTyMono headTy resultMono)

-- When the impl's full type-arg patterns line up with the interface's full param
-- monos (a multi-param interface), fold the trailing element groundings into the
-- head subst (concrete-wins); otherwise return the head subst unchanged.
augmentWithParams : List (String, Mono) -> List Ty -> List Mono -> List (String, Mono)
augmentWithParams headSub implTys paramMonos
  | listLen implTys == listLen paramMonos && listLen paramMonos > 1 = match implHeadSubst implTys paramMonos
    Some full => mergeSubstPreferConcrete headSub full
    None => headSub
  | otherwise = headSub

-- Match the impl's full type-arg patterns [pats] (`[Set a, a]`) against the
-- interface's concrete param monos [concretes] (`[Set _a, Int]`), accumulating a
-- name→mono subst.  When the SAME impl var appears in several positions (here `a`
-- is both the head element and the standalone element param), prefer the binding
-- whose mono has a CONCRETE head tycon (Int) over a still-free var (_a) — that is
-- what recovers the element grounding the result-only match missed.  Mirrors the
-- oracle's impl_head_subst (Hashtbl.replace last-wins, with concrete winning here).
-- A length mismatch / structural failure → None (no match, try the next impl), so a
-- single-param interface ([resultMono] only) behaves exactly as the old matchTyMono.
implHeadSubst : List Ty -> List Mono -> Option (List (String, Mono))
implHeadSubst pats concretes
  | listLen pats /= listLen concretes = None
  | otherwise = implHeadSubstGo pats concretes (Some [])

implHeadSubstGo : List Ty -> List Mono -> Option (List (String, Mono)) -> Option (List (String, Mono))
implHeadSubstGo [] [] acc = acc
implHeadSubstGo (p::ps) (c::cs) None = None
implHeadSubstGo (p::ps) (c::cs) (Some sofar) = match matchTyMono p c
  None => None
  Some s => implHeadSubstGo ps cs (Some (mergeSubstPreferConcrete sofar s))
implHeadSubstGo _ _ _ = None

-- Merge two name→mono substs; on a key collision keep whichever value has a
-- concrete head tycon (so the grounded element wins over a free result var).
mergeSubstPreferConcrete : List (String, Mono) -> List (String, Mono) -> List (String, Mono)
mergeSubstPreferConcrete acc [] = acc
mergeSubstPreferConcrete acc ((k, v)::rest) =
  mergeSubstPreferConcrete (mergeOne acc k v) rest

mergeOne : List (String, Mono) -> String -> Mono -> List (String, Mono)
mergeOne [] k v = [(k, v)]
mergeOne ((k2, v2)::rest) k v
  | k2 == k = (k2, preferConcrete v2 v)::rest
  | otherwise = (k2, v2) :: mergeOne rest k v

preferConcrete : Mono -> Mono -> Mono
preferConcrete a b = match headTyconNameMono a
  Some _ => a
  None => b

-- match an impl-head type PATTERN against a concrete mono, binding the impl's
-- type-variable names to monos (single-level: the pattern's args are bare vars).
-- #156 S1 / Fork B: matchTyMono is now a CONSISTENCY-ENFORCING frontend of the
-- shared matchOneSided core (specific side = Mono, so the consistency equality is
-- cohEqMono).  The old body combined element substs with `xs ++ ys` and NEVER
-- checked a var bound twice, so a non-linear impl head (`Get (Box a) a`) could
-- "match" `Get (Box Int) Bool` (binding a↦Int AND a↦Bool) even though NO
-- substitution exists — violating §3 `inst`'s "φ a most-general MATCHER" premise
-- and letting findImplEntryGo (iface=="") select the wrong impl's requires.  Now
-- a↦Int, a↦Bool fails cohEqMono ⇒ None (no false match); a CONSISTENT non-linear
-- head (`Get (Box Int) Int`, a↦Int twice) still matches (the live canary in
-- test/eval_typed_fixtures/return_only_param_dispatch.mdk).  The recovered subst
-- is consumed only by key-lookup (fromAstType / paramMonoOf), so dropping the
-- redundant duplicate binding is byte-identical for every previously-accepted
-- match.
matchTyMono : Ty -> Mono -> Option (List (String, Mono))
matchTyMono headTy resultMono =
  matchOneSided matchStep eqStr cohEqMono [(headTy, resultMono)] []

-- #609: the §3 matching judgement over a head VECTOR —
--     match(IE, C τ̄) = { I | ∃φ. φ(head(I)) = C τ̄ }
-- ONE most-general matcher φ for the whole vector, so a var appearing in several
-- argument positions must receive the same mono (matchOneSided's cohEqMono
-- consistency check, the same one matchTyMono relies on).  n=1 reduces to
-- matchTyMono term for term: `zipL [t] [m] == [(t, m)]`.
matchTyMonos : List Ty -> List Mono -> Option (List (String, Mono))
matchTyMonos pats goals
  | listLen pats /= listLen goals = None
  | otherwise = matchOneSided matchStep eqStr cohEqMono (zipL pats goals) []

-- Does an impl whose head vector is [itys] (arg-0 pattern [hty]) match the goal
-- vector [goals]?  When the caller recovered the interface's FULL param monos the
-- two vectors line up and we match ALL of them under one φ (§3).  When it could
-- not — a scalar-only caller passes the singleton [m] — the lengths disagree for a
-- multi-param impl and we fall back to matching the arg-0 pattern alone, which is
-- byte-identical to the pre-#609 scan.  For a single-param impl the lengths always
-- agree (both 1) and `matchTyMonos [hty] [m] == matchTyMono hty m`, so the
-- single-param path never takes the fallback and never changes.
entryHeadMatches : Ty -> List Ty -> List Mono -> Bool
entryHeadMatches hty itys goals
  | listLen itys == listLen goals = isSome (matchTyMonos itys goals)
  | otherwise = match goals
    g::_ => isSome (matchTyMono hty g)
    [] => False

-- AST-head-vs-Mono step: destructure the AST head pattern, normalizing the Mono
-- side at each level.  TyVar binds the WHOLE mono at that position.
--  • TyTuple: a tuple impl head (`(a, b)`) matches a same-arity tuple mono (Native
--    Gap C) — one element-var subst per position; mismatched arity ⇒ MFail.
--  • TyFun: recover typaram bindings from BOTH argument and result positions (used
--    by ifaceParamMonos); effect rows ignored (row-blind), result wrapper stripped.
--  • TyEffect/TyConstrained wrappers on the head are transparent.
matchStep : Ty -> Mono -> MStep String Ty Mono
matchStep (TyVar n) _ = MVar n
matchStep (TyCon { tyConName = n, tyConOrigin = o }) m = match normalize m
  -- #1111 A-2.10: the IMPL-HEAD-vs-GOAL match reads identity too, by the same
  -- `sameTyConHead` rule `unifyN` uses.  This is the dispatch half: `impl C a.T`
  -- no longer matches a goal whose head is `b.T`.  ⚠️ It does NOT make dispatch
  -- identity-KEYED — `ImplBuckets`/`obUniv*` are still spelling-keyed (#1274,
  -- `dispHeadTab`); this narrows the candidates a bucket's scan accepts, which
  -- is why the two can be landed in either order.
  TCon n2 o2 => if sameTyConHead n o n2 o2 then MOk else MFail
  -- #1110 ANSWER-PRESERVING, and it really does fire — the twin of `tupleSpine`'s
  -- rigid arm.  A real head is uppercase-initial OR one of the four reserved
  -- `__tupleN__` tags (`tupleCtorTyName`, `compiler/frontend/parser.mdk:2137-2141`,
  -- minted via `tyConBuiltin` at `:2131`), and `__tupleN__` is ALSO a legal rigid
  -- spelling: `identStartLower` (`compiler/frontend/lexer.mdk:1638`) admits a
  -- leading `_`, so `data Bad = Bad __tuple2__` binds a type PARAMETER and both
  -- rigid producers can mint `TRigid "__tuple2__"`.  Measured: without this arm
  -- `impl Q (,)` stops matching such a goal and a program that checked clean before
  -- the split becomes `No impl of Q for (,)` — a real answer change.
  --
  -- ⚠️ The pre-split answer this restores is a FORGERY: a rigid variable is not the
  -- builtin tuple head, and letting it match one is exactly the identity confusion
  -- DICT-SEMANTICS §8 I6.2(b) records as OWED-#1110.  Preserved deliberately —
  -- this PR is the carrier step; changing answers is the follow-on.
  TRigid n2 => if n == n2 then MOk else MFail
  _ => MFail
matchStep (TyApp a b) m = match normalize m
  TApp ma mb => MKids [(a, ma), (b, mb)]
  _ => MFail
matchStep (TyTuple ts) m = match tupleSpine m
  Some ms => if listLen ts == listLen ms then MKids (zipL ts ms) else MFail
  _ => MFail
matchStep (TyFun a b) m = match normalize m
  TFun ma _ mb => MKids [(a, ma), (stripEff b, mb)]
  _ => MFail
matchStep (TyEffect _ _ t) m = MKids [(t, m)]
matchStep (TyConstrained _ t) m = MKids [(t, m)]
matchStep _ _ = MFail

-- #217: the return-position BLIND requires chain (implReqRoutes → reqRoute →
-- implRequiresRoutesRec[D]) has been UNIFIED onto the activeDictVar-AWARE arg chain
-- (argImplReqRoutes → argReqRoute → routeOf → argImplRequiresRoutes).  The old
-- blind chain resolved an abstract element var to RNone (a null dict cell, the
-- historical SIGSEGV source) even when that var was an in-scope enclosing-method
-- constraint var whose dict param IS available; the aware chain routes it RDict per
-- DICT-SEMANTICS §3 `assum`.  The WS-4b depth fuse (max 32) was RETAINED — it now lives
-- on the aware recursion (argImplRequiresRoutes) so the unified chain is aware +
-- fused, not aware-and-diverging on a non-shrinking impl context.

-- find the ImplEntry in [implTable] for interface [iface] whose head tycon is
-- [tag] and whose head pattern matches the concrete mono [m].  A type may carry
-- SEVERAL `requires`-bearing impls at one head tycon for different interfaces
-- whose requires differ in shape (arity/parameters); keying on the tag alone
-- picked the first such impl and produced the WRONG element-dict routes (e.g.
-- `Applicative (VT e) requires Semigroup e` stealing dispatch from
-- `Debug (VT e a) requires Debug e, Debug a`).  So we filter by [iface] too.
-- [iface] == "" means "no interface known" (the method-level path) → fall back to
-- the historical first-by-tag behaviour.  The head-pattern match against [m] is
-- also required so a same-iface but wrong-arity head (e.g. `VT e` vs `VT e a`) is
-- skipped rather than matched-then-dropped.
findImplEntry : ImplBuckets -> String -> String -> Mono -> Option ImplEntry
findImplEntry buckets iface tag m =
  findImplEntryGo (bucketOf tag buckets) iface tag m

findImplEntryGo : List ImplEntry -> String -> String -> Mono -> Option ImplEntry
findImplEntryGo [] _ _ _ = None
findImplEntryGo ((ImplEntry tag2 ms hty reqs itys ifn)::rest) iface tag m
  | tag2 == tag && (iface == "" || ifn == iface) = match matchTyMono hty m
    Some _ => Some (ImplEntry tag2 ms hty reqs itys ifn)
    None => findImplEntryGo rest iface tag m
  | otherwise = findImplEntryGo rest iface tag m

-- fill each constrained-fn call site's routes: one route per constraint mono.  A
-- mono pinned to a concrete head → RKey; still a constraint variable (a nested
-- constrained call) → RDict; otherwise RNone.
resolveDictApps : List Decl -> ImplBuckets -> List (Ref (List Route), List Mono, List String, List (List Mono), Option Loc) -> Unit
resolveDictApps _ _ [] = goalSiteLoc := None
resolveDictApps prog implTable ((routesRef, monos, ifaces, argVecs, loc)::rest) =
  goalSiteLoc := loc
  let routes = routesOfMonosTopV prog implTable monos ifaces argVecs
  routesRef := routes
  resolveDictApps prog implTable rest

-- Caller-supplied policy for the UNDETERMINED arm of routeOf (the constraint var is
-- pinned by NEITHER an argument nor the result).  KeepNone (the nested element-dict
-- recursion) keeps the existing RNone; CountImpls prog iface (a TOP-LEVEL
-- constrained-call site) counts impls of [iface] in [prog].  A VARIANT (not a
-- callback) so a nested element-position caller STRUCTURALLY cannot read [prog] or
-- raise T-AMBIGUOUS-INSTANCE — the type forbids it, so a blanket RNone→RKey can never
-- corrupt element-dict routing (the fear the three variants were "kept SEPARATE" for).
data Undetermined = KeepNone | CountImpls (List Decl) String

-- #156 S3b: the SiteKind-parametrized entailment core.  ONE `assum → inst → fallback`
-- ladder that both the genuine return-position method resolver (`resolveSite`, EKReturn)
-- and the nested/top constrained-call router (`routeOfD`, EKNestedTop) route through.
-- Returns `(primary route, element-dict route list)`.  Genuine sites carry their element
-- routes in the SEPARATE `implRef` (primary is `RKey key []`), so `snd` is non-empty and
-- the adapter stamps it into `implRef`; nested/top PACK their `requires` into the primary
-- RKey (byte-identical to the pre-S3b `routeOfD`) and leave `snd` empty.
--   * assum: EKNestedTop uses `activeDictVarForEncl`; EKReturn uses the enclDictVarOf-
--     preferring `activeDictVarOfEncl`.  EKReturn routes RDictFwd when the method is
--     return-position (name∈rpNames), else RDict; EKNestedTop routes RDict.
--   * inst: EKReturn upgrades the head tag to the canonical full-type key (`keyForSite`)
--     and fills element routes via `implDictRoutesForFull`; EKNestedTop stamps the
--     canonical key of the min⊑ winner + `argImplRequiresRoutes`-packed requires (with
--     the W2 depth fuse).
--   * fallback: EKReturn → RNone; EKNestedTop → the caller-supplied `Undetermined` policy.
-- #156 S3c wired arg-position + operator sites in (EKArg / EKOp below).
data EntailKind =
  -- return-position method site: the method's full (un-stripped) mono (for
  -- ifaceParamMonos), and whether the method is return-position.
  | EKReturn Mono Bool
  -- nested-element / top-level constrained call: iface, undetermined policy, and the
  -- `requires`-recursion fuse — which is TWO Ints since #1576, not one depth counter:
  --   • [prevSize] — the structural size (`monoSizes`) of the goal VECTOR of the
  --     `argImplRequiresRoutes` level that spawned this sub-goal, or 0 at a seed site
  --     ("no parent"; a real goal vector always measures ≥ 1, so 0 is unambiguous).
  --   • [spent]    — how many NON-SHRINKING steps this chain has taken.  Only these
  --     burn fuel; a step whose goal is structurally smaller than its parent's is
  --     free, because such a chain is guaranteed to terminate on its own.
  -- See `argImplRequiresRoutes` for the whole argument.
  -- #1154 (F-3a): the predicate's goal args PAST arg 0.  Arg 0 stays in `entail`'s
  -- own [m] (it keys `assum` and supplies the head tag), so this field holds only the
  -- TAIL — storing the whole vector would duplicate arg 0 and let the two copies
  -- drift.  `[]` at every caller with no vector to offer, which reproduces the
  -- pre-#1154 singleton exactly.  Same pattern as EKReturn/EKArg carrying the
  -- `fullMono` only THEY need.
  | EKNestedTop String Undetermined Int Int (List Mono)
  -- #156 S3c: arg-position stamp (resolveArgStamp).  assum =
  -- activeDictVarOfEncl → RDict (never RDictFwd; arg-position); inst = same canonical
  -- RKey primary as EKReturn but element routes via argImplDictRoutesForEncl keyed on
  -- the (default-reduced) method; fallback = RNone (the load-bearing do-nothing arm).
  -- #609: also carries the method's full occurrence mono, so this kind can recover
  -- the interface's whole param vector (ifaceParamMonos) exactly as EKReturn does.
  -- Without it the arm could only ever see arg 0 — and the arg-position leg is the
  -- one an ordinary `ix 1 'x'` call takes, so this is where #609 landed.
  | EKArg Mono
  -- #156 S3c: operator site (resolveOpSite).  isBinop and the in-impl-body flag
  -- (for opDictVarOf's dict-var policy).  assum = opDictVarOf → RDict;
  -- inst = stampOpRouteVal (builtin head → RNone, else RKey with reqs PACKED in — no
  -- separate implRef); fallback = RNone.  Both do-nothing arms preserved by the adapter's
  -- RNone guard (op-site refs are always Ref RNone-seeded — parser/desugar).
  | EKOp Bool Bool

-- 🚨 THE LADDER'S SELECTOR-REACHABILITY PROPERTY, inscribed so the next refactor
-- cannot violate it silently.  Every impl-row SELECTOR call reachable from `entail`
-- lies in an `inst` arm (`entailInst`) or in an element-route helper called from one.
-- No selector call may be reachable from `entailAssum`, `entailAssumVar` or
-- `entailAssumRoute` — verified at this pin by enumerating the assum chain
-- (`activeDictVarOfEncl`/`activeDictVarForEncl`/`enclDictVarOf`/`opDictVarOf`/
-- `activeDictPredOf`/`ifaceOfMethodName`): every one is a `perRun` registry lookup and
-- none reaches a selector.
--
-- ⚠️ `entailFallback` HAS ONE REACHING PATH, AND IT IS NOT A VIOLATION — but it is why
-- the rule above stops naming it.  `EKNestedTop`'s `CountImpls` policy goes
-- `undeterminedRoute` → `routeUndeterminedTop`, which answers THIS goal by COUNTING
-- (`implHeadTagsForIface`, exactly-one → that tag; two or more → `T-AMBIGUOUS-INSTANCE`),
-- never by selection — and only THEN routes the chosen impl's own nested `requires`
-- through `argImplRequiresRoutes` → `selectReqImpl`, which is a FRESH sub-goal
-- descending the ladder again, not this goal being answered on a later rung.  A refactor
-- that let the fallback rung answer the ladder's own goal by selection IS the violation
-- this property forbids; the `KeepNone` policy (every element-dict recursion) cannot
-- reach even this path.
--
-- WHY IT MATTERS.  DICT-SEMANTICS §3 pins the precedence: `assum` strictly precedes
-- `inst`, which strictly precedes `fallback`.  Letting a later rung answer a goal an
-- earlier rung could have answered re-routes a dict cell from a CALLER-SUPPLIED
-- PARAMETER to a STATICALLY SELECTED impl — the wrong value, at exit 0, with no
-- diagnostic.  A selector call sitting on an `assum` or `fallback` arm is precisely how
-- that happens, which is why this is a placement rule and not a tidiness point.
--
-- 🚨 IT IS A REACHABILITY PROPERTY, NOT A COUNT — AND THE COUNT FORM IS FALSE ON A
-- CORRECT TREE.  There are legitimately TWO selector calls per `inst` arm: one for the
-- primary route word, one inside the element-route helper.  At `EKArg` and `EKOp` those
-- two deliberately ask about DIFFERENT methods — the element helper is keyed on the
-- `innerDefaultMethod`-reduced name when the head's impl does not itself define the
-- method (`ieDefinesReqMethodAt`).  Any *"one selector call per arm"* rule would license
-- collapsing them, which changes WHICH IMPL'S CONTEXT IS DISCHARGED (§6 C2).  Do not
-- restate this property in the count form.
--
-- ⚠️ AND A GREP OF `ieSelectRowBy*` IS NOT THE CHECK.  `concreteReqMatchByIface` is a
-- LEGITIMATE selector call outside this ladder — it is the obligation channel's evidence
-- check, not a routing decision — and is out of scope here.  An audit that greps the
-- selector names without excluding it reports a false violation.
-- 🚨 THE `inst` ARM PROJECTS THROUGH `headTyconMono`, THE DISPATCH-KEY PROJECTION,
-- NOT THROUGH THE `headTyconNameMono` RESIDUAL IT READ UNTIL #1617.  This is the
-- SAME repoint A-2.2b made at `goalHeadCon` and the three `implExistsForHead`
-- receiver sites, arriving one site late: `entail` is a ROUTING decision (its
-- result is stamped straight into a site's route ref by `resolveArgStamp`), so it
-- owes the goal-side dispatch key, and the name-only residual can no longer
-- express that argument now that the two answer differently at `TFun`.
--
-- MEASURED, this line alone is what kept #1617 open after both head projections
-- and both definition-side tags already agreed on `__fun__`: an arg-position
-- occurrence (`sz : a -> Int` dispatches on its ARGUMENT, so it is stamped here
-- and not by `resolveSites`) took the `None => entailFallback` arm, left the site
-- `RNone`, and the emitter arg-tag-dispatched over a closure.  The typed Core-IR
-- dump showed `CMethod "sz" RNone` beside two correctly-tagged
-- `CImplTagged "__fun__"` entries — impl side fixed, goal side fixed, route still
-- unstamped.
--
-- ⚠️ The name is projected INSIDE the arm, not with `map headKeyName` over the
-- `Option` — same reason `headTyconNameTy`/`headTyconNameMono` exist at all
-- (`compiler/AGENTS.md`): Medaka is strict, so the combinator spelling would
-- allocate a second `Option` on every entailment to throw it away.
entail : ImplBuckets -> String -> Mono -> String -> EntailKind -> (Route, List Route)
entail implTable name m encl kind = match entailAssum m encl name kind
  Some dname => (entailAssumRoute dname kind, [])
  None => match headTyconMono m
    Some hk => entailInst implTable name m encl (headKeyName hk) kind
    None => (entailFallback implTable kind, [])

-- #412: `assum`, both halves.  DICT-SEMANTICS §3 pins the precedence — `assum`/`super`
-- takes precedence over `inst`; a predicate already in scope is USED, and `inst` fires only
-- when no assumption matches (GHC's rule) — which is what makes :160's "sub-evidence is
-- never pre-baked at the instance declaration" realisable.  The tyvar-keyed registry runs
-- first and unchanged; the predicate-keyed one (registerPredGiven) then answers the
-- STRUCTURED given (`requires S (List a)`) that `activeDictVarOf` structurally cannot see,
-- because it recurses to the spine head and a structured subject has a TCon there.
-- Strictly additive: every goal the tyvar path already answers routes exactly as before.
entailAssum : Mono -> String -> String -> EntailKind -> Option String
entailAssum m encl name kind = match entailAssumVar m encl name kind
  Some dname => Some dname
  None => match ifaceOfMethodName name
    Some iface => activeDictPredOf iface (goalVecOfKind name m kind) encl
    None => None

-- #1956: the GOAL PREDICATE's whole argument vector at this site, which is what the
-- vector-keyed given registry is keyed on.  Each arm is the SAME projection `entailInst`
-- selects its impl row on, one rung down the ladder — so the rung that ANSWERS a goal
-- from an in-scope dict and the rung that SELECTS an impl for it ask about one and the
-- same predicate.  Reading `m` alone here is #1956: `m` is a single position (the
-- discriminating mono), and a multi-parameter predicate is not identified by it.
--   * EKReturn / EKArg — `ifaceParamMonos`, exactly `entailInst`'s `paramMonos`/`goals`,
--     falling back to `[m]` when the method has no registered interface (unchanged
--     single-position behaviour for a plain `=>`-constrained fn).
--   * EKNestedTop — `m::rest`: the kind stores only the TAIL past arg 0 on purpose (arg
--     0 lives in `entail`'s own [m] so the two copies cannot drift), and `entailInst`'s
--     own arm reassembles it the same way for `keyForSiteByIface`.
--   * EKOp — `[m]`: an operator node carries one operand mono and no method occurrence,
--     so no vector is recoverable; every operator interface is single-param anyway
--     (`goalPredOfOp` and `stampOpRouteVal` say the same).
goalVecOfKind : String -> Mono -> EntailKind -> List Mono
goalVecOfKind name m (EKReturn fullMono _) =
  fromOption [m] (ifaceParamMonos name fullMono)
goalVecOfKind name m (EKArg fullMono) =
  fromOption [m] (ifaceParamMonos name fullMono)
goalVecOfKind _ m (EKNestedTop _ _ _ _ rest) = m::rest
goalVecOfKind _ m (EKOp _ _) = [m]

-- assum: which in-scope dict-param (if any) does [m]'s head constraint var read?  The
-- genuine/arg kinds prefer the enclosing method's own slot (activeDictVarOfEncl); the
-- nested/top kind uses the plain encl-aware lookup (activeDictVarForEncl); the op kind
-- routes through opDictVarOf (isBinop/inImpl-keyed, needs the method [name]).  [name] is
-- ignored by the non-op kinds.
entailAssumVar : Mono -> String -> String -> EntailKind -> Option String
-- #1177: the genuine/arg kinds now hand `activeDictVarOfEncl` the site's PREDICATE —
-- [name]'s interface plus the vector `ifaceParamMonos` recovers from the kind's own
-- full occurrence mono, the SAME vector `entailInst` selects the impl row on — so the
-- slot the body reads and the impl the site dispatches to answer one question.  The
-- nested/top kind keeps `activeDictVarForEncl` (no predicate: [name] there is a
-- constrained FUNCTION, not a method occurrence).
entailAssumVar m encl name (EKReturn fullMono _) =
  activeDictVarOfEncl (goalPredOf name fullMono) m encl
entailAssumVar m encl _ (EKNestedTop _ _ _ _ _) = activeDictVarForEncl m encl
entailAssumVar m encl name (EKArg fullMono) =
  activeDictVarOfEncl (goalPredOf name fullMono) m encl
entailAssumVar m encl name (EKOp isBinop inImpl) =
  opDictVarOf isBinop name m inImpl encl

entailAssumRoute : String -> EntailKind -> Route
entailAssumRoute dname (EKReturn _ isRp) =
  if isRp then
    RDictFwd dname
  else
    RDict dname
entailAssumRoute dname (EKNestedTop _ _ _ _ _) = RDict dname
entailAssumRoute dname (EKArg _) = RDict dname
entailAssumRoute dname (EKOp _ _) = RDict dname

-- inst: a concrete head [tag].  EKReturn → canonical full-type key + split element routes
-- (implRef-bound); EKNestedTop → the min⊑ winner's canonical key (bare head only when the
-- iface-keyed collision gate is False — see the arm's own body comment) with requires PACKED
-- into the primary RKey;
-- EKArg → same canonical RKey primary as EKReturn but element routes keyed on the
-- (default-reduced) method via argImplDictRoutesForEncl; EKOp → stampOpRouteVal (builtin
-- head → RNone do-nothing, else RKey with reqs packed in, no separate element routes).
entailInst : ImplBuckets -> String -> Mono -> String -> String -> EntailKind -> (Route, List Route)
-- #609: the goal is the interface's FULL param-mono vector `τ̄` (§5: "the dispatch
-- type is the instantiated vector"), not the result mono alone — and it is the SAME
-- vector `implDictRoutesForFull` already recovered for element grounding, so the
-- selector and the requires router now agree on one goal by construction.  A method
-- with no registered interface (ifaceParamMonos → None) still selects on [m],
-- exactly as before.
entailInst implTable name m encl tag (EKReturn fullMono _) =
  let paramMonos = fromOption [m] (ifaceParamMonos name fullMono)
  let routeKey = fromOption tag (keyForSite name paramMonos)
  (RKey routeKey [], implDictRoutesForFull implTable encl name tag m paramMonos)
-- #203 (E, the root fix): mirror EKReturn.  Was `RKey tag …` — a BARE ambiguous head
-- tag whose constructor carried no KeyBuckets, so it could not reach the min⊑ selector;
-- every nested-`requires` and super-projection goal funnels through here.  Now the
-- primary route is the canonical key of the MOST-SPECIFIC impl (iface-keyed, head-
-- collision-gated exactly like keyForSite ⇒ a non-overlapping site keeps its bare tag,
-- byte-identical), and the packed requires come from that same winner (F).
-- #1154 (F-3a): a nested/top `requires` goal is a PREDICATE, so its goal is the
-- predicate's whole argument vector (§3 `match(IE, C τ̄)`), not its subject mono.
-- `argReqRoute` used to keep `(arg::_)` and drop the rest, so `requires Ix a Char`
-- arrived here as the singleton `[Int]`; `entryHeadMatches` then took its arg-0
-- fallback, `Ix Int Bool` and `Ix Int Char` both "matched", `entryCovers` found them
-- incomparable, and `pickMostSpecificEntry` returned the FIRST-DECLARED — so swapping
-- two impl blocks changed the program's answer, at exit 0, on both engines (#1154).
-- [rest] is `[]` at every caller that has no vector, so those sites are unchanged.
-- #1161 (F-3a-ii) now threads the OTHER leg through this same arm.  The top-level
-- `=>`-constrained-call leg reaches here via `routesOfMonosTopV` → `topRouteV` →
-- `routeOfD`, carrying the goal vector recorded at SIGNATURE REGISTRATION
-- (funConstraintArgsRef).  ⚠️ The claim this comment used to make — that that leg "has
-- no vector to thread" — was wrong: the vector is built from the signature, and
-- recording it beside `funConstraintsRef` (rather than inside it) leaves the SHATTERED
-- per-tyvar dict slots, and hence emitted dict arity, exactly as they were.  #607
-- punch-list item 3 (dict slot = predicate, which really would move arity) stays open.
entailInst implTable _ m encl tag (EKNestedTop iface _ prevSize spent rest) =
  -- 🚨 B-4b-ii LEFT THIS BARE ON PURPOSE, AND THE REASON IS THE SOURCE, NOT THE
  -- PLUMBING.  Widening `EKNestedTop`'s field is mechanical; the question is whether
  -- anything upstream HAS an origin worth supplying, and on this leg it does not.
  -- `EKNestedTop` is constructed at exactly one site (`routeOfD`), whose `iface`
  -- reaches it from `routesOfMonosTop`/`routesOfMonosTopV` — whose `List String` is
  -- minted by `shadowStandaloneDictSlots` and `pushDictApp` as `map (s =>
  -- s.csIface.irName) expanded`, a projection those two functions' own comments
  -- declare deliberate ("the ROUTE half stays a SPELLING … route words, not
  -- identities").  Un-projecting it is the route-word design question (#1507 /
  -- `dispHeadTab`), not an identity-supply omission, so inventing an origin here
  -- would be supplying one from a source this bite cannot justify.
  --
  -- ⚠️ AND THE CONSUMER WOULD NOT SURVIVE IT UNEXAMINED.  This value reaches BOTH
  -- `keyForSiteByIface` (below) and `argImplRequiresRoutes` (the same `iface`, one
  -- line down — §6 C2 forbids repointing those separately, which is exactly why they
  -- share the variable).  `keyForSiteByIface` gates the stamped word on
  -- `ieHeadCollidesByIface`, whose count stays SPELLING-keyed by ruling, so a
  -- selection that moved without the count moving flips the word between the
  -- canonical key and the bare head tag — a dict-cell byte change
  -- `core_ir_lower.ifaceDeclHeadUnique` does not follow.  Whoever supplies identity
  -- here owns that decision explicitly.
  --
  -- 🚨 THIS PARAGRAPH USED TO CLAIM LEAVING IT BARE WAS "MEASURED SAFE FOR WHAT B-4b-ii
  -- DID MOVE".  THAT IS FALSE, AND THE FALSIFYING PROGRAM IS ONE EDIT AWAY FROM THE
  -- FIXTURE THE CLAIM CITED.  What is actually true is narrower, and the boundary is the
  -- METHOD NAMES:
  --
  --   * DISJOINT method names (`bar` vs `foo`) — safe, and measured:
  --     `test/dict_fixtures/b4bii-xmod-req-route-leg-still-spelling` routes correctly on
  --     all three engines and in the executed binary.  The METHOD-keyed selector
  --     disambiguates the two same-spelled classes for free, because each class's method
  --     name occurs in exactly one of them.  The cited fixture had that property, which
  --     is precisely why it could not falsify the claim it was cited for.
  --   * COLLIDING method names (`m` vs `m`) — NOT safe.  That disambiguation vanishes and
  --     the built binary prints the OTHER class's value at exit 0.
  --
  -- 🚨 BUT THE CAUSE IS NOT THIS SEAM, AND A DRAFT OF THIS COMMENT SAID IT WAS.  It read:
  -- "the route leg's spelling scan reaches the OTHER module's row", and cited a pin of
  -- its own.  DISCRIMINATING EXPERIMENT, measured 2026-08-16 on both arms: take that
  -- program and change ONLY the two interfaces' NAMES so they no longer collide
  -- (`SameA`/`SameZ`), keeping the shared method name — the base binary then ACCEPTS (no
  -- false reject, the spellings differ) and BOTH arms still print the wrong value.  So
  -- the wrong dispatch is driven ENTIRELY by the shared METHOD name — `matchingEntries`
  -- selecting candidates by method-name membership rather than by interface (#1182) —
  -- and the interface-spelling collision this seam is about contributes NOTHING to it.
  -- The draft pin was deleted on that evidence and the fact ported into #1182's own
  -- fixture (`test/must_fail_fixtures/1182-two-ifaces-same-method-name-order-decides`).
  --
  -- ⚠️ WHAT IS STILL TRUE, AND IS THIS BITE'S TO OWN: that defect is PRE-EXISTING (with
  -- an `Eq`-bearing payload both arms accept, both print the same wrong value, and the
  -- emitted IR is BYTE-IDENTICAL), and B-4b-ii removes a FALSE REJECT that was
  -- accidentally SHIELDING it on the same-spelled variant — so the observable there moves
  -- loud → silent.  Under `AGENTS.md`'s ladder that is a severity INCREASE, which is why
  -- it is recorded rather than left for the next reader to rediscover.
  --
  -- The lesson for the next bite at this seam: a wrong answer downstream of an
  -- interface-spelling collision is NOT evidence that the interface-spelling seam caused
  -- it.  Vary the collision away and re-measure before attributing.
  let routeKey = fromOption tag (keyForSiteByIface (ifaceRefBare iface) (m::rest))
  (
    RKey routeKey (argImplRequiresRoutes implTable iface encl tag m rest prevSize spent),
    [],
  )
-- #609: select on the interface's FULL param vector (§5 — the dispatch type is the
-- instantiated vector `T̄`), not on the discriminating ARGUMENT's mono alone.
-- [goals] is bound ONCE and fed to BOTH arms: the method route (`routeKey`) and the
-- selected impl's own `requires`-context routes.  That is not a tidiness point — §6
-- C2 requires the impl dispatched to and the impl whose context is discharged to be
-- the SAME impl, and the first cut of this fix computed the vector here and then
-- handed the scalar `m` to argImplDictRoutesForEncl, so the two arms could select
-- differently at n≥2.  Sharing one binding makes them agree by construction.
entailInst implTable name m encl tag (EKArg fullMono) =
  let goals = fromOption [m] (ifaceParamMonos name fullMono)
  let routeKey = fromOption tag (keyForSite name goals)
  -- ARCH B-2.1-h: graph-global, off `bodyImplEnvRef` — see `ieDefinesReqMethodAt`,
  -- which carries the measured repro.  The head is `headTyconMono m`, the `HeadKey`
  -- whose name IS this arm's `tag` (`entail` derives `tag` from the same `m` via
  -- `headTyconNameMono`), NOT `goalHeadCon goals` — this guard has always asked about
  -- the DISCRIMINATING mono's head, and re-aiming it at the vector's head would be a
  -- second, unrelated semantic change at n>=2.
  let dictName = if ieDefinesReqMethodAt perRun.value.bodyImplEnvRef.value name (headTyconMono m) then
    name
  else
    innerDefaultMethod name
  (
    RKey routeKey [],
    argImplDictRoutesForEncl implTable encl dictName tag m goals,
  )
entailInst implTable name m _ tag (EKOp isBinop _) =
  (stampOpRouteVal isBinop implTable name m tag, [])

entailFallback : ImplBuckets -> EntailKind -> Route
entailFallback _ (EKReturn _ _) = RNone
entailFallback implTable (EKNestedTop _ policy _ _ _) =
  undeterminedRoute implTable policy
entailFallback _ (EKArg _) = RNone
entailFallback _ (EKOp _ _) = RNone

-- ONE constrained-call-arg route resolver — collapses routeOfMono (encl="",
-- KeepNone) / routeOfMonoEncl (KeepNone) / routeOfMonoTop (encl="", CountImpls).
-- [encl] == "" ⇒ global activeDictVarOf (activeDictVarForEncl short-circuits); else
-- the enclosing method's own constraint-var dict.  [policy] decides the undetermined
-- arm (see Undetermined).
routeOf : ImplBuckets -> String -> String -> Undetermined -> Mono -> Route
routeOf implTable iface encl policy m =
  routeOfD implTable iface encl policy m [] 0 0

-- #217: fuse-carrying core of routeOf.  [prevSize]/[spent] thread the WS-4b fuse
-- through the aware recursion (routeOfD → argImplRequiresRoutes → argImplReqRoutes
-- → argReqRoute → routeOfD), the guard retained from the removed blind chain so a
-- non-shrinking impl context (`impl C (T a) requires C (T (T a))`) terminates instead of
-- diverging at route-resolution time.  Both are unchanged here; they are recomputed once
-- per impl level in argImplRequiresRoutes, which owns the whole shrinking argument.
-- #1154 (F-3a): [rest] carries the predicate's goal args past arg 0 (see EKNestedTop).
routeOfD : ImplBuckets -> String -> String -> Undetermined -> Mono -> List Mono -> Int -> Int -> Route
-- #156 S3b: a thin adapter over `entail` (EKNestedTop kind).  The nested/top ladder
-- packs its `requires` into the primary RKey, so `snd` is empty and only `fst` is read —
-- byte-identical to the pre-S3b arm-by-arm body.  The requires recursion still lands back
-- here via argImplRequiresRoutes → argImplReqRoutes → argReqRoute → routeOfD, with the
-- fuse pair threaded through the EKNestedTop payload.
routeOfD implTable iface encl policy m rest prevSize spent =
  fst (entail
    implTable
    ""
    m
    encl
    (EKNestedTop iface policy prevSize spent rest))

undeterminedRoute : ImplBuckets -> Undetermined -> Route
undeterminedRoute _ KeepNone = RNone
undeterminedRoute implTable (CountImpls prog iface) =
  routeUndeterminedTop prog implTable iface

-- TOP-LEVEL constraint routes (a constrained-fn CALL site, e.g. `roundtrip 10`).
-- Like routesOfMonos but passes the CountImpls policy to routeOf, so the UNDETERMINED
-- case resolves via routeUndeterminedTop instead of the nested-recursion RNone (which
-- yields an empty dict → runtime `intToString: not an Int` / a null build dict): look
-- up how many impls of the slot's interface exist:
--   • exactly ONE  → stamp a concrete RKey to that impl's head tag (deterministic
--                    dispatch on both run and build);
--   • two or more  → genuinely ambiguous → pushTypeError AmbiguousImpl (DELIBERATELY
--                    diverges from the frozen oracle's silent first-wins);
--   • zero         → keep RNone (existing no-impl behaviour/error).
-- #1161 (F-3a-ii): the vector-aware form.  Slot COUNT, slot ORDER and the number of
-- Routes produced are IDENTICAL to routesOfMonosTop's — the ONLY difference is the
-- GOAL each slot is selected with.  That is what keeps the change arity-neutral:
-- dictArityOf / dictPass / scopeArities and the cross-module arity snapshot all read
-- funConstraintsRef, whose payload this leaves untouched.
--
-- #1909 REWRITES THE INVARIANT THIS HEADER USED TO STATE.  It read: the widening is
-- "GATED ON `listLen v > 1` (topRouteV's two-cons pattern), so a 1-ary `=>` constraint —
-- which is every `=>` constraint in compiler + stdlib + sqlite — takes the SAME `routeOf`
-- call routesOfMonosTop makes, term for term.  The 1-ary path is therefore byte-identical
-- BY CONSTRUCTION."  That was the #1161 (F-3a-ii) gate, and #1909 is the case its own
-- closing caveat predicted: byte-identity held for the compiler's bare-tyvar constraints
-- and never held for a STRUCTURED single-subject one.
--
-- THE CORRECTED INVARIANT.  There is no length gate; `vectorGoal` declines only an EMPTY
-- vector or an unknown interface.  Byte-identity with routesOfMonosTop is now a property
-- of the VECTOR'S CONTENT, not of its length:
--   • vector `[m]` where the recorded argument IS the slot's own mono (every bare-tyvar
--     `=>` constraint — which is still every `=>` constraint in compiler + stdlib +
--     sqlite): `routeOfD … g0 [] 0 0` with `g0 == m` is `routeOf … m` term for term, so
--     those callers are byte-identical BY CONSTRUCTION exactly as before;
--   • vector `[Wrap a]` against slot mono `a` (a structured single-subject predicate):
--     routes on `Wrap a`, which is the whole point — see `vectorGoal`;
--   • no vector at all: the `[]` arm below, still the untouched scalar router.
-- Slot COUNT, slot ORDER and the number of Routes produced are unchanged either way,
-- which is what still keeps this arity-neutral.  The self-compile fixpoint proves
-- absence-of-regression, never correctness of the new path — as before.
routesOfMonosTopV : List Decl -> ImplBuckets -> List Mono -> List String -> List (List Mono) -> List Route
-- no vectors at all (a caller with nothing to offer) ⇒ the scalar router, unchanged.
routesOfMonosTopV prog implTable monos ifaces [] =
  routesOfMonosTop prog implTable monos ifaces
routesOfMonosTopV _ _ [] _ _ = []
routesOfMonosTopV prog implTable (m::rest) [] (_::vs) =
  routeOf implTable "" "" (CountImpls prog "") m ::
    routesOfMonosTopV prog implTable rest [] vs
routesOfMonosTopV prog implTable (m::rest) (iface::ifacesRest) (v::vs) =
  topRouteV prog implTable iface m v ::
    routesOfMonosTopV prog implTable rest ifacesRest vs

-- one slot.  A multi-argument predicate hands `routeOfD` the goal TAIL (arg 0 stays in
-- `routeOfD`'s own `m`, exactly as EKNestedTop documents), so the selector sees
-- `Ix Int Char` instead of the shattered `Ix Int _` and `ieEntriesForIface`
-- returns a singleton.
-- ⚠️ The vector's arg 0 — NOT this slot's own mono — is the predicate head.  The two
-- differ whenever a predicate shatters into more than one slot (`Ix a b` gives the `b`
-- slot the mono of `b`, while the predicate's arg 0 is `a`'s): both slots are evidence
-- for the SAME predicate, so both must select on the same goal.  That is what
-- `vectorGoal` returning the head separately encodes; the scalar arm keeps [m].
topRouteV : List Decl -> ImplBuckets -> String -> Mono -> List Mono -> Route
topRouteV prog implTable iface m goals = match vectorGoal iface goals
  Some (g0, gs) => routeOfD implTable iface "" (CountImpls prog iface) g0 gs 0 0
  None => routeOf implTable iface "" (CountImpls prog iface) m

-- `Some (arg0, tail)` exactly when the widening applies: a NON-EMPTY argument vector
-- under a KNOWN interface.  Everything else is None ⇒ the scalar route.
-- #1909: the length-1 declining clause (`vectorGoal _ [_] = None`) is GONE.  It made a
-- 1-ary predicate select on the SLOT's mono instead of on the vector's own argument —
-- byte-identical while the two coincide (`Shw a => …` records `[a]`, so arg 0 IS the
-- slot mono) and WRONG the moment they do not (`Tag (Wrap a) => …` records `[Wrap a]`
-- against slot mono `a`, so the call site keyed its dict on `Bool` where the predicate
-- is `Tag (Wrap Bool)`).  Arity is not what makes a vector meaningful; a recorded
-- argument that differs from the slot's own mono is.
-- ⚠️ `iface == ""` is pinned scalar deliberately: with no interface there is no arity
-- to give a vector meaning, and `argImplRequiresRoutes`'s own iface-unknown arm pins
-- its `goals` to `[m]` for the same reason (#1168).  Holding the pin on BOTH sides is
-- what keeps that function's soundness argument true now that this is its second
-- non-empty-`rest` caller — see the re-derivation in its header.  Dropping the length-1
-- clause does not touch that pin: it only widens WHICH non-empty vectors get past it.
vectorGoal : String -> List Mono -> Option (Mono, List Mono)
vectorGoal _ [] = None
vectorGoal iface (g0::gs) = if iface == "" then None else Some (g0, gs)

routesOfMonosTop : List Decl -> ImplBuckets -> List Mono -> List String -> List Route
routesOfMonosTop _ _ [] _ = []
routesOfMonosTop prog implTable (m::rest) [] =
  routeOf implTable "" "" (CountImpls prog "") m ::
    routesOfMonosTop prog implTable rest []
routesOfMonosTop prog implTable (m::rest) (iface::ifacesRest) =
  routeOf implTable iface "" (CountImpls prog iface) m ::
    routesOfMonosTop prog implTable rest ifacesRest

-- the undetermined-constraint resolution: count impls of [iface] in [prog].
routeUndeterminedTop : List Decl -> ImplBuckets -> String -> Route
routeUndeterminedTop prog implTable iface
  | iface == "" = RNone
  | otherwise = match implHeadTagsForIface prog iface
    [] => RNone
    -- #1110: `tag` arrived as a bare `String` from `implHeadTagsForIface`, which
    -- projects an impl head through `headTyconTy` and DISCARDS the `Ty` that
    -- carried the identity — so there is no origin to acquire at this site, only
    -- one to invent.  `tconUnresolved`, not `tconBuiltin`: an impl head is not a
    -- builtin.  Recovering it means giving `implHeadTagsForIface` an
    -- origin-carrying return type; that is a consumer change, not this carrier's.
    [tag] => RKey tag (argImplRequiresRoutes implTable iface "" tag (tconUnresolved tag) [] 0 0)
    _ => reportAmbiguousImpl iface

reportAmbiguousImpl : String -> Route
reportAmbiguousImpl iface =
  let _ = pushTypeError "T-AMBIGUOUS-INSTANCE" (ambiguousImplMsg iface)
  RNone

-- every impl head tycon for [iface] declared in [prog] (a single-arg interface has
-- one head ty per impl; we read its head tycon).  Dedups so a prelude impl imported
-- twice via multi-module loading doesn't read as ambiguous.
implHeadTagsForIface : List Decl -> String -> List String
implHeadTagsForIface prog iface =
  dedup (flatMap (implHeadTagForIface iface) prog)

implHeadTagForIface : String -> Decl -> List String
implHeadTagForIface want (DAttrib _ d) = implHeadTagForIface want d
-- ⚠️ `censusHeadNameTy`, NOT `headTyconNameTy`: this is the ACCEPTANCE census
-- (one head → stamp it, two or more → `T-AMBIGUOUS-INSTANCE`), so an arrow- or
-- effect-headed impl must stay DROPPED here the way it was before #1617/#1618.
-- The derivation is at `headTyNode`.
implHeadTagForIface want (DImpl { iface, tys, ... })
  | iface == want = match tys
    headTy::_ => match censusHeadNameTy headTy
      Some tag => [tag]
      None => []
    [] => []
  | otherwise = []
implHeadTagForIface _ _ = []

ambiguousImplMsg : String -> String
ambiguousImplMsg iface = "Ambiguous instance for `"
  ++ iface
  ++ "`. Cannot determine which impl; add a type annotation"

routesOfMonos : ImplBuckets -> List Mono -> List Route
routesOfMonos _ [] = []
routesOfMonos implTable (m::rest) =
  routeOf implTable "" "" KeepNone m :: routesOfMonos implTable rest

-- Native #54/#21 residual: the activeDictVar-AWARE requires recursion.  Recursing
-- via routeOf (not the removed blind reqRoute) keeps every nesting level
-- activeDictVar-aware: e.g. a `Debug (Map k v)` impl body's `debug (toList m)` arg-
-- stamps `List (k, v)` → RKey "List" recursing into the tuple `(k, v)` whose element
-- vars `k`/`v` ARE the enclosing impl's `requires Debug k, Debug v` dict params
-- (registered in activeDictVars), so they route RDict $dict_debug_<slot>, NOT RNone.
-- The emitted element-dict cell carries the live impl dicts instead of a null (0)
-- field — the null field was the SIGSEGV (the inner per-element debug/eq/compare
-- dispatched through a 0 dict).
-- #217: this is now the SOLE requires recursion — the return position
-- (implDictRoutesIn) routes through here too, no longer through a blind twin.  [encl]
-- threads the enclosing method so nested element dicts forward its own
-- `$dict_<encl>_<slot>` params (encl == "" recovers the global routing).
-- #217/WS-4b: the fuse guards a non-shrinking impl context (`impl C (T a) requires C
-- (T (T a))`) — RETAINED from the removed blind chain, now on the aware
-- recursion so unifying the two chains did not import a typecheck hang.  On limit-hit we
-- return [] (RNone element → null cell).  (#1154
-- folded away the depth-0 wrapper `argImplRequiresRoutesRec`: two names for one body,
-- one caller each.  Seed `[] 0 0` at an entry point instead.)
--
-- 🚨 #1576 REPLACED THE FLAT `depth >= 32` COUNTER WITH A SHRINKING TEST, BECAUSE THE
-- FLAT COUNTER WAS SILENTLY WRONG ON VALID PROGRAMS AND THE OLD COMMENT HERE SAID IT
-- COULD NOT BE.  It claimed "depth 32 is ample for valid programs (real nesting rarely
-- exceeds 3–4 levels)" and "safe because such an impl is ill-formed and never produces a
-- valid concrete instantiation in a well-typed program".  Both halves are false for a
-- GROUND chain: `impl Tag (Wrap a) requires Tag a` applied to `Wrap^34 Int` is perfectly
-- well-formed, reaches this function at depth 34 through the RETURN-position chain
-- (`implDictRoutesForFull` → `argImplReqRoutes` → `argReqRoute` → `routeOfD` → `entail`
-- (EKNestedTop) → here), and the `[]` DROPPED A REAL `requires`.  The emitted witness
-- (`emitConstDictCell`, `backend/llvm_emit.mdk`) then carried a 1-word `Wrap` cell with
-- no nested `Tag a` dict; the innermost `tagOf` read a nonexistent field and the built
-- binary segfaulted, at exit 0 from `check` and `build`.  (Usable ground depth was
-- exactly 33, not 32, only because at 33 the level the fuse cut was terminal — `impl
-- Tag Int`, empty `requires` — so the truncated `[]` was accidentally the right answer.)
--
-- ⚠️ AND A BIGGER CONSTANT IS NOT THE FIX.  `residualPredsOf`'s own header already says
-- it ("any finite fuel has the same cliff; only making the cliff LOUD removes the silent
-- wrongness") and it was measured: 32 → 200 fixes `Wrap^34` and breaks `Wrap^202`.
--
-- THE ACTUAL DISTINCTION, and why this chain differs from `residualPredsOf`'s flat fuel.
-- `residualPredsOf` guards a DEFERRED, possibly-cyclic walk where 32 really is arbitrary.
-- The chain THIS function drives reduces a GOAL, and the interesting population reduces
-- it STRUCTURALLY: each `requires` sub-goal of `impl Tag (Wrap a) requires Tag a` is one
-- `Wrap` layer smaller than the goal that spawned it.  Such a chain terminates by
-- construction, and its natural bound is the SIZE of the goal being reduced — not a
-- constant.  So:
--   • [prevSize] is the parent level's goal-vector size (`monoSizes`), 0 at a seed;
--   • a step whose own goal vector is STRICTLY SMALLER than [prevSize] is SHRINKING and
--     costs no fuel — a shrinking chain therefore compiles at ANY depth its type needs;
--   • every other step (including a seed's first level, which has no parent to compare
--     against) burns one unit of [spent], and 32 of those still trip the fuse.
-- The pathological shape the fuse was written for is caught FASTER than before, not
-- slower: `impl C (T a) requires C (T (T a))` GROWS its goal every step, so every step is
-- non-shrinking and the fuse trips after 32 of them regardless of the type's size.
-- Termination overall: [spent] never decreases and caps at 32, and between two
-- fuel-burning steps every step strictly decreases a natural number, so each shrinking
-- run is finite.
--
-- ⚠️ THE LIMIT-HIT ARM IS STILL SILENT, AND THAT IS NOT AN ENDORSEMENT.  A
-- `pushTypeErrorOnceAt` here is INERT today: this code runs inside `elabModuleStamp` /
-- `elaborateModules`, and `check`, `run` AND `build` all discard type errors pushed from
-- the `resolve*` stamp passes (measured 2026-08-24; see `keyForSite`'s header for the
-- `check` half, which is the only half that was written down).  That severed channel is
-- #1910.  When it is repaired, THIS arm is the first place a `T-REQUIRES-DEPTH` reject
-- belongs — the shrinking test narrows what reaches it to genuinely non-shrinking
-- contexts, which is exactly the population that deserves a loud reject.
--
-- #1154 (F-3a): [rest] is the predicate's goal args past arg 0.  [goals] is bound ONCE
-- and fed to BOTH the SELECTION and the head SUBSTITUTION — §6 C2 requires the impl
-- dispatched to and the impl whose context is discharged to be the SAME impl, and a
-- scalar select paired with a vector subst could bind an impl's trailing head vars
-- from a DIFFERENT impl's goal.  (`entailInst`'s EKArg arm binds its goals once for
-- exactly this reason.)
--
-- ⚠️ The iface-UNKNOWN arm (iface == "", the method-dict / untyped-fallback path) has
-- no interface and therefore no arity to give a vector meaning, so it stays SCALAR —
-- and `goals` is pinned to `[m]` there so the substitution is scalar too.  That is not
-- a special case bolted on: at `listLen goals == 1`, `headSubstWithParams h itys m [m]`
-- IS `matchTyMono h m` (augmentWithParams gates on `listLen paramMonos > 1`), so this
-- arm reduces to the pre-#1154 body term for term, algebraically.
--
-- ⚠️ Be precise about what that pin buys, because the obvious reading is wrong:
-- `selectReqImpl`'s `iface == ""` arm IGNORES [goals] entirely (it selects with
-- `findImplEntry … m`), so pinning `goals` there changes NOTHING about selection and is
-- inert on that consumer today.  Its only live effect is on the SUBSTITUTION, and it is
-- a FORWARD guard against the two drifting apart if that arm is ever made vector-aware.
--
-- #1161 (F-3a-ii) CORRECTION.  This comment used to add: "the property this function
-- actually rests on is NOT anything about `iface`: it is that **only `argReqRoute` ever
-- supplies a non-empty [rest]** … if a second non-empty-[rest] caller appears, re-derive
-- this."  `topRouteV` (the top-level `=>`-constrained call leg) is that second caller,
-- so the premise is now FALSE and the derivation has been redone:
--   • `iface == ""` ⇒ `goals == [m]`, so the iface-unknown arm is untouched however many
--     callers supply a vector.  `topRouteV` additionally declines to build one at all
--     when `iface == ""`, so the two pins agree from both ends.
--   • `iface /= ""` ⇒ selection runs through `ieSelectRowByIface`, which matches
--     `ifn == iface` and (for `iface == ""`) returns nothing either way.  A longer
--     [goals] can only make `entryHeadMatches` STRICTER — it is the arg-0 FALLBACK that
--     the short vector was triggering — so a second supplier cannot widen any match.
--   • selection and substitution still read the ONE `goals` binding, so §6 C2's
--     "dispatched-to impl == context-discharged impl" holds per caller, not per callsite
--     count.
-- The property this now rests on is therefore about the VALUE, not the caller census:
-- every caller either supplies `[]` (⇒ `goals == [m]`, byte-identical) or supplies a
-- vector under a non-empty `iface`.  A caller that supplies a non-empty [rest] with
-- `iface == ""` would be the shape to re-derive for; the `if iface == ""` pin below
-- neutralizes even that.
argImplRequiresRoutes : ImplBuckets -> String -> String -> String -> Mono -> List Mono -> Int -> Int -> List Route
argImplRequiresRoutes implTable iface encl tag m rest prevSize spent =
  -- #1576: the goal vector is bound BEFORE the fuse test now, because the fuse test
  -- reads it.  It is pure, so hoisting it costs a `monoSizes` walk on the limit-hit
  -- path and changes no answer.
  let goals = if iface == "" then [m] else m::rest
  let size = monoSizes goals
  -- SHRINKING ⇒ free.  No parent (`prevSize == 0`, a seed) ⇒ not shrinking, by
  -- definition rather than by measurement: there is nothing to have shrunk from.
  let spentNow = if prevSize > 0 && size < prevSize then spent else spent + 1
  if spentNow >= requiresNonShrinkingFuel then []
  else
    -- B-4b-ii: still bare, and NOT independently — this `iface` is the SAME value
    -- `entailInst`'s `EKNestedTop` arm hands `keyForSiteByIface` one line above its
    -- call to this function, which is how §6 C2 ("the impl dispatched to and the impl
    -- whose context is discharged must be the same impl") is held by construction
    -- rather than by care.  The reason it carries no origin is written there; moving
    -- one of these two without the other is the thing C2 forbids.  Its own `iface ==
    -- ""` pin in the `goals` binding above is the same sentinel `selectReqImpl`
    -- re-spells; both stay name-scoped.
    match selectReqImpl implTable (ifaceRefBare iface) tag m goals
      Some (headTy, itys, reqs) => match headSubstWithParams headTy itys m goals
        Some subst =>
          -- THIS level's goal size becomes the child's [prevSize] — that is the whole
          -- shrinking comparison, one parent/child pair at a time.
          argImplReqRoutes implTable encl subst reqs size spentNow
        None => []
      None => []

-- #203 (F): pick the impl whose `requires` this nested obligation must discharge.
--   • iface known → the MOST-SPECIFIC impl of that iface over the graph-global impl
--     universe (`IE`, §3 `inst` = min⊑) and ITS OWN requires — [] for a no-requires specific
--     impl (the `List Int` sibling), never the general `List a`'s.  The old
--     `findImplEntry` searched ImplBuckets (no-requires impls OMITTED) and first-matched,
--     so it was structurally blind to `List Int` and always returned `List a`'s requires.
--   • iface unknown ("" — the method-dict / untyped-fallback path, never the typed
--     dispatch of #203) → the historical first-by-tag `findImplEntry`, byte-identical.
-- #1154 (F-3a): also returns the winner's FULL head-type vector `itys`, so the caller
-- can build the head substitution from the SAME impl it selected (headSubstWithParams)
-- instead of re-matching the arg-0 pattern alone.  [m] is arg 0 (the bucket key, and
-- the only thing the iface-unknown arm can select on); [goals] is the vector the
-- iface-known arm selects on — the caller pins them consistent, see argImplRequiresRoutes.
-- ARCH B-2.1-b2 (LEG 2a, the ROUTER's `requires` half): the iface-known arm reads
-- the graph-global `IE` instead of the prefix `KeyBuckets`.  The `KeyBuckets`
-- parameter is REMOVED rather than ignored — it had exactly one reader, this arm.
-- Its `EKNestedTop` caller computes the SAME selection a second time for the route
-- WORD (`keyForSiteByIface`), which moved in the same bite: §6 C2 requires the impl
-- dispatched to and the impl whose context is discharged to be the same impl, so
-- these two cannot be repointed separately.
-- B-4b-i: `iface` is an `IfaceRef`.  ⚠️ The `""` test below is a SENTINEL — "no
-- interface is known at this site" — NOT an identity test, so it is re-spelled
-- against the NAME component alone and keeps its exact meaning.  It must not become
-- an `IfaceRef` equality against `ifaceRefNone`: that would make a query whose name
-- is known but whose origin is absent compare unequal to the sentinel for the wrong
-- reason.  `findImplEntry` is a DIFFERENT substrate (`ImplEntry.ifn`, still a bare
-- `String`) and is reached only on the arm where the name is `""` anyway.
selectReqImpl : ImplBuckets -> IfaceRef -> String -> Mono -> List Mono -> Option (Ty, List Ty, List Require)
selectReqImpl implTable iface tag m goals
  | iface.irName == "" = map ((ImplEntry _ _ headTy reqs itys _) => (headTy, itys, reqs)) (findImplEntry implTable iface.irName tag m)
  | otherwise = ieRowHeadTriple (ieSelectRowByIface perRun.value.bodyImplEnvRef.value iface goals)

-- ── D3b-1: arg-position element-dict routing ────────────────────────────────
-- The argument-position analogue of implDictRoutesFor.  Same impl-table match +
-- head-pattern unification against the discriminating-argument mono, but each
-- requires route is computed by routeOf (activeDictVar-aware): a recursive
-- element of the SAME parametric type (the impl's own element tyvar `a`, still a
-- registered constraint var) forwards the in-scope `$dict_<method>_<slot>` param
-- (RDict); a concrete element (`MyList Int`) materializes a static RKey.  #217: the
-- return position (implDictRoutesIn) now shares this same aware requires recursion — the
-- two chains were unified; this entry runs for emit-path arg stamps specifically.
-- #609: the operator entry.  The goal is the singleton [mono] — and unlike the
-- deferred EKNestedTop case this is not a scope cut, it is EXACT: every interface
-- owning an operator method is single-param (`Eq a`, `Ord a`, `Num a`,
-- `Semigroup a`, `Monoid a` in stdlib/core.mdk), so `itys` has length 1, the
-- lengths agree, and the singleton IS the full vector — matchTyMonos [hty] [m]
-- reduces to matchTyMono hty m.  Should a multi-param interface ever own an
-- operator, entryHeadMatches degrades to the arg-0 fallback rather than
-- mis-selecting.
argImplDictRoutesFor : ImplBuckets -> String -> String -> Mono -> List Route
argImplDictRoutesFor implTable name tag mono =
  argImplDictRoutesForEncl implTable "" name tag mono [mono]

-- encl-aware variant: thread the ENCLOSING method [encl] so the recursively-routed
-- element dicts forward [encl]'s own `$dict_<encl>_<slot>` params (not whichever
-- method registered the shared impl tyvar id LAST — see activeDictVarForEncl).  encl
-- == "" recovers the original global routing (binop path, single-method impls).
-- #203 (H): the arg/op-position element routes.  Was a FIRST-MATCH scan of the
-- ImplBuckets [tag] bucket (blind to no-requires siblings, see implDictRoutesForFull);
-- now selects the MOST-SPECIFIC matching impl over the graph-global impl universe (`IE`)
-- via the shared method-keyed selector (`ieSelectRowByMethod` since ARCH B-2.1-b2, which
-- replaced `matchedEntry`) and discharges THAT impl's OWN requires.  A
-- non-overlapping site (one match) selects the same impl the first-match scan did ⇒
-- byte-identical routes.
-- #609 (arg position): selects on the goal VECTOR [goals] and binds the subst from
-- the winner's FULL head types, exactly as its return-position twin
-- implDictRoutesForFull does.  This is the SAME defect as #609 proper, one leg over:
-- selecting on `[mono]` length-mismatches a multi-param impl's `itys`, so
-- entryHeadMatches fell back to arg-0 and two siblings differing only past arg 0 both
-- matched.  They are genuinely disjoint, so coherence never rejected them and
-- entryCovers finds them incomparable ⇒ pickMostSpecificEntry took the FIRST-DECLARED,
-- and the impl whose `requires`-context was routed could differ from the impl
-- `routeKey` dispatched to — evidence for instance A attached to methods of instance
-- B (§2 "evidence is a tree"; §6 C2 coherence), order-dependently (§6 C3).
--
-- ⚠️ Only observable when the siblings' requires differ in COUNT.  The dict cell is a
-- TYPE tag (`@mdk_dc_0 = [1 x i64] [193460240]` — the `Int` tag, shared with
-- println's dict), and the routes are built from the subst, so two siblings whose
-- requires range over the SAME tyvar produce the SAME dict whichever is picked; the
-- interface is re-chosen at the use site by a method-specific dispatcher
-- (`@mdk_disp_bar_0_1`).  Differing COUNTS thread the wrong NUMBER of dicts, shifting
-- every later argument.  Regression:
-- test/eval_typed_fixtures/multiparam_impl_requires_arity{,_swapped}.mdk.
argImplDictRoutesForEncl : ImplBuckets -> String -> String -> String -> Mono -> List Mono -> List Route
-- ARCH B-2.1-b2 (LEG 3b): the arg-position twin of leg 3a, repointed for the same
-- reason and in the same bite — the two legs select the SAME way at the same goal
-- and a split between them is the §6 C2 break the header describes.
argImplDictRoutesForEncl implTable encl name _tag mono goals = match ieRowHeadTriple (ieSelectRowByMethod perRun.value.bodyImplEnvRef.value name goals)
  Some (headTy, implTys, reqs) => match headSubstWithParams headTy implTys mono goals
    Some subst => argImplReqRoutes implTable encl subst reqs 0 0
    None => []
  None => []

-- #217/#1576: [prevSize]/[spent] carry the WS-4b fuse through the aware recursion (see
-- argImplRequiresRoutes, which owns the shrinking argument).  Every entry point seeds
-- `0 0` — arg-position (argImplDictRoutesForEncl), return-position
-- (implDictRoutesForFull), routeOf/topRouteV and routeUndeterminedTop alike: `prevSize
-- == 0` is the "no parent goal yet" sentinel, so a seed's own first level is counted
-- as non-shrinking and costs one unit of fuel.
argImplReqRoutes : ImplBuckets -> String -> List (String, Mono) -> List Require -> Int -> Int -> List Route
argImplReqRoutes _ _ _ [] _ _ = []
argImplReqRoutes implTable encl subst ((Require { requireHead = rIface, requireArgs = rargs })::rest) prevSize spent = argReqRoute implTable rIface encl subst rargs prevSize spent :: argImplReqRoutes implTable encl subst rest prevSize spent

argReqRoute : ImplBuckets -> String -> String -> List (String, Mono) -> List Ty -> Int -> Int -> Route
argReqRoute _ _ _ _ [] _ _ = RNone
-- #1154 (F-3a): `(arg::_)` USED TO DROP every argument past arg 0, so a multi-param
-- `requires Ix a Char` reached the selector as the singleton `[Int]` and matched every
-- `Ix Int _` impl.  Keep the whole vector; `routeOfD` threads the tail down the
-- EKNestedTop leg.  Single-param requires bind `more == []` ⇒ unchanged.
argReqRoute implTable iface encl subst (arg::more) prevSize spent =
  routeOfD
    implTable
    iface
    encl
    KeepNone
    (fromAstType subst arg)
    (map (fromAstType subst) more)
    prevSize
    spent

-- Phase 69.x-e: fill each method occurrence's method-dicts ref — one route per
-- method-level constraint, from the instantiated constraint mono.  A concrete head
-- → RKey (eval supplies a literal VDict for the body's `empty`/… to read); a
-- constraint variable still (the caller is itself constrained) → RDict forwarding
-- the caller's dict.  Mirrors resolveDictApps; runs after inference.
resolveMethodDicts : ImplBuckets -> List (Ref (List Route), List Mono) -> Unit
resolveMethodDicts _ [] = ()
resolveMethodDicts implTable ((methodRef, monos)::rest) =
  methodRef := routesOfMonos implTable monos
  resolveMethodDicts implTable rest

-- ── recursive dict-app realization (self/mutual recursion) ──────────────────
-- A deferred recursive call records one route per the CALLEE's constraint slot
-- (matching the dict params dict_pass prepends to its def), each forwarding the
-- ENCLOSING fn's own dict param.  Run after inference, when funConstraintsRef is
-- fully populated.
realizeRecDictApps : List RecDictApp -> Unit
realizeRecDictApps [] = ()
realizeRecDictApps ((RecDictApp routesRef callee encl mono)::rest) =
  let ids = fromOption [] (lookupAssocSL2 callee perRun.value.funConstraintsRef.value)
  let routes = recRoutes encl mono ids
  routesRef := routes
  realizeRecDictApps rest

recRoutes : String -> Mono -> List Int -> List Route
recRoutes _ _ [] = []
recRoutes encl mono (id::rest) =
  recRoute encl mono id :: recRoutes encl mono rest

-- For one of the callee's constraint ids, recover the live occurrence type from
-- [mono] (the var the body unified it to).  Concrete head → RKey; still a
-- constraint variable that is one of [encl]'s own → forward [encl]'s dict param
-- (RDict, the slot it sits at); otherwise fall back to the global routing.
recRoute : String -> Mono -> Int -> Route
recRoute encl mono id = match findTvarInMono mono id
  None => RNone
  Some m => resolveRecMono encl m

resolveRecMono : String -> Mono -> Route
resolveRecMono encl m = match headTyconNameMono m
  Some tag => RKey tag []
  None => match enclSlot encl m
    Some slot => RDict (dictParamName encl slot)
    None => routeOf omEmpty "" "" KeepNone m

-- the dict-param slot at which [m]'s tyvar sits among the enclosing fn's
-- constraint ids (its position in funConstraintsRef[encl] = the kept slot)
enclSlot : String -> Mono -> Option Int
enclSlot encl m = match normalize m
  TVar cell => indexOfId (tyvarId cell) (fromOption [] (lookupAssocSL2 encl perRun.value.funConstraintsRef.value))
  _ => None

indexOfId : Int -> List Int -> Option Int
indexOfId target ids = indexOfIdGo 0 target ids

indexOfIdGo : Int -> Int -> List Int -> Option Int
indexOfIdGo _ _ [] = None
indexOfIdGo i target (x::xs)
  | x == target = Some i
  | otherwise = indexOfIdGo (i + 1) target xs

-- the tyvar in [t] whose id is [id], if any (mirrors the reference's
-- find_tvar_in_mono): recovers the enclosing constraint var the body unified into
-- the recursive call's type
findTvarInMono : Mono -> Int -> Option Mono
findTvarInMono t id = findTvarN (normalize t) id

findTvarN : Mono -> Int -> Option Mono
findTvarN (TVar cell) id = if tyvarId cell == id then Some (TVar cell) else None
findTvarN (TCon _ _) _ = None
-- #1110: a rigid is not a unification variable, so it holds no tyvar id —
-- same `None` the shared `TCon` arm gave.
findTvarN (TRigid _) _ = None
findTvarN (TApp a b) id = firstTvar a b id
findTvarN (TFun a _ b) id = firstTvar a b id
-- An effect row is reachable here as a KRow type-application argument
-- (`TApp con (TEff row)`); a value-level tyvar id is never inside an effect row
-- (its tail is an effvar, a separate namespace), so the answer is None.
findTvarN (TEff _) _ = None

firstTvar : Mono -> Mono -> Int -> Option Mono
firstTvar a b id = match findTvarInMono a id
  Some m => Some m
  None => findTvarInMono b id

-- ── dict_pass: prepend dict parameters to constrained function definitions ──
-- For each top-level def of a name in [dictNames], prepend one `$dict_<fn>_<slot>`
-- parameter per constraint (arity from funConstraintsRef, populated during
-- inference), matching the dicts EDictAt applies at call sites.  Multi-clause
-- functions are several DFunDef decls; each clause gets the same leading params.
dictPass : List String -> List Decl -> List Decl
dictPass names prog =
  map
    (dictPassDecl names (returnPosMethodNames prog))
    (mapProg rewriteBinopExpr prog)

-- Phase 151 / Gap G: rewrite each *stamped* comparison/equality EBinOp into its
-- Eq/Ord method application via EMethodAt (the same dispatch node `eq`/`lt` calls
-- become), so eval routes to the user/derived impl.  Only nodes resolveBinopSites
-- stamped (ground non-primitive operand) carry a non-RNone route; primitives /
-- arithmetic stay the literal EBinOp the eval builtin handles (no recursion).
-- Native Gap C: a parametric impl (tuple `Eq (a,b)`) has element `requires` dicts
-- the body reads; resolveBinopSite stamped them into the RKey route's reqs, which
-- binopMethodApp now forwards as the EMethodAt impl-dict routes (the 3rd ref).  A
-- non-parametric concrete impl stamps empty reqs → the plain direct call.
--   <→lt  >→gt  <=→lte  >=→gte  ==→eq  /=→not (eq a b)
rewriteBinopExpr : Expr -> Expr
rewriteBinopExpr (EBinOp op l r routeRef) = match !routeRef
  RNone => EBinOp op l r routeRef
  -- SHARED-FLOAT-RESIDUAL §3(C): an RScalar route is NOT a typeclass dispatch — it
  -- is the scalar-type tag typecheck stamped on a monomorphic arithmetic binop
  -- (resolveArithSite, "Float").  The EBinOp's own route ref does NOT survive the
  -- dict-pass→lower boundary (only NODE values do — verified: an op-string change in
  -- this arm reaches lower but a setRef on routeRef does not), so we carry the scalar
  -- type in a NODE by wrapping the binop in `EAnnot … (TyCon tag)`.  Eval ignores the
  -- annotation (`eval (EAnnot e _) = eval e`) and evaluates the binop dynamically
  -- (Float-correct); lowering reads the annotation to stamp CBinPrim's scalar tag so
  -- the native emitter picks the Float primitive (bypassing the type-lost
  -- staticIsFloat).  This is the dispatch route READ-OUT the design names, relocated
  -- from the (lost) ref cell to a (surviving) node.
  --
  -- #1110 (was a residual, DRAINED by the stamping PR): `tag` is a SCALAR-TYPE
  -- TAG this pass synthesises (never a head the user wrote), and this runs AFTER
  -- resolve, so nothing downstream would ever stamp it.  It takes the same
  -- treatment as `parser.mdk`'s tuple head — the reserved BUILTIN origin, not the
  -- module under elaboration, which resolve does not know and this pass would be
  -- inventing.  Its only reader is `ir/core_ir_lower.mdk`'s
  -- `lower (EAnnot (EBinOp …) (TyCon { tyConName }))`, which takes the NAME and
  -- nothing else, so the origin is unobserved either way — but `OriginBuiltin` is
  -- the TRUE identity of a scalar tag, and leaving `OriginUnresolved` on a
  -- post-resolve node would keep the §8 I6.3 sentinel alive for no reason.
  RScalar tag => EAnnot (EBinOp op l r routeRef) (tyConBuiltin tag None)
  _ => binopMethodApp op l r routeRef
-- PLAN.md #11: re-tag a source integer literal to its inferred runtime rep, a 3-way
-- decision mirroring lib/dict_pass.ml's e7031e6 ENumLit arm.  setNumlitFloats already
-- decided: float cell `Some f` ⇒ concrete Float ⇒ `ELit (LFloat f)`; otherwise the
-- route cell [dref] distinguishes concrete-Int (RNone, cleared) from a surviving
-- polymorphic `Num a` (a non-RNone RDictFwd/RKey route, the soundness case) — the
-- latter dispatches through the runtime Num dict via `fromInt n` (the SAME dict the
-- enclosing `Num a => …` function threads), closing the hole where `inc x = x + 1`
-- instantiated at Float crashed `VFloat + VInt`.  The constructed EMethodAt carries
-- [dref]'s route on its tag ref; impl-dicts/method-dicts refs are empty (`Num` has no
-- element `requires`).  Done in the same mapProg walk that rewrites binops, so
-- eval/lower never see ENumLit and eval_arith / the emitter get matching tags.
rewriteBinopExpr (ENumLit n fref dref _) = match !fref
  Some f => ELit (LFloat f)
  None => match !dref
    RNone => ELit (LInt n)
    route =>
      EApp (EMethodAt "fromInt" (Ref route) (Ref []) (Ref [])) (ELit (LInt n))
-- Roadmap #18c: rewrite each *stamped* EUnOp (`-` → `negate`) into its Num
-- method application via EMethodAt, exactly like the EBinOp arm above.  Only
-- nodes resolveUnopSites stamped (ground non-primitive operand) carry a
-- non-RNone route; Int/Float stay the literal EUnOp the eval builtin handles
-- structurally (no recursion — Int/Float's own `negate` bodies use the BINOP
-- `0 - a`, never unary minus).  `!` never routes (stays RNone unconditionally).
rewriteBinopExpr (EUnOp op e routeRef) = match !routeRef
  RNone => EUnOp op e routeRef
  _ => unopMethodApp op e routeRef
rewriteBinopExpr e = e

-- split the stamped RKey route into a bare-tag route (reqs dropped) + the element
-- dict routes, so the dicts ride on the EMethodAt impl-dict ref (where emitMethod /
-- eval read leading dict words) rather than the route reqs (which the RKey call
-- path ignores).  A non-RKey / empty-reqs route forwards no dicts.
binopRouteSplit : Route -> (Route, List Route)
binopRouteSplit (RKey tag reqs) = (RKey tag [], reqs)
binopRouteSplit r = (r, [])

binopMethodApp : String -> Expr -> Expr -> Ref Route -> Expr
binopMethodApp op l r routeRef =
  let method = fromOption "eq" (binopMethod op)
  let split = binopRouteSplit !routeRef
  let call = EApp (EApp (EMethodAt method (Ref (fst split)) (Ref (snd split)) (Ref [])) l) r
  if op == "/=" then EApp (EVar "not") call else call

-- The EUnOp analogue of binopMethodApp: one operand, no `/=`-style postfix
-- (unopMethod only ever routes `-`).  Reuses binopRouteSplit (a generic
-- Route-ripping helper — nothing about it is binop-specific).
unopMethodApp : String -> Expr -> Ref Route -> Expr
unopMethodApp op e routeRef =
  let method = fromOption "negate" (unopMethod op)
  let split = binopRouteSplit !routeRef
  EApp (EMethodAt method (Ref (fst split)) (Ref (snd split)) (Ref [])) e

dictPassDecl : List String -> List String -> Decl -> Decl
dictPassDecl names _ (DFunDef pub n pats body)
  | contains n names = DFunDef pub n (dictParams n (dictArityOf n) ++ pats) body
  | otherwise = DFunDef pub n pats body
-- Top-level `let rec … with …` (DLetGroup): each binding is dict-passed exactly
-- like a DFunDef — a constrained member gets `dictParams n (dictArityOf n)`
-- prepended to every clause's params, so the dict-passed call sites (which DO get
-- rewritten) line up with the definition.  Mirror of lib/dict_pass.ml's DLetGroup
-- run_decl arm.  (Without this, a `Num a => a -> a` group member's call site
-- supplies a leading dict the body never binds → the dict lands in the first user
-- param → arithmetic over a dict value panics `unknown op`.)
dictPassDecl names _ (DLetGroup pub binds) =
  DLetGroup pub (map (dictPassLetBind names) binds)
-- Phase 83/84 single-level + D3b-1: a parametric impl with `requires` gets one
-- leading `$dict_<method>_<slot>` param on each method (return- OR argument-
-- position) whose body actually reads an impl dict (so a terminal body like
-- `eq Nil Nil = True` would take none — but see implDictPassMethods: the param is
-- added UNIFORMLY across all clauses of a method when ANY clause uses the dict, so
-- a multi-clause method keeps one arity).  The routes resolveSite/resolveArgStamp
-- filled on the call-site EMethodAt's impl-dicts ref line up with these params.
dictPassDecl _ _ (d@(DImpl { reqs, methods, ... })) =
  DImpl { d | methods = implDictPassMethods (listLen reqs) methods }
-- Phase 69.x-e: a method with method-level constraints (foldMap's `Monoid m`) gets
-- one leading `$dict_<method>_<slot>` param per constraint on its DEFAULT body, so a
-- caller can supply the dictionary the body's `empty`/… reads (routed RDict by
-- inferDefaultMethod).  Mirror of lib/dict_pass.ml's DInterface arm.
dictPassDecl _ _ (d@(DInterface { methods, ... })) =
  DInterface { d | methods = map ifaceDictPassMethod methods }
dictPassDecl names ret (DAttrib attrs d) =
  DAttrib attrs (dictPassDecl names ret d)
dictPassDecl _ _ d = d

-- DLetGroup binding dict-pass: prepend the member's dict params to every clause.
-- `dictArityOf n` is 0 for an unconstrained member (no change), matching the
-- oracle's `if k = 0 then (n, clauses)` guard.  Gated on `names` (the constrained
-- set) so an unconstrained member with a coincidental arity entry is untouched.
dictPassLetBind : List String -> LetBind -> LetBind
dictPassLetBind names (LetBind n clauses)
  | contains n names =
    LetBind n (map (prependDictClause n (dictArityOf n)) clauses)
  | otherwise = LetBind n clauses

prependDictClause : String -> Int -> FunClause -> FunClause
prependDictClause n k (FunClause pats body) =
  FunClause (dictParams n k ++ pats) body

ifaceDictPassMethod : IfaceMethod -> IfaceMethod
ifaceDictPassMethod (IfaceMethod n ty (Some (MethodDefault pats body))) =
  ifaceDictPassDefault n ty pats body (methodDictArityOf n)
ifaceDictPassMethod m = m

ifaceDictPassDefault : String -> Ty -> List Pat -> Expr -> Int -> IfaceMethod
ifaceDictPassDefault n ty pats body k
  | k > 0 =
    IfaceMethod n ty (Some (MethodDefault (dictParams n k ++ pats) body))
  | otherwise = IfaceMethod n ty (Some (MethodDefault pats body))

methodDictArityOf : String -> Int
methodDictArityOf n =
  listLen (fromOption
    []
    (lookupAssocSL2 n perRun.value.methodConstraintsRef.value))

-- D3b-1: add the leading `$dict_<method>_<slot>` params UNIFORMLY across all
-- clauses of a method.  An impl method is many ImplMethod entries (one per
-- clause), so a per-clause `usesImplDict` test would give clauses different
-- arities (`eq Nil Nil = True` uses no dict; `eq (Cons …) (Cons …) = … eq x y …`
-- does) and break coalescing.  Compute the set of method NAMES any of whose
-- clauses reads the dict, then prepend the params to every clause of those names.
-- No rpNames gate: usesImplDict already requires an in-body RDict route to one of
-- these params, which on the non-emit path no arg-position site ever has (its
-- occurrences stay bare EVar), so return-position goldens are unaffected.
-- TYPECHECK-AUDIT S2: each method gets, in oracle slot order, its METHOD-LEVEL
-- dict params (`dictParams n k`, k = methodDictArityOf n — e.g. `build`'s `Num e`)
-- FOLLOWED BY the impl-`requires` element-dict params (at slots k..k+nReq-1, only
-- when the body reads one), then the original pats.  Direct mirror of
-- lib/dict_pass.ml:99-119 (`dict_pats n k @ impl_pats @ pats`) and the
-- `method_off + slot` impl-dict naming in lib/typecheck.ml:3682-3690.  Eval applies
-- method dicts unconditionally first (eval.mdk), so dropping the leading method-level
-- params (the old `match reqs []=>d` early-out) mis-bound the dict into the first
-- value parameter.
implDictPassMethods : Int -> List ImplMethod -> List ImplMethod
implDictPassMethods nReq methods =
  let users = dedup (flatMap (clauseImplDictUser nReq) methods)
  map (prependImplDictIfUser nReq users) methods

clauseImplDictUser : Int -> ImplMethod -> List String
clauseImplDictUser nReq (ImplMethod n _ body)
  | usesImplDict n nReq body = [n]
  | otherwise = []

-- params = method-level dicts (slots 0..k-1) ++ impl-`requires` dicts (slots
-- k..k+nReq-1, only when this method's body consumes one) ++ original pats.  Skip
-- entirely only when there are neither (k = 0 and no impl-dict use), matching the
-- oracle's `if k = 0 && not uses_impl_dict then (n, pats, body)`.
prependImplDictIfUser : Int -> List String -> ImplMethod -> ImplMethod
prependImplDictIfUser nReq users (ImplMethod n pats body) =
  let k = methodDictArityOf n
  let implPats = if contains n users then dictParamsFrom n k nReq else []
  if k == 0 && isEmptyL implPats then
    ImplMethod n pats body
  else
    ImplMethod n (dictParams n k ++ implPats ++ pats) body

-- does [body] reference an in-body return-position method already routed RDict to
-- one of THIS method's would-be impl-dict params? (the gate that distinguishes a
-- body that consumes the element dict from a terminal one that doesn't).  Impl-dict
-- slots are offset by the method's own method-level arity (S2), so probe at k..k+nReq-1.
usesImplDict : String -> Int -> Expr -> Bool
usesImplDict mname nReq body =
  anyMember (bodyRDictNames body) (implDictNames mname nReq)

implDictNames : String -> Int -> List String
implDictNames mname nReq =
  map (dictParamName mname) (rangeFromCount (methodDictArityOf mname) nReq)

-- [start, start+1, .. start+count-1]
rangeFromCount : Int -> Int -> List Int
rangeFromCount start count
  | count <= 0 = []
  | otherwise = start :: rangeFromCount (start + 1) (count - 1)

-- the dict-param names every EMethodAt in [e] routes RDict to (post-resolveSites)
-- plus every EDictAt route-LIST that forwards RDict/RDictFwd to an impl param
-- (a `=>`-constrained helper call that threads the impl dict through, e.g.
-- `debug xs = "[\{debugListItems xs}]"` where `debugListItems` is an EDictAt).
bodyRDictNames : Expr -> List String
bodyRDictNames e = flatMap siteRDictName (collectMethodSites e)
  ++ flatMap siteRDictNamesL (collectDictSites e)

siteRDictName : Ref Route -> List String
siteRDictName r = match !r
  RDict d => [d]
  RDictFwd d => [d]
  _ => []

siteRDictNamesL : Ref (List Route) -> List String
siteRDictNamesL r = flatMap routeRDictName !r

routeRDictName : Route -> List String
routeRDictName (RDict d) = [d]
routeRDictName (RDictFwd d) = [d]
-- Native #54/#21 residual: an element-dict RKey route can NEST an RDict forwarding
-- the enclosing impl's `requires` dict (e.g. `RKey "$tuple" [RDict $dict_debug_0,
-- RDict $dict_debug_1]` for `debug (toList m)` in a `Debug (Map k v)` body).  The
-- gate that decides whether to PREPEND those impl-dict params (usesImplDict) must
-- see the nested name, else the route references a param the clause never declares
-- → emitter panics "unbound dict witness".  Recurse into the nested reqs.
routeRDictName (RKey _ reqs) = flatMap routeRDictName reqs
routeRDictName _ = []

-- every EMethodAt route ref reachable in [e] (a pure structural walk; reading a
-- ref's `.value` is done later by siteRDictName, not here)
collectMethodSites : Expr -> List (Ref Route)
collectMethodSites (EMethodAt _ r _ _) = [r]
collectMethodSites (ELoc _ e) = collectMethodSites e
collectMethodSites (EDoOrigin _ e) = collectMethodSites e
collectMethodSites (EApp f x) = collectMethodSites f ++ collectMethodSites x
collectMethodSites (ELam _ b) = collectMethodSites b
collectMethodSites (ELet _ _ _ e1 e2) = collectMethodSites e1
  ++ collectMethodSites e2
collectMethodSites (ELetGroup binds body) = flatMap letBindSites binds
  ++ collectMethodSites body
collectMethodSites (EMatch e arms) = collectMethodSites e
  ++ flatMap armSites arms
collectMethodSites (EIf c t e) = collectMethodSites c
  ++ collectMethodSites t
  ++ collectMethodSites e
collectMethodSites (EBinOp _ l r _) = collectMethodSites l
  ++ collectMethodSites r
collectMethodSites (EUnOp _ e _) = collectMethodSites e
collectMethodSites (EInfix _ l r) = collectMethodSites l ++ collectMethodSites r
collectMethodSites (EFieldAccess e _ _) = collectMethodSites e
collectMethodSites (ETuple es) = flatMap collectMethodSites es
collectMethodSites (EListLit es) = flatMap collectMethodSites es
collectMethodSites (EArrayLit es) = flatMap collectMethodSites es
collectMethodSites (ERangeList a b _) = collectMethodSites a
  ++ collectMethodSites b
collectMethodSites (ERangeArray a b _) = collectMethodSites a
  ++ collectMethodSites b
collectMethodSites (ESlice e a b _ _) = collectMethodSites e
  ++ collectMethodSites a
  ++ collectMethodSites b
collectMethodSites (EIndex e i _) = collectMethodSites e ++ collectMethodSites i
collectMethodSites (EAnnot e _) = collectMethodSites e
collectMethodSites (EBlock stmts) = flatMap doStmtSites stmts
collectMethodSites (ERecordCreate _ fs) = flatMap fieldAssignSites fs
collectMethodSites (ERecordUpdate e fs _) = collectMethodSites e
  ++ flatMap fieldAssignSites fs
collectMethodSites (EVariantUpdate _ e fs) = collectMethodSites e
  ++ flatMap fieldAssignSites fs
collectMethodSites _ = []

letBindSites : LetBind -> List (Ref Route)
letBindSites (LetBind _ clauses) = flatMap funClauseSites clauses

funClauseSites : FunClause -> List (Ref Route)
funClauseSites (FunClause _ body) = collectMethodSites body

armSites : Arm -> List (Ref Route)
armSites (Arm _ guards body) = flatMap guardSites guards
  ++ collectMethodSites body

guardSites : Guard -> List (Ref Route)
guardSites (GBool e) = collectMethodSites e
guardSites (GBind _ e) = collectMethodSites e

doStmtSites : DoStmt -> List (Ref Route)
doStmtSites (DoExpr e) = collectMethodSites e
doStmtSites (DoLet _ _ _ e) = collectMethodSites e
doStmtSites (DoBind _ e) = collectMethodSites e
doStmtSites (DoAssign _ e) = collectMethodSites e
doStmtSites (DoFieldAssign _ _ e) = collectMethodSites e

fieldAssignSites : FieldAssign -> List (Ref Route)
fieldAssignSites (FieldAssign _ e) = collectMethodSites e

-- mirror of collectMethodSites's structural walk, but collecting EDictAt's
-- route-LIST refs (`Ref (List Route)`) instead of EMethodAt's single route ref.
collectDictSites : Expr -> List (Ref (List Route))
collectDictSites (EDictAt _ rs) = [rs]
-- D3b-1: an EMethodAt arg-position site carries its element-dict routes in the
-- impl-/method-dicts route LISTS (not tagRef).  A nested `requires` impl whose
-- body dispatches a method on its own element tyvar routes RDict $dict_<m>_<slot>
-- here — scan both so implDictPassMethods' usesImplDict gate sees it and prepends
-- the matching param.  [] on the golden path (resolveArgStamp never runs).
collectDictSites (EMethodAt _ _ implR methR) = [implR, methR]
collectDictSites (ELoc _ e) = collectDictSites e
collectDictSites (EDoOrigin _ e) = collectDictSites e
collectDictSites (EApp f x) = collectDictSites f ++ collectDictSites x
collectDictSites (ELam _ b) = collectDictSites b
collectDictSites (ELet _ _ _ e1 e2) = collectDictSites e1 ++ collectDictSites e2
collectDictSites (ELetGroup binds body) = flatMap letBindDictSites binds
  ++ collectDictSites body
collectDictSites (EMatch e arms) = collectDictSites e
  ++ flatMap armDictSites arms
collectDictSites (EIf c t e) = collectDictSites c
  ++ collectDictSites t
  ++ collectDictSites e
collectDictSites (EBinOp _ l r _) = collectDictSites l ++ collectDictSites r
collectDictSites (EUnOp _ e _) = collectDictSites e
collectDictSites (EInfix _ l r) = collectDictSites l ++ collectDictSites r
collectDictSites (EFieldAccess e _ _) = collectDictSites e
collectDictSites (ETuple es) = flatMap collectDictSites es
collectDictSites (EListLit es) = flatMap collectDictSites es
collectDictSites (EArrayLit es) = flatMap collectDictSites es
collectDictSites (ERangeList a b _) = collectDictSites a ++ collectDictSites b
collectDictSites (ERangeArray a b _) = collectDictSites a ++ collectDictSites b
collectDictSites (ESlice e a b _ _) = collectDictSites e
  ++ collectDictSites a
  ++ collectDictSites b
collectDictSites (EIndex e i _) = collectDictSites e ++ collectDictSites i
collectDictSites (EAnnot e _) = collectDictSites e
collectDictSites (EBlock stmts) = flatMap doStmtDictSites stmts
collectDictSites (ERecordCreate _ fs) = flatMap fieldAssignDictSites fs
collectDictSites (ERecordUpdate e fs _) = collectDictSites e
  ++ flatMap fieldAssignDictSites fs
collectDictSites (EVariantUpdate _ e fs) = collectDictSites e
  ++ flatMap fieldAssignDictSites fs
collectDictSites _ = []

letBindDictSites : LetBind -> List (Ref (List Route))
letBindDictSites (LetBind _ clauses) = flatMap funClauseDictSites clauses

funClauseDictSites : FunClause -> List (Ref (List Route))
funClauseDictSites (FunClause _ body) = collectDictSites body

armDictSites : Arm -> List (Ref (List Route))
armDictSites (Arm _ guards body) = flatMap guardDictSites guards
  ++ collectDictSites body

guardDictSites : Guard -> List (Ref (List Route))
guardDictSites (GBool e) = collectDictSites e
guardDictSites (GBind _ e) = collectDictSites e

doStmtDictSites : DoStmt -> List (Ref (List Route))
doStmtDictSites (DoExpr e) = collectDictSites e
doStmtDictSites (DoLet _ _ _ e) = collectDictSites e
doStmtDictSites (DoBind _ e) = collectDictSites e
doStmtDictSites (DoAssign _ e) = collectDictSites e
doStmtDictSites (DoFieldAssign _ _ e) = collectDictSites e

fieldAssignDictSites : FieldAssign -> List (Ref (List Route))
fieldAssignDictSites (FieldAssign _ e) = collectDictSites e

dictArityOf : String -> Int
dictArityOf n =
  listLen (fromOption
    []
    (lookupAssocSL2 n perRun.value.funConstraintsRef.value))

dictParams : String -> Int -> List Pat
dictParams n k = dictParamsGo n 0 k

dictParamsGo : String -> Int -> Int -> List Pat
dictParamsGo n slot k
  | slot >= k = []
  | otherwise =
    PVar (dictParamName n slot) (Loc "" 0 0 0 0) :: dictParamsGo n (slot + 1) k

-- [count] dict params for [n] starting at slot [start]: $dict_n_start ..
-- $dict_n_(start+count-1).  Used for impl-`requires` element-dict params, which
-- follow the method's own method-level params (S2 offset = methodDictArityOf).
dictParamsFrom : String -> Int -> Int -> List Pat
dictParamsFrom n start count
  | count <= 0 = []
  | otherwise = PVar (dictParamName n start) (Loc "" 0 0 0 0) :: dictParamsFrom n (start + 1) (count - 1)

dictParamName : String -> Int -> String
dictParamName fn slot = "$dict_\{fn}_\{intToString slot}"

-- the head node of a left-spine `TApp`, normalizing at each level (the head may
-- be a TVar linked to a concrete type after unification — normalize follows only
-- the top link, so recurse through normalize).  Total (every `Mono` has a head)
-- and ALLOCATION-FREE (it returns a node that already exists).
headMonoNode : Mono -> Mono
headMonoNode t = match normalize t
  TApp a _ => headMonoNode a
  other => other

-- the head type constructor as the GOAL-SIDE dispatch key — Stage A-2 unit
-- A-2.2 (#1111).  The result was `Option String` until this unit, which threw
-- away the `TyConOrigin` Stage A-1 put on the `TCon` this matches; `HeadKey`
-- (`types/registry.mdk`) carries it, and its doc-comment derives why `None` had
-- to keep meaning exactly what it meant before ("no head type constructor at
-- all") rather than absorbing "a head with no identity yet".
--
-- ⚠️ IT IS NOT THE ONLY `Mono` HEAD PROJECTION — but it IS now the only `Mono`
-- one on a dispatch path.  A-2.2 left a third, `monoHeadCon`, `Option String`
-- and carrying its own copy of the same I6.1 forgery; A-2.2b DELETED it,
-- pointed `goalHeadCon` (hence `KeyBuckets`' goal side) and the three
-- `implExistsForHead` receiver sites at this function, and moved its name-only
-- consumers to `headTyconNameMono` below.
--
-- ⚠️ "THE SURVIVING PAIR" IS AMBIGUOUS AND THIS COMMENT MEANS ONE OF THEM.  The
-- pair meant HERE is the SOURCE-TYPE pair — this and `headTyconNameMono`, the
-- two `Mono` projections, which owe each other the invariant that they classify
-- the same head nodes.  `monoHeadCon`'s obituary above names the other, the
-- SIDE pair (`headTyconTy` impl / `headTyconMono` goal).  Neither is "the" pair
-- and neither is a count of the projections in this file: that is four, and the
-- derivation that can actually discover a fifth is in the obituary.
--
-- 🚨 THIS IS THE FIRST SITE IN THIS FILE THAT READS A `Mono.TCon` ORIGIN, which
-- is why `test/typecheck_compiler_source.sh`'s `Mono.TCon` mint ratchet carries
-- this line: its discriminator is a `_` in the origin slot, so a pattern that
-- BINDS the origin is the false positive its own remedy predicts ("a pattern
-- that legitimately BINDS the origin is the expected first false positive; list
-- it, and the list stays the audit").  Nothing is CONSTRUCTED here.
headTyconMono : Mono -> Option HeadKey
headTyconMono t = match headMonoNode t
  TCon n o => Some (headKeyOfCon o n)
  -- ⚠️ ANSWER-PRESERVING, NOT CORRECT — the twin of `headTyconNameMono`'s arm,
  -- and the load-bearing one: this is the GOAL-side dispatch key (#1110,
  -- DICT-SEMANTICS §8 I6.1).  A rigid variable has no head type constructor, so
  -- handing its parameter name out as a bucket key is the residual violation the
  -- split makes visible.  It reproduced today's answer byte-for-byte and is left
  -- alone deliberately; changing it is the follow-on semantics PR.
  --
  -- A-2.2 does NOT give it one: `HkRigid` is the inhabitant that says "this is
  -- not a declaration", so the widening carries the violation forward VISIBLY
  -- instead of minting the identity §8 I6.1 forbids.  The answer is unchanged —
  -- `headKeyName (HkRigid n) == n`, exactly the `Some n` this arm gave before.
  TRigid n => Some (HkRigid n)
  -- #1617, the GOAL half of the same bite — and it MUST land with
  -- `headTyconTy`'s `TyFun` arm, never alone.  This is the projection
  -- `goalHeadCon` reads, so it is what decides which bucket
  -- `ieSelectRowByMethod`/`ieSelectRowByIface` search; fixing only the impl side
  -- would file the arrow-headed impls into a bucket no goal ever keys, i.e.
  -- would move them from "mis-bucketed" to "unreachable".
  TFun _ _ _ => Some (headKeyOfCon OriginBuiltin funHeadTag)
  _ => None

-- The BARE-NAME residual of the projection above: byte-identical to what
-- `headTyconMono` itself answered before A-2.2, and allocating exactly what it
-- allocated (one `Some`).  Every consumer that has not yet been re-keyed calls
-- THIS, so the GOAL-side half of the Stage A-2 ledger is what this prints —
-- a command, never a number copied down here:
--
--   grep -nw headTyconNameMono compiler/types/typecheck.mdk \
--     | grep -vE '^[0-9]+:[[:space:]]*--' \
--     | grep -vE '^[0-9]+:headTyconNameMono'
--
-- ⚠️ Both filters are load-bearing, for the reason `headTyconNameTy` above
-- gives: the unfiltered command also prints the comments and the definition.
--
-- ⚠️ Deliberately NOT `map headKeyName (headTyconMono t)` — see the same note on
-- `headTyconNameTy` above for why the three duplicated arms are the cheaper of
-- the two prices.  The invariant they owe: these arms and `headTyconMono`'s must
-- classify the SAME head nodes, so a new `Mono` head constructor is owed an arm
-- in both (both fall through `_ => None`, which is exactly the wildcard hazard
-- `AGENTS.md` names — audit them as a SET).
--
-- 🚨 THAT INVARIANT NOW HAS ONE DECLARED EXCEPTION, `TFun` (#1617), AND IT IS A
-- DECISION RATHER THAN AN OVERSIGHT.  `headTyconMono` gained a `TFun` arm; this
-- one deliberately did not, because the two functions stopped being asked the
-- same QUESTION at that constructor:
--   * `headTyconMono` is the goal-side DISPATCH KEY.  It needs arrow goals to key
--     the same bucket arrow-headed impls file into, and `__fun__` is a synthetic
--     bucket name, not a claim that a declaration exists.
--   * this residual is read by 17 sites that ask "does this head NAME a type
--     constructor?", and for several the answer `None` is load-bearing prose in
--     the tree.  `allConcreteHeads` is the sharp one: `uOblIsDecidableNow`'s own
--     comment derives its closed set FROM the fact that "`headTyconNameMono`
--     answers `None` for a `TFun` … so `allConcreteHeads` calls it non-concrete",
--     and pairs that with the separate `anyListM monoIsFunction` arm.  Handing it
--     `Some "__fun__"` would silently merge two populations that comment keeps
--     apart, on a path that — by its own 🚨 — NO GATE CAN SEE.
-- So a NEW `Mono` head constructor still owes an arm in both; `TFun` is the one
-- place where the pair answers differently on purpose.  Do not "restore
-- symmetry" here without first re-deriving `uOblIsDecidableNow`'s closed set.
headTyconNameMono : Mono -> Option String
headTyconNameMono t = match headMonoNode t
  TCon n _ => Some n
  TRigid n => Some n
  _ => None

-- Native Gap C: the arity-distinguished tuple dispatch tag (`__tuple2__`, …),
-- byte-identical to eval.mdk's `tupleHeadTag`.  Stamped as the RKey route tag at a
-- tuple method site so each arity routes to its own impl group / lifted define.
tupleHeadTagTc : Int -> String
tupleHeadTagTc n = "__tuple" ++ intToString n ++ "__"

-- An n-tuple TYPE is a saturated left-spine TApp over the synthetic nullary
-- constructor `TCon (tupleHeadTagTc n)` — the constructor NAME string IS the
-- existing `__tupleN__` dispatch tag, so tag/eval parity is automatic and no
-- `Mono.TTuple` constructor is needed.  (Surface `Ty.TyTuple` is unchanged.)
tupleMono : List Mono -> Mono
tupleMono ts = tupleSpineOf (tconTupleHead (listLen ts)) ts

tupleSpineOf : Mono -> List Mono -> Mono
tupleSpineOf acc [] = acc
tupleSpineOf acc (t::rest) = tupleSpineOf (TApp acc t) rest

-- collect a left-spine `TApp` into (head, args-in-application-order),
-- normalizing at each level so a linked head resolves.
spineParts : Mono -> (Mono, List Mono)
spineParts t = match normalize t
  TApp a b => match spineParts a
    (h, args) => (h, args ++ [b])
  other => (other, [])

-- recognise a fully-saturated tuple spine (arity >= 2 — `()`/Unit stays
-- `TCon "Unit"`, never a tuple); return its element monos in order.
export
tupleSpine : Mono -> Option (List Mono)
tupleSpine t = match spineParts t
  (TCon n _, args) =>
    if listLen args >= 2 && n == tupleHeadTagTc (listLen args) then
      Some args
    else
      None
  -- #1110 answer-preserving, and deliberately not "simplified" away.  A rigid
  -- variable can be the head of an application spine (`fromAstTypeVarApp` builds
  -- `TApp (TRigid h) …` at a row-slot arg), and before the split such a head was
  -- a `TCon` and reached the arm above.  A type parameter spelled `__tupleN__`
  -- is absurd but lexically legal, so dropping this arm would be a real — if
  -- unreachable-in-corpus — answer change.  Keep the answer; fix it with the
  -- rest of I6.1.
  (TRigid n, args) =>
    if listLen args >= 2 && n == tupleHeadTagTc (listLen args) then
      Some args
    else
      None
  _ => None

-- arity a `__tupleN__` tag string names (else None) — bounded probe so a bare
-- or PARTIAL tuple ctor never leaks the raw `__tupleN__` tag into a message.
tupleTagArity : String -> Option Int
tupleTagArity n = tupleTagArityGo n 2

tupleTagArityGo : String -> Int -> Option Int
tupleTagArityGo n k
  | k > 32 = None
  | tupleHeadTagTc k == n = Some k
  | otherwise = tupleTagArityGo n (k + 1)

commaStr : Int -> String
commaStr n = if n <= 0 then "" else "," ++ commaStr (n - 1)

-- render a bare/partial tuple constructor as the surface-less `(,)`/`(,,)` head
-- (only reached when a tuple spine is UNSATURATED, e.g. an arity-mismatch
-- message); a saturated spine renders `(e1, …)` via ppApp before reaching here.
ppConName : String -> String
ppConName n = match tupleTagArity n
  Some k => "(" ++ commaStr (k - 1) ++ ")"
  None => n

-- Two monos genuinely CANNOT unify because a tuple spine meets a differing
-- concrete head/arity — used only to pick the readable full-type mismatch
-- message.  A TVar-headed other side returns False (it can still bind).
tupleUnifyClash : Mono -> Mono -> Bool
tupleUnifyClash a b = match (tupleSpine a, tupleSpine b)
  (Some xs, Some ys) => listLen xs /= listLen ys
  (Some _, None) => monoSpineHeadIsCon b
  (None, Some _) => monoSpineHeadIsCon a
  (None, None) => False

-- DRIVER-COLLAPSE Phase 5: scheme extraction for repl/lsp `:type`/hover + the
-- `=== TYPES ===` golden (checkToLines), the surviving replacement for the
-- deleted flat `checkProgram`.  implInferEnabled OFF + the seeded path, which
-- keeps the checkLetRecDecls / LetRecNonFunction guard checkModuleFull skips.
-- Callers pass the 1-module decl list (preludeDecls ++ user buffer) and read
-- schemes by name; no eval, so this is the typecheck-only sibling of the
-- 1-module path.
export
checkProgramSchemes : List Decl -> List Decl -> List (String, Scheme)
checkProgramSchemes coreProg userProg =
  driverState.value.implInferEnabled := False
  checkProgramSeededSplit [] coreProg userProg

-- Like checkProgramSchemes but ALSO seeds runtime.mdk's externs (putStrLn,
-- readLine, …) into scope, so a buffer using them type-checks instead of leaving
-- the bindings that consume them unconstrained.  Mirrors the OCaml reference's
-- `check_program`, which seeds `Runtime.entries` into the initial env — the LSP
-- hover/completion/inlay handlers run this so externs resolve and a `let input =
-- readLine ()` hovers as `String`, not a free `a`.
export
checkProgramSchemesWithRuntime : List Decl -> List Decl -> List Decl -> List (String, Scheme)
checkProgramSchemesWithRuntime runtimeDecls coreProg userProg =
  driverState.value.implInferEnabled := False
  -- #1280: `coreProg` IS the prelude boundary this entry exists to carry, so the
  -- extern scope can attribute `Option`/`Ordering`/`Result` to `core` here.
  checkProgramSeededSplit (externSchemes (externTyOriginScope coreProg) runtimeDecls) coreProg userProg

-- [seed] are extern schemes from runtime.mdk: in scope for lookup (so core.mdk's
-- use of putStrLn/etc. resolves) but NOT part of the output (mirrors the
-- reference seeding Runtime.entries into initial_env, which aren't returned).
checkProgramSeeded : List (String, Scheme) -> List Decl -> List (String, Scheme)
checkProgramSeeded seed prog = checkProgramSeededSplit seed [] prog

-- Same pass, but told WHERE THE PRELUDE ENDS.  Every driver that flattens the prelude
-- into the program it checks (`desugar coreP ++ desugared`) hands the two halves in
-- separately instead of pre-concatenating them, which is the only thing the flat path
-- was missing to make SHADOW-SEMANTICS S1 (shadow-hood is PER-MODULE, per-name) hold:
-- with the boundary known, a user standalone that shadows an interface-method name is a
-- shadow inside the USER's decls and NOT inside the prelude's.  See flatShadowScopingRef
-- for the bug this closes.  [coreProg] = [] ⇒ prelude-free program ⇒ scoping is inert and
-- this is byte-for-byte the old checkProgramSeeded (that is the multi-module discovery,
-- elaborateDict, and probe-entry path).
-- #1110 flat-identity: the FLAT half of the resolve→typecheck channel.
-- `checkModulesPreamble` and `elaborateModules` cover every graph driver; this is
-- the one remaining seam a program reaches typecheck through without a module graph
-- (`medaka check` on a no-import file arrives via checkToLinesWithRuntime).
--
-- 🚨 Both halves are stamped with the SAME loader-less scope, and it deliberately
-- contains NO entry for the user program's own declarations — `stampFlatTyOrigins`
-- has the full argument.  The short version: this driver has no module id (its
-- callers hold SOURCE TEXT, an editor buffer, or a repl line), an invented one is
-- made permanent by `stampTyHead`'s immunity rule, and `medaka run` on a no-import
-- file reaches this arm AND the loader-backed `elaborateModules` arm in ONE process
-- — so an id invented here directly contradicts the real one.
--
-- `coreProg0` is passed as the scope source for BOTH calls on purpose: it is the
-- prelude-boundary this "Split" entry exists to carry, so the prelude's types get
-- `core` while the user's stay unstamped.  When it is `[]` the boundary is unknown
-- (the internal `checkProgramSeeded` passes flatten the prelude into `prog`), and
-- then nothing is claimed at all — which is why the prelude can no longer be
-- attributed to the user's module.
--
-- #1227: the paragraph above is about the OCCURRENCE layer (`stampFlatTyOrigins`)
-- only.  The DECLARATION layer (`stampDeclOrigins`, resolve.mdk) is narrower still:
-- `coreProg0` is a KNOWN module id here (unlike the graph drivers' `registerData`,
-- which would have to invent one for an imported module), so this driver now also
-- stamps the prelude's own `DData`/`DNewtype`/`DTypeAlias`/`DInterface` heads
-- `core`.  ONLY `coreProg` gets this call — `userProg0` still has no module id and
-- must stay unstamped, exactly as the occurrence layer already treats it.  When
-- `coreProg0` is `[]` (the prelude-free / already-flattened callers), stamping an
-- empty list is a no-op, so this adds nothing on those paths.
checkProgramSeededSplit : List (String, Scheme) -> List Decl -> List Decl -> List (String, Scheme)
checkProgramSeededSplit seed coreProg0 userProg0 =
  let coreProgTy = stampFlatTyOrigins coreProg0 coreProg0
  let coreProg = stampDeclOrigins "core" coreProgTy
  let userProg = stampFlatTyOrigins coreProg0 userProg0
  -- #1110 agreement tap.  OFF unless a probe enabled it (`noteOriginTrace` is a
  -- `Bool` read and a return otherwise).  It is here, at the DRIVER, rather than
  -- inside the stamper, because the two defects it exists to catch were both in
  -- the ARGUMENTS a driver passed, not in the stamping.
  let _ = noteOriginTrace "core" coreProg
  let _ = noteOriginTrace "user" userProg
  checkBodyImpl seed (Flat coreProg) userProg

-- #80: the SINGLE whole-program typecheck body, shared by the flat/single-file path
-- (checkProgramSeededSplit, `Flat coreProg`) and the per-module path
-- (checkModuleFullImpl, `Module mid accData implDecls`).  Institutionalizes
-- DICT-SEMANTICS §7's single-evaluator law: one elaboration ⇒ `check` and `emit`
-- cannot silently disagree on a dispatch decision.  Everything is shared EXCEPT the
-- SIX load-bearing divergences, each a `match mode` branch below:
--   (1) decl universe (prog / persistent DATA-universe / fullUniverse / groundUniverse)
--   (2) inference plan — flat's TWO-PHASE prelude-then-user vs module's single pass
--   (3) cross-module dict-threading restore + snapshot (module only; flat SKIPS)
--   (4) importer/definer shadows + the shadowMethodSchemes env layer
--   (5) the implInferEnabled obligation gate (INVERTED between the two emit paths)
--   (6) superDeclsRef ownership (set from the mode)
-- The mode carries the inputs each path adds on top of `seed` + `prog0`:
--   Flat   coreProg               — the prelude prefix (empty ⇒ prelude-free program)
--   Module mid accData implDecls  — module id, prior modules' public data, impl universe
data CheckMode = Flat (List Decl) | Module String (List Decl) (List Decl)

checkBodyImpl : List (String, Scheme) -> CheckMode -> List Decl -> List (String, Scheme)
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
checkBodyImpl seed mode prog0 =
  let _ = resetState ()
  -- (#1) decl universes, derived from the mode.  On Flat, prog = coreProg ++ userProg
  -- and every universe collapses to it; on Module they fan out over accData/implDecls.
  let prog = match mode
    Flat coreProg => coreProg ++ prog0
    Module _ _ _ => prog0
  -- P1 (#1446) / DICT §8 I7: the four operator-and-literal classes' identities, read
  -- off the PRELUDE's own `DInterface` decls before any body is inferred (the operator
  -- handlers consult them during inference).  See `seedBuiltinClasses`.
  let _ = seedBuiltinClasses mode prog
  -- #837: stamp binding ids on the program the bodies are INFERRED from.  `prog`
  -- itself stays unstamped for the pre-inference analyses (shadows/key table/…),
  -- which do not need ids; only the inferred bodies (defs + impl/default/prop/test)
  -- carry EVarId, and schemeDefIdsRef feeds registerSchemeObligations the top-level
  -- members' ids.  A single walk (top-level frame built over the whole `prog`, so a
  -- user body referencing a prelude fn gets the prelude fn's id), then split back
  -- into core/user slices for the two-phase Flat inference.
  let stampRes = stampBindingIds prog
  let progS = fst stampRes
  -- #907: index name→id as an OrdMap (was a List scanned linearly per rendered
  -- scheme in ppSchemeNamed / per SCC member in registerSchemeObligations → O(decls²)).
  -- Built from the REVERSED pairs so omFromPairs' last-write-wins reproduces the old
  -- `lookupAssoc` first-match-wins on a duplicated binder name (same pattern as sigTyMapRef).
  perRun.value.schemeDefIdsRef := (omFromPairs (reverseL (snd stampRes)) omEmpty)
  let coreLen = match mode
    Flat coreProg => listLen coreProg
    Module _ _ _ => 0
  let coreProgS = takeFirst coreLen progS
  let prog0S = dropFirst coreLen progS
  -- the full visible universe (shadows / key table / iface-param registration /
  -- completeness / obligations): Flat = whole flattened program; Module = imported
  -- data + impl universe + this module.
  -- #154 PR-A: every consumer of `fullUniverse` is a `Flat _ =>` arm (grep confirms:
  -- buildDefinerShadows / registerMethodIfaceParamsAll
  -- / checkImplObligations / checkCallObligations — all Flat).  #1557 A-3.5a removed
  -- `checkImplCompleteness` from that list: impl-completeness no longer takes a decl
  -- list on either arm, it reads `classEnvHere` (whose Flat arm is built from `prog`,
  -- which IS this binding on that arm).  Medaka is STRICT, so the
  -- Module arm's `accData ++ implDecls ++ prog0` allocated an O(|accData|) list every module
  -- and discarded it unread — a dead per-module O(N) concat.  Bind `[]` on Module.
  let fullUniverse = match mode
    Flat _ => prog
    Module _ _ _ => []
  -- registerAllData universe (#154 PR-A): the Module path no longer builds `accData ++ prog0`
  -- here — prior modules' public data lives in the persistent DATA-universe accumulators
  -- (universeRecordByName/…/universeDataEnv), copied+overlaid at the `dataEnv` binding below.
  -- groundMultiParamObligations universe: Flat grounds over prog; Module over implDecls.
  let groundUniverse = match mode
    Flat _ => prog
    Module _ _ implDecls => implDecls
  -- (#6) superDeclsRef: unified body OWNS it — Flat = coreProg ++ userProg, Module =
  -- implDecls.  On the emit path elabModuleStamp already sets the same implDecls; on the
  -- multi-module CHECK path this closes the latent stale/empty-ref gap (behavior change).
  let superDecls = match mode
    Flat _ => prog
    Module _ _ implDecls => implDecls
  driverState.value.superDeclsRef := superDecls
  -- (BREAK #3) effect domains: FLAT populates inline; MODULE relies on the driver
  -- preamble (checkModulesPreamble / elaborateModules) populating ONCE over the whole
  -- import graph — a per-module populate would wipe another module's domains.
  let _ = match mode
    Flat _ =>
      let _ = populateEffectDomains prog
      ()
    Module _ _ _ => ()
  let _ = checkEffectParams prog
  let _ = checkLetRecDecls prog
  -- #154 PR1: on the Module path, grow the persistent universe accumulators by THIS
  -- module's decls BEFORE the shadow/key reads below consult them — so they see the
  -- same universe `fullUniverse` (which appended prog0) did.  The Flat path leaves them
  -- untouched and rebuilds over its whole `prog` (already O(N)).
  let _ = match mode
    Flat _ => ()
    -- #1112 A-3.4 PR2: `ieShadowCompare mid prog0` stood here, and the hard `panic`
    -- surface it put in the released compiler is GONE with it — that instrument had
    -- exactly one job, measuring the §9.5 equality before the flip committed to it,
    -- and the flip has now been made on a strictly stronger measurement (see
    -- `moduleImplUniv` just below for what was measured and how it was shown
    -- fail-capable).  `appendUniverseAccums` no longer grows an impl universe either,
    -- so there is nothing left here for `IE` to be compared against.
    Module _ _ _ => appendUniverseAccums prog0
  -- 🚨 #1112 A-3.4 PR2 — THE `IE` READER FLIP.  THIS IS THE ONE PRODUCTION READ OF
  -- STAGE K's `IE`, and it is what makes the registry real rather than shelf-ware.
  --
  -- WAS (#154 PR3, retired here): `ImplUniverse obUnivConcreteRef.value
  -- obUnivHeadlessRef.value obUnivIfaceTagsRef.value` — three `CrossRun` accumulators
  -- grown one module at a time by the `appendUniverseAccums prog0` immediately above.
  -- Those three fields are GONE, not merely unread: these were their only readers, so
  -- leaving them would have left two sources of truth for "what impls exist" (design
  -- law L1) and the `cross_allowed` ratchet would still carry three rows this unit
  -- exists to retire.
  --
  -- NOW: a projection of the whole-graph `IE` through `ieUniverseAt`, the universe
  -- read accessor (A-3.5b added a second `IE` read, `ieRowsVisibleAt`; see that
  -- function's header, and do not re-instate "the ONE place" here).
  --
  -- 🚨 AND SINCE A-3.6 (#1558) IT IS NO LONGER FILTERED TO THIS MODULE'S ORDINAL
  -- PREFIX.  This paragraph said "filtered to this module's ordinal prefix … the
  -- filter stays ON here (it must)", which was A-3.4 PR2 correctly refusing to do
  -- A-3.6's job early.  A-3.6 has now done it: `ieSnapAt` routes through
  -- `ieCandidacyVisibleAt`, which is `True`, so this binding is the WHOLE GRAPH's
  -- impl universe regardless of `mid`'s ordinal.  **This line is where A-3's
  -- headline C4/I2 claim is cashed** — everything an obligation check on the
  -- multi-module path knows about which impls exist comes from here, and it now
  -- knows the same thing in every module, which is what *"import scoping never
  -- decides which instances exist"* means operationally.
  --
  -- ⚠️ `declEnvsOrdOf mid` IS STILL PASSED AND IS NOW INERT ON THIS PATH.  It is
  -- kept so the call site does not move and so re-scoping candidacy later is a
  -- one-line change; do not "simplify" it away, and do not read its presence as
  -- evidence a filter is still applied.  Its `-1` miss sentinel is likewise vacuous
  -- here — an unknown module id now gains the whole graph rather than losing
  -- everything, the opposite of the fail-CLOSED story `declEnvsOrdOf` documents for
  -- the NAME axis.
  --
  -- ⚠️ WHAT THIS WIDENS, said out loud rather than left to be discovered: #1482's
  -- measurement showed topological prefix scoping was accidentally load-bearing for
  -- #1438's same-spelled-interface shape, so #1438's reach grows here.  That is
  -- expected and licensed (§8 I5), not a regression — but it is an acceptance delta,
  -- and the pin that grades it is
  -- `test/must_fail_fixtures/1072-overlap-xmod-bare-head-arm-order`, which A-3.6
  -- flips: `main.mdk` must now print `specific` with `control.mdk` STILL `specific`.
  -- Red on both legs is a real regression, not the drain.
  --
  -- 🚨 BOUND ONCE, READ TWICE, AND THE "ONCE" IS LOAD-BEARING.  There are TWO Module-arm
  -- consumers — `residualUnivRef` (#1549) just below, and the end-of-body obligation
  -- `obUniv` — and A-3.4's own design was written when there was only ONE.  Do not
  -- re-derive the projection at the second site: it is a whole-prefix rebuild, so a
  -- second call doubles this unit's already-measured per-module cost for a value that
  -- cannot have changed (both `ord` and `IE` are immutable for the whole module; the
  -- accumulator these replaced was likewise grown once, above, and read at both sites).
  -- A third consumer should take this binding too, or say in writing why it needs a
  -- different ordinal.
  --
  -- WHY THIS IS EQUALITY-PRESERVING, MEASURED AND NOT ASSUMED.  §9.5's argument is the
  -- conjunction of (a) a fold algebra — `growImplUniverse` is the SAME writer on both
  -- sides, over triples from the SAME `implDeclsWithReqs` — and (b) `DL`, the decl-list
  -- identity, which the algebra assumes rather than shows.  PR1's `ieShadowCompare`
  -- measured the per-module SLICE.  This PR measured the strictly stronger proposition
  -- the flip actually rests on: the WHOLE PREFIX universe at the read site, both
  -- `MultiRegistry` buckets and the tag `Registry`, digested key-by-key and
  -- entry-by-entry in bucket order, `IE` against the accumulator, panicking on any
  -- disagreement.  Run over the compiler's own graph (both the `checkModules` and the
  -- `elaborateModules` driver), `make check-self`, the multi-module differential gates,
  -- and 193 multi-module fixture projects: ZERO disagreements.  Fail-capable in two
  -- directions, both executed: projecting at `ord - 1` panicked with the prelude's whole
  -- population on one side and an empty universe on the other, and a name-triggered
  -- control proved `medaka check` on a two-module project reaches this line carrying a
  -- real module id at a real ordinal.  The instrument is deleted with `ieShadowCompare`;
  -- the measurement is the reason this binding is allowed to exist.
  let moduleImplUniv = match mode
    Flat _ => emptyImplUniverse
    Module mid _ _ =>
      let envs = driverState.value.declEnvsRef.value
      ieUniverseAt (declEnvsOrdOf mid envs) envs.deImpls
  -- #1549: stash the impl universe the RESIDUAL REDUCER entails against
  -- (`residualPredsOf`, called from each generalizing group's close).  This is NOT a
  -- third source: it is the SAME two arm-gated sources the end-of-body obligation
  -- checkers consume — `buildImplUniverse prog` on Flat, and since A-3.4 PR2 the `IE`
  -- projection on Module (which carries this module's own impls, its ordinal being
  -- included by `declEnvVisibleAt`, exactly as the retired accumulator did after the
  -- `appendUniverseAccums` above).  Built ONCE per module rather than per group:
  -- rebuilding it inside the reducer would be O(decls) per SCC, i.e. quadratic.
  let _ = setRef
    perRun.value.residualUnivRef
    (match mode
      Flat _ => buildImplUniverse prog
      Module _ _ _ => moduleImplUniv)
  -- (#4) shadows.  definerShadows uses the SHARED form — buildDefinerShadows over the
  -- full visible universe, scoped to THIS module's decls (prog0).  On Flat, prog0 =
  -- userProg and fullUniverse = prog, so this is exactly the old flat `buildDefinerShadows
  -- prog userProg`.  #154 PR1: the Module path reads the accumulated interface-method
  -- SET instead (byte-identical membership).  importerShadows exist only across a module
  -- boundary; the `Module _ _ []` arm (cmCheckWorker / core pass, implDecls = []) keeps
  -- the old empty result — `funDefs [] = []` gave no imported fns there.
  -- #1354 unit A (#1353): both accumulators are graph-global, so the intersection alone
  -- implements only S1's LEFT operand.  `nameableIfaceShadows` supplies the RIGHT one —
  -- the interface must be nameable in THIS module.  Applied to the RESULT, never inside
  -- either filter (the result is single-digit; `fnSet` is every fn name in the graph), and
  -- fail-open when the graph index is absent.  See `nameableIfaceShadows`.  The Flat arms
  -- are untouched: a single file is one module and its own interfaces are nameable in it.
  let definerShadows = match mode
    Flat _ => buildDefinerShadows fullUniverse prog0
    Module _ _ _ => nameableIfaceShadows prog0 (definerShadowsFromSet crossRun.value.universeIfaceMethodsRef.value prog0)
  let importerShadows = match mode
    Flat _ => []
    Module _ _ [] => []
    Module _ _ _ => nameableIfaceShadows prog0 (standaloneShadowsFromSet crossRun.value.universeIfaceMethodsRef.value crossRun.value.universeFunNamesRef.value prog0)
  let sigs = sigsOf prog
  perRun.value.definerShadowNamesRef := definerShadows
  perRun.value.definerShadowSigsRef := sigs
  -- #154 PR1 seeded a SECOND impl-existence table here — `shadowKeyTableRef`, from
  -- `buildKeyTable fullUniverse` on Flat and from the cumulative `universeKeyBucketsRef`
  -- on Module.  ARCH B-2.1-g repointed all three of its boolean existence reads onto the
  -- graph-global `bodyImplEnvRef` seeded just below (`ieImplExistsForHead`), and B-2.1-d
  -- deleted both refs.  🚨 DO NOT RE-ADD A PREFIX-KEYED EXISTENCE TABLE HERE.  The Module
  -- arm's source was a cumulative TOPOLOGICAL PREFIX while S2's impl universe is
  -- graph-global (`SHADOW-SEMANTICS.md:183-186`, `:226`), so an importer shadow whose
  -- receiver's impl sat in a topologically later module answered "no impl" and called the
  -- standalone — a located reject became exit 0 printing a `Box` pointer fed to `n + 1`,
  -- discriminated by the order of two `import` lines.  One substrate, one decision.
  -- ARCH B-2.1-a2: the SAME impl population, seated on `IE`'s shape, on BOTH arms —
  -- one ref, so the evidence reader B-2.1-b repoints has one substrate rather than an
  -- arm gate.  It landed ADDITIVE AND BEHAVIOUR-NEUTRAL, so the repoints that followed got
  -- a substrate they could trust on a path where `IE` was empty (see `buildFlatImplEnv`
  -- for the measured hazard, RUN-B-017 probe 3).
  -- ⚠️ "nothing reads `bodyImplEnvRef` yet" was true only at a2 and is now FALSE: B-2.1-b2's
  -- three selection legs, and B-2.1-g's route word plus three shadow existence reads, all
  -- read this ref.  Derive the set: `grep -n bodyImplEnvRef compiler/types/typecheck.mdk`.
  -- The Module arm is a pointer copy of the env `buildDeclEnvs` already built; it
  -- deliberately does NOT re-derive, for the reason `moduleImplUniv` gives above.
  let _ = match mode
    Flat _ => (perRun.value.bodyImplEnvRef := (buildFlatImplEnv fullUniverse))
    Module _ _ _ => (perRun.value.bodyImplEnvRef := driverState.value.declEnvsRef.value.deImpls)
  -- (#4 + #3-restore) mode-specific pre-inference ref setup (all pure/independent of the
  -- register+globalS block below, so order-safe).  Flat arms the per-body shadow-scoping
  -- toggles; Module installs importer-shadow state and restores the cross-module dict
  -- accumulators resetState just wiped.
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op
  let _ = match mode
    Flat coreProg =>
      perRun.value.flatShadowScopingRef := (declsNonEmpty coreProg)
      perRun.value.flatUserShadowNamesRef := definerShadows
      perRun.value.flatCoreFnNamesRef := (namesToSet (map fst (funDefs coreProg)) omEmpty)
      ()
    -- #1425 site 2: `mid` is BOUND here now — the three lockstep re-keys at the end of this
    -- arm need this module's identity, and the arm can no longer discard it.
    Module mid _ _ =>
      driverState.value.standaloneValuesRef := (dedup (importerShadows ++ definerShadows))
      perRun.value.shadowStandaloneSchemesRef := (pickStandaloneSchemes importerShadows seed)
      -- #1351: the per-module copy of the identity-keyed dispatch-index universe, read by
      -- `methodDispatchIdx` through `dispatchIdxScoped`.  Its bare-name peer was retired at L5.
      driverState.value.methodDispatchIdxByIdRef := crossRun.value.universeMethodDispatchIdxByIdRef.value
      perRun.value.funConstraintsRef := crossRun.value.crossModuleFunConstraintsRef.value
      perRun.value.funConstraintIfacesRef := crossRun.value.crossModuleFunConstraintIfacesRef.value
      -- B-2.2-f (#1113): the declared-prefix sidecar rides the IDS table — every
      -- whole-table replacement of `funConstraintsRef` owes one of these.
      perRun.value.funConstraintDeclaredRef := crossRun.value.crossModuleFunConstraintDeclaredRef.value
      let _ = setRef perRun.value.funConstraintsRef (aliasConstraintEntries prog crossRun.value.crossModuleFunConstraintsQualRef.value
        ++ perRun.value.funConstraintsRef.value)
      let _ = setRef perRun.value.funConstraintIfacesRef (aliasConstraintEntries prog crossRun.value.crossModuleFunConstraintIfacesQualRef.value
        ++ perRun.value.funConstraintIfacesRef.value)
      let _ = setRef perRun.value.funConstraintDeclaredRef (aliasConstraintEntries prog crossRun.value.crossModuleFunConstraintDeclaredQualRef.value
        ++ perRun.value.funConstraintDeclaredRef.value)
      -- #1425 site 2: the three tables above were just seeded WHOLESALE from graph-wide
      -- BARE-NAME accumulators, so every name this module declares is currently answered by
      -- whichever module's same-named binding the topological order happened to put first.
      -- Re-key those names — and only those — onto this module's own `(mid, name)` rows.
      -- Three writes, in lockstep, per B-2.2-f (#1113): the declared-prefix sidecar rides the
      -- IDS table, and this is a whole-table replacement of all three.
      let _ = setRef perRun.value.funConstraintsRef
        (selfDeclArities mid prog crossRun.value.crossModuleFunConstraintsQualRef.value perRun.value.funConstraintsRef.value)
      let _ = setRef perRun.value.funConstraintIfacesRef
        (selfDeclArities mid prog crossRun.value.crossModuleFunConstraintIfacesQualRef.value perRun.value.funConstraintIfacesRef.value)
      let _ = setRef perRun.value.funConstraintDeclaredRef
        (selfDeclArities mid prog crossRun.value.crossModuleFunConstraintDeclaredQualRef.value perRun.value.funConstraintDeclaredRef.value)
      -- RUN-XMOD-062: ONE derivation, two projections.  The two refs are read together
      -- (`qualConstraintKey` assembles a `(definer, origin)` key out of both), so they
      -- must not be derived by two independent walks that could admit different rows.
      let admitted = importDefinersOf prog
      perRun.value.currentImportDefinersRef := (definerRowsOf admitted)
      perRun.value.currentImportOriginsRef := (originRowsOf admitted)
      -- #1114 (#845): this module's imported SCHEME CONTEXTS, keyed by local spelling.
      -- `reverseL` before `omFromPairs` so the FIRST entry wins a duplicate key, matching
      -- the first-match `lookupAssoc` policy of the three sibling tables set just above
      -- (`omFromPairs` is last-write-wins; see its own note in support/ordmap.mdk).
      let _ = setRef perRun.value.importedSchemeOblsRef
        (omFromPairs (reverseL (importedSchemeOblEntries prog crossRun.value.crossModuleSchemeOblsQualRef.value)) omEmpty)
      ()
  -- #11 soundness: the interface-method→iface-param map (+ the registered-iface set).
  -- #154 PR2 (site #3): FLAT rebuilds both refs over its whole `fullUniverse` (already
  -- O(N)); the Module path COPIES the persistent accumulators — grown one module at a
  -- time by `appendUniverseAccums prog0` above (which ran BEFORE this) and seeded by the
  -- core pass — into the two refs resetState just wiped, exactly as PR1 used to copy
  -- universeKeyBucketsRef into shadowKeyTableRef (both deleted by ARCH B-2.1-d; the
  -- SHAPE described here is this pair's, not theirs).
  -- 🚨 #1111 A-2.5: this comment used to end "Method/interface names are globally unique,
  -- so the accumulated maps carry the same entries the per-module rebuild over
  -- `fullUniverse` (= accData ++ implDecls ++ prog0) did for every name this module
  -- names."  THAT PREMISE IS FALSE and it was the whole of #1092 (S0): two unrelated
  -- interfaces may each declare a method `mth`, the accumulated map is bare-name-keyed
  -- and last-write-wins, and the per-module rebuild over a universe containing BOTH would
  -- have made the identical wrong choice — so the two agreed on a wrong answer, which is
  -- why nothing caught it.  `applyMethodScopeOverrides` re-decides those (normally zero)
  -- names from THIS module's own import scope; every other name still takes the shared
  -- map unchanged.
  let _ = match mode
    Flat _ => registerMethodIfaceParamsAll fullUniverse
    Module _ _ _ =>
      perRun.value.methodIfaceParamsRef := (aliasQualifiedMethodEntries prog (applyMethodScopeOverrides prog crossRun.value.universeMethodIfaceParamsRef.value))
      perRun.value.registeredIfacesRef := crossRun.value.universeRegisteredIfacesRef.value
  -- #154 PR-A: the dominant remaining O(N²) in the multi-module typecheck.  The Module arm
  -- used to `registerAllData initialEnv (accData ++ prog0)` — re-registering (and re-minting
  -- the tyvars of) EVERY earlier module's public data ONCE PER MODULE.  Now: COPY the seven
  -- persistent DATA-universe accumulators (prior modules' public data + ctor env, each minted
  -- exactly once) into the resetState-wiped working refs, then register ONLY this module's
  -- `prog0` as a transient FRONT overlay.  Ordering is byte-identical: the persistent list is
  -- [pub_{k-1}..pub_1] and `registerData` conses prog0 on top → [prog0, pub_{k-1}..pub_1],
  -- the same lookupAssoc (first-wins) / omInsert (last-write-wins) winner the old left fold
  -- over `accData ++ prog0` produced.  Per module O(|prog0|); total O(N).  Flat is unchanged.
  let dataEnv = match mode
    Flat _ => registerAllData initialEnv prog
    -- A-3.2b (#1512): `mid` is BOUND here now — the overlay pool below is read at this
    -- module's own ordinal, so the arm can no longer discard it.
    Module mid _ _ =>
      -- A-3.2b residual (#1512): `envs`/`cur` are bound BEFORE the reload, not
      -- after, because the reload's alias half is now a projection of `envs` at
      -- `cur`.  Both bindings are pure reads of `driverState`, so hoisting them
      -- above `loadDataUniverse` changes nothing else.
      let envs = driverState.value.declEnvsRef.value
      let cur = declEnvsOrdOf mid envs
      let _ = loadDataUniverse cur
      -- #674: OVERLAY the ctors of the types THIS module imports so a bare ctor name
      -- resolves to the module the unit imports it from, not the universe's load-order
      -- winner.  Reads the persistent universe DECLS (not the Module `accData` field —
      -- that is dead `[]` on the elaborate/emit path, #154 PR-C), so the overlay fires
      -- on the run/build gate too, not just `check`.
      --
      -- 🚨 THREE LAYERS, and the order is the whole contract:
      --     universe  <  imported-ctor overlay  <  this module's OWN `prog0`.
      -- The overlay registers AFTER the universe (that is #674's requirement — it must
      -- win the `omInsert` tie-break over the load-order winner) and BEFORE `prog0`
      -- (this module's own declarations outrank anything it imports — ordinary
      -- shadowing, and the SHADOW spec's S1 per-module scoping).
      --
      -- ⚠️ Registering the overlay LAST, over `prog0`, is a REGRESSION and shipped as
      -- one: an imported decl's constructors then beat locally-declared ones, so
      -- `import json.{Json, JNull}` + a local `data Tok = JString String` was rejected
      -- `Type mismatch: Json vs Tok` — clobbered by a SIBLING constructor of `Json`
      -- that the program never imported.  It reaches the stdlib and it is not narrow:
      -- every selective constructor-naming import carries it.  Pinned by
      -- `test/engine_fixtures/ctor_scope_local_ctor_beats_stdlib_import.mdk` (the
      -- stdlib `json` shape, on all three engines) and
      -- `test/llvm_fixtures_modules/ctor_scope_local_decl_wins/` (`{Ext, Other}` plus
      -- a local decl, prelude-free).
      --
      -- 🚨 THE SET OF ORDER-OBSERVABLE STRUCTURES — enumerate it, because #674's root
      -- cause was exactly two of them disagreeing, and a FUTURE edit re-creates that by
      -- moving ONE.  This note used to name a PAIR ("both structures agree"), and the
      -- pair it named was the one that cannot disagree — while omitting the one that can.
      --
      -- Registration order here is  universe < overlay < prog0.  Under it:
      --   * the `TcEnv` ctor scheme map (`addCtor` → `omInsert`, BARE ctor name) —
      --     LAST-write-wins → prog0.  BARE-keyed, so two modules genuinely collide here;
      --     this is #1259's table and the one the overlay exists for.
      --   * `recordByNameRef` (`registerRecordInfoKeyed` → `omInsert`, BARE ctor name) —
      --     LAST-write-wins → prog0.  #1256's table, same keying, same hazard.
      --   * `dataParamKindsRef` (`recordParamKinds`, a consed list read FIRST-match) —
      --     prepend order [prog0, overlay, universe] → prog0.  ⚠️ This one is
      --     IDENTITY-keyed since A-2.3 (`tyTabKey o name`), so two modules' same-named
      --     types get DIFFERENT keys and registration order cannot decide between them
      --     at all.  It is order-observable only for a decl registered twice, where it
      --     agrees.  It is NOT evidence about the bare-keyed tables above.
      --   * the exhaust ctor ORACLE — and it is built at a DIFFERENT CALL SITE
      --     (`checkModuleFullDiags`: `seedCheckRun (prog ++ importedCtorTypeDeclsFirstWins prog …
      --     ++ accData)`), from a LIST, with `oracleMap` = `omFromPairs (reverseL …)`,
      --     i.e. FIRST-wins on that list → prog0 > overlay > universe.  Same verdict,
      --     opposite mechanism, and reached through none of the code on this line.
      --     THIS is the one a future edit can silently flip, so check it too.
      -- All four land on prog0 > overlay > universe.  Getting any two to disagree is
      -- #674's root cause.
      -- #1111 A-2.11 (#1319 unit 1): a FIFTH layer, and it is a per-NAME overlay rather
      -- than a fifth registration — `applyCtorScopeOverrides` re-points the (normally
      -- empty) set of COLLIDED constructor names at the declaration THIS module's import
      -- scope selects.  It sits ABOVE prog0 and declines for any name prog0 declares, so
      -- the ladder above is unchanged: own > import scope > import overlay > universe.
      -- A collision-free program returns this very env unchanged and unallocated.
      -- #1111 A-2.12 (#1319 unit 2): the two RECORD-table overlays are the same fifth
      -- layer one namespace-half over, and they must run HERE — after `registerAllData …
      -- prog0` has written the floor into `recordByNameRef` / `fieldOwnersRef` — for the
      -- same reason `applyCtorScopeOverrides` wraps that call.  They are statements rather
      -- than an env transform only because those two tables are per-run REFS, not `TcEnv`
      -- fields; the ladder they implement is identical.  See applyRecordScopeOverrides.
      -- #1112 A-3.2b (#1512), absorbing #1319 unit 4: THE OVERLAY POOL IS NOW STAGE K.
      -- `crossRun.universeDataDecls` — a positional `List Decl` accumulated by
      -- `appendDataUniverse`, carrying no key at all — is RETIRED; the pool is the
      -- whole-graph envelope read at THIS module's ordinal through
      -- `declEnvRowVisible`/`declEnvVisibleTo`.
      --
      -- 🚨 THE READ KEY IS `mid`, THE LOADER'S MODULE ID — the same string
      -- `buildDeclEnvs` indexed the row under, threaded here by the driver
      -- (`elabModuleStamp mid` on the emit path; `cmCheckWorker mid` since #1508).  It
      -- is NOT re-derived from import syntax, which is why the emit path's
      -- `private_mangle` rewriting cannot break it: mangling renames top-level
      -- bindings, never a loader module id, and the decls in the pool are the very
      -- objects the accumulator held before.  (Re-deriving a read key by re-walking
      -- `DUse` syntax is what made #1425's four-site change resolve on eval and MISS on
      -- emit — `DUse` decls are never mangled.  This key does not go through that
      -- channel.)
      -- #1112 A-3.2b (#1512) slices 2+3: the KIND and FIELD-OWNER halves of the seed
      -- `loadDataUniverse` used to copy out of two `crossRun` accumulators.  Same
      -- position in the ladder (it is the UNIVERSE layer, under the overlay and under
      -- `prog0`), same content, one ordinal-aware source.  See `declEnvSeedChain` for
      -- why the reader's OWN row is excluded here and registered by the two
      -- `registerAllData` calls below instead.
      let _ = declEnvSeedDataUniverse mid envs
      -- 🚨 `…LastWins`, NOT the `…FirstWins` sibling: `registerAllData` folds LEFT into
      -- `omInsert` tables, so the LAST row wins, and the overlay's named-outranks-wildcard
      -- rule therefore needs the `UseGroup` rows LAST.  The oracle call site takes the
      -- opposite order for the opposite reason — see the partition note at
      -- `importedCtorTypeDeclsFirstWins`.  Swapping these two inverts the rule silently.
      let base = registerAllData crossRun.value.universeDataEnv.value
                   (importedCtorTypeDeclsLastWins prog0 cur envs.deModules)
      let env0 = registerAllData base prog0
      let _ = applyRecordScopeOverrides prog0
      applyCtorScopeOverrides prog0 env0
  -- #784: reject under-determined return-only effect vars on interface methods.
  -- MUST run AFTER `dataEnv` above populated `dataParamKindsRef` — the kind-aware
  -- predicate (rowArgNames) reads that table to distinguish a row-kinded ctor arg
  -- (`Async e a`, pins the effect) from a type-kinded one (`List e`, does not).
  let _ = checkUndeterminedRetEffVars prog
  -- #822: instance-head kind check for graded interfaces.  Same placement rationale
  -- as the line above for the HEAD-constructor half, which still reads
  -- `dataParamKindsRef` that `dataEnv` above has just populated.
  -- #1557 A-3.5c: the INTERFACE-slot half no longer reads a per-run table at all —
  -- it reads stage K's `CE` at this module's ordinal, mirroring `moduleImplUniv`'s
  -- arm-gated shape exactly.  The Flat arm builds its own single-module `CE` from
  -- `prog`, the very list `registerAllData initialEnv prog` walked to fill the
  -- retired table, so the check does not go silent on a no-import `medaka check`.
  -- #1557 A-3.5a: this pair is now BOUND ONCE and read by TWO consumers — the graded
  -- impl-head check here and impl-completeness at the end of the body — hence the
  -- neutral name.  Binding once is not a style choice: `flatClassEnvOf` folds the whole
  -- decl list into a registry, so a second construction at the completeness site would
  -- pay that fold twice per flat compile, and the two copies could drift.  On Flat
  -- `fullUniverse = prog` (see its binding above), so `flatClassEnvOf prog` IS the
  -- `flatClassEnvOf fullUniverse` the completeness relocation calls for.
  let classEnvHere = match mode
    Flat _ => (flatClassEnvOf prog, 0)
    Module mid _ _ =>
      let envs = driverState.value.declEnvsRef.value
      (envs.deIfaces, declEnvsOrdOf mid envs)
  let _ = checkGradedImplHeads (fst classEnvHere) (snd classEnvHere) prog
  let _ = rejectCyclicAliases ()
  -- #1280: `prog` reached here through a driver's stamping walk already, and
  -- `stampTyHead` is first-write-immune, so the builtins-only scope can only fill
  -- a head no driver could attribute — an `extern` written in a FLAT user file,
  -- where there is no module id and the primitive heads are all that is knowable.
  let globalS = ifaceMethodSchemes prog ++ externSchemes (externTyOriginScope []) prog
  -- methodNames: FLAT's SECOND ifaceMethodSchemes call over prog — dedup-skipped by
  -- registerMethodConstraints so globalS's registered (first-call) ids stay authoritative.
  -- Module checks core in isolation and never needs it, so NO extra call there.
  -- #973: an OrdMap-backed SET, not a `List` — its two consumers (methodShadowNamesRef via
  -- dropSchemesNamed at 12036 and per-SCC at processGroup) test MEMBERSHIP only, and as a
  -- List `dropSchemesNamed`'s `contains (fst s) names` scanned this whole interface-method
  -- list once per scheme → O(schemes x methods), a flat-path `manyifaces:typecheck` quadratic
  -- (once here over topSchemes, once PER SCC group).  omHasKey is byte-identical membership.
  let methodNames = match mode
    Flat _ => namesToSet (map fst (ifaceMethodSchemes prog)) omEmpty
    Module _ _ _ => omEmpty
  -- (#4 cont) post-globalS mode setup.  Module: shadowMethodSchemes env layer (rebinding
  -- imported method names to the interface-method scheme) + the method-constraint cross
  -- seed (AFTER globalS's ifaceMethodSchemes registration, per registerMethodConstraints).
  -- Flat: record the interface-method names for processSCC's method-shadow scoping.
  let shadowLayer = match mode
    Flat _ =>
      perRun.value.methodShadowNamesRef := methodNames
      []
    Module _ _ implDecls =>
      -- #1351 L1 EXPAND.  `ifaceMethodSchemes implDecls` is hoisted into a binding so it
      -- is called EXACTLY ONCE, as before: it is effectful (mints tyvar ids, registers
      -- method constraints), so a second call here would shift ids and break this leaf's
      -- zero-behaviour-change property.  `pickSchemes` is pure, so hoisting moves no
      -- effect relative to the `methodConstraintsRef` write below.
      let ifaceSchemes = ifaceMethodSchemes implDecls
      perRun.value.ifaceMethodSchemesByIdRef := (zipIfaceMethodSchemeIds (ifaceMethodSchemeIds implDecls) ifaceSchemes)
      -- #1351 L2 MIGRATE.  The importer-shadow layer now binds each shadowed method
      -- name to the scheme of the declaration THIS module's import scope admits
      -- (`applyMethodScopeOverrides`), not to `lookupAssoc`'s decl-walk first match.
      -- Falls back to the bare-name answer on a miss — see `pickSchemesByDecl`.
      let sm = pickSchemesByDecl importerShadows ifaceSchemes
        perRun.value.ifaceMethodSchemesByIdRef.value
      perRun.value.methodConstraintsRef := (perRun.value.methodConstraintsRef.value ++ crossRun.value.crossModuleMethodConstraintsRef.value)
      sm
  let env1 = extendVars (extendVars (extendVars dataEnv seed) globalS) shadowLayer
  let defs = funDefs progS
  let topSchemes = processTopGroups env1 sigs defs (groupNames defs omEmpty)
  -- (#2 / BREAK #1) inference plan.  FLAT runs the TWO-PHASE prelude-then-user scoped
  -- inference (dropSchemesNamed drops user schemes shadowing an interface method so the
  -- prelude's own bodies see the METHOD; scopeShadowsCore/User gate the per-body shadow
  -- set) — reproducing the isolation the module path gets by checking core as its own
  -- invocation.  Collapsing this to one pass reintroduces the prelude-method-shadow
  -- miscompile (List Int vs Int).  MODULE runs the single pass.
  let _ = match mode
    Flat coreProg =>
      let preludeBodyEnv = extendVars env1 (dropSchemesNamed methodNames topSchemes)
      let _ = scopeShadowsCore ()
      let _ = inferImplBodiesIfEnabledIn preludeBodyEnv prog coreProgS
      let _ = inferDefaultBodiesIfEnabled preludeBodyEnv coreProgS
      let _ = inferPropBodies preludeBodyEnv coreProgS
      let _ = inferTestBodies preludeBodyEnv coreProgS
      let _ = scopeShadowsUser ()
      -- #760: on the EMIT path keep the ORIGINAL full impl-body inference
      -- (inferImplBodiesIfEnabledIn — ALL impls, no filtering, no error suppression); on
      -- the CHECK path (implInferEnabled OFF, where that call is a no-op) infer GROUND user
      -- impl bodies so their missing-instance obligations are recorded and rejected.  The two
      -- are MUTUALLY EXCLUSIVE by implInferEnabled, so there is no double inference.  Applying
      -- inferUserImplBodies' ground-only filter / error-suppression on the EMIT path dropped
      -- parametric-impl dispatch inference and MOVED the prelude-free typed-IR goldens
      -- (llvm_typed / llvm_typed_ir) — so emit MUST keep the full call.  The CORE call above
      -- stays emit-gated (re-inferring core on check leaks spurious ambiguities).
      let _ = if driverState.value.implInferEnabled.value
        then inferImplBodiesIfEnabledIn preludeBodyEnv prog prog0S
        else inferUserImplBodies preludeBodyEnv prog prog0S
      let _ = inferDefaultBodiesIfEnabled preludeBodyEnv prog0S
      let _ = inferPropBodies preludeBodyEnv prog0S
      let _ = inferTestBodies preludeBodyEnv prog0S
      ()
    Module _ _ implDecls =>
      let bodyEnv = extendVars env1 topSchemes
      -- #760: EMIT path infers all impl bodies (inferModuleImplBodiesIfEnabled, gated ON);
      -- CHECK path (implInferEnabled OFF, where that call is a no-op) infers THIS module's
      -- GROUND user impl bodies so a cross-module `deriving (Eq)`/`(Debug)` over an imported
      -- field type lacking the instance is rejected at check — closing the multi-module half
      -- of #760 (it reproduced through the loader while single-file check already caught it).
      -- allProg = implDecls (interfaces + accumulated impls) grounds the field types.  Linear:
      -- inferUserImplBodies routes the method-type lookup through the O(log) registered table.
      let _ = inferModuleImplBodiesIfEnabled bodyEnv implDecls progS
      let _ = if not driverState.value.implInferEnabled.value
        then inferUserImplBodies bodyEnv implDecls progS
        else ()
      let _ = inferDefaultBodiesIfEnabled bodyEnv progS
      let _ = inferPropBodies bodyEnv progS
      let _ = inferTestBodies bodyEnv progS
      ()
  -- (#3) cross-module dict-threading SNAPSHOT — MODULE ONLY (flat SKIPS: running it would
  -- pollute the cross-module accumulators with a phantom single-file attribution).
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op
  let _ = match mode
    Flat _ => ()
    Module mid _ _ =>
      let _ = expandSupersTable driverState.value.superDeclsRef.value
      -- #1425: restore the rows the per-module view masked (see `selfNameRows`) — the view
      -- must not propagate as a graph-wide deletion into the next module's seed.
      let _ = setRef crossRun.value.crossModuleFunConstraintsRef
        (perRun.value.funConstraintsRef.value ++ selfNameRows prog crossRun.value.crossModuleFunConstraintsRef.value)
      let _ = setRef crossRun.value.crossModuleFunConstraintsQualRef
        (attributeModuleEntries mid prog perRun.value.funConstraintsRef.value ++ crossRun.value.crossModuleFunConstraintsQualRef.value)
      let _ = setRef crossRun.value.crossModuleFunConstraintIfacesQualRef
        (attributeModuleEntries mid prog perRun.value.funConstraintIfacesRef.value ++ crossRun.value.crossModuleFunConstraintIfacesQualRef.value)
      -- S-xmod-vector-supply (#1868/#1867): the ARGUMENT-VECTOR snapshot, attributed by the
      -- same `(mid, name)` key as the ids/ifaces snapshots it is slot-parallel to.  It gets
      -- NO `crossModuleFunConstraintArgsRef` bare-name peer and NO seed back into
      -- `funConstraintArgsRef` (the reset/restore block above): a bare-name vector table is
      -- the misattribution `declaredConstraintArgs`' header calls strictly worse than
      -- missing, and the qual key is the whole reason this one is safe.
      let _ = setRef crossRun.value.crossModuleFunConstraintArgsQualRef
        (attributeModuleEntries mid prog perRun.value.funConstraintArgsRef.value ++ crossRun.value.crossModuleFunConstraintArgsQualRef.value)
      -- B-2.2-f (#1113): the sidecar's two snapshots, paired with the ids snapshots above.
      let _ = setRef crossRun.value.crossModuleFunConstraintDeclaredRef
        (perRun.value.funConstraintDeclaredRef.value ++ selfNameRows prog crossRun.value.crossModuleFunConstraintDeclaredRef.value)
      let _ = setRef crossRun.value.crossModuleFunConstraintDeclaredQualRef
        (attributeModuleEntries mid prog perRun.value.funConstraintDeclaredRef.value ++ crossRun.value.crossModuleFunConstraintDeclaredQualRef.value)
      let _ = setRef crossRun.value.crossModuleFunConstraintIfacesRef
        (perRun.value.funConstraintIfacesRef.value ++ selfNameRows prog crossRun.value.crossModuleFunConstraintIfacesRef.value)
      crossRun.value.crossModuleMethodConstraintsRef := perRun.value.methodConstraintsRef.value
      let _ = setRef crossRun.value.crossModuleMethodConstraintsQualRef
        (attributeMethodModuleArities mid prog perRun.value.methodConstraintsRef.value ++ crossRun.value.crossModuleMethodConstraintsQualRef.value)
      -- #1114 (#845, DICT-SEMANTICS §4.2 D6(a)): snapshot THIS module's scheme contexts
      -- alongside the three arity tables above.  The arity tables carry only what
      -- `funConstraintsRef` holds, whose INFERRED half is gated on `dictEligibleSetRef`
      -- and is therefore EMPTY on the check path (see that ref's comment) — so an
      -- UNSIGNATURED constrained export was invisible to every importer at check time
      -- while `run`/`build` threaded its dict anyway.  `schemeObligationsRef` is the
      -- always-on store of the same fact and is what the SAME-module use site already
      -- reads; this makes the cross-module use site read it too, under the same
      -- source-exact (mid, name) key.
      let _ = setRef crossRun.value.crossModuleSchemeOblsQualRef
        (attributeModuleSchemeObls mid prog crossRun.value.crossModuleSchemeOblsQualRef.value perRun.value.schemeObligationsRef.value
          ++ crossRun.value.crossModuleSchemeOblsQualRef.value)
      ()
  let _ = groundMultiParamObligations groundUniverse perRun.value.implObls.items.value
  -- P0-17: impl missing a required method.  #1557 A-3.5a: ONE call, both modes — the
  -- arm split is gone because `classEnvHere` above already carries the mode's `CE` and
  -- its reading ordinal (Flat: a single-module `CE` over `prog`, which IS `fullUniverse`
  -- on that arm, at ordinal 0; Module: stage K's whole-graph `deIfaces` at this module's
  -- ordinal).  🚨 It must NOT read `declEnvsRef` unconditionally: that envelope is
  -- `emptyDeclEnvs` on every Flat path, so a Flat read would make `ceRequiredAt` miss on
  -- every interface, and the miss arm is `[]` — every live rejection here would become a
  -- silent accept.  `classEnvHere`'s `Flat _` arm is what prevents that.
  let _ = checkImplCompletenessMap (fst classEnvHere) (snd classEnvHere) prog
  -- (#5 / BREAK #2) obligation gate.  FLAT runs checkImplObligations + setNumlitFloats
  -- UNCONDITIONALLY (flat-emit via elaborateDict needs the Float int-literal stamp — its
  -- resolve chain doesn't redo it).  MODULE runs them iff `not implInferEnabled` (the emit
  -- path stamps AFTER arg-stamp resolution; calling here would double-stamp).  The
  -- setNumlitFloats-vs-checkCallObligations ordering also differs per path — preserved.
  let _ = match mode
    Flat _ =>
      -- #838 I4: impl obligations now go through the unified checkCallObligations
      -- (projected via implOblToU), same universe/order as before the checker swap.
      -- Impl channel = (deferNonGround=True) — retired checkImplObligationsU semantics:
      -- defer non-ground, and check EVERY obligation (no seen skip; S0 #863).
      -- Call channel = (deferNonGround=False): RULE 2/3.  #1925: both channels used to
      -- also thread a `dedup` flag; #1330 made every obligation checked regardless, so
      -- the flag was dead and is removed.
      let _ = checkCallObligations True fullUniverse perRun.value.implObls.items.value
      let _ = checkCallObligations False fullUniverse perRun.value.obls.items.value
      let _ = setNumlitFloats ()   -- PLAN.md #11: stamp Float-typed int literals
      ()
    Module _ _ _ =>
      -- #1112 A-3.4 PR2: the obligation universe is now the `IE` projection bound ONCE
      -- as `moduleImplUniv` far above (see its block for the flip, the measurement, and
      -- why re-deriving it here would be a second whole-prefix rebuild for a value that
      -- cannot have changed).  The three `obUniv*` accumulators this used to read are
      -- deleted from `CrossRun`.
      --
      -- Site #8 (`groundMultiParamObligations groundUniverse`) is still on the list path
      -- above, unchanged: `groundUniverse = implDecls` EXCLUDES this module's `prog0`,
      -- which this projection (like the accumulator before it) includes.
      let obUniv = moduleImplUniv
      let _ = if not driverState.value.implInferEnabled.value then
                -- #838 I4: unified checker, same `obUniv`, same `not implInferEnabled`
                -- gate and same order relative to setNumlitFloats as the retired checker.
                -- Impl channel = (deferNonGround=True); call channel = (deferNonGround=False).
                let _ = checkCallObligationsU True obUniv perRun.value.implObls.items.value
                setNumlitFloats ()
              else ()
      let _ = checkCallObligationsU False obUniv perRun.value.obls.items.value
      ()
  perRun.value.localSchemesOut := (mapLocalSchemes perRun.value.localBindRefs.value)
  perRun.value.seedSchemesOut := seed
  -- #154 PR-A: grow the persistent DATA-universe by THIS module's PUBLIC data, AFTER the
  -- module's inference is complete (so the copy+overlay above saw pub 1..k-1 and NEVER this
  -- module's own pub twice) — the register-time mirror of foldModules' `accData ++
  -- publicDataDecls prog` threading.  appendDataUniverse clobbers the working table refs,
  -- which are DEAD here (the next module's resetState wipes them).  Flat leaves it untouched.
  let _ = match mode
    Flat _ => ()
    -- A-3.2b residual (#1512): `mid` is BOUND here now — `appendDataUniverse`'s
    -- reload reads the alias universe at this module's own ordinal.
    Module mid _ _ => appendDataUniverse mid prog0
  globalS ++ topSchemes
-- D2: check top-level `let rec` bindings for non-function members before
-- type-checking the DFunDef groups (mirrors oracle's LetRecNonFunction guard,
-- lib/typecheck.ml:2596-2602, which fires in process_letrec_group for
-- is_letrec=true groups — i.e. those coming from DLetGroup).

-- Phase 83/84 single-level: AFTER top-level inference (so the scheme output is
-- unchanged), and ONLY on the elaborate/dict path, infer each parametric impl's
-- return-position method bodies, registering the requires' element dict so the
-- inner ref routes RDict and the call site routes RKey + impl dicts.

-- Phase 69.x-e: likewise infer each interface DEFAULT body that carries a
-- method-level constraint (foldMap's default), registering the constraint var so
-- the in-body return-position ref (`empty`) routes RDict to `$dict_<method>_<slot>`.

-- Phase 4.55 (mirror lib/typecheck.ml:4254-4262): type-check each prop body with
-- its declared params in scope.  This is what RESOLVES the EDictAt/EMethodAt route
-- refs the prepass marked inside a prop body — without it the routes stay empty,
-- and on the dict-passed eval path (DRIVER-COLLAPSE Phase 2 promotes the file's own
-- `=>`-constrained fns) the prop body would call a now-dict-passed `wf`/`fromList`
-- with no dict argument → under-application → `force` a partial closure → not VBool
-- → every prop "fails" (set's `fromList []` reported ill-formed).  The compiler
-- typechecker previously skipped props entirely (funDefs ignores DProp), so this
-- gap was latent until Phase 2's promotion exposed it.

-- Shape A (gap #44): ground a container literal's free result-element var THROUGH
-- the impl's method type, BEFORE the resolve* passes read the cells.

-- Error-path B4: now every method occurrence's dispatch type is fully resolved;
-- reject any whose concrete head type has no matching impl (mirrors the oracle's
-- check_method_usages, lib/typecheck.ml:3845).

-- Phase 4.55: infer each prop body with its declared params in scope, so the
-- prepass-marked EDictAt/EMethodAt route refs inside resolve (mirror of
-- lib/typecheck.ml:4254-4262).  Runs unconditionally (props are eval-only; the
-- emit/golden paths have no props), like the OCaml `infer prop_body; unify t_bool`.
-- A prop body is eval-only and is NOT dict-passed for operator dispatch: like the
-- OCaml oracle (which evals raw prop bodies against the marked env), its comparison
-- operators must stay PRIMITIVE EBinOps the eval builtin handles structurally, not
-- get stamped and rewritten to eq/lt method apps (whose dict route would then be
-- applied to a non-dict-passed comparison, panic: applied non-function).  So
-- snapshot pendingBinopSites around prop inference and restore it after: the routes
-- the prop body NEEDS (EDictAt for the file's promoted constrained fns, via
-- pendingDictApps/pendingSites) are still collected; only the binop-rewrite sites
-- the prop body would otherwise contribute are dropped.
inferPropBodies : TcEnv -> List Decl -> Unit
inferPropBodies env prog =
  let savedBinop = perRun.value.pendingBinopSites.value
  let savedUnop = perRun.value.pendingUnopSites.value
  let savedArith = perRun.value.pendingArithSites.value
  let _ = inferPropBodiesGo env prog
  perRun.value.pendingArithSites := savedArith
  perRun.value.pendingUnopSites := savedUnop
  perRun.value.pendingBinopSites := savedBinop

inferPropBodiesGo : TcEnv -> List Decl -> Unit
inferPropBodiesGo _ [] = ()
inferPropBodiesGo env ((DProp _ _ params body)::rest) =
  let local = extendPropParams env params
  let _ = infer local body
  inferPropBodiesGo env rest
inferPropBodiesGo env (_::rest) = inferPropBodiesGo env rest

-- Phase 127 (restored 2026-07-11): typecheck each `test "…" = body` body,
-- requiring it to have type `Expectation` (a nullary TCon, so a plain nominal
-- unify).  Unlike props, test bodies ARE dict-passed (their `expectEqual`/… calls
-- come from `import test`), so this runs on the normal inference path with binop
-- stamping enabled (no snapshot/restore).  Without this, `test "x" = 1 + "str"`
-- and `test "x" = 42` slipped through `check` with zero diagnostics.
inferTestBodies : TcEnv -> List Decl -> Unit
inferTestBodies _ [] = ()
inferTestBodies env ((DTest _ _ body)::rest) =
  -- #1110: `Expectation` is declared by `stdlib/test.mdk`, a USER-SPACE module —
  -- the checker fabricates this head from a literal and has no decl in view, so
  -- there is no identity to acquire.  `tconUnresolved`, not `tconBuiltin`: the
  -- language does not provide `Expectation`, and claiming §8 I6.2's
  -- program-global identity for a type some module declares would be a lie the
  -- shared carrier type cannot object to.
  let _ = unify (infer env body) (tconUnresolved "Expectation")
  inferTestBodies env rest
inferTestBodies env (_::rest) = inferTestBodies env rest

-- bind each prop param `x : ty` as a monomorphic scheme in the env (fresh tyvars
-- for any free type variable in ty; props are normally concrete, e.g. `List Int`).
extendPropParams : TcEnv -> List PropParam -> TcEnv
extendPropParams env [] = env
extendPropParams env ((PropParam x _ ty)::rest) =
  let scheme = monoScheme (fromAstType (freshTvMap (dedup (tyVarNames ty))) ty)
  extendPropParams (extendLocalVar env x scheme) rest

-- gate: impl-body inference runs only when the elaborate/dict path turned it on.
-- FLAT-PATH SHADOW SCOPING: the impl decls to WALK [decls] are given separately from the
-- [allProg] universe the return-position/method tables are built from — so the flat path
-- can walk core's impls (shadows off) and the user's impls (shadows on) in two bracketed
-- calls without perturbing either table.
inferImplBodiesIfEnabledIn : TcEnv -> List Decl -> List Decl -> Unit
inferImplBodiesIfEnabledIn env allProg decls
  | driverState.value.implInferEnabled.value =
    inferImplBodies env allProg (returnPosMethodNames allProg) decls
  | otherwise = ()

-- #760 (S1, check-vs-emit soundness): infer the USER program's impl-method bodies on
-- EVERY path — not only the emit path (implInferEnabled).  The gate created a hole:
-- the EMIT/eval path (implInferEnabled ON) inferred impl bodies but SKIPS
-- checkImplObligations, while the CHECK path (implInferEnabled OFF) ran
-- checkImplObligations but did NOT infer impl bodies — so NO path both inferred an
-- impl body AND checked its obligations.  A `deriving (Eq)`/`(Debug)` (or a hand-written
-- impl) over a field whose type lacks that instance therefore `check`ed clean, ran with
-- a permissive structural fallback, and `build` PANICKED ("no impl of method 'eq' for
-- type 'Inner'").  Inferring the body on the check path records the field's `Eq Inner`
-- obligation via recordImplObligation, which checkImplObligations then rejects with the
-- SAME diagnostic a direct `==` already emits.
--
-- SCOPED TO THE USER decls (`prog0`), NOT the prelude (`coreProg`): re-inferring CORE's
-- own parametric impl bodies on the check path is heavier and pointless — core is
-- known-good (it builds + self-compiles), so only user impls need check-path inference.
--
-- SCOPED TO GROUND-HEADED impls (no type variable in the impl head).  A ground impl —
-- `impl Eq Outer`, the derived instance for a non-parametric type — only ever calls
-- methods on its fields' CONCRETE types, so every obligation it records is concrete:
-- checkImplObligations/checkCallObligations either finds the impl or emits the genuine
-- `No impl of Eq for Inner`.  A PARAMETRIC impl (`impl Eq (List a) requires Eq a`) instead
-- records obligations on its abstract element tyvar; those never ground on the check path
-- and would reach checkUndeterminedObligation, which reports a spurious `Ambiguous instance`
-- for any iface with >= 2 impls (it fired on EVERY program the moment core's own parametric
-- impls were inferred standalone — the prelude snapshot).  The emit path never exercised
-- that because it SKIPS the obligation gate.  Inferring only ground impls records the
-- concrete missing-instance rejects (the whole point of #760) while structurally avoiding
-- the abstract-element ambiguity.  A parametric impl over a concrete field (a rarer nesting)
-- stays deferred to `build` exactly as it was before #760 — a residual, not a regression.
--
-- DIAGNOSTICS PUSHED *DURING* body inference: #760 originally DROPPED all of them (snapshot +
-- restore typeErrors / typeErrorsSticky), because it only wanted the missing-INSTANCE rejects,
-- which are recorded as pendingImpl/CallObligations (side effects) that
-- checkImplObligations/checkCallObligations gate LATER — AFTER this returns — so dropping the
-- error accumulators did not lose a single missing-instance reject.  #777 (type mismatch) and
-- #782 (effect leak) then established that the type/effect errors the body inference itself
-- raises (e.g. an EFFECT LEAK: `putStr` in a pure-typed method body, or a body type mismatch)
-- are genuine soundness bugs that must reject symmetrically with top-level functions — so those
-- are now KEPT — and since issue 1146 they are kept because NOTHING REMOVES THEM: the
-- window that used to rebuild this list is retired (see the retirement note at the end
-- of inferUserImplBodies below).  Per-axis history follows.
-- #777 (S0, silent wrongness): a GENUINE type mismatch inside a ground impl-method
-- body (`sig _ = idInt "str"` where `idInt : Int -> Int` but `sig`'s declared return
-- is `String`) is a `unify`/`typeMismatch` error pushed DURING body inference, not an
-- obligation.  Blanket-restoring `typeErrors` here (as this did before #777) discarded
-- it, and because `medaka build`'s soundness gate (medaka_cli.typecheckGate) runs this
-- SAME check path, both `check` and `build` accepted the program — the built binary
-- then printed a wrong value at exit 0 or SEGFAULTED (an impl method returning a
-- differently-typed field/value).  We now KEEP those body clash errors so both paths
-- reject.
-- #782 (S2, ratified 2026-07-20): the effect axis is now enforced HERE too, symmetric
-- with top-level functions.  An effect leak in an impl-method body (`putStr` in a body
-- whose method signature declares no effect row) is a `T-EFFECT-LEAK`/`T-EFFECT-PARAM`
-- pushed DURING body inference, exactly like a body type mismatch.  Previously these two
-- codes were SUPPRESSED here (isSuppressedImplBodyErr) to spare the intentionally-effectful
-- `impl Speak Dog` in test/engine_fixtures/nullary_memo_with_args — but that made the
-- effect discipline the spec commits to (EFFECTS-SEMANTICS §method: an impl's latent row is
-- bounded by the signature) hold for top-level functions yet silently NOT for impl bodies.
-- The ratified fix is to STOP suppressing: the fixture's method now declares its concrete
-- `<Stdout>` row (`speak : a -> <Stdout> String`), so its body is bounded-by-signature and
-- stays valid, while a pure-signatured method that leaks an effect is now a real error.
-- Missing-instance rejects are unaffected regardless: they are recorded as
-- pendingImpl/CallObligations (side channel) and gated LATER, so they were never in this
-- window.

inferUserImplBodies : TcEnv -> List Decl -> List Decl -> Unit
inferUserImplBodies env allProg decls =
  let rpNames = returnPosMethodNames allProg
  useFastIfaceMethodTy := True
  -- GROUND heads (#760/#777): infer their bodies and KEEP the obligations they record
  -- — a ground impl only calls methods on CONCRETE field types, so every obligation is
  -- concrete and checkImplObligations either finds the impl or emits a genuine
  -- `No impl of <iface> for <field>` reject.
  let _ = inferImplBodies env allProg rpNames (filterList implHeadGround decls)
  -- PARAMETRIC heads (#781, S0): a parametric impl head (`impl Sig (List a)`) is never
  -- reached by the ground filter, so a genuine non-literal type mismatch inside its
  -- method body (`sig _ = idInt "str"`, `idInt : Int -> Int` in a String-returning
  -- method) went unenforced end-to-end — `check`/`build` exit 0 and the built binary
  -- printed a wrong value.  Infer these bodies too so the `unify`/`typeMismatch` clash
  -- is surfaced (it is pushed to `typeErrors`, and kept because nothing removes it —
  -- see the retirement note at the end of this function), mirroring the
  -- ground-head fix.  BUT a parametric impl also records obligations on its ABSTRACT
  -- element tyvar (`impl Eq (List a) requires Eq a` → an `Eq a` obligation over an
  -- unground var); those never ground on the check path and would reach
  -- checkUndeterminedObligation as a SPURIOUS `Ambiguous instance` for any iface with
  -- >= 2 impls (it fired on every program the moment core's own parametric impls were
  -- inferred — the prelude snapshot).  So WINDOW the obligation channel across this
  -- pass and restore it afterward: the body-clash errors go through `typeErrors`, NOT
  -- the obligation channel, so windowing keeps the #781 reject while dropping the
  -- abstract-var false positives.
  --
  -- 🚨 #1114 (#792): THE ROLLBACK IS GROUND-PRESERVING, and it did not used to be.
  -- The two `wRestore`s below used to run bare, which threw away EVERY obligation the
  -- parametric pass recorded — including the GROUND ones, which are exactly the ones
  -- the abstract-var argument above does not cover.  `impl Foo (List a)` whose body
  -- calls `debug Bar` records a fully-ground `Debug Bar`; nothing about it is abstract,
  -- the gate would have rejected it on the spot, and the blanket rollback deleted it —
  -- so `check` exited 0 while `build` PANICKED (`no impl of method 'debug' for type
  -- 'Bar'`).  That is a `run_check_agreement` break, and the sentence this comment
  -- replaced ("stays deferred to `build` exactly as before — a residual, not a
  -- regression") named it as a known residual without naming its cost.
  --
  -- The policy is now written down: DICT-SEMANTICS §4.2 **D1** (a predicate the gate can
  -- decide where it is recorded is discharged there — no window may discard it) and
  -- **D6(b)** (a window that exists to suppress D3 false positives must filter by what is
  -- DECIDABLE, not discard wholesale).  So: window as before, then re-push exactly the
  -- obligations `uOblIsDecidableNow` accepts.  The abstract element tyvar of a parametric
  -- head is decidable by nothing, so every false positive the window was built to stop is
  -- still stopped.
  --
  -- ⚠️ The predicate is "the GATE can decide it now", NOT "it is ground" — those differ,
  -- and this site is where believing otherwise costs a verdict.  `uOblIsDecidableNow`
  -- carries the derivation and the counterexample (`Debug (Int -> Int)`); read it before
  -- touching either side.
  -- Re-pushed in `reverseL` order because `wWindow` yields newest-first (items are
  -- consed): reversing restores the original record order, which the gate reports in.
  let implOblsSnap = wSnapshot perRun.value.implObls
  let callSnap = wSnapshot perRun.value.obls
  let _ = inferImplBodies env allProg rpNames (filterList implHeadParametric decls)
  let keptImpl = filterList uOblIsDecidableNow (wWindow perRun.value.implObls (snd implOblsSnap))
  let keptCall = filterList uOblIsDecidableNow (wWindow perRun.value.obls (snd callSnap))
  let _ = wRestore perRun.value.implObls implOblsSnap
  let _ = wRestore perRun.value.obls callSnap
  let _ = wPushAll perRun.value.implObls (reverseL keptImpl)
  let _ = wPushAll perRun.value.obls (reverseL keptCall)
  -- issue 1146: the typeErrors save/window/rebuild that used to close this function is
  -- RETIRED — it was DEAD, an identity dressed as a filter.  It computed
  -- `added = takeFirst (listLen curErrs - listLen savedErrs) curErrs` and wrote back
  -- `added ++ savedErrs`, which IS `curErrs`: pushes are CONSED onto the head, and the
  -- only two sites that replace this channel wholesale (discoverPromotedModules, and
  -- this rebuild itself) are unreachable from inferImplBodies — the former is called
  -- once, from the elaborateModules driver.  So `savedErrs` was always a suffix of
  -- `curErrs` and the rebuild always reproduced it.  The sticky recomputation
  -- `savedSticky || isNonEmptyL added` was dead for the same reason: every push arms
  -- the sticky flag in the SAME arm in which it stores, so "added is non-empty" and
  -- "the flag was armed during this window" are the same fact, and the flag was
  -- already set.  #782's decision to STOP suppressing the effect axis is what emptied
  -- the filter (isSuppressedImplBodyErr, gone; see the history block above); nothing
  -- replaced it, so what remained was a no-op.  Keeping the body's errors is now what
  -- happens by DOING NOTHING, which is also what the comment block above describes.
  useFastIfaceMethodTy := False

-- True for a DImpl whose head types carry NO type variable (a monomorphic receiver like
-- `Eq Outer` / `Debug (List Int)`); False for a parametric head (`Eq (List a)`) and every
-- non-impl decl (which contributes no impl body regardless).
implHeadGround : Decl -> Bool
implHeadGround (DAttrib _ d) = implHeadGround d
implHeadGround (DImpl { tys, ... }) = isEmptyL (flatMap tyVarNames tys)
implHeadGround _ = False

-- True for a DImpl whose head types carry AT LEAST ONE type variable (a parametric
-- receiver like `Eq (List a)`); False for a ground head and every non-impl decl.  The
-- exact complement of implHeadGround over DImpl decls, so the two filters partition the
-- impls without double-inferring any (and both skip non-impl decls).
implHeadParametric : Decl -> Bool
implHeadParametric (DAttrib _ d) = implHeadParametric d
implHeadParametric (DImpl { tys, ... }) = isNonEmptyL (flatMap tyVarNames tys)
implHeadParametric _ = False

-- C8b: default-body type-checking runs UNCONDITIONALLY (mirrors the oracle's
-- register_interface default-body loop at lib/typecheck.ml:3122-3160 which checks
-- ALL default bodies regardless of whether they carry method-level constraints).
-- Previously gated on implInferEnabled — that blocked unconstrained defaults
-- (Ord.lt/gt/min/max, Foldable.length/isEmpty, Filterable.filter, …) from being
-- type-checked on the plain-check path, so bad unconstrained default bodies were
-- silently accepted.  The constrained branch still registers dict slots (needed
-- for the emit/dict path); the unconstrained branch only type-checks — safe on
-- the plain-check path (activeDictVars mutation is harmless; reset by resetState).
inferDefaultBodiesIfEnabled : TcEnv -> List Decl -> Unit
inferDefaultBodiesIfEnabled env prog = inferDefaultBodies env prog

-- drop every (name, scheme) whose name is in [names] (the flat-path prelude-body
-- shadow fix: remove user schemes that shadow an interface-method name so the
-- method scheme stays visible to the prelude's own bodies).
-- #973: `names` is an OrdMap SET (omHasKey), not a `List` scanned by `contains`.  Callers
-- (dropSchemesNamed methodNames topSchemes; per-SCC processGroup over methodShadowNamesRef)
-- probe MEMBERSHIP only; as a list this was O(schemes x methods) — a flat-path
-- `manyifaces:typecheck` quadratic since the interface-method set grows with the interface
-- count and processGroup runs once per SCC.  omHasKey is a byte-identical membership test.
dropSchemesNamed : OrdMap Unit -> List (String, Scheme) -> List (String, Scheme)
dropSchemesNamed names schemes =
  filterList (s => not (omHasKey (fst s) names)) schemes

inferDefaultBodies : TcEnv -> List Decl -> Unit
inferDefaultBodies _ [] = ()
inferDefaultBodies env (d::rest) =
  let _ = inferOneIfaceDefaults env d
  inferDefaultBodies env rest

inferOneIfaceDefaults : TcEnv -> Decl -> Unit
inferOneIfaceDefaults env (DAttrib _ d) = inferOneIfaceDefaults env d
-- Mirror lib/typecheck.ml:3116-3126: type each default body against the
-- interface's OWN method scheme (built from [typarams]+[methods]), NOT
-- `lookupVar env mname`.  On the flat single-file check path a user top-level
-- funDef can SHADOW a method name (e.g. map.mdk's `isEmpty : Map k v -> Bool`
-- shadowing Foldable's `isEmpty`); looking the name up in env would instantiate
-- that Map-typed shadow and infer the default `isEmpty t = match toList t`
-- against it, grounding `toList`'s container var to `Map` → a spurious
-- `No impl of Foldable for Map` obligation.  The interface scheme is shadow-free.
-- Also extend env with these schemes so PEER-method refs in a default body
-- resolve to the interface methods (oracle's env_with_methods), not user shadows.
inferOneIfaceDefaults env (DInterface { name, typarams, methods, ... }) =
  -- #822: derived from THIS declaration, not from a name key (declGradedScope), and
  -- threaded down so the default bodies see the same Row slots the schemes were built
  -- with.  Computed ONCE per interface rather than per method.
  let dscope = declGradedScope typarams methods
  let ifaceSchemes = methodSchemesPure dscope methods
  inferDefaultMethods (extendVars env ifaceSchemes) name dscope typarams methods
inferOneIfaceDefaults _ _ = ()

inferDefaultMethods : TcEnv -> String -> List (String, List Kind) -> List String -> List IfaceMethod -> Unit
inferDefaultMethods _ _ _ _ [] = ()
inferDefaultMethods env iface dscope typarams (m::rest) =
  let _ = inferDefaultMethod env iface dscope typarams m
  inferDefaultMethods env iface dscope typarams rest

-- C8b: type-check ALL interface default bodies, unconditionally.
--
-- Constrained arm (non-empty ids): method has method-level constraints (e.g. foldMap : Monoid m =>):
--   Instantiate scheme, register constraint vars → dict param names (for dict-passing
--   emit path), infer body, unify.  Mirrors lib/typecheck.ml:3132-3142 + 3143-3150.
--   CRITICAL: the constraint slot ids AND the default-body instantiation MUST come
--   from the SAME sigToSchemeTvs build of THIS method's type.  Reading the ids from
--   methodConstraintsRef (filled by a SEPARATE ifaceMethodSchemes build with its own
--   fresh tyvar ids) and instantiating an unrelated methodSchemesPure scheme gave ids
--   that did not appear in the instantiation subst → registerOneMethodDict's
--   `lookupAssocI id subst` returned None → activeDictVars got no entry → the in-body
--   `empty`/`++` routed RNone → eval's `++` saw a non-monoid acc and panicked
--   ('++' requires Semigroup).  The oracle (lib/typecheck.ml:3067-3093 + 3126-3142)
--   uses ONE method_schemes build for both, which is mirrored here.
--
-- Unconstrained arm (empty ids): method has no method-level constraints (e.g. Ord.lt):
--   Instantiate scheme, infer body, unify — same but no dict registration.
--
-- Double-error guard (GATE S1).  If the body itself detected a type error, skip the
-- outer unify: the body's own error IS the root cause, and unifying its poisoned
-- result against the declared type would add a `Method '<m>': …` line that blames the
-- victim.  NORMATIVE HOME: `compiler/ERROR-QUALITY.md` §3 dim R ("Pinpoints the single
-- root cause; no cascade") and its §6 enforcement table, which names this site.
-- ⚠️ It used to cite "the oracle's single-error raise" instead.  That compiler was
-- removed 2026-06-26, so the citation named nothing; the rule is ours now, and its
-- conformance fixture is `test/typecheck_error_fixtures/iface_default_dedup_cascade.mdk`
-- (which pins the shared KEYING; it does not on its own discriminate this gate — that
-- would need a compiler built with S1 removed, and nobody has built one).
--
-- ⚠️ THE GATED BLOCK IS NOT DIAGNOSTICS-ONLY.  `unify expected2 actualTy` mutates
-- union-find state that `defaultBodyLocalNum` reads below — its job (#873) is grounding
-- body-local `Num` vars so the right impl is selected — so skipping it moves GROUNDING,
-- hence dispatch, not just what prints.  On the ordinary path that is harmless because
-- a detection here means the program is rejected anyway; inside
-- `discoverPromotedModules`'s speculative pass that premise is unavailable (see there).
-- The judgment is read off `perRun.errorsDetected` via `erredDuring`, never off the
-- diagnostic list (issue 1146).
inferDefaultMethod : TcEnv -> String -> List (String, List Kind) -> List String -> IfaceMethod -> Unit
inferDefaultMethod env iface dscope typarams (IfaceMethod mname mty (Some (MethodDefault pats body))) =
  -- #822: [dscope] is the same declaration-derived graded scope the method's own
  -- scheme was built under (inferOneIfaceDefaults → methodSchemesPure) — a DEFAULT
  -- body of a graded method must see its Row slots as rows, not as tyvars.
  let st = sigToSchemeTvsIn dscope mty
  let ids = methodConstraintSlotIds typarams mty (snd st)
  perRun.value.currentFn := ""
  perRun.value.inRigidityBodyRef := True
  -- #837: the schemeObligationsRef snapshot/restore window is RETIRED — a where-helper
  -- named like a top-level binding can no longer leak, now that registration/lookup key
  -- by (name, binding-id) rather than the bare name.
  let inst = instantiateTracked (fst st)
  -- W3 on the GENERIC default path (adversarial break 1): window this body's
  -- obligations on both channels, exactly as inferImplMethod does.
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let defLoc = orElseLoc (implBodyLoc body) (firstTyLoc mty)
  let subject = defaultSubject iface mname
  -- EFFECT axis on the generic default path (round-2 adversarial break 2): a
  -- cross-module impl inherits the default via the untagged fallback, so this
  -- is the ONLY place its intrinsic effects can be bounded — the same-module
  -- specialized copy goes through inferImplMethod, and module placement must
  -- not flip soundness.  The #803 launder residual is queried from the
  -- absorption trail INSIDE inferDefaultMethodBody, around its PRIMARY unify
  -- (#839 2b — see there).  [expected2] rebuilds the declared type over a
  -- private effMap/tvMap purely for the #816 effect-var rigidity read below:
  -- after the body unifies clean, aliasing [expected2] onto the solved
  -- [actualTy] lets the same post-unify rigidity used on the impl path read the
  -- solution through [effMap2] (contortion #3; 2c retires this rebuild).
  let effMap2 = freshEffMap (dedup (effTailNames mty ++ rowArgNamesIn dscope mty))
  let expected2 = fromAstTypeE effMap2 (freshTvMap (removeAllS (rowArgNamesIn dscope mty) (dedup (tyVarNames mty)))) mty
  -- issue 1146: "did the body DETECT an error" is a CONTROL judgment, so it is read
  -- off the occurrence counter, not off `listLen typeErrors`.  The region is the
  -- whole body inference — which is broader than any one unify, and is why no
  -- unify-level failure signal could have answered this: `inferDefaultMethodBody`
  -- also pushes T-EFFECT-LAUNDER, and contains its own gated unify.
  let (bodyErred, actualTy) = erredDuring (_ => inferDefaultMethodBody mname subject defLoc env (fst inst) pats body)
  let _ = if bodyErred then
    ()
  else
    let _ = unify expected2 actualTy
    checkImplEffVarRigidity subject dscope mty effMap2 False defLoc
  let addedObls = wWindow perRun.value.implObls oblN0
  let addedCallObls = callOblsWindow callN0
  let _ = checkDefaultMethodRigidity
    iface
    typarams
    mname
    mty
    (snd st)
    (snd inst)
    addedObls
    addedCallObls
    defLoc
  -- #873 (S0, silent wrongness): mirror inferImplMethod's #518 body-local Num
  -- grounding onto the GENERIC-DEFAULT path.  A cross-module impl inherits the
  -- untagged generic default (fillImplDefaults specializes SAME-MODULE only), so
  -- an ambiguous Num literal consumed body-locally in a default body — its element
  -- var surfacing NOWHERE in the method's declared type ([expected2]) — reached the
  -- route resolver UNGROUNDED here, exactly the #518 hole reopened: `t _ = s [1, 2]`
  -- left `[1,2] : List _a`, matching only the GENERAL `impl S (List a)` and never the
  -- specific `impl S (List Int)`.  So `t Foo` dispatched to a DIFFERENT impl than the
  -- same-module (impl-path) placement, a wrong value keyed purely on module placement,
  -- `check` green either way.  [addedObls] = this default body's obligation window (the
  -- SAME [implObls] channel inferImplMethod grounds over after #841/#876) and [expected2]
  -- = the declared method type as a Mono, aliased by the body's unify above — the exact
  -- pair inferImplMethod passes.  defaultBodyLocalNum grounds ONLY vars absent from
  -- [expected2], so a legitimately polymorphic default (a Num var reflected in the
  -- signature, dict-supplied by the caller) stays polymorphic — no over-grounding.  Runs
  -- AFTER checkDefaultMethodRigidity so a body-local Num default can never mask a pin,
  -- matching the impl path's ordering.
  let _ = defaultBodyLocalNum addedObls expected2
  -- #837: schemeObligationsRef restore RETIRED (see snapshot site above).
  perRun.value.inRigidityBodyRef := False
  -- register AFTER body inference, so each constraint var's id in [snd inst] is
  -- its SURVIVING (normalized) union-find root — the same id the in-body return-
  -- position `empty`/`++` site normalizes to (activeDictVarOf reads that root).
  -- Registering BEFORE inference recorded the pre-unification id; the in-body
  -- site could become the surviving root instead, so activeDictVarOf missed it →
  -- RNone → `'++' requires Semigroup`.  Mirrors registerImplRequires's ordering.
  registerMethodDictSlots mname 0 ids (snd inst)
inferDefaultMethod _ _ _ _ _ = ()

-- Infer a default method body against [expectedTy], suppressing this unify if the
-- body itself already detected a type error (GATE S2).  Medaka ACCUMULATES rather
-- than raising, so without the gate one root cause inside the body would be reported
-- twice: once as itself and once as the shape mismatch it induces at the method
-- boundary.  NORMATIVE HOME: `compiler/ERROR-QUALITY.md` §3 dim R (single root cause,
-- no cascade) and dim X (exactly one diagnostic per root cause), tabulated in that
-- file's §6.  ⚠️ This paragraph used to justify itself by "the oracle's raise-on-first
-- behaviour"; that compiler was removed 2026-06-26 and the citation named nothing.
--
-- C8b Gap 2 (GATE S3): the unify runs with `currentMethodMismatch = Some mname` so a
-- leaf TypeMismatch reports the specialized single line
-- `Method '<mname>': expected type <e> but got <a>` rather than a bare
-- `Type mismatch` — dim C (accurate diagnosis) plus dim J (the user's vocabulary is
-- the method name, not two anonymous monotypes).  When that unify DID detect a
-- mismatch, the body's own added impl obligations are TRUNCATED back to the pre-body
-- snapshot: the method's type is already known wrong, so its body's induced
-- obligations (e.g. `(5 : Bool)` ⇒ `Num Bool`) are cascade victims, and reporting
-- them would add a spurious `No impl of Num for Bool` under the real error — dim X
-- again.  All three gates read `perRun.errorsDetected` via `erredDuring`, never the
-- diagnostic list (issue 1146).
inferDefaultMethodBody : String -> String -> Option Loc -> TcEnv -> Mono -> List Pat -> Expr -> Mono
inferDefaultMethodBody mname subject defLoc env expectedTy pats body =
  let oblSnapshot = wSnapshot perRun.value.implObls
  -- issue 1146: the region is the whole of expression inference for this body.
  let (bodyErred, actualTy) = erredDuring (_ => inferClauses env [(pats, body)])
  let _ = if bodyErred then ()
  else
    -- #839 2b: the #803 launder residual as a POST-unify query over the absorption
    -- trail (default-path phrasing; keeps defaultEffectLaunderMsg's committed
    -- golden verbatim).  Query against [expectedTy] (the PRIMARY instantiation) —
    -- the exact rows THIS unify merges — so its declared tails are the ones that
    -- link and absorb.  (The caller's private [expected2]/[effMap2] rebuild — for
    -- the #816 rigidity read — is unified only AFTER this, by which point the atom
    -- is already merged away, so it must NOT be the query source; contortion #3.)
    let launderMark = wMark perRun.value.absorptions
    let declArrows = allArrowEffs expectedTy
    let actualArrows = allArrowEffs actualTy
    currentMethodMismatch := (Some mname)
    -- issue 1146: keyed on the UNIFY's detection delta ONLY (the pre-unify walk kept
    -- its own launder push out of this baseline by running before the region; the
    -- query below runs after the unify, so the region is exactly this one unify,
    -- closed before anything else can push).  The region is a THUNK because Medaka is
    -- strict — the unify has to run between the counter's two reads.
    --
    -- The leaf mismatch this expects is pushed NON-deduped: `currentMethodMismatch`
    -- is `Some mname` across the whole region, which selects typeMismatchReport's
    -- first arm.  So the PR2 dedup bump does not change what this particular region
    -- normally sees; it only makes the reading honest if some other deduped push ever
    -- becomes reachable from inside a unify.
    let unifyErred = fst (erredDuring (_ => unify expectedTy actualTy))
    currentMethodMismatch := None
    let _ = match launderEscapeFromLog declArrows actualArrows (wWindow perRun.value.absorptions launderMark)
      [] => ()
      escaping => pushTypeErrorOnceAt "T-EFFECT-LAUNDER" defLoc (defaultEffectLaunderMsg subject escaping)
    -- mismatch detected ⇒ restore the pre-body obligation list (drop the body's
    -- own added `Num <wrong-type>` cascade, prepended at the front)
    if unifyErred then wRestore perRun.value.implObls oblSnapshot else ()
  actualTy

-- ── Error-path B4: missing-impl dispatch-obligation check ──────────────────
-- Mirror lib/typecheck.ml's check_method_usages (the `No impl of … for …` reject,
-- :3845).  For each recorded interface-method occurrence, recover the types the
-- interface params resolved to at this site (dispatchMonosOf), and — ONLY when
-- they are all CONCRETE (a resolved head tycon, no remaining polymorphic var, so
-- a constrained-generic `Ord a =>` site whose receiver is still `a` is correctly
-- deferred to the caller) — verify the program declares a matching impl.  None →
-- `No impl of <iface> for <args>`.  An impl block (even one defaulting every
-- method to its interface default body) creates a head entry, so a default-method
-- call on a type WITH an impl is satisfied; a default-method call on a type with
-- NO impl is rejected — both matching the oracle.
-- #154 PR3: the KEYED impl universe consumed by the obligation checkers below.  Bundles
-- the three buckets `insertUnivImplAt` writes (#1112 A-3.4 PR2 deleted the three
-- `CrossRun` refs this line used to name; the buckets are unchanged): concrete-head impls
-- keyed "iface|tag", HEADLESS-receiver impls keyed by iface (matched against ANY
-- receiver), and iface→concrete-head-tag SET (for implCountForIfaceU).  The FLAT path
-- builds one from its whole `prog` via `buildImplUniverse` (O(N) once — the same cost
-- as the old `implDeclsWithReqs`+`implHeadsOf` it replaces); the Module path passes the
-- ⚠️ #1112 A-3.4 PR2: NO LONGER A PERSISTENT ACCUMULATOR.  This block's header used
-- to read "PERSISTENT accumulator (grown one module at a time in
-- appendUniverseAccums)"; those three `CrossRun` refs are deleted.  The Module path
-- now PROJECTS this value out of stage K's `IE` at the reading module's ordinal
-- (`ieUniverseAt`, selecting from the per-ordinal `ieUnivSnaps` built once by
-- `ieBuildSnapsGo`); the Flat path still builds its own with `buildImplUniverse`.
-- Everything below about the KEYS is unchanged — the same `insertUnivImplAt` writer
-- mints them on both paths, which is what made that flip equality-preserving.
-- A-2.2b (#1111): all three buckets are IDENTITY-KEYED registries.  What each
-- key carries, and what it deliberately does NOT:
--   * the INTERFACE half is an IDENTITY key on both the writer and every reader
--     (#1446 T2) — `tabKeyOf NsIface` over the occurrence's `TyConOrigin`, see
--     `oblIfaceKey`.  An impl that HAS an identity is additionally indexed under its
--     bare spelling, for goals that cannot supply one: see `insertUnivImplKeys`.
--   * the RECEIVER-HEAD half is the `TabKey` inside the `HeadKey` that
--     `headTyconTy` projected, so it carries the head's declaring module
--     wherever the pipeline has one (module path) and lands in `TkBare`
--     wherever it does not (flat path, until #1115/E-1).
-- `MultiRegistry` rather than `Registry (List …)`: these buckets are explicitly
-- COMMUTATIVE — every impl ever added is kept, none can be lost to arrival
-- order — which is the invariant the ratchet asks a cross-module table to
-- declare.  They use `mregAppendK`, not `mregAddK`, because within one bucket
-- the FORWARD declaration order is semantic (`findMatchingImplReqsU`).
public export data ImplUniverse =
  | ImplUniverse (MultiRegistry (List Ty, List Require)) (MultiRegistry (List Ty, List Require)) (Registry SetRegistry)

emptyImplUniverse : ImplUniverse
emptyImplUniverse = ImplUniverse mregEmpty mregEmpty regEmpty

buildImplUniverse : List Decl -> ImplUniverse
buildImplUniverse prog =
  growImplUniverse (implDeclsWithReqs prog) emptyImplUniverse

-- fold each (iface, tys, reqs) triple into the universe, APPENDING to keep forward
-- declaration order within every bucket (matching the old whole-list first-match scan).
growImplUniverse : List (IfaceRef, List Ty, List Require) -> ImplUniverse -> ImplUniverse
growImplUniverse [] univ = univ
growImplUniverse (t::rest) univ = growImplUniverse rest (insertUnivImpl univ t)

-- concrete receiver head (Some tag) → the "iface|tag" bucket + record the tag in the
-- iface's tag set; headless receiver (TyVar/function/empty head — None) → the iface's
-- headless bucket, which every lookup also consults (matchTyMono wildcard matches any).
insertUnivImpl : ImplUniverse -> (IfaceRef, List Ty, List Require) -> ImplUniverse
insertUnivImpl univ (iface, tys, reqs) =
  insertUnivImplKeys (oblIfaceKeys iface) tys reqs univ

-- ── THE BARE COMPATIBILITY LEG, AND ITS DRAIN CONDITION ─────────────────────────
-- An impl is indexed under its interface's IDENTITY key — that is T2 — and, when it
-- HAS an identity, ALSO under the bare-spelling key.  The second index is not a
-- hedge about the impl side: it is the only thing that keeps a goal whose identity
-- is UNRECOVERABLE from missing every impl in the program.
--
-- 🚨 MEASURED, and it is the finding that shaped this function.  With the identity
-- index ALONE, every predicate re-instantiated through a table with no identity keys
-- `TkBare` while the prelude's own impls key `TkIdent core`, so the lookup misses and
-- the obligation is reported as `No impl` — a FALSE REJECT, not a silent miss.  On
-- this tree that was: `medaka check` of a file containing nothing but
-- `main = println 1` → exit 1 with 9 rejects (`No impl of Applicative for Option`,
-- `Mappable`, `Thenable`, …, all mislocated to line 1); `check stdlib/core.mdk` → 7;
-- `stdlib/list.mdk` → 8; `stdlib/map.mdk` → 7; `check
-- compiler/driver/medaka_cli.mdk` → 37; and #1438's OWN control fixture (a legal
-- program the pin requires to keep working) rejected too.
--
-- 🚨 THE DRAIN CONDITION, CORRECTED AGAIN BY U1c (#1507) — READ IT BEFORE DELETING
-- ANYTHING.  This paragraph used to read "both `ifaceRefBare` call sites disappear …
-- delete it then" (a count of TWO against a set of THREE), then "delete the leg only
-- when every remaining `ifaceRefBare` hit is the definition itself" once U1b named the
-- third producer (`recordImplObligation`'s method-occurrence goal).  **U1c retires that
-- third producer** — `recordImplObligation` now records `iface`, the identity-carrying
-- `IfaceRef` `methodIfaceParamsRef` already held, instead of stripping it via
-- `ifaceRefBare iface.irName` — so by the census rule stated then, every REMAINING
-- `ifaceRefBare` call site IS the definition (`:3850-3851`) or the deliberately-bare
-- `pendingDictApps` route-word fallback in `ifaceForInferredId` (§10.3).
--
-- ⚠️ THAT FALLBACK IS NOT SAFELY DISMISSED AS "A ROUTE WORD, NOT A GOAL PRODUCER" —
-- an earlier revision of this paragraph said so and it was not established, only
-- assumed from the fallback's OWN call site (`pushDictApp`'s routing arg). TRACED,
-- not instrumented: `ifaceForInferredId`'s result is written by `registerInferredFor`
-- directly into `funConstraintIfacesRef` (`map (ifaceForInferredId m) ids`); that
-- table is read by `declaredConstraintFor`'s `None` arm (when `qualConstraintFor`
-- misses); `declaredConstraintFor` feeds `inferDictAtFound`, which calls
-- `recordCallObligations`, which calls `recordObl (Predicate { iface = s.csIface, … })
-- 0 PCallSlot …` — an `ImplUniverse` goal, unconditionally, for any slot whose
-- `csIface.irName /= ""`. So the SAME value this fallback mints reaches BOTH a
-- routing site AND a goal-producing one, through two different readers of
-- `funConstraintIfacesRef`. Bare BY CONSTRUCTION (this channel stores route words,
-- §10.3's still-true half) — but that is a FOURTH reason the leg stays, not evidence
-- the fallback is goal-producer-free. Not independently re-derived whether a program
-- can actually DRIVE this path to a bare, non-"" `csIface` at a live call site
-- (`ifaceForConstraintId`/`lookupSchemeIface` are tried first and may already cover
-- every reachable case) — flag this as unresolved rather than assume either answer.
--
-- ⚠️ 🚨 **AND THE LEG STILL MAY NOT BE DELETED — MEASURED, NOT INFERRED FROM THE
-- CENSUS ABOVE.**  Zero remaining `ifaceRefBare` *goal-producer* call sites does not by
-- itself mean zero remaining *bare* goals: `methodIfaceParamsRef` itself can hold an
-- `IfaceRef` whose `irOrigin` is `OriginUnresolved` — not because a producer stripped
-- it, but because nothing upstream ever stamped one — and `recordImplObligation`
-- forwarding that value FAITHFULLY (which is the whole point of U1c) still produces a
-- bare goal in that case.  Two such sources, one closed by construction and one that
-- is NOT:
--   * The compatibility leg's OWN worked example above (`main = println 1`,
--     `check stdlib/core.mdk`, …) is CLOSED as of #1227 for the ordinary "user program
--     imports the prelude" shape: `stampFlatTyOrigins`'s occurrence layer stamps a
--     prelude interface occurrence `core` even in flat/no-module-graph mode
--     (`flatTyOriginScope` carries the prelude's own interfaces), and
--     `checkProgramSeededSplit` additionally calls `stampDeclOrigins "core" coreProgTy`
--     — so goal and impl agree on identity `core` and no bare goal is minted at all.
--     MEASURED on this branch (post-U1c): `check` of `main = println 1` and of
--     `compiler/driver/medaka_cli.mdk` are BOTH clean with the leg *removed* — this
--     shape genuinely needs no leg any more.
--   * `medaka check stdlib/core.mdk` **directly** (the prelude checking ITSELF, not a
--     user program importing it) is a DIFFERENT shape and is NOT closed.  Checking
--     `core.mdk` as the entry file reaches `checkProgramSeeded` with `coreProg0 = []`
--     (the "prelude is already flattened into `prog`" arm — see this file's own
--     `checkProgramSeededSplit` comment), so `core.mdk`'s OWN interfaces and impls are
--     stamped with a scope that does not include core.mdk's own declarations at all —
--     they never get an identity, on EITHER layer.  MEASURED, on this branch, with the
--     leg *removed* (a throwaway experiment, reverted — not landed):
--     `medaka check stdlib/core.mdk` regresses from a clean exit 0 to **exit 1 with 32
--     `No impl of <Iface> for <Ty>` false rejects** (re-derive with `grep -c 'No impl'`
--     on the check output rather than trust this number; `Ord`/`Eq`/`Foldable`/`Mappable`/…,
--     the exact cascade shape this leg's worked example predicted). With the leg
--     restored it is clean again. `compiler/driver/medaka_cli.mdk` and
--     `main = println 1` stayed clean in BOTH arms of this experiment — the residual is
--     narrower than the pre-#1227 cascade, but it is real and it is live TODAY, after
--     U1c, not a hypothetical.
--
-- ⚠️ So: **DO NOT DELETE THIS LEG.**  U1c closes the THIRD `ImplUniverse` goal
-- producer, which is a real and necessary step, but it is NOT the sole remaining
-- condition — a self-checking flat prelude is a fourth source of bare goals this leg
-- protects, independent of any producer, and it has no owner yet. Do not trust a census
-- of `ifaceRefBare` call sites to answer this question by itself; re-run the experiment
-- above (temporarily drop the bare key from `oblIfaceKeys`'s non-`OriginUnresolved`
-- arm, rebuild, `check stdlib/core.mdk`) before believing the leg is dead weight.
--
-- ⚠️ CONSEQUENCE FOR #1438.  U1b drained the PINNED INSTANCE (a signed forwarder,
-- reached through the signature `=>` slot channel U1b widened); the CLASS did not
-- drain with it — deleting one signature line reposed the same goal through the bare
-- METHOD OCCURRENCE producer this file no longer has, and it was a silent accept
-- (`check` exit 0, `build` exit 0, built binary SEGFAULTS at 139) right up to U1c. U1c
-- closes that remaining reach: the minimal pair that used to live at
-- `test/must_fail_fixtures/1507-xmod-iface-name-collision-method-occurrence/` now
-- REJECTS and the pin is retired, replaced by the positive pair
-- `test/dict_fixtures/i4-xmod-method-occurrence-{foreign-iface-rejected,
-- own-iface-control}` (alongside U1b's own
-- `i4-xmod-sig-constraint-{foreign-iface-rejected,own-iface-control}`). **#1438 itself
-- stays open** pending confirmation that no other reach of the same collision survives
-- (see #1507's own issue thread) — this comment records the obligation-channel half,
-- not the whole issue.
--
-- Order within a bucket is preserved per key (`mregAppendK` appends), so
-- `findMatchingImplReqsU`'s declaration-order first-match is unchanged on either leg.
insertUnivImplKeys : List TabKey -> List Ty -> List Require -> ImplUniverse -> ImplUniverse
insertUnivImplKeys [] _ _ univ = univ
insertUnivImplKeys (ifk::rest) tys reqs univ =
  insertUnivImplKeys rest tys reqs (insertUnivImplAt ifk tys reqs univ)

-- the interface keys an IMPL is indexed under: the identity key, plus the bare
-- spelling key when the two differ (an identity-less occurrence mints the bare key
-- from `tabKeyOf` already, so the list is a singleton there and nothing is doubled).
oblIfaceKeys : IfaceRef -> List TabKey
oblIfaceKeys ir = match ir.irOrigin
  OriginUnresolved => [TkBare NsIface ir.irName]
  _ => [oblIfaceKey ir, TkBare NsIface ir.irName]

insertUnivImplAt : TabKey -> List Ty -> List Require -> ImplUniverse -> ImplUniverse
insertUnivImplAt ifk tys reqs (ImplUniverse conc hl tags) = match univReceiverTag tys
  Some hk =>
    -- Each key is bound ONCE — Medaka is strict and `regKeyRender` BUILDS a
    -- string, so a re-minted key is a re-rendered key.  `regInsertCheckedK`
    -- (`types/registry.mdk`) carries the same warning for the same reason, and
    -- `check` is GC-bound.
    let ifkey = regKeyOfTab ifk
    let hd = dispHeadTab hk
    -- ⚠️ the third bucket is the ACCEPTANCE census, not a dispatch table — see
    -- `univHeadCountsInCensus`.  It is the ONE of these three that an arrow- or
    -- effect-headed impl must stay out of.
    ImplUniverse
      (mregAppendK (regKeyNTab [ifk, hd]) (tys, reqs) conc)
      hl
      (univAddIfaceTag (univHeadCountsInCensus tys) ifkey hd tags)
  None => ImplUniverse conc (mregAppendK (regKeyOfTab ifk) (tys, reqs) hl) tags

-- ✅ #1446 (T2): THE OBLIGATION CHANNEL'S INTERFACE KEY IS AN IDENTITY.  `Predicate`
-- carries an `IfaceRef` (P1), so `checkOneCallObligation`'s goal side supplies the
-- same `TyConOrigin` the writer reads off `DImpl.implOrigin`, and this key is minted
-- through the ONE total mint (`tabKeyOf`) on both sides.
--
-- 🚨 THIS BLOCK'S PREDICTION WAS MEASURED-WRONG IN DIRECTION, AND THE CORRECTION IS
-- THE REASON THE LEDGER SAYS SO RATHER THAN BEING QUIETLY DELETED.  It said keying the
-- writer while the readers stayed bare would "silently switch the whole missing-impl
-- obligation check off" — a `loud → silent` severity increase with no golden moving.
-- It is the OPPOSITE.  This is a PAYLOAD table, not a GATE: a missed lookup means "no
-- impl exists", i.e. a REJECT.  Measured twice — #1112's 2026-08-09 P1 experiment
-- (writer-only prototype: `make check-self` exit 1, 634 `No impl of …`, 61/61
-- behaviour goldens moved) and again here on this tree, where leaving just TWO goal
-- producers identity-less made `medaka check` of a file containing only
-- `main = println 1` exit 1 with 9 rejects.  The reasoning that produced the wrong
-- prediction generalised from a GATE-shaped sibling (`ifaceRegistered`, `Unit`-valued)
-- while describing a payload-shaped table; `.claude/workstreams/TYPECHECK.md` trap 11
-- now carries the rule.  ONE sub-case is genuinely silent and it is nested inside this
-- one: `checkUndeterminedObligation`'s RULE 3 is guarded on `implCountForIfaceU >= 2`,
-- so a missed count reads 0 and `T-AMBIGUOUS-INSTANCE` stops emitting.
--
-- ⚠️ THE HEAD HALF STILL DOES NOT MOVE, and that is not symmetry-for-its-own-sake:
-- see `dispHeadTab` for the measured derivation (#1317 T1 / the closed S0 #1277).
-- The `NsIface` tag is not decoration either: it is what stops a future table that
-- mixes namespaces from colliding a bare interface name with a bare type name of the
-- same spelling.
--
-- ⚠️ AN IDENTITY-LESS GOAL IS STILL LEGAL AND STILL MATCHES BY SPELLING — see
-- `insertUnivImplKeys` for the compatibility leg, the `ifaceRefBare` producers that
-- still need it (U1b/#1482 retired two of three; #1507 owns the last), and the
-- corrected condition under which it is deleted.
oblIfaceKey : IfaceRef -> TabKey
oblIfaceKey ir = tabKeyOf NsIface ir.irOrigin ir.irName

-- 🚨 THE HEAD COMPONENT OF EVERY DISPATCH KEY IS **BARE**, AND IT IS NOT
-- BECAUSE THE IMPL SIDE LACKS IDENTITY.  It has it: `headTyconTy` reads a
-- `Ty.TyCon`'s stamped `TyConOrigin`.  It is because the GOAL side cannot
-- match it, and that is MEASURED, not argued.  A-2.2b built this key on the
-- head's `TabKey` first, rebuilt the compiler, and watched it reject its own
-- prelude — `No impl of Ord for Int`, `No impl of Display for String`,
-- `No impl of Semigroup for String` — on BOTH driver arms.  Instrumenting the
-- two sides of one lookup (`main = println "hi"`, flat arm) printed:
--
--   impl  side  …4:type7:builtin0:3:Int      (`OriginBuiltin`)
--   goal  side  …4:type4:bare0:3:Int         (`OriginUnresolved`)
--
-- for EVERY primitive head — `Eq Int`, `Eq Char`, `Num Int`, `Ord Int`,
-- `Semigroup String`.  Two independent reasons, and the first alone is fatal:
--
--   1. CANONICALITY — THE FATAL ONE.  `Mono`'s own doc-comment (this file, at
--      `TCon`) states the field is a CARRIER that every comparison — `unifyN`
--      included — ignores, "so two modules' same-named types still unify exactly
--      as they did".  Two `TCon "Int"` with different origins therefore unify,
--      and which origin survives the link is an artefact of link DIRECTION.  A
--      key built on it is not a function of the type at all, and no amount of
--      supply repairs that.
--   2. SUPPLY — a gap that CAN be filled, and ✅ #1280 FILLED IT.  `Mono.TCon`'s
--      origin is filled at the four mints, and a mono that reaches a dispatch
--      goal through a signature (`fromAstTypeE`) inherits whatever its `Ty`
--      carried.  The hole was NOT `stampTyHead` (`frontend/resolve.mdk`), whose
--      scope does contain the primitives: it was that `stdlib/runtime.mdk`'s
--      EXTERN signatures never passed through the stamping walk at all, so every
--      mono flowing out of an extern's declared type was `OriginUnresolved`.  It
--      was per-PROVENANCE silent, not systematically silent — `(1 : Int) < 2`
--      supplied identity; `stringLength "xy" < 2` did not — and it was not
--      confined to the flat arm, so the earlier units' framing ("A-2 is
--      module-path-only until #1115") never covered it.  `externSchemes` (this
--      file) now stamps under `externTyOriginScope`; the goal-side head for an
--      extern-sourced primitive was MEASURED before and after and moved from
--      `TkBare NsType` to the same `TkIdent` the impl side already carried, on
--      BOTH arms.
--
-- ⚠️ THAT ORDER IS LOAD-BEARING AND WAS ONCE WRITTEN THE OTHER WAY ROUND HERE,
-- while #1111's own write-up listed it as it is now — two records naming
-- OPPOSITE causes as fatal under the identical sentence.  `#1111` is the record
-- that stands; this note is the one that was corrected.
--
-- ⇒ The dispatch tables can move onto the identity SUBSTRATE now — a
-- namespaced, injective, structurally position-aware key instead of spliced
-- text — but the head COMPONENT cannot become an identity until the goal side
-- is supplied and canonicalised.  That is a semantics change with its own
-- fixture, not a re-key, and doing it here shipped a compiler that rejects
-- `1 + 1`.
--
-- 🚨 ONE OF THOSE TWO PRECONDITIONS IS MET, NOT BOTH.  ⚠️ This sentence used to
-- continue "AND THE DIFFERENCE IS THE WHOLE OF WHAT #1317 STILL HAS TO SOLVE",
-- which #1317's own scoping pass then measured to be false — there is a THIRD
-- precondition, it is not a supply gap, and it is the binding one for half these
-- sites.  See the 🚨 block below before acting on this paragraph.
-- Canonicality: met, by A-2.10.  Supply:
-- met **for the EXTERN population only**, by #1280 — which is one of the TWO
-- populations that had no identity, not the residual.  ⚠️ An earlier draft of this
-- paragraph said "BOTH … ARE NOW MET"; that was written by #1280's own author and
-- is exactly the over-claim this ledger must not make, because this comment is the
-- anchor #1317's issue routes its implementer to (`grep -nw dispHeadTab`).
--
-- The population that remains is the FLAT/loader-less driver's own user module —
-- **#1115 / E-1, OPEN**.  `stampFlatTyOrigins` (`frontend/resolve.mdk`, and see its
-- `#1110 flat-identity` residual note) deliberately claims nothing for the user
-- program's own declarations, because that driver has no loader-derived module id
-- and an invented one is made PERMANENT by `stampTyHead`'s immunity rule.  So a
-- flat user module's own `data` head reaches this projection with
-- `OriginUnresolved`, and `tabKeyOf`'s `None => TkBare ns name` arm
-- (`types/registry.mdk`) turns it into a `TkBare` — the *same* "goal side is mixed"
-- condition A-2.2b measured, surviving for the other population.  ⚠️ Do not take
-- that on trust and do not re-derive it with a probe either: it is already
-- committed evidence.  `test/origin_fixtures/graph/agreement.golden`'s `RESIDUAL`
-- section lists the `flat` arm's surviving `OriginUnresolved` heads by name
-- (`flat alpha Crate`, `flat alpha Weight`, `flat beta Shipment`, …) — those are
-- the user modules' OWN types.
--
-- A THIRD, smaller gap, for completeness: the prelude-FLATTENED internal passes
-- have no prelude boundary, so they leave `Option`/`Ordering`/`Result` absent —
-- symmetrically, since the flattened prelude's own declarations are unstamped
-- there too (`externSchemes` carries that derivation and the call-site list).
--
-- 🚨 AND THERE IS A **THIRD PRECONDITION**, WHICH IS NOT A SUPPLY GAP AT ALL AND
-- WHICH NO AMOUNT OF SUPPLY CLOSES — #1317's scoping pass, MEASURED.  The two
-- preconditions above (canonicality, supply) are the ones this ledger has always
-- named, and they are the wrong frame for HALF of the sites below.  Read this
-- before re-keying anything here; it is the half that bites.
--
-- The sites this ledger enrols split into TWO independent tables:
--
--   T1  the head partition — `headBucketKey` (written, at the time of this ledger, by
--       `bucketKeyEntriesFrom` and `ieFileRowByHead`; `bucketKeyEntriesFrom` and its
--       sibling `headBucketRender` were later deleted by `S-keytable-payoff`, `75f4148f`)
--       and its retests
--       `headTabIs`/`headTabEq`/`headTabOf`, consumed by `ieImplExistsForHeadGo`,
--       `ieCountHeadByIfaceGo` and `ieCountHeadByMethodGo`.  ⚠️ ARCH B-2.1-d deleted
--       this tier's `KeyBuckets` readers (`bucketOfHead`, `implExistsForHeadGo`,
--       `countHeadGo`); the retests and the enrolment rule are unchanged, and the
--       surviving consumers are the `IE` scans named above.
--   T2  the `ImplUniverse`/obligation channel — `insertUnivImpl`,
--       `univConcreteBucket`, `oblKeyParts`.
--
-- **T2 moves cleanly; T1's two COUNTING scans must not move at all.**  Measured on
-- a cold-built `MEDAKA_STRICT=1` binary at `7bf3165e`, three builds, probed with
-- #1277's own three-module repro: moving all of `dispHeadTab` turns `(1, 2)` into
-- `(1, 1)` — a valid program, exit 0, wrong answer, no diagnostic, i.e. #1277's
-- own S0 re-introduced.  Moving T2 alone does not.  Moving ONLY the two counting
-- scans' retest, with everything else here left spelling-keyed, reproduces it
-- exactly — so the cause is isolated to the two counting scans (the
-- latter measured as `countHeadByIface`, its `KeyBuckets`-reading predecessor;
-- ARCH B-2.1-b2 moved its BUCKET to `ieHeadRows` and left its RETEST spelling-keyed
-- for exactly the reason this ledger gives).
--
-- WHY, and why supply is beside the point: those two feed
-- `ieHeadCollidesByMethod`/`ieHeadCollidesByIface` → `keyForSite`/`keyForSiteByIface`, which
-- stamp a ROUTE WORD.  Route words are bare names by construction, and three
-- engines re-derive the same uniqueness test from a bare `String` tag
-- (`core_ir_lower.declRouteKey`/`ifaceDeclHeadUnique`,
-- `llvm_emit.headTagUnique`/`distinctKeysAtHead`, `eval.pickTagFallback`'s peer).
-- An identity-keyed count answers 1 where the spelling count answers 2, so
-- `keyForSite` takes its no-collision branch and stamps the bare head word into a
-- dict cell that is then ambiguous at run time.  The question "is this route word
-- ambiguous" is inherently SPELLING-scoped; answering it with identities is wrong
-- at any supply level, TOTAL SUPPLY INCLUDED.  See `ieCountHeadByIface`'s own comment
-- for the full derivation and `keyForSite`'s for the same conclusion reached from the
-- other side.
--
-- ⇒ The head COMPONENT is therefore still spelling-keyed, and that is still
-- CORRECT rather than merely deferred.  What #1317 owns, restated with the
-- measurement in hand:
--
--   * **T1's counters retire WITH #1113 (B-2)**, not before it and not by a
--     re-key — B-2's blast list already names `keyForSite*` and the `KeyBuckets`
--     slices alongside the emitter word-set retirement, and at that point they are
--     DELETED (no head-tag hedge left to disambiguate) rather than re-keyed.  The
--     sequencing "`#1280` → `#1317` → B-2" recorded on #1113 is INVERTED for them.
--   * **T2 HAS MOVED** — #1446, landed with #991: `Predicate` grew an interface
--     identity and `oblIfaceKey` moved with it, so the channel is not half-migrated.
--     The named accumulator risk (a per-RUN `obUnivConcreteRef` read from a
--     prelude-FLATTENED pass, which would MISS under an identity key — that ref is
--     since retired by #1112 A-3.4 PR2, and the argument now reads on the
--     `ieUniverseAt` projection that replaced it) did NOT
--     reproduce, and the reason is structural rather than statistical: there are
--     exactly TWO `ImplUniverse` sources and they are ARM-GATED — the `Flat` arm
--     builds a fresh `buildImplUniverse prog`, only the `Module` arm reads the
--     whole-graph one (since #1112 A-3.4 PR2 that is `ieUniverseAt`'s projection of
--     `IE`, not the retired `CrossRun` accumulator; still ONE source, still
--     arm-gated, which is why this argument survived the flip unchanged), and all
--     five `externTyOriginScope []` prelude-flattened sites route to `Flat`.  ⚠️ That separation is now load-bearing, and E-1 (#1115)
--     is exactly the unit that would break it by migrating Flat consumers onto the
--     Module path; `test/dict_fixtures/i7-flatten-arm-fresh-universe/` pins it.
--   * **#1115 is NOT this unit's blocker.**  It is still open and still worth
--     closing for I6.3's sake, but the regression above is on the MODULE arm,
--     where every head carries identity; the flat-arm probes were byte-identical
--     under every build.  Population (a) is identity-less SYMMETRICALLY — impl side
--     and goal side equally unstamped — which is why it produced no false conflict.
--     ⚠️ That last clause is an INFERENCE from the golden plus the three builds'
--     agreement, not an audit of the class.
--
-- ⚠️ AND THE RIGID ARM IS KEYED, DELIBERATELY.  `headKeyName (HkRigid n) = n`,
-- so a rigid parameter still hands out a bucket key — the §8 I6.1 residual
-- A-2.2 made greppable, which this unit does NOT get to delete, because
-- deleting it changes an answer: a rigid may legally be spelled `__tupleN__`
-- (see `Mono.TRigid`'s naming rule; §8 I6.2(b) tracks that forgery), and a
-- rigid so spelled currently reaches the tuple head's bucket.
-- `types/registry.mdk` carries the machinery to separate the two populations
-- (`headKeyDecl`, `headBucketKey`'s refusal, `dispKeyRender`'s residual group)
-- and doctests it; it stays UNUSED at these sites, and the follow-on semantics
-- unit switches them over.
--
-- THIS FUNCTION IS THE LEDGER — and it is the ledger for every dispatch
-- DECISION taken on a head's spelling, not only for every dispatch KEY built
-- from one.  That distinction is not pedantry: it is the gap the first cut of
-- A-2.2b fell into.  `implExistsForHeadGo` builds no key at all — it RETESTS a
-- head against the bucket it is scanning — and because it sat outside this
-- ledger it was quietly changed to compare IDENTITIES, which made it strictly
-- stronger than the spelling-keyed bucketing and silently rerouted every call
-- whose receiver came from an unstamped extern signature (S0; see there).  So
-- the enrolment rule is: if a site's answer would CHANGE when the head half
-- becomes an identity, it goes through this function.
--
-- ⚠️ AND `implExistsForHeadGo` WAS NOT THE ONLY UNENROLLED RETEST — it was the
-- only one anybody had looked at.  Round-2 review found the same defect twice
-- more, in `countHeadGo` and `ieCountHeadByIfaceGo`, each scanning a
-- spelling-keyed `bucketOfHead` while retesting `hd2 == hd` on `Option HeadKey`.
-- Both are now enrolled (via `headTabEq` / `headTabOf`) and both appear in the
-- grep below.  Treat "the fix is applied at the site the report named" as an
-- incomplete audit for this class: the projections are duplicated per SCAN, so
-- the question is always which scans exist, not which one was reported.
--
--   grep -nw dispHeadTab compiler/types/typecheck.mdk
dispHeadTab : HeadKey -> TabKey
dispHeadTab hk = TkBare NsType (headKeyName hk)

-- the receiver-position head tycon tag of an impl's head types (None for a headless
-- receiver or an empty head list) — the SAME tag `headTyconMono` computes for a
-- dispatch mono, so an impl and the args it matches land under the same key.
univReceiverTag : List Ty -> Option HeadKey
univReceiverTag (headTy::_) = headTyconTy headTy
univReceiverTag [] = None

-- ── the acceptance census, at the impl-UNIVERSE layer ─────────────────────
-- 🚨 THE THIRD BUCKET (`iface → SET of head tags`) IS NOT A DISPATCH TABLE, AND
-- IT MUST NOT BE POPULATED BY `univReceiverTag`.  Its only reader is
-- `implCountForIfaceU`, whose only reader is `checkUndeterminedObligation`'s
-- RULE 3 — *"the var escaped its group anchored to NOTHING and the iface has >= 2
-- impls ⇒ genuinely ambiguous"*, a `T-AMBIGUOUS-INSTANCE` REJECT.  The other two
-- buckets ARE dispatch tables and keep `univReceiverTag`.
--
-- Giving `headTyconTy` a `TyFun` arm and a `TyEffect` peel (#1617/#1618) is a
-- ROUTING fix, but it reached this set through the shared writer and pushed the
-- count from 1 to 2 for `impl C Int` beside `impl C (Int -> Int)` — measured on
-- both arms, exit 0 → exit 1 on a program that never dispatches to the arrow.
-- The set's own doc-comment already stated the rule this restores: *"headless
-- impls contribute no tag, exactly as `implHeadTagsFromHeads` skipped them"* —
-- and `implHeadTagsFromHeads`' successor, `implHeadTagForIface`, is the sibling
-- census that reads `censusHeadNameTy` for exactly the same reason.
--
-- ⚠️ TWO WRITERS, ONE HELPER, ON PURPOSE.  `insertUnivImplAt` (Flat path) and
-- `ieInsertRowAt` (`IE`, the Module path `ieUniverseAt` projects the universe
-- out of) both write a tag set, and a fix applied to one is silently absent from
-- the other — the parallel-driver hazard `AGENTS.md` names for
-- `evalModules`/`cevalModules`.  Both call THIS.
univHeadCountsInCensus : List Ty -> Bool
univHeadCountsInCensus (headTy::_) = isSome (censusHeadNameTy headTy)
univHeadCountsInCensus [] = False

-- Add [hd] to [ifkey]'s tag set, or leave the set alone when the head does not
-- count in the census.  The `True` arm is byte-identical to what both writers
-- did inline before; the `False` arm is the restored drop.
univAddIfaceTag : Bool -> RegKey -> TabKey -> Registry SetRegistry -> Registry SetRegistry
univAddIfaceTag False _ _ tags = tags
univAddIfaceTag True ifkey hd tags =
  regInsertK
    ifkey
    (sregAddK (regKeyOfTab hd) (fromOption sregEmpty (regLookupK ifkey tags)))
    tags

-- ── PR3 keyed lookups (replace implMatches / implMatchesReceiver / findMatchingImplReqs /
-- implCountForIface).  Each first scans the concrete "iface|tag" bucket, then the iface's
-- headless bucket.  implMatchesU / implMatchesReceiverU are EXISTENCE tests, so the
-- concrete-then-headless order is byte-identical to the old flat scan.  findMatchingImplReqsU
-- is first-MATCH and DOES depend on that order — a deliberate soundness/conformance fix,
-- documented on it below. ────────────────────────────────────────────────────────────────

-- does SOME impl of [iface] match the concrete dispatch monos [args]? (existence)
implMatchesU : ImplUniverse -> IfaceRef -> List Mono -> Bool
implMatchesU _ _ [] = False
implMatchesU univ iface (a0::rest) = bucketArgsMatch (univConcreteBucket univ iface (headTyconMono a0)) (a0::rest)
  || bucketArgsMatch (univHeadless univ iface) (a0::rest)

bucketArgsMatch : List (List Ty, List Require) -> List Mono -> Bool
bucketArgsMatch [] _ = False
bucketArgsMatch ((tys, _)::rest) args = implHeadMatchesArgs tys args
  || bucketArgsMatch rest args

-- does some impl of [iface] have a RECEIVER (first head type) matching the single
-- dispatch mono [dm]?  (the call-obligation path carries only the receiver mono.)
implMatchesReceiverU : ImplUniverse -> IfaceRef -> Mono -> Bool
implMatchesReceiverU univ iface dm = bucketRecvMatch (univConcreteBucket univ iface (headTyconMono dm)) dm
  || bucketRecvMatch (univHeadless univ iface) dm

bucketRecvMatch : List (List Ty, List Require) -> Mono -> Bool
bucketRecvMatch [] _ = False
bucketRecvMatch ((tys, _)::rest) dm = match tys
  recv::_ => match matchTyMono recv dm
    Some _ => True
    None => bucketRecvMatch rest dm
  [] => bucketRecvMatch rest dm

-- the impl of [iface] whose `requires` we must check at a dispatch to [args] (the
-- receiver-head mono [args[0]]), with its (subst, reqs) — the impl checkNestedReqs
-- then discharges.  The concrete RECEIVER-head bucket is consulted BEFORE the iface's
-- headless bucket, so a specific impl always outranks a `impl Foo a` catch-all.
--
-- ⚠️ Coherence ACCEPTS a specific-vs-general overlap (`impl Foo Int` + `impl Foo a`,
-- most-specific-wins), so TWO impls can match one concrete mono.  Selecting the WRONG
-- one's requires is a soundness hole: parametric `impl Foo a` (no reqs) first + concrete
-- `impl Foo Int requires Bar Int` (no `impl Bar`) → an ACCEPT then a runtime null-dict
-- crash, because `foo (3:Int)` dispatches to the MOST-SPECIFIC `impl Foo Int`.
--
-- #326: the within-bucket winner is chosen by the SHARED min⊑ selector — the SAME
-- registry, and the SAME selector, the dispatch ROUTER stamps with (PR #319 fixed the
-- router, this makes the CHECKER agree).  ⚠️ ARCH B-2.1-b2 moved BOTH sides at once:
-- that registry is now `ieSelectRowByIface` over the graph-global `IE`
-- (`bodyImplEnvRef`), not `selectImplEntryByIface` over the topological-prefix
-- `shadowKeyTableRef`.  The checker-agrees-with-router property is what forced the two
-- to move in one bite — see the `B-2.1-b2` block's three-leg header.  It returns the most-specific impl's
-- OWN requires — [] for a no-requires specific `impl Foo (List Int)` sibling declared
-- ALONGSIDE a `impl Foo (List a) requires Show a`, both in the same `List` head bucket —
-- never the general sibling's.  The prior concrete-then-headless first-match ranked
-- concrete-vs-headless correctly but took DECLARATION-ORDER first-match WITHIN a shared
-- head bucket, so `Foo (List Int)` could inherit `List a`'s `Show a` requirement (a false
-- reject/accept).  A non-overlapping receiver head has exactly one match, which
-- pickMostSpecificEntry returns unchanged ⇒ byte-identical to the old first-match.
-- ⚠️ #1128 (F-3b) CORRECTION.  This said "Headless impls carry no head tycon and so
-- are absent from KeyBuckets — the headless bucket fallback (still over the
-- ImplUniverse) covers them."  They are no longer absent: `keyEntryOf` registers a
-- bare-TyVar head under `noneHeadTag` and the candidate scan unions it into every
-- goal-head lookup (`candidateBucket` then; `ieCandidatesForIface`/`…ForMethod` since
-- B-2.1-b2, the former deleted by B-2.1-d), so a HEADLESS winner can be returned
-- directly.  That does not change which impl's requires get discharged — the union
-- goes through the same min⊑ selector, and concrete ⊑ headless strictly at every
-- single-param head, so a concrete match still outranks the catch-all exactly as the
-- "concrete bucket before headless bucket" ordering below did.  What it changes is
-- WHERE the headless answer comes from: the `firstReqMatch (univHeadless …)` fallback
-- is now reached only when the KeyBuckets union has no match at all (e.g. an empty
-- arg list, the arm above).  The fallback is retained rather than deleted because
-- `ImplUniverse` and `KeyBuckets` are populated from different decl sets and this
-- stage is a bug fix, not a registry merge.  ⚠️ `keyEntryOf` and `KeyBuckets` (this whole
-- paragraph's subject) were later deleted outright by `S-keytable-payoff` (`75f4148f`);
-- `findMatchingImplReqsU` below reads `ImplUniverse` only.  This paragraph is kept as the
-- historical record of the #1128 fix it documents, not as a description of the current
-- table.  Regression:
-- test/typecheck_error_fixtures/overlap_specific_req_wins.mdk (concrete-vs-headless) and
-- overlap_same_head_req_wins{,_swapped}.mdk (#326 within-bucket min⊑).
findMatchingImplReqsU : ImplUniverse -> IfaceRef -> List Mono -> Option (List (String, Mono), List Require)
findMatchingImplReqsU univ iface [] = firstReqMatch (univHeadless univ iface) []
-- 🚨 B-4b-ii SUPPLIES THE IDENTITY HERE — B-4b-i's `ifaceRefBare iface.irName`
-- wrapper is DELETED, and this is the behaviour change that bite deferred.
--
-- WHY THIS SOURCE IS TRUSTWORTHY, stated as a derivation rather than an assertion:
-- `iface` reaches this function from `reqObligationsFor` and `residualPredsOf`, whose
-- own `IfaceRef` is minted by `reqToObligation` off `Require.requireHead` +
-- `Require.requireOrigin` — a carrier `resolve.fillIfaceOccOrigin` stamps from the
-- DECLARING module's `iface:`-tagged scope, under the immunity rule (an occurrence
-- that already carries identity is never re-stamped).  It is NOT taken from
-- `methodIfaceParamsRef`, the bare-method-name-keyed table whose own S0s are open;
-- nothing on this path consults it.
--
-- ⚠️ THE TWO LEGS OF THIS FUNCTION DISAGREED, AND THAT IS WHAT THIS FIXES.  The
-- HEADLESS fallback one line below has ALWAYS been identity-keyed — `univHeadless`
-- looks the bucket up through `oblIfaceKey`, i.e. `tabKeyOf NsIface ir.irOrigin
-- ir.irName`, which is `TkIdent` for an origin-bearing interface — while the CONCRETE
-- leg re-minted the query bare and asked a SPELLING question over the same population.
-- One function, two keyings, and the concrete leg is the one tried first.
--
-- MEASURED false reject this removes (hand-derived first, then run): two unrelated
-- modules each declaring `interface Same a`, each with `impl Same (Box a)` — one plain,
-- one `requires Eq a`.  A use of the PLAIN one's method at `Box Opaque` was rejected
-- with *"No impl of Eq for Opaque"*, because the spelling scan reached the OTHER
-- module's row and imposed ITS `requires`.  Swapping the two modules' names made the
-- same program compile: the answer depended on declaration order, which is the
-- signature of a spelling-keyed selection. See `test/dict_fixtures/b4bii-*`.
--
-- ⚠️ ABSENCE IS STILL A WILDCARD, and that is what keeps the flat drivers alive:
-- `sameTyConHead`'s `tyConIdsConflict` answers True only when BOTH origins are
-- identities and they differ, so a single-file `check`/lsp/repl/doc run — which stamps
-- nothing — is unaffected, term for term.  This is NOT `ifaceIdMatches`; see
-- `ieRowIfaceMatches`.
findMatchingImplReqsU univ iface (a0::rest) = match concreteReqMatchByIface iface (a0::rest)
  Some r => Some r
  None => firstReqMatch (univHeadless univ iface) (a0::rest)

-- #326: the concrete-receiver-head requires match, routed through the shared min⊑
-- selector over the all-impls KeyBuckets registry (the router's `selectReqImpl` /
-- `argImplRequiresRoutes` select the SAME entry the SAME way).  Bind the winning
-- impl's typaram vars by matching its FULL head types against [args] (multi-param subst
-- preserved), then hand back that impl's OWN requires.  A selected entry whose full head
-- fails to match [args] yields None, so findMatchingImplReqsU falls through to the
-- headless bucket, mirroring the old scan.
-- #609: select on [args] — the FULL head-mono vector this function already matches
-- the winner's `itys` against two lines down.  Selecting on the receiver alone while
-- substituting against the whole vector was the same split #609 names: the checker
-- saw the vector, the selector saw arg 0.  With one goal for both, a selected entry
-- can no longer fail the subst for a reason the selector could have seen.
concreteReqMatchByIface : IfaceRef -> List Mono -> Option (List (String, Mono), List Require)
-- ARCH B-2.1-b2 (LEG 1, the CHECKER): off `shadowKeyTableRef` — a topological
-- PREFIX, so an impl in a later module contributed no `requires` and the goal read
-- as unroutable — onto the graph-global `bodyImplEnvRef`.  See the `B-2.1-b2` block
-- above for why moving this leg ALONE is an S0 rather than half a fix.
concreteReqMatchByIface iface args = match ieSelectRowByIface perRun.value.bodyImplEnvRef.value iface args
  Some (ImplRow _ _ _ itys reqs _) =>
    map (sub => (sub, reqs)) (implHeadSubst itys args)
  None => None

firstReqMatch : List (List Ty, List Require) -> List Mono -> Option (List (String, Mono), List Require)
firstReqMatch [] _ = None
firstReqMatch ((tys, reqs)::rest) args = match implHeadSubst tys args
  Some sub => Some (sub, reqs)
  None => firstReqMatch rest args

-- the number of DISTINCT concrete-head impls of [iface] (headless impls contribute no
-- tag, exactly as the old implHeadTagsFromHeads skipped them).
implCountForIfaceU : ImplUniverse -> IfaceRef -> Int
implCountForIfaceU (ImplUniverse _ _ tags) iface =
  fromOption
    0
    (map sregSize (regLookupK (regKeyOfTab (oblIfaceKey iface)) tags))

-- the concrete "iface|tag" bucket (empty when the tag is None / no such impl).
-- A-2.2 (#1111): the GOAL-side head arrives as a `HeadKey` that CAN carry
-- identity — this is the row the concrete bucket's `"<iface>|<tag>"` key is
-- built from, on both sides (`insertUnivImpl` is the impl side; the bucket used to
-- be cited as `obUnivConcreteRef`, retired by #1112 A-3.4 PR2).  The tag is
-- still that key's bare NAME, so every bucket lookup answers exactly as before.
-- A-2.2b (#1111): the `"\{iface}|\{tag}"` string splice is gone — this is a
-- structured two-component key (`RegKey`), so a `|` inside either half can no
-- longer forge the other, and each half carries its namespace.  Both halves are
-- still keyed by SPELLING; `dispHeadTab` derives why.
univConcreteBucket : ImplUniverse -> IfaceRef -> Option HeadKey -> List (List Ty, List Require)
univConcreteBucket (ImplUniverse conc _ _) iface (Some hk) =
  mregLookupK (regKeyNTab [oblIfaceKey iface, dispHeadTab hk]) conc
univConcreteBucket _ _ None = []

univHeadless : ImplUniverse -> IfaceRef -> List (List Ty, List Require)
univHeadless (ImplUniverse _ hl _) iface =
  mregLookupK (regKeyOfTab (oblIfaceKey iface)) hl

-- ── Error-path B4: missing-impl dispatch-obligation check ──────────────────
-- Mirror lib/typecheck.ml's check_method_usages (the `No impl of … for …` reject,
-- :3845).  For each recorded interface-method occurrence, recover the types the
-- interface params resolved to at this site (dispatchMonosOf), and — ONLY when
-- they are all CONCRETE (a resolved head tycon, no remaining polymorphic var, so
-- a constrained-generic `Ord a =>` site whose receiver is still `a` is correctly
-- deferred to the caller) — verify the program declares a matching impl.  None →
-- `No impl of <iface> for <args>`.
-- #838 I4: the second obligation checker (checkImplObligations/checkImplObligationsU/
-- checkOneImplObligation) is RETIRED — impl obligations now route through the unified
-- checkOneCallObligation (so a rule lands ONCE).
-- #991: the `implOblToU` bridge that used to project a surviving
-- `pendingImplObligations` 5-tuple onto `UObligation` is GONE — both channels store
-- `UObligation` directly.  The projection it performed still happens at CHECK time and
-- in the same place: `uOblArgs`, via the `OpMethodOcc` arm (NOT `oblDispatchMonos`,
-- which special-cases Num → [] and would drop a numeric literal's operand).
-- `groundMultiParamObligations` runs BEFORE the gate on both arms and grounds the shared
-- mono cells, so the projected args are already ground for multi-param obligations.

-- #11 soundness (native obligation hole): check each constrained-fn CALL site's
-- instantiated obligation.  When `f : C a => …` is applied (`g = f "hello"`),
-- inferDictAtFound recorded (iface, the instantiated constraint mono) here.  After
-- inference the mono is ground: a CONCRETE-head mono (`String`) with no matching impl
-- is an ERROR; a still-polymorphic head (`a`, the obligation propagated to a further-
-- out caller — `id x = x; y = id 5`) is DEFERRED.  Exactly the accept/reject decision
-- of checkOneImplObligation's tail, and the mirror of lib/typecheck.ml's
-- check_constraint_obligations (which checks fun_constraints instantiated at the call).
-- #838 I1: takes `List UObligation` (the ported call channel) instead of the old bare
-- tuple.  Deferral is BYTE-IDENTICAL to before the port — checkOneCallObligation still
-- reads (iface, occs, loc) exactly as it did; only the storage/read shape changed.
-- #838 I4: [deferNonGround] selects the ONE rule that genuinely differs between the two
-- obligation channels this single checker now serves (all GROUND rules — no-prelude-Num,
-- unimplementable-head, function-reject, accept/nested-reqs, reportNumOrNoImpl reframe —
-- are shared, which is the payoff).  False = the CALL channel: a non-ground obligation
-- runs checkUndeterminedObligations (RULE 2/3 ambiguity).  True = the retired IMPL
-- channel's semantics: a non-ground impl obligation DEFERS unconditionally (old
-- checkOneImplObligation step 7).  This is NOT a mode fork on elaboration — it is the
-- same fact the two checkers always encoded: the impl channel's genuinely-ambiguous
-- subset is caught out-of-band by registerAmbiguousConstraints (which re-records the
-- escaped-unanchored var as a PCallSlot CALL obligation → RULE 3), so applying RULE 3
-- to the impl channel directly would ALSO reject the benign non-ground impl obligations
-- (prelude interface-method occurrences: a bare receiver var recorded outside any
-- generalized-group-close window, so in neither deferrableVarIds nor the RETPOS pass) —
-- a spurious `Ambiguous instance` on essentially every program.  Adding those vars to
-- deferrableVarIds instead is UNSOUND: it is shared with the call channel's RULE 2, and
-- the RETPOS-registered ambiguous var must stay OUT of it or the genuine ambiguity would
-- defer too.  So the disposition is per-channel, byte-identical to each retired checker.
-- #838 I4 (S0 fix, PR #863 review): a CHECK-level [dedup] flag used to be the SECOND
-- per-channel fact here — the CALL channel skipped a repeat of an already-checked
-- (iface, every-arg-head-tycon) key, because the SAME call obligation is recorded by
-- more than one path (EVar + EDictAt).  That CHECK-level skip was itself the #1330 S0:
-- a tuple's head tycon is `__tuple2__` regardless of element types, so `Debug (Color,3)`
-- and `Debug (1,2)` shared a key, and skipping the second (a different-verdict sibling)
-- meant its checkNestedReqs `No impl Debug Color` reject never ran → check-green,
-- run-CRASH.  #1330 fixed it by running `checkOneCallObligation` on EVERY obligation on
-- both channels — the flag, the `seen` accumulator threaded to carry it, and the
-- `oblDedupKey` call that fed `seen` were left in place but unread (#1925: removed).
-- The ONLY dedup left is at EMISSION: `checkOneCallObligation`'s `pushTypeErrorOnceAt`
-- collapses two IDENTICAL rendered messages to one report — DICT-SEMANTICS §4.2 OD5.
checkCallObligations : Bool -> List Decl -> List UObligation -> Unit
checkCallObligations deferNonGround prog obligations =
  checkCallObligationsU deferNonGround (buildImplUniverse prog) obligations

-- #1925: the CHECK-level dedup key that used to be minted here (`oblDedupKey`,
-- A-2.2b #1111's identity-keyed encoding through `dispKeyRender`/`regKeyNTabAt`) fed
-- only a `seen` accumulator that #1330 (above) left unread — every obligation is
-- checked now, so there is nothing left to key.  Removed along with `oblKeyParts`
-- (its sole helper).  `dispKeyRender`/`dispHeadTab`/`regKeyNTabAt` stay — they are
-- general `types/registry.mdk` machinery with other callers.
checkCallObligationsU : Bool -> ImplUniverse -> List UObligation -> Unit
checkCallObligationsU _ _ [] = ()
checkCallObligationsU deferNonGround univ (o::rest) =
  let iface = o.pred.iface
  -- `uOblArgs`, NOT `o.pred.args`: an impl-channel obligation carries an EMPTY
  -- `pred.args` and projects its dispatch vector at CHECK time (see `OblProjection`).
  -- Reading the field directly makes every method-occurrence obligation inert here —
  -- `checkOneCallObligation` returns on `isEmptyL args` — which is SILENT.  Measured:
  -- with this line reading the field, `test/dict_fixtures/s6-2-t3-closed-goal-reported`
  -- flipped from its `T-AMBIGUOUS-INSTANCE` reject to an ACCEPT printing an
  -- order-decided 1-or-2, and `diff_compiler_dict_semantics`'s section-4 permutation
  -- differential was the only thing in the tree that caught it.
  let occs = uOblArgs o
  let loc = o.loc
  let _ = checkOneCallObligation deferNonGround univ iface occs loc
  checkCallObligationsU deferNonGround univ rest

-- [occs] is the predicate's whole argument vector.  At arity 1 the match test stays
-- implMatchesReceiverU (byte-identical to the pre-#607 behaviour: for a 1-param
-- interface the receiver IS the vector).  At arity >= 2 it is implMatchesU, which
-- matches the FULL head vector — the difference between "is there an impl of Ix whose
-- receiver is String" (yes-ish, vacuously) and "is there an impl of Ix for
-- (String, Bool)" (no).
checkOneCallObligation : Bool -> ImplUniverse -> IfaceRef -> List Mono -> Option Loc -> Unit
checkOneCallObligation deferNonGround univ iface occs loc =
  let args = map normalize occs
  if isEmptyL args then ()
  -- ⚠️ P1 (#1446): the three `Num` tests in this checker and in
  -- `checkUndeterminedObligation` stay SPELLING tests, not identity tests against
  -- `builtinIfaceRef BNum`.  They select a DIAGNOSTIC/defaulting policy for the numeric
  -- class, and an identity test would change which programs take these arms the moment a
  -- second `Num` can exist — a behaviour change §7.1 U1 owns, not this re-key.  Today the
  -- two cannot differ: a user redeclaration of a prelude interface name is rejected
  -- outright (`Duplicate interface: Num`).
  else if iface.irName == "Num" && anyListM numUnimplementableHead args then
    pushNoImplError iface.irName loc args
  -- A function-typed constraint obligation is fully ground yet has no impl — report
  -- `No impl of <iface> for <a -> b>` (not the emit path's misleading "Ambiguous").
  -- Placed BEFORE the no-prelude-Num skip below so a no-prelude `Num (a -> b)` still
  -- rejects structurally (mirrors checkOneImplObligation, where the Num/Eq/Ord
  -- unimplementable-head rejects precede the no-prelude skip).
  else if anyListM monoIsFunction args && not (implMatchesArgsU univ iface args) then
    pushNoImplError iface.irName loc args
  -- #838 I4 (was checkOneImplObligation step 4): no-prelude Num skip.  A grounded
  -- `Num Int` literal in a prelude-free program (bare-HM oracle, the prelude's `Num`
  -- absent) has no `impl Num Int`; without this guard the ground path below reports a
  -- spurious `No impl of Num for Int`, breaking `typecheck_main`/tc_probe oracle parity.
  -- #1539: the PRESENCE half is now `builtinClassPresent BNum` (was `ifaceRegistered
  -- "Num"`), per DICT §8 I7 qualification 4 — see `recordIfaceObligation`.  The SPELLING
  -- half (`iface.irName == "Num"`) deliberately stays a spelling test, exactly as the
  -- ⚠️ note above requires: the two halves ask different questions, and only the
  -- presence half is what #1539 owns.
  else if iface.irName == "Num" && not (builtinClassPresent BNum) then ()
  -- #838 I4: the ONE per-channel branch (see checkCallObligations).  IMPL channel
  -- (deferNonGround) defers a non-ground obligation unconditionally — byte-identical to
  -- the retired checkOneImplObligation step 7; its genuine ambiguities arrive via the
  -- CALL channel (registerAmbiguousConstraints → PCallSlot).  CALL channel runs the
  -- RULE 2/3 undetermined-var analysis.
  else if not (allConcreteHeads args) then
    if deferNonGround then () else checkUndeterminedObligations univ iface args loc
  -- 🚨 #1867 (S1): A TRUNCATED GOAL IS UNDER-DETERMINED, NOT DECIDABLE HERE.
  -- `recordCallObligations` records one obligation per SHATTERED per-tyvar dict slot,
  -- so a call to `useIx : (Ix a Char, Ix a Bool) => a -> Int` records the 1-ary goal
  -- `Ix Int` — the SECOND parameter of a two-parameter predicate is simply dropped.
  -- Its own header says this is deliberate ("widening this to a joint vector … moves
  -- emitted arity"), and it is: the JOINT obligation for the same predicate is recorded
  -- separately by `declaredSchemeOblsFor`/`declaredOblMixed` and reaches this checker
  -- with the full vector (`Ix Int Bool`, `Ix Int Char`), where it decides correctly.
  -- What was NOT safe is letting the truncated goal ALSO decide.  Below,
  -- `implMatchesArgsU` at arity 1 is `implMatchesReceiverU`, which matches on the
  -- receiver ALONE, so `Ix Int` matches BOTH `impl Ix Int Char` and `impl Ix Int Bool`;
  -- `checkNestedReqs` then poses that 1-ary goal to the min⊑ selector
  -- (`reqObligationsFor` → `findMatchingImplReqsU` → `pickMostSpecificEntry`), which
  -- finds two ⊑-incomparable candidates and reports `T-AMBIGUOUS-INSTANCE`.  MEASURED:
  -- that reject is the whole of #1867 — trace order at the base was
  -- `RECOBL Ix ×2` → `CHKOBL Ix nargs=1 args=Int` → `AMBIGOVERLAP-FIRE ngoals=1 ncands=2`
  -- → `RECERR T-AMBIGUOUS-INSTANCE`, with the correct 2-ary goals checked separately and
  -- silently accepting.  `medaka check` never surfaced it and `run`/`build` rejected the
  -- program unlocated (the #1812 surface).
  -- ⚠️ THE GATE IS "SOME IMPL OF THIS INTERFACE DECLARES MORE HEAD TYPES THAN THE GOAL
  -- CARRIES", not "arity 1".  A genuine 1-parameter interface has no impl head longer
  -- than 1, so this arm cannot fire for it and every existing 1-ary verdict is
  -- byte-identical.  [W-QUIETER] check: nothing goes silent that was decidable here —
  -- the truncated goal was never decidable (it cannot see the dropped argument), and
  -- the joint goal that CAN decide is checked on the same channel.  Negative controls,
  -- all still rejected with a located diagnostic: an unsatisfiable declared context
  -- (`No impl of Ix for Int Bool`), the same with the constraint INFERRED rather than
  -- declared, and a conditional two-parameter instance whose `requires` fails
  -- (`No impl of Tag for Color`, i.e. `checkNestedReqs` still runs — via the joint goal).
  -- Measured firings across `stdlib/list.mdk` and `compiler/driver/medaka_cli.mdk`: 0.
  -- Regression: test/dict_fixtures/s-nary-truncated-goal-not-ambiguous.mdk (accept) and
  -- s-nary-truncated-goal-joint-rejects.mdk (reject).
  -- ⚡ PERF (#1974): the truncation gate and the match test below read THE SAME two
  -- buckets, so they are answered from ONE pair of lookups (`oblCallVerdict`) rather
  -- than the two-then-two the separate `oblGoalIsTruncated` / `implMatchesArgsU` calls
  -- performed.  Every `mregLookupK` RENDERS ITS KEY INTO A FRESH STRING (`insertUnivImplAt`
  -- carries the same warning for the same reason, and `check` is GC-bound), so the
  -- doubled lookups were ~70 MB of extra garbage at N=400 modules and ~22% of the whole
  -- `typecheck` stage on `diff_compiler_perf_scaling.sh`'s `modules` shape — enough to
  -- push its TIME arm over the gate's 3.0x-per-doubling ceiling (measured 1.63 s -> 1.28 s
  -- at N=400 with the gate stubbed out).  The VERDICTS are byte-identical: same buckets,
  -- same concrete-then-headless order, same two tests, truncation still asked FIRST and
  -- over BOTH buckets.
  else match oblCallVerdict univ iface args
    -- truncated goal — defer to the joint obligation (see the block above).
    None => ()
    -- Recurse into a matched CONDITIONAL instance's `requires` (`impl Display (a, b)
    -- requires Display a, Display b`) so an unsatisfied element constraint surfaces
    -- (`main = (Red, 5)` → `No impl of Display for Color`) instead of the head-only
    -- match silently accepting (→ null element dict → SIGSEGV at runtime).
    Some True => checkNestedReqs univ iface args loc
    Some False => checkOneCallObligationNoImpl iface args loc

-- the no-impl tail of `checkOneCallObligation` — reached when the goal is neither a
-- truncation nor matched by any impl.  Extracted verbatim so `oblCallVerdict`'s three
-- verdicts can be a `match` without duplicating it; the two arms below are unchanged.
checkOneCallObligationNoImpl : IfaceRef -> List Mono -> Option Loc -> Unit
checkOneCallObligationNoImpl iface args loc =
  -- 🚨 #1939 / #1938 (OPEN WORLD): `allConcreteHeads` IS NOT GROUNDNESS, AND ONLY
  -- GROUNDNESS LICENSES A REJECT HERE.  It asks whether every argument has a head
  -- TYCON, which `Wrap a` satisfies while still carrying a variable — so a goal like
  -- `Tag (Wrap a)` walks past the defer gate above and is refuted against the impls of
  -- THIS load graph, which never contains the module's dependents.  This is the SAME
  -- closed-world reading `residualRefutableNow` carries, reached by the other channel,
  -- and it owns the SINGLE-PARAMETER half of both issues (a 1-ary goal is discharged
  -- here; the mixed/n-ary vector goes out as a residual).  MEASURED at slice 1's head
  -- `7941e5fe` with `residualRefutableNow` already fixed:
  --   * `f : Tag (Wrap a) => Wrap a -> String ; f x = tag x` — declared, never called,
  --     legal — still rejected at its own definition.
  --   * `medaka check lib.mdk`, where `lib` infers `Tag (Wrap α)` for
  --     `describe x = tag (Wrap x)` and the satisfying `impl Tag (Wrap Int)` lives in a
  --     module that IMPORTS `lib` — still rejected.
  -- ⚠️ THE GATE IS FIVE CONJUNCTS AND EACH ONE IS PAID FOR.  Bare openness is not
  -- enough.  The three below are slice 2's; the LANDING-SITE pair the fix round added
  -- (review S0-1 / S0-2 / S2-5) is derived on `goalDefersOpenWorld`'s own header, where
  -- the three exit-0 type-confused-dict programs they refuse are written out:
  --   * `monoVectorClosed` — a closed goal cannot instantiate further, so its verdict
  --     is the one the use site would reach anyway.  Keep rejecting those.
  --   * `monoHeadIsDecl` — §8 I6.1's rigid-variable forgery.  `headTyconMono` hands a
  --     bare `TRigid n` out as `HkRigid n`, so `allConcreteHeads` reads `Q zzz` (an
  --     UNDECLARED data-field variable, quantified by nothing) as concrete.  Without
  --     this conjunct that program becomes a SILENT ACCEPT — MEASURED: `check` exit 0,
  --     0 errors, on `test/typecheck_error_fixtures/rigid_mono_head_key.mdk`, whose
  --     golden is exactly this reject.  [W-QUIETER]: that is a severity INCREASE, not
  --     a fix, and it is the reason this arm is not the one-line `not
  --     (monoVectorClosed args)`.
  --   * `deferrableVarIds` — RULE 2's own test, one arm up in
  --     `checkUndeterminedObligation`: a goal whose variables NO enclosing scheme
  --     quantifies has nowhere to defer TO, and dropping it would green a program the
  --     emitter builds a null dict for.  ⚠️ A DECLARED CONTEXT'S VARIABLES ARE NOT
  --     `TRigid` AT THIS SITE — MEASURED: `g : Tag (Wrap a) => …` reaches here carrying
  --     `Tag (Wrap TVar#736)`, an ordinary unbound cell, so this test is a REAL one for
  --     the declared channel and passes because the id genuinely is deferrable.  (The
  --     end-of-sprint review's S0-2 asserted the opposite and called this conjunct
  --     vacuous for a declared context; it is vacuous only for a goal whose openness is
  --     ALL rigid — S2-5's nested-rigid shape, which conjunct 3 now covers.)
  if goalDefersOpenWorld iface args then ()
  -- #838 I4 (was checkOneImplObligation step 9): reportNumOrNoImpl is a strict superset
  -- of pushNoImplError — it reframes a ground `Num`-obligation tracing to a numeric
  -- LITERAL (loc-keyed `numlitReframeLoc`, not prov-keyed) into `T-TYPE-MISMATCH`, and
  -- degrades to pushNoImplError verbatim for any non-literal (every call obligation) —
  -- so this restores the impl channel's literal-mismatch diagnostic quality byte-for-byte.
  else
    reportNumOrNoImpl iface.irName args loc

-- match test for a call obligation's argument vector: receiver-only at arity 1 (the
-- historical, deliberately lenient 1-param shape), full head-vector at arity >= 2.
implMatchesArgsU : ImplUniverse -> IfaceRef -> List Mono -> Bool
implMatchesArgsU univ iface [a] = implMatchesReceiverU univ iface a
implMatchesArgsU univ iface args = implMatchesU univ iface args

-- #1867 + PERF (#1974): the ONE call-obligation verdict, answered from ONE pair of
-- bucket lookups.  It fuses two questions the separate `oblGoalIsTruncated` /
-- `implMatchesArgsU` pair asked over THE SAME buckets, each re-minting (and re-RENDERING,
-- see `insertUnivImplAt`) its registry key:
--   `None`       — the goal is a TRUNCATION of a k-parameter predicate, k > its own
--                  arity: some impl of [iface] this goal could reach declares more head
--                  types than the goal carries.  Scoped to arity 1 because that is the
--                  only truncation any producer mints — `recordCallObligations` shatters
--                  a predicate into ONE obligation per dict slot, each carrying a single
--                  mono; every other goal on this channel is a whole vector.  See
--                  `checkOneCallObligation`'s block for the verdict this decides and why
--                  deferring is not a [W-QUIETER] regression.
--   `Some True`  — some impl matches (receiver-only at arity 1, full head vector above).
--   `Some False` — no impl matches.
-- ⚠️ ORDER IS SEMANTIC AND UNCHANGED.  The truncation question is still asked FIRST and
-- over BOTH buckets (concrete receiver-head bucket, then the iface's headless bucket) —
-- a goal that is truncated defers even when the concrete bucket would have matched it.
-- The headless bucket is still read only when the concrete one did not already answer
-- "truncated", exactly as the old `||` short-circuited; it is then REUSED by the match
-- test instead of being looked up again.  No third universe, no new registry read.
oblCallVerdict : ImplUniverse -> IfaceRef -> List Mono -> Option Bool
oblCallVerdict univ iface [a0] =
  let cb = univConcreteBucket univ iface (headTyconMono a0)
  if bucketAnyLonger cb 1 then None
  else
    let hb = univHeadless univ iface
    if bucketAnyLonger hb 1 then
      None
    else
      Some (bucketRecvMatch cb a0 || bucketRecvMatch hb a0)
oblCallVerdict univ iface args = Some (implMatchesU univ iface args)

bucketAnyLonger : List (List Ty, List Require) -> Int -> Bool
bucketAnyLonger [] _ = False
bucketAnyLonger ((tys, _)::rest) n = listLen tys > n || bucketAnyLonger rest n

-- an undetermined-var check per argument of the predicate (at arity 1 this is exactly
-- the old single call).
checkUndeterminedObligations : ImplUniverse -> IfaceRef -> List Mono -> Option Loc -> Unit
checkUndeterminedObligations _ _ [] _ = ()
checkUndeterminedObligations univ iface (a::rest) loc =
  let _ = checkUndeterminedObligation univ iface a loc
  checkUndeterminedObligations univ iface rest loc

-- WS-1c: a constrained call whose constraint var stays UNDETERMINED (pinned by
-- neither arg nor result, `roundtrip 14` where `roundtrip : Sub a => Int -> Int`).
-- If the var is a FORWARDED enclosing-fn dict (activeDictVarOf Some), it's resolved
-- by dict-passing — fine.  Otherwise it is genuinely free, and the route must pick
-- an impl with no type to guide it: ONE impl of [iface] → sole-impl default (no
-- error; routeUndeterminedTop stamps it concretely); TWO or more → genuinely
-- ambiguous → AmbiguousImpl (the deliberate divergence from the oracle's silent
-- first-wins).  Skip "Num" (its literal defaulting handles ambiguity) and ifaces
-- with no user impls (zero → existing no-impl path).  This runs on BOTH the check
-- path (checkModuleFullImpl) and the emit/eval path, so `check` rejects too.
checkUndeterminedObligation : ImplUniverse -> IfaceRef -> Mono -> Option Loc -> Unit
checkUndeterminedObligation univ iface occ loc
  | iface.irName == "Num" = ()                                       -- RULE 4a: Num → literal defaulting, never ambiguity (a SPELLING test — see checkOneCallObligation)
  | isSome (activeDictVarOf occ) = ()                                -- forwarded enclosing-dict slot (fold-in)
  | anyIn (monoUnboundIds occ) perRun.value.poisonedVars.value = ()  -- Chunk A: primary mismatch already explained this var
  -- RULE 2 (#838 I2, DESIGN.md §2.4): every free var of this predicate is QUANTIFIED by
  -- some enclosing scheme (`deferrableVarIds`, populated from `schemeIds` at each
  -- generalized group close) ⇒ it is `deferredToCaller` — the constraint is forwarded
  -- and re-checked at each concrete use, so DEFER here.  It is what checkOneImplObligation
  -- does unconditionally on a non-ground arg, now shared by the call channel.  Without it
  -- a where-helper's re-instantiated `Ord a` (once #827's registration gate is flipped)
  -- would trip the rule-3 ambiguity reject instead of deferring into the enclosing scheme
  -- (`guard_gap_where.mdk`, #827).  Keyed on QUANTIFIED (post-generalization) ids, NOT
  -- pre-gen member monos: a value-restricted intermediate never quantifies its var, so a
  -- genuinely-ambiguous escaped var (`let x = mk n` under `mk : Int -> a`, ≥2 impls) is
  -- NOT in the set and RULE 3 rejects it — the S0 the #855 review caught.
  | isNonEmptyL (monoUnboundIds occ) && allList (i => containsI i perRun.value.deferrableVarIds.value) (monoUnboundIds occ) = ()
  -- RULE 3: the var escaped its group anchored to NOTHING and the iface has >= 2 impls
  -- ⇒ genuinely ambiguous (the escaped-unanchored case registerDispatchMonos records).
  | implCountForIfaceU univ iface >= 2 =
    pushTypeErrorOnceAt "T-AMBIGUOUS-INSTANCE" loc (ambiguousImplMsg iface.irName)
  | otherwise = ()

-- PLAN.md #11: after HM + defaulting every source integer literal's type var is
-- ground (or a genuine `Num a` survivor).  Decide each literal's runtime rep
-- (3-way, mirror of lib/typecheck.ml's set_numlit_floats):
--   • ground Float ⇒ stamp the float cell + CLEAR the fromInt route (dref RNone) ⇒
--     dictPass emits `ELit (LFloat f)` (eval is value-tagged; eval_arith rejects
--     mixed int/float tags, so a Float literal must carry a real float).
--   • ground Int (incl. via ambiguous→Int defaulting) ⇒ clear both cells ⇒
--     `ELit (LInt n)`, no dict dispatch.
--   • NOT a primitive head (a still-polymorphic `Num a` — the soundness case, `1`
--     in `inc x = x + 1` — or an exotic user numeric type) ⇒ leave [dref]'s
--     resolveSites-stamped route in place ⇒ dictPass emits
--     `EApp (EMethodAt "fromInt" …) (ELit (LInt n))` so the literal dispatches
--     through the runtime Num dict (Int→identity, Float→intToFloat).  A dref left
--     RNone (route never filled, e.g. unreachable position) falls to Int below.
-- Reads numlitRefs (populated by inferNumLit during THIS run/module's inference).
setNumlitFloats : Unit -> Unit
setNumlitFloats _ = setNumlitFloatsGo perRun.value.numlitRefs.value

setNumlitFloatsGo : List (Mono, Ref (Option Float), Int, Ref Route) -> Unit
setNumlitFloatsGo [] = ()
setNumlitFloatsGo ((var, fref, n, dref)::rest) =
  let _ = match normalize var
    TCon "Float" _ =>
      fref := Some (intToFloat n)
      dref := RNone
    TCon "Int" _ => dref := RNone
    _ => ()
  setNumlitFloatsGo rest

-- ── Multi-param-interface element grounding (Shape A / gap #44) ─────────────
-- A container LITERAL (`Set { 3,1,2 }` / `Map { 1 => "a" }`) desugars to a
-- return-position `fromEntries [..] :~ Set _a`.  The head-pin fixes the RESULT to
-- `Set _a`, and the list arg grounds the interface's ELEMENT param `e` (= Int),
-- but nothing ties the result's element var `_a` to `e` — HM does not propagate the
-- impl's `FromEntries (Set a) a` variable-sharing.  So `_a` stays free, and BOTH the
-- return-position `requires Ord a` route AND the enclosing `display`/`debug`'s
-- arg-position element dict drop their dictionaries (null dict → SIGSEGV on the build
-- path; eval recovers via runtime arg-tag fallback, which is why `medaka run` worked).
-- Fix: for each multi-param-interface method occurrence whose dispatch type heads a
-- UNIQUE impl, instantiate that impl's method type (interface typarams ↦ the impl's
-- own type args, freshened) and unify it with the occurrence mono.  This grounds `_a`
-- := Int THROUGH THE SHARED CELL, so every downstream site reading that cell (the
-- `display` arg-stamp) and the return-position route both see `Set Int`.  Runs after
-- inference, before the resolve* passes read the cells.  Single-param interfaces and
-- already-ground occurrences are no-ops.  Mirrors the intent of the oracle's
-- impl_head_subst keying off the FULL concrete_args (the interface's param_vars).
groundMultiParamObligations : List Decl -> List UObligation -> Unit
groundMultiParamObligations _ [] = ()
groundMultiParamObligations prog (o::rest) =
  let _ = match o.oblProj
    OpMethodOcc typarams mty occ =>
      groundOneObligation prog o.pred.iface.irName typarams mty occ
    OpProjected => ()
  groundMultiParamObligations prog rest

groundOneObligation : List Decl -> String -> List String -> Ty -> Mono -> Unit
groundOneObligation prog iface typarams mty occ
  | listLen typarams <= 1 = ()
  | otherwise = match dispatchMonosOf typarams mty occ
    [] => ()
    dispMono::_ => match headTyconNameMono dispMono
      None => ()
      Some tag => match uniqueImplTysFor prog iface tag
        None => ()
        Some implTys =>
          let baseMap = zipL typarams implTys
          let implMethodTy = substTyVars baseMap mty
          let inst = fst (astTypeFreshTbl implMethodTy)
          unify occ inst
-- build impl method type: interface typaram ↦ impl ty, then freshen the
-- impl's own vars, then unify with the occurrence.

-- the type args of the UNIQUE impl of [iface] whose head tycon is [tag]; None when
-- absent or ambiguous (more than one), so an over-determined case is left untouched.
uniqueImplTysFor : List Decl -> String -> String -> Option (List Ty)
uniqueImplTysFor prog iface tag = match filterImplTysFor prog iface tag
  [tys] => Some tys
  _ => None

filterImplTysFor : List Decl -> String -> String -> List (List Ty)
filterImplTysFor prog iface tag = flatMap (implTysIfMatch iface tag) prog

implTysIfMatch : String -> String -> Decl -> List (List Ty)
implTysIfMatch iface tag (DAttrib _ d) = implTysIfMatch iface tag d
-- ⚠️ `censusHeadNameTy`, NOT `headTyconNameTy`: `uniqueImplTysFor` gives up on
-- more than one match, so an extra `Some` here is an ACCEPTANCE narrowing (a
-- multi-param obligation stops being ground, and the cascade is a downstream
-- `T-AMBIGUOUS-INSTANCE`).  The derivation is at `headTyNode`.
implTysIfMatch iface tag (DImpl { iface = ifn, tys, ... })
  | ifn == iface = match tys
    headTy::_ => match censusHeadNameTy headTy
      Some t => if t == tag then [tys] else []
      None => []
    [] => []
  | otherwise = []
implTysIfMatch _ _ _ = []

-- substitute interface-typaram NAMES → impl type PATTERNS inside a declared Ty.
--
-- #1110 (was a residual, DRAINED by the stamping PR).  The `TyCon` arm used to
-- REBUILD the node from its name alone, which dropped the span (pre-existing and
-- deliberate — see below) and would have DESTROYED the `tyConOrigin` identity
-- resolve had already acquired, silently and with no diagnostic, on every declared
-- `Ty` reached through an impl-head substitution.  It now PRESERVES the matched
-- node and clears only the span, which is the fix the carrier PR called for:
-- re-stamping here was never an option, because this function does not know an
-- identity and would have been guessing one.
--
-- ⚠️ The span clear is deliberate and must STAY: a substituted head is no longer
-- at the source position the interface's declared type named it at, and the
-- located-diagnostic paths downstream would otherwise squiggle the interface
-- declaration for an error in the impl.  Preserving `tyConLoc` here is NOT a
-- byte-identical change; preserving `tyConOrigin` is.
substTyVars : List (String, Ty) -> Ty -> Ty
substTyVars sub (TyVar n) = fromOption (TyVar n) (lookupAssoc n sub)
substTyVars _ (t@(TyCon {  })) = TyCon { t | tyConLoc = None }
substTyVars sub (TyApp a b) = TyApp (substTyVars sub a) (substTyVars sub b)
substTyVars sub (TyFun a b) = TyFun (substTyVars sub a) (substTyVars sub b)
substTyVars sub (TyTuple ts) = TyTuple (map (substTyVars sub) ts)
substTyVars sub (TyEffect es eff t) = TyEffect es eff (substTyVars sub t)
substTyVars sub (TyConstrained cs t) = TyConstrained cs (substTyVars sub t)
-- No wrapped type to recurse into, and (like `TyEffect`'s `eff` above,
-- untouched by this substitution) a row's tail var is never one of `sub`'s
-- ordinary type-var names — a bare row atom substitutes to itself.
substTyVars _ (TyRow es eff l) = TyRow es eff l

-- A function-typed dispatch mono is fully GROUND — its head is `->`, structurally
-- un-implementable for an ordinary interface (no `impl Display (a -> b)` exists).
-- So a function-typed obligation with no matching impl is a genuine `No impl of
-- <iface> for <a -> b>` (bug: `main = f` where `f : Int -> Int` used to fall
-- through to the emit path's route resolution and mis-report "Ambiguous instance"
-- — but a monomorphic function type is not ambiguous, it simply has no impl).
-- Reserved for the un-matched case so a real `impl Display (a -> b)` would satisfy.
monoIsFunction : Mono -> Bool
monoIsFunction m = match normalize m
  TFun _ _ _ => True
  _ => False

-- After the impl head for (iface, args) matched, a CONDITIONAL instance's
-- `requires` constraints must ALSO be satisfied (`impl Display (a, b) requires
-- Display a, Display b`).  Recover the impl's typaram bindings from the head match
-- and check each substituted requirement recursively — so `main = (Red, 5)` (Red
-- has no Display) surfaces `No impl of Display for Color` at the deepest failing
-- leaf, exactly like the bare `main = Red`, instead of the head-only match silently
-- accepting the unsatisfiable element constraint (→ null element dict → SIGSEGV).
-- A satisfied requirement (`Display Int`, `Display String`) recurses into ITS own
-- (empty) requires and accepts, so `(5, "hi")` / `[1,2,3]` still build.
checkNestedReqs : ImplUniverse -> IfaceRef -> List Mono -> Option Loc -> Unit
checkNestedReqs univ iface args loc =
  -- #1155: `reqObligationsFor` asks the min⊑ selector WHICH impl matched, so this is
  -- the one goal-posing site that reaches `pickMostSpecificEntry` from OUTSIDE the
  -- five resolver drains — publish the obligation's own snapshotted span so the
  -- ambiguity reject lands on the use site rather than on `currentLoc`'s stale one.
  -- Restored to None after, per `goalSiteLoc`'s scoping rule.
  goalSiteLoc := loc
  let _ = checkReqObligations univ loc (reqObligationsFor univ iface args)
  goalSiteLoc := None

-- Impl decls paired with their `requires` (implHeadsOf drops reqs; this keeps them).
implDeclsWithReqs : List Decl -> List (IfaceRef, List Ty, List Require)
implDeclsWithReqs prog = flatMap implDeclWithReqs prog

implDeclWithReqs : Decl -> List (IfaceRef, List Ty, List Require)
implDeclWithReqs (DAttrib _ d) = implDeclWithReqs d
implDeclWithReqs (DImpl { iface, tys, reqs, implOrigin, ... }) =
  [(IfaceRef { irName = iface, irOrigin = implOrigin }, tys, reqs)]
implDeclWithReqs _ = []

-- The substituted requirement obligations of the impl of [iface] whose head
-- matches [args]: bind the impl's typaram vars from the head match, then apply that
-- binding to each `Require`'s type args.  No matching impl / no reqs → [].
-- #154 PR3: the FIRST-match impl lookup is now the keyed `findMatchingImplReqsU`
-- (bucket by iface|tag, headless fallback) instead of a flat scan over every impl.
-- ⚠️ THE `None` ARM IS NOT "NOTHING TO CHECK" — it is Door 4's `None` arm, one
-- consumer over.  See `unroutedGroundReqs` directly below for why it rejects.
reqObligationsFor : ImplUniverse -> IfaceRef -> List Mono -> List (IfaceRef, List Mono)
reqObligationsFor univ iface args = match findMatchingImplReqsU univ iface args
  None => unroutedGroundReqs univ iface args
  Some (subst, reqs) => map (reqToObligation subst) reqs

-- ── SA-1 / "Door 4b": the GROUND goal's un-plumbed case is a LOUD reject too ──
-- Door 4 (`unroutedResidual`, on `residualPredsOf`'s `None` arm) made the
-- two-registry disagreement loud for a DEFERRED goal.  It has exactly one call site,
-- and a goal that never becomes a residual predicate never reaches it: a GROUND goal
-- (`Tag (Wrap Int)` — from a type signature, or from literal defaulting on a nullary
-- binding) is discharged here instead, by the end-of-body obligation checker
-- (`checkOneCallObligation` -> `checkNestedReqs` -> this function), which has the SAME
-- split.  `implMatchesArgsU` accepts over the graph-global `IE` while
-- `findMatchingImplReqsU`'s evidence legs could not recover the requires.  ⚠️ ARCH
-- B-2.1-b2/-d: this sentence used to name the CONCRETE leg
-- (`concreteReqMatchByIface`) reading `shadowKeyTableRef`, the CUMULATIVE
-- `universeKeyBucketsRef` prefix.  That leg is graph-global now and both refs are
-- deleted; the surviving prefix read is the HEADLESS fallback `firstReqMatch
-- (univHeadless univ iface)` over `residualUnivRef` — see Door 4's block for the full
-- narrowing.  The split is narrower, not closed — so the impl's
-- `requires` are never recovered, no dict is built, and the emitted call is one
-- argument short of the impl it dispatches to.
-- MEASURED at `0b953165` on #1564's own four files with `export nest : Int -> String`
-- added to `nest.mdk` and NOTHING else changed: `check` exit 0 (`main : Unit`),
-- `run` exit 1 `E-PANIC: putStrLn: not a String`, `build` exit 0, and the built binary
-- exit **139** (segmentation fault); the control (the two import lines swapped) is
-- clean on all four arms and prints `wrap(int)`.  Same defect, same mechanism, one
-- signature away from the reproduction Door 4 was verified against.
-- 🚨 REJECT, DO NOT ROUTE.  Handing this arm the `requires` from `univ` would be
-- "move only the checker's leg" — `TYPECHECK-TARGET-ARCHITECTURE.md:1814-1815` defers
-- both the re-key and the reader move to B-2 BY NAME, and the tree has already MEASURED
-- that desynchronizing the checker from the router yields an `argReqRoute` of `RNone`
-- and a binary that still faults (`residualPredsOf`'s header, #1560).  So this reads
-- `univ` for a yes/no REJECT PREDICATE only: no obligation is discharged from it, no
-- scheme and no route changes, and both arms still return `[]`.
-- ⚠️ WHY THE TEST IS THIS ONE.  It shipped NARROWER than Door 4's, which fired on
-- `implMatchesU` alone and so did not ask whether the matched impl HAS a `requires`.
-- 🪦 THAT ASYMMETRY IS GONE: SA-4 (owner ruling RUN-055) moved `unroutedResidual` onto
-- this same predicate, so both guards now read `implMatchesWithReqsU`.  This site could
-- never have afforded the bare twin: EVERY ground obligation in every
-- program reaches here, including a no-`requires` impl whose evidence is a bare route
-- word and needs no dict at all (MEASURED by R5: `define i64 @mdk_nest__nest(i64
-- %arg0)`, arity 1, no dict) — rejecting those would be a false reject on programs that
-- run correctly.  So the predicate is "some impl that MATCHES these args carries a
-- non-empty `requires`", i.e. exactly "a dictionary would have to be passed here".
-- The disjunctive form (ANY matching impl, not the selected one) is the LOUD fail
-- direction: the selector that would name the winner is the registry that just failed.
-- 🚨 THE MESSAGE IS `requiresUnroutedMsg` — DOOR 4'S OWN, VERBATIM, AND THAT SHARING IS
-- LOAD-BEARING, NOT LAZINESS.  A DEFERRED goal reaches BOTH guards (this checker runs on
-- `Tag (Wrap a)` too — `allConcreteHeads` is about head TYCONS, so a partially-free
-- vector still gets here), so a second, differently-worded message would DOUBLE-REPORT
-- the same defect at the same span.  MEASURED: with a bespoke ground-shaped message,
-- `check --json` on #1564's own `main.mdk` emitted TWO `T-REQUIRES-UNROUTED`
-- diagnostics at range 2:16-2:21 and the must-fail pin flipped to DRAINED on a live
-- bug.  `pushTypeErrorOnceAt` dedups on the MESSAGE, so identical text collapses the
-- pair to one report by construction.  ⚠️ Consequence for SA-5 / item 4: the wording
-- now serves two sites, and its *"the module where this binding is generalized"* clause
-- is inaccurate on THIS one (nothing is generalized at a ground use site).  Reword it
-- for both, and do not fix that by re-splitting the text.
unroutedGroundReqs : ImplUniverse -> IfaceRef -> List Mono -> List (IfaceRef, List Mono)
unroutedGroundReqs univ iface args
  | implMatchesWithReqsU univ iface args =
    let _ = pushTypeErrorOnceAt "T-REQUIRES-UNROUTED" !goalSiteLoc (requiresUnroutedMsg iface args)
    []
  | otherwise = []

-- does SOME impl of [iface] matching [args] carry a non-empty `requires`?  The
-- reqs-aware twin of `implMatchesU`: same buckets, same concrete-then-headless order,
-- same `implHeadMatchesArgs` success condition, so True-here-with-`findMatchingImplReqsU`-None
-- isolates precisely the two-registry disagreement on a goal that needs a dict.
-- ⚠️ TWO CALLERS, and they must stay the same predicate: `unroutedGroundReqs` (the ground
-- obligation site, SA-1) and `unroutedResidual` (Door 4's residual site, moved here by
-- SA-4 / RUN-055).  They share `requiresUnroutedMsg` verbatim because
-- `pushTypeErrorOnceAt` dedups on message text and a deferred goal reaches BOTH; if the
-- two guards ever disagree about what counts as a match, one of them starts reporting a
-- defect the other has already ruled out.
implMatchesWithReqsU : ImplUniverse -> IfaceRef -> List Mono -> Bool
implMatchesWithReqsU _ _ [] = False
implMatchesWithReqsU univ iface (a0::rest) = bucketArgsMatchReqs (univConcreteBucket univ iface (headTyconMono a0)) (a0::rest)
  || bucketArgsMatchReqs (univHeadless univ iface) (a0::rest)

bucketArgsMatchReqs : List (List Ty, List Require) -> List Mono -> Bool
bucketArgsMatchReqs [] _ = False
bucketArgsMatchReqs ((tys, reqs)::rest) args = isNonEmptyL reqs && implHeadMatchesArgs tys args
  || bucketArgsMatchReqs rest args

reqToObligation : List (String, Mono) -> Require -> (IfaceRef, List Mono)
reqToObligation subst (Require { requireHead = ifaceR, requireArgs = tysR, requireOrigin = o }) = (IfaceRef { irName = ifaceR, irOrigin = o }, map (reqTyToMono subst) tysR)

-- Convert a `Require`'s declared type arg to a mono under the head-match subst.
-- Impl-typaram vars (the common case, `Display a`) resolve to their bound mono; an
-- unbound name gets a fresh var (defers, never a spurious concrete head).
reqTyToMono : List (String, Mono) -> Ty -> Mono
reqTyToMono sub (TyVar n) = fromOption (freshVar ()) (lookupAssoc n sub)
reqTyToMono _ (TyCon { tyConName = n, tyConOrigin = o }) = tconFrom o n
reqTyToMono sub (TyApp a b) = TApp (reqTyToMono sub a) (reqTyToMono sub b)
reqTyToMono sub (TyFun a b) =
  TFun (reqTyToMono sub a) (openRow ()) (reqTyToMono sub b)
reqTyToMono sub (TyTuple ts) =
  tupleSpineOf (tconTupleHead (listLen ts)) (map (reqTyToMono sub) ts)
reqTyToMono sub (TyEffect _ _ t) = reqTyToMono sub t
reqTyToMono sub (TyConstrained _ t) = reqTyToMono sub t
-- Same diagnostic + recovery as `fromAstTypeE`'s `TyRow` arm: `reqTyToMono`
-- has no kind-directed KRow branch at all (its `TyApp` arm is unconditional),
-- so a row written in a `requires` clause's type argument was ALREADY a
-- silent `Unit` mistype before #997 for the degenerate spelling — push the
-- same diagnostic rather than let #997's new syntax spelling reach it in
-- silence too.
reqTyToMono _ (TyRow labels tail loc) =
  let _ = pushTypeErrorOnceAt "T-ROW-KIND-MISMATCH" loc (rowKindMismatchMsg labels tail)
  tconBuiltin "Unit"

-- Check each substituted requirement with the SAME accept/reject logic as a
-- top-level obligation, recursing into a satisfied conditional impl's own reqs.
checkReqObligations : ImplUniverse -> Option Loc -> List (IfaceRef, List Mono) -> Unit
checkReqObligations _ _ [] = ()
checkReqObligations univ loc ((ifaceR, monoArgs)::rest) =
  let _ = checkReqOne univ ifaceR monoArgs loc
  checkReqObligations univ loc rest

-- A function-typed requirement arg is fully GROUND yet structurally un-Ord/Eq/etc
-- (no `impl Ord (a -> b)` exists), so it must REJECT — but its head has no tycon,
-- so `allConcreteHeads` reads it as non-concrete.  Order the function-typed reject
-- BEFORE the concreteness defer (mirroring checkOneCallObligation): otherwise a
-- `requires Ord k` with k = (Int -> Int) — e.g. `Map { f => 1 }` selecting
-- `FromEntries (Map k v) (k, v) requires Ord k` — would DEFER into a silent accept,
-- and `check` would pass a program `run` rejects at runtime (P0-18).
checkReqOne : ImplUniverse -> IfaceRef -> List Mono -> Option Loc -> Unit
checkReqOne univ iface args loc
  | anyListM monoIsFunction args && not (implMatchesU univ iface args) =
    pushNoImplError iface.irName loc args
  | not (allConcreteHeads args) = ()
  | implMatchesU univ iface args = checkNestedReqs univ iface args loc
  -- #1939 / #1938 (OPEN WORLD): the nested-`requires` twin of
  -- `checkOneCallObligation`'s open-world defer, and it moves WITH it by the same
  -- argument this header already makes about the function-typed reject — the two
  -- checkers share their accept/reject logic, so a rule landing in one and not the
  -- other refutes or defers the same goal according to whether it arrived as a
  -- top-level obligation or as a conditional impl's `requires`.  `residualPredsOf`
  -- reduces through `requires` too, so a deferred sub-goal reaches the enclosing scheme
  -- by the route the top-level one takes and is adjudicated where it grounds.
  | goalDefersOpenWorld iface args = ()
  | otherwise = pushNoImplError iface.irName loc args

-- #838 I4: the function-typed Ord/Eq unimplementable-head rejects were only used by the
-- retired checkOneImplObligation.  Both fired only on TFun, which checkOneCallObligation's
-- generic `anyListM monoIsFunction args && not implMatchesArgsU` rule already subsumes, so
-- they are removed rather than left dead.

-- a mono no `Num` impl can ever match: a function type, or an application whose
-- spine head is still an unbound tyvar (a literal forced into `m a` monad position)
numUnimplementableHead : Mono -> Bool
numUnimplementableHead m = match normalize m
  TFun _ _ _ => True
  TApp a b => unboundSpineHead (spineHeadMono (TApp a b))
  _ => False

-- True iff [m] normalizes to an unbound tyvar (the spine head of `m a`)
unboundSpineHead : Mono -> Bool
unboundSpineHead m = match normalize m
  TVar _ => True
  _ => False

spineHeadMono : Mono -> Mono
spineHeadMono t = match normalize t
  TApp f _ => spineHeadMono f
  other => other

-- #1952: a MULTI-ARGUMENT goal names its arguments at ARGUMENT precedence, so
-- `Conv (Wrap a) Int` no longer prints as `Conv for Wrap a Int` — which reads as a
-- three-argument predicate and cannot be matched against the impl heads printed beside
-- it.  ⚠️ The length gate is the whole disambiguation and is not a hedge: with exactly
-- ONE argument the entire remainder of the message IS that argument, so there is nothing
-- to mis-group, and `ppMonosShared` is kept there so every existing single-argument
-- reject (`No impl of Eq for List Int`) renders byte-identically.  This message is prose,
-- not source — `renderConstraintCtx` is the surface that owes parens unconditionally.
noImplFoundMsg : String -> List Mono -> String
noImplFoundMsg iface [arg] = "No impl of \{iface} for \{ppMonosShared [arg]}"
noImplFoundMsg iface args = "No impl of \{iface} for \{ppPredArgsShared args}"

-- Actionable-fix hint (F dimension) for a `No impl of <iface> for <ty>` reject:
-- only when [args] is a single user-declared data type (a `dataParamKindsRef`
-- hit) does "add deriving" / "write an impl" read as concrete, applicable
-- advice — a builtin (String/Int/Bool/…) can't take `deriving`, and a function
-- type is structurally un-implementable, so both stay hint-free (unchanged
-- message) rather than print misleading advice.
-- ⚠️ #1111 A-2.3: the ONE `dataParamKindsRef` consumer that stays a BARE-NAME
-- question, and it is a membership test rather than a lookup.  A-2.2 has since
-- landed, so the identity IS reachable here (`headTyconMono` now answers a
-- `HeadKey`); this site deliberately calls the bare-name residual
-- `headTyconNameMono` instead, and is therefore one of the residual rows the
-- Stage A-2 ledger counts.
-- That costs nothing real: the question this asks is "is a type by this name
-- user-declared anywhere?", used ONLY to decide whether `add 'deriving X'` is
-- applicable advice rather than a dead end for a builtin.  `tabHasName`
-- returns no value, so it cannot select the wrong module's row; the worst a
-- collision can do is offer applicable advice for the right reason under the
-- wrong module's declaration.
noImplHint : String -> List Mono -> Option String
noImplHint iface [arg] = match headTyconNameMono arg
  Some n => noImplHintFor iface n
  None => None
noImplHint _ _ = None

noImplHintFor : String -> String -> Option String
noImplHintFor iface n
  | tabHasName n perRun.value.dataParamKindsRef.value =
    Some (noImplAdvice iface n)
  | otherwise = None

-- Roadmap #18a: only a DERIVABLE interface may be suggested via `deriving`.  A
-- `deriving <iface>` for anything outside that set is silently DROPPED by desugar's
-- `deriveImpls` (its `deriveForData`/`deriveForNewtype` return None), so the old
-- unconditional "add 'deriving X'" sent the user down a dead end for every other
-- interface — including the `Semigroup` reject `a ++ b` now raises, and the
-- pre-existing user-interface case (`No impl of Printable for Foo`).  For those the
-- only real fix is to write the impl, so that is all we advise.
noImplAdvice : String -> String -> String
noImplAdvice iface n
  | derivableIface iface = "add 'deriving \{iface}' to the '\{n}' type, or write an 'impl \{iface} \{n}'."
  | otherwise = "write an 'impl \{iface} \{n}'."

-- The interfaces desugar.mdk can actually synthesize an impl for (deriveForData /
-- deriveForNewtype).  `Generic` is data-only; the other four cover both.
derivableIface : String -> Bool
derivableIface iface =
  contains iface ["Eq", "Ord", "Debug", "Display", "Generic"]

-- Append the hint (when applicable) to the plain `noImplFoundMsg`, mirroring
-- the did-you-mean append convention (base message ++ " — " ++ hint).
noImplFoundMsgHinted : String -> List Mono -> (String, Option String)
noImplFoundMsgHinted iface args =
  let base = noImplFoundMsg iface args
  match noImplHint iface args
    Some hint => ("\{base}; \{hint}", Some hint)
    None => (base, None)

-- Push a `No impl of …` type error, appending + recording the actionable-fix
-- hint (via `pushTypeErrorHelpFixAt`) when one applies; otherwise behaves
-- exactly like the previous plain `pushTypeErrorOnceAt "T-NO-IMPL" …` call.
pushNoImplError : String -> Option Loc -> List Mono -> Unit
pushNoImplError iface loc args = match firstTupleCallHint args
  -- P0-16: the un-implementable type IS a tuple-call residual (e.g. `println
  -- (add(1, 2))` → `No impl of Display for ((Int, Int) -> (Int, Int))`) — append
  -- the "call with spaces, not parentheses" hint + machine fix.
  Some (help, fix) =>
    pushTypeErrorHelpFixAt "T-NO-IMPL" loc "\{noImplFoundMsg iface args} — \{help}" help fix
  None =>
    let (msg, mhint) = noImplFoundMsgHinted iface args
    match mhint
      Some hint => pushTypeErrorHelpFixAt "T-NO-IMPL" loc msg hint None
      None => pushTypeErrorOnceAt "T-NO-IMPL" loc msg

-- Chunk D (Num mis-framing reframe): at the final no-impl branch, a `Num`
-- obligation forced to a fully-ground concrete non-Num head (`args` already passed
-- allConcreteHeads + failed implMatches) is reframed to a structural type mismatch
-- WHEN it traces to a bare numeric LITERAL (`numlitReframeLoc`: recorded at this
-- loc, and NOT an arithmetic operand).  An operator-sourced `Num` failure
-- (`x + 1`, `1 + x`) keeps `No impl of Num for T` — the `+` is the real culprit.
reportNumOrNoImpl : String -> List Mono -> Option Loc -> Unit
reportNumOrNoImpl iface args loc
  | iface == "Num" && numlitReframeLoc loc =
    let hint = numlitMismatchHint loc args
    pushTypeErrorHelpFixAt
      "T-TYPE-MISMATCH"
      loc
      (numlitMismatchMsg loc args ++ hint)
      hint
      None
  | otherwise = pushNoImplError iface loc args

-- True iff [loc] is a literal-sourced Num obligation eligible for reframe: some
-- literal was recorded at [loc] and that loc was NOT operator-tainted.
numlitReframeLoc : Option Loc -> Bool
numlitReframeLoc (Some l) = anyList (p => locEq (snd p) l) perRun.value.numlitVarLocs.value
  && not (anyList (ol => locEq ol l) perRun.value.numlitOpLocs.value)
numlitReframeLoc None = False

-- site-specific reframe wording (if / list / cons) when the context is known, else
-- a bare literal-vs-type mismatch.  `Int` is the numeric default the literal takes.
numlitMismatchMsg : Option Loc -> List Mono -> String
numlitMismatchMsg loc args = match numlitCtxKind loc
  Some "if" =>
    "'if' branches have different types: Int vs \{ppMonosShared args}"
  Some "list" =>
    "List elements have different types: Int vs \{ppMonosShared args}"
  Some "cons" => "Cons (::) type mismatch: head is Int but the list holds \{ppMonosShared args}"
  _ => "Type mismatch: Int literal vs \{ppMonosShared args}"

-- F-dimension actionable-fix hint appended to `numlitMismatchMsg` (2026-07-04):
-- mirrors its per-context wording, reusing the SAME two type strings the
-- message already interpolates (never recomputed).  No hint for the
-- context-less fallback (`_`) — there's no branch/element/head to name.
numlitMismatchHint : Option Loc -> List Mono -> String
numlitMismatchHint loc args = match numlitCtxKind loc
  Some "if" => ". Both branches must have the same type; change the else branch to Int, or the then branch to \{ppMonosShared args}."
  Some "list" => ". All elements must have the same type; convert the \{ppMonosShared args} element, or make the list hold \{ppMonosShared args}."
  Some "cons" => ". The head's type must match the list's elements; change the head to \{ppMonosShared args}, or use a list of Int."
  _ => ""

numlitCtxKind : Option Loc -> Option String
numlitCtxKind (Some l) = lookupCtxKind l perRun.value.numlitCtxTags.value
numlitCtxKind None = None

lookupCtxKind : Loc -> List (Loc, String) -> Option String
lookupCtxKind _ [] = None
lookupCtxKind l ((l2, k)::rest) =
  if locEq l l2 then
    Some k
  else
    lookupCtxKind l rest

locEq : Loc -> Loc -> Bool
locEq (Loc f1 a1 b1 c1 d1) (Loc f2 a2 b2 c2 d2) = f1 == f2
  && a1 == a2
  && b1 == b2
  && c1 == c2
  && d1 == d2

-- the dispatch (interface-param) monos at one occurrence: parallel-walk the
-- declared method type against the normalized occurrence mono; wherever the
-- declared type is a bare interface-param tyvar, read the corresponding sub-mono.
-- Returns one entry per interface param, in typaram order (deduplicated by name).
-- An empty result means the walk found no iface-param position (shadowed method /
-- shape mismatch) — the caller then skips, so a shadow never produces a false
-- reject.
dispatchMonosOf : List String -> Ty -> Mono -> List Mono
dispatchMonosOf typarams mty occ =
  let pairs = walkDispatch typarams (stripTyConstraints mty) occ
  collectByParam typarams pairs

-- strip leading `=>` constraints / effect rows so the walk aligns the method's
-- value type with the occurrence mono.
stripTyConstraints : Ty -> Ty
stripTyConstraints (TyConstrained _ t) = stripTyConstraints t
stripTyConstraints (TyEffect _ _ t) = stripTyConstraints t
stripTyConstraints t = t

-- parallel structural walk collecting (paramName, mono) wherever the declared
-- type is a bare iface-param tyvar.  Other positions recurse; a shape mismatch
-- (declared has structure the occurrence lacks) simply stops that branch.
walkDispatch : List String -> Ty -> Mono -> List (String, Mono)
walkDispatch typarams (TyVar n) m
  | contains n typarams = [(n, normalize m)]
  | otherwise = []
walkDispatch typarams (TyFun a b) m = match normalize m
  TFun ma _ mb => walkDispatch typarams (stripTyConstraints a) ma
    ++ walkDispatch typarams (stripTyConstraints b) mb
  _ => []
walkDispatch typarams (TyApp a b) m = match normalize m
  TApp ma mb => walkDispatch typarams a ma ++ walkDispatch typarams b mb
  _ => []
walkDispatch typarams (TyTuple ts) m = match tupleSpine m
  Some ms => flatMap (p => walkDispatch typarams (fst p) (snd p)) (zipL ts ms)
  _ => []
walkDispatch _ _ _ = []

-- one mono per interface param, in declaration order; if ANY param has no
-- recovered binding the whole obligation is abandoned (return [] → caller skips).
collectByParam : List String -> List (String, Mono) -> List Mono
collectByParam typarams pairs = match collectByParamGo typarams pairs
  None => []
  Some ms => ms

collectByParamGo : List String -> List (String, Mono) -> Option (List Mono)
collectByParamGo [] _ = Some []
collectByParamGo (p::rest) pairs = match lookupAssoc p pairs
  None => None
  Some m => map (m :: _) (collectByParamGo rest pairs)

-- every dispatch mono has a resolved concrete head tycon (no remaining bare
-- TVar at the head) — the oracle's is_concrete gate, restricted to the head (a
-- concrete head with free args, e.g. `Maybe a`, still uniquely picks the impl).
--
-- 🚨 THIS IS THE DISPATCH-HEAD PROJECTION, NOT A DECIDABILITY TEST, AND THE TWO COME
-- APART ON EXACTLY ONE POPULATION.  `headTyconNameMono` enumerates `TCon`/`TRigid`, so
-- its `None` conflates two different facts: "not ground yet" (a `TVar` head — may still
-- bind) and "ground but HEADLESS" (a `TFun` — fully concrete, and no instance can ever
-- match an arrow).  A caller asking "can entailment decide this now?" therefore CANNOT
-- use this predicate alone; a caller asking "does this pick an impl?" can.
--
-- ⚠️ DO NOT "FIX" THE CONFLATION BY WIDENING THIS FUNCTION to treat `TFun` as concrete.
-- The tree's settled convention is the opposite, and it predates #1114: every site that
-- needs a VERDICT orders a function-typed arm BEFORE its concreteness test.  Three sites
-- do this today —
--   * `checkOneCallObligation`   (`anyListM monoIsFunction args && not implMatchesArgsU`)
--   * `checkReqOne`              (same arm; its comment states the rule outright — "fully
--                                 GROUND yet structurally un-Ord/Eq/etc … but its head has
--                                 no tycon, so `allConcreteHeads` reads it as non-concrete.
--                                 Order the function-typed reject BEFORE the concreteness
--                                 defer")
--   * `uOblIsDecidableNow`       (#1114, the parametric-impl-body window's filter)
-- — and each pairs the arm with a `not (implMatches…)` guard, so a function type that DOES
-- have a matching impl is not rejected.  Widening this predicate would make those guards
-- unreachable and would reroute a *matching* function-typed obligation from "defer" into
-- `checkNestedReqs`, changing behaviour on a path none of the above is about.
-- The conflation is real; the fix for it is a separate, better-named projection, not a
-- redefinition of this one.
allConcreteHeads : List Mono -> Bool
allConcreteHeads [] = True
allConcreteHeads (m::rest) = isSome (headTyconNameMono m)
  && allConcreteHeads rest

-- #154 PR3: implMatches / implMatchesReceiver (flat whole-universe scans) are replaced
-- by the keyed implMatchesU / implMatchesReceiverU above.  implHeadMatchesArgs (used by
-- both the keyed matcher and matchTyMono callers) stays: a head-arg type pattern is
-- matched against the corresponding mono via matchTyMono (a TyVar in the head is a
-- wildcard; a parametric impl `impl Eq (List a)` thus matches `List Int`).
implHeadMatchesArgs : List Ty -> List Mono -> Bool
implHeadMatchesArgs tys args
  | listLen tys == listLen args = allHeadArgsMatch (zipL tys args)
  | otherwise = False

allHeadArgsMatch : List (Ty, Mono) -> Bool
allHeadArgsMatch [] = True
allHeadArgsMatch ((ty, m)::rest) = match matchTyMono ty m
  Some _ => allHeadArgsMatch rest
  None => False

-- render the dispatch monos space-separated under ONE shared naming context
-- (mirrors lib/typecheck.ml's pp_monos), so distinct free vars don't all collapse
-- to "a".  Concrete heads (the only case that reaches an error) render as the
-- type name.
ppMonosShared : List Mono -> String
ppMonosShared ms =
  let ctx = Ref []
  let cnt = Ref 0
  joinWith " " (ppEachShared ctx cnt ms)

ppEachShared : Ref (List (Int, String)) -> Ref Int -> List Mono -> List String
ppEachShared _ _ [] = []
ppEachShared ctx cnt (m::rest) = ppGo ctx cnt 2 m :: ppEachShared ctx cnt rest

-- register, per slot, the default body's constraint var id → `$dict_<method>_<slot>`
-- in activeDictVars, so an in-body method ref unified to that var routes RDict.
-- Run AFTER body inference so the id is the SURVIVING (normalized) union-find root —
-- the same id the in-body site normalizes to (mirrors registerImplRequires).
registerMethodDictSlots : String -> Int -> List Int -> List (Int, Mono) -> Unit
registerMethodDictSlots _ _ [] _ = ()
registerMethodDictSlots mname slot (id::rest) subst =
  let _ = registerOneMethodDict mname slot id subst
  registerMethodDictSlots mname (slot + 1) rest subst

registerOneMethodDict : String -> Int -> Int -> List (Int, Mono) -> Unit
registerOneMethodDict mname slot id subst = match lookupAssocI id subst
  None => ()
  Some m => match normalize m
    TVar cell => perRun.value.activeDictVars := (tyvarId cell, dictParamName mname slot)::perRun.value.activeDictVars.value
    _ => ()

-- infer each impl-with-`requires`' return-position method bodies; the interface
-- declarations live in [allProg] (method types + typarams).
inferImplBodies : TcEnv -> List Decl -> List String -> List Decl -> Unit
inferImplBodies _ _ _ [] = ()
inferImplBodies env allProg rpNames (d::rest) =
  let _ = inferOneImpl env allProg rpNames d
  inferImplBodies env allProg rpNames rest

inferOneImpl : TcEnv -> List Decl -> List String -> Decl -> Unit
inferOneImpl env allProg rpNames (DAttrib _ d) =
  inferOneImpl env allProg rpNames d
inferOneImpl env allProg rpNames (DImpl { iface, tys, reqs, methods, ... }) = match reqs
  [] => inferPlainImpl env allProg iface tys methods
  _ => inferRequiresImpl env allProg rpNames iface tys reqs methods
inferOneImpl _ _ _ _ = ()

-- D3a: a NON-`requires` impl body, inferred on every path (single elaboration mode)
-- so its ARG-position method occurrences (e.g. `display` of a String field inside a
-- `Display`/`Debug` impl — the 19 `display@String` sites) reach inferMethodAt and
-- get stamped.  Mirrors inferRequiresImpl's head-mono substitution but with no
-- requires to register (an unconstrained impl threads no element dict).
inferPlainImpl : TcEnv -> List Decl -> String -> List Ty -> List ImplMethod -> Unit
inferPlainImpl env allProg iface tys methods =
  let implTvMap = freshTvMap (dedup (flatMap tyVarNames tys))
  let headMonos = map (fromAstType implTvMap) tys
  inferImplMethods env allProg iface implTvMap headMonos methods

-- one impl `impl Iface (List a) requires Iface a where …`: build ONE tyvar map
-- shared between the head (`List a`) and the requires (`Iface a`) so the body's
-- inner method ref unifies its discriminating var to the head's `a`; infer each
-- method body against the method type instantiated at the head; THEN register the
-- requires' post-unification ids in activeDictVars keyed to `$dict_<method>_<slot>`.
inferRequiresImpl : TcEnv -> List Decl -> List String -> String -> List Ty -> List Require -> List ImplMethod -> Unit
inferRequiresImpl env allProg rpNames iface tys reqs methods =
  let implTvMap = freshTvMap (dedup (flatMap tyVarNames tys))
  let headMonos = map (fromAstType implTvMap) tys
  let _ = inferImplMethods env allProg iface implTvMap headMonos methods
  registerImplRequires implTvMap rpNames reqs methods

inferImplMethods : TcEnv -> List Decl -> String -> List (String, Mono) -> List Mono -> List ImplMethod -> Unit
inferImplMethods _ _ _ _ _ [] = ()
inferImplMethods env allProg iface implTvMap headMonos (m::rest) =
  let _ = inferImplMethod env allProg iface implTvMap headMonos m
  inferImplMethods env allProg iface implTvMap headMonos rest

inferImplMethod : TcEnv -> List Decl -> String -> List (String, Mono) -> List Mono -> ImplMethod -> Unit
inferImplMethod env allProg iface implTvMap headMonos (ImplMethod mname pats body) = match ifaceMethodTyResolved allProg iface mname
  None => ()
  Some (ifaceParams, mty, gscope) =>
    -- currentFn = the method name (NOT "") so arg-/return-position sites in THIS
    -- body record `encl = mname`.  registerImplRequires keys every method of an impl
    -- under the SAME impl tyvar id (`impl Ord (List a)` registers `a` once per
    -- compare/lt/min/max/…), so the global first-match route resolution returns the
    -- LAST-registered method's `$dict_<m>_<slot>` for ALL bodies — corrupting e.g.
    -- compare's element dispatch to `$dict_max_0` (unbound in compare's scope).  With
    -- encl = mname, activeDictVarOfEncl/argImplDictRoutesForEncl prefer THIS method's
    -- own `$dict_<mname>_<slot>`.  Pre-specialization each Ord impl defined only
    -- compare so there was no collision; universal default specialization exposes it.
    perRun.value.currentFn := mname
    perRun.value.currentImplBody := True
    perRun.value.inRigidityBodyRef := True
    -- #822: [gscope] arrives FROM `ifaceMethodTyResolved`, in the same result as [mty] —
    -- deliberately NOT a separate lookup.  The Row slots must elaborate here exactly as
    -- they did when this method's own scheme was built, and the only way to guarantee
    -- that is for the scope and the type to be one resolution.  (Getting it wrong is
    -- loud, not silent: `e` would stay a plain tyvar that the body's real `TEff` then
    -- binds, which the W3 survivor check below reports as T-IMPL-TOO-SPECIFIC.)
    -- #837: schemeObligationsRef snapshot/restore window RETIRED — (name, binding-id)
    -- keying makes a where-helper name collision structurally impossible.
    -- #518: window this body's newly-added obligations, exactly as processLetGroup /
    -- checkProgramSeeded do for a let-group, so the Num defaulting below is scoped to
    -- THIS method and can never touch an already-generalized outer var.
    let oblN0 = wMark perRun.value.implObls
    let callN0 = wMark perRun.value.obls
    -- build the method type's tv map explicitly (instead of expectedMethodType,
    -- which hides it) so the impl method's OWN method-level constraint vars
    -- (`Thenable m => …`) can be registered into activeDictVars below.
    let baseMap = zipL ifaceParams headMonos
    -- #822: subtract rowArgNames too — the same split sigToSchemeTvs and
    -- astTypeFreshTbl already make, and this was the one seam of the three that did
    -- not.  A name sitting in a KRow type-app slot (`f e a` under a graded interface)
    -- is an EFFECT variable: it belongs to [effMap] below, and minting a TYPE var for
    -- it as well puts an entry in [extraMap] that [expected] never mentions.
    -- ⚠️ HONEST SCOPE: this is a consistency fix, NOT a fix for an observed bug.  The
    -- counterfactual was built and run (#822 branch): without this subtraction the
    -- graded fixtures still check, run and build identically, because the stray entry
    -- survives unification as an unbound, distinct var and so passes
    -- checkMethodRigidityCore's pinned/dup/head-disjointness tests vacuously.  It is
    -- kept because a survivor set that contains a variable the method type does not
    -- mention is a false-positive waiting for the first rule that quantifies over ALL
    -- survivors — and because one of three parallel seams disagreeing is this file's
    -- documented recurring bug shape.
    let extraMap = freshTvMap (removeAllS ifaceParams (removeAllS (rowArgNamesIn gscope mty) (dedup (tyVarNames mty))))
    -- #782/#784: build the method type's effect table the way sigToSchemeTvs does,
    -- so a free return-position effect var (`speak : a -> <e> String`) becomes a
    -- FRESH OPEN effvar that the impl body's actual effect instantiates (effect
    -- polymorphism: `Speak Dog`'s <Stdout> body sets e := <Stdout>), rather than
    -- collapsing to a CLOSED empty `<>` (fromAstType's empty etbl) and firing a
    -- spurious T-EFFECT-LEAK against a bound the method never declared.  A CONCRETE
    -- (`<Stdout>`) or PURE (`<>`) declared row still yields a closed row, so a genuine
    -- impl-body effect leak past a non-var bound is still enforced (#782).  The free-var
    -- laundering at the CALL site remains #784's concern.
    let effMap = freshEffMap (dedup (effTailNames mty ++ rowArgNamesIn gscope mty))
    let expected = fromAstTypeE effMap (baseMap ++ extraMap) mty
    let actual = inferClauses env [(pats, body)]
    let launderLoc = orElseLoc (implBodyLoc body) (firstTyLoc mty)
    -- #803 (S0): bound the impl body's latent effect on EVERY arrow down to the method's
    -- DECLARED return by the effect the method declares at that same arrow.  An effect an
    -- impl legitimately performs by USING an argument (applying a callback `a -> <e> b`,
    -- running a row-kinded `Async e` arg) enters the body row as that argument's effect
    -- VARIABLE (an unbound tail at impl-check, since params are fresh vars here).  An
    -- INTRINSIC effect — `putStr`, or a call to a concrete-effect helper, sourced from NO
    -- argument — instead lands as a CONCRETE ATOM on whichever arrow evaluates it.  So per
    -- arrow, the impl's concrete atoms must be a subset of the method's declared concrete
    -- atoms; anything more launders to pure at the call site.  Covering ALL declared arrows
    -- (not just the impl's `pats` count) is load-bearing: a curried / eta-reduced impl
    -- (`speak d k = u => putStr …`) writes FEWER patterns and performs its intrinsic effect
    -- on a RETURNED-lambda arrow BEYOND its pattern count — the arrow the declared return
    -- still covers.
    --
    -- #839 2b: this is now a POST-unify QUERY over the absorption event trail
    -- (increment 2a) rather than arrowLaunderEscape's pre-unify walk.  The pre-unify
    -- ordering existed ONLY because `unify` merges an intrinsic atom into the shared open
    -- tail (both-open arm, runs no effectLeakCheck), after which effrowLabels can no longer
    -- see it.  2a records that merge; so: snapshot the declared AND body arrow rows +
    -- MARK the trail BEFORE the unify, run the unify (which now RECORDS each absorbed atom
    -- against the surviving tail), then query the window per arrow.  An OPEN body arrow's
    -- absorbed atom is recovered from the trail; a CLOSED body arrow (a type ANNOTATION,
    -- which the unifier never merges) is checked directionally against the declared row —
    -- see launderEscapeFromLog.  Argument-contributed effects stay variables (never
    -- concrete atoms) so they are structurally exempt at every arrow.
    let launderMark = wMark perRun.value.absorptions
    let declArrows = allArrowEffs expected
    let actualArrows = allArrowEffs actual
    let _ = unify expected actual
    let launderEsc = launderEscapeFromLog declArrows actualArrows (wWindow perRun.value.absorptions launderMark)
    -- True iff the launder query flagged this body — the post-unify effect-atom half
    -- (checkImplEffVarRigidity) then stays quiet (same defect, one report).
    let launderFlagged = isNonEmptyL launderEsc
    let _ = match launderEsc
      [] => ()
      escaping => pushTypeErrorOnceAt "T-EFFECT-LAUNDER" launderLoc (effectLaunderMsg iface mname escaping)
    -- #814 (S0): W3 method-scheme fidelity (DICT-SEMANTICS §3).  The method's
    -- non-head quantified variables — type AND effect — belong to the CALLER
    -- (every use site re-instantiates them freshly), so the body must be checked
    -- at full generality.  [extraMap]/[effMap] were fresh flexible vars for the
    -- unify above; verifying they SURVIVED unification as distinct unbound
    -- variables (types) / atom-free rows with distinct tails (effects) is
    -- equivalent to having checked the body against skolems, at the cost of one
    -- post-unify inspection (the same discipline as checkAnnotTooGeneral's C3).
    -- Without it an impl can pin `b` in `mk : a -> b` — to Int (caller
    -- instantiates b := String, evaluation crashes) or to an effect-bearing
    -- arrow, alone or nested in a tuple/data arg (caller pins b to the pure
    -- arrow: a certified-pure value performs IO — the #814 laundering vein the
    -- per-arrow #803 walk above is structurally blind to).  Runs BEFORE
    -- defaultBodyLocalNum so a body-local Num default can never mask a pin.
    -- [addedObls] (this body's obligation window, also fed to defaultBodyLocalNum
    -- below) carries the CONSTRAINT axis: a body whose pin is a *constrained
    -- var* rather than a constructed type (`mk d = 42` pins b to a Num-obligated
    -- var, still a TVar) escapes the distinctness check, but its obligation on a
    -- caller-owned var is the same lie — gen-sig's `Q_sig ⊩ P'` on the impl side.
    let addedObls = wWindow perRun.value.implObls oblN0
    -- ALSO the CALL-obligation window: a predicate reaching a scheme var through
    -- a constrained HELPER call (`hh : Num x => x -> x`; body `meth d x = hh x`)
    -- is recorded by recordCallObligations, never by recordImplObligation — the
    -- adversarial review's break 2: without this window the Num rides a channel
    -- the survivor check never read, and `check` stayed green on a program whose
    -- built binary printed garbage.
    let addedCallObls = callOblsWindow callN0
    let _ = checkImplMethodRigidity iface mname mty headMonos extraMap effMap addedObls addedCallObls launderFlagged gscope launderLoc
    -- #518 (S0, silent wrongness): PLAN.md #11 Num defaulting NEVER RAN over an impl
    -- method body — this path is not a let-group, so nothing grounded its ambiguous
    -- Num vars.  A literal consumed entirely inside the body (`t _ = s [1, 2]`) left
    -- its element var UNBOUND, so the receiver the route resolver saw was `List _a`,
    -- not `List Int` — and `List _a` matches only the GENERAL `impl S (List a)`, never
    -- the specific `impl S (List Int)`.  The min⊑ selector was never at fault: with one
    -- match there is nothing to select between.  It resolved to the general impl and
    -- routed its `requires S a` to RNone (a null dict) — hence `build` silently printing
    -- the general instance's answer and `run` panicking E-NOT-A-FUNCTION.
    -- The same expression at TOP LEVEL was always correct precisely because
    -- checkProgramSeeded's group defaulting grounded the var to Int first.
    --
    -- MUST run AFTER `unify expected actual` (so [expected] reflects the body's
    -- aliasing) and defaults ONLY BODY-LOCAL vars — see defaultBodyLocalNum, which
    -- explains at length why defaultGroupNum is the WRONG primitive HERE even though
    -- it is what processLetGroup/processSCC use: its arg-position-only exclusion filter
    -- leaves a method-level constraint var in RETURN position (`lift : Num b => a ->
    -- Box b`) unprotected, and at an impl method body that var is dict-supplied by the
    -- CALLER.  Using defaultGroupNum here measurably traded #518's S0 for a new one.
    --
    -- NOT paired with registerAmbiguousConstraints, unlike processLetGroup/processSCC:
    -- that helper reads `currentLevel + 1` and documents itself as running POST-
    -- exitLevel, but this function has no enterLevel/exitLevel at all, so the level it
    -- would compute here is meaningless.  It is also orthogonal to #518 (oblDispatchMonos
    -- returns [] for Num).  Tracked as #564.
    let _ = defaultBodyLocalNum addedObls expected
    -- Eval-path method-dict threading (parity with inferDefaultMethod's
    -- registerMethodDictSlots): an impl method with its OWN method-level constraint
    -- (`wrap : Thenable m => … -> m (List b)`) whose body returns a constraint-var
    -- method (`pure []`) needs that inner site routed RDictFwd $dict_<mname>_<slot>
    -- — the leading method-dict param implDictPassMethods prepends — so eval narrows
    -- it by the dict supplied at the call site (resolveMethodDicts) instead of
    -- falling to arg-tag dispatch and panicking `no matching impl for dispatch`.
    -- The EMIT path already worked because the emitter restamps impl-body
    -- return-position methods to the dict param directly; the eval path relies on
    -- the route, so register the var → dict-param mapping here (AFTER body inference,
    -- so each var is its surviving union-find root, mirroring registerMethodDictSlots).
    let _ = registerImplMethodDicts mname ifaceParams mty extraMap
    -- #837: schemeObligationsRef restore RETIRED (see snapshot site above).
    perRun.value.inRigidityBodyRef := False
    perRun.value.currentImplBody := False
    perRun.value.currentFn := ""
-- G4: mark binop sites recorded while inferring this impl body so resolveBinopSite
-- routes their element dict (RDict) — and ONLY theirs, not top-level operators.

-- #803 (S0, silent wrongness): the impl-body effect-LAUNDER check.  Sound rule, per
-- arrow of the method's DECLARED type down to its final return:
--
--     ∀ arrow i ≤ methodArity.  atoms(body_arrow_effect_i) ⊆ atoms(declared_effect_i)
--
-- i.e. the impl's concrete latent atoms at each arrow must be bounded by the method's
-- declared concrete atoms at that same arrow (the general form of
-- `body_latent ⊆ decl(φ) ∪ argContributable`).  Argument-contributed effects are free
-- and exact: at impl-check every parameter is still a fresh variable, so an effect the
-- body performs by USING an argument (applying a callback, running a row-kinded `Async e`
-- arg) appears as that VARIABLE — never a concrete atom — at every arrow.  Hence the
-- body's *concrete atoms* on any arrow are exactly the INTRINSIC effects, and per-arrow
-- `atomsEscape` against the declared row (IO-expanded via the same expandIoInBound the
-- binding-boundary check uses) is precisely the laundered set — a variable is
-- caller-visible and cannot lie, so only a concrete atom can launder.
--
-- #839 2b: sourced from the absorption event trail (increment 2a), POST-unify, rather
-- than arrowLaunderEscape's pre-unify walk over [expected]/[actual] arrow rows.  The
-- pre-unify walk existed only because `unify` then merges an intrinsic atom into the
-- shared open tail (both-open arm, no effectLeakCheck), after which effrowLabels can no
-- longer see it; 2a records that merge, so a post-unify query recovers it.
--
-- [declArrows]/[actualArrows] = the declared method type's and the inferred body's arrow
-- effect rows, BOTH captured PRE-unify and zipped (same spine, bounded at the shorter —
-- the methodArity bound arrowLaunderEscape had).  [evts] = the events `unify expected
-- actual` recorded in this body's trail window.  The per-arrow residual is
-- `atomsEscape (actual atoms) (declared WRITTEN atoms)`, recovered by two DISJOINT routes
-- keyed on whether the ACTUAL arrow is OPEN or CLOSED:
--
--  * OPEN actual arrow (the common inferred case): an intrinsic atom is ABSORBED at unify
--    (both-open / same-tail arm merges it into a shared tail, no effectLeakCheck), so
--    effrowLabels can no longer see it — recover it from the TRAIL.  Resolve the declared
--    arrow's tail LIVE (post-unify the fresh cell has ELinked into a shared v3 — a record-
--    time id would be -1-poisoned; risk 2), gather the window atoms absorbed into that same
--    live tail (the per-cell key — risk 3, recovering arrowLaunderEscape's which-arrow
--    precision), and `atomsEscape` them against the declared row.  For a CLOSED declared
--    arrow met by an OPEN actual, the guarded closed~open arm already fired effectLeakCheck
--    (T-EFFECT-LEAK) during the SAME unify, so the trail route yields nothing and the leak
--    line stands alone (the pre-unify walk only ever DOUBLE-reported there).
--    WHY the trail equals the walk here: the both-open arm records the SYMMETRIC diff
--    (actual\declared ++ declared\actual) against the shared v3 both tails link to;
--    `atomsEscape absorbed declared` drops the declared\actual side (⊆ declared) and any
--    IO-covered atom, leaving actual \ expandIo(declared) — arrowLaunderEscape's residual.
--
--  * CLOSED actual arrow (a body type ANNOTATION — `(f : Unit -> <Stdout> Unit)`): unify
--    NEVER merges a closed row (closed~closed is a SILENT no-op; open~closed links the
--    OTHER, open tail), so its concrete atoms are STABLE and the trail never records them.
--    A pure log query MISSES them — the #839-2b-review S0: a `<>`-declared arrow returning
--    an annotated closed `<Stdout>` (closed~closed) type-checks GREEN yet performs Stdout
--    at run.  So read the closed atoms straight off the captured row and check them
--    DIRECTIONALLY against the declared written atoms — exactly the residual the pre-unify
--    walk computed at this arrow, now without racing the unifier.  Directional (actual \
--    declared) is load-bearing: an impl PURER than declared (actual `<>` vs declared
--    `<Stdout>`, both closed) yields the empty set and still PASSES — no false positive, and
--    a symmetric/strict "atom sets must be equal" arm-level check would wrongly reject it.
--    (An annotated closed actual met by an OPEN declared arrow lands here too and reports
--    the same launder the #816 effect-var rigidity check would — one report, via
--    launderFlagged suppression — matching the pre-unify walk.)
launderEscapeFromLog : List EffRow -> List EffRow -> List AbsorptionEvent -> List Atom
launderEscapeFromLog [] _ _ = []
launderEscapeFromLog _ [] _ = []
launderEscapeFromLog (der::dRest) (aer::aRest) evts =
  let here = match aer
    EffRow aAtoms None => atomsEscape aAtoms (effrowWrittenAtoms der)
    EffRow _ (Some _) => launderOpenActualArrow der evts
  here ++ launderEscapeFromLog dRest aRest evts

-- OPEN actual arrow: recover the absorbed launder atom from the trail, keyed on an OPEN
-- declared arrow's live tail; a CLOSED declared arrow's leak was already reported by the
-- closed~open arm's effectLeakCheck during the unify, so yield nothing.
launderOpenActualArrow : EffRow -> List AbsorptionEvent -> List Atom
launderOpenActualArrow (EffRow declAtoms (Some cell)) evts =
  let tid = liveTailId cell
  if tid == 0 - 1 then
    []
  else
    atomsEscape (atomsAbsorbedInto tid evts) declAtoms
launderOpenActualArrow (EffRow _ None) _ = []

-- the raw WRITTEN atoms of an arrow row captured pre-unify — the `atoms` field directly,
-- NOT effrowLabels (which effrowNorms THROUGH a tail the unify may since have linked,
-- polluting the declared set with the very atoms that were absorbed into it).
effrowWrittenAtoms : EffRow -> List Atom
effrowWrittenAtoms (EffRow atoms _) = atoms

-- the concrete atoms the window recorded as absorbed into the live tail [tid]
-- (resolving each event's stored cell live, per risk 2).
atomsAbsorbedInto : Int -> List AbsorptionEvent -> List Atom
atomsAbsorbedInto _ [] = []
atomsAbsorbedInto tid (ev::rest) =
  if liveTailId ev.cell == tid then
    ev.atom :: atomsAbsorbedInto tid rest
  else
    atomsAbsorbedInto tid rest

-- resolve an absorbing tail CELL to its live effvar id (post-unify the cell has ELinked
-- into a shared tail); -1 for a cell that resolved to a CLOSED row (no live tail).  Same
-- idiom as effVarTailIds.
liveTailId : Ref Effvar -> Int
liveTailId cell = match effrowNorm (EffRow [] (Some cell))
  EffRow _ (Some t) => effvarId t
  EffRow _ None => 0 - 1

-- the effect rows on each arrow of a Mono arrow spine, outermost first, down to the
-- non-arrow result (length = the type's arity).
allArrowEffs : Mono -> List EffRow
allArrowEffs m = match normalize m
  TFun _ eff b => eff :: allArrowEffs b
  _ => []

-- the first source span inside an impl-method body, for locating T-EFFECT-LAUNDER
-- at the offending body rather than the shared interface signature.  Peels the
-- let-chain a `let _ = putStr …; body` body desugars to (a partial mirror of
-- resolve.mdk's firstExprLoc, which is not exported); falls back at the call site
-- to the method-signature loc when the body carries no span.
implBodyLoc : Expr -> Option Loc
implBodyLoc (ELoc l _) = Some l
implBodyLoc (ELam _ b) = implBodyLoc b
implBodyLoc (ELet _ _ _ e1 e2) = orElseLoc (implBodyLoc e1) (implBodyLoc e2)
implBodyLoc (ELetGroup _ b) = implBodyLoc b
implBodyLoc _ = None

effectLaunderMsg : String -> String -> List Atom -> String
effectLaunderMsg iface mname escaping = "Effect laundering in impl of '\{mname}' for interface '\{iface}': the body performs <\{renderAtoms escaping}>, which is not sourced from any argument and is not declared by the method's effect row, so a caller can instantiate the method's effect variable to <> and a function typed pure would then silently perform it. Either declare the effect as a concrete label in the method's return row (e.g. `<\{renderAtoms escaping}>`), or perform it only through an argument (a callback carrying `<e>`) so the caller sees it."

-- #814 (S0): W3 method-scheme fidelity — the post-unify rigidity check.  The
-- method scheme's non-head quantifiers are re-instantiated freshly by every
-- caller, so the impl body may not constrain them.  Having unified the body
-- against fresh flexible vars, rigidity holds iff each survived untouched:
--   · every [extraMap] type var still normalizes to a TVar (not pinned to a
--     constructed type), and all their ids are pairwise distinct and disjoint
--     from the impl-head vars' ids (not identified with each other or with a
--     head variable);
--   · every [effMap] effect var's row carries no concrete atom beyond what the
--     declared row at EVERY occurrence of that var in [mty] already covers
--     (IO-expanded, as the §5 escape check) — an atom unification poured into
--     the var from a position whose declared row lacks it is an intrinsic
--     effect the caller erases by instantiating the var to <>; and the vars'
--     tails are pairwise distinct (aliasing an INSTANCE-HEAD row param is
--     admitted — the #817 carve-out; see checkImplEffVarRigidity).
-- Union-find bindings are monotone, so a var unbound-and-distinct AFTER unify
-- was never constrained DURING it: this is observationally the skolem check.
-- All lists here are the handful of quantified vars of one method signature.
-- #840 Step 2a: the ONE parameterized rigidity core.  checkImplMethodRigidity
-- and checkDefaultMethodRigidity were ~80% identical (the pinned/dup-survivor
-- head and the survivor-obligation tail already shared); the legitimate per-path
-- differences are EXPLICIT parameters here, never a silent collapse
-- (#838-I4/#863).  Byte-identical to the two forked checkers on every input:
--   * [subject]      implSubject vs defaultSubject, built by the caller (rows 1/2).
--   * [headMonos]    the instance-head monos on the impl path; a default body has
--                    NO instance head, so the caller passes [] (row 11).  [] is the
--                    honest value — the head-disjointness disjunct then goes vacuous
--                    (anyContainsI _ [] = False), reproducing default's `hasDupI`-only
--                    test exactly.
--   * [extraMap]     the survivor set (row 10): impl's non-head extraMap vs the
--                    default's `defaultSurvivorMap tvs subst` over ALL sig vars —
--                    built by the caller and passed in.
--   * [ownTyparams]  [] on impl, the interface typarams on default (row 12): a
--                    receiver-typaram obligation is self-entailed on the default path.
--   * [effInside]    row 14: the eff-var rigidity check lives INSIDE this core on
--                    the impl path (Some (effMap, launderFlagged)); on the default
--                    path it is a SEPARATE call site upstream, so None here.  The
--                    launderFlagged value (row 8) is threaded through this Some,
--                    preserving today's values exactly (impl: the real threaded flag;
--                    default's own separate call: False) — 2a does NOT touch the
--                    double-report.
checkMethodRigidityCore : String -> String -> Ty -> List Mono -> List (String, Mono) -> List String -> List UObligation -> List (IfaceRef, List Mono, Option Loc) -> Option (List (String, Ref Effvar), Bool, List (String, List Kind)) -> Option Loc -> Unit
checkMethodRigidityCore subject iface mty headMonos extraMap ownTyparams addedObls addedCallObls effInside loc =
  let pinned = map fst (filterList (p => not (isUnboundTvar (snd p))) extraMap)
  let _ = if isNonEmptyL pinned then pushTypeErrorOnceAt "T-IMPL-TOO-SPECIFIC" loc (pinsTyvarMsg subject mty pinned)
  else
    let survivors = sigTvarIds (map snd extraMap)
    if hasDupI survivors || anyContainsI survivors (flatMap monoTyvarIds headMonos) then
      pushTypeErrorOnceAt "T-IMPL-TOO-SPECIFIC" loc (collapsesTyvarsMsg subject mty)
    else
      ()
  let _ = checkSurvivorObligations subject iface ownTyparams mty extraMap addedObls loc
  let _ = checkSurvivorCallObligations subject iface ownTyparams mty extraMap addedCallObls loc
  match effInside
    Some (effMap, launderFlagged, gscope) =>
      checkImplEffVarRigidity subject gscope mty effMap launderFlagged loc
    None => ()

checkImplMethodRigidity : String -> String -> Ty -> List Mono -> List (String, Mono) -> List (String, Ref Effvar) -> List UObligation -> List (IfaceRef, List Mono, Option Loc) -> Bool -> List (String, List Kind) -> Option Loc -> Unit
checkImplMethodRigidity iface mname mty headMonos extraMap effMap addedObls addedCallObls launderFlagged gscope loc = checkMethodRigidityCore (implSubject iface mname) iface mty headMonos extraMap [] addedObls addedCallObls (Some (effMap, launderFlagged, gscope)) loc

-- B1 (adversarial review): the GENERIC default-method path is the checking seam
-- for a cross-module impl that inherits an interface default (fillImplDefaults
-- is same-module only, deliberately), and it had NO rigidity guard — a default
-- `mk d = "not-a-b"` under `mk : a -> b` sailed through and the importer's
-- built binary reinterpreted the String as Int.  Same W3 rule, two twists:
--   * ALL the signature's quantified vars are survivors here — the interface
--     typarams too (the default must be parametric in the receiver);
--   * an obligation on a RECEIVER typaram is entailed by the interface ITSELF
--     plus its requires-closure (Ord's default `lt` calling `compare` infers
--     `Ord a` — self-entailed; a Thenable default's `pure` infers the super
--     `Applicative m`), not by method-level `=>` constraints.
-- [tvs] is sigToSchemeTvs' name→scheme-var map; [subst] instantiateTracked's
-- scheme-var-id→fresh-mono subst — crossing them recovers each declared name's
-- post-unify mono, the same shape inferImplMethod's extraMap has.
checkDefaultMethodRigidity : String -> List String -> String -> Ty -> List (String, Mono) -> List (Int, Mono) -> List UObligation -> List (IfaceRef, List Mono, Option Loc) -> Option Loc -> Unit
checkDefaultMethodRigidity iface typarams mname mty tvs subst addedObls addedCallObls loc = checkMethodRigidityCore (defaultSubject iface mname) iface mty [] (defaultSurvivorMap tvs subst) typarams addedObls addedCallObls None loc

defaultSurvivorMap : List (String, Mono) -> List (Int, Mono) -> List (String, Mono)
defaultSurvivorMap [] _ = []
defaultSurvivorMap ((name, m)::rest) subst = match lookupAssocI (monoTyvarId m) subst
  Some fm => (name, fm) :: defaultSurvivorMap rest subst
  None => defaultSurvivorMap rest subst

implSubject : String -> String -> String
implSubject iface mname = "Impl of '\{mname}' for interface '\{iface}'"

defaultSubject : String -> String -> String
defaultSubject iface mname =
  "Default body of '\{mname}' in interface '\{iface}'"

-- the constraint axis of W3: a predicate the body records on a method-scheme
-- var must be entailed by a DECLARED method-level constraint on that var,
-- closed under `requires` (`foldMap : Monoid m => …` whose body's `++` infers
-- `Semigroup m` is entailed; `mk : a -> b` whose body's `42` infers `Num b` is
-- not — a caller instantiates b to a type with no Num impl and evaluation
-- dispatches into nothing).  Obligations on non-scheme vars (body-local
-- literals, impl-head `requires` vars, ground receivers) are skipped — the
-- existing checkImplObligations/defaulting machinery owns those.  [ownTyparams]
-- is non-empty only on the default path: an obligation on one of those
-- (receiver) vars is entailed by the interface itself + requires-closure.
checkSurvivorObligations : String -> String -> List String -> Ty -> List (String, Mono) -> List UObligation -> Option Loc -> Unit
checkSurvivorObligations _ _ _ _ _ [] _ = ()
checkSurvivorObligations subject ownIface ownTyparams mty extraMap (o::rest) loc =
  -- the obligation's occurrence mono is the FULL instantiated occurrence type (`Int -> a`
  -- for a literal's `fromInt`); the constrained position is extracted by the
  -- same declared-type walk checkImplObligations uses.  Dispatch (receiver)
  -- typarams only, per the F0 stance: a non-receiver typaram is impl-determined.
  let _ = match o.oblProj
    OpProjected => ()
    OpMethodOcc otyparams omty occ => checkSurvivorDispatchMonos
      subject
      ownIface
      ownTyparams
      mty
      extraMap
      o.pred.iface.irName
      (dispatchMonosOf (dispatchTyparams otyparams) omty occ)
      loc
  checkSurvivorObligations subject ownIface ownTyparams mty extraMap rest loc

-- the CALL-obligation half of the constraint axis: recordCallObligations pushes
-- (iface, [constraint-var mono], loc) for each dict slot a constrained CALLEE
-- discharges at a call site, so the monos here are the dispatch monos directly
-- (no declared-type walk needed).  Same rule as checkSurvivorObligations: a
-- predicate landing on a method-scheme var must be entailed by a declared
-- method-level constraint under requires-closure.
checkSurvivorCallObligations : String -> String -> List String -> Ty -> List (String, Mono) -> List (IfaceRef, List Mono, Option Loc) -> Option Loc -> Unit
checkSurvivorCallObligations _ _ _ _ _ [] _ = ()
checkSurvivorCallObligations subject ownIface ownTyparams mty extraMap ((oiface, monos, _)::rest) loc =
  let _ = checkSurvivorDispatchMonos subject ownIface ownTyparams mty extraMap oiface.irName monos loc
  checkSurvivorCallObligations
    subject
    ownIface
    ownTyparams
    mty
    extraMap
    rest
    loc

checkSurvivorDispatchMonos : String -> String -> List String -> Ty -> List (String, Mono) -> String -> List Mono -> Option Loc -> Unit
checkSurvivorDispatchMonos _ _ _ _ _ _ [] _ = ()
checkSurvivorDispatchMonos subject ownIface ownTyparams mty extraMap oiface (dm::rest) loc =
  let _ = match survivorNameOf dm extraMap
    Some vname =>
      if survivorObligationEntailed ownIface ownTyparams oiface vname mty then
        ()
      else
        pushTypeErrorOnceAt "T-IMPL-TOO-SPECIFIC" loc (undeclaredConstraintMsg subject mty oiface vname)
    None => ()
  checkSurvivorDispatchMonos
    subject
    ownIface
    ownTyparams
    mty
    extraMap
    oiface
    rest
    loc

-- entailment base per var kind: a RECEIVER typaram (default path only) is
-- entailed by the owning interface itself + requires-closure; a method-level
-- var by its declared `=>` constraints + requires-closure.
survivorObligationEntailed : String -> List String -> String -> String -> Ty -> Bool
survivorObligationEntailed ownIface ownTyparams oiface vname mty
  | contains vname ownTyparams = contains oiface (ifaceSelfAndSupers ownIface)
  | otherwise = entailedByDeclared oiface vname mty

-- the method-scheme var name whose post-unify root [omono] resolves to, if any
survivorNameOf : Mono -> List (String, Mono) -> Option String
survivorNameOf omono extraMap = match normalize omono
  TVar cell => survivorNameOfId (tyvarId cell) extraMap
  _ => None

survivorNameOfId : Int -> List (String, Mono) -> Option String
survivorNameOfId _ [] = None
survivorNameOfId id ((n, m)::rest) = match normalize m
  TVar cell => if tyvarId cell == id then Some n else survivorNameOfId id rest
  _ => survivorNameOfId id rest

-- is [oiface] within the `requires`-closure of the method-level constraints
-- declared on var [vname] in [mty]?  ifaceSelfAndSupers — NOT expandSupersPairs,
-- whose WS-1b user-iface guard deliberately skips prelude chains (a dict-SLOT
-- policy), while entailment here must see them (`Monoid m =>` entails the
-- prelude `Semigroup m`).
entailedByDeclared : String -> String -> Ty -> Bool
entailedByDeclared oiface vname mty =
  contains oiface (flatMap ifaceSelfAndSupers (declaredIfacesOn vname mty))

-- the interfaces the method's own signature constrains [vname] with
declaredIfacesOn : String -> Ty -> List String
declaredIfacesOn vname (TyConstrained cs t) = map constraintIface (filterList (c => contains vname (constraintVarNames c)) cs)
  ++ declaredIfacesOn vname t
declaredIfacesOn vname (TyEffect _ _ t) = declaredIfacesOn vname t
declaredIfacesOn _ _ = []

constraintIface : Constraint -> String
constraintIface (Constraint { constraintHead = n }) = n

constraintVarNames : Constraint -> List String
constraintVarNames (Constraint { constraintArgs = args }) =
  flatMap tyVarNames args

isUnboundTvar : Mono -> Bool
isUnboundTvar m = match normalize m
  TVar _ => True
  _ => False

-- #837 incr2 (Axis A): the value-restricted arm of the old `isBodyLocalScheme`,
-- kept as a pure STRUCTURAL test.  A monomorphic scheme (`Forall [] []`) is never
-- a genuine interface-method occurrence — every real method quantifies at least
-- its interface parameter — so a mono scheme reaching a `recordImplObligation`
-- guard denotes a value-restricted local (a lambda/pattern var, or a
-- value-restricted simple `let`) and must NOT record a method obligation.  This
-- arm is retained verbatim; the old `(name, schemeIds) ∈ bodyLocalSchemesRef`
-- membership arm (generalized locals) is now the ENV is-local flag
-- (`lookupLocalFlag`, §TcEnv), which is lexically scoped and cannot go stale.
isMonoScheme : Scheme -> Bool
isMonoScheme (Forall [] [] _) = True
isMonoScheme _ = False

-- any member of [xs] present in [ys] (tiny per-method var lists)
anyContainsI : List Int -> List Int -> Bool
anyContainsI [] _ = False
anyContainsI (x::xs) ys = containsI x ys || anyContainsI xs ys

-- the effect half of the rigidity check: atom containment per declared
-- occurrence, then tail distinctness among the METHOD's own effect vars.
-- ⚠️ #817 carve-out: a method effect var unifying with an INSTANCE-HEAD row
-- parameter (`impl Mappable (Async e)`, whose Suspend arm stores the callback
-- and so forces method `e'` ~ head `e`) is deliberately ADMITTED — the
-- impl-head types' row tails are NOT in the dup set.  It is a real residual
-- laundering channel (verified: a pure-typed thunk returned through `Async`
-- performs Stdout when forced — issue #817), but rejecting it would outlaw
-- Async v1's shipped Mappable/Thenable impls, which cannot be written
-- otherwise: the sound result row `e ⊔ e'` is inexpressible with `f` fixed to
-- `Async e`.  Resolution is design-scoped (#817); until then this check
-- preserves main's behavior for that channel exactly.  (The TYPE-var half has
-- no such carve-out: a method type var may never alias an impl-head type var.)
checkImplEffVarRigidity : String -> List (String, List Kind) -> Ty -> List (String, Ref Effvar) -> Bool -> Option Loc -> Unit
checkImplEffVarRigidity subject scope mty effMap launderFlagged loc =
  let occs = effVarOccAtoms mty ++ map (n => (n, [])) (rowArgNamesIn scope mty)
  let _ = if launderFlagged then
    ()
  else
    checkEffVarAtoms subject occs effMap loc
  -- ⚠️ DEFERRED-PERFORMANCE residual (round-2 break 4; tracked, NOT enforced):
  -- a method effect var forced CLOSED post-unify is in truth a PIN — an impl
  -- that applies its <e>-callback inside a value whose declared row is pure
  -- (`act d k = (u => k ())` under `-> <e> (Unit -> Unit)`) closes e := <>,
  -- and a caller's effectful callback then runs inside a pure-typed thunk.
  -- Rejecting it here is CORRECT but outlaws the compiler's own Parser monad
  -- (`impl Mappable Parser` stores the callback under Parser's pure arrows —
  -- the identical shape, latent because the compiler only passes pure
  -- callbacks) and every pure-container deferred-application impl with it.
  -- Like #817, the honest result type needs grading (`Parser e a`, #820), so
  -- the channel is admitted for now and owned by #825 (pinned).
  if hasDupI (effVarTailIds effMap) then
    pushTypeErrorOnceAt "T-IMPL-TOO-SPECIFIC" loc (collapsesEffvarsMsg subject mty)
  else
    ()

checkEffVarAtoms : String -> List (String, List Atom) -> List (String, Ref Effvar) -> Option Loc -> Unit
checkEffVarAtoms _ _ [] _ = ()
checkEffVarAtoms subject occs ((n, cell)::rest) loc =
  let esc = effVarOccEscape n (effrowLabels (EffRow [] (Some cell))) occs
  let _ = if isNonEmptyL esc then
    pushTypeErrorOnceAt "T-EFFECT-LAUNDER" loc (effVarLaunderMsg subject n esc)
  else
    ()
  checkEffVarAtoms subject occs rest loc

-- the first occurrence of var [n] whose declared atoms fail to cover
-- [instAtoms]: laundering demands EVERY occurrence cover the instantiation,
-- since the caller reads the var's row at each of them independently.
effVarOccEscape : String -> List Atom -> List (String, List Atom) -> List Atom
effVarOccEscape _ [] _ = []
effVarOccEscape _ _ [] = []
effVarOccEscape n instAtoms ((m, declAtoms)::rest) =
  if m == n && isNonEmptyL (atomsEscape instAtoms declAtoms) then
    atomsEscape instAtoms declAtoms
  else
    effVarOccEscape n instAtoms rest

-- (name, written atoms) for each named-tail row occurrence in a method's AST
-- type — every TyEffect node, on the arrow spine or nested (tuples, callback
-- rows, data-arg rows).  Bare row-kinded ctor-arg slots (`Async e a`) carry no
-- written atoms and are contributed by rowArgNames at the call site.
effVarOccAtoms : Ty -> List (String, List Atom)
effVarOccAtoms (TyEffect labels (Some n) t) =
  (n, atomsOfWritten labels) :: effVarOccAtoms t
effVarOccAtoms (TyEffect _ None t) = effVarOccAtoms t
-- A bare row atom (#997) is a named-tail row occurrence exactly like
-- `TyEffect` above, just with no wrapped type. Without this arm, a KRow
-- ctor-arg written as `Box <Stdout | e> Int` was invisible to
-- `checkImplEffVarRigidity`'s coverage set, so the impl-body T-EFFECT-LAUNDER
-- check over-fired ("not sourced from any argument") on an argument that
-- demonstrably DOES declare the atom.
effVarOccAtoms (TyRow labels (Some n) _) = [(n, atomsOfWritten labels)]
effVarOccAtoms (TyRow _ None _) = []
effVarOccAtoms (TyApp a b) = effVarOccAtoms a ++ effVarOccAtoms b
effVarOccAtoms (TyFun a b) = effVarOccAtoms a ++ effVarOccAtoms b
effVarOccAtoms (TyTuple ts) = flatMap effVarOccAtoms ts
effVarOccAtoms (TyConstrained _ t) = effVarOccAtoms t
effVarOccAtoms _ = []

-- the still-open tail id of each method effect var's row, post-unify (a closed
-- row contributes nothing: closing a var to the empty row performs LESS than
-- any caller instantiation — the safe direction, not a pin).
effVarTailIds : List (String, Ref Effvar) -> List Int
effVarTailIds [] = []
effVarTailIds ((_, cell)::rest) = match effrowNorm (EffRow [] (Some cell))
  EffRow _ (Some t) => effvarId t :: effVarTailIds rest
  EffRow _ None => effVarTailIds rest

quotedNames : List String -> String
quotedNames names = joinWith ", " (map (n => "'" ++ n ++ "'") names)

pinsTyvarMsg : String -> Ty -> List String -> String
pinsTyvarMsg subject mty pinned = "\{subject} pins the method's quantified type variable(s) \{quotedNames pinned}: the declared type '\{ppTy mty}' promises every caller its own choice of \{quotedNames pinned}, but this body fixes them to specific types. A caller instantiating them differently would get a value of the wrong type — or, if the pinned type carries an effect row, a value typed pure that silently performs effects. Make the body parametric in \{quotedNames pinned}, or name the intended concrete type in the method's signature."

undeclaredConstraintMsg : String -> Ty -> String -> String -> String
undeclaredConstraintMsg subject mty oiface vname = "\{subject} requires '\{oiface}' on the method's quantified type variable '\{vname}', but the declared type '\{ppTy mty}' does not: every caller instantiates '\{vname}' freely (including to a type with no '\{oiface}' impl), so the body may not assume it. Add the constraint to the method's signature (`\{oiface} \{vname} => …`), or make the body parametric in '\{vname}'."

collapsesTyvarsMsg : String -> Ty -> String
collapsesTyvarsMsg subject mty = "\{subject} identifies quantified type variables that the declared type '\{ppTy mty}' keeps distinct (two method variables forced equal, or a method variable forced equal to an impl-head variable). Every caller may instantiate each independently, so the body must keep them independent."

defaultEffectLaunderMsg : String -> List Atom -> String
defaultEffectLaunderMsg subject escaping = "\{subject} launders an effect: the body performs <\{renderAtoms escaping}>, which is not sourced from any argument and is not declared by the method's effect row, so a caller can instantiate the method's effect variable to <> and a value typed pure would silently perform it. Declare the effect as a concrete label in the method's row, or perform it only through an argument so the caller sees it."

collapsesEffvarsMsg : String -> Ty -> String
collapsesEffvarsMsg subject mty = "\{subject} identifies effect variables that the declared type '\{ppTy mty}' keeps distinct. Every caller instantiates each independently, so unifying them lets an effect flow to a row the caller pinned to <>. Keep the body's effects on the variable the signature declares at that position."

effVarLaunderMsg : String -> String -> List Atom -> String
effVarLaunderMsg subject evar escaping = "\{subject} launders an effect: the body performs <\{renderAtoms escaping}> inside the method's effect variable <\{evar}>, at a position whose declared row does not include it, so a caller can instantiate <\{evar}> to <> and a value typed pure would silently perform it. Declare the effect as a concrete label at that position in the method's signature, or perform it only through an argument (a callback carrying <\{evar}>) so the caller sees it."

-- Register an impl method's OWN method-level constraints (`Thenable m => …`) into
-- activeDictVars, one slot per constraint, so a return-position method in the impl
-- body whose result type is the constraint var routes RDictFwd $dict_<mname>_<slot>.
-- [tvMap] maps the method type's non-interface-param tyvar names → the fresh vars
-- expected/the body unified against; normalize each to its surviving root before
-- registering.  Slot numbering matches methodConstraintSlotIds (same flatMap order),
-- so it lines up with implDictPassMethods' prepended params and the call-site
-- methodRoutes resolveMethodDicts fills.
registerImplMethodDicts : String -> List String -> Ty -> List (String, Mono) -> Unit
registerImplMethodDicts mname ifaceParams mty tvMap =
  registerImplMethodDictsGo
    mname
    0
    (methodLevelConstraintVarNames ifaceParams mty)
    tvMap

registerImplMethodDictsGo : String -> Int -> List String -> List (String, Mono) -> Unit
registerImplMethodDictsGo _ _ [] _ = ()
registerImplMethodDictsGo mname slot (vname::rest) tvMap =
  let _ = registerImplMethodDictOne mname slot vname tvMap
  registerImplMethodDictsGo mname (slot + 1) rest tvMap

registerImplMethodDictOne : String -> Int -> String -> List (String, Mono) -> Unit
registerImplMethodDictOne mname slot vname tvMap = match lookupAssoc vname tvMap
  None => ()
  Some m => match normalize m
    TVar cell => perRun.value.activeDictVars := (tyvarId cell, dictParamName mname slot)::perRun.value.activeDictVars.value
    _ => ()

-- the non-interface-param dispatch var name of each method-level constraint, in
-- declaration order — the name-returning mirror of methodConstraintSlotIds (which
-- returns the ids).  One name per constraint slot; a constraint over only interface
-- params contributes nothing (it dispatches via the impl, not a dict).
methodLevelConstraintVarNames : List String -> Ty -> List String
methodLevelConstraintVarNames typarams (TyConstrained cs t) = flatMap (constraintFirstNonParam typarams) cs
  ++ methodLevelConstraintVarNames typarams t
methodLevelConstraintVarNames typarams (TyEffect _ _ t) =
  methodLevelConstraintVarNames typarams t
methodLevelConstraintVarNames _ _ = []

constraintFirstNonParam : List String -> Constraint -> List String
constraintFirstNonParam typarams c = match constraintNonParamVars typarams c
  [] => []
  n::_ => [n]

-- #818 (#838 I3): (dispatch-var-name, interface-name) per method-level `=>` constraint
-- slot — the same slots methodLevelConstraintVarNames enumerates (a non-interface-param
-- dispatch var, in declaration order), each paired with its constraint's interface.
-- recordMethodLevelObls uses it to attach the right iface to each slot's obligation.
methodLevelConstraintSlots : List String -> Ty -> List (String, IfaceRef)
methodLevelConstraintSlots typarams (TyConstrained cs t) = flatMap (constraintSlotVarIface typarams) cs
  ++ methodLevelConstraintSlots typarams t
methodLevelConstraintSlots typarams (TyEffect _ _ t) =
  methodLevelConstraintSlots typarams t
methodLevelConstraintSlots _ _ = []

-- P1 (#1446): the slot's interface identity comes from the `Constraint` occurrence
-- resolve already stamped (`constraintOrigin`, #1110) — no new supply pass.
constraintSlotVarIface : List String -> Constraint -> List (String, IfaceRef)
constraintSlotVarIface typarams c = match constraintNonParamVars typarams c
  [] => []
  n::_ => [(n, IfaceRef {
        irName = constraintIface c,
        irOrigin = c.constraintOrigin,
      })]

-- #818 (#838 I3): strip the leading `=>`/effect wrappers off a method's declared type,
-- leaving the bare function spine so matchTyMono can align it against a constraint-free
-- occurrence mono (mirrors the TyConstrained/TyEffect peel in methodLevelConstraintVarNames).
stripLeadingMethodConstraints : Ty -> Ty
stripLeadingMethodConstraints (TyConstrained _ t) =
  stripLeadingMethodConstraints t
stripLeadingMethodConstraints (TyEffect _ _ t) = stripLeadingMethodConstraints t
stripLeadingMethodConstraints t = t

removeAllS : List String -> List String -> List String
removeAllS _ [] = []
removeAllS drop (x::xs)
  | contains x drop = removeAllS drop xs
  | otherwise = x :: removeAllS drop xs

-- #760: same result as ifaceMethodTy, but O(log) via the registered `methodIfaceParamsRef`
-- table when `useFastIfaceMethodTy` is set (the check-path ground-impl pass) — else the
-- exact O(program) scan (emit path, byte-identical to before).  The table stores
-- `mname -> (iface, typarams, mty)` — the SAME (typarams, mty) ifaceMethodTy extracts.  It
-- is method-NAME-keyed last-write-wins, so on a rare cross-interface method-name COLLISION a
-- lookup whose stored iface /= [iface] returns None; that only makes the check-path
-- obligation pass SKIP that impl body (a missed reject, deferred to build — the pre-#760
-- status quo), never a false reject, and never touches the emit path.
-- #822: BOTH paths also return the interface's graded scope, so a caller cannot obtain
-- the method type without the scope that elaborates it.  On the slow path it comes from
-- the very declaration this scan selected (free — same traversal); on the fast path it
-- comes out of the same table entry as `(typarams, mty)`.
ifaceMethodTyResolved : List Decl -> String -> String -> Option (List String, Ty, List (String, List Kind))
ifaceMethodTyResolved allProg iface mname
  | !useFastIfaceMethodTy = match omLookup mname perRun.value.methodIfaceParamsRef.value
    Some (ifn, typarams, mty, scope) =>
      -- ⚠️ SPELLING comparison, deliberately: the caller supplies `iface` as a bare
      -- name (from an `impl` head / a default-body subject), so making this an identity
      -- test would need the caller re-keyed first.  #1446 P1 stops at the OBLIGATION
      -- channel; this guard is unchanged in behaviour.
      if ifn.irName == iface then
        Some (typarams, mty, scope)
      else
        None
    None => None
  | otherwise = ifaceMethodTy allProg iface mname

-- the (interface typarams, declared method type, graded scope) of method [mname] in
-- interface [iface], searched across [allProg]'s interface decls
ifaceMethodTy : List Decl -> String -> String -> Option (List String, Ty, List (String, List Kind))
ifaceMethodTy [] _ _ = None
ifaceMethodTy ((DAttrib _ d)::rest) iface mname = match ifaceMethodTy [d] iface mname
  Some r => Some r
  None => ifaceMethodTy rest iface mname
ifaceMethodTy ((DInterface { name, typarams, methods, ... })::rest) iface mname
  | name == iface = match methodTyOf mname methods
    Some ty => Some (typarams, ty, declGradedScope typarams methods)
    None => ifaceMethodTy rest iface mname
  | otherwise = ifaceMethodTy rest iface mname
ifaceMethodTy (_::rest) iface mname = ifaceMethodTy rest iface mname

methodTyOf : String -> List IfaceMethod -> Option Ty
methodTyOf _ [] = None
methodTyOf mname ((IfaceMethod n ty _)::rest)
  | n == mname = Some ty
  | otherwise = methodTyOf mname rest

-- AFTER body inference: for each method of the impl that dispatches the element
-- (return-position OR, on the emit path, argument-position), register the requires'
-- surviving (normalized) tyvar ids → its `$dict_<method>_<slot>` param, so the
-- inner ref's pendingSite/pendingArgStamp (also normalizing to that id) routes
-- RDict.  D3b-1: arg-position methods (`eq`/`compare`/`debug`/… on the element)
-- register whenever argDispatchOf finds a dispatch index (single elaboration mode;
-- return-position-only methods are unaffected).  (The element tyvar is shared
-- across an impl's methods, so per-method dict names only disambiguate for
-- single-method interfaces — exactly the D3b-1 targets Eq/Ord/Debug/Display/Hashable.)
registerImplRequires : List (String, Mono) -> List String -> List Require -> List ImplMethod -> Unit
registerImplRequires _ _ _ [] = ()
registerImplRequires implTvMap rpNames reqs ((ImplMethod mname _ _)::rest)
  | registersElementDict mname rpNames =
    let _ = registerReqSlots mname implTvMap (methodDictArityOf mname) reqs
    registerImplRequires implTvMap rpNames reqs rest
  | otherwise = registerImplRequires implTvMap rpNames reqs rest

-- a method registers an element dict if it is return-position (rpNames) or — on
-- the emit path only — an arg-position dispatch method (argDispatchOf is Some).
registersElementDict : String -> List String -> Bool
registersElementDict mname rpNames = contains mname rpNames
  || isSome (argDispatchOf mname)

registerReqSlots : String -> List (String, Mono) -> Int -> List Require -> Unit
registerReqSlots _ _ _ [] = ()
registerReqSlots mname implTvMap slot ((Require { requireHead = iface, requireArgs = rargs, requireOrigin = ro })::rest) =
  let argMonos = map (a => fromAstType implTvMap a) rargs
  let ids = flatMap monoTyvarIds argMonos
  let _ = registerEachActive ids (dictParamName mname slot)
  let _ = registerPredGiven iface argMonos (dictParamName mname slot)
  -- #1154 RESIDUAL: record the WHOLE predicate beside the ids, in the SAME op that
  -- registers them, so the two can never be written apart (`setFunConstraintEntry`'s
  -- rule, one channel over).  `registerPredGiven` above cannot serve this: it is
  -- single-subject and STRUCTURED-only, so `requires Ix a Char` registers nothing there.
  -- SLICE-1 SUPPLY (#1182): `requireOrigin` is a field of the `Require` this arm
  -- ALREADY destructures — `reqToObligation` reads the same pair to build a real
  -- `IfaceRef` — so this was a projection thrown away in place, not a missing channel.
  -- PURE SUPPLY: `implReqPreds`' only reader is `implReqPick`, which compares
  -- `sp.iface.irName` against the goal's, so no slot is picked differently today.
  let entry = (dictParamName mname slot, ids, Predicate { iface = IfaceRef { irName = iface, irOrigin = ro }, args = argMonos })
  perRun.value.implReqPreds := entry::perRun.value.implReqPreds.value
  registerReqSlots mname implTvMap (slot + 1) rest

-- #412: the PREDICATE-keyed half of the given registry.  `activeDictVars` above is keyed
-- by TYVAR ID, which cannot express a STRUCTURED given: `requires S (List a)` registers
-- only `a`'s id (monoTyvarIds descends to the leaves), and the goal `S (List a)` looks up
-- through `activeDictVarOf`, which recurses to the SPINE HEAD (`TCon "List"`) and finds no
-- tyvar — so `assum` was unreachable by construction and `entail` fell through to
-- `entailInst`, statically committing the body to the GENERAL instance and discarding the
-- most-specific dict the construction site had correctly built and passed.  DICT-SEMANTICS
-- §3 (assum before inst) + :155-166 (sub-evidence is never pre-baked at the declaration).
-- Keyed by (iface, WHOLE argument vector) so it is neither iface-blind nor
-- structure-blind, and matched by `monoVecSameGiven` — pointwise `monoSameGiven`,
-- structural, on rigid-tyvar IDENTITY, never unification.
--
-- 🚨 #1956 / #1937: THE KEY IS THE VECTOR, NOT THE LEAD ARGUMENT.  This arm used to
-- match `[subject]` and return `()` for any longer vector, so a MULTI-PARAMETER
-- declared context (`f : Conv (Wrap a) b => …`) had no consumption-side answer at all:
-- `entailAssum` could never see it, `entail` fell through to `entailInst`, and the body
-- was statically committed to whichever impl was most specific at ABSTRACTION time while
-- the caller's correctly-built dict went unread — so `f (Wrap 5) True` and `f (Wrap 'c')
-- 7` both took the SAME impl, and swapping the two `impl` blocks changed which one, at
-- exit 0 (DICT-SEMANTICS §3 forbids selection by declaration order outright).
-- ⚠️ THE ANSWER TO "when are two predicate argument vectors the same predicate?" IS
-- POINTWISE STRUCTURAL IDENTITY OVER THE VECTOR: equal length, and `monoSameGiven` at
-- every position, in order.  `goalMatchesGiven`/`goalSlotStillOpen` follow this shape
-- exactly, and must keep following it — see their own headers.
--
-- §6.1.3's rigid commit is preserved TWICE OVER, and the guard below is the load-bearing
-- one: `requires S a` is a bare-tyvar given, so it never reaches this registry at all, and
-- the body's goal `S (List a)` finds no assumption ⇒ `inst` fires on the rigid goal ⇒ the
-- general instance ⇒ 2, unchanged.  Even had it been registered, `monoSameGiven` compares
-- structurally and would not match subject `a` against goal `List a` — only unification
-- would, and this is deliberately not unification.  Pinned by
-- test/build_diff_fixtures/impl_requires_structured_rigid_control.mdk.
--
-- ⚠️ STRUCTURED vectors ONLY (the `allList monoIsBareTyvar` guard — a vector EVERY one of
-- whose positions is a bare tyvar registers nothing) — a MINIMALITY guard, kept because
-- the all-bare case buys nothing and costs surface, not because a gate caught it.  A
-- bare-tyvar
-- given (`requires S a`) is already answered by `activeDictVars`, which `entailAssum`
-- consults FIRST, so registering it here could only ever produce a second answer to an
-- already-answered goal.  It would also opt that goal into this registry's one sharp edge:
-- `monoSameGiven` compares TVar to TVar by ID, and ids here are not unique forever — see
-- the G4 note at `currentImplBody` ("an operand could normalize to an unsolved tyvar whose
-- id collides with a stale activeDictVars entry left by a previously-inferred impl"), which
-- `activeDictVarOf` is scope-gated against by the `inImpl` flag and this lookup is not.
-- A STRUCTURED subject is matched head-first down a TCon spine, so it answers only a goal
-- of the same shape at the same interface, and the id comparison is reached only after that
-- shape already agrees.
--
-- ⚠️ #1956 WIDENS THAT SHARP EDGE TO MORE POSITIONS, and does not introduce a new one.
-- A vector like `[Wrap a, b]` is admitted because SOME position is structured, but its
-- SECOND position is a bare tyvar matched by raw id — the same `TVar`/`TVar` arm of
-- `monoSameGiven`, one position over.  The structured position still gates the whole
-- match (all positions must agree, so a stale-id coincidence at a bare position can only
-- matter for a goal that already agrees structurally elsewhere at the same interface),
-- which is why this is a widening of an existing hazard rather than a new one.  Removing
-- it is the same scoped-projection question `activeDictVarOf`'s `inImpl` gate answers,
-- and belongs with the key-side work (#1904), not here.
registerPredGiven : String -> List Mono -> String -> Unit
registerPredGiven _ [] _ = ()
registerPredGiven iface args dname
  | allList monoIsBareTyvar args = ()
  | otherwise = perRun.value.activeDictPreds := (iface, args, dname)::perRun.value.activeDictPreds.value

-- True iff [m] normalizes to a bare type VARIABLE (the given shape `activeDictVars`
-- already covers). `TApp`/`TCon`/`TFun` are the STRUCTURED shapes it cannot see.
monoIsBareTyvar : Mono -> Bool
monoIsBareTyvar m = match normalize m
  TVar _ => True
  _ => False

-- structural equality of two monos that may contain RIGID tyvars, compared by tyvar
-- IDENTITY.  Deliberately NOT unification: a given must match a goal only when it IS
-- that goal, never by binding the given's variables.  (This used to contrast itself
-- against a var-free same-shape helper; that helper existed only to serve the
-- swapped-argument hint and was deleted with it — issue 1147.)
monoSameGiven : Mono -> Mono -> Bool
monoSameGiven a b = match normalize a
  TVar c1 => match normalize b
    TVar c2 => tyvarId c1 == tyvarId c2
    _ => False
  -- #1111 A-2.10 on the `TCon`/`TCon` pairing (`sameTyConHead`): an in-scope
  -- dict given for `C a.T` no longer answers a goal `C b.T`.  ⚠️ Cross-population
  -- pairs left name-only and NOT SEPARATELY PROBED — armed because the pre-split
  -- arm answered them (`__tupleN__`; see `Mono.TRigid`), and a rigid carries no
  -- origin, so routing them through `sameTyConHead` would answer the same.
  TCon x ox => match normalize b
    TCon y oy => sameTyConHead x ox y oy
    TRigid y => x == y
    _ => False
  TRigid x => match normalize b
    TRigid y => x == y
    TCon y _ => x == y
    _ => False
  TApp a1 b1 => match normalize b
    TApp a2 b2 => monoSameGiven a1 a2 && monoSameGiven b1 b2
    _ => False
  TFun a1 _ b1 => match normalize b
    TFun a2 _ b2 => monoSameGiven a1 a2 && monoSameGiven b1 b2
    _ => False
  _ => False

-- #1956: THE ANSWER TO "when are two predicate argument vectors the same predicate?" —
-- POINTWISE STRUCTURAL IDENTITY: equal length, and `monoSameGiven` at every position, in
-- order.  Deliberately NOT unification and deliberately NOT lead-argument-only: the first
-- would let a given bind the goal's variables (the whole reason `monoSameGiven` exists),
-- the second is #1956 itself.  Length is compared by the pattern arms, not by `listLen`,
-- so a prefix can never pass for the whole vector.
monoVecSameGiven : List Mono -> List Mono -> Bool
monoVecSameGiven [] [] = True
monoVecSameGiven (a::arest) (b::brest) = monoSameGiven a b
  && monoVecSameGiven arest brest
monoVecSameGiven _ _ = False

-- assum lookup over the predicate-keyed givens: the in-scope dict param holding evidence
-- for `iface subject`.  PREFERS the entry owned by the enclosing method [encl] (`$dict_
-- <encl>_<slot>`) for exactly the reason `activeDictVarForEncl` does: registerImplRequires
-- registers every method of an impl against the SAME given, so a global first-match would
-- return whichever method registered LAST — a dict param out of scope in this body.
activeDictPredOf : String -> List Mono -> String -> Option String
activeDictPredOf iface goalArgs encl =
  let preds = perRun.value.activeDictPreds.value
  match firstPredForEncl iface goalArgs "$dict_\{encl}_" preds
    Some dname => Some dname
    None => firstPredForEncl iface goalArgs "" preds

firstPredForEncl : String -> List Mono -> String -> List (String, List Mono, String) -> Option String
firstPredForEncl _ _ _ [] = None
firstPredForEncl iface goalArgs pfx ((eiface, eargs, ename)::rest)
  | eiface == iface && startsWith pfx ename && monoVecSameGiven eargs goalArgs = Some ename
  | otherwise = firstPredForEncl iface goalArgs pfx rest

-- the interface a method NAME belongs to, for the predicate-keyed assum lookup.  A
-- non-method [name] (a top-level constrained call routed through EKNestedTop) is absent
-- from methodIfaceParamsRef → None → no predicate route, tyvar-keyed behaviour unchanged.
ifaceOfMethodName : String -> Option String
ifaceOfMethodName name = map
  ((iface, _, _, _) => iface.irName)
  (omLookup name perRun.value.methodIfaceParamsRef.value)

registerEachActive : List Int -> String -> Unit
registerEachActive [] _ = ()
registerEachActive (id::rest) dname =
  perRun.value.activeDictVars := (id, dname)::perRun.value.activeDictVars.value
  registerEachActive rest dname

-- the tyvar ids in a (normalized) mono — single var for a bare constraint arg
monoTyvarIds : Mono -> List Int
monoTyvarIds m = match normalize m
  TVar cell => [tyvarId cell]
  TApp a b => monoTyvarIds a ++ monoTyvarIds b
  TFun a _ b => monoTyvarIds a ++ monoTyvarIds b
  _ => []

-- extern declarations become top-level schemes (like interface methods)
--
-- 🚨 #1280: THE STAMPING WALK IS PART OF THIS FUNCTION, NOT OF ITS CALLERS, AND
-- THAT IS THE FIX.  Every other tree that reaches typecheck has already been
-- through `stampTyOrigins` at a driver (`stampGraphTyOrigins` on the module arm,
-- `stampFlatTyOrigins` inside `checkProgramSeededSplit` on the flat one).
-- `runtimeDecls` was the one tree that reached a `Scheme` without ever entering
-- that walk on EITHER arm, so every `Mono` `fromAstTypeE` built out of an extern's
-- declared type carried `OriginUnresolved` — the SUPPLY half of the dispatch-key
-- blocker recorded at `dispHeadTab`, and the absent head #1279 bridges two
-- distinct identities through.
--
-- The scope is a parameter and not a `List Decl` prelude on purpose: two
-- `List Decl` arguments are positionally interchangeable and `stampTyHead`'s
-- immunity rule makes a wrong first stamp PERMANENT (`stampFlatTyOrigins`'
-- comment in `frontend/resolve.mdk` records that hazard costing a defect once
-- already).  Build it with `externTyOriginScope`, which owns the derivation of
-- WHY one scope is right for this population on both arms.
--
-- ⚠️ `externTyOriginScope []` at a call site is not a shrug: it is the same
-- "prelude boundary unknown" answer `checkProgramSeededSplit` gives when its
-- `coreProg0` is `[]` — those callers have already FLATTENED the prelude into the
-- program they check, so the prelude's own `Option`/`Ordering`/`Result`
-- declarations are unstamped on that path too and the two sides stay symmetric.
-- The builtin layer is still supplied there, so it is strictly more identity than
-- before, never a claim the driver cannot justify.
--
-- 🚨 FILTER BEFORE STAMPING, AND THAT ORDER IS PERFORMANCE, NOT STYLE.  The first
-- cut here was `externSchemesGo (stampTyOrigins scope decls)`, which is a no-op
-- difference for `runtimeDecls` (every element IS a `DExtern`) and wrong-shaped at
-- the `checkBodyImpl` call site, where `decls` is the WHOLE MODULE.  Read the
-- chain rather than take this on trust: `stampTyOrigins` is `map
-- (stampDeclTyOrigins scope)`, and `stampDeclTyOrigins` is `mapOriginsInDecl`,
-- i.e. a full `mapTyInDecl` REBUILD of the decl — so that shape reconstructs every
-- declaration in the program and then discards all but the externs, in a stage
-- `compiler/AGENTS.md` calls GC-bound.  Filtering first makes the walk
-- proportional to the externs, which is all this function reads.
--
-- ⚠️ THE MECHANISM ABOVE IS READ OFF THE SOURCE; THE MAGNITUDE WAS NOT MEASURED.
-- No before/after allocation number was taken, so this is a shape argument, not a
-- perf result — do not cite it as one.  It needs no number to be the right shape:
-- rebuilding what you are about to throw away is never the cheaper branch.
externSchemes : OrdMap TyConOrigin -> List Decl -> List (String, Scheme)
externSchemes scope decls =
  externSchemesGo (stampTyOrigins scope (externDecls decls))

-- The `DExtern` sublist, in order.  Its own clause rather than a `filter` with a
-- lambda predicate: `Decl` has no cheap "is an extern" projection, so the pattern
-- match IS the predicate.
externDecls : List Decl -> List Decl
externDecls [] = []
externDecls ((d@(DExtern _ _ _))::rest) = d :: externDecls rest
externDecls (_::rest) = externDecls rest

-- The pre-#1280 body, unchanged, over the ALREADY-STAMPED list.  It is split out
-- rather than folded into the clause above so that the recursion cannot re-enter
-- the stamping walk on its own tail — the shape that turns a one-pass `map` into a
-- quadratic, which is the defect class `compiler/AGENTS.md` opens with.
externSchemesGo : List Decl -> List (String, Scheme)
externSchemesGo [] = []
externSchemesGo ((DExtern _ n ty)::rest) =
  (n, sigToScheme ty) :: externSchemesGo rest
externSchemesGo (_::rest) = externSchemesGo rest

-- interface method schemes: each method's declared type, free tyvars (incl. the
-- interface param) quantified — the bare scheme the === TYPES === output shows
-- (the typeclass constraint itself is never rendered).  Impl bodies add no
-- top-level bindings, so DImpl needs no output here.
ifaceMethodSchemes : List Decl -> List (String, Scheme)
ifaceMethodSchemes [] = []
ifaceMethodSchemes (d::rest) = declIfaceMethods d ++ ifaceMethodSchemes rest

declIfaceMethods : Decl -> List (String, Scheme)
declIfaceMethods (DInterface { name, typarams, methods, ... }) =
  methodSchemes (declGradedScope typarams methods) typarams methods
declIfaceMethods _ = []

-- #1351 L1 (EXPAND): the IDENTITY-CARRYING sibling of `ifaceMethodSchemes` above.
--
-- 🚨 WHY THIS IS A KEY-ONLY WALK AND NOT A SECOND `ifaceMethodSchemes` CALL.  A second
-- call would NOT be observationally neutral: `methodSchemes` mints tyvar ids through
-- `sigToSchemeTvsIn` (off `PerRun.tyvarCounter`) AND registers method-level constraints
-- into `methodConstraintsRef`.  Re-obtaining the same schemes under a richer key that way
-- would shift every downstream tyvar id — an observable change, which L1 (a pure-addition
-- leaf) may not make.  `methodSchemesPure` is no escape: it drops the registration but
-- still mints ids.  So this walk produces ONLY the keys, and `zipIfaceMethodSchemeIds`
-- pairs them against the single, existing scheme list.
--
-- The pairing is positional, so the two walks must stay arm-for-arm identical.  Note in
-- particular that `declIfaceMethods` does NOT unwrap `DAttrib` (an attributed interface
-- contributes no schemes) and neither does `declIfaceMethodIds` — that asymmetry against
-- `argDispatchOfDeclById`, which DOES unwrap it, is inherited from the functions being
-- mirrored, not a slip.
--
-- ⚠️ NOTHING READS THE RESULT YET — it is the substrate leaf L2 migrates `pickSchemes`
-- onto.  Written-only by design; see the matching note on `argDispatchIndicesById`.
ifaceMethodSchemeIds : List Decl -> List (IfaceRef, String)
ifaceMethodSchemeIds [] = []
ifaceMethodSchemeIds (d::rest) = declIfaceMethodIds d
  ++ ifaceMethodSchemeIds rest

declIfaceMethodIds : Decl -> List (IfaceRef, String)
declIfaceMethodIds (DInterface { name, methods, ifaceOrigin, ... }) = map
  (ifaceMethodIdRow IfaceRef { irName = name, irOrigin = ifaceOrigin })
  methods
declIfaceMethodIds _ = []

ifaceMethodIdRow : IfaceRef -> IfaceMethod -> (IfaceRef, String)
ifaceMethodIdRow iface (IfaceMethod mname _ _) = (iface, mname)

-- Pair `ifaceMethodSchemeIds`' keys against `ifaceMethodSchemes`' own output,
-- positionally: the two walks visit the same decls in the same order and emit exactly one
-- row per `IfaceMethod` of every `DInterface`, so row i of one is row i of the other.
-- Ragged input truncates rather than raising — this is written-only substrate, and a
-- length disagreement must not be able to fail a build that is otherwise fine.  L2, the
-- first reader, is where such a mismatch becomes a graded fact.
zipIfaceMethodSchemeIds : List (IfaceRef, String) -> List (String, Scheme) -> List ((IfaceRef, String), Scheme)
zipIfaceMethodSchemeIds [] _ = []
zipIfaceMethodSchemeIds _ [] = []
zipIfaceMethodSchemeIds (k::ks) ((_, s)::ss) =
  (k, s) :: zipIfaceMethodSchemeIds ks ss

-- Error-path B4: register each interface method → (iface, typarams, declared Ty)
-- so checkImplObligations can recover its dispatch (iface-param) types at a call
-- site.  Built from the SAME prog the impl lookup uses, so an interface absent
-- from prog (e.g. a prelude method in the no-prelude path) is never checked.
registerMethodIfaceParamsAll : List Decl -> Unit
registerMethodIfaceParamsAll [] = ()
registerMethodIfaceParamsAll (d::rest) =
  let _ = registerMethodIfaceParamsDecl d
  registerMethodIfaceParamsAll rest

registerMethodIfaceParamsDecl : Decl -> Unit
registerMethodIfaceParamsDecl (DAttrib _ d) = registerMethodIfaceParamsDecl d
registerMethodIfaceParamsDecl (DInterface { name, typarams, methods, ifaceOrigin, ... }) = registerMethodIfaceParamsMethods IfaceRef { irName = name, irOrigin = ifaceOrigin } typarams (declGradedScope typarams methods) methods
registerMethodIfaceParamsDecl _ = ()

-- #822: [scope] — this interface's graded typarams, computed ONCE from THIS declaration
-- (declGradedScope, union over all its methods) and stored in the same entry as
-- (typarams, mty).
--
-- ⚠️ That co-location is the whole point, and it is why #822 does NOT add a table of its
-- own.  The scope's ONLY job is to elaborate the `mty` it accompanies, so the invariant
-- that matters is not "the scope has a collision-proof key" — it is "the scope is never
-- resolved differently from the mty it elaborates".  Keying it independently (by
-- interface name, or by method name in a parallel map) is exactly what could break that.
-- Storing them as one value makes disagreement unrepresentable.
-- This entry is method-NAME-keyed last-write-wins, an exposure it already had and which
-- `ifaceMethodTyResolved` already guards by comparing the stored iface; a graded scope
-- inherits that guard rather than adding a second, differently-wrong lookup.  The
-- underlying bare-name interface identity is #1047's territory, upstream of #822.
registerMethodIfaceParamsMethods : IfaceRef -> List String -> List (String, List Kind) -> List IfaceMethod -> Unit
registerMethodIfaceParamsMethods _ _ _ [] = ()
registerMethodIfaceParamsMethods iface typarams scope ((IfaceMethod mname mty _)::rest) =
  perRun.value.methodIfaceParamsRef := omInsert mname (iface, typarams, mty, scope) perRun.value.methodIfaceParamsRef.value
  perRun.value.registeredIfacesRef := omInsert iface.irName () perRun.value.registeredIfacesRef.value
  registerMethodIfaceParamsMethods iface typarams scope rest

-- build each method's scheme AND register its method-level constraints (foldMap's
-- `Monoid m`) into methodConstraintsRef, keyed by the scheme's own quantified ids
-- (from the same tvs map), so a call-site instantiation can route the dict.
methodSchemes : List (String, List Kind) -> List String -> List IfaceMethod -> List (String, Scheme)
methodSchemes _ _ [] = []
methodSchemes scope typarams ((IfaceMethod mname mty _)::rest) =
  let st = sigToSchemeTvsIn scope mty
  let _ = registerMethodConstraints typarams mname mty (snd st) (schemeIds (fst st))
  (mname, fst st) :: methodSchemes scope typarams rest

-- like methodSchemes but WITHOUT the registerMethodConstraints side effect — for
-- callers (inferOneIfaceDefaults) that only need the schemes to look up a method's
-- own type and must not double-register methodConstraintsRef entries (those are
-- registered once during ifaceMethodSchemes at env setup).
methodSchemesPure : List (String, List Kind) -> List IfaceMethod -> List (String, Scheme)
methodSchemesPure _ [] = []
methodSchemesPure scope ((IfaceMethod mname mty _)::rest) =
  (mname, fst (sigToSchemeTvsIn scope mty)) :: methodSchemesPure scope rest

-- the method-level-constraint slot ids of [mname]: one id per `=>` constraint over
-- a non-interface-param tyvar, looked up in the scheme's tvs map.  Registered only
-- when non-empty (so methodConstraintsRef holds only genuinely-constrained methods).
registerMethodConstraints : List String -> String -> Ty -> List (String, Mono) -> List Int -> Unit
registerMethodConstraints typarams mname mty tvs fullIds =
  let ids = methodConstraintSlotIds typarams mty tvs
  if isEmptyL ids || hasAssocSL2 mname perRun.value.methodConstraintsRef.value then
    ()
  else
    setMethodConstraintEntry mname fullIds ids

-- #994 (B-3-c): THE write op for the method-constraint table pair — the sole site that
-- writes both.  The positions entry is DERIVED inside the op from the same [ids] list the
-- op stores, so the two tables cannot be given different lengths or a different slot
-- order; previously the caller held one list and mapped it into the second table itself,
-- which is the same convention `funConstraintsRef`/`funConstraintIfacesRef` carried.
--
-- ⚠️ Deliberately NOT a single record-valued table.  `methodConstraintsRef` also has
-- ids-ONLY writers (the cross-module reseeds at `checkModuleFullImpl` / `scopeMethodArities`),
-- and positions-ABSENCE selects a fallback arm in `alignedMethodConstraintIds` — so a fused
-- table would need `Option` positions, and a non-optional field would change WHICH ARM RUNS,
-- not merely invent data.  Keeping the tables separate keeps absence representable by there
-- being no positions entry at all.
setMethodConstraintEntry : String -> List Int -> List Int -> Unit
setMethodConstraintEntry mname fullIds ids =
  perRun.value.methodConstraintsRef := (mname, ids)::perRun.value.methodConstraintsRef.value
  perRun.value.methodConstraintPositionsRef := (mname, map (id => indexOfInt id fullIds) ids)::perRun.value.methodConstraintPositionsRef.value

-- index of [x] in [xs] (0-based; -1 if absent — absent shouldn't happen, slot ids
-- are always quantified ids of the same scheme).
indexOfInt : Int -> List Int -> Int
indexOfInt x xs = indexOfIntGo x xs 0
indexOfIntGo : Int -> List Int -> Int -> Int
indexOfIntGo _ [] _ = 0 - 1
indexOfIntGo x (y::ys) i = if x == y then i else indexOfIntGo x ys (i + 1)
-- DRIVER-COLLAPSE Phase 2: skip when [mname] is ALREADY registered in THIS pass.
-- The ids must be the SAME quantified ids the call-site instantiation maps through
-- its subst (see methodConstraintsRef doc).  The module path's checkModuleFullImpl
-- can call ifaceMethodSchemes more than once per pass (env setup + impl/default body
-- inference re-resolving schemes), and a SECOND registration prepends DIFFERENT
-- freshly-instantiated ids → lookupAssocSL2 (first-match) returns the stale ids →
-- constraintMonosOf drops them → empty method-dict route (method_constraint_impl_offset:
-- methodN=0).  Keeping the FIRST (env-setup) registration — whose scheme is the one
-- lookupVar returns at call sites — restores the flat path's single-registration
-- invariant.  resetState clears methodConstraintsRef between modules, so this only
-- de-dups WITHIN a pass.

hasAssocSL2 : String -> List (String, List Int) -> Bool
hasAssocSL2 n xs = match lookupAssocSL2 n xs
  Some _ => True
  None => False

methodConstraintSlotIds : List String -> Ty -> List (String, Mono) -> List Int
methodConstraintSlotIds typarams (TyConstrained cs t) tvs = flatMap (constraintSlotId typarams tvs) cs
  ++ methodConstraintSlotIds typarams t tvs
methodConstraintSlotIds typarams (TyEffect _ _ t) tvs =
  methodConstraintSlotIds typarams t tvs
methodConstraintSlotIds _ _ _ = []

-- one slot per method-level constraint: the id of its first non-interface-param
-- tyvar (the dispatch var the supplied dict narrows by).  A constraint over only
-- interface params contributes no slot (it dispatches via the impl, not a dict).
constraintSlotId : List String -> List (String, Mono) -> Constraint -> List Int
constraintSlotId typarams tvs c = match constraintNonParamVars typarams c
  [] => []
  n::_ => match lookupAssoc n tvs
    Some m => [monoTyvarId m]
    None => []

sigsOf : List Decl -> List (String, Ty)
sigsOf [] = []
sigsOf ((DTypeSig _ n ty)::rest) = (n, ty) :: sigsOf rest
sigsOf (_::rest) = sigsOf rest

-- all free variable references in an expr (for the dependency graph); over-
-- approximate (includes bound vars), filtered to top-level group names by caller
allEVars : Expr -> List String
allEVars (EVar x) = [x]
allEVars (EVarId x _) = [x]
allEVars (EMethodAt n _ _ _) = [n]
allEVars (EDictAt n _) = [n]
allEVars (ELit _) = []
allEVars (EApp f x) = allEVars f ++ allEVars x
allEVars (ELam _ b) = allEVars b
allEVars (ELet _ _ _ e1 e2) = allEVars e1 ++ allEVars e2
allEVars (ELetGroup binds body) = flatMap letBindEVars binds ++ allEVars body
allEVars (EMatch e arms) = allEVars e ++ flatMap armEVars arms
allEVars (EIf c t e) = allEVars c ++ allEVars t ++ allEVars e
allEVars (EBinOp _ l r _) = allEVars l ++ allEVars r
allEVars (EUnOp _ e _) = allEVars e
allEVars (EInfix op l r) = op :: allEVars l ++ allEVars r
allEVars (EFieldAccess e _ _) = allEVars e
allEVars (ETuple es) = flatMap allEVars es
allEVars (EListLit es) = flatMap allEVars es
allEVars (EArrayLit es) = flatMap allEVars es
allEVars (ERangeList a b _) = allEVars a ++ allEVars b
allEVars (ERangeArray a b _) = allEVars a ++ allEVars b
allEVars (ESlice e a b _ _) = allEVars e ++ allEVars a ++ allEVars b
allEVars (EIndex e i _) = allEVars e ++ allEVars i
allEVars (EAnnot e _) = allEVars e
allEVars (EBlock stmts) = flatMap doStmtEVars stmts
allEVars (ERecordCreate _ fs) = flatMap fieldAssignEVars fs
allEVars (ERecordUpdate e fs _) = allEVars e ++ flatMap fieldAssignEVars fs
allEVars (EVariantUpdate _ e fs) = allEVars e ++ flatMap fieldAssignEVars fs
allEVars (ELoc _ e) = allEVars e
allEVars (EDoOrigin _ e) = allEVars e
allEVars _ = []

letBindEVars : LetBind -> List String
letBindEVars (LetBind _ clauses) = flatMap funClauseEVars clauses

funClauseEVars : FunClause -> List String
funClauseEVars (FunClause _ body) = allEVars body

armEVars : Arm -> List String
armEVars (Arm _ guards body) = flatMap guardEVars guards ++ allEVars body

guardEVars : Guard -> List String
guardEVars (GBool e) = allEVars e
guardEVars (GBind _ e) = allEVars e

doStmtEVars : DoStmt -> List String
doStmtEVars (DoExpr e) = allEVars e
doStmtEVars (DoLet _ _ _ e) = allEVars e
doStmtEVars (DoBind _ e) = allEVars e
doStmtEVars (DoAssign _ e) = allEVars e
doStmtEVars (DoFieldAssign _ _ e) = allEVars e

fieldAssignEVars : FieldAssign -> List String
fieldAssignEVars (FieldAssign _ e) = allEVars e

-- builtin constructors available without the prelude (mirrors initial_env)
initialEnv : TcEnv
initialEnv =
  TcEnv
    omEmpty
    (omInsert
      "True"
      (monoScheme (tconBuiltin "Bool"))
      (omInsert "False" (monoScheme (tconBuiltin "Bool")) omEmpty))
    []
    omEmpty

registerAllData : TcEnv -> List Decl -> TcEnv
registerAllData env [] = env
registerAllData env (d::rest) = registerAllData (registerData env d) rest

-- ── dependency-ordered, SCC-merged letrec processing ──────────────────────
-- The prelude has forward references and mutual recursion throughout, so groups
-- must be type-checked in dependency order (a callee generalized before its
-- callers instantiate it polymorphically) with mutually-recursive cycles merged
-- into one letrec group (generalized together).  Mirrors the reference's
-- order_groups_by_deps + process_letrec_group (Phase 136).

-- ── Tarjan strongly-connected components (O(V+E)) ─────────────────────────
-- Replaces the former all-pairs-reachability + mutual-reachability SCC + topo
-- sort, which was O(n^3) in a module's top-level binding count and dominated
-- the multi-module typecheck (check_modules).  Emits SCCs in dependency-first
-- order (a "sink" component — no outside dependencies — finishes and is emitted
-- first), exactly what processSCCs needs.  State is held in module-level refs,
-- reset at the start of each run (processTopGroups runs sequentially per module).

depGraphMap : List String -> OrdMap (List (List Pat, Expr)) -> OrdMap (List String)
depGraphMap names grouped =
  buildAdj names (namesToSet names omEmpty) grouped omEmpty

-- name-membership set, built ONCE, so `keepGroupNames` is O(log n)/ref instead of
-- O(names)/ref (the dep-graph build was O(names²·refs)). Output-order-preserving:
-- `keepGroupNames`'s `filterList` is unchanged, only its membership test is faster.
namesToSet : List String -> OrdMap Unit -> OrdMap Unit
namesToSet [] m = m
namesToSet (n::rest) m = namesToSet rest (omInsert n () m)

-- defs grouped by name ONCE (name -> its clauses, in defs order), so `depsOf`
-- does an O(log n) lookup instead of re-scanning all defs per name (was
-- O(names·defs)). Built by prepend (O(1)); `clausesOf` reverses on read to
-- restore defs order — so the per-name clause list is identical to the old
-- `clausesFor name defs`, keeping dep lists / SCC order / output byte-identical.
groupClauses : List (String, (List Pat, Expr)) -> OrdMap (List (List Pat, Expr))
groupClauses defs = groupClausesGo defs omEmpty
groupClausesGo : List (String, (List Pat, Expr)) -> OrdMap (List (List Pat, Expr)) -> OrdMap (List (List Pat, Expr))
groupClausesGo [] m = m
groupClausesGo ((n, c)::rest) m =
  groupClausesGo rest (omInsert n (c :: clausesAt n m) m)

clausesAt : String -> OrdMap (List (List Pat, Expr)) -> List (List Pat, Expr)
clausesAt n m = match omLookup n m
  Some xs => xs
  None => []

clausesOf : String -> OrdMap (List (List Pat, Expr)) -> List (List Pat, Expr)
clausesOf n m = revClauses (clausesAt n m) []

revClauses : List (List Pat, Expr) -> List (List Pat, Expr) -> List (List Pat, Expr)
revClauses [] acc = acc
revClauses (x::xs) acc = revClauses xs (x::acc)

buildAdj : List String -> OrdMap Unit -> OrdMap (List (List Pat, Expr)) -> OrdMap (List String) -> OrdMap (List String)
buildAdj [] _ _ m = m
buildAdj (n::rest) nameSet cbn m =
  buildAdj rest nameSet cbn (omInsert n (depsOf n nameSet cbn) m)

-- sig-name presence set (which top-level names carry a type signature), set once
-- per module in `processTopGroups` so `memberPeelSource`/`memberSigIsFun` do an
-- O(log n) presence check instead of an O(sigs) `lookupAssoc` scan per SCC member
-- (was O(members·sigs) over the whole compiler). Module-level ref, matching the
-- `currentFn`/`curEffect` idiom; processing is sequential per module.

sigNamesToSet : List (String, Ty) -> OrdMap Unit -> OrdMap Unit
sigNamesToSet [] m = m
sigNamesToSet ((n, _)::rest) m = sigNamesToSet rest (omInsert n () m)

-- PERF: name → declared signature, the same `sigs` assoc list as an index.  Three
-- sites (preunifySigsEx, checkEffectEscape, checkSigConstraintOne) did
-- `lookupAssoc m sigs` — an O(N) scan of EVERY top-level signature, run per member
-- of every group, so O(N²) over a large file.  Companion to `sigNameSetRef`, seeded
-- from the same `sigs` in processTopGroups.
--
-- Built from the REVERSED list: `omFromPairs` is last-write-wins, while the
-- `lookupAssoc` it replaces was first-match-wins, so reversing preserves which
-- signature a duplicated name resolves to.

processTopGroups : TcEnv -> List (String, Ty) -> List (String, (List Pat, Expr)) -> List String -> List (String, Scheme)
processTopGroups env sigs defs names =
  driverState.value.sigNameSetRef := sigNamesToSet sigs omEmpty
  driverState.value.sigTyMapRef := omFromPairs (reverseL sigs) omEmpty
  let grouped = groupClauses defs
  let ordered = tarjanSCCs names (depGraphMap names grouped)
  processSCCs env sigs grouped ordered

-- per-name dependencies: the other top-level names a binding's bodies reference
-- (a conservative over-approximation via all free EVars is fine — only names
-- that are themselves groups matter).  Consumed by depGraphMap → Tarjan.
depsOf : String -> OrdMap Unit -> OrdMap (List (List Pat, Expr)) -> List String
depsOf name nameSet cbn =
  filterNonSelf
    name
    (keepGroupNames nameSet (dedup (groupRefs (clausesOf name cbn))))

groupRefs : List (List Pat, Expr) -> List String
groupRefs clauses = flatMap clauseRefs clauses

clauseRefs : (List Pat, Expr) -> List String
clauseRefs (_, body) = allEVars body

keepGroupNames : OrdMap Unit -> List String -> List String
keepGroupNames nameSet refs = filterList (r => omHasKey r nameSet) refs

filterNonSelf : String -> List String -> List String
filterNonSelf name xs = filterList (/= name) xs

-- process each SCC as a letrec group in topological order
processSCCs : TcEnv -> List (String, Ty) -> OrdMap (List (List Pat, Expr)) -> List (List String) -> List (String, Scheme)
processSCCs _ _ _ [] = []
processSCCs env sigs grouped (scc::rest) =
  let er = processSCC env sigs grouped scc
  snd er ++ processSCCs (fst er) sigs grouped rest

-- #23 support: synthesize impl-obligation-shaped Num entries from a group's
-- pendingCallObligations / pendingDictApps deltas.  The Num constraint of an
-- ambiguous var reaching a group ONLY through a constrained-callee instantiation
-- (`main = println (app2 (==))`) is recorded on those refs, never on
-- pendingImplObligations, so the group-level Num defaulting (defaultGroupNum /
-- groundNumVars, which both reads candidate ids AND finds the live var to ground
-- from impl-shaped entries) never saw it — leaving an ungrounded var whose Num dict
-- route resolves RNone → a NULL dict word → build-time SIGTRAP (run is correct).
-- Only field 0 (iface) and field 3 (the live operand mono) are read downstream;
-- the rest mirror inferNumLitBare's placeholder shape.
-- Num is 1-param, so its obligation vector is a singleton; a wider predicate can
-- never be "Num" and is filtered out anyway.
numCallObls : List (IfaceRef, List Mono, Option Loc) -> List UObligation
numCallObls [] = []
numCallObls ((iface, monos, loc)::rest) = match (iface.irName, monos)
  ("Num", [mono]) => mkMethodOccObl (builtinIfaceRef BNum) ["a"] (TyVar "a") mono PNumLit loc :: numCallObls rest
  _ => numCallObls rest

numDictObls : List (Ref (List Route), List Mono, List String, List (List Mono), Option Loc) -> List UObligation
-- #1155: the loc comes from the ENTRY's own snapshot, not from the ambient
-- `currentLoc`.  This runs at a generalized group close, well after inference left
-- the call site, so `currentLoc` named whichever ELoc happened to be entered last.
-- Behaviour-neutral by inspection rather than by hope: these synthetic entries feed
-- ONLY the Num-defaulting search (`defaultGroupNum`/`defaultEachMember` →
-- `numConstrainedIds`/`groundNumVars` → `numObligIds`/`liveNumVarGo`), and every one
-- of those readers destructures the 5th element as `_`.  Nothing renders it today;
-- the point is that the tuple stops carrying a span it knows to be wrong.
numDictObls [] = []
numDictObls ((_, monos, ifaces, _, loc)::rest) = flatMap (p => if fst p == "Num" then [mkMethodOccObl (builtinIfaceRef BNum) ["a"] (TyVar "a") (snd p) PNumLit loc] else []) (zipL ifaces monos)
  ++ numDictObls rest

-- #23 (two-hop forward): the impl-obligation-shaped entries for EVERY iface (not
-- just Num) a group's constrained-callee instantiations recorded on the call/dict
-- deltas.  Unlike numCallObls/numDictObls (which feed only Num-defaulting), these
-- feed registerSchemeObligations so a constraint FORWARDED from a constrained callee
-- (`useApp g = app2 g`, whose Num lives on the call/dict deltas, never on
-- pendingImplObligations) is recorded in schemeObligationsRef — so a caller of the
-- forwarder (`main = println (useApp (==))`) re-instantiates it (instantiateVarTracked),
-- surfacing the constraint on the caller's own delta where group Num-defaulting can
-- ground the shared ambiguous var.  Without this the forwarded var never grounds on
-- the check path and a downstream Eq/Ord obligation on it is falsely ambiguous.
-- #23 two-hop forward, VECTOR-PRESERVING.  A constraint forwarded from a constrained
-- callee lives on the pendingCallObligations delta, never in addedObls, so a caller of
-- this group must re-instantiate it from schemeObligationsRef.
--
-- This used to detour through a SYNTHETIC addedObls entry (iface, ["a"], TyVar "a",
-- mono, loc) that schemeObligationOne re-read via dispatchMonosOf.  That entry
-- structurally carries ONE Mono, so a joint predicate could not pass through it: it was
-- flat-mapped per ARGUMENT, and because each 1-ary shard lands on a bound tyvar,
-- boundTyvarIds SUCCEEDED and FABRICATED `Ix a` + `Ix i` alongside the real `Ix a i`
-- (one violation reported three times; `(Ix a, Ix a b, Ix b) =>` displayed).
--
-- The detour was pure overhead: dispatchMonosOf ["a"] (TyVar "a") m is an IDENTITY —
-- walkDispatch hits `contains "a" ["a"]` giving [("a", normalize m)], and collectByParam
-- reads it straight back out as [normalize m].  A pendingCallObligations entry ALREADY
-- carries its joint `List Mono`, so map it to bound tyvar ids DIRECTLY and the vector
-- survives at every arity.  Identical at arity 1 (boundTyvarIds normalizes too), and it
-- closes the UNSIGNED forwarding hole, which the declared-context path cannot reach
-- (lookupSigTvMap is None for an unsigned binding).
-- #1549: both scheme-obligation channels now project their entry to a PREDICATE
-- (`callPredOf` / `oblPredOf`) and map it through the ONE `vecOblOfPred` — so the
-- residual reduction §4 `gen` requires cannot be present on one channel and absent
-- from the other (this file's signature failure mode).
forwardedVecObls : List Int -> List (IfaceRef, List Mono, Option Loc) -> List VecObl
forwardedVecObls boundIds callObls =
  flatMap (vecOblOfPred boundIds) (flatMap callPredOf callObls)

-- the (interface, argument-vector) predicate a constrained-callee call-delta entry
-- carries.  An entry whose interface name is unrecoverable contributes nothing: the
-- name is what a VecObl is keyed and displayed by.
callPredOf : (IfaceRef, List Mono, Option Loc) -> List (IfaceRef, List Mono, Option Loc)
callPredOf (iface, monos, loc)
  | iface.irName == "" = []
  | otherwise = [(iface, monos, loc)]

-- FLAT-PATH SHADOW SCOPING (S1): a letrec group whose members are ALL prelude fns is a
-- CORE group — no user standalone is a shadow inside it.  Empty group ⇒ not core (it
-- cannot occur, and "user" is the conservative arm: it preserves the pre-fix behavior).
flatGroupIsCore : List String -> Bool
flatGroupIsCore [] = False
flatGroupIsCore members = allCoreFns members

allCoreFns : List String -> Bool
allCoreFns [] = True
allCoreFns (m::rest)
  | omHasKey m perRun.value.flatCoreFnNamesRef.value = allCoreFns rest
  | otherwise = False

-- FLAT-PATH SHADOW SCOPING (S1): point definerShadowNamesRef at the shadow set that is
-- actually IN SCOPE for the decls about to be inferred — [] inside the prelude, the
-- user's shadows inside the user's module.  Inert (and byte-identical) unless the flat
-- path prepended a prelude; see flatShadowScopingRef.
scopeShadowsForGroup : List String -> Unit
scopeShadowsForGroup members
  | not perRun.value.flatShadowScopingRef.value = ()
  | flatGroupIsCore members = perRun.value.definerShadowNamesRef := []
  | otherwise = perRun.value.definerShadowNamesRef := perRun.value.flatUserShadowNamesRef.value

scopeShadowsCore : Unit -> Unit
scopeShadowsCore _ =
  if perRun.value.flatShadowScopingRef.value then
    perRun.value.definerShadowNamesRef := []
  else
    ()

scopeShadowsUser : Unit -> Unit
scopeShadowsUser _ =
  if perRun.value.flatShadowScopingRef.value then
    perRun.value.definerShadowNamesRef := perRun.value.flatUserShadowNamesRef.value
  else
    ()

-- did the caller prepend a prelude?  (`listLen ds > 0` without walking the list.)
declsNonEmpty : List Decl -> Bool
declsNonEmpty [] = False
declsNonEmpty _ = True

processSCC : TcEnv -> List (String, Ty) -> OrdMap (List (List Pat, Expr)) -> List String -> (TcEnv, List (String, Scheme))
processSCC env sigs grouped members =
  let _ = scopeShadowsForGroup members
  let _ = enterLevel ()
  let oblN0 = wMark perRun.value.implObls
  let callN0 = wMark perRun.value.obls
  let dictN0 = wMark perRun.value.dictApps
  let placeholders = map (m => (m, freshVar ())) members
  let env2 = extendVars env (map placeholderBinding placeholders)
  let (regs, sigTvMaps) = preunifySigsEx sigs placeholders
  -- P0-19 (constrained-receiver arm): publish THIS group's `=>`-constraint vars for
  -- the duration of body inference, so a definer-shadow method occurrence on one of
  -- them (`neq x y = not (eq x y)` under `neq : Eq a => …`) is seen as a DISPATCH and
  -- not monomorphised to the shadowing standalone's declared domain.
  -- `groupConstraintMonosRef` answers a SPELLING question (`dictVarSatisfiesIface`
  -- compares interface NAMES), so U1b (#1482) projects back to the name here rather than
  -- widening a second ref for a reader that would only throw the identity away.
  perRun.value.groupConstraintMonosRef := (flatMap (r => flatMap ifaceMonoName (regIfaceMonosOf r)) regs)
  -- #837: the schemeObligationsRef snapshot/restore window is RETIRED.  It existed
  -- because registerLocalScheme entries were NAME-KEYED and body-scoped: a prelude
  -- where-helper named `g` (core's `find`) leaked obligations onto an unrelated
  -- top-level `g` in a later body (a phantom `Num a =>` on types/numlit_bidir's
  -- signed fn).  Registration/lookup now key by (name, binding-id), so a top-level
  -- `g`'s use keys (g, its-id) and can never match a where-helper `g`'s (g, 0) entry.
  let _ = inferMembers env2 sigs grouped placeholders
  perRun.value.groupConstraintMonosRef := []
  let _ = checkSigsTooGeneral sigTvMaps
  let _ = registerConstraintRegs regs
  let _ = exitLevel ()
  -- PLAN.md #11 (locked §0.2): GROUP-LEVEL + per-binding Num defaulting.  Ground
  -- every ambiguous Num-only var (one not reachable from an ARGUMENT position of
  -- ANY member's type) to Int before this group generalizes.  Covers both a var
  -- that surfaces in a member's type (`n = 1`) and one consumed entirely inside a
  -- body (`n = tag [1,2,3]`, element var in no member type).  An arg-reachable var
  -- (`sum`'s/`inc`'s element var) stays polymorphic.  Scoped to THIS group's newly
  -- added obligations (prepended at the front) so an earlier group's already-
  -- generalized var is never touched.  Mirrors lib/typecheck.ml's
  -- process_letrec_group group-level pass + per-binding default_ambiguous_num.
  let addedObls = wWindow perRun.value.implObls oblN0
  -- #23: also ground an ambiguous Num var that reaches this group ONLY through a
  -- constrained-callee instantiation (its Num obligation lives on the call/dict deltas,
  -- not pendingImplObligations).  See numCallObls/numDictObls.  The synthetic entries
  -- feed ONLY the Num-defaulting search; addedObls alone still drives the
  -- ambiguous-constraint/scheme-obligation registration below.
  let extraNumObls =
        numCallObls (callOblsWindow callN0)
        ++ numDictObls (wWindow perRun.value.dictApps dictN0)
  let defaultObls = addedObls ++ extraNumObls
  let _ = defaultGroupNum defaultObls (map snd placeholders)
  let _ = defaultEachMember defaultObls placeholders
  let _ = registerAmbiguousConstraints addedObls (map snd placeholders)   -- RETPOS soundness
  let schemes = sccSchemes env2 sigs grouped (isLetrecGroup members) placeholders
  -- #23 two-hop forward: also record constraints FORWARDED from a constrained
  -- callee (living on the call delta, never in addedObls) into schemeObligationsRef,
  -- so a caller of this group re-instantiates them and its own group can ground the
  -- shared ambiguous var.
  -- The CALL delta is passed RAW (it already carries each predicate's joint `List
  -- Mono`); registerSchemeObligations maps it with forwardedVecObls so a multi-param
  -- predicate survives whole.  #838 I5: a constrained callee's DICT slot is forwarded
  -- through THIS same call delta — inferDictAtFound records it as a 1-ary PCallSlot
  -- obligation (recordCallObligations, beside pushDictApp), so the old `allDictObls`
  -- re-derivation off the dict delta was a redundant duplicate (deduped away) and is
  -- retired; addedObls now carries only the real pendingImplObligations delta.
  let callOblsDelta = callOblsWindow callN0
  let _ = registerSchemeObligations perRun.value.schemeDefIdsRef.value sigTvMaps callOblsDelta addedObls schemes
  -- SIGNATURE CONSTRAINT SOUNDNESS: a signed member whose body induces an
  -- interface constraint on one of its own quantified vars that its declared `=>`
  -- context (superclass-closed) does NOT cover severs the constraint for callers
  -- → wrong-dictionary dispatch (a silent wrong answer).  Reject at the def-site.
  -- Runs on every path; the census over compiler+stdlib+sqlite was 0 new failures.
  let _ = checkSigConstraintCoverage regs sigs sigTvMaps callOblsDelta addedObls schemes
  let _ = registerInferredConstraints sigs callOblsDelta addedObls schemes
  -- FLAT-PATH SHADOW FIX (facet 1): thread forward only the NON-method-shadowing
  -- schemes, so a method name a user fn shadows keeps resolving to the METHOD
  -- (base env / globalS) for later prelude bindings.  The shadowing scheme is still
  -- RETURNED (second tuple slot) for the scheme dump + final env.
  (extendVars env (dropSchemesNamed perRun.value.methodShadowNamesRef.value schemes), schemes)

-- A multi-member SCC is a mutually-recursive group (always a function group, like
-- the oracle's DLetGroup); a singleton is a plain binding gated on its RHS.  Self-
-- recursive singletons have had their self-edge stripped (filterNonSelf) so they
-- arrive as size-1 SCCs — strict evaluation rules out a self-recursive zero-arg
-- value, so gating them on the RHS is sound and matches the oracle's DFunDef path.
isLetrecGroup : List String -> Bool
isLetrecGroup [] = False
isLetrecGroup [_] = False
isLetrecGroup _ = True

placeholderBinding : (String, Mono) -> (String, Scheme)
placeholderBinding (m, v) = (m, monoScheme v)

-- Extended Pass A: same as preunifySigs but also returns the tyvar maps (for
-- the signature-too-general check after body inference).  Returns a pair:
-- (constraintRegs, sigTvMaps) where sigTvMaps is [(name, sig_ast, tvs)] for
-- each signed member.
-- #1161 (F-3a-ii): each reg is now a TRIPLE — (name, slot-parallel (iface, mono) pairs,
-- slot-parallel predicate argument VECTORS).  The first two components are unchanged;
-- the third is carried alongside, never instead of, so nothing downstream that sizes or
-- orders dict slots can move.
preunifySigsEx : List (String, Ty) -> List (String, Mono) -> (List (String, List (IfaceRef, List Mono), List (List Mono)), List (String, Ty, List (String, Mono)))
preunifySigsEx _ [] = ([], [])
preunifySigsEx sigs ((m, v)::rest) =
  let (restRegs, restTvs) = preunifySigsEx sigs rest
  match omLookup m driverState.value.sigTyMapRef.value
    Some ty =>
      let inst = instantiateSigTracked ty
      let _ = unify v (fst inst)
      let regs = [
        (
          m,
          constraintVarIfaceMonos (sigConstraints ty) (snd inst),
          constraintVarArgMonos (sigConstraints ty) (sigConstraintArgTys ty) (snd inst),
        )
      ]
      (regs ++ restRegs, (m, ty, snd inst)::restTvs)
    None => (restRegs, restTvs)

-- like astTypeFresh but also returns the tyvar-name → fresh-var map
instantiateSigTracked : Ty -> (Mono, List (String, Mono))
instantiateSigTracked ty =
  let tvs = freshTvMap (removeAllS (rowArgNames ty) (tyVarNamesWithConstraints ty))
  let etbl = freshEffMap (dedup (effTailNames ty ++ rowArgNames ty))
  (fromAstTypeE etbl tvs ty, tvs)

-- 🚨 ONE ENTRY PER PREDICATE (S-dict-arity-contract, #1318/B-4) — the (iface, bare
-- tyvar NAMES) pairs of a signature's `=>` constraints, ONE per constraint that has at
-- least one bare type variable ANYWHERE in its argument types, direct or NESTED
-- (`tyVarArgNames`'s `dedup (flatMap tyVarNames tys)` walks into `TyApp`/`TyFun`/`TyTuple`
-- spines, not just top-level `TyVar` arguments — S-structured-predicate-carry). So a
-- STRUCTURED-only constraint (`Tag (Wrap a) =>`, no bare argument, `a` only reachable by
-- descending into `Wrap a`) DOES carry a dict slot now.  Only a constraint whose
-- arguments are entirely ground/closed — no bare type variable anywhere in them, nested
-- or not — carries no dict slot and contributes nothing.
--
-- This list IS the dict-param cardinality of a `=>`-constrained top-level fn: it feeds
-- `registerMemberSlots` → `funConstraintsRef`, which `dictArityOf` (define side) and
-- `inferDictAtFound` (call side) both size from.  It used to emit one entry per bare
-- tyvar ARGUMENT — `Ix a b =>` shattered into TWO dict params for ONE predicate, both
-- routed from the same single-argument goal — so the emitted convention disagreed with
-- the METHOD-level channel (`methodLevelConstraintVarNames`/`constraintFirstNonParam`,
-- one slot per constraint since #818) and with the impl-`requires` channel
-- (`registerReqSlots`, one slot per ENTRY).  All three channels now agree: one dict per
-- predicate.  ⚠️ The names are kept as a LIST, not collapsed to the first one here,
-- because WHICH of them is still an abstract tyvar after body inference is not knowable
-- until `registerMemberSlots` normalizes the instantiated monos — and every abstract one
-- must still reach `activeDictVars`, or a body use dispatching on the predicate's SECOND
-- variable loses its route.
sigConstraints : Ty -> List (IfaceRef, List String)
sigConstraints (TyConstrained cs _) = flatMap constraintTyVars cs
sigConstraints _ = []

-- U1b (#1482): carries `constraintOrigin` (the #1110 interface-occurrence identity)
-- alongside the spelling, so `registerMember`'s slot-parallel iface list — and hence
-- every obligation `recordCallObligations` later mints from it — is identity-carrying.
constraintTyVars : Constraint -> List (IfaceRef, List String)
constraintTyVars (Constraint { constraintHead = iface, constraintArgs = tys, constraintOrigin = co }) = match tyVarArgNames tys
  [] => []
  ns => [(IfaceRef { irName = iface, irOrigin = co }, ns)]

tyVarArgNames : List Ty -> List String
tyVarArgNames tys = dedup (flatMap tyVarNames tys)

-- #1161 (F-3a-ii): slot-parallel to `sigConstraints` — the WHOLE predicate's argument
-- type list, ONE per slot.  `Ix a Char` and `Ix a b` are each ONE slot carrying their
-- full argument list (`[TyVar a, TyCon Char]` / `[TyVar a, TyVar b]`) — evidence for one
-- predicate, so one goal.
-- Length-parallel to sigConstraints by construction: both are `flatMap … cs` over the
-- SAME constraint list, and both emit one element per constraint that has at least one
-- bare tyvar argument.
-- Matches sigConstraints' TOP-LEVEL-`TyConstrained`-only shape deliberately, so the two
-- cannot desynchronize on a nested-constraint spine.
sigConstraintArgTys : Ty -> List (List Ty)
sigConstraintArgTys (TyConstrained cs _) = flatMap constraintTyVarArgs cs
sigConstraintArgTys _ = []

constraintTyVarArgs : Constraint -> List (List Ty)
constraintTyVarArgs (Constraint { constraintArgs = tys }) = match tyVarArgNames tys
  [] => []
  _ => [tys]

-- like constraintVarMonos but KEEPS the iface name paired with each constraint var's
-- mono (slot order preserved), so registerMember can register call-obligation ifaces.
-- S-dict-arity-contract: the payload is now the predicate's WHOLE bare-tyvar mono list,
-- one entry per predicate.  An entry survives when AT LEAST ONE of its names is in
-- [tvMap] (the drop rule `constraintVarArgMonos` mirrors exactly); the monos of the
-- names that are absent are simply not carried, which is what the per-name walk did.
constraintVarIfaceMonos : List (IfaceRef, List String) -> List (String, Mono) -> List (IfaceRef, List Mono)
constraintVarIfaceMonos [] _ = []
constraintVarIfaceMonos ((iface, names)::rest) tvMap = match constraintNameMonos names tvMap
  [] => constraintVarIfaceMonos rest tvMap
  monos => (iface, monos) :: constraintVarIfaceMonos rest tvMap

constraintNameMonos : List String -> List (String, Mono) -> List Mono
constraintNameMonos [] _ = []
constraintNameMonos (n::rest) tvMap = match lookupAssoc n tvMap
  Some mono => mono :: constraintNameMonos rest tvMap
  None => constraintNameMonos rest tvMap

-- #1161 (F-3a-ii): as constraintVarIfaceMonos, but yields each kept slot's predicate
-- argument vector as MONOS at the signature instantiation.  Drops exactly the slots
-- constraintVarIfaceMonos drops (same `lookupAssoc name tvMap` test, same walk), so the
-- two lists stay slot-parallel.
-- ⚠️ Resolves arguments with `fromAstType tvMap`, NOT `constraintArgMonos` — the latter
-- returns `None` for any argument that is not a bare type variable, i.e. exactly the
-- concrete `Char` in `Ix a Char` that is the whole point of recording the vector.
-- Every tyvar NAME reachable inside an argument is in [tvMap]: instantiateSigTracked
-- builds it from `tyVarNamesWithConstraints`, whose constraint half
-- (`constraintArgVarNames`) is a full structural `tyVarNames` walk of each argument —
-- so the interior `b` of `List b` is mapped, and fromAstType's unmapped-var → `TCon n`
-- fallback is unreachable here.
constraintVarArgMonos : List (IfaceRef, List String) -> List (List Ty) -> List (String, Mono) -> List (List Mono)
constraintVarArgMonos [] _ _ = []
constraintVarArgMonos _ [] _ = []
constraintVarArgMonos ((_, names)::rest) (args::argsRest) tvMap = match constraintNameMonos names tvMap
  [] => constraintVarArgMonos rest argsRest tvMap
  _ => map (fromAstType tvMap) args :: constraintVarArgMonos rest argsRest tvMap

-- After body inference, register each member's constraint variables by their
-- *surviving* (normalized) tyvar id: in activeDictVars (id → dict param name, for
-- in-body RDict routing) and per-fn in funConstraintsRef (for call-site dict
-- application).  Done per group so a callee's constraints are known before its
-- (later-group) callers infer.
registerConstraintRegs : List (String, List (IfaceRef, List Mono), List (List Mono)) -> Unit
registerConstraintRegs [] = ()
registerConstraintRegs ((m, ifaceMonos, argVecs)::rest) =
  let _ = registerMember m ifaceMonos argVecs
  registerConstraintRegs rest

-- #994 (B-3-a): THE per-entry write op for the fn-constraint tables.  `CSlot` (U1b,
-- #1482) stopped every CONSUMER of a callee's constraint slots from holding two parallel
-- lists; this stops the two PRODUCERS — `registerMember` and `registerInferredFor` —
-- from holding them either.  Both projections come off ONE `CSlot` list, so
-- `funConstraintsRef`'s ids and `funConstraintIfacesRef`'s ifaces are slot-parallel by
-- TYPE here, not by a filter each writer re-derives and keeps in step by hand.
--
-- ⚠️ [argsOpt] is `None` for a writer that registers no `funConstraintArgsRef` entry at
-- all — since S-inferred-vector-supply (#1869) that is `registerInferredFor` only when it
-- recovered NO vector for any slot (`inferredArgsOpt`), not unconditionally as before —
-- and that is why the arg vectors CANNOT join `CSlot`:
-- `keptConstraintArgs` stops when its vector list runs out, so the args payload is
-- legitimately a PREFIX of the slots, and folding it in per-slot would either truncate
-- the id list (a dict-ARITY change) or invent a vector.  Entry-ABSENCE is also
-- meaningful — an ids-only entry is a distinct state from an entry with empty args.
setFunConstraintEntry : String -> List CSlot -> Option (List (List Mono)) -> Unit
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
setFunConstraintEntry m slots argsOpt =
  perRun.value.funConstraintsRef := ((m, map (s => s.csId) slots)::perRun.value.funConstraintsRef.value)
  -- B-2.2-f (#1113): the DECLARED-prefix sidecar, written in the SAME op as the ids it
  -- describes so the two can never be written apart.
  --
  -- 🚨 The DEDUPED length, not `listLen slots` — MEASURED, not defensive.  The expansion
  -- starts from the deduped declared slots, so a signature whose context names one
  -- interface twice on one tyvar (`twice : (Shw a, Shw a) => a -> Int`) contributes ONE
  -- slot where `slots` holds two.  Recording the unshrunk length would put `index < k` one
  -- slot past the real declared prefix and mark the first APPENDED super slot as declared —
  -- the unsafe direction, silently.
  -- 🚨 S-slot-key-vector (#1866): it must be the SAME dedup the expansion runs, and that
  -- is now `dedupSlotVecs` over the slots PAIRED WITH THEIR VECTORS.  Keeping the
  -- vector-free dedup that used to stand here (`dedupSlots`, now deleted — see
  -- `cslotKey`) would under-count `(Ix a Char, Ix a Bool) => …` (one
  -- where the expansion now yields two) and re-introduce the same off-by-one in the other
  -- direction.  [argsOpt] is the very prefix `expandSupersEntry` reads back out of
  -- `funConstraintArgsRef`, so the two dedups see identical input; `None` (no vector row
  -- at all) yields `[]` per slot, i.e. exactly the pre-widening count.
  let _ = setRef perRun.value.funConstraintDeclaredRef
    ((m, CDPLen (listLen (dedupSlotVecs (zipSlotVecs slots (fromOption [] argsOpt)))))::perRun.value.funConstraintDeclaredRef.value)
  perRun.value.funConstraintIfacesRef := ((m, map (s => s.csIface) slots)::perRun.value.funConstraintIfacesRef.value)
  match argsOpt
    Some args => (perRun.value.funConstraintArgsRef := ((m, args)::perRun.value.funConstraintArgsRef.value))
    None => ()

-- register a member's constraints: ids into funConstraintsRef + activeDictVars (the
-- kept/abstract slots), and the SLOT-ALIGNED iface names into funConstraintIfacesRef.
-- registerMemberSlots keeps a slot only when its mono is still an abstract TVar (a
-- body-forced-concrete constraint takes no dict slot); it emits the (iface, id) pair in
-- ONE traversal, so the iface list cannot be filtered differently from the id list.
registerMember : String -> List (IfaceRef, List Mono) -> List (List Mono) -> Unit
-- An UNCONSTRAINED member (empty constraint list) gets NO funConstraintsRef /
-- funConstraintIfacesRef entry.  These refs are keyed by BARE NAME and accumulate
-- across the per-module elaboration; an unconstrained top-level fn that shares a
-- name with a constrained one in another module (e.g. array.mdk's `find : (a ->
-- Bool) -> Array a -> Option a` vs core.mdk's `find : Foldable t => …`) would
-- otherwise register a `(find, [])` entry that, prepended later, wins the
-- first-match lookup over core's `(find, [foldableId])`.  inferDictAt then reads 0
-- constraint ids → 0 dict args at the call site → `unbound identifier:
-- $dict_find_0` at eval.  An unconstrained fn is never marked EDictAt, so it needs
-- no entry (mirrors registerInferredFor's empty-ids guard).
registerMember _ [] _ = ()
registerMember m ifaceMonos argVecs =
  let slots = registerMemberSlots m 0 ifaceMonos
  let keptArgs = keptConstraintArgs ifaceMonos argVecs
  -- #1909: the PREDICATE-keyed half of the given, alongside the tyvar-id half
  -- `registerMemberSlots` just wrote.  Exactly `registerReqSlots`' pairing, one channel
  -- over — see `registerSlotPredGivens`.
  let _ = registerSlotPredGivens m 0 slots keptArgs
  setFunConstraintEntry m slots (Some keptArgs)

-- #1161 (F-3a-ii): the argument vectors of the constraints registerMemberSlots KEEPS,
-- in the same slot order — the same `normalize`-is-a-TVar filter applied to the parallel
-- vector list, so funConstraintArgsRef stays slot-parallel to funConstraintsRef's ids.
-- ⚠️ It is a PREFIX, not a full parallel list, when [argVecs] is shorter than the
-- constraint list (`constraintVarArgMonos` drops constraints absent from the tvs map):
-- the second clause stops early.  That is why #994's fusion keeps this payload
-- entry-level and OPTIONAL instead of folding it into `CSlot` — see
-- `setFunConstraintEntry`.
keptConstraintArgs : List (IfaceRef, List Mono) -> List (List Mono) -> List (List Mono)
keptConstraintArgs [] _ = []
keptConstraintArgs _ [] = []
keptConstraintArgs ((_, monos)::rest) (v::vs) = match abstractSlotIds monos
  [] => keptConstraintArgs rest vs
  _ => v :: keptConstraintArgs rest vs

-- [kept] is the next dict-param slot; a constraint variable forced concrete by the
-- body takes no dict and doesn't advance the slot (so param names stay 0..k-1,
-- matching dict_pass).
--
-- #994 (B-3-a): emits `CSlot`s, not a bare id list.  The iface half used to be recovered
-- by a SECOND traversal (`keptConstraintIfaces`, deleted) applying the identical
-- `normalize mono` is-a-`TVar` filter to the identical list; one traversal carrying the
-- pair makes "the iface list is filtered the same way" unrepresentable-otherwise instead
-- of a comment two functions apart.
-- S-dict-arity-contract: ONE slot per PREDICATE.  [monos] is NOT the predicate's own
-- argument-type list (that can be structured, e.g. `[Wrap a]` for `Tag (Wrap a)`) — it is
-- the instantiated monos of the bare tyvar NAMES `sigConstraints`/`tyVarArgNames` found
-- inside those argument types, direct or nested, one per name
-- (`constraintNameMonos`/`constraintVarArgMonos`).  Each entry of [monos] is therefore
-- always a `TVar` at the signature instantiation, never a structured mono, even when the
-- predicate's own argument was structured.  The slot survives when at
-- least one of them is still abstract after body inference (a predicate ALL of whose
-- variables the body forced concrete takes no dict, as before), and it is keyed on the
-- FIRST such id — the same "first dispatch variable" rule the method-level channel has
-- used since #818 (`constraintFirstNonParam`).
--
-- ⚠️ EVERY abstract id of the predicate is registered in `activeDictVars` against THAT
-- ONE slot, not just the lead: `Ix a b => …` binds one dict param, and a body use whose
-- dispatch variable is `b` must still find it.  `activeDictVarForEncl`'s id-keyed lookup
-- is what answers those sites (`enclSlotIndex`'s predicate/first-id rungs are keyed on
-- the slot's lead id and legitimately miss).  This mirrors `registerReqSlots`'
-- `registerEachActive`, which has keyed many ids onto one `requires` slot all along.
registerMemberSlots : String -> Int -> List (IfaceRef, List Mono) -> List CSlot
registerMemberSlots _ _ [] = []
registerMemberSlots m kept ((iface, monos)::rest) = match abstractSlotIds monos
  [] => registerMemberSlots m kept rest
  id::more =>
    let _ = registerEachActiveId (id::more) (dictParamName m kept)
    CSlot {
      csIface = iface,
      csId = id,
    } :: registerMemberSlots m (kept + 1) rest

-- the ids of [monos] that are still ABSTRACT type variables, in order.  The filter
-- `registerMemberSlots` and `keptConstraintArgs` must agree on, factored so the two
-- cannot drift (they decide, respectively, whether a slot exists and whether its
-- argument vector is recorded — a disagreement desynchronizes `funConstraintArgsRef`
-- from `funConstraintsRef`).
abstractSlotIds : List Mono -> List Int
abstractSlotIds [] = []
abstractSlotIds (mono::rest) = match normalize mono
  TVar cell => tyvarId cell :: abstractSlotIds rest
  _ => abstractSlotIds rest

registerEachActiveId : List Int -> String -> Unit
registerEachActiveId [] _ = ()
registerEachActiveId (id::rest) dname =
  perRun.value.activeDictVars := (id, dname)::perRun.value.activeDictVars.value
  registerEachActiveId rest dname

-- #1909: the SIGNATURE channel's `registerPredGiven` call — the one `registerReqSlots`
-- has made since #412 and this side never did.  `registerEachActiveId` above registers a
-- fn's declared `=>` given by TYVAR ID only, which cannot express a STRUCTURED given:
-- `Tag (Wrap a) => …` registers only `a`'s id, and the body's goal `Tag (Wrap a)` looks
-- up through `activeDictVarOf`, which recurses to the spine head (`TCon "Wrap"`) and
-- finds no tyvar — so `entailAssum` was unreachable by construction, `entail` fell to
-- `entailInst`, and the body was statically committed to whichever impl `entailInst`
-- picked against the ABSTRACTION-time goal, discarding the per-instantiation dict the
-- call site (`routesOfMonosTopV` → `pickMostSpecificEntry`) had already built correctly.
-- `registerPredGiven`'s header carries the same paragraph for the `requires` channel.
--
-- ⚠️ NO SELECTOR IS CALLED HERE, and none may be: `typecheck.mdk`'s assum-rung rule is
-- that no selector call may be reachable from `entailAssum`.  This restores an EARLIER
-- rung's ability to answer; it does not re-select.
--
-- Strictly ADDITIVE by construction, via `registerPredGiven`'s own two guards: a
-- bare-tyvar context (`Shw a => …`) hits `monoIsBareTyvar` and registers nothing (the
-- tyvar-id path above still answers it byte-identically), and a multi-parameter predicate
-- (`Ix a Char => …`) misses the `[subject]` pattern and registers nothing.  Only a
-- STRUCTURED SINGLE-SUBJECT context gains an answer it did not have.
--
-- [slot] counts dict params the way `registerMemberSlots`' `kept` does, so the nth kept
-- slot gets `dictParamName m n`.  The vector list is legitimately a PREFIX of the slots
-- (`keptConstraintArgs` stops when its input runs out — see `setFunConstraintEntry`), so
-- the second clause stops early rather than inventing a subject for a vectorless slot.
registerSlotPredGivens : String -> Int -> List CSlot -> List (List Mono) -> Unit
registerSlotPredGivens _ _ [] _ = ()
registerSlotPredGivens _ _ _ [] = ()
registerSlotPredGivens m slot (s::srest) (v::vrest) =
  let _ = registerPredGiven s.csIface.irName v (dictParamName m slot)
  registerSlotPredGivens m (slot + 1) srest vrest

-- Pass B: infer each member's clauses, unifying with its placeholder.
-- Phase 73 (bidirectional, signature-driven parameter typing): a member WITH a
-- signature peels its declared arrow types onto the clause parameter patterns
-- BEFORE inferring the body, so the body sees concrete parameter types (a
-- receiver-directed field access `f p = p.x` or a `String`-indexed `s.[0]`
-- resolves from the signature alone).  [peel] is Some(placeholder) for a signed
-- member, None otherwise; the placeholder already holds the sig instantiation
-- (preunifySigsEx unified it), and its shared tyvars accumulate unifications
-- across clauses exactly as the oracle's `sig_t` does.  Purely additive: the
-- per-clause `unify v arrow` below imposes the same equalities anyway.
inferMembers : TcEnv -> List (String, Ty) -> OrdMap (List (List Pat, Expr)) -> List (String, Mono) -> Unit
inferMembers _ _ _ [] = ()
inferMembers env sigs grouped ((m, v)::rest) =
  perRun.value.currentFn := m
  let peel = memberPeelSource sigs m v
  let effs = inferMemberClauses env peel v (clausesOf m grouped)
  perRun.value.currentFn := ""
  let _ = checkEffectEscape sigs m effs
  inferMembers env sigs grouped rest

-- the peel source for a member: Some placeholder if it has a signature (peel the
-- declared arrow domains onto the clause params), None otherwise
memberPeelSource : List (String, Ty) -> String -> Mono -> Option Mono
memberPeelSource sigs m v =
  map (_ => v) (omLookup m driverState.value.sigNameSetRef.value)

-- peel up to [n] arrow domains off [t], normalizing at each level.  A signature
-- with fewer arrows than the clause has params stops early and returns fewer
-- domains (the mismatch then surfaces at the per-clause `unify v arrow`).
peelArrows : Int -> Mono -> List Mono
peelArrows n t
  | n <= 0 = []
  | otherwise = match normalize t
    TFun a _ b => a :: peelArrows (n - 1) b
    _ => []

-- zip-unify the equal-length prefix of param types and peeled sig domains; a
-- shorter [qs] (partial sig) pushes nothing past its end
zipUnify : List Mono -> List Mono -> Unit
zipUnify (p::ps) (q::qs) =
  let _ = unify p q
  zipUnify ps qs
zipUnify _ _ = ()

-- infer each clause, unifying it to the member placeholder [v] and collecting the
-- concrete effect labels the bodies perform (Phase 79e binding-boundary check).
-- [peel] threads the Phase-73 sig peel source (Some placeholder when signed).
inferMemberClauses : TcEnv -> Option Mono -> Mono -> List (List Pat, Expr) -> List Atom
inferMemberClauses _ _ _ [] = []
inferMemberClauses env peel v (cl::rest) =
  let ce = inferClauseEff env peel cl
  let _ = unify v (fst ce)
  atomsUnion (snd ce) (inferMemberClauses env peel v rest)

-- infer one clause, returning its arrow type AND the concrete effect labels its
-- body performs (captured under a fresh open ambient, then the ambient restored —
-- building a closure performs nothing).  Mirrors inferLam but exposes the effect.
-- Phase 73: when [peel] is Some(sig source) and the clause has params, peel the
-- signature's arrow domains and zip-unify them onto the clause param types BEFORE
-- inferring the body (bidirectional checking mode).
inferClauseEff : TcEnv -> Option Mono -> (List Pat, Expr) -> (Mono, List Atom)
inferClauseEff env peel (pats, body) =
  -- Anchor currentLoc to THIS clause's body loc before inferring patterns:
  -- patterns carry no source Loc, so an over-applied-constructor / arity pattern
  -- error would otherwise be recorded at the STALE loc left by the previous
  -- clause's (or a previous function's) body inference — mis-blaming an innocent
  -- sibling clause.  See the twin note in inferLam.
  let _ = match exprLoc body
    Some l => (currentLoc := (Some l))
    None => ()
  let pr = inferPats env pats
  let _ = peelOntoParams peel (fst pr) pats
  let saved = perRun.value.curEffect.value
  perRun.value.curEffect := (openRow ())
  let bodyTy = infer (extendLocalVars env (snd pr)) body
  let bodyEff = perRun.value.curEffect.value
  perRun.value.curEffect := saved
  (arrowsWithLastEffect (fst pr) bodyEff bodyTy, effrowLabels bodyEff)

-- Phase 73 peel: for a signed clause with params, zip-unify the peeled sig
-- domains onto the inferred param types.  No-op for an unsigned member, a value
-- binding (no params), or a sig with no remaining arrows.
peelOntoParams : Option Mono -> List Mono -> List Pat -> Unit
peelOntoParams None _ _ = ()
peelOntoParams (Some _) _ [] = ()
peelOntoParams (Some src) patTypes pats =
  zipUnify patTypes (peelArrows (listLen pats) src)

-- a signatured binding's body must not perform a concrete effect its signature
-- doesn't declare; effect *variables* (polymorphic `<e>`) carry no labels and so
-- never escape (Phase 79e)
checkEffectEscape : List (String, Ty) -> String -> List Atom -> Unit
checkEffectEscape sigs m effs = match omLookup m driverState.value.sigTyMapRef.value
  None => ()
  Some ty => match atomsEscape effs (declaredEffects ty)
    [] => ()
    extras => pushTypeError "T-EFFECT-LEAK" (effectEscapeMsg m (declaredEffects ty) extras)

effectEscapeMsg : String -> List Atom -> List Atom -> String
effectEscapeMsg name declared extras = "Function '\{name}' declared with <\{renderAtoms declared}> but also performs <\{renderAtoms extras}>"

-- generalize each member's (sig-and-body-unified) placeholder.  A signature was
-- already unified into the placeholder by preunifySigs, so generalizing the
-- result respects it AND any further specialization the body forces (e.g.
-- sum : t a -> a with body `fold (+) 0` reports a Int -> Int, not the raw sig).
-- Value restriction (T1): generalize a member only if it is a *value* —
--   plainVal = isLetrec (multi-member SCC, always a function group) OR every
--              clause has params / a non-expansive zero-arg RHS;
--   sigIsFun = the member is signed AND its (post-unify) type is an arrow
--              (Phase 89 point-free relaxation: a signed arrow-typed point-free
--              binding like `maximum = fold step None` stays generalizable even
--              though its RHS is an application);
--   isVal    = plainVal || sigIsFun.
-- A non-function expansive unsigned binding (`r = Ref []`) is value-restricted and
-- stays monomorphic.  Mirrors oracle lib/typecheck.ml:2705-2710 + 2756.
sccSchemes : TcEnv -> List (String, Ty) -> OrdMap (List (List Pat, Expr)) -> Bool -> List (String, Mono) -> List (String, Scheme)
sccSchemes _ _ _ _ [] = []
sccSchemes env sigs grouped isLetrec ((m, v)::rest) =
  let plainVal = isLetrec || allList (memberClauseIsValue env) (clausesOf m grouped)
  let sigIsFun = memberSigIsFun sigs m v
  let isVal = plainVal || sigIsFun
  (m, genRestricted isVal v) :: sccSchemes env sigs grouped isLetrec rest

-- a top-level clause is a value if it has params (function) or a non-expansive RHS
memberClauseIsValue : TcEnv -> (List Pat, Expr) -> Bool
memberClauseIsValue env ([], rhs) = isNonexpansive env rhs
memberClauseIsValue _ (_, _) = True

-- Phase 89: a signed binding whose (post-unify) type is an arrow is generalizable
memberSigIsFun : List (String, Ty) -> String -> Mono -> Bool
memberSigIsFun sigs m v = match omLookup m driverState.value.sigNameSetRef.value
  None => False
  Some _ => match normalize v
    TFun _ _ _ => True
    _ => False

-- ── signature-too-general check ──────────────────────────────────────────────
-- After body inference, the declared signature's type variables must map to
-- DISTINCT TVar refs.  If two declared tyvars (e.g. `a` and `b` in `a -> b`)
-- collapse to the SAME TVar after unification (body forces them equal), the
-- declared signature claims more polymorphism than the body allows.
-- We only reject the "two tvars become one" case (not concrete grounding), so
-- `sum = fold (+) 0` (which grounds one tyvar to Int) passes.
checkSigsTooGeneral : List (String, Ty, List (String, Mono)) -> Unit
checkSigsTooGeneral [] = ()
checkSigsTooGeneral ((m, ty, tvs)::rest) =
  let _ = checkSigTooGeneral m ty tvs
  checkSigsTooGeneral rest

checkSigTooGeneral : String -> Ty -> List (String, Mono) -> Unit
checkSigTooGeneral name ty tvs =
  let tvarIds = sigTvarIds (map snd tvs)
  if hasDupI tvarIds then
    pushTypeError "T-TYPE-TOO-GENERAL" (sigTooGeneralMsg name ty)
  else
    ()

-- collect the TVar ids of those entries in tvs that normalize to a TVar
-- (concrete-grounded entries are skipped — only same-TVar collapses are an error)
sigTvarIds : List Mono -> List Int
sigTvarIds [] = []
sigTvarIds (m::rest) = match normalize m
  TVar cell => tyvarId cell :: sigTvarIds rest
  _ => sigTvarIds rest

-- true if the list has any duplicate Int
hasDupI : List Int -> Bool
hasDupI [] = False
hasDupI (x::xs) = containsI x xs || hasDupI xs

sigTooGeneralMsg : String -> Ty -> String
sigTooGeneralMsg name ty = "Declared signature of '\{name}' is more general than its body. '\{ppTy ty}' claims type variables that are the same type after inference"

-- C3: mirrors lib/typecheck.ml's AnnotationTooGeneral message byte-for-byte.
annotTooGeneralMsg : Ty -> String
annotTooGeneralMsg ty = "Type annotation '"
  ++ ppTy ty
  ++ "' is more polymorphic than the expression. A type variable in the annotation is actually a specific type (or two annotation variables are the same type)"

-- pretty-print an AST type (mirrors lib/ast.ml's pp_ty byte-for-byte)
ppTy : Ty -> String
ppTy (TyCon { tyConName = n }) = n
ppTy (TyVar n) = n
ppTy (TyApp a b) = "\{ppTy a} \{ppTyAtom b}"
ppTy (TyFun a b) = "\{ppTyFunArg a} -> \{ppTy b}"
ppTy (TyTuple ts) = "(" ++ joinWith ", " (map ppTy ts) ++ ")"
ppTy (TyEffect effs tail t) = "<\{ppEffInsideTy effs tail}> \{ppTy t}"
-- A bare row atom (#997): same row rendering as `TyEffect` above, minus the
-- wrapped type it has none of.
ppTy (TyRow effs tail _) = "<\{ppEffInsideTy effs tail}>"
ppTy (TyConstrained cs t) = "\{ppConstraints cs} => \{ppTy t}"

-- shared `<...>` row-body renderer for `TyEffect`/`TyRow` (factored out of
-- `TyEffect`'s arm above so `TyRow` doesn't duplicate it — lint's
-- rule-duplicate-body would flag an inlined copy).
ppEffInsideTy : List (String, Option String) -> Option String -> String
ppEffInsideTy effs tail =
  let labs = map ppEffAtomTy effs
  match tail
    None => joinWith ", " labs
    Some v => match effs
      [] => v
      _ => "\{joinWith ", " labs} | \{v}"

-- effect atom renderer for ppTy (mirrors OCaml pp_atom inside pp_ty_prec / TEff)
ppEffAtomTy : (String, Option String) -> String
ppEffAtomTy (l, None) = l
-- Intentional cross-file duplicate of the same helper in doc.mdk AND eval.mdk's ppEffAtomK; not consolidating (tiny helper / divergent-by-design backend trio).
-- lint-disable-next-line rule-duplicate-body
ppEffAtomTy (l, Some s) = if s == "_" then l ++ " _" else "\{l} \{escStr s}"

-- single constraint: no outer parens; multiple: wrap in parens (mirrors OCaml)
ppConstraints : List Constraint -> String
ppConstraints [c] = ppConstraint c
ppConstraints cs = "(" ++ joinWith ", " (map ppConstraint cs) ++ ")"

-- argument of `->`: wrap TyFun (prec>=1) but not TyApp (prec<2)
ppTyFunArg : Ty -> String
ppTyFunArg (TyFun a b) = "(" ++ ppTy (TyFun a b) ++ ")"
ppTyFunArg t = ppTy t

-- argument of application: wrap TyFun (prec>=1) and TyApp (prec>=2)
ppTyAtom : Ty -> String
ppTyAtom (TyFun a b) = "(" ++ ppTy (TyFun a b) ++ ")"
ppTyAtom (TyApp a b) = "(" ++ ppTy (TyApp a b) ++ ")"
ppTyAtom t = ppTy t

ppConstraint : Constraint -> String
ppConstraint (Constraint { constraintHead = iface, constraintArgs = [] }) =
  iface
ppConstraint (Constraint { constraintHead = iface, constraintArgs = tys }) =
  "\{iface} \{joinWith " " (map ppTyAtom tys)}"

-- ── inferred-constraint promotion (unsignatured `=>` — the two-pass layer) ──
-- After a group is generalized, an UNSIGNATURED eligible member that uses a
-- return-position method (methodSiteFns) — or calls a constrained fn (dictAppFns)
-- — at one of its OWN quantified tyvars carries an INFERRED constraint.  Register
-- it exactly as a signatured one (funConstraintsRef + activeDictVars, keyed by the
-- *surviving* normalized id) so its body's method routes RDict and dict_pass
-- prepends a dict param; and record it in promotedRef so elaborateDict marks its
-- occurrences EDictAt on the next pass.  Signatured members are skipped (their
-- constraints came from preunifySigs); prelude fns are skipped (not eligible).
-- #1549: the deltas are threaded in so an inferred constraint that arrived as a
-- `requires` RESIDUAL (`nest x = tagOf (Wrap x)`) gets its dict parameter too.
-- `inferredConstraintIds` reads `methodSiteFns`/`dictAppFns`, which store a bare mono
-- with no interface attached, so a compound receiver (`Wrap t`) cannot be reduced
-- there; `residualInferredPreds` reduces the SAME predicates the scheme-obligation
-- channel just deferred.  Without this the scheme carries `Tag a` while the body
-- abstracts no dict — `check` would reject the bad call and an ORDINARY correct
-- program's binary would still read an unpassed dict word (issue 1549's second cell).
registerInferredConstraints : List (String, Ty) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> List (String, Scheme) -> Unit
registerInferredConstraints _ _ _ [] = ()
registerInferredConstraints sigs callObls addedObls ((m, sch)::rest) =
  let _ = maybeInferConstraint sigs callObls addedObls m sch
  registerInferredConstraints sigs callObls addedObls rest

maybeInferConstraint : List (String, Ty) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> String -> Scheme -> Unit
maybeInferConstraint sigs callObls addedObls m sch
  | not (omHasKey m driverState.value.dictEligibleSetRef.value) = ()
  | omHasKey m driverState.value.sigNameSetRef.value = ()
  | otherwise =
    let boundIds = schemeIds sch
    -- S-inferred-vector-supply (#1869): the SAME predicate list, read TWICE for two
    -- different questions — which slots exist (ids, unchanged) and what argument vector
    -- each slot's predicate carries.  `residualInferredPreds` is evaluated ONCE and both
    -- questions read its result, so the §3 residual reduction still runs exactly once per
    -- group (see `residualBoundPreds`).
    let preds = flatMap oblPredOf addedObls ++ flatMap callPredOf callObls
    let residualPreds = residualInferredPreds boundIds preds
    let vecs = directInferredPreds boundIds preds ++ residualPreds
    let ids = dedupI (inferredConstraintIds m boundIds ++ map inferredPredLead residualPreds)
    registerInferredFor m ids vecs

-- #11 soundness (ALWAYS-ON): for each generalized member, record the deferred impl
-- obligations it quantifies over — an addedObls entry whose discriminating mono is a
-- TVar among the member's scheme ids becomes (iface, that id).  A signed member's
-- declared `=>` constraints come from its sig instead (registered via funConstraints);
-- but recording the inferred obligation list here too is harmless (a satisfiable
-- concrete instantiation passes; an unsatisfiable one SHOULD error).  Runs on every
-- path (NOT gated on dictEligibleSetRef), so the plain check path catches the hole.
-- SOURCING (#619 DECLARED-ONLY; supersedes the #607/#610 UNION): the predicates a
-- binding abstracts are its PRINCIPAL context, and per DICT-SEMANTICS §4 `gen`/`var`
-- an ASCRIBED signature IS that context — a contract the body must satisfy, not a
-- floor it can raise (Jones; Hall-Peyton-Jones-Wadler; Haskell).  So:
--   • SIGNED binding   → obligations come SOLELY from the declared `=>` context
--       (declaredSchemeOblsFor).  The body's inferred obligations
--       (schemeObligationsOf / forwardedVecObls) are NOT merged in — they are
--       CHECKED as entailed by the declared context (checkSigConstraintCoverage);
--       a body that genuinely needs MORE than the signature declares is a def-site
--       type error (T-MISSING-CONSTRAINT), not a silent widening.
--   • UNSIGNED binding → no declared context exists, so the inferred principal
--       context stands: direct body dispatch (schemeObligationsOf) plus any
--       constraint forwarded from a constrained callee (forwardedVecObls).  Its
--       inferred constraints are promoted, not checked (see checkSigConstraintOne).
-- #610 stays satisfied: a declared constraint the body never dispatches on
-- (`sz2 : Sz a => a -> Int; sz2 x = 9`) is still sourced from declaredSchemeOblsFor,
-- so the scheme keeps `Sz a` and every caller discharges it.  #619 additionally drops
-- the union's redundant superclass display — `when : Thenable m => …` whose body's
-- `pure` infers Applicative now renders just `Thenable a =>` (Applicative is entailed
-- by `Thenable requires Applicative`, so it is checked-and-dropped, not merged).
-- #837: [memberDefIds] carries each TOP-LEVEL member's binding id (processSCC passes
-- schemeDefIdsRef); the local/where call sites pass omEmpty so their members key under
-- the sentinel id 0.  A member absent from [memberDefIds] is a local/where binder → 0.
registerSchemeObligations : OrdMap Int -> List (String, Ty, List (String, Mono)) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> List (String, Scheme) -> Unit
registerSchemeObligations _ _ _ _ [] = ()
registerSchemeObligations memberDefIds sigTvMaps callObls addedObls ((m, sch)::rest) =
  -- #838 I2 / #827: record this binding's QUANTIFIED (generalized) var ids as
  -- caller-deferrable.  A var this binding ∀-quantifies is FORWARDED to its callers
  -- (each use re-instantiates it fresh), so an end-of-run call obligation carrying
  -- that exact id is this binding's own deferred predicate — checkUndeterminedObligation
  -- RULE 2 defers it into the scheme instead of a spurious `Ambiguous instance` reject.
  -- CRITICAL (S0 #855-review): this uses the POST-generalization `schemeIds`, NOT the
  -- pre-generalization member monos.  A value-restricted intermediate (`let x = mk n`,
  -- `mk : Int -> a`) does NOT quantify its var (`Forall []`), so an escaped ambiguous
  -- var never enters this set and RULE 3 correctly rejects it (a1_greet/a1_letleak).
  perRun.value.deferrableVarIds := (schemeIds sch ++ perRun.value.deferrableVarIds.value)
  let obs = dedupVecObls (schemeOblsForMember sigTvMaps callObls addedObls m sch)
  -- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
  -- lint-disable-next-line rule-prefer-assign-op
  let _ = if isEmptyL obs then ()
  else
    let defId = fromOption 0 (omLookup m memberDefIds)
    setRef
      perRun.value.schemeObligationsRef
      (((m, defId), obs)::perRun.value.schemeObligationsRef.value)
  registerSchemeObligations memberDefIds sigTvMaps callObls addedObls rest

-- #619: a SIGNED binding's scheme context is EXACTLY its declared `=>` predicates
-- (authoritative); an UNSIGNED binding's is its inferred principal context (direct
-- dispatch + forwarded).  Signedness is `lookupSigTvMap … = Some` — true for any
-- signed member, including a signed binding with an EMPTY `=>` (whose declared
-- context is correctly empty), which is what distinguishes it from an unsigned one.
schemeOblsForMember : List (String, Ty, List (String, Mono)) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> String -> Scheme -> List VecObl
schemeOblsForMember sigTvMaps callObls addedObls m sch = match lookupSigTvMap m sigTvMaps
  Some _ => declaredSchemeOblsFor sigTvMaps m (schemeIds sch)
  None => schemeObligationsOf (schemeIds sch) addedObls
    ++ forwardedVecObls (schemeIds sch) callObls

-- the DECLARED `=>` predicates of signed member [m], each as its argument vector of
-- scheme-quantified tyvar ids.  A predicate is kept only if EVERY argument is a plain
-- tyvar that instantiated to one of this scheme's quantified vars: a concrete-grounded
-- argument (`Sz Int =>`) carries no per-use obligation here, and a partial vector would
-- be a different predicate.  An unsigned member contributes nothing.
declaredSchemeOblsFor : List (String, Ty, List (String, Mono)) -> String -> List Int -> List VecObl
declaredSchemeOblsFor sigTvMaps m boundIds = match lookupSigTvMap m sigTvMaps
  None => []
  Some (ty, tvMap) =>
    flatMap (declaredOblOne boundIds tvMap) (sigConstraintsOf ty)

declaredOblOne : List Int -> List (String, Mono) -> Constraint -> List VecObl
declaredOblOne boundIds tvMap (Constraint { constraintHead = iface, constraintArgs = args, constraintOrigin = co }) =
  -- U1b (#1482): `constraintOrigin` is the #1110 interface-OCCURRENCE identity of the
  -- `=>` predicate as written in this module's scope — the same layer `DImpl.implOrigin`
  -- is stamped in, which is what makes the goal and the impl comparable.
  let ifref = IfaceRef { irName = iface, irOrigin = co }
  match constraintArgMonos args tvMap
    None => declaredOblMixed boundIds ifref tvMap args
    Some monos => match boundTyvarIds boundIds monos
      Some ids => [VecObl { voIface = ifref, voIds = ids, voArgs = [] }]
      None => []

-- #1161 SYMPTOM 2: the predicate has an argument that is not a bare tyvar, so
-- `constraintArgMonos` answered `None` and the WHOLE predicate used to be discarded —
-- `Ix a Bool =>` with no `impl Ix _ Bool` anywhere reached neither the displayed scheme
-- nor any caller's obligation list, and `check` accepted it at exit 0 while the call
-- dispatched to an unrelated impl.  DICT-SEMANTICS §3 makes `match(IE, Ix Int Bool)`
-- empty and the goal a missing-instance rejection, so the predicate must survive the
-- channel: record its WHOLE argument vector in `voArgs`, and the ids of its bare-tyvar
-- positions in `voIds` (one dict slot per deferred variable, unchanged cardinality).
--
-- 🚨 THE ADMISSION TEST IS DELIBERATELY NARROW, AND EVERY CLAUSE OF IT IS LOAD-BEARING —
-- this is a NARROWING (programs that were accepted now reject), so an argument this
-- function admits without being able to instantiate CORRECTLY would substitute to a
-- wrong-but-CONCRETE goal, which is strictly worse than the missing one it replaces:
--   * a BARE tyvar bound by this scheme — `recordSchemeCallObligations` maps it through
--     the call's instantiation subst, exactly as the ids-only path always did;
--   * a GROUND argument (no tyvars anywhere, `monoTyvarIds` empty) — it needs no
--     substitution, so the signature's mono IS the call's mono;
--   * #1937: a STRUCTURED argument whose tyvar leaves are ALL bound by this scheme
--     (`Conv (Wrap a) b =>`) — `substOblArgs` now walks `TApp`/`TFun` structurally and
--     substitutes at each leaf, so the caller's goal is `Conv (Wrap Char) Bool`, not the
--     signature's own cell.  Before that walk existed this class HAD to be dropped, and
--     the two halves must stay together: admitting without the structural walk
--     substitutes to a wrong-but-CONCRETE goal;
--   * nothing else.  An unbound tyvar — bare, or as a leaf of a structured argument —
--     has no id to defer on and is dropped exactly as before.
-- At least one bare bound tyvar is REQUIRED: a fully ground declared context (`Sz Int =>`)
-- carries no per-use obligation on this channel and stays dropped, which keeps the
-- narrowing to the shape the issue is about.
declaredOblMixed : List Int -> IfaceRef -> List (String, Mono) -> List Ty -> List VecObl
declaredOblMixed boundIds ifref tvMap args =
  let monos = map (fromAstType tvMap) args
  let ids = flatMap (declaredOblArgId boundIds) monos
  if isEmptyL ids || not (allList (declaredOblArgOk boundIds) monos) then
    []
  else
    [VecObl { voIface = ifref, voIds = ids, voArgs = monos }]

-- the scheme-quantified ids an argument defers on: the id itself for a BARE tyvar, and
-- since #1937 every scheme-bound tyvar LEAF of a STRUCTURED one (`Wrap a` ⇒ `a`), in
-- leaf order.  `[]` for a ground argument.  Duplicates are kept, exactly as the all-bare
-- path's `boundTyvarIds` keeps them for `Conv a a`.
declaredOblArgId : List Int -> Mono -> List Int
declaredOblArgId boundIds m = match normalize m
  TVar cell if containsI (tyvarId cell) boundIds => [tyvarId cell]
  TVar _ => []
  _ => filterList (id => containsI id boundIds) (monoTyvarIds m)

-- #1937: a STRUCTURED argument whose free ids are ALL scheme-bound now carries too.
-- The clause this replaces required a structured argument to be GROUND, because
-- `substOblArgs` substituted only at a top-level `TVar` and would have carried the
-- signature's own tyvar cell into the caller's goal.  That walk is now structural, so
-- the instantiation this admission promises is one the channel can actually perform;
-- the two halves are a single change (admitting without it substitutes to a
-- wrong-but-CONCRETE goal, strictly worse than the missing one it replaces).  An
-- UNBOUND tyvar anywhere in the argument is still refused — it has no id to defer on.
declaredOblArgOk : List Int -> Mono -> Bool
declaredOblArgOk boundIds m = match normalize m
  TVar cell => containsI (tyvarId cell) boundIds
  _ => allList (id => containsI id boundIds) (monoTyvarIds m)

-- the monos a predicate's arguments resolve to under a tyvar-name -> mono map, in
-- declaration order; None if ANY argument is not a plain tyvar or is absent from the
-- map (a partial vector is a DIFFERENT predicate, so the whole thing is dropped).
-- Shared by the declared-context sourcing and recordSigConstraintArgs.
constraintArgMonos : List Ty -> List (String, Mono) -> Option (List Mono)
constraintArgMonos [] _ = Some []
constraintArgMonos (a::rest) tvMap = match constraintArgMono a tvMap
  None => None
  Some mono => map (mono :: _) (constraintArgMonos rest tvMap)

-- the mono ONE predicate argument resolves to: None unless it is a plain tyvar
-- present in [tvMap] (a concrete-grounded argument like `Sz Int =>` carries no
-- per-use obligation here).
constraintArgMono : Ty -> List (String, Mono) -> Option Mono
constraintArgMono a tvMap = match constraintArgVarName a
  None => None
  Some v => lookupAssoc v tvMap

lookupSigTvMap : String -> List (String, Ty, List (String, Mono)) -> Option (Ty, List (String, Mono))
lookupSigTvMap _ [] = None
lookupSigTvMap m ((n, ty, tvMap)::rest)
  | m == n = Some (ty, tvMap)
  | otherwise = lookupSigTvMap m rest

-- #242: routed through the canonical O(n·log n) `support.util.dedupBy` (was a
-- private O(n²) `List`-as-a-set scan).  The iface name is length-prefixed and
-- the id VECTOR is comma-joined — ints carry no comma, so the encoding is
-- injective over both components.
-- ⚠️ Keyed on the SPELLING (`voIface.irName`), deliberately: this dedup decides what a
-- binding's DISPLAYED and re-instantiated scheme context is, and keying it on identity
-- would split one printed `Num a =>` into two.  U1b (#1482) carries identity through the
-- payload without changing what counts as the same entry.
dedupVecObls : List VecObl -> List VecObl
dedupVecObls xs = dedupBy vecOblKey xs

-- #1161: the GROUND half of the vector joins the key.  `(Ix a Bool, Ix a Char)` is two
-- predicates sharing one interface AND one id vector — without the ground positions the
-- dedup would collapse them into one, silently dropping half a declared context.  An
-- ids-only entry contributes a constant empty suffix, so its key is order-equivalent to
-- the pre-widening one.
-- S-nonlead-arg-identity (#1904) made `oblArgKey` structural and id-carrying.  On THIS
-- channel that is mostly redundant — `voIds` already carries every position's id — but
-- not entirely: `voIds` is a FLATTENED concatenation with no position boundaries, so
-- `Ix (Pair a b) (Pair c d)` and `Ix (Pair a c) (Pair b d)` shared both `voIds` and the
-- old head-name-only suffix.  The partition this key induces is strictly FINER than
-- before and identical on bare-tyvar vectors (the shape `dedupVecObls`' spelling caveat
-- above is about), so a printed `Num a =>` still does not split.
vecOblKey : VecObl -> String
vecOblKey o = "\{lenKey o.voIface.irName}\{joinWith "," (map intToString o.voIds)}|\{joinWith "," (map oblArgKey o.voArgs)}"

-- S-nonlead-arg-identity (#1904): ONE predicate-argument position, rendered as a
-- PREFIX-FREE PREORDER of the normalized mono, so the key REALISES the sprint's settled
-- notion of "same predicate" — pointwise `monoSameGiven` over the vector — rather than a
-- weaker local one.  Every arm below mirrors an arm of `monoSameGiven`:
--   * `TVar` keys on the tyvar's IDENTITY, not on its mere presence.  This is the whole
--     fix: the old encoding keyed EVERY tyvar position as the constant "*", so
--     `(Ix a b c, Ix a c b)` rendered `Ix|*,*,*` twice and `dedupSlotVecs` collapsed two
--     predicates into ONE dict slot (#1904, S0: `ix n x y + ix n y x` summed 333+333
--     instead of 333+111).  `vecOblKey` survived that only because `voIds` carries every
--     position's id in a SECOND component; `cslotVecKey` composes `cslotKey`, which
--     carries the LEAD id alone (`csId`), so it had no per-position id anywhere.
--   * `TCon`/`TRigid` fold to the same rendering because `monoSameGiven` equates them by
--     name across those two constructors.
--   * `TApp`/`TFun` recurse structurally, so the key sees the SPINE, not just the head —
--     `Ix (Pair a b) (Pair c d)` and `Ix (Pair a c) (Pair b d)` are now distinct, where a
--     head-name-plus-flattened-ids encoding (`xmodOblArgId`'s shape) would tie.
-- ⚠️ TWO deliberate residual under-splits, both PRE-EXISTING and neither widened here:
--   * TYCON ORIGIN is dropped (name only, as `headTyconNameMono` always did).  It cannot
--     be folded into a key string at all: `sameTyConHead`'s absent-origin arm is
--     non-transitive, so no string equivalence can realise it.
--   * `TEff` (the only remaining arm) keys as "*", where `monoSameGiven` answers False
--     even against itself.  An effect row in a predicate-argument position keys exactly
--     as it did before this change.
-- Injectivity: each arm emits a self-delimiting tag — "v"+digits+"." , "c"+`lenKey`, and
-- the fixed-arity "a"/"f" — so a preorder walk parses back uniquely and the joined vector
-- key is injective over the vector.
-- ⚠️ RAW TYVAR IDS IN A KEY STRING: safe HERE, and not by an "ids are unique" claim.
-- `cslotKey` already folds the raw lead `csId` into this same key, and the non-lead ids
-- come from the SAME predicate occurrence in the SAME signature, normalized together.
-- Both `dedupSlotVecs` call sites compare keys only WITHIN one binding's slot list
-- (`expandSupersFix`'s frontier, `setFunConstraintEntry`'s declared prefix) and
-- `vecOblKey`'s `voIds` are equally raw — so this adds no exposure the lead id did not
-- already carry.  The G4 hazard at `registerPredGiven` is about `activeDictVars`, which
-- no key here consults.
oblArgKey : Mono -> String
oblArgKey m = match normalize m
  TVar cell => "v\{intToString (tyvarId cell)}."
  TCon name _ => "c\{lenKey name}"
  TRigid name => "c\{lenKey name}"
  TApp a b => "a\{oblArgKey a}\{oblArgKey b}"
  TFun a _ b => "f\{oblArgKey a}\{oblArgKey b}"
  _ => "*"

-- membership of ONE vector in the DECLARED set (reportUncoveredVec) — not a
-- dedup, and the declared set is a handful of entries, so it stays a scan.
containsVecObl : VecObl -> List VecObl -> Bool
containsVecObl _ [] = False
containsVecObl o (o2::rest) = o.voIface.irName == o2.voIface.irName && eqIntList o.voIds o2.voIds
  || containsVecObl o rest

eqIntList : List Int -> List Int -> Bool
eqIntList [] [] = True
eqIntList (a::xs) (b::ys) = a == b && eqIntList xs ys
eqIntList _ _ = False

-- the (iface, var-id VECTOR) entries of the obligations whose discriminating monos are
-- all quantified ids of this scheme.  Deduped on (iface, ids).
schemeObligationsOf : List Int -> List UObligation -> List VecObl
schemeObligationsOf boundIds obls =
  flatMap (vecOblOfPred boundIds) (flatMap oblPredOf obls)

-- #991: the impl-channel arm only — a call-channel obligation is re-instantiated from
-- `schemeObligationsRef` by its own path and contributes nothing here.
-- U1b (#1482): forwards the whole `IfaceRef`, not `.irName` — the obligation already
-- carries its occurrence identity and this is the channel that hands it to every later
-- re-instantiation.  An EMPTY dispatch vector contributes nothing.
-- The obligation's own `loc` travels WITH the predicate — see `residualVecObls`, whose
-- reduction poses a goal to the min⊑ selector and must attribute it to the recording
-- site rather than to whatever `currentLoc` holds at a group's close.
oblPredOf : UObligation -> List (IfaceRef, List Mono, Option Loc)
oblPredOf o = match o.oblProj
  OpMethodOcc typarams mty occ => match dispatchMonosOf typarams mty occ
    [] => []
    ds => [(o.pred.iface, ds, o.loc)]
  OpProjected => []

-- a single recorded predicate contributes ONE joint (iface, ids) entry iff EVERY one of
-- its dispatch monos is a bound tyvar of the scheme.  Before #607 the multi-mono case
-- fell into a `_ => []` wildcard and the obligation was DISCARDED — which is why an
-- unsatisfiable `Ix a i =>` reached neither the displayed scheme nor any caller's
-- obligation list, and `check` accepted it at exit 0 while the built binary did raw
-- pointer arithmetic.
-- #1549: a predicate whose argument vector is NOT all bare bound tyvars is no longer
-- simply discarded — it is first REDUCED by §3 entailment (`residualVecObls`), and the
-- residual that reduction leaves over this scheme's own quantified vars is deferred
-- here.  Dropping it outright is what severed `nest x = tagOf (Wrap x)` from its
-- `Tag a` (DICT-SEMANTICS §4 `gen` / §4.2 OD2).
vecOblOfPred : List Int -> (IfaceRef, List Mono, Option Loc) -> List VecObl
vecOblOfPred boundIds (iface, ds, loc) = match boundTyvarIds boundIds ds
  Some ids => [VecObl { voIface = iface, voIds = ids, voArgs = [] }]
  None => residualVecObls boundIds iface ds loc

-- ── #1549: residual reduction at `gen` ──────────────────────────────────────
-- DICT-SEMANTICS §4 `gen` makes a binding's principal context `P'` = "the predicates
-- DEFERRED to this binding", and §4.2 OD2 says a non-ground predicate defers to the
-- binder that quantifies its variables.  A predicate like `Tag (Wrap t)` is neither
-- deferrable as written (its head is concrete, so it is not `P'`) nor dischargeable
-- (its `t` is generalizable): §3 `inst` reduces it against `impl Tag (Wrap a) requires
-- Tag a`, and the RESIDUAL `Tag t` is what defers.  Reducing here is what makes the
-- deferral OD2 already performs on the CHECK side (checkUndeterminedObligation RULE 2
-- defers `Tag t` "to the caller") actually reach a caller: without the residual in the
-- scheme there is no context for `(var)` to discharge and no `λd̄.` for `gen` to
-- abstract, so `check` was silent, `run` fell back to declaration order, and the built
-- binary read a dict word that was never passed (issue 1549, S0).
--
-- Deliberately the FALLBACK arm only: when every argument is already a bound tyvar the
-- predicate IS its own residual and the direct path above owns it, so this returns []
-- for that case and the behaviour of every predicate that reached a VecObl before is
-- unchanged.  A predicate mentioning none of this scheme's quantified vars can have no
-- residual over them either (grounding is monotone), and is rejected by the cheap guard
-- before any impl lookup — that keeps the common ground obligation (`Display String`)
-- off the reduction path entirely.
--
-- 🚨 [loc] IS LOAD-BEARING AND IS NOT DECORATION — DROPPING IT MOVES A DIAGNOSTIC.
-- `residualPredsOf` reaches `findMatchingImplReqsU`, which asks the min⊑ selector WHICH
-- impl matched — so this is a SECOND goal-posing site outside the five resolver drains
-- (the first is `checkNestedReqs`, whose header says the same thing).  When the goal is
-- ambiguous the selector calls `reportAmbiguousOverlap`, which reads `goalSiteLoc` and
-- falls back to `currentLoc` when it is `None`.  At a generalized group's close
-- `currentLoc` points at the LAST expression inferred, not at the site that recorded the
-- predicate; and because `pushTypeErrorOnceAt` dedups on the message, that badly-located
-- push WINS over the well-located one a later resolver drain would emit.
-- MEASURED on `test/dict_fixtures/s6-c1-rigid-goal-no-call-discriminator.mdk`
-- (`firstRow xss = index xss 0`): with the recorded loc dropped, the caret moved off the
-- `index` call at 29:15 onto the literal `0` at 29:25 — same code, same message, worse
-- span, and NO gate saw it because the dict-semantics gate asserted the code alone.
-- So publish the obligation's OWN snapshotted span for the duration of the reduction and
-- restore `None` after, exactly as `checkNestedReqs` does, per `goalSiteLoc`'s scoping
-- rule (outside a drain the selector must fall back rather than inherit a stale span).
residualVecObls : List Int -> IfaceRef -> List Mono -> Option Loc -> List VecObl
residualVecObls boundIds iface ds loc =
  map keepBoundResidual (residualBoundPreds boundIds iface ds loc)

-- S-inferred-vector-supply: the reduction itself, factored out of `residualVecObls` so
-- the DICT-ABSTRACTION channel can read the residual predicate's ARGUMENT MONOS and not
-- only the ids `VecObl` keeps.  ⚠️ ONE run per group: `registerInferredFor`'s vectors and
-- its slot ids are both projections of this one call (see `maybeInferConstraint`), so the
-- §3 entailment — and the `goalSiteLoc`-scoped diagnostics it can emit — fire exactly as
-- often as they did before this slice, not twice.
-- Each entry is (interface, the residual's bare-tyvar ids IN ORDER, the residual's whole
-- argument vector); a residual not entirely over this scheme's own quantified vars is
-- dropped, exactly as `keepBoundResidual` always dropped it.
residualBoundPreds : List Int -> IfaceRef -> List Mono -> Option Loc -> List (IfaceRef, List Int, List Mono)
residualBoundPreds boundIds iface ds loc
  | isSome (boundTyvarIds boundIds ds) = []
  | not (anyIn (flatMap monoUnboundIds ds) boundIds) = []
  | otherwise =
    goalSiteLoc := loc
    let preds = residualPredsOf residualReduceFuel iface ds
    goalSiteLoc := None
    flatMap (keepBoundResidualPred boundIds) preds

keepBoundResidualPred : List Int -> (IfaceRef, List Mono) -> List (IfaceRef, List Int, List Mono)
keepBoundResidualPred boundIds (iface, args) = match boundTyvarIds boundIds args
  Some ids => [(iface, ids, args)]
  None => residualMixedPred boundIds iface args

-- ── #1905: the INFERRED twin of `declaredOblMixed` (#1161 SYMPTOM 2) ─────────────
-- A residual that is not ALL bare bound tyvars used to be dropped here, and that drop is
-- #1549's exact defect one shape over: `useIx x = ix x 'z'` leaves the residual
-- `Ix t Char`, `boundTyvarIds` answered `None` on the `Char`, and the predicate reached
-- neither `useIx`'s scheme nor its callers' obligation lists — `check` printed
-- `useIx : a -> Int`, and `main = println (useIx 'q')` was accepted on all four verbs,
-- printing `222` out of `impl Ix Int Char`.  §4.2 OD2 says a non-ground predicate defers
-- to the binder that quantifies its variables and is discharged at each USE SITE, and
-- `VecObl` has carried exactly this mixed shape since #1161 — ids for the bare-tyvar
-- positions, the whole vector in `voArgs`, instantiated per call by `substVecOblArgs`.
-- MEASURED that the declared half already does the right thing on the identical body:
-- with `useIx : Ix a Char => a -> Int` written out, `useIx 5` runs and prints `222`
-- while `useIx 'q'` is rejected on check/run/build with
-- `No impl of Ix for Char Char` at the call site.  This makes the INFERRED context
-- reach the same verdict, which is §4 `(gen)`'s whole claim (OD6(a): declared and
-- inferred contexts defer identically).
--
-- 🚨 THE ADMISSION TEST IS `declaredOblMixed`'S, REUSED VERBATIM AND NOT RE-DERIVED —
-- `declaredOblArgOk` / `declaredOblArgId`, the same two functions, for the reason
-- `xmodVecObl`'s header states about ITS reuse of them: this is one fact about one
-- predicate recorded on three channels, and a channel admitting a wider argument class
-- than its siblings is a new divergence rather than a fix.  Since #1937 THREE argument
-- classes carry — a BARE tyvar bound by this scheme, a GROUND argument, and a STRUCTURED
-- argument all of whose tyvar leaves are bound by this scheme — and that third class
-- arrived on all three channels in one change, together with the structural
-- `substOblArgs` walk that makes it instantiable.  A structured argument mentioning an
-- UNBOUND tyvar is still dropped: it has no deferral target, and admitting something this
-- channel cannot instantiate substitutes to a wrong-but-CONCRETE goal, strictly worse
-- than the missing one it replaces.  At least one bound tyvar is required: a fully ground
-- residual has no deferral target on this channel and stays dropped.
residualMixedPred : List Int -> IfaceRef -> List Mono -> List (IfaceRef, List Int, List Mono)
residualMixedPred boundIds iface args =
  let ids = flatMap (declaredOblArgId boundIds) args
  if isEmptyL ids || not (allList (declaredOblArgOk boundIds) args) then
    []
  else
    [(iface, ids, args)]

-- ⚠️ `voArgs` IS THE ids-only `[]` FOR AN ALL-BARE RESIDUAL AND THE WHOLE VECTOR FOR A
-- MIXED ONE — the same split `declaredOblOne` makes between its own arm and
-- `declaredOblMixed`, so the OBLIGATION channel's readers (`substVecOblArgs`,
-- `dedupVecObls`, `reportUncoveredVec`) see, for each shape, precisely the shape they
-- have always seen from the declared channel.  Every residual that reached a `VecObl`
-- before this change is all-bare by construction (it came through `boundTyvarIds`), so
-- its entry is byte-identical; the mixed entries are the ones #1905 adds.
-- The argument vector the DICT channel consumes (`funConstraintArgsRef`) is the third
-- component of the triple and is unaffected by this projection.
keepBoundResidual : (IfaceRef, List Int, List Mono) -> VecObl
keepBoundResidual (iface, ids, args) =
  VecObl { voIface = iface, voIds = ids, voArgs = residualOblArgs args }

-- 🚨 #1937: THIS TEST USED TO BE `listLen ids == listLen args`, AND THAT EQUIVALENCE DIED
-- WITH THE ADMISSION WIDENING.  It relied on `declaredOblArgId` contributing exactly one
-- id per BARE-tyvar position and none for anything else, so equal lengths meant "every
-- position is a bare tyvar".  Now that a STRUCTURED argument contributes its own bound
-- leaves, `Conv (Wrap a) b` has two ids for two arguments and would have taken the
-- ids-only `[]` arm — instantiating through `substMonos o.voIds` to the goal `Conv a b`,
-- i.e. silently DROPPING the `Wrap`.  Ask the structural question directly instead.
residualOblArgs : List Mono -> List Mono
residualOblArgs args
  | allList isBareTyvarMono args = []
  | otherwise = args

isBareTyvarMono : Mono -> Bool
isBareTyvarMono m = match normalize m
  TVar _ => True
  _ => False

-- §3 `inst`, run for its RESIDUAL rather than for a verdict.  A predicate whose
-- arguments are not all concrete-headed is itself the residual (OD2 defers it); a
-- concrete-headed one is matched against the impl universe and replaced by that impl's
-- substituted `requires`, recursively.  No matching impl ⇒ no residual.
-- ⚠️ This used to add *"and this function must never invent a diagnostic of its own"*.
-- That has NOT been true since #1562 (`T-REQUIRES-DEPTH`, the fuel arm below) and is no
-- longer true of the `None` arm either: `unroutedResidual` splits it, and rejects the
-- half where an impl DOES match but its evidence cannot be routed — see its header.
-- 🚨 BUT DO NOT READ THE `None` ARM AS "SOMEONE ELSE REPORTS IT".  This comment used to
-- say the goal is *"unsatisfiable and `checkOneCallObligation`/`checkReqOne` own that
-- diagnostic"*, and that premise is FALSE for a PARTIALLY-GROUND vector — precisely the
-- class the `anyConcreteHead` widening newly admits here.  A fully-ground goal is indeed
-- owned by those checkers; a goal like `Conv (Wrap t) u` with no `Wrap`-headed impl is
-- not unsatisfiable-and-reported, it is UNRESOLVED AND SILENT.  MEASURED, and
-- byte-identical on this branch and on its base (so it is NOT a regression from this
-- change, and NOT something this change repairs): with `impl Conv Int Bool` as the only
-- impl, `h x y = conv (Wrap x) y` gives `check` exit 0, `run` exit 0 printing
-- `int-bool` — a `Wrap`-headed goal answered by `impl Conv Int Bool`, i.e. a WRONG VALUE
-- — and `build` exit 1 on an emitter `E-PANIC: no impl of method 'conv' for type 'Wrap'`.
-- `[]` here is therefore still the same representational conflation issue 1562 was about
-- ("no residual" and "no answer" are one value), one shape over; it is filed as issue
-- 1578 and is NOT this function's to fix silently.  ⚠️ That shape has NO `Wrap`-headed
-- impl anywhere, so `unroutedResidual`'s existence test is False for it and it still
-- takes the silent `[]`: 1578 is untouched by Door 4, which splits off only the case
-- where an impl DOES match the goal.
-- ⚠️ A SECOND thing this arm's neighbourhood does NOT own: when the goal IS matched but
-- only the GENERAL member of a specific-vs-general overlap can match a partially-free
-- vector, committing to that impl's `requires` saddles the binding with a constraint its
-- real (more specific, `requires`-free) instance never demanded — a FALSE REJECT, issue
-- 1579, likewise measured byte-identical before and after the `anyConcreteHead` widening.
-- ⚠️ #1560: the terminal test is `anyConcreteHead`, NOT `allConcreteHeads`, and the
-- difference is an S0.  `allConcreteHeads` is ALL-OR-NOTHING on the vector, so a MIXED
-- argument vector — one argument concrete-headed, another a bare tyvar, e.g.
-- `Conv (Wrap t) u` — took the terminal arm, came back UNREDUCED, and was then dropped
-- by `keepBoundResidual` (whose `boundTyvarIds` rejects the non-bare `Wrap t`): exactly
-- 1549's drop, one shape over.  It needed no change to the matcher, which was the
-- reason recorded for deferring it: `matchStep` ALREADY matches per-argument and is
-- already safe on a free goal argument — an impl-head `TyVar` binds whatever is at that
-- position (`MVar`), while a CONCRETE impl-head pattern against an unbound goal var
-- takes `matchStep`'s `_ => MFail` arm.  So an impl is selected only when it is generic
-- exactly where the goal is still free, which is the per-argument reduction OD2 wants;
-- `impl Conv Int Bool` cannot be committed to for a goal `Conv (Wrap t) u`.  A vector
-- with NO concrete head anywhere is still terminal — it is its own residual (OD2), and
-- that arm is unchanged.
-- 🚨 THIS FIXES THE DROP, AND THE DROP IS ONLY LAYER 1 OF ISSUE 1560'S OWN REPRO.  When
-- the RESIDUAL is itself n-ary (n >= 2, `Conv t u`), the predicate now reaches the
-- scheme and the dict prefix — but `funConstraintsRef`'s dict slots are SHATTERED PER
-- TYVAR (`recordCallObligations`: *"1-ary by construction … Widening this to a joint
-- vector is the dict-slot=predicate change (#607 punch-list item 3), which moves emitted
-- arity and is deliberately NOT done here"*), so the conditional impl's `requires Conv a
-- b` has no JOINT dict to route to and `argReqRoute` resolves it to `RNone` — a literal
-- null element dict, and the binary still faults.  MEASURED, and INDEPENDENT of this
-- reduction and of every inference channel: write the context out by hand
-- (`f : Conv a b => a -> b -> String ; f x y = conv (Wrap x) y`) and a binary built from
-- `main` faults identically, while the same program with a SINGLE-parameter residual
-- (`impl Conv (Wrap a) b requires Tag a`) runs correctly on that same binary.  So issue
-- 1560's pin does not drain on this change and is deliberately retained.
-- ⚠️ The fuel bounds a cyclic instance (`impl C (Box a) requires C (Box a)`), which
-- would otherwise reduce forever.  EXHAUSTING IT USED TO BE SILENT (issue 1562, an S0):
-- `[]` is also what "no matching impl" returns, so the predicate was dropped and the
-- program landed back in 1549's exact defect — MEASURED, depth 31 fixed, depth 32 gave
-- `deep : a -> String`, check exit 0, binary 139.  It is now a located REJECT
-- (`T-REQUIRES-DEPTH`).  Raising the constant would not have been a fix — any finite
-- fuel has the same cliff; only making the cliff LOUD removes the silent wrongness.
-- ⚠️ THE GUARD ORDER IS LOAD-BEARING: the terminal test runs BEFORE the fuel test, so a
-- predicate that is ALREADY fully reduced when the fuel runs out is returned as the
-- residual it is rather than reported as too deep.  Ordering the fuel first would
-- reject a chain whose very next step was the answer.
residualPredsOf : Int -> IfaceRef -> List Mono -> List (IfaceRef, List Mono)
residualPredsOf fuel iface args
  | not (anyConcreteHead args) = [(iface, args)]
  | fuel <= 0 =
    let _ = pushTypeErrorOnceAt "T-REQUIRES-DEPTH" !goalSiteLoc (requiresDepthMsg iface args)
    []
  | otherwise = match findMatchingImplReqsU perRun.value.residualUnivRef.value iface args
    None => unroutedResidual iface args
    Some (subst, reqs) =>
      flatMap (residualPredOne fuel) (map (reqToObligation subst) reqs)

-- ── #1564 / Stage A "Door 4": the un-plumbed case is a LOUD reject ────────────
-- `residualPredsOf`'s `None` arm conflates TWO facts, and since the instance axis went
-- graph-global (ARCH A-3.6, issue 1112) they are no longer the same fact:
--   (a) NO impl of this interface matches these arguments anywhere — the ordinary
--       "nothing to reduce against" terminal, owned by the call/req checkers (and, for
--       the partially-ground shape, still under-reported: issue 1578).  Unchanged: [].
--   (b) an impl DOES match — `implMatchesU` says so over the very same `ImplUniverse`
--       this arm just consulted — but `findMatchingImplReqsU` could not hand back its
--       `requires`.
--       ⚠️ ARCH B-2.1-b2/-d: THE CAUSE STATED HERE HAS NARROWED, AND THE OLD WORDING WAS
--       LEFT BEHIND BY TWO BITES.  It read: "its concrete leg
--       (`concreteReqMatchByIface`) does not read that universe at all: it reads
--       `shadowKeyTableRef`, copied per module from the CUMULATIVE
--       `universeKeyBucketsRef` accumulator."  That is no longer true on the CONCRETE
--       leg — B-2.1-b2 repointed `concreteReqMatchByIface` onto the graph-global
--       `bodyImplEnvRef`, and B-2.1-d deleted both refs.  What SURVIVES is the same
--       shape one leg over: `findMatchingImplReqsU`'s HEADLESS fallback is
--       `firstReqMatch (univHeadless univ iface)`, still read off `residualUnivRef` —
--       the `ImplUniverse` projected at THIS module's ordinal, i.e. still a topological
--       prefix.  So candidacy can still span the whole module graph while the evidence
--       registry does not, and a goal whose only matching impl is HEADLESS and declared
--       in a module that sorts LATER than the goal's own is admitted with no requires,
--       no residual, no `λd̄.` slot and no route dict.
--       🚨 DO NOT read this narrowing as "(b) is fixed" — it is not, and this arm must
--       still reject.  The prefix-read fallbacks are `B-2.1-b2`'s own Item 3 residual,
--       re-confirmed untouched by `B-2.1-g`, and no probe has yet reached them in a way
--       that DIVERGES; that is a negative result, not a clearance.
-- (b) used to be impossible: before A-3.6 the same import order that starved the
-- evidence registry also starved candidacy, so the program was REJECTED (that is
-- issue 1564's false reject).  Afterwards it was ACCEPTED and MISCOMPILED — MEASURED on
-- `test/must_fail_fixtures/1564-import-order-decides-conditional-impl-candidacy`:
-- `check` exit 0 (`main : Unit`), `run` exit 1 `E-PANIC: putStrLn: not a String`,
-- `build` exit 0, and the built binary exit **139**, because `@mdk_impl_Wrap_tagOf` is
-- emitted arity-2 and called arity-1: the value cell lands in the dict slot and the impl
-- loads a function pointer out of it.
-- 🚨 SO THIS ARM MUST NOT FALL THROUGH TO `[]`.  Returning "no residual" for (b) is
-- exactly issue 1549's drop and exactly issue 1562's cliff, one cause over — and the
-- precedent for the remedy is `T-REQUIRES-DEPTH` on this same function, whose own note
-- states the principle: only making the cliff LOUD removes the silent wrongness.
-- ⚠️ WHAT THIS IS NOT.  It does not route the evidence and it does not make
-- DICT-SEMANTICS C4/I2 true — C4 is a conjunction ("consult the same instance set AND
-- produce the same evidence"), and only the first conjunct is delivered.  ⚠️ BOTH
-- DEFERRALS NAMED HERE HAVE NOW BEEN CASHED, AND C4 STILL DOES NOT HOLD: B-2.1-b2
-- repointed the CONCRETE reader at `IE` and B-2.1-d deleted `universeKeyBucketsRef`
-- rather than re-keying it (`TYPECHECK-TARGET-ARCHITECTURE.md`'s deferral row).  The
-- headless evidence leg is still prefix-read, so this arm still converts a segfault into
-- a located reject and nothing more; it drains when THAT leg moves, not before.
-- ⚠️ WHY THE TEST IS OVER THE SAME `univ`, and not a broader one: it is the EXISTENCE
-- twin of the matcher that just failed (same buckets, same
-- `implHeadMatchesArgs`/`implHeadSubst` success condition, same headless fallback), so
-- True-here-with-None-there isolates precisely the two-registry disagreement.  When both
-- registries agree that nothing matches, this is silent and (a)'s behaviour is
-- byte-identical to before.
--
-- ⚖️ RUN-055 (SA-4), owner ruling, 2026-08-12: THE TEST IS `implMatchesWithReqsU`, NOT
-- `implMatchesU`.  It shipped on the bare existence twin, which never asks whether the
-- matched impl HAS a `requires` — so it also converted the case where the correct answer
-- is `[]` on BOTH arms into a hard error.  MEASURED (R5-F2, and re-derived on this
-- change's own before/after arms): #1564's fixture with ONE variable changed — `impl Tag
-- (Wrap a)` carrying no `requires` — rejected with `T-REQUIRES-UNROUTED` while the
-- control order compiled to `define i64 @mdk_nest__nest(i64 %arg0)`, arity 1, with no
-- dict parameter anywhere.  For that shape the message's own claim ("accepting it would
-- build a program that reads a dictionary that was never passed") is simply false: no
-- dictionary is passed on either order.
-- 🚨 THIS IS AN ACCEPTANCE WIDENING and it RESTORES what BASE did — BASE never reached
-- this code at all.  Its could-not-pass-before fixture is leg 24 of
-- `test/diff_compiler_check_cli_modules.sh`.  The narrowing half is what must not move:
-- an impl that DOES carry `requires` still rejects (legs 24b/24c), and the disjunctive
-- form — ANY matching impl carries reqs, not the selected one — is the LOUD direction,
-- because the selector that would name the winner is the registry that just failed.
-- ⚠️ `implMatchesWithReqsU` is SA-1's, added at the sibling ground site
-- (`unroutedGroundReqs`) and reused verbatim here rather than re-derived: same buckets,
-- same concrete-then-headless order, same `implHeadMatchesArgs` success condition, one
-- extra `isNonEmptyL reqs` conjunct.  The two guards are now the SAME predicate, which is
-- also what keeps the shared message honest at both sites.
-- ── #1578 / #1905: case (a) REACHES A VERDICT, it no longer falls through to [] ──
-- The `| otherwise = []` this replaces was the silent half of the conflation the block
-- above names: "no impl matches" and "no residual" were one value, so the predicate
-- reached neither the binding's scheme, nor any channel's check, nor a diagnostic.  Both
-- measured shapes were exit-0 wrong answers (#1578 `h x y = conv (Wrap x) y` ran and
-- printed `int-bool` off `impl Conv Int Bool`; #1905 `useIx x = ix x 'z'` accepted
-- `useIx 'q'` on all four verbs and printed `222`).  DICT-SEMANTICS §4.2 gives exactly
-- two dispositions and this arm now picks between them rather than dropping the goal:
--   * OD1 — the goal is DECIDABLE here, so discharge it here.  `residualRefutableNow`
--     is the test, and it is the *structurally refutable* population OD1 enumerates,
--     not the *ground* one: the RECEIVER's head is a concrete tycon (hence stable —
--     grounding is monotone, no later substitution can move it) and NO impl of this
--     interface heads at that tycon or is headless, so `match(IE, π)` is empty now and
--     stays empty however the goal's remaining free arguments instantiate.  That is
--     #1578: `Conv (Wrap t) u` against a program whose only impl is `Conv Int Bool`.
--   * OD2 — otherwise the goal is its OWN residual and defers outward to the binder
--     that quantifies its variables, discharged at each use site by `(var)`.  That is
--     #1905: `Ix t Char` CAN still match `impl Ix Int Char` (`t := Int`), so rejecting
--     it here would be a false reject — MEASURED as a live accept, `useIx 5` prints
--     `222` and must keep doing so.  The verdict lands where it is decidable, at
--     `main`'s `useIx 'q'`.
-- ⚠️ THE OD1 ARM REPORTS THROUGH `T-NO-IMPL`, THE EXISTING CODE, AND MINTS NOTHING NEW.
-- `DIAGNOSTIC-CODES-DESIGN.md` draws the line at cause, and it already puts this arm on
-- that side: `T-NO-IMPL` is *"no instance matches"*, which both `T-REQUIRES-DEPTH`
-- ("instances matched all the way down and the chain did not bottom out") and
-- `T-REQUIRES-UNROUTED` ("exactly one instance matches and its evidence is unreachable")
-- are defined against.  A second code for the same fact reached one channel over would
-- be a taxonomy split, not a distinction — and `pushNoImplError` also carries the
-- derivable-iface / tuple-call hints, which apply here verbatim.
-- 🚨 THE OD2 ARM IS WHY `keepBoundResidualPred` HAD TO WIDEN IN THE SAME SLICE.  Handing
-- `[(iface, args)]` back here is necessary and NOT sufficient: `Ix t Char` is a MIXED
-- vector, and the ids-only `boundTyvarIds` filter one call up dropped every such
-- residual on the floor — the same drop, one shape over.  See `residualMixedPred`.
-- ⚠️ GUARD ORDER: the `implMatchesWithReqsU` arm stays FIRST and untouched (RUN-055 /
-- SA-4, above).  It is case (b) — an impl DOES match, its evidence cannot be routed —
-- and `residualRefutableNow` is False for it by construction (a matching impl is in one
-- of the two buckets the existence test reads), so the two arms cannot both fire.
unroutedResidual : IfaceRef -> List Mono -> List (IfaceRef, List Mono)
unroutedResidual iface args
  | implMatchesWithReqsU perRun.value.residualUnivRef.value iface args =
    let _ = pushTypeErrorOnceAt "T-REQUIRES-UNROUTED" !goalSiteLoc (requiresUnroutedMsg iface args)
    []
  | residualRefutableNow iface args =
    let _ = pushNoImplError iface.irName !goalSiteLoc args
    []
  | otherwise = [(iface, args)]

-- OD1's decidability test for this arm, and it is deliberately a CANDIDACY question
-- ("could any impl of this interface ever head-match this goal?") rather than the
-- MATCH question `findMatchingImplReqsU` just answered No to.  The difference is the
-- whole soundness of the reject: `Ix Int t` fails the match (a concrete impl-head
-- pattern against an unbound goal argument is `matchStep`'s `MFail`) while an
-- instantiation of `t` would satisfy it, so a reject keyed on the match would be a
-- false reject on every partially-free vector.  Candidacy keys on the RECEIVER head
-- alone, which is the one position `matchStep` can never recover by substitution once
-- it is a concrete tycon.
-- ⚠️ `goalHeadCon`'s `None` — a bare-tyvar receiver — is NOT refutable and must answer
-- False: that is #1905's own goal, and rejecting it is the false reject above.
-- 🚨 READ OVER `bodyImplEnvRef`, THE GRAPH-GLOBAL REGISTRY, NOT `residualUnivRef`.
-- Deliberate, and NOT a second selector: this is an existence read, the only decision it
-- makes is reject-vs-defer, and it is the twin of `ieCandidatesForIface` — same two
-- bucket reads (the goal head's own bucket plus the headless one), same
-- `ieRowIfaceMatches` comparator, minus the head-vector match candidacy must not apply.
-- `residualUnivRef` is the universe projected at THIS module's ordinal, i.e. a
-- topological PREFIX (Door 4's block above derives this at length); keying a REJECT on a
-- prefix would reject a program whose only matching impl is declared in a
-- later-sorting module — a false reject decided by module order, which is the exact
-- failure shape #1564 is.  Reading the graph-global registry fails toward DEFERRAL,
-- and a deferred goal still gets its verdict at the use site.
--
-- 🚨 #1939 / #1938 (OPEN WORLD): THE HEAD-CANDIDACY TEST IS NECESSARY BUT NOT
-- SUFFICIENT, AND ON ITS OWN IT REFUTES BY WHAT THE COMPILATION UNIT HAPPENS TO HAVE
-- LOADED.  The paragraph above argues candidacy is stable under substitution — true,
-- and it is the only thing the goal's OWN shape can make stable.  What it does NOT
-- establish is that `IE` is stable, and `IE` is not: the loaded module graph never
-- contains a module's DEPENDENTS, so `ieHeadCandidateExists` answering False means
-- *"no impl heads there IN THIS GRAPH"*, never *"no impl heads there"*.  For a goal
-- that is still open — any argument carrying a type VARIABLE, unification (`TVar`)
-- or declared-and-skolemized (`TRigid`) — that difference decides acceptance:
--   * #1939 shape (1): `f : Conv (Wrap a) b => Wrap a -> b -> String` with no `Conv`
--     impl in the file.  BASE rejected `f`'s DEFINITION (`No impl of Conv for Wrap a
--     b`) — a declared, never-called, perfectly legal constrained function.
--   * #1939 shape (2) / #1938: `medaka check <library module>`.  `a.mdk` infers `Conv
--     (Wrap α) β` for `h`; the satisfying `impl Conv (Wrap Int) Bool` lives in `b.mdk`,
--     which IMPORTS `a` and so is absent from `a`'s own load graph.  BASE rejected a
--     module that the whole project compiles fine.
-- ⇒ REFUTE ONLY A CLOSED GOAL.  A closed vector cannot instantiate further, so its
-- verdict is the one the use site would reach anyway and OD1 keeps its whole point
-- (`residualPredsOf` reaches here with ground `requires` vectors after a reduction
-- step, so this arm is not thereby dead).  An OPEN vector defers outward as OD2 —
-- `unroutedResidual`'s `otherwise` — and is adjudicated where it grounds, at the use
-- site, by `checkOneCallObligation`.  #1578 is exactly that: `Conv (Wrap α) β` now
-- defers out of `h`, and `main`'s `h 5 True` forces `Conv (Wrap Int) Bool`, which is
-- closed and still rejects.  The reject MOVED; it did not go away.
-- ⚠️ THIS IS AN ACCEPTANCE WIDENING ([W-QUIETER]) AND ITS NARROW HALF IS THE POINT:
-- the illegal siblings of both shapes still reject, one site further out.  Guarded in
-- both directions by `test/dict_fixtures/s-open-world-*`, plus the untouched #1578 /
-- #1905 rows whose REJECT verdicts are deliberately location-free.
residualRefutableNow : IfaceRef -> List Mono -> Bool
residualRefutableNow iface args = match goalHeadCon args
  None => False
  Some hk => monoVectorClosed args
    && not (ieHeadCandidateExists perRun.value.bodyImplEnvRef.value iface hk)

-- does this goal vector contain NO type variable at all?  Deliberately stricter than
-- `isEmptyL (flatMap monoUnboundIds args)`, whose `TRigid _ => []` arm reports a
-- DECLARED context's skolemized variables as if they were ground — which is #1939
-- shape (1) verbatim, so reusing it here would have left half the issue standing.
-- Same structural walk otherwise; `TCon` is a LEAF (`TCon String TyConOrigin`, no
-- argument list — application is `TApp`).
monoVectorClosed : List Mono -> Bool
monoVectorClosed args = allList monoClosed args

monoClosed : Mono -> Bool
monoClosed t = match normalize t
  TVar _ => False
  TRigid _ => False
  TCon _ _ => True
  TApp a b => monoClosed a && monoClosed b
  TFun a _ b => monoClosed a && monoClosed b
  TEff _ => True

-- The OPEN-WORLD defer test for the two OBLIGATION checkers (`checkOneCallObligation`,
-- `checkReqOne`), as opposed to `residualRefutableNow`'s bare `monoVectorClosed`.  The
-- residual site sits INSIDE a generalizing binding by construction — producing that
-- binding's context is its whole job — so an open goal there always has a scheme to
-- land on, and it never sees a bare-rigid receiver either (`goalHeadCon` is read for
-- candidacy, not for concreteness).  An obligation checker has neither guarantee, so it
-- asks all five questions.  Each conjunct's counterexample is on
-- `checkOneCallObligation`'s arm.
--
-- 🚨 CONJUNCTS 3 AND 5 ARE THE FIX-ROUND ADDITIONS (review S0-2 / S0-1 / S2-5), AND
-- THEY ASK THE ONE QUESTION THE THREE-CONJUNCT FORM NEVER DID: *does this goal have a
-- landing site that will actually be given a dict?*  "Defer" means "forward this
-- predicate outward to the binder that quantifies its variables, and let each use site
-- discharge it".  Where no such binder will carry it, "defer" means DROP, and a dropped
-- goal is a type-confused dict at exit 0 — MEASURED, three ways, all against the sprint
-- merge-base `0944ca9d` where every one of them was a located reject:
--   * S0-2 — `g : Tag (Wrap a) => a -> String ; g x = "…\{tagOf (Box x)}"`.  The goal
--     `Tag (Box a)` is NOT the declared context and a declared context cannot grow, so
--     it lands nowhere; HEAD printed `wrapChar|boxInt=123`, `Box Int`'s body applied to
--     a `Char`.  Conjunct 5.
--   * S0-1 — `f : Conv (Wrap a) Int => a -> String`.  The MULTI-PARAMETER goal has a
--     landing site (the declared context IS the goal) but no CONSUMPTION-side answer:
--     `registerPredGiven` matches `[subject]` only and registers nothing for a longer
--     vector, so `entailAssum` can never see it, `entail` falls to `entailInst`, and the
--     body is statically committed to whichever impl was most specific at ABSTRACTION
--     time while the caller's correct dict goes unread.  HEAD printed `T/T` for
--     `"\{f True}/\{f 41}"` (expected `T/n=42`), and swapping the two `impl` blocks
--     changed the answer to `intInt/intInt` — selection by declaration order, which
--     DICT-SEMANTICS §3 forbids outright.  Conjunct 5, via `goalMatchesGiven`, which is
--     deliberately `registerPredGiven`'s OWN shape: this gate admits exactly what that
--     registry can answer, so the two cannot drift into another silent accept.
--     ⚠️ SUPERSEDED AS A REJECT, NOT AS A RULE (#1956).  `registerPredGiven` is now keyed
--     on the WHOLE argument vector, so this exact program HAS a consumption-side answer:
--     `entailAssum` finds the declared context's dict and S0-1 is ACCEPTED, printing
--     `T/n=42` — the answer DICT-SEMANTICS §3 requires (assum before inst; the caller's
--     dict is used, not an abstraction-time commitment).  The invariant above is
--     unchanged and is what made the reject safe to lift: the gate still admits exactly
--     what the registry answers — the registry simply answers more.
--   * S2-5 — `data Bad = Bad zzz ; use (Bad v) = qq (Wrap v)`.  `zzz` is a `TRigid` no
--     scheme quantifies, so `monoUnboundIds` is empty and conjunct 4 passed VACUOUSLY —
--     the rigid-head forgery `monoHeadIsDecl` catches at the top level, leaking through
--     as soon as the rigid is NESTED inside a structure.  Conjunct 3 is the groundness
--     half made non-vacuous: a goal with no unbound variable at all has nothing for any
--     scheme to generalize, hence nowhere to defer TO.
--
-- ⚠️ CONJUNCT 5 FAILS OPEN ON PURPOSE, and that is what keeps #1939 shape (2) accepted.
-- `not (goalIdsClaimed …)` is the INFERRED-binding arm: `describe x = tag (Wrap x)` in a
-- library module reaches this gate BEFORE its own generalization has registered anything
-- (MEASURED on `test/dict_fixtures/s-open-world-library-dependent-impl/lib.mdk`: the
-- second check pass reaches the goal `Tag (Wrap α)` with an EMPTY given registry and no
-- `funConstraintArgsRef` row for `describe`), so its scheme is still open and the goal
-- is what will populate it.  A binding whose constraint set is already REGISTERED is
-- fixed — declared or inferred — and a goal claiming its variables must be in it.
--
-- ⚠️ MEASURED CORRECTION TO THE REVIEW'S STATED MECHANISM (report S0-2): a declared
-- context's variables are NOT `TRigid` at this site.  They are ordinary unbound `TVar`s
-- (`i2_unsound.mdk`'s `g` carries `Tag (Wrap TVar#736)` and its goal is
-- `Tag (Box TVar#736)` — the SAME cell), so conjunct 4 was never vacuous for S0-2; it
-- passed because the id genuinely IS deferrable.  The review's conclusion stands, its
-- mechanism does not, and conjunct 5 is keyed on the fact that was actually there.
goalDefersOpenWorld : IfaceRef -> List Mono -> Bool
goalDefersOpenWorld iface args = not (monoVectorClosed args)
  && allList monoHeadIsDecl args
  && isNonEmptyL (flatMap monoUnboundIds args)
  && allList (i => containsI i perRun.value.deferrableVarIds.value) (flatMap monoUnboundIds args)
  && (goalMatchesGiven iface args || goalSlotStillOpen args)

-- is there an in-scope PREDICATE-keyed given that answers this goal exactly?
-- Deliberately `registerPredGiven`'s own shape — the WHOLE argument vector, structural,
-- matched by `monoVecSameGiven` (pointwise `monoSameGiven` on rigid/cell IDENTITY) rather
-- than by unification — because the question this gate asks is not "is the goal
-- plausible" but "will `entailAssum` be handed a dict for it".
-- 🚨 THIS SHAPE AND `registerPredGiven`'s MUST MOVE TOGETHER, AND #1956 IS WHY BOTH MOVED
-- IN ONE STEP.  Widening the registry alone would let this gate keep answering False for
-- a multi-parameter goal the registry can now answer (a needless reject); widening this
-- gate alone would re-open exactly the S0-1 hole FIX-1 closed — a goal admitted to defer
-- with no consumption-side answer, i.e. a dropped predicate and a type-confused dict at
-- exit 0.  The invariant is that this gate admits EXACTLY what that registry can answer.
goalMatchesGiven : IfaceRef -> List Mono -> Bool
goalMatchesGiven _ [] = False
goalMatchesGiven iface args =
  anyGivenMatches iface.irName args perRun.value.activeDictPreds.value

anyGivenMatches : String -> List Mono -> List (String, List Mono, String) -> Bool
anyGivenMatches _ _ [] = False
anyGivenMatches iface args ((eiface, eargs, _)::rest) = eiface == iface && monoVecSameGiven eargs args
  || anyGivenMatches iface args rest

-- COULD a given for this goal still be registered, once the enclosing binding finishes
-- generalizing?  Both conditions are `registerPredGiven`'s own, because it is the only
-- writer that can ever answer a structured goal:
--   * NON-EMPTY.  It returns `()` for the empty vector and registers nothing, so an
--     empty goal can never acquire an answer.  (This used to read "ARITY 1", because the
--     registry matched `[subject]` only — #1956 replaced that narrowing with the whole
--     vector on all three channels (`requires`, declared, inferred), so a MULTI-PARAMETER
--     structured goal now DOES have a consumption-side answer and this arm no longer
--     withholds it.  The programs that pinned the old wording — `e1_inf_multi.mdk`
--     (`h x = conv (Wrap x) 0`, no signature) and its signatured twin `a2_twoarg.mdk` —
--     are re-measured against this widening, not assumed: see the S-nary-given report.)
--   * UNCLAIMED.  See below; this is the arm that keeps #1939 shape (2) accepted.
--     Asked of the vector's WHOLE unbound-id set, for the same reason the match above is
--     pointwise: a slot is open only if NO binding has already fixed a context claiming
--     any variable this predicate mentions, at any position.
goalSlotStillOpen : List Mono -> Bool
goalSlotStillOpen [] = False
goalSlotStillOpen args = not (goalIdsClaimed (flatMap monoUnboundIds args))

-- has some binding's constraint set ALREADY been registered against one of [ids]?  If
-- so that binding's context is fixed and this goal must be part of it; if not, the
-- binding is still generalizing and this goal is what will open its slot.  Reads
-- `funConstraintArgsRef`, which both channels write (`registerMember` for a declared
-- context, `registerInferredFor` for an inferred one), so the test does not distinguish
-- them — the fixedness, not the channel, is what decides.
goalIdsClaimed : List Int -> Bool
goalIdsClaimed [] = False
goalIdsClaimed ids = anyClaimRow ids perRun.value.funConstraintArgsRef.value

anyClaimRow : List Int -> List (String, List (List Mono)) -> Bool
anyClaimRow _ [] = False
anyClaimRow ids ((_, vecs)::rest) = anyList (v => anyList (m => anyIn (monoTyvarIds m) ids) v) vecs
  || anyClaimRow ids rest

-- is this argument's dispatch head a real type CONSTRUCTOR?  `headTyconMono`'s
-- `TRigid n => Some (HkRigid n)` arm is DICT-SEMANTICS §8 I6.1's known forgery — a type
-- PARAMETER name handed out as a dispatch key, preserved deliberately for answer
-- parity — and `HkRigid` exists precisely so a reader can tell the two apart.  This is
-- such a reader: a rigid head means the goal is not open in the way an open world can
-- close, it is a variable nothing will ever ground, and it must keep rejecting.
monoHeadIsDecl : Mono -> Bool
monoHeadIsDecl m = match headTyconMono m
  Some (HkRigid _) => False
  Some _ => True
  None => False

-- does ANY impl of [iface] head at [hk], or head at nothing at all?  The existence twin
-- of `ieCandidatesForIface`, and it reads the same two buckets in the same order for the
-- same reason: a fully-general `impl C a` matches every goal but heads at none (#1128
-- F-3b), so the headless bucket is part of candidacy at every head.
ieHeadCandidateExists : ImplEnv -> IfaceRef -> HeadKey -> Bool
ieHeadCandidateExists env iface hk = ieAnyRowForIface (ieHeadRows (Some hk) env) iface
  || ieAnyRowForIface (ieHeadRows None env) iface

-- ⚠️ `ieRowIfaceMatches`, NOT a bare `irName` compare — the SAME comparator
-- `ieEntriesForIface` admits a candidate row with, for the reason derived on its header
-- (two modules can spell one interface name and mean two interfaces).
ieAnyRowForIface : List ImplRow -> IfaceRef -> Bool
ieAnyRowForIface [] _ = False
ieAnyRowForIface ((ImplRow _ _ ir _ _ _)::rest) iface = ieRowIfaceMatches ir iface
  || ieAnyRowForIface rest iface

-- `T-REQUIRES-UNROUTED` (issue 1564).  Root-cause-honest: it must NOT say the impl is
-- missing, because it is not — saying so would send the reader off to write an `impl`
-- that already exists.  It names the impl as present, names the limitation as the
-- compiler's, and gives the edit that actually works today: import the defining module
-- (MEASURED on 1564's fixture — adding `import wrapimpl` to `nest.mdk` alone restores the
-- dict parameter and the program prints `wrap(int)`).
--
-- 🚨 ONE STRING, TWO CALL SITES, AND THAT SHARING IS LOAD-BEARING — see
-- `unroutedGroundReqs`.  `pushTypeErrorOnceAt` dedups on MESSAGE TEXT and a DEFERRED goal
-- reaches both guards, so any wording that differs between them DOUBLE-REPORTS at one
-- span (MEASURED: two `T-REQUIRES-UNROUTED` diagnostics at range 2:16-2:21, and #1564's
-- must-fail pin flipped to DRAINED on a live bug).  Reword it here or not at all.
--
-- ⚖️ SA-5 (RUN-055) — TWO CLAUSES WERE WRONG, and both were measured wrong, not argued:
--  1. *"route its evidence into the module where this binding is GENERALIZED"* is false
--     at the ground site: nothing is generalized at a fully-concrete use site, and that
--     site has reached this text since SA-1.  It now says "to this code".
--  2. The remedy sent the DECLARED-GIVEN shape to a dead end.  MEASURED on
--     `export nest : Tag (Wrap a) => a -> String`: adding the advised `import wrapimpl`
--     to `nest.mdk` does not make the program compile — it produces a DIFFERENT error,
--     *"Could not deduce 'Tag a' from the signature of 'nest' … add 'Tag a =>'"*.  The
--     import is necessary and is real progress; it is just not sufficient when the
--     signature is hand-written, because a declared context must carry every constraint
--     the body needs.  Saying only the first half reads as "do this and it works", so the
--     reader concludes the advice failed.  The text now says the import may not be enough
--     for a signatured binding and that the next error names the missing constraint —
--     which is what actually happens.
-- ⚠️ Do NOT fix (2) by splitting the text per shape.  That is exactly the double-report
-- above.  The wording must be true of the residual, ground and declared-given shapes at
-- once, which is why it is conditional ("if this binding carries a signature") rather
-- than shape-specific.
requiresUnroutedMsg : IfaceRef -> List Mono -> String
requiresUnroutedMsg iface args = "Cannot pass a dictionary for `\{iface.irName} \{ppPredArgsShared args}`: a matching `impl \{iface.irName} …` does exist in this program and is a candidate here, but this compiler cannot yet route its evidence to this code — the impl is declared in a module that this one does not import. This is a compiler limitation, not a missing impl: accepting it would build a program that reads a dictionary that was never passed. Add an `import` of the module that declares that impl to THIS module, or move this code into a module that already imports it. If this binding carries a hand-written type signature, that import is necessary but may not be sufficient: the signature must also declare every constraint its body needs, and the next error will name the missing one"

-- does at least ONE argument carry a concrete head tycon?  The per-argument twin of
-- `allConcreteHeads`: `False` means the whole vector is head-free, hence terminal for
-- §3 reduction (nothing to match an impl head against).  See `residualPredsOf` for why
-- the vector test must be ANY and not ALL — issue 1560.
anyConcreteHead : List Mono -> Bool
anyConcreteHead args = anyListM (m => isSome (headTyconNameMono m)) args

-- `T-REQUIRES-DEPTH` (issue 1562).  Named in the user's own vocabulary — the thing they
-- wrote is a `requires` clause, not a "residual reduction fuel" — and it states the
-- limit, the goal STILL OUTSTANDING after that many steps, and what to change.  This is
-- a REJECT, not a warning: continuing would drop the predicate from the binding's
-- context AND from its dict prefix, which is the S0 this replaces.
-- ⚠️ It renders the goal AT THE POINT OF EXHAUSTION, not the goal originally posed — at
-- depth 33 that reads `Tag (Wrap a)`, one level, which looks trivially shallow unless
-- the message says what it is.  Hence "still needed … after N steps"; the original goal
-- is not threaded here because doing so re-signs this helper for prose alone.
-- 🚨 ONE SHAPE REACHES THIS, NOT TWO.  An earlier revision (and the codes doc) claimed a
-- `requires` clause NAMING ITS OWN HEAD was a second reaching shape.  MEASURED, it is
-- not: `impl C (Box a) requires C (Box a)` makes `check`/`run`/`build` all abort at exit
-- 134 with `E-STACK-OVERFLOW`, identically on this branch and on its base — something
-- upstream of this fuel-bounded walk diverges first, so this diagnostic never fires for
-- it and advice written for that user is never delivered.  The crash is pre-existing and
-- is filed as issue 1575.  The only shape observed to reach here is genuine nesting
-- deeper than the bound, which is why the message no longer offers the self-naming
-- remedy.
-- ⚠️ Nor does this reject cover every deep chain: a GROUND `requires` chain past the same
-- depth never reaches this reducer at all (it is not deferred over a bound tyvar) and is
-- still silently accepted — issue 1562's shape on the path this fix cannot reach, filed
-- as issue 1576.  "1562 is fixed" means the DEFERRED cell, not every deep chain.
requiresDepthMsg : IfaceRef -> List Mono -> String
requiresDepthMsg iface args = "Cannot resolve this constraint: following the `requires` clauses of the matching impls exceeded the maximum depth of \{intToString residualReduceFuel}, and still needed `\{iface.irName} \{ppPredArgsShared args}` after \{intToString residualReduceFuel} steps. Each conditional `impl \{iface.irName} … requires …` discharged along the way adds one level. Reduce the nesting at this call site, or add a direct `impl \{iface.irName} …` for one of the types in the chain so resolution bottoms out sooner"

residualPredOne : Int -> (IfaceRef, List Mono) -> List (IfaceRef, List Mono)
residualPredOne fuel (iface, args) = residualPredsOf (fuel - 1) iface args

-- reduction depth fuse.  Matches the depth-32 bound the WS-4b entailment fuse (#217)
-- already uses for the same reason; no real instance chain approaches it.  Since #1562
-- crossing it is a REJECT (`T-REQUIRES-DEPTH`, `requiresDepthMsg`), never a silent
-- drop, so this constant is a reported limit rather than a hidden cliff — and it is
-- named in the message, so changing it changes user-visible text.
residualReduceFuel : Int
residualReduceFuel = 32

-- the residual predicates a group's recorded deltas leave over [boundIds] — the ids
-- half of what `vecOblOfPred` just deferred into the scheme, for the DICT-ABSTRACTION
-- channel (`registerInferredFor`).  Reads the same two deltas through the same two
-- projections, so the two channels cannot see different predicates.
-- ⚠️ ONE ID PER RESIDUAL PREDICATE — its RECEIVER (`leadInferredPred`), not every id in the
-- vector.  `registerInferredFor` opens one dict SLOT per id it is handed
-- (`registerActiveDictVars m 0 ids`), and the DIRECT channel next to it contributes one
-- id per predicate by construction: `methodSiteFns` stores the site's single dispatch
-- mono, so an inferred `Conv a b` from `g x y = conv x y` opens exactly ONE slot holding
-- the whole `Conv` dictionary.  Flat-mapping `voIds` here opened one slot PER ARGUMENT
-- instead — the residual channel disagreeing with the direct channel about what a dict
-- slot IS — which at n >= 2 gave the binding two dict parameters, left the conditional
-- impl's `requires` with no slot keyed on the receiver var to route to, and emitted a
-- NULL element dict.  MEASURED before/after on built binaries.  This is deliberately
-- NOT the "a dict slot is a predicate" change (#1318 / #607 item 3): it makes the
-- residual channel match the cardinality the direct channel already has, it does not
-- change that cardinality.
-- S-inferred-vector-supply (#1869): it now yields the (iface, LEAD id, ARGUMENT VECTOR)
-- triple rather than the lead id alone.  `map inferredPredLead` over the result is
-- byte-identically the id list this used to return — the cardinality note above is
-- untouched, ONE id per residual predicate — and the vector half is what
-- `registerInferredFor` records so an inferred slot stops degrading to the scalar goal.
residualInferredPreds : List Int -> List (IfaceRef, List Mono, Option Loc) -> List (IfaceRef, Int, List Mono)
residualInferredPreds boundIds preds =
  flatMap (residualInferredPredOf boundIds) preds

residualInferredPredOf : List Int -> (IfaceRef, List Mono, Option Loc) -> List (IfaceRef, Int, List Mono)
residualInferredPredOf boundIds (iface, ds, loc) =
  flatMap leadInferredPred (residualBoundPreds boundIds iface ds loc)

-- the DIRECT arm's twin: a predicate every one of whose arguments is already a bound
-- tyvar IS its own residual (`residualVecObls` returns [] for it by design), so its own
-- monos are the vector, and its lead id is the slot `inferredConstraintIds` opens from
-- the very same site through `methodSiteFns`/`dictAppFns`.
directInferredPreds : List Int -> List (IfaceRef, List Mono, Option Loc) -> List (IfaceRef, Int, List Mono)
directInferredPreds boundIds preds =
  flatMap (directInferredPredOf boundIds) preds

directInferredPredOf : List Int -> (IfaceRef, List Mono, Option Loc) -> List (IfaceRef, Int, List Mono)
directInferredPredOf boundIds (iface, ds, _) = match boundTyvarIds boundIds ds
  Some ids => leadInferredPred (iface, ids, ds)
  None => []

-- the receiver id of a deferred predicate — the one this scheme opens a dict slot for.
leadInferredPred : (IfaceRef, List Int, List Mono) -> List (IfaceRef, Int, List Mono)
leadInferredPred (iface, ids, args) = match ids
  id::_ => [(iface, id, args)]
  [] => []

inferredPredLead : (IfaceRef, Int, List Mono) -> Int
inferredPredLead (_, id, _) = id

-- the argument vector to record for the dict slot [id] of an inferred binding, whose
-- interface is [ifref]: the first deferred predicate that opened THIS slot.  Matching the
-- interface too is load-bearing — `registerInferredFor` opens ONE slot per id, so two
-- predicates on different interfaces (`Ix a b`, `Jx a c`) can share a lead id, and the
-- wrong one's vector would substitute to a wrong-but-concrete goal, which
-- `declaredConstraintArgs`' header measures as strictly worse than missing.
-- [] when nothing matches — the slot then keeps the scalar per-tyvar goal
-- (`substArgVec`'s empty arm) that EVERY inferred slot had before this slice, which is
-- the "leave it uncovered" arm, not an invented vector.
inferredVecFor : IfaceRef -> Int -> List (IfaceRef, Int, List Mono) -> List Mono
inferredVecFor _ _ [] = []
inferredVecFor ifref id ((pIface, pId, args)::rest)
  | ifref.irName /= "" && ifref.irName == pIface.irName && id == pId = args
  | otherwise = inferredVecFor ifref id rest

-- the tyvar ids of [monos], in order, iff EVERY mono is a TVar bound by this scheme;
-- None otherwise (a partial vector is a different predicate — never over-reject).
boundTyvarIds : List Int -> List Mono -> Option (List Int)
boundTyvarIds _ [] = Some []
boundTyvarIds boundIds (d::rest) = match normalize d
  TVar cell if containsI (tyvarId cell) boundIds =>
    map (tyvarId cell :: _) (boundTyvarIds boundIds rest)
  _ => None

schemeIds : Scheme -> List Int
schemeIds (Forall ids _ _) = ids

-- shatter vector obligations into (iface, id) pairs — the currency of the
-- coverage subset test.  See checkSigConstraintCoverage's header.
-- ⚠️ Drops to the SPELLING currency on purpose — the coverage (subset) test compares
-- an INFERRED constraint against a DECLARED one written in the same signature, which is
-- a "did you write this down" question, not an identity question.
pairsOfVecObls : List VecObl -> List (String, Int)
pairsOfVecObls [] = []
pairsOfVecObls (o::rest) = map (id => (o.voIface.irName, id)) o.voIds
  ++ pairsOfVecObls rest

-- ── signature-constraint soundness check ─────────────────────────────────────
-- For each SIGNED member, the interface constraints its body INFERS on the
-- member's own quantified vars must be covered by the DECLARED `=>` context,
-- closed under the interface `requires` (superclass) graph.  An uncovered
-- inferred constraint ⇒ def-site type_error (the constraint analogue of
-- checkEffectEscape).  Under #619 DECLARED-ONLY this is the SOLE enforcement of the
-- body's inferred obligations: registerSchemeObligations no longer merges them into
-- the scheme, so a body needing more than its signature declares is caught HERE or
-- silently severed.  The inferred obligations are the UNION of the flat-path
-- (schemeObligationsOf over addedObls), the FORWARDED path (forwardedVecObls over the
-- constrained-callee call delta — #619: a signed forwarder that under-declares is no
-- longer backstopped by the union, so it must be checked here), and the marked-path
-- (inferredConstraintIds + ifaceForInferredId) sources — a return-position-method
-- constraint lands only in the last.
-- #607: the PAIR test runs in (iface, var-id) currency on both sides — a multi-param
-- predicate is shattered per argument before the subset test (pairsOfVecObls /
-- declaredPairsFor).  Shattering both sides is sound for a COVERAGE (subset) question
-- — declared `Ix a i` covers inferred `Ix a` and `Ix i` — and it makes the reject
-- direction live at n>=2.  On its own it UNDER-rejects the exotic cross-pairing
-- (declared `Ix a b, Ix c d` vs inferred `Ix a d`: all four pairs a,b,c,d are declared,
-- so pair coverage passes though the JOINT `Ix a d` is undeclared).
-- #619/#607 item 4: reportUncoveredVec closes that gap — an inferred JOINT vector
-- (arity >= 2) whose EXACT argument vector is not among the declared vectors
-- (vector-valued superclass closure, censusSuperCloseVec / superSlotVecOf) is
-- uncovered, and is reported when the pair test did not already flag one of its args.
checkSigConstraintCoverage : List (String, List (IfaceRef, List Mono), List (List Mono)) -> List (String, Ty) -> List (String, Ty, List (String, Mono)) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> List (String, Scheme) -> Unit
checkSigConstraintCoverage _ _ _ _ _ [] = ()
checkSigConstraintCoverage regs sigs sigTvMaps callObls addedObls ((m, sch)::rest) =
  let _ = checkSigConstraintOne regs sigs sigTvMaps callObls addedObls m sch
  checkSigConstraintCoverage regs sigs sigTvMaps callObls addedObls rest

checkSigConstraintOne : List (String, List (IfaceRef, List Mono), List (List Mono)) -> List (String, Ty) -> List (String, Ty, List (String, Mono)) -> List (IfaceRef, List Mono, Option Loc) -> List UObligation -> String -> Scheme -> Unit
checkSigConstraintOne regs sigs sigTvMaps callObls addedObls m sch = match omLookup m driverState.value.sigTyMapRef.value
  None => ()   -- unsigned member: its inferred constraints are promoted, not checked
  Some _ =>
    let declaredPairs = censusSuperClose driverState.value.superDeclsRef.value (declaredPairsFor m regs)
    let inferredA = pairsOfVecObls (schemeObligationsOf (schemeIds sch) addedObls)
    let inferredFwd = pairsOfVecObls (forwardedVecObls (schemeIds sch) callObls)
    let inferredB = inferredIfacePairs m (schemeIds sch)
    let inferred = dedupPairs (inferredA ++ inferredFwd ++ inferredB)
    let _ = reportUncovered m sigTvMaps declaredPairs inferred
    let declaredVecs = censusSuperCloseVec driverState.value.superDeclsRef.value (declaredSchemeOblsFor sigTvMaps m (schemeIds sch))
    let inferredVecs = schemeObligationsOf (schemeIds sch) addedObls ++ forwardedVecObls (schemeIds sch) callObls
    reportUncoveredVec m sigTvMaps declaredPairs declaredVecs inferredVecs

-- inferred (iface, id) pairs from the marked path: each inferred constraint var id
-- paired with its recovered iface (skip an id whose iface can't be recovered).
inferredIfacePairs : String -> List Int -> List (String, Int)
inferredIfacePairs m boundIds =
  flatMap (pairIface m) (inferredConstraintIds m boundIds)

pairIface : String -> Int -> List (String, Int)
pairIface m id =
  let ir = ifaceForInferredId m id
  match ir.irName
    "" => []
    iface => [(iface, id)]

-- the declared (iface, id) constraint pairs of member m: each declared constraint
-- mono normalized to its surviving tyvar id (single-param shape; concrete-grounded
-- constraints — no tyvar — carry no dict slot and are skipped).
declaredPairsFor : String -> List (String, List (IfaceRef, List Mono), List (List Mono)) -> List (String, Int)
declaredPairsFor m regs = flatMap declaredPairOne (regIfaceMonosFor m regs)

-- #1161 (F-3a-ii): a reg is a triple, so its (iface, mono) component needs a named
-- accessor (`snd`/`lookupAssoc` no longer apply).  Both spellings — first-match by name,
-- and the whole-list projection — are exactly what the two consumers used before.
regIfaceMonosFor : String -> List (String, List (IfaceRef, List Mono), List (List Mono)) -> List (IfaceRef, List Mono)
regIfaceMonosFor _ [] = []
regIfaceMonosFor m ((n, ims, _)::rest)
  | m == n = ims
  | otherwise = regIfaceMonosFor m rest

regIfaceMonosOf : (String, List (IfaceRef, List Mono), List (List Mono)) -> List (IfaceRef, List Mono)
regIfaceMonosOf (_, ims, _) = ims

-- U1b (#1482): project a reg's (interface occurrence, mono) pair back to the SPELLING
-- for `groupConstraintMonosRef`, whose only reader (`dictVarSatisfiesIface`) compares
-- interface NAMES.
-- ⚠️ S-dict-arity-contract: a reg entry is now ONE PREDICATE carrying ALL its bare-tyvar
-- monos, so this fans back out to one (name, mono) pair per variable.  Collapsing the
-- SLOT must not collapse the READ-ONLY census this and `declaredPairOne` feed: they
-- answer "is this variable declared at this interface", not "how many dicts", and
-- dropping `b` from `Ix a b =>` would make a body use at `b` UNCOVERED — an
-- over-rejection of a program that type-checks today.
ifaceMonoName : (IfaceRef, List Mono) -> List (String, Mono)
ifaceMonoName (ir, monos) = map (mono => (ir.irName, mono)) monos

declaredPairOne : (IfaceRef, List Mono) -> List (String, Int)
declaredPairOne (iface, monos) =
  map (id => (iface.irName, id)) (abstractSlotIds monos)

-- UNGATED transitive super-closure over declared (iface, id) slots — mirrors
-- expandSupersPairs but WITHOUT the userIfaceNamesRef gate, so prelude super chains
-- (Applicative requires Mappable, Thenable requires Applicative, …) are included.
-- (The gated expandSupersPairs stays user-only because its slots drive dict arity;
-- this closure only feeds the read-only subset test, so gating is not needed here.)
censusSuperClose : List Decl -> List (String, Int) -> List (String, Int)
censusSuperClose allDecls declared =
  censusSuperCloseFix allDecls declared declared

censusSuperCloseFix : List Decl -> List (String, Int) -> List (String, Int) -> List (String, Int)
censusSuperCloseFix allDecls acc frontier =
  let next = dedupPairs (acc ++ flatMap (censusSuperSlotsOf allDecls) frontier)
  if listLen next == listLen acc then
    acc
  else
    censusSuperCloseFix allDecls next (dropN (listLen acc) next)

-- ⚠️ Drops each super slot back to the SPELLING currency (`csIface.irName`): this
-- closure only feeds the read-only coverage subset test, which asks "did the signature
-- declare this", not an identity question.  See `pairsOfVecObls`.
censusSuperSlotsOf : List Decl -> (String, Int) -> List (String, Int)
censusSuperSlotsOf allDecls (iface, id) = match ifaceSupersOf allDecls iface
  None => []
  Some (typarams, supers) =>
    let subst = zipL typarams (replicate (listLen typarams) id)
    map
      (sl => (sl.csIface.irName, sl.csId))
      (flatMap (superSlotOf subst) supers)

-- #619/#607 item 4: VECTOR-valued transitive super-closure over declared constraint
-- vectors.  Unlike censusSuperClose (which collapses each predicate to per-arg pairs),
-- this preserves the whole argument vector, so an inferred JOINT predicate can be
-- tested for membership as a unit — the exotic cross-pairing `Ix a d` is NOT a member
-- of {`Ix a b`, `Ix c d`} even though every one of its args appears in some declared
-- predicate.  Ungated (mirrors censusSuperClose) so prelude super chains are included.
censusSuperCloseVec : List Decl -> List VecObl -> List VecObl
censusSuperCloseVec allDecls declared =
  censusSuperCloseVecFix allDecls declared declared

censusSuperCloseVecFix : List Decl -> List VecObl -> List VecObl -> List VecObl
censusSuperCloseVecFix allDecls acc frontier =
  let next = dedupVecObls (acc ++ flatMap (censusSuperSlotsVecOf allDecls) frontier)
  if listLen next == listLen acc then
    acc
  else
    censusSuperCloseVecFix allDecls next (dropN (listLen acc) next)

-- the direct super vectors of one (iface, ids) predicate: the interface's typarams map
-- POSITIONALLY onto ids (so a multi-param super carries the right per-arg ids, not a
-- single shared one), and each `Super superName params` emits its own arg vector.
censusSuperSlotsVecOf : List Decl -> VecObl -> List VecObl
censusSuperSlotsVecOf allDecls o = match ifaceSupersOf allDecls o.voIface.irName
  None => []
  Some (typarams, supers) =>
    let subst = zipL typarams o.voIds
    flatMap (superSlotVecOf subst) supers

superSlotVecOf : List (String, Int) -> Super -> List VecObl
superSlotVecOf subst (Super { superHead = superName, superParams = params, superOrigin = so }) =
  let mapped = filterMaybeIds (map (p => lookupAssoc p subst) params)
  if listLen mapped == listLen params then
    [
      VecObl {
        voIface = IfaceRef { irName = superName, irOrigin = so },
        voIds = mapped,
        voArgs = [],
      }
    ]
  else
    []

-- one type_error per inferred JOINT vector (arity >= 2) whose exact vector the declared
-- (super-closed) set does not contain.  Skipped when the pair test already flagged one
-- of the vector's args (allPairsIn False) — so a genuinely absent constraint reports
-- ONCE, via reportUncovered, and only the cross-pairing (all args present, joint
-- vector absent) reports here.  Arity < 2 is fully handled by the pair test.
reportUncoveredVec : String -> List (String, Ty, List (String, Mono)) -> List (String, Int) -> List VecObl -> List VecObl -> Unit
reportUncoveredVec _ _ _ _ [] = ()
reportUncoveredVec m sigTvMaps declaredPairs declaredVecs (o::rest) =
  let _ = if listLen o.voIds < 2 then
    ()
  else if containsVecObl o declaredVecs then
    ()
  else if not (allPairsIn o.voIface.irName o.voIds declaredPairs) then
    ()
  else
    pushTypeError "T-MISSING-CONSTRAINT" (missingConstraintVecMsg m o.voIface.irName (map (varNameForId sigTvMaps m) o.voIds))
  reportUncoveredVec m sigTvMaps declaredPairs declaredVecs rest

allPairsIn : String -> List Int -> List (String, Int) -> Bool
allPairsIn iface ids declaredPairs =
  allList (id => containsPair (iface, id) declaredPairs) ids

missingConstraintVecMsg : String -> String -> List String -> String
missingConstraintVecMsg name iface varNames =
  let pred = joinWith " " (iface::varNames)
  "Could not deduce '\{pred}' from the signature of '\{name}'. Its body requires it; add '\{pred} =>' to the declared type"

-- one type_error per inferred (iface, id) not covered by the declared-closed set.
reportUncovered : String -> List (String, Ty, List (String, Mono)) -> List (String, Int) -> List (String, Int) -> Unit
reportUncovered _ _ _ [] = ()
reportUncovered m sigTvMaps declared ((iface, id)::rest) =
  let _ = if containsPair (iface, id) declared then
    ()
  else
    pushTypeError "T-MISSING-CONSTRAINT" (missingConstraintMsg m iface (varNameForId sigTvMaps m id))
  reportUncovered m sigTvMaps declared rest

containsPair : (String, Int) -> List (String, Int) -> Bool
containsPair _ [] = False
containsPair (i, d) ((i2, d2)::rest) = i == i2 && d == d2
  || containsPair (i, d) rest

-- recover the sig-tyvar NAME for a constraint var id (for a readable message);
-- falls back to "a" if the id isn't found among the member's sig tyvars.
varNameForId : List (String, Ty, List (String, Mono)) -> String -> Int -> String
varNameForId sigTvMaps m id = match findSigTvMap m sigTvMaps
  None => "a"
  Some tvMap => match findTvName id tvMap
    None => "a"
    Some n => n

findSigTvMap : String -> List (String, Ty, List (String, Mono)) -> Option (List (String, Mono))
findSigTvMap _ [] = None
findSigTvMap m ((n, _, tvMap)::rest)
  | n == m = Some tvMap
  | otherwise = findSigTvMap m rest

findTvName : Int -> List (String, Mono) -> Option String
findTvName _ [] = None
findTvName id ((n, mono)::rest) = match normalize mono
  TVar cell => if tyvarId cell == id then Some n else findTvName id rest
  _ => findTvName id rest

missingConstraintMsg : String -> String -> String -> String
missingConstraintMsg name iface varName = "Could not deduce '\{iface} \{varName}' from the signature of '\{name}'. Its body requires it; add '\{iface} \{varName} =>' to the declared type"

-- the member's own quantified tyvar ids that a body method site / propagated
-- constrained-call sits at (deduped, slot order = discovery order)
inferredConstraintIds : String -> List Int -> List Int
inferredConstraintIds m boundIds =
  dedupI
    (flatMap (boundTvarId boundIds) (sitesFor m perRun.value.methodSiteFns.value) ++ flatMap (monosTvarIds boundIds) (sitesFor m perRun.value.dictAppFns.value))

monosTvarIds : List Int -> List Mono -> List Int
monosTvarIds boundIds monos = flatMap (boundTvarId boundIds) monos

-- [mono] normalizing to a tyvar this scheme generalized → that (constraint var)
-- id; a pinned-concrete or foreign var → none
boundTvarId : List Int -> Mono -> List Int
boundTvarId boundIds mono = match normalize mono
  TVar cell => if containsI (tyvarId cell) boundIds then [tyvarId cell] else []
  _ => []

-- S-inferred-vector-supply (#1869): [vecs] carries the deferred predicates this
-- binding's slots were opened from, WITH their whole argument vectors, so an inferred
-- constrained binding records a real `funConstraintArgsRef` row instead of the hardcoded
-- `None` that made every inferred call site degrade to the scalar per-tyvar goal —
-- `useIx p q = ix p q` answering by DECLARATION ORDER while its signatured twin answered
-- by DICT-SEMANTICS §3.  The vectors are looked up per slot, keyed on (interface, lead
-- id), and a slot that matches nothing keeps `[]`, i.e. exactly its historical goal.
registerInferredFor : String -> List Int -> List (IfaceRef, Int, List Mono) -> Unit
registerInferredFor _ [] _ = ()
registerInferredFor m ids vecs =
  -- #994 (B-3-a): one `CSlot` per id, so the iface list is a `map` over the very list
  -- that is stored and cannot differ from it in length or order.  ⚠️ This moves
  -- `ifaceForInferredId`'s evaluation BEFORE the `funConstraintsRef` write (it used to
  -- sit in the second `setRef`'s argument, i.e. after it); that is sound only because it
  -- reads `implObls` / `schemeObligationsRef` / `dictApps` and NEITHER fn-constraint
  -- table — checked, since a recovery that consulted them would change answers here.
  let slots = map (id => CSlot { csIface = ifaceForInferredId m id, csId = id }) ids
  let slotVecs = map (s => inferredVecFor s.csIface s.csId vecs) slots
  let _ = setFunConstraintEntry m slots (inferredArgsOpt slotVecs)
  let _ = registerActiveDictVars m 0 ids
  -- #1909, the INFERRED twin of `registerMember`'s call: this writer is likewise ids-only
  -- (`registerActiveDictVars` above), so an inferred binding whose deferred predicate is
  -- STRUCTURED (`nest x = tagOf (Wrap x)`) had the same unreachable-`entailAssum` gap as
  -- the declared one, and OD6(a) (declared and inferred must agree) fails without it.
  -- The subject comes from the vector `inferredVecFor` already recovers per slot since
  -- #1869; a slot that recovered nothing carries `[]` and registers nothing, exactly as
  -- it did before.  See `registerSlotPredGivens` for why this adds no selector call.
  let _ = registerSlotPredGivens m 0 slots slotVecs
  perRun.value.promotedRef := (m::perRun.value.promotedRef.value)

-- N5 (inherited, slice 1): entry ABSENCE means "no argument vector was recorded for this
-- callee at all", and every reader turns it into `(slot, [])` — the historical scalar
-- per-tyvar goal, byte for byte.  A row of all-empty vectors reads identically at every
-- reader, same-module and cross-module alike, so writing one would only ADD a
-- `funConstraintArgsRef` / `crossModuleFunConstraintArgsQualRef` row that says nothing.
-- Recover nothing ⇒ write nothing, exactly as before this slice.
inferredArgsOpt : List (List Mono) -> Option (List (List Mono))
inferredArgsOpt vecs
  | allList isEmptyL vecs = None
  | otherwise = Some vecs

-- #23: the iface name for an inferred constraint var.  `ifaceForConstraintId` only
-- recovers it from a pendingImplObligation whose `occ` is a BARE `TVar id`; a
-- constraint induced by a `fromInt`/method site records a COMPOUND occ (the whole
-- method type), so it returns "" — leaving the call site's dict route unkeyed
-- (`routeUndeterminedTop ""` → RNone → a NULL Num dict word → build SIGTRAP, while
-- `medaka run` is correct).  Two FALLBACKS recover the name when ifaceForConstraintId
-- returns "" (so existing non-"" routes stay byte-identical):
--   (1) `schemeObligationsRef` pairs each scheme var with its iface via
--       `dispatchMonosOf` (robust to compound occs); covers a fn whose own body has
--       the literal/method site (`app2 f = f 2 3`).
--   (2) a constraint FORWARDED from a constrained callee (`useApp g = app2 g`) never
--       lands in pendingImplObligations/schemeObligations — its iface lives in the
--       `pendingDictApps` entry the callee's inferDictAtFound recorded (slot-parallel
--       monos/ifaces).  Scan it for the var at a slot whose iface is now known.
-- Both run AFTER the callee's own constraints are registered (topological SCC order),
-- so the forwarded callee's ifaces are populated.
-- U1b (#1482): returns an `IfaceRef`, since `funConstraintIfacesRef` now stores one.
-- Fallbacks (1) and (2) carry a real occurrence identity — `implObls` and
-- `schemeObligationsRef` both hold one.  Fallback (3) CANNOT and does not pretend to:
-- `pendingDictApps` stores a route WORD (see `resolveDictApps` / `dispHeadTab`), so its
-- recovery is bare by construction.  `ifaceRefNone` is the "no interface here" sentinel,
-- which is a different fact from "identity unrecoverable".
ifaceForInferredId : String -> Int -> IfaceRef
ifaceForInferredId m id =
  let direct = ifaceForConstraintId id
  if direct.irName /= "" then direct
  else match lookupSchemeIface m id perRun.value.schemeObligationsRef.value
    Some ir => ir
    None => match ifaceFromDictApps id perRun.value.dictApps.items.value
      "" => ifaceRefNone
      n => ifaceRefBare n

-- #837: keyed by member NAME only (the id here is a SCHEME-VAR id, not a binding
-- id) — match the name component of the (name, binding-id) key, first match wins.
lookupSchemeIface : String -> Int -> List ((String, Int), List VecObl) -> Option IfaceRef
lookupSchemeIface _ _ [] = None
lookupSchemeIface m id (((m2, _), obs)::rest)
  | m == m2 = match lookupIfaceById id obs
    Some iface => Some iface
    None => lookupSchemeIface m id rest
  | otherwise = lookupSchemeIface m id rest

-- the iface of the first recorded predicate whose ARGUMENT VECTOR mentions [id].
-- (#607: an obligation's ids became a vector; at arity 1 this is the old `id == oid`.)
-- This per-id recovery is inherently 1-ary — it answers "which interface constrains
-- this var", which for a multi-param predicate has no single right answer; it feeds
-- the dict-slot/route tables, whose per-tyvar shattering is punch-list item 3.
lookupIfaceById : Int -> List VecObl -> Option IfaceRef
lookupIfaceById _ [] = None
lookupIfaceById id (o::rest)
  | containsI id o.voIds = Some o.voIface
  | otherwise = lookupIfaceById id rest

-- Scan pendingDictApps for [id] at a slot (bare-TVar mono) whose iface is non-empty.
ifaceFromDictApps : Int -> List (Ref (List Route), List Mono, List String, List (List Mono), Option Loc) -> String
ifaceFromDictApps _ [] = ""
ifaceFromDictApps id ((_, monos, ifaces, _, _)::rest) = match ifaceAtMonoId id monos ifaces
  Some s => s
  None => ifaceFromDictApps id rest

ifaceAtMonoId : Int -> List Mono -> List String -> Option String
ifaceAtMonoId _ [] _ = None
ifaceAtMonoId _ _ [] = None
ifaceAtMonoId id (m::ms) (i::is) = match normalize m
  TVar cell =>
    if tyvarId cell == id && i /= "" then
      Some i
    else
      ifaceAtMonoId id ms is
  _ => ifaceAtMonoId id ms is

-- recover the interface name of an INFERRED constraint var (unsignatured fn like
-- `f x = x + 1`): the var was recorded in a pendingImplObligation by the method
-- occurrence that induced the constraint (`+` → a `Num <thisvar>` entry).  Slot-
-- aligned with registerInferredFor's id list.  "" if unresolvable — recordCallObligations
-- still pairs it positionally, and checkOneCallObligation with an empty iface finds no
-- matching impl head ⇒ it only fires for a CONCRETE-head mono whose iface genuinely had
-- no impl, which for an inferred Num constraint is exactly the hole we close.  A still-
-- polymorphic head defers regardless of iface, so a blank iface never over-rejects.
ifaceForConstraintId : Int -> IfaceRef
ifaceForConstraintId id =
  ifaceForConstraintIdGo id perRun.value.implObls.items.value

ifaceForConstraintIdGo : Int -> List UObligation -> IfaceRef
ifaceForConstraintIdGo _ [] = ifaceRefNone
ifaceForConstraintIdGo id (o::rest) = match o.oblProj
  OpMethodOcc _ _ occ => match normalize occ
    TVar cell =>
      if tyvarId cell == id then
        o.pred.iface
      else
        ifaceForConstraintIdGo id rest
    _ => ifaceForConstraintIdGo id rest
  OpProjected => ifaceForConstraintIdGo id rest

registerActiveDictVars : String -> Int -> List Int -> Unit
registerActiveDictVars _ _ [] = ()
registerActiveDictVars m slot (id::rest) =
  perRun.value.activeDictVars := (id, dictParamName m slot)::perRun.value.activeDictVars.value
  registerActiveDictVars m (slot + 1) rest

-- Render accumulated type errors as `TYPE ERROR: <msg>` lines (in order of
-- occurrence — typeErrors accumulates newest-first, so reverse).
typeErrorLines : List String -> List String
typeErrorLines [] = []
typeErrorLines (e::rest) = "TYPE ERROR: " ++ e :: typeErrorLines rest

export
checkToLines : List Decl -> String
checkToLines prog =
  let schemes = checkProgramSchemes [] prog
  let progCe = flatClassEnvOf prog
  let progIe = flatImplEnvOf prog
  -- #1559 A-3.7: ONE `IE`, passed for both roles — this path is prelude-free (see the
  -- note below), so its coherence population and its cycle/super population are the
  -- same `prog`, exactly as the two `CE` arguments already were.  `hasPrelude = False`:
  -- `flatImplEnvOf` puts this single module at ordinal 0, so filtering ordinal 0 here
  -- would drop every row and silently switch flat coherence off.
  let _ = runFinalChecks prog prog progCe progCe progIe progIe 0 False
  let errs = reverseL perRun.value.typeErrors.items.value
  match errs
    [] => joinNl (schemeLines schemes)
    _ => joinNl (typeErrorLines (map tcMsg errs))
-- coherence over the WHOLE prog: this path (typecheck_main single-arg) is
-- prelude-free, so every impl is a user impl (mirrors check_program_no_prelude).

-- #415 item 1: the seeding PREAMBLE every runtime-seeded entry point runs before its
-- typecheck pass — the head half of the sandwich whose tail is `runFinalChecks`.
-- [oracleDecls] is the decl set the ctor oracle is built from: the ONE axis the callers
-- legitimately differ on (the flat paths pass `prog`; checkModuleFullDiags passes
-- `prog ++ accData` own-module-FIRST — see the P0-9 note there, that order is load-bearing).
-- matchWarnings is cleared explicitly because resetState does NOT clear it.
-- Call ORDER is preserved from the four bodies this replaces.
seedCheckRun : List Decl -> Unit
seedCheckRun oracleDecls =
  driverState.value.implInferEnabled := False
  driverState.value.matchWarnings := []
  driverState.value.matchOracle := buildOracle oracleDecls

-- #415 item 1: seed-and-run for the three FLAT runtime-seeded entry points
-- (checkToLinesWithRuntime / checkErrorsWithRuntime / checkProgramDiags).  All three
-- used to repeat this body verbatim under a "Mirrors checkToLinesWithRuntime's
-- side-effects EXACTLY" comment — a mirror obligation enforced only by that comment.
-- They now differ ONLY in what they HARVEST from the accumulators afterwards, so the
-- seeding+coherence they share has exactly one body and cannot drift.
-- ⚠️ trap #5, same as runFinalChecks: coherence sees the driver-staged USER decls only,
-- NEVER `prog`.  A user impl deliberately overrides a seeded prelude impl, so feeding
-- the seeded set to checkCoherence false-positives on the stdlib itself.
seedAndCheckSplit : List Decl -> List Decl -> List Decl -> List (String, Scheme)
seedAndCheckSplit runtimeDecls coreProg userProg =
  let prog = coreProg ++ userProg
  -- ⚠️ THE ORACLE'S PRELUDE HALF IS STAMPED HERE AND `prog`'s IS NOT, AND THE
  -- ASYMMETRY IS THE POINT.  `matchOracle`'s `typeCtors` is the one table keyed
  -- by DECLARATION IDENTITY (`frontend/exhaust.mdk`), so its rows have to be
  -- minted from the SAME origin the READER's key is minted from.  The reader's
  -- key comes from `matchCol0Type` → `headTyconMono` → the scrutinee `Mono`'s
  -- `TCon` origin, and on THIS path that origin is written by the
  -- `stampDeclOrigins "core" coreProgTy` call inside `checkProgramSeededSplit`
  -- (`frontend/resolve.mdk`'s #1227 note) — on the very next line, over this
  -- same `coreProg`.  Feeding `buildOracle` the UNstamped copy therefore made
  -- the writer mint `TkBare NsType "Option"` for a type whose reader mints
  -- `TkIdent (Ident NsType (IdentModule "core") "Option")`; `tabKeyEq` never
  -- equates those, so under the ONE ABSENCE RULE every prelude-typed column-0
  -- lookup MISSED — and a `bindCtors` miss is LOUD, not silent (`defaultMatrix`
  -- keeps only wildcard-headed rows, so an all-ctor-headed matrix goes empty and
  -- `useful _ _ [] _ = True`), which is why the unstamped form put a spurious
  -- `non-exhaustive match of 'Ordering'` on `main = println 1`.
  --
  -- ⚠️ Same id, same decls, same call — NOT an invented module id, so the
  -- "over-supplying is not correctable" bound in `stampDeclOrigins`' comment is
  -- not being widened.  `fillDeclOrigin` fills only a still-`OriginUnresolved`
  -- origin, so this is idempotent and cannot re-stamp an identity-bearing decl.
  --
  -- ⚠️ `prog` itself is deliberately left alone: its readers here
  -- (`runFinalChecks`' cycle walk, `flatClassEnvOf`, `flatImplEnvOf`) are the
  -- ones that work today, and widening the stamp to them is a separate question
  -- with its own blast radius.  `buildOracle` reads `DData` only, and of its four
  -- tables only `typeCtors` reads an origin — the other three stay name-keyed —
  -- so the blast radius of this line is exactly that one table's keys.
  let _ = seedCheckRun (stampDeclOrigins "core" coreProg ++ userProg)
  -- #1280: prelude boundary in hand — see `checkProgramSchemesWithRuntime`.
  let schemes = checkProgramSeededSplit (externSchemes (externTyOriginScope coreProg) runtimeDecls) coreProg userProg
  -- #1557 A-3.5c: TWO envs, because the two decl lists differ here and always have —
  -- phantom-methods sees the driver-staged USER decls (trap #5, the same set
  -- coherence sees), the cycle walk sees the whole seeded `prog` so a user interface
  -- can close a cycle through a PRELUDE superinterface.
  let userDecls = driverState.value.coherenceUserDecls.value
  -- #1557 A-3.5b: the `IE` peer is built from `prog` — the SAME list this call passes
  -- as [cycDecls], i.e. the whole seeded universe the super-existence query used to
  -- scan — so the population question is "does IE over that list equal that list",
  -- not a new one.
  -- #1559 A-3.7: TWO `IE`s, because the two decl lists differ here — the same split
  -- the two `CE`s above already carry.  Coherence's env is built from [userDecls], the
  -- driver-staged USER boundary (trap #5); handing it `flatImplEnvOf prog` instead
  -- would feed it the seeded prelude and false-positive on the stdlib itself.
  -- `hasPrelude = False` on both counts: there is no prelude in [userDecls], and
  -- `flatImplEnvOf` seats its one module at ordinal 0, which the carve-out must not
  -- filter.  This is the Flat arm's prelude boundary, and it is a DECL LIST, which is
  -- why `coherenceUserDecls` does not retire in this unit.
  let _ = runFinalChecks userDecls prog (flatClassEnvOf userDecls) (flatClassEnvOf prog) (flatImplEnvOf userDecls) (flatImplEnvOf prog) 0 False
  schemes

-- like checkToLines but seeds runtime.mdk's externs (for typechecking core.mdk,
-- which references putStrLn / etc. declared in runtime.mdk).  [coreProg] is the PRELUDE
-- the caller would otherwise have pre-concatenated onto [userProg]; keeping the two
-- apart is what lets the flat path scope shadow-hood per module (SHADOW-SEMANTICS S1 —
-- see flatShadowScopingRef).  Prelude-free callers pass [].
export
checkToLinesWithRuntime : List Decl -> List Decl -> List Decl -> String
checkToLinesWithRuntime runtimeDecls coreProg userProg =
  let schemes = seedAndCheckSplit runtimeDecls coreProg userProg
  let errs = reverseL perRun.value.typeErrors.items.value
  let warns = map tcMsg (reverseL driverState.value.matchWarnings.value)
  match errs
    [] => joinNl (schemeLines schemes ++ warns)
    _ => joinNl (typeErrorLines (map tcMsg errs))
-- B5: seed the exhaustiveness oracle and clear any stale match warnings so the
-- composed check.mdk path surfaces non-exhaustive-match warnings, mirroring the
-- OCaml oracle's `medaka check` output.

-- coherence over the USER decls the driver staged (NO prelude) — empty when the
-- driver staged nothing (golden/profile paths) ⇒ no check, byte-identical.

-- G1 (SOUNDNESS): does the runtime-seeded typecheck pass produce any TYPE ERROR?
-- Shares checkToLinesWithRuntime's seeding + coherence BY CONSTRUCTION (the one
-- seedAndCheckSplit body), and differs only in the harvest: a Bool keyed on the
-- typeErrors accumulator, ignoring the success-path scheme dump and the match WARNINGS
-- (which are not errors).  Used by check.mdk's checkHasErrors to gate the CLI exit code
-- WITHOUT altering runCheck's reported stdout.
export
checkErrorsWithRuntime : List Decl -> List Decl -> List Decl -> Bool
checkErrorsWithRuntime runtimeDecls coreProg userProg =
  let _ = seedAndCheckSplit runtimeDecls coreProg userProg
  match perRun.value.typeErrors.items.value
    [] => False
    _ => True

-- ── type-aware non-exhaustive-match check (the `check_match` driver) ────────
-- Run the full typecheck pass over [prog] (runtime externs seeded, NO prelude —
-- mirrors the reference's check_program_no_prelude oracle) and return one
-- `Warning: non-exhaustive match …` line per `match` that isn't exhaustive.
-- The oracle is built from the program's own data decls + the syntactic builtins
-- (same set check_match's env-backed oracle has in the no-prelude path).  Diffs
-- against `dev/diagdump.exe --check-match` (the harness sorts).
export
checkMatchToLines : List Decl -> List Decl -> String
checkMatchToLines runtimeDecls prog =
  driverState.value.matchWarnings := []
  driverState.value.matchOracle := (buildOracle prog)
  -- #1280: prelude-flattened probe entry — builtins-only scope, see `elaborateDict`.
  let _ = checkProgramSeeded (externSchemes (externTyOriginScope []) runtimeDecls) prog
  joinNl (map tcMsg (reverseL driverState.value.matchWarnings.value))

-- ── diagnostics entry point (compiler/diagnostics.mdk bridge) ────────────
-- Run the full typecheck pass (runtime-seeded) over [prog] and return the
-- accumulated errors and non-exhaustive-match warnings as `TcDiag`s — each
-- carrying its own code, span (B.10.2b / S4), message, and optional help/fix —
-- so diagnostics.mdk maps them straight to structured `Diag` values.
export
checkProgramDiags : List Decl -> List Decl -> List Decl -> (List TcDiag, List TcDiag)
checkProgramDiags runtimeDecls coreProg userProg =
  let _ = seedAndCheckSplit runtimeDecls coreProg userProg
  (
    reverseL perRun.value.typeErrors.items.value,
    reverseL driverState.value.matchWarnings.value,
  )

-- ── multi-module typecheck (bootstrap front-end) ───────────────────────────
-- Threads per-module exports in dependency order.  The prelude (core) is checked
-- ONCE and ALL its schemes + ctors seed every module (it's implicitly visible);
-- each compiler module then contributes only its PUBLIC value schemes — private
-- helpers stay module-local, so same-named helpers across modules never collide
-- (the per-module-frame property, without a frame) — plus its public ctors.
-- Returns each module's OWN value schemes, in load order.

-- typecheck one program with seeded value schemes + accumulated data decls.
-- Like checkProgramSeeded but ALSO re-registers prior modules' public data decls
-- (`accData ++ prog`) so imported constructors AND named-field-variant record
-- info (e.g. ast's DInterface) resolve.  Returns the module's own value schemes.
checkModuleFull : List (String, Scheme) -> List Decl -> List Decl -> List (String, Scheme)
checkModuleFull seedVars accData prog =
  checkModuleFullImpl "" seedVars accData [] prog

-- E5: like checkModuleFull but takes [implDecls] (core + every EARLIER module +
-- this module) as the impl-body inference universe.  Under implInferEnabled (now ON
-- unconditionally) it ALSO infers THIS module's parametric impl
-- bodies — mirroring checkProgramSeeded's inferImplBodiesIfEnabled — so their
-- ARG-position ELEMENT dispatch (`eq`/`compare`/… on the impl head tyvar) reaches
-- inferMethodAt and lands in pendingArgStamps, which elabModuleStamp's
-- resolveArgStamps then stamps RDict (via the requires dict registered by
-- registerImplRequires).  [implDecls] gives ifaceMethodTy the interface decls
-- (core's Eq/Ord/…) AND lets a body dispatch against an earlier module's impl.
checkModuleFullImpl : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> List (String, Scheme)
checkModuleFullImpl mid seedVars accData implDecls prog =
  checkBodyImpl seedVars (Module mid accData implDecls) prog
-- C5: compute this module's standalone-shadow set BEFORE inference, so the
-- inferMethodAt arg-position record can gate on it (resetState cleared it via
-- pendingRLocalSites, but standaloneValuesRef is set fresh here per module).
--
-- Two flavours of standalone-shadow, BOTH needing RLocal recording so a method
-- call on a no-impl receiver routes to the standalone instead of mis-dispatching:
--   • IMPORTER shadow (`importerShadows`): a name imported from a sibling that is
--     also an interface method (box importing map's `toList`).  Its scheme must be
--     REBOUND to the interface-method scheme (`shadowMethodSchemes`) so the call
--     site types polymorphically; RLocal then redirects the no-impl receiver back.
--   • DEFINER shadow (`definerShadows`): a name THIS module defines as a top-level
--     funDef that ALSO names an interface method (map-as-root's own `toList` /
--     `isEmpty`).  The MARK pass (`buildStandaloneShadowsGraph`) rewrites these to
--     `EMethodAt`, so without a matching RLocal record the route falls back to the
--     result-type `RKey` (e.g. `toList`'s `List` result), dispatching the method on
--     the WRONG impl (List's `toList = identity`) → `debug`/`display` recurse on the
--     unchanged receiver forever (Map Debug/Eq/Ord impl bodies call standalone
--     `toList`).  These must be RECORDED for RLocal but must NOT be rebound to the
--     method scheme — their local standalone scheme (`Map k v -> …`) is what the
--     impl body types against.

-- E6: re-install the cross-module constraint accumulator that resetState just
-- wiped, so this module's `=>`-constrained call sites into EARLIER modules resolve.
-- Post-ARGSTAMP-UNIFY (Phase 4): eval and emit both thread dicts, so this runs
-- UNCONDITIONALLY on every path (single elaboration mode).

-- resetState wiped methodIfaceParamsRef; re-register it from the FULL impl
-- universe [implDecls] (core/earlier modules ++ this prog) so resolveSite's
-- ifaceParamMonos can recover a multi-param interface's full param monos (the
-- element grounding `e` for `FromEntries c e`).  The flat checkProgramSeeded does
-- the same against its whole-program [prog].  Without it the module path leaves the
-- table empty → ifaceParamMonos returns None → a Set/Map-literal return-position
-- `fromEntries` route drops its `Ord` element dict → null dict → SIGSEGV.

-- C5: a standalone-shadow method name (box's `toList`/`isEmpty`) is bound in
-- seedVars to its imported MONOMORPHIC standalone scheme (`Box k v -> …`), which
-- would shadow the polymorphic interface-method scheme and mis-type a genuine
-- method call (`isEmpty [1,2,3]` unifying List with Box).  Re-bind those names to
-- the graph-wide METHOD scheme so the call site types against the method (oracle
-- behaviour); RLocal then redirects only the no-impl receiver back to the standalone
-- at eval.  Mirrors lib/typecheck.ml: the EApp method-head arm types against the
-- method scheme even when standalone_values holds the name.
-- DEFINER shadows are EXCLUDED here: the module's OWN funDef (map-root's `toList`)
-- must type against its local standalone scheme (`Map k v -> List (k, v)`), not the
-- imported method scheme — the impl bodies call it ON a Map.  Only IMPORTER shadows
-- (imported-from-sibling method names) get the method-scheme rebind.

-- E5: infer this module's parametric impl bodies (gated, emit path only), seeing
-- [implDecls] for interface method types + cross-module impl dispatch.  The sites
-- it records stay in pendingArgStamps/pendingSites for elabModuleStamp to resolve.

-- C8(b): also infer THIS module's interface DEFAULT bodies (gated identically to
-- the single-file path's inferDefaultBodiesIfEnabled) so a default body's type
-- error is caught on the module path too — mirrors checkProgramSeeded.

-- Phase 4.55 (mirror checkProgramSeeded + lib/typecheck.ml:4254-4262): infer this
-- module's prop bodies so their prepass-marked EDictAt/EMethodAt routes resolve.
-- The multi-module test path (runPropsMulti) evaluates the ELABORATED prop body
-- against the dict-passed env, so the body's calls into the file's own promoted
-- `=>`-constrained fns (set's `wellFormed`/`fromList`) need their dict-arg routes
-- filled here — otherwise the call under-applies the dict-passed callee → not VBool
-- → every prop "fails".  funDefs ignores DProp, so without this the module path
-- never typed props at all.

-- E6: fold THIS module's freshly-registered fn-constraints into the cross-module
-- accumulator so a LATER module's call site finds them after its own reset.
-- Post-ARGSTAMP-UNIFY (Phase 4): unconditional on every path (single elaboration mode).

-- Shape A (gap #44): ground a container literal's free result-element var THROUGH
-- the unique impl's method type, so this module's pending sites/arg-stamps resolve
-- against the GROUNDED element (Set Int, not Set _a).  [implDecls] is the full impl
-- universe (core ++ earlier modules ++ prog), so the Set/Map impls are visible.

-- gate: per-module impl-body inference runs only on the emit path (implInferEnabled).
-- allProg = [implDecls] (interfaces + accumulated impls); rpNames computed over it.
-- #760: see checkModuleFullImpl for the check-path USER-impl inference (inferUserImplBodies)
-- that closes the missing-instance hole on the multi-module path without re-inferring core.
inferModuleImplBodiesIfEnabled : TcEnv -> List Decl -> List Decl -> Unit
inferModuleImplBodiesIfEnabled env implDecls prog
  | driverState.value.implInferEnabled.value =
    inferImplBodies env implDecls (returnPosMethodNames implDecls) prog
  | otherwise = ()

-- public top-level value names (the pub flag may sit on the sig, def, or extern).
-- C8(a): a PUBLIC interface ALSO exports its method names so an importer can see
-- their schemes (mirrors lib/typecheck.ml's pub_iface_schemes — methods of an
-- `is_pub = true` interface are appended to the exported value schemes).
publicValNames : List Decl -> List String
publicValNames [] = []
publicValNames ((DAttrib _ d)::rest) = publicValNames [d] ++ publicValNames rest
publicValNames ((DFunDef True n _ _)::rest) = n :: publicValNames rest
publicValNames ((DTypeSig True n _)::rest) = n :: publicValNames rest
publicValNames ((DExtern True n _)::rest) = n :: publicValNames rest
publicValNames ((DInterface { pub = True, methods, ... })::rest) = ifaceMethodNames methods
  ++ publicValNames rest
publicValNames (_::rest) = publicValNames rest

ifaceMethodNames : List IfaceMethod -> List String
ifaceMethodNames [] = []
ifaceMethodNames ((IfaceMethod n _ _)::rest) = n :: ifaceMethodNames rest

-- C5: every interface method name declared anywhere in [decls] (unwrapping DAttrib).
allIfaceMethodNames : List Decl -> List String
allIfaceMethodNames [] = []
allIfaceMethodNames ((DAttrib _ d)::rest) = allIfaceMethodNames [d]
  ++ allIfaceMethodNames rest
allIfaceMethodNames ((DInterface { methods, ... })::rest) = ifaceMethodNames methods
  ++ allIfaceMethodNames rest
allIfaceMethodNames (_::rest) = allIfaceMethodNames rest

-- C5 (DEFINER shadow): the names THIS module declares as a top-level funDef that
-- ALSO name an interface method visible in [implDecls] (the imported prelude/core).
-- E.g. map-as-root defines `toList`/`isEmpty`, which shadow Foldable's methods.  The
-- MARK pass (`buildStandaloneShadowsGraph`) rewrites occurrences of these to
-- `EMethodAt`, so they MUST be in `standaloneValuesRef` for `recordRLocalSite` to
-- record an RLocal candidate — otherwise the route falls back to the method's
-- RESULT-type RKey (`toList`'s `List`) and the method dispatches on the WRONG impl.
-- Unlike importer shadows these keep their LOCAL standalone scheme (NOT rebound to the
-- method scheme), since the impl bodies apply them to the concrete receiver.
buildDefinerShadows : List Decl -> List Decl -> List String
buildDefinerShadows implDecls prog =
  -- A method name that is ALSO bound by a LOCAL pattern anywhere in the module (a
  -- clause/lambda param, a let/match binder) is NOT a definer shadow at that
  -- occurrence: lexical scope resolves it to the local.  Without this guard the
  -- definer-shadow application path (inferDefinerShadowVarApp / inferDefinerShadowApp)
  -- types `applyEq eq x y = eq x y` — where `eq` is a PARAMETER — against the TOP-LEVEL
  -- standalone `eq : Int -> Int -> Int`, ignoring the binder entirely.  Mirrors the
  -- MARK pass's identical exclusion (marker.mdk's shadowRenames `keepNotIn
  -- (localBoundNames prog)`), so check/run/build agree on which occurrences are shadows.
  --
  -- #973: `methodNames` is an OrdMap-backed SET (omHasKey), NOT a growing `List` scanned by
  -- `contains`.  As a list, `filter (n => contains n methodNames) localNames` was
  -- O(funDefs x methods) — the flat single-file path's `manyifaces:typecheck` O(interfaces^2)
  -- quadratic (each of the module's funDefs forced a full scan of the interface-method list,
  -- which grows with the interface count).  Keyed into a set the membership test is O(log n)
  -- with BYTE-IDENTICAL output: `omHasKey n methodNames` is a point-for-point substitute for
  -- `contains n methodNames` (same membership over the same names, same declaration order),
  -- exactly the substitution #154 made for the Module path's `definerShadowsFromSet`.
  let methodNames = namesToSet (allIfaceMethodNames implDecls) omEmpty
  let localNames = dedup (map fst (funDefs prog))
  let direct = filter (n => omHasKey n methodNames) localNames
  -- P0-18: on the EMIT path this module's funDefs are MANGLED, so `direct` finds no
  -- shadow.  For each mangled funDef that the mangle map flags as an iface-method
  -- shadow, register the BARE method name — that is the name the mark pass stamped
  -- on the `EMethodAt`, which `definerShadowArgHead`/`resolveRLocalSite` key off.
  let bares = flatMap (n => match lookupAssoc n driverState.value.mangledShadowMapRef.value
    Some bare => [bare]
    None => []) localNames
  removeAllS (localBoundNames prog) (dedup (direct ++ bares))

-- #154 PR1: fold THIS module's decls into the persistent universe accumulators
-- (declared in `CrossRun`).  Called from checkBodyImpl's Module arm BEFORE the shadow
-- reads, so this module's own decls are visible there — exactly as `fullUniverse` (which
-- appended prog0) was.
-- ⚠️ ARCH B-2.1-d REMOVED THE KEY-BUCKET LINE from this fold, with the
-- `universeKeyBucketsRef` cell it grew.  That line re-entered `bucketKeyEntries` once per
-- module with a NON-EMPTY accumulator, which is what duplicated declaration indices across
-- modules and left each module's slice descending; at the time, `buildKeyTable` was
-- `bucketKeyEntries`' sole caller and passed `omEmpty` (see `mergeByDeclIdx`).  Both
-- `buildKeyTable` and `bucketKeyEntries` (and the whole key-bucket table, `KeyBuckets`) were
-- deleted by `S-keytable-payoff`.  Do not re-add a cumulative key-bucket accumulator here:
-- impl EXISTENCE and impl SELECTION both read the graph-global `bodyImplEnvRef` now, and a
-- prefix-keyed second population is the shape B-2.1-c/-f/-g each measured an S0 out of.
-- ⚠️ #1557 A-3.5a REMOVED THE COMPLETENESS LINE from this fold, with the
-- `universeIfaceRequiredRef` cell and its `insertIfaceRequired` writer.  The ordering
-- guarantee this comment records ("this module's own decls are visible at the read")
-- is no longer what impl-completeness depends on: it reads stage K's `CE`, whose rows
-- carry their declaring module's ordinal, and `declEnvVisibleAt cur o` (`o <= cur`)
-- admits the reader's OWN row — the same 0..cur-inclusive prefix the accumulator held
-- here.  Do not re-add a completeness accumulator to restore an ordering property that
-- has moved onto the ordinal predicate.
appendUniverseAccums : List Decl -> Unit
appendUniverseAccums prog =
  crossRun.value.universeIfaceMethodsRef := (namesToSet (allIfaceMethodNames prog) crossRun.value.universeIfaceMethodsRef.value)
  crossRun.value.universeFunNamesRef := (namesToSet (map fst (funDefs prog)) crossRun.value.universeFunNamesRef.value)
  -- #154 PR2 (site #3): grow the methodIfaceParams / registeredIfaces accumulators by
  -- THIS module's interfaces, in lockstep (one decl walk).
  let acc = insertMethodIfaceParams prog (crossRun.value.universeMethodIfaceParamsRef.value, crossRun.value.universeRegisteredIfacesRef.value)
  crossRun.value.universeMethodIfaceParamsRef := (fst acc)
  crossRun.value.universeRegisteredIfacesRef := (snd acc)
  -- #1111 A-2.5 (#1092): the identity-keyed companion of the map above, grown in the
  -- SAME place so the two cannot see different universes.  See insertMethodIdents.
  let identAcc = insertMethodIdents prog (crossRun.value.universeMethodIdentsRef.value, crossRun.value.universeMethodCollidedRef.value)
  crossRun.value.universeMethodIdentsRef := (fst identAcc)
  crossRun.value.universeMethodCollidedRef := (snd identAcc)
  -- #154 PR-B: grow the dispatch-index accumulator by THIS module's interface indices.
  -- APPEND (universe first) so the accumulated list stays in the same core-first order the
  -- old `argDispatchIndices (accAll ++ prog)` flatMap produced.  #1351 L5 (CONTRACT) deleted
  -- the bare-name accumulator that used to be grown alongside this one: its only reader was
  -- `dispatchIdxScoped`'s fall-back arm, and the reader is now identity-keyed only, so a
  -- prior-module entry this module never names cannot be queried by spelling at all.
  crossRun.value.universeMethodDispatchIdxByIdRef := (crossRun.value.universeMethodDispatchIdxByIdRef.value ++ argDispatchIndicesById prog)
  -- #1112 A-3.4 PR2: the #154 PR3 leg that grew the three `obUniv*` obligation-universe
  -- accumulators here is GONE.  Its consumer — the Module arm's `obUniv` — now projects
  -- stage K's `IE` at the reader's ordinal instead (`ieUniverseAt`), so this fold was
  -- building a second copy of a table nothing reads.  Note what that makes this function:
  -- it no longer answers "what impls exist" at all; every remaining line here is an
  -- interface/method/name-side accumulator.  Do not re-add an impl accumulator — the whole
  -- point of the flip is that `IE` is the one answer, and a second one is design law L1's
  -- divergence.
  ()

-- #154 PR-A: grow the persistent DATA-universe by [pubDecls] (THIS module's public data).
-- `registerData` / `registerVariants` hardcode the working table refs, so grow by
-- pointing those refs at the persistent values, registering pubDecls over the accumulated
-- ctor env, and snapshotting the results back.  ⚠️ DERIVE HOW MANY from `loadDataUniverse`
-- below rather than trusting a count here — this sentence said "six"/"seven" while A-3.2b
-- was taking the pair to three.  Called at the END of checkBodyImpl's
-- Module arm, where the working table refs are DEAD (this module's inference is done and the
-- next module's resetState wipes them), so the clobber is invisible.  Registers each public
-- decl exactly ONCE across the whole run — the O(N) replacing the Module arm's old
-- per-module O(|accData|) re-registration.  Only publicDataDecls are folded in (private data
-- stays module-local), matching foldModules' `accData ++ publicDataDecls prog` threading.
-- ⚠️ #804/#1028's OPAQUE-type param kinds used to be published from here too, by a second
-- pass (`registerOpaqueParamKinds`) whose ONLY purpose was to reach the kind universe.
-- That universe is retired (see below) and the opaque arms live on `kindPublicDataDecl`,
-- so the pass is GONE rather than left writing a table nothing reads.
-- #415 item 3: the cross-module DATA universe ⇄ per-run working tables copy, which was
-- open-coded as an N-way lockstep mirror at THREE sites (the Module arm of the data-env
-- setup + appendDataUniverse's load and its store-back).  Adding a further universe table
-- meant remembering all three — the "silently absent from the other side" shape.  It now
-- has one body per direction.  ⚠️ N IS DELIBERATELY NOT A NUMBER HERE: it was 5, then 4
-- (#1557 A-3.5c), then 1 (#1512 slices 2+3), inside three successive PRs — derive it from
-- the two bodies below, which are what the invariant note there tells you to read.
-- ⚠️ universeDataEnv is deliberately NOT copied here: it is threaded through
-- `registerAllData` by the CALLER (it is that call's env argument and its result), so it
-- has no meaning as a blind copy.
--
-- 🚨 THE CROSS-RUN HALF IS NOW ONE CELL, AND THE OTHERS ARE NOT SILENTLY DROPPED.
-- Three units in a row have edited these two bodies, so read them as TWO SEPARABLE
-- HALVES rather than as a table count (a count here rots on contact — this comment
-- has said "five", "four" and "three" in three successive PRs; DERIVE it from the
-- bodies below):
--   * CROSS-RUN half — a copy IN and the exact inverse copy OUT, same set, same
--     order.  `universeRecordByName` is what is left of it: its payload is an
--     ELABORATED `RecordInfo`, which the Step-0 ruling keeps OUT of syntactic K, so
--     it stays a marshalled cell until a dedicated elaboration-cache unit.
--   * STAGE-K half — a PROJECTION at the reader's own ordinal, which has NO inverse
--     here by construction.  ⚠️ ONLY ONE OF THE THREE IS SEEDED IN THE BODY BELOW.
--     This bullet said "three tables are now on this side", which reads as three
--     lines of `loadDataUniverse`; two of them are seeded at a DIFFERENT call site —
--     the ONE call of `declEnvSeedDataUniverse mid envs`, in `checkBodyImpl`'s Module
--     arm, further down that arm than this function's own call.  Anchor on the seeder,
--     not on a line number or on this bullet's ordering:
--       `aliasTableRef`      ← `aliasUniverseAt cur … .deData.deAliases`  (#1512 residual 1)
--                              — HERE, in `loadDataUniverse`'s body
--       `dataParamKindsRef`  ← `declEnvSeedDataUniverse mid …`            (#1512 slice 2)
--       `fieldOwnersRef`     ← `declEnvSeedDataUniverse mid …`            (#1512 slice 3)
--                              — both at that function's ONE call site, not here
--     and `ifaceParamKindsRef` left the pair entirely with #1557 A-3.5c (its reader
--     sources `ceSlotKindsAt` from `deIfaces`).
-- Do NOT re-add a `setRef crossRun.… perRun.value.<any of those>.value` "for
-- symmetry".  That is design law L1's divergence: K and a cross-run copy become two
-- answers to one question, and the copy is always the one that drifts — it would
-- carry `rejectCyclicAliases`' per-module alias deletions, and it would carry the
-- DOUBLED owner keys `appendDataUniverse` now leaves behind (see its own note).
--
-- ⚠️ WHEN THIS INVARIANT BREAKS IT IS SILENT — no compile error, no gate, just a
-- table that stops crossing a module boundary.  After ANY rebase, read the two
-- bodies side by side and check the cross-run half agrees in SET and in ORDER, and
-- that each body still has exactly one tail expression and no dangling `let _ =`.
loadDataUniverse : Int -> Unit
loadDataUniverse cur =
  perRun.value.recordByNameRef := crossRun.value.universeRecordByName.value
  perRun.value.aliasTableRef := aliasUniverseAt cur driverState.value.declEnvsRef.value.deData.deAliases

-- The exact inverse of `loadDataUniverse`'s CROSS-RUN half — see the invariant above.
-- It is one line because that half is one cell; the other three seeds are stage-K
-- projections and have nothing to invert.
storeDataUniverse : Unit -> Unit
storeDataUniverse _ =
  crossRun.value.universeRecordByName := perRun.value.recordByNameRef.value

-- ⚠️ STILL TAKES THIS MODULE'S WHOLE decl list, not a pre-filtered one, even though the
-- second half it owned has moved.  It used to own BOTH halves of what a module publishes
-- to the data universe — `publicDataDecls` (ctors + records + kinds, for a `public export`
-- type) and `registerOpaqueParamKinds` (kinds ONLY, for an opaque one, #804/#1028).
-- A-3.2b (#1512) slice 2 retired the kind universe, so the opaque half is now a projection
-- of the whole graph (`kindPublicDataDecl`) rather than a second pass here.  The parameter
-- stays unfiltered because filtering at the CALL SITE is what let the opaque half go
-- missing for as long as it did, and a future third half would land here again.
--
-- 🚨 WHAT `fieldOwnersRef` AND `dataParamKindsRef` CONTAIN WHEN THIS RUNS CHANGED WITH
-- A-3.2b, AND THE OLD "the working refs are DEAD here" NOTE DOES NOT COVER IT.  That
-- note is about WHEN (this module's inference is finished; the next module's
-- `resetState` wipes them) and it still holds.  What changed is WHAT they hold on
-- ENTRY.  `loadDataUniverse` used to RESET both refs from the cross-run universe as
-- its first act; it no longer touches either, so they arrive holding the K seed PLUS
-- everything this module registered during inference — and `registerAllData … pubDecls`
-- below then registers this module's PUBLIC decls a SECOND time.  `addFieldOwners`
-- conses without dedupe, so every own public record is DOUBLE-listed in
-- `fieldOwnersRef` from that line until the next `resetState`.
--
-- ⚠️ UNOBSERVABLE TODAY, AND ONLY BECAUSE NOTHING READS IT IN BETWEEN — verified, not
-- assumed: `insertRecordIdents`/`insertCtorIdents` below read `recordByNameRef` (an
-- `omInsert` map, idempotent under re-registration), never the owner multimap.  But a
-- doubled owner key is EXACTLY the shape `declEnvSeedChain`'s own-row 🚨 exists to
-- prevent: `mangledHeadCandidates` reads this multimap RAW (no `sortUniqS`), so a key
-- appearing twice turns its `[pair]` singleton gate into the give-up arm and `Some
-- pair` becomes `None`.  ⇒ DO NOT ADD A READ OF `fieldOwnersRef` AFTER THIS POINT
-- without either de-duplicating first or restoring a reset.  (`dataParamKindsRef` gets
-- the same doubling; it is inert there because `lookupTab` is first-match over
-- identity-bearing keys whose two copies are equal.)
appendDataUniverse : String -> List Decl -> Unit
appendDataUniverse mid prog0 =
  let pubDecls = publicDataDecls prog0
  -- A-3.2b residual (#1512): the reload takes THIS module's ordinal, because the
  -- alias half of it is now a stage-K projection rather than a cross-run copy.
  -- Same ordinal the arm's own `dataEnv` reload used, and it must stay strictly
  -- BELOW-this-module (`aliasUniverseAt`'s `<`): `registerAllData … pubDecls`
  -- immediately below is what puts this module's own public aliases in front,
  -- exactly as it always did.
  let _ = loadDataUniverse (declEnvsOrdOf mid driverState.value.declEnvsRef.value)
  let env2 = registerAllData crossRun.value.universeDataEnv.value pubDecls
  let _ = storeDataUniverse ()
  crossRun.value.universeDataEnv := env2
  -- #1111 A-2.11 (#1319 unit 1): the identity-keyed companion of `universeDataEnv`'s ctor
  -- map, grown in the SAME place from the SAME `env2` so the two cannot come to hold
  -- different schemes for one declaration.  See insertCtorIdents.
  let ctorAcc = insertCtorIdents env2 pubDecls (crossRun.value.universeCtorIdentsRef.value, crossRun.value.universeCtorCollidedRef.value)
  crossRun.value.universeCtorIdentsRef := (fst ctorAcc)
  crossRun.value.universeCtorCollidedRef := (snd ctorAcc)
  -- #1111 A-2.12 (#1319 unit 2): the RECORD-table peer of the three lines above, grown
  -- HERE and not in `registerRecordInfoKeyed` for the same reason — `registerAllData …
  -- pubDecls` has just written this module's rows into `recordByNameRef` / `fieldOwnersRef`
  -- (`storeDataUniverse` copies, it does not clear), so both helpers read back the very
  -- objects the bare tables hold instead of minting a second set.  See insertRecordIdents.
  let recAcc = insertRecordIdents pubDecls (crossRun.value.universeRecordIdentsRef.value, crossRun.value.universeRecordCollidedRef.value)
  crossRun.value.universeRecordIdentsRef := (fst recAcc)
  -- ⚠️ A-3.2b (#1512): a `setRef crossRun.value.universeDataDecls (… ++ pubDecls)` used
  -- to follow the line below — #674's overlay pool, kept here because
  -- `universeDataEnv` is a lossy bare-name ctor env and could not recover a SPECIFIC
  -- module's ctor.  It is RETIRED: stage K's `DeclEnvs` already holds every module's
  -- decls tagged with the module id and ordinal that lossiness was the absence of, so
  -- the overlay reads the envelope directly (`importedCtorTypeDecls`) instead of a
  -- second, unkeyed copy of the same declarations grown one module at a time.
  crossRun.value.universeRecordCollidedRef := (snd recAcc)

-- #154 PR1: buildDefinerShadows with the `allIfaceMethodNames fullUniverse` scan
-- replaced by the persistent interface-method membership SET.  `direct` still filters
-- THIS module's localNames in declaration order, so `omHasKey n ifaceSet` is a
-- point-for-point substitute for `contains n methodNames` — same set, same order,
-- byte-identical output.
definerShadowsFromSet : OrdMap Unit -> List Decl -> List String
definerShadowsFromSet ifaceSet prog =
  let localNames = dedup (map fst (funDefs prog))
  let direct = filter (n => omHasKey n ifaceSet) localNames
  let bares = flatMap (n => match lookupAssoc n driverState.value.mangledShadowMapRef.value
    Some bare => [bare]
    None => []) localNames
  removeAllS (localBoundNames prog) (dedup (direct ++ bares))

-- #154 PR1: buildStandaloneShadows with BOTH O(N) universe scans
-- (`allIfaceMethodNames (implDecls ++ prog)` and `funDefs implDecls`) replaced by the
-- persistent interface-method and top-level-fn membership sets.  A name qualifies when
-- it is a universe fn, an interface method, and NOT defined in THIS module — the
-- `not (contains n localNames)` guard drops both this module's own funDefs (which the
-- set now includes) exactly as the original excluded them, so the result set is
-- identical.  It is consumed only by membership (standaloneValuesRef) and by unique-name
-- first-match lookup (shadowStandaloneSchemesRef), so the sorted `omKeys` iteration order
-- is immaterial to every downstream reader.  P0-18 (a shadowed interface declared
-- LOCALLY in the importing module) is preserved: appendUniverseAccums folds prog0's own
-- interface methods into the set, so a local `interface Sizeable … size` is visible here
-- exactly as the old `allIfaceMethodNames (implDecls ++ prog)` (which included prog) made it.
--
-- #411 (row 21, S4): the `mangled` arm is the IMPORTER peer of the recovery
-- definerShadowsFromSet has carried since P0-18 (its `bares`), and its absence WAS the
-- bug.  On the EMIT path every funDef is mangled (`prov__size`), so `direct` — which
-- intersects the MANGLED universe fn names against the BARE interface-method names —
-- matches nothing and this returned []; importerShadows was therefore empty on emit, so
-- standaloneValuesRef never listed the name, recordRLocalSite never recorded a site, and
-- resolveArgStamp's `RKey Int` CLOBBERED the mark pass's correct `RLocal prov__size`
-- seed → `emitDefaultRKey` → `no impl of method 'size' for type 'Int'` on a valid
-- program.  The definer twin (d4) never broke precisely because it had this arm.
-- Recovering the bare method name via the mangle map restores the site, and
-- resolveRLocalSite then applies the ORDINARY Fork-1 importer rule to it (live impl at
-- the receiver head ⇒ keep the RKey dispatch; no impl ⇒ RLocal standalone) — so i4's
-- `isEmpty [1, 2]` still reaches `Foldable.isEmpty`.  Empty on the un-mangled run/check
-- path (the map is empty there) → `direct` alone → byte-identical.
standaloneShadowsFromSet : OrdMap Unit -> OrdMap Unit -> List Decl -> List String
standaloneShadowsFromSet ifaceSet fnSet prog =
  let localNames = map fst (funDefs prog)
  let direct = filter (n => omHasKey n ifaceSet && not (contains n localNames)) (omKeys fnSet)
  let mangled = flatMap (n => match lookupAssoc n driverState.value.mangledShadowMapRef.value
    Some bare => if contains n localNames then [] else [bare]
    None => []) (omKeys fnSet)
  dedup (direct ++ mangled)

-- ── #1354 unit A (#1353): SHADOW-SEMANTICS S1's `nameable in M` interface operand ──
-- `docs/spec/SHADOW-SEMANTICS.md` S1 (SCOPE RULED 2026-08-06, #1375) intersects
-- funDef-names(standalones defined in or imported into `M`) with
-- iface-method-names(interfaces **nameable in `M`**).  `universeIfaceMethodsRef` is the
-- accumulated method-name set of EVERY module the loader processed, so the two builders
-- above implement the LEFT operand's scope (the `fnSet`/`localNames` guards) and give the
-- RIGHT one none: an interface reachable only transitively, through a module that
-- re-exports nothing, captured a standalone the occurrence's module had explicitly
-- imported (#1353, S0 — `7` instead of `99`, at exit 0, no diagnostic).
--
-- The remedy is a SUPPLY, not a re-key: the set is a correct MEMBERSHIP set and re-keying
-- it would answer a question nobody asks of it.  This is the missing predicate, applied to
-- the ALREADY-COMPUTED intersection rather than inside either operand's filter — the
-- intersection is single-digit in practice (over `compiler/**` + `stdlib/*` it is 3:
-- `toList`, `isEmpty`, `orElse`) while `fnSet` holds every top-level fn name in the graph,
-- so filtering the result is cheap and filtering the operand is not.
--
-- ⚠️ THE PREDICATE ASKS A TYPE-NAMESPACE QUESTION, and getting that wrong is how the first
-- cut of this fix shipped two defects at once — see `graphIfaceMethods` for both, measured.
-- §1.0's row says `nameable in M` qualifies **S1's INTERFACE operand**; asking instead
-- whether the METHOD NAME is exported along the import path is a different question that
-- answers differently in BOTH directions.
--
-- 🚨 IT FAILS OPEN, DELIBERATELY, AND THAT DIRECTION IS LOAD-BEARING.  Dropping shadow-hood
-- from an occurrence that IS one makes it dispatch unconditionally (`recordRLocalSite`'s
-- `standaloneValuesRef` guard declines, so no pending site exists for
-- `resolveRLocalSites` to stamp and the route stays the method's RKey) — the S4/#410
-- class, up to `no impl of method … for type …` on a valid program and a SIGSEGV variant.
-- Adding shadow-hood is the pre-existing behaviour.  So an ABSENT index answers True for
-- every name rather than False: `graphIfaceMethodsRef` is written unconditionally at both
-- Module-mode driver entries (`checkModulesPreamble`, `elaborateModules` — the conjunction
-- stated in full on `graphMethodExports`, which this ref is written beside), and a driver
-- that ever omits that write must degrade to today's graph-global answer, not to "nothing
-- is a shadow anywhere".
--
-- ⚠️ SCOPE, stated so it is not over-read.  The predicate is `nameable in M` as §1.0 defines
-- it, applied to S1's INTERFACE operand — so it covers BOTH failures S1 names, the
-- reachability one (#1353: no import path reaches the declaring module) and the one where a
-- path exists but does not carry the interface.  What it does NOT decide is #1302's axis:
-- `graphIfaceMethods` has no `pub` filter, so a module that imports a dependency BY NAME can
-- still be told about that dependency's PRIVATE interface.  That is the fail-open direction
-- and it is left exactly where #1302 and `declMethodIdentsOf`'s F3 already own it.
nameableIfaceShadows : List Decl -> List String -> List String
nameableIfaceShadows _ [] = []
nameableIfaceShadows prog names
  -- fail OPEN on an absent index — see the paragraph above; `names` unchanged is exactly
  -- the pre-#1353 graph-global answer.
  | omSize driverState.value.graphIfaceMethodsRef.value == 0 = names
  | otherwise =
    let nameable = nameableIfaceMethodSet prog
    filterList (n => omHasKey n nameable) names

-- The bare method names of every interface NAMEABLE in module [prog] — S1's three
-- nameable-in-`M` positions, built ONCE per module: the implicit prelude (`core`'s row),
-- this module's own interfaces, and, for each `DUse`, the interfaces THAT USE-PATH ADMITS
-- out of the dependency's row (which already carries what the dependency re-exports, at any
-- chain depth — S1-CHAIN, #1380).
--
-- 🚨 THE USE-PATH FILTER IS THE WHOLE POINT, and its absence was this fix's first defect.
-- Taking a dependency's WHOLE row on any import makes `import smod.{sf}` — one unrelated
-- function — enough to make `smod`'s interface "nameable", which it demonstrably is not:
-- `impl Sizeable Blob` in that module is rejected `Unknown interface: Sizeable`.  That left
-- #1353 narrowed rather than fixed (its own repro with the bridge hop removed still printed
-- the impl's value).  `selectIfaceRows` is shared with the re-export side so the import and
-- chain answers cannot drift apart.
--
-- Name-level rather than identity-level ON PURPOSE.  S1's intersection is over NAMES, so
-- when two interfaces declare `n` and only one is nameable here, `n` is a shadow either
-- way; WHICH declaration an occurrence then means is `applyMethodScopeOverrides`' question
-- about a different table (`universeMethodIfaceParamsRef`), and answering it here would be
-- a second resolver free to disagree with that one.
--
-- 🔒 THIS IS S1's RIGHT OPERAND UNDER S1-NS (RULED 2026-08-08), and it is the ONLY predicate
-- in the compiler that answers it — `checkBodyImpl`'s shadow-hood and EVERY filter in the
-- mark pass read THIS set.  Named rather than counted, because a count rots silently and
-- this sentence already did (it said "all three" for a week after `rpNames` became the
-- fourth): `prePassModulePairArg` filters `rpNames`, `shadowNames` (through
-- `shadowBareName`), `argNames` and `shadowMap` — its own `otherwise` arm enumerates them
-- against what `rewriteArgScoped` can turn into an `EMethodAt`.  S1-NS (b) requires
-- shadow-hood to be a superset of dispatch
-- eligibility and rules two different predicates at the two sites non-conformant; one set
-- makes them equal, so the invariant holds by construction rather than by test.  Do not
-- introduce a second, wider set for marking: two earlier cuts of this unit did exactly that
-- and each shipped an S0 (a `run`-vs-built-binary split, and a `build`-only E-PANIC).
--
-- The per-METHOD union of the two namespaces lives in `selectIfaceRows`, applied on the
-- import arm here and on the re-export arm in `graphIfaceMethods`.
nameableIfaceMethodSet : List Decl -> OrdMap Unit
nameableIfaceMethodSet prog =
  addImportedIfaceMethods
    prog
    (addIfaceRowMethods
      (fromOption
        []
        (omLookup "core" driverState.value.graphIfaceMethodsRef.value))
      (namesToSet (allIfaceMethodNames prog) omEmpty))

addImportedIfaceMethods : List Decl -> OrdMap Unit -> OrdMap Unit
addImportedIfaceMethods [] acc = acc
addImportedIfaceMethods ((DAttrib _ d)::rest) acc =
  addImportedIfaceMethods rest (addImportedIfaceMethods [d] acc)
addImportedIfaceMethods ((DUse _ path _)::rest) acc = addImportedIfaceMethods
  rest
  (match omLookup (usePathModuleId path) driverState.value.graphIfaceMethodsRef.value
    None => acc
    Some src => addIfaceRowMethods (selectIfaceRows path src) acc)
addImportedIfaceMethods (_::rest) acc = addImportedIfaceMethods rest acc

addIfaceRowMethods : List (String, List String) -> OrdMap Unit -> OrdMap Unit
addIfaceRowMethods [] acc = acc
addIfaceRowMethods ((_, ms)::rest) acc =
  addIfaceRowMethods rest (namesToSet ms acc)

-- C5: graph-wide standalone-shadow names — every top-level funDef name in [userDecls]
-- (the user modules, NOT core) that is also an interface method name anywhere in
-- [allDecls].  Used by the MARK pass to rewrite such occurrences to EMethodAt (so the
-- route ref exists for resolveRLocalSites to stamp).  Excludes core's own decls as the
-- funDef source so core's elaboration (no standalone shadows there) is untouched.
-- P0-18: recover, per (module, iface-method) pair, the mangled standalone symbol the
-- mangler produced for a definer-shadow funDef.  Forward-constructs `mangledName mid
-- method` (using the KNOWN mid — exact, not lossy prefix-stripping) and checks it
-- against the module's actual funDef names; a hit is a `(mangledSymbol ↦ bareMethod)`
-- entry.  On the un-mangled path no funDef matches → [] → every consumer unchanged.
computeMangledShadowMap : List Decl -> List (String, List Decl) -> List (String, String)
computeMangledShadowMap allDecls units =
  let methodNames = allIfaceMethodNames allDecls
  flatMap (unitMangledShadows methodNames) units

unitMangledShadows : List String -> (String, List Decl) -> List (String, String)
unitMangledShadows methodNames (mid, decls) =
  let fns = dedup (map fst (funDefs decls))
  flatMap
    (m => if contains (mangledName mid m) fns then [(mangledName mid m, m)] else [])
    methodNames

-- L3 (xmod-identity #1351 spine, RUN-XMOD-022/026): the graph-level fact "this
-- compile's decls carry at least one top-level funDef with its own module's
-- mangle prefix" — the DENOTATION the new driverState flag below actually
-- records (F12).  NOT literally "a mangler ran": a hand-written `m__foo` in
-- module `m` on the un-mangled (check/run) path also satisfies it, harmlessly
-- (see that flag's callers).  Reuses `isMangledFor` (F6) rather than a second
-- prefix test, and `funDefs` rather than a second decl walk.
-- Monomorphic, explicit-recursion, short-circuits on the first hit — do NOT
-- delegate to prelude `any`/`elem` here (AGENTS.md: costed +56% self-compile
-- on this file's hot helpers).
--
-- 🚨 RUN-XMOD-045 CORRECTION (post-landing, slice-breaker finding): on EVERY
-- emit path this flag is CONSTANT TRUE, not merely "true when some module
-- shadows an interface method."  `private_mangle.mdk:14-16` states the
-- mangler's actual scope: "EVERY top-level FUNCTION binding (in core + every
-- module) is renamed to a module-qualified unique symbol," unconditionally,
-- BEFORE `elaborateModules` (and therefore this function) ever runs.  So
-- `core`'s own funDefs already carry the `core__` prefix by the time this
-- walks them, and the very first unit checked (`("core", coreDecls)`, see
-- both call sites below) already satisfies `unitCarriesMangledFunDefs` —
-- MEASURED: a feature-free `main = println 1` build emits ~70 distinct
-- `@mdk_core__*`/`@mdk_<mid>__*` symbols in its own IR with zero user
-- modules, zero shadows, zero interfaces.  The ORIGINAL packet's inertness
-- argument (F8: "a non-empty route symbol implies this flag is True") is
-- still literally correct but was read as "this flag is sometimes False,"
-- which is false — it is NEVER False on the emit path, so F8's implication
-- is vacuously satisfied rather than doing narrowing work.  The precondition
-- F8's phrasing hid: BOTH writers (this flag AND the route-symbol conjunct
-- in `importerShadowOnEmitPath`) are stamped by the SAME compile, and on
-- that compile this flag is always True the moment mangling has run at all —
-- see `importerShadowOnEmitPath`'s own header for the consequence.
--
-- 🚨 THIS FACT CURRENTLY HAS NO DISCRIMINATING CONSUMER — L4's conjunct is
-- constant-True on emit and its partner (`occurrenceCarriesMangledShadowSym`)
-- is always-empty off emit.  It is explicit documentation of an implicit
-- invariant, not a live condition.  Do not migrate a reader onto it
-- expecting it to select.  KEPT (not reverted) by owner ruling because it is
-- provably zero-risk and reads better than the anonymous test it replaced —
-- see `importerShadowOnEmitPath`.
graphCarriesMangledFunDefs : List (String, List Decl) -> Bool
graphCarriesMangledFunDefs [] = False
graphCarriesMangledFunDefs ((mid, decls)::rest) =
  if unitCarriesMangledFunDefs mid (funDefs decls) then
    True
  else
    graphCarriesMangledFunDefs rest

unitCarriesMangledFunDefs : String -> List (String, (List Pat, Expr)) -> Bool
unitCarriesMangledFunDefs mid [] = False
unitCarriesMangledFunDefs mid ((n, _)::rest) =
  if isMangledFor mid n then
    True
  else
    unitCarriesMangledFunDefs mid rest

buildStandaloneShadowsGraph : List Decl -> List Decl -> List String
buildStandaloneShadowsGraph allDecls userDecls =
  let methodNames = allIfaceMethodNames allDecls
  let fns = dedup (map fst (funDefs userDecls))
  let direct = filter (n => contains n methodNames) fns
  -- P0-18: on the EMIT path the funDef names are MANGLED (`<mid>__toList`), so the
  -- `direct` name-intersection misses them; recover them via the mangle map so the
  -- prePass marks their (mangled) occurrences `EMethodAt`.  Empty on the un-mangled
  -- path (the map is empty there) → `direct` alone → byte-identical.
  let mangled = filter (n => isSome (lookupAssoc n driverState.value.mangledShadowMapRef.value)) fns
  dedup (direct ++ mangled)

-- `public export data` / `public export record` decls — re-registered in every
-- importing module so their constructors + field layout are in scope.
-- ALSO carries public DInterface (so the multi-module path can register the
-- interface's method→iface-param map for #11 obligation checking — a numeric
-- literal's `fromInt`/`Num` obligation, recorded via recordImplObligation, needs
-- `Num`'s entry in methodIfaceParamsRef), AND public DImpl (so checkImplObligations'
-- implHeadsOf sees core's `impl Num Int` etc. — without it a legitimately Int-typed
-- literal's Num obligation finds no matching impl head and is spuriously rejected).
-- registerAllData and buildOracle read only DData, so the extra DInterface/
-- DImpl entries are inert for them.
-- A-3.2b (#1512): the PREDICATE half, split out so `declEnvVisibleTo`'s publicity
-- conjunct and this filter cannot drift.  The ruling on #1512 requires the flag be
-- `publicDataDecls`' predicate VERBATIM, `DNewtype`'s absence included; the way to
-- guarantee "verbatim" is not to copy it but to make `publicDataDecls` itself the
-- filter over this one function, which is what the two lines below do.
--
-- ⚠️ `DNewtype`'s ABSENCE IS DELIBERATE, not an oversight to be tidied up: a newtype
-- constructor is module-private by design (`public` is a parse error on `newtype`),
-- and admitting one here would leak newtype constructors across module boundaries —
-- draining #1311/#1305 in the loud→silent direction, i.e. a severity INCREASE.
-- `DAttrib` is absent for the same reason it always was: an attributed decl is not
-- unwrapped here, so it does not publish.  Neither absence may be "fixed" without
-- owning those issues.
publicDataDecl : Decl -> Bool
publicDataDecl (DData { dataVis = VisPublic }) = True
publicDataDecl (DInterface { pub = True, ... }) = True
publicDataDecl (DImpl { pub = True, ... }) = True
publicDataDecl (DTypeAlias { tyAliasPub = True }) = True
publicDataDecl _ = False

-- #1110: the decl passes THROUGH rather than being rebuilt, or the acquired
-- `dataOrigin` is dropped on the export path — `filterList` preserves that by
-- construction, where the old per-arm `d :: …` form preserved it by remembering to.
publicDataDecls : List Decl -> List Decl
publicDataDecls decls = filterList publicDataDecl decls

-- 🚨 A-3.2b (#1512) slice 2: THE THIRD PROJECTION, AND IT IS A PEER OF
-- `publicDataDecl`, NEVER A WIDENING OF IT.  What a module published to the RETIRED
-- `crossRun.universeDataParamKinds` was NOT `publicDataDecls`: it was `publicDataDecls`
-- (whose only kind-bearing arm is `DData VisPublic`) PLUS a second, kinds-only pass
-- over `DData VisAbstract` and `DNewtype { newtypePub = True }`.  Reusing
-- `publicDataDecl` for the kind seed would therefore LOSE an opaque type's parameter
-- kinds cross-module, which is #804/#1028 exactly: every reader that asks "is slot i
-- row-kinded?" misses, and each one fails differently — `fromAstTypeApp` erases a
-- written row SILENTLY, the bare-row spelling draws a FALSE `T-ROW-KIND-MISMATCH`, and
-- #784's `checkUndeterminedRetEffVars` cannot see `Async e a` pin `<e>` and rejects the
-- method.  `stdlib/async.mdk`'s `Async` is that shape; `test/check_module_fixtures/
-- opaque_param_kinds_xmod/` and its `_newtype` sibling are the fixtures.
--
-- A KIND IS NOT A FIELD, which is why this may be wider than `publicDataDecl` without
-- leaking anything: "slot 0 of `Async` has kind Row" says nothing about `Done` or
-- `Suspend`, so the abstraction `export` buys is intact.  Only `declEnvKindEntries`
-- consumes this projection, and it mints kinds and NOTHING else — no ctor schemes, no
-- `RecordInfo`, no `fieldOwnersRef` entry.  Promoting these decls in `publicDataDecl`
-- instead would have been the one-line "fix" that leaks the constructors (and drains
-- #1311/#1305 loud→silent).
--
-- ⚠️ NOT `VisPrivate`: a private type's name is not in scope for an importer and the
-- kind table is not import-scoped, so publishing it could only collide a name nobody
-- can spell against one they can.  ⚠️ NO `DAttrib` ARM: neither source it replaces had
-- one — see `declEnvKindEntries` and #1586.  ⚠️ `export newtype` is in the same bucket
-- as `VisAbstract` and has no workaround at all: `public` is a parse error on `newtype`,
-- so its constructor is unconditionally module-private, which is why the third arm keys
-- on `newtypePub` and not on a visibility that does not exist.
--
-- ⚠️ WHAT THE IDENTITY KEY DOES AND DOES NOT BUY — inherited verbatim from
-- `registerOpaqueParamKinds`, which this projection replaced (A-3.2b), because a reader
-- who believes the retired version of the second bullet concludes there is nothing here
-- to fix:
--   * KEYING.  Since #1111 A-2.3 the key is a `TabKey` (see `tyTabKey`), so an opaque
--     type's kinds are registered under ITS OWN module's identity and are reachable only
--     from an occurrence that resolved to that module.  Two same-named types in
--     unrelated modules no longer share a key on the module path.
--   * THE GUARD.  An older note claimed "every hot reader additionally guards on
--     `listLen kinds == listLen args`, so a same-name/different-arity clash abstains
--     rather than mis-kinds".  It does NOT.  A 2×5 matrix (shadower arity 0/1/2/3 plus a
--     control × the row spelled WRAPPED `Box (<Stdout> Unit) Int` or BARE
--     `Bx <Stdout> Int` at the use site) moved the outcome in NEITHER direction: on the
--     guard-PASSING path the winning entry's kinds are all-`KType`, so `foldAppKinds`
--     erases the row exactly as `appFallback` does.  What actually selected
--     silent-vs-loud was the SPELLING of the row at the use site — `fromAstTypeE`'s
--     `TyEffect` arm unwraps a wrapped row to a real type and keeps inferring silently
--     (#1069), while its `TyRow` arm has no wrapped type and raises
--     `T-ROW-KIND-MISMATCH` (#1090).  Same table, same collision, opposite symptoms.
--   * The flat/single-file path is NOT re-keyed and still competes by bare name; that is
--     the Module-path-only bound recorded on `tyTabKey`, drained by #1115 (E-1).  It is
--     also why `declEnvSeedChain`'s fold direction is reproduced but currently
--     unobservable — see its note.
kindPublicDataDecl : Decl -> Bool
kindPublicDataDecl (DData { dataVis = VisPublic }) = True
kindPublicDataDecl (DData { dataVis = VisAbstract }) = True
kindPublicDataDecl (DNewtype { newtypePub = True }) = True
kindPublicDataDecl _ = False

-- WS-1a fix: every impl in scope, EXPORT OR NOT.  Instances are GLOBAL (coherence
-- + dispatch leak across module boundaries regardless of `export`), so the
-- superinterface existence query (checkSuperImpls/superImplExists) must see an
-- imported module's `impl Semigroup T` even when it isn't `export`-marked — else
-- `impl Monoid T` in an importer is falsely rejected for a "missing" super impl.
pickSchemes : List String -> List (String, Scheme) -> List (String, Scheme)
pickSchemes [] _ = []
pickSchemes (n::ns) table = match lookupAssoc n table
  Some s => (n, s) :: pickSchemes ns table
  None => pickSchemes ns table

-- ── #1351 L2 (MIGRATE Leg 2b): the IDENTITY-SCOPED picker for the shadow layer ──
--
-- `pickSchemes` above answers "which scheme does the bare name [n] have" with
-- `lookupAssoc` — FIRST MATCH over `ifaceMethodSchemes`' decl-walk order.  When two
-- interfaces declare the same method name, that order is module-processing order, so
-- the scheme an importer shadow is CHECKED AGAINST is decided by import-clause order.
-- MEASURED six-for-six (RUN-METHID-058): on `#1351`'s corpus the accept/reject split
-- tracks this row's identity with zero exceptions — `IA.mth : a -> Int -> Int`
-- unifies at `a := String` and accepts (wrongly, silently, value `7`); `IZ.mth : Int
-- -> b -> Int` does not and rejects loudly.  This is Leg 2b.
--
-- The successor asks `applyMethodScopeOverrides`' ALREADY-RESOLVED answer — the
-- declaration THIS module's own import scope admits for [n] — and takes that
-- declaration's own scheme row out of L1's identity-keyed table.  It is a LOOKUP, not
-- a second resolver: the resolution happened at `methodIfaceParamsRef`'s population
-- site and is only consulted here (the named prohibition in this leaf's packet).
--
-- ⚠️ MISS FALLS BACK TO `pickSchemes`' OWN ANSWER, deliberately.  Both misses are
-- real: `methodIfaceParamsRef` holds no entry for [n] (not an interface method at
-- all), or the admitted declaration contributes no row to `ifaceMethodSchemesByIdRef`
-- (its interface is not among `implDecls`).  A miss must not DROP the binding — that
-- would remove a name from the shadow layer, i.e. turn a checked occurrence into an
-- unchecked one, `exit 1 → exit 0`, a severity INCREASE.  Falling back keeps exactly
-- today's answer for every shape this leaf does not decide.
pickSchemesByDecl : List String -> List (String, Scheme) -> List ((IfaceRef, String), Scheme) -> List (String, Scheme)
pickSchemesByDecl [] _ _ = []
pickSchemesByDecl (n::ns) table byId = match admittedSchemeFor n byId
  Some s => (n, s) :: pickSchemesByDecl ns table byId
  None => match lookupAssoc n table
    Some s => (n, s) :: pickSchemesByDecl ns table byId
    None => pickSchemesByDecl ns table byId

-- The declaration `applyMethodScopeOverrides` resolved for [n] IN THIS MODULE, then
-- that declaration's own scheme row.  `None` at either step means "this module's
-- scope does not decide it", and the caller keeps the bare-name answer — never a
-- guess, the same discipline `scopedMethodEntry` states for the table itself.
admittedSchemeFor : String -> List ((IfaceRef, String), Scheme) -> Option Scheme
admittedSchemeFor n byId = match omLookup n perRun.value.methodIfaceParamsRef.value
  None => None
  Some (iface, _, _, _) => lookupSchemeById iface n byId

-- ⚠️ `sameTyConHead`, not a bare `irName` compare: this is a LOOKUP, where a false HIT
-- is silent wrongness (the wrong interface's scheme), so absence-makes-no-claim plus
-- name equality is the comparator the file's own rule (`cohSameIface`'s header) picks
-- for this direction.  A false MISS costs only the fall-back to today's answer.
lookupSchemeById : IfaceRef -> String -> List ((IfaceRef, String), Scheme) -> Option Scheme
lookupSchemeById _ _ [] = None
lookupSchemeById iface n (((ir, mn), s)::rest)
  | mn == n && sameTyConHead ir.irName ir.irOrigin iface.irName iface.irOrigin = Some s
  | otherwise = lookupSchemeById iface n rest

-- Bug C: for each importer-shadow name, pick from [table] the scheme that is the
-- imported STANDALONE — the one whose receiver (first arrow domain) heads in a
-- CONCRETE type constructor (`Map k v`), NOT the polymorphic interface-method scheme
-- (`t a`) that shares the same name in the seed.  A name with no concrete-domain
-- entry contributes nothing (its only binding is the method scheme; the ordinary
-- dispatch path handles it).
pickStandaloneSchemes : List String -> List (String, Scheme) -> List (String, Scheme)
pickStandaloneSchemes [] _ = []
pickStandaloneSchemes (n::ns) table = match concreteDomainScheme n table
  Some s => (n, s) :: pickStandaloneSchemes ns table
  None => pickStandaloneSchemes ns table

-- the FIRST scheme bound to [n] in [table] whose first arrow domain has a concrete
-- (TCon-headed) receiver — i.e. the standalone rather than the `t a` method scheme.
concreteDomainScheme : String -> List (String, Scheme) -> Option Scheme
concreteDomainScheme _ [] = None
concreteDomainScheme n ((n2, s)::rest) =
  if n == n2 && schemeHasConcreteDomain s then
    Some s
  else
    concreteDomainScheme n rest

-- True iff the scheme's type is `dom -> _` and [dom]'s spine head is a TCon (a
-- concrete receiver), distinguishing the standalone `Map k v -> …` from the method
-- `t a -> …` whose domain head is a quantified tyvar.
schemeHasConcreteDomain : Scheme -> Bool
schemeHasConcreteDomain (Forall _ _ t) = match normalize t
  TFun dom _ _ => monoSpineHeadIsCon dom
  _ => False

monoSpineHeadIsCon : Mono -> Bool
monoSpineHeadIsCon m = match normalize m
  TApp a _ => monoSpineHeadIsCon a
  TCon _ _ => True
  -- #1110 answer-preserving.  ⚠️ Semantically a rigid head is NOT concrete, so
  -- this arm is (like `headTyconMono`'s) part of the residual I6.1 violation —
  -- but it is what the shared `TCon` constructor answered, and `unifyN`'s
  -- tuple-clash guard reads it, so flipping it here would change diagnostics.
  TRigid _ => True
  _ => False

-- ── IMPORT-SCOPED per-module seeding (mirrors lib/typecheck.ml:4513-4543) ────
-- The multi-module drivers must NOT flat-seed the cumulative UNION of every
-- dependency's public schemes into each module's env: omInsert is last-write-wins,
-- so a later-loaded dependency's same-named binding (e.g. `string.reverse :
-- String -> String`) silently overwrites an earlier one (`list.reverse :
-- List a -> List a`) — mis-typing a module that explicitly `import list.{reverse}`.
-- Instead each module's seed is built from ONLY the names its own `DUse` decls
-- import, looked up in the SPECIFIC dependency they name.  The implicit prelude
-- (runtime + core) is always fully in scope and is threaded separately as baseSeed.

-- the bare member names a single `import` form names from its dependency —
-- mirrors lib/typecheck.ml's imported_names match (BEFORE mangle-key resolution):
--   UseGroup (_, ms) → the member names         (import dep.{a, b, c})
--   UseWild _        → ALL of the dep's schemes  (import dep.*)
--   UseName ns       → [last ns] if dotted (import a.b.name), else [] (bare name)
--   UseAlias _       → [] (alias only — no auto-imported value names)
-- `None` ⇒ wildcard (every scheme); `Some names` ⇒ exactly those member names.
-- (ORIGIN, LOCAL) per imported member.  They differ only under a member alias
-- (`import m.{a as b}`): the SCHEME is looked up under the origin `a` in the
-- dependency, and bound into this module's env under the local `b`.
importedBindings : UsePath -> Option (List (String, String))
importedBindings (UseGroup _ ms) = Some (map memberBinding ms)
importedBindings (UseWild _) = None
importedBindings (UseName ns)
  | listLen ns > 1 = Some [selfBinding (lastComponent ns)]
  | otherwise = Some []
-- A module alias enumerates the dependency's schemes, so it cannot be expressed as a
-- fixed member list — importFormSchemes handles it directly.
importedBindings (UseAlias _ _) = Some []

memberBinding : UseMember -> (String, String)
memberBinding m = (useMemberOrigin m, useMemberLocal m)

selfBinding : String -> (String, String)
selfBinding n = (n, n)

-- resolve one imported bare member name to its actual key in a dependency's public
-- schemes.  The golden path keys schemes by the bare name; the EMIT path runs after
-- universal mangling (backend.private_mangle), which rewrites a definition `member`
-- to `<dep>__member` but leaves the importer's `DUse` member name BARE — so the key
-- is the SUFFIX-matching scheme `…__member` (uniquely identified within THIS dep's
-- own schemes; distinct members never share an `__<name>` suffix).  Try the bare
-- key first (golden), then the `__<name>` suffix (mangled emit path).
memberSuffix : String -> String
memberSuffix n = "__" ++ n

-- local suffix test (string.endsWith is not imported here): `s` ends with `suf`.
endsWithStr : String -> String -> Bool
endsWithStr suf s =
  let ls = stringLength s
  let lsuf = stringLength suf
  lsuf <= ls && stringSlice (ls - lsuf) ls s == suf

-- Look the member up by its ORIGIN name, bind it under its LOCAL name.  Without an
-- alias the two coincide and this is the historical behaviour.
--
-- On the MANGLED emit path the bare origin is absent (the dep's keys are `<dep>__name`)
-- AND the reference in this module's body has itself been mangled to `<dep>__name` by
-- backend/private_mangle — so the suffix-matched entries are passed through under their
-- MANGLED keys, which is exactly the key the mangled reference will look up.  (A member
-- alias is erased by the same mangling, so it needs no rebinding there.)
-- PAYLOAD-GENERIC on purpose (RUN-XMOD-062).  This is the member-resolution half of the
-- ONE admission predicate — "which of a dependency's exported rows does this import form
-- admit, and under which local key" — and it is shared by every consumer of that
-- question rather than re-derived per payload.  Its callers today carry `Scheme`
-- payloads (`importFormSchemes`) and `(definer module, origin name)` payloads
-- (`importDefinersOf`); nothing in the body inspects the payload.
resolveMemberRows : (String, String) -> List (String, a) -> List (String, a)
resolveMemberRows (origin, local) depRows = match lookupAssoc origin depRows
  Some s => [(local, s)]
  None => filter (kv => endsWithStr (memberSuffix origin) (fst kv)) depRows

-- ── THE admission predicate for VALUES, payload-generic (RUN-XMOD-062) ─────────
-- "What does this import form admit out of a dependency's exported rows?", answered
-- ONCE for every caller that asks it.  The forms live in `importedBindings` (wildcard /
-- member list / bare-or-dotted / module alias) and are resolved here; the ALIAS arm is
-- deliberately not special-cased here, because what `A.name` re-keying means is
-- payload-specific — each caller handles `UseAlias` before delegating (see
-- `importFormSchemes`, which routes it to `aliasSchemes`).
--
-- 🚨 A CALLER MUST NOT RE-ENUMERATE THE FORMS.  Three consecutive repairs to the
-- dict-arity identity seam (#1425 F1 and its two relocations) each scoped their fix by
-- enumerating import forms by hand, and each enumeration missed a member the next
-- review found — wildcard, then selective re-export, then wildcard re-export.  Routing
-- through this function makes "did we cover every form" a property of ONE definition
-- instead of a hope: a form added to `importedBindings` reaches every caller by
-- construction.  `selectIfaceRows`/`narrowRowToNamed` are the same predicate for
-- interface ROWS (a row is a name plus a list of methods, so its narrowing is
-- per-method rather than per-key) — deliberate mirrors; move them in lockstep.
importFormRows : UsePath -> List (String, a) -> List (String, a)
importFormRows path depRows = match importedBindings path
  None => depRows
  Some bindings => flatMap (b => resolveMemberRows b depRows) bindings

-- `import m as A` binds EVERY value m exports under `A.name` — so it enumerates the
-- dependency's schemes rather than a fixed member list.
--
-- Same golden/mangled split as above: on the emit path the reference is already
-- `<definer>__name`, so the key must stay mangled; on the golden path the reference is
-- the flat `A.name` that desugar produced, so bind it under that.
--
-- #1337/#1427/#1472: the mangle test asks the LOADED MODULE-ID SET, not just the module
-- the importer spelled.  A key reached through `export import` is mangled for its
-- DEFINER, not for the re-exporter `m` that the importer named — so a spelled-mid-only
-- prefix test answered False for it and re-bound `lib_plain__g` as `A.lib_plain__g`,
-- while backend/private_mangle (which chases re-exports to the definer) had already
-- rewritten the body's reference to the bare `lib_plain__g`.  The lookup then missed:
-- for a constrained callee that reaches inferDictAt's panic and `build` fails outright
-- (#1427); for an unconstrained one the enclosing prelude call's dict route resolves to
-- nothing, the emitter writes a null dict operand, and the BINARY segfaults (#1472).
--
-- Conservatism (the property this rests on): a BARE key — one no loaded module exports
-- under that exact name with that module's own mangle prefix — is still re-bound under
-- the alias.  That population is exactly the interface METHODS (publicValNames admits
-- them; private_mangle's rename map, built from unitDefNames/pubFnNames, never renames
-- them), which is the occurrence-carrier question #1276/#1386 own — deliberately NOT
-- moved here.  The only keys whose binding changes are those a DIFFERENT loaded module
-- actually exports under its mangled name, i.e. precisely the re-exported ones, i.e.
-- precisely the defect.
--
-- 🚨 THE TEST IS AN IDENTITY TEST, NOT A STRING-SHAPE TEST (RUN-XMOD-039 F2), and it
-- must stay one.  A first version asked only "does `k` carry SOME loaded module's mangle
-- prefix?" — a pure spelling question — and that regressed a program base accepted: with
-- a module `lib.plain` loaded, an unrelated module's ordinary exported binding literally
-- named `lib_plain__g` was misread as already-mangled and rejected `Unbound variable:
-- O.lib_plain__g` at exit 1.  That surface is UNBOUNDED AND GROWS WITH THE MODULE GRAPH
-- (every module `a.b` makes `a_b__x` a landmine), and a sprint whose thesis is "identity
-- must not be derived from spelling" cannot decide identity by spelling, even in a guard.
-- ⚠️ So do NOT repair a future false positive here by TIGHTENING THE PREFIX PATTERN — a
-- narrower heuristic has a smaller unbounded surface, not a bounded one.  The conjunct
-- below is what bounds it: `k` must be a name the candidate module ACTUALLY EXPORTS, so
-- a false positive now requires two modules to genuinely export the same symbol rather
-- than one identifier to merely look like a mangled one.
aliasSchemes : List (String, List (String, Scheme)) -> String -> List (String, Scheme) -> List (String, Scheme)
aliasSchemes deps alias depSchemes =
  map (aliasSchemeEntry deps alias) depSchemes

aliasSchemeEntry : List (String, List (String, Scheme)) -> String -> (String, Scheme) -> (String, Scheme)
aliasSchemeEntry deps alias (k, s) =
  if isMangledExportOfAny deps k then
    (k, s)
  else
    (qualifiedLocal alias k, s)

-- does `k` carry the `<sanitized mid>__` prefix the mangler would have given it?
isMangledFor : String -> String -> Bool
isMangledFor mid k =
  let pre = mangledName mid ""
  let lp = stringLength pre
  lp <= stringLength k && stringSlice 0 lp k == pre

-- is `k` a symbol some loaded module ACTUALLY EXPORTS under that module's own mangled
-- name?  Both halves are load-bearing and the ORDER is deliberate: the cheap spelling
-- test gates the assoc lookup, so the scan below runs only for the rare key that already
-- looks mangled.  Short-circuiting and monomorphic on purpose (a dict-passed `any` over
-- a closure is the measured anti-pattern here).
--
-- 🚨 THE HONEST RESIDUAL, RECORDED SO THE NEXT READER DOES NOT HAVE TO RE-DERIVE IT
-- (RUN-XMOD-042).  This is "SHAPE **AND** ACTUALLY-EXPORTED", **not** pure identity, and
-- the distinction matters if you are auditing it against the sprint's own thesis that
-- identity must not be derived from spelling.  `isMangledFor` is still a string test; it
-- has simply stopped being the *whole* decision.  What the `isSome (lookupAssoc k pubV)`
-- conjunct buys is that the surface becomes BOUNDED BY THE PROGRAM'S REAL EXPORT SET: a
-- false positive now needs a GENUINE SYMBOL COLLISION -- module `m` must actually export
-- something named exactly `k`, where `k` also carries `m`'s mangle prefix -- instead of
-- merely a similar-LOOKING name.  Before the conjunct, the surface grew with the module
-- graph (every module `a.b` made `a_b__x` a landmine, which is what regressed `core__foo`
-- and `lib_plain__g`); now it does not grow with the graph at all.
--
-- ⚠️ WHY NOT DROP THE SHAPE HALF AND MAKE IT PURE IDENTITY?  Because that is measurably
-- WRONG here, not merely purer: a re-exported interface METHOD key is also a key of its
-- declaring module's `pubV`, so "is `k` a key of some other loaded module?" alone answers
-- True for methods and would re-bind them -- moving the bare-key population that
-- #1276/#1386 own and that this slice must not touch.  The shape half is precisely what
-- holds methods out (a bare method name carries no `<mid>__` prefix).  So the two halves
-- are not redundant and neither may be removed on tidiness grounds.
--
-- ⚠️ The residual's true root is one level down and is NOT fixed here: private_mangle's
-- `(module, name) -> symbol` encoding is not injective -- a module `lib.plain` and a
-- module literally named `lib_plain` both yield `lib_plain__g`.  That is the common root
-- of both regressions above and is bigger than this function; do not try to repair it by
-- editing this test.
isMangledExportOfAny : List (String, List (String, Scheme)) -> String -> Bool
isMangledExportOfAny [] _ = False
isMangledExportOfAny ((m, pubV)::rest) k = isMangledFor m k && isSome (lookupAssoc k pubV)
  || isMangledExportOfAny rest k

-- the (key, scheme) pairs a single `import` form brings into scope, resolving each
-- member to its (possibly mangled) key in the dependency's schemes.  `deps` is the
-- loaded dependency environment — module id PLUS that module's public schemes, because
-- the alias arm's test needs the exported NAMES, not just the ids (see aliasSchemes).
-- The non-alias arms ignore it — their resolution is definer-agnostic by construction
-- (a `__<name>` SUFFIX test, and the wildcard form performs no mangle test at all).
--
-- Passing `depEnv` WHOLE is also what supplies the spelled `depId` itself: both callers
-- reach this only through a successful `lookupAssoc depId depEnv`, so the spelled module
-- is in the list by construction and needs no separate term.
--
-- 🚨 `"core"` IS DELIBERATELY **NOT** IN `mids`, AND MUST NOT BE ADDED BACK
-- (RUN-XMOD-039).  It was, briefly.  The argument for it reads well — `reexportSeed`'s
-- own comment records core as the one source NOT in depEnv, and private_mangle *does*
-- mangle core's exports to `core__<name>` — but it was DERIVED, never witnessed: a
-- `export import core.{…}` reached through an alias is green on every verb with or
-- without the term, because core's names are seeded via `baseSeed` and resolve before
-- the alias binding is ever consulted.  Meanwhile the term has a MEASURED cost: it made
-- `mangledName "core" "" == "core__"` a live prefix, so an ordinary user binding named
-- `core__foo` reached through an alias import was misread as already-mangled and left
-- un-rebound — `Unbound variable: O.core__foo`, exit 1, on a program that compiled and
-- printed correctly before.  Zero measured benefit, measured cost.
importFormSchemes : List (String, List (String, Scheme)) -> UsePath -> List (String, Scheme) -> List (String, Scheme)
importFormSchemes deps (UseAlias _ alias) depSchemes =
  aliasSchemes deps alias depSchemes
importFormSchemes _ path depSchemes = importFormRows path depSchemes

-- ── import aliasing: re-key the dict-arity / dict-iface tables ───────────────────
-- Both tables (funConstraintsRef, funConstraintIfacesRef) are keyed by the name a CALL
-- SITE writes.  An alias makes that name differ from the definition's, so without this
-- an aliased constrained callee gets zero dict routes and under-applies.  Generic over
-- the payload so the arity table (List Int) and the iface table (List String) share it.
--
-- [qual] is the (definerMid, name)-keyed table, which is what makes this PRECISE: an
-- entry is copied only when its DEFINER is the very module the alias names.
-- #1114 (#845): THIS module's imported bindings' SCHEME CONTEXTS, keyed by the local
-- spelling the importer writes.  Structurally the sibling of `aliasConstraintEntries`
-- below — same `DUse` walk, same "copy an entry only when its DEFINER is the very module
-- this import names" precision, and the payload is likewise taken from the
-- `(definerMid, name)`-keyed qual table.
--
-- TWO deliberate differences from `aliasConstraintEntries`, both because that function
-- serves the DICT-ARITY tables on the emit path and this one serves the CHECK-time
-- obligation channel:
--   * it has a `UseWild` arm.  `aliasConstraintEntries` needs none — on the emit path a
--     wildcard-imported name keeps its own spelling and `funConstraintsRef` is re-seeded
--     from the bare `crossModuleFunConstraintsRef` accumulator, which already covers it.
--     The check path has no such bare re-seed (that ref is the emit path's), so without
--     this arm `import m.*` would be the one spelling that still dropped the obligation.
--   * it emits the UNALIASED member of a `UseGroup` too (`useMemberLocal`, not
--     `useMemberAlias`), because plain `import m.{f}` is the common spelling and is
--     exactly what #845 pins.
--
-- ⚠️ Kept SEPARATE from `aliasConstraintEntries` rather than generalizing it. Adding a
-- `UseWild` arm there would change what `funConstraintsRef` holds on the emit path, i.e.
-- dict-passing arity — a different judgment, with a different blast radius, reached from
-- here only by the coincidence that both read the same qual-table shape.
importedSchemeOblEntries : List Decl -> List ((String, String), List VecObl) -> List (String, List VecObl)
importedSchemeOblEntries [] _ = []
importedSchemeOblEntries ((DAttrib _ d)::rest) qual = importedSchemeOblEntries [d] qual
  ++ importedSchemeOblEntries rest qual
importedSchemeOblEntries ((DUse _ path _)::rest) qual = schemeOblEntriesFor (usePathModuleId path) path qual
  ++ importedSchemeOblEntries rest qual
importedSchemeOblEntries (_::rest) qual = importedSchemeOblEntries rest qual

schemeOblEntriesFor : String -> UsePath -> List ((String, String), List VecObl) -> List (String, List VecObl)
-- `import m as A` → every constrained binding m defines is written `A.<name>` here.
schemeOblEntriesFor mid (UseAlias _ a) qual =
  flatMap (moduleAliasEntry mid a) qual
-- `import m.*` → every constrained binding m defines is written under its OWN name here.
schemeOblEntriesFor mid (UseWild _) qual = flatMap (wildSchemeOblEntry mid) qual
-- `import m.{x}` / `import m.{x as y}` → `x` (resp. `y`) carries x's scheme context.
schemeOblEntriesFor mid (UseGroup _ ms) qual =
  flatMap (memberSchemeOblEntry mid qual) ms
-- `import m` binds NO names (it exists to bring m's impls into scope), so nothing here.
schemeOblEntriesFor _ _ _ = []

wildSchemeOblEntry : String -> ((String, String), List VecObl) -> List (String, List VecObl)
wildSchemeOblEntry mid ((defMid, n), obs)
  | defMid == mid = [(n, obs)]
  | otherwise = []

memberSchemeOblEntry : String -> List ((String, String), List VecObl) -> UseMember -> List (String, List VecObl)
memberSchemeOblEntry mid qual m =
  let local = useMemberLocal m
  let origin = useMemberOrigin m
  map
    (e => (local, snd e))
    (filterList (e => fst (fst e) == mid && snd (fst e) == origin) qual)

-- B-2.2-f (#1113): the payload is `a`, not `List a`.  The declared-prefix sidecar's
-- qual table carries a per-entry SCALAR (`CDeclaredPrefix`), which does not fit a
-- list-shaped payload; every existing caller instantiates `a := List X` unchanged.
aliasConstraintEntries : List Decl -> List ((String, String), a) -> List (String, a)
aliasConstraintEntries [] _ = []
aliasConstraintEntries ((DAttrib _ d)::rest) qual = aliasConstraintEntries [d] qual
  ++ aliasConstraintEntries rest qual
aliasConstraintEntries ((DUse _ path _)::rest) qual = aliasEntriesFor (usePathModuleId path) path qual
  ++ aliasConstraintEntries rest qual
aliasConstraintEntries (_::rest) qual = aliasConstraintEntries rest qual

aliasEntriesFor : String -> UsePath -> List ((String, String), a) -> List (String, a)
-- `import m as A` → every constrained fn m defines is callable as `A.<name>`.
aliasEntriesFor mid (UseAlias _ a) qual = flatMap (moduleAliasEntry mid a) qual
-- `import m.{x as y}` → `y` carries `x`'s dict arity.
aliasEntriesFor mid (UseGroup _ ms) qual =
  flatMap (memberAliasEntry mid qual) ms
aliasEntriesFor _ _ _ = []

-- ── import aliasing of an interface/impl METHOD ─────────────────────────────────
-- A method is GLOBAL-BY-NAME.  Impl coalescing, dispatch routing, the emitter's method
-- tables and the METHOD-side dict-arity tables are every one of them keyed by the
-- method's own name, and there is exactly ONE cell per name — a method is deliberately
-- NOT a per-module binding (eval.mdk's globalCells / coalesceImpls).  So an alias of a
-- method is not a new binding at all: it is a second SPELLING of the same method.
--
-- Resolve it back to the origin name here, once, right after resolve has validated the
-- alias and before ANY marking / route-stamping / dict-arity machinery runs.  Every
-- downstream stage — marker, typecheck route stamping, private_mangle, the emitter, both
-- eval drivers — then sees an ordinary method reference and needs no alias awareness.
--
-- That is also precisely why the METHOD-side dict-arity tables (methodConstraintsRef /
-- crossModuleMethodConstraintsQualRef / scopeMethodArities) need no alias re-keying the
-- way funConstraintsRef did: by the time they are built, no aliased method name survives.
-- The standalone `=>`-constrained functions are the opposite case — they ARE per-module
-- bindings that keep their local name, which is why they needed the re-keying.
--
-- Caveat, shared with the marker's own shadowRename: the rewrite is scope-blind, so a
-- LOCAL binder whose name equals an alias local would also be rewritten.  An alias local
-- is chosen by the importing file, so this is a self-inflicted collision.
-- The rewrite has TWO halves, and they must agree: rewriting only the references would
-- leave them bound to nothing.
--   (a) every reference to an aliased method  → the origin method name
--   (b) the module's own `DUse` decls          → import that method under its ORIGIN name
-- With (b) in place, the import seed (typecheck), the import frame (eval) and the
-- rename map (private_mangle) all bind the origin name by their ORDINARY un-aliased
-- paths — none of them needs to learn anything about aliases.
renameAliasedMethods : List Decl -> List (String, List Decl) -> List (String, List Decl)
renameAliasedMethods coreDecls modules =
  let coreEntry = ("core", declMethodNames coreDecls)
  let methodsPerMid = coreEntry :: methodsPerMidGo [coreEntry] modules
  map (renameAliasedMethodsIn methodsPerMid) modules

-- A module's method set is what it DECLARES *plus what it RE-EXPORTS*, folded in
-- dependency-first (loader) order so a re-export resolves against its source's
-- already-computed set (and a >1-hop chain still resolves).
--
-- The `++ reexportedMethodNames` half closes a run≠build divergence that predates
-- core re-exports and is NOT core-specific: with a module's set limited to its own
-- `declMethodNames`, a module that re-exports a method did not list it, so at an
-- importer's `import reExporter.{method as alias}` neither half of the rewrite fired
-- — the alias was not dropped from the DUse (b) and references were not renamed to the
-- origin (a).  `run` still worked (eval's import frame binds the alias to the origin's
-- cell), but a method is global-by-name with no per-module symbol, so EMIT had nothing
-- to bind `alias` to and died with `unbound variable '<alias>'`.  Observed on a pure
-- user-module chain (b defines `area`; c re-exports it; main imports `area as surface`
-- → run prints 16, build fails), and on `import list.{filter as f}` once
-- `export import core.{filter}` began re-exporting at all.
methodsPerMidGo : List (String, List String) -> List (String, List Decl) -> List (String, List String)
methodsPerMidGo _ [] = []
methodsPerMidGo acc ((mid, decls)::rest) =
  let entry = (mid, dedup (declMethodNames decls ++ reexportedMethodNames acc decls))
  entry :: methodsPerMidGo (entry::acc) rest

-- method names a module re-exports via `export import src.{…}` (`DUse True`), taken
-- from `acc` — the dependency's already-folded method set.
reexportedMethodNames : List (String, List String) -> List Decl -> List String
reexportedMethodNames acc decls = flatMap (reexportedMethodsOf acc) decls

reexportedMethodsOf : List (String, List String) -> Decl -> List String
reexportedMethodsOf acc (DAttrib _ d) = reexportedMethodsOf acc d
reexportedMethodsOf acc (DUse True path _) = match lookupAssoc (usePathModuleId path) acc
  None => []
  Some srcMethods => match importedBindings path
    -- `export import src.*` re-exports every one of src's methods
    None => srcMethods
    Some bs => filterList (n => contains n srcMethods) (map fst bs)
reexportedMethodsOf _ _ = []

-- ── #1111 A-2.5b: the graph's method-IDENTITY index ─────────────────────────
-- `mid → [(name the row carries this method under, the Ident of the interface
-- declaration it means)]`, folded DEPENDENCY-FIRST so a `export import src.{…}`
-- resolves against `src`'s already-computed row and a >1-hop re-export chain still
-- resolves.  Same shape and the same ordering argument as `methodsPerMidGo` above,
-- one level up: identities instead of names.
--
-- This is what makes `usePathWitnesses` answer *"does this import bring in THAT
-- declaration"* rather than *"does the spelling match"* — see its comment for the two
-- S0s the spelling question produced (#1272 / #1275).
--
-- 🚨 INTERIM — AND THIS TREE ALREADY COMPUTES THIS FACT TWICE ELSEWHERE.  Say it plainly
-- rather than leaving it to the next reader to discover: `resolve.mdk` already derives
-- module → exported method identities (`ModuleExports.expIfaceMethods` /
-- `reExpIfaceMethods`, and `valueProvenance` / `ambiguousSet`, which reach interface
-- methods because `publicIfaceMethodVals` folds a public interface's methods into
-- `expValues`).  This is therefore a THIRD implementation of one fact, and #1288 is an
-- open S1 against resolve's copy of it.  The long-term home is UPSTREAM: R / #1288's fix
-- owns the fact and typecheck CONSUMES it.  **The absorbing stage that deletes this
-- function is R / #1288.**  It lands now, as named scaffolding, only because two S0s
-- (#1272 / #1275) would otherwise wait on a component that does not exist yet.
--
-- ── THE SAFETY PROPERTY, AND IT IS A CONJUNCTION.  Both halves, or neither. ──
-- The result is stored in `driverState.graphMethodExportsRef`, read only by
-- `depExportsMethodIdent`.  What makes that safe is BOTH of:
--
--   (a) UNCONDITIONAL WHOLE-VALUE OVERWRITE AT EVERY Module-MODE DRIVER ENTRY.  The two
--       entries are `checkModulesPreamble` and `elaborateModules`, each doing
--       `setRef driverState.value.graphMethodExportsRef (graphMethodExports coreDecls modules)`
--       over THAT compile's graph.  Never `omInsert`, never a merge — so compile N's rows
--       cannot reach compile N+1.  This half is NECESSARY: `freshDriverState` initialises
--       the field to `omEmpty`, so a driver that omits the write reads an empty index and
--       every candidate misses, which is F1's symptom exactly.
--   (b) NO RESET POINT IN BETWEEN.  `DriverState` has none — its own header says
--       `freshDriverState` is the INITIAL construction only, and no whole-bundle
--       `setRef driverState (…)` exists in the tree.  This half is also NECESSARY: on
--       `CrossRun` the writes in (a) were already there and correct, and F1 still
--       happened, because `resetCrossModuleState` cleared the field between the write and
--       the read.
--
-- ⚠️ Do not restate this as "who clears, not who writes", and do not restate it as the
-- writer enumeration alone.  Each of those was written down during review, each is half
-- the property, and F1 is what the missing half costs.  (b) is greppable; (a) is a
-- two-site enumeration that a new driver can invalidate — which is why the precondition
-- is spelled out at `checkModuleFullDiags` as well.
--
-- ⚠️ Must run on the STAMPED graph: identity comes from `DInterface.ifaceOrigin`, which
-- `stampGraphTyOrigins` writes.  Both call sites (`checkModulesPreamble`,
-- `elaborateModules`) sit after their driver's stamp.
--
-- 🚨 THERE IS NO `pub` FILTER, so "exports" is the WRONG word for a row and this comment
-- said it for a round (F3).  `declMethodIdentsOf` takes every `DInterface`, PRIVATE ones
-- included, which diverges from resolve's `expIfaceMethodsDirect` (that one does filter
-- `pub = True`).  Under a WILDCARD import `usePathBindsName` is `True` for every name, so
-- a dependency's private interface can witness a name it does not put in scope —
-- MEASURED: the valid fixture graph plus `import mspriv.*`, where `mspriv` declares a
-- non-`pub` `interface MSIP`, is rejected `No impl of MSIP for Blob`, naming a private
-- interface of another module.  **PRE-EXISTING, not this unit's regression** — A-2.5's
-- witness (a) had the identical gap, and it reproduces on `main`; filed separately, and
-- deliberately NOT fixed here because whether a private interface's method is visible to
-- dispatch is a LANGUAGE decision the spec should make before the code does.
--
-- The absence of the filter is also what lets `usePathWitnesses` drop its separate
-- declaring-module witness: `import dep.{mth}` where `dep` declares the interface —
-- public or not — is just the row `dep` seeds itself with.
graphMethodExports : List Decl -> List (String, List Decl) -> OrdMap (List (String, Ident))
graphMethodExports coreDecls modules =
  graphMethodExportsGo
    (omInsert "core" (declMethodIdents coreDecls) omEmpty)
    modules

graphMethodExportsGo : OrdMap (List (String, Ident)) -> List (String, List Decl) -> OrdMap (List (String, Ident))
graphMethodExportsGo acc [] = acc
graphMethodExportsGo acc ((mid, decls)::rest) =
  graphMethodExportsGo
    (omInsert
      mid
      (declMethodIdents decls ++ reexportedMethodIdents acc decls)
      acc)
    rest

-- the (method name, declaring identity) pairs [decls] DECLARES.  An impl declares no
-- method — it implements one — so only `DInterface` contributes, and a declaration with
-- no module id contributes nothing (honest absence, §8 I6.3) exactly as
-- `insertIfaceMethodIdents` does.
--
-- ⚠️ F3 LIVES HERE: the `DInterface` pattern does not bind `pub`, so a PRIVATE interface
-- contributes too.  Pre-existing and deliberately unfixed in this unit — the full
-- derivation, the measured repro and the reason it is a language decision are on
-- `graphMethodExports` above.
declMethodIdents : List Decl -> List (String, Ident)
declMethodIdents decls = flatMap declMethodIdentsOf decls

declMethodIdentsOf : Decl -> List (String, Ident)
declMethodIdentsOf (DAttrib _ d) = declMethodIdentsOf d
declMethodIdentsOf (DInterface { methods, ifaceOrigin, ... }) =
  flatMap (m => ifaceMethodIdentPair ifaceOrigin m) methods
declMethodIdentsOf _ = []

ifaceMethodIdentPair : TyConOrigin -> IfaceMethod -> List (String, Ident)
ifaceMethodIdentPair origin (IfaceMethod mname _ _) = match mkIdent NsMethod origin mname
  None => []
  Some i => [(mname, i)]

-- the identities a module RE-EXPORTS via `export import src.{…}` (`DUse True`), taken
-- from [acc] — the dependency's already-folded row.
--
-- ⚠️ `local` and `origin` are ALWAYS EQUAL here, so `reexportRenamed` never renames.
-- This comment used to read "the exported NAME is the member's LOCAL spelling
-- (`export import src.{a as b}` exports `b`)" — which describes a program the parser
-- REFUSES: `compiler/frontend/parser.mdk:2369,2376` reject both `export import m as A`
-- and `export import m.{a as b}` outright.  The generality is kept (it costs one
-- `filterList`, and it is the shape a future `export import … as …` would need) but it
-- is DEAD TODAY and must not be cited as behaviour.
reexportedMethodIdents : OrdMap (List (String, Ident)) -> List Decl -> List (String, Ident)
reexportedMethodIdents acc decls = flatMap (reexportedMethodIdentsOf acc) decls

reexportedMethodIdentsOf : OrdMap (List (String, Ident)) -> Decl -> List (String, Ident)
reexportedMethodIdentsOf acc (DAttrib _ d) = reexportedMethodIdentsOf acc d
reexportedMethodIdentsOf acc (DUse True path _) = match omLookup (usePathModuleId path) acc
  None => []
  Some src => match importedBindings path
    -- `export import src.*` re-exports every one of src's methods, under their own names
    None => src
    Some bs => flatMap (b => reexportRenamed b src) bs
reexportedMethodIdentsOf _ _ = []

reexportRenamed : (String, String) -> List (String, Ident) -> List (String, Ident)
reexportRenamed (origin, local) src =
  map (e => (local, snd e)) (filterList (e => fst e == origin) src)

-- ── #1354 unit A follow-up: the TYPE-namespace peer of graphMethodExports ────
-- Stored in `driverState.graphIfaceMethodsRef`, declared bare (no interior record
-- comment) next to its method-namespace peer: `DriverState`'s header is still the
-- two-line `data X =` / `| X {` form, and `medaka fmt --write` MOVES a trailing comment
-- one field down on that shape while `fmt --check` reports the result as clean (#829,
-- REOPENED).  It did exactly that to the first draft of this line — the comment landed on
-- `graphCtorExportsRef`, where it read as describing the constructor index.  The prose
-- lives here instead, which is the workaround PR #1296 uses for the same record.
-- `mid → [(interface name as this module provides it, that interface's method names)]`,
-- folded DEPENDENCY-FIRST so an `export import src.{…}` resolves against `src`'s
-- already-computed row and a >1-hop re-export chain still resolves.  Read only by
-- `nameableIfaceMethodSet`.
--
-- 🚨 WHY THIS EXISTS AND `graphMethodExports` COULD NOT BE REUSED — the defect this fixes.
-- `SHADOW-SEMANTICS.md` §1.0 says S1's `nameable in M` predicate applies to **S1's
-- INTERFACE operand** — a TYPE-namespace question, "is this interface one `M` can name?".
-- The first cut of this fix asked `graphMethodExports` instead, which is a **METHOD**-name
-- index, and the two disagree in BOTH directions:
--
--   * TOO STRICT on a chain.  A re-exporter's row is built by matching the `export import`
--     member list against METHOD names (`reexportRenamed`), so the ordinary
--     `export import ifc.{Sizeable}` — re-exporting the interface by its TYPE name —
--     yielded an EMPTY row and the predicate answered "not nameable" for an interface that
--     demonstrably is.  MEASURED, two entry files differing by one import line: the direct
--     import printed `300` and the chained one was REJECTED `Type mismatch: Int vs Box`.
--     That is exactly what `SHADOW-SEMANTICS.md`'s S1-CHAIN forbids — it says the predicate
--     "MAY NOT fail closed on chains" and enumerates an implementation satisfied only by a
--     DIRECT export as **newly NON-CONFORMANT** (#1380).
--   * TOO LOOSE on one hop.  Any import of the interface's home module admitted that
--     module's WHOLE method row, so `import smod.{sf}` — which binds one unrelated function
--     — made `Sizeable` "nameable".  It is not: `impl Sizeable Blob` in that module is
--     rejected `Unknown interface: Sizeable` (resolve, `UnknownInterface`).  That left
--     #1353 NARROWED rather than fixed — its own repro with the bridge hop removed.
--
-- Both are the same error: answering a method-namespace question where the spec asks a
-- type-namespace one.  The member test that is WRONG for a method name (an interface is
-- nameable through an import that never mentions its methods — the corpus's own `i3`,
-- `import ifc.{Sizeable, Box(..)}`) is exactly RIGHT for the interface name, which is what
-- `selectIfaceRows` applies on both the import and the re-export side.
--
-- ⚠️ IT MUST BE BUILT HERE, NOT TAKEN FROM RESOLVE, even though resolve owns
-- `UnknownInterface` and already derives module exports.  `stampGraphTyOrigins`' own note
-- says why: the separate `medaka_emitter` process NEVER RUNS RESOLVE, so a predicate that
-- consumed resolve's tables would decide differently on `build` than on `check`/`run` — a
-- manufactured front/back split (#1382).  This is therefore a THIRD derivation of a fact
-- resolve owns, exactly as `graphMethodExports` is, and it retires at the same place: R /
-- #1288, whose fix owns the fact and makes typecheck consume it.  Named scaffolding.
--
-- ⚠️ NO `pub` FILTER, exactly as `declMethodIdentsOf` has none (F3) — a private interface
-- contributes a row.  That is the FAIL-OPEN direction for this predicate (it can only ADD
-- shadow-hood, never remove it), which is the direction `nameableIfaceShadows` argues for.
--
-- SAFETY PROPERTY: the conjunction stated in full on `graphMethodExports` — unconditional
-- whole-value overwrite at every Module-mode driver entry, AND no reset point in between —
-- applies verbatim, because this ref is written on the same two lines and lives on the same
-- `DriverState` that `resetCrossModuleState` does not touch.
graphIfaceMethods : List Decl -> List (String, List Decl) -> OrdMap (List (String, List String))
graphIfaceMethods coreDecls modules =
  graphIfaceMethodsGo
    (omInsert "core" (ifaceMethodRows coreDecls) omEmpty)
    modules

graphIfaceMethodsGo : OrdMap (List (String, List String)) -> List (String, List Decl) -> OrdMap (List (String, List String))
graphIfaceMethodsGo acc [] = acc
graphIfaceMethodsGo acc ((mid, decls)::rest) =
  graphIfaceMethodsGo
    (omInsert
      mid
      (ifaceMethodRows decls ++ reexportedIfaceMethods acc decls)
      acc)
    rest

-- the (interface name, its method names) pairs [decls] DECLARES.
ifaceMethodRows : List Decl -> List (String, List String)
ifaceMethodRows decls = flatMap ifaceMethodRowOf decls

ifaceMethodRowOf : Decl -> List (String, List String)
ifaceMethodRowOf (DAttrib _ d) = ifaceMethodRowOf d
ifaceMethodRowOf (DInterface { name, methods, ... }) =
  [(name, ifaceMethodNames methods)]
ifaceMethodRowOf _ = []

-- the rows a module RE-EXPORTS via `export import src.{…}` (`DUse True`), taken from [acc]
-- — the dependency's already-folded row, which is what makes a chain of any depth resolve.
reexportedIfaceMethods : OrdMap (List (String, List String)) -> List Decl -> List (String, List String)
reexportedIfaceMethods acc decls = flatMap (reexportedIfaceMethodsOf acc) decls

reexportedIfaceMethodsOf : OrdMap (List (String, List String)) -> Decl -> List (String, List String)
reexportedIfaceMethodsOf acc (DAttrib _ d) = reexportedIfaceMethodsOf acc d
reexportedIfaceMethodsOf acc (DUse True path _) = match omLookup (usePathModuleId path) acc
  None => []
  Some src => selectIfaceRows path src
reexportedIfaceMethodsOf _ _ = []

-- ── S1-NS (RULED 2026-08-08): the rows of [src] a use-path admits ──────────
-- `docs/spec/SHADOW-SEMANTICS.md` S1-NS (a): S1's right operand is the PER-METHOD UNION of
-- the two namespaces.  A row `(I, ms)` is NARROWED, not merely kept or dropped:
--
--   * WILDCARD (`import m.*`) — everything the dependency provides, so the whole row.
--   * MODULE ALIAS (`import m as A`) — the whole row, on the VALUE arm: `A.n` is a legal
--     call for every method `n`.  An alias cannot put a TYPE name in scope (alias-qualified
--     names in type position are a parse error), so it admits nothing on the type arm — but
--     a union needs only one arm.
--   * MEMBER LIST — the TYPE arm admits the WHOLE row when the list names the interface `I`
--     (an author who can write `impl I T` can write every method of `I`); otherwise the
--     VALUE arm admits ONLY the methods the list actually names.
--   * BARE (`import m`) or DOTTED (`import a.b.n`) — `importedBindings` answers `Some []` for
--     the bare form, so the member list is EMPTY and admits NOTHING.  Stated because the
--     three bullets above read as an exhaustive enumeration and this is the fourth arm:
--     reading an empty member list as "binds everything" (the way a wildcard legitimately is
--     read) is a real mistake, and `i15_importer_iface_one_hop_unbound/bare.mdk` exists to
--     catch it.  A bare import brings IMPLS into scope, which S2 governs; it binds no NAMES,
--     which is all S1 asks about.
--
-- 🚨 PER METHOD, NOT PER ROW, and this is measured rather than stylistic: `import ifc.{tag}`
-- leaves a sibling method UNBOUND (*"Unbound variable: size. (Did you forget to
-- 'import ifc.{size}'?)"*), so admitting the whole row because the list names ONE method
-- makes a DIFFERENT name dispatch-eligible on evidence that says nothing about it.  That
-- over-approximates both namespaces at once, and it is what silently replaced a module's own
-- top-level `size` with a foreign impl body (777 where 42 is correct, exit 0, no diagnostic
-- on any verb — `test/shadow_fixtures/d23_definer_sibling_method_silent/`).
--
-- ⚠️ ONE SELECTOR, USED ON THE IMPORT ARM **AND** THE RE-EXPORT ARM.  S1-NS makes the two
-- symmetric: `export import ifc.{size}` must admit `size` one hop down exactly as
-- `export import ifc.{Sizeable}` admits the row.  An implementation whose arms evaluate
-- different namespaces is enumerated NON-CONFORMANT, and it was live here — a method-name
-- re-export chain that `main` builds and runs at 50 failed `build` with `E-PANIC: arg-tag
-- dispatch on impl type that owns no constructors`.  Keeping this ONE function is what makes
-- that unrepresentable rather than merely fixed (`i20_importer_method_reexport_chain/`).
selectIfaceRows : UsePath -> List (String, List String) -> List (String, List String)
selectIfaceRows (UseAlias _ _) src = src
selectIfaceRows path src = match importedBindings path
  None => src
  Some bs => flatMap (r => narrowRowToNamed (map fst bs) r) src

-- TYPE arm: the list names the interface → the whole row.  VALUE arm: it does not → only
-- the methods it names.  An empty narrowing contributes no row at all.
--
-- 🚨 KNOWN DEVIATION FROM S1-NS (a)(ii), AND IT IS OBSERVABLE TODAY.  [named] is built from
-- the member ORIGIN spellings (`map fst bs`), so `import ifc.{size as sz}` admits `size` —
-- the name in the DEPENDENCY — while the only name this module can write for that method is
-- `sz`.  S1-NS (a)(ii) says the admitted name must be the CALLABLE one.
--
-- ⚠️ An earlier version of this note claimed the deviation was "unobservable today because
-- member-ALIASED method imports are independently broken".  BOTH HALVES ARE FALSE, measured:
-- `import ifc.{size as sz}` then `sz "ab"` prints 7, so aliased method imports work fine;
-- and a program does reach the difference — with a standalone `size` imported from `fmod`,
-- adding `import ifc` prints 99 while adding `import ifc.{size as sz}` prints 7, the two
-- differing only in that second import line.  Under the clause, 99 is correct for BOTH: the
-- alias case gives this module no way to write `size` for the method, so `size` unambiguously
-- denotes `fmod`'s standalone.
--
-- NOT FIXED HERE, deliberately.  It is NOT a regression — base prints 7 too, so the alias arm
-- is exactly where this unit changes nothing — and any fix is a behaviour change on a fresh
-- axis that no ruling has been written for.  Pinned instead, so it self-drains:
-- `test/shadow_fixtures/i22_importer_member_alias_not_nameable/`.
--
-- 🚨 THE FIX SHAPE IS NOT KNOWN, AND THE OBVIOUS ONE IS INERT.  This note used to end *"the
-- fix shape when it is taken: key the VALUE arm on `snd` (the LOCAL spelling) while the TYPE
-- arm keeps `fst`"*.  It cannot move the run/build answer, and that is DERIVABLE from this
-- file without building anything — grep the two call sites and read the order:
--
--     grep -n 'renameAliasedMethods \|graphIfaceMethods coreDecls' compiler/types/typecheck.mdk
--
-- `renameAliasedMethods` has exactly ONE call site, in `elaborateModules`, and it runs
-- BEFORE that driver writes `graphIfaceMethodsRef` and before the mark pass.  It applies
-- `deAliasMethodImports`, whose whole job (b) is rewriting `import ifc.{size as sz}` into
-- `import ifc.{size}` — the alias is dropped because a method is global-by-name.  So by the
-- time `selectIfaceRows` runs on that path, `snd b == fst b` for every member and the two
-- keyings are literally the SAME EXPRESSION.  A reviewer implemented the one-token change,
-- rebuilt, and measured `i22/main.mdk` still at **7** — which is what the derivation
-- predicts.  (The `check` path does NOT de-alias, having no `renameAliasedMethods` call, so
-- re-keying WOULD move that arm alone.  That is a `check`≠`run` split, not a fix.)  A real
-- fix therefore spans at least those two functions and is a design question, because simply
-- not de-aliasing breaks aliased method CALLS outright, which is the whole reason
-- `deAliasMethodImports` exists.
-- A DOCUMENTED FIX SHAPE THAT IS INERT IS WORSE THAN NONE: the next person implements it,
-- sees nothing move, and concludes the defect is somewhere else.
narrowRowToNamed : List String -> (String, List String) -> List (String, List String)
narrowRowToNamed named r
  | contains (fst r) named = [r]
  | otherwise = match filterList (m => contains m named) (snd r)
    [] => []
    ms => [(fst r, ms)]

-- ── #1111 A-2.11 (#1319 unit 1): the CONSTRUCTOR peer of graphMethodExports ──
-- (module id → [(ctor name, owning type name, declaring `Ident`)]), folded dependency-first
-- so a `export import` chain resolves transitively and BY IDENTITY.  Read only by
-- `depExportsCtorIdent`.  Its SAFETY PROPERTY is the conjunction stated in full on
-- `graphMethodExports` and it is the SAME conjunction, not a similar one:
--   (a) unconditional whole-value overwrite at EVERY Module-mode driver entry —
--       `checkModulesPreamble` and `elaborateModules`, each carrying the line
--       `setRef driverState.value.graphCtorExportsRef (graphCtorExports coreDecls modules)`;
--   (b) no reset point in between — `DriverState` has none, which is why this ref lives
--       there and not on `CrossRun` (`resetCrossModuleState` would clear it between the
--       write and the read: that was F1).
-- Both halves, or neither.  An empty index makes every candidate miss, the override
-- declines everywhere, and the unit silently does nothing.
--
-- ⚠️ Must run on the STAMPED graph — identity comes from `DData.dataOrigin` /
-- `DNewtype.newtypeOrigin`, which `stampGraphTyOrigins` writes.  Both call sites sit
-- after their driver's stamp.
--
-- ⚠️ THE OWNING TYPE NAME IS IN THE ROW ON PURPOSE.  It is what lets a `(..)` member be
-- expanded on BOTH sides of the chain — `export import m.{T(..)}` re-exporting T's
-- constructors, and `import m.{T(..)}` witnessing one — through the single shared
-- predicate `memberBindsCtorName`.  Without it the `(..)` spelling silently binds nothing
-- here, which is the #1272 shape.
--
-- ⚠️ NO `pub` FILTER, exactly as `declMethodIdentsOf` has none — but unlike the method
-- peer this cannot become that peer's F3 gap, and the reason is structural rather than a
-- promise: the CANDIDATES this index is matched against come from `publicDataDecls`
-- (`appendDataUniverse`), so a private declaration's row entry can never equal a
-- candidate's `Ident` and can never witness anything.
graphCtorExports : List Decl -> List (String, List Decl) -> OrdMap (List (String, String, Ident))
graphCtorExports coreDecls modules =
  graphCtorExportsGo
    (omInsert "core" (declCtorIdents coreDecls) omEmpty)
    modules

graphCtorExportsGo : OrdMap (List (String, String, Ident)) -> List (String, List Decl) -> OrdMap (List (String, String, Ident))
graphCtorExportsGo acc [] = acc
graphCtorExportsGo acc ((mid, decls)::rest) =
  graphCtorExportsGo
    (omInsert mid (declCtorIdents decls ++ reexportedCtorIdents acc decls) acc)
    rest

-- the (ctor name, owning type name, declaring identity) rows [decls] DECLARES.
declCtorIdents : List Decl -> List (String, String, Ident)
declCtorIdents decls = flatMap declCtorIdentsOf decls

declCtorIdentsOf : Decl -> List (String, String, Ident)
declCtorIdentsOf (DAttrib _ d) = declCtorIdentsOf d
declCtorIdentsOf (DData { dataName, dataCtors, dataOrigin, ... }) =
  flatMap (v => variantIdentRow dataName dataOrigin v) dataCtors
declCtorIdentsOf (DNewtype { newtypeName, newtypeCtor, newtypeOrigin, ... }) =
  ctorIdentRow newtypeName newtypeOrigin newtypeCtor
declCtorIdentsOf _ = []

variantIdentRow : String -> TyConOrigin -> Variant -> List (String, String, Ident)
variantIdentRow tyName o (Variant cn _) = ctorIdentRow tyName o cn

ctorIdentRow : String -> TyConOrigin -> String -> List (String, String, Ident)
ctorIdentRow tyName o cn = match mkIdent NsCtor o cn
  None => []
  Some i => [(cn, tyName, i)]

-- the constructor rows a module RE-EXPORTS via `export import src.{…}` (`DUse True`),
-- taken from [acc] — the dependency's already-folded row.  A `(..)` member re-exports
-- the named TYPE's constructors, which is why this cannot reuse `importedBindings`
-- (it drops the `(..)` flag) and goes through `memberBindsCtorName` instead.
reexportedCtorIdents : OrdMap (List (String, String, Ident)) -> List Decl -> List (String, String, Ident)
reexportedCtorIdents acc decls = flatMap (reexportedCtorIdentsOf acc) decls

reexportedCtorIdentsOf : OrdMap (List (String, String, Ident)) -> Decl -> List (String, String, Ident)
reexportedCtorIdentsOf acc (DAttrib _ d) = reexportedCtorIdentsOf acc d
reexportedCtorIdentsOf acc (DUse True path _) = match omLookup (usePathModuleId path) acc
  None => []
  Some src => match path
    -- `export import src.*` re-exports every one of src's constructors
    UseWild _ => src
    UseGroup _ ms => flatMap (m => reexportCtorMember m src) ms
    _ => []
reexportedCtorIdentsOf _ _ = []

reexportCtorMember : UseMember -> List (String, String, Ident) -> List (String, String, Ident)
reexportCtorMember m src = filterList (r => rowBoundByMember m r) src

rowBoundByMember : UseMember -> (String, String, Ident) -> Bool
rowBoundByMember m (cn, owner, _) = memberBindsCtorName cn owner m

renameAliasedMethodsIn : List (String, List String) -> (String, List Decl) -> (String, List Decl)
renameAliasedMethodsIn methodsPerMid (mid, prog) = match aliasMethodRenames methodsPerMid prog
  [] => (mid, prog)
  renames =>
    let prog2 = flatMap (deAliasMethodImports methodsPerMid) prog
    (mid, mapProg (renameMethodVar renames) prog2)

-- (b): make each import bind the METHODS it names under their ORIGIN name.
--   `import m.{area as computeArea}` → `import m.{area}`  (the alias is dropped: a method
--                                      is global-by-name, so the rename already points
--                                      every reference at `area`)
--   `import m as A`                  → keep it (its non-method values are still `A.f`)
--                                      and ADD `import m.{…m's methods…}`, which is what
--                                      `A.area` was rewritten to refer to.
deAliasMethodImports : List (String, List String) -> Decl -> List Decl
deAliasMethodImports mm (DAttrib attrs d) =
  map (DAttrib attrs) (deAliasMethodImports mm d)
deAliasMethodImports mm (d@(DUse pub path loc)) = match lookupAssoc (usePathModuleId path) mm
  None => [d]
  Some methods => match path
    UseGroup quals ms =>
      [DUse pub (UseGroup quals (map (deAliasMethodMember methods) ms)) loc]
    UseAlias quals _ => match methodMembersOf methods loc
      [] => [d]
      mems => [d, DUse pub (UseGroup quals mems) loc]
    _ => [d]
deAliasMethodImports _ d = [d]

deAliasMethodMember : List String -> UseMember -> UseMember
deAliasMethodMember methods (m@(UseMember n allCtors loc _))
  | contains n methods = UseMember n allCtors loc None
  | otherwise = m

methodMembersOf : List String -> Loc -> List UseMember
methodMembersOf methods loc = map (n => UseMember n False loc None) methods

renameMethodVar : List (String, String) -> Expr -> Expr
renameMethodVar renames (e@(EVar x)) = match lookupAssoc x renames
  Some origin => EVar origin
  None => e
renameMethodVar renames (e@(EVarId x _)) = match lookupAssoc x renames
  Some origin => EVar origin
  None => e
renameMethodVar _ e = e

-- (localName, originMethodName) for every import in [prog] whose ORIGIN is a method of
-- the module it comes from.  Only an alias yields an entry — an un-aliased import already
-- carries the origin name, which is why this gap stayed invisible for so long.
aliasMethodRenames : List (String, List String) -> List Decl -> List (String, String)
aliasMethodRenames methodsPerMid prog =
  flatMap (aliasMethodRenamesOf methodsPerMid) prog

aliasMethodRenamesOf : List (String, List String) -> Decl -> List (String, String)
aliasMethodRenamesOf mm (DAttrib _ d) = aliasMethodRenamesOf mm d
aliasMethodRenamesOf mm (DUse _ path _) = match lookupAssoc (usePathModuleId path) mm
  None => []
  Some methods => aliasMethodRenamesOfPath methods path
aliasMethodRenamesOf _ _ = []

aliasMethodRenamesOfPath : List String -> UsePath -> List (String, String)
-- `import m as A` → `A.area` is method `area`
aliasMethodRenamesOfPath methods (UseAlias _ a) =
  map (n => (qualifiedLocal a n, n)) methods
-- `import m.{area as computeArea}` → `computeArea` is method `area`
aliasMethodRenamesOfPath methods (UseGroup _ ms) =
  flatMap (memberMethodRename methods) ms
aliasMethodRenamesOfPath _ _ = []

memberMethodRename : List String -> UseMember -> List (String, String)
memberMethodRename methods m = match useMemberAlias m
  Some local =>
    let origin = useMemberOrigin m
    if contains origin methods then [(local, origin)] else []
  None => []

-- every interface/impl method name a decl list declares (interface methods with or
-- without a default, plus impl method names).
declMethodNames : List Decl -> List String
declMethodNames decls = dedup (flatMap declMethodNamesOf decls)

declMethodNamesOf : Decl -> List String
declMethodNamesOf (DAttrib _ d) = declMethodNamesOf d
declMethodNamesOf (DInterface { methods, ... }) = ifaceMethodNames methods
declMethodNamesOf (DImpl { methods, ... }) = map implMethodName methods
declMethodNamesOf _ = []

-- IMPORT ALIASING: the LOCAL names, across every module, under which a CONSTRAINED
-- function is reachable through an alias.  These must join dictNames or the aliased
-- call site is never marked as a dict application (see the call site of this fn).
--
-- [bare] is the un-aliased dictNames; [unitDecls] is (mid, decls) for core + every
-- module, used to ask which fns a given module actually DEFINES — so `import m as A`
-- contributes `A.<n>` only for m's own constrained fns, never for a same-named
-- constrained fn belonging to some other module.
aliasDictNames : List String -> List (String, List Decl) -> List (String, List Decl) -> List String
aliasDictNames bare unitDecls modules =
  flatMap (u => aliasDictNamesOfUnit bare unitDecls (snd u)) modules

aliasDictNamesOfUnit : List String -> List (String, List Decl) -> List Decl -> List String
aliasDictNamesOfUnit bare unitDecls decls =
  flatMap (aliasDictNamesOfDecl bare unitDecls) decls

aliasDictNamesOfDecl : List String -> List (String, List Decl) -> Decl -> List String
aliasDictNamesOfDecl bare unitDecls (DAttrib _ d) =
  aliasDictNamesOfDecl bare unitDecls d
aliasDictNamesOfDecl bare unitDecls (DUse _ path _) =
  aliasDictNamesOfPath bare unitDecls (usePathModuleId path) path
aliasDictNamesOfDecl _ _ _ = []

aliasDictNamesOfPath : List String -> List (String, List Decl) -> String -> UsePath -> List String
aliasDictNamesOfPath bare unitDecls mid (UseAlias _ a) = match lookupAssoc mid unitDecls
  Some ds =>
    map (qualifiedLocal a) (filter (n => contains n bare) (declTopFnNames ds))
  None => []
aliasDictNamesOfPath bare _ _ (UseGroup _ ms) = flatMap (memberDictName bare) ms
aliasDictNamesOfPath _ _ _ _ = []

memberDictName : List String -> UseMember -> List String
memberDictName bare m = match useMemberAlias m
  Some local => if contains (useMemberOrigin m) bare then [local] else []
  None => []

-- B-2.2-f (#1113): payload generalized `List a` -> `a` along with `aliasEntriesFor`
-- above (a bare `a` there cannot flow into a `List a` parameter here).  Every existing
-- caller — including `schemeOblEntriesFor`'s — instantiates `a := List X` unchanged.
moduleAliasEntry : String -> String -> ((String, String), a) -> List (String, a)
moduleAliasEntry mid a ((defMid, n), ids)
  | defMid == mid = [(qualifiedLocal a n, ids)]
  | otherwise = []

memberAliasEntry : String -> List ((String, String), a) -> UseMember -> List (String, a)
memberAliasEntry mid qual m = match useMemberAlias m
  None => []
  Some local =>
    let origin = useMemberOrigin m
    map
      (e => (local, snd e))
      (filter (e => fst (fst e) == mid && snd (fst e) == origin) qual)

-- build THIS module's import-scoped seed: walk its DUse decls, and for each one
-- pick the imported names out of the named dependency's public schemes (held in
-- depEnv, keyed by the dotted module id that usePathModuleId yields == the loader's
-- mid).  `core` DUse decls are skipped — core is always seeded via baseSeed.
importSeed : List Decl -> List (String, List (String, Scheme)) -> List (String, Scheme)
importSeed [] _ = []
importSeed ((DAttrib _ d)::rest) depEnv = importSeed [d] depEnv
  ++ importSeed rest depEnv
importSeed ((DUse _ path _)::rest) depEnv =
  let depId = usePathModuleId path
  match lookupAssoc depId depEnv
    None => importSeed rest depEnv
    Some depSchemes => importFormSchemes depEnv path depSchemes
      ++ importSeed rest depEnv
importSeed (_::rest) depEnv = importSeed rest depEnv

-- WS-2/D2: THIS module's imported value name → import-source module id, from its DUse
-- decls.  Mirrors importSeed's walk but records (localName, depId) for EXPLICIT imports
-- only (importedBindings = Some bindings); a wildcard `import mod.*` (None) is skipped —
-- it can't enumerate names here, so those names fall back to the bare arity table at the
-- call site.  `core` is skipped (core fns route via the prelude dict machinery, never the
-- cross-module qual tables).  depId == usePathModuleId == the loader mid == the qual
-- tables' definer key for a DIRECT import; a re-exported fn's depId is the intermediate
-- (≠ definer), so its qual lookup misses and it too falls back to bare (correct).
--
-- Keyed by the LOCAL name, because that is the name the CALL SITE writes: under a member
-- alias (`import m.{a as b}`) the call site says `b`, so `b` is what must map to m.
--
-- A whole-module alias (`import m as A`) contributes nothing, for the same reason a
-- wildcard doesn't: its locals are one-per-export and this walk has no depEnv to
-- enumerate them.  Those call sites take the same documented bare-table fallback as
-- every wildcard import does today.  The dict ARGS themselves are unaffected — they are
-- stamped from the callee's SCHEME, which importSeed binds under the alias local — so
-- this costs only the cross-module arity DISAMBIGUATION, and only when two modules
-- export same-named constrained fns of differing dict arity.
-- ── #674 / #1111 A-2.6: import-scoped constructor overlay ──────────────────
-- The `data`/`newtype` decls (from the surrounding universe `pool`) whose
-- CONSTRUCTORS this module binds by name, read from its own DUse decls.  They
-- OVERLAY the whole-universe ctor tables (the typecheck scheme table, the
-- record-info table AND the exhaust oracle) so a bare ctor / record name resolves
-- to the SPECIFIC module this unit imports it from — instead of the universe's
-- arbitrary load-order winner, the #674 root cause where the check side
-- (last-loaded-wins) and the native mangler (first-import-wins) DISAGREED.
--
-- A `UseGroup` member contributes its owning decl when EITHER
--   (a) it carries the `(..)` flag and names the decl's TYPE (`import m.{T(..)}`) —
--       the original #674 rule; or
--   (b) it NAMES ONE OF THE DECL'S CONSTRUCTORS (`import m.{T, C}` — and, because a
--       record's sole variant carries the type's own name, `import m.{Cfg}` for a
--       `data Cfg = { … }`).  #1111 A-2.6: (b) is the half that drains #1259 (the
--       ctor-scheme env) and #1256 (the record-info table).
--
-- ⚠️ Rule (b) is a CONSTRUCTOR-name test, not a "not a type name" test, and the
-- difference is observable.  A member spelled like a TYPE contributes nothing only when
-- no decl of `mid` happens to have a constructor of that spelling; if one does, the
-- member matches by rule (b) and that SIBLING decl is overlaid.  Measured: `pmod` with
-- `data Wrap = T Int`, `import pmod.{T, pf}`, and a local `data Loc = T String` —
-- pinned as `test/llvm_fixtures_modules/ctor_scope_type_only_sibling_decl/`.
-- (An earlier revision of this note claimed such a member "contributes NOTHING"; it was
-- measured false and the paragraph is rewritten rather than re-pointed.)
--
-- That contribution is harmless BECAUSE of the layering at the registration site
-- (`dataEnv`, `Module` arm): the overlay sits BELOW this module's own `prog0`, so a
-- sibling decl riding along can never clobber a locally-declared constructor.  What it
-- can still do is out-rank a ctor the unit names from a DIFFERENT module in an EARLIER
-- import clause, decided by source order — the residual this note used to claim was
-- prevented outright.  It is the pre-existing `(..)` hazard (#674's remainder) now also
-- reachable via (b), and it is order-dependent on `main` too.
--
-- 🚨 IT IS **#1284**, and that number is the point of this paragraph.  The note used to
-- end "it is tracked, not fixed here" while NOTHING tracked it — #1283 is the RE-EXPORT
-- spelling, #733 item 1a is marked FIXED and item 1c is wildcards only.  A declared-
-- but-unfiled residual is indistinguishable from an unnoticed one.  Pinned self-
-- drainingly by `test/must_fail_fixtures/1284-a26-overlay-sibling-ctor-beats-named-
-- import/`, whose CONTROL is the discriminator that dates it: the NON-sibling case is
-- rejected on `main` and accepted here, so A-2.6 repairs that one and leaves exactly
-- the sibling one.
--
-- 🚨 The pool lookup is IDENTITY-scoped, not bare-name.  The pool is the WHOLE
-- universe, so two modules declaring the same TYPE name (#1256's two `Cfg`s) made the
-- old bare-name first-match a LOAD-ORDER coin flip inside the very overlay that exists
-- to defeat load order.  The pool is appended in LOAD order and searched FIRST-match
-- while the tables it overlays are `omInsert` LAST-write-wins, so the two orders are
-- OPPOSITE: an unscoped lookup picks right only when the wanted module is loaded
-- FIRST, and `test/eval_typed_modules_fixtures/ctor_scope_load_order/` is the measured
-- counterexample (stubbing `declOwnedBy` to `True` regresses it to `7.0`, an answer
-- pristine `main` gets right).  `declOwnedBy` compares the decl's own identity against
-- `OriginModule <this import's module id>`; `usePathModuleId` yields exactly the loader
-- mid that `stampDeclOrigins` stamped with (see `aliasDictNamesOfPath`'s note, which
-- states the same equality for the qual tables).
--
-- ⚠️ PERF (issue #154) — THE REAL BOUND, stated for the WORK and not just the RESULT.
-- The RESULT is bounded by IMPORT COUNT x PER-MODULE PUBLIC DECL COUNT: at most one
-- overlay decl per UseGroup member, and — since `wildOverlayDecls` — the wildcard-named
-- module's whole published row per `UseWild`.  It is still a per-module VIEW (the row is
-- the envelope's own memoized `demPubDecls`, not a copy), never a per-module rebuild of
-- the global universe.  A module importing no constructors AND no wildcard overlays
-- NOTHING and stays byte-identical.  A bare `import mod` (UseName) still contributes no
-- overlay: the bare form binds no ctors at all, so no ctor occurrence in the reader can
-- mean that module's declaration by that import.  A wildcard `import mod.*` DOES
-- contribute, as of `wildOverlayDecls` below — it cannot name its owning type, but it
-- does not need to: every decl the module publishes is in scope by construction, and
-- leaving it to the universe-fallback made import-clause ORDER decide which declaration
-- a ctor occurrence meant, in both the spurious-warning and the lost-warning direction.
--
-- The WORK is NOT import-count bounded, and saying it is has already shipped a
-- regression.  `pool` is the WHOLE accumulated universe and it is SCANNED — so the cost
-- is O(members x |pool|) per module, i.e. O(modules x universe) across a run, the same
-- shape `main` has paid since #674 for its `(..)` members.  What keeps that acceptable
-- is entirely the CONSTANT, and the constant has exactly two load-bearing parts, both
-- enforced downstream and both measured:
--   * ONE traversal per member, not three (see `findOverlayDecl`/`overlayScan`); and
--   * ZERO allocation per visited decl (see `overlayNote` — name tests before the
--     identity mint).
-- Break either and the perf gate's `modules` shape goes superlinear: this comment
-- previously asserted the universe-independence outright, the first cut of A-2.6 broke
-- both parts, and the gate read typecheck TIME r2=3.24 (hard threshold 3.0) with net
-- allocation 306/744/2013 MB against `main`'s 242/491/1010.  A cheaper bound is
-- available if it is ever needed — index `pool` by owning module id, which would make
-- the owned passes O(log n) — but it does not exist today, so do not cite one.
--
-- 🚨 A-3.2b (#1512, absorbing #1319 unit 4): THE POOL IS NO LONGER A MATERIALISED
-- ACCUMULATOR.  It used to be `crossRun.universeDataDecls` — a bare `List Decl`
-- grown by `appendDataUniverse` one module at a time, with NO record of which module
-- contributed what and no key at all beyond list position.  It is now the whole-graph
-- envelope (`DeclEnvs.deModules`, stage K) read at the READER'S OWN ORDINAL through
-- `declEnvRowVisible`, i.e. through `declEnvVisibleTo`'s two conjuncts.  `cur` is
-- `declEnvsOrdOf mid` for the module being checked — a LOADER-derived identity, not a
-- spelling re-derived from import syntax, which is what makes it survive the emit path
-- (see the call site in `checkBodyImpl`).
--
-- ⚠️ THE POPULATION IS NOT BYTE-IDENTICAL TO THE OLD ACCUMULATOR, and the difference
-- is exactly one row: the READER'S OWN module.  The accumulator held only STRICTLY
-- EARLIER modules' public decls (`appendDataUniverse` runs at the END of a module's
-- own pass); `declEnvVisibleTo` admits the reader's own row too, privately, because
-- `entryOrd == cur` short-circuits the publicity conjunct.  That is the ruled
-- predicate and it is deliberately not special-cased away here.  Its reach is
-- bounded: `ownedType`/`ownedCtor` are scoped by `declOwnedBy mid` where `mid` comes
-- from a `DUse` path, and no module imports itself, so an own-module decl can only
-- ever fill the `bareType` fallback — LAST in a FIRST-wins walk, so it can only add a
-- candidate where every earlier row supplied none, never displace one.
-- 🚨 THE RESULT IS PARTITIONED: NAMED (`UseGroup`) ROWS AND WILDCARD (`UseWild`) ROWS
-- ARE TWO SEPARATE HALVES, and which half a consumer must see FIRST depends on that
-- consumer's own tie-break direction.  This is not a style choice; a single flat
-- source-ordered list shipped an S1.
--
-- WHY.  Before `wildOverlayDecls`, only `UseGroup` contributed, and every row was ONE
-- precisely-named decl.  A wildcard row is the module's WHOLE published set, so once
-- `UseWild` was enrolled the flat `flatMap` over the unit's decls in SOURCE ORDER made
-- import-clause order decide same-named-type collisions BETWEEN the two spellings: with
-- `import zzcol.*` written above `import aacol.{Red, Blue}`, a non-exhaustive match over
-- `aacol.Col` was reported as `Missing case: 'Green'` — a constructor of `zzcol.Col`,
-- the wrong type entirely — and the real missing case went unreported, so the program
-- then died at runtime on the case nobody warned about.  Swapping the two clauses fixed
-- it.  Measured on af6e0414 (broken) vs c7c879b7 (correct in BOTH orders).
--
-- THE RULE, and it is the ordinary scoping one: AN EXPLICITLY NAMED MEMBER OUTRANKS A
-- WILDCARD.  "You named this type" beats "you imported everything and it happened to be
-- in there", whichever clause is written first.
--
-- 🚨 THE TWO CONSUMERS TIE-BREAK IN OPPOSITE DIRECTIONS, so they take opposite orders.
-- Enumerated, because a future edit that routes one of them through the other's wrapper
-- silently inverts the rule for that consumer with no diagnostic anywhere:
--   * `registerAllData` (the `dataEnv` overlay) folds the list LEFT and its bare-keyed
--     tables are `omInsert`, i.e. LAST-WRITE-WINS  -> named rows must come LAST
--     -> `importedCtorTypeDeclsLastWins`.
--   * `seedCheckRun` (the exhaustiveness ctor ORACLE) builds `oracleMap` =
--     `omFromPairs (reverseL …)`, i.e. FIRST-WINS   -> named rows must come FIRST
--     -> `importedCtorTypeDeclsFirstWins`.
-- Same rule, both sites; only the list order differs.  The big note at the `dataEnv`
-- call site enumerates the full set of order-observable structures — this pair is the
-- overlay's own contribution to it.
--
-- ⚠️ WHAT THIS DELIBERATELY DOES **NOT** DECIDE: named-vs-named.  Two `UseGroup` clauses
-- each naming a same-spelled type from a different module are still resolved by
-- import-clause order, exactly as before this partition — within each half the walk is
-- the same `flatMap` over `unitDecls` in source order, and neither consumer's tie-break
-- direction moved.  That case is a SEPARATE, PRE-EXISTING defect (it reproduces on
-- c7c879b7, before the wildcard arm existed) and fixing it needs the overlay keyed by
-- RESOLVED DECLARATION IDENTITY rather than by bare type name — #1319/#1185 territory,
-- not an ordering change.  Do not "while you are here" it: an ordering answer for
-- named-vs-named would freeze a guess into the oracle.
--
-- ⚠️ PERF: the unit's decl list is walked TWICE (once per half) instead of once, but the
-- POOL — the expensive part, see `THE REAL BOUND` above — is scanned exactly as many
-- times as before: each clause yields its rows in whichever half claims it and `[]` in
-- the other, so the total member/wildcard lookups are unchanged.  The extra cost is one
-- linear pass over `unitDecls`, which is import-clause bounded, not universe bounded.
importedCtorTypeDeclsFirstWins : List Decl -> Int -> List DeclEnvModule -> List Decl
importedCtorTypeDeclsFirstWins unitDecls cur rows = overlayHalf False unitDecls cur rows
  ++ overlayHalf True unitDecls cur rows

importedCtorTypeDeclsLastWins : List Decl -> Int -> List DeclEnvModule -> List Decl
importedCtorTypeDeclsLastWins unitDecls cur rows = overlayHalf True unitDecls cur rows
  ++ overlayHalf False unitDecls cur rows

-- One half of the partition, in the unit's own source order.  `wildHalf` selects which:
-- True = `UseWild` rows only, False = `UseGroup` rows only.
overlayHalf : Bool -> List Decl -> Int -> List DeclEnvModule -> List Decl
overlayHalf wildHalf unitDecls cur rows =
  flatMap (importOverlayDecls wildHalf cur rows) unitDecls

importOverlayDecls : Bool -> Int -> List DeclEnvModule -> Decl -> List Decl
importOverlayDecls wildHalf cur rows (DAttrib _ d) =
  importOverlayDecls wildHalf cur rows d
importOverlayDecls wildHalf cur rows (DUse _ (p@(UseGroup _ ms)) _) =
  if wildHalf then
    []
  else
    flatMap (memberOverlayDecl cur rows (usePathModuleId p)) ms
importOverlayDecls wildHalf cur rows (DUse _ (p@(UseWild _)) _) =
  if wildHalf then
    wildOverlayDecls cur rows (usePathModuleId p)
  else
    []
importOverlayDecls _ _ _ _ = []

-- A wildcard import's overlay: EVERY decl the named module publishes, as the reader at
-- ordinal `cur` may see it.  A wildcard names no member, so there is nothing to look up
-- by name — the whole published row IS the answer, and one row is all a module id can
-- have (`deOrdIndex` keys rows by `demId`), hence the stop at the first match.
--
-- 🚨 `declEnvRowVisible`, NEVER `m.demDecls`.  The visible projection is what confines
-- this to `publicDataDecl`s — public `DData`/`DInterface`/`DImpl`/`DTypeAlias` — and
-- `DNewtype`'s ABSENCE from that predicate is deliberate (see `publicDataDecl`): reading
-- `demDecls` here would leak a wildcard-imported module's PRIVATE and NEWTYPE
-- constructors across the module boundary, draining #1311/#1305 in the loud→silent
-- direction, i.e. a severity INCREASE.  A wildcard-imported `newtype`'s ctors are
-- consequently NOT overlaid; that is the ruled behaviour, not an oversight.
--
-- The private branch of `declEnvRowVisible` (`entryOrd == cur`, the reader's own row) is
-- UNREACHABLE from here for the reason the pool note above already gives: `mid` comes
-- from a `DUse` path, and no module imports itself.
--
-- ⚠️ PERF: this returns the row's OWN memoized `demPubDecls` list — no filtered copy is
-- materialised, per `declEnvRowVisible`'s zero-allocation contract.  It does move the
-- RESULT bound: see the `THE REAL BOUND` note above.
wildOverlayDecls : Int -> List DeclEnvModule -> String -> List Decl
wildOverlayDecls _ [] _ = []
wildOverlayDecls cur (m::rest) mid =
  if m.demId == mid then
    declEnvRowVisible cur m
  else
    wildOverlayDecls cur rest mid

-- One member's overlay decl.  The bare-name fallback is kept for the `(..)` spelling
-- ALONE, so no overlay that fired before #1111 A-2.6 is lost where the identity cannot
-- match — a RE-EXPORTED type's decl names the ORIGINAL module, not the re-exporter
-- this import path names.  The (b) spellings are new, so they get no fallback: an
-- unscoped guess there would be the load-order coin flip this unit is removing.
-- (The fallback is not a second pass over `pool` — `overlayScan` collects it in the
-- same walk as the two identity-scoped candidates; see `findOverlayDecl`.)
memberOverlayDecl : Int -> List DeclEnvModule -> String -> UseMember -> List Decl
memberOverlayDecl cur rows mid (UseMember n ctors _ _) = match findOverlayDecl mid n ctors cur rows
  Some d => [d]
  None => []

-- The pool decl DECLARED BY `mid` that this member names.
--
-- 🚨 TWO PASSES, not one first-match, and the order between them is the point.  A
-- module may declare BOTH a type `T` and, in an earlier decl, a constructor spelled
-- `T` (`data Wrap = T Int` above `data T = A | B`).  For `import m.{T(..)}` the member
-- means the TYPE — `(..)` is what makes it a type spelling — so the type-name match
-- must be tried over the WHOLE pool before any constructor-name match is considered.
--
-- ⚠️ A single first-match pass that accepted `variantNamed n vs || ctors && tn == n`
-- shipped and was wrong: `import m.{T(..)}` selected `Wrap` (whose ctor is `T`), so
-- `T`'s own `A`/`B` were never overlaid and a universe collision on `A` won instead —
-- `Type mismatch: T vs Other`.  `declOwnedBy` had removed the CROSS-module first-match
-- hazard; this WITHIN-module one is what `variantNamed` newly made reachable.  Pinned
-- by `test/llvm_fixtures_modules/ctor_scope_ctors_prefer_type_name/`.
--
-- The constructor pass is still the fallback for `(..)`, not dead: `import m.{C(..)}`
-- where `C` is a constructor and not a type name of `m` keeps its pre-A-2.6 meaning.
--
-- 🚨 THE THREE PASSES SHARE ONE TRAVERSAL, and that is a MEASURED PERF CONTRACT.
-- `pool` is the WHOLE accumulated universe and this runs once per UseGroup member of
-- every module, so each independent pass over it is an O(modules x universe) term.
-- The first cut of A-2.6 ran three (type-owned, then ctor-owned, then the bare
-- fallback) where `main` ran ONE, and that alone put the perf gate's `modules` shape
-- at typecheck TIME r2=3.24 — over the hard 3.0 threshold.  `overlayScan` collects all
-- three candidates in a SINGLE walk (their predicates are independent, so first-wins
-- per candidate is unchanged) and stops the instant the DECIDING candidate is found,
-- which is the early exit the three-pass form had.  See `overlayScan`.
findOverlayDecl : String -> String -> Bool -> Int -> List DeclEnvModule -> Option Decl
findOverlayDecl mid n ctors cur rows = match overlayScanRows mid n ctors cur (None, None, None) rows
  (ownedType, ownedCtor, bareType) =>
    if ctors then
      orElseOpt (orElseOpt ownedType ownedCtor) bareType
    else
      ownedCtor

-- ONE walk of the pool, THREE first-wins candidates, in the precedence order
-- `findOverlayDecl` applies:
--
--   ownedType — first decl DECLARED BY `mid` whose TYPE name is `n`   (the `(..)` rule)
--   ownedCtor — first decl DECLARED BY `mid` with a CONSTRUCTOR named `n`  (rule (b))
--   bareType  — first decl of ANY owner whose TYPE name is `n`  (the `(..)` fallback,
--               `dataDeclForType`'s old job: a RE-EXPORTED type's decl names the
--               ORIGINAL module, so no identity-scoped pass can ever match it)
--
-- Each is recorded independently and FIRST-wins, which is exactly what three separate
-- first-match passes computed; a decl can legitimately fill two of them at once (a
-- record's sole variant carries the type's own name), so they are collected with
-- INDEPENDENT tests and never with an `else`.
--
-- ⚠️ THE EARLY EXIT IS `ctors`-DEPENDENT AND MUST STAY THAT WAY.  With `(..)` the
-- deciding candidate is `ownedType` (it outranks both others), so finding it ends the
-- walk; WITHOUT `(..)` only `ownedCtor` is ever read, so exiting on `ownedType` would
-- abandon the walk before the answer was found.  Exiting on "all three filled" is
-- likewise wrong for the second case.
-- A-3.2b (#1512): the OUTER half of the same one-traversal walk, over the envelope's
-- per-module rows in ORDINAL order — which is the identical decl order the old
-- accumulator was appended in (`appendDataUniverse` ran once per module, dependency
-- first), so every FIRST-wins candidate below sees the same sequence it saw before.
--
-- 🚨 THE EARLY EXIT MUST BE CHECKED AT BOTH LEVELS.  `overlayScan` stops mid-row on
-- the deciding candidate; without the identical test here the walk would continue into
-- every LATER row having already decided, which is the O(modules x universe) term this
-- whole neighbourhood is written to avoid.  `declEnvRowVisible` allocates nothing, so
-- a skipped row costs one comparison.
overlayScanRows : String -> String -> Bool -> Int -> (Option Decl, Option Decl, Option Decl) -> List DeclEnvModule -> (Option Decl, Option Decl, Option Decl)
overlayScanRows _ _ _ _ acc [] = acc
overlayScanRows mid n ctors cur acc (m::rest) =
  let acc2 = overlayScan mid n ctors acc (declEnvRowVisible cur m)
  if overlayDecided ctors acc2 then
    acc2
  else
    overlayScanRows mid n ctors cur acc2 rest

overlayScan : String -> String -> Bool -> (Option Decl, Option Decl, Option Decl) -> List Decl -> (Option Decl, Option Decl, Option Decl)
overlayScan _ _ _ acc [] = acc
overlayScan mid n ctors acc (d::rest) =
  let acc2 = overlayScanOne mid n acc d
  if overlayDecided ctors acc2 then acc2 else overlayScan mid n ctors acc2 rest

overlayDecided : Bool -> (Option Decl, Option Decl, Option Decl) -> Bool
overlayDecided ctors (ownedType, ownedCtor, _) =
  if ctors then
    isSome ownedType
  else
    isSome ownedCtor

overlayScanOne : String -> String -> (Option Decl, Option Decl, Option Decl) -> Decl -> (Option Decl, Option Decl, Option Decl)
overlayScanOne mid n acc (DAttrib _ d) = overlayScanOne mid n acc d
overlayScanOne mid n acc (d@(DData { dataName = tn, dataOrigin = o })) =
  overlayNote mid n tn o d acc
overlayScanOne mid n acc (d@(DNewtype { newtypeName = tn, newtypeOrigin = o })) = overlayNote mid n tn o d acc
overlayScanOne _ _ acc _ = acc

-- 🚨 NAME TESTS FIRST, IDENTITY SECOND — a MEASURED perf contract, not style.
-- `tn == n` / `declCtorNamed` are string compares over fields already in hand and
-- ALLOCATE NOTHING; `declOwnedBy` MINTS an identity on both sides (`OriginModule`,
-- `IdentModule`, the `map` closure, the `Ident`, the `Some` — five objects per call).
-- This runs ONCE PER POOL DECL, i.e. over the whole universe per member per module, so
-- minting unconditionally is O(modules x universe) ALLOCATION — `compiler/AGENTS.md`'s
-- named exception ("when the KEY PROJECTION allocates"), and it re-created the #154
-- quadratic that `modules` was promoted out of `KNOWN_SUPERLINEAR` for.  Measured on
-- the gate's own `modules` shape (N=100/200/400, K=8, one worktree, one emitter,
-- interleaved): mint-first 306/744/2013 MB net (r2=2.71) vs name-first 242/491/1010 MB
-- (r2=2.06), which is `main`'s figure to 0.1 MB.  A name test matches at most the
-- handful of pool decls sharing that spelling, so the mint is O(1) per member.
--
-- The unchanged `acc` is returned BY IDENTITY when neither name matches — the common
-- case — so the walk allocates nothing at all until it actually finds something.
overlayNote : String -> String -> String -> TyConOrigin -> Decl -> (Option Decl, Option Decl, Option Decl) -> (Option Decl, Option Decl, Option Decl)
overlayNote mid n tn o d acc = match acc
  (ownedType, ownedCtor, bareType) =>
    let hitType = tn == n
    let hitCtor = declCtorNamed n d
    if hitType || hitCtor then
      let owned = declOwnedBy mid tn o
      (
        if hitType && owned then orElseOpt ownedType (Some d) else ownedType,
        if hitCtor && owned then orElseOpt ownedCtor (Some d) else ownedCtor,
        if hitType then orElseOpt bareType (Some d) else bareType,
      )
    else acc

declCtorNamed : String -> Decl -> Bool
declCtorNamed n (DData { dataCtors = vs }) = variantNamed n vs
declCtorNamed n (DNewtype { newtypeCtor = cn }) = cn == n
declCtorNamed _ _ = False

variantNamed : String -> List Variant -> Bool
variantNamed _ [] = False
variantNamed n ((Variant cn _)::rest) = cn == n || variantNamed n rest

-- Does this decl's DECLARATION identity name module `mid`?  Both sides go through
-- `mkIdent`, so an ABSENT identity matches NOTHING — not even another absence.  That
-- polarity is deliberate and is A-2.3's, not A-2.10's: this answers a LOOKUP, where a
-- miss is recoverable (the universe fallback stands, i.e. today's behaviour) and a
-- false hit would silently overlay the wrong module's constructors.  It is why `mid`
-- being `""` (the I6.3 "origin not recorded" sentinel, which `identOriginOf` refuses)
-- cannot pair with an `OriginUnresolved` decl.
declOwnedBy : String -> String -> TyConOrigin -> Bool
declOwnedBy mid tyName o = match mkIdent NsType (OriginModule mid) tyName
  Some want => mkIdent NsType o tyName == Some want
  None => False

-- ── the local-spelling → DEFINER map, for EVERY import form ─────────────────────
-- This is the ONE representation the dict-arity identity seam resolves through:
-- `qualConstraintKey` turns a name into a `(definer, origin)` key with it, and
-- `hasImportDefiner` reads the same rows to decide that a qual MISS means "genuinely
-- unconstrained in its source module" rather than "look in the source-blind bare
-- table".  Every reader of that decision — `declaredConstraintFor`,
-- `declaredConstraintIds`, the pinned-var guard — takes its answer from here, and
-- none of them knows which import FORM produced a row.  So the forms are normalized
-- here, once, and a form whose rows are missing is not a gap in one arm: it is a
-- silent fall-through to bare-name first-match for that whole spelling.
--
-- 🚨 `import m.*` USED TO CONTRIBUTE NOTHING, and that hole is #1425's F1.
-- `importedBindings` answers `None` for `UseWild` because a wildcard's member list
-- cannot be read off the `DUse` decl alone — it is every public top-level binding the
-- DEPENDENCY declares — so this walk simply skipped it and every wildcard-imported
-- name fell to the bare table.  While the bare table happened to be wrong on BOTH
-- sides of a same-name collision (a foreign constrained row sized the define AND the
-- call), the two errors cancelled and the spelling looked correct.  `selfDeclArities`
-- then repaired the DEFINE side by identity; the call side, still on the bare table,
-- began applying a dict its callee no longer abstracts —
-- `E-NOT-A-FUNCTION: applied non-function: <dict:>` on nine ordinary 3-line stdlib
-- programs, in BOTH import orders, behind a `check` that exits 0.  The defect did not
-- move because the repair was wrong; it moved because the repair was applied at one
-- arm of a seam whose other arm had no rows at all.
--
-- The graph is what supplies the missing member list, and it is already built and
-- already keyed by module id: `declEnvsRef.deModules`.  On the Flat/loader-less paths
-- that envelope is EMPTY, so the wildcard rows are empty and this is byte-identically
-- today's behaviour — the same fail-closed-on-absent-identity discipline
-- `selfDeclArities` takes for `mid == ""`.
--
-- ORDER AND SHADOWING.  Named-form rows come FIRST (every reader is first-match), and a
-- wildcard row is dropped when the name is already spoken for — by a named import of
-- this module, or by this module's OWN top-level declaration, which shadows the
-- wildcard binding and whose arity `selfDeclArities` answers from its own qual row.
--
-- 🚨 THE SUPPLY SIDE DOES NOT ENUMERATE (RUN-XMOD-062).  It used to, twice over — one
-- walk for the named forms, one for the wildcard form, each deciding for itself what a
-- dependency "makes available".  Both walks answered that with the names a dependency
-- DECLARES, so a name it RE-EXPORTS (`export import u.{pick}` / `export import u.*`,
-- at any depth) got no row and fell to the source-blind bare table — the same
-- `E-NOT-A-FUNCTION: applied non-function: <dict:>` on a well-typed program, one hop
-- further out.  That was the THIRD enumeration in this seam to miss a member.  The rows
-- are now DERIVED: `graphPubDefiners` answers "what does module m export, and who
-- DEFINED each of those names" (declared publics, plus re-exports resolved through the
-- same predicate, transitively), and `importFormRows` — the one admission predicate,
-- shared with `importFormSchemes` — answers "which of those does this import form
-- admit, under which local key".  A form or a re-export shape this seam has never seen
-- is covered by construction, not by a case.
--
-- Also, the payload is now a PAIR: `(definer module, origin name at the definer)`,
-- because an IMPORTER can rename a re-exported member (`import r1.{pick as pk}` — an
-- ordinary import with an as-alias on a name that happens to be re-exported).  A
-- RE-EXPORT hop itself cannot rename: `export import u.{pick as pk}` is a hard parse
-- error (`parser.mdk:2379`), so that is not the motivating shape.  The qual tables are
-- keyed `(definer, ORIGINAL exported name)`, so carrying only the definer would key them
-- with the local spelling, MISS, and — via `hasImportDefiner` — read that miss as
-- "genuinely unconstrained", silently dropping the callee's dict.  Both halves of the
-- key come out of one derivation; they cannot disagree.
importDefinersOf : List Decl -> List (String, (String, String))
importDefinersOf prog =
  let named = useAdmittedRows False prog
  let taken = namesToSet (map fst named ++ declTopFnNames prog) omEmpty
  named
    ++ filterList (e => not (omHasKey (fst e) taken)) (useAdmittedRows True prog)

-- one precedence TIER of the walk above — [wild] selects the wildcard-form rows or the
-- named-form rows.  This is a precedence split, not a re-enumeration of the forms:
-- WHICH names a form admits is `importFormRows`' answer in both tiers.
useAdmittedRows : Bool -> List Decl -> List (String, (String, String))
useAdmittedRows _ [] = []
useAdmittedRows wild ((DAttrib _ d)::rest) = useAdmittedRows wild [d]
  ++ useAdmittedRows wild rest
useAdmittedRows wild ((DUse _ path _)::rest) = useDefinerRows wild path
  ++ useAdmittedRows wild rest
useAdmittedRows wild (_::rest) = useAdmittedRows wild rest

-- `core` is skipped: the implicit prelude is never an explicit provenance (every reader
-- of these rows relies on that — see `declaredConstraintFor`).
useDefinerRows : Bool -> UsePath -> List (String, (String, String))
useDefinerRows wild path =
  let depId = usePathModuleId path
  if depId == "core" then []
  else match importedBindings path
    None => if wild then graphPubDefiners depId else []
    Some bindings =>
      if wild then
        []
      else
        flatMap (memberDefinerRow depId (graphPubDefiners depId)) bindings

-- resolve ONE named member against the dependency's export table.  The fallback is the
-- load-bearing part: on the Flat / loader-less drivers `deModules` is EMPTY, so the
-- table is silent about every dependency, and a named import must keep contributing its
-- row (attributed to the SPELLED module, which is what it contributed before this
-- derivation existed) rather than vanish.  The wildcard form has no such fallback — it
-- cannot enumerate without the graph — which is the same fail-closed-on-absent-identity
-- discipline `selfDeclArities` takes for `mid == ""`.
memberDefinerRow : String -> List (String, (String, String)) -> (String, String) -> List (String, (String, String))
memberDefinerRow depId pubs (origin, local) = match resolveMemberRows (origin, local) pubs
  [] => [(local, (depId, origin))]
  rows => rows

-- what module [mid] EXPORTS as values, each mapped to the module that DEFINED it and
-- the name it is defined under — read off the graph envelope `buildDeclEnvs` already
-- built for this driver.  Empty when the envelope is (Flat / loader-less drivers).
--
-- Re-exports resolve through `importFormRows`, so `export import u.{p}`,
-- `export import u.*` and a chain of either resolve identically and transitively, and
-- an aliased re-export keeps the ORIGIN half of the payload pointing at the definer's
-- own name.  Declared names come first: a module that both declares and re-exports a
-- name answers with its own binding, matching first-match resolution elsewhere.
--
-- 🚨 RUN-XMOD-066: THIS IS A TABLE LOOKUP, NOT A WALK, AND THAT IS LOAD-BEARING FOR CI.
-- The first cut recursed per call: `flatMap` over every row of `deModules` to find [mid],
-- then a fresh recursive walk per `export import`.  Nothing shares a subresult, so a
-- re-export CHAIN costs O(depth * modules) per importer and a branching re-export DAG
-- costs Fibonacci-many walks (round-3 breaker, F4).  A fuel bound of 64 capped the depth
-- and not the work: `test/diff_compiler_perf_scaling.sh`'s `modules` shape — 400 modules
-- in one `export import` chain — went from 1.69 s to 2.49 s of typecheck at N=400, with
-- the ADDED term growing 3.2x per doubling of N against ~2x for everything else, and CI's
-- `gates (types)` failed it twice deterministically as SUPERLINEAR (TIME).  A comment
-- landed here calling that cost "acceptable" (RUN-XMOD-064); it was measurably wrong and
-- is retracted.
--
-- The whole answer is now derived ONCE per graph, in `declEnvDefinerIndex`, and lives on
-- the envelope as `deDefiners` — a real `OrdMap` keyed by module id, O(log modules) to
-- read, NOT a `List` scanned per lookup (this tree's thirteen quadratics are all "a List
-- used as a set or a map"; a memo that reintroduced the scan would be the fourteenth).
--
-- KEY SCOPING.  The key is the loader's module id — the SAME `demId` `deOrdIndex` is
-- keyed by and the same one `usePathModuleId` produces at every reader.  Two positions in
-- the module graph cannot collide on it, because a module id names a `deModules` row and
-- `declEnvModulesFrom` builds exactly one row per loader module; and it cannot collide
-- ACROSS graphs, because the table is a field of the envelope rather than a program-global
-- ref — see `declEnvDefinerIndex` for why that is the point.
--
-- Empty when the envelope is (Flat / loader-less drivers), exactly as before: a miss
-- answers `[]`, which is the fail-closed-on-absent-identity discipline the whole seam
-- takes (`selfDeclArities` for `mid == ""`).
graphPubDefiners : String -> List (String, (String, String))
graphPubDefiners mid =
  definersIn driverState.value.declEnvsRef.value.deDefiners mid

definersIn : OrdMap (List (String, (String, String))) -> String -> List (String, (String, String))
definersIn tbl mid = match omLookup mid tbl
  None => []
  Some rows => rows

-- ── the per-graph derivation of `deDefiners`, built once by `buildDeclEnvs` ────────────
--
-- 🚨 NO RESET POINT IS NEEDED, AND THAT IS DELIBERATE (RUN-XMOD-066 (iii)).  The obvious
-- shape for a memo here is a `driverState` ref filled lazily — and `driverState` has no
-- reset point at all, which is precisely what makes `mangledShadowMapRef` an anti-pattern
-- (RUN-XMOD-040): it is written once, on the emit path, and nothing invalidates it when
-- the thing it was derived FROM is replaced, so a second graph in one process reads the
-- first graph's answers.  This table is instead a FIELD of the value it is a function of.
-- `deDefiners` is derived from `mods` and from nothing else, in the same constructor, so
-- it cannot outlive its input: every write of `declEnvsRef` (both Module-mode driver
-- entries write it unconditionally — see `checkModulesPreamble` and `elaborateModules`)
-- replaces the whole envelope, table included, and a driver that never calls
-- `buildDeclEnvs` reads `emptyDeclEnvs`' empty one.  There is no state to forget to clear.
--
-- ONE FORWARD FOLD, dependency-first.  [acc] holds the finished rows of every module of a
-- LOWER ordinal, and a re-export target is a DEPENDENCY, so it is always already in [acc]
-- — `deModules` is the loader's dependency-first order (see `DeclEnvModule.demOrd`), the
-- same premise `deKindsBefore`/`deOwnersBefore`/`declEnvSeedChain` are built on.  So the
-- transitive answer falls out of a single linear pass with no recursion, and therefore no
-- fuel: `importDefinerFuel = 64` existed only to keep termination from resting on the
-- loader's cycle rejection, and a fold over a finite list terminates outright.  (Its side
-- effect — silently truncating a re-export chain deeper than 64 to a partial row set, i.e.
-- a dropped dict on a well-typed program — goes with it.)
--
-- UNGATED: nothing in this fold checks that [deModules] really is dependency-first — it's
-- enforced upstream by the loader's topo-sort, not verified locally. A violation fails
-- CLOSED: the not-yet-inserted dependency's `omLookup` misses, yielding a partial/missing
-- row, never a crash or a wrong-but-plausible answer.
declEnvDefinerIndex : OrdMap (List (String, (String, String))) -> List DeclEnvModule -> OrdMap (List (String, (String, String)))
declEnvDefinerIndex acc [] = acc
declEnvDefinerIndex acc (m::rest) =
  declEnvDefinerIndex
    (omInsert
      m.demId
      (firstRowPerName omEmpty (modulePubDefiners acc m.demId m.demDecls))
      acc)
    rest

-- keep the FIRST row per local spelling and drop the rest.  This is not a shortcut, it is
-- what every reader of these rows already does: `resolveMemberRows` takes `lookupAssoc`'s
-- first hit, `importDefinersOf` drops a wildcard row whose name is already spoken for, and
-- the three refs the rows land in are read first-match.  So collapsing here is
-- observationally identical AND it is what keeps the TABLE from being exponential: a
-- wildcard re-export takes its dependency's rows WHOLESALE (`importFormRows`' `None` arm),
-- so a module re-exporting two predecessors carries |rows(k-1)| + |rows(k-2)| — Fibonacci
-- in chain depth — even though the DISTINCT names are only ever the handful the graph
-- actually declares.  Measured on the round-3 breaker's own branching corpus (F4, K=26,
-- `check`, min of 3 interleaved rounds): 8.23 s without this line, 6.56 s with it, against
-- a 6.49 s base.
firstRowPerName : OrdMap Unit -> List (String, (String, String)) -> List (String, (String, String))
firstRowPerName _ [] = []
firstRowPerName seen ((k, v)::rest) =
  if omHasKey k seen then
    firstRowPerName seen rest
  else
    (k, v) :: firstRowPerName (omInsert k () seen) rest

modulePubDefiners : OrdMap (List (String, (String, String))) -> String -> List Decl -> List (String, (String, String))
modulePubDefiners before mid decls = map (n => (n, (mid, n))) (pubTopFnNames decls)
  ++ reexportDefiners before decls

-- the rows a module's `export import` decls (`DUse True` — the same filter resolve's
-- `pubUsePaths` and `reexportSeed` use) add to its own export table.  A plain `import`
-- is not re-exported and contributes nothing downstream.
reexportDefiners : OrdMap (List (String, (String, String))) -> List Decl -> List (String, (String, String))
reexportDefiners _ [] = []
reexportDefiners before ((DAttrib _ d)::rest) = reexportDefiners before [d]
  ++ reexportDefiners before rest
reexportDefiners before ((DUse True path _)::rest) =
  let depId = usePathModuleId path
  if depId == "core" then
    reexportDefiners before rest
  else
    importFormRows path (definersIn before depId) ++ reexportDefiners before rest
reexportDefiners before (_::rest) = reexportDefiners before rest

-- `declTopFnNames` restricted to the EXPORTED bindings — what a wildcard import can
-- actually bind.  A private binding must not enter the definer map: it is unreachable
-- from the importer, and a row for it could shadow a genuine wildcard row of the same
-- name from a second dependency.
--
-- ⚠️ The export test is `publicValNames`, the module's own canonical one — NOT a
-- hand-rolled `DFunDef True` scan, for the reason `attributeModuleSchemeObls` records
-- and this function's first cut re-learned the expensive way: `export pick : a -> a`
-- on one line with `pick x = x` on the next parses as a PUBLIC `DTypeSig` plus a
-- PRIVATE `DFunDef`, so a `DFunDef`-flag scan calls the common spelling private,
-- returns NO names, and the whole wildcard row-set is silently empty — which reads
-- exactly like "the fix had no effect".  Measured on this binary: with the flag scan
-- the F1 repro was byte-identically unfixed.
--
-- Intersected with `declTopFnNames` so the map carries only what this seam answers for
-- — top-level FN definitions.  `publicValNames` also yields public interface METHOD
-- names (global-by-name, owned by the method-side tables) and public EXTERNs (dict
-- arity 0 by construction); neither belongs in a fn-side definer map, and excluding
-- them fails OPEN to the bare path rather than to a dropped dict.
pubTopFnNames : List Decl -> List String
pubTopFnNames decls =
  let fns = namesToSet (declTopFnNames decls) omEmpty
  filterList (n => omHasKey n fns) (publicValNames decls)

-- #739 fix follow-up: local-import-name → ORIGINAL exported name.  `importedBindings`
-- yields (origin, local) pairs, so an aliased member `{x as y}` gives (y ↦ x) and a plain
-- `{f}` gives (f ↦ f).  qualConstraintFor keys the (source, name) qual tables by the ORIGIN,
-- not the surface alias — the tables are attributed under the DEFINING name — so a constrained
-- aliased import (`hash_map.{set as hmSet}`) resolves its `Hash`/`Eq` dict instead of being
-- misclassified as unconstrained and short-circuited (which DROPPED the dict → dispatch panic).
--
-- RUN-XMOD-062: this is now a PROJECTION of `importDefinersOf`'s rows rather than its own
-- `DUse` walk.  Two walks over the import forms could disagree about which rows exist —
-- and a `(definer, origin)` key assembled from two disagreeing walks is exactly the
-- silent misroute this seam pays for.  `definerRowsOf` is its sibling projection; both
-- take the SAME rows, computed once at the single write site.
originRowsOf : List (String, (String, String)) -> List (String, String)
originRowsOf rows = map (e => (fst e, snd (snd e))) rows

definerRowsOf : List (String, (String, String)) -> List (String, String)
definerRowsOf rows = map (e => (fst e, fst (snd e))) rows

-- the (key, scheme) pairs a module RE-EXPORTS via `export import` (`DUse True`).
-- Mirrors resolve's re-export set (resolve.pubUsePaths filters the same `DUse True`)
-- into the typecheck seed: walk the export-flagged DUse decls and, for each, pick the
-- re-exported member names out of the SOURCE dependency's public schemes already in
-- depEnv — the exact member resolution importSeed uses (importFormSchemes /
-- resolveMemberRows), so it works on both golden and mangled emit paths.  Schemes
-- come from depEnv by IDENTITY (the definer's original schemes, never re-generalized),
-- which preserves the original-definer constraint ids (D2 diamond-safety).  ONLY
-- `DUse True` is threaded, so a plain `import` never leaks the importer's names
-- downstream.  Transitivity is automatic: pubV accumulates these and is carried
-- forward as depEnv, so a second `export import` hop re-resolves against the enriched
-- pubV.  Methods need no special case — the source module's pubV already holds the
-- method scheme (publicValNames includes DInterface method names).
--
-- `core` is the one source that is NOT in depEnv: it is the implicit prelude, so its
-- schemes go into `baseSeed`, not into the per-module dep chain.  It is therefore
-- passed separately as `coreV` — without it, `lookupAssoc "core" depEnv` missed and
-- `export import core.{filter}` re-exported nothing (in silence, and forever).
-- `coreV` is consulted ONLY here, on `DUse True`: `importSeed` keeps taking the plain
-- depEnv, so a plain `import core.{…}` still seeds nothing (its names are already in
-- baseSeed — seeding them twice would only add duplicate assoc entries).
reexportSeed : List (String, Scheme) -> List Decl -> List (String, List (String, Scheme)) -> List (String, Scheme)
reexportSeed _ [] _ = []
reexportSeed coreV ((DAttrib _ d)::rest) depEnv = reexportSeed coreV [d] depEnv
  ++ reexportSeed coreV rest depEnv
reexportSeed coreV ((DUse True path _)::rest) depEnv =
  let depId = usePathModuleId path
  let src = if depId == "core" then Some coreV else lookupAssoc depId depEnv
  match src
    None => reexportSeed coreV rest depEnv
    Some depSchemes => importFormSchemes depEnv path depSchemes
      ++ reexportSeed coreV rest depEnv
reexportSeed coreV (_::rest) depEnv = reexportSeed coreV rest depEnv

-- ── UNIFIED per-module fold (#151) ─────────────────────────────────────────
-- The single home for the identical per-module skeleton the four module drivers
-- (checkModules / checkModulesDiags / checkModulesEntryFull / elaborateModules)
-- share, so the next import-scoped-seed-style fix touches ONE place instead of
-- four (the miss would otherwise be path-specific — LSP-only or emit-only).  It
-- owns: the IMPORT-SCOPED seed (`baseSeed ++ importSeed prog depEnv` — a flat
-- union let `string.reverse` shadow the `list.reverse` a module imports), the
-- per-module PUBLIC accumulator (`pubV = pickSchemes (publicValNames prog) schemes
-- ++ reexportSeed coreV prog depEnv`), and the DEPENDENCY-FIRST threading of
-- depEnv (PREPEND `(mid,pubV)::depEnv`, so importSeed's first-match picks the
-- nearest dependency), accData (`++ publicDataDecls prog`) and accAll (`++ prog`,
-- the cumulative impl-body universe).  Each driver supplies:
--   * worker  : mid seed accData accAll prog -> (schemes, extra) — runs the
--               per-module pass; MUST surface `schemes` (pubV needs it for the
--               next depEnv) plus its driver-specific payload `extra`.
--   * collect : isLast mid extra restResult -> result — a foldr combiner, where
--               restResult is the fold over the REMAINING modules (`base` for []).
--               `isLast` is True only for the terminal (entry) module — the one
--               place checkModulesEntryFull keeps the module's OWN schemes/warns
--               rather than the recursion's.
-- foldModules owns ONLY the loop and performs NO resetCrossModuleState: the reset
-- boundary stays in each driver's preamble (a reset leaking in here would hand the
-- `check*` drivers a reset they must not have).
-- #154 PR-C: `wantData`/`wantAll` are per-worker "needs" signals gating the two
-- accumulator concats.  The old unconditional `accData ++ publicDataDecls prog` /
-- `accAll ++ prog` copied a GROWING left operand every iteration → O(modules^2)
-- allocation across the graph (the residual PR-A left).  Each worker declares which
-- accumulator it actually reads, and the OTHER is threaded UNCHANGED (`else accData`
-- — no copy), so a path that consumes neither (the perf-gate `checkModules` path,
-- where `checkBodyImpl` binds `accData` as `Module _ _ _` and never reads it, and
-- `accAll` is `cmCheckWorker`'s ignored `_accAll`) does O(|prog|) per module = O(N)
-- total.  Byte-identity: when `wantX` is False the worker provably ignores that
-- accumulator, so the value threaded is unobserved; when True the concat is IDENTICAL
-- to the old append (same operand order), so the elab/diag witnesses are unchanged.
foldModules : Bool -> Bool -> (String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), e)) -> (Bool -> String -> e -> acc -> acc) -> acc -> List (String, Scheme) -> List (String, Scheme) -> List (String, List (String, Scheme)) -> List Decl -> List Decl -> List (String, List Decl) -> acc
foldModules _ _ _ _ base _ _ _ _ _ [] = base
foldModules _wantData _wantAll worker collect base baseSeed _coreV depEnv accData accAll [(mid, prog)] =
  let seed = baseSeed ++ importSeed prog depEnv
  let (_, extra) = worker mid seed accData accAll prog
  collect True mid extra base
foldModules wantData wantAll worker collect base baseSeed coreV depEnv accData accAll ((mid, prog)::rest) =
  let seed = baseSeed ++ importSeed prog depEnv
  let (schemes, extra) = worker mid seed accData accAll prog
  let pubV = pickSchemes (publicValNames prog) schemes ++ reexportSeed coreV prog depEnv
  collect
    False
    mid
    extra
    (foldModules
      wantData
      wantAll
      worker
      collect
      base
      baseSeed
      coreV
      ((mid, pubV)::depEnv)
      (if wantData then accData ++ publicDataDecls prog else accData)
      (if wantAll then accAll ++ prog else accAll)
      rest)

-- Shared preamble of the three `check*` module drivers (the "three verbatim entry
-- wrappers" of #151): reset the cross-module accumulators, register abstract
-- record types, and seed runtime + core schemes.  Returns (runtimeSeed,
-- coreSchemes) for the caller to thread into foldModules.  elaborateModules does
-- NOT use this — its preamble additionally marks/prePasses the graph and stamps
-- core via elabModuleStamp.
--
-- ⚠️ #1110: each of the three callers acquires type-constructor identity FIRST
-- (`stampGraphTyOrigins`, the resolve→typecheck channel) and hands this preamble
-- the ALREADY-STAMPED prelude and modules.  It is not done here, where one line
-- would serve all three, for a specific reason: this function's inferred type is
-- pinned by the selfproc LEG A golden, and widening its result to carry the
-- stamped decls back out is the one change that would make that golden's move
-- non-additive.  A fourth driver must therefore remember to stamp — hence the
-- identical, greppable `#1110` line at the head of each caller below.
checkModulesPreamble : List Decl -> List Decl -> List (String, List Decl) -> (List (String, Scheme), List (String, Scheme))
checkModulesPreamble runtimeDecls coreDecls modules =
  let _ = resetCrossModuleState ()
  -- #1111 A-2.5b: derive the graph's method-identity index over the whole
  -- (already-stamped) graph, before any module — including the core pass below — reads
  -- it.  `elaborateModules` carries the identical line.
  --
  -- ⚠️ NOT "built once per compile": F1 falsified that phrasing.  It is derived once PER
  -- DRIVER ENTRY, and a driver may legitimately run twice over one graph.  What matters is
  -- not how many times it is written but that it is LIVE at every entry into the `Module`
  -- arm — see `graphMethodExports`, which states the two-part property that carries it.
  --
  -- THIS LINE IS ONE HALF OF THAT PROPERTY.  `freshDriverState` initialises the field to
  -- `omEmpty`, so a driver that does not write it reads an empty index and every candidate
  -- misses — which IS F1's symptom.  The writer set is therefore a NECESSARY conjunct, not
  -- "the wrong question": the two Module-mode driver entries that must carry this line are
  -- `checkModulesPreamble` (here) and `elaborateModules`.
  driverState.value.graphMethodExportsRef := (graphMethodExports coreDecls modules)
  -- #1354 unit A follow-up: the TYPE-namespace peer, written in LOCKSTEP with the line
  -- above.  Same graph, same two entries, same safety conjunction — see graphIfaceMethods.
  driverState.value.graphIfaceMethodsRef := (graphIfaceMethods coreDecls modules)
  -- #1111 A-2.11 (#1319 unit 1): the CONSTRUCTOR peer of the line above, under the
  -- identical two-part property.  Both driver entries carry both lines or neither works.
  driverState.value.graphCtorExportsRef := (graphCtorExports coreDecls modules)
  -- L3 (xmod-identity #1351 spine): the graph-level mangled-funDefs fact, under the
  -- SAME two-part safety property as the three lines above (F3: unconditional
  -- whole-value overwrite at BOTH Module-mode driver entries + no reset point in
  -- between is what keeps compile N's flag from leaking into compile N+1 — see
  -- `graphMethodExports`).  `elaborateModules` carries the identical derivation,
  -- from the identical `("core", coreDecls)::modules` unit list.
  driverState.value.mangledFunDefsPresentRef := (graphCarriesMangledFunDefs (("core", coreDecls)::modules))
  -- #1112 A-3.1: the whole-graph declaration envelope, under the SAME two-part
  -- property as the three lines above (`driverState` has no reset point, and both
  -- Module-mode driver entries write it unconditionally).  `elaborateModules`
  -- carries the identical line.  See `buildDeclEnvs`.
  let declEnvs = buildDeclEnvs coreDecls modules
  driverState.value.declEnvsRef := declEnvs
  -- #80/#201: populate effect domains ONCE over the WHOLE import graph (builtins +
  -- every `effect …` decl in core or any module), BEFORE the per-module foldModules
  -- loop, so a module using an effect declared in ANOTHER module sees its domain.
  -- resetState no longer re-seeds, so this survives every per-module reset below.
  -- Must precede the core checkModuleFull (it runs checkEffectParams, reading these).
  -- #1112 A-3.1: `deAllDecls` IS `coreDecls ++ flatMap snd modules` (see
  -- `declEnvDeclsOf`) — the same list value, now derived from the envelope so a
  -- module the envelope drops is loud here rather than silent.
  let _ = populateEffectDomains declEnvs.deAllDecls
  -- #1280: `coreDecls` arrives here ALREADY STAMPED (each caller's
  -- `stampGraphTyOrigins` line above), but the scope is derived from its type
  -- NAMES, not its origins, so it is the same map either way.
  let runtimeSeed = externSchemes (externTyOriginScope coreDecls) runtimeDecls
  let _ = seedAbstractRecordTypes coreDecls modules
  let coreSchemes = checkModuleFull runtimeSeed [] coreDecls
  -- #673: snapshot core's OWN obligations NOW — perRun.schemeObligationsRef still holds core's
  -- bindings (the next module's resetState has not run yet).  This is the source-exact store a
  -- plain-EVar use of a PRELUDE constrained fn (`println`) reads in instantiateVarTracked, so
  -- its Display obligation lands on the located check path instead of being dropped.
  -- #837: coreSchemeObligationsRef is NAME-keyed (declaredCrossModuleObls reads it by
  -- bare cross-module name); drop the binding-id component of each (name, id) key.
  crossRun.value.coreSchemeObligationsRef := (omFromPairs (map (kv => (fst (fst kv), snd kv)) perRun.value.schemeObligationsRef.value) omEmpty)
  (runtimeSeed, coreSchemes)

-- worker: plain per-module typecheck (no diagnostics harvest, no accAll).  Surfaces
-- `schemes` twice — once as the pubV source foldModules needs, once as the payload
-- checkModules collects.
--
-- #1508 (U2a): this worker used to call `checkModuleFull`, i.e. `checkModuleFullImpl ""`,
-- DISCARDING the module id `foldModules` hands it — so on the `checkModules` driver every
-- USER module reached `checkBodyImpl`'s Module arm claiming to be the prelude (`""`,
-- `declEnvsOrdOf` ordinal 0).  Its two sibling workers (`cmDiagsWorker`, `cmEntryWorker`)
-- always passed the real `mid` through `checkModuleFullDiags`; this one was the outlier.
-- It calls `checkModuleFullImpl` directly rather than `checkModuleFull` so the id can be
-- threaded — everything else (`accData`, the `[]` implDecls that keep the #154 PR-C perf
-- property) is byte-identically what `checkModuleFull` passed.
--
-- 🚨 THIS IS NOT ATTRIBUTION-ONLY, AND THE FIRST DRAFT OF THIS COMMENT SAID IT WAS.
-- The `""` key made `crossModuleSchemeOblsQualRef` and its three sibling qual tables
-- unreadable on this driver — their readers derive `src` from a real import path
-- (`usePathModuleId`), so they missed universally — which means an INFERRED
-- cross-module obligation was SILENTLY DROPPED from the importer's scheme.  MEASURED,
-- two arms, same fixture and `MEDAKA_ROOT`, only the probe differing:
--
--   p.mdk      export f x = "\{x}!"        -- Display a, INFERRED (no signature)
--   entry.mdk  import p.{f} / g v = f v
--
--   before:  g : a -> String              ← the `Display a =>` context is GONE
--   after:   g : Display a => a -> String  (and `medaka check`, an untouched driver
--                                           routing through `analyzeProject`, agrees)
--
-- That reached users through `projectEntrySchemes` — LSP project hover reported the
-- unconstrained type.  Pinned at
-- `test/check_module_fixtures/inferred_cross_module_obligation/`, whose header records
-- why the other eight fixtures were blind to the shape (all signatured or
-- interface-method-typed, so their contexts are DECLARED and ride the module seed).
-- An under-claimed fix is one nobody writes a test for, which is exactly what happened
-- between this comment's first draft and adversarial review.
cmCheckWorker : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), List (String, Scheme))
cmCheckWorker mid seed accData _accAll prog =
  let schemes = checkModuleFullImpl mid seed accData [] prog
  (schemes, schemes)

-- check every module in dependency order against a shared prelude + runtime.
-- modules = (moduleId, desugared program) in dependency-first order.
export
checkModules : List Decl -> List Decl -> List (String, List Decl) -> List (String, List (String, Scheme))
checkModules runtimeDecls coreDecls0 modules0 =
  -- #1110: acquire type-constructor identity over the whole graph before anything
  -- typechecks; the rebind shadows the raw params so no line below can read the
  -- unstamped tree.  See `checkModulesPreamble` for why it is here and not there.
  let (coreDecls, modules) = stampGraphTyOrigins coreDecls0 modules0
  let (runtimeSeed, coreSchemes) = checkModulesPreamble runtimeDecls coreDecls modules
  -- #154 PR-C: cmCheckWorker reads NEITHER accData (checkModuleFull → Module path, where
  -- checkBodyImpl binds it `_` and never reads it) NOR accAll (its `_accAll` param), so
  -- both concats are pure waste here — the residual O(modules^2) the PR-A review found.
  -- wantData=wantAll=False threads them unchanged (no copy) and the `[] []` initials keep
  -- the dead values empty → the whole perf-gate `checkModules` path is O(N).
  foldModules
    False
    False
    cmCheckWorker
    (_last mid schemes rest => (mid, schemes)::rest)
    []
    (runtimeSeed ++ coreSchemes)
    coreSchemes
    []
    []
    []
    modules

-- ── per-module ISOLATED diagnostics (the analyzeProject typecheck stage) ────
-- Like checkModuleFull but ALSO harvests THIS module's type diagnostics: it shares the
-- flat paths' seeding via `seedCheckRun` (#415 item 1 — matchOracle/matchWarnings/
-- implInferEnabled) and runs coherence over the module's OWN decls, while keeping the
-- module ISOLATED — only
-- PUBLIC schemes/data of earlier modules are seeded (via seedVars/accData), so a
-- private same-named helper in another module never collides (the bug the old
-- flat prefix-concat diagnostics path had).  checkModuleFull calls resetState (),
-- which clears typeErrors at module start, so the post-call typeErrors snapshot is
-- exactly THIS module's contribution; matchWarnings is cleared here explicitly
-- (resetState does NOT clear it).  Returns (own value schemes, errs, warns) so the
-- driver can thread accV/accData exactly as foldModules does.
--
-- ⚠️ PRECONDITION (#154 PR1/PR2): this is per-module, and the Module path now consults
-- the persistent universe accumulators (universeIfaceMethodsRef /
-- universeMethodIfaceParamsRef / …) which SURVIVE the
-- per-module resetState.  They are grown by `appendUniverseAccums prog0` per module but
-- must be CLEARED once per run by `resetCrossModuleState` (and seeded by the core pass)
-- BEFORE the first module.  Every existing caller goes through a driver that does exactly
-- that (foldModulesDiags / checkModulesDiags via resetCrossModuleState); a future
-- standalone caller that skips it would leak the previous run's universe into this one.
--
-- 🚨 THE SENTENCE ABOVE DOES NOT COVER EVERYTHING THE Module PATH READS, AND THE ONE
-- EXCEPTION IS EXACTLY BACKWARDS FROM IT (#1111 A-2.5b).  `driverState.graphMethodExportsRef`
-- — the method-identity index `applyMethodScopeOverrides` consults on this path — is NOT a
-- `CrossRun` accumulator and `resetCrossModuleState` does NOT clear it, deliberately: it is
-- derived once from the WHOLE graph and has no per-module re-seed path, so being cleared
-- mid-run is precisely the defect that put it on `driverState` (F1 — `check` clean while
-- `run`/`build` reported a type error).  For it the precondition is not "clear before the
-- first module" but **"OVERWRITE with this run's graph before the first module"**:
--     setRef driverState.value.graphMethodExportsRef (graphMethodExports coreDecls modules)
-- which `checkModulesPreamble` and `elaborateModules` both do.  ⚠️ The failure modes differ
-- in KIND, which is why this is worth spelling out rather than folding into the list above:
-- skipping `resetCrossModuleState` leaks the previous run's universe; skipping THIS write
-- leaves the previous run's INDEX in place, and a stale index can pick a wrong interface
-- where an empty one merely declines to the floor.  A standalone caller must do BOTH.
export
checkModuleFullDiags : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), List TcDiag, List TcDiag)
checkModuleFullDiags mid seedVars accData accAll prog =
  -- #415 item 1: same seeding preamble as the flat entry points (one body), but the
  -- oracle decls are THIS module's own first.
  -- P0-9: THIS module's own decls (`prog`) come FIRST so its constructors win
  -- the oracle's first-wins bare-name tables.  Another loaded module (in accData)
  -- can define a same-named ctor at a different arity (`map`'s arity-5 `Bin` vs
  -- `set`'s arity-4 `Bin`); with accData first, the type-aware `check_match` reads
  -- the WRONG arity/type for this module's own `Bin` in a match and false-warns
  -- W-NONEXHAUSTIVE.  buildOracle is duplicate-tolerant, and accData still
  -- supplies prelude Option/Result ctors (this module never redefines them).
  -- #674 / #1111 A-2.6: the decls whose CONSTRUCTORS this module binds by name are
  -- prepended BEFORE accData so their ctors win the oracle's first-wins bare-name
  -- tables over any same-named ctor a non-imported module contributes by load order —
  -- the exhaustiveness peer of the typecheck-scheme overlay.  Own-module `prog` still
  -- wins first.  The overlay decls come from the persistent universe (same source the
  -- dataEnv overlay uses), which equals accData here but keeps the two overlays in
  -- lockstep.
  --
  -- ⚠️ TWO CLAIMS THAT USED TO STAND HERE ARE FALSE SINCE A-2.6's RULE (b), which is
  -- why they are written out rather than re-pointed:
  --   * NOT "the types this module imports with `(..)`" — EVERY selective
  --     constructor-naming member contributes now (`import m.{T, C}`, and a record's
  --     `import m.{Cfg}`), not only the `(..)` spelling.
  --   * NOT "a module with no `T(..)` import is byte-identical" — only a module that
  --     names no constructor at all AND carries no wildcard import is.  A wildcard
  --     (`import m.*`) contributes m's whole published row without naming any
  --     constructor, since `wildOverlayDecls`; before that arm existed it fell to the
  --     universe fallback and import-clause ORDER decided the oracle's answer.
  -- The PERF claim is corrected at `importedCtorTypeDeclsFirstWins` itself (the result is bounded
  -- by import count x per-module public decl count; the WORK is O(members x |universe|),
  -- held down by one zero-allocation traversal per member).  Do not restate it as "no
  -- O(N²)" here: this
  -- call site is the SECOND per-module scan of the same pool, so it doubles whatever
  -- that constant is.
  -- A-3.2b (#1512): the SECOND consumer of the retired `universeDataDecls`, re-pointed
  -- at stage K in lockstep with the `dataEnv` overlay — the two must stay on the same
  -- pool ("keeps the two overlays in lockstep", above), and `mid` is this function's
  -- own parameter, so the same loader-derived key reaches both.
  let declEnvsHere = driverState.value.declEnvsRef.value
  -- 🚨 `…FirstWins`: `oracleMap` is `omFromPairs (reverseL …)`, so the FIRST row wins and
  -- the `UseGroup` rows must come FIRST for an explicitly named member to outrank a
  -- wildcard.  The `dataEnv` overlay takes `…LastWins` — opposite order, same rule,
  -- because that consumer is last-write-wins.  See `importedCtorTypeDeclsFirstWins`.
  let _ = seedCheckRun (prog ++ importedCtorTypeDeclsFirstWins prog (declEnvsOrdOf mid declEnvsHere) declEnvsHere.deModules ++ accData)
  -- Bug C: pass the cumulative full impl universe (core + earlier modules) as
  -- implDecls (was checkModuleFull, i.e. implDecls=[]) so buildStandaloneShadows sees
  -- an imported standalone funDef that shadows an interface method (`map`'s `toList`
  -- vs Foldable's): without it the importer-shadow set is EMPTY on the CHECK path and
  -- `toList m` routes to method dispatch → spurious `No impl of Foldable for Map`.
  -- implInferEnabled stays False, so this does NOT trigger impl-body inference — it
  -- only feeds the shadow/dispatch-index/key tables, matching the eval path's
  -- elabModuleStamp (which passes accAll ++ prog too).
  -- #749: thread the REAL module id (not "") so this module's constrained fns are
  -- attributed into crossModuleFunConstraintsQualRef under their OWN source module —
  -- SOURCE-EXACT, exactly as the emit path (elabModuleStamp mid) does.  With mid=""
  -- every module attributed under "", so qualConstraintFor (which keys by the import's
  -- real source module via currentImportDefinersRef) always MISSED for a user-module
  -- constrained callee → declaredCrossModuleObls dropped its obligation → `check`
  -- false-greened on `p.f Z` (Display Z missing) while run/build rejected (the #673
  -- residual #738 fixed only for the prelude/core coreSchemeObligationsRef flow).  The
  -- source-exact keying makes it MISS for a genuinely-unconstrained same-name import
  -- (#739's `q.f`, attributed nowhere), so no over-rejection is reintroduced.
  let schemes = checkModuleFullImpl mid seedVars accData accAll prog
  -- #1557 A-3.5c: the whole-graph `CE`, read at THIS module's ordinal — the same
  -- `declEnvsOrdOf mid` key `seedCheckRun`'s overlay pool above and `moduleImplUniv`
  -- (`checkBodyImpl`) already read at.  ONE env for both members; they differ only in
  -- which population they take from it (`ceRowsOwnedBy` vs `ceRowsVisibleAt`).
  let ceHere = declEnvsHere.deIfaces
  let ordHere = declEnvsOrdOf mid declEnvsHere
  -- #1557 A-3.5b: the whole-graph `IE`, read at the SAME `ordHere` — the same key
  -- `ceHere` and `moduleImplUniv` (`checkBodyImpl`) already read at.
  -- #1559 A-3.7: coherence reads the SAME whole-graph `IE` at the SAME `ordHere`, and
  -- takes this module's OWN rows from it (`cohRowsOwnedBy`) — the population `prog`
  -- named, derived in `checkCoherence`'s header.  `hasPrelude = True`: this env came
  -- from `buildDeclEnvs`, which seats the prelude at ordinal 0, and coherence has never
  -- seen prelude impls.
  let _ = runFinalChecks prog (accAll ++ accData ++ prog) ceHere ceHere declEnvsHere.deImpls declEnvsHere.deImpls ordHere True
  (
    schemes,
    reverseL perRun.value.typeErrors.items.value,
    reverseL driverState.value.matchWarnings.value,
  )
-- Seed the ctor oracle over ALL data decls in scope (prelude + every imported
-- module via accData, plus this module's own prog), NOT just `prog`.  The
-- single-file path (checkProgramDiags:5826) sees a flat prelude+user dump, so
-- its `buildOracle prog` already includes Option/Result; the multi-module path
-- keeps modules separate, so prelude ADTs live in accData.  Seeding with only
-- `prog` left the oracle missing Some/None|Ok/Err → exhaustive matches on
-- Option/Result false-warned "non-exhaustive".  buildOracle reads only DData
-- and is duplicate-tolerant, so accData ++ prog is safe.

-- checkModuleFull → checkModuleFullImpl runs resetState () first (clears
-- typeErrors + currentLevel), so the snapshot below is this module's own errors.

-- coherence over THIS module's own decls (mirrors checkProgramDiags's
-- checkCoherence coherenceUserDecls.value, which moduleTypeDiags set to the
-- module decls).  Pushes any conflict into typeErrors AFTER the resetState above.

-- multi-module diagnostics driver: threads the runtime+core seed and per-module
-- PUBLIC accumulators exactly as foldModules threads, but at each module harvests its
-- ISOLATED diagnostics via checkModuleFullDiags.  Returns one
-- (mid, (errs, warns)) per module in load order.  Core is checked ONCE (its
-- diagnostics are not surfaced — it is the trusted prelude, as in checkModules).
-- IMPORT-SCOPED seed (baseSeed ++ importSeed prog depEnv), exactly like
-- foldModules — NOT a flat union of every earlier module's publics, which let
-- a same-named function from a non-imported module win by load order (e.g.
-- string.reverse shadowing the list.reverse a module imports → spurious errors).
-- worker: ISOLATED per-module diagnostics harvest (checkModuleFullDiags — see its
-- doc above).  Surfaces this module's own `schemes` (for pubV) plus its (errs, warns)
-- payload.  IMPORT-SCOPED seed exactly like cmCheckWorker; NOT a flat union.
cmDiagsWorker : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), (List TcDiag, List TcDiag))
cmDiagsWorker mid seed accData accAll prog =
  let (schemes, errs, warns) = checkModuleFullDiags mid seed accData accAll prog
  (schemes, (errs, warns))

export
checkModulesDiags : List Decl -> List Decl -> List (String, List Decl) -> List (String, (List TcDiag, List TcDiag))
checkModulesDiags runtimeDecls coreDecls0 modules0 =
  -- #1110: acquire type-constructor identity over the whole graph before anything
  -- typechecks; the rebind shadows the raw params so no line below can read the
  -- unstamped tree.  See `checkModulesPreamble` for why it is here and not there.
  let (coreDecls, modules) = stampGraphTyOrigins coreDecls0 modules0
  let (runtimeSeed, coreSchemes) = checkModulesPreamble runtimeDecls coreDecls modules
  -- #154 PR-C: cmDiagsWorker reads BOTH accData (buildOracle `prog ++ accData` +
  -- runFinalChecks) and accAll (checkModuleFullImpl implDecls + runFinalChecks), and both
  -- are order-observable (oracle first-wins, runFinalChecks scan order), so both concats
  -- are RETAINED verbatim — this diagnostics path stays byte-identical (not the perf-gate
  -- path; it is a byte-identity witness).
  let perMod = foldModules
    True
    True
    cmDiagsWorker
    (_last mid ew rest => (mid, ew) :: rest)
    []
    (runtimeSeed ++ coreSchemes)
    coreSchemes
    []
    (publicDataDecls coreDecls)
    coreDecls
    modules
  -- D3 / WS-2 part-2: attach any cross-module coherence conflict to the ENTRY
  -- module's diagnostics (last in dependency-first order), so LSP/analyzeProject
  -- surfaces it too.  User modules only (prelude excluded).
  -- #414: no span — see globalCoherenceConflict (the entry module it attaches to is
  -- not the module the span would name, and the renderer keys the file by group).
  -- F-3d: the ⊑-incomparable half rides the WARNING list of the same module.
  -- #1559 A-3.7: the whole-graph `IE` the preamble built above; `cohRowsOf True` is
  -- what excludes the prelude, replacing "walk the user `modules` list".
  match globalCoherenceConflict driverState.value.declEnvsRef.value.deImpls
    (hard, soft) => attachEntryWarnOpt soft (attachEntryDiagOpt hard perMod)

attachEntryDiagOpt : Option String -> List (String, (List TcDiag, List TcDiag)) -> List (String, (List TcDiag, List TcDiag))
attachEntryDiagOpt None perMod = perMod
attachEntryDiagOpt (Some msg) perMod =
  attachEntryDiag (TcDiag "T-CONFLICTING-IMPL" 1 None msg None None) perMod

attachEntryWarnOpt : Option String -> List (String, (List TcDiag, List TcDiag)) -> List (String, (List TcDiag, List TcDiag))
attachEntryWarnOpt None perMod = perMod
attachEntryWarnOpt (Some msg) perMod =
  attachEntryWarn
    (TcDiag "W-INCOMPARABLE-IMPLS" 2 None msg (Some cohIncomparableHelp) None)
    perMod

-- prepend a warning to the LAST module's (errs, warns) in a per-module diag list —
-- the warning-channel twin of `attachEntryDiag`, same entry-module attribution.
attachEntryWarn : TcDiag -> List (String, (List TcDiag, List TcDiag)) -> List (String, (List TcDiag, List TcDiag))
attachEntryWarn _ [] = []
attachEntryWarn w [(mid, (errs, warns))] = [(mid, (errs, w::warns))]
attachEntryWarn w (m::rest) = m :: attachEntryWarn w rest

-- prepend an error to the LAST module's (errs, warns) in a per-module diag list.
attachEntryDiag : TcDiag -> List (String, (List TcDiag, List TcDiag)) -> List (String, (List TcDiag, List TcDiag))
attachEntryDiag _ [] = []
attachEntryDiag e [(mid, (errs, warns))] = [(mid, (e::errs, warns))]
attachEntryDiag e (m::rest) = m :: attachEntryDiag e rest

-- the entry module is last in dependency-first order
export
entryOwnSchemes : List (String, List (String, Scheme)) -> List (String, Scheme)
entryOwnSchemes [] = []
entryOwnSchemes [(_, ss)] = ss
entryOwnSchemes (_::rest) = entryOwnSchemes rest

-- ── multi-module `check` CLI report (DRIVER-COLLAPSE Phase 4, OPTION A) ─────
-- The unified `medaka check` path for IMPORT-BEARING files: the caller loads the
-- entry + its transitive imports (loadProgram), then this typechecks the whole
-- graph in dependency order (checkModuleFullDiags per module: per-module-frame,
-- prelude seeded once) and harvests the ENTRY module's OWN (schemes, errs, warns).
-- Imports are RESOLVED (their public schemes seed the entry), so a valid cross-
-- module reference no longer falls through to `UnknownModule` — the known "native
-- check is single-file" limitation, fixed.  The entry is last in dependency-first
-- order.  No-import (1-module) files still route through runCheck (full prelude+
-- user dump, byte-identical); this path is reached ONLY when the load returned
-- more than one module.
checkModulesEntryFull : List Decl -> List Decl -> List (String, List Decl) -> (List (String, Scheme), List TcDiag, List TcDiag)
checkModulesEntryFull runtimeDecls coreDecls0 modules0 =
  -- #1110: acquire type-constructor identity over the whole graph before anything
  -- typechecks; the rebind shadows the raw params so no line below can read the
  -- unstamped tree.  See `checkModulesPreamble` for why it is here and not there.
  let (coreDecls, modules) = stampGraphTyOrigins coreDecls0 modules0
  let (runtimeSeed, coreSchemes) = checkModulesPreamble runtimeDecls coreDecls modules
  -- #154 PR-C: cmEntryWorker also routes through checkModuleFullDiags, reading BOTH
  -- accData and accAll exactly as cmDiagsWorker does → both concats RETAINED (byte-identity
  -- witness, not the perf-gate path).
  let (schemes, errs, warns) = foldModules
    True
    True
    cmEntryWorker
    cmEntryCollect
    ([], [], [])
    (runtimeSeed ++ coreSchemes)
    coreSchemes
    []
    (publicDataDecls coreDecls)
    coreDecls
    modules
  -- D3 / WS-2 part-2: cross-module coherence over the USER modules only (prelude
  -- excluded — it is checked separately and a user impl may override a prelude one).
  -- Prepend any conflict (dependency-first, ahead of the entry's own errors).
  -- #414: no span — see globalCoherenceConflict.
  -- F-3d: the ⊑-incomparable half is prepended to `warns` instead of `errs`.
  -- #1559 A-3.7: the whole-graph `IE` the preamble built above; `cohRowsOf True` is
  -- what excludes the prelude, replacing "walk the user `modules` list".
  match globalCoherenceConflict driverState.value.declEnvsRef.value.deImpls
    (hard, soft) => (schemes, prependDiagOpt "T-CONFLICTING-IMPL" 1 None hard errs, prependDiagOpt "W-INCOMPARABLE-IMPLS" 2 (Some cohIncomparableHelp) soft warns)

-- prepend an optional bare-message diagnostic (code, severity, help) to a TcDiag list.
prependDiagOpt : String -> Int -> Option String -> Option String -> List TcDiag -> List TcDiag
prependDiagOpt _ _ _ None ds = ds
prependDiagOpt code sev help (Some msg) ds =
  TcDiag code sev None msg help None :: ds

-- worker: same ISOLATED per-module diagnostics as cmDiagsWorker, but surfaces the
-- FULL triple (schemes, errs, warns) as its payload so cmEntryCollect can keep the
-- terminal module's OWN schemes/warns.  IMPORT-SCOPED seed, exactly like the others.
cmEntryWorker : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), (List (String, Scheme), List TcDiag, List TcDiag))
cmEntryWorker mid seed accData accAll prog =
  let (schemes, errs, warns) = checkModuleFullDiags mid seed accData accAll prog
  (schemes, (schemes, errs, warns))

-- collect: the ENTRY report keeps the ENTRY (last/terminal) module's SCHEMES and
-- WARNINGS (those belong to the entry's report), but ACCUMULATES type errors from
-- EVERY module dependency-first: a type error in an IMPORTED module is still a hard
-- error of `check`ing the entry graph and must surface (else it silently reaches
-- codegen — the G1-class soundness hole).  Earlier-module errors are PREPENDED
-- (`e ++ eE`) to the recursion's; only isLast (the terminal module) uses its OWN
-- schemes/warns, every earlier module inherits eS/eW from the recursion.
cmEntryCollect : Bool -> String -> (List (String, Scheme), List TcDiag, List TcDiag) -> (List (String, Scheme), List TcDiag, List TcDiag) -> (List (String, Scheme), List TcDiag, List TcDiag)
cmEntryCollect isLast _mid extra rest =
  let (s, e, w) = extra
  let (eS, eE, eW) = rest
  if isLast then (s, e ++ eE, w) else (eS, e ++ eE, eW)

-- render the entry report: type errors win (each `TYPE ERROR: …`), else the
-- entry's `name : scheme` lines followed by its non-exhaustive-match warnings.
-- The harness sorts, so scheme/warn relative order is not load-bearing.  Mirrors
-- runCheck's single-file shape, but over the entry module of a resolved graph.
export
checkModulesEntryReport : List Decl -> List Decl -> List (String, List Decl) -> String
checkModulesEntryReport runtimeDecls coreDecls modules =
  let (schemes, errs, warns) = checkModulesEntryFull runtimeDecls coreDecls modules
  match errs
    [] => joinNl (schemeLines schemes ++ map tcMsg warns)
    _ => joinNl (typeErrorLines (map tcMsg errs))

-- exit-code predicate analog of checkHasErrors: any type error in ANY module of
-- the resolved graph (entry or imported — see cmEntryCollect / foldModules).
export
checkModulesEntryHasErrors : List Decl -> List Decl -> List (String, List Decl) -> Bool
checkModulesEntryHasErrors runtimeDecls coreDecls modules =
  let (_, errs, _) = checkModulesEntryFull runtimeDecls coreDecls modules
  match errs
    [] => False
    _ => True

-- run the multi-module front-end and render the ENTRY module's own bindings as
-- `name : scheme` per line (the harness sorts) — diffs vs dev/tc_module_probe.
export
checkModulesEntryLines : List Decl -> List Decl -> List (String, List Decl) -> String
checkModulesEntryLines runtimeDecls coreDecls modules =
  joinNl (schemeLines (entryOwnSchemes (checkModules
    runtimeDecls
    coreDecls
    modules)))

-- Emit EVERY module's bindings in one pass, each section preceded by a
-- `## MODULE <mid>` marker line.  A single full-closure run can then cover many
-- modules at once (the batch harness splits on the marker and diffs each
-- section vs its per-module oracle).  Scheme of a module depends only on its
-- dependency-closure (which precedes it in topo order), so a module's section
-- is identical whether checked alone or inside a larger union closure.
export
checkModulesAllLines : List Decl -> List Decl -> List (String, List Decl) -> String
checkModulesAllLines runtimeDecls coreDecls modules =
  joinNl (allModuleLines (checkModules runtimeDecls coreDecls modules))

allModuleLines : List (String, List (String, Scheme)) -> List String
allModuleLines [] = []
allModuleLines ((mid, ss)::rest) =
  "## MODULE " ++ mid :: schemeLines ss ++ allModuleLines rest

-- ── TYPED multi-module elaboration (bootstrap eval front-end) ──────────────
-- The multi-module analog of `elaborate`: the composition of `checkModules`
-- (per-module-frame typecheck, dependency-first) and the EMethodAt route-
-- stamping `elaborate` does single-module.  prePasses the prelude + every module
-- (rewriting return-position method occurrences to EMethodAt over the WHOLE
-- program's RP method set), typechecks each module in dependency order (seeded
-- like checkModules), and STAMPS each module's route refs from its now-resolved
-- result types.  Returns the SAME trees (refs filled) so evalModules can route
-- return-position dispatch (`pure`/`andThen` — the Parser monad) by RKey instead
-- of the untyped arg-tag fallback.  RKey-only (dictNames = []): the bootstrap
-- source uses no `=>`-constrained user polymorphism, so no EDictAt / dict params
-- and no pendingDictApps / pendingRecDictApps to resolve.
export
elaborateModules : List Decl -> List Decl -> List (String, List Decl) -> (List Decl, List (String, List Decl))
-- E4: apply D3b's ARG-position dict-passing per module, mirroring elaborateDict.
-- Runs on every path (single elaboration mode, #157).
--
-- implInferEnabled is ON unconditionally: the EVAL
-- path needs impl-body inference too, so a standalone-shadow method call INSIDE an
-- impl body (map's `Debug`/`Eq`/`Ord`/`Display (Map k v)` bodies all call standalone
-- `toList m`) RECORDS its RLocal site (recordRLocalSite → pendingRLocalSites) for
-- resolveRLocalSites to stamp.  Without it the impl-body `toList` route stayed at its
-- default RNone → eval arg-tag-dispatched a Map through the no-matching-tag `keepOrAll`
-- fallback to Foldable List's `toList = identity` → returned the Map unchanged →
-- `debug`/`display` recursed forever (SIGBUS on `medaka test stdlib/map.mdk`).  The
-- TYPECHECK golden probes use checkModulesEntryLines/checkModulesDiags (NOT
-- elaborateModules), so their goldens are unaffected; the diff gates all run with
-- impl inference ON — a single elaboration mode across every driver.
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
elaborateModules runtimeDecls coreDecls0 modulesIn =
  driverState.value.implInferEnabled := True
  -- IMPORT ALIASING of an interface/impl METHOD — resolve it back to the origin name
  -- before ANY of the marking / stamping / dict-arity machinery below runs.  See
  -- renameAliasedMethods: a method is global-by-name, so an alias of one is a second
  -- SPELLING, not a second binding.
  --
  -- #1110: `stampGraphTyOrigins` is the resolve→typecheck channel (see its own doc
  -- comment).  It runs HERE, not in a driver, because this is the seam the RUN path
  -- and the separate `medaka_emitter` BUILD process share — the emitter never runs
  -- resolve, so acquiring identity anywhere upstream would give `check` and `build`
  -- different trees.  Method-alias renaming first: it is a name rewrite on VALUES
  -- and cannot move a type head, but keeping the graph in its final shape before
  -- identity is minted means no later pass has to re-mint.
  let (coreDecls, modules) = stampGraphTyOrigins coreDecls0 (renameAliasedMethods coreDecls0 modulesIn)
  driverState.value.mainSchemeRef := None
  let _ = resetCrossModuleState ()
  -- #1111 A-2.5b: the graph's method-identity index — the identical line
  -- `checkModulesPreamble` carries, for the one Module-mode driver that does not use
  -- that preamble.  See `graphMethodExports`.
  --
  -- This driver runs the `Module` arm on TWO paths — the bare sweep below and, when
  -- `promotionHarvestRef` is non-empty, the second sweep in the `_ =>` arm that begins
  -- with another `resetCrossModuleState ()`.  This one write covers both ONLY because
  -- the ref is on `driverState`, which that reset does not touch (F1).
  driverState.value.graphMethodExportsRef := (graphMethodExports coreDecls modules)
  -- #1354 unit A follow-up: the TYPE-namespace peer, written in LOCKSTEP with the line
  -- above.  Same graph, same two entries, same safety conjunction — see graphIfaceMethods.
  driverState.value.graphIfaceMethodsRef := (graphIfaceMethods coreDecls modules)
  -- #1111 A-2.11 (#1319 unit 1): the CONSTRUCTOR peer, same placement, same reasoning —
  -- including the two-sweep note above, which it inherits verbatim (same `driverState`).
  driverState.value.graphCtorExportsRef := (graphCtorExports coreDecls modules)
  -- #1112 A-3.1: the whole-graph declaration envelope — the identical line
  -- `checkModulesPreamble` carries, for the driver that does not use that preamble.
  -- It inherits the two-sweep note above for the same reason the three peers do: the
  -- ref is on `driverState`, which `resetCrossModuleState` does not touch.
  let declEnvs = buildDeclEnvs coreDecls modules
  driverState.value.declEnvsRef := declEnvs
  -- #1112 A-3.1: `deAllDecls` IS `coreDecls ++ flatMap snd modules` — the same list
  -- value (see `declEnvDeclsOf`), now derived from the envelope.
  let allDecls = declEnvs.deAllDecls
  -- #80/#201: populate effect domains ONCE over the WHOLE import graph (builtins +
  -- every `effect …` decl), BEFORE any per-module resetState (discovery scratch pass
  -- + the elabModuleStamp loop both call it) can read them — resetState no longer
  -- re-seeds, and effectDomains has a single writer (populateEffectDomains), so this
  -- persists untouched through the whole emit pass.
  let _ = populateEffectDomains allDecls
  -- P0-18: recover the definer-shadow map from the (already-mangled on the emit path)
  -- decls BEFORE marking/typecheck reads it.  Empty on the un-mangled path.  Set once
  -- here; per-module resetState (in checkModuleFullImpl) does NOT clear it.
  -- L3 (xmod-identity #1351 spine): bind the unit list ONCE so the map and the
  -- graph-level "carries mangled funDefs" flag can never drift apart.
  let mangleUnitsList = ("core", coreDecls)::modules
  driverState.value.mangledShadowMapRef := (computeMangledShadowMap allDecls mangleUnitsList)
  driverState.value.mangledFunDefsPresentRef := (graphCarriesMangledFunDefs mangleUnitsList)
  let _ = (driverState.value.superDeclsRef := allDecls)  -- WS-1b: interfaces in scope for the discovery scratch typecheck
  let _ = (driverState.value.userIfaceNamesRef := (collectIfaceNames (flatMap snd modules)))  -- WS-1b: gate super-expansion to user interfaces
  let rpNames = returnPosMethodNames allDecls
  driverState.value.argDispatchIdxByIdRef := (argDispatchIndicesById allDecls)
  -- #1351 L5 (CONTRACT): the NAME SET only — `prePassDictArg` wants the names, not the
  -- indices, and the indices are now answered exclusively by the identity-keyed table above.
  let argNames = map fst (argDispatchIndices allDecls)
  let _ = setDictEligible (moduleUserFnNames modules)
  -- #194: eliminate the redundant MANDATORY promotion-discovery whole-program
  -- typecheck.  Direct-promotion == ∅ ⟹ full-promoted == ∅ (inherited promotion needs a
  -- leaf direct promotion to inherit from), so a SINGLE bare-dict elaboration sweep that
  -- harvests zero direct promotions is ALREADY the final, correct answer — no discovery
  -- pass, no second sweep.  The bare-dict names (moduleDictNames + aliases, WITHOUT any
  -- promoted set) drive both the prePass marking and the final dictPass.
  let bareDictNames0 = dedup (moduleDictNames coreDecls allDecls modules)
  let dictNames0 = dedup (bareDictNames0
    ++ aliasDictNames bareDictNames0 (("core", coreDecls)::modules) modules)
  -- #1354 unit A (#1353): the mark set is split so its SHADOW component can be scoped per
  -- module.  `buildStandaloneShadowsGraph` is graph-global by construction (its own header
  -- says "graph-wide"), and so is `argNames` — both hand one name set to a rewriter that
  -- runs per module, which is how an interface reachable only transitively captured an
  -- explicitly-imported standalone on the run/build path.  `markRpNames` (the unsplit set)
  -- is still what CORE is marked with: `core` is the prelude, every interface it declares
  -- is nameable in it, and S1 makes a `core.mdk` occurrence no user standalone's shadow
  -- anyway (P0-21).  Scoping happens in `prePassModulePairArg`, which has the module's own
  -- decls in hand — INCLUDING `rpNames`, which `prePassModulePairArg` filters with the same
  -- predicate as everything else it marks.
  --
  -- 🚨 THIS COMMENT USED TO SAY `rpNames` WAS "deliberately NOT scoped here: a different
  -- axis with no filed repro", AND THAT CARVE-OUT WAS AN S0.  The repro was missing because
  -- the CORPUS could not express it — every interface method in `test/shadow_fixtures/`
  -- mentioned its typaram in an ARGUMENT, so 52 assertions were green while a
  -- RETURN-position method of a non-nameable interface gave `run` 777 against a built binary
  -- of 42, both at exit 0 with no diagnostic.  "No filed repro" was a fact about the
  -- corpus, not about the code.  See `prePassModulePairArg` for the full enumeration of
  -- every input that can become an `EMethodAt`, and
  -- `test/shadow_fixtures/d24_definer_return_pos_not_nameable/` for the cell that now
  -- expresses the axis.
  let markSharedNames = dedup (rpNames ++ methodConstraintNames allDecls)
  let graphShadowNames = buildStandaloneShadowsGraph allDecls (flatMap snd modules)
  let markRpNames = dedup (markSharedNames ++ graphShadowNames)
  -- #1280: the EMIT arm's copy of `checkModulesPreamble`'s line — the same scope,
  -- for the driver that does not use that preamble.  This is the seam `run` and
  -- the separate `medaka_emitter` process share, so an extern head stamped here
  -- and not there would be a fresh check≠build divergence.
  let runtimeSeed = externSchemes (externTyOriginScope coreDecls) runtimeDecls
  -- FIRST SWEEP (bare-dict): the real per-module elaboration, harvesting each module's
  -- direct promotions (registerInferredConstraints → promotedRef, unioned per module by
  -- elabHarvestWorker).  On a program that promotes NOTHING — every compiler self-compile
  -- and any promotion-free program — the harvest is empty and this sweep's stamped trees
  -- are already correct, saving the whole discovery typecheck (the ~20% front-end win).
  let core2a = prePassDictArg markRpNames dictNames0 argNames driverState.value.mangledShadowMapRef.value coreDecls
  let modules2a = map (prePassModulePairArg markSharedNames graphShadowNames dictNames0 argNames driverState.value.mangledShadowMapRef.value) modules
  driverState.value.promotionHarvestRef := []
  let coreSchemesA = elabModuleStamp "" runtimeSeed [] core2a core2a
  -- #154 PR-C: elabHarvestWorker → elabWorker → elabModuleStamp reads accAll as its
  -- impl-body universe (`accAll ++ prog`, order-observable through buildImplTable/
  -- resolveSites) but forwards accData only to checkModuleFullImpl's dead
  -- Module `accData` field.  wantAll=True keeps the impl-universe concat byte-identical;
  -- wantData=False drops the dead accData concat (`[]` initial).
  let _ = foldModules
    False
    True
    elabHarvestWorker
    (_last _mid _extra _rest => ())
    ()
    (runtimeSeed ++ coreSchemesA)
    coreSchemesA
    []
    []
    core2a
    modules2a
  match driverState.value.promotionHarvestRef.value
    -- EMPTY: no direct promotion anywhere ⟹ no full promotion ⟹ nothing needed marking
    -- beyond moduleDictNames.  The bare sweep IS final — 1 whole-program typecheck.
    [] => dictPassModulesIfEnabled dictNames0 core2a modules2a
    -- NON-EMPTY: ≥1 fn was directly promoted, so its call sites (unmarked under bareDict,
    -- while its body already routes RDict) are UNSOUND to keep.  DISCARD the bare sweep
    -- and fall back to today's EXACT 2-pass path: joint discovery (which seeds
    -- crossModuleFunConstraintsRef so a promoted fn's inferred arity is visible when its
    -- cross-module CALLER is checked) then the real marking sweep with the
    -- promotion-augmented dict-name set.  resetCrossModuleState clears the Qual
    -- accumulators the bare sweep filled; mainSchemeRef is re-armed for last-wins.
    _ =>
      let _ = resetCrossModuleState ()
      driverState.value.mainSchemeRef := None
      -- the bare sweep's per-module elabModuleStamp left superDeclsRef at the LAST
      -- module's implDecls; restore the whole-graph value (mirror the WS-1b set above)
      -- so discovery's super-expansion sees every interface, exactly as today's path.
      driverState.value.superDeclsRef := allDecls
      let promoted = discoverPromotedModules runtimeDecls coreDecls modules rpNames argNames
      let bareDictNames = dedup (moduleDictNames coreDecls allDecls modules ++ promoted)
      -- IMPORT ALIASING: prePassDict* marks a call site `EVar n` as a dict application only
      -- when `n` is in dictNames — a set of DEFINITION names.  An aliased call site writes
      -- the LOCAL name, so unless the alias locals are added here the call is never marked,
      -- receives no dict arguments, and silently UNDER-APPLIES: `check` stays green and
      -- `run` dies downstream with a type-confused value (the Phase-134 shape).
      let dictNames = dedup (bareDictNames
        ++ aliasDictNames bareDictNames (("core", coreDecls)::modules) modules)
      let core2 = prePassDictArg markRpNames dictNames argNames driverState.value.mangledShadowMapRef.value coreDecls
      let modules2 = map (prePassModulePairArg markSharedNames graphShadowNames dictNames argNames driverState.value.mangledShadowMapRef.value) modules
      let coreSchemes = elabModuleStamp "" runtimeSeed [] core2 core2
      -- #154 PR-C: same as the bare sweep above — elabWorker reads accAll (impl universe,
      -- order-observable) but not accData (dead Module field).  wantAll=True keeps the
      -- concat byte-identical; wantData=False drops the dead one (`[]` initial).
      let _ = foldModules
        False
        True
        elabWorker
        (_last _mid _extra _rest => ())
        ()
        (runtimeSeed ++ coreSchemes)
        coreSchemes
        []
        []
        core2
        modules2
      dictPassModulesIfEnabled dictNames core2 modules2
-- arg-position interface-method names whose route resolveArgStamps may stamp
-- (populated on every path; an empty set would degenerate prePassDictArg to prePassDict)

-- DRIVER-COLLAPSE Phase 2 (global): seed the promotion-eligible set with the USER
-- modules' top-level fn names (NOT core/prelude — those keep arg-tag / RKey
-- dispatch, which type-checks the goldens).  Seeded on every path (single
-- elaboration mode) so
-- elaborateModules promotes INFERRED-constraint user fns exactly as flat
-- elaborateDict does (discoverAll runs discoverPromoted whenever eligibleNames is
-- non-empty).  The TYPECHECK golden module drivers
-- (checkModulesEntryLines/checkModulesDiags) never reach elaborateModules, so their
-- goldens are unaffected; the eval goldens are captured from the OCaml oracle's
-- run, which dict-passes prelude+modules unconditionally — so promotion-on-eval
-- matches them.  Mirrors elaborateDict's dictEligibleRef seed.

-- Cause A / Phase 2: run a JOINT-flattened promotion fixpoint over runtime ++ core
-- ++ all modules (mirror discoverPromoted) so an unsignatured fn whose body
-- dispatches a method in ARG position (`f s = println s` → inferred `Display a => …`)
-- OR uses a return-position method (`doubleEmpty x = append (append x empty) empty`
-- → inferred `Monoid a => …`) is discovered + registered in
-- promotedRef/funConstraintsRef/activeDictVars.  The promoted names then join the
-- dict-name set so their call sites are marked EDictAt (caller supplies the dict
-- ARGUMENT) and their defs get the leading dict PARAM.  Runs on every path with
-- argNames populated (single elaboration mode), so both return-position and
-- arg-position inferred constraints are surfaced uniformly across emit and eval.

-- E6: dict-name set for the `=>`-constrained-function layer, mirroring the
-- single-file emit driver's assembly (llvm_emit_typed_main.runEmit): prelude
-- return- AND arg-position `=>`-constrained fns (clamp/debugListItems/…) plus the
-- modules' own constrained signatures.  Computed on every path (single elaboration
-- mode).
-- Used to MARK constrained-fn call sites EDictAt in the prePass (so the caller
-- supplies the dict ARGUMENT) AND to add the leading dict PARAM in the final
-- dictPass (so the callee body's witness binds).  BOTH halves are required: marking
-- alone under-defines the param; param alone under-applies the call (ABI mismatch).
-- Cause A: promoted (inferred-constraint) user fns join the set.

-- ARGSTAMP-UNIFY Phase 4: the eval-dict layer is now PERMANENTLY active on both
-- paths (flag retired).  Flat elaborateDict runs its resolve chain + dictPass
-- UNCONDITIONALLY; the 1-module / multi-module eval path matches, so method-level
-- constraints (`build : Num e =>`) and parametric-impl `requires` (`impl Default
-- (List a) requires Default a`) — which leave dictNames EMPTY (no top-level
-- constrained FUNCTION) but still need resolveMethodDicts / the DImpl dict-pass —
-- get serviced.  The dictPass/resolve passes are no-ops when nothing was marked, so
-- this leaves the golden eval trees byte-identical where there is nothing to
-- dict-pass.
-- C5: ALSO mark cross-module standalone-shadow method occurrences (box's
-- `toList`/`isEmpty`) as EMethodAt, so they carry a route ref for elabModuleStamp's
-- resolveRLocalSites to stamp RLocal.  Without this they stay EVar (arg-position)
-- → no route ref → arg-tag panic on a no-impl
-- receiver.  Only added to the MARK set (not rpNames proper, which discoverPromoted
-- etc. consume) so other passes are unchanged.
-- DRIVER-COLLAPSE Phase 2: ALSO include methodConstraintNames (methods with their OWN
-- method-level `=>` constraint, e.g. `build : Num e => e -> t`), mirroring flat
-- elaborateDict's prePass mark set (`returnPosMethodNames prog ++ methodConstraintNames
-- prog`).  Without it the method-constraint occurrence stays unmarked → its impl
-- clause's leading method-dict param is dropped/mis-bound → `non-exhaustive match`
-- (method_constraint_impl_offset).

-- impl table accumulates across modules (dependency order): a module's
-- arg-position dispatch can thread an EARLIER module's / core's parametric
-- `requires` element dict.  core2 seeds it.

-- E5: dict-pass each module's now-stamped
-- trees, mirroring elaborateDict's final `dictPass`.  A parametric `requires`
-- impl whose body element-dispatch E5 routed RDict needs its leading
-- `$dict_<m>_<slot>` PARAM (dictPassDecl's DImpl arm) so the emitter can bind the
-- witness the route references; the call site's impl-dict route (filled by
-- resolveArgStamp) supplies the matching ARGUMENT.  E6: dictNames now carries the
-- prelude/module `=>`-constrained fns (clamp/debugListItems/displayListItems/…),
-- so dictPassDecl's DFunDef arm ALSO prepends their `$dict_<fn>_<slot>` params —
-- closing the "unbound dict witness" residual.  Runs on every path (single
-- elaboration mode); when nothing is marked the pass is a no-op returning
-- core2/modules2 verbatim.

-- E5/E6: final dict-pass of the stamped module trees, on every path.
-- [dictNames] is the prelude + module `=>`-constrained fn set.
-- E6: each module's typecheck calls resetState, which clears funConstraintsRef,
-- so by this final pass only the LAST module's constraint arities survive — a
-- core-level constrained fn like `clamp` would get `dictArityOf` = 0 and NO leading
-- param.  Re-seed funConstraintsRef from every constrained signature (core +
-- modules) so dictPassDecl's DFunDef arm prepends the right number of
-- `$dict_<fn>_<slot>` params.  Only the COUNT is read here (the body's EDictAt/RDict
-- routes were already stamped, with real ids, during each module's own pass), so a
-- placeholder id list of the correct length is sufficient.  Prepended → wins the
-- lookupAssocSL2 first-match over any stale last-module entry.  (Golden module
-- drivers never reach elaborateModules, so their trees are untouched.)
-- Step 4 (Phase-134 fix): per-module importer-scoped arity, mirroring the oracle
-- eval.ml:2104-2164 collect_arities-per-scope.  The pre-fix JOINT
-- seedDictAritiesFromSigs keyed arity by BARE NAME, so a constrained fn in module A
-- forced spurious leading dict params onto an unconstrained same-named fn in module
-- B (whose call sites then under-applied → silent partial closure).  Core
-- (≈ the oracle's prelude) is imported by every module, so it keeps the FULL joint
-- scope.  Each module's scope = its own decls ∪ the decls of its transitive
-- importers ∪ core (the importer part covers a PUBLIC constrained fn referenced only
-- by its importers; mangleUnits already de-collided PRIVATES).  promotedC = the
-- joint-discovered promoted-fn arities (unsignatured, so constrainedSigArity misses
-- them) carried across resetState in crossModuleFunConstraintsRef.
dictPassModulesIfEnabled : List String -> List Decl -> List (String, List Decl) -> (List Decl, List (String, List Decl))
dictPassModulesIfEnabled dictNames core2 modules2 =
  let allModDecls = flatMap snd modules2
  let promotedQ = crossRun.value.crossModuleFunConstraintsQualRef.value
  let allMods = namesToSet (map fst modules2) omEmpty
  perRun.value.funConstraintsRef := (scopeArities promotedQ allMods (core2 ++ allModDecls))
  -- 🚨 B-2.2-b1: THE SIDECAR IS CLEARED, NOT LEFT ALONE.  `f` shipped arguing that
  -- writing no companion here is "absence, which is correct"; it is not — FAIL-CLOSED
  -- REQUIRES WRITING `[]`.  `resetState ()` fires at exactly two sites and neither runs
  -- between the last `checkBodyImpl` and this call, so not writing leaves the PREVIOUS
  -- module's entries live: a reader in this phase would get a PRESENT, WRONG `CDPLen`,
  -- resolved by bare-name first-match against a differently-populated table, with no
  -- `CDPUnknown` to trip on.  Empty ⇒ `clampPrefix`'s `None` arm ⇒ `CDPUnknown` ⇒
  -- withhold, which is the honest answer for a table this phase does not repopulate.
  perRun.value.funConstraintDeclaredRef := []
  perRun.value.methodConstraintsRef := (scopeMethodArities crossRun.value.crossModuleMethodConstraintsQualRef.value allMods)
  let core2' = dictPass dictNames core2
  let modules2' = dictPassModulesScoped dictNames promotedQ core2 modules2 modules2
  (core2', modules2')
-- Post-ARGSTAMP-UNIFY (Phase 4): ALWAYS run on every path (single elaboration mode).
-- Emit:
-- the DImpl arm prepends parametric impl-body element-dict params even when no
-- top-level `=>`-constrained FUNCTION is in [dictNames] (e.g. the empty-prelude
-- nested_dict_dispatch fixture: a parametric `Cmp (Box a) requires Cmp a` with no
-- constrained fn).  Eval: same — a parametric-impl `requires` whose DImpl body needs
-- its leading element-dict param (nested_instance_dicts: `impl Default (List a)
-- requires Default a`) gets dict-passed even with no top-level constrained FUNCTION.
-- Mirrors flat elaborateDict's unconditional final dictPass.  No-op when nothing was
-- marked → byte-identical golden trees.  scopeArities sizes each define's leading
-- dict params to its surviving-constraint count.

-- per-module: set funConstraintsRef to the module's importer-scoped arities, then
-- dict-pass that module.  [allModules] is the full set (for the transitive-importer
-- walk); [modules2] is the remaining suffix to process.  core2 is always in scope.
dictPassModulesScoped : List String -> List ((String, String), List Int) -> List Decl -> List (String, List Decl) -> List (String, List Decl) -> List (String, List Decl)
dictPassModulesScoped _ _ _ _ [] = []
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
dictPassModulesScoped dictNames promotedQ core2 allModules ((mid, prog)::rest) =
  let importerDecls = transitiveImporterDecls mid allModules
  let scope = core2 ++ prog ++ importerDecls
  let scopeMods = namesToSet (mid :: transitiveImporterIds mid allModules) omEmpty
  -- IMPORT ALIASING: scopeArities keys arity by the DEFINITION's name, but an aliased
  -- call site in THIS module writes the LOCAL name.  Re-key this module's own aliases
  -- (from its DUse decls) onto the origin's arity, else the aliased call under-applies
  -- its dicts.  This is the RUN/eval path's counterpart to the same fix in
  -- checkModuleFullImpl — the EMIT path never needs it, because private_mangle has
  -- already rewritten `A.name` to the origin's real symbol before this point.
  -- #1425 site 3: re-key the names THIS module declares onto its own qual rows before the
  -- table is handed to `dictPass`.  `scopeArities` reduces `(mid, name)` to a bare name and
  -- throws the module id away, which is where a foreign module's constrained row becomes
  -- this module's phantom dict param; `selfDeclArities` is what puts the identity back for
  -- the one set of names this module can answer authoritatively — its own.
  let _ = setRef perRun.value.funConstraintsRef (selfDeclArities mid prog promotedQ
    (aliasConstraintEntries prog promotedQ ++ scopeArities promotedQ scopeMods scope))
  -- B-2.2-b1: cleared for the same reason as in `dictPassModulesIfEnabled` — a stale
  -- prefix table is worse than an empty one, because only the empty one answers
  -- `CDPUnknown`.
  perRun.value.funConstraintDeclaredRef := []
  perRun.value.methodConstraintsRef := (scopeMethodArities crossRun.value.crossModuleMethodConstraintsQualRef.value scopeMods)
  (mid, dictPass dictNames prog) :: dictPassModulesScoped dictNames promotedQ core2 allModules rest

-- the arity table for a scope: every `=>`-constrained signature in [scope]
-- (constrainedSigArity) PLUS the joint-discovered promoted-fn arities whose fn is
-- DEFINED in [scope] (so a promoted fn out of scope doesn't leak a param count in).
-- #55: the signature count (`constrainedSigArity`) is the SYNTACTIC `=>`-constraint
-- count; the INFERRED count in [promotedC] (crossModuleFunConstraintsRef, the
-- surviving generalized constraint vars from each body's inference) is what every
-- CALL site computes (constraintMonosOf over the call's instantiated scheme).  These
-- diverge for a point-free fn whose body MONOMORPHIZES a constraint var — e.g.
-- `sum = fold (+) 0`: the `0` literal is typed `Int` (litType), pinning `Num a`'s `a`
-- to `Int`, so `a` is NOT generalized → the scheme keeps only `Foldable t` (1
-- constraint) while the signature still lists 2.  If the define were sized off the
-- 2-count sig it would take 2 leading dict params while call sites pass 1 (dict +
-- container) → the container arg lands in an unpassed register → garbage deref /
-- SIGSEGV at -O2.  So for a fn WITH an inferred entry, the inferred arity WINS (drop
-- its sig entry); the sig count is the fallback for fns the body-inference path never
-- registered (unreached/never-called constrained fns).  `elem` is unaffected: both
-- its `Eq a` and `Foldable t` vars survive (no literal pins them) → inferred == sig == 2.
-- WS-2/D2: [promotedQ] is the module-attributed inferred arities
-- (crossModuleFunConstraintsQualRef); [scopeMods] is the set of module ids in this
-- dict-pass scope (this module ∪ its transitive importers ∪ "" for core, which is in
-- every scope).  An inferred entry survives when its fn NAME is in scope (as before).
-- For the SUBSET of names that collide (same bare name from ≥2 modules), prefer the
-- entry whose OWNING module is in scope — that disambiguation is the WS-2/D2 fix.
-- A non-colliding name, or a colliding name with NO in-scope-module entry, keeps the
-- old bare behavior (every same-name entry retained; first-match downstream).  This
-- is intentionally minimal: it changes arity ONLY for the cross-module bare-name
-- collision, so non-colliding programs (every golden) are byte-identical.
-- Reduces the qualified entries to the bare (name,ids) form downstream readers expect.
scopeArities : List ((String, String), List Int) -> OrdMap Unit -> List Decl -> List (String, List Int)
scopeArities promotedQ scopeMods scope =
  let scopeNames = namesToSet (declTopFnNames scope) omEmpty
  let nameInScope = filterList (e => omHasKey (snd (fst e)) scopeNames) promotedQ
  -- names that have at least one in-scope-module entry → drop their out-of-scope-module twins
  let resolvedNames = namesToSet (map (e => snd (fst e)) (filterList (e => modInScope (fst (fst e)) scopeMods) nameInScope)) omEmpty
  let inferredQ = filterList (e => modInScope (fst (fst e)) scopeMods || not (omHasKey (snd (fst e)) resolvedNames)) nameInScope
  let inferred = map (e => (snd (fst e), snd e)) inferredQ
  let inferredNames = namesToSet (map fst inferred) omEmpty
  let sigEntries = filterList (e => not (omHasKey (fst e) inferredNames)) (flatMap constrainedSigArity scope)
  inferred ++ sigEntries

-- ── #1425 / #1351: a module's OWN declarations take their arity from their OWN row ──
-- A bare-name arity table cannot say WHOSE `f` an entry is.  When two modules each declare
-- a top-level `f` — one `=>`-constrained, one not — the graph-wide bare accumulator carries
-- only the CONSTRAINED one's row, because an unconstrained binding contributes none at all.
-- So the unconstrained module's OWN `f` is sized with the OTHER module's dict arity: its
-- `define` takes a phantom dict parameter that its call sites never pass, and the argument
-- lands in the dict slot.  Which of the two import orderings breaks is decided by the order
-- of two `import` lines, because that decides the topological order the bare accumulator is
-- grown in — a wrong answer selected by source-file layout.
--
-- ⚠️ THIS IS THE CASE `scopeArities`' OWN in-scope-preference CANNOT REACH, and it is why
-- that preference is not enough on its own.  Its ladder prefers "an entry whose owning
-- module is in scope", and an unconstrained binding HAS NO ENTRY — it can never win a
-- preference it does not enter.  Worse, `scopeMods` is the IMPORTER direction (`mid` ∪ the
-- modules that transitively import it), so a foreign definer is never "in scope" and its row
-- survives by the `not (omHasKey … resolvedNames)` arm precisely when it is most wrong.
--
-- The repair supplies the DECLARATION's identity where it is already available and nowhere
-- else.  For each name THIS module declares at top level, the entry is THIS module's
-- `(mid, name)` qual row — and ABSENT when there is none, which is the accurate reading of
-- an unconstrained binding, not a missing fact: `declaredConstraintFor`'s `None` arm already
-- reads a qual miss for a known import exactly that way ("a MISS for a known import means
-- 'no constraint', not 'look elsewhere'"), and this is the same discipline applied to the
-- module's own declarations instead of to its imports.  A name the module does NOT declare
-- keeps the incoming table's answer byte-identical, so a program with no same-name collision
-- across modules is unaffected.
--
-- ⚠️ FAILS CLOSED ON ABSENT IDENTITY.  `mid == ""` is the "no module id" sentinel of the
-- loader-less drivers (single-file `check`, lsp, repl, doc); there the incoming table is
-- returned untouched, i.e. today's behaviour.  A supply that turned absence into a dropped
-- dict would be a severity increase, and absence is common on those paths by construction.
--
-- Keyed on `elaborateModules`' OWN inputs — the module's decls and the qual accumulator,
-- both already in hand at every site that calls this — never on which driver invoked it.
selfDeclArities : String -> List Decl -> List ((String, String), a) -> List (String, a) -> List (String, a)
selfDeclArities mid prog qual bare =
  if mid == "" then bare
  else
    let own = namesToSet (declTopFnNames prog) omEmpty
    selfQualEntries mid own qual
      ++ filterList (e => not (omHasKey (fst e) own)) bare

-- ── the other half of `selfDeclArities`, and it is NOT optional ──────────────
-- `selfDeclArities` is a per-module VIEW; the ref it is written to is ALSO the ref the
-- cross-module accumulator is snapshotted FROM at the end of the same body
-- (`crossModuleFunConstraintsRef` ← `perRun.funConstraintsRef`).  Without this restore the
-- view becomes a graph-wide LOSS: the rows masked while checking module `mid` never reach
-- the modules processed after it.
--
-- 🚨 MEASURED, not hypothetical — this is what the first cut of #1425's fix did.  Masking
-- `count` while checking `mut_array` (which declares an unconstrained `count`) deleted the
-- PRELUDE's constrained `count` row from the accumulator, so every later module lost it and
-- an ordinary `count (x => x > 1) [1, 2, 3]` in the entry panicked at `run`.  Prelude names
-- are the ones that expose it, because `importDefinersOf` skips `core` — a prelude name is
-- never an "explicit import", so it can only ever be answered by this bare table.
--
-- Restores by NAME from the accumulator's own previous value (still unwritten at the
-- snapshot, which is this ref's only writer), appended AFTER the module's rows so
-- first-match still prefers the identity-resolved answer.  Content-preserving: the view
-- removed exactly these rows, so appending them back is not duplication.
selfNameRows : List Decl -> List (String, a) -> List (String, a)
selfNameRows prog old =
  let own = namesToSet (declTopFnNames prog) omEmpty
  filterList (e => omHasKey (fst e) own) old

-- this module's own qual rows, reduced to the bare (name, payload) shape readers expect.
selfQualEntries : String -> OrdMap Unit -> List ((String, String), a) -> List (String, a)
selfQualEntries mid own qual = map
  (e => (snd (fst e), snd e))
  (filterList (e => fst (fst e) == mid && omHasKey (snd (fst e)) own) qual)

-- WS-2/D2 method analog of scopeArities, WITHOUT the sig-fallback: every method-level
-- constraint is registered during its interface module's typecheck
-- (registerMethodConstraints over ifaceMethodSchemes), so there is no
-- unsignatured-promoted residual to seed from signatures.  No method-name scope filter
-- either: keep every entry whose bare method name does NOT collide across modules (so a
-- method whose impl lives in a different module than its interface is never dropped),
-- and for the SUBSET of names that DO collide, prefer the entry whose owning (interface)
-- module is in [scopeMods] — the bare-name disambiguation.  Non-colliding programs keep
-- every entry → the per-scope methodConstraintsRef is identical to the bare accumulated
-- table → byte-identical method dict-pass (every existing fixture, and the fixpoint).
scopeMethodArities : List ((String, String), List Int) -> OrdMap Unit -> List (String, List Int)
scopeMethodArities promotedMQ scopeMods =
  let resolvedNames = namesToSet (map (e => snd (fst e)) (filterList (e => modInScope (fst (fst e)) scopeMods) promotedMQ)) omEmpty
  let kept = filterList (e => modInScope (fst (fst e)) scopeMods || not (omHasKey (snd (fst e)) resolvedNames)) promotedMQ
  map (e => (snd (fst e), snd e)) kept

-- core (mid "") is in every scope; otherwise membership in the scope-module set.
modInScope : String -> OrdMap Unit -> Bool
modInScope mid scopeMods = mid == "" || omHasKey mid scopeMods

-- attribute each fn DEFINED in [prog] that carries a per-fn table entry to [mid] —
-- the source-exact `(mid, name)` key every cross-module fn table is read under.
--
-- Used for all three of the fn-side qual snapshots: the constraint ARITIES
-- (`funConstraintsRef`), the slot-parallel IFACES (`funConstraintIfacesRef`) and, since
-- B-2.2-f (#1113), the per-entry DECLARED-PREFIX scalar.  It was two byte-identical
-- monomorphic copies (`attributeModuleArities` / `attributeModuleArrIfaces`), each
-- carrying a `rule-duplicate-body` disable deferred to #1201; the sidecar's SCALAR
-- payload does not fit a `List X` signature at all, so the payload is now `a` and both
-- disables are gone rather than joined by a third.
attributeModuleEntries : String -> List Decl -> List (String, a) -> List ((String, String), a)
attributeModuleEntries mid prog entries =
  let progNames = namesToSet (declTopFnNames prog) omEmpty
  map
    (e => ((mid, fst e), snd e))
    (filterList (e => omHasKey (fst e) progNames) entries)

-- #1114 (#845): attribute each TOP-LEVEL binding of [prog] that carries a
-- `schemeObligationsRef` entry to [mid], source-exactly keyed `(mid, name)` — the same
-- key discipline as `attributeModuleEntries` above, and for the same #739 reason (a
-- bare-name cross-module table misattributes a same-named export of another module).
--
-- ⚠️ Unlike the arity tables, `schemeObligationsRef` is keyed `(name, binding-id)` and
-- holds LOCAL/`where` binders too (registerSchemeObligations is called from the local
-- sites with `omEmpty` member ids, so those key under id 0).  Two filters make the
-- projection to a bare exported name safe:
--   (1) [progNames] keeps only names this module defines at TOP LEVEL, so a `where`
--       helper whose name matches nothing at top level never enters the table at all;
--   (2) FIRST-occurrence-wins within a name, which resolves the one residual case — a
--       `where` helper that happens to SHARE a top-level name.  `schemeObligationsRef`
--       is consed, and a group's top-level members are registered AFTER the locals
--       inferred inside their bodies, so the head-most entry for a name is the
--       top-level one.  That is byte-identically the policy the SAME-module use site
--       already applies (`lookupSchemeOblsByName`'s first match), which is the point:
--       an importer must see what a same-module caller sees.
--
-- 🚨 A MODULE'S CONTRIBUTION IS WHAT IT DECLARES *PLUS WHAT IT RE-EXPORTS*, and the second
-- half is not optional — it is the recurrence `.claude/workstreams/TYPECHECK.md` records for
-- #1283 and `renameAliasedMethods` (below) already learned for the METHOD tables: "the
-- decl's origin names the DECLARING module and the import path names the RE-EXPORTER, so
-- the identity test misses."  Attributing only `declTopFnNames prog` means a pure
-- re-exporter (`export import lib.def.{f}`, whose `prog` has no function definitions at
-- all) contributes NOTHING, so `import lib.reexp.{f}` found no entry and #845's whole
-- failure came back one hop out — `check` 0, `build` 0, and the built binary SEGFAULTED.
-- Adversarial review produced exactly that program; this arm is the answer to it.
--
-- [qual] is the ALREADY-ACCUMULATED cross-module table, and dependency-first module order
-- is what makes reading it correct here: every module this one re-exports FROM has been
-- processed already, so its entries are present. That also makes a multi-hop chain resolve
-- without special-casing — each hop re-attributes under its own mid as it is processed,
-- exactly as `reexportedMethodNames` folds the method sets.
--
-- Re-export entries come SECOND so the module's own top-level binding wins the first-match
-- dedup below if a module somehow both defines and re-exports one name.
attributeModuleSchemeObls : String -> List Decl -> List ((String, String), List VecObl) -> List ((String, Int), List VecObl) -> List ((String, String), List VecObl)
attributeModuleSchemeObls mid prog qual entries = attributeSchemeOblsGo mid (namesToSet (publicValNames prog) omEmpty) omEmpty entries
  ++ map (e => ((mid, fst e), snd e)) (reexportSchemeOblEntries prog qual)

-- ⚠️ The export test is `publicValNames`, the module's own canonical one — NOT a
-- hand-rolled `DFunDef True` scan.  A first cut used the latter and REGRESSED two of this
-- PR's own fixtures: `export g : Num a => a -> a` on one line with `g x = x + 1` on the
-- next parses as a PUBLIC `DTypeSig` plus a PRIVATE `DFunDef`, so a scan that only reads
-- the `DFunDef` flag calls an exported binding private and drops it from the store.
-- `publicValNames` already answers this (its `DTypeSig True` arm), and reusing it is what
-- keeps this table's notion of "exported" from drifting from the module seed's.

-- the scheme contexts a module RE-EXPORTS (`export import src.{…}` / `export import src.*`),
-- each under the name it re-exports it as.  Reuses `schemeOblEntriesFor` — the same
-- spelling table the IMPORT side uses — so re-export and import can never disagree about
-- what a spelling binds; that is one table, not two kept in step by hand.
-- ⚠️ `export import src as A` contributes entries keyed `A.<name>`, which no importer of
-- THIS module can name (an alias is local to the file that writes it).  They are inert
-- rather than wrong, and excluding them would mean a second spelling table.
reexportSchemeOblEntries : List Decl -> List ((String, String), List VecObl) -> List (String, List VecObl)
reexportSchemeOblEntries [] _ = []
reexportSchemeOblEntries ((DAttrib _ d)::rest) qual = reexportSchemeOblEntries [d] qual
  ++ reexportSchemeOblEntries rest qual
reexportSchemeOblEntries ((DUse True path _)::rest) qual = schemeOblEntriesFor (usePathModuleId path) path qual
  ++ reexportSchemeOblEntries rest qual
reexportSchemeOblEntries (_::rest) qual = reexportSchemeOblEntries rest qual

attributeSchemeOblsGo : String -> OrdMap Unit -> OrdMap Unit -> List ((String, Int), List VecObl) -> List ((String, String), List VecObl)
attributeSchemeOblsGo _ _ _ [] = []
attributeSchemeOblsGo mid progNames seen (e::rest)
  | not (omHasKey (fst (fst e)) progNames) =
    attributeSchemeOblsGo mid progNames seen rest
  | omHasKey (fst (fst e)) seen = attributeSchemeOblsGo mid progNames seen rest
  | otherwise = ((mid, fst (fst e)), snd e) :: attributeSchemeOblsGo mid progNames (omInsert (fst (fst e)) () seen) rest

-- WS-2/D2 method analog: attribute each method whose INTERFACE is declared in [prog]
-- (carrying a methodConstraintsRef entry) to [mid].  Keyed by the interface's module —
-- the arity is a property of the method signature, registered during that module's
-- ifaceMethodSchemes pass.
attributeMethodModuleArities : String -> List Decl -> List (String, List Int) -> List ((String, String), List Int)
attributeMethodModuleArities mid prog entries =
  let progMethods = namesToSet (allIfaceMethodNames prog) omEmpty
  map
    (e => ((mid, fst e), snd e))
    (filterList (e => omHasKey (fst e) progMethods) entries)
-- membership-only sets (built once) instead of O(N) contains scans per entry:
-- scopeNames (~all top-level fn names) was scanned per promotedC entry → O(N²).

declTopFnNames : List Decl -> List String
declTopFnNames decls = map fst (funDefs decls)

-- the decls of every module that transitively imports [mid] (excluding [mid]),
-- so a public constrained/promoted fn defined in [mid] but referenced only by an
-- importer is in scope when [mid] is dict-passed.
transitiveImporterDecls : String -> List (String, List Decl) -> List Decl
transitiveImporterDecls mid modules = flatMap
  (p => if fst p /= mid && transitivelyImports (fst p) mid modules then snd p else [])
  modules

-- the module IDS that transitively import [mid] (excluding [mid]) — the id-level
-- analog of transitiveImporterDecls, for the scopeArities owning-module set.
transitiveImporterIds : String -> List (String, List Decl) -> List String
transitiveImporterIds mid modules = flatMap
  (p => if fst p /= mid && transitivelyImports (fst p) mid modules then [fst p] else [])
  modules

-- does module [a] transitively import module [target]?
transitivelyImports : String -> String -> List (String, List Decl) -> Bool
transitivelyImports a target modules = depReaches [] a target modules

depReaches : List String -> String -> String -> List (String, List Decl) -> Bool
depReaches seen a target modules
  | contains a seen = False
  | otherwise =
    let deps = directImports a modules
    contains target deps || anyDepReaches (a::seen) deps target modules

anyDepReaches : List String -> List String -> String -> List (String, List Decl) -> Bool
anyDepReaches _ [] _ _ = False
anyDepReaches seen (d::rest) target modules = depReaches seen d target modules
  || anyDepReaches seen rest target modules

-- the module ids module [mid] imports directly (from its DUse decls), mirroring the
-- oracle's path→module-id mapping (last component of a dotted UseName, else the path).
directImports : String -> List (String, List Decl) -> List String
directImports mid modules = match lookupAssoc mid modules
  Some prog => flatMap useModuleId prog
  None => []

useModuleId : Decl -> List String
useModuleId (DUse _ path _) = [usePathModuleId path]
useModuleId _ = []

usePathModuleId : UsePath -> String
usePathModuleId (UseName ns)
  | listLen ns > 1 = joinDot (initList ns)
  | otherwise = lastComponent ns
usePathModuleId (UseGroup ns _) = joinDot ns
usePathModuleId (UseWild ns) = joinDot ns
usePathModuleId (UseAlias ns _) = joinDot ns

lastComponent : List String -> String
lastComponent [] = ""
lastComponent [x] = x
lastComponent (_::rest) = lastComponent rest

-- E6: the `=>`-constrained-function dict-name set for the module emit path,
-- mirroring the single-file driver (llvm_emit_typed_main.runEmit): prelude return-
-- AND arg-position constrained fns (clamp/debugListItems/displayListItems/…) plus
-- every module's own constrained signatures.  Both eval and emit paths return the
-- same set; guarded so prePass/dictPass both see the SAME set.
moduleDictNames : List Decl -> List Decl -> List (String, List Decl) -> List String
moduleDictNames coreDecls allDecls modules = preludeReturnPosDictNames coreDecls allDecls
  ++ preludeArgPosDictNames coreDecls allDecls
  ++ constrainedSigNames (flatMap snd modules)
-- EVAL path: even with arg-position stamping OFF, the constrained prelude/module
-- fns MUST be dict-passed.  DRIVER-COLLAPSE Phase 2: the MODULE part now uses the
-- FULL constrainedSigNames (every `=>`-constrained module signature), mirroring flat
-- elaborateDict's caller (constrainedSigNames userDecls) — NOT the return-position
-- subset.  Rationale: dictPass adds a leading dict PARAM to every fn whose
-- constrained signature is in scopeArities (all constrained sigs), so the prePass
-- MARK set must match or a fn like `quad : Monoid a => a -> a` (body calls another
-- constrained fn, NOT a return-position method directly) gets the PARAM but its call
-- sites are unmarked → `unbound identifier: $dict_quad_0`.  The PRELUDE part stays
-- return-position-only (preludeReturnPosDictNames): arg-position prelude helpers
-- (neq/elem/clamp) keep arg-tag dispatch in ceval and sweeping them in re-triggers
-- the prop-shrinker `neq`-hang.  User modules have no such hazard (flat already
-- dict-passes their full constrained set).  #55 background: their bodies route a
-- return-position method (`fromInt`/`pure`) RDictFwd `$dict_<fn>_<slot>` during the
-- per-module typecheck (registerConstraintRegs ungated); with no leading dict PARAM
-- the witness is unbound.  The OCaml oracle's eval_modules dict-passes
-- prelude+modules unconditionally; this mirrors that.
-- ARGSTAMP-UNIFY Phase 1 (F10 dict-set convergence): the eval branch now ALSO
-- includes preludeArgPosDictNames, matching the emit branch's dict-name set.
-- First convergence step toward flipping eval to full dict-threading.  By itself
-- OUTPUT-invariant: an arg-position prelude fn that is ALSO arg-tag-dispatchable
-- gets a redundant (not wrong) dict pass.  NOTE the historical neq-hang risk
-- (prop-shrinker oscillation when neq/elem/any/… were swept into the eval dict
-- set); guarded by the `medaka test stdlib/core.mdk` canary.

constrainedSigArity : Decl -> List (String, List Int)
constrainedSigArity (DTypeSig _ n ty)
  | isConstrainedTy ty = [(n, zerosL (listLen (sigConstraints ty)))]
  | otherwise = []
constrainedSigArity _ = []

zerosL : Int -> List Int
zerosL k
  | k <= 0 = []
  | otherwise = 0 :: zerosL (k - 1)

prePassModulePair : List String -> (String, List Decl) -> (String, List Decl)
prePassModulePair rpNames (mid, prog) = (mid, prePassDict rpNames [] prog)

-- E4/E6: prePass a module rewriting ARG-position method occurrences to EMethodAt
-- (argNames) AND `=>`-constrained-fn occurrences to EDictAt (dictNames); both
-- populated on every path (single elaboration mode).  Degenerates to
-- prePassModulePair when both are [] (prePassDictArg with empty argNames/dictNames
-- == prePassDict).
-- #1354 unit A (#1353): [shadowNames] (the graph-wide standalone-shadow set) and
-- [argNames] (every interface method with a dispatch argument index, graph-wide) are BOTH
-- decided over the whole loaded graph and BOTH consumed here, per module — so an interface
-- the module cannot name still rewrote its occurrences of a same-named imported standalone
-- to `EMethodAt`, and dispatch then answered from an impl the module has no path to.  Both
-- are filtered to `SHADOW-SEMANTICS.md` S1's `nameable in M` (§1.0; ruling #1375) using the
-- module's own decls, which are exactly what this function already has in hand.
--
-- This is the RUN/BUILD half of the fix; `checkBodyImpl`'s `definerShadows`/
-- `importerShadows` are the CHECK half.  Neither is sufficient alone — the mark pass
-- rewrites the occurrence before typecheck ever consults `standaloneValuesRef`, so
-- filtering only there leaves `check` right and the binary wrong (the S7 divergence #1375
-- warns a mark-pass-only fix introduces, with the arms swapped).
--
-- [shadowMap] is filtered too, and THAT is the arm the emit path actually takes: the
-- mangler rewrites an imported `size` occurrence to `fmod__size`, so neither name set above
-- can match it and `rewriteArgScoped`'s FIRST guard — the `sm` lookup — is what marks it.
-- Filtering it here, at the CONSUMING module, is the placement #1375 requires: the map is a
-- PRODUCER-side index (`computeMangledShadowMap` walks the unit that DEFINES the
-- standalone), and keying its visibility on that definer instead fails CLOSED and reddens
-- the corpus's `i1`/`i3`/`i8`/`i10` — the provider module does not import the consumer
-- where the interface lives (the #411 shape).  Same reason [shadowNames] is scoped through
-- `shadowBareName`: on the emit path `buildStandaloneShadowsGraph` returns MANGLED symbols,
-- and testing a mangled symbol against a set of METHOD names would answer False for every
-- legitimate shadow.
--
-- [dictNames] is the ONE input NOT filtered: those are `=>`-constrained FUNCTION names, not
-- interface methods, and dropping one under-applies a dict-passed callee (`unbound
-- identifier: $dict_…`) — the Phase-134 shape.
--
-- ⚠️ [rpNames] **IS** FILTERED, by the same predicate as everything else here — read the
-- `otherwise` arm below, which is four `filterList`s and one bare `dictNames`.  The split
-- that makes the per-module filter possible is at `markSharedNames`.  This paragraph read
-- *"[rpNames] is not filtered either"* until 2026-08-08: introduced and falsified by the
-- same PR, and then missed by the very commit whose job was retiring that claim at its
-- sibling site.  It was the THIRD copy of the sentence.  Nothing in this tree links a claim
-- to the code it describes, so when one of these turns out to be false, check the SET of
-- sites that assert it — not the one you were handed.
prePassModulePairArg : List String -> List String -> List String -> List String -> List (String, String) -> (String, List Decl) -> (String, List Decl)
prePassModulePairArg rpNames shadowNames dictNames argNames shadowMap (mid, prog)
  -- fail OPEN when the graph index is absent, for the reason stated on
  -- `nameableIfaceShadows`: an unscoped mark set is today's behaviour, an empty one is the
  -- S4/#410 class.
  -- ⚠️ GUARD THE REF THIS ACTUALLY READS.  It used to test `graphMethodExportsRef` while the
  -- body reads `graphIfaceMethodsRef` — an implicit conjunction ("they are written on
  -- adjacent lines") of exactly the kind the `registry_keying_ratchet` row beside it exists
  -- to forbid.  If the two ever diverged this arm would run with an EMPTY iface index and
  -- filter out every imported and prelude shadow name, failing CLOSED into the S4/#410 class
  -- that `nameableIfaceShadows` says must never happen.
  | omSize driverState.value.graphIfaceMethodsRef.value == 0 =
    (mid, prePassDictArg (dedup (rpNames ++ shadowNames)) dictNames argNames shadowMap prog)
  | otherwise =
    -- 🔒 S1-NS (b), THE CLOSURE INVARIANT.  The spec requires the predicate deciding
    -- SHADOW-HOOD to be a SUPERSET of the one deciding DISPATCH ELIGIBILITY, and rules two
    -- different predicates at the two sites non-conformant WHICHEVER WAY THEY DIFFER.
    --
    -- 🚨 THE INVARIANT IS ABOUT INPUTS TO DISPATCH, NOT ABOUT SETS OR SELECTORS, AND
    -- COUNTING THE WRONG THING SHIPPED AN S0.  An earlier revision of this comment said
    -- "there is exactly ONE predicate here … the two sets are EQUAL … the gap is
    -- unrepresentable" — and was false four lines above itself, because `rpNames` was
    -- concatenated RAW into the first argument while the other three lists were filtered.
    -- `rewriteArgScoped` dispatches on `rp`, `an` AND `sm`, so dispatch-eligibility was
    -- `rpNames ∪ filtered(…)` — a strict superset of shadow-hood, which is S1-NS's own
    -- "Newly NON-CONFORMANT (1)".  Measured: a return-position method of a non-nameable
    -- interface gave `run` 777 against a built binary of 42, both exit 0, no diagnostic.
    --
    -- THE ENUMERATION, so the next reader checks the SET rather than trusting a sentence.
    -- Every input `rewriteArgScoped` can turn into an `EMethodAt` is filtered here:
    --   * `rpNames`   — return-position method names AND method-level-constraint method
    --                   names (`markSharedNames` concatenates both).  BOTH are interface
    --                   METHOD names — each walks `DInterface`'s `methods` — so both are the
    --                   same kind of set as `argNames` and both are filtered.
    --   * `shadowNames` — via `shadowBareName`, because on the emit path these are mangled.
    --   * `argNames`  — arg-position dispatch indices.
    --   * `shadowMap` — the emit-path peer of `argNames`.
    -- `dictNames` is the ONE input deliberately NOT filtered, and it is not an input to
    -- dispatch at all: it produces `EDictAt`, a dict application of a `=>`-constrained
    -- FUNCTION, which selects no impl from a receiver.  Filtering it would drop a dict
    -- argument and UNDER-APPLY the callee (`unbound identifier: $dict_…`, the Phase-134
    -- shape) — so it is disjoint by node kind, not by name, and that is probed rather than
    -- argued (see `test/shadow_fixtures/`'s return-position cells and the PR body).
    let nameable = nameableIfaceMethodSet prog
    let keep = (n => omHasKey n nameable)
    (
      mid,
      prePassDictArg
        (dedup (filterList keep rpNames
          ++ filterList (n => omHasKey (shadowBareName shadowMap n) nameable) shadowNames))
        dictNames
        (filterList keep argNames)
        (filterList (e => omHasKey (snd e) nameable) shadowMap)
        prog,
    )

-- the BARE interface-method name a (possibly mangled) standalone-shadow symbol stands for.
-- Identity on the un-mangled run/check path, where the map is empty.
shadowBareName : List (String, String) -> String -> String
shadowBareName sm n = match lookupAssoc n sm
  Some bare => bare
  None => n

-- The mark sub-phase of elaborateModules (RKey-only): compute rpNames over the
-- full module graph and prePassDict each module.  Exported so profiling drivers
-- can bracket the mark phase vs the typecheck phase separately.
export
markModules : List Decl -> List (String, List Decl) -> (List Decl, List (String, List Decl))
markModules coreDecls modules =
  let rpNames = returnPosMethodNames (coreDecls ++ flatMap snd modules)
  let core2 = prePassDict rpNames [] coreDecls
  let modules2 = map (prePassModulePair rpNames) modules
  (core2, modules2)

-- typecheck one module (seeded like checkModuleFull) AND immediately stamp the
-- EMethodAt route refs it just recorded.  checkModuleFull's resetState clears
-- pendingSites before inference, so on return pendingSites holds exactly THIS
-- module's sites; the tyvar cells are still bound (the next module's resetState
-- hasn't run yet), so resolveSites reads each site's resolved result type.
-- E4: ALSO stamp this module's ARG-position sites
-- (pendingArgStamps, likewise this-module-only after resetState) from their now-
-- resolved discriminating-argument monos — the multi-module analogue of
-- elaborateDict's resolveArgStamps.  [implDecls] is core + every EARLIER module +
-- this module, so a cross-module parametric `requires` element dict resolves; a
-- still-unresolvable case stays RNone (arg-tag fallback).  activeDictVars (the
-- constraint-var → dict-param map registerConstraintRegs built in checkModuleFull)
-- is also still bound, so a tyvar receiver routes RDict.
elabModuleStamp : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> List (String, Scheme)
-- multi-line RHS: the indented `:=` form is legal but not seed-parseable yet (#1744)
-- lint-disable-next-line rule-prefer-assign-op
elabModuleStamp mid seedVars accData implDecls prog =
  let _ = driverState.value.superDeclsRef := implDecls  -- WS-1b: interfaces in scope for super expansion
  let schemes = checkModuleFullImpl mid seedVars accData implDecls prog
  let _ = setNumlitFloats ()  -- PLAN.md #11: stamp Float-typed int literals (per module, before dictPass)
  let stampImplTable = buildImplTable implDecls
  let _ = resolveSites stampImplTable (returnPosMethodNames implDecls) perRun.value.pendingSites.value
  let _ = resolveOpSites True stampImplTable perRun.value.pendingBinopSites.value
  let _ = resolveOpSites False stampImplTable perRun.value.pendingUnopSites.value
  let _ = resolveArithSites perRun.value.pendingArithSites.value
  let _ = resolveArgStamps stampImplTable perRun.value.pendingArgStamps.value
  let _ = resolveRLocalSites implDecls stampImplTable perRun.value.pendingRLocalSites.value
  let _ = realizeRecDictApps perRun.value.pendingRecDictApps.value
  let _ = resolveDictApps implDecls stampImplTable perRun.value.dictApps.items.value
  let _ = resolveMethodDicts stampImplTable perRun.value.pendingMethodDicts.value
  schemes
-- DRIVER-COLLAPSE Phase 2: pass the return-position method names (was `[]`) so
-- resolveSite's RDict-case routes a RETURN-position method site RDictFwd (forward the
-- enclosing dict's nested reqs) rather than RDict (arg-position).  Flat elaborateDict
-- passes `returnPosMethodNames prog2`; the empty list mis-stamped a parametric-impl
-- body's inner return-position method (`impl Default (List a) requires Default a where
-- def = [def]` — the inner `def` must be RDictFwd:$dict_def_0, not RDict) → eval
-- `no matching impl for dispatch` (nested_instance_dicts).  `implDecls` is this
-- module's full impl universe (core/earlier-modules ++ prog), the analogue of flat's
-- whole-program `prog2`.

-- Phase 151 / Gap G: stamp this module's comparison-operator binop sites.
-- UNGATED (mirrors flat elaborateDict, which calls resolveBinopSites
-- unconditionally) so the EVAL path also dispatches `==`/`<`/… to user/derived
-- Eq/Ord impls (adt_deriving_ord / record_deriving_ord).  No-op when
-- pendingBinopSites is empty (no comparison-operator site) → golden type-only
-- path leaves them RNone → dictPass-skipped → byte-identical.  Gap #21: binop route
-- stamping emits `RKey key []` (empty element reqs), which only narrows the method
-- VMulti and applies ZERO dicts,
-- so even a RECURSIVE user Eq impl (json's `impl Eq Json`) dispatches inner
-- operands by arg-tag without over-applying — no suppression needed.

-- C5: LAST among the route-stampers (after resolveSites AND resolveArgStamps) so the
-- receiver-grounded RLocal/RNone overrides whatever those stamped on the SAME ref —
-- resolveSites mis-stamps RKey<resultType> (eval path) and resolveArgStamps stamps
-- RKey<receiverHead> (emit path), both wrong for a standalone-shadow site.

-- E6: fill THIS module's `=>`-constrained-fn EDictAt routes (the call sites
-- prePassDictArg marked) so the emitter supplies the matching dict ARGUMENT —
-- realizeRecDictApps for self/mutually-recursive calls, resolveDictApps for the
-- normal ones.  ARGSTAMP-UNIFY Phase 4: unconditional on BOTH paths — the eval path
-- also marks the RETURN-position constrained fns (sum/product/when/unless) EDictAt
-- via moduleDictNames, so their call-site routes must resolve here too.  No-op when
-- nothing was marked (pendingDictApps/pendingRecDictApps empty → golden drivers
-- byte-identical).

-- G7: fill each foldMap-style method occurrence's methRoutes from the monos its
-- `Monoid m` constraint resolved to AT THE CALL SITE (List vs String), so
-- emitDefaultRKey threads the right per-call dict word into the shared default body.
-- Independent of the body-side dict routing (the emitter restamps the body's
-- cross-interface `empty` to its `$dict_<method>_<slot>` param directly).
-- ARGSTAMP-UNIFY Phase 4: run unconditionally on every path (single elaboration
-- mode), mirroring flat elaborateDict (which
-- calls resolveMethodDicts unconditionally) — a method with its OWN method-level
-- constraint (`build : Num e => e -> t`) needs its method-dict route filled so its
-- impl clause binds the leading dict param instead of mis-binding it into the first
-- value param (method_constraint_impl_offset: was `non-exhaustive match`).  No-op
-- when pendingMethodDicts is empty → golden drivers byte-identical.

-- worker: per-module elaboration + route-stamping (elabModuleStamp).  IMPORT-SCOPED
-- seed (see importSeed / foldModules): only the names THIS module's DUse decls
-- import; implDecls (`accAll ++ prog`) is the cumulative impl-body universe.
-- Side-effects mainSchemeRef when this module binds `main` — the entry module (last
-- in dependency order) wins, exactly as the old head-recursive loop.  Payload is
-- Unit; elaborateModules discards foldModules' result and re-reads the stamped trees.
elabWorker : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), Unit)
elabWorker mid seed accData accAll prog =
  let schemes = elabModuleStamp mid seed accData (accAll ++ prog) prog
  let _ = match lookupAssoc "main" schemes
    Some s => driverState.value.mainSchemeRef := Some s
    None => ()
  (schemes, ())

-- #194: elabWorker + harvest.  Runs the identical per-module elaboration, then unions
-- THIS module's directly-promoted fns (promotedRef, populated by
-- registerInferredConstraints inside checkModuleFullImpl's generalization) into
-- promotionHarvestRef.  Timing: elabModuleStamp → checkModuleFullImpl → checkBodyImpl
-- calls resetState (wiping promotedRef) at module START, then registerInferredFor
-- writes this module's promotions; foldModules calls the worker HEAD-first, so this
-- harvest reads the head module's set BEFORE the recursion into `rest` resets it.
elabHarvestWorker : String -> List (String, Scheme) -> List Decl -> List Decl -> List Decl -> (List (String, Scheme), Unit)
elabHarvestWorker mid seed accData accAll prog =
  let result = elabWorker mid seed accData accAll prog
  driverState.value.promotionHarvestRef := dedup (driverState.value.promotionHarvestRef.value ++ perRun.value.promotedRef.value)
  result

schemeLines : List (String, Scheme) -> List String
schemeLines [] = []
schemeLines ((n, s)::rest) = "\{n} : \{ppSchemeNamed n s}" :: schemeLines rest
