-- The typecheck stage: Hindley-Milner inference, interface/impl constraint solving,
-- and dict-passing elaboration.  Architecture doc, including the component model this
-- file is being decomposed towards: `compiler/TYPECHECK-TARGET-ARCHITECTURE.md`.
--
-- The HM core is monotypes over Ref-based union-find tyvars, level-based
-- generalization, unification (occurs-check + level adjust), and instantiation.  On
-- top of it, and NOT deferred elsewhere, this file also carries: interfaces, impls,
-- superclasses and coherence; constraint solving and the dict-passing elaboration the
-- backends consume; effect rows; records; explicit signatures; and operator inference.
-- Exhaustiveness is the one part that lives elsewhere and is still called from here --
-- `checkMatchExhaustive` (`compiler/frontend/exhaust.mdk`), once per `EMatch`
-- ([P-EXHAUST-IN-TYPECHECK]).
--
-- WARNING: TWO DRIVERS, AND THEY ARE NOT THE SAME FUNCTION.  `elaborateModules` /
-- `elaborateOne` are the typed pipeline behind `run`, `build` and `test`; the
-- `check*` family (`checkModulesAllLines`, `checkModuleFullDiags`, `checkToLines`,
-- `checkProgramSchemesWithRuntime`) is what `medaka check`, `check --json`, the LSP,
-- MCP and `test/typecheck_compiler_source.sh` go through.  The `check` family does not
-- run every mark pass the elaborate family runs (`prePassDictArg`'s definer-shadow
-- argument is `[]` on some check paths), so ACCEPTING UNDER ONE DRIVER IS NOT EVIDENCE
-- ABOUT THE OTHER: a program can pass `check` at exit 0 with zero diagnostics and be
-- rejected by `run` and `build`.  That divergence is pinned as a fixture
-- (`test/must_fail_fixtures/1812-alias-import-check-accepts-run-build-reject/`) and its
-- consequence for the gate over this compiler's own source is #1811.  Fix inference
-- behaviour in whichever driver you measured, then check the other.
--
-- History: this began as a prelude-less HM engine validated against the (since removed)
-- OCaml reference compiler.  Both that reference and its `dev/tc_probe.exe` harness are
-- gone; native is the sole compiler.  The remaining probe is
-- `compiler/entries/selfproc_tc_probe.mdk`.

import frontend.ast.{
  Lit(..),
  -- A-3.2b residual (#1512): named ONLY by `aliasFixtureAttribCore`, the doctest
  -- fixture that pins `dataEnvFromDeclsGo`'s deliberate `DAttrib` asymmetry.
  Attr(..),
  Ty(..),
  TyConOrigin(..),
  Ns(..),
  Ident(..),
  mkIdent,
  -- #1111 Stage A-2 unit A-2.10: the ONE type-head comparison every "same
  -- type?" test below is written against.  Its doc-comment derives why an
  -- absent origin makes no claim here while `ifaceIdMatches`/`tabKeyEq` refuse
  -- absence outright — do not copy either shape to the other site.
  sameTyConHead,
  tyConBuiltin,
  firstTyLoc,
  firstTyLocList,
  Constraint(..),
  Route(..),
  Pat(..),
  RecPatField(..),
  Guard(..),
  Arm(..),
  DoStmt(..),
  FunClause(..),
  FieldAssign(..),
  LetBind(..),
  Expr(..),
  Loc(..),
  orElseLoc,
  ConPayload(..),
  Field(..),
  Variant(..),
  IfaceMethod(..),
  MethodDefault(..),
  Require(..),
  Super(..),
  ImplMethod(..),
  DataVis(..),
  Decl(..),
  PropParam(..),
  Section(..),
  InterpPart(..),
  GuardArm(..),
  UsePath(..),
  UseMember(..),
  useMemberOrigin,
  useMemberLocal,
  useMemberAlias,
  qualifiedLocal,
  -- RE-HOMED here from `types/registry.mdk` (oracle-identity family leaf L1):
  -- `frontend/exhaust.mdk`'s constructor oracle keys on `TabKey`, and
  -- `frontend` may not import `types`.  Same six symbols, same bodies; only
  -- the module they are imported from changed.  The RENDERER stays in
  -- `types/registry.mdk` and is still imported from there.
  TabKey(..),
  tabKeyOf,
  tabKeyName,
  lookupTab,
  tabHasName,
}
-- #1111 Stage A-2 unit A-2.3: the TYPE-namespace re-key.  `aliasTableRef` /
-- `dataParamKindsRef` (and their `universe*` cross-run halves) are keyed by
-- `TabKey`, not by a bare `String`.  See `tabKeyOf`'s doc-comment in that
-- module for why these two tables keep the assoc list rather than becoming a
-- `Registry`, and `tyTabKey` below for the miss policy.
-- #1111 Stage A-2 unit A-2.4: the INTERFACE-namespace re-key.
-- `universeIfaceRequiredRef` becomes a `Registry` and `ifaceParamKindsRef` /
-- `universeIfaceParamKinds` become `RegKey`-keyed assoc lists, both minted
-- through `ifaceTabKey` below.  `universeRegisteredIfacesRef` is deliberately
-- NOT re-keyed — see `ifaceRegistered`.
import types.registry.{
  RegKey,
  Registry,
  regKeyOfTab,
  regKeyRender,
  regEmpty,
  regInsertK,
  regLookupK,
}
import frontend.desugar.{mapProg}
import frontend.marker.{localBoundNames}
import frontend.resolve.{
  stampBindingIds,
  stampGraphTyOrigins,
  stampFlatTyOrigins,
  stampDeclOrigins,
  -- #1280: the extern-signature half of the identity supply — see `externSchemes`.
  stampTyOrigins,
  externTyOriginScope,
  noteOriginTrace,
}
