import support.char.{isUpper}
import backend.private_mangle.{mangledName}
import support.scc.{tarjanSCCs}
import support.ordmap.{
  OrdMap,
  omEmpty,
  omInsert,
  omLookup,
  omHasKey,
  omKeys,
  omFromPairs,
  omMapValues,
  omSize,
}
import list.{replicate}
import support.util.{
  listLen,
  lookupAssoc,
  contains,
  endsWith,
  reverseL,
  joinWith,
  joinNl,
  joinDot,
  filterList,
  anyList,
  allList,
  initList,
  isEmptyL,
  isNonEmptyL,
  minI,
  isSome,
