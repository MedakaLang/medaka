-- Sibling tests for `program_facts.mdk`: the bracket nests and restores.
-- `factsNow` outside a bracket panics, and no verb observes a panic in-process, so
-- the restore after a bracket stands in for that arm.

import test.{Expectation, expectEqual, expectAll, expectTrue, expectFalse, fail}
import frontend.ast.{Decl, EvId(..), EvVal(..), EvEntry(..), Route(..)}
import frontend.desugar.{desugar}
import frontend.parser.{parseLocated}
import types.disposition.{emptyDispositionTable}
import types.publish.{EntryOutcome(..)}
import types.program_facts.{
  ProgramFacts(..),
  emptyFacts,
  factsOfChecked,
  factsOfElab,
  factsOfElabWith,
  factsOfElabSources,
  withFacts,
  factsNow,
}
import types.route_key.{
  evIndexEntries,
  evIndexOf,
  evSiteRouteIn,
}
import types.typecheck.{
  defaultDriveInputs, elaborateModules, elaborateModulesWithReport
}
import types.typecheck.{checkedFfiExternTypeNamesModules}
import types.extern_source.{ExternSource(..), ExternProvenance(..)}
import types.runtime_abi_types.{CallableShape(..)}
import support.util.{joinNl}
import types.capability_manifest.{
  EntryKey(..),
  ManifestSelector(..),
  InvocationProtocol(..),
  CapabilityManifest,
}
import types.tc_types.{DriveInputs(..), DriveOutputs(..)}
import driver.main_autoprint.{factsForExecutedTrees, asyncWrapModules}

manifestIdentities : List CapabilityManifest ->
  List (String, String, List String)
manifestIdentities = map (m => (
  (m : CapabilityManifest).request.entry.moduleId,
  (m : CapabilityManifest).request.entry.binding,
  map (a => a.label) m.atoms,
))

test "checked elaborated source and evidence facts preserve frozen manifest identities" =
  let inputs = { defaultDriveInputs |
    diManifestRequests = [
      ExactEntry
        EntryKey { moduleId = "entry", binding = "declared" }
        HostInvocation,
      ExactEntry
        EntryKey { moduleId = "entry", binding = "main" }
        HostInvocation,
    ],
  }
  let (elab, report, outputs) = elaborateModulesWithReport
    inputs
    False
    None
    []
    []
    [
      (
        "entry",
        desugar
          (parseLocated
            """
declared : Unit -> <Clock> Unit
declared _ = ()
main = ()
"""),
      ),
    ]
  let (_, _, _, _, table, _, _) = elab
  let checked = option emptyFacts factsOfChecked report.trChecked
  let sourceFacts =
    factsOfElabSources checkedFfiExternTypeNamesModules outputs elab table
  let expected = [("entry", "declared", ["Clock"]), ("entry", "main", [])]
  expectAll [
    expectEqual expected (manifestIdentities outputs.doManifests),
    expectEqual expected (manifestIdentities checked.pfManifests),
    expectEqual expected (manifestIdentities (factsOfElab elab).pfManifests),
    expectEqual expected (manifestIdentities sourceFacts.pfManifests),
    expectEqual
      expected
      (manifestIdentities (factsOfElabWith [] elab).pfManifests),
    expectEqual
      expected
      (withFacts sourceFacts (_ =>
        manifestIdentities (factsNow ()).pfManifests)),
    expectEqual [] (manifestIdentities emptyFacts.pfManifests),
  ]

routeFacts : ProgramFacts
routeFacts = ProgramFacts {
  pfManifests = [],
  pfEvidence = evIndexOf [EvEntry (EvId "m" 1) (EvOne (RScalar "Int"))],
  pfDispositions = Some emptyDispositionTable,
  pfBinders = None,
  pfEntryOutcome = None,
  pfExternSources = None,
}

isTyped : ProgramFacts -> Bool
isTyped f = isSome f.pfDispositions

routeOf : ProgramFacts -> String
routeOf f = match evSiteRouteIn f.pfEvidence (EvId "m" 1)
  RScalar tag => tag
  _ => "other"

test "withFacts makes its facts current inside the bracket" = expectAll [
  expectTrue (withFacts routeFacts (_ => isTyped (factsNow ()))),
  expectEqual "Int" (withFacts routeFacts (_ => routeOf (factsNow ()))),
]

test "withFacts nests, and each bracket restores the one around it" =
  let seen = withFacts routeFacts (_ =>
    let inner = withFacts emptyFacts (_ => isTyped (factsNow ()))
    (inner, isTyped (factsNow ())))
  expectEqual (False, True) seen

test "sequential brackets are independent" =
  let first = withFacts routeFacts (_ => isTyped (factsNow ()))
  let second = withFacts emptyFacts (_ => isTyped (factsNow ()))
  expectEqual (True, False) (first, second)

test "emptyFacts carries no dispositions and no binders" = expectAll [
  expectFalse (isTyped emptyFacts),
  expectFalse (isSome emptyFacts.pfBinders),
]

-- An interface in one module, its method applied in another: the entry's
-- occurrence is a method-occurrence entry, which only the whole table holds.
twoModuleFacts : ProgramFacts
twoModuleFacts =
  let owner = joinNl [
    "export interface Pick a where",
    "  pick : a -> Int",
    "impl Pick Int where",
    "  pick n = n",
  ]
  let entry =
    joinNl ["import pick_owner.{pick}", "value : Int", "value = pick 41"]
  factsOfElab
    (elaborateModules
      defaultDriveInputs
      []
      []
      (map
        (m => (fst m, desugar (parseLocated (snd m))))
        [("pick_owner", owner), ("pick_entry", entry)]))

isMethodEntry : EvEntry -> Bool
isMethodEntry (EvEntry _ (EvMethod _ _ _ _ _)) = True
isMethodEntry _ = False

test "factsOfElab of a driven two-module program holds its method occurrences" =
  let entries = evIndexEntries twoModuleFacts.pfEvidence
  expectAll [expectTrue (any isMethodEntry entries)]

entryOutcomePrelude : List Decl
entryOutcomePrelude =
  desugar
    (parseLocated
      (joinNl [
        "interface Display a where",
        "  display : a -> String",
        "impl Display Int where",
        "  display _ = \"int\"",
        "println : Display a => a -> Unit",
        "println x = let _ = display x in ()",
      ]))

outcomeFacts : (ProgramFacts, ProgramFacts)
outcomeFacts =
  let (elab, report, _) =
    elaborateModulesWithReport
      { defaultDriveInputs |
        diManifestRequests = [
          ExactEntry
            EntryKey { moduleId = "entry", binding = "main" }
            ExecutedMain,
        ],
      }
      True
      (Some "runMain")
      []
      entryOutcomePrelude
      [("entry", desugar (parseLocated "main = 1"))]
  let (_, _, _, _, table, _, _) = elab
  let checked = match report.trChecked
    Some program => factsOfChecked program
    None => emptyFacts
  (checked, factsOfElabWith table elab)

entryOutcomeExpectation : ProgramFacts -> Expectation
entryOutcomeExpectation facts = match facts.pfEntryOutcome
  Some outcome => expectAll [
    expectFalse outcome.eoMainIsUnit,
    expectFalse outcome.eoMainIsFloat,
    expectFalse outcome.eoMainIsAsync,
    expectFalse outcome.eoMainAsyncPayloadIsUnit,
    expectTrue (isSome outcome.eoAutoPrint),
  ]
  None => fail "facts dropped their entry outcome"

test "checked and elaborated facts preserve the selected entry outcome" =
  let (checked, elaborated) = outcomeFacts
  expectAll [
    entryOutcomeExpectation checked,
    entryOutcomeExpectation elaborated,
  ]

test "physical wrapper adjustment preserves the original frozen invocation" =
  let (checked, _) = outcomeFacts
  let wrapped =
    asyncWrapModules
      EntryKey { moduleId = "async", binding = "runAsyncMain" }
      [("entry", desugar (parseLocated "main = 1"))]
  let adjusted = factsForExecutedTrees checked wrapped
  expectAll [
    expectEqual
      [("entry", "main", [])]
      (manifestIdentities adjusted.pfManifests),
    expectEqual
      (manifestIdentities checked.pfManifests)
      (manifestIdentities adjusted.pfManifests),
    expectEqual
      (Some (True, False, False))
      (map
        (outcome => (
          outcome.eoMainIsUnit,
          outcome.eoMainIsFloat,
          isSome outcome.eoAutoPrint,
        ))
        adjusted.pfEntryOutcome),
  ]

test "source-aware checked facts retain module ownership and checked alias heads" =
  let (elab, _, outputs) = elaborateModulesWithReport
    defaultDriveInputs
    False
    None
    []
    []
    [
      (
        "a",
        desugar
          (parseLocated
            "type Number = Int\nextern shared : Number -> <FFI \"c\"> Number\n"),
      ),
      (
        "b",
        desugar (parseLocated "extern shared : Float -> <FFI \"c\"> Float\n"),
      ),
    ]
  let (_, _, _, _, table, _, _) = elab
  let facts =
    factsOfElabSources checkedFfiExternTypeNamesModules outputs elab table
  let rows = optionOr [] facts.pfExternSources
  expectAll [
    expectEqual
      ["$extern$u1:a6:shared", "$extern$u1:b6:shared"]
      (map (row => row.sourceSymbol) rows),
    expectEqual
      [CheckedSource, CheckedSource]
      (map (row => row.sourceProvenance) rows),
    expectEqual
      [Some (["Int"], "Int"), Some (["Float"], "Float")]
      (map (s => map (a => (a.parameterHeads, a.resultHead)) s.sourceAbi) rows),
  ]
