import types.extern_source.{externSourceHeadRows}
-- BOOTSTRAP (B1) emit driver — the gap-TOLERANT multi-module emitter behind the
-- FIRST native self-compile slice (test/bootstrap_lex.sh).  It is a near-clone of
-- llvm_emit_modules_main.mdk (runs the REAL emitProgram so the native binary can
-- be linked + run + byte-diffed against the interpreter), with ONE difference:
--
--   it calls emitProgramRecord instead of strict emitProgram.
--
-- Why.  The bootstrap forces the REAL stdlib/core.mdk prelude through emitProgram
-- (unlike llvm_emit_modules_main.mdk's deliberately EMPTY prelude).  core.mdk
-- still contains 8 UNREACHABLE dead-code emitter gaps (`max`/`min` in
-- maximum/minimum, the Arbitrary impls — census-B excluded).  With gap-recording
-- OFF, emitProgram's `gapE`/`gapU`/`gapStr` would `panic` on those sites, even
-- though the LEXER never reaches them.  Turning recording ON makes each gap a
-- harmless placeholder ("0") instead of an abort.
--
-- This is SAFE precisely because the harness byte-diffs the native token stream
-- against the interpreter: if any gap the lexer ACTUALLY reaches got a "0"
-- placeholder, the output diverges and the diff FAILS.  A passing diff therefore
-- proves every placeholder was dead code.  (We reuse the same recording
-- mechanism — emitProgramRecord — but keep the REAL emission path, not the
-- measure-only emitProgramGaps.)
--
--   medaka run compiler/entries/llvm_bootstrap_lex_main.mdk <runtime.mdk> <core.mdk> <entry.mdk> [root ...]

import backend.extern_catalog.{runtimeDomain}
import backend.emit_target.{Backend(..)}
import frontend.ast.{externDecls, Decl}
import types.typecheck.{
  elaborateModulesWithReport,
  constrainedSigNames,
  preludeReturnPosDictNames,
  preludeArgPosDictNames,
  checkedFfiExternTypeNamesModules,
}
import types.tc_types.{DriveInputs(..)}
import ir.core_ir_lower.{
  declaredRecordFieldOrders,
  lowerProgramEmitWith,
  methodIfaceTable,
  ctorFieldTypeNames,
  externArities,
  validateFfiExternTypeNames,
}
import backend.llvm_emit.{emitProgramRecord, makeEmitInput}
import backend.emit_plan.{buildEmitPlan}

import types.private_mangle.{mangleUnitsEv}
import types.program_facts.{factsOfElabSources, factsWithEvidence}
import entries.entry_support.{driveModules}

export
oracleMain : Unit -> <IO> Unit
oracleMain () = driveModules runEmit

runEmit : DriveInputs ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
runEmit inputs runtimeDecls coreDecls modules =
  -- #2809: elaborate the program as written, then mangle its elaborated trees.
  let (elab, _, outputs) =
    elaborateModulesWithReport inputs False None runtimeDecls coreDecls modules
  let (coreE, modulesE, _, _, evTable, _, _) = elab
  let externFacts =
    factsOfElabSources checkedFfiExternTypeNamesModules outputs elab evTable
  let (coreD, modules2, evTableM) = mangleUnitsEv evTable coreE modulesE
  let allDecls = coreD ++ flatMap snd modules2
  let _ =
    preludeReturnPosDictNames coreD allDecls
      ++ preludeArgPosDictNames coreD allDecls
      ++ constrainedSigNames allDecls
  let input =
    makeEmitInput
      (runtimeDomain (externDecls runtimeDecls))
      (methodIfaceTable allDecls)
      (ctorFieldTypeNames allDecls)
      (externArities runtimeDecls)
      0
      []
      []
      ""
      (validateFfiExternTypeNames
        (externSourceHeadRows (optionOr [] externFacts.pfExternSources)))
  let cp =
    lowerProgramEmitWith (factsWithEvidence evTableM externFacts) allDecls
  let (text, _) = emitProgramRecord input (buildEmitPlan LlvmBackend cp) cp
  putStr text
-- Module-qualify module-PRIVATE top-level functions whose bare name collides
-- across units, on the trees `elaborateModules` has already produced (#2809 put the
-- rename after the elaboration, not before it).  Without this, two modules'
-- same-named privates (e.g. lex_main.emit vs lexer.emit) both mangle to @mdk_emit
-- and only one survives → @main calls the wrong arity.

-- gap-TOLERANT: unreachable dead-code gaps in core.mdk become "0" placeholders
-- instead of aborting.  The harness byte-diff is the safety net.

main = oracleMain ()
