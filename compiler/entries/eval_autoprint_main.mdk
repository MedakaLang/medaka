-- The INTERPRETER arm of the 3-engine differential gate (test/diff_compiler_engines.sh,
-- TESTING-DESIGN.md §4.4).
--
--   medaka run compiler/entries/eval_autoprint_main.mdk <runtime.mdk> <core.mdk> <entry.mdk> [root ...]
--
-- This is the interpreter path (loadProgram → elaborateModules →
-- evalModulesOutput) PLUS the composite-main auto-print wrap
-- (driver/main_autoprint.mdk) that every verb applies to a bare VALUE `main`
-- (`main = 1 + 2`) — the shape essentially every fixture in test/llvm_fixtures/
-- and test/wasm/fixtures/ uses.  `medaka run` applies the same wrap
-- (`executedTrees` in driver/medaka_cli.mdk's run arms); this probe keeps the
-- interpreter arm free of the CLI's check gate and argument handling.
--
-- Like every compiler/entries/*.mdk this is a probe driver — not compiled into the
-- `medaka` binary and not in the emitter seed graph — so it owes no re-mint.

import frontend.ast.{Decl}
import types.typecheck.{elaborateModulesWithReport}
import types.publish.{TcReport(..)}
import eval.eval.{evalModulesOutput}
import driver.main_autoprint.{valueMainCandidate, executedTrees}
import entries.entry_support.{driveModules, failWith}

export
oracleMain : Unit -> <IO> Unit
oracleMain () = driveModules runElab

-- Elaborate once as an executing drive, which returns the auto-print evidence,
-- then wrap the elaborated trees (a bare non-Unit value main is printed, an
-- `Async` main takes the scheduler driver, #2506) and force them.
runElab : List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
runElab runtimeDecls coreDecls modules =
  let ((coreE, modulesE, _, _, _, _, _), report) =
    elaborateModulesWithReport
      (valueMainCandidate coreDecls modules)
      (Some "runAsyncMain")
      runtimeDecls
      coreDecls
      modules
  let executed =
    executedTrees
      report.trAutoPrint
      "runAsyncMain"
      (coreDecls, modules)
      (coreE, modulesE)
  match executed
    Ok (coreW, modulesW) => putStr (evalModulesOutput coreW modulesW)
    Err msg => failWith msg

main = oracleMain ()
