-- The INTERPRETER arm of the 3-engine differential gate (test/diff_compiler_engines.sh,
-- TESTING-DESIGN.md §4.4).
--
--   medaka run compiler/entries/eval_autoprint_main.mdk <runtime.mdk> <core.mdk> <entry.mdk> [root ...]
--
-- This is the interpreter path (loadProgram → elaborateModules →
-- evalModulesOutput) PLUS the composite-main auto-print wrap
-- (driver/main_autoprint.mdk) that every verb applies to a bare VALUE `main`
-- (`main = 1 + 2`) — the shape essentially every fixture in test/llvm_fixtures/
-- and test/wasm/fixtures/ uses.  `medaka run` applies the same wrap
-- (`autoPrintElaborated`, driver/medaka_cli.mdk); this probe keeps the
-- interpreter arm free of the CLI's check gate and argument handling.
--
-- Like every compiler/entries/*.mdk this is a probe driver — not compiled into the
-- `medaka` binary and not in the emitter seed graph — so it owes no re-mint.

import frontend.ast.{Decl}
import types.typecheck.{elaborateModules}
import eval.eval.{evalModulesOutput}
import driver.main_autoprint.{
  autoPrintWrapModules,
  autoPrintPinCore,
  shouldAutoPrintMain,
  shouldAsyncWrapMain,
  asyncWrapModules,
}
import entries.entry_support.{driveModules}

main = driveModules runElab

-- Elaborate once to learn `main`'s type (populates mainSchemeRef, which
-- shouldAutoPrintMain reads), wrap a bare non-Unit value main, then elaborate the
-- (possibly wrapped) graph for real and force it.  The double elaborate mirrors
-- entry_support.runEmitWith / playground_main.doEmit, which do exactly this.
runElab : List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
runElab runtimeDecls coreDecls modules =
  let _ = elaborateModules runtimeDecls coreDecls modules
  let fired = shouldAutoPrintMain coreDecls modules
  -- An `Async` main takes the scheduler-driver rewrite instead (#2506), the
  -- same one `medaka run`'s `elaborateRun` applies.
  let asyncFired = shouldAsyncWrapMain "runAsyncMain" modules
  let modulesW =
    if fired then
      autoPrintWrapModules modules
    else if asyncFired then
      asyncWrapModules "runAsyncMain" modules
    else
      modules
  -- the wrap's callee is a PRELUDE re-binding (autoPrintPinCore, #2185 / F1 / F2).
  let coreW = if fired then autoPrintPinCore coreDecls else coreDecls
  let (coreE, modulesE, _, _, _, _) =
    elaborateModules runtimeDecls coreW modulesW
  putStr (evalModulesOutput coreE modulesE)
