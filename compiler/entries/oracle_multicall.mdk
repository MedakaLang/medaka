import entries.eval_dict_batch.{oracleMain as eval_dict_batch}
import entries.eval_typed_main.{oracleMain as eval_typed_main}
import entries.eval_typed_batch.{oracleMain as eval_typed_batch}
import entries.eval_typed_modules_main.{oracleMain as eval_typed_modules_main}
import entries.eval_modules_main.{oracleMain as eval_modules_main}
import entries.eval_autoprint_main.{oracleMain as eval_autoprint_main}
import entries.core_ir_main.{oracleMain as core_ir_main}
