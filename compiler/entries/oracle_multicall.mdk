-- Multicall oracle: ONE binary, hardlinked as test/bin/<entry>; dispatches on the
-- basename of executablePath () (Linux /proc/self/exe keeps the hardlink name).
import path.{basename}
import entries.eval_run_main.{oracleMain as eval_run_main}
import entries.eval_run_batch.{oracleMain as eval_run_batch}
import entries.core_ir_run_main.{oracleMain as core_ir_run_main}
import entries.eval_main.{oracleMain as eval_main}
import entries.eval_prelude_main.{oracleMain as eval_prelude_main}
