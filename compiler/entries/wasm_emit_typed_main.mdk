-- WasmGC TYPED driver for slice W5 (typeclass dispatch) — the WasmGC peer of
-- entries/llvm_emit_typed_main.mdk.  Where wasm_emit_main.mdk (the W1–W4 scalar/
-- ADT/closure spike) runs the PRELUDE-FREE annotate path (annotateProgram), which
-- never marks/typechecks and so NEVER produces CMethod/CDict, THIS driver runs the
-- typed front end (desugar → elaborateDict: RKey/EDictAt route stamping + dict_pass
-- leading-dict params → lower to Core IR), then emits a WasmGC WAT module.  It is
-- the ONLY WasmGC driver that produces dispatch nodes.
--
--   medaka run compiler/entries/wasm_emit_typed_main.mdk <runtime.mdk> <prelude.mdk>... <file.mdk>
--   (or, OCaml-free: the compiled binary test/bin/wasm_emit_typed_main <runtime.mdk> <file.mdk>)
--
-- ENTRY STRATEGY (W5, reported in the slice writeup): DUAL-ENTRY.  The W1–W4
-- scalar/ADT fixtures keep wasm_emit_main; the W5 dispatch fixtures use THIS typed
-- single-file entry, mirroring the LLVM dispatch spike (test/diff_compiler_llvm_typed.sh
-- drives llvm_emit_typed_main passing ONLY runtime.mdk).  WHY NOT the modules+DCE
-- build path: the WasmGC emitter only covers W1–W4 (scalar/ADT/closure) — it has
-- explicit gaps for strings/Float/Char/tuples (W6/W7).  DCE retains every
-- impl/interface WHOLE (dispatch is runtime dict-passing, pruning an impl would be a
-- silent miscompile), so the real `medaka build` of even a minimal `Eq Color`
-- fixture emits ~274 prelude impl functions — Debug/Display (strings), Num Float
-- (Float arith), Char impls, tuple impls — every one an out-of-slice WasmGC gap.
-- The prelude-free typed entry sidesteps this exactly as the LLVM spike did:
-- fixtures define their own minimal interfaces (Eq/Ord/Num-shaped), elaborateDict
-- resolves every route, and the lowered program pulls in NOTHING but scalar/ADT/
-- dispatch nodes the emitter can lower.

import frontend.ast.{Decl, Lit(..), Loc(..), Pat(..), Addr(..), Route(..)}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import types.typecheck.{
  elaborateDict,
  constrainedSigNames,
  preludeReturnPosDictNames,
  preludeArgPosDictNames,
}
import eval.eval.{funNamesOf, dropShadowedExp}
import ir.core_ir.{
  CProgram(..),
  CBind(..),
  CClause(..),
  CExpr(..),
  CField(..),
  CImplEntry(..),
  CImplBody(..),
}
import ir.core_ir_lower.{
  lowerProgramEmit,
  declSigTypeNames,
  ctorFieldTypeNames,
  declaredRecordFieldOrders,
  methodIfaceTable,
}
import backend.wasm_emit.{
  WasmEmitInput,
  emitProgram,
  emitProgramRecord,
  emitProgramGaps,
  makeWasmEmitInput,
}
import entries.entry_support.{driveRuntime}

main = match args ()
  "--reemit-trmc-state"::_ => reemitTrmcState ()
  "--reemit-impl-self-state"::_ => reemitImplSelfState ()
  "--reemit-input"::runtimePath::pPath::uPath::_ =>
    reemitInput runtimePath pPath uPath
  "--reemit-state"::runtimePath::_ => reemitState runtimePath
  "--reemit-gap-state"::_ => reemitGapState ()
  "--reemit-gap-strict"::_ => reemitGapStrict ()
  "--reemit-string-state"::_ => reemitStringState ()
  "--reemit-default-state"::_ => reemitDefaultState ()
  "--reemit-lambda-state"::_ => reemitLambdaState ()
  "--reemit-trap-state"::_ => reemitTrapState ()
  "--emit-trap-state"::_ =>
    putStr (emitProgram trapStateInput trapStateAbortProgram)
  "--reemit-ref-trap-state"::_ => reemitRefTrapState ()
  "--emit-ref-trap-state"::_ =>
    putStr (emitProgram refTrapStateInput refTrapStateAbortProgram)
  "--reemit-feature-state"::_ => reemitFeatureState ()
  "--reemit-char-from-code-state"::_ => reemitCharFromCodeState ()
  "--reemit-leaf-runtime-state"::_ => reemitLeafRuntimeState ()
  "--capture-current-binding"::row::_ => captureCurrentBinding row
  _ => driveRuntime emit

emit : List Decl -> List Decl -> List Decl -> <IO> Unit
emit runtimeDecls preludeDecls userDecls =
  putStr (runEmit runtimeDecls preludeDecls userDecls)

runEmit : List Decl -> List Decl -> List Decl -> String
runEmit runtimeDecls preludeDecls userDecls =
  emitProgram
    (typedInput runtimeDecls preludeDecls userDecls)
    (typedProgram runtimeDecls preludeDecls userDecls)

typedInput : List Decl -> List Decl -> List Decl -> WasmEmitInput
typedInput runtimeDecls preludeDecls userDecls =
  let userNames = funNamesOf userDecls
  let livePrelude = dropShadowedExp userNames preludeDecls
  let combined = livePrelude ++ userDecls
  makeWasmEmitInput
    []
    (declSigTypeNames runtimeDecls ++ declSigTypeNames combined)
    (ctorFieldTypeNames combined)
    False
    (declaredRecordFieldOrders combined)

typedProgram : List Decl -> List Decl -> List Decl -> CProgram
typedProgram runtimeDecls preludeDecls userDecls =
  let userNames = funNamesOf userDecls
  let livePrelude = dropShadowedExp userNames preludeDecls
  let combined = livePrelude ++ userDecls
  let dictNames = preludeReturnPosDictNames livePrelude combined ++ preludeArgPosDictNames livePrelude combined ++ constrainedSigNames userDecls
  lowerProgramEmit (elaborateDict runtimeDecls dictNames userNames combined)

-- Same-process input-isolation harness for X-W.H1. It lowers P once, then emits
-- that exact CProgram with P's complete input, one U-derived field at a time, and
-- P's input again. The markers prove re-entrant isolation and that each input
-- family affects the physical plan independently.
reemitInput : String -> String -> String -> <IO> Unit
reemitInput runtimePath pPath uPath = match readFile runtimePath
  Err msg => ePutStrLn msg
  Ok runtimeSrc => match readFile pPath
    Err msg => ePutStrLn msg
    Ok pSrc => match readFile uPath
      Err msg => ePutStrLn msg
      Ok uSrc =>
        let runtimeDecls = desugar (parse runtimeSrc)
        let pDecls = desugar (parse pSrc)
        let uDecls = desugar (parse uSrc)
        let pProgram = typedProgram runtimeDecls [] pDecls
        let pMethods = methodIfaceTable pDecls
        let pSigs = declSigTypeNames runtimeDecls ++ declSigTypeNames pDecls
        let pCtors = ctorFieldTypeNames pDecls
        let pRecords = declaredRecordFieldOrders pDecls
        let pInput = makeWasmEmitInput pMethods pSigs pCtors False pRecords
        let p1 = emitProgram pInput pProgram
        let methodWat = emitProgram (makeWasmEmitInput (methodIfaceTable uDecls) pSigs pCtors False pRecords) pProgram
        let sigWat = emitProgram (makeWasmEmitInput pMethods (declSigTypeNames runtimeDecls ++ declSigTypeNames uDecls) pCtors False pRecords) pProgram
        let ctorWat = emitProgram (makeWasmEmitInput pMethods pSigs (ctorFieldTypeNames uDecls) False pRecords) pProgram
        let recordWat = emitProgram (makeWasmEmitInput pMethods pSigs pCtors False (declaredRecordFieldOrders uDecls)) pProgram
        let mainDecls = desugar (parse "data Dummy = Dummy\n\nmain = 1\n")
        let mainProgram = typedProgram runtimeDecls [] mainDecls
        let mainBase = emitProgram (typedInput runtimeDecls [] mainDecls) mainProgram
        let mainWat = emitProgram (makeWasmEmitInput [] (declSigTypeNames runtimeDecls ++ declSigTypeNames mainDecls) (ctorFieldTypeNames mainDecls) True (declaredRecordFieldOrders mainDecls)) mainProgram
        let pLast = emitProgram pInput pProgram
        let _ = putStrLn (if p1 == pLast then "P_EQ_PLAST" else "P_NE_PLAST")
        let _ = putStrLn (if p1 /= methodWat then "P_NE_METHOD" else "P_EQ_METHOD")
        let _ = putStrLn (if p1 /= sigWat then "P_NE_SIG" else "P_EQ_SIG")
        let _ = putStrLn (if p1 /= ctorWat then "P_NE_CTOR" else "P_EQ_CTOR")
        let _ = putStrLn (if mainBase /= mainWat then "P_NE_MAIN" else "P_EQ_MAIN")
        putStrLn (if p1 /= recordWat then "P_NE_RECORD" else "P_EQ_RECORD")

-- X-W.H2a: the selected Wasm physical indexes must belong to one private Prog, not
-- module state. P and U deliberately reuse names while changing every selected index
-- family; a gap-mode U sits between the two normal P emissions.
reemitState : String -> <IO> Unit
reemitState runtimePath = match readFile runtimePath
  Err msg => ePutStrLn msg
  Ok runtimeSrc =>
    let runtimeDecls = desugar (parse runtimeSrc)
    let pDecls = desugar (parse reemitStateP)
    let uDecls = desugar (parse reemitStateU)
    let pInput = reemitStateFallbackInput runtimeDecls pDecls
    let uInput = reemitStateFallbackInput runtimeDecls uDecls
    let pProgram = typedProgram runtimeDecls [] pDecls
    let uProgram = typedProgram runtimeDecls [] uDecls
    let p1 = emitProgram pInput pProgram
    let u = emitProgram uInput uProgram
    let _ = emitProgramGaps uInput uProgram
    let p2 = emitProgram pInput pProgram
    let _ = putStrLn "REEMIT_P1_BEGIN"
    let _ = putStrLn p1
    let _ = putStrLn "REEMIT_P1_END"
    let _ = putStrLn "REEMIT_U_BEGIN"
    let _ = putStrLn u
    let _ = putStrLn "REEMIT_U_END"
    let _ = putStrLn "REEMIT_P2_BEGIN"
    let _ = putStrLn p2
    putStrLn "REEMIT_P2_END"

reemitStateFallbackInput : List Decl -> List Decl -> WasmEmitInput
reemitStateFallbackInput runtimeDecls decls =
  -- This harness deliberately omits declaration record orders so its record probes
  -- exercise Prog's immutable indexRecFieldsW construction fallback.
  makeWasmEmitInput
    (methodIfaceTable decls)
    (declSigTypeNames runtimeDecls ++ declSigTypeNames decls)
    (ctorFieldTypeNames decls)
    False
    []

reemitStateP : String
reemitStateP = "interface Mark a where\n  mark : a -> Int\n\ndata PSubject = PZero | SharedCtor Int\n\ndata SharedRecord = SharedRecord { pFirst : Int, common : Int }\n\nsharedArity x = x\n\npOnlyFn x = x\n\nsharedValueFn x = x\n\napply f x = f x\n\nchoose x _ = x\n\nsubjectCode subject = match subject\n  PZero => 0\n  SharedCtor value => value\n\npOnlyValue = 1\n\npOnlyProbe = pOnlyFn pOnlyValue\n\npArityValue = sharedArity\n\npArityProbe = apply pArityValue 1\n\npFnValue = sharedValueFn\n\npFnProbe = apply pFnValue 2\n\npRecordProbe = (SharedRecord { pFirst = 3, common = 4 }).common\n\npLazy = mark (SharedCtor 7)\n\nimpl Mark PSubject where\n  mark _ = 7\n\nmain = choose pLazy (subjectCode (SharedCtor 7))\n"

reemitStateU : String
reemitStateU = "interface Mark a where\n  mark : a -> Int -> Int\n\ndata USubject = SharedCtor Int Int | UZero\n\ndata SharedRecord = SharedRecord { common : Int, uLast : Int }\n\nsharedArity x y = x\n\nuOnlyFn x = x\n\nsharedValueFn x y = x\n\napply f x y = f x y\n\nchoose x _ = x\n\nsubjectCode subject = match subject\n  SharedCtor first second => first + second\n  UZero => 0\n\nuOnlyValue = 2\n\nuOnlyProbe = uOnlyFn uOnlyValue\n\nuArityValue = sharedArity\n\nuArityProbe = apply uArityValue 1 2\n\nuFnProbe = sharedValueFn 2 3\n\nuRecordProbe = (SharedRecord { common = 3, uLast = 4 }).common\n\nuLazy = mark (SharedCtor 7 8) 0\n\nimpl Mark USubject where\n  mark _ _ = 9\n\nmain = choose uLazy (subjectCode (SharedCtor 7 8))\n"

-- H2b.6: fresh strict/record/census emissions exercise top-level TRMC state.
-- P is emitted twice around unrelated U work; U's census carries its one
-- attributed gap. Both normal captures contain an admitted list-builder loop.
reemitTrmcState : Unit -> <IO> Unit
reemitTrmcState _ =
  let p1 = emitProgram trmcStateInput (trmcStateProgram "pTrmc" 17)
  let (u, _) = emitProgramRecord trmcStateInput (trmcStateProgram "uTrmc" 29)
  let censusEvents = emitProgramGaps trmcStateInput trmcStateCensusProgram
  let _ = printCapture "TRMC_P1" p1
  let _ = printCapture "TRMC_RECORD_U" u
  let _ = printEvents "TRMC_CENSUS_U_GAP" censusEvents
  printCapture
    "TRMC_P2"
    (emitProgram trmcStateInput (trmcStateProgram "pTrmc" 17))

trmcStateInput : WasmEmitInput
trmcStateInput = makeWasmEmitInput [] [] [] False []

trmcStateLoc : Loc
trmcStateLoc = Loc "<trmc-state>" 1 1 1 1

trmcStateProgram : String -> Int -> CProgram
trmcStateProgram name marker =
  let n = CVar "n" (ALocal 0 0)
  let recursive = CApp (CVar name AGlobal) (CBinPrim "-" n (CLit (LInt 1)) "Int")
  let body = CIf (CBinPrim "==" n (CLit (LInt 0)) "Int") (CList []) (CBinPrim "::" (CLit (LInt marker)) recursive "")
  CProgram
    [
      CBind name [CClause [PVar "n" trmcStateLoc] body],
      CBind "main" [
        CClause [] (CLet False (PCons (PVar "head" trmcStateLoc) PWild) (CApp (CVar name AGlobal) (CLit (LInt 2000000))) (CVar "head" (ALocal 0 0)))
      ],
    ]
    []
    []
    []

trmcStateCensusProgram : CProgram
trmcStateCensusProgram = CProgram
  [
    CBind "pTrmc" [
      CClause [PVar "n" trmcStateLoc] (CIf (CBinPrim "==" (CVar "n" (ALocal 0 0)) (CLit (LInt 0)) "Int") (CList []) (CBinPrim "::" (CLit (LInt 17)) (CApp (CVar "pTrmc" AGlobal) (CBinPrim "-" (CVar "n" (ALocal 0 0)) (CLit (LInt 1)) "Int")) ""))
    ],
    CBind "trmcIntentionalGap" [CClause [] (CVar "missingTrmcCensus" AGlobal)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

reemitImplSelfState : Unit -> <IO> Unit
reemitImplSelfState _ =
  let pProgram = implSelfProgram "PLoop" 17 3
  let uProgram = implSelfProgram "ULoop" 29 4
  let p1 = emitProgram implSelfInput pProgram
  let _ = printCapture "IMPL_SELF_P1" p1
  let (u, _) = emitProgramRecord implSelfInput uProgram
  let _ = printCapture "IMPL_SELF_RECORD_U" u
  let censusEvents = emitProgramGaps implSelfInput (implSelfCensusProgram uProgram)
  let _ = printEvents "IMPL_SELF_CENSUS_U_GAP" censusEvents
  printCapture "IMPL_SELF_P2" (emitProgram implSelfInput pProgram)

-- X-W.H2b.7: fresh WasmEmit owns the lambda-id counter, lifted-definition drain,
-- named eta dedup, and `ref.func` declaration registry. P→U→census→P shares one
-- process while every emission allocates exclusive carrier state.
reemitLambdaState : Unit -> <IO> Unit
reemitLambdaState _ =
  let p1 = emitProgram lambdaStateInput (lambdaStateProgram 17)
  let (u, _) = emitProgramRecord lambdaStateInput (lambdaStateProgram 29)
  let censusEvents = emitProgramGaps lambdaStateInput lambdaStateCensusProgram
  let _ = printCapture "LAMBDA_P1" p1
  let _ = printCapture "LAMBDA_RECORD_U" u
  let _ = printEvents "LAMBDA_CENSUS_U_GAP" censusEvents
  printCapture
    "LAMBDA_P2"
    (emitProgram lambdaStateInput (lambdaStateProgram 17))

lambdaStateInput : WasmEmitInput
lambdaStateInput = makeWasmEmitInput [] [] [("Pair", ["Int", "Int"])] False []

lambdaStateLoc : Loc
lambdaStateLoc = Loc "<lambda-state>" 1 1 1 1

lambdaStateProgram : Int -> CProgram
lambdaStateProgram result =
  let arg = PVar "arg" lambdaStateLoc
  let local = PVar "local" lambdaStateLoc
  let nestedName = PVar "nested" lambdaStateLoc
  let identity = CLam [arg] (CVar "arg" (ALocal 0 0))
  let nested = CLam [arg] (CApp (CVar "local" (ALocal 0 0)) (CVar "arg" (ALocal 0 0)))
  let lambdaBody = if result == 17 then
    CLet False local identity (CApp (CVar "local" (ALocal 0 0)) (CLit (LInt result)))
  else
    CLet False local identity (CLet False nestedName nested (CApp (CVar "nested" (ALocal 0 0)) (CLit (LInt result))))
  let body = CLet False PWild (CVar "Pair" AGlobal) (CLet False PWild (CVar "Pair" AGlobal) lambdaBody)
  CProgram [CBind "main" [CClause [] body]] [("Pair", 2)] [("Pair", "Pair")] []

lambdaStateCensusProgram : CProgram
lambdaStateCensusProgram = CProgram
  [
    CBind "lambdaCensus" [CClause [] (CLam [PVar "x" lambdaStateLoc] (CVar "x" (ALocal 0 0)))],
    CBind "lambdaIntentionalGap" [CClause [] (CVar "missingLambdaCensus" AGlobal)],
  ]
  [("Pair", 2)]
  [("Pair", "Pair")]
  []

-- X-W.H2b.8: coded stderr-import demand belongs to fresh WasmEmit. P carries an
-- uncalled concrete div-zero route, so it imports mdk_write_err_byte while inert main
-- runs. Trap-free record U and census separate P emissions; a separate strict route
-- executes the exact abort.
reemitTrapState : Unit -> <IO> Unit
reemitTrapState _ =
  let p1 = emitProgram trapStateInput trapStateProgram
  let (u, _) = emitProgramRecord trapStateInput trapStateControlProgram
  let censusEvents = emitProgramGaps trapStateInput trapStateCensusProgram
  let _ = printCapture "TRAP_P1" p1
  let _ = printCapture "TRAP_RECORD_U" u
  let _ = printEvents "TRAP_CENSUS_U_GAP" censusEvents
  printCapture "TRAP_P2" (emitProgram trapStateInput trapStateProgram)

-- A0 capture-only apparatus for H2b.9. P activates each prospective feature
-- route from an uncalled one-argument binding; U is an inert positive control.
-- Census deliberately uses a function binding so emitFnsGapsW establishes both
-- gap attribution and current binding before its unbound-variable reader runs.
reemitFeatureState : Unit -> <IO> Unit
reemitFeatureState _ =
  let p1 = emitProgram featureStateInput featureStateProgram
  let hashIntOnly = emitProgram featureHashIntOnlyInput featureHashIntOnlyProgram
  let floatDiv = emitProgram featureStateInput featureFloatDivProgram
  let (u, _) = emitProgramRecord featureStateInput featureStateControlProgram
  let censusEvents = emitProgramGaps featureStateInput featureStateCensusProgram
  let hashFloatP1 = emitProgram featureHashFloatInput featureHashFloatProgram
  let (hashFloatU, _) = emitProgramRecord featureHashFloatInput featureHashFloatRecordUProgram
  let hashFloatCensusEvents = emitProgramGaps featureHashFloatInput featureHashFloatCensusProgram
  let _ = printCapture "FEATURE_P1" p1
  let _ = printCapture "FEATURE_HASH_INT_ONLY" hashIntOnly
  let _ = printCapture "FEATURE_FLOAT_DIV" floatDiv
  let _ = printCapture "FEATURE_RECORD_U" u
  let _ = printEvents "FEATURE_CENSUS_U_GAP" censusEvents
  let _ = printCapture "FEATURE_P2" (emitProgram featureStateInput featureStateProgram)
  let _ = printCapture "FEATURE_HASH_FLOAT_P1" hashFloatP1
  let _ = printCapture "FEATURE_HASH_FLOAT_RECORD_U" hashFloatU
  let _ = printEvents "FEATURE_HASH_FLOAT_CENSUS_P_GAP" hashFloatCensusEvents
  printCapture
    "FEATURE_HASH_FLOAT_P2"
    (emitProgram featureHashFloatInput featureHashFloatProgram)

featureStateInput : WasmEmitInput
featureStateInput = makeWasmEmitInput
  []
  []
  [("FeatureRecord", ["Int", "Int"]), ("FeatureVariant", ["Int", "Int"])]
  False
  [("FeatureRecord", ["left", "right"]), ("FeatureVariant", ["left", "right"])]

featureStateLoc : Loc
featureStateLoc = Loc "<feature-state>" 1 1 1 1

featureStateArg : Pat
featureStateArg = PVar "x" featureStateLoc

featureStateRecord : CExpr
featureStateRecord = CRecord
  "FeatureRecord"
  [CField "left" (CLit (LInt 1)), CField "right" (CLit (LInt 2))]

featureStateVariant : CExpr
featureStateVariant = CRecord
  "FeatureVariant"
  [CField "left" (CLit (LInt 3)), CField "right" (CLit (LInt 4))]

featureStateBinds : List CBind
featureStateBinds = [
  CBind "featureDiv" [
    CClause [featureStateArg] (CBinPrim "/" (CVar "x" (ALocal 0 0)) (CLit (LInt 1)) "Int")
  ],
  CBind "featureMod" [
    CClause [featureStateArg] (CBinPrim "%" (CVar "x" (ALocal 0 0)) (CLit (LInt 1)) "Int")
  ],
  CBind "featureRecordUpdate" [
    CClause [featureStateArg] (CRecordUpdate "FeatureRecord" featureStateRecord [CField "left" (CLit (LInt 5))])
  ],
  CBind "featureVariantUpdate" [
    CClause [featureStateArg] (CVariantUpdate "FeatureVariant" featureStateVariant [CField "right" (CLit (LInt 6))])
  ],
  CBind "featureRandomInt" [
    CClause [featureStateArg] (CApp (CApp (CVar "randomInt" AGlobal) (CLit (LInt 0))) (CLit (LInt 1)))
  ],
  CBind "featureHashInt" [
    CClause [featureStateArg] (CApp (CVar "hashInt" AGlobal) (CVar "x" (ALocal 0 0)))
  ],
  CBind "featureEPut" [
    CClause [featureStateArg] (CApp (CVar "ePutStr" AGlobal) (CLit (LString "feature ePut")))
  ],
  CBind "featurePanic" [
    CClause [featureStateArg] (CApp (CVar "panic" AGlobal) (CLit (LString "feature panic")))
  ],
]

featureStateCtorArities : List (String, Int)
featureStateCtorArities = [("FeatureRecord", 2), ("FeatureVariant", 2)]

featureStateCtorTypes : List (String, String)
featureStateCtorTypes =
  [("FeatureRecord", "FeatureRecord"), ("FeatureVariant", "FeatureVariant")]

featureStateProgram : CProgram
featureStateProgram =
  CProgram
    (featureStateBinds ++ [CBind "main" [CClause [] (CLit (LInt 0))]])
    featureStateCtorArities
    featureStateCtorTypes
    []

-- This nearest-miss contains hashInt only.  Unlike featureStateProgram it has no
-- string-bearing feature route, so it proves the hash-string runtime conjunction
-- is not widened by base hash use.
featureHashIntOnlyInput : WasmEmitInput
featureHashIntOnlyInput = makeWasmEmitInput [] [] [] False []

featureHashIntOnlyProgram : CProgram
featureHashIntOnlyProgram = CProgram
  [
    CBind "featureHashIntOnly" [
      CClause [featureStateArg] (CApp (CVar "hashInt" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

-- H2b.10 hashFloat uses a fresh strict emission with an uncalled binding. Its
-- record U is the nearest miss: Float + hashInt retain shared prerequisites but
-- deliberately omit hashFloat. Census repeats P and adds exactly one attributed gap.
featureHashFloatInput : WasmEmitInput
featureHashFloatInput = makeWasmEmitInput [] [] [] False []

featureHashFloatProgram : CProgram
featureHashFloatProgram = CProgram
  [
    CBind "featureHashFloat" [
      CClause [featureStateArg] (CApp (CVar "hashFloat" AGlobal) (CLit (LFloat 3.14)))
    ],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

featureHashFloatRecordUProgram : CProgram
featureHashFloatRecordUProgram = CProgram
  [
    CBind "featureHashFloatNearestFloat" [
      CClause [featureStateArg] (CApp (CVar "intToFloat" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "featureHashFloatNearestHashInt" [
      CClause [featureStateArg] (CApp (CVar "hashInt" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

featureHashFloatCensusProgram : CProgram
featureHashFloatCensusProgram = CProgram
  [
    CBind "featureHashFloat" [
      CClause [featureStateArg] (CApp (CVar "hashFloat" AGlobal) (CLit (LFloat 3.14)))
    ],
    CBind "featureHashFloatIntentionalGap" [CClause [featureStateArg] (CVar "missingFeatureHashFloatCensus" AGlobal)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

-- H2b.11: charFromCode owns a range-check runtime and a point-free extern eta
-- wrapper. P reaches both routes; U retains the neighboring Char/String path
-- through charToStr without selecting charFromCode. Census repeats P and carries
-- exactly one attributed gap between P emissions.
reemitCharFromCodeState : Unit -> <IO> Unit
reemitCharFromCodeState _ =
  let p1 = emitProgram charFromCodeStateInput charFromCodeStateProgram
  let (u, _) = emitProgramRecord charFromCodeStateInput charFromCodeStateControlProgram
  let censusEvents = emitProgramGaps charFromCodeStateInput charFromCodeStateCensusProgram
  let _ = printCapture "CHAR_FROM_CODE_P1" p1
  let _ = printCapture "CHAR_FROM_CODE_RECORD_U" u
  let _ = printEvents "CHAR_FROM_CODE_CENSUS_P_GAP" censusEvents
  printCapture
    "CHAR_FROM_CODE_P2"
    (emitProgram charFromCodeStateInput charFromCodeStateProgram)

charFromCodeStateInput : WasmEmitInput
charFromCodeStateInput = makeWasmEmitInput [] [] [] False []

charFromCodeStateProgram : CProgram
charFromCodeStateProgram = CProgram
  [
    CBind "charFromCodeApplied" [
      CClause [featureStateArg] (CApp (CVar "charFromCode" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "charFromCodePointFree" [
      CClause [featureStateArg] (CLet False PWild (CVar "charFromCode" AGlobal) (CLit (LInt 0)))
    ],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

charFromCodeStateControlProgram : CProgram
charFromCodeStateControlProgram = CProgram
  [
    CBind "charFromCodeNearestChar" [
      CClause [featureStateArg] (CApp (CVar "charToStr" AGlobal) (CLit (LChar "A")))
    ],
    CBind "charFromCodeNearestString" [CClause [featureStateArg] (CLit (LString "char-neighborhood"))],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

charFromCodeStateCensusProgram : CProgram
charFromCodeStateCensusProgram = CProgram
  [
    CBind "charFromCodeApplied" [
      CClause [featureStateArg] (CApp (CVar "charFromCode" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "charFromCodePointFree" [
      CClause [featureStateArg] (CLet False PWild (CVar "charFromCode" AGlobal) (CLit (LInt 0)))
    ],
    CBind "charFromCodeIntentionalGap" [CClause [featureStateArg] (CVar "missingCharFromCodeCensus" AGlobal)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

-- LR0 capture-only apparatus. Each row emits strict P, record U, census P with
-- one attributed gap, then strict P again. Record events retain their own empty
-- capture so a record-mode substitution cannot hide behind valid placeholder WAT.
reemitLeafRuntimeState : Unit -> <IO> Unit
reemitLeafRuntimeState _ =
  let _ = reemitLeafRuntimeRow "CHARCLASS" leafCharClassP leafCharClassU "leafCharClassIntentionalGap" "missingLeafCharClassCensus"
  let _ = reemitLeafRuntimeRow "FLOATRNG" leafFloatRngP leafFloatRngU "leafFloatRngIntentionalGap" "missingLeafFloatRngCensus"
  let _ = reemitLeafRuntimeRow "STRCODEC" leafStrCodecP leafStrCodecU "leafStrCodecIntentionalGap" "missingLeafStrCodecCensus"
  let _ = reemitLeafRuntimeRow "VALUECMP" leafValueCmpP leafValueCmpU "leafValueCmpIntentionalGap" "missingLeafValueCmpCensus"
  let _ = reemitLeafRuntimeRow "FLOATSTR" leafFloatStrP leafFloatStrU "leafFloatStrIntentionalGap" "missingLeafFloatStrCensus"
  let _ = reemitLeafRuntimeRow "ARGS" leafArgsP leafArgsU "leafArgsIntentionalGap" "missingLeafArgsCensus"
  let _ = reemitLeafRuntimeRow "FILEBYTES_READ" leafFileBytesReadP leafFileBytesU "leafFileBytesReadIntentionalGap" "missingLeafFileBytesReadCensus"
  let _ = reemitLeafRuntimeRow "FILEBYTES_WRITE" leafFileBytesWriteP leafFileBytesU "leafFileBytesWriteIntentionalGap" "missingLeafFileBytesWriteCensus"
  reemitLeafRuntimeRow
    "MATH"
    leafMathP
    leafMathU
    "leafMathIntentionalGap"
    "missingLeafMathCensus"

reemitLeafRuntimeRow : String -> CProgram -> CProgram -> String -> String -> <IO> Unit
reemitLeafRuntimeRow name p u gapBind gapMissing =
  let p1 = emitProgram leafRuntimeInput p
  let (recordU, recordEvents) = emitProgramRecord leafRuntimeInput u
  let censusEvents = emitProgramGaps leafRuntimeInput (leafRuntimeCensus p gapBind gapMissing)
  let _ = printCapture ("LEAF_" ++ name ++ "_P1") p1
  let _ = printCapture ("LEAF_" ++ name ++ "_RECORD_U") recordU
  let _ = printEvents ("LEAF_" ++ name ++ "_RECORD_U_EVENTS") recordEvents
  let _ = printEvents ("LEAF_" ++ name ++ "_CENSUS_P_GAP") censusEvents
  printCapture ("LEAF_" ++ name ++ "_P2") (emitProgram leafRuntimeInput p)

leafRuntimeInput : WasmEmitInput
leafRuntimeInput = makeWasmEmitInput [] [] [] False []

leafRuntimeLoc : Loc
leafRuntimeLoc = Loc "<leaf-runtime-state>" 1 1 1 1

leafRuntimeArg : Pat
leafRuntimeArg = PVar "x" leafRuntimeLoc

leafRuntimeProgram : List CBind -> CProgram
leafRuntimeProgram groups =
  CProgram (groups ++ [CBind "main" [CClause [] (CLit (LInt 0))]]) [] [] []

leafRuntimeCensus : CProgram -> String -> String -> CProgram
leafRuntimeCensus (CProgram groups ctorArs ctorTypes impls) bindName missingName = CProgram (groups ++ [CBind bindName [CClause [leafRuntimeArg] (CVar missingName AGlobal)]]) ctorArs ctorTypes impls

leafCharClassP : CProgram
leafCharClassP = leafRuntimeProgram
  [
    CBind "leafCharClass" [
      CClause [leafRuntimeArg] (CApp (CVar "charIsAlpha" AGlobal) (CLit (LChar "a")))
    ]
  ]

leafCharClassU : CProgram
leafCharClassU = leafRuntimeProgram
  [
    CBind "leafCharClassNearestCode" [
      CClause [leafRuntimeArg] (CApp (CVar "charFromCode" AGlobal) (CLit (LInt 65)))
    ],
    CBind "leafCharClassNearestString" [
      CClause [leafRuntimeArg] (CLet False PWild (CLit (LString "char-class-nearest")) (CLit (LInt 0)))
    ],
  ]

leafFloatRngP : CProgram
leafFloatRngP = leafRuntimeProgram
  [
    CBind "leafFloatRng" [CClause [leafRuntimeArg] (CApp (CVar "randomFloat" AGlobal) (CLit LUnit))]
  ]

leafFloatRngU : CProgram
leafFloatRngU = leafRuntimeProgram
  [
    CBind "leafFloatRngNearestInt" [
      CClause [leafRuntimeArg] (CApp (CApp (CVar "randomInt" AGlobal) (CLit (LInt 0))) (CLit (LInt 1)))
    ],
    CBind "leafFloatRngNearestFloat" [
      CClause [leafRuntimeArg] (CApp (CVar "intToFloat" AGlobal) (CLit (LInt 0)))
    ],
  ]

leafStrCodecP : CProgram
leafStrCodecP = leafRuntimeProgram
  [
    CBind "leafStrCodec" [
      CClause [leafRuntimeArg] (CApp (CVar "stringToChars" AGlobal) (CLit (LString "héllo")))
    ]
  ]

leafStrCodecU : CProgram
leafStrCodecU = leafRuntimeProgram
  [
    CBind "leafStrCodecNearestChar" [
      CClause [leafRuntimeArg] (CApp (CVar "charToStr" AGlobal) (CLit (LChar "A")))
    ],
    CBind "leafStrCodecNearestArray" [CClause [leafRuntimeArg] (CArray [CLit (LInt 1)])],
  ]

leafValueCmpP : CProgram
leafValueCmpP = leafRuntimeProgram
  [
    CBind "leafValueCmpEq" [
      CClause [leafRuntimeArg] (CBinPrim "==" (CLit (LString "value-cmp")) (CLit (LString "value-cmp")) "String")
    ],
    CBind "leafValueCmpLt" [
      CClause [leafRuntimeArg] (CBinPrim "<" (CLit (LString "value-cmp-a")) (CLit (LString "value-cmp-b")) "String")
    ],
  ]

leafValueCmpU : CProgram
leafValueCmpU = leafRuntimeProgram
  [
    CBind "leafValueCmpNearestStringCompare" [
      CClause [leafRuntimeArg] (CApp (CApp (CVar "stringCompare" AGlobal) (CLit (LString "medaka"))) (CLit (LString "medaka")))
    ]
  ]

-- A2: P selects stringToFloat. U retains Float, String, and IO cofactors without
-- selecting its host import/runtime; shared leaf census remains ownership-only.
leafFloatStrP : CProgram
leafFloatStrP = leafRuntimeProgram
  [
    CBind "leafFloatStr" [
      CClause [leafRuntimeArg] (CApp (CVar "stringToFloat" AGlobal) (CLit (LString "3.14")))
    ]
  ]

leafFloatStrU : CProgram
leafFloatStrU = leafRuntimeProgram
  [
    CBind "leafFloatStrNearestFloat" [
      CClause [leafRuntimeArg] (CApp (CVar "intToFloat" AGlobal) (CVar "x" (ALocal 0 0)))
    ],
    CBind "leafFloatStrNearestStringIo" [
      CClause [leafRuntimeArg] (CApp (CVar "readFile" AGlobal) (CLit (LString "floatstr-nearest")))
    ],
  ]

-- A3: P selects args. U retains IO, String, and List cofactors without selecting
-- the args runtime; shared leaf census remains ownership-only.
leafArgsP : CProgram
leafArgsP = leafRuntimeProgram
  [
    CBind "leafArgs" [CClause [leafRuntimeArg] (CApp (CVar "args" AGlobal) (CLit LUnit))]
  ]

leafArgsU : CProgram
leafArgsU = leafRuntimeProgram
  [
    CBind "leafArgsNearestIo" [
      CClause [leafRuntimeArg] (CApp (CVar "readFile" AGlobal) (CLit (LString "args-nearest")))
    ],
    CBind "leafArgsNearestList" [CClause [leafRuntimeArg] (CList [CLit (LString "args-nearest")])],
  ]

-- A4: separate P rows keep read/write producers independently observable. Shared U
-- retains IO, Array, and String cofactors without FileBytes demand; census is
-- ownership-only and all hand-built programs keep main inert.
leafFileBytesReadP : CProgram
leafFileBytesReadP = leafRuntimeProgram
  [
    CBind "leafFileBytesRead" [
      CClause [leafRuntimeArg] (CApp (CVar "readFileBytes" AGlobal) (CLit (LString "filebytes-read-inert")))
    ]
  ]

leafFileBytesWriteP : CProgram
leafFileBytesWriteP = leafRuntimeProgram
  [
    CBind "leafFileBytesWrite" [
      CClause [leafRuntimeArg] (CApp (CApp (CVar "writeFileBytes" AGlobal) (CLit (LString "filebytes-write-inert"))) (CArray [CLit (LInt 1)]))
    ]
  ]

leafFileBytesU : CProgram
leafFileBytesU = leafRuntimeProgram
  [
    CBind "leafFileBytesNearestIoString" [
      CClause [leafRuntimeArg] (CApp (CVar "readFile" AGlobal) (CLit (LString "filebytes-nearest")))
    ],
    CBind "leafFileBytesNearestArray" [CClause [leafRuntimeArg] (CArray [CLit (LInt 1)])],
  ]

leafMathP : CProgram
leafMathP = leafRuntimeProgram
  [
    CBind "leafMath" [CClause [leafRuntimeArg] (CApp (CVar "sin" AGlobal) (CLit (LFloat 0.0)))]
  ]

leafMathU : CProgram
leafMathU = leafRuntimeProgram
  [
    CBind "leafMathNearestSqrt" [CClause [leafRuntimeArg] (CApp (CVar "sqrt" AGlobal) (CLit (LFloat 4.0)))]
  ]

-- Float `/` stays over-approximated by the divisor-local scan: it needs the
-- ref-mode local even though IEEE division never traps on zero.
featureFloatDivProgram : CProgram
featureFloatDivProgram = CProgram
  [
    CBind "featureFloatDiv" [
      CClause [featureStateArg] (CBinPrim "/" (CLit (LFloat 1.0)) (CLit (LFloat 2.0)) "Float")
    ],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

featureStateControlProgram : CProgram
featureStateControlProgram = CProgram
  [
    CBind "featurePlainRecord" [CClause [featureStateArg] featureStateRecord],
    CBind "featurePlainAccess" [
      CClause [featureStateArg] (CFieldAccess featureStateRecord "left" "FeatureRecord")
    ],
    CBind "featureControl" [CClause [featureStateArg] (CLit (LInt 29))],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  featureStateCtorArities
  featureStateCtorTypes
  []

featureStateCensusProgram : CProgram
featureStateCensusProgram =
  CProgram
    (featureStateBinds ++ [
      CBind "featureIntentionalGap" [CClause [featureStateArg] (CVar "missingFeatureCensus" AGlobal)],
      CBind "main" [CClause [] (CLit (LInt 0))],
    ])
    featureStateCtorArities
    featureStateCtorTypes
    []

trapStateInput : WasmEmitInput
trapStateInput = makeWasmEmitInput [] [] [] False []

trapStateProgram : CProgram
trapStateProgram = CProgram
  [
    CBind "trapRoute" [
      CClause [PVar "n" lambdaStateLoc] (CBinPrim "/" (CLit (LInt 1)) (CLit (LInt 0)) "Int")
    ],
    CBind "main" [CClause [] (CLit (LInt 17))],
  ]
  []
  []
  []

trapStateControlProgram : CProgram
trapStateControlProgram =
  CProgram [CBind "main" [CClause [] (CLit (LInt 29))]] [] [] []

trapStateCensusProgram : CProgram
trapStateCensusProgram = CProgram
  [
    CBind "trapCensusRoute" [
      CClause [PVar "n" lambdaStateLoc] (CBinPrim "/" (CLit (LInt 1)) (CLit (LInt 0)) "Int")
    ],
    CBind "trapIntentionalGap" [CClause [] (CVar "missingTrapCensus" AGlobal)],
  ]
  []
  []
  []

trapStateAbortProgram : CProgram
trapStateAbortProgram = CProgram
  [
    CBind "main" [CClause [] (CBinPrim "/" (CLit (LInt 1)) (CLit (LInt 0)) "Int")]
  ]
  []
  []
  []

-- H2b.8 ref-reader control: the ADT table forces emitRefProgram, whose late import
-- predicate is distinct from scalar's. No ePut route appears in P or U.
reemitRefTrapState : Unit -> <IO> Unit
reemitRefTrapState _ =
  let p1 = emitProgram refTrapStateInput refTrapStateProgram
  let u = emitProgram refTrapStateInput refTrapStateControlProgram
  let _ = printCapture "REF_TRAP_P1" p1
  let _ = printCapture "REF_TRAP_U" u
  printCapture "REF_TRAP_P2" (emitProgram refTrapStateInput refTrapStateProgram)

refTrapStateInput : WasmEmitInput
refTrapStateInput = makeWasmEmitInput [] [] [] False []

refTrapCtorArities : List (String, Int)
refTrapCtorArities = [("TrapToken", 0)]

refTrapCtorTypes : List (String, String)
refTrapCtorTypes = [("TrapToken", "TrapToken")]

refTrapStateProgram : CProgram
refTrapStateProgram = CProgram
  [
    CBind "refTrapRoute" [
      CClause [PVar "n" lambdaStateLoc] (CBinPrim "/" (CLit (LInt 1)) (CLit (LInt 0)) "Int")
    ],
    CBind "main" [CClause [] (CLit (LInt 17))],
  ]
  refTrapCtorArities
  refTrapCtorTypes
  []

refTrapStateControlProgram : CProgram
refTrapStateControlProgram = CProgram
  [CBind "main" [CClause [] (CLit (LInt 29))]]
  refTrapCtorArities
  refTrapCtorTypes
  []

refTrapStateAbortProgram : CProgram
refTrapStateAbortProgram = CProgram
  [
    CBind "main" [CClause [] (CBinPrim "/" (CLit (LInt 1)) (CLit (LInt 0)) "Int")]
  ]
  refTrapCtorArities
  refTrapCtorTypes
  []

implSelfInput : WasmEmitInput
implSelfInput = makeWasmEmitInput [("walk", ("Loop", 2))] [] [] False []

implSelfLoc : Loc
implSelfLoc = Loc "<impl-self-state>" 1 1 1 1

implSelfProgram : String -> Int -> Int -> CProgram
implSelfProgram tag base depth =
  let self = CVar "self" (ALocal 0 0)
  let n = CVar "n" (ALocal 0 1)
  let recurse = CApp (CApp (CMethod "walk" (RKey tag []) [] []) self) (CBinPrim "-" n (CLit (LInt 1)) "Int")
  let body = CIf (CBinPrim "==" n (CLit (LInt 0)) "Int") (CLit (LInt base)) recurse
  CProgram
    [CBind "main" [CClause [] (CLit (LInt depth))]]
    [(tag, 0)]
    [(tag, tag)]
    [
      CImplEntry "walk" 0 (CImplTagged tag tag "Loop" [0] [PVar "self" implSelfLoc, PVar "n" implSelfLoc] body)
    ]

implSelfCensusProgram : CProgram -> CProgram
implSelfCensusProgram (CProgram groups ctorArs ctorTypes impls) =
  CProgram
    (groups ++ [
      CBind "implSelfIntentionalGap" [CClause [] (CVar "missingImplSelfGap" AGlobal)]
    ])
    ctorArs
    ctorTypes
    impls

-- X-W.H2b.1: strict, record, and census emissions each own a fresh gap
-- lifecycle. The hand-built Core program deliberately reaches the same two
-- unbound-name readers in a stable order without enrolling a shared fixture.
reemitGapState : Unit -> <IO> Unit
reemitGapState _ =
  let pDecls = desugar (parse reemitStateP)
  let pProgram = typedProgram [] [] pDecls
  let pInput = reemitStateFallbackInput [] pDecls
  let p1 = emitProgram pInput pProgram
  let (recordWat, recordEvents) = emitProgramRecord gapStateInput gapStateProgram
  let censusEvents = emitProgramGaps gapStateInput gapStateProgram
  let p2 = emitProgram pInput pProgram
  let _ = printCapture "GAP_P1" p1
  let _ = printCapture "GAP_RECORD_WAT" recordWat
  let _ = printEvents "GAP_RECORD_EVENTS" recordEvents
  let _ = printEvents "GAP_CENSUS_EVENTS" censusEvents
  printCapture "GAP_P2" p2

-- The final strict emission is deliberately gap-bearing and last: the expected
-- panic proves that record/census mode cannot contaminate a later call in this
-- same process.
reemitGapStrict : Unit -> <IO> Unit
reemitGapStrict _ =
  let _ = emitProgramRecord gapStateInput gapStateProgram
  let _ = emitProgramGaps gapStateInput gapStateProgram
  let _ = putStrLn "GAP_STRICT_AFTER_RECORD_CENSUS"
  putStr (emitProgram gapStateInput gapStateProgram)

-- X-W.H2b.2: string segments belong to the fresh WasmEmit of each strict,
-- record, and census call. P covers expression, clause-pattern, and tail/non-tail
-- decision-tree string readers; U differs in both segment count and payload.
reemitStringState : Unit -> <IO> Unit
reemitStringState _ =
  let pDecls = desugar (parse reemitStringStateP)
  let uDecls = desugar (parse reemitStringStateU)
  let pInput = typedInput [] [] pDecls
  let uInput = typedInput [] [] uDecls
  let pProgram = typedProgram [] [] pDecls
  let uProgram = typedProgram [] [] uDecls
  let p1 = emitProgram pInput pProgram
  let (u, _) = emitProgramRecord uInput uProgram
  let censusEvents = emitProgramGaps gapStateInput stringCensusProgram
  let p2 = emitProgram pInput pProgram
  let _ = printCapture "STRING_P1" p1
  let _ = printCapture "STRING_RECORD_U" u
  let _ = printEvents "STRING_CENSUS_EVENTS" censusEvents
  printCapture "STRING_P2" p2

reemitStringStateP : String
reemitStringStateP = "pExpr _ = \"p-expr\"\n\npRepeat _ = \"p-expr\"\n\npClause \"p-clause\" = \"p-clause-body\"\npClause _ = \"p-clause-other\"\n\npTail x = match x\n  \"p-tail\" => \"p-tail-body\"\n  _ => \"p-tail-other\"\n\npNonTail x =\n  let y = match x\n    \"p-non-tail\" => \"p-non-tail-body\"\n    _ => \"p-non-tail-other\"\n  y\n\nmain = 71\n"

reemitStringStateU : String
reemitStringStateU =
  "uExpr _ = \"u-expr\"\n\nuOther _ = \"u-other\"\n\nmain = 82\n"

-- X-W.H2b.4: synthesized defaults are physical per-emission state. P has two
-- unexecuted call sites for one inherited default, exercising membership, mark,
-- definition append, and drain without relying on interface-ID narrowing. U differs
-- in its explicit default body; its census adds one attributed gap between P runs.
reemitDefaultState : Unit -> <IO> Unit
reemitDefaultState _ =
  let p1 = emitProgram defaultStateInputP defaultStateProgramP
  let (u, _) = emitProgramRecord defaultStateInputU defaultStateProgramU
  let censusEvents = emitProgramGaps defaultStateInputU defaultStateCensusProgramU
  let _ = printCapture "DEFAULT_P1" p1
  let _ = printCapture "DEFAULT_RECORD_U" u
  let _ = printEvents "DEFAULT_CENSUS_U_EVENTS" censusEvents
  printCapture
    "DEFAULT_P2"
    (emitProgram defaultStateInputP defaultStateProgramP)

defaultStateLoc : Loc
defaultStateLoc = Loc "<default-state>" 1 1 1 1

defaultStateInputP : WasmEmitInput
defaultStateInputP =
  makeWasmEmitInput [("synthDefault", ("DefaultFace", 1))] [] [] False []

defaultStateInputU : WasmEmitInput
defaultStateInputU =
  makeWasmEmitInput [("synthDefault", ("DefaultFace", 1))] [] [] False []

defaultStateCall : String -> CExpr
defaultStateCall tag =
  CApp (CMethod "synthDefault" (RKey tag []) [] []) (CLit LUnit)

defaultStateProgram : String -> Int -> CProgram
defaultStateProgram tag bodyConstant = CProgram
  [
    CBind "defaultRequestOne" [CClause [PVar "one" defaultStateLoc] (defaultStateCall tag)],
    CBind "defaultRequestTwo" [CClause [PVar "two" defaultStateLoc] (defaultStateCall tag)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  [
    CImplEntry "synthDefault" 0 (CImplDefault "DefaultFace" [PVar "value" defaultStateLoc] (CLit (LInt bodyConstant)))
  ]

defaultStateProgramP : CProgram
defaultStateProgramP = defaultStateProgram "PDefault" 17

defaultStateProgramU : CProgram
defaultStateProgramU = defaultStateProgram "UDefault" 29

defaultStateCensusProgramU : CProgram
defaultStateCensusProgramU = CProgram
  [
    CBind "defaultRequestOne" [CClause [PVar "one" defaultStateLoc] (defaultStateCall "UDefault")],
    CBind "defaultRequestTwo" [CClause [PVar "two" defaultStateLoc] (defaultStateCall "UDefault")],
    CBind "defaultCensusGap" [CClause [] (CVar "missingDefaultCensus" AGlobal)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  [
    CImplEntry "synthDefault" 0 (CImplDefault "DefaultFace" [PVar "value" defaultStateLoc] (CLit (LInt 29)))
  ]

-- Current-binding observation harness.  These rows deliberately only drive the
-- existing record/census/strict APIs; they do not change emitter ownership or
-- recover from a strict failure.  Every sensitive strict call is last.
bindingLoc : Loc
bindingLoc = Loc "<current-binding>" 1 1 1 1

bindingInput : WasmEmitInput
bindingInput = makeWasmEmitInput [] [] [] False []

bindingMain : CBind
bindingMain = CBind "main" [CClause [] (CLit (LInt 0))]

bindingUnsupported : CExpr
bindingUnsupported = CMatch (CLit (LInt 0)) []

-- Exercise both sensitive ref readers in one reachable expression.  Record and
-- census retain both events; strict stops at the first existing failure.
bindingSensitiveExpr : CExpr
bindingSensitiveExpr =
  CLet False PWild (CVar "missingCurrentBinding" AGlobal) bindingUnsupported

bindingRefCtorArs : List (String, Int)
bindingRefCtorArs = [("CurrentBindingForceRef", 0)]

bindingRefCtorTypes : List (String, String)
bindingRefCtorTypes = [("CurrentBindingForceRef", "CurrentBindingForceRef")]

-- The dummy constructor table selects ref-mode without placing a constructor
-- expression in a row; the row's sensitive reader is therefore the Core gap.
bindingProgram : List CBind -> CProgram
bindingProgram groups = CProgram groups bindingRefCtorArs bindingRefCtorTypes []

bindingSensitiveProgram : String -> CProgram
bindingSensitiveProgram name = bindingProgram
  [CBind name [CClause [PVar "x" bindingLoc] bindingSensitiveExpr], bindingMain]

bindingNoWriterProgram : CProgram
bindingNoWriterProgram =
  bindingProgram [CBind "P" [CClause [] bindingSensitiveExpr], bindingMain]

bindingWriterProgram : CProgram
bindingWriterProgram = bindingProgram
  [
    CBind "U" [CClause [PVar "x" bindingLoc] (CVar "x" (ALocal 0 0))],
    bindingMain,
  ]

bindingEventCaptures : String -> CProgram -> <IO> Unit
bindingEventCaptures name program =
  let (recordWat, recordEvents) = emitProgramRecord bindingInput program
  let censusEvents = emitProgramGaps bindingInput program
  let _ = printCapture (name ++ "_RECORD_WAT") recordWat
  let _ = printEvents (name ++ "_RECORD_EVENTS") recordEvents
  printEvents (name ++ "_CENSUS_EVENTS") censusEvents

captureCurrentBinding : String -> <IO> Unit
captureCurrentBinding "control" =
  let decls = desugar (parse bindingControlSource)
  printCapture
    "CBIND_CONTROL_WAT"
    (emitProgram (typedInput [] [] decls) (typedProgram [] [] decls))
captureCurrentBinding "top" =
  let program = bindingSensitiveProgram "P"
  let _ = bindingEventCaptures "CBIND_TOP" program
  let _ = putStrLn "CBIND_TOP_STRICT"
  putStr (emitProgram bindingInput program)
captureCurrentBinding "lifted" =
  -- emitLetGroupRef calls emitLgLifted before it emits this group's use-site
  -- body, so the sensitive local member is reached while currentBinding is lg:P.
  let program = bindingProgram [
    CBind "outer" [CClause [PVar "x" bindingLoc]
      (CLetGroup [CBind "P" [CClause [PVar "y" bindingLoc] bindingSensitiveExpr]]
        (CApp (CVar "P" (ALocal 0 0)) (CLit (LInt 0))))],
    bindingMain,
  ]
  let _ = bindingEventCaptures "CBIND_LIFT" program
  let _ = putStrLn "CBIND_LIFT_STRICT"
  putStr (emitProgram bindingInput program)
captureCurrentBinding "no-writer" =
  let writerWat = emitProgram bindingInput bindingWriterProgram
  let _ = printCapture "CBIND_NOWRITER_SETUP_WAT" writerWat
  let _ = putStrLn "CBIND_NOWRITER_SETUP_OK"
  let _ = bindingEventCaptures "CBIND_NOWRITER" bindingNoWriterProgram
  let _ = putStrLn "CBIND_NOWRITER_STRICT"
  putStr (emitProgram bindingInput bindingNoWriterProgram)
captureCurrentBinding "post-lift" =
  -- The local member L emits successfully before the enclosing body reaches the
  -- unsupported argument; the final strict call observes whichever binding the
  -- existing backend leaves current, without choosing a verdict here.
  let program = bindingProgram [
    CBind "P" [CClause [PVar "x" bindingLoc]
      (CLetGroup [CBind "L" [CClause [PVar "y" bindingLoc] (CVar "y" (ALocal 0 0))]]
        (CApp (CVar "L" (ALocal 0 0)) bindingSensitiveExpr))],
    bindingMain,
  ]
  let _ = bindingEventCaptures "CBIND_POSTLIFT" program
  let _ = putStrLn "CBIND_POSTLIFT_STRICT"
  putStr (emitProgram bindingInput program)
captureCurrentBinding "malformed" =
  -- A literal parameter selects clause-dispatch/ref mode structurally; this is
  -- intentionally a route boundary, not scalar patName coverage.
  let program = bindingProgram [
    CBind "Malformed" [CClause [PLit (LInt 0)] (CLit (LInt 1))],
    bindingMain,
  ]
  let _ = putStrLn "CBIND_MALFORMED_REF_ROUTE"
  printCapture "CBIND_MALFORMED_WAT" (emitProgram bindingInput program)
captureCurrentBinding _ =
  putStrLn
    "usage: --capture-current-binding <control|top|lifted|no-writer|post-lift|malformed>"

bindingControlSource : String
bindingControlSource = "data ControlRef = ControlRef Int\n\ncontrol value = match value\n  ControlRef n => n\n\nmain = control (ControlRef 0)\n"

printCapture : String -> String -> <IO> Unit
printCapture name text =
  let _ = putStrLn (name ++ "_BEGIN")
  let _ = putStrLn text
  putStrLn (name ++ "_END")

printEvents : String -> List String -> <IO> Unit
printEvents name events =
  let _ = putStrLn (name ++ "_BEGIN")
  let _ = printEventLines events
  putStrLn (name ++ "_END")

printEventLines : List String -> <IO> Unit
printEventLines [] = ()
printEventLines (event::rest) =
  let _ = putStrLn event
  printEventLines rest

gapStateInput : WasmEmitInput
gapStateInput = makeWasmEmitInput [] [] [] False []

gapStateProgram : CProgram
gapStateProgram = CProgram
  [
    CBind "gapA" [CClause [] (CVar "missingGapA" AGlobal)],
    CBind "gapB" [CClause [] (CVar "missingGapB" AGlobal)],
    CBind "main" [CClause [] (CLit (LInt 0))],
  ]
  []
  []
  []

stringCensusProgram : CProgram
stringCensusProgram = CProgram
  [
    CBind "censusString" [CClause [] (CLit (LString "census-string"))],
    CBind "gapA" [CClause [] (CVar "missingGapA" AGlobal)],
    CBind "gapB" [CClause [] (CVar "missingGapB" AGlobal)],
  ]
  []
  []
  []
