-- X-0D structural probe (#1399). This is the only executable consumer of
-- DraftSemanticProgram; LLVM, WasmGC, and the playground remain on the legacy
-- seam until V/AP validation and the later .C cutovers.

import frontend.ast.{Decl}
import types.typecheck.{mainTypeIsUnit, mainTypeIsFloat}
import ir.draft_semantic_program.{
  DraftSemanticProgram,
  buildDraftSemanticProgram,
  compareDraftSemanticProgram,
  draftWithoutFirstMethodIface,
  draftWithWrongMethodIfaceProvenance,
  draftSemanticProgramToSexp,
}
import entries.entry_support.{driveModules, runEmitWith}

main : <IO> Unit
main = driveModules (runEmitWith "runAsyncIOMain" reportDraft)

unrelatedModule : List (String, List Decl) -> (String, List Decl)
unrelatedModule [] = ("__draft_unrelated__", [])
unrelatedModule ((_, decls) :: _) = ("__draft_unrelated__", decls)

prepareDraft : List Decl ->
  List Decl ->
  List (String, List Decl) ->
  Bool ->
  Bool ->
  DraftSemanticProgram ->
  <IO> DraftSemanticProgram
prepareDraft runtimeDecls coreD modules unitHint floatHint draft =
  match getEnv "MEDAKA_DRAFT_MUTATION"
    Some "method-iface" => draftWithoutFirstMethodIface draft
    Some "method-iface-provenance" => draftWithWrongMethodIfaceProvenance draft
    Some "unrelated-control" =>
      buildDraftSemanticProgram
        runtimeDecls
        coreD
        (modules ++ [unrelatedModule modules])
        unitHint
        floatHint
    Some "same-process" =>
      let _ =
        buildDraftSemanticProgram
          runtimeDecls
          coreD
          (modules ++ [unrelatedModule modules])
          unitHint
          floatHint
      draft
    _ => draft

reportDraft : List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
reportDraft runtimeDecls coreD modules =
  let unitHint = mainTypeIsUnit ()
  let floatHint = mainTypeIsFloat ()
  let draft0 =
    buildDraftSemanticProgram runtimeDecls coreD modules unitHint floatHint
  let draft = prepareDraft runtimeDecls coreD modules unitHint floatHint draft0
  let receipts =
    compareDraftSemanticProgram
      draft
      runtimeDecls
      coreD
      modules
      unitHint
      floatHint
  putStrLn (draftSemanticProgramToSexp draft receipts)
