-- lint-disable-file rule-duplicate-body
-- (The hover/completion helpers below are DELIBERATELY reimplemented from the
--  same logic in compiler/tools/lsp.mdk rather than shared: importing lsp.mdk
--  into this entry drags in tools.fmt + io and trips a pre-existing multi-module
--  flat-union type conflation ("Token vs a -> b" at lsp.mdk's nextMode).  The
--  duplication is the cost of keeping this entry's module graph small + correct.)
-- playground_main.mdk — COMBINED diagnostics + WasmGC-emit entry for the
-- server-free in-browser Medaka playground (Stage 2).
--
-- WHY this entry exists
-- ---------------------
-- The bare emit entry (entries/wasm_emit_modules_main.mdk), when fed a
-- type-broken or parse-broken program, compiles its native diagnostic/panic path
-- to a wasm `unreachable` trap that aborts with ZERO bytes on stdout/stderr — so
-- a browser host cannot surface compile errors through it.  This entry runs the
-- REAL front end (the same `analyzeLocated`/`analyzeProject` path the native
-- `medaka check --json` uses), and:
--   * if there are check errors → prints JSON diagnostics in the SAME shape
--     `medaka check --json` emits ({"files":[{"file","diagnostics":[...]}]}),
--     then exits 0 cleanly — NO trap;
--   * if clean → emits the program's WAT (exactly as wasm_emit_modules_main does).
-- Because emit runs only AFTER a clean analyze, a well-typed program never reaches
-- the emit-panic path.
--
-- HOW MANY TIMES IT RUNS (S2/#2442 — this line used to read "ONCE" and was wrong).
-- Per invocation, over the user's program:
--   `analyze` — parsed + loaded ONCE (`run`'s `loadProgramE`, threaded downstream),
--     typechecked ONCE (`analyzeFrom`/`analyzeProject`); PLUS one further check of
--     the SYNTHETIC auto-print wrap (`underivedMainDiags`) on the bare-value mains
--     that trigger it, which is a different program and not a repeat of the same
--     work.
--     Prelude parsing+desugaring is ONCE only on the SINGLE-MODULE arm
--     (`analyzeSingle` → `analyzeFrom` fills the global content-keyed
--     `desugaredPrelude` memo, `frontend/desugar_cache.mdk`; `doEmit` below then
--     hits that memo). The MULTI-MODULE arm (`analyzeMulti` → `analyzeProject`)
--     is NOT converged: `analyzeProject`'s loader fills a separate, per-call
--     `Ref` (`preludeDesugared`, `driver/diagnostics.mdk`) that `doEmit`'s
--     `desugaredPrelude` call never sees, so on that arm `doEmit` still
--     re-parses+re-desugars runtime.mdk and core.mdk from scratch — measured
--     ~103ms/compile on the multi-module arm vs ~8ms on the single-module arm
--     (Fix-1/#2442 review round). This is a known, UNCONVERGED gap, not fixed
--     here — separate follow-up work.
--   `compile` — all of the above, plus exactly one emit-side `elaborateModules`
--     inside `runEmit`.
-- Before S2 this entry additionally re-loaded and re-parsed every user module, re-parsed
-- and re-desugared runtime.mdk + core.mdk, and ran a whole extra `elaborateModules`
-- whose result it threw away — ~161ms and ~99ms respectively of a 454ms `analyze` of a
-- four-line program, measured on the Node driver.
--
-- ARG CONTRACT (identical to wasm_emit_modules_main):
--   <runtime.mdk> <core.mdk> <entry.mdk> [root ...]
--   (roots default to [dirOf entry] when omitted)
--
-- OUTPUT-MARKER PROTOCOL (first line of stdout is the marker, rest is payload):
--   __MEDAKA_DIAGNOSTICS__\n<one-line JSON {"files":[...]}>\n        ← had check errors
--   __MEDAKA_WAT__\n<the WAT text>                                  ← clean, no warnings
--   __MEDAKA_WAT_DIAGS__\n<one-line JSON {"files":[...]}>\n<WAT>     ← clean but WARNINGS
-- present (e.g. W-NONEXHAUSTIVE): warnings never block emit (they don't in native
-- `medaka check` either), so the WAT still follows the warnings JSON line — the
-- caller shows the warnings AND runs the program.
-- The caller (playground/compile.mjs) splits on newlines: the marker line selects
-- the branch; for __MEDAKA_WAT_DIAGS__ the SECOND line is the warnings JSON and
-- everything after that is the WAT. Diagnostics JSON is byte-identical to
-- `medaka check --json` (the cj* renderers below mirror medaka_cli.mdk).
--   __MEDAKA_ANALYZE__\n<one-line JSON {"files":[...]}>\n         ← `analyze` mode
-- (diagnostics only, no codegen): no ERROR diagnostics.  The JSON line carries the
-- same warnings `__MEDAKA_WAT_DIAGS__` would have carried, or `{"files":[]}` when
-- there are none — `analyze` ALWAYS prints a marker AND a payload, so the host
-- never has to tell "clean" apart from "no output".  Errors under `analyze` use
-- `__MEDAKA_DIAGNOSTICS__`, byte-identically to `compile`.
--
-- This entry is OUTSIDE the self-host compiler graph (an entry, not imported), so
-- it needs no fixpoint/seed: the decisive checks are wasm-tools assemble/validate
-- plus the Node round-trip.  It composes EXISTING analyze + emit functions; only
-- the thin cj* JSON shaping is reproduced (those live in medaka_cli.mdk, which is
-- itself an entry and cannot be imported).

import frontend.ast.{Decl(..), Loc(..), Pat, Expr(..)}
import frontend.parser.{
  parseResult,
  parseLocated,
  ParseError,
  parseErrorLine,
  parseErrorCol,
  parseErrorMessage,
}
import frontend.desugar.{desugar}
import frontend.desugar_cache.{desugaredPrelude}
import driver.loader.{
  LoadMsg,
  LoadParseFailed,
  loadProgramE,
  unknownModuleIdOf,
  findImportLoc,
}
import driver.diagnostics.{
  analyzeProject,
  analyzeLocated,
  Diag(..),
  Severity(..),
  cjPosition,
  cjRange,
  cjRangeOfLoc,
  cjDiagnostic,
  cjFileEntry,
  cjAllToJson,
  readDiagSrc,
  parseErrCode,
  codeKind,
  diagOfTypeError,
}
import driver.main_autoprint.{
  shouldAutoPrintMain,
  autoPrintWrapModules,
  autoPrintPinCore,
  underivedMainDiags,
}
import json.{
  Json,
  JNull,
  JInt,
  JString,
  JArray,
  JObject,
  jObject,
  jArray,
  stringify,
}
import support.path.{dirOf}
import support.char.{isIdentChar, isDigit}
import support.util.{startsWith}
import types.typecheck.{
  elaborateModules,
  constrainedSigNames,
  preludeReturnPosDictNames,
  preludeArgPosDictNames,
  mainTypeIsFloat,
  mainTypeIsUnit,
  Scheme,
  ppSchemeNamedFull,
  checkOneSchemeFull,
}
import ir.core_ir_lower.{
  lowerProgramEmit,
  methodIfaceTable,
  declSigTypeNames,
  declaredRecordFieldOrders,
  ctorFieldTypeNames,
}
import backend.private_mangle.{mangleUnits}
import ir.dce.{dceFilter}
import backend.wasm_emit.{emitProgram, makeWasmEmitInput}
import backend.wasm_reach.{wasmReachFilter}

-- ARG CONTRACT (Stage 3): the FIRST arg is a MODE, dispatched below.
--   compile  <runtime> <core> <entry> [root ...]      → analyze→emit (today's behavior)
--   analyze  <runtime> <core> <entry> [root ...]      → analyze ONLY, no wasm codegen
--   hover    <runtime> <core> <entry> <line> <col>     → __MEDAKA_HOVER__ + Hover JSON
--   complete <runtime> <core> <entry> <line> <col>     → __MEDAKA_COMPLETE__ + CompletionItem[]
-- line/col are 0-based (LSP position convention).  hover/complete run a fresh
-- single-file typecheck (checkOneSchemeFull — the same env the LSP's
-- hoverFor/completionFor use on a no-import buffer) and look up the identifier /
-- prefix at the cursor.  ONE playground.wasm serves all four (the typecheck deps
-- are already linked for `compile`).
--
-- `analyze` (#2442) is `compile` minus the emit tail: it runs the IDENTICAL
-- diagnostic-producing logic — the same analyzeLocated/analyzeProject route, the
-- same main-shape guard, the same `underivedMainDiags` — and stops where `compile`
-- would call `runEmit`.  It exists because the editor's live-squiggle path
-- (playground/language-worker.js) throws the WAT away: on a clean one-liner, 596ms
-- of a 769ms `compile` was codegen nobody read.  The `emit` flag threaded through
-- run/analyzeSingle/analyzeMulti/guardedEmit/doEmit below is that fork, and it
-- diverges at exactly ONE point (`finishClean`) so the two modes cannot drift in
-- what diagnostics they report.
main : <IO> Unit
main = match args ()
  "compile"::runtimeP::coreP::entry::roots =>
    run True runtimeP coreP entry (rootsOrDefault entry roots)
  "analyze"::runtimeP::coreP::entry::roots =>
    run False runtimeP coreP entry (rootsOrDefault entry roots)
  "hover"::runtimeP::coreP::entry::rest =>
    runQuery True runtimeP coreP entry rest
  "complete"::runtimeP::coreP::entry::rest =>
    runQuery False runtimeP coreP entry rest
  _ => ePutStrLn "usage: playground_main <compile|analyze|hover|complete> <runtime.mdk> <core.mdk> <entry.mdk> [root ... | line col]"

rootsOrDefault : String -> List String -> List String
rootsOrDefault entry [] = [dirOf entry]
rootsOrDefault _ roots = roots

-- ── driver ────────────────────────────────────────────────────────────────
-- Read runtime + core, then run the front end ONCE.  Parse the user entry with
-- the non-panicking parseResult FIRST (so a parse-broken file becomes a clean
-- JSON diagnostic instead of a loader panic / wasm trap — the key playground
-- requirement).  Then route exactly as `medaka check --json` does:
--   parse error          → single located diagnostic
--   load error           → single diagnostic (missing import etc.)
--   1 module             → analyzeLocated (single-file path)
--   N modules            → analyzeProject (loader path)
-- If analysis is clean, fall through to emit.
-- `emit` False (mode `analyze`) takes the SAME route through every diagnostic
-- above and below; it only changes what happens after the last one has passed.
run : Bool -> String -> String -> String -> List String -> <IO> Unit
run emit runtimeP coreP entry roots = match readFile runtimeP
  Err e => emitLoadFail entry e
  Ok rsrc => match readFile coreP
    Err e => emitLoadFail entry e
    Ok csrc => match readFile entry
      Err e => emitLoadFail entry e
      Ok tsrc => match parseResult tsrc
        Err pe => emitParseError entry pe
        Ok _ => match loadProgramE entry roots
          -- #100: a parse/lex error in an IMPORTED module squiggles THAT module,
          -- exactly as an entry-file parse error squiggles the entry.
          Err (LoadParseFailed mpath _ pe) => emitParseError mpath pe
          Err (LoadMsg lmsg) =>
            -- Recover the failing import's own span so the squiggle lands on the
            -- bad `import` line, not line 1 (mirrors medaka_cli's F3 Chunk B
            -- entry-scan). Available-modules help is CLI-only (needs a stdlib dir
            -- listing, unavailable over the browser vfs).
            let mloc = match unknownModuleIdOf lmsg
              None => None
              Some mid => findImportLoc mid (parseLocated tsrc)
            emitDiagnostics (cjAllToJson [(entry, tsrc, [Diag SevError "R-MODULE-LOAD" lmsg mloc None None])])
          Ok mods => match mods
            [_] => analyzeSingle emit rsrc csrc tsrc entry runtimeP coreP mods
            _ => analyzeMulti emit rsrc csrc tsrc entry runtimeP coreP roots mods

-- Single module: analyzeLocated (correct single-file type errors).  Clean ⇒ emit.
-- `mods` is `run`'s ALREADY-LOADED module list, threaded through rather than
-- re-derived downstream (S2/#2442): `loadProgramE` has no memo of its own, so
-- `doEmit`'s second call re-read and re-parsed every user module.
analyzeSingle : Bool -> String -> String -> String -> String -> String -> String -> List (String, List Decl) -> <IO> Unit
analyzeSingle emit rsrc csrc tsrc entry runtimeP coreP mods =
  let diags = analyzeLocated rsrc csrc tsrc
  match any isDiagError diags
    True => emitDiagnostics (cjAllToJson [(entry, tsrc, diags)])
    False => guardedEmit emit rsrc csrc tsrc entry mods [(entry, tsrc, filterWarnings diags)]

-- Multi-module: analyzeProject (loader path).  Clean ⇒ emit.
-- #1362: `analyzeSingle` above uses the UNGUARDED `analyzeLocated` (the
-- playground has no `--allow-internal` flag or trusted-root concept); kept
-- unguarded here too (`allowInternal = True`, `trustedMods = []`) for parity.
analyzeMulti : Bool -> String -> String -> String -> String -> String -> String -> List String -> List (String, List Decl) -> <IO> Unit
analyzeMulti emit rsrc csrc tsrc entry runtimeP coreP roots mods =
  let cacheRef = Ref []
  let parseCacheRef = Ref []
  let results = analyzeProject True [] cacheRef parseCacheRef (_ => None) entry roots rsrc csrc
  let triples = map readDiagSrc results
  match any cjHasErr results
    True => emitDiagnostics (cjAllToJson triples)
    False => guardedEmit emit rsrc csrc tsrc entry mods (map warnTriple triples)

-- Keep only non-error (i.e. warning) diagnostics for a single file's list.
filterWarnings : List Diag -> List Diag
filterWarnings [] = []
filterWarnings (d::rest)
  | isDiagError d = filterWarnings rest
  | otherwise = d :: filterWarnings rest

warnTriple : (String, String, List Diag) -> (String, String, List Diag)
warnTriple (p, s, ds) = (p, s, filterWarnings ds)

-- ── main-shape guard (beginner-facing, pre-emit) ────────────────────────────
-- A clean analyze (no ERROR diagnostic) is not sufficient to guarantee emit
-- succeeds: `main` shape is only ever a WARNING out of analyze (`main () = …`,
-- W-MAIN-SHAPE) or entirely unchecked (no `main` at all) — so both a function-
-- shaped `main` and a program with no `main` fall through to `doEmit`, which
-- has no valid nullary main to force and hits a bare wasm `unreachable` trap
-- with zero diagnostic. Re-parse the user's RAW entry decls here and block on
-- either shape with a located ERROR before ever reaching the emitter. (Mirrors
-- medaka_cli.mdk's findMainFunDef/mainBodyLoc/mainArityMsg; duplicated per this
-- entry's F5 self-contained convention rather than importing the CLI entry.)
-- `warnTriples` carries the (already error-filtered) warning diags per source
-- file, so a clean-but-warning program can still surface them once we reach
-- `doEmit` below.  The main-shape guard runs FIRST and unconditionally blocks
-- on an ERROR — it never consults warnTriples.
-- Runs in BOTH modes: W-MAIN-SHAPE / W-MAIN-MISSING are diagnostics the editor
-- shows today, so `analyze` must report them exactly as `compile` does.
guardedEmit : Bool -> String -> String -> String -> String -> List (String, List Decl) -> List (String, String, List Diag) -> <IO> Unit
guardedEmit emit rsrc csrc tsrc entry mods warnTriples = match parseResult tsrc
  Err pe => emitParseError entry pe
  Ok decls => match mainShapeError decls
    Some d => emitDiagnostics (cjAllToJson [(entry, tsrc, [d])])
    None => doEmit emit rsrc csrc tsrc entry mods warnTriples

-- Find a top-level `main` DFunDef among a module's raw decls (skipping @attr
-- wrappers).  Returns its param list + body so callers can inspect arity and
-- locate the body's first ELoc span.
findMainFunDef : List Decl -> Option (List Pat, Expr)
findMainFunDef [] = None
findMainFunDef ((DAttrib _ d)::rest) = findMainFunDef (d::rest)
findMainFunDef ((DFunDef _ "main" ps body)::_) = Some (ps, body)
findMainFunDef (_::rest) = findMainFunDef rest

-- Best-effort location: the first ELoc span walking the outermost EApp spine.
mainBodyLoc : Expr -> Option Loc
mainBodyLoc (ELoc l _) = Some l
mainBodyLoc (EApp f _) = mainBodyLoc f
mainBodyLoc _ = None

-- The `main`'s own head span (`main () = `): DFunDef/Pat carry no loc, so derive
-- it from the body — the LHS runs from column 0 to the body's start column on the
-- body's line (correct for the common single-line `main () = <body>`), which
-- reads better than squiggling the body expression itself.
mainHeadLoc : Expr -> Option Loc
mainHeadLoc body =
  map ((Loc f sl sc _ _) => Loc f sl 0 sl sc) (mainBodyLoc body)

mainArityMsg : String
mainArityMsg = "'main' must be a value of type Unit. Write 'main = …', not 'main () = …' or 'main x = …' ('medaka run' never applies main; it forces a zero-arg main for its effects)"

mainMissingMsg : String
mainMissingMsg =
  "no 'main' found. Add a top-level 'main = …' (e.g. 'main = println \"hi\"')"

-- Some d ⇒ block emit with a located ERROR; None ⇒ a valid nullary main (or
-- any other shape typecheck already accepts), safe to fall through to emit.
mainShapeError : List Decl -> Option Diag
mainShapeError decls = match findMainFunDef decls
  Some (_::_, body) => Some (Diag SevError "W-MAIN-SHAPE" mainArityMsg (mainHeadLoc body) None None)
  Some ([], _) => None
  None => Some (Diag SevError "W-MAIN-MISSING" mainMissingMsg None None None)

-- ── emit (clean path) ───────────────────────────────────────────────────────
-- Identical to wasm_emit_modules_main.runEmit, prefixed by the WAT marker.  A clean
-- analyze guarantees this emit cannot hit the diagnostic/panic path.
-- S2/#2442 — CONVERGENCE ON THE CLI'S SHAPE.  This used to re-derive the whole
-- front end from source here: a SECOND `loadProgramE` (which has no memo — it
-- re-reads and re-parses every user module), plus `desugar (parse rsrc)` /
-- `desugar (parse csrc)` over runtime.mdk + core.mdk.  Both are now what
-- `medaka_cli.mdk`'s `typecheckGate`/`typecheckGateRoute` already do: the loader's
-- module list is THREADED in from `run` (the caller that loaded it), and — on the
-- SINGLE-MODULE arm only — the two prelude halves go through the content-keyed
-- `desugaredPrelude` memo that `analyzeFrom` (driver/diagnostics.mdk) already
-- filled on the way here, so this is a cache HIT, not a second desugar. The
-- MULTI-MODULE arm (`analyzeMulti` → `analyzeProject`) fills a DIFFERENT,
-- per-call `preludeDesugared` Ref instead (never `desugaredPrelude`), so on that
-- arm this call is still a cache MISS — see the header's "HOW MANY TIMES IT
-- RUNS" note; unconverged, not fixed here.
--
-- 🚨 IT ALSO RAN A WHOLE `mangleUnits` + `elaborateModules` HERE AND DISCARDED THE
-- RESULT.  That call was NOT dead — bound to `_`, but its SIDE EFFECT was
-- `mainSchemeRef`, the sole input to `mainTypeIsUnit`/`mainTypeIsAsync`/
-- `mainTypeIsFloat` and therefore to the `shouldAutoPrintMain` two lines below.
-- What retired it is that `mainSchemeRef` acquired a SECOND, equally authoritative
-- producer on BOTH arms that reach here, after this call site was written:
--   * single module — `analyzeFrom` → `checkOneDiags` → `checkModulesEntryFullSplit`
--     (#2155's SET-OR-CLEAR write);
--   * multi module  — `analyzeProject` → `typecheckPass` → `cmDiagsCollect` →
--     `setMainSchemeIfEntry` (#2246's).
-- Both run BEFORE this point on every path that reaches it, and nothing between
-- them and here writes the ref (`desugaredPrelude` and `desugarPair` are pure;
-- `underivedMainDiags` runs after, and `checkOneDiagsSynthetic` saves/restores it
-- by design).  MEASURED, not inferred (S2/#2442): an instrumented build printing all
-- three predicates plus `shouldAutoPrintMain` immediately before and after this
-- elaborate agreed on all four bits in 34/34 runs — 17 fixtures spanning Unit,
-- Int/String/Bool/List/Option/Result/tuple values, Float, an explicit `main : Int`
-- sig, a shadowed `println`, and the multi-module arm — in both modes.
-- ⚠️ Do NOT reintroduce a discarded elaborate here as "cheap insurance": it is the
-- interleaved second `Module`-arm run that #2049 (typecheck.mdk's `matchOracle`
-- obituary) is about, and its removal is what makes `analyze` elaborate the user's
-- program exactly once.
--
-- COMPOSITE-MAIN AUTO-PRINT (design §10, single-process in-browser path): a bare
-- non-Unit VALUE main is rewritten `main = <e>` → `main = println <e>` (so composite
-- mains no longer crash the emitter); a bare underived-ADT main surfaces the clean
-- `No impl of Display …` diagnostic (via the __MEDAKA_DIAGNOSTICS__ marker, NOT the WAT
-- marker).  A Unit/Async main is unchanged.
-- `underivedMainDiags` below is a DIAGNOSTIC, not part of emit, so it runs in
-- `analyze` mode too; only the `finishClean` tail is mode-dependent.
doEmit : Bool -> String -> String -> String -> String -> List (String, List Decl) -> List (String, String, List Diag) -> <IO> Unit
doEmit emit rsrc csrc tsrc entry mods warnTriples =
  let rt = desugaredPrelude rsrc
  let core = desugaredPrelude csrc
  let modules = map desugarPair mods
  if shouldAutoPrintMain core modules then
    -- coreW carries the wrap's prelude-pinned callee (autoPrintPinCore, #2185).
    let coreW = autoPrintPinCore core
    let modulesW = autoPrintWrapModules modules
    match underivedMainDiags rt coreW modulesW
      [] => finishClean emit warnTriples rt coreW modulesW
      errs => emitDiagnostics (cjAllToJson [(entry, tsrc, map diagOfTypeError errs)])
  else
    finishClean emit warnTriples rt core modules

-- ACCEPTED TRADEOFF (Val, 2026-09-01, #2442 review round F1): because `analyze`
-- deliberately never reaches `runEmit` below, it CANNOT detect a codegen-only
-- failure — an unsupported wasm construct that only trips `E-PANIC`/`unreachable`
-- inside the emitter, never surfaced as a source diagnostic by anything above this
-- point. That's the whole point of `analyze`: skipping codegen is what saves the
-- ~596ms a clean one-liner otherwise spends in `runEmit` (see the `analyze` doc
-- comment above `main`). Before `analyze` existed in its current form, every
-- keystroke ran `compile` and reached codegen, so such a gap surfaced as a
-- synthetic "compiler trap: unreachable" JS-level catch — not a real, located
-- source diagnostic either. After: `analyze` reports the program clean, and the
-- user only learns of the emitter gap on Run (when `compile` finally reaches
-- `runEmit`). Val's ruling: ship as-is — the old always-reached-codegen message
-- was arguably a worse, misleading pseudo-diagnostic for what is a compiler
-- limitation, not the user's bug. This is a deliberate, accepted tradeoff, not a
-- bug to fix here.
--
-- The ONE divergence point between `compile` and `analyze`.  Every diagnostic
-- either mode can produce has already been produced by the time control reaches
-- here, so `compile` prints the WAT marker and the WAT while `analyze` prints its
-- own marker and the same warnings JSON — no lowerProgramEmit, no wasmReachFilter,
-- no emitProgram, and no `elaborateModules` at all (`runEmit`'s is now the only one
-- on either path — see doEmit's obituary for the discarded one that used to precede
-- it, which is why `analyze` reaches here having elaborated the user's program once).
finishClean : Bool -> List (String, String, List Diag) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
finishClean emit warnTriples runtimeDecls coreDecls modules =
  if emit then
    let _ = emitWatMarker warnTriples
    runEmit runtimeDecls coreDecls modules
  else emitAnalyzeMarker warnTriples

-- `analyze`'s terminal marker: ALWAYS a marker line plus a one-line JSON payload.
-- The payload is byte-identical to the warnings JSON `emitWatMarker` writes when
-- there ARE warnings, and `{"files":[]}` when there are none — which is what
-- `compile`'s bare `__MEDAKA_WAT__` means to the host (no diagnostics at all), so
-- the two modes hand the caller the same diagnostic set either way.
emitAnalyzeMarker : List (String, String, List Diag) -> <IO> Unit
emitAnalyzeMarker warnTriples =
  let _ = putStr "__MEDAKA_ANALYZE__\n"
  match any tripleHasDiag warnTriples
    True => putStr (cjAllToJson warnTriples ++ "\n")
    False => putStr (cjAllToJson [] ++ "\n")

-- Print the plain WAT marker when there are no warnings, else the combined
-- marker (warnings JSON line, THEN the WAT) — the browser shows the warnings
-- AND still runs the program.
emitWatMarker : List (String, String, List Diag) -> <IO> Unit
emitWatMarker warnTriples = match any tripleHasDiag warnTriples
  True =>
    let _ = putStr "__MEDAKA_WAT_DIAGS__\n"
    putStr (cjAllToJson warnTriples ++ "\n")
  False => putStr "__MEDAKA_WAT__\n"

tripleHasDiag : (String, String, List Diag) -> Bool
tripleHasDiag (_, _, ds) = nonEmptyDiags ds

nonEmptyDiags : List Diag -> Bool
nonEmptyDiags [] = False
nonEmptyDiags _ = True

desugarPair : (String, List Decl) -> (String, List Decl)
desugarPair (mid, p) = (mid, desugar p)

runEmit : List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
runEmit runtimeDecls coreDecls modules =
  let (coreMangled, modulesMangled) = mangleUnits coreDecls modules
  let (coreD, modules2) = elaborateModules runtimeDecls coreMangled modulesMangled
  let allDecls0 = coreD ++ flatMap snd modules2
  let allDecls = dceFilter allDecls0
  let _ = preludeReturnPosDictNames coreD allDecls ++ preludeArgPosDictNames coreD allDecls ++ constrainedSigNames allDecls
  let input = makeWasmEmitInput (methodIfaceTable allDecls) (declSigTypeNames runtimeDecls ++ declSigTypeNames allDecls) (ctorFieldTypeNames allDecls) (mainTypeIsFloat ()) (declaredRecordFieldOrders allDecls)
  -- #2359 (F1): mirror wasm_emit_modules_main.emitTail — bind the lowered
  -- program, then drop the impl bodies (and the plain bindings only they
  -- reached) that no dispatchable method name in this program can reach.  Without
  -- this the in-browser compiler emitted ~84k lines of WAT for a one-line program.
  let lowered = lowerProgramEmit allDecls
  let filtered = wasmReachFilter lowered
  putStr (emitProgram input filtered)

-- ── diagnostics emit helpers ──────────────────────────────────────────────────
-- Print the marker then the one-line JSON, then exit 0 (NO trap).
emitDiagnostics : String -> <IO> Unit
emitDiagnostics json =
  let _ = putStr "__MEDAKA_DIAGNOSTICS__\n"
  putStr (json ++ "\n")

-- Parse error: single located diagnostic (mirrors medaka_cli runCheckJsonCmd).
emitParseError : String -> ParseError -> <IO> Unit
emitParseError entry pe =
  -- parseErrorLine is 1-based, parseErrorCol 0-based (see medaka_cli.mdk); cjRange
  -- wants 0-based LSP positions, so drop the line by one (col is already 0-based).
  let ln = parseErrorLine pe - 1
  let col = parseErrorCol pe
  let r = cjRange ln col ln (col + 1)
  let pcode = parseErrCode (parseErrorMessage pe)
  let diagJson = jObject [
    ("code", JString pcode),
    ("kind", JString (codeKind pcode)),
    ("message", JString (parseErrorMessage pe)),
    ("range", r),
    ("severity", JInt 1),
    ("source", JString "medaka"),
  ]
  let filesJson = jObject [("file", JString entry), ("diagnostics", JArray (arrayFromList [diagJson]))]
  emitDiagnostics (stringify (jObject
    [("files", JArray (arrayFromList [filesJson]))]))

-- A failed stdlib read becomes a single diagnostic too (never a trap).
emitLoadFail : String -> String -> <IO> Unit
emitLoadFail entry msg = emitDiagnostics (cjAllToJson
  [(entry, "", [Diag SevError "R-MODULE-LOAD" msg None None None])])

cjHasErr : (String, List Diag) -> Bool
cjHasErr (_, diags) = any isDiagError diags

isDiagError : Diag -> Bool
isDiagError (Diag SevError _ _ _ _ _) = True
isDiagError _ = False

-- ── hover / completion (stateless single-file language queries) ───────────────
-- These reuse the LSP's already-pure approach (compiler/tools/lsp.mdk hoverFor /
-- completionFor on a no-import buffer) WITHOUT importing lsp.mdk: they call the
-- typecheck env builder (`checkOneSchemeFull`, the same function the
-- LSP's single-file `docSchemes` path calls) and the pure identifier/prefix
-- helpers below (ported verbatim from lsp.mdk).  The playground buffer is a single
-- file (prelude only), so no project graph is ever needed.

-- hover=True → __MEDAKA_HOVER__ + a Hover JSON (or null); False → __MEDAKA_COMPLETE__
-- + a CompletionItem[] (or null).  Reads the three sources; a read/parse failure
-- degrades to a null result (never a trap), keeping the browser seam happy.
runQuery : Bool -> String -> String -> String -> List String -> <IO> Unit
runQuery isHover runtimeP coreP entry (lineS::colS::_) = match readFile runtimeP
  Err _ => emitQuery isHover JNull
  Ok rsrc => match readFile coreP
    Err _ => emitQuery isHover JNull
    Ok csrc => match readFile entry
      Err _ => emitQuery isHover JNull
      Ok tsrc => emitQuery isHover (queryResult isHover rsrc csrc tsrc (parseNat lineS) (parseNat colS))
runQuery isHover _ _ _ _ = emitQuery isHover JNull

emitQuery : Bool -> Json -> <IO> Unit
emitQuery isHover j =
  let _ = putStr (if isHover then "__MEDAKA_HOVER__\n" else "__MEDAKA_COMPLETE__\n")
  putStr (stringify j ++ "\n")

-- Build the buffer's typecheck env (core + runtime + this file), then either look
-- up the identifier under the cursor (hover) or prefix-filter the env (complete).
queryResult : Bool -> String -> String -> String -> Int -> Int -> Json
queryResult isHover rsrc csrc tsrc line col = match parseResult tsrc
  Err _ => JNull
  Ok userRaw =>
    let runtimeDecls = desugar (unwrapDecls (parseResult rsrc))
    let coreDecls = desugar (unwrapDecls (parseResult csrc))
    -- S-full-env-scheme-entry (#1116): Module arm, own schemes FIRST — kept in
    -- lockstep with `docSchemes` in tools/lsp.mdk, whose comment carries the
    -- shadowing rationale (`lookupSchemeL`/`hoverResult` are first-match scans).
    let (preludeSchemes, ownSchemes) = checkOneSchemeFull runtimeDecls coreDecls ("__user__", desugar userRaw)
    let env = ownSchemes ++ preludeSchemes
    if isHover then
      hoverResult tsrc line col env
    else
      jArray (filterCompletions (prefixBefore tsrc line col) [] env)

hoverResult : String -> Int -> Int -> List (String, Scheme) -> Json
hoverResult src line col env = match identifierAt src line col
  None => JNull
  Some name => match lookupSchemeL name env
    None => JNull
    Some sch => jHover name (ppSchemeNamedFull name sch)

-- core.mdk / runtime.mdk always parse; unwrap defensively (None → []).
unwrapDecls : Result ParseError (List Decl) -> List Decl
unwrapDecls (Ok ds) = ds
unwrapDecls (Err _) = []

-- Parse a non-negative decimal from argv (digits only; non-digits skipped).
parseNat : String -> Int
parseNat s = pnGo (stringToChars s) 0 0

pnGo : Array Char -> Int -> Int -> Int
pnGo arr i acc
  | i >= arrayLength arr = acc
  | isDigit (arrayGetUnsafe i arr) =
    pnGo arr (i + 1) (acc * 10 + (charCode (arrayGetUnsafe i arr) - 48))
  | otherwise = pnGo arr (i + 1) acc

-- ── identifier-at-cursor + prefix (pure string ops, ported from lsp.mdk) ──────
offsetOfLineCol : Array Char -> Int -> Int -> Option Int
offsetOfLineCol arr line col = offsetGo arr (arrayLength arr) 0 0 0 line col

offsetGo : Array Char -> Int -> Int -> Int -> Int -> Int -> Int -> Option Int
offsetGo arr len i curLine lineStart line col
  | curLine == line =
    let pos = lineStart + col
    if pos >= 0 && pos < len then Some pos else None
  | i >= len = None
  | arrayGetUnsafe i arr == '\n' =
    offsetGo arr len (i + 1) (curLine + 1) (i + 1) line col
  | otherwise = offsetGo arr len (i + 1) curLine lineStart line col

identStart : Array Char -> Int -> Int
identStart arr i
  | i <= 0 = 0
  | isIdentChar (arrayGetUnsafe (i - 1) arr) = identStart arr (i - 1)
  | otherwise = i

identStop : Array Char -> Int -> Int -> Int
identStop arr len i
  | i + 1 >= len = i + 1
  | isIdentChar (arrayGetUnsafe (i + 1) arr) = identStop arr len (i + 1)
  | otherwise = i + 1

identifierAt : String -> Int -> Int -> Option String
identifierAt src line col =
  let arr = stringToChars src
  let len = arrayLength arr
  match offsetOfLineCol arr line col
    None => None
    Some pos =>
      if not (isIdentChar (arrayGetUnsafe pos arr)) then
        None
      else
        Some (stringSlice (identStart arr pos) (identStop arr len pos) src)

-- The identifier prefix ending just before the cursor (for completion).
prefixBefore : String -> Int -> Int -> String
prefixBefore src line col =
  let arr = stringToChars src
  let len = arrayLength arr
  match offsetOfLineStart arr len line
    None => ""
    Some lineStart =>
      let stop = lineStart + col - 1
      if stop < lineStart then
        ""
      else if stop >= len then
        ""
      else if not (isIdentChar (arrayGetUnsafe stop arr)) then
        ""
      else
        stringSlice (prefixStart arr lineStart stop) (stop + 1) src

offsetOfLineStart : Array Char -> Int -> Int -> Option Int
offsetOfLineStart arr len line = lineStartGo arr len 0 0 0 line

lineStartGo : Array Char -> Int -> Int -> Int -> Int -> Int -> Option Int
lineStartGo arr len i curLine lineStart line
  | curLine == line = Some lineStart
  | i >= len = None
  | arrayGetUnsafe i arr == '\n' =
    lineStartGo arr len (i + 1) (curLine + 1) (i + 1) line
  | otherwise = lineStartGo arr len (i + 1) curLine lineStart line

prefixStart : Array Char -> Int -> Int -> Int
prefixStart arr lineStart i
  | i <= lineStart = lineStart
  | isIdentChar (arrayGetUnsafe (i - 1) arr) = prefixStart arr lineStart (i - 1)
  | otherwise = i

-- ── env lookup + JSON shaping (ported from lsp.mdk) ───────────────────────────
lookupSchemeL : String -> List (String, Scheme) -> Option Scheme
lookupSchemeL _ [] = None
lookupSchemeL name ((n, s)::rest)
  | name == n = Some s
  | otherwise = lookupSchemeL name rest

anyName : List String -> String -> Bool
anyName [] _ = False
anyName (x::xs) name = x == name || anyName xs name

filterCompletions : String -> List String -> List (String, Scheme) -> List Json
filterCompletions _ _ [] = []
filterCompletions prefix seen ((n, s)::rest)
  | startsWith prefix n && not (anyName seen n) = jCompletionItem n (ppSchemeNamedFull n s) :: filterCompletions prefix (n::seen) rest
  | otherwise = filterCompletions prefix seen rest

jCompletionItem : String -> String -> Json
jCompletionItem label detail = jObject
  [("label", JString label), ("kind", JInt 3), ("detail", JString detail)]

jHover : String -> String -> Json
jHover name ty =
  let value = stringConcat ["```medaka\n", name, " : ", ty, "\n```"]
  jObject
    [
      (
        "contents",
        jObject [("kind", JString "markdown"), ("value", JString value)],
      )
    ]
