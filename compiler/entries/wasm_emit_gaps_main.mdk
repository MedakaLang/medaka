-- WasmGC GAP-CENSUS driver — copy of wasm_emit_modules_main.mdk, but instead of
-- emitting WAT it runs emitProgramGaps over the whole module graph and prints one
-- recorded gap per line ("<binding>\t<reason>").  Needs NO `main` in the input.
--
-- ORIGINAL HEADER (multi-module emit driver) ---------------------------------
-- MULTI-MODULE WasmGC emit driver (slice W9) — the WasmGC peer of
-- entries/llvm_emit_modules_main.mdk, and the MVP capstone for the WasmGC
-- backend.  Where wasm_emit_typed_main.mdk runs the single-file TYPED path with
-- its OWN minimal interfaces (no real prelude, no DCE, no loader), THIS driver
-- runs the REAL `medaka build` front end:
--
--   driver.loader.loadProgram  (multi-file, dependency-first)
--     -> types.typecheck.elaborateModules  (REAL core.mdk prelude + dict-passing)
--     -> ir.core_ir_lower.lowerProgramEmitWith
--     -> ir.dce.dceFilter  (prunes the real prelude to reached decls)
--     -> backend.wasm_emit.emitProgram
--
-- so typeclass dispatch flows through the REAL `core.mdk` prelude (Eq/Ord/Num/
-- Show/Debug over real Int/Bool/String/List), and DCE shrinks that prelude to
-- exactly what each program reaches.  This is the deferred W5 integration
-- (real-prelude dispatch) plus multi-module loading.
--
--   medaka run compiler/entries/wasm_emit_modules_main.mdk <runtime.mdk> <core.mdk> <entry.mdk> [root ...]
--   (or, OCaml-free: the compiled binary test/bin/wasm_emit_modules_main <runtime.mdk> <core.mdk> <entry.mdk> [root ...])
--
-- NOTE vs the LLVM modules entry: makeWasmEmitInput carries the Wasm semantic
-- prerequisites, including the method arity needed to eta-expand the real prelude's
-- point-free impls. LLVM's additional returns-self, callback-position, and split-half
-- inputs have no Wasm analogue and stay omitted. Everything up
-- to lowerProgramEmitWith (loader, mangle, elaborateModules, dceFilter) is identical to
-- the LLVM modules driver.

import frontend.ast.{Decl}
import types.typecheck.{
  defaultDriveInputs,
  elaborateModules,
  constrainedSigNames,
  preludeReturnPosDictNames,
  preludeArgPosDictNames,
}
import ir.core_ir_lower.{
  lowerProgramEmitWith,
  methodIfaceTable,
  declaredRecordFieldOrders,
}
import types.private_mangle.{mangleUnitsEv}
import types.program_facts.{factsOfElabWith}
import ir.dce.{dceFilter}
import backend.wasm_emit.{emitProgramGaps, makeWasmEmitInputFull}
import backend.emit_plan.{buildEmitPlan}
import backend.core_validate.{Backend(..)}
import entries.entry_support.{driveModules}

main : <IO> Unit
main = driveModules runEmit

runEmit : List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit
runEmit runtimeDecls coreDecls modules =
  -- #2809: elaborate the program as written, then mangle its elaborated trees.
  let elab = elaborateModules defaultDriveInputs runtimeDecls coreDecls modules
  let (coreE, modulesE, _, _, evTable, _, _) = elab
  let (coreD, modules2, evTableM) = mangleUnitsEv evTable coreE modulesE
  let allDecls0 = coreD ++ flatMap snd modules2
  -- GAP CENSUS: do NOT run dceFilter.  DCE roots reachability from `main`, and the
  -- census input (all_modules_entry) has NO main — DCE would prune EVERY plain
  -- top-level function and the census would see nothing.  We want to emit the FULL
  -- graph to measure every node, so keep all decls.
  let allDecls = allDecls0
  let _ =
    preludeReturnPosDictNames coreD allDecls
      ++ preludeArgPosDictNames coreD allDecls
      ++ constrainedSigNames allDecls
  let input =
    makeWasmEmitInputFull
      (methodIfaceTable allDecls)
      []
      False
      False
      (declaredRecordFieldOrders allDecls)
      []
  let cp = lowerProgramEmitWith (factsOfElabWith evTableM elab) allDecls
  let gaps = emitProgramGaps input (buildEmitPlan WasmBackend cp) cp
  printGaps gaps

printGaps : List String -> <IO> Unit
printGaps [] = ()
printGaps (g :: rest) =
  let _ = putStrLn g
  printGaps rest
