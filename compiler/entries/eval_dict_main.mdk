-- DICT-PASSING execution path: like the typed path, but also dictionary-passes
-- the *user* program's `=>`-constrained functions, so a return-position method
-- used at a constraint variable's type inside a constrained function (e.g.
-- `empty` inside `f : Monoid a => a -> a`) resolves through the dict parameter
-- the caller supplies — which plain arg-tag / RKey dispatch cannot do.
--
--   medaka run compiler/entries/eval_dict_main.mdk <runtime.mdk> <prelude.mdk>... <source.mdk>
--
-- The shared tree is: desugar → `evalDictString` (`entries.entry_support`),
-- which elaborates via `elaborateOne` — the same Module-arm pipeline
-- `evalTypedString` calls for the typed path; entry_support's own comment
-- notes the two are byte-identical here, the dict-passing/typed distinction
-- being elaboration-internal — then eval.

import frontend.ast.{Decl}
import entries.entry_support.{driveRuntime, evalDictString}

main = driveRuntime emit

emit : List Decl -> List Decl -> List Decl -> <IO> Unit
emit runtimeDecls preludeDecls userDecls =
  putStr (evalDictString runtimeDecls preludeDecls userDecls)
