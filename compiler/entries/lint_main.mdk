-- Entry point for the self-hosted lint pass — THE LINT GATE'S ORACLE.  Built,
-- not interpreted:
--
--   FORCE=1 JOBS=1 sh test/build_oracles.sh --build-one lint_main
--   MEDAKA_ROOT="$ROOT" test/bin/lint_main <source.mdk>   # what the `diff_compiler_lint`
--   row of test/diff_compiler_fmt_test.mdk runs — MEDAKA_ROOT is exported before invoking
--   the binary. A bare
--   invocation without MEDAKA_ROOT set silently reports NOTHING (the stdlib
--   reference index builds empty), it does not error.
--
-- `medaka run compiler/entries/lint_main.mdk <source.mdk>` does not work.  This entry builds the stdlib
-- reference index (`tools.lint.buildStdlibIndexResult`, needed so the gate oracle and
-- the `medaka lint` CLI feed their rules the SAME inputs), and lexing all 29
-- stdlib files under the tree-walking interpreter exceeds its 25000-frame depth
-- cap: `frontend/lexer.mdk: runtime error [E-STACK-OVERFLOW]`.  Nothing in the
-- tree ran this entry interpreted, so this costs no caller — but do not put the
-- `medaka run` form back into a script without solving that first.
--
-- Parses the target (NO desugar — the lint rules detect surface shapes that
-- desugar lowers away), runs every rule in the registry, and prints one finding
-- per line as `<severity>: [<rule>] <message>` (location-stripped; the golden
-- harness sorts).  Mirror of compiler/entries/exhaust_main.mdk.

import frontend.parser.{parseWithPositionsLocated}
import string.{contains, join, lines, stripPrefix}
import tools.lint.{
  lintToLines, buildStdlibIndexResult, splitLintNames, StdlibIndexError(..)
}
import driver.diagnostics.{ppDiagCliSrc}
import support.stage_count.{stageExit}

export
oracleMain : Unit -> <IO> Unit
oracleMain () = match args ()
  [targetPath] => withTarget [] targetPath
  [flag, targetPath] => match stripPrefix "--only=" flag
    Some names => withTarget (splitLintNames names) targetPath
    None => ePutStrLn "unknown flag \{flag}"
  _ =>
    ePutStrLn
      "usage: MEDAKA_ROOT=<repo> test/bin/lint_main [--only=<rules>] <file.mdk>"

-- Keeps only the report lines of the named rules (all lines for an empty
-- list), so a fixture golden depends on the one rule it is about.
onlyRules : List String -> String -> String
onlyRules [] report = report
onlyRules names report =
  join
    "\n"
    (filter (l => any (n => contains ": [\{n}] " l) names) (lines report))

withTarget : List String -> String -> <IO> Unit
withTarget only targetPath = match readFile targetPath
  Ok targetSrc =>
    -- `parseWithPositionsLocated` (#649): findings print location-STRIPPED
    -- here, but inline `-- lint-disable-line`/`-next-line` suppression still
    -- keys off each Finding's real location, so a nested detector hit
    -- needs its own span rather than the enclosing decl's to suppress right.
    let (decls, pos) = parseWithPositionsLocated targetSrc
    -- The stdlib reference index, built ONCE here (a rule's `check` is pure, so
    -- it cannot read the stdlib itself).  This entry is the LINT GATE'S ORACLE:
    -- if it ran on an empty index while the CLI ran on a real one, the gate
    -- would go green on output the CLI never produces.  Both build the same way.
    match buildStdlibIndexResult
      Ok idx =>
        putStr (onlyRules only (lintToLines idx targetSrc targetPath pos decls))
      Err (StdlibIndexError { path, source, diagnostic }) =>
        ePutStrLn (ppDiagCliSrc source path diagnostic)
        stageExit 1
  Err msg => ePutStrLn msg

main = oracleMain ()
