-- Shared scaffolding for the per-stage probe entry points (compiler/entries/*.mdk).
--
-- Every `medaka run` probe repeats the same loader/setup boilerplate: read a
-- runtime.mdk + prelude*.mdk + target.mdk off argv, parse+desugar each, then hand
-- the three decl lists to a single terminal-stage call (eval / lower+eval / emit).
-- The ONLY per-probe difference is that terminal call, so the scaffolding lives
-- here once and each probe collapses to its unique terminal + a one-line `main`.
--
-- These are `medaka run` scripts — NOT compiled into the `medaka` binary and NOT
-- in the emitter seed graph — so this module may freely import the whole compiler.

import frontend.ast.{Decl}
import types.typecheck.{TcDiag}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
export import support.util.{rootsOrDefault}
import support.util.{splitLast}
import types.typecheck.{
  elaborateOne,
  elaborateModules,
  hadTypeErrors,
  setLocalPinDisabled,
}
import driver.diagnostics.{
  emitDiagExitCode,
  emitGateDiags,
  renderTcDiags,
  residualOrGeneric,
}
import eval.eval.{evalOneOutput, funNamesOf, dropShadowedExp}
import driver.loader.{
  dropPathTriple,
  loadErrorMessage,
  loadProgramFilesLocatedE,
  modIdToPath,
  unknownModuleIdOf,
}
import backend.private_mangle.{mangleUnitsEv}
import driver.main_autoprint.{
  shouldAutoPrintMain,
  autoPrintWrapModules,
  autoPrintPinCore,
  underivedMainDiags,
  shouldAsyncWrapMain,
  asyncWrapModules,
  asyncMainShapeError,
}

-- ── failure ──────────────────────────────────────────────────────────────────

-- EVERY error path in these probe drivers must exit NON-ZERO (issue #440).
--
-- These probes' output contract is "the artifact on STDOUT" (IR, an S-expr dump,
-- a decl listing).  So an error path that prints to stderr and falls through to a
-- 0 exit hands a redirecting harness `> out.ll` an EMPTY FILE plus SUCCESS —
-- indistinguishable from a real emit, and invisible to the near-universal
-- `2>/dev/null` idiom that hides the only evidence.  `cmd > out.ll || die` never
-- fires.  That is this repo's #1 documented failure class: a step that can
-- silently no-op will, and "green" is not "ran" (empty-vs-empty diffs "identical").
--
-- #440 was filed against ONE path (driveModules' usage/arity error, the one an
-- agent tripped over).  It was under-scoped: this module had ZERO `exit` calls
-- against 21 error paths, and is imported by 22 entry probes — so the bug was
-- every error path in every probe, including a nonexistent input file and a real
-- typecheck diagnostic, which are far likelier in a harness than a wrong arity.
--
-- Route every such path through `failWith` rather than a bare `ePutStrLn`.
export
failWith : String -> <IO> Unit
-- lint-disable-next-line rule-duplicate-body
failWith msg =
  let _ = ePutStrLn msg
  exit 1

-- ── file readers ───────────────────────────────────────────────────────────────

-- parse + desugar each prelude file in order, concatenating their decls.
export
readAllDecls : List String -> <IO> Result String (List Decl)
readAllDecls [] = Ok []
readAllDecls (p :: rest) = match readFile p
  Err msg => Err msg
  Ok src => map (desugar (parse src) ++ _) (readAllDecls rest)

-- read each target file, keeping (path, source) pairs in order (for batch harnesses
-- that need the path to prefix each section's sentinel).
export
readAllSources : List String -> <IO> Result String (List (String, String))
readAllSources [] = Ok []
readAllSources (p :: rest) = match readFile p
  Err msg => Err msg
  Ok src => map ((p, src) :: _) (readAllSources rest)

-- ── single-target drivers ────────────────────────────────────────────────────

-- CLI shape: <runtime.mdk> <prelude.mdk>... <target.mdk>.  Reads + parses + desugars
-- all three, then calls `emit runtimeDecls preludeDecls userDecls` (which prints).
export
driveRuntime : (List Decl -> List Decl -> List Decl -> <IO> Unit) -> <IO> Unit
driveRuntime emit = driveRuntimeArgs (args ()) emit

-- same as driveRuntime, but takes the argv explicitly so a probe can strip a leading
-- flag (e.g. the argstamp parity probe's ON|OFF mode) before dispatching.
export
driveRuntimeArgs : List String ->
  (List Decl -> List Decl -> List Decl -> <IO> Unit) ->
  <IO> Unit
driveRuntimeArgs (runtimePath :: rest) emit = match splitLast rest
  Some (preludePaths, targetPath) => match readFile runtimePath
    Ok rsrc => match readAllDecls preludePaths
      Ok preludeDecls => match readFile targetPath
        Ok tsrc =>
          emit (desugar (parse rsrc)) preludeDecls (desugar (parse tsrc))
        Err msg => failWith msg
      Err msg => failWith msg
    Err msg => failWith msg
  None => failWith usageRuntime
driveRuntimeArgs _ emit = failWith usageRuntime

-- CLI shape: <prelude.mdk>... <target.mdk> (no separate runtime).  Calls
-- `emit preludeDecls userDecls` (which prints).
export
drivePrelude : (List Decl -> List Decl -> <IO> Unit) -> <IO> Unit
drivePrelude emit = match splitLast (args ())
  Some (preludePaths, targetPath) => match readAllDecls preludePaths
    Ok preludeDecls => match readFile targetPath
      Ok tsrc => emit preludeDecls (desugar (parse tsrc))
      Err msg => failWith msg
    Err msg => failWith msg
  None => failWith usagePrelude

export
usageRuntime : String
usageRuntime = "usage: <runtime.mdk> <prelude.mdk>... <file.mdk>"

export
usagePrelude : String
usagePrelude = "usage: <prelude.mdk>... <file.mdk>"

export
usageModules : String
usageModules = "usage: <runtime.mdk> <core.mdk> <entry.mdk> [root ...]"

-- CLI shape: <runtime.mdk> <core.mdk> <entry.mdk> [root ...].  Loads <entry.mdk>
-- + its transitive imports via the loader (dependency-first), desugars runtime +
-- core + every loaded module, then calls `runEmit runtimeDecls coreDecls modules`
-- (which owns elaboration/lowering/emission and does its own IO).  Shared by the
-- LLVM/WasmGC multi-module emit drivers (llvm_bootstrap_lex_main,
-- llvm_emit_modules_main, wasm_emit_gaps_main, wasm_emit_modules_main).
export
driveModules : (List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  <IO> Unit
driveModules runEmit = driveModulesLocated (_ => runEmit)

-- `driveModules` for a terminal that needs the loader's `(modId, path, decls)`
-- triples as well — the emit drivers do, because since the parent `medaka build`
-- process stopped typechecking they own the located diagnostics for the build
-- and need each module's own file to render against.
export
driveModulesLocated : (List (String, String, List Decl) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  <IO> Unit
driveModulesLocated runEmit = match args ()
  runtimeP :: coreP :: entry :: roots =>
    driveModulesGo runEmit runtimeP coreP entry (rootsOrDefault entry roots)
  _ => failWith usageModules

-- Kept as a local one-liner in each of its three call sites (here,
-- tools/test_cmd.mdk, driver/medaka_cli.mdk) rather than moved to
-- support/util.mdk: it composes `desugar`, and support/util.mdk is imported
-- BY frontend/desugar.mdk, so importing desugar back into support/util would
-- be a module cycle.
export
desugarPair : (String, List Decl) -> (String, List Decl)
desugarPair (mid, p) = (mid, desugar p)

-- The loader is the LOCATED one (`parseLocatedResult`, real spans + each
-- module's path), not `loadProgram`: this driver renders the build's type
-- diagnostics itself, and placeholder 1:0 spans with no path render them as
-- `(module <mid>)` with no caret.  `ELoc` is transparent to every backend, so
-- the emitted IR is unchanged by the swap.
driveModulesGo : (List (String, String, List Decl) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  String ->
  String ->
  String ->
  List String ->
  <IO> Unit
driveModulesGo runEmit runtimeP coreP entry roots = match readFile runtimeP
  Err e => failWith e
  Ok rsrc => match readFile coreP
    Err e => failWith e
    Ok csrc => match loadProgramFilesLocatedE (_ => None) entry roots
      Err e => failWith (moduleLoadHint (loadErrorMessage e))
      Ok mods =>
        runEmit
          mods
          (desugar (parse rsrc))
          (desugar (parse csrc))
          (map desugarPair (map dropPathTriple mods))

-- #1796: `usageModules`' `[root ...]` bracket notation reads as "root args are
-- optional" — they aren't, the moment the entry graph spans more than one root
-- directory (e.g. both `compiler` and `stdlib`).  Omitting them degrades to a
-- bare loader `unknown module: X` with no hint that ROOT arguments are the
-- fix.  Same gate + suffix convention as `moduleLoadErrText`'s
-- `availableModulesHint` (medaka_cli.mdk): `unknownModuleIdOf` recognizes the
-- one loader message shape this applies to, and every other loader error
-- (cycle / unreadable file) passes through unchanged.
moduleLoadHint : String -> String
moduleLoadHint e = match unknownModuleIdOf e
  None => e
  Some _ => stringConcat [
    e, " — did you forget to pass every root search directory? ", usageModules
  ]

-- ── shared composite-main emit glue (parameterized by the backend's emitTail) ──
-- The LLVM and WasmGC multi-module emit drivers had byte-identical runEmit +
-- emitModules bodies (composite-main auto-print wrap glue); their ONLY difference
-- is the backend-specific `emitTail`.  These two helpers host that shared glue
-- once, taking `emitTail` as a function parameter, so each driver keeps only its
-- backend `emitTail` and calls `driveModules (runEmitWith emitTail)`.
--
-- COMPOSITE-MAIN AUTO-PRINT (design §10): after the elaborate that learns main's
-- type, a bare non-Unit VALUE main is rewritten `main = <e>` → `main = println
-- <e>` and re-emitted; a bare underived-ADT main surfaces the clean `No impl of
-- Display …` error.  A `main : Async _` is rewritten to apply the `async`
-- module's driver named by `asyncDriver` (`runAsyncIOMain` for a target with a
-- clock, `runAsyncMain` otherwise; both declare a `Unit` result so no backend
-- auto-prints it) and re-emitted — see main_autoprint.
-- asyncWrapModules (#2506).  A Unit main (incl. every compiler-graph main)
-- takes the unchanged path, so emitter output on the compiler graph is
-- byte-identical.
-- The test-only `MEDAKA_ARGTAG_UNPIN=1` hatch (`test/argtag_matrix_fixtures/CENSUS.md`)
-- drops the local-pin channels so the `T-LOCAL-CONSTRAINED-MONO` region typechecks and
-- the engines' behaviour on it can be observed.  `medaka_cli` arms it for `check`/`run`
-- (`argtagUnpinRequested`); this driver runs in the separate `medaka_emitter` process
-- and must arm it too, or its own elaboration still records the pin error — which the
-- #2089 gate below would then reject under `MEDAKA_STRICT=1`, hiding exactly the
-- region the census exists to observe.  Same three-way read as the CLI's: only a
-- non-empty value arms it, so an unset flag fails CLOSED.
argtagUnpinArmed : Unit -> <IO> Bool
argtagUnpinArmed () = match getEnv "MEDAKA_ARGTAG_UNPIN"
  Some v => v /= ""
  None => False

-- #2089: the emit driver's own elaboration is the only `elaborateModules` caller
-- that never read `hadTypeErrors` afterwards — a type error surfaced only on this
-- path (the mangled tree, or the compiler's own graph on the bootstrap, which never
-- passes through `medaka build`'s CLI gate) reached codegen at exit 0.  The gate is
-- HARD: ruling 3 made this process `build`'s only typecheck, so nothing downstream
-- would reject the program, and `MEDAKA_STRICT=1` no longer selects between two
-- behaviours.
--
-- Residual-only arm: the graph-end drain's own diagnostics, which the per-module
-- lists cannot carry (they close before the drain runs).  Reached from the wrapped
-- re-elaboration, whose per-module diagnostics `emitFullGate` already rendered for
-- the unwrapped program.
emitResidualGate : List (String, String) ->
  String ->
  List (String, TcDiag) ->
  <IO> Unit
emitResidualGate pathMap target residual =
  if hadTypeErrors () then
    let _ = ePutStrLn (residualOrGeneric pathMap target residual)
    exit emitDiagExitCode

-- The whole diagnostic verdict for a build, rendered as `medaka check` renders
-- it: this process is the only one that typechecks the graph, so the warnings go
-- out even when the build goes on to succeed and an error stops it before the
-- backend.  `emitDiagExitCode` tells the parent that what reached its stderr is a
-- located diagnostic and needs no "emitter failed" preamble wrapped around it.
emitFullGate : List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  List (String, (List TcDiag, List TcDiag)) ->
  List (String, TcDiag) ->
  <IO> Unit
emitFullGate modsWithPath runtimeDecls coreDecls modules perMod residual =
  let (errLines, warnLines) =
    emitGateDiags runtimeDecls coreDecls modsWithPath modules perMod
  let pathMap = map modIdToPath modsWithPath
  match errLines
    -- Warnings ride the CLEAN path only, which is what `check` does with the same
    -- diagnostics: once a program has an error the errors are the whole report.
    -- Printing both made a rejecting `build` louder than `medaka check` on the
    -- same file, and louder than this same `build` was before the child owned the
    -- verdict.
    [] =>
      let _ = map ePutStrLn warnLines
      emitResidualGate pathMap (entryPathOf modsWithPath) residual
    _ =>
      let _ = map ePutStrLn errLines
      exit emitDiagExitCode

-- The auto-print / async wrap re-checks the WRAPPED program, and its diagnostics
-- are about the user's own `main`.  They go out through the same located face as
-- every other diagnostic of a build: `failWith` prints a bare message, so on the
-- one path that reached it the reader lost the file, the line and the caret that
-- `medaka check` gives them for the identical program.
emitWrapDiags : List (String, String, List Decl) -> List TcDiag -> <IO> Unit
emitWrapDiags modsWithPath ds =
  let mid = entryMidOf modsWithPath
  let _ =
    map
      ePutStrLn
      (renderTcDiags (map modIdToPath modsWithPath) (map (d => (mid, d)) ds))
  exit emitDiagExitCode

-- The entry module's path, for the residual's fallback text.  The loader is
-- dependency-first, so the entry is last.
entryPathOf : List (String, String, List Decl) -> String
entryPathOf [] = ""
entryPathOf [(_, path, _)] = path
entryPathOf (_ :: rest) = entryPathOf rest

entryMidOf : List (String, String, List Decl) -> String
entryMidOf [] = ""
entryMidOf [(mid, _, _)] = mid
entryMidOf (_ :: rest) = entryMidOf rest

export
runEmitWith : String ->
  (List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
runEmitWith asyncDriver emitTail modsWithPath runtimeDecls coreDecls modules =
  let _ = setLocalPinDisabled (argtagUnpinArmed ())
  -- #2809: ELABORATE THE PROGRAM THE USER WROTE, then mangle its elaborated trees.
  -- Elaboration reads the import structure (`DUse` member spellings, alias locals) and
  -- groups denotations by name, and the mangler rewrites definitions and references but
  -- never a `DUse` — so elaborating a mangled graph made every import-keyed table miss
  -- and gave two mangled denotations two distinct names.  This order makes the child's
  -- verdict equal `check`'s by construction; `mangleUnitsEv` then renames the elaborated
  -- trees AND the evidence table's `RLocal` routes.  Each branch below mangles exactly
  -- once, after its own elaboration.
  let (coreE, modulesE, perMod, residual, _) =
    elaborateModules runtimeDecls coreDecls modules
  -- Both halves of the fold now read the trees the loader parsed: the elaboration
  -- above is the user's own program, so a diagnostic names the constructors and
  -- imports the user wrote (#2809).
  let _ =
    emitFullGate modsWithPath runtimeDecls coreDecls modules perMod residual
  if shouldAutoPrintMain coreDecls modules then
    -- the wrap's callee is a PRELUDE re-binding, so the core decl list has to
    -- carry it — see main_autoprint.autoPrintPinCore (#2185 / F1 / F2).
    let coreW = autoPrintPinCore coreDecls
    let modulesW = autoPrintWrapModules modules
    match underivedMainDiags runtimeDecls coreW modulesW
      [] => emitModulesWith emitTail modsWithPath runtimeDecls coreW modulesW
      ds => emitWrapDiags modsWithPath ds
  else match asyncMainShapeError modules
    Some msg => failWith msg
    None =>
      if shouldAsyncWrapMain asyncDriver modules then
        -- Re-check the WRAPPED program, as the auto-print branch does: the
        -- rewrite applies the driver to `main`, and a program whose `Async`
        -- is not the driver's (a look-alike type, a mismatched row) must fail
        -- here with a type error, not in the emitter or at run time.
        let modulesW = asyncWrapModules asyncDriver modules
        match underivedMainDiags runtimeDecls coreDecls modulesW
          [] =>
            emitModulesWith
              emitTail
              modsWithPath
              runtimeDecls
              coreDecls
              modulesW
          ds => emitWrapDiags modsWithPath ds
      else
        let (coreD, modules2) = mangleUnitsEv coreE modulesE
        emitTail runtimeDecls coreD modules2

-- Elaborate + mangle + emit a (possibly wrapped) module list from scratch.
export
emitModulesWith : (List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
emitModulesWith emitTail modsWithPath runtimeDecls coreDecls modules =
  let _ = setLocalPinDisabled (argtagUnpinArmed ())
  -- Elaborate first, mangle after — see `runEmitWith` (#2809).
  let (coreE, modulesE, _, residual, _) =
    elaborateModules runtimeDecls coreDecls modules
  let _ =
    emitResidualGate
      (map modIdToPath modsWithPath)
      (entryPathOf modsWithPath)
      residual
  let (coreD, modules2) = mangleUnitsEv coreE modulesE
  emitTail runtimeDecls coreD modules2

-- ── shared terminal computations ─────────────────────────────────────────────
-- Identical across the _main and _batch variants of the same stage, so they live
-- here rather than being copy-pasted per probe.

-- TYPED path: drop prelude fns the user shadows, elaborate (typecheck stamps the
-- EMethodAt routes), eval for stdout.  Shared by eval_typed_main + eval_typed_batch.
export
evalTypedString : List Decl -> List Decl -> List Decl -> String
evalTypedString runtimeDecls preludeDecls userDecls =
  let livePrelude = dropShadowedExp (funNamesOf userDecls) preludeDecls
  evalOneOutput [] (
    "__main__",
    elaborateOne runtimeDecls livePrelude ("__user__", userDecls),
  )

-- DICT-PASSING path: routes through the 1-module case of the multi-module path
-- (elaborateOne owns the dict-set + per-module eval).  Byte-identical to the TYPED
-- path here — the difference is elaboration-internal.  Shared by eval_dict_main +
-- eval_dict_batch.
export
evalDictString : List Decl -> List Decl -> List Decl -> String
evalDictString runtimeDecls preludeDecls userDecls =
  let userNames = funNamesOf userDecls
  let livePrelude = dropShadowedExp userNames preludeDecls
  evalOneOutput [] (
    "__main__",
    elaborateOne runtimeDecls livePrelude ("__user__", userDecls),
  )

-- ── batch drivers ────────────────────────────────────────────────────────────

-- strict per-target IO loop: for each target path, print `sentinel <path>\n` then
-- `render <decls>\n`, evaluating + printing each target STRICTLY before the next
-- (the self-hosted evaluator reseeds a global ctor->type table per program, so a
-- lazy string-builder could force one program's dispatch after the next clobbers
-- that table).
export
batchLoop : String -> (List Decl -> String) -> List String -> <IO> Unit
batchLoop sentinel render [] = putStr ""
batchLoop sentinel render (path :: rest) = match readFile path
  Err msg =>
    let _ = ePutStrLn msg
    batchLoop sentinel render rest
  Ok src =>
    let _ = putStr "\{sentinel}\{path}\n\{render (desugar (parse src))}\n"
    batchLoop sentinel render rest

-- batch CLI shape: <runtime.mdk> <core.mdk> <target.mdk>...  runtime + core parsed
-- + desugared ONCE, then `render runtimeDecls coreDecls targetDecls` per target.
export
driveRuntimeBatch : String ->
  (List Decl -> List Decl -> List Decl -> String) ->
  <IO> Unit
driveRuntimeBatch sentinel render = match args ()
  runtimePath :: corePath :: targets => match readFile runtimePath
    Err msg => failWith msg
    Ok rsrc => match readFile corePath
      Err msg => failWith msg
      Ok csrc =>
        let runtimeDecls = desugar (parse rsrc)
        let coreDecls = desugar (parse csrc)
        batchLoop sentinel (render runtimeDecls coreDecls) targets
  _ => failWith usageRuntime

-- lazy batch CLI shape: <runtime.mdk> <core.mdk> <target.mdk>...  runtime + core
-- PARSED (raw, not desugared — resolve/check take the raw AST), all target sources
-- read, then `render runtimeParsed coreParsed [(path,src)]` builds one output blob.
export
driveParseSources : (List Decl -> List Decl -> List (String, String) -> String) ->
  <IO> Unit
driveParseSources render = match args ()
  runtimePath :: corePath :: targets => match readFile runtimePath
    Err msg => failWith msg
    Ok rsrc => match readFile corePath
      Err msg => failWith msg
      Ok csrc => match readAllSources targets
        Err msg => failWith msg
        Ok srcs => putStr (render (parse rsrc) (parse csrc) srcs)
  _ => failWith usageRuntime
