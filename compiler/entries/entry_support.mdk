-- ── failure ──────────────────────────────────────────────────────────────────

-- EVERY error path in these probe drivers must exit NON-ZERO (issue #440).
--
-- These probes' output contract is "the artifact on STDOUT" (IR, an S-expr dump,
-- a decl listing).  So an error path that prints to stderr and falls through to a
-- 0 exit hands a redirecting harness `> out.ll` an EMPTY FILE plus SUCCESS —
-- indistinguishable from a real emit, and invisible to the near-universal
-- `2>/dev/null` idiom that hides the only evidence.  `cmd > out.ll || die` never
-- fires.  That is this repo's #1 documented failure class: a step that can
-- silently no-op will, and "green" is not "ran" (empty-vs-empty diffs "identical").
--
-- #440 was filed against ONE path (driveModules' usage/arity error, the one an
-- agent tripped over).  It was under-scoped: this module had ZERO `exit` calls
-- against 21 error paths, and is imported by 22 entry probes — so the bug was
-- every error path in every probe, including a nonexistent input file and a real
-- typecheck diagnostic, which are far likelier in a harness than a wrong arity.
--
-- Route every such path through `failWith` rather than a bare `ePutStrLn`.
--
-- Structurally identical to `driver/medaka_cli.dieMsg`, and deliberately not
-- consolidated with it: this module is `medaka run`-only harness scaffolding
-- and is free to import the whole compiler, while medaka_cli.mdk is compiled
-- into the shipped binary and sits in the emitter seed graph, so the
-- dependency can only ever point one way — and not this way.
export
failWith : String -> <IO> Unit
-- lint-disable-next-line rule-duplicate-body
failWith msg =
  let _ = ePutStrLn msg
  stageExit 1

-- ── file readers ───────────────────────────────────────────────────────────────

-- parse + desugar each prelude file in order, concatenating their decls.
export
readAllDecls : List String -> <IO> Result String (List Decl)
readAllDecls [] = Ok []
readAllDecls (p :: rest) = match readFile p
  Err msg => Err msg
  Ok src => map (desugar (parse src) ++ _) (readAllDecls rest)

-- read each target file, keeping (path, source) pairs in order (for batch harnesses
-- that need the path to prefix each section's sentinel).
export
readAllSources : List String -> <IO> Result String (List (String, String))
readAllSources [] = Ok []
readAllSources (p :: rest) = match readFile p
  Err msg => Err msg
  Ok src => map ((p, src) :: _) (readAllSources rest)

-- ── single-target drivers ────────────────────────────────────────────────────

-- CLI shape: <runtime.mdk> <prelude.mdk>... <target.mdk>.  Reads + parses + desugars
-- all three, then calls `emit runtimeDecls preludeDecls userDecls` (which prints).
export
driveRuntime : (List Decl -> List Decl -> List Decl -> <IO> Unit) -> <IO> Unit
driveRuntime emit = driveRuntimeArgs (args ()) emit

-- same as driveRuntime, but takes the argv explicitly so a probe can strip a leading
-- flag (e.g. the argstamp parity probe's ON|OFF mode) before dispatching.
export
driveRuntimeArgs : List String ->
  (List Decl -> List Decl -> List Decl -> <IO> Unit) ->
  <IO> Unit
driveRuntimeArgs (runtimePath :: rest) emit = match splitLast rest
  Some (preludePaths, targetPath) => match readFile runtimePath
    Ok rsrc => match readAllDecls preludePaths
      Ok preludeDecls => match readFile targetPath
        Ok tsrc =>
          emit (desugar (parse rsrc)) preludeDecls (desugar (parse tsrc))
        Err msg => failWith msg
      Err msg => failWith msg
    Err msg => failWith msg
  None => failWith usageRuntime
driveRuntimeArgs _ emit = failWith usageRuntime

-- CLI shape: <prelude.mdk>... <target.mdk> (no separate runtime).  Calls
-- `emit preludeDecls userDecls` (which prints).
export
drivePrelude : (List Decl -> List Decl -> <IO> Unit) -> <IO> Unit
drivePrelude emit = match splitLast (args ())
  Some (preludePaths, targetPath) => match readAllDecls preludePaths
    Ok preludeDecls => match readFile targetPath
      Ok tsrc => emit preludeDecls (desugar (parse tsrc))
      Err msg => failWith msg
    Err msg => failWith msg
  None => failWith usagePrelude

export
usageRuntime : String
usageRuntime = "usage: <runtime.mdk> <prelude.mdk>... <file.mdk>"

export
usagePrelude : String
usagePrelude = "usage: <prelude.mdk>... <file.mdk>"

export
usageModules : String
usageModules = "usage: <runtime.mdk> <core.mdk> <entry.mdk> [root ...]"

-- CLI shape: <runtime.mdk> <core.mdk> <entry.mdk> [root ...].  Loads <entry.mdk>
-- + its transitive imports via the loader (dependency-first), desugars runtime +
-- core + every loaded module, then calls `runEmit runtimeDecls coreDecls modules`
-- (which owns elaboration/lowering/emission and does its own IO).  Shared by the
-- LLVM/WasmGC multi-module emit drivers (llvm_bootstrap_lex_main,
-- llvm_emit_modules_main, wasm_emit_gaps_main, wasm_emit_modules_main).
export
driveModules : (DriveInputs -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  <IO> Unit
driveModules runEmit =
  driveModulesLocated (ask _ => runEmit (emitDriveInputs !selectedProfile ask))

-- What an emit is handed beside its graph: the prelude sources the graph's
-- prelude decls were desugared from, on the `--json` route the envelope file and
-- what the gate kept for it (`None` on every other route), and the graph's stdlib
-- ownership (`stdlibOwnership`: the flat entry's, then the owned module ids).
public export data EmitAsk = EmitAsk {
  askPreludeSrcs : (String, String),
  askJson : Option (String, JsonFront),
  askOwnership : (Bool, List String),
}

-- The inputs of an emit's drive under [profile], with the graph's stdlib ownership
-- and the prelude key of the sources the graph's prelude decls were desugared from.
emitDriveInputs : Option TargetProfile -> EmitAsk -> DriveInputs
emitDriveInputs profile ask = match (ask.askOwnership, ask.askPreludeSrcs)
  ((flatEntry, owned), (rsrc, csrc)) => { driveInputsFor profile flatEntry owned |
    diPreludeKey = Some (preludeGeneration rsrc csrc),
  }

-- The prelude's interface and elaborated trees beside `core.mdk` in [stdlibDir],
-- held for this process when the spawning `medaka` named its compiler identity
-- (`preludeCompilerEnv`); with none, or with a file that does not load, the
-- drive elaborates core as it always did.  This process prints nothing about
-- either file: the verb that spawned it reports the verdict.
holdShippedPrelude : String -> String -> String -> <IO> Unit
holdShippedPrelude stdlibDir rsrc csrc = match getEnv preludeCompilerEnv
  None => ()
  Some "" => ()
  Some id =>
    let inputs = { shippedInputs stdlibDir rsrc csrc | pnCompiler = id }
    let _ = loadPreludeInterface inputs
    let _ = loadPreludeElab inputs
    ()

-- `driveModules` for a terminal that needs the loader's `(modId, path, decls)`
-- triples and the route's ask (`runEmitAsked`) as well — the emit drivers do,
-- because since the parent `medaka build` process stopped typechecking they own
-- the located diagnostics for the build and need each module's own file to
-- render against.
export
driveModulesLocated : (EmitAsk -> List (String, String, List Decl) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  <IO> Unit
driveModulesLocated runEmit = match args ()
  runtimeP :: coreP :: entry :: roots =>
    driveModulesGo runEmit runtimeP coreP entry (rootsOrDefault entry roots)
  _ => failWith usageModules

-- Kept as a local one-liner in each of its three call sites (here,
-- tools/test_cmd.mdk, driver/medaka_cli.mdk) rather than lifted into
-- support/util.mdk: it composes `desugar`, and support/util.mdk is imported
-- BY frontend/desugar.mdk, so importing desugar back into support/util would
-- be a module cycle.
export
desugarPair : (String, List Decl) -> (String, List Decl)
desugarPair (mid, p) = (mid, desugarIn mid p)

-- The loader is the LOCATED one (`parseLocatedResult`, real spans + each
-- module's path), not `loadProgram`: this driver renders the build's type
-- diagnostics itself, and placeholder 1:0 spans with no path render them as
-- `(module <mid>)` with no caret.  `ELoc` is transparent to every backend, so
-- the emitted IR is unchanged by the swap.
driveModulesGo : (EmitAsk -> List (String, String, List Decl) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  String ->
  String ->
  String ->
  List String ->
  <IO> Unit
driveModulesGo runEmit runtimeP coreP entry roots =
  let r = do
    rsrc <- readFile runtimeP
    csrc <- readFile coreP
    Ok (rsrc, csrc)
  match r
    Err e => failWith e
    Ok (rsrc, csrc) => match (frontGateOfEnv (), diagJsonPathOfEnv ())
      -- `medaka build --json` asked for the gate's verdict as `check --json`'s
      -- envelope, written to `path` (`driver/front_gate.mdk`).
      (Some allowInternal, Some path) =>
        let verdict = frontGateJson allowInternal (dirOf coreP) rsrc csrc entry
        let _ = writeGateAck ()
        match verdict
          Err cj => refuseJson path cj
          Ok (g, front) =>
            emitLoaded
              runEmit
              (rsrc, csrc)
              (Some (path, front))
              coreP
              entry
              g.fgRoots
              g.fgMods
              g.fgRuntimeD
              g.fgCoreD
              g.fgModsD
      -- `medaka build` asked for its front-end gate, whose verdict is final and
      -- whose graph is the one elaborated (`driver/front_gate.mdk`).
      (Some allowInternal, None) =>
        let verdict = frontGate allowInternal (dirOf coreP) rsrc csrc entry
        let _ = writeGateAck ()
        match verdict
          Err msg =>
            let _ = ePutStrLn msg
            stageExit emitDiagExitCode
          Ok g =>
            emitLoaded
              runEmit
              (rsrc, csrc)
              None
              coreP
              entry
              g.fgRoots
              g.fgMods
              g.fgRuntimeD
              g.fgCoreD
              g.fgModsD
      (None, _) => match loadProgramFilesLocatedE (_ => None) entry roots
        Err e => failWith (moduleLoadHint (loadErrorMessage e))
        Ok mods =>
          emitLoaded
            runEmit
            (rsrc, csrc)
            None
            coreP
            entry
            roots
            mods
            (desugaredPrelude rsrc)
            (desugaredPrelude csrc)
            (map (dropPathTriple >> desugarPair) mods)

-- A `--json` refusal: the envelope goes to the file, nothing to stderr, under
-- the code that tells `build` the child's verdict is a diagnostic.
refuseJson : String -> CheckJson -> <IO> Unit
refuseJson path cj =
  let _ = writeDiagJson path cj
  stageExit emitDiagExitCode

-- #2072: the FFI-stamp discriminator, derived before anything elaborates and
-- handed to the emit in its ask.  `ffiStampModeOwned` defaults to "apply the
-- `extern` declaration rules", so a drive given no ownership rejects a
-- stdlib-root-owned module whose externs the stdlib itself wrote, which `medaka
-- check` accepts.  This process owns the type verdict for a build, so it derives
-- the fact `check` derives, from the roots the graph was loaded with.  The stdlib
-- root is `dirOf coreP`: this driver's CLI shape hands it the stdlib's own
-- `core.mdk`, which is the file the parent spells `<root>/stdlib/core.mdk`.
emitLoaded : (EmitAsk -> List (String, String, List Decl) -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  (String, String) ->
  Option (String, JsonFront) ->
  String ->
  String ->
  List String ->
  List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
emitLoaded runEmit srcs json coreP entry roots mods runtimeD coreD modsD =
  let _ = holdShippedPrelude (dirOf coreP) (fst srcs) (snd srcs)
  let ownership =
    stdlibOwnership entry roots (dirOf coreP) (map dropPathTriple mods)
  let ask = EmitAsk {
    askPreludeSrcs = srcs,
    askJson = json,
    askOwnership = ownership,
  }
  runEmit ask mods runtimeD coreD modsD

-- #1796: `usageModules`' `[root ...]` bracket notation reads as "root args are
-- optional" — they aren't, the moment the entry graph spans more than one root
-- directory (e.g. both `compiler` and `stdlib`).  Omitting them degrades to a
-- bare loader `unknown module: X` with no hint that ROOT arguments are the
-- fix.  Same gate + suffix convention as `moduleLoadErrText`'s
-- `availableModulesHint` (compiler/driver/front_gate.mdk): `unknownModuleIdOf`
-- recognizes the one loader message shape this applies to, and every other
-- loader error (cycle / unreadable file) passes through unchanged.
moduleLoadHint : String -> String
moduleLoadHint e = match unknownModuleIdOf e
  None => e
  Some _ => stringConcat [
    e, " — did you forget to pass every root search directory? ", usageModules
  ]

-- ── shared composite-main emit glue (parameterized by the backend's emitTail) ──
-- The LLVM and WasmGC multi-module emit drivers had byte-identical runEmit +
-- emitModules bodies (composite-main auto-print wrap glue); their ONLY difference
-- is the backend-specific `emitTail`.  These two helpers host that shared glue
-- once, taking `emitTail` as a function parameter, so each driver keeps only its
-- backend `emitTail` and calls `driveModules (runEmitWith emitTail)`.
--
-- COMPOSITE-MAIN AUTO-PRINT (design §10): the elaboration that judges the program
-- also returns the auto-print evidence, and the emit wraps its trees
-- (main_autoprint.executedTrees): a bare non-Unit VALUE main becomes
-- `main = 0autoprintln <e>`, and a bare underived-ADT main has already surfaced
-- the clean `No impl of Display …` error.  A `main : Async _` is wrapped to apply
-- the `async` module's driver named by `asyncDriver` (`runAsyncMain` on every
-- target; it declares a `Unit` result so no backend auto-prints it, #2506).  A
-- Unit main (incl. every compiler-graph main) takes the unchanged path, so emitter
-- output on the compiler graph is byte-identical.

-- #2089: a type error must stop this driver's own elaboration — it surfaced only
-- on this path (the mangled tree, or the compiler's own graph on the bootstrap,
-- which never passes through `medaka build`'s CLI gate) and reached codegen at
-- exit 0.  The gate reads the drive's report (`trChecked`) and is HARD under
-- every setting of `MEDAKA_STRICT`: this process is the only typecheck on the
-- build path, so nothing downstream rejects the program.
--
-- Residual-only arm: the graph-end drain's own diagnostics, which the per-module
-- lists cannot carry (they close before the drain runs).
emitResidualGate : List (String, String) -> String -> TcReport -> <IO> Unit
emitResidualGate pathMap target report =
  if isNone report.trChecked then
    let _ = ePutStrLn (residualOrGeneric pathMap target report.trResidual)
    stageExit emitDiagExitCode

-- The whole diagnostic verdict for a build, rendered as `medaka check` renders
-- it: this process is the only one that typechecks the graph, so the warnings go
-- out even when the build goes on to succeed and an error stops it before the
-- backend.  `emitDiagExitCode` tells the parent that what reached its stderr is a
-- located diagnostic and needs no "emitter failed" preamble wrapped around it.
emitFullGate : List (String, String, List Decl) ->
  List (String, List Diag) ->
  TcReport ->
  <IO> Unit
emitFullGate modsWithPath buckets report =
  let (errLines, warnLines) = emitGateDiags modsWithPath buckets
  let pathMap = map modIdToPath modsWithPath
  match errLines
    -- Warnings ride the CLEAN path only, which is what `check` does with the same
    -- diagnostics: once a program has an error the errors are the whole report.
    -- Printing both made a rejecting `build` louder than `medaka check` on the
    -- same file, and louder than this same `build` was before the child owned the
    -- verdict.
    [] =>
      let _ = map ePutStrLn warnLines
      emitResidualGate pathMap (entryPathOf modsWithPath) report
    _ =>
      let _ = map ePutStrLn errLines
      stageExit emitDiagExitCode

-- The entry module's path, for the residual's fallback text.  The loader is
-- dependency-first, so the entry is last.
entryPathOf : List (String, String, List Decl) -> String
entryPathOf [] = ""
entryPathOf [(_, path, _)] = path
entryPathOf (_ :: rest) = entryPathOf rest

-- ── the target check ─────────────────────────────────────────────────────────
-- `medaka build` names the selected profile in the environment
-- (`targetProfileEnv`), and every program it builds passes through
-- `runEmitWith`, so the check sits here: after the type gate, before anything
-- is lowered.  A child started without the variable checks nothing.

-- The profile this emit is checked against, if `build` named one, selected as
-- `check --target` selects it and published before the first elaboration: the
-- typechecker bounds `IO` by the selected profile's join.  A name the table
-- does not know is refused rather than read as no profile.
selectTargetProfileOfEnv : Unit -> <IO> Option TargetProfile
selectTargetProfileOfEnv _ = match selectProfile (getEnv targetProfileEnv) None
  Ok p =>
    selectedProfile := p
    p
  Err m =>
    let _ = failWith ("error: " ++ m)
    None

-- One elaboration either way.  With a profile it is `check-policy`'s analysis,
-- the same drive `elaborateModules` runs with the entry's schemes and
-- invocation table kept, so the refusal costs no second drive.  It is the
-- build's checking drive, so it poses a value `main`'s auto-print obligation,
-- and the drive whose trees are emitted, so it returns that print's evidence
-- and judges an `Async` main's application to `asyncDriver`.  `paths` spells
-- each module's file as the refusal is reported.
elaborateForTarget : ManifestRequirement ->
  DriveInputs ->
  EntryKey ->
  Option TargetProfile ->
  List (String, String, List Decl) ->
  List (String, String) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  (ElabResult, TcReport, DriveOutputs, List Diag)
elaborateForTarget requirement inputs asyncDriver None _ _ runtimeDecls coreDecls modules =
  let (elaborated, report, outputs) =
    elaborateModulesWithReport
      (match requirement
        RawUnchecked => inputs
        CheckedEntry key protocol => { inputs |
          diExecutedMainDriver = Some asyncDriver,
          diManifestRequests =
            ExactEntry key protocol :: inputs.diManifestRequests,
        })
      (valueMainCandidate coreDecls modules)
      (Some asyncDriver.binding)
      runtimeDecls
      coreDecls
      modules
  (elaborated, report, outputs, [])
elaborateForTarget requirement inputs asyncDriver (Some p) modsWithPath paths runtimeDecls coreDecls modules =
  let (analysis, report, outputs) =
    analyzeProgramReport
      (executedMainInputs inputs asyncDriver modules)
      (valueMainCandidate coreDecls modules)
      (Some asyncDriver.binding)
      runtimeDecls
      coreDecls
      modules
  (
    analysis.eaElab,
    report,
    outputs,
    targetRefusal p (entryPathOf modsWithPath) paths analysis.eaTarget,
  )

-- The refusal `check --target` gives, located in the entry file, under the
-- exit code that tells `build` it is a diagnostic.  An admitted program's
-- target is published for the backend's extern check (`checkedTarget`).
emitTargetGate : List (String, String, List Decl) ->
  List Decl ->
  Option TargetProfile ->
  List Diag ->
  <IO> Unit
emitTargetGate _ _ None _ = ()
emitTargetGate _ runtimeDecls (Some p) [] =
  checkedTarget := Some (checkedTargetOf p runtimeDecls)
emitTargetGate modsWithPath _ (Some _) ds =
  let file = entryPathOf modsWithPath
  let src = resultOr "" (readFile file)
  let _ = ePutStrLn (joinNl (map (ppTargetDiag file src) ds))
  stageExit emitDiagExitCode

-- `emitFullGate` and `emitTargetGate` for the `--json` route: the drive's
-- verdict is written as `check --json`'s envelope instead of rendered, with
-- `check`'s full warning set.  The graph-end residual, which `check` does not
-- read, still stops the build as on every route.  An admitted program's clean
-- envelope is returned, to be written once the emit has returned.
emitJsonGate : String ->
  JsonFront ->
  List (String, String, List Decl) ->
  List Decl ->
  List (String, List Diag) ->
  TcReport ->
  Option TargetProfile ->
  List Diag ->
  <IO> CheckJson
emitJsonGate path front modsWithPath runtimeDecls buckets report profile refusal =
  match frontJsonVerdict front modsWithPath buckets refusal
    Err refused =>
      let _ = refuseJson path refused
      refused
    Ok cj =>
      let _ =
        emitResidualGate
          (map modIdToPath modsWithPath)
          (entryPathOf modsWithPath)
          report
      let _ = emitTargetGate modsWithPath runtimeDecls profile []
      cj

export
runEmitWith : ManifestRequirement ->
  EntryKey ->
  (ManifestRequirement -> DriveOutputs -> ProgramFacts -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  EmitAsk ->
  List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
runEmitWith requirement asyncDriver emitTail ask modsWithPath runtimeDecls coreDecls modules =
  runEmitAsked
    ask
    requirement
    asyncDriver
    emitTail
    modsWithPath
    runtimeDecls
    coreDecls
    modules

-- What the build's one drive keeps for the gates after it: the target refusal
-- it found and the profile it checked against.
data EmitKept = EmitKept {
  ekRefusal : List Diag,
  ekProfile : Option TargetProfile,
}

-- `runEmitWith` on the route `ask` names: one `frontEnd` run whose drive is the
-- build's elaboration.  Off the `--json` route the gate (`frontGate`) has
-- already resolved the graph, or nothing does, so the front end resolves
-- nothing (`ResolvedByGate`).  On it the front end resolves as `check --json`
-- does, its verdict is the envelope file's, and a clean one is written after the
-- emit returns, so the file holds a clean envelope only for a program that was
-- emitted.
runEmitAsked : EmitAsk ->
  ManifestRequirement ->
  EntryKey ->
  (ManifestRequirement -> DriveOutputs -> ProgramFacts -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  List (String, String, List Decl) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  <IO> Unit
runEmitAsked ask requirement asyncDriver emitTail modsWithPath runtimeDecls coreDecls modules =
  -- #2809: ELABORATE THE PROGRAM THE USER WROTE, then mangle its elaborated trees.
  -- Elaboration reads the import structure (`DUse` member spellings, alias locals) and
  -- groups denotations by name, and the mangler rewrites definitions and references but
  -- never a `DUse` — so elaborating a mangled graph made every import-keyed table miss
  -- and gave two mangled denotations two distinct names.  This order makes the child's
  -- verdict equal `check`'s by construction; `mangleUnitsEv` then renames the elaborated
  -- trees AND the evidence table's `RLocal` routes.  `emitElaborated` mangles exactly
  -- once, after the one elaboration and the driver's wrap.
  let paths = map modIdToPath modsWithPath
  let reported = match ask.askJson
    None => paths
    Some (_, front) =>
      map ((mid, path) => (mid, jsonFrontKey front modsWithPath path)) paths
  -- The profile is selected inside the drive, after any resolve the front end
  -- runs and before the elaboration: the typechecker bounds `IO` by the
  -- selected profile's join, so the drive's inputs are built from it.
  let drive =
    _ =>
      let profile = selectTargetProfileOfEnv ()
      let (_, report, outputs, refusal) =
        elaborateForTarget
          requirement
          (emitDriveInputs profile ask)
          asyncDriver
          profile
          modsWithPath
          reported
          runtimeDecls
          coreDecls
          modules
      (
        EmitKept { ekRefusal = refusal, ekProfile = profile },
        report,
        outputs,
      )
  let (rsrc, csrc) = ask.askPreludeSrcs
  let out = match ask.askJson
    None => frontEnd noStdlibExports drive FrontInput {
      fiInputs = emitDriveInputs !selectedProfile ask,
      fiAllowInternal = True,
      fiTrusted = [],
      fiRuntimeSrc = rsrc,
      fiCoreSrc = csrc,
      fiPolicy = ResolvedByGate,
      fiProgram = FrontGraph modsWithPath modules,
    }
    Some (_, front) =>
      let program = match modsWithPath
        [m] => FrontFile m
        _ => FrontGraph modsWithPath modules
      frontEnd
        (cliStdlibExports front.jfStdlibDir)
        drive
        FrontInput {
          fiInputs = emitDriveInputs !selectedProfile ask,
          fiAllowInternal = front.jfAllowInternal,
          fiTrusted = front.jfTrusted,
          fiRuntimeSrc = rsrc,
          fiCoreSrc = csrc,
          fiPolicy =
            DriveUnblocked (chainKeyOf front.jfEntry front.jfRoots) NoSteps,
          fiProgram = program,
        }
  -- Both halves of the fold read the trees the loader parsed: the elaboration
  -- is the user's own program, so a diagnostic names the constructors and
  -- imports the user wrote (#2809).
  match (ask.askJson, out.foDriven)
    (None, Some kept) =>
      let _ = emitFullGate modsWithPath out.foDiags out.foReport
      let _ =
        emitTargetGate modsWithPath runtimeDecls kept.ekProfile kept.ekRefusal
      emitElaborated
        out.foOutputs
        requirement
        asyncDriver
        emitTail
        runtimeDecls
        coreDecls
        modules
        out.foReport
    (Some (path, front), Some kept) =>
      let cj =
        emitJsonGate
          path
          front
          modsWithPath
          runtimeDecls
          out.foDiags
          out.foReport
          kept.ekProfile
          kept.ekRefusal
      let _ =
        emitElaborated
          out.foOutputs
          requirement
          asyncDriver
          emitTail
          runtimeDecls
          coreDecls
          modules
          out.foReport
      writeDiagJson path cj
    -- Resolve rejected the graph, so nothing was elaborated: the envelope holds
    -- its resolve errors and what the unblocked modules' check drive reported.
    (Some (path, front), None) =>
      refuseJson path (fst (jsonEnvelope front modsWithPath out.foDiags))
    (None, None) =>
      failWith
        "error: the build's front end did not drive a graph its gate admitted"

-- The emit of a program the gate admitted, from the elaboration that judged it
-- (`report`, whose checked trees are run): the driver's wrap is applied to
-- them (`executedFromReport`), and the result is mangled once.  The backend
-- lowers against the facts of the checked program with the mangled table.
emitElaborated : DriveOutputs ->
  ManifestRequirement ->
  EntryKey ->
  (ManifestRequirement -> DriveOutputs -> ProgramFacts -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  List Decl ->
  List Decl ->
  List (String, List Decl) ->
  TcReport ->
  <IO> Unit
emitElaborated outputs requirement asyncDriver emitTail runtimeDecls coreDecls modules report =
  match asyncMainShapeError outputs.doEntryOutcome modules
    Some msg => failWith msg
    None =>
      let executed = executedFromReport report asyncDriver (coreDecls, modules)
      match executed
        Err msg => failWith msg
        Ok (coreW, modulesW) => match report.trChecked
          Some checked =>
            let externFacts =
              withCheckedExternSources
                checkedFfiExternTypeNamesModules
                outputs
                coreW
                modulesW
                (factsOfChecked checked)
            let (coreD, modules2, table, origins) =
              mangleUnitsEv checked.cpEvidence coreW modulesW
            emitTail
              requirement
              outputs
              (factsForExecutedTrees
                (withSymbolOrigins
                  origins
                  (factsWithEvidence table externFacts))
                modulesW)
              runtimeDecls
              coreD
              modules2
          None =>
            failWith
              "internal error: the typecheck published no checked program to run"

-- A whole multi-module emit driver, for a backend `emitTail` that also reads
-- the loader's (module, path, decls): its `Async` main is run by
-- `runAsyncMain`.
export
driveEmitLocated : (List (String, String, List Decl) -> ManifestRequirement -> DriveOutputs -> ProgramFacts -> List Decl -> List Decl -> List (String, List Decl) -> <IO> Unit) ->
  <IO> Unit
driveEmitLocated emitTail = driveModulesLocated (ask mods =>
  runEmitAsked
    ask
    (CheckedEntry
      (mainEntryKey (map ((mid, _, decls) => (mid, decls)) mods))
      ExecutedMain)
    EntryKey { moduleId = "async", binding = "runAsyncMain" }
    (emitTail mods)
    mods)

-- ── shared terminal computations ─────────────────────────────────────────────
-- Identical across the _main and _batch variants of the same stage, so they live
-- here rather than being copy-pasted per probe.

-- TYPED path: drop prelude fns the user shadows, elaborate (typecheck stamps the
-- EMethodAt routes), eval for stdout.  Shared by eval_typed_main + eval_typed_batch.
export
evalTypedString : List Decl -> List Decl -> List Decl -> String
evalTypedString runtimeDecls preludeDecls userDecls =
  let livePrelude = dropShadowedExp (funNamesOf userDecls) preludeDecls
  let (elaborated, facts) = elaborateOneFacts
    defaultDriveInputs
    runtimeDecls
    livePrelude
    ("__user__", userDecls)
  evalOneOutputFacts facts [] ("__main__", elaborated)

-- DICT-PASSING path: routes through the 1-module case of the multi-module path
-- (elaborateOneFacts owns the dict-set + per-module eval).  Byte-identical to the TYPED
-- path here — the difference is elaboration-internal.  Shared by eval_dict_main +
-- eval_dict_batch.
export
evalDictString : List Decl -> List Decl -> List Decl -> String
evalDictString runtimeDecls preludeDecls userDecls =
  let userNames = funNamesOf userDecls
  let livePrelude = dropShadowedExp userNames preludeDecls
  let (elaborated, facts) = elaborateOneFacts
    defaultDriveInputs
    runtimeDecls
    livePrelude
    ("__user__", userDecls)
  evalOneOutputFacts facts [] ("__main__", elaborated)

-- ── batch drivers ────────────────────────────────────────────────────────────

-- strict per-target IO loop: for each target path, print `sentinel <path>\n` then
-- `render <decls>\n`, evaluating + printing each target STRICTLY before the next
-- (the self-hosted evaluator reseeds a global ctor->type table per program, so a
-- lazy string-builder could force one program's dispatch after the next clobbers
-- that table).
export
batchLoop : String -> (List Decl -> String) -> List String -> <IO> Unit
batchLoop sentinel render [] = putStr ""
batchLoop sentinel render (path :: rest) = match readFile path
  Err msg =>
    let _ = ePutStrLn msg
    batchLoop sentinel render rest
  Ok src =>
    let _ = putStr "\{sentinel}\{path}\n\{render (desugar (parse src))}\n"
    batchLoop sentinel render rest

-- batch CLI shape: <runtime.mdk> <core.mdk> <target.mdk>...  runtime + core parsed
-- + desugared ONCE, then `render runtimeDecls coreDecls targetDecls` per target.
export
driveRuntimeBatch : String ->
  (List Decl -> List Decl -> List Decl -> String) ->
  <IO> Unit
driveRuntimeBatch sentinel render = match args ()
  runtimePath :: corePath :: targets => match readFile runtimePath
    Err msg => failWith msg
    Ok rsrc => match readFile corePath
      Err msg => failWith msg
      Ok csrc =>
        let runtimeDecls = desugar (parse rsrc)
        let coreDecls = desugar (parse csrc)
        batchLoop sentinel (render runtimeDecls coreDecls) targets
  _ => failWith usageRuntime

-- lazy batch CLI shape: <runtime.mdk> <core.mdk> <target.mdk>...  runtime + core
-- PARSED (raw, not desugared — resolve/check take the raw AST), all target sources
-- read, then `render runtimeParsed coreParsed [(path,src)]` builds one output blob.
export
driveParseSources : (List Decl -> List Decl -> List (String, String) -> String) ->
  <IO> Unit
driveParseSources render = match args ()
  runtimePath :: corePath :: targets =>
    let r = do
      rsrc <- readFile runtimePath
      csrc <- readFile corePath
      srcs <- readAllSources targets
      Ok (putStr (render (parse rsrc) (parse csrc) srcs))
    match r
      Err msg => failWith msg
      Ok v => v
  _ => failWith usageRuntime

-- ── trap-site files ──────────────────────────────────────────────────────────
-- The emit drivers' trap sites name their file.  [mods] is the loader's
-- (module, path, decls) and [modules1] the elaborated modules; the entry path is
-- argv[2] (`<runtime> <core> <entry> [root ...]`).
export
stampSiteFiles : List (String, String, List Decl) ->
  List (String, List Decl) ->
  <IO> List (String, List Decl)
stampSiteFiles mods modules1 =
  let base = siteBaseOf (entryArgOf (args ()))
  stampModulePaths (map (modulePath base) mods) modules1

-- Stamp each module's path, given as (module, path), into its trap sites.
export
stampModulePaths : List (String, String) ->
  List (String, List Decl) ->
  List (String, List Decl)
stampModulePaths pairs modules1 =
  let paths = omFromPairs pairs omEmpty
  map (stampModuleFile paths) modules1

entryArgOf : List String -> String
entryArgOf (_ :: _ :: entry :: _) = entry
entryArgOf _ = ""

-- The parser leaves a `Loc`'s file empty.  Each module's path goes into the
-- spans its trap sites are read from (a located `ELoc`, a block `let`'s site,
-- a function's or local binding's first-clause site) here, in the emitter only, so no diagnostic of the build sees a filled one.
-- The path is the loader's, the spelling `medaka run` prints, unless the
-- entry's project names a `site-root` (`driver.loader.manifestSiteRoot`): a
-- path under that directory is then written relative to it.
modulePath : Option String ->
  (String, String, List Decl) ->
  <IO> (String, String)
modulePath base (mid, path, _) = (mid, sitePath base path)

-- The canonical `site-root` directory of [entry]'s project, if it names one.
siteBaseOf : String -> <IO> Option String
siteBaseOf entry = match findProjectRoot (dirOf entry)
  None => None
  Some root => siteBaseUnder root (manifestSiteRoot root)

siteBaseUnder : String -> Option String -> <IO> Option String
siteBaseUnder _ None = None
siteBaseUnder root (Some rel) = Some (canonicalizePath (joinPath root rel))

sitePath : Option String -> String -> <IO> String
sitePath None path = path
sitePath (Some base) path =
  let canon = canonicalizePath path
  let prefix = base ++ "/"
  if startsWith prefix canon then
    stringSlice (stringLength prefix) (stringLength canon) canon
  else
    path

stampModuleFile : OrdMap String -> (String, List Decl) -> (String, List Decl)
stampModuleFile paths (mid, decls) = match omLookup mid paths
  Some path =>
    (mid, map (stampDeclFile path) (mapProg (stampSiteFile path) decls))
  None => (mid, decls)

-- A function's first-clause site, which a call no clause accepts reports.
stampDeclFile : String -> Decl -> Decl
stampDeclFile path (DFunDef pub n ps e site bid) =
  DFunDef pub n ps e (withSiteFile path site) bid
stampDeclFile path (DLetGroup r binds) =
  DLetGroup r (map (stampBindFile path) binds)
stampDeclFile path (DAttrib attrs d) = DAttrib attrs (stampDeclFile path d)
stampDeclFile _ d = d

stampBindFile : String -> LetBind -> LetBind
stampBindFile path (LetBind n clauses site bid) =
  LetBind n clauses (withSiteFile path site) bid

stampSiteFile : String -> Expr -> Expr
stampSiteFile path (ELoc l e) = ELoc (withSiteFile path l) e
stampSiteFile path (ELet site r p e1 e2) =
  ELet (withSiteFile path site) r p e1 e2
stampSiteFile path (EBlock stmts) = EBlock (map (stampStmtFile path) stmts)
stampSiteFile path (ELetGroup binds body) =
  ELetGroup (map (stampBindFile path) binds) body
stampSiteFile _ e = e

stampStmtFile : String -> DoStmt -> DoStmt
stampStmtFile path (DoLet m r p e site) = DoLet m r p e (withSiteFile path site)
stampStmtFile _ s = s

withSiteFile : String -> Loc -> Loc
withSiteFile path (Loc "" sl sc el ec) = Loc path sl sc el ec
withSiteFile _ l = l
