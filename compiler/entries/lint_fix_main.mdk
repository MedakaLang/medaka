-- Entry point for the self-hosted lint AUTOFIX driver:
--
--   medaka run compiler/entries/lint_fix_main.mdk <source.mdk>
--
-- applies every fixable rule's fix, unsafe ones included, to the target (or
-- only the `--only=<rules>` ones) and prints the rewritten source to stdout.
-- Drives `tools.lint.fixSource`,
-- the path `medaka lint --fix` takes — the gate (test/diff_compiler_fmt_test.mdk)
-- compares its output to a `.fixed` golden.

import string.{stripPrefix}
import tools.lint.{
  Applicability(..),
  StdlibIndex,
  buildStdlibIndexResult,
  emptyStdlibIndex,
  fixSource,
  splitLintNames,
  stdlibIndexNeeded,
}

export
oracleMain : Unit -> <IO> Unit
oracleMain () = match args ()
  [targetPath] => withTarget [] targetPath
  [flag, targetPath] => match stripPrefix "--only=" flag
    Some names => withTarget (splitLintNames names) targetPath
    None => ePutStrLn "unknown flag \{flag}"
  _ =>
    ePutStrLn
      "usage: medaka run compiler/entries/lint_fix_main.mdk [--only=<rules>] <file.mdk>"

withTarget : List String -> String -> <IO> Unit
withTarget only targetPath = match readFile targetPath
  Ok targetSrc => match indexFor only
    Ok idx => match fixSource idx Unsafe only [] targetPath targetSrc
      Ok (newSrc, _) => putStr newSrc
      Err msg => ePutStrLn msg
    Err msg => ePutStrLn msg
  Err msg => ePutStrLn msg

-- The stdlib index when a selected rule reads it, else the empty one.
indexFor : List String -> <IO> Result String StdlibIndex
indexFor only =
  if stdlibIndexNeeded only [] then match buildStdlibIndexResult
    Ok idx => Ok idx
    Err _ => Err "cannot build the stdlib index"
  else
    Ok emptyStdlibIndex

main = oracleMain ()
