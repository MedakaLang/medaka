import backend.runtime_c_abi.{AbiType(..), RuntimeAbiRow(..), runtimeAbiRows}
import backend.llvm_preamble.{runtimeDecls, ffiRuntimeDecls, siteTrapDecls}
import string.{join}

typeName : AbiType -> String
typeName AbiWord = "i64"
typeName AbiInt32 = "i32"
typeName AbiPointer = "ptr"
typeName AbiDouble = "double"
typeName AbiVoid = "void"

render : RuntimeAbiRow -> String
render row =
  row.name
    ++ "|"
    ++ typeName row.result
    ++ "|"
    ++ join "," (map typeName row.parameters)

main = match runtimeAbiRows (runtimeDecls ++ ffiRuntimeDecls ++ siteTrapDecls)
  Err e => putStrLn ("ERROR: " ++ e)
  Ok rows => putStrLn (join "\n" (map render rows))
