-- Batched variant of check.mdk — PROTOTYPE for prelude caching.
--
--   medaka run compiler/entries/check_batch.mdk <runtime.mdk> <core.mdk> <file.mdk>...
--
-- Parses runtime.mdk + core.mdk ONCE, then runs parse → desugar → resolve →
-- exhaust → typecheck per target file, reusing the parsed prelude across all
-- targets.  Each target's report is prefixed with a sentinel line
--   ===SELFHOST-FIX=== <path>
-- so the harness can split one process's output back into per-fixture sections.
--
-- Semantics per target are identical to check.mdk's runCheck; only the prelude
-- parse is hoisted out of the per-target loop.
--
-- ⚠️ That identity claim is the WHOLE POINT of this entry, and it is what
-- decides which typecheck wrapper is called here.  This file called the FLAT
-- wrapper `checkToLinesWithRuntime` until 2026-08-26; `check.mdk`'s runCheck moved
-- to the one-module wrapper in S-migrate-check-route (E-1 #1115) and this one did
-- not, so the two silently diverged.  The divergence is not cosmetic: the FLAT arm
-- checks `coreProg ++ userProg` as ONE decl list, so `groupClauses` (typecheck.mdk)
-- merges a user standalone with a PRELUDE standalone of the same name into a single
-- letrec group -- `test/diff_fixtures/higher_order.mdk`'s own `isEven` vanished from
-- the scheme dump and the prelude's `isEven : Int -> Bool` stood in its place.
-- Keep this on the one-module wrapper: it is what makes the claim above true.

import frontend.ast.{Decl}
import frontend.parser.{parse}
import frontend.desugar.{desugar}
import frontend.resolve.{resolveToLines}
import frontend.exhaust.{exhaustToLinesWith}
import types.typecheck.{checkOneToLinesWithRuntime, setCoherenceUserDecls}
import entries.entry_support.{driveParseSources}

main = driveParseSources renderAll

renderAll : List Decl -> List Decl -> List (String, String) -> String
renderAll runtimeP coreP [] = ""
renderAll runtimeP coreP (pr::rest) = renderOne runtimeP coreP pr
  ++ renderAll runtimeP coreP rest

renderOne : List Decl -> List Decl -> (String, String) -> String
renderOne runtimeP coreP (path, tsrc) =
  "===SELFHOST-FIX=== \{path}\n\{runCheckCached runtimeP coreP tsrc}\n"

runCheckCached : List Decl -> List Decl -> String -> String
runCheckCached runtimeP coreP tsrc =
  let raw = parse tsrc
  let desugared = desugar raw
  let resDiags = resolveToLines runtimeP coreP desugared
  reportFor resDiags runtimeP coreP raw desugared

reportFor : String -> List Decl -> List Decl -> List Decl -> List Decl -> String
reportFor "" runtimeP coreP raw desugared =
  cleanReport runtimeP coreP raw desugared
reportFor resDiags _ _ _ _ = resDiags

cleanReport : List Decl -> List Decl -> List Decl -> List Decl -> String
-- Intentional cross-file duplicate of the same helper in check.mdk; not consolidating (tiny helper / divergent-by-design backend pair).
-- lint-disable-next-line rule-duplicate-body
cleanReport runtimeP coreP raw desugared =
  let exWarns = exhaustToLinesWith (raw ++ runtimeP ++ coreP) raw
  let _ = setCoherenceUserDecls desugared
  let schemes = checkOneToLinesWithRuntime (desugar runtimeP) (desugar coreP) desugared
  joinNonEmpty exWarns schemes

joinNonEmpty : String -> String -> String
joinNonEmpty "" b = b
joinNonEmpty a "" = a
joinNonEmpty a b = "\{a}\n\{b}"
