{- | Gate for the Product effect-refinement domain.

   The fixtures define `Net = Host(Prefix) x Method(Set)` and exercise
   pointwise confinement, missing-axis soundness, host lifting, Prefix
   compatibility, and Product policies. The frozen reference compiler does
   not parse Product domains, so the current native compiler is the sole arm. -}

import compiler_cli_test_support.{
  expectCheckAccept,
  expectCheckReject,
  expectVerbExitStartsWith,
  expectVerbExitStartsWithAndContains,
  fixtureIn,
}

fixture : String -> <IO> String
fixture name = fixtureIn "test/effect_product_fixtures" name

test "Product accepts when Host and Method are independently confined" =
  expectCheckAccept (fixture "prod_accept.mdk")

test "Product rejects an out-of-prefix Host" = expectCheckReject (fixture
  "prod_reject_host.mdk") [
  "performs <FFI, Net Host=\"other.com/api\" Method={\"GET\"}>",
]

test "Product rejects an out-of-set Method" = expectCheckReject (fixture
  "prod_reject_method.mdk") [
  "performs <FFI, Net Host=\"idp.example.com/api\" Method={\"POST\"}>",
]

test "Product treats a missing inferred Method axis as top" = expectCheckReject
  (fixture "prod_soundness.mdk")
  ["performs <FFI, Net Host=\"idp.example.com/api\">"]

test "a bare Product literal lifts into the Host axis" =
  expectCheckAccept (fixture "prod_host_lift.mdk")
test "a Product label's own axes: the literal lifts into the first declared axis" =
  expectCheckAccept (fixture "prod_custom_axes.mdk")
test "a Product label must declare its axes" = expectCheckReject (fixture
  "prod_no_axes.mdk") [
  "a Product label declares its axes",
]
test "a written product may name only the declared axes" = expectCheckReject
  (fixture "prod_unknown_axis.mdk")
  ["unknown product axis `Host`; declared axes: Table, Op"]

test "every axis takes a binder, each in its own axis's domain" =
  expectCheckAccept (fixture "prod_axis_binder_accept.mdk")

-- Charged against the primary axis's domain, the runtime method would land
-- in Host and the program would typecheck.
test "a runtime argument on the Method axis is that axis's top" = expectCheckReject
  (fixture "prod_axis_binder_runtime.mdk")
  [
    "performs <Http Host=\"api.example.com/users\"> where only <FFI, Http Host=\"api.example.com/*\" Method={\"GET\"}> is allowed",
  ]

test "arguments passed swapped are charged on the axes they land on" = expectCheckReject
  (fixture "prod_axis_binder_swapped.mdk")
  ["performs <Http Host=\"GET\" Method={\"api.example.com/users\"}>"]

test "an axis names only a binder written to its left" = expectCheckReject
  (fixture "prod_axis_binder_unbound.mdk")
  ["unknown authority `method`"]

test "a product that names arguments prints back as written" =
  expectVerbExitStartsWith
    "fmt"
    ["--check", fixture "prod_axis_binder_accept.mdk"]
    0
    ""

test "a non-Product Prefix domain keeps its old behavior" =
  expectCheckAccept (fixture "prod_compat_prefix.mdk")

test "check-policy accepts a Product policy that admits both axes" =
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "prod_policy_plugin.mdk",
      "--allow",
      "Net=Host=\"idp.example.com/*\";Method={GET,POST},FFI",
      "--fn",
      "transform",
    ]
    0
    "accepted"

test "check-policy rejects a Product policy with a narrow Method axis" =
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "prod_policy_plugin.mdk",
      "--allow",
      "Net=Host=\"idp.example.com/*\";Method={GET},FFI",
      "--fn",
      "transform",
    ]
    1
    "rejected"

-- A policy entry is read by the rules a source atom is: a bare pattern on a
-- Product label lifts into its first axis, and an entry the label's domain
-- does not admit is refused with the reason, never read as the whole domain.
policyRun : String -> <IO> List String
policyRun allow = [
  fixture "prod_policy_plugin.mdk",
  "--allow",
  allow,
  "--fn",
  "transform",
]

test "check-policy lifts a bare Product pattern into the first axis" =
  expectVerbExitStartsWith
    "check-policy"
    (policyRun "Net=idp.example.com/*,FFI")
    0
    "accepted"

test "check-policy confines a lifted Product pattern" =
  expectVerbExitStartsWith
    "check-policy"
    (policyRun "Net=other.com/*,FFI")
    1
    "rejected"

test "check-policy refuses a pattern on a Set axis rather than reading it as one" = expectVerbExitStartsWithAndContains
  "check-policy"
  (policyRun "Net=Host=\"idp.example.com/*\";Method=GET,FFI")
  1
  "rejected"
  ["axis `Method` takes a set, not a pattern"]

test "check-policy refuses an axis without a value rather than widening it" = expectVerbExitStartsWithAndContains
  "check-policy"
  (policyRun "Net=Host=\"idp.example.com/*\";Method,FFI")
  1
  "rejected"
  ["axis 'Method' has no value"]

test "check-policy refuses an undeclared axis" = expectVerbExitStartsWithAndContains
  "check-policy"
  (policyRun "Net=Host=\"idp.example.com/*\";Verb={GET},FFI")
  1
  "rejected"
  ["unknown product axis `Verb`"]

test "a 16-member Set axis beside an axis binder is accepted" =
  expectCheckAccept (fixture "prod_binder_set16_accept.mdk")

test "a 17-member Set axis beside an axis binder is refused" = expectCheckReject
  (fixture "prod_binder_set17_reject.mdk")
  ["a set holds at most 16 members, and this one has 17"]
