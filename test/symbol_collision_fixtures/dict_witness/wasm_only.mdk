-- Two impls of ONE method name (`zn`) at head tycons `Dbnfbcp`/`Llzhriz`,
-- dispatched through one dict parameter. Their full i64 `hashName`s differ and
-- their low 30 bits agree, so the wasm `dictTag` headers are equal words. Both
-- backends must build it and answer `d|l`.
interface Zn a where
  zn : a -> String

data Dbnfbcp = Dbnfbcp
data Llzhriz = Llzhriz

impl Zn Dbnfbcp where
  zn _ = "d"

impl Zn Llzhriz where
  zn _ = "l"

callZn : Zn a => a -> String
callZn x = zn x

main = println (callZn Dbnfbcp ++ "|" ++ callZn Llzhriz)
