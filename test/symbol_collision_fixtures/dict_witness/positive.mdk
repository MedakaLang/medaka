-- One type, one interface, one impl, whose key `JMt` is engineered to djb2-collide
-- with the prelude's `Int` for a completely UNRELATED method
-- (`hashName "Int" == hashName "JMt"`, via the adjacent-position shift documented
-- on `private_mangle.hashName`). Must BUILD and RUN.
interface Nm a where
  nm : a -> String

data JMt = JMt

impl Nm JMt where
  nm _ = "jmt"

main = println (nm JMt)
