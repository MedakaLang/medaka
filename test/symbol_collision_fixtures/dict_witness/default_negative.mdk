-- Inherited-default shape: `zn` has a default, `Mzone` supplies it and `NYone`
-- inherits it. The two dictionary headers are equal words (`hashName "Mzone" ==
-- hashName "NYone"`; see negative.mdk), which nothing compares: this must build
-- and answer `mzone|default`, as `run` does.
interface Zn a where
  zn : a -> String
  zn _ = "default"

data Mzone = Mzone
data NYone = NYone

impl Zn Mzone where
  zn _ = "mzone"

impl Zn NYone

callZn : Zn a => a -> String
callZn x = zn x

main = println (callZn Mzone ++ "|" ++ callZn NYone)
