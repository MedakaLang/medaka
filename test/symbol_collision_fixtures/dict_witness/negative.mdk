-- Two impls of the SAME method name (`zn`, interface `Zn`) at head tycons
-- `Mzone`/`NYone`, dispatched through one dict parameter (`callZn`).
-- `hashName "Mzone" == hashName "NYone" == 210683374574`, so the two dictionary
-- headers are equal words. Nothing compares a header (a call loads a slot), so
-- this must build and answer `mzone|nyone`, as `run` does.
interface Zn a where
  zn : a -> String

data Mzone = Mzone
data NYone = NYone

impl Zn Mzone where
  zn _ = "mzone"

impl Zn NYone where
  zn _ = "nyone"

callZn : Zn a => a -> String
callZn x = zn x

main = println (callZn Mzone ++ "|" ++ callZn NYone)
