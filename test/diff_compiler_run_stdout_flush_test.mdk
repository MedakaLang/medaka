{- | Gate for the "run drops stdout on panic" regression over
   `test/run_stdout_flush_fixtures` (#40, #2848).

   `medaka run` used to buffer a program's stdout in an in-language
   `Ref String` and write it out with one final `putStr` after `main`
   returned normally. Medaka panics are not catchable, so a panicking
   program's already-printed output was silently discarded. That defeated the
   standard probe for "did this failing program actually execute" — put a
   `println` sentinel before the suspect expression and look for it — because
   the sentinel was invisible whether the program ran or not, and the exit
   code was 1 either way. #40 was nearly closed as not reproducible on
   exactly that basis. The fix arms a flush from `run`'s own driver, snapshots
   the buffer on every print, and flushes it from every abort path in
   `runtime/medaka_rt.c` before that path prints its own diagnostic.

   A compiled binary has the same bug in libc's shape: `println` writes
   through buffered stdout, which every coded abort gets flushed for free by
   `exit()`, but the fault handler must use `_exit()` — `fflush` is not
   async-signal-safe — which skips it. `stack_overflow_build` pins that half.

   Every fixture prints the literal line `SENTINEL` and then dies, and every
   row pins that engine's stdout as exactly those bytes, newline included.
   Byte equality is the whole assertion: a substring test passes on output
   that lost its newline or gained a duplicate, and the defect this gate
   exists to catch is precisely bytes going missing. stdout and stderr are
   read as separate streams for the same reason — merged, the diagnostic the
   abort path prints would stand in for the program's own output.

   Two fixtures are graded on one engine only, and each has its reason in
   its own file header. `stack_overflow_depth_guard` and
   `stack_overflow_build` are the same source: under `run` it trips the
   interpreter's synthetic depth guard, and built it exhausts a real stack
   and faults, so each is asked about the engine whose abort path it was
   written for. No program `check` admits reaches a raw `panic` site of the
   interpreter that is not the native `panic` extern, because a name no
   engine provides is refused at check; that class stays covered through the
   same `panic` extern by `index_oob`, `panic` and `nonexhaustive_match`.

   Why this is not `diff_compiler_run_check_agreement`: that gate pins each
   fixture to one `check` verdict its runtime must agree with, and cannot
   represent a fixture `check` accepts as well typed but that panics at
   runtime for an unrelated reason, which is this bug's whole shape.

   Runs under `medaka test --native`: it spawns subprocesses and reads the
   corpus, neither of which the interpreter binds. -}

import compiler_cli_test_support.{
  Agreement(..),
  EngineDeath(..),
  binaryRanClean,
  RuntimeOutcome(..),
  checkRunBuildAll,
  fatalOutcomeSweep,
  rosterAgreement,
}
import io.{runVerb}
import list.{somes, zipWith}
import string.{trim}
import test.{Expectation, expectAll, expectEach, expectEqual, fail}
import test_process.{medakaRoot}

corpus : <IO> String
corpus = "\{medakaRoot}/test/run_stdout_flush_fixtures"

-- The bytes every fixture prints before dying, and the only thing any of
-- them prints. The trailing newline is part of the pin.
sentinel : String
sentinel = "SENTINEL\n"

-- | The size of the corpus, written down so that a corpus which silently
-- shrank is red. Growing it is expected: add the row and raise this.
declaredFixtureCount : Int
declaredFixtureCount = 7

-- Both engines reach the same coded abort and must both still show the
-- sentinel.
bothDie : String -> RuntimeOutcome
bothDie code = Dies (Coded code) (Coded code) sentinel

rows : List (String, RuntimeOutcome)
rows = [
  ("index_oob", bothDie "E-INDEX-OOB"),
  ("panic", bothDie "E-PANIC"),
  ("nonexhaustive_match", bothDie "E-NONEXHAUSTIVE-MATCH"),
  -- #2848's silent wrongness: a reserved-spelling collision made the emitter
  -- drop the default arm, so only `run` aborted at all.
  ("nonexhaustive_reserved_name", bothDie "E-NONEXHAUSTIVE-MATCH"),
  (
    "stack_overflow_depth_guard",
    Dies (Coded "E-STACK-OVERFLOW") Unexercised sentinel,
  ),
  (
    "stack_overflow_build",
    Dies Unexercised (Coded "E-STACK-OVERFLOW") sentinel,
  ),
  -- The replay after a flush holds only the bytes written since it.
  (
    "stack_overflow_build_flushed",
    Dies Unexercised (Coded "E-STACK-OVERFLOW") sentinel,
  ),
]

test "every fixture pins a runtime outcome" =
  rosterAgreement corpus declaredFixtureCount rows

test "run and build+exec agree with every fixture's pinned outcome" =
  fatalOutcomeSweep corpus declaredFixtureCount rows

-- # Order around `writeStdoutBytes`
--
-- `medaka run` writes a byte block to stdout itself rather than through its
-- String buffer, so the text before the block, the block, and the text after
-- it reach stdout by two routes.  Every way the program can end must still
-- print them in program order.  Each program prints `A`, the one-byte block
-- `B`, then `C`, and ends as its row says; both engines owe exactly `ABC` on
-- stdout and the row's exit code.

orderSource : String -> String
orderSource ending =
  "import bytes.{writeStdoutBytes, fromArrayAssumeByteDomain}\n\nmain =\n  let _ = putStr \"A\"\n  let _ = writeStdoutBytes (fromArrayAssumeByteDomain [|66|])\n  let _ = putStr \"C\"\n  \{ending}\n"

orderRows : List (String, String, Int)
orderRows = [
  ("return", "()", 0),
  ("exit_0", "exit 0", 0),
  ("exit_3", "exit 3", 3),
  ("panic", "(panic \"after the block\" : Unit)", 1),
]

-- The `(entry, binPath)` one row's program is written to and built from.
orderPaths : String -> (String, String, Int) -> (String, String)
orderPaths dir (name, _, _) = ("\{dir}/\{name}.mdk", "\{dir}/\{name}.bin")

-- Writes one row's program, or names the row when it could not be written.
orderWriteFailure : String ->
  (String, String, Int) ->
  <FileWrite> Option (String, Expectation)
orderWriteFailure dir (name, ending, code) =
  let (entry, _) = orderPaths dir (name, ending, code)
  match writeFile entry (orderSource ending)
    Err e => Some (name, fail "could not write \{entry}: \{e}")
    Ok _ => None

gradeOrderRow : (String, String, Int) ->
  Result String Agreement ->
  (String, Expectation)
gradeOrderRow (name, _, _) (Err e) = (name, fail e)
gradeOrderRow (name, _, code) (Ok a) = (
  name,
  expectAll
    [
      expectEqual
        [(code, "ABC"), (code, "ABC")]
        [(a.runCode, a.runOut), (a.binCode, a.binOut)],
      -- Only the zero-exit rows leave the binary clean: a nonzero exit and a
      -- panic both fail `binaryRanClean`.
      expectEqual (code == 0) (binaryRanClean a),
    ],
)

-- Every row's program written first, then all of them run side by side.
orderExpectations : String -> <Exec, FileWrite, IO> List (String, Expectation)
orderExpectations dir = match somes (map (orderWriteFailure dir) orderRows)
  [] =>
    zipWith
      gradeOrderRow
      orderRows
      (checkRunBuildAll (map (orderPaths dir) orderRows))
  unwritten => unwritten

-- A directory of this test's own.  Not `test_process.scratchDir`: that is one
-- value for the whole process, and a sweep that reads it removes it when it
-- finishes.
orderDir : Unit -> <Exec> Result String String
orderDir _ = match runVerb "mktemp" ["-d"]
  Err e => Err e
  Ok (0, out, _) => Ok (trim out)
  Ok (code, _, err) => Err "mktemp -d exited \{intToString code}: \{err}"

test "run and build+exec print text and writeStdoutBytes in program order on every exit" =
  match orderDir ()
    Err e => fail "no scratch directory: \{e}"
    Ok dir =>
      let result = expectEach (orderExpectations dir)
      let _ = runVerb "rm" ["-rf", dir]
      result
