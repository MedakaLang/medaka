{- | Gate for the comment-register shout check (#2621, #3032, #4504): a PR adds no
   shout comment line to a .mdk outside test/.

   1. Diff shout check: for each file in `git diff --name-only --diff-filter=ACM
      <merge-base> HEAD -- *.mdk :(exclude)test/**`, the merge-base blob and the
      HEAD blob are linted with `rule-comment-emoji` and `rule-comment-shout`. A
      (rule, line text) pair found more times at HEAD than at the merge-base is a
      finding, so a shout line rewritten in place counts as added and one left
      textually unchanged does not. This is the comparison `.githooks/pre-commit`
      check 6 makes, run on every changed file instead of behind the hook's
      prefilter.
   2. Prefilter cover: the hook's `re_emoji` and `re_shout` literals, read from the
      hook, match every line the two rules flag under the lint roots, so the hook
      never skips a file whose added lines carry a finding.
   3. Detector self-check: synthetic before/after pairs through the comparison of 1.

   What it proves: a PR adds no emoji or capitals-run comment line to a .mdk outside
   test/, and the hook's prefilter is wide enough on today's tree.

   What it does not prove: the per-file count ratchet over the eight
   comment-register rules, which is `diff_compiler_lint_baseline`'s. .md files are
   out of scope.

   Shallow-clone recovery: when origin/main does not resolve,
   `git fetch --depth=50 origin refs/heads/main:refs/remotes/origin/main` runs;
   when the merge-base with HEAD fails, `git fetch --depth=50 origin <HEAD sha>`
   runs. Fetch failures are ignored. Locally, with origin/main present, no fetch
   runs. If the merge-base is still unresolvable, the test fails. -}

import test_process.{
  medakaRoot,
  medakaBin,
  boundedVerb,
  boundedVerbSeconds,
  underRoot,
  withScratchDir,
}
import test.{Expectation, expectEqual, expectNoFindings, fail}
import string.{
  lines, startsWith, trim, stripPrefix, stripSuffix, split, toInt, indexOf
}
import list.{indexed, sort}
import map.{Map, countBy, entries, findWithDefault, groupByKey}
import regex.{Regex, compile, isMatch}
import array as Arr

shoutRules : String
shoutRules = "rule-comment-emoji,rule-comment-shout"

-- The lint run over the whole tree takes a few seconds; the default spawn limit
-- leaves too little margin on a loaded CI box.
lintSeconds : Int
lintSeconds = 600

-- One file's two sides: its name, its blob before the change (none for a new
-- file) and its blob after.
type BlobPair = (String, Option String, String)

-- Lint output parsing ---------------------------------------------------------

-- A `warning: <path>:<line>:<col>: [<rule>] ...` line as (path, line, rule).
parseHit : String -> Option (String, Int, String)
parseHit l = do
  rest <- stripPrefix "warning: " l
  match split ":" rest
    path :: lineText :: _col :: msg :: _ =>
      map (n => (path, n, ruleOf msg)) (toInt lineText)
    _ => None

ruleOf : String -> String
ruleOf msg = match stripPrefix "[" (trim msg)
  None => ""
  Some r => match indexOf "]" r
    Some i => stringSlice 0 i r
    None => r

lintHits : List String -> <Exec, IO> Result String (List (String, Int, String))
lintHits paths =
  let args = ["lint", "--internal", "--only=\{shoutRules}"] ++ paths
  match boundedVerbSeconds lintSeconds (medakaBin ()) args
    Err e => Err "could not run medaka lint: \{e}"
    Ok (0, out, _) => Ok (filterMap parseHit (lines out))
    Ok (code, out, err) =>
      Err "medaka lint exited \{intToString code}:\n\{err}\{out}"

-- The comparison ---------------------------------------------------------------

lineAt : Array String -> Int -> String
lineAt srcLines n = optionOr "" (Arr.get (n - 1) srcLines)

-- The `[rule] text` key of each (line, rule) hit, `text` being the source line.
keysOf : String -> List (Int, String) -> List String
keysOf src hits =
  let srcLines = Arr.fromList (lines src)
  map ((n, rule) => "[\{rule}] \{lineAt srcLines n}") hits

-- The keys found more times in `after` than in `before`.
risen : List String -> List String -> List String
risen before after =
  let old = countBy (k => k) before
  entries (countBy (k => k) after)
    |> filter ((k, n) => n > findWithDefault 0 k old)
    |> map fst

blobPath : String -> String -> Int -> String
blobPath dir side i = "\{dir}/\{side}-\{intToString i}.mdk"

writeBlob : String -> String -> <FileWrite> Result String String
writeBlob path text = match writeFile path text
  Err e => Err "could not write \{path}: \{e}"
  Ok _ => Ok path

writeBefore : String ->
  Int ->
  Option String ->
  <FileWrite> Result String (List String)
writeBefore _ _ None = Ok []
writeBefore dir i (Some b) =
  map (p => [p]) (writeBlob (blobPath dir "before" i) b)

-- Writes every pair's blobs under `dir`, returning the paths written.
writeAll : String ->
  List (Int, BlobPair) ->
  <FileWrite> Result String (List String)
writeAll _ [] = Ok []
writeAll dir ((i, (_, before, after)) :: rest) = do
  a <- writeBlob (blobPath dir "after" i) after
  bs <- writeBefore dir i before
  ps <- writeAll dir rest
  Ok (a :: bs ++ ps)

-- `name: [rule] text` for each key pair `i` gains.
pairFindings : String ->
  Map String (List (String, Int, String)) ->
  (Int, BlobPair) ->
  List String
pairFindings dir byPath (i, (name, before, after)) =
  let keysAt side text =
    keysOf
      text
      (map
        ((_, n, r) => (n, r))
        (findWithDefault [] (blobPath dir side i) byPath))
  let beforeKeys = match before
    Some b => keysAt "before" b
    None => []
  map (k => "\{name}: \{k}") (risen beforeKeys (keysAt "after" after))

-- Lints both blobs of every pair in one process under `dir`.
risenPairs : String ->
  List BlobPair ->
  <Exec, IO, FileWrite> Result String (List String)
risenPairs dir pairs = do
  let numbered = indexed pairs
  paths <- writeAll dir numbered
  hits <- lintHits paths
  let byPath = groupByKey ((p, _, _) => p) hits
  Ok (flatMap (pairFindings dir byPath) numbered)

-- Git-touching helpers ---------------------------------------------------------

-- Merge-base of HEAD with the given ref, or "" when it cannot be resolved.
mergeBaseWith : String -> <Exec, IO> String
mergeBaseWith ref =
  match boundedVerb "git" ["-C", medakaRoot (), "merge-base", ref, "HEAD"]
    Err _ => ""
    Ok (code, out, _) => if code == 0 then trim out else ""

-- Fetch with output discarded; returns whether the fetch exited 0. Failures are
-- ignored.
fetchQuiet : List String -> <Exec, IO> Bool
fetchQuiet args =
  match runCommand "git" (["-C", medakaRoot (), "fetch", "--quiet"] ++ args)
    Ok (0, _, _) => True
    _ => False

-- HEAD's commit sha, or "" when it cannot be resolved.
headSha : Unit -> <Exec, IO> String
headSha () = match runCommand "git" ["-C", medakaRoot (), "rev-parse", "HEAD"]
  Ok (0, out, _) => trim out
  _ => ""

originMainResolves : Unit -> <Exec, IO> Bool
originMainResolves () = match runCommand "git" [
  "-C",
  medakaRoot (),
  "rev-parse",
  "--verify",
  "--quiet",
  "origin/main",
]
  Ok (0, _, _) => True
  _ => False

-- CI shallow-clone recovery. actions/checkout@v4's default checkout is depth=1
-- of the triggering ref: origin/main is unresolvable and HEAD has no parent
-- history, so both fetches are needed there. Locally they never run. Each step
-- is sequenced by `let`; the Bool result is only for ordering.
recoverShallow : Unit -> <Exec, IO> Bool
recoverShallow () =
  let originOk =
    originMainResolves ()
      || fetchQuiet [
        "--depth=50", "origin", "refs/heads/main:refs/remotes/origin/main"
      ]
  let historyOk =
    mergeBaseWith "origin/main" /= ""
      || fetchQuiet ["--depth=50", "origin", headSha ()]
  originOk && historyOk

-- origin/main first, then local main.
baseOf : Unit -> <Exec, IO> String
baseOf () =
  let _recovered = recoverShallow ()
  let b = mergeBaseWith "origin/main"
  if b /= "" then b else mergeBaseWith "main"

mdkFiles : String -> <Exec, IO> Result String (List String)
mdkFiles base = do
  (code, out, err) <- boundedVerb "git" [
    "-C",
    medakaRoot (),
    "diff",
    "--name-only",
    "--diff-filter=ACM",
    base,
    "HEAD",
    "--",
    "*.mdk",
    ":(exclude)test/**",
  ]
  if code /= 0 then
    Err "exit \{intToString code}: \{err}"
  else
    Ok (filter (/= "") (lines out))

-- The blob of `f` at `rev`, or None when `rev` has no such path.
blobAt : String -> String -> <Exec, IO> Option String
blobAt rev f =
  match boundedVerb "git" ["-C", medakaRoot (), "show", "\{rev}:\{f}"]
    Ok (0, out, _) => Some out
    _ => None

pairsOf : String -> List String -> <Exec, IO> Result String (List BlobPair)
pairsOf _ [] = Ok []
pairsOf base (f :: rest) = match blobAt "HEAD" f
  None => Err "git show HEAD:\{f} failed"
  Some after => map ((f, blobAt base f, after) :: _) (pairsOf base rest)

-- Assertion 1: diff shout check over the PR's .mdk changes outside test/.
diffCheckFrom : String -> <Exec, IO, FileRead, FileWrite> Expectation
diffCheckFrom base = match mdkFiles base
  Err e =>
    fail
      "git diff --name-only \{base} HEAD failed (unresolvable ref or too-shallow clone): \{e}"
  Ok files => match pairsOf base files
    Err e => fail e
    Ok pairs => withScratchDir (dir =>
      expectNoFindings
        "new shout comment line(s) added (🚨/⚠️/🔒 or sigil-free ALL-CAPS) in .mdk outside test/ -- see AGENTS.md [T-COMMENT-REGISTER]: no new shout comments"
        (risenPairs dir pairs))

diffCheck : Unit -> <Exec, IO, FileRead, FileWrite> Expectation
diffCheck () =
  let base = baseOf ()
  if base == "" then
    fail "could not determine a merge-base with main -- pass a base explicitly"
  else
    diffCheckFrom base

-- Assertion 2: the hook's prefilter covers every line the rules flag ----------

lintRoots : List String
lintRoots = [
  "compiler",
  "demo",
  "gzip",
  "parsec",
  "pds",
  "playground",
  "scripts",
  "sqlite",
  "stdlib",
]

firstMatching : String -> String -> String
firstMatching key text = match filter (startsWith key) (lines text)
  [] => ""
  l :: _ => l

-- The single-quoted value of the hook's `<name>='...'` assignment, compiled.
hookRegex : String -> String -> Result String Regex
hookRegex name hookText =
  let assignment = firstMatching "\{name}='" hookText
  match stripPrefix "\{name}='" assignment |> flatMap (stripSuffix "'")
    None => Err "no \{name}='...' line in .githooks/pre-commit"
    Some src =>
      mapErr (e => "\{name} does not compile: \{e.message}") (compile src)

-- `path:line: rule` for each hit whose source line the rule's regex misses.
uncovered : Regex ->
  Regex ->
  String ->
  List (String, Int, String) ->
  <FileRead> List String
uncovered emojiRe shoutRe path hits = match readFile path
  Err e => ["\{path}: could not read: \{e}"]
  Ok src =>
    let srcLines = Arr.fromList (lines src)
    let missed (_, n, rule) =
      let re = if rule == "rule-comment-emoji" then emojiRe else shoutRe
      not (isMatch re (lineAt srcLines n))
    hits
      |> filter missed
      |> map ((_, n, rule) => "\{path}:\{intToString n}: \{rule}")

coverMisses : Regex -> Regex -> <Exec, IO, FileRead> Result String (List String)
coverMisses emojiRe shoutRe =
  let missesIn hits =
    entries (groupByKey ((p, _, _) => p) hits)
      |> flatMap ((path, hs) => uncovered emojiRe shoutRe path hs)
  map missesIn (lintHits (map underRoot lintRoots))

prefilterCovers : Unit -> <Exec, IO, FileRead> Expectation
prefilterCovers () = match readFile (underRoot ".githooks/pre-commit")
  Err e => fail "could not read .githooks/pre-commit: \{e}"
  Ok hookText => match (
    hookRegex "re_emoji" hookText,
    hookRegex "re_shout" hookText,
  )
    (Ok emojiRe, Ok shoutRe) =>
      expectNoFindings
        "lines the comment rules flag that .githooks/pre-commit's prefilter would skip"
        (coverMisses emojiRe shoutRe)
    (Err e, _) => fail e
    (_, Err e) => fail e

-- Assertion 3: detector self-check --------------------------------------------

-- Each pair is named for whether the hook must reject it.
selfCheckPairs : List BlobPair
selfCheckPairs = [
  ("reject-added-sigil", Some "x = 1\n", "-- 🔒 keep\nx = 1\n"),
  (
    "reject-rewritten-sigil",
    Some "-- 🔒 keep\nx = 1\n",
    "-- 🔒 keep it\nx = 1\n",
  ),
  ("reject-added-caps", Some "x = 1\n", "-- DO NOT EDIT\nx = 1\n"),
  ("reject-new-file-block", None, "{- DO NOT EDIT -}\nx = 1\n"),
  (
    "reject-duplicated",
    Some "-- 🔒 keep\nx = 1\n",
    "-- 🔒 keep\n-- 🔒 keep\nx = 1\n",
  ),
  ("accept-caps-string", Some "x = 1\n", "x = \"DO NOT EDIT\"\n"),
  ("accept-unchanged", Some "-- 🔒 keep\nx = 1\n", "-- 🔒 keep\nx = 2\n"),
  (
    "accept-moved",
    Some "-- 🔒 keep\nx = 1\ny = 2\n",
    "x = 1\n-- 🔒 keep\ny = 2\n",
  ),
]

nameOf : String -> String
nameOf finding = match split ":" finding
  n :: _ => n
  [] => finding

detectorSelfCheck : Unit -> <Exec, IO, FileRead, FileWrite> Expectation
detectorSelfCheck () = withScratchDir
  (dir => match risenPairs dir selfCheckPairs
    Err e => fail e
    Ok found => expectEqual (sort (map nameOf found)) [
      "reject-added-caps",
      "reject-added-sigil",
      "reject-duplicated",
      "reject-new-file-block",
      "reject-rewritten-sigil",
    ])

test "diff_compiler_comment_shout_diff: no new shout line in .mdk outside test/ (PR diff)" =
  diffCheck ()

test "diff_compiler_comment_shout_diff: the hook's prefilter covers every flagged line" =
  prefilterCovers ()

test "diff_compiler_comment_shout_diff: detector rejects added and rewritten shouts only" =
  detectorSelfCheck ()
