-- Two Foo-granting externs whose authority sets together exceed setCardCap
-- (16) distinct members.  The row joins same-label atoms into one set, and the
-- union of 18 stays exact: an inferred set is never folded (#3464).
-- Bounding the function at bare `<Foo>` (the whole domain) ACCEPTS; a
-- narrower bound refuses the exact union (set_cap_saturate_ctrl.mdk).
effect Foo Set

extern g1 : String -> <FFI, Foo {"a","b","c","d","e","f","g","h","i"}> String
extern g2 : String -> <FFI, Foo {"j","k","l","m","n","o","p","q","r"}> String

both : String -> <Foo, FFI> String
both x =
  let _ = g1 x
  g2 x

main : <IO> Unit
main = println "cap saturate ok"
