-- Bool RETURN across a function boundary (slice 2b): `isPos` returns the result
-- of a comparison (a Bool word).  The call site reads `isPos`'s return type (Bool)
-- from the typechecker's stamp, so `main`'s result is printed via mdk_print_bool
-- (true/false), not as an Int — the boundary type, not the operand type, drives
-- the print routine.
isPos : Int -> Bool
isPos n = n > 0
main = isPos 5
