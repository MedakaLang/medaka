-- Regression for #2292: `medaka test` used to generate a prop parameter
-- structurally from its declared type for every type, so a user's `Arbitrary`
-- instance never reached the draw.  This prop fails within a handful of
-- structural draws (`Green` is generated roughly half the time) and passes
-- only when the instance is honored.
--
-- The doctest is load-bearing beyond what it asserts: `medaka test` skips
-- typechecking for a prop-only, doctest-free module (#1229), so without one
-- nothing here would prove the instance is well-typed.

-- Regression for #2813 case 2: the instance was consulted only for a prop
-- parameter's OWN top-level type, so `Color` reached as a FIELD of `Wrap` was
-- still drawn structurally.  `wrapIsRed` fails within a handful of structural
-- draws for the same reason `isRed` does.

data Color = Red | Green deriving (Eq, Debug)

data Wrap = Wrap Color deriving (Eq, Debug)

-- > isRed Red
-- True
-- > isRed Green
-- False
isRed : Color -> Bool
isRed Red = True
isRed Green = False

impl Arbitrary Color where
  arbitrary () = Red

-- > wrapIsRed (Wrap Red)
-- True
-- > wrapIsRed (Wrap Green)
-- False
wrapIsRed : Wrap -> Bool
wrapIsRed (Wrap c) = isRed c

prop "user generator is honored" (c : Color) = isRed c

prop "user generator is honored at a nested field" (w : Wrap) = wrapIsRed w
