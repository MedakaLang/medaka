-- #2588: a `test "…"` decl that needs a capability `medaka test`'s interpreter
-- policy does not grant.  Under `--native` it compiles to a real binary and
-- passes; under the default (eval) engine the capability gate refuses the file
-- by naming `runCommand`, instead of dying mid-run on eval's own `unbound
-- identifier`.
--
-- The subject is `medaka check` run on a sibling fixture: reading a file and
-- spawning a process are exactly the two things the eval policy withholds.
-- `MEDAKA` names the binary under test (the same variable the native runner's
-- own build step reads); `MEDAKA_TEST_SUBJECT` names the file to check.

import io.{runCommandOk}
import test.{fail, pass, Expectation}

envOrDefault : String -> String -> <Env "_"> String
envOrDefault name fallback = match getEnv name
  Some v => v
  None => fallback

-- Reads the subject first so a missing fixture fails as a missing fixture,
-- not as a confusing `medaka check` error about a path that is not there.
checkPasses : <Exec "_", Env "_", FileRead "_"> Expectation
checkPasses =
  let subject =
    envOrDefault
      "MEDAKA_TEST_SUBJECT"
      "test/compiler_test_fixtures/native_test_subject.mdk"
  match readFile subject
    Err e => fail "could not read the subject \{subject}: \{e}"
    Ok _ =>
      match runCommandOk (envOrDefault "MEDAKA" "medaka") ["check", subject]
        Err e => fail e
        Ok _ => pass

test "medaka check accepts the subject fixture" = checkPasses
