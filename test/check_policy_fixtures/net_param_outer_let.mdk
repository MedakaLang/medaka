-- WS-2 fixture: A4/outer — α scope-seeding (E3 precision).
-- The capability-bearing URL is bound by an OUTER-BODY `let dest = "<literal>"`
-- and only THEN passed as the `url` argument that carries the <Net Prefix>
-- extern's authority.  With an empty `lets` at the call site, α would see
-- `netGet dest` with `dest` as an unknown EVar → collapse to ⊤ → OVER-REJECT
-- under a wildcard policy.  α is seeded with the enclosing body's `let` scope, so
--   α(dest) = α("idp.example.com/api") = Known "idp.example.com/api"
-- and the inferred row carries <Net "idp.example.com/api">.
--
-- Intraprocedural ONLY: the let is in the SAME function body as the call.
-- `--allow 'Net=idp.example.com/*'` must ACCEPT.
effect Net Prefix

extern netGet : (url : String) -> <FFI, Net url> String

transform req =
  let dest = "idp.example.com/api"
  (u => netGet dest)
