-- WS-1c #3322 regression fixture.
-- `entry`'s WRITTEN signature carries the bare label `<Net>` — the Prefix
-- domain's ⊤, not a literal — and its body forwards a plain parameter to
-- `netGet`, whose Net authority is bound to that argument, so the atom
-- `medaka manifest` sees for `Net` is ⊤ on both the written and the inferred
-- side.  The manifest renderer must emit the bare ⊤ grant `Net = true`,
-- matching every other ⊤ atom, never a placeholder string.
effect Net Prefix

extern netGet : (url : String) -> <FFI, Net url> String

entry : String -> <FFI, Net> String
entry req = netGet req
