-- A runtime method abstracts to the Method axis's top, so it is charged as
-- every method and escapes a `Method={"GET"}` bound.  Bound to the primary
-- axis instead, the argument would land in Host and this would typecheck.
effect Http Product (Host : Prefix, Method : Set)

extern request : (host : String) ->
  (method : String) ->
  <FFI, Http Host=host Method=method> Int

get : String -> <FFI, Http Host="api.example.com/*" Method={"GET"}> Int
get m = request "api.example.com/users" m

main : <IO> Unit
main = println "should not typecheck"
