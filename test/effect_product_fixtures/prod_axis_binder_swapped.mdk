-- Each argument is charged on its own axis: passed swapped, the method lands
-- in Host and the host in Method, and neither lies within the bound.
effect Http Product (Host : Prefix, Method : Set)

extern request : (host : String) ->
  (method : String) ->
  <FFI, Http Host=host Method=method> Int

get : Unit -> <FFI, Http Host="api.example.com/*" Method={"GET"}> Int
get _ = request "GET" "api.example.com/users"

main : <IO> Unit
main = println "should not typecheck"
