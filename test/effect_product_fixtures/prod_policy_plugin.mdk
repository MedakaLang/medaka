-- WS-4 check-policy product plugin (native-only).  `transform` returns a closure
-- that reaches a product Net fetch confined to Host="idp.example.com/*"
-- Method={"GET","POST"}.  The latent returned-arrow effects remain visible to
-- check-policy, while its accepted-plugin sample run does not force an FFI call
-- that the tree-walking interpreter cannot perform.  A policy admitting that
-- product ACCEPTS; a narrower product policy REJECTS.
-- lint-disable-file rule-dead-code
effect Net Product

extern fetch : String -> <FFI, Net "@P{Host=\"idp.example.com/api\";Method={GET}}"> String

transform : String -> Unit -> <Net "@P{Host=\"idp.example.com/*\";Method={GET,POST}}", FFI> String
transform req = _ => fetch req

main : <IO> Unit
main = println "product plugin"
