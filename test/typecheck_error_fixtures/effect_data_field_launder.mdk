-- The data half's launders (EFFECTS-SEMANTICS §4.1), each beside its honest
-- twin in effect_data_field_ok: a literal outside the bound at construction,
-- a dynamic value stored into a qualified field, a literal reached where a
-- matched field's authority is the only admitted one, an index widened as if
-- covariant, a write of the wrong authority into a cell, and a record update
-- that replaces the qualified field with a literal.
data Handle (p : Authority FileRead) = Handle (String @p)

data Conf (p : Authority FileRead) = Conf { path : String @p, retries : Int }

-- the stored literal lies outside the declared index
cfg : Unit -> Handle "config/*"
cfg _ = Handle "/etc/passwd"

-- a runtime value abstracts to the whole domain
dyn : String -> Handle "config/*"
dyn s = Handle s

-- the matched field's authority is `p`; an unrelated literal is not within it
readIt : Handle p -> <FileRead p> Result String String
readIt (Handle _) = readFile "/etc/passwd"

-- an index is invariant: a narrower handle is not a wider one
widen : Handle "config/app.toml" -> Handle "config/*"
widen h = h

-- mutable storage keeps the stored index
overwrite : (path : String) -> Ref (Handle path) -> Unit
overwrite _ r = r := Handle "/etc/passwd"

-- an update of the qualified field is a proof obligation like construction
repoint : Conf p -> Conf p
repoint c = { c | path = "/etc/passwd" }

main = println 1
