-- #825's control: the SAME callback applied EAGERLY, before the pure thunk is
-- built, so the effect is charged at the arrow that performs it. Must check
-- clean; the deferred sibling effect_deferred_callback_launder.mdk is rejected.
interface Act a where
  act : a -> (Unit -> <e> Unit) -> <e> (Unit -> Unit)

data Dog = Dog

impl Act Dog where
  act d k =
    let _ = k ()
    (u => ())

main =
  let thunk = act Dog (u2 => putStr "EAGER ")
  let _ = thunk ()
  println "done"
