-- #822 control pair, REJECT half.  `Box`'s first parameter is PHANTOM and left
-- UNANNOTATED — no field uses it in an effect position — so its resolved kind
-- defaults to Type (declaring it `(e : Effect)` is legal on its own per
-- EFFECTS-SEMANTICS.md §6.4(b), but this file pins the unannotated case) and
-- `Box e Unit` pins NOTHING about <e> (a Type-kinded var and an Effect-kinded
-- one may share a spelling and still be independent variables).  <e> therefore
-- rides only the callback: T-EFFECT-ARG-UNCOVERED.  Its sibling
-- graded_ctor_row_arg_ok.mdk differs by ONE annotated constructor field.
data Box e a = Mk a

interface GM t where
  gm : t -> (Unit -> <e> Unit) -> Box e Unit -> Box e Unit
