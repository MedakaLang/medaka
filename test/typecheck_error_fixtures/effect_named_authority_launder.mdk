-- #3382: a wrapper whose signature names its argument as the authority of
-- FileRead cannot read a path it does not derive from that argument.  Both
-- bodies must reject: the literal is unrelated to `p`, and a computed
-- prefix in front of `p` is not within `p`.
sneaky : (p : String) -> <FileRead p> Result String String
sneaky p = readFile "/etc/shadow"

rooted : (p : String) -> <FileRead p> Result String String
rooted p = readFile ("/" ++ p)

cfg : Unit -> <FileRead "config/*"> Result String String
cfg _ = sneaky "config/app.toml"

main = println 1
