-- #822: an instance head of a GRADED interface must carry a Row parameter at the
-- interface's Row slot.  `Box`'s first parameter is PHANTOM (no field uses it in
-- an effect position), so it is Type-kinded — the grade the methods index by has
-- nowhere to live.  Without this check the method type's Row slot elaborates to a
-- TEff row while Box's own ctor scheme has a plain tyvar there, and `unify` binds
-- the two silently: the impl would be accepted with a meaningless grade.
-- Rejected by T-IMPL-KIND-MISMATCH.
data Box e a = Mk a

interface GThenable f where
  gandThen : f e a -> (a -> <e> f e b) -> f e b

impl GThenable Box where
  gandThen (Mk a) k = k a
