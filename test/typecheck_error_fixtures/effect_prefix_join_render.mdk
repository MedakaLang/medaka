-- Two prefix authorities joined across branches are the set of both,
-- rendered one atom per element, which is written syntax: the inferred
-- scheme copied into a signature is accepted as the same row, and a pattern
-- covering both is accepted as a wider bound.
effect Net Prefix

extern visit : (host : String) -> <Net host, FFI> Unit

joined b = if b then visit "a.com/x" else visit "a.com.evil/x"

written : Bool -> <FFI, Net "a.com.evil/x", Net "a.com/x"> Unit
written b = if b then visit "a.com/x" else visit "a.com.evil/x"

wider : Bool -> <FFI, Net "a.com*"> Unit
wider b = if b then visit "a.com/x" else visit "a.com.evil/x"

main = println 1
