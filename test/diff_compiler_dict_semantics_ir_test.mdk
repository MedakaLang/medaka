entryOf : (String, String, Kind, String) -> String
entryOf (e, _, _, _) = e

rowName : (String, String, Kind, String) -> String
rowName (e, label, _, _) = "\{e} | \{label}"

-- Distinct entries, first occurrence order, so each fixture builds once.
distinct : List String -> List String
distinct [] = []
distinct (x :: r) = x :: distinct (L.filter (/= x) r)

-- Output stem for an entry: `/` and `.` become `_`, so the kept IR is
-- `<work>/<stem>.ir.ll`.
irName : String -> String
irName e = S.replaceAll "/" "_" (S.replaceAll "." "_" e)

-- Build one fixture with its kept IR, and return the IR text.
buildOne : String -> String -> <Exec, IO, FileRead> Result String String
buildOne work entry = match boundedInTree 60 medakaBin [
  "build",
  "--keep-ir",
  "\{fixtures}/\{entry}",
  "-o",
  "\{work}/\{irName entry}.ir",
]
  Err e => Err "could not spawn build: \{e}"
  Ok (code, _, _) =>
    if code /= 0 then
      Err "build exited \{intToString code}"
    else
      readFile "\{work}/\{irName entry}.ir.ll"

buildEach : String ->
  List String ->
  <Exec, IO, FileRead> List (String, Result String String)
buildEach _ [] = []
buildEach work (e :: r) = (e, buildOne work e) :: buildEach work r

irFor : String ->
  List (String, Result String String) ->
  Option (Result String String)
irFor _ [] = None
irFor e ((k, v) :: r) = if k == e then Some v else irFor e r

-- Number of IR lines the regex matches (grep -c semantics).
hitCount : String -> String -> Int
hitCount pat ir = match R.compile pat
  Err _ => -1
  Ok re => length (L.filter (l => R.isMatch re l) (S.lines ir))

-- Each verdict returns "" when the row is green, else its failure message.
verdict : String -> Kind -> Int -> String
verdict label Has n = if n > 0 then "" else "HAS not found: \{label}"
verdict label Lacks n =
  if n == 0 then "" else "LACKS found \{intToString n} line(s): \{label}"
verdict label (Count want) n =
  if n == want then
    ""
  else
    "COUNT=\{intToString want} but found \{intToString n}: \{label}"

-- Problem text for one row, "" when green. Every row is evaluated, so a
-- single run names every red row.
rowProblem : List (String, Result String String) ->
  (String, String, Kind, String) ->
  String
rowProblem irs (entry, label, kind, pat) = match irFor entry irs
  None => "\{entry}: no build was attempted"
  Some (Err e) => "\{entry}: no kept IR (build failed or .ll missing): \{e}"
  Some (Ok ir) =>
    if hitCount pat ir == -1 then
      "invalid regex: \{pat}"
    else
      verdict label kind (hitCount pat ir)

-- Problem line for a row: "" when green, else "<entry> | <label>: <why>".
rowLine : List (String, Result String String) ->
  (String, String, Kind, String) ->
  String
rowLine irs r = match rowProblem irs r
  "" => ""
  msg => "\{rowName r} :: \{msg}"

section3 : String -> <Exec, IO, FileRead, FileWrite> Expectation
section3 work =
  let irs = buildEach work (distinct (map entryOf rows))
  let red = filter (/= "") (map (r => rowLine irs r) rows)
  expectAll [
    expectAtLeast 92 (length rows),
    reportRed red,
  ]

-- One failure naming every red row, or pass when none is red.
reportRed : List String -> Expectation
reportRed [] = pass
reportRed red =
  fail "\{intToString (length red)} red row(s):\n\{S.join "\n" red}"

test "diff_compiler_dict_semantics_ir (section 3): emitted LLVM dict arity and impl routing" =
  withScratchDir section3
