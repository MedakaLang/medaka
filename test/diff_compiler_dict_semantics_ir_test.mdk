    "#679/#993 DECLARED ARITY: a three-level super chain (Top requires Mid requires Base) reached through one declared `Top a =>` dict. `useTop` takes 1 dict + 1 value; `mid` and `base` are projections of that one dictionary along paths [0] and [0,0]",
    "HAS",
    "^define internal i64 @mdk\\.user\\.6d3733333232643733373537303635373232643633363836313639366533335f5f757365546f70\\(i64 %arg0, i64 %arg1\\)",
  ),
  (
    "s2-requires-super-projected.mdk",
    "#679/#993 DECLARED ARITY: an impl with `requires Hi a` whose own body needs Hi's super `Sz a`. The impl fn takes 1 requires-dict + 1 value; `sz v` projects the super out of the `Hi a` dictionary",
    "HAS",
    "^define internal i64 @mdk\\.impl\\.7a5a73325f32645f72657175697265735f32645f73757065725f32645f70726f6a65637465645f32655f426f78\\.6869\\(i64 %arg0, i64 %arg1\\)",
  ),
]

-- Pure helpers ----------------------------------------------------------------

entryOf : (String, String, String, String) -> String
entryOf (e, _, _, _) = e

rowsFor : String -> List (String, String, String, String)
rowsFor entry = filter (r => entryOf r == entry) table

-- "COUNT=2" -> "2"; anything else -> "?", which no hit count renders as.
wantOf : String -> String
wantOf kind = match split "=" kind
  _ :: n :: _ => n
  _ => "?"

hitsOk : String -> Int -> Bool
hitsOk kind hits =
  if kind == "HAS" then
    hits > 0
  else if kind == "LACKS" then
    hits == 0
  else
    intToString hits == wantOf kind

countHits : Regex -> String -> Int
countHits re ir = length (filter (l => isMatch re l) (lines ir))

-- Grading -----------------------------------------------------------------------

gradeOne : String -> String -> String -> String -> String -> Expectation
gradeOne entry ir label kind pat = match compile pat
  Err _ => fail "\{entry}: grep FAILED: pattern does not compile: \{pat}"
  Ok re =>
    let hits = countHits re ir
    if hitsOk kind hits then
      pass
    else
      fail
        "\{entry} [\{label}] \{kind} \{pat} -- found \{intToString hits} matching lines"

gradeRow : String -> String -> (String, String, String, String) -> Expectation
gradeRow entry ir (_, label, kind, pat) = gradeOne entry ir label kind pat

readIr : String -> String -> <FileRead> Expectation
readIr entry dir = match readFile "\{dir}/ir.ll"
  Err e => fail "\{entry}: no IR emitted (build failed?): \{e}"
  Ok ir => expectAll (map (r => gradeRow entry ir r) (rowsFor entry))

-- The entry's own state before its build, or the Expectation that settles it.
prepEntry : String ->
  Result String String ->
  <FileRead, IO> Result Expectation (String, String, String)
prepEntry entry (Err e) =
  Err (fail "\{entry}: could not make a scratch directory: \{e}")
prepEntry entry (Ok dir) =
  let path = underRoot "test/dict_fixtures/\{entry}"
  match isFile path
    Err e => Err (fail "\{entry}: could not stat fixture: \{e}")
    Ok False => Err (fail "\{entry}: MISSING FIXTURE FILE")
    Ok True => Ok (entry, dir, path)

buildSpawn : String -> (String, String, String) -> List (String, List String)
buildSpawn bin (_, dir, path) =
  [(bin, ["build", "--keep-ir", path, "-o", "\{dir}/ir"])]

gradeBuilt : (String, String, String) ->
  List (Result String (Int, String, String)) ->
  <FileRead, IO> Expectation
gradeBuilt (entry, dir, _) [r] = match r
  Err e => fail "\{entry}: could not spawn medaka build: \{e}"
  Ok (code, _, err) =>
    if code /= 0 then
      fail "\{entry}: build exited \{intToString code}: \{err}"
    else
      readIr entry dir
gradeBuilt (entry, _, _) _ = fail "\{entry}: internal: no single build result"

-- One group of entries: every directory made, every fixture checked, the
-- builds run as one batch, then the group's directories removed. A build the
-- batch did not answer, or an entry that got no directory, is a failure row.
groupEntries : List String -> <Exec, IO, FileRead> List (String, Expectation)
groupEntries group =
  let bin = medakaBin
  let dirs = map freshDirFor group
  let prepared = prepEntries group dirs
  let live = somes (map liveOf prepared)
  let graded =
    gradeBuilts live (spawnEach spawnTimeoutSeconds (buildSpawn bin) live)
  let settled = mergeStage fail prepared (map (g => Ok g) graded)
  let _ = map (d => runVerb "rm" ["-rf", d]) (somes (map okDir dirs))
  labelGrades group (map finalOf settled)

entries : List String
entries = nub (map entryOf table)

-- `prepEntry` and `gradeBuilt` take effects, so they are applied by recursion.
prepEntries : List String ->
  List (Result String String) ->
  <FileRead, IO> List (Result Expectation (String, String, String))
prepEntries [] [] = []
prepEntries (e :: es) (d :: ds) = prepEntry e d :: prepEntries es ds
prepEntries (e :: es) [] =
  Err (fail "\{e}: internal: no scratch directory was made")
    :: prepEntries es []
prepEntries [] (_ :: ds) =
  Err (fail "internal: a scratch directory was made for no entry")
    :: prepEntries [] ds

gradeBuilts : List (String, String, String) ->
  List (List (Result String (Int, String, String))) ->
  <FileRead, IO> List Expectation
gradeBuilts [] [] = []
gradeBuilts (e :: es) (r :: rs) = gradeBuilt e r :: gradeBuilts es rs
gradeBuilts ((entry, _, _) :: es) [] =
  fail "\{entry}: internal: the build batch returned no result"
    :: gradeBuilts es []
gradeBuilts [] (_ :: rs) =
  fail "internal: the build batch answered an entry that was not live"
    :: gradeBuilts [] rs

test "diff_compiler_dict_semantics_ir: section 3 emitted-LLVM IR rows" = expectAll
  [
    expectAtLeast 92 (length table),
    expectEach (flatMap groupEntries (chunks testJobs entries)),
  ]

test "diff_compiler_dict_semantics_ir: grader decides HAS, LACKS and COUNT= correctly" = expectAll
  [
    expectTrue (hitsOk "HAS" 1),
    expectTrue (not (hitsOk "HAS" 0)),
    expectTrue (hitsOk "LACKS" 0),
    expectTrue (not (hitsOk "LACKS" 1)),
    expectTrue (hitsOk "COUNT=2" 2),
    expectTrue (not (hitsOk "COUNT=2" 1)),
    expectTrue (not (hitsOk "COUNT=2" 3)),
    expectTrue (not (hitsOk "MAYBE" 1)),
  ]
