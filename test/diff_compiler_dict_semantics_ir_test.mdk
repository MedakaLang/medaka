{- | DICT-SEMANTICS section 3: emitted LLVM structure, over test/dict_fixtures.
   Replaces diff_compiler_dict_semantics_ir.sh. The corpus, the discipline and
   the known-divergence ledger live in test/dict_fixtures/README.md.

   Each distinct fixture entry is built once with `medaka build --keep-ir`
   (bounded to 60s), and the kept .ll is graded line by line with a POSIX
   extended regex (regex.isMatch on each line, as grep -cE counts lines):
     HAS      at least one line matches
     LACKS    no line matches
     COUNT=n  exactly n lines match
   A missing .ll, a failed build, or an invalid regex fails its row; a LACKS
   row can never pass on a broken pattern.

   Proves: dictionary-parameter arity of emitted definitions (the dead-slot and
   arity-skew bugs that behaviour cannot see), which dictionary or impl each
   call site passes (positional identity, cross-module, #1128 three-site drain,
   #1403 one-word-per-arm), and the canonical dictionary-word constants.
   Does NOT prove: runtime behaviour (sections 1 and 2 cover values), or any
   optimisation level (the IR is emitted before clang runs).

   Usage: medaka test <this file>. Needs clang for the builds. -}

import test_process.{medakaBin, underRoot, withScratchDir}
import compiler_cli_test_support.{boundedInTree}
import test.{Expectation, expectAll, expectAtLeast, fail, pass}
import string as S
import regex as R
import list as L

fixtures : <IO> String
fixtures = underRoot "test/dict_fixtures"

data Kind = Has | Lacks | Count Int

-- entry, label, kind, extended regex. One row per assertion of the old table.
rows : List (String, String, Kind, String)
rows = [
