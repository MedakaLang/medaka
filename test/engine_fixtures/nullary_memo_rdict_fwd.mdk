-- A nullary return-position impl method reached through a RUNTIME-DICT route, here
-- RDictFwd (the dict a polymorphic caller `useTwice : HasUnit a =>` forwards at a
-- concrete type), is evaluated at each occurrence as on any other route, so its
-- effect runs twice: `[eval] [eval] XX`.
interface HasUnit a where
  theUnit : <Stdout> a

data Box = Box String

impl HasUnit Box where
  theUnit =
    let _ = putStr "[eval] "
    Box "X"

unBox : Box -> String
unBox (Box s) = s

useTwice : HasUnit a => (a -> String) -> <Stdout> String
useTwice un =
  let a = un theUnit
  let b = un theUnit
  a ++ b

main = putStrLn (useTwice unBox)
