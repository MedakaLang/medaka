-- The foreign interface exports the same method spellings as Num. Reversing
-- these independent imports must not change the operator's prelude Num identity.
-- lint-disable-file rule-missing-signature

import numop_predicate.foreign.{add, rem}
import numop_predicate.box.{Box(..)}
import numop_predicate.num.{numReady}

signedAdd : Num a => a -> a -> a
signedAdd x y = x + y

signedSub : Num a => a -> a -> a
signedSub x y = x - y

signedMul : Num a => a -> a -> a
signedMul x y = x * y

signedDiv : Num a => a -> a -> a
signedDiv x y = x / y

signedRem : Num a => a -> a -> a
signedRem x y = x % y

inferredAdd x y = x + y

inferredSub x y = x - y

inferredMul x y = x * y

inferredDiv x y = x / y

inferredRem x y = x % y

localRem : Num a => a -> a -> a
localRem x y = let local _ = x % y in local ()

main =
  println (signedAdd (Box 12) (Box 3) == Box 1203)
  println (signedSub (Box 12) (Box 3) == Box 1197)
  println (signedMul (Box 12) (Box 3) == Box 12003)
  println (signedDiv (Box 12) (Box 3) == Box 120003)
  println (signedRem (Box 13) (Box 5) == Box 100003)
  println (inferredAdd (Box 12) (Box 3) == Box 1203)
  println (inferredSub (Box 12) (Box 3) == Box 1197)
  println (inferredMul (Box 12) (Box 3) == Box 12003)
  println (inferredDiv (Box 12) (Box 3) == Box 120003)
  println (inferredRem (Box 13) (Box 5) == Box 100003)
  println (localRem (Box 13) (Box 5) == Box 100003)
  println (Box 12 + Box 3 == Box 1203)
  println (Box 12 - Box 3 == Box 1197)
  println (Box 12 * Box 3 == Box 12003)
  println (Box 12 / Box 3 == Box 120003)
  println (Box 13 % Box 5 == Box 100003)
