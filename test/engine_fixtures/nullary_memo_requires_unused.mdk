-- A nullary return-position impl of a requires-bearing instance whose body does not
-- read its prerequisite binds no dictionary and is evaluated at each occurrence like
-- any other.  Reached through a runtime dictionary (`useTwice : HasUnit a =>`),
-- twice per instance, so every engine prints `[box] [box] [wrap] [wrap] BB00`.
interface HasUnit a where
  theUnit : <Stdout> a

data Box = Box String

data Wrap a = Wrap (List a)

impl HasUnit Box where
  theUnit =
    let _ = putStr "[box] "
    Box "B"

impl HasUnit (Wrap a) requires HasUnit a where
  theUnit =
    let _ = putStr "[wrap] "
    Wrap []

wrapLen : Wrap a -> Int
wrapLen (Wrap xs) = length xs

unBox : Box -> String
unBox (Box s) = s

useTwice : HasUnit a => (a -> String) -> <Stdout> String
useTwice un = un theUnit ++ un theUnit

main =
  putStrLn
    (useTwice unBox ++ useTwice (w => intToString (wrapLen (w : Wrap Box))))
