-- Two DIFFERENT concrete types' nullary return-position impl methods evaluate
-- independently, at each occurrence: the effects fire in occurrence order,
-- `[box] [cup] [box] [cup] BCBC`, on all three engines.
interface HasUnit a where
  theUnit : <Stdout> a

data Box = Box String
data Cup = Cup String

impl HasUnit Box where
  theUnit =
    let _ = putStr "[box] "
    Box "B"

impl HasUnit Cup where
  theUnit =
    let _ = putStr "[cup] "
    Cup "C"

unBox : Box -> String
unBox (Box s) = s

unCup : Cup -> String
unCup (Cup s) = s

main =
  let a = unBox (theUnit : Box)
  let b = unCup (theUnit : Cup)
  let c = unBox (theUnit : Box)
  let d = unCup (theUnit : Cup)
  putStrLn (a ++ b ++ c ++ d)
