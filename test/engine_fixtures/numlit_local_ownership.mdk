-- DICT §6.3 D4: each local boundary below receives an already-live numeric
-- root from its enclosing declared function. The boundary must leave that root
-- to the caller; calls fix it independently to Float and to a custom Num Box.
-- lint-disable-file rule-missing-signature, rule-lambda-section

data Box a = Box a deriving (Eq)

impl Num (Box a) requires Num a where
  add (Box x) (Box y) = Box (x * 100 + y)
  sub (Box x) (Box y) = Box (x - y)
  mul (Box x) (Box y) = Box (x * y)
  div (Box x) (Box y) = Box (x / y)
  negate (Box x) = Box (-x)
  abs (Box x) = Box (abs x)
  signum (Box x) = Box (signum x)
  fromInt n = Box (fromInt n)
  rem (Box x) (Box y) = Box (x % y + 100000)

directNum : Num a => a -> a
directNum x = x + 0

blockLambdaNum : Num a => a -> a
blockLambdaNum x =
  let local = _ => x + 0
  local ()

blockLetNum : Num a => a -> a
blockLetNum x =
  let local = x + 0
  local

inferRecNum : Num a => a -> a
inferRecNum x = let local _ = x + 0 in local ()

inferLetNum : Num a => a -> a
inferLetNum x = let local = x + 0 in local

groupNum : Num a => a -> a
groupNum x = local ()
  where
    local _ = x + 0

-- A root created by the boundary has no outer determination channel and still
-- defaults to Int. These five functions exercise the same producer routes.
blockLambdaOwn _ =
  let local = _ => 1
  local ()

blockLetOwn _ =
  let local = 1
  local

inferRecOwn _ = let local _ = 1 in local ()

inferLetOwn _ = let local = 1 in local

groupOwn _ = local ()
  where
    local _ = 1

-- These controls keep concrete Int, concrete Float, and nonnumeric captures
-- distinct from the polymorphic numeric capture exercised above.
capturedInt : Int -> Int
capturedInt x =
  let local = _ => x + 1
  local ()

capturedFloat : Float -> Float
capturedFloat x = let local _ = x + 0.25 in local ()

capturedPair : String -> Bool -> (String, Bool)
capturedPair text flag = local ()
  where
    local _ = (text, flag)

-- Arithmetic under a same-spelled binder belongs to that binder, while the
-- outer unconstrained parameter must still carry the caller's String value.
shadowedLambda x = ((x => x + 1) 41, x)

shadowedGroup x = (x, let rec x _ = 41 + 1 in x ())

-- Numeric context must reach captures through both orders of nested closure
-- and group boundaries. ownAndCaptured needs context for both x and local y.
lamThenGroup : Num a => a -> a
lamThenGroup x = let f = y => let rec g z = y + z in g y in f x

groupThenLam : Num a => a -> a
groupThenLam x = local x
  where
    local z = (y => x + y + z) x

ownAndCaptured : Num a => a -> a
ownAndCaptured x = let f = y => x + y in f x

-- Unsigned outer functions must infer and retain their Num caller channel
-- across the four formatter-stable local-boundary forms.
inferredBlock x =
  let local = x + 0
  local

inferredInlineRec x = let local _ = x + 0 in local ()

inferredInline x = let local = x + 0 in local

inferredGroup x = local ()
  where
    local _ = x + 0

-- Top-level SCC defaulting remains unrestricted in this slice. The expansive
-- Ref keeps the function weakly monomorphic, and its application fixes n to Int.
cell = Ref (x => x)
n = cell.value 1

main =
  println (directNum (1.5 : Float) == 1.5)
  println (blockLambdaNum (1.5 : Float) == 1.5)
  println (blockLetNum (1.5 : Float) == 1.5)
  println (inferRecNum (1.5 : Float) == 1.5)
  println (inferLetNum (1.5 : Float) == 1.5)
  println (groupNum (1.5 : Float) == 1.5)
  println (directNum (Box 1) == Box 100)
  println (blockLambdaNum (Box 1) == Box 100)
  println (blockLetNum (Box 1) == Box 100)
  println (inferRecNum (Box 1) == Box 100)
  println (inferLetNum (Box 1) == Box 100)
  println (groupNum (Box 1) == Box 100)
  println (blockLambdaOwn () == 1)
  println (blockLetOwn () == 1)
  println (inferRecOwn () == 1)
  println (inferLetOwn () == 1)
  println (groupOwn () == 1)
  println (capturedInt 41 == 42)
  println (capturedFloat 2.0 == 2.25)
  println (capturedPair "kept" True == ("kept", True))
  println (shadowedLambda "kept" == (42, "kept"))
  println (shadowedGroup "kept" == ("kept", 42))
  println (lamThenGroup (1.5 : Float) == 3.0)
  println (groupThenLam (1.5 : Float) == 4.5)
  println (ownAndCaptured (1.5 : Float) == 3.0)
  println (inferredBlock (1.5 : Float) == 1.5)
  println (inferredInlineRec (1.5 : Float) == 1.5)
  println (inferredInline (1.5 : Float) == 1.5)
  println (inferredGroup (1.5 : Float) == 1.5)
  println (inferredBlock (Box 1) == Box 100)
  println (inferredInlineRec (Box 1) == Box 100)
  println (inferredInline (Box 1) == Box 100)
  println (inferredGroup (Box 1) == Box 100)
  println n
