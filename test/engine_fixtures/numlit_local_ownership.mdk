-- DICT §6.3 D4: each local boundary below receives an already-live numeric
-- root from its enclosing declared function. The boundary must leave that root
-- to the caller; every call fixes it to Float and must therefore return 1.5.
-- lint-disable-file rule-missing-signature

directNum : Num a => a -> a
directNum x = x + 0

blockRecNum : Num a => a -> a
blockRecNum x =
  let local = _ => x + 0
  local ()

blockLetNum : Num a => a -> a
blockLetNum x =
  let local = x + 0
  local

inferRecNum : Num a => a -> a
inferRecNum x = let local _ = x + 0 in local ()

inferLetNum : Num a => a -> a
inferLetNum x = let local = x + 0 in local

groupNum : Num a => a -> a
groupNum x = local ()
  where
    local _ = x + 0

-- A root created by the boundary has no outer determination channel and still
-- defaults to Int. These five functions exercise the same producer routes.
blockRecOwn _ =
  let local = _ => 1
  local ()

blockLetOwn _ =
  let local = 1
  local

inferRecOwn _ = let local _ = 1 in local ()

inferLetOwn _ = let local = 1 in local

groupOwn _ = local ()
  where
    local _ = 1

-- Top-level SCC defaulting remains unrestricted in this slice. The expansive
-- Ref keeps the function weakly monomorphic, and its application fixes n to Int.
cell = Ref (x => x)
n = cell.value 1

main =
  println (directNum (1.5 : Float) == 1.5)
  println (blockRecNum (1.5 : Float) == 1.5)
  println (blockLetNum (1.5 : Float) == 1.5)
  println (inferRecNum (1.5 : Float) == 1.5)
  println (inferLetNum (1.5 : Float) == 1.5)
  println (groupNum (1.5 : Float) == 1.5)
  println (blockRecOwn () == 1)
  println (blockLetOwn () == 1)
  println (inferRecOwn () == 1)
  println (inferLetOwn () == 1)
  println (groupOwn () == 1)
  println n
