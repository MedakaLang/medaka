-- Building a byte string without an `Array Int` anywhere in the path: allocate,
-- write each byte, freeze.  The route this replaces -- fill an `Array Int`, hand
-- it to `fromArray` -- boxes a machine word per byte before packing them, which
-- is the cost the packed representation exists to avoid, so a construction path
-- that still allocates an array defeats the type.
--
-- The three engines agree on the values; what the array-freedom claim rests on
-- is the emitted IR for `buildBytes`/`buildGo`, checked in the slice report.

import bytes as B
import bytes.{Bytes}
import mut_bytes.{MutBytes, freeze, make, setInPlace}
import u8 as U8

buildGo : MutBytes -> Int -> Int -> Unit
buildGo mb i n
  | i >= n = ()
  | otherwise =
    let _ = setInPlace i (fromInt (i * 3)) mb
    buildGo mb (i + 1) n

buildBytes : Int -> Bytes
buildBytes n =
  let mb = make n
  let _ = buildGo mb 0 n
  freeze mb

sumGo : Bytes -> Int -> Int -> Int
sumGo b i n
  | i >= n = 0
  | otherwise = U8.toInt b[i] + sumGo b (i + 1) n

main =
  let b = buildBytes 16
  (B.length b, b[0], b[5], b[15], sumGo b 0 (B.length b))
