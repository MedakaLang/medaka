-- #3800: `desc`'s own context constrains only the interface parameter.  At
-- `impl Desc (Pair b)` the context is `Show2 (Pair b)`, which the instance head
-- leaves open, so the call supplies that dictionary and the body's `show2 p`
-- reads it.  Expected, from the impls: `show2 (Pair 1 2)` = `show2 1` = "int 1".
data Pair a = Pair a a

interface Show2 a where
  show2 : a -> String

impl Show2 Int where
  show2 n = "int \{n}"

impl Show2 (Pair b) requires Show2 b where
  show2 (Pair x _) = show2 x

interface Desc a where
  desc : Show2 a => a -> String

impl Desc (Pair b) where
  desc p = show2 p

main = println (desc (Pair (1 : Int) 2))
