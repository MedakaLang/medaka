-- A nullary return-position impl method with two impls, reached through a
-- polymorphic runtime-dict route (`useTwice : HasUnit a =>` forwards the dict at a
-- type only known at RUNTIME), is evaluated at each occurrence: each resolved
-- tag's effect fires once per occurrence, `[box] [box] [cup] [cup] BBCC`.  Box and
-- Cup evaluate their own bodies, never one shared value.
interface HasUnit a where
  theUnit : <Stdout> a

data Box = Box String
data Cup = Cup String

impl HasUnit Box where
  theUnit =
    let _ = putStr "[box] "
    Box "B"

impl HasUnit Cup where
  theUnit =
    let _ = putStr "[cup] "
    Cup "C"

unBox : Box -> String
unBox (Box s) = s

unCup : Cup -> String
unCup (Cup s) = s

useTwice : HasUnit a => (a -> String) -> <Stdout> String
useTwice un = un theUnit ++ un theUnit

main = putStrLn (useTwice unBox ++ useTwice unCup)
