-- #1617 — a LONE arrow-headed impl. This is a DIFFERENT code path from the
-- two-impl pair beside it and must be pinned separately: with one impl at the
-- head there is no collision, so `keyForSite` stamps the BARE head tag
-- (`__fun__`) instead of upgrading to the canonical impl word, and
-- `core_ir_lower.declRouteKey` must independently derive the same bare tag from
-- `eval.headTycon`. The pair-only fixtures ride the canonical-word branch and
-- would stay green if the two sides disagreed about the bare tag.
--
-- Expected `5`, derived from the source: `f : Int -> Int` is the only receiver
-- and there is only one impl it can match.
interface Sz a where
  sz : a -> Int

impl Sz (Int -> Int) where
  sz _ = 5

f : Int -> Int
f x = x + 1

main = println (sz f)
