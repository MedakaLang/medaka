-- A `main : Async _` is driven by every engine (#2506): all three apply the one
-- driver, `runAsyncMain`, which is the scheduler.  The scheduler names no clock
-- and no poll extern of its own, so it runs on wasm too.  Spawned tasks and
-- `concurrent` collect in input order, so all three must print the same lines.
import async.{Async, liftIO, spawnTask, await, concurrent}

main : Async <Stdout> Unit
main = defer
  _ <- liftIO (u => putStrLn "start")
  xs <- concurrent [liftIO (u => 1), liftIO (u => 2), liftIO (u => 3)]
  _ <- liftIO (u => putStrLn (display xs))
  t <- spawnTask (liftIO (u => 40))
  v <- await t
  liftIO (u => putStrLn (display (v + 6)))
