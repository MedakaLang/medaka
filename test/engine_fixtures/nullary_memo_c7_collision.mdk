-- Two impls that share a head tycon but differ in type args
-- (`Foo (MyPair Int Bool)` vs `Foo (MyPair Bool Int)`) are a TYPECHECK-AUDIT C7
-- collision: the route carries the canonical KEY (`Foo|(MyPair Int Bool)|`), not the
-- bare head `MyPair`.  A nullary return-position impl method is evaluated at each
-- occurrence, so both colliding impls are exercised twice and each effect fires per
-- occurrence, in occurrence order: `[IB] [IB] [BI] [BI] 4`.
data MyPair a b = MyPair a b

interface Foo a where
  theVal : <Stdout> a

impl Foo (MyPair Int Bool) where
  theVal =
    let _ = putStr "[IB] "
    MyPair 1 True

impl Foo (MyPair Bool Int) where
  theVal =
    let _ = putStr "[BI] "
    MyPair True 1

fstI : MyPair Int Bool -> Int
fstI (MyPair a _) = a

sndI : MyPair Bool Int -> Int
sndI (MyPair _ b) = b

main =
  let a = fstI (theVal : MyPair Int Bool)
  let b = fstI (theVal : MyPair Int Bool)
  let c = sndI (theVal : MyPair Bool Int)
  let d = sndI (theVal : MyPair Bool Int)
  println (a + b + c + d)
