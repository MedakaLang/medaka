-- U8/U32 reached through an `Ord a =>` dictionary rather than at their ground
-- type: `maximum`/`minimum`, `sort`, and a user function comparing with `>`.
-- The u8/u32 `Ord` impls define only `compare`, so every other `Ord` method is
-- the interface default.  Values straddle 2^31 so a signed comparison would
-- pick the wrong answer.
--
-- Ledgered wasm:codegen-bug #1020 (test/engine_divergence.txt): wasm's
-- dictionary dispatch has no interface-default arms, so the first defaulted
-- method traps.  eval and native agree; when wasm is fixed the ledger row
-- goes PROMOTE.
--
-- Expected (eval and native): Some 4294967295 / Some 0 / the sorted list /
-- 3000000000 / 200.
import u8
import u32
import list.{sort}

bigger : Ord a => a -> a -> a
bigger a b = if a > b then a else b

ws : List U32
ws = [3000000000, 0, 4294967295, 2147483648, 1]

main =
  println (maximum ws, minimum ws)
  println (sort ws)
  println (bigger (3000000000 : U32) 2147483647)
  println (bigger (200 : U8) 100)
