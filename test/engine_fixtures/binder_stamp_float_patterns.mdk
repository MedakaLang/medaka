-- A Float reaches its use through a pattern binder: a constructor field bound
-- in a match arm, an `Option` payload, a tuple-pattern parameter, and a tuple
-- matched in the body.  Each is read as a Float, never as an Int word.
-- Expected, derived from the source:
-- `scale (Circle 1.25)` = 2.5; `scale (Sq 1.5)` = 2.25;
-- `twiceSome (Some 1.75)` = 3.5; `sumF (0.5, 0.25)` = 0.75;
-- `addF (1.5, 0.125)` = 1.625.
data Shape = Circle Float | Sq Float

scale : Shape -> Float
scale s = match s
  Circle r => r * 2.0
  Sq w => w * w

twiceSome : Option Float -> Float
twiceSome o = match o
  Some v => v + v
  None => 0.5

sumF : (Float, Float) -> Float
sumF (a, b) = a + b

addF : (Float, Float) -> Float
addF p = match p
  (a, b) => a + b

main =
  println (scale (Circle 1.25))
  println (scale (Sq 1.5))
  println (twiceSome (Some 1.75))
  println (sumF (0.5, 0.25))
  println (addF (1.5, 0.125))
