-- #1518: a record UPDATE `{ r | g = e1, f = e2 }` whose override expressions are
-- written out of DECLARATION order evaluates them once each, in WRITTEN order, on
-- all three engines.  The computed field VALUES never differed; the SIDE-EFFECT
-- ORDER (which `println` fires first) is what this fixture pins, and it is invisible
-- to any gate that only compares final values.
--
-- `g` is written first, `f` second; `R` declares `f` before `g`.
--
-- EXPECTED OUTPUT, HAND-DERIVED from this source (the language spec says written
-- order, exactly once): "g\nf\n10\n20\n".  `core_ir_lower` binds the overrides to
-- temporaries in written order and stores them by declared ordinal, so neither
-- emitter walks the declaration to decide what runs first.

data R = R { f : Int, g : Int }

bump : String -> Int -> <IO> Int
bump tag n =
  println tag
  n

main : <IO> Unit
main =
  let base = R { f = 0, g = 0 }
  let r = { base | g = bump "g" 20, f = bump "f" 10 }
  println r.f
  println r.g
