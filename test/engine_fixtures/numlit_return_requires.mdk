-- The literal must call Num and forward Num Int into its body. Nested literals
-- and arithmetic consume that dictionary. Explicit fromInt selects Forge, whose
-- concrete implementation has no prerequisite dictionary.

data Box a = Box a deriving (Eq)

interface Forge a where
  fromInt : Int -> a

impl Forge (Box Int) where
  fromInt _ = Box (2000 + 1)

impl Num (Box a) requires Num a where
  add (Box x) (Box y) = Box (x + y)
  sub (Box x) (Box y) = Box (x - y)
  mul (Box x) (Box y) = Box (x * y)
  div (Box x) (Box y) = Box (x / y)
  negate (Box x) = Box (-x)
  abs (Box x) = Box (abs x)
  signum (Box x) = Box (signum x)
  fromInt _ = Box (1000 + 1)

unBox : Box a -> a
unBox (Box x) = x

literal : Box Int
literal = 1

explicit : Box Int
explicit = fromInt 1

main =
  println (unBox literal)
  println (unBox explicit)
