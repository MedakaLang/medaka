-- #1617 — the PERMUTATION partner of fun_head_impl_ab.mdk: byte-identical
-- except that the two impl blocks are declared in the opposite order.
--
-- Expected `(5, 9)` — the SAME answer as the partner, hand-derived from the
-- source. Impl selection is by type, not by declaration order, so a fixture
-- pair that disagrees is the bug. Pre-fix this file printed `(9, 9)` while its
-- partner printed `(5, 5)`: both wrong, differently, at exit 0.
interface Sz a where
  sz : a -> Int

impl Sz (Bool -> Bool) where
  sz _ = 9

impl Sz (Int -> Int) where
  sz _ = 5

f : Int -> Int
f x = x + 1

g : Bool -> Bool
g b = b

main = println (sz f, sz g)
