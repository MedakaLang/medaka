public export data Box a = Box a deriving (Eq)

export impl Num (Box a) requires Num a where
  add (Box x) (Box y) = Box (x + y)
  sub (Box x) (Box y) = Box (x - y)
  mul (Box x) (Box y) = Box (x * y)
  div (Box x) (Box y) = Box (x / y)
  negate (Box x) = Box (-x)
  abs (Box x) = Box (abs x)
  signum (Box x) = Box (signum x)
  fromInt n = Box (fromInt n)
