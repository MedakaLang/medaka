-- A nullary return-position impl method runs at each occurrence, not at program
-- init and not once: `start ` prints BEFORE the first reference, the effect
-- (`[force] `) follows it, and fires again at the second reference.  Expected on all
-- three engines: `start [force] mid [force] end`.
interface HasUnit a where
  theUnit : <Stdout> a

data Box = Box String

impl HasUnit Box where
  theUnit =
    let _ = putStr "[force] "
    Box "X"

unBox : Box -> String
unBox (Box s) = s

main =
  let _ = putStr "start "
  let a = unBox (theUnit : Box)
  let _ = putStr "mid "
  let b = unBox (theUnit : Box)
  putStrLn "end"
