-- `freeze` copies: a `Bytes` never observes a write made to the `MutBytes` it
-- came from.  An implementation that aliased the backing block instead would
-- agree with this one on every other program in the tree -- both answer the
-- same bytes for a buffer that is finished before it is frozen -- so the write
-- AFTER the freeze is the whole fixture.
--
-- Every printed value is an Int: `byteAt` projects the `Option` out so that no
-- engine has to render a `Bytes` or a `MutBytes` cell.  An index past the end
-- reads as -1, which pins the `None` arm of `MB.get` at the same time.

-- Both modules export a `length`, and both are read here, so each is
-- reached through its own alias.
import bytes as B
import bytes.{Bytes}
import mut_bytes as MB
import mut_bytes.{MutBytes}

byteAt : Int -> MutBytes -> Int
byteAt i mb = match MB.get i mb
  Some v => v
  None => -1

main =
  let mb = MB.make 4
  let _ = MB.setInPlace 0 10 mb
  let _ = MB.setInPlace 1 20 mb
  let b = MB.freeze mb
  let _ = MB.setInPlace 0 99 mb
  let _ = MB.setInPlace 3 255 mb
  (
    (B.length b, b[0], b[1], b[2], b[3]),
    (
      MB.length mb,
      byteAt 0 mb,
      byteAt 1 mb,
      byteAt 3 mb,
      byteAt 9 mb,
    ),
  )
