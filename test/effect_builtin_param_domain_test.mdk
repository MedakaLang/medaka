{- | Gate for refined effect parameters on runtime builtins and externs.

   The corpus exercises Set and Prefix hole filling for real runtime
   builtins, manifest and policy rendering, FFI row honesty, the foreign ABI
   crossable set, runtime-name constraints, and nullary aliases. The frozen
   reference compiler lacks these effect-domain forms, so the current native
   compiler is the sole arm. -}

import compiler_cli_test_support.{
  expectCheckAccept,
  expectCheckReject,
  expectCheckRejectLine,
  expectVerbExitStartsWith,
  expectVerbExitStartsWithAndContains,
  fixtureIn,
  runMedaka,
}
import string.{stripSuffix}
import test.{Expectation, expectAll, fail, pass}

fixture : String -> <IO> String
fixture name = fixtureIn "test/effect_builtin_param_fixtures" name

stripTrailingNewlines : String -> String
stripTrailingNewlines s = match stripSuffix "\n" s
  Some rest => stripTrailingNewlines rest
  None => s

expectManifest : String -> String -> String -> <Exec, IO> Expectation
expectManifest name fn expected =
  match runMedaka ["manifest", fixture name, "--fn", fn]
    Err e => fail "\{name}: could not run `medaka manifest`: \{e}"
    Ok (code, out) =>
      if code /= 0 then
        fail
          "\{name}: `medaka manifest` exited \{intToString code}: \{debug out}"
      else if expected == stripTrailingNewlines out then
        pass
      else
        fail
          "\{name}: expected exact manifest \{debug expected}, got \{debug out}"

test "Env builtin fills a singleton inside its Set bound" =
  expectCheckAccept (fixture "env_hole_accept.mdk")

test "Env builtin rejects a singleton outside its Set bound" = expectCheckReject
  (fixture "env_hole_reject.mdk")
  ["performs <Env {\"HOME\"}>"]

test "Exec builtin fills a concrete path inside its Prefix bound" =
  expectCheckAccept (fixture "exec_hole_accept.mdk")

test "Exec builtin rejects a concrete path outside its Prefix bound" = expectCheckReject
  (fixture "exec_hole_reject.mdk")
  ["performs <Exec \"/usr/bin/ls\">"]

test "FileRead builtin fills a concrete path inside its Prefix bound" =
  expectCheckAccept (fixture "fileread_hole_accept.mdk")

test "FileRead builtin rejects a concrete path outside its Prefix bound" = expectCheckReject
  (fixture "fileread_hole_reject.mdk")
  ["performs <FileRead \"/etc/app/config.toml\">"]

test "a concatenation extends an exact FileRead prefix to the pattern it begins" = expectCheckReject
  (fixture "fileread_concat_exact_reject.mdk")
  ["performs <FileRead \"/etc/app/*\">"]

test "a concatenation under the pattern it begins is accepted" =
  expectCheckAccept (fixture "fileread_concat_pattern_accept.mdk")

test "an interpolation extends an exact FileRead prefix to the pattern it begins" = expectCheckReject
  (fixture "fileread_interp_exact_reject.mdk")
  ["performs <FileRead \"/etc/app/*\">"]

test "an interpolation under the pattern it begins is accepted" =
  expectCheckAccept (fixture "fileread_interp_pattern_accept.mdk")

test "manifest grants a concatenation's pattern, never its exact prefix" =
  expectManifest
    "fileread_concat_manifest_accept.mdk"
    "readUnder"
    "[package.capabilities]\nFileRead = \"/etc/app/*\""

test "manifest grants a literal concatenation exactly" =
  expectManifest
    "fileread_concat_manifest_accept.mdk"
    "readFixed"
    "[package.capabilities]\nFileRead = \"/etc/app/config.toml\""

test "FileWrite builtin fills a concrete path inside its Prefix bound" =
  expectCheckAccept (fixture "filewrite_hole_accept.mdk")

test "FileWrite builtin rejects a concrete path outside its Prefix bound" = expectCheckReject
  (fixture "filewrite_hole_reject.mdk")
  ["performs <FileWrite \"/var/log/app.log\">"]

test "manifest renders a top-level FileRead Prefix as a TOML string" =
  expectManifest
    "fileread_hole_accept.mdk"
    "readCfg"
    "[package.capabilities]\nFileRead = \"/etc/app/*\""

test "manifest renders a top-level Env Set as a TOML array" =
  expectManifest
    "env_hole_accept.mdk"
    "readHome"
    "[package.capabilities]\nEnv = [\"HOME\", \"PATH\"]"

test "check-policy accepts a manifest-derived Env Set token" =
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "env_hole_accept.mdk",
      "--allow",
      "Env={HOME,PATH}",
      "--fn",
      "readHome",
    ]
    0
    "accepted"

-- a set member may be written quoted, as a source atom writes it
test "check-policy reads a quoted Env Set member as the member" =
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "env_hole_accept.mdk",
      "--allow",
      "Env={\"HOME\",\"PATH\"}",
      "--fn",
      "readHome",
    ]
    0
    "accepted"

test "check-policy rejects an Env Set token missing HOME" =
  expectVerbExitStartsWithAndContains
    "check-policy"
    [fixture "env_hole_accept.mdk", "--allow", "Env={PATH}", "--fn", "readHome"]
    1
    "rejected"
    ["Env {\"HOME\", \"PATH\"}"]

test "IO does not subsume an FFI-performing body" = expectCheckReject (fixture
  "ffi_io_reject.mdk") [
  "performs <FFI \"libcurl*\">",
]

test "IO still subsumes an Exec-performing body" =
  expectCheckAccept (fixture "exec_io_accept.mdk")

-- The non-empty-row reject and the narrow accept distinguish the honesty
-- rule from one that only rejects a bare empty row.
test "an extern row missing FFI is rejected even when the row is non-empty" = expectCheckReject
  (fixture "ffi_stamp_missing_reject.mdk")
  [
    "Foreign declaration 'ffiFetch' does not name the 'FFI' effect in its result row",
  ]

test "an empty caller row does not subsume a declared FFI row" =
  expectCheckReject (fixture "ffi_stamp_bare_reject.mdk") ["performs <FFI>"]

test "a caller explicitly naming FFI accepts a declared FFI row" =
  expectCheckAccept (fixture "ffi_stamp_bare_accept.mdk")

test "an extern row may name FFI beside its refined effect" =
  expectCheckAccept (fixture "ffi_stamp_narrow_accept.mdk")

test "the FFI boundary rejects a Tuple result" = expectCheckReject (fixture
  "ffi_cross_tuple_reject.mdk") [
  "Type '(Int, Int)' cannot cross the foreign-function boundary in extern 'ffiPair'",
]

test "the FFI boundary rejects a List parameter" = expectCheckReject (fixture
  "ffi_cross_list_reject.mdk") [
  "Type 'List Int' cannot cross the foreign-function boundary in extern 'ffiSum'",
]

test "the FFI boundary rejects an Array with non-Int elements" = expectCheckReject
  (fixture "ffi_cross_array_elem_reject.mdk")
  [
    "Type 'Array String' cannot cross the foreign-function boundary in extern 'ffiWidths'",
  ]

test "the FFI boundary rejects a user ADT" = expectCheckReject (fixture
  "ffi_cross_adt_reject.mdk") [
  "Type 'Color' cannot cross the foreign-function boundary in extern 'ffiColorCode'",
]

-- The novel name proves the builtin-name exemption did not swallow every
-- extern declaration.
test "the FFI boundary rejects Ref under a novel extern name" = expectCheckReject
  (fixture "ffi_cross_ref_reject.mdk")
  [
    "Type 'Ref Int' cannot cross the foreign-function boundary in extern 'ffiPeek'",
  ]

test "the FFI boundary rejects a function parameter" = expectCheckReject
  (fixture "ffi_cross_fnparam_reject.mdk")
  [
    "Type 'Int -> <> Int' cannot cross the foreign-function boundary in extern 'ffiApply'",
  ]

test "the FFI boundary rejects a polymorphic extern at its own line" = expectCheckRejectLine
  (fixture "ffi_cross_poly_reject.mdk")
  [
    "ffi_cross_poly_reject.mdk:11:",
    "Type 'a' cannot cross the foreign-function boundary in extern 'ffiWrapAll'",
  ]

test "Int crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_int_accept.mdk")

test "Float crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_float_accept.mdk")

test "Bool crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_bool_accept.mdk")

test "Char crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_char_accept.mdk")

test "String crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_string_accept.mdk")

test "Array Int crosses the FFI boundary" =
  expectCheckAccept (fixture "ffi_cross_arrayint_accept.mdk")

test "Unit crosses the FFI boundary as C void" =
  expectCheckAccept (fixture "ffi_cross_unit_accept.mdk")

test "a compatible builtin-name redeclaration is exempt from the FFI guard" =
  expectCheckAccept (fixture "ffi_cross_builtin_name_accept.mdk")

test "a bare FFI library name is accepted" =
  expectCheckAccept (fixture "ffi_libname_bare_accept.mdk")

test "a wildcard FFI library name denotes the same set as the bare name" =
  expectCheckAccept (fixture "ffi_libname_wildcard_accept.mdk")

test "an empty FFI library pattern is rejected" = expectCheckReject (fixture
  "ffi_libname_empty_reject.mdk") [
  "the library pattern is empty",
]

-- These checks pair with the compatible builtin-name and honest-row accepts
-- above so a broader ban cannot satisfy the rejection cells.
test "a nullary extern is rejected because it has no row for FFI" = expectCheckReject
  (fixture "ffi_nullary_reject.mdk")
  ["Foreign declaration 'gNullary' has no arrow in its signature"]

test "a builtin name with an incompatible signature is rejected" = expectCheckReject
  (fixture "ffi_builtin_shadow_reject.mdk")
  [
    "Foreign declaration 'log' redeclares a built-in runtime name at a type the built-in does not have",
  ]

test "an extern cannot claim the runtime's mdk_ symbol namespace" = expectCheckReject
  (fixture "ffi_reserved_prefix_reject.mdk")
  ["Foreign declaration 'mdk_nil' claims a reserved name"]

test "a builtin redeclaration cannot narrow the catalog effect row" = expectCheckReject
  (fixture "ffi_catalog_narrow_reject.mdk")
  [
    "Foreign declaration 'getEnv' redeclares a built-in runtime name with a NARROWER effect row",
  ]

test "writeFile cannot be redeclared with an empty effect row" = expectCheckReject
  (fixture "ffi_catalog_writefile_narrow_reject.mdk")
  [
    "Foreign declaration 'writeFile' redeclares a built-in runtime name with a NARROWER effect row",
  ]

test "a builtin redeclaration may preserve the catalog effect row" =
  expectCheckAccept (fixture "ffi_catalog_honest_accept.mdk")

test "a direct alias does not hide a nullary extern" = expectCheckReject
  (fixture "ffi_nullary_alias_direct_reject.mdk")
  ["Foreign declaration 'k' has no arrow in its signature"]

test "a constrained alias does not hide a nullary extern" = expectCheckReject
  (fixture "ffi_nullary_alias_constrained_reject.mdk")
  ["Foreign declaration 'k' has no arrow in its signature"]

-- #3463/#3468: the invocation summary.  An entry is charged for what the host
-- can reach through it, read by variance; each charged entry has a control
-- that differs in one position.
positions : String
positions = "invocation_positions.mdk"

-- The manifest of [fn] in `positions`: the header, then [grant] when non-empty.
expectGrant : String -> String -> <Exec, IO> Expectation
expectGrant fn grant =
  let header = "[package.capabilities]"
  expectManifest positions fn (if grant == "" then
    header
  else
    "\{header}\n\{grant}")

test "a callback the host supplies is not charged" = expectAll [
  expectGrant "sinkEntry" "",
  expectGrant "takerEntry" "",
  expectGrant "hostCallback" "",
]

test "a function the host can reach through the entry is charged" = expectAll [
  expectGrant "returnedEntry" "FileRead = \"r/*\"",
  expectGrant "laterEntry" "FileRead = \"l/*\"",
  expectGrant "tupledEntry" "FileRead = \"t/*\"",
  expectGrant "apiEntry" "FileRead = \"a/*\"",
  expectGrant "passBack" "FileRead = \"d/*\"",
  expectGrant "refArg" "FileRead = \"c/*\"",
  expectManifest
    "invocation_async_index.mdk"
    "transform"
    "[package.capabilities]\nFileRead = \"x/*\"",
]

test "an index slot is invariant, and an opened field reads at the head's arguments" = expectAll
  [
    expectGrant "rowCellEntry" "FileRead = \"e/*\"",
    expectGrant "rdEntry" "FileRead = \"i/*\"",
  ]

-- Each reader keeps its own directory: nine prefixes are a set under the cap,
-- never their common `srv/*`.
test "a nested data type ends, and nine sibling readers are each instantiated" = expectAll
  [
    expectManifest "invocation_nested.mdk" "useW" "[package.capabilities]",
    expectManifest
      "invocation_nested.mdk"
      "caps"
      "[package.capabilities]\nFileRead = [\"srv/a/*\", \"srv/b/*\", \"srv/c/*\", \"srv/d/*\", \"srv/e/*\", \"srv/f/*\", \"srv/g/*\", \"srv/h/*\", \"srv/i/*\"]",
  ]

test "a flip cycle through four imported types is charged" =
  expectManifest
    "invocation_flip.mdk"
    "leak"
    "[package.capabilities]\nFileRead = \"lk/*\""

test "a type's fields are found by its identity, not a constructor's spelling" =
  expectManifest
    "invocation_same_ctor.mdk"
    "entryA"
    "[package.capabilities]\nFileRead = \"a/*\""

test "check-policy's chain follows what calling a callee performs" =
  expectVerbExitStartsWithAndContains
    "check-policy"
    [fixture "invocation_chain.mdk", "--allow", "Log", "--fn", "transform"]
    1
    "rejected. transform requires <FileRead \"q/*\">"
    ["reached via: transform → reader"]

test "an authority the caller chooses is granted whole and says why" =
  expectGrant
    "readUnder"
    "FileRead = true  # unresolved: authority variable `p`"

test "check-policy accepts the sink entry and refuses its returned control" = expectAll
  [
    expectVerbExitStartsWith
      "check-policy"
      [fixture positions, "--allow", "Log", "--fn", "sinkEntry"]
      0
      "accepted. sinkEntry requires only pure",
    expectVerbExitStartsWith
      "check-policy"
      [fixture positions, "--allow", "Log", "--fn", "returnedEntry"]
      1
      "rejected. returnedEntry requires <FileRead \"r/*\">",
  ]

test "check-policy names an authority a narrower entry cannot prove" =
  expectVerbExitStartsWithAndContains
    "check-policy"
    [fixture positions, "--allow", "FileRead=cfg/*", "--fn", "readUnder"]
    1
    "rejected. readUnder requires <FileRead p>"
    ["not proven: FileRead p (authority variable `p`)"]

-- #3464: a written row keeps a set of elements per label.
test "a bound of two hosts refuses a third, and admits each of the two" = expectAll
  [
    expectCheckReject (fixture "prefix_set_reject.mdk") [
      "performs <Net \"evil.net\">",
    ],
    expectCheckAccept (fixture "prefix_set_accept.mdk"),
  ]

test "two sibling directories do not admit their common parent" = expectAll [
  expectCheckReject (fixture "prefix_set_sibling_reject.mdk") [
    "performs <FileRead \"cfg/secret/key\">",
  ],
  expectCheckAccept (fixture "prefix_set_sibling_accept.mdk"),
]

test "an authority variable solves to the set of its lower bounds" = expectAll [
  expectCheckAccept (fixture "prefix_set_variable_accept.mdk"),
  expectCheckReject (fixture "prefix_set_variable_launder.mdk") [
    "performs <Net \"a.com/x\", Net \"evil.net/y\">",
  ],
]

test "a written bound past the cap is refused, not folded" = expectAll [
  expectCheckReject (fixture "prefix_set_cap_reject.mdk") [
    "a bound admits at most 16 elements of one label, and this one writes 17",
  ],
  expectCheckAccept (fixture "prefix_set_cap_accept.mdk"),
  expectCheckReject (fixture "env_set_cap_reject.mdk") [
    "a set holds at most 16 members, and this one has 17",
  ],
]

test "a set is written in an index and a qualifier as it prints" = expectAll [
  expectCheckAccept (fixture "authority_set_surface_accept.mdk"),
  expectCheckReject (fixture "authority_set_surface_launder.mdk") [
    "reaches \"evil.net/x\" where its declared bound admits only (\"a.com/*\" | \"b.com/*\")",
  ],
]

test "Product elements differing beyond one Set axis stay a set of tuples" = expectAll
  [
    expectCheckAccept (fixture "product_set_accept.mdk"),
    expectCheckReject (fixture "product_set_reject.mdk") [
      "performs <Web Host=\"a.com/*\" Method={\"POST\"}>",
    ],
  ]

test "the manifest renders a set as an array of its elements" = expectAll [
  expectManifest
    "prefix_set_accept.mdk"
    "both"
    "[package.capabilities]\nNet = [\"a.com/x\", \"b.com/y\"]",
  expectManifest
    "product_set_accept.mdk"
    "both"
    "[package.capabilities]\nFFI = true\nWeb = [{ host = \"a.com/*\", method = [\"GET\"] }, { host = \"b.com/*\", method = [\"POST\"] }]",
]

test "check-policy reads every entry of a label, in either order" = expectAll [
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "prefix_set_accept.mdk",
      "--allow",
      "Net=a.com/*,Net=b.com/*",
      "--fn",
      "both",
    ]
    0
    "accepted",
  expectVerbExitStartsWith
    "check-policy"
    [
      fixture "prefix_set_accept.mdk",
      "--allow",
      "Net=b.com/*,Net=a.com/*",
      "--fn",
      "both",
    ]
    0
    "accepted",
  expectVerbExitStartsWith
    "check-policy"
    [fixture "prefix_set_accept.mdk", "--allow", "Net=a.com/*", "--fn", "both"]
    1
    "rejected",
]

test "a qualifier or an index past the cap is refused, not folded" = expectAll [
  expectCheckReject (fixture "written_term_cap_reject.mdk") [
    "Invalid authority in the qualifier",
    "a bound admits at most 16 elements of one label, and this one writes 17",
  ],
  expectCheckAccept (fixture "written_term_cap_accept.mdk"),
]

test "a qualifier or an index literal is an element of its domain" = expectCheckReject
  (fixture "written_term_domain_reject.mdk")
  [
    "Invalid authority in the qualifier `@\"a.com\"`: pattern \"a.com\" must end in '*'",
    "Invalid effect parameter on <Net>: label 'Net' takes a prefix pattern, not a set",
  ]

test "Set members split across atoms are capped as one set" = expectAll [
  expectCheckReject (fixture "written_split_cap_reject.mdk") [
    "Invalid effect parameter on <Env>: a set holds at most 16 members, and this one has 17",
    "Invalid effect parameter on <Web>: a bound admits at most 16 elements of one label, and this one writes 17",
  ],
  expectCheckAccept (fixture "written_split_cap_accept.mdk"),
]

test "rows in a data field or a type alias are validated as bounds" = expectAll
  [
    expectCheckReject (fixture "data_alias_bound_reject.mdk") [
      "a bound admits at most 16 elements of one label",
      "pattern \"a.com\" must end in '*'",
      "pattern \"b.com\" must end in '*'",
    ],
    expectCheckAccept (fixture "data_alias_bound_accept.mdk"),
  ]

test "the same Product elements in any order are one set" =
  expectCheckAccept (fixture "product_set_order_accept.mdk")

test "a policy's entries for one label are read exactly, however many" = expectAll
  [
    expectVerbExitStartsWith
      "check-policy"
      [
        fixture "policy_cap_accept.mdk",
        "--allow",
        "FileRead=cfg/a/*,FileRead=cfg/b/*,FileRead=cfg/c/*,FileRead=cfg/d/*,FileRead=cfg/e/*,FileRead=cfg/f/*,FileRead=cfg/g/*,FileRead=cfg/h/*,FileRead=cfg/i/*,FileRead=cfg/j/*,FileRead=cfg/k/*,FileRead=cfg/l/*,FileRead=cfg/m/*,FileRead=cfg/n/*,FileRead=cfg/o/*,FileRead=cfg/q/*,FileRead=cfg/secret/*",
        "--fn",
        "readSecret",
      ]
      0
      "accepted",
    expectVerbExitStartsWith
      "check-policy"
      [
        fixture "policy_cap_accept.mdk",
        "--allow",
        "FileRead=cfg/a/*,FileRead=cfg/b/*,FileRead=cfg/c/*,FileRead=cfg/d/*,FileRead=cfg/e/*,FileRead=cfg/f/*,FileRead=cfg/g/*,FileRead=cfg/h/*,FileRead=cfg/i/*,FileRead=cfg/j/*,FileRead=cfg/k/*,FileRead=cfg/l/*,FileRead=cfg/m/*,FileRead=cfg/n/*,FileRead=cfg/o/*,FileRead=cfg/p/*,FileRead=cfg/q/*",
        "--fn",
        "readSecret",
      ]
      1
      "rejected",
  ]

test "a bound assembled from pieces stays exact, never folded" = expectAll [
  expectCheckReject (fixture "bound_pieces_reject.mdk") [
    "performs <FileRead \"cfg/secret\">",
  ],
  expectCheckAccept (fixture "bound_pieces_accept.mdk"),
]

test "a bound's elements have one canonical form, in either write order" = expectAll
  [
    expectCheckReject (fixture "bound_order_a_reject.mdk") [
      "a bound admits at most 16 elements of one label, and this one writes 32",
    ],
    expectCheckReject (fixture "bound_order_b_reject.mdk") [
      "a bound admits at most 16 elements of one label, and this one writes 32",
    ],
  ]

test "Product tuples the bound covers together are within it" = expectAll [
  expectCheckAccept (fixture "product_set_cover_accept.mdk"),
  expectCheckReject (fixture "product_set_cover_reject.mdk") [
    "performs <Web Host=\"a.com/y/*\" Method={\"POST\"}>",
  ],
]

test "a catalog extern redeclared at an index join charges each term" =
  expectCheckAccept (fixture "catalog_index_join_accept.mdk")

test "a Set qualifier naming no binder is a Set bound" = expectAll [
  expectCheckAccept (fixture "qualifier_literal_domain_accept.mdk"),
  expectCheckReject (fixture "qualifier_literal_domain_launder.mdk") [
    "reaches {\"SECRET\"}",
  ],
]

test "a value's abstraction is widened past the cap, never a bound" = expectAll
  [
    expectCheckAccept (fixture "value_widen_accept.mdk"),
    expectCheckReject (fixture "value_widen_launder.mdk") ["performs <Net"],
  ]

test "the written cap counts written elements, whatever the axes are named" =
  expectCheckAccept (fixture "written_cap_axis_names_accept.mdk")

test "a literal containing a quote never merges two tuples" =
  expectCheckReject (fixture "product_quote_literal_reject.mdk") ["performs"]

test "elements of different domains joined are the whole domain" = expectAll [
  expectCheckReject (fixture "mixed_domain_join_reject.mdk") ["performs <Env>"],
  expectCheckAccept (fixture "mixed_domain_join_accept.mdk"),
]

test "a covered tuple does not change how a Product bound groups" = expectCheckReject
  (fixture "product_covered_cap_reject.mdk")
  ["a set holds at most 16 members, and this one has 18"]

test "a Product bound with many Set axes is kept as written" =
  expectCheckAccept (fixture "product_many_axes_accept.mdk")

test "a join of elements whose axes differ in shape is the whole axis" =
  expectCheckReject (fixture "product_axis_shape_reject.mdk") ["performs"]

test "a string qualifier lifts into a Product label's primary axis" =
  expectCheckAccept (fixture "qualifier_product_lift_accept.mdk")
