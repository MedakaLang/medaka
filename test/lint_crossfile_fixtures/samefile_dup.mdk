-- #602 pin: two top-level bodies that are structurally
-- identical within one file.  The cross-file group needs >=2 distinct
-- files, so a same-file pair like parser.mdk's
-- `frontend.parser.parseBracketBlock`/`frontend.parser.indentedBody` is invisible to it.  Both
-- bindings below must be flagged by rule-duplicate-body with the "in this
-- same file" message.  The body shape is deliberately UNIQUE to this file, so
-- the finding can only have come from the in-file tier.
export widthOne : Int -> String
widthOne n =
  if n > 640 then
    "wide"
  else if n > 320 then
    "narrow"
  else if n > 80 then
    "tiny"
  else
    "hidden"

export widthTwo : Int -> String
widthTwo n =
  if n > 640 then
    "wide"
  else if n > 320 then
    "narrow"
  else if n > 80 then
    "tiny"
  else
    "hidden"
