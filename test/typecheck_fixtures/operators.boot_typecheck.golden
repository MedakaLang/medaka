add : a -> a -> a
poly : Num a => a -> a -> a -> a
negI : Num a => a -> a
negP : a -> a
eqp : a -> a -> Bool
ltp : a -> a -> Bool
clampish : a -> a -> a -> a
andb : Bool -> Bool -> Bool
orb : Bool -> Bool -> Bool
derefp : Ref a -> a
appx : a -> a -> a
consx : a -> List a -> List a
pipeIt : a -> (a -> <b> c) -> <b> c
fwd : (a -> <b> c) -> (c -> <d> e) -> a -> <b | d> e
bwd : (a -> <b> c) -> (d -> <e> a) -> d -> <e | b> c
applyfn : (a -> <b> c -> <d> e) -> a -> c -> <b | d> e
total : Num a => L a -> a