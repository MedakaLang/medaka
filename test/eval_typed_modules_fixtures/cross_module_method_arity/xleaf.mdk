-- WS-2/D2 method-level analog: two modules declare distinct interfaces sharing the
-- bare method name `shape` but with DIFFERENT method-level `=>`-constraint arity
-- (Num e here; (Num e, Num f) in yleaf). The explicit receiver selects the interface
-- while the method result remains parametric in its method-level numeric variable.
export interface BuildA t where
  shape : Num e => t -> e -> e
data BoxA = MkBoxA Int
export impl BuildA BoxA where
  shape _ n = n + n
unboxA : BoxA -> Int
unboxA (MkBoxA x) = x
export
callX : Int
callX = shape (MkBoxA 0) 3
