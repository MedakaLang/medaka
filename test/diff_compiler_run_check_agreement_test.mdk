{- | Gate for `check` == `run` == `build` agreement over
   `test/run_check_agreement_fixtures`.

   `check` runs the full diagnostic pass — resolve, typecheck, constraint,
   coherence and no-impl — and is the source of truth for whether a program
   is well formed. `run` and `build` share that front end and differ only in
   engine, so a program the three verbs disagree about is a program one of
   them decided on less information than the others. Each fixture pins the
   answer all three owe in a sibling `<name>.expected` holding exactly
   `ACCEPT` or `REJECT`.

   Two grades beyond the verdict, each closing a hole a verdict cannot see:

   - An `ACCEPT` fixture must ship a `<name>.out` pinning its exact stdout,
     and the run engine's stdout, the built binary's stdout and that pin
     must all agree. A missing pin is `NOPIN`, a failure and never a skip:
     two engines agreeing with each other prove nothing when they agree on
     garbage, which is exactly the shape a build exiting 0 while printing
     the wrong number takes. `REJECT` fixtures never execute, so they are
     exempt, and no fixture takes a ledgered exception. When minting a pin,
     read the fixture and decide the value the program owes; do not capture
     whatever the binary prints today.

   - A `REJECT` fixture must be rejected by a diagnostic, never by a runtime
     panic (`RANPANIC` on the run engine, `EMITPANIC` on the build path).
     Both outcomes exit 1, so the verdict column is blind to the difference,
     and that blindness is how multi-module `run` once shipped executing
     ill-typed programs with this corpus green. A stdout probe cannot stand
     in either: `medaka run` discards buffered stdout when the program
     panics, so a `println` placed ahead of the ill-typed expression
     vanishes. The diagnostic is the only observable that differs.

   Only the corpus root holds fixtures. `lib/` beneath it holds modules the
   multi-file fixtures import, which are not entry points and have no pinned
   verdict of their own.

   The per-fixture verdict table is rendered into the failure message rather
   than printed: `medaka test --native` runs a test body inside a probe whose
   stdout it parses back as a sentinel transcript, so anything the body
   prints on its own account is absorbed there and never reaches a reader. A
   red run therefore names every disagreeing fixture and its columns at once.

   Runs under `medaka test --native`: it spawns subprocesses and reads the
   corpus, neither of which the interpreter binds. -}

import compiler_cli_test_support.{
  Agreement(..),
  RuntimeOutcome(..),
  binaryRanClean,
  checkRunBuild,
  fatalOutcomeSweep,
  fixtureStems,
  summarizeSweep,
  sweepUnits,
  verdictOf,
}
import fs.{expectUnitCount, fixtureFiles, mkdirAll}
import list.{somes, sort}
import path.{dirname, stem}
import string.{contains, endsWith, join, lines, padRight, trim, unlines}
import test.{Expectation, expectEqual, fail, pass}
import test_process.{boundedVerb, medakaBin, medakaRoot, scratchDir}

-- Fixtures are located through MEDAKA_ROOT rather than the working
-- directory: `medaka gate run` exports it and inherits whatever cwd the
-- caller had.
corpus : <IO> String
corpus = "\{medakaRoot}/test/run_check_agreement_fixtures"

{- | One fixture's graded row. `note` carries a structural failure — a
   fixture missing its verdict pin, a spawn that could not start — which
   has no verdict columns of its own to report. -}
data Row = Row {
  base : String,
  expected : String,
  checkV : String,
  runV : String,
  buildV : String,
  grade : String,
  ok : Bool,
  note : String,
}

-- The value grades that are failures. A row also fails on any verdict
-- disagreement; these are the ones the verdict columns cannot express.
badValues : List String
badValues = ["DIFF", "WRONG", "NOPIN", "RANPANIC", "EMITPANIC", "BINPANIC"]

-- The third argument is the `<name>.out` file's contents, `Err` when it is
-- absent.
valueColumn : String -> Agreement -> Result String String -> String
valueColumn "REJECT" a _ =
  if contains "E-PANIC" a.runErr then
    "RANPANIC"
  else if contains "E-PANIC" a.buildLog then
    "EMITPANIC"
  else
    "-"
valueColumn "ACCEPT" _ (Err _) = "NOPIN"
valueColumn "ACCEPT" a (Ok want) =
  if a.runCode /= 0 || a.buildCode /= 0 then
    "-"
  else if a.binOut /= a.runOut then
    "DIFF"
  else if want /= a.runOut then
    "WRONG"
  else if not (binaryRanClean a) then
    "BINPANIC"
  else
    "ok"
valueColumn _ _ _ = "-"

structuralRow : String -> String -> Row
structuralRow base note = Row {
  base = base,
  expected = "-",
  checkV = "-",
  runV = "-",
  buildV = "-",
  grade = "-",
  ok = False,
  note = note,
}

gradeOne : String -> String -> <Exec, FileRead, IO> Row
gradeOne scratch path =
  let base = stem path
  let sibling = "\{corpus}/\{base}"
  match readFile "\{sibling}.expected"
    Err e => structuralRow base "no readable .expected file: \{e}"
    Ok raw => match checkRunBuild path "\{scratch}/\{base}.bin"
      Err e => structuralRow base e
      Ok a =>
        let expected = trim raw
        let value = valueColumn expected a (readFile "\{sibling}.out")
        let checkV = verdictOf a.checkCode
        let runV = verdictOf a.runCode
        let buildV = verdictOf a.buildCode
        Row {
          base = base,
          expected = expected,
          checkV = checkV,
          runV = runV,
          buildV = buildV,
          grade = value,
          ok =
            checkV == expected
              && runV == expected
              && buildV == expected
              && not (elem value badValues),
          note = "",
        }

agreementRowFailure : Row -> Option String
agreementRowFailure r =
  if r.ok then
    None
  else
    Some
      "  \{padRight 46 ' ' r.base} expect=\{padRight 7 ' ' r.expected} check=\{padRight 7 ' ' r.checkV} run=\{padRight 7 ' ' r.runV} build=\{padRight 7 ' ' r.buildV} value=\{r.grade} \{r.note}"

-- The whole verdict table for the failing fixtures, since the vehicle
-- swallows anything a test body prints: a red run has to name every
-- disagreeing fixture in one message or lose the rest.
summarizeAgreement : String -> Int -> List String -> Expectation
summarizeAgreement _ _ [] = pass
summarizeAgreement what graded failures =
  fail
    "\{intToString (length failures)} of \{intToString graded} fixtures \{what}:\n\{unlines failures}"

sweep : List String -> <Exec, FileRead, IO> Expectation
sweep entries =
  sweepUnits
    entries
    gradeOne
    agreementRowFailure
    (summarizeAgreement "disagree with their pinned verdict or value")

{- | The corpus's fixtures: its top-level `.mdk` files. `fixtureFiles`
   carries the anti-vacuity floor, so a corpus that reads cleanly but holds
   nothing is an `Err` rather than a green run over zero rows; it walks
   recursively, and `lib/` holds imported modules rather than entry points,
   so only the root's own files are fixtures. -}
mdkFixtures : <FileRead, IO> Result String (List String)
mdkFixtures = match fixtureFiles corpus
  Err e => Err e
  Ok paths =>
    match sort (filter (p => endsWith ".mdk" p && dirname p == corpus) paths)
      [] => Err "no top-level .mdk fixtures"
      fixtures => Ok fixtures

pinnedVerdict : String -> <FileRead, IO> Option String
pinnedVerdict path = match readFile "\{corpus}/\{stem path}.expected"
  Err _ => Some "  \{stem path}: no .expected file pinning ACCEPT or REJECT"
  Ok raw =>
    let v = trim raw
    if v == "ACCEPT" || v == "REJECT" then
      None
    else
      Some "  \{stem path}: .expected reads \{debug v}, not ACCEPT or REJECT"

test "every fixture pins exactly one of ACCEPT or REJECT" = match mdkFixtures
  Err e => fail "\{corpus}: \{e}"
  Ok entries =>
    summarizeAgreement
      "do not pin a verdict"
      (length entries)
      (somes (map pinnedVerdict entries))

{- | The declared size of the corpus. This is the WEAKER floor — the corpus
   has no roster naming its fixtures one by one, so a count is all there is
   to check against, and it catches a corpus that silently shrank (the
   anti-vacuity floor only catches one that emptied). Growing the corpus is
   expected: raise this number in the same commit that adds the fixture. -}
declaredFixtureCount : Int
declaredFixtureCount = 166

test "check, run and build agree with every fixture's pinned verdict and value" =
  match mdkFixtures
    Err e => fail "\{corpus}: \{e}"
    Ok entries => match expectUnitCount declaredFixtureCount entries
      Err e => fail "\{corpus}: \{e} — see `declaredFixtureCount`"
      Ok _ => sweep entries

-- # Fixed-width integers: out of range is refused, never stored

{- | The W-QUIETER probe for `U8`/`U16`/`U32` (epic #3417, #3420, #3421;
   `docs/design/INTEGER-TYPES-DESIGN.md` §10) over
   `test/fixed_width_refusal_fixtures`.

   A fixed-width value outside its range has exactly two legal fates: a
   ground literal is refused at compile time by `check`, `run` and `build`
   alike, and a value only known at runtime (a computed `fromInt`, or a
   literal in a generic `Num a =>` body) is refused by a panic on both the
   run engine and the built binary. Storing the wrapped value, 300 as 44,
   is the one outcome no row admits, which is why a runtime row pins an
   empty stdout and a compile-time row requires exit 1 from all three verbs.

   A compile-time row grades each verb's whole output for a line carrying
   every needle, and refuses an `E-PANIC` anywhere in it: the two exits
   look identical, and a range check that fired as an emitter panic would
   otherwise pass. The runtime rows reuse `checkRunBuild`'s fatal-outcome
   grading, which also requires `check` to accept the program. -}
refusalCorpus : <IO> String
refusalCorpus = "\{medakaRoot}/test/fixed_width_refusal_fixtures"

-- The diagnostic an out-of-range literal owes: the literal, the type and its
-- range, on the same line as the fixture's own location. The two pattern
-- rows pin the file but not the line, since the literal's position is not
-- what they are about.
literalRefused : String -> String -> String -> List String
literalRefused loc lit range =
  [loc, "integer literal \{lit} does not fit \{range}"]

compileRefusals : List (String, List String)
compileRefusals = [
  (
    "literal_u8_300",
    literalRefused "literal_u8_300.mdk:6:" "300" "U8 (0..255)",
  ),
  (
    "literal_u8_negative",
    literalRefused "literal_u8_negative.mdk:6:" "-2" "U8 (0..255)",
  ),
  (
    "literal_u32_2p32",
    literalRefused "literal_u32_2p32.mdk:5:" "4294967296" "U32 (0..4294967295)",
  ),
  (
    "local_helper_literal_u8_300",
    literalRefused "local_helper_literal_u8_300.mdk:7:" "300" "U8 (0..255)",
  ),
  (
    "pattern_u8_clause_300",
    literalRefused "pattern_u8_clause_300.mdk:" "300" "U8 (0..255)",
  ),
  (
    "pattern_u8_arm_256",
    literalRefused "pattern_u8_arm_256.mdk:" "256" "U8 (0..255)",
  ),
]

fromIntRefused : String -> String -> RuntimeOutcome
fromIntRefused n range = Aborts "E-PANIC" "fromInt: \{n} does not fit \{range}"

-- `in_range_control` is load-bearing: without it, a check "fixed" into
-- refusing every fixed-width value would leave this whole section green.
runtimeRefusals : List (String, RuntimeOutcome)
runtimeRefusals = [
  ("fromint_u8_computed_300", fromIntRefused "300" "U8 (0..255)"),
  ("fromint_u8_negative", fromIntRefused "-2" "U8 (0..255)"),
  ("fromint_u32_2p32", fromIntRefused "4294967296" "U32 (0..4294967295)"),
  ("generic_literal_u8_300", fromIntRefused "300" "U8 (0..255)"),
  (
    "in_range_control",
    Prints
      "[255, 0]\n[65535, 0]\n[4294967295, 0]\ntop\n255\n4294967295\n255\n300\n-2",
  ),
]

-- Why one verb's handling of a compile-time row is wrong, or `None`.
verbRefusalFailure : List String ->
  (String, List String) ->
  <Exec "_", IO> Option String
verbRefusalFailure needles (verb, args) = match boundedVerb medakaBin args
  Err e => Some "\{verb}: could not spawn: \{e}"
  Ok (code, out, err) =>
    let said = out ++ err
    let carried = any (l => all (n => contains n l) needles) (lines said)
    if code == 1 && carried && not (contains "E-PANIC" said) then
      None
    else
      Some
        "\{verb} exit=\{intToString code} output=\{debug said}; want exit 1 and one diagnostic line carrying \{debug needles}, no E-PANIC"

compileRefusalFailure : String ->
  (String, List String) ->
  <Exec "_", IO> Option String
compileRefusalFailure scratch (name, needles) =
  let entry = "\{refusalCorpus}/\{name}.mdk"
  let verbs = [
    ("check", ["check", entry]),
    ("run", ["run", entry]),
    ("build", ["build", entry, "-o", "\{scratch}/\{name}.bin"]),
  ]
  match somes (map (verbRefusalFailure needles) verbs)
    [] => None
    whys => Some "  \{padRight 26 ' ' name} \{join "; " whys}"

test "every fixed-width refusal fixture has a row, and every row a fixture" =
  match fixtureStems refusalCorpus
    Err e => fail "\{refusalCorpus}: \{e}"
    Ok found =>
      expectEqual
        (sort (map fst compileRefusals ++ map fst runtimeRefusals))
        found

{- | `sweep` with the scratch directory made again first.

   `test_process.scratchDir` is a top-level nullary, evaluated once per
   process, and every sweep removes it when it finishes, so each sweep after
   the module's first would be handed a path that no longer exists. -}
afterRemadeScratch : (Unit -> <Exec "_", FileRead "_", IO> Expectation) ->
  <Exec "_", FileRead "_", FileWrite "_", IO> Expectation
afterRemadeScratch sweep = match scratchDir
  Err e => fail "could not make a scratch directory: \{e}"
  Ok dir => match mkdirAll dir
    Err e => fail "could not remake \{dir}: \{e}"
    Ok () => sweep ()

test "an out-of-range fixed-width literal is refused by check, run and build" = afterRemadeScratch
  (_ =>
    sweepUnits compileRefusals compileRefusalFailure (r => r) summarizeSweep)

test "a computed out-of-range fixed-width value panics on run and build, never stored" = afterRemadeScratch
  (_ =>
    fatalOutcomeSweep refusalCorpus (length runtimeRefusals) runtimeRefusals)
