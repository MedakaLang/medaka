{- | Gate for `medaka test` type-checking its target (issues #1229, #260, #1680),
   and for the narrowing of the exemption to compiler/stdlib/test-dir vehicles.
   Replaces diff_compiler_test_typecheck.sh.

   The exemption (`hasTests`/`hasProps`) skips the pre-check only for modules
   carrying `test "..."` or `prop "..."` decls; every other target must
   type-check. Each cell runs `medaka test` on a fixture written into a fresh
   scratch directory, grades the exit code and the output, and removes the
   directory afterwards.

   Runs under `medaka test --native`: it spawns the built binary and writes
   fixtures, neither of which the interpreter binds. -}

import test_process.{medakaBin, boundedVerb, withScratchDir}
import test.{
  Expectation, expectAll, expectEach, expectTextContainsAll, fail, pass
}
import fs.{mkdirAll}
import path.{dirname}
import string.{contains, lines, startsWith}
import list.{filter}

fixtures : List (String, String)
fixtures = [
  ("a_nodoc_broken.mdk", "main = println nosuchvariable\n"),
  ("b_nodoc_clean.mdk", "inc : Int -> Int\ninc x = x + 1\n"),
  (
    "c_doctest_pass.mdk",
    "-- > double 3\n-- 6\ndouble : Int -> Int\ndouble x = x * 2\n",
  ),
  (
    "d_doctest_wrong_expectation.mdk",
    "-- > double 3\n-- 7\ndouble : Int -> Int\ndouble x = x * 2\n",
  ),
  (
    "e_exempt_via_testdecl.mdk",
    "import test.{expectEqual}\n\nillTyped = nosuchvariable\n\ntest \"sum of two\" = expectEqual 2 (1 + 1)\n",
  ),
  (
    "h_exempt_via_prop.mdk",
    "illTyped = nosuchvariable\n\nprop \"addition commutes\" (x : Int) (y : Int) = x + y == y + x\n",
  ),
  (
    "i_1680_repro.mdk",
    "f : Int -> Int\nf x = x + 1\n\ntest \"t\" = f \"x\" == 3\n",
  ),
]

brokenText : String
brokenText = "main = println nosuchvariable\n"

vehicleText : String
vehicleText = "f : Int -> Int\nf x = x + 1\n\ntest \"t\" = f \"x\" == 3\n"

doctestText : String
doctestText = "-- > double 3\n-- 6\ndouble : Int -> Int\ndouble x = x * 2\n"

agreeMainText : String
agreeMainText =
  "import dep.{inc}\n\ninterface Get c v where\n  get1 : c -> v\n\ndata Box a = Box a\n\nimpl Get (Box a) a where\n  get1 (Box x) = x\n\nshown : String\nshown = debug (get1 (Box 42))\n\nuseDep : Int -> Int\nuseDep x = inc x\n"

-- The narrowing, substring, skip-announcement, directory, project and agreement
-- trees. Each file sits at the path its cell's predicate reads, so the path
-- components (compiler/, stdlib/, repo/test/, mycompiler/, newstdlib/) are real.
scenarioFixtures : List (String, String)
scenarioFixtures = [
  ("a_nodoc_broken.mdk", brokenText),
  ("b_nodoc_clean.mdk", "inc : Int -> Int\ninc x = x + 1\n"),
  (
    "j_doctest_beats_testdecl.mdk",
    "import test.{expectEqual}\n\n-- > triple 3\n-- 9\ntriple : Int -> Int\ntriple x = x * 3\n\ntest \"triple two\" = expectEqual 6 (triple 2)\n",
  ),
  ("compiler/types/n_narrow_compiler_vehicle_test.mdk", vehicleText),
  ("stdlib/o_narrow_stdlib_vehicle_test.mdk", vehicleText),
  ("p_suffix_only_stays_exempt_test.mdk", vehicleText),
  ("repo/compiler/medaka.toml", ""),
  ("repo/test/u_repo_test_dir_test.mdk", vehicleText),
  ("norepo/test/v_no_compiler_sibling_stays_exempt_test.mdk", vehicleText),
  ("mycompiler/sqlite/test/r_substring_not_component_test.mdk", vehicleText),
  ("newstdlib/s_substring_not_component_test.mdk", vehicleText),
  ("dir/clean.mdk", doctestText),
  ("dir/illtyped.mdk", brokenText),
  ("proj/sib.mdk", "export helper : Int -> Int\nhelper x = x + 1\n"),
  (
    "proj/main.mdk",
    "import sib.{helper}\n\nmain = println (helper \"not an int\")\n",
  ),
  ("agree/dep.mdk", "export\ninc : Int -> Int\ninc x = x + 1\n"),
  ("agree/main.mdk", agreeMainText),
]

-- Writes each (relative name, text) pair under dir, creating its parent directory
-- first, and stops at the first failed step.
writeFixtures : String ->
  List (String, String) ->
  <Exec, IO, FileWrite> Result String Unit
writeFixtures _ [] = Ok ()
writeFixtures dir ((name, text) :: rest) =
  match mkdirAll (dirname "\{dir}/\{name}")
    Err e => Err e
    Ok _ => match writeFile "\{dir}/\{name}" text
      Err e => Err e
      Ok _ => writeFixtures dir rest

-- Runs `k` in a fresh scratch directory holding every (relative name, text) pair,
-- removed afterwards by withScratchDir (graded).
inTree : List (String, String) ->
  (String -> <Exec, IO, FileRead, FileWrite> Expectation) ->
  <Exec, IO, FileRead, FileWrite> Expectation
inTree files k = withScratchDir (dir => match writeFixtures dir files
  Err e => fail "could not write fixtures: \{e}"
  Ok _ => k dir)

-- The spawned argv: cwd "" keeps the caller's directory; otherwise the binary runs
-- inside cwd, which is how the relative-target cell reaches its fixture.
spawnTest : String ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
spawnTest cwd args =
  if cwd == "" then
    boundedVerb medakaBin args
  else
    boundedVerb
      "sh"
      (["-c", "cd \"$1\" && shift && exec \"$@\"", "medaka", cwd, medakaBin]
        ++ args)

-- One `medaka test` run on target: the exit code must equal wantCode, and the
-- combined stdout and stderr must contain every needle.
runCaseIn : String ->
  String ->
  List String ->
  Int ->
  List String ->
  <Exec, IO> Expectation
runCaseIn cwd target engineArgs wantCode needles =
  match spawnTest cwd (["test"] ++ engineArgs ++ [target])
    Err e => fail "could not spawn medaka test on \{target}: \{e}"
    Ok (code, out, err) =>
      if code /= wantCode then
        fail
          "\{target}: exited \{intToString code} (expected \{intToString wantCode})"
      else
        expectTextContainsAll needles (out ++ err)

runCase : String -> List String -> Int -> List String -> <Exec, IO> Expectation
runCase target engineArgs wantCode needles =
  runCaseIn "" target engineArgs wantCode needles

-- Every unwanted needle must be ABSENT from the text. Presence-only checks cannot
-- pin the announcement's scope.
expectAbsent : List String -> String -> Expectation
expectAbsent unwanted text =
  expectAll
    (map
      (u =>
        if contains u text then
          fail "output CONTAINS [\{u}] and must not"
        else
          pass)
      unwanted)

-- One `medaka test` run on target: the exit code must equal wantCode, and the
-- output must contain none of the unwanted needles.
refuteCase : String -> Int -> List String -> <Exec, IO> Expectation
refuteCase target wantCode unwanted =
  match boundedVerb medakaBin ["test", target]
    Err e => fail "could not spawn medaka test on \{target}: \{e}"
    Ok (code, out, err) =>
      if code /= wantCode then
        fail
          "\{target}: exited \{intToString code} (expected \{intToString wantCode})"
      else
        expectAbsent unwanted (out ++ err)

-- `medaka test` and `medaka check` must reach the same verdict on target, and when
-- both reject, every `error: ` line `check` printed must appear in `test`'s output.
agreeCase : String -> <Exec, IO> Expectation
agreeCase target = match boundedVerb medakaBin ["check", target]
  Err e => fail "could not spawn medaka check on \{target}: \{e}"
  Ok (ccode, cout, cerr) => match boundedVerb medakaBin ["test", target]
    Err e => fail "could not spawn medaka test on \{target}: \{e}"
    Ok (tcode, tout, terr) =>
      if ccode /= 0 /= (tcode /= 0) then
        fail
          "\{target}: `medaka check` exit \{intToString ccode} but `medaka test` exit \{intToString tcode} — the two verbs disagree"
      else if ccode == 0 then
        pass
      else
        expectTextContainsAll
          (filter (startsWith "error: ") (lines (cout ++ cerr)))
          (tout ++ terr)

-- Cell a's counterpart: `medaka check` must reject the same file, or the matrix
-- compares `test` against nothing.
control : String -> <Exec, IO> Expectation
control dir = match boundedVerb medakaBin ["check", "\{dir}/a_nodoc_broken.mdk"]
  Err e => fail "could not spawn medaka check on the control fixture: \{e}"
  Ok (code, _, _) =>
    if code == 0 then
      fail
        "control: `medaka check` exited 0 on the ill-typed fixture — the matrix proves nothing"
    else
      pass

test "medaka test type-checks its target: cells a-h" = inTree
  fixtures
  (dir => expectAll [
    expectEach [
      (
        "a zero-doctest ill-typed",
        runCase "\{dir}/a_nodoc_broken.mdk" [] 1 [
          "requires it to `medaka check` first",
          "unbound variable `nosuchvariable`"
        ],
      ),
      (
        "b zero-doctest clean",
        runCase "\{dir}/b_nodoc_clean.mdk" [] 0 ["(no doctests found)"],
      ),
      (
        "c doctest passing",
        runCase "\{dir}/c_doctest_pass.mdk" [] 0 ["1/1 passed"],
      ),
      (
        "d doctest failing",
        runCase "\{dir}/d_doctest_wrong_expectation.mdk" [] 1 [
          "FAIL", "0/1 passed"
        ],
      ),
      (
        "e exemption preserved (hasTests)",
        runCase
          "\{dir}/e_exempt_via_testdecl.mdk"
          ["--engines", "eval"]
          0
          ["  ok   ", "sum of two", "1/1 passed"],
      ),
      (
        "h exemption preserved (hasProps)",
        runCase
          "\{dir}/h_exempt_via_prop.mdk"
          ["--engines", "eval"]
          0
          ["Testing \"addition commutes\" [eval] ... OK (100 tests passed)"],
      ),
      (
        "h native property compilation checks the exempt target",
        runCase "\{dir}/h_exempt_via_prop.mdk" [] 1 [
          "[native] ... FAILED", "could not build",
          "unbound variable `nosuchvariable`"
        ],
      ),
    ],
  ])

test "medaka test announces the exemption (issue #1680): cells i, k, l" = inTree
  fixtures
  (dir => expectAll [
    expectEach [
      (
        "i announcement on the hasTests exemption",
        runCase
          "\{dir}/e_exempt_via_testdecl.mdk"
          ["--engines", "eval"]
          0
          [
            "note: typechecking was skipped for", "`test \"…\"` decls",
            "to type-check it, run `medaka check", "1/1 passed"
          ],
      ),
      (
        "k announcement on the hasProps exemption",
        runCase
          "\{dir}/h_exempt_via_prop.mdk"
          ["--engines", "eval"]
          0
          [
            "note: typechecking was skipped for", "`prop \"…\"` decls",
            "to type-check it, run `medaka check",
            "[eval] ... OK (100 tests passed)"
          ],
      ),
      (
        "l 1680 repro: the panic is explained",
        runCase
          "\{dir}/i_1680_repro.mdk"
          ["--engines", "eval"]
          1
          [
            "note: typechecking was skipped for",
            "may be an uncaught type error",
            "runtime error [E-PANIC]: unknown op '+'"
          ],
      ),
    ],
  ])

test "medaka test narrows the exemption to compiler/stdlib vehicles: cells n, o, p, q" = inTree
  scenarioFixtures
  (dir => expectAll [
    expectEach [
      (
        "n narrowing: compiler-prefix vehicle no longer exempt",
        runCase
          "\{dir}/compiler/types/n_narrow_compiler_vehicle_test.mdk"
          []
          1
          [
            "requires it to `medaka check` first",
            "type mismatch: Int vs String"
          ],
      ),
      (
        "o narrowing: stdlib-prefix vehicle no longer exempt",
        runCase "\{dir}/stdlib/o_narrow_stdlib_vehicle_test.mdk" [] 1 [
          "requires it to `medaka check` first", "type mismatch: Int vs String"
        ],
      ),
      (
        "p suffix alone insufficient: stays exempt",
        runCase
          "\{dir}/p_suffix_only_stays_exempt_test.mdk"
          ["--engines", "eval"]
          1
          [
            "note: typechecking was skipped for",
            "runtime error [E-PANIC]: unknown op '+'"
          ],
      ),
      (
        "q narrowing survives a relative invocation form",
        runCaseIn
          "\{dir}/compiler/types"
          "n_narrow_compiler_vehicle_test.mdk"
          []
          1
          [
            "requires it to `medaka check` first",
            "type mismatch: Int vs String"
          ],
      ),
    ],
  ])

test "medaka test narrows the exemption by path component: cells u, v, r, s" = inTree
  scenarioFixtures
  (dir => expectAll [
    expectEach [
      (
        "u narrowing: this repo own test dir no longer exempt",
        runCase "\{dir}/repo/test/u_repo_test_dir_test.mdk" [] 1 [
          "requires it to `medaka check` first", "type mismatch: Int vs String"
        ],
      ),
      (
        "v test dir without a compiler sibling: stays exempt",
        runCase
          "\{dir}/norepo/test/v_no_compiler_sibling_stays_exempt_test.mdk"
          ["--engines", "eval"]
          1
          [
            "note: typechecking was skipped for",
            "runtime error [E-PANIC]: unknown op '+'"
          ],
      ),
      (
        "r substring is not a component (mycompiler): stays exempt",
        runCase
          "\{dir}/mycompiler/sqlite/test/r_substring_not_component_test.mdk"
          ["--engines", "eval"]
          1
          [
            "note: typechecking was skipped for",
            "runtime error [E-PANIC]: unknown op '+'"
          ],
      ),
      (
        "s substring is not a component (newstdlib): stays exempt",
        runCase
          "\{dir}/newstdlib/s_substring_not_component_test.mdk"
          ["--engines", "eval"]
          1
          [
            "note: typechecking was skipped for",
            "runtime error [E-PANIC]: unknown op '+'"
          ],
      ),
    ],
  ])

test "medaka test announces the skip only when it skips: cells j, m, f, g" = inTree
  scenarioFixtures
  (dir => expectAll [
    expectEach [
      (
        "j doctest wins: no skip announced",
        refuteCase "\{dir}/j_doctest_beats_testdecl.mdk" 0 [
          "typechecking was skipped",
        ],
      ),
      (
        "m gated clean module: no skip announced",
        refuteCase "\{dir}/b_nodoc_clean.mdk" 0 ["typechecking was skipped"],
      ),
      (
        "f directory with ill-typed member",
        runCase "\{dir}/dir" [] 1 ["requires it to `medaka check` first"],
      ),
      (
        "g import-bearing, zero doctests, ill-typed",
        runCase "\{dir}/proj/main.mdk" [] 1 [
          "requires it to `medaka check` first", "type mismatch: Int vs String"
        ],
      ),
    ],
  ])

test "medaka test agrees with medaka check on an import-bearing module: cell t, control" = inTree
  scenarioFixtures
  (dir => expectAll [
    expectEach [
      (
        "t import-bearing, module-own impl: test agrees with check",
        agreeCase "\{dir}/agree/main.mdk",
      ),
      ("control: medaka check rejects the cell a fixture", control dir),
    ],
  ])
