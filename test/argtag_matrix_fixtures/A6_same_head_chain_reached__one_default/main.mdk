-- A6/B2 — A6's same-head collision where one sibling INHERITS the interface default
-- instead of defining the method. See CENSUS.md.
--
-- This historically exercised the RAW LEG of the emitter's head-collision guard.
-- Complete inferred predicate slots now make top-level `go` carry the exact
-- `Wrap (Pair Int)` or `Wrap (Pair String)` dictionary, so the inherited default and
-- explicit body are selected without consulting that arg-tag leg.
interface Wrap f where
  wsize : f a -> Int
  wsize _ = 9

data Pair a b = Pair a b

impl Wrap (Pair Int)

impl Wrap (Pair String) where
  wsize _ = 2

go xs = wsize xs

main =
  let _ = println (go (Pair 1 True))
  println (go (Pair "x" True))
