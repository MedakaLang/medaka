-- A7/B2 — the historical negative control for A6/B2's old raw leg: one impl defines
-- the method and a sibling at a DIFFERENT head inherits the interface default. Complete
-- inferred predicate slots now make this top-level `go` carry exact dictionaries too;
-- the unchanged `9|2` answer controls distinct-head default/defined selection.
-- See CENSUS.md.
--
-- `Solo` and `Pair` remain different heads, while the inherited/default dimension matches
-- A6/B2. A repair that merely folded all complete `Wrap f` evidence to one row would move
-- this control as well.
interface Wrap f where
  wsize : f a -> Int
  wsize _ = 9

data Pair a b = Pair a b

data Solo a = Solo a

impl Wrap Solo

impl Wrap (Pair Int) where
  wsize _ = 2

go xs = wsize xs

main =
  let _ = println (go (Solo True))
  println (go (Pair 1 True))
