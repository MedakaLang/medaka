-- A6 — historically the same-head collision that reached the native arg-tag chain,
-- with no pinned local anywhere. Complete inferred predicate slots now make `go`
-- carry an exact `Wrap f` dictionary, so the two calls are decidable. See CENSUS.md.
--
-- A2 shares this cell's head collision but routes through a `let`-local that cannot
-- abstract predicate evidence under the unpin hatch. It remains the control for the
-- undecidable arg-tag route. Here top-level `go` can publish its higher-kinded
-- constraint and receive one exact dictionary per call.
interface Wrap f where
  wsize : f a -> Int

data Pair a b = Pair a b

impl Wrap (Pair Int) where
  wsize _ = 1

impl Wrap (Pair String) where
  wsize _ = 2

go xs = wsize xs

main =
  let _ = println (go (Pair 1 True))
  println (go (Pair "x" True))
