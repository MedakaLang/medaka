    let source = underRoot "test/process_runtime_fixtures/adapter_eintr.mdk"
    let shim = "\{dir}/delay.so"
    let binary = "\{dir}/adapter_eintr"
    expectAll [
      expectSpawnOk "clang" [
        "-shared",
        "-fPIC",
        underRoot "test/process_runtime_fixtures/adapter_delay.c",
        "-ldl",
        "-o",
        shim,
      ],
      expectSpawnOk (underRoot "medaka") ["build", source, "-o", binary],
      expectSpawnOkLine
        "env"
        ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=eintr", binary]
        "adapter eintr deadline passed",
      expectSpawnOkLine binary [] "adapter eintr deadline failed",
    ])

test "parked read rechecks the owner after its fd is reused" = withScratchDir
  (dir =>
    let source = underRoot "test/process_runtime_fixtures/adapter_reuse.mdk"
    let shim = "\{dir}/delay.so"
    let binary = "\{dir}/adapter_reuse"
    let args = ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=reuse", binary]
    expectAll [
      expectSpawnOk "clang" [
        "-shared",
        "-fPIC",
        underRoot "test/process_runtime_fixtures/adapter_delay.c",
        "-ldl",
        "-o",
        shim,
      ],
      expectSpawnOk (underRoot "medaka") ["build", source, "-o", binary],
      expectSpawnOkLine "env" args "adapter fd reused",
      expectSpawnOkLine "env" args "adapter reuse passed",
    ])

test "launch cleanup errors retain the ticket for retry" = withScratchDir
  (dir =>
    let source =
      underRoot "test/process_runtime_fixtures/adapter_cleanup_error.mdk"
    let shim = "\{dir}/delay.so"
    let binary = "\{dir}/adapter_cleanup_error"
    expectAll [
      expectSpawnOk "clang" [
        "-shared",
        "-fPIC",
        underRoot "test/process_runtime_fixtures/adapter_delay.c",
        "-ldl",
        "-o",
        shim,
      ],
      expectSpawnOk (underRoot "medaka") ["build", source, "-o", binary],
      expectSpawnOkLine
        "env"
        ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=wait-error", binary]
        "adapter cleanup error passed",
      expectSpawnOkLine binary [] "adapter cleanup error failed",
    ])
