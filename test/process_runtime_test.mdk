import test_process.{
  underRoot,
  boundedVerb,
  withScratchDir,
  expectSpawnOk,
  expectSpawnFails,
  expectSpawnOkLine,
}
import test.{Expectation, expectAll, fail, pass}
import string.{contains}

run : String -> List String -> String -> <Exec> Expectation
run cmd args marker = match boundedVerb cmd args
  Err e => fail "could not run \{cmd}: \{e}"
  Ok (code, out, err) =>
    if code == 0 && contains marker out then
      pass
    else
      fail "\{cmd} exited \{intToString code}: \{out}\{err}"

fixture : String ->
  String ->
  List String ->
  <Exec, IO, FileRead, FileWrite> Expectation
fixture dir name modes =
  let output = "\{dir}/\{name}"
  let built = boundedVerb "clang" [
    "-DMDK_PROCESS_TESTING",
    "-std=gnu11",
    "-O0",
    "-pthread",
    "-I\{underRoot "runtime"}",
    underRoot "runtime/medaka_rt.c",
    underRoot "runtime/medaka_process.c",
    underRoot "test/process_runtime_fixtures/\{name}.c",
    "-lgc",
    "-lm",
    "-o",
    output,
  ]
  match built
    Err e => fail "could not compile \{name}: \{e}"
    Ok (code, _, err) =>
      if code /= 0 then
        fail "compiling \{name} failed: \{err}"
      else
        expectAll
          (map
              (mode => run output (if mode == "" then [] else [mode]) " passed")
              modes
            ++ (if name == "submission" then
              [
                expectSpawnOkLine
                  "env"
                  ["MEDAKA_TEST_SUBMISSION_INIT_FAIL=1", output]
                  "worker initialization refusal preserves synchronous launch passed",
              ]
            else
              []))

test "real process owner and launch tickets retain resources through failures" = withScratchDir
  (dir => expectAll [
    fixture dir "owner_smoke" [
      "", "deny-clone", "deny-signal", "deny-wait", "deny-close", "sigpipe",
      "selective-close"
    ],
    fixture dir "pipe_io" [""],
    fixture dir "launch_tickets" ["", "signal", "wait", "signal-stalled"],
    fixture dir "submission" ["", "gc", "signal", "wait"],
  ])

test "submission controls reject missing roots and GC-active construction" = withScratchDir
  (dir =>
    run
      "python3"
      [
        underRoot "test/process_runtime_fixtures/submission_mutations.py",
        underRoot "",
        dir,
      ]
      "submission mutation controls passed")

test "optional submission startup preserves standalone, archive, cached and installed links" = withScratchDir
  (dir =>
    run
      "python3"
      [
        underRoot "test/process_runtime_fixtures/submission_linkage.py",
        underRoot "",
        dir,
      ]
      "submission linkage controls passed")

test "typed submission preserves Exec grants and explicitly refuses eval and wasm" = withScratchDir
  (dir =>
    let source = underRoot "test/process_runtime_fixtures/submission_typed.mdk"
    let compiler = underRoot "medaka"
    let binary = "\{dir}/submitted"
    expectAll [
      expectSpawnOk compiler ["check", source],
      expectSpawnOk compiler ["build", source, "-o", binary],
      expectSpawnOkLine binary [] "submitted native passed",
      expectSpawnOk compiler [
        "check-policy", source, "--allow", "Exec=/bin/true", "--fn", "launch"
      ],
      expectSpawnFails
        compiler
        ["check-policy", source, "--allow", "Exec=/bin/false", "--fn", "launch"]
        "Exec",
      expectSpawnFails
        compiler
        [
          "check",
          underRoot "test/process_runtime_fixtures/submission_grant.mdk",
        ]
        "Exec",
      expectSpawnFails
        compiler
        ["run", source]
        "process ownership is unavailable in eval",
      expectSpawnFails
        compiler
        ["check", "--target", "wasm", source]
        "does not grant Exec",
    ])

test "owner fixture rejects an incorrect exit status" = withScratchDir (dir =>
  let script =
    """
set -eu
sed 's/field(t,2)==255/field(t,2)==253/g' "$1/test/process_runtime_fixtures/owner_smoke.c" > "$2/mutant.c"
grep -q 'field(t,2)==253' "$2/mutant.c"
clang -DMDK_PROCESS_TESTING -std=gnu11 -O0 -pthread -I"$1/runtime" "$1/runtime/medaka_rt.c" "$1/runtime/medaka_process.c" "$2/mutant.c" -lgc -lm -o "$2/mutant"
if "$2/mutant" >"$2/out" 2>&1; then exit 1; fi
grep -q 'field(t,2)==253' "$2/out"
printf 'control failed as expected\n'
"""
  run
    "sh"
    ["-c", script, "control", underRoot "", dir]
    "control failed as expected")

test "typed pipe operations link and report invalid or closed streams" = withScratchDir
  (dir =>
    let source = "\{dir}/pipe_typed.mdk"
    let binary = "\{dir}/pipe_typed"
    let program =
      """
import bytes.{encodeUtf8}
import process.{SpawnOptions(..), PipeChoice(..), OutputStream(..), ProcessError(..), StartError(..), start, tryRead, tryWrite, streamFd, closeStdin}
main = match start "/bin/true" (SpawnOptions { argv = [], cwd = "/tmp", env = [], stdin = Piped, stdout = Piped, stderr = Piped })
  Err _ => println "start failed"
  Ok p =>
    let invalidRead = tryRead p ChildStdout 0
    let invalidFd = streamFd p 3
    let _ = closeStdin p
    let closedWrite = tryWrite p (encodeUtf8 "x") 0 1
    match (invalidRead, invalidFd, closedWrite)
      (Err (InvalidIO _), Err (InvalidIO _), Err ProcessClosed) => println "typed pipe passed"
      _ => println "unexpected result"
"""
    match writeFile source program
      Err e => fail "could not write typed pipe probe: \{e}"
      Ok _ => expectAll [
        run (underRoot "medaka") ["check", source] "main",
        run (underRoot "medaka") ["build", source, "-o", binary] "built",
        run binary [] "typed pipe passed",
      ])

test "async launch retains grants and supports cross-module result inspection" = withScratchDir
  (dir =>
    let source = underRoot "test/process_runtime_fixtures/adapter_typed.mdk"
    let compiler = underRoot "medaka"
    let binary = "\{dir}/adapter"
    expectAll [
      expectSpawnOk compiler ["check", source],
      expectSpawnOk compiler ["build", source, "-o", binary],
      expectSpawnOkLine binary [] "adapter native passed",
      expectSpawnOk compiler [
        "check-policy", source, "--allow", "Clock,Exec=/bin/true,Stdout",
        "--fn", "launch"
      ],
      expectSpawnFails
        compiler
        [
          "check-policy", source, "--allow", "Clock,Exec=/bin/false,Stdout",
          "--fn", "launch"
        ]
        "Exec",
      expectSpawnFails
        compiler
        ["check", underRoot "test/process_runtime_fixtures/adapter_forge.mdk"]
        "Process",
      expectSpawnFails
        compiler
        [
          "check",
          underRoot "test/process_runtime_fixtures/adapter_ticket_forge.mdk",
        ]
        "LaunchTicket",
    ])

test "async launch timeout and cancellation retain cleanup during delayed exec" = withScratchDir
  (dir =>
    let compiler = underRoot "medaka"
    let source = underRoot "test/process_runtime_fixtures/adapter_stall.mdk"
    let shim = "\{dir}/delay.so"
    let binary = "\{dir}/adapter_stall"
    expectAll [
      expectSpawnOk "clang" [
        "-shared",
        "-fPIC",
        underRoot "test/process_runtime_fixtures/adapter_delay.c",
        "-ldl",
        "-o",
        shim,
      ],
      expectSpawnOk compiler ["check", source],
      expectSpawnOk compiler ["build", source, "-o", binary],
      expectSpawnOkLine
        "env"
        ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=exec", binary]
        "adapter stall passed",
      expectSpawnOkLine
        "env"
        ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=pipe", binary]
        "adapter stall passed",
      expectSpawnOkLine binary [] "adapter stall failed",
    ])

test "async write retains exact prefix on an injected syscall error" = withScratchDir
  (dir =>
    let source =
      underRoot "test/process_runtime_fixtures/adapter_write_error.mdk"
    let shim = "\{dir}/delay.so"
    let binary = "\{dir}/adapter_write_error"
    expectAll [
      expectSpawnOk "clang" [
        "-shared",
        "-fPIC",
        underRoot "test/process_runtime_fixtures/adapter_delay.c",
        "-ldl",
        "-o",
        shim,
      ],
      expectSpawnOk (underRoot "medaka") ["build", source, "-o", binary],
      expectSpawnOkLine
        "env"
        ["LD_PRELOAD=\{shim}", "ADAPTER_DELAY=write", binary]
        "adapter error prefix passed",
      expectSpawnOkLine binary [] "adapter error prefix failed",
    ])

