-- writeFileMode refuses a path whose canonical form its grant does not admit, in the
-- mode medaka_rt.c confines it in: writeFile's, which follows the last component.
-- The file is left at exactly the mode given, whatever the umask or an existing
-- file's mode, so the modes read back are the ones written.  The last section calls it
-- under a declared bound that a wider grant cannot lift.  An OS error prints as
-- `Err (host)`: each engine words it its own way.  run.sh builds the tree and
-- installs cfg/link -> ../outdir/sub.
import string.{contains}

said : Result String a -> String
said (Ok _) = "Ok"
said (Err e) =
  if contains "is outside the granted authority" e then
    "Err \{e}"
  else
    "Err (host)"

writeCfg : String -> Int -> String -> <FileWrite "cfg/*"> Result String Unit
writeCfg name mode s = writeFileMode ("cfg/" ++ name) mode s

modeCfg : String -> <FileRead "cfg/*"> Result String Int
modeCfg name = fileMode ("cfg/" ++ name)

modeText : Result String Int -> String
modeText (Ok m) = "Ok \{m}"
modeText (Err e) = said (Err e)

-- the same write under a narrow bound, called through a wide row
writeBound : String -> <FileWrite "cfg/*"> Result String Unit
writeBound leaf = writeFileMode ("cfg/link/" ++ leaf) 384 "x"

widePackedWrite : Option (String -> <FileWrite> Result String Unit)
widePackedWrite = Some writeBound

main =
  println "new: \{said (writeCfg "new.txt" 384 "w")}"
  println "new mode: \{modeText (modeCfg "new.txt")}"
  println "overwrite: \{said (writeCfg "a.txt" 420 "x")}"
  println "overwrite mode: \{modeText (modeCfg "a.txt")}"
  println "inside sub: \{said (writeCfg "sub/b.txt" 448 "y")}"
  println "up: \{said (writeCfg "../new2.txt" 384 "z")}"
  println "link out: \{said (writeCfg "out" 384 "z")}"
  println "dangling: \{said (writeCfg "dangling" 384 "z")}"
  println "dir: \{said (writeCfg "sub" 384 "z")}"
  println "absent dir: \{said (writeCfg "nodir/x.txt" 384 "z")}"
  println "through link: \{said (writeCfg "link/a.txt" 384 "z")}"
  let _ = match widePackedWrite
    Some f => println "bound write: \{said (f "stolen.txt")}"
    None => println "unexpected empty container"
