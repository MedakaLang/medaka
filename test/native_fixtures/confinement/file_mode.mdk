-- fileMode refuses a path whose canonical form its grant does not admit, in the mode
-- medaka_rt.c confines it in: a read that follows the last component, as statFile
-- does.  The permission bits are the umask's and the directory's, so each success
-- prints only that the value lies in 0 to 4095.  The last section calls it under a
-- declared bound that a wider grant cannot lift.  An OS error prints as `Err (host)`:
-- each engine words it its own way.  run.sh builds the tree and installs
-- cfg/link -> ../outdir/sub.
import string.{contains}

said : Result String a -> String
said (Ok _) = "Ok"
said (Err e) =
  if contains "is outside the granted authority" e then
    "Err \{e}"
  else
    "Err (host)"

modeCfg : String -> <FileRead "cfg/*"> Result String Int
modeCfg name = fileMode ("cfg/" ++ name)

modeText : Result String Int -> String
modeText (Ok m) =
  if m >= 0 then
    if m <= 4095 then "Ok in range" else "Ok out of range"
  else
    "Ok out of range"
modeText (Err e) = said (Err e)

-- the same read under a narrow bound, called through a wide row
modeBound : String -> <FileRead "cfg/*"> Result String Int
modeBound leaf = fileMode ("cfg/link/" ++ leaf)

widePackedMode : Option (String -> <FileRead> Result String Int)
widePackedMode = Some modeBound

main =
  println "mode file: \{modeText (modeCfg "a.txt")}"
  println "mode dir: \{modeText (modeCfg "sub")}"
  println "mode inside link: \{modeText (modeCfg "../inlink")}"
  println "mode up: \{modeText (modeCfg "../secret.txt")}"
  println "mode link out: \{modeText (modeCfg "out")}"
  println "mode dangling: \{modeText (modeCfg "dangling")}"
  println "mode absent: \{modeText (modeCfg "nowhere")}"
  println "mode through link: \{modeText (modeCfg "link/a.txt")}"
  let _ = match widePackedMode
    Some f => println "bound mode: \{modeText (f "stolen.txt")}"
    None => println "unexpected empty container"
