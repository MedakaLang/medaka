-- makeDir refuses a path whose canonical form its grant does not admit, in entry
-- mode: the last component is not followed, so a symbolic link there is the entry
-- itself, which already exists, and is never made through.  Each element before it
-- is followed.  The last section calls it under a declared bound that a wider grant
-- cannot lift.  An OS error prints as `Err (host)`: each engine words it its own
-- way.  run.sh builds the tree and installs cfg/link -> ../outdir/sub.
import string.{contains}

said : Result String a -> String
said (Ok _) = "Ok"
said (Err e) =
  if contains "is outside the granted authority" e then
    "Err \{e}"
  else
    "Err (host)"

makeCfg : String -> <FileWrite "cfg/*"> Result String Unit
makeCfg name = makeDir ("cfg/" ++ name)

-- the same creation under a narrow bound, called through a wide row
makeBound : String -> <FileWrite "cfg/*"> Result String Unit
makeBound leaf = makeDir ("cfg/link/" ++ leaf)

widePackedMake : Option (String -> <FileWrite> Result String Unit)
widePackedMake = Some makeBound

main =
  println "make new: \{said (makeCfg "newdir")}"
  println "make inside new: \{said (makeCfg "newdir/inner")}"
  println "make new again: \{said (makeCfg "newdir")}"
  println "make existing: \{said (makeCfg "sub")}"
  println "make file: \{said (makeCfg "a.txt")}"
  println "make up: \{said (makeCfg "../outdir/stolen.txt")}"
  println "make link: \{said (makeCfg "link")}"
  println "make link out: \{said (makeCfg "out")}"
  println "make dangling: \{said (makeCfg "dangling")}"
  println "make absent parent: \{said (makeCfg "nowhere/x")}"
  println "make through link: \{said (makeCfg "link/stolen.txt")}"
  let _ = match widePackedMake
    Some f => println "bound make: \{said (f "stolen.txt")}"
    None => println "unexpected empty container"
