-- CONTROL half of the pair with `record_ctor_sibling_blocks_narrowing/`: two
-- named-field constructors of one type where BOTH declare `x`, at DIFFERENT slot
-- indices.  Both are owners of `x` and both survive the receiver-identity filter,
-- as one candidate for the type `T`; no sibling withholds `x`, so the narrowing
-- selects `T` and the position disagreement is what rejects the access.
public export data T = Zed { x : Int, q : Int } | Oth { q : Int, x : Int }

export mkZ : T
mkZ = Zed { x = 1, q = 2 }

export mkO : T
mkO = Oth { q = 3, x = 4 }
