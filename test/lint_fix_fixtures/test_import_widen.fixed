-- Fixture for the `--fix` import widening (#3285).
-- A rewrite that introduces a `test` verb the selective `import test.{…}` list
-- does not name must add that verb to the list, once, in list order.

import test.{expectTrue, expectFalse, expectEqual, expectNotEqual}

eqCase a = expectEqual a 1
neCase a = expectNotEqual a 1
neCase2 a = expectNotEqual a 2
