-- Fixture for rule-not-eq autofix.
-- The `bang*` rows are NEGATIVE since #1739 half A: `!` is Ref-dereference, not
-- boolean negation, so `--fix` must leave them byte-identical.

notEq a b = not (a == b)
notNe a b = not (a /= b)
bangEq a b = !(a == b)
bangNe a b = !(a /= b)
nested a b c = if not (a == b) then c else a

-- NEGATIVE: must stay untouched.
negLt a b = not (a < b)
negFlag flag = not flag
negPlain a b = a == b
