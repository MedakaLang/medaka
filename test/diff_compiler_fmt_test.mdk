test "every probe reproduces its corpus's goldens" = gradeProbeRows rows

{- | The `<stem> <rules>` rows of `<dir>/ONLY.txt`: the one rule set each
   fixture's golden is the report (or the fix) of, so adding a rule moves none
   of them. `capture_goldens.sh` reads the same file. -}
onlyRows : String -> <FileRead, IO> Result String (List (String, String))
onlyRows dir = match readFile "\{medakaRoot}/\{dir}/ONLY.txt"
  Err e => Err "\{dir}/ONLY.txt: \{e}"
  Ok raw =>
    Ok (somes (map onlyRow (filter (l => not (startsWith "#" l)) (lines raw))))

onlyRow : String -> Option (String, String)
onlyRow l = match split " " (trim l)
  [name, rules] => Some (name, rules)
  _ => None

-- A narrowed probe run over one fixture directory: the probe binary, the
-- directory, whether its stdout is lint output (graded as a sorted line set),
-- and the golden's file suffix.
data NarrowedProbe = NarrowedProbe {
  probe : String,
  dir : String,
  isLint : Bool,
  suffix : String,
}

-- One narrowed fixture: the probe run with `--only=<rules>`, graded on its
-- exit and its stdout against the fixture's golden.
narrowedFailure : NarrowedProbe ->
  (String, String) ->
  <Exec, FileRead, IO> Option String
narrowedFailure np (name, rules) =
  let src = "\{medakaRoot}/\{np.dir}/\{name}.mdk"
  match boundedVerb "\{medakaRoot}/\{np.probe}" ["--only=\{rules}", src]
    Err e => Some "\{name}: could not spawn \{np.probe}: \{e}"
    Ok (code, out, err) => match processFailure np.probe name code err
      Some m => Some m
      None => match readFile "\{medakaRoot}/\{np.dir}/\{name}\{np.suffix}"
        Err e => Some "\{name}: no readable golden: \{e}"
        Ok raw =>
          let text =
            chompNewlines (if np.isLint then stripUnitAutoPrint out else out)
          let actual =
            if np.isLint then
              chompNewlines (unlines (sort (lines text)))
            else
              text
          if chompNewlines raw == actual then
            None
          else
            Some "\{name}: \{diffNote (chompNewlines raw) actual}"

narrowedFailures : NarrowedProbe -> Int -> <Exec, FileRead, IO> List String
narrowedFailures np want = match fixtureStems "\{medakaRoot}/\{np.dir}"
  Err e => ["\{np.dir}: \{e}"]
  Ok stems => match onlyRows np.dir
    Err e => [e]
    Ok table => narrowedGrade np want stems table

narrowedGrade : NarrowedProbe ->
  Int ->
  List String ->
  List (String, String) ->
  <Exec, FileRead, IO> List String
narrowedGrade np want stems table =
  let tabled = sort (map fst table)
  let uncovered =
    if stems == tabled then
      []
    else
      ["\{np.dir}: fixtures \{debug stems} are not the tabled \{debug tabled}"]
  countFloor np.dir want stems
    ++ uncovered
    ++ somes (map (narrowedFailure np) table)

test "diff_compiler_lint fixtures reproduce their one-rule goldens" =
  report
    "lint"
    (narrowedFailures
      NarrowedProbe {
        probe = "test/bin/lint_main",
        dir = "test/lint_fixtures",
        isLint = True,
        suffix = ".expected",
      }
      5)

test "diff_compiler_lint_fix fixtures reproduce their one-rule goldens" =
  report
    "lint-fix"
    (narrowedFailures
      NarrowedProbe {
        probe = "test/bin/lint_fix_main",
        dir = "test/lint_fix_fixtures",
        isLint = False,
        suffix = ".fixed",
      }
      69)

test "`medaka new`'s scaffold matches its golden tree" =
  report
    "scaffold"
    (scaffoldFailures "test/bin/new_main" "myapp" "test/new_golden/myapp" 4)

test "entry-probe error paths exit nonzero with an empty artifact" =
  report "error-path" (errorPathFailures "test/bin/llvm_emit_modules_main" 6)

-- # Shared helpers for the rows below that do not fit `Row`

-- | `text` contains every string in `needles`.
containsAll : String -> List String -> Bool
containsAll text needles = all (n => contains n text) needles

-- | `text` reads as a rejected `check` run: a parse/type-error vocabulary
-- word, case-insensitively.
hasParseErr : String -> Bool
hasParseErr text =
  let low = toLower text
  contains "parse error" low
    || contains "type error" low
    || contains "unbound" low
    || contains "unknown" low

{- | The `# TYPES_USER` section of a snapshot `.md`'s lines: everything
   after a line reading exactly `# TYPES_USER`, up to the next `# `-headed
   line or the end. -}
typesUserSection : List String -> List String
typesUserSection ls = takeSection (dropWhile (/= "# TYPES_USER") ls)

takeSection : List String -> List String
takeSection [] = []
takeSection (_ :: rest) = takeUntilHeader rest

takeUntilHeader : List String -> List String
takeUntilHeader [] = []
takeUntilHeader (l :: rest)
  | startsWith "# " l = []
  | otherwise = l :: takeUntilHeader rest

-- | The lines of `want` absent, verbatim, from `got`.
missingLines : List String -> List String -> List String
missingLines want got = filter (l => not (elem l got)) want

{- | Every committed `# TYPES_USER` line of the snapshot at `snapshotRel`
   appears verbatim in `host`'s own TYPES output over `fix` — the
   subset-membership check `diff_compiler_effect_hole`/`_effect_param`
   shared (#81 Stage C2: the prelude scheme table is pinned once elsewhere,
   so only the user schemes are re-checked here). -}
effectTypesSuperset : String ->
  String ->
  String ->
  String ->
  String ->
  <Exec, FileRead, IO> Option String
effectTypesSuperset snapshotRel host rt core fix =
  let snap = underRoot snapshotRel
  match readFile snap
    Err e => Some "missing snapshot \{snap}: \{e}"
    Ok snapRaw =>
      let want = typesUserSection (lines (chompNewlines snapRaw))
      match boundedVerb host [rt, core, fix]
        Err e => Some "native-host TYPES: could not spawn check_main: \{e}"
        Ok (code, out, err) =>
          match processFailure "check_main" "native-host TYPES" code err
            Some m => Some m
            None =>
              let got = lines (chompNewlines (stripUnitAutoPrint out))
              let missing = missingLines want got
              if missing == [] then
                None
              else
                let body = unlines (map (l => "  missing: \{l}") missing)
                Some "native-host TYPES missing # TYPES_USER lines:\n\{body}"

-- # `diff_compiler_references_correctness`

-- | The project fixtures the retired script dumped, in its own
-- order. `test/references_fixtures/query` is a DIFFERENT gate's corpus
-- (JSONL query goldens, not `expected.golden`) and stays out.
referencesFixtures : List String
referencesFixtures = [
  "binder_loc",
  "correctness",
  "ctor_import",
  "dup_field_def",
  "iface_collide",
  "iface_method_loc",
  "iface_ty_collide",
  "iface_use",
  "impl_method",
  "multiclause",
  "self_rec_local",
  "sig_name",
]

{- | Everything wrong with one `references_fixtures/<name>/` project: a
   `refindex_main --dump` over its `main.mdk`, path-normalized the same way
   the retired script's `sed` was, diffed against `expected.golden`. -}
referencesFixtureFailure : String -> <Exec, FileRead, IO> Option String
referencesFixtureFailure name =
  let dir = underRoot "test/references_fixtures/\{name}"
  let bin = underRoot "test/bin/refindex_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  match boundedVerb bin ["--dump", rt, core, "\{dir}/main.mdk", dir]
    Err e => Some "\{name}: could not spawn refindex_main: \{e}"
    Ok (code, out, err) => match processFailure (basename bin) name code err
      Some m => Some m
      None =>
        let got = chompNewlines (replaceAll "\{dir}/" "" out)
        match readFile "\{dir}/expected.golden"
          Err e => Some "\{name}: no readable golden: \{e}"
          Ok raw =>
            let want = chompNewlines raw
            if want == got then None else Some "\{name}: \{diffNote want got}"

-- # `diff_compiler_effect_param`

effectParamFixture : String
effectParamFixture = "test/diff_fixtures/effect_param.mdk"

effectParamSnapshot : String
effectParamSnapshot = "test/snapshots/diff_fixtures_types/effect_param.md"

{- | Stage-2a's parameterized effect surface (`effect Net Prefix`,
   `<Net "a.com/foo">`) accepted by the native CLI, inferred correctly, and
   agreeing with the committed `# TYPES_USER` snapshot. -}
effectParamFailures : <Exec, FileRead, IO> List String
effectParamFailures =
  let fix = underRoot effectParamFixture
  let native = underRoot "medaka"
  let host = underRoot "test/bin/check_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  match boundedVerb native ["check", fix]
    Err e => ["native-cli/check: could not spawn: \{e}"]
    Ok (code, natOut, natErr) =>
      match processFailure "medaka" "native-cli/check" code natErr
        Some m => [m]
        None =>
          let natText = natOut ++ natErr
          let acceptFail =
            if hasParseErr natText then
              Some
                "native-cli/check emitted an error accepting effect-param syntax"
            else
              None
          let inferFail =
            if containsAll natText [
              "fetch : String -> <FFI \"c*\", Net \"a.com/foo\"> String",
              "netGet : String -> <FFI \"c\", Net \"a.com/foo\"> String",
            ] then
              None
            else
              Some "native-cli/check did not infer the <Net \"a.com/foo\"> rows"
          let typesFail =
            effectTypesSuperset effectParamSnapshot host rt core fix
          let graded = [acceptFail, inferFail, typesFail]
          countFloor "effect-param assertions" 3 graded ++ somes graded

-- # `diff_compiler_effect_hole`

effectHoleFixture : String
effectHoleFixture = "test/diff_fixtures/effect_param_hole.mdk"

effectHoleSnapshot : String
effectHoleSnapshot = "test/snapshots/diff_fixtures_types/effect_param_hole.md"

effectHoleWs2Src : String
effectHoleWs2Src = unlines [
  "effect Net Prefix",
  "extern netGet : (url : String) -> <FFI \"c\", Net url> String",
  "fetch _ =",
  "  let dest = \"a.com/foo\"",
  "  netGet dest",
  "main : <IO> Unit",
  "main = println \"x\"",
]

effectHoleRejectSiblingSrc : String
effectHoleRejectSiblingSrc = unlines [
  "effect Net Prefix",
  "extern netGet : (url : String) -> <FFI \"c\", Net url> String",
  "fetch : Unit -> <FFI \"c*\", Net \"a.com/*\"> String",
  "fetch _ = netGet \"a.com.evil.com/x\"",
  "main : <IO> Unit",
  "main = println \"x\"",
]

effectHoleRejectComputedSrc : String
effectHoleRejectComputedSrc = unlines [
  "effect Net Prefix",
  "extern netGet : (url : String) -> <FFI \"c\", Net url> String",
  "fetch : String -> <FFI \"c*\", Net \"a.com/*\"> String",
  "fetch url = netGet url",
  "main : <IO> Unit",
  "main = println \"x\"",
]

effectHoleRejectOuterComputedSrc : String
effectHoleRejectOuterComputedSrc = unlines [
  "effect Net Prefix",
  "extern netGet : (url : String) -> <FFI \"c\", Net url> String",
  "fetch : String -> <FFI \"c*\", Net \"a.com/*\"> String",
  "fetch url =",
  "  let dest = url",
  "  netGet dest",
  "main : <IO> Unit",
  "main = println \"x\"",
]

{- | Writes `name`.mdk under `scratch` as `src`, then runs `use` on its
   path. `scratch` is the directory the caller made for all of its synthesized
   fixtures (`inFreshDirOf`), so the caller removes it once, after the last. -}
withScratchFile : String ->
  String ->
  String ->
  (String -> <Exec, FileRead, IO> Option String) ->
  <Exec, FileWrite, IO> Option String
withScratchFile scratch name src use =
  let f = "\{scratch}/\{name}.mdk"
  match writeFile f src
    Err e => Some "\{name}: could not write \{f}: \{e}"
    Ok () => use f

{- | Stage-2b's inferred-hole surface (`<Net>`), the α-derived wildcard
   admission, and the delimiter-aware rejections the WS-2 scope-seeding
   soundness rule depends on (#440-adjacent, WS-2). -}
effectHoleFailures : <Exec, FileWrite, FileRead, IO> List String
effectHoleFailures =
  let fix = underRoot effectHoleFixture
  let native = underRoot "medaka"
  let host = underRoot "test/bin/check_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  match boundedVerb native ["check", fix]
    Err e => ["native-cli/check: could not spawn: \{e}"]
    Ok (code, natOut, natErr) =>
      match processFailure "medaka" "native-cli/check" code natErr
        Some m => [m]
        None =>
          let natText = natOut ++ natErr
          let acceptFail =
            if hasParseErr natText then
              Some
                "native-cli/check emitted an error accepting the named-extern fixture"
            else
              None
          let inferFail =
            if containsAll natText [
              "netGet : (url : String) -> <FFI \"c\", Net url> String",
              "fetch : Unit -> <FFI \"c*\", Net \"a.com/*\"> String",
            ] then
              None
            else
              Some "native-cli/check did not infer the hole/wildcard rows"
          let typesFail =
            effectTypesSuperset effectHoleSnapshot host rt core fix
          let synthesized =
            inFreshDirOf
              (scratch =>
                let ws2Fail =
                  withScratchFile
                    scratch
                    "ws2_outer"
                    effectHoleWs2Src
                    (effectHoleWs2Check host rt core)
                let rejectSibling = withScratchFile
                  scratch
                  "reject_sibling"
                  effectHoleRejectSiblingSrc
                  (f => effectHoleRejectCheck native "reject_sibling" f)
                let rejectComputed = withScratchFile
                  scratch
                  "reject_computed"
                  effectHoleRejectComputedSrc
                  (f => effectHoleRejectCheck native "reject_computed" f)
                let rejectOuterComputed = withScratchFile
                  scratch
                  "reject_outer_computed"
                  effectHoleRejectOuterComputedSrc
                  (f => effectHoleRejectCheck native "reject_outer_computed" f)
                let synth =
                  [ws2Fail, rejectSibling, rejectComputed, rejectOuterComputed]
                Ok
                  (countFloor "effect-hole synthesized assertions" 4 synth
                    ++ somes synth))
              (msg => Err msg)
          let synthFails = match synthesized
            Err e => [e]
            Ok fs => fs
          let graded = [acceptFail, inferFail, typesFail]
          countFloor "effect-hole native assertions" 3 graded
            ++ somes graded
            ++ synthFails

{- | WS-2 scope-seeding (E3 precision): an OUTER-BODY `let` literal reaches
   an inner `<Net>` call site, so the recovered row must carry the
   literal's prefix rather than staying the bare `<Net>` an empty `lets`
   scope would infer. -}
effectHoleWs2Check : String ->
  String ->
  String ->
  String ->
  <Exec, FileRead, IO> Option String
effectHoleWs2Check host rt core f = match boundedVerb host [rt, core, f]
  Err e => Some "WS-2 outer-let: could not spawn check_main: \{e}"
  Ok (code, out, err) =>
    match processFailure "check_main" "WS-2 outer-let" code err
      Some m => Some m
      None =>
        let text =
          chompNewlines (unlines (sort (lines (stripUnitAutoPrint out))))
        if contains
          "fetch : a -> <FFI \"c\", Net \"a.com/foo\"> String"
          text then
          None
        else
          Some "WS-2: outer-let row not recovered"

-- | `native check f` must reject: a nonzero exit, or an error/`Effectful`
-- capability diagnostic on its combined output.
effectHoleRejectCheck : String -> String -> String -> <Exec, IO> Option String
effectHoleRejectCheck native name f = match boundedVerb native ["check", f]
  Err e => Some "\{name}: could not spawn native check: \{e}"
  Ok (code, out, err) =>
    let low = toLower (out ++ err)
    if code /= 0 || contains "error" low || contains "effectful" low then
      None
    else
      Some "\{name}: native did not reject (rc=\{intToString code})"

-- # `diff_compiler_typecheck_errors`

typecheckErrorFixturesDir : String
typecheckErrorFixturesDir = "test/typecheck_error_fixtures"

{- | How many fixtures that directory held when this block was written. The
   corpus is scanned rather than listed, and `fixtureFiles`' own floor only
   rules out an EMPTY scan — a corpus that lost fifty fixtures still reports
   nothing. -}
typecheckErrorFixtureCount : Int
typecheckErrorFixtureCount = 156

{- | Fixtures whose documented error depends on the prelude (#11: an integer
   literal desugars to `fromInt`, so the no-prelude driver structurally
   cannot resolve `Num` and would wrongly accept). These run ONLY through
   the prelude-aware driver; every other fixture runs through both. -}
typecheckPreludeDep : List String
typecheckPreludeDep = [
  "impl_head_repeated_var.mdk",
  "deferred_join_noncovariant_settle.mdk",
  "effect_ctor_binder_shadow.mdk",
  "effect_socket_ok.mdk",
  "effect_socket_launder.mdk",
  "effect_socket_forge.mdk",
  "effect_socket_redeclare.mdk",
  "effect_socket_redeclare_ok.mdk",
  "effect_catalog_redeclare_rows.mdk",
  "effect_catalog_redeclare_rows_ok.mdk",
  "effect_data_field_ok.mdk",
  "effect_data_field_launder.mdk",
  "effect_existential_ok.mdk",
  "effect_existential_launder.mdk",
  "effect_phantom_export.mdk",
  "effect_named_authority_scope_launder.mdk",
  "effect_named_authority_scope_ok.mdk",
