  "graded_prelude_head_wrong_kind_flat.mdk",
]

sortedText : String -> String
sortedText s = chompNewlines (unlines (sort (lines (chompNewlines s))))

{- | One driver's grading of one fixture against its golden, given the
   result of its spawn — both sides `LC_ALL=C`-sorted the way the retired
   script's `sort` was, since the single-error fixtures' line order carries no
   meaning. -}
typecheckDriverGrade : String ->
  String ->
  String ->
  Result String (Int, String, String) ->
  Option String
typecheckDriverGrade driver _ _ (Err e) =
  Some "\{driver}: could not spawn: \{e}"
typecheckDriverGrade driver bin want (Ok (code, out, err)) =
  match processFailure (basename bin) driver code err
    Some m => Some m
    None =>
      let got = sortedText (stripUnitAutoPrint out)
      if got == want then None else Some "\{driver}: \{diffNote want got}"

{- | One `typecheck_error_fixtures/*.mdk`'s plan: its golden, sorted, and the
   driver runs it owes as `(prefix, driver, bin, args)` rows, in spawn order.
   Prelude-dependent fixtures run ONLY `check_main` (`typecheckPreludeDep`);
   every other fixture runs `check_main` and `typecheck_main` both. An
   unreadable golden is the plan's `Err`, and spawns nothing. -}
typecheckErrorPlan : String ->
  <FileRead, IO> Result String (String, List (String, String, String, List String))
typecheckErrorPlan path =
  let name = basename path
  let golden = "\{dirname path}/\{stem path}.tc.golden"
  match readFile golden
    Err e => Err "\{name}: no readable golden \{golden}: \{e}"
    Ok raw =>
      let rt = underRoot "stdlib/runtime.mdk"
      let core = underRoot "stdlib/core.mdk"
      let checkBin = underRoot "test/bin/check_main"
      let checkRun = ("check/\{name}", "check", checkBin, [rt, core, path])
      if elem name typecheckPreludeDep then
        Ok (sortedText raw, [checkRun])
      else
        let tcBin = underRoot "test/bin/typecheck_main"
        let tcRun = ("tc_main/\{name}", "tc_main", tcBin, [path])
        Ok (sortedText raw, [checkRun, tcRun])

-- The `(bin, args)` rows a plan spawns, in spawn order.
typecheckPlanRows : Result String (String, List (String, String, String, List String)) ->
  List (String, List String)
typecheckPlanRows (Err _) = []
typecheckPlanRows (Ok (_, runs)) = map ((_, _, bin, args) => (bin, args)) runs

-- Each run of one fixture graded against its share of `results`, in spawn
-- order, a missing result being an `Err` rather than a skipped run.
typecheckRunFailures : (String -> String -> String -> Result String (Int, String, String) -> Option String) ->
  String ->
  List (String, String, String, List String) ->
  List (Result String (Int, String, String)) ->
  List (Option String)
typecheckRunFailures _ _ [] _ = []
typecheckRunFailures grade want ((prefix, driver, bin, _) :: runs) (r :: rs) =
  map (m => "\{prefix}: \{m}") (grade driver bin want r)
    :: typecheckRunFailures grade want runs rs
typecheckRunFailures grade want ((prefix, driver, bin, _) :: runs) [] =
  map
      (m => "\{prefix}: \{m}")
      (grade driver bin want (Err "the batch returned no result"))
    :: typecheckRunFailures grade want runs []

-- The failures of `plans`, in input order, consuming `results` as the rows
-- of `typecheckPlanRows` were spawned. A fixture's runs are graded in spawn
-- order and reported in reverse, `typecheck_main` before `check_main`.
gradeTypecheckPlans : (String -> String -> String -> Result String (Int, String, String) -> Option String) ->
  List (Result String (String, List (String, String, String, List String))) ->
  List (Result String (Int, String, String)) ->
  List String
gradeTypecheckPlans _ [] _ = []
gradeTypecheckPlans grade ((Err e) :: rest) results =
  e :: gradeTypecheckPlans grade rest results
gradeTypecheckPlans grade ((Ok (want, runs)) :: rest) results =
  let (mine, others) = splitAt (length runs) results
  reverse (somes (typecheckRunFailures grade want runs mine))
    ++ gradeTypecheckPlans grade rest others

-- One `testJobs`-wide group of fixtures: every driver run of the group spawns
-- as one batch, then the group is graded in input order.
typecheckErrorGroup : List String -> <Exec, FileRead, IO> List String
typecheckErrorGroup paths =
  let plans = map typecheckErrorPlan paths
  let spawned =
    boundedVerbsSeconds spawnTimeoutSeconds (flatMap typecheckPlanRows plans)
  gradeTypecheckPlans typecheckDriverGrade plans spawned

-- | Every `.mdk` fixture directly under `typecheckErrorFixturesDir`,
-- against its two (or one) drivers, `testJobs` fixtures at a time.
typecheckErrorFailures : <Exec, FileRead, IO> List String
typecheckErrorFailures =
  match fixtureFiles (underRoot typecheckErrorFixturesDir)
    Err e => ["\{typecheckErrorFixturesDir}: \{e}"]
    Ok paths =>
      let fixtures = sort (filter (endsWith ".mdk") paths)
      countFloor typecheckErrorFixturesDir typecheckErrorFixtureCount fixtures
        ++ flatMap typecheckErrorGroup (chunks testJobs fixtures)

-- # `diff_compiler_repl`

replInput : String
replInput = "test/repl_fixtures/session.in"

replGolden : String
replGolden = "test/repl_fixtures/session.golden"

{- | The self-hosted REPL over its committed session transcript, fed on
   STDIN — the one thing `boundedVerb` cannot express directly, so the
   redirection is carried by an `sh -c` wrapper, the same trick
   `probe_runner.spawnIn` uses to set a spawn's working directory. The
   transcript deliberately runs past an unbound-variable line, which exits
   the repl nonzero on this session's last input, so this only bounds the
   exit code to the two values the golden transcript's own scripted errors
   can produce (matching the original script, which never inspected the
   exit code at all) rather than requiring 0 — an escape outside {0, 1}
   (a crash, not a scripted repl error) is still graded a finding, with
   `err` folded into its message. Stdout is graded against the golden. -}
replFailures : <Exec, FileRead, IO> List String
replFailures =
  let bin = underRoot "test/bin/repl_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  let input = underRoot replInput
  let golden = underRoot replGolden
  match (boundedVerb "sh" [
    "-c", "exec \"$1\" \"$2\" \"$3\" < \"$4\"", "sh", bin, rt, core, input
  ])
    Err e => ["could not spawn repl_main: \{e}"]
    Ok (code, out, err) =>
      let codeFail =
        if code == 0 || code == 1 then
          None
        else
          Some "repl: exited unexpectedly: \{intToString code}\{stderrTail err}"
      let got = chompNewlines out
      let transcriptFail = match readFile golden
        Err e => Some "no readable golden \{golden}: \{e}"
        Ok raw =>
          let want = chompNewlines raw
          if want == got then None else Some "repl: \{diffNote want got}"
      let graded = [codeFail, transcriptFail]
      countFloor "repl assertions" 2 graded ++ somes graded

-- # `diff_compiler_analyze_project`

analyzeProjectFixturesDir : String
analyzeProjectFixturesDir = "test/analyze_project_fixtures"

{- | The per-spawn ceiling this probe runs under. It loads and typechecks a
   whole project's import graph per fixture, which is a longer job than the
   single-file probes `test_process.spawnTimeoutSeconds` is sized for. -}
analyzeProjectSeconds : Int
analyzeProjectSeconds = 180

{- | One project diagnostic, as the two sides are compared on it: `key` over
   the (severity, message) pair, and `start` for the side that located it.

   `key` renders severity first and the message after a tab, so sorting keys
   orders exactly as sorting (severity, message) pairs does: a severity is
   one digit, and a tab sorts below every character a message carries. -}
data ProjectDiag = ProjectDiag { key : String, start : Option String }

projectDiagKey : Int -> String -> String
projectDiagKey sev msg = "\{intToString sev}\t\{msg}"

projectDiagStart : Int -> Int -> String
projectDiagStart line col = "\{intToString line}:\{intToString col}"

{- | The one `root_*.mdk` or `main_*.mdk` entry directly under `dir`, or an
   error naming how many were found — the fixture is malformed unless there
   is exactly one, and the probe takes a single entry. -}
analyzeProjectEntry : String -> <FileRead> Result String String
analyzeProjectEntry dir = match fixtureFiles dir
  Err e => Err "\{basename dir}: \{e}"
  Ok paths => match sort (filter (projectEntryFile dir) paths)
    [e] => Ok e
    es =>
      Err
        "\{basename dir}: expected exactly one root_*.mdk or main_*.mdk entry, found \{intToString (length es)}"

projectEntryFile : String -> String -> Bool
projectEntryFile dir p =
  endsWith ".mdk" p
    && dirname p == dir
    && (startsWith "root_" (basename p) || startsWith "main_" (basename p))

{- | An `oracle.json`'s `files` array as (basename, diagnostics) buckets. -}
oracleBuckets : Json -> Result String (List (String, List ProjectDiag))
oracleBuckets j = match map asArray (get "files" j)
  Some (Some arr) => match partitionResults (map oracleBucket (toList arr))
    (e :: _, _) => Err e
    ([], buckets) => Ok buckets
  _ => Err "oracle.json has no \"files\" array"

oracleBucket : Json -> Result String (String, List ProjectDiag)
oracleBucket entry = match map asString (get "file" entry)
  Some (Some path) => match map asArray (get "diagnostics" entry)
    Some (Some arr) => match partitionResults (map oracleDiag (toList arr))
      (e :: _, _) => Err "\{basename path}: \{e}"
      ([], diags) => Ok (basename path, diags)
    _ => Err "\{basename path}: no \"diagnostics\" array"
  _ => Err "a \"files\" entry has no string \"file\""

{- | One diagnostic object of the oracle. A `range` that is PRESENT with the
   value `null` means the same as an absent one: an unlocated diagnostic
   serializes its JSON `range` as `null` rather than leaving it out. -}
oracleDiag : Json -> Result String ProjectDiag
oracleDiag d = match (
  map asInt (get "severity" d),
  map asString (get "message" d),
)
  (Some (Some sev), Some (Some msg)) =>
    Ok ProjectDiag { key = projectDiagKey sev msg, start = oracleStart d }
  _ => Err "a diagnostic has no integer \"severity\" and string \"message\""

oracleStart : Json -> Option String
oracleStart d = match map (get "start") (get "range" d)
  Some (Some s) => match (
    map asInt (get "line" s),
    map asInt (get "character" s),
  )
    (Some (Some line), Some (Some col)) => Some (projectDiagStart line col)
    _ => None
  _ => None

{- | The probe's report as (basename, diagnostics) buckets: a `## FILE <path>`
   line opens a bucket and every non-blank line under it is one diagnostic.
   A line before the first `## FILE` belongs to no bucket and is dropped. -}
reportBuckets : List String -> Result String (List (String, List ProjectDiag))
reportBuckets [] = Ok []
reportBuckets (l :: rest) = match stripPrefix "## FILE " l
  None => reportBuckets rest
  Some path => match span (ln => not (startsWith "## FILE " ln)) rest
    (body, more) =>
      match (partitionResults
        (map reportDiag (filter (ln => trim ln /= "") body)))
        (e :: _, _) => Err "\{basename (trim path)}: \{e}"
        ([], diags) =>
          map ((basename (trim path), diags) :: _) (reportBuckets more)

{- | One `<severity>@<line>:<col>: <message>` or `<severity>: <message>` line
   of the probe's report. An unparsable line is an error, not a dropped
   line: the report's whole shape is this grammar, so a line outside it is a
   claim about the probe, not noise to skip. -}
reportDiag : String -> Result String ProjectDiag
reportDiag l = match reportDiagAs "error" 1 l
  Some d => Ok d
  None => match reportDiagAs "warning" 2 l
    Some d => Ok d
    None => Err "unparsable diagnostic line: \{debug l}"

reportDiagAs : String -> Int -> String -> Option ProjectDiag
reportDiagAs word sev l = match stripPrefix "\{word}@" l
  Some rest => locatedReportDiag sev rest
  None =>
    map
      (msg => ProjectDiag { key = projectDiagKey sev msg, start = None })
      (stripPrefix "\{word}: " l)

locatedReportDiag : Int -> String -> Option ProjectDiag
locatedReportDiag sev rest = match split ":" rest
  lineText :: colText :: msgParts => match (toInt lineText, toInt colText)
    (Some line, Some col) =>
      map
        (msg => ProjectDiag {
          key = projectDiagKey sev msg,
          start = Some (projectDiagStart line col),
        })
        (stripPrefix " " (join ":" msgParts))
    _ => None
  _ => None

{- | The two sides' buckets compared: the FILE SET first, because a per-file
   comparison over disagreeing sets reports every unshared file as an empty
   bucket rather than as the missing file it is. -}
bucketFailures : String ->
  List (String, List ProjectDiag) ->
  List (String, List ProjectDiag) ->
  List String
bucketFailures name want got =
  let wantFiles = sort (map fst want)
  let gotFiles = sort (map fst got)
  if wantFiles /= gotFiles then
    [
      "\{name}: FILE SET mismatch: oracle=\{debug wantFiles} self=\{debug gotFiles}",
    ]
  else
    somes
      (map
        (f => fileDiagFailure name f (bucketOf f want) (bucketOf f got))
        wantFiles)

bucketOf : String -> List (String, List ProjectDiag) -> List ProjectDiag
bucketOf f buckets = match lookup f buckets
  None => []
  Some diags => diags

{- | One file's two buckets: the sorted (severity, message) multiset, then
   the START of every diagnostic the probe located. -}
fileDiagFailure : String ->
  String ->
  List ProjectDiag ->
  List ProjectDiag ->
  Option String
fileDiagFailure name f want got =
  let wantKeys = sort (map (d => d.key) want)
  let gotKeys = sort (map (d => d.key) got)
  if wantKeys /= gotKeys then
    Some
      "\{name}/\{f}: (severity, message) mismatch: oracle=\{debug wantKeys} self=\{debug gotKeys}"
  else match somes (map (startFailure name f want) got)
    [] => None
    m :: _ => Some m

{- | A diagnostic the probe LOCATED must start where an oracle diagnostic
   with the same (severity, message) starts. A diagnostic the probe left
   positionless is not checked here: the resolve layer's own location
   fallback publishes none, which is what the oracle records too. -}
startFailure : String ->
  String ->
  List ProjectDiag ->
  ProjectDiag ->
  Option String
startFailure name f want d = match d.start
  None => None
  Some at =>
    let starts =
      somes (map (w => if w.key == d.key then w.start else None) want)
    if elem at starts then
      None
    else
      Some
        "\{name}/\{f}: START mismatch for \{debug d.key}: self=\{debug at} oracle_starts=\{debug starts}"

{- | Everything wrong with one `analyze_project_fixtures/<name>/` project:
   the probe's per-file diagnostic buckets against the committed
   `oracle.json`'s.

   `oracle.json` is FROZEN — `test/capture_goldens.sh` has no arm for this
   corpus, and one is re-derived by hand from `./medaka check --json` and
   reviewed before being committed. -}
analyzeProjectFixtureFailures : String -> <Exec, FileRead, IO> List String
analyzeProjectFixtureFailures dir =
  let name = basename dir
  match analyzeProjectEntry dir
    Err e => [e]
    Ok entry => match readFile "\{dir}/oracle.json"
      Err e => ["\{name}: no readable oracle.json: \{e}"]
      Ok raw => match parse raw
        Err e => ["\{name}: oracle.json did not parse: \{e}"]
        Ok j => match oracleBuckets j
          Err e => ["\{name}: \{e}"]
          Ok want => analyzeProjectSpawn name dir entry want

analyzeProjectSpawn : String ->
  String ->
  String ->
  List (String, List ProjectDiag) ->
  <Exec, IO> List String
analyzeProjectSpawn name dir entry want =
  let bin = underRoot "test/bin/diagnostics_project_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  match boundedVerbSeconds analyzeProjectSeconds bin [rt, core, entry, dir]
    Err e => ["\{name}: could not spawn diagnostics_project_main: \{e}"]
    Ok (code, out, err) => match processFailure (basename bin) name code err
      Some m => [m]
      None =>
        match reportBuckets (lines (chompNewlines (stripUnitAutoPrint out)))
          Err e => ["\{name}: \{e}"]
          Ok got => bucketFailures name want got

-- # `diff_compiler_test`

{- | The per-spawn ceiling every `test_main` spawn below runs under.

   #1307: a hung shrink loop stalled this family to CI's job ceiling with no
   diagnostic. A bounded spawn turns that into a nonzero exit on the row that
   hung, so the sweep still names the fixture. -}
testReportSeconds : Int
testReportSeconds = 120

{- | The corpus the retired script ran by default: the stdlib modules whose
   doctests and props the self-hosted `test_main` reproduces, plus the
   `compiler_test_fixtures` whose whole report is pinned. Each has a
   committed `<stem>.test.golden` beside it.

   The three `array`/`vector`/`map` entries are #1712: all three had ZERO
   doctests or props running under any gate, which is how
   `Array.concat`/`concatLookup`'s documented O(outer*total) quadratic and
   its empty-inner-array boundary hazard went unobserved. -}
testReportCorpus : List String
testReportCorpus = [
  "stdlib/core.mdk",
  "stdlib/args.mdk",
  "stdlib/json.mdk",
  "stdlib/toml.mdk",
  "stdlib/list.mdk",
  "stdlib/set.mdk",
  "stdlib/string.mdk",
  "stdlib/async.mdk",
  "stdlib/byteparser.mdk",
  "stdlib/bytebuilder.mdk",
  "stdlib/hash_map.mdk",
  "stdlib/hash_set.mdk",
  "stdlib/array.mdk",
  "stdlib/vector.mdk",
  "stdlib/map.mdk",
  "test/compiler_test_fixtures/mixed.mdk",
  "test/compiler_test_fixtures/sum_dict.mdk",
  "test/compiler_test_fixtures/record_prop.mdk",
  "test/compiler_test_fixtures/int_shrink.mdk",
  "test/compiler_test_fixtures/user_arbitrary.mdk",
  "test/compiler_test_fixtures/mappable_not_foldable.mdk",
  "test/compiler_test_fixtures/shadow_impl_tolist.mdk",
  "test/compiler_test_fixtures/blockquote_and_valid.mdk",
  "test/compiler_test_fixtures/doctest_typecheck_gate.mdk",
  "test/compiler_test_fixtures/doctest_import_qualified.mdk",
]

testFixturesDir : String
testFixturesDir = "test/compiler_test_fixtures"

{- | `text` with the tree's own absolute prefix removed and trailing newlines
   chomped — the normalization the retired script's `sed "s#$ROOT/##g"` plus
   `$(…)` did, and what makes a `.test.golden` machine-independent: the
   doctest report embeds the path of every file it ran. -}
testRelative : String -> <IO> String
testRelative text = chompNewlines (replaceAll "\{medakaRoot}/" "" text)

{- | One `test_main` spawn over `rel` with `roots` as its search roots: the
   exit code, and stdout and stderr each path-normalized. -}
testSpawn : String ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
testSpawn rel roots =
  let bin = underRoot "test/bin/test_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  let args = [rt, core, underRoot rel] ++ map underRoot roots
  match boundedVerbSeconds testReportSeconds bin args
    Err e => Err "could not spawn test_main: \{e}"
    Ok (code, out, err) => Ok (code, testRelative out, testRelative err)

{- | One corpus module's report against its committed `.test.golden`.

   The exit code is NOT graded here: three of the fixtures exist to hold a
   FAILING doctest or prop and exit 1 by construction, so the golden is the
   whole claim. Stderr still is — no corpus member writes an `E-PANIC`
   today, and the retired script's `2>/dev/null` could not have said so. -}
testGoldenFailure : String -> <Exec, FileRead, IO> Option String
testGoldenFailure rel =
  let name = basename rel
  match testSpawn rel [dirname rel]
    Err e => Some "\{name}: \{e}"
    Ok (_, out, err) =>
      if contains "E-PANIC" err then
        Some "\{name}: test_main panicked — \{debug err}"
      else
        testGoldenCompare name rel (chompNewlines (stripUnitAutoPrint out))

testGoldenCompare : String -> String -> String -> <FileRead, IO> Option String
testGoldenCompare name rel got =
  let golden = underRoot "\{dirname rel}/\{stem rel}.test.golden"
  match readFile golden
    Err e => Some "\{name}: no readable golden \{golden}: \{e}"
    Ok raw =>
      let want = chompNewlines raw
      if want == got then None else Some "\{name}: \{diffNote want got}"

{- | One fixture asserted on its EXIT CODE alone: `medaka test` must exit
   nonzero exactly when a doctest, prop or `test` declaration failed (P0-6 —
   a printed "N passed, M failed" report used to always exit 0). -}
testExitFailure : String ->
  String ->
  List String ->
  Bool ->
  <Exec, IO> Option String
testExitFailure label rel roots wantZero = match testSpawn rel roots
  Err e => Some "\{label}: \{e}"
  Ok (code, _, _) =>
    if code == 0 == wantZero then
      None
    else
      Some
        "\{label}: exited \{intToString code}, expected \{wantedExit wantZero}"

wantedExit : Bool -> String
wantedExit True = "0"
wantedExit False = "nonzero"

{- | One fixture asserted on its report CONTENT and its exit code: every
   needle in `wanted` present, every needle in `unwanted` absent.

   Content rather than a golden wherever the RIGHT answer and a WRONG one
   both exit nonzero and the wrong one's shape varies — a non-exhaustive
   match for one constructor arity, a dispatch panic for another — so the
   only stable signal is which message was printed, and the ABSENCE half is
   what carries the claim. -}
testContentFailure : String ->
  String ->
  List String ->
  Bool ->
  List String ->
  List String ->
  <Exec, IO> Option String
testContentFailure label rel roots wantZero wanted unwanted =
  testContentResult label wantZero wanted unwanted (testSpawn rel roots)

testContentFailureWithoutMedakaEnv : String ->
  String ->
  List String ->
  Bool ->
  List String ->
  List String ->
  <Exec, IO> Option String
testContentFailureWithoutMedakaEnv label rel roots wantZero wanted unwanted =
  let bin = underRoot "test/bin/test_main"
  let rt = underRoot "stdlib/runtime.mdk"
  let core = underRoot "stdlib/core.mdk"
  let args =
    ["-u", "MEDAKA", "-u", "MEDAKA_ROOT", bin, rt, core, underRoot rel]
      ++ map underRoot roots
  let spawned = match boundedVerbSeconds testReportSeconds "env" args
    Err e => Err "could not spawn environment-clean test_main: \{e}"
    Ok (code, out, err) => Ok (code, testRelative out, testRelative err)
  testContentResult label wantZero wanted unwanted spawned

testContentResult : String ->
  Bool ->
  List String ->
  List String ->
  Result String (Int, String, String) ->
  Option String
testContentResult label _ _ _ (Err e) = Some "\{label}: \{e}"
testContentResult label wantZero wanted unwanted (Ok (code, out, err)) =
  let text = "\{out}\n\{err}"
  let missing = filter (n => not (contains n text)) wanted
  let present = filter (n => contains n text) unwanted
  if code == 0 /= wantZero then
    Some "\{label}: exited \{intToString code}, expected \{wantedExit wantZero}"
  else if missing /= [] then
    Some "\{label}: report is missing \{debug missing}"
  else if present /= [] then
    Some "\{label}: report contains \{debug present}"
  else
    None

{- | One fixture whose WHOLE report is pinned inline rather than as a
   capturable golden, because capturing at the buggy base would have
   enshrined the wrong answer: the expected text is derived from the
   fixture's own semantics. -}
testReportFailure : String ->
  String ->
  List String ->
  String ->
  <Exec, IO> Option String
testReportFailure label rel roots want = match testSpawn rel roots
  Err e => Some "\{label}: \{e}"
  Ok (_, out, _) =>
    if want == out then None else Some "\{label}: \{diffNote want out}"

{- | Phase 127's `test "…" = <Expectation>` runner: discovery, evaluation,
   the per-test ok/FAIL report, and the summary.

   Derived from the fixture rather than captured: it declares four tests at
   lines 8, 9, 10 and 16, of which `expectEqual 1 2` and `fail "boom"` fail
   with those two detail lines, and the surrounding `running`/verdict/summary
   protocol is the one `hashNegativeHashReport` below already pins. -}
testDeclsReport : String
testDeclsReport = join "\n" [
  "running doctests in test/compiler_test_fixtures/test_decls.mdk",
  "  (no doctests found)",
  "  running test/compiler_test_fixtures/test_decls.mdk:8: passing assertion [eval]",
  "  ok   test/compiler_test_fixtures/test_decls.mdk:8: passing assertion [eval]",
  "  running test/compiler_test_fixtures/test_decls.mdk:9: failing assertion [eval]",
  "  FAIL test/compiler_test_fixtures/test_decls.mdk:9: failing assertion [eval]",
  "       expected 1 but got 2",
  "  running test/compiler_test_fixtures/test_decls.mdk:10: explicit fail [eval]",
  "  FAIL test/compiler_test_fixtures/test_decls.mdk:10: explicit fail [eval]",
  "       boom",
  "  running test/compiler_test_fixtures/test_decls.mdk:16: block body [eval]",
  "  ok   test/compiler_test_fixtures/test_decls.mdk:16: block body [eval]",
  "",
  "test/compiler_test_fixtures/test_decls.mdk: 2/4 passed (2 failed, 0 errors, 0 known-red)",
]

{- | #416 (S1): a NEGATIVE hash from a contract-compliant `Hashable` impl —
   the contract requires eq-agreement only, not non-negativity — reached a
   negative bucket index and an out-of-bounds `arrayGetUnsafe` in
   `hash_map`/`hash_set`'s `slotOf`. This is the EVAL-side guard; the native
   one is `test/build_diff_fixtures/hash_negative_hash.mdk`. -}
hashNegativeHashReport : String
hashNegativeHashReport = join "\n" [
  "running doctests in test/compiler_test_fixtures/hash_negative_hash.mdk",
  "  (no doctests found)",
  "  running test/compiler_test_fixtures/hash_negative_hash.mdk:32: hash_map: negative hash finds its key (#416) [eval]",
  "  ok   test/compiler_test_fixtures/hash_negative_hash.mdk:32: hash_map: negative hash finds its key (#416) [eval]",
  "  running test/compiler_test_fixtures/hash_negative_hash.mdk:35: hash_set: negative hash finds its element (#416) [eval]",
  "  ok   test/compiler_test_fixtures/hash_negative_hash.mdk:35: hash_set: negative hash finds its element (#416) [eval]",
  "  running test/compiler_test_fixtures/hash_negative_hash.mdk:38: hash_map: intMinBound hash (#416) [eval]",
  "  ok   test/compiler_test_fixtures/hash_negative_hash.mdk:38: hash_map: intMinBound hash (#416) [eval]",
  "  running test/compiler_test_fixtures/hash_negative_hash.mdk:40: hash_set: intMinBound hash (#416) [eval]",
  "  ok   test/compiler_test_fixtures/hash_negative_hash.mdk:40: hash_set: intMinBound hash (#416) [eval]",
  "",
  "test/compiler_test_fixtures/hash_negative_hash.mdk: 4/4 passed",
]

{- | #1292 (S0): `eval.runtimeTypeTag` tagged a `VCon` by its BARE
   constructor name through the program-global `ctorToTypeRef`, so two
   modules declaring a same-named constructor collapsed to one entry and
   every value of the loser's type dispatched to the winner's impl, silently,
   at exit 0.

   This grades the THIRD driver, `evalModulesRootEnvFacts` — the one the
   `test` phase, the prop runner and the repl use, where `evalModulesWith`
   serves doctests only; a fix wired into the other two module drivers alone
   passes every other check in this tree. It also pins the `Pass`/`Fail`
   exemption: `tools/test_runner.mdk` matches a test body's result as a bare
   `VCon "Pass" []` / `VCon "Fail" [_]`, so renaming those would report all
   three cases as ERROR instead of ok. -}
ctorCollisionReport : String
ctorCollisionReport = join "\n" [
  "running doctests in test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk",
  "  (no doctests found)",
  "  running test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:25: amod's own Box tags TA [eval]",
  "  ok   test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:25: amod's own Box tags TA [eval]",
  "  running test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:27: the imported bmod Box tags TB [eval]",
  "  ok   test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:27: the imported bmod Box tags TB [eval]",
  "  running test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:30: a Pass/Fail collision does not break the test runner [eval]",
  "  ok   test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk:30: a Pass/Fail collision does not break the test runner [eval]",
  "",
  "test/compiler_test_fixtures/ctor_collision_test_seam/main.mdk: 3/3 passed",
]

{- | #2820's four entries, and they are a SET: an alias-qualified name is a
   parse error in type position, so one file can name only one of the two
   `Color`s, and a fix that always takes the first candidate passes `main_a`
   and fails `main_b`. The `2` entries vary the second, independent axis —
   which type the prop is over and which order the two modules were imported
   in are separate questions, and the candidate list under the shared route
   word is built in load order, so a fix keyed on position rather than on the
   resolved type's own identity splits the `main_a`/`main_a2` pair. -}
twoModuleCollisionEntries : List (String, String)
twoModuleCollisionEntries = [
  ("main_a", "a's own Arbitrary instance is what a's Color draws from"),
  ("main_b", "b's own Arbitrary instance is what b's Color draws from"),
  ("main_a2", "a's own Arbitrary instance is what a's Color draws from"),
  ("main_b2", "b's own Arbitrary instance is what b's Color draws from"),
]

twoModuleCollisionFailure : (String, String) -> <Exec, IO> Option String
twoModuleCollisionFailure (entry, want) =
  let dir = "\{testFixturesDir}/arbitrary_two_module_collision"
  testContentFailure
    "arbitrary_two_module_collision/\{entry}.mdk"
    "\{dir}/\{entry}.mdk"
    [dir]
    True
    ["Testing \{debug want} [eval] ... OK (100 tests passed)"]
    []

{- | Directory testing runs each file in a fresh child process. An explicit
   prop seed must follow that boundary: otherwise the parent accepts `--seed`
   but every child silently reverts to the default stream, so the failure's
   advertised replay command does not replay the directory run. Compare each
   direct-file and directory report, then confirm two requested seeds produce
   distinct reports without pinning an RNG draw or a shrink result. -}
seedDirectoryReport : Int -> String -> String -> <Exec, IO> Result String String
seedDirectoryReport seed file dir =
  let args target =
    ["test", "--engines", "eval", "--seed", intToString seed, target]
  match (
    boundedVerbSeconds testReportSeconds medakaBin (args file),
    boundedVerbSeconds testReportSeconds medakaBin (args dir),
  )
    (Ok (directCode, directOut, directErr), Ok (dirCode, dirOut, dirErr)) =>
      let directText = testRelative "\{directOut}\n\{directErr}"
      let directProp = seedDirectoryPropertyLine directText
      let dirProp =
        seedDirectoryPropertyLine (testRelative "\{dirOut}\n\{dirErr}")
      if directCode == 0 || dirCode == 0 then
        Err
          "seed directory replay: the deliberately failing property unexpectedly exited 0"
      else if directProp == "" || dirProp == "" then
        Err "seed directory replay: missing the property result"
      else if directProp /= dirProp then
        Err
          "seed directory replay: direct and directory property results differ: \{diffNote directProp dirProp}"
      else if not (contains "FAILED" directProp) then
        Err "seed directory replay: expected a failing property result"
      else if not (contains "Seed: \{intToString seed}; Cases: 100" directText)
        || not (contains "Seed: \{intToString seed}; Cases: 100" dirOut) then
        Err "seed directory replay: missing the requested seed and case budget"
      else
        Ok directProp
    (Err e, _) =>
      Err "seed directory replay: direct invocation failed to start: \{e}"
    (_, Err e) =>
      Err "seed directory replay: directory invocation failed to start: \{e}"

seedDirectoryPropertyLine : String -> String
seedDirectoryPropertyLine text =
  join "\n" (filter (contains "Testing \"seed directory replay\"") (lines text))

seedDirectoryReplayFailure : <Exec, IO> Option String
seedDirectoryReplayFailure =
  let dir = underRoot "test/compiler_test_fixtures/seed_directory_replay"
  let file = "\{dir}/case.mdk"
  match (seedDirectoryReport 1 file dir, seedDirectoryReport 2 file dir)
    (Ok seed1, Ok seed2) =>
      if seed1 == seed2 then
        Some
          "seed directory replay: --seed 1 and --seed 2 produced the same report"
      else
        None
    (Err e, _) => Some e
    (_, Err e) => Some e

{- | The regression battery the retired script ran UNCONDITIONALLY beside its
   corpus loop: fixtures whose claim is an exit code, a whole hand-derived
   report, or the presence and ABSENCE of a specific message, none of which a
   per-fixture golden diff can carry. -}
testBatteryFailures : <Exec, IO> List String
testBatteryFailures =
  let fix = testFixturesDir
  let stdlib = "stdlib"
  let battery = [
    testExitFailure "mixed.mdk exit code" "\{fix}/mixed.mdk" [fix] False,
    testExitFailure "list.mdk exit code" "stdlib/list.mdk" [stdlib] True,
    testExitFailure
      "doctest_typecheck_gate.mdk exit code (#260)"
      "\{fix}/doctest_typecheck_gate.mdk"
      [fix]
      False,
    testExitFailure
      "test_decls.mdk exit code"
      "\{fix}/test_decls.mdk"
      [fix, stdlib]
      False,
    testReportFailure
      "test_decls.mdk (test-decl runner)"
      "\{fix}/test_decls.mdk"
      [fix, stdlib]
      testDeclsReport,
    testReportFailure
      "hash_negative_hash.mdk (#416)"
      "\{fix}/hash_negative_hash.mdk"
      [fix, stdlib]
      hashNegativeHashReport,
    testReportFailure
      "ctor_collision_test_seam/main.mdk (#1292)"
      "\{fix}/ctor_collision_test_seam/main.mdk"
      ["\{fix}/ctor_collision_test_seam", stdlib]
      ctorCollisionReport,
    testContentFailure
      "arbitrary_name_collision"
      "\{fix}/arbitrary_name_collision/main.mdk"
      ["\{fix}/arbitrary_name_collision", stdlib]
      True
      ["Testing \"payload is an Int, always\" [eval] ... OK (100 tests passed)"]
      [],
    testContentFailure
      "arbitrary_constrained_instance (#2813)"
      "\{fix}/arbitrary_constrained_instance.mdk"
      [fix]
      True
      [
        "Testing \"constrained instance is reported, not ignored\" [eval] ... OK (100 tests passed)",
      ]
      [],
    testContentFailure
      "shrink_not_called (#2812)"
      "\{fix}/shrink_not_called.mdk"
      [fix]
      False
      ["counterexample: w = Wrap(0)"]
      [],
    seedDirectoryReplayFailure,
    testContentFailure
      "parse_error.mdk (#892)"
      "\{fix}/parse_error.mdk"
      [fix]
      False
      ["test/compiler_test_fixtures/parse_error.mdk:1:0:"]
      ["E-PANIC"],
  ]
  countFloor "test-battery cases" 12 battery
    ++ countFloor "two-module collision entries" 4 twoModuleCollisionEntries
    ++ somes battery
    ++ somes (map twoModuleCollisionFailure twoModuleCollisionEntries)

{- | `test_main` launches evaluator properties in a child process. These are
   deliberately nongolden controls: a stale launcher can make a whole corpus
   look capture-ready while neither a passing nor a failing law actually ran.
   The passing fixture reaches custom generators at both its root and nested
   field, while the false law independently retains a minimized witness. -}
evalPropertyWorkerFailures : <Exec, IO> List String
evalPropertyWorkerFailures = somes [
  testContentFailureWithoutMedakaEnv
    "eval property worker: passing custom laws"
    "\{testFixturesDir}/user_arbitrary.mdk"
    [testFixturesDir]
    True
    [
      "Testing \"user generator is honored\" [eval] ... OK (100 tests passed)",
      "Testing \"user generator is honored at a nested field\" [eval] ... OK (100 tests passed)",
    ]
    ["interpreter property worker batch aborted"],
  testContentFailureWithoutMedakaEnv
    "eval property worker: false law reports minimized witness"
    "\{testFixturesDir}/int_shrink.mdk"
    [testFixturesDir]
    False
    [
      "Testing \"int_shrink: deliberately false over Int (#1307)\" [eval] ... FAILED (line 20: failed after 1 test; counterexample: a = 0)",
    ]
    ["interpreter property worker batch aborted"],
]

{- | The words of the shell statement in `capture_goldens.sh` that starts at
   the first line containing `marker` and runs through its backslash
   continuations, with quotes, `;` and continuation backslashes dropped. -}
shStatementWords : List String -> String -> List String
shStatementWords ls marker =
  let from = dropWhile (l => not (contains marker l)) ls
  let (cont, rest) = span (endsWith "\\") from
  let stmt = join " " (cont ++ take 1 rest)
  filter
    (/= "")
    (split
      " "
      (replaceAll "\\" " " (replaceAll ";" " " (replaceAll "\"" "" stmt))))

{- | Disagreement between a corpus list in this module and the list the
   matching `capture_goldens.sh --frozen` arm iterates: the golden the arm
   writes and the golden the gate grades must describe the same corpus. -}
corpusAgreement : String -> List String -> List String -> List String
corpusAgreement what here script =
  map
      (n => "\{what}: \{n} is in capture_goldens.sh but not in this module")
      (filter (n => not (elem n here)) script)
    ++ map
      (n => "\{what}: \{n} is in this module but not in capture_goldens.sh")
      (filter (n => not (elem n script)) here)

captureCorpusFailures : List String
captureCorpusFailures = match readFile (underRoot "test/capture_goldens.sh")
  Err e => ["test/capture_goldens.sh: \{e}"]
  Ok raw =>
    let ls = lines raw
    let rootPaths =
      marker => somes (map (stripPrefix "$ROOT/") (shStatementWords ls marker))
    corpusAgreement
        "lextok arm vs lexCorpus"
        lexCorpus
        (rootPaths "regen_frozen lex_main lextok.golden")
      ++ corpusAgreement
        "test arm vs testReportCorpus"
        testReportCorpus
        (rootPaths "for f in \"$ROOT\"/stdlib/core.mdk")
      ++ corpusAgreement
        "references_correctness arm vs referencesFixtures"
        referencesFixtures
        (filter
          (w => not (elem w ["for", "name", "in", "do"]))
          (shStatementWords ls "for name in binder_loc"))

test "capture_goldens.sh iterates the same corpora this module grades" =
  report "capture-corpus" captureCorpusFailures

test "reference-index dumps match binders, not strings" =
  report
    "references-correctness"
    (countFloor "references_fixtures" 12 referencesFixtures
      ++ somes (map referencesFixtureFailure referencesFixtures))

test "the parameterized effect surface typechecks through the real front-end" =
  report "effect-param" effectParamFailures

test "the inferred-hole effect surface typechecks through the real front-end" =
  report "effect-hole" effectHoleFailures

test "typecheck-error fixtures agree with their driver(s)' committed golden" =
  report "typecheck-errors" typecheckErrorFailures

test "the self-hosted repl reproduces its committed session transcript" =
  report "repl" replFailures

test "project-wide diagnostics bucket per file the way the oracle does" = report
  "analyze-project"
  (match fixtureDirs (underRoot analyzeProjectFixturesDir)
    Err e => ["\{analyzeProjectFixturesDir}: \{e}"]
    Ok dirs =>
      countFloor analyzeProjectFixturesDir 39 dirs
        ++ fold
          (acc d => acc ++ analyzeProjectFixtureFailures d)
          []
          (sort dirs))

test "`medaka test`'s corpus reproduces its committed reports" =
  report
    "test-report"
    (countFloor "test-report corpus" 25 testReportCorpus
      ++ somes (map testGoldenFailure testReportCorpus))

test "`medaka test`'s exit code and its pinned reports still discriminate" =
  report "test-battery" testBatteryFailures

test "the standalone evaluator property worker runs laws before reports are captured" =
  report "eval-property-worker" evalPropertyWorkerFailures
