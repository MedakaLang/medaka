-- #3512: a flip cycle through four types.  `T4`'s parameter occurs
-- contravariantly (`y -> Unit`) and, through `T1 .. T3`, under a second
-- flip, so it is invariant, and so is every wrapper's slot above it.
public export data T0 x = T0 (T1 (x -> Unit))

public export data T1 x = T1 (T2 x)

public export data T2 x = T2 (T3 x)

public export data T3 x = T3 (T4 x)

public export data T4 y = TA (y -> Unit) | TB (T1 (y -> Unit))
