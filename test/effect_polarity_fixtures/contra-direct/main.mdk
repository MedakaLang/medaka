-- CONTRAVARIANT-IMMUTABLE x DIRECT wrapper shape. Reused verbatim from
-- test/must_fail_fixtures/1121-contravariant-domain-widening-launders/main.mdk
-- (the seed shape named in the packet's §4 fact 5). `Taker a = MkTaker (a ->
-- Int)` puts `a` in the DOMAIN of the stored function, so `Taker` is
-- CONTRAVARIANT in `a`. Widening `Taker (Unit -> Unit)` to `Taker (Unit ->
-- <IO> Unit)` is accepted, yet that is the UNSAFE direction for a
-- contravariant occurrence: no `Ref`, no mutation anywhere -- the
-- unsoundness is pure contravariance, made observable by applying the
-- (actually-effectful) argument through the widened type. EFFECTS-SEMANTICS
-- .md §9: polarity is not knowable without a variance analysis Medaka does
-- not have, so no direction of weakening is sound in general.
-- EXPECTED-RED until slice 4 (D-2, #1119).
data Taker a = MkTaker (a -> Int)

runTaker : Taker a -> a -> Int
runTaker (MkTaker g) x = g x

pureTaker : Taker (Unit -> Unit)
pureTaker = MkTaker (k => let _ = k () in 1)

wide : Taker (Unit -> <IO> Unit)
wide = pureTaker

shout : Unit -> <IO> Unit
shout _ = println "LAUNDERED"

main = println (runTaker wide shout)
