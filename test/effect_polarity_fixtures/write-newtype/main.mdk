-- WRITE-CHANNEL x NEWTYPE wrapper shape. One positional single-constructor
-- wrapper (`Cell`) sits between the parametric widening and the `Ref` that
-- provides the write channel. Same mechanism as write-direct (substMonoP's
-- `TApp` arm propagates `pos` unchanged through `Cell`'s own type parameter,
-- per packet §4 fact 2), just one constructor of indirection further out.
-- EFFECTS-SEMANTICS.md §9: polarity is not knowable without a variance
-- analysis Medaka does not have, and this datatype's parameter is used
-- inside a write-capable `Ref`, so it needs INVARIANCE, not the covariant
-- treatment it gets today. EXPECTED-RED until slice 4 (D-2, #1119).
data Cell a = MkCell (Ref a)

shout : Unit -> <Stdout> Unit
shout u =
  let _ = putStr "SMUGGLED "
  ()

pureFn : Unit -> Unit
pureFn u = ()

box : Cell (Unit -> <> Unit)
box = MkCell (Ref pureFn)

alias : Cell (Unit -> <Stdout> Unit)
alias = box

writeIntoAlias : Unit -> Unit
writeIntoAlias u = match alias
  MkCell r => r := shout

callBox : Unit -> Unit
callBox u = match box
  MkCell r => r.value ()

main =
  let _ = writeIntoAlias ()
  println (callBox ())
