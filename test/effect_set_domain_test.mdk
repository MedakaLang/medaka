{- | Gate for the Set refinement domain (set-shaped authority).

   Covers four properties of `./medaka check` over
   `test/effect_set_fixtures`:

   - a `<Foo {"a", "b"}>` annotation parses and typechecks,
   - a body row that is a subset of the declared bound is accepted,
   - a body row that is not a subset is rejected, naming the row it found,
   - a union past `setCardCap` saturates to the top row `<Foo>`, which
     accepts a top-bounded body and rejects a `<Foo>`-performing one.

   There is no differential oracle: the frozen OCaml reference compiler
   does not parse `<Foo {"a", "b"}>`, so the native `check` is the sole
   arm. Every assertion is therefore a property of the diagnostic text,
   not an agreement between two engines. -}

import compiler_cli_test_support.{
  expectCheckAccept,
  expectCheckReject,
  fixtureIn,
}

-- Fixtures are located through MEDAKA_ROOT rather than the working
-- directory: `medaka gate run` exports it and inherits whatever cwd the
-- caller had.
fixture : String -> <IO> String
fixture name = fixtureIn "test/effect_set_fixtures" name

test "a set-shaped row annotation parses and typechecks" =
  expectCheckAccept (fixture "set_p4_parse_accept.mdk")

test "a body row inside the declared bound is accepted" =
  expectCheckAccept (fixture "set_subset_accept.mdk")

test "a body row outside the declared bound is rejected, naming the row" = expectCheckReject
  (fixture "set_subset_reject.mdk")
  ["performs <FFI, Foo {\"a\", \"b\"}>"]

test "a union past the cardinality cap saturates to the top row" =
  expectCheckAccept (fixture "set_cap_saturate.mdk")

test "a saturated bound still rejects a body performing the top row" = expectCheckReject
  (fixture "set_cap_saturate_ctrl.mdk")
  ["performs <FFI, Foo>"]
