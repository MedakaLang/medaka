-- ENV named-argument ⊆ ACCEPT.  `getEnv : (name : String) -> <Env name> …`
-- binds its Env authority to its argument; at the call site that argument is
-- the literal "HOME", so the DOMAIN-DIRECTED atom is the singleton authority
-- set <Env {"HOME"}> (Set domain, not a Prefix pattern).  Declared bound is the
-- SUPERSET {"HOME","PATH"} ⇒ {"HOME"} ⊆ {"HOME","PATH"} ⇒ ACCEPT.
-- Env is the builtin Set-domain label; a local declaration would be another label

extern getEnv : (name : String) -> <Env name> Option String

readHome : Unit -> <Env {"HOME", "PATH"}, FFI> Option String
readHome _ = getEnv "HOME"

main : <IO> Unit
main = println "env hole-fill accept"
