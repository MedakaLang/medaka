-- EXEC named-argument ⊑ ACCEPT.  `runCommand : (program : String) ->
-- List String -> <Exec program> …` binds its Exec authority to argv0; at the
-- call site that argument is the literal "/usr/bin/ls", so the atom is the
-- Prefix pattern <Exec "/usr/bin/ls"> (Prefix domain).  Declared bound
-- <Exec "/usr/bin/*"> (a prefix pattern) ADMITS "/usr/bin/ls" ⇒ ACCEPT.
-- Exec is the builtin Prefix-domain label; a local declaration would be another label

extern runCommand : (program : String) -> List String -> <Exec program> Result String (Int, String, String)

runLs : Unit -> <Exec "/usr/bin/*", FFI> Result String (Int, String, String)
runLs _ = runCommand "/usr/bin/ls" []

main : <IO> Unit
main = println "exec hole-fill accept"
