-- ENV named-argument ⊄ REJECT.  `getEnv`'s Env authority is its argument, the
-- literal "HOME", so the body performs <Env {"HOME"}>; the declared bound
-- {"PATH"} does NOT contain HOME ⇒ {"HOME"} ⊄ {"PATH"} ⇒ a TYPE ERROR.
-- Env is the builtin Set-domain label; a local declaration would be another label

extern getEnv : (name : String) -> <Env name> Option String

readHome : Unit -> <Env {"PATH"}> Option String
readHome _ = getEnv "HOME"

main : <IO> Unit
main = println "should not typecheck"
