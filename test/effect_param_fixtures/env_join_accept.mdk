-- ENV multi-call djoin ∪.  Two `getEnv` calls with DIFFERENT literal arguments
-- each bind a singleton (<Env {"A"}>, <Env {"B"}>); the row join is the set
-- UNION <Env {"A","B"}> (proves djoin = ∪ for the Set domain).  Declared at the
-- union ⇒ ACCEPT.
-- Env is the builtin Set-domain label; a local declaration would be another label

extern getEnv : (name : String) -> <Env name> Option String

both : Unit -> <Env {"A", "B"}, FFI> (Option String, Option String)
both _ = (getEnv "A", getEnv "B")

main : <IO> Unit
main = println "env join accept"
