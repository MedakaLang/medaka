-- Defined names (column-0, first word not a declaration keyword): an
-- identifier `[a-z_][A-Za-z0-9_']*` or a parenthesised operator.
definedName : String -> Option String
definedName l =
  let w = match words l
    [] => ""
    x :: _ => x
  if not (isColZero l) || elem w declKeywordsAndLayout then
    None
  else
    nameAtStart l

declKeywordsAndLayout : List String
declKeywordsAndLayout = declKeywords ++ ["else", "then", "in"]

declKeywords : List String
declKeywords = [
  "import", "data", "type", "interface", "impl", "export", "public", "test",
  "prop"
]

nameAtStart : String -> Option String
nameAtStart l = match toList (toChars l)
  c :: _ if c >= 'a' && c <= 'z' || c == '_' =>
    Some (fromChars (takeWhile identChar (toList (toChars l))))
  '(' :: more =>
    let op = takeWhile (x => x /= ')' && not (isSpace x)) more
    match dropWhile (x => x /= ')' && not (isSpace x)) more
      ')' :: _ if length op > 0 => Some (fromChars op)
      _ => None
  _ => None

identChar : Char -> Bool
identChar c = isAlphaNum c || c == '_' || c == '\''

namesOf : List (String, List String) -> String -> S.Set String
namesOf mods m = match filter (p => fst p == m) mods
  [] => S.fromList []
  (_, ls) :: _ => S.fromList (filterMap definedName ls)

-- The `llvm_emit` names with a `wasm_emit` twin under any of four conventions:
-- same name, `n+"W"` when `n` is not in wasm, `n+"Ref"`, `"wasm"+Capitalized(n)`.
twinNames : List (String, List String) -> List String
twinNames mods =
  let ll = namesOf mods "backend.llvm_emit"
  let ww = namesOf mods "backend.wasm_emit"
  sort
    (filter
      (n =>
        S.has n ww
          || S.has (n ++ "W") ww
          || S.has (n ++ "Ref") ww
          || S.has ("wasm" ++ capitalize n) ww)
      (toList ll))

startsWithSpace : String -> Bool
startsWithSpace s = match toList (toChars s)
  c :: _ => isSpace c
  [] => False

-- Drop the words of `ws` in order, each followed by whitespace.
dropWords : List String -> String -> Option String
dropWords [] s = Some s
dropWords (w :: ws) s = match stripPrefix w s
  Some r if startsWithSpace r => dropWords ws (trimLeft r)
  _ => None

-- `KW X` with `X` an upper-case word, after one of the optional prefixes.
kindWord : String -> List (List String) -> String -> Option String
kindWord kw prefixes l = firstSome (map (p => kindAfter kw p l) prefixes)

firstSome : List (Option a) -> Option a
firstSome [] = None
firstSome ((Some x) :: _) = Some x
firstSome (None :: rest) = firstSome rest

kindAfter : String -> List String -> String -> Option String
kindAfter kw prefix l = match dropWords prefix l
  None => None
  Some r => match stripPrefix kw r
    Some rest if startsWithSpace rest => match toList (toChars (trimLeft rest))
      c :: more if c >= 'A' && c <= 'Z' =>
        Some "\{kw} \{fromChars (c :: takeWhile identChar more)}"
      _ => None
    _ => None

dataOrTypeName : String -> Option String
dataOrTypeName l =
  match kindWord "data" [["public", "export"], ["export"], []] l
    Some k => Some k
    None => kindWord "type" [["export"], []] l

-- Declaration kind of a column-0 line: `Some kind` opens an extent.
startKind : String -> Option String
startKind l =
  if not (isColZero l) then
    None
  else
    let ws = words l
    let w = match ws
      [] => ""
      x :: _ => x
    let second = match ws
      _ :: y :: _ => y
      _ => ""
    if ws == ["}"] || ws == ["]"] || ws == [")"] then
      None
    else if any (c => startsWith c l) ["}", "]", ")", "|", ","]
      || ws == ["export"] then
      None
    else match dataOrTypeName l
      Some k => Some k
      None => match importOf l
        Some _ => Some "<import>"
        None =>
          if w == "else" || w == "then" || w == "in" then
            None
          else if w == "test" || w == "prop" then
            Some "<\{w}>"
          else if elem w declKeywords then
            Some "\{w} \{second}"
          else
            nameAtStart l

-- One declaration extent: name, whether a `rule-duplicate-body` directive sits
-- directly above its first line, and its lines in reverse.
type Seg = (String, Bool, List String)

segmentLines : List String -> List Seg
segmentLines ls = segFinish (segGo ls "" [] None)

segGo : List String ->
  String ->
  List Seg ->
  Option Seg ->
  (List Seg, Option Seg)
segGo [] _ done cur = (done, cur)
segGo (l :: rest) prev done cur = match startKind l
  None => match cur
    None => segGo rest l done None
    Some (n, d, acc) => segGo rest l done (Some (n, d, l :: acc))
  Some n =>
    let flag = startsWith "-- lint-disable-next-line rule-duplicate-body" prev
    match cur
      Some (cn, cd, acc) if cn == n && not (startsWith "<" n) =>
        segGo rest l done (Some (cn, cd || flag, l :: acc))
      Some c => segGo rest l (c :: done) (Some (n, flag, [l]))
      None => segGo rest l done (Some (n, flag, [l]))

segFinish : (List Seg, Option Seg) -> List Seg
segFinish (done, cur) = match cur
  None => reverse done
  Some c => reverse (c :: done)

isCommentLine : String -> Bool
isCommentLine l = startsWith "--" (trimLeft l)

-- Whitespace- and comment-normalized body of an extent; trailing blank and
-- comment lines are not part of it.
segBody : List String -> String
segBody revLines =
  let kept =
    reverse (dropWhile (l => trimLeft l == "" || isCommentLine l) revLines)
  join " " (flatMap words (filter (l => not (isCommentLine l)) kept))

-- name -> (body, exempt); several extents of one name are joined with a newline.
moduleBodies : List String -> M.Map String (String, Bool)
moduleBodies ls =
  let fileExempt =
    any (startsWith "-- lint-disable-file rule-duplicate-body") ls
  fold
    (acc (n, d, rev) =>
      let b = segBody rev
      match M.get n acc
        None => M.set n (b, d || fileExempt) acc
        Some (ob, od) => M.set n ("\{ob}\n\{b}", od || d || fileExempt) acc)
    (M.fromList [])
    (segmentLines ls)

outputAfterRenderer : String -> String -> String -> <IO> Expectation
outputAfterRenderer moduleName functionName output =
  let source = optionOr [] (lookup moduleName loadModules)
  match M.get functionName (moduleBodies source)
    None => fail "missing \{moduleName}.\{functionName}"
    Some (body, _) => match (
      indexOf "let wat = emitProgram input plan reached" body,
      indexOf output body,
    )
      (Some renderer, Some marker) => expectLessThan marker renderer
      _ => fail "missing renderer or \{output} in \{moduleName}.\{functionName}"

test "arch_boundaries: public Wasm compositions validate before markers and stats" = expectEach
  [
    (
      "playground WAT marker",
      outputAfterRenderer
        "entries.playground_main"
        "runEmit"
        "emitWatMarker warnTriples",
    ),
    (
      "modules stats",
      outputAfterRenderer
        "entries.wasm_emit_modules_main"
        "emitTail"
        "if statsEnabled ()",
    ),
  ]

type DefRow = (String, String, Bool)

-- name -> (module, body, exempt) over non-test, non-`entries/` modules.
definitionIndex : List (String, List String) -> M.Map String (List DefRow)
definitionIndex mods =
  fold
    (acc (m, ls) =>
      fold
        (a (n, (b, d)) =>
          if startsWith "<" n
            || startsWith "data " n
            || startsWith "type " n then
            a
          else match M.get n a
            None => M.set n [(m, b, d)] a
            Some rows => M.set n ((m, b, d) :: rows) a)
        acc
        (M.entries (moduleBodies ls)))
    (M.fromList [])
    (filter (p => not (startsWith "entries." (fst p))) mods)

-- Names whose most common body, among non-exempt definitions in two or more
-- modules, occurs at least twice.
identicalNames : M.Map String (List DefRow) -> List String
identicalNames idx =
  sort
    (filterMap
      ((n, rows) =>
        let live = filter (r => not (rowExempt r)) rows
        if length live >= 2 && topCount (map rowBody live) >= 2 then
          Some n
        else
          None)
      (M.entries idx))

rowExempt : DefRow -> Bool
rowExempt (_, _, e) = e

rowBody : DefRow -> String
rowBody (_, b, _) = b

topCount : List String -> Int
topCount bodies =
  let counts =
    fold
      (acc b => M.set b (M.findWithDefault 0 b acc + 1) acc)
      (M.fromList [])
      bodies
  fold max 0 (M.values counts)

test "arch_boundaries: llvm/wasm twins match twins.golden" =
  pin "twins.golden" (twinNames loadModules)

test "arch_boundaries: global order has one shared authority" =
  let forbidden = [
    "orderedValBinds", "topoSortValBinds", "topoValGo", "topoValVisit",
    "topoValVisitDeps"
  ]
  let names =
    toList (namesOf loadModules "backend.llvm_emit")
      ++ toList (namesOf loadModules "backend.wasm_emit")
  expectEqual [] (filter (n => S.has n (S.fromList names)) forbidden)

test "arch_boundaries: identical-body names match dupbodies.golden" =
  let idx = definitionIndex loadModules
  -- The count of names defined in two or more modules is information only and
  -- not pinned; no passing-test channel surfaces it, so compute
  -- `length (filter (rows => length rows >= 2) (M.values idx))` in a scratch
  -- `println` when the number is wanted.
  pin "dupbodies.golden" (identicalNames idx)

-- The `## Typechecker cells` section of CELL-LIFETIMES.md: from its heading to
-- the next `## ` heading.
typecheckerSection : List String -> List String
typecheckerSection ls =
  takeWhile
    (l => not (startsWith "## " l))
    (drop 1 (dropWhile (/= "## Typechecker cells") ls))

-- Data rows of a markdown table: the header and the `|---|` separator are not.
isDataRow : String -> Bool
isDataRow l = startsWith "| " l && not (startsWith "| name |" l)

-- The cells of a `| a | b |` row, outer pipes stripped, split on ` | `.
rowCells : String -> List String
rowCells l = match stripPrefix "|" (trim l)
  None => []
  Some rest => match stripSuffix "|" (trim rest)
    None => []
    Some body => split " | " (trim body)

nameOf : List String -> String
nameOf [] = ""
nameOf (c :: _) = c

lifetimeVocab : List String
lifetimeVocab =
  ["process", "config", "graph", "module", "group", "run", "unknown"]

cellAt : Int -> List String -> String
cellAt i cells = match drop i cells
  [] => ""
  c :: _ => c

-- Some "<row>: <label> <value>" when column `i` of the row is outside `vocab`.
badField : String -> Int -> List String -> List String -> Option String
badField label i vocab cells =
  let v = cellAt i cells
  if elem v vocab then None else Some "\{nameOf cells}: \{label} \{v}"

badLifetime : List String -> Option String
badLifetime = badField "lifetime" 2 lifetimeVocab

ownerVocab : List String
ownerVocab = [
  "module-level", "ModuleCtx", "GroupCtx", "GraphRun", "GraphCtx", "CrossRun",
  "Interners", "Lineage", "TcConfig", "DriveInputs", "TraceSink", "DynCtx",
  "SiteCtx"
]

targetVocab : List String
targetVocab = [
  "TcEnv", "GroupCtx", "ModuleCtx", "GraphCtx", "TcConfig", "DriveInputs",
  "interner", "delete"
]

fillsVocab : List String
fillsVocab = ["yes", "no", "n/a"]

sourceFields : List String
sourceFields =
  ["cpSchemes", "cpCore", "cpEvidence", "cpDispositions", "cpBinders"]

-- `-`, `none`, `derived(<field>)`, or a comma-separated non-empty field list.
goodSource : String -> Bool
goodSource s =
  s == "-"
    || s == "none"
    || derivedField s
    || fieldList (map trim (split "," s))

derivedField : String -> Bool
derivedField s = match stripPrefix "derived(" s
  None => False
  Some rest => match stripSuffix ")" rest
    None => False
    Some f => elem f sourceFields

fieldList : List String -> Bool
fieldList parts =
  parts /= [] && filter (p => not (elem p sourceFields)) parts == []

badSource : List String -> Option String
badSource cells =
  let v = cellAt 8 cells
  if goodSource v then None else Some "\{nameOf cells}: source \{v}"

badVocab : List String -> List String
badVocab cells =
  filterMap
    (f => f cells)
    [
      badLifetime,
      badField "owner-today" 3 ownerVocab,
      badField "target" 6 targetVocab,
      badField "interface-fills" 7 fillsVocab,
      badSource,
    ]

badWidth : List String -> Option String
badWidth cells =
  if length cells == 10 then
    None
  else
    Some "\{nameOf cells}: \{length cells} cells, not 10"

-- The `## Cells outside the file` section: from its heading to the next `## `.
sideSection : List String -> List String
sideSection ls =
  takeWhile
    (l => not (startsWith "## " l))
    (drop 1 (dropWhile (/= "## Cells outside the file") ls))

sideNames : List String
sideNames = [
  "selectedProfile",
  "binderOrdinalRef",
  "preludeScopeMemoRef",
  "loadedSourcesRef",
  "preludeCacheRef",
  "preludeElabCacheRef",
  "preludeEvidenceRef",
  "desugarCacheRef",
  "desugarGenRef",
  "moduleCacheRef",
  "program_facts.currentFacts",
]

-- The field name of an indented `name :` line; comment lines give None.
fieldNameOf : String -> Option String
fieldNameOf l =
  if not (startsWith " " l) then
    None
  else
    let body = toList (toChars (trimLeft l))
    let name = takeWhile identChar body
    match name
      [] => None
      _ => match dropWhile isSpace (dropWhile identChar body)
        ':' :: _ => Some (fromChars name)
        _ => None

bundleRecords : List String
bundleRecords = [
  "ModuleCtx",
  "ModuleCells",
  "GroupCtx",
  "GraphRun",
  "GraphCtx",
  "CrossRun",
  "Interners",
  "Lineage",
  "TcConfig",
  "DriveInputs",
  "TraceSink",
  "DynCtx",
  "SiteCtx",
]

-- Field names of the bundle `rec`: the indented lines after its
-- `public export data rec = rec {` header, up to the column-0 `}`.
bundleNames : List String -> List String
bundleNames ls = flatMap (recName => bundleFieldNames ls recName) bundleRecords

bundleFieldNames : List String -> String -> List String
bundleFieldNames ls recName =
  let header = "public export data \{recName} = \{recName} {"
  let after = drop 1 (dropWhile (/= header) ls)
  let body = takeWhile (l => not (startsWith "}" l)) after
  map (f => "\{recName}.\{f}") (filterMap fieldNameOf body)

-- The modules of the `types.typecheck` family: the entry module and the leaf modules
-- its rows are partitioned into.
typecheckFamily : List String
typecheckFamily = [
  "types.typecheck",
  "types.tc_mono",
  "types.tc_state",
  "types.tc_env",
  "types.tc_diag_text",
  "types.tc_diag",
  "types.tc_scope",
  "types.tc_unify",
  "types.tc_decls_variance",
  "types.tc_decls_types",
  "types.tc_decls",
  "types.tc_foreign",
  "types.tc_solve_givens",
]

-- The lines of module [m], empty when it is not loaded.
linesFor : String -> List (String, List String) -> List String
linesFor m mods = optionOr [] (lookup m mods)

-- The lines of every module in [typecheckFamily], in that order.
typecheckFamilyLines : List (String, List String) -> List String
typecheckFamilyLines mods = flatMap (m => linesFor m mods) typecheckFamily

-- The cell census: the column-0 `name = Ref` cells of the typecheck family, then
-- the `Bundle.field` names of the `tc_types` bundles.
cellCensus : List (String, List String) -> List String
cellCensus mods =
  filterMap cellName (typecheckFamilyLines mods)
    ++ bundleNames (linesFor "types.tc_types" mods)

-- Names in exactly one of the two lists, sorted.
symmetricDifference : List String -> List String -> List String
symmetricDifference a b =
  let sa = S.fromList a
  let sb = S.fromList b
  sort (toList (S.difference sa sb) ++ toList (S.difference sb sa))

test "arch_boundaries: CELL-LIFETIMES rows equal the cell census" =
  match readFile (underRoot "compiler/types/CELL-LIFETIMES.md")
    Err e => fail "could not read CELL-LIFETIMES.md: \{e}"
    Ok text =>
      let rows =
        map rowCells (filter isDataRow (typecheckerSection (lines text)))
      let sideRows = map rowCells (filter isDataRow (sideSection (lines text)))
      let allRows = rows ++ sideRows
      let census = cellCensus loadModules
      expectAll [
        expectAtLeast 150 (length census),
        expectEqual [] (symmetricDifference census (map nameOf rows)),
        expectEqual (length census) (length rows),
        expectEqual sideNames (map nameOf sideRows),
        expectEqual [] (flatMap badVocab allRows),
        expectEqual [] (filterMap badWidth allRows),
      ]

-- The module-field partition (`moduleCtxFrom` and `moduleCellsFrom` in
-- `types.tc_state`): each field the two name, with the class argument it is taken
-- from, read off their bodies' `field = <class>.field` and
-- `field = refFrom detach <class>.field` lines.  `ModuleCtx.mcCells` has no row of its
-- own: `moduleCellsFrom` builds it, and its rows are the cells.  `moduleCellsFrom` is a
-- record update over `run`, so it names only the fields of the other classes; every
-- cell it does not name is `run`.
partitionHeaders : List (String, String)
partitionHeaders = [
  ("ModuleCtx", "moduleCtxFrom detach run tables drain ident = ModuleCtx {"),
  (
    "ModuleCells",
    "moduleCellsFrom detach run tables drain ident = { run |",
  ),
]

partitionClasses : List String
partitionClasses = ["run", "tables", "drain", "ident"]

-- The rows of the partition function under [header], each named `<record>.<field>`.
partitionRows : List String -> (String, String) -> List (String, String)
partitionRows ls (record, header) =
  let after = drop 1 (dropWhile (/= header) ls)
  map
    (r => ("\{record}.\{fst r}", snd r))
    (filterMap partitionRow (takeWhile (l => not (startsWith "}" l)) after))

-- Some (field, class) for a `field = … class.field,` line.
partitionRow : String -> Option (String, String)
partitionRow l = match split " = " (trim l)
  [field, rhs] => match last (words rhs)
    Some w => classOf field w
    None => None
  _ => None

-- Some (field, class) when [w] is `class.field` (its trailing comma dropped).
classOf : String -> String -> Option (String, String)
classOf field w = match split "." (optionOr w (stripSuffix "," w))
  [cls, f] if f == field => Some (field, cls)
  _ => None

-- A new `ModuleCtx` or `ModuleCells` field is unclassified until the partition names
-- its class: the partition and the records have the same fields, each once, each in a
-- class.
test "arch_boundaries: the module-field partition classifies every ModuleCtx field" =
  let mods = loadModules
  let fields =
    filter
      (/= "ModuleCtx.mcCells")
      (flatMap
        (h => bundleFieldNames (linesFor "types.tc_types" mods) (fst h))
        partitionHeaders)
  let rows =
    flatMap (partitionRows (typecheckFamilyLines mods)) partitionHeaders
  let (cellRows, ctxRows) =
    partition (r => startsWith "ModuleCells." (fst r)) rows
  expectAll
    [
      expectAtLeast 90 (length fields),
      -- A new ModuleCells field is `run` by default in moduleCellsFrom's update: bump this
      -- count only after naming the field in the update or deciding it is a run cell.
      expectEqual 92 (length (filter (startsWith "ModuleCells.") fields)),
      expectEqual
        []
        (symmetricDifference
          (filter (f => not (startsWith "ModuleCells." f)) fields)
          (map fst ctxRows)),
      expectEqual [] (filter (r => not (elem (fst r) fields)) cellRows),
      expectAtLeast 5 (length cellRows),
      expectEqual
        []
        (filter (r => not (elem (snd r) (drop 1 partitionClasses))) cellRows),
      expectEqual [] (filter (r => not (elem (snd r) partitionClasses)) ctxRows),
    ]
