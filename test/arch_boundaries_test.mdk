{- | Architecture boundary pins: layering, module-level cells, the hooks record,
   the AST's cell-free shape, the A8 oversize list, the declaration-visibility
   counts, and the import closures of the leaf modules (laws A6 and A8, G3 and G7
   of the architecture playbook).

   Scope is every `compiler/**/*.mdk` except `*_test.mdk`; a module id is the
   path under `compiler/` without `.mdk`, `/` read as `.`. Only column-0 import
   lines count, so a multi-line `{...}` continuation is ignored.

   The goldens in `test/arch_goldens/` may only fall: `test/arch_ratchet.sh`
   fails a rise unless a commit trailer names it. Run with `ARCH_PINS_WRITE=1`
   to rewrite them from the tree instead of comparing. -}
import fs.{walkDir}
import list.{
  drop, take, dropWhile, dropWhileEnd, filterMap, last, lookup, nub, partition,
  reverse, sort, takeWhile
}
import map as M
import set as S
import string.{
  capitalize, countOccurrences, endsWith, fromChars, split, toChars, isAlphaNum,
  isSpace, join, lines, replace, startsWith, stripPrefix, stripSuffix, trim,
  trimLeft, unlines, words, indexOf
}
import test.{
  Expectation, expectAll, expectAtLeast, expectEqual, expectGolden, fail, pass,
  expectEach, expectLessThan
}
import test_process.{underRoot}

-- The only `types/` modules allowed to reach `support.hooks` through their
-- import closure. Empty until a hooks consumer inside inference is reviewed
-- and named here.
hooksReaderAllowlist : List String
hooksReaderAllowlist = []

layerRank : String -> Option Int
layerRank "support" = Some 0
layerRank "frontend" = Some 1
layerRank "types" = Some 2
layerRank "ir" = Some 3
layerRank "backend" = Some 4
layerRank _ = None

isTop : String -> Bool
isTop d = d == "driver" || d == "tools" || d == "entries"

firstComponent : String -> String
firstComponent m = match split "." m
  [] => m
  d :: _ => d

-- (module id, file lines) for every non-test compiler module, sorted by id.
loadModules : <IO> List (String, List String)
loadModules =
  let root = underRoot "compiler"
  match walkDir root
    Err _ => []
    Ok paths => M.entries (M.fromList (filterMap (loadOne root) paths))

loadOne : String -> String -> <IO> Option (String, List String)
loadOne root path =
  if endsWith ".mdk" path
    && not (endsWith "_test.mdk" path) then match readFile path
    Ok text => Some (modId root path, lines text)
    Err _ => None
  else
    None

modId : String -> String -> String
modId root path =
  let rel = match stripPrefix "\{root}/" path
    Some r => r
    None => path
  replace "/" "." (replace ".mdk" "" rel)

-- A column-0 line that is neither blank, indented, nor a `--` comment.
isColZero : String -> Bool
isColZero l =
  l /= ""
    && not (startsWith " " l)
    && not (startsWith "\t" l)
    && not (startsWith "--" l)

-- `^(?:export\s+)?import\s+IDENT(.IDENT)*`, first dotted path only.
importOf : String -> Option String
importOf l =
  if not (isColZero l) then
    None
  else
    let body = dropExport l
    match stripPrefix "import" body
      None => None
      Some rest => match toList (toChars rest)
        c :: _ if isSpace c => Some (dottedPath (trimLeft rest))
        _ => None

dropExport : String -> String
dropExport l = match stripPrefix "export" l
  Some rest => match toList (toChars rest)
    c :: _ if isSpace c => trimLeft rest
    _ => l
  None => l

dottedPath : String -> String
dottedPath s =
  let raw =
    takeWhile (c => isAlphaNum c || c == '_' || c == '.') (toList (toChars s))
  fromChars (dropWhileEnd (== '.') raw)

importsOf : List String -> List String
importsOf ls = nub (filterMap importOf ls)

-- module id -> imported compiler module ids
type Graph = M.Map String (List String)

buildGraph : List (String, List String) -> Graph
buildGraph mods =
  let ids = S.fromList (map (p => fst p) mods)
  M.fromList
    (map
      ((m, ls) =>
        (m, sort (filter (i => S.has i ids && i /= m) (importsOf ls))))
      mods)

neighbors : Graph -> String -> List String
neighbors g m = match M.get m g
  Some xs => xs
  None => []

violation : String -> String -> Bool
violation src dst =
  let a = firstComponent src
  let b = firstComponent dst
  if isTop a then
    False
  else if isTop b then
    True
  else if a == "eval" then
    b == "ir" || b == "backend"
  else if b == "eval" then
    True
  else match (layerRank a, layerRank b)
    (Some x, Some y) => y > x
    _ => False

violations : Graph -> List String
violations g =
  sort
    (flatMap
      ((src, dsts) => map (d => "\{src} -> \{d}") (filter (violation src) dsts))
      (M.entries g))

-- `^([a-z][A-Za-z0-9_']*)\s*=\s*(Ref|newRef)\b` on a column-0 line whose first
-- word is not a keyword.
cellName : String -> Option String
cellName l =
  let w = match words l
    [] => ""
    x :: _ => x
  if not (isColZero l) || elem w declKeywordsAndLayout then
    None
  else
    let cs = toList (toChars l)
    match cs
      c :: _ if c >= 'a' && c <= 'z' =>
        let name = takeWhile identChar cs
        let after = dropWhile isSpace (dropWhile identChar cs)
        match after
          '=' :: more =>
            let val = fromChars (dropWhile isSpace more)
            if refHead "Ref" val || refHead "newRef" val then
              Some (fromChars name)
            else
              None
          _ => None
      _ => None

-- `kw\b`: the word, then a non-word character or the end.
refHead : String -> String -> Bool
refHead kw s = match stripPrefix kw s
  None => False
  Some rest => match toList (toChars rest)
    [] => True
    c :: _ => not (isAlphaNum c || c == '_')

cellCount : List String -> Int
cellCount ls = length (filterMap cellName ls)

-- One `<prefix><module>\t<count>` row per module whose count is positive,
-- sorted.
countRows : String ->
  (List String -> Int) ->
  List (String, List String) ->
  List String
countRows prefix countFn mods =
  sort
    (filterMap
      ((m, ls) =>
        let n = countFn ls
        if n > 0 then Some "\{prefix}\{m}\t\{n}" else None)
      mods)

-- Lines of `frontend.ast` that hold the word `Ref` (as `grep -nw`) outside a
-- `--` comment. Zero means the AST carries no mutable cell on any node; -1 when
-- the module is absent, so a rename cannot satisfy the pin vacuously.
astRefFields : List (String, List String) -> Int
astRefFields mods = match filter (p => fst p == "frontend.ast") mods
  [] => -1
  (_, ls) :: _ => length (filter hasRefLine ls)

hasRefLine : String -> Bool
hasRefLine l =
  not (startsWith "--" (trimLeft l)) && refWordAt False (toList (toChars l))

-- `Ref` at a word boundary: no word character before it (`prevWord`) and none
-- after it (`refHead`).
refWordAt : Bool -> List Char -> Bool
refWordAt _ [] = False
refWordAt prevWord (c :: cs) =
  if not prevWord && refHead "Ref" (fromChars (c :: cs)) then
    True
  else
    refWordAt (isAlphaNum c || c == '_') cs

-- Fields of the `data Hooks` extent of support/hooks.mdk: ` : ` annotations of
-- a record, else the constructor arguments of a positional declaration. Zero
-- while the type is absent.
hooksFieldCount : List (String, List String) -> Int
hooksFieldCount mods = match filter (p => fst p == "support.hooks") mods
  [] => 0
  (_, ls) :: _ => fieldsOf (dropWhile (l => not (isHooksData l)) ls)

isHooksData : String -> Bool
isHooksData l =
  let body = dropExport (match stripPrefix "public" l
    Some r => trimLeft r
    None => l)
  startsWith "data Hooks" body

fieldsOf : List String -> Int
fieldsOf [] = 0
fieldsOf (first :: rest) =
  let extent = first :: takeWhile continuesData rest
  let colons = sum (map countColons extent)
  if colons > 0 then colons else positionalArgs (join " " extent)

-- Constructor arguments across the `|` alternatives of a positional `data`.
positionalArgs : String -> Int
positionalArgs text =
  let rhs = drop 1 (dropWhile (/= '=') (toList (toChars text)))
  sum
    (map
      (alt => max 0 (topAtoms (toList (toChars alt)) 0 False 0 - 1))
      (split " | " (fromChars rhs)))

-- Whitespace-separated atoms at bracket depth 0, a bracketed group being one.
topAtoms : List Char -> Int -> Bool -> Int -> Int
topAtoms [] _ _ n = n
topAtoms (c :: cs) d inTok n =
  let opens = c == '(' || c == '['
  let closes = c == ')' || c == ']'
  if isSpace c then
    topAtoms cs d (inTok && d > 0) n
  else
    let n2 = if d == 0 && not inTok then n + 1 else n
    let d2 = if opens then d + 1 else if closes then d - 1 else d
    topAtoms cs d2 True n2

continuesData : String -> Bool
continuesData l =
  l == ""
    || startsWith " " l
    || startsWith "}" l
    || startsWith "|" l
    || startsWith "," l

countColons : String -> Int
countColons l = countOccurrences " : " l

-- Transitive import closure of `root`, excluding `root`, ascending.
closureOf : Graph -> String -> List String
closureOf g root = filter (/= root) (toList (reach g [root] (S.fromList [])))

reach : Graph -> List String -> S.Set String -> S.Set String
reach _ [] seen = seen
reach g (m :: rest) seen =
  if S.has m seen then
    reach g rest seen
  else
    reach g (neighbors g m ++ rest) (S.insert m seen)

pin : String -> List String -> <IO> Expectation
pin name rows =
  let path = underRoot "test/arch_goldens/\{name}"
  match getEnv "ARCH_PINS_WRITE"
    Some "1" => match writeFile path (unlines rows)
      Ok _ => pass
      Err e => fail "could not write \{path}: \{e}"
    _ => expectGolden path (unlines rows)

test "arch_boundaries: the tree walk finds the compiler modules" =
  expectAtLeast 100 (length loadModules)

test "arch_boundaries: layering violations match layering.golden" =
  pin "layering.golden" (violations (buildGraph loadModules))

test "arch_boundaries: module-level cells match cells.golden" =
  pin "cells.golden" (countRows "" cellCount loadModules)

test "arch_boundaries: hook field count matches hooks.golden" =
  pin "hooks.golden" ["hooks.fields\t\{hooksFieldCount loadModules}"]

test "arch_boundaries: ast.mdk declares no Ref field matches ast_cells.golden" =
  pin "ast_cells.golden" ["ast_ref_fields\t\{astRefFields loadModules}"]

test "arch_boundaries: no types/ module outside the allowlist reaches support.hooks" =
  let g = buildGraph loadModules
  let offenders =
    sort
      (filter
        (m =>
          startsWith "types." m
            && not (elem m hooksReaderAllowlist)
            && elem "support.hooks" (closureOf g m))
        (M.keys g))
  expectEqual [] offenders

-- Law A8: a module over 3,000 code lines (neither blank nor `--`-leading, the
-- growth ratchet's rule) is a listed exception. The list may only fall; a module
-- that crosses the line needs an `Arch-Pin-Raise:` trailer naming the reason its
-- header states.
isCodeLine : String -> Bool
isCodeLine l = trimLeft l /= "" && not (isCommentLine l)

oversizeRows : List (String, List String) -> List String
oversizeRows mods =
  filterMap
    ((m, ls) => if length (filter isCodeLine ls) > 3000 then Some m else None)
    mods

test "arch_boundaries: modules over 3,000 code lines match oversize.golden" =
  pin "oversize.golden" (oversizeRows loadModules)

-- Substrings that mark a declaration's visibility: an exported `DFunDef`,
-- `DTypeSig`, `DLetGroup` or `DUse` node, an `edPub` flag, a `VisPublic`
-- constructor and a `dataVis` field. Each code-line occurrence is counted.
visibilityPatterns : List String
visibilityPatterns = [
  "DFunDef True",
  "DTypeSig True",
  "DLetGroup True",
  "DUse True",
  "edPub = True",
  "VisPublic",
  "dataVis =",
]

visibilityCount : List String -> Int
visibilityCount ls =
  sum
    (map
      (l => sum (map (p => countOccurrences p l) visibilityPatterns))
      (filter isCodeLine ls))

-- [root]'s import closure against `closure.<root>.golden`.
closurePin : String -> <IO> Expectation
closurePin root =
  pin "closure.\{root}.golden" (closureOf (buildGraph loadModules) root)

test "arch_boundaries: declaration-visibility counts match visibility.golden" =
  pin "visibility.golden" (countRows "visibility." visibilityCount loadModules)

test "arch_boundaries: frontend.ast closure matches its golden" =
  closurePin "frontend.ast"

test "arch_boundaries: frontend.visibility closure matches its golden" =
  closurePin "frontend.visibility"

test "arch_boundaries: types.effect_param_decode closure matches its golden" =
  closurePin "types.effect_param_decode"

test "arch_boundaries: types.capability_manifest closure matches its golden" =
  closurePin "types.capability_manifest"

test "arch_boundaries: types.manifest_publish closure matches its golden" =
  closurePin "types.manifest_publish"

test "arch_boundaries: types.capability_policy closure matches its golden" =
  closurePin "types.capability_policy"

test "arch_boundaries: types.repr closure matches its golden" =
  closurePin "types.repr"

test "arch_boundaries: types.tc_types closure matches its golden" =
  closurePin "types.tc_types"

test "arch_boundaries: types.tc_mono closure matches its golden" =
  closurePin "types.tc_mono"

test "arch_boundaries: types.tc_state closure matches its golden" =
  closurePin "types.tc_state"

test "arch_boundaries: types.tc_env closure matches its golden" =
  closurePin "types.tc_env"

test "arch_boundaries: types.tc_diag closure matches its golden" =
  closurePin "types.tc_diag"

test "arch_boundaries: types.tc_diag_text closure matches its golden" =
  closurePin "types.tc_diag_text"

-- Every module of the typecheck family that sits above `tc_diag_text`: all of them
-- except the modules the leaf may import (`tc_types`, `tc_mono`) and the leaf itself.
-- Derived from `typecheckFamily`, so a row added there is covered when it lands. A
-- golden can be re-blessed; this set cannot.
aboveDiagText : List String
aboveDiagText =
  filter
    (m =>
      m /= "types.tc_mono"
        && m /= "types.tc_types"
        && m /= "types.tc_diag_text")
    typecheckFamily

test "arch_boundaries: types.tc_diag_text closure holds no module above it" =
  let closure = closureOf (buildGraph loadModules) "types.tc_diag_text"
  expectEqual [] (filter (m => elem m aboveDiagText) closure)

-- The state and context record types. A row of `tc_diag_text` names none of
-- them; a row of `tc_diag` that builds text from one belongs beside its emitter.
contextTypes : List String
contextTypes = [
  "ModuleCtx",
  "GraphCtx",
  "GraphRun",
  "SiteCtx",
  "DynCtx",
  "DoCtx",
  "TcEnv",
  "ModuleCells",
  "Windowed",
  "GrantState",
  "ShadowDicts",
  "DeclEnvs",
  "ImplEnv",
  "ClassEnv",
  "DataEnv",
  "MethodEnv",
]

-- The `Ref` spellings a context-free signature may carry: the three
-- variable cells, an `Int` counter and a name table.
allowedRefs : List String
allowedRefs = [
  "Ref Tyvar",
  "Ref Effvar",
  "Ref Authvar",
  "Ref (List (Int, String))",
  "Ref Int",
]

-- Identifier tokens of [s]: maximal runs of identifier characters.
sigTokens : String -> List String
sigTokens s = filter (/= "") (map fromChars (identRuns (toList (toChars s))))

identRuns : List Char -> List (List Char)
identRuns [] = [[]]
identRuns (c :: rest) =
  let tl = identRuns rest
  if identChar c then match tl
    [] => [[c]]
    t :: ts => (c :: t) :: ts
  else
    [] :: tl

-- Every top-level `name : signature` of [ls], as (name, signature text), the
-- signature joined across its indented continuation lines.
topSigs : List String -> List (String, String)
topSigs [] = []
topSigs (l :: rest) = match sigHead l
  None => topSigs rest
  Some (name, sig0) =>
    let cont = takeWhile startsWithSpace rest
    (name, join " " (map trim (sig0 :: cont)))
      :: topSigs (dropWhile startsWithSpace rest)

sigHead : String -> Option (String, String)
sigHead l = match indexOf " : " l
  None => None
  Some i =>
    let name = fromChars (take i (toList (toChars l)))
    if name /= "" && all identChar (toList (toChars name)) then
      Some (name, fromChars (drop (i + 3) (toList (toChars l))))
    else
      None

-- The segments of a signature split at each `->` outside parentheses.
splitAtArrows : String -> List String
splitAtArrows s = arrowGo 0 [] (toList (toChars s))

arrowGo : Int -> List Char -> List Char -> List String
arrowGo depth cur [] = [fromChars (reverse cur)]
arrowGo depth cur ('-' :: '>' :: rest) =
  if depth == 0 then
    fromChars (reverse cur) :: arrowGo depth [] rest
  else
    arrowGo depth ('>' :: '-' :: cur) rest
arrowGo depth cur (c :: rest) =
  let d = if c == '(' then depth + 1 else if c == ')' then depth - 1 else depth
  arrowGo d (c :: cur) rest

-- The tokens of every segment of [sig] before its result.
sigParamTokens : String -> List String
sigParamTokens sig = flatMap sigTokens (dropLast (splitAtArrows sig))

dropLast : List a -> List a
dropLast xs = take (length xs - 1) xs

hasContextToken : List String -> Bool
hasContextToken ts = any (t => elem t contextTypes) ts

-- [sig] with every allowed `Ref` spelling removed, then any `Ref` left over.
hasDisallowedRef : String -> Bool
hasDisallowedRef sig =
  elem "Ref" (sigTokens (fold (acc r => replace r "" acc) sig allowedRefs))

diagTextSigs : List (String, String)
diagTextSigs = topSigs (linesFor "types.tc_diag_text" loadModules)

-- A leaf code line holding a context type token, wherever it sits: an import item, a
-- `type` alias, an annotation, a signature or a body.
test "arch_boundaries: tc_diag_text names no context type anywhere" =
  expectEqual
    []
    (filter
      (l => isCodeLine l && hasContextToken (sigTokens l))
      (linesFor "types.tc_diag_text" loadModules))

-- Every column-zero row of the leaf is signed, so no row reaches a cell through an
-- unannotated parameter.
test "arch_boundaries: every tc_diag_text row has a signature" =
  expectEqual
    []
    (filter
      (n => not (elem n (map fst diagTextSigs)))
      (nub (filterMap definedName (linesFor "types.tc_diag_text" loadModules))))

test "arch_boundaries: tc_diag_text signatures carry only the allowed Ref cells" =
  expectEqual
    []
    (filter (nameSig => hasDisallowedRef (snd nameSig)) diagTextSigs)

test "arch_boundaries: tc_diag_text signature census sees its rows" =
  expectAtLeast 150 (length diagTextSigs)

test "arch_boundaries: tc_diag_text assigns no cell" =
  expectEqual
    []
    (filter
      (l => isCodeLine l && indexOf ":=" l /= None)
      (linesFor "types.tc_diag_text" loadModules))

-- Every `tc_diag` row is signed and takes a context-typed parameter; a row without one
-- is context-free text and belongs in `tc_diag_text`. The complement of the leaf pins.
test "arch_boundaries: every tc_diag row takes a context type" =
  let sigs = topSigs (linesFor "types.tc_diag" loadModules)
  let rows = nub (filterMap definedName (linesFor "types.tc_diag" loadModules))
  let takesContext n = match lookup n sigs
    None => False
    Some sig => hasContextToken (sigParamTokens sig)
  expectEqual [] (filter (n => not (takesContext n)) rows)

