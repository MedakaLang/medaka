-- issue #1090: `dataParamKindsRef`/`universeDataParamKinds` are keyed by BARE type
-- name. `z2.mdk` declares its own same-name, same-arity `Bx` with an all-ordinary
-- kind signature; even though this file imports ONLY `gbox`'s `Bx` (never `z2`'s), a
-- written effect row on `gbox`'s `Bx` is elaborated against `z2`'s wrong kind list and
-- rejected outright as `T-ROW-KIND-MISMATCH` -- a false, order-dependent loud reject
-- of a valid signature.
import gbox.{Bx}
import z2.{z2} -- ONLY the function; never z2's Bx

v : Bx <Stdout> Int
v = v

main = println "x"
