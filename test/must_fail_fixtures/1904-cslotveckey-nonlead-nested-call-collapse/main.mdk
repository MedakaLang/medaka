interface Ix a b c where
  ix : a -> b -> c -> Int
impl Ix Int Char Bool where
  ix _ _ _ = 333
impl Ix Int Bool Char where
  ix _ _ _ = 111

callA : Ix a b c => a -> b -> c -> Int
callA n x y = ix n x y

callB : Ix a c b => a -> b -> c -> Int
callB n x y = ix n y x

size : (Ix a b c, Ix a c b) => a -> b -> c -> Int
size n x y = callA n x y + callB n x y

main = println (size 5 'z' True)
