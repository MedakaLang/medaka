data Taker a = MkTaker (a -> Int)

runTaker : Taker a -> a -> Int
runTaker (MkTaker g) x = g x

pureTaker : Taker (Unit -> Unit)
pureTaker = MkTaker (k => let _ = k () in 1)

wide : Taker (Unit -> <IO> Unit)
wide = pureTaker                       -- the unsound step: contravariant widening, accepted

shout : Unit -> <IO> Unit
shout _ = println "LAUNDERED"

main = println (runTaker wide shout)
