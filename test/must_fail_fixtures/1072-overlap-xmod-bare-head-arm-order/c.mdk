-- CONTROL half: byte-identical in shape to a.mdk, except THIS module holds the
-- SPECIFIC impl instead of the general one.  Same site, same helper, same exports.
export import iface.{Speak(..), speak}

public export data Box a = Box a

impl Speak (Box Int) where
  speak _ = "specific"

export useC : Speak a => a -> String
useC x = speak x

export callC : String
callC = useC (Box 1)
