-- Module `a` holds the dict-routed call site AND ONLY THE GENERAL impl.
-- a does NOT import b, so a's KeyBuckets hold ONE impl at head `Box` -> no collision
-- -> typecheck stamps the BARE HEAD `Box` into the callA dict cell.  That is the word
-- the rework OR's into EVERY arm at this head, so which arm wins is decided by ARM
-- ORDER, not by specificity.
export import iface.{Speak(..), speak}

public export data Box a = Box a

impl Speak (Box a) where
  speak _ = "general"

export useA : Speak a => a -> String
useA x = speak x

export callA : String
callA = useA (Box 1)
