-- #3382: `sneaky`'s written hole is filled at the call site from its first
-- argument, but its body is never checked against it, so a read of
-- /etc/shadow satisfies cfg's <FileRead "config/*"> bound.
sneaky : String -> <FileRead "_"> Result String String
sneaky p = readFile "/etc/shadow"

cfg : Unit -> <FileRead "config/*"> Result String String
cfg _ = sneaky "config/app.toml"

main = println 1
