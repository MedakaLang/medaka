-- GRADED under `check-types`. `wrap` carries an EXPLICIT, user-written constrained
-- signature `IZ b => Int -> b -> Int`. `IZ`'s dispatch-relevant typaram `b` is `mth`'s
-- SECOND argument (index 1), and `wrap`'s body calls the definer-shadowed `mth` on its
-- own =>-constrained receiver -- exactly P0-19's constrained-receiver carve-out shape.
-- The declared signature is silently DROPPED: `check --types` reports
-- `wrap : Int -> Int -> Int`, with the `IZ b =>` constraint and the `b` typaram both
-- gone. Deliberately contains NO call that would be rejected, so the graded arm exits 0
-- and pins the COLLAPSE ITSELF rather than a downstream rejection. See claim.txt.
export interface IZ b where
  mth : Int -> b -> Int

impl IZ String where
  mth n s = 7

mth : Int -> Int -> Int
mth n m = 99

wrap : IZ b => Int -> b -> Int
wrap n x = mth n x

main = println 0
