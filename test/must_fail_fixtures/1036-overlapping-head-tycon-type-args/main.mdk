-- issue #1036: two impls SHARE a head tycon (`Box`) but differ in their type
-- ARGUMENT (`Box Int` vs `Box String`). A polymorphic forwarding call through
-- `use : Speak a => a -> String` resolves BOTH receivers to the FIRST-registered
-- impl (`Box Int`'s override) in the native backend, silently ignoring the
-- second impl's own body (here, its inherited default). check and eval are fine.
import iface.{Speak(..), speak}

data Box a = Box a

impl Speak (Box Int) where
  speak _ = "boxint"

impl Speak (Box String) where

use : Speak a => a -> String
use x = speak x

main =
  let _ = println (use (Box 1))
  println (use (Box "s"))
