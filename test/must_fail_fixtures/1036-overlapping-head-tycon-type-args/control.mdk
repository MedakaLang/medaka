-- CONTROL for #1036 (matches the issue body's own stated control): byte-identical
-- to main.mdk except `impl Speak (Box String)` OVERRIDES `speak` instead of
-- inheriting the interface default. That is the ONE flipped feature -- override
-- vs inherited-default on the SAME shared head tycon (`Box`) -- so it must
-- build-run clean and print `boxint` then `boxstr`, proving the dispatch
-- machinery CAN distinguish `Box Int` from `Box String` in general. The defect
-- is specific to the inherited-default path, not to sharing a head tycon per se.
import iface.{Speak(..), speak}

data Box a = Box a

impl Speak (Box Int) where
  speak _ = "boxint"

impl Speak (Box String) where
  speak _ = "boxstr"

use : Speak a => a -> String
use x = speak x

main =
  let _ = println (use (Box 1))
  println (use (Box "s"))
