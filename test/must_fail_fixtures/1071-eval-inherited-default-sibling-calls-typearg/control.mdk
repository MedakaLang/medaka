-- CONTROL for #1071: byte-for-byte the same program as main.mdk except the second impl
-- sits at a DIFFERENT head tycon -- `Bag String` instead of `Box String`. Everything else
-- is identical: same interface, same INHERITED two-sibling-call `describe` default, both
-- impls still define `tagOf` and `sizeOf`, same constrained forwarding helper `useD`, same
-- two receivers, same expected numbers. Head-tycon collision vs no collision is the ONE
-- flipped variable.
--
-- It must print `int/31` then `str/71` under `medaka run`, proving that a sibling call
-- inside an inherited default body IS re-narrowed correctly whenever the two impls' heads
-- differ. So a break here means default-body sibling dispatch regressed broadly in the
-- interpreter -- NOT that #1071 was fixed.
import dface.{Described(..), tagOf, sizeOf, describe}

data Box a = Box a
data Bag a = Bag a

impl Described (Box Int) where
  tagOf _ = "int"
  sizeOf _ = 3

impl Described (Bag String) where
  tagOf _ = "str"
  sizeOf _ = 7

useD : Described a => a -> String
useD x = describe x

main =
  let _ = println (useD (Box (1 : Int)))
  println (useD (Bag "v"))
