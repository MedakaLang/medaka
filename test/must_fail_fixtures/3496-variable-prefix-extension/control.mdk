-- #3496 control: the same wrapper forwarding its argument unchanged. The read
-- is exactly the caller's element, so the exact bound admits it.
readUnder : (p : String) -> String -> <FileRead p> Result String String
readUnder p _ = readFile p

onlyApp : Unit -> <FileRead "cfg/app.toml"> Result String String
onlyApp _ = readUnder "cfg/app.toml" ".bak"

main = println 1
