-- issue #1256: `registerRecordInfoKeyed`/`lookupRecordByName` are keyed by bare record
-- name. `zrmod.mdk` declares its own same-name `Cfg` with a DIFFERENT field type, and
-- even though entry.mdk imports ONLY `armod`'s `Cfg` (never `zrmod`'s), the interpreter
-- reads whichever `Cfg` won the shared registry -- silently printing a Float where an
-- Int was written.
import armod.{Cfg}
import zrmod.{zrf} -- ONLY the function; never zrmod's Cfg

v : Cfg
v = Cfg { fld = 7 }

main = println v.fld
