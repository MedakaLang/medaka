-- CONTROL half of issue #1382: same TYPE NAME collision as zrmod.mdk (`Cfg`,
-- shared with armod_ctl.mdk) -- that part of the shape stays -- but the field
-- ORDER now matches armod_ctl.mdk's (`a` then `b`) instead of being reversed.
-- The ONE variable this isolates: same-name collision present, field-order
-- disagreement removed.
public export data Cfg = { a : Int, b : Int }
mkZ : Cfg
mkZ = Cfg { a = 44, b = 33 }
export selfA : Int
selfA = mkZ.a
export selfB : Int
selfB = mkZ.b
