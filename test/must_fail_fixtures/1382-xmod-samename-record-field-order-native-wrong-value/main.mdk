-- issue #1382 repro A, verbatim from the issue body. NO cross-module
-- projection at all: this module only imports plain Int VALUES (`arSum`,
-- `selfA`, `selfB`), never a `Cfg` value or type from either module. Yet the
-- native build corrupts zrmod's own internally-consistent projection.
--
-- Hand-derived correct answer: `self=44,33 arsum=33`. Derived from the source
-- before running anything: `mkZ = Cfg { b = 33, a = 44 }`, so `mkZ.a = 44` and
-- `mkZ.b = 33`; `arSum = 11 + 22 = 33`. `medaka run` prints exactly this.
import armod.{arSum}
import zrmod.{selfA, selfB}
main : <IO> Unit
main =
  putStrLn ("self=" ++ intToString selfA ++ "," ++ intToString selfB
    ++ " arsum=" ++ intToString arSum)
