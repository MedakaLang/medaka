-- CONTROL for #1052: byte-identical to main.mdk except the body of `useTwo` calls
-- `sizeOf` DIRECTLY at each argument instead of going through the `where`-local `d`.
-- That is the ONE flipped feature -- shared `where`-local vs inlined body -- so this
-- must print `3` (Box=1 plus Tag=2), proving two-constraint dict passing works in
-- general and isolating the defect to the monomorphised local.
interface Sized a where
  sizeOf : a -> Int

data Box = Box Int

impl Sized Box where
  sizeOf _ = 1

data Tag = Tag

impl Sized Tag where
  sizeOf _ = 2

useTwo : (Sized a, Sized b) => a -> b -> Int
useTwo x y = sizeOf x + sizeOf y

main = println (useTwo (Box 0) Tag)
