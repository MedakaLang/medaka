-- issue #1052: a `where`-local helper used at BOTH constrained type variables of a
-- multi-constraint signature is monomorphised, which MERGES the two distinct rigid
-- signature vars and DROPS a dict slot from the calling convention. `useTwo` is emitted
-- with ONE `$dict_` param for a TWO-constraint signature, so `d y` routes through `x`'s
-- dictionary and `sizeOf Tag` runs `Box`'s impl. `check` is green; both eval and native
-- print `2` where the correct answer is `3`.
interface Sized a where
  sizeOf : a -> Int

data Box = Box Int

impl Sized Box where
  sizeOf _ = 1

data Tag = Tag

impl Sized Tag where
  sizeOf _ = 2

useTwo : (Sized a, Sized b) => a -> b -> Int
useTwo x y = d x + d y where
  d v = sizeOf v

main = println (useTwo (Box 0) Tag)
