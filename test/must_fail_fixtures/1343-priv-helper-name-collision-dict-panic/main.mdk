-- #1343: `lib.w.bump` is module-private and not bound by this wildcard import;
-- this file's OWN unrelated, SIGNATURED `bump : a -> a` is never called by
-- `main`, which only forces `used 1`.  Correct verdict: exit 0, print 2 (as
-- `medaka build` + run the binary already does).  Observed: `medaka run`
-- panics with the INTERNAL dictionary name `$dict_bump_0`.
import lib.w.*

data NoNum = NoNum

bump : a -> a
bump x = x

main = println (used 1)
