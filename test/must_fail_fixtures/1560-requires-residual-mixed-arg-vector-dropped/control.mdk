-- CONTROL for issue 1560.  ONE flipped dimension: the predicate arrives DIRECTLY from
-- the method call (`conv x y`, argument vector `[t, u]` — all bare tyvars) instead of
-- as the residual of a `requires` discharge.  Same multi-parameter interface, same
-- impls, same binder shape, same call, same marker.
--
-- HAND-DERIVED: the goal `Conv t u` is already all-bare-tyvars, so the long-standing
-- direct path defers it unchanged — `g : Conv a b => a -> b -> String`, one dict
-- abstracted — and the binary prints
--     start
--     int-bool
-- at exit 0.
--
-- If THIS row breaks, multi-parameter interfaces, dict abstraction at arity 2, or
-- native multi-param dispatch broke: an ENVIRONMENT break, never evidence about issue
-- 1560.  It is also the false-drain guard in the other direction — it proves the
-- sibling's crash is specific to the residual, not to this interface shape.
main =
  let _ = println "start"
  println (g 5 True)

data Wrap a = Wrap a

interface Conv a b where
  conv : a -> b -> String

impl Conv Int Bool where
  conv _ _ = "int-bool"

impl Conv (Wrap a) b requires Conv a b where
  conv (Wrap x) y = "w:\{conv x y}"

g x y = conv x y
