-- CONTROL for #1493: identical to main.mdk with the method renamed `identity` ->
-- `idnty`, a name no prelude standalone uses. That is the ONE flipped feature. It must
-- check clean (exit 0, zero diagnostics); measured, it also RUNS clean and prints the
-- correct `7`, which is what establishes main.mdk's program as legal rather than merely
-- differently-rejected.
interface Idn c where
  idnty : c -> Int

data Box = Box Int

impl Idn Box where
  idnty (Box n) = n

main = println (idnty (Box 7))
