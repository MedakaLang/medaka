export interface IZ b where
  szK : b -> Int -> Int  -- arity 2, SAME method name, unrelated interface

-- SAME receiver type Int as amod's IA impl: one receiver, two same-spelled
-- methods of DIFFERENT arity, from two unrelated interfaces.
export impl IZ Int where
  szK s k = k + 7

export viaZ : IZ b => b -> Int -> Int
viaZ x k = szK x k
