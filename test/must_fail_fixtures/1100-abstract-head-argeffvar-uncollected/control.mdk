-- CONTROL: byte-identical to main.mdk except the ONE thing that decides whether
-- the hole is exploitable: `loud` (which performs <Stdout>) becomes `quiet`, an
-- honestly PURE function of the same shape.  The interface declaration (still an
-- uncharged, abstract-head `gtake : f e a -> a`) and the impl (still forcing the
-- Susp thunk eagerly) are UNCHANGED -- only whether the forced thunk actually
-- performs an effect differs.  It must stay green and print `7` with NO `BOOM`,
-- isolating the defect to declarations whose underlying value actually performs
-- an effect, not to graded interfaces, Susp, or eager forcing in general.  If
-- this breaks, the environment broke, not #1100.
data Box e a = Done a | Susp (Unit -> <e> a)

interface GRun f where
  grun : f e a -> <e> a
  gtake : f e a -> a

impl GRun Box where
  grun (Done a) = a
  grun (Susp t) = t ()
  gtake (Done a) = a
  gtake (Susp t) = t ()

quiet : Unit -> Int
quiet u = 7

pureInt : Int
pureInt = gtake (Susp quiet)

main = println pureInt
