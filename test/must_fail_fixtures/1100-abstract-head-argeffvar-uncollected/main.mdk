data Box e a = Done a | Susp (Unit -> <e> a)

interface GRun f where
  grun : f e a -> <e> a
  gtake : f e a -> a

impl GRun Box where
  grun (Done a) = a
  grun (Susp t) = t ()
  gtake (Done a) = a
  gtake (Susp t) = t ()

loud : Unit -> <Stdout> Int
loud u =
  let _ = putStr "BOOM "
  7

pureInt : Int
pureInt = gtake (Susp loud)

main = println pureInt
