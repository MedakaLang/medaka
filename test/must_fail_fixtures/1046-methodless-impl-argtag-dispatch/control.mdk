-- CONTROL for #1046: byte-identical to main.mdk except `impl Speak Dog` OVERRIDES
-- `speak` (`"woof"`) instead of inheriting the interface default. That is the ONE
-- flipped feature -- method-less (inherited-default) vs. explicit-override -- so this
-- must build-run clean and print `woof|meow`, proving the native arg-tag dispatch CAN
-- tell `Dog` and `Cat` apart once BOTH impls contribute an entry to the method's group.
import iface.{Speak(..), speak}
data Dog = Dog
data Cat = Cat
impl Speak Dog where
  speak _ = "woof"
impl Speak Cat where
  speak _ = "meow"
main =
  let f = v => speak v
  println (f Dog ++ "|" ++ f Cat)
