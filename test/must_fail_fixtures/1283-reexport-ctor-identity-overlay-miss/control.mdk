-- CONTROL for #1283.  Byte-identical to main.mdk except the FIRST import names
-- `amodd` — the module that DECLARES `A1`/`Dup` — instead of `reamod`, which only
-- re-exports them.  That single hop is the whole defect: with the declaring module
-- named, `declOwnedBy` matches, the overlay fires, and this must stay GREEN.
--
-- If this goes red, the environment broke (the overlay itself regressed), NOT #1283.
import amodd.{A1, Dup, unA1}
import zmod.{zf}

v : A1
v = Dup

main : <IO> Unit
main = println (unA1 v + zf 0)
