-- CONTROL: the SAME type-level widening (`<> ` where `<Stdout>` is written) through an
-- IMMUTABLE container.  `List` has no write-back operation, so nothing can install the
-- effectful value into the narrower-typed original — the widening is unexploitable and
-- accepting it is correct.  This must stay green: if it breaks, the environment broke
-- (effect rows, containers, the prelude), not #1098.
shout : Unit -> <Stdout> Unit
shout u =
  let _ = putStr "LIST-CONTROL "
  ()

pureFn : Unit -> Unit
pureFn u = ()

box : List (Unit -> <> Unit)
box = [pureFn]

alias : List (Unit -> <Stdout> Unit)
alias = box

main = println (length alias)
