shout : Unit -> <Stdout> Unit
shout u =
  let _ = putStr "REF-EFFECT-PERFORMED "
  ()

pureFn : Unit -> Unit
pureFn u = ()

box : Ref (Unit -> <> Unit)
box = Ref pureFn

alias : Ref (Unit -> <Stdout> Unit)
alias = box

writeIntoAlias : Unit -> Unit
writeIntoAlias u = setRef alias shout

callBox : Unit -> Unit
callBox u = box.value ()

main =
  let _ = writeIntoAlias ()
  println (callBox ())
