-- Issue 1578: `conv (Wrap x) y` poses `Conv (Wrap t) u` -- a MIXED vector, one
-- concrete head and one free variable -- and NO impl in this program has a `Wrap`
-- head, so the goal has no witness at any instantiation and the program must be
-- REJECTED.  Measured: `check` exits 0 with `h : a -> b -> String`, and `run` answers
-- the call with `impl Conv Int Bool` -- an impl whose head is not the goal's head --
-- printing `int-bool` at exit 0.
data Wrap a = Wrap a

interface Conv a b where
  conv : a -> b -> String

impl Conv Int Bool where
  conv _ _ = "int-bool"

h x y = conv (Wrap x) y

main = println (h 5 True)
