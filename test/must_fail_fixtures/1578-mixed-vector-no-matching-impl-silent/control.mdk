-- CONTROL for issue 1578: main.mdk with the ONE distinguishing feature removed -- here
-- the goal `Conv (Wrap t) u` DOES have a matching impl, so there is nothing for the
-- no-match arm to swallow.  Everything else is identical.  This must run clean; if it
-- does not, the environment broke and the gate says CONTROL-BROKE rather than letting
-- an unrelated failure read as the bug.
data Wrap a = Wrap a

interface Conv a b where
  conv : a -> b -> String

impl Conv Int Bool where
  conv _ _ = "int-bool"

impl Conv (Wrap a) b where
  conv (Wrap _) _ = "wrapped"

h x y = conv (Wrap x) y

main = println (h 5 True)
