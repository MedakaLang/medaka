-- CONTROL: main.mdk with Rec's colliding field renamed (beta -> gamma) -- the one
-- variable this isolates. Rec no longer shares any field name with Other, so the
-- interpreter and the built binary must agree: both print `ob` then `BBB`. If they
-- disagree, something OTHER than the field-name collision broke record field access,
-- not #1216.
import other.{Other(..)}

data Rec = Rec { alpha : String, gamma : String }

getBeta : Rec -> String
getBeta r = r.gamma

main =
  let _ = println (Other { beta = "ob", alpha = "oa" }.beta)
  println (getBeta (Rec { alpha = "AAA", gamma = "BBB" }))
