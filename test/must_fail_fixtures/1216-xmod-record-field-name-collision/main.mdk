-- issue #1216: Rec's `beta` (index 1) collides in NAME ONLY with Other's `beta`
-- (index 0), across a module boundary. `getBeta` reads `r.beta` on a genuine Rec --
-- the native emitter reads the wrong slot for `.field` access when it has also seen
-- another module's record sharing that field name at a different index.
import other.{Other(..)}

data Rec = Rec { alpha : String, beta : String }

getBeta : Rec -> String
getBeta r = r.beta

main =
  let _ = println (Other { beta = "ob", alpha = "oa" }.beta)
  println (getBeta (Rec { alpha = "AAA", beta = "BBB" }))
