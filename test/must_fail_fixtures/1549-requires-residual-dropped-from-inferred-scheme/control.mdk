-- CONTROL for issue 1549.  Byte-identical to main.mdk except the ONE flipped
-- dimension: the `requires Tag a` context is DROPPED from the `Wrap` impl (and
-- its body no longer routes through the Tag dict).  With no residual to defer,
-- `nest : a -> String` is the CORRECT principal scheme and `nest NoTag` is a
-- legal program whose answer is "wrap".
--
-- This proves that a PARAMETRIC impl reached from an UNSIGNATURED binding is
-- fine in general -- so a red main.mdk means the residual is now carried, not
-- that dispatch through `impl Tag (Wrap a)` broke.  If THIS file breaks, the
-- environment broke and the harness says CONTROL-BROKE rather than DRAINED.
--
-- Per #1144 this harness grades a control on its EXIT CODE ONLY, and a
-- wrong-value-at-exit-0 defect cannot be discriminated by an exit code unless
-- the program puts the value INTO the exit code.  So `main` ASSERTS "wrap" and
-- panics otherwise, rather than printing it -- a control that merely printed
-- would exit 0 either way and could never fail.
data Wrap a = Wrap a

data NoTag = NoTag

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

impl Tag (Wrap a) where
  tagOf _ = "wrap"

nest x = tagOf (Wrap x)

main =
  let r = nest NoTag
  if r == "wrap" then
    println "control-ok:wrap"
  else
    panic "control regressed: a requires-free parametric impl no longer answers 'wrap'"
