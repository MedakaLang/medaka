-- issue 1549: the residual predicate left over from discharging a
-- `requires`-carrying impl is DROPPED from an UNSIGNATURED binding's
-- generalized context.
--
-- THE CORRECT ANSWER IS A REJECTION.  `Wrap x : Wrap t`, so `tagOf (Wrap x)`
-- poses `Tag (Wrap t)`; the only matching instance is
-- `impl Tag (Wrap a) requires Tag a`, whose discharge leaves the residual
-- `Tag t`.  `t` is generalizable, so DICT-SEMANTICS §4 `gen` defers it into the
-- principal context: `nest : Tag a => a -> String`.  `nest NoTag` then poses
-- `Tag NoTag`, which no impl satisfies, and the program must be rejected with
-- `No impl of Tag for NoTag`.
--
-- This file reproduces the BUG.  Measured on a cold-bootstrapped binary at
-- d0281bef, MEDAKA_STRICT=1, exit codes read from a file redirect:
--   medaka check --types  -> exit 0, `nest : a -> String` (context ABSENT)
--   medaka run            -> exit 0, `wrap(int)`   <-- pinned here
--   medaka build          -> exit 0, binary written
--   ./the binary          -> exit 139, E-FATAL-SIGNAL segmentation fault
--
-- `wrap(int)` is NOT the correct answer and is never asserted to be: NoTag is
-- not Int.  With no dict to pass, the un-witnessed goal falls back to a
-- concrete impl by declaration order (adding `impl Tag Bool` above
-- `impl Tag Int` makes this print `wrap(bool)` instead).
--
-- ONE-BINDING DISCRIMINATOR, in this very file's shape: adding
-- `direct x = tagOf x` alongside `nest` and running `medaka check` prints
--   direct : Tag a => a -> String     <- carried
--   nest   : a -> String              <- DROPPED
-- Same interface, same impls, one compilation.  The single distinguishing
-- dimension is whether the predicate is a `requires` RESIDUAL.
data Wrap a = Wrap a

data NoTag = NoTag

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

impl Tag (Wrap a) requires Tag a where
  tagOf (Wrap x) = "wrap(\{tagOf x})"

nest x = tagOf (Wrap x)

main = println (nest NoTag)
