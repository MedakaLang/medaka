-- CONTROL for #1161 symptom 2.  Byte-identical to main.mdk except for ONE
-- addition: the `impl Ix Int Bool` that main.mdk is missing.  That single change
-- flips the declared constraint `Ix a Bool` from UNSATISFIABLE to SATISFIABLE,
-- which is the bug's one distinguishing feature -- so if this control stops
-- working the `=>`-constrained multi-parameter dispatch machinery broke, and
-- main.mdk's red is an environment regression, not a fix to #1161.
--
-- Per #1144 this harness grades a control on its EXIT CODE ONLY, and neither the
-- bug nor its control is discriminable by an exit code (both are exit-0
-- programs), so `main` ASSERTS its value and panics otherwise rather than
-- printing it -- a control that merely printed would exit 0 either way and could
-- never fail.
--
-- 111 is HAND-DERIVED, not captured: the goal is `Ix Int Bool`, `match(IE, ·)`
-- is the singleton {`Ix Int Bool`} (the `Ix Int Char` head differs in argument
-- 1), so §3 `inst` selects it and `ix x True` is its body, 111.
interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Char where
  ix _ _ = 222

impl Ix Int Bool where
  ix _ _ = 111

useIx : Ix a Bool => a -> Int
useIx x = ix x True

main =
  let r = useIx 1
  if r == 111 then
    println "control-ok:111"
  else
    panic "control regressed: a SATISFIABLE `Ix a Bool =>` no longer dispatches to `impl Ix Int Bool`"
