import shared.{Box(..)}

-- Interface spelled `Same`, method spelled `m`, signature `a -> Int`.
-- IDENTICAL signature to zmod's. That is deliberate: issue 1647's own control
-- shows its emit-path defect tracks the SIGNATURE difference, so identical
-- signatures EXCLUDE 1647's mechanism from this fixture.
export interface Same a where
  m : a -> Int

export impl Same (Box a) requires Eq a where
  m _ = 2
