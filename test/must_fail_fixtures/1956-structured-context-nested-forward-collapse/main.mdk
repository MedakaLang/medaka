data Wrap a = Wrap a
interface Conv a b where
  conv : a -> b -> String
impl Conv (Wrap Int) Bool where
  conv _ _ = "wrap-int-bool"
impl Conv (Wrap Char) Int where
  conv _ _ = "wrap-char-int"

callA : Conv (Wrap a) b => Wrap a -> b -> String
callA x y = conv x y

f2 : (Conv (Wrap a) b, Conv (Wrap c) d) => Wrap a -> b -> Wrap c -> d -> String
f2 x y z w = callA x y ++ " " ++ callA z w

main = println (f2 (Wrap 5) True (Wrap 'c') 7)
