-- #1620 RAW PROBE — NOT RUN BY THIS GATE. It records the channels main.mdk's
-- projection deliberately gives up, and the measurement that rules the raw value
-- out as a pin.
--
-- Same program as main.mdk, printing `ping T` itself instead of comparing it.
-- Re-derive with (correct behaviour is described in main.mdk):
--   M=./medaka; D=test/must_fail_fixtures/1620-two-ifaces-same-method-binary-wrong-value
--   $M check $D/raw-probe.mdk;                 echo "check=$?"
--   $M run   $D/raw-probe.mdk > /tmp/r 2>&1;   echo "run=$?";   cat /tmp/r
--   $M build $D/raw-probe.mdk -o /tmp/raw > /tmp/b 2>&1; echo "build=$?"
--   /tmp/raw; echo "exec=$?"; /tmp/raw; /tmp/raw
--
-- Measured 2026-08-14:
--   check = 0, silent
--   run   = 1, `runtime error [E-PANIC]: intToString: not an Int` on stderr
--   build = 0, and the binary exits 0 printing a bare decimal word. Three
--           consecutive executions of the SAME binary:
--           47185148492088 / 47242695156024 / 47268389349688
-- THE PRINTED VALUE IS A LIVE HEAP ADDRESS AND IS NOT BYTE-STABLE — three
-- executions, three values — which is why main.mdk pins a projected Bool.
-- The `run` arm is not pinned either: `exit 1 with empty stdout` is exactly the
-- "it crashed" assertion this suite forbids, since an unrelated failure matches
-- it, and this harness's `run` verb does not read stderr at all.
interface Alpha a where
  ping : a -> String

interface Beta a where
  ping : a -> Int

data T = T

impl Alpha T where
  ping _ = "alpha"

impl Beta T where
  ping _ = 7

main = println (ping T)
