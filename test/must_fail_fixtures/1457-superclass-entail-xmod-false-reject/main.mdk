-- #1457: `mkSub` lives in sm.mdk and declares `Sub m =>`. `Base m` is Sub's
-- superclass (`interface Sub f requires Base f`), so the body's `base x` is
-- entailed. Reached through the MULTI-MODULE path it is false-rejected.
-- control.mdk is this same program with everything in ONE file, which is clean.
import sm.{SBag(..), mkSub}

unbag : SBag Int -> Int
unbag (SBag n) = n

main = println (unbag (mkSub 5))
