-- #1457 control: byte-for-byte the same declarations as sm.mdk + main.mdk, with
-- the ONE variable removed -- there is no module boundary. No `export`/`public
-- export` qualifiers and no `import`; everything is in this single file. This
-- must check clean at exit 0 (and run, printing 5). If it breaks, superclass
-- entailment broke in general, not the multi-module path #1457 is about.
data SBag a = SBag a

interface Base f where
  base : a -> f a

interface Sub f requires Base f where
  same : f a -> f a

impl Base SBag where
  base x = SBag x
impl Sub SBag where
  same x = x

mkSub : Sub m => a -> m a
mkSub x = same (base x)

unbag : SBag Int -> Int
unbag (SBag n) = n

main = println (unbag (mkSub 5))
