-- Issue 1580. `h`'s inferred context is rendered over letters (`c`, `d`) that the
-- rendered TYPE never binds: `h : Conv c d => a -> b -> String`.
--
-- The residual is `Conv a b` on h's OWN two argument types (the goal
-- `Conv (Wrap a) (Wrap b)` discharges through the conditional impl below, whose
-- `requires Conv a b` leaves exactly h's arguments), so the correct rendering is
--     h : Conv a b => a -> b -> String
-- The program itself is CORRECT — `run` prints `w:int-bool` at exit 0 with the dict
-- passed — so only the pretty-printer is wrong. See claim.txt.
--
-- Program is the PR #1573 author's own repro, pasted verbatim on that PR after a
-- reviewer's two attempts (a direct call, and a Wrap call with no `requires`) both
-- failed to show it. Both of those are the CONTROL shape; see control.mdk.
data Wrap a = Wrap a

interface Conv a b where
  conv : a -> b -> String

impl Conv Int Bool where
  conv _ _ = "int-bool"

impl Conv (Wrap a) (Wrap b) requires Conv a b where
  conv (Wrap x) (Wrap y) = "w:\{conv x y}"

h x y = conv (Wrap x) (Wrap y)

main = println (h 5 True)
