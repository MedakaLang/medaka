-- issue #1069: `universeDataParamKinds` is keyed by bare type name. `zopapub.mdk`
-- declares its own same-name, same-arity `Box`, and even though main.mdk imports
-- ONLY `apub`'s `Box` (never `zopapub`'s), the loser's param kinds vanish and a
-- written effect row on `apub`'s `Box` silently erases to the wrapped type.
import apub.{Box}
import zopapub.{zf} -- ONLY the function; never zopapub's Box

v : Box (<Stdout> Unit) Int
v = v

main = println "x"
