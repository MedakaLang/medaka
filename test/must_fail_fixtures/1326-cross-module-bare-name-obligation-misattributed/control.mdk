-- SAME shape as main.mdk with ONE variable removed: the `import lib.ps.{h as ph}` line
-- (and the now-unreachable `ph 5` use) are gone. `lib/qs.h : a -> a` is imported alone
-- and called exactly as in main.mdk (`tag (h NoDisp)`). This must stay accepted: the
-- unconstrained `qs.h` alone never triggers a Display obligation.
import lib.qs.{h}

data NoDisp = NoDisp

tag : NoDisp -> String
tag _ = "ok"

main = println (tag (h NoDisp))
