-- CONTROL: keeps launderArrow and its SAME mismatched-prefix signature
-- byte-identical -- exercising the identical same-tail arm and unification path
-- -- but swaps `shout` for `quiet2`, a function honestly TYPED `Unit -> <Stdout>
-- Unit` whose body never actually performs any IO.  Declaring an unused
-- capability is sound, so this stays green and prints `()` with no `SMUGGLED`,
-- isolating the defect to callbacks that actually perform the laundered effect
-- at runtime, not to the type-level mismatch existing at all.  If this breaks,
-- the environment broke, not #1103.
launderArrow : (Unit -> <Stdout | e> Unit) -> (Unit -> <e> Unit)
launderArrow f = f

quiet2 : Unit -> <Stdout> Unit
quiet2 u = ()

quiet : Unit -> Unit
quiet = launderArrow quiet2

main = println (quiet ())
