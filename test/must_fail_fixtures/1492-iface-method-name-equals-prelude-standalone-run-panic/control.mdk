-- CONTROL for #1492: byte-structurally identical to main.mdk with the method renamed
-- `count` -> `zzq`, a name no prelude standalone uses. That is the ONE flipped feature:
-- same interface, same data type, same impl, same call, same marker line. It must `run`
-- clean at exit 0 (measured: prints `probe-reached-main` then `7`), isolating the defect
-- to the NAME COLLISION and not to anything about interfaces, impls, or this shape.
interface Sized c where
  zzq : c -> Int

data Box = Box Int

impl Sized Box where
  zzq (Box n) = n

main =
  println "probe-reached-main"
  println (zzq (Box 7))
