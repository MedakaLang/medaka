-- issue #1492: an interface METHOD whose name equals a PRELUDE STANDALONE makes
-- `medaka run` E-PANIC, while `medaka check` accepts cleanly and the BUILT BINARY
-- prints the correct answer. `count` is stdlib/core.mdk:1285
-- `export count : Foldable t => (a -> <e> Bool) -> t a -> <e> Int` -- a standalone,
-- NOT an interface method. Nothing here mentions Foldable or a predicate.
--
-- The `println "probe-reached-main"` line is the PIN's positive observable: it proves
-- the program was elaborated and started executing, so an unrelated failure earlier in
-- the pipeline (which would print nothing) cannot masquerade as this bug.
--
-- Hand-derived correct answer: 7. The built binary agrees; `medaka run` does not.
interface Sized c where
  count : c -> Int

data Box = Box Int

impl Sized Box where
  count (Box n) = n

main =
  println "probe-reached-main"
  println (count (Box 7))
