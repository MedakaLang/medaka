-- issue #1277 provider B: an UNRELATED module that happens to spell its own
-- type `H` too, under a DIFFERENT interface `Fb`.  Its impl answers 2.  There
-- is no import relationship between a.mdk and b.mdk.
public export data H = MkB Int

export interface Fb x where
  ff : x -> Int

impl Fb H where
  ff _ = 2

export mkB : Int -> H
mkB n = MkB n
