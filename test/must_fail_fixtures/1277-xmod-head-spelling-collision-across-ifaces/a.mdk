-- issue #1277 provider A: a type spelled `H`, an interface `Fa`, and the impl
-- that answers 1.  The method name `ff` is shared with b.mdk's DIFFERENT
-- interface on purpose; the collision under test is the HEAD spelling.
public export data H = MkA Int

export interface Fa x where
  ff : x -> Int

impl Fa H where
  ff _ = 1

export mkA : Int -> H
mkA n = MkA n
