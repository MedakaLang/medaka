-- #1468 — `T` has two named-field constructors and only `A` declares `x`, so a `.x`
-- selection has exactly ONE candidate offset and typecheck accepts it. On `main` there
-- is no well-formedness check on field selection at all (a proposed offset-conflict
-- guard, `T-FIELD-VARIANT-CONFLICT`, exists only on the still-parked PR #1455 and would
-- not fire on this shape anyway — the offsets do not disagree here, only the FIELD SETS
-- do). Nothing anywhere then checks that a `B` value has an `x` at all: the built binary
-- reads `B`'s slot 0 and prints it as the `Int` field `x`.
--
-- `medaka run` REFUSES this program (`E-PANIC unknown field: x`, exit 1) because the
-- interpreter resolves fields by name at run time, which is why the defect is invisible
-- to `check` and `run` and shows only on the executed binary.
data T =
  | A { x : Int }
  | B { z : Int }

mkA : T
mkA = A { x = 7 }

getX : T -> Int
getX t = t.x

main : <IO> Unit
main = putStrLn ("a=" ++ intToString (getX mkA) ++ " v=" ++ intToString (getX (B { z = 99 })))
