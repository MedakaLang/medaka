-- CONTROL: byte-identical to main.mdk except that `Cfg`'s arm names a label `Dfg` does
-- NOT declare (`gamma`), so the two arms' label sets differ and the interpreter's
-- label-set selection lands on the same arm the constructor tag does.  It prints `D11`.
--
-- That isolates the defect to "the arms' label sets do not distinguish the
-- constructors", and rules out `match`, record patterns, `putStrLn` or `medaka run`
-- being broken in general.
data Wrap =
  | Cfg { alpha : Int, gamma : Int }
  | Dfg { beta : Int, alpha : Int }

mkD : Wrap
mkD = Dfg { beta = 22, alpha = 11 }

f : Wrap -> String
f w = match w
  Cfg { gamma = g } => "C" ++ intToString g
  Dfg { alpha = a } => "D" ++ intToString a

main : <IO> Unit
main = putStrLn (f mkD)
