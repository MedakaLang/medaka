-- #1462: `mkD` is a `Dfg`, so `f mkD` must take the `Dfg` arm and print `D11`.
-- The interpreter takes the `Cfg` arm and prints `C11`; the built binary prints `D11`.
-- Both arms bind `alpha` by NAME, which is why the NUMBER is right on both engines and
-- only the arm's own letter differs — the shape that makes this easy to miss.
data Wrap =
  | Cfg { alpha : Int, beta : Int }
  | Dfg { beta : Int, alpha : Int }

mkD : Wrap
mkD = Dfg { beta = 22, alpha = 11 }

f : Wrap -> String
f w = match w
  Cfg { alpha = a } => "C" ++ intToString a
  Dfg { alpha = a } => "D" ++ intToString a

main : <IO> Unit
main = putStrLn (f mkD)
