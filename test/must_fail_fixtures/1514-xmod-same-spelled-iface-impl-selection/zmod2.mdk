-- The CONTROL's sibling of zmod.mdk: byte-identical arithmetic, but the interface and
-- type are spelled differently from amod's (`Same2`/`Blob2` instead of `Same`/`Blob`), so
-- there is no cross-module spelling collision left to trigger the bug.
public export data Blob2 = Blob2 Int

export interface Same2 a where
  sizeOf2 : a -> Int

impl Same2 Blob2 where
  sizeOf2 (Blob2 n) = n + 100

export zValue2 : Int
zValue2 = sizeOf2 (Blob2 10)
