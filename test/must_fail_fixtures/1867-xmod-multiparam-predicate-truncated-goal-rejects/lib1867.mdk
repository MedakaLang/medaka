export interface Dbg a where
  dbg : a -> Int

export interface Ix a b where
  ix : a -> b -> Int

export impl Dbg Int where
  dbg _ = 1

export impl Ix Int Char where
  ix _ _ = 222

export impl Ix Int Bool where
  ix _ _ = 111

export useBoth : (Dbg a, Ix a Char) => a -> Int
useBoth x = dbg x + ix x 'z'
