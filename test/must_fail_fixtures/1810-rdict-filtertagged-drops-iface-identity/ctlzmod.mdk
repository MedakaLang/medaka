-- Control for #1810, other half: same-spelled interface, but its impl is at a
-- DISTINCT head tycon (Widget, not Int) so no dispatcher collision is possible.
export interface Same a where
  sizeOf : a -> Int

data Widget = Widget Int

impl Same Widget where
  sizeOf (Widget n) = n + 100

zWrap : Same a => a -> Int
zWrap x = sizeOf x

export
zValue : Int
zValue = zWrap (Widget 10)
