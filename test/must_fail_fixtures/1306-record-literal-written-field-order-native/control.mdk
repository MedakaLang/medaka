-- CONTROL: identical, except the literal writes the fields in the SAME order they
-- are DECLARED.  Hand-derived expected output `2` then `1`, and every engine agrees
-- -- which is the discriminator: the trigger is precisely "written order differs
-- from declared order", not records, not pattern matching, not `println`.
data R = Rec { q : Int, p : Int }

main =
  let v = Rec { q = 2, p = 1 }
  println (match v
    Rec { q } => q)
  println (match v
    Rec { p } => p)
