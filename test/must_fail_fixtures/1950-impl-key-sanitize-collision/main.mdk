-- #1950: two DISTINCT impls of one method at one head tycon whose canonical
-- dispatch keys collapse onto ONE emitted symbol.
--
-- Both impls head at `Q`, so the C7 arm applies and each is emitted under the
-- SANITIZED canonical key rather than the bare head.  The two keys are
-- `main::Sz|(Q A_B C)|` and `main::Sz|(Q A B_C)|` -- they differ only in where
-- the underscore sits versus where a space sits, and the sanitizer maps every
-- character outside [A-Za-z0-9_] to `_`, so both become
-- `main__Sz__Q_A_B_C__` and both methods want the symbol
-- `mdk_impl_main__Sz__Q_A_B_C___size`.
--
-- `medaka run` answers CORRECTLY (`1|2`) -- the tree-walking interpreter has no
-- symbol mint.  Only `build` is affected, which is why the pinned verb is
-- `build`.
data A = MkA
data B = MkB
data C = MkC
data A_B = MkA_B
data B_C = MkB_C

data Q a b = MkQ a b

interface Sz a where
  size : a -> Int

impl Sz (Q A_B C) where
  size _ = 1

impl Sz (Q A B_C) where
  size _ = 2

main =
  let x = MkQ MkA_B MkC
  let y = MkQ MkA MkB_C
  println "\{size x}|\{size y}"
