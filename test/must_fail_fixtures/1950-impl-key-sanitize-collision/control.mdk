-- CONTROL for #1950: main.mdk with exactly ONE thing changed -- the second
-- impl's type arguments are `A` and `C` / `B` and `C` instead of `A_B` and `C` /
-- `A` and `B_C`, so nothing in either key sits on the underscore-vs-space seam.
--
-- Everything else is identical: same interface, same head tycon `Q`, same TWO
-- distinct impls at that ONE head (so the C7 collision arm still applies and both
-- symbols are still SANITIZED CANONICAL KEYS, not bare head tags), same method,
-- same arity, same two integer results.  The keys are `main::Sz|(Q A C)|` and
-- `main::Sz|(Q B C)|`, which sanitize to the DISTINCT `main__Sz__Q_A_C__` and
-- `main__Sz__Q_B_C__`.
--
-- This is the tightest possible negative control: it isolates the collapse, not
-- the C7 collision arm.  A guard that refused every same-head multi-impl program
-- would break it, so "you refused ordinary C7 dispatch" can never be read as
-- "the #1950 collision guard works".  Hand-derived expected output: `1|2`.
data A = MkA
data B = MkB
data C = MkC

data Q a b = MkQ a b

interface Sz a where
  size : a -> Int

impl Sz (Q A C) where
  size _ = 1

impl Sz (Q B C) where
  size _ = 2

main =
  let x = MkQ MkA MkC
  let y = MkQ MkB MkC
  println "\{size x}|\{size y}"
