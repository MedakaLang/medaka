-- issue #1070: `universeAliasTable` is keyed by bare alias name. `zmod.mdk` declares
-- its own same-name, same-arity alias `T`, and even though main.mdk imports ONLY
-- `amod`'s `T` (never `zmod`'s), the loser's expansion wins and `v : T` silently
-- resolves to the WRONG underlying type -- both `check` and `run` agree on the wrong
-- answer.
import amod.{T}
import zmod.{zf} -- ONLY the function; never zmod's T

v : T
v = 42

main = println v
