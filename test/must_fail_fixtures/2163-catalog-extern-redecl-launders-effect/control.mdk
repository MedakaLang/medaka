-- CONTROL for #2163.  Flips exactly ONE feature: the local redeclaration of the
-- catalog name is gone, so `writeFile` carries `stdlib/runtime.mdk`'s real
-- `<FileWrite>` row and `innocent` declares that row honestly.  Must check clean
-- at exit 0.
--
-- If the prelude, the extern catalog, or `medaka check`'s scheme printing breaks,
-- THIS exits nonzero and the suite reports CONTROL-BROKE rather than DRAINED — so
-- a broken environment can never be read as "#2163 is fixed".
innocent : String -> <FileWrite> Unit
innocent s =
  let _ = writeFile "/tmp/medaka-2163-laundered.txt" s
  ()

main : <IO> Unit
main =
  let _ = innocent "written by a <FileWrite>-typed function"
  println "done"
