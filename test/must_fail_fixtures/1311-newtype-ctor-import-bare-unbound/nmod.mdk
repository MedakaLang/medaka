-- #1311: `NT`'s constructor `Wrap` is UNCONDITIONALLY module-private by design --
-- `public` is a parse error on `newtype`, so there is no spelling that exports it.
-- `unNT` has a redundant wildcard clause solely to keep this file diagnostic-free
-- on its own (newtype single-constructor exhaustiveness is a separate, unrelated
-- known gap -- not what this fixture is about).
export newtype NT = Wrap Int

export unNT : NT -> Int
unNT (Wrap n) = n
unNT _ = 0
