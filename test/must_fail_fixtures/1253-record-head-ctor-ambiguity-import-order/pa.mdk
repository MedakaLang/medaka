-- issue #1253: POSITIONAL-form twin of ra.mdk, kept as the discriminating
-- evidence that the ambiguous-constructor guard exists and works -- just not at
-- a record-form head. See mainpos.mdk for why this cannot be claim.txt's
-- `control:` (it exits 1, and `control:` can only express a control that exits 0
-- -- filed separately as #1144).
public export data TA2 = MkT2 Int
export interface Tag2 a where
  tag2 : a -> String
export impl Tag2 TA2 where
  tag2 _ = "FROM-PA"
