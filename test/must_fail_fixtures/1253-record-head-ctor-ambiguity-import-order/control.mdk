-- issue #1253 control: identical topology to main.mdk (imports TA(..) and
-- TB(..) from two sibling modules, dispatches `tag` through a record-form
-- constructor call) except rb2.mdk's record ctor is MkTB, not MkT -- so `MkT`
-- unambiguously names ra.TA's constructor and there is nothing to be silently
-- wrong about. Must stay diagnostic-free (exit 0, zero diagnostics) and, if run,
-- must print FROM-RA (verified by hand below). A break here means record-form
-- constructor resolution or cross-module dispatch regressed broadly, not that
-- #1253 was fixed.
--
-- Verified against the binary at the SHA this fixture was added:
--   medaka check --json control.mdk  -> zero diagnostics, exit 0
--   medaka check control.mdk         -> `main : Unit`, exit 0
--   medaka run   control.mdk         -> `FROM-RA`, exit 0
import ra.{TA(..), Tag, tag}
import rb2.{TB(..)}
main = println (tag MkT { fx = 1 })
