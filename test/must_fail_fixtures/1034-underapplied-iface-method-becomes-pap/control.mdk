counter : Ref Int
counter = Ref 0

interface Act a where
  act : a -> (Unit -> Unit)

data Dog = Dog

impl Act Dog where
  act d =
    let _ = counter := 1
    (u => ())

main =
  let seen0 = counter.value
  let _ = act Dog ()
  let seen1 = counter.value
  println "seen-before=\{debug seen0} seen-after=\{debug seen1}"
