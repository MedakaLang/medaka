counter : Ref Int
counter = Ref 0

interface Act a where
  act : a -> (Unit -> Unit)

data Dog = Dog

impl Act Dog where
  act d =
    let _ = counter := 1
    (u => ())

main =
  let thunk = act Dog
  let seen = counter.value
  let _ = thunk ()
  println "seen-after-act=\{debug seen} final=\{debug counter.value}"
