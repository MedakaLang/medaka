-- CONTROL for #1062: byte-identical to main.mdk except the second impl sits at a
-- DIFFERENT head tycon -- `Bag String` instead of `Box String`. Everything else is the
-- same: same interface, same sibling-calling default body `loud`, both impls still
-- override `speak`, same constrained forwarding helper, same two receivers. Head-tycon
-- collision vs no collision is the ONE flipped variable, and it is the control the
-- issue body itself states. It must print `<boxint>` then `<boxstr>`. If THIS breaks,
-- sibling-call dispatch inside a default body regressed generally, not #1062.
import iface.{Speak(..), speak, loud}

data Box a = Box a
data Bag a = Bag a

impl Speak (Box Int) where
  speak _ = "boxint"

impl Speak (Bag String) where
  speak _ = "boxstr"

use : Speak a => a -> String
use x = loud x

main =
  let _ = println (use (Box 1))
  println (use (Bag "s"))
