-- issue #1062: two impls of `Speak` share the head tycon `Box` and differ only in the
-- type ARGUMENT (`Box Int` vs `Box String`). BOTH OVERRIDE `speak` -- there is no
-- method-less impl here, so this is not the inherited-default family. `loud` is taken
-- from the interface default, and its body calls the sibling method `speak`. The
-- interpreter does not re-narrow that inner sibling call by the canonical impl key, so
-- it resolves to the FIRST impl at head `Box` for every receiver: eval prints
-- `<boxint>` twice where the correct answer is `<boxint>` then `<boxstr>`.
-- `medaka check` exits 0. Native is CORRECT post-#1058 -- this is the interpreter half.
import iface.{Speak(..), speak, loud}

data Box a = Box a

impl Speak (Box Int) where
  speak _ = "boxint"

impl Speak (Box String) where
  speak _ = "boxstr"

use : Speak a => a -> String
use x = loud x

main =
  let _ = println (use (Box 1))
  println (use (Box "s"))
