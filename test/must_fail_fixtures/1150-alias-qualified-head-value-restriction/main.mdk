-- #1150 (OPEN, verified, S0 memory-safety): the value restriction decides "is this
-- application head a data constructor?" from the FIRST CHARACTER of the head name.
-- A module alias MUST be uppercase (parser.mdk `aliasNameFor`) and an alias-qualified
-- value desugars to a flat `EVar "H.new"` (desugar.mdk, via ast.mdk `qualifiedLocal`),
-- so `H.new ()` reads as a constructor application and `let m = H.new ()` is
-- GENERALIZED -- a polymorphic mutable hash table.
--
-- `medaka check` exits 0 with ZERO diagnostics on this file. That acceptance IS the
-- defect (the value restriction is a typechecker property); the interpreter's
-- E-NOT-A-FUNCTION and the native binary's segfault are downstream of it.
--
-- The one-token discriminator is discriminator.mdk (`H.new ()` -> `new ()`).
import hash_map as H
import hash_map.{HashMap}

putI : HashMap String Int -> Unit
putI m = H.set "k" 1 m

getF : HashMap String (Int -> Int) -> Option (Int -> Int)
getF m = H.get "k" m

main =
  let m = H.new ()
  let _ = putI m
  match getF m
    Some f => println (debug (f 10))
    None => println "none"
