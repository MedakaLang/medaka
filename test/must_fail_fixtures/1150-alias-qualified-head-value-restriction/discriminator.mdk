-- DISCRIMINATOR for #1150 -- NOT wired as this fixture's `control:`, and it cannot be:
-- `diff_compiler_must_fail.sh` requires a control to EXIT 0
-- (`[ "$crc" = 0 ] || ctl_broke=...`, which is issue #1144), and this program is
-- CORRECTLY REJECTED, exit 1.
-- It ships here as evidence and as a hand-run probe; see claim.txt `why-discriminator:`.
--
-- ONE TOKEN differs from main.mdk: the `let` RHS head `H.new ()` is spelled `new ()`
-- (with `new` added to the selective import list). `H.set` and `H.get` are UNCHANGED,
-- so the alias import itself is still present and still used. Verified output:
--
--   $ medaka check discriminator.mdk
--   discriminator.mdk:<the `match getF m` line>:13: Type mismatch: Int -> Int vs Int
--   exit 1
--
-- (the line NUMBER is deliberately not written here -- it moves whenever this comment
--  header does; claim.txt records the run verbatim.)
--
-- That isolates the defect to the ALIAS QUALIFICATION OF THE GENERALIZED BINDING'S
-- HEAD -- not to `HashMap`, not to alias imports as such, not to the program's shape.
import hash_map as H
import hash_map.{HashMap, new}

putI : HashMap String Int -> Unit
putI m = H.set "k" 1 m

getF : HashMap String (Int -> Int) -> Option (Int -> Int)
getF m = H.get "k" m

main =
  let m = new ()
  let _ = putI m
  match getF m
    Some f => println (debug (f 10))
    None => println "none"
