-- CONTROL for #1150. Byte-identical to main.mdk except `getF`'s element type is `Int`
-- instead of `Int -> Int` (two tokens on the signature, one in the body), which makes
-- the program GENUINELY WELL-TYPED: the table is written and read at one and the same
-- type, so nothing turns on whether `let m = H.new ()` was generalized.
--
-- It must stay diagnostic-free. It exercises the SAME machinery the pinned row does --
-- the `as H` alias import, the alias-qualified heads `H.new` / `H.set` / `H.get`, the
-- stdlib `HashMap` type -- so a break here means alias imports, hash_map, or the check
-- pipeline regressed, NOT that #1150 was fixed. It also survives the fix: under a
-- corrected value restriction `m` is simply a monotype, unified to `HashMap String Int`
-- by `putI m` and read back at that same type.
--
-- Verified to `medaka run` clean too (prints `11`).
import hash_map as H
import hash_map.{HashMap}

putI : HashMap String Int -> Unit
putI m = H.set "k" 1 m

getF : HashMap String Int -> Option Int
getF m = H.get "k" m

main =
  let m = H.new ()
  let _ = putI m
  match getF m
    Some f => println (debug (f + 10))
    None => println "none"
