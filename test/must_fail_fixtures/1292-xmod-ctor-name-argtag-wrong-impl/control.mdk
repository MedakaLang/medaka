-- CONTROL: byte-for-byte the shape of main.mdk -- same lambda, same arg-tag path,
-- same two impls in the graph -- with the ONLY difference being that the imported
-- constructor's spelling does not collide with c1292a's.  Correct answer `cmod`,
-- and it is what every engine prints.  So the trigger is the cross-module bare
-- CONSTRUCTOR-NAME collision, not the lambda and not the two impls.
import c1292i.{Label, label}
import c1292a.{TA}
import c1292c.{TC, Crateee}

main =
  let f = v => label v
  println (f (Crateee 5))
