-- issue #1043: a `let`-bound helper INSIDE A BLOCK (a `let` that appears as a
-- statement in a `main`/do-style body, as opposed to a `where`-group) that
-- calls an interface method (`debug`) cannot be BUILT natively. `medaka check`
-- exits 0; `medaka run` (the interpreter) is CORRECT (prints `2`). `medaka
-- build` fails: exit 1, `error: emitter failed compiling <file>` followed by
-- `runtime error [E-PANIC]: arg-tag dispatch on impl type that owns no
-- constructors (primitive receiver carries no cell tag)`. Moving the exact same
-- helper into a `where`-group instead of a block-`let` builds fine (see
-- control.mdk) -- block-`let` is the trigger.
main =
  let d v = debug v
  println (d 2)
