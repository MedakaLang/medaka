-- CONTROL for #1043: the SAME helper (`d v = debug v`) calling the SAME
-- interface method, but attached as a `where`-GROUP on a top-level binding
-- instead of a block-`let` statement inside `main`. That is the ONE flipped
-- feature -- where-group vs block-let -- so it must BUILD FINE (exit 0),
-- isolating the defect to block-let specifically, not to a local helper
-- calling an interface method in general.
top = d 2
  where
    d v = debug v

main = println top
