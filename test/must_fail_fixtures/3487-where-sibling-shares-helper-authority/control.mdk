data Dir (d : Authority FileRead) = Dir (String @d)

mk : (s : String) -> Dir s
mk s = Dir s

readUnder : Dir d -> (p : String @d) -> <FileRead d> Result String String
readUnder _ p = readFile p

cfg : Dir "cfg/*"
cfg = mk "cfg/*"

app : Dir "cfg/app"
app = mk "cfg/app"

showR r = match r
  Ok s => "READ: " ++ s
  Err e => "ERR: " ++ e

-- #3487 control: the same helper, called from the block's body rather than
-- by a sibling, so no other member mentions its authority.
readOne h d = rd d
  where
    rd (Dir p) = showR (readUnder h p)

onlyCfg : Unit -> <FileRead "cfg/*"> String
onlyCfg _ = readOne cfg app

main = println (onlyCfg ())
