-- CONTROL for the #1154 residual.  Byte-identical to main.mdk except the two
-- `impl Ix` BLOCKS are swapped -- a reordering that changes no program meaning.
-- That single change flips the answer to the CORRECT 227, which is the whole
-- defect: declaration order decides.
--
-- Per #1144 this harness grades a control on its EXIT CODE ONLY, and a
-- wrong-value-at-exit-0 bug cannot be discriminated by an exit code unless the
-- program puts the value INTO the exit code.  So `main` ASSERTS 227 and panics
-- otherwise, rather than printing it -- a control that merely printed would
-- exit 0 either way and could never fail.
interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Char where
  ix _ _ = 222

impl Ix Int Bool where
  ix _ _ = 111

interface Dbg2 a where
  dbg2 : a -> Int

impl Dbg2 Int where
  dbg2 n = n

data Box a = MkBox a

interface Sh a where
  sh : a -> Int

impl Sh (Box a) requires Ix a Char, Dbg2 a where
  sh (MkBox x) = ix x 'z' + dbg2 x

main =
  let r = sh (MkBox 5)
  if r == 227 then
    println "control-ok:227"
  else
    panic "control regressed: swapping the impl blocks no longer yields the correct 227"
