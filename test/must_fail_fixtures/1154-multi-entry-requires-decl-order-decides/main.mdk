-- #1154 RESIDUAL: a TWO-ENTRY `requires` is STILL declaration-order-decided
-- after F-3a-i threaded the full goal vector through the `requires` route.
--
-- THE CORRECT ANSWER IS 227.  `impl Sh (Box a) requires Ix a Char, Dbg2 a`
-- pins the second `Ix` parameter to Char, and the body calls `ix x 'z'` with
-- `'z' : Char`, so `impl Ix Int Char` (222) is the only satisfying instance;
-- `dbg2 5` is 5.  222 + 5 = 227.
--
-- This file reproduces the BUG: it prints 116 (= 111, the `Ix Int Bool` body,
-- + 5).  Swapping the two `impl Ix` BLOCKS -- a reordering that changes no
-- program meaning -- flips both engines to 227.  See control.mdk.
--
-- ⚠️ ONE-TOKEN NEIGHBOUR THAT IS ALREADY FIXED: with a SINGLE-entry
-- `requires Ix a Char` this shape is CORRECT on the current binary -- that is
-- test/dict_fixtures/s3-nary-requires-goal-vector.mdk, which asserts 222.  The
-- residual needs >= 2 requires entries, which is exactly why the positive
-- fixture cannot see it and this pin is owed.
interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Bool where
  ix _ _ = 111

impl Ix Int Char where
  ix _ _ = 222

interface Dbg2 a where
  dbg2 : a -> Int

impl Dbg2 Int where
  dbg2 n = n

data Box a = MkBox a

interface Sh a where
  sh : a -> Int

impl Sh (Box a) requires Ix a Char, Dbg2 a where
  sh (MkBox x) = ix x 'z' + dbg2 x

main = println (sh (MkBox 5))
