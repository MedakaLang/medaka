-- issue #1386: `A.mth` unambiguously names ifacea's `IA.mth` -- `A` is an alias
-- of `ifacea`, and `ifacea` exports no standalone `mth`, only `IA.mth`. `Blob`
-- implements only `IB` (method `mthb`), never `IA`. Correct verdict: reject
-- with `No impl of IA for Blob; write an 'impl IA Blob'.` -- exactly what the
-- non-alias spelling `import ifacea.{IA, mth}; mth Blob` produces (verified by
-- hand, not itself part of this pin's cmd/control).
--
-- Observed: `medaka check` exits 0, `main : Unit`, no diagnostic at all. The
-- impl obligation for an alias-qualified method occurrence is never checked.
import ifacea as A
import ifaceb.{IB}

public export data Blob = Blob

export impl IB Blob where
  mthb b = 2

main = println (A.mth Blob)
