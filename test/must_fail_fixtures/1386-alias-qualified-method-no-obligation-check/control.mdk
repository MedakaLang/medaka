-- CONTROL for #1386. This harness grades a control on its EXIT CODE ONLY and a
-- control must exit 0 (test/diff_compiler_must_fail.sh's `run_verb`/`ctl_broke`
-- logic), so it cannot be the "correctly rejects" cell (exit 1) -- the shape
-- that would isolate main.mdk most directly (same program, non-alias spelling)
-- is NOT expressible here for exactly that reason.
--
-- So, following #1276's own control (test/must_fail_fixtures/
-- 1276-alias-method-provenance-erased/control.mdk): keep the SAME
-- alias-qualified call shape (`A.mth Blob`) and the SAME two-interface
-- program, and let `Blob` genuinely implement `IA` -- the interface the
-- occurrence actually names. A valid program that must ACCEPT and print 1.
-- If it breaks, alias-qualified method resolution broke outright, not #1386's
-- narrower "obligation never checked" defect.
--
-- ⚠️ `IA` needs a separate by-name import: an alias binds VALUES only, and an
-- alias-qualified name in TYPE position is a parse error, so `impl A.IA Blob`
-- is not spellable.
import ifacea as A
import ifacea.{IA}
import ifaceb.{IB}

public export data Blob = Blob

export impl IB Blob where
  mthb b = 2

export impl IA Blob where
  mth b = 1

main = println (A.mth Blob)
