-- #1180 AMBIGUITY PROBE — identical to main.mdk with the fully-general `impl Sz a`
-- replaced by a second CONCRETE impl. Two matching instances, same undetermined goal.
--
-- ⚠️ This file is NOT run by the must-fail gate: the harness grades a control on its
-- exit code and requires 0 (#1144), and this program is correctly REJECTED at exit 1.
-- It is shipped because it settles the one question main.mdk alone cannot answer —
-- whether `routeUndeterminedTop`'s ambiguity arm is even live in this file shape. It
-- is: the silence in main.mdk is a property of the HEADLESS impl being invisible to the
-- head counter, not of a dead probe.
--
-- Re-derive in one command (measured 2026-08-01, exit 1) rather than trusting this note:
--   medaka check --json ambiguity-probe.mdk
--   -> T-AMBIGUOUS-INSTANCE, "Ambiguous instance for `Sz`. Cannot determine which impl;
--      add a type annotation", on `szTag` in the `roundtrip` body.
interface Sz a where
  szNew : Int -> a
  szTag : a -> Int

data Widget = Widget Int
data Gadget = Gadget Int

impl Sz Widget where
  szNew n = Widget (n * 3)
  szTag (Widget n) = n

impl Sz Gadget where
  szNew n = Gadget (n * 5)
  szTag (Gadget n) = n

roundtrip : Sz a => Int -> Int
roundtrip n = szTag (szNew n)

main = println (roundtrip 14)
