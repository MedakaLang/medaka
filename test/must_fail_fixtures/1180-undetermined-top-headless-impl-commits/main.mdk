-- #1180: an UNDETERMINED top-level constraint whose interface has a fully-general
-- `impl Sz a` alongside one concrete impl is silently COMMITTED to the concrete impl.
-- The goal reaching quiescence is `Sz ?a` with `?a` neither ground nor rigid, so
-- DICT-SEMANTICS §6.2 T3 forbids `inst` from firing at all. Two instances match.
-- CORRECT ANSWER: the T-AMBIGUOUS-INSTANCE rejection that control.mdk already produces.
-- This file is the BUG: check is clean, run prints 42, build crashes with an E-PANIC.
interface Sz a where
  szNew : Int -> a
  szTag : a -> Int

data Widget = Widget Int

impl Sz Widget where
  szNew n = Widget (n * 3)
  szTag (Widget n) = n

impl Sz a where
  szNew _ = panic "general szNew"
  szTag _ = 7

roundtrip : Sz a => Int -> Int
roundtrip n = szTag (szNew n)

main = println (roundtrip 14)
