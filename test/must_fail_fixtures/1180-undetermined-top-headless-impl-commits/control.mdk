-- #1180 CONTROL — identical to main.mdk with the fully-general `impl Sz a` DELETED.
-- Flips exactly one dimension: the presence of the headless impl. One impl remains, so
-- the undetermined constraint has a genuinely unique instance and committing to it is
-- correct. This fixes 42 as the CONCRETE impl's value, which is what identifies WHICH
-- impl main.mdk silently selected.
-- Per #1144 this harness grades a control on its EXIT CODE ONLY, so this asserts 42 and
-- panics otherwise rather than printing it.
interface Sz a where
  szNew : Int -> a
  szTag : a -> Int

data Widget = Widget Int

impl Sz Widget where
  szNew n = Widget (n * 3)
  szTag (Widget n) = n

roundtrip : Sz a => Int -> Int
roundtrip n = szTag (szNew n)

main =
  let r = roundtrip 14
  if r == 42 then
    println "control-ok:42"
  else
    panic "control regressed: the sole `impl Sz Widget` no longer yields 42"
