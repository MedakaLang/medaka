-- UNGRADED EVIDENCE, module half. Same shape as speakerb.mdk, but the body is
-- ILL-TYPED under its OWN declared signature (`p : DogC`, used as a String) and
-- well-typed only under speakera's (`String -> x -> String`). If the emit path's
-- wrong-interface attribution ever reached ACCEPTANCE, this would be accepted.
public export data DogC = DogC

export interface Speak x where
  speak : x -> String -> String

impl Speak DogC where
  speak p _ = intToString (stringLength p)

export useC : String
useC = speak DogC "z"
