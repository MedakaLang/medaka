-- #1647 fixture, module B. SAME interface spelling, SAME method spelling, the
-- OTHER argument order: `x -> String -> String`. Under B's own declaration the
-- body's `s` is a String; under A's declaration it would be the class parameter,
-- i.e. `DogB` — which is exactly what the emit path believes.
public export data DogB = DogB

export interface Speak x where
  speak : x -> String -> String

impl Speak DogB where
  speak _ s = "B(\{s})"

export useB : String
useB = speak DogB "y"
