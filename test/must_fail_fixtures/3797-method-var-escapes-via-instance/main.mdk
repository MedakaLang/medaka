-- #3526 shape on a METHOD-scheme variable (W3): w's `b` is caller-owned; the body
-- poses Get (Box (List t)) b, which the instance matches only if b := List t.
-- Expected: rejected.
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

interface W x where
  w : x -> b -> b

impl W Int where
  w _ _ = get (Box [])

main = println (w (1 : Int) 41 + 1)
