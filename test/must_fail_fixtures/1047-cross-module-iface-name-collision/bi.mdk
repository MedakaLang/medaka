-- issue #1047: B's implementor. `impl Speak DogB` is METHOD-LESS, so it inherits
-- b.mdk's default body ("B-default") -- and that is the fact that is lost when both
-- interfaces are keyed by the bare name `Speak`.
import b.{Speak(..), speak}

public export data DogB = DogB

impl Speak DogB where

export sayB : DogB -> String
sayB d = speak d
