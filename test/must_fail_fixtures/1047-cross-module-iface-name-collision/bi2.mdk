-- CONTROL half for #1047: bi.mdk against the RENAMED interface. Identical to bi.mdk
-- except `Speak`/`speak` -> `Speak2`/`speak2`. The impl is still METHOD-LESS, so it
-- still inherits the default body -- the only changed variable is the interface name.
import b2.{Speak2(..), speak2}

public export data DogB = DogB

impl Speak2 DogB where

export sayB : DogB -> String
sayB d = speak2 d
