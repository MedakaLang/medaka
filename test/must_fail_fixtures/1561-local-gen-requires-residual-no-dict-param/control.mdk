-- CONTROL for issue 1561, and THE DISCRIMINATOR OF THE ISSUE.  ONE flipped dimension:
-- the local binding's constraint arrives DIRECTLY from the method call (`tagOf z`)
-- instead of as the residual of a `requires` discharge.  Same `let`-local binder, same
-- local generalization, same call shape, same interface, same marker.
--
-- HAND-DERIVED: the goal `Tag t` is already a bare tyvar, so `inner : Tag a =>
-- a -> String`, ITS DICT IS ABSTRACTED, and the binary prints
--     start
--     int
-- at exit 0.
--
-- This is the row that refutes "local bindings never get a dict parameter" (the broad
-- local-`gen` gap of issue 1082, which PR 1552's body cites for this cell): the local
-- path handles a DIRECT constraint correctly on this very build, so the sibling's crash
-- is specific to the `requires` RESIDUAL.  If THIS row breaks, local generalization
-- itself broke — an ENVIRONMENT break, never evidence about issue 1561.
main =
  let _ = println "start"
  println (useLocal 5)

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

useLocal y =
  let inner z = tagOf z
  inner y
