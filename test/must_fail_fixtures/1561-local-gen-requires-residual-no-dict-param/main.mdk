-- Issue 1561: a LET-LOCAL binding whose inferred context is the RESIDUAL of a
-- `requires` discharge gets no dict parameter, so the built binary faults.
-- THIS PROGRAM IS LEGAL.
--
-- HAND-DERIVED FROM THE SPEC, BEFORE THE BINARY WAS ASKED (DICT-SEMANTICS §3 `inst`,
-- §4/§4.1 `gen`, §4.2 OD2):
--   `tagOf (Wrap z)` poses `Tag (Wrap t)`.  The only matching instance is
--   `impl Tag (Wrap a) requires Tag a`, whose discharge leaves the RESIDUAL `Tag t`.
--   `inner` generalizes over `t`, so `inner : Tag a => a -> String` and `gen` must
--   abstract one dict for it.  `useLocal 5` instantiates at `a = Int`; `impl Tag Int`
--   answers "int"; so the CORRECT behaviour is to print
--       start
--       wrap(int)
--   at exit 0.  The pinned `exit: 139` with stdout `start` is THE BUG.
--
-- The "start" marker is printed BEFORE the constrained call on purpose: it makes the
-- pinned observation "the binary ran, produced its first line, and then faulted AT the
-- local binding's call", which a crash from any unrelated cause at startup would not
-- match.
main =
  let _ = println "start"
  println (useLocal 5)

data Wrap a = Wrap a

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

impl Tag (Wrap a) requires Tag a where
  tagOf (Wrap x) = "wrap(\{tagOf x})"

useLocal y =
  let inner z = tagOf (Wrap z)
  inner y
