interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Bool where
  ix _ _ = 111

impl Ix Int Char where
  ix _ _ = 222

interface Jx a b where
  jx : a -> b -> Int

impl Jx Int Char where
  jx _ _ = 2220

impl Jx Int Bool where
  jx _ _ = 1110

useIx : Ix a b => a -> b -> Int
useIx p q = ix p q

useJx : Jx a b => a -> b -> Int
useJx p q = jx p q

main = println (useIx 5 'z' + useJx 5 'z')
