-- An inherited default calls a SUPER method on its receiver; the super has a general
-- instance AND a more specific one at the receiver's type. DICT §2/§3: supers are
-- resolved per construction goal, so `nm` inside `loud` at `Box Int` must reach the
-- SPECIFIC `Named (Box Int)`. Expected: [b:spec]|[b:gen(cat)]
interface Named a where
  nm : a -> String
interface Fmt a requires Named a where
  fmt : a -> String
  loud : a -> String
  loud x = "[" ++ fmt x ++ ":" ++ nm x ++ "]"
data Cat = Cat
data Box a = Box a
impl Named Cat where
  nm _ = "cat"
impl Named Int where
  nm _ = "int"
impl Fmt Cat where
  fmt _ = "b"
impl Fmt Int where
  fmt _ = "b"
impl Named (Box a) requires Named a where
  nm (Box v) = "gen(" ++ nm v ++ ")"
impl Named (Box Int) where
  nm (Box v) = "spec"
impl Fmt (Box a) requires Fmt a where
  fmt (Box v) = fmt v
shout : Fmt a => a -> String
shout x = loud x
main = println (shout (Box (1 : Int)) ++ "|" ++ shout (Box Cat))
