-- issue #1281: imports `aaf` (NOT `Cfg`) from aacfg.mdk, and `Cfg` from zzcfg.mdk.
-- `Cfg` at the literal `Cfg { fld = 7 }` construction can only mean zzcfg's `Cfg` --
-- the sole `Cfg` this module ever brings into scope -- so the correct, and
-- interpreter-given, answer is `7`. The built binary faults before printing anything.
import aacfg.{aaf}
import zzcfg.{Cfg}

v : Cfg
v = Cfg { fld = 7 }

main = println v.fld
