-- CONTROL for issue #1281: byte-identical structure to main.mdk (same imports,
-- same construction, same field access), except BOTH `Cfg` records declare
-- `fld : Int` (aaint.mdk / zzint.mdk) -- the type-name collision is still present,
-- only the differing FIELD TYPE is removed. Per the issue's own sharpening this
-- must build-run clean (exit 0, prints `7`), proving the type-name collision alone
-- is not the trigger -- the differing field type is.
import aaint.{aaf}
import zzint.{Cfg}

v : Cfg
v = Cfg { fld = 7 }

main = println v.fld
