-- CONTROL: the issue's own iso1 isolation probe.  BYTE-IDENTICAL `box`/`getBox` --
-- same top-level CAF, same MyBox/Ref, same closure -- but the application
-- `(getBox box) ()` is inlined directly in `main` instead of living in a
-- separate top-level `callBox`.  That ONE structural difference (a distinct
-- top-level caller vs. inlined in main) is what the issue's own boundary
-- isolation established as required for the bug to reproduce at all.  It must
-- build-run clean (exit 0) and print `CALLED`, proving the CAF and the
-- closure-returning `getBox` are otherwise intact -- if this breaks, the
-- environment broke, not #1101.
data MyBox a = MyBox (Ref a)

getBox : MyBox a -> a
getBox (MyBox r) = r.value

box : MyBox (Unit -> <Stdout> Unit)
box = MyBox (Ref (u => putStrLn "CALLED"))

main = (getBox box) ()
