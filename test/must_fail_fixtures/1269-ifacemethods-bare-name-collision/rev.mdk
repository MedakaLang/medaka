-- issue #1269: `Env.ifaceMethods` (compiler/frontend/resolve.mdk) is an assoc list keyed
-- by BARE interface name and scanned FIRST-MATCH by `ifaceMethodsOf`. `gmod` is imported
-- FIRST, so its `Same` wins the shared key and `checkMethodMember` validates this impl's
-- method names against `gmod.Same`'s method set -- rejecting `pmth`, which is the only
-- method of the only `Same` this file imports.
--
-- ⚠️ IMPORT ORDER IS THE FIXTURE. With `pmod` imported first this program checks clean;
-- that is the order the (drained) #1257 fixture pinned, which is why this half survived
-- #1257's fix.
import gmod.{gdummy} -- ONLY the function; never gmod's Same
import pmod.{Same, pmth}

data P a b = MkP a b

impl Same P where
  pmth p = 1

main = println (pmth (MkP 1 2))
