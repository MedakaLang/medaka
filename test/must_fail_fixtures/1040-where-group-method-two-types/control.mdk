-- CONTROL for #1040: byte-similar to main.mdk except the `where`-group helper
-- `d` is called at only ONE ground type (`Int`), not two. That is the ONE
-- flipped feature -- single call-site type vs two DIFFERING call-site types --
-- so it must build-run clean and print the correct `debug` rendering of `2`,
-- isolating the defect to a where-helper monomorphized across two DIFFERENT
-- types at its call sites, not to where-groups or `debug` in general.
top : String
top = d 2
  where
    d v = debug v

main = println top
