-- SAME shape as main.mdk (same two `println` calls, same dedup-colliding `Display` at a
-- 2-tuple head), but `Color` genuinely HAS a `Display` impl here. Both obligations are
-- actually satisfiable, so accepting this program is correct -- isolating the ONE
-- distinguishing feature from main.mdk: whether the type at the shared dedup key
-- actually implements the interface, not the dedup collision itself (which is present in
-- both files).
data Color = Red deriving (Display)

main =
  let _ = println (Red, 3)
  println (1, 2)
