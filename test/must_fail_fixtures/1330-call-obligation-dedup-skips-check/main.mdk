-- #1330 verbatim repro: two `println` calls of a 2-tuple both dispatch `Display` at the
-- same tuple head, so their call-channel obligations share a dedup key. `Color` has no
-- Display impl -- alone (see control.mdk's sibling shape) it is correctly rejected -- but
-- here the SECOND, well-typed obligation (`(1, 2)`, both Int) shares the dedup key with
-- the first, and the collision drops the first obligation's check entirely.
data Color = Red

main =
  let _ = println (Red, 3)
  println (1, 2)
