-- CONTROL for #1037: byte-identical to main.mdk except the `impl Speak Cat`
-- block carries NO decl attribute. That is the ONE flipped feature -- presence
-- vs absence of `@deprecated "old"` on the impl -- so `medaka run` must dispatch
-- both receivers correctly (prints `meow` then `DEFAULT`). If THIS breaks,
-- dispatch regressed generally, not #1037 specifically.
import iface.{Speak(..), speak}

data Cat = Cat
data Dog = Dog

impl Speak Cat where
  speak _ = "meow"

impl Speak Dog where

use : Speak a => a -> String
use x = speak x

main =
  let _ = println (use Cat)
  println (use Dog)
