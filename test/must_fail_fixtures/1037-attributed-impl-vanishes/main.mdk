-- issue #1037: a DECL ATTRIBUTE (`@deprecated "old"`) on an `impl` block makes
-- the impl VANISH from both the interpreter and the native backend. eval falls
-- back to the interface's default body for the attributed impl's type (silent
-- wrong answer); native SEGFAULTS. `medaka check` exits 0 throughout.
import iface.{Speak(..), speak}

data Cat = Cat
data Dog = Dog

@deprecated "old"
impl Speak Cat where
  speak _ = "meow"

impl Speak Dog where

use : Speak a => a -> String
use x = speak x

main =
  let _ = println (use Cat)
  println (use Dog)
