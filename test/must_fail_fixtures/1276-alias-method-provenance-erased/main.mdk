-- issue #1276: `A.mth` unambiguously names ifacea's `IA.mth` -- the alias `A` is
-- the ONLY provider of `mth` in this file -- and `Blob` has no `IA` impl at all,
-- only an `IB` one. This must be rejected with `No impl of IA for Blob`. It is
-- not: check and run are clean and it prints `2`, IB's impl body.
--
-- `import m as A` produces a `UseAlias` path, `importedBindings` yields `Some []`
-- for it, so `usePathBindsName` (compiler/types/typecheck.mdk) is False for every
-- name and NO candidate is ever witnessed. By the time this table is consulted
-- the occurrence has already been rewritten to a bare `mth` by
-- `renameAliasedMethods`, so its provenance is gone. Not a regression -- main @
-- e572da09 prints `2` here too.
import ifacea as A
import ifaceb.{IB}

public export data Blob = Blob

export impl IB Blob where
  mth b = 2

main = println (A.mth Blob)
