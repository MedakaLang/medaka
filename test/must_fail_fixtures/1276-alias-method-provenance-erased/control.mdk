-- CONTROL for #1276. This harness grades a control on its EXIT CODE ONLY and a
-- control must exit 0, so it cannot be the "correctly rejects" cell (exit 1).
--
-- So it keeps the SAME alias-qualified call shape (`A.mth Blob`) and the SAME
-- two-module collision, and lets `Blob` implement `IA` -- the interface the
-- occurrence actually names. A valid program that must print 1. If it breaks,
-- alias imports or alias-qualified method calls broke, not #1276.
--
-- ⚠️ `IA` needs a separate by-name import: an alias binds VALUES only, and an
-- alias-qualified name in TYPE position is a parse error, so `impl A.IA Blob`
-- is not spellable.
import ifacea as A
import ifacea.{IA}
import ifaceb.{IB}

public export data Blob = Blob

export impl IA Blob where
  mth b = 1

main = println (A.mth Blob)
