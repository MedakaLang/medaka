-- #3526 through a generalized local inside a signed top-level function.
-- Expected: rejected like `weird : b -> b; weird _ = get (Box [])`.
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

weird2 : b -> b
weird2 x =
  let k u = get (Box [])
  k x

main = println (weird2 41 + 1)
