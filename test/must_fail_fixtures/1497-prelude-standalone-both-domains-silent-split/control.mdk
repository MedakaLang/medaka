-- CONTROL for #1497: byte-structurally identical to main.mdk with the method renamed
-- `isEven` -> `zzq`, a name no prelude standalone uses. That is the ONE flipped feature:
-- same interface, same impl, same receiver, same marker line, same `println` of a Bool.
-- It must `run` clean at exit 0 -- measured: prints `probe-reached-main` then `True`, and
-- the BUILT BINARY prints the same `True`, so the two execution arms AGREE. That isolates
-- the defect to the prelude-standalone NAME COLLISION and not to anything about
-- interfaces, impls, dispatch, or this program shape.
interface Parity c where
  zzq : c -> Bool

impl Parity Int where
  zzq n = True

main =
  println "probe-reached-main"
  println (zzq 7)
