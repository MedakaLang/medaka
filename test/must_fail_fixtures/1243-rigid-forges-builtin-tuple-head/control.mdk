-- CONTROL: byte-identical to main.mdk except the field's rigid is spelled `zzz`
-- instead of `__tuple2__`, and `g`'s result type is `Bad` rather than the builtin
-- pair `(Int, Int)`.  An ordinary rigid in a constructor field, and a signature
-- over it, must keep working — if THIS breaks, rigids broke generally and the
-- environment moved, not the forgery.
data Bad = Bad (zzz Int Int)

g : Bad -> Bad
g b = b

sane : Int -> Int
sane n = n
