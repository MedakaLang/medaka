-- `__tuple2__` is a legal TYPE-PARAMETER spelling (identStartLower admits a
-- leading `_`), so `Bad`'s field applies a RIGID VARIABLE, not the tuple head.
-- `g` then claims that rigid IS the builtin pair head, and it is accepted.
data Bad = Bad (__tuple2__ Int Int)

g : Bad -> (Int, Int)
g (Bad v) = v

-- proves the command reached the scheme dump rather than dying early
sane : Int -> Int
sane n = n
