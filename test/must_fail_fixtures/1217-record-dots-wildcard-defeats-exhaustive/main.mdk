-- issue #1217: `desugarPat _ (PRec _ _ True) = PWild` (compiler/frontend/exhaust.mdk:233)
-- lowers a `{ ... }` record pattern to a bare wildcard for exhaustiveness, discarding
-- the constructor entirely. `Circle { ... }` reads as "match anything", not "match a
-- Circle, ignoring its remaining fields" -- so `area` is (wrongly) accepted as
-- exhaustive, and a Square silently takes the Circle arm.
data Shape = Circle { r : Int } | Square { s : Int }

area : Shape -> Int
area sh = match sh
  Circle { ... } => 1

main = println (area (Square { s = 2 }))
