-- CONTROL: the identical match with `Circle { ... }` replaced by a plain binder
-- `Circle c` -- the one variable this isolates. Exhaustiveness checking works
-- correctly without `...`: `medaka check` reports a real W-NONEXHAUSTIVE warning
-- (a warning, not a hard error, so `check` still exits 0 -- expressible as a green
-- control) naming the missing `Square` case. If this control breaks (no warning, or
-- check starts failing outright), exhaustiveness checking broke in general, not
-- specifically the `...` lowering #1217 pins.
data Shape = Circle { r : Int } | Square { s : Int }

area : Shape -> Int
area sh = match sh
  Circle c => 1

main = println (area (Square { s = 2 }))
