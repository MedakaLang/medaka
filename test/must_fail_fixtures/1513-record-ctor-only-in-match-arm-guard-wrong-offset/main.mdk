-- #1513: `B`'s ONLY construction site is inside a MATCH-ARM GUARD.  The LLVM
-- emitter builds its record label-order table by scanning construction sites
-- (`scanExprRecords`), and `scanArmsRecords` scans an arm's BODY only -- never
-- its guard qualifiers -- so `B` never enters the table.  `getK`'s field access
-- then falls back to the label-only search, which answers with `A` (the only
-- record in the table owning `k`) and emits `A`'s index for `k`.
--
-- `A.k` is at index 1, `B.k` at index 0, so the built binary reads a `B` cell's
-- SECOND word: `q`, not `k`.  See control.mdk -- identical program with the
-- construction moved out of the guard.
data A = A { p : Int, k : Int }
data B = B { k : Int, q : Int }

getK : B -> Int
getK b = b.k

readK : Int -> Int
readK n = match n
  0 if Some b <- Some (B { k = 7, q = 99 }) => getK b
  _ => 0

main =
  let a = A { p = 10, k = 5 }
  let _ = println a.k
  println (readK 0)
