-- issue #1472: `g` is UNCONSTRAINED (`Int -> Int`), declared in lib/plain.mdk,
-- re-exported by lib/rplain.mdk via `export import`, and imported HERE with an
-- ALIAS spelling (`as R` / `R.g`). check/run both accept and run correctly
-- (run prints the CORRECT `2`), and build succeeds too -- but the emitted
-- `println` call (a PRELUDE, constrained method the user program never
-- touches) gets a NULL dict pointer, and the built binary segfaults before
-- printing anything.
import lib.rplain as R

main = println (R.g 1)
