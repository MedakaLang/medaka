-- #3502: a handle's authority is a flexible variable while the match arm is
-- inferred, so `p ++ x` keeps the variable; it is later solved to the exact
-- element "/etc", and the grant claims that one path while the read is of
-- "/etc" ++ x.  No caller is involved.
data Handle (p : Authority FileRead) = Handle (String @p)

readAny : String -> <FileRead "/etc"> Result String String
readAny x = match Handle "/etc"
  Handle p => readFile (p ++ x)

main = println 1
