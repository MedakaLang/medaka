-- CONTROL: byte-identical to main.mdk except ONE impl arm, which DEFERS instead of
-- applying eagerly (`Susp (u => g a)` for `Done (g a)`).  Constructing the Box then
-- charges nothing, `runBox` is still never called, and no effect happens — which is the
-- semantics EFFECTS-SEMANTICS §6 promises for a deferred graded value.
--
-- It isolates #1095 to the EAGER APPLICATION specifically: the interface declaration,
-- the graded signature, the impl machinery and the index are all identical here and all
-- behave.  If this breaks, the environment broke, not #1095.
data Box e a = Done a | Susp (Unit -> <e> a)

runBox : Box e a -> <e> a
runBox (Done a) = a
runBox (Susp t) = t ()

interface GMap f where
  gmap : (a -> <e> b) -> f e a -> f e b

impl GMap Box where
  gmap g (Done a) = Susp (u => g a)
  gmap g (Susp t) = Susp (u => g (t u))

loud : Int -> <Stdout> Int
loud x =
  let _ = putStr "BOOM "
  x + 1

built : Box <Stdout> Int
built = gmap loud (Done 1)

pureInt : Int
pureInt =
  let b = built
  0

main = println pureInt
