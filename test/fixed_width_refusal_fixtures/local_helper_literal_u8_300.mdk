-- #3420 / #1082: a local helper generalizes over `Num` and is dictionary-abstracted,
-- so its 300 is a generic literal, exactly as in a top-level `Num a =>` body: it
-- reaches U8 through `fromInt` at runtime and must panic, not store 301.
import u8

main =
  let g = x => x + 300
  println (g (1 : U8))
