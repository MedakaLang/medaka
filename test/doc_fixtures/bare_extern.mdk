-- bare_extern.mdk — the NEGATIVE control for hole (c).  Same shape as
-- `runtime.mdk` next to it, different module name, so the unexported extern
-- must NOT be documented: `preludeOnlyModule` is a per-module exception, not a
-- global "ignore `pub`" relaxation that would leak every module's privates.

-- | Unexported here, so this must NOT appear on the page.
extern hiddenPrimitive : Int -> Int

-- | Exported, so it does.
export
extern visiblePrimitive : Int -> Int
