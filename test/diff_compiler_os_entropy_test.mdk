{- | #1726: native/eval OS-entropy contract and anti-rot structure, over
   `test/os_entropy_fixtures`.

   The bytes `osEntropyBytes` returns are deliberately nondeterministic, so
   this gate cannot pin a value. It grades a SHAPE instead: `positive.mdk`
   must run clean and print two DIFFERENT results across two fresh spawns
   of each engine — independence must hold across real processes, since a
   fixture that sampled twice inside one process could pass by calling the
   same in-process RNG state twice without ever exercising a fresh OS call.
   `negative.mdk`/`too_large.mdk` must be rejected, by name, on every
   engine (native, and wasmgc/node under test/wasm/run.js). Five structural
   checks below protect the security contract that the executable checks alone
   cannot see: the exact effect annotation, that the extern never leaks into a
   deterministic dispatch table, and that the C helper never falls back to the
   runtime's seeded SplitMix generator. The wasm lowering is pinned as an
   Inline row in `compiler/backend/extern_catalog_gate_test.mdk`.

   Runs under `medaka test --native`: it spawns subprocesses and reads
   source files, neither of which the interpreter binds. -}

import fs.{expectUnitCount, fixtureFiles}
import list.{dropWhile, nub, takeWhile}
import string.{contains, endsWith, lines, startsWith, unlines}
import compiler_cli_test_support.{inFreshDirOf, wasmBuildArgv}
import test.{Expectation, expectAll, fail, pass}
import test_process.{
  boundedVerb,
  boundedVerbSeconds,
  medakaBin,
  medakaRoot,
}

corpus : <IO> String
corpus = "\{medakaRoot}/test/os_entropy_fixtures"

positiveFixture : <IO> String
positiveFixture = "\{corpus}/positive.mdk"

negativeFixture : <IO> String
negativeFixture = "\{corpus}/negative.mdk"

tooLargeFixture : <IO> String
tooLargeFixture = "\{corpus}/too_large.mdk"

-- `medakaBin` under `MEDAKA_STRICT=1`, via the same double-`env` device
-- `compiler_cli_test_support.boundedInTree` uses to pass a variable through
-- to an execed process: a stale binary must fail loudly here rather than
-- print a right-looking answer over a compiler that no longer matches disk.
strictSpawn : Int ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
strictSpawn secs args =
  boundedVerbSeconds secs "env" (["MEDAKA_STRICT=1", medakaBin] ++ args)

okShape : (Int, String, String) -> Bool
okShape (code, out, _) = code == 0 && startsWith "ok:" out

spawnSummary : String -> (Int, String, String) -> String
spawnSummary tag (code, out, err) =
  "\{tag} exit=\{intToString code} stdout=\{debug out} stderr=\{debug err}"

-- The independence claim two fresh spawns of the same program owe: both
-- clean and well-shaped, and NOT byte-identical to each other.
freshSpawnsIndependent : String ->
  (Int, String, String) ->
  (Int, String, String) ->
  Expectation
freshSpawnsIndependent tag a (bc, bo, be) =
  let b = (bc, bo, be)
  if not (okShape a) then
    fail (spawnSummary "\{tag} first" a)
  else if not (okShape b) then
    fail (spawnSummary "\{tag} second" b)
  else
    let (_, ao, _) = a
    if ao == bo then
      fail "\{tag}: two fresh spawns produced identical entropy: \{debug ao}"
    else
      pass

test "os_entropy: exactly 5 fixtures on disk" = match fixtureFiles corpus
  Err e => fail "\{corpus}: \{e}"
  Ok paths => match expectUnitCount 5 (filter (endsWith ".mdk") paths)
    Err e => fail "\{corpus}: \{e}"
    Ok _ => pass

test "os_entropy: positive fixture — `medaka run` is well-shaped and independent across fresh spawns" =
  match strictSpawn 30 ["run", positiveFixture]
    Err e => fail "first `medaka run` spawn: \{e}"
    Ok a => match strictSpawn 30 ["run", positiveFixture]
      Err e => fail "second `medaka run` spawn: \{e}"
      Ok b => freshSpawnsIndependent "run" a b

-- The rejection `medaka run` owes for a fixture whose `osEntropyBytes` call
-- is out of contract: nonzero exit with `wantSubstring` on stderr.
runRejected : String -> String -> <Exec, IO> Expectation
runRejected fixture wantSubstring = match strictSpawn 30 ["run", fixture]
  Err e => fail "medaka run: \{e}"
  Ok (code, ro, re) =>
    if code == 0 then
      fail "medaka run unexpectedly succeeded: stdout=\{debug ro}"
    else if not (contains wantSubstring re) then
      fail
        "medaka run: expected stderr containing \{debug wantSubstring}, got \{debug re}"
    else
      pass

test "os_entropy: negative length is rejected by `medaka run`" =
  runRejected negativeFixture "osEntropyBytes: length must be non-negative"

test "os_entropy: too-large length is rejected by `medaka run`" =
  runRejected tooLargeFixture "osEntropyBytes: requested length is too large"

-- Builds `fixture` into `\{scratch}/\{name}` and executes it once. `scratch`
-- is the directory the caller made for its own builds (`inFreshDirOf`), so
-- every build sharing it is keyed apart by `name` alone.
builtOnce : String ->
  String ->
  String ->
  <Exec, IO> Result String (Int, String, String)
builtOnce scratch name fixture =
  let binPath = "\{scratch}/\{name}"
  match strictSpawn 60 ["build", fixture, "-o", binPath]
    Err e => Err "medaka build \{name}: \{e}"
    Ok (code, bo, be) =>
      if code /= 0 then
        Err
          "medaka build \{name} failed: exit=\{intToString code} \{debug (bo ++ be)}"
      else match boundedVerb binPath []
        Err e => Err "\{name}: exec: \{e}"
        Ok r => Ok r

-- `fixture` built into `scratch` as `name`; the binary's path.
buildOnly : String -> String -> String -> <Exec, IO> Result String String
buildOnly scratch name fixture =
  let binPath = "\{scratch}/\{name}"
  match strictSpawn 60 ["build", fixture, "-o", binPath]
    Err e => Err "medaka build \{name}: \{e}"
    Ok (0, _, _) => Ok binPath
    Ok (code, bo, be) =>
      Err
        "medaka build \{name} failed: exit=\{intToString code} \{debug (bo ++ be)}"

-- `fixture`, built once into `scratch` under `name` and executed TWICE:
-- both runs must be well-shaped and must differ from each other.
buildIndependence : String -> String -> String -> <Exec, IO> Expectation
buildIndependence scratch name fixture = match builtOnce scratch name fixture
  Err e => fail e
  Ok a => match boundedVerb "\{scratch}/\{name}" []
    Err e => fail "\{name}: second exec: \{e}"
    Ok b => freshSpawnsIndependent name a b

-- `fixture`, built once into `scratch` under `name` and executed once: the
-- binary must fail nonzero with `wantSubstring` on stderr.
buildRejected : String -> String -> String -> String -> <Exec, IO> Expectation
buildRejected scratch name fixture wantSubstring =
  match builtOnce scratch name fixture
    Err e => fail e
    Ok (nc, no, ne) =>
      if nc == 0 then
        fail "\{name}: built binary unexpectedly succeeded: stdout=\{debug no}"
      else if not (contains wantSubstring ne) then
        fail
          "\{name}: expected stderr containing \{debug wantSubstring}, got \{debug ne}"
      else
        pass

-- The wasm arm: `fixture` built for `wasm` into `scratch` as `name.wasm`, which is
-- run under node by test/wasm/run.js (the wasmgc/node profile, which grants Rand).
wasmBuild : String -> String -> String -> <Exec, IO> Result String String
wasmBuild scratch name fixture =
  let binPath = "\{scratch}/\{name}.wasm"
  match boundedVerbSeconds 60 "env" (wasmBuildArgv fixture binPath)
    Err e => Err "medaka build --target wasm \{name}: \{e}"
    Ok (code, bo, be) =>
      if code /= 0 then
        Err
          "medaka build --target wasm \{name} failed: exit=\{intToString code} \{debug (bo ++ be)}"
      else
        Ok binPath

-- Runs a built module under node; an exit other than `want` is an error
-- carrying the code and stderr, so a crash is never a result.
wasmRun : Int -> String -> <Exec, IO> Result String (Int, String, String)
wasmRun want binPath = match boundedVerbSeconds 60 "node" [
  "\{medakaRoot}/test/wasm/run.js",
  binPath,
]
  Err e => Err e
  Ok (code, out, err) =>
    if code /= want then
      Err
        "node exited \{intToString code}, want \{intToString want}: stdout=\{debug out} stderr=\{debug err}"
    else
      Ok (code, out, err)

-- A clean wasm run writes nothing to stderr, as native does.
wasmClean : String -> (Int, String, String) -> Expectation
wasmClean tag (_, _, err) =
  if err == "" then
    pass
  else
    fail "\{tag}: expected empty stderr, got \{debug err}"

wasmIndependence : String -> String -> String -> <Exec, IO> Expectation
wasmIndependence scratch name fixture = match wasmBuild scratch name fixture
  Err e => fail e
  Ok binPath => match wasmRun 0 binPath
    Err e => fail "\{name} (wasm): first run: \{e}"
    Ok a => match wasmRun 0 binPath
      Err e => fail "\{name} (wasm): second run: \{e}"
      Ok b => expectAll [
        wasmClean "\{name} (wasm) first" a,
        wasmClean "\{name} (wasm) second" b,
        freshSpawnsIndependent "\{name} (wasm)" a b,
      ]

wasmRejected : String -> String -> String -> String -> <Exec, IO> Expectation
wasmRejected scratch name fixture wantSubstring =
  match wasmBuild scratch name fixture
    Err e => fail e
    Ok binPath => match wasmRun 1 binPath
      Err e => fail "\{name} (wasm): run: \{e}"
      Ok (_, _, ne) =>
        if not (contains wantSubstring ne) then
          fail
            "\{name} (wasm): expected stderr containing \{debug wantSubstring}, got \{debug ne}"
        else
          pass

test "os_entropy: build+exec — positive is independent, negative and too-large are rejected" =
  inFreshDirOf
    (scratch => expectAll [
      buildIndependence scratch "positive" positiveFixture,
      buildRejected
        scratch
        "negative"
        negativeFixture
        "osEntropyBytes: length must be non-negative",
      buildRejected
        scratch
        "too_large"
        tooLargeFixture
        "osEntropyBytes: requested length is too large",
      wasmIndependence scratch "positive" positiveFixture,
      wasmRejected
        scratch
        "negative"
        negativeFixture
        "osEntropyBytes: length must be non-negative",
      wasmRejected
        scratch
        "too_large"
        tooLargeFixture
        "osEntropyBytes: requested length is too large",
    ])
    (msg => fail msg)

-- # MEDAKA_SEED: the first draw of an unseeded program seeds from the
-- environment, on `run`, a built binary and a wasm module alike (#4621).

seedDrawFixture : <IO> String
seedDrawFixture = "\{corpus}/seed_draw.mdk"

seedSetFixture : <IO> String
seedSetFixture = "\{corpus}/seed_set.mdk"

-- A program on one engine: the command and arguments that run it.
runEngine : String -> <IO> (String, List String)
runEngine fixture = ("env", ["MEDAKA_STRICT=1", medakaBin, "run", fixture])

binEngine : String -> (String, List String)
binEngine bin = (bin, [])

wasmEngine : String -> <IO> (String, List String)
wasmEngine bin = ("node", ["\{medakaRoot}/test/wasm/run.js", bin])

-- The stdout of a clean run of `engine` under `MEDAKA_SEED=seed` (any
-- environment when `seed` is `None`), else the reason it was not one.
drawOf : String ->
  Option String ->
  (String, List String) ->
  <Exec, IO> Result String String
drawOf tag seed (cmd, argv) =
  let argv2 = match seed
    Some v => ["MEDAKA_SEED=\{v}", cmd] ++ argv
    None => cmd :: argv
  match boundedVerbSeconds 60 "env" argv2
    Err e => Err "\{tag}: \{e}"
    Ok (0, out, _) => Ok out
    Ok (code, out, err) => Err (spawnSummary tag (code, out, err))

-- Every draw clean and no two alike.
allDistinctDraws : String -> List (Result String String) -> Expectation
allDistinctDraws tag runs = match allOk runs
  Err e => fail e
  Ok outs =>
    if length (nub outs) == length outs then
      pass
    else
      fail "\{tag}: unseeded runs repeated a draw: \{debug outs}"

-- `Ok` of every element, or the first `Err`.
allOk : List (Result String a) -> Result String (List a)
allOk [] = Ok []
allOk ((Err e) :: _) = Err e
allOk ((Ok x) :: rest) = map (x :: _) (allOk rest)

-- The two programs drew the same clean answer.
sameDraw : String -> Result String String -> Result String String -> Expectation
sameDraw tag (Ok x) (Ok y) =
  if x == y then
    pass
  else
    fail "\{tag}: MEDAKA_SEED=42 drew \{debug x}, setSeed 42 drew \{debug y}"
sameDraw _ (Err e) _ = fail e
sameDraw _ _ (Err e) = fail e

-- A seed the engine must refuse: nonzero exit and the message on stderr.
refusesSeed : String ->
  String ->
  (String, List String) ->
  <Exec, IO> Expectation
refusesSeed tag seed (cmd, argv) =
  match boundedVerbSeconds 60 "env" (["MEDAKA_SEED=\{seed}", cmd] ++ argv)
    Err e => fail "\{tag} MEDAKA_SEED=\{debug seed}: \{e}"
    Ok (0, out, _) =>
      fail "\{tag}: MEDAKA_SEED=\{debug seed} was accepted: stdout=\{debug out}"
    Ok (_, _, err) =>
      if contains "MEDAKA_SEED must be a decimal integer" err then
        pass
      else
        fail "\{tag}: MEDAKA_SEED=\{debug seed}: stderr \{debug err}"

badSeeds : List String
badSeeds = ["abc", "", " 42", "42 "]

test "os_entropy: unseeded draws differ across runs on `run` and a built binary" =
  inFreshDirOf
    (scratch => match buildOnly scratch "seed_draw" seedDrawFixture
      Err e => fail e
      Ok bin => expectAll [
        allDistinctDraws
          "run"
          (map (_ => drawOf "run" None (runEngine seedDrawFixture)) [1, 2, 3]),
        allDistinctDraws
          "native"
          (map (_ => drawOf "native" None (binEngine bin)) [1, 2, 3]),
      ])
    (msg => fail msg)

test "os_entropy: MEDAKA_SEED=42 equals a leading setSeed 42 on run, native and wasm" =
  inFreshDirOf
    (scratch => match buildOnly scratch "seed_draw" seedDrawFixture
      Err e => fail e
      Ok draw => match buildOnly scratch "seed_set" seedSetFixture
        Err e => fail e
        Ok set => match wasmBuild scratch "seed_draw" seedDrawFixture
          Err e => fail e
          Ok wdraw => match wasmBuild scratch "seed_set" seedSetFixture
            Err e => fail e
            Ok wset => expectAll [
              sameDraw
                "run"
                (drawOf "run" (Some "42") (runEngine seedDrawFixture))
                (drawOf "run" (Some "42") (runEngine seedSetFixture)),
              sameDraw
                "native"
                (drawOf "native" (Some "42") (binEngine draw))
                (drawOf "native" (Some "42") (binEngine set)),
              sameDraw
                "wasm"
                (drawOf "wasm" (Some "42") (wasmEngine wdraw))
                (drawOf "wasm" (Some "42") (wasmEngine wset)),
            ])
    (msg => fail msg)

test "os_entropy: a malformed MEDAKA_SEED fails loudly on run, native and wasm" =
  inFreshDirOf
    (scratch => match buildOnly scratch "seed_draw" seedDrawFixture
      Err e => fail e
      Ok draw => match wasmBuild scratch "seed_draw" seedDrawFixture
        Err e => fail e
        Ok wdraw =>
          expectAll
            (flatMap
              (seed => [
                refusesSeed "run" seed (runEngine seedDrawFixture),
                refusesSeed "native" seed (binEngine draw),
                refusesSeed "wasm" seed (wasmEngine wdraw),
              ])
              badSeeds))
    (msg => fail msg)

-- # Structural anti-rot checks — none of these touch a spawn

-- The lines of `allLines` strictly after the first line starting with
-- `startPrefix`, up to (not including) the first later line satisfying
-- `stopWhen`. `Err` when `startPrefix` is never found — distinct from an
-- anchor that IS found but delimits a genuinely empty section, so a
-- reformatted anchor line fails the check instead of vacuously emptying it.
sectionAfter : String ->
  (String -> Bool) ->
  List String ->
  Result String (List String)
sectionAfter startPrefix stopWhen allLines =
  match dropWhile (l => not (startsWith startPrefix l)) allLines
    [] => Err "anchor '\{startPrefix}' not found — this check needs updating"
    _ :: rest => Ok (takeWhile (l => not (stopWhen l)) rest)

test "os_entropy: extern declares the <Rand> effect exactly" =
  let path = "\{medakaRoot}/stdlib/runtime.mdk"
  match readFile path
    Err e => fail "\{path}: \{e}"
    Ok src =>
      if elem "extern osEntropyBytes : Int -> <Rand> Array Int" (lines src) then
        pass
      else
        fail "\{path}: exact <Rand> declaration missing"

test "os_entropy: excluded from the deterministic externBindings table" =
  let path = "\{medakaRoot}/compiler/eval/eval.mdk"
  match readFile path
    Err e => fail "\{path}: \{e}"
    Ok src =>
      let sectionResult =
        sectionAfter
          "externBindings _ = ["
          (startsWith "pDebugStringLit")
          (lines src)
      match sectionResult
        Err e => fail "\{path}: \{e}"
        Ok section =>
          if contains "\"osEntropyBytes\"" (unlines section) then
            fail
              "\{path}: osEntropyBytes leaked into the deterministic externBindings table"
          else
            pass

test "os_entropy: excluded from testCapableExterns" =
  let path = "\{medakaRoot}/compiler/eval/eval.mdk"
  match readFile path
    Err e => fail "\{path}: \{e}"
    Ok src =>
      let sectionResult =
        sectionAfter "testCapableExterns _ = [" (l => l == "]") (lines src)
      match sectionResult
        Err e => fail "\{path}: \{e}"
        Ok section =>
          if contains "\"osEntropyBytes\"" (unlines section) then
            fail "\{path}: osEntropyBytes leaked into testCapableExterns"
          else
            pass

test "os_entropy: the C runtime helper has no deterministic SplitMix fallback" =
  let path = "\{medakaRoot}/runtime/medaka_rt.c"
  match readFile path
    Err e => fail "\{path}: \{e}"
    Ok src =>
      let sectionResult =
        sectionAfter
          "long long mdk_os_entropy_bytes("
          (l => l == "}")
          (lines src)
      match sectionResult
        Err e => fail "\{path}: \{e}"
        Ok section =>
          if contains "mdk_next_u64" (unlines section) then
            fail
              "\{path}: osEntropyBytes calls the deterministic SplitMix generator"
          else
            pass

-- A shrinking count here is the same silent-wrongness signal
-- `rosterAgreement`'s doc comment names for a fixture roster: written down
-- so a corpus that lost a check reads red instead of a quieter suite.
test "os_entropy: exactly 13 `os_entropy:` checks are declared" =
  let path = "\{medakaRoot}/test/diff_compiler_os_entropy_test.mdk"
  match readFile path
    Err e => fail "\{path}: \{e}"
    Ok src =>
      let n = length (filter (startsWith "test \"os_entropy:") (lines src))
      if n == 13 then
        pass
      else
        fail "\{path}: expected 13 `os_entropy:` checks, found \{intToString n}"
