{- | Shared process assertions for native compiler CLI gates.

   The helpers locate the repository binary and fixtures, enforce CLI exit-code
   contracts, and match diagnostics without tying those mechanics to one test
   corpus. -}

import fs.{expectUnitCount, fixtureFiles}
import io.{getEnvOr, runVerb}
import list.{chunks, dropWhile, group, reverse, somes, sort, splitAt, takeWhile}
import path.{dirname, stem}
import string.{
  contains,
  endsWith,
  join,
  lines,
  padRight,
  startsWith,
  stripSuffix,
  toLower,
  trim,
  unlines,
}
import regex.{Regex, mustCompile, isMatch}
import test_process.{
  boundedVerbSeconds,
  medakaBin,
  medakaRoot,
  spawnTimeoutSeconds,
  testJobs,
}
import test.{
  Expectation,
  expectLineContainsAll,
  expectTextContainsAll,
  expectTextStartsWithAndContains,
  fail,
  pass,
}

export
fixtureIn : String -> String -> <IO> String
fixtureIn corpus name = "\{medakaRoot}/\{corpus}/\{name}"

export
runMedaka : List String -> <Exec, IO> Result String (Int, String)
runMedaka args =
  map ((code, out, err) => (code, out ++ err)) (runVerb medakaBin args)

-- # Spawning inside the tree under test

{- | The raw native emitter to spawn, from `MEDAKA_EMITTER`, defaulting to the
   one in `medakaRoot`.

   The peer of `test_process.medakaBin`, for a gate whose subject is the
   emitter binary itself rather than a `medaka` verb. -}
export
emitterBin : <IO> String
emitterBin = getEnvOr "MEDAKA_EMITTER" "\{medakaRoot}/medaka_emitter"

{- | The wasm emitter binary the CLI's `--target wasm` path execs, from
   `MEDAKA_WASM_EMITTER`, defaulting to the one in `medakaRoot`; a gate shard
   builds it but never exports the variable. -}
export
wasmEmitter : <IO> String
wasmEmitter =
  getEnvOr "MEDAKA_WASM_EMITTER" "\{medakaRoot}/test/bin/wasm_emit_modules_main"

{- | The `env` argv of `medaka build --target wasm src -o out`, with the wasm
   emitter named explicitly and `MEDAKA_STRICT=1` so a stale compiler fails
   the build loudly. -}
export
wasmBuildArgv : String -> String -> <IO> List String
wasmBuildArgv src out = [
  "MEDAKA_STRICT=1",
  "MEDAKA_WASM_EMITTER=\{wasmEmitter}",
  medakaBin,
  "build",
  "--target",
  "wasm",
  src,
  "-o",
  out,
]

{- | Runs `cmd` with `MEDAKA_ROOT` and `MEDAKA_EMITTER` named explicitly in its
   environment, killed after `secs` seconds.

   Both variables are passed rather than left to a default lookup: a gate
   shard does not export them, and a spawn that relies on the binary finding
   its own emitter is one refactor away from grading a verb that silently did
   nothing. `env` carries them because Medaka has no `setEnv`, which is the
   same device `medaka gate run` uses to hand a gate its environment. A value
   already set in this process wins, since `medakaRoot` and `emitterBin` read it
   first. -}
export
boundedInTree : Int ->
  String ->
  List String ->
  <Exec, IO> Result String (Int, String, String)
boundedInTree secs cmd args =
  boundedVerbSeconds
    secs
    "env"
    (["MEDAKA_ROOT=\{medakaRoot}", "MEDAKA_EMITTER=\{emitterBin}", cmd] ++ args)

{- | `boundedVerbSeconds secs cmd args` for every `(cmd, args)` row, at most
   `testJobs` of them running at once.

   Each element is what `boundedVerbSeconds` returns for its row, in input
   order and with the same error text, so grading the results in order reads
   exactly what a loop over `boundedVerbSeconds` would have read. The argv
   below has to stay the one `boundedVerbSeconds` builds. -}
export
boundedVerbsSeconds : Int ->
  List (String, List String) ->
  <Exec, IO> List (Result String (Int, String, String))
boundedVerbsSeconds secs rows =
  let alarm = "alarm \{intToString secs}; exec @ARGV or die qq(exec: $!)"
  let argvs = map ((cmd, args) => ["-e", alarm, "env", cmd] ++ args) rows
  map (mapErr (e => "perl: \{e}")) (runCommandBatch "perl" testJobs argvs)

rejectionRe : Regex
rejectionRe = mustCompile "(?i)(type error|parse error)|^error:"

{- | Whether a `check` output line reads as a rejection, case-insensitively.

   > rejectionLine "Type error: something"
   True
   > rejectionLine "PARSE ERROR near foo"
   True
   > rejectionLine "error: something went wrong"
   True
   > rejectionLine "Error: mismatch"
   True
   > rejectionLine "unexpected error: xyz"
   False
   > rejectionLine "warning: this is fine"
   False -}
rejectionLine : String -> Bool
rejectionLine line = isMatch rejectionRe line

firstErrorLine : String -> String
firstErrorLine out = match filter (contains "error" << toLower) (lines out)
  l :: _ => l
  [] => "(no line mentioning an error)"

export
expectCheckAccept : String -> <Exec, IO> Expectation
expectCheckAccept path = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 0 then
      fail "\{path}: expected accept, `medaka check` exited \{intToString code}"
    else if any rejectionLine (lines out) then
      fail "\{path}: expected accept, got \{debug (firstErrorLine out)}"
    else
      pass

export
expectCheckReject : String -> List String -> <Exec, IO> Expectation
expectCheckReject path needles = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 1 then
      fail "\{path}: expected reject, `medaka check` exited \{intToString code}"
    else
      expectTextContainsAll needles out

export
expectCheckRejectLine : String -> List String -> <Exec, IO> Expectation
expectCheckRejectLine path needles = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 1 then
      fail "\{path}: expected reject, `medaka check` exited \{intToString code}"
    else
      expectLineContainsAll needles out

export
expectVerbExitStartsWith : String ->
  List String ->
  Int ->
  String ->
  <Exec, IO> Expectation
expectVerbExitStartsWith verb args expectedCode prefix =
  expectVerbExitStartsWithAndContains verb args expectedCode prefix []

export
expectVerbExitStartsWithAndContains : String ->
  List String ->
  Int ->
  String ->
  List String ->
  <Exec, IO> Expectation
expectVerbExitStartsWithAndContains verb args expectedCode prefix needles =
  match runMedaka (verb :: args)
    Err e => fail "medaka \{verb}: could not run: \{e}"
    Ok (code, out) =>
      if code /= expectedCode then
        fail
          "medaka \{verb}: expected exit \{intToString expectedCode}, got \{intToString code}: \{debug out}"
      else
        expectTextStartsWithAndContains prefix needles out

-- # Three-verb agreement

{- | What `check`, `run` and `build` each did with one entry file, and what
   the binary `build` produced then printed.

   The three verbs share a front end and differ only in engine, so a gate
   that grades them apart is grading one program three ways. The exit codes
   alone cannot do that: a program rejected by a diagnostic and a program
   executed and killed by a runtime panic both exit 1, and a build that
   exits 0 while its binary prints the wrong number is invisible to any
   grader that stops at the code. Every stream is therefore kept separate
   and whole. -}
public export data Agreement = Agreement {
  checkCode : Int,
  checkErr : String,
  runCode : Int,
  runOut : String,
  runErr : String,
  buildCode : Int,
  buildLog : String,
  binCode : Int,
  binOut : String,
  binErr : String,
}

-- | `"ACCEPT"` when a verb exited 0, `"REJECT"` otherwise — the verdict
-- column a fixture pins.
export
verdictOf : Int -> String
verdictOf 0 = "ACCEPT"
verdictOf _ = "REJECT"

{- | Runs `medaka check`, `medaka run` and `medaka build` over `entry`,
   writing the build's output to `binPath`, and executes that binary when
   the build succeeded.

   Every spawn is bounded (`spawnTimeoutSeconds`), so one hanging fixture
   fails its own row rather than the job. When the build did not succeed
   there is no binary to run, and the three `bin` fields report an empty
   zero-exit run that every caller reads only after checking `buildCode`. -}
export
checkRunBuild : String -> String -> <Exec, IO> Result String Agreement
checkRunBuild entry binPath = match checkRunBuildAll [(entry, binPath)]
  [a] => a
  _ => Err "\{entry}: checkRunBuildAll did not answer exactly once"

{- | `checkRunBuild` for every `(entry, binPath)` pair, `testJobs` pairs at
   a time, each verb run over a group's pairs side by side: every `check`,
   then every `run`, then every `build`, then every binary that built.

   Each element is what `checkRunBuild` returns for its pair, in input
   order. Groups of `testJobs` keep `MEDAKA_TEST_JOBS=1` spawning in exactly
   the order a loop over `checkRunBuild` does. A pair whose spawn could not
   be started stops there and spawns nothing further. Pairs that name the
   same `binPath` are each an `Err` naming it, and spawn nothing: built at
   once, one fixture's binary would be graded as the other's. -}
export
checkRunBuildAll : List (String, String) ->
  <Exec, IO> List (Result String Agreement)
checkRunBuildAll pairs =
  let shared = sharedPaths (map snd pairs)
  flatMap (checkRunBuildGroup shared) (chunks testJobs pairs)

checkRunBuildGroup : List String ->
  List (String, String) ->
  <Exec, IO> List (Result String Agreement)
checkRunBuildGroup shared pairs =
  let bin = medakaBin
  let start = map (startAgreement shared) pairs
  let checked =
    spawnPhase
      start
      (((entry, _), _) => Some (bin, ["check", entry]))
      "`medaka check`"
      (a (code, _, err) => { a | checkCode = code, checkErr = err })
  let ran =
    spawnPhase
      checked
      (((entry, _), _) => Some (bin, ["run", entry]))
      "`medaka run`"
      (a (code, out, err) => { a | runCode = code, runOut = out, runErr = err })
  let built =
    spawnPhase
      ran
      (((entry, binPath), _) => Some (bin, ["build", entry, "-o", binPath]))
      "`medaka build`"
      (a (code, out, err) => { a | buildCode = code, buildLog = out ++ err })
  let executed =
    spawnPhase
      built
      (((_, binPath), a) =>
        if a.buildCode == 0 then Some (binPath, []) else None)
      "the built binary"
      (a (code, out, err) => { a | binCode = code, binOut = out, binErr = err })
  map (map snd) executed

-- The paths that occur more than once in `paths`, each named once.
sharedPaths : List String -> List String
sharedPaths paths = flatMap repeated (group (sort paths))

repeated : List String -> List String
repeated (p :: _ :: _) = [p]
repeated _ = []

-- A pair's state before any spawn: every field empty, which is also what an
-- unbuilt binary's fields keep.
startAgreement : List String ->
  (String, String) ->
  Result String ((String, String), Agreement)
startAgreement shared (entry, binPath) =
  if elem binPath shared then
    Err "\{entry}: another fixture also builds to \{binPath}"
  else
    Ok ((entry, binPath), emptyAgreement)

emptyAgreement : Agreement
emptyAgreement = Agreement {
  checkCode = 0,
  checkErr = "",
  runCode = 0,
  runOut = "",
  runErr = "",
  buildCode = 0,
  buildLog = "",
  binCode = 0,
  binOut = "",
  binErr = "",
}

-- One verb of `checkRunBuildAll`: the spawn `spawnOf` names for each pair
-- still standing, all run as one batch, each result folded back by `fill`.
-- A pair `spawnOf` names no spawn for is carried through unchanged.
spawnPhase : List (Result String ((String, String), Agreement)) ->
  (((String, String), Agreement) -> Option (String, List String)) ->
  String ->
  (Agreement -> (Int, String, String) -> Agreement) ->
  <Exec, IO> List (Result String ((String, String), Agreement))
spawnPhase states spawnOf what fill =
  let wanted = somes (map (st => flatMap spawnOf (fromResult st)) states)
  settle
    spawnOf
    what
    fill
    states
    (boundedVerbsSeconds spawnTimeoutSeconds wanted)

settle : (((String, String), Agreement) -> Option (String, List String)) ->
  String ->
  (Agreement -> (Int, String, String) -> Agreement) ->
  List (Result String ((String, String), Agreement)) ->
  List (Result String (Int, String, String)) ->
  List (Result String ((String, String), Agreement))
settle _ _ _ [] _ = []
settle spawnOf what fill ((Err e) :: rest) results =
  Err e :: settle spawnOf what fill rest results
settle spawnOf what fill ((Ok s) :: rest) results =
  let ((entry, _), a) = s
  match (spawnOf s, results)
    (None, _) => Ok s :: settle spawnOf what fill rest results
    (Some _, (Ok r) :: more) =>
      Ok (fst s, fill a r) :: settle spawnOf what fill rest more
    (Some _, (Err e) :: more) =>
      Err "\{entry}: could not run \{what}: \{e}"
        :: settle spawnOf what fill rest more
    (Some _, []) =>
      Err "\{entry}: could not run \{what}: the batch returned no result"
        :: settle spawnOf what fill rest []

-- | True when the built binary itself proves nothing pinned wrong: it
-- exited 0 and its stderr carries no runtime panic. Only meaningful after
-- the caller has already checked `buildCode == 0` — `checkRunBuild`
-- synthesizes a zero-exit/empty-string `bin*` triple when the build itself
-- failed, so this predicate reads as trivially true in that case.
export
binaryRanClean : Agreement -> Bool
binaryRanClean a = a.binCode == 0 && not (contains "E-PANIC" a.binErr)

-- # Sweeping a corpus

{- | Grades every `unit` through `gradeOne` in a fresh scratch directory,
   collects each row's failure message via `rowFailure`, then hands the
   whole batch to `summarize`.

   Every gate that sweeps a corpus shares this exact outer dance and differs
   only in its row shape and `summarize`'s wording, so those stay the
   caller's own `gradeOne`/`rowFailure`/`summarize` rather than being
   unified here. -}
export
sweepUnits : List unit ->
  (String -> unit -> <Exec, FileRead, IO> row) ->
  (row -> Option String) ->
  (Int -> List String -> Expectation) ->
  <Exec, FileRead, IO> Expectation
sweepUnits units gradeOne rowFailure summarize =
  inFreshDirOf
    (scratch =>
      let graded = map (gradeOne scratch) units
      let failures = somes (map rowFailure graded)
      summarize (length graded) failures)
    (msg => fail msg)

{- | `sweepUnits` for a corpus graded by `checkRunBuild`: `plan` names each
   unit's `(entry, binPath)` under the scratch directory, or settles its row
   without spawning anything, and `grade` turns the unit's agreement into
   its row.

   Units go `testJobs` at a time, each verb of a group running side by side
   (`checkRunBuildAll`), and each group is graded before the next one
   spawns, so under `MEDAKA_TEST_JOBS=1` the spawns come in exactly the
   order a loop over `checkRunBuild` makes them. Units planned onto the same
   `binPath` fail the sweep before anything spawns. The scratch directory is
   made fresh for each sweep, so a sweep that follows another in the same
   process is not handed the one that sweep removed. -}
export
sweepAgreements : List unit ->
  (String -> unit -> <FileRead, IO> Result row (String, String)) ->
  (unit -> (String, String) -> Result String Agreement -> <Exec, FileRead, IO> row) ->
  (row -> Option String) ->
  (Int -> List String -> Expectation) ->
  <Exec, FileRead, IO> Expectation
sweepAgreements units plan grade rowFailure summarize = inFreshScratch
  (scratch =>
    let plans = map (u => (u, plan scratch u)) units
    match sharedPaths (map snd (somes (map (p => fromResult (snd p)) plans)))
      [] =>
        let graded = flatMap (gradePlanned grade) (chunks testJobs plans)
        summarize (length graded) (somes (map rowFailure graded))
      shared =>
        fail "more than one unit builds to each of: \{join ", " shared}")

gradePlanned : (unit -> (String, String) -> Result String Agreement -> <Exec, FileRead, IO> row) ->
  List (unit, Result row (String, String)) ->
  <Exec, FileRead, IO> List row
gradePlanned grade batch =
  let spawned = checkRunBuildAll (somes (map (p => fromResult (snd p)) batch))
  gradeEach grade batch spawned

gradeEach : (unit -> (String, String) -> Result String Agreement -> <Exec, FileRead, IO> row) ->
  List (unit, Result row (String, String)) ->
  List (Result String Agreement) ->
  <Exec, FileRead, IO> List row
gradeEach _ [] _ = []
gradeEach grade ((_, Err row) :: rest) results =
  row :: gradeEach grade rest results
gradeEach grade ((u, Ok pair) :: rest) (a :: more) =
  grade u pair a :: gradeEach grade rest more
gradeEach grade ((u, Ok pair) :: rest) [] =
  grade u pair (Err "\{fst pair}: no agreement was produced")
    :: gradeEach grade rest []

{- | `sweepUnits` for a corpus whose rows each grade the spawns `spawnsOf`
   names, every one bounded by `spawnTimeoutSeconds`: `spawnsOf` is handed
   the sweep's scratch directory, and `grade` is handed the unit's results in
   the order its spawns were named.

   Units go `testJobs` at a time, all the spawns of a group running side by
   side, and each group is graded before the next one spawns, so under
   `MEDAKA_TEST_JOBS=1` the spawns come in exactly the order a loop over the
   units makes them. The scratch directory is made fresh for each sweep. -}
export
sweepSpawns : List unit ->
  (String -> unit -> <FileRead, IO> List (String, List String)) ->
  (unit -> List (Result String (Int, String, String)) -> <Exec, FileRead, IO> row) ->
  (row -> Option String) ->
  (Int -> List String -> Expectation) ->
  <Exec, FileRead, IO> Expectation
sweepSpawns units spawnsOf grade rowFailure summarize = inFreshScratch
  (scratch =>
    let graded =
      flatMap (gradeSpawned (spawnsOf scratch) grade) (chunks testJobs units)
    summarize (length graded) (somes (map rowFailure graded)))

-- | `sweepSpawns` for a corpus whose rows each grade exactly one spawn.
export
sweepSpawn : List unit ->
  (String -> unit -> <IO> (String, List String)) ->
  (unit -> Result String (Int, String, String) -> <Exec, FileRead, IO> row) ->
  (row -> Option String) ->
  (Int -> List String -> Expectation) ->
  <Exec, FileRead, IO> Expectation
sweepSpawn units spawnOf grade rowFailure summarize =
  sweepSpawns
    units
    (scratch u => [spawnOf scratch u])
    (u results => grade u (soleResult results))
    rowFailure
    summarize

soleResult : List (Result String a) -> Result String a
soleResult [r] = r
soleResult rs =
  Err "the batch returned \{intToString (length rs)} results for one spawn"

gradeSpawned : (unit -> <FileRead, IO> List (String, List String)) ->
  (unit -> List (Result String (Int, String, String)) -> <Exec, FileRead, IO> row) ->
  List unit ->
  <Exec, FileRead, IO> List row
gradeSpawned spawnsOf grade batch =
  let named = map spawnsOf batch
  let results = boundedVerbsSeconds spawnTimeoutSeconds (flatMap (s => s) named)
  gradeSplit grade batch (map length named) results

gradeSplit : (unit -> List (Result String (Int, String, String)) -> <Exec, FileRead, IO> row) ->
  List unit ->
  List Int ->
  List (Result String (Int, String, String)) ->
  <Exec, FileRead, IO> List row
gradeSplit grade (u :: us) (n :: ns) results =
  let (mine, rest) = splitAt n results
  grade u mine :: gradeSplit grade us ns rest
gradeSplit _ _ _ _ = []

-- Runs `body` in a scratch directory made for this call, then removes it.
inFreshScratch : (String -> <Exec, FileRead, IO> Expectation) ->
  <Exec, FileRead, IO> Expectation
inFreshScratch body = match runVerb "mktemp" ["-d"]
  Err e => fail "could not make a scratch directory: \{e}"
  Ok (0, out, _) =>
    let scratch = trim out
    let result = body scratch
    let _ = runVerb "rm" ["-rf", scratch]
    result
  Ok (code, _, err) =>
    fail
      "could not make a scratch directory: mktemp -d exited \{intToString code}: \{err}"

{- | Runs `body` in a directory made for this call, removes it, and returns
   what `body` returned. `fromMsg` turns a failure to make the directory into
   the caller's result type, so each caller words that failure its own way.

   The directory is made here rather than taken from `test_process.scratchDir`,
   which is one directory per process and outlives the sweep that removes it. -}
export
inFreshDirOf : (String -> <e> a) -> (String -> a) -> <Exec, IO | e> a
inFreshDirOf body fromMsg = match runVerb "mktemp" ["-d"]
  Err e => fromMsg "could not make a scratch directory: \{e}"
  Ok (0, out, _) =>
    let scratch = trim out
    let result = body scratch
    let _ = runVerb "rm" ["-rf", scratch]
    result
  Ok (code, _, err) =>
    fromMsg
      "could not make a scratch directory: mktemp -d exited \{intToString code}: \{err}"

-- # Staging a batch of rows

{- | A scratch directory for one row of a batch: a function of the row, not a
   value, since a value is evaluated once per process and every row would share
   one directory. -}
export
freshDirFor : a -> <Exec, IO> Result String String
freshDirFor _ = match runVerb "mktemp" ["-d"]
  Err e => Err e
  Ok (0, out, _) => Ok (trim out)
  Ok (code, _, err) => Err "mktemp -d exited \{intToString code}: \{err}"

export
okDir : Result String String -> Option String
okDir (Ok d) = Some d
okDir (Err _) = None

export
liveOf : Result e a -> Option a
liveOf (Ok x) = Some x
liveOf (Err _) = None

export
finalOf : Result Expectation Expectation -> Expectation
finalOf (Ok e) = e
finalOf (Err e) = e

-- `xs` cut into consecutive runs of the lengths in `ns`, in order.
export
splitCounts : List Int -> List a -> List (List a)
splitCounts [] _ = []
splitCounts (n :: ns) xs =
  let (mine, rest) = splitAt n xs
  mine :: splitCounts ns rest

{- | The spawns `spawnsOf` names for each item, all run as one batch of
   `boundedVerbsSeconds secs` rows, with each item's results handed back in its
   own list, in input order. -}
export
spawnEach : Int ->
  (s -> List (String, List String)) ->
  List s ->
  <Exec, IO> List (List (Result String (Int, String, String)))
spawnEach secs spawnsOf items =
  let named = map spawnsOf items
  splitCounts
    (map length named)
    (boundedVerbsSeconds secs (flatMap (x => x) named))

{- | Grades each live state from the results of its own spawns, one result
   list per state, in order.

   The batch is split by the counts the spawns were named with, so the two
   lists agree in length by construction. Should they not, each unpaired state
   and each unclaimed result list is a failure row built by `mismatch`, never a
   row that is skipped or passes. -}
export
gradeLive : (String -> e) ->
  (s -> List (Result String (Int, String, String)) -> <Exec, FileRead, IO> Result e t) ->
  List s ->
  List (List (Result String (Int, String, String))) ->
  <Exec, FileRead, IO> List (Result e t)
gradeLive _ _ [] [] = []
gradeLive m grade (s :: ss) (r :: rs) = grade s r :: gradeLive m grade ss rs
gradeLive m grade (_ :: ss) [] =
  Err (m "internal: a live row got no batch results") :: gradeLive m grade ss []
gradeLive m grade [] (_ :: rs) =
  Err (m "internal: a batch answered a row that was not live")
    :: gradeLive m grade [] rs

{- | One stage of a row chain. A row already settled by an earlier stage
   passes through untouched and spawns nothing. Every live row's spawns run as
   one batch through `spawn` (a `spawnEach` the caller has applied to its
   bound and spawn list, so the caller's own code names the spawn it grades),
   then each live row is graded from its own results. `mismatch` builds the
   failure a row gets when its batch answer is missing. -}
export
stageRun : (List s -> <Exec, IO> List (List (Result String (Int, String, String)))) ->
  (String -> e) ->
  (s -> List (Result String (Int, String, String)) -> <Exec, FileRead, IO> Result e t) ->
  List (Result e s) ->
  <Exec, FileRead, IO> List (Result e t)
stageRun spawn mismatch grade states =
  let live = somes (map liveOf states)
  mergeStage mismatch states (gradeLive mismatch grade live (spawn live))

{- | Pairs each `Ok` state with the next graded result, and keeps each `Err`
   state as it is. A state left without a graded result is a failure row. -}
export
mergeStage : (String -> e) ->
  List (Result e s) ->
  List (Result e t) ->
  List (Result e t)
mergeStage _ [] gs = gs
mergeStage m ((Err e) :: rest) gs = Err e :: mergeStage m rest gs
mergeStage m ((Ok _) :: rest) (g :: gs) = g :: mergeStage m rest gs
mergeStage m ((Ok _) :: rest) [] =
  Err (m "internal: a live row got no graded result") :: mergeStage m rest []

{- | Each row's label paired with its grade. A count mismatch is a failure
   row carrying the mismatch, never a dropped row. -}
export
labelGrades : List String -> List Expectation -> List (String, Expectation)
labelGrades [] [] = []
labelGrades (l :: ls) (e :: es) = (l, e) :: labelGrades ls es
labelGrades (l :: ls) [] =
  (l, fail "internal: no grade was produced for this row") :: labelGrades ls []
labelGrades [] (e :: es) =
  ("(no row)", fail "internal: a grade was produced for no row")
    :: labelGrades [] es

{- | The `summarize` most `sweepUnits` callers pass: a generic "N of M probe
   rows failed" report, or `pass` when nothing failed.

   Seven gate-test modules each re-derived this exact function under their
   own local name. A gate whose failures need a different noun than "probe
   rows" (a distinct census, an extra label) keeps its own `summarize`
   instead of this one — genuinely different behavior, not the same
   function twice. -}
export
summarizeSweep : Int -> List String -> Expectation
summarizeSweep _ [] = pass
summarizeSweep graded failures =
  fail
    "\{intToString (length failures)} of \{intToString graded} probe rows failed:\n\{unlines failures}"

-- # Reading a spawned oracle's stdout

{- | `s` without its trailing newlines.

   Every golden these helpers grade against was minted under a shell gate
   that read both sides through `$(…)`, which strips trailing newlines and
   nothing else. `trimRight` is the wrong tool for that: it also eats
   trailing spaces, so a row whose output gained one would keep passing.

   > chompNewlines "a\nb\n\n"
   "a\nb"

   > chompNewlines "a \n"
   "a " -}
export
chompNewlines : String -> String
chompNewlines s = match stripSuffix "\n" s
  Some t => chompNewlines t
  None => s

-- The last element dropped when it equals `want`.
dropLastIf : String -> List String -> List String
dropLastIf want ls = match reverse ls
  l :: rest => if l == want then reverse rest else ls
  [] => ls

{- | `out` without the trailing `()` line the native runtime auto-prints for
   a `main` that returns Unit (`runtime/medaka_rt.c`).

   The goldens carry no such line, having been captured from an interpreter
   that never printed one. Only a sole FINAL `()` goes: a `()` the program
   itself printed mid-stream is output, not an epilogue.

   > stripUnitAutoPrint "5\n()\n"
   "5\n"

   > stripUnitAutoPrint "()\n5\n"
   "()\n5\n" -}
export
stripUnitAutoPrint : String -> String
stripUnitAutoPrint out = unlines (dropLastIf "()" (dropLastIf "" (lines out)))

{- | The section of `all` that a batch oracle emitted for `key`: the lines
   after the `\{prefix}\{key}` marker, up to the next line carrying
   `prefix`.

   A batch oracle runs a whole corpus in ONE process and delimits its
   fixtures in a single stdout stream, so grading it means cutting that
   stream back apart. `""` when `key` has no marker at all — a fixture the
   batch never reached, which the caller grades as a mismatch against that
   fixture's golden rather than as a skip.

   > batchSection "=== " "b" "=== a\none\n=== b\ntwo\n=== c\nthree\n"
   "two\n" -}
export
batchSection : String -> String -> String -> String
batchSection prefix key all = match dropWhile (/= "\{prefix}\{key}") (lines all)
  [] => ""
  _ :: rest => unlines (takeWhile (l => not (startsWith prefix l)) rest)

-- # Grading a fatal runtime outcome

{- | What both runtime engines owe for one fixture of a corpus whose subject
   is a program that aborts.

   `Aborts code tail` is a clean diagnostic abort: exit 1, nothing on
   stdout, and `runtime error [code]: tail` on stderr — that whole line from
   a built binary, and the same line behind the `<file>:L:C: ` prefix only
   `medaka run` emits. `AbortsLocated code tail` is the same abort for a trap
   the native backend locates: the built binary's stderr is the whole line
   `medaka run` printed, its `<file>:L:C: ` prefix included. `Prints out` is the control an aborting corpus needs:
   exit 0 on both engines with exactly `out` on stdout, so that a guard
   "fixed" into rejecting everything cannot read as green. `PrintsWarned out
   note` is `Prints` for a program that is accepted with a compile-time
   warning: `medaka run` also carries `note` on stderr, while the built binary
   still has an empty stderr.

   The three observables are graded together because each one alone admits a
   different wrong answer. "Nonzero" takes a SIGSEGV's 139 for the trap; an
   empty stdout takes a program that aborted for an unrelated reason; and the
   code without its tail takes a guard that fired on the wrong side of the
   boundary, which is what the number in `index 9 out of bounds` is there to
   pin.

   `Dies run built out` is the looser sibling `Aborts` cannot express, for a
   corpus whose subject is the death itself rather than its wording: each
   engine is graded separately (`EngineDeath`), the exit is required only to
   be nonzero, and `out` is the exact stdout every graded engine must have
   produced anyway — bytes, newline included, not a chomp and not a
   substring. A fatal signal's exit code is the platform's to choose, and two
   engines can die of the same program for genuinely different reasons; what
   neither is allowed to do is die silently or print less than it already
   had. -}
public export data RuntimeOutcome =
  | Aborts String String
  | AbortsLocated String String
  | Prints String
  | PrintsWarned String String
  | Dies EngineDeath EngineDeath String

{- | What one engine owes for a `Dies` fixture.

   `Coded code` is a clean coded death: a nonzero exit with `runtime error
   [code]: ` on that engine's own stderr. `AnyCode` asks only for some
   `E-…`, for a fixture whose two engines legitimately reach different codes.
   `Unexercised` grades that engine not at all — for a fixture only one of
   them can be fairly asked about, which then also excuses a build that does
   not compile.

   Containment rather than a whole line is deliberate, and is where a `Dies`
   row is looser than an `Aborts` one: a raw signal death and a coded one are
   told apart by that line being there at all, not by its wording, and the
   two engines word it differently on purpose — `medaka run` prefixes a
   `<file>:L:C: ` location onto the ones that have a source location, names
   an unmangled binding where the emitter names a mangled one, and describes
   the interpreter's own depth guard where the binary describes a real stack.
   Wording is pinned per code by the corpus that owns it. -}
public export data EngineDeath = Coded String | AnyCode | Unexercised

abortLine : String -> String -> String
abortLine code tail = "runtime error [\{code}]: \{tail}"

observed : String -> Int -> String -> String -> String
observed engine exitCode out err =
  "\{engine} exit=\{intToString exitCode} stdout=\{debug out} stderr=\{debug err}"

-- `line` is the unlocated runtime-error line; [located] asks the built binary
-- for the run's own last stderr line, which ends in it, rather than for `line`.
abortFailure : Bool -> String -> Agreement -> Option String
abortFailure located line a =
  let suffix = ": \{line}"
  let runOut = chompNewlines a.runOut
  let runErr = chompNewlines a.runErr
  let want = if located then lastLine runErr else line
  let binOut = chompNewlines a.binOut
  let binErr = chompNewlines a.binErr
  if a.runCode /= 1 || runOut /= "" || not (endsWith suffix runErr) then
    Some
      "\{observed "run" a.runCode runOut runErr}; want exit=1, empty stdout, stderr ending \{debug suffix}"
  else if a.binCode /= 1 || binOut /= "" || binErr /= want then
    Some
      "\{observed "build+exec" a.binCode binOut binErr}; want exit=1, empty stdout, stderr \{debug want}"
  else
    None

lastLine : String -> String
lastLine s = match reverse (lines s)
  l :: _ => l
  [] => ""

printsFailure : String -> Agreement -> Option String
printsFailure want a = printsWith want "" a

-- `note` is "" for a program owed an empty stderr from `run`, else the text
-- `run`'s stderr must contain.
printsWith : String -> String -> Agreement -> Option String
printsWith want note a =
  let runOut = chompNewlines a.runOut
  let runErr = chompNewlines a.runErr
  let binOut = chompNewlines a.binOut
  let binErr = chompNewlines a.binErr
  let runErrOk = if note == "" then runErr == "" else contains note runErr
  let owed = if note == "" then "empty stderr" else "stderr carrying \{debug note}"
  if a.runCode /= 0 || runOut /= want || not runErrOk then
    Some
      "\{observed "run" a.runCode runOut runErr}; want exit=0, stdout \{debug want}, \{owed}"
  else if a.binCode /= 0 || binOut /= want || binErr /= "" then
    Some
      "\{observed "build+exec" a.binCode binOut binErr}; want exit=0, stdout \{debug want}, empty stderr"
  else
    None

deathMarker : EngineDeath -> Option String
deathMarker (Coded code) = Some "runtime error [\{code}]: "
deathMarker AnyCode = Some "runtime error [E-"
deathMarker Unexercised = None

deathFailure : String ->
  EngineDeath ->
  String ->
  Int ->
  String ->
  String ->
  Option String
deathFailure engine want wantOut exitCode out err = match deathMarker want
  None => None
  Some marker =>
    if exitCode == 0 || out /= wantOut || not (contains marker err) then
      Some
        "\{observed engine exitCode out err}; want nonzero exit, stdout \{debug wantOut}, stderr carrying \{debug marker}"
    else
      None

diesFailure : EngineDeath -> EngineDeath -> String -> Agreement -> Option String
diesFailure wantRun wantBuilt out a =
  orElse
    (deathFailure "run" wantRun out a.runCode a.runOut a.runErr)
    (deathFailure "build+exec" wantBuilt out a.binCode a.binOut a.binErr)

-- Whether the binary `medaka build` was asked to produce is evidence for
-- `want`. A `Dies` row that does not exercise it covers a fixture the
-- emitter cannot compile at all, so a failed build is that row's premise
-- rather than its failure.
gradesBuiltBinary : RuntimeOutcome -> Bool
gradesBuiltBinary (Dies _ Unexercised _) = False
gradesBuiltBinary _ = True

{- | Why `a` is not the `want` outcome, or `None` when it is exactly that
   outcome on every engine the outcome grades.

   `check` and `build` answer first and on their own: a fixture the front end
   rejected, or one whose build produced no binary, has no runtime outcome to
   compare at all, and reporting that as a stderr mismatch would blame the
   wrong stage. The build's verdict is skipped only for a row that does not
   exercise the built binary, where failing to compile is the row's premise.
   Both report their whole output rather than the first line mentioning an
   error, since the reason a fatal-outcome fixture stops being compilable is
   as often an unreadable path as a diagnostic, and that has no error-shaped
   line to pick out. -}
export
runtimeOutcomeFailure : RuntimeOutcome -> Agreement -> Option String
runtimeOutcomeFailure want a =
  if a.checkCode /= 0 then
    Some
      "`medaka check` rejected it (exit \{intToString a.checkCode}): \{debug (chompNewlines a.checkErr)}"
  else if a.buildCode /= 0 && gradesBuiltBinary want then
    Some
      "`medaka build` produced no binary (exit \{intToString a.buildCode}): \{debug (chompNewlines a.buildLog)}"
  else match want
    Aborts code tail => abortFailure False (abortLine code tail) a
    AbortsLocated code tail => abortFailure True (abortLine code tail) a
    Prints out => printsFailure out a
    PrintsWarned out note => printsWith out note a
    Dies wantRun wantBuilt out => diesFailure wantRun wantBuilt out a

-- # Sweeping a rostered fatal-outcome corpus

-- The stems of `corpus`'s own fixtures: its top-level `.mdk` files. A
-- subdirectory holds modules the fixtures import, which are not entry points
-- and pin no outcome of their own.
export
fixtureStems : String -> <FileRead, IO> Result String (List String)
fixtureStems corpus = match fixtureFiles corpus
  Err e => Err e
  Ok paths =>
    let own = filter (p => endsWith ".mdk" p && dirname p == corpus) paths
    Ok (sort (map stem own))

unmatchedNames : String -> List String -> List String -> List String
unmatchedNames what haves wants =
  map (n => "  \{n}: \{what}") (filter (n => not (elem n haves)) wants)

{- | That `rows` names exactly the fixtures on disk, exactly `want` of them.

   The count is written down rather than discovered so that a corpus which
   silently SHRANK is red rather than green over whatever is left — the
   anti-vacuity floor inside `fixtureFiles` only catches one that emptied.
   Growing the corpus is expected: add the row and raise the number in the
   same commit. The two set directions are checked as well as the count,
   since a fixture swapped for a differently named one keeps the count: a
   fixture with no row is graded by nothing at all, and a row with no fixture
   would otherwise surface later as an unreadable path, naming the spawn
   instead of the roster. -}
export
rosterAgreement : String ->
  Int ->
  List (String, RuntimeOutcome) ->
  <FileRead, IO> Expectation
rosterAgreement corpus want rows = match fixtureStems corpus
  Err e => fail "\{corpus}: \{e}"
  Ok found => match expectUnitCount want rows
    Err e => fail "\{corpus}: roster \{e}"
    Ok _ => match expectUnitCount want found
      Err e => fail "\{corpus}: \{e} on disk"
      Ok _ =>
        let roster = map fst rows
        match (unmatchedNames
            "on disk, but no row pins its outcome"
            roster
            found
          ++ unmatchedNames "pinned by a row, but no such fixture" found roster)
          [] => pass
          problems => fail "\{corpus}:\n\{unlines problems}"

planOutcome : String ->
  String ->
  (String, RuntimeOutcome) ->
  Result (Option String) (String, String)
planOutcome corpus scratch (name, _) =
  Ok ("\{corpus}/\{name}.mdk", "\{scratch}/\{name}.bin")

gradeOutcome : (String, RuntimeOutcome) ->
  (String, String) ->
  Result String Agreement ->
  Option String
gradeOutcome (name, _) _ (Err e) = Some "  \{padRight 30 ' ' name} \{e}"
gradeOutcome (name, want) _ (Ok a) =
  map (why => "  \{padRight 30 ' ' name} \{why}") (runtimeOutcomeFailure want a)

-- The whole disagreeing-fixture table goes into the failure message rather
-- than to stdout: `medaka test --native` parses a test body's own stdout back
-- as a sentinel transcript, so anything printed there never reaches a reader.
summarizeOutcomes : String -> Int -> Int -> List String -> Expectation
summarizeOutcomes corpus want graded failures =
  if graded /= want then
    fail
      "\{corpus}: graded \{intToString graded} fixtures, want exactly \{intToString want}"
  else match failures
    [] => pass
    _ =>
      fail
        "\{intToString (length failures)} of \{intToString graded} fixtures under \{corpus} missed their pinned runtime outcome:\n\{unlines failures}"

{- | Grades every row of `rows` against its fixture under `corpus`, failing
   with one line per fixture that missed its pinned outcome, and failing on
   the count alone unless exactly `want` rows were graded. -}
export
fatalOutcomeSweep : String ->
  Int ->
  List (String, RuntimeOutcome) ->
  <Exec, FileRead, IO> Expectation
fatalOutcomeSweep corpus want rows =
  sweepAgreements
    rows
    (planOutcome corpus)
    gradeOutcome
    (r => r)
    (summarizeOutcomes corpus want)
