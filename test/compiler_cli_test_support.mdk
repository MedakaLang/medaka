{- | Shared process assertions for native compiler CLI gates.

   The helpers locate the repository binary and fixtures, enforce CLI exit-code
   contracts, and match diagnostics without tying those mechanics to one test
   corpus. -}

import fs.{expectUnitCount, fixtureFiles}
import io.{getEnvOr, runVerb}
import list.{dropWhile, reverse, somes, sort, takeWhile}
import path.{dirname, stem}
import string.{
  contains,
  endsWith,
  lines,
  padRight,
  startsWith,
  stripSuffix,
  toLower,
  unlines,
}
import regex.{Regex, mustCompile, isMatch}
import test_process.{boundedVerb, boundedVerbSeconds, medakaBin, scratchDir}
import test.{
  Expectation,
  expectLineContainsAll,
  expectTextContainsAll,
  expectTextStartsWithAndContains,
  fail,
  pass,
}

root : <IO> String
root = getEnvOr "MEDAKA_ROOT" "."

export
fixtureIn : String -> String -> <IO> String
fixtureIn corpus name = "\{root}/\{corpus}/\{name}"

export
runMedaka : List String -> <Exec "_", IO> Result String (Int, String)
runMedaka args =
  map ((code, out, err) => (code, out ++ err)) (runVerb medakaBin args)

-- # Spawning inside the tree under test

{- | The raw native emitter to spawn, from `MEDAKA_EMITTER`, defaulting to the
   one in `root`.

   The peer of `test_process.medakaBin`, for a gate whose subject is the
   emitter binary itself rather than a `medaka` verb. -}
export
emitterBin : <IO> String
emitterBin = getEnvOr "MEDAKA_EMITTER" "\{root}/medaka_emitter"

{- | Runs `cmd` with `MEDAKA_ROOT` and `MEDAKA_EMITTER` named explicitly in its
   environment, killed after `secs` seconds.

   Both variables are passed rather than left to a default lookup: a gate
   shard does not export them, and a spawn that relies on the binary finding
   its own emitter is one refactor away from grading a verb that silently did
   nothing. `env` carries them because Medaka has no `setEnv`, which is the
   same device `medaka gate run` uses to hand a gate its environment. A value
   already set in this process wins, since `root` and `emitterBin` read it
   first. -}
export
boundedInTree : Int ->
  String ->
  List String ->
  <Exec "_", IO> Result String (Int, String, String)
boundedInTree secs cmd args =
  boundedVerbSeconds
    secs
    "env"
    (["MEDAKA_ROOT=\{root}", "MEDAKA_EMITTER=\{emitterBin}", cmd] ++ args)

rejectionRe : Regex
rejectionRe = mustCompile "(?i)(type error|parse error)|^error:"

{- | Whether a `check` output line reads as a rejection, case-insensitively.

   > rejectionLine "Type error: something"
   True
   > rejectionLine "PARSE ERROR near foo"
   True
   > rejectionLine "error: something went wrong"
   True
   > rejectionLine "Error: mismatch"
   True
   > rejectionLine "unexpected error: xyz"
   False
   > rejectionLine "warning: this is fine"
   False -}
rejectionLine : String -> Bool
rejectionLine line = isMatch rejectionRe line

firstErrorLine : String -> String
firstErrorLine out = match filter (contains "error" << toLower) (lines out)
  l :: _ => l
  [] => "(no line mentioning an error)"

export
expectCheckAccept : String -> <Exec "_", IO> Expectation
expectCheckAccept path = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 0 then
      fail "\{path}: expected accept, `medaka check` exited \{intToString code}"
    else if any rejectionLine (lines out) then
      fail "\{path}: expected accept, got \{debug (firstErrorLine out)}"
    else
      pass

export
expectCheckReject : String -> List String -> <Exec "_", IO> Expectation
expectCheckReject path needles = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 1 then
      fail "\{path}: expected reject, `medaka check` exited \{intToString code}"
    else
      expectTextContainsAll needles out

export
expectCheckRejectLine : String -> List String -> <Exec "_", IO> Expectation
expectCheckRejectLine path needles = match runMedaka ["check", path]
  Err e => fail "\{path}: could not run `medaka check`: \{e}"
  Ok (code, out) =>
    if code /= 1 then
      fail "\{path}: expected reject, `medaka check` exited \{intToString code}"
    else
      expectLineContainsAll needles out

export
expectVerbExitStartsWith : String ->
  List String ->
  Int ->
  String ->
  <Exec "_", IO> Expectation
expectVerbExitStartsWith verb args expectedCode prefix =
  expectVerbExitStartsWithAndContains verb args expectedCode prefix []

export
expectVerbExitStartsWithAndContains : String ->
  List String ->
  Int ->
  String ->
  List String ->
  <Exec "_", IO> Expectation
expectVerbExitStartsWithAndContains verb args expectedCode prefix needles =
  match runMedaka (verb :: args)
    Err e => fail "medaka \{verb}: could not run: \{e}"
    Ok (code, out) =>
      if code /= expectedCode then
        fail
          "medaka \{verb}: expected exit \{intToString expectedCode}, got \{intToString code}: \{debug out}"
      else
        expectTextStartsWithAndContains prefix needles out

-- # Three-verb agreement

{- | What `check`, `run` and `build` each did with one entry file, and what
   the binary `build` produced then printed.

   The three verbs share a front end and differ only in engine, so a gate
   that grades them apart is grading one program three ways. The exit codes
   alone cannot do that: a program rejected by a diagnostic and a program
   executed and killed by a runtime panic both exit 1, and a build that
   exits 0 while its binary prints the wrong number is invisible to any
   grader that stops at the code. Every stream is therefore kept separate
   and whole. -}
public export data Agreement = Agreement {
  checkCode : Int,
  checkErr : String,
  runCode : Int,
  runOut : String,
  runErr : String,
  buildCode : Int,
  buildLog : String,
  binCode : Int,
  binOut : String,
  binErr : String,
}

-- | `"ACCEPT"` when a verb exited 0, `"REJECT"` otherwise — the verdict
-- column a fixture pins.
export
verdictOf : Int -> String
verdictOf 0 = "ACCEPT"
verdictOf _ = "REJECT"

{- | Runs `medaka check`, `medaka run` and `medaka build` over `entry`,
   writing the build's output to `binPath`, and executes that binary when
   the build succeeded.

   Every spawn is bounded (`boundedVerb`), so one hanging fixture fails its
   own row rather than the job. When the build did not succeed there is no
   binary to run, and the three `bin` fields report an empty zero-exit run
   that every caller reads only after checking `buildCode`. -}
export
checkRunBuild : String -> String -> <Exec "_", IO> Result String Agreement
checkRunBuild entry binPath = match boundedVerb medakaBin ["check", entry]
  Err e => Err "\{entry}: could not run `medaka check`: \{e}"
  Ok (checkCode, _, checkErr) => match boundedVerb medakaBin ["run", entry]
    Err e => Err "\{entry}: could not run `medaka run`: \{e}"
    Ok (runCode, runOut, runErr) =>
      match boundedVerb medakaBin ["build", entry, "-o", binPath]
        Err e => Err "\{entry}: could not run `medaka build`: \{e}"
        Ok (buildCode, buildOut, buildErr) =>
          let built =
            if buildCode == 0 then boundedVerb binPath [] else Ok (0, "", "")
          match built
            Err e => Err "\{entry}: could not run the built binary: \{e}"
            Ok (binCode, binOut, binErr) => Ok Agreement {
              checkCode = checkCode,
              checkErr = checkErr,
              runCode = runCode,
              runOut = runOut,
              runErr = runErr,
              buildCode = buildCode,
              buildLog = buildOut ++ buildErr,
              binCode = binCode,
              binOut = binOut,
              binErr = binErr,
            }

-- | True when the built binary itself proves nothing pinned wrong: it
-- exited 0 and its stderr carries no runtime panic. Only meaningful after
-- the caller has already checked `buildCode == 0` — `checkRunBuild`
-- synthesizes a zero-exit/empty-string `bin*` triple when the build itself
-- failed, so this predicate reads as trivially true in that case.
export
binaryRanClean : Agreement -> Bool
binaryRanClean a = a.binCode == 0 && not (contains "E-PANIC" a.binErr)

-- # Sweeping a corpus

{- | Grades every `unit` through `gradeOne` in a fresh scratch directory,
   collects each row's failure message via `rowFailure`, then hands the
   whole batch to `summarize`.

   Every gate that sweeps a corpus shares this exact outer dance and differs
   only in its row shape and `summarize`'s wording, so those stay the
   caller's own `gradeOne`/`rowFailure`/`summarize` rather than being
   unified here. -}
export
sweepUnits : List unit ->
  (String -> unit -> <Exec "_", FileRead "_", IO> row) ->
  (row -> Option String) ->
  (Int -> List String -> Expectation) ->
  <Exec "_", FileRead "_", IO> Expectation
sweepUnits units gradeOne rowFailure summarize = match scratchDir
  Err e => fail "could not make a scratch directory: \{e}"
  Ok scratch =>
    let graded = map (gradeOne scratch) units
    let failures = somes (map rowFailure graded)
    let _ = runVerb "rm" ["-rf", scratch]
    summarize (length graded) failures

-- # Reading a spawned oracle's stdout

{- | `s` without its trailing newlines.

   Every golden these helpers grade against was minted under a shell gate
   that read both sides through `$(…)`, which strips trailing newlines and
   nothing else. `trimRight` is the wrong tool for that: it also eats
   trailing spaces, so a row whose output gained one would keep passing.

   > chompNewlines "a\nb\n\n"
   "a\nb"

   > chompNewlines "a \n"
   "a " -}
export
chompNewlines : String -> String
chompNewlines s = match stripSuffix "\n" s
  Some t => chompNewlines t
  None => s

-- The last element dropped when it equals `want`.
dropLastIf : String -> List String -> List String
dropLastIf want ls = match reverse ls
  l :: rest => if l == want then reverse rest else ls
  [] => ls

{- | `out` without the trailing `()` line the native runtime auto-prints for
   a `main` that returns Unit (`runtime/medaka_rt.c`).

   The goldens carry no such line, having been captured from an interpreter
   that never printed one. Only a sole FINAL `()` goes: a `()` the program
   itself printed mid-stream is output, not an epilogue.

   > stripUnitAutoPrint "5\n()\n"
   "5\n"

   > stripUnitAutoPrint "()\n5\n"
   "()\n5\n" -}
export
stripUnitAutoPrint : String -> String
stripUnitAutoPrint out = unlines (dropLastIf "()" (dropLastIf "" (lines out)))

{- | The section of `all` that a batch oracle emitted for `key`: the lines
   after the `\{prefix}\{key}` marker, up to the next line carrying
   `prefix`.

   A batch oracle runs a whole corpus in ONE process and delimits its
   fixtures in a single stdout stream, so grading it means cutting that
   stream back apart. `""` when `key` has no marker at all — a fixture the
   batch never reached, which the caller grades as a mismatch against that
   fixture's golden rather than as a skip.

   > batchSection "=== " "b" "=== a\none\n=== b\ntwo\n=== c\nthree\n"
   "two\n" -}
export
batchSection : String -> String -> String -> String
batchSection prefix key all = match dropWhile (/= "\{prefix}\{key}") (lines all)
  [] => ""
  _ :: rest => unlines (takeWhile (l => not (startsWith prefix l)) rest)

-- # Grading a fatal runtime outcome

{- | What both runtime engines owe for one fixture of a corpus whose subject
   is a program that aborts.

   `Aborts code tail` is a clean diagnostic abort: exit 1, nothing on
   stdout, and `runtime error [code]: tail` on stderr — that whole line from
   a built binary, and the same line behind the `<file>:L:C: ` prefix only
   `medaka run` emits. `Prints out` is the control an aborting corpus needs:
   exit 0 on both engines with exactly `out` on stdout, so that a guard
   "fixed" into rejecting everything cannot read as green.

   The three observables are graded together because each one alone admits a
   different wrong answer. "Nonzero" takes a SIGSEGV's 139 for the trap; an
   empty stdout takes a program that aborted for an unrelated reason; and the
   code without its tail takes a guard that fired on the wrong side of the
   boundary, which is what the number in `index 9 out of bounds` is there to
   pin.

   `Dies run built out` is the looser sibling `Aborts` cannot express, for a
   corpus whose subject is the death itself rather than its wording: each
   engine is graded separately (`EngineDeath`), the exit is required only to
   be nonzero, and `out` is the exact stdout every graded engine must have
   produced anyway — bytes, newline included, not a chomp and not a
   substring. A fatal signal's exit code is the platform's to choose, and two
   engines can die of the same program for genuinely different reasons; what
   neither is allowed to do is die silently or print less than it already
   had. -}
public export data RuntimeOutcome =
  | Aborts String String
  | Prints String
  | Dies EngineDeath EngineDeath String

{- | What one engine owes for a `Dies` fixture.

   `Coded code` is a clean coded death: a nonzero exit with `runtime error
   [code]: ` on that engine's own stderr. `AnyCode` asks only for some
   `E-…`, for a fixture whose two engines legitimately reach different codes.
   `Unexercised` grades that engine not at all — for a fixture only one of
   them can be fairly asked about, which then also excuses a build that does
   not compile.

   Containment rather than a whole line is deliberate, and is where a `Dies`
   row is looser than an `Aborts` one: a raw signal death and a coded one are
   told apart by that line being there at all, not by its wording, and the
   two engines word it differently on purpose — `medaka run` prefixes a
   `<file>:L:C: ` location onto the ones that have a source location, names
   an unmangled binding where the emitter names a mangled one, and describes
   the interpreter's own depth guard where the binary describes a real stack.
   Wording is pinned per code by the corpus that owns it. -}
public export data EngineDeath = Coded String | AnyCode | Unexercised

abortLine : String -> String -> String
abortLine code tail = "runtime error [\{code}]: \{tail}"

observed : String -> Int -> String -> String -> String
observed engine exitCode out err =
  "\{engine} exit=\{intToString exitCode} stdout=\{debug out} stderr=\{debug err}"

abortFailure : String -> Agreement -> Option String
abortFailure want a =
  let suffix = ": \{want}"
  let runOut = chompNewlines a.runOut
  let runErr = chompNewlines a.runErr
  let binOut = chompNewlines a.binOut
  let binErr = chompNewlines a.binErr
  if a.runCode /= 1 || runOut /= "" || not (endsWith suffix runErr) then
    Some
      "\{observed "run" a.runCode runOut runErr}; want exit=1, empty stdout, stderr ending \{debug suffix}"
  else if a.binCode /= 1 || binOut /= "" || binErr /= want then
    Some
      "\{observed "build+exec" a.binCode binOut binErr}; want exit=1, empty stdout, stderr \{debug want}"
  else
    None

printsFailure : String -> Agreement -> Option String
printsFailure want a =
  let runOut = chompNewlines a.runOut
  let binOut = chompNewlines a.binOut
  if a.runCode /= 0 || runOut /= want then
    Some
      "\{observed "run" a.runCode runOut (chompNewlines a.runErr)}; want exit=0, stdout \{debug want}"
  else if a.binCode /= 0 || binOut /= want then
    Some
      "\{observed "build+exec" a.binCode binOut (chompNewlines a.binErr)}; want exit=0, stdout \{debug want}"
  else
    None

deathMarker : EngineDeath -> Option String
deathMarker (Coded code) = Some "runtime error [\{code}]: "
deathMarker AnyCode = Some "runtime error [E-"
deathMarker Unexercised = None

deathFailure : String ->
  EngineDeath ->
  String ->
  Int ->
  String ->
  String ->
  Option String
deathFailure engine want wantOut exitCode out err = match deathMarker want
  None => None
  Some marker =>
    if exitCode == 0 || out /= wantOut || not (contains marker err) then
      Some
        "\{observed engine exitCode out err}; want nonzero exit, stdout \{debug wantOut}, stderr carrying \{debug marker}"
    else
      None

diesFailure : EngineDeath -> EngineDeath -> String -> Agreement -> Option String
diesFailure wantRun wantBuilt out a =
  orElse
    (deathFailure "run" wantRun out a.runCode a.runOut a.runErr)
    (deathFailure "build+exec" wantBuilt out a.binCode a.binOut a.binErr)

-- Whether the binary `medaka build` was asked to produce is evidence for
-- `want`. A `Dies` row that does not exercise it covers a fixture the
-- emitter cannot compile at all, so a failed build is that row's premise
-- rather than its failure.
gradesBuiltBinary : RuntimeOutcome -> Bool
gradesBuiltBinary (Dies _ Unexercised _) = False
gradesBuiltBinary _ = True

{- | Why `a` is not the `want` outcome, or `None` when it is exactly that
   outcome on every engine the outcome grades.

   `check` and `build` answer first and on their own: a fixture the front end
   rejected, or one whose build produced no binary, has no runtime outcome to
   compare at all, and reporting that as a stderr mismatch would blame the
   wrong stage. The build's verdict is skipped only for a row that does not
   exercise the built binary, where failing to compile is the row's premise.
   Both report their whole output rather than the first line mentioning an
   error, since the reason a fatal-outcome fixture stops being compilable is
   as often an unreadable path as a diagnostic, and that has no error-shaped
   line to pick out. -}
export
runtimeOutcomeFailure : RuntimeOutcome -> Agreement -> Option String
runtimeOutcomeFailure want a =
  if a.checkCode /= 0 then
    Some
      "`medaka check` rejected it (exit \{intToString a.checkCode}): \{debug (chompNewlines a.checkErr)}"
  else if a.buildCode /= 0 && gradesBuiltBinary want then
    Some
      "`medaka build` produced no binary (exit \{intToString a.buildCode}): \{debug (chompNewlines a.buildLog)}"
  else match want
    Aborts code tail => abortFailure (abortLine code tail) a
    Prints out => printsFailure out a
    Dies wantRun wantBuilt out => diesFailure wantRun wantBuilt out a

-- # Sweeping a rostered fatal-outcome corpus

-- The stems of `corpus`'s own fixtures: its top-level `.mdk` files. A
-- subdirectory holds modules the fixtures import, which are not entry points
-- and pin no outcome of their own.
export
fixtureStems : String -> <FileRead "_", IO> Result String (List String)
fixtureStems corpus = match fixtureFiles corpus
  Err e => Err e
  Ok paths =>
    let own = filter (p => endsWith ".mdk" p && dirname p == corpus) paths
    Ok (sort (map stem own))

unmatchedNames : String -> List String -> List String -> List String
unmatchedNames what haves wants =
  map (n => "  \{n}: \{what}") (filter (n => not (elem n haves)) wants)

{- | That `rows` names exactly the fixtures on disk, exactly `want` of them.

   The count is written down rather than discovered so that a corpus which
   silently SHRANK is red rather than green over whatever is left — the
   anti-vacuity floor inside `fixtureFiles` only catches one that emptied.
   Growing the corpus is expected: add the row and raise the number in the
   same commit. The two set directions are checked as well as the count,
   since a fixture swapped for a differently named one keeps the count: a
   fixture with no row is graded by nothing at all, and a row with no fixture
   would otherwise surface later as an unreadable path, naming the spawn
   instead of the roster. -}
export
rosterAgreement : String ->
  Int ->
  List (String, RuntimeOutcome) ->
  <FileRead "_", IO> Expectation
rosterAgreement corpus want rows = match fixtureStems corpus
  Err e => fail "\{corpus}: \{e}"
  Ok found => match expectUnitCount want rows
    Err e => fail "\{corpus}: roster \{e}"
    Ok _ => match expectUnitCount want found
      Err e => fail "\{corpus}: \{e} on disk"
      Ok _ =>
        let roster = map fst rows
        match (unmatchedNames
            "on disk, but no row pins its outcome"
            roster
            found
          ++ unmatchedNames "pinned by a row, but no such fixture" found roster)
          [] => pass
          problems => fail "\{corpus}:\n\{unlines problems}"

gradeOutcome : String ->
  String ->
  (String, RuntimeOutcome) ->
  <Exec "_", FileRead "_", IO> Option String
gradeOutcome corpus scratch (name, want) =
  match checkRunBuild "\{corpus}/\{name}.mdk" "\{scratch}/\{name}.bin"
    Err e => Some "  \{padRight 30 ' ' name} \{e}"
    Ok a =>
      map
        (why => "  \{padRight 30 ' ' name} \{why}")
        (runtimeOutcomeFailure want a)

-- The whole disagreeing-fixture table goes into the failure message rather
-- than to stdout: `medaka test --native` parses a test body's own stdout back
-- as a sentinel transcript, so anything printed there never reaches a reader.
summarizeOutcomes : String -> Int -> Int -> List String -> Expectation
summarizeOutcomes corpus want graded failures =
  if graded /= want then
    fail
      "\{corpus}: graded \{intToString graded} fixtures, want exactly \{intToString want}"
  else match failures
    [] => pass
    _ =>
      fail
        "\{intToString (length failures)} of \{intToString graded} fixtures under \{corpus} missed their pinned runtime outcome:\n\{unlines failures}"

{- | Grades every row of `rows` against its fixture under `corpus`, failing
   with one line per fixture that missed its pinned outcome, and failing on
   the count alone unless exactly `want` rows were graded. -}
export
fatalOutcomeSweep : String ->
  Int ->
  List (String, RuntimeOutcome) ->
  <Exec "_", FileRead "_", IO> Expectation
fatalOutcomeSweep corpus want rows =
  sweepUnits rows (gradeOutcome corpus) (r => r) (summarizeOutcomes corpus want)
