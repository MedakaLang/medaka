-- W9 port of test/llvm_fixtures_modules/iface_name_collision_default/ifa.mdk
-- (#1418). #1047 (S0, CLOSED), module A: declares `interface Speak` with the
-- default `"A-default"`. It has NO import relationship of any kind with ifb.mdk,
-- which declares an interface of the SAME BARE NAME with a DIFFERENT default
-- body.
export interface Speak x where
  speak : x -> String
  speak _ = "A-default"
