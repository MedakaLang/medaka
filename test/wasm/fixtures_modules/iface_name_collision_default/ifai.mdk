-- W9 port of test/llvm_fixtures_modules/iface_name_collision_default/ifai.mdk
-- (#1418). #1047: A's implementor. `impl Speak DogA` is METHOD-LESS, so DogA
-- inherits ifa.mdk's default body ("A-default"), cross-module. Its disposition
-- row is `InheritedDefault`, and its entry dispatches through the shared default
-- body by its own canonical dictionary word, module boundary notwithstanding.
import ifa.{Speak(..), speak}

public export data DogA = DogA

impl Speak DogA where

export sayA : DogA -> String
sayA d = speak d
