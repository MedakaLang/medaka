-- `aacfg` declares a record TYPE named `Cfg` whose sole field, `fld`, is a `Float`.
-- `entry.mdk` never imports `Cfg` from here — only the unrelated `aaf` function —
-- but this module's `Cfg` is still in the module graph, which was enough.
public export data Cfg = { fld : Float }

export aaf : Int -> Int
aaf n = n
