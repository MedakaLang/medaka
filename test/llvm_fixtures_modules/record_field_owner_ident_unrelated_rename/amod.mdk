-- Byte-identical to `field_owner_no_narrowing/amod.mdk`: a NAMED-FIELD VARIANT whose
-- registry key is `Dup` and whose type is `RA`.  That gap is what sends `mkA.dx` down
-- the field→owners fallback instead of the exact `lookupRecordByName <head tycon>` hit.
public export data RA =
  | Dup { dx : Int }
  | ACount Int

export mkA : RA
mkA = Dup { dx = 7 }
