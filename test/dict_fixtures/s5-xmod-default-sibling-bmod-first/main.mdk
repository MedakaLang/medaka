-- §5 (#1821): `dflt` is imported from amod1821 only; bmod1821's same-spelled `dflt`
-- default is in scope under no name.  IA's default `dflt x = sib x + 1` runs for T,
-- whose `sib x = sup x * 10` and `sup (T 7) = 7`, so the answer is 71.  9000 would be
-- IB's default.
-- The row above with its two import lines exchanged, and nothing else.
import bmod1821.{IB, other}
import amod1821.{Sup, IA, sup, sib, dflt}

data T = T Int

impl Sup T where
  sup (T n) = n

impl IA T where
  sib x = sup x * 10

impl IB T where
  other _ = 1

main = println (dflt (T 7))
