-- Control: the same body under the closed head `impl Show2 (Box Int)`. The goal is
-- `Conv Int String`, which the one instance answers. Hand-derived: `conv` returns
-- "i" for every Int.
data Box a = Box a

interface Conv a b where
  conv : a -> b

impl Conv Int String where
  conv _ = "i"

interface Show2 t where
  show2 : t -> String

impl Show2 (Box Int) where
  show2 (Box x) = conv x

main = println (show2 (Box 1))
