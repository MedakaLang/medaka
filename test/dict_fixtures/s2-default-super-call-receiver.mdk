-- #3509 (drained from its must-fail pin): an inherited default calls a SUPER method on
-- its receiver; the super has a general instance AND a more specific one at the
-- receiver's type.  DICT §2/§3: `shout` builds the `Fmt (Box Int)` dictionary at its
-- call site, solving the `Named` super at that goal (the SPECIFIC `Named (Box Int)`);
-- the inherited `loud` receives that dictionary and projects the super out of it.
-- `Box Cat` has no specific `Named` impl, so the general one answers.
-- Expected: [b:spec]|[b:gen(cat)]
interface Named a where
  nm : a -> String
interface Fmt a requires Named a where
  fmt : a -> String
  loud : a -> String
  loud x = "[" ++ fmt x ++ ":" ++ nm x ++ "]"
data Cat = Cat
data Box a = Box a
impl Named Cat where
  nm _ = "cat"
impl Named Int where
  nm _ = "int"
impl Fmt Cat where
  fmt _ = "b"
impl Fmt Int where
  fmt _ = "b"
impl Named (Box a) requires Named a where
  nm (Box v) = "gen(" ++ nm v ++ ")"
impl Named (Box Int) where
  nm (Box v) = "spec"
impl Fmt (Box a) requires Fmt a where
  fmt (Box v) = fmt v
shout : Fmt a => a -> String
shout x = loud x
main = println (shout (Box (1 : Int)) ++ "|" ++ shout (Box Cat))
