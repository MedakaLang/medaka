-- S-cardinality-conformance (closes out #1871): the #1869 shape, RESTORED from the
-- drained must_fail pin (was test/must_fail_fixtures/1869-inferred-constrained-
-- binding-order-dependent/main.mdk before S-inferred-vector-supply drained it). TWO
-- structurally identical interfaces whose impls are declared in OPPOSITE orders, two
-- UNSIGNATURED (inferred) bindings each calling one method. The correct answer
-- (docs/spec/DICT-SEMANTICS.md §3) is 2442 = 222 (Ix Int Char) + 2220 (Jx Int Char),
-- order-independent -- see the `-swapped` sibling for the other declaration order.
-- Section 3 (IRS below) pins each binding's slot count: ONE bare-tyvar 2-ary predicate
-- (`Ix a b`) is ONE dict slot, so `useIx`/`useJx` each abstract 1 dict + 2 values = 3
-- params -- the SAME count as their signatured oracle, s-cardinality-signatured.mdk.
interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Bool where
  ix _ _ = 111

impl Ix Int Char where
  ix _ _ = 222

interface Jx a b where
  jx : a -> b -> Int

impl Jx Int Char where
  jx _ _ = 2220

impl Jx Int Bool where
  jx _ _ = 1110

useIx p q = ix p q

useJx p q = jx p q

main = println (useIx 5 'z' + useJx 5 'z')
