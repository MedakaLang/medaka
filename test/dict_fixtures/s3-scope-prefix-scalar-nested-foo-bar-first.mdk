-- Interface-order twin of s3-scope-prefix-scalar-nested-foo-first.  Reordering
-- `foo_bar` ahead of `foo` must not change lexical ownership or the result 7.
interface D a where
  d : a -> Int

impl D Int where
  d _ = 7

useD : D a => a -> Int
useD x = d x

data Box a = Box a

interface C t where
  foo_bar : t -> Int
  foo : t -> Int

impl C (Box a) requires D a where
  foo_bar (Box x) = useD x
  foo (Box x) = useD x

main = println (foo (Box 0))
