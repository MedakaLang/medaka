-- R-SUPER-CARRY control: `impl Sub (Box a) requires Sup (Box a)` hands the super to the
-- use, and with no `Show2 Bool`, `f True` is T-NO-IMPL at the call, on every verb.
interface Show2 t where
  show2 : t -> String
impl Show2 Int where
  show2 _ = "i"
interface Sup a where
  sup : a -> String
interface Sub a requires Sup a where
  sub : a -> String
data Box a = Box a
data Two a = Two a
impl Sup (Box a) where
  sup _ = "sup"
impl Sup (Box (Two a)) requires Show2 a where
  sup (Box (Two x)) = "supt" ++ show2 x
impl Sub (Box a) requires Sup (Box a) where
  sub _ = "sub"
useSup : Sub a => a -> String
useSup x = sup x ++ sub x
f x = useSup (Box (Two x))
main =
  println (f (1 : Int))
  println (f True)
