-- R-SUPER-CARRY control: the signature declares the carried `Show2 a`, so the super
-- dictionary is built from the caller's evidence: `suptisub` then `suptbsub`.
interface Show2 t where
  show2 : t -> String
impl Show2 Int where
  show2 _ = "i"
impl Show2 Bool where
  show2 _ = "b"
interface Sup a where
  sup : a -> String
interface Sub a requires Sup a where
  sub : a -> String
data Box a = Box a
data Two a = Two a
impl Sup (Box a) where
  sup _ = "sup"
impl Sup (Box (Two a)) requires Show2 a where
  sup (Box (Two x)) = "supt" ++ show2 x
impl Sub (Box a) where
  sub _ = "sub"
useSup : Sub a => a -> String
useSup x = sup x ++ sub x
f : Show2 a => a -> String
f x = useSup (Box (Two x))
main =
  println (f (1 : Int))
  println (f True)
