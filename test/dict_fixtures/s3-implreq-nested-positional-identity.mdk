-- Complete predicate identity recurses below TApp.  The two requires slots share
-- `a` and the outer `List` head; only the nested variable distinguishes them.
data W a b c = W a b c

interface Ix a b where
  ix : a -> b -> Int

impl Ix Int (List Char) where
  ix _ _ = 300

impl Ix Int (List Bool) where
  ix _ _ = 100

interface Sz s where
  sz : s -> Int

impl Sz (W a b c) requires Ix a (List b), Ix a (List c) where
  sz (W n x y) = ix n [x] + ix n [y]

main = println (sz (W 5 'z' True))
