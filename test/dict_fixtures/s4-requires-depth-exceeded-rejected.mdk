-- §3 `inst` reduction past the old depth bound, at a generalizing binder (issue 1562's
-- shape, re-derived under §3 W2).
--
-- `deep` nests `Wrap` 33 deep, so discharging `Tag (Wrap^33 t)` takes 33 `requires`
-- steps through `impl Tag (Wrap a) requires Tag a`.  Every step is one `Wrap` smaller
-- than its parent, so under W2's measure no step spends fuel: the chain shrinks to the
-- residual `Tag t`, which `gen` abstracts (`deep : Tag a => a -> String`).  ACCEPT on
-- every verb; `deep 5` prints one `w` per `Wrap` and then `int`:
--     wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwint
-- (33 `w`s, hand-counted from the nesting depth).
--
-- History: this file was a REJECT (`T-REQUIRES-DEPTH`) while the reducer counted every
-- step against a flat bound of 32.  Before that it was issue 1562's S0: exhaustion was
-- silent, the predicate was dropped from the scheme and the dict prefix, and the built
-- binary segfaulted.  A chain that does not shrink is still a located reject:
-- requires-growing-context-depth-rejected.mdk.
-- that a code assertion cannot see (see that section's header).
data Wrap a = Wrap a

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

impl Tag (Wrap a) requires Tag a where
  tagOf (Wrap x) = "w\{tagOf x}"

deep x = tagOf (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap  x)))))))))))))))))))))))))))))))))

main = println (deep 5)
