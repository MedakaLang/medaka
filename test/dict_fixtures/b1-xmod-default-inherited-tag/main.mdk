-- An impl that inherits every method, declared in a module OTHER than its
-- interface's.  Its site selects the instance and routes on the instance's
-- canonical key to the inherited default's per-instance entry
-- (`@mdk_default_<iface>_<method>_<instance key>`), exactly as `iface.mdk`'s
-- same-module `Cup` does.
--
-- HAND-DERIVED FROM THE SPEC, not captured: both impls are method-less, so both
-- occurrences run the interface default `sz _ = 42`.  100 * 42 + 42 = 4242.
-- EXPECTED: 4242
--
-- The value is not the assertion: both occurrences answer 42 whichever entry
-- they reach.  `diff_compiler_dict_semantics_ir.sh`'s rows pin both emitted
-- per-instance symbols and the canonical word the cross-module receiver carries.
import iface.{Sz(..), sz, Cup(..)}

data Box = Box

impl Sz Box

main = println (sz Box * 100 + sz Cup)
