-- The interface, with a DEFAULT body, in a module of its own.
--
-- `Cup`'s impl is METHOD-LESS and lives HERE, in the interface's own module: the
-- SAME-MODULE twin of `main.mdk`'s `Box` impl, the same source shape one module
-- over.  Both inherit the default the same way -- see that file.
export interface Sz a where
  sz : a -> Int
  sz _ = 42

public export data Cup = Cup

impl Sz Cup where
