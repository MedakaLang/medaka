-- §6.1.3, the signed-caller shape over a higher-kinded prelude interface: `h` keeps
-- `Applicative (Result a)` because its super goal `Mappable (Result a)` unifies with
-- the program's `impl Mappable (Result Color)` (#4023).  The signed
-- `k2 : b -> Result b Int` holds `b` rigid, so the super commits to the prelude's
-- `impl Mappable (Result e)`, which keeps `Err Red`: `k2 Red` prints `red`, while
-- `h Red` selects the program impl and prints `green`, on every verb.
data Color = Red | Green deriving (Eq, Ord)
impl Mappable (Result Color) where
  map _ _ = Err Green
useAp : Applicative f => f Int -> f Int
useAp v = map (x => x + 1) v
mkErr : e -> Result e Int
mkErr e = Err e
h e = useAp (mkErr e)
k2 : b -> Result b Int
k2 y = h y
colorOf : Result Color Int -> String
colorOf r = match r
  Ok _ => "ok"
  Err Red => "red"
  Err Green => "green"
main =
  println (colorOf (k2 Red))
  println (colorOf (h Red))
