-- §3 the verdict on an open vector goal of the call window: `useIx []` poses
-- `Ix ?a Bool`, and both `impl Ix Int Bool` and the headless `impl Ix a Bool`
-- unify with it.  `?a` is in no member's type, so the goal is `main`s and no
-- type chooses between the two.  Hand-derived: REJECT on all three verbs,
-- T-AMBIGUOUS-INSTANCE at the `useIx` call.
interface Ix a b where
  ix : List a -> b -> Int

impl Ix Int Bool where
  ix _ _ = 111

impl Ix a Bool where
  ix _ _ = 222

useIx : Ix a Bool => List a -> Int
useIx xs = ix xs True

main = println (useIx [])
