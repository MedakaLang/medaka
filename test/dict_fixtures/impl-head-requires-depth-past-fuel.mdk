-- §3 W3-inst one step deeper than impl-head-requires-depth-at-fuel.mdk: the body of
-- `impl Tag (Q a)` poses `Tag (W^33 a)` with no `requires Tag a`.  Each reduction
-- step is one `W` smaller, so under §3 W2's measure none spends fuel, and the chain
-- reaches the residual `Tag a`, which no given answers: the impl is refused naming the
-- `requires` to add (`T-IMPL-MISSING-REQUIRES`), exactly as at depth 32.  It used to
-- stop one step short with `T-REQUIRES-DEPTH` under a flat 32-step bound.
interface Tag a where
  tag : a -> Int

impl Tag Int where
  tag n = n

data W a = W a

impl Tag (W a) requires Tag a where
  tag (W x) = tag x + 1

data Q a = Q a

impl Tag (Q a) where
  tag (Q x) = tag (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (x))))))))))))))))))))))))))))))))))

main = println (tag (Q (1 : Int)))
