-- §6.1.3 R-STABLE over super selection (#4023), control: with only the general
-- `impl Sup (Box a)`, the super goal `Sup (Box a)` selects it at every
-- instantiation, so `g`'s goal is still reduced: `g : a -> String`, `GENsub` twice.
interface Show2 t where
  show2 : t -> String
impl Show2 Int where
  show2 _ = "i"
impl Show2 Bool where
  show2 _ = "b"
interface Sup a where
  sup : a -> String
interface Sub a requires Sup a where
  sub : a -> String
data Box a = Box a
data Two a = Two a
impl Sup (Box a) where
  sup _ = "GEN"
impl Sub (Box a) where
  sub _ = "sub"
useSup : Sub a => a -> String
useSup x = sup x ++ sub x
g x = useSup (Box x)
main =
  println (g (Two True))
  println (useSup (Box (Two True)))
