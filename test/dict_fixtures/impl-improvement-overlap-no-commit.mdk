-- §3 improvement never fires under overlap: both instances unify with
-- `Pick (List t) (List n) (List Int)` (`n` the literals' variable, not yet
-- defaulted when the group closes), so `t` is not committed, although the
-- one-sided matcher accepts only `Pick a a a` there.  After defaulting both
-- match modulo `t`; `t` stays undetermined (§6.2 T4, #3535): check accepts
-- with the incomparable-impls warning, the build has no instance to emit.
-- Both bodies return their first argument, so `run` prints [] whichever
-- instance its dispatch reaches.
interface Pick a b c where
  pick : a -> b -> c

impl Pick a a a where
  pick x _ = x

impl Pick a (List Int) a where
  pick x _ = x

main =
  let r : List Int = pick [] [3, 7]
  println (debug r)
