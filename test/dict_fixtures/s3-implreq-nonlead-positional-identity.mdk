-- #1981 drain.  Each `Ix` predicate is one ordered three-argument slot.  At the
-- `Sz (W Int Char Bool)` use, the first requirement denotes `Ix Int Char Bool`
-- (333) and the second `Ix Int Bool Char` (111), so the spec answer is 444.
-- A consumer that compares only the lead argument collapses both to one route.
data W a b c = W a b c

interface Ix a b c where
  ix : a -> b -> c -> Int

impl Ix Int Char Bool where
  ix _ _ _ = 333

impl Ix Int Bool Char where
  ix _ _ _ = 111

interface Sz s where
  sz : s -> Int

impl Sz (W a b c) requires Ix a b c, Ix a c b where
  sz (W n x y) = ix n x y + ix n y x

main = println (sz (W 5 'z' True))
