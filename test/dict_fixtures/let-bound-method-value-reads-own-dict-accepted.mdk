-- #4116: `let f = k` binds a method value whose receiver type the body of
-- `main` fixes only at the later call `f (Box 2)`.  The let-bound value takes
-- its own dictionary parameter, and its body's occurrence of `k` reads it
-- (`RDict`), as an assumption answers a goal before any instance does.
-- Hand-derived from DICT-SEMANTICS §3: the call's goal `K (Box Int) ?b` has one
-- matching instance, so the dictionary passed is `impl K (Box Int) Bool` and the
-- program prints `INTBOOL` on every verb.
interface K a b where
  k : a -> String
  mk : b -> a
data Box a = Box a
impl K (Box Int) Bool where
  k _ = "INTBOOL"
  mk _ = Box 2
impl K (Box String) Int where
  k _ = "STRINT"
  mk _ = Box "s"
main =
  let f = k
  println (f (Box (2 : Int)))
