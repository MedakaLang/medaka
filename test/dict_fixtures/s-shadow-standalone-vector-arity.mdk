-- C4, L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error.
interface Sizeable a where
  size : a -> Int

data Box = Box Int

impl Sizeable Box where
  size (Box n) = n

interface Ix a b where
  ix : a -> b -> Int

impl Ix Int Char where
  ix _ _ = 222

impl Ix Int Bool where
  ix _ _ = 111

size : (Ix a Char, Ix a Bool) => a -> Int
size n = ix n 'z' + ix n True

plain : Ix a Char => a -> Int
plain n = ix n 'z'

main =
  let _ = println (size 5)
  println (plain 5)
