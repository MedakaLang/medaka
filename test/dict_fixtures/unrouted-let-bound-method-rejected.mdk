-- #4116: `let f = k` binds a method value whose receiver type the body of
-- `main` fixes only at the later call `f (Box 2)`.  The let-bound value is
-- generalized with its own dictionary parameter, but its body's occurrence of
-- `k` is left with no route (`RNone`), so no instance is committed for it.
-- Hand-derived from DICT-SEMANTICS §3: the call's goal `K (Box Int) ?b` has one
-- matching instance and the program should print `INTBOOL`.  Today the hole is
-- a check reject: T-UNROUTED-DISPATCH at 19:10 (the `k` of `let f = k`).
interface K a b where
  k : a -> String
  mk : b -> a
data Box a = Box a
impl K (Box Int) Bool where
  k _ = "INTBOOL"
  mk _ = Box 2
impl K (Box String) Int where
  k _ = "STRINT"
  mk _ = Box "s"
main =
  let f = k
  println (f (Box (2 : Int)))
