-- DICT-SEMANTICS §2 "evidence is a TREE" + §7 single-evaluator law.
-- s3-nested-obligation-most-specific one level deeper, so the general instance's
-- captured context evidence is itself a dictionary built by `inst`, not a leaf.
--
-- SPEC ANSWER (hand-derived, BEFORE running anything):
--   goal `Tag (List (List (List Int)))`
--     -> only `Tag (List a)` matches; its context is `Tag (List (List Int))`
--     -> only `Tag (List a)` matches; its context is `Tag (List Int)`
--     -> `Tag (List Int)` is the ⊑-minimum                     => 99
--   unwinding: 10 + (10 + 99)                                  => 119
--
-- Both eval and native must retain the recursively supplied dictionaries.
-- The overlapping concrete instance changes the innermost result from 1 to 99;
-- the no-overlap sibling yields 31 and distinguishes overlap from nesting depth.
-- The initial output 7 is retained before the recursive result.
interface Tag a where
  tag : a -> Int

impl Tag Int where
  tag _ = 1

impl Tag (List a) requires Tag a where
  tag xs = match xs
    y :: _ => 10 + tag y
    [] => 10

impl Tag (List Int) where
  tag _ = 99

main =
  println 7
  println (tag ([[[1]]] : List (List (List Int))))
