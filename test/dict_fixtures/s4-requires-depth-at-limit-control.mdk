-- §3 `inst` reduction at a generalizing binder, the control for
-- s4-requires-depth-exceeded-rejected.mdk (one `Wrap` deeper).
--
-- `deep` nests `Wrap` 32 deep, the old flat bound.  Every step is one `Wrap` smaller,
-- so under §3 W2's measure none spends fuel.  The reduction bottoms out on `impl Tag
-- Int`, leaves the residual `Tag t`, and `gen` abstracts its dict, so this file must
-- ACCEPT and its BUILT BINARY must print
--     wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwint
-- (32 `w`s, hand-counted from the nesting depth) at exit 0.
--
-- It is built and EXECUTED: before issue 1562 this depth was silently dropped from the
-- scheme and the dict prefix, and the binary segfaulted.  Accepted under the flat bound
-- (the terminal test in `residualPredsOf` runs before a goal is entered) and under W2.
data Wrap a = Wrap a

interface Tag t where
  tagOf : t -> String

impl Tag Int where
  tagOf _ = "int"

impl Tag (Wrap a) requires Tag a where
  tagOf (Wrap x) = "w\{tagOf x}"

deep x = tagOf (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap (Wrap  x))))))))))))))))))))))))))))))))

main = println (deep 5)
