-- #1386: an UNRELATED interface, deliberately using a DIFFERENT method name
-- (`mthb`, not `mth`) than ifacea's `IA.mth`. main.mdk's `Blob` implements
-- ONLY this interface. There is NO bare-name collision anywhere in this
-- program: nothing but `IA` is ever named `mth`.
export interface IB a where
  mthb : a -> Int
