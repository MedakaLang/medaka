-- §6.1.4 pt 4, R-SUPER-CARRY (#4010): `Sub (Box (Two x))` is built by `impl Sub (Box a)`,
-- and its `Sup (Box (Two x))` super by the more specific `impl Sup (Box (Two a)) requires
-- Show2 a`, so the generalizing `f` carries `Show2 a`: `f : Show2 a => a -> String`, and
-- `f True` is T-NO-IMPL at the call, on every verb.  It used to be accepted, printing
-- `suptisub` twice: the second line ran `Bool` through the `Show2 Int` dictionary.
interface Show2 t where
  show2 : t -> String
impl Show2 Int where
  show2 _ = "i"
interface Sup a where
  sup : a -> String
interface Sub a requires Sup a where
  sub : a -> String
data Box a = Box a
data Two a = Two a
impl Sup (Box a) where
  sup _ = "sup"
impl Sup (Box (Two a)) requires Show2 a where
  sup (Box (Two x)) = "supt" ++ show2 x
impl Sub (Box a) where
  sub _ = "sub"
useSup : Sub a => a -> String
useSup x = sup x ++ sub x
f x = useSup (Box (Two x))
main =
  println (f (1 : Int))
  println (f True)
