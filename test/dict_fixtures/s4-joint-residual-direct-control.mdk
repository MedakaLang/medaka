-- #1560 control.  The same `Conv Int Bool` dictionary is required directly,
-- without conditional-impl residual reduction.  The exact answer is `start`
-- followed by `int-bool`; failure here is general multi-parameter dispatch.
main =
  let _ = println "start"
  println (g 5 True)

data Wrap a = Wrap a

interface Conv a b where
  conv : a -> b -> String

impl Conv Int Bool where
  conv _ _ = "int-bool"

impl Conv (Wrap a) b requires Conv a b where
  conv (Wrap x) y = "w:\{conv x y}"

g x y = conv x y
