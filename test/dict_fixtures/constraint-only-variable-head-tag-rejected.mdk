-- §3 + §5: `f`'s signature constraint `K x y` names `y`, which its type
-- omits, so the call `f (Box 2)` poses `K (Box Int) ?y`.  No row is selected
-- for the undetermined vector: the call's dictionary route is the head tag
-- `Box` and `k x` in `f`'s body is `RNone`, so no instance is committed.
-- Hand-derived (Val's ruling on #4121): REJECT, T-UNROUTED-DISPATCH 17:6, 19:16.
interface K a b where
  k : a -> String
  mk : b -> a

data Box a = Box a

impl K (Box Int) Bool where
  k _ = "BOX"
  mk _ = Box 2

f : K x y => x -> String
f x = k x

main = println (f (Box (2 : Int)))
