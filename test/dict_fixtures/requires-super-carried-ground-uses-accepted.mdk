-- R-SUPER-CARRY control: ground uses, each selecting its own `Sup` instance, whose context
-- `Show2 Int` holds: `supsub` then `suptisub`, on every engine.
interface Show2 t where
  show2 : t -> String
impl Show2 Int where
  show2 _ = "i"
interface Sup a where
  sup : a -> String
interface Sub a requires Sup a where
  sub : a -> String
data Box a = Box a
data Two a = Two a
impl Sup (Box a) where
  sup _ = "sup"
impl Sup (Box (Two a)) requires Show2 a where
  sup (Box (Two x)) = "supt" ++ show2 x
impl Sub (Box a) where
  sub _ = "sub"
useSup : Sub a => a -> String
useSup x = sup x ++ sub x
main =
  println (useSup (Box (1 : Int)))
  println (useSup (Box (Two (1 : Int))))
