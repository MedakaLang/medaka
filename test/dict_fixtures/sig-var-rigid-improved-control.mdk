-- §3's own example: improvement commits the empty list's element to the
-- signature's `a`, and the goal `Pick (List a) (List a) (List a)` matches
-- `impl Pick a a a` with `a` rigid.
interface Pick a b c where
  pick : a -> b -> c

impl Pick a a a where
  pick _ y = y

g : a -> List a
g y = pick [y] []

main = println (debug (g (5 : Int)))
