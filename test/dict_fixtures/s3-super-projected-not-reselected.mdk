-- DICT-SEMANTICS §3 `super` (#2095): #1127's shape (a THIRD overlapping
-- instance makes a re-selection value-observable), with different names so
-- this is not a byte-for-byte duplicate of `s6-1-4-supers-per-construction-
-- goal.mdk`, which pins the same shape for §6.1.4/C2. `Boxed`'s `requires Sz a`
-- super slot is filled at `useSz`'s construction goal by entailing `Sz (Box
-- Int)` against THREE overlapping `Sz` instances (`Int`, `Box a requires Sz
-- a`, `Box Int`) -- the min-⊑ winner is the ground `Box Int` instance, `77`.
-- `sizeOf (Box 1 : Box Int)` on the next line is an INDEPENDENT top-level
-- goal at the same type, entailed separately. §2.1/§2.3 (this milestone) name
-- this today's mechanism: two SEPARATE selections that happen to land on the
-- same answer because both independently pick the ⊑-minimum, not one
-- projection that GUARANTEES they agree. Pinned to today's value, `77\n77`;
-- S2 replaces the super slot's selection with a projection from `useSz`'s own
-- construction evidence, which is the observation this row exists for.
data Box a = Box a

interface Sz a where
  sizeOf : a -> Int

interface Boxed a requires Sz a where
  label : a -> Int

impl Sz Int where
  sizeOf _ = 1

impl Sz (Box a) requires Sz a where
  sizeOf _ = 20

impl Sz (Box Int) where
  sizeOf _ = 77

impl Boxed (Box a) requires Sz a where
  label _ = 5

useSz : Boxed a => a -> Int
useSz x = sizeOf x

main =
  println (useSz (Box 1 : Box Int))
  println (sizeOf (Box 1 : Box Int))
