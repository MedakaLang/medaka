-- #4117: `jmap`'s declared result `f (e | e2) b` joins two rows in an
-- `Effect` slot.  Both the recursive `jmap g (t u)` inside `impl JMap Later`
-- and the call in `main` select on the vector `[Later]`, which the row join
-- does not hide, and route to the instance key, not to the head `Later`.
-- Hand-derived from DICT-SEMANTICS §3 (R-ARITY1): the one unifying instance is
-- `impl JMap Later`, so both occurrences route to it and the program prints
-- `42` on every verb.
data Later (e : Effect) a = Now a | Wait (Unit -> <e> Later e a)
interface JMap (f : Effect -> Type -> Type) where
  jmap : (a -> <e2> b) -> f e a -> f (e | e2) b
impl JMap Later where
  jmap g (Now a) = Wait (u => Now (g a))
  jmap g (Wait t) = Wait (u => jmap g (t u))
force : Later <> Int -> Int
force (Now n) = n
force (Wait t) = force (t ())
main = println (force (jmap (x => x + 1) (Wait (u => Now 41))))
