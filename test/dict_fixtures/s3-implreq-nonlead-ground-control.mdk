-- #1981 control.  Removing the parametric `requires` route leaves two ordinary
-- ground selections.  It must produce the same hand-derived 333 + 111 = 444,
-- distinguishing a carrier regression from a general Ix dispatch failure.
data W a b c = W a b c

interface Ix a b c where
  ix : a -> b -> c -> Int

impl Ix Int Char Bool where
  ix _ _ _ = 333

impl Ix Int Bool Char where
  ix _ _ _ = 111

interface Sz s where
  sz : s -> Int

impl Sz (W Int Char Bool) where
  sz (W n x y) = ix n x y + ix n y x

main = println (sz (W 5 'z' True))
