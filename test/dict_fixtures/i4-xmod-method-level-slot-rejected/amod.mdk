-- An UNRELATED interface sharing only the spelling `Sizer`.  Its method is
-- `weight`, disjoint from `zmod.Sizer`'s `bulk`.  It owns the graph's only
-- `impl Sizer Int` — an impl of THIS class, not of `zmod`'s.
export interface Sizer a where
  weight : a -> Int

export impl Sizer Int where
  weight n = n * 100
