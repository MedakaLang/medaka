-- DICT-SEMANTICS §6.1.3 (R-STABLE): a use through the generalized binding selects
-- the instance a direct use at the same type selects.
--
-- `#1579`'s shape with `impl Show2 Bool` added, so reducing `Tag (Wrap a)` to
-- `Show2 a` at `nest`'s definition would also have compiled.  The more specific
-- `impl Tag (Wrap Bool)` still unifies with the goal and is not ⊒ the matching
-- head, so the goal stays in the scheme as written and each call selects at its
-- own instantiation.
--
-- SPEC ANSWER (hand-derived): `nest True` selects `impl Tag (Wrap Bool)`
-- (`specificW`), the same instance the direct `tagOf (Wrap True)` selects;
-- `nest (1 : Int)` selects the general instance with `impl Show2 Int`
-- (`genericWi`).  Before R-STABLE `nest True` printed `genericWb` while the
-- direct call printed `specificW`.
data Wrap a = Wrap a

interface Tag t where
  tagOf : t -> String

interface Show2 t where
  show2 : t -> String

impl Show2 Int where
  show2 _ = "i"

impl Show2 Bool where
  show2 _ = "b"

impl Tag (Wrap a) requires Show2 a where
  tagOf (Wrap x) = "genericW\{show2 x}"

impl Tag (Wrap Bool) where
  tagOf _ = "specificW"

nest x = tagOf (Wrap x)

main =
  println (nest True)
  println (nest (1 : Int))
  println (tagOf (Wrap True))
