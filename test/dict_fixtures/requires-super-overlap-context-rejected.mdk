-- §6.1.4 pt 4 beside R-SUPER-DECL: `impl Sub (Box a)` passes the declaration rule, since
-- at its head `Sup (Box a)` selects `impl Sup (Box a)`, which requires nothing.  The
-- ground goal `Sub (Box (Two Bool))` selects the more specific
-- `impl Sup (Box (Two a)) requires Show2 a` for its super dictionary, whose context
-- `Show2 Bool` no instance gives: T-NO-IMPL at the call (36:16), on every verb.  This is
-- the ground face of the super carry (`superGoalsEntered`); without it the program is
-- accepted and prints `suptisub` through the `Show2 Int` dictionary.
interface Show2 t where
  show2 : t -> String

impl Show2 Int where
  show2 _ = "i"

interface Sup a where
  sup : a -> String

interface Sub a requires Sup a where
  sub : a -> String

data Box a = Box a

data Two a = Two a

impl Sup (Box a) where
  sup _ = "sup"

impl Sup (Box (Two a)) requires Show2 a where
  sup (Box (Two x)) = "supt" ++ show2 x

impl Sub (Box a) where
  sub _ = "sub"

useSup : Sub a => a -> String
useSup x = sup x ++ sub x

main = println (useSup (Box (Two True)))
