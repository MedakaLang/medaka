-- `impl Get (Box a) a` against `Get (Box (Option t)) (List Int)`: the two
-- bindings of `a` differ in their constructor while both still hold a free
-- variable, so no instantiation makes them equal and the goal is refused.
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

viaG b = get b

total : List Int -> Int
total xs = fold (acc x => acc + x) 0 xs

main = println (total (viaG (Box None)))
