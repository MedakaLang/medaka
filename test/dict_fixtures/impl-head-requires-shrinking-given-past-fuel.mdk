-- §3 W2 on the impl-body path, the twin of requires-shrinking-given-past-fuel.mdk
-- (#3802): the body of `impl Tag (Q a) requires Tag a` poses `Tag (W^40 a)`, which
-- shrinks one `W` per step to the impl's given `Tag a`.  No step spends fuel, so the
-- impl is accepted on every verb.  `tag (Q 1)` adds one per `W` to 1, so it prints 41.
interface Tag a where
  tag : a -> Int

impl Tag Int where
  tag n = n

data W a = W a

impl Tag (W a) requires Tag a where
  tag (W x) = tag x + 1

data Q a = Q a

impl Tag (Q a) requires Tag a where
  tag (Q x) = tag (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (W (x)))))))))))))))))))))))))))))))))))))))))

main = println (tag (Q (1 : Int)))
