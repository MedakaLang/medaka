-- The entry. It puts `amod` and `zmod` in ONE module graph and uses one method from
-- each, so neither import can be dead-code-argued away. 1*100 + (2+7) = 109 -- a value
-- only reachable when BOTH impls are selected, one per class.
import amod.{foo}
import zmod.{bar}

main = println (foo 1 + bar 2)
