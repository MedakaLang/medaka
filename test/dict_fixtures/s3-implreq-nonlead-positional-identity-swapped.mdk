-- #1981 order invariant.  This is the sibling program with only the two
-- `requires` predicates exchanged.  Predicate identity, not declaration order,
-- must still route 333 to `ix n x y` and 111 to `ix n y x`: exactly 444.
data W a b c = W a b c

interface Ix a b c where
  ix : a -> b -> c -> Int

impl Ix Int Char Bool where
  ix _ _ _ = 333

impl Ix Int Bool Char where
  ix _ _ _ = 111

interface Sz s where
  sz : s -> Int

impl Sz (W a b c) requires Ix a c b, Ix a b c where
  sz (W n x y) = ix n x y + ix n y x

main = println (sz (W 5 'z' True))
