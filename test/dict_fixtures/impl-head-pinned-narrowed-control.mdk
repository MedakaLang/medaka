-- Control: the head narrowed to what the body supports, `impl Sizer (P String d)`,
-- called at a matching receiver. Hand-derived: "a" is not "zzz", so 5.
interface Sizer x where
  size : x -> Int

data P c d = P c d

impl Sizer (P String d) where
  size (P tag n) =
    let t = tag : String
    if t == "zzz" then 0 else 5

main = println (size (P "a" 2))
