-- The #2981 must-fail control, retained after the pin drains: both interface
-- parameters occur in the method type, so the ordinary complete-vector path applies.
interface Hidden a b where
  hidden : b -> a

impl Hidden Int Char where
  hidden _ = 22

impl Hidden Int Bool where
  hidden _ = 12

useHidden : Hidden a b => b -> a
useHidden witness = hidden witness

main = println (useHidden True : Int)
