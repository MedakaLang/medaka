-- #3809 through a local `let` in an impl body, the keys unannotated (#3820).
-- Hand-derived answer: 3.75, then 7 (`k` defaults, `e = a`).  The key literals
-- are in no type of the `let`, which hands them to the method body; the body
-- grounds them to `Int`, withholds `e` (`a` is held), and its second
-- determination fixes `e = a`.  Before #3820 no boundary defaulted the
-- keys, and D3 clause 3's verdict rejected `Index (Array a) k e` as ambiguous.
impl Index (Array a) Float a where
  index xs _ = xs[1]

interface Report t where
  report : t -> String

impl Report (Array a) requires Num a, Debug a where
  report v =
    let s = v[0] + v[1]
    debug s

main =
  println (report [|1.5, 2.25|])
  println (report [|3, 4|])
