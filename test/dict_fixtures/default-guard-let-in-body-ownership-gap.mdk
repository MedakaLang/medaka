-- #3809 through a local `let` in an impl body, the keys unannotated.
-- Hand-derived answer: 3.75, then 7 (`k` defaults, `e = a`).  The key literals
-- are in no type of the `let` and deeper than the body, so no boundary defaults
-- them (an ownership gap, filed separately); with `k` open, `Index (Array a) k e`
-- has two candidates and D3 clause 3's verdict rejects it as ambiguous.  Pinned:
-- REJECT on all three verbs, T-AMBIGUOUS-INSTANCE, until the gap is fixed.
impl Index (Array a) Float a where
  index xs _ = xs[1]

interface Report t where
  report : t -> String

impl Report (Array a) requires Num a, Debug a where
  report v =
    let s = v[0] + v[1]
    debug s

main =
  println (report [|1.5, 2.25|])
  println (report [|3, 4|])
