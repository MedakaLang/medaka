-- §3 R-SUPER-DECL: a dictionary for `Sub (Box a)` carries one for `Sup (Box a)`, built
-- by `impl Sup (Box a) requires Show2 a`, so `impl Sub (Box a)` must entail `Show2 a`
-- and it declares no `requires`: T-IMPL-MISSING-REQUIRES at the impl (line 23), on
-- every verb.  It used to be accepted: the generalizing `f` reduced `Sub (Box a)` and
-- dropped `Show2 a`, so `f True` printed `supisub` through the `Show2 Int` dictionary.
interface Show2 t where
  show2 : t -> String

impl Show2 Int where
  show2 _ = "i"

interface Sup a where
  sup : a -> String

interface Sub a requires Sup a where
  sub : a -> String

data Box a = Box a

impl Sup (Box a) requires Show2 a where
  sup (Box x) = "sup" ++ show2 x

impl Sub (Box a) where
  sub _ = "sub"

useSup : Sub a => a -> String
useSup x = sup x ++ sub x

f x = useSup (Box x)

main =
  println (f (1 : Int))
  println (f True)
