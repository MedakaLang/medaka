-- §3 + §5 (return twin): `f`'s signature constraint `K x y` names `y`, which
-- its type omits, and `x` is fixed only by the result.  The call poses
-- `K (Box Int) ?y`.  No row is selected for the undetermined vector, so the
-- call's dictionary route is the head tag `Box` and no instance is committed.
-- Hand-derived (Val's ruling on #4121): REJECT on every verb,
-- T-UNROUTED-DISPATCH at 23:23 (the call to `f`).
interface K a b where
  r : Int -> a
  mk : b -> a

data Box a = Box a

impl K (Box Int) Bool where
  r _ = Box 7
  mk _ = Box 2

unbox : Box Int -> Int
unbox (Box n) = n

f : K x y => Int -> x
f n = r n

main = println (unbox (f 1))
