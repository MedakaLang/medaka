-- Control for the #3535 rows: `back (W 3)` at `Int` poses the closed goal
-- `Conv2 Int W`, which `impl Conv2 Int W` answers.  Hand-derived: ACCEPT on all
-- three verbs, `back (W 3)` = 3 + 1 = `4`.
interface Conv a b where
  conv : a -> b
interface Conv2 a b requires Conv a b where
  back : b -> a
data W = W Int
impl Conv Int W where
  conv n = W (n * 2)
impl Conv2 Int W where
  back (W n) = n + 1
main = println (debug ((back (W 3)) : Int))
