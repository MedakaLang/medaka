-- DICT-SEMANTICS §6.1: a program's impls are compared with the prelude's.
--
-- SPEC ANSWER (hand-derived): the prelude has `impl Eq (Array a)`; the program's is
-- α-equal to it, so the pair has no unique ⊑-minimum.  REJECTED at the program's
-- impl on every verb (#3872).
impl Eq (Array a) where
  eq _ _ = True

main = println ([|1|] == [|2|])
