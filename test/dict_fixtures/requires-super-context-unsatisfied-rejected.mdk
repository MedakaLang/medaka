-- §2/§3: a dictionary for `Sub (Box Bool)` carries a `Sup (Box Bool)` dictionary,
-- and the only instance that builds it, `impl Sup (Box a) requires Show2 a`, needs
-- `Show2 Bool`, which no instance gives.  The goal at `useSup (Box True)` is
-- unsatisfiable, exactly as the direct `sup (Box True)` is: `T-NO-IMPL` (`no impl of
-- Show2 for Bool`), located at the call, on every verb.  It used to be accepted on
-- every verb and print `supisub`, running `show2` through a dictionary of the wrong
-- type.
interface Show2 t where
  show2 : t -> String

impl Show2 Int where
  show2 _ = "i"

interface Sup a where
  sup : a -> String

interface Sub a requires Sup a where
  sub : a -> String

data Box a = Box a

impl Sup (Box a) requires Show2 a where
  sup (Box x) = "sup" ++ show2 x

impl Sub (Box a) where
  sub _ = "sub"

useSup : Sub a => a -> String
useSup x = sup x ++ sub x

main = println (useSup (Box True))
