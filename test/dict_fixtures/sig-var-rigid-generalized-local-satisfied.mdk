-- Control for the generalized-local rows: the same locals used where the instance
-- answers their goal.  `h`'s use poses `Get (Box (List t)) (List Int)`, which
-- improvement fixes to `t = Int`; `p`'s poses `Pick (List Int) (List Int)
-- (List Int)`.  Each local is passed the dictionary its use solves.
-- Hand-derived: `get (Box [])` is [], and `pick` returns its second argument, [1].
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

interface Pick a b c where
  pick : a -> b -> c

impl Pick a a a where
  pick _ y = y

h : Int -> List Int
h x =
  let k u = get (Box [])
  k x

p : Int -> List Int
p y =
  let k z = pick [z] [1]
  k y

main =
  println (debug (h 3))
  println (debug (p 5))
