-- C7, L3: the hub re-exports two distinct declarations of `mth`, so the explicit import
-- binds it to both: a located ambiguity at the occurrence, whatever the receiver, types or
-- import order.
import mid.{IP, IG, mth}

data W a = MkW a

impl IG W where
  mth w = 5

main = println (mth (MkW 1))
