-- §3 W3-inst on a residual that mixes a head variable with another variable. The
-- body of `impl Mk (Wr b)` poses `Get (Box (List t)) b`, which `impl Get (Box a) a`
-- answers only if the head's `b` is `List t`, so the impl is refused at the body.
-- `mk 0 : Wr Int` would otherwise reach the body with `b` as Int.
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

data Wr b = Wr b

interface Mk x where
  mk : Int -> x

impl Mk (Wr b) where
  mk _ = Wr (get (Box []))

unwr : Wr b -> b
unwr (Wr v) = v

main = println (unwr (mk 0 : Wr Int) + 1)
