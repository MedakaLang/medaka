-- FILEREAD named-argument accept on the REAL stdlib builtin `readFile` (no
-- local extern redeclaration, no per-program `effect FileRead Prefix` decl —
-- FileRead is pre-registered as a Prefix domain in seedEffectDomains).
-- `readFile : (path : String) -> <FileRead path> …` binds its FileRead
-- authority to its argument; the literal "/etc/app/config.toml" is that
-- argument, so the body performs the Prefix pattern
-- <FileRead "/etc/app/config.toml">.  Declared bound <FileRead "/etc/app/*">
-- ADMITS "/etc/app/config.toml" ⇒ ACCEPT.
readCfg : Unit -> <FileRead "/etc/app/*"> Result String String
readCfg _ = readFile "/etc/app/config.toml"

main : <IO> Unit
main = println "fileread builtin hole-fill accept"
