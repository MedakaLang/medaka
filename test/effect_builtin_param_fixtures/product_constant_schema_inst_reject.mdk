-- A Product constant writes only some of its label's axes, so it cannot say
-- which axis is primary. Instantiating `apply` at H's constant index must not
-- read the axis the constant writes (Host) as the place a literal lands: the
-- literal is refused, not admitted as a Host pattern.
effect Web2 Product (Method : Set, Host : Prefix)

extern req2 : (u : String) -> <FFI, Web2 u> Unit

data H (p : Authority Web2) = H (String @p)

apply : H p -> String @p -> <FFI, Web2 p> Unit
apply _ s = req2 s

idH : H (Host="a.com/*") -> H (Host="a.com/*")
idH h = h

pair h2 h = (apply h2, apply (idH h))

g : H (Host="a.com/*") -> <FFI, Web2 Host="a.com/*"> Unit
g h = match pair h h
  (_, f2) => f2 "a.com/x"

main = println 1
