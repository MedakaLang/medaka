-- ENV named-argument reject on the REAL stdlib builtin `getEnv`.  Its Env
-- authority is its argument, the literal "HOME"; the declared bound {"PATH"}
-- does not contain HOME ⇒ {"HOME"} ⊄ {"PATH"} ⇒ REJECT (performs <Env {"HOME"}>).
readHome : Unit -> <Env {"PATH"}> Option String
readHome _ = getEnv "HOME"

main : <IO> Unit
main = println "should not typecheck"
