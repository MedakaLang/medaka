-- FILEWRITE named-argument reject on the REAL stdlib builtin `writeFile`.  Its
-- FileWrite authority is its first argument, the literal "/var/log/app.log";
-- the declared bound <FileWrite "/tmp/*"> does not cover "/var/log/app.log"
-- (different prefix) ⇒ REJECT
-- (performs <FileWrite "/var/log/app.log">).
writeLog : Unit -> <FileWrite "/tmp/*"> Result String Unit
writeLog _ = writeFile "/var/log/app.log" "x"

main : <IO> Unit
main = println "should not typecheck"
