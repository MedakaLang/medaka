-- FILEWRITE named-argument accept on the REAL stdlib builtin `writeFile` (no
-- local extern redeclaration, no per-program `effect FileWrite Prefix` decl —
-- FileWrite is pre-registered as a Prefix domain in seedEffectDomains).
-- `writeFile : (path : String) -> String -> <FileWrite path> …` binds its
-- FileWrite authority to its first argument; the literal "/var/log/app.log" is
-- that argument, so the body performs the Prefix pattern
-- <FileWrite "/var/log/app.log">.  Declared bound <FileWrite "/var/log/*">
-- ADMITS "/var/log/app.log" ⇒ ACCEPT.
writeLog : Unit -> <FileWrite "/var/log/*"> Result String Unit
writeLog _ = writeFile "/var/log/app.log" "x"

main : <IO> Unit
main = println "filewrite builtin hole-fill accept"
