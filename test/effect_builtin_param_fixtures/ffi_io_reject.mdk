-- #2071/#2070 (epic, Layer 1, R1): `FFI` is a registered Prefix-domain label
-- (seedEffectDomains) but is deliberately ABSENT from ioAliasLabels, so an
-- `<IO>` bound does NOT subsume an `<FFI>`-performing body.  `callLib`
-- performs <FFI "libcurl*">; `caller`'s declared bound is only `<IO>` ⇒
-- REJECT (performs <FFI "libcurl*">).
extern callLib : String -> <FFI "libcurl*"> Int

caller : Unit -> <IO> Int
caller _ = callLib "GET /"

main : <IO> Unit
main = println "should not typecheck"
