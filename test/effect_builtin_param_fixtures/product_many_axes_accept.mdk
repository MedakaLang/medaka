-- One written tuple with three Set axes of sixteen members is within the
-- cap, and is normalised as written, not split into its 4096 singletons.
effect P Product (A : Set, B : Set, C : Set, E : Set)

extern ex : Unit -> <FFI, P A={"a1"} B={"b1"} C={"c1"} E={"e"}> Unit

f : Unit -> <FFI, P A={"a1", "a2", "a3", "a4", "a5", "a6", "a7", "a8", "a9", "a10", "a11", "a12", "a13", "a14", "a15", "a16"} B={"b1", "b2", "b3", "b4", "b5", "b6", "b7", "b8", "b9", "b10", "b11", "b12", "b13", "b14", "b15", "b16"} C={"c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16"} E={"e"}> Unit
f _ = ex ()

main = println 1
