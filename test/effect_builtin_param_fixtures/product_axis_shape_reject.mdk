-- A value whose Host axis is Set-shaped (a binder-free Product qualifier),
-- joined in alpha with 16 host literals: past 16 elements alpha folds by the
-- domain join. On Host a Set and a Prefix have no join but the whole axis,
-- so the value is not within `a.com/*` and the bound refuses it.
effect Web Product (Host : Prefix, Method : Set)

extern req : (u : String) -> <FFI, Web u> Unit

extern getK : Unit -> <FFI> String @(Host={"s"} Method={"GET"})

send : Int -> String @(Host={"s"} Method={"GET"}) -> <FFI, Web Host="a.com/*"> Unit
send n k =
  let u = if n == 1 then "a.com/1" else if n == 2 then "a.com/2" else if n == 3 then "a.com/3" else if n == 4 then "a.com/4" else if n == 5 then "a.com/5" else if n == 6 then "a.com/6" else if n == 7 then "a.com/7" else if n == 8 then "a.com/8" else if n == 9 then "a.com/9" else if n == 10 then "a.com/10" else if n == 11 then "a.com/11" else if n == 12 then "a.com/12" else if n == 13 then "a.com/13" else if n == 14 then "a.com/14" else if n == 15 then "a.com/15" else if n == 16 then "a.com/16" else k
  req u

main = send 0 (getK ())
