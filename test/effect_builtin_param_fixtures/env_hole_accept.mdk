-- ENV named-argument accept on the REAL stdlib builtin `getEnv` (no local
-- extern redeclaration, no per-program `effect Env Set` decl — Env is
-- pre-registered as a Set domain in seedEffectDomains).  `getEnv : (name :
-- String) -> <Env name> …` binds its Env authority to its argument; the literal
-- "HOME" is that argument, so the body performs <Env {"HOME"}>.  Declared bound
-- is the SUPERSET {"HOME","PATH"} ⇒ {"HOME"} ⊆ {"HOME","PATH"} ⇒ ACCEPT.
readHome : Unit -> <Env {"HOME", "PATH"}> Option String
readHome _ = getEnv "HOME"

main : <IO> Unit
main = println "env builtin hole-fill accept"
