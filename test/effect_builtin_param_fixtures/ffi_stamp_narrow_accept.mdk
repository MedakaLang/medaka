-- N2 (F1 fix packet): pin the R2 stamp-acceptance shape from slice 3's Checks
-- 4/5 (S-extern-stamp report N2) — a NARROWER user-declared extern with its
-- own Prefix-domain param.  `<Net "idp.example.com/*">` is stamped
-- `<FFI, Net "idp.example.com/*">` (the stamp joins the existing param atom,
-- it does not replace it).  A caller bounded at the SAME joined row admits
-- it ⇒ ACCEPT.
effect Net Prefix

extern ffiFetch : String -> <Net "idp.example.com/*"> String

wrapFetch : String -> <FFI, Net "idp.example.com/*"> String
wrapFetch x = ffiFetch x

main : <IO> Unit
main = println "ffi stamp narrow accept"
