-- Ten of the eleven labels: a performed `<IO>` still needs `Net`, and the
-- refusal names it.
ioSay : String -> <IO> Unit
ioSay s = println s

say : String ->
  <Clock, Env, Exec, FileRead, FileWrite, Rand, Signal, Stderr, Stdin, Stdout> Unit
say s = ioSay s

main : <IO> Unit
main = say "io join reject"
