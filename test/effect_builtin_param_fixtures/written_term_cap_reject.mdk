-- A qualifier or an index that writes more than sixteen elements of one
-- label is refused, as a row is: folding them into one wider pattern would
-- admit what none of them does.
readAny : String @("cfg/a/*" | "cfg/b/*" | "cfg/c/*" | "cfg/d/*" | "cfg/e/*" | "cfg/f/*" | "cfg/g/*" | "cfg/h/*" | "cfg/i/*" | "cfg/j/*" | "cfg/k/*" | "cfg/l/*" | "cfg/m/*" | "cfg/n/*" | "cfg/o/*" | "cfg/p/*" | "cfg/q/*") -> <FileRead "cfg/*"> Result String String
readAny p = readFile p

openOne : Unit -> <Net> Result String (Socket ("h/a/*" | "h/b/*" | "h/c/*" | "h/d/*" | "h/e/*" | "h/f/*" | "h/g/*" | "h/h/*" | "h/i/*" | "h/j/*" | "h/k/*" | "h/l/*" | "h/m/*" | "h/n/*" | "h/o/*" | "h/p/*" | "h/q/*"))
openOne _ = netTcpConnect "h/zzz/x" 80

main = println 1
