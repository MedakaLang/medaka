-- The other half of ffi_libname_bare_accept.mdk: a WILDCARD library name is
-- a pattern, and the bare name is an exact element within it.  The extern
-- names the exact library and the `caller` is bounded at the pattern, so
-- this cell pins the one direction the Prefix order admits: an exact element
-- lies within the pattern that starts with it, never the reverse.
extern callLib : String -> <FFI "libcurl"> Int

caller : Unit -> <FFI "libcurl*"> Int
caller _ = callLib "GET /"

main : <IO> Unit
main = println "ffi wildcard library name accept"
