-- A string qualifier on a value that reaches a Product label lifts into its
-- primary axis, as a literal in an atom does; so does a joined one.
effect Web Product (Host : Prefix, Method : Set)

extern req : (u : String) -> <FFI, Web u> Unit

sendW : Bool -> String @(Host="a.com/x*") -> <FFI, Web Host="a.com/*"> Unit
sendW c k =
  let u = if c then k else "a.com/y"
  req u

sendW1 : String @(Host="a.com/x*") -> <FFI, Web Host="a.com/*"> Unit
sendW1 k = req k

sendW2 : String @"a.com/x*" -> <FFI, Web "a.com/x*"> Unit
sendW2 k = req k

main = println 1
