-- #3636: a `..` after a written directory climbs back out of it. The runtime
-- confines by canonical path, so `"data/../" ++ leaf` is the working
-- directory's pattern, not one under `data/`, and the bound refuses it.
said : Result String a -> String
said (Ok _) = "Ok"
said (Err e) = "Err \{e}"

store : String -> <FileWrite "data/*"> Result String Unit
store leaf = writeFile ("data/../" ++ leaf) "x"

main = println (said (store "escaped.txt"))
