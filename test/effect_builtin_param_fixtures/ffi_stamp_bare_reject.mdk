-- F1 (epic #2070): the CALLER half.  The extern names `FFI` in its own row
-- because the compiler no longer stamps one in (ffi_stamp_missing_reject.mdk
-- pins that rejection); this cell is about what the row then costs a caller.
-- Composed with R1 (`FFI` excluded from `ioAliasLabels`), a caller declared at
-- a bare `<>` does not subsume the extern's `<FFI>` ⇒ REJECT.  Its counterpart
-- ffi_stamp_bare_accept.mdk flips only the caller's bound.
extern ffiCall : Int -> <FFI> Int

pureWrap : Int -> <> Int
pureWrap x = ffiCall x

main : <IO> Unit
main = println "unreached"
