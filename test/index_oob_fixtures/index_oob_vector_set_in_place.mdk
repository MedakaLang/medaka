-- #3187: `Vector.setInPlace` OOB used to abort with a bare `panic` — coded
-- E-PANIC, no index, and a different message shape than its own `IndexMut`
-- sibling (`v[i] := v`).  It now routes through `indexErrorAt i`, same as
-- `setIndex`.
import vector.{Vector, fromList, setInPlace}

main =
  let m = fromList [5, 6, 7]
  let _ = setInPlace 4 1 m
  println "unreachable"
