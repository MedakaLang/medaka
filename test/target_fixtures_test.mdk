{- | Gate for the target check: `medaka check` and `medaka run` refuse an entry
   whose invocation summary the selected target profile does not grant
   (`T-TARGET-CAPABILITY`), and admit one it does; `medaka build`'s emitter
   child refuses it before lowering.  Each case spawns the native binary (or
   the emitter child) over a program in test/target_fixtures/ and compares its
   exit code, stdout and stderr with a committed golden, so the refusal text,
   its location and its via-chain are pinned as well as the verdict.

   Runs under `medaka test --native`: it spawns subprocesses and reads
   goldens, neither of which the interpreter binds. -}

import test_process.{medakaBin, medakaRoot, underRoot, boundedVerb}
import test.{Expectation, expectEach, expectGolden, fail}
import io.{getEnvOr}
import string.{replaceAll}

fixtureDir : String
fixtureDir = underRoot "test/target_fixtures"

-- The transcript a golden holds: the exit code, then each stream, with the
-- fixture directory spelled `<fixtures>` so the golden does not name a tree.
transcript : Int -> String -> String -> <IO> String
transcript code out err =
  replaceAll
    fixtureDir
    "<fixtures>"
    "exit=\{intToString code}\n--- stdout\n\{out}--- stderr\n\{err}"

-- One case: `medaka <verb> <flags> <fixture>`, graded against
-- `<stem>.golden`.
targetCase : String ->
  String ->
  List String ->
  String ->
  <Exec, IO, FileRead> (String, Expectation)
targetCase stem verb flags fixture =
  (stem, runCase stem ([verb] ++ flags ++ ["\{fixtureDir}/\{fixture}"]))

runCase : String -> List String -> <Exec, IO, FileRead> Expectation
runCase stem argv = spawnCase stem medakaBin argv

spawnCase : String -> String -> List String -> <Exec, IO, FileRead> Expectation
spawnCase stem cmd argv = match boundedVerb cmd argv
  Err e => fail "\{stem}: could not spawn: \{e}"
  Ok (code, out, err) =>
    expectGolden "\{fixtureDir}/\{stem}.golden" (transcript code out err)

-- One case run from inside `dir` (under the fixtures), naming the entry by its
-- bare file name, as a user in that directory would.
inDirCase : String ->
  String ->
  String ->
  String ->
  <Exec, IO, FileRead> (String, Expectation)
inDirCase stem verb dir entry = (
  stem,
  spawnCase stem "sh" [
    "-c",
    "cd \"$1\" && exec \"$2\" \"$3\" \"$4\"",
    "sh",
    "\{fixtureDir}/\{dir}",
    medakaBin,
    verb,
    entry,
  ],
)

-- One case of the emitter child `medaka build` spawns, started as `build`
-- starts it: the selected profile in the environment, then the runtime, the
-- prelude, the entry and the search roots.  The check sits in the child's
-- shared seam, so the native emitter answers for both backends.
emitterCase : String ->
  String ->
  String ->
  <Exec, IO, FileRead> (String, Expectation)
emitterCase stem profile fixture =
  let emitter = getEnvOr "MEDAKA_EMITTER" "\{medakaRoot}/medaka_emitter"
  let stdlib = underRoot "stdlib"
  (
    stem,
    spawnCase stem "env" [
      "MEDAKA_TARGET_PROFILE=\{profile}",
      emitter,
      "\{stdlib}/runtime.mdk",
      "\{stdlib}/core.mdk",
      "\{fixtureDir}/\{fixture}",
      fixtureDir,
      stdlib,
    ],
  )

test "target_fixtures: one admitted and one refused program per profile" = expectEach
  [
    targetCase
      "native_accepts_net"
      "check"
      ["--target", "native"]
      "net_reached.mdk",
    targetCase
      "native_refuses_no_main"
      "check"
      ["--target", "native"]
      "no_main.mdk",
    targetCase
      "evalrun_refuses_net"
      "check"
      ["--target", "eval/run"]
      "net_reached.mdk",
    targetCase
      "evalrun_accepts_builtin_unreached"
      "check"
      ["--target", "eval/run"]
      "builtin_unreached.mdk",
    targetCase
      "evalrun_refuses_ffi"
      "check"
      ["--target", "eval/run"]
      "ffi_entry.mdk",
    targetCase
      "node_accepts_env"
      "check"
      ["--target", "wasmgc/node"]
      "env_stdout.mdk",
    targetCase
      "node_refuses_net"
      "check"
      ["--target", "wasm"]
      "net_reached.mdk",
    targetCase
      "browser_accepts_file_read"
      "check"
      ["--target", "wasmgc/browser-worker"]
      "file_read.mdk",
    targetCase
      "browser_refuses_env"
      "check"
      ["--target", "wasmgc/browser-worker"]
      "env_stdout.mdk",
    targetCase
      "edge_accepts_clock"
      "check"
      ["--target", "wasmgc/edge"]
      "clock_stdout.mdk",
    targetCase
      "edge_refuses_file_read"
      "check"
      ["--target", "wasmgc/edge"]
      "file_read.mdk",
  ]

test "target_fixtures: the IO join, FFI and user labels" = expectEach [
  targetCase
    "node_accepts_io"
    "check"
    ["--target", "wasmgc/node"]
    "io_declared.mdk",
  targetCase "node_refuses_io_exec" "check" ["--target", "wasm"] "io_exec.mdk",
  targetCase
    "native_accepts_io_exec"
    "check"
    ["--target", "native"]
    "io_exec.mdk",
  targetCase
    "native_accepts_io"
    "check"
    ["--target", "native"]
    "io_declared.mdk",
  targetCase "run_accepts_io" "run" [] "io_declared.mdk",
  targetCase
    "native_accepts_ffi"
    "check"
    ["--target", "native"]
    "ffi_entry.mdk",
  targetCase
    "browser_refuses_ffi"
    "check"
    ["--target", "wasmgc/browser-worker"]
    "ffi_entry.mdk",
  targetCase "run_refuses_ffi" "run" [] "ffi_entry.mdk",
  targetCase "run_json_refuses_ffi" "run" ["--json"] "ffi_entry.mdk",
  targetCase
    "native_accepts_net_param"
    "check"
    ["--target", "native"]
    "net_param.mdk",
  targetCase
    "edge_refuses_net_socket"
    "check"
    ["--target", "wasmgc/edge"]
    "net_param.mdk",
  targetCase
    "edge_accepts_user_label"
    "check"
    ["--target", "wasmgc/edge"]
    "user_label.mdk",
  targetCase "run_accepts_user_label" "run" [] "user_label.mdk",
  targetCase
    "edge_refuses_ffi_not_user_net"
    "check"
    ["--target", "wasmgc/edge"]
    "user_spelled_net.mdk",
  targetCase
    "native_accepts_user_net"
    "check"
    ["--target", "native"]
    "user_spelled_net.mdk",
]

-- `fetchText` is a built-in under the `Net` label: the edge grants `Net` and
-- serves it, so it admits the program; native and eval/run grant `Net` too but
-- provide no `fetchText`, so the built-in wall refuses it at check and run.
test "target_fixtures: fetchText rides the edge's Net grant" = expectEach [
  targetCase
    "edge_accepts_fetch"
    "check"
    ["--target", "wasmgc/edge"]
    "fetch_reached.mdk",
  targetCase
    "native_refuses_fetch"
    "check"
    ["--target", "native"]
    "fetch_reached.mdk",
  targetCase "run_refuses_fetch" "run" [] "fetch_reached.mdk",
  targetCase "run_refuses_exec_helper" "run" [] "exec_helper_unreached.mdk",
]

test "target_fixtures: build checks in its emitter child, and an empty IO join refuses IO" = expectEach
  [
    emitterCase "seam_refuses_net" "wasmgc/node" "net_reached.mdk",
    targetCase
      "wasi_refuses_io_extern"
      "check"
      ["--allow-internal", "--target", "wasmgc/wasi-p2"]
      "io_extern.mdk",
  ]

test "target_fixtures: entries, manifests and the JSON envelope" = expectEach [
  targetCase
    "node_json_refuses_net"
    "check"
    ["--json", "--target", "wasm"]
    "net_reached.mdk",
  targetCase "plain_accepts_no_main" "check" [] "no_main.mdk",
  targetCase
    "native_refuses_imported_main"
    "check"
    ["--target", "native"]
    "imported_main/entry.mdk",
  targetCase "manifest_refuses_net" "check" [] "project_target/main.mdk",
  targetCase
    "flag_overrides_manifest"
    "check"
    ["--target", "native"]
    "project_target/main.mdk",
  targetCase
    "manifest_json_refuses_net"
    "check"
    ["--json"]
    "project_target/main.mdk",
  targetCase "run_manifest_refuses_net" "run" [] "project_target/main.mdk",
  targetCase "manifest_refuses_no_entry" "check" [] "project_no_entry/lib.mdk",
]

test "target_fixtures: a project's target is found from any directory and read or refused" = expectEach
  [
    inDirCase "relative_entry_subdir" "check" "project_subdir/src" "main.mdk",
    inDirCase "relative_entry_subdir_run" "run" "project_subdir/src" "main.mdk",
    targetCase
      "relative_entry_subdir_root"
      "check"
      []
      "project_subdir/src/main.mdk",
    targetCase "bad_manifest_target" "check" [] "bad_manifest_target/main.mdk",
    targetCase
      "bad_manifest_target_build"
      "build"
      ["-o", "/dev/null"]
      "bad_manifest_target/main.mdk",
    targetCase "profile_not_string" "check" [] "profile_not_string/main.mdk",
    targetCase "profile_not_string_run" "run" [] "profile_not_string/main.mdk",
  ]

-- `T-TARGET-NO-BINDING`: an extern the program reaches, with no binding for
-- the host the profile calls foreign code through, is refused at its
-- declaration, whether it is called, only named as a value, or declared in an
-- imported module.  Under `run` the binding refusal is the verdict, and the
-- entry's capability refusal is not reported beside it (`run_refuses_ffi`).
test "target_fixtures: a reached extern needs a binding for the target's host" = expectEach
  [
    targetCase
      "node_refuses_ffi_c_only"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_entry.mdk",
    targetCase
      "native_refuses_ffi_js_only"
      "check"
      ["--target", "native"]
      "ffi_js_only.mdk",
    targetCase "run_refuses_ffi_value_only" "run" [] "ffi_value_only.mdk",
    targetCase
      "native_accepts_ffi_dual"
      "check"
      ["--target", "native"]
      "ffi_dual.mdk",
    targetCase
      "node_accepts_ffi_dual"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_dual.mdk",
    targetCase
      "native_accepts_ffi_js_unreached"
      "check"
      ["--target", "native"]
      "ffi_js_unreached.mdk",
    targetCase
      "wasm_refuses_ffi_imported"
      "check"
      ["--target", "wasm"]
      "ffi_imported/main.mdk",
    targetCase
      "wasm_refuses_ffi_imported_qualified"
      "check"
      ["--target", "wasm"]
      "ffi_imported/qualified.mdk",
    targetCase
      "wasm_json_refuses_ffi_imported"
      "check"
      ["--json", "--target", "wasm"]
      "ffi_imported/main.mdk",
    targetCase
      "wasm_refuses_ffi_member_alias"
      "check"
      ["--target", "wasm"]
      "ffi_imported/member_alias.mdk",
    targetCase
      "native_refuses_ffi_member_alias_js"
      "check"
      ["--target", "native"]
      "ffi_imported/member_alias_js.mdk",
    targetCase
      "run_refuses_ffi_member_alias_value"
      "run"
      []
      "ffi_imported/member_alias_value.mdk",
    targetCase
      "wasm_refuses_ffi_reexport_alias"
      "check"
      ["--target", "wasm"]
      "ffi_imported/reexport_alias.mdk",
    targetCase
      "wasm_refuses_ffi_wild"
      "check"
      ["--target", "wasm"]
      "ffi_imported/wild.mdk",
    targetCase
      "native_accepts_ffi_shadow_param"
      "check"
      ["--target", "native"]
      "ffi_shadow_param.mdk",
    targetCase
      "node_accepts_ffi_shadow_local"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_shadow_local.mdk",
    targetCase
      "node_accepts_ffi_same_name"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_same_name/main.mdk",
    targetCase
      "node_refuses_ffi_impl"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_impl.mdk",
    targetCase
      "node_refuses_ffi_default"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_default.mdk",
    targetCase
      "node_refuses_ffi_letgroup"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_letgroup.mdk",
    targetCase
      "node_refuses_ffi_two"
      "check"
      ["--target", "wasmgc/node"]
      "ffi_two.mdk",
    targetCase
      "run_accepts_catalog_redecl"
      "run"
      ["--allow-internal"]
      "ffi_catalog_redecl.mdk",
    targetCase
      "node_accepts_catalog_redecl"
      "check"
      ["--allow-internal", "--target", "wasmgc/node"]
      "ffi_catalog_redecl.mdk",
    targetCase
      "browser_accepts_ffi_dual"
      "check"
      ["--target", "wasmgc/browser-worker"]
      "ffi_dual.mdk",
    targetCase
      "edge_accepts_ffi_dual"
      "check"
      ["--target", "wasmgc/edge"]
      "ffi_dual.mdk",
    targetCase
      "run_node_refuses_ffi_js_only"
      "run"
      ["--target", "wasmgc/node"]
      "ffi_js_only.mdk",
    emitterCase "seam_refuses_ffi_c_only" "wasmgc/node" "ffi_entry.mdk",
    targetCase
      "wall_saturated"
      "check"
      ["--target", "wasm"]
      "ffi_wall_saturated.mdk",
    targetCase
      "wall_value_position_hof"
      "check"
      ["--target", "wasm"]
      "ffi_wall_hof.mdk",
    targetCase
      "wall_bare_toplevel_reference"
      "check"
      ["--target", "wasm"]
      "ffi_wall_bare.mdk",
  ]

test "target_fixtures: a module label spelled FFI does not label a foreign call" = expectEach
  [
    targetCase
      "user_effect_ffi"
      "check"
      ["--target", "wasmgc/edge"]
      "user_effect_ffi.mdk",
    targetCase
      "user_effect_ffi_policy"
      "check-policy"
      ["--allow", "Stdout", "--fn", "main"]
      "user_effect_ffi.mdk",
    targetCase
      "user_effect_ffi_cross"
      "check"
      ["--target", "wasmgc/edge"]
      "user_effect_ffi_cross/main.mdk",
  ]

test "target_fixtures: the program judged is the one that runs" = expectEach [
  targetCase
    "autoprint_wasi"
    "check"
    ["--target", "wasmgc/wasi-p2"]
    "autoprint_wasi.mdk",
  targetCase
    "autoprint_wasi_run"
    "run"
    ["--target", "wasmgc/wasi-p2"]
    "autoprint_wasi.mdk",
  emitterCase "autoprint_wasi_seam" "wasmgc/wasi-p2" "autoprint_wasi.mdk",
  targetCase
    "extern_value_not_performed"
    "check"
    ["--target", "wasm"]
    "extern_value_not_performed.mdk",
]

-- `medaka build <fixture> --target <first> --target <second>`, built to a
-- scratch path: the transcript is the build's output when it fails, then its
-- exit code.
buildOrderCase : String ->
  String ->
  String ->
  String ->
  <Exec, IO, FileRead> (String, Expectation)
buildOrderCase stem first second fixture = (
  stem,
  spawnCase stem "sh" [
    "-c",
    "out=$(mktemp) && \"$1\" build --target \"$2\" --target \"$3\" \"$4\" -o \"$out\" >\"$out.log\" 2>&1; code=$?; if [ $code -ne 0 ]; then cat \"$out.log\"; fi; rm -f \"$out\" \"$out.log\"; echo \"build=$code\"",
    "sh",
    medakaBin,
    first,
    second,
    "\{fixtureDir}/\{fixture}",
  ],
)

test "target_fixtures: build's last --target wins" = expectEach [
  buildOrderCase "build_last_target_wins" "eval/run" "native" "net_reached.mdk",
  buildOrderCase
    "build_last_target_refused"
    "native"
    "eval/run"
    "net_reached.mdk",
]
