import test.{expectEqual}

data Box = Box Int

-- Positives the fix withholds come first: the fix removes lines, and the
-- `unfixed` positives must keep their line numbers.

-- Inside a test body, in brackets.
test "passthrough in a test" =
  expectEqual
    (Some 1)
    -- expect-next-line rule-passthrough-arm unfixed
    (match half 4
      Some n => half n
      None => None)

-- After `else`.
afterElse : Bool -> Option Int -> Option Int
afterElse b o =
  if b then
    Some 0
  else
    -- expect-next-line rule-passthrough-arm unfixed
    match o
      Some n => half n
      None => None

-- A comment on the edited passthrough line.
commentOnArm : Option Int -> Option Int
commentOnArm o =
  -- expect-next-line rule-passthrough-arm unfixed
  match o
    Some n => half n
    None => None -- stop here

-- A success pattern that is not a variable or a tuple of them.
boxed : Option Box -> Option Int
boxed o =
  -- expect-next-line rule-passthrough-arm unfixed
  match o
    Some (Box n) => half n
    None => None

-- A passthrough arm over two lines.
splitArm : Option Int -> Option Int
splitArm o =
  -- expect-next-line rule-passthrough-arm unfixed
  match o
    Some n => half n
    None =>
      None

-- As an operand.
operand : Option Int -> List (Option Int)
operand o =
  [
    -- expect-next-line rule-passthrough-arm unfixed
    match o
      Some n => half n
      None => None,
  ]

-- A bare statement before the last one would not type in the `do`.
bareStatement : Option Int -> Option Int
bareStatement o =
  -- expect-next-line rule-passthrough-arm unfixed
  match o
    Some n =>
      note n
      half n
    None => None

-- The fixes below. One level, Option, success arm first.
lookupDouble : Option Int -> Option Int
lookupDouble o =
  -- expect-next-line rule-passthrough-arm
  match o
    Some n => half n
    None => None

-- Passthrough arm first.
lookupFirst : Option Int -> Option Int
lookupFirst o =
  -- expect-next-line rule-passthrough-arm
  match o
    None => None
    Some n => half n

-- One level, Result.
parseThen : Result String Int -> Result String Int
parseThen r =
  -- expect-next-line rule-passthrough-arm
  match r
    Err e => Err e
    Ok n => halfR n

-- The match follows the `=`.
inlineHead : Option Int -> Option Int
-- expect-next-line rule-passthrough-arm
inlineHead o = match o
  Some n => half n
  None => None

-- Nested one level deeper than the top: each level is reported.
twice : Result String Int -> Result String Int
twice r =
  -- expect-next-line rule-passthrough-arm
  match r
    Ok n =>
      -- expect-next-line rule-passthrough-arm
      match halfR n
        Ok m => halfR m
        Err e => Err e
    Err e => Err e

-- A recursive use that is not a tail call is reported.
nonTail : Int -> Result String Int
nonTail n =
  -- expect-next-line rule-passthrough-arm
  match halfR n
    Ok m => bump (nonTail m)
    Err e => Err e

-- A tuple pattern and a wildcard bind as they are.
pairs : Option (Int, Int) -> Option Int
pairs o =
  -- expect-next-line rule-passthrough-arm
  match o
    Some (a, b) => half (a + b)
    None => None

wild : Option Int -> Option Int
wild o =
  -- expect-next-line rule-passthrough-arm
  match o
    Some _ => half 0
    None => None

-- The success body starts on the next line and spans several.
longBody : Result String Int -> Result String Int
longBody r =
  -- expect-next-line rule-passthrough-arm
  match r
    Ok n =>
      let k = n + 1
      halfR k
    Err e => Err e

-- The success body is a match chain that is not a passthrough.
chain : Result String Int -> Result String Int
chain r =
  -- expect-next-line rule-passthrough-arm
  match r
    Err e => Err e
    Ok n => match half n
      Some m => Ok m
      None => Err "odd"

-- The match is an arm body.
inArm : Int -> Option Int
inArm n = match n
  0 => None
  _ =>
    -- expect-next-line rule-passthrough-arm
    match half n
      Some m => half m
      None => None

-- The match is a `let` value.
inLet : Option Int -> Option Int
inLet o =
  let v =
    -- expect-next-line rule-passthrough-arm
    match o
      Some n => half n
      None => None
  v

-- A comment outside the edited lines stays.
commentOutside : Option Int -> Option Int
commentOutside o =
  -- expect-next-line rule-passthrough-arm
  match o
    -- the success arm
    Some n => half n -- halve it
    None => None

-- A directive that silences a finding silences its fix too.
suppressed : Option Int -> Option Int
suppressed o =
  -- lint-disable-next-line rule-passthrough-arm
  match o
    Some n => half n
    None => None

bump : Result String Int -> Result String Int
bump r = r

note : Int -> Unit
note _ = ()

half : Int -> Option Int
half n = if n % 2 == 0 then Some (n / 2) else None

halfR : Int -> Result String Int
halfR n = if n % 2 == 0 then Ok (n / 2) else Err "odd"

-- Both arms transform.
bothTransform : Option Int -> Option Int
bothTransform o = match o
  Some n => half n
  None => Some 0

-- The failure value is rebuilt.
wrapErr : Result String Int -> Result (List String) Int
wrapErr r = match r
  Err e => Err [e]
  Ok n => Ok n

-- The failure arm swaps the constructor.
swapCtor : Option Int -> Result String Int
swapCtor o = match o
  None => Err "none"
  Some n => Ok n

-- A same-constructor re-wrap is a map, owned by rule-match-to-map.
mapped : Option Int -> Option Int
mapped o = match o
  Some n => Some (n + 1)
  None => None

-- Three arms.
threeArms : Option Int -> Option Int
threeArms o = match o
  Some 0 => Some 0
  Some n => half n
  None => None

-- A guarded success arm.
guarded : Option Int -> Option Int
guarded o = match o
  Some n if n > 0 => half n
  _ => None

-- A self-recursive tail is not reported.
countDown : Int -> Result String Int
countDown n =
  match halfR n
    Ok m => countDown m
    Err e => Err e

-- The tail sits under an `if`.
countIf : Int -> Result String Int
countIf n =
  match halfR n
    Ok m => if m > 1 then countIf m else Ok m
    Err e => Err e

-- The tail sits under a `let`.
countLet : Int -> Result String Int
countLet n =
  match halfR n
    Ok m =>
      let k = m + 0
      countLet k
    Err e => Err e

-- The recursion is a where-local loop.
countGo : Int -> Result String Int
countGo n0 = go n0
  where
    go n = match halfR n
      Ok m => go m
      Err e => Err e
