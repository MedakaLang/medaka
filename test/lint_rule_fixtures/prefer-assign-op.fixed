-- `setRef r v` and a `:=` write bound to a wildcard `let _ =` are flagged, at the
-- declaration; a bare `:=` statement is not.
bump : Ref Int -> Unit
-- expect-next-line rule-prefer-assign-op
bump r =
  let _ = 0
  r := 1

stamp : Ref Int -> Unit
-- expect-next-line rule-prefer-assign-op
stamp r =
  r := 2
  ()

plain : Ref Int -> Unit
plain r =
  r := 3

-- A `setRef` the file rebinds is not the prelude's: the write is reported and
-- the source left alone.  The prelude's `setRef` in the same file is still
-- rewritten.
-- expect-next-line rule-prefer-assign-op unfixed
reboundWhere r = setRef r 5
  where
    setRef a b = ()

-- expect-next-line rule-prefer-assign-op
plainAfterRebound r = r := 6

-- The replacement is bracketed where its parent would regroup it.
-- expect-next-line rule-prefer-assign-op
inArgument r = id (r := 7)

-- expect-next-line rule-prefer-assign-op
inOperand r = 1 + (r := 8)

-- A comment inside the span being replaced would be lost, so the fix is only
-- suggested; a comment elsewhere in the declaration does not stand in its way.
-- expect-next-line rule-prefer-assign-op unfixed
commentInside r = setRef r {- kept -} 9

-- expect-next-line rule-prefer-assign-op
commentOutside r =
  -- explains the choice
  r := 10

-- The collapse's span is the `let _ = ` text, so a comment in it withholds it.
-- expect-next-line rule-prefer-assign-op unfixed
collapseCommentInside r =
  let _ = {- kept -} r := 11
  ()

-- A directive that silences a finding silences its fix too.
-- lint-disable-next-line rule-prefer-assign-op
suppressed r = setRef r 12
