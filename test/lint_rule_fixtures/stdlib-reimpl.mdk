-- Positive fixture for rule-stdlib-reimpl (STYLE §7a):
-- top-level function shadows a common stdlib name.
reverse : List a -> List a
-- expect-next-line rule-stdlib-reimpl
reverse [] = []
reverse (x::xs) = reverse xs ++ [x]

-- NEGATIVE fixture for rule-stdlib-reimpl's delegation exemption (#2620): a
-- thin one-line forwarding wrapper is not a reimplementation, so the rule
-- must stay silent even though `sortL`'s declared signature alpha-matches
-- `list.sort`.
import list.{sort}

export
sortL : Ord a => List a -> List a
sortL xs = sort xs

-- POSITIVE fixture for rule-stdlib-reimpl's delegation exemption (#2620): an
-- argument REORDER is not a delegation — it is the `listContains`/`elemInt`
-- flipped-twin class (#2312) — so the rule must keep firing even though the
-- body's only call is to the matched stdlib name.
import string.{startsWith}

export
startsWithFlip : String -> String -> Bool
-- expect-next-line rule-stdlib-reimpl
startsWithFlip s pre = startsWith pre s

-- POSITIVE fixture for rule-stdlib-reimpl's delegation exemption (S2-1): a
-- wildcard PARAMETER matched against a hardcoded LITERAL argument is not a
-- delegation -- both `paramNameOf _` and `argNameOf "x"` read `None` at the
-- same position, and comparing the raw `Option String` lists directly would
-- coincidentally "match" on that shared `None`. The rule must keep firing.
import string.{startsWith}

export
startsWithP : String -> String -> Bool
-- expect-next-line rule-stdlib-reimpl
startsWithP _ s = startsWith "x" s

-- 🚨 POSITIVE fixture, and the one that proves the stdlib index is DERIVED from
-- `stdlib/` rather than re-hardcoded (#2327 finding 4, contract E2).
--
-- Every OTHER positive rule-stdlib-reimpl golden in this corpus resolves to
-- `reverse` or `take` — both members of the retired 15-name curated list
-- (reverse take drop map filter flatMap concatMap foldl foldr length elem
-- intercalate intersperse zip zipWith), and both in module `list`.  So a
-- regression that silently reverted the rule to a 15-name literal would keep
-- the whole corpus green and E2 would be unfalsifiable.
--
-- `trimSpaces` closes that hole from BOTH directions: `trim` is not in the
-- retired 15, and `string` is not `list`.  The finding is only reachable by
-- reading the real `stdlib/string.mdk` export table, so this fixture goes red
-- the moment the index stops being derived.  Do not "fix" it by repointing it
-- at a `list` name.
export
trimSpaces : String -> String
-- expect-next-line rule-stdlib-reimpl
trimSpaces s = s

-- 🚨 NEGATIVE fixture for the TYPE-CONSTRUCTOR HOMONYM guard (#2327 finding 2).
--
-- `tyCanon` compares type constructors by BARE NAME — it has no resolver — so
-- this file's own `Set` canonicalises identically to stdlib's `set.Set`, and
-- `insertSet` relaxes onto the stdlib name `insert`.  Before the guard, the rule
-- fired here and told the author to "use the stdlib version" of a function whose
-- type does not even mention the same `Set`: not merely noisy but TYPE-INCORRECT
-- advice, the same bare-name-across-modules hazard the stdlib index is keyed to
-- avoid for stdlib VALUE names.
--
-- A file that declares its own `Set` is talking about its own `Set`, so the rule
-- must stay silent.  Do not "fix" this fixture by renaming the local type.
export
data Set a = Empty | Node a (Set a) (Set a)

export
insertSet : Ord a => a -> Set a -> Set a
insertSet _ s = s

-- NEGATIVE fixture: an EXACT stdlib name whose declared signature matches none
-- of that name's stdlib candidates.  `nub` is declared by list;
-- `Matrix -> Matrix` is not its signature, so a domain type's own `nub`
-- is not a reimplementation of anything and must not be flagged.
export
data Matrix = Matrix (List (List Int))

export
nub : Matrix -> Matrix
nub m = m

-- Positive fixture for rule-stdlib-reimpl under NAME RELAXATION (#2248 Miss 2).
-- `listReverse` is not itself a stdlib name, but it ENDS WITH one, and its
-- DECLARED signature is exactly `list.reverse`'s — so the rule must fire on it
-- even though the old name-exact 15-name curated list could never have seen it.
--
-- It also pins the AMBIGUITY half: `reverse` is declared by THREE stdlib modules
-- (array/list/string) with three different signatures, so the finding is only
-- reachable by matching ANY candidate rather than "the" signature of the name.
-- The message must name `list.reverse`, not the array or string one.
export
listReverse : List a -> List a
-- expect-next-line rule-stdlib-reimpl
listReverse [] = []
listReverse (x::xs) = listReverse xs ++ [x]

-- 🚨 NEGATIVE fixture, and the one that proves the SIGNATURE FILTER does real
-- work.  `initList` relaxes onto the stdlib name `init` by prefix, so the name
-- half of rule-stdlib-reimpl accepts it — but `list.init` really declares
-- `List a -> Option (List a)`, not `List a -> List a`, so the rule must stay
-- silent.
--
-- If the declared-signature filter is ever dropped, name relaxation alone fires
-- on 1,866 definitions tree-wide; THIS fixture is what goes red first.  Do not
-- "fix" it by deleting it, and do not give it a signature that happens to match.
export
initList : List a -> List a
initList [] = []
initList (x::xs) = x :: initList xs
