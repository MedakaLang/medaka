-- THE STRING CONTROL for #3186: every in-bounds String slice, including the exact
-- boundaries the guard must NOT reject.  `[0..5]` (end == codepoint count) and `[0..=4]`
-- (last index, inclusive) are LEGAL, and an empty slice is legal both in the interior
-- and at the very end.  Results go through `debug` so an empty result prints as `""`
-- rather than a blank line the shell's `$(...)` would strip off the end.
main =
  let s = "hello"
  let _ = println (debug s.[1..3])
  let _ = println (debug s.[1..=3])
  let _ = println (debug s.[0..5])
  let _ = println (debug s.[0..=4])
  let _ = println (debug s.[2..2])
  println (debug s.[5..5])
