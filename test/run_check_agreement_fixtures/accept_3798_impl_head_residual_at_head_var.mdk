-- Control for the mixed-residual row: `mk2 (Wr v) = Wr (get (Box v))` poses
-- `Get (Box b) b` at the head variable alone, which `impl Get (Box a) a` matches
-- with `b` rigid. Hand-derived: `get` unwraps 41, and 41 + 1 = 42.
data Box a = Box a

interface Get c e where
  get : c -> e

impl Get (Box a) a where
  get (Box x) = x

data Wr b = Wr b

interface Mk x where
  mk2 : x -> x

impl Mk (Wr b) where
  mk2 (Wr v) = Wr (get (Box v))

unwr : Wr b -> b
unwr (Wr v) = v

main = println (unwr (mk2 (Wr 41)) + 1)
