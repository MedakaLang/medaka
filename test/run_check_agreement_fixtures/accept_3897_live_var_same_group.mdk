-- DICT-SEMANTICS §6.2 T2: a later group can ground an earlier group's type, so a
-- goal on a variable in a non-generalized binding's type waits for quiescence
-- (§6.2 "T4 implemented").
-- The same-group shape: `z`'s `Zero ?a` waits, and `main`'s `z + 1` grounds `?a`
-- by literal defaulting to `Int`.  Hand-derived: ACCEPT, `1`.
interface Zero a where
  zero : a
impl Zero Int where
  zero = 0
impl Zero Bool where
  zero = False
z = identity zero
main = println (z + 1)
