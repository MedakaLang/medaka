-- L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error; a literal receiver changes nothing (L1).
interface Sz a where
  size : a -> String

data Box = Box Int

impl Sz Box where
  size (Box n) = "IMPL"

size : Int -> Int
size n = n + 1

main = println (size 3)
