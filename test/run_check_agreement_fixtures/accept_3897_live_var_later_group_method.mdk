-- DICT-SEMANTICS §6.2 T2: a later group can ground an earlier group's type, so a
-- goal on a variable in a non-generalized binding's type waits for quiescence
-- (§6.2 "T4 implemented").
-- The goal is posed by a method occurrence: `b`'s `zero` is `Zero ?a` on `xs`'s
-- element variable, which `main`'s `sum xs + (1 : Int)` grounds to `Int`.
-- Hand-derived: ACCEPT, `[] == [0]` is False, `(False, 1)`.
interface Zero a where
  zero : a
impl Zero Int where
  zero = 0
impl Zero Bool where
  zero = False
xs = identity []
b = xs == [zero]
main = println (debug (b, sum xs + (1 : Int)))
