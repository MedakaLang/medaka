-- L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error at the second declaration.
data Box = Box Int

interface Sz a where
  size : a -> String

impl Sz Box where
  size _ = "IMPL"

size : Num a => a -> a
size x = x + 1

main = println (size (Box 3))
