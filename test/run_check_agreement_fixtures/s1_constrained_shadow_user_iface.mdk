-- C4, L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error; the `=>` constraint on the receiver changes nothing
-- (L8).
interface Dbl a where
  dbl : a -> a

impl Dbl Int where
  dbl x = x * 2

interface Sz a where
  size : a -> String

size : Dbl a => a -> a
size x = dbl x

main = println (size 3)
