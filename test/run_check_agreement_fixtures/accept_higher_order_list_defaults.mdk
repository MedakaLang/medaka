-- `test/diff_fixtures/higher_order.mdk`'s value, held here on the typed engines:
-- List's `filter` is Filterable's inherited default, which only an elaborated
-- program carries, so the untyped eval rows over diff_fixtures no longer grade it.
double x = x * 2
isEven x = x % 2 == 0

sumList xs = fold (acc x => acc + x) 0 xs

main : <IO> Unit
main =
  println (map double [1, 2, 3, 4, 5])
  println (filter isEven [1, 2, 3, 4, 5, 6])
  println (sumList (map double [1, 2, 3]))
