-- §4.2 OD3's zero arm at a call whose callee never reads the dictionary: the call
-- `plain 14` poses `Sz ?a`, and `Sz` has no instance at all, so no type can
-- satisfy it (#3713).  Hand-derived: REJECT on all three verbs, T-NO-IMPL at the
-- call.
interface Sz a where
  szTag : a -> Int

plain : Sz a => Int -> Int
plain n = n + 1

main = println (plain 14)
