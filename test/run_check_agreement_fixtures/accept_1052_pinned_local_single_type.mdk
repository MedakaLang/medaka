-- #1052 — A DICTIONARY-FORWARDING `where` LOCAL, EVERY USE AT ONE TYPE.
--
-- `d` calls `sizeOf`, so it is dictionary-abstracted; every use here is at the same
-- type as its enclosing call, so each application forwards that call's own given.
-- The sibling `accept_866_local_dict_forward_rigid_vars_stay_apart` covers uses at
-- two different variables.
--
-- Ground truth, derived from the source, NOT captured: `useTwo (Box 0) (Box 1)`
-- calls `sizeOf` twice at Box (1 + 1 = 2); `useTwo Tag Tag` twice at Tag
-- (2 + 2 = 4); 2 + 4 = 6. The value also discriminates WHICH impl each call
-- reached: a single shared route would print 4 (all Box) or 8 (all Tag).
--
-- Verdict: ACCEPT.
interface Sized a where
  sizeOf : a -> Int

data Box = Box Int

impl Sized Box where
  sizeOf _ = 1

data Tag = Tag

impl Sized Tag where
  sizeOf _ = 2

useTwo : Sized a => a -> a -> Int
useTwo x y = d x + d y
  where
    d v = sizeOf v

main = println (useTwo (Box 0) (Box 1) + useTwo Tag Tag)
