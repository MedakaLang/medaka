-- C4, L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error; a literal receiver changes nothing (L1).
interface Sz a where
  size : a -> String

impl Sz Int where
  size n = "IMPL"

size : Int -> Int
size n = n + 1

main =
  let s = size 3 : Int
  println s
