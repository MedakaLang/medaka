-- #784: a row-kinded data ctor (its first param is declared `(e : Effect)`)
-- defined in ITS OWN module, imported by the entry below.  Regression guard
-- for the multi-module ACCEPT case: the under-determined-effect-var check
-- must consult the IMPORTED ctor's kind (dataParamKindsRef loaded from the
-- data universe), not just local ctors.
public export data Async (e : Effect) a = Done a | Suspend (Unit -> <e> Async e a)
