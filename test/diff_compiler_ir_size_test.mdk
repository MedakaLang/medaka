{- | Gate for the size of emitted LLVM IR: a tiny-program ceiling (arm A) and
   linear growth of IR with live program size (arm B). Replaces
   diff_compiler_ir_size.sh.

   IR line count is deterministic (the text IR is produced before clang runs),
   so an absolute ceiling is legitimate. Arm B samples N / 2N / 4N live decls
   and grades the ratio of consecutive IR deltas: linear is 2.0, quadratic 4.0,
   and the gate fails above 3.0. The constant prelude cost cancels in that ratio.

   The probe programs are written into a scratch directory, not a fixture
   corpus. Runs under `medaka test --native`: it spawns `medaka build --keep-ir`
   and reads the kept `.ll`, neither of which the interpreter binds. -}

import compiler_cli_test_support.{boundedInTree}
import string.{lines, unlines}
import test.{Expectation, fail, pass}
import test_process.{medakaBin, scratchDir}

-- Arm A: the tiny program's IR is 11,480 lines; 15,000 is about 30% headroom.
-- A legitimate prelude change that lifts it should re-measure and raise this
-- with a comment; a ceiling that tracks the value it bounds guards nothing.
ceiling : Int
ceiling = 15000

-- Arm B: base live size N, sampled at N / 2N / 4N.
baseN : Int
baseN = 300

tinySource : String
tinySource = unlines [
  "add : Int -> Int -> Int", "add x y = x + y", "main = println (add 2 3)"
]

gname : Int -> String
gname i = "g\{intToString i}"

-- g0 x = x + 0; gI x = g(I-1) x + I. Every decl is live because `main` calls
-- the head of the chain, so DCE keeps them all.
chainDecl : Int -> List String
chainDecl i =
  if i == 0 then
    ["g0 : Int -> Int", "g0 x = x + 0"]
  else
    [
      "\{gname i} : Int -> Int",
      "\{gname i} x = \{gname (i - 1)} x + \{intToString i}",
    ]

chainLines : Int -> Int -> List String
chainLines i n = if i >= n then [] else chainDecl i ++ chainLines (i + 1) n

chainSource : Int -> String
chainSource n =
  unlines (chainLines 0 n ++ ["main = println (\{gname (n - 1)} 0)"])

-- Build `source` with --keep-ir into `dir` and return the kept IR's line count.
-- A build failure, or a missing or empty .ll, is an error, never a skip.
buildIr : String ->
  String ->
  String ->
  <Exec, FileRead, FileWrite, IO> Result String Int
buildIr dir stem source = do
  _ <- writeFile "\{dir}/\{stem}.mdk" source
  (code, out, err) <- boundedInTree 600 medakaBin [
    "build",
    "--keep-ir",
    "\{dir}/\{stem}.mdk",
    "-o",
    "\{dir}/\{stem}",
  ]
  if code /= 0 then
    Err "could not build \{stem} (exit \{intToString code}):\n\{out}\{err}"
  else do
    text <- readFile "\{dir}/\{stem}.ll"
    if text == "" then
      Err "no IR kept for \{stem}: harness bug or --keep-ir regressed"
    else
      pure (length (lines text))

ceilingCase : String -> <Exec, FileRead, FileWrite, IO> Expectation
ceilingCase dir = match buildIr dir "tiny" tinySource
  Err e => fail "IR ceiling: \{e}"
  Ok n =>
    if n > ceiling then
      fail
        "CEILING: the tiny program emitted \{intToString n} IR lines, over the \{intToString ceiling} ceiling. This is prelude bloat (the prelude or dispatchers re-emitted per program). Inspect with `medaka build --keep-ir`, do not raise the ceiling."
    else
      pass

scaling : String ->
  <Exec, FileRead, FileWrite, IO> Result String (Int, Int, Int)
scaling dir = do
  l1 <- buildIr dir "b1" (chainSource baseN)
  l2 <- buildIr dir "b2" (chainSource (baseN * 2))
  l3 <- buildIr dir "b3" (chainSource (baseN * 4))
  pure (l1, l2, l3)

-- Grade the delta ratio d2/d1 against 3.0 as d2 > 3 * d1 (exact for d1 > 0).
gradeScaling : Int -> Int -> Int -> Expectation
gradeScaling l1 l2 l3 = gradeDeltas l1 l2 (l2 - l1) (l3 - l2)

gradeDeltas : Int -> Int -> Int -> Int -> Expectation
gradeDeltas l1 l2 d1 d2 =
  if d1 <= 0 then
    fail
      "IR did not grow from N=\{intToString baseN} (\{intToString l1} lines) to 2N (\{intToString l2} lines): the live chain is not being emitted (DCE pruned it, or the root or generator shape regressed)"
  else if d2 > 3 * d1 then
    fail
      "SUPERLINEAR: IR delta N->2N is \{intToString d1}, 2N->4N is \{intToString d2}; ratio above 3.0 (linear ~2.0, quadratic ~4.0)"
  else
    pass

scalingCase : String -> <Exec, FileRead, FileWrite, IO> Expectation
scalingCase dir = match scaling dir
  Err e => fail "IR scaling: \{e}"
  Ok (l1, l2, l3) => gradeScaling l1 l2 l3

test "diff_compiler_ir_size: tiny program IR is under the ceiling (arm A)" =
  match scratchDir
    Err e => fail "scratch dir: \{e}"
    Ok dir => ceilingCase dir

test "diff_compiler_ir_size: emitted IR scales linearly with live size (arm B)" =
  match scratchDir
    Err e => fail "scratch dir: \{e}"
    Ok dir => scalingCase dir
