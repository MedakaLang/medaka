-- Bare lambda with a capture that escapes: an anonymous `x => ...` lambda
-- literal that closes over `k` and outlives the iteration that builds it. Each
-- iteration passes its lambda on to the next one, which applies it; the last
-- one is applied after the loop. A cell is still live when the next one, with
-- a different `k`, is built, so the probe allocates one cell per iteration. A
-- lambda applied only inside the iteration that builds it is not a valid
-- control: once the applying call inlines, -O2 deletes the cell.
loop : Int -> Int -> (Int -> Int) -> Int -> Int
loop n k f acc
  | n <= 0 = f acc
  | otherwise = loop (n - 1) (k + 1) (x => x + k) (f acc)

main =
  let a0 = allocBytes ()
  let r = loop 2000000 0 (x => x) 0
  let a1 = allocBytes ()
  println "lambda-capture result=\{debug r}"
  println "lambda-capture allocBytes=\{debug (a1 - a0)}"
