-- C1, L8: a `Foldable t =>` constraint does not make the bare `length` the prelude method;
-- the wildcard-imported `bytes.length` answers, so the receiver mistypes
import bytes.*
count : Foldable t => t a -> Int
count xs = length xs
main =
  let _ = println (count (Some 1))
  let _ = println (count (None : Option Int))
  let _ = println (count (Ok 1 : Result String Int))
  println (count [1, 2, 3])
