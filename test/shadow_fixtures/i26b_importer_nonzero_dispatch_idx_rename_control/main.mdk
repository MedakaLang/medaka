-- L2 rung 2: the own method `mth` has no collision with the imported `mthx`; the plain call
-- and the dict-bound call both mean the method
import prov.{mthx}

interface IZ b where
  mth : Int -> b -> Int

data Box = Box Int

impl IZ Box where
  mth n (Box m) = 700 + n + m

viaDict : IZ b => Int -> b -> Int
viaDict n x = mth n x

main =
  println (mthx 3 4)
  println (viaDict 3 (Box 4))
