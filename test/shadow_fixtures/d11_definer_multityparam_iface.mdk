-- L3 (F-R4): the duplicate-declaration error holds for a multi-type-parameter interface;
-- arity takes no part (L1)
interface Ix a i where
  get : a -> i -> Int

data Box = Box Int

impl Ix Box Int where
  get (Box n) i = n + i

get : Int -> Int -> Int
get n i = n * i

main =
  println (get (Box 3) 1)
  println (get 3 1)
