-- L2 rung 2: the own method `fromInt` types the annotated binding (1005); the literal sum `1
-- + 2` is 3
interface Buildable c where
  fromInt : Int -> c

data Tag = Tag Int

impl Buildable Tag where
  fromInt n = Tag (n + 1000)

unTag : Tag -> Int
unTag (Tag n) = n

main =
  let t : Tag = fromInt 5
  println (unTag t)
  println (1 + 2)
