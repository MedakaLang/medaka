-- C1, L2 rung 4 over rung 5: `import bytes.*` binds `length : Bytes -> Int`, which beats the
-- prelude method; `length (Some 7)` is a located type mismatch
import bytes.*
o : Option Int
o = Some 7
main =
  let _ = println (length (Some 7))
  let _ = println (length o)
  let _ = println (length (None : Option Int))
  println (length (encodeUtf8 "héllo"))
