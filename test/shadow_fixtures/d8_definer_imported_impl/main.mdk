-- C6, L2 rung 2: the module's own `size : Int -> Int` is the bare name; `import
-- prov.{Sizeable, Box(..)}` binds no bare method name, so `size (Box 3)` is a located type
-- mismatch
import prov.{Sizeable, Box(..)}

size : Int -> Int
size n = n + 1

main =
  println (size (Box 3))
  println (size 3)
