-- SHADOW-SEMANTICS cell D8: DEFINER shadow whose shadowed interface + the
-- receiver's impl are IMPORTED — this module defines only the standalone.
-- Expected: check/run/build REJECT `size (Box 3)` (Int vs Box); the standalone wins.
import prov.{Sizeable, Box(..)}

size : Int -> Int
size n = n + 1

main =
  println (size (Box 3))
  println (size 3)
