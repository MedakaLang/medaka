-- L4 (F-R3): explicit `import prov.{size}` plus the module's own interface method `size`
-- is a located error at the import member
import prov.{size}

interface Sizeable a where
  size : a -> Int

data Box = Box Int

impl Sizeable Box where
  size (Box n) = n

main =
  println (size (Box 3))
  println (size 3)
