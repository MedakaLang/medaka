-- C1, L2 rung 3 over rung 5: the imported `display : Tok -> String` beats the prelude
-- `display`, so `display (3 : Int)` is a located type mismatch
import prov.{Tok(..), display}

main =
  println (display (Tok 0))
  println (display (3 : Int))
  println (display (stringLength "xy"))
  println (display (charCode 'a'))
