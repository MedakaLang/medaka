{- | Gate for `medaka mcp` (#253): a golden JSON-RPC transcript per fixture, the
   `--help`/bogus-flag argv contract (#299), the MEDAKA_MCP_LOG call-log format,
   and the mainSchemeRef memo-hit property across two medaka_check calls.
   Replaces test/diff_compiler_mcp.sh. Each fixture is a pair: <name>.jsonl, the
   request stream (one JSON-RPC message per line; notifications have no id and
   produce no response line), and <name>.golden, the exact expected stdout. A new
   tool gets a new pair; no edit to this file is needed. The shell gate's CAPTURE=1
   re-capture mode has no native equivalent, so goldens are written by hand.

   Paths. The fixture loop compares each golden byte for byte, with no
   normalisation. The server runs with its working directory set to the repository
   root (mcpScript cds there), so a fixture that names a file should use a
   repo-relative path, which keeps the response independent of where the gate was
   invoked from. A golden must never contain the worktree's absolute path. This test
   does no sed substitution. A fixture whose result must embed a path needs the
   runner extended to replace that path with a placeholder before the comparison,
   the way the shell gate's sed did for check --json. The two checks that touch temp
   paths (the logging record and the memo projects) assert on counts and escaped
   content only, never on path text.

   Runs under `medaka test --native`: it spawns ./medaka mcp with fixture request
   streams on stdin and writes temp projects, neither of which the interpreter
   binds. -}

import test_process.{medakaBin, medakaRoot, boundedVerbSeconds, withScratchDir}
import test.{
  Expectation, expectAll, expectAtLeast, expectEach, expectEqual, expectGolden,
  expectTextContainsAll, expectFalse, fail, pass
}
import fs.{fixtureFiles}
import path.{stem}
import json.{Json(..), jObject, jArray, stringify, parse, get, asString}
import string.{split, endsWith, join, contains}
import list.{reverse}

corpus : <IO> String
corpus = "\{medakaRoot}/test/mcp_fixtures"

-- Positional args: $1 repo root (cwd and MEDAKA_ROOT), $2 binary, $3 stdin
-- source, $4 MEDAKA_MCP_LOG path ("" = unset); the rest are argv for `mcp`.
mcpScript : String
mcpScript =
  "export MEDAKA_ROOT=\"$1\"; cd \"$1\" || exit 1; bin=\"$2\"; input=\"$3\"; log=\"$4\"; shift 4; if [ -n \"$log\" ]; then MEDAKA_MCP_LOG=\"$log\"; export MEDAKA_MCP_LOG; else unset MEDAKA_MCP_LOG; fi; exec \"$bin\" mcp \"$@\" < \"$input\""

mcpRun : Int ->
  String ->
  String ->
  List String ->
  <Exec, IO, FileRead> Result String (Int, String, String)
mcpRun secs input logPath args =
  boundedVerbSeconds
    secs
    "sh"
    (["-c", mcpScript, "sh", medakaRoot, medakaBin, input, logPath] ++ args)

-- #299: --help/-h print usage on stdout and exit 0 without reading the loop.
usageRow : String -> List String -> <Exec, IO, FileRead> Expectation
usageRow label args = match mcpRun 5 "/dev/zero" "" args
  Err e => fail "mcp-arg(\{label}): could not spawn: \{e}"
  Ok (code, out, _) =>
    if code /= 0 then
      fail "mcp-arg(\{label}): exited \{intToString code} (hung or failed)"
    else
      expectTextContainsAll ["medaka mcp"] out

-- #299: a bogus flag is rejected on stderr with a nonzero exit.
rejectRow : String -> <Exec, IO, FileRead> Expectation
rejectRow flag = match mcpRun 5 "/dev/zero" "" [flag]
  Err e => fail "mcp-arg(\{flag}): could not spawn: \{e}"
  Ok (code, _, err) =>
    if code /= 0 then
      expectTextContainsAll ["unrecognized flag '\{flag}' (known: none)"] err
    else
      fail "mcp-arg(\{flag}): exited 0, want nonzero"

test "mcp argv: --help/-h print usage and exit 0; bogus flags rejected on stderr" = expectEach
  [
    ("--help", usageRow "--help" ["--help"]),
    ("-h", usageRow "-h" ["-h"]),
    ("bogusarg", rejectRow "bogusarg"),
    ("--zzz", rejectRow "--zzz"),
  ]

fixtureStems : <Exec, IO, FileRead> Result String (List String)
fixtureStems =
  map
    (paths => map stem (filter (endsWith ".jsonl") paths))
    (fixtureFiles corpus)

fixtureRow : String -> <Exec, IO, FileRead> Expectation
fixtureRow name = match mcpRun 30 "\{corpus}/\{name}.jsonl" "" []
  Err e => fail "\{name}: could not spawn: \{e}"
  Ok (code, out, _) =>
    if code /= 0 then
      fail "\{name}: medaka mcp exited \{intToString code}"
    else
      expectGolden "\{corpus}/\{name}.golden" out

test "mcp fixtures: each request stream exits 0 and its stdout equals its golden" =
  match fixtureStems
    Err e => fail "list fixtures: \{e}"
    Ok names => expectAll [
      expectAtLeast 32 (length names),
      expectEach (map (n => (n, fixtureRow n)) names),
    ]

-- Log-record checks over the `logging` fixture: each record is one physical
-- line with exactly 4 tab-separated fields, exactly one tools/call record,
-- and that record carries the escaped name and the stringified arguments.
dropLastEmpty : List String -> List String
dropLastEmpty xs = match reverse xs
  "" :: rest => reverse rest
  _ => xs

secondField : String -> String
secondField r = match split "\t" r
  _ :: f :: _ => f
  _ => ""

isCall : String -> Bool
isCall r = secondField r == "\"tools/call\""

callContent : List String -> Expectation
callContent [r] =
  expectTextContainsAll ["\"weird\\nname\\ttab\"", "\"probe\":true"] r
callContent _ = fail "tools/call record: expected exactly one record"

expectLogRecords : List String -> Expectation
expectLogRecords rs = expectAll [
  expectEqual 4 (length rs),
  expectEqual 0 (length (filter (r => length (split "\t" r) /= 4) rs)),
  expectEqual 1 (length (filter isCall rs)),
  callContent (filter isCall rs),
]

logRecordsCheck : String -> <Exec, IO, FileRead> Expectation
logRecordsCheck logfile = match readFile logfile
  Err e => fail "logging-on(log-file): \{logfile} unreadable: \{e}"
  Ok text => expectLogRecords (dropLastEmpty (split "\n" text))

loggingRun : String -> <Exec, IO, FileRead> Expectation
loggingRun logfile = match mcpRun 30 "\{corpus}/logging.jsonl" logfile []
  Err e => fail "logging-on(stdout): could not spawn: \{e}"
  Ok (code, out, _) =>
    if code /= 0 then
      fail "logging-on(stdout): medaka mcp exited \{intToString code}"
    else
      expectAll [
        expectGolden "\{corpus}/logging.golden" out,
        logRecordsCheck logfile,
      ]

test "mcp logging: MEDAKA_MCP_LOG leaves stdout golden-identical and writes 4 well-formed records" =
  withScratchDir (dir => loggingRun "\{dir}/mcp_call.log")

-- mainSchemeRef across a module-chain memo HIT: two medaka_check calls on the
-- same project in ONE process must both report (or both stay silent on) the
-- missing-Display error for the terminal module's `main`.
writeOk : String -> String -> <Exec, IO, FileRead> Result String String
writeOk path text = map (_ => path) (writeFile path text)

memoCall : String -> String -> String
memoCall dir id =
  "{\"jsonrpc\":\"2.0\",\"id\":\{id},\"method\":\"tools/call\",\"params\":{\"name\":\"medaka_check\",\"arguments\":{\"file\":\"\{dir}/main.mdk\"}}}"

memoRequest : String -> String
memoRequest dir =
  "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n\{memoCall dir "2"}\n\{memoCall dir "3"}\n{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\",\"params\":{}}\n"

memoSetup : String -> <Exec, IO, FileRead> Result String String
memoSetup dir =
  match (writeOk
    "\{dir}/lib_a.mdk"
    "export double : Int -> Int\ndouble x = x + x\n")
    Err e => Err e
    Ok _ =>
      match (writeOk
        "\{dir}/lib_b.mdk"
        "import lib_a.{double}\n\nexport quad : Int -> Int\nquad x = double (double x)\n")
        Err e => Err e
        Ok _ => writeOk "\{dir}/memo.jsonl" (memoRequest dir)

countDisplay : String -> Int
countDisplay out = length (split "no impl of Display for H" out) - 1

memoCase : String -> String -> Int -> String -> <Exec, IO, FileRead> Expectation
memoCase dir src want label = match writeOk "\{dir}/main.mdk" src
  Err e => fail "memo-hit main-shape (\{label}): write main: \{e}"
  Ok _ => match mcpRun 60 "\{dir}/memo.jsonl" "" []
    Err e => fail "memo-hit main-shape (\{label}): could not spawn: \{e}"
    Ok (code, out, _) =>
      if code /= 0 then
        fail
          "memo-hit main-shape (\{label}): medaka mcp exited \{intToString code}"
      else if countDisplay out == want then
        pass
      else
        fail
          "memo-hit main-shape (\{label}): want \{intToString want} missing-Display errors over two calls, got \{intToString (countDisplay out)}"

test "mcp memo-hit: two medaka_check calls on one project keep the terminal main's Display verdict" = withScratchDir
  (dir => match memoSetup dir
    Err e => fail "memo setup: \{e}"
    Ok _ => expectAll [
      memoCase
        dir
        "import lib_a.{double}\nimport lib_b.{quad}\n\ndata H = H Int\n\nmain = H (quad (double 3))\n"
        2
        "undisplayable value main",
      memoCase
        dir
        "import lib_a.{double}\nimport lib_b.{quad}\n\nmain = println (quad (double 3))\n"
        0
        "Unit main",
    ])

coordinateCall : Int -> String -> Json -> String
coordinateCall id name args =
  stringify
    (jObject [
      ("jsonrpc", JString "2.0"),
      ("id", JInt id),
      ("method", JString "tools/call"),
      ("params", jObject [("name", JString name), ("arguments", args)]),
    ])

coordinateFile : String -> Json
coordinateFile path = jObject [("file", JString path)]

coordinateResponse : String -> Option String
coordinateResponse line = do
  obj <- match parse line
    Ok value => Some value
    Err _ => None
  result <- get "result" obj
  content <- get "content" result
  first <- match content
    JArray items => match toList items
      item :: _ => Some item
      [] => None
    _ => None
  match get "text" first
    Some (JString text) => Some text
    _ => None

coordinateRun : String -> <Exec, IO, FileRead> Expectation
coordinateRun dir =
  let path = stringConcat [dir, "/unicode.mdk"]
  let one = stringConcat [dir, "/one.mdk"]
  let two = stringConcat [dir, "/two.mdk"]
  let request = stringConcat [dir, "/coordinate.jsonl"]
  let calls = [
    coordinateCall
      1
      "medaka_definition"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("col", JInt 18),
      ]),
    coordinateCall
      2
      "medaka_definition"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("symbol", JString "value"),
      ]),
    coordinateCall
      3
      "medaka_definition"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("symbol", JString "missing"),
      ]),
    coordinateCall
      4
      "medaka_type_at"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("col", JInt 18),
      ]),
    coordinateCall 5 "medaka_symbols" (coordinateFile one),
    coordinateCall 6 "medaka_symbols" (coordinateFile two),
    coordinateCall
      7
      "medaka_check"
      (jObject [("source", JString "main = (\"😀\", 1 + \"x\")\n")]),
    coordinateCall 8 "medaka_symbols" (coordinateFile path),
    coordinateCall
      9
      "medaka_check"
      (jObject [("source", JString "main = \"abc")]),
    coordinateCall
      10
      "medaka_fmt"
      (jObject [("source", JString "main = (\"😀\", )\n")]),
    coordinateCall
      12
      "medaka_check"
      (jObject [("source", JString "main = (\"😀\", 1 != 2)\n")]),
    coordinateCall
      11
      "medaka_check"
      (coordinateFile (stringConcat [dir, "/missing.mdk"])),
  ]
  match (
    writeOk path """value = 1
main = ("😀", value + value)""",
    writeOk one """main = (
""",
    writeOk two """value = 1
bad = )
""",
    writeOk request (stringConcat [join "\n" calls, "\n"]),
  )
    (Ok _, Ok _, Ok _, Ok _) => match mcpRun 30 request "" []
      Err e => fail e
      Ok (code, out, _) => match map coordinateResponse (split "\n" out)
        (Some first) :: (Some ambiguous) :: (Some missing) :: (Some ty) :: (Some firstError) :: (Some secondError) :: (Some diag) :: (Some symbols) :: (Some eof) :: (Some fmt) :: (Some parseDiag) :: (Some absent) :: _ => expectEach
          [
            ("exit", expectEqual 0 code),
            (
              "parse identity and UTF-16 range",
              expectTextContainsAll
                [
                  "P-BAD-NEQ", "\"character\":16", "\"character\":18",
                  "replace `!=` with `/=`"
                ]
                parseDiag,
            ),
            (
              "EOF clamp",
              expectTextContainsAll ["\"character\":11,\"line\":0"] eof,
            ),
            ("formatter astral", expectTextContainsAll ["line 0, col 12"] fmt),
            (
              "missing source",
              expectTextContainsAll ["cannot read file"] absent,
            ),
            ("definition", expectTextContainsAll ["\"character\":5"] first),
            (
              "ambiguity",
              expectTextContainsAll ["\"col\":14", "\"col\":22"] ambiguous,
            ),
            (
              "miss",
              expectTextContainsAll ["\"col\":14", "\"col\":22"] missing,
            ),
            ("type", expectEqual "value : Int" ty),
            (
              "first line",
              expectEqual "[]" firstError,
            ),
            (
              "second line",
              expectTextContainsAll ["value"] secondError,
            ),
            (
              "diagnostic",
              expectTextContainsAll
                ["\"character\":14", "\"character\":21"]
                diag,
            ),
            (
              "symbol EOF",
              expectTextContainsAll ["\"line\":1,\"character\":28"] symbols,
            ),
          ]
        _ => fail "coordinate responses missing"
    _ => fail "coordinate fixture write failed"

test "mcp positions use UTF-16 and parse errors use zero-based lines" =
  withScratchDir coordinateRun

scopeCoordinates : String -> <Exec, IO, FileRead> Expectation
scopeCoordinates dir =
  let path = stringConcat [dir, "/scope.mdk"]
  let bad = stringConcat [dir, "/bad.mdk"]
  let request = stringConcat [dir, "/scope.jsonl"]
  let calls = [
    coordinateCall
      1
      "medaka_type_at"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("symbol", JString "x"),
      ]),
    coordinateCall
      2
      "medaka_definition"
      (jObject [
        ("file", JString path),
        ("line", JInt 1),
        ("symbol", JString "x"),
      ]),
    coordinateCall
      3
      "medaka_type_at"
      (jObject [
        ("file", JString path),
        ("line", JInt 0),
        ("symbol", JString "x"),
      ]),
    coordinateCall
      4
      "medaka_type_at"
      (jObject [
        ("file", JString bad),
        ("line", JInt 0),
        ("symbol", JString "x"),
      ]),
  ]
  match (
    writeOk path """x = True
f x = (x + 1, x)
main = f 2
""",
    writeOk bad "x = (x + x",
    writeOk request (stringConcat [join "\n" calls, "\n"]),
  )
    (Ok _, Ok _, Ok _) => match mcpRun 30 request "" []
      Err e => fail e
      Ok (code, out, _) => match map coordinateResponse (split "\n" out)
        (Some local) :: (Some defs) :: (Some global) :: (Some malformed) :: _ => expectEach
          [
            ("exit", expectEqual 0 code),
            (
              "local shadow",
              expectTextContainsAll
                ["col 2: x : a", "col 7: x : a", "col 14: x : a"]
                local,
            ),
            (
              "definitions",
              expectTextContainsAll
                ["\"col\":2", "\"col\":7", "\"col\":14", "\"character\":1"]
                defs,
            ),
            ("global", expectEqual "x : Bool" global),
            ("malformed", expectTextContainsAll ["no symbol"] malformed),
          ]
        _ => fail "scope responses missing"
    _ => fail "scope fixture write failed"

test "mcp ambiguous positions preserve local scope" =
  withScratchDir scopeCoordinates

testGateCoordinates : String -> <Exec, IO, FileRead> Expectation
testGateCoordinates dir =
  let ascii = "\{dir}/ascii.mdk"
  let one = "\{dir}/one.mdk"
  let two = "\{dir}/two.mdk"
  let dep = "\{dir}/dep.mdk"
  let main = "\{dir}/main.mdk"
  let bad = "\{dir}/bad.mdk"
  let missing = "\{dir}/missing.mdk"
  let cycle = "\{dir}/cycle.mdk"
  let request = "\{dir}/test.jsonl"
  let paths = [ascii, one, two, main, bad, missing, cycle]
  let calls =
    map
      (path =>
        coordinateCall
          1
          "medaka_test"
          (jObject [("file", JString path), ("engine", JString "eval")]))
      paths
  match (
    writeOk ascii """-- > 1
-- 1
main = (1 + "x")
""",
    writeOk one """-- > 1
-- 1
main = ("😀", 1 + "x")
""",
    writeOk two """-- > 1
-- 1
main = ("😀😀", 1 + "x")
""",
    writeOk dep """export bad = ("😀😀", 1 + "x")
""",
    writeOk main """import dep.{bad}
main = bad
""",
    writeOk bad """import dep.{bad}
main = (
""",
    writeOk missing """import absent.{x}
main = x
""",
    writeOk cycle """import cycle.{x}
x = 1
""",
    writeOk request (stringConcat [join "\n" calls, "\n"]),
  )
    (Ok _, Ok _, Ok _, Ok _, Ok _, Ok _, Ok _, Ok _, Ok _) =>
      match mcpRun 60 request "" []
        Err e => fail e
        Ok (code, out, _) => match map coordinateResponse (split "\n" out)
          (Some a) :: (Some b) :: (Some c) :: (Some d) :: (Some e) :: (Some f) :: (Some g) :: _ => expectEach
            [
              ("exit", expectEqual 0 code),
              (
                "error envelope",
                expectEqual
                  (length paths)
                  (length (split "\"isError\":true" out) - 1),
              ),
              (
                "ASCII",
                expectTextContainsAll
                  ["T-NO-IMPL", "\"character\":8", "\"character\":15"]
                  a,
              ),
              (
                "one astral",
                expectTextContainsAll ["\"character\":14", "\"character\":21"] b,
              ),
              (
                "two astral",
                expectTextContainsAll
                  [
                    "\"character\":16", "\"character\":23", "\"total\":0",
                    "\"properties\":[]"
                  ]
                  c,
              ),
              (
                "destination",
                expectTextContainsAll
                  [dep, "\"character\":22", "\"character\":29"]
                  d,
              ),
              ("parse", expectTextContainsAll ["P-", "typeDiagnostics"] e),
              ("missing", expectTextContainsAll ["R-MODULE-LOAD", "absent"] f),
              (
                "cycle",
                expectTextContainsAll ["R-MODULE-LOAD", "cyclic dependency"] g,
              ),
            ]
          _ => fail "test gate responses missing"
    _ => fail "test gate fixture write failed"

test "mcp test gate retains diagnostic sources and uses UTF-16 ranges" =
  withScratchDir testGateCoordinates

testGateControls : String -> <Exec, IO, FileRead> Expectation
testGateControls dir =
  let entry = stringConcat [dir, "/entry.mdk"]
  let broken = stringConcat [dir, "/broken.mdk"]
  let importing = stringConcat [dir, "/importing.mdk"]
  let good = stringConcat [dir, "/good.mdk"]
  let exempt = stringConcat [dir, "/exempt.mdk"]
  let multi = stringConcat [dir, "/multi.mdk"]
  let request = stringConcat [dir, "/controls.jsonl"]
  let testCall =
    path =>
      coordinateCall
        1
        "medaka_test"
        (jObject [("file", JString path), ("engine", JString "eval")])
  let invalid =
    coordinateCall
      1
      "medaka_test"
      (jObject [("file", JString entry), ("engine", JString "wrong")])
  let calls = [
    invalid,
    testCall entry,
    testCall good,
    testCall importing,
    testCall exempt,
    testCall multi,
  ]
  match (
    writeOk entry "main = (\n",
    writeOk broken "export bad = (\n",
    writeOk importing """import broken.{bad}
main = bad
""",
    writeOk good "main = 1\n",
    writeOk exempt "test \"panic\" = panic \"must not run\"\n",
    writeOk multi """-- > 1
-- 1
x = 1 + "x"
y = True + 1
main = x
""",
    writeOk request (stringConcat [join "\n" calls, "\n"]),
  )
    (Ok _, Ok _, Ok _, Ok _, Ok _, Ok _, Ok _) => match mcpRun 60 request "" []
      Err e => fail e
      Ok (code, out, _) => match map coordinateResponse (split "\n" out)
        (Some a) :: (Some b) :: (Some c) :: (Some d) :: (Some e) :: (Some f) :: _ => expectEach
          [
            ("exit", expectEqual 0 code),
            (
              "engine before parse",
              expectTextContainsAll ["engine", "wrong"] a,
            ),
            (
              "entry parse",
              expectTextContainsAll ["P-", "typeDiagnostics", "\"total\":0"] b,
            ),
            ("session survives", expectTextContainsAll ["\"ok\":true"] c),
            ("import parse", expectTextContainsAll [broken, "P-"] d),
            (
              "exempt test skipped",
              expectTextContainsAll
                [
                  "\"typecheckSkipped\":true", "\"testDeclsSkipped\":true",
                  "\"ok\":true"
                ]
                e,
            ),
            (
              "multiple errors",
              expectAtLeast 2 (length (split "\"code\":" f) - 1),
            ),
          ]
        _ => fail "test gate control responses missing"
    _ => fail "test gate control fixture write failed"

test "mcp test parse, validation, and skipped phase controls" =
  withScratchDir testGateControls

mixedGateDiagnostics : String -> <Exec, IO, FileRead> Expectation
mixedGateDiagnostics dir =
  let single = "\{dir}/single.mdk"
  let dep = "\{dir}/dep.mdk"
  let main = "\{dir}/main.mdk"
  let warning = "\{dir}/warning.mdk"
  let request = "\{dir}/mixed.jsonl"
  let calls =
    map
      (path =>
        coordinateCall
          1
          "medaka_test"
          (jObject [("file", JString path), ("engine", JString "eval")]))
      [single, main, warning]
  match (
    writeOk single """data Color = Red | Blue
f Red = 1
main = 1 + "x"
""",
    writeOk dep """data Color = Red | Blue
f Red = 1
export bad = 1 + "x"
""",
    writeOk main """import dep.{bad}
main = bad
""",
    writeOk warning """data Color = Red | Blue
f Red = 1
main = 1
""",
    writeOk request (stringConcat [join "\n" calls, "\n"]),
  )
    (Ok _, Ok _, Ok _, Ok _, Ok _) => match mcpRun 60 request "" []
      Err e => fail e
      Ok (code, out, _) => match map coordinateResponse (split "\n" out)
        (Some a) :: (Some b) :: (Some c) :: _ => expectEach [
          ("exit", expectEqual 0 code),
          (
            "error envelopes",
            expectEqual 2 (length (split "\"isError\":true" out) - 1),
          ),
          (
            "single diagnostics",
            expectTextContainsAll
              [
                "W-NONEXHAUSTIVE-CLAUSES", "T-NO-IMPL", "\"severity\":2",
                "\"severity\":1", "\"character\":8", "\"character\":9",
                "\"character\":7", "\"character\":14",
                "\"typeError\":\"no impl of Num for String\"", "\"total\":0",
                "\"properties\":[]"
              ]
              a,
          ),
          (
            "import diagnostics",
            expectTextContainsAll
              [
                dep, "W-NONEXHAUSTIVE-CLAUSES", "T-NO-IMPL", "\"severity\":2",
                "\"severity\":1", "\"character\":8", "\"character\":9",
                "\"character\":13", "\"character\":20",
                "\"typeError\":\"no impl of Num for String\""
              ]
              b,
          ),
          ("warning only", expectTextContainsAll ["\"ok\":true"] c),
        ]
        _ => fail "mixed gate responses missing"
    _ => fail "mixed gate fixture write failed"

test "mcp test gate retains warnings alongside errors" =
  withScratchDir mixedGateDiagnostics

symbolPos : Int -> Int -> Json
symbolPos line col = jObject [("line", JInt line), ("character", JInt col)]

symbolRegion : Int -> Int -> Json
symbolRegion start end = jObject [
  ("start", symbolPos start 0),
  ("end", symbolPos end 0),
  ("reason", JString "invalidDeclaration"),
]

symbolRange : Int -> Int -> Int -> Int -> Json
symbolRange sl sc el ec =
  jObject [("start", symbolPos sl sc), ("end", symbolPos el ec)]

symbolDiagnostic : Int -> Int -> Int -> Int -> String -> String -> Json
symbolDiagnostic sl sc el ec code message = jObject [
  ("range", symbolRange sl sc el ec),
  ("severity", JInt 1),
  ("source", JString "medaka"),
  ("message", JString message),
  ("code", JString code),
]

symbolField : String -> Json -> Option String
symbolField key obj = do
  value <- get key obj
  asString value

outlineSymbols : Json -> Option (List Json)
outlineSymbols result = do
  content <- get "content" result
  first <- match content
    JArray items => match toList items
      item :: _ => Some item
      [] => None
    _ => None
  text <- symbolField "text" first
  value <- match parse text
    Ok v => Some v
    Err _ => None
  match value
    JArray items => Some (toList items)
    _ => None

outlineNames : Json -> Option (List (Option String))
outlineNames result = map (map (symbolField "name")) (outlineSymbols result)

currentSymbolsWire : String -> <Exec, IO, FileRead> Expectation
currentSymbolsWire dir =
  let path = stringConcat [dir, "/current.mdk"]
  let request = stringConcat [dir, "/current.jsonl"]
  let source =
    "before = (\"😀\", 1)\r\nbad = )\r\nmiddle = 2\r\nworse = )\r\nafter = 3\r\n"
  match (
    writeOk path source,
    writeOk
      request
      (coordinateCall 1 "medaka_symbols" (coordinateFile path) ++ "\n"),
  )
    (Ok _, Ok _) => match mcpRun 30 request "" []
      Err e => fail e
      Ok (code, out, _) => match parse out
        Err _ => fail "invalid MCP response"
        Ok obj => match get "result" obj
          None => fail "missing MCP result"
          Some result => match get "structuredContent" result
            None => fail "missing metadata"
            Some metadata => expectEach [
              ("exit", expectEqual 0 code),
              (
                "origin",
                expectEqual
                  (Some
                    (jObject [
                      ("uri", JString ("file://" ++ path)),
                      ("version", JNull),
                      ("generation", JInt 0),
                    ]))
                  (get "origin" metadata),
              ),
              (
                "completeness",
                expectEqual
                  (Some (JString "partial"))
                  (get "completeness" metadata),
              ),
              (
                "stop",
                expectEqual (Some (JString "reachedEnd")) (get "stop" metadata),
              ),
              (
                "regions",
                expectEqual
                  (Some (jArray [symbolRegion 1 2, symbolRegion 3 4]))
                  (get "invalidRegions" metadata),
              ),
              (
                "names",
                expectEqual
                  (Some [Some "before", Some "middle", Some "after"])
                  (outlineNames result),
              ),
              (
                "diagnostics",
                expectEqual
                  (Some
                    (jArray [
                      symbolDiagnostic
                        1
                        6
                        1
                        7
                        "P-PARSE"
                        "expected an expression",
                      symbolDiagnostic
                        3
                        8
                        3
                        9
                        "P-PARSE"
                        "expected an expression",
                    ]))
                  (get "diagnostics" metadata),
              ),
            ]
    _ => fail "current fixture write failed"

test "mcp symbols report current partial source and provenance" =
  withScratchDir currentSymbolsWire

terminalSymbolsWire : String -> <Exec, IO, FileRead> Expectation
terminalSymbolsWire dir =
  let openPath = dir ++ "/open.mdk"
  let lexPath = dir ++ "/lex.mdk"
  let request = dir ++ "/terminal.jsonl"
  let calls = stringConcat [
    coordinateCall 1 "medaka_symbols" (coordinateFile openPath),
    "\n",
    coordinateCall 2 "medaka_symbols" (coordinateFile lexPath),
    "\n",
  ]
  match (
    writeOk openPath "before = 1\nbad = (\nhidden = 2\n",
    writeOk lexPath "before = 1\nbad = \"unterminated\n",
    writeOk request calls,
  )
    (Ok _, Ok _, Ok _) => match mcpRun 30 request "" []
      Err e => fail e
      Ok (code, out, _) => expectEach [
        ("exit", expectEqual 0 code),
        (
          "unclosed",
          expectTextContainsAll
            ["stoppedDelimiter", "unclosedDelimiter", "before", "partial"]
            out,
        ),
        (
          "lexical",
          expectTextContainsAll
            ["stoppedLexically", "terminalLexError", "L-UNTERMINATED-STRING"]
            out,
        ),
        ("hidden declaration", expectFalse (contains "hidden" out)),
      ]
    _ => fail "terminal fixture write failed"

test "mcp symbols stop at delimiters and terminal lex errors" =
  withScratchDir terminalSymbolsWire

barrierSymbolsWire : String -> <Exec, IO, FileRead> Expectation
barrierSymbolsWire dir =
  let broken = dir ++ "/broken.mdk"
  let valid = dir ++ "/valid.mdk"
  let request = dir ++ "/barrier.jsonl"
  let calls = stringConcat [
    coordinateCall 1 "medaka_symbols" (coordinateFile broken),
    "\n",
    coordinateCall 2 "medaka_symbols" (coordinateFile valid),
    "\n",
  ]
  match (
    writeOk broken "f : Int -> Int\nbroken = )\nf x = x\n",
    writeOk valid "f : Int -> Int\nf x = x\n",
    writeOk request calls,
  )
    (Ok _, Ok _, Ok _) => match mcpRun 30 request "" []
      Err e => fail e
      Ok (code, out, _) => match split "\n" out
        a :: b :: _ => match (parse a, parse b)
          (Ok x, Ok y) =>
            let brokenSymbols = do
              result <- get "result" x
              outlineSymbols result
            let validSymbols = do
              result <- get "result" y
              outlineSymbols result
            expectEach [
              ("exit", expectEqual 0 code),
              (
                "broken names",
                expectEqual
                  (Some [Some "f", Some "f"])
                  (map (map (symbolField "name")) brokenSymbols),
              ),
              (
                "broken ranges",
                expectEqual
                  (Some [
                    Some (symbolRange 0 0 1 0),
                    Some (symbolRange 2 0 3 0),
                  ])
                  (map (map (get "range")) brokenSymbols),
              ),
              (
                "valid names",
                expectEqual
                  (Some [Some "f"])
                  (map (map (symbolField "name")) validSymbols),
              ),
              (
                "valid range",
                expectEqual
                  (Some [Some (symbolRange 0 0 2 0)])
                  (map (map (get "range")) validSymbols),
              ),
            ]
          _ => fail "invalid MCP response"
        _ => fail "missing MCP responses"
    _ => fail "barrier fixture write failed"

test "mcp symbols keep invalid regions as barriers" =
  withScratchDir barrierSymbolsWire
