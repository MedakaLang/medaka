{- | The eval and Core IR value sweeps over the fixture corpora, as one
   runner over a table of rows.

   Eighteen shell gates used to do this, one script per (oracle, corpus)
   pair, each a near-copy of the same loop: spawn an oracle over every
   fixture in a corpus, strip the native runtime's trailing `()`, and diff
   the result against a committed golden. The pairs are the data; the loop is
   not. The rows here name them:

   | oracle | corpus | what it proves |
   |---|---|---|
   | `eval_main` | `eval_fixtures` | the AST tree-walker on the engine core |
   | `core_ir_main` | `eval_fixtures` | Core IR evaluates as the AST does |
   | `core_ir_roundtrip_main` | `eval_fixtures` | S-expr serialization is lossless |
   | `eval_prelude_main` | `eval_list_fixtures` | List combinators + comprehensions |
   | `eval_list_batch` | `eval_list_fixtures` | batched == per-process |
   | `core_ir_prelude_main` | `eval_list_fixtures` | the same through Core IR |
   | `eval_prelude_main` | `eval_prelude_fixtures` | `core.mdk` dispatch |
   | `eval_prelude_batch` | `eval_prelude_fixtures` | batched == per-process |
   | `core_ir_prelude_main` | `eval_prelude_fixtures` | the same through Core IR |
   | `eval_run_main` | `diff_fixtures` | the shared `medaka run` corpus |
   | `eval_run_batch` | `diff_fixtures` | batched == per-process |
   | `core_ir_run_main` | `diff_fixtures` | the same through Core IR |
   | `core_ir_typed_main` | `eval_typed_fixtures` | Core IR's typed `CMethod`/`RKey` dispatch |
   | `eval_typed_batch` | `eval_typed_fixtures` | batched == per-process |
   | `eval_dict_batch` | `eval_dict_fixtures` | batched == per-process, dict-passed dispatch |
   | `eval_modules_main` | `eval_modules_fixtures` | the loader-driven untyped `evalModules` |
   | `core_ir_modules_main` | `eval_modules_fixtures` | the same corpus through per-module Core IR frames |
   | `eval_typed_modules_main` | `eval_typed_modules_fixtures` | route-stamped dispatch the untyped path cannot resolve |

   The last three take a corpus whose unit is a DIRECTORY of modules rather
   than a single file (`DirFixture` below). Their goldens sit inside the
   fixture beside its modules, their entry module is named per corpus rather
   than per fixture, and their oracle takes the fixture's own directory as a
   further argument so the loader can find the entry's siblings.

   A `_batch` row is NOT a duplicate of the per-fixture row above it. It
   spawns ONE process over the whole corpus and cuts the delimited stdout
   back apart, so it is the only thing asserting that a cached prelude and a
   shared heap leave no trace between fixtures. Deduplicating the table on
   (corpus, golden) would silently delete that property, so the two stay
   separate rows with separate spawns.

   Three things this runner does that the retired scripts did not:

   - It reads the oracle's EXIT CODE and STDERR, not stdout alone. The
     scripts piped stderr to `/dev/null` and never looked at `$?`, which is
     how `eval_prelude_fixtures/string_interp.mdk` sat green for a year while
     its oracle panicked (`expectedPanics` below).
   - It asserts each corpus still holds the number of fixtures it held when
     the rows were written, so a corpus that silently shrinks reds rather
     than passing over fewer rows.
   - It grades every row in one process, so a red run names every failing
     (gate, fixture) pair at once instead of the first script to exit 1.

   `test/eval_fixtures`, `test/eval_list_fixtures`,
   `test/eval_prelude_fixtures` and `test/eval_typed_modules_fixtures` are
   FROZEN dev-probe corpora (#1241): `test/capture_goldens.sh` is a no-op for
   them and there is no regeneration script, so a missing or wrong golden is
   hand-derived from the fixture's semantics, never captured from whatever an
   oracle prints today.

   Most of these corpora never reach the type checker: the entries behind
   `eval_main`, `core_ir_main` and `core_ir_roundtrip_main` import no
   `types.typecheck`, so their pipeline is parse → desugar → [annotate →
   lower] → eval and no `Mono` is ever built. The two typed entries
   (`compiler/entries/core_ir_typed_main.mdk`,
   `compiler/entries/eval_typed_modules_main.mdk`) do, because their fixtures
   turn on dispatch that only resolves once the typed pipeline stamps routes.
   Even there the assertion is a VALUE, not a type: a type-level assertion
   belongs in `test/typecheck_error_fixtures/`, not here.

   Runs under `medaka test --native`: it spawns oracle binaries and reads the
   corpora, neither of which the interpreter binds. -}

import compiler_cli_test_support.{
  batchSection, boundedInTree, chompNewlines, stripUnitAutoPrint, sweepUnits
}
import fs.{fixtureDirs, fixtureFiles, mkdirAll}
import io.{runVerb}
import list.{dropWhile, reverse, somes, sort}
import path.{basename, dirname, stem}
import string.{contains, endsWith, join, lines, split, startsWith, unlines}
import regex.{escape, mustCompile, isFullMatch}
import test.{Expectation, fail, pass}
import test_process.{
  boundedVerb, medakaBin, medakaRoot, scratchDir, spawnTimeoutSeconds
}

{- | What one fixture of a row's corpus IS, and where its expected value
   lives. The two questions are one constructor because the corpus shape
   decides both: a corpus of files keys its goldens off the fixture's stem,
   and a corpus of directories keys them off a fixed name inside the
   directory.

   - `FileStem` — the fixture is a `.mdk` file in the corpus root, graded
     against a sibling `<stem>.eval.golden` holding the whole value.
   - `FileSection` — the same file shape, graded against the `=== EVAL ===`
     section of a sibling `<stem>.golden`: the multi-stage golden
     `test/diff_fixtures` shares with the parse, lex and typecheck gates.
   - `DirFixture entry golden` — the fixture is a whole DIRECTORY of modules
     under the corpus root. `entry` names the root module inside it, either
     literally or as a single-`*` glob over the basename; `golden` is a file
     name inside that same directory, unrelated to the entry's stem. A
     directory-shaped row also spawns its oracle with the fixture's own
     directory as a trailing argument, which is how the loader resolves the
     entry's sibling imports. -}
data Shape = FileStem | FileSection | DirFixture String String

{- | One retired gate: an oracle, a corpus, and how to read the two apart.

   `oracle` and `prelude` are spelled repo-relative and interpolated onto
   `medakaRoot` at spawn time. The `test/bin/<name>` spelling is load-bearing
   beyond readability: `test/build_oracles.sh --for` derives which oracles a
   gate needs by grepping the gate's own source for that literal, so an
   oracle assembled from fragments would be invisible to it and the gate
   would run against a stale or missing binary. -}
data Row = Row {
  gate : String,
  oracle : String,
  corpus : String,
  prelude : List String,
  shape : Shape,
  batched : Bool,
  fixtures : Int,
}

coreMod : String
coreMod = "stdlib/core.mdk"

listMod : String
listMod = "stdlib/list.mdk"

runtimeMod : String
runtimeMod = "stdlib/runtime.mdk"

-- | Named once because two things spawn it: the corpus row below, and the
-- FFI engine-wall probes at the foot of this file.
coreIrModulesOracle : String
coreIrModulesOracle = "test/bin/core_ir_modules_main"

rows : List Row
rows = [
  Row {
    gate = "diff_compiler_eval",
    oracle = "test/bin/eval_main",
    corpus = "test/eval_fixtures",
    prelude = [],
    shape = FileStem,
    batched = False,
    fixtures = 24,
  },
  Row {
    gate = "diff_compiler_core_ir",
    oracle = "test/bin/core_ir_main",
    corpus = "test/eval_fixtures",
    prelude = [],
    shape = FileStem,
    batched = False,
    fixtures = 24,
  },
  Row {
    gate = "diff_compiler_core_ir_roundtrip",
    oracle = "test/bin/core_ir_roundtrip_main",
    corpus = "test/eval_fixtures",
    prelude = [],
    shape = FileStem,
    batched = False,
    fixtures = 24,
  },
  Row {
    gate = "diff_compiler_eval_list",
    oracle = "test/bin/eval_prelude_main",
    corpus = "test/eval_list_fixtures",
    prelude = [coreMod, listMod],
    shape = FileStem,
    batched = False,
    fixtures = 1,
  },
  Row {
    gate = "diff_compiler_eval_list_batch",
    oracle = "test/bin/eval_list_batch",
    corpus = "test/eval_list_fixtures",
    prelude = [coreMod, listMod],
    shape = FileStem,
    batched = True,
    fixtures = 1,
  },
  Row {
    gate = "diff_compiler_core_ir_list",
    oracle = "test/bin/core_ir_prelude_main",
    corpus = "test/eval_list_fixtures",
    prelude = [coreMod, listMod],
    shape = FileStem,
    batched = False,
    fixtures = 1,
  },
  Row {
    gate = "diff_compiler_eval_prelude",
    oracle = "test/bin/eval_prelude_main",
    corpus = "test/eval_prelude_fixtures",
    prelude = [coreMod],
    shape = FileStem,
    batched = False,
    fixtures = 6,
  },
  Row {
    gate = "diff_compiler_eval_prelude_batch",
    oracle = "test/bin/eval_prelude_batch",
    corpus = "test/eval_prelude_fixtures",
    prelude = [coreMod],
    shape = FileStem,
    batched = True,
    fixtures = 6,
  },
  Row {
    gate = "diff_compiler_core_ir_prelude",
    oracle = "test/bin/core_ir_prelude_main",
    corpus = "test/eval_prelude_fixtures",
    prelude = [coreMod],
    shape = FileStem,
    batched = False,
    fixtures = 6,
  },
  Row {
    gate = "diff_compiler_eval_run",
    oracle = "test/bin/eval_run_main",
    corpus = "test/diff_fixtures",
    prelude = [coreMod, listMod],
    shape = FileSection,
    batched = False,
    fixtures = 54,
  },
  Row {
    gate = "diff_compiler_eval_run_batch",
    oracle = "test/bin/eval_run_batch",
    corpus = "test/diff_fixtures",
    prelude = [coreMod, listMod],
    shape = FileSection,
    batched = True,
    fixtures = 54,
  },
  Row {
    gate = "diff_compiler_core_ir_run",
    oracle = "test/bin/core_ir_run_main",
    corpus = "test/diff_fixtures",
    prelude = [coreMod, listMod],
    shape = FileSection,
    batched = False,
    fixtures = 54,
  },
  Row {
    gate = "diff_compiler_core_ir_typed",
    oracle = "test/bin/core_ir_typed_main",
    corpus = "test/eval_typed_fixtures",
    prelude = [runtimeMod, coreMod],
    shape = FileStem,
    batched = False,
    fixtures = 12,
  },
  Row {
    gate = "diff_compiler_eval_typed_batch",
    oracle = "test/bin/eval_typed_batch",
    corpus = "test/eval_typed_fixtures",
    prelude = [runtimeMod, coreMod],
