{- | Per-verb stage-call pins: how many times each pipeline stage runs for one
   run of `check`, `check --json`, `run`, `build`, `test` and `lint`.

   Each probe spawns the built `medaka` with MEDAKA_STAGE_COUNTS=1 and reads
   the `[stage]` lines `stageDump` (compiler/support/stage_count.mdk) writes to
   stderr. A row is `<probe>.<key>` and its count. A stage that runs a second
   time raises its count and fails the golden, and a count may fall only by
   rewriting `test/arch_goldens/stage_counts.golden` with `ARCH_PINS_WRITE=1`.

   `build` runs its front end and typecheck in the `medaka_emitter` child
   (compiler/entries/llvm_emit_modules_main.mdk), which counts and dumps its own
   stages; the parent forwards that stderr, and the `build_*` rows are the SUM
   by key of both processes' `[stage]` lines.

   `probeRows` pins a probe that must exit 0; `probeRowsExit` names the exit
   code it must meet. Every process exit goes through `stageExit`
   (compiler/support/stage_count.mdk), so an error exit prints its counts too.

   The `lsp.` rows each feed one `medaka lsp` process a framed transcript
   ending `shutdown` then `exit`. Their frames are built here because
   compiler/tools/lsp_harness.mdk is not importable from a test project.
   `lsp.d_hover.parse.positions` 1 and its extra `lex.offsets` are the
   current value of the open hover second parse (#4148, hover/completion second
   parse), not a minimum.

   `typecheck.module` counts the typechecker's per-module entries, the prelude
   (core) included, so it is not a count of user modules. `typecheck.drive`
   counts whole-graph typecheck drives. Every count here is a pinned value that
   may only fall, and only by re-capturing with `ARCH_PINS_WRITE=1`; the issue
   that owns a duplicate drive is named beside its probe. Counts above 1 for
   `desugar`, `parse.prescan` and `exhaust.oracle` are pinned values, not a
   claim that they are the minimum. `lint`'s 50 parses are 49 stdlib-index
   parses plus 1 per file: a constant that moves when the stdlib module set
   changes, not a duplicate. -}
import json.{Json(..), jArray, jObject, stringify}
import list.{filterMap, nub, sort}
import string.{
  byteLength, contains, lines, split, startsWith, toInt, unlines, words
}
import test.{
  Expectation,
  expectAll,
  expectEqual,
  expectFalse,
  expectGolden,
  expectTrue,
  fail,
  pass,
}
import test_process.{
  boundedVerbSeconds, medakaBin, spawnTimeoutSeconds, underRoot, withScratchDir
}

fixture : String -> <Env "MEDAKA_ROOT"> String
fixture rel = underRoot "test/stage_count_fixtures/\{rel}"

-- Spawns `medaka <args>` with counting on: (exit code, stdout, stderr), or the
-- spawn error as exit -1.
spawnCounted : List String ->
  <Exec, Env "MEDAKA_ROOT", Env "MEDAKA"> (Int, String, String)
spawnCounted args =
  let spawned =
    boundedVerbSeconds
      (spawnTimeoutSeconds * 3)
      "env"
      (["MEDAKA_STAGE_COUNTS=1", medakaBin] ++ args)
  spawnResult spawned

-- A spawn error becomes exit -1 with the error as stderr.
spawnResult : Result String (Int, String, String) -> (Int, String, String)
spawnResult (Ok r) = r
spawnResult (Err e) = (-1, "", e)

-- The `<key>\t<n>` pairs of every `[stage]` line on stderr.
stageLines : String -> List (String, String)
stageLines err =
  filterMap
    (l => match split "\t" l
      ["[stage]", k, n] => Some (k, n)
      _ => None)
    (lines err)

-- `<prefix>.exit` plus one `<prefix>.<key>\t<n>` row per `[stage]` line of `err`,
-- summing repeated keys (the parent and the emitter child both dump).
rowsOf : String -> Int -> String -> List String
rowsOf prefix code err =
  ["\{prefix}.exit\t\{code}"]
    ++ map ((k, n) => "\{prefix}.\{k}\t\{n}") (sumByKey (stageLines err))

sumByKey : List (String, String) -> List (String, String)
sumByKey pairs =
  map
    (k => (k, debug (sum (filterMap (p => countFor k p) pairs))))
    (sort (nub (map fst pairs)))

countFor : String -> (String, String) -> Option Int
countFor k (k2, n) = if k == k2 then toInt n else None

-- Rows `<probe>.<key>\t<n>` for one spawn, plus its exit code and whether
-- stdout stayed free of `[stage]` lines.
probeRows : String ->
  List String ->
  <Exec, Env "MEDAKA_ROOT", Env "MEDAKA"> (List String, Expectation)
probeRows name args = probeRowsExit name 0 args

-- `probeRows` for a probe that must exit `want`.
probeRowsExit : String ->
  Int ->
  List String ->
  <Exec, Env "MEDAKA_ROOT", Env "MEDAKA"> (List String, Expectation)
probeRowsExit name want args =
  let (code, out, err) = spawnCounted args
  let rows = rowsOf name code err
  let clean = expectAll [
    expectFalse (contains "[stage]" out),
    if code == want then
      pass
    else
      fail "\{name} exited \{code}, want \{want}: \{err}",
  ]
  (rows, clean)

-- One Content-Length-framed JSON-RPC message.
frame : Json -> String
frame j =
  let body = stringify j
  "Content-Length: \{byteLength body}\r\n\r\n\{body}"

rpc : String -> List (String, Json) -> Json
rpc method fields =
  jObject ([("jsonrpc", JString "2.0"), ("method", JString method)] ++ fields)

initializeMsg : Json
initializeMsg = rpc "initialize" [
  ("id", JInt 1),
  ("params", jObject [("capabilities", jObject [])]),
]

initializedMsg : Json
initializedMsg = rpc "initialized" [("params", jObject [])]

didOpenMsg : String -> String -> Json
didOpenMsg uri text = rpc "textDocument/didOpen" [
  (
    "params",
    jObject [
      (
        "textDocument",
        jObject [
          ("uri", JString uri),
          ("languageId", JString "medaka"),
          ("version", JInt 1),
          ("text", JString text),
        ],
      ),
    ],
  ),
]

didChangeMsg : String -> String -> Json
didChangeMsg uri text = rpc "textDocument/didChange" [
  (
    "params",
    jObject [
      ("textDocument", jObject [("uri", JString uri), ("version", JInt 2)]),
      ("contentChanges", jArray [jObject [("text", JString text)]]),
    ],
  ),
]

-- A position request (`references`, `hover`) at line/character of `uri`.
posRequest : Int -> String -> String -> Int -> Int -> Json
posRequest idn method uri line ch = rpc method [
  ("id", JInt idn),
  (
    "params",
    jObject [
      ("textDocument", jObject [("uri", JString uri)]),
      ("position", jObject [("line", JInt line), ("character", JInt ch)]),
      ("context", jObject [("includeDeclaration", JBool True)]),
    ],
  ),
]

shutdownMsg : Json
shutdownMsg = rpc "shutdown" [("id", JInt 99)]

exitMsg : Json
exitMsg = rpc "exit" []

-- Runs `medaka lsp` over the framed `msgs` with counting on and reports it like
-- `probeRows`, rows prefixed `lsp.<name>`.
lspRows : String ->
  String ->
  String ->
  List Json ->
  <Exec, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> (List String, Expectation)
lspRows dir name want msgs =
  let req = "\{dir}/\{name}.req"
  let _ = writeFile req (stringConcat (map frame msgs))
  let spawned = boundedVerbSeconds (spawnTimeoutSeconds * 3) "sh" [
    "-c",
    "MEDAKA_STAGE_COUNTS=1 \{medakaBin} lsp < \{req}",
  ]
  let (code, out, err) = spawnResult spawned
  let rows = rowsOf "lsp.\{name}" code err
  let clean = expectAll [
    expectFalse (contains "[stage]" out),
    if contains want out then
      pass
    else
      fail "lsp.\{name}: no `\{want}` in reply",
    if code == 0 then pass else fail "lsp.\{name} exited \{code}: \{err}",
  ]
  (rows, clean)

readText : String -> <FileRead> String
readText path = match readFile path
  Ok t => t
  Err _ => ""

uriOf : String -> <Env "MEDAKA_ROOT"> String
uriOf rel = "file://\{fixture rel}"

lspProbes : String ->
  <Exec, FileRead, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> List (List String, Expectation)
lspProbes dir =
  let mainRel = "lsp_project/main.mdk"
  let mainUri = uriOf mainRel
  let mainText = readText (fixture mainRel)
  let open = [initializeMsg, initializedMsg, didOpenMsg mainUri mainText]
  -- `level1` on line 9 of lsp_project/main.mdk (0-based), column 8.
  let refs = posRequest 2 "textDocument/references" mainUri 9 8
  let tail = [shutdownMsg, exitMsg]
  let sibRel = "lsp_project/m6.mdk"
  let sibUri = uriOf sibRel
  let sibText = readText (fixture sibRel)
  [
    lspRows dir "a_references" "m1.mdk" (open ++ [refs] ++ tail),
    lspRows
      dir
      "b_references_twice"
      "m1.mdk"
      (open
        ++ [refs, posRequest 3 "textDocument/references" mainUri 9 8]
        ++ tail),
    lspRows
      dir
      "c_didchange"
      "publishDiagnostics"
      ([initializeMsg, initializedMsg, didOpenMsg sibUri sibText]
        ++ map
          (n => didChangeMsg sibUri (sibText ++ "-- edit \{n}\n"))
          [1, 2, 3]
        ++ tail),
    lspRows
      dir
      "d_hover"
      "Int"
      ([initializeMsg, initializedMsg, didOpenMsg sibUri sibText]
        ++ [posRequest 2 "textDocument/hover" sibUri 4 9]
        ++ tail),
  ]

-- `repl` fed `1 + 2` on stdin, counting on. Spawned through `sh` for the
-- redirect, as `lspRows` does.
replRows : String ->
  <Exec, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> (List String, Expectation)
replRows dir =
  let inp = "\{dir}/repl_one_line.in"
  let _ = writeFile inp "1 + 2\n"
  let spawned = boundedVerbSeconds (spawnTimeoutSeconds * 3) "sh" [
    "-c",
    "MEDAKA_STAGE_COUNTS=1 \{medakaBin} repl < \{inp}",
  ]
  let (code, out, err) = spawnResult spawned
  let rows = rowsOf "repl_one_line" code err
  let clean = expectAll [
    expectFalse (contains "[stage]" out),
    if code == 0 then pass else fail "repl_one_line exited \{code}: \{err}",
  ]
  (rows, clean)

-- Probes for the duplicate and extra drives. Each count is a pinned value; the
-- issue named beside a probe owns the drive, so its removal shows as a fall in
-- the golden.
driveProbes : String ->
  <Exec, FileWrite, Env "MEDAKA_ROOT", Env "MEDAKA"> List (List String, Expectation)
driveProbes dir = [
  -- #4151 value-main extra drives
  probeRows "check_vm" ["check", fixture "vm.mdk"],
  probeRows "run_vm" ["run", fixture "vm.mdk"],
  probeRows "build_vm" ["build", fixture "vm.mdk", "-o", "\{dir}/vm"],
  probeRows "check_vmm" ["check", fixture "vmm/main.mdk"],
  probeRows "run_vmm" ["run", fixture "vmm/main.mdk"],
  probeRows "build_vmm" ["build", fixture "vmm/main.mdk", "-o", "\{dir}/vmm"],
  -- #4154 check --target re-elaboration
  probeRows
    "check_target_three"
    [
      "check",
      "--target",
      "wasmgc/edge",
      fixture "three_mod/main.mdk",
    ],
  -- #2874 build --json double check
  probeRows
    "build_json_hello"
    [
      "build",
      "--json",
      fixture "hello.mdk",
      "-o",
      "\{dir}/hj",
    ],
  -- #4152 REPL three drives
  replRows dir,
  -- the test engine drives the doctest-injected program as a second graph
  probeRows "test_doc_eval" ["test", "--engines", "eval", fixture "doc.mdk"],
  probeRows "test_docimp_eval" [
    "test",
    "--engines",
    "eval",
    fixture "docimp.mdk",
  ],
]

test "stage_counts: per-verb stage counts match stage_counts.golden" = withScratchDir
  (dir =>
    let probes = [
      probeRows "check_hello" ["check", fixture "hello.mdk"],
      probeRows "check_three_mod" ["check", fixture "three_mod/main.mdk"],
      probeRows "check_json_three_mod" [
        "check",
        "--json",
        fixture "three_mod/main.mdk",
      ],
      probeRows "run_hello" ["run", fixture "hello.mdk"],
      probeRows "build_hello" ["build", fixture "hello.mdk", "-o", "\{dir}/h"],
      probeRows "test_probe" ["test", fixture "test_probe.mdk"],
      probeRows "lint_probe" ["lint", fixture "lint_probe.mdk"],
      probeRowsExit "check_bad" 1 ["check", fixture "bad.mdk"],
      probeRowsExit "run_bad" 1 ["run", fixture "bad.mdk"],
      probeRowsExit "build_bad" 1 ["build", fixture "bad.mdk", "-o", "\{dir}/b"],
    ]
    let allProbes = probes ++ driveProbes dir ++ lspProbes dir
    let rows = flatMap fst allProbes
    let golden = underRoot "test/arch_goldens/stage_counts.golden"
    expectAll (map snd allProbes ++ [pinRows golden rows]))

pinRows : String ->
  List String ->
  <FileRead, FileWrite, Env "ARCH_PINS_WRITE"> Expectation
pinRows path rows = match getEnv "ARCH_PINS_WRITE"
  Some "1" => match writeFile path (unlines rows)
    Ok _ => pass
    Err e => fail "could not write \{path}: \{e}"
  _ => expectGolden path (unlines rows)

-- Structural pin: no code line of the two drivers calls `exit` directly, so
-- every process exit prints the stage dump through `stageExit`.
test "stage_counts: no raw exit in the drivers" = expectAll [
  rawExitsIn "compiler/driver/medaka_cli.mdk",
  rawExitsIn "compiler/entries/entry_support.mdk",
]

rawExitsIn : String -> <FileRead, Env "MEDAKA_ROOT"> Expectation
rawExitsIn rel = match readFile (underRoot rel)
  Ok src => expectEqual [] (filter rawExitLine (lines src))
  Err _ => fail "could not read \{rel}"

-- True for a line that calls `exit` outside a string literal and outside a
-- `--` comment line.
rawExitLine : String -> Bool
rawExitLine line =
  not (isCommentLine line) && exitCallIn (tokensOf (codeOf line))

isCommentLine : String -> Bool
isCommentLine line = match words line
  w :: _ => startsWith "--" w
  [] => False

-- The text of `line` outside its string literals, each literal a space. An
-- escaped quote is removed first, so it neither opens nor closes a literal.
codeOf : String -> String
codeOf line =
  stringConcat
    (map
      (s => " \{s} ")
      (everyOther True (split "\"" (stringConcat (split "\\\"" line)))))

-- The even-indexed segments of a `"`-split line: the text outside literals.
everyOther : Bool -> List String -> List String
everyOther _ [] = []
everyOther True (s :: rest) = s :: everyOther False rest
everyOther False (_ :: rest) = everyOther True rest

tokensOf : String -> List String
tokensOf code = words (stringConcat (map (++ " ") (split "(" code)))

argStarts : String
argStarts = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

-- `exit` followed by an argument starting with a letter, digit or `_`: the
-- raw call `\bexit [0-9a-zA-Z]`.
exitCallIn : List String -> Bool
exitCallIn [] = False
exitCallIn ("exit" :: arg :: rest) =
  contains (stringSlice 0 1 arg) argStarts || exitCallIn (arg :: rest)
exitCallIn (_ :: rest) = exitCallIn rest

-- Spawns `medaka <args>` with `extraEnv` assignments and without stage
-- counting, so stdout and stderr are the verb's own bytes.
spawnPlain : List String ->
  List String ->
  <Exec, Env "MEDAKA_ROOT", Env "MEDAKA"> (Int, String, String)
spawnPlain extraEnv args =
  spawnResult
    (boundedVerbSeconds
      (spawnTimeoutSeconds * 3)
      "env"
      (extraEnv ++ [medakaBin] ++ args))

-- `build` refuses a compiler-private import in the emitter child's gate; the
-- diagnostic reaches the user on both routes, and a `MEDAKA_DIAG_JSON` inherited
-- from the caller's environment does not redirect it.
test "stage_counts: build refuses a private import on every route" = withScratchDir
  (dir =>
    let entry = fixture "private_import.mdk"
    let (plainCode, plainOut, plainErr) =
      spawnPlain [] ["build", entry, "-o", "\{dir}/p"]
    let (jsonCode, jsonOut, jsonErr) =
      spawnPlain [] ["build", "--json", entry, "-o", "\{dir}/j"]
    let (strayCode, _, strayErr) =
      spawnPlain
        ["MEDAKA_DIAG_JSON=\{dir}/stray.json"]
        ["build", entry, "-o", "\{dir}/s"]
    expectAll [
      expectEqual 1 plainCode,
      expectTrue (contains "unknown module: support.path" plainErr),
      expectEqual "" plainOut,
      expectEqual 1 jsonCode,
      expectTrue (contains "unknown module: support.path" jsonOut),
      expectEqual "" jsonErr,
      expectEqual 1 strayCode,
      expectTrue (contains "unknown module: support.path" strayErr),
    ])
