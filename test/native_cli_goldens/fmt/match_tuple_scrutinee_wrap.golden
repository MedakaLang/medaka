-- #932: a match SCRUTINEE that would otherwise wrap across lines (long
-- tuple, long non-tuple expr) is kept FLAT instead — wrapping it is
-- layout-UNSAFE (the lexer's `match` opener flag stays armed through any
-- bracket the scrutinee opens, so the first newline the wrap would emit is
-- misread as arming the ARMS block, and the parser then rejects fmt's own
-- output). A SHORT function head (so the column is still low when the
-- scrutinee's own Doc group is measured) with a long enough tuple/expr to
-- force a would-be wrap. Covers 2/3/4/5-tuples, a nested tuple, and a
-- non-tuple long expr.
f2 a b = match (
  aVeryLongNameForATupleElementNumberOneHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
  aVeryLongNameForATupleElementNumberTwoHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
)
  (x, y) => x

f3 a b c = match (
  aVeryLongNameForATupleElementNumberOneHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
  aVeryLongNameForATupleElementNumberTwoHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
  aVeryLongNameForATupleElementNumberThreeHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
)
  (x, y, z) => x

f4 a b c d = match (
  someVeryLongParameterNameHereOne,
  someVeryLongParameterNameHereTwo,
  someVeryLongParameterNameHereThree,
  someVeryLongParameterNameHereFour,
)
  (w, x, y, z) => w

f5 p1 p2 p3 p4 p5 = match (
  p1,
  p2,
  p3,
  p4,
  p5,
  p1,
  p2,
  p3,
  p4,
  p5,
  p1,
  p2,
  p3,
  p4,
  p5,
  p1,
  p2,
  p3,
  p4,
  p5,
  p1,
  p2,
  p3,
  p4,
  p5,
  p1,
  p2,
  p3,
  p4,
  p5,
)
  (a, b, c, d, e, g, h, i, j, k, l, m, n, o, q, r, s, t, u, v, w, x, y, aa, bb, cc, dd, ee, ff, gg) =>
    a

fNested a b = match (
  (
    aVeryLongNameForATupleElementNumberOneHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
    aVeryLongNameForATupleElementNumberTwoHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
  ),
  aVeryLongNameForATupleElementNumberOneHereXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,
)
  ((x, y), z) => x

fNonTuple a =
  match (someVeryLongNameHereForANonTupleScrutineeExpressionThatWouldOtherwiseWrapAcrossLinesXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    + 1)
    n => n
