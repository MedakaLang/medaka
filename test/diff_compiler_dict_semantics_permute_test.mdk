{- | DICT-SEMANTICS section 4: DECLARATION-ORDER PERMUTATION. Replaces
   diff_compiler_dict_semantics_permute.sh (section 4 of that script only).

   For every fixture directly in test/dict_fixtures (*.mdk, no recursion) with
   >= 2 `impl` blocks of one interface, the top-level chunks tagged with that
   interface are reversed in place (every other declaration stays where it was),
   and the permuted source is graded against the original:
     * `check --json`: both accept, or both reject with the same diagnostic code
     * both accept: `run` exit + stdout and `build` + built-binary stdout match
     * both reject: `run` / `build` exit codes match (never stderr text: the
       permutation shifts every line number, so text would false-positive)
   An asymmetric outcome (one ordering accepts, the other rejects; one runs, the
   other does not) fails the row. Exit 126/127 is a launch failure, never a pass.

   Import order (SHADOW-SEMANTICS S2-DECL (e)): for every entry of every
   `admitted-set-*` directory fixture, the directory is copied to scratch with
   the top-level `import` / `export import` lines of each of its files that has
   two or more reversed in place (a re-export hub's two lines, an entry's own
   imports), and the copied entry is graded against the original the same way,
   except that two rejects need not share a code. Inference types an admitted
   occurrence against the first declaration in scope, so the code of a reject
   can follow import order (`admitted-set-decl-type-mismatch-rejected`); the
   verdict and every accepted value may not. The dict_semantics table pins each
   order's codes where they matter.

   PROVES: declaration order decides neither acceptance, the reject code, the
   runtime stdout, nor the built binary's stdout, over the corpus; import order
   over the admitted-set fixtures decides neither acceptance nor any stdout.
   DOES NOT PROVE: order-freedom on any axis this permuter does not move -- in
   particular the predicate order inside a signature or `requires` clause
   (#1177), which is not permuted, and import order outside the admitted-set
   directories. Nor that any answer is the right one (Section 1 pins values).

   Floor: the derived set keeps at least 135 (fixture, interface) rows and 24
   import-order entries. Fewer means the derivation (enumeration or
   qualifying-interface scan) broke; the floor catches that, not a change in
   which rows exist. Rows are graded in
   groups of `testJobs`: each group's spawns run as one batch, and each row
   works in a scratch directory of its own, removed once its group is graded.
   Under MEDAKA_TEST_JOBS=1 a group is one row, so its spawns run in the order
   they are listed. Needs clang (build).

   Usage: medaka test <this file>
-}

import compiler_cli_test_support.{
  finalOf, freshDirFor, labelGrades, okDir, spawnEach, stageRun
}
import fs.{fixtureFiles}
import io.{runVerb}
import list.{chunks, dropWhile, nub, somes, takeWhile}
import string.{contains, endsWith, lines, replaceAll, split, startsWith, trim}
import test.{
  Expectation, expectAll, expectAtLeast, expectEach, expectEqual, fail, pass
}
import test_process.{medakaBin, spawnTimeoutSeconds, testJobs, underRoot}

-- ── Permuter (pure; ports the script's perl PERMPL) ──────────────────────────

-- A top-level line starts in column 0 with a non-blank character. Anything
-- else (indented or blank) attaches to the chunk above it.
topLevel : String -> Bool
topLevel l = l /= "" && not (startsWith " " l) && not (startsWith "\t" l)

isBody : String -> Bool
isBody l = not (topLevel l)

-- Interface named by a top-level `impl X` / `export impl X` header, else "".
implIface : String -> String
implIface l = if topLevel l then wordsIface (split " " l) else ""

wordsIface : List String -> String
wordsIface [] = ""
wordsIface (w :: rest) =
  if w == "export" then implName rest else implName (w :: rest)

implName : List String -> String
implName ("impl" :: n :: _) = n
implName _ = ""

-- (interface, lines) per top-level chunk; "" interface for non-impl chunks.
topChunks : List String -> List (String, List String)
topChunks ls = topChunksBy implIface ls

-- (tag, lines) per top-level chunk, tagged by [tag] of its first line.
topChunksBy : (String -> String) -> List String -> List (String, List String)
topChunksBy _ [] = []
topChunksBy tag (l :: rest) =
  (tag l, l :: takeWhile isBody rest) :: topChunksBy tag (dropWhile isBody rest)

bodiesOf : String -> List (String, List String) -> List (List String)
bodiesOf _ [] = []
bodiesOf iface ((ifc, ls) :: rest) =
  if ifc == iface then ls :: bodiesOf iface rest else bodiesOf iface rest

-- Slot k of the tagged chunks receives the body of tagged chunk n-1-k.
placeAll : String ->
  List (List String) ->
  List (String, List String) ->
  List (String, List String)
placeAll _ _ [] = []
placeAll iface pending ((ifc, ls) :: rest) =
  if ifc /= iface then
    (ifc, ls) :: placeAll iface pending rest
  else
    placeTagged iface pending ifc ls rest

placeTagged : String ->
  List (List String) ->
  String ->
  List String ->
  List (String, List String) ->
  List (String, List String)
placeTagged iface (p :: ps) ifc _ rest = (ifc, p) :: placeAll iface ps rest
placeTagged iface [] ifc ls rest = (ifc, ls) :: placeAll iface [] rest

revList : List a -> List a
revList xs = revAcc xs []

revAcc : List a -> List a -> List a
revAcc [] acc = acc
revAcc (x :: rest) acc = revAcc rest (x :: acc)

flatten : List (String, List String) -> List String
flatten [] = []
flatten ((_, ls) :: rest) = ls ++ flatten rest

endEach : String -> List String -> String
endEach _ [] = ""
endEach sep (l :: rest) = l ++ sep ++ endEach sep rest

joinSemi : List String -> String
joinSemi [] = ""
joinSemi [r] = r
joinSemi (r :: rest) = "\{r}; \{joinSemi rest}"

permuteText : String -> String -> String
permuteText iface text = permuteChunks iface (topChunks (lines text))

permuteChunks : String -> List (String, List String) -> String
permuteChunks iface cs =
  endEach "\n" (flatten (placeAll iface (revList (bodiesOf iface cs)) cs))

-- A top-level `import` or `export import` line, tagged so its chunk is moved
-- as one.
importTag : String -> String
importTag l =
  if topLevel l
    && (startsWith "import " l || startsWith "export import " l) then
    "import"
  else
    ""

importCount : String -> Int
importCount text = length (filter (l => importTag l == "import") (lines text))

permuteImports : String -> String
permuteImports text =
  permuteChunks "import" (topChunksBy importTag (lines text))

-- Interfaces with >= 2 `impl` headers in one fixture (the script's PAIRS grep).
qualifying : String -> List String
qualifying text = qualifyingIn (lines text)

qualifyingIn : List String -> List String
qualifyingIn ls =
  filter
    (n => length (filter (l => implIface l == n) ls) >= 2)
    (nub (filter (/= "") (map implIface ls)))

pairsIn : String -> List String -> <FileRead> Result String (List Pair)
pairsIn _ [] = Ok []
pairsIn dir (f :: rest) = match readFile "\{dir}/\{f}"
  Err e => Err "could not read \{f}: \{e}"
  Ok t => map (withPairs f t) (pairsIn dir rest)

withPairs : String -> String -> List Pair -> List Pair
withPairs f t more = map (i => DeclPair f i) (qualifying t) ++ more

-- The `.mdk` files one level inside an `admitted-set-*` directory, relative to
-- the corpus.
admittedRels : String -> List String -> List String
admittedRels fixDir names =
  filter
    (r =>
      startsWith "admitted-set-" r
        && endsWith ".mdk" r
        && length (split "/" r) == 2)
    (map (p => replaceAll "\{fixDir}/" "" p) names)

-- One pair per entry (a file with a top-level `main`) of each directory.
importPairsIn : String -> List String -> <FileRead> Result String (List Pair)
importPairsIn fixDir rels =
  map
    (texts => flatMap (dirPairs texts) (nub (map dirPart rels)))
    (readAll fixDir rels)

readAll : String ->
  List String ->
  <FileRead> Result String (List (String, String))
readAll _ [] = Ok []
-- The section the rule suggests, `((r, t) ::)`, does not parse.
-- lint-disable-next-line rule-lambda-section
readAll fixDir (r :: rest) = match readFile "\{fixDir}/\{r}"
  Err e => Err "could not read \{r}: \{e}"
  Ok t => map (more => (r, t) :: more) (readAll fixDir rest)

dirPart : String -> String
dirPart r = match split "/" r
  d :: _ => d
  [] => r

filePart : String -> String
filePart r = match split "/" r
  [_, f] => f
  _ => r

dirPairs : List (String, String) -> String -> List Pair
dirPairs texts d =
  let files = somes (map (inDir d) texts)
  let reordered = somes (map reorderedFile files)
  map (f => ImportPair d f reordered) (somes (map entryName files))

inDir : String -> (String, String) -> Option (String, String)
inDir d (r, t) = if dirPart r == d then Some (filePart r, t) else None

reorderedFile : (String, String) -> Option (String, String)
reorderedFile (f, t) =
  if importCount t >= 2 then Some (f, permuteImports t) else None

entryName : (String, String) -> Option String
entryName (f, t) = if any (startsWith "main =") (lines t) then Some f else None

-- ── Verdicts (pure) ──────────────────────────────────────────────────────────

-- The first "code" of a `check --json` report, or "" (the script's grep | head -1).
codeOf : String -> String
codeOf s = match split "\"code\":\"" s
  _ :: r :: _ => codeEnd r
  _ => ""

codeEnd : String -> String
codeEnd r = match split "\"" r
  c :: _ => c
  _ => ""

-- Exit 126/127: the process never launched, so it cannot grade anything.
launchFail : Int -> Bool
launchFail code = code == 126 || code == 127

outcome : List String -> Expectation
outcome [] = pass
outcome rs = fail (joinSemi rs)

rejectReasons : String -> String -> List String
rejectReasons a b =
  if a == b then [] else ["reject code changed under permutation: \{a} -> \{b}"]

-- (verdict label, reasons) from the two `check --json` results.
-- [codes]: whether two rejects must share their first diagnostic code.
checkVerdict : Bool -> Int -> String -> Int -> String -> (String, List String)
checkVerdict codes oc ocode pc pcode =
  if launchFail oc || launchFail pc then
    (
      "LAUNCH",
      ["check could not launch (exit \{intToString oc}/\{intToString pc})"],
    )
  else if oc == 0 && pc == 0 then
    ("ACCEPT/ACCEPT", [])
  else if oc /= 0 && pc /= 0 then
    (
      "REJECT/REJECT",
      if codes then rejectReasons (codeOf ocode) (codeOf pcode) else [],
    )
  else
    ("DIVERGED", ["check verdict itself flipped under permutation"])

runReasons : Int -> String -> Int -> String -> List String
runReasons oc oo pc po =
  if launchFail oc || launchFail pc then
    ["run could not launch (exit \{intToString oc}/\{intToString pc})"]
  else if oc == 0 && pc == 0 then
    if oo == po then [] else ["run stdout differs under permutation"]
  else if oc /= 0 && pc /= 0 then
    if oc == pc then
      []
    else
      [
        "run fails on both orderings but with DIFFERENT exit codes: orig=\{intToString oc} perm=\{intToString pc}",
      ]
  else
    [
      "run exit code diverges under permutation: orig=\{intToString oc} perm=\{intToString pc} (order changed whether the program runs at all)",
    ]

-- oOk / pOk: build exited 0 AND produced an executable.
buildReasons : Int -> Int -> Bool -> Bool -> String -> String -> List String
buildReasons ob pb oOk pOk oo po =
  if launchFail ob || launchFail pb then
    ["build could not launch (exit \{intToString ob}/\{intToString pb})"]
  else if oOk && pOk then
    if oo == po then [] else ["build stdout differs under permutation"]
  else if not oOk && not pOk then
    if ob == pb then
      []
    else
      [
        "build fails on both orderings but with DIFFERENT exit codes: orig=\{intToString ob} perm=\{intToString pb}",
      ]
  else
    [
      "build exit code (or missing binary) diverges under permutation: orig=\{intToString ob}(ok=\{boolText oOk}) perm=\{intToString pb}(ok=\{boolText pOk})",
    ]

boolText : Bool -> String
boolText b = if b then "1" else "0"

-- Per-row state, carried from stage to stage. Each record holds what the
-- stages before it observed, so every message is graded from its own spawn.
data Row = Row {
  rowDir : String,
  rowOrig : String,
  rowPerm : String,
  rowCodes : Bool,
}

data RunRec = RunRec {
  runRow : Row,
  runOrc : Int,
  runOro : String,
  runPrc : Int,
  runPro : String,
}

data BuildRec = BuildRec { buildRun : RunRec, buildOb : Int, buildPb : Int }

data TestRec = TestRec { testBuild : BuildRec, testOxc : Int, testPxc : Int }

origBinOf : Row -> String
origBinOf r = "\{r.rowDir}/orig.bin"

permBinOf : Row -> String
permBinOf r = "\{r.rowDir}/perm.bin"

-- The stdout of one built binary: a launch failure is an `Err`, as before.
binOutOf : Result String (Int, String, String) -> Result String String
binOutOf (Err e) = Err e
binOutOf (Ok (code, out, _)) =
  if launchFail code then
    Err "built binary could not launch (exit \{intToString code})"
  else
    Ok out

-- Stage 1: `check --json` on both orderings. Only ACCEPT/ACCEPT goes on.
checkSpawns : String -> Row -> List (String, List String)
checkSpawns bin r =
  [(bin, ["check", "--json", r.rowOrig]), (bin, ["check", "--json", r.rowPerm])]

gradeCheck : Row ->
  List (Result String (Int, String, String)) ->
  Result Expectation Row
gradeCheck r [oR, pR] = match oR
  Err e => Err (fail "could not spawn check on \{r.rowOrig}: \{e}")
  Ok (oCode, oo, oe) =>
    if launchFail oCode then
      Err
        (fail
          "check could not launch on \{r.rowOrig}: exit \{intToString oCode}")
    else match pR
      Err e => Err (fail "could not spawn check on \{r.rowPerm}: \{e}")
      Ok (pCode, po, pe) =>
        if launchFail pCode then
          Err
            (fail
              "check could not launch on \{r.rowPerm}: exit \{intToString pCode}")
        else
          verdictGate
            r
            (checkVerdict r.rowCodes oCode (oo ++ oe) pCode (po ++ pe))
gradeCheck _ _ =
  Err (fail "internal: a row was not answered by its two check spawns")

verdictGate : Row -> (String, List String) -> Result Expectation Row
verdictGate r (label, reasons) =
  if label == "ACCEPT/ACCEPT" then Ok r else Err (outcome reasons)

-- Stage 2: `run` on both orderings.
runSpawns : String -> Row -> List (String, List String)
runSpawns bin r = [(bin, ["run", r.rowOrig]), (bin, ["run", r.rowPerm])]

gradeRun : Row ->
  List (Result String (Int, String, String)) ->
  Result Expectation RunRec
gradeRun r [oR, pR] = match oR
  Err e => Err (fail "could not spawn run on \{r.rowOrig}: \{e}")
  Ok (oCode, oo, _) =>
    if launchFail oCode then
      Err
        (fail "run could not launch on \{r.rowOrig}: exit \{intToString oCode}")
    else match pR
      Err e => Err (fail "could not spawn run on \{r.rowPerm}: \{e}")
      Ok (pCode, po, _) =>
        if launchFail pCode then
          Err
            (fail
              "run could not launch on \{r.rowPerm}: exit \{intToString pCode}")
        else
          Ok RunRec {
            runRow = r,
            runOrc = oCode,
            runOro = oo,
            runPrc = pCode,
            runPro = po,
          }
gradeRun _ _ =
  Err (fail "internal: a row was not answered by its two run spawns")

-- Stage 3: `build` both orderings, each to its own binary.
buildSpawns : String -> RunRec -> List (String, List String)
buildSpawns bin s =
  let r = s.runRow
  [
    (bin, ["build", r.rowOrig, "-o", origBinOf r]),
    (bin, ["build", r.rowPerm, "-o", permBinOf r]),
  ]

gradeBuild : RunRec ->
  List (Result String (Int, String, String)) ->
  Result Expectation BuildRec
gradeBuild s [oR, pR] =
  let r = s.runRow
  match oR
    Err e => Err (fail "could not spawn build on \{r.rowOrig}: \{e}")
    Ok (oCode, _, _) =>
      if launchFail oCode then
        Err
          (fail
            "build could not launch on \{r.rowOrig}: exit \{intToString oCode}")
      else match pR
        Err e => Err (fail "could not spawn build on \{r.rowPerm}: \{e}")
        Ok (pCode, _, _) =>
          if launchFail pCode then
            Err
              (fail
                "build could not launch on \{r.rowPerm}: exit \{intToString pCode}")
          else
            Ok BuildRec { buildRun = s, buildOb = oCode, buildPb = pCode }
gradeBuild _ _ =
  Err (fail "internal: a row was not answered by its two build spawns")

-- Stage 4: `test -x` on both built binaries, whatever their build exit codes.
testSpawns : BuildRec -> List (String, List String)
testSpawns b =
  let r = b.buildRun.runRow
  [
    ("sh", ["-c", "test -x \"$1\"", "x", origBinOf r]),
    ("sh", ["-c", "test -x \"$1\"", "x", permBinOf r]),
  ]

gradeTest : BuildRec ->
  List (Result String (Int, String, String)) ->
  Result Expectation TestRec
gradeTest b [oR, pR] =
  let r = b.buildRun.runRow
  match oR
    Err e => Err (fail "could not test -x \{origBinOf r}: \{e}")
    Ok (oCode, _, _) =>
      if launchFail oCode then
        Err
          (fail
            "test -x could not launch on \{origBinOf r}: exit \{intToString oCode}")
      else match pR
        Err e => Err (fail "could not test -x \{permBinOf r}: \{e}")
        Ok (pCode, _, _) =>
          if launchFail pCode then
            Err
              (fail
                "test -x could not launch on \{permBinOf r}: exit \{intToString pCode}")
          else
            Ok TestRec { testBuild = b, testOxc = oCode, testPxc = pCode }
gradeTest _ _ =
  Err (fail "internal: a row was not answered by its two test -x spawns")

-- Stage 5: the built binaries' stdout, only when both builds and both `test -x`
-- checks passed. Otherwise there is no binary to run, and nothing is spawned.
bothBuilt : TestRec -> Bool
bothBuilt t =
  t.testBuild.buildOb == 0
    && t.testOxc == 0
    && t.testBuild.buildPb == 0
    && t.testPxc == 0

binSpawns : TestRec -> List (String, List String)
binSpawns t =
  if bothBuilt t then
    let r = t.testBuild.buildRun.runRow
    [(origBinOf r, []), (permBinOf r, [])]
  else
    []

-- With no binary to run (`binSpawns` named none), the build verdict alone is
-- graded. Any other answer count is a failure row, never that same grading.
gradeBins : TestRec ->
  List (Result String (Int, String, String)) ->
  Result Expectation Expectation
gradeBins t [oR, pR] = finishBins t (binOutOf oR) (binOutOf pR)
gradeBins t [] =
  if bothBuilt t then
    Err (fail "internal: two built binaries were named but none was answered")
  else
    finishBins t (Ok "") (Ok "")
gradeBins _ _ =
  Err (fail "internal: a row was not answered by its two binary spawns")

finishBins : TestRec ->
  Result String String ->
  Result String String ->
  Result Expectation Expectation
finishBins t (Err e) _ = Err (fail "could not run a built binary: \{e}")
finishBins t (Ok oo) (Err e) = Err (fail "could not run a built binary: \{e}")
finishBins t (Ok oo) (Ok po) =
  let b = t.testBuild
  let rs = b.buildRun
  let oOk = b.buildOb == 0 && t.testOxc == 0
  let pOk = b.buildPb == 0 && t.testPxc == 0
  let runRs = runReasons rs.runOrc rs.runOro rs.runPrc rs.runPro
  Ok (outcome (runRs ++ buildReasons b.buildOb b.buildPb oOk pOk oo po))

-- The five stages of one batch of rows, each stage run over every row still
-- standing. A stage's spawns run as one batch, so a group's `check`s all
-- start before its first `run`.
runGroup : String ->
  List (Result Expectation Row) ->
  <Exec, FileRead, IO> List Expectation
runGroup bin rows =
  let s1 =
    stageRun
      (spawnEach spawnTimeoutSeconds (checkSpawns bin))
      fail
      gradeCheck
      rows
  let s2 =
    stageRun (spawnEach spawnTimeoutSeconds (runSpawns bin)) fail gradeRun s1
  let s3 =
    stageRun
      (spawnEach spawnTimeoutSeconds (buildSpawns bin))
      fail
      gradeBuild
      s2
  let s4 = stageRun (spawnEach spawnTimeoutSeconds testSpawns) fail gradeTest s3
  let s5 = stageRun (spawnEach spawnTimeoutSeconds binSpawns) fail gradeBins s4
  map finalOf s5

-- One graded pair: a fixture file with one interface's impl blocks reversed,
-- or an admitted-set directory entry with its imports reversed (the directory
-- and the entry in it, and the reordered text of each file that changes).
data Pair =
  | DeclPair String String
  | ImportPair String String (List (String, String))

rowLabel : Pair -> String
rowLabel (DeclPair f iface) = "\{f} [\{iface}]"
rowLabel (ImportPair d e _) = "\{d}/\{e} [import order]"

prepRow : String ->
  Pair ->
  Result String String ->
  <Exec, IO, FileRead, FileWrite> Result Expectation Row
prepRow _ _ (Err e) = Err (fail "could not make a scratch directory: \{e}")
prepRow _ (ImportPair d _ []) (Ok _) =
  Err (fail "\{d}: no file has two or more imports to reorder")
prepRow fixDir (ImportPair d e texts) (Ok dir) =
  match runVerb "cp" ["-R", "\{fixDir}/\{d}/.", dir]
    Err err => Err (fail "could not copy \{d}: \{err}")
    Ok (0, _, _) => match writeAll dir texts
      Err err => Err (fail err)
      Ok _ => Ok Row {
        rowDir = dir,
        rowOrig = "\{fixDir}/\{d}/\{e}",
        rowPerm = "\{dir}/\{e}",
        rowCodes = False,
      }
    Ok (code, _, err) =>
      Err (fail "cp -R \{d} exited \{intToString code}: \{err}")
prepRow fixDir (DeclPair f iface) (Ok dir) =
  let origPath = "\{fixDir}/\{f}"
  let permPath = "\{dir}/\{f}__\{iface}_perm.mdk"
  match readFile origPath
    Err e => Err (fail "could not read \{origPath}: \{e}")
    Ok text => match writeFile permPath (permuteText iface text)
      Err e => Err (fail "could not write \{permPath}: \{e}")
      Ok _ => Ok Row {
        rowDir = dir,
        rowOrig = origPath,
        rowPerm = permPath,
        rowCodes = True,
      }

writeAll : String -> List (String, String) -> <FileWrite> Result String Unit
writeAll _ [] = Ok ()
writeAll dir ((f, t) :: rest) = match writeFile "\{dir}/\{f}" t
  Err e => Err "could not write \{dir}/\{f}: \{e}"
  Ok _ => writeAll dir rest

-- One `testJobs`-wide group of pairs: every row prepared, every stage run over
-- the group, then the group's scratch directories removed. Under
-- MEDAKA_TEST_JOBS=1 this is one row at a time, spawning in serial order.
groupRows : String ->
  String ->
  List Pair ->
  <Exec, IO, FileRead, FileWrite> List (String, Expectation)
groupRows bin fixDir pairs =
  let dirs = map freshDirFor pairs
  let prepared = prepAll fixDir pairs dirs
  let settled = runGroup bin prepared
  let _ = map (d => runVerb "rm" ["-rf", d]) (somes (map okDir dirs))
  labelGrades (map rowLabel pairs) settled

groupedRows : String ->
  String ->
  List Pair ->
  <Exec, IO, FileRead, FileWrite> List (String, Expectation)
groupedRows bin fixDir pairs =
  flatMap (groupRows bin fixDir) (chunks testJobs pairs)

-- `prepRow` over every pair, each with its own directory result. A pair with
-- no directory, or a directory with no pair, is a failure row rather than a
-- row that is silently dropped.
prepAll : String ->
  List Pair ->
  List (Result String String) ->
  <Exec, IO, FileRead, FileWrite> List (Result Expectation Row)
prepAll _ [] [] = []
prepAll fixDir (p :: ps) (d :: ds) = prepRow fixDir p d :: prepAll fixDir ps ds
prepAll fixDir (p :: ps) [] =
  Err (fail "\{rowLabel p}: internal: no scratch directory was made")
    :: prepAll fixDir ps []
prepAll fixDir [] (_ :: ds) =
  Err (fail "internal: a scratch directory was made for no row")
    :: prepAll fixDir [] ds

check : <Exec, IO, FileRead, FileWrite> Expectation
check = checkIn medakaBin (underRoot "test/dict_fixtures")

-- The script globbed `*.mdk` directly in the fixture dir (no recursion). The
-- enumerator returns full paths, recursive; keep top-level `.mdk` leaves only.
-- A leaf with a "/" lives in a subdirectory (multi-file fixture) and is excluded.
directLeaves : String -> List String -> List String
directLeaves fixDir names =
  filter
    (l => endsWith ".mdk" l && not (contains "/" l))
    (map (p => replaceAll "\{fixDir}/" "" p) names)

checkIn : String -> String -> <Exec, IO, FileRead, FileWrite> Expectation
checkIn bin fixDir = match fixtureFiles fixDir
  Err e => fail "could not enumerate test/dict_fixtures: \{e}"
  Ok names => match pairsIn fixDir (directLeaves fixDir names)
    Err e => fail e
    Ok ps => match importPairsIn fixDir (admittedRels fixDir names)
      Err e => fail e
      Ok ips => expectAll [
        expectAtLeast 135 (length ps),
        expectAtLeast 24 (length ips),
        expectEach (groupedRows bin fixDir (ps ++ ips)),
      ]

test "DICT-SEMANTICS section 4: declaration-order permutation keeps verdict, run and build" =
  check

-- A file's trailing blank line travels with its last chunk, so a reordered file
-- can gain a blank line between imports; only the order of lines is asserted.
test "the import permuter reverses a hub's lines and moves nothing else" =
  let hub = "-- hub\nexport import pa.{IA, mth}\nexport import pb.{IB, mth}\n"
  let entry = "import hub.{mth}\nimport dflt.{dflt}\n\nmain = mth dflt\n"
  expectAll [
    expectEqual
      ["-- hub", "export import pb.{IB, mth}", "export import pa.{IA, mth}"]
      (filter (/= "") (lines (permuteImports hub))),
    expectEqual
      ["import dflt.{dflt}", "import hub.{mth}", "main = mth dflt"]
      (filter (/= "") (lines (permuteImports entry))),
    expectEqual 2 (importCount entry),
  ]
