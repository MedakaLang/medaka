-- module `recshapes` — two INDEX-INCOMPLETENESS shapes for the rename gate
-- (`scopes.jsonl`).  ⚠️ THE LINE NUMBERS BELOW ARE THE TRANSCRIPT'S CLICK
-- COORDINATES — keep this header exactly 16 lines.
--
-- Both are OPEN `refindex` defects, and neither has a mis-placed span, so F3(d)
-- span verification is structurally blind to them — the occurrence is simply not
-- under the clicked key:
--   #1003 a self-recursive LOCAL: `rgo (k - 1)` is recorded as a use of the
--         top-level `rgo`, so the rename leaves it behind and it REBINDS to that
--         outer definition — `medaka run` printed 10 before and 104 after, with
--         `check` clean. A silent wrong answer.
--   #951  a top-level `let rec`: `recshapes|local|rcount|N` and
--         `recshapes|val|rcount` BOTH hold a def at the same span, and the
--         recursive call belongs to the first while the external call belongs to
--         the second. Renaming from either click edits half of them.
-- Both must now REFUSE (F3(f), `renameIndexAmbiguous`).
rgo : Int -> Int
rgo k = 100

rOuter : Int -> Int
rOuter n =
  let rgo k = if k <= 0 then 0 else k + rgo (k - 1)
  rgo n

let rec rcount n = if n <= 0 then 0 else 1 + rcount (n - 1)

recMain : Int
recMain = rOuter 4 + rcount 3
