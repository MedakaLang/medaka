{- | Gate for the P0-2(a)+(b) "no silent death" regression over
   `test/stack_overflow_fixtures`.

   Deep non-tail recursion and non-productive self-referential values used to
   die with a bare SIGBUS/SIGSEGV and zero output on both engines: `medaka
   run`'s tree-walking interpreter recurses on the host C stack with no
   tail-call optimisation, and a compiled binary either exhausts its 256 MB
   worker stack or faults on a wild self-reference. Every such death is now a
   clean, coded, nonzero-exit diagnostic. The discriminating signal is the
   `runtime error [E-…]` line on stderr, not the exit code: a raw signal
   death is nonzero too.

   Two mechanisms are exercised. `E-STACK-OVERFLOW` is the interpreter's
   depth guard under `run` and the native signal backstop under `build`, and
   the two word it differently on purpose — the guard names the evaluator's
   call-depth limit, the backstop names a real stack — so the code is what is
   pinned, not the sentence. `E-CYCLIC-VALUE` is `forceCell`'s black-holing,
   which only the interpreter has; the compiled binary reaches its cyclic
   fault through the same signal backstop and is free to report a different
   code for it, so its row asks only that the death be coded at all.

   `deep_ok` is the control, and it is load-bearing: a moderately deep but
   finite program, below the guard's limit, that must still print 10000 and
   exit 0 on both engines. Without it, a guard "fixed" into tripping on
   everything would read as green.

   Runs under `medaka test --native`: it spawns subprocesses and reads the
   corpus, neither of which the interpreter binds. -}

import compiler_cli_test_support.{
  EngineDeath(..), RuntimeOutcome(..), fatalOutcomeSweep, rosterAgreement
}
import string.{contains, lines}
import test.{Expectation, fail, pass}
import test_process.{boundedVerbSeconds, medakaBin, medakaRoot}

corpus : <IO> String
corpus = "\{medakaRoot}/test/stack_overflow_fixtures"

-- Both engines die before anything is printed, so the stdout every row pins
-- is the empty string rather than a sentinel line. That the printed bytes of
-- an aborting program survive at all is `run_stdout_flush_fixtures`' subject.
silently : String
silently = ""

-- | The size of the corpus, written down so that a corpus which silently
-- shrank is red. Growing it is expected: add the row and raise this.
declaredFixtureCount : Int
declaredFixtureCount = 3

overflow : EngineDeath
overflow = Coded "E-STACK-OVERFLOW"

rows : List (String, RuntimeOutcome)
rows = [
  ("deep_recursion", Dies overflow overflow silently),
  ("cyclic_value", Dies (Coded "E-CYCLIC-VALUE") AnyCode silently),
  ("deep_ok", Prints "10000"),
]

test "every fixture pins a runtime outcome" =
  rosterAgreement corpus declaredFixtureCount rows

test "run and build+exec agree with every fixture's pinned outcome" =
  fatalOutcomeSweep corpus declaredFixtureCount rows

-- #3781: the interpreter arm of `medaka test` names the file in the
-- diagnostic, as `medaka run` does, rather than printing a bare `:L:C:`.
namesFile : String -> <Exec, IO> Expectation
namesFile name =
  let fixture = "\{medakaRoot}/test/stack_overflow_test_fixtures/\{name}.mdk"
  match boundedVerbSeconds 60 medakaBin ["test", "--engines", "eval", fixture]
    Err e => fail "medaka test: \{e}"
    Ok (_, _, re) => match filter (contains "[E-STACK-OVERFLOW]") (lines re)
      [] => fail "no E-STACK-OVERFLOW line on stderr: \{debug re}"
      ls =>
        if all (contains "\{name}.mdk:") ls then
          pass
        else
          fail "diagnostic does not name the file: \{debug ls}"

test "medaka test under the interpreter names the file at a stack overflow" =
  namesFile "deep_in_test_block"

test "a doctest's stack overflow names the file" = namesFile "deep_in_doctest"

test "a prop's stack overflow names the file" = namesFile "deep_in_prop"
