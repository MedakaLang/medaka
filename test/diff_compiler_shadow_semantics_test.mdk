{- | The diagnostic a rejecting cell owes: for `run` and for `build`, when the
   row expects the verb to REJECT, a non-empty `diag` must appear in that
   verb's own stderr or log (`check` prints type errors on stdout, which
   `Agreement` does not keep, so its column pins the verdict only). A rejected cell therefore pins its message class
   as well as its verdict, so a program that starts failing for a different
   reason goes red instead of staying a green REJECT. -}
missingDiag : String -> (String, String) -> Bool
missingDiag needle (verdict, err) =
  verdict == "REJECT" && not (contains needle err)

diagFailure : Row -> Agreement -> Option String
diagFailure r a =
  let verbs = [(r.expRun, a.runErr), (r.expBuild, a.buildLog)]
  if r.diag == "" || not (any (missingDiag r.diag) verbs) then
    None
  else
    Some "expected \{debug r.diag} on every rejecting run and build"

{- | The import-shadow warning is retired: no cell carries it on any verb. -}
retiredWarning : String
retiredWarning = "is shadowed in module"

retiredWarningFailure : Agreement -> Option String
retiredWarningFailure a =
  if any (contains retiredWarning) [a.checkErr, a.runErr, a.buildLog] then
    Some "expected NO \{debug retiredWarning} on any verb; it fired"
  else
    None

{- | One cell's graded outcome. `note` carries a structural failure — a
   table row naming a fixture that is not there, a spawn that could not
   start — which has no verdict columns of its own to report. -}
data Graded = Graded {
  entry : String,
  checkV : String,
  runV : String,
  buildV : String,
  grade : String,
  ok : Bool,
  note : String,
}

gradeValue : Mode -> String -> Agreement -> String
gradeValue NoValue _ _ = "-"
gradeValue AllExact pinned a =
  if a.runCode /= 0 || a.buildCode /= 0 then
    "n/a"
  else if a.runOut == a.binOut && a.runOut == pinned then
    if binaryRanClean a then "ok" else "BINPANIC"
  else
    "DIFF"

structuralRow : String -> String -> Graded
structuralRow entry note = Graded {
  entry = entry,
  checkV = "-",
  runV = "-",
  buildV = "-",
  grade = "-",
  ok = False,
  note = " \{note}",
}

-- The scratch binary's name has to be unique per row, and an entry path can
-- name a subdirectory, so the separator becomes part of the name rather
-- than a directory the build would have to create.
binName : String -> String
binName entry = replaceAll "/" "_" entry

{- | The grades that mean "graded, and fine". An ALLOWLIST, deliberately: a
   `Mode` arm added later (which this module's header invites) must be RED
   until it is named here, not green by omission. -}
gradePasses : String -> Bool
gradePasses grade = grade == "-" || grade == "ok" || grade == "n/a"

planOne : String -> Row -> <FileRead, IO> Result Graded (String, String)
planOne scratch r =
  let entrypath = "\{corpus}/\{r.entry}"
  match readFile entrypath
    Err e => Err (structuralRow r.entry "missing fixture file: \{e}")
    Ok _ => Ok (entrypath, "\{scratch}/\{binName r.entry}.bin")

gradeOne : Row ->
  (String, String) ->
  Result String Agreement ->
  <FileRead, IO> Graded
gradeOne r _ (Err e) = structuralRow r.entry e
gradeOne r (_, binPath) (Ok a) =
  let checkV = verdictOf a.checkCode
  let runV = verdictOf a.runCode
  -- A `build` ACCEPT must have produced a binary: exit 0 alone would
  -- let a `NONE`-mode row pin ACCEPT over a build that emitted nothing.
  let buildV =
    if a.buildCode == 0 && fileExists binPath then "ACCEPT" else "REJECT"
  let grade = gradeValue r.mode r.pinned a
  let diagNote = match diagFailure r a
    Some msg => Some msg
    None => retiredWarningFailure a
  let diagOk = match diagNote
    None => True
    Some _ => False
  Graded {
    entry = r.entry,
    checkV = checkV,
    runV = runV,
    buildV = buildV,
    grade = grade,
    ok =
      checkV == r.expCheck
        && runV == r.expRun
        && buildV == r.expBuild
        && gradePasses grade
        && diagOk,
    note = match diagNote
      None => ""
      Some msg => "\n\{msg}",
  }

cellRowFailure : Graded -> Option String
cellRowFailure g =
  if g.ok then
    None
  else
    Some
      "  \{padRight 60 ' ' g.entry} check=\{padRight 7 ' ' g.checkV} run=\{padRight 7 ' ' g.runV} build=\{padRight 7 ' ' g.buildV} value=\{g.grade}\{g.note}"

sweep : <Exec, FileRead, IO> Expectation
sweep = sweepAgreements table planOne gradeOne cellRowFailure summarizeSweep

-- A row may name a secondary entry point inside a fixture directory
-- (`<dir>/order-swapped.mdk`), which grades that directory a second way;
-- only `<dir>/main.mdk` names the unit itself.
unitOf : String -> String
unitOf e = match stripSuffix "/main.mdk" e
  Some d => d
  None => e

rowEntry : Row -> String
rowEntry r = r.entry

roster : List String
roster = map unitOf (map rowEntry table)

{- | Every top-level unit of the corpus: a fixture is either one `.mdk` file
   or a whole directory. `fixtureDirs` carries the anti-vacuity floor, so a
   corpus that reads cleanly but holds nothing is an `Err` rather than a
   green run over zero cells. -}
corpusUnits : <FileRead, IO> Result String (List String)
corpusUnits = match fixtureDirs corpus
  Err e => Err e
  Ok dirs =>
    map
      (names => sort (map basename dirs ++ filter (endsWith ".mdk") names))
      (listDir corpus)

test "every fixture in the corpus is wired into the table" = match corpusUnits
  Err e => fail "\{corpus}: \{e}"
  Ok units => match unrosteredUnits (n => Some n) roster units
    [] => pass
    orphans =>
      fail
        "present in \{corpus} but not wired into this gate's table: \{debug orphans}"

{- | `binaryRanClean`'s False branch has no vehicle anywhere in the tree:
   every `table` row that reaches it would need to grade `"BINPANIC"`
   forever, which `gradePasses`'s allowlist can never accept. This test runs
   the two static fixtures in `test/binpanic_fixtures/` (a real binary that
   panics after printing, and its clean counterpart) through the same
   `checkRunBuild` the sweep uses, and asserts both of `binaryRanClean`'s
   branches directly, outside the "every cell grades ok" sweep.

   Declared BEFORE the heavy sweep below, and it leaves its `scratchDir` in
   place: this test never removes the root. -}
test "binaryRanClean distinguishes a panicking binary from a clean one" =
  let binpanicCorpus = "\{medakaRoot}/test/binpanic_fixtures"
  match scratchDir
    Err e => fail "could not make a scratch directory: \{e}"
    Ok scratch =>
      match checkRunBuild "\{binpanicCorpus}/panics.mdk" "\{scratch}/panics.bin"
        Err e => fail "checkRunBuild panics.mdk: \{e}"
        Ok panicAgree =>
          match (checkRunBuild
            "\{binpanicCorpus}/clean.mdk"
            "\{scratch}/clean.bin")
            Err e => fail "checkRunBuild clean.mdk: \{e}"
            Ok cleanAgree =>
              if binaryRanClean panicAgree then
                fail
                  "expected binaryRanClean False for a panicking binary, got True (binCode=\{intToString panicAgree.binCode} binErr=\{debug panicAgree.binErr})"
              else if not (binaryRanClean cleanAgree) then
                fail
                  "expected binaryRanClean True for a clean binary, got False (binCode=\{intToString cleanAgree.binCode} binErr=\{debug cleanAgree.binErr})"
              else
                pass

-- # Spawning a sweep side by side

-- Whether a spawn exited with `want` and wrote exactly `errText` to stderr.
exitedWith : Int -> String -> Result String (Int, String, String) -> Expectation
exitedWith want errText (Ok (code, _, err)) =
  if code == want && err == errText then
    pass
  else
    fail
      "expected exit \{want} with stderr \{errText} but got exit \{code} with stderr \{err}"
exitedWith _ _ (Err e) = fail "the run produced no result: \{e}"

test "boundedVerbsSeconds answers each row as boundedVerbSeconds does, in order" =
  let rows = [
    ("sh", ["-c", "sleep 0.3; printf first"]),
    ("sh", ["-c", "printf second >&2; exit 3"]),
    ("medaka-no-such-command", []),
  ]
  let answers = boundedVerbsSeconds 5 rows
  match answers
    [first, second, _] => expectAll [
      expectEqual
        (map ((cmd, args) => boundedVerbSeconds 5 cmd args) rows)
        answers,
      exitedWith 0 "" first,
      exitedWith 3 "second" second,
    ]
    _ => fail "expected one answer per row, got \{debug answers}"

-- 142 is 128 + SIGALRM, the signal the alarm kills a hanging spawn with.
test "a hanging row of a batch is killed by its alarm and the others still answer" =
  let answers = boundedVerbsSeconds 1 [
    ("sh", ["-c", "printf before"]),
    ("sleep", ["30"]),
    ("sh", ["-c", "printf after"]),
  ]
  match answers
    [before, hung, after] => expectAll [
      expectEqual
        [Ok (0, "before", ""), Ok (142, "", ""), Ok (0, "after", "")]
        answers,
      exitedWith 0 "" before,
      exitedWith 142 "" hung,
      exitedWith 0 "" after,
    ]
    _ => fail "expected one answer per row, got \{debug answers}"

-- What a result says, short of an `Agreement`, which has no `Eq`.
spawnedOutputs : Result String Agreement ->
  Result String (String, String, String, Bool)
spawnedOutputs r =
  map (a => (a.runOut, a.binOut, verdictOf a.runCode, binaryRanClean a)) r

test "two fixtures planned onto one binary path are refused, and neither spawns" =
  expectEqual
    [
      Err "a.mdk: another fixture also builds to /no-such-dir/x.bin",
      Err "b.mdk: another fixture also builds to /no-such-dir/x.bin",
    ]
    (map
      spawnedOutputs
      (checkRunBuildAll [
        ("a.mdk", "/no-such-dir/x.bin"),
        ("b.mdk", "/no-such-dir/x.bin"),
      ]))

-- Two fixtures that share a basename in different directories, each built
-- to the path `binName` derives from its whole entry path.
sameBasenameOutputs : String ->
  <Exec, FileRead, FileWrite, IO> Result String (List (Result String (String, String, String, Bool)))
sameBasenameOutputs dir = do
  _ <- mkdirAll "\{dir}/x"
  _ <- mkdirAll "\{dir}/y"
  _ <- writeFile "\{dir}/x/main.mdk" "main = putStr \"x\"\n"
  _ <- writeFile "\{dir}/y/main.mdk" "main = putStr \"y\"\n"
  let pairs =
    map
      (e => ("\{dir}/\{e}", "\{dir}/\{binName e}.bin"))
      ["x/main.mdk", "y/main.mdk"]
  Ok (map spawnedOutputs (checkRunBuildAll pairs))

test "fixtures sharing a basename in different directories grade independently" = withScratchDir
  (dir =>
    expectEqual
      (Ok [Ok ("x", "x", "ACCEPT", True), Ok ("y", "y", "ACCEPT", True)])
      (sameBasenameOutputs dir))

test "check, run and build agree with every cell's pinned verdict and value" =
  sweep

test "S4 imported length rejects at the user source line on every verb" =
  match scratchDir
    Err e => fail e
    Ok scratch =>
      match (checkRunBuild
        "\{corpus}/i4f_importer_value_position_reject/main.mdk"
        "\{scratch}/value-position.bin")
        Err e => fail e
        Ok a => expectAll [
          expectSpawnFailsAll
            medakaBin
            [
              "check",
              "--json",
              "\{corpus}/i4f_importer_value_position_reject/main.mdk",
            ]
            ["T-TYPE-MISMATCH", "type mismatch: Bytes vs List", "\"line\":1"],
          expectLineContainsAll
            ["main.mdk:2:", "type mismatch: Bytes vs List"]
            a.runErr,
          expectLineContainsAll
            ["main.mdk:2:", "type mismatch: Bytes vs List"]
            a.buildLog,
        ]
