{- | Ladder gate for `docs/spec/SHADOW-SEMANTICS.md`, over
   `test/shadow_fixtures`.

   One fixture per question the lexical ladder answers; every row's `label`
   names the spec clause (L1-L9) that decides it.
   The spec's clause L9 says `check`, `run` and `build` agree on every cell and
   that agreement is not evidence: a name that resolves to the wrong
   declaration resolves the same wrong way on all three paths. Every cell that
   accepts therefore also pins the exact stdout the program owes, derived from
   the clause and never captured from a binary.

   A cell that rejects pins its verdict on every verb and, through `diag`, the
   message class each rejecting verb owes. No cell carries an import-shadow
   warning (`retiredWarning`).

   An interface method and a function declared in one module are one
   duplicate-declaration error whatever the receiver, arity, position or
   constraint; `d1` and `d11` stand for every such cell, and `i1` and `i7` for
   the explicit import of a name the module also declares.

   When adding a fixture, vary the shape the ladder reads (which rung binds
   the name, how the name arrived), not the receiver's type or position: those
   take no part in the choice (L1). The coverage assertion below refuses a
   fixture that is present in the corpus but absent from the table.

   Two value modes are live. A future row needing a different one adds a
   `Mode` constructor and an arm in `gradeValue`; `Agreement` keeps the built
   binary's exit code, stdout and stderr apart, so a mode can pin a crash
   signature or a wrong integer. No row pins a known-wrong answer.

   The per-cell verdict table is rendered into the failure message rather
   than printed: `medaka test --native` runs a test body inside a probe whose
   stdout it parses back as a sentinel transcript, so anything the body
   prints on its own account is absorbed there and never reaches a reader. A
   red run therefore names every disagreeing cell and its columns at once.

   Runs under `medaka test --native`: it spawns subprocesses and reads the
   corpus, neither of which the interpreter binds. -}

import compiler_cli_test_support.{
  Agreement(..), binaryRanClean, boundedVerbsSeconds, checkRunBuild,
  checkRunBuildAll, summarizeSweep, sweepAgreements, verdictOf
}
import fs.{fixtureDirs, mkdirAll}
import list.{sort}
import path.{basename}
import string.{contains, endsWith, padRight, replaceAll, stripSuffix}
import test.{
  Expectation, expectAll, expectEqual, expectLineContainsAll, fail, pass
}
import test_process.{
  boundedVerbSeconds,
  expectSpawnFailsAll,
  medakaBin,
  medakaRoot,
  scratchDir,
  unrosteredUnits,
  withScratchDir,
}

-- Fixtures are located through MEDAKA_ROOT rather than the working
-- directory: `medaka gate run` exports it and inherits whatever cwd the
-- caller had.
corpus : <IO> String
corpus = "\{medakaRoot}/test/shadow_fixtures"

{- | What a row asserts about the stdout of a cell that runs.

   `NoValue` is for a cell that owes no stdout: every verb rejects, or the
   verbs that accept ran nothing the cell prints.
   `AllExact` requires the run engine's stdout, the built binary's stdout
   and the pinned value to be byte-identical. -}
data Mode = NoValue | AllExact

{- | One matrix cell: the entry path under the corpus, the label carrying
   why the cell reads as it does, the verdict each verb owes, and what the
   cell prints. -}
data Row = Row {
  entry : String,
  label : String,
  expCheck : String,
  expRun : String,
  expBuild : String,
  mode : Mode,
  pinned : String,
  diag : String,
}

table : List Row
table = [
  Row {
    entry = "d1_definer_noimpl.mdk",
    label =
      "L3 (F-R4): an interface method and a top-level function of one name in one module is a located duplicate-declaration error, with or without impls, receivers or signatures",
    expCheck = "REJECT",
    expRun = "REJECT",
    expBuild = "REJECT",
    mode = NoValue,
    pinned = "",
    diag = "duplicate definition of",
  },
  Row {
    entry = "d11_definer_multityparam_iface.mdk",
