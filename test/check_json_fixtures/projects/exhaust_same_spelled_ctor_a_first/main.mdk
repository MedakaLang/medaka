-- #1185: three modules declare a constructor spelled `Bin`. Each function
-- below and in c.mdk and u.mdk covers every constructor of its own type, so
-- no file has a diagnostic, whatever the import order.
import a.{A(..)}
import u.{f}
import c.{h}
import one.{One}
import b.{B}

fe : A -> Int
fe (Bin n) = n
fe Leaf = 0

ge : Option A -> Int
ge o = match o
  None => 0
  Some (Bin n) => n
  Some Leaf => 1

main = println (fe (Bin 6) + ge (Some Leaf) + f Leaf)
