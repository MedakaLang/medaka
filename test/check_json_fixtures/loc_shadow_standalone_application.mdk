-- C4, L3 (F-R4): an interface method and a top-level function of one name in one module is a
-- located duplicate-declaration error at the second declaration.
interface Sizeable a where
  size : a -> Int

data Box = Box Int

impl Sizeable Box where
  size (Box n) = n

size : Int -> Int
size n = n + 1

q : Int -> Int
q k =
  if k > 3 then
    k
  else
    size "hi"

main = println (q 1)
