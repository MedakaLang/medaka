import boxes.{Tagged, tag}

-- A FOURTH module, constrained and polymorphic: `relay`'s own `tag` occurrence
-- cannot be resolved where it is written — it must receive the impl as a dict
-- from its caller, in a third module, across a module boundary. This is the arm
-- of dispatch a direct `tag bi` call site does not exercise.
export relay : Tagged a => a -> String
relay x = "[" ++ tag x ++ "]"
