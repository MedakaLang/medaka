{- | WASM-SEMANTICS WH2/WH3 (one shim). Replaces diff_compiler_wasm_shim_parity.sh.

   The wasm engine's observable behaviour is not all in the module: the float
   formatter `fmt12g` and the strtod parser `mdkStrToFloat` run in the JS host. They
   used to be copied into each host between `--- BEGIN SHARED SHIM` markers and
   byte-diffed here. Every host now imports them from playground/medaka_host.mjs, so
   this test checks that the copies stay gone:
     * no file under test/ or playground/ carries a BEGIN marker at a line start;
     * playground/medaka_host.mjs defines each shim exactly once;
     * no other file under test/ or playground/ defines either shim.
   A file that cannot be read as UTF-8 text but carries a marker or a definition is a
   named finding, never silently dropped.

   What it proves: there is one copy of each shim. Text, not behaviour: the hosts'
   behaviour is exercised by the wasm gates and playground/medaka_host_test.mjs.

   Runs under `medaka test --native`: it reads files under the repository tree. -}

import test_process.{underRoot}
import string.{lines, startsWith, endsWith, fromUtf8}
import fs.{walkDir, isFile}
import test.{Expectation, expectAll, expectEach, expectEqual, fail}

beginPrefix : String
beginPrefix = "// --- BEGIN SHARED SHIM "

hostModule : String
hostModule = "playground/medaka_host.mjs"

shimNames : List String
shimNames = ["fmt12g", "mdkStrToFloat"]

-- A line that defines shim `name`, exported or not.
definesShim : String -> String -> Bool
definesShim name l =
  startsWith "function \{name}(" l || startsWith "export function \{name}(" l

definitions : String -> String -> Int
definitions name text = length (filter (definesShim name) (lines text))

-- A file that still holds a copy: a BEGIN marker, or a definition of a shim.
holdsCopy : String -> Bool
holdsCopy t =
  any (startsWith beginPrefix) (lines t)
    || any (n => definitions n t > 0) shimNames

data Host = Copy String | Unreadable String String | NotAHost

-- A file that reads as UTF-8 is judged on its text. A file that does not is judged on
-- its bytes, decoded lossily (ASCII markers survive): a copy in it is a named finding.
-- A file that cannot be read at all is a named finding too, never a silent skip.
hostOf : String -> <IO, FileRead> Host
hostOf p = match readFile p
  Ok t => if holdsCopy t then Copy p else NotAHost
  Err e => match isFile p
    Err e3 => Unreadable p "could not stat: \{e3}"
    Ok False => NotAHost
    Ok True => match readFileBytes p
      Ok bs =>
        if holdsCopy (fromUtf8 bs) then
          Unreadable p "not valid UTF-8 but holds a shim copy: \{e}"
        else
          NotAHost
      Err e2 => Unreadable p "could not read: \{e2}"

hosts : List String -> <IO, FileRead> List Host
hosts [] = []
hosts (p :: rest) = match hostOf p
  NotAHost => hosts rest
  h => h :: hosts rest

copyList : List Host -> List String
copyList [] = []
copyList (h :: rest) = match h
  Copy p => p :: copyList rest
  _ => copyList rest

unreadableList : List Host -> List (String, Expectation)
unreadableList [] = []
unreadableList (h :: rest) = match h
  Unreadable p r => (p, fail r) :: unreadableList rest
  _ => unreadableList rest

checkHosts : String -> List Host -> Expectation
checkHosts hostText hs = expectAll [
  expectEach
    (map
      (n => ("\{hostModule}: one \{n}", expectEqual 1 (definitions n hostText)))
      shimNames),
  expectEqual [] (copyList hs),
  expectEach (unreadableList hs),
]

oneShim : <IO, FileRead> Expectation
oneShim = match readFile (underRoot hostModule)
  Err e => fail "missing host module \{hostModule}: \{e}"
  Ok hostText => match walkDir (underRoot "test")
    Err e => fail "could not walk test/: \{e}"
    Ok testPaths => match walkDir (underRoot "playground")
      Err e => fail "could not walk playground/: \{e}"
      Ok playPaths =>
        checkHosts
          hostText
          (hosts
            (filter
              (p => not (endsWith hostModule p))
              (testPaths ++ playPaths)))

test "diff_compiler_wasm_shim_parity: the shared shims live only in playground/medaka_host.mjs" =
  oneShim
