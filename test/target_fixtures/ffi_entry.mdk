-- A foreign call bound for `c` alone: llvm/native-posix calls it, while `run`
-- (eval/run, no host) and every wasm profile (`js`) refuse the reached
-- declaration at check, before the interpreter or the emitter meets the call.
extern ffiAddInts : Int -> Int -> <FFI "c"> Int

main : <Stdout, FFI "c*"> Unit
main = println (ffiAddInts 20 22)
