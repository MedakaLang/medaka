-- `Net "a.com"` at the entry: `native` admits it; `wasmgc/edge` grants `Net`,
-- yet refuses the socket built-in `netResolve` it reaches (native-only).
fetchHost : (h : String) -> <Net h, Stdout> Unit
fetchHost h = match netResolve h
  Ok _ => println "resolved"
  Err e => println e

main = fetchHost "a.com"
