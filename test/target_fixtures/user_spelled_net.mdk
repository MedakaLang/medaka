-- A module-declared label spelled `Net` is a user label, not the host `Net`:
-- no profile gates it, so a wasm profile refuses only the extern it has no
-- `js` binding for, and llvm/native-posix admits the program.
effect Net Prefix

extern netGet : (url : String) -> <FFI "c", Net url> String

main : <Stdout, FFI "c*", Net> Unit
main = println (netGet "a.com/api")
