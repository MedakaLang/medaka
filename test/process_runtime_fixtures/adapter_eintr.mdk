import async.{runAsync}
import bytes.{encodeUtf8}
import process.{
  SpawnOptions(..), PipeChoice(..), ExitStatus(..), closeStdin, dispose
}
import process_async.{
  after, newCancelToken, startUntil, writeUntil, waitUntil, StartResult(..),
  WriteResult(..), WaitResult(..)
}
import string.{repeat}
import time.{millis}

options : SpawnOptions
options = SpawnOptions {
  argv = ["1"],
  cwd = "/tmp",
  env = [],
  stdin = Piped,
  stdout = Null,
  stderr = Null,
}
main =
  let launchDeadline = runAsync (after (millis 5000))
  let started =
    runAsync
      (startUntil "/bin/sleep" options launchDeadline (newCancelToken ()))
  let passed = match started
    Ok (Started p) =>
      let bytes = encodeUtf8 (repeat 100000 "x")
      let deadline = runAsync (after (millis 50))
      let written = runAsync (writeUntil p bytes deadline (newCancelToken ()))
      let closed = closeStdin p
      let exited = runAsync (waitUntil p launchDeadline (newCancelToken ()))
      let disposed = dispose p
      match (written, closed, exited, disposed)
        (Ok (WriteTimedOut 0), Ok _, Ok (ChildExited (Exited 0)), Ok _) => True
        _ => False
    _ => False
  if passed then
    println "adapter eintr deadline passed"
  else
    println "adapter eintr deadline failed"
