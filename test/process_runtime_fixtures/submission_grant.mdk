import process.{SpawnOptions(..), PipeChoice(..), submit}

options : SpawnOptions
options = SpawnOptions {
  argv = [],
  cwd = "/tmp",
  env = [],
  stdin = Null,
  stdout = Null,
  stderr = Null,
}

wrong : Unit -> <Exec "/bin/false"> Unit
wrong _ = let _ = submit "/bin/true" options in ()

main = wrong ()
