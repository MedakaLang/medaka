-- #1647 — the PINNED program. A VALID program that CANNOT BE BUILT.
--
-- HAND-DERIVED, NOT CAPTURED (DICT-SEMANTICS §8 I4: an interface is identified by
-- (module, name), so speakera::Speak and speakerb::Speak are two DISTINCT interfaces
-- that merely share a spelling; each impl body is checked against ITS OWN module's
-- declaration):
--   speakera::speak : String -> x -> String ; `speak "x" DogA` -> "A(x)"
--   speakerb::speak : x -> String -> String ; `speak DogB "y"` -> "B(y)"
-- ⇒ a CORRECT compiler builds this program and the binary prints
--      A(x)
--      B(y)
-- at exit 0. `medaka check` agrees (exit 0, no diagnostics) and `medaka run` agrees
-- and PRINTS exactly that, so the correct answer is not in dispute — only the EMIT
-- path is, which refuses to build the program at all.
import speakera.{useA}
import speakerb.{useB}

main =
  let _ = println useA
  println useB
