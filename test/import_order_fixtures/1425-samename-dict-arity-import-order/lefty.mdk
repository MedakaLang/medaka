-- CONSTRAINED `widget`: per DICT-SEMANTICS §4 `gen-sig` it abstracts ONE dict
-- parameter, and per §8 I1 that arity belongs to THIS binding's module-qualified
-- identity, not to the surface name `widget`.
export interface Sz a where
  sz : a -> Int

export impl Sz Int where
  sz n = n

export widget : Sz a => a -> Int
widget x = sz x + 100
