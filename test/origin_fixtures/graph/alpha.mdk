-- #1110 origin-agreement corpus — the DEFINING module.
--
-- `Tag` and `Crate` are alpha's OWN declarations, so any driver that claims an
-- identity for them must say `alpha`.  F1 was a driver claiming `__user__` here
-- while, in the same process, the graph driver said the loader id.
--
-- `Option` and `Ordering` are PRELUDE types spelled inside a USER module.  F2 was a
-- driver attributing exactly those to the user's module instead of `core`, so they
-- are here deliberately rather than incidentally.
--
-- `Int`/`String`/`Bool` are builtins: one program-global identity (DICT-SEMANTICS
-- §8 I6.2), never the writing module's.

public export data Tag = Fragile | Bulk

public export data Crate a = Crate Tag a

export crateTag : Crate a -> Tag
crateTag (Crate t _) = t

export crateValue : Crate a -> Option a
crateValue (Crate _ v) = Some v

export tagOrder : Tag -> Tag -> Ordering
tagOrder Fragile Bulk = Lt
tagOrder Bulk Fragile = Gt
tagOrder _ _ = Eq

export crateHeavy : Crate Int -> Bool
crateHeavy (Crate _ n) = n > 10

export crateLabel : Crate Int -> String
crateLabel (Crate _ n) = "crate-\{n}"

-- A CONSTRUCTOR FUNCTION, so a consumer can build a `Crate` while importing only
-- the re-exported TYPE name from beta.  That is what keeps the re-export chain
-- (`beta` re-exports alpha's `Tag`/`Crate`) under test: a type reached through a
-- re-export must still be attributed to alpha, its DEFINER, never to beta.
export fragileCrate : a -> Crate a
fragileCrate v = Crate Fragile v

-- #1110 coverage gap (issue title: "types/aliases/interfaces/methods/records/
-- ctors"): the corpus above is ALL `data`.  Everything below adds one of the
-- other decl forms that mints/uses a type head, so a defect confined to
-- `stampDeclTyOrigins`'s non-`data` arms has somewhere to print itself.
--
-- `Weighable` is an INTERFACE.  Its own name is never a `TyCon` — an interface
-- is a constraint predicate, not a type constructor, and `mapTyInDecl`'s
-- `DInterface` arm walks only `methods`' Ty positions — so this declaration by
-- itself mints no HEAD SPREAD row.  It exists to give the `impl`s below (here
-- and in beta) something to be an impl OF.
export interface Weighable a where
  weight : a -> Int

-- An IMPL, over `Tag` — alpha's own type, alpha's own interface.  `DImpl.tys`
-- is walked by the same traversal the stamper uses, so this exercises the
-- decl form directly; the re-exported case (impl over a head reached only via
-- beta's re-export) is in beta.mdk.
export impl Weighable Tag where
  weight Fragile = 1
  weight Bulk = 5

-- `CrateId` is a NEWTYPE.  A bare `newtype` decl mints no Ty-position
-- occurrence of its OWN name (`mapTyInDecl`'s `DNewtype` arm walks only the
-- underlying field type) — so `crateIdOf`'s signature is what turns `CrateId`
-- into a claimable head.
newtype CrateId = CrateId Int

export crateIdOf : Crate a -> CrateId
crateIdOf _ = CrateId 0

-- `Weight` is a TYPE ALIAS over `Int`, referenced the same way as `CrateId`
-- above: the alias decl's own name needs a USE site to become a head.
export type Weight = Int

export crateWeightOf : Crate Int -> Weight
crateWeightOf (Crate t n) = n + weight t
