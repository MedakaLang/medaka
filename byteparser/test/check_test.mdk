{- | Floor gate for the `byteparser/` project (#1933 coverage half),
   migrated from `byteparser/test/check.sh` under #2592.

   `medaka check byteparser/main.mdk` exiting 0 is the whole floor: this
   manifest-bearing project has no doctests or `test "…"` declarations of
   its own, so an accepted `check` is what keeps it from being silently
   unenrolled from CI. Add assertions here if the project ever grows
   behavior worth asserting on. -}

import test.{Expectation}
import test_process.{expectSpawnOk, medakaBin, underRoot}

test "byteparser/main.mdk passes `medaka check`" =
  expectSpawnOk medakaBin ["check", underRoot "byteparser/main.mdk"]
