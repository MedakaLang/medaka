test "inflate: real dynamic-Huffman raw DEFLATE stream (zlib -15) round-trips" =
  expectEqual (Ok dynExpected) (inflate dynBytes)

-- ---------------------------------------------------------------------------
-- Hand-derived dynamic-Huffman error path: a repeat-previous code-length
-- symbol (16) as the very FIRST decoded code-length symbol, with no
-- previous length to repeat — RFC 1951 §3.2.7's own malformed-stream case,
-- and the design doc's explicit "must Err, not read out of bounds"
-- requirement. Built by hand with `bitio`'s writer primitives (the same
-- technique `huffman.mdk`'s own tests use), not captured from our decoder:
--
--   BFINAL=1, BTYPE=2 (dynamic), HLIT=0 (nLit=257), HDIST=0 (nDist=1),
--   HCLEN=0 (nClen=4, the minimum — covers clOrder positions 0..3, i.e.
--   code-length symbols 16, 17, 18, 0). Transmitted 3-bit lengths: symbol16
--   -> 1, symbol17 -> 0, symbol18 -> 0, symbol0 -> 1. That is a
--   Kraft-COMPLETE 2-symbol code-length alphabet (two length-1 codes,
--   0.5+0.5=1) — `buildHuffmanStrict` accepts it with no exception needed.
--   Canonical assignment (ascending symbol order within a length): symbol0
--   gets code "0", symbol16 gets code "1". The block body's first (and
--   only) bit is therefore a single `1`, decoding to code-length symbol 16
--   as literally the FIRST symbol of the block — i == 0, prevLen == -1 —
--   which `readCodeLengthsGo` must reject before touching `getBits 2` or
--   the output array at all.
-- ---------------------------------------------------------------------------

repeatFirstBytes : Array Int
repeatFirstBytes =
  let w = newBitWriter ()
  let _ = putBits 1 1 w  -- BFINAL = 1
  let _ = putBits 2 2 w  -- BTYPE = 2 (dynamic Huffman)
  let _ = putBits 0 5 w  -- HLIT = 0 -> nLit = 257
  let _ = putBits 0 5 w  -- HDIST = 0 -> nDist = 1
  let _ = putBits 0 4 w  -- HCLEN = 0 -> nClen = 4
  let _ = putBits 1 3 w  -- clOrder[0] = symbol 16, length 1
  let _ = putBits 0 3 w  -- clOrder[1] = symbol 17, length 0 (unused)
  let _ = putBits 0 3 w  -- clOrder[2] = symbol 18, length 0 (unused)
  let _ = putBits 1 3 w  -- clOrder[3] = symbol 0,  length 1
  let _ = putCodeMSB 1 1 w  -- the block body's first code-length symbol: code "1" -> symbol 16
  finishBitWriter w

test "inflate: dynamic Huffman rejects repeat-code 16 as the FIRST code-length symbol (no previous length)" =
  expectEqual
    (Err
      "dynamic Huffman: repeat-previous code (16) with no previous code length to repeat")
    (inflate repeatFirstBytes)

-- `head -c 200 /dev/urandom > rand.bin && gzip -1 -n -c rand.bin` — genuinely
-- incompressible input, so gzip falls back to a STORED block (there is no
-- `gzip -0`; see design doc "The oracle"). Verified on this box:
--   $ xxd -s 10 -l 6 rand.gz  ->  01c8 0037 ff
-- 0x01 = BFINAL=1,BTYPE=00; LEN=0x00c8=200; NLEN=0xff37, the exact one's
-- complement of 200. Cross-checked against
-- `python3 -c "import zlib; d=open('rand.bin','rb').read(); print(zlib.crc32(d), len(d))"`
-- -> 547945378 200.
randGz : Array Int
randGz = arrayFromList [
  31, 139, 8, 0, 0, 0, 0, 0, 4, 3, 1, 200, 0, 55, 255, 190, 246, 7, 148, 140,
  204, 149, 34, 157, 59, 105, 78, 139, 12, 231, 77, 123, 149, 186, 225, 117,
  173, 39, 30, 68, 168, 225, 77, 156, 131, 16, 184, 216, 6, 73, 248, 122, 225,
  141, 220, 91, 157, 16, 255, 181, 8, 13, 100, 202, 137, 199, 185, 210, 108,
  225, 18, 33, 5, 206, 152, 26, 254, 127, 84, 202, 154, 167, 124, 252, 141, 136,
  108, 34, 7, 38, 231, 155, 60, 142, 124, 93, 53, 248, 19, 246, 162, 230, 25,
  186, 135, 220, 205, 123, 92, 159, 122, 220, 40, 141, 230, 159, 22, 167, 37,
  109, 108, 254, 2, 19, 56, 91, 180, 254, 214, 119, 115, 189, 255, 31, 16, 146,
  246, 3, 23, 72, 163, 157, 187, 251, 204, 138, 106, 133, 111, 74, 231, 32, 221,
  125, 127, 246, 204, 166, 219, 42, 153, 120, 174, 43, 151, 52, 168, 18, 217, 6,
  225, 250, 65, 150, 113, 82, 56, 11, 243, 88, 99, 138, 25, 128, 232, 218, 51,
  248, 151, 250, 176, 60, 177, 73, 157, 39, 184, 131, 101, 125, 101, 91, 229,
  23, 154, 250, 197, 248, 98, 90, 106, 191, 88, 196, 3, 162, 251, 168, 32, 200,
  0, 0, 0
]

-- The 200 raw bytes `randGz` decompresses to (the payload bytes of `randGz`
-- between the 10-byte header + 5-byte block header, and the 8-byte trailer).
randBin : Array Int
randBin = arrayFromList [
  190, 246, 7, 148, 140, 204, 149, 34, 157, 59, 105, 78, 139, 12, 231, 77, 123,
  149, 186, 225, 117, 173, 39, 30, 68, 168, 225, 77, 156, 131, 16, 184, 216, 6,
  73, 248, 122, 225, 141, 220, 91, 157, 16, 255, 181, 8, 13, 100, 202, 137, 199,
  185, 210, 108, 225, 18, 33, 5, 206, 152, 26, 254, 127, 84, 202, 154, 167, 124,
  252, 141, 136, 108, 34, 7, 38, 231, 155, 60, 142, 124, 93, 53, 248, 19, 246,
  162, 230, 25, 186, 135, 220, 205, 123, 92, 159, 122, 220, 40, 141, 230, 159,
  22, 167, 37, 109, 108, 254, 2, 19, 56, 91, 180, 254, 214, 119, 115, 189, 255,
  31, 16, 146, 246, 3, 23, 72, 163, 157, 187, 251, 204, 138, 106, 133, 111, 74,
  231, 32, 221, 125, 127, 246, 204, 166, 219, 42, 153, 120, 174, 43, 151, 52,
  168, 18, 217, 6, 225, 250, 65, 150, 113, 82, 56, 11, 243, 88, 99, 138, 25,
  128, 232, 218, 51, 248, 151, 250, 176, 60, 177, 73, 157, 39, 184, 131, 101,
  125, 101, 91, 229, 23, 154, 250, 197, 248, 98, 90, 106, 191, 88, 196, 3
]

test "gunzipMember: real stored-block .gz round-trips byte for byte" =
  expectEqual (Ok randBin) (gunzipMember randGz)

-- Corrupt NLEN (byte offset 13, one of the two NLEN bytes: 55 -> 56) so it is
-- no longer the one's complement of LEN=200.
corruptedNlenGz : Array Int
corruptedNlenGz = arrayFromList (setAt 13 56 (toList randGz))

setAt : Int -> a -> List a -> List a
setAt _ _ [] = []
setAt 0 v (_ :: rest) = v :: rest
setAt i v (x :: rest) = x :: setAt (i - 1) v rest

test "gunzipMember: a corrupted NLEN is rejected" =
  match gunzipMember corruptedNlenGz
    Err msg =>
      expectEqual
        "stored block: NLEN (65336) is not the one's complement of LEN (200)"
        msg
    Ok _ => fail "expected Err on corrupted NLEN"

-- Truncate mid-payload (keep only the header + block header + a handful of
-- payload bytes, well short of LEN=200 and short of the trailer). Must be an
-- `Err`, not a hang and not a wrong-length success.
truncatedGz : Array Int
truncatedGz = sliceClamped 0 20 randGz

test "gunzipMember: a truncated stream is Err, not a hang" =
  expectEqual True (isErr (gunzipMember truncatedGz))

-- Corrupt one byte of the CRC-32 field in the trailer (the last 8 bytes,
-- first 4 are CRC-32 LE — flip the low byte).
corruptedCrcGz : Array Int
corruptedCrcGz =
  arrayFromList (setAt (arrayLength randGz - 8) 0 (toList randGz))

test "gunzipMember: a corrupted trailer CRC-32 is rejected" =
  match gunzipMember corruptedCrcGz
    Err msg =>
      expectEqual
        "gzip trailer CRC-32 mismatch: computed 547945378, trailer says 547945216"
        msg
    Ok _ => fail "expected Err on a corrupted trailer CRC-32"

-- ---------------------------------------------------------------------------
-- `copyBack` — the sliding-window primitive, exercised now even though no
-- caller exists yet (see module header).
-- ---------------------------------------------------------------------------

copyBackResult : List Int -> Int -> Int -> Result String (Array Int)
copyBackResult seed distance len =
  let out = fromList seed
  map (_ => toArray out) (copyBack distance len out)

-- Design-doc-verified shape: `distance=1, length=4` over `[65,66]` is
-- run-length encoding of the trailing byte, `66`, four more times.
test "copyBack: distance=1 (RLE) repeats the trailing byte" =
  expectEqual
    (Ok (arrayFromList [65, 66, 66, 66, 66, 66]))
    (copyBackResult [65, 66] 1 4)

-- `distance == length(out)` is legal and refers to the very FIRST output
-- byte: over `[65, 66, 67]`, distance=3, len=2 reads index 0 then index 1
-- (which by then is the just-copied 65), yielding `[65, 66, 67, 65, 66]`.
test "copyBack: distance == outLen refers to the first output byte (legal)" =
  expectEqual
    (Ok (arrayFromList [65, 66, 67, 65, 66]))
    (copyBackResult [65, 66, 67] 3 2)

-- A general overlap case: `distance=2, length=5` over `[1, 2]` alternates
-- the two seed bytes, since each copied byte becomes a source two positions
-- later: seed `1,2` followed by 5 more copies `1,2,1,2,1`.
test "copyBack: distance=2, length=5 alternates the seed bytes" =
  expectEqual
    (Ok (arrayFromList [1, 2, 1, 2, 1, 2, 1]))
    (copyBackResult [1, 2] 2 5)

-- `distance > length(out)` is a malformed stream, not a wrap-around: `Err`.
test "copyBack: distance > outLen is rejected" =
  match copyBackResult [65, 66] 5 1
    Err msg =>
      expectEqual "copyBack: distance 5 exceeds current output length 2" msg
    Ok _ => fail "expected Err on distance > outLen"

-- `distance <= 0` is also malformed (there is no RFC encoding for it, but a
-- corrupted/adversarial stream could still produce it once Phase 2/3 decode
-- distance symbols) and must not silently no-op or underflow.
test "copyBack: distance <= 0 is rejected" = match copyBackResult [65, 66] 0 1
  Err msg => expectEqual "copyBack: distance must be positive, got 0" msg
  Ok _ => fail "expected Err on distance <= 0"

-- ---------------------------------------------------------------------------
-- Properties
-- ---------------------------------------------------------------------------

-- `copyBack distance length` always grows the output by exactly `length`
-- elements, for any legal `distance` (1..seedLen) — a from-scratch identity
-- independent of what bytes actually land there.
prop "copyBack grows the output by exactly `length`, for any legal distance" (seed : List Int) (distRaw : Int) (lenRaw : Int) =
  let seedLen = length seed
  if seedLen == 0 then
    True  -- no legal distance exists over an empty window
  else
    let distance = 1 + abs distRaw % seedLen
    let len = abs lenRaw % 64
    let out = fromList seed
    match copyBack distance len out
      Ok _ => length out == seedLen + len
      Err _ => False

-- `inflate` of a single stored block round-trips arbitrary bytes: BFINAL=1,
-- BTYPE=00, LEN/NLEN framing it, followed by the bytes themselves. This is
-- an independent hand-rolled encoder (not `inflate`'s own logic reused), so
-- a bug shared between "how this property builds a stored block" and "how
-- `inflateStored` reads one" would have to be the SAME bug in both, not a
-- tautology any encoding/decoding pair would pass.
storedBlockStream : List Int -> Array Int
storedBlockStream bytes =
  let n = length bytes
  let lenLow = bitAnd n 255
  let lenHigh = shiftRight (bitAnd n mask16) 8
  let nlen = bitAnd (bitNot n) mask16
  let nlenLow = bitAnd nlen 255
  let nlenHigh = shiftRight nlen 8
  arrayFromList
    (1
      :: lenLow
      :: lenHigh
      :: nlenLow
      :: nlenHigh
      :: map (b => bitAnd b 255) bytes)

prop "inflate of a hand-built single stored block round-trips arbitrary bytes" (bytes : List Int) =
  let masked = map (b => bitAnd b 255) bytes
  match inflate (storedBlockStream bytes)
    Ok got => got == arrayFromList masked
    Err _ => False
