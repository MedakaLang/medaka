-- | gzip.lib.inflate — the DEFLATE block loop (RFC 1951) and the gzip member
--   decoder that wraps it (RFC 1952).
--
-- Phase 2 status: **stored blocks only** (`BTYPE=00`). Fixed Huffman
-- (`BTYPE=01`, Phase 2's real payload) and dynamic Huffman (`BTYPE=10`,
-- Phase 3) are dispatched to but not yet implemented — each returns a named
-- `Err` rather than being silently absorbed by a wildcard, so a later agent
-- adds them by replacing one match arm each, not by restructuring the loop.
-- `BTYPE=11` is reserved by the RFC and is always an `Err`.
--
-- The output accumulator (`out : MutArray Int`, built with `stdlib/mut_array.mdk`)
-- *is* the sliding window — see `copyBack` below and
-- `docs/design/GZIP-DESIGN.md` §"The sliding window and the overlap case".
-- Nothing here calls `copyBack` yet (no back-references exist before fixed/
-- dynamic Huffman blocks decode length/distance pairs), but it is written and
-- tested now so the window shape does not change under Phase 2/3.
--
-- A stored block's raw bytes are pushed into `out` alongside being part of
-- the decompressed output — that is not two operations, it is one `push` per
-- byte, since `out` serves both roles at once. A later block's back-reference
-- can therefore reach into a stored block's bytes, which is the "classic bug"
-- the design doc calls out: forgetting this makes stored-block bytes
-- invisible to a subsequent Huffman block's `copyBack`.

import array.{get, sliceClamped}
import mut_array.{MutArray, new, push, get as maGet, toArray, fromList}
import lib.bitio.{BitReader, newBitReader, getBits, alignByte, getBytesAligned}
import lib.container.{parseGzipHeader, parseGzipTrailer}
import lib.crc32.{crc32}
import test.{expectEqual, fail}

-- ---------------------------------------------------------------------------
-- Named constants (STYLE §12 — name the meaning)
-- ---------------------------------------------------------------------------

btypeStored : Int
btypeStored = 0

btypeFixedHuffman : Int
btypeFixedHuffman = 1

btypeDynamicHuffman : Int
btypeDynamicHuffman = 2

btypeReserved : Int
btypeReserved = 3

-- 16-bit wraparound mask, 0xFFFF — LEN/NLEN are each a raw 16-bit field.
mask16 : Int
mask16 = 65535

-- 32-bit wraparound mask, 0xFFFFFFFF — ISIZE is uncompressed length mod 2^32.
mask32 : Int
mask32 = 4294967295

-- ---------------------------------------------------------------------------
-- The sliding window: `copyBack`
-- ---------------------------------------------------------------------------

{- | Copy `length` bytes from `distance` bytes back in `out` to the end of
   `out`, READ-then-PUSH one byte at a time (never a `blit`, never a
   pre-snapshotted slice — see the module header and the design doc's
   "overlap case" section: when `distance < length` the source region
   overlaps the bytes this very call is producing, and `distance = 1` — pure
   run-length repetition of the last byte — is the common case that a
   whole-slice copy gets wrong).

   `distance` must be in `1..length(out)` (inclusive at the top: `distance ==
   length(out)` legally refers to the very first byte ever pushed). Anything
   else is a malformed stream, not a wrap-around, and is an `Err`.

   Design-doc-verified shape: `copyBack 1 4` over `[65, 66]` yields
   `[65, 66, 66, 66, 66, 66]` (RLE of the trailing byte). -}
export copyBack : Int -> Int -> MutArray Int -> Result String Unit
copyBack distance len out =
  let outLen = length out
  if distance <= 0 then
    Err "copyBack: distance must be positive, got \{distance}"
  else if distance > outLen then
    Err "copyBack: distance \{distance} exceeds current output length \{outLen}"
  else
    copyBackGo distance len out

copyBackGo : Int -> Int -> MutArray Int -> Result String Unit
copyBackGo distance remaining out
  | remaining <= 0 = Ok ()
  | otherwise =
    let outLen = length out
    match maGet (outLen - distance) out
      Some b =>
        let _ = push b out
        copyBackGo distance (remaining - 1) out
      -- `outLen` only grows across this loop (one `push` per iteration) and
      -- `distance <= outLen` was already established by `copyBack` before
      -- the first call, so `outLen - distance` is always a valid live index
      -- — this arm is unreachable. Panic rather than a quiet `Err`: a
      -- violated loop invariant here is a bug in this module, not bad input.
      None => panic "copyBack: source index out of range (unreachable)"

-- ---------------------------------------------------------------------------
-- Stored blocks (BTYPE 00)
-- ---------------------------------------------------------------------------

-- NLEN must be the one's complement of LEN, both taken as raw 16-bit fields.
checkNlen : Int -> Int -> Result String Unit
checkNlen len nlen =
  if bitAnd (bitNot len) mask16 == nlen then
    Ok ()
  else
    Err "stored block: NLEN (\{nlen}) is not the one's complement of LEN (\{len})"

-- Push every byte of `bytes` onto `out`, in order — this is what makes a
-- stored block's payload part of the sliding window, not just part of the
-- output (see the module header).
pushAll : Array Int -> MutArray Int -> Unit
pushAll bytes out = pushAllGo bytes 0 (arrayLength bytes) out

pushAllGo : Array Int -> Int -> Int -> MutArray Int -> Unit
pushAllGo bytes i n out
  | i >= n = ()
  | otherwise = match get i bytes
    Some b =>
      let _ = push b out
      pushAllGo bytes (i + 1) n out
    None => ()

-- | A stored block: byte-align, `LEN`/`NLEN` (2 bytes LE each, validated
--   against each other), then `LEN` raw bytes copied verbatim into `out`.
inflateStored : BitReader -> MutArray Int -> Result String Unit
inflateStored r out =
  let _ = alignByte r
  do
    len <- getBits 16 r
    nlen <- getBits 16 r
    _ <- checkNlen len nlen
    bytes <- getBytesAligned len r
    let _ = pushAll bytes out
    Ok ()

-- ---------------------------------------------------------------------------
-- Block dispatch — the Phase 2/3 seam
-- ---------------------------------------------------------------------------

-- | Decode one block of the given `BTYPE` into `out`. `BTYPE=00` is real;
--   `BTYPE=01`/`10` are named stubs (Phase 2/3), and `BTYPE=11` is always
--   invalid per RFC 1951 §3.2.3. Adding fixed/dynamic Huffman is meant to be
--   a one-arm replacement here, not a restructuring of `inflateBlocks`.
inflateBlock : Int -> BitReader -> MutArray Int -> Result String Unit
inflateBlock btype r out
  | btype == btypeStored = inflateStored r out
  | btype == btypeFixedHuffman =
    Err "fixed Huffman blocks not yet implemented (Phase 2)"
  | btype == btypeDynamicHuffman =
    Err "dynamic Huffman blocks not yet implemented (Phase 3)"
  | btype == btypeReserved =
    Err "invalid DEFLATE block: BTYPE=3 is reserved (RFC 1951 §3.2.3)"
  | otherwise = panic "inflateBlock: BTYPE \{btype} out of the 0..3 range getBits 2 can produce (unreachable)"

-- Read BFINAL (1 bit) + BTYPE (2 bits), both LSB-first, decode one block,
-- and loop until a block with BFINAL=1.
inflateBlocks : BitReader -> MutArray Int -> Result String Unit
inflateBlocks r out = do
  bfinal <- getBits 1 r
  btype <- getBits 2 r
  _ <- inflateBlock btype r out
  if bfinal == 1 then Ok () else inflateBlocks r out

{- | Decode a raw DEFLATE stream (RFC 1951) — no gzip/zlib framing — to its
   uncompressed bytes.

   > inflate (arrayFromList [1, 3, 0, 252, 255, 65, 66, 67])
   Ok [|65, 66, 67|]
-}
export inflate : Array Int -> Result String (Array Int)
inflate bytes =
  let r = newBitReader bytes
  let out = new ()
  do
    _ <- inflateBlocks r out
    Ok (toArray out)

-- ---------------------------------------------------------------------------
-- gzip member decode: header + inflate + trailer validation
-- ---------------------------------------------------------------------------

checkCrc : Int -> Int -> Result String Unit
checkCrc ours stored =
  if ours == stored then
    Ok ()
  else
    Err "gzip trailer CRC-32 mismatch: computed \{ours}, trailer says \{stored}"

checkIsize : Int -> Int -> Result String Unit
checkIsize ours stored =
  if bitAnd ours mask32 == stored then
    Ok ()
  else
    Err "gzip trailer ISIZE mismatch: computed \{ours} (mod 2^32), trailer says \{stored}"

{- | Decode a whole `.gz` member: parse the header, inflate the DEFLATE
   payload between the header and the 8-byte trailer, then validate BOTH
   trailer fields against the decoded bytes — CRC-32 and ISIZE. A checksum
   that is never checked is decoration, not a checksum, so a mismatch on
   either is a named `Err`, not a silently accepted decode.

   The bytes below are a hand-built minimal gzip member wrapping a single
   stored DEFLATE block for `"hi"`, verified against the system `gunzip`
   (`gunzip -c` on these exact bytes prints `hi`, exit 0).

   > gunzipMember (arrayFromList [31,139,8,0,0,0,0,0,0,3,1,2,0,253,255,104,105,172,42,147,216,2,0,0,0])
   Ok [|104, 105|]
-}
export gunzipMember : Array Int -> Result String (Array Int)
gunzipMember bytes = do
  (hdr, off) <- parseGzipHeader bytes
  let n = arrayLength bytes
  let payload = sliceClamped off (n - 8) bytes
  decoded <- inflate payload
  (storedCrc, storedIsize) <- parseGzipTrailer bytes
  _ <- checkCrc (crc32 decoded) storedCrc
  _ <- checkIsize (arrayLength decoded) storedIsize
  Ok decoded

-- ---------------------------------------------------------------------------
-- Tests — external-oracle vectors, hand-derived shapes, and pinned
-- not-yet-implemented boundaries. No golden is ever captured from this
-- module's own output (see gzip/README.md "Testing policy").
-- ---------------------------------------------------------------------------

-- `printf 'hello' | gzip -n -c` — the same bytes `gzip/main.mdk` uses. `gzip`
-- picks BTYPE=1 (fixed Huffman) for input this small, so this pins the
-- honest Phase-2 boundary: this exact real-world stream is NOT yet
-- decodable, and the reason why is named, not a generic parse failure.
helloGz : Array Int
helloGz = arrayFromList
  [
    31,
    139,
    8,
    0,
    0,
    0,
    0,
    0,
    0,
    3,
    203,
    72,
    205,
    201,
    201,
    7,
    0,
    134,
    166,
    16,
    54,
    5,
    0,
    0,
    0,
  ]

test "gunzipMember on real hello.gz (fixed Huffman) is the honest Phase-2 boundary" = expectEqual (Err "fixed Huffman blocks not yet implemented (Phase 2)") (gunzipMember helloGz)

