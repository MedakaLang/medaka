-- | parsec — a small char-level parser-combinator library, written in Medaka.
--
-- A `Parser a` wraps a function from (input char array + position) to a
-- `PResult a`, which is either success (value + new position) or failure
-- (message + position).  Position threading is EXPLICIT — there is no hidden
-- state monad; every primitive returns the position it consumed up to.
--
-- The type is given `DeferredMappable` / `DeferredApplicative` /
-- `DeferredThenable` instances so that
-- `defer`-notation sequences parsers, and a plain `orElse`/`noMatch` pair
-- (`Alternative` requires `Applicative`, which an `Effect`-indexed container
-- cannot have) that is LEFT-BIASED with FULL BACKTRACKING: `orElse p q` runs `p` at the
-- current position; if `p` fails it runs `q` at the SAME position (the input is
-- immutable and we never mutate the position on failure, so backtracking is
-- automatic).

import array
import list.{reverse}
import string.{toChars, isDigit, isAlpha, isSpace}

-- | Parse result: success carries the value and the position just past what was
--   consumed; failure carries a message and the position at which it occurred.
export data PResult a = POk a Int | PErr String Int

-- | A parser is a function from (input, position) to a result.  It STORES that
--   function rather than running it, so the type indexes the container by the
--   row the stored arrow performs (`Deferred*`, core.mdk / #825) instead of
--   charging a callback's row on the combinator's own arrow — the latter would
--   force the stored arrow pure and run an effectful callback inside a value
--   typed `<>`.  Parsing this library's inputs performs nothing, so the exported
--   `Parser a` alias pins the index to `<>`.
export data ParserE (e : Effect) a =
  | ParserE (Array Char -> Int -> <e> PResult a)

export type Parser a = ParserE <> a

-- Run the wrapped function.
export
runP : ParserE e a -> Array Char -> Int -> <e> PResult a
runP (ParserE f) input pos = f input pos

-- ---------------------------------------------------------------------------
-- Typeclass instances
-- ---------------------------------------------------------------------------

-- Higher-kinded impls use the BARE constructor head: `ParserE`, not
-- `ParserE e a`.  Every body STORES its callback inside the `ParserE` arrow
-- rather than applying it, which is what lets the callback's row ride the
-- index (an eager application would perform `<e>` at construction and is
-- rejected, `T-EFFECT-INDEX-EAGER`).
--
-- The match-over-result bodies sit directly inside `( ... )` using the
-- bracketed-block-expression feature; the closing `)` lives on the last arm's
-- line.  Guards-based helpers (`satisfyStep`, `eofStep`) stay as named
-- top-level functions since multi-clause guard syntax can't be inlined.

export impl DeferredMappable ParserE where
  deferMap g p = ParserE (input pos => match runP p input pos
    POk a pos2 => POk (g a) pos2
    PErr m ep => PErr m ep)

export impl DeferredApplicative ParserE where
  deferPure a = ParserE (_ pos => POk a pos)
  deferAp pf pa = ParserE (input pos => match runP pf input pos
    PErr m ep => PErr m ep
    POk f pos2 => match runP pa input pos2
      POk a pos3 => POk (f a) pos3
      PErr m2 ep2 => PErr m2 ep2)

export impl DeferredThenable ParserE where
  deferThen p k = ParserE (input pos => match runP p input pos
    PErr m ep => PErr m ep
    POk a pos2 => runP (k a) input pos2)

-- Left-biased, full-backtracking alternative.  Plain functions rather than an
-- `Alternative` impl: that interface `requires Applicative f` at kind
-- `Type -> Type`, which `ParserE : Effect -> Type -> Type` cannot satisfy.
-- `noMatch` always fails;
-- `orElse p q` tries `p`, and on failure re-runs `q` from the ORIGINAL pos.
--
-- ERROR SELECTION: when BOTH branches fail, we keep the failure that got
-- FARTHEST into the input, rather than (as a naive left-biased `orElse` does)
-- unconditionally keeping the RIGHTMOST branch's message.  The deepest failure
-- is almost always the informative one: a `choice` over N alternatives where the
-- first alternative consumed 40 characters before choking should blame column
-- 40, not report the last (and shallowest) alternative's "no match at 0".
-- Ties go to the LEFT branch, preserving left-bias.
--
-- Note the residual limitation this does NOT fix: an alternative that SUCCEEDS
-- discards any deeper failure explored underneath it (`orElse deepFailingP (deferPure
-- x)` — the shape of `optional`/`many`/`chainl1`'s loop tail).  Fixing that needs
-- the farthest-failure to be threaded through SUCCESS as well, i.e. carried in
-- `POk` too.  See `sqlite/findings/sql-parser-expr.md` (F5).
export
noMatch : ParserE e a
noMatch = ParserE (_ pos => PErr "noMatch" pos)

export
orElse : ParserE e a -> ParserE e a -> ParserE e a
orElse p q = ParserE (input pos => match runP p input pos
  POk a pos2 => POk a pos2
  PErr m1 e1 => keepFarther m1 e1 (runP q input pos))

-- Keep whichever of the two failures reached farther into the input; a success
-- from the right branch always wins outright.  Ties favour the LEFT branch.
keepFarther : String -> Int -> PResult a -> PResult a
keepFarther _ _ (POk a pos2) = POk a pos2
keepFarther m1 e1 (PErr m2 e2) = if e1 >= e2 then PErr m1 e1 else PErr m2 e2

-- ---------------------------------------------------------------------------
-- Primitives
-- ---------------------------------------------------------------------------

-- | Fail unconditionally with a message.
export
failWith : String -> Parser a
failWith msg = ParserE (_ pos => PErr msg pos)

-- ---------------------------------------------------------------------------
-- Error-reporting combinators
--
-- `orElse` picks the FARTHEST failure when both branches fail (see
-- its definition above).  That heuristic is only as good as the positions the
-- branches report, so two combinators exist to control them:
--
--   * `attempt` — rewind a failure's REPORTED position back to where the parser
--     started.  Use it around a speculative multi-character token (`<=`, a
--     keyword, a number) so that half-matching one does not look like "deep
--     progress" and hijack the error message.
--   * `label` — replace the message of a failure that occurred at the parser's
--     START position (i.e. one that consumed nothing), leaving deeper, more
--     specific failures alone.  This is the `<?>` of classic parsec.
-- ---------------------------------------------------------------------------

-- | Run `p`, but if it fails, report the failure at the position where `p`
--   STARTED rather than wherever inside `p` it actually gave up.
--
--   Input backtracking is already automatic (`orElse` re-runs the alternative
--   from the original position); `attempt` fixes only the reported POSITION, so
--   that a partially-consumed token does not out-rank a genuinely deeper error.
--
-- > runParser (orElse (attempt (string "abc")) (string "abd")) "abd"
-- Ok "abd"
export
attempt : Parser a -> Parser a
attempt p = ParserE (input pos => rewindErr pos (runP p input pos))

rewindErr : Int -> PResult a -> PResult a
rewindErr _ (POk a pos2) = POk a pos2
rewindErr pos (PErr m _) = PErr m pos

-- | Replace `p`'s error message when `p` failed WITHOUT consuming input (its
--   failure position is still the start position).  A failure deeper inside `p`
--   is left untouched — it is more specific than the label.
--
-- > runParser (label "expected a digit" digit) "x"
-- Err "expected a digit at 0"
export
label : String -> Parser a -> Parser a
label msg p = ParserE (input pos => relabel msg pos (runP p input pos))

relabel : String -> Int -> PResult a -> PResult a
relabel _ _ (POk a pos2) = POk a pos2
relabel msg pos (PErr m ep) = if ep == pos then PErr msg ep else PErr m ep

-- | Consume one char if it satisfies the predicate.
export
satisfy : (Char -> Bool) -> Parser Char
satisfy pred = ParserE (satisfyStep pred)

satisfyStep : (Char -> Bool) -> Array Char -> Int -> PResult Char
satisfyStep pred input pos
  | pos >= arrayLength input = PErr "unexpected end of input" pos
  | pred input[pos] = POk input[pos] (pos + 1)
  | otherwise = PErr "unexpected character" pos

-- | Consume any single char.
export
anyChar : Parser Char
anyChar = satisfy (_ => True)

-- | Consume exactly the given char.
--
-- > runParser (char 'a') "abc"
-- Ok 'a'
-- > runParser (char 'a') "xyz"
-- Err "unexpected character at 0"
export
char : Char -> Parser Char
char c = satisfy (== c)

-- | Match the empty input (end of input).  Yields Unit; consumes nothing.
export
eof : Parser Unit
eof = ParserE eofStep

eofStep : Array Char -> Int -> PResult Unit
eofStep input pos
  | pos >= arrayLength input = POk () pos
  | otherwise = PErr "expected end of input" pos

-- Convenience character classes.
export
digit : Parser Char
digit = satisfy isDigit

export
letter : Parser Char
letter = satisfy isAlpha

export
space : Parser Char
space = satisfy isSpace

-- ---------------------------------------------------------------------------
-- Combinators
-- ---------------------------------------------------------------------------

-- | Zero-or-more.  Uses explicit position threading (a loop), since `many` of
--   a parser that consumes nothing must terminate.
export
many : Parser a -> Parser (List a)
many p = ParserE (input pos => manyGo p input pos [])

manyGo : Parser a -> Array Char -> Int -> List a -> PResult (List a)
manyGo p input pos acc = match runP p input pos
  PErr _ _ => POk (reverse acc) pos
  POk a pos2 =>
    if pos2 == pos then
      POk (reverse acc) pos2  -- no progress: stop to avoid a loop
    else
      manyGo p input pos2 (a :: acc)

-- | One-or-more.  Written with `do`-notation to EXERCISE Thenable Parser.
export
some : Parser a -> Parser (List a)
some p = defer
  x <- p
  xs <- many p
  deferPure (x :: xs)

-- | Alias for `some`.
export
many1 : Parser a -> Parser (List a)
many1 p = some p

-- | One-or-more `p` separated by `sep`.
export
sepBy1 : Parser a -> Parser b -> Parser (List a)
sepBy1 p sep = defer
  x <- p
  xs <- many (defer
    _ <- sep
    p)
  deferPure (x :: xs)

-- | Zero-or-more `p` separated by `sep`.
export
sepBy : Parser a -> Parser b -> Parser (List a)
sepBy p sep = orElse (sepBy1 p sep) (deferPure [])

-- | Try `p`; produce `Some` on success, `None` (consuming nothing) on failure.
export
optional : Parser a -> Parser (Option a)
optional p = orElse (deferMap Some p) (deferPure None)

-- | `between open close p` parses `open`, then `p`, then `close`, yielding `p`.
export
between : Parser open -> Parser close -> Parser a -> Parser a
between open close p = defer
  _ <- open
  x <- p
  _ <- close
  deferPure x

-- | First successful parser in the list; fails if all fail.
export
choice : List (Parser a) -> Parser a
choice [] = failWith "choice: no alternatives"
choice (q :: rest) = orElse q (choice rest)

-- | Match a literal string, yielding it back.
export
string : String -> Parser String
string s = ParserE (input pos => stringGo (toChars s) 0 input pos s)

stringGo : Array Char -> Int -> Array Char -> Int -> String -> PResult String
stringGo want wi input pos original =
  if wi >= arrayLength want then
    POk original pos
  else if pos >= arrayLength input then
    PErr "unexpected end of input" pos
  else if input[pos] == want[wi] then
    stringGo want (wi + 1) input (pos + 1) original
  else
    PErr "string: mismatch" pos

-- | Left-associative chaining of `p` separated by an operator parser `op`
--   whose value is a binary function.  `1-2-3` parses as `((1-2)-3)`.
--
--   COMMITTED after the operator: only the OPERATOR is speculative (`optional
--   op` backtracks cleanly when there is no operator left).  Once an operator HAS
--   matched, the right operand is MANDATORY, and its failure propagates instead
--   of being swallowed.
--
--   This matters for error quality, and it is also the faithful reading of
--   classic Parsec's `chainl1`: there, `<|>` declines to backtrack once the left
--   branch has CONSUMED input, so a matched operator already commits the parse.
--   Our `orElse` backtracks unconditionally, so the naive transcription
--   (`orElse (defer f <- op; y <- p; …) (deferPure acc)`) silently turns `1 +` into a
--   successful parse of `1` with `+` left over — and then the REAL error surfaces
--   far away, as a bogus "expected end of input" pointing at the operator rather
--   than at the missing operand.  Committing restores the intended behaviour.
export
chainl1 : Parser a -> Parser (a -> a -> a) -> Parser a
chainl1 p op = defer
  x <- p
  chainl1Rest p op x

chainl1Rest : Parser a -> Parser (a -> a -> a) -> a -> Parser a
chainl1Rest p op acc = defer
  f <- optional op
  chainl1Step p op acc f

chainl1Step : Parser a ->
  Parser (a -> a -> a) ->
  a ->
  Option (a -> a -> a) ->
  Parser a
chainl1Step _ _ acc None = deferPure acc
chainl1Step p op acc (Some f) = defer
  y <- p
  chainl1Rest p op (f acc y)

-- | Skip zero-or-more whitespace.
export
spaces : Parser Unit
spaces = ParserE (input pos => POk () (skipSpaces input pos))

skipSpaces : Array Char -> Int -> Int
skipSpaces input pos =
  if pos >= arrayLength input then
    pos
  else if isSpace input[pos] then
    skipSpaces input (pos + 1)
  else
    pos

-- ---------------------------------------------------------------------------
-- Entry point
-- ---------------------------------------------------------------------------

-- | Run a parser over a whole `String`, starting at position 0.  Reports the
--   success value or a positioned error message.
--
-- > runParser (string "ab") "abc"
-- Ok "ab"
-- > runParser digit "x"
-- Err "unexpected character at 0"
export
runParser : Parser a -> String -> Result String a
runParser p s = match runP p (toChars s) 0
  POk a _ => Ok a
  PErr m pos => Err "\{m} at \{pos}"
