#!/bin/sh
# Medaka pre-commit hook — reject commits containing unformatted or lint-failing .mdk
# source, or a snapshot suite the author forgot to re-run.
#
# Checks 1–2 run over every staged .mdk (added/copied/modified); `test/` fixtures are
# deliberately excluded from BOTH — they are golden inputs kept intentionally unformatted
# and often violate style rules on purpose. Check 4 has a wider trigger (see below).
#
#   1. FORMAT: `medaka fmt --check` — aborts if any file differs from its formatted form.
#   2. LINT:   ONE `medaka lint --cache --internal` process over the staged .mdk plus
#      the $CROSS_ROOTS project roots (the roots feed the cross-file scan that a
#      per-staged-file pass cannot do; `--cache` makes them a replay). Which rules
#      are checked, and how, is read from the binary's own registry
#      (`medaka lint --list-rules --names --ratchet=... --tier=...`), never listed
#      here: a GATED rule may never fire at all (any NEW finding fails the commit);
#      a BASELINED rule's per-file count, pinned in test/lint_baseline.toml, may
#      only fall (a file with findings but no row fails too). A genuine intentional
#      exception is silenced inline with an ESLint-style directive comment
#      (`-- lint-disable-next-line <rule>`, also -line / -file forms). Counts move
#      only by regenerating the file (`sh test/diff_compiler_lint_baseline.sh
#      --write`), never by hand. Only findings in STAGED files, and cross-file
#      findings, block the commit: an unstaged edit elsewhere is not this commit's.
#      test/diff_compiler_lint_baseline.sh re-checks the whole tree in CI, over the
#      same project roots, so `--no-verify` cannot smuggle an increase past this.
#   4. SNAPSHOT: `make snapshot-check` — the per-stage snapshot suite, CHECK ONLY.
#   5. LEXTOK:   an inline `test/bin/lex_main` compare — OPPORTUNISTIC: only runs if
#      test/bin/lex_main already exists (this hook never builds an oracle). Scoped to
#      staged files (from check 1's set) that already have a sibling .lextok.golden.
#   6. SHOUT DIFF: rejects a commit that ADDS a new shout line to a staged .mdk
#      (check 1's file set) — either a 🚨/⚠️/🔒 sigil line, or the sigil-free shout
#      register (a run of 3+ consecutive ALL-CAPS words), the latter scoped to
#      comment-scope added lines only. Diff-scoped on ADDED lines only (`git diff
#      --cached -U0`) — an existing shout that is merely touched but textually
#      unchanged does not trigger, and it needs no built binary. CI twin:
#      test/diff_compiler_comment_shout_diff_test.mdk (#2621, widened #3032).
#   6b. COMMENT-REGISTER BASELINE: `test/comment_register_census.sh --check
#      test/comment_register_baseline.toml <staged files>` — a per-file COUNT
#      ratchet (not diff-scoped like 6) over the 8 baselined comment-register
#      classes, so a MOVED/duplicated existing line that raises a staged
#      file's class total still fails even when check 6's added-line diff
#      wouldn't catch it on its own. A file with a nonzero class count and no
#      row in the baseline fails closed. Counts move only by regenerating
#      (`sh test/comment_register_census.sh --write
#      test/comment_register_baseline.toml`), never by hand. CI twin:
#      test/diff_compiler_comment_shout_diff_test.mdk's second assertion
#      (#3034).
#
# ── #491: this hook covers ONE of five golden families outright, plus one more
# OPPORTUNISTICALLY (check 5, only when test/bin/lex_main happens to already be
# built) — it never builds an oracle itself, and a fresh clone/worktree has none.
# The three remaining families (stdlib/<f>.test.golden, test/selfproc_goldens/**,
# test/native_cli_goldens/check/**) need a full oracle set + a heavier run and
# stay CI-only. `.test.golden` was tried here and REMOVED (see #536 review):
# `test/diff_compiler_fmt_test.mdk` runs four fixture assertions (mixed.mdk, list.mdk,
# test_decls.mdk, hash_negative_hash.mdk) UNCONDITIONALLY regardless of the file
# arguments passed to it — so scoping this hook's call to only the staged file(s)
# does not stop it from also re-checking those four fixtures against whatever
# test_main oracle happens to be sitting in test/bin/, and two of those four
# (test_decls.mdk, hash_negative_hash.mdk) have NO .test.golden at all — their
# expected output is an inline string literal in the gate script — so a stale
# oracle can reject a commit that never touched them, with no working per-file
# remediation. That is the exact #459 disease ("a gate names a recipe that does
# nothing"), so this hook does not carry it. Silence here was historically
# misread as "goldens are complete", so the hook NAMES what it did and did not
# check on every run that reaches this point (see the final section) — that is
# the fix for `.test.golden` until `test/diff_compiler_fmt_test.mdk` itself is scoped
# (tracked separately; not this hook's file to fix).
#
# ── check 4, and the one thing a hook must never be ──────────────────────────
# The hook's job here is "you did not forget to run the suite". It is NOT, and cannot be,
# the review gate for BLESSING a snapshot: the author runs the hook, and the bless button
# is right there. A hook that offered to re-cut the goldens it just found stale would be
# a rubber stamp with a progress bar. So it runs `--check` and stops; re-cutting is an
# explicit, named, human act:
#
#     sh test/snapshot_bless.sh --bless <the file you changed>
#
# and the actual review gate is `git diff` on test/snapshots/ — which is what a reviewer
# and every CI shard look at. (See compiler/tools/snapshot.mdk for the three locks on
# --bless: scoped, non-creating, and refuses diagnostic-bearing sections outright.)
#
# The trigger is WIDER than checks 1–3: the corpus contains the compiler's own 50 sources,
# all of stdlib, AND test/{parse,parse_only,diff}_fixtures — so a staged test/ fixture
# moves a snapshot too, and so does a pure `medaka fmt` reflow of a compiler source. The
# hook therefore fires on ANY staged .mdk (test/ included) or any staged
# test/snapshots/**.md.
#
# Install (from the repo root):
#     cp .githooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#     chmod +x "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# Binary lookup order: $MEDAKA, then <repo-root>/medaka, then `medaka` on PATH.
# If none is found: a commit with NOTHING relevant staged (no .mdk, no snapshot)
# is allowed silently — this hook has nothing to check either way. But a commit
# that DOES stage a .mdk (or a snapshot) is FAILED (#437) — a missing binary is
# the normal state of a fresh worktree, and silently allowing it here would mean
# exactly the commits that need fmt/lint most (an agent's first .mdk commit in a
# freshly-spawned worktree) get none. Emergency bypass either way: `git commit --no-verify`.
#
# Note: this checks the WORKING-TREE copy of each staged file (the normal
# full-staging case). Partially-staged files are checked as they exist on disk.
#
# #1179: check 4 specifically also verifies staging state directly (an unstaged
# snapshot diff fails outright, before the suite even runs — see check 4 below), because
# for that one check "current on disk" is not the same claim as "part of this commit".
# PRECOMMIT_SNAPSHOT_DEFER=1 skips check 4 alone for a commit that intentionally defers
# its golden to a later commit in the same PR; fmt/lint/lextok stay live either way.
set -u

# Lint enforcement reads its rule lists from the binary (see check 2), so a rule
# added to the registry is enforced here without touching this file.
LINT_BASELINE_FILE="test/lint_baseline.toml"
# Roots of the project-wide cross-file scan. Narrower than the per-file check on
# purpose: the other projects carry cross-file findings that are not yet drained
# (#2881), so scanning them would block every commit.
CROSS_ROOTS="compiler stdlib sqlite"

ROOT="$(git rev-parse --show-toplevel)"

# Staged .mdk files, excluding test/ fixtures (checks 1–3).
files="$(git diff --cached --name-only --diff-filter=ACM -- '*.mdk' ':(exclude)test/**')"
# Anything that can move a snapshot (check 4): ANY staged .mdk — test/ fixtures included,
# they are in the corpus — plus the snapshots themselves.
snapfiles="$(git diff --cached --name-only --diff-filter=ACMD -- '*.mdk' 'test/snapshots/*.md')"
[ -z "$files" ] && [ -z "$snapfiles" ] && exit 0

# Union of both sets, deduped — everything this hook would check if a binary
# were available. Computed BEFORE the binary lookup below so the "no binary"
# branch can name exactly what it is failing to check (#437).
staged_mdk="$(printf '%s\n%s\n' "$files" "$snapfiles" | grep -v '^$' | sort -u)"

MEDAKA="${MEDAKA:-$ROOT/medaka}"
if [ ! -x "$MEDAKA" ]; then
  if command -v medaka >/dev/null 2>&1; then
    MEDAKA="$(command -v medaka)"
  else
    # #437: staged .mdk (or a snapshot) with no medaka binary reachable is a REAL
    # coverage gap, not a no-op commit — this hook is the ONLY fmt/lint enforcement
    # in the repo (CI does not check tree fmt/lint cleanliness). Unlike the "nothing
    # relevant staged" early-exit above, this does NOT silently allow the commit.
    echo "" >&2
    echo "✗ pre-commit: medaka binary not found — cannot check staged .mdk:" >&2
    for f in $staged_mdk; do echo "      $f" >&2; done
    echo "" >&2
    echo "  This hook is the ONLY fmt/lint enforcement in the repo (CI does not check" >&2
    echo "  tree fmt/lint cleanliness), so committing unchecked would ship silently." >&2
    echo "  Build it:      make -C $ROOT medaka" >&2
    echo "  Or point at one:  MEDAKA=/path/to/medaka git commit ...   (or add to PATH)" >&2
    echo "  Bypass once:   git commit --no-verify" >&2
    echo "" >&2
    exit 1
  fi
fi

# ── 1. formatter check ───────────────────────────────────────────────────────
bad=""
for f in $files; do
  [ -f "$f" ] || continue
  "$MEDAKA" fmt --check "$f" >/dev/null 2>&1 || bad="$bad $f"
done

if [ -n "$bad" ]; then
  echo "" >&2
  echo "✗ pre-commit: unformatted (or unparseable) .mdk staged for commit:" >&2
  for f in $bad; do echo "      $f" >&2; done
  echo "" >&2
  echo "  Format them:  medaka fmt --write$bad" >&2
  echo "  Re-stage:     git add$bad" >&2
  echo "  Bypass once:  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# ── 2. lint check (gated + baselined + cross-file, one process) ─────────────
rule_names() { "$MEDAKA" lint --list-rules --names "$@" 2>/dev/null; }
csv() { paste -sd, - ; }

cross_nl="$(rule_names --ratchet=gated --tier=cross)"
CROSS_RULES="$(printf '%s\n' "$cross_nl" | csv)"
BASELINED_RULES="$(rule_names --ratchet=baselined | csv)"
# The per-file gated set is every gated rule minus the ones that run as the
# cross-file scan; the scan is named separately in --only/--deny below.
gated_file=""
for n in $(rule_names --ratchet=gated); do
  case "
$cross_nl
" in
    *"
$n
"*) ;;
    *) gated_file="$gated_file,$n" ;;
  esac
done
GATED_RULES="${gated_file#,}"
if [ -z "$GATED_RULES" ]; then
  echo "" >&2
  echo "✗ pre-commit: $MEDAKA could not list the lint rules (is it older than this hook?)." >&2
  echo "  Rebuild it:   make -C $ROOT medaka" >&2
  echo "  Bypass once:  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi
ALL_GATED="$GATED_RULES${CROSS_RULES:+,$CROSS_RULES}"

# Targets: the cross-file roots, plus each staged file that lies outside them.
lintfiles=""
for f in $files; do
  [ -f "$f" ] && lintfiles="$lintfiles $f"
done
targets=""
for r in $CROSS_ROOTS; do
  [ -d "$ROOT/$r" ] && targets="$targets $r"
done
for f in $lintfiles; do
  inside=0
  for r in $CROSS_ROOTS; do
    case "$f" in "$r"/*) inside=1 ;; esac
  done
  [ "$inside" = 1 ] || targets="$targets $f"
done

lintout="$(mktemp)"
trap 'rm -f "$lintout"' EXIT
if [ -n "$lintfiles" ]; then
  lintst=0
  # shellcheck disable=SC2086
  "$MEDAKA" lint --cache --internal --baseline="$ROOT/$LINT_BASELINE_FILE" \
    --only="$ALL_GATED,$BASELINED_RULES" --deny="$ALL_GATED" \
    $targets >"$lintout" 2>&1 || lintst=$?
  if [ "$lintst" -ne 0 ]; then
    # An error counts when it is in a staged file or in the cross-file section.
    blocking="$(awk -v staged="$lintfiles " '
      /^cross-file:$/ { cross = 1 }
      /^error: / {
        if ($2 !~ /:[0-9]+:[0-9]+:$/) { print "(finding without a location)"; next }
        split($2, loc, ":")
        if (cross || index(staged, " " loc[1] " ") > 0) print loc[1]
      }' "$lintout" | sort -u)"
    # A failure that printed no error line at all (a crash, an unreadable file)
    # is never passed over.
    if [ -n "$blocking" ] || ! grep -q '^error: ' "$lintout"; then
      echo "" >&2
      echo "✗ pre-commit: lint violated (a gated rule may not fire at all; a baselined" >&2
      echo "  rule's count may only fall below its row in $LINT_BASELINE_FILE):" >&2
      printf '%s\n' "$blocking" | while IFS= read -r f; do [ -n "$f" ] && echo "      $f" >&2; done
      grep -q '^error: ' "$lintout" || sed 's/^/      /' "$lintout" | head -20 >&2
      echo "" >&2
      echo "  See findings:  medaka lint --internal --baseline=$LINT_BASELINE_FILE --only=$ALL_GATED,$BASELINED_RULES$lintfiles" >&2
      echo "  If intentional, silence inline with a directive comment above the site:" >&2
      echo "                 -- lint-disable-next-line <rule>" >&2
      echo "  A count that legitimately moves is re-pinned by REGENERATING the file," >&2
      echo "  never by editing it:  sh test/diff_compiler_lint_baseline.sh --write" >&2
      echo "  Bypass once:   git commit --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  fi
fi

# ── 4. snapshot suite (CHECK only — this hook can never bless) ────────────────
# ~7s, no oracle binaries needed. Runs against the BUILT ./medaka, so if you have staged
# a compiler change you have not rebuilt, this checks the OLD compiler's behaviour — it
# still catches the common case it is here for (a fixture/source edit that moved a
# `# SOURCE` section), and `make medaka` before committing makes it exact.
#
# #1179: `--bless` writes to the WORKING TREE, and the gate below reads the working
# tree too (see the "Note" in the file header) — NOT the index. That means a bless you
# forgot to `git add` is invisible to this check: it passes because the golden looks
# current on disk, even though the commit about to be made does not contain it. That is
# a SILENT version of exactly the hazard AGENTS.md's "bless in the same commit" rule
# exists to prevent (main observing a moved source with a stale committed golden), so it
# is closed unconditionally, before the (expensive) suite even runs: any snapshot file
# with an UNSTAGED working-tree diff is refused outright — "blessed but not staged".
snap_unstaged="$(git diff --name-only -- 'test/snapshots/*.md' 2>/dev/null)"
if [ -n "$snap_unstaged" ] && [ -n "$snapfiles" ]; then
  echo "" >&2
  echo "✗ pre-commit: snapshot(s) blessed on disk but NOT staged — this commit would land" >&2
  echo "  the moved source with the OLD golden still committed:" >&2
  echo "" >&2
  printf '%s\n' "$snap_unstaged" | sed 's/^/      /' >&2
  echo "" >&2
  echo "  git add $(printf '%s' "$snap_unstaged" | tr '\n' ' ')  and read the diff, then re-commit." >&2
  echo "" >&2
  exit 1
fi

# #1179: a source-only commit (golden intentionally deferred to a LATER commit in the
# SAME PR — the "goldens are re-cut in their own terminal commit" convention) legitimately
# fails check 4, because the golden for the staged source is, by construction, not staged
# yet. That is real and correct — check 4 enforces a per-push property (main must never
# observe a moved source without its golden) at per-commit granularity, and the merge
# queue only tests the MERGED result of the whole PR (see AGENTS.md), so the property
# still holds as long as the golden lands before the PR is enqueued. PRECOMMIT_SNAPSHOT_DEFER=1
# opts THIS commit alone out of check 4 (fmt/lint/lextok stay live — unlike --no-verify,
# which drops all four) for exactly that case. It is not a rubber stamp: CI's own
# snapshot-suite shard re-runs the real gate against the merged tree regardless, so a
# forgotten golden still reds the PR — this only defers WHEN it's checked, not WHETHER.
if [ -n "$snapfiles" ] && [ -n "${PRECOMMIT_SNAPSHOT_DEFER:-}" ]; then
  echo "pre-commit: PRECOMMIT_SNAPSHOT_DEFER=1 — skipping check 4 (snapshot) for this commit." >&2
  echo "pre-commit:   reminder: the golden MUST land in this PR before you enqueue the merge —" >&2
  echo "pre-commit:   CI's snapshot shard still enforces it against the merged tree. (#1179)" >&2
  snapfiles=""
fi

if [ -n "$snapfiles" ]; then
  # The snapshot suite's CHECK half is a `kind = "native"` gate module, invoked
  # here exactly as `medaka gate run` invokes it, so this hook and CI cannot
  # drift into two ways of running one check. MEDAKA_ROOT is named rather than
  # left to the hook's cwd, since the module resolves every corpus through it.
  snapgate="$ROOT/test/diff_compiler_snapshot_frontend_test.mdk"
  if [ -f "$snapgate" ]; then
    snapout="$(MEDAKA_ROOT="$ROOT" MEDAKA="$MEDAKA" \
                 "$MEDAKA" test --native "$snapgate" 2>&1)"; snapst=$?
    if [ "$snapst" -ne 0 ]; then
      echo "" >&2
      echo "✗ pre-commit: the snapshot suite is stale (make snapshot-check):" >&2
      echo "" >&2
      printf '%s\n' "$snapout" | grep -E '(: (FAIL|ERROR)|families failed)' | sed 's/^/    /' >&2
      echo "" >&2
      echo "  Re-cut ONLY the fixtures you changed, by name:" >&2
      echo "      sh test/snapshot_bless.sh --bless <file.mdk> ..." >&2
      echo "  then re-stage test/snapshots/ and READ the diff — that diff is the review gate." >&2
      echo "  (There is no whole-suite bless. A diagnostic-bearing section will refuse to" >&2
      echo "   bless at all: read the new message, then rm the .md and re-cut it with --new.)" >&2
      echo "" >&2
      echo "  OR, if you intend the golden to land in a LATER commit in this same PR:" >&2
      echo "      PRECOMMIT_SNAPSHOT_DEFER=1 git commit ...   (keeps fmt/lint/lextok live)" >&2
      echo "" >&2
      echo "  Bypass once (drops fmt/lint/lextok too):  git commit --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  fi
fi

# ── 5. lextok check (OPPORTUNISTIC — never builds the oracle) ────────────────
# Scoped to $files (check 1's set: staged .mdk, test/ excluded) that already have
# a sibling <f>.lextok.golden — i.e. files this family is actually meant to cover,
# not every staged .mdk (a file that never had a lextok golden captured, e.g. a
# newly-added stdlib module, would otherwise report a false "no golden" FAIL).
lex_relevant=""
for f in $files; do
  [ -f "$f" ] || continue
  [ -f "${f%.mdk}.lextok.golden" ] && lex_relevant="$lex_relevant $f"
done
lex_checked=0
if [ -n "$lex_relevant" ]; then
  if [ -x "$ROOT/test/bin/lex_main" ]; then
    lex_checked=1
    # The gate that owns this family is test/diff_compiler_fmt_test.mdk, a
    # `kind = "native"` module over a FIXED corpus — it takes no file arguments
    # and needs five oracles this hook must not require. So the per-staged-file
    # compare is spelled here: the same `lex_main <f>` spawn, the same drop of
    # the runtime's trailing `()`, against the same sibling golden.
    lexout=""; lexst=0; lexfail_names=""
    for lf in $lex_relevant; do
      lex_actual="$("$ROOT/test/bin/lex_main" "$lf" 2>/dev/null | sed '$ s/()$//; ${/^$/d;}')"
      lex_expected="$(cat "${lf%.mdk}.lextok.golden")"
      if [ "$lex_actual" != "$lex_expected" ]; then
        lexout="$lexout
FAIL $(basename "$lf")"
        lexfail_names="$lexfail_names $(basename "$lf" .mdk)"
        lexst=1
      fi
    done
    if [ "$lexst" -ne 0 ]; then
      echo "" >&2
      echo "✗ pre-commit: lextok golden(s) stale (self-lex token-stream snapshot):" >&2
      echo "" >&2
      printf '%s\n' "$lexout" | grep -E '^(FAIL|no golden)' | sed 's/^/    /' >&2
      echo "" >&2
      echo "  Recapture (per module — the bare form only reaches the fixed 13-module gate" >&2
      echo "  corpus, which may not include the module(s) above):" >&2
      for lfn in $lexfail_names; do
        echo "      sh test/capture_goldens.sh --frozen lextok --only $lfn" >&2
      done
      echo "  then re-stage the .lextok.golden file(s)." >&2
      echo "  Bypass once:  git commit --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  else
    echo "pre-commit: could NOT check lextok goldens for:$lex_relevant (no test/bin/lex_main —" >&2
    echo "pre-commit:   FORCE=1 JOBS=1 sh test/build_oracles.sh --build-one lex_main to enable)." >&2
  fi
fi

# ── 6. shout diff check (added lines only, staged .mdk, test/ excluded) ──────
# New comment-register class (#2621): rejects a commit that ADDS a new
# 🚨/⚠️/🔒 line to a staged .mdk. Diff-scoped, not baseline-scoped — an
# existing shout line that is merely touched (context around an edit) but
# textually unchanged does not trigger. Reuses $files from check 1 (staged
# .mdk, test/** excluded) rather than recomputing the glob. Needs no built
# binary — pure `git diff` + grep.
#
# Widened (#3032) to also reject the sigil-free shout
# register (census class 10, test/comment_register_census.sh): a run of 3+
# consecutive ALL-CAPS words survives a sigil strip with the shout sentence
# intact. That regex is line-content-blind — it also matches ALL-CAPS code
# and string literals (CLI help, error text) — so it is scoped to
# comment-scope added lines only: both of Medaka's comment forms, a `--`
# line comment and the interior of a nestable `{- ... -}` block, as
# `test/comment_register_census.sh --comment-scope` classifies them over the
# STAGED post-image (not the working tree, which may differ from what is
# being committed). A shout written into a block comment is the evasion the
# `^[ \t]*--` test alone let through.
# The sigil check is not comment-scoped: a sigil is deliberately rare enough
# outside comments that scoping it was never needed, and narrowing it now
# would be an unrelated behavior change.
#
# re_emoji/re_shout must stay byte-identical to the same-named literals in
# test/comment_register_census.sh and test/diff_compiler_comment_shout_diff_test.mdk
# — the CI gate asserts this on every run (see that script) rather than the
# three copies sharing code, so `--no-verify` cannot bypass the gate by
# skipping this hook.
re_emoji='🚨|⚠️|🔒'
re_shout='([A-Z][A-Z]+[,.:;)]? ){2,}[A-Z][A-Z]+'

# Emits the comment-scope subset of the `+`-prefixed diff lines on stdin,
# with the `+` stripped. $1 is the rev-spec of the file's staged post-image
# (`:<path>`), whose comment scope the census script classifies. A `--` line
# comment is matched directly, so a failure to read the post-image degrades
# to the pre-widening behavior rather than to no check at all. Block
# membership is by exact line text rather than by line number — enough at
# this check's precision, and far less code than correlating diff hunks.
# Output may repeat a line; callers dedupe.
scoped_added_lines() {
  sal_added="$(sed 's/^+//')"
  sal_scope="$(mktemp)"
  git show "$1" 2>/dev/null |
    sh "$ROOT/test/comment_register_census.sh" --comment-scope - >"$sal_scope" 2>/dev/null
  printf '%s\n' "$sal_added" | grep -E '^[ \t]*--'
  printf '%s\n' "$sal_added" | grep -Fxf "$sal_scope"
  rm -f "$sal_scope"
}

badshout=""
for f in $files; do
  [ -f "$f" ] || continue
  added="$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++')"
  [ -z "$added" ] && continue
  sigil_hit="$(printf '%s\n' "$added" | grep -E "$re_emoji")"
  comment_added="$(printf '%s\n' "$added" | scoped_added_lines ":$f" | sed '/^$/d' | sort -u)"
  shout_hit=""
  [ -n "$comment_added" ] && shout_hit="$(printf '%s\n' "$comment_added" | grep -E "$re_shout")"
  if [ -n "$sigil_hit" ] || [ -n "$shout_hit" ]; then
    badshout="$badshout $f"
  fi
done

if [ -n "$badshout" ]; then
  echo "" >&2
  echo "✗ pre-commit: new shout comment line(s) added:" >&2
  for f in $badshout; do
    added="$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++')"
    sigil_hit="$(printf '%s\n' "$added" | grep -E "$re_emoji")"
    comment_added="$(printf '%s\n' "$added" | scoped_added_lines ":$f" | sed '/^$/d' | sort -u)"
    shout_hit=""
    [ -n "$comment_added" ] && shout_hit="$(printf '%s\n' "$comment_added" | grep -E "$re_shout")"
    echo "" >&2
    echo "  $f:" >&2
    [ -n "$sigil_hit" ] && printf '%s\n' "$sigil_hit" | sed 's/^/      /' >&2
    [ -n "$shout_hit" ] && printf '%s\n' "$shout_hit" | sed 's/^/      /' >&2
  done
  echo "" >&2
  echo "  No new shout comments (🚨/⚠️/🔒 or sigil-free ALL-CAPS) — see AGENTS.md [T-COMMENT-REGISTER]." >&2
  echo "  Bypass once:  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# ── 6b. comment-register count baseline (staged .mdk, per-file) ─────────────
# Unlike check 6, not diff-scoped -- catches a moved/duplicated existing line
# that raises a staged file's class total without any individually new-
# looking added line. Reuses $files from check 1. Needs no built binary.
# The census reads each file from the working tree, not the index. A partially
# staged file is judged on unstaged edits too: a clean staged blob can fail
# here, and a violating staged blob can pass. Workaround: git add every edit
# before committing. The CI twin, test/diff_compiler_comment_shout_diff_test.mdk
# (baselineCheck), runs the same ratchet over a clean checkout of the commit,
# so it is the authoritative verdict.
baseline_out="$(sh "$ROOT/test/comment_register_census.sh" --check "$ROOT/test/comment_register_baseline.toml" $files 2>&1)"
baseline_status=$?
if [ "$baseline_status" -ne 0 ]; then
  echo "" >&2
  echo "✗ pre-commit: comment-register baseline ratchet violated:" >&2
  echo "" >&2
  printf '%s\n' "$baseline_out" | sed 's/^/  /' >&2
  echo "" >&2
  echo "  Bypass once:  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# ── #491: NAME THE BLIND SPOT ─────────────────────────────────────────────────
# This hook's silence has repeatedly been read as "goldens are complete" — it
# never is. State plainly, every run that reaches here, what got checked and
# what did NOT, rather than letting the absence of a message imply coverage.
# `.test.golden` is ALWAYS in the not-checked list: see the header note above
# (#536) on why `test/diff_compiler_fmt_test.mdk` cannot be scoped to staged files
# from the outside — running it here would risk rejecting a commit over an
# unrelated, stale fixture with no working per-file remediation.
checked="fmt, lint, baselined-lint, shout-diff, comment-register-baseline"
notchecked=""
if [ -n "${PRECOMMIT_SNAPSHOT_DEFER:-}" ]; then notchecked="$notchecked snapshots(deferred)"; else checked="$checked, snapshots"; fi
if [ "$lex_checked" = 1 ]; then checked="$checked, lextok"; else notchecked="$notchecked lextok"; fi
notchecked="$notchecked .test.golden selfproc-goldens native_cli-check-goldens"
echo "" >&2
echo "pre-commit: checked this run: $checked." >&2
echo "pre-commit: NOT checked this run:$notchecked —" >&2
echo "pre-commit:   if you touched stdlib/ or compiler/, run their gates before you push" >&2
echo "pre-commit:   (test/diff_compiler_fmt_test.mdk, test/diff_compiler_selfproc.sh," >&2
echo "pre-commit:    test/diff_native_cli.sh). This hook's" >&2
echo "pre-commit:   silence is not evidence those goldens are still current. (#491)" >&2

exit 0
