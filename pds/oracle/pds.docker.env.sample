# pds.docker.env.sample — env template for pds/oracle/run.sh's `up` subcommand (PRIMARY,
# Docker route).
#
# Container-side paths — `/pds` is the bind mount of $PDS_ORACLE_HOME (`-v
# "$PDS_ORACLE_HOME:/pds"`). NOT interchangeable with pds.env.sample (the fallback/no-Docker
# route's template): `docker --env-file` does NOT expand shell syntax like `${...}` — values
# are passed through literally — so every path below must already be the LITERAL container-side
# path, never a `${PDS_ORACLE_HOME:-...}`-style expression.
#
# `run.sh up` copies this file to $PDS_ORACLE_HOME/pds.docker.env (outside the repo) the first
# time it runs, filling the three secret fields below via `openssl rand` and substituting
# PDS_PORT with $PDS_ORACLE_PORT. This sample is never written to with real secrets — the copy
# in $PDS_ORACLE_HOME is.

# Plain-HTTP localhost origin. Without this, PDS_HOSTNAME=localhost is rejected at startup:
# "Resource URL must use the https scheme" (docs/ops/PDS-ORACLE.md, "What Route A runs, and
# what it does NOT reproduce").
PDS_DEV_MODE=true

PDS_HOSTNAME=localhost
PDS_PORT=3999

# Filled by `run.sh up` with `openssl rand -hex 32/16/32` — left empty here on purpose.
# Never commit real values for these.
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# Container-side, literal — the bind mount root is /pds. These directories must exist on
# the HOST side before `docker run` (docs/ops/PDS-ORACLE.md, the "up creates them for you
# before docker run" note); `run.sh up` mkdir -p's them under $PDS_ORACLE_HOME before
# starting the container.
PDS_DATA_DIRECTORY=/pds/data
PDS_BLOBSTORE_DISK_LOCATION=/pds/blobs

PDS_INVITE_REQUIRED=false

# Account creation (com.atproto.server.createAccount) needs a reachable PLC directory.
# PDS_DID_PLC_URL is SET here, to a dead loopback sentinel — not left unset:
#   - unset OR EMPTY resolves to the PUBLIC https://plc.directory (@atproto/pds's
#     config.js: `plcUrl: env.didPlcUrl ?? 'https://plc.directory'`; @atproto/common's
#     envStr() maps an EMPTY string to undefined too, so `PDS_DID_PLC_URL=` is exactly
#     as unsafe as leaving the line out). createAccount would then perform a real,
#     permanent, un-withdrawable did:plc WRITE to that public network — do not point
#     this at it casually, and never as a default.
#   - this is a REQUIRED safety decision, not a default: `run.sh up` now REFUSES to
#     start unless this line is present and non-empty.
#   - 127.0.0.1 here is the CONTAINER's own loopback (docker --env-file passes values
#     through literally) — it can reach neither the host nor the network, which is
#     what makes it safe on this route too.
#   - a local PLC server is out of scope for this slice (Phase 1's problem — see
#     docs/ops/PDS-ORACLE.md, Limitations).
PDS_DID_PLC_URL=http://127.0.0.1:9
