# pds.env.sample — env template for pds/oracle/run.sh's `node-up` subcommand (FALLBACK,
# no-Docker route — see docs/ops/PDS-ORACLE.md Route B). The primary (Docker) route uses
# pds.docker.env.sample instead; the two are NOT interchangeable, since `docker --env-file`
# does not expand shell syntax and this file's paths rely on that expansion.
#
# `run.sh node-up` copies this file to $PDS_ORACLE_HOME/pds.env (outside the repo) the first
# time it runs, filling the three secret fields below via `openssl rand`. This sample is
# never written to with real secrets — the copy in $PDS_ORACLE_HOME is. See
# docs/ops/PDS-ORACLE.md for the full procedure and the F-8/F-9 measurements this is
# derived from.

# Plain-HTTP localhost origin. Without this, PDS_HOSTNAME=localhost is rejected at
# startup: "Resource URL must use the https scheme" (dist/auth-routes.js requires
# cfg.service.devMode or an https:// resource URL — docs/ops/PDS-ORACLE.md F-8).
PDS_DEV_MODE=true

PDS_HOSTNAME=localhost
PDS_PORT=3999

# Filled by `run.sh node-up` with `openssl rand -hex 32/16/32` — left empty here on purpose.
# Never commit real values for these.
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

PDS_DATA_DIRECTORY=${PDS_ORACLE_HOME:-/var/tmp/medaka-pds-oracle}/data
PDS_BLOBSTORE_DISK_LOCATION=${PDS_ORACLE_HOME:-/var/tmp/medaka-pds-oracle}/blobs

PDS_INVITE_REQUIRED=false
NODE_ENV=production
UV_USE_IO_URING=0

# Account creation (com.atproto.server.createAccount) needs a reachable PLC directory.
# PDS_DID_PLC_URL is SET here, to a dead loopback sentinel — not left unset:
#   - unset OR EMPTY resolves to the PUBLIC https://plc.directory (@atproto/pds's
#     config.js: `plcUrl: env.didPlcUrl ?? 'https://plc.directory'`; @atproto/common's
#     envStr() maps an EMPTY string to undefined too, so `PDS_DID_PLC_URL=` is exactly
#     as unsafe as leaving the line out). createAccount would then perform a real,
#     permanent, un-withdrawable did:plc WRITE to that public network — do not point
#     this at it casually, and never as a default.
#   - this is a REQUIRED safety decision, not a default: `run.sh node-up` now REFUSES
#     to start unless this line is present and non-empty.
#   - a local PLC server is out of scope for this slice (Phase 1's problem — see
#     docs/ops/PDS-ORACLE.md, Limitations).
PDS_DID_PLC_URL=http://127.0.0.1:9
