# pds.env.sample — env template for pds/oracle/run.sh's `up` subcommand.
#
# `run.sh up` copies this file to $PDS_ORACLE_HOME/pds.env (outside the repo) the first
# time it runs, filling the three secret fields below via `openssl rand`. This sample is
# never written to with real secrets — the copy in $PDS_ORACLE_HOME is. See
# docs/ops/PDS-ORACLE.md for the full procedure and the F-8/F-9 measurements this is
# derived from.

# Plain-HTTP localhost origin. Without this, PDS_HOSTNAME=localhost is rejected at
# startup: "Resource URL must use the https scheme" (dist/auth-routes.js requires
# cfg.service.devMode or an https:// resource URL — docs/ops/PDS-ORACLE.md F-8).
PDS_DEV_MODE=true

PDS_HOSTNAME=localhost
PDS_PORT=3999

# Filled by `run.sh up` with `openssl rand -hex 32/16/32` — left empty here on purpose.
# Never commit real values for these.
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

PDS_DATA_DIRECTORY=${PDS_ORACLE_HOME:-/var/tmp/medaka-pds-oracle}/data
PDS_BLOBSTORE_DISK_LOCATION=${PDS_ORACLE_HOME:-/var/tmp/medaka-pds-oracle}/blobs

PDS_INVITE_REQUIRED=false
NODE_ENV=production
UV_USE_IO_URING=0

# Account creation (com.atproto.server.createAccount) needs a reachable PLC directory or
# it fails with 502 UpstreamFailure (docs/ops/PDS-ORACLE.md F-9). Left UNSET here:
#   - the PUBLIC https://plc.directory publishes a real did:plc to a real network — do
#     not point this at it casually, and never as a default;
#   - a local PLC server is out of scope for this slice (Phase 1's problem).
# PDS_DID_PLC_URL=https://plc.directory
