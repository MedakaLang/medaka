# pds/Caddyfile.egress — a template for the loopback egress reverse proxy
# that `pds serve`'s appview-proxying (`--egress-port`, `--proxy-audience`)
# and relay-announce (`--relay-port`) features dial out through.
#
# `pds serve` never dials the internet itself (docs/ops/PDS-DEPLOY.md,
# "Appview proxying" and "Discovery: announcing to a relay") — it only ever
# calls `127.0.0.1:<port>`. This file is the other half of that: one site
# block per port, each reverse-proxying to exactly ONE real-world upstream
# host. There is no header, variable, or other request-time input that picks
# the upstream — the port a request arrives on IS the routing decision, made
# once, here, by an operator editing this file, not by anything a caller
# sends. That fixed 1:1 mapping is the allow-list.
#
# Replace `relay.example.com` with the real relay host before use (the
# appview and chat hosts below are Bluesky's own and rarely need to change).
# Each port here must match the corresponding `pds serve` flag:
# `--egress-port` / a `--proxy-audience` row's port / `--relay-port`.
#
# Run this alongside the inbound Caddyfile (pds/Caddyfile) under its own
# systemd unit (pds/pds-egress.service) — see docs/ops/PDS-DEPLOY.md.

# A global options block, and the `admin off` in it is REQUIRED, not tidiness.
# Caddy binds an admin API on 127.0.0.1:2019 by default, and this proxy is
# specified to run ALONGSIDE the inbound Caddy (pds/Caddyfile) on the same box
# under its own unit. Two Caddy processes both claiming that port means the
# second one to start dies with `listen tcp 127.0.0.1:2019: bind: address
# already in use` and its unit restart-loops. Nothing here needs an admin API:
# the config is a fixed file loaded at start, never reconfigured at runtime.
{
	admin off
}

http://127.0.0.1:3128 {
	bind 127.0.0.1

	reverse_proxy https://api.bsky.app {
		header_up Host api.bsky.app

		transport http {
			tls
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}

	# stderr for the same reason pds/Caddyfile uses it: this unit's journal is
	# where an outbound call is correlated against the PDS's own line for the
	# inbound call that caused it.
	log {
		output stderr
	}
}

http://127.0.0.1:3129 {
	bind 127.0.0.1

	reverse_proxy https://relay.example.com {
		header_up Host relay.example.com

		transport http {
			tls
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}

	# stderr for the same reason pds/Caddyfile uses it: this unit's journal is
	# where an outbound call is correlated against the PDS's own line for the
	# inbound call that caused it.
	log {
		output stderr
	}
}

http://127.0.0.1:3130 {
	bind 127.0.0.1

	reverse_proxy https://api.bsky.chat {
		header_up Host api.bsky.chat

		transport http {
			tls
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}

	# stderr for the same reason pds/Caddyfile uses it: this unit's journal is
	# where an outbound call is correlated against the PDS's own line for the
	# inbound call that caused it.
	log {
		output stderr
	}
}
