# pds/Caddyfile — a template for the reverse proxy in front of `pds serve`.
#
# Caddy is the ONLY thing in this deployment that touches TLS (P5,
# docs/design/ATPROTO-PDS-DESIGN.md): it obtains and renews the Let's
# Encrypt certificate for the hostname below and reverse-proxies plaintext
# HTTP to the Medaka process, which binds loopback only. `pds serve` never
# sees the certificate and never terminates TLS itself — there is no TLS
# implementation in Medaka to do so.
#
# Replace `pds.example.com` with the real hostname (the same one `pds serve
# --hostname` is given) before use, and see docs/ops/PDS-DEPLOY.md for the
# rest of the procedure — the port here must match `pds serve --port`.
#
# `request_body`'s `max_size` is set to the exact byte count of the PDS's
# own largest body ceiling (`maxBlobBytes` / `maxHttpClientBodyBytes`, both
# 5242880 bytes, pds/lib/resource_limits.mdk) — a unit suffix like `5MB` is
# ambiguous (5,000,000 or 5,242,880 depending on the parser) and the smaller
# reading would reject a legitimate PDS-accepted request here first.

pds.example.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	request_body {
		max_size 5242880
	}

	# `stderr`, not a file, so systemd captures this into the journal beside
	# `pds.service`'s own lines (criterion E7: retained and readable BESIDE the
	# PDS log). A request that crosses the proxy boundary is then one query --
	# `journalctl -u caddy -u pds` -- on one timeline, which is what
	# docs/ops/PDS-RUNBOOK.md's incident procedure asks an operator to read.
	# Writing a file instead costs a manual timestamp join at exactly the hour
	# nobody wants to do one. The price is Caddy's own rotation, which journald
	# replaces, and journald's rate limiting, which can drop lines under a
	# burst -- see `RateLimitBurst` if that ever matters here.
	log {
		output stderr
	}

	reverse_proxy 127.0.0.1:8080 {
		# Caddy prints "Unnecessary header_up X-Forwarded-For" on every load of
		# this file. That warning is accurate for the Caddy in Debian trixie
		# (2.6.2) and it must not be acted on. MEASURED on 2.6.2, both arms, a
		# client sending `X-Forwarded-For: 1.2.3.4` through this proxy: with and
		# without this line, the upstream sees the real remote host and the
		# client's value is discarded. So today this line is a PIN, not the
		# mechanism.
		#
		# Keep it, for two reasons. It states the property `--trusted-proxy`
		# depends on — the last hop is this proxy's observation, never the
		# client's claim (pds/README.md, "Pass --trusted-proxy only when") —
		# rather than leaving it inherited from a default. And Caddy 2.7 adds a
		# `trusted_proxies` server option that changes what that default does;
		# 2.6.2 rejects the option outright, so the day someone upgrades Caddy
		# and configures it is the day this line starts carrying weight.
		header_up X-Forwarded-For {remote_host}

		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}
}
