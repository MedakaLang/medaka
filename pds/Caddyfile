# pds/Caddyfile — a template for the reverse proxy in front of `pds serve`.
#
# Caddy is the ONLY thing in this deployment that touches TLS (P5,
# docs/design/ATPROTO-PDS-DESIGN.md): it obtains and renews the Let's
# Encrypt certificate for the hostname below and reverse-proxies plaintext
# HTTP to the Medaka process, which binds loopback only. `pds serve` never
# sees the certificate and never terminates TLS itself — there is no TLS
# implementation in Medaka to do so.
#
# Replace `pds.example.com` with the real hostname (the same one `pds serve
# --hostname` is given) before use, and see docs/ops/PDS-DEPLOY.md for the
# rest of the procedure — the port here must match `pds serve --port`.
#
# `request_body`'s `max_size` is set to the PDS's own largest body ceiling
# (`maxBlobBytes` / `maxHttpClientBodyBytes`, both 5242880 bytes,
# pds/lib/resource_limits.mdk) rounded up to whole megabytes — never below
# it, or a legitimate PDS-accepted request would be rejected here first.

pds.example.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	request_body {
		max_size 5MB
	}

	log {
		output file /var/log/caddy/pds-access.log
	}

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}

		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
	}
}
