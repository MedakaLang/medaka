# pds/pds.service — a systemd unit template for the built `pds serve` binary.
#
# This deployment binds LOOPBACK (the default `--bind`, no `--bind` flag
# here) with Caddy reverse-proxying to it — see pds/Caddyfile and
# docs/ops/PDS-DEPLOY.md. `--trusted-proxy` is still passed: Caddy forwards
# `X-Forwarded-For`, and this process's peer really is Caddy on the same
# box, so per-identity rate limiting can use that header
# (docs/design/ATPROTO-PDS-DESIGN.md § "Rate limiting"). It is the operator
# who is asserting that fact by passing the flag — this process has no way
# to verify it.
#
# Replace the placeholders (WorkingDirectory, ExecStart's --did/--handle/
# --hostname/--data, User/Group) before installing. The secrets are not named
# here: `pdsd` reads them from `secrets/` under WorkingDirectory
# (`secrets/key.hex`, and `secrets/token.hex` when present). Copy to
# /etc/systemd/system/pds.service, then:
#   systemctl daemon-reload && systemctl enable --now pds
#
# The `pds`/`pds` user/group referenced below is not created by this unit —
# see docs/ops/PDS-DEPLOY.md's "Create the service user" step, run once
# before the first `systemctl enable --now pds`.
#
# `/opt/pds/secrets` is deliberately `ReadOnlyPaths`, not `ReadWritePaths`:
# the process only ever reads its secrets from there, and
# `ProtectSystem=strict` already makes every other path read-only by
# default, so this entry exists to say the read is intentional rather than
# to grant it.
#
# RestrictAddressFamilies, SystemCallFilter and OOMPolicy below are derived
# from what the process was measured doing, so a change to what `pdsd` opens
# or calls has to be re-measured against them. Boot a freshly built `pdsd`
# as a throwaway transient unit carrying this file's [Service] sandbox, from
# a `mktemp -d` $DIR outside /tmp, /var/tmp, /root and /home (the sandbox
# hides all four) with `data/` and the secrets owned by the unit's user, on
# `--port 0`, and drive every path the
# live service reaches through it: a request, a proxied call to a local stub
# on `--egress-port`, a `subscribeRepos` frame, a login and a record write,
# a burst of a few hundred large-bodied requests, and `systemctl stop` for
# the drain. Then remove one syscall group and check that the same boot now
# fails. Never point it at the live unit, data directory or ports:
#   systemd-run --unit=sprint-annbin-perimeter --collect \
#     -p User=nobody -p Group=nogroup -p ReadWritePaths=$DIR/data \
#     -p NoNewPrivileges=true -p ProtectSystem=strict -p ProtectHome=true \
#     -p PrivateDevices=true -p PrivateTmp=true -p CapabilityBoundingSet= \
#     -p WorkingDirectory=$DIR \
#     -p UMask=0077 -p LimitCORE=0 -p IPAddressDeny=any \
#     -p IPAddressAllow=localhost -p MemoryMax=512M -p TasksMax=256 \
#     -p LimitNOFILE=65536 -p CPUWeight=20 -p Environment=GC_MARKERS=1 \
#     -p RestrictAddressFamilies=AF_INET \
#     -p SystemCallFilter=@system-service \
#     -p 'SystemCallFilter=~@privileged @resources' \
#     -p SystemCallErrorNumber=EPERM -p OOMPolicy=kill \
#     $DIR/pdsd --did ... --data $DIR/data --port 0 \
#     --init --trusted-proxy --appview-did ... --egress-port $STUB_PORT

[Unit]
Description=Medaka atproto PDS
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/pds
StartLimitIntervalSec=60
StartLimitBurst=5
# Fires on every failure of this unit, a single crash that Restart= recovers
# from included, not only when the burst above is exhausted (systemd 257).
# So the first crash after the alert is armed takes its one push, and a crash
# loop after it pages nobody until the alert is re-armed. pds-alert@.service's
# header states exactly what that does and does not catch, and why
# pds-healthping.timer exists beside it rather than instead of it.
OnFailure=pds-alert@%n.service

[Service]
Type=simple
User=pds
Group=pds
WorkingDirectory=/opt/pds
ExecStart=/opt/pds/pdsd \
	--did did:web:pds.example.com \
	--handle alice.pds.example.com \
	--hostname pds.example.com \
	--data /opt/pds/data \
	--port 8080 \
	--trusted-proxy
Restart=on-failure
RestartSec=5
# The app drains for up to 95s after SIGTERM; keep 15s of supervisor margin.
TimeoutStopSec=110s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
ReadWritePaths=/opt/pds/data
ReadOnlyPaths=/opt/pds/secrets
CapabilityBoundingSet=
UMask=0077
# The heap holds the signing key and the session secret; a core dump would
# write both to disk in the clear.
LimitCORE=0
IPAddressDeny=any
IPAddressAllow=localhost
# IPv4 sockets only. The listener binds 127.0.0.1, the egress proxy is
# dialled at the literal 127.0.0.1 (`egressAddress`, pds/shell/egress.mdk),
# no name is ever resolved, and stdout reaches the journal on a descriptor
# systemd hands in, so the process opens no AF_UNIX or AF_INET6 socket.
RestrictAddressFamilies=AF_INET
# Every system call the exercise above reached (threads, the GC's
# SIGPWR/SIGXCPU stop-the-world signals, mmap/mprotect/madvise, fsync and
# rename for the store, getrandom for keys and tokens) is inside
# @system-service, and none is in @privileged or @resources. EPERM rather
# than the default SIGSYS kill: a call on a path the exercise never reached
# then fails as an error the process reports for that one request, instead
# of killing every open connection with it.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# An OOM kill against MemoryMax is a designed event. `kill` has the kernel
# take the whole cgroup at once (memory.oom.group), so nothing is left to
# drain against a heap at its ceiling, and the unit's result is `oom-kill`:
# on systemd 257 that is a failure, so Restart=on-failure restarts it and
# OnFailure= is triggered. `continue` would leave any survivor of the kill
# running as though the unit were healthy.
OOMPolicy=kill
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536
CPUWeight=20
# One GC marker thread. Boehm's default starts one per CPU, and at this low
# CPUWeight they wait on each other whenever the box is busy: a login's
# PBKDF2 measured 21-25 us/iteration with the default against 5-8 with one
# marker, under a scope with this unit's CPUWeight and MemoryMax beside
# twelve busy loops, and 7-10 against 5-7 on an idle box
# (docs/design/ATPROTO-PDS-DESIGN.md §4.2).
Environment=GC_MARKERS=1

[Install]
WantedBy=multi-user.target
