{- | In-language STRUCTURAL tests for `pds/lib/scalar.mdk` (S-scalar, #1700
   secp256k1 group ops + RFC 6979 + low-S).

   Only algebraic identities of the ring `Z/nZ` and rejection shapes live
   here — properties that are true of the RING, not answers computed by
   anyone. Every expected VALUE lives instead in the ledgered reference
   corpus (`pds/test/vectors/scalar_reference_corpus.txt`, graded by
   `pds/test/scalar_vectors_main.mdk`), because an expected value written
   inline in a `*_test.mdk` is invisible to `pds/test/VECTOR-PROVENANCE.txt`
   by construction — its own DOES-NOT-PROVE block says so.

   The INPUTS below are this slice's own selection and need no provenance: an
   input is not an answer key. They are built programmatically so the limb
   boundaries (every 32 bits, and every 16 in between) are hit exactly rather
   than by hand-typed hex.

   The two 32-byte constants that ARE spelled out — `n` and `n+1` — are the
   published curve order (SEC 2 v2 §2.4.1), used as REJECTION inputs, not as
   expected answers. `n_h = floor(n/2)` is never typed out: it is derived
   here as `(n-1)/2` by a byte-wise halving of `n-1`, and the graded answer
   key for the low-S boundary is the corpus's `high` rows.

   This file uses the BOUNDS-CHECKED public array API (`arr[i]`,
   `arr[i] := v`, `Array.setInPlace`) — no restricted internal externs. -}

import test.{expectEach, expectEqual, expectSatisfies, expectTrue, expectFalse}
import test.algebra_support.{allPairs, allTriples}
import test.fixture_support.{bitBytes, decBytes}
import bytes.{Bytes, fromU8Array}
import bytes as B
import mut_bytes as MB
import mut_bytes.{MutBytes}
import u8 as U8
import lib.scalar.{
  Sc,
  scZero,
  scOne,
  scAdd,
  scSub,
  scMul,
  scNegate,
  scInverse,
  scEqual,
  scIsZero,
  scIsHigh,
  scZeroBit,
  scEqualBit,
  scSelect,
  scNegateCt,
  scHighBit,
  scFromBytes,
  scFromBytesReduce,
  scToBytes,
}

-- ── Input construction (inputs, not answer keys) ──────────────────────

-- 32 big-endian bytes, incremented by one.
incBytes : Bytes -> Bytes
incBytes bs =
  let out = MB.thaw bs
  let () = incGo out 31
  MB.freeze out

incGo : MutBytes -> Int -> Unit
incGo out i =
  if i < 0 then
    ()
  else
    let v = U8.toInt out[i]
    if v == 255 then
      let () = MB.setInPlace i 0 out
      incGo out (i - 1)
    else
      MB.setInPlace i (U8.truncate (v + 1)) out

-- 32 big-endian bytes, halved (v >> 1).
halveBytes : Bytes -> Bytes
halveBytes bs =
  let out = MB.make 32
  let () = halveGo bs out 0 0
  MB.freeze out

halveGo : Bytes -> MutBytes -> Int -> Int -> Unit
halveGo bs out i carry =
  if i >= 32 then
    ()
  else
    let cur = U8.toInt bs[i]
    let () =
      MB.setInPlace i (U8.truncate (shiftRight cur 1 + shiftLeft carry 7)) out
    halveGo bs out (i + 1) (bitAnd cur 1)

-- 32 big-endian bytes, a - b (a >= b, which every input here satisfies).
subBytes : Bytes -> Bytes -> Bytes
subBytes a b =
  let out = MB.make 32
  let () = subGo a b out 31 0
  MB.freeze out

subGo : Bytes -> Bytes -> MutBytes -> Int -> Int -> Unit
subGo a b out i borrow =
  if i < 0 then
    ()
  else
    let v = U8.toInt a[i] - U8.toInt b[i] - borrow
    if v < 0 then
      let () = MB.setInPlace i (U8.truncate (v + 256)) out
      subGo a b out (i - 1) 1
    else
      let () = MB.setInPlace i (U8.truncate v) out
      subGo a b out (i - 1) 0

-- 32 big-endian bytes, a + b (the sum below 2^256, which every input here
-- satisfies).
addBytes : Bytes -> Bytes -> Bytes
addBytes a b =
  let out = MB.make 32
  let () = addGo a b out 31 0
  MB.freeze out

addGo : Bytes -> Bytes -> MutBytes -> Int -> Int -> Unit
addGo a b out i carry =
  if i < 0 then
    ()
  else
    let v = U8.toInt a[i] + U8.toInt b[i] + carry
    let () = MB.setInPlace i (U8.truncate (bitAnd v 255)) out
    addGo a b out (i - 1) (shiftRight v 8)

allOnes : Bytes
allOnes = fromU8Array (arrayMake 32 255)

-- n, the secp256k1 group order (SEC 2 v2 §2.4.1). Used here ONLY as a
-- rejection input and as the base for the derived boundary values below —
-- never as an expected answer.
nBytes : Bytes
nBytes = fromU8Array [|
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xfe, 0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b, 0xbf, 0xd2,
  0x5e, 0x8c, 0xd0, 0x36, 0x41, 0x41
|]

nPlus1Bytes : Bytes
nPlus1Bytes = incBytes nBytes

nMinus1Bytes : Bytes
nMinus1Bytes = decBytes nBytes

-- n_h = floor(n/2) = (n-1)/2, DERIVED rather than typed out. `n` is odd, so
-- halving n-1 is exact.
nHalfBytes : Bytes
nHalfBytes = halveBytes nMinus1Bytes

nHalf : Sc
nHalf = scFromBytesReduce nHalfBytes

nHalfPlus1 : Sc
nHalfPlus1 = scFromBytesReduce (incBytes nHalfBytes)

nMinus1 : Sc
nMinus1 = scFromBytesReduce nMinus1Bytes

-- Every 16-bit boundary: the seven limb boundaries of the 8 x 2^32 layout
-- and the mid-limb positions between them.
limbBits : List Int
limbBits = [16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 240]

-- One representative element per limb boundary, plus a few small ones.
sampleBytes : List Bytes
sampleBytes =
  [bitBytes 0, bitBytes 1, bitBytes 255]
    ++ map bitBytes limbBits
    ++ map (k => decBytes (bitBytes k)) limbBits

samples : List Sc
samples = map scFromBytesReduce sampleBytes

-- A second, offset list, so the binary identities are not all `a op a`.
samples2 : List Sc
samples2 =
  map scFromBytesReduce (map (bs => decBytes (decBytes bs)) sampleBytes)

scNext : Sc -> Sc
scNext a = scAdd a scOne

-- ── The sample list is NON-EMPTY ──────────────────────────────────────
-- Every identity below is an `all`/`allPairs` over `samples`, and `all` over
-- an EMPTY list is vacuously True. Without this assertion a refactor that
-- emptied `sampleBytes` would turn the whole file green while testing
-- nothing.

test "the sample lists are non-empty (guards every `all` below from going vacuous)" =
  expectEqual (length samples) 33

test "the offset sample list matches it in length" =
  expectEqual (length samples2) 33

-- ── Additive structure ────────────────────────────────────────────────

test "a + (-a) = 0, over every limb boundary" =
  expectTrue (all (a => scIsZero (scAdd a (scNegate a))) samples)

test "a + 0 = a" = expectTrue (all (a => scEqual (scAdd a scZero) a) samples)

test "a - b = a + (-b)" =
  expectTrue
    (allPairs
      (a b => scEqual (scSub a b) (scAdd a (scNegate b)))
      samples
      samples2)

test "a - a = 0" = expectTrue (all (a => scIsZero (scSub a a)) samples)

test "(a + b) + c = a + (b + c)" =
  expectTrue
    (allTriples
      (a b c => scEqual (scAdd (scAdd a b) c) (scAdd a (scAdd b c)))
      scNext
      samples
      samples2)

test "a + b = b + a" =
  expectTrue
    (allPairs (a b => scEqual (scAdd a b) (scAdd b a)) samples samples2)

test "-0 = 0" = expectTrue (scIsZero (scNegate scZero))

test "fixed-control zero/equality bits agree with the public predicates" =
  expectTrue
    (all
      (a =>
        scZeroBit a == (if scIsZero a then 1 else 0)
          && scEqualBit a a == 1
          && scEqualBit a (scAdd a scOne) == 0)
      samples)

test "fixed-control select visits both choices without changing their values" =
  expectTrue
    (allPairs
      (a b => scEqual (scSelect 0 a b) a && scEqual (scSelect 1 a b) b)
      samples
      samples2)

test "fixed-control negation agrees with scalar negation, including zero" = expectEach
  [
    (
      "fixed-control negation leaves zero at zero",
      expectTrue (scEqual (scNegateCt scZero) scZero),
    ),
    (
      "fixed-control negation agrees with plain negation on every sample",
      expectTrue (all (a => scEqual (scNegateCt a) (scNegate a)) samples),
    ),
  ]

-- ── Multiplicative structure ──────────────────────────────────────────

test "a * 1 = a" = expectTrue (all (a => scEqual (scMul a scOne) a) samples)

test "a * 0 = 0" = expectTrue (all (a => scIsZero (scMul a scZero)) samples)

test "(a * b) * c = a * (b * c)" =
  expectTrue
    (allTriples
      (a b c => scEqual (scMul (scMul a b) c) (scMul a (scMul b c)))
      scNext
      samples
      samples2)

test "a * b = b * a" =
  expectTrue
    (allPairs (a b => scEqual (scMul a b) (scMul b a)) samples samples2)

test "a * (b + c) = a*b + a*c" =
  expectTrue
    (allTriples
      (a b c => scEqual (scMul a (scAdd b c)) (scAdd (scMul a b) (scMul a c)))
      scNext
      samples
      samples2)

-- ⚠️ SUBSET, DELIBERATELY, AND MEASURED. `scInverse` is Fermat over `n-2`:
-- ~451 scalar multiplies, ~11 s per call under the tree-walking interpreter
-- this suite runs on. Over all 33 `samples` this ONE assertion measured
-- 6m34s for the whole file; over the six representatives below it measures
-- well under a minute, and this suite runs as a CI gate
-- (pds/test/inlang_test_oracle_test.mdk, which runs this file natively).
--
-- Nothing is lost: `inverse` is graded against the EXTERNAL answer key over
-- 52 inputs — including 0, 1, n-1, n_h, n_h+1 and 16 pseudo-random values —
-- by the corpus's `inv` rows, on the NATIVE engine, in well under a second
-- (pds/test/scalar_vectors_test.mdk's native arm, full corpus). This assertion's job is
-- the structural one: that `a * inverse a = 1` holds as an identity of the
-- ring, at representative limb positions.
--
-- The six: the low bit, the top bit, a mid-limb boundary, the first limb
-- boundary, an all-ones-below-a-boundary value in limb 0, and one in limb 7.
invSamples : List Sc
invSamples = map scFromBytesReduce [
  bitBytes 0,
  bitBytes 255,
  bitBytes 128,
  bitBytes 16,
  decBytes (bitBytes 16),
  decBytes (bitBytes 240),
]

test "the inverse-sample list is non-empty (this `all` cannot go vacuous)" =
  expectEqual (length invSamples) 6

test "a * inverse a = 1 for every non-zero a (representative limb positions)" =
  expectTrue
    (all (a => scIsZero a || scEqual (scMul a (scInverse a)) scOne) invSamples)

-- `inverse 0 = 0` is the settled convention (RUN-PDS0-016 Q1): a TOTAL
-- function matching libsecp256k1, pinned executably by the corpus's `inv 0`
-- row and by the doctest at the definition site. Pinned here too, because it
-- is the one cell where "wrong" and "by design" look identical.
test "inverse 0 = 0 (the settled convention, not an error)" =
  expectTrue (scIsZero (scInverse scZero))

-- The largest product, (n - 1)^2, is n^2 - 2n + 1: every fold of the
-- reduction runs on it, and it ends one subtraction of n away from 1.
test "(n - 1) * (n - 1) = 1, the largest product" =
  expectTrue (scEqual (scMul nMinus1 nMinus1) scOne)

-- 2(n - 1) = 2n - 2 is at least 2^256, so the addition carries out of the top
-- limb; the result is -2, reached here through negation instead.
test "(n - 1) + (n - 1) = -2, a sum that carries out of 256 bits" =
  expectTrue (scEqual (scAdd nMinus1 nMinus1) (scNegate (scAdd scOne scOne)))

-- ── Serialization ─────────────────────────────────────────────────────

roundTrips : Bytes -> Bool
roundTrips bs = match scFromBytes bs
  Ok s => scToBytes s == bs
  Err _ => False

test "fromBytes >> toBytes round-trips at every limb boundary" =
  expectTrue (all roundTrips sampleBytes)

test "toBytes is 32 bytes" =
  expectSatisfies
    "every sample to encode to 32 bytes"
    (all (n => n == 32))
    (map (a => B.length (scToBytes a)) samples)

test "fromBytes REJECTS n" = expectTrue (match scFromBytes nBytes
  Err _ => True
  Ok _ => False)

test "fromBytes REJECTS n+1" = expectTrue (match scFromBytes nPlus1Bytes
  Err _ => True
  Ok _ => False)

test "fromBytes REJECTS 2^256-1" = expectTrue (match scFromBytes allOnes
  Err _ => True
  Ok _ => False)

test "fromBytes ACCEPTS n-1 (the last canonical value)" = expectTrue
  (match scFromBytes nMinus1Bytes
    Ok _ => True
    Err _ => False)

test "fromBytes REJECTS a short input" = expectTrue
  (match scFromBytes (fromU8Array (arrayMake 31 0))
    Err _ => True
    Ok _ => False)

test "fromBytes REJECTS a long input" = expectTrue
  (match scFromBytes (fromU8Array (arrayMake 33 0))
    Err _ => True
    Ok _ => False)

test "fromBytesReduce ACCEPTS n and reduces it to 0" =
  expectTrue (scIsZero (scFromBytesReduce nBytes))

test "fromBytesReduce ACCEPTS n+1 and reduces it to 1" =
  expectTrue (scEqual (scFromBytesReduce nPlus1Bytes) scOne)

test "fromBytesReduce ACCEPTS 2^256-1" =
  expectFalse (scIsZero (scFromBytesReduce allOnes))

-- Every value in [n, 2^256) is below 2n, so it reduces to x - n. The inputs
-- span that range: its bottom (n, n + 1), limb boundaries above n, and its top
-- (2^256 - 1); x - n is computed on the bytes, not by the module.
aboveN : List Bytes
aboveN = [
  nBytes,
  nPlus1Bytes,
  addBytes nBytes (bitBytes 0),
  addBytes nBytes (decBytes (bitBytes 32)),
  addBytes nBytes (bitBytes 64),
  addBytes nBytes (bitBytes 127),
  addBytes nBytes (decBytes (bitBytes 128)),
  allOnes,
]

reducesToDifference : Bytes -> Bool
reducesToDifference x = match scFromBytes (subBytes x nBytes)
  Ok d => scEqual (scFromBytesReduce x) d
  Err _ => False

test "fromBytesReduce x = x - n for every x in [n, 2^256)" =
  expectTrue (all reducesToDifference aboveN)

test "the [n, 2^256) input list is non-empty (this `all` cannot go vacuous)" =
  expectEqual (length aboveN) 8

-- ── The low-S boundary (structural) ───────────────────────────────────
-- `scIsHigh` is STRICT: s > floor(n/2). `n_h` here is derived as (n-1)/2,
-- not typed out; the corpus's `high` rows are the graded answer key. These
-- four cells pin the shape of the boundary, not its value.

test "isHigh n_h is False (the predicate is STRICTLY greater)" =
  expectFalse (scIsHigh nHalf)

test "isHigh (n_h + 1) is True" = expectTrue (scIsHigh nHalfPlus1)

test "isHigh 0 is False" = expectFalse (scIsHigh scZero)

test "isHigh (n-1) is True" = expectTrue (scIsHigh nMinus1)

test "fixed-control high bit agrees at every low-S boundary" = expectEach [
  ("scHighBit nHalf == 0", expectEqual 0 (scHighBit nHalf)),
  ("scHighBit nHalfPlus1 == 1", expectEqual 1 (scHighBit nHalfPlus1)),
  ("scHighBit scZero == 0", expectEqual 0 (scHighBit scZero)),
  ("scHighBit nMinus1 == 1", expectEqual 1 (scHighBit nMinus1)),
]

-- 2 * n_h = n - 1, so n_h really is floor(n/2): a check on the DERIVATION
-- above, independent of scIsHigh.
test "2 * n_h = n - 1 (so the derived n_h is floor(n/2))" =
  expectTrue (scEqual (scAdd nHalf nHalf) nMinus1)

test "n_h + 1 = inverse 2 (equivalently 2 * (n_h + 1) = 1)" =
  expectTrue (scEqual (scAdd nHalfPlus1 nHalfPlus1) scOne)
