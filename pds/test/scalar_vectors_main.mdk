{- | Reference-corpus driver for `pds/lib/scalar.mdk` (S-scalar, #1700
   secp256k1 group ops + RFC 6979 + low-S).

   Usage: scalar_vectors_main [--stride N] <corpus-file> [<corpus-file> ...]

   Grades our secp256k1 scalar arithmetic (mod the group order `n`) against
   `pds/test/vectors/scalar_reference_corpus.txt`, generated from
   `libsecp256k1` at the pinned commit — never against a self-captured
   golden (G5, `docs/design/ATPROTO-PDS-DESIGN.md` §5). Provenance:
   `pds/test/VECTOR-PROVENANCE.txt`.

   Grammar — one row per line, lowercase hex, single-space separated:
     <op> <a-64hex> <r-64hex>            op in { red, neg, inv }
     <op> <a-64hex> <bit>                op in { high, ovf }   bit is 0 or 1
     <op> <a-64hex> <b-64hex> <r-64hex>  op in { mul, add, sub }
   Blank lines and lines beginning `#` are ignored. Operands are RAW 32-byte
   big-endian values that may be >= n; every one goes in through
   `scFromBytesReduce`, and every hex result is compared as CANONICAL 32
   bytes. An UNKNOWN or MISPLACED op token is a FAIL naming the file, line
   and token, never a skip — a silently skipped row is a false green.

   ⚠️ `ovf` is graded as *"`scFromBytes` on these 32 bytes returns `Err`"*.
   That is equivalent to the reference's `set_b32` overflow flag ONLY because
   every corpus row carries exactly 32 well-formed bytes: `scFromBytes` also
   rejects a wrong length and an out-of-range element, and neither shape can
   occur here (the row is 64 hex chars, which `hex.decode` turns into 32
   bytes in 0..255). Under that standing precondition the two agree exactly
   on the `>= n` boundary, so no extra export is needed. The non-`>= n`
   rejection paths are covered structurally in `pds/test/scalar_test.mdk`.

   `--stride N` checks only every Nth row (and counts the rest as skipped).
   That is what lets the gate's eval-engine phase run a bounded subset: an
   `inv` row is ~451 scalar multiplications (255 squarings + 196 multiplies
   over the fixed exponent `n-2`), which the tree-walking interpreter is not
   the right engine for. The native phase runs stride 1.

   The LAST stdout line is exactly `TOTAL: PASS` or `TOTAL: FAIL`. Exit 1 if
   any row failed OR if zero rows were checked (the vacuous-green guard).

   This file uses the BOUNDS-CHECKED public array API (`arr[i]`,
   `Array.setInPlace`) — no restricted internal externs, matching `pds/lib/scalar.mdk`. -}

import lib.scalar.{
  Sc,
  scFromBytes,
  scFromBytesReduce,
  scToBytes,
  scAdd,
  scSub,
  scMul,
  scNegate,
  scInverse,
  scIsHigh,
}
import array as A
import hex.{decode, encode}
import string.{split, startsWith, toInt, trim}
import io.{readLines}

-- ── Counter layout ───────────────────────────────────────────────────
-- `counts` holds the per-op OK count, indexed by `opIndex`.
-- `totals` holds [checked, failed, skipped].

opNames : Array String
opNames = [|"red", "neg", "inv", "high", "ovf", "mul", "add", "sub"|]

nOps : Int
nOps = 8

-- 0..2 are unary-with-hex-result, 3..4 are unary-with-bit-result, 5..7 are
-- binary. `processLine` keys the row shape off these ranges, so an op in the
-- wrong shape is a FAIL rather than a silent mis-parse.
opIndex : String -> Int
opIndex op =
  if op == "red" then
    0
  else if op == "neg" then
    1
  else if op == "inv" then
    2
  else if op == "high" then
    3
  else if op == "ovf" then
    4
  else if op == "mul" then
    5
  else if op == "add" then
    6
  else if op == "sub" then
    7
  else
    -1

bump : Array Int -> Int -> Unit
bump arr i = A.setInPlace i (arr[i] + 1) arr

-- ── Row evaluation ───────────────────────────────────────────────────

mustHex : String -> Array Int
mustHex s = match decode s
  Ok bs => bs
  Err m => panic "scalar_vectors: bad hex '\{s}': \{m}"

loadSc : String -> Sc
loadSc s = scFromBytesReduce (mustHex s)

applyUnary : String -> Sc -> Sc
applyUnary op x =
  if op == "red" then x else if op == "neg" then scNegate x else scInverse x

applyBinary : String -> Sc -> Sc -> Sc
applyBinary op x y =
  if op == "mul" then
    scMul x y
  else if op == "add" then
    scAdd x y
  else
    scSub x y

-- The boolean-result ops. `high` is the low-S predicate on the REDUCED
-- value; `ovf` is `scFromBytes`'s rejection of a raw `>= n` input (see the
-- module header's precondition note).
applyBit : String -> String -> Bool
applyBit op a =
  if op == "high" then
    scIsHigh (loadSc a)
  else match scFromBytes (mustHex a)
    Ok _ => False
    Err _ => True

-- Compare an actual scalar against the row's expected 64-hex, print one line
-- for the cell, and update the counters.
grade : Array Int -> Array Int -> String -> String -> Sc -> String -> <IO> Unit
grade counts totals label op actual expected =
  let got = encode (scToBytes actual)
  let () = bump totals 0
  if got == expected then
    let () = bump counts (opIndex op)
    println "PASS\t\{label}"
  else
    let () = bump totals 1
    println "FAIL\t\{label}\texpected \{expected}\tgot \{got}"

-- Same, for a boolean-result row whose expected column is "0" or "1".
gradeBit : Array Int ->
  Array Int ->
  String ->
  String ->
  Bool ->
  String ->
  <IO> Unit
gradeBit counts totals label op actual expected =
  let got = if actual then "1" else "0"
  let () = bump totals 0
  if expected /= "0" && expected /= "1" then
    let () = bump totals 1
    println "FAIL\t\{label}\texpected column must be 0 or 1, got '\{expected}'"
  else if got == expected then
    let () = bump counts (opIndex op)
    println "PASS\t\{label}"
  else
    let () = bump totals 1
    println "FAIL\t\{label}\texpected \{expected}\tgot \{got}"

-- ── Line dispatch ────────────────────────────────────────────────────

isComment : String -> Bool
isComment line = startsWith "#" line

failRow : Array Int -> String -> String -> <IO> Unit
failRow totals label msg =
  let () = bump totals 0
  let () = bump totals 1
  println "FAIL\t\{label}\t\{msg}"

processLine : Array Int -> Array Int -> String -> Int -> String -> <IO> Unit
processLine counts totals path lineNo line =
  let t = trim line
  let loc = "\{path}:\{intToString lineNo}"
  if t == "" || isComment t then
    ()
  else match split " " t
    [op, a, r] =>
      let i = opIndex op
      if i < 0 || i > 4 then
        failRow totals loc "unknown or misplaced op '\{op}' in: \{t}"
      else if i <= 2 then
        grade counts totals "\{loc}:\{op}" op (applyUnary op (loadSc a)) r
      else
        gradeBit counts totals "\{loc}:\{op}" op (applyBit op a) r
    [op, a, b, r] =>
      if opIndex op < 5 then
        failRow totals loc "unknown or misplaced op '\{op}' in: \{t}"
      else
        grade
          counts
          totals
          "\{loc}:\{op}"
          op
          (applyBinary op (loadSc a) (loadSc b))
          r
    _ => failRow totals loc "malformed row: \{t}"

processAll : Array Int ->
  Array Int ->
  Int ->
  String ->
  List String ->
  Int ->
  Int ->
  <IO> Unit
processAll counts totals stride path [] lineNo rowNo = ()
processAll counts totals stride path (l :: rest) lineNo rowNo =
  let t = trim l
  if t == "" || isComment t then
    processAll counts totals stride path rest (lineNo + 1) rowNo
  else if rowNo % stride /= 0 then
    let () = bump totals 2
    processAll counts totals stride path rest (lineNo + 1) (rowNo + 1)
  else
    let () = processLine counts totals path lineNo l
    processAll counts totals stride path rest (lineNo + 1) (rowNo + 1)

runFile : Array Int -> Array Int -> Int -> String -> <IO, FileRead "_"> Unit
runFile counts totals stride path = match readLines path
  Err e =>
    let () = println "FAIL\tcannot read \{path}: \{e}"
    bump totals 1
  Ok ls => processAll counts totals stride path ls 1 0

runAll : Array Int -> Array Int -> Int -> List String -> <IO, FileRead "_"> Unit
runAll counts totals stride [] = ()
runAll counts totals stride (f :: rest) =
  let () = runFile counts totals stride f
  runAll counts totals stride rest

-- ── Reporting ────────────────────────────────────────────────────────

printOpCounts : Array Int -> Int -> <IO> Unit
printOpCounts counts i =
  if i >= nOps then
    ()
  else
    let () = println "op \{opNames[i]}: \{intToString counts[i]} ok"
    printOpCounts counts (i + 1)

parseArgs : List String -> (Int, List String)
parseArgs ("--stride" :: nStr :: rest) = match toInt nStr
  Some n =>
    if n < 1 then
      panic "scalar_vectors: --stride needs a positive integer"
    else
      (n, rest)
  None => panic "scalar_vectors: --stride needs an integer argument"
parseArgs files = (1, files)

main : <IO, Env, FileRead "_"> Unit
main =
  let (stride, files) = parseArgs (args ())
  if files == [] then
    let () =
      println
        "usage: scalar_vectors_main [--stride N] <corpus-file> [<corpus-file> ...]"
    exit 2
  else
    let counts = arrayMake nOps 0
    let totals = arrayMake 3 0
    let () = runAll counts totals stride files
    let () = printOpCounts counts 0
    let checked = totals[0]
    let failed = totals[1]
    let skipped = totals[2]
    let () =
      println
        "counted: \{intToString (checked - failed)}/\{intToString checked} rows ok, \{intToString skipped} skipped (stride \{intToString stride})"
    if failed > 0 || checked == 0 then
      let () = println "TOTAL: FAIL"
      exit 1
    else
      let () = println "TOTAL: PASS"
      exit 0
