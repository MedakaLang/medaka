{- | The PDS read, identity and well-known routes that need no repository,
   the appview-proxy dispositions and the service-auth mints, on native and
   Wasm, and a mutation self-test showing the gate can fail.

   No cell builds a repository, so nothing here signs a commit. The
   repository-bearing read routes run as an arm of `repo_vectors_test`,
   next to the corpus they are graded by. The interpreter's agreement with
   the transcript is graded nightly by `pds/nightly/read_routes_eval_engine_test.mdk`,
   which shares the transcript through `pds/test/read_routes_support.mdk`.

   The cells cover the router's stateless half: the two non-XRPC well-known
   paths, every other non-XRPC path still 404ing, every repository-bearing
   read refusing cleanly on an unconfigured server, CORS preflight, the
   `atproto-proxy` seam (#2912; default-allow on the method axis within
   `app.bsky.*`/`chat.bsky.*`, default-deny on the audience axis) and
   `com.atproto.server.getServiceAuth`. The socket half of the proxy is
   `pds/test/serve_e2e.sh`'s. The driver takes
   `pds/test/vectors/pds_protected_methods_corpus.txt` as its one argument,
   because `pds/lib` declares no effect row and so cannot read the file its
   `protectedMethods` list is compared against.

   The value test requires native and Wasm to print exactly `transcript`,
   which is hand-authored: each line is the answer the route is defined to
   give. A host without the Wasm emitter, `node` or `wasm-tools` fails the
   row rather than skipping the Wasm arm.

   The mutation test copies `pds/` into a scratch tree, breaks one line of
   the driver at a time, and requires the natively built mutant to fail with
   that mutation's own witness line. Native only, for the reason
   `test.vector_runner`'s `MutationTest` gives. -}

import test.vector_runner.{
  Bound(..),
  Corpus(..),
  Engine(..),
  Mutation(..),
  MutationTest(..),
  Row(..),
  expectMutations,
  expectRow,
  transcriptArm,
}
import test.read_routes_support.{transcript}
import test
import test_process.{medakaRoot}

gate : String
gate = "pds/test/read_routes_all_engines"

driver : String
driver = "pds/test/read_routes_all_engines_main.mdk"

corpusFile : String
corpusFile = "pds/test/vectors/pds_protected_methods_corpus.txt"

row : Row
row = Row {
  gate = gate,
  driver = driver,
  corpus = Explicit [corpusFile],
  corpusCount = Exactly 1,
  sourceShapes = [],
  oracle = None,
  arms = map (transcriptArm transcript) [NativeEngine, WasmEngine],
  parity = True,
}

-- # Mutations

mutationTest : MutationTest
mutationTest = MutationTest {
  gate = gate,
  driver = driver,
  args = ["\{medakaRoot}/\{corpusFile}"],
  mutations = [
    -- A document naming the wrong server must not satisfy the did:web cell.
    Mutation {
      name = "did-web-hostname",
      file = driver,
      anchor = "\\\"id\\\":\\\"did:web:pds.example\\\"",
      mutant = "\\\"id\\\":\\\"did:web:other.example\\\"",
      witness = "CELL wellknown-did-json FAIL",
    },
    -- The confused deputy (#2912): the "foreign" audience becomes the one
    -- permitted audience, so the refusal cell sees an admission. Only an
    -- expectation naming the whole outcome, claims or `signed=none`, can tell
    -- a refusal from an admission.
    Mutation {
      name = "proxy-foreign-audience",
      file = driver,
      anchor = "foreignServiceDid = \"did:web:other.example\"",
      mutant = "foreignServiceDid = \"did:web:appview.example\"",
      witness = "CELL proxy-foreign-audience FAIL decision=admitted",
    },
    -- Every proxied request loses its `Authorization` field. The audience
    -- mutation proves the seam grades which service a credential is for; this
    -- one proves it grades whether the caller may have one at all.
    Mutation {
      name = "proxy-no-credential",
      file = driver,
      anchor =
        "proxyAuthField = \"Authorization: Bearer \\{proxyAccessToken}\\r\\n\"",
      mutant = "proxyAuthField = \"\"",
      witness =
        "CELL proxy-admitted-timeline FAIL decision=refused status=401 error=AuthenticationRequired",
    },
    -- The egress port is looked up under the default audience instead of the
    -- admitted one. Every claim set stays correct, so only a cell naming the
    -- port sees it: the appview cells stay green and the chat ones go red.
    Mutation {
      name = "proxy-audience-routing",
      file = driver,
      anchor = "match appviewRouteFor table did",
      mutant = "match appviewRouteFor table configuredAppviewDid",
      witness = "CELL proxy-admitted-chat-audience FAIL decision=admitted",
    },
  ],
}

test "read routes: 81 hand-authored cells, native == Wasm" = expectRow row

test "read routes: each of 4 mutations turns the gate red with its own witness" =
  expectMutations mutationTest
