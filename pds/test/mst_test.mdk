{- | Structural tests for the pure persistent atproto MST. External root CIDs
   and node bytes remain exclusively in the provenance-ledgered corpus. -}

import array as A
import list.{filter, reverse, take}
import string.{fromUtf8, toUtf8}
import test.{Expectation, expectEach, expectEqual, expectTrue}
import lib.cid.{Cid, cidEqual, cidForDagCbor}
import lib.mst.{
  Mst,
  MstRangeQuery(..),
  mstDelete,
  mstEmpty,
  mstEntries,
  mstFromEntries,
  mstInsert,
  mstKeyDepth,
  mstLookup,
  mstNodeBlocks,
  mstRange,
  mstReplace,
  mstRootBytes,
  mstRootCid,
  mstValidateBlocks,
}

-- `Cid` derives no `Eq` — `lib.cid` designates `cidEqual` as its equality
-- (`Cid`'s constructor is module-private), so an `Option Cid` result cannot be
-- compared with `==`.
lookupIs : Option Cid -> Cid -> Bool
lookupIs (Some found) want = cidEqual found want
lookupIs None _ = False

mustTree : Result String Mst -> Mst
mustTree (Ok tree) = tree
mustTree (Err message) = panic message

key0 : Array Int
key0 = [|
  97, 112, 112, 46, 98, 115, 107, 121, 46, 102, 101, 101, 100, 46, 112, 111,
  115, 116, 47, 109, 101, 100, 97, 107, 97, 45, 100, 101, 112, 116, 104, 45, 48,
  45, 48
|]

key1 : Array Int
key1 = [|
  97, 112, 112, 46, 98, 115, 107, 121, 46, 102, 101, 101, 100, 46, 112, 111,
  115, 116, 47, 109, 101, 100, 97, 107, 97, 45, 100, 101, 112, 116, 104, 45, 49,
  45, 53
|]

value0 : Cid
value0 = cidForDagCbor [|1|]

value1 : Cid
value1 = cidForDagCbor [|2|]

test "empty MST is stable and validates" =
  expectEqual
    (mstValidateBlocks (mstRootCid mstEmpty) (mstNodeBlocks mstEmpty))
    (Ok ())

test "from-entries is independent of input order" =
  let left = mustTree (mstFromEntries [(key0, value0), (key1, value1)])
  let right = mustTree (mstFromEntries [(key1, value1), (key0, value0)])
  expectTrue (cidEqual (mstRootCid left) (mstRootCid right))

test "known keys occupy adjacent protocol depths" = expectEach [
  ("mstKeyDepth key0 == Ok 0", expectEqual (Ok 0) (mstKeyDepth key0)),
  ("mstKeyDepth key1 == Ok 1", expectEqual (Ok 1) (mstKeyDepth key1)),
]

test "lookup finds exact keys and misses absent keys" =
  let tree = mustTree (mstFromEntries [(key0, value0)])
  expectEach [
    (
      "an inserted key is found",
      expectTrue (lookupIs (mstLookup key0 tree) value0),
    ),
    (
      "a key never inserted is absent",
      expectTrue (isNone (mstLookup key1 tree)),
    ),
  ]

test "insert rejects an existing key" =
  let tree = mustTree (mstInsert key0 value0 mstEmpty)
  expectTrue (isErr (mstInsert key0 value1 tree))

test "replace changes only the selected value" =
  let tree = mustTree (mstFromEntries [(key0, value0), (key1, value1)])
  let updated = mustTree (mstReplace key0 value1 tree)
  expectEach [
    (
      "the replaced key now carries the new value",
      expectTrue (lookupIs (mstLookup key0 updated) value1),
    ),
    (
      "the untouched key still carries its own value",
      expectTrue (lookupIs (mstLookup key1 updated) value1),
    ),
  ]

test "replace rejects a missing key" =
  expectTrue (isErr (mstReplace key0 value1 mstEmpty))

test "delete removes exactly one key" =
  let tree = mustTree (mstFromEntries [(key0, value0), (key1, value1)])
  let updated = mustTree (mstDelete key0 tree)
  expectEach [
    ("the deleted key is gone", expectTrue (isNone (mstLookup key0 updated))),
    (
      "the other key survives the delete",
      expectTrue (lookupIs (mstLookup key1 updated) value1),
    ),
  ]

test "delete-to-empty restores the canonical empty root" =
  let tree = mustTree (mstInsert key0 value0 mstEmpty)
  let empty = mustTree (mstDelete key0 tree)
  expectTrue (cidEqual (mstRootCid empty) (mstRootCid mstEmpty))

test "from-entries rejects empty and duplicate keys" = expectEach [
  (
    "an empty key is rejected",
    expectTrue (isErr (mstFromEntries [([||], value0)])),
  ),
  (
    "a duplicate key is rejected",
    expectTrue (isErr (mstFromEntries [(key0, value0), (key0, value1)])),
  ),
]

test "entry and root byte views are defensive copies" =
  let tree = mustTree (mstInsert key0 value0 mstEmpty)
  let [(shown, _)] = mstEntries tree
  let root = mstRootBytes tree
  let before = mstRootBytes tree
  let () = A.setInPlace 0 0 shown
  let () = A.setInPlace 0 0 root
  expectEqual (mstRootBytes tree) before

test "reachable block view validates after layered construction" =
  let tree = mustTree (mstFromEntries [(key0, value0), (key1, value1)])
  expectEqual (mstValidateBlocks (mstRootCid tree) (mstNodeBlocks tree)) (Ok ())

-- ── mutation against a from-scratch build, step by step ─────────────────────

{- | A mutation rebuilds only the path to the touched key and keeps every
   other node as it stands, so the whole tree it produces has to be the tree a
   from-scratch build of the same entries produces — same root CID, same node
   blocks in the same order, byte for byte. The orders below are two different
   permutations of the same key set, so the sequence visits insertion at the
   front, in the middle and at the end of a node, the layer promotions those
   force, and the prune back to the canonical empty root. -}

probeCount : Int
probeCount = 64

probeKey : Int -> Array Int
probeKey i = toUtf8 "app.bsky.feed.post/probe-\{intToString i}"

insertOrder : Int -> Int
insertOrder i = (i * 37 + 11) % probeCount

deleteOrder : Int -> Int
deleteOrder i = (i * 45 + 7) % probeCount

blocksEqual : List (Cid, Array Int) -> List (Cid, Array Int) -> Bool
blocksEqual [] [] = True
blocksEqual ((leftCid, leftBytes) :: left) ((rightCid, rightBytes) :: right) =
  cidEqual leftCid rightCid && leftBytes == rightBytes && blocksEqual left right
blocksEqual _ _ = False

agrees : Mst -> Bool
agrees tree =
  let fresh = mustTree (mstFromEntries (mstEntries tree))
  cidEqual (mstRootCid tree) (mstRootCid fresh)
    && blocksEqual (mstNodeBlocks tree) (mstNodeBlocks fresh)

data Walk = Walk Mst Bool

stepped : Walk -> Mst -> Walk
stepped (Walk _ ok) next = Walk next (ok && agrees next)

insertPhase : Int -> Walk -> Walk
insertPhase i (walk@(Walk tree _)) =
  if i >= probeCount then
    walk
  else
    insertPhase
      (i + 1)
      (stepped
        walk
        (mustTree (mstInsert (probeKey (insertOrder i)) value0 tree)))

replacePhase : Int -> Walk -> Walk
replacePhase i (walk@(Walk tree _)) =
  if i >= probeCount then
    walk
  else
    replacePhase
      (i + 3)
      (stepped walk (mustTree (mstReplace (probeKey i) value1 tree)))

deletePhase : Int -> Walk -> Walk
deletePhase i (walk@(Walk tree _)) =
  if i >= probeCount then
    walk
  else
    deletePhase
      (i + 1)
      (stepped walk (mustTree (mstDelete (probeKey (deleteOrder i)) tree)))

test "every single-key mutation matches a from-scratch build" =
  let (Walk final ok) =
    deletePhase 0 (replacePhase 0 (insertPhase 0 (Walk mstEmpty True)))
  expectEach [
    ("every step matched", expectTrue ok),
    (
      "deleting every key returns to the empty root",
      expectTrue (cidEqual (mstRootCid final) (mstRootCid mstEmpty)),
    ),
  ]

-- ── bounded range reads ─────────────────────────────────────────────────────

treeOf : List String -> Mst
treeOf names =
  mustTree (mstFromEntries (map (name => (toUtf8 name, value0)) names))

entryKey : (Array Int, Cid) -> String
entryKey (key, _) = fromUtf8 key

rangeKeys : MstRangeQuery -> Mst -> List String
rangeKeys query tree = map entryKey (mstRange query tree)

likePrefix : Array Int
likePrefix = toUtf8 "app.bsky.feed.like/"

postPrefix : Array Int
postPrefix = toUtf8 "app.bsky.feed.post/"

mixedNames : List String
mixedNames = [
  "app.bsky.feed.like/a1",
  "app.bsky.feed.like/a2",
  "app.bsky.feed.post/b1",
  "app.bsky.feed.post/b2",
  "app.bsky.feed.post/b3",
  "app.bsky.graph.follow/c1",
]

mixedTree : Mst
mixedTree = treeOf mixedNames

soleTree : Mst
soleTree = treeOf ["app.bsky.feed.post/b2"]

forwardFrom : Option (Array Int) -> Option (Array Int) -> MstRangeQuery
forwardFrom start prefix = MstRangeQuery {
  start = start,
  prefix = prefix,
  reverse = False,
  limit = None,
}

backwardFrom : Option (Array Int) -> Option (Array Int) -> MstRangeQuery
backwardFrom start prefix =
  MstRangeQuery { start = start, prefix = prefix, reverse = True, limit = None }

withLimit : Option Int -> MstRangeQuery -> MstRangeQuery
withLimit limit query = { query | limit = limit }

rangeIs : List String -> MstRangeQuery -> Mst -> Expectation
rangeIs want query tree = expectEqual want (rangeKeys query tree)

test "a forward range starts at its key and runs to the end" =
  rangeIs
    [
      "app.bsky.feed.post/b2", "app.bsky.feed.post/b3",
      "app.bsky.graph.follow/c1"
    ]
    (forwardFrom (Some (toUtf8 "app.bsky.feed.post/b2")) None)
    mixedTree

test "a reverse range starts at its key and runs back to the start" =
  rangeIs
    [
      "app.bsky.feed.post/b2",
      "app.bsky.feed.post/b1",
      "app.bsky.feed.like/a2",
      "app.bsky.feed.like/a1",
    ]
    (backwardFrom (Some (toUtf8 "app.bsky.feed.post/b2")) None)
    mixedTree

test "a start key absent from the tree bounds the range without joining it" = expectEach
  [
    (
      "forward from a gap takes the keys above it",
      rangeIs
        [
          "app.bsky.feed.post/b2",
          "app.bsky.feed.post/b3",
          "app.bsky.graph.follow/c1",
        ]
        (forwardFrom (Some (toUtf8 "app.bsky.feed.post/b1x")) None)
        mixedTree,
    ),
    (
      "backward from a gap takes the keys below it",
      rangeIs
        ["app.bsky.feed.like/a1"]
        (backwardFrom (Some (toUtf8 "app.bsky.feed.like/a1x")) None)
        mixedTree,
    ),
  ]

test "a collection prefix restricts a range to that collection" = expectEach [
  (
    "forward over one collection",
    rangeIs
      [
        "app.bsky.feed.post/b1",
        "app.bsky.feed.post/b2",
        "app.bsky.feed.post/b3",
      ]
      (forwardFrom None (Some postPrefix))
      mixedTree,
  ),
  (
    "backward over one collection",
    rangeIs
      [
        "app.bsky.feed.post/b3",
        "app.bsky.feed.post/b2",
        "app.bsky.feed.post/b1",
      ]
      (backwardFrom None (Some postPrefix))
      mixedTree,
  ),
  (
    "a start key inside the collection narrows it further",
    rangeIs
      ["app.bsky.feed.post/b2", "app.bsky.feed.post/b3"]
      (forwardFrom (Some (toUtf8 "app.bsky.feed.post/b2")) (Some postPrefix))
      mixedTree,
  ),
  (
    "the first collection stops before the next one",
    rangeIs
      ["app.bsky.feed.like/a1", "app.bsky.feed.like/a2"]
      (forwardFrom None (Some likePrefix))
      mixedTree,
  ),
]

test "degenerate trees range without special-casing" = expectEach [
  (
    "the empty tree ranges to nothing",
    rangeIs [] (forwardFrom None None) mstEmpty,
  ),
  (
    "the empty tree ranges to nothing in reverse too",
    rangeIs [] (backwardFrom None None) mstEmpty,
  ),
  (
    "a one-node tree yields its single key",
    rangeIs ["app.bsky.feed.post/b2"] (forwardFrom None None) soleTree,
  ),
  (
    "a one-node tree yields its single key in reverse",
    rangeIs ["app.bsky.feed.post/b2"] (backwardFrom None None) soleTree,
  ),
  (
    "a start key above every key yields nothing",
    rangeIs [] (forwardFrom (Some (toUtf8 "zzz")) None) mixedTree,
  ),
  (
    "a prefix no key carries yields nothing",
    rangeIs [] (forwardFrom None (Some (toUtf8 "chat.bsky/"))) mixedTree,
  ),
]

{- | A limit is an early end to the descent, not a trim of its result, so the
   direction decides which end of the range it keeps: the first keys of a
   forward read and the last of a backward one. -}
test "a limit bounds a range to the entries it asks for" = expectEach [
  (
    "forward takes the first keys of the range",
    rangeIs
      ["app.bsky.feed.post/b1", "app.bsky.feed.post/b2"]
      (withLimit (Some 2) (forwardFrom None (Some postPrefix)))
      mixedTree,
  ),
  (
    "backward takes the last keys of the range",
    rangeIs
      ["app.bsky.feed.post/b3", "app.bsky.feed.post/b2"]
      (withLimit (Some 2) (backwardFrom None (Some postPrefix)))
      mixedTree,
  ),
  (
    "a limit of none takes nothing",
    rangeIs [] (withLimit (Some 0) (forwardFrom None None)) mixedTree,
  ),
  (
    "a limit past the end of the range takes all of it",
    rangeIs
      ["app.bsky.feed.like/a1", "app.bsky.feed.like/a2"]
      (withLimit (Some 9) (forwardFrom None (Some likePrefix)))
      mixedTree,
  ),
  (
    "a limit of one seeks the single entry a range opens on",
    rangeIs
      ["app.bsky.graph.follow/c1"]
      (withLimit (Some 1) (forwardFrom (Some (toUtf8 "app.bsky.graph.")) None))
      mixedTree,
  ),
]

{- | The range read against the baseline it exists to avoid: filtering the
   fully materialised entry list by the same bounds. Descending the node tree
   skips whole subtrees the flat list walks, and a limit ends that descent
   early, so the two agreeing over every start key of every corpus tree, in
   both directions, under every prefix and at every limit, is what says
   neither the skipping nor the early end drops anything it should keep. -}

carriesPrefix : Option (Array Int) -> Array Int -> Bool
carriesPrefix None _ = True
carriesPrefix (Some prefix) key = A.take (arrayLength prefix) key == prefix

pastStart : Bool -> Option (Array Int) -> Array Int -> Bool
pastStart _ None _ = True
pastStart True (Some start) key = key <= start
pastStart False (Some start) key = key >= start

selects : MstRangeQuery -> (Array Int, Cid) -> Bool
selects query (key, _) =
  carriesPrefix query.prefix key && pastStart query.reverse query.start key

bounded : Option Int -> List a -> List a
bounded None entries = entries
bounded (Some limit) entries = take limit entries

filteredRange : MstRangeQuery -> Mst -> List String
filteredRange query tree =
  let kept = map entryKey (filter (selects query) (mstEntries tree))
  bounded query.limit (if query.reverse then reverse kept else kept)

queryLabel : MstRangeQuery -> String
queryLabel query =
  let direction = if query.reverse then "reverse" else "forward"
  "\{direction} start=\{describeBound query.start} prefix=\{describeBound query.prefix} limit=\{describeLimit query.limit}"

describeBound : Option (Array Int) -> String
describeBound None = "-"
describeBound (Some bytes) = fromUtf8 bytes

describeLimit : Option Int -> String
describeLimit None = "-"
describeLimit (Some limit) = intToString limit

queriesOver : List (Option (Array Int)) ->
  List (Option (Array Int)) ->
  List (Option Int) ->
  List MstRangeQuery
queriesOver starts prefixes limits =
  flatMap
    (query => map (limit => withLimit limit query) limits)
    (flatMap
      (start =>
        flatMap
          (prefix => [forwardFrom start prefix, backwardFrom start prefix])
          prefixes)
      starts)

disagreements : Mst -> List String
disagreements tree =
  let starts = None :: map ((key, _) => Some key) (mstEntries tree)
  let prefixes = [None, Some likePrefix, Some postPrefix]
  let limits = [None, Some 0, Some 1, Some 2, Some 5]
  map
    queryLabel
    (filter
      (query => rangeKeys query tree /= filteredRange query tree)
      (queriesOver starts prefixes limits))

probeTree : Mst
probeTree =
  treeOf (map (i => "app.bsky.feed.post/probe-\{intToString i}") [0..=63])

test "a range selects exactly what filtering the full entry list selects" = expectEach
  [
    ("the empty tree", expectEqual [] (disagreements mstEmpty)),
    ("a one-node tree", expectEqual [] (disagreements soleTree)),
    ("three collections", expectEqual [] (disagreements mixedTree)),
    ("a 64-key layered tree", expectEqual [] (disagreements probeTree)),
  ]
