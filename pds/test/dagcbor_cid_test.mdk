{- | Structural tests for canonical DAG-CBOR/DRISL, CID, and base32.
   Published expected bytes and CIDs stay in the provenance-ledgered corpus;
   these tests assert round-trips, determinism, isolation, and rejection. -}

import bytes.{fromArrayAssumeByteDomain, fromU8Array}
import mut_bytes as MB
import string.{contains, toLower}
import u8 as U8
import test.{
  expectEach, expectEqual, expectErr, expectFalse, expectOkThen, expectTrue
}
import base32.{base32Decode, base32Encode}
import lib.cid.{
  cidDigest,
  cidEqual,
  cidForDagCbor,
  cidForRaw,
  cidFromBytes,
  cidFromString,
  cidToBytes,
  cidToString,
}
import lib.dagcbor.{DagCbor(..), dagCborDecode, dagCborEncode}
import lib.resource_limits.{maxDagCborDepth}

-- | `n` nested single-element arrays around one leaf, putting that leaf at
-- DAG-CBOR nesting depth `n` and every array above it at depths 0..n-1.
nest : Int -> DagCbor
nest n = if n <= 0 then DcInt 0 else DcArray [nest (n - 1)]

roundTrip : DagCbor -> Bool
roundTrip value = match dagCborEncode value
  Err _ => False
  Ok encoded => match dagCborDecode encoded
    Err _ => False
    Ok decoded => dagCborEncode decoded == Ok encoded

test "base32 round-trips empty and partial groups" =
  let samples = [
    fromU8Array [||],
    fromU8Array [|0|],
    fromU8Array [|0, 1|],
    fromU8Array [|0, 1, 2|],
    fromU8Array [|0, 1, 2, 3|],
    fromU8Array [|0, 1, 2, 3, 4|],
  ]
  expectTrue (all (bs => base32Decode (base32Encode bs) == Ok bs) samples)

test "base32 encoder is lowercase and unpadded" =
  let encoded = base32Encode (fromU8Array [|255, 238, 221, 204, 187, 170|])
  expectEach [
    ("the encoding is lowercase", expectEqual (toLower encoded) encoded),
    ("the encoding carries no padding", expectFalse (contains "=" encoded)),
  ]

test "base32 rejects padding uppercase and alien alphabet" = expectEach [
  ("padding characters are rejected", expectErr (base32Decode "aa======")),
  ("uppercase input is rejected", expectErr (base32Decode "AA")),
  (
    "a character outside the alphabet is rejected",
    expectErr (base32Decode "a1"),
  ),
]

test "CID binary and string forms round-trip" =
  let cid = cidForDagCbor (fromU8Array [|1, 2, 3, 4|])
  expectOkThen
    (binary =>
      expectOkThen
        (text => expectEach [
          (
            "the binary form parses back to the same CID",
            expectTrue (cidEqual cid binary),
          ),
          (
            "the string form parses back to the same CID",
            expectTrue (cidEqual cid text),
          ),
        ])
        (cidFromString (cidToString cid)))
    (cidFromBytes (cidToBytes cid))

test "CID codec changes the identity for identical content" =
  expectTrue
    (not
      (cidEqual
        (cidForDagCbor (fromU8Array [|1|]))
        (cidForRaw (fromU8Array [|1|]))))

test "CID digest access does not expose the CID's own storage" =
  let cid = cidForDagCbor (fromU8Array [|9, 8, 7|])
  let before = cidToBytes cid
  let exposed = MB.thaw (cidDigest cid)
  let () = MB.setInPlace 0 (U8.bitXor exposed[0] (U8.truncate 255)) exposed
  expectEqual (cidToBytes cid) before

test "DAG-CBOR round-trips every admitted value kind" =
  let link = cidForDagCbor (fromU8Array [|1, 2, 3|])
  let value = DcMap [
    ("link", DcLink link),
    ("array", DcArray [DcNull, DcBool False, DcBool True, DcInt (-25)]),
    ("bytes", DcBytes (fromArrayAssumeByteDomain [|0, 255|])),
    ("text", DcString "水"),
  ]
  expectTrue (roundTrip value)

test "DAG-CBOR map encoding is insertion-order independent" =
  let a = DcMap [("bbb", DcInt 3), ("a", DcInt 1), ("cc", DcInt 2)]
  let b = DcMap [("cc", DcInt 2), ("bbb", DcInt 3), ("a", DcInt 1)]
  expectEqual (dagCborEncode a) (dagCborEncode b)

test "DAG-CBOR encoder rejects duplicate map keys" =
  expectErr (dagCborEncode (DcMap [("x", DcInt 1), ("x", DcInt 2)]))

test "DAG-CBOR encoder admits the deepest nesting its decoder reads back" =
  expectTrue (roundTrip (nest maxDagCborDepth))

test "DAG-CBOR encoder refuses nesting one level past the decoder's ceiling" =
  expectErr (dagCborEncode (nest (maxDagCborDepth + 1)))

{- | The two ceilings are the SAME ceiling: one more array header in front of
   the deepest admitted encoding is the encoding the encoder now refuses, and
   the decoder must still refuse it. A gate that only checked the encoder
   would pass an encoder bound set anywhere at or below the decoder's. -}
test "DAG-CBOR decoder refuses exactly what the encoder now refuses" =
  expectOkThen
    (bytes =>
      expectTrue
        (isErr (dagCborDecode (fromArrayAssumeByteDomain [|0x81|] ++ bytes))))
    (dagCborEncode (nest maxDagCborDepth))

test "DAG-CBOR decoder rejects non-shortest and trailing encodings" = expectEach
  [
    (
      "a non-shortest integer encoding is rejected",
      expectTrue
        (isErr (dagCborDecode (fromArrayAssumeByteDomain [|0x18, 0x17|]))),
    ),
    (
      "trailing bytes after a complete value are rejected",
      expectTrue (isErr (dagCborDecode (fromArrayAssumeByteDomain [|0xf6, 0|]))),
    ),
  ]

test "DAG-CBOR decoder rejects unordered and duplicate map keys" = expectEach [
  (
    "map keys out of canonical order are rejected",
    expectTrue
      (isErr
        (dagCborDecode
          (fromArrayAssumeByteDomain [|0xa2, 0x61, 0x62, 1, 0x61, 0x61, 2|]))),
  ),
  (
    "a duplicate map key is rejected",
    expectTrue
      (isErr
        (dagCborDecode
          (fromArrayAssumeByteDomain [|0xa2, 0x61, 0x61, 1, 0x61, 0x61, 2|]))),
  ),
]
