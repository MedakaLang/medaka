{- | Focused structural tests for strict bounded HTTP/1.1 request framing. -}

import http.{
  checkHttpBodyBytes,
  checkHttpChunks,
  checkHttpHeaderBytes,
  checkHttpHeaderFields,
  checkHttpRequestBytes,
  checkHttpRequestLineBytes,
  checkHttpTrailerFields,
  checkJsonBodyBytes,
  checkRawBodyBytes,
  checkTextBodyBytes,
  DecodedBody(..),
  decodeRequestBody,
  Header,
  headerName,
  headerValue,
  HttpFrame(..),
  HttpParseFailure(..),
  HttpScan,
  httpScanStart,
  makeHeader,
  makeResponse,
  maxHttpBodyBytes,
  maxHttpChunks,
  maxHttpHeaderBytes,
  maxHttpHeaderFields,
  maxHttpRequestBytes,
  maxHttpRequestLineBytes,
  maxHttpTrailerFields,
  maxJsonBodyBytes,
  maxRawBodyBytes,
  maxTextBodyBytes,
  mediaTypeSubtype,
  mediaTypeType,
  parseMediaType,
  parseRequest,
  parseRequestAt,
  parseTargetQuery,
  QueryParam(..),
  Request,
  requestBody,
  requestHeaders,
  requestKeepAlive,
  requestMethod,
  requestTarget,
  requestTrailers,
  Response,
  scanRequestBoundary,
  scanRequestBoundaryFrom,
  scanRequestBoundaryWithin,
  serializeResponse,
}
import test.{
  expectEach,
  expectEqual,
  expectErr,
  expectFalse,
  expectOk,
  expectOkThen,
  expectTrue,
  fail,
  pass,
}
import bytes as B
import bytes.{Bytes, encodeUtf8, fromArray}
import string.{contains, toUtf8}

rejects : String -> Bytes -> Bool
rejects expected input = match parseRequest input
  Err message => contains expected message
  Ok _ => False

mustRequest : Bytes -> Request
mustRequest input = match parseRequest input
  Ok request => request
  Err message => panic message

appendBytes : Array Int -> Array Int -> Array Int
appendBytes left right =
  let leftSize = arrayLength left
  arrayMakeWith (leftSize + arrayLength right) (i =>
    if i < leftSize then left[i] else right[i - leftSize])

names : List Header -> List String
names = map headerName

mustBytes : Array Int -> Bytes
mustBytes arr = match fromArray arr
  Some bytes => bytes
  None => panic "http_test: element outside the byte domain"

emptyBytes : Bytes
emptyBytes = mustBytes [||]

mustHeader : String -> Array Int -> Header
mustHeader name value = match makeHeader name value
  Ok header => header
  Err message => panic message

mustResponse : Int -> String -> List Header -> Array Int -> Response
mustResponse status reason headers body =
  match makeResponse status reason headers body
    Ok response => response
    Err message => panic message

requestWithBody : String -> Bytes -> Request
requestWithBody contentType body =
  mustRequest
    (encodeUtf8
        "POST /xrpc/example HTTP/1.1\r\nHost: pds.example\r\nContent-Type: \{contentType}\r\nContent-Length: \{intToString (B.length body)}\r\n\r\n"
      ++ body)

bodyRejects : String -> Request -> Bool
bodyRejects expected request = match decodeRequestBody request
  Err message => contains expected message
  Ok _ => False

simpleGet : Bytes
simpleGet =
  encodeUtf8
    "GET /xrpc/com.atproto.server.describeServer?detail=true HTTP/1.1\r\nHost: pds.example\r\n\r\n"

fixedBinary : Bytes
fixedBinary =
  encodeUtf8
      "POST /xrpc/com.atproto.repo.uploadBlob HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 3\r\nConnection: keep-alive, CLOSE\r\nX-Repeat: one\r\nX-Repeat: two\r\n\r\n"
    ++ mustBytes [|0, 128, 255|]

chunked : Bytes
chunked =
  encodeUtf8
    "POST /xrpc/com.atproto.repo.applyWrites HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: Chunked\r\nX-Repeat: one\r\nX-Repeat: two\r\n\r\n4;foo=bar\r\nWiki\r\n5;quoted=\"yes\"\r\npedia\r\n0;done\r\nX-Checksum: ok\r\n\r\n"

test "origin-form HTTP/1.1 request parses without a body" =
  let request = mustRequest simpleGet
  expectEach [
    ("the method is GET", expectEqual "GET" (requestMethod request)),
    (
      "the target keeps its path and query verbatim",
      expectEqual
        "/xrpc/com.atproto.server.describeServer?detail=true"
        (requestTarget request),
    ),
    (
      "the request carries no body",
      expectEqual 0 (B.length (requestBody request)),
    ),
    (
      "the connection stays alive by default",
      expectTrue (requestKeepAlive request),
    ),
  ]

test "fixed-length framing preserves raw binary body and ordered duplicates" =
  let request = mustRequest fixedBinary
  expectEach [
    (
      "the binary body survives byte for byte",
      expectEqual (mustBytes [|0, 128, 255|]) (requestBody request),
    ),
    (
      "the header names keep their order, repeats included",
      expectEqual
        ["host", "content-length", "connection", "x-repeat", "x-repeat"]
        (names (requestHeaders request)),
    ),
    (
      "the close token ends the connection",
      expectFalse (requestKeepAlive request),
    ),
  ]

test "header accessors return trimmed field bytes" =
  let request =
    mustRequest
      (encodeUtf8
        "GET / HTTP/1.1\r\nHost: pds.example\r\nX-Test:\t value \t\r\n\r\n")
  match requestHeaders request
    [_host, value] => expectEqual (headerValue value) (toUtf8 "value")
    _ => fail "expected exactly two headers (Host, X-Test)"

test "chunked framing accepts extensions and ordered trailers" =
  let request = mustRequest chunked
  expectEach [
    (
      "the chunks reassemble to the whole body",
      expectEqual (encodeUtf8 "Wikipedia") (requestBody request),
    ),
    (
      "the trailer section is preserved",
      expectEqual ["x-checksum"] (names (requestTrailers request)),
    ),
    ("the connection stays alive", expectTrue (requestKeepAlive request)),
  ]

test "Connection close token matching is case-insensitive and comma aware" =
  let request =
    mustRequest
      (encodeUtf8
        "GET / HTTP/1.1\r\nHost: pds.example\r\nConnection: upgrade, ClOsE\r\n\r\n")
  expectTrue (not (requestKeepAlive request))

test "duplicate Content-Length is rejected even when values agree" =
  expectTrue
    (rejects
      "duplicate Content-Length"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n"))

test "Transfer-Encoding plus Content-Length is rejected" =
  expectTrue
    (rejects
      "ambiguous"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n0\r\n\r\n"))

test "unsupported transfer coding is rejected" =
  expectTrue
    (rejects
      "unsupported transfer coding"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"))

test "repeated Transfer-Encoding is rejected" =
  expectTrue
    (isErr
      (parseRequest
        (encodeUtf8
          "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")))

test "close-delimited request bodies are rejected as trailing bytes" =
  expectTrue
    (rejects
      "unframed or trailing"
      (encodeUtf8 "POST / HTTP/1.1\r\nHost: pds.example\r\n\r\npayload"))

test "truncated fixed-length body is rejected" =
  expectTrue
    (rejects
      "truncated body"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 4\r\n\r\nabc"))

test "bytes after fixed-length framing are rejected" =
  expectTrue
    (rejects
      "bytes after framed"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 1\r\n\r\nab"))

test "overflowing Content-Length is rejected before allocation" =
  expectTrue
    (rejects
      "overflows Int"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 99999999999999999999\r\n\r\n"))

test "decoded-body limit is enforced before fixed allocation" =
  expectTrue
    (rejects
      "decoded body exceeds"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 5242881\r\n\r\n"))

test "invalid chunk size is rejected" =
  expectTrue
    (rejects
      "invalid chunk size"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\nZ\r\n"))

test "oversized chunk is rejected before allocation" =
  expectTrue
    (rejects
      "chunk size exceeds"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n500001\r\n"))

test "truncated chunk data is rejected" =
  expectTrue
    (rejects
      "truncated body"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nab"))

test "missing CRLF after chunk data is rejected" =
  expectTrue
    (rejects
      "missing CRLF"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n1\r\naXX"))

test "malformed chunk extension is rejected" =
  expectTrue
    (rejects
      "unterminated quoted"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n1;x=\"no\r\na\r\n0\r\n\r\n"))

test "forbidden framing trailer is rejected" =
  expectTrue
    (rejects
      "forbidden framing"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nContent-Length: 0\r\n\r\n"))

test "bytes after chunked trailers are rejected" =
  expectTrue
    (rejects
      "bytes after framed"
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nx"))

test "bare LF is rejected" =
  expectTrue
    (rejects "bare LF" (encodeUtf8 "GET / HTTP/1.1\nHost: pds.example\n\n"))

test "bare CR is rejected" =
  expectTrue (rejects "bare CR" (encodeUtf8 "GET / HTTP/1.1\rX"))

test "obsolete folded header line is rejected" =
  expectTrue
    (rejects
      "folded"
      (encodeUtf8
        "GET / HTTP/1.1\r\nHost: pds.example\r\n continuation\r\n\r\n"))

test "invalid method token is rejected" =
  expectTrue
    (rejects
      "method token"
      (encodeUtf8 "GE(T / HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "non-ASCII byte in method is rejected" =
  expectTrue
    (rejects
      "method token"
      (mustBytes [|255|]
        ++ encodeUtf8 "ET / HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "non-ASCII byte in target is rejected" =
  expectTrue
    (rejects
      "origin-form ASCII target"
      (encodeUtf8 "GET /"
        ++ mustBytes [|128|]
        ++ encodeUtf8 " HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "invalid header-name token is rejected" =
  expectTrue
    (rejects
      "header field name"
      (encodeUtf8
        "GET / HTTP/1.1\r\nHost: pds.example\r\nBad Name: value\r\n\r\n"))

test "control byte in header value is rejected" =
  expectTrue
    (rejects
      "control byte"
      (encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example\r\nX-Test: "
        ++ mustBytes [|1|]
        ++ encodeUtf8 "\r\n\r\n"))

test "CRLF injection in request target is rejected" =
  expectTrue
    (isErr
      (parseRequest
        (encodeUtf8
          "GET /ok\r\nInjected: yes HTTP/1.1\r\nHost: pds.example\r\n\r\n")))

-- The framer reads a `Bytes`, whose every element is an octet by
-- construction, so a non-byte element is refused at the door that builds one
-- rather than by a scan that re-derives the guarantee. RFC 9112 s2.1 defines a
-- message as a sequence of octets; `fromArray` is where a sequence of `Int`
-- becomes one, or fails to.
test "a non-byte input element is refused at the door, not interpreted" =
  expectTrue
    (isNone
      (fromArray
        (appendBytes
          [|71, 256|]
          (toUtf8 "T / HTTP/1.1\r\nHost: pds.example\r\n\r\n"))))

test "absolute-form request target is rejected" =
  expectTrue
    (rejects
      "origin-form"
      (encodeUtf8
        "GET http://pds.example/x HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "fragment in request target is rejected" =
  expectTrue
    (rejects
      "origin-form"
      (encodeUtf8 "GET /x#fragment HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "request target rejects raw braces and preserves percent-encoded braces" = expectEach
  [
    (
      "a raw brace in the query is rejected",
      expectTrue
        (rejects
          "origin-form"
          (encodeUtf8
            "GET /x?value={bad} HTTP/1.1\r\nHost: pds.example\r\n\r\n")),
    ),
    (
      "the percent-encoded spelling of the same query is accepted",
      expectTrue
        (isOk
          (parseRequest
            (encodeUtf8
              "GET /x?value=%7Bgood%7D HTTP/1.1\r\nHost: pds.example\r\n\r\n"))),
    ),
  ]

test "HTTP/1.0 is rejected" =
  expectTrue
    (rejects
      "only HTTP/1.1"
      (encodeUtf8 "GET / HTTP/1.0\r\nHost: pds.example\r\n\r\n"))

test "HTTP protocol name is case-sensitive" = expectEach [
  (
    "an all-lowercase protocol name is rejected",
    expectTrue
      (rejects
        "only HTTP/1.1"
        (encodeUtf8 "GET / http/1.1\r\nHost: pds.example\r\n\r\n")),
  ),
  (
    "a title-case protocol name is rejected",
    expectTrue
      (rejects
        "only HTTP/1.1"
        (encodeUtf8 "GET / Http/1.1\r\nHost: pds.example\r\n\r\n")),
  ),
]

test "missing Host is rejected" =
  expectTrue (rejects "exactly one Host" (encodeUtf8 "GET / HTTP/1.1\r\n\r\n"))

test "duplicate Host is rejected" =
  expectTrue
    (rejects
      "exactly one Host"
      (encodeUtf8 "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\n\r\n"))

test "Host requires a syntactically valid authority" = expectEach [
  (
    "a Host with a space is rejected",
    expectTrue
      (rejects
        "valid authority"
        (encodeUtf8 "GET / HTTP/1.1\r\nHost: bad host\r\n\r\n")),
  ),
  (
    "a Host with a non-numeric port is rejected",
    expectTrue
      (rejects
        "valid authority"
        (encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example:not-a-port\r\n\r\n")),
  ),
  (
    "a bracketed IPv6 literal with a port is accepted",
    expectTrue
      (isOk
        (parseRequest
          (encodeUtf8 "GET / HTTP/1.1\r\nHost: [2001:db8::1]:2583\r\n\r\n"))),
  ),
]

test "Host accepts explicit empty reg-name and IP-literal ports" = expectEach [
  (
    "a reg-name with an empty port is accepted",
    expectTrue
      (isOk
        (parseRequest
          (encodeUtf8 "GET / HTTP/1.1\r\nHost: example.com:\r\n\r\n"))),
  ),
  (
    "an IP-literal with an empty port is accepted",
    expectTrue
      (isOk
        (parseRequest (encodeUtf8 "GET / HTTP/1.1\r\nHost: [::1]:\r\n\r\n"))),
  ),
]

test "malformed Connection token list is rejected" =
  expectTrue
    (rejects
      "Connection"
      (encodeUtf8
        "GET / HTTP/1.1\r\nHost: pds.example\r\nConnection: close,\r\n\r\n"))

test "raw request ceiling accepts at and rejects over" = expectEach [
  (
    "a raw request exactly at the ceiling is admitted",
    expectOk (checkHttpRequestBytes maxHttpRequestBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpRequestBytes (maxHttpRequestBytes + 1)),
  ),
]

test "combined header ceiling accepts at and rejects over" = expectEach [
  (
    "the combined headers exactly at the ceiling is admitted",
    expectOk (checkHttpHeaderBytes maxHttpHeaderBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpHeaderBytes (maxHttpHeaderBytes + 1)),
  ),
]

test "decoded body ceiling accepts at and rejects over" = expectEach [
  (
    "a decoded body exactly at the ceiling is admitted",
    expectOk (checkHttpBodyBytes maxHttpBodyBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpBodyBytes (maxHttpBodyBytes + 1)),
  ),
]

test "request-line ceiling accepts at and rejects over" = expectEach [
  (
    "a request line exactly at the ceiling is admitted",
    expectOk (checkHttpRequestLineBytes maxHttpRequestLineBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpRequestLineBytes (maxHttpRequestLineBytes + 1)),
  ),
]

test "header-field ceiling accepts at and rejects over" = expectEach [
  (
    "the header fields exactly at the ceiling is admitted",
    expectOk (checkHttpHeaderFields maxHttpHeaderFields),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpHeaderFields (maxHttpHeaderFields + 1)),
  ),
]

test "trailer-field ceiling accepts at and rejects over" = expectEach [
  (
    "the trailer fields exactly at the ceiling is admitted",
    expectOk (checkHttpTrailerFields maxHttpTrailerFields),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpTrailerFields (maxHttpTrailerFields + 1)),
  ),
]

test "chunk-count ceiling accepts at and rejects over" = expectEach [
  (
    "the chunks exactly at the ceiling is admitted",
    expectOk (checkHttpChunks maxHttpChunks),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkHttpChunks (maxHttpChunks + 1)),
  ),
]

test "zero-length response serialization is exact and computes one length" =
  expectEqual
    (serializeResponse (mustResponse 204 "No Content" [] [||]))
    (toUtf8 "HTTP/1.1 204 No Content\r\ncontent-length: 0\r\n\r\n")

test "binary response serialization preserves header order and bytes" =
  let response =
    mustResponse
      200
      "OK"
      [
        mustHeader "X-First" (toUtf8 "one"),
        mustHeader "Content-Type" (toUtf8 "application/octet-stream"),
      ]
      [|0, 255|]
  expectEqual
    (serializeResponse response)
    (appendBytes (toUtf8
      "HTTP/1.1 200 OK\r\nx-first: one\r\ncontent-type: application/octet-stream\r\ncontent-length: 2\r\n\r\n") [|
      0, 255
    |])

test "response status outside the three-digit supported range is rejected" = expectEach
  [
    (
      "a status below 100 is refused",
      expectTrue (isErr (makeResponse 99 "Continue" [] [||])),
    ),
    (
      "a status above 599 is refused",
      expectTrue (isErr (makeResponse 600 "Nope" [] [||])),
    ),
  ]

test "response reason phrase injection is rejected" =
  expectTrue (isErr (makeResponse 200 "OK\r\nInjected: yes" [] [||]))

test "safe header constructor canonicalizes names" =
  expectEqual (headerName (mustHeader "X-Trace-ID" (toUtf8 "abc"))) "x-trace-id"

test "invalid response header name and value injection are rejected" = expectEach
  [
    (
      "a header name with a space is refused",
      expectTrue (isErr (makeHeader "Bad Name" (toUtf8 "value"))),
    ),
    (
      "a header value carrying CRLF is refused",
      expectTrue (isErr (makeHeader "X-Test" (toUtf8 "ok\r\nInjected: yes"))),
    ),
  ]

test "caller response framing fields are rejected" =
  let reserved = mustHeader "Content-Length" (toUtf8 "7")
  expectTrue (isErr (makeResponse 200 "OK" [reserved] (toUtf8 "payload")))

test "response body elements must be bytes" =
  expectTrue (isErr (makeResponse 200 "OK" [] [|256|]))

test "query decoding preserves repeated names, empty values, and order" =
  let request =
    mustRequest
      (encodeUtf8 "GET /x?a=1&a=&flag HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  match parseTargetQuery request
    Ok (path, [QueryParam a1 v1, QueryParam a2 v2, QueryParam flag v3]) => expectEach
      [
        ("the path is separated from the query", expectEqual "/x" path),
        ("the first parameter keeps its name", expectEqual "a" a1),
        ("the first parameter keeps its value", expectEqual "1" v1),
        ("the repeated name is preserved, not merged", expectEqual "a" a2),
        ("the second parameter's empty value is preserved", expectEqual "" v2),
        ("the valueless parameter keeps its name", expectEqual "flag" flag),
        (
          "the valueless parameter decodes to the empty string",
          expectEqual "" v3,
        ),
      ]
    _ => fail "expected exactly the three query params (a, a, flag)"

test "empty query component after question mark is accepted" =
  let request =
    mustRequest (encodeUtf8 "GET /x? HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  match parseTargetQuery request
    Ok (path, []) => expectEqual path "/x"
    _ => fail "expected an Ok result with no query params"

test "query percent decoding is exact and plus stays literal" =
  let request =
    mustRequest
      (encodeUtf8
        "GET /x?q=a+b%20c&snow=%E2%98%83 HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  match parseTargetQuery request
    Ok (_, [QueryParam "q" first, QueryParam "snow" second]) => expectEach [
      ("first == \"a+b c\"", expectEqual "a+b c" first),
      ("second == \"☃\"", expectEqual "☃" second),
    ]
    _ => fail "expected exactly the two query params (q, snow)"

test "malformed query percent escape is rejected" =
  expectTrue
    (rejects
      "origin-form"
      (encodeUtf8 "GET /x?q=%2G HTTP/1.1\r\nHost: pds.example\r\n\r\n"))

test "overlong UTF-8 in query is rejected" =
  let request =
    mustRequest
      (encodeUtf8 "GET /x?q=%C0%AF HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  expectTrue (isErr (parseTargetQuery request))

test "decoded query controls and NUL are rejected" =
  let nul =
    mustRequest
      (encodeUtf8 "GET /x?q=%00 HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  let del =
    mustRequest
      (encodeUtf8 "GET /x?q=%7f HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  expectEach [
    ("rejects a NUL control", expectTrue (isErr (parseTargetQuery nul))),
    ("rejects a DEL control", expectTrue (isErr (parseTargetQuery del))),
  ]

test "empty query names are rejected" =
  let first =
    mustRequest
      (encodeUtf8 "GET /x?=value HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  let later =
    mustRequest
      (encodeUtf8 "GET /x?a=1&&b=2 HTTP/1.1\r\nHost: pds.example\r\n\r\n")
  expectEach [
    (
      "rejects an empty leading name",
      expectTrue (isErr (parseTargetQuery first)),
    ),
    ("rejects an empty later name", expectTrue (isErr (parseTargetQuery later))),
  ]

test "media type and subtype are case-insensitive with bounded parameters" =
  expectOkThen
    (mediaType => expectEach [
      (
        "mediaTypeType mediaType == \"application\"",
        expectEqual "application" (mediaTypeType mediaType),
      ),
      (
        "mediaTypeSubtype mediaType == \"json\"",
        expectEqual "json" (mediaTypeSubtype mediaType),
      ),
    ])
    (parseMediaType
      (toUtf8 "Application/JSON; Charset=\"utf-8\"; profile=atproto"))

test "malformed and non-ASCII media types are rejected" = expectEach [
  (
    "a media type with no subtype is refused",
    expectTrue (isErr (parseMediaType (toUtf8 "application"))),
  ),
  (
    "an unterminated quoted parameter is refused",
    expectTrue
      (isErr (parseMediaType (toUtf8 "text/plain; charset=\"unterminated"))),
  ),
  (
    "a non-ASCII byte in the media type is refused",
    expectTrue (isErr (parseMediaType [|97, 112, 112, 47, 255|])),
  ),
]

test "JSON request body is syntax-checked after strict UTF-8 decoding" =
  match (decodeRequestBody
    (requestWithBody
      "Application/JSON; charset=utf-8"
      (encodeUtf8 "{\"ok\":true}")))
    Ok (JsonBody _ _) => pass
    _ => fail "expected a JsonBody decode result"

test "invalid JSON syntax is rejected" =
  expectTrue
    (bodyRejects
      "invalid JSON"
      (requestWithBody "application/json" (encodeUtf8 "{nope}")))

test "invalid JSON UTF-8 is rejected before syntax parsing" =
  expectTrue
    (bodyRejects
      "not valid UTF-8"
      (requestWithBody "application/json" (mustBytes [|0xc0, 0xaf|])))

test "duplicate Content-Type is rejected" =
  let request =
    mustRequest
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/json\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}")
  expectTrue (bodyRejects "duplicate Content-Type" request)

test "missing Content-Type is rejected" =
  let request =
    mustRequest
      (encodeUtf8
        "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 2\r\n\r\n{}")
  expectTrue (bodyRejects "requires Content-Type" request)

test "text media types decode strict UTF-8" =
  match (decodeRequestBody
    (requestWithBody "Text/Plain; charset=utf-8" (encodeUtf8 "héllo")))
    Ok (TextBody mediaType text) => expectEach [
      (
        "mediaTypeType mediaType == \"text\"",
        expectEqual "text" (mediaTypeType mediaType),
      ),
      ("text == \"héllo\"", expectEqual "héllo" text),
    ]
    _ => fail "expected a TextBody decode result"

test "invalid text UTF-8 is rejected" =
  expectTrue
    (bodyRejects
      "not valid UTF-8"
      (requestWithBody "text/plain" (mustBytes [|0xed, 0xa0, 0x80|])))

test "raw media types preserve binary bytes" =
  match (decodeRequestBody
    (requestWithBody "image/png" (mustBytes [|0, 128, 255|])))
    Ok (RawBody mediaType bytes) => expectEach [
      (
        "the media type is image",
        expectEqual "image" (mediaTypeType mediaType),
      ),
      (
        "the media subtype is png",
        expectEqual "png" (mediaTypeSubtype mediaType),
      ),
      (
        "the body bytes are passed through untouched",
        expectEqual [|0, 128, 255|] bytes,
      ),
    ]
    _ => fail "expected a RawBody decode result"

test "JSON body ceiling accepts at and rejects over" = expectEach [
  (
    "a JSON body exactly at the ceiling is admitted",
    expectOk (checkJsonBodyBytes maxJsonBodyBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkJsonBodyBytes (maxJsonBodyBytes + 1)),
  ),
]

test "text body ceiling accepts at and rejects over" = expectEach [
  (
    "a text body exactly at the ceiling is admitted",
    expectOk (checkTextBodyBytes maxTextBodyBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkTextBodyBytes (maxTextBodyBytes + 1)),
  ),
]

test "raw body ceiling accepts at and rejects over" = expectEach [
  (
    "a raw body exactly at the ceiling is admitted",
    expectOk (checkRawBodyBytes maxRawBodyBytes),
  ),
  (
    "one unit past the ceiling is refused",
    expectErr (checkRawBodyBytes (maxRawBodyBytes + 1)),
  ),
]

-- Incremental framing: the scanner splits a stream into requests, so its
-- verdict on a buffer and the one-shot parser's verdict on exactly that
-- framed prefix have to be the same answer arrived at two ways.

prefix : Bytes -> Int -> Bytes
prefix input size = slice input 0 size

sameRequest : Request -> Request -> Bool
sameRequest left right =
  requestMethod left == requestMethod right
    && requestTarget left == requestTarget right
    && requestBody left == requestBody right
    && requestKeepAlive left == requestKeepAlive right
    && names (requestHeaders left) == names (requestHeaders right)
    && names (requestTrailers left) == names (requestTrailers right)

scanAgrees : Bytes -> Bool
scanAgrees input = match scanRequestBoundary input 0
  HttpNeedMore => isErr (parseRequest input)
  HttpFrameFailed _ => isErr (parseRequest input)
  HttpFramedAt at =>
    at >= 0
      && at <= B.length input
      && (match (parseRequestAt input 0 at, parseRequest (prefix input at))
        (Ok viaFrame, Ok viaPrefix) => sameRequest viaFrame viaPrefix
        _ => False)

allAgree : List Bytes -> Bool
allAgree [] = True
allAgree (input :: rest) = scanAgrees input && allAgree rest

pipelined : Bytes
pipelined = simpleGet ++ fixedBinary

corpus : List Bytes
corpus = [
  simpleGet,
  fixedBinary,
  chunked,
  pipelined,
  chunked ++ simpleGet,
  simpleGet ++ encodeUtf8 "x",
  encodeUtf8
    "GET / HTTP/1.1\r\nHost: pds.example\r\nX-Test:\t value \t\r\n\r\n",
  encodeUtf8
    "GET / HTTP/1.1\r\nHost: pds.example\r\nConnection: upgrade, ClOsE\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n0\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
  encodeUtf8 "POST / HTTP/1.1\r\nHost: pds.example\r\n\r\npayload",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 4\r\n\r\nabc",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 1\r\n\r\nab",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 99999999999999999999\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 5242881\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\nZ\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n500001\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nab",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n1\r\naXX",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n1;x=\"no\r\na\r\n0\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nContent-Length: 0\r\n\r\n",
  encodeUtf8
    "POST / HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nx",
  encodeUtf8 "GET / HTTP/1.1\nHost: pds.example\n\n",
  encodeUtf8 "GET / HTTP/1.1\rX",
  encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example\r\n continuation\r\n\r\n",
  encodeUtf8 "GE(T / HTTP/1.1\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example\r\nBad Name: value\r\n\r\n",
  encodeUtf8 "GET /ok\r\nInjected: yes HTTP/1.1\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET http://pds.example/x HTTP/1.1\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET /x#fragment HTTP/1.1\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.0\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET / http/1.1\r\nHost: pds.example\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.1\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.1\r\nHost: bad host\r\n\r\n",
  encodeUtf8 "GET / HTTP/1.1\r\nHost: [2001:db8::1]:2583\r\n\r\n",
  encodeUtf8
    "GET / HTTP/1.1\r\nHost: pds.example\r\nConnection: close,\r\n\r\n",
  encodeUtf8 "GET /x?a=1&a=&flag HTTP/1.1\r\nHost: pds.example\r\n\r\n",
  emptyBytes,
]

everyProperPrefixNeedsMore : Bytes -> Int -> Bool
everyProperPrefixNeedsMore input size =
  if size >= B.length input then
    True
  else match scanRequestBoundary (prefix input size) 0
    HttpNeedMore => everyProperPrefixNeedsMore input (size + 1)
    _ => False

-- A prefix a later byte could still complete must never report a failure the
-- server would answer 400 to, and the byte that completes it must frame.
-- Feeding one byte at a time checks both halves against the same scanner: the
-- verdict on every proper prefix, and the frame the one-shot parser then
-- accepts at exactly that length.
feedOneByteAtATime : Bytes -> Bool
feedOneByteAtATime input =
  everyProperPrefixNeedsMore input 0
    && (match scanRequestBoundary input 0
      HttpFramedAt at => at == B.length input && isOk (parseRequest input)
      _ => False)

test "scanner and one-shot parser agree across the whole HTTP corpus" =
  expectTrue (allAgree corpus)

test "a byte-at-a-time feed asks for more until the completing byte frames it" = expectEach
  [
    (
      "a header-only request frames on its completing byte",
      expectTrue (feedOneByteAtATime simpleGet),
    ),
    (
      "a fixed-length request frames on its completing byte",
      expectTrue (feedOneByteAtATime fixedBinary),
    ),
    (
      "a chunked request frames on its completing byte",
      expectTrue (feedOneByteAtATime chunked),
    ),
  ]

test "a definitively malformed prefix is rejected rather than left pending" =
  match scanRequestBoundary (encodeUtf8 "GET / HTTP/1.0\r\n") 0
    HttpFrameFailed _ => pass
    _ => fail "expected the malformed prefix to be rejected (HttpFrameFailed)"

test "pipelined requests are framed one at a time from a single buffer" =
  match (
    scanRequestBoundary pipelined 0,
    scanRequestBoundary pipelined (B.length simpleGet),
  )
    (HttpFramedAt first, HttpFramedAt second) => match (
      parseRequestAt pipelined 0 first,
      parseRequestAt pipelined first second,
    )
      (Ok head, Ok tail) => expectEach [
        (
          "the first boundary falls at the end of the first request",
          expectEqual (B.length simpleGet) first,
        ),
        (
          "the second boundary falls at the end of the buffer",
          expectEqual (B.length pipelined) second,
        ),
        (
          "the first request is the GET",
          expectEqual "GET" (requestMethod head),
        ),
        (
          "the second request is the POST",
          expectEqual "POST" (requestMethod tail),
        ),
        (
          "the second request's body is framed whole",
          expectEqual (mustBytes [|0, 128, 255|]) (requestBody tail),
        ),
      ]
      _ => fail "expected both parseRequestAt calls to succeed"
    _ => fail "expected both scanRequestBoundary calls to frame"

test "a chunked request frames at its trailer terminator, not the buffer end" =
  let stream = chunked ++ simpleGet
  match scanRequestBoundary stream 0
    HttpFramedAt at => expectEqual at (B.length chunked)
    _ => fail "expected the chunked request to frame at its trailer terminator"

test "trailing bytes frame the first request instead of failing the buffer" =
  let stream = simpleGet ++ encodeUtf8 "x"
  match scanRequestBoundary stream 0
    HttpFramedAt at => expectEach [
      ("at == B.length simpleGet", expectEqual (B.length simpleGet) at),
      (
        "the truncated stream does not parse",
        expectTrue (isErr (parseRequest stream)),
      ),
    ]
    _ => fail "expected the first request to frame before the trailing byte"

-- A resumable scan and a whole-buffer scan are the same framer, so they have to
-- return the same verdict for every prefix a client could stop at. A boundary
-- the two disagreed on would be a request the server frames differently from
-- the one it parses, which is request smuggling.

sameFailure : HttpParseFailure -> HttpParseFailure -> Bool
sameFailure (HttpMalformed left) (HttpMalformed right) = left == right
sameFailure (HttpResourceExcess left) (HttpResourceExcess right) = left == right
sameFailure _ _ = False

sameFrame : HttpFrame -> HttpFrame -> Bool
sameFrame HttpNeedMore HttpNeedMore = True
sameFrame (HttpFramedAt left) (HttpFramedAt right) = left == right
sameFrame (HttpFrameFailed left) (HttpFrameFailed right) =
  sameFailure left right
sameFrame _ _ = False

-- Deliver `input` in `step`-byte increments from `size`, comparing the resumed
-- verdict at each prefix against a scan of that same prefix from scratch.
resumeAgreesGo : Bytes -> Int -> Int -> Int -> HttpScan -> Bool
resumeAgreesGo input start step size scan =
  let buf = prefix input size
  let (resumed, next) = scanRequestBoundaryFrom buf start scan
  let agrees = sameFrame resumed (scanRequestBoundary buf start)
  if size >= B.length input then
    agrees
  else
    agrees
      && resumeAgreesGo
        input
        start
        step
        (min (B.length input) (size + step))
        next

resumeAgrees : Int -> Int -> Bytes -> Bool
resumeAgrees start step input =
  resumeAgreesGo input start step (min start (B.length input)) httpScanStart

allResumeAgree : Int -> List Bytes -> Bool
allResumeAgree _ [] = True
allResumeAgree step (input :: rest) =
  resumeAgrees 0 step input && allResumeAgree step rest

resumeCorpus : List Bytes
resumeCorpus =
  corpus
    ++ [
      encodeUtf8
        "POST /x HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n3;a=b\r\nabc\r\n2\r\nde\r\n0\r\nX-Done: 1\r\n\r\n",
      encodeUtf8
        "POST /x HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 5\r\nX-Pad:\t sp \t\r\n\r\nab\rcd",
      pipelined ++ chunked,
      encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example\r\n\r",
      encodeUtf8 "GET / HTTP/1.1\r\nHost: pds.example\r",
      encodeUtf8 "GET / HTTP/1.1\r",
      encodeUtf8 "GET",
    ]

test "a resumed scan matches a whole-buffer scan one byte at a time" =
  expectTrue (allResumeAgree 1 resumeCorpus)

test "a resumed scan matches a whole-buffer scan at other increments" = expectEach
  [
    (
      "2-byte increments agree with a whole-buffer scan",
      expectTrue (allResumeAgree 2 resumeCorpus),
    ),
    (
      "3-byte increments agree with a whole-buffer scan",
      expectTrue (allResumeAgree 3 resumeCorpus),
    ),
    (
      "7-byte increments agree with a whole-buffer scan",
      expectTrue (allResumeAgree 7 resumeCorpus),
    ),
    (
      "increments larger than the corpus agree with a whole-buffer scan",
      expectTrue (allResumeAgree 4096 resumeCorpus),
    ),
  ]

test "a resumed scan matches a whole-buffer scan from a pipelined offset" = expectEach
  [
    (
      "a byte-at-a-time resume from the pipelined offset agrees",
      expectTrue (resumeAgrees (B.length simpleGet) 1 pipelined),
    ),
    (
      "the same resume agrees with a third request appended",
      expectTrue (resumeAgrees (B.length simpleGet) 1 (pipelined ++ chunked)),
    ),
    (
      "3-byte increments from that offset agree too",
      expectTrue (resumeAgrees (B.length simpleGet) 3 (pipelined ++ chunked)),
    ),
  ]

-- A caller that accumulates into a backing array with spare capacity hands the
-- scanner more bytes than it has received. Only the first `avail` bytes are
-- input; framing a request out of the rest would be the server answering a
-- request its client never sent.

-- Bytes that could complete a fixed-length body, a chunk-size line, or a
-- trailer section if the scanner ever mistook capacity for input.
slackBytes : Bytes
slackBytes = encodeUtf8 "\r\n0\r\n\r\nZZZZ"

tenByteBody : Bytes
tenByteBody =
  encodeUtf8
    "POST /xrpc/com.atproto.repo.uploadBlob HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 10\r\n\r\nabc"

test "a body short of its content length is pending, padding notwithstanding" =
  let padded = tenByteBody ++ mustBytes (arrayMakeWith 7 (_ => 0))
  match (
    fst
      (scanRequestBoundaryWithin padded (B.length tenByteBody) 0 httpScanStart),
    scanRequestBoundary padded 0,
  )
    (HttpNeedMore, HttpFramedAt at) => expectEqual at (B.length padded)
    _ =>
      fail
        "expected HttpNeedMore on the short scan and HttpFramedAt on the full one"

-- Scanning a padded backing array one received byte at a time has to agree with
-- scanning the exact prefix of that many bytes, for every shape in the corpus.
availAgreesGo : Bytes -> Int -> Int -> HttpScan -> Bool
availAgreesGo padded live avail scan =
  let (resumed, next) = scanRequestBoundaryWithin padded avail 0 scan
  let agrees = sameFrame resumed (scanRequestBoundary (prefix padded avail) 0)
  if avail >= live then
    agrees
  else
    agrees && availAgreesGo padded live (avail + 1) next

availAgrees : Bytes -> Bool
availAgrees input =
  availAgreesGo (input ++ slackBytes) (B.length input) 0 httpScanStart

allAvailAgree : List Bytes -> Bool
allAvailAgree [] = True
allAvailAgree (input :: rest) = availAgrees input && allAvailAgree rest

test "a scan bounded by its received length ignores the bytes past it" =
  expectTrue (allAvailAgree resumeCorpus)
