{- | Gate A's stub appview (#2912): a loopback listener standing in for the
   service a proxied read is forwarded to, and for the egress proxy in front of
   it.

   It exists to make the credential OBSERVABLE from outside this project. Every
   other test of service auth in this tree grades a token against code that
   minted it or against a vector file; this driver is the only place a token
   crosses a socket and is read by something that never knew what the issuer
   intended. So what it does with each call is log the claims it RECEIVED —
   `aud`, `lxm`, `iss`, `jti` — and echo two of them back in its answer, which
   is what lets `pds/test/serve_e2e.sh` assert, from the client's side of the
   PDS, that the audience and method a token was minted for are the ones the
   header asked for and not the ones an attacker did.

   It logs the same way what the call itself carried: the verb, the relayed
   request fields, and the body. A forwarded call is no longer a bodyless GET,
   and a relay that quietly dropped a field or a body would otherwise be
   invisible from either side of the PDS — the client sees only an upstream
   answer, which a PDS that forwarded nothing at all can still produce. Its
   answer carries an `atproto-repo-rev` field for the same reason in the other
   direction: only the upstream can set it, so seeing it at the client proves
   the response half of the relay.

   It verifies NOTHING. A stub that graded the signature would be asserting
   self-consistency between two halves of this project; that judgement belongs
   to `pds/tools/check_pds_service_jwt.mjs` and its reference verifier. This
   driver is an observer, and an observer that refused a call could hide a
   defect behind its own refusal.

   Six modes:

     appview_stub_main answer <port> <logfile> <status>
     appview_stub_main batch <port> <logfile> <status> <count>
     appview_stub_main bulk <port> <logfile> <status> <count> <size> <prefix> <holdMs>
     appview_stub_main linger <port> <logfile> <status>
     appview_stub_main stall <port>
     appview_stub_main deaf <port>

   `answer` serves one call at a time — read, log, reply, close — which is all
   a sequential gate needs, and replies with `<status>` so a case can prove the
   upstream's own status code is relayed rather than replaced. `batch` answers
   identically but holds the first `<count>` calls unanswered until all
   `<count>` have arrived, which is how a case about how many calls the PDS
   keeps outstanding gets that number to be its own rather than the scheduler's.
   `linger` answers identically and then holds the connection open instead of
   closing it, which separates "the response is complete" from "the peer has
   finished with the socket" — two events a reader can confuse for one. `bulk`
   holds `<count>` calls the way `batch` does and answers each with a
   `<size>`-byte body, sent as `<prefix>` bytes at once and then a byte at a
   time for `<holdMs>` before the rest: an answer that is large, in flight,
   and not yet complete for as long as a case needs one to be. `stall`
   accepts and never answers: it is the head-of-line-blocking case's upstream,
   and the claim under test there is about the PDS's scheduler, not about this
   driver.
   `deaf` never accepts at all and fills its own accept queue until the kernel
   stops answering handshakes, which is the only state in which a LOOPBACK dial
   hangs rather than completing or being refused — the upstream a case about
   the PDS's connect needs.

   `PORT` may be 0, in which case the kernel picks one and the readiness line
   on stdout names it — the same contract `pds/serve.mdk` has with this gate,
   so neither side has to guess a free port. -}

import array.{concat, make, sliceClamped}
import base64.{decodeUrlSafe}
import bytes.{fromArray, toArray}
import http.{
  Header,
  HttpFrame(..),
  Request,
  headerName,
  headerValue,
  makeHeader,
  makeResponse,
  parseRequest,
  requestBody,
  requestHeaders,
  requestMethod,
  requestTarget,
  scanRequestBoundary,
  serializeResponse,
}
import json.{Json(..), get, jObject, parse, stringify}
import list.{reverse}
import net.{
  Connection,
  Listener,
  accept,
  close,
  listen,
  listenPort,
  recv,
  recvAll,
  sendAll,
}
import string.{drop, fromUtf8, split, startsWith, toInt, toUtf8}

-- ── the claims a call arrived with ──────────────────────────────────────────

{- | Base64url as RFC 7515 §2 writes it — no trailing padding — which
   `base64.decodeUrlSafe` (RFC 4648 §5) rejects outright. The padding is put
   back rather than the decoder relaxed.

   `pds/lib/jwt.mdk` holds the same adaptation privately, and it stays private
   there: this driver is supposed to read a token the way an off-box peer does,
   with its own decoder, so sharing one would make the observation circular. -}
-- This shares `base64.decode`'s declared signature but neither its alphabet nor
-- its padding convention, which is the whole reason it exists;
-- rule-stdlib-reimpl compares declared signatures only and cannot see the
-- difference, so it is disabled for this file rather than delegated away.
-- lint-disable-file rule-stdlib-reimpl
segmentBytes : String -> Result String (Array Int)
segmentBytes segment = match stringLength segment % 4
  0 => decodeUrlSafe segment
  2 => decodeUrlSafe "\{segment}=="
  3 => decodeUrlSafe "\{segment}="
  _ => Err "appview_stub: segment is not a valid unpadded base64url length"

claimsJson : String -> Result String Json
claimsJson token = match split "." token
  [_, claimsSeg, _] => match segmentBytes claimsSeg
    Err message => Err "appview_stub: claims segment: \{message}"
    Ok bytes => parse (fromUtf8 bytes)
  _ => Err "appview_stub: bearer credential is not three segments"

-- A claim that is absent reads as `<absent>` rather than failing the call: a
-- missing `lxm` is exactly the defect a gate asserting on this line is looking
-- for, and a driver that refused the call would print nothing to assert on.
stringClaim : String -> Json -> String
stringClaim name claims = match get name claims
  Some (JString text) => text
  _ => "<absent>"

intClaim : String -> Json -> String
intClaim name claims = match get name claims
  Some (JInt value) => intToString value
  _ => "<absent>"

-- ── the request ─────────────────────────────────────────────────────────────

findHeaderValue : String -> List Header -> Option String
findHeaderValue _ [] = None
findHeaderValue wanted (header :: rest) =
  if headerName header == wanted then
    Some (fromUtf8 (headerValue header))
  else
    findHeaderValue wanted rest

bearerToken : Request -> Result String String
bearerToken request =
  match findHeaderValue "authorization" (requestHeaders request)
    None => Err "appview_stub: call carried no authorization field"
    Some value =>
      if startsWith "Bearer " value then
        Ok (drop 7 value)
      else
        Err "appview_stub: authorization field is not a bearer credential"

-- ── the answer ──────────────────────────────────────────────────────────────

mustJsonHeader : Header
mustJsonHeader =
  resultOrPanic
    "appview_stub: header error"
    (makeHeader "content-type" (toUtf8 "application/json"))

{- | A repository revision this driver invents. Nothing interprets the value;
   what a case asserts on is that a field only the upstream could have set
   reaches the client. -}
stubRepoRev : String
stubRepoRev = "3lstubrev0000"

mustRepoRevHeader : Header
mustRepoRevHeader =
  resultOrPanic
    "appview_stub: header error"
    (makeHeader "atproto-repo-rev" (toUtf8 stubRepoRev))

{- | The stub's answer, echoing the audience and method the credential it was
   handed actually named.

   Echoing them is what makes the assertion available to the CLIENT. The gate
   can read the log file too, but a body carrying `aud` and `lxm` proves one
   thing the log cannot: that what the PDS relayed to its client is this
   service's own answer to this service's own credential, rather than something
   the PDS composed. -}
answerBytes : Int -> String -> String -> Array Int
answerBytes status aud lxm =
  let body =
    toUtf8
      (stringify
        (jObject [
          ("appview", JString "stub"),
          ("aud", JString aud),
          ("lxm", JString lxm),
        ]))
  match makeResponse status "OK" [mustJsonHeader, mustRepoRevHeader] body
    Ok response => serializeResponse response
    Err message => panic "appview_stub: response error: \{message}"

{- | The answer for a call this driver could not read the claims of.

   It is a 200 carrying `<absent>` claims, not a refusal: the PDS relays the
   status it is given, so answering 400 here would make a stub-side read failure
   indistinguishable from the PDS refusing the request itself — and telling
   those two apart is the whole point of the cases this driver serves. -}
unreadableBytes : Int -> Array Int
unreadableBytes status = answerBytes status "<unreadable>" "<unreadable>"

-- ── modes ───────────────────────────────────────────────────────────────────

logLine : String -> String -> <FileWrite "_"> Unit
logLine path line = match appendFile path "\{line}\n"
  Ok () => ()
  Err message => panic "appview_stub: could not log: \{message}"

{- | One complete request, head and body.

   Read with `recv` and not `recvAll`: a proxied call does not close its end
   before it expects an answer, so reading to EOF here would deadlock against
   the very peer this driver exists to answer. Where the request ends is
   `stdlib/http`'s own framer rather than a terminator search, because a
   forwarded call can carry a body and a driver that stopped at the header
   terminator would answer before the body it is supposed to observe had
   arrived. -}
recvRequest : Connection -> Array Int -> <Net "_"> Result String Request
recvRequest conn buffer = match fromArray buffer
  -- `recv` hands back an `Array Int`; the framer reads a packed `Bytes`, and
  -- `fromArray` is the only door between them.
  None => Err "appview_stub: a byte read off the socket fell outside 0..255"
  Some packed => match scanRequestBoundary packed 0
    HttpFramedAt at => parseRequest (slice packed 0 at)
    -- The framer refused what it has; parse the same bytes for the diagnostic
    -- rather than keeping a second wording of it here.
    HttpFrameFailed _ => parseRequest packed
    HttpNeedMore => match recv conn 65536
      Err message => Err "appview_stub: read failed: \{message}"
      Ok chunk =>
        if arrayLength chunk == 0 then
          Err "appview_stub: call closed before its request was complete"
        else
          recvRequest conn (concat [|buffer, chunk|])

observedField : String -> Request -> String
observedField name request = match findHeaderValue name (requestHeaders request)
  Some value => value
  None => "<absent>"

-- One call is one log line, so a body with a newline in it would split the
-- record. Nothing this gate forwards carries one, and a body that did would
-- show up as a short line rather than a wrong one.
observedCall : Request -> String
observedCall request =
  "verb=\{requestMethod request} content-type=\{observedField "content-type" request} accept-language=\{observedField "accept-language" request} body=\{fromUtf8 (toArray (requestBody request))}"

-- | Reads one call, logs what it carried, and returns the bytes that answer
-- it — WITHOUT sending them. Split from `answerCall` so `batch` can hold a
-- read call unanswered, which is the only way a mode can make the PDS keep
-- more than one of them outstanding.
answerFor : String -> Int -> Connection -> <FileWrite "_", Net "_"> Array Int
answerFor path status conn = match recvRequest conn [||]
  Err message =>
    let () = logLine path "unreadable \{message}"
    unreadableBytes status
  Ok request => match bearerToken request
    Err message =>
      let () = logLine path "unreadable \{message}"
      unreadableBytes status
    Ok token => match claimsJson token
      Err message =>
        let () = logLine path "unreadable \{message}"
        unreadableBytes status
      Ok claims =>
        let aud = stringClaim "aud" claims
        let lxm = stringClaim "lxm" claims
        let () =
          logLine
            path
            "call aud=\{aud} lxm=\{lxm} iss=\{stringClaim "iss" claims} jti=\{stringClaim "jti" claims} iat=\{intClaim "iat" claims} target=\{requestTarget request} \{observedCall request}"
        answerBytes status aud lxm

answerCall : String ->
  Int ->
  Connection ->
  <FileWrite "_", Net "_"> Result String Unit
answerCall path status conn = sendAll conn (answerFor path status conn)

-- Reads the call to its end and answers nothing, holding the connection until
-- the PDS's own outbound budget gives up on it. `serveLoop` then closes it and
-- accepts the next one, so a stalled upstream can be asked twice.
stallCall : Connection -> <Net "_"> Result String Unit
stallCall conn = match recvAll conn
  Err _ => Ok ()
  Ok _ => Ok ()

{- | Answers in full, like `answer`, and then does not close: it reads on until
   the PEER closes, so the connection stays open behind a complete response.

   This is the upstream a real deployment produced (#3097) and the one a
   caller that waits for the close cannot tell from an upstream with nothing
   to say — a complete answer is in the client's hands, and the socket says
   nothing more will arrive only when it eventually shuts. Holding until the
   peer closes rather than for a fixed span keeps this mode free of a clock
   and leaves the timing entirely to the PDS: how long it takes to answer is
   the measurement. -}
lingerCall : String ->
  Int ->
  Connection ->
  <FileWrite "_", Net "_"> Result String Unit
lingerCall path status conn =
  let answered = answerCall path status conn
  match recvAll conn
    Err _ => answered
    Ok _ => answered

-- Announces the bound port and hands it back, so a mode that needs the port
-- itself does not ask for it a second time and risk naming a different one in
-- its own output than the gate read from this line.
ready : Listener -> <IO, Net "_"> Int
ready lis = match listenPort lis
  Err message => panic "appview_stub: listener port unavailable: \{message}"
  Ok port =>
    let () = println "appview-stub: listening on 127.0.0.1:\{intToString port}"
    let () = flushStdout ()
    port

{- | How long one `deaf` dial is given to complete before the accept queue is
   taken to be full. A loopback handshake the kernel answers completes in
   microseconds, so this is three orders of magnitude of slack. -}
dialProbeMs : Int
dialProbeMs = 300

{- | How many dials `deaf` will make looking for the queue's edge. The kernel
   takes the listen backlog plus one before it starts dropping handshakes
   (`listen(fd, 128)`, `stdlib/net.mdk`), so this is comfortably past it while
   still terminating if a future kernel queues far more. -}
backlogDialAttempts : Int
backlogDialAttempts = 512

{- | Whether a dial to this box's own `port` finishes its handshake inside
   `dialProbeMs`.

   The readiness externs are used directly, rather than `net`'s blocking
   `connect`, because the question is exactly the one a blocking connect cannot
   answer: a dial into a FULL accept queue is not refused — the kernel drops
   the handshake and `connect(2)` waits minutes on SYN retries — so a driver
   that dialled with `net.connect` would itself hang at the edge it is looking
   for, with nothing left to report the edge with.

   A socket whose handshake never completed is deliberately left open: the
   queue stays full only while those requests keep retransmitting, and closing
   them would let the next dial through — including the PDS's, which is the
   dial the case needs to hang. -}
dialCompletes : Int -> <Net "_"> Bool
dialCompletes port = match netConnectStart "127.0.0.1" port
  Err message => panic "appview_stub: deaf dial failed: \{message}"
  Ok fd => match ioPoll [|fd|] [|2|] dialProbeMs
    Err message => panic "appview_stub: deaf poll failed: \{message}"
    Ok _ => match netConnectCheck fd
      Ok (Some _) => True
      Ok None => False
      Err message => panic "appview_stub: deaf dial refused: \{message}"

{- | Dial this listener until a dial stops completing, then say so.

   The readiness line is already out by the time this runs, so the gate waits
   for THIS line before pointing a PDS at the port: a dial made while the queue
   still had room would complete, and the case would grade a connect that never
   hung. -}
fillBacklog : Int -> Int -> <IO, Net "_"> Unit
fillBacklog port attempts =
  if attempts <= 0 then
    panic "appview_stub: the accept queue never filled"
  else if dialCompletes port then
    fillBacklog port (attempts - 1)
  else
    let () =
      println "appview-stub: accept queue full on 127.0.0.1:\{intToString port}"
    flushStdout ()

-- Nothing is ever accepted, so there is no loop to run: the process exists
-- from here on only to hold the queue full and the sockets open.
idleForever : Unit -> <Clock> Unit
idleForever u =
  let () = sleepMs 60000
  idleForever ()

deaf : Int -> <Clock, IO, Net "_"> Unit
deaf port = match listen "127.0.0.1" port
  Err message => panic "appview_stub: listen failed: \{message}"
  Ok lis =>
    let bound = ready lis
    let () = fillBacklog bound backlogDialAttempts
    idleForever ()

{- | `stdlib/net`'s own `serveLoop` cannot carry this: its handler row is closed
   at `<Net "_">`, and logging the claims a call arrived with is a file write.
   One connection at a time, closed on every path, which is all a sequential
   gate asks for. -}
acceptLoop : Listener ->
  (Connection -> <FileWrite "_", Net "_"> Result String Unit) ->
  <FileWrite "_", Net "_"> Unit
acceptLoop lis handle = match accept lis
  Err message => panic "appview_stub: accept failed: \{message}"
  Ok conn =>
    let _ = handle conn
    let _ = close conn
    acceptLoop lis handle

serveWith : Int ->
  (Listener -> <FileWrite "_", Net "_"> Unit) ->
  <IO, Net "_"> Unit
serveWith port run = match listen "127.0.0.1" port
  Err message => panic "appview_stub: listen failed: \{message}"
  Ok lis =>
    let _ = ready lis
    run lis

serve : Int ->
  (Connection -> <FileWrite "_", Net "_"> Result String Unit) ->
  <IO, Net "_"> Unit
serve port handle = serveWith port (lis => acceptLoop lis handle)

{- | Accepts `count` calls and answers NONE of them until all `count` have
   arrived, then answers them together and serves one at a time from there on.

   It exists to make concurrency the CASE's rather than the scheduler's. An
   upstream that answers as it goes lets the PDS finish a call before the next
   one has been made, so a fan-out of twelve can be served with three ever
   outstanding and prove nothing about a ceiling of eight — and which it was is
   invisible from the client, which sees twelve answers either way. Holding the
   first `count` removes the choice: the PDS cannot complete any of them until
   it has `count` of them outstanding, so a case that names the ceiling as
   `count` observes the ceiling.

   The calls after the batch are answered singly rather than in another batch
   of `count`, because the ones behind a ceiling are made only as the ones in
   front of them finish: a second batch would be waiting for callers who are
   waiting for it. -}
batchAnswer : String -> Int -> Int -> Listener -> <FileWrite "_", Net "_"> Unit
batchAnswer path status count lis =
  let () = flushHeld (holdCalls path status lis count [])
  acceptLoop lis (answerCall path status)

holdCalls : String ->
  Int ->
  Listener ->
  Int ->
  List (Connection, Array Int) ->
  <FileWrite "_", Net "_"> List (Connection, Array Int)
holdCalls path status lis remaining held =
  if remaining <= 0 then
    held
  else match accept lis
    Err message => panic "appview_stub: accept failed: \{message}"
    Ok conn =>
      holdCalls
        path
        status
        lis
        (remaining - 1)
        ((conn, answerFor path status conn) :: held)

-- The order the held calls are answered in is not the order they arrived in,
-- and nothing depends on it: the log is already written in arrival order by
-- `answerFor`, and each answer goes back on the connection that asked for it.
flushHeld : List (Connection, Array Int) -> <Net "_"> Unit
flushHeld [] = ()
flushHeld ((conn, bytes) :: rest) =
  let _ = sendAll conn bytes
  let _ = close conn
  flushHeld rest

-- A `size`-byte answer. The body is filler: what a case about a large answer
-- asserts on is its size and status, and a body that also echoed the claims
-- would be one more thing for the PDS to relay intact without proving more.
bulkBytes : Int -> Int -> Array Int
bulkBytes status size =
  match makeResponse status "OK" [mustJsonHeader] (make size 120)
    Ok response => serializeResponse response
    Err message => panic "appview_stub: response error: \{message}"

{- | How long `bulk` waits after each held call's prefix before sending the
   next one's.

   The call that is sent its prefix first is the one that reaches a size worth
   charging first, and a case that says which of two calls holds the budget
   needs that order to be this driver's rather than the PDS's scheduler's. A
   prefix is read off a loopback socket in milliseconds. -}
bulkPrefixGapMs : Int
bulkPrefixGapMs = 300

{- | How often `bulk` sends each held call one more byte while it holds them.

   Far inside any silence budget the PDS keeps on an upstream read, so what
   holds a call open is this driver not having finished and never the PDS
   giving up on a peer that went quiet. -}
bulkTickMs : Int
bulkTickMs = 500

-- Errors are ignored: a call the PDS has already abandoned is closed on its
-- side, and what the case asserts is what the PDS answered its own client.
sendRange : Array Int -> Int -> Int -> Connection -> <Net "_"> Unit
sendRange bytes lo hi conn =
  if lo >= hi then
    ()
  else
    let _ = sendAll conn (sliceClamped lo hi bytes)
    ()

sendPrefixes : Array Int -> Int -> List Connection -> <Clock, Net "_"> Unit
sendPrefixes _ _ [] = ()
sendPrefixes bytes prefix (conn :: rest) =
  let () = sendRange bytes 0 prefix conn
  let () = sleepMs bulkPrefixGapMs
  sendPrefixes bytes prefix rest

sendEach : Array Int -> Int -> Int -> List Connection -> <Net "_"> Unit
sendEach _ _ _ [] = ()
sendEach bytes lo hi (conn :: rest) =
  let () = sendRange bytes lo hi conn
  sendEach bytes lo hi rest

-- One byte to every held call per tick, from `at` until `until`, and returns
-- where it stopped.
trickle : Array Int -> Int -> Int -> List Connection -> <Clock, Net "_"> Int
trickle bytes at until conns =
  if at >= until then
    at
  else
    let () = sleepMs bulkTickMs
    let () = sendEach bytes at (at + 1) conns
    trickle bytes (at + 1) until conns

finishAll : Array Int -> Int -> List Connection -> <Net "_"> Unit
finishAll _ _ [] = ()
finishAll bytes from (conn :: rest) =
  let () = sendRange bytes from (arrayLength bytes) conn
  let _ = close conn
  finishAll bytes from rest

{- | Holds `count` calls as `batch` does, then answers every one of them with a
   `size`-byte body without completing any: `prefix` bytes each, in the order
   the calls arrived, and then a byte at a time to all of them for `holdMs`.
   Only then does it send the rest and close. The calls after the held ones
   are answered singly and at once, at the same size.

   Holding answers part-sent is what makes a case about bytes in flight
   observable. An answer the PDS has only partly read is one it is holding
   and has not relayed, and this driver, not the PDS, decides how long that
   lasts; an upstream that answered at once would let the first call finish
   before the second held anything, and a budget on answers held together
   would never be reached. -}
bulkAnswer : String ->
  Int ->
  Int ->
  Int ->
  Int ->
  Int ->
  Listener ->
  <Clock, FileWrite "_", Net "_"> Unit
bulkAnswer path status count size prefix holdMs lis =
  let held = holdCalls path status lis count []
  let conns = reverse (map (pair => let (conn, _) = pair in conn) held)
  let bytes = bulkBytes status size
  let sent = min prefix (arrayLength bytes)
  let () = sendPrefixes bytes sent conns
  let () = logLine path "bulk prefix-sent \{intToString sent}"
  let upTo = min (arrayLength bytes) (sent + holdMs / bulkTickMs)
  let from = trickle bytes sent upTo conns
  let () = finishAll bytes from conns
  let () = logLine path "bulk finished"
  acceptLoop lis (bulkCall path status size)

bulkCall : String ->
  Int ->
  Int ->
  Connection ->
  <FileWrite "_", Net "_"> Result String Unit
bulkCall path status size conn =
  let _ = answerFor path status conn
  sendAll conn (bulkBytes status size)

mustPort : String -> Int
mustPort text = optionOrPanic "appview_stub: not a port: \{text}" (toInt text)

mustStatus : String -> Int
mustStatus text =
  optionOrPanic "appview_stub: not a status code: \{text}" (toInt text)

mustCount : String -> Int
mustCount text = optionOrPanic "appview_stub: not a count: \{text}" (toInt text)

usage : String
usage =
  "usage: appview_stub_main <answer PORT LOGFILE STATUS|batch PORT LOGFILE STATUS COUNT|bulk PORT LOGFILE STATUS COUNT SIZE PREFIX HOLDMS|linger PORT LOGFILE STATUS|stall PORT|deaf PORT>"

main : <Clock, IO, Env, Net "_"> Unit
main = match args ()
  ["answer", port, path, status] =>
    serve (mustPort port) (answerCall path (mustStatus status))
  ["batch", port, path, status, count] =>
    serveWith
      (mustPort port)
      (batchAnswer path (mustStatus status) (mustCount count))
  ["linger", port, path, status] =>
    serve (mustPort port) (lingerCall path (mustStatus status))
  ["stall", port] => serve (mustPort port) stallCall
  ["deaf", port] => deaf (mustPort port)
  ["bulk", port, path, status, count, size, prefix, holdMs] =>
    match listen "127.0.0.1" (mustPort port)
      Err message => panic "appview_stub: listen failed: \{message}"
      Ok lis =>
        let _ = ready lis
        bulkAnswer
          path
          (mustStatus status)
          (mustCount count)
          (mustCount size)
          (mustCount prefix)
          (mustCount holdMs)
          lis
  _ => panic usage
