{- | Cross-engine value-parity probe for #1724's fixed reduction paths.

   This is not an answer key: the external 944/1028-row corpora own absolute
   correctness. It prints the same public operations on eval/native/Wasm so a
   backend-specific value change cannot hide behind the native corpora. -}

import lib.field.{feFromBytesReduce, feMul, feInverse, feToBytes}
import lib.scalar.{scFromBytesReduce, scMul, scInverse, scToBytes}
import lib.sign.{secretKeyFromBytes, publicKeyCompressed, publicKeyForSecret}
import bytes.{Bytes, fromU8Array, length}
import u8 as U8

renderBytes : Bytes -> Int -> String -> String
renderBytes bs i acc =
  if i >= length bs then
    acc
  else
    renderBytes bs (i + 1) "\{acc}\{intToString (U8.toInt bs[i])},"

emit : String -> Bytes -> <IO> Unit
emit label bs = println "\{label}:\{renderBytes bs 0 ""}"

main =
  let maxBytes = fromU8Array (arrayMake 32 255)
  let oneBytes = fromU8Array (arrayMakeWith 32 (i => if i == 31 then 1 else 0))
  let fieldMax = feFromBytesReduce maxBytes
  let scalarMax = scFromBytesReduce maxBytes
  let () = emit "field-mul" (feToBytes (feMul fieldMax fieldMax))
  let () = emit "field-inv" (feToBytes (feInverse fieldMax))
  let () = emit "scalar-mul" (scToBytes (scMul scalarMax scalarMax))
  let () = emit "scalar-inv" (scToBytes (scInverse scalarMax))
  match secretKeyFromBytes oneBytes
    Ok secret =>
      emit "public-key-1" (publicKeyCompressed (publicKeyForSecret secret))
    Err message =>
      panic "constant_time_parity: rejected fixed secret: \{message}"
