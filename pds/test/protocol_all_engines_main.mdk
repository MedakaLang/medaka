{- | Deterministic all-engine Phase-2 protocol transcript.

   Expected cells are independently specified from RFC 9112 framing and the
   pinned XRPC error envelope. They are intentionally not captured from an
   engine. -}

import http.{
  Header,
  makeHeader,
  makeResponse,
  maxHttpRequestLineBytes,
  mediaTypeSubtype,
  mediaTypeType,
  QueryParam(..),
  Response,
}
import string.{repeat, toUtf8}
import lib.cid.{cidForRaw}
import lib.httpclient as HC
import lib.httpclient.{HttpClientMalformed, HttpClientResourceExcess}
import lib.resource_limits.{
  maxHttpClientBodyBytes,
  maxHttpClientChunkBytes,
  maxHttpClientHeaderBytes,
  maxHttpClientHeaderFields,
  maxHttpClientStatusLineBytes,
}
import lib.server_core.{
  Account,
  RequestContext(..),
  Handler,
  Server,
  handleBytes,
  makeAccount,
  makeServer,
}
import lib.store.{Store, storeEmpty, storeGet, storePut, storeSize}
import lib.xrpc.{
  AuthPolicy(..),
  Endpoint,
  InputPolicy(..),
  Registry,
  XrpcCall(..),
  makeRegistry,
  procedureEndpoint,
  queryEndpoint,
}

mustHeader : String -> String -> Header
mustHeader name value = match makeHeader name (toUtf8 value)
  Ok header => header
  Err message => panic "protocol_all_engines: header setup failed: \{message}"

mustResponse : Int -> String -> String -> Response
mustResponse status reason body =
  match (makeResponse
    status
    reason
    [mustHeader "content-type" "text/plain"]
    (toUtf8 body))
    Ok response => response
    Err message =>
      panic "protocol_all_engines: response setup failed: \{message}"

mustEndpoint : Result String Endpoint -> Endpoint
mustEndpoint (Ok endpoint) = endpoint
mustEndpoint (Err message) =
  panic "protocol_all_engines: endpoint setup failed: \{message}"

mustRegistry : Result String Registry -> Registry
mustRegistry (Ok registry) = registry
mustRegistry (Err message) =
  panic "protocol_all_engines: registry setup failed: \{message}"

registry : Registry
registry =
  mustRegistry
    (makeRegistry [
      mustEndpoint (queryEndpoint "com.example.query.fixed" PublicRoute),
      mustEndpoint (queryEndpoint "Com.Example.query.caseFixed" PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.params.check" NoInput PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.raw.echo" RawInput PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.block.put" RawInput PublicRoute),
    ])

handler : Handler
handler _ _ store (QueryCall "com.example.query.fixed" _) =
  (store, mustResponse 200 "OK" "fixed")
handler _ _ store (QueryCall "Com.Example.query.caseFixed" _) =
  (store, mustResponse 200 "OK" "authority-case")
handler _ _ store (ProcedureNoInputCall "com.example.params.check" [QueryParam firstName firstValue, QueryParam secondName secondValue, QueryParam flag flagValue]) =
  if firstName == "dryRun"
    && firstValue == "true"
    && secondName == "dryRun"
    && secondValue == ""
    && flag == "flag"
    && flagValue == "" then
    (store, mustResponse 200 "OK" "params-ordered")
  else
    panic "protocol_all_engines: procedure parameter order mismatch"
handler _ _ store (ProcedureRawCall "com.example.raw.echo" [] media bytes) =
  let mediaType = mediaTypeType media
  let mediaSubtype = mediaTypeSubtype media
  if mediaType == "text"
    && mediaSubtype == "plain"
    && bytes == toUtf8 "hello" then
    (store, mustResponse 200 "OK" "raw-text")
  else if mediaType == "application"
    && mediaSubtype == "json"
    && bytes == toUtf8 "{nope}" then
    (store, mustResponse 200 "OK" "raw-json")
  else if mediaType == "application"
    && mediaSubtype == "octet-stream"
    && bytes == [|0, 128, 255|] then
    (store, mustResponse 200 "OK" "raw-opaque")
  else
    panic "protocol_all_engines: raw media/body preservation mismatch"
handler _ _ store (ProcedureRawCall "com.example.block.put" [] _ bytes) =
  match storePut (cidForRaw bytes) bytes store
    Err message =>
      panic "protocol_all_engines: verified store update failed: \{message}"
    Ok next => (next, mustResponse 201 "Created" "stored")
handler _ _ _ _ = panic "protocol_all_engines: unexpected routed call"

account : Account
account =
  match (makeAccount
    "did:plc:medakaprotocoltest"
    "protocol.example"
    "pds.example")
    Ok value => value
    Err message =>
      panic "protocol_all_engines: account setup failed: \{message}"

{- | The instant every request in this file is placed at. `lib.server_core`
   reads no clock, so each of its callers supplies one. -}
{- | The per-request nonce every request in this file is placed at. Nothing
   here drives a route that mints a token, so the value only has to be fixed;
   `pds/shell/server.mdk` draws a real one from `osEntropyBytes` per request. -}
testNonce : Array Int
testNonce = arrayMakeWith 16 (i => (i * 11 + 5) % 256)

testContext : RequestContext
testContext = RequestContext { nowSeconds = 1700000000, nonce = testNonce }

server : Server
server = makeServer account registry handler

seedBytes : Array Int
seedBytes = toUtf8 "seed"

seededStore : Store
seededStore = match storePut (cidForRaw seedBytes) seedBytes storeEmpty
  Ok store => store
  Err message =>
    panic "protocol_all_engines: seed store setup failed: \{message}"

seedPreserved : Store -> Bool
seedPreserved store = storeGet (cidForRaw seedBytes) store == Some seedBytes

expectedTextResponse : Int -> String -> String -> Array Int
expectedTextResponse status reason body =
  toUtf8
    "HTTP/1.1 \{intToString status} \{reason}\r\ncontent-type: text/plain\r\ncontent-length: \{intToString (arrayLength (toUtf8 body))}\r\n\r\n\{body}"

expectedError : Int -> String -> String -> String -> Array Int
expectedError status reason code message =
  let body = "{\"error\":\"\{code}\",\"message\":\"\{message}\"}"
  toUtf8
    "HTTP/1.1 \{intToString status} \{reason}\r\ncontent-type: application/json\r\ncontent-length: \{intToString (arrayLength (toUtf8 body))}\r\n\r\n\{body}"

appendBytes : Array Int -> Array Int -> Array Int
appendBytes left right =
  let leftSize = arrayLength left
  arrayMakeWith (leftSize + arrayLength right) (i =>
    if i < leftSize then left[i] else right[i - leftSize])

fixedQuery : Array Int
fixedQuery =
  toUtf8
    "GET /xrpc/com.example.query.fixed?one=1&one=2 HTTP/1.1\r\nHost: pds.example\r\n\r\n"

chunkedPut : Array Int
chunkedPut =
  toUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/octet-stream\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n2\r\nbc\r\n0\r\n\r\n"

malformedRequest : Array Int
malformedRequest =
  toUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"

lowercaseVersionRequest : Array Int
lowercaseVersionRequest =
  toUtf8
    "POST /xrpc/com.example.block.put http/1.1\r\nHost: pds.example\r\nContent-Type: application/octet-stream\r\nContent-Length: 1\r\n\r\nx"

invalidHostRequest : Array Int
invalidHostRequest =
  toUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: bad host\r\nContent-Type: application/octet-stream\r\nContent-Length: 1\r\n\r\nx"

invalidTargetRequest : Array Int
invalidTargetRequest =
  toUtf8
    "GET /xrpc/com.example.query.fixed?value={bad} HTTP/1.1\r\nHost: pds.example\r\n\r\n"

rawTextRequest : Array Int
rawTextRequest =
  toUtf8
    "POST /xrpc/com.example.raw.echo HTTP/1.1\r\nHost: pds.example\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello"

rawJsonRequest : Array Int
rawJsonRequest =
  toUtf8
    "POST /xrpc/com.example.raw.echo HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/json\r\nContent-Length: 6\r\n\r\n{nope}"

rawOpaqueRequest : Array Int
rawOpaqueRequest = appendBytes (toUtf8
  "POST /xrpc/com.example.raw.echo HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/octet-stream\r\nContent-Length: 3\r\n\r\n") [|
  0, 128, 255
|]

procedureParamsRequest : Array Int
procedureParamsRequest =
  toUtf8
    "POST /xrpc/com.example.params.check?dryRun=true&dryRun=&flag HTTP/1.1\r\nHost: pds.example\r\n\r\n"

uppercaseAuthorityRequest : Array Int
uppercaseAuthorityRequest =
  toUtf8
    "GET /xrpc/com.example.query.caseFixed HTTP/1.1\r\nHost: pds.example\r\n\r\n"

emptyRegPortRequest : Array Int
emptyRegPortRequest =
  toUtf8
    "GET /xrpc/com.example.query.fixed HTTP/1.1\r\nHost: example.com:\r\n\r\n"

emptyIpPortRequest : Array Int
emptyIpPortRequest =
  toUtf8 "GET /xrpc/com.example.query.fixed HTTP/1.1\r\nHost: [::1]:\r\n\r\n"

unknownRequest : Array Int
unknownRequest =
  toUtf8
    "GET /xrpc/com.example.query.unknown HTTP/1.1\r\nHost: pds.example\r\n\r\n"

resourceRequest : Array Int
resourceRequest =
  toUtf8
    ("GET /"
      ++ repeat maxHttpRequestLineBytes "a"
      ++ " HTTP/1.1\r\nHost: pds.example\r\n\r\n")

checkFixedQuery : <IO> Unit
checkFixedQuery =
  let (next, response) = handleBytes server testContext seededStore fixedQuery
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "fixed" then
    println "CELL fixed-query PASS status=200 state=unchanged"
  else
    panic "protocol_all_engines: fixed-query mismatch"

checkChunkedUpdate : <IO> Unit
checkChunkedUpdate =
  let expectedBody = toUtf8 "abc"
  let (next, response) = handleBytes server testContext seededStore chunkedPut
  if storeSize next == 2
    && seedPreserved next
    && storeGet (cidForRaw expectedBody) next == Some expectedBody
    && response == expectedTextResponse 201 "Created" "stored" then
    println "CELL chunked-update PASS status=201 state=1->2 body=abc"
  else
    panic "protocol_all_engines: chunked-update state mismatch"

checkMalformed : <IO> Unit
checkMalformed =
  let (next, response) =
    handleBytes server testContext seededStore malformedRequest
  if storeSize next == 1
    && seedPreserved next
    && response
      == expectedError
        400
        "Bad Request"
        "InvalidRequest"
        "Malformed HTTP request" then
    println "CELL malformed-unchanged PASS status=400 state=unchanged"
  else
    panic "protocol_all_engines: malformed framing mismatch"

malformedIsUnchanged : Array Int -> Bool
malformedIsUnchanged request =
  let (next, response) = handleBytes server testContext seededStore request
  storeSize next == 1
    && seedPreserved next
    && response
      == expectedError
        400
        "Bad Request"
        "InvalidRequest"
        "Malformed HTTP request"

checkLowercaseVersion : <IO> Unit
checkLowercaseVersion =
  if malformedIsUnchanged lowercaseVersionRequest then
    println
      "CELL malformed-lowercase-version PASS status=400 state=unchanged no-dispatch"
  else
    panic "protocol_all_engines: lowercase HTTP version reached dispatch"

checkInvalidHost : <IO> Unit
checkInvalidHost =
  if malformedIsUnchanged invalidHostRequest then
    println "CELL malformed-host PASS status=400 state=unchanged no-dispatch"
  else
    panic "protocol_all_engines: invalid Host reached dispatch"

checkInvalidTarget : <IO> Unit
checkInvalidTarget =
  if malformedIsUnchanged invalidTargetRequest then
    println "CELL malformed-target PASS status=400 state=unchanged no-dispatch"
  else
    panic "protocol_all_engines: invalid request target reached dispatch"

checkRawText : <IO> Unit
checkRawText =
  let (next, response) =
    handleBytes server testContext seededStore rawTextRequest
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "raw-text" then
    println "CELL raw-text PASS media=text/plain bytes=exact state=unchanged"
  else
    panic "protocol_all_engines: raw-text mismatch"

checkRawJson : <IO> Unit
checkRawJson =
  let (next, response) =
    handleBytes server testContext seededStore rawJsonRequest
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "raw-json" then
    println
      "CELL raw-json PASS media=application/json bytes=exact state=unchanged"
  else
    panic "protocol_all_engines: raw-json mismatch"

checkRawOpaque : <IO> Unit
checkRawOpaque =
  let (next, response) =
    handleBytes server testContext seededStore rawOpaqueRequest
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "raw-opaque" then
    println
      "CELL raw-opaque PASS media=application/octet-stream bytes=exact state=unchanged"
  else
    panic "protocol_all_engines: raw-opaque mismatch"

checkProcedureParams : <IO> Unit
checkProcedureParams =
  let (next, response) =
    handleBytes server testContext seededStore procedureParamsRequest
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "params-ordered" then
    println
      "CELL procedure-params PASS repeated=true empty=true order=preserved state=unchanged"
  else
    panic "protocol_all_engines: procedure parameter mismatch"

checkUppercaseAuthority : <IO> Unit
checkUppercaseAuthority =
  let (next, response) =
    handleBytes server testContext seededStore uppercaseAuthorityRequest
  if storeSize next == 1
    && seedPreserved next
    && response == expectedTextResponse 200 "OK" "authority-case" then
    println
      "CELL uppercase-authority-lookup PASS returned=Com.Example.query.caseFixed state=unchanged"
  else
    panic "protocol_all_engines: uppercase-authority lookup mismatch"

checkAuthorityDuplicateIdentity : <IO> Unit
checkAuthorityDuplicateIdentity =
  let lower =
    mustEndpoint (queryEndpoint "com.example.identity.echo" PublicRoute)
  let upperAuthority =
    mustEndpoint (queryEndpoint "Com.Example.identity.echo" PublicRoute)
  let upperMethod =
    mustEndpoint (queryEndpoint "com.example.identity.Echo" PublicRoute)
  match (
    makeRegistry [lower, upperAuthority],
    makeRegistry [lower, upperMethod],
  )
    (Err _, Ok _) =>
      println
        "CELL authority-duplicate-identity PASS folded-authority=true method-case=distinct"
    _ => panic "protocol_all_engines: NSID duplicate identity mismatch"

checkEmptyRegPort : <IO> Unit
checkEmptyRegPort =
  let (next, response) =
    handleBytes server testContext seededStore emptyRegPortRequest
  if response == expectedTextResponse 200 "OK" "fixed"
    && storeSize next == 1
    && seedPreserved next then
    println "CELL host-empty-reg-port PASS status=200 state=unchanged"
  else
    panic "protocol_all_engines: empty reg-name port mismatch"

checkEmptyIpPort : <IO> Unit
checkEmptyIpPort =
  let (next, response) =
    handleBytes server testContext seededStore emptyIpPortRequest
  if seedPreserved next
    && response == expectedTextResponse 200 "OK" "fixed"
    && storeSize next == 1 then
    println "CELL host-empty-ip-port PASS status=200 state=unchanged"
  else
    panic "protocol_all_engines: empty IP-literal port mismatch"

checkUnknown : <IO> Unit
checkUnknown =
  let (next, response) =
    handleBytes server testContext seededStore unknownRequest
  if storeSize next == 1
    && seedPreserved next
    && response
      == expectedError
        404
        "Not Found"
        "NotFound"
        "Unknown XRPC method: com.example.query.unknown" then
    println "CELL unknown-unchanged PASS status=404 state=unchanged"
  else
    panic "protocol_all_engines: unknown route mismatch"

checkResource : <IO> Unit
checkResource =
  let (next, response) =
    handleBytes server testContext seededStore resourceRequest
  if storeSize next == 1
    && seedPreserved next
    && response
      == expectedError
        413
        "Payload Too Large"
        "PayloadTooLarge"
        "HTTP request exceeds resource limits" then
    println "CELL resource-unchanged PASS status=413 state=unchanged"
  else
    panic "protocol_all_engines: resource classification mismatch"

-- # HTTP client codec (`lib.httpclient`) — response side

clientFixedResponse : Array Int
clientFixedResponse =
  toUtf8
    "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\ncontent-length: 5\r\n\r\nhello"

checkClientFixedLength : <IO> Unit
checkClientFixedLength = match HC.parseResponse clientFixedResponse
  Err message =>
    panic "protocol_all_engines: client fixed-length parse failed: \{message}"
  Ok response =>
    if HC.responseStatus response == 200
      && HC.responseReason response == "OK"
      && HC.responseBody response == toUtf8 "hello"
      && HC.findHeader "content-type" (HC.responseHeaders response)
        == Some (toUtf8 "text/plain") then
      println "CELL client-fixed-length PASS status=200 body=hello"
    else
      panic "protocol_all_engines: client fixed-length mismatch"

-- Two chunks, the first carrying a chunk-extension per RFC 9112 SS7.1.1, plus
-- a trailer field the terminating chunk introduces.
clientChunkedResponse : Array Int
clientChunkedResponse =
  toUtf8
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3;ext=1\r\nfoo\r\n3\r\nbar\r\n0\r\nx-trailer: done\r\n\r\n"

checkClientChunked : <IO> Unit
checkClientChunked = match HC.parseResponse clientChunkedResponse
  Err message =>
    panic "protocol_all_engines: client chunked parse failed: \{message}"
  Ok response =>
    if HC.responseStatus response == 200
      && HC.responseBody response == toUtf8 "foobar"
      && HC.findHeader "x-trailer" (HC.responseTrailers response)
        == Some (toUtf8 "done") then
      println "CELL client-chunked PASS chunks=2 body=foobar trailer=done"
    else
      panic "protocol_all_engines: client chunked mismatch"

expectResourceExcess : String -> Array Int -> String -> <IO> Unit
expectResourceExcess label bytes cellLine =
  match HC.parseResponseClassified bytes
    Ok _ => panic "protocol_all_engines: \{label} unexpectedly parsed"
    Err (HttpClientMalformed message) =>
      panic
        "protocol_all_engines: \{label} reported malformed, not resource-excess: \{message}"
    Err (HttpClientResourceExcess _) => println cellLine

clientStatusLineOverLimit : Array Int
clientStatusLineOverLimit =
  toUtf8
    ("HTTP/1.1 200 "
      ++ repeat (maxHttpClientStatusLineBytes + 1) "a"
      ++ "\r\n\r\n")

checkClientStatusLineLimit : <IO> Unit
checkClientStatusLineLimit =
  expectResourceExcess
    "client status-line ceiling"
    clientStatusLineOverLimit
    "CELL client-status-line-limit PASS refused"

-- Ten headers of 7000 bytes each (70000 total) rather than one single
-- 65537-byte value: the eval engine's tree-walking interpreter has no
-- tail-call optimisation (`E-STACK-OVERFLOW` past ~25000 call depth), and a
-- single CRLF-less scan that long would recurse once per byte. Ten short
-- scans keep every recursion shallow while the CUMULATIVE ceiling this cell
-- exercises still trips well before the unrelated 100-field ceiling would.
clientHeaderBytesOverLimit : Array Int
clientHeaderBytesOverLimit =
  let perHeaderBytes = 7000
  let headerCount = maxHttpClientHeaderBytes / perHeaderBytes + 2
  toUtf8
    ("HTTP/1.1 200 OK\r\n"
      ++ repeat headerCount ("x-big: " ++ repeat perHeaderBytes "a" ++ "\r\n")
      ++ "content-length: 0\r\n\r\n")

checkClientHeaderBytesLimit : <IO> Unit
checkClientHeaderBytesLimit =
  expectResourceExcess
    "client header-bytes ceiling"
    clientHeaderBytesOverLimit
    "CELL client-header-bytes-limit PASS refused"

clientHeaderFieldsOverLimit : Array Int
clientHeaderFieldsOverLimit =
  toUtf8
    ("HTTP/1.1 200 OK\r\n"
      ++ repeat (maxHttpClientHeaderFields + 1) "x-h: 1\r\n"
      ++ "content-length: 0\r\n\r\n")

checkClientHeaderFieldsLimit : <IO> Unit
checkClientHeaderFieldsLimit =
  expectResourceExcess
    "client header-fields ceiling"
    clientHeaderFieldsOverLimit
    "CELL client-header-fields-limit PASS refused"

-- One chunk-size line declaring more than `maxHttpClientChunkBytes`; the
-- ceiling is enforced on the declared size alone, so no matching chunk data
-- needs to follow.
clientChunkSizeOverLimit : Array Int
clientChunkSizeOverLimit =
  toUtf8 "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n200000\r\n"

checkClientChunkSizeLimit : <IO> Unit
checkClientChunkSizeLimit =
  expectResourceExcess
    "client chunk-size ceiling"
    clientChunkSizeOverLimit
    "CELL client-chunk-size-limit PASS refused"

-- `maxHttpClientChunks` itself is exercised directly against
-- `checkHttpClientChunks` (`pds/lib/resource_limits.mdk`'s doctest), not
-- here: exceeding it for real needs 65537 chunk-head parses, and the eval
-- engine's tree-walking interpreter has no tail-call optimisation
-- (`E-STACK-OVERFLOW` past ~25000 call depth) — the same constraint
-- `clientHeaderBytesOverLimit` above works around by staying shallow, which
-- is not available here since the recursion this ceiling bounds is one call
-- per CHUNK, not per byte.

-- A declared Content-Length alone is enough to trip this ceiling; no body
-- bytes need to be supplied since the check runs before the body is read.
clientBodyBytesOverLimit : Array Int
clientBodyBytesOverLimit =
  toUtf8
    "HTTP/1.1 200 OK\r\ncontent-length: \{intToString (maxHttpClientBodyBytes + 1)}\r\n\r\n"

checkClientBodyBytesLimit : <IO> Unit
checkClientBodyBytesLimit =
  expectResourceExcess
    "client body-bytes ceiling"
    clientBodyBytesOverLimit
    "CELL client-body-bytes-limit PASS refused"

clientMalformedStatusLine : Array Int
clientMalformedStatusLine = toUtf8 "HTTP/1.1 20 OK\r\n\r\n"

checkClientMalformedStatusLine : <IO> Unit
checkClientMalformedStatusLine =
  match HC.parseResponseClassified clientMalformedStatusLine
    Ok _ =>
      panic
        "protocol_all_engines: malformed client status line unexpectedly parsed"
    Err (HttpClientResourceExcess message) =>
      panic
        "protocol_all_engines: malformed client status line reported resource-excess, not malformed: \{message}"
    Err (HttpClientMalformed _) =>
      println "CELL client-malformed-status-line PASS refused"

clientMalformedHeader : Array Int
clientMalformedHeader =
  toUtf8 "HTTP/1.1 200 OK\r\nbadheader\r\ncontent-length: 0\r\n\r\n"

checkClientMalformedHeader : <IO> Unit
checkClientMalformedHeader =
  match HC.parseResponseClassified clientMalformedHeader
    Ok _ =>
      panic "protocol_all_engines: malformed client header unexpectedly parsed"
    Err (HttpClientResourceExcess message) =>
      panic
        "protocol_all_engines: malformed client header reported resource-excess, not malformed: \{message}"
    Err (HttpClientMalformed _) =>
      println "CELL client-malformed-header PASS refused"

main : <IO> Unit
main =
  let () = checkFixedQuery
  let () = checkChunkedUpdate
  let () = checkMalformed
  let () = checkLowercaseVersion
  let () = checkInvalidHost
  let () = checkInvalidTarget
  let () = checkRawText
  let () = checkRawJson
  let () = checkRawOpaque
  let () = checkProcedureParams
  let () = checkUppercaseAuthority
  let () = checkAuthorityDuplicateIdentity
  let () = checkEmptyRegPort
  let () = checkEmptyIpPort
  let () = checkUnknown
  let () = checkResource
  let () = checkClientFixedLength
  let () = checkClientChunked
  let () = checkClientStatusLineLimit
  let () = checkClientHeaderBytesLimit
  let () = checkClientHeaderFieldsLimit
  let () = checkClientChunkSizeLimit
  let () = checkClientBodyBytesLimit
  let () = checkClientMalformedStatusLine
  let () = checkClientMalformedHeader
  println "TOTAL: PASS"
