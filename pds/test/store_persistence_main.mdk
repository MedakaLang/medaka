{- | P7 durable-store driver: two separate process invocations over one data
   directory.

   `save` builds a repository, writes records, and persists it. `load` rehydrates
   from the persisted head plus blocks and prints the same summary. The gate runs
   them as distinct processes and compares the summaries byte for byte, so a
   repository that survived only inside one process cannot pass.

   `reject` is the tamper route: it asserts the reload REJECTS a corrupted block
   file rather than serving its bytes.

   The `blob-*` routes are the same three claims for the blob half
   (`shell.blobfile`), which is persisted beside the repository and not inside
   it: save in one process, load in another, and reject a tampered blob file.
   `blob-oversize` is the fourth: a blob the pure layer refuses reaches no
   file at all.

   The `prefs-*` routes are the same save/load claim for the preferences half
   (`shell.persist`'s `persistPreferences`/`persistLoadPreferences`), written
   into the same data directory as the repository and blob halves so the
   signing-key sweep in `store_persistence.sh` covers it too. `credential-save`
   is the write half of the same claim for the account's password credential
   (`shell.persist`'s `persistCredential`); there is no `credential-load` route
   because reading it back is `pds/shell/server.mdk`'s job, not this shell's —
   this route exists only so case 12's syscall trace sees the credential
   file's promote.

   The remaining routes are for HALF-WRITTEN directories. None of them races a
   process kill: each write path here promotes with `rename`, so the states a
   crash can leave are a finite set that can be built directly and graded
   deterministically. `crash-save-old` persists an earlier generation the gate
   rewinds the head file to; `blob-survey` reports what the blob reader makes
   of a blob whose two files did not both land;    `event-recover-*` stages an
   entry against a persisted head and recovers over it, the way `configure`
   does: plan, then apply.

   `transition` is the one route that drives BOTH halves in a single process,
   which is what makes their relative order observable at all.

   `genesis-init` and `genesis-resume` are that same pair for the four events a
   repository's creation emits: the first creates the repository and emits
   them, the second is every later start over that data directory. The gate
   runs the second over a log it truncated to none, one, two or three of the
   four, and requires the result to be the log an uninterrupted creation
   leaves.

   `sweep-staging` and `stray-entries` are about entries NOBODY wrote rather
   than half-written ones: the first that startup clears crash residue out of
   the three `.staging` directories, the second that every other directory the
   three stores list has a stated disposition for an entry no write path here
   can produce. -}

import fs.{mkdirAll}
import hex.{decode, encode}
import json.{Json(..), jObject}
import string.{repeat, take, toUtf8}
import lib.blob.{admitBlob, blobCid}
import lib.blockstore.{blockStoreFromBlocks}
import lib.car.{carDecode}
import lib.cid.{Cid, cidDigest, cidEqual, cidToBytes, cidToString}
import lib.credential.{CredentialRecord, makeCredential}
import lib.dagcbor.{DagCbor(..)}
import lib.event_log_record.{
  EventLogEntry(..),
  eventLogEntryName,
  eventLogRetentionSeconds,
}
import lib.repo.{
  Repo,
  repoCommitCid,
  repoCreate,
  repoExportBlocks,
  repoExportCar,
  repoFromBlocks,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoList,
  repoMutationState,
  repoRootCid,
}
import sha256.{sha256}
import lib.resource_limits.{maxBlobBytes}
import lib.sign.{SecretKey, secretKeyFromBytes}
import lib.store.{Store, storeFromRepo, storePutBlob, storeWithRepo}
import lib.tid.{Tid, tidParse}
import shell.blobfile.{
  blobDir,
  blobFileCount,
  blobFileRead,
  blobFileSweepStaging,
  blobFileWrite,
}
import shell.blockfile.{blockFileRead}
import shell.eventlog.{
  eventLogApplyRecovery,
  eventLogPlanRecovery,
  eventLogRead,
  eventLogStage,
  eventLogStaged,
  eventLogSweepStaging,
}
import shell.persist.{
  persistCredential,
  persistLoad,
  persistLoadPreferences,
  persistLoadSessions,
  persistPreferences,
  persistSessions,
  persistSave,
  persistSweepStagedBlocks,
}
import shell.server.{completeGenesisEvents, persistTransition}

-- The gate greps every persisted file for this hex and for its raw bytes; it is
-- the signing key the adapter must never be able to write.
secretHex : String
secretHex = "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"

accountDid : String
accountDid = "did:plc:persistencefixture000000"

mustHex : String -> Array Int
mustHex text = resultOrPanic "store_persistence: malformed hex" (decode text)

mustSecret : SecretKey
mustSecret =
  resultOrPanic
    "store_persistence: malformed secret"
    (secretKeyFromBytes (mustHex secretHex))

mustTid : String -> Tid
mustTid text = resultOrPanic "store_persistence: malformed TID" (tidParse text)

mustRepo : Result String Repo -> Repo
mustRepo (Ok repo) = repo
mustRepo (Err message) =
  panic "store_persistence: repository failed: \{message}"

post : String -> DagCbor
post text = DcMap [
  ("$type", DcString "app.bsky.feed.post"),
  ("text", DcString text),
  ("createdAt", DcString "2026-09-02T00:00:00.000Z"),
]

write : String -> String -> String -> Repo -> Repo
write path text rev repo =
  mustRepo
    (map
      repoMutationState
      (repoCreate (toUtf8 path) (post text) (mustTid rev) repo))

{- | The generation before the one `save` persists: two records at fixed
   revisions. It exists so the crash routes have a real EARLIER head to rewind
   to — a head file naming this repository, over a blocks directory that also
   holds `fixtureRepo`'s, is exactly what a crash between the last block write
   and the head `rename` leaves behind. -}
olderRepo : Repo
olderRepo =
  let base =
    mustRepo
      (repoInitFromKeyBytes
        accountDid
        (mustHex secretHex)
        (mustTid "3lba2s5ykxs2a"))
  let one =
    write "app.bsky.feed.post/3lba2s5ykxs2b" "first" "3lba2s5ykxs2b" base
  write "app.bsky.feed.post/3lba2s5ykxs2c" "second" "3lba2s5ykxs2c" one

-- | The repository the `save` route persists: three records at fixed revisions,
-- so every byte of the result is deterministic.
fixtureRepo : Repo
fixtureRepo =
  write "app.bsky.actor.profile/self" "third" "3lba2s5ykxs2d" olderRepo

mustCar : Repo -> Array Int
mustCar repo =
  resultOrPanic "store_persistence: CAR export failed" (repoExportCar repo)

{- | The whole observable identity of a repository: head commit CID, record
   count, and the exact `sync.getRepo` CAR bytes (length plus their digest, so a
   single flipped byte anywhere in the export changes the summary). -}
summary : String -> Repo -> <IO> Unit
summary label repo =
  let car = mustCar repo
  let records = match repoList repo
    Ok rows => length rows
    Err message => panic "store_persistence: listing failed: \{message}"
  let roots = match carDecode car
    Ok _ => "decodes"
    Err message =>
      panic "store_persistence: exported CAR does not decode: \{message}"
  let () =
    println
      "\{label} head \{cidToString (repoCommitCid (repoLatestCommit repo))}"
  let () = println "\{label} records \{intToString records}"
  let () =
    println
      "\{label} car \{intToString (arrayLength car)} \{encode (sha256 car)} \{roots}"
  ()

blocksOf : Repo -> List (Cid, Array Int)
blocksOf repo =
  resultOrPanic "store_persistence: block export failed" (repoExportBlocks repo)

runSave : String -> <IO, FileRead "_", FileWrite "_"> Unit
runSave dir =
  let repo = fixtureRepo
  match persistSave dir (repoCommitCid (repoLatestCommit repo)) (blocksOf repo)
    Err message => panic "store_persistence: save failed: \{message}"
    Ok () =>
      let () = summary "SAVE" repo
      println "SAVE: PASS"

{- | Persist the EARLIER generation, so a later `save` into the same directory
   leaves both generations' blocks on disk and only the head distinguishes
   them. The summary is the one a rewound head must reproduce exactly. -}
runCrashSaveOld : String -> <IO, FileRead "_", FileWrite "_"> Unit
runCrashSaveOld dir =
  let repo = olderRepo
  match persistSave dir (repoCommitCid (repoLatestCommit repo)) (blocksOf repo)
    Err message =>
      panic "store_persistence: old-generation save failed: \{message}"
    Ok () =>
      let () = summary "OLD" repo
      println "CRASH-SAVE-OLD: PASS"

reload : String -> <FileRead "_"> Result String Repo
reload dir = do
  (head, blocks) <- persistLoad dir
  repoFromBlocks accountDid mustSecret head blocks

runLoad : String -> <IO, FileRead "_"> Unit
runLoad dir = match reload dir
  Err message => panic "store_persistence: load failed: \{message}"
  Ok repo =>
    let () = summary "LOAD" repo
    println "LOAD: PASS"

-- | A tampered block file must be rejected, never served.
runReject : String -> <IO, FileRead "_"> Unit
runReject dir = match reload dir
  Ok _ =>
    let () = println "REJECT: FAIL tampered store reloaded"
    exit 1
  Err message =>
    let () = println "REJECT: PASS \{message}"
    ()

-- ── the blob half ───────────────────────────────────────────────────────────

blobBytes : String -> Array Int
blobBytes text = toUtf8 text

{- | The blobs the `blob-save` route persists: two, with DIFFERENT declared
   MIME types, because the type is the part content addressing does not carry
   and is therefore the part a restart can lose silently. -}
blobFixtures : List (Cid, String, Array Int)
blobFixtures =
  let first = blobBytes "store_persistence blob fixture one"
  let second = blobBytes "store_persistence blob fixture two, a different type"
  [
    (blobCid first, "text/plain", first),
    (blobCid second, "application/octet-stream", second),
  ]

blobSummary : String -> (Cid, String, Array Int) -> <IO> Unit
blobSummary label (cid, mimeType, bytes) =
  println
    "\{label} blob \{cidToString cid} \{mimeType} \{intToString (arrayLength bytes)} \{encode (sha256 bytes)}"

findBlob : Cid ->
  List (Cid, String, Array Int) ->
  Option (Cid, String, Array Int)
findBlob _ [] = None
findBlob wanted ((cid, mimeType, bytes) :: rest) =
  if cidEqual wanted cid then
    Some (cid, mimeType, bytes)
  else
    findBlob wanted rest

printBlobs : String -> List (Cid, String, Array Int) -> <IO> Unit
printBlobs _ [] = ()
printBlobs label (row :: rest) =
  let () = blobSummary label row
  printBlobs label rest

runBlobSave : String -> <IO, FileRead "_", FileWrite "_"> Unit
runBlobSave dir = match blobFileWrite dir blobFixtures
  Err message => panic "store_persistence: blob save failed: \{message}"
  Ok () =>
    let () = printBlobs "BLOBSAVE" blobFixtures
    let () = println "BLOBSAVE count \{intToString (length blobFixtures)}"
    println "BLOB-SAVE: PASS"

-- The rows are unverified disk bytes until this runs, exactly as the
-- repository's are until `repoFromBlocks` runs.
verifiedBlobs : String ->
  <FileRead "_"> Result String (List (Cid, String, Array Int))
verifiedBlobs dir = do
  rows <- blobFileRead dir
  _ <- blockStoreFromBlocks (map ((cid, _, bytes) => (cid, bytes)) rows)
  Ok rows

-- Each fixture is reported in FIXTURE order, not disk order (`blobFileRead`
-- promises none), so the gate can compare the two summaries line for line.
reportBlobs : List (Cid, String, Array Int) ->
  List (Cid, String, Array Int) ->
  <IO> Unit
reportBlobs _ [] = ()
reportBlobs loaded ((cid, _, _) :: rest) = match findBlob cid loaded
  None =>
    panic
      "store_persistence: blob \{cidToString cid} did not survive the restart"
  Some row =>
    let () = blobSummary "BLOBLOAD" row
    reportBlobs loaded rest

runBlobLoad : String -> <IO, FileRead "_"> Unit
runBlobLoad dir = match verifiedBlobs dir
  Err message => panic "store_persistence: blob load failed: \{message}"
  Ok loaded =>
    let () = reportBlobs loaded blobFixtures
    let () = println "BLOBLOAD count \{intToString (length loaded)}"
    println "BLOB-LOAD: PASS"

{- | Report what the blob reader actually makes of `<dir>/blobs`, whatever that
   is — the count and each surviving row, or the error.

   Unlike `blob-load` this asserts nothing about which blobs are there, because
   the states it is pointed at are half-written ones: a sidecar promoted with
   its bytes still missing, or bytes promoted with the sidecar still missing.
   What the reader does with each is the measurement, so the route records it
   rather than demanding it. -}
runBlobSurvey : String -> <IO, FileRead "_"> Unit
runBlobSurvey dir = match verifiedBlobs dir
  Err message => println "BLOB-SURVEY: ERR \{message}"
  Ok rows =>
    let () = printBlobs "BLOBSURVEY" rows
    println "BLOB-SURVEY: OK \{intToString (length rows)}"

runBlobReject : String -> <IO, FileRead "_"> Unit
runBlobReject dir = match verifiedBlobs dir
  Ok _ =>
    let () = println "BLOB-REJECT: FAIL tampered blob loaded"
    exit 1
  Err message =>
    let () = println "BLOB-REJECT: PASS \{message}"
    ()

{- | A blob past the per-blob cap is refused by `pds/lib/blob.mdk`'s
   `admitBlob` — the ONE admission point — and therefore never reaches
   `blobFileWrite` at all. The directory is read back afterwards to show that
   nothing was written, which is the claim: refused BEFORE any bytes land. -}
runBlobOversize : String -> <IO, FileRead "_", FileWrite "_"> Unit
runBlobOversize dir =
  let oversize = arrayMakeWith (maxBlobBytes + 1) (_ => 65)
  match admitBlob 0 "application/octet-stream" oversize
    Ok _ =>
      let () = println "BLOB-OVERSIZE: FAIL an oversize blob was admitted"
      exit 1
    Err message =>
      let () = println "BLOB-OVERSIZE refused \{message}"
      match blobFileRead dir
        Err readMessage =>
          panic "store_persistence: blob directory unreadable: \{readMessage}"
        Ok rows =>
          if length rows == 0 then
            println "BLOB-OVERSIZE: PASS nothing was written"
          else
            let () =
              println
                "BLOB-OVERSIZE: FAIL \{intToString (length rows)} blob(s) on disk"
            exit 1

-- ── the preferences half ────────────────────────────────────────────────────

-- | Two items in the `app.bsky` namespace, fixed so the reload comparison is
-- exact rather than approximate.
fixturePrefs : List Json
fixturePrefs = [
  jObject [
    ("$type", JString "app.bsky.actor.defs#personalDetailsPref"),
    ("birthDate", JString "2000-01-01"),
  ],
  jObject [
    ("$type", JString "app.bsky.actor.defs#contentLabelPref"),
    ("label", JString "spam"),
  ],
]

runPrefsSave : String -> <IO, FileRead "_", FileWrite "_"> Unit
runPrefsSave dir = match persistPreferences dir fixturePrefs
  Err message => panic "store_persistence: preferences save failed: \{message}"
  Ok () => println "PREFS SAVE: PASS"

-- ── the credential half ─────────────────────────────────────────────────────

-- A fixed record, persisted into the same data directory as the repository
-- and preferences halves so case 12's syscall trace covers it too.
fixtureCredentialSalt : Array Int
fixtureCredentialSalt = mustHex "000102030405060708090a0b0c0d0e0f"

fixtureCredential : CredentialRecord
fixtureCredential =
  match (makeCredential
    fixtureCredentialSalt
    100000
    "correct horse battery staple")
    Err message =>
      panic "store_persistence: malformed credential fixture: \{message}"
    Ok record => record

runCredentialSave : String -> <IO, FileWrite "_"> Unit
runCredentialSave dir = match persistCredential dir fixtureCredential
  Err message => panic "store_persistence: credential save failed: \{message}"
  Ok () => println "CREDENTIAL SAVE: PASS"

runPrefsLoad : String -> <IO, FileRead "_"> Unit
runPrefsLoad dir = match persistLoadPreferences dir
  Err message => panic "store_persistence: preferences load failed: \{message}"
  Ok prefs =>
    if prefs == fixturePrefs then
      println "PREFS LOAD: PASS"
    else
      let () = println "PREFS LOAD: FAIL mismatch"
      exit 1

-- ── the session half ─────────────────────────────────────────

{- | Two open sessions, persisted into the same data directory as every other
   half so the signing-key sweep in `store_persistence.sh` covers this file
   too. The fingerprints are fixed rather than derived from tokens: these
   routes grade the file's round trip, not `lib.store`'s `sessionFingerprint`,
   and a row is a pair of digests plus an expiry whatever produced it. -}
fixtureSessions : List (Array Int, Array Int, Int)
fixtureSessions = [
  (
    mustHex "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    mustHex "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100",
    2000000000,
  ),
  (
    mustHex "0f0e0d0c0b0a090807060504030201000f0e0d0c0b0a09080706050403020100",
    mustHex "1f1e1d1c1b1a191817161514131211101f1e1d1c1b1a19181716151413121110",
    2100000000,
  ),
]

runSessionsSave : String -> <IO, FileRead "_", FileWrite "_"> Unit
runSessionsSave dir = match persistSessions dir fixtureSessions
  Err message => panic "store_persistence: sessions save failed: \{message}"
  Ok () => println "SESSIONS SAVE: PASS"

runSessionsLoad : String -> <IO, FileRead "_"> Unit
runSessionsLoad dir = match persistLoadSessions dir
  Err message => panic "store_persistence: sessions load failed: \{message}"
  Ok rows =>
    if rows == fixtureSessions then
      println "SESSIONS LOAD: PASS"
    else
      let () = println "SESSIONS LOAD: FAIL mismatch"
      exit 1

-- ── the event-log half ──────────────────────────────────────────────────────

-- Fixed, so the entry's file name and the retention decision taken over it are
-- both deterministic; passed as `nowSeconds` too, which puts the entry at the
-- near end of the window and keeps the sweep out of the measurement.
eventFixtureTime : Int
eventFixtureTime = 1756771200

eventFixture : Option String -> String -> EventLogEntry
eventFixture anchor frameHex = EventLogEntry {
  seq = 1,
  timeSeconds = eventFixtureTime,
  anchorCommitCid = anchor,
  frameHex = frameHex,
}

-- An entry's anchor as the gate greps for it. An entry that anchors to
-- nothing prints `unanchored` rather than an empty word, so a survey line the
-- gate matches cannot lose a field.
anchorLabel : Option String -> String
anchorLabel None = "unanchored"
anchorLabel (Some cid) = cid

-- What the log holds right now: the pending entry, if any, and how many
-- entries have been promoted.
eventSurvey : String -> String -> <IO, FileRead "_"> Unit
eventSurvey label dir =
  let staged = match eventLogStaged dir
    Err message => "staged-unreadable(\{message})"
    Ok None => "staged none"
    Ok (Some entry) => "staged \{anchorLabel entry.anchorCommitCid}"
  let promoted = match eventLogRead dir 0
    Err message => "entries-unreadable(\{message})"
    Ok entries => "entries \{intToString (length entries)}"
  println "\{label} \{staged} \{promoted}"

{- | Persist a repository, leave a staged entry behind it as a crash between
   the stage and the promote would, and recover against the head that is
   actually on disk — planning and applying as `configure` does, so what this
   grades is the sequence the server runs and not a shorter one.

   `anchorFor` picks which crash point is staged, over the head `persistLoad`
   actually answers:

   - `Some head` — crashed AFTER the commit: the entry is owed and must be
     finished.
   - the MST root, a real CID this repository has but never a commit CID —
     crashed BEFORE the commit: owed to nobody, and must be dropped.
   - `None` — an entry announcing no repository mutation at all, which no head
     can contradict and which must be finished whatever is on disk. Its
     payload is a stand-in for a non-commit frame; the log never decodes
     one. -}
runEventRecover : String ->
  (Repo -> String -> Option String) ->
  <IO, FileRead "_", FileWrite "_"> Unit
runEventRecover dir anchorFor =
  let repo = fixtureRepo
  let () =
    match (persistSave
      dir
      (repoCommitCid (repoLatestCommit repo))
      (blocksOf repo))
      Err message =>
        panic "store_persistence: event-log save failed: \{message}"
      Ok () => ()
  let onDisk = match persistLoad dir
    Err message =>
      panic "store_persistence: event-log head unreadable: \{message}"
    Ok (head, _) => cidToString head
  let anchor = anchorFor repo onDisk
  match eventLogStage dir (eventFixture anchor (frameFor anchor))
    Err message => panic "store_persistence: event stage failed: \{message}"
    Ok () =>
      let () = eventSurvey "EVENTBEFORE" dir
      match eventLogPlanRecovery dir (Some onDisk)
        Err message => println "EVENT-RECOVER: ERR \{message}"
        Ok plan =>
          let () = eventSurvey "EVENTPLANNED" dir
          match (eventLogApplyRecovery
            dir
            plan
            eventLogRetentionSeconds
            eventFixtureTime)
            Err message => println "EVENT-RECOVER: ERR \{message}"
            Ok () =>
              let () = eventSurvey "EVENTAFTER" dir
              println "EVENT-RECOVER: OK"

-- A commit event and a non-commit one are two different payloads to the gate
-- and the same opaque hex to the log, which is the point: only the anchor
-- decides.
frameFor : Option String -> String
frameFor None = "a2626f7001617469236964656e74697479"
frameFor (Some _) = "a1"

-- ── both halves of one transition, in one process ───────────────────────────

putBlobs : List (Cid, String, Array Int) -> Store -> Store
putBlobs [] store = store
putBlobs ((cid, mimeType, bytes) :: rest) store =
  match storePutBlob cid mimeType bytes store
    Err message => panic "store_persistence: blob fixture rejected: \{message}"
    Ok next => putBlobs rest next

{- | One `persistTransition` over a data directory that already holds the
   earlier generation: the blob half gains both fixture blobs and the repo half
   advances `olderRepo` to `fixtureRepo`, so both halves move and one process
   performs the whole sequence.

   Every other route here drives a single half, and a trace of one says nothing
   about which half reached the disk first. That ORDER is the claim (#3057): a
   commit may name blob bytes and never the reverse, so a crash between the
   halves must be able to leave an unreferenced blob and never a committed
   record naming bytes that are not there. This route exists so
   `store_persistence.sh` can read the order out of one trace rather than infer
   it from five.

   The gate persists the earlier generation through `crash-save-old` BEFORE it
   starts tracing, so what the trace holds is this transition alone. -}
runTransition : String -> <IO, FileRead "_", FileWrite "_"> Unit
runTransition dir =
  let before = storeFromRepo olderRepo
  let after = putBlobs blobFixtures (storeWithRepo fixtureRepo before)
  match persistTransition dir accountDid eventFixtureTime before after
    Err message => panic "store_persistence: transition failed: \{message}"
    Ok () => println "TRANSITION: PASS"

-- ── one upload's share of the blob area (#2692) ─────────────────────────────

{- | How many blobs the churn routes put in the account. The seed route
   persists the first `churnCount - 1` one upload at a time, and the add
   route persists the last one alone, so the gate can stat the blob area in
   between and see what that ONE upload cost. -}
churnCount : Int
churnCount = 100

-- A blob big enough that rewriting the account would dwarf rewriting one
-- blob, and distinct per index so that every row is a distinct CID.
churnBytes : Int -> Array Int
churnBytes index =
  toUtf8 "\{repeat 35 "store-persistence-churn-blob-"}\{intToString index}"

churnRow : Int -> (Cid, String, Array Int)
churnRow index =
  let bytes = churnBytes index
  (blobCid bytes, "application/octet-stream", bytes)

churnRows : Int -> Int -> List (Cid, String, Array Int)
churnRows index limit =
  if index > limit then [] else churnRow index :: churnRows (index + 1) limit

-- Uploads persisted the way a server persists them: one transition per
-- upload, each publishing the store the previous one left.
churnSeed : String ->
  Int ->
  Int ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Store
churnSeed dir index limit store =
  if index > limit then
    Ok store
  else
    let next = putBlobs [churnRow index] store
    match persistTransition dir accountDid eventFixtureTime store next
      Err message => Err message
      Ok () => churnSeed dir (index + 1) limit next

runBlobChurnSeed : String -> <IO, FileRead "_", FileWrite "_"> Unit
runBlobChurnSeed dir =
  match churnSeed dir 1 (churnCount - 1) (storeFromRepo olderRepo)
    Err message => panic "store_persistence: churn seed failed: \{message}"
    Ok _ =>
      let () = println "BLOB-CHURN-SEED count \{intToString (churnCount - 1)}"
      println "BLOB-CHURN-SEED: PASS"

reportChurnAdd : (Cid, String, Array Int) -> <IO> Unit
reportChurnAdd (cid, mimeType, bytes) =
  let () = println "BLOB-CHURN-ADD cid \{cidToString cid}"
  let () = println "BLOB-CHURN-ADD size \{intToString (arrayLength bytes)}"
  let () = println "BLOB-CHURN-ADD mime \{mimeType}"
  println "BLOB-CHURN-ADD: PASS"

{- | The last upload alone, against the store the seed route left on disk.

   The earlier uploads are replayed into memory rather than read back, so the
   `before` this transition is graded against is the very store the seed route
   published — a store rebuilt by reading the blob area would hold the same
   blobs, but reading it would also be the whole-account walk this route is
   here to show is gone. -}
runBlobChurnAdd : String -> <IO, FileRead "_", FileWrite "_"> Unit
runBlobChurnAdd dir =
  let before = putBlobs (churnRows 1 (churnCount - 1)) (storeFromRepo olderRepo)
  let row = churnRow churnCount
  let after = putBlobs [row] before
  match persistTransition dir accountDid eventFixtureTime before after
    Err message => panic "store_persistence: churn add failed: \{message}"
    Ok () => reportChurnAdd row

-- ── the crash-residue sweeps (#2572 part 2, #3052) ──────────────────────────

presentLabel : Bool -> String
presentLabel True = "present"
presentLabel False = "absent"

-- What the three sweeps left `dir` holding: whether each planted residue file
-- is still there (it must not be), whether each planted stray SUBDIRECTORY
-- and its own inner file are still there (they must be — a sweep tolerates,
-- never recurses into, an entry it did not write), and the state of the
-- legitimate content the residue sat beside (it must be untouched) — the
-- same repository, blob and event summaries the other routes already print,
-- so the gate can compare them against what `save`/`blob-save`/an applied
-- recovery produced.
reportSweep : String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  <IO, FileRead "_"> Unit
reportSweep dir blockResidue blobResidue eventResidue strayBlockFile strayBlobFile strayEventFile =
  let () =
    println "SWEEP residue-block \{presentLabel (fileExists blockResidue)}"
  let () = println "SWEEP residue-blob \{presentLabel (fileExists blobResidue)}"
  let () =
    println "SWEEP residue-event \{presentLabel (fileExists eventResidue)}"
  let () =
    println "SWEEP stray-block \{presentLabel (fileExists strayBlockFile)}"
  let () = println "SWEEP stray-blob \{presentLabel (fileExists strayBlobFile)}"
  let () =
    println "SWEEP stray-event \{presentLabel (fileExists strayEventFile)}"
  match reload dir
    Err message =>
      panic "store_persistence: sweep-staging reload failed: \{message}"
    Ok repo =>
      let () = summary "SWEEP" repo
      match verifiedBlobs dir
        Err message =>
          panic
            "store_persistence: sweep-staging blob reload failed: \{message}"
        Ok rows =>
          let () = println "SWEEP blobs \{intToString (length rows)}"
          match eventLogRead dir 0
            Err message =>
              panic
                "store_persistence: sweep-staging event reload failed: \{message}"
            Ok entries =>
              let () = println "SWEEP entries \{intToString (length entries)}"
              println "SWEEP-STAGING: PASS"

-- Run the same three sweeps `pds/serve.mdk`'s `configure` runs at startup,
-- then report what is left.
sweepAndReport : String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  <IO, FileRead "_", FileWrite "_"> Unit
sweepAndReport dir blockResidue blobResidue eventResidue strayBlockFile strayBlobFile strayEventFile =
  match persistSweepStagedBlocks dir
    Err message =>
      panic "store_persistence: block staging sweep failed: \{message}"
    Ok () => match blobFileSweepStaging dir
      Err message =>
        panic "store_persistence: blob staging sweep failed: \{message}"
      Ok () => match eventLogSweepStaging dir
        Err message =>
          panic "store_persistence: event staging sweep failed: \{message}"
        Ok () =>
          reportSweep
            dir
            blockResidue
            blobResidue
            eventResidue
            strayBlockFile
            strayBlobFile
            strayEventFile

-- Plant one file directly under each of the three `.staging` directories —
-- the residue a crash between a `writeFileBytes`/`writeFile` and its `rename`
-- leaves behind — beside content this route already persisted legitimately.
-- Also plant a stray SUBDIRECTORY (with a file of its own inside) under each
-- `.staging` — residue this process did not write, which the sweep must
-- skip rather than fail on or recurse into (F5, #3053).
plantAndSweep : String -> <IO, FileRead "_", FileWrite "_"> Unit
plantAndSweep dir =
  let blockResidue = "\{dir}/blocks/.staging/crash-residue"
  let blobResidue = "\{dir}/blobs/.staging/crash-residue"
  let eventResidue = "\{dir}/events/.staging/crash-residue"
  let strayBlockDir = "\{dir}/blocks/.staging/stray-dir"
  let strayBlobDir = "\{dir}/blobs/.staging/stray-dir"
  let strayEventDir = "\{dir}/events/.staging/stray-dir"
  let strayBlockFile = "\{strayBlockDir}/inner"
  let strayBlobFile = "\{strayBlobDir}/inner"
  let strayEventFile = "\{strayEventDir}/inner"
  match writeFile blockResidue "residue"
    Err message =>
      panic "store_persistence: planting block residue failed: \{message}"
    Ok () => match writeFile blobResidue "residue"
      Err message =>
        panic "store_persistence: planting blob residue failed: \{message}"
      Ok () => match writeFile eventResidue "residue"
        Err message =>
          panic "store_persistence: planting event residue failed: \{message}"
        Ok () => match mkdirAll strayBlockDir
          Err message =>
            panic
              "store_persistence: planting stray block dir failed: \{message}"
          Ok () => match mkdirAll strayBlobDir
            Err message =>
              panic
                "store_persistence: planting stray blob dir failed: \{message}"
            Ok () => match mkdirAll strayEventDir
              Err message =>
                panic
                  "store_persistence: planting stray event dir failed: \{message}"
              Ok () => match writeFile strayBlockFile "stray"
                Err message =>
                  panic
                    "store_persistence: planting stray block file failed: \{message}"
                Ok () => match writeFile strayBlobFile "stray"
                  Err message =>
                    panic
                      "store_persistence: planting stray blob file failed: \{message}"
                  Ok () => match writeFile strayEventFile "stray"
                    Err message =>
                      panic
                        "store_persistence: planting stray event file failed: \{message}"
                    Ok () =>
                      sweepAndReport
                        dir
                        blockResidue
                        blobResidue
                        eventResidue
                        strayBlockFile
                        strayBlobFile
                        strayEventFile

{- | A data directory as an uninterrupted run leaves it: the fixture
   repository, both fixture blobs, and one promoted event entry.

   Shared by every route that plants something beside legitimate content, so
   that "the readers still answer with everything real" is a claim about all
   three halves and not a vacuous one over an empty directory. -}
persistFixtureTree : String -> <FileRead "_", FileWrite "_"> Result String Unit
persistFixtureTree dir =
  let repo = fixtureRepo
  do
    () <- persistSave
      dir
      (repoCommitCid (repoLatestCommit repo))
      (blocksOf repo)
    () <- blobFileWrite dir blobFixtures
    () <- eventLogStage dir (eventFixture None (frameFor None))
    plan <- eventLogPlanRecovery dir None
    eventLogApplyRecovery dir plan eventLogRetentionSeconds eventFixtureTime

{- | Persist a repository, blobs and one promoted event entry — the
   legitimate content a normal, uninterrupted run leaves behind — then plant
   residue in all three `.staging` directories and run the sweeps
   `pds/serve.mdk`'s `configure` runs before the listener binds. The residue
   must be gone afterward; the legitimate content it sat beside must not be,
   since a sweep that cannot tell staged residue from a directory it should
   never touch is not the sweep #2572 part 2 asked for. -}
runSweepStaging : String -> <IO, FileRead "_", FileWrite "_"> Unit
runSweepStaging dir = match persistFixtureTree dir
  Err message =>
    panic "store_persistence: sweep-staging setup failed: \{message}"
  Ok () => plantAndSweep dir

-- ── entries no store wrote (#3055) ──────────────────────────────────────────

strayText : String
strayText = "planted by the gate; no store in this tree wrote it"

-- A planted entry, answering the path it planted so the gate can require a
-- refusal to NAME it. A planted directory gets a file of its own inside, so
-- that "skipped" means the whole subtree was passed over rather than that an
-- empty directory happened to contribute nothing.
plantFile : String -> <FileWrite "_"> Result String String
plantFile path = map (_ => path) (writeFile path strayText)

plantDir : String -> <FileWrite "_"> Result String String
plantDir path = do
  () <- mkdirAll path
  _ <- plantFile "\{path}/inner"
  Ok path

-- The shard a CID's bytes land in. Re-derived here rather than imported: both
-- stores keep this arithmetic private, and the gate has to plant INSIDE a
-- shard that really exists for a leaf-level case to be a leaf-level case.
shardOf : Cid -> String
shardOf cid = take 2 (encode (cidDigest cid))

cidName : Cid -> String
cidName cid = encode (cidToBytes cid)

firstBlobCid : Cid
firstBlobCid = match blobFixtures
  (cid, _, _) :: _ => cid
  [] => panic "store_persistence: no blob fixture to shard on"

-- A shard name nothing under `parent` occupies, so a directory planted under
-- it is genuinely an entry nobody wrote and not a second handle on a real
-- shard. Derived rather than written down: which shards this fixture occupies
-- is a function of its bytes, and a hand-picked name would go stale the first
-- time a fixture record changes.
freeShardFrom : String -> Int -> <FileRead "_"> String
freeShardFrom parent n =
  if n >= 256 then
    panic "store_persistence: \{parent} occupies every shard name"
  else
    let name = encode (arrayMakeWith 1 (_ => n))
    if fileExists "\{parent}/\{name}" then
      freeShardFrom parent (n + 1)
    else
      name

plantShard : String -> <FileRead "_", FileWrite "_"> Result String String
plantShard parent = plantDir "\{parent}/\{freeShardFrom parent 0}"

-- A reader's answer in one word: how many rows it returned, or that it
-- refused. The message goes on its own line, so the gate can require BOTH the
-- disposition and that a refusal names the path it is about.
strayVerdict : Result String Int -> String
strayVerdict (Ok n) = "ok:\{intToString n}"
strayVerdict (Err _) = "refused"

strayMessage : String -> String -> Result String Int -> <IO> Unit
strayMessage _ _ (Ok _) = ()
strayMessage label reader (Err message) =
  println "STRAYMSG \{label} \{reader} \{message}"

{- | What all four readers make of one planted entry.

   Every case reports every reader and not only the one the planted entry sits
   under: a disposition that also moved a store the entry never touched is the
   failure this is otherwise blind to. `count` is `blobFileCount` beside
   `blobs`, which is `blobFileRead` — the two answer the same question by
   different means and a case where they disagree is a count of blobs the
   server cannot serve. -}
straySurvey : String -> String -> <IO, FileRead "_"> Unit
straySurvey label dir =
  let blocks = map length (blockFileRead "\{dir}/blocks")
  let blobs = map length (blobFileRead dir)
  let counted = blobFileCount dir
  let events = map length (eventLogRead dir 0)
  let () =
    println
      "STRAY \{label} blocks \{strayVerdict blocks} blobs \{strayVerdict blobs} count \{strayVerdict counted} events \{strayVerdict events}"
  let () = strayMessage label "blocks" blocks
  let () = strayMessage label "blobs" blobs
  let () = strayMessage label "count" counted
  strayMessage label "events" events

-- One case: its own legitimate data directory, one planted entry, and the
-- survey of what every reader then answers.
strayCase : String ->
  String ->
  (String -> <FileRead "_", FileWrite "_"> Result String String) ->
  <IO, FileRead "_", FileWrite "_"> Unit
strayCase root label plant =
  let dir = "\{root}/\{label}"
  match persistFixtureTree dir
    Err message =>
      panic "store_persistence: stray-entries setup failed: \{message}"
    Ok () => match plant dir
      Err message =>
        panic "store_persistence: planting \{label} failed: \{message}"
      Ok planted =>
        let () = println "STRAYPLANT \{label} \{planted}"
        straySurvey label dir

blockShardPath : String -> String
blockShardPath dir = "\{dir}/blocks/\{shardOf (repoRootCid fixtureRepo)}"

blobShardPath : String -> String
blobShardPath dir = "\{blobDir dir}/\{shardOf firstBlobCid}"

-- A bytes-file name spelling a valid CID, beside a sidecar of its own, but
-- carried by a DIRECTORY. Name arithmetic alone reads it as a blob, which is
-- why `blobFileCount` used to report one the reader skips.
plantBlobLeafCid : String -> <FileRead "_", FileWrite "_"> Result String String
plantBlobLeafCid dir =
  let name = cidName (repoRootCid fixtureRepo)
  do
    planted <- plantDir "\{blobShardPath dir}/\{name}"
    _ <- plantFile "\{blobShardPath dir}/\{name}\{mimeSuffixText}"
    Ok planted

-- The suffix `shell.blobfile` keeps private; a sidecar this fixture plants has
-- to spell it the same way or the case is not the case it claims to be.
mimeSuffixText : String
mimeSuffixText = ".mime"

{- | Every entry no store in this tree wrote, planted one at a time beside
   content that is real, at every level any of the three stores lists (#3055).

   Three shapes at each level, because the stores grade an entry on two axes:
   a stray plain FILE, a stray DIRECTORY whose name is not one the store could
   have produced, and a stray DIRECTORY whose name is one it could have — the
   third being the one a name-only rule cannot tell from its own data.

   The route asserts nothing. Each case prints what all four readers answered
   and, for a refusal, the message; `store_persistence.sh` decides which of
   those is correct, so that the expected disposition lives beside the prose
   that states the rule rather than inside the driver. -}
runStrayEntries : String -> <IO, FileRead "_", FileWrite "_"> Unit
runStrayEntries root =
  let () = strayCase root "none" (_ => Ok "nothing")
  let () = strayCase root "blocks-top-file" (dir =>
    plantFile "\{dir}/blocks/.DS_Store")
  let () =
    strayCase root "blocks-top-dir" (dir => plantDir "\{dir}/blocks/stray-dir")
  let () = strayCase root "blocks-top-shard" (dir => plantShard "\{dir}/blocks")
  let () = strayCase root "blocks-leaf-file" (dir =>
    plantFile "\{blockShardPath dir}/.DS_Store")
  let () = strayCase root "blocks-leaf-dir" (dir =>
    plantDir "\{blockShardPath dir}/stray-dir")
  let () = strayCase root "blocks-leaf-cid" (dir =>
    plantDir "\{blockShardPath dir}/\{cidName firstBlobCid}")
  let () = strayCase root "blobs-top-file" (dir =>
    plantFile "\{blobDir dir}/.DS_Store")
  let () =
    strayCase root "blobs-top-dir" (dir => plantDir "\{blobDir dir}/stray-dir")
  let () = strayCase root "blobs-top-shard" (dir => plantShard (blobDir dir))
  let () = strayCase root "blobs-leaf-file" (dir =>
    plantFile "\{blobShardPath dir}/.DS_Store")
  let () = strayCase root "blobs-leaf-dir" (dir =>
    plantDir "\{blobShardPath dir}/stray-dir")
  let () = strayCase root "blobs-leaf-cid" plantBlobLeafCid
  let () = strayCase root "events-file" (dir =>
    plantFile "\{dir}/events/entries/.DS_Store")
  let () = strayCase root "events-dir" (dir =>
    plantDir "\{dir}/events/entries/stray-dir")
  let () = strayCase root "events-name" (dir =>
    plantDir "\{dir}/events/entries/\{eventLogEntryName 9 eventFixtureTime}")
  println "STRAY-ENTRIES: PASS"

-- ── the genesis quartet ─────────────────────────────────────────────────────

-- The handle the genesis `#identity` event announces. Fixed like every other
-- input to these two routes, so the frames they produce are deterministic
-- bytes and two runs over one data directory can be compared line for line.
genesisHandle : String
genesisHandle = "persistence.fixture.test"

-- Every promoted entry, one line each: position, anchor, and the frame BYTES
-- rather than a count of them. A resumption that emitted four events of the
-- wrong kinds, or the right kinds out of order, satisfies a count.
printGenesis : List EventLogEntry -> <IO> Unit
printGenesis [] = ()
printGenesis (entry :: rest) =
  let () =
    println
      "GENESIS \{intToString entry.seq} \{anchorLabel entry.anchorCommitCid} \{entry.frameHex}"
  printGenesis rest

genesisSurvey : String -> <IO, FileRead "_"> Unit
genesisSurvey dir = match eventLogRead dir 0
  Err message => panic "store_persistence: genesis log unreadable: \{message}"
  Ok entries =>
    let () = printGenesis entries
    println "GENESIS count \{intToString (length entries)}"

{- | A start over a data directory that already holds a repository, with no
   `--init` anywhere: load the repository from disk, make the call `configure`
   makes on every start, and survey what the log holds afterwards.

   Pointed at a log the gate truncated this is the resumption; pointed at a
   finished one it must add nothing, which is the same route run twice. -}
runGenesisResume : String -> <IO, FileRead "_", FileWrite "_"> Unit
runGenesisResume dir = match reload dir
  Err message => panic "store_persistence: genesis reload failed: \{message}"
  Ok repo =>
    match (completeGenesisEvents
      dir
      accountDid
      genesisHandle
      eventFixtureTime
      repo)
      Err message => panic "store_persistence: genesis emit failed: \{message}"
      Ok () => genesisSurvey dir

-- A LATER start than the one that created the repository, which is what makes
-- the entry count a real claim: an entry's file name carries its timestamp,
-- so a quartet re-minted at the creation's own second would overwrite the
-- four files it duplicates and leave the same four names behind.
genesisSecondStartTime : Int
genesisSecondStartTime = eventFixtureTime + 3600

{- | The same start as `genesis-resume`, but reporting the refusal instead of
   panicking on it: a log whose last-promoted pointer is gone while its
   entries remain must be refused, and a route that dies on `Err` cannot tell
   a refusal apart from a crash. -}
runGenesisGuard : String -> <IO, FileRead "_", FileWrite "_"> Unit
runGenesisGuard dir = match reload dir
  Err message => panic "store_persistence: genesis reload failed: \{message}"
  Ok repo =>
    match (completeGenesisEvents
      dir
      accountDid
      genesisHandle
      genesisSecondStartTime
      repo)
      Err message => println "GENESIS-GUARD: ERR \{message}"
      Ok () =>
        let () = genesisSurvey dir
        println "GENESIS-GUARD: OK"

{- | The repository's creation: the commit persisted first, then the four
   events emitted over it.

   The events are emitted over the repository READ BACK from disk and not over
   the one just built, so that this route's survey and `genesis-resume`'s are
   the same bytes whenever the log is. What the gate compares is a log nothing
   interrupted against one it truncated and let this finish, and the
   comparison would otherwise be grading the reload as well. -}
runGenesisInit : String -> <IO, FileRead "_", FileWrite "_"> Unit
runGenesisInit dir =
  let repo = fixtureRepo
  match persistSave dir (repoCommitCid (repoLatestCommit repo)) (blocksOf repo)
    Err message => panic "store_persistence: genesis save failed: \{message}"
    Ok () => runGenesisResume dir

main : <IO, Env, FileRead "_", FileWrite "_"> Unit
main = match args ()
  ["save", dir] => runSave dir
  ["crash-save-old", dir] => runCrashSaveOld dir
  ["load", dir] => runLoad dir
  ["reject", dir] => runReject dir
  ["blob-save", dir] => runBlobSave dir
  ["blob-load", dir] => runBlobLoad dir
  ["blob-survey", dir] => runBlobSurvey dir
  ["blob-reject", dir] => runBlobReject dir
  ["blob-oversize", dir] => runBlobOversize dir
  ["prefs-save", dir] => runPrefsSave dir
  ["prefs-load", dir] => runPrefsLoad dir
  ["sessions-save", dir] => runSessionsSave dir
  ["sessions-load", dir] => runSessionsLoad dir
  ["credential-save", dir] => runCredentialSave dir
  ["event-recover-owed", dir] => runEventRecover dir (_ head => Some head)
  ["event-recover-orphan", dir] =>
    runEventRecover dir (repo _ => Some (cidToString (repoRootCid repo)))
  ["event-recover-unanchored", dir] => runEventRecover dir (_ _ => None)
  ["transition", dir] => runTransition dir
  ["blob-churn-seed", dir] => runBlobChurnSeed dir
  ["blob-churn-add", dir] => runBlobChurnAdd dir
  ["sweep-staging", dir] => runSweepStaging dir
  ["stray-entries", dir] => runStrayEntries dir
  ["genesis-init", dir] => runGenesisInit dir
  ["genesis-resume", dir] => runGenesisResume dir
  ["genesis-guard", dir] => runGenesisGuard dir
  _ =>
    panic
      "usage: store_persistence_main <save|crash-save-old|load|reject|blob-save|blob-load|blob-survey|blob-reject|blob-oversize|prefs-save|prefs-load|sessions-save|sessions-load|credential-save|event-recover-owed|event-recover-orphan|event-recover-unanchored|transition|blob-churn-seed|blob-churn-add|sweep-staging|stray-entries|genesis-init|genesis-resume|genesis-guard> <dir>"
