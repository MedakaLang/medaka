{- | The `#commit` body's own lexicon bounds, the shape of the three activation
   frames, and the genesis commit's block set (`pds/lib/sync_event.mdk`).

   `com.atproto.sync.subscribeRepos` def `commit` caps `ops` at 200 entries,
   and nothing at the repository layer caps a write batch, so a legal
   `applyWrites` can produce more ops than the event is allowed to carry. The
   field the lexicon provides for that is `tooBig`, whose own description says
   the consumer fetches the missing data in a separate request — so an
   over-long commit is REPORTED (`tooBig` true, `ops` empty), never emitted
   over the cap.

   The first three cases are the `ops` cap's boundary and its two sides. A cap
   written with the wrong comparison passes one of them and fails another,
   which is why 200 and 201 are both here rather than a single "large" commit.

   The next three are the activation frames' SHAPE, over inputs the pinned
   corpus does not use: which message type the header announces, which keys
   the body carries and which it does not. `pds/test/
   activation_event_vectors_main.mdk` grades the same builders' BYTES against
   the official ones, and does it for one fixture; what is stated here is the
   shape as a property of any input, including the absence of the `status`
   field an inactive account would carry.

   Then the genesis `#commit`'s own `blocks` CAR, which has to carry the empty
   MST root node as well as the commit.

   The last group is the op list itself: a record rewritten to the CID it
   already held is not an op, two MST keys that differ only in bytes that are
   not UTF-8 are two different paths, and a path that is not UTF-8 has no
   text-string encoding, so the frame that would have to carry one is
   refused. -}

import bytes as B
import bytes.{Bytes, encodeUtf8, fromU8Array, sliceClamped}
import crypto.sha256.{sha256}
import hex.{encode}
import list.{lookup, range, sort}
import string.{padLeft}
import test.{expectEqual}
import lib.car.{carBlocks, carDecode, carRoots}
import lib.cid.{Cid, cidForDagCbor, cidForRaw, cidToString}
import lib.dagcbor.{DagCbor(..), dagCborDecode, dagCborEncode}
import lib.mst.{mstEmpty, mstFromEntries, mstNodeBlocks, mstRootCid}
import lib.repo.{
  Repo,
  RepoMutation,
  RepoWrite(..),
  repoApplyWrites,
  repoCommitCid,
  repoCreate,
  repoFromBlocks,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoMutationState,
  repoUpdate,
}
import lib.sign.{SecretKey, secretKeyFromBytes, signDigest, signatureCompact}
import lib.sync_event.{
  SyncCommitEvent(..),
  SyncRepoOp(..),
  syncAccountFrame,
  syncCommitBody,
  syncCommitEventFor,
  syncCommitFrame,
  syncIdentityFrame,
  syncSyncFrame,
}
import lib.tid.{Tid, tidEncode, tidToString}

recordCid : Cid
recordCid = cidForRaw (encodeUtf8 "record")

commitCid : Cid
commitCid = cidForRaw (encodeUtf8 "commit")

mustTid : Result String Tid -> Tid
mustTid (Ok tid) = tid
mustTid (Err message) = panic message

sampleRev : Tid
sampleRev = mustTid (tidEncode 1 1)

-- Distinct paths, so a cap that deduplicated rather than counted would not
-- pass by accident.
opAt : Int -> SyncRepoOp
opAt i =
  SyncOpCreate
    (encodeUtf8 ("app.bsky.feed.post/rec-" ++ intToString i))
    recordCid

-- A commit carrying `count` creates. `blocksCar` is empty because nothing
-- here grades the CAR: the cap under test is on `ops` alone.
eventWithOps : Int -> SyncCommitEvent
eventWithOps count = SyncCommitEvent {
  seq = 1,
  time = "2026-01-01T00:00:00.000Z",
  repoDid = "did:plc:medakaexamplerepo",
  commitCid = commitCid,
  rev = sampleRev,
  since = None,
  prevData = None,
  blocksCar = fromU8Array [||],
  ops = map opAt (range 0 count),
}

bodyField : String -> DagCbor -> Option DagCbor
bodyField name (DcMap fields) = lookup name fields
bodyField _ _ = None

mustBody : Result String DagCbor -> DagCbor
mustBody (Ok body) = body
mustBody (Err message) = panic "sync_event: body refused: \{message}"

-- `DagCbor` derives no `Eq`, so each assertion projects the one field it is
-- about down to a primitive rather than comparing encoded values.
asBool : Option DagCbor -> Option Bool
asBool (Some (DcBool value)) = Some value
asBool _ = None

-- `-1` for "not an array at all", which no legal length can collide with.
arrayLen : Option DagCbor -> Int
arrayLen (Some (DcArray items)) = length items
arrayLen _ = 0 - 1

tooBigOf : Int -> Option Bool
tooBigOf count =
  asBool (bodyField "tooBig" (mustBody (syncCommitBody (eventWithOps count))))

opsLengthOf : Int -> Int
opsLengthOf count =
  arrayLen (bodyField "ops" (mustBody (syncCommitBody (eventWithOps count))))

test "an ordinary commit reports its ops and is not tooBig" =
  expectEqual (tooBigOf 3, opsLengthOf 3) (Some False, 3)

test "a commit exactly at the lexicon cap still carries every op" =
  expectEqual (tooBigOf 200, opsLengthOf 200) (Some False, 200)

test "a commit one op over the cap is reported as tooBig with no ops" =
  expectEqual (tooBigOf 201, opsLengthOf 201) (Some True, 0)

-- # The activation frames

-- A DID and a handle that are not the pinned corpus's, so a builder that
-- ignored an argument and emitted a constant would not pass here.
sampleDid : String
sampleDid = "did:plc:medakaexamplerepo"

sampleHandle : String
sampleHandle = "gate.medaka.example.invalid"

commitBytes : Bytes
commitBytes = encodeUtf8 "commit"

-- The position in the stream every frame below is stamped with. The builders
-- take it rather than invent it, so these are the caller's values and the
-- assertions read them back out of the encoded body.
sampleSeq : Int
sampleSeq = 4207

sampleTime : String
sampleTime = "2026-09-13T18:34:14.000Z"

{- | A frame's two objects. `dagCborDecode` decodes exactly one canonical value
   and refuses trailing bytes, so the boundary between them is the shortest
   prefix that decodes and leaves a decodable remainder. -}
frameParts : Result String Bytes -> (DagCbor, DagCbor)
frameParts (Err message) = panic "sync_event: frame refused: \{message}"
frameParts (Ok bytes) = partsAt bytes 1

decodePart : Bytes -> Int -> Int -> Result String DagCbor
decodePart bytes lo hi = dagCborDecode (sliceClamped lo hi bytes)

partsAt : Bytes -> Int -> (DagCbor, DagCbor)
partsAt bytes cut =
  if cut > B.length bytes then
    panic "sync_event: frame carries no decodable header object"
  else match decodePart bytes 0 cut
    Err _ => partsAt bytes (cut + 1)
    Ok header => match decodePart bytes cut (B.length bytes)
      Err _ => partsAt bytes (cut + 1)
      Ok body => (header, body)

-- The body's keys in the order they were encoded, which DAG-CBOR fixes: by
-- key length first, then bytewise. A key the builder must NOT emit is absent
-- from this list, which is the whole point of comparing the set rather than
-- reading one field.
keysOf : DagCbor -> List String
keysOf (DcMap fields) = map ((key, _) => key) fields
keysOf _ = []

textOf : DagCbor -> String -> String
textOf value name = match bodyField name value
  Some (DcString text) => text
  _ => ""

boolOf : DagCbor -> String -> Option Bool
boolOf value name = asBool (bodyField name value)

-- A CAR's roots and its blocks, each as CID text, in the order it holds them.
carCidsOf : Bytes -> (List String, List String)
carCidsOf bytes = match carDecode bytes
  Ok car => (
    map cidToString (carRoots car),
    map ((cid, _) => cidToString cid) (carBlocks car),
  )
  Err message => panic "sync_event: undecodable CAR: \{message}"

-- The `blocks` CAR's roots and its block set, each as CID text.
carCids : DagCbor -> (List String, List String)
carCids body = match bodyField "blocks" body
  Some (DcBytes bytes) => carCidsOf bytes
  _ => panic "sync_event: #sync body carries no blocks"

test "an #identity frame names the handle beside the DID and nothing else" =
  let frame = syncIdentityFrame sampleSeq sampleTime sampleDid sampleHandle
  let (header, body) = frameParts frame
  expectEqual
    (textOf header "t", keysOf body, textOf body "handle")
    ("#identity", ["did", "seq", "time", "handle"], sampleHandle)

test "an #account frame states active and carries no status" =
  let (header, body) =
    frameParts (syncAccountFrame sampleSeq sampleTime sampleDid)
  expectEqual
    (textOf header "t", keysOf body, boolOf body "active")
    ("#account", ["did", "seq", "time", "active"], Some True)

test "a #sync frame's CAR is rooted at and holds only the commit block" =
  let frame =
    syncSyncFrame sampleSeq sampleTime sampleDid sampleRev commitCid commitBytes
  let (header, body) = frameParts frame
  expectEqual
    (textOf header "t", keysOf body, carCids body)
    (
      "#sync",
      ["did", "rev", "seq", "time", "blocks"],
      ([cidToString commitCid], [cidToString commitCid]),
    )

-- # The genesis commit

mustRepo : Result String Repo -> Repo
mustRepo (Ok repo) = repo
mustRepo (Err message) = panic "sync_event: repository init failed: \{message}"

mustEvent : Result String SyncCommitEvent -> SyncCommitEvent
mustEvent (Ok event) = event
mustEvent (Err message) = panic "sync_event: event refused: \{message}"

-- A repository at its first commit: created, never written to.
genesisRepo : Repo
genesisRepo =
  mustRepo
    (repoInitFromKeyBytes sampleDid (fromU8Array (arrayMake 32 1)) sampleRev)

{- | The genesis event. `None` for the prior repository is what
   `pds/shell/server.mdk` hands `syncCommitEventFor` when it announces a new
   account, and the only case that passes it. -}
genesisEvent : SyncCommitEvent
genesisEvent =
  mustEvent (syncCommitEventFor sampleSeq sampleTime sampleDid None genesisRepo)

{- | A genesis `blocks` CAR has to carry the empty MST root node as well as the
   commit, because the commit's `data` field names that node and a reader
   given neither it nor a prior root has no way to reach it. A rule that
   subtracts a prior tree's nodes from the post-write tree's loses exactly
   this block when the two are both empty, which at genesis they are.

   The block list is asserted in sorted-CID order, not as a set: `sortBlocks`
   makes the emitted bytes a function of the block set rather than of a
   traversal, and a CAR that carried the right two blocks in an order that
   varied run to run would still be a defect. -}
test "a genesis commit's CAR carries the empty MST root beside the commit" =
  let commit = cidToString (repoCommitCid (repoLatestCommit genesisRepo))
  expectEqual (carCidsOf genesisEvent.blocksCar) (
    [commit],
    sort [commit, cidToString (mstRootCid mstEmpty)],
  )

-- # The op list

-- An op as text, its path in hex so a key that is not UTF-8 still reads.
opText : SyncRepoOp -> String
opText (SyncOpCreate path cid) = "create \{encode path} \{cidToString cid}"
opText (SyncOpUpdate path cid prev) =
  "update \{encode path} \{cidToString cid} prev \{cidToString prev}"
opText (SyncOpDelete path prev) =
  "delete \{encode path} prev \{cidToString prev}"

must : Result String a -> a
must (Ok value) = value
must (Err message) = panic "sync_event: \{message}"

mustState : Result String RepoMutation -> Repo
mustState result = repoMutationState (must result)

opsBetween : Repo -> Repo -> List String
opsBetween before after =
  map
    opText
    (mustEvent
      (syncCommitEventFor 2 sampleTime sampleDid (Some before) after)).ops

sampleRecord : String -> DagCbor
sampleRecord text =
  DcMap [("$type", DcString "app.bsky.feed.post"), ("text", DcString text)]

recordCidOf : String -> Cid
recordCidOf text = cidForDagCbor (must (dagCborEncode (sampleRecord text)))

samplePath : Bytes
samplePath = encodeUtf8 "app.bsky.feed.post/one"

{- | A record rewritten to the bytes it already held leaves the MST where it
   was, so the commit that wrote it announces nothing: an update op here
   would claim a mutation no reader of the tree can find. -}
test "a record rewritten to its own CID announces no op" =
  let created =
    mustState
      (repoCreate
        samplePath
        (sampleRecord "one")
        (mustTid (tidEncode 2 1))
        genesisRepo)
  let rewritten =
    mustState
      (repoUpdate
        samplePath
        (sampleRecord "one")
        (mustTid (tidEncode 3 1))
        created)
  expectEqual [] (opsBetween created rewritten)

sampleSecret : SecretKey
sampleSecret = must (secretKeyFromBytes (fromU8Array (arrayMake 32 1)))

{- | A signed repository whose MST holds exactly `rows`, rebuilt through
   `repoFromBlocks`. No write path admits a key that is not UTF-8, and a
   rebuild does not re-validate keys, so this is the route such a key takes
   into a `Repo`. -}
rebuiltRepo : Int -> List (Bytes, String) -> Repo
rebuiltRepo revN rows =
  let records =
    map ((path, text) => (path, must (dagCborEncode (sampleRecord text)))) rows
  let tree =
    must
      (mstFromEntries
        (map ((path, bytes) => (path, cidForDagCbor bytes)) records))
  let rev = mustTid (tidEncode (10 + revN) 1)
  let fields = [
    ("did", DcString sampleDid),
    ("version", DcInt 3),
    ("data", DcLink (mstRootCid tree)),
    ("rev", DcString (tidToString rev)),
    ("prev", DcNull),
  ]
  let unsigned = must (dagCborEncode (DcMap fields))
  let signature = must (signDigest sampleSecret (sha256 unsigned))
  let signed =
    must
      (dagCborEncode
        (DcMap (fields ++ [("sig", DcBytes (signatureCompact signature))])))
  let commit = cidForDagCbor signed
  let blocks =
    (commit, signed)
      :: mstNodeBlocks tree
        ++ map ((_, bytes) => (cidForDagCbor bytes, bytes)) records
  must (repoFromBlocks sampleDid sampleSecret commit blocks)

-- `a.b.c/` followed by one byte that no UTF-8 sequence starts with. A lossy
-- decode maps both to U+FFFD, so an index keyed on text sees one path.
keyFF : Bytes
keyFF = fromU8Array [|97, 46, 98, 46, 99, 47, 255|]

keyFE : Bytes
keyFE = fromU8Array [|97, 46, 98, 46, 99, 47, 254|]

oneAtFF : Repo
oneAtFF = rebuiltRepo 1 [(keyFF, "one")]

-- Every case below announces at least one op whose path is `keyFE` or `keyFF`,
-- so each event's op list is exact and each event's frame is refused: the ops
-- come from the two trees, and only the frame has to spell a path as text.
-- `keyFE` sorts first, so its op is the one the refusal names.
frameOutcome : SyncCommitEvent -> Result String Unit
frameOutcome event = map (_ => ()) (syncCommitFrame event)

feRefusal : Result String Unit
feRefusal = Err "sync_event: op path 612e622e632ffe (hex) is not valid UTF-8"

opsAndFrame : Repo -> Repo -> (List String, Result String Unit)
opsAndFrame before after =
  let event =
    mustEvent (syncCommitEventFor 2 sampleTime sampleDid (Some before) after)
  (map opText event.ops, frameOutcome event)

test "a record renamed between two non-UTF-8 keys is a create and a delete" =
  let one = cidToString (recordCidOf "one")
  let expected = [
    "create 612e622e632ffe \{one}",
    "delete 612e622e632fff prev \{one}",
  ]
  expectEqual
    (expected, feRefusal)
    (opsAndFrame oneAtFF (rebuiltRepo 3 [(keyFE, "one")]))

test "a second non-UTF-8 key beside the first is announced as a create" =
  let one = cidToString (recordCidOf "one")
  let after = rebuiltRepo 4 [(keyFF, "one"), (keyFE, "one")]
  expectEqual
    (["create 612e622e632ffe \{one}"], feRefusal)
    (opsAndFrame oneAtFF after)

test "a different record under a different non-UTF-8 key is not an update" =
  let one = cidToString (recordCidOf "one")
  let two = cidToString (recordCidOf "two")
  let expected = [
    "create 612e622e632ffe \{two}",
    "delete 612e622e632fff prev \{one}",
  ]
  expectEqual
    (expected, feRefusal)
    (opsAndFrame oneAtFF (rebuiltRepo 2 [(keyFE, "two")]))

-- The path `ops[0]` carries in an encoded `#commit` frame, re-encoded.
framedOpPath : Result String Bytes -> Bytes
framedOpPath frame = match bodyField "ops" (snd (frameParts frame))
  Some (DcArray (op :: _)) => match bodyField "path" op
    Some (DcString text) => encodeUtf8 text
    _ => panic "sync_event: op carries no text path"
  _ => panic "sync_event: #commit body carries no op"

{- | A path outside ASCII but inside UTF-8 is a text string like any other,
   and reaches the frame as exactly the bytes the MST holds. -}
test "a non-ASCII UTF-8 path reaches the frame byte for byte" =
  let path = encodeUtf8 "a.b.c/é🐟"
  let event = { eventWithOps 0 | ops = [SyncOpCreate path recordCid] }
  expectEqual path (framedOpPath (syncCommitFrame event))

postPath : String -> Bytes
postPath rkey = encodeUtf8 "app.bsky.feed.post/\{rkey}"

-- Enough filler records that the tree is several nodes deep, so the four named
-- keys sit in different subtrees and most of the tree is untouched.
fillerRows : List (Bytes, String)
fillerRows =
  map
    (i =>
      (postPath "k\{padLeft 3 '0' (intToString i)}", "filler \{intToString i}"))
    (range 0 120)

batchBase : Repo
batchBase =
  rebuiltRepo
    5
    ([
        (postPath "a", "a1"),
        (postPath "b", "b1"),
        (postPath "c", "c1"),
        (postPath "d", "d1"),
      ]
      ++ fillerRows)

{- | One batch touching every op shape. `a` is deleted and recreated with new
   bytes, which is an update; `d` is rewritten to the bytes it already held and
   `f` is created, updated and deleted again, and neither is an op at all. The
   ops come in post-write key order for creates and updates, then pre-write key
   order for deletes, so the delete of `c` follows the create of `e`. -}
test "one applyWrites batch announces exactly the keys whose CIDs moved" =
  let writes = [
    RepoWriteCreate (postPath "e") (sampleRecord "e1"),
    RepoWriteUpdate (postPath "b") (sampleRecord "b2"),
    RepoWriteDelete (postPath "c"),
    RepoWriteUpdate (postPath "d") (sampleRecord "d1"),
    RepoWriteCreate (postPath "f") (sampleRecord "f1"),
    RepoWriteUpdate (postPath "f") (sampleRecord "f2"),
    RepoWriteDelete (postPath "f"),
    RepoWriteDelete (postPath "a"),
    RepoWriteCreate (postPath "a") (sampleRecord "a2"),
  ]
  let after =
    mustState (repoApplyWrites writes (mustTid (tidEncode 30 1)) batchBase)
  let cidOf = text => cidToString (recordCidOf text)
  let hexOf = rkey => encode (postPath rkey)
  expectEqual
    [
      "update \{hexOf "a"} \{cidOf "a2"} prev \{cidOf "a1"}",
      "update \{hexOf "b"} \{cidOf "b2"} prev \{cidOf "b1"}",
      "create \{hexOf "e"} \{cidOf "e1"}",
      "delete \{hexOf "c"} prev \{cidOf "c1"}",
    ]
    (opsBetween batchBase after)
