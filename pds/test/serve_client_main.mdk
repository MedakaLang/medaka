{- | Gate A (`pds/test/serve_e2e.sh`) test client: a plain synchronous socket
   driver over `stdlib/net`, one subcommand per acceptance case. This is a
   test client, not another server, so it deliberately does NOT use
   `net_async` — `pds/shell/server.mdk` is the only thing in this tree that
   needs the async scheduler.

   Every route prints its case name and `PASS`/`FAIL` on the last line
   (`pds/test/store_persistence_main.mdk`'s convention); the shell gate reads
   that line and nothing else. -}

import array.{concat, sliceClamped}
import hex as Hex
import lib.cid.{cidForRaw, cidToString}
import lib.credential.{
  credentialDigest,
  credentialIterations,
  credentialSalt,
  makeCredential,
  saltBytes,
}
import sha256.{sha256}
import json.{Json(..), get, jArray, jObject, parse, stringify}
import net.{Connection, close, connect, recv, sendAll, setTimeout}
import regex.{Regex, find, mustCompile}
import string.{
  contains,
  fromChars,
  fromUtf8,
  lines,
  split,
  toChars,
  toInt,
  toUtf8,
  trim,
}
import time.{Duration, elapsedSince, millis, monotonic, seconds, sleep}

-- # Small ad-hoc helpers this test driver owns

-- `stdlib/http.mdk` never needs a response PARSER — the server only ever
-- serializes responses, never reads one — so a minimal one lives here,
-- test-only, reading exactly what `serializeResponse` always produces: a
-- status line, headers, and a `content-length:` body (never chunked; see
-- `serializeResponse`).

hexDigits : Array Char
hexDigits = toChars "0123456789abcdef"

hexDigitChar : Int -> Char
hexDigitChar d = hexDigits[d]

toHexGo : Int -> List Char -> List Char
toHexGo n acc =
  if n == 0 then acc else toHexGo (n / 16) (hexDigitChar (n % 16) :: acc)

-- | Lowercase hex text of a non-negative `Int`, no leading zeros (a valid
-- HTTP chunk-size line).
toHexString : Int -> String
toHexString n = if n == 0 then "0" else fromChars (toHexGo n [])

appendBytes : Array Int -> Array Int -> Array Int
appendBytes left right = concat [|left, right|]

-- | Byte offset of the first `\r\n\r\n` at or after `i`, if any.
findHeaderEnd : Array Int -> Int -> Option Int
findHeaderEnd buf i =
  if i + 4 > arrayLength buf then
    None
  else if buf[i] == 13
    && buf[i + 1] == 10
    && buf[i + 2] == 13
    && buf[i + 3] == 10 then
    Some i
  else
    findHeaderEnd buf (i + 1)

statusOf : String -> Result String Int
statusOf statusLine = match split " " statusLine
  _ :: code :: _ => match toInt code
    Some n => Ok n
    None => Err "serve_client: unparsable status code in '\{statusLine}'"
  _ => Err "serve_client: unparsable status line '\{statusLine}'"

-- Response headers are always lowercase (`serializeResponse` emits them that
-- way), so these two patterns are case-sensitive. Each captures the whole
-- field value rather than matching its shape: a line that names the field but
-- carries an unreadable value is still THIS field's line, and must report its
-- own error rather than fall through to the next line.
contentLengthRe : Regex
contentLengthRe = mustCompile "^content-length:(.*)$"

contentTypeRe : Regex
contentTypeRe = mustCompile "^content-type:(.*)$"

contentLengthOf : List String -> Result String Int
contentLengthOf [] = Err "serve_client: response has no content-length header"
contentLengthOf (line :: rest) = match find contentLengthRe line
  None => contentLengthOf rest
  Some m => match m.groups
    [Some g] => match toInt (trim g.text)
      Some n => Ok n
      None => Err "serve_client: unparsable content-length in '\{line}'"
    _ => Err "serve_client: unparsable content-length in '\{line}'"

-- | The response's declared media type, or the empty string when it declares
-- none. `sync.getBlob` answers with the blob's DECLARED type here, which is
-- the one thing about a blob content addressing cannot check.
contentTypeOf : List String -> String
contentTypeOf [] = ""
contentTypeOf (line :: rest) = match find contentTypeRe line
  None => contentTypeOf rest
  Some m => match m.groups
    [Some g] => trim g.text
    _ => ""

parseHeaderBlock : Array Int -> Result String (Int, String, Int)
parseHeaderBlock headerBytes = match lines (fromUtf8 headerBytes)
  [] => Err "serve_client: empty response header block"
  statusLine :: rest => do
    status <- statusOf statusLine
    len <- contentLengthOf rest
    Ok (status, contentTypeOf rest, len)

recvAtLeast : Connection ->
  Array Int ->
  Int ->
  <Net "_"> Result String (Array Int)
recvAtLeast conn buf need =
  if arrayLength buf >= need then
    Ok buf
  else match recv conn 65536
    Err message => Err message
    Ok chunk =>
      if arrayLength chunk == 0 then
        Err "serve_client: connection closed mid-response"
      else
        recvAtLeast conn (appendBytes buf chunk) need

{- | Reads one complete HTTP response starting at the front of `pending`
   (bytes already buffered from a previous read, `[||]` for a fresh
   connection), receiving more as needed. Returns the status code, the
   declared media type, the body bytes, and whatever bytes were buffered past
   the end of this response — the next pipelined response's bytes, on a
   connection that has one. -}
readTypedResponse : Connection ->
  Array Int ->
  <Net "_"> Result String (Int, String, Array Int, Array Int)
readTypedResponse conn pending = match findHeaderEnd pending 0
  Some headerEnd => do
    let bodyStart = headerEnd + 4
    (status, mediaType, len) <- parseHeaderBlock
      (sliceClamped 0 headerEnd pending)
    let need = bodyStart + len
    full <- recvAtLeast conn pending need
    Ok (
      status,
      mediaType,
      sliceClamped bodyStart need full,
      sliceClamped need (arrayLength full) full,
    )
  None => match recv conn 4096
    Err message => Err message
    Ok chunk =>
      if arrayLength chunk == 0 then
        Err "serve_client: connection closed before response headers"
      else
        readTypedResponse conn (appendBytes pending chunk)

{- | Same read as `readTypedResponse`, but keeps the raw header block text
   instead of parsing only the status and content type out of it — for the
   rate-limit cases, which must assert directly on the `ratelimit-*`
   response headers no other reader keeps. -}
readHeaderResponse : Connection ->
  Array Int ->
  <Net "_"> Result String (Int, String, Array Int, Array Int)
readHeaderResponse conn pending = match findHeaderEnd pending 0
  Some headerEnd => do
    let bodyStart = headerEnd + 4
    let headerBlock = sliceClamped 0 headerEnd pending
    let headerText = fromUtf8 headerBlock
    (status, _, len) <- parseHeaderBlock headerBlock
    let need = bodyStart + len
    full <- recvAtLeast conn pending need
    Ok (
      status,
      headerText,
      sliceClamped bodyStart need full,
      sliceClamped need (arrayLength full) full,
    )
  None => match recv conn 4096
    Err message => Err message
    Ok chunk =>
      if arrayLength chunk == 0 then
        Err "serve_client: connection closed before response headers"
      else
        readHeaderResponse conn (appendBytes pending chunk)

-- | The same read for the cases that do not care what media type came back.
readResponse : Connection ->
  Array Int ->
  <Net "_"> Result String (Int, Array Int, Array Int)
readResponse conn pending =
  map
    ((status, _, body, rest) => (status, body, rest))
    (readTypedResponse conn pending)

mustConnect : Int -> <Net "_"> Connection
mustConnect port = match connect "127.0.0.1" port
  Ok conn => conn
  Err message => panic "serve_client: connect failed: \{message}"

mustSend : Connection -> Array Int -> <Net "_"> Unit
mustSend conn bytes = match sendAll conn bytes
  Ok () => ()
  Err message => panic "serve_client: send failed: \{message}"

-- # Request builders

hostHeader : String
hostHeader = "Host: 127.0.0.1\r\n"

getRequest : String -> Array Int
getRequest path = toUtf8 "GET \{path} HTTP/1.1\r\n\{hostHeader}\r\n"

-- | The same GET, carrying a bearer token.
getRequestWith : String -> String -> Array Int
getRequestWith token path =
  toUtf8 "GET \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}\r\n"

-- | An empty `xff` sends no header at all, so a rate-limit case run without
-- `--trusted-proxy` on the server exercises the untrusted, single-bucket
-- path with the exact same request builder as the trusted one.
xffHeader : String -> String
xffHeader "" = ""
xffHeader xff = "X-Forwarded-For: \{xff}\r\n"

-- | The same GET, carrying a forwarded-for identity rather than a token —
-- what the rate-limit cases use to tell one client identity from another.
getRequestXff : String -> String -> Array Int
getRequestXff xff path =
  toUtf8 "GET \{path} HTTP/1.1\r\n\{hostHeader}\{xffHeader xff}\r\n"

oneChunk : Array Int -> Array Int
oneChunk chunkBytes = concat [|
  toUtf8 "\{toHexString (arrayLength chunkBytes)}\r\n",
  chunkBytes,
  toUtf8 "\r\n",
|]

finalChunk : Array Int
finalChunk = toUtf8 "0\r\n\r\n"

{- | The `Authorization` header block a write carries, or the empty string.

   The three record-write procedures are `AuthenticatedRoute`, so a request to
   one is refused at `lib.server_core`'s seam before any handler runs unless it
   presents a bearer token this server can verify. `auth` is passed in rather
   than obtained here so that the gate logs in once per run (the `login`
   subcommand) and hands the access token it was issued to every case. -}
authHeader : String -> String
authHeader "" = ""
authHeader token = "Authorization: Bearer \{token}\r\n"

-- | A `content-length` JSON POST, the ordinary shape the three write
-- procedures take when nothing is testing chunked transfer encoding.
postRequest : String -> String -> String -> Array Int
postRequest token path bodyJson =
  let body = toUtf8 bodyJson
  concat [|
    toUtf8
      "POST \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}Content-Type: application/json\r\nContent-Length: \{intToString (arrayLength body)}\r\n\r\n",
    body,
  |]

-- | The same content-length JSON POST as `postRequest`, carrying a
-- forwarded-for identity instead of (or alongside) a bearer token — the
-- write and createSession rate-limit cases use this to run two identities
-- against the server at once.
postRequestXff : String -> String -> String -> String -> Array Int
postRequestXff xff token path bodyJson =
  let body = toUtf8 bodyJson
  concat [|
    toUtf8
      "POST \{path} HTTP/1.1\r\n\{hostHeader}\{xffHeader xff}\{authHeader token}Content-Type: application/json\r\nContent-Length: \{intToString (arrayLength body)}\r\n\r\n",
    body,
  |]

-- A POST with no body and no body framing at all, which is the shape
-- `com.atproto.server.{refreshSession, deleteSession}` take: they are
-- `NoInput` procedures, and the router refuses one that carries framing.
postNoInputRequest : String -> String -> Array Int
postNoInputRequest token path =
  toUtf8 "POST \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}\r\n"

{- | A `content-length` POST whose body is raw bytes under a caller-chosen
   media type, which is the shape `com.atproto.repo.uploadBlob` takes: the
   `Content-Type` header IS the blob's declared MIME type, and there is no
   JSON envelope anywhere in the request. -}
rawPostRequest : String -> String -> String -> Array Int -> Array Int
rawPostRequest token path mimeType body = concat [|
  toUtf8
    "POST \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}Content-Type: \{mimeType}\r\nContent-Length: \{intToString (arrayLength body)}\r\n\r\n",
  body,
|]

chunkedPostRequest : String -> String -> String -> Array Int
chunkedPostRequest token path bodyJson =
  let body = toUtf8 bodyJson
  let n = arrayLength body
  let mid = n / 2
  let head =
    toUtf8
      "POST \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}Content-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n"
  concat [|
    head,
    oneChunk (sliceClamped 0 mid body),
    oneChunk (sliceClamped mid n body),
    finalChunk,
  |]

-- # Fixture JSON

createRecordJson : String -> String -> String -> String -> String
createRecordJson did collection rkey text =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
      (
        "record",
        JObject [|
          ("$type", JString "app.bsky.feed.post"),
          ("text", JString text),
          ("createdAt", JString "2026-09-02T00:00:00.000Z"),
        |],
      ),
    ])

createSessionJson : String -> String -> String
createSessionJson identifier password =
  stringify
    (jObject [
      ("identifier", JString identifier),
      ("password", JString password),
    ])

deleteRecordJson : String -> String -> String -> String
deleteRecordJson did collection rkey =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
    ])

xrpcPath : String -> String
xrpcPath nsid = "/xrpc/\{nsid}"

createRecordPath : String
createRecordPath = xrpcPath "com.atproto.repo.createRecord"

getRecordPath : String -> String -> String -> String
getRecordPath did collection rkey =
  "\{xrpcPath "com.atproto.repo.getRecord"}?repo=\{did}&collection=\{collection}&rkey=\{rkey}"

createSessionPath : String
createSessionPath = xrpcPath "com.atproto.server.createSession"

refreshSessionPath : String
refreshSessionPath = xrpcPath "com.atproto.server.refreshSession"

deleteSessionPath : String
deleteSessionPath = xrpcPath "com.atproto.server.deleteSession"

getSessionPath : String
getSessionPath = xrpcPath "com.atproto.server.getSession"

getPreferencesPath : String
getPreferencesPath = xrpcPath "app.bsky.actor.getPreferences"

putPreferencesPath : String
putPreferencesPath = xrpcPath "app.bsky.actor.putPreferences"

uploadBlobPath : String
uploadBlobPath = xrpcPath "com.atproto.repo.uploadBlob"

getRepoPath : String -> String
getRepoPath did = "\{xrpcPath "com.atproto.sync.getRepo"}?did=\{did}"

getBlobPath : String -> String -> String
getBlobPath did cid =
  "\{xrpcPath "com.atproto.sync.getBlob"}?did=\{did}&cid=\{cid}"

atprotoDidPath : String
atprotoDidPath = "/.well-known/atproto-did"

didJsonPath : String
didJsonPath = "/.well-known/did.json"

-- | One string field of a JSON response body, or a panic naming what was
-- missing. A session response the gate cannot read is a failed gate, not a
-- case to carry on past.
stringField : String -> Array Int -> String
stringField name body = match parse (fromUtf8 body)
  Err message => panic "serve_client: response is not JSON: \{message}"
  Ok value => match get name value
    Some (JString text) => text
    _ =>
      panic
        "serve_client: response has no string field '\{name}': \{fromUtf8 body}"

-- # Cases

report : String -> Bool -> String -> <IO> Unit
report label ok detail =
  if ok then
    println "\{label}: PASS \{detail}"
  else
    let () = println "\{label}: FAIL \{detail}"
    exit 1

expectStatus : String ->
  Int ->
  Result String (Int, Array Int, Array Int) ->
  <IO> Unit
expectStatus label _ (Err message) = report label False message
expectStatus label want (Ok (got, _, _)) =
  report
    label
    (got == want)
    "status \{intToString got} (wanted \{intToString want})"

ignoreResult : Result String a -> Unit
ignoreResult (Ok _) = ()
ignoreResult (Err _) = ()

runQuery : Int -> String -> <IO, Net "_"> Unit
runQuery port did =
  let conn = mustConnect port
  let () = mustSend conn (getRequest atprotoDidPath)
  let result = readResponse conn [||]
  let () = expectStatus "QUERY" 200 result
  let () = match result
    Ok (_, body, _) =>
      if trim (fromUtf8 body) == did then
        ()
      else
        report
          "QUERY"
          False
          "body '\{fromUtf8 body}' did not echo the hosted DID"
    Err _ => ()
  ignoreResult (close conn)

runPipeline : Int -> <IO, Net "_"> Unit
runPipeline port =
  let conn = mustConnect port
  let both = appendBytes (getRequest atprotoDidPath) (getRequest atprotoDidPath)
  let () = mustSend conn both
  let first = readResponse conn [||]
  let () = match first
    Err message => report "PIPELINE" False "first response: \{message}"
    Ok (s1, _, rest) =>
      let second = readResponse conn rest
      match second
        Err message => report "PIPELINE" False "second response: \{message}"
        Ok (s2, _, _) =>
          report
            "PIPELINE"
            (s1 == 200 && s2 == 200)
            "statuses \{intToString s1}, \{intToString s2}"
  ignoreResult (close conn)

runKeepalive : Int -> <IO, Net "_"> Unit
runKeepalive port =
  let conn = mustConnect port
  let () = mustSend conn (getRequest atprotoDidPath)
  let first = readResponse conn [||]
  let () = match first
    Err message => report "KEEPALIVE" False "first response: \{message}"
    Ok (s1, _, rest) =>
      let () = mustSend conn (getRequest atprotoDidPath)
      let second = readResponse conn rest
      match second
        Err message => report "KEEPALIVE" False "second response: \{message}"
        Ok (s2, _, _) =>
          report
            "KEEPALIVE"
            (s1 == 200 && s2 == 200)
            "two requests over one connection: \{intToString s1}, \{intToString s2}"
  ignoreResult (close conn)

runChunked : Int ->
  String ->
  String ->
  String ->
  String ->
  String ->
  <IO, Net "_"> Unit
runChunked port token did collection rkey text =
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (chunkedPostRequest
        token
        createRecordPath
        (createRecordJson did collection rkey text))
  let result = readResponse conn [||]
  let () = expectStatus "CHUNKED" 200 result
  let () = match result
    Ok (_, body, _) =>
      let bodyText = fromUtf8 body
      if contains "\"uri\"" bodyText then
        ()
      else
        report "CHUNKED" False "response body missing 'uri': \{bodyText}"
    Err _ => ()
  ignoreResult (close conn)

{- | The verdict every case that grades CORS shares: the status wanted, the
   one header every response of this server carries, and the absence of the
   credentialed form — `Access-Control-Allow-Credentials` and `origin: *` are
   mutually exclusive in the CORS spec and this server never issues the
   credentialed one, so a case that only checked for the allow-origin header
   would pass a response carrying both. -}
corsVerdict : String -> Int -> Int -> String -> <IO> Unit
corsVerdict label want got headerText =
  if got /= want then
    report
      label
      False
      "want status \{intToString want}, got \{intToString got}: \{headerText}"
  else if not (contains "access-control-allow-origin: *" headerText) then
    report label False "missing allow-origin header: \{headerText}"
  else if contains "access-control-allow-credentials" headerText then
    report label False "answered with allow-credentials: \{headerText}"
  else
    report label True "status=\{intToString got}"

-- Graded on the allow-origin header as well as the status: this answer comes
-- from `lib.server_core`'s `handleBytes` Err arm, which never reaches `handle`
-- and so is not one of the exits that gets the header for free.
runMalformed : Int -> <IO, Net "_"> Unit
runMalformed port =
  let conn = mustConnect port
  let () = mustSend conn (toUtf8 "THIS IS NOT AN HTTP REQUEST\r\n\r\n")
  let result = readHeaderResponse conn [||]
  let () = match result
    Err message => report "MALFORMED" False message
    Ok (status, headerText, _, _) =>
      corsVerdict "MALFORMED" 400 status headerText
  ignoreResult (close conn)

overcapFillerBytes : Int
overcapFillerBytes = 6400000

runOvercap : Int -> <IO, Net "_"> Unit
runOvercap port =
  let conn = mustConnect port
  let filler = arrayMakeWith overcapFillerBytes (_ => 65)
  let request =
    appendBytes
      (toUtf8
        "POST /xrpc/com.atproto.repo.createRecord HTTP/1.1\r\n\{hostHeader}Content-Type: application/json\r\nContent-Length: \{intToString overcapFillerBytes}\r\n\r\n")
      filler
  -- The server may close its read side as soon as the buffered request passes
  -- the cap, which can break this multi-megabyte write before the 413 it has
  -- already decided on can be read back. That closure IS the rejection, so it
  -- counts as one. What does not count: any status other than 413, or a server
  -- that accepted the whole over-cap body and then answered nothing.
  --
  -- When a 413 IS read back it is graded on the allow-origin header too: this
  -- is the other `handleBytes` Err arm, and it reaches no `handle` exit either.
  let sent = sendAll conn request
  let result = readHeaderResponse conn [||]
  let () = match result
    Ok (got, headerText, _, _) => corsVerdict "OVERCAP" 413 got headerText
    Err message => match sent
      Err sendMessage =>
        report
          "OVERCAP"
          True
          "connection closed mid-send, rejecting the over-cap body (send: \{sendMessage}; read: \{message})"
      Ok () =>
        report
          "OVERCAP"
          False
          "whole over-cap body was accepted and no response followed: \{message}"
  ignoreResult (close conn)

idleWaitCeiling : Duration
idleWaitCeiling = seconds 40

runIdle : Int -> <IO, Net "_", Clock> Unit
runIdle port =
  let conn = mustConnect port
  let _ = setTimeout conn idleWaitCeiling
  let t0 = monotonic ()
  let result = recv conn 1
  let elapsed = elapsedSince t0
  let () = match result
    Ok bytes =>
      report
        "IDLE"
        (arrayLength bytes == 0)
        "server closed after \{floatToString elapsed}s (\{intToString (arrayLength bytes)} bytes)"
    Err message =>
      report
        "IDLE"
        False
        "recv error after \{floatToString elapsed}s: \{message}"
  ignoreResult (close conn)

-- | Drive one route on a connection of its own and require `want`.
checkRoute : String -> Int -> Int -> Array Int -> <IO, Net "_"> Unit
checkRoute label port want request =
  let conn = mustConnect port
  let () = mustSend conn request
  let () = expectStatus label want (readResponse conn [||])
  ignoreResult (close conn)

{- | The endpoints the other cases do not already drive, so that all eleven
   XRPC NSIDs and both well-knowns are proven by this gate rather than by
   reading the routing table. `createRecord` is CHUNKED's, `getRecord` is
   RESUME's, and `/.well-known/atproto-did` is QUERY's; the rest are here.

   `listRepos`/`getRepoStatus` run here rather than in a case of their own
   because this is the first point in the gate where the hosted repository
   has a commit (case 4's chunked write) — the repository-free shape of both
   is already covered by `read_routes_all_engines.sh`'s cells, so what this
   gate adds is the repo-bearing shape neither engine harness can produce.

   `putRecord` and `deleteRecord` do mutate, so they work on a scratch record
   key of their own and the delete puts the repository back — RESUME reads the
   fixture record after a process restart and must still find it. -}
runEndpoints : Int ->
  String ->
  String ->
  String ->
  String ->
  String ->
  <IO, Net "_"> Unit
runEndpoints port token did handle collection rkey =
  let scratch = "\{rkey}scratch"
  let () =
    checkRoute
      "LISTRECORDS"
      port
      200
      (getRequest
        "\{xrpcPath "com.atproto.repo.listRecords"}?repo=\{did}&collection=\{collection}")
  let () =
    checkRoute
      "DESCRIBEREPO"
      port
      200
      (getRequest "\{xrpcPath "com.atproto.repo.describeRepo"}?repo=\{did}")
  let () =
    checkRoute
      "GETREPO"
      port
      200
      (getRequest "\{xrpcPath "com.atproto.sync.getRepo"}?did=\{did}")
  let () =
    checkRoute
      "GETLATESTCOMMIT"
      port
      200
      (getRequest "\{xrpcPath "com.atproto.sync.getLatestCommit"}?did=\{did}")
  let () =
    checkRoute
      "RESOLVEHANDLE"
      port
      200
      (getRequest
        "\{xrpcPath "com.atproto.identity.resolveHandle"}?handle=\{handle}")
  let () =
    checkRoute
      "LISTREPOS"
      port
      200
      (getRequest (xrpcPath "com.atproto.sync.listRepos"))
  let () =
    checkRoute
      "GETREPOSTATUS"
      port
      200
      (getRequest "\{xrpcPath "com.atproto.sync.getRepoStatus"}?did=\{did}")
  let () = checkRoute "DIDJSON" port 200 (getRequest didJsonPath)
  let () =
    checkRoute
      "PUTRECORD"
      port
      200
      (postRequest
        token
        (xrpcPath "com.atproto.repo.putRecord")
        (createRecordJson
          did
          collection
          scratch
          "pds serve_e2e scratch record"))
  checkRoute
    "DELETERECORD"
    port
    200
    (postRequest
      token
      (xrpcPath "com.atproto.repo.deleteRecord")
      (deleteRecordJson did collection scratch))

runResume : Int -> String -> String -> String -> String -> <IO, Net "_"> Unit
runResume port did collection rkey text =
  let conn = mustConnect port
  let () = mustSend conn (getRequest (getRecordPath did collection rkey))
  let result = readResponse conn [||]
  let () = expectStatus "RESUME" 200 result
  let () = match result
    Ok (_, body, _) =>
      let bodyText = fromUtf8 body
      if contains text bodyText then
        ()
      else
        report
          "RESUME"
          False
          "resumed record body missing fixture text: \{bodyText}"
    Err _ => ()
  ignoreResult (close conn)

{- | An unauthenticated write over the real socket must be refused 401 by the
   composition seam, and the body must carry atproto's `AuthenticationRequired`
   error code rather than whatever the handler would have said. This is the
   running-server half of `pds/test/auth_seam_test.mdk`'s in-process cells. -}
runUnauthorized : Int -> String -> String -> String -> <IO, Net "_"> Unit
runUnauthorized port did collection rkey =
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (postRequest
        ""
        createRecordPath
        (createRecordJson did collection rkey "unauthenticated write attempt"))
  let result = readResponse conn [||]
  let () = expectStatus "UNAUTHORIZED" 401 result
  let () = match result
    Ok (_, body, _) =>
      let bodyText = fromUtf8 body
      if contains "\"AuthenticationRequired\"" bodyText then
        ()
      else
        report
          "UNAUTHORIZED"
          False
          "refusal body is not AuthenticationRequired: \{bodyText}"
    Err _ => ()
  ignoreResult (close conn)

{- | Logs in and prints the pair `com.atproto.server.createSession` issued,
   access token first, separated by a space, so the shell gate can hand each to
   the case that needs it.

   This is the ONLY way this gate obtains a token: there is no direct-mint
   path any more. A token minted beside the server rather than by it would
   verify its signature and nothing else — no session would be open for it, so
   the seam would refuse it — and the login path is what the gate is here to
   prove. -}
runLogin : Int -> String -> String -> <IO, Net "_"> Unit
runLogin port identifier password =
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (postRequest "" createSessionPath (createSessionJson identifier password))
  let out = match readResponse conn [||]
    Err message => panic "serve_client: createSession failed: \{message}"
    Ok (200, body, _) =>
      "\{stringField "accessJwt" body} \{stringField "refreshJwt" body}"
    Ok (status, body, _) =>
      panic
        "serve_client: createSession answered \{intToString status}: \{fromUtf8 body}"
  let () = println out
  ignoreResult (close conn)

-- | A login that must be REFUSED, and with atproto's own code for it.
runLoginRefused : Int -> String -> String -> <IO, Net "_"> Unit
runLoginRefused port identifier password =
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (postRequest "" createSessionPath (createSessionJson identifier password))
  let result = readResponse conn [||]
  let () = expectStatus "LOGINREFUSED" 401 result
  let () = match result
    Ok (_, body, _) =>
      let bodyText = fromUtf8 body
      if contains "\"AuthenticationRequired\"" bodyText then
        ()
      else
        report
          "LOGINREFUSED"
          False
          "refusal body is not AuthenticationRequired: \{bodyText}"
    Err _ => ()
  ignoreResult (close conn)

{- | Rotates the presented refresh token and prints the pair that replaced it.
   `refreshSession` is a `RefreshRoute`, so the REFRESH token is what its
   `Authorization` header carries — an access token there is refused. -}
runRefresh : Int -> String -> <IO, Net "_"> Unit
runRefresh port refreshToken =
  let conn = mustConnect port
  let () = mustSend conn (postNoInputRequest refreshToken refreshSessionPath)
  let out = match readResponse conn [||]
    Err message => panic "serve_client: refreshSession failed: \{message}"
    Ok (200, body, _) =>
      "\{stringField "accessJwt" body} \{stringField "refreshJwt" body}"
    Ok (status, body, _) =>
      panic
        "serve_client: refreshSession answered \{intToString status}: \{fromUtf8 body}"
  let () = println out
  ignoreResult (close conn)

-- | A refresh that must be REFUSED — a token already consumed by a rotation,
-- or one belonging to a session that has been closed.
runRefreshRefused : Int -> String -> <IO, Net "_"> Unit
runRefreshRefused port refreshToken =
  let conn = mustConnect port
  let () = mustSend conn (postNoInputRequest refreshToken refreshSessionPath)
  let () = expectStatus "REFRESHREFUSED" 401 (readResponse conn [||])
  ignoreResult (close conn)

-- | Closes the session the presented refresh token belongs to.
runLogout : Int -> String -> <IO, Net "_"> Unit
runLogout port refreshToken =
  let conn = mustConnect port
  let () = mustSend conn (postNoInputRequest refreshToken deleteSessionPath)
  let () = expectStatus "LOGOUT" 200 (readResponse conn [||])
  ignoreResult (close conn)

-- | `getSession` reports the account the presented ACCESS token belongs to.
runGetSession : Int -> String -> String -> <IO, Net "_"> Unit
runGetSession port token did =
  let conn = mustConnect port
  let () = mustSend conn (getRequestWith token getSessionPath)
  let result = readResponse conn [||]
  let () = expectStatus "GETSESSION" 200 result
  let () = match result
    Ok (_, body, _) =>
      if stringField "did" body == did then
        ()
      else
        report "GETSESSION" False "body did not name the hosted DID"
    Err _ => ()
  ignoreResult (close conn)

-- | The one preference item every `put-preferences`/`get-preferences` case
-- in this gate shares, so the round trip through a restart is an exact
-- string comparison rather than a structural one.
preferencesItem : Json
preferencesItem = jObject [
  ("$type", JString "app.bsky.actor.defs#personalDetailsPref"),
  ("birthDate", JString "2000-01-01"),
]

preferencesBodyJson : String
preferencesBodyJson =
  stringify (jObject [("preferences", jArray [preferencesItem])])

missingTypePreferencesJson : String
missingTypePreferencesJson =
  stringify
    (jObject [
      ("preferences", jArray [jObject [("birthDate", JString "2000-01-01")]]),
    ])

wrongNamespacePreferencesJson : String
wrongNamespacePreferencesJson =
  stringify
    (jObject [
      (
        "preferences",
        jArray [
          jObject [("$type", JString "com.atproto.server.describeServer")],
        ],
      ),
    ])

-- | `app.bsky.actor.putPreferences` with the one shared fixture item,
-- required to answer `want`.
runPutPreferences : Int -> String -> Int -> <IO, Net "_"> Unit
runPutPreferences port token want =
  let conn = mustConnect port
  let () =
    mustSend conn (postRequest token putPreferencesPath preferencesBodyJson)
  let () =
    expectStatus "PUTPREFS\{intToString want}" want (readResponse conn [||])
  ignoreResult (close conn)

-- | The same call, graded on the allow-origin header instead of the body —
-- used for the persist-failure 500 path, the other response
-- `lib.server_core`'s `handle` never sees.
runPutPreferencesCors : Int -> String -> Int -> <IO, Net "_"> Unit
runPutPreferencesCors port token want =
  let conn = mustConnect port
  let () =
    mustSend conn (postRequest token putPreferencesPath preferencesBodyJson)
  let result = readHeaderResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report "PUTPREFSCORS" False message
    Ok (status, headerText, _, _) =>
      corsVerdict "PUTPREFSCORS" want status headerText

{- | A `putPreferences` body this server must refuse 400: either an item with
   no `$type` at all, or one whose `$type` names a namespace other than
   `app.bsky`. -}
runPutPreferencesInvalid : Int -> String -> String -> <IO, Net "_"> Unit
runPutPreferencesInvalid port token kind =
  let body =
    if kind == "missing-type" then
      missingTypePreferencesJson
    else
      wrongNamespacePreferencesJson
  let conn = mustConnect port
  let () = mustSend conn (postRequest token putPreferencesPath body)
  let () = expectStatus "PUTPREFSINVALID" 400 (readResponse conn [||])
  ignoreResult (close conn)

-- | `app.bsky.actor.getPreferences`, required to answer with exactly the
-- fixture item `runPutPreferences` last wrote — or, on a fresh account that
-- never called `putPreferences`, an empty list.
runGetPreferences : Int -> String -> Bool -> <IO, Net "_"> Unit
runGetPreferences port token expectFixture =
  let conn = mustConnect port
  let () = mustSend conn (getRequestWith token getPreferencesPath)
  let result = readResponse conn [||]
  let () = expectStatus "GETPREFS" 200 result
  let wanted =
    if expectFixture then
      preferencesBodyJson
    else
      stringify (jObject [("preferences", jArray [])])
  let () = match result
    Ok (_, body, _) =>
      if fromUtf8 body == wanted then
        ()
      else
        report "GETPREFS" False "unexpected body: \{fromUtf8 body}"
    Err _ => ()
  ignoreResult (close conn)

{- | One `createRecord` with `token`, required to answer `want`.

   With 200 it proves a token WORKS; with 401 it proves one does not, which is
   how a revoked access token is told from a valid one over the real socket. -}
runWriteStatus : Int ->
  String ->
  String ->
  String ->
  String ->
  Int ->
  <IO, Net "_"> Unit
runWriteStatus port token did collection rkey want =
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (postRequest
        token
        createRecordPath
        (createRecordJson did collection rkey "session lifecycle probe"))
  let () = expectStatus "WRITE\{intToString want}" want (readResponse conn [||])
  ignoreResult (close conn)

-- # Rate-limit cases (#2612)
--
-- Every case below drives one `pds/lib/ratelimit.mdk` class to its ceiling
-- from a single identity (an `X-Forwarded-For` value, `xff`) and grades the
-- LAST response of `count` sent: `want` is what the caller expects that one
-- to be — 429 with the `RateLimit-*` headers and `RateLimitExceeded` once
-- the identity's own budget is spent, or the ordinary success status when
-- `count` stays under the ceiling (used to prove a SECOND identity is still
-- served while the first is refused, which is the check that matters).

-- | One request/response round trip over an existing connection, using
-- whatever bytes `readHeaderResponse` already buffered past the previous
-- response.
floodStep : Connection ->
  Array Int ->
  Array Int ->
  <Net "_"> (Int, String, Array Int, Array Int)
floodStep conn pending requestBytes =
  let () = mustSend conn requestBytes
  match readHeaderResponse conn pending
    Ok result => result
    Err message => panic "serve_client: rate-limit case failed: \{message}"

-- | Sends `count` requests one after another over ONE connection — each
-- built from its 1-based index, so a write case can hand every request a
-- distinct record key — and reports only the LAST response, the one that
-- observes the class's ceiling if `count` exceeds it.
floodLoop : Connection ->
  Int ->
  (Int -> Array Int) ->
  <Net "_"> (Int, String, Array Int)
floodLoop conn count buildRequest = floodLoopGo conn count buildRequest 1 [||]

floodLoopGo : Connection ->
  Int ->
  (Int -> Array Int) ->
  Int ->
  Array Int ->
  <Net "_"> (Int, String, Array Int)
floodLoopGo conn count buildRequest i pending =
  let (status, headerText, body, rest) = floodStep conn pending (buildRequest i)
  if i >= count then
    (status, headerText, body)
  else
    floodLoopGo conn count buildRequest (i + 1) rest

-- | The connections-class case needs a NEW connection each time — that class
-- is charged once per connection, on its first request, never on a reused
-- one — so it cannot share `floodLoop`'s single-connection shape.
floodConnections : Int -> String -> Int -> <Net "_"> (Int, String, Array Int)
floodConnections port xff count = floodConnectionsGo port xff count 1

floodConnectionsGo : Int ->
  String ->
  Int ->
  Int ->
  <Net "_"> (Int, String, Array Int)
floodConnectionsGo port xff count i =
  let conn = mustConnect port
  let (status, headerText, body, _) =
    floodStep conn [||] (getRequestXff xff atprotoDidPath)
  let () = ignoreResult (close conn)
  if i >= count then
    (status, headerText, body)
  else
    floodConnectionsGo port xff count (i + 1)

-- | Grades one rate-limit case's last response against `want`. A 429 must
-- also carry all three `RateLimit-*` headers and the `RateLimitExceeded`
-- error name; any other expected status is graded on the status alone,
-- since that is what a second, still-served identity actually gets back.
reportRateLimit : String -> Int -> Int -> String -> Array Int -> <IO> Unit
reportRateLimit label want status headerText body =
  if status /= want then
    report
      label
      False
      "want status \{intToString want}, got \{intToString status}"
  else if want == 429 then
    let bodyText = fromUtf8 body
    let headersPresent =
      contains "ratelimit-limit:" headerText
        && contains "ratelimit-remaining:" headerText
        && contains "ratelimit-reset:" headerText
    if headersPresent && contains "\"RateLimitExceeded\"" bodyText then
      report label True ""
    else
      report
        label
        False
        "429 missing RateLimit-* headers or RateLimitExceeded body: \{headerText}"
  else
    report label True ""

runRateLimitConn : Int -> String -> Int -> Int -> <IO, Net "_"> Unit
runRateLimitConn port xff count want =
  let (status, headerText, body) = floodConnections port xff count
  reportRateLimit "RLCONN" want status headerText body

runRateLimitReq : Int -> String -> Int -> Int -> <IO, Net "_"> Unit
runRateLimitReq port xff count want =
  let conn = mustConnect port
  let (status, headerText, body) =
    floodLoop conn count (_ => getRequestXff xff atprotoDidPath)
  let () = ignoreResult (close conn)
  reportRateLimit "RLREQ" want status headerText body

-- | `com.atproto.sync.getRepo` has its own ceiling because one call's response
-- is a whole-repository CAR, bounded by `maxCarBytes` and not by any count of
-- requests. Driven over ONE connection so the flood observes that ceiling
-- rather than the far lower per-connection one.
runRateLimitRepo : Int -> String -> Int -> Int -> String -> <IO, Net "_"> Unit
runRateLimitRepo port xff count want did =
  let conn = mustConnect port
  let (status, headerText, body) =
    floodLoop conn count (_ => getRequestXff xff (getRepoPath did))
  let () = ignoreResult (close conn)
  reportRateLimit "RLREPO" want status headerText body

{- | A request that is answered 400 but never routed, in one of two shapes: it
   frames and fails to PARSE (`framed`), or no framer can complete it at all
   (`unframed`). Both are work the server performs for an unidentifiable
   caller, so both are charged.

   Each goes on a fresh connection because neither response is keep-alive:
   the server closes after answering a request it could not parse. -}
malformedRequest : String -> Array Int
malformedRequest "framed" =
  toUtf8 "GET /xrpc/x HTTP/1.1\r\n\{hostHeader}Content-Length: abc\r\n\r\n"
malformedRequest "unframed" = toUtf8 "THIS IS NOT AN HTTP REQUEST\r\n\r\n"
malformedRequest shape = panic "serve_client: unknown malformed shape \{shape}"

floodMalformed : Int -> String -> Int -> <Net "_"> (Int, String, Array Int)
floodMalformed port shape count = floodMalformedGo port shape count 1

floodMalformedGo : Int ->
  String ->
  Int ->
  Int ->
  <Net "_"> (Int, String, Array Int)
floodMalformedGo port shape count i =
  let conn = mustConnect port
  let (status, headerText, body, _) =
    floodStep conn [||] (malformedRequest shape)
  let () = ignoreResult (close conn)
  if i >= count then
    (status, headerText, body)
  else
    floodMalformedGo port shape count (i + 1)

runRateLimitMalformed : Int -> String -> Int -> Int -> <IO, Net "_"> Unit
runRateLimitMalformed port shape count want =
  let (status, headerText, body) = floodMalformed port shape count
  reportRateLimit "RLMALFORMED" want status headerText body

-- | `rkeyPrefix` keeps two identities' record keys from colliding when both
-- run against the same collection in the same gate: the rate limiter charges
-- a write's class before `applyRequest` ever sees it, but the record key
-- still has to be one `createRecord` accepts as new.
runRateLimitWrite : Int ->
  String ->
  Int ->
  Int ->
  String ->
  String ->
  String ->
  String ->
  <IO, Net "_"> Unit
runRateLimitWrite port xff count want token did collection rkeyPrefix =
  let conn = mustConnect port
  let (status, headerText, body) = floodLoop conn count (i =>
    postRequestXff
      xff
      token
      createRecordPath
      (createRecordJson
        did
        collection
        "\{rkeyPrefix}-\{intToString i}"
        "rate limit probe"))
  let () = ignoreResult (close conn)
  reportRateLimit "RLWRITE" want status headerText body

runRateLimitSession : Int ->
  String ->
  Int ->
  Int ->
  String ->
  String ->
  <IO, Net "_"> Unit
runRateLimitSession port xff count want identifier password =
  let conn = mustConnect port
  let (status, headerText, body) = floodLoop conn count (_ =>
    postRequestXff
      xff
      ""
      createSessionPath
      (createSessionJson identifier password))
  let () = ignoreResult (close conn)
  reportRateLimit "RLSESSION" want status headerText body

-- # The un-framed connection census (#2772)

{- | A request whose header section is deliberately never terminated: a
   request line and one unfinished header field, with no `\r\n\r\n` after
   it. It is the cheapest state a caller can hold a connection open in — one
   packet, and then nothing at all, forever. -}
unterminatedHeaders : Array Int
unterminatedHeaders =
  toUtf8 "GET \{atprotoDidPath} HTTP/1.1\r\n\{hostHeader}X-Never-Finished: "

{- | Open `count` connections, send each the same unterminated header
   section, and hand every one of them back still open.

   A send may legitimately fail: past either accept-time ceiling the server
   closes the connection without reading it, which is the behavior under
   test, not an error in the driver. -}
holdUnframed : Int -> Int -> <Net "_"> List Connection
holdUnframed port count = holdUnframedGo port count []

holdUnframedGo : Int -> Int -> List Connection -> <Net "_"> List Connection
holdUnframedGo port count held =
  if count <= 0 then
    held
  else
    let conn = mustConnect port
    let _ = sendAll conn unterminatedHeaders
    holdUnframedGo port (count - 1) (conn :: held)

closeAll : List Connection -> <Net "_"> Unit
closeAll [] = ()
closeAll (conn :: rest) =
  let () = ignoreResult (close conn)
  closeAll rest

-- | How long one probe waits for its own answer, and how long the retry
-- loop pauses between probes. Both are far below the budget the gate hands
-- this case, so a refused probe costs the loop a pause and not a timeout.
probeReadCeiling : Duration
probeReadCeiling = seconds 2

probeInterval : Duration
probeInterval = millis 250

{- | One ordinary request, on a connection of its own. `None` covers every
   way a server under the flood declines to answer — the connect refused, the
   connection closed at accept without a response, or the read timing out —
   because this case grades on being ANSWERED, and those are the same
   non-answer to the caller. -}
probeOnce : Int -> <Net "_"> Option Int
probeOnce port = match connect "127.0.0.1" port
  Err _ => None
  Ok conn =>
    let _ = setTimeout conn probeReadCeiling
    let _ = sendAll conn (getRequest atprotoDidPath)
    let result = readResponse conn [||]
    let () = ignoreResult (close conn)
    match result
      Ok (status, _, _) => Some status
      Err _ => None

-- | Probe until one attempt is answered or `budgetSeconds` have passed since
-- `t0`, reporting the status and how long it took.
probeWithin : Int -> Float -> Int -> <Net "_", Clock> Option (Int, Float)
probeWithin port t0 budgetSeconds = match probeOnce port
  Some status => Some (status, elapsedSince t0)
  None =>
    if elapsedSince t0 >= intToFloat budgetSeconds then
      None
    else
      let () = sleep probeInterval
      probeWithin port t0 budgetSeconds

{- | #2772: a stranger holds `sockets` connections open having never
   terminated a header, and an unrelated caller must still be ANSWERED —
   given a real HTTP response, not a closed socket and not a hang.

   The caller retries rather than probing once, and that is the claim, not a
   weakening of it: a connection that has produced no request occupies a
   budget of its own, bounded in count and in time, so the flood's grip is
   bounded by the header budget rather than by what a whole request is
   allowed. The budget the gate passes is what discriminates — it sits above
   the header budget and well below the read and request budgets a
   never-terminated header used to be granted. -}
runUnframedFlood : Int -> Int -> Int -> <IO, Net "_", Clock> Unit
runUnframedFlood port sockets budgetSeconds =
  let held = holdUnframed port sockets
  let t0 = monotonic ()
  let outcome = probeWithin port t0 budgetSeconds
  let () = match outcome
    Some (status, elapsed) =>
      report
        "UNFRAMED"
        (status == 200)
        "\{intToString sockets} un-framed sockets held open; an unrelated caller answered \{intToString status} after \{floatToString elapsed}s"
    None =>
      report
        "UNFRAMED"
        False
        "\{intToString sockets} un-framed sockets held open; no unrelated caller was answered within \{intToString budgetSeconds}s"
  closeAll held

-- # The body-phase stall (#2815)

{- | A request whose header section IS terminated and which declares a body
   that never arrives. `Content-Length` is 1 MiB — comfortably under
   `maxHttpRequestBytes` (6 MiB), so the server admits the frame instead of
   answering 413 and freeing the slot.

   Terminating the headers is the whole point: it leaves the un-framed
   census (`maxUnframedConnections`) that `unframed-flood` above exercises,
   and moves the connection to the body phase, whose budget is
   `bodyProgressTimeout` (5 s) and whose whole-request budget is
   `requestTimeout` (60 s). No dribbling is needed: this shape makes no
   progress at all, which is exactly what the body budget grades. -}
declaredBodyNeverSent : Array Int
declaredBodyNeverSent =
  toUtf8
    "POST \{createSessionPath} HTTP/1.1\r\n\{hostHeader}Content-Type: application/json\r\nContent-Length: 1048576\r\n\r\n"

holdBodyStall : Int -> Int -> <Net "_"> List Connection
holdBodyStall port count = holdBodyStallGo port count []

holdBodyStallGo : Int -> Int -> List Connection -> <Net "_"> List Connection
holdBodyStallGo port count held =
  if count <= 0 then
    held
  else
    let conn = mustConnect port
    let _ = sendAll conn declaredBodyNeverSent
    holdBodyStallGo port (count - 1) (conn :: held)

{- | #2815: a stranger holds `sockets` connections open, each having terminated
   its headers and declared a body it never sends, and an unrelated caller must
   still be ANSWERED.

   This is `unframed-flood`'s claim one phase further on, and it is a separate
   claim because the defenses are different: the header phase is bounded by a
   census (`maxUnframedConnections`) and the body phase by a progress budget
   (`bodyProgressTimeout`), so a fix to either leaves the other exactly as it
   was. A stalled body is charged to nothing — it left the un-framed census
   when its headers terminated — so the only thing that can free its slot is
   the body budget running out.

   The budget the gate passes is what discriminates: it sits above the body
   progress budget and well below the `requestTimeout` a declared-but-unsent
   body would otherwise be granted, so a server that bounds the body phase
   only by the whole request's budget cannot pass it. -}
runBodyStallFlood : Int -> Int -> Int -> <IO, Net "_", Clock> Unit
runBodyStallFlood port sockets budgetSeconds =
  let held = holdBodyStall port sockets
  let t0 = monotonic ()
  let outcome = probeWithin port t0 budgetSeconds
  let () = match outcome
    Some (status, elapsed) =>
      report
        "BODYSTALL"
        (status == 200)
        "\{intToString sockets} stalled-body sockets held open; an unrelated caller answered \{intToString status} after \{floatToString elapsed}s"
    None =>
      report
        "BODYSTALL"
        False
        "\{intToString sockets} stalled-body sockets held open; no unrelated caller was answered within \{intToString budgetSeconds}s"
  closeAll held

-- # The appview proxy (#2912)

{- | A GET asking to be proxied: the same read every other case sends, plus the
   one client-controlled header that names the audience a service credential
   would be minted for.

   `token` is the caller's own access token, and an empty one sends no
   `Authorization` field at all. It is not optional decoration: a forward is
   made on behalf of the logged-in account and carries the ACCOUNT's signature,
   so a proxied read is an `AuthenticatedRoute` like any other and an anonymous
   one is refused 401 before the audience it named is looked at.

   An empty `service` sends no `atproto-proxy` field at all, which is the
   header-ABSENT call: a client that names no audience is forwarded to the one
   this operator configured. It is not the same request as one naming the empty
   string, which names no service DID and is refused for it.

   `xff` identifies the caller to the rate limiter exactly as in the limit cases,
   and an empty one sends no field at all — so the cases that are about proxying
   and the case that is about its ceiling build their requests the same way. -}
proxyHeaderField : String -> String
proxyHeaderField service =
  if service == "" then "" else "atproto-proxy: \{service}\r\n"

proxyRequest : String -> String -> String -> String -> Array Int
proxyRequest xff token service path =
  toUtf8
    "GET \{path} HTTP/1.1\r\n\{hostHeader}\{xffHeader xff}\{authHeader token}\{proxyHeaderField service}\r\n"

{- | The content negotiation a proxied write carries. Fixed here rather than
   passed in: what the gate asserts is that this value reached the upstream,
   and a value the gate also chose could be reported back to it by a PDS that
   forwarded nothing. -}
proxyWriteLanguage : String
proxyWriteLanguage = "de-DE"

{- | A POST asking to be proxied: a body, the two inbound fields a forward
   relays for one, and the audience header.

   The language and the body are the halves a GET cannot exercise. A forward
   that dropped either would still answer this client with the upstream's own
   reply, so neither is gradeable here — they are gradeable at the STUB, which
   logs what it received; what this builder owes is to send them. -}
proxyWriteRequest : String -> String -> String -> String -> Array Int
proxyWriteRequest token service path body =
  toUtf8
    "POST \{path} HTTP/1.1\r\n\{hostHeader}\{authHeader token}\{proxyHeaderField service}accept-language: \{proxyWriteLanguage}\r\ncontent-type: application/json\r\ncontent-length: \{intToString (stringLength body)}\r\n\r\n\{body}"

{- | Drive one proxied write and grade what came back, response FIELDS
   included.

   `field` is text the response header block must contain. It is the only
   assertion in this file that a proxied answer's own fields reached the
   client: the upstream sets `atproto-repo-rev`, nothing on this side of the
   PDS can invent it, and a relay that kept only the body would pass every
   other proxy case here unchanged. -}
runProxyWrite : Int ->
  String ->
  String ->
  String ->
  String ->
  Int ->
  String ->
  String ->
  <IO, Net "_"> Unit
runProxyWrite port token service path body want marker field =
  let conn = mustConnect port
  let () = mustSend conn (proxyWriteRequest token service path body)
  let result = readHeaderResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report "PROXYWRITE" False message
    Ok (status, headerText, responseBody, _) =>
      let bodyText = fromUtf8 responseBody
      if status /= want then
        report
          "PROXYWRITE"
          False
          "want status \{intToString want}, got \{intToString status}: \{bodyText}"
      else if marker /= "" && not (contains marker bodyText) then
        report "PROXYWRITE" False "body did not carry '\{marker}': \{bodyText}"
      else if field /= "" && not (contains field headerText) then
        report
          "PROXYWRITE"
          False
          "response fields did not carry '\{field}': \{headerText}"
      else
        report "PROXYWRITE" True "status=\{intToString status}"

{- | Drive one proxied read and grade what came back.

   `marker` is text the body must contain, or empty to grade the status alone.
   For a read the server forwarded it is the stub appview's own echo of the
   credential's `aud` and `lxm` — which is what lets this case assert, from the
   CLIENT's side of the PDS and with access to neither the token nor the stub's
   log, that the audience and method a credential was minted for are the ones
   the header asked for. For a refusal it is the refusal's own message, which is
   what tells a refused AUDIENCE apart from a refused METHOD: both are 400
   `InvalidRequest`, and a case graded on the status alone could not tell which
   defense fired or whether either did. -}
runProxyRead : Int ->
  String ->
  String ->
  String ->
  Int ->
  String ->
  <IO, Net "_"> Unit
runProxyRead port token service path want marker =
  let conn = mustConnect port
  let () = mustSend conn (proxyRequest "" token service path)
  let result = readResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report "PROXYREAD" False message
    Ok (status, body, _) =>
      let bodyText = fromUtf8 body
      if status /= want then
        report
          "PROXYREAD"
          False
          "want status \{intToString want}, got \{intToString status}: \{bodyText}"
      else if marker /= "" && not (contains marker bodyText) then
        report "PROXYREAD" False "body did not carry '\{marker}': \{bodyText}"
      else
        report "PROXYREAD" True "status=\{intToString status}"

-- | The same proxied read, graded on the allow-origin header instead of the
-- body — the one response `lib.server_core`'s `handle` never sees, so it is
-- the exit that most needs its own check that the header still reaches it.
runProxyReadCors : Int ->
  String ->
  String ->
  String ->
  Int ->
  <IO, Net "_"> Unit
runProxyReadCors port token service path want =
  let conn = mustConnect port
  let () = mustSend conn (proxyRequest "" token service path)
  let result = readHeaderResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report "PROXYREADCORS" False message
    Ok (status, headerText, _, _) =>
      corsVerdict "PROXYREADCORS" want status headerText

{- | The `Access-Control-Request-Headers` value a preflight case sends, named
   rather than passed as text: two of the four shapes are a single byte the
   inbound parser accepts and the outbound serializer refuses, and a raw TAB
   or a raw high byte does not survive a trip through `sh` argv legibly.

   `tab` is byte 9 and `high` is byte 195 — both admitted by `http`'s
   `validFieldValue` (which takes TAB and everything above 127) and both
   refused by `validResponseValue` (`32..126`), which is the exact gap that
   used to panic `lib.cors` and take the whole server process with it. -}
requestedHeadersBytes : String -> Array Int
requestedHeadersBytes "none" = [||]
requestedHeadersBytes "tab" = concat [|toUtf8 "a", [|9|], toUtf8 "b"|]
requestedHeadersBytes "high" = concat [|toUtf8 "a", [|195|], toUtf8 "b"|]
requestedHeadersBytes named = toUtf8 named

-- | An `OPTIONS` preflight, with the named `Access-Control-Request-Headers`
-- value or none at all when the name is `none`.
preflightRequest : String -> String -> Array Int
preflightRequest path named =
  let value = requestedHeadersBytes named
  if arrayLength value == 0 then
    toUtf8 "OPTIONS \{path} HTTP/1.1\r\n\{hostHeader}\r\n"
  else
    concat [|
      toUtf8 "OPTIONS \{path} HTTP/1.1\r\n\{hostHeader}",
      toUtf8 "Access-Control-Request-Headers: ",
      value,
      toUtf8 "\r\n\r\n",
    |]

-- | The five headers `cors@2.8.6`'s defaults produce, minus the one whose
-- value this case is asserting itself.
preflightHeaderFields : List String
preflightHeaderFields = [
  "access-control-allow-origin: *",
  "access-control-allow-methods: GET,HEAD,PUT,PATCH,POST,DELETE",
  "vary: Access-Control-Request-Headers",
  "access-control-max-age: 86400",
]

-- | The `Access-Control-Allow-Headers` value a case expects, with `-` naming
-- the empty one: `sh` argv can carry an empty word, but a case list reads far
-- worse when the interesting value is invisible.
wantedAllowHeaders : String -> String
wantedAllowHeaders "-" = ""
wantedAllowHeaders value = value

missingField : String -> List String -> Option String
missingField _ [] = None
missingField headerText (field :: rest) =
  if contains field headerText then missingField headerText rest else Some field

{- | A CORS preflight over the real socket, graded on the status, the five
   answer headers, and the exact `Access-Control-Allow-Headers` value.

   `wantAllowed` is the value the answer must carry, with `-` standing for the
   empty one — which is what a client that asked for nothing gets, and also
   what a client that asked with bytes this server cannot repeat gets. The
   value is asserted rather than merely present: a preflight that answered 204
   while echoing an attacker's bytes back verbatim would pass a presence check
   and is the shape that used to crash the process.

   This runs against the LIVE shell, not `handleBytes`, because the ordering
   under test is the shell's: `pds/shell/server.mdk`'s `respondAt` answers the
   preflight before `upgradeDecision`/`proxyDecisionFor`/
   `serviceAuthDecisionFor`, and an in-process cell calling `handleBytes`
   directly sits below all three and cannot see that ordering at all. -}
runPreflight : Int -> String -> String -> Int -> String -> <IO, Net "_"> Unit
runPreflight port path named want wantAllowed =
  let allowed = wantedAllowHeaders wantAllowed
  let conn = mustConnect port
  let () = mustSend conn (preflightRequest path named)
  let result = readHeaderResponse conn [||]
  let () = ignoreResult (close conn)
  let wantedField = "access-control-allow-headers: \{allowed}\r\n"
  match result
    Err message => report "PREFLIGHT" False message
    Ok (status, headerText, _, _) =>
      -- The read stops AT the blank line, so the last field carries no CRLF of
      -- its own; the needle above ends in one, so restore it before searching.
      let terminated = "\{headerText}\r\n"
      if status /= want then
        report
          "PREFLIGHT"
          False
          "want status \{intToString want}, got \{intToString status}: \{headerText}"
      else if contains "access-control-allow-credentials" headerText then
        report
          "PREFLIGHT"
          False
          "answered with allow-credentials: \{headerText}"
      else if not (contains wantedField terminated) then
        report
          "PREFLIGHT"
          False
          "want allow-headers '\{allowed}': \{headerText}"
      else match missingField headerText preflightHeaderFields
        Some field =>
          report "PREFLIGHT" False "missing '\{field}': \{headerText}"
        None => report "PREFLIGHT" True "status=\{intToString status}"

{- | Any GET, graded on the allow-origin header and the status alone — the
   shape every shell response exit outside `lib.server_core`'s `handle` needs
   asserted, since `handle` is the only thing that appends the header for
   free.

   The label is a parameter because this one shape serves several distinct
   exits (a `getServiceAuth` success, a service-auth refusal, a proxy
   refusal), and a shared label would make a failure name the wrong case. An
   empty `token` sends no `Authorization` header, which is what a refusal case
   needs. -}
runCorsGet : String -> Int -> String -> String -> Int -> <IO, Net "_"> Unit
runCorsGet label port token path want =
  let conn = mustConnect port
  let () = mustSend conn (getRequestWith token path)
  let result = readHeaderResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report label False message
    Ok (status, headerText, _, _) => corsVerdict label want status headerText

{- | Ask this server for a service credential, then SPEND it on the service it
   was minted for.

   Two connections and two claims. The first is that
   `com.atproto.server.getServiceAuth` answers a token at all for an audience
   this operator configured. The second is that what came back is a real
   service-auth credential a PEER can read: the stub decodes the bearer it is
   handed and echoes the `aud` and `lxm` it found, so those two values come from
   the token's own bytes rather than from anything this client said about them.

   The minted token is printed in the PASS line because the gate then greps the
   SERVER's stderr for that exact text: a credential that reached a log is a
   credential that leaked, and only the party that received it can say what text
   to look for. -}
runServiceAuth : Int -> String -> String -> String -> Int -> <IO, Net "_"> Unit
runServiceAuth port token audience nsid stubPort =
  let path =
    xrpcPath "com.atproto.server.getServiceAuth?aud=\{audience}&lxm=\{nsid}"
  let conn = mustConnect port
  let () = mustSend conn (getRequestWith token path)
  let result = readResponse conn [||]
  let () = ignoreResult (close conn)
  match result
    Err message => report "SERVICEAUTH" False message
    Ok (status, body, _) =>
      if status /= 200 then
        report
          "SERVICEAUTH"
          False
          "want status 200, got \{intToString status}: \{fromUtf8 body}"
      else
        let minted = stringField "token" body
        let stub = mustConnect stubPort
        let () = mustSend stub (getRequestWith minted (xrpcPath nsid))
        let echoed = readResponse stub [||]
        let () = ignoreResult (close stub)
        match echoed
          Err message =>
            report "SERVICEAUTH" False "the service did not answer: \{message}"
          Ok (echoStatus, echoBody, _) =>
            let echoText = fromUtf8 echoBody
            if not (contains "\"aud\":\"\{audience}\"" echoText)
              || not (contains "\"lxm\":\"\{nsid}\"" echoText) then
              report
                "SERVICEAUTH"
                False
                "the service read back \{echoText} (status \{intToString echoStatus})"
            else
              report "SERVICEAUTH" True "token=\{minted}"

{- | The proxied-read class, driven over ONE connection.

   One connection for the reason the repo-export case uses one: the connections
   class is charged once per connection and its ceiling is far lower than this
   one, so a connection-per-request flood would observe that ceiling instead and
   the case would pass without ever reaching the class it names. -}
runProxyFlood : Int ->
  String ->
  String ->
  String ->
  String ->
  Int ->
  Int ->
  <IO, Net "_"> Unit
runProxyFlood port xff token service path count want =
  let conn = mustConnect port
  let (status, headerText, body) =
    floodLoop conn count (_ => proxyRequest xff token service path)
  let () = ignoreResult (close conn)
  reportRateLimit "RLPROXY" want status headerText body

usage : String
usage =
  "usage: serve_client_main <query|pipeline|keepalive|chunked|endpoints|malformed|overcap|idle|unframed-flood|body-stall-flood|slow-upload|resume|unauthorized|login|login-refused|refresh|refresh-refused|logout|get-session|write|proxy-read|proxy-read-cors|put-preferences-cors|preflight|cors-get|proxy-write|service-auth|rl-conn|rl-req|rl-write|rl-session|rl-repo|rl-proxy|rl-malformed> ..."

main : <IO, Env, Net "_", Clock> Unit
main = match args ()
  ["query", port, did] => runQuery (mustPort port) did
  ["pipeline", port] => runPipeline (mustPort port)
  ["keepalive", port] => runKeepalive (mustPort port)
  ["chunked", port, token, did, collection, rkey, text] =>
    runChunked (mustPort port) token did collection rkey text
  ["endpoints", port, token, did, handle, collection, rkey] =>
    runEndpoints (mustPort port) token did handle collection rkey
  ["unauthorized", port, did, collection, rkey] =>
    runUnauthorized (mustPort port) did collection rkey
  ["login", port, identifier, password] =>
    runLogin (mustPort port) identifier password
  ["login-refused", port, identifier, password] =>
    runLoginRefused (mustPort port) identifier password
  ["refresh", port, token] => runRefresh (mustPort port) token
  ["refresh-refused", port, token] => runRefreshRefused (mustPort port) token
  ["logout", port, token] => runLogout (mustPort port) token
  ["get-session", port, token, did] => runGetSession (mustPort port) token did
  ["put-preferences", port, token, want] =>
    runPutPreferences (mustPort port) token (mustStatus want)
  ["put-preferences-invalid", port, token, kind] =>
    runPutPreferencesInvalid (mustPort port) token kind
  ["get-preferences", port, token, expectFixture] =>
    runGetPreferences (mustPort port) token (expectFixture == "fixture")
  ["write", port, token, did, collection, rkey, want] =>
    runWriteStatus (mustPort port) token did collection rkey (mustStatus want)
  ["malformed", port] => runMalformed (mustPort port)
  ["overcap", port] => runOvercap (mustPort port)
  ["idle", port] => runIdle (mustPort port)
  ["unframed-flood", port, sockets, budget] =>
    runUnframedFlood (mustPort port) (mustCount sockets) (mustCount budget)
  ["body-stall-flood", port, sockets, budget] =>
    runBodyStallFlood (mustPort port) (mustCount sockets) (mustCount budget)
  ["slow-upload", port, token, mimeType] =>
    runSlowUpload (mustPort port) token mimeType
  ["resume", port, did, collection, rkey, text] =>
    runResume (mustPort port) did collection rkey text
  ["upload-blob", port, token, mimeType, text] =>
    runUploadBlob (mustPort port) token mimeType text
  ["get-blob", port, did, cid, mimeType, text] =>
    runGetBlob (mustPort port) did cid mimeType text
  ["get-blob-not-live", port, did, cid] =>
    runGetBlobNotLive (mustPort port) did cid
  ["repo-digest", port, did] => runRepoDigest (mustPort port) did
  ["get-blob-missing", port, did, cid] =>
    runGetBlobMissing (mustPort port) did cid
  ["rl-conn", port, xff, count, want] =>
    runRateLimitConn (mustPort port) xff (mustCount count) (mustStatus want)
  ["rl-req", port, xff, count, want] =>
    runRateLimitReq (mustPort port) xff (mustCount count) (mustStatus want)
  ["rl-write", port, xff, count, want, token, did, collection, rkeyPrefix] =>
    runRateLimitWrite
      (mustPort port)
      xff
      (mustCount count)
      (mustStatus want)
      token
      did
      collection
      rkeyPrefix
  ["proxy-read", port, token, service, path, want, marker] =>
    runProxyRead (mustPort port) token service path (mustStatus want) marker
  ["proxy-read-cors", port, token, service, path, want] =>
    runProxyReadCors (mustPort port) token service path (mustStatus want)
  ["put-preferences-cors", port, token, want] =>
    runPutPreferencesCors (mustPort port) token (mustStatus want)
  ["preflight", port, path, named, want, wantAllowed] =>
    runPreflight (mustPort port) path named (mustStatus want) wantAllowed
  ["cors-get", label, port, token, path, want] =>
    runCorsGet label (mustPort port) token path (mustStatus want)
  ["service-auth", port, token, audience, nsid, stubPort] =>
    runServiceAuth (mustPort port) token audience nsid (mustPort stubPort)
  ["proxy-write", port, token, service, path, body, want, marker, field] =>
    runProxyWrite
      (mustPort port)
      token
      service
      path
      body
      (mustStatus want)
      marker
      field
  ["rl-proxy", port, xff, token, service, path, count, want] =>
    runProxyFlood
      (mustPort port)
      xff
      token
      service
      path
      (mustCount count)
      (mustStatus want)
  ["rl-repo", port, xff, count, want, did] =>
    runRateLimitRepo (mustPort port) xff (mustCount count) (mustStatus want) did
  ["rl-malformed", port, shape, count, want] =>
    runRateLimitMalformed
      (mustPort port)
      shape
      (mustCount count)
      (mustStatus want)
  ["credential-at", count, password] =>
    runCredentialAt (mustCount count) password
  ["rl-session", port, xff, count, want, identifier, password] =>
    runRateLimitSession
      (mustPort port)
      xff
      (mustCount count)
      (mustStatus want)
      identifier
      password
  _ => panic usage

{- | Print an account credential derived at `count` iterations, in the three
   lines `<data>/credential` holds: the count, the salt, and the derived key.

   This exists so a gate can put a data directory into the state a server
   bootstrapped BEFORE `defaultIterations` moved was in — a state no running
   binary can produce any more, and one that cannot be forged by editing the
   count alone, since the derived key is a function of the count. The salt is
   drawn from `osEntropyBytes`, as a real one is.

   It is the only cell here that touches no socket, and it prints no password:
   what it emits is exactly what the server would have written to disk. -}
runCredentialAt : Int -> String -> <IO, Rand> Unit
runCredentialAt count password =
  match makeCredential (osEntropyBytes saltBytes) count password
    Err message => panic "serve_client: credential-at: \{message}"
    Ok record =>
      let () = println (intToString (credentialIterations record))
      let () = println (Hex.encode (credentialSalt record))
      println (Hex.encode (credentialDigest record))

{- | Upload one blob and print the CID the server content-addressed it to.

   The gate captures that CID and asks for it back after a restart, so an
   upload whose bytes never reached the disk is caught by the READ, not by
   anything this case asserts on its own. -}
runUploadBlob : Int -> String -> String -> String -> <IO, Net "_"> Unit
runUploadBlob port token mimeType text =
  let conn = mustConnect port
  let () =
    mustSend conn (rawPostRequest token uploadBlobPath mimeType (toUtf8 text))
  let out = match readResponse conn [||]
    Err message => panic "serve_client: uploadBlob failed: \{message}"
    Ok (200, body, _) => blobRefCidText body
    Ok (status, body, _) =>
      panic
        "serve_client: uploadBlob answered \{intToString status}: \{fromUtf8 body}"
  let () = println out
  ignoreResult (close conn)

{- | Fetch `com.atproto.sync.getRepo` and print the CAR's byte length and its
   SHA-256 digest, which together name its exact bytes.

   The gate reads that one line from two different servers — one over the
   original `--data` directory and one over a directory restored from a backup
   of it — and requires the two to be equal, which is what "the restored
   server's export byte-matches" means. Printing a digest rather than the CAR
   keeps the comparison a string comparison, exactly as
   `pds/test/store_persistence_main.mdk`'s `summary` does for the same bytes. -}
runRepoDigest : Int -> String -> <IO, Net "_"> Unit
runRepoDigest port did =
  let conn = mustConnect port
  let () = mustSend conn (getRequest (getRepoPath did))
  let out = match readResponse conn [||]
    Err message => panic "serve_client: getRepo failed: \{message}"
    Ok (200, body, _) =>
      "\{intToString (arrayLength body)} \{Hex.encode (sha256 body)}"
    Ok (status, body, _) =>
      panic
        "serve_client: getRepo answered \{intToString status}: \{fromUtf8 body}"
  let () = println out
  ignoreResult (close conn)

-- | A blob body big enough to be a real upload, one fifth of it per piece,
-- and a gap between pieces that is long but well inside the body phase's
-- progress budget. The product of the gap and the piece count is what makes
-- the case discriminating: the upload outlives any fixed body-phase deadline
-- of the budget's own length, while no single gap in it reaches that budget.
slowUploadBytes : Int
slowUploadBytes = 5000000

slowUploadPieces : Int
slowUploadPieces = 5

slowUploadGap : Duration
slowUploadGap = seconds 3

{- | A legitimately slow but PROGRESSING upload, which must still be answered
   200 with the CID its bytes content-address to.

   This is the other half of `body-stall-flood`'s claim and the half a body
   budget can get wrong: the whole upload takes many times the progress budget
   to arrive, so a server that bounded the body phase by a fixed deadline
   instead of by progress would close the connection part way through. The CID
   is computed here, from the bytes this client meant to send, so a body the
   server truncated at one of the gaps cannot pass by answering 200 to a
   shorter blob. -}
runSlowUpload : Int -> String -> String -> <IO, Net "_", Clock> Unit
runSlowUpload port token mimeType =
  let body = arrayMakeWith slowUploadBytes (i => 65 + i % 26)
  let wanted = cidToString (cidForRaw body)
  let conn = mustConnect port
  let () =
    mustSend
      conn
      (toUtf8
        "POST \{uploadBlobPath} HTTP/1.1\r\n\{hostHeader}\{authHeader token}Content-Type: \{mimeType}\r\nContent-Length: \{intToString slowUploadBytes}\r\n\r\n")
  let t0 = monotonic ()
  let () = sendInPieces conn body 0 (slowUploadBytes / slowUploadPieces)
  let elapsed = elapsedSince t0
  let () = match readResponse conn [||]
    Err message =>
      report
        "SLOWUPLOAD"
        False
        "no response after \{floatToString elapsed}s of dribbling: \{message}"
    Ok (status, respBody, _) =>
      let got = if status == 200 then blobRefCidText respBody else "-"
      report
        "SLOWUPLOAD"
        (status == 200 && got == wanted)
        "status \{intToString status}, \{intToString slowUploadBytes} bytes in \{intToString slowUploadPieces} pieces over \{floatToString elapsed}s, CID \{got} (wanted \{wanted})"
  ignoreResult (close conn)

-- | Sends `body` from `offset` onward in `piece`-byte pieces, pausing
-- `slowUploadGap` before every piece after the first.
sendInPieces : Connection -> Array Int -> Int -> Int -> <Net "_", Clock> Unit
sendInPieces conn body offset piece =
  if offset >= arrayLength body then
    ()
  else
    let () = if offset == 0 then () else sleep slowUploadGap
    let () = mustSend conn (sliceClamped offset (offset + piece) body)
    sendInPieces conn body (offset + piece) piece

-- | The `ref.$link` CID of an `uploadBlob` response's `blob` value.
blobRefCidText : Array Int -> String
blobRefCidText body = match parse (fromUtf8 body)
  Err message =>
    panic "serve_client: uploadBlob response is not JSON: \{message}"
  Ok value => match andThen (get "blob" value) (get "ref")
    Some ref => match get "$link" ref
      Some (JString text) => text
      _ =>
        panic
          "serve_client: uploadBlob response has no 'blob.ref.$link': \{fromUtf8 body}"
    None =>
      panic
        "serve_client: uploadBlob response has no 'blob.ref': \{fromUtf8 body}"

{- | Fetch one blob back and grade all three things a restart can lose: the
   status, the DECLARED media type (which content addressing does not carry,
   so only the sidecar on disk can have preserved it), and the bytes. -}
runGetBlob : Int -> String -> String -> String -> String -> <IO, Net "_"> Unit
runGetBlob port did cid mimeType text =
  let conn = mustConnect port
  let () = mustSend conn (getRequest (getBlobPath did cid))
  let () = match readTypedResponse conn [||]
    Err message => report "GETBLOB" False message
    Ok (status, mediaType, body, _) =>
      let bodyText = fromUtf8 body
      report
        "GETBLOB"
        (status == 200 && mediaType == mimeType && bodyText == text)
        "status \{intToString status}, type '\{mediaType}' (wanted '\{mimeType}'), \{intToString (arrayLength body)} byte(s)"
  ignoreResult (close conn)

{- | Fetch a blob back and grade that `getBlob` refuses to serve it as a live
   document under this origin: the response must carry both
   `x-content-type-options: nosniff` and `content-disposition: attachment`,
   whatever the blob's declared MIME type. Response headers are always
   lowercase (`serializeResponse`'s doing), so a plain substring check is
   exact. -}
runGetBlobNotLive : Int -> String -> String -> <IO, Net "_"> Unit
runGetBlobNotLive port did cid =
  let conn = mustConnect port
  let () = mustSend conn (getRequest (getBlobPath did cid))
  let () = match readHeaderResponse conn [||]
    Err message => report "GETBLOBNOTLIVE" False message
    Ok (status, headerText, _, _) =>
      report
        "GETBLOBNOTLIVE"
        (status == 200
          && contains "x-content-type-options: nosniff" headerText
          && contains "content-disposition: attachment" headerText)
        "status \{intToString status}, headers:\n\{headerText}"
  ignoreResult (close conn)

{- | Fetch a blob the server must NOT hold and grade the refusal: a blob whose
   on-disk residue the loader skipped is absent from the store, so the route
   answers `BlobNotFound` rather than serving a partially-recovered blob.

   The refusal is graded by its error NAME and not by its status alone: every
   other refusal this route can produce carries the same 400. -}
runGetBlobMissing : Int -> String -> String -> <IO, Net "_"> Unit
runGetBlobMissing port did cid =
  let conn = mustConnect port
  let () = mustSend conn (getRequest (getBlobPath did cid))
  let result = readResponse conn [||]
  let () = expectStatus "GETBLOBMISSING" 400 result
  let () = match result
    Ok (_, body, _) =>
      let bodyText = fromUtf8 body
      if contains "\"BlobNotFound\"" bodyText then
        ()
      else
        report
          "GETBLOBMISSING"
          False
          "refusal body is not BlobNotFound: \{bodyText}"
    Err _ => ()
  ignoreResult (close conn)

-- | An expected HTTP status, as the shell gate spells it on the command line.
mustStatus : String -> Int
mustStatus text = match toInt text
  Some n => n
  None => panic "serve_client: not a status: \{text}"

mustPort : String -> Int
mustPort text = match toInt text
  Some n => n
  None => panic "serve_client: not a port: \{text}"

-- | A rate-limit case's request count, as the shell gate spells it.
mustCount : String -> Int
mustCount text = match toInt text
  Some n => n
  None => panic "serve_client: not a count: \{text}"
