{- | The composition seam's authentication check (#2604).

   `lib.server_core`'s `handle` refuses an unauthenticated request to a gated
   route BEFORE any handler runs, and lets a public one through with no
   credential at all. Both halves are silent-wrongness paths in opposite
   directions: an open write is a repository anyone can scribble in, and a
   closed read is a repository no client and no relay can mirror.

   Two subjects, deliberately:

   * a SYNTHETIC registry with one gated procedure and one public query, whose
     handler reports the `AuthOutcome` it was handed, so every credential class
     (absent, wrong scheme, duplicated, wrong secret, wrong subject, wrong
     audience, expired, not yet valid, well-formed) can be graded without a
     repository;
   * the REAL `pdsRegistry`, whose classification is read back out of the
     registry itself rather than restated here — a route added later without a
     classification cannot slip past a test that enumerates what is registered.

   The 401 on the real registry is also the proof of ORDER: an unauthenticated
   `createRecord` against an unconfigured store answers `AuthenticationRequired`
   and not the `RepoNotFound` the handler would have produced, so the check
   demonstrably ran first.

   The service-credential cells drive the real registry too: every gated
   route is presented a valid service token minted for that route, and only
   the routes registered `AccessOrServiceRoute` may answer anything but
   `401 InvalidToken`. -}

import bytes as B
import bytes.{Bytes, decodeUtf8, encodeUtf8, fromU8Array}
import u8 as U8
import http.{
  Header,
  makeHeader,
  makeResponse,
  parseRequest,
  Request,
  Response,
  serializeResponse,
}
import hex.{decode}
import json.{Json(..), get, jObject, parse, stringify}
import list.{lookup, sort}
import test.{expectEach, expectEqual, expectNotEqual}
import lib.handlers.{pdsRegistry, pdsServer, serverLinksEmpty}
import lib.hmac_sha256.{hmacSha256FixedKey}
import lib.jws.{b64uEncode}
import lib.jwt.{
  Mint,
  ServiceAuthRequest(..),
  SessionKey,
  mintAccessToken,
  mintRefreshToken,
  mintServiceToken,
  sessionKeyFromBytes,
}
import lib.proxy.{AppviewTable, makeAppviewRoute, makeAppviewTable}
import lib.repo.{repoInitFromKeyBytes}
import lib.server_core.{
  Account,
  AuthOutcome(..),
  Handler,
  ProxyDecision(..),
  RequestContext(..),
  Server,
  ServiceAuthDecision(..),
  accessAudience,
  classifyProxy,
  classifyServiceAuth,
  handleBytes,
  makeAccount,
  makeServer,
  refreshAudience,
  serverDid,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeEmpty,
  storeSessionOpen,
  storeWithRepo,
  storeWithServerSecret,
}
import lib.tid.{tidParse}
import lib.xrpc.{
  AuthPolicy(..),
  Endpoint,
  InputPolicy(..),
  Registry,
  XrpcCall(..),
  endpointAuth,
  endpointInput,
  endpointNsid,
  makeRegistry,
  procedureEndpoint,
  queryEndpoint,
  registryEndpoints,
  serviceAuthRouteNsids,
}
import test.response_support.{bodyText}
import lib.sign.{SecretKey, Sign, secretKeyFromBytes}

-- ── fixtures ────────────────────────────────────────────────────────────────

accountDidText : String
accountDidText = "did:plc:medakaauthseamtest"

accountHostText : String
accountHostText = "pds.example"

{- | A fixed session secret. The seam grades a token against whatever secret
   the `Store` carries, so a fixture secret is the whole point here: entropy
   would only make the tokens below irreproducible. -}
testSecret : Bytes
testSecret = fromU8Array (arrayMakeWith 32 (i => U8.truncate (i * 11 + 5)))

otherSecret : Bytes
otherSecret = fromU8Array (arrayMakeWith 32 (i => U8.truncate (i * 13 + 7)))

testKey : SessionKey
testKey =
  resultOrPanic "auth_seam_test: session key" (sessionKeyFromBytes testSecret)

otherKey : SessionKey
otherKey =
  resultOrPanic "auth_seam_test: session key" (sessionKeyFromBytes otherSecret)

testInstant : Int
testInstant = 1700000000

{- | A fixed nonce. It identifies any token a route mints while serving the
   request; no route in this file's synthetic registry mints one, so the value
   only has to be fixed. -}
testNonce : Bytes
testNonce = fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 17 + 3)))

testContext : RequestContext
testContext =
  RequestContext { nowSeconds = testInstant, nonce = testNonce, login = None }

account : Account
account =
  resultOrPanic
    "auth_seam_test: account setup failed"
    (makeAccount accountDidText "alice.example" accountHostText)

-- ── the synthetic subject ───────────────────────────────────────────────────

gatedNsid : String
gatedNsid = "com.example.gated.write"

openNsid : String
openNsid = "com.example.open.read"

refreshNsid : String
refreshNsid = "com.example.refresh.rotate"

mustEndpoint : Result String Endpoint -> Endpoint
mustEndpoint (Ok endpoint) = endpoint
mustEndpoint (Err message) =
  panic "auth_seam_test: endpoint setup failed: \{message}"

syntheticRegistry : Registry
syntheticRegistry = match makeRegistry [
  mustEndpoint (procedureEndpoint gatedNsid JsonInput AuthenticatedRoute),
  mustEndpoint (queryEndpoint openNsid PublicRoute),
  mustEndpoint (procedureEndpoint refreshNsid NoInput RefreshRoute),
]
  Ok registry => registry
  Err message => panic "auth_seam_test: registry setup failed: \{message}"

mustResponse : String -> Response
mustResponse body =
  resultOrPanic
    "auth_seam_test: response setup failed"
    (makeResponse 200 "OK" [textHeader] (encodeUtf8 body))

textHeader : Header
textHeader =
  resultOrPanic
    "auth_seam_test: header setup failed"
    (makeHeader "content-type" (encodeUtf8 "text/plain"))

{- | Reports the `AuthOutcome` the seam resolved, so a public route reached
   with a good token is distinguishable from one reached with none. Reaching
   this handler at all on the gated route is itself the assertion that the
   credential was accepted. -}
syntheticHandler : Handler <>
syntheticHandler _ Unauthenticated store _ = (store, mustResponse "anonymous")
syntheticHandler _ (Authenticated did _) store _ = (store, mustResponse did)
syntheticHandler _ (ServiceAuthenticated did) store _ =
  (store, mustResponse "service \{did}")

syntheticServer : Server <>
syntheticServer = makeServer account syntheticRegistry syntheticHandler

-- ── stores ──────────────────────────────────────────────────────────────────

{- | A store carrying the session secret and NO open session. Every token below
   verifies against it and none is a credential on it: a good signature inside
   its window is not on its own a session. -}
secretOnlyStore : Store
secretOnlyStore = storeWithServerSecret testKey storeEmpty

-- The same store with `goodToken`/`goodRefreshToken`'s session open, which is
-- what makes those two credentials rather than merely well-formed tokens.
configuredStore : Store
configuredStore =
  storeSessionOpen
    (sessionFingerprint goodToken)
    (sessionFingerprint goodRefreshToken)
    (testInstant + 3600)
    secretOnlyStore

-- ── tokens ──────────────────────────────────────────────────────────────────

tokenFor : SessionKey ->
  String ->
  String ->
  String ->
  Int ->
  Int ->
  <Mint "access"> String
tokenFor key sub aud tokenId from until =
  mintAccessToken key sub aud tokenId from until

goodToken : String
goodToken =
  tokenFor
    testKey
    accountDidText
    accountHostText
    "good"
    (testInstant - 60)
    (testInstant + 3600)

{- | The refresh half of `goodToken`'s session. It differs from `goodToken` in
   audience, which is what stops each being presented as the other. -}
goodRefreshToken : String
goodRefreshToken =
  mintRefreshToken
    testKey
    accountDidText
    (refreshAudience account)
    "good"
    (testInstant - 60)
    (testInstant + 3600)

expiredToken : String
expiredToken =
  tokenFor
    testKey
    accountDidText
    accountHostText
    "expired"
    (testInstant - 3600)
    (testInstant - 1)

futureToken : String
futureToken =
  tokenFor
    testKey
    accountDidText
    accountHostText
    "future"
    (testInstant + 60)
    (testInstant + 3600)

wrongSecretToken : String
wrongSecretToken =
  tokenFor
    otherKey
    accountDidText
    accountHostText
    "wrong-secret"
    (testInstant - 60)
    (testInstant + 3600)

wrongSubjectToken : String
wrongSubjectToken =
  tokenFor
    testKey
    "did:plc:somebodyelseentirely"
    accountHostText
    "wrong-subject"
    (testInstant - 60)
    (testInstant + 3600)

wrongAudienceToken : String
wrongAudienceToken =
  tokenFor
    testKey
    accountDidText
    "other.example"
    "wrong-audience"
    (testInstant - 60)
    (testInstant + 3600)

-- ── request framing ─────────────────────────────────────────────────────────

-- `auth` is spliced verbatim, so a test can send a header this server would
-- never mint (a bare token, a second Authorization line, a wrong scheme).
postRequest : String -> String -> Bytes
postRequest auth nsid = postRequestBytes (encodeUtf8 auth) nsid

-- | As `postRequest`, with `auth` given as raw wire bytes, which need not be
-- UTF-8.
postRequestBytes : Bytes -> String -> Bytes
postRequestBytes auth nsid =
  let body = "{}"
  encodeUtf8 "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n"
    ++ auth
    ++ encodeUtf8
      "Content-Type: application/json\r\nContent-Length: 2\r\n\r\n\{body}"

getRequest : String -> String -> Bytes
getRequest auth target =
  encodeUtf8 "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{auth}\r\n"

{- | A procedure with no input at all, which is the shape a refresh route
   takes. The zero-length `Content-Length` is deliberate and is what a real
   client sends on a bodiless POST: a refresh route reached without it is a
   refresh route reached in a shape no client uses. -}
postNoInputRequest : String -> String -> Bytes
postNoInputRequest auth nsid =
  encodeUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{auth}Content-Length: 0\r\n\r\n"

bearer : String -> String
bearer token = "Authorization: Bearer \{token}\r\n"

-- ── response inspection ─────────────────────────────────────────────────────

-- The three status digits of "HTTP/1.1 NNN Reason".
statusOf : Bytes -> String
statusOf bytes =
  optionOrPanic
    "auth_seam: status code is not UTF-8"
    (decodeUtf8 (B.take 3 (B.drop 9 bytes)))

errorCodeOf : Bytes -> String
errorCodeOf bytes = match parse (bodyText bytes)
  Ok value => match get "error" value
    Some (JString code) => code
    _ => "<no-error-field>"
  Err _ => "<not-json>"

-- | Status and atproto error code as one comparable string.
refusal : Bytes -> String
refusal bytes = "\{statusOf bytes} \{errorCodeOf bytes}"

-- ── the synthetic cells ─────────────────────────────────────────────────────

gatedWith : String -> <Mint {"access", "refresh"}> String
gatedWith auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (postRequest auth gatedNsid)
  refusal bytes

gatedBody : String -> <Mint {"access", "refresh"}> String
gatedBody auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (postRequest auth gatedNsid)
  bodyText bytes

openWith : String -> <Mint {"access", "refresh"}> String
openWith auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (getRequest auth "/xrpc/\{openNsid}")
  bodyText bytes

openStatusWith : String -> <Mint {"access", "refresh"}> String
openStatusWith auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (getRequest auth "/xrpc/\{openNsid}")
  statusOf bytes

test "a gated route with no Authorization header is refused 401" =
  expectEqual (gatedWith "") "401 AuthenticationRequired"

test "a gated route with a well-formed token reaches its handler" =
  expectEqual (gatedBody (bearer goodToken)) accountDidText

test "an expired token is refused as expired, not as absent" =
  expectEqual (gatedWith (bearer expiredToken)) "401 ExpiredToken"

{- A credential that is not UTF-8 is malformed, and is refused before any of
   it is read: its expiry included. The expired token with its first
   character re-spelled as a two-byte overlong (`C0 | c >> 6`, `80 | c & 63`)
   is one a lenient decode reads back as the expired token itself, and so as
   `ExpiredToken`, a claim read out of a token that could not have been
   verified. -}
test "an expired token whose first character is an overlong is an invalid token" =
  let token = encodeUtf8 expiredToken
  let first = optionOrPanic "auth_seam: empty token" (B.get 0 token)
  let firstByte = U8.toInt first
  let overlong = fromU8Array [|
    U8.truncate (0xC0 + firstByte / 64),
    U8.truncate (0x80 + firstByte % 64),
  |]
  let auth =
    encodeUtf8 "Authorization: Bearer "
      ++ overlong
      ++ B.drop 1 token
      ++ encodeUtf8 "\r\n"
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (postRequestBytes auth gatedNsid)
  expectEqual "401 InvalidToken" (refusal bytes)

test "a not-yet-valid token is refused" =
  expectEqual (gatedWith (bearer futureToken)) "401 InvalidToken"

test "a token signed with another secret is refused" =
  expectEqual (gatedWith (bearer wrongSecretToken)) "401 InvalidToken"

test "a token for another subject is refused" =
  expectEqual (gatedWith (bearer wrongSubjectToken)) "401 InvalidToken"

test "a token for another audience is refused" =
  expectEqual (gatedWith (bearer wrongAudienceToken)) "401 InvalidToken"

test "the access audience is this PDS's hostname" =
  expectEqual (accessAudience account) accountHostText

test "the refresh audience is not the access audience" =
  expectNotEqual (refreshAudience account) (accessAudience account)

test "a token presented without the Bearer scheme is refused" =
  expectEqual (gatedWith "Authorization: \{goodToken}\r\n") "401 InvalidToken"

test "a token presented under another scheme is refused" =
  expectEqual
    (gatedWith "Authorization: Basic \{goodToken}\r\n")
    "401 InvalidToken"

test "two Authorization headers are an ambiguous credential, not a credential" =
  expectEqual
    (gatedWith "\{bearer goodToken}\{bearer goodToken}")
    "401 InvalidToken"

test "the Bearer scheme is matched case-insensitively" =
  expectEqual
    (gatedBody "Authorization: bEaReR \{goodToken}\r\n")
    accountDidText

refreshWith : String -> <Mint {"access", "refresh"}> String
refreshWith auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (postNoInputRequest auth refreshNsid)
  refusal bytes

refreshBody : String -> <Mint {"access", "refresh"}> String
refreshBody auth =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      configuredStore
      (postNoInputRequest auth refreshNsid)
  bodyText bytes

{- | The revocation property, at the seam. `goodToken` is inside its window and
   carries a good MAC against the very secret this store holds; it is refused
   anyway, because no open session names it. That is what `deleteSession`
   leaves behind, and what a restart leaves behind for every token at once. -}
test "a token whose session is not open is refused, signature notwithstanding" =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      secretOnlyStore
      (postRequest (bearer goodToken) gatedNsid)
  expectEqual "401 InvalidToken" (refusal bytes)

test "a refresh route reached with the session's refresh token runs" =
  expectEqual (refreshBody (bearer goodRefreshToken)) accountDidText

test "an access token is refused on a refresh route" =
  expectEqual (refreshWith (bearer goodToken)) "401 InvalidToken"

test "a refresh token is refused on an ordinary gated route" =
  expectEqual (gatedWith (bearer goodRefreshToken)) "401 InvalidToken"

test "a refresh route with no Authorization header is refused 401" =
  expectEqual (refreshWith "") "401 AuthenticationRequired"

test "a gated route on a store with no session secret is refused" =
  let (_, bytes) =
    handleBytes
      syntheticServer
      testContext
      storeEmpty
      (postRequest (bearer goodToken) gatedNsid)
  expectEqual "401 InvalidToken" (refusal bytes)

test "a public route answers with no credential at all" = expectEach [
  ("openStatusWith \"\" == \"200\"", expectEqual "200" (openStatusWith "")),
  ("openWith \"\" == \"anonymous\"", expectEqual "anonymous" (openWith "")),
]

test "a public route still answers when a good token IS presented" =
  expectEqual (openWith (bearer goodToken)) accountDidText

test "a public route is not closed by an unusable token" = expectEach [
  (
    "the public route still answers 200",
    expectEqual "200" (openStatusWith (bearer expiredToken)),
  ),
  (
    "the caller is seen as anonymous rather than authenticated",
    expectEqual "anonymous" (openWith (bearer expiredToken)),
  ),
]

-- ── the real registry ───────────────────────────────────────────────────────

pdsServerValue : Server <Mint {"access", "refresh"}, Sign "commit">
pdsServerValue =
  resultOrPanic
    "auth_seam_test: pdsServer setup failed"
    (pdsServer account serverLinksEmpty "test-driver")

realRegistry : Registry
realRegistry =
  resultOrPanic "auth_seam_test: pdsRegistry setup failed" pdsRegistry

nsidsWith : AuthPolicy -> List String
nsidsWith wanted =
  sort
    (map
      endpointNsid
      (filter
        (endpoint => samePolicy (endpointAuth endpoint) wanted)
        (registryEndpoints realRegistry)))

samePolicy : AuthPolicy -> AuthPolicy -> Bool
samePolicy PublicRoute PublicRoute = True
samePolicy AuthenticatedRoute AuthenticatedRoute = True
samePolicy RefreshRoute RefreshRoute = True
samePolicy AccessOrServiceRoute AccessOrServiceRoute = True
samePolicy _ _ = False

{- | The whole route set, read out of the registry rather than restated from
   the diff. A route registered later shows up in exactly one of these three
   lists, so neither an unclassified new write nor a wrongly closed read can
   land without moving one of them. -}
test "exactly the four record writes, updateHandle, getSession, getServiceAuth and the two preferences routes are access-gated" = expectEqual
  (nsidsWith AuthenticatedRoute)
  [
    "app.bsky.actor.getPreferences",
    "app.bsky.actor.putPreferences",
    "com.atproto.identity.updateHandle",
    "com.atproto.repo.applyWrites",
    "com.atproto.repo.createRecord",
    "com.atproto.repo.deleteRecord",
    "com.atproto.repo.putRecord",
    "com.atproto.server.getServiceAuth",
    "com.atproto.server.getSession",
  ]

test "every read, sync and identity query is public, and so is createSession" = expectEqual
  (nsidsWith PublicRoute)
  [
    "com.atproto.identity.resolveHandle",
    "com.atproto.repo.describeRepo",
    "com.atproto.repo.getRecord",
    "com.atproto.repo.listRecords",
    "com.atproto.server.createSession",
    "com.atproto.server.describeServer",
    "com.atproto.sync.getBlob",
    "com.atproto.sync.getBlocks",
    "com.atproto.sync.getLatestCommit",
    "com.atproto.sync.getRecord",
    "com.atproto.sync.getRepo",
    "com.atproto.sync.getRepoStatus",
    "com.atproto.sync.listBlobs",
    "com.atproto.sync.listRepos",
    "com.atproto.sync.subscribeRepos",
  ]

{- | Refreshing and logging out are authenticated by the REFRESH token, which
   is atproto's own classification: a client whose access token has expired can
   still do both, and that is the whole point of holding a refresh token. -}
test "refreshSession and deleteSession take the refresh token" = expectEqual
  (nsidsWith RefreshRoute)
  [
    "com.atproto.server.deleteSession",
    "com.atproto.server.refreshSession",
  ]

test "uploadBlob alone takes an access token or a service credential" =
  expectEqual (nsidsWith AccessOrServiceRoute) ["com.atproto.repo.uploadBlob"]

realPost : String ->
  String ->
  <Mint {"access", "refresh"}, Sign "commit"> String
realPost auth nsid =
  let (_, bytes) =
    handleBytes pdsServerValue testContext storeEmpty (postRequest auth nsid)
  refusal bytes

realGet : String -> <Mint {"access", "refresh"}, Sign "commit"> String
realGet target =
  let (_, bytes) =
    handleBytes pdsServerValue testContext storeEmpty (getRequest "" target)
  statusOf bytes

{- | The order proof. `createRecord` against an unconfigured store would answer
   `400 RepoNotFound` if the handler ran; it answers 401 because the seam
   refuses first. -}
test "an unauthenticated createRecord is refused before the handler runs" =
  expectEqual
    (realPost "" "com.atproto.repo.createRecord")
    "401 AuthenticationRequired"

test "an unauthenticated putRecord is refused" =
  expectEqual
    (realPost "" "com.atproto.repo.putRecord")
    "401 AuthenticationRequired"

test "an unauthenticated deleteRecord is refused" =
  expectEqual
    (realPost "" "com.atproto.repo.deleteRecord")
    "401 AuthenticationRequired"

test "a public read answers without a token" =
  expectEqual
    (realGet "/xrpc/com.atproto.identity.resolveHandle?handle=alice.example")
    "200"

test "a well-known answers without a token" =
  expectEqual (realGet "/.well-known/atproto-did") "200"

test "the did:web document answers without a token" =
  expectEqual (realGet "/.well-known/did.json") "200"

-- ── the health probe ────────────────────────────────────────────────────────

-- `_health` fails NSID syntax, so the registry-derived cases above never reach
-- it; its own arms are graded here, against the real registry.

-- | A request on the wire, through the real registry, as its response bytes.
realWire : Bytes -> <Mint {"access", "refresh"}, Sign "commit"> Bytes
realWire bytes =
  let (_, response) = handleBytes pdsServerValue testContext storeEmpty bytes
  response

-- | A request to `/xrpc/_health` with the given method, extra header lines
-- (each ending in CRLF) and body.
healthRequest : String -> String -> String -> Bytes
healthRequest method headers body =
  encodeUtf8
    "\{method} /xrpc/_health HTTP/1.1\r\nHost: \{accountHostText}\r\n\{headers}\r\n\{body}"

-- | A string field of a JSON response body, or a marker when there is none.
stringFieldOf : String -> Bytes -> String
stringFieldOf name bytes = match parse (bodyText bytes)
  Ok value => match get name value
    Some (JString text) => text
    _ => "<no-\{name}-field>"
  Err _ => "<not-json>"

healthRefusal : Bytes -> String
healthRefusal bytes = "\{statusOf bytes} \{stringFieldOf "message" bytes}"

test "the health probe answers 200 with its version to a bodiless GET" =
  let reply = realWire (healthRequest "GET" "" "")
  expectEach [
    ("status", expectEqual (statusOf reply) "200"),
    ("version", expectEqual (stringFieldOf "version" reply) "test-driver"),
  ]

test "the health probe refuses POST, HEAD and DELETE with 405" = expectEach [
  (
    "POST",
    expectEqual
      (healthRefusal (realWire (healthRequest "POST" "" "")))
      "405 the health probe requires GET",
  ),
  (
    "HEAD",
    expectEqual
      (healthRefusal (realWire (healthRequest "HEAD" "" "")))
      "405 the health probe requires GET",
  ),
  (
    "DELETE",
    expectEqual
      (healthRefusal (realWire (healthRequest "DELETE" "" "")))
      "405 the health probe requires GET",
  ),
]

test "a GET to the health probe with a body is refused 400" =
  expectEqual
    (healthRefusal (realWire (healthRequest "GET" "Content-Length: 1\r\n" "x")))
    "400 the health probe does not accept request body framing"

test "a GET to the health probe declaring a body is refused 400" =
  expectEqual
    (healthRefusal
      (realWire
        (healthRequest "GET" "Transfer-Encoding: chunked\r\n" "0\r\n\r\n")))
    "400 the health probe does not accept request body framing"

-- ── service credentials ─────────────────────────────────────────────────────

uploadBlobNsid : String
uploadBlobNsid = "com.atproto.repo.uploadBlob"

serviceKeyBytes : Bytes
serviceKeyBytes =
  resultOrPanic
    "auth_seam_test: service key bytes"
    (decode "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")

-- The account's repository key: what a service token is signed with, and what
-- the seam verifies one against.
serviceKey : SecretKey
serviceKey =
  resultOrPanic
    "auth_seam_test: service key"
    (secretKeyFromBytes serviceKeyBytes)

{- | An HS256 access token for the account, minted the way `lib.jwt` mints
   one but carrying an `lxm` claim, which `lib.jwt` never mints. Its session
   is open in `serviceStore`, so the claim is the only thing about it that is
   not a good session credential. -}
lxmSessionToken : String
lxmSessionToken =
  let headerSeg = b64uEncode (encodeUtf8 "{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
  let claims = jObject [
    ("sub", JString accountDidText),
    ("aud", JString accountHostText),
    ("jti", JString "lxm"),
    ("iat", JInt (testInstant - 60)),
    ("nbf", JInt (testInstant - 60)),
    ("exp", JInt (testInstant + 3600)),
    ("lxm", JString uploadBlobNsid),
  ]
  let claimsSeg = b64uEncode (encodeUtf8 (stringify claims))
  let signingInput = "\{headerSeg}.\{claimsSeg}"
  let mac = hmacSha256FixedKey testSecret (encodeUtf8 signingInput)
  "\{signingInput}.\{b64uEncode mac}"

-- `configuredStore` with the account's repository, so a service token has a
-- key to verify against, and with `lxmSessionToken`'s session open.
serviceStore : Store
serviceStore =
  let rev =
    resultOrPanic "auth_seam_test: initial revision" (tidParse "3ke6kg3wk222b")
  let repo =
    resultOrPanic
      "auth_seam_test: repository"
      (repoInitFromKeyBytes accountDidText serviceKeyBytes rev)
  storeSessionOpen
    (sessionFingerprint lxmSessionToken)
    (sessionFingerprint "auth_seam_test-lxm-refresh")
    (testInstant + 3600)
    (storeWithRepo repo configuredStore)

-- A valid service token for the account, addressed to this server and
-- limited to `nsid`.
serviceTokenFor : String -> <Sign "service-auth"> String
serviceTokenFor nsid =
  resultOrPanic
    "auth_seam_test: service token"
    (mintServiceToken serviceKey ServiceAuthRequest {
      iss = accountDidText,
      aud = serverDid account,
      lxm = Some nsid,
      jti = "00112233445566778899aabbccddeeff",
      iat = testInstant,
      exp = None,
    })

-- A raw-body POST, the shape `uploadBlob` takes.
postRawRequest : String -> String -> Bytes
postRawRequest auth nsid =
  encodeUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{auth}Content-Type: video/mp4\r\nContent-Length: 3\r\n\r\nmp4"

-- A text-body POST.
postTextRequest : String -> String -> Bytes
postTextRequest auth nsid =
  encodeUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{auth}Content-Type: text/plain\r\nContent-Length: 4\r\n\r\ntext"

{- | A request carrying `auth` that the router admits to `endpoint`, so the
   answer is the seam's and not a routing refusal: a GET for a query, and for
   a procedure a POST with the body its input policy takes. -}
admittedRequest : String -> Endpoint -> Bytes
admittedRequest auth endpoint =
  let nsid = endpointNsid endpoint
  match endpointInput endpoint
    None => getRequest auth "/xrpc/\{nsid}"
    Some JsonInput => postRequest auth nsid
    Some NoInput => postNoInputRequest auth nsid
    Some RawInput => postRawRequest auth nsid
    Some TextInput => postTextRequest auth nsid

serviceWire : Bytes -> <Mint {"access", "refresh"}, Sign "commit"> Bytes
serviceWire bytes =
  let (_, response) = handleBytes pdsServerValue testContext serviceStore bytes
  response

-- Every gated route in the real registry, by NSID.
gatedEndpoints : List Endpoint
gatedEndpoints =
  filter
    (endpoint => not (samePolicy (endpointAuth endpoint) PublicRoute))
    (registryEndpoints realRegistry)

{- | Every gated route, presented a valid service token whose `lxm` is that
   route's own NSID, and what it answered. -}
serviceSweep : <Mint {"access", "refresh"}, Sign {"commit", "service-auth"}> List (String, String)
serviceSweep =
  map
    (endpoint =>
      let nsid = endpointNsid endpoint
      let token = serviceTokenFor nsid
      (nsid, refusal (serviceWire (admittedRequest (bearer token) endpoint))))
    gatedEndpoints

-- The swept routes that answered something other than `401 InvalidToken`.
sweptPastTheSeam : <Mint {"access", "refresh"}, Sign {"commit", "service-auth"}> List String
sweptPastTheSeam =
  map fst (filter ((_, answer) => answer /= "401 InvalidToken") serviceSweep)

{- | The sweep's verdict is written down, not derived from the registry: a
   route re-registered `AccessOrServiceRoute` passes the seam with its own
   service token and fails the first cell, whatever `serviceAuthRouteNsids`
   then says. -}
test "a service token for its own route passes the seam on uploadBlob alone" = expectEach
  [
    (
      "the routes that did not answer 401 InvalidToken",
      expectEqual [uploadBlobNsid] sweptPastTheSeam,
    ),
    (
      "they are the registry's service-auth routes",
      expectEqual (serviceAuthRouteNsids realRegistry) sweptPastTheSeam,
    ),
    (
      "every other gated route was swept and refused",
      expectEqual
        (sort (nsidsWith AuthenticatedRoute ++ nsidsWith RefreshRoute))
        (sort
          (map
            fst
            (filter
              ((_, answer) => answer == "401 InvalidToken")
              serviceSweep))),
    ),
  ]

test "uploadBlob runs its handler for a service token" =
  expectEqual (Some "200 <no-error-field>") (lookup uploadBlobNsid serviceSweep)

test "a service token cannot reach getSession, refreshSession or deleteSession" =
  let sessionRoutes = [
    "com.atproto.server.deleteSession",
    "com.atproto.server.getSession",
    "com.atproto.server.refreshSession",
  ]
  expectEqual
    (map (nsid => (nsid, "401 InvalidToken")) sessionRoutes)
    (sort (filter ((nsid, _) => elem nsid sessionRoutes) serviceSweep))

test "a session token still works on uploadBlob" =
  expectEqual
    "200 <no-error-field>"
    (refusal (serviceWire (postRawRequest (bearer goodToken) uploadBlobNsid)))

test "an HS256 access token carrying an lxm claim is refused on uploadBlob" = expectEach
  [
    (
      "control: it is an open session's access token on getSession",
      expectEqual
        "200 <no-error-field>"
        (refusal
          (serviceWire
            (getRequest
              (bearer lxmSessionToken)
              "/xrpc/com.atproto.server.getSession"))),
    ),
    (
      "on uploadBlob it is read as a service token, and is not one",
      expectEqual
        "401 InvalidToken"
        (refusal
          (serviceWire
            (postRawRequest (bearer lxmSessionToken) uploadBlobNsid))),
    ),
  ]

-- A request parsed for a classifier, which takes a `Request` and not bytes.
parsedRequest : Bytes -> Request
parsedRequest bytes =
  resultOrPanic "auth_seam_test: request setup failed" (parseRequest bytes)

responseRefusal : Response -> String
responseRefusal response = refusal (serializeResponse response)

mintOutcome : ServiceAuthDecision -> String
mintOutcome NotServiceAuth = "not-service-auth"
mintOutcome (ServiceAuthRefused response) = responseRefusal response
mintOutcome (ServiceAuthMinted claims) = "minted lxm=\{debug claims.lxm}"

-- `getServiceAuth` for this server's own DID and `uploadBlob`, carrying `auth`.
mintWith : String -> <Mint {"access", "refresh"}, Sign "commit"> String
mintWith auth =
  let target =
    "/xrpc/com.atproto.server.getServiceAuth?aud=\{serverDid account}&lxm=\{uploadBlobNsid}"
  mintOutcome
    (classifyServiceAuth
      pdsServerValue
      testContext
      None
      serviceStore
      (parsedRequest (getRequest auth target)))

test "a service token cannot mint a service token" = expectEach [
  (
    "control: a session token mints",
    expectEqual
      "minted lxm=Some \"com.atproto.repo.uploadBlob\""
      (mintWith (bearer goodToken)),
  ),
  (
    "a service token for getServiceAuth itself",
    expectEqual
      "401 InvalidToken"
      (mintWith (bearer (serviceTokenFor "com.atproto.server.getServiceAuth"))),
  ),
]

appviewTable : Option AppviewTable
appviewTable =
  let route =
    resultOrPanic
      "auth_seam_test: appview route setup failed"
      (makeAppviewRoute "did:web:api.bsky.app" 2584)
  Some
    (resultOrPanic
      "auth_seam_test: appview table setup failed"
      (makeAppviewTable route []))

proxyOutcome : ProxyDecision -> String
proxyOutcome NotProxied = "not-proxied"
proxyOutcome (ProxyRefused response) = responseRefusal response
proxyOutcome (ProxyAdmitted admission) = "admitted \{admission.nsid}"

timelineNsid : String
timelineNsid = "app.bsky.feed.getTimeline"

-- A proxied `getTimeline` naming the configured appview, carrying `auth`.
proxyWith : String -> <Mint {"access", "refresh"}, Sign "commit"> String
proxyWith auth =
  let headers = "\{auth}atproto-proxy: did:web:api.bsky.app#bsky_appview\r\n"
  proxyOutcome
    (classifyProxy
      pdsServerValue
      testContext
      appviewTable
      serviceStore
      (parsedRequest (getRequest headers "/xrpc/\{timelineNsid}")))

test "a service token cannot be proxied" = expectEach [
  (
    "control: a session token is proxied",
    expectEqual "admitted \{timelineNsid}" (proxyWith (bearer goodToken)),
  ),
  (
    "a service token for the proxied method",
    expectEqual
      "401 InvalidToken"
      (proxyWith (bearer (serviceTokenFor timelineNsid))),
  ),
]
