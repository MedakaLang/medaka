{- | Focused structural XRPC registry, routing, and canonical-error tests. -}

import bytes.{fromArray}
import http.{
  maxJsonBodyBytes,
  maxRawBodyBytes,
  maxTextBodyBytes,
  mediaTypeSubtype,
  mediaTypeType,
  parseRequest,
  QueryParam(..),
  Request,
  serializeResponse,
}
import json.{stringify}
import string.{toUtf8}
import test.{expectEach, expectEqual, expectFalse, expectTrue}
import lib.nsid.{validateNsid}
import lib.xrpc.{
  AuthPolicy(..),
  Endpoint,
  InputPolicy(..),
  Registry,
  RouteResult(..),
  XrpcCall(..),
  XrpcFailure,
  inputSizeFailure,
  inputSizeWithinLimit,
  makeRegistry,
  procedureEndpoint,
  queryEndpoint,
  routeRequest,
  subscriptionEndpoint,
  xrpcFailureError,
  xrpcFailureMessage,
  xrpcFailureResponse,
  xrpcFailureStatus,
}

appendBytes : Array Int -> Array Int -> Array Int
appendBytes left right =
  let leftSize = arrayLength left
  arrayMakeWith (leftSize + arrayLength right) (i =>
    if i < leftSize then left[i] else right[i - leftSize])

-- The framer reads a packed `Bytes`; this driver's fixtures are still
-- `Array Int`, and `fromArray` is the only door between them. A fixture
-- element outside the byte domain stops here rather than reaching the parser.
mustRequest : Array Int -> Request
mustRequest bytes = match fromArray bytes
  Some packed =>
    resultOrPanic "xrpc_test: request setup failed" (parseRequest packed)
  None => panic "xrpc_test: request fixture holds a non-byte element"

noBodyRequest : String -> String -> Request
noBodyRequest method target =
  mustRequest
    (toUtf8 "\{method} \{target} HTTP/1.1\r\nHost: pds.example\r\n\r\n")

bodyRequest : String -> String -> String -> Array Int -> Request
bodyRequest method target headers body =
  mustRequest
    (appendBytes
      (toUtf8
        "\{method} \{target} HTTP/1.1\r\nHost: pds.example\r\n\{headers}Content-Length: \{intToString (arrayLength body)}\r\n\r\n")
      body)

mustEndpoint : Result String Endpoint -> Endpoint
mustEndpoint (Ok endpoint) = endpoint
mustEndpoint (Err message) =
  panic "xrpc_test: endpoint setup failed: \{message}"

mustRegistry : Result String Registry -> Registry
mustRegistry (Ok registry) = registry
mustRegistry (Err message) =
  panic "xrpc_test: registry setup failed: \{message}"

registry : Registry
registry =
  mustRegistry
    (makeRegistry [
      mustEndpoint
        (queryEndpoint "com.atproto.server.describeServer" PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.nobody.ping" NoInput PublicRoute),
      mustEndpoint
        (procedureEndpoint
          "com.atproto.repo.applyWrites"
          JsonInput
          PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.text.echo" TextInput PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.atproto.repo.uploadBlob" RawInput PublicRoute),
      mustEndpoint
        (subscriptionEndpoint "com.atproto.sync.subscribeRepos" PublicRoute),
    ])

reasonFor : Int -> String
reasonFor 400 = "Bad Request"
reasonFor 404 = "Not Found"
reasonFor 405 = "Method Not Allowed"
reasonFor 413 = "Payload Too Large"
reasonFor 415 = "Unsupported Media Type"
reasonFor 426 = "Upgrade Required"
reasonFor _ = "Unexpected"

expectedFailure : Int -> String -> String -> Array Int
expectedFailure status code message =
  let body = toUtf8 "{\"error\":\"\{code}\",\"message\":\"\{message}\"}"
  appendBytes
    (toUtf8
      "HTTP/1.1 \{intToString status} \{reasonFor status}\r\ncontent-type: application/json\r\ncontent-length: \{intToString (arrayLength body)}\r\n\r\n")
    body

failureValueMatches : Int -> String -> String -> XrpcFailure -> Bool
failureValueMatches status code message failed =
  xrpcFailureStatus failed == status
    && xrpcFailureError failed == code
    && xrpcFailureMessage failed == message
    && serializeResponse (xrpcFailureResponse failed)
      == expectedFailure status code message

failureMatches : Int -> String -> String -> Request -> Bool
failureMatches status code message request = match routeRequest registry request
  RouteCall _ _ => False
  RouteFailure failed => failureValueMatches status code message failed

sizeBoundaryMatches : InputPolicy -> Int -> String -> Bool
sizeBoundaryMatches policy limit message =
  inputSizeWithinLimit policy limit
    && not (inputSizeWithinLimit policy (limit + 1))
    && (match (
      inputSizeFailure policy limit,
      inputSizeFailure policy (limit + 1),
    )
      (None, Some failed) =>
        failureValueMatches 413 "PayloadTooLarge" message failed
      _ => False)

test "shared NSID authority accepts ASCII case and rejects structural boundaries" = expectEach
  [
    (
      "a well-formed NSID is accepted",
      expectFalse (isErr (validateNsid "com.atproto.repo.applyWrites")),
    ),
    (
      "the same NSID with a mixed-case authority is accepted",
      expectFalse (isErr (validateNsid "Com.AtProto.repo.applyWrites")),
    ),
    (
      "a two-segment NSID is rejected",
      expectTrue (isErr (validateNsid "com.applyWrites")),
    ),
    (
      "an authority segment starting with a digit is rejected",
      expectTrue (isErr (validateNsid "1com.atproto.applyWrites")),
    ),
    (
      "an authority segment starting with a hyphen is rejected",
      expectTrue (isErr (validateNsid "com.-atproto.applyWrites")),
    ),
    (
      "a hyphen in the method name is rejected",
      expectTrue (isErr (validateNsid "com.atproto.apply-Writes")),
    ),
  ]

test "endpoint smart constructors reject invalid NSIDs" = expectEach [
  (
    "a query endpoint rejects a malformed NSID",
    expectTrue (isErr (queryEndpoint "com.atproto.bad-name" PublicRoute)),
  ),
  (
    "a procedure endpoint rejects a malformed NSID",
    expectTrue (isErr (procedureEndpoint "not-an-nsid" JsonInput PublicRoute)),
  ),
  (
    "a subscription endpoint rejects a malformed NSID",
    expectTrue
      (isErr
        (subscriptionEndpoint "com.atproto.sync.subscribe-Repos" PublicRoute)),
  ),
]

test "registry admission rejects duplicate endpoint NSIDs" =
  let endpoint =
    mustEndpoint (queryEndpoint "com.example.test.echo" PublicRoute)
  expectTrue (isErr (makeRegistry [endpoint, endpoint]))

test "registry identity folds authority case but preserves method-name case" =
  let lower = mustEndpoint (queryEndpoint "com.example.test.echo" PublicRoute)
  let upperAuthority =
    mustEndpoint (queryEndpoint "Com.Example.test.echo" PublicRoute)
  let upperMethod =
    mustEndpoint (queryEndpoint "com.example.test.Echo" PublicRoute)
  expectEach [
    (
      "two endpoints differing only in authority case collide",
      expectTrue (isErr (makeRegistry [lower, upperAuthority])),
    ),
    (
      "two endpoints differing in method-name case do not collide",
      expectFalse (isErr (makeRegistry [lower, upperMethod])),
    ),
  ]

test "GET query routing preserves repeated decoded values and order" =
  let request =
    noBodyRequest
      "GET"
      "/xrpc/com.atproto.server.describeServer?detail=one&detail=&flag"
  match routeRequest registry request
    RouteCall _ (QueryCall nsid [QueryParam firstName firstValue, QueryParam secondName secondValue, QueryParam flag flagValue]) => expectEach
      [
        (
          "the call names the queried method",
          expectEqual "com.atproto.server.describeServer" nsid,
        ),
        ("the first parameter keeps its name", expectEqual "detail" firstName),
        (
          "the first parameter keeps its decoded value",
          expectEqual "one" firstValue,
        ),
        (
          "the repeated name is preserved, not merged",
          expectEqual "detail" secondName,
        ),
        (
          "the second parameter's empty value is preserved",
          expectEqual "" secondValue,
        ),
        ("the valueless parameter keeps its name", expectEqual "flag" flag),
        (
          "the valueless parameter decodes to the empty string",
          expectEqual "" flagValue,
        ),
      ]
    _ => expectTrue False

test "encoded and otherwise invalid XRPC method identities are rejected" = expectEach
  [
    (
      "a percent-encoded dot in the method identity is rejected",
      expectTrue
        (failureMatches
          400
          "InvalidRequest"
          "Invalid XRPC method NSID"
          (noBodyRequest "GET" "/xrpc/com%2eatproto.server.describeServer")),
    ),
    (
      "a trailing slash after the method identity is rejected",
      expectTrue
        (failureMatches
          400
          "InvalidRequest"
          "Invalid XRPC method NSID"
          (noBodyRequest "GET" "/xrpc/com.atproto.server.describeServer/")),
    ),
  ]

test "routing matches authority case-insensitively and returns registered spelling" =
  match (routeRequest
    registry
    (noBodyRequest "GET" "/xrpc/Com.AtProto.server.describeServer"))
    RouteCall _ (QueryCall "com.atproto.server.describeServer" []) =>
      expectTrue True
    _ => expectTrue False

test "empty XRPC method path is rejected without producing a call" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "Invalid XRPC method path"
      (noBodyRequest "GET" "/xrpc/"))

test "malformed query encoding is a canonical invalid-request failure" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "Invalid XRPC query parameters"
      (noBodyRequest "GET" "/xrpc/com.atproto.server.describeServer?q=%00"))

test "unknown registered-shape method is a canonical not-found failure" =
  expectTrue
    (failureMatches
      404
      "NotFound"
      "Unknown XRPC method: com.example.unknown"
      (noBodyRequest "GET" "/xrpc/com.example.unknown"))

test "non-XRPC target is a canonical not-found failure" =
  expectTrue
    (failureMatches
      404
      "NotFound"
      "XRPC route not found"
      (noBodyRequest "GET" "/health"))

test "query wrong method fails before a call exists" =
  expectTrue
    (failureMatches
      405
      "MethodNotAllowed"
      "XRPC query endpoints require GET"
      (noBodyRequest "POST" "/xrpc/com.atproto.server.describeServer"))

test "procedure wrong method fails before a call exists" =
  expectTrue
    (failureMatches
      405
      "MethodNotAllowed"
      "XRPC procedure endpoints require POST"
      (noBodyRequest "GET" "/xrpc/com.atproto.repo.applyWrites"))

test "query rejects a non-empty framed body" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "XRPC query endpoints do not accept request body framing"
      (bodyRequest
        "GET"
        "/xrpc/com.atproto.server.describeServer"
        "Content-Type: application/json\r\n"
        (toUtf8 "{}")))

test "query admits zero-length framing and Content-Type" =
  match (routeRequest
    registry
    (bodyRequest
      "GET"
      "/xrpc/com.atproto.server.describeServer"
      "Content-Type: application/json\r\n"
      [||]))
    RouteCall _ (QueryCall "com.atproto.server.describeServer" []) =>
      expectTrue True
    _ => expectTrue False

test "no-input procedure produces a typed call" =
  match (routeRequest
    registry
    (noBodyRequest "POST" "/xrpc/com.example.nobody.ping"))
    RouteCall _ (ProcedureNoInputCall "com.example.nobody.ping" []) =>
      expectTrue True
    _ => expectTrue False

-- The shape nearly every HTTP client gives a bodiless POST, and so the one
-- `com.atproto.server.refreshSession` is reached by in the field.
test "no-input procedure admits a zero-length Content-Length" =
  match (routeRequest
    registry
    (bodyRequest "POST" "/xrpc/com.example.nobody.ping" "" [||]))
    RouteCall _ (ProcedureNoInputCall "com.example.nobody.ping" []) =>
      expectTrue True
    _ => expectTrue False

test "no-input procedure admits a Content-Type over a zero-length body" =
  match (routeRequest
    registry
    (bodyRequest
      "POST"
      "/xrpc/com.example.nobody.ping"
      "Content-Type: application/json\r\n"
      [||]))
    RouteCall _ (ProcedureNoInputCall "com.example.nobody.ping" []) =>
      expectTrue True
    _ => expectTrue False

test "no-input procedure rejects a body that carries bytes" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "This procedure does not accept request body framing"
      (bodyRequest "POST" "/xrpc/com.example.nobody.ping" "" (toUtf8 "{}")))

test "no-input procedure rejects a chunked transfer coding" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "This procedure does not accept request body framing"
      (mustRequest
        (toUtf8
          "POST /xrpc/com.example.nobody.ping HTTP/1.1\r\nHost: pds.example\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")))

test "JSON procedure produces a typed parsed call" =
  let request =
    bodyRequest
      "POST"
      "/xrpc/com.atproto.repo.applyWrites"
      "Content-Type: application/json; charset=utf-8\r\n"
      (toUtf8 "{\"ok\":true}")
  match routeRequest registry request
    RouteCall _ (ProcedureJsonCall nsid [] value) => expectEach [
      (
        "the call names the posted method",
        expectEqual "com.atproto.repo.applyWrites" nsid,
      ),
      (
        "the JSON body parses back to what was sent",
        expectEqual "{\"ok\":true}" (stringify value),
      ),
    ]
    _ => expectTrue False

test "text procedure produces a typed UTF-8 call" =
  let request =
    bodyRequest
      "POST"
      "/xrpc/com.example.text.echo"
      "Content-Type: text/plain; charset=utf-8\r\n"
      (toUtf8 "héllo")
  match routeRequest registry request
    RouteCall _ (ProcedureTextCall nsid [] media text) => expectEach [
      (
        "the call names the posted method",
        expectEqual "com.example.text.echo" nsid,
      ),
      ("the media type is text", expectEqual "text" (mediaTypeType media)),
      (
        "the media subtype is plain",
        expectEqual "plain" (mediaTypeSubtype media),
      ),
      ("the body decodes as UTF-8, accents intact", expectEqual "héllo" text),
    ]
    _ => expectTrue False

test "wildcard raw procedure preserves text JSON and opaque media with exact bytes" =
  let textRequest =
    bodyRequest
      "POST"
      "/xrpc/com.atproto.repo.uploadBlob"
      "Content-Type: text/plain\r\n"
      (toUtf8 "hello")
  let jsonRequest =
    bodyRequest
      "POST"
      "/xrpc/com.atproto.repo.uploadBlob"
      "Content-Type: application/json\r\n"
      (toUtf8 "{nope}")
  let opaqueRequest = bodyRequest
    "POST"
    "/xrpc/com.atproto.repo.uploadBlob"
    "Content-Type: image/png\r\n"
    [|0, 128, 255|]
  match (
    routeRequest registry textRequest,
    routeRequest registry jsonRequest,
    routeRequest registry opaqueRequest,
  )
    (RouteCall _ (ProcedureRawCall textNsid [] textMedia textBytes), RouteCall _ (ProcedureRawCall jsonNsid [] jsonMedia jsonBytes), RouteCall _ (ProcedureRawCall opaqueNsid [] opaqueMedia opaqueBytes)) => expectEach
      [
        (
          "the text request names the blob method",
          expectEqual "com.atproto.repo.uploadBlob" textNsid,
        ),
        (
          "the text request keeps its media type",
          expectEqual "text" (mediaTypeType textMedia),
        ),
        (
          "the text request keeps its media subtype",
          expectEqual "plain" (mediaTypeSubtype textMedia),
        ),
        (
          "the text request's bytes are passed through",
          expectEqual (toUtf8 "hello") textBytes,
        ),
        (
          "the JSON request names the blob method",
          expectEqual "com.atproto.repo.uploadBlob" jsonNsid,
        ),
        (
          "the JSON request keeps its media type",
          expectEqual "application" (mediaTypeType jsonMedia),
        ),
        (
          "the JSON request keeps its media subtype",
          expectEqual "json" (mediaTypeSubtype jsonMedia),
        ),
        (
          "the JSON request's bytes are passed through unparsed",
          expectEqual (toUtf8 "{nope}") jsonBytes,
        ),
        (
          "the opaque request names the blob method",
          expectEqual "com.atproto.repo.uploadBlob" opaqueNsid,
        ),
        (
          "the opaque request keeps its media type",
          expectEqual "image" (mediaTypeType opaqueMedia),
        ),
        (
          "the opaque request keeps its media subtype",
          expectEqual "png" (mediaTypeSubtype opaqueMedia),
        ),
        (
          "the opaque request's bytes are passed through",
          expectEqual [|0, 128, 255|] opaqueBytes,
        ),
      ]
    _ => expectTrue False

test "procedure query parameters preserve repeated names empty values and order" =
  let request =
    bodyRequest
      "POST"
      "/xrpc/com.atproto.repo.applyWrites?dryRun=true&dryRun=&flag"
      "Content-Type: application/json\r\n"
      (toUtf8 "{}")
  match routeRequest registry request
    RouteCall _ (ProcedureJsonCall nsid [QueryParam firstName firstValue, QueryParam secondName secondValue, QueryParam flag flagValue] _) => expectEach
      [
        (
          "the call names the posted method",
          expectEqual "com.atproto.repo.applyWrites" nsid,
        ),
        ("the first parameter keeps its name", expectEqual "dryRun" firstName),
        ("the first parameter keeps its value", expectEqual "true" firstValue),
        (
          "the repeated name is preserved, not merged",
          expectEqual "dryRun" secondName,
        ),
        (
          "the second parameter's empty value is preserved",
          expectEqual "" secondValue,
        ),
        ("the valueless parameter keeps its name", expectEqual "flag" flag),
        (
          "the valueless parameter decodes to the empty string",
          expectEqual "" flagValue,
        ),
      ]
    _ => expectTrue False

test "missing duplicate and malformed body media classify as 415" = expectEach [
  (
    "a body with no Content-Type is refused",
    expectTrue
      (failureMatches
        415
        "UnsupportedMediaType"
        "Request body requires one Content-Type header"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          ""
          (toUtf8 "{}"))),
  ),
  (
    "a body with two Content-Type headers is refused",
    expectTrue
      (failureMatches
        415
        "UnsupportedMediaType"
        "Request body requires one Content-Type header"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          "Content-Type: application/json\r\nContent-Type: application/json\r\n"
          (toUtf8 "{}"))),
  ),
  (
    "a body with a malformed Content-Type is refused",
    expectTrue
      (failureMatches
        415
        "UnsupportedMediaType"
        "Request body has an invalid Content-Type header"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          "Content-Type: application\r\n"
          (toUtf8 "{}"))),
  ),
]

test "wrong JSON and text media classify as 415" = expectEach [
  (
    "text sent to a JSON endpoint is refused",
    expectTrue
      (failureMatches
        415
        "UnsupportedMediaType"
        "Request body media type does not match endpoint input"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          "Content-Type: text/plain\r\n"
          (toUtf8 "{}"))),
  ),
  (
    "JSON sent to a text endpoint is refused",
    expectTrue
      (failureMatches
        415
        "UnsupportedMediaType"
        "Request body media type does not match endpoint input"
        (bodyRequest
          "POST"
          "/xrpc/com.example.text.echo"
          "Content-Type: application/json\r\n"
          (toUtf8 "{}"))),
  ),
]

test "invalid JSON syntax and UTF-8 classify as 400" = expectEach [
  (
    "a body that is not JSON is refused",
    expectTrue
      (failureMatches
        400
        "InvalidRequest"
        "Request body is invalid for endpoint input"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          "Content-Type: application/json\r\n"
          (toUtf8 "{nope}"))),
  ),
  (
    "a body that is not valid UTF-8 is refused",
    expectTrue
      (failureMatches
        400
        "InvalidRequest"
        "Request body is invalid for endpoint input"
        (bodyRequest
          "POST"
          "/xrpc/com.atproto.repo.applyWrites"
          "Content-Type: application/json\r\n"
          [|0xc0, 0xaf|])),
  ),
]

test "invalid text UTF-8 classifies as 400" =
  expectTrue
    (failureMatches
      400
      "InvalidRequest"
      "Request body is invalid for endpoint input"
      (bodyRequest
        "POST"
        "/xrpc/com.example.text.echo"
        "Content-Type: text/plain\r\n"
        [|0xed, 0xa0, 0x80|]))

test "JSON input ceiling accepts at and returns exact 413 over" =
  expectTrue
    (sizeBoundaryMatches
      JsonInput
      maxJsonBodyBytes
      "JSON request body exceeds 153600 bytes")

test "text input ceiling accepts at and returns exact 413 over" =
  expectTrue
    (sizeBoundaryMatches
      TextInput
      maxTextBodyBytes
      "Text request body exceeds 102400 bytes")

test "raw input ceiling accepts at and returns exact 413 over" =
  expectTrue
    (sizeBoundaryMatches
      RawInput
      maxRawBodyBytes
      "Raw request body exceeds 5242880 bytes")

test "known subscription is 426 while its wrong method is 405" = expectEach [
  (
    "a plain GET to a subscription asks for a WebSocket upgrade",
    expectTrue
      (failureMatches
        426
        "UpgradeRequired"
        "XRPC subscription requires a WebSocket upgrade: com.atproto.sync.subscribeRepos"
        (noBodyRequest "GET" "/xrpc/com.atproto.sync.subscribeRepos")),
  ),
  (
    "a POST to a subscription is refused as the wrong method",
    expectTrue
      (failureMatches
        405
        "MethodNotAllowed"
        "XRPC subscription endpoints require GET"
        (noBodyRequest "POST" "/xrpc/com.atproto.sync.subscribeRepos")),
  ),
]
