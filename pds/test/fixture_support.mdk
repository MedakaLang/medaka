{- | Deterministic byte fixtures and small record/JSON helpers shared across
   the pds handler and route tests — secrets, nonces, per-seed contexts, byte
   builders and JSON-field accessors that many test mains built the same way
   under different names. -}

import bytes as B
import bytes.{Bytes}
import mut_bytes as MB
import mut_bytes.{MutBytes}
import u8 as U8
import json.{Json(..), get}
import string.{startsWith}
import lib.cid.{cidToString}
import lib.repo.{repoCommitCid, repoLatestCommit, repoRootCid}
import lib.server_core.{RequestContext(..)}
import lib.store.{Store, storeRepo}

export
testSecret : Bytes
testSecret = B.fromU8Array (arrayMakeWith 32 (i => U8.truncate (i * 7 + 3)))

-- | A second fixed secret, distinct from `testSecret`, for the tests that
-- need two accounts with different credentials in the same run.
export
altTestSecret : Bytes
altTestSecret = B.fromU8Array (arrayMakeWith 32 (i => U8.truncate (i * 7 + 1)))

export
testNonce : Bytes
testNonce = B.fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 11 + 5)))

export
nonceAt : Int -> Bytes
nonceAt seed =
  B.fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 31 + seed)))

export
contextAt : Int -> Int -> RequestContext
contextAt instant seed =
  RequestContext { nowSeconds = instant, nonce = nonceAt seed, login = None }

export
meaningful : String -> Bool
meaningful line = line /= "" && not (startsWith "#" line)

export
appendBytes : Array Int -> Array Int -> Array Int
appendBytes left right =
  let leftSize = arrayLength left
  arrayMakeWith (leftSize + arrayLength right) (i =>
    if i < leftSize then left[i] else right[i - leftSize])

export
lastHex : String -> String
lastHex text = stringSlice (stringLength text - 32) (stringLength text) text

export
storeFingerprint : Store -> String
storeFingerprint store = match storeRepo store
  None => "<unconfigured>"
  Some repo =>
    "\{cidToString (repoCommitCid (repoLatestCommit repo))}/\{cidToString (repoRootCid repo)}"

-- | The `i`-th element of a string list, counting from 0.
export
field : Int -> List String -> String
field _ [] = panic "fixture_support: corpus row is too short"
field i (value :: rest) = if i <= 0 then value else field (i - 1) rest

export
fieldText : String -> Json -> String
fieldText name value = match get name value
  Some (JString text) => text
  _ => "<missing:\{name}>"

export
commitField : String -> Json -> String
commitField name value = match get "commit" value
  Some commit => fieldText name commit
  None => "<missing:commit>"

export
bitBytes : Int -> Bytes
bitBytes k =
  let out = MB.make 32
  let () =
    MB.setInPlace
      (31 - shiftRight k 3)
      (U8.truncate (shiftLeft 1 (k - shiftLeft (shiftRight k 3) 3)))
      out
  MB.freeze out

decGo : MutBytes -> Int -> Unit
decGo out i =
  if i < 0 then
    ()
  else
    let v = U8.toInt out[i]
    if v == 0 then
      let () = MB.setInPlace i 255 out
      decGo out (i - 1)
    else
      MB.setInPlace i (U8.truncate (v - 1)) out

export
decBytes : Bytes -> Bytes
decBytes bs =
  let out = MB.thaw bs
  let () = decGo out 31
  MB.freeze out
