{- | Direct unit coverage for `ReadBuffer`'s capacity arithmetic
   (`pds/shell/server.mdk`) and for the `vector.pushArray`/`vector.rawParts`
   it is built from (#2859).

   The accumulation buffer's only other exercise is a live 5 MiB upload in
   `pds/test/serve_e2e.sh` (case 4d), which needs a socket, a server process
   and several seconds, and reports one bit. The arithmetic itself is pure:
   `readBufferAppend` is `vector.pushArray`, and `readBufferBacking` is
   `vector.rawParts`'s first half — this file asserts the growth-boundary
   and zero-copy properties directly against `Vector`, then again through
   `ReadBuffer`'s end-to-end wrapping, so a regression in either the
   stdlib API or the fold onto it shows up here. -}

import array.{fromList}
import shell.server.{
  ReadBuffer,
  readBufferAppend,
  readBufferBacking,
  readBufferLen,
  readBufferLive,
  readBufferNew,
}
import test.{expectAll, expectEqual}
import vector.{capacity, fromArray, get, new, pushArray, rawParts}

-- # `vector.pushArray`/`vector.rawParts` directly

test "pushArray into an empty vector allocates the smallest doubling that fits" =
  let v = new ()
  let () = pushArray (fromList [1]) v
  expectEqual 1 (capacity v)

test "pushArray doubles past the requested size, not to it" =
  let v = new ()
  let () = pushArray (fromList [1, 2, 3]) v
  expectEqual 4 (capacity v)

test "pushArray of nothing into nothing allocates nothing" =
  let v = new ()
  let () = pushArray (fromList []) v
  expectEqual 0 (capacity v)

-- 128 is the smallest doubling of 1 that is at least 80: a single call
-- crosses every boundary from 1 to 128 (1, 2, 4, 8, 16, 32, 64, 128) in one
-- grow, not seven. `push`'s own doubling can never need more than one `* 2`
-- step per call because it adds one element at a time; this is the case
-- that distinguishes `pushArray` from a naive "call `push` `n` times."
test "pushArray spanning many doubling boundaries in one call grows once, to the smallest doubling that holds it" =
  let v = new ()
  let () = pushArray (arrayMakeWith 80 (i => i)) v
  expectAll [expectEqual 128 (capacity v), expectEqual 80 (length v)]

test "rawParts reports the live length, not the backing capacity" =
  let v = new ()
  let () = pushArray (fromList [1, 2, 3]) v
  let (_, liveLen) = rawParts v
  expectEqual 3 liveLen

-- `rawParts` hands back the vector's OWN backing array, not a copy: writing
-- through it must be visible back through the vector's own reads.
test "rawParts is zero-copy: mutating through it is visible in the vector" =
  let v = fromArray (fromList [10, 20, 30])
  let (backing, _) = rawParts v
  let () = arraySetUnsafe 1 99 backing
  expectEqual (Some 99) (get 1 v)

-- # The buffer's own growth

-- How many three-byte chunks `filled` is built from, and the live count that
-- implies. 1000 chunks cross every doubling boundary from 4 to 4096.
chunkCount : Int
chunkCount = 1000

chunkSize : Int
chunkSize = 3

liveCount : Int
liveCount = chunkCount * chunkSize

-- Chunk `k` holds the three bytes at offsets `3k`, `3k+1`, `3k+2` of one
-- ascending byte stream, so a mis-ordered or mis-offset `blit` shows up as a
-- value mismatch rather than only as a length mismatch.
chunkAt : Int -> Array Int
chunkAt k = fromList [
  (chunkSize * k) % 256,
  (chunkSize * k + 1) % 256,
  (chunkSize * k + 2) % 256,
]

{- | One buffer, appended to `chunkCount` times. A top-level nullary binding
   is memoized, so every assertion below reads the same filled buffer and the
   1000 appends run once. -}
filled : ReadBuffer
filled =
  let buf = readBufferNew ()
  let () =
    fold (_ k => readBufferAppend (chunkAt k) buf) () [0..=chunkCount - 1]
  buf

test "a buffer filled in small increments holds every appended byte" =
  expectEqual liveCount (readBufferLen filled)

test "the live bytes are the appended bytes, in order" =
  expectEqual
    (fromList (map (i => i % 256) [0..=liveCount - 1]))
    (readBufferLive filled)

-- 4096 is the smallest doubling of 1 that holds 3000, so the backing store is
-- larger than the live count and `readBufferLive` must not expose the excess.
test "the backing store is the smallest doubling that holds the live bytes" =
  expectEqual 4096 (arrayLength (readBufferBacking filled))

-- Three appends of three bytes grow the store 0 -> 4 -> 8 -> 16: the second
-- and third both overflow, so this fails if a single grow is made to serve
-- more than the append that triggered it.
thrice : ReadBuffer
thrice =
  let buf = readBufferNew ()
  let () = fold (_ k => readBufferAppend (chunkAt k) buf) () [0..=2]
  buf

test "each overflowing append grows the store exactly once" =
  expectEqual 16 (arrayLength (readBufferBacking thrice))

test "a partly-filled store reports only its live bytes" =
  expectEqual 9 (readBufferLen thrice)

test "a partly-filled store's live bytes carry no spare capacity" =
  expectEqual (fromList [0, 1, 2, 3, 4, 5, 6, 7, 8]) (readBufferLive thrice)
