{- | Direct unit coverage for `ReadBuffer`'s capacity arithmetic
   (`pds/shell/server.mdk`), for the `vector.pushArray`/`vector.rawParts` it
   is built from (#2859), and for the process-wide budget that bounds those
   buffers in aggregate (#2951).

   The accumulation buffer's only other exercise is a live 5 MiB upload in
   `pds/test/serve_e2e.sh` (case 4d), which needs a socket, a server process
   and several seconds, and reports one bit. The arithmetic itself is pure:
   `readBufferAppend` is `bytebuilder.emitArray`, and `readBufferBacking` is
   `bytebuilder.builderParts`'s first half — this file asserts the
   growth-boundary and zero-copy properties directly against `Vector`, whose
   doubling `bytebuilder` mirrors, then again through `ReadBuffer`'s
   end-to-end wrapping, so a regression in either the stdlib API or the fold
   onto it shows up here.

   `readBufferAppend`'s byte-domain refusal is NOT asserted here: it aborts
   the process, which would shadow every later assertion in this file.
   `pds/test/trust_boundary_guards_test.mdk` grades it out of process, in
   its `readbuffer-over`/`readbuffer-under`/`readbuffer-edges` cells. -}

import array.{fromList}
import bytes.{bytesLength, toArray}
import lib.resource_limits.{maxInFlightRequestBytes}
import shell.server.{
  BufferCensus,
  BufferWaiter,
  bufferedBytes,
  chargeReadBuffer,
  claimBufferBytes,
  enqueueBufferBytes,
  maxQueuedBufferedReads,
  newBufferCensus,
  ReadBuffer,
  readBufferAppend,
  readBufferBacking,
  readBufferCharged,
  readBufferFrom,
  readBufferLen,
  readBufferLive,
  readBufferNew,
  releaseBufferBytes,
  releaseReadBuffer,
  retireReadBuffer,
  settleBufferedRead,
  waitingReads,
}
import test.{expectAll, expectEqual, expectTrue}
import vector.{capacity, fromArray, get, new, pushArray, rawParts}

-- # `vector.pushArray`/`vector.rawParts` directly

test "pushArray into an empty vector allocates the smallest doubling that fits" =
  let v = new ()
  let () = pushArray (fromList [1]) v
  expectEqual 1 (capacity v)

test "pushArray doubles past the requested size, not to it" =
  let v = new ()
  let () = pushArray (fromList [1, 2, 3]) v
  expectEqual 4 (capacity v)

test "pushArray of nothing into nothing allocates nothing" =
  let v = new ()
  let () = pushArray (fromList []) v
  expectEqual 0 (capacity v)

-- 128 is the smallest doubling of 1 that is at least 80: a single call
-- crosses every boundary from 1 to 128 (1, 2, 4, 8, 16, 32, 64, 128) in one
-- grow, not seven. `push`'s own doubling can never need more than one `* 2`
-- step per call because it adds one element at a time; this is the case
-- that distinguishes `pushArray` from a naive "call `push` `n` times."
test "pushArray spanning many doubling boundaries in one call grows once, to the smallest doubling that holds it" =
  let v = new ()
  let () = pushArray (arrayMakeWith 80 (i => i)) v
  expectAll [expectEqual 128 (capacity v), expectEqual 80 (length v)]

test "rawParts reports the live length, not the backing capacity" =
  let v = new ()
  let () = pushArray (fromList [1, 2, 3]) v
  let (_, liveLen) = rawParts v
  expectEqual 3 liveLen

-- `rawParts` hands back the vector's OWN backing array, not a copy: writing
-- through it must be visible back through the vector's own reads.
test "rawParts is zero-copy: mutating through it is visible in the vector" =
  let v = fromArray (fromList [10, 20, 30])
  let (backing, _) = rawParts v
  let () = arraySetUnsafe 1 99 backing
  expectEqual (Some 99) (get 1 v)

-- # The buffer's own growth

-- How many three-byte chunks `filled` is built from, and the live count that
-- implies. 1000 chunks cross every doubling boundary from 4 to 4096.
chunkCount : Int
chunkCount = 1000

chunkSize : Int
chunkSize = 3

liveCount : Int
liveCount = chunkCount * chunkSize

-- Chunk `k` holds the three bytes at offsets `3k`, `3k+1`, `3k+2` of one
-- ascending byte stream, so a mis-ordered or mis-offset `blit` shows up as a
-- value mismatch rather than only as a length mismatch.
chunkAt : Int -> Array Int
chunkAt k = fromList [
  (chunkSize * k) % 256,
  (chunkSize * k + 1) % 256,
  (chunkSize * k + 2) % 256,
]

{- | One buffer, appended to `chunkCount` times. A top-level nullary binding
   is memoized, so every assertion below reads the same filled buffer and the
   1000 appends run once. -}
filled : ReadBuffer
filled =
  let buf = readBufferNew ()
  let () =
    fold (_ k => readBufferAppend (chunkAt k) buf) () [0..=chunkCount - 1]
  buf

test "a buffer filled in small increments holds every appended byte" =
  expectEqual liveCount (readBufferLen filled)

test "the live bytes are the appended bytes, in order" =
  expectEqual
    (fromList (map (i => i % 256) [0..=liveCount - 1]))
    (toArray (readBufferLive filled))

-- 4096 is the smallest doubling of 1 that holds 3000, so the backing store is
-- larger than the live count and `readBufferLive` must not expose the excess.
test "the backing store is the smallest doubling that holds the live bytes" =
  expectEqual 4096 (bytesLength (readBufferBacking filled))

-- Three appends of three bytes grow the store 0 -> 4 -> 8 -> 16: the second
-- and third both overflow, so this fails if a single grow is made to serve
-- more than the append that triggered it.
thrice : ReadBuffer
thrice =
  let buf = readBufferNew ()
  let () = fold (_ k => readBufferAppend (chunkAt k) buf) () [0..=2]
  buf

test "each overflowing append grows the store exactly once" =
  expectEqual 16 (bytesLength (readBufferBacking thrice))

test "a partly-filled store reports only its live bytes" =
  expectEqual 9 (readBufferLen thrice)

test "a partly-filled store's live bytes carry no spare capacity" =
  expectEqual
    (fromList [0, 1, 2, 3, 4, 5, 6, 7, 8])
    (toArray (readBufferLive thrice))

-- # The process-wide buffer budget (#2951)

{- | `maxInFlightRequestBytes` bounds what every connection holds buffered
   between them, which no per-connection ceiling can: `maxHttpRequestBytes`
   grades one buffer and `maxConcurrentConnections` counts connections, and
   256 of the first is a gibibyte and a half against `pds/pds.service`'s
   `MemoryMax=512M`.

   What is asserted below is the admission decision itself, which is pure:
   what a claim charges, what a full budget refuses, what a full queue refuses
   outright, what order a release hands headroom on in, and that a connection
   gives back every byte it charged. The parking around that decision
   (`admitBufferBytes`) needs a scheduler and a live socket, so the
   concurrency claim itself is graded in `pds/test/serve_e2e.sh`. -}

mustWaiter : Option BufferWaiter -> BufferWaiter
mustWaiter queued =
  optionOrPanic
    "read_buffer_test: the queue refused a place it had room for"
    queued

queueRefused : Option BufferWaiter -> Bool
queueRefused None = True
queueRefused (Some _) = False

-- | `n` further reads queued for headroom, each asking for the same amount.
queueReads : BufferCensus -> Int -> Int -> Unit
queueReads census n bytes =
  fold (_ _ => discard (enqueueBufferBytes census bytes)) () [1..=n]

discard : Option BufferWaiter -> Unit
discard _ = ()

test "a claim within the budget is charged for exactly what it took" =
  let census = newBufferCensus ()
  let took = claimBufferBytes census 4096
  expectAll [expectTrue took, expectEqual 4096 (bufferedBytes census)]

test "a claim past the budget is refused and charges nothing" =
  let census = newBufferCensus ()
  let filledBudget = claimBufferBytes census maxInFlightRequestBytes
  let past = claimBufferBytes census 1
  expectAll [
    expectTrue filledBudget,
    expectTrue (not past),
    expectEqual maxInFlightRequestBytes (bufferedBytes census),
  ]

-- The refusal is not the end of it: the read joins the queue, and the release
-- that frees enough headroom charges the waiter BEFORE it runs again, so
-- nothing arriving in between can take the bytes ahead of it.
test "a read refused by a full budget is granted once headroom is released" =
  let census = newBufferCensus ()
  let filledBudget = claimBufferBytes census maxInFlightRequestBytes
  let refused = claimBufferBytes census 4096
  let waiter = mustWaiter (enqueueBufferBytes census 4096)
  let queuedBefore = waitingReads census
  let () = releaseBufferBytes census 4096
  let granted = settleBufferedRead census waiter
  expectAll [
    expectTrue filledBudget,
    expectTrue (not refused),
    expectEqual 1 queuedBefore,
    expectTrue granted,
    expectEqual 0 (waitingReads census),
    expectEqual maxInFlightRequestBytes (bufferedBytes census),
  ]

-- The queue is bounded as well as the budget: a waiter costs a parked task
-- and the chunk it has already read, so past `maxQueuedBufferedReads` of them
-- a further read is told now rather than held.
test "a read past a full budget and a full queue is refused outright" =
  let census = newBufferCensus ()
  let filledBudget = claimBufferBytes census maxInFlightRequestBytes
  let () = queueReads census maxQueuedBufferedReads 4096
  let queued = waitingReads census
  let past = enqueueBufferBytes census 4096
  expectAll [
    expectTrue filledBudget,
    expectEqual maxQueuedBufferedReads queued,
    expectTrue (queueRefused past),
  ]

-- A waiter whose wait ran out leaves the queue on its own settle, so the next
-- release hands headroom to the read behind it rather than to one that has
-- already been refused.
test "a waiter that gave up frees its place and takes no headroom" =
  let census = newBufferCensus ()
  let filledBudget = claimBufferBytes census maxInFlightRequestBytes
  let first = mustWaiter (enqueueBufferBytes census 4096)
  let second = mustWaiter (enqueueBufferBytes census 4096)
  let abandoned = settleBufferedRead census first
  let () = releaseBufferBytes census 4096
  let secondGranted = settleBufferedRead census second
  expectAll [
    expectTrue filledBudget,
    expectTrue (not abandoned),
    expectTrue secondGranted,
    expectEqual 0 (waitingReads census),
  ]

-- Strictly in order: a release too small for the head of the queue grants
-- nobody rather than skipping past it to the smaller read behind it, which
-- would leave a large read waiting out its deadline beside headroom it was
-- never offered.
test "a release too small for the head of the queue grants nobody" =
  let census = newBufferCensus ()
  let filledBudget = claimBufferBytes census maxInFlightRequestBytes
  let head = mustWaiter (enqueueBufferBytes census 8192)
  let behind = mustWaiter (enqueueBufferBytes census 1024)
  let () = releaseBufferBytes census 1024
  let headGranted = settleBufferedRead census head
  let behindGranted = settleBufferedRead census behind
  expectAll [
    expectTrue filledBudget,
    expectTrue (not headGranted),
    expectTrue (not behindGranted),
  ]

-- The per-connection charge and the process-wide total are one number seen
-- twice. A kept-alive connection's buffer is REPLACED by a rebased successor
-- between requests, so the charge has to survive that replacement or the
-- budget would shrink by one request's bytes per request served.
test "a connection gives back every byte it charged, across a rebase" =
  let census = newBufferCensus ()
  let buf = readBufferNew ()
  let took = claimBufferBytes census liveCount
  let () = chargeReadBuffer buf liveCount
  let () =
    fold (_ k => readBufferAppend (chunkAt k) buf) () [0..=chunkCount - 1]
  let rest = readBufferFrom 1200 buf
  let () = releaseReadBuffer census buf 1200
  let afterRebase = bufferedBytes census
  let () = retireReadBuffer census rest
  expectAll [
    expectTrue took,
    expectEqual (liveCount - 1200) afterRebase,
    expectEqual (liveCount - 1200) (readBufferLen rest),
    expectEqual 0 (bufferedBytes census),
    expectEqual 0 (readBufferCharged buf),
  ]
