{- | secp256k1 point arithmetic against the 25-row public-point corpus, on
   native over every row.

   The native row sweeps every row and pins that row 17 reached canonical
   infinity through the raw `n * G` ladder: `scFromBytes` does not admit
   `n`, so no other path in the driver can reach that row's answer.

   The eval arm over a three-row sample of the same file (lines 17, 19 and
   25) is graded nightly in `pds/nightly/secp256k1_point_eval_engine_test.mdk`:
   a 256-round ladder interpreted per row is too slow for the merge queue.

   No Wasm arm: the retired script had none. -}

import test.secp256k1_point_support.{corpusFile, driver}
import test.vector_runner.{
  Arm(..), Bound(..), Corpus(..), Engine(..), Row(..), expectRow
}
import test

gate : String
gate = "pds/test/secp256k1_point_vectors"

nativeFull : Row
nativeFull = Row {
  gate = gate,
  driver = driver,
  corpus = Explicit [corpusFile],
  corpusCount = Exactly 1,
  sourceShapes = [],
  oracle = None,
  arms = [
    Arm {
      engine = NativeEngine,
      driverArgs = [],
      countFloor = None,
      needs =
        ["row 17 raw-ladder canonical-infinity", "counted: 25/25 rows ok"],
      lastLine = Some "TOTAL: PASS",
      exactStdout = None,
    },
  ],
  parity = False,
}

test "secp256k1 points (native): 25/25 rows, nG raw ladder reaches canonical infinity" =
  expectRow nativeFull
