-- Refused: a `DataDir` rooted at "secrets/" is not within the caller's
-- `data/*`. Twin: `blocks_into_data.mdk`.

import bytes.{Bytes}
import lib.cid.{Cid}
import shell.blockfile.{blockFileWrite}
import shell.datadir.{DataDir(..)}

export
store : List (Cid, Bytes) ->
  <FileRead "data/*", FileWrite "data/*"> Result String Unit
store rows = blockFileWrite (DataDir "secrets/") rows
