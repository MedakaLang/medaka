{- | P1-C external CAR corpus and hostile-wire driver. -}

import array.{take}
import hex.{decode}
import io.{readLines}
import list.{reverse}
import string.{contains, split, startsWith}
import lib.blockstore.{blockStoreHas, blockStoreSize}
import lib.car.{Car, carBlocks, carDecode, carEncode, carRoots, carStore}
import lib.cid.{Cid, cidEqual, cidFromString, cidToBytes}
import lib.dagcbor.{DagCbor(..), dagCborEncode}
import lib.multiformats.{uvarintEncode}

data Fixture = Fixture String (List Cid) (List (Cid, Array Int)) (Array Int)
data FixtureState =
  | FixtureState String (List Cid) (List (Cid, Array Int)) (Option (Array Int))

mustHex : String -> Array Int
mustHex text = match decode text
  Ok bytes => bytes
  Err message => panic "car_vectors: malformed hex: \{message}"

mustCid : String -> Cid
mustCid text = match cidFromString text
  Ok cid => cid
  Err message => panic "car_vectors: malformed CID: \{message}"

mustHeader : DagCbor -> Array Int
mustHeader value = match dagCborEncode value
  Ok bytes => bytes
  Err message => panic "car_vectors: header encoding failed: \{message}"

mustCar : Result String Car -> Car
mustCar (Ok car) = car
mustCar (Err message) = panic "car_vectors: valid CAR failed: \{message}"

mustCarBytes : Result String (Array Int) -> Array Int
mustCarBytes (Ok bytes) = bytes
mustCarBytes (Err message) =
  panic "car_vectors: CAR encoding failed: \{message}"

parseFixture : List String -> Option FixtureState -> Fixture
parseFixture [] _ = panic "car_vectors: missing or unterminated fixture"
parseFixture (line::rest) current =
  if line == "" || startsWith "#" line then parseFixture rest current
  else match split "\t" line
    ["CASE", name] => match current
      Some _ => panic "car_vectors: nested CASE"
      None => parseFixture rest (Some (FixtureState name [] [] None))
    ["ROOT", cidText] => match current
      None => panic "car_vectors: ROOT outside CASE"
      Some (FixtureState name roots blocks bytes) => parseFixture rest (Some (FixtureState name (roots ++ [mustCid cidText]) blocks bytes))
    ["BLOCK", cidText, bytesHex] => match current
      None => panic "car_vectors: BLOCK outside CASE"
      Some (FixtureState name roots blocks bytes) => parseFixture rest (Some (FixtureState name roots (blocks ++ [(mustCid cidText, mustHex bytesHex)]) bytes))
    ["CAR", bytesHex] => match current
      None => panic "car_vectors: CAR outside CASE"
      Some (FixtureState name roots blocks _) => parseFixture rest (Some (FixtureState name roots blocks (Some (mustHex bytesHex))))
    ["END"] => match current
      None => panic "car_vectors: END outside CASE"
      Some (FixtureState name roots blocks (Some bytes)) =>
        Fixture name roots blocks bytes
      Some _ => panic "car_vectors: fixture has no CAR row"
    _ => panic "car_vectors: malformed corpus row: \{line}"

sameRoots : List Cid -> List Cid -> Bool
sameRoots [] [] = True
sameRoots (left::ls) (right::rs) = cidEqual left right && sameRoots ls rs
sameRoots _ _ = False

sameBlocks : List (Cid, Array Int) -> List (Cid, Array Int) -> Bool
sameBlocks [] [] = True
sameBlocks ((left, leftBytes)::ls) ((right, rightBytes)::rs) = cidEqual left right
  && leftBytes == rightBytes
  && sameBlocks ls rs
sameBlocks _ _ = False

frameHeader : DagCbor -> Array Int
frameHeader value =
  let header = mustHeader value
  uvarintEncode (arrayLength header) ++ header

headerValue : List Cid -> Int -> DagCbor
headerValue roots version =
  DcMap [("roots", DcArray (map DcLink roots)), ("version", DcInt version)]

encodeSections : List (Cid, Array Int) -> Array Int
encodeSections [] = [||]
encodeSections ((cid, bytes)::rest) =
  let payload = cidToBytes cid ++ bytes
  uvarintEncode (arrayLength payload) ++ payload ++ encodeSections rest

wireCar : List Cid -> Int -> List (Cid, Array Int) -> Array Int
wireCar roots version blocks = frameHeader (headerValue roots version)
  ++ encodeSections blocks

gradeExternal : Fixture -> <IO> Int
gradeExternal (Fixture name roots blocks expected) = match carDecode expected
  Err message =>
    let () = println "CASE \{name} FAIL decode=\{message}"
    0
  Ok car =>
    let reencoded = carEncode roots blocks
    let ok = sameRoots roots (carRoots car) && sameBlocks blocks (carBlocks car) && reencoded == Ok expected && blockStoreSize (carStore car) == length blocks
    if ok then
      let () = println "CASE \{name} PASS roots=\{intToString (length roots)} blocks=\{intToString (length blocks)}"
      1
    else
      let () = println "CASE \{name} FAIL decoded-or-reencoded-mismatch"
      0

success : String -> Bool -> <IO> Int
success label True =
  let () = println "SUCCESS \{label} PASS"
  1
success label False =
  let () = println "SUCCESS \{label} FAIL"
  0

runSuccess : Fixture -> <IO> Int
runSuccess (Fixture _ roots blocks expected) =
  let decoded = mustCar (carDecode expected)
  let first = match blocks
    block::_ => block
    [] => panic "car_vectors: fixture must contain blocks"
  let duplicateCar = mustCar (carDecode (mustCarBytes (carEncode roots (blocks ++ [first]))))
  let reordered = reverse blocks
  let reorderedCar = mustCar (carDecode (mustCarBytes (carEncode roots reordered)))
  let root = match roots
    item::_ => item
    [] => panic "car_vectors: fixture must contain a root"
  sum
    [
      success "canonical-reencode" (carEncode roots blocks == Ok expected),
      success "identical-duplicate" (length (carBlocks duplicateCar) == length blocks + 1 && blockStoreSize (carStore duplicateCar) == length blocks),
      success "arbitrary-order" (sameBlocks reordered (carBlocks reorderedCar)),
      success "unrelated-block" (length blocks > length roots && blockStoreHas root (carStore decoded)),
    ]

rejectContains : String -> String -> Result String a -> <IO> Int
rejectContains label witness (Err message) =
  if contains witness message then
    let () = println "HOSTILE \{label} PASS route=\{witness}"
    1
  else
    let () = println "HOSTILE \{label} FAIL wrong-route=\{message}"
    0
rejectContains label _ (Ok _) =
  let () = println "HOSTILE \{label} FAIL accepted"
  0

runHostile : Fixture -> <IO> Int
runHostile (Fixture _ roots blocks expected) =
  let header = mustHeader (headerValue roots 1)
  let framed = uvarintEncode (arrayLength header) ++ header
  let root = match roots
    item::_ => item
    [] => panic "car_vectors: fixture must contain a root"
  let malformedCid = [|0|]
  let nonBlessedCid = [|1, 0x70, 0x12, 0x20|] ++ arrayMake 32 0
  let malformedSection = uvarintEncode (arrayLength malformedCid) ++ malformedCid
  let nonBlessedSection = uvarintEncode (arrayLength nonBlessedCid) ++ nonBlessedCid
  let mismatchPayload = cidToBytes root ++ [|0|]
  let mismatchSection = uvarintEncode (arrayLength mismatchPayload) ++ mismatchPayload
  let truncated = take (arrayLength expected - 1) expected
  sum
    [
      rejectContains "nonminimal-varint" "uvarint: non-minimal" (carDecode ([|bitOr (arrayLength header) 0x80, 0|] ++ header ++ encodeSections blocks)),
      rejectContains "overflow-varint" "representable Int range" (carDecode [|128, 128, 128, 128, 128, 128, 128, 128, 64|]),
      rejectContains "zero-section" "zero-length section" (carDecode (framed ++ [|0|])),
      rejectContains "overlong-section" "overlong section" (carDecode (framed ++ [|100|])),
      rejectContains "truncation" "truncated" (carDecode truncated),
      rejectContains "trailing-corruption" "trailing corruption" (carDecode (expected ++ [|0x80|])),
      rejectContains "wrong-version" "version must be 1" (carDecode (wireCar roots 2 blocks)),
      rejectContains "wrong-header" "header must be exactly" (carDecode (frameHeader (DcMap [("version", DcInt 1)]))),
      rejectContains "malformed-cid" "CID codec" (carDecode (framed ++ malformedSection)),
      rejectContains "nonblessed-cid" "non-blessed CID" (carDecode (framed ++ nonBlessedSection)),
      rejectContains "missing-root" "root block is missing" (carDecode framed),
      rejectContains "cid-mismatch" "content does not match CID" (carDecode (framed ++ mismatchSection)),
    ]

main : <IO, Env, FileRead "_"> Unit
main = match args ()
  [corpusPath] => match readLines corpusPath
    Err message => panic "car_vectors: cannot read corpus: \{message}"
    Ok rows =>
      let fixture = parseFixture rows None
      let external = gradeExternal fixture
      let successes = runSuccess fixture
      let hostile = runHostile fixture
      let () = println "external: \{intToString external}/1 official-atproto CAR cases"
      let () = println "success: \{intToString successes}/4 interoperability routes"
      let () = println "hostile: \{intToString hostile}/12 rejected on named routes"
      if external == 1 && successes == 4 && hostile == 12 then println "TOTAL: PASS"
      else
        let () = println "TOTAL: FAIL"
        exit 1
  _ => panic "usage: car_vectors_main <ledger-owned-corpus>"
