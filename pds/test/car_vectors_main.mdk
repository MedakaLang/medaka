{- | P1-C external CAR corpus and hostile-wire driver. -}

import array.{take}
import bytes.{Bytes, fromArrayAssumeByteDomain, toArray}
import hex.{decode}
import io.{readLines}
import list.{reverse}
import string.{split, startsWith}
import lib.blockstore.{blockStoreHas, blockStoreSize}
import lib.car.{Car, carBlocks, carDecode, carEncode, carRoots, carStore}
import lib.cid.{Cid, cidEqual, cidFromString, cidToBytes}
import lib.dagcbor.{DagCbor(..), dagCborEncode}
import lib.multiformats.{uvarintEncode}
import test.vector_support.{rejectContains}

data Fixture = Fixture String (List Cid) (List (Cid, Array Int)) (Array Int)
data FixtureState =
  | FixtureState String (List Cid) (List (Cid, Array Int)) (Option (Array Int))

mustHex : String -> Array Int
mustHex text =
  toArray (resultOrPanic "car_vectors: malformed hex" (decode text))

mustCid : String -> Cid
mustCid text = resultOrPanic "car_vectors: malformed CID" (cidFromString text)

mustHeader : DagCbor -> Array Int
mustHeader value =
  toArray
    (resultOrPanic "car_vectors: header encoding failed" (dagCborEncode value))

mustCar : Result String Car -> Car
mustCar (Ok car) = car
mustCar (Err message) = panic "car_vectors: valid CAR failed: \{message}"

mustCarBytes : Result String Bytes -> Bytes
mustCarBytes (Ok bytes) = bytes
mustCarBytes (Err message) =
  panic "car_vectors: CAR encoding failed: \{message}"

-- Door: this driver is not itself retyped this slice (its own `Array Int`
-- moves in sprint C). One conversion helper each way covers every
-- whole-block-list call into/out of `lib.car`.
blockRowsToBytesDoor : List (Cid, Array Int) -> List (Cid, Bytes)
blockRowsToBytesDoor =
  map ((cid, bytes) => (cid, fromArrayAssumeByteDomain bytes))

blockRowsFromBytesDoor : List (Cid, Bytes) -> List (Cid, Array Int)
blockRowsFromBytesDoor = map ((cid, bytes) => (cid, toArray bytes))

hostileDecode : Array Int -> Result String Car
hostileDecode bytes = carDecode (fromArrayAssumeByteDomain bytes)

parseFixture : List String -> Option FixtureState -> Fixture
parseFixture [] _ = panic "car_vectors: missing or unterminated fixture"
parseFixture (line :: rest) current =
  if line == "" || startsWith "#" line then
    parseFixture rest current
  else match split "\t" line
    ["CASE", name] => match current
      Some _ => panic "car_vectors: nested CASE"
      None => parseFixture rest (Some (FixtureState name [] [] None))
    ["ROOT", cidText] => match current
      None => panic "car_vectors: ROOT outside CASE"
      Some (FixtureState name roots blocks bytes) =>
        parseFixture
          rest
          (Some (FixtureState name (roots ++ [mustCid cidText]) blocks bytes))
    ["BLOCK", cidText, bytesHex] => match current
      None => panic "car_vectors: BLOCK outside CASE"
      Some (FixtureState name roots blocks bytes) =>
        parseFixture
          rest
          (Some
            (FixtureState
              name
              roots
              (blocks ++ [(mustCid cidText, mustHex bytesHex)])
              bytes))
    ["CAR", bytesHex] => match current
      None => panic "car_vectors: CAR outside CASE"
      Some (FixtureState name roots blocks _) =>
        parseFixture
          rest
          (Some (FixtureState name roots blocks (Some (mustHex bytesHex))))
    ["END"] => match current
      None => panic "car_vectors: END outside CASE"
      Some (FixtureState name roots blocks (Some bytes)) =>
        Fixture name roots blocks bytes
      Some _ => panic "car_vectors: fixture has no CAR row"
    _ => panic "car_vectors: malformed corpus row: \{line}"

sameRoots : List Cid -> List Cid -> Bool
sameRoots [] [] = True
sameRoots (left :: ls) (right :: rs) = cidEqual left right && sameRoots ls rs
sameRoots _ _ = False

sameBlocks : List (Cid, Array Int) -> List (Cid, Array Int) -> Bool
sameBlocks [] [] = True
sameBlocks ((left, leftBytes) :: ls) ((right, rightBytes) :: rs) =
  cidEqual left right && leftBytes == rightBytes && sameBlocks ls rs
sameBlocks _ _ = False

frameHeader : DagCbor -> Array Int
frameHeader value =
  let header = mustHeader value
  toArray (uvarintEncode (arrayLength header)) ++ header

headerValue : List Cid -> Int -> DagCbor
headerValue roots version =
  DcMap [("roots", DcArray (map DcLink roots)), ("version", DcInt version)]

encodeSections : List (Cid, Array Int) -> Array Int
encodeSections [] = [||]
encodeSections ((cid, bytes) :: rest) =
  let payload = toArray (cidToBytes cid) ++ bytes
  toArray (uvarintEncode (arrayLength payload))
    ++ payload
    ++ encodeSections rest

wireCar : List Cid -> Int -> List (Cid, Array Int) -> Array Int
wireCar roots version blocks =
  frameHeader (headerValue roots version) ++ encodeSections blocks

gradeExternal : Fixture -> <IO> Int
gradeExternal (Fixture name roots blocks expected) =
  match hostileDecode expected
    Err message =>
      let () = println "CASE \{name} FAIL decode=\{message}"
      0
    Ok car =>
      let reencoded =
        map toArray (carEncode roots (blockRowsToBytesDoor blocks))
      let ok =
        sameRoots roots (carRoots car)
          && sameBlocks blocks (blockRowsFromBytesDoor (carBlocks car))
          && reencoded == Ok expected
          && blockStoreSize (carStore car) == length blocks
      if ok then
        let () =
          println
            "CASE \{name} PASS roots=\{intToString (length roots)} blocks=\{intToString (length blocks)}"
        1
      else
        let () = println "CASE \{name} FAIL decoded-or-reencoded-mismatch"
        0

success : String -> Bool -> <IO> Int
success label True =
  let () = println "SUCCESS \{label} PASS"
  1
success label False =
  let () = println "SUCCESS \{label} FAIL"
  0

runSuccess : Fixture -> <IO> Int
runSuccess (Fixture _ roots blocks expected) =
  let decoded = mustCar (hostileDecode expected)
  let first = match blocks
    block :: _ => block
    [] => panic "car_vectors: fixture must contain blocks"
  let duplicateCar =
    mustCar
      (carDecode
        (mustCarBytes
          (carEncode roots (blockRowsToBytesDoor (blocks ++ [first])))))
  let reordered = reverse blocks
  let reorderedCar =
    mustCar
      (carDecode
        (mustCarBytes (carEncode roots (blockRowsToBytesDoor reordered))))
  let root = match roots
    item :: _ => item
    [] => panic "car_vectors: fixture must contain a root"
  sum [
    success
      "canonical-reencode"
      (map toArray (carEncode roots (blockRowsToBytesDoor blocks))
        == Ok expected),
    success
      "identical-duplicate"
      (length (carBlocks duplicateCar) == length blocks + 1
        && blockStoreSize (carStore duplicateCar) == length blocks),
    success
      "arbitrary-order"
      (sameBlocks reordered (blockRowsFromBytesDoor (carBlocks reorderedCar))),
    success
      "unrelated-block"
      (length blocks > length roots && blockStoreHas root (carStore decoded)),
  ]

runHostile : Fixture -> <IO> Int
runHostile (Fixture _ roots blocks expected) =
  let header = mustHeader (headerValue roots 1)
  let framed = toArray (uvarintEncode (arrayLength header)) ++ header
  let root = match roots
    item :: _ => item
    [] => panic "car_vectors: fixture must contain a root"
  let malformedCid = [|0|]
  let nonBlessedCid = [|1, 0x70, 0x12, 0x20|] ++ arrayMake 32 0
  let malformedSection =
    toArray (uvarintEncode (arrayLength malformedCid)) ++ malformedCid
  let nonBlessedSection =
    toArray (uvarintEncode (arrayLength nonBlessedCid)) ++ nonBlessedCid
  let mismatchPayload = toArray (cidToBytes root) ++ [|0|]
  let mismatchSection =
    toArray (uvarintEncode (arrayLength mismatchPayload)) ++ mismatchPayload
  let truncated = take (arrayLength expected - 1) expected
  sum [
    rejectContains
      "nonminimal-varint"
      "uvarint: non-minimal"
      (hostileDecode
        ([|bitOr (arrayLength header) 0x80, 0|]
          ++ header
          ++ encodeSections blocks)),
    rejectContains
      "overflow-varint"
      "representable Int range"
      (hostileDecode [|128, 128, 128, 128, 128, 128, 128, 128, 64|]),
    rejectContains
      "zero-section"
      "zero-length section"
      (hostileDecode (framed ++ [|0|])),
    rejectContains
      "overlong-section"
      "overlong section"
      (hostileDecode (framed ++ [|100|])),
    rejectContains "truncation" "truncated" (hostileDecode truncated),
    rejectContains
      "trailing-corruption"
      "trailing corruption"
      (hostileDecode (expected ++ [|0x80|])),
    rejectContains
      "wrong-version"
      "version must be 1"
      (hostileDecode (wireCar roots 2 blocks)),
    rejectContains
      "wrong-header"
      "header must be exactly"
      (hostileDecode (frameHeader (DcMap [("version", DcInt 1)]))),
    rejectContains
      "malformed-cid"
      "CID codec"
      (hostileDecode (framed ++ malformedSection)),
    rejectContains
      "nonblessed-cid"
      "non-blessed CID"
      (hostileDecode (framed ++ nonBlessedSection)),
    rejectContains
      "missing-root"
      "root block is missing"
      (hostileDecode framed),
    rejectContains
      "cid-mismatch"
      "content does not match CID"
      (hostileDecode (framed ++ mismatchSection)),
  ]

main : <IO, Env, FileRead> Unit
main = match args ()
  [corpusPath] => match readLines corpusPath
    Err message => panic "car_vectors: cannot read corpus: \{message}"
    Ok rows =>
      let fixture = parseFixture rows None
      let external = gradeExternal fixture
      let successes = runSuccess fixture
      let hostile = runHostile fixture
      let () =
        println "external: \{intToString external}/1 official-atproto CAR cases"
      let () =
        println "success: \{intToString successes}/4 interoperability routes"
      let () =
        println "hostile: \{intToString hostile}/12 rejected on named routes"
      if external == 1 && successes == 4 && hostile == 12 then
        println "TOTAL: PASS"
      else
        let () = println "TOTAL: FAIL"
        exit 1
  _ => panic "usage: car_vectors_main <ledger-owned-corpus>"
