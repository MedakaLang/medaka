-- Committed hostile-input guard probes for RUN-PDS0-036, #1727 and #3210. Each
-- case is ONE process because a panic aborts the process;
-- pds/test/trust_boundary_guards_test.mdk runs them one at a time and grades
-- exit codes AND messages. NOT named *_test.mdk on purpose: Medaka has no
-- catchable panics, so a panicking guard cannot be asserted from `medaka
-- test` — the first abort would shadow every later assertion in the file.
--
-- Every guard gets both directions. The PANIC cases prove the guard fires;
-- the CONTROL cases prove it does not fire on legitimate input, which is
-- the half that catches an off-by-one in the bound.
--
--   medaka run pds/test/guard_probes_main.mdk <case>

import bytes as B
import lib.multiformats.{uvarintEncode}
import shell.server.{readBufferAppend, readBufferLen, readBufferNew}

main = match args ()
  -- unsigned-varint encodes non-negative values only.
  ["uvarint-neg"] =>
    let v = uvarintEncode (0 - 1)
    println "REACHED uvarint-neg len=\{intToString (B.length v)}"
  -- CONTROL. An ordinary two-byte value must still encode.
  ["uvarint-ok"] =>
    let v = uvarintEncode 300
    println "OK uvarint-ok len=\{intToString (B.length v)}"
  -- `readBufferAppend` packs an `Array Int` into the connection's byte
  -- buffer. Without the guard both cells alias into the byte domain — 300
  -- masks to 44 (`,`) and -1 to 255 — which is a byte on the wire the
  -- caller never supplied.
  ["readbuffer-over"] =>
    let buf = readBufferNew ()
    let () = readBufferAppend (arrayFromList [65, 300]) buf
    println "REACHED readbuffer-over len=\{intToString (readBufferLen buf)}"
  ["readbuffer-under"] =>
    let buf = readBufferNew ()
    let () = readBufferAppend (arrayFromList [65, 0 - 1]) buf
    println "REACHED readbuffer-under len=\{intToString (readBufferLen buf)}"
  -- CONTROL. 0 and 255 are the two INCLUSIVE endpoints, the cell that
  -- catches a `>= 255` or `> 0` off-by-one in the guard.
  ["readbuffer-edges"] =>
    let buf = readBufferNew ()
    let () = readBufferAppend (arrayFromList [0, 255]) buf
    println "OK readbuffer-edges len=\{intToString (readBufferLen buf)}"
  _ => panic "guard_probes: unknown case"
