-- | Anti-rot sanity floor for the whole `pds/` in-language test harness.
--   `pds/test/inlang_test_oracle.sh` counts the assertions
--   that actually ran here and fails if the count drops below the committed
--   floor — that is what catches a discovery regression instead of a silent
--   vacuous-green pass.

import test.{expectEqual}

-- The annotation is load-bearing: `expectEqual` is polymorphic and a bare
-- numeric literal picks no instance, so `Debug`/`Eq` are ambiguous without it.
test "arithmetic sanity: 2 + 2 = 4" = expectEqual (2 + 2 : Int) 4

test "string sanity: concatenation" =
  expectEqual ("pds" ++ "/skeleton") "pds/skeleton"
