{- | The `com.atproto.repo.applyWrites` batch driver.

   Replays ONE batch of four operations through the full protocol seam — JSON
   request BYTES into `handleBytes`, JSON response BYTES out — and grades the
   result against `pds/test/vectors/repo_batch_reference_corpus.txt`, which the
   pinned official `@atproto/repo` generated by making the same four MST edits
   and signing ONCE.

   That is the property under test, and the reason the corpus is its own file:
   a batch must land as ONE signed commit at ONE revision, so the answer key
   cannot be four single-write commits replayed in sequence. The response's
   `commit.cid` and `commit.rev`, every result row's record CID, and the whole
   exported CAR are compared against the official bytes.

   The cells then grade what a batch owes beyond its happy path: a mismatched
   `swapCommit` is `InvalidSwap`, a batch whose LAST operation cannot apply
   leaves the repository at its prior commit with none of the earlier three
   applied, and an empty batch is a no-op that reports the current commit
   rather than signing a vacuous one.

   A last pair grades what a batch owes the write that comes AFTER it: a batch
   that mints its own record keys must commit past all of them, so the next
   rkey-less `createRecord` does not propose one again; and a batch deleting a
   record that is not there is the same idempotent no-op `deleteRecord` is. -}

import bytes as B
import bytes.{Bytes, decodeUtf8, encodeUtf8}
import json.{Json(..), jArray, jObject, get, parse, stringify}
import hex.{decode, encode}
import io.{readLines}
import string.{split, startsWith}
import lib.cid.{cidToString}
import lib.dagcbor.{dagCborDecode}
import lib.handlers.{recordServer}
import lib.lexjson.{dagCborToLexJson}
import lib.repo.{
  Repo,
  repoCommitCid,
  repoCommitTid,
  repoExportCar,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoRootCid,
}
import lib.server_core.{
  Account,
  RequestContext(..),
  Server,
  handleBytes,
  makeAccount,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeFromRepo,
  storeRepo,
  storeSessionOpen,
  storeWithServerSecret,
}
import lib.tid.{Tid, tidParse, tidToString}
import test.response_support.{bodyText}
import test.fixture_support.{
  commitField,
  field,
  fieldText,
  lastHex,
  meaningful,
  storeFingerprint,
  testKey,
  testNonce,
  testSecret,
}
import lib.sign.{Sign}
import lib.jwt.{mintAccessToken}

accountHandleText : String
accountHandleText = "medaka.example"

accountHostText : String
accountHostText = "pds.example"

applyWritesNsid : String
applyWritesNsid = "com.atproto.repo.applyWrites"

createRecordNsid : String
createRecordNsid = "com.atproto.repo.createRecord"

-- | The collection the two revision-consistency cells write into. It is not
-- one the pinned corpus touches, so those cells cannot perturb the graded
-- batch above.
scratchCollection : String
scratchCollection = "app.medaka.scratch"

-- | A record of the scratch collection. A record's `$type` must name the
-- collection it is written to, or the write is refused before any key is
-- minted.
scratchRecord : Json
scratchRecord = jObject [
  ("$type", JString scratchCollection),
  ("text", JString "scratch"),
]

mustHex : String -> Bytes
mustHex text = resultOrPanic "batch_handlers: malformed hex" (decode text)

mustTid : String -> Tid
mustTid text = resultOrPanic "batch_handlers: malformed TID" (tidParse text)

mustRecordJson : String -> Json
mustRecordJson text = match dagCborDecode (mustHex text)
  Ok value => dagCborToLexJson value
  Err message => panic "batch_handlers: malformed record: \{message}"

mustAccount : String -> Account
mustAccount did =
  resultOrPanic
    "batch_handlers: account setup failed"
    (makeAccount did accountHandleText accountHostText)

mustServer : Account -> Server <Sign "commit">
mustServer account =
  resultOrPanic "batch_handlers: server setup failed" (recordServer account)

mustRepo : String -> String -> Tid -> <Sign "commit"> Repo
mustRepo did secretHex rev =
  match repoInitFromKeyBytes did (mustHex secretHex) rev
    Ok repo => repo
    Err message => panic "batch_handlers: repository init failed: \{message}"

-- ── the session credential every write needs ────────────────────────────────

-- A fixed secret and instant, for the reason `pds/test/record_handlers_main.mdk`
-- gives at length: this file grades handler behavior, and a random secret would
-- only make the transcript irreproducible.
testInstant : Int
testInstant = 1700000000

testContext : RequestContext
testContext =
  RequestContext { nowSeconds = testInstant, nonce = testNonce, login = None }

testToken : String -> <Mint "access"> String
testToken did =
  mintAccessToken
    testKey
    did
    accountHostText
    "batch_handlers-fixture-token"
    (testInstant - 60)
    (testInstant + 3600)

authorizedStore : String -> Store -> <Mint "access"> Store
authorizedStore did store =
  let next = storeWithServerSecret testKey store
  storeSessionOpen
    (sessionFingerprint (testToken did))
    (sessionFingerprint "batch_handlers: no refresh token in this fixture")
    (testInstant + 3600)
    next

-- ── request framing ─────────────────────────────────────────────────────────

procedureRequestTo : String -> String -> String -> <Mint "access"> Bytes
procedureRequestTo nsid did body =
  let bytes = encodeUtf8 body
  encodeUtf8
      "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\nAuthorization: Bearer \{testToken did}\r\nContent-Type: application/json\r\nContent-Length: \{intToString (B.length bytes)}\r\n\r\n"
    ++ bytes

procedureRequest : String -> String -> <Mint "access"> Bytes
procedureRequest did body = procedureRequestTo applyWritesNsid did body

responseJson : Bytes -> Json
responseJson bytes = match parse (bodyText bytes)
  Ok value => value
  Err message => panic "batch_handlers: response is not JSON: \{message}"

resultCidsAt : Array Json -> Int -> List String
resultCidsAt rows i =
  if i >= arrayLength rows then
    []
  else
    fieldText "cid" rows[i] :: resultCidsAt rows (i + 1)

resultCids : Json -> List String
resultCids value = match get "results" value
  Some (JArray rows) => resultCidsAt rows 0
  _ => ["<missing:results>"]

-- ── corpus rows ─────────────────────────────────────────────────────────────

{- | Every row carrying `tag`, as its remaining tab-separated fields. Selecting
   by tag rather than by position is deliberate: the single-write corpus is
   matched positionally by two other drivers, which is exactly what makes that
   file unextendable. -}
tagged : String -> List String -> List (List String)
tagged _ [] = []
tagged tag (line :: rest) = match split "\t" line
  name :: fields =>
    if name == tag then fields :: tagged tag rest else tagged tag rest
  _ => tagged tag rest

taggedOne : String -> List String -> List String
taggedOne tag lines = match tagged tag lines
  [fields] => fields
  _ => panic "batch_handlers: expected exactly one \{tag} row"

-- ── the batch request ───────────────────────────────────────────────────────

splitPath : String -> (String, String)
splitPath text = match split "/" text
  [collection, rkey] => (collection, rkey)
  _ => panic "batch_handlers: malformed corpus path"

elementType : String -> String
elementType fragment = "\{applyWritesNsid}#\{fragment}"

writeElement : List String -> Json
writeElement fields =
  let kind = field 0 fields
  let (collection, rkey) =
    splitPath
      (optionOrPanic
        "batch_handlers: corpus path is not UTF-8"
        (decodeUtf8 (mustHex (field 1 fields))))
  match kind
    "DELETE" => jObject [
      ("$type", JString (elementType "delete")),
      ("collection", JString collection),
      ("rkey", JString rkey),
    ]
    "CREATE" => jObject [
      ("$type", JString (elementType "create")),
      ("collection", JString collection),
      ("rkey", JString rkey),
      ("value", mustRecordJson (field 2 fields)),
    ]
    "UPDATE" => jObject [
      ("$type", JString (elementType "update")),
      ("collection", JString collection),
      ("rkey", JString rkey),
      ("value", mustRecordJson (field 2 fields)),
    ]
    _ => panic "batch_handlers: unknown batch operation \{kind}"

{- | Every batch this driver sends says `validate: false`: the corpus keys
   its `app.bsky.feed.post` records `medaka-a`, `medaka-b` and `medaka-c`,
   which are not TIDs, so the reference PDS itself refuses the batch unless
   grading is off, and the keys are inside the pinned bytes. -}
batchBody : String -> List Json -> String
batchBody did writes =
  stringify
    (jObject [
      ("repo", JString did),
      ("writes", jArray writes),
      ("validate", JBool False),
    ])

batchBodyWithSwap : String -> List Json -> String -> String
batchBodyWithSwap did writes swap =
  stringify
    (jObject [
      ("repo", JString did),
      ("writes", jArray writes),
      ("swapCommit", JString swap),
      ("validate", JBool False),
    ])

-- ── grading ─────────────────────────────────────────────────────────────────

storeMustRepo : Store -> Repo
storeMustRepo store =
  optionOrPanic "batch_handlers: store carries no repository" (storeRepo store)

stateWord : Bool -> String
stateWord True = "unchanged"
stateWord False = "MUTATED"

check : String -> Bool -> String -> <IO> Int
check label ok detail =
  if ok then
    let () = println "BATCH \{label} PASS \{detail}"
    1
  else
    let () = println "BATCH \{label} FAIL \{detail}"
    0

rejectCell : String ->
  String ->
  String ->
  Server e ->
  Store ->
  String ->
  <IO, Mint "access" | e> Int
rejectCell label expectedCode did server store body =
  let before = storeFingerprint store
  let (next, responseBytes) =
    handleBytes server testContext store (procedureRequest did body)
  let value = responseJson responseBytes
  let after = storeFingerprint next
  let code = fieldText "error" value
  check
    label
    (code == expectedCode && before == after)
    "error=\{code} state=\{stateWord (before == after)}"

firstHex : String -> String
firstHex text = stringSlice 0 32 text

-- ── driver ──────────────────────────────────────────────────────────────────

{- | The operation appended to a copy of the batch to make it fail: an update
   of a record no operation in the batch created. It is LAST so that the three
   good operations have already been threaded into the intermediate tree when
   it fails — which is what makes "the repository is unchanged" a claim about
   the batch being all-or-nothing rather than about it failing early. -}
doomedElement : Json -> Json
doomedElement value = jObject [
  ("$type", JString (elementType "update")),
  ("collection", JString "app.bsky.feed.post"),
  ("rkey", JString "never-created"),
  ("value", value),
]

runBatch : List String -> <IO, Mint "access", Sign "commit"> Unit
runBatch lines =
  let meta = taggedOne "META" lines
  let did = field 0 meta
  let tids = map (row => field 2 row) (tagged "TID" lines)
  let initialRev = match tids
    first :: _ => mustTid first
    _ => panic "batch_handlers: corpus has no TID rows"
  let batchRev = match tids
    [_, second] => second
    _ => panic "batch_handlers: corpus does not carry exactly two TID rows"
  let ops = tagged "BATCHOP" lines
  let expectedCommitCid = field 3 (taggedOne "BATCHCOMMIT" lines)
  let expectedCarHex = field 0 (taggedOne "BATCHCAR" lines)
  let writes = map writeElement ops
  let expectedCids = map (row => field 3 row) ops
  let firstRecord = match ops
    row :: _ => mustRecordJson (field 2 row)
    _ => panic "batch_handlers: corpus has no BATCHOP rows"
  let server = mustServer (mustAccount did)
  let store =
    authorizedStore did (storeFromRepo (mustRepo did (field 1 meta) initialRev))
  let before = storeFingerprint store
  let (applied, responseBytes) =
    handleBytes
      server
      testContext
      store
      (procedureRequest did (batchBody did writes))
  let value = responseJson responseBytes
  let carHex = match repoExportCar (storeMustRepo applied)
    Ok bytes => encode bytes
    Err message => panic "batch_handlers: repoExportCar failed: \{message}"
  let external =
    check
        "one-commit-cid"
        (commitField "cid" value == expectedCommitCid)
        "cid=\{commitField "cid" value} expected=\{expectedCommitCid}"
      + check
        "one-commit-rev"
        (commitField "rev" value == batchRev)
        "rev=\{commitField "rev" value} expected=\{batchRev}"
      + check
        "result-record-cids"
        (resultCids value == expectedCids)
        "results=\{intToString (length (resultCids value))} expected=\{intToString (length expectedCids)}"
      + check
        "exported-car-bytes"
        (carHex == expectedCarHex)
        "bytes=\{intToString (stringLength carHex / 2)} head=\{firstHex carHex} tail=\{lastHex carHex}"
  let () =
    println "external: \{intToString external}/4 official-atproto batch checks"
  let cells =
    rejectCell
        "swap-commit-mismatch"
        "InvalidSwap"
        did
        server
        store
        (batchBodyWithSwap
          did
          writes
          "bafyreie5737gdxlw5i64vzichcalba3z2v5n6icifvx5xytvske7mr3hpm")
      + rejectCell
        "failing-operation-aborts-batch"
        "InvalidRequest"
        did
        server
        store
        (batchBody did (writes ++ [doomedElement firstRecord]))
      + emptyBatchCell did server store before
  let () =
    println "cells: \{intToString cells}/3 state-preserving batch properties"
  let writes =
    autoRkeyCell did server store scratchRecord
      + absentDeleteCell did server store before
  let () =
    println "writes: \{intToString writes}/2 revision-consistency properties"
  if external == 4 && cells == 3 && writes == 2 then
    println "TOTAL: PASS"
  else
    let () = println "TOTAL: FAIL"
    exit 1

emptyBatchCell : String ->
  Server e ->
  Store ->
  String ->
  <IO, Mint "access" | e> Int
emptyBatchCell did server store before =
  let (after, responseBytes) =
    handleBytes
      server
      testContext
      store
      (procedureRequest did (batchBody did []))
  let value = responseJson responseBytes
  let current = repoLatestCommit (storeMustRepo store)
  check
    "empty-batch-is-a-no-op"
    (storeFingerprint after == before
      && commitField "cid" value == cidToString (repoCommitCid current)
      && commitField "rev" value == tidToString (repoCommitTid current)
      && resultCids value == [])
    "state=\{stateWord (storeFingerprint after == before)} commit=\{commitField "cid" value} rev=\{commitField "rev" value}"

-- ── revision consistency across a batch and the write that follows it ──

autoCreateElement : Json -> Json
autoCreateElement record = jObject [
  ("$type", JString (elementType "create")),
  ("collection", JString scratchCollection),
  ("value", record),
]

absentDeleteElement : Json
absentDeleteElement = jObject [
  ("$type", JString (elementType "delete")),
  ("collection", JString scratchCollection),
  ("rkey", JString "never-created"),
]

createRecordBody : String -> Json -> String
createRecordBody did record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString scratchCollection),
      ("record", record),
    ])

{- | A batch's rkey-less creates and the NEXT rkey-less `createRecord` draw
   their record keys from the same TID sequence the commit revision comes
   from, and this driver's clock is fixed: every key is a function of the
   repository's last commit alone. So a batch that mints keys past its own
   commit revision leaves the next `createRecord` proposing a key the batch
   already consumed -- refused as a duplicate create, and refused on every
   retry until the clock passes it. The commit revision has to clear them. -}
autoRkeyCell : String ->
  Server e ->
  Store ->
  Json ->
  <IO, Mint "access" | e> Int
autoRkeyCell did server store record =
  let (afterBatch, batchBytes) =
    handleBytes
      server
      testContext
      store
      (procedureRequest
        did
        (batchBody did [autoCreateElement record, autoCreateElement record]))
  let batchValue = responseJson batchBytes
  let (_, createBytes) =
    handleBytes
      server
      testContext
      afterBatch
      (procedureRequestTo createRecordNsid did (createRecordBody did record))
  let createValue = responseJson createBytes
  let batchError = fieldText "error" batchValue
  let createError = fieldText "error" createValue
  check
    "auto-rkey-batch-then-createRecord"
    (batchError == "<missing:error>"
      && createError == "<missing:error>"
      && fieldText "uri" createValue /= "<missing:uri>")
    "batch=\{batchError} create=\{createError} uri=\{fieldText "uri" createValue}"

{- | A batch deleting a record that is not there is the idempotent no-op
   `deleteRecord` already promises for the single-record route: the repository
   is unchanged, no commit is signed, and the response carries the CURRENT
   commit. -}
absentDeleteCell : String ->
  Server e ->
  Store ->
  String ->
  <IO, Mint "access" | e> Int
absentDeleteCell did server store before =
  let (after, responseBytes) =
    handleBytes
      server
      testContext
      store
      (procedureRequest did (batchBody did [absentDeleteElement]))
  let value = responseJson responseBytes
  let current = repoLatestCommit (storeMustRepo store)
  check
    "absent-delete-is-idempotent"
    (storeFingerprint after == before
      && fieldText "error" value == "<missing:error>"
      && commitField "cid" value == cidToString (repoCommitCid current)
      && commitField "rev" value == tidToString (repoCommitTid current))
    "state=\{stateWord (storeFingerprint after == before)} error=\{fieldText "error" value} rev=\{commitField "rev" value}"

runRead : Result String (List String) -> <IO, Mint "access", Sign "commit"> Unit
runRead (Err message) = panic "batch_handlers: cannot read corpus: \{message}"
runRead (Ok raw) = runBatch (filter meaningful raw)

runMain : List String -> <Env, FileRead, IO, Mint "access", Sign "commit"> Unit
runMain [corpusPath] = runRead (readLines corpusPath)
runMain _ = panic "usage: batch_handlers_main <ledger-owned-batch-corpus>"

main : <Env, FileRead, IO, Mint "access", Sign "commit"> Unit
main = runMain (args ())
