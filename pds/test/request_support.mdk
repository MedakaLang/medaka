{- | Raw HTTP/1.1 request builders and their small JSON-body helpers, shared
   across the pds route/handler tests that drive `handleBytes` with hand-
   built wire bytes rather than a real socket. The caller passes its own
   `accountHostText` explicitly, since different test files name different
   literal hosts. -}

import bytes as B
import bytes.{Bytes, encodeUtf8}
import http.{maxHttpRequestLineBytes}
import json.{Json(..), jObject, stringify}
import string.{repeat}

export
pathRequest : String -> String -> Bytes
pathRequest host target =
  encodeUtf8 "GET \{target} HTTP/1.1\r\nHost: \{host}\r\n\r\n"

export
queryRequest : String -> String -> Bytes
queryRequest host target =
  encodeUtf8 "GET /xrpc/\{target} HTTP/1.1\r\nHost: \{host}\r\n\r\n"

-- | `token` is the caller's already-minted bearer token (each caller mints
-- it its own way — the label and validity window are test-specific).
export
procedureRequest : String -> String -> String -> String -> Bytes
procedureRequest host token nsid body =
  let bytes = encodeUtf8 body
  encodeUtf8
      "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{host}\r\nAuthorization: Bearer \{token}\r\nContent-Type: application/json\r\nContent-Length: \{intToString (B.length bytes)}\r\n\r\n"
    ++ bytes

-- | A GET whose request line is one byte past `maxHttpRequestLineBytes`, the
-- smallest request the framer refuses for its size rather than its shape.
export
resourceRequest : Bytes
resourceRequest =
  encodeUtf8
    ("GET /"
      ++ repeat maxHttpRequestLineBytes "a"
      ++ " HTTP/1.1\r\nHost: pds.example\r\n\r\n")

export
authOf : String -> String
authOf "" = ""
authOf token = "Authorization: Bearer \{token}\r\n"

export
postJson : String -> String -> String -> String -> Bytes
postJson host token nsid bodyJson =
  encodeUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{host}\r\n\{authOf token}Content-Type: application/json\r\nContent-Length: \{intToString (B.length (encodeUtf8 bodyJson))}\r\n\r\n\{bodyJson}"

export
loginJson : String -> String -> String
loginJson identifier passwordText =
  stringify
    (jObject [
      ("identifier", JString identifier),
      ("password", JString passwordText),
    ])

{- | A write body that replays a pinned transcript record, which is why it
   says `validate: false`: the transcripts key `app.bsky.feed.post` records
   `medaka-a` and `medaka-b`, which are not TIDs, so the reference PDS itself
   refuses them unless grading is off. The keys cannot change, since they are
   inside the pinned repository bytes. -}
export
createBody : String -> String -> String -> Json -> String
createBody did collection rkey record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
      ("record", record),
      ("validate", JBool False),
    ])

export
deleteBody : String -> String -> String -> String
deleteBody did collection rkey =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
    ])
