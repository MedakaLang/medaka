{- | P4-B lexicon-JSON<->DAG-CBOR round-trip driver
   (`pds/test/lexjson_vectors_test.mdk`).

   Graded against the official `@atproto/lex-cbor` + `@atproto/lex-json`
   reference corpus (`pds/test/vectors/lexjson_reference_corpus.txt`), both
   directions per row: decode the reference DAG-CBOR bytes and render them as
   lexicon JSON (must match the reference JSON text exactly), and parse the
   reference JSON text back to DAG-CBOR and re-encode it (must reproduce the
   reference bytes exactly).

   Also runs three hand-written malformed-input cases that
   `pds/lib/lexjson.mdk` must reject rather than silently coerce (its own
   [W-QUIETER] boundary): a duplicate JSON object key, a plain map that
   happens to carry a `"$link"` key without being a link object, and a
   `"$bytes"` value that is not valid base64. -}

import bytes.{Bytes}
import hex.{decode}
import io.{readLines}
import json.{Json(..), jObject, parse, stringify}
import string.{split, startsWith}
import lib.dagcbor.{dagCborDecode, dagCborEncode}
import lib.lexjson.{dagCborToLexJson, lexJsonToDagCbor}

mustHex : String -> Bytes
mustHex text = resultOrPanic "lexjson_vectors: malformed hex" (decode text)

checkForward : String -> Bytes -> String -> <IO> Bool
checkForward name cborBytes jsonText = match dagCborDecode cborBytes
  Err message =>
    let () = println "ROW \{name} FAIL forward-decode \{message}"
    False
  Ok dc =>
    let rendered = stringify (dagCborToLexJson dc)
    if rendered == jsonText then
      True
    else
      let () =
        println
          "ROW \{name} FAIL forward rendered=\{rendered} expected=\{jsonText}"
      False

checkBackwardValue : String -> Bytes -> Json -> <IO> Bool
checkBackwardValue name cborBytes value = match lexJsonToDagCbor value
  Err message =>
    let () = println "ROW \{name} FAIL backward \{message}"
    False
  Ok dc => match dagCborEncode dc
    Err message =>
      let () = println "ROW \{name} FAIL backward-encode \{message}"
      False
    Ok reencoded =>
      if reencoded == cborBytes then
        True
      else
        let () = println "ROW \{name} FAIL backward-mismatch"
        False

checkBackward : String -> Bytes -> String -> <IO> Bool
checkBackward name cborBytes jsonText = match parse jsonText
  Err message =>
    let () = println "ROW \{name} FAIL json-parse \{message}"
    False
  Ok value => checkBackwardValue name cborBytes value

runRow : String -> <IO> Int
runRow line = match split "\t" line
  [name, cborHex, jsonText] =>
    let cborBytes = mustHex cborHex
    let forwardOk = checkForward name cborBytes jsonText
    let backwardOk = checkBackward name cborBytes jsonText
    if forwardOk && backwardOk then
      let () = println "ROW \{name} PASS forward backward"
      1
    else
      0
  _ => panic "lexjson_vectors: malformed corpus row: \{line}"

runRows : List String -> Int -> <IO> Int
runRows [] count = count
runRows (line :: rest) count =
  if line == "" || startsWith "#" line then
    runRows rest count
  else
    runRows rest (count + runRow line)

countCases : List String -> Int -> Int
countCases [] count = count
countCases (line :: rest) count =
  if line == "" || startsWith "#" line then
    countCases rest count
  else
    countCases rest (count + 1)

rejectMalformed : String -> String -> <IO> Int
rejectMalformed label text = match parse text
  Err message =>
    let () = println "MALFORMED \{label} FAIL json-parse \{message}"
    0
  Ok value => match lexJsonToDagCbor value
    Err message =>
      let () = println "MALFORMED \{label} PASS \{message}"
      1
    Ok _ =>
      let () = println "MALFORMED \{label} FAIL accepted"
      0

runMalformed : <IO> Int
runMalformed =
  let checks = [
    rejectMalformed "duplicate-key" "{\"a\":1,\"a\":2}",
    rejectMalformed
      "link-key-on-plain-map"
      "{\"$link\":\"not-a-cid\",\"extra\":true}",
    rejectMalformed "bad-bytes-base64" "{\"$bytes\":\"!!!!\"}",
  ]
  sum checks

-- Duplicate detection cells: the refused shapes and one accepted object,
-- built directly so no JSON text has to be parsed.
keyPairs : List String -> List (String, Json)
keyPairs keys = map (k => (k, JInt 1)) keys

isRefusedDuplicate : List String -> Bool
isRefusedDuplicate keys = match lexJsonToDagCbor (jObject (keyPairs keys))
  Err message => message == "lexjson: duplicate object key"
  Ok _ => False

runDupCells : Int
runDupCells =
  let checks = [
    isRefusedDuplicate ["a", "b", "c", "a"],
    isRefusedDuplicate ["a", "b", "c", "c"],
    isRefusedDuplicate ["a", "a", "b", "c"],
    isRefusedDuplicate ["x", "a", "b", "a", "y"],
    match lexJsonToDagCbor (jObject (keyPairs ["a", "b", "c", "d"]))
      Ok _ => True
      Err _ => False,
  ]
  length (filter (== True) checks)

distinctObject : Int -> Json
distinctObject n = jObject (keyPairs (map (i => "key\{intToString i}") [0..n]))

-- Best of three decisions of an n-field distinct-key object, in seconds.
timeDecision : Int -> <Clock> Float
timeDecision n =
  let obj = distinctObject n
  let one =
    _ =>
      let t0 = monotonicSec ()
      let ok = match lexJsonToDagCbor obj
        Ok _ => True
        Err _ => False
      let t1 = if ok then monotonicSec () else panic "scaling object refused"
      t1 - t0
  min (one ()) (min (one ()) (one ()))

runScaling : <IO, Clock> Bool
runScaling =
  let _warm = timeDecision 1000
  let t1 = timeDecision 10000
  let t2 = timeDecision 20000
  let t4 = timeDecision 40000
  let r1 = t2 / t1
  let r2 = t4 / t2
  let () =
    println "scaling: 10k=\{t1}s 20k=\{t2}s 40k=\{t4}s ratios=\{r1},\{r2}"
  r1 < 3.0 && r2 < 3.0

runCap : <IO, Clock> Unit
runCap =
  let t = timeDecision 19000
  println "cap-19k: \{t}s"

main : <IO, Env, FileRead, Clock> Unit
main = match args ()
  [corpusPath] => match readLines corpusPath
    Err message => panic "lexjson_vectors: cannot read corpus: \{message}"
    Ok rows =>
      let total = countCases rows 0
      let passed = runRows rows 0
      let malformed = runMalformed
      let () =
        println
          "lexjson: \{intToString passed}/\{intToString total} round-trip (both directions)"
      let () = println "malformed: \{intToString malformed}/3 rejected"
      let dups = runDupCells
      let () = println "dup-keys: \{intToString dups}/5"
      let scaled = runScaling
      let () = println "scaling-ok: \{scaled}"
      let () = runCap
      if passed == total && malformed == 3 && dups == 5 && scaled then
        println "TOTAL: PASS"
      else
        let () = println "TOTAL: FAIL"
        exit 1
  _ => panic "usage: lexjson_vectors_main <ledger-owned-corpus>"
