-- Negative opacity cell: a caller must not be able to fabricate an `Sc` from
-- raw limbs. `pds/test/opaque_field_scalar.sh` requires this file to fail.
import lib.scalar.{Sc}

forged : Sc
forged = [|
  0x4141, 0xd036, 0x5e8c, 0xbfd2, 0xa03b, 0xaf48, 0xdce6, 0xbaae, 0xfffe,
  0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff,
|]

consume : Sc -> Unit
consume _ = ()

main =
  let () = consume forged
  println 1
