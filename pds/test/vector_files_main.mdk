{- | Prints the repo-relative files one consumer id owns in the provenance
   ledger, one per line, sorted, each checked against its recorded digest
   first: `vector_files_main <repo-root> <consumer-id>`.

   For a shell script that needs a ledgered corpus path. A lookup that
   fails, including a digest that no longer matches, panics, so the script
   sees a nonzero exit rather than an empty list. -}

import test.vector_ledger.{filesForConsumer}

main : <Exec, FileRead, IO> Unit
main = match args ()
  [root, consumer] => match filesForConsumer root consumer
    Ok files => printEach files
    Err e => panic "vector_files_main: \{e}"
  _ => panic "usage: vector_files_main <repo-root> <consumer-id>"

printEach : List String -> <IO> Unit
printEach [] = ()
printEach (f :: rest) =
  let _ = println f
  printEach rest
