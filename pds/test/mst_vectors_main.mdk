{- | P1-B external MST corpus and hostile-structure driver. -}

import hex.{decode}
import io.{readLines}
import string.{contains, split, startsWith, toInt}
import lib.cid.{Cid, cidEqual, cidFromString, cidToString}
import lib.dagcbor.{DagCbor(..), dagCborEncode}
import lib.mst.{
  Mst,
  mstDelete,
  mstEmpty,
  mstFromEntries,
  mstInsert,
  mstKeyDepth,
  mstNodeBlocks,
  mstReplace,
  mstRootBytes,
  mstRootCid,
  mstValidateBlocks,
  mstValidateNodeBytes,
}

data CaseState = CaseState String Mst (Option Cid) (List (Cid, Array Int))

mustHex : String -> Array Int
mustHex text = match decode text
  Ok bytes => bytes
  Err message => panic "mst_vectors: malformed hex: \{message}"

mustCid : String -> Cid
mustCid text = match cidFromString text
  Ok cid => cid
  Err message => panic "mst_vectors: malformed CID: \{message}"

mustTree : Result String Mst -> Mst
mustTree (Ok tree) = tree
mustTree (Err message) =
  panic "mst_vectors: fixture operation failed: \{message}"

blockPresent : (Cid, Array Int) -> List (Cid, Array Int) -> Bool
blockPresent (cid, bytes) actual = any
  ((candidate, candidateBytes) => cidEqual cid candidate && bytes == candidateBytes)
  actual

sameBlocks : List (Cid, Array Int) -> List (Cid, Array Int) -> Bool
sameBlocks expected actual = length expected == length actual
  && all (expectedBlock => blockPresent expectedBlock actual) expected

gradeCase : CaseState -> <IO> Int
gradeCase (CaseState name tree expectedRoot expectedBlocks) = match expectedRoot
  None => panic "mst_vectors: case \{name} has no ROOT row"
  Some root =>
    let actualBlocks = mstNodeBlocks tree
    let valid = mstValidateBlocks (mstRootCid tree) actualBlocks
    let ok = cidEqual root (mstRootCid tree) && sameBlocks expectedBlocks actualBlocks && valid == Ok ()
    if ok then
      let () = println "CASE \{name} PASS root=\{cidToString root} blocks=\{intToString (length actualBlocks)}"
      1
    else
      let () = println "CASE \{name} FAIL root=\{cidToString (mstRootCid tree)} expected=\{cidToString root} blocks=\{intToString (length actualBlocks)}/\{intToString (length expectedBlocks)} valid=\{debug valid}"
      0

runCorpus : List String -> Option CaseState -> Int -> Int -> <IO> (Int, Int)
runCorpus [] None passed total = (passed, total)
runCorpus [] (Some _) _ _ = panic "mst_vectors: unterminated CASE"
runCorpus (line::rest) current passed total =
  if line == "" || startsWith "#" line then runCorpus rest current passed total
  else match split "\t" line
    ["CASE", name] => match current
      Some _ => panic "mst_vectors: nested CASE"
      None =>
        runCorpus rest (Some (CaseState name mstEmpty None [])) passed total
    ["PUT", keyHex, depthText, valueText] => match current
      None => panic "mst_vectors: PUT outside CASE"
      Some (CaseState name tree root blocks) =>
        let key = mustHex keyHex
        let expectedDepth = match toInt depthText
          Some depth => depth
          None => panic "mst_vectors: invalid fixture depth"
        if mstKeyDepth key /= Ok expectedDepth then
          panic "mst_vectors: fixture depth disagreement"
        else
          runCorpus rest (Some (CaseState name (mustTree (mstInsert key (mustCid valueText) tree)) root blocks)) passed total
    ["REPLACE", keyHex, valueText] => match current
      None => panic "mst_vectors: REPLACE outside CASE"
      Some (CaseState name tree root blocks) => runCorpus rest (Some (CaseState name (mustTree (mstReplace (mustHex keyHex) (mustCid valueText) tree)) root blocks)) passed total
    ["DELETE", keyHex] => match current
      None => panic "mst_vectors: DELETE outside CASE"
      Some (CaseState name tree root blocks) => runCorpus rest (Some (CaseState name (mustTree (mstDelete (mustHex keyHex) tree)) root blocks)) passed total
    ["ROOT", cidText] => match current
      None => panic "mst_vectors: ROOT outside CASE"
      Some (CaseState name tree _ blocks) => runCorpus rest (Some (CaseState name tree (Some (mustCid cidText)) blocks)) passed total
    ["BLOCK", cidText, bytesHex] => match current
      None => panic "mst_vectors: BLOCK outside CASE"
      Some (CaseState name tree root blocks) => runCorpus rest (Some (CaseState name tree root ((mustCid cidText, mustHex bytesHex)::blocks))) passed total
    ["END"] => match current
      None => panic "mst_vectors: END outside CASE"
      Some state => runCorpus rest None (passed + gradeCase state) (total + 1)
    _ => panic "mst_vectors: malformed corpus row: \{line}"

rejectContains : String -> String -> Result String a -> <IO> Int
rejectContains label witness (Err message) =
  if contains witness message then
    let () = println "HOSTILE \{label} PASS route=\{witness}"
    1
  else
    let () = println "HOSTILE \{label} FAIL wrong-route=\{message}"
    0
rejectContains label _ (Ok _) =
  let () = println "HOSTILE \{label} FAIL accepted"
  0

mustNode : DagCbor -> Array Int
mustNode value = match dagCborEncode value
  Ok bytes => bytes
  Err message => panic "mst_vectors: hostile node encoding failed: \{message}"

entryValue : Array Int -> Int -> Cid -> DagCbor
entryValue key prefix value = DcMap
  [("p", DcInt prefix), ("k", DcBytes key), ("v", DcLink value), ("t", DcNull)]

runHostile : <IO> Int
runHostile =
  let keyA = mustHex "6170702e62736b792e666565642e706f73742f7072656669782d612d31"
  let keyB = mustHex "6170702e62736b792e666565642e706f73742f7072656669782d622d30"
  let value = mustCid "bafyreifqadjijwueiii3uzghmdqx4u7zbodkcyfyjvgpaalgp4ck32rmfa"
  let validTree = mustTree (mstInsert keyA value mstEmpty)
  let emptyRoot = mstRootCid mstEmpty
  let badOrder = mustNode (DcMap [
    ("l", DcNull),
    ("e", DcArray [entryValue keyB 0 value, entryValue keyA 0 value]),
  ])
  let badPrefix = mustNode (DcMap [("l", DcNull), ("e", DcArray [entryValue keyA 1 value])])
  let invalidTop = mustNode (DcMap [("l", DcLink emptyRoot), ("e", DcArray [])])
  sum
    [
      rejectContains "empty-key" "empty key" (mstInsert [||] value mstEmpty),
      rejectContains "duplicates" "duplicate key" (mstFromEntries [(keyA, value), (keyA, value)]),
      rejectContains "depth" "depth" (mstValidateNodeBytes 1 True (mstRootBytes validTree)),
      rejectContains "order" "order" (mstValidateNodeBytes 0 True badOrder),
      rejectContains "prefix" "prefix" (mstValidateNodeBytes 0 True badPrefix),
      rejectContains "malformed-links" "identity byte" (mstValidateNodeBytes 1 True (mustHex "a2616580616cd82a4101")),
      rejectContains "truncation" "truncated" (mstValidateNodeBytes 0 True [|0xa2|]),
      rejectContains "unreachable" "unreachable" (mstValidateBlocks (mstRootCid validTree) (mstNodeBlocks validTree ++ mstNodeBlocks mstEmpty)),
      rejectContains "invalid-node" "invalid node form" (mstValidateNodeBytes 1 True invalidTop),
    ]

main : <IO, Env, FileRead "_"> Unit
main = match args ()
  [corpusPath] => match readLines corpusPath
    Err message => panic "mst_vectors: cannot read corpus: \{message}"
    Ok rows =>
      let (external, total) = runCorpus rows None 0 0
      let hostile = runHostile
      let () = println "external: \{intToString external}/\{intToString total} official-reference cases"
      let () = println "hostile: \{intToString hostile}/9 rejected on named routes"
      if external == 11 && total == 11 && hostile == 9 then println "TOTAL: PASS"
      else
        let () = println "TOTAL: FAIL"
        exit 1
  _ => panic "usage: mst_vectors_main <ledger-owned-corpus>"
