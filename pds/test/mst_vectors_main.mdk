{- | P1-B external MST corpus and hostile-structure driver. -}

import array.{drop}
import hex.{decode}
import io.{readLines}
import list.{reverse, sortBy}
import string.{contains, join, split, startsWith, toInt, toUtf8}
import lib.cid.{Cid, cidEqual, cidForDagCbor, cidFromString, cidToString}
import lib.dagcbor.{DagCbor(..), dagCborEncode}
import lib.mst.{
  Mst,
  mstCoveringProofBlocks,
  mstDelete,
  mstEmpty,
  mstFromEntries,
  mstInsert,
  mstKeyDepth,
  mstNodeBlocks,
  mstReplace,
  mstRootBytes,
  mstRootCid,
  mstValidateBlocks,
  mstValidateNodeBytes,
}

data CaseState = CaseState String Mst (Option Cid) (List (Cid, Array Int))

data ProofRow = ProofRow (List (Array Int)) (List String)

data ProofCase = ProofCase String Mst (Option Cid) Int (List ProofRow)

mustHex : String -> Array Int
mustHex text = match decode text
  Ok bytes => bytes
  Err message => panic "mst_vectors: malformed hex: \{message}"

mustCid : String -> Cid
mustCid text = match cidFromString text
  Ok cid => cid
  Err message => panic "mst_vectors: malformed CID: \{message}"

mustTree : Result String Mst -> Mst
mustTree (Ok tree) = tree
mustTree (Err message) =
  panic "mst_vectors: fixture operation failed: \{message}"

blockPresent : (Cid, Array Int) -> List (Cid, Array Int) -> Bool
blockPresent (cid, bytes) actual =
  any
    ((candidate, candidateBytes) =>
      cidEqual cid candidate && bytes == candidateBytes)
    actual

sameBlocks : List (Cid, Array Int) -> List (Cid, Array Int) -> Bool
sameBlocks expected actual =
  length expected == length actual
    && all (expectedBlock => blockPresent expectedBlock actual) expected

gradeCase : CaseState -> <IO> Int
gradeCase (CaseState name tree expectedRoot expectedBlocks) = match expectedRoot
  None => panic "mst_vectors: case \{name} has no ROOT row"
  Some root =>
    let actualBlocks = mstNodeBlocks tree
    let valid = mstValidateBlocks (mstRootCid tree) actualBlocks
    let ok =
      cidEqual root (mstRootCid tree)
        && sameBlocks expectedBlocks actualBlocks
        && valid == Ok ()
    if ok then
      let () =
        println
          "CASE \{name} PASS root=\{cidToString root} blocks=\{intToString (length actualBlocks)}"
      1
    else
      let () =
        println
          "CASE \{name} FAIL root=\{cidToString (mstRootCid tree)} expected=\{cidToString root} blocks=\{intToString (length actualBlocks)}/\{intToString (length expectedBlocks)} valid=\{debug valid}"
      0

runCorpus : List String -> Option CaseState -> Int -> Int -> <IO> (Int, Int)
runCorpus [] None passed total = (passed, total)
runCorpus [] (Some _) _ _ = panic "mst_vectors: unterminated CASE"
runCorpus (line :: rest) current passed total =
  if line == "" || startsWith "#" line then
    runCorpus rest current passed total
  else match split "\t" line
    ["CASE", name] => match current
      Some _ => panic "mst_vectors: nested CASE"
      None =>
        runCorpus rest (Some (CaseState name mstEmpty None [])) passed total
    ["PUT", keyHex, depthText, valueText] => match current
      None => panic "mst_vectors: PUT outside CASE"
      Some (CaseState name tree root blocks) =>
        let key = mustHex keyHex
        let expectedDepth = match toInt depthText
          Some depth => depth
          None => panic "mst_vectors: invalid fixture depth"
        if mstKeyDepth key /= Ok expectedDepth then
          panic "mst_vectors: fixture depth disagreement"
        else
          runCorpus
            rest
            (Some
              (CaseState
                name
                (mustTree (mstInsert key (mustCid valueText) tree))
                root
                blocks))
            passed
            total
    ["REPLACE", keyHex, valueText] => match current
      None => panic "mst_vectors: REPLACE outside CASE"
      Some (CaseState name tree root blocks) =>
        runCorpus
          rest
          (Some
            (CaseState
              name
              (mustTree (mstReplace (mustHex keyHex) (mustCid valueText) tree))
              root
              blocks))
          passed
          total
    ["DELETE", keyHex] => match current
      None => panic "mst_vectors: DELETE outside CASE"
      Some (CaseState name tree root blocks) =>
        runCorpus
          rest
          (Some
            (CaseState
              name
              (mustTree (mstDelete (mustHex keyHex) tree))
              root
              blocks))
          passed
          total
    ["ROOT", cidText] => match current
      None => panic "mst_vectors: ROOT outside CASE"
      Some (CaseState name tree _ blocks) =>
        runCorpus
          rest
          (Some (CaseState name tree (Some (mustCid cidText)) blocks))
          passed
          total
    ["BLOCK", cidText, bytesHex] => match current
      None => panic "mst_vectors: BLOCK outside CASE"
      Some (CaseState name tree root blocks) =>
        runCorpus
          rest
          (Some
            (CaseState
              name
              tree
              root
              ((mustCid cidText, mustHex bytesHex) :: blocks)))
          passed
          total
    ["END"] => match current
      None => panic "mst_vectors: END outside CASE"
      Some state => runCorpus rest None (passed + gradeCase state) (total + 1)
    _ => panic "mst_vectors: malformed corpus row: \{line}"

rejectContains : String -> String -> Result String a -> <IO> Int
rejectContains label witness (Err message) =
  if contains witness message then
    let () = println "HOSTILE \{label} PASS route=\{witness}"
    1
  else
    let () = println "HOSTILE \{label} FAIL wrong-route=\{message}"
    0
rejectContains label _ (Ok _) =
  let () = println "HOSTILE \{label} FAIL accepted"
  0

mustNode : DagCbor -> Array Int
mustNode value = match dagCborEncode value
  Ok bytes => bytes
  Err message => panic "mst_vectors: hostile node encoding failed: \{message}"

entryValueWithTree : Array Int -> Int -> Cid -> DagCbor -> DagCbor
entryValueWithTree key prefix value tree = DcMap [
  ("p", DcInt prefix),
  ("k", DcBytes key),
  ("v", DcLink value),
  ("t", tree),
]

entryValue : Array Int -> Int -> Cid -> DagCbor
entryValue key prefix value = entryValueWithTree key prefix value DcNull

nodeBytes : DagCbor -> List DagCbor -> Array Int
nodeBytes left entries = mustNode (DcMap [("l", left), ("e", DcArray entries)])

nodeBlock : Array Int -> (Cid, Array Int)
nodeBlock bytes = (cidForDagCbor bytes, bytes)

nodeCid : Array Int -> Cid
nodeCid bytes = cidForDagCbor bytes

accepts : String -> Result String Unit -> <IO> Int
accepts label (Ok ()) =
  let () = println "MST CONTROL \{label} PASS"
  1
accepts label (Err message) =
  let () = println "MST CONTROL \{label} FAIL rejected=\{message}"
  0

runHostile : <IO> Int
runHostile =
  let keyA =
    mustHex "6170702e62736b792e666565642e706f73742f7072656669782d612d31"
  let keyB =
    mustHex "6170702e62736b792e666565642e706f73742f7072656669782d622d30"
  let rootLow = toUtf8 "app.bsky.feed.post/range-2"
  let rootHigh = toUtf8 "app.bsky.feed.post/range-3"
  let leftKey = toUtf8 "app.bsky.feed.post/range-1"
  let betweenKey = toUtf8 "app.bsky.feed.post/range-20"
  let rightKey = toUtf8 "app.bsky.feed.post/range-4"
  let depthTwo = toUtf8 "app.bsky.feed.post/medaka-depth-2-31"
  let depthOne = toUtf8 "app.bsky.feed.post/medaka-depth-1-5"
  let value =
    mustCid "bafyreifqadjijwueiii3uzghmdqx4u7zbodkcyfyjvgpaalgp4ck32rmfa"
  let validTree = mustTree (mstInsert keyA value mstEmpty)
  let emptyRoot = mstRootCid mstEmpty
  let badOrder = nodeBytes DcNull [
    entryValue keyB 0 value,
    entryValue (drop 26 keyA) 26 value,
  ]
  let badPrefix = nodeBytes DcNull [entryValue keyA 1 value]
  let undercompressed =
    nodeBytes DcNull [entryValue keyA 0 value, entryValue keyB 0 value]
  let invalidTop = nodeBytes (DcLink emptyRoot) []
  let misplacedLeftChild = nodeBytes DcNull [entryValue rightKey 0 value]
  let misplacedLeftRoot =
    nodeBytes (DcLink (nodeCid misplacedLeftChild)) [entryValue rootLow 0 value]
  let misplacedBetweenChild = nodeBytes DcNull [entryValue rightKey 0 value]
  let misplacedBetweenRoot = nodeBytes DcNull [
    entryValueWithTree rootLow 0 value (DcLink (nodeCid misplacedBetweenChild)),
    entryValue (drop 25 rootHigh) 25 value,
  ]
  let misplacedRightChild = nodeBytes DcNull [entryValue leftKey 0 value]
  let misplacedRightRoot = nodeBytes DcNull [
    entryValueWithTree rootLow 0 value (DcLink (nodeCid misplacedRightChild)),
  ]
  let transitiveGrandchild = nodeBytes DcNull [entryValue rightKey 0 value]
  let transitiveMiddle = nodeBytes DcNull [
    entryValueWithTree depthOne 0 value (DcLink (nodeCid transitiveGrandchild)),
  ]
  let transitiveRoot =
    nodeBytes (DcLink (nodeCid transitiveMiddle)) [entryValue depthTwo 0 value]
  sum [
    rejectContains "empty-key" "empty key" (mstInsert [||] value mstEmpty),
    rejectContains
      "duplicates"
      "duplicate key"
      (mstFromEntries [(keyA, value), (keyA, value)]),
    rejectContains
      "depth"
      "depth"
      (mstValidateNodeBytes 1 True (mstRootBytes validTree)),
    rejectContains "order" "order" (mstValidateNodeBytes 0 True badOrder),
    rejectContains "prefix" "prefix" (mstValidateNodeBytes 0 True badPrefix),
    rejectContains
      "undercompressed"
      "not maximal"
      (mstValidateNodeBytes 0 True undercompressed),
    rejectContains
      "misplaced-left"
      "lexical range"
      (mstValidateBlocks (nodeCid misplacedLeftRoot) [
        nodeBlock misplacedLeftRoot,
        nodeBlock misplacedLeftChild,
      ]),
    rejectContains
      "misplaced-between"
      "lexical range"
      (mstValidateBlocks (nodeCid misplacedBetweenRoot) [
        nodeBlock misplacedBetweenRoot,
        nodeBlock misplacedBetweenChild,
      ]),
    rejectContains
      "misplaced-right"
      "lexical range"
      (mstValidateBlocks (nodeCid misplacedRightRoot) [
        nodeBlock misplacedRightRoot,
        nodeBlock misplacedRightChild,
      ]),
    rejectContains
      "misplaced-transitive"
      "lexical range"
      (mstValidateBlocks (nodeCid transitiveRoot) [
        nodeBlock transitiveRoot,
        nodeBlock transitiveMiddle,
        nodeBlock transitiveGrandchild,
      ]),
    rejectContains
      "malformed-links"
      "identity byte"
      (mstValidateNodeBytes 1 True (mustHex "a2616580616cd82a4101")),
    rejectContains
      "truncation"
      "truncated"
      (mstValidateNodeBytes 0 True [|0xa2|]),
    rejectContains
      "unreachable"
      "unreachable"
      (mstValidateBlocks
        (mstRootCid validTree)
        (mstNodeBlocks validTree ++ mstNodeBlocks mstEmpty)),
    rejectContains
      "invalid-node"
      "invalid node form"
      (mstValidateNodeBytes 1 True invalidTop),
  ]

runControls : <IO> Int
runControls =
  let rootLow = toUtf8 "app.bsky.feed.post/range-2"
  let rootHigh = toUtf8 "app.bsky.feed.post/range-3"
  let leftKey = toUtf8 "app.bsky.feed.post/range-1"
  let betweenKey = toUtf8 "app.bsky.feed.post/range-20"
  let rightKey = toUtf8 "app.bsky.feed.post/range-4"
  let value =
    mustCid "bafyreifqadjijwueiii3uzghmdqx4u7zbodkcyfyjvgpaalgp4ck32rmfa"
  let leftChild = nodeBytes DcNull [entryValue leftKey 0 value]
  let leftRoot =
    nodeBytes (DcLink (nodeCid leftChild)) [entryValue rootLow 0 value]
  let betweenChild = nodeBytes DcNull [entryValue betweenKey 0 value]
  let betweenRoot = nodeBytes DcNull [
    entryValueWithTree rootLow 0 value (DcLink (nodeCid betweenChild)),
    entryValue (drop 25 rootHigh) 25 value,
  ]
  let rightChild = nodeBytes DcNull [entryValue rightKey 0 value]
  let rightRoot = nodeBytes DcNull [
    entryValueWithTree rootHigh 0 value (DcLink (nodeCid rightChild)),
  ]
  sum [
    accepts
      "left-neighbor"
      (mstValidateBlocks (nodeCid leftRoot) [
        nodeBlock leftRoot,
        nodeBlock leftChild,
      ]),
    accepts
      "between-neighbor"
      (mstValidateBlocks (nodeCid betweenRoot) [
        nodeBlock betweenRoot,
        nodeBlock betweenChild,
      ]),
    accepts
      "right-neighbor"
      (mstValidateBlocks (nodeCid rightRoot) [
        nodeBlock rightRoot,
        nodeBlock rightChild,
      ]),
  ]

proofCids : List (Cid, Array Int) -> List String
proofCids blocks = sortBy compare (map ((cid, _) => cidToString cid) blocks)

gradeProofRow : String ->
  Mst ->
  List (Cid, Array Int) ->
  ProofRow ->
  <IO> (Int, Int)
gradeProofRow name tree nodes (ProofRow keys expected) =
  match mstCoveringProofBlocks keys tree
    Err message =>
      let () = println "PROOF \{name} FAIL error=\{message}"
      (0, 0)
    Ok blocks =>
      -- Every returned block must also be one of this tree's own node blocks,
      -- bytes included: a proof that names a block the tree does not contain
      -- would match the reference CID list and still be unverifiable.
      let bound = all (block => blockPresent block nodes) blocks
      if proofCids blocks == expected && bound then
        let narrower = if length blocks < length nodes then 1 else 0
        let () =
          println
            "PROOF \{name} PASS keys=\{intToString (length keys)} blocks=\{intToString (length blocks)}/\{intToString (length nodes)}"
        (1, narrower)
      else
        let () =
          println
            "PROOF \{name} FAIL keys=\{intToString (length keys)} bound=\{debug bound} got=\{join "," (proofCids blocks)} want=\{join "," expected}"
        (0, 0)

gradeProofRows : String ->
  Mst ->
  List (Cid, Array Int) ->
  List ProofRow ->
  (Int, Int) ->
  <IO> (Int, Int)
gradeProofRows _ _ _ [] totals = totals
gradeProofRows name tree nodes (row :: rest) (passed, narrower) =
  let (rowPassed, rowNarrower) = gradeProofRow name tree nodes row
  gradeProofRows name tree nodes rest (
    passed + rowPassed,
    narrower + rowNarrower,
  )

gradeProofCase : ProofCase -> <IO> (Int, Int, Int)
gradeProofCase (ProofCase name tree expectedRoot expectedNodes rows) =
  match expectedRoot
    None => panic "mst_vectors: proof case \{name} has no ROOT row"
    Some root =>
      let nodes = mstNodeBlocks tree
      if not (cidEqual root (mstRootCid tree)) then
        let () =
          println
            "PROOFCASE \{name} FAIL root=\{cidToString (mstRootCid tree)} expected=\{cidToString root}"
        (0, length rows, 0)
      else if length nodes /= expectedNodes then
        let () =
          println
            "PROOFCASE \{name} FAIL nodes=\{intToString (length nodes)} expected=\{intToString expectedNodes}"
        (0, length rows, 0)
      else
        let ordered = reverse rows
        let (passed, narrower) = gradeProofRows name tree nodes ordered (0, 0)
        let () =
          println
            "PROOFCASE \{name} root=\{cidToString root} nodes=\{intToString (length nodes)} rows=\{intToString passed}/\{intToString (length rows)} narrower=\{intToString narrower}"
        (passed, length rows, narrower)

parseProofRow : String -> String -> ProofRow
parseProofRow keysField cidsField =
  ProofRow
    (map mustHex (split "," keysField))
    (sortBy compare (split "," cidsField))

runProofCorpus : List String ->
  Option ProofCase ->
  (Int, Int, Int) ->
  <IO> (Int, Int, Int)
runProofCorpus [] None totals = totals
runProofCorpus [] (Some _) _ = panic "mst_vectors: unterminated proof CASE"
runProofCorpus (line :: rest) current totals =
  if line == "" || startsWith "#" line then
    runProofCorpus rest current totals
  else match split "\t" line
    ["CASE", name] => match current
      Some _ => panic "mst_vectors: nested proof CASE"
      None =>
        runProofCorpus rest (Some (ProofCase name mstEmpty None 0 [])) totals
    ["PUT", keyHex, depthText, valueText] => match current
      None => panic "mst_vectors: proof PUT outside CASE"
      Some (ProofCase name tree root nodes rows) =>
        let key = mustHex keyHex
        let expectedDepth = match toInt depthText
          Some depth => depth
          None => panic "mst_vectors: invalid proof fixture depth"
        if mstKeyDepth key /= Ok expectedDepth then
          panic "mst_vectors: proof fixture depth disagreement"
        else
          runProofCorpus
            rest
            (Some
              (ProofCase
                name
                (mustTree (mstInsert key (mustCid valueText) tree))
                root
                nodes
                rows))
            totals
    ["ROOT", cidText] => match current
      None => panic "mst_vectors: proof ROOT outside CASE"
      Some (ProofCase name tree _ nodes rows) =>
        runProofCorpus
          rest
          (Some (ProofCase name tree (Some (mustCid cidText)) nodes rows))
          totals
    ["NODES", countText] => match current
      None => panic "mst_vectors: NODES outside CASE"
      Some (ProofCase name tree root _ rows) =>
        let count = match toInt countText
          Some value => value
          None => panic "mst_vectors: invalid proof node count"
        runProofCorpus rest (Some (ProofCase name tree root count rows)) totals
    ["PROOF", keysField, cidsField] => match current
      None => panic "mst_vectors: PROOF outside CASE"
      Some (ProofCase name tree root nodes rows) =>
        runProofCorpus
          rest
          (Some
            (ProofCase
              name
              tree
              root
              nodes
              (parseProofRow keysField cidsField :: rows)))
          totals
    ["END"] => match current
      None => panic "mst_vectors: proof END outside CASE"
      Some state =>
        let (passed, rows, narrower) = gradeProofCase state
        let (allPassed, allRows, allNarrower) = totals
        runProofCorpus rest None (
          allPassed + passed,
          allRows + rows,
          allNarrower + narrower,
        )
    _ => panic "mst_vectors: malformed proof corpus row: \{line}"

main : <IO, Env, FileRead "_"> Unit
main = match args ()
  [corpusPath, proofPath] => match (readLines corpusPath, readLines proofPath)
    (Err message, _) => panic "mst_vectors: cannot read corpus: \{message}"
    (_, Err message) =>
      panic "mst_vectors: cannot read proof corpus: \{message}"
    (Ok rows, Ok proofRows) =>
      let (external, total) = runCorpus rows None 0 0
      let (proofs, proofTotal, narrower) =
        runProofCorpus proofRows None (0, 0, 0)
      let hostile = runHostile
      let controls = runControls
      let () =
        println
          "external: \{intToString external}/\{intToString total} official-reference cases"
      let () =
        println
          "covering proofs: \{intToString proofs}/\{intToString proofTotal} official-reference rows"
      let () =
        println
          "narrower than the whole tree: \{intToString narrower}/\{intToString proofTotal} proof rows"
      let () =
        println "hostile: \{intToString hostile}/14 rejected on named routes"
      let () =
        println "controls: \{intToString controls}/3 valid lexical neighbors"
      if external == 11
        && total == 11
        && proofs == 17
        && proofTotal == 17
        && narrower == 13
        && hostile == 14
        && controls == 3 then
        println "TOTAL: PASS"
      else
        let () = println "TOTAL: FAIL"
        exit 1
  _ =>
    panic
      "usage: mst_vectors_main <ledger-owned-corpus> <ledger-owned-proof-corpus>"
