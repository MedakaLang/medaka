{- | Vector-file driver for `stdlib/sha256.mdk` (S-sha256, #1698).
   Grades our SHA-256 against a corpus of NIST/CAVS-style records — never
   against a self-captured golden (G5).

   Usage: sha256_vector_driver [--max-bytes N] <vector-file> [<vector-file> ...]

   Grammar (see pds/test/vectors/sha256_worked_examples.txt for the full
   spec comment; the Len/Msg/MD triple is CAVS's, `Repeat` is this
   project's extension):
     Len = <bits>            authoritative message length, in BITS
     Msg = <lowercase hex>   message bytes (Len=0 records still write "00")
     MD  = <lowercase hex>   expected 64-hex digest
     Repeat = <n>            optional, default 1: message = (Msg bytes)
                             repeated n times; Len is the length of ONE rep
   Any other line (comments, `[L = 32]`, blank lines) is ignored.

   A file whose path contains `Monte` (`SHA256Monte.rsp`) is a CAVS Monte
   Carlo file instead: one `Seed` line followed by 100 `COUNT`/`MD` pairs,
   each `MD` the 1000th hash of a chained rolling-window loop over the
   previous COUNT's answer (SHAVS §6.4) — not a flat Msg->MD pair, so it is
   parsed and graded separately (`parseMonte`/`checkMonte`).

   `--max-bytes N` SKIPS (and counts) any record whose full expanded
   message exceeds N bytes — this is what lets the eval-engine phase of the
   gate run a bounded subset (AGENTS.md: eval is not for a ~210KB corpus).
   For a Monte file this is compared against the fixed 96-byte per-hash
   width (three chained 32-byte digests) rather than a message length, since
   the whole 100000-hash file is one all-or-nothing unit of work.

   Exit 1 if any record failed, or if zero records were checked across all
   files (vacuous-green guard). Exit 0 otherwise. -}

import sha256.{sha256}
import hex.{decode, encode}
import array.{take, make, blit, concat}
import list.{reverse}
import string.{contains, toInt, toLower, trim}
import io.{readLines}

-- ── Record parsing ───────────────────────────────────────────────────

data Record = Record {
  lenBits : Int,
  msgHex : String,
  mdHex : String,
  repeatN : Int,
}

data ParseAcc = ParseAcc {
  lenBits : Option Int,
  msgHex : Option String,
  repeatN : Int,
}

initAcc : ParseAcc
initAcc = ParseAcc { lenBits = None, msgHex = None, repeatN = 1 }

-- `key = value` split on the FIRST `=`; None if the line has no `=` at all
-- (comments, `[L = 32]` still splits — its key "[L" matches nothing below,
-- so it is ignored the same as a true comment).
splitKV : String -> Option (String, String)
splitKV line =
  map
    (i => (
      trim (stringSlice 0 i line),
      trim (stringSlice (i + 1) (stringLength line) line),
    ))
    (stringIndexOf "=" line)

-- Fold one line into the in-progress record accumulator. Returns the
-- (possibly updated) accumulator and, when the line completed a record
-- (the `MD` key), that record — the accumulator resets to `initAcc` then.
applyLine : String -> ParseAcc -> (ParseAcc, Option Record)
applyLine line acc = match splitKV line
  None => (acc, None)
  Some (key, value) =>
    if key == "Len" then
      (ParseAcc { acc | lenBits = toInt value }, None)
    else if key == "Msg" then
      (ParseAcc { acc | msgHex = Some (toLower value) }, None)
    else if key == "Repeat" then match toInt value
      Some n => (ParseAcc { acc | repeatN = n }, None)
      None => (acc, None)
    else if key == "MD" then match (acc.lenBits, acc.msgHex)
      (Some lb, Some mh) => (
        initAcc,
        Some Record {
          lenBits = lb,
          msgHex = mh,
          mdHex = toLower value,
          repeatN = acc.repeatN,
        },
      )
      _ => panic "sha256_vector_driver: MD line with no preceding Len/Msg"
    else
      (acc, None)

parseRecords : List String -> List Record
parseRecords lines = goParse lines initAcc

goParse : List String -> ParseAcc -> List Record
goParse [] _ = []
goParse (line :: rest) acc =
  let (acc', maybeRec) = applyLine line acc
  match maybeRec
    None => goParse rest acc'
    Some r => r :: goParse rest acc'

-- ── Expanding a record into the bytes to hash ───────────────────────

-- First `lenBits/8` bytes of the decoded `Msg` hex, repeated `repeatN`
-- times (F-21's `Len = 0` trap: `Len` decides the byte count, never the
-- raw length of `Msg` — the CAVS files write `Msg = 00` for the empty
-- message).
--
-- Deliberately NOT `concat (replicate repeatN oneRep)`: stdlib's
-- `Array.concat` is documented O(outer * total) (its own `concatLookup`
-- comment, stdlib/array.mdk) — with `outer == total == repeatN` for a
-- 1-byte `oneRep` (the 1,000,000x"a" record), that is O(n^2) and never
-- finishes. `blit`-per-repetition is O(repeatN * lenBytes) = O(total).
-- Reported as a FINDING, not fixed here (out of scope, RUN-PDS0-001 (3)).
expandMsg : Int -> String -> Int -> Array Int
expandMsg lenBits msgHex repeatN =
  let lenBytes = lenBits / 8
  let decoded = match decode msgHex
    Ok bytes => bytes
    Err e => panic "sha256_vector_driver: bad hex in Msg: \{e}"
  let oneRep = take lenBytes decoded
  let n = if repeatN <= 0 then 1 else repeatN
  if n <= 1 then
    oneRep
  else
    let out = make (lenBytes * n) 0
    fillRepeats out oneRep lenBytes n 0
    out

fillRepeats : Array Int -> Array Int -> Int -> Int -> Int -> Unit
fillRepeats out oneRep lenBytes n i =
  if i >= n then
    ()
  else
    blit oneRep 0 out (i * lenBytes) lenBytes
    fillRepeats out oneRep lenBytes n (i + 1)

fullByteLength : Record -> Int
fullByteLength r = r.lenBits / 8 * (if r.repeatN <= 0 then 1 else r.repeatN)

-- ── Monte Carlo records (SHAVS §6.4) ────────────────────────────────

{- | A CAVS Monte Carlo file (`SHA256Monte.rsp`) is one `Seed`, followed by
   100 `COUNT`/`MD` pairs — NOT a flat Msg->MD pair like the Len/Msg/MD
   grammar above, so it needs its own parse and its own check. Detected by
   the file's own path, since the grammar has no `Msg` line to key off of. -}
isMonteFile : String -> Bool
isMonteFile path = contains "Monte" path

-- (seed hex, expected MD hexes in COUNT order). `COUNT`'s own numeric value
-- is not read back — the file's line order is what the algorithm below
-- walks, and NIST's own generator never reorders it.
parseMonte : List String -> (Option String, List String)
parseMonte lns = goMonte lns None []

goMonte : List String ->
  Option String ->
  List String ->
  (Option String, List String)
goMonte [] seed acc = (seed, reverse acc)
goMonte (line :: rest) seed acc = match splitKV line
  None => goMonte rest seed acc
  Some (key, value) =>
    if key == "Seed" then
      goMonte rest (Some (toLower value)) acc
    else if key == "MD" then
      goMonte rest seed (toLower value :: acc)
    else
      goMonte rest seed acc

-- One Monte Carlo inner loop (SHAVS §6.4): 1000 chained hashes over a
-- 3-digest rolling window, seeded three-wide from the running checkpoint.
-- Returns the 1000th hash, which becomes both this COUNT's answer and the
-- next COUNT's checkpoint.
monteStep : Array Int -> Array Int -> Array Int -> Int -> Array Int
monteStep md0 md1 md2 remaining =
  if remaining <= 0 then
    md2
  else
    let mi = sha256 (concat [|md0, md1, md2|])
    monteStep md1 md2 mi (remaining - 1)

-- The 100 COUNT answers, each COUNT's checkpoint carried into the next.
monteRun : Array Int -> Int -> List (Array Int)
monteRun seed n =
  if n <= 0 then
    []
  else
    let md = monteStep seed seed seed 1000
    md :: monteRun md (n - 1)

-- checked, failed, skipped, mirroring `checkRecords`'s tuple — a Monte file
-- contributes exactly one skip-or-check decision per COUNT, since the
-- 1000-iteration inner loop cannot be graded one COUNT at a time without
-- doing the same work `maxBytes` exists to avoid on the fast eval arm. The
-- per-hash width (96 bytes: three chained 32-byte digests) is what
-- `maxBytes` is compared against.
checkMonte : String -> Int -> List String -> <IO> (Int, Int, Int)
checkMonte path maxBytes lns =
  let (seedOpt, expected) = parseMonte lns
  let n = length expected
  match seedOpt
    None => panic "sha256_vector_driver: Monte file missing Seed"
    Some seedHex =>
      if maxBytes >= 0 && 96 > maxBytes then
        (0, 0, n)
      else
        let seedBytes = match decode seedHex
          Ok b => b
          Err e => panic "sha256_vector_driver: bad hex in Seed: \{e}"
        let actual = map encode (monteRun seedBytes n)
        let failed = countMonteMismatches path 0 expected actual
        (n, failed, 0)

countMonteMismatches : String -> Int -> List String -> List String -> <IO> Int
countMonteMismatches path i [] [] = 0
countMonteMismatches path i (e :: erest) (a :: arest) =
  let rest = countMonteMismatches path (i + 1) erest arest
  if e == a then
    rest
  else
    println "MISMATCH \{path} COUNT=\{intToString i} expected=\{e} actual=\{a}"
    rest + 1
countMonteMismatches path i _ _ =
  panic "sha256_vector_driver: Monte expected/actual count mismatch"

-- ── Grading one file ─────────────────────────────────────────────────

-- checked, failed, skipped — (-1) `maxBytes` means unlimited.
checkRecords : String -> Int -> List Record -> <IO> (Int, Int, Int)
checkRecords path maxBytes [] = (0, 0, 0)
checkRecords path maxBytes (r :: rest) =
  if maxBytes >= 0 && fullByteLength r > maxBytes then
    let (c, f, s) = checkRecords path maxBytes rest
    (c, f, s + 1)
  else
    let actual = encode (sha256 (expandMsg r.lenBits r.msgHex r.repeatN))
    let (c, f, s) = checkRecords path maxBytes rest
    if actual == r.mdHex then
      (c + 1, f, s)
    else
      println
        "MISMATCH \{path} Len=\{r.lenBits} Repeat=\{r.repeatN} expected=\{r.mdHex} actual=\{actual}"
      (c + 1, f + 1, s)

runFile : String -> Int -> <IO, FileRead "_"> Result String (Int, Int, Int)
runFile path maxBytes =
  if isMonteFile path then
    map (checkMonte path maxBytes) (readLines path)
  else
    map
      (lines => checkRecords path maxBytes (parseRecords lines))
      (readLines path)

printFileSummary : String -> Int -> Int -> Int -> <IO> Unit
printFileSummary path checked failed skipped =
  println "\{path}: \{checked} ok, \{failed} failed, \{skipped} skipped"

-- ── Driving all files, then the process exit code ───────────────────

runAll : List String -> Int -> Int -> Int -> Int -> <IO, FileRead "_"> Unit
runAll [] maxBytes totalChecked totalFailed totalSkipped =
  if totalFailed > 0 || totalChecked == 0 then exit 1 else exit 0
runAll (f :: rest) maxBytes totalChecked totalFailed totalSkipped =
  match runFile f maxBytes
    Err e =>
      println "ERROR reading \{f}: \{e}"
      exit 1
    Ok (c, fl, s) =>
      printFileSummary f c fl s
      runAll
        rest
        maxBytes
        (totalChecked + c)
        (totalFailed + fl)
        (totalSkipped + s)

parseArgs : List String -> (Int, List String)
parseArgs ("--max-bytes" :: nStr :: rest) = match toInt nStr
  Some n => (n, rest)
  None => panic "sha256_vector_driver: --max-bytes needs an integer argument"
parseArgs files = (-1, files)

main : <IO, Env, FileRead "_"> Unit
main =
  let (maxBytes, files) = parseArgs (args ())
  if files == [] then
    let _ =
      println
        "usage: sha256_vector_driver [--max-bytes N] <vector-file> [<vector-file> ...]"
    exit 2
  else
    runAll files maxBytes 0 0 0
