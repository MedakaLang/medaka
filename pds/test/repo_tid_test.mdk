{- | Structural TID and pre-sign repository admission tests.
   Protocol answer bytes remain only in the provenance-ledgered corpus. -}

import string.{contains}
import test.{expectEach, expectEqual, expectOkThen, expectTrue}
import lib.nsid.{validateNsid}
import lib.repo.{repoInitFromKeyBytes}
import lib.tid.{
  Tid,
  tidClockId,
  tidCompare,
  tidEncode,
  tidMicros,
  tidNext,
  tidParse,
  tidToString,
}

errContains : String -> Result String a -> Bool
errContains witness (Err message) = contains witness message
errContains _ (Ok _) = False

mustTid : Int -> Int -> Tid
mustTid micros clockId =
  resultOrPanic "repo_tid_test: setup failed" (tidEncode micros clockId)

test "TID encode and parse preserve timestamp clock and spelling" =
  let tid = mustTid 1700000000000000 7
  expectOkThen
    (parsed => expectEach [
      (
        "tidMicros parsed == 1700000000000000",
        expectEqual 1700000000000000 (tidMicros parsed),
      ),
      ("tidClockId parsed == 7", expectEqual 7 (tidClockId parsed)),
      ("tidCompare tid parsed == Eq", expectEqual Eq (tidCompare tid parsed)),
    ])
    (tidParse (tidToString tid))

test "TID lexical order follows microsecond order" =
  expectTrue
    (tidCompare (mustTid 1700000000000000 0) (mustTid 1700000000000001 0) == Lt)

test "TID monotonic next advances a backwards proposal" =
  let prior = mustTid 1700000000000000 7
  expectOkThen
    (next => expectEach [
      (
        "tidMicros next == 1700000000000001",
        expectEqual 1700000000000001 (tidMicros next),
      ),
      ("tidClockId next == 9", expectEqual 9 (tidClockId next)),
    ])
    (tidNext prior 1699999999999999 9)

test "TID monotonic next preserves a newer proposal" =
  let prior = mustTid 1700000000000000 7
  expectEqual
    (map tidToString (tidNext prior 1700000000000100 11))
    (map tidToString (tidEncode 1700000000000100 11))

test "TID parser rejects length alphabet high bit and range" =
  expectTrue
    (errContains "13" (tidParse "3ke6kg3wk222")
      && errContains "alphabet" (tidParse "3ke6kg3wk2220")
      && errContains "high bit" (tidParse "k222222222222")
      && errContains "53-bit" (tidParse "c222222222222"))

test "TID encoder rejects timestamp and clock ranges" =
  expectTrue
    (isErr (tidEncode (-1) 0)
      && isErr (tidEncode 9007199254740992 0)
      && isErr (tidEncode 0 (-1))
      && isErr (tidEncode 0 1024))

test "repository rejects invalid DID before signing" =
  expectTrue
    (errContains
      "invalid DID"
      (repoInitFromKeyBytes "not-a-did" (arrayMake 32 1) (mustTid 1 0)))

test "repository rejects invalid signing key before commit construction" =
  expectTrue
    (errContains
      "bad signing key"
      (repoInitFromKeyBytes "did:plc:medaka" (arrayMake 32 0) (mustTid 1 0)))

test "shared generic NSID authority accepts uppercase while retaining lowercase form" =
  expectTrue
    (not (isErr (validateNsid "Com.AtProto.test"))
      && not (isErr (validateNsid "com.atproto.test")))
