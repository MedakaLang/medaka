{- | Structural TID and pre-sign repository admission tests, and the
   revision a write commits at, driven through the record-write handler at a
   chosen clock. Protocol answer bytes remain only in the provenance-ledgered
   corpus. -}

import bytes.{encodeUtf8, fromU8Array}
import json.{Json(..), jObject}
import list.{replicate}
import string.{contains, join, repeat}
import test.{
  Expectation,
  expectEach,
  expectEqual,
  expectFalse,
  expectOkThen,
  expectTrue,
  fail,
}
import lib.handlers.{recordHandler}
import lib.nsid.{nsidErrorMessage, validateNsid}
import lib.repo.{
  repoCommitTid,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoLookup,
}
import lib.server_core.{Account, AuthOutcome(..), makeAccount}
import lib.store.{Store, storeFromRepo, storeRepo}
import lib.xrpc.{XrpcCall(..)}
import test.fixture_support.{contextAt}
import lib.tid.{
  Tid,
  tidClockId,
  tidCompare,
  tidEncode,
  tidMicros,
  tidNext,
  tidParse,
  tidToString,
}

errContains : String -> Result String a -> Bool
errContains witness (Err message) = contains witness message
errContains _ (Ok _) = False

mustTid : Int -> Int -> Tid
mustTid micros clockId =
  resultOrPanic "repo_tid_test: setup failed" (tidEncode micros clockId)

test "TID encode and parse preserve timestamp clock and spelling" =
  let tid = mustTid 1700000000000000 7
  expectOkThen
    (parsed => expectEach [
      (
        "tidMicros parsed == 1700000000000000",
        expectEqual 1700000000000000 (tidMicros parsed),
      ),
      ("tidClockId parsed == 7", expectEqual 7 (tidClockId parsed)),
      ("tidCompare tid parsed == Eq", expectEqual Eq (tidCompare tid parsed)),
    ])
    (tidParse (tidToString tid))

test "TID lexical order follows microsecond order" =
  expectEqual
    Lt
    (tidCompare (mustTid 1700000000000000 0) (mustTid 1700000000000001 0))

test "TID monotonic next advances a backwards proposal" =
  let prior = mustTid 1700000000000000 7
  expectOkThen
    (next => expectEach [
      (
        "tidMicros next == 1700000000000001",
        expectEqual 1700000000000001 (tidMicros next),
      ),
      ("tidClockId next == 9", expectEqual 9 (tidClockId next)),
    ])
    (tidNext prior 1699999999999999 9)

test "TID monotonic next preserves a newer proposal" =
  let prior = mustTid 1700000000000000 7
  expectEqual
    (map tidToString (tidNext prior 1700000000000100 11))
    (map tidToString (tidEncode 1700000000000100 11))

test "TID monotonic next falls back to the successor when the proposal cannot be encoded" =
  let prior = mustTid 1700000000000000 7
  expectEach [
    (
      "before 1970",
      expectEqual
        (map tidToString (tidEncode 1700000000000001 9))
        (map tidToString (tidNext prior (0 - 1) 9)),
    ),
    (
      "past 2^53 microseconds",
      expectEqual
        (map tidToString (tidEncode 1700000000000001 9))
        (map tidToString (tidNext prior 9007199254740992 9)),
    ),
  ]

test "TID parser rejects length alphabet high bit and range" = expectEach [
  (
    "a 12-character TID is rejected for its length",
    expectTrue (errContains "13" (tidParse "3ke6kg3wk222")),
  ),
  (
    "a character outside the base32-sortable alphabet is rejected",
    expectTrue (errContains "alphabet" (tidParse "3ke6kg3wk2220")),
  ),
  (
    "a leading character with the high bit set is rejected",
    expectTrue (errContains "high bit" (tidParse "k222222222222")),
  ),
  (
    "a timestamp past 53 bits is rejected",
    expectTrue (errContains "53-bit" (tidParse "c222222222222")),
  ),
]

test "TID encoder rejects timestamp and clock ranges" = expectEach [
  ("a negative timestamp is rejected", expectTrue (isErr (tidEncode (-1) 0))),
  (
    "a timestamp past 2^53 is rejected",
    expectTrue (isErr (tidEncode 9007199254740992 0)),
  ),
  ("a negative clock id is rejected", expectTrue (isErr (tidEncode 0 (-1)))),
  ("a clock id past 10 bits is rejected", expectTrue (isErr (tidEncode 0 1024))),
]

test "repository rejects invalid DID before signing" =
  expectTrue
    (errContains
      "invalid DID"
      (repoInitFromKeyBytes
        "not-a-did"
        (fromU8Array (arrayMake 32 1))
        (mustTid 1 0)))

test "repository rejects invalid signing key before commit construction" =
  expectTrue
    (errContains
      "bad signing key"
      (repoInitFromKeyBytes
        "did:plc:medaka"
        (fromU8Array (arrayMake 32 0))
        (mustTid 1 0)))

test "shared generic NSID authority accepts uppercase while retaining lowercase form" = expectEach
  [
    (
      "a mixed-case authority is accepted",
      expectFalse (isErr (validateNsid "Com.AtProto.test")),
    ),
    (
      "the lowercase spelling is still accepted",
      expectFalse (isErr (validateNsid "com.atproto.test")),
    ),
  ]

nsidWithAuthorityOf : Int -> String
nsidWithAuthorityOf segments =
  join "." (replicate segments (repeat 63 "a") ++ ["name"])

nsidVerdict : String -> Result String Unit
nsidVerdict nsid = mapErr nsidErrorMessage (validateNsid nsid)

test "an NSID authority is bounded only by the 317-character total" = expectEach
  [
    (
      "four 63-character segments plus a name (260 characters) are accepted",
      expectEqual (Ok ()) (nsidVerdict (nsidWithAuthorityOf 4)),
    ),
    (
      "a total past 317 characters is refused",
      expectEqual
        (Err "collection NSID exceeds 317 characters")
        (nsidVerdict (nsidWithAuthorityOf 5)),
    ),
  ]

-- # The revision a write commits at

revisionDid : String
revisionDid = "did:plc:medakarevision"

revisionAccount : Account
revisionAccount =
  resultOrPanic
    "repo_tid_test: account setup failed"
    (makeAccount revisionDid "medaka.example" "pds.example")

-- The latest commit's revision: exactly second 1700000100, clock id 7.
priorSeconds : Int
priorSeconds = 1700000100

priorStore : Store
priorStore =
  storeFromRepo
    (resultOrPanic
      "repo_tid_test: repository setup failed"
      (repoInitFromKeyBytes
        revisionDid
        (fromU8Array (arrayMake 32 1))
        (mustTid (priorSeconds * 1000000) 7)))

postValue : Json
postValue = jObject [
  ("$type", JString "app.bsky.feed.post"),
  ("text", JString "hello"),
  ("createdAt", JString "2023-11-14T22:15:00Z"),
]

createWithoutRkey : Json
createWithoutRkey = jObject [
  ("repo", JString revisionDid),
  ("collection", JString "app.bsky.feed.post"),
  ("record", postValue),
]

batchCreate : Json
batchCreate = jObject [
  ("$type", JString "com.atproto.repo.applyWrites#create"),
  ("collection", JString "app.bsky.feed.post"),
  ("value", postValue),
]

threeCreates : Json
threeCreates = jObject [
  ("repo", JString revisionDid),
  ("writes", JArray (arrayFromList [batchCreate, batchCreate, batchCreate])),
]

writeAt : Int -> String -> Json -> Store -> Store
writeAt seconds nsid body store =
  let (next, _) =
    recordHandler
      revisionAccount
      (contextAt seconds 1)
      Unauthenticated
      store
      (ProcedureJsonCall nsid [] body)
  next

createAt : Int -> Store -> Store
createAt seconds =
  writeAt seconds "com.atproto.repo.createRecord" createWithoutRkey

latestRevision : Store -> Option Int
latestRevision store =
  map
    (repo => tidMicros (repoCommitTid (repoLatestCommit repo)))
    (storeRepo store)

keyPresent : Store -> Int -> Expectation
keyPresent store micros = match storeRepo store
  None => fail "the store holds no repository"
  Some repo =>
    let key = "app.bsky.feed.post/\{tidToString (mustTid micros 7)}"
    expectEqual (Ok True) (map isSome (repoLookup (encodeUtf8 key) repo))

test "a clock behind the latest commit still advances the revision" =
  let stepped = createAt (priorSeconds - 3600) priorStore
  expectEqual (Some (priorSeconds * 1000000 + 1)) (latestRevision stepped)

test "a clock that steps back after a clock-based write keeps the revision rising" =
  let ahead = createAt (priorSeconds + 60) priorStore
  let back = createAt priorSeconds ahead
  expectEach [
    (
      "the first write commits at its clock",
      expectEqual (Some ((priorSeconds + 60) * 1000000)) (latestRevision ahead),
    ),
    (
      "the stepped-back write commits one microsecond later",
      expectEqual
        (Some ((priorSeconds + 60) * 1000000 + 1))
        (latestRevision back),
    ),
  ]

test "three rkey-less creates in one batch get three distinct keys" =
  let clock = priorSeconds + 1
  let batched =
    writeAt clock "com.atproto.repo.applyWrites" threeCreates priorStore
  expectEach [
    ("the first key is the clock", keyPresent batched (clock * 1000000)),
    ("the second key follows it", keyPresent batched (clock * 1000000 + 1)),
    ("the third key follows that", keyPresent batched (clock * 1000000 + 2)),
    (
      "the commit lands past every key",
      expectEqual (Some (clock * 1000000 + 3)) (latestRevision batched),
    ),
  ]

test "a clock one second past the latest commit sets the revision" =
  let clock = priorSeconds + 1
  let first = createAt clock priorStore
  let second = createAt clock first
  expectEach [
    (
      "the first write in that second commits at its start",
      expectEqual (Some (clock * 1000000)) (latestRevision first),
    ),
    (
      "a second write in that second leads the clock by one microsecond",
      expectEqual (Some (clock * 1000000 + 1)) (latestRevision second),
    ),
  ]
