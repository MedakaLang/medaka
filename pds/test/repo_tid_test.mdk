{- | Structural TID and pre-sign repository admission tests, the revision a
   write commits at, driven through the record-write handler at a chosen
   clock, and the export ceilings a commit's persist must stay within, driven
   through `repoAddedBlocksWithin` at ceilings small enough to cross with a
   record or two. Protocol answer bytes remain only in the
   provenance-ledgered corpus. -}

import bytes as B
import bytes.{Bytes, encodeUtf8, fromU8Array}
import json.{Json(..), jObject}
import list.{replicate}
import string.{contains, join, repeat}
import test.{
  Expectation,
  expectEach,
  expectEqual,
  expectFalse,
  expectGreaterThan,
  expectOkThen,
  expectTrue,
  fail,
}
import lib.dagcbor.{DagCbor(..)}
import lib.handlers.{recordHandler}
import lib.mst.{mstNodeBlocks}
import lib.nsid.{nsidErrorMessage, validateNsid}
import lib.repo.{
  Repo,
  RepoCeilings(..),
  RepoMutation,
  repoAddedBlocksWithin,
  repoCommitTid,
  repoCreate,
  repoDelete,
  repoExportBlocks,
  repoExportCar,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoLookup,
  repoMutationState,
  repoTree,
  repoUpdate,
}
import lib.server_core.{Account, AuthOutcome(..), makeAccount}
import lib.store.{Store, storeFromRepo, storeRepo}
import lib.xrpc.{XrpcCall(..)}
import test.fixture_support.{contextAt}
import lib.tid.{
  Tid,
  tidClockId,
  tidCompare,
  tidEncode,
  tidMicros,
  tidNext,
  tidParse,
  tidToString,
}

errContains : String -> Result String a -> Bool
errContains witness (Err message) = contains witness message
errContains _ (Ok _) = False

mustTid : Int -> Int -> Tid
mustTid micros clockId =
  resultOrPanic "repo_tid_test: setup failed" (tidEncode micros clockId)

test "TID encode and parse preserve timestamp clock and spelling" =
  let tid = mustTid 1700000000000000 7
  expectOkThen
    (parsed => expectEach [
      (
        "tidMicros parsed == 1700000000000000",
        expectEqual 1700000000000000 (tidMicros parsed),
      ),
      ("tidClockId parsed == 7", expectEqual 7 (tidClockId parsed)),
      ("tidCompare tid parsed == Eq", expectEqual Eq (tidCompare tid parsed)),
    ])
    (tidParse (tidToString tid))

test "TID lexical order follows microsecond order" =
  expectEqual
    Lt
    (tidCompare (mustTid 1700000000000000 0) (mustTid 1700000000000001 0))

test "TID monotonic next advances a backwards proposal" =
  let prior = mustTid 1700000000000000 7
  expectOkThen
    (next => expectEach [
      (
        "tidMicros next == 1700000000000001",
        expectEqual 1700000000000001 (tidMicros next),
      ),
      ("tidClockId next == 9", expectEqual 9 (tidClockId next)),
    ])
    (tidNext prior 1699999999999999 9)

test "TID monotonic next preserves a newer proposal" =
  let prior = mustTid 1700000000000000 7
  expectEqual
    (map tidToString (tidNext prior 1700000000000100 11))
    (map tidToString (tidEncode 1700000000000100 11))

test "TID monotonic next falls back to the successor when the proposal cannot be encoded" =
  let prior = mustTid 1700000000000000 7
  expectEach [
    (
      "before 1970",
      expectEqual
        (map tidToString (tidEncode 1700000000000001 9))
        (map tidToString (tidNext prior (0 - 1) 9)),
    ),
    (
      "past 2^53 microseconds",
      expectEqual
        (map tidToString (tidEncode 1700000000000001 9))
        (map tidToString (tidNext prior 9007199254740992 9)),
    ),
  ]

test "TID parser rejects length alphabet high bit and range" = expectEach [
  (
    "a 12-character TID is rejected for its length",
    expectTrue (errContains "13" (tidParse "3ke6kg3wk222")),
  ),
  (
    "a character outside the base32-sortable alphabet is rejected",
    expectTrue (errContains "alphabet" (tidParse "3ke6kg3wk2220")),
  ),
  (
    "a leading character with the high bit set is rejected",
    expectTrue (errContains "high bit" (tidParse "k222222222222")),
  ),
  (
    "a timestamp past 53 bits is rejected",
    expectTrue (errContains "53-bit" (tidParse "c222222222222")),
  ),
]

test "TID encoder rejects timestamp and clock ranges" = expectEach [
  ("a negative timestamp is rejected", expectTrue (isErr (tidEncode (-1) 0))),
  (
    "a timestamp past 2^53 is rejected",
    expectTrue (isErr (tidEncode 9007199254740992 0)),
  ),
  ("a negative clock id is rejected", expectTrue (isErr (tidEncode 0 (-1)))),
  ("a clock id past 10 bits is rejected", expectTrue (isErr (tidEncode 0 1024))),
]

test "repository rejects invalid DID before signing" =
  expectTrue
    (errContains
      "invalid DID"
      (repoInitFromKeyBytes
        "not-a-did"
        (fromU8Array (arrayMake 32 1))
        (mustTid 1 0)))

test "repository rejects invalid signing key before commit construction" =
  expectTrue
    (errContains
      "bad signing key"
      (repoInitFromKeyBytes
        "did:plc:medaka"
        (fromU8Array (arrayMake 32 0))
        (mustTid 1 0)))

test "shared generic NSID authority accepts uppercase while retaining lowercase form" = expectEach
  [
    (
      "a mixed-case authority is accepted",
      expectFalse (isErr (validateNsid "Com.AtProto.test")),
    ),
    (
      "the lowercase spelling is still accepted",
      expectFalse (isErr (validateNsid "com.atproto.test")),
    ),
  ]

nsidWithAuthorityOf : Int -> String
nsidWithAuthorityOf segments =
  join "." (replicate segments (repeat 63 "a") ++ ["name"])

nsidVerdict : String -> Result String Unit
nsidVerdict nsid = mapErr nsidErrorMessage (validateNsid nsid)

test "an NSID authority is bounded only by the 317-character total" = expectEach
  [
    (
      "four 63-character segments plus a name (260 characters) are accepted",
      expectEqual (Ok ()) (nsidVerdict (nsidWithAuthorityOf 4)),
    ),
    (
      "a total past 317 characters is refused",
      expectEqual
        (Err "collection NSID exceeds 317 characters")
        (nsidVerdict (nsidWithAuthorityOf 5)),
    ),
  ]

-- # The revision a write commits at

revisionDid : String
revisionDid = "did:plc:medakarevision"

revisionAccount : Account
revisionAccount =
  resultOrPanic
    "repo_tid_test: account setup failed"
    (makeAccount revisionDid "medaka.example" "pds.example")

-- The latest commit's revision: exactly second 1700000100, clock id 7.
priorSeconds : Int
priorSeconds = 1700000100

priorStore : Store
priorStore =
  storeFromRepo
    (resultOrPanic
      "repo_tid_test: repository setup failed"
      (repoInitFromKeyBytes
        revisionDid
        (fromU8Array (arrayMake 32 1))
        (mustTid (priorSeconds * 1000000) 7)))

postValue : Json
postValue = jObject [
  ("$type", JString "app.bsky.feed.post"),
  ("text", JString "hello"),
  ("createdAt", JString "2023-11-14T22:15:00Z"),
]

createWithoutRkey : Json
createWithoutRkey = jObject [
  ("repo", JString revisionDid),
  ("collection", JString "app.bsky.feed.post"),
  ("record", postValue),
]

batchCreate : Json
batchCreate = jObject [
  ("$type", JString "com.atproto.repo.applyWrites#create"),
  ("collection", JString "app.bsky.feed.post"),
  ("value", postValue),
]

threeCreates : Json
threeCreates = jObject [
  ("repo", JString revisionDid),
  ("writes", JArray (arrayFromList [batchCreate, batchCreate, batchCreate])),
]

writeAt : Int -> String -> Json -> Store -> Store
writeAt seconds nsid body store =
  let (next, _) =
    recordHandler
      revisionAccount
      (contextAt seconds 1)
      Unauthenticated
      store
      (ProcedureJsonCall nsid [] body)
  next

createAt : Int -> Store -> Store
createAt seconds =
  writeAt seconds "com.atproto.repo.createRecord" createWithoutRkey

latestRevision : Store -> Option Int
latestRevision store =
  map
    (repo => tidMicros (repoCommitTid (repoLatestCommit repo)))
    (storeRepo store)

keyPresent : Store -> Int -> Expectation
keyPresent store micros = match storeRepo store
  None => fail "the store holds no repository"
  Some repo =>
    let key = "app.bsky.feed.post/\{tidToString (mustTid micros 7)}"
    expectEqual (Ok True) (map isSome (repoLookup (encodeUtf8 key) repo))

test "a clock behind the latest commit still advances the revision" =
  let stepped = createAt (priorSeconds - 3600) priorStore
  expectEqual (Some (priorSeconds * 1000000 + 1)) (latestRevision stepped)

test "a clock that steps back after a clock-based write keeps the revision rising" =
  let ahead = createAt (priorSeconds + 60) priorStore
  let back = createAt priorSeconds ahead
  expectEach [
    (
      "the first write commits at its clock",
      expectEqual (Some ((priorSeconds + 60) * 1000000)) (latestRevision ahead),
    ),
    (
      "the stepped-back write commits one microsecond later",
      expectEqual
        (Some ((priorSeconds + 60) * 1000000 + 1))
        (latestRevision back),
    ),
  ]

test "three rkey-less creates in one batch get three distinct keys" =
  let clock = priorSeconds + 1
  let batched =
    writeAt clock "com.atproto.repo.applyWrites" threeCreates priorStore
  expectEach [
    ("the first key is the clock", keyPresent batched (clock * 1000000)),
    ("the second key follows it", keyPresent batched (clock * 1000000 + 1)),
    ("the third key follows that", keyPresent batched (clock * 1000000 + 2)),
    (
      "the commit lands past every key",
      expectEqual (Some (clock * 1000000 + 3)) (latestRevision batched),
    ),
  ]

test "a clock one second past the latest commit sets the revision" =
  let clock = priorSeconds + 1
  let first = createAt clock priorStore
  let second = createAt clock first
  expectEach [
    (
      "the first write in that second commits at its start",
      expectEqual (Some (clock * 1000000)) (latestRevision first),
    ),
    (
      "a second write in that second leads the clock by one microsecond",
      expectEqual (Some (clock * 1000000 + 1)) (latestRevision second),
    ),
  ]

-- # The export ceilings a commit must stay within

ceilingTid : Int -> Tid
ceilingTid step = mustTid (1700000000000000 + step) 0

ceilingRepo : Repo
ceilingRepo =
  resultOrPanic
    "repo_tid_test: ceiling repository setup failed"
    (repoInitFromKeyBytes
      "did:plc:medakaceiling"
      (fromU8Array (arrayMake 32 1))
      (ceilingTid 0))

ceilingPath : String -> Bytes
ceilingPath rkey = encodeUtf8 "app.bsky.feed.post/\{rkey}"

ceilingRecord : String -> DagCbor
ceilingRecord text = DcMap [("text", DcString text)]

mutated : Result String RepoMutation -> Repo
mutated result =
  repoMutationState
    (resultOrPanic "repo_tid_test: ceiling mutation failed" result)

createText : Int -> String -> String -> Repo -> Repo
createText step rkey text repo =
  mutated
    (repoCreate (ceilingPath rkey) (ceilingRecord text) (ceilingTid step) repo)

updateText : Int -> String -> String -> Repo -> Repo
updateText step rkey text repo =
  mutated
    (repoUpdate (ceilingPath rkey) (ceilingRecord text) (ceilingTid step) repo)

deletePath : Int -> String -> Repo -> Repo
deletePath step rkey repo =
  mutated (repoDelete (ceilingPath rkey) (ceilingTid step) repo)

-- The ceilings `repo`'s own export sits exactly at, read off the export
-- itself: its CAR bytes, its block count, and its MST node blocks.
exactCeilings : Repo -> RepoCeilings
exactCeilings repo =
  let car =
    resultOrPanic "repo_tid_test: ceiling export failed" (repoExportCar repo)
  let blocks =
    resultOrPanic "repo_tid_test: ceiling export failed" (repoExportBlocks repo)
  RepoCeilings
    (B.length car)
    (length blocks)
    (length (mstNodeBlocks (repoTree repo)))

persistVerdict : RepoCeilings -> Option Repo -> Repo -> Result String Unit
persistVerdict ceilings prior after =
  map (_ => ()) (repoAddedBlocksWithin ceilings prior after)

byteRefusal : Int -> Result String Unit
byteRefusal ceiling =
  Err
    "repo: CAR export failed: car: container exceeds \{intToString ceiling}-byte resource limit"

blockRefusal : Int -> Result String Unit
blockRefusal ceiling =
  Err
    "repo: CAR export failed: car: block count exceeds \{intToString ceiling} resource limit"

nodeRefusal : Int -> Result String Unit
nodeRefusal ceiling =
  Err "mst: node block count exceeds \{intToString ceiling} resource limit"

-- One record under rkey "a"; creating "b" beside it takes the MST from one
-- node to three, so the same commit crosses all three ceilings at once.
ceilingBefore : Repo
ceilingBefore = createText 1 "a" "first" ceilingRepo

ceilingAfter : Repo
ceilingAfter = createText 2 "b" "second" ceilingBefore

-- `after` is refused one step under its own export and admitted at it, on
-- each ceiling, diffed against `before`.
admittedExactly : Repo -> Repo -> Expectation
admittedExactly before after =
  let (RepoCeilings bytes blocks nodes) = exactCeilings after
  expectEach [
    (
      "admitted at its own export's ceilings",
      expectEqual
        (Ok ())
        (persistVerdict (exactCeilings after) (Some before) after),
    ),
    (
      "refused one byte under",
      expectEqual
        (byteRefusal (bytes - 1))
        (persistVerdict
          (RepoCeilings (bytes - 1) blocks nodes)
          (Some before)
          after),
    ),
    (
      "refused one block under",
      expectEqual
        (blockRefusal (blocks - 1))
        (persistVerdict
          (RepoCeilings bytes (blocks - 1) nodes)
          (Some before)
          after),
    ),
    (
      "refused one MST node under",
      expectEqual
        (nodeRefusal (nodes - 1))
        (persistVerdict
          (RepoCeilings bytes blocks (nodes - 1))
          (Some before)
          after),
    ),
  ]

test "a commit past the export byte ceiling is refused, and the graph before it is within it" =
  let (RepoCeilings bytes blocks nodes) = exactCeilings ceilingAfter
  let ceilings = RepoCeilings (bytes - 1) blocks nodes
  expectEach [
    (
      "the commit is refused with the export's own message",
      expectEqual
        (byteRefusal (bytes - 1))
        (persistVerdict ceilings (Some ceilingBefore) ceilingAfter),
    ),
    (
      "the repository before it persists under the same ceilings",
      expectEqual (Ok ()) (persistVerdict ceilings None ceilingBefore),
    ),
  ]

test "a commit past the export block ceiling is refused, and the graph before it is within it" =
  let (RepoCeilings bytes blocks nodes) = exactCeilings ceilingAfter
  let ceilings = RepoCeilings bytes (blocks - 1) nodes
  expectEach [
    (
      "the commit is refused with the export's own message",
      expectEqual
        (blockRefusal (blocks - 1))
        (persistVerdict ceilings (Some ceilingBefore) ceilingAfter),
    ),
    (
      "the repository before it persists under the same ceilings",
      expectEqual (Ok ()) (persistVerdict ceilings None ceilingBefore),
    ),
  ]

test "a commit past the MST node ceiling is refused, and the graph before it is within it" =
  let (RepoCeilings bytes blocks nodes) = exactCeilings ceilingAfter
  let (RepoCeilings _ _ nodesBefore) = exactCeilings ceilingBefore
  let ceilings = RepoCeilings bytes blocks (nodes - 1)
  expectEach [
    ("the commit adds MST nodes", expectGreaterThan nodesBefore nodes),
    (
      "the commit is refused with the load walk's own message",
      expectEqual
        (nodeRefusal (nodes - 1))
        (persistVerdict ceilings (Some ceilingBefore) ceilingAfter),
    ),
    (
      "the repository before it persists under the same ceilings",
      expectEqual (Ok ()) (persistVerdict ceilings None ceilingBefore),
    ),
  ]

test "a commit exactly at every ceiling is admitted, after creates, updates, deletes and shared records" =
  let updated = updateText 3 "a" "first, edited" ceilingAfter
  let shared = createText 4 "c" "second" updated
  let unshared = deletePath 5 "b" shared
  let emptied = deletePath 6 "a" unshared
  expectEach [
    ("a create", admittedExactly ceilingBefore ceilingAfter),
    ("an update", admittedExactly ceilingAfter updated),
    ("a second path naming an existing record", admittedExactly updated shared),
    (
      "deleting one of two paths naming a record",
      admittedExactly shared unshared,
    ),
    ("deleting down to one record", admittedExactly unshared emptied),
  ]

test "a refused commit leaves the totals the next commit is judged against alone" =
  let small = createText 2 "b" "small" ceilingBefore
  let large = createText 2 "b" (repeat 400 "x") ceilingBefore
  let ceilings = exactCeilings small
  let (RepoCeilings bytes _ _) = ceilings
  expectEach [
    (
      "the larger commit is refused under the smaller one's ceilings",
      expectEqual
        (byteRefusal bytes)
        (persistVerdict ceilings (Some ceilingBefore) large),
    ),
    (
      "the smaller commit from the same repository is then admitted exactly",
      admittedExactly ceilingBefore small,
    ),
  ]
