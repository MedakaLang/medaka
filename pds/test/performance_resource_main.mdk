{- | Native scaling and resource-limit probe for the Phase 1 MST/CAR gates. -}

import array.{drop}
import hex.{decode}
import lib.blockstore.{blockStoreFromBlocks}
import lib.car.{carDecode, carEncode}
import lib.cid.{Cid, cidForDagCbor, cidForRaw}
import lib.dagcbor.{DagCbor(..), dagCborEncode}
import lib.mst.{
  Mst,
  mstEmpty,
  mstEntries,
  mstFromEntries,
  mstInsert,
  mstNodeBlocks,
  mstRootBytes,
  mstRootCid,
  mstValidateBlocks,
  mstValidateBlocksWithTraversalLimit,
  mstValidateNodeBytes,
}
import lib.multiformats.{uvarintEncode}
import lib.repo.{repoExportGraph, repoFromBlocks}
import lib.resource_limits.{
  checkCarBlocks,
  checkCarBytes,
  checkCarSectionBytes,
  checkMstBlocks,
  checkMstNodeBytes,
  checkMstNodeEntries,
  checkMstTraversalDepth,
  maxCarBlocks,
  maxCarBytes,
  maxCarSectionBytes,
  maxMstBlocks,
  maxMstNodeBytes,
  maxMstNodeEntries,
  maxMstTraversalDepth,
}
import lib.sign.{SecretKey, secretKeyFromBytes, signDigest, signatureCompact}
import lib.tid.{Tid, tidParse, tidToString}
import list.{reverse}
import sha256.{sha256}
import string.{contains, toInt}

mustBytes : Result String (Array Int) -> Array Int
mustBytes (Ok bytes) = bytes
mustBytes (Err message) =
  panic "performance_resource: encoding failed: \{message}"

intBytes : Int -> Array Int
intBytes n =
  [|bitAnd (shiftRight n 16) 255, bitAnd (shiftRight n 8) 255, bitAnd n 255|]

carRows : Int -> Int -> List (Cid, Array Int) -> List (Cid, Array Int)
carRows n i acc =
  if i >= n then
    reverse acc
  else
    let bytes = intBytes i
    carRows n (i + 1) ((cidForRaw bytes, bytes) :: acc)

mstRows : Int -> Int -> List (Cid, Array Int) -> List (Cid, Array Int)
mstRows n i acc =
  if i >= n then
    reverse acc
  else
    let bytes = mustBytes (dagCborEncode (DcInt i))
    mstRows n (i + 1) ((cidForDagCbor bytes, bytes) :: acc)

runCar : Int -> <IO> Unit
runCar n = match carRows n 0 []
  [] => panic "performance_resource: CAR size must be positive"
  rows@((root, _) :: _) => match carEncode [root] rows
    Ok bytes =>
      println "CAR \{intToString n} \{intToString (arrayLength bytes)}"
    Err message => panic "performance_resource: CAR scaling failed: \{message}"

runMst : Int -> <IO> Unit
runMst n =
  let root = mstRootCid mstEmpty
  let rows = mstNodeBlocks mstEmpty ++ mstRows n 0 []
  match mstValidateBlocks root rows
    Err message =>
      if contains "unreachable" message then
        println "MST \{intToString n} UNREACHABLE"
      else
        panic "performance_resource: MST scaling wrong route: \{message}"
    Ok () => panic "performance_resource: MST hostile rows were accepted"

-- ── write/export/startup routes ─────────────────────────────────────────────
--
-- A fixed synthetic signing identity, mirroring `synth_repo_main.mdk`'s own
-- corpus key: these routes never read back through a client that cares which
-- key signed the corpus, so one key serves every size.
perfSecretHex : String
perfSecretHex =
  "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"

mustHexBytes : String -> Array Int
mustHexBytes text = match decode text
  Ok bytes => bytes
  Err message => panic "performance_resource: malformed hex: \{message}"

perfSecret : SecretKey
perfSecret = match secretKeyFromBytes (mustHexBytes perfSecretHex)
  Ok key => key
  Err message => panic "performance_resource: bad signing key: \{message}"

perfDid : String
perfDid = "did:plc:perfrouteidentity0000000"

perfRev : Tid
perfRev = match tidParse "3lba2s5ykxs2a"
  Ok tid => tid
  Err message => panic "performance_resource: bad TID literal: \{message}"

-- Every entry's key is a distinct fixed-width byte string and its value CID
-- points at a small distinct record block, built once via `mstFromEntries`
-- (non-quadratic per `synth_repo_main.mdk`'s own header note) rather than N
-- calls to `mstInsert`.
perfRowsGo : Int ->
  Int ->
  List (Array Int, Cid, Array Int) ->
  List (Array Int, Cid, Array Int)
perfRowsGo n i acc =
  if i >= n then
    reverse acc
  else
    let bytes = mustBytes (dagCborEncode (DcInt i))
    perfRowsGo n (i + 1) ((intBytes i, cidForDagCbor bytes, bytes) :: acc)

perfRows : Int -> List (Array Int, Cid, Array Int)
perfRows n = perfRowsGo n 0 []

perfEntriesOf : List (Array Int, Cid, Array Int) -> List (Array Int, Cid)
perfEntriesOf [] = []
perfEntriesOf ((key, cid, _) :: rest) = (key, cid) :: perfEntriesOf rest

perfRecordBlocksOf : List (Array Int, Cid, Array Int) -> List (Cid, Array Int)
perfRecordBlocksOf [] = []
perfRecordBlocksOf ((_, cid, bytes) :: rest) =
  (cid, bytes) :: perfRecordBlocksOf rest

mustPerfTree : List (Array Int, Cid) -> Mst
mustPerfTree entries = match mstFromEntries entries
  Ok tree => tree
  Err message => panic "performance_resource: mst build failed: \{message}"

-- Mirrors `lib.repo`'s private `buildCommit` signed-commit shape, using only
-- exported primitives — `buildCommit` itself is not exported.
perfUnsignedValue : Cid -> DagCbor
perfUnsignedValue dataCid = DcMap [
  ("did", DcString perfDid),
  ("version", DcInt 3),
  ("data", DcLink dataCid),
  ("rev", DcString (tidToString perfRev)),
  ("prev", DcNull),
]

perfSignedCommit : Cid -> (Cid, Array Int)
perfSignedCommit dataCid =
  let unsigned = mustBytes (dagCborEncode (perfUnsignedValue dataCid))
  let signature = match signDigest perfSecret (sha256 unsigned)
    Ok value => value
    Err message => panic "performance_resource: signing failed: \{message}"
  let signed =
    mustBytes
      (dagCborEncode
        (DcMap [
          ("did", DcString perfDid),
          ("version", DcInt 3),
          ("data", DcLink dataCid),
          ("rev", DcString (tidToString perfRev)),
          ("prev", DcNull),
          ("sig", DcBytes (signatureCompact signature)),
        ]))
  (cidForDagCbor signed, signed)

-- The commit-plus-graph block list every route below shares: the record
-- blocks, the MST node blocks over them, and a signed commit pointing at the
-- tree's root.
perfGraphBlocks : List (Array Int, Cid, Array Int) ->
  Mst ->
  Cid ->
  Array Int ->
  List (Cid, Array Int)
perfGraphBlocks rows tree commitCid signed =
  (commitCid, signed) :: mstNodeBlocks tree ++ perfRecordBlocksOf rows

insertAllGo : Int -> Int -> Mst -> Mst
insertAllGo n i tree =
  if i >= n then
    tree
  else
    let bytes = mustBytes (dagCborEncode (DcInt i))
    match mstInsert (intBytes i) (cidForDagCbor bytes) tree
      Ok next => insertAllGo n (i + 1) next
      Err message => panic "performance_resource: MST insert failed: \{message}"

-- One key at a time from empty, exactly how `repoCreate`/`repoApplyWrites`
-- build a tree — the shape the write-path fix actually guards, since a
-- single insert against an already-built tree costs the same complexity
-- class before and after the fix and cannot discriminate them.
runMstInsert : Int -> <IO> Unit
runMstInsert n =
  let tree = insertAllGo n 0 mstEmpty
  println "MSTINSERT \{intToString n} \{intToString (length (mstEntries tree))}"

runExport : Int -> <IO> Unit
runExport n =
  let rows = perfRows n
  let tree = mustPerfTree (perfEntriesOf rows)
  let dataCid = mstRootCid tree
  let (commitCid, signed) = perfSignedCommit dataCid
  let blocks = perfGraphBlocks rows tree commitCid signed
  match blockStoreFromBlocks blocks
    Err message =>
      panic "performance_resource: export block store failed: \{message}"
    Ok store => match repoExportGraph commitCid signed dataCid store
      Ok (exported, _) =>
        println "EXPORT \{intToString n} \{intToString (length exported)}"
      Err message => panic "performance_resource: export failed: \{message}"

runRehydrate : Int -> <IO> Unit
runRehydrate n =
  let rows = perfRows n
  let tree = mustPerfTree (perfEntriesOf rows)
  let dataCid = mstRootCid tree
  let (commitCid, signed) = perfSignedCommit dataCid
  let blocks = perfGraphBlocks rows tree commitCid signed
  match repoFromBlocks perfDid perfSecret commitCid blocks
    Ok _ => println "REHYDRATE \{intToString n} OK"
    Err message => panic "performance_resource: rehydrate failed: \{message}"

accept : String -> Result String Unit -> <IO> Int
accept label (Ok ()) =
  let () = println "LIMIT CONTROL \{label} PASS"
  1
accept label (Err message) =
  let () = println "LIMIT CONTROL \{label} FAIL rejected=\{message}"
  0

reject : String -> String -> Result String a -> <IO> Int
reject label witness (Err message) =
  if contains witness message then
    let () = println "LIMIT HOSTILE \{label} PASS route=\{witness}"
    1
  else
    let () = println "LIMIT HOSTILE \{label} FAIL wrong-route=\{message}"
    0
reject label _ (Ok _) =
  let () = println "LIMIT HOSTILE \{label} FAIL accepted"
  0

repeatRows : Int ->
  (Cid, Array Int) ->
  List (Cid, Array Int) ->
  List (Cid, Array Int)
repeatRows n row acc =
  if n <= 0 then acc else repeatRows (n - 1) row (row :: acc)

prefix3 : Array Int -> Array Int -> Int
prefix3 prior key =
  if prior[0] /= key[0] then
    0
  else if prior[1] /= key[1] then
    1
  else if prior[2] /= key[2] then
    2
  else
    3

nodeEntries : Int ->
  Int ->
  Option (Array Int) ->
  Cid ->
  List DagCbor ->
  List DagCbor
nodeEntries n i prior value acc =
  if i >= n then
    reverse acc
  else
    let key = intBytes i
    let prefix = match prior
      None => 0
      Some previous => prefix3 previous key
    let entry = DcMap [
      ("p", DcInt prefix),
      ("k", DcBytes (drop prefix key)),
      ("v", DcLink value),
      ("t", DcNull),
    ]
    nodeEntries n (i + 1) (Some key) value (entry :: acc)

framedHeader : Cid -> Array Int
framedHeader root =
  let header =
    mustBytes
      (dagCborEncode
        (DcMap [("roots", DcArray [DcLink root]), ("version", DcInt 1)]))
  uvarintEncode (arrayLength header) ++ header

depthNode : Array Int -> Cid -> Option Cid -> (Cid, Array Int)
depthNode key value child =
  let left = match child
    None => DcNull
    Some cid => DcLink cid
  let bytes =
    mustBytes
      (dagCborEncode
        (DcMap [
          ("l", left),
          (
            "e",
            DcArray [
              DcMap [
                ("p", DcInt 0),
                ("k", DcBytes key),
                ("v", DcLink value),
                ("t", DcNull),
              ],
            ],
          ),
        ]))
  (cidForDagCbor bytes, bytes)

depthCid : (Cid, Array Int) -> Cid
depthCid (cid, _) = cid

depthRouteControls : Cid -> <IO> (Int, Int)
depthRouteControls value =
  let leaf = depthNode [|0x00, 0x01|] value None
  let depth1 = depthNode [|0x00, 0x07|] value (Some (depthCid leaf))
  let depth2 = depthNode [|0x00, 0x16|] value (Some (depthCid depth1))
  let depth3 = depthNode [|0x00, 0x61|] value (Some (depthCid depth2))
  let atRows = [depth2, depth1, leaf]
  let overRows = [depth3, depth2, depth1, leaf]
  let controls = sum [
    accept
      "mst-public-depth-at"
      (mstValidateBlocksWithTraversalLimit 2 (depthCid depth2) atRows),
    accept
      "mst-production-depth-control"
      (mstValidateBlocks (depthCid depth3) overRows),
  ]
  let hostile =
    reject
      "mst-public-depth-over"
      "traversal depth exceeds"
      (mstValidateBlocksWithTraversalLimit 2 (depthCid depth3) overRows)
  let () =
    println
      "public-depth: \{intToString controls}/2 adjacent controls; \{intToString hostile}/1 hostile route"
  (controls, hostile)

runLimits : <IO> Unit
runLimits =
  let root = mstRootCid mstEmpty
  let rootBytes = mstRootBytes mstEmpty
  let tooManyCar = repeatRows (maxCarBlocks + 1) (root, rootBytes) []
  let tooManyMst = repeatRows (maxMstBlocks + 1) (root, rootBytes) []
  let tooManyEntries =
    mustBytes
      (dagCborEncode
        (DcMap [
          ("l", DcNull),
          ("e", DcArray (nodeEntries (maxMstNodeEntries + 1) 0 None root [])),
        ]))
  let controls = sum [
    accept "car-container-at" (checkCarBytes maxCarBytes),
    accept "car-section-at" (checkCarSectionBytes maxCarSectionBytes),
    accept "car-blocks-at" (checkCarBlocks maxCarBlocks),
    accept "mst-blocks-at" (checkMstBlocks maxMstBlocks),
    accept "mst-node-bytes-at" (checkMstNodeBytes maxMstNodeBytes),
    accept "mst-entries-at" (checkMstNodeEntries maxMstNodeEntries),
    accept "mst-depth-at" (checkMstTraversalDepth maxMstTraversalDepth),
  ]
  let hostile = sum [
    reject
      "car-container-over"
      "container exceeds"
      (carDecode (arrayMake (maxCarBytes + 1) 0)),
    reject
      "car-section-over"
      "section exceeds"
      (carDecode (framedHeader root ++ uvarintEncode (maxCarSectionBytes + 1))),
    reject
      "car-blocks-over"
      "block count exceeds"
      (carEncode [root] tooManyCar),
    reject
      "mst-blocks-over"
      "node block count exceeds"
      (mstValidateBlocks root tooManyMst),
    reject
      "mst-node-bytes-over"
      "node exceeds"
      (mstValidateNodeBytes 0 True (arrayMake (maxMstNodeBytes + 1) 0)),
    reject
      "mst-entries-over"
      "node entry count exceeds"
      (mstValidateNodeBytes 0 True tooManyEntries),
    reject
      "mst-depth-over"
      "traversal depth exceeds"
      (checkMstTraversalDepth (maxMstTraversalDepth + 1)),
  ]
  let (publicControls, publicHostile) = depthRouteControls root
  let () =
    println
      "limits: \{intToString controls}/7 adjacent controls; \{intToString hostile}/7 hostile routes"
  if controls == 7
    && hostile == 7
    && publicControls == 2
    && publicHostile == 1 then
    println "LIMITS: PASS"
  else
    let () = println "LIMITS: FAIL"
    exit 1

main : <IO, Env> Unit
main = match args ()
  ["car", nText] => match toInt nText
    Some n => runCar n
    None => panic "performance_resource: invalid CAR size"
  ["mst", nText] => match toInt nText
    Some n => runMst n
    None => panic "performance_resource: invalid MST size"
  ["mst-insert", nText] => match toInt nText
    Some n => runMstInsert n
    None => panic "performance_resource: invalid MST insert size"
  ["export", nText] => match toInt nText
    Some n => runExport n
    None => panic "performance_resource: invalid export size"
  ["rehydrate", nText] => match toInt nText
    Some n => runRehydrate n
    None => panic "performance_resource: invalid rehydrate size"
  ["limits"] => runLimits
  _ =>
    panic
      "usage: performance_resource_main (car|mst|mst-insert|export|rehydrate) <size> | limits"
