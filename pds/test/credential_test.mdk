{- | `pds/lib/credential.mdk` (#2611 password half): what is stored in place of
   an account password, and how a presented password is graded against it.

   `pds/test/pbkdf2_test.mdk` already grades the derivation itself against RFC
   7914's published vectors, so nothing here re-grades PBKDF2. What is graded
   here is the record around it: that a record admits only well-formed parts,
   that it survives the round trip through the three values `pds/serve.mdk`
   writes to disk, that a wrong password fails and the right one passes, and
   that a record carries its own iteration count so raising the default does
   not lock an existing account out. -}

import test.{expectEqual, expectTrue}
import lib.credential.{
  CredentialRecord,
  credentialDigest,
  credentialFromParts,
  credentialIterations,
  credentialSalt,
  credentialVerify,
  ctEqBytes,
  defaultIterations,
  digestBytes,
  makeCredential,
  saltBytes,
}

{- | A fixed salt. A real one is drawn from `osEntropyBytes` per account
   (`pds/serve.mdk`); a fixture only has to be the right length, and a
   deterministic one keeps this file's expectations stable. -}
testSalt : Array Int
testSalt = arrayMakeWith saltBytes (i => (i * 37 + 11) % 256)

otherSalt : Array Int
otherSalt = arrayMakeWith saltBytes (i => (i * 91 + 5) % 256)

{- | The iteration count this file derives at.

   It is NOT `defaultIterations`: these tests care about the record, not about
   the cost, and every derivation below is paid for in gate wall time. The one
   test that grades the shipped default states it separately. -}
cheapIterations : Int
cheapIterations = 4

password : String
password = "correct horse battery staple"

record : CredentialRecord
record = match makeCredential testSalt cheapIterations password
  Ok made => made
  Err message => panic "credential_test: fixture credential failed: \{message}"

test "the right password verifies" =
  expectTrue (credentialVerify password record)

test "a wrong password does not verify" =
  expectTrue (not (credentialVerify "correct horse battery stapl" record))

test "an empty password does not verify a record derived from a real one" =
  expectTrue (not (credentialVerify "" record))

-- The password is graded as bytes, not as a normalized string: two passwords
-- that differ only in case are two passwords.
test "the password comparison is case-sensitive" =
  expectTrue (not (credentialVerify "Correct Horse Battery Staple" record))

test "a record keeps the salt it was derived under" =
  expectTrue (ctEqBytes (credentialSalt record) testSalt)

test "a record keeps the iteration count it was derived at" =
  expectEqual (credentialIterations record) cheapIterations

test "a record's derived key is the advertised length" =
  expectEqual (arrayLength (credentialDigest record)) digestBytes

{- | The round trip `pds/serve.mdk` performs on every start after the first:
   the three stored values go back in and grade the same password the same
   way. A record that did not survive this would lock the account out on the
   first restart and look like a wrong password while doing it. -}
test "a record rebuilt from its stored parts verifies the same password" =
  let reloading =
    credentialFromParts
      (credentialSalt record)
      (credentialIterations record)
      (credentialDigest record)
  match reloading
    Err message => expectEqual message "a credential rebuilt from its own parts"
    Ok reloaded => expectTrue (credentialVerify password reloaded)

{- | What a refusal said, or the word `admitted` for a record that was let in.

   The record itself is never rendered — a `CredentialRecord` derives no
   `Debug` precisely so that no failing assertion anywhere can print an
   account's derived key into a log — so an admission is graded by this word
   and by the behavior of the record, never by its contents. -}
refusal : Result String CredentialRecord -> String
refusal (Err message) = message
refusal (Ok _) = "admitted"

test "a truncated salt is refused" =
  expectEqual
    (refusal
      (credentialFromParts
        [|1, 2, 3|]
        cheapIterations
        (credentialDigest record)))
    "credential: salt must be \{intToString saltBytes} bytes"

test "a truncated derived key is refused" =
  expectEqual
    (refusal
      (credentialFromParts (credentialSalt record) cheapIterations [|1, 2, 3|]))
    "credential: derived key must be \{intToString digestBytes} bytes"

test "a zero iteration count is refused" =
  expectEqual
    (refusal
      (credentialFromParts (credentialSalt record) 0 (credentialDigest record)))
    "credential: iteration count must be at least 1"

test "deriving under a zero iteration count is refused" =
  expectEqual
    (refusal (makeCredential testSalt 0 password))
    "credential: iteration count must be at least 1"

test "deriving under a wrong-length salt is refused" =
  expectEqual
    (refusal (makeCredential [|1, 2, 3|] cheapIterations password))
    "credential: salt must be \{intToString saltBytes} bytes"

{- | The salt is what stops one derived key from grading two accounts, and
   what stops a precomputed table from grading any. Same password, different
   salt, different stored value. -}
test "the same password under a different salt derives a different key" =
  match makeCredential otherSalt cheapIterations password
    Err message => expectEqual message "a second record"
    Ok other =>
      expectTrue
        (not (ctEqBytes (credentialDigest other) (credentialDigest record)))

{- | A record is graded at ITS OWN iteration count, not at today's default, so
   raising `defaultIterations` leaves every existing credential working. -}
test "a record derived at another count still verifies after the default moves" =
  match makeCredential testSalt (cheapIterations + 1) password
    Err message => expectEqual message "a record at another iteration count"
    Ok other => expectTrue (credentialVerify password other)

-- A live review finding, pinned here so it cannot be lost: the shipped count
-- is far below OWASP's >=600,000 floor for PBKDF2-HMAC-SHA-256. It is what a
-- pure-Medaka derivation can afford within a bootstrap budget on this box; a
-- native fast path is the fix, and this cell fails the moment one lands and
-- the count is raised, which is exactly when this comment should be revisited.
test "the shipped iteration count is the measured 1,500, not a security floor" =
  expectEqual defaultIterations 1500

test "constant-time equality accepts equal arrays" =
  expectTrue (ctEqBytes [|1, 2, 3|] [|1, 2, 3|])

test "constant-time equality rejects a difference in the last byte" =
  expectTrue (not (ctEqBytes [|1, 2, 3|] [|1, 2, 4|]))

test "constant-time equality rejects a difference in the first byte" =
  expectTrue (not (ctEqBytes [|1, 2, 3|] [|9, 2, 3|]))

test "constant-time equality rejects arrays of different lengths" =
  expectTrue (not (ctEqBytes [|1, 2, 3|] [|1, 2, 3, 4|]))
