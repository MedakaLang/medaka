{- | `pds/lib/credential.mdk` (#2611 password half): what is stored in place of
   an account password, and how a presented password is graded against it.

   `pds/test/pbkdf2_test.mdk` already grades the derivation itself against RFC
   7914's published vectors, so nothing here re-grades PBKDF2. What is graded
   here is the record around it: that a record admits only well-formed parts,
   that it survives the round trip through the three values `pds/serve.mdk`
   writes to disk, that a wrong password fails and the right one passes, and
   that a record carries its own iteration count so raising the default does
   not lock an existing account out. -}

import test.{
  Expectation,
  expectEach,
  expectEqual,
  expectFalse,
  expectOkThen,
  expectTrue,
  fail,
  pass,
}
import hmac.{ctEq}
import hex.{decode}
import lib.pbkdf2.{pbkdf2HmacSha256}
import string.{toUtf8}
import lib.credential.{
  CredentialRecord,
  LoginCheck,
  LoginOutcome(..),
  LoginVerdict,
  Pbkdf2Steps,
  credentialDigest,
  credentialFromParts,
  credentialIterations,
  credentialSalt,
  credentialVerify,
  defaultIterations,
  digestBytes,
  loginCheckAdvance,
  loginCheckBegin,
  loginCheckVerdict,
  loginOutcome,
  makeCredential,
  pbkdf2Advance,
  pbkdf2Begin,
  pbkdf2Output,
  saltBytes,
}

{- | A fixed salt. A real one is drawn from `osEntropyBytes` per account
   (`pds/serve.mdk`); a fixture only has to be the right length, and a
   deterministic one keeps this file's expectations stable. -}
testSalt : Array Int
testSalt = arrayMakeWith saltBytes (i => (i * 37 + 11) % 256)

otherSalt : Array Int
otherSalt = arrayMakeWith saltBytes (i => (i * 91 + 5) % 256)

{- | The iteration count this file derives at.

   It is NOT `defaultIterations`: these tests care about the record, not about
   the cost, and every derivation below is paid for in gate wall time. The one
   test that grades the shipped default states it separately. -}
cheapIterations : Int
cheapIterations = 4

password : String
password = "correct horse battery staple"

record : CredentialRecord
record =
  resultOrPanic
    "credential_test: fixture credential failed"
    (makeCredential testSalt cheapIterations password)

test "the right password verifies" =
  expectTrue (credentialVerify password record)

test "a wrong password does not verify" =
  expectTrue (not (credentialVerify "correct horse battery stapl" record))

test "an empty password does not verify a record derived from a real one" =
  expectTrue (not (credentialVerify "" record))

-- The password is graded as bytes, not as a normalized string: two passwords
-- that differ only in case are two passwords.
test "the password comparison is case-sensitive" =
  expectTrue (not (credentialVerify "Correct Horse Battery Staple" record))

test "a record keeps the salt it was derived under" =
  expectTrue (ctEq (credentialSalt record) testSalt)

test "a record keeps the iteration count it was derived at" =
  expectEqual (credentialIterations record) cheapIterations

test "a record's derived key is the advertised length" =
  expectEqual (arrayLength (credentialDigest record)) digestBytes

{- | The round trip `pds/serve.mdk` performs on every start after the first:
   the three stored values go back in and grade the same password the same
   way. A record that did not survive this would lock the account out on the
   first restart and look like a wrong password while doing it. -}
test "a record rebuilt from its stored parts verifies the same password" =
  let reloading =
    credentialFromParts
      (credentialSalt record)
      (credentialIterations record)
      (credentialDigest record)
  expectOkThen
    (reloaded => expectTrue (credentialVerify password reloaded))
    reloading

{- | What a refusal said, or the word `admitted` for a record that was let in.

   The record itself is never rendered — a `CredentialRecord` derives no
   `Debug` precisely so that no failing assertion anywhere can print an
   account's derived key into a log — so an admission is graded by this word
   and by the behavior of the record, never by its contents. -}
refusal : Result String CredentialRecord -> String
refusal (Err message) = message
refusal (Ok _) = "admitted"

test "a truncated salt is refused" =
  expectEqual
    (refusal
      (credentialFromParts
        [|1, 2, 3|]
        cheapIterations
        (credentialDigest record)))
    "credential: salt must be \{intToString saltBytes} bytes"

test "a truncated derived key is refused" =
  expectEqual
    (refusal
      (credentialFromParts (credentialSalt record) cheapIterations [|1, 2, 3|]))
    "credential: derived key must be \{intToString digestBytes} bytes"

test "a zero iteration count is refused" =
  expectEqual
    (refusal
      (credentialFromParts (credentialSalt record) 0 (credentialDigest record)))
    "credential: iteration count must be at least 1"

test "deriving under a zero iteration count is refused" =
  expectEqual
    (refusal (makeCredential testSalt 0 password))
    "credential: iteration count must be at least 1"

test "deriving under a wrong-length salt is refused" =
  expectEqual
    (refusal (makeCredential [|1, 2, 3|] cheapIterations password))
    "credential: salt must be \{intToString saltBytes} bytes"

{- | The salt is what stops one derived key from grading two accounts, and
   what stops a precomputed table from grading any. Same password, different
   salt, different stored value. -}
test "the same password under a different salt derives a different key" =
  expectOkThen
    (other =>
      expectTrue
        (not (ctEq (credentialDigest other) (credentialDigest record))))
    (makeCredential otherSalt cheapIterations password)

{- | A record is graded at ITS OWN iteration count, not at today's default, so
   raising `defaultIterations` leaves every existing credential working. -}
test "a record derived at another count still verifies after the default moves" =
  expectOkThen
    (other => expectTrue (credentialVerify password other))
    (makeCredential testSalt (cheapIterations + 1) password)

{- | The shipped count, pinned so that moving it is a deliberate act.

   It is still below OWASP's >=600,000 floor for PBKDF2-HMAC-SHA-256: it is
   the round count a pure-Medaka derivation fits into a 500 ms login budget on
   the reference box (`docs/design/ATPROTO-PDS-DESIGN.md` §4.2). A cheaper
   derivation is what would raise it, and this cell fails the moment the count
   moves — which is when the residual gap recorded in that section should be
   recomputed. -}
test "the shipped iteration count is the measured 60,000, not a security floor" =
  expectEqual defaultIterations 60000

{- | The migration a login performs when the stored record predates today's
   count: same password, new count, and a record that still verifies.

   `record`, derived at `cheapIterations`, stands in for a credential written
   before `defaultIterations` moved. The cells below derive at counts of 4 and
   5 rather than at the shipped one, because what is under test is the upgrade
   decision, not the cost. -}
newIterations : Int
newIterations = cheapIterations + 1

{- | A login check run to its verdict, `chunk` HMAC calls at a time — what the
   server's yielding loop does, without the yields. -}
settle : Int -> LoginCheck -> LoginVerdict
settle chunk check = match loginCheckVerdict check
  Some verdict => verdict
  None => settle chunk (loginCheckAdvance chunk check)

-- The verdict of presenting `presented` against `graded`, derived one HMAC
-- call at a time, offering `otherSalt` and `target` as the upgrade.
verdictFor : String -> Int -> CredentialRecord -> LoginVerdict
verdictFor presented target graded =
  settle 1 (loginCheckBegin presented otherSalt target graded)

-- What an outcome decided. A `CredentialRecord` renders nothing, so the
-- record an upgrade carries is graded by `upgradeOf`, never printed.
decision : LoginOutcome -> String
decision LoginRefused = "refused"
decision LoginAccepted = "accepted"
decision (LoginAcceptedUpgrading _) = "accepted, upgrading"

upgradeOf : LoginOutcome -> Option CredentialRecord
upgradeOf (LoginAcceptedUpgrading upgraded) = Some upgraded
upgradeOf LoginAccepted = None
upgradeOf LoginRefused = None

test "a credential written at the old count still verifies" =
  expectTrue (credentialVerify password record)

test "the right password at the current count is accepted without an upgrade" =
  expectEqual
    "accepted"
    (decision
      (loginOutcome (verdictFor password cheapIterations record) record))

test "a wrong password is refused" =
  expectEqual
    "refused"
    (decision
      (loginOutcome
        (verdictFor "not the password" cheapIterations record)
        record))

test "one successful login re-derives the record at the new count" =
  let upgrading = loginOutcome (verdictFor password newIterations record) record
  match upgradeOf upgrading
    None => fail "no upgrade offered"
    Some upgraded => expectEach [
      (
        "the re-derived record carries the new iteration count",
        expectEqual newIterations (credentialIterations upgraded),
      ),
      (
        "the same password still verifies against it",
        expectTrue (credentialVerify password upgraded),
      ),
      (
        "it carries the salt the upgrade was offered",
        expectTrue (ctEq (credentialSalt upgraded) otherSalt),
      ),
      (
        "its digest differs from the record it replaced",
        expectFalse (ctEq (credentialDigest upgraded) (credentialDigest record)),
      ),
    ]

{- | The failed-login half: the password is graded before any upgrade is
   derived, so a wrong password yields no record at all and no caller can
   rewrite a stored credential from an unauthenticated guess. -}
test "a failed login offers no upgrade" =
  expectEqual
    "refused"
    (decision
      (loginOutcome
        (verdictFor "not the password" newIterations record)
        record))

{- | The race the verdict exists for: a verdict is computed against the record
   the store held when the derivation began, and by the time it is applied
   another login's upgrade has replaced that record. The verdict names a
   record the store no longer holds, so it is refused, even though the
   password it graded was right. -}
test "a verdict computed against a record that has since been replaced is refused" =
  let upgrading = loginOutcome (verdictFor password newIterations record) record
  match upgradeOf upgrading
    None => fail "no upgrade offered"
    Some replaced => expectEach [
      (
        "a right-password verdict against the old record",
        expectEqual
          "refused"
          (decision
            (loginOutcome (verdictFor password newIterations record) replaced)),
      ),
      (
        "a right-password verdict against a record under another salt",
        expectOkThen
          (other =>
            expectEqual
              "refused"
              (decision
                (loginOutcome
                  (verdictFor password cheapIterations record)
                  other)))
          (makeCredential otherSalt cheapIterations password),
      ),
      (
        "a fresh verdict against the replacement is accepted",
        expectEqual
          "accepted"
          (decision
            (loginOutcome
              (verdictFor password newIterations replaced)
              replaced)),
      ),
    ]

-- The staleness check compares the record's contents, not its identity: the
-- same three parts read back from disk are the same record.
test "a verdict applies to the same record rebuilt from its stored parts" =
  expectOkThen
    (reloaded =>
      expectEqual
        "accepted"
        (decision
          (loginOutcome (verdictFor password cheapIterations record) reloaded)))
    (credentialFromParts
      (credentialSalt record)
      (credentialIterations record)
      (credentialDigest record))

test "the verdict does not depend on the slice size it was paid for in" =
  expectEach
    (map
      (chunk => (
        "slices of \{intToString chunk}",
        expectEqual
          "accepted, upgrading"
          (decision
            (loginOutcome
              (settle
                chunk
                (loginCheckBegin password otherSalt newIterations record))
              record)),
      ))
      [1, 2, 3, 4, 5, 7, 100])

{- | A derivation paid for `chunk` HMAC calls at a time, to its end. -}
derivedInChunks : Int -> Pbkdf2Steps -> Array Int
derivedInChunks chunk steps = match pbkdf2Output steps
  Some derived => derived
  None => derivedInChunks chunk (pbkdf2Advance chunk steps)

hexBytes : String -> Array Int
hexBytes text = resultOrPanic "credential_test: bad hex literal" (decode text)

{- | RFC 7914 §11's two PBKDF2-HMAC-SHA-256 vectors, the same ones
   `pds/test/pbkdf2_test.mdk` grades `pbkdf2HmacSha256` against (transcribed
   from `pds/test/vectors/rfc7914_pbkdf2_hmac_sha256.txt`). Both have
   `dkLen = 64`, so both cross a block boundary. -}
rfc7914Vector1 : Array Int
rfc7914Vector1 =
  hexBytes
    "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"

rfc7914Vector2 : Array Int
rfc7914Vector2 =
  hexBytes
    "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d"

-- Vector 1 is `c = 1`, so its two blocks cost one HMAC call each: slices of
-- 1 and 2 divide its total of 2, a slice of 3 does not.
test "RFC 7914 vector 1 derived in slices equals the published key" =
  expectEach
    (map
      (chunk => (
        "slices of \{intToString chunk}",
        expectEqual
          rfc7914Vector1
          (derivedInChunks
            chunk
            (pbkdf2Begin (toUtf8 "passwd") (toUtf8 "salt") 1 64)),
      ))
      [1, 2, 3])

-- Vector 2 is `c = 80000`: 320 divides it and 256 does not, so one run ends
-- every slice on a block boundary and the other straddles both.
test "RFC 7914 vector 2 derived in slices equals the published key" =
  expectEach
    (map
      (chunk => (
        "slices of \{intToString chunk}",
        expectEqual
          rfc7914Vector2
          (derivedInChunks
            chunk
            (pbkdf2Begin (toUtf8 "Password") (toUtf8 "NaCl") 80000 64)),
      ))
      [320, 256])

{- | Inputs generated from `n`: a password and salt of varying length
   (including empty), a count from 1 to 9, and a key length on either side
   of a block boundary. -}
generatedInput : Int -> (Array Int, Array Int, Int, Int)
generatedInput n = (
  arrayMakeWith ((n * 7) % 23) (i => (i * 31 + n * 17) % 256),
  arrayMakeWith ((n * 5) % 19) (i => (i * 53 + n * 11 + 7) % 256),
  n % 9 + 1,
  [|1, 20, 31, 32, 33, 64, 65, 96|][n % 8],
)

-- Generated input `n` derived whole and in slices. Slices of 1 and of
-- exactly the count divide the count; one past the count never does, and 2
-- does only when the count is even.
slicedAgainstWhole : Int -> List (String, Expectation)
slicedAgainstWhole n =
  let (secret, salt, iterations, dkLen) = generatedInput n
  let whole = pbkdf2HmacSha256 secret salt iterations dkLen
  map
    (chunk => (
      "input \{intToString n}, slices of \{intToString chunk}",
      expectEqual
        whole
        (derivedInChunks chunk (pbkdf2Begin secret salt iterations dkLen)),
    ))
    [1, 2, iterations, iterations + 1]

test "a derivation in slices equals pbkdf2HmacSha256 on generated inputs" =
  expectEach (flatMap slicedAgainstWhole [0..=23])

-- Advancing a state does not change it, so the same state advanced twice
-- reaches the same key.
test "advancing a derivation leaves the state it started from unchanged" =
  let start = pbkdf2Advance 3 (pbkdf2Begin (toUtf8 "pw") (toUtf8 "salt") 5 40)
  let once = derivedInChunks 1 start
  expectEqual once (derivedInChunks 2 start)

test "constant-time equality accepts equal arrays" =
  expectTrue (ctEq [|1, 2, 3|] [|1, 2, 3|])

test "constant-time equality rejects a difference in the last byte" =
  expectTrue (not (ctEq [|1, 2, 3|] [|1, 2, 4|]))

test "constant-time equality rejects a difference in the first byte" =
  expectTrue (not (ctEq [|1, 2, 3|] [|9, 2, 3|]))

test "constant-time equality rejects arrays of different lengths" =
  expectTrue (not (ctEq [|1, 2, 3|] [|1, 2, 3, 4|]))
