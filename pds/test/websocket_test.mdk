{- | Vector-graded tests for `pds/lib/sha1.mdk` and `pds/lib/websocket.mdk`
   (S-ws-transport, #2608 subscribeRepos inbound surface).

   Every expected value below is EXTERNALLY sourced (G5) and none is captured
   from this implementation:

   - the SHA-1 digests are RFC 3174 §7.3's four published test vectors,
     committed byte-for-byte at `pds/test/vectors/rfc3174_sha1.txt` and
     ledgered in `pds/test/VECTOR-PROVENANCE.txt`;
   - the handshake key/accept pair is RFC 6455 §1.3's worked example and the
     frame byte strings are RFC 6455 §5.7's, committed at
     `pds/test/vectors/rfc6455_handshake_frames.txt`.

   The literals here were read back against those two files. Inputs (the
   messages hashed, the masking key) need no provenance row of their own;
   only the expected outputs are graded values.

   The adversarial cases below have no published vector — a rejection is a
   requirement of RFC 6455 §5.1/§5.2/§5.5, not a byte string anyone
   publishes — so each names the clause it enforces. -}

import bytes as B
import bytes.{Bytes, encodeUtf8, fromU8Array}
import list.{replicate}
import mut_bytes as MB
import test.{
  expectEach,
  expectEqual,
  expectErr,
  expectErrContains,
  expectNone,
  expectOkThen,
  expectTrue,
  fail,
}
import u8 as U8
import lib.sha1.{sha1}
import lib.websocket.{
  AssembleEvent(..),
  DecodeResult(..),
  Direction(..),
  Frame(..),
  Opcode(..),
  assembleFrame,
  closeFrame,
  decodeFrame,
  encodeClientFrame,
  encodeServerFrame,
  handshakeAccept,
  parseClosePayload,
}

-- # Helpers

-- The message of RFC 3174 TEST3/TEST4: `pattern` repeated `n` times.
repeatedBytes : Bytes -> Int -> Bytes
repeatedBytes pattern n = B.concat (replicate n pattern)

-- A decode that is expected to succeed, reduced to the four things every
-- assertion below asks about.
decodedAs : DecodeResult -> Option (Bool, Opcode, Bytes, Int)
decodedAs (Decoded (Frame fin opcode payload) consumed) =
  Some (fin, opcode, payload, consumed)
decodedAs NeedMore = None
decodedAs (Rejected _ _) = None

rejectedWith : Int -> DecodeResult -> Bool
rejectedWith code (Rejected c _) = c == code
rejectedWith _ (Decoded _ _) = False
rejectedWith _ NeedMore = False

isNeedMore : DecodeResult -> Bool
isNeedMore NeedMore = True
isNeedMore (Decoded _ _) = False
isNeedMore (Rejected _ _) = False

eventRejectedWith : Int -> AssembleEvent -> Bool
eventRejectedWith code (EventRejected c _) = c == code
eventRejectedWith _ EventPartial = False
eventRejectedWith _ (EventMessage _ _) = False
eventRejectedWith _ (EventControl _) = False

-- `n` copies of one byte, for a payload whose length is what is under test.
filled : Int -> Int -> Bytes
filled n byte =
  let mb = MB.make n
  MB.fill (U8.truncate byte) mb
  MB.freeze mb

-- The largest payload the decode assertions below will allocate for. Every
-- "declared length" case is graded against this number, not against the
-- bytes that happen to be present.
maxPayload : Int
maxPayload = 65536

-- # SHA-1 — RFC 3174 §7.3

test "RFC 3174 §7.3 TEST1: \"abc\"" =
  expectEqual
    (fromU8Array [|
      0xa9,
      0x99,
      0x3e,
      0x36,
      0x47,
      0x06,
      0x81,
      0x6a,
      0xba,
      0x3e,
      0x25,
      0x71,
      0x78,
      0x50,
      0xc2,
      0x6c,
      0x9c,
      0xd0,
      0xd8,
      0x9d,
    |])
    (sha1 (encodeUtf8 "abc"))

test "RFC 3174 §7.3 TEST2: the 56-byte alphabet string" =
  expectEqual
    (fromU8Array [|
      0x84,
      0x98,
      0x3e,
      0x44,
      0x1c,
      0x3b,
      0xd2,
      0x6e,
      0xba,
      0xae,
      0x4a,
      0xa1,
      0xf9,
      0x51,
      0x29,
      0xe5,
      0xe5,
      0x46,
      0x70,
      0xf1,
    |])
    (sha1
      (encodeUtf8 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))

-- RFC 3174 TEST3's message: the one byte of "a", a million times. Built by
-- `MB.fill` rather than by `repeatedBytes`, whose per-repeat `B.concat` cost
-- would be quadratic bytes copied at this repeat count.
millionA : Bytes
millionA =
  let mb = MB.make 1000000
  MB.fill (U8.truncate 97) mb
  MB.freeze mb

test "RFC 3174 §7.3 TEST3: one million 'a'" =
  expectEqual
    (fromU8Array [|
      0x34,
      0xaa,
      0x97,
      0x3c,
      0xd4,
      0xc4,
      0xda,
      0xa4,
      0xf6,
      0x1e,
      0xeb,
      0x2b,
      0xdb,
      0xad,
      0x27,
      0x31,
      0x65,
      0x34,
      0x01,
      0x6f,
    |])
    (sha1 millionA)

test "RFC 3174 §7.3 TEST4: a 64-byte pattern ten times (exact block multiple)" =
  expectEqual
    (fromU8Array [|
      0xde,
      0xa3,
      0x56,
      0xa2,
      0xcd,
      0xdd,
      0x90,
      0xc7,
      0xa7,
      0xec,
      0xed,
      0xc5,
      0xeb,
      0xb5,
      0x63,
      0x93,
      0x4f,
      0x46,
      0x04,
      0x52,
    |])
    (sha1
      (repeatedBytes
        (encodeUtf8
          "0123456701234567012345670123456701234567012345670123456701234567")
        10))

test "the digest is 20 bytes" = expectEqual 20 (B.length (sha1 (encodeUtf8 "")))

-- # The opening handshake — RFC 6455 §1.3

test "RFC 6455 §1.3 worked example: the key's accept value, byte for byte" =
  expectEqual
    (Ok "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
    (handshakeAccept "dGhlIHNhbXBsZSBub25jZQ==")

test "a Sec-WebSocket-Key that does not decode to 16 bytes is refused (§4.1)" =
  expectErr (handshakeAccept "c2hvcnQ=")

test "a Sec-WebSocket-Key that is not base64 at all is refused" =
  expectErr (handshakeAccept "not base64!!")

-- # Frame encoding — RFC 6455 §5.7

hello : Bytes
hello = encodeUtf8 "Hello"

-- The masking key of §5.7's two masked examples.
sampleMaskKey : Bytes
sampleMaskKey = fromU8Array [|0x37, 0xfa, 0x21, 0x3d|]

test "§5.7: a single-frame unmasked text message" =
  expectEqual
    (fromU8Array [|0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f|])
    (encodeServerFrame (Frame True Text hello))

test "§5.7: a single-frame masked text message" =
  expectEqual
    maskedHelloWire
    (encodeClientFrame sampleMaskKey (Frame True Text hello))

test "§5.7: a fragmented unmasked text message, both frames" =
  let first = encodeServerFrame (Frame False Text (encodeUtf8 "Hel"))
  let second = encodeServerFrame (Frame True Continuation (encodeUtf8 "lo"))
  expectEach [
    (
      "the opening frame is a non-final text frame carrying \"Hel\"",
      expectEqual (fromU8Array [|0x01, 0x03, 0x48, 0x65, 0x6c|]) first,
    ),
    (
      "the closing frame is a final continuation frame carrying \"lo\"",
      expectEqual (fromU8Array [|0x80, 0x02, 0x6c, 0x6f|]) second,
    ),
  ]

test "§5.7: an unmasked Ping request and a masked Pong response" =
  let ping = encodeServerFrame (Frame True Ping hello)
  let pong = encodeClientFrame sampleMaskKey (Frame True Pong hello)
  expectEach [
    (
      "the server's Ping goes out unmasked",
      expectEqual
        (fromU8Array [|0x89, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f|])
        ping,
    ),
    (
      "the client's Pong goes out masked with the sample key",
      expectEqual
        (fromU8Array [|
          0x8a,
          0x85,
          0x37,
          0xfa,
          0x21,
          0x3d,
          0x7f,
          0x9f,
          0x4d,
          0x51,
          0x58,
        |])
        pong,
    ),
  ]

-- The two extended-length examples state a header and leave the payload
-- unspecified, so these grade the header and the total length.
test "§5.7: 256 bytes of binary in one unmasked frame uses the 16-bit length" =
  let body = filled 256 0x61
  let wire = encodeServerFrame (Frame True Binary body)
  expectEach [
    (
      "the frame is a 4-byte header plus the payload",
      expectEqual (4 + 256) (B.length wire),
    ),
    (
      "the first byte marks a final binary frame",
      expectEqual 0x82 (U8.toInt wire[0]),
    ),
    (
      "the second byte selects the 16-bit length form",
      expectEqual 0x7e (U8.toInt wire[1]),
    ),
    (
      "the 16-bit length's high byte carries the 0x01 of 256",
      expectEqual 0x01 (U8.toInt wire[2]),
    ),
    (
      "the 16-bit length's low byte is zero",
      expectEqual 0x00 (U8.toInt wire[3]),
    ),
  ]

test "§5.7: 64KiB of binary in one unmasked frame uses the 64-bit length" =
  let body = filled 65536 0x62
  let wire = encodeServerFrame (Frame True Binary body)
  expectEach [
    (
      "the frame is a 10-byte header plus the payload",
      expectEqual (10 + 65536) (B.length wire),
    ),
    (
      "the first byte marks a final binary frame",
      expectEqual 0x82 (U8.toInt wire[0]),
    ),
    (
      "the second byte selects the 64-bit length form",
      expectEqual 0x7f (U8.toInt wire[1]),
    ),
    ("the 64-bit length's byte 1 is zero", expectEqual 0x00 (U8.toInt wire[2])),
    ("the 64-bit length's byte 2 is zero", expectEqual 0x00 (U8.toInt wire[3])),
    ("the 64-bit length's byte 3 is zero", expectEqual 0x00 (U8.toInt wire[4])),
    ("the 64-bit length's byte 4 is zero", expectEqual 0x00 (U8.toInt wire[5])),
    ("the 64-bit length's byte 5 is zero", expectEqual 0x00 (U8.toInt wire[6])),
    (
      "the 64-bit length's byte 6 carries the 0x01 of 65536",
      expectEqual 0x01 (U8.toInt wire[7]),
    ),
    ("the 64-bit length's byte 7 is zero", expectEqual 0x00 (U8.toInt wire[8])),
    ("the 64-bit length's byte 8 is zero", expectEqual 0x00 (U8.toInt wire[9])),
  ]

-- # Frame decoding — RFC 6455 §5.7's own bytes, read back

maskedHelloWire : Bytes
maskedHelloWire = fromU8Array [|
  0x81,
  0x85,
  0x37,
  0xfa,
  0x21,
  0x3d,
  0x7f,
  0x9f,
  0x4d,
  0x51,
  0x58,
|]

unmaskedHelloWire : Bytes
unmaskedHelloWire = fromU8Array [|0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f|]

test "§5.7's masked text frame decodes to an unmasked \"Hello\"" =
  match decodedAs (decodeFrame FromClient maxPayload maskedHelloWire 0)
    None => fail "the masked text frame failed to decode"
    Some (fin, opcode, payload, consumed) => expectEach [
      ("the frame is final", expectTrue fin),
      ("opcode == Text", expectEqual Text opcode),
      ("payload == \"Hello\"", expectEqual hello payload),
      ("consumed == 11", expectEqual 11 consumed),
    ]

test "§5.7's unmasked text frame decodes on the server-to-client side" =
  match decodedAs (decodeFrame FromServer maxPayload unmaskedHelloWire 0)
    None => fail "the unmasked text frame failed to decode"
    Some (fin, opcode, payload, consumed) => expectEach [
      ("the frame is final", expectTrue fin),
      ("opcode == Text", expectEqual Text opcode),
      ("payload == \"Hello\"", expectEqual hello payload),
      ("consumed == 7", expectEqual 7 consumed),
    ]

test "a second frame in the same buffer decodes at the reported offset" =
  let buffer = fromU8Array [|
    0x89,
    0x05,
    0x48,
    0x65,
    0x6c,
    0x6c,
    0x6f,
    0x81,
    0x05,
    0x48,
    0x65,
    0x6c,
    0x6c,
    0x6f,
  |]
  match decodedAs (decodeFrame FromServer maxPayload buffer 0)
    None => fail "the first frame in the buffer failed to decode"
    Some (_, first, _, consumed) =>
      match decodedAs (decodeFrame FromServer maxPayload buffer consumed)
        None => fail "the second frame in the buffer failed to decode"
        Some (_, second, payload, _) => expectEach [
          ("first == Ping", expectEqual Ping first),
          ("second == Text", expectEqual Text second),
          ("payload == \"Hello\"", expectEqual hello payload),
        ]

test "a 16-bit-length frame this module encoded decodes back to its payload" =
  let body = filled 300 0x61
  let wire = encodeServerFrame (Frame True Binary body)
  match decodedAs (decodeFrame FromServer maxPayload wire 0)
    None => fail "the 16-bit-length frame failed to decode"
    Some (fin, opcode, payload, consumed) => expectEach [
      ("the frame is final", expectTrue fin),
      ("opcode == Binary", expectEqual Binary opcode),
      ("payload == body", expectEqual body payload),
      ("consumed == B.length wire", expectEqual (B.length wire) consumed),
    ]

-- # Fragmentation — RFC 6455 §5.4

test "§5.7's two fragments reassemble into one \"Hello\" message" =
  let (afterFirst, firstEvent) =
    assembleFrame None (Frame False Text (encodeUtf8 "Hel"))
  let (afterSecond, secondEvent) =
    assembleFrame afterFirst (Frame True Continuation (encodeUtf8 "lo"))
  match (firstEvent, secondEvent, afterSecond)
    (EventPartial, EventMessage Text payload, None) => expectEqual hello payload
    _ =>
      fail
        "expected EventPartial then EventMessage Text with no assembly left open"

test "an unfragmented data frame is delivered without opening an assembly" =
  match assembleFrame None (Frame True Text hello)
    (None, EventMessage Text payload) => expectEqual hello payload
    _ => fail "expected an EventMessage Text with no assembly left open"

test "a control frame interleaved in a fragmented message leaves it open" =
  let (afterFirst, _) = assembleFrame None (Frame False Text (encodeUtf8 "Hel"))
  let (afterPing, pingEvent) =
    assembleFrame afterFirst (Frame True Ping (encodeUtf8 ""))
  let (_, finalEvent) =
    assembleFrame afterPing (Frame True Continuation (encodeUtf8 "lo"))
  match (pingEvent, finalEvent)
    (EventControl _, EventMessage Text payload) => expectEqual hello payload
    _ =>
      fail
        "expected an EventControl for the ping and EventMessage Text for the reassembled body"

test "a continuation frame with nothing open is refused with 1002 (§5.4)" =
  let (_, event) = assembleFrame None (Frame True Continuation hello)
  expectTrue (eventRejectedWith 1002 event)

test "a new data frame while a fragmented message is open is refused (§5.4)" =
  let (afterFirst, _) = assembleFrame None (Frame False Text (encodeUtf8 "Hel"))
  let (_, event) = assembleFrame afterFirst (Frame True Text hello)
  expectTrue (eventRejectedWith 1002 event)

-- # Adversarial input

test "an unmasked client frame is REFUSED, not read anyway (§5.1)" =
  expectTrue
    (rejectedWith 1002 (decodeFrame FromClient maxPayload unmaskedHelloWire 0))

test "a masked server frame is refused (§5.1)" =
  expectTrue
    (rejectedWith 1002 (decodeFrame FromServer maxPayload maskedHelloWire 0))

test "a set RSV bit is refused with 1002 (§5.2)" =
  expectTrue
    (rejectedWith
      1002
      (decodeFrame FromServer maxPayload (fromU8Array [|0xc1, 0x01, 0x41|]) 0))

test "a reserved opcode is refused with 1002 (§5.2)" =
  expectTrue
    (rejectedWith
      1002
      (decodeFrame FromServer maxPayload (fromU8Array [|0x83, 0x01, 0x41|]) 0))

test "a control frame declaring over 125 bytes is refused with 1002 (§5.5)" =
  expectTrue
    (rejectedWith
      1002
      (decodeFrame
        FromServer
        maxPayload
        (fromU8Array [|0x89, 0x7e, 0x01, 0x00|])
        0))

test "a fragmented control frame is refused with 1002 (§5.5)" =
  expectTrue
    (rejectedWith
      1002
      (decodeFrame FromServer maxPayload (fromU8Array [|0x09, 0x01, 0x41|]) 0))

test "a 64-bit length with the most significant bit set is refused (§5.2)" =
  let wire = fromU8Array [|0x82, 0x7f, 0x80, 0, 0, 0, 0, 0, 0, 0|]
  expectTrue (rejectedWith 1002 (decodeFrame FromServer maxPayload wire 0))

test "a non-minimally encoded length is refused with 1002 (§5.2)" =
  expectTrue
    (rejectedWith
      1002
      (decodeFrame
        FromServer
        maxPayload
        (fromU8Array [|0x82, 0x7e, 0x00, 0x05, 0x41|])
        0))

-- The two assertions that matter most: NOTHING is ever allocated to the size
-- an attacker declared. A terabyte declared in a ten-byte frame is refused
-- before any allocation, and a length merely larger than the bytes in hand
-- asks for more bytes rather than allocating for the promise.
test "a terabyte declared in a 10-byte frame is refused with 1009, not allocated" =
  let wire = fromU8Array [|0x82, 0x7f, 0, 0x01, 0, 0, 0, 0, 0, 0|]
  expectTrue (rejectedWith 1009 (decodeFrame FromServer maxPayload wire 0))

-- #2905: a 64-bit length from 2^62 up to 2^63 - 1 is past `Int`, and read as
-- an `Int` it wrapped to a negative number that the minimal-encoding check
-- then reported as a 1002. It is an oversized length, so it is a 1009.
test "a 64-bit length of 2^62 is refused as too big (1009), not as malformed" =
  let wire = fromU8Array [|0x82, 0x7f, 0x40, 0, 0, 0, 0, 0, 0, 0|]
  expectTrue (rejectedWith 1009 (decodeFrame FromServer maxPayload wire 0))

test "a 64-bit length of 2^63 - 1 is refused as too big (1009)" =
  let wire =
    fromU8Array [|0x82, 0x7f, 0x7f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff|]
  expectTrue (rejectedWith 1009 (decodeFrame FromServer maxPayload wire 0))

test "a declared length beyond the bytes in hand needs more, never allocates" =
  expectTrue
    (isNeedMore
      (decodeFrame
        FromServer
        maxPayload
        (fromU8Array [|0x81, 0x64, 0x48, 0x65, 0x6c|])
        0))

test "a truncated two-byte header needs more bytes" =
  expectTrue
    (isNeedMore (decodeFrame FromServer maxPayload (fromU8Array [|0x81|]) 0))

test "a 16-bit length field with only one of its two bytes needs more" =
  expectTrue
    (isNeedMore
      (decodeFrame FromServer maxPayload (fromU8Array [|0x82, 0x7e, 0x01|]) 0))

-- # The close handshake — RFC 6455 §5.5.1, §7.4

test "a close frame carries its status code big-endian, then the reason" =
  match closeFrame 1000 "bye"
    Frame fin opcode payload => expectEach [
      ("the frame is final", expectTrue fin),
      ("opcode == Close", expectEqual Close opcode),
      (
        "payload == big-endian code + reason",
        expectEqual (fromU8Array [|0x03, 0xe8, 0x62, 0x79, 0x65|]) payload,
      ),
    ]

test "a close payload parses back to its code and reason" =
  expectOkThen
    (opt => match opt
      Some (code, reason) => expectEach [
        ("code == 1000", expectEqual 1000 code),
        ("reason == \"bye\"", expectEqual (encodeUtf8 "bye") reason),
      ]
      None => fail "expected a close status, not the no-status case")
    (parseClosePayload (fromU8Array [|0x03, 0xe8, 0x62, 0x79, 0x65|]))

test "an empty close payload is no status, not a zero status (§5.5.1)" =
  expectOkThen expectNone (parseClosePayload (encodeUtf8 ""))

test "a one-byte close payload is a violation, not half a code (§5.5.1)" =
  expectErrContains "1 byte" (parseClosePayload (fromU8Array [|0x03|]))

test "close code 1005 may not appear on the wire (§7.4.1)" =
  expectErrContains
    "may not appear on the wire"
    (parseClosePayload (fromU8Array [|0x03, 0xed|]))

test "a private-range close code 4000 is accepted (§7.4.2)" =
  expectOkThen
    (opt => match opt
      Some (code, _) => expectEqual 4000 code
      None => fail "expected a close status, not the no-status case")
    (parseClosePayload (fromU8Array [|0x0f, 0xa0|]))

-- A masked payload is unmasked into a FRESH byte string; the read buffer a
-- caller may still be holding must not have been rewritten under it.
test "decoding does not mutate the caller's read buffer" =
  let wire = maskedHelloWire
  let before = MB.freeze (MB.thaw wire)
  let _ = decodeFrame FromClient maxPayload wire 0
  expectEqual before wire

-- A payload built by `filled` states "the length form, not the contents, is
-- what is under test" without a 126-element literal.
test "an all-ones 126-byte payload round-trips through the 16-bit length form" =
  let body = filled 126 0xff
  let wire = encodeServerFrame (Frame True Binary body)
  match decodedAs (decodeFrame FromServer maxPayload wire 0)
    Some (_, _, payload, _) => expectEqual body payload
    None => fail "the 126-byte payload frame failed to decode"
