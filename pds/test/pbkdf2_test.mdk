{- | Vector-graded tests for `pds/lib/pbkdf2.mdk` (S-kdf, #2604 password
   hashing half).

   The two `P`/`S`/`c`/`dkLen` -> output tuples below are hand-transcribed
   from RFC 7914 §11's published PBKDF2-HMAC-SHA-256 test vectors — not a
   self-captured golden (G5). The raw octets, byte-exact from the RFC, are
   committed separately at
   `pds/test/vectors/rfc7914_pbkdf2_hmac_sha256.txt`, ledgered in
   `pds/test/VECTOR-PROVENANCE.txt`; the literals here were read back
   against that file. `P`/`S` are ASCII strings per the RFC's own wording
   ("passed as sequences of ASCII octets") — inputs, not answer keys, so
   they need no provenance row of their own; only the expected output
   bytes are the graded values. -}

import test.{expectTrue}
import array.{take}
import lib.pbkdf2.{pbkdf2HmacSha256}

-- "passwd"
passwd : Array Int
passwd = [|112, 97, 115, 115, 119, 100|]

-- "salt"
salt1 : Array Int
salt1 = [|115, 97, 108, 116|]

-- "Password"
passwordCap : Array Int
passwordCap = [|80, 97, 115, 115, 119, 111, 114, 100|]

-- "NaCl"
nacl : Array Int
nacl = [|78, 97, 67, 108|]

expected1 : Array Int
expected1 = [|
  0x55,
  0xac,
  0x04,
  0x6e,
  0x56,
  0xe3,
  0x08,
  0x9f,
  0xec,
  0x16,
  0x91,
  0xc2,
  0x25,
  0x44,
  0xb6,
  0x05,
  0xf9,
  0x41,
  0x85,
  0x21,
  0x6d,
  0xde,
  0x04,
  0x65,
  0xe6,
  0x8b,
  0x9d,
  0x57,
  0xc2,
  0x0d,
  0xac,
  0xbc,
  0x49,
  0xca,
  0x9c,
  0xcc,
  0xf1,
  0x79,
  0xb6,
  0x45,
  0x99,
  0x16,
  0x64,
  0xb3,
  0x9d,
  0x77,
  0xef,
  0x31,
  0x7c,
  0x71,
  0xb8,
  0x45,
  0xb1,
  0xe3,
  0x0b,
  0xd5,
  0x09,
  0x11,
  0x20,
  0x41,
  0xd3,
  0xa1,
  0x97,
  0x83,
|]

expected2 : Array Int
expected2 = [|
  0x4d,
  0xdc,
  0xd8,
  0xf6,
  0x0b,
  0x98,
  0xbe,
  0x21,
  0x83,
  0x0c,
  0xee,
  0x5e,
  0xf2,
  0x27,
  0x01,
  0xf9,
  0x64,
  0x1a,
  0x44,
  0x18,
  0xd0,
  0x4c,
  0x04,
  0x14,
  0xae,
  0xff,
  0x08,
  0x87,
  0x6b,
  0x34,
  0xab,
  0x56,
  0xa1,
  0xd4,
  0x25,
  0xa1,
  0x22,
  0x58,
  0x33,
  0x54,
  0x9a,
  0xdb,
  0x84,
  0x1b,
  0x51,
  0xc9,
  0xb3,
  0x17,
  0x6a,
  0x27,
  0x2b,
  0xde,
  0xbb,
  0xa1,
  0xd0,
  0x78,
  0x47,
  0x8f,
  0x62,
  0xb3,
  0x97,
  0xf3,
  0x3c,
  0x8d,
|]

test "RFC 7914 §11 vector 1: P=passwd S=salt c=1 dkLen=64" =
  expectTrue (pbkdf2HmacSha256 passwd salt1 1 64 == expected1)

test "RFC 7914 §11 vector 2: P=Password S=NaCl c=80000 dkLen=64" =
  expectTrue (pbkdf2HmacSha256 passwordCap nacl 80000 64 == expected2)

test "shorter dkLen truncates the same block stream rather than re-deriving" =
  let full = pbkdf2HmacSha256 passwd salt1 1 64
  let short = pbkdf2HmacSha256 passwd salt1 1 20
  expectTrue (arrayLength short == 20 && short == take 20 full)

test "does not mutate its Array Int inputs" =
  let passwordBefore = arrayCopy passwd
  let saltBefore = arrayCopy salt1
  let _ = pbkdf2HmacSha256 passwd salt1 1 64
  expectTrue (passwd == passwordBefore && salt1 == saltBefore)
