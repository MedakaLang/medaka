{- | P4-C end-to-end record-write driver.

   Replays the SAME provenance-pinned Phase-1 repository transcript
   (`pds/test/vectors/repo_reference_corpus.txt`) that
   `pds/test/repo_vectors_main.mdk` replays directly against `lib.repo`, but
   through the full protocol seam instead: JSON request BYTES into
   `handleBytes`, JSON response BYTES out. Every `uri`, record `cid`,
   `commit.cid`, and `commit.rev` in the response is compared against the
   corpus's pinned value for that step, so the handler layer is graded against
   the official atproto oracle rather than against itself.

   It then grades the three state-preservation properties the record layer
   owes: a mismatched `swapCommit` is `InvalidSwap` and leaves the `Store`
   byte-identical, `validate: true` is refused outright, and an unknown
   collection or a malformed body leaves the `Store` byte-identical. -}

import json.{Json(..), jObject, get, parse, stringify}
import hex.{decode}
import io.{readLines}
import string.{fromUtf8, split, startsWith, toUtf8}
import lib.cid.{cidToString}
import lib.dagcbor.{dagCborDecode}
import lib.handlers.{recordServer}
import lib.lexjson.{dagCborToLexJson}
import lib.repo.{
  Repo,
  repoCommitCid,
  repoInitFromKeyBytes,
  repoLatestCommit,
  repoRootCid,
}
import lib.jwt.{mintToken}
import lib.server_core.{
  Account,
  RequestContext(..),
  Server,
  handleBytes,
  makeAccount,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeFromRepo,
  storeRepo,
  storeSessionOpen,
  storeWithServerSecret,
}
import lib.tid.{Tid, tidParse}

accountHandleText : String
accountHandleText = "medaka.example"

accountHostText : String
accountHostText = "pds.example"

collectionText : String
collectionText = "app.bsky.feed.post"

mustHex : String -> Array Int
mustHex text = match decode text
  Ok bytes => bytes
  Err message => panic "record_handlers: malformed hex: \{message}"

mustTid : String -> Tid
mustTid text = match tidParse text
  Ok tid => tid
  Err message => panic "record_handlers: malformed TID: \{message}"

mustRecordJson : String -> Json
mustRecordJson text = match dagCborDecode (mustHex text)
  Ok value => dagCborToLexJson value
  Err message => panic "record_handlers: malformed record: \{message}"

mustAccount : String -> Account
mustAccount did = match makeAccount did accountHandleText accountHostText
  Ok account => account
  Err message => panic "record_handlers: account setup failed: \{message}"

mustServer : Account -> Server
mustServer account = match recordServer account
  Ok server => server
  Err message => panic "record_handlers: server setup failed: \{message}"

mustRepo : String -> String -> Tid -> Repo
mustRepo did secretHex rev =
  match repoInitFromKeyBytes did (mustHex secretHex) rev
    Ok repo => repo
    Err message => panic "record_handlers: repository init failed: \{message}"

-- ── the session credential every write now needs ──────────────────────────

{- | A fixed session-token secret and a fixed instant. Record writes are
   `AuthenticatedRoute`, so `lib.server_core`'s seam refuses one that
   arrives without a verifiable bearer token — a driver that replays
   writes must present one, and the store it replays them against must
   carry the secret that token was minted from.

   The secret is a fixture, not entropy: this file grades handler
   behavior, and a random secret would only make the transcript
   irreproducible. -}
testSecret : Array Int
testSecret = arrayMakeWith 32 (i => (i * 7 + 3) % 256)

testInstant : Int
testInstant = 1700000000

{- | The per-request nonce every request in this file is placed at. Nothing
   here drives a route that mints a token, so the value only has to be fixed;
   `pds/shell/server.mdk` draws a real one from `osEntropyBytes` per request. -}
testNonce : Array Int
testNonce = arrayMakeWith 16 (i => (i * 11 + 5) % 256)

testContext : RequestContext
testContext = RequestContext { nowSeconds = testInstant, nonce = testNonce }

{- | The store a replayed write is applied to: it carries the session secret
   the fixture token was minted from, and the open session that token belongs
   to. A verified signature is not on its own a credential — the seam also
   requires the token's session to be open (`lib.store`) — so a driver that
   presents a token must open its session too.

   The session's refresh half is the fingerprint of a string that is not a
   token at all: no route this file drives is a `RefreshRoute`, so nothing can
   present it. -}
authorizedStore : String -> Store -> Store
authorizedStore did store = match storeWithServerSecret testSecret store
  Ok next =>
    storeSessionOpen
      (sessionFingerprint (testToken did))
      (sessionFingerprint "record_handlers: no refresh token in this fixture")
      (testInstant + 3600)
      next
  Err message =>
    panic "record_handlers: session secret setup failed: \{message}"

-- The audience is this PDS's own hostname and the subject the account
-- DID, which is exactly what the seam verifies against.
testToken : String -> String
testToken did =
  mintToken
    testSecret
    did
    accountHostText
    "record_handlers-fixture-token"
    (testInstant - 60)
    (testInstant + 3600)

-- ── request framing ─────────────────────────────────────────────────────────

procedureRequest : String -> String -> String -> Array Int
procedureRequest did nsid body =
  let bytes = toUtf8 body
  toUtf8
      "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\nAuthorization: Bearer \{testToken did}\r\nContent-Type: application/json\r\nContent-Length: \{intToString (arrayLength bytes)}\r\n\r\n"
    ++ bytes

-- Everything after the first CRLFCRLF is the response body.
bodyStart : Array Int -> Int -> Int
bodyStart bytes i =
  if i + 3 >= arrayLength bytes then
    panic "record_handlers: response has no body separator"
  else if bytes[i] == 13
    && bytes[i + 1] == 10
    && bytes[i + 2] == 13
    && bytes[i + 3] == 10 then
    i + 4
  else
    bodyStart bytes (i + 1)

responseBodyText : Array Int -> String
responseBodyText bytes =
  let start = bodyStart bytes 0
  fromUtf8 (arrayMakeWith (arrayLength bytes - start) (i => bytes[start + i]))

responseJson : Array Int -> Json
responseJson bytes = match parse (responseBodyText bytes)
  Ok value => value
  Err message => panic "record_handlers: response body is not JSON: \{message}"

fieldText : String -> Json -> String
fieldText name value = match get name value
  Some (JString text) => text
  _ => "<missing:\{name}>"

commitField : String -> Json -> String
commitField name value = match get "commit" value
  Some commit => fieldText name commit
  None => "<missing:commit>"

-- ── the transcript ──────────────────────────────────────────────────────────

createBody : String -> String -> String -> Json -> String
createBody did collection rkey record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
      ("record", record),
    ])

deleteBody : String -> String -> String -> String
deleteBody did collection rkey =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collection),
      ("rkey", JString rkey),
    ])

splitPath : String -> (String, String)
splitPath text = match split "/" text
  [collection, rkey] => (collection, rkey)
  _ => panic "record_handlers: malformed corpus path"

runStep : String -> Server -> Store -> String -> String -> <IO> Store
runStep did server store opLine commitLine = match (
  split "\t" opLine,
  split "\t" commitLine,
)
  (["OP", kind, pathHex, recordHex, recordCid, rev], ["COMMIT", _, _, _, commitCid, _]) =>
    let (collection, rkey) = splitPath (fromUtf8 (mustHex pathHex))
    let (nsid, body) = match kind
      "CREATE" => (
        "com.atproto.repo.createRecord",
        createBody did collection rkey (mustRecordJson recordHex),
      )
      "UPDATE" => (
        "com.atproto.repo.putRecord",
        createBody did collection rkey (mustRecordJson recordHex),
      )
      "DELETE" =>
        ("com.atproto.repo.deleteRecord", deleteBody did collection rkey)
      _ => panic "record_handlers: unknown transcript operation \{kind}"
    let (next, responseBytes) =
      handleBytes server testContext store (procedureRequest did nsid body)
    let value = responseJson responseBytes
    let expectedUri = "at://\{did}/\{collection}/\{rkey}"
    let uriOk = kind == "DELETE" || fieldText "uri" value == expectedUri
    let cidOk = kind == "DELETE" || fieldText "cid" value == recordCid
    let commitOk = commitField "cid" value == commitCid
    let revOk = commitField "rev" value == rev
    if uriOk && cidOk && commitOk && revOk then
      let () =
        println
          "STEP \{kind} PASS rkey=\{rkey} cid=\{fieldText "cid" value} commit=\{commitCid} rev=\{rev}"
      next
    else
      let () =
        println
          "STEP \{kind} FAIL rkey=\{rkey} uri=\{fieldText "uri" value} cid=\{fieldText "cid" value} commit=\{commitField "cid" value} rev=\{commitField "rev" value}"
      let () = exit 1
      next
  _ => panic "record_handlers: malformed transcript rows"

-- ── state-preservation cells ────────────────────────────────────────────────

storeFingerprint : Store -> String
storeFingerprint store = match storeRepo store
  None => "<unconfigured>"
  Some repo =>
    "\{cidToString (repoCommitCid (repoLatestCommit repo))}/\{cidToString (repoRootCid repo)}"

rejectCell : String ->
  String ->
  String ->
  String ->
  Server ->
  Store ->
  String ->
  <IO> Int
rejectCell label expectedCode did nsid server store body =
  let before = storeFingerprint store
  let (next, responseBytes) =
    handleBytes server testContext store (procedureRequest did nsid body)
  let value = responseJson responseBytes
  let after = storeFingerprint next
  let code = fieldText "error" value
  if code == expectedCode && before == after then
    let () =
      println
        "CELL \{label} PASS error=\{code} message=\{fieldText "message" value} state=unchanged"
    1
  else
    let () =
      println "CELL \{label} FAIL error=\{code} before=\{before} after=\{after}"
    0

swapCommitBody : String -> String -> Json -> String
swapCommitBody did rkey record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collectionText),
      ("rkey", JString rkey),
      ("record", record),
      (
        "swapCommit",
        JString "bafyreie5737gdxlw5i64vzichcalba3z2v5n6icifvx5xytvske7mr3hpm",
      ),
    ])

validateBody : String -> String -> Json -> String
validateBody did rkey record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString collectionText),
      ("rkey", JString rkey),
      ("record", record),
      ("validate", JBool True),
    ])

unknownCollectionBody : String -> String -> Json -> String
unknownCollectionBody did rkey record =
  stringify
    (jObject [
      ("repo", JString did),
      ("collection", JString "not-an-nsid"),
      ("rkey", JString rkey),
      ("record", record),
    ])

runCells : String -> Server -> Store -> Json -> <IO> Unit
runCells did server store record =
  let create = "com.atproto.repo.createRecord"
  let swap =
    rejectCell
      "swap-commit-mismatch"
      "InvalidSwap"
      did
      create
      server
      store
      (swapCommitBody did "medaka-c" record)
  let validate =
    rejectCell
      "validate-true-refused"
      "InvalidRequest"
      did
      create
      server
      store
      (validateBody did "medaka-d" record)
  let unknown =
    rejectCell
      "unknown-collection"
      "InvalidRequest"
      did
      create
      server
      store
      (unknownCollectionBody did "medaka-e" record)
  let malformed =
    rejectCell
      "malformed-json"
      "InvalidRequest"
      did
      create
      server
      store
      "{\"repo\": "
  let cells = swap + validate + unknown + malformed
  let () = println "cells: \{intToString cells}/4 state-preserving rejections"
  if cells == 4 then
    println "CELLS: PASS"
  else
    let () = println "CELLS: FAIL"
    exit 1

-- ── driver ──────────────────────────────────────────────────────────────────

initialTidFrom : String -> Tid
initialTidFrom line = match split "\t" line
  ["TID", _, _, text] => mustTid text
  _ => panic "record_handlers: malformed initial TID row"

runTranscript : List String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  <IO> Unit
runTranscript ["META", did, secretHex] t0 op1 c1 op2 c2 op3 c3 op4 c4 =
  let account = mustAccount did
  let server = mustServer account
  let repo = mustRepo did secretHex (initialTidFrom t0)
  let store = authorizedStore did (storeFromRepo repo)
  let s1 = runStep did server store op1 c1
  let s2 = runStep did server s1 op2 c2
  let s3 = runStep did server s2 op3 c3
  let s4 = runStep did server s3 op4 c4
  let () =
    println "transcript: 4/4 handler-layer steps matched the pinned corpus"
  let () = println "final-commit: \{storeFingerprint s4}"
  let () = runCells did server s1 (recordJsonFrom op1)
  println "TOTAL: PASS"
runTranscript _ _ _ _ _ _ _ _ _ _ = panic "record_handlers: malformed META row"

recordJsonFrom : String -> Json
recordJsonFrom line = match split "\t" line
  ["OP", _, _, recordHex, _, _] => mustRecordJson recordHex
  _ => panic "record_handlers: malformed operation row"

runRows : List String -> <IO> Unit
runRows [meta, t0, _, _, _, _, _, op1, c1, _, _, op2, c2, op3, c3, op4, c4, _, _, "END"] =
  runTranscript (split "\t" meta) t0 op1 c1 op2 c2 op3 c3 op4 c4
runRows _ = panic "record_handlers: unexpected corpus shape"

meaningful : String -> Bool
meaningful line = line /= "" && not (startsWith "#" line)

runRead : Result String (List String) -> <IO> Unit
runRead (Err message) = panic "record_handlers: cannot read corpus: \{message}"
runRead (Ok raw) = runRows (filter meaningful raw)

runMain : List String -> <IO, Env, FileRead "_"> Unit
runMain [corpusPath] = runRead (readLines corpusPath)
runMain _ = panic "usage: record_handlers_main <ledger-owned-corpus>"

main : <IO, Env, FileRead "_"> Unit
main = runMain (args ())
