{- | The PDS's capability manifests, checked in and kept current, and the
   systemd unit's sandbox checked against the entry it runs.

   `pds/capabilities/main.toml` is `medaka manifest pds/serve.mdk`, and
   `pds/capabilities/serve.toml` is the same with `--fn serve`, the entry
   `pds.service` starts. Each is compared with a fresh run byte for byte, so
   a change to what the server may do shows up as a diff to a file a
   reviewer reads.

   The sandbox half derives a `check-policy --allow` list from
   `pds/pds.service` and checks `serve` against it. It makes two claims of
   different kinds.

   Writes and dials are an agreement. `ProtectSystem=strict` and
   `IPAddressDeny=any`, pinned by `deploy_config_lint_test.mdk`, make the
   unit's allow lines the whole of what the process may write and dial, so
   `serve`'s manifest is inside the sandbox exactly when it is inside these:

   - each `ReadWritePaths=` directory gives `FileWrite` of everything
     beneath it,
   - each `IPAddressAllow=` address gives `Net` of that address, with
     `localhost` read as `127.0.0.1`, the one address `serve` dials.

   Reads are not. `ProtectSystem=strict` leaves most of the filesystem
   readable (`/usr`, `/etc`, `/opt`), and `ReadOnlyPaths=` grants nothing
   that was not already readable, so no line of the unit bounds what the
   process may read. What the derivation checks instead is that the
   manifest's reads fall within the directories the unit NAMES: each
   `ReadWritePaths=` and `ReadOnlyPaths=` directory gives `FileRead` of
   everything beneath it. That is a claim that the manifest is narrower than
   the sandbox, not that the two agree.

   Paths are written relative to `WorkingDirectory=`, as the program's own
   rows are. The labels systemd does not govern are allowed whole.

   The two mutation controls narrow one allow line of the unit in memory and
   must turn the verdict to `rejected.`, so the accepted row cannot pass by
   the derivation allowing everything. The third checks `runKeygen`, which
   writes under `secrets/`, with every read allowed: it must be rejected for
   its writes alone.

   Runs under `medaka test --native`: every assertion but the derivation's
   own spawns `medaka`, and the interpreter binds no subprocess extern. -}

import list.{lookup, zip, zipWith}
import string.{join, lines, startsWith, stripPrefix, unwords, words}
import test.{Expectation(..), expectEqual, expectEqualLines}
import test_process.{medakaBin, spawnTimeoutSeconds, testJobs, underRoot}

-- # The subject

serveSource : <IO> String
serveSource = underRoot "pds/serve.mdk"

-- # Spawning

-- | The arguments to `perl` that run `bin` with `args` under the same `alarm`
-- wrapper `boundedVerb` gives each spawn. `runCommandBatch` runs the batches
-- below, `testJobs` at a time.
boundedArgv : String -> List String -> List String
boundedArgv bin args =
  ["-e", "alarm \{intToString spawnTimeoutSeconds}; exec @ARGV", "env", bin]
    ++ args

-- # The checked-in manifests

-- The two `medaka manifest` runs this suite grades, keyed by their extra
-- arguments. Both run side by side, once, in one batch.
manifestRuns : <Exec, IO> List (List String, Result String (Int, String, String))
manifestRuns =
  let bin = medakaBin
  let src = serveSource
  let extras = [[], ["--fn", "serve"]]
  let argvs = map (extra => boundedArgv bin (["manifest", src] ++ extra)) extras
  zip extras (runCommandBatch "perl" testJobs argvs)

-- | What `medaka manifest pds/serve.mdk` prints on stdout with `extra`
-- arguments, or why it printed nothing.
manifestOf : List String -> <Exec, IO> Result String String
manifestOf extra = match lookup extra manifestRuns
  None => Err "no medaka manifest run with \{unwords extra}"
  Some (Err e) => Err "could not run medaka manifest: \{e}"
  Some (Ok (0, out, _)) => Ok out
  Some (Ok (code, out, err)) =>
    Err "medaka manifest exited \{intToString code}: \{out}\{err}"

-- | Passes when the file at `rel` is byte for byte what `medaka manifest`
-- prints with `extra`.
expectCheckedIn : String -> List String -> <Exec, FileRead, IO> Expectation
expectCheckedIn rel extra = match readFile (underRoot rel)
  Err e => Fail "could not read \{rel}: \{e}" "the checked-in manifest" "none"
  Ok want => match manifestOf extra
    Err e => Fail e want "no manifest"
    Ok got => expectEqualLines want got

test "pds/capabilities/main.toml is `medaka manifest pds/serve.mdk`" =
  expectCheckedIn "pds/capabilities/main.toml" []

test "pds/capabilities/serve.toml is `medaka manifest pds/serve.mdk --fn serve`" =
  expectCheckedIn "pds/capabilities/serve.toml" ["--fn", "serve"]

-- # Deriving a policy from the unit

-- | The labels systemd has no directive for, allowed whole.
ungoverned : List String
ungoverned = [
  "Clock",
  "Kdf",
  "Mint",
  "Rand",
  "Sign",
  "Signal",
  "Stderr",
  "Stdout",
]

-- | Every value the unit gives `key`, one per line that sets it.
directiveValues : String -> List String -> List String
directiveValues key ls = filterMap (stripPrefix "\{key}=") ls

{- | The `check-policy --allow` entries the unit's lines give, or why they
   cannot be read. The `FileWrite` and `Net` entries are what the sandbox
   permits; the `FileRead` entries are the directories the unit names, which
   is narrower than what it permits.

   A path outside `WorkingDirectory=` is an `Err` rather than skipped: the
   program names no path outside it, so such a line is one this derivation
   does not understand. -}
unitPolicy : List String -> Result String (List String)
unitPolicy ls = match directiveValues "WorkingDirectory" ls
  [root] => do
    written <- beneath
      root
      (rel => ["FileRead=\{rel}/*", "FileWrite=\{rel}/*"])
      (flatMap words (directiveValues "ReadWritePaths" ls))
    named <- beneath
      root
      (rel => ["FileRead=\{rel}/*"])
      (flatMap words (directiveValues "ReadOnlyPaths" ls))
    let dialled =
      map netEntry (flatMap words (directiveValues "IPAddressAllow" ls))
    Ok (written ++ named ++ dialled ++ ungoverned)
  [] => Err "the unit sets no WorkingDirectory="
  _ => Err "the unit sets WorkingDirectory= more than once"

-- | `grant` of each path's name relative to `root`.
beneath : String ->
  (String -> List String) ->
  List String ->
  Result String (List String)
beneath _ _ [] = Ok []
beneath root grant (path :: rest) = match stripPrefix "\{root}/" path
  Some rel if rel /= "" => map (grant rel ++ _) (beneath root grant rest)
  _ => Err "\{path} is not beneath WorkingDirectory=\{root}"

netEntry : String -> String
netEntry "localhost" = "Net=127.0.0.1"
netEntry address = "Net=\{address}"

-- | The unit as it is on disk, one element per line.
unitLines : <FileRead, IO> Result String (List String)
unitLines = map lines (readFile (underRoot "pds/pds.service"))

-- | The policy of the unit on disk with `rewrite` applied to its lines.
policyOf : (List String -> List String) ->
  <FileRead, IO> Result String (List String)
policyOf rewrite = match unitLines
  Err e => Err "could not read pds/pds.service: \{e}"
  Ok ls => unitPolicy (rewrite ls)

-- | Every line, with a line equal to `old` replaced by `new`.
replacing : String -> String -> List String -> List String
replacing old new ls = map (l => if l == old then new else l) ls

test "the unit's sandbox derives the expected policy" =
  expectEqual
    (Ok
      ([
          "FileRead=data/*", "FileWrite=data/*", "FileRead=secrets/*",
          "Net=127.0.0.1"
        ]
        ++ ungoverned))
    (policyOf identity)

-- # Checking serve against it

-- | The `check-policy` runs this suite grades, each named: the entry it
-- checks and the policy it checks it under. A row whose policy cannot be read
-- is still spawned, with an empty `--allow`, and its verdict is that read
-- error (see `verdictGraded`), so the spawn's own result is never graded.
policyRuns : <FileRead, IO> List (String, (String, Result String (List String)))
policyRuns = [
  ("serve", ("serve", servePolicy)),
  ("mutation: ReadWritePaths narrowed", ("serve", narrowedReadWritePolicy)),
  ("mutation: IPAddressAllow", ("serve", narrowedNetPolicy)),
  ("runKeygen", ("runKeygen", everyReadPolicy)),
]

-- The unit's own policy, and the three variants the controls grade.
servePolicy : <FileRead, IO> Result String (List String)
servePolicy = policyOf identity

narrowedReadWritePolicy : <FileRead, IO> Result String (List String)
narrowedReadWritePolicy =
  policyOf
    (replacing
      "ReadWritePaths=/opt/pds/data"
      "ReadWritePaths=/opt/pds/data/blocks")

narrowedNetPolicy : <FileRead, IO> Result String (List String)
narrowedNetPolicy =
  policyOf (replacing "IPAddressAllow=localhost" "IPAddressAllow=10.0.0.1")

everyReadPolicy : <FileRead, IO> Result String (List String)
everyReadPolicy = everyReadAllowed servePolicy

{- | The verdict of every `policyRuns` row, in order, each as `verdictOf`
   would report it. The checks run side by side, at most `testJobs` at once. -}
policyVerdicts : <Exec, FileRead, IO> List (String, Result String (Int, String))
policyVerdicts =
  let bin = medakaBin
  let src = serveSource
  let argvs =
    map
      ((_, (entry, policy)) =>
        boundedArgv bin (checkPolicyArgs src entry policy))
      policyRuns
  zipWith
    ((name, (_, policy)) run => (name, verdictGraded policy run))
    policyRuns
    (runCommandBatch "perl" testJobs argvs)

-- The `check-policy` arguments for `entry` under `policy`.
checkPolicyArgs : String -> String -> Result String (List String) -> List String
checkPolicyArgs src entry policy = [
  "check-policy",
  src,
  "--fn",
  entry,
  "--allow",
  allowList policy,
]

-- The `--allow` value a policy gives, or none when it cannot be read.
allowList : Result String (List String) -> String
allowList (Ok policy) = join "," policy
allowList (Err _) = ""

{- | The exit status of `medaka check-policy pds/serve.mdk --fn <entry>`
   under `policy`, and the first word of its verdict line, graded from the
   spawn `spawned`.

   The verdict word, not only the status, is graded: a run that could not
   read the policy also exits nonzero. -}
verdictGraded : Result String (List String) ->
  Result String (Int, String, String) ->
  Result String (Int, String)
verdictGraded (Err e) _ = Err e
verdictGraded (Ok _) (Err e) = Err "could not run medaka check-policy: \{e}"
verdictGraded (Ok _) (Ok (code, out, err)) =
  Ok (code, verdictWord (lines (out ++ err)))

-- | The verdict of the `policyRuns` row named `name`.
verdictNamed : String -> <Exec, FileRead, IO> Result String (Int, String)
verdictNamed name = match lookup name policyVerdicts
  Some verdict => verdict
  None => Err "no check-policy run named \{name}"

{- | `policy` with its `FileRead` entries replaced by `FileRead` whole: every
   read allowed, which is closer to what `ProtectSystem=strict` permits than
   the named directories are. -}
everyReadAllowed : Result String (List String) -> Result String (List String)
everyReadAllowed policy =
  map
    (entries =>
      "FileRead" :: filter (e => not (startsWith "FileRead=" e)) entries)
    policy

verdictWord : List String -> String
verdictWord [] = "no verdict"
verdictWord (line :: rest) =
  if startsWith "accepted." line then
    "accepted."
  else if startsWith "rejected." line then
    "rejected."
  else
    verdictWord rest

test "serve is accepted under the unit's sandbox" =
  expectEqual (Ok (0, "accepted.")) (verdictNamed "serve")

test "mutation control: ReadWritePaths narrowed to data/blocks is rejected" =
  expectEqual
    (Ok (1, "rejected."))
    (verdictNamed "mutation: ReadWritePaths narrowed")

test "mutation control: IPAddressAllow=10.0.0.1 is rejected" =
  expectEqual (Ok (1, "rejected.")) (verdictNamed "mutation: IPAddressAllow")

-- `runKeygen` writes `secrets/key.hex` and `secrets/token.hex`, outside the
-- one directory the unit lets the process write. With every read allowed,
-- the writes are the only thing left to reject it for.
test "control: runKeygen, which writes under secrets/, is rejected with every read allowed" =
  expectEqual (Ok (1, "rejected.")) (verdictNamed "runKeygen")
