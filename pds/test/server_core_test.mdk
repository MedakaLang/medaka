{- | Pure Store and end-to-end HTTP/XRPC composition tests. -}

import bytes as B
import bytes.{Bytes, encodeUtf8, fromArray, fromU8Array}
import http.{
  Header,
  HttpParseFailure(..),
  Request,
  makeHeader,
  makeResponse,
  parseRequest,
  parseRequestClassified,
  Response,
  responseBody,
  responseStatus,
  serializeResponse,
}
import json.{Json(..), get, parse}
import u8 as U8
import test.{
  expectAll,
  expectEach,
  expectEqual,
  expectOkThen,
  expectTrue,
  fail,
  pass,
}
import lib.cid.{cidForRaw}
import lib.jwt.{mintToken}
import lib.proxy.{AppviewTable, makeAppviewRoute, makeAppviewTable}
import lib.server_core.{
  Account,
  ProxyDecision(..),
  RequestContext(..),
  Handler,
  Server,
  UpgradeDecision(..),
  accessAudience,
  classifyProxy,
  classifyUpgrade,
  handle,
  handleBytes,
  makeAccount,
  makeServer,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeEmpty,
  storeGet,
  storePut,
  storeSessionOpen,
  storeSize,
  storeWithServerSecret,
}
import test.fixture_support.{testNonce, testSecret}
import test.request_support.{resourceRequest}
import test.response_support.{expectedError, expectedTextResponse}
import lib.xrpc.{
  AuthPolicy(..),
  Endpoint,
  InputPolicy(..),
  Registry,
  XrpcCall(..),
  makeRegistry,
  procedureEndpoint,
  queryEndpoint,
  subscriptionEndpoint,
}

mustHeader : String -> String -> Header
mustHeader name value =
  resultOrPanic
    "server_core_test: header setup failed"
    (makeHeader name (encodeUtf8 value))

mustResponse : Int -> String -> String -> Response
mustResponse status reason body =
  match (makeResponse
    status
    reason
    [mustHeader "content-type" "text/plain"]
    (encodeUtf8 body))
    Ok response => response
    Err message => panic "server_core_test: response setup failed: \{message}"

mustEndpoint : Result String Endpoint -> Endpoint
mustEndpoint (Ok endpoint) = endpoint
mustEndpoint (Err message) =
  panic "server_core_test: endpoint setup failed: \{message}"

mustRegistry : Result String Registry -> Registry
mustRegistry (Ok registry) = registry
mustRegistry (Err message) =
  panic "server_core_test: registry setup failed: \{message}"

registry : Registry
registry =
  mustRegistry
    (makeRegistry [
      mustEndpoint (queryEndpoint "com.example.query.fixed" PublicRoute),
      mustEndpoint
        (procedureEndpoint "com.example.block.put" RawInput PublicRoute),
    ])

handler : Handler
handler _ _ store (QueryCall "com.example.query.fixed" _) =
  (store, mustResponse 200 "OK" "fixed")
handler _ _ store (ProcedureRawCall "com.example.block.put" [] _ bytes) =
  match storePut (cidForRaw bytes) bytes store
    Err message =>
      panic "server_core_test: verified store update failed: \{message}"
    Ok next => (next, mustResponse 201 "Created" "stored")
handler _ _ _ _ = panic "server_core_test: unexpected routed call"

account : Account
account =
  match makeAccount "did:plc:medakaservertest" "server.example" "pds.example"
    Ok value => value
    Err message => panic "server_core_test: account setup failed: \{message}"

{- | The instant every request in this file is placed at. `lib.server_core`
   reads no clock, so each of its callers supplies one. -}
{- | The per-request nonce every request in this file is placed at. Nothing
   here drives a route that mints a token, so the value only has to be fixed;
   `pds/shell/server.mdk` draws a real one from `osEntropyBytes` per request. -}
testContext : RequestContext
testContext =
  RequestContext { nowSeconds = 1700000000, nonce = testNonce, login = None }

server : Server
server = makeServer account registry handler

seedBytes : Bytes
seedBytes = encodeUtf8 "seed"

seededStore : Store
seededStore =
  resultOrPanic
    "server_core_test: seed store setup failed"
    (storePut (cidForRaw seedBytes) seedBytes storeEmpty)

seedPreserved : Store -> Bool
seedPreserved store =
  storeSize store == 1 && storeGet (cidForRaw seedBytes) store == Some seedBytes

fixedQuery : Bytes
fixedQuery =
  encodeUtf8
    "GET /xrpc/com.example.query.fixed?one=1&one=2 HTTP/1.1\r\nHost: pds.example\r\n\r\n"

fixedPut : Bytes
fixedPut =
  encodeUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/octet-stream\r\nContent-Length: 3\r\n\r\nabc"

chunkedPut : Bytes
chunkedPut =
  encodeUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: pds.example\r\nContent-Type: application/octet-stream\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n2\r\nbc\r\n0\r\n\r\n"

malformedRequest : Bytes
malformedRequest =
  encodeUtf8
    "POST /xrpc/com.example.block.put HTTP/1.1\r\nHost: pds.example\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"

unknownRequest : Bytes
unknownRequest =
  encodeUtf8
    "GET /xrpc/com.example.query.unknown HTTP/1.1\r\nHost: pds.example\r\n\r\n"

-- The same bytes as `fixedQuery`, with one element outside 0..255 appended.
-- RFC 9112 s2.1 defines an HTTP message as a sequence of octets, so this is
-- not an HTTP message at all. `Bytes` carries that property by construction
-- and `fromArray` is its sole door, which is where the refusal belongs.
outOfDomainQuery : Array Int
outOfDomainQuery = B.toArray fixedQueryPlain ++ [|256|]

fixedQueryPlain : Bytes
fixedQueryPlain =
  encodeUtf8
    "GET /xrpc/com.example.query.fixed HTTP/1.1\r\nHost: pds.example\r\n\r\n"

{- | The door refuses, and the control shows what it is refusing.

   `handleBytes` and `parseRequest` both take a `Bytes`, so an out-of-domain
   array has no route into either: `fromArray` answers `None` and there is no
   value to hand on. The control below is the same request without the
   out-of-domain element, which the door admits — so the refusal is about
   that element and not about the request. -}
test "an out-of-domain request array is refused at the door, not framed" = expectAll
  [
    expectTrue (isNone (fromArray outOfDomainQuery)),
    expectTrue (isSome (fromArray (B.toArray fixedQueryPlain))),
  ]

test "Store starts empty and delegates verified immutable insertion" =
  let bytes = fromU8Array [|1, 2, 3|]
  let cid = cidForRaw bytes
  expectOkThen
    (next => expectEach [
      ("storeSize storeEmpty == 0", expectEqual 0 (storeSize storeEmpty)),
      ("storeSize next == 1", expectEqual 1 (storeSize next)),
      (
        "storeGet cid next == Some [1,2,3]",
        expectEqual (Some (fromU8Array [|1, 2, 3|])) (storeGet cid next),
      ),
    ])
    (storePut cid bytes storeEmpty)

test "classified parser exposes malformed framing without diagnostic matching" =
  match parseRequestClassified malformedRequest
    Err (HttpMalformed _) => pass
    _ => fail "expected an HttpMalformed classification"

test "classified parser exposes resource excess without diagnostic matching" =
  match parseRequestClassified resourceRequest
    Err (HttpResourceExcess _) => pass
    _ => fail "expected an HttpResourceExcess classification"

test "original parseRequest API retains its Result String contract" =
  expectTrue (isOk (parseRequest fixedQuery))

test "direct configured handle preserves Store for a fixed query" =
  expectOkThen
    (request =>
      let (next, response) = handle server testContext seededStore request
      expectEach [
        ("the seeded store is left untouched", expectTrue (seedPreserved next)),
        (
          "the response is the exact fixed-query wire form",
          expectEqual
            (expectedTextResponse 200 "OK" "fixed")
            (serializeResponse response),
        ),
      ])
    (parseRequest fixedQuery)

test "fixed raw request returns successor Store and exact response bytes" =
  let (next, bytes) = handleBytes server testContext storeEmpty fixedPut
  expectEach [
    (
      "the successor store holds exactly one block",
      expectEqual 1 (storeSize next),
    ),
    (
      "the stored block reads back as the posted bytes",
      expectEqual
        (Some (encodeUtf8 "abc"))
        (storeGet (cidForRaw (encodeUtf8 "abc")) next),
    ),
    (
      "the response is the exact 201 Created wire form",
      expectEqual (expectedTextResponse 201 "Created" "stored") bytes,
    ),
  ]

test "chunked raw request returns successor Store and exact response bytes" =
  let (next, bytes) = handleBytes server testContext storeEmpty chunkedPut
  expectEach [
    (
      "the successor store holds exactly one block",
      expectEqual 1 (storeSize next),
    ),
    (
      "the chunked body reassembles to the posted bytes",
      expectEqual
        (Some (encodeUtf8 "abc"))
        (storeGet (cidForRaw (encodeUtf8 "abc")) next),
    ),
    (
      "the response is the exact 201 Created wire form",
      expectEqual (expectedTextResponse 201 "Created" "stored") bytes,
    ),
  ]

test "malformed framing returns exact 400 and preserves Store" =
  let (next, bytes) =
    handleBytes server testContext seededStore malformedRequest
  expectEach [
    ("the seeded store is left untouched", expectTrue (seedPreserved next)),
    (
      "the response is the exact 400 Bad Request wire form",
      expectEqual
        (expectedError
          400
          "Bad Request"
          "InvalidRequest"
          "Malformed HTTP request")
        bytes,
    ),
  ]

test "unknown route returns exact 404 and preserves Store" =
  let (next, bytes) = handleBytes server testContext seededStore unknownRequest
  expectEach [
    ("the seeded store is left untouched", expectTrue (seedPreserved next)),
    (
      "the response is the exact 404 Not Found wire form",
      expectEqual
        (expectedError
          404
          "Not Found"
          "NotFound"
          "Unknown XRPC method: com.example.query.unknown")
        bytes,
    ),
  ]

test "resource excess returns exact 413 and preserves Store" =
  let (next, bytes) = handleBytes server testContext seededStore resourceRequest
  expectEach [
    ("the seeded store is left untouched", expectTrue (seedPreserved next)),
    (
      "the response is the exact 413 Payload Too Large wire form",
      expectEqual
        (expectedError
          413
          "Payload Too Large"
          "PayloadTooLarge"
          "HTTP request exceeds resource limits")
        bytes,
    ),
  ]

-- # Header values that are not UTF-8

{- The handshake and proxy seams read a header's raw bytes and decode them
   strictly: a value that is not UTF-8 is refused, never repaired into the
   text it resembles. Each refusal below sits beside a control that differs
   from it only in the offending bytes, so the refusal is about those bytes.

   The overlong forms are the ones a lenient decode reads as ASCII: `C1 A4`
   as `d`, the first character of the handshake key, and `C0 A0` as a
   space, which `trim` would then strip. -}

-- `server` with a subscription route to upgrade to. Neither registry holds
-- an `app.bsky.*` method, so a request for one is the proxy's to classify.
seamServer : Server
seamServer =
  makeServer
    account
    (mustRegistry
      (makeRegistry [
        mustEndpoint
          (subscriptionEndpoint "com.atproto.sync.subscribeRepos" PublicRoute),
      ]))
    handler

raw : List Int -> Bytes
raw xs = fromU8Array (arrayFromList (map U8.truncate xs))

headerLine : String -> Bytes -> Bytes
headerLine name value =
  B.concat [encodeUtf8 "\{name}: ", value, encodeUtf8 "\r\n"]

getWith : String -> List Bytes -> Request
getWith target headerLines =
  resultOrPanic
    "server_core_test: request setup failed"
    (parseRequest
      (B.concat
        ([encodeUtf8 "GET \{target} HTTP/1.1\r\nHost: pds.example\r\n"]
          ++ headerLines
          ++ [encodeUtf8 "\r\n"])))

-- | A refusal's status and atproto error code, as one comparable string.
refusalOf : Response -> String
refusalOf response =
  let code = match map parse (B.decodeUtf8 (responseBody response))
    Some (Ok body) => match get "error" body
      Some (JString value) => value
      _ => "<no-error-field>"
    _ => "<not-json>"
  "\{intToString (responseStatus response)} \{code}"

upgradeOutcome : UpgradeDecision -> String
upgradeOutcome NotAnUpgrade = "not-an-upgrade"
upgradeOutcome (UpgradeRefused response) = refusalOf response
upgradeOutcome (UpgradeAdmitted _) = "admitted"

goodKey : Bytes
goodKey = encodeUtf8 "dGhlIHNhbXBsZSBub25jZQ=="

upgradeWith : Bytes -> Bytes -> String
upgradeWith version key =
  let request = getWith "/xrpc/com.atproto.sync.subscribeRepos" [
    headerLine "upgrade" (encodeUtf8 "websocket"),
    headerLine "connection" (encodeUtf8 "Upgrade"),
    headerLine "sec-websocket-version" version,
    headerLine "sec-websocket-key" key,
  ]
  upgradeOutcome (classifyUpgrade seamServer testContext storeEmpty request)

test "a WebSocket key whose first character is an overlong is refused 400" = expectEach
  [
    ("control", expectEqual "admitted" (upgradeWith (encodeUtf8 "13") goodKey)),
    (
      "overlong first character",
      expectEqual
        "400 InvalidRequest"
        (upgradeWith (encodeUtf8 "13") (raw [0xC1, 0xA4] ++ B.drop 1 goodKey)),
    ),
  ]

test "a WebSocket version of 13 and an overlong space is refused 426" = expectEach
  [
    ("control", expectEqual "admitted" (upgradeWith (encodeUtf8 "13") goodKey)),
    (
      "13 then C0 A0",
      expectEqual
        "426 UnsupportedWebSocketVersion"
        (upgradeWith (encodeUtf8 "13" ++ raw [0xC0, 0xA0]) goodKey),
    ),
  ]

liveToken : String
liveToken =
  mintToken
    testSecret
    "did:plc:medakaservertest"
    (accessAudience account)
    "server_core_test"
    1699999000
    1700003600

sessionStore : Store
sessionStore =
  storeSessionOpen
    (sessionFingerprint liveToken)
    (sessionFingerprint "server_core_test-refresh")
    1700090000
    (resultOrPanic
      "server_core_test: session secret setup failed"
      (storeWithServerSecret testSecret storeEmpty))

appviewTable : Option AppviewTable
appviewTable =
  let route =
    resultOrPanic
      "server_core_test: appview route setup failed"
      (makeAppviewRoute "did:web:api.bsky.app" 2584)
  Some
    (resultOrPanic
      "server_core_test: appview table setup failed"
      (makeAppviewTable route []))

proxyOutcome : ProxyDecision -> String
proxyOutcome NotProxied = "not-proxied"
proxyOutcome (ProxyRefused response) = refusalOf response
proxyOutcome (ProxyAdmitted admission) =
  "admitted aud=\{admission.serviceAuth.aud}"

proxiedWith : Bytes -> String
proxiedWith header =
  let request = getWith "/xrpc/app.bsky.feed.getTimeline" [
    headerLine "authorization" (encodeUtf8 "Bearer \{liveToken}"),
    headerLine "atproto-proxy" header,
  ]
  proxyOutcome
    (classifyProxy seamServer testContext appviewTable sessionStore request)

test "an atproto-proxy service fragment ending in 0xFF is refused 400" =
  let service = encodeUtf8 "did:web:api.bsky.app#bsky_appview"
  expectEach [
    (
      "control",
      expectEqual
        "admitted aud=did:web:api.bsky.app#bsky_appview"
        (proxiedWith service),
    ),
    (
      "fragment then 0xFF",
      expectEqual "400 InvalidRequest" (proxiedWith (service ++ raw [0xFF])),
    ),
  ]
