{- | Deterministic all-engine driver for the official-PDS secp256k1
   `did:key` corpus and the public decoder's malformed-input boundary. -}

import bytes as B
import bytes.{Bytes, fromU8Array}
import hex.{decode}
import io.{readLines}
import string.{split, stripPrefix, toInt, trim}
import lib.did_key.{didKeyFromPublicKey, publicKeyFromDidKey}
import lib.multiformats.{
  multibaseBase58btc,
  multibaseBase58btcDecode,
  multicodecP256Pub,
  multicodecPrefix,
  multicodecSecp256k1Pub,
  uvarintDecode,
}
import lib.sign.{publicKeyCompressed, publicKeyFromCompressed}

mustHex : String -> Bytes
mustHex text =
  resultOrPanic "did_key_all_engines: malformed corpus hex" (decode text)

mustInt : String -> Int
mustInt text =
  optionOrPanic
    "did_key_all_engines: malformed corpus row id: \{text}"
    (toInt text)

mustStrip : String -> String -> String
mustStrip prefix text =
  optionOrPanic
    "did_key_all_engines: expected prefix \{prefix}"
    (stripPrefix prefix text)

canonicalPayload : String -> Bytes -> Bool
canonicalPayload did keyBytes =
  let multibase = mustStrip "did:key:" did
  match multibaseBase58btcDecode multibase
    Err _ => False
    Ok payloadBytes => match uvarintDecode payloadBytes
      Err _ => False
      Ok (codec, consumed) =>
        let prefix = multicodecPrefix multicodecSecp256k1Pub
        codec == multicodecSecp256k1Pub
          && consumed == B.length prefix
          && payloadBytes == prefix ++ keyBytes

runRow : Int -> String -> <IO> Unit
runRow expectedId line = match split " " (trim line)
  ["did-key", idText, keyHex, expectedDid] =>
    let id = mustInt idText
    if id /= expectedId then
      panic "did_key_all_engines: row id \{idText} out of order"
    else
      let keyBytes = mustHex keyHex
      match publicKeyFromCompressed keyBytes
        Err message =>
          panic
            "did_key_all_engines: row \{idText} public key rejected: \{message}"
        Ok publicKey =>
          let encoded = didKeyFromPublicKey publicKey
          match publicKeyFromDidKey expectedDid
            Err message =>
              panic
                "did_key_all_engines: row \{idText} DID rejected: \{message}"
            Ok decoded =>
              let recompressed = publicKeyCompressed decoded
              let ok =
                encoded == expectedDid
                  && recompressed == keyBytes
                  && didKeyFromPublicKey decoded == expectedDid
                  && canonicalPayload expectedDid keyBytes
              if ok then
                println
                  "ROW \{idText} PASS encode decode recompress canonical-payload \{keyHex} \{expectedDid}"
              else
                panic "did_key_all_engines: row \{idText} value mismatch"
  _ => panic "did_key_all_engines: malformed corpus row: \{line}"

runRows : List String -> Int -> <IO> Int
runRows [] count = count
runRows (row :: rest) count =
  let () = runRow count row
  runRows rest (count + 1)

payloadDid : Bytes -> String
payloadDid payload = "did:key:" ++ multibaseBase58btc payload

reject : String -> String -> <IO> Int
reject label did = match publicKeyFromDidKey did
  Err _ =>
    let () = println "MALFORMED \{label} PASS"
    1
  Ok _ =>
    let () = println "MALFORMED \{label} FAIL accepted"
    0

-- | A 33-byte SEC1 compressed-point shape: prefix byte `first`, then 32
-- copies of `rest`.
sec1Shape : U8 -> U8 -> Bytes
sec1Shape first rest = fromU8Array [|first|] ++ fromU8Array (arrayMake 32 rest)

runMalformed : Bytes -> String -> <IO> Int
runMalformed keyBytes canonicalDid =
  let didBody = mustStrip "did:key:" canonicalDid
  let base58Body = mustStrip "z" didBody
  let prefix = multicodecPrefix multicodecSecp256k1Pub
  let invalidPrefix = fromU8Array [|4|] ++ B.drop 1 keyBytes
  let xAtOrAboveP = sec1Shape 2 255
  let nonsquareXZero = sec1Shape 2 0
  let r1 = reject "wrong-method" ("did:web:" ++ didBody)
  let r2 = reject "wrong-method-case" ("DID:key:" ++ didBody)
  let r3 = reject "missing-multibase" ("did:key:" ++ base58Body)
  let r4 = reject "invalid-multibase" ("did:key:x" ++ base58Body)
  let r5 = reject "invalid-base58" "did:key:z0"
  let r6 =
    reject
      "wrong-codec"
      (payloadDid (multicodecPrefix multicodecP256Pub ++ keyBytes))
  let r7 =
    reject
      "nonminimal-codec"
      (payloadDid (fromU8Array [|0xe7, 0x81, 0x00|] ++ keyBytes))
  let r8 = reject "empty-payload" (payloadDid empty)
  let r9 = reject "short-payload" (payloadDid (prefix ++ B.take 32 keyBytes))
  let r10 =
    reject "long-payload" (payloadDid (prefix ++ fromU8Array (arrayMake 34 0)))
  let r11 =
    reject
      "trailing-payload"
      (payloadDid (prefix ++ keyBytes ++ fromU8Array [|0|]))
  let r12 = reject "invalid-sec1-prefix" (payloadDid (prefix ++ invalidPrefix))
  let r13 = reject "invalid-sec1-x" (payloadDid (prefix ++ xAtOrAboveP))
  let r14 =
    reject "invalid-sec1-nonsquare" (payloadDid (prefix ++ nonsquareXZero))
  r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14

main : <IO, Env, FileRead> Unit
main = match args ()
  [corpusPath] => match readLines corpusPath
    Err message => panic "did_key_all_engines: cannot read corpus: \{message}"
    Ok rows =>
      let rowCount = runRows rows 0
      if rowCount /= 16 then
        panic
          "did_key_all_engines: external row count expected 16, got \{intToString rowCount}"
      else match rows
        [] => panic "did_key_all_engines: corpus discovery returned zero rows"
        first :: _ => match split " " (trim first)
          ["did-key", _, keyHex, canonicalDid] =>
            let malformedCount = runMalformed (mustHex keyHex) canonicalDid
            let () =
              println "external: \{intToString rowCount}/16 official-PDS rows"
            let () =
              println "malformed: \{intToString malformedCount}/14 rejected"
            if malformedCount == 14 then
              println "TOTAL: PASS"
            else
              let () = println "TOTAL: FAIL"
              exit 1
          _ => panic "did_key_all_engines: malformed first corpus row"
  _ => panic "usage: did_key_all_engines_main <pds_did_key_corpus>"
