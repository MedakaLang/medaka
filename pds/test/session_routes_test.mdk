{- | The four `com.atproto.server.*` session routes (#2604), driven in process
   through the real registry, the real seam, and the real handler — one HTTP
   request in, one HTTP response out, exactly as `pds/shell/server.mdk` drives
   them over a socket.

   Nothing here reaches into `lib.store`'s session list to assert a shape. A
   session is only ever observed the way a client observes one: by presenting
   a token and seeing what the server does with it. That is the property that
   matters, and it is the one an implementation change can quietly break while
   every structural assertion still passes.

   `pds/test/serve_e2e.sh` drives the same four routes over a real socket
   against the real binary; this file is the fast, deterministic half — it can
   place a request at any instant, which is how the expiry cells below run
   without waiting two hours. -}

import bytes.{fromArray}
import json.{Json(..), asBool, get, jObject, parse, stringify}
import string.{contains, drop, fromUtf8, indexOf, split, toUtf8}
import test.{
  expectEach,
  expectEqual,
  expectFalse,
  expectNotEqual,
  expectSatisfies,
  expectTrue,
}
import lib.credential.{CredentialRecord, defaultIterations, makeCredential}
import lib.handlers.{pdsServer, serverLinksEmpty}
import lib.server_core.{
  Account,
  RequestContext(..),
  Server,
  handleBytes,
  makeAccount,
}
import lib.store.{Store, storeEmpty, storeWithCredential, storeWithServerSecret}

accountDidText : String
accountDidText = "did:plc:s-sessions-test-account"

accountHandleText : String
accountHandleText = "alice.test"

accountHostText : String
accountHostText = "pds.test"

password : String
password = "s-sessions-test-password"

account : Account
account =
  resultOrPanic
    "session_routes_test: account"
    (makeAccount accountDidText accountHandleText accountHostText)

server : Server
server =
  resultOrPanic
    "session_routes_test: server"
    (pdsServer account serverLinksEmpty "test-driver")

-- A fixed session secret. The seam only ever compares a MAC against it, so a
-- fixture value is as good as an entropy-drawn one here; the real server
-- draws its own from `osEntropyBytes` (`pds/serve.mdk`).
testSecret : Array Int
testSecret = arrayMakeWith 32 (i => (i * 7 + 1) % 256)

{- | The account credential, derived at the SHIPPED iteration count.

   `pds/test/credential_test.mdk` derives cheaply because it is grading the
   record; this file pays the real cost once, so that what the login cells
   grade is the credential an operator's server would actually hold. -}
credential : CredentialRecord
credential =
  let derived =
    makeCredential
      (arrayMakeWith 16 (i => (i * 13 + 3) % 256))
      defaultIterations
      password
  match derived
    Ok made => made
    Err message => panic "session_routes_test: credential: \{message}"

-- | A configured server's store: session secret and account credential, no
-- repository. No session route touches the repository.
configuredStore : Store
configuredStore = match storeWithServerSecret testSecret storeEmpty
  Ok withSecret => storeWithCredential credential withSecret
  Err message => panic "session_routes_test: session secret: \{message}"

-- | The same store with no credential at all, which is what a server that was
-- never given a password would hold.
credentiallessStore : Store
credentiallessStore =
  resultOrPanic
    "session_routes_test: session secret"
    (storeWithServerSecret testSecret storeEmpty)

testInstant : Int
testInstant = 1700000000

nonceAt : Int -> Array Int
nonceAt seed = arrayMakeWith 16 (i => (i * 31 + seed) % 256)

{- | A request context at `instant`, identified by `seed`.

   The seed becomes the minted tokens' `jti`, so two requests placed at the
   same instant with different seeds mint DIFFERENT tokens — which is what the
   real server gets from drawing a fresh nonce per request. Two requests with
   the same seed at the same instant would mint the same token, and one cell
   below relies on exactly that to prove the nonce is what separates them. -}
contextAt : Int -> Int -> RequestContext
contextAt instant seed =
  RequestContext { nowSeconds = instant, nonce = nonceAt seed }

-- # Requests and responses

authOf : String -> String
authOf "" = ""
authOf token = "Authorization: Bearer \{token}\r\n"

postJson : String -> String -> String -> Array Int
postJson token nsid bodyJson =
  toUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{authOf token}Content-Type: application/json\r\nContent-Length: \{intToString (arrayLength (toUtf8 bodyJson))}\r\n\r\n\{bodyJson}"

{- | A bodiless POST, the shape `refreshSession` and `deleteSession` take.
   The zero-length `Content-Length` is what a real client sends on one, so it
   is what these tests send. -}
postNoInput : String -> String -> Array Int
postNoInput token nsid =
  toUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{authOf token}Content-Length: 0\r\n\r\n"

getQuery : String -> String -> Array Int
getQuery token nsid =
  toUtf8
    "GET /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{authOf token}\r\n"

loginJson : String -> String -> String
loginJson identifier passwordText =
  stringify
    (jObject [
      ("identifier", JString identifier),
      ("password", JString passwordText),
    ])

-- The status line and, for a refusal, atproto's error code: the two things a
-- client can act on. A token or a password never appears in either.
outcome : Array Int -> String
outcome bytes =
  let text = fromUtf8 bytes
  let status = match parse (bodyOf text)
    Ok body => match get "error" body
      Some (JString code) => code
      _ => ""
    Err _ => ""
  if status == "" then statusLineOf text else "\{statusLineOf text} \{status}"

statusLineOf : String -> String
statusLineOf text = match split "\r\n" text
  first :: _ => drop 9 first
  [] => "no status line"

bodyOf : String -> String
bodyOf text = match indexOf "\r\n\r\n" text
  Some at => drop (at + 4) text
  None => ""

-- | One string field of a response body, or `""`.
field : String -> Array Int -> String
field name bytes = match parse (bodyOf (fromUtf8 bytes))
  Ok body => match get name body
    Some (JString value) => value
    _ => ""
  Err _ => ""

-- | One boolean field of a response body, or `None` if it is absent or not a
-- `JBool` (mirrors `field`, whose `JString`-only match can't see this shape).
fieldBool : String -> Array Int -> Option Bool
fieldBool name bytes = match parse (bodyOf (fromUtf8 bytes))
  Ok body => match get name body
    Some value => asBool value
    _ => None
  Err _ => None

-- # Driving

-- | One request against `store` at `context`, giving the store it left behind
-- and the response bytes.
send : RequestContext -> Store -> Array Int -> (Store, Array Int)
send context store bytes = match fromArray bytes
  Some packed => handleBytes server context store packed
  None => panic "session_routes: request fixture holds a non-byte element"

createSessionNsid : String
createSessionNsid = "com.atproto.server.createSession"

refreshSessionNsid : String
refreshSessionNsid = "com.atproto.server.refreshSession"

deleteSessionNsid : String
deleteSessionNsid = "com.atproto.server.deleteSession"

getSessionNsid : String
getSessionNsid = "com.atproto.server.getSession"

createRecordNsid : String
createRecordNsid = "com.atproto.repo.createRecord"

-- | Log in with the right password at `instant`, identified by `seed`.
login : Int -> Int -> Store -> (Store, Array Int)
login instant seed store =
  send
    (contextAt instant seed)
    store
    (postJson "" createSessionNsid (loginJson accountHandleText password))

{- | A logged-in session: the store holding it, its access token, and its
   refresh token. Every cell below starts from one of these. -}
loggedIn : (Store, String, String)
loggedIn =
  let (store, response) = login testInstant 1 configuredStore
  (store, field "accessJwt" response, field "refreshJwt" response)

sessionStore : Store
sessionStore = match loggedIn
  (store, _, _) => store

accessToken : String
accessToken = match loggedIn
  (_, token, _) => token

refreshToken : String
refreshToken = match loggedIn
  (_, _, token) => token

-- # createSession

test "a login with the right password is 200" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual (outcome response) "200 OK"

test "a login is answered with the account's DID and handle" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual
    (field "did" response ++ " " ++ field "handle" response)
    "\{accountDidText} \{accountHandleText}"

test "a login is answered with an active session" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual (fieldBool "active" response) (Some True)

test "a login issues two different tokens" = expectEach [
  ("the access token is not empty", expectNotEqual "" accessToken),
  ("the refresh token is not empty", expectNotEqual "" refreshToken),
  (
    "the two tokens differ from one another",
    expectNotEqual accessToken refreshToken,
  ),
]

test "a login by DID is accepted as well as by handle" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson accountDidText password))
  expectEqual (outcome response) "200 OK"

-- atproto handles are domain names, and domain names are case-insensitive.
test "a login by handle is case-insensitive" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson "ALICE.TEST" password))
  expectEqual (outcome response) "200 OK"

test "a login with the wrong password is refused" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson accountHandleText "not it"))
  expectEqual (outcome response) "401 Unauthorized AuthenticationRequired"

{- | The three ways a login can fail are ONE answer, byte for byte. The
   differences between them — is this identifier real, is this server
   configured — are exactly what an attacker probing for an account is asking
   about, and a client has no use for any of them. -}
test "a wrong password and an unknown identifier are the same refusal" =
  let (_, wrongPassword) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson accountHandleText "not it"))
  let (_, unknownIdentifier) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson "nobody.test" password))
  expectEqual (fromUtf8 wrongPassword) (fromUtf8 unknownIdentifier)

test "a login against a server with no credential is the same refusal" =
  let (_, noCredential) =
    send
      (contextAt testInstant 1)
      credentiallessStore
      (postJson "" createSessionNsid (loginJson accountHandleText password))
  let (_, wrongPassword) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson accountHandleText "not it"))
  expectEqual (fromUtf8 noCredential) (fromUtf8 wrongPassword)

-- Nothing the client sent comes back. A refusal that quoted the identifier
-- would put it in every log the response passes through on the way out.
test "a refusal repeats neither the password nor the identifier" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson "" createSessionNsid (loginJson accountHandleText "not it"))
  let text = fromUtf8 response
  expectEach [
    (
      "the refusal does not repeat the password",
      expectSatisfies
        "a response free of the password"
        (t => not (contains "not it" t))
        text,
    ),
    (
      "the refusal does not repeat the identifier",
      expectSatisfies
        "a response free of the identifier"
        (t => not (contains "alice.test" t))
        text,
    ),
  ]

test "two logins in the same second issue different tokens" =
  let (_, first) = login testInstant 1 configuredStore
  let (_, second) = login testInstant 2 configuredStore
  expectNotEqual (field "accessJwt" first) (field "accessJwt" second)

-- # The access token

test "the access token reaches a gated route" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "200 OK"

test "getSession names the account the token belongs to" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (field "did" response) accountDidText

test "getSession reports the session as active" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (fieldBool "active" response) (Some True)

{- | An access token that was never issued by this server is refused even
   though it is syntactically a bearer token. This is the seam's job, and it
   is graded here as well as in `pds/test/auth_seam_test.mdk` because a
   session route must not be a way around it. -}
test "an invented token is refused" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery "not.a.token" getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a session opened on one store is unknown to another" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      configuredStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

{- | Two hours on, the access token's own window has closed, and an open
   session record does not keep it alive past it.

   The refusal is `ExpiredToken`, not `InvalidToken`: it is atproto's own
   distinction and the one a client acts on, because expiry is the case a
   refresh fixes and a bad signature is not. -}
test "the access token is refused after its window closes" =
  let (_, response) =
    send
      (contextAt (testInstant + 7201) 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized ExpiredToken"

-- # refreshSession

refreshed : (Store, Array Int)
refreshed =
  send
    (contextAt (testInstant + 60) 4)
    sessionStore
    (postNoInput refreshToken refreshSessionNsid)

rotatedStore : Store
rotatedStore = match refreshed
  (store, _) => store

rotatedAccess : String
rotatedAccess = match refreshed
  (_, response) => field "accessJwt" response

rotatedRefresh : String
rotatedRefresh = match refreshed
  (_, response) => field "refreshJwt" response

test "a refresh with the session's refresh token is 200" = match refreshed
  (_, response) => expectEqual (outcome response) "200 OK"

test "a refresh reports the rotated session as active" = match refreshed
  (_, response) => expectEqual (fieldBool "active" response) (Some True)

test "a refresh issues a token pair that is not the one it replaced" = expectEach
  [
    ("rotatedAccess /= accessToken", expectNotEqual accessToken rotatedAccess),
    (
      "rotatedRefresh /= refreshToken",
      expectNotEqual refreshToken rotatedRefresh,
    ),
  ]

test "the rotated access token reaches a gated route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 5)
      rotatedStore
      (getQuery rotatedAccess getSessionNsid)
  expectEqual (outcome response) "200 OK"

{- | The rotation invalidates the token it consumed once the grace window has
   passed. Presenting it after that is refused — the reuse an attacker who
   stole a refresh token would attempt buys them nothing. -}
test "the consumed refresh token is refused once the grace window has passed" =
  let (_, response) =
    send
      (contextAt (testInstant + 60 + 7201) 6)
      rotatedStore
      (postNoInput refreshToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

-- The rotation replaced the whole session, access half included: a client
-- that refreshes has been issued a new access token and is expected to use it.
test "the access token from before the rotation is refused after it" =
  let (_, response) =
    send
      (contextAt (testInstant + 120) 6)
      rotatedStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "an access token is refused on the refresh route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (postNoInput accessToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a refresh token is refused on an access-gated route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (getQuery refreshToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a refresh with no Authorization header is refused" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (postNoInput "" refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized AuthenticationRequired"

-- # Session families

daySeconds : Int
daySeconds = 86400

-- | Refresh with `refresh` at `instant`, giving the store left behind and the
-- pair the response carried.
rotateAt : Int -> Int -> Store -> String -> (Store, String, String)
rotateAt instant seed store refresh =
  let (next, response) =
    send (contextAt instant seed) store (postNoInput refresh refreshSessionNsid)
  (next, field "accessJwt" response, field "refreshJwt" response)

{- | A family rotated three times, the last only ten minutes before the ninety
   days since its login run out: every token in it is freshly minted, and the
   refresh token's own signed window runs for another ninety days. -}
lateChain : (Store, String, String)
lateChain =
  let (first, _, firstRefresh) =
    rotateAt (testInstant + 30 * daySeconds) 20 sessionStore refreshToken
  let (second, _, secondRefresh) =
    rotateAt (testInstant + 60 * daySeconds) 21 first firstRefresh
  rotateAt (testInstant + 90 * daySeconds - 600) 22 second secondRefresh

test "a family is refused past ninety days however recently it rotated" =
  let (store, access, refresh) = lateChain
  let before = testInstant + 90 * daySeconds - 300
  let after = testInstant + 90 * daySeconds + 60
  let (_, liveResponse) =
    send (contextAt before 23) store (getQuery access getSessionNsid)
  let (_, accessResponse) =
    send (contextAt after 24) store (getQuery access getSessionNsid)
  let (_, refreshResponse) =
    send (contextAt after 25) store (postNoInput refresh refreshSessionNsid)
  expectEach [
    (
      "the last rotation's access token works before the family ends",
      expectEqual "200 OK" (outcome liveResponse),
    ),
    (
      "the same access token is refused once the family has ended",
      expectEqual "401 Unauthorized InvalidToken" (outcome accessResponse),
    ),
    (
      "the last rotation's refresh token is refused once the family has ended",
      expectEqual "401 Unauthorized InvalidToken" (outcome refreshResponse),
    ),
  ]

{- | A client that refreshes twice in a burst presents one refresh token twice.
   The second presentation, inside the grace window, is answered with a pair
   that works, and the first answer's pair keeps working beside it. -}
test "a consumed refresh token replayed within the grace window still works" =
  let (store, access, refresh) =
    rotateAt (testInstant + 120) 26 rotatedStore refreshToken
  let (_, replayed) =
    send
      (contextAt (testInstant + 121) 27)
      store
      (getQuery access getSessionNsid)
  let (_, earlier) =
    send
      (contextAt (testInstant + 121) 28)
      store
      (getQuery rotatedAccess getSessionNsid)
  expectEach [
    ("the replay issued a refresh token", expectNotEqual "" refresh),
    (
      "the replay issued a pair unlike the first rotation's",
      expectNotEqual rotatedAccess access,
    ),
    (
      "the replay's access token reaches a gated route",
      expectEqual "200 OK" (outcome replayed),
    ),
    (
      "the first rotation's access token still reaches it",
      expectEqual "200 OK" (outcome earlier),
    ),
  ]

-- | The original refresh token, consumed at +60, presented `count - step`
-- more times a second apart from +120, each against the store the last left.
replayBurst : Int -> Int -> Store -> (Store, List (Array Int))
replayBurst step count store =
  if step >= count then
    (store, [])
  else
    let (next, response) =
      send
        (contextAt (testInstant + 120 + step) (40 + step))
        store
        (postNoInput refreshToken refreshSessionNsid)
    let (final, rest) = replayBurst (step + 1) count next
    (final, response :: rest)

-- | The outcome of one request, the store it left behind discarded.
answerTo : RequestContext -> Store -> Array Int -> String
answerTo context store bytes = match send context store bytes
  (_, response) => outcome response

{- | A client retrying one refresh in a burst presents the consumed token many
   times inside the grace window. Every presentation is answered with a pair,
   and each replay's pair supersedes the one before it: however long the
   burst, one replay-issued session is left open, beside the one the rotation
   itself issued, rather than one per presentation. -}
test "a burst of replays inside the grace window leaves one of its pairs open" =
  let (store, responses) = replayBurst 0 6 rotatedStore
  let at = contextAt (testInstant + 130) 50
  let (_, rotation) = send at store (getQuery rotatedAccess getSessionNsid)
  let served = "200 OK"
  let refused = "401 Unauthorized InvalidToken"
  expectEach [
    (
      "every replay is answered with a pair",
      expectEqual (map (_ => served) responses) (map outcome responses),
    ),
    (
      "only the last replay's access token still reaches a gated route",
      expectEqual
        [refused, refused, refused, refused, refused, served]
        (map
          (response =>
            answerTo
              at
              store
              (getQuery (field "accessJwt" response) getSessionNsid))
          responses),
    ),
    (
      "only the last replay's refresh token still rotates",
      expectEqual
        [refused, refused, refused, refused, refused, served]
        (map
          (response =>
            answerTo
              at
              store
              (postNoInput (field "refreshJwt" response) refreshSessionNsid))
          responses),
    ),
    (
      "the first rotation's access token still reaches a gated route",
      expectEqual served (outcome rotation),
    ),
  ]

{- | Family A: the logged-in session, rotated at +60 (`refreshed`) and again
   at +7000, so its current access token is still inside its own two hours
   when the original refresh token is replayed at +7261, past the grace window
   of its consumption at +60. Family B: a second login at +7000, which that
   replay must not touch. -}
revocation : (Store, Store, String, String, String, String, Array Int)
revocation =
  let (familyA, currentAccess, currentRefresh) =
    rotateAt (testInstant + 7000) 31 rotatedStore rotatedRefresh
  let (twoFamilies, siblingResponse) = login (testInstant + 7000) 32 familyA
  let (revoked, replay) =
    send
      (contextAt (testInstant + 7261) 33)
      twoFamilies
      (postNoInput refreshToken refreshSessionNsid)
  (
    twoFamilies,
    revoked,
    currentAccess,
    currentRefresh,
    field "accessJwt" siblingResponse,
    field "refreshJwt" siblingResponse,
    replay,
  )

test "a replay past the grace window revokes its whole family at once" =
  let (before, revoked, access, refresh, _, _, replay) = revocation
  let at = contextAt (testInstant + 7262) 34
  let (_, beforeResponse) = send at before (getQuery access getSessionNsid)
  let (_, accessResponse) = send at revoked (getQuery access getSessionNsid)
  let (_, refreshResponse) =
    send at revoked (postNoInput refresh refreshSessionNsid)
  expectEach [
    (
      "the replay itself is refused",
      expectEqual "401 Unauthorized InvalidToken" (outcome replay),
    ),
    (
      "the family's current access token worked before the replay",
      expectEqual "200 OK" (outcome beforeResponse),
    ),
    (
      "the family's current access token is refused after it",
      expectEqual "401 Unauthorized InvalidToken" (outcome accessResponse),
    ),
    (
      "the family's current refresh token is refused after it",
      expectEqual "401 Unauthorized InvalidToken" (outcome refreshResponse),
    ),
  ]

test "a revocation leaves a sibling family on the same account open" =
  let (_, revoked, _, _, siblingAccess, siblingRefresh, _) = revocation
  let (_, accessResponse) =
    send
      (contextAt (testInstant + 7262) 35)
      revoked
      (getQuery siblingAccess getSessionNsid)
  let (_, refreshResponse) =
    send
      (contextAt (testInstant + 7262) 36)
      revoked
      (postNoInput siblingRefresh refreshSessionNsid)
  expectEach [
    (
      "the sibling's access token still reaches a gated route",
      expectEqual "200 OK" (outcome accessResponse),
    ),
    (
      "the sibling's refresh token still rotates",
      expectEqual "200 OK" (outcome refreshResponse),
    ),
  ]

-- # deleteSession

closed : (Store, Array Int)
closed =
  send
    (contextAt (testInstant + 60) 7)
    sessionStore
    (postNoInput refreshToken deleteSessionNsid)

closedStore : Store
closedStore = match closed
  (store, _) => store

test "deleting the session is 200" = match closed
  (_, response) => expectEqual (outcome response) "200 OK"

{- | THE revocation property, and the reason a session list exists at all: the
   access token the client was holding when it logged out is refused from the
   next request on. Its signature is still good and its two-hour window is
   still open — a stateless check would still accept it. -}
test "the access token is refused after the session is deleted" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "the refresh token is refused after the session is deleted" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postNoInput refreshToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "deleting the same session twice is refused the second time" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postNoInput refreshToken deleteSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

{- | A write is gated on the ACCESS token, so logging out closes the account's
   repository to the client that logged out. The refusal is the seam's, and it
   comes before the handler: this store holds no repository at all, so a
   handler that ran would have answered `RepoNotFound`. -}
test "a write with the deleted session's access token is refused first" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postJson
        accessToken
        createRecordNsid
        (stringify
          (jObject [
            ("repo", JString accountDidText),
            ("collection", JString "app.bsky.feed.post"),
            ("record", jObject [("text", JString "after logout")]),
          ])))
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

-- # Independence

{- | Two logins are two sessions, and closing one leaves the other open. A
   single-session server would answer this cell the same way as a correct one
   right up until an account signed in twice. -}
test "logging out of one session leaves another open" =
  let (afterFirst, _) = login testInstant 1 configuredStore
  let (twoSessions, secondResponse) = login testInstant 9 afterFirst
  let secondAccess = field "accessJwt" secondResponse
  let secondRefresh = field "refreshJwt" secondResponse
  let (afterClose, _) =
    send
      (contextAt (testInstant + 1) 10)
      twoSessions
      (postNoInput refreshToken deleteSessionNsid)
  let (_, response) =
    send
      (contextAt (testInstant + 1) 11)
      afterClose
      (getQuery secondAccess getSessionNsid)
  expectEach [
    (
      "secondRefresh /= refreshToken",
      expectNotEqual refreshToken secondRefresh,
    ),
    ("outcome response == \"200 OK\"", expectEqual "200 OK" (outcome response)),
  ]
