{- | The four `com.atproto.server.*` session routes (#2604), driven in process
   through the real registry, the real seam, and the real handler — one HTTP
   request in, one HTTP response out, exactly as `pds/shell/server.mdk` drives
   them over a socket.

   Nothing here reaches into `lib.store`'s session list to assert a shape. A
   session is only ever observed the way a client observes one: by presenting
   a token and seeing what the server does with it. That is the property that
   matters, and it is the one an implementation change can quietly break while
   every structural assertion still passes.

   `pds/test/serve_e2e.sh` drives the same four routes over a real socket
   against the real binary; this file is the fast, deterministic half — it can
   place a request at any instant, which is how the expiry cells below run
   without waiting two hours. -}

import bytes.{Bytes, encodeUtf8, fromU8Array}
import http.{parseRequestClassified}
import json.{Json(..), asBool, get, jObject, parse, stringify}
import string.{contains}
import u8 as U8
import test.{
  expectAtLeast,
  expectEach,
  expectEqual,
  expectFalse,
  expectNotEqual,
  expectSatisfies,
  expectTrue,
}
import lib.credential.{
  CredentialRecord,
  LoginCheck,
  LoginOutcome(..),
  LoginVerdict,
  credentialIterations,
  defaultIterations,
  loginOutcome,
  makeCredential,
  passwordFromText,
}
import lib.handlers.{
  pdsServer,
  refreshTokenSeconds,
  serverLinksEmpty,
  sessionFamilyLifetimeSeconds,
}
import lib.server_core.{
  Account,
  RequestContext(..),
  Server,
  classifyLogin,
  handleBytes,
  makeAccount,
}
import lib.store.{
  Store,
  storeCredential,
  storeEmpty,
  storeWithCredential,
  storeWithServerSecret,
}
import test.fixture_support.{altTestKey, contextAt}
import test.request_support.{authOf, loginJson, postJson}
import test.response_support.{
  jsonBody, outcome, responseText, settled, statusLineOf, stringField
}
import lib.sign.{Sign}
import lib.jwt.{Mint}
import lib.pbkdf2.{Kdf}

accountDidText : String
accountDidText = "did:plc:s-sessions-test-account"

accountHandleText : String
accountHandleText = "alice.test"

accountHostText : String
accountHostText = "pds.test"

password : String
password = "s-sessions-test-password"

account : Account
account =
  resultOrPanic
    "session_routes_test: account"
    (makeAccount accountDidText accountHandleText accountHostText)

server : Server <Mint {"access", "refresh"}, Sign "commit">
server =
  resultOrPanic
    "session_routes_test: server"
    (pdsServer account serverLinksEmpty "test-driver")

-- A fixed session secret. The seam only ever compares a MAC against it, so a
-- fixture value is as good as an entropy-drawn one here; the real server
-- draws its own from `osEntropyBytes` (`pds/serve.mdk`).
{- | The iteration count this file's credentials are derived at.

   It is NOT `defaultIterations`: every derivation here is paid for in gate
   wall time, and a fixture at the shipped count would make that cost grow
   with every raise of it. A login at this count grades the password exactly
   as one at the shipped count does, so the only cell that derives at the
   shipped count is the one about moving a record onto it. -}
cheapIterations : Int
cheapIterations = 4

-- | The account credential.
credential : CredentialRecord
credential =
  let derived =
    makeCredential
      (fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 13 + 3))))
      cheapIterations
      (passwordFromText password)
  match derived
    Ok made => made
    Err message => panic "session_routes_test: credential: \{message}"

-- | A configured server's store: session secret and account credential, no
-- repository. No session route touches the repository.
configuredStore : Store
configuredStore =
  let withSecret = storeWithServerSecret altTestKey storeEmpty
  storeWithCredential credential withSecret

-- | The same store holding a credential for the same password under another
-- salt, which a successful login offered an upgrade moves onto the shipped
-- count.
outdatedStore : Store
outdatedStore =
  let older =
    makeCredential
      (fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 5 + 9))))
      cheapIterations
      (passwordFromText password)
  match older
    Ok made => storeWithCredential made configuredStore
    Err message => panic "session_routes_test: older credential: \{message}"

-- | The same store after the account's password changed.
changedPasswordStore : Store
changedPasswordStore =
  let changed =
    makeCredential
      (fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 13 + 3))))
      cheapIterations
      (passwordFromText "a different password")
  match changed
    Ok made => storeWithCredential made configuredStore
    Err message => panic "session_routes_test: changed credential: \{message}"

-- | The verdict the shell would derive for `bytes` against `store`, offering
-- `salt` as the upgrade.
verdictFor : Bytes -> Bytes -> Store -> <Kdf> Option LoginVerdict
verdictFor salt bytes store = verdictAgainst salt store bytes

-- | The same store with no credential at all, which is what a server that was
-- never given a password would hold.
credentiallessStore : Store
credentiallessStore = storeWithServerSecret altTestKey storeEmpty

testInstant : Int
testInstant = 1700000000

-- # Requests and responses

{- | A bodiless POST, the shape `refreshSession` and `deleteSession` take.
   The zero-length `Content-Length` is what a real client sends on one, so it
   is what these tests send. -}
postNoInput : String -> String -> Bytes
postNoInput token nsid =
  encodeUtf8
    "POST /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{authOf token}Content-Length: 0\r\n\r\n"

getQuery : String -> String -> Bytes
getQuery token nsid =
  encodeUtf8
    "GET /xrpc/\{nsid} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{authOf token}\r\n"

-- | One boolean field of a response body, or `None` if it is absent or not a
-- `JBool` (mirrors `stringField`, whose `JString`-only match can't see this
-- shape).
fieldBool : String -> Bytes -> Option Bool
fieldBool name bytes = match map (get name) (jsonBody bytes)
  Some (Some value) => asBool value
  _ => None

-- # Driving

{- | One request against `store` at `context`, giving the store it left behind
   and the response bytes.

   A login's password is graded the way the shell grades it: before the
   request reaches the store, against the record `store` holds, with the
   verdict handed in on the context (`settleLogin`, `pds/shell/server.mdk`).
   The shell pays for it a slice at a time between other connections' work;
   here nothing else is running, so it is paid for at once.

   No upgrade is offered, so a login here is graded the way the shipped
   server grades one against a record already at its count: the password is
   verified and the record kept. The shell always offers one, and against
   this file's `cheapIterations` records it would re-derive at the shipped
   count on every successful login. -}
send : RequestContext ->
  Store ->
  Bytes ->
  <Kdf, Mint {"access", "refresh"}, Sign "commit"> (Store, Bytes)
send context store bytes =
  handleBytes
    server
    { context | login = verdictAgainst noUpgradeSalt store bytes }
    store
    bytes

-- The salt a login that earns an upgrade re-derives the credential under.
upgradeSalt : Bytes
upgradeSalt = fromU8Array (arrayMakeWith 16 (i => U8.truncate (i * 29 + 17)))

-- A salt of the wrong length, which `loginCheckBegin` takes as an offer of no
-- upgrade at all.
noUpgradeSalt : Bytes
noUpgradeSalt = empty

-- | The verdict of `packed`'s password derivations against the credential
-- `store` holds, offering `salt` as the upgrade, or `None` for a request that
-- needs none.
verdictAgainst : Bytes -> Store -> Bytes -> <Kdf> Option LoginVerdict
verdictAgainst salt store packed = match parseRequestClassified packed
  Err _ => None
  Ok request => map settled (classifyLogin server salt store request)

-- | One request against `store`, carrying a verdict computed elsewhere rather
-- than against `store` itself.
sendWithVerdict : Option LoginVerdict ->
  Store ->
  Bytes ->
  <Mint {"access", "refresh"}, Sign "commit"> (Store, Bytes)
sendWithVerdict verdict store bytes =
  handleBytes server { contextAt testInstant 40 | login = verdict } store bytes

createSessionNsid : String
createSessionNsid = "com.atproto.server.createSession"

refreshSessionNsid : String
refreshSessionNsid = "com.atproto.server.refreshSession"

deleteSessionNsid : String
deleteSessionNsid = "com.atproto.server.deleteSession"

getSessionNsid : String
getSessionNsid = "com.atproto.server.getSession"

createRecordNsid : String
createRecordNsid = "com.atproto.repo.createRecord"

-- | Log in with the right password at `instant`, identified by `seed`.
login : Int ->
  Int ->
  Store ->
  <Kdf, Mint {"access", "refresh"}, Sign "commit"> (Store, Bytes)
login instant seed store =
  send
    (contextAt instant seed)
    store
    (postJson
      accountHostText
      ""
      createSessionNsid
      (loginJson accountHandleText password))

{- | A logged-in session: the store holding it, its access token, and its
   refresh token. Every cell below starts from one of these. -}
loggedIn : (Store, String, String)
loggedIn =
  let (store, response) = login testInstant 1 configuredStore
  (store, stringField "accessJwt" response, stringField "refreshJwt" response)

sessionStore : Store
sessionStore = match loggedIn
  (store, _, _) => store

accessToken : String
accessToken = match loggedIn
  (_, token, _) => token

refreshToken : String
refreshToken = match loggedIn
  (_, _, token) => token

-- # createSession

test "a login with the right password is 200" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual (outcome response) "200 OK"

test "a login is answered with the account's DID and handle" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual
    (stringField "did" response ++ " " ++ stringField "handle" response)
    "\{accountDidText} \{accountHandleText}"

test "a login is answered with an active session" =
  let (_, response) = login testInstant 1 configuredStore
  expectEqual (fieldBool "active" response) (Some True)

test "a login issues two different tokens" = expectEach [
  ("the access token is not empty", expectNotEqual "" accessToken),
  ("the refresh token is not empty", expectNotEqual "" refreshToken),
  (
    "the two tokens differ from one another",
    expectNotEqual accessToken refreshToken,
  ),
]

test "a login by DID is accepted as well as by handle" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountDidText password))
  expectEqual (outcome response) "200 OK"

-- atproto handles are domain names, and domain names are case-insensitive.
test "a login by handle is case-insensitive" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson "ALICE.TEST" password))
  expectEqual (outcome response) "200 OK"

test "a login with the wrong password is refused" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText "not it"))
  expectEqual (outcome response) "401 Unauthorized AuthenticationRequired"

{- | A login whose verdict was computed against a credential the store no
   longer holds.

   The shell derives a login's verdict outside the store transition, so
   another request can replace the credential while it is being derived.
   Two cases: a second login's upgrade landing first, and the account's
   password changing (stood in for by a record derived from another
   password, since no route changes it). In both the verdict graded the right
   password against the record it saw, and in both it is refused, because the
   record it saw is not the record it would be applied to.

   This is the one cell that derives at the shipped count, twice: the upgrade
   the first login carries, and the check of the record it left behind. -}
test "a login verdict computed against a replaced credential is refused" =
  let loginBytes =
    postJson
      accountHostText
      ""
      createSessionNsid
      (loginJson accountHandleText password)
  let upgrading = verdictFor upgradeSalt loginBytes outdatedStore
  let (raced, first) = sendWithVerdict upgrading outdatedStore loginBytes
  let (_, second) = sendWithVerdict upgrading raced loginBytes
  let (_, afterChange) =
    sendWithVerdict
      (verdictFor noUpgradeSalt loginBytes configuredStore)
      changedPasswordStore
      loginBytes
  let (_, fresh) =
    sendWithVerdict (verdictFor upgradeSalt loginBytes raced) raced loginBytes
  expectEach [
    (
      "the first login lands and upgrades the credential",
      expectEqual
        ("200 OK", Some defaultIterations)
        (outcome first, map credentialIterations (storeCredential raced)),
    ),
    (
      "the second verdict, against the record the upgrade replaced",
      expectEqual (outcome second) "401 Unauthorized AuthenticationRequired",
    ),
    (
      "a verdict against the password the account no longer has",
      expectEqual
        (outcome afterChange)
        "401 Unauthorized AuthenticationRequired",
    ),
    (
      "a verdict against the upgraded record itself",
      expectEqual (outcome fresh) "200 OK",
    ),
  ]

{- | A login naming some other account, with this account's password, against
   a record below the shipped count.

   The handler refuses any identifier that does not name the account whatever
   its verdict carries, so neither the refusal nor the untouched record can
   show whether an upgrade was derived. The verdict can: it was graded with no
   upgrade offered, so against the record it was computed from it reads as
   accepted and not as accepted-upgrading. -}
test "a login naming another identifier is offered no upgrade" =
  let loginBytes =
    postJson
      accountHostText
      ""
      createSessionNsid
      (loginJson "someone-else.test" password)
  let verdict = verdictFor upgradeSalt loginBytes outdatedStore
  let (after, response) = sendWithVerdict verdict outdatedStore loginBytes
  expectEach [
    (
      "the login is refused",
      expectEqual "401 Unauthorized AuthenticationRequired" (outcome response),
    ),
    (
      "the stored record keeps its count",
      expectEqual
        (Some cheapIterations)
        (map credentialIterations (storeCredential after)),
    ),
    (
      "the verdict carries no upgrade",
      expectEqual "accepted" (verdictReading verdict outdatedStore),
    ),
  ]

-- | What `verdict` says against the record `store` holds, by name.
verdictReading : Option LoginVerdict -> Store -> String
verdictReading verdict store = match (verdict, storeCredential store)
  (Some graded, Some record) => match loginOutcome graded record
    LoginRefused => "refused"
    LoginAccepted => "accepted"
    LoginAcceptedUpgrading _ => "accepted, upgrading"
  _ => "no verdict"

-- A login that reaches the handler with no verdict at all was never graded,
-- and is refused the way a wrong password is.
test "a login that carries no verdict is refused" =
  let (_, response) =
    sendWithVerdict
      None
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText password))
  expectEqual (outcome response) "401 Unauthorized AuthenticationRequired"

{- | The three ways a login can fail are ONE answer, byte for byte. The
   differences between them — is this identifier real, is this server
   configured — are exactly what an attacker probing for an account is asking
   about, and a client has no use for any of them. -}
test "a wrong password and an unknown identifier are the same refusal" =
  let (_, wrongPassword) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText "not it"))
  let (_, unknownIdentifier) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson "nobody.test" password))
  expectEqual (responseText wrongPassword) (responseText unknownIdentifier)

test "a login against a server with no credential is the same refusal" =
  let (_, noCredential) =
    send
      (contextAt testInstant 1)
      credentiallessStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText password))
  let (_, wrongPassword) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText "not it"))
  expectEqual (responseText noCredential) (responseText wrongPassword)

-- Nothing the client sent comes back. A refusal that quoted the identifier
-- would put it in every log the response passes through on the way out.
test "a refusal repeats neither the password nor the identifier" =
  let (_, response) =
    send
      (contextAt testInstant 1)
      configuredStore
      (postJson
        accountHostText
        ""
        createSessionNsid
        (loginJson accountHandleText "not it"))
  let text = responseText response
  expectEach [
    (
      "the refusal does not repeat the password",
      expectSatisfies
        "a response free of the password"
        (t => not (contains "not it" t))
        text,
    ),
    (
      "the refusal does not repeat the identifier",
      expectSatisfies
        "a response free of the identifier"
        (t => not (contains "alice.test" t))
        text,
    ),
  ]

test "two logins in the same second issue different tokens" =
  let (_, first) = login testInstant 1 configuredStore
  let (_, second) = login testInstant 2 configuredStore
  expectNotEqual
    (stringField "accessJwt" first)
    (stringField "accessJwt" second)

-- # The access token

test "the access token reaches a gated route" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "200 OK"

test "getSession names the account the token belongs to" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (stringField "did" response) accountDidText

test "getSession reports the session as active" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (fieldBool "active" response) (Some True)

{- | An access token that was never issued by this server is refused even
   though it is syntactically a bearer token. This is the seam's job, and it
   is graded here as well as in `pds/test/auth_seam_test.mdk` because a
   session route must not be a way around it. -}
test "an invented token is refused" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      sessionStore
      (getQuery "not.a.token" getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a session opened on one store is unknown to another" =
  let (_, response) =
    send
      (contextAt testInstant 3)
      configuredStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

{- | Two hours on, the access token's own window has closed, and an open
   session record does not keep it alive past it.

   The refusal is `ExpiredToken`, not `InvalidToken`: it is atproto's own
   distinction and the one a client acts on, because expiry is the case a
   refresh fixes and a bad signature is not. -}
test "the access token is refused after its window closes" =
  let (_, response) =
    send
      (contextAt (testInstant + 7201) 3)
      sessionStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized ExpiredToken"

-- # refreshSession

refreshed : (Store, Bytes)
refreshed =
  send
    (contextAt (testInstant + 60) 4)
    sessionStore
    (postNoInput refreshToken refreshSessionNsid)

rotatedStore : Store
rotatedStore = match refreshed
  (store, _) => store

rotatedAccess : String
rotatedAccess = match refreshed
  (_, response) => stringField "accessJwt" response

rotatedRefresh : String
rotatedRefresh = match refreshed
  (_, response) => stringField "refreshJwt" response

test "a refresh with the session's refresh token is 200" = match refreshed
  (_, response) => expectEqual (outcome response) "200 OK"

test "a refresh reports the rotated session as active" = match refreshed
  (_, response) => expectEqual (fieldBool "active" response) (Some True)

test "a refresh issues a token pair that is not the one it replaced" = expectEach
  [
    ("rotatedAccess /= accessToken", expectNotEqual accessToken rotatedAccess),
    (
      "rotatedRefresh /= refreshToken",
      expectNotEqual refreshToken rotatedRefresh,
    ),
  ]

test "the rotated access token reaches a gated route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 5)
      rotatedStore
      (getQuery rotatedAccess getSessionNsid)
  expectEqual (outcome response) "200 OK"

{- | The rotation invalidates the token it consumed once the grace window has
   passed. Presenting it after that is refused — the reuse an attacker who
   stole a refresh token would attempt buys them nothing. -}
test "the consumed refresh token is refused once the grace window has passed" =
  let (_, response) =
    send
      (contextAt (testInstant + 60 + 7201) 6)
      rotatedStore
      (postNoInput refreshToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

-- The rotation replaced the whole session, access half included: a client
-- that refreshes has been issued a new access token and is expected to use it.
test "the access token from before the rotation is refused after it" =
  let (_, response) =
    send
      (contextAt (testInstant + 120) 6)
      rotatedStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "an access token is refused on the refresh route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (postNoInput accessToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a refresh token is refused on an access-gated route" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (getQuery refreshToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "a refresh with no Authorization header is refused" =
  let (_, response) =
    send
      (contextAt (testInstant + 60) 4)
      sessionStore
      (postNoInput "" refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized AuthenticationRequired"

-- # Session families

daySeconds : Int
daySeconds = 86400

-- | Refresh with `refresh` at `instant`, giving the store left behind and the
-- pair the response carried.
rotateAt : Int ->
  Int ->
  Store ->
  String ->
  <Kdf, Mint {"access", "refresh"}, Sign "commit"> (Store, String, String)
rotateAt instant seed store refresh =
  let (next, response) =
    send (contextAt instant seed) store (postNoInput refresh refreshSessionNsid)
  (next, stringField "accessJwt" response, stringField "refreshJwt" response)

{- | A family rotated three times, the last only ten minutes before the ninety
   days since its login run out: every token in it is freshly minted, and the
   refresh token's own signed window runs for another ninety days. -}
lateChain : (Store, String, String)
lateChain =
  let (first, _, firstRefresh) =
    rotateAt (testInstant + 30 * daySeconds) 20 sessionStore refreshToken
  let (second, _, secondRefresh) =
    rotateAt (testInstant + 60 * daySeconds) 21 first firstRefresh
  rotateAt (testInstant + 90 * daySeconds - 600) 22 second secondRefresh

test "a family is refused past ninety days however recently it rotated" =
  let (store, access, refresh) = lateChain
  let before = testInstant + 90 * daySeconds - 300
  let after = testInstant + 90 * daySeconds + 60
  let (_, liveResponse) =
    send (contextAt before 23) store (getQuery access getSessionNsid)
  let (_, accessResponse) =
    send (contextAt after 24) store (getQuery access getSessionNsid)
  let (_, refreshResponse) =
    send (contextAt after 25) store (postNoInput refresh refreshSessionNsid)
  expectEach [
    (
      "the last rotation's access token works before the family ends",
      expectEqual "200 OK" (outcome liveResponse),
    ),
    (
      "the same access token is refused once the family has ended",
      expectEqual "401 Unauthorized InvalidToken" (outcome accessResponse),
    ),
    (
      "the last rotation's refresh token is refused once the family has ended",
      expectEqual "401 Unauthorized InvalidToken" (outcome refreshResponse),
    ),
  ]

{- | A rotated session expires at the sooner of its own refresh lifetime and
   the expiry of the session it consumed, and `lib.store`'s
   `storeSessionRotate` reads that expiry as the family's end. It is the
   family's end only while a refresh token lasts at least as long as a family:
   a shorter one would give the rotated session an earlier expiry, and from
   then on no session would hold the family's end. -}
test "a refresh token lasts at least as long as its family" =
  expectAtLeast sessionFamilyLifetimeSeconds refreshTokenSeconds

{- | A client that refreshes twice in a burst presents one refresh token twice.
   The second presentation, inside the grace window, is answered with a pair
   that works, and the first answer's pair keeps working beside it. -}
test "a consumed refresh token replayed within the grace window still works" =
  let (store, access, refresh) =
    rotateAt (testInstant + 120) 26 rotatedStore refreshToken
  let (_, replayed) =
    send
      (contextAt (testInstant + 121) 27)
      store
      (getQuery access getSessionNsid)
  let (_, earlier) =
    send
      (contextAt (testInstant + 121) 28)
      store
      (getQuery rotatedAccess getSessionNsid)
  expectEach [
    ("the replay issued a refresh token", expectNotEqual "" refresh),
    (
      "the replay issued a pair unlike the first rotation's",
      expectNotEqual rotatedAccess access,
    ),
    (
      "the replay's access token reaches a gated route",
      expectEqual "200 OK" (outcome replayed),
    ),
    (
      "the first rotation's access token still reaches it",
      expectEqual "200 OK" (outcome earlier),
    ),
  ]

-- | The original refresh token, consumed at +60, presented `count - step`
-- more times a second apart from +120, each against the store the last left.
replayBurst : Int ->
  Int ->
  Store ->
  <Kdf, Mint {"access", "refresh"}, Sign "commit"> (Store, List Bytes)
replayBurst step count store =
  if step >= count then
    (store, [])
  else
    let (next, response) =
      send
        (contextAt (testInstant + 120 + step) (40 + step))
        store
        (postNoInput refreshToken refreshSessionNsid)
    let (final, rest) = replayBurst (step + 1) count next
    (final, response :: rest)

-- | The outcome of one request, the store it left behind discarded.
answerTo : RequestContext ->
  Store ->
  Bytes ->
  <Kdf, Mint {"access", "refresh"}, Sign "commit"> String
answerTo context store bytes = match send context store bytes
  (_, response) => outcome response

{- | A client retrying one refresh in a burst presents the consumed token many
   times inside the grace window. Every presentation is answered with a pair,
   and each replay's pair supersedes the one before it: however long the
   burst, one replay-issued session is left open, beside the one the rotation
   itself issued, rather than one per presentation. -}
test "a burst of replays inside the grace window leaves one of its pairs open" =
  let (store, responses) = replayBurst 0 6 rotatedStore
  let at = contextAt (testInstant + 130) 50
  let (_, rotation) = send at store (getQuery rotatedAccess getSessionNsid)
  let served = "200 OK"
  let refused = "401 Unauthorized InvalidToken"
  expectEach [
    (
      "every replay is answered with a pair",
      expectEqual (map (_ => served) responses) (map outcome responses),
    ),
    (
      "only the last replay's access token still reaches a gated route",
      expectEqual
        [refused, refused, refused, refused, refused, served]
        (map
          (response =>
            answerTo
              at
              store
              (getQuery (stringField "accessJwt" response) getSessionNsid))
          responses),
    ),
    (
      "only the last replay's refresh token still rotates",
      expectEqual
        [refused, refused, refused, refused, refused, served]
        (map
          (response =>
            answerTo
              at
              store
              (postNoInput
                (stringField "refreshJwt" response)
                refreshSessionNsid))
          responses),
    ),
    (
      "the first rotation's access token still reaches a gated route",
      expectEqual served (outcome rotation),
    ),
  ]

{- | Family A: the logged-in session, rotated at +60 (`refreshed`) and again
   at +7000, so its current access token is still inside its own two hours
   when the original refresh token is replayed at +7261, past the grace window
   of its consumption at +60. Family B: a second login at +7000, which that
   replay must not touch. -}
revocation : (Store, Store, String, String, String, String, Bytes)
revocation =
  let (familyA, currentAccess, currentRefresh) =
    rotateAt (testInstant + 7000) 31 rotatedStore rotatedRefresh
  let (twoFamilies, siblingResponse) = login (testInstant + 7000) 32 familyA
  let (revoked, replay) =
    send
      (contextAt (testInstant + 7261) 33)
      twoFamilies
      (postNoInput refreshToken refreshSessionNsid)
  (
    twoFamilies,
    revoked,
    currentAccess,
    currentRefresh,
    stringField "accessJwt" siblingResponse,
    stringField "refreshJwt" siblingResponse,
    replay,
  )

test "a replay past the grace window revokes its whole family at once" =
  let (before, revoked, access, refresh, _, _, replay) = revocation
  let at = contextAt (testInstant + 7262) 34
  let (_, beforeResponse) = send at before (getQuery access getSessionNsid)
  let (_, accessResponse) = send at revoked (getQuery access getSessionNsid)
  let (_, refreshResponse) =
    send at revoked (postNoInput refresh refreshSessionNsid)
  expectEach [
    (
      "the replay itself is refused",
      expectEqual "401 Unauthorized InvalidToken" (outcome replay),
    ),
    (
      "the family's current access token worked before the replay",
      expectEqual "200 OK" (outcome beforeResponse),
    ),
    (
      "the family's current access token is refused after it",
      expectEqual "401 Unauthorized InvalidToken" (outcome accessResponse),
    ),
    (
      "the family's current refresh token is refused after it",
      expectEqual "401 Unauthorized InvalidToken" (outcome refreshResponse),
    ),
  ]

test "a revocation leaves a sibling family on the same account open" =
  let (_, revoked, _, _, siblingAccess, siblingRefresh, _) = revocation
  let (_, accessResponse) =
    send
      (contextAt (testInstant + 7262) 35)
      revoked
      (getQuery siblingAccess getSessionNsid)
  let (_, refreshResponse) =
    send
      (contextAt (testInstant + 7262) 36)
      revoked
      (postNoInput siblingRefresh refreshSessionNsid)
  expectEach [
    (
      "the sibling's access token still reaches a gated route",
      expectEqual "200 OK" (outcome accessResponse),
    ),
    (
      "the sibling's refresh token still rotates",
      expectEqual "200 OK" (outcome refreshResponse),
    ),
  ]

-- # deleteSession

closed : (Store, Bytes)
closed =
  send
    (contextAt (testInstant + 60) 7)
    sessionStore
    (postNoInput refreshToken deleteSessionNsid)

closedStore : Store
closedStore = match closed
  (store, _) => store

test "deleting the session is 200" = match closed
  (_, response) => expectEqual (outcome response) "200 OK"

{- | THE revocation property, and the reason a session list exists at all: the
   access token the client was holding when it logged out is refused from the
   next request on. Its signature is still good and its two-hour window is
   still open — a stateless check would still accept it. -}
test "the access token is refused after the session is deleted" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (getQuery accessToken getSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "the refresh token is refused after the session is deleted" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postNoInput refreshToken refreshSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

test "deleting the same session twice is refused the second time" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postNoInput refreshToken deleteSessionNsid)
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

{- | A write is gated on the ACCESS token, so logging out closes the account's
   repository to the client that logged out. The refusal is the seam's, and it
   comes before the handler: this store holds no repository at all, so a
   handler that ran would have answered `RepoNotFound`. -}
test "a write with the deleted session's access token is refused first" =
  let (_, response) =
    send
      (contextAt (testInstant + 61) 8)
      closedStore
      (postJson
        accountHostText
        accessToken
        createRecordNsid
        (stringify
          (jObject [
            ("repo", JString accountDidText),
            ("collection", JString "app.bsky.feed.post"),
            ("record", jObject [("text", JString "after logout")]),
          ])))
  expectEqual (outcome response) "401 Unauthorized InvalidToken"

{- | Logging out with the original refresh token after the rotation at +60
   consumed it, inside the grace window. The token is still admitted, since a
   replay of it would be, and it ends the family it was consumed in. -}
consumedClosed : (Store, Bytes)
consumedClosed =
  send
    (contextAt (testInstant + 120) 60)
    rotatedStore
    (postNoInput refreshToken deleteSessionNsid)

consumedClosedStore : Store
consumedClosedStore = match consumedClosed
  (store, _) => store

test "logging out with a consumed refresh token is 200" = match consumedClosed
  (_, response) => expectEqual "200 OK" (outcome response)

test "logging out with a consumed refresh token closes the rotated session" =
  let (_, response) =
    send
      (contextAt (testInstant + 121) 61)
      consumedClosedStore
      (getQuery rotatedAccess getSessionNsid)
  expectEqual "401 Unauthorized InvalidToken" (outcome response)

-- The consumed token is forgotten with its family, so presenting it again
-- inside the grace window cannot reopen what was logged out of.
test "a consumed refresh token logged out with is not replayed afterwards" =
  let (_, response) =
    send
      (contextAt (testInstant + 121) 62)
      consumedClosedStore
      (postNoInput refreshToken refreshSessionNsid)
  expectEqual "401 Unauthorized InvalidToken" (outcome response)

{- | The same logout past the grace window. Family A is rotated a second time
   at +7000, so its current access token is still inside its own two hours when
   the original refresh token is presented at +7261; family B is a second login
   at +7000, which the logout must not touch. -}
lateConsumedClosed : (Store, String, String, Bytes)
lateConsumedClosed =
  let (familyA, currentAccess, _) =
    rotateAt (testInstant + 7000) 63 rotatedStore rotatedRefresh
  let (twoFamilies, siblingResponse) = login (testInstant + 7000) 64 familyA
  let (store, response) =
    send
      (contextAt (testInstant + 60 + 7201) 65)
      twoFamilies
      (postNoInput refreshToken deleteSessionNsid)
  (store, currentAccess, stringField "accessJwt" siblingResponse, response)

test "logging out with a consumed refresh token past its grace is 200" =
  let (_, _, _, response) = lateConsumedClosed
  expectEqual "200 OK" (outcome response)

test "logging out past the grace window closes the family's current session" =
  let (store, access, _, _) = lateConsumedClosed
  let (_, response) =
    send
      (contextAt (testInstant + 7262) 66)
      store
      (getQuery access getSessionNsid)
  expectEqual "401 Unauthorized InvalidToken" (outcome response)

test "logging out with a consumed refresh token leaves a sibling family open" =
  let (store, _, siblingAccess, _) = lateConsumedClosed
  let (_, response) =
    send
      (contextAt (testInstant + 7262) 67)
      store
      (getQuery siblingAccess getSessionNsid)
  expectEqual "200 OK" (outcome response)

{- | The original refresh token, consumed at +60, replayed at +100 and again at
   +110. The second replay's pair supersedes the first's, so the first
   replay's refresh token is left naming no open session, and it still belongs
   to the family. -}
superseded : (Store, String, String)
superseded =
  let (once, _, firstReplay) =
    rotateAt (testInstant + 100) 70 rotatedStore refreshToken
  let (twice, secondAccess, _) =
    rotateAt (testInstant + 110) 71 once refreshToken
  (twice, firstReplay, secondAccess)

test "logging out with a superseded refresh token ends its family" =
  let (store, supersededRefresh, replayAccess) = superseded
  let (closedFamily, logout) =
    send
      (contextAt (testInstant + 120) 72)
      store
      (postNoInput supersededRefresh deleteSessionNsid)
  let at = contextAt (testInstant + 121) 73
  let refused = "401 Unauthorized InvalidToken"
  expectEach [
    ("the logout is 200", expectEqual "200 OK" (outcome logout)),
    (
      "the replay that superseded it is refused",
      expectEqual
        refused
        (answerTo at closedFamily (getQuery replayAccess getSessionNsid)),
    ),
    (
      "the rotated sibling is refused",
      expectEqual
        refused
        (answerTo at closedFamily (getQuery rotatedAccess getSessionNsid)),
    ),
  ]

{- | A superseded refresh token mints nothing. `refreshSession` refuses it and
   keeps the store it was handed, so the family stays open and the token can
   still end it. -}
test "a superseded refresh token is refused a refresh and leaves its family open" =
  let (store, supersededRefresh, replayAccess) = superseded
  let (after, refresh) =
    send
      (contextAt (testInstant + 120) 74)
      store
      (postNoInput supersededRefresh refreshSessionNsid)
  let at = contextAt (testInstant + 121) 75
  expectEach [
    (
      "the refresh is refused",
      expectEqual "401 Unauthorized InvalidToken" (outcome refresh),
    ),
    (
      "the replay that superseded it still reaches a gated route",
      expectEqual
        "200 OK"
        (answerTo at after (getQuery replayAccess getSessionNsid)),
    ),
    (
      "the token still ends the family afterwards",
      expectEqual
        "200 OK"
        (answerTo at after (postNoInput supersededRefresh deleteSessionNsid)),
    ),
  ]

-- # Independence

{- | Two logins are two sessions, and closing one leaves the other open. A
   single-session server would answer this cell the same way as a correct one
   right up until an account signed in twice. -}
test "logging out of one session leaves another open" =
  let (afterFirst, _) = login testInstant 1 configuredStore
  let (twoSessions, secondResponse) = login testInstant 9 afterFirst
  let secondAccess = stringField "accessJwt" secondResponse
  let secondRefresh = stringField "refreshJwt" secondResponse
  let (afterClose, _) =
    send
      (contextAt (testInstant + 1) 10)
      twoSessions
      (postNoInput refreshToken deleteSessionNsid)
  let (_, response) =
    send
      (contextAt (testInstant + 1) 11)
      afterClose
      (getQuery secondAccess getSessionNsid)
  expectEach [
    (
      "secondRefresh /= refreshToken",
      expectNotEqual refreshToken secondRefresh,
    ),
    ("outcome response == \"200 OK\"", expectEqual "200 OK" (outcome response)),
  ]
