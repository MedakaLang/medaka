{- | P4-D: the routes that need NO repository, on all three engines.

   No cell here builds an account repository, and so nothing here signs a
   commit. That is deliberate and is what makes an EVAL arm
   possible at all: one `repoInit` under the tree-walking interpreter does not
   complete in 600s on this box (measured in P4-C, and the reason
   `pds/test/repo_vectors.sh` has no `medaka run` arm any more, #2208). The
   repository-bearing read routes — `getRecord`, `listRecords`, `describeRepo`,
   `sync.getRepo`, `sync.getLatestCommit` — are graded against the pinned
   Phase-1 corpus by `pds/test/read_handlers_main.mdk` on the compiled engines
   instead.

   What IS gradeable on all three engines is exactly the part this slice added
   to the ROUTER: the two non-XRPC well-known paths become their own route
   class, `/favicon.ico` and friends still 404 exactly as before, the
   well-knowns answer with the right bytes and the right media type, and every
   repository-bearing read refuses cleanly with `RepoNotFound` on an
   unconfigured server rather than answering something. `com.atproto.identity.
   resolveHandle` and `com.atproto.server.describeServer` need no repository
   either, so both are graded here in full.

   No route cell may change the `Store`: every one of them runs against
   `storeEmpty` and asserts the successor is still that empty, unconfigured
   store.

   The second group of cells grades the APPVIEW-PROXY seam (`classifyProxy`),
   which belongs here for the same reason: it reads the route registry, the
   account and the open sessions, and no repository, so the question "may a
   service credential be minted for this client's `atproto-proxy` header" is
   answerable on all three engines. Those cells never reach a socket — what they
   assert is the decision itself, including that a refused request carries no
   claim set for anything to sign.

   They run against a store holding a session secret and one open session
   (`proxySessionStore`) rather than `storeEmpty`, because a forward is made on
   behalf of the logged-in account and the seam resolves the caller's credential
   before admitting one. That is still repository-free, which is what the eval
   arm's cost turns on: a session is an HMAC over a short string, and `repoInit`
   is what does not finish. -}

import http.{Request, parseRequest, serializeResponse}
import json.{Json(..), jObject, get, parse}
import string.{contains, fromUtf8, join, split, toUtf8}
import lib.handlers.{pdsServer}
import lib.jwt.{ServiceAuthRequest, mintToken, serverSecretBytes}
import lib.proxy.{
  AppviewRoute,
  appviewRouteFor,
  appviewRoutePort,
  AppviewTable,
  makeAppviewRoute,
  makeAppviewTable,
}
import lib.server_core.{
  Account,
  ProxyAdmission,
  ProxyDecision(..),
  RequestContext(..),
  Server,
  accessAudience,
  classifyProxy,
  handleBytes,
  makeAccount,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeEmpty,
  storeRepo,
  storeSessionOpen,
  storeSize,
  storeWithServerSecret,
}

accountDidText : String
accountDidText = "did:key:zQ3shVc2UkAfJCdc1TR8E66J85h48P43r93q8jGPkPpjF9Ef9"

accountHandleText : String
accountHandleText = "medaka.example"

accountHostText : String
accountHostText = "pds.example"

expectedDidDocument : String
expectedDidDocument =
  "{\"@context\":[\"https://www.w3.org/ns/did/v1\"],\"id\":\"did:web:pds.example\",\"service\":[{\"id\":\"#atproto_pds\",\"type\":\"AtprotoPersonalDataServer\",\"serviceEndpoint\":\"https://pds.example\"}]}"

mustAccount : Account
mustAccount = match makeAccount accountDidText accountHandleText accountHostText
  Ok account => account
  Err message => panic "read_routes: account setup failed: \{message}"

mustServer : Server
mustServer = match pdsServer mustAccount
  Ok server => server
  Err message => panic "read_routes: server setup failed: \{message}"

{- | The instant every request in this file is placed at. `lib.server_core`
   reads no clock, so each of its callers supplies one. -}
{- | The per-request nonce every request in this file is placed at. Nothing
   here drives a route that mints a token, so the value only has to be fixed;
   `pds/shell/server.mdk` draws a real one from `osEntropyBytes` per request. -}
testNonce : Array Int
testNonce = arrayMakeWith 16 (i => (i * 11 + 5) % 256)

testContext : RequestContext
testContext = RequestContext { nowSeconds = 1700000000, nonce = testNonce }

-- ── request framing ─────────────────────────────────────────────────────────

getRequest : String -> Array Int
getRequest target =
  toUtf8 "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\r\n"

getWithBodyFraming : String -> Array Int
getWithBodyFraming target =
  toUtf8
    "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\nContent-Type: application/json\r\n\r\n"

postRequest : String -> Array Int
postRequest target =
  toUtf8
    "POST \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}"

-- ── response inspection ─────────────────────────────────────────────────────

headerEnd : Array Int -> Int -> Int
headerEnd bytes i =
  if i + 3 >= arrayLength bytes then
    panic "read_routes: response has no header terminator"
  else if bytes[i] == 13
    && bytes[i + 1] == 10
    && bytes[i + 2] == 13
    && bytes[i + 3] == 10 then
    i
  else
    headerEnd bytes (i + 1)

headText : Array Int -> String
headText bytes = fromUtf8 (arrayMakeWith (headerEnd bytes 0) (i => bytes[i]))

bodyText : Array Int -> String
bodyText bytes =
  let start = headerEnd bytes 0 + 4
  fromUtf8 (arrayMakeWith (arrayLength bytes - start) (i => bytes[start + i]))

statusText : Array Int -> String
statusText bytes = match split " " (headText bytes)
  _ :: code :: _ => code
  _ => "<no-status>"

hasContentType : String -> Array Int -> Bool
hasContentType value bytes =
  contains "content-type: \{value}\r\n" (headText bytes)

errorCode : Array Int -> String
errorCode bytes = match parse (bodyText bytes)
  Ok value => match get "error" value
    Some (JString code) => code
    _ => "<no-error-field>"
  Err _ => "<unparseable-body>"

-- The proxy cells grade the refusal MESSAGE as well as the code, because every
-- refusal this seam can raise carries the same 400 `InvalidRequest`: the
-- message is the only thing that says whether a request was refused for the
-- audience it named or for the method it asked for, and those are different
-- claims about what was not signed.
errorMessage : Array Int -> String
errorMessage bytes = match parse (bodyText bytes)
  Ok value => match get "message" value
    Some (JString text) => text
    _ => "<no-message-field>"
  Err _ => "<unparseable-body>"

-- ── cells ───────────────────────────────────────────────────────────────────

{- | A cell is a request against the empty store. `state=unchanged` is the
   literal readback of the successor store, not a claim: an unconfigured store
   has no repository and no blobs, and no route here may create either. -}
storeIsEmpty : Store -> Bool
storeIsEmpty store =
  storeSize store == 0
    && (match storeRepo store
      None => True
      Some _ => False)

check : String -> Bool -> String -> <IO> Int
check label ok detail =
  if ok then
    let () = println "CELL \{label} PASS \{detail}"
    1
  else
    let () = println "CELL \{label} FAIL \{detail}"
    0

okCell : String -> Array Int -> String -> String -> <IO> Int
okCell label request contentType expectedBody =
  let (next, response) = handleBytes mustServer testContext storeEmpty request
  let status = statusText response
  let ok =
    status == "200"
      && hasContentType contentType response
      && bodyText response == expectedBody
      && storeIsEmpty next
  check
    label
    ok
    "status=\{status} media=\{contentType} body=\{bodyText response} state=unchanged"

failCell : String -> Array Int -> String -> String -> <IO> Int
failCell label request expectedStatus expectedCode =
  let (next, response) = handleBytes mustServer testContext storeEmpty request
  let status = statusText response
  let code = errorCode response
  let ok = status == expectedStatus && code == expectedCode && storeIsEmpty next
  check label ok "status=\{status} error=\{code} state=unchanged"

-- ── the appview-proxy seam ──────────────────────────────────────────────────

{- | The audiences these cells are configured to proxy to, and a THIRD service
   DID nothing here is configured for.

   The confused-deputy cells turn on the difference between a configured
   audience and an unconfigured one: a header naming the third must be refused
   with nothing signed, and a cell that printed a claim set for it would be
   exactly the defect the seam exists to prevent. The transcript is therefore
   graded on the whole outcome string — a refusal prints `signed=none` and an
   admission prints the claims, so the two can never be confused for each
   other.

   The two CONFIGURED audiences carry the other half of the same property. They
   differ only in their DID and their port, so an admitted call that reached
   the wrong one is visible as a `port=` that names the other row rather than
   as anything about the claim set, which is what makes a routing confusion
   gradeable here at all. -}
configuredAppviewDid : String
configuredAppviewDid = "did:web:appview.example"

configuredChatDid : String
configuredChatDid = "did:web:chat.example"

foreignServiceDid : String
foreignServiceDid = "did:web:other.example"

{- | The loopback ports the two configured audiences are reached at.

   Arbitrary numbers, and deliberately adjacent: nothing here opens a socket,
   so what a port means in this file is only "which row", and two values a
   transposition would swap is the shape a routing cell wants. -}
configuredAppviewPort : Int
configuredAppviewPort = 3128

configuredChatPort : Int
configuredChatPort = 3129

mustRoute : String -> Int -> AppviewRoute
mustRoute did port = match makeAppviewRoute did port
  Ok route => route
  Err message => panic "read_routes: audience row setup failed: \{message}"

configuredAudiences : Option AppviewTable
configuredAudiences =
  let configured = makeAppviewTable (mustRoute
    configuredAppviewDid
    configuredAppviewPort) [
    mustRoute configuredChatDid configuredChatPort,
  ]
  match configured
    Ok table => Some table
    Err message => panic "read_routes: audience table setup failed: \{message}"

{- | The session every proxy cell below calls as.

   A proxied read is made on behalf of the logged-in account, so `classifyProxy`
   refuses one whose caller presented no access token of its own — which means
   these cells need a real minted token and a store that has the secret it was
   minted with and an open session for it. The values are fixed rather than
   drawn from anywhere: what the cells grade is the DECISION, and a token is
   only an input to it.

   The refresh fingerprint is an unrelated constant. No cell presents a refresh
   token, and the two halves of a session are distinct fingerprints, so giving
   this one the access token's value would say something untrue about the store
   rather than nothing. -}
proxySessionSecret : Array Int
proxySessionSecret = arrayMakeWith serverSecretBytes (i => (i * 13 + 7) % 256)

proxyAccessToken : String
proxyAccessToken =
  mintToken
    proxySessionSecret
    accountDidText
    (accessAudience mustAccount)
    "read-routes-proxy-cells"
    1699999000
    1700003600

proxySessionStore : Store
proxySessionStore = match storeWithServerSecret proxySessionSecret storeEmpty
  Err message =>
    panic "read_routes: proxy session store setup failed: \{message}"
  Ok store =>
    storeSessionOpen
      (sessionFingerprint proxyAccessToken)
      (sessionFingerprint "read-routes-proxy-refresh")
      1700090000
      store

{- | The `Authorization` field every proxied request below carries, built once
   so that the ONE cell that presents no credential
   (`proxyRequestUnauthenticated`) is the only place this file differs on it. -}
proxyAuthField : String
proxyAuthField = "Authorization: Bearer \{proxyAccessToken}\r\n"

-- A server with no `--appview-did` at all, which is what every deployment that
-- has not configured an appview runs.
noPolicy : Option AppviewTable
noPolicy = None

proxyRequest : String -> String -> String -> Array Int
proxyRequest verb header target =
  toUtf8
    "\{verb} \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{proxyAuthField}atproto-proxy: \{header}\r\n\r\n"

{- | A forwarded write: a POST carrying a body, the two inbound fields a
   forward relays for it, and one field it must NOT relay.

   The unrelayed field is what makes this a whitelist test rather than a
   copy test: the relayed list is printed in full by `proxyOutcome`, so a seam
   that carried `x-medaka-not-relayed` along would fail here even though every
   field the client asked to be relayed did arrive. -}
proxyPostRequest : String -> String -> Array Int
proxyPostRequest target body =
  toUtf8
    "POST \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{proxyAuthField}atproto-proxy: \{configuredAppviewDid}\r\naccept-language: en-GB\r\nx-medaka-not-relayed: 1\r\ncontent-type: application/json\r\ncontent-length: \{intToString (stringLength body)}\r\n\r\n\{body}"

{- | A call that names NO audience, made by the logged-in account.

   A forward is made on the account's behalf whether or not the client named
   where to, so the header-absent arm needs the same credential the header-
   bearing one does; this is `proxyRequest` with the `atproto-proxy` field and
   nothing else removed. -}
proxyRequestNoHeader : String -> Array Int
proxyRequestNoHeader target =
  toUtf8
    "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{proxyAuthField}\r\n"

{- | The same request `proxy-admitted-timeline` sends, with the caller's own
   credential left out. An anonymous caller asking this server to forward under
   the ACCOUNT's identity is the confused deputy in its plainest form, so it is
   refused before the audience it named is even looked at. -}
proxyRequestUnauthenticated : String -> Array Int
proxyRequestUnauthenticated target =
  toUtf8
    "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\natproto-proxy: \{configuredAppviewDid}\r\n\r\n"

-- Field names are case-insensitive on the wire, so the seam must find the
-- header under the spelling a client chose rather than the one it expects.
proxyMixedCaseRequest : String -> Array Int
proxyMixedCaseRequest target =
  toUtf8
    "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{proxyAuthField}Atproto-Proxy: \{configuredAppviewDid}\r\n\r\n"

-- Two fields, the first naming the configured appview and the second naming
-- somewhere else. A seam that took the first would be proxying a request whose
-- audience the client left ambiguous.
proxyRepeatedRequest : String -> Array Int
proxyRepeatedRequest target =
  toUtf8
    "GET \{target} HTTP/1.1\r\nHost: \{accountHostText}\r\n\{proxyAuthField}atproto-proxy: \{configuredAppviewDid}\r\natproto-proxy: \{foreignServiceDid}\r\n\r\n"

mustRequest : Array Int -> Request
mustRequest bytes = match parseRequest bytes
  Ok request => request
  Err message =>
    panic "read_routes: proxy cell request did not frame: \{message}"

lxmText : Option String -> String
lxmText None = "<absent>"
lxmText (Some nsid) = nsid

claimText : ServiceAuthRequest -> String
claimText claims =
  "iss=\{claims.iss} aud=\{claims.aud} lxm=\{lxmText claims.lxm} jti=\{claims.jti} iat=\{intToString claims.iat}"

{- | The relayed inbound fields, as the admission selected them.

   Printed in full rather than counted: the fields are a WHITELIST, so a cell
   asserting on this string fails both when a listed field is dropped and when
   an unlisted one is carried along. -}
relayedText : List (String, String) -> String
relayedText fields = join "," (map ((name, value) => "\{name}=\{value}") fields)

{- | Everything an admission licenses the shell to do, in one line.

   `verb`, `relayed` and `body` are here because a forward now carries them:
   the seam chooses them and the shell only sends what it is handed, so a cell
   that graded the target and the claims alone would not see a lost body or a
   dropped field at all. `audience` and the claim's `aud` are printed
   separately because they are allowed to differ — the first is the bare DID
   this server admitted and may open a socket to, the second is the header's
   own text a token is signed for. -}
{- | The loopback port a forward this admission licensed would leave by, as the
   shell finds it: by asking the configured table for the row whose DID is the
   ADMITTED audience (`pds/shell/egress.mdk`'s `egressCall`).

   It is looked up here rather than read off the admission because the
   admission carries no port — the seam decides WHO may be talked to and the
   shell decides which socket that is, and grading the second against the first
   is what makes an audience that routed to another audience's proxy visible.
   `<unrouted>` is what an admitted audience no row holds would print, which is
   a state nothing should be able to reach. -}
routeText : Option AppviewTable -> String -> String
routeText None _ = "<no-table>"
routeText (Some table) did = match appviewRouteFor table did
  Some route => intToString (appviewRoutePort route)
  None => "<unrouted>"

proxyOutcome : Option AppviewTable -> ProxyDecision -> String
proxyOutcome _ NotProxied = "decision=not-proxied signed=none"
proxyOutcome _ (ProxyRefused response) =
  let bytes = serializeResponse response
  "decision=refused status=\{statusText bytes} error=\{errorCode bytes} message=\{errorMessage bytes} signed=none"
proxyOutcome table (ProxyAdmitted admission) =
  "decision=admitted verb=\{admission.verb} target=\{admission.target} audience=\{admission.audience} \{claimText admission.serviceAuth} relayed=[\{relayedText admission.headers}] body=\{fromUtf8 admission.body} port=\{routeText table admission.audience}"

proxyCell : String -> Option AppviewTable -> Array Int -> String -> <IO> Int
proxyCell label policy bytes expected =
  let decision =
    classifyProxy
      mustServer
      testContext
      policy
      proxySessionStore
      (mustRequest bytes)
  let got = proxyOutcome policy decision
  check label (got == expected) got

xrpc : String -> String
xrpc rest = "/xrpc/\{rest}"

identityRoute : String -> String
identityRoute query = xrpc "com.atproto.identity.resolveHandle\{query}"

{- | `jti` as the admitted cells expect it: `testNonce` hex-encoded.

   A literal, not a recomputation. It is what makes the admitted cells assert
   that the credential's one unique value comes from the request's own nonce and
   is the 32 hex characters
   `pds/test/vectors/pds_service_auth_shape_corpus.txt` records — a cell that
   re-encoded the nonce here would assert neither. -}
expectedJti : String
expectedJti = "05101b26313c47525d68737e89949faa"

notProxiedLine : String
notProxiedLine = "decision=not-proxied signed=none"

admittedWith : String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  String ->
  Int ->
  String
admittedWith verb target audience aud nsid relayed body port =
  "decision=admitted verb=\{verb} target=\{target} audience=\{audience} iss=\{accountDidText} aud=\{aud} lxm=\{nsid} jti=\{expectedJti} iat=1700000000 relayed=[\{relayed}] body=\{body} port=\{intToString port}"

-- A forwarded GET: no body, and therefore no body fields relayed with it.
admittedLine : String -> String -> String -> Int -> String
admittedLine target aud nsid port =
  admittedWith "GET" target aud aud nsid "" "" port

refusedLine : String -> String -> String -> String
refusedLine status code message =
  "decision=refused status=\{status} error=\{code} message=\{message} signed=none"

invalidRequestLine : String -> String
invalidRequestLine message = refusedLine "400" "InvalidRequest" message

-- `refusalFor NoCredential`'s own body, which is what every other gated route
-- answers a caller that presented nothing.
noCredentialLine : String
noCredentialLine =
  refusedLine "401" "AuthenticationRequired" "Authentication Required"

timelineTarget : String
timelineTarget = xrpc "app.bsky.feed.getTimeline?limit=2"

-- | A read this server does not register, used by both header-absent cells.
followsTarget : String
followsTarget = xrpc "app.bsky.graph.getFollows?actor=\{accountDidText}"

updateSeenTarget : String
updateSeenTarget = xrpc "app.bsky.notification.updateSeen"

updateSeenBody : String
updateSeenBody = "{\"seenAt\":\"2026-09-12T00:00:00.000Z\"}"

-- | A read in the OTHER forwardable namespace, used by every second-audience
-- cell. `chat.bsky.*` is the DM service's lexicon and this server registers
-- none of it, so the method half of every one of those cells is settled by the
-- namespace bound and only the audience half is in question.
listConvosTarget : String
listConvosTarget = xrpc "chat.bsky.convo.listConvos"

{- | An nsid in no namespace this server forwards and in no registry it holds.

   `com.atproto.temp.*` is deliberately not one of the account-management
   methods: what the two cells on it assert is the NAMESPACE bound, which owes
   the same answer to a method whose only property is being outside it. -}
outOfNamespaceTarget : String
outOfNamespaceTarget = xrpc "com.atproto.temp.checkSignupQueue"

{- | The same method `timelineTarget` names, spelled with an upper-case
   authority.

   `lib.nsid`'s `sameNsidIdentity` folds the case of an NSID's authority and
   not of its method name, so this IS `app.bsky.feed.getTimeline` and is
   forwarded — while `App.Bsky.Feed.GetTimeline` would be a different method and
   forwarded for nothing. What the cell asserts is that the `lxm` claim carries
   the TABLE's spelling and not this one: a signed claim must name the value the
   authorization decision was taken against, and the client chose these
   bytes. -}
mixedCaseNsidTarget : String
mixedCaseNsidTarget = xrpc "App.Bsky.Feed.getTimeline?limit=2"

{- | The proxy-disposition half of this file: the same request bytes the socket
   shell frames, graded at the pure seam that decides whether anything may be
   signed for them.

   It lives here rather than in a gate of its own because every cell is
   repository-free — `classifyProxy` reads the registry and the account, never
   the store — so all three engines can run it for the price of the cells
   themselves. -}
runProxyCells : <IO> Int
runProxyCells =
  let profileTarget = xrpc "app.bsky.actor.getProfile?actor=\{accountDidText}"
  let authorFeedTarget =
    xrpc "app.bsky.feed.getAuthorFeed?actor=\{accountDidText}"
  let absent =
    proxyCell
      "proxy-header-absent-default-appview"
      configuredAudiences
      (proxyRequestNoHeader followsTarget)
      (admittedLine
        followsTarget
        configuredAppviewDid
        "app.bsky.graph.getFollows"
        configuredAppviewPort)
  -- Anonymous ON PURPOSE: a deployment with no appview has no forward to make,
  -- so this path must stay the router's 404 and must not become the 401 a
  -- credential check would answer first.
  let absentUnconfigured =
    proxyCell
      "proxy-header-absent-no-appview"
      noPolicy
      (getRequest followsTarget)
      notProxiedLine
  let admitted =
    proxyCell
      "proxy-admitted-timeline"
      configuredAudiences
      (proxyRequest "GET" configuredAppviewDid timelineTarget)
      (admittedLine
        timelineTarget
        configuredAppviewDid
        "app.bsky.feed.getTimeline"
        configuredAppviewPort)
  let fragment =
    proxyCell
      "proxy-admitted-service-fragment"
      configuredAudiences
      (proxyRequest "GET" "\{configuredAppviewDid}#bsky_appview" profileTarget)
      (admittedWith
        "GET"
        profileTarget
        configuredAppviewDid
        "\{configuredAppviewDid}#bsky_appview"
        "app.bsky.actor.getProfile"
        ""
        ""
        configuredAppviewPort)
  let mixedCase =
    proxyCell
      "proxy-header-name-case-insensitive"
      configuredAudiences
      (proxyMixedCaseRequest authorFeedTarget)
      (admittedLine
        authorFeedTarget
        configuredAppviewDid
        "app.bsky.feed.getAuthorFeed"
        configuredAppviewPort)
  let foreign =
    proxyCell
      "proxy-foreign-audience"
      configuredAudiences
      (proxyRequest "GET" foreignServiceDid timelineTarget)
      (invalidRequestLine
        "atproto-proxy names a service this server does not proxy to")
  let notADid =
    proxyCell
      "proxy-audience-not-a-did"
      configuredAudiences
      (proxyRequest "GET" "https://appview.example" timelineTarget)
      (invalidRequestLine "atproto-proxy does not name a service DID")
  let repeated =
    proxyCell
      "proxy-header-repeated"
      configuredAudiences
      (proxyRepeatedRequest timelineTarget)
      (invalidRequestLine "atproto-proxy must not be repeated")
  let protectedUnregistered =
    proxyCell
      "proxy-protected-method-unregistered"
      configuredAudiences
      (proxyRequest
        "GET"
        configuredAppviewDid
        (xrpc "com.atproto.admin.deleteAccount"))
      (invalidRequestLine
        "No service configured for com.atproto.admin.deleteAccount")
  let registeredWithHeader =
    proxyCell
      "proxy-registered-method-with-header"
      configuredAudiences
      (proxyRequest
        "GET"
        configuredAppviewDid
        (xrpc "com.atproto.server.getSession"))
      notProxiedLine
  let localMiss =
    proxyCell
      "proxy-forward-on-local-miss"
      configuredAudiences
      (proxyRequest
        "GET"
        configuredAppviewDid
        (xrpc
          "com.atproto.repo.getRecord?repo=\{accountDidText}&collection=app.bsky.feed.post&rkey=medaka-a"))
      notProxiedLine
  let preferences =
    proxyCell
      "proxy-admitted-preferences"
      configuredAudiences
      (proxyRequest
        "GET"
        configuredAppviewDid
        (xrpc "app.bsky.actor.getPreferences"))
      (admittedLine
        (xrpc "app.bsky.actor.getPreferences")
        configuredAppviewDid
        "app.bsky.actor.getPreferences"
        configuredAppviewPort)
  let unconfigured =
    proxyCell
      "proxy-no-appview-configured"
      noPolicy
      (proxyRequest "GET" configuredAppviewDid timelineTarget)
      (invalidRequestLine "No service configured for app.bsky.feed.getTimeline")
  let postBody =
    proxyCell
      "proxy-admitted-post-body"
      configuredAudiences
      (proxyPostRequest updateSeenTarget updateSeenBody)
      (admittedWith
        "POST"
        updateSeenTarget
        configuredAppviewDid
        configuredAppviewDid
        "app.bsky.notification.updateSeen"
        "accept-language=en-GB,content-type=application/json"
        updateSeenBody
        configuredAppviewPort)
  let needsGetOrPost =
    proxyCell
      "proxy-forwardable-requires-get-or-post"
      configuredAudiences
      (proxyRequest "DELETE" configuredAppviewDid timelineTarget)
      (refusedLine
        "405"
        "MethodNotAllowed"
        "a proxied XRPC method requires GET or POST")
  let outOfNamespaceHeader =
    proxyCell
      "proxy-out-of-namespace-with-header"
      configuredAudiences
      (proxyRequest "GET" configuredAppviewDid outOfNamespaceTarget)
      (invalidRequestLine
        "No service configured for com.atproto.temp.checkSignupQueue")
  let outOfNamespaceAbsent =
    proxyCell
      "proxy-out-of-namespace-header-absent"
      configuredAudiences
      (getRequest outOfNamespaceTarget)
      notProxiedLine
  let wellKnown =
    proxyCell
      "proxy-header-on-well-known"
      configuredAudiences
      (proxyRequest "GET" configuredAppviewDid "/.well-known/did.json")
      notProxiedLine
  let unauthenticated =
    proxyCell
      "proxy-unauthenticated"
      configuredAudiences
      (proxyRequestUnauthenticated timelineTarget)
      noCredentialLine
  let mixedCaseNsid =
    proxyCell
      "proxy-admitted-nsid-authority-case"
      configuredAudiences
      (proxyRequest "GET" configuredAppviewDid mixedCaseNsidTarget)
      (admittedLine
        mixedCaseNsidTarget
        configuredAppviewDid
        "app.bsky.feed.getTimeline"
        configuredAppviewPort)
  -- The SECOND configured audience, named by a header. Everything but the DID
  -- and the port is what the appview cells send, so what this cell adds over
  -- them is the routing: the admitted audience is the chat DID and the port a
  -- forward would leave by is the chat row's, not the default row's.
  let chatAudience =
    proxyCell
      "proxy-admitted-chat-audience"
      configuredAudiences
      (proxyRequest "GET" configuredChatDid listConvosTarget)
      (admittedLine
        listConvosTarget
        configuredChatDid
        "chat.bsky.convo.listConvos"
        configuredChatPort)
  -- A service OF the second audience. The fragment is stripped before the
  -- table is asked, so the row that matches is the chat row and not the
  -- default one — a strip that fell through to the default would send a
  -- credential minted for the chat service to the appview's proxy.
  let chatFragment =
    proxyCell
      "proxy-admitted-chat-service-fragment"
      configuredAudiences
      (proxyRequest "GET" "\{configuredChatDid}#bsky_chat" listConvosTarget)
      (admittedWith
        "GET"
        listConvosTarget
        configuredChatDid
        "\{configuredChatDid}#bsky_chat"
        "chat.bsky.convo.listConvos"
        ""
        ""
        configuredChatPort)
  -- The two axes stay independent: a `chat.bsky.*` method is forwardable on
  -- namespace alone, and the audience it goes to is the one the HEADER named.
  -- A server that routed on the method's namespace would send this to the chat
  -- row; the client asked for the appview.
  let chatMethodDefaultAudience =
    proxyCell
      "proxy-chat-method-default-audience"
      configuredAudiences
      (proxyRequest "GET" configuredAppviewDid listConvosTarget)
      (admittedLine
        listConvosTarget
        configuredAppviewDid
        "chat.bsky.convo.listConvos"
        configuredAppviewPort)
  -- A DID's method-specific identifier is case-SENSITIVE, so neither of these
  -- is a configured audience and neither may be admitted for the row it
  -- resembles. They are the audience-routing-confusion pair: a comparison that
  -- folded case would admit one of them and then route it somewhere.
  let chatAudienceCaseFolded =
    proxyCell
      "proxy-chat-audience-case-folded"
      configuredAudiences
      (proxyRequest "GET" "did:web:Chat.Example" listConvosTarget)
      (invalidRequestLine
        "atproto-proxy names a service this server does not proxy to")
  let appviewAudienceCaseFolded =
    proxyCell
      "proxy-appview-audience-case-folded"
      configuredAudiences
      (proxyRequest "GET" "did:web:Appview.Example" timelineTarget)
      (invalidRequestLine
        "atproto-proxy names a service this server does not proxy to")
  chatAudience
    + chatFragment
    + chatMethodDefaultAudience
    + chatAudienceCaseFolded
    + appviewAudienceCaseFolded
    + absent
    + absentUnconfigured
    + admitted
    + fragment
    + mixedCase
    + foreign
    + notADid
    + repeated
    + protectedUnregistered
    + registeredWithHeader
    + localMiss
    + preferences
    + unconfigured
    + postBody
    + needsGetOrPost
    + outOfNamespaceHeader
    + outOfNamespaceAbsent
    + wellKnown
    + unauthenticated
    + mixedCaseNsid

runCells : <IO> Unit
runCells =
  let didJson =
    okCell
      "wellknown-did-json"
      (getRequest "/.well-known/did.json")
      "application/json"
      expectedDidDocument
  let atprotoDid =
    okCell
      "wellknown-atproto-did"
      (getRequest "/.well-known/atproto-did")
      "text/plain; charset=utf-8"
      accountDidText
  let wellKnownPost =
    failCell
      "wellknown-post-rejected"
      (postRequest "/.well-known/did.json")
      "405"
      "MethodNotAllowed"
  let wellKnownFramed =
    failCell
      "wellknown-body-framing-rejected"
      (getWithBodyFraming "/.well-known/atproto-did")
      "400"
      "InvalidRequest"
  let favicon =
    failCell "non-xrpc-still-404" (getRequest "/favicon.ico") "404" "NotFound"
  let sibling =
    failCell
      "well-known-sibling-still-404"
      (getRequest "/.well-known/openid-configuration")
      "404"
      "NotFound"
  let resolve =
    okCell
      "resolve-handle"
      (getRequest (identityRoute "?handle=\{accountHandleText}"))
      "application/json"
      "{\"did\":\"\{accountDidText}\"}"
  let resolveUnknown =
    failCell
      "resolve-handle-unknown"
      (getRequest (identityRoute "?handle=stranger.example"))
      "400"
      "HandleNotFound"
  let resolveRepeated =
    failCell
      "resolve-handle-repeated-param"
      (getRequest (identityRoute "?handle=a.example&handle=b.example"))
      "400"
      "InvalidRequest"
  let resolveMissing =
    failCell
      "resolve-handle-missing-param"
      (getRequest (identityRoute ""))
      "400"
      "InvalidRequest"
  let describeServer =
    okCell
      "describe-server"
      (getRequest (xrpc "com.atproto.server.describeServer"))
      "application/json"
      "{\"did\":\"\{accountDidText}\",\"availableUserDomains\":[],\"inviteCodeRequired\":false}"
  let getRecord =
    failCell
      "get-record-unconfigured"
      (getRequest
        (xrpc
          "com.atproto.repo.getRecord?repo=\{accountDidText}&collection=app.bsky.feed.post&rkey=medaka-a"))
      "400"
      "RepoNotFound"
  let listRecords =
    failCell
      "list-records-unconfigured"
      (getRequest
        (xrpc
          "com.atproto.repo.listRecords?repo=\{accountDidText}&collection=app.bsky.feed.post"))
      "400"
      "RepoNotFound"
  let describeRepo =
    failCell
      "describe-repo-unconfigured"
      (getRequest (xrpc "com.atproto.repo.describeRepo?repo=\{accountDidText}"))
      "400"
      "RepoNotFound"
  let getRepo =
    failCell
      "get-repo-unconfigured"
      (getRequest (xrpc "com.atproto.sync.getRepo?did=\{accountDidText}"))
      "400"
      "RepoNotFound"
  let latestCommit =
    failCell
      "get-latest-commit-unconfigured"
      (getRequest
        (xrpc "com.atproto.sync.getLatestCommit?did=\{accountDidText}"))
      "400"
      "RepoNotFound"
  let listRepos =
    okCell
      "list-repos-empty"
      (getRequest (xrpc "com.atproto.sync.listRepos"))
      "application/json"
      "{\"repos\":[]}"
  let getRepoStatus =
    failCell
      "get-repo-status-unconfigured"
      (getRequest (xrpc "com.atproto.sync.getRepoStatus?did=\{accountDidText}"))
      "400"
      "RepoNotFound"
  let readNeedsGet =
    failCell
      "read-route-requires-get"
      (postRequest
        (xrpc "com.atproto.repo.describeRepo?repo=\{accountDidText}"))
      "405"
      "MethodNotAllowed"
  let unregistered =
    failCell
      "unregistered-xrpc-still-404"
      (getRequest (xrpc "com.atproto.repo.listMissingBlobs"))
      "404"
      "NotFound"
  let proxied = runProxyCells
  let cells =
    proxied
      + didJson
      + atprotoDid
      + wellKnownPost
      + wellKnownFramed
      + favicon
      + sibling
      + resolve
      + resolveUnknown
      + resolveRepeated
      + resolveMissing
      + describeServer
      + getRecord
      + listRecords
      + describeRepo
      + getRepo
      + latestCommit
      + listRepos
      + getRepoStatus
      + readNeedsGet
      + unregistered
  let () =
    println
      "cells: \{intToString cells}/45 repository-free routes and proxy dispositions"
  if cells == 45 then
    println "TOTAL: PASS"
  else
    let () = println "TOTAL: FAIL"
    exit 1

main : <IO> Unit
main = runCells
