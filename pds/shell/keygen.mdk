{- | Generating the two secrets `pds serve` will not generate for an operator:
   the account signing key, and the session-token secret.

   This is shell work, not `pds/lib` work: it reads OS entropy and writes
   files, and `pds/lib` draws no entropy and performs no I/O. What it does NOT
   own is the flag vocabulary — `pds/serve.mdk` holds `keygen`'s roster beside
   `serve`'s.

   Both secrets live at fixed paths relative to the working directory,
   `secrets/key.hex` and `secrets/token.hex`, the same paths `serve` reads
   them back from. Each path is written out literally at every call that
   touches it, so the rows below name exactly the files they read and write.

   Nothing here renders a secret. A generated scalar reaches its file and the
   two public values derived from it, and no other output; the failure paths
   name the file and the rule and never the value. -}

import bytes.{Bytes, fromArrayAssumeByteDomain}
import fs.{isDir}
import hex.{encode}
import io.{writeFilePrivate}
import lib.did_key.{didKeyFromPublicKey}
import lib.jwt.{serverSecretBytes}
import lib.sign.{
  SecretKey, publicKeyCompressed, publicKeyForSecret, secretKeyFromBytes
}

{- | How many candidate scalars `keygen` will draw before giving up.

   A uniformly random 32-byte value is outside `[1, n)` with probability below
   2^-127, so a bound of eight is a bound on a broken entropy source and on
   nothing else: the loop is not expected to take a second turn. -}
keygenAttempts : Int
keygenAttempts = 8

{- | Door (FFI), checked: `osEntropyBytes` answers the runtime's integer
   array and a candidate scalar is `Bytes`. An element outside 0..255 gets
   `secretKeyFromBytes`'s own refusal, so a broken entropy source is refused
   the way an out-of-range scalar is.

   The candidate is a secret scalar, so the range check reads every element
   and branches once on the aggregate: an early-exit scan would let the
   position of the first bad element decide how many elements are read. -}
secretKeyDoor : Array Int -> Result String Bytes
secretKeyDoor raw =
  if outOfByteRange raw 0 0 == 0 then
    Ok (fromArrayAssumeByteDomain raw)
  else
    Err "sign.secretKeyFromBytes: expected a 32-byte scalar in 1..n-1"

-- A candidate admitted as a key, through `secretKeyDoor` and then the same
-- `secretKeyFromBytes` the server admits `secrets/key.hex` with.
admitCandidate : Array Int -> Result String Bytes
admitCandidate raw = do
  bytes <- secretKeyDoor raw
  map (_ => bytes) (secretKeyFromBytes bytes)

-- Zero exactly when every element of `raw` from `i` on is a byte: shifted
-- right by 8, a byte is 0, a larger value is positive, and a negative value
-- stays negative.
outOfByteRange : Array Int -> Int -> Int -> Int
outOfByteRange raw i acc =
  if i >= arrayLength raw then
    acc
  else
    outOfByteRange raw (i + 1) (bitOr acc (shiftRight raw[i] 8))

{- | A fresh secp256k1 secret scalar, admitted by the same
   `lib.sign.secretKeyFromBytes` the server admits `secrets/key.hex` with — so
   `keygen` can produce no value `serve` would later refuse, and admits `d`
   only in `[1, n)`.

   The bytes come from `osEntropyBytes`, the OS entropy source, and never from
   `randomInt`, whose SplitMix64 generator is seeded deterministically and
   would make every key this ever generated derivable from a public constant.
   No candidate, admitted or rejected, reaches the failure message. -}
export
keygenSecretBytes : Int -> <Rand> Result String Bytes
keygenSecretBytes attempts =
  if attempts < 1 then
    Err
      "the entropy source produced no scalar in 1..n-1; refusing to write a key"
  else match admitCandidate (osEntropyBytes signingKeyBytes)
    Err _ => keygenSecretBytes (attempts - 1)
    Ok bytes => Ok bytes

{- | A fresh session-token secret, drawn from `osEntropyBytes` for the reason
   `keygenSecretBytes` gives. Exported so `pds/serve.mdk`'s first-run
   generation draws it through this same door.

   Door (FFI), masked: `osEntropyBytes` is the runtime's integer-array
   extern, and every element it returns is a byte by construction. The
   secret is never scanned, so no step here branches on its value. -}
export
tokenSecretBytes : Unit -> <Rand> Bytes
tokenSecretBytes () =
  fromArrayAssumeByteDomain (osEntropyBytes serverSecretBytes)

-- | How many bytes a secp256k1 secret scalar is.
signingKeyBytes : Int
signingKeyBytes = 32

{- | The two PUBLIC values of a signing key: its compressed SEC 1 public key
   as hex, and the `did:key` that names it. Both are derived through exactly
   the boundary `lib.repo` signs commits with, so what `keygen` prints is what
   the network will see this key as, and neither value discloses the scalar.

   This is the whole of `keygen`'s derivation, exported so
   `pds/test/secp256k1_public_key_main.mdk` can grade it against the official
   corpora rather than against this program's own output. -}
export
keygenSummary : Bytes -> Result String (String, String)
keygenSummary bytes = do
  secret <- secretKeyFromBytes bytes
  let publicKey = publicKeyForSecret secret
  Ok (
    encode (publicKeyCompressed publicKey),
    didKeyFromPublicKey publicKey,
  )

{- | Refuse `path` if it already exists, drawing no entropy and writing
   nothing.

   The refusal is the point: `keygen` overwriting a signing key would destroy
   the only thing that can sign this account's next commit, and an operator
   who meant to rotate can say so by moving the old file aside.

   It is exported because the caller must apply it to EVERY destination a run
   names before any of them is written: a run that generated a key, announced
   it, and then refused the second destination would leave a valid 0600 key on
   disk under a failure exit code, which an operator reading the exit code
   would take as "nothing happened". -}
export
keygenRefusePath : String ->
  (path : String) ->
  <FileRead path> Result String Unit
keygenRefusePath label path =
  if fileExists path then
    Err
      "refusing \{path}: it already exists, and overwriting a \{label} destroys it; move it aside first if you mean to replace it"
  else
    Ok ()

{- | Create `secrets/` when it is absent, and refuse a `secrets` that exists
   but is not a directory.

   The directory is created at the runtime's `makeDir` mode (0755 before the
   umask): no primitive can create or narrow a directory's mode. Every file
   written into it is 0600, which is what `serve` grades. -}
export
keygenSecretsDir : Unit ->
  <FileRead "secrets", FileWrite "secrets"> Result String Unit
keygenSecretsDir () =
  if fileExists "secrets" then match isDir "secrets"
    Ok True => Ok ()
    Ok False => Err "refusing secrets: it exists and is not a directory"
    Err message => Err "unreadable secrets: \{message}"
  else match makeDir "secrets"
    Ok () => Ok ()
    Err message => Err "cannot create secrets: \{message}"

-- | Write one generated secret to `path` at mode 0600. The existence refusal
-- is re-applied here so no write path can bypass it, whatever the caller did.
keygenWrite : String ->
  (path : String) ->
  Bytes ->
  <FileRead path, FileWrite path> Result String Unit
keygenWrite label path bytes = match keygenRefusePath label path
  Err message => Err message
  Ok () => match writeFilePrivate path "\{encode bytes}\n"
    Err message => Err "unwritable \{label} \{path}: \{message}"
    Ok () => Ok ()

-- | Generate the signing key at `secrets/key.hex`, and report the two public
-- values that identify it. The scalar itself goes to the file and nowhere
-- else.
export
keygenSigningKey : Unit ->
  <FileRead "secrets/key.hex", FileWrite "secrets/key.hex", Rand, Stdout> Result String Unit
keygenSigningKey () = do
  bytes <- keygenSecretBytes keygenAttempts
  (publicHex, did) <- keygenSummary bytes
  () <- keygenWrite "signing key" "secrets/key.hex" bytes
  let () = putStrLn "keygen: wrote signing key secrets/key.hex (mode 0600)"
  let () = putStrLn "keygen: public key \{publicHex}"
  let () = putStrLn "keygen: did:key \{did}"
  Ok ()

-- | Generate the session-token secret at `secrets/token.hex`.
export
keygenTokenSecret : Unit ->
  <FileRead "secrets/token.hex", FileWrite "secrets/token.hex", Rand, Stdout> Result String Unit
keygenTokenSecret () = do
  () <- keygenWrite
    "session-token secret"
    "secrets/token.hex"
    (tokenSecretBytes ())
  let () =
    putStrLn "keygen: wrote session-token secret secrets/token.hex (mode 0600)"
  Ok ()

{- | Generate both secrets, publish neither success summary until both writes
   succeed, and remove the signing key if the token-secret write fails.

   This is command-level cleanup, not cross-directory crash atomicity. A
   cleanup failure preserves the original write error and also names the
   signing-key residue that may remain. -}
export
keygenSigningKeyAndTokenSecret : Unit ->
  <FileRead "secrets/key.hex", FileRead "secrets/token.hex", FileWrite "secrets/key.hex", FileWrite "secrets/token.hex", Rand, Stdout> Result String Unit
keygenSigningKeyAndTokenSecret () = do
  keyBytes <- keygenSecretBytes keygenAttempts
  (publicHex, did) <- keygenSummary keyBytes
  let secretBytes = tokenSecretBytes ()
  () <- keygenWrite "signing key" "secrets/key.hex" keyBytes
  match keygenWrite "session-token secret" "secrets/token.hex" secretBytes
    Err message => match removeFile "secrets/key.hex"
      Ok () => Err message
      Err cleanup =>
        Err
          "\{message}; cleanup of signing key secrets/key.hex also failed: \{cleanup}; the signing key may remain"
    Ok () =>
      let () = putStrLn "keygen: wrote signing key secrets/key.hex (mode 0600)"
      let () = putStrLn "keygen: public key \{publicHex}"
      let () = putStrLn "keygen: did:key \{did}"
      let () =
        putStrLn
          "keygen: wrote session-token secret secrets/token.hex (mode 0600)"
      Ok ()
