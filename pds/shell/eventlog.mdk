{- | The durable firehose event log: one file per sequenced event, beneath
   `<dir>/events` (`docs/design/ATPROTO-PDS-DESIGN.md` row P12).

   On disk rather than in memory so a process restart does not invalidate a
   connected relay's cursor, and one file per entry rather than one growing
   file because that is what makes both ends cheap: an append creates a file
   whose name it already knows, and truncation unlinks files whose names
   already say they are too old. Neither operation reads, rewrites, or even
   lists what the log already holds, so neither costs what the log currently
   holds — the whole-set rewrite #2692 measured is the shape this is built to
   avoid. The one linear step is the retention sweep, which runs once every
   `eventLogSweepInterval` appends rather than on each one.

   APPENDING IS TWO PHASES, and the split is the whole point. An event and the
   commit it announces must land together or not at all, and the only atomic
   step this tree has is `rename` (`pds/shell/persist.mdk`, whose barrier
   discipline this module also follows: every staged file is `fsync`ed before
   the `rename` that publishes it and the containing directory after, so a
   promotion cannot reach disk ahead of the entry it promotes; and a directory
   this module creates is barriered into the directory `mkdirAll` wrote its
   dentry into, since an entry directory whose own entry a crash loses takes
   every event promoted into it). Unlike the two stores next door, the log
   barriers its OWN top directory into the data directory rather than leaving
   that to a persist call: those two are written only through
   `persistTransition`, which always runs a repo half after them, while an
   event announcing no repository mutation is appended with no commit beside
   it at all. Only a creation owes a directory barrier either way, so an
   append over a log already on disk pays nothing for one. So a caller
   STAGES the entry, persists the commit, and then
   PROMOTES it, and every crash point in that sequence is recoverable from
   what survives:

   - before the stage lands: no commit, no event.
   - after the stage, before the commit: the staged entry anchors to a head
     the repository does not have, and recovery drops it.
   - after the commit, before or during the promote: the staged entry anchors
     to the head on disk, and recovery finishes the promotion.

   An entry that anchors to nothing is always finished; `eventLogEntryOwed`
   (`lib.event_log_record`) carries that rule and the obligation it puts on
   whoever stages one.

   Promotion is idempotent, which is what makes that last case safe to
   re-run: an entry's file name is a function of the entry, so writing it
   twice writes the same bytes to the same path.

   RECOVERY IS ITSELF TWO PHASES, for a reason that is `pds/serve.mdk`'s and
   not this module's: deciding what is owed can REFUSE a startup, and
   discharging it MUTATES the log. A refusal must reach the operator before
   any generated secret touches disk (#2659), and a mutation must not happen
   on a run that goes on to refuse (#2906) — two demands one call cannot
   satisfy. `eventLogPlanRecovery` answers the first and writes nothing;
   `eventLogApplyRecovery` performs the second and decides nothing. The pair
   is `planCredential`/`establishCredential`'s shape, for the same reason.

   This module is an effectful shell (P14): it holds no protocol state, and
   its signatures carry no `Repo` and no `SecretKey`. -}

import fs.{isDir, mkdirAll}
import list.{reverse}
import string.{toInt}
import lib.event_log_record.{
  EventLogEntry(..),
  eventLogAfterCursor,
  eventLogDecodeEntry,
  eventLogEncodeEntry,
  eventLogEntryName,
  eventLogEntryOwed,
  eventLogFirstSeq,
  eventLogNextSeq,
  eventLogParseEntryName,
  eventLogPartitionExpired,
  eventLogSweepsAt,
}

-- | The log directory beneath a data directory.
export
eventLogDir : String -> String
eventLogDir dir = "\{dir}/events"

-- Entries are promoted out of this directory, and the two pointer files sit
-- beside it, so a listing of the log directory is not simply its entries.
stagingName : String
stagingName = ".staging"

stagedName : String
stagedName = ".staged"

lastName : String
lastName = ".last"

entriesDir : String -> String
entriesDir dir = "\{eventLogDir dir}/entries"

stagedPath : String -> String
stagedPath dir = "\{eventLogDir dir}/\{stagedName}"

lastPath : String -> String
lastPath dir = "\{eventLogDir dir}/\{lastName}"

stagingDir : String -> String
stagingDir dir = "\{eventLogDir dir}/\{stagingName}"

-- The log directory itself, created if it is not there, with the dentry that
-- created barriered into the data directory. See the header for why the log
-- owns this one where the two stores next door leave theirs to a persist
-- call.
ensureLogDir : String -> <FileRead "_", FileWrite "_"> Result String Unit
ensureLogDir dir =
  if fileExists (eventLogDir dir) then
    Ok ()
  else do
    () <- mkdirAll (eventLogDir dir)
    fsync dir

-- One directory beneath the log — `entries` or `.staging` — created if it is
-- not there, with the dentry that created barriered into the log directory.
ensureUnderLog : String ->
  String ->
  <FileRead "_", FileWrite "_"> Result String Unit
ensureUnderLog dir path = do
  () <- ensureLogDir dir
  if fileExists path then
    Ok ()
  else do
    () <- mkdirAll path
    fsync (eventLogDir dir)

-- Write a small pointer file the way `persist.mdk` writes the head pointer:
-- into the staging directory, then promoted with `rename`, so a reader never
-- observes a half-written one.
promoteText : String ->
  String ->
  String ->
  <FileRead "_", FileWrite "_"> Result String Unit
promoteText dir name text = do
  () <- ensureUnderLog dir (stagingDir dir)
  let staged = "\{stagingDir dir}/\{name}"
  () <- writeFile staged text
  () <- fsync staged
  () <- rename staged "\{eventLogDir dir}/\{name}"
  fsync (eventLogDir dir)

{- | The sequence number of the last PROMOTED entry, or `None` when this
   repository has emitted no event yet.

   Read from its own small pointer file rather than by inspecting the entry
   directory, so assigning the next sequence number costs one file read
   however many entries the log holds.

   The number alone: the pointer used to carry the promoted entry's commit CID
   beside it, which no reader ever consulted and which an entry announcing no
   commit has nothing to put there. -}
export
eventLogLast : String -> <FileRead "_"> Result String (Option Int)
eventLogLast dir =
  if not (fileExists (lastPath dir)) then
    Ok None
  else match readFile (lastPath dir)
    Err message => Err "eventlog: unreadable last-entry pointer: \{message}"
    Ok text => match toInt text
      Some seq => Ok (Some seq)
      None =>
        Err "eventlog: last-entry pointer is not a sequence number: \{text}"

{- | The sequence number the next emitted event takes.

   Derived from what is on disk, so it survives a restart: the in-memory
   server holds no counter to lose. -}
export
eventLogNextSequence : String -> <FileRead "_"> Result String Int
eventLogNextSequence dir = match eventLogLast dir
  Err message => Err message
  Ok None => Ok eventLogFirstSeq
  Ok (Some seq) => Ok (eventLogNextSeq seq)

{- | Record an entry as pending, before the commit it announces is persisted.

   A stage that lands over an earlier pending entry is correct rather than a
   loss: the earlier one's commit did not persist (a promotion removes what it
   promoted), so it was owed to nobody. -}
export
eventLogStage : String ->
  EventLogEntry ->
  <FileRead "_", FileWrite "_"> Result String Unit
eventLogStage dir entry = promoteText dir stagedName (eventLogEncodeEntry entry)

-- | Forget a pending entry whose commit did not persist.
export
eventLogDiscardStaged : String ->
  <FileRead "_", FileWrite "_"> Result String Unit
eventLogDiscardStaged dir =
  if fileExists (stagedPath dir) then removeFile (stagedPath dir) else Ok ()

-- | The pending entry, if there is one.
export
eventLogStaged : String -> <FileRead "_"> Result String (Option EventLogEntry)
eventLogStaged dir =
  if not (fileExists (stagedPath dir)) then
    Ok None
  else match readFile (stagedPath dir)
    Err message => Err "eventlog: unreadable staged entry: \{message}"
    Ok text => map Some (eventLogDecodeEntry text)

-- Write one entry's own file. Its name is a function of the entry, so a
-- repeated promotion overwrites the same path with the same bytes and no
-- duplicate can be created.
writeEntry : String ->
  EventLogEntry ->
  <FileRead "_", FileWrite "_"> Result String Unit
writeEntry dir entry = do
  () <- ensureUnderLog dir (entriesDir dir)
  () <- ensureUnderLog dir (stagingDir dir)
  let name = eventLogEntryName entry.seq entry.timeSeconds
  let staged = "\{stagingDir dir}/\{name}"
  () <- writeFile staged (eventLogEncodeEntry entry)
  () <- fsync staged
  () <- rename staged "\{entriesDir dir}/\{name}"
  fsync (entriesDir dir)

{- | Promote the pending entry, if there is one, and sweep the window.

   Ordered entry file, then pointer, then the removal of the staged copy, so
   that a crash anywhere in it leaves the staged copy behind and the whole
   sequence runs again — each step idempotent. Doing it the other way round
   would let a crash between the pointer and the entry publish a sequence
   number nothing backs.

   The sweep runs only on every `eventLogSweepInterval`-th entry: it lists the
   live log, which is linear in it, and an append must not be. -}
export
eventLogPromote : String ->
  Int ->
  Int ->
  <FileRead "_", FileWrite "_"> Result String Unit
eventLogPromote dir retentionSeconds nowSeconds = match eventLogStaged dir
  Err message => Err message
  Ok None => Ok ()
  Ok (Some entry) => promoteEntry dir retentionSeconds nowSeconds entry

promoteEntry : String ->
  Int ->
  Int ->
  EventLogEntry ->
  <FileRead "_", FileWrite "_"> Result String Unit
promoteEntry dir retentionSeconds nowSeconds entry = do
  () <- writeEntry dir entry
  () <- promoteText dir lastName (intToString entry.seq)
  () <- removeFile (stagedPath dir)
  sweepIfDue dir retentionSeconds nowSeconds entry.seq

sweepIfDue : String ->
  Int ->
  Int ->
  Int ->
  <FileRead "_", FileWrite "_"> Result String Unit
sweepIfDue dir retentionSeconds nowSeconds seq =
  if not (eventLogSweepsAt seq) then
    Ok ()
  else
    map (_ => ()) (eventLogSweep dir retentionSeconds nowSeconds)

-- | What a previous process left the log owing: nothing, a promotion to
-- finish, or a pending entry to drop.
public export data EventLogRecovery =
  | EventLogSettled
  | EventLogOwed
  | EventLogOrphaned

{- | What a pending entry left by a previous process still owes, against the
   head that repository actually persisted — decided, and nothing written.

   `headCommitCid` is `None` for a data directory with no repository yet,
   where no anchored entry can be owed. The rule itself is
   `eventLogEntryOwed`'s, in `lib.event_log_record`, so that what recovery
   DECIDES is gradeable without a data directory and separately from what it
   PERFORMS. -}
export
eventLogPlanRecovery : String ->
  Option String ->
  <FileRead "_"> Result String EventLogRecovery
eventLogPlanRecovery dir headCommitCid = match eventLogStaged dir
  Err message => Err message
  Ok None => Ok EventLogSettled
  Ok (Some entry) =>
    if eventLogEntryOwed headCommitCid entry then
      Ok EventLogOwed
    else
      Ok EventLogOrphaned

-- | Discharge what `eventLogPlanRecovery` decided. Every arm is idempotent, so
-- a crash inside this one leaves the next start the same plan.
export
eventLogApplyRecovery : String ->
  EventLogRecovery ->
  Int ->
  Int ->
  <FileRead "_", FileWrite "_"> Result String Unit
eventLogApplyRecovery _ EventLogSettled _ _ = Ok ()
eventLogApplyRecovery dir EventLogOwed retentionSeconds nowSeconds =
  eventLogPromote dir retentionSeconds nowSeconds
eventLogApplyRecovery dir EventLogOrphaned _ _ = eventLogDiscardStaged dir

-- Every file left behind under `<dir>/events/.staging` by a process that
-- crashed between staging a file and its `rename`. `.staging` holds only
-- leaf files in every caller of `promoteText`/`writeEntry` — an entry file,
-- or the `.staged`/`.last` pointer, never a subdirectory — but this sweep
-- also tolerates residue it did not write — a stray subdirectory is skipped
-- rather than passed to `removeFile`, which fails on a directory.
removeStagingResidue : String ->
  List String ->
  <FileRead "_", FileWrite "_"> Result String Unit
removeStagingResidue _ [] = Ok ()
removeStagingResidue dir (name :: rest) = match isDir "\{dir}/\{name}"
  Ok True => removeStagingResidue dir rest
  _ => match removeFile "\{dir}/\{name}"
    Err message =>
      Err "eventlog: \{dir}/\{name}: undeletable staging residue: \{message}"
    Ok () => removeStagingResidue dir rest

{- | Remove every file staged beneath `<dir>/events/.staging` and never
   promoted or cleaned up — the residue a crash between staging an entry or a
   pointer file and its `rename` leaves behind. Nothing else in this module
   ever removes from `.staging`, so this is the only place stale entries go
   away.

   Meant to be called once, at startup, before the listener binds
   (`pds/serve.mdk`'s `configure`): that is the only window in which a file
   under `.staging` unambiguously means residue from a prior crash rather
   than a promotion this process has in flight. A data directory that has
   never staged an entry reads as nothing to sweep, not as a failure. -}
export
eventLogSweepStaging : String ->
  <FileRead "_", FileWrite "_"> Result String Unit
eventLogSweepStaging dir =
  let staging = stagingDir dir
  if not (fileExists staging) then
    Ok ()
  else match listDir staging
    Err message =>
      Err "eventlog: \{staging}: unreadable staging directory: \{message}"
    Ok names => removeStagingResidue staging names

entryRows : String ->
  List String ->
  List (Int, Int, String) ->
  Result String (List (Int, Int, String))
entryRows _ [] acc = Ok (reverse acc)
entryRows entries (name :: rest) acc = match eventLogParseEntryName name
  Err message =>
    Err
      "\{message}, found in \{entries}. That directory holds promoted log entries and nothing else, and this log reports a name it could not have written rather than reading around it. Move \{entries}/\{name} elsewhere before starting this repository again."
  Ok (seq, timeSeconds) =>
    entryRows entries rest ((seq, timeSeconds, name) :: acc)

{- Every promoted entry's name, parsed, in listing order.

   The entry directory is graded BY NAME and by nothing else — no entry is
   stat'ed and none is opened. That is not an oversight, it is the reason seq
   and time are in the name at all: `eventLogRead` answers a subscriber's
   cursor from this listing plus the entries that are actually new, and a
   `stat` per name would put the whole retention window back on every poll,
   once per subscriber. So the three dispositions of an entry nobody wrote
   are:

   - a name this log could not have written, whatever the entry is, is
     REFUSED here (`lib.event_log_record`'s `eventLogParseEntryName` carries
     that stance and its reason); a stray plain file and a stray directory
     are the same answer, because only the name was consulted.
   - an entry whose name IS one this log could have written but which is not
     a readable entry file is refused by `readRows`, when it is opened.

   Never skipped, either way: this log's directory listing IS its index, so an
   entry routed around is a hole in a stream a subscriber cannot detect. The
   two stores next door (`pds/shell/blockfile.mdk`, `pds/shell/blobfile.mdk`)
   skip residue instead, and the difference is deliberate — a block or a blob
   is content-addressed and independently verified downstream, so a skipped
   one cannot become a wrong answer, while a missing event silently becomes
   one. -}
listEntryRows : String -> <FileRead "_"> Result String (List (Int, Int, String))
listEntryRows dir =
  if not (fileExists (entriesDir dir)) then
    Ok []
  else match listDir (entriesDir dir)
    Err message =>
      Err "eventlog: \{entriesDir dir}: unreadable entry directory: \{message}"
    Ok names => entryRows (entriesDir dir) names []

{- | Whether the log holds any promoted entry at all.

   Answered by listing the entries rather than by reading the last-promoted
   pointer, which is the whole of its use: it is the one question
   `eventLogLast` cannot answer, because a caller asking it is checking that
   pointer against what the log actually holds. A log directory that does not
   exist yet reads as empty, the same way `listEntryRows` reads it — and, the
   same way, an entry directory holding a name this log could not have written
   is an error here rather than a count.

   Linear in the live log, so it belongs at startup and not on an append. -}
export
eventLogHasEntries : String -> <FileRead "_"> Result String Bool
eventLogHasEntries dir = match listEntryRows dir
  Err message => Err message
  Ok [] => Ok False
  Ok _ => Ok True

dropRows : String ->
  List (Int, Int, String) ->
  Int ->
  <FileWrite "_"> Result String Int
dropRows _ [] dropped = Ok dropped
dropRows dir ((_, _, name) :: rest) dropped =
  match removeFile "\{entriesDir dir}/\{name}"
    Err message =>
      Err
        "eventlog: \{entriesDir dir}/\{name}: undeletable expired entry: \{message}"
    Ok () => dropRows dir rest (dropped + 1)

{- | Drop every entry the retention window no longer admits, and answer how
   many left. An entry's timestamp is in its file name, so deciding this opens
   nothing. -}
export
eventLogSweep : String ->
  Int ->
  Int ->
  <FileRead "_", FileWrite "_"> Result String Int
eventLogSweep dir retentionSeconds nowSeconds = match listEntryRows dir
  Err message => Err message
  Ok rows =>
    let (expired, _) = eventLogPartitionExpired retentionSeconds nowSeconds rows
    dropRows dir expired 0

readRows : String ->
  List (Int, Int, String) ->
  List EventLogEntry ->
  <FileRead "_"> Result String (List EventLogEntry)
readRows _ [] acc = Ok (reverse acc)
readRows dir ((seq, timeSeconds, name) :: rest) acc =
  match readFile "\{entriesDir dir}/\{name}"
    -- Where an entry whose NAME this log could have written, but which is not
    -- an entry file at all — a directory spelling a seq-time pair — is
    -- refused. `listEntryRows` graded the name and deliberately did not stat
    -- it; this is the open that finds out.
    Err message =>
      Err "eventlog: \{entriesDir dir}/\{name}: unreadable entry: \{message}"
    Ok text => match eventLogDecodeEntry text
      Err message => Err message
      Ok entry =>
        if entry.seq /= seq || entry.timeSeconds /= timeSeconds then
          Err
            "eventlog: entry \{name} contains sequence \{intToString entry.seq} at \{intToString entry.timeSeconds}"
        else
          readRows dir rest (entry :: acc)

{- | Every live entry after `cursor`, in sequence order — what a subscriber
   holding that cursor has not been sent.

   Each entry's file name is checked against its contents rather than trusted:
   the name decides which files are read, so a name and a body that disagree
   would silently answer a cursor with the wrong events.

   The cursor is applied to the NAMES before any file is opened, and that is
   what makes this usable by a connected subscriber rather than only by a
   fresh one: a sequence number is in every entry's file name, so answering
   "what is new since 4000" costs one directory listing plus the entries that
   are actually new, not one file read per entry the window still holds. A
   subscriber polling a three-day log would otherwise re-read the whole of it
   on every tick, once per subscriber. The answer is unchanged either way —
   `eventLogAfterCursor` still fixes what a cursor MEANS, and it is applied to
   the decoded entries as before. -}
export
eventLogRead : String ->
  Int ->
  <FileRead "_"> Result String (List EventLogEntry)
eventLogRead dir cursor = match listEntryRows dir
  Err message => Err message
  Ok rows =>
    map
      (eventLogAfterCursor cursor)
      (readRows dir (filter (row => rowSeq row > cursor) rows) [])

rowSeq : (Int, Int, String) -> Int
rowSeq (seq, _, _) = seq
