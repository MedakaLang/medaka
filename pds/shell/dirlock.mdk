{- | A single-writer lock over a PDS data directory.

   Two `pdsd` processes pointed at one `--data` directory destroy each other's
   work. Each one's startup sweep deletes every file under `.staging`
   (`shell.blockfile`, `shell.blobfile`, `shell.eventlog`), and those sweeps
   are correct only while nothing else is mid-promotion: a file under
   `.staging` means residue from a prior crash exactly when no other process
   is between a write and its `rename`. Nothing in the on-disk layout made
   that true, so this module does.

   The lock is a DIRECTORY, because `makeDir` is `mkdir(2)`: creating one is
   atomic and the second creation fails with `EEXIST` rather than succeeding
   twice, which is the whole primitive a lock needs and the reason this costs
   no new host call. What `mkdir` does not give is release on death — a killed
   process leaves its directory behind — so the holder writes a HEARTBEAT into
   the lock and a contender grades the heartbeat rather than the lock's
   existence. A lock whose heartbeat moves is held; one whose heartbeat has
   not moved for `lockStaleAfterMillis` is held by nobody, and the contender
   takes it over. A live holder is therefore detected in about one beat, so an
   operator who starts a second server gets the refusal immediately; a dead
   holder costs the next start the stale window, once.

   Two limits an operator should know, both real:

   - `EEXIST` is recognized by matching the host's error STRING, because the
     file primitives return no typed errno. `stdlib/fs`'s `mkdirAll` already
     turns on the same distinction.
   - The window is a bet that a live server writes a twenty-byte file at least
     once every `lockStaleAfterMillis`. A holder stalled longer than that can
     have its lock reclaimed under it. `--force-lock` covers the other
     direction — taking a lock immediately rather than waiting the window out
     — and is the only way past a lock whose owner file cannot be read at
     all. -}

import string.{contains, toInt, trim}
import time.{Duration, millis, now, sleep}

{- | The lock this process holds: proof that `acquireDataLock` returned, and
   the data directory whose heartbeat this process now owes. The constructor
   is not exported, so a value of this type cannot be minted by a caller that
   never took the lock. -}
export data DataLock = DataLock String

{- | How often the holder must refresh its heartbeat. `pds/serve.mdk` spawns
   the loop that does it, beside the loop that emits the stats line. -}
export
lockBeatInterval : Duration
lockBeatInterval = millis 500

-- A heartbeat that has not moved for this long belongs to no live process.
-- Six beats rather than two: the margin is against a scheduler that is busy,
-- not against one that is gone.
lockStaleAfterMillis : Int
lockStaleAfterMillis = 3000

-- How often a contender re-reads the holder's heartbeat while waiting the
-- window out. It bounds how long a REFUSAL takes, not how long a takeover
-- does, so it is short.
lockPollMillis : Int
lockPollMillis = 100

-- | The lock directory beneath a data directory.
export
dataLockPath : String -> String
dataLockPath dir = "\{dir}/.lock"

ownerName : String
ownerName = "owner"

ownerPath : String -> String
ownerPath dir = "\{dataLockPath dir}/\{ownerName}"

-- Where a takeover moves an abandoned lock before creating its own. Beside
-- the lock rather than inside it, so that moving it aside is one `rename`.
stalePath : String -> String
stalePath dir = "\{dir}/.lock.stale"

staleOwnerPath : String -> String
staleOwnerPath dir = "\{stalePath dir}/\{ownerName}"

nowMillis : Unit -> <Clock> Int
nowMillis u = floatToInt (now u * 1000.0)

-- The heartbeat is written and NOT `fsync`ed, unlike every other write this
-- server makes. It is liveness and not durability: a beat that survived a
-- power cut would be a beat on behalf of a process the power cut killed.
writeBeat : String -> <Clock, FileWrite "_"> Result String Unit
writeBeat dir = writeFile (ownerPath dir) "\{intToString (nowMillis ())}\n"

{- | Refresh this process's claim on the directory it locked. A holder that
   stops calling this has, as far as the next process to start is concerned,
   stopped running. -}
export
refreshDataLock : DataLock -> <Clock, FileWrite "_"> Result String Unit
refreshDataLock (DataLock dir) = writeBeat dir

-- The holder's heartbeat file as raw text, with every failure to read it
-- reported as the empty string. A lock directory with no readable owner file
-- is a half-created one, and a contender waits it out exactly as it waits out
-- one whose beat has stopped — the two are the same claim, that nothing is
-- writing here.
ownerText : String -> <FileRead "_"> String
ownerText dir =
  if not (fileExists (ownerPath dir)) then
    ""
  else match readFile (ownerPath dir)
    Err _ => ""
    Ok text => text

-- Whether the holder's heartbeat moves at all within `remaining`
-- milliseconds. It returns the moment it does, which is what makes a refusal
-- cost one beat and not the whole window.
beatMoves : String -> String -> Int -> <Clock, FileRead "_"> Bool
beatMoves dir seen remaining =
  if remaining <= 0 then
    False
  else
    let () = sleep (millis lockPollMillis)
    if ownerText dir /= seen then
      True
    else
      beatMoves dir seen (remaining - lockPollMillis)

-- How long ago the recorded holder last beat, for the refusal. An owner file
-- that does not parse says so rather than reporting a number derived from
-- nothing.
beatAge : String -> Int -> String
beatAge text nowMs = match toInt (trim text)
  None => "at a time this file does not record"
  Some beatMs => "\{intToString ((nowMs - beatMs) / 1000)}s ago"

-- Drop a `.lock.stale` left beside the lock: this process's own, a moment
-- after it moved one aside, or one left by a takeover that died halfway
-- through. A failure here is reported and refuses the run rather than being
-- swallowed — an undeletable `.lock.stale` is a directory this process cannot
-- write, which is the one thing a lock must not assume it can.
discardStale : String -> <FileRead "_", FileWrite "_"> Result String Unit
discardStale dir =
  if not (fileExists (stalePath dir)) then
    Ok ()
  else do
    () <- if fileExists (staleOwnerPath dir) then
      removeFile (staleOwnerPath dir)
    else
      Ok ()
    removeDir (stalePath dir)

{- | Take a lock whose holder is no longer beating.

   The takeover moves the abandoned lock aside with `rename` rather than
   deleting it in place, and `rename` is what makes the takeover safe against
   a second contender that reached the same verdict in the same window:
   exactly one of them moves the directory, and the other finds nothing to
   move and refuses. A remove-then-create pair has no such ordering — the
   second contender's remove can delete the first one's FRESH lock. -}
takeOver : String -> <Clock, FileRead "_", FileWrite "_"> Result String DataLock
takeOver dir = do
  () <- discardStale dir
  () <- match rename (dataLockPath dir) (stalePath dir)
    Err message => Err (lostRaceMessage dir message)
    Ok () => Ok ()
  () <- discardStale dir
  () <- match makeDir (dataLockPath dir)
    Err message => Err (lostRaceMessage dir message)
    Ok () => Ok ()
  () <- writeBeat dir
  Ok (DataLock dir)

lostRaceMessage : String -> String -> String
lostRaceMessage dir message =
  "data directory \{dir}: another process took \{dataLockPath dir} first (\{message}); start this server again once that one has settled"

heldMessage : String -> <Clock, FileRead "_"> String
heldMessage dir =
  "data directory \{dir} is already locked by a running server (\{dataLockPath dir}, last heartbeat \{beatAge (ownerText dir) (nowMillis ())}). Two servers over one data directory delete each other's staged writes, so this run refuses before reading or writing anything beneath it. Stop the running server, or pass --force-lock if you are certain it is gone."

-- A lock that exists and is being beaten refuses; one that exists and is not
-- is taken over. The verdict costs a beat in the first case and the window in
-- the second, and nothing can distinguish the two faster than the holder
-- itself reports.
contend : String ->
  <Clock, FileRead "_", FileWrite "_"> Result String (DataLock, String)
contend dir =
  let seen = ownerText dir
  if beatMoves dir seen lockStaleAfterMillis then
    Err (heldMessage dir)
  else
    map
      (lock => (
        lock,
        "reclaimed after \{intToString (lockStaleAfterMillis / 1000)}s with no heartbeat from the previous holder",
      ))
      (takeOver dir)

{- | Take the data directory's single-writer lock, or refuse the run.

   `force` is `--force-lock`: take the lock without waiting the stale window
   out. It is the operator asserting that the recorded holder is gone — after
   a power cut, or over a lock that came back in a backup — and it is the only
   way past a lock whose owner file cannot be read at all.

   The second half of the result is what taking it took, for the startup line.
   A start that adopted a lock another process left behind must say so,
   because that is also what a start which STOLE one from a stalled holder
   would look like, and only the operator can tell those apart afterwards. -}
export
acquireDataLock : Bool ->
  String ->
  <Clock, FileRead "_", FileWrite "_"> Result String (DataLock, String)
acquireDataLock force dir = match makeDir (dataLockPath dir)
  Ok () => do
    () <- writeBeat dir
    Ok (DataLock dir, "acquired")
  Err message =>
    if not (contains "exists" message) then
      Err "data directory \{dir}: cannot create \{dataLockPath dir}: \{message}"
    else if force then
      map (lock => (lock, "taken with --force-lock")) (takeOver dir)
    else
      contend dir
