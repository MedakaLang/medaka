-- ── timeouts, ceilings and the listener ─────────────────────────────────────

{- | How long a connection in the BODY phase may go without delivering a new
   byte before it is closed (#2815).

   A PROGRESS budget, not a phase deadline: every read that delivers bytes
   starts it again, so an upload that keeps arriving is never closed on it
   however long it takes in total — `requestTimeout` is what bounds that. What
   it does close is the one shape nothing else bounded: a peer that terminates
   its headers, declares a `Content-Length`, and then sends nothing. That peer
   has left the un-framed census (`maxUnframedConnections`) behind, so the only
   budget left over it was the whole request's, and it held one of
   `maxConcurrentConnections` for the whole of that while delivering nothing.

   It is the body phase's per-read silence bound as well as its progress bound,
   and those are one question asked once rather than two: `recvWithin` parks
   until either bytes arrive or the budget passes, so a read that returns bytes
   restarts the budget and a read that returns nothing has consumed all of it.

   Deliberately its own constant rather than `headerTimeout`, whose value it
   coincides with: a header section is capped at `maxHttpHeaderBytes` while a
   body may carry megabytes, so the two answer different questions and diverge
   the moment either is tuned. -}
bodyProgressTimeout : Duration
bodyProgressTimeout = seconds 5

-- | How long one request may take to arrive in full, however many reads it
-- takes. Reset for each request on a kept-alive connection.
requestTimeout : Duration
requestTimeout = seconds 60

-- | Default for how often `statsLoop` samples and emits the process-wide
-- stats line, when `pds/serve.mdk`'s `--stats-interval-ms` is not given.
-- Exported so `serve.mdk`'s flag default and this default cannot drift apart.
export
defaultStatsInterval : Duration
defaultStatsInterval = seconds 60

-- | How long writing one response may take before the connection is closed.
writeTimeout : Duration
writeTimeout = seconds 30

-- | Bytes asked for per read. The buffer grows by what actually arrives.
readChunkBytes : Int
readChunkBytes = 65536

-- | How long one read of a refused connection's leftover body waits before
-- `drainRefused` gives up on it. Short: every read that finds bytes returns
-- at once, so this is only ever spent once, on the read that finds the queue
-- empty and ends the drain.
lingerDrainWait : Duration
lingerDrainWait = millis 250

-- | How many such reads a refusal is willing to spend, which at
-- `readChunkBytes` each is eight mebibytes — past any socket receive queue,
-- and bounded work for a peer that keeps sending.
lingerDrainReads : Int
lingerDrainReads = 128

{- | How many bytes of OS entropy each request is given.

   It identifies any token the request mints (`RequestContext`'s `nonce`,
   `lib.server_core`), so it is drawn from `osEntropyBytes` and never from
   `randomInt`, whose generator is a seeded SplitMix64 and predictable by
   construction. Sixteen bytes is the usual floor for a value an attacker must
   not be able to guess ahead of time.

   It is ALSO the salt a login's credential rehash is derived under
   (`applyCreateSession`, `pds/lib/handlers.mdk`), which is the only entropy a
   pure handler has, so the length is `lib.credential`'s `saltBytes` rather
   than its own sixteen: a nonce of some other length would make every rehash
   fail its salt admission and leave the credential silently unupgraded. -}
requestNonceBytes : Int
requestNonceBytes = saltBytes

{- | How many connections may be in flight at once. An accepted connection past
   the ceiling is closed immediately, without a read: answering it would need
   the very socket work the ceiling exists to bound. -}
maxConcurrentConnections : Int
maxConcurrentConnections = 256

{- | How many UN-FRAMED connections may be in flight at once (#2772) — a
   connection whose current request's header section has not been terminated
   yet, which is the state a caller can hold open while doing nothing and
   costing nothing.

   `maxConcurrentConnections` alone does not bound it: a caller that opens
   every slot and never terminates a header holds all 256 for as long as the
   read and request budgets allow, and every other caller is closed at accept
   for the whole of that. So this ceiling is deliberately a small fraction of
   that one. The un-framed state is not where a healthy connection spends any
   measurable time — a client that has sent a request has sent its headers
   with it.

   This ceiling does NOT bound an attacker without bounding legitimate
   concurrency (#2816): it is an admission gate ahead of
   `maxConcurrentConnections`, not a carved-out share of it, so once 64
   connections sit un-framed the 65th is refused regardless of how much of
   the 256 is free — legitimate callers included. An un-framed connection
   reaches no rate-limit class, so a single reconnecting source can hold the
   gate shut indefinitely at no cost to itself. Closing that gap needs a
   ceiling that distinguishes sources, which this one does not; see #2816.

   The charge is global rather than per-caller because no peer identity
   exists before headers: `accept` yields a `Connection` and the runtime has
   no `getpeername`, and `X-Forwarded-For` needs a parsed request. -}
maxUnframedConnections : Int
maxUnframedConnections = 64

{- | How many event-stream subscriptions may be open at once.

   A subscription is the one connection on this server with NO total lifetime
   bound at all: `requestTimeout` and `headerTimeout` are armed per request by
   `connectionLoop`, which an upgraded connection never re-enters, and that is
   correct — "how long may one request take to arrive" is not a question a
   firehose asks. What that leaves is a connection an attacker can open, hold
   silently, and pay nothing further for: it is charged `ConnectionsClass`
   once at open (`baseClasses`) and then costs no traffic, no CPU and no
   further allowance for the rest of its life.

   Without a ceiling of its own that is a denial strictly CHEAPER than the one
   #2816 already documents, on both of #2816's own axes: #2816's un-framed
   flood needs a continuous reconnect stream and reopens within
   `headerTimeout` once it stops, whereas held subscriptions need no further
   bytes and never reopen — and 256 of them would exhaust
   `maxConcurrentConnections` outright, closing this server to every route
   rather than to un-framed callers alone.

   So this ceiling is a small fraction of `maxConcurrentConnections` rather
   than a share of it: with 32 held, seven eighths of the connection census is
   still there for ordinary request/response traffic, and an attacker holding
   all 32 has denied subscriptions alone. Thirty-two is generous for what a
   real PDS serving ONE account needs — its subscribers are the handful of
   relays mirroring it, not its readers. Like every ceiling above it, an
   attempt past it is refused with a cheap answer rather than admitted and
   then dropped: an over-ceiling subscriber is told 503 over ordinary HTTP and
   never reaches the upgrade, so it costs this server one response and
   nothing ongoing. -}
maxConcurrentSubscriptions : Int
maxConcurrentSubscriptions = 32

{- | How many proxied reads may be in flight at once.

   The ceiling this one backs up is `maxHttpClientWireBytes`
   (`pds/lib/resource_limits.mdk`), which bounds ONE upstream response's
   accumulating buffer at about six megabytes. That bound is in LOGICAL bytes
   and the buffer holding them is a `Vector Int` — one tagged 64-bit word per
   byte, plus the doubling slack the vector carries — so one in-flight call
   costs resident memory an order of magnitude above its logical ceiling, and
   until this ceiling existed nothing bounded how many calls paid it at once:
   `maxConcurrentConnections` admits 256, and 256 of them exceed the memory of
   any box this server runs on. What that costs is not the caller's request —
   it is the process, and with it every account's connections and every open
   subscription.

   Eight is how many of those buffers this process will hold, and NOT a guess
   at what a client asks for: the official client's cold start was measured
   issuing ten proxied reads at once (#3100), so a caller past this number is
   ordinary rather than abusive. What it is not is free, which is why the call
   past the eighth waits in `maxQueuedProxiedCalls` for a slot instead of
   either being admitted or refused outright.

   It bounds CONCURRENCY, and `ProxyClass` (`pds/lib/ratelimit.mdk`) bounds
   RATE; neither substitutes for the other, because a caller well within its
   rate allowance still has all eight outstanding the moment the upstream is
   slow. A buffer representation that packed bytes as bytes would lower the
   per-call cost without removing the need for a ceiling on the count, which
   is why this is a ceiling rather than a stopgap. -}
maxConcurrentProxiedCalls : Int
maxConcurrentProxiedCalls = 8

{- | How many proxied reads may wait for a slot before one is refused.

   A caller past `maxConcurrentProxiedCalls` is not over the resource that
   ceiling protects; it is early. One official client's cold start peaks at ten
   concurrent proxied reads (#3100, measured over the live access log: 302
   calls, median 563 ms, nine arriving while eight were already in flight), so
   a bare ceiling of eight refuses part of a healthy app's first screen against
   a server with nothing wrong with it. A legitimate burst should become
   latency; only genuine overload should still be refused.

   Sixteen is twice the ceiling, which is a bound on LATENCY rather than on
   memory: a call admitted at the back of a full queue waits two service
   rounds, and at the measured p90 of 697 ms per proxied read that is under a
   second and a half — inside `proxyQueueWait` with margin. A waiter costs one
   parked task and the inbound connection it already charged to
   `maxConcurrentConnections`; it holds none of the response buffer the ceiling
   exists to bound, because it has made no outbound call at all.

   Raising the ceiling instead was considered and refused: the ceiling is one
   number for the whole process while a fan-out is one client's, so a constant
   sized for one phone is wrong for two devices and wrong again for a caller
   poking at the server on purpose. Queueing keeps the memory bound at eight
   whatever the fan-out is. -}
maxQueuedProxiedCalls : Int
maxQueuedProxiedCalls = 16

{- | How long a queued proxied read waits for a slot before it is refused.

   Long enough that a legitimate queue drains inside it — sixteen waiters
   behind eight slots at the measured p90 of 697 ms is about 1.4 s — and short
   enough that the wait is spent on an answer somebody is still there for.
   Without a deadline the queue would be a refusal wearing a nicer error: the
   call would end in a client-side timeout instead, after this server had spent
   an upstream call on it.

   It is well under the outbound budgets a slot can be held for
   (`upstreamSilenceTimeout` is 5 s and `upstreamCallTimeout` 10 s,
   `pds/shell/egress.mdk`), which is what keeps a stalled upstream from turning
   the queue into a second and longer wait behind the first: waiters behind a
   stall are refused on this deadline rather than held until the stalled call
   gives its slot back. -}
proxyQueueWait : Duration
proxyQueueWait = seconds 2

{- | How many reads may wait for buffer headroom before one is refused (#2951).

   The queue behind `maxInFlightRequestBytes` (`lib.resource_limits`), and a
   count rather than a byte figure because what it bounds is the waiters
   themselves: headroom is taken BEFORE the read it is for, so a waiter is
   parked holding nothing but a task and the bytes it has already been charged
   for, and what waiting costs on top of the budget is that task alone. The
   bytes a waiter wants are not charged until it is granted them, which is
   what keeps the budget a bound on what is held rather than on what has been
   asked for.

   A quarter of `maxConcurrentConnections`, the fraction `maxUnframedConnections`
   also takes: past 64 connections stalled on headroom this process is
   saturated enough that the 65th is better told now than held, and the
   connections behind it are already bounded by the connection ceiling.

   Exported so `pds/test/read_buffer_test.mdk` can name the bound it asserts
   rather than repeating the number beside it, where the two would drift. -}
export
maxQueuedBufferedReads : Int
maxQueuedBufferedReads = 64

{- | How long a read waits for buffer headroom before it is refused (#2951).

   Headroom comes back when another connection's request is answered or its
   connection closes, so the wait is sized against the phase the waiters are
   in rather than against a round trip: five seconds is `bodyProgressTimeout`,
   the budget the body phase already gives one read, and a twelfth of
   `requestTimeout`, so a request refused on it is nowhere near its own
   deadline and a client that retries is right to.

   Refusing without waiting at all would make a transient overlap of large
   uploads indistinguishable from an attack, and closing a legitimate upload
   part way through costs the client everything it has sent. Waiting without a
   deadline would hold a connection open on headroom that a stalled peer
   elsewhere may never give back. -}
bufferQueueWait : Duration
bufferQueueWait = seconds 5

{- | How long one request's header section may take to arrive in full (#2772).

   Distinct from `requestTimeout` and far shorter: a header section is capped
   at `maxHttpHeaderBytes` and is what a client sends first, so seconds are
   generous for it, whereas a whole request may legitimately carry megabytes
   of body and needs the longer budget. Bounding both with one number gave the
   cheapest state a caller can hold — headers half sent — the budget of the
   most expensive one.

   It bounds the header phase twice over, because either alone leaves a hole:
   as the deadline `frameLoop` tests, so that a caller trickling one byte at a
   time is closed on total elapsed time; and as the per-read timeout
   `readMore` uses while the headers are unterminated, so that a caller
   sending nothing at all is closed on it rather than sitting out a whole body
   budget before any deadline is looked at. -}
headerTimeout : Duration
headerTimeout = seconds 5

{- | Bind the listening socket to the given address and port.

   `pds/serve.mdk`'s `configure` is the only caller, and it refuses to reach
   here at all for a non-loopback address unless `--trusted-proxy` is also
   set (`requireTrustedBind`) — this function itself performs no such check,
   because it cannot: a bind address is a deployment fact, not something this
   process can verify about its own socket. -}
export
bindAddress : String -> Int -> <Net "_"> Result String Listener
bindAddress addr port = listen addr port

-- ── applying a request and persisting the store ─────────────────────────────

-- This response never reaches `lib.server_core`'s `handle`, so the
-- allow-origin header every response carries is added here rather than
-- inherited.
persistFailureBytes : Array Int
persistFailureBytes =
  serializeResponse
    (withAllowOrigin
      (xrpcErrorResponse
        500
        "Internal Server Error"
        "InternalServerError"
        "Repository state could not be persisted"))

{- | Apply one framed request to the shared `Store`.

   This function is the whole reason the shell has the shape it has, and it is
   deliberately ORDINARY, non-`Async` code: read the current store, transition
   it, persist the successor, publish the successor. A scheduler can only
   interleave tasks at an `Async` bind, and there is not one in this sequence —
   `handleBytes` is pure, the clock and entropy readings handed to it are plain
   synchronous `<Clock>`/`<Rand>` calls, and `persistTransition` performs plain
   synchronous `<FileRead, FileWrite>` for both halves, not a suspension. So the four steps run
   as one indivisible unit, and two concurrent connections cannot both read the
   same store and each publish over the other's write. Wrapping the persist in
   `liftIO`, or splitting these steps across two `Async` steps, silently
   reintroduces that lost update; every caller therefore reaches this through a
   SINGLE `liftIO`.

   A persist that fails does not publish: the in-memory store and the disk stay
   the same store, and the client is told the write did not happen. -}
applyRequest : Server ->
  String ->
  Ref Store ->
  Bytes ->
  <Clock, FileRead "_", FileWrite "_", Rand, Stderr> Array Int
applyRequest server dir storeRef bytes =
  let store = !storeRef
  let nowSeconds = floatToInt (now ())
  let context = RequestContext {
    nowSeconds = nowSeconds,
    nonce = osEntropyBytes requestNonceBytes,
  }
  let (next, response) = handleBytes server context store bytes
  let did = accountDid (serverAccount server)
  match persistTransition dir did nowSeconds store next
    Err message =>
      let () = ePutStrLn "serve: persist failed, state not advanced: \{message}"
      persistFailureBytes
    Ok () =>
      let () = storeRef := next
      response

{- | Persist whichever halves of the `Store` the transition moved.

   Each half is skipped when it did not move, so a read route rewrites neither
   the block graph nor the blob area. None is an `Async` step: this runs
   inside `applyRequest`'s single indivisible sequence, and a suspension
   between any two would let a second connection publish in the gap.

   The BLOB half runs before the repo half, and the order is load-bearing for
   reference: a record may name blob bytes, never the reverse, so a crash
   between the two halves must leave at most an unreferenced blob and never a
   committed record naming bytes that are not on disk. That is the whole of
   what the order carries. It does not also carry the durability of the blob
   area's own directory entry: `shell.blobfile` barriers `<dir>/blobs` into
   `<dir>` itself, which it must, because the repo half here is skipped
   entirely on a transition that moved no commit. The other two halves
   reference nothing, are referenced by nothing, and create no directory, so
   their position is free. -}
export
persistTransition : String ->
  String ->
  Int ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistTransition dir did nowSeconds before after = do
  () <- if blobsMoved before after then
    persistBlobHalf dir before after
  else
    Ok ()
  () <- persistRepoHalf dir did nowSeconds before after
  () <- persistCredentialHalf dir before after
  () <- persistPreferencesHalf dir before after
  persistSessionsHalf dir before after

{- | Persist the open session set when the transition moved it, which the
   three session routes do: `createSession` opens one, `refreshSession`
   rotates one, `deleteSession` closes one, and each of those also drops
   whichever records had expired. Every other route leaves the set alone and
   writes nothing.

   Sessions are persisted so that a restart does not close them. A backup
   window, a version bump or a crash would otherwise log every client out and
   send it back to the password, which is what an unpersisted set costs:
   a restart refuses the refresh token too, so there is nothing for a client
   to recover with. The rows carry fingerprints rather than tokens
   (`lib.store`'s `sessionFingerprint`), so the file cannot be replayed
   against the server that wrote it. -}
persistSessionsHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistSessionsHalf dir before after =
  if storeSessionRows before == storeSessionRows after then
    Ok ()
  else
    persistSessions dir (storeSessionRows after)

{- | Persist the preference half when the transition moved it, which
   `putPreferences` does (a wholesale replace) and every other route does
   not. Comparing the two lists is exactly `persistCredentialHalf`'s shape,
   one level simpler: there is no re-derivation case to distinguish, only
   "moved" or "did not". -}
persistPreferencesHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistPreferencesHalf dir before after =
  if storePreferences before == storePreferences after then
    Ok ()
  else
    persistPreferences dir (storePreferences after)

{- | Persist the account credential when the transition moved it, which one
   route does: a login whose stored record predates today's iteration count is
   re-derived onto it (`applyCreateSession`, `pds/lib/handlers.mdk`). Every
   other request leaves the credential where it was and writes nothing.

   A rewrite that failed would not publish the successor store either, so the
   next login re-derives against the record still on disk rather than against
   one nothing can verify. -}
persistCredentialHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistCredentialHalf dir before after = match (
  storeCredential before,
  storeCredential after,
)
  (_, None) => Ok ()
  (None, Some next) => persistCredential dir next
  (Some prior, Some next) =>
    if credentialIterations prior == credentialIterations next
      && ctEq (credentialDigest prior) (credentialDigest next) then
      Ok ()
    else
      persistCredential dir next

{- | Whether this transition produced a new commit.

   One question asked once: it is both the condition under which the block
   graph is rewritten and the condition under which a firehose event exists,
   and two spellings of it could disagree — which is exactly the divergence
   "commit persisted, event missing" is made of. -}
repoAdvanced : Store -> Store -> Bool
repoAdvanced before after = match (storeRepo before, storeRepo after)
  (_, None) => False
  (None, Some _) => True
  (Some prior, Some next) => headText prior /= headText next

{- | Persist the new commit and append the event announcing it, or neither.

   The order is stage, persist, promote, and it is what makes the pair
   indivisible under a crash as well as under a failure — `shell.eventlog`'s
   header sets out each crash point. A persist that fails takes the staged
   entry back down with it, so a write the client was told did not happen
   leaves no event behind claiming it did. -}
persistRepoHalf : String ->
  String ->
  Int ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistRepoHalf dir did nowSeconds before after = match storeRepo after
  None => Ok ()
  Some next =>
    if not (repoAdvanced before after) then
      Ok ()
    else match stageCommitEvent dir did nowSeconds (storeRepo before) next
      Err message => Err message
      Ok () => match persistRepo dir next
        Err message => match eventLogDiscardStaged dir
          Err _ => Err message
          Ok () => Err message
        Ok () => eventLogPromote dir eventLogRetentionSeconds nowSeconds

-- The event for a commit, recorded as pending before the commit itself is
-- written. Its sequence number comes off disk rather than out of memory: a
-- relay's cursor has to survive this process, so the counter it indexes has
-- to as well.
stageCommitEvent : String ->
  String ->
  Int ->
  Option Repo ->
  Repo ->
  <FileRead "_", FileWrite "_"> Result String Unit
stageCommitEvent dir did nowSeconds before after = do
  seq <- eventLogNextSequence dir
  let time = formatIso (fromEpochSeconds nowSeconds)
  event <- syncCommitEventFor seq time did before after
  frame <- syncCommitFrame event
  eventLogStage dir EventLogEntry {
    seq = seq,
    timeSeconds = nowSeconds,
    anchorCommitCid = Some (headText after),
    frameHex = encode frame,
  }

{- | The four events a repository's creation emits, in the order
   `com.atproto.sync.subscribeRepos` states them: `#identity`, `#account`,
   `#commit`, `#sync`.

   A relay subscribing from cursor 0 learns the DID, the handle it answers to,
   that the account is active, and the repository's head before it sees the
   first ordinary write — which is what makes an empty repository indexable at
   all. Without them the stream begins mid-story: a `#commit` whose `since` is
   null for a DID the reader has never been told about.

   The `#commit` here is the GENESIS commit and needs no builder of its own.
   `stageCommitEvent` with no prior repository is exactly it: `since` goes
   null and `prevData` is omitted, which is what `optionalCommit None`
   (`lib.sync_event`) already means.

   Only that one anchors. The other three announce no repository mutation, so
   `eventLogEntryOwed` always owes them and there is no head that could
   contradict one — and the commit they describe is already on disk before the
   first of them is staged, so none of them can publish state a reader cannot
   fetch.

   This runs on EVERY start and not only on the one that creates the
   repository, because a start is the only place the sequence can be finished:
   `--init` refuses a directory that already holds a repository, so a process
   that died between two of the four would otherwise leave a stream that opens
   mid-story for as long as that repository lives.

   Nothing can interleave: this runs inside `configure`, before the listener
   is bound, so there is no connection through which a write could reach the
   log until all four are promoted.

   How far the sequence got is read from one pointer file, so that pointer is
   checked against the entries it indexes before any of the four is emitted
   again: a pointer that says NOTHING was ever promoted, over an entry
   directory that is not empty, describes a repository whose pointer was lost
   rather than a fresh one, and re-minting the quartet there would publish a
   second identity, account, commit and sync beside the first, which no
   subscriber can reconcile. Such a start refuses instead. -}
export
completeGenesisEvents : String ->
  String ->
  String ->
  Int ->
  Repo ->
  <FileRead "_", FileWrite "_"> Result String Unit
completeGenesisEvents dir did handle nowSeconds repo = do
  () <- requireRecoveryApplied dir
  resumeAt <- eventLogNextSequence dir
  () <- refuseLostPointer dir resumeAt
  genesisFrom resumeAt dir did handle nowSeconds repo

{- | Refuse to read the log's pointer while a pending entry is still staged.

   `refuseLostPointer` below reads the last-promoted pointer as the whole
   truth about how far the quartet got, and that reading is true only of a log
   nothing still owes. A staged entry is a promotion a previous process began
   and did not finish: its entry file may already be beside the pointer while
   the pointer still stands where it did, which is exactly the shape
   `refuseLostPointer` refuses. Applying recovery first is what removes it, so
   a caller that has not done so gets this refusal rather than a refusal
   blaming the directory.

   The check lives here, in front of the pointer read it protects, rather than
   in the caller: a precondition written into the caller moves when the two
   calls it orders are swapped, which is the one mutation it exists to
   catch. -}
requireRecoveryApplied : String -> <FileRead "_"> Result String Unit
requireRecoveryApplied dir = match eventLogStaged dir
  Err message => Err message
  Ok None => Ok ()
  Ok (Some _) =>
    Err
      "\{eventLogDir dir}: an event-log entry is still staged, so startup recovery has not run yet. The genesis events may only be completed after eventLogApplyRecovery has finished or dropped that entry — a pointer read over one describes a log mid-recovery, not a log. This is a startup ordering fault in pds/serve.mdk and not damage to this data directory."

{- | Refuse a log whose last-promoted pointer contradicts the entries beside
   it, rather than treating it as a repository that has emitted nothing.

   Checked in one direction only. A retention sweep unlinks entry files and
   leaves the pointer where it stood, so a pointer standing over an empty
   entry directory is ordinary and says nothing is wrong; the reverse — no
   pointer at all over entries that exist — is reachable by no sequence
   `shell.eventlog` writes, because a promotion writes the entry first and the
   pointer second and the staged copy it leaves behind makes the pair run
   again.

   Deciding only, like `eventLogPlanRecovery`: naming what an operator has to
   look at is the whole of the answer, because which of the two files is the
   damaged one is not something this process can know. -}
refuseLostPointer : String -> Int -> <FileRead "_"> Result String Unit
refuseLostPointer dir resumeAt =
  if resumeAt /= eventLogFirstSeq then
    Ok ()
  else match eventLogHasEntries dir
    Err message => Err message
    Ok False => Ok ()
    Ok True =>
      let log = eventLogDir dir
      Err
        "serve: \{log}: the last-promoted pointer records no promoted event, but the entry directory is not empty. Emitting the genesis events here would announce a second identity, account, commit and sync over history that already holds them. Compare \{log}/.last against \{log}/entries before starting this repository again."

{- | The genesis events from `step` onward, where `step` is the sequence
   number the next promoted event will take.

   The next sequence number IS the step number, and the log alone decides it.
   These four are the only events any repository emits before its listener is
   bound, and `eventLogNextSequence` counts what was ever PROMOTED rather than
   what is still readable — the retention sweep unlinks entry files and leaves
   the pointer where it stood. So a log whose next number is 3 holds
   `#identity` and `#account` and owes the other two, and one whose next
   number is past the fourth owes nothing, on that start and on every later
   one.

   Each step is emitted by the call that would have emitted it on a first
   start, and an already-promoted step is skipped rather than repeated:
   `emitUnanchored` and `stageCommitEvent` take a fresh sequence number every
   time they are called, so re-running step 1 would mint a fifth event rather
   than replace the first. -}
genesisFrom : Int ->
  String ->
  String ->
  String ->
  Int ->
  Repo ->
  <FileRead "_", FileWrite "_"> Result String Unit
genesisFrom 1 dir did handle nowSeconds repo = do
  let identityFrame = seq time => syncIdentityFrame seq time did handle
  () <- emitUnanchored dir nowSeconds identityFrame
  genesisFrom 2 dir did handle nowSeconds repo
genesisFrom 2 dir did handle nowSeconds repo = do
  let accountFrame = seq time => syncAccountFrame seq time did
  () <- emitUnanchored dir nowSeconds accountFrame
  genesisFrom 3 dir did handle nowSeconds repo
genesisFrom 3 dir did handle nowSeconds repo = do
  () <- stageCommitEvent dir did nowSeconds None repo
  () <- eventLogPromote dir eventLogRetentionSeconds nowSeconds
  genesisFrom 4 dir did handle nowSeconds repo
genesisFrom 4 dir did _ nowSeconds repo =
  emitUnanchored dir nowSeconds (headSyncFrame did repo)
genesisFrom _ _ _ _ _ _ = Ok ()

-- The `#sync` frame for a repository's current head: the one event that
-- states where the repository stands without describing how it got there.
headSyncFrame : String -> Repo -> Int -> String -> Result String (Array Int)
headSyncFrame did repo seq time =
  let commit = repoLatestCommit repo
  syncSyncFrame
    seq
    time
    did
    (repoCommitTid commit)
    (repoCommitCid commit)
    (repoCommitSignedBytes commit)

{- | One event that announces no repository mutation: staged and promoted with
   nothing in between, because the state it describes is already durable.

   The frame is built from the sequence number rather than before it, because
   the lexicon requires `seq` and `time` inside every event body and this log
   stores the finished bytes. The number comes off disk for the reason
   `stageCommitEvent` gives: a relay's cursor has to survive this process. -}
emitUnanchored : String ->
  Int ->
  (Int -> String -> Result String (Array Int)) ->
  <FileRead "_", FileWrite "_"> Result String Unit
emitUnanchored dir nowSeconds build = do
  seq <- eventLogNextSequence dir
  frame <- build seq (formatIso (fromEpochSeconds nowSeconds))
  () <- eventLogStage dir EventLogEntry {
    seq = seq,
    timeSeconds = nowSeconds,
    anchorCommitCid = None,
    frameHex = encode frame,
  }
  eventLogPromote dir eventLogRetentionSeconds nowSeconds

{- | Whether the blob half of the transition differs.

   Block COUNTS decide the byte half exactly: a blob's name is its content and
   `lib.store` exposes no way to remove one, so two blob halves of equal size
   hold equal blocks. The declared-type index is compared outright because it
   moves on its own — re-uploading identical bytes under a different declared
   MIME type leaves the count where it was — and `storeBlobMimeIndex` answers
   that without copying every blob's bytes, which `storeBlobEntries` would do
   on every read request. -}
blobsMoved : Store -> Store -> Bool
blobsMoved before after =
  storeSize before /= storeSize after
    || storeBlobMimeIndex before /= storeBlobMimeIndex after

{- | The type declared for a stored blob.

   The fallback is `com.atproto.sync.getBlob`'s own (`pds/lib/handlers.mdk`),
   so a blob inserted through the byte-only `storePut` — which no route uses —
   reads back after a restart as exactly what it served before one. -}
declaredMimeType : Store -> Cid -> String
declaredMimeType store cid = match storeBlobMimeType cid store
  Some declared => declared
  None => "application/octet-stream"

{- | Whether the transition owes the blob area a write for one blob: it is new
   in `after`, or its declared type is not what it was.

   A blob's name is its content and `lib.store` exposes no way to remove one,
   so a blob `before` already held under an unchanged declared type is already
   on disk under the very name a rewrite would promote it to — and rewriting
   it stages, fsyncs and renames both its files to replace them with
   themselves. -}
blobWriteOwed : Store -> Store -> Cid -> Bool
blobWriteOwed before after cid =
  not (storeHasBlob cid before)
    || storeBlobMimeType cid before /= storeBlobMimeType cid after

-- The rows `blobWriteOwed` selects, read out of `after` one at a time so that
-- only a blob actually being written has its bytes copied at all. A CID the
-- blob half lists and then cannot produce bytes for would be a torn store, so
-- it refuses the persist rather than promoting a blob file over an empty one.
blobRowsOwed : Store ->
  Store ->
  List Cid ->
  Result String (List (Cid, String, Array Int))
blobRowsOwed _ _ [] = Ok []
blobRowsOwed before after (cid :: rest) =
  if blobWriteOwed before after cid then match storeGet cid after
    None =>
      Err
        "blob \{cidToString cid} is listed by the blob half but holds no bytes"
    Some bytes => do
      tail <- blobRowsOwed before after rest
      Ok ((cid, declaredMimeType after cid, bytes) :: tail)
  else
    blobRowsOwed before after rest

-- Only the blobs the transition owes are rewritten, not the whole area: a
-- blob file's name is its content, so promoting one already on disk writes
-- the same bytes over themselves, and doing that for every blob makes one
-- upload cost the account's whole stored size.
persistBlobHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistBlobHalf dir before after = do
  rows <- blobRowsOwed before after (storeBlobCids after)
  blobFileWrite dir rows

headText : Repo -> String
headText repo = cidToString (repoCommitCid (repoLatestCommit repo))

persistRepo : String -> Repo -> <FileRead "_", FileWrite "_"> Result String Unit
persistRepo dir repo = do
  blocks <- repoExportBlocks repo
  persistSave dir (repoCommitCid (repoLatestCommit repo)) blocks

-- ── rate limiting ───────────────────────────────────────────────────────────

-- One rate-limit decision, taken against every class this request must
-- clear: `ConnectionsClass` only on a connection's first framed request (a
-- kept-alive connection is "opened" once, not once per pipelined request),
-- `RequestsClass` always, and `WritesClass`/`CreateSessionClass`/
-- `RepoExportClass` when the routed NSID is one of the write procedures,
-- `createSession`, or a whole-repository export. A refusal at an earlier
-- class in the list short-circuits: a request already being refused should
-- not also spend a later class's budget it never reached.
data RateLimitAdmission =
  | RequestAdmitted RateLimitState
  | RequestRefused RateLimitState RateLimitClass
  | RequestRefusedCapacity RateLimitState

-- | What every request that reached the framer clears, whatever it routes to
-- and whether or not it parsed.
baseClasses : Bool -> List RateLimitClass
baseClasses firstRequest =
  (if firstRequest then [ConnectionsClass] else []) ++ [RequestsClass]

-- | The extra classes the routed procedure adds. A request that did not parse
-- has no routed procedure and so adds none.
nsidClasses : Result HttpParseFailure Request -> List RateLimitClass
nsidClasses (Err _) = []
nsidClasses (Ok request) = match requestNsid request
  None => []
  Some name => nsidRateLimitClasses name

{- | The classes one framed request is charged against, and — below — the
   identity it is charged to.

   No two arguments on this path share a type: the trust assertion is a
   `TrustedProxy`, the first-request flag a `Bool`, the parse outcome a
   `Result`. That is a constraint on any future edit here, not an accident of
   spelling. A charge decided from several same-typed positional flags is
   wrong-but-plausible when two are crossed, and a crossed charge is a 429 for
   the wrong client that no output distinguishes from a correct one — so the
   only thing that can catch it is the type checker. -}
admissionClasses : Bool ->
  Result HttpParseFailure Request ->
  List RateLimitClass
admissionClasses firstRequest parsed =
  baseClasses firstRequest ++ nsidClasses parsed

{- | An unparseable request carries no headers this module may trust, so it is
   charged to the shared `direct` bucket rather than to a reconstructed
   identity. Garbage is not the shape a legitimate client sends, so a shared
   ceiling on it costs a well-behaved client nothing.

   `Err` is the other outcome and it is not that one: the request parsed, its
   `X-Forwarded-For` reached `identifyClient`, and the header was refused
   against a ceiling. What that request is owed is an answer, not a bucket —
   `forwardedForRefusal`. -}
admissionIdentity : TrustedProxy ->
  Result HttpParseFailure Request ->
  Result String ClientIdentity
admissionIdentity _ (Err _) = Ok directIdentity
admissionIdentity trustedProxy (Ok request) =
  identifyClient trustedProxy (requestHeaders request)

{- | The bucket a request counts against when no identity of its own could be
   derived: the shared one, the same bucket an unparseable buffer uses.

   A refused header is charged too, and then refused anyway. Leaving it
   uncharged would reopen the hole `applyRateLimit`'s contract closes — every
   buffer that reaches the framer costs a parse and a response, so an
   uncharged failure is a work channel with no ceiling. The charge buys its
   sender nothing, because the answer is a 4xx whatever the verdict says, and
   it is no stronger a lever on the shared bucket than sending no
   `X-Forwarded-For` at all, which is already charged there. -}
chargedIdentity : Result String ClientIdentity -> ClientIdentity
chargedIdentity (Ok identity) = identity
chargedIdentity (Err _) = directIdentity

{- | What a client whose `X-Forwarded-For` violated one of its ceilings is
   told. A refusal rather than a demotion to the shared bucket: the shared
   bucket is a DIFFERENT bucket, so answering out of it hands a client whose
   own allowance is spent a fresh one for the price of padding a header it
   writes itself. The message is `lib.resource_limits`' own — it names the
   ceiling and nothing about this request. -}
forwardedForRefusal : String -> Response
forwardedForRefusal message =
  xrpcErrorResponse 400 "Bad Request" "InvalidRequest" message

admitClasses : RateLimitState ->
  ClientIdentity ->
  Int ->
  List RateLimitClass ->
  RateLimitAdmission
admitClasses state _ _ [] = RequestAdmitted state
admitClasses state identity nowSeconds (cls :: rest) =
  match step state identity cls nowSeconds
    (next, Refused) => RequestRefused next cls
    (next, RefusedCapacity) => RequestRefusedCapacity next
    (next, Admitted) => admitClasses next identity nowSeconds rest

classMessage : RateLimitClass -> String
classMessage ConnectionsClass =
  "too many connections for this identity in the current window"
classMessage RequestsClass =
  "too many requests for this identity in the current window"
classMessage WritesClass =
  "too many write requests for this identity in the current window"
classMessage CreateSessionClass =
  "too many createSession attempts for this identity in the current window"
classMessage RepoExportClass =
  "too many repository exports for this identity in the current window"
classMessage ProxyClass =
  "too many proxied appview reads for this identity in the current window"

-- | What a `RequestRefusedCapacity` refusal is told: this identity has not
-- exceeded anything of its own — the shared per-window table is full of
-- OTHER identities, and `classMessage`/`remainingInClass` would describe a
-- usage this identity never accrued.
capacityMessage : String
capacityMessage =
  "too many distinct client identities tracked in the current window"

intHeader : String -> Int -> Header
intHeader name value =
  resultOrPanic
    "serve: internal rate-limit header error"
    (makeHeader name (toUtf8 "\{value}"))

-- `RateLimit-Reset` needs no state, only `now` and the shared window length:
-- every class resets on the same window boundary.
rateLimitHeaderList : RateLimitState ->
  ClientIdentity ->
  RateLimitClass ->
  Int ->
  List Header
rateLimitHeaderList state identity cls nowSeconds = [
  intHeader "ratelimit-limit" (classAllowance cls),
  intHeader
    "ratelimit-remaining"
    (remainingInClass state identity cls nowSeconds),
  intHeader
    "ratelimit-reset"
    (rateLimitWindowSeconds - nowSeconds % rateLimitWindowSeconds),
]

-- | Headers for a `RequestRefusedCapacity` refusal: `ratelimit-limit` names
-- the cardinality cap itself rather than a class allowance, and
-- `ratelimit-remaining` is `0` rather than `remainingInClass`'s answer —
-- this identity has no row and no usage of its own, so the class allowance
-- it would otherwise report is not what refused it, and reporting it would
-- claim full allowance while refusing the request.
rateLimitCapacityHeaderList : Int -> List Header
rateLimitCapacityHeaderList nowSeconds = [
  intHeader "ratelimit-limit" maxRateLimitIdentitiesPerWindow,
  intHeader "ratelimit-remaining" 0,
  intHeader
    "ratelimit-reset"
    (rateLimitWindowSeconds - nowSeconds % rateLimitWindowSeconds),
]

-- | `None` admits; `Some` is the 429 to send instead of doing any real work.
-- Every buffer that reached the framer is charged, a parse failure included:
-- answering one costs a parse and a response, so an uncharged failure is a
-- work channel with no ceiling on it at all.
applyRateLimit : Ref RateLimitState ->
  ClientIdentity ->
  List RateLimitClass ->
  Int ->
  Option Response
applyRateLimit limiterRef identity classes nowSeconds =
  match admitClasses !limiterRef identity nowSeconds classes
    RequestAdmitted next =>
      let () = limiterRef := next
      None
    RequestRefused next cls =>
      let () = limiterRef := next
      Some
        (xrpcFailureResponse
          (rateLimitFailureWithHeaders
            (classMessage cls)
            (rateLimitHeaderList next identity cls nowSeconds)))
    RequestRefusedCapacity next =>
      let () = limiterRef := next
      Some
        (xrpcFailureResponse
          (rateLimitFailureWithHeaders
            capacityMessage
            (rateLimitCapacityHeaderList nowSeconds)))

-- ── connection, subscription and proxy censuses ─────────────────────────────

{- | The two budgets one request is under at once: the header section's, and
   the whole request's. They travel as a pair rather than as two `Wait`
   arguments so that a call site cannot silently swap them — they have the
   same type and opposite meanings. -}
data Deadlines (e : Effect) = Deadlines (Wait e) (Wait e)

{- | One connection's place in the un-framed census: the process-wide count,
   and whether THIS connection is still one of the connections it counts.

   The flag is what makes retirement idempotent. The count is retired at the
   first point the connection stops being un-framed and again on the exit
   path every connection leaves by, and a census one connection could
   decrement twice would drift below zero and stop bounding anything — an
   outage this process inflicts on itself, which nothing observes as an
   error. -}
data UnframedSlot = UnframedSlot (Ref Int) (Ref Bool)

{- | How many subscriptions are open right now, bounded by
   `maxConcurrentSubscriptions`.

   A type of its own rather than the bare `Ref Int` it wraps, for the reason
   `admissionClasses` states about its own arguments: `active` and `unframed`
   are already two same-typed counters travelling this module, and a third
   crossed with either would bound the wrong thing while still looking like a
   census — which no output distinguishes from a correct one. The type checker
   is what catches that, so the counters that travel furthest do not share a
   type. -}
data SubscriptionCensus = SubscriptionCensus (Ref Int)

-- | Take a subscription slot if one is free. `False` means the ceiling is
-- reached and nothing was charged.
claimSubscription : SubscriptionCensus -> Bool
claimSubscription (SubscriptionCensus open) =
  if !open >= maxConcurrentSubscriptions then
    False
  else
    let () = open := !open + 1
    True

-- | Give a subscription slot back. Called on the ONE path a claimed
-- subscription leaves by, so it needs no idempotence flag: unlike the
-- un-framed census there is no earlier point at which a subscription stops
-- being one.
releaseSubscription : SubscriptionCensus -> Unit
releaseSubscription (SubscriptionCensus open) = open := !open - 1

{- | One proxied read waiting for a slot.

   Two flags and not one. `granted` is what the scheduler parks on
   (`waitFlag`) and it is set by the RELEASING call rather than by the waiter,
   because the slot is handed straight over rather than given back and taken
   again: between a decrement and the waiter's next step a fresh arrival would
   find the slot free and barge past a call that has already been waiting.
   `abandoned` is the waiter's own answer, and the queue is what needs it — a
   waiter whose deadline passed is still somewhere in the list, and marking it
   is what stops a later release from handing a slot to a call that has already
   been refused.

   Reading `granted` first is what makes the two exclusive: a grant is recorded
   before the waiter runs again, so a waiter that could read both takes the
   slot rather than abandoning one already charged to it. -}
data ProxyWaiter = ProxyWaiter (Ref Bool) (Ref Bool)

{- | How many proxied reads are in flight right now, bounded by
   `maxConcurrentProxiedCalls`, and how many are queued for a slot, bounded by
   `maxQueuedProxiedCalls`.

   A type of its own for the reason `SubscriptionCensus` is one: it is a
   third same-typed counter travelling this module, and one crossed with
   another would bound the wrong resource while still looking like a census.
   Unlike the other two it rides on `Serving` rather than beside them,
   because the outbound path is the only thing that charges it and `Serving`
   is already what that path reads its configuration from.

   The count of waiters is carried beside the list rather than read off its
   length, because the list also holds waiters that have given up: their charge
   comes off the moment they do, and only a release walking past them drops
   them. -}
data ProxyCensus = ProxyCensus (Ref Int) (Ref Int) (Ref (List ProxyWaiter))

-- | Take a proxied-call slot if one is free. `False` means every slot is in
-- flight and nothing was charged.
claimProxiedCall : ProxyCensus -> Bool
claimProxiedCall (ProxyCensus inFlight _ _) =
  if !inFlight >= maxConcurrentProxiedCalls then
    False
  else
    let () = inFlight := !inFlight + 1
    True

-- | Join the back of the admission queue, or `None` when it is full — in which
-- case nothing was charged and the call is refused now rather than later.
enqueueProxiedCall : ProxyCensus -> Option ProxyWaiter
enqueueProxiedCall (ProxyCensus _ waiting queue) =
  if !waiting >= maxQueuedProxiedCalls then
    None
  else
    let waiter = ProxyWaiter (Ref False) (Ref False)
    let () = waiting := !waiting + 1
    let () = queue := !queue ++ [waiter]
    Some waiter

waiterGranted : ProxyWaiter -> Ref Bool
waiterGranted (ProxyWaiter granted _) = granted

waiterAbandoned : ProxyWaiter -> Bool
waiterAbandoned (ProxyWaiter _ abandoned) = !abandoned

-- | The first waiter still holding its place, and what is left behind it.
-- Waiters that gave up are dropped on the way past rather than returned: their
-- charge came off `waiting` when they abandoned.
firstLiveWaiter : List ProxyWaiter -> Option (ProxyWaiter, List ProxyWaiter)
firstLiveWaiter [] = None
firstLiveWaiter (waiter :: rest) =
  if waiterAbandoned waiter then firstLiveWaiter rest else Some (waiter, rest)

{- | Hand this call's slot to the caller that has waited longest for it, or
   give it back when nobody is waiting.

   The slot is TRANSFERRED on the first path: `inFlight` stays charged and the
   waiter resumes already holding it, which is what makes the claim and the
   release the two halves of one decision even with a queue between them —
   there is no instant at which a slot is free and unowned for an arriving call
   to take ahead of the queue. It is conservative in the only direction that
   matters: the count reads one higher than the calls actually outstanding for
   the step between the grant and the waiter's resumption, never one lower.

   Called on the ONE path a claimed call leaves by, so it needs no idempotence
   flag: `egressCall` answers every outcome it has with a `Result`, so there is
   no exit that skips the release. -}
releaseProxiedCall : ProxyCensus -> Unit
releaseProxiedCall (ProxyCensus inFlight waiting queue) =
  match firstLiveWaiter !queue
    None =>
      let () = queue := []
      inFlight := !inFlight - 1
    Some (waiter, rest) =>
      let () = queue := rest
      let () = waiting := !waiting - 1
      waiterGranted waiter := True

{- | What a woken waiter holds: `True` when a slot was handed to it, `False`
   when its wait ran out first.

   The `False` arm is where the waiter leaves the queue — it stays in the list
   until a release walks past it, but its charge comes off here, so a refused
   call does not go on occupying a queue place it will never use. -}
settleProxiedCall : ProxyCensus -> ProxyWaiter -> Bool
settleProxiedCall (ProxyCensus _ waiting _) (ProxyWaiter granted abandoned) =
  if !granted then
    True
  else
    let () = abandoned := True
    let () = waiting := !waiting - 1
    False

{- | Take a proxied-call slot, waiting in the admission queue for one if every
   slot is in flight. `False` means the call is refused: the queue was full, or
   `proxyQueueWait` ran out before a slot reached it.

   It PARKS on the grant flag and the deadline together rather than polling the
   census, because this process runs one cooperative thread
   (`stdlib/async.mdk`) and everything else it is doing runs on it too. A wait
   that spun, or slept in a loop, would stop every other connection and every
   open subscription as well as this call — a concurrency limit turned into a
   global stall, which is worse than the refusal it replaced. Parked, a waiting
   call costs one entry in the scheduler's park table and no work at all until
   one of its two waits fires.

   The rate limit is charged before this is reached (`forwardProxied` applies
   `ProxyClass` first), so queueing admits more calls into flight without
   admitting more calls per window: the anti-abuse bound is untouched. -}
admitProxiedCall : ProxyCensus -> Async <Clock | e> Bool
admitProxiedCall census =
  if claimProxiedCall census then
    deferPure True
  else match enqueueProxiedCall census
    None => deferPure False
    Some waiter => defer
      limit <- deadlineAfter proxyQueueWait
      _ <- awaitAny [waitFlag (waiterGranted waiter), limit]
      liftIO (u => settleProxiedCall census waiter)

-- ── the in-flight buffer budget ─────────────────────────────────────────────

{- | A read waiting for buffer headroom: the flag a release grants it on, the
   flag it abandons on, and how many bytes it is waiting for.

   The byte count rides on the waiter rather than being re-derived when
   headroom appears, because the grant runs on the releasing connection's task
   and not on the waiter's: whoever gives bytes back has to be able to tell
   whether the head of the queue fits in them without asking that connection
   anything.

   `granted` and `abandoned` are exclusive the way `ProxyWaiter`'s two flags
   are, and reading `granted` first is what makes them so: a waiter that could
   read both takes headroom already charged to it rather than abandoning a
   charge nothing else will give back. -}
export data BufferWaiter = BufferWaiter (Ref Bool) (Ref Bool) Int

{- | How many bytes of inbound request every connection holds between them
   right now — buffered, or reserved for a body still arriving — bounded by
   `maxInFlightRequestBytes`, and how many reads are waiting for headroom,
   bounded by `maxQueuedBufferedReads`.

   A type of its own for the reason `ProxyCensus` is one, and it rides on
   `Serving` beside it for the same reason: it is a counter no single
   connection owns, and `Serving` is already on every function between
   `acceptLoop` and the read that charges it. The two count opposite
   directions — the buffers this server accumulates FROM its callers, and the
   ones it accumulates from an upstream — so one crossed with the other would
   bound the wrong resource while still looking like a census.

   The waiter count is carried beside the list rather than read off its length,
   because the list also holds waiters that have given up: their charge comes
   off the moment they do, and only a release walking past them drops them. -}
export data BufferCensus =
  | BufferCensus (Ref Int) (Ref Int) (Ref (List BufferWaiter))

-- | An empty budget, charged by nothing yet.
export
newBufferCensus : Unit -> BufferCensus
newBufferCensus _ = BufferCensus (Ref 0) (Ref 0) (Ref [])

-- | How many bytes every connection holds between them right now, buffered or
-- reserved.
export
bufferedBytes : BufferCensus -> Int
bufferedBytes (BufferCensus buffered _ _) = !buffered

-- | How many reads are parked on headroom right now.
export
waitingReads : BufferCensus -> Int
waitingReads (BufferCensus _ waiting _) = !waiting

bufferWaiterBytes : BufferWaiter -> Int
bufferWaiterBytes (BufferWaiter _ _ bytes) = bytes

bufferWaiterGranted : BufferWaiter -> Ref Bool
bufferWaiterGranted (BufferWaiter granted _ _) = granted

bufferWaiterAbandoned : BufferWaiter -> Bool
bufferWaiterAbandoned (BufferWaiter _ abandoned _) = !abandoned

-- | Take `bytes` of headroom if that much is free. `False` means the budget is
-- full and nothing was charged.
export
claimBufferBytes : BufferCensus -> Int -> Bool
claimBufferBytes (BufferCensus buffered _ _) bytes =
  if !buffered + bytes > maxInFlightRequestBytes then
    False
  else
    let () = buffered := !buffered + bytes
    True

-- | Join the back of the headroom queue, or `None` when it is full — in which
-- case nothing was charged and the read is refused now rather than later.
export
enqueueBufferBytes : BufferCensus -> Int -> Option BufferWaiter
enqueueBufferBytes (BufferCensus _ waiting queue) bytes =
  if !waiting >= maxQueuedBufferedReads then
    None
  else
    let waiter = BufferWaiter (Ref False) (Ref False) bytes
    let () = waiting := !waiting + 1
    let () = queue := !queue ++ [waiter]
    Some waiter

-- | The first waiter still holding its place, and what is left behind it.
-- Waiters that gave up are dropped on the way past rather than returned: their
-- charge came off `waiting` when they abandoned.
firstLiveBufferWaiter : List BufferWaiter ->
  Option (BufferWaiter, List BufferWaiter)
firstLiveBufferWaiter [] = None
firstLiveBufferWaiter (waiter :: rest) =
  if bufferWaiterAbandoned waiter then
    firstLiveBufferWaiter rest
  else
    Some (waiter, rest)

{- | Hand freed headroom to the reads that have waited longest for it, in
   order, for as long as the one at the front still fits in what is free.

   It stops at the first waiter that does not fit rather than looking past it
   for a smaller one: this is a bound on bytes and not a scheduler, and a large
   read passed over while small ones keep arriving would wait out its deadline
   beside headroom it was never offered. The bytes are transferred the way
   `releaseProxiedCall` transfers a slot — charged to the waiter before it
   resumes — so there is no instant at which freed bytes are unowned for an
   arriving read to take ahead of the queue. -}
grantBufferHeadroom : BufferCensus -> Unit
grantBufferHeadroom census = match census
  BufferCensus buffered waiting queue => match firstLiveBufferWaiter !queue
    None => queue := []
    Some (waiter, rest) =>
      if !buffered + bufferWaiterBytes waiter > maxInFlightRequestBytes then
        queue := waiter :: rest
      else
        let () = queue := rest
        let () = waiting := !waiting - 1
        let () = buffered := !buffered + bufferWaiterBytes waiter
        let () = bufferWaiterGranted waiter := True
        grantBufferHeadroom census

{- | Give `bytes` back to the budget and pass them on to whoever is waiting.

   A saturated budget is a wait and never a deadlock, and what makes that true
   is WHERE a connection asks for headroom, not that its request is bounded: a
   connection past its header section holds a reservation for the whole of the
   request it is framing (`readBufferTarget`), so it never waits on the budget
   again before giving that reservation back, on the rebase a finished request
   performs or on the connection's own retirement — both of which run this,
   within `requestTimeout` either way. The connections that can still be
   waiting are the ones inside a header section, which is capped at
   `maxHttpHeaderBytes`, so the waiting set is never waiting on itself.

   Charging a body incrementally instead would make that false, bounded request
   or not: each waiter would then be holding part of a body and waiting for the
   rest of it, and no member of that set could finish. -}
export
releaseBufferBytes : BufferCensus -> Int -> Unit
releaseBufferBytes census bytes = match census
  BufferCensus buffered _ _ =>
    let () = buffered := !buffered - bytes
    grantBufferHeadroom census

{- | What a woken waiter holds: `True` when headroom was handed to it, `False`
   when its wait ran out first.

   The `False` arm is where the waiter leaves the queue — it stays in the list
   until a release walks past it, but its charge comes off here, so a refused
   read does not go on occupying a queue place it will never use. -}
export
settleBufferedRead : BufferCensus -> BufferWaiter -> Bool
settleBufferedRead (BufferCensus _ waiting _) (BufferWaiter granted abandoned _) =
  if !granted then
    True
  else
    let () = abandoned := True
    let () = waiting := !waiting - 1
    False

{- | Take `bytes` of buffer headroom, waiting in the queue for it while the
   budget is full. `False` means the read is refused: the queue was full, or
   `bufferQueueWait` ran out before headroom reached it.

   It PARKS rather than polling, for the reason `admitProxiedCall` does: one
   cooperative thread (`stdlib/async.mdk`) runs every other connection and
   every open subscription too, so a wait that spun would turn a memory bound
   into a global stall. -}
admitBufferBytes : BufferCensus -> Int -> Async <Clock | e> Bool
admitBufferBytes census bytes =
  if claimBufferBytes census bytes then
    deferPure True
  else match enqueueBufferBytes census bytes
    None => deferPure False
    Some waiter => defer
      limit <- deadlineAfter bufferQueueWait
      _ <- awaitAny [waitFlag (bufferWaiterGranted waiter), limit]
      liftIO (u => settleBufferedRead census waiter)

-- | Retire this connection's un-framed charge, if it still holds one.
releaseUnframed : UnframedSlot -> Unit
releaseUnframed (UnframedSlot unframed held) =
  if !held then
    let () = held := False
    unframed := !unframed - 1

-- | Retire it as soon as the scan leaves the header section, whether or not a
-- whole request has framed yet: the body that may follow is bounded by
-- `bodyProgressTimeout`, `requestTimeout` and `maxHttpRequestBytes`, not by
-- this census.
releaseWhenHeadersDone : UnframedSlot -> HttpScan -> Unit
releaseWhenHeadersDone slot scan =
  if httpScanInHeaders scan then () else releaseUnframed slot

-- | Retire everything one connection holds, on the one path every connection
-- leaves by.
retireConnection : Ref Int -> UnframedSlot -> BufferCensus -> ReadBuffer -> Unit
retireConnection active slot census buf =
  let () = releaseUnframed slot
  let () = retireReadBuffer census buf
  active := !active - 1

-- ── the read buffer ─────────────────────────────────────────────────────────

{- | A connection's accumulated read bytes: `bytebuilder.Builder`'s own
   backing byte block with spare capacity, and how many of its bytes are
   live. A byte costs a byte here, not a tagged 64-bit word. Appending a
   chunk (`readBufferAppend`) copies only the chunk, doubling the backing
   store when it doesn't fit — a request delivered in K reads costs
   O(bytes), not O(bytes × K), which `buf ++ bytes` on a plain `Array Int`
   would cost because `++` copies its whole left operand on every call. The
   doubling itself is `bytebuilder.emitBytes`'s: this module does no
   capacity arithmetic of its own.

   The live count is exactly what `scanRequestBoundaryWithin` calls `avail`:
   the backing store's own length is spare capacity, never received bytes,
   so nothing may read past it.

   `readBufferBacking` hands out that block itself, and `scanRequestBoundaryWithin`
   and `parseRequestAt` read it in place: no copy stands between a received
   byte and the framer that reads it.

   The second field is how many of those bytes this connection has charged to
   the process-wide `BufferCensus`. It rides here rather than beside the
   buffer because it must survive `readBufferFrom`: a kept-alive connection's
   buffer is replaced by a rebased one between requests, and the charge
   belongs to the connection rather than to whichever of those values is
   current, so `serveConnection` can give back exactly what its connection
   still holds however many requests it served.

   Exported abstractly, with the operations below, for
   `pds/test/read_buffer_test.mdk`: the growth behavior is pure — a function
   of the bytes appended — and so can be asserted without a socket. The
   representation stays private — a caller outside this module cannot reach
   the `Builder`. -}
export data ReadBuffer = ReadBuffer Builder (Ref Int)

-- | An empty buffer; the backing store is allocated on the first append.
export
readBufferNew : Unit -> ReadBuffer
readBufferNew _ = ReadBuffer (newBuilder ()) (Ref 0)

-- | How many bytes are live, in O(1): a `Ref Int` deref, never a traversal of
-- the backing store.
export
readBufferLen : ReadBuffer -> Int
readBufferLen (ReadBuffer b _) = let (_, len) = builderParts b in len

-- | How many of this connection's bytes are charged to the budget right now.
-- At least `readBufferLen`, and more while a reservation covers bytes the
-- request it is framing has not delivered yet; the two are separate counters
-- because the budget is given back by the connection, which by then holds a
-- different buffer value.
export
readBufferCharged : ReadBuffer -> Int
readBufferCharged (ReadBuffer _ charged) = !charged

{- | Record `bytes` of headroom `admitBufferBytes` has just taken for this
   connection. The process-wide total is charged at admission and this is the
   connection's own half of the same number, so the two move together and a
   retirement gives back what this connection holds rather than some share of
   what everyone holds. -}
export
chargeReadBuffer : ReadBuffer -> Int -> Unit
chargeReadBuffer (ReadBuffer _ charged) bytes = charged := !charged + bytes

-- | Give back the `bytes` this connection has stopped holding.
export
releaseReadBuffer : BufferCensus -> ReadBuffer -> Int -> Unit
releaseReadBuffer census (ReadBuffer _ charged) bytes =
  let () = charged := !charged - bytes
  releaseBufferBytes census bytes

{- | Give back everything beyond the `keep` bytes the connection's rebased
   buffer still carries: the finished request's own bytes, and the tail of its
   reservation that the request never grew into.

   The reservation is released at the same point its bytes are rather than
   held to the connection's retirement, because it was taken for ONE request:
   a kept-alive connection's next request reserves again from its own header
   section, and one that carried its predecessor's reservation across would
   hold a megabyte of headroom per request it had ever served. -}
export
rebaseReadBufferCharge : BufferCensus -> ReadBuffer -> Int -> Unit
rebaseReadBufferCharge census buf keep =
  releaseReadBuffer census buf (readBufferCharged buf - keep)

-- | Give back everything this connection still holds, on the one path every
-- connection leaves by. Idempotent, like `releaseUnframed`: a second call
-- finds nothing charged and gives back nothing.
export
retireReadBuffer : BufferCensus -> ReadBuffer -> Unit
retireReadBuffer census buf =
  releaseReadBuffer census buf (readBufferCharged buf)

readBufferIsEmpty : ReadBuffer -> Bool
readBufferIsEmpty buf = readBufferLen buf == 0

-- | The backing store, for a caller (`scanRequestBoundaryWithin`,
-- `parseRequestAt`) that is handed the live count separately and must never
-- read past it on its own. `builderParts` reaches the builder's own block
-- without copying, so this costs nothing proportional to what is buffered.
export
readBufferBacking : ReadBuffer -> Bytes
readBufferBacking (ReadBuffer b _) =
  let (backing, _) = builderParts b
  backing

{- | Appends `bytes` in place. When the backing store doesn't fit them, it is
   replaced by a doubled one first, copying the live prefix once (`blit`);
   the append itself is one more `blit`, of exactly `arrayLength bytes`
   bytes. Neither copy is proportional to bytes already buffered from
   earlier reads — `emitBytes` grows at most once per call, to the
   smallest doubling that holds the result, however many capacity classes a
   single delivered chunk spans.

   Packing `bytes` into a `Bytes` first is the one copy this shape adds, and
   it goes through the CHECKED door: an element outside `0..255` aborts
   rather than being masked to its low eight bits, so no caller can put a
   byte on the wire that it did not supply. The socket read loop pays
   neither the copy nor the scan: its chunk arrives packed and appends
   through `readBufferAppendBytes`. The abort is graded out of process by
   `pds/test/trust_boundary_guards_test.mdk`'s `readbuffer-*` cells. -}
export
readBufferAppend : Array Int -> ReadBuffer -> Unit
readBufferAppend bytes (ReadBuffer b _) =
  emitBytes
    (optionOrPanic
      "readBufferAppend: every element must be a byte in 0..255"
      (fromArray bytes))
    b

-- | Appends an already-packed chunk, skipping the packing copy
-- `readBufferAppend` performs. This is `readMore`'s door: a chunk off the
-- socket arrives packed.
readBufferAppendBytes : Bytes -> ReadBuffer -> Unit
readBufferAppendBytes bytes (ReadBuffer b _) = emitBytes bytes b

{- | A fresh buffer holding the live bytes from `from` to the end — the
   leftover a finished request carries into the next one
   (`respondAt`'s `rest`). Copies the leftover once, the same single copy
   `sliceClamped` performed on the old `Array Int` representation.

   The budget charge is carried across rather than restarted: this is the same
   connection's buffer under a new value, and `respondAt` gives back exactly
   the `from` bytes this drops. -}
export
readBufferFrom : Int -> ReadBuffer -> ReadBuffer
readBufferFrom from (ReadBuffer b charged) =
  let (backing, len) = builderParts b
  let fresh = newBuilder ()
  let () = emitBytes (sliceClamped from len backing) fresh
  ReadBuffer fresh charged

-- | The live bytes alone, for the one caller (`rejectBufferAt`) that hands
-- the whole buffer to `applyRequest` rather than a scanned `[0, boundary)`
-- prefix.
export
readBufferLive : ReadBuffer -> Bytes
readBufferLive (ReadBuffer b _) =
  let (backing, len) = builderParts b
  sliceClamped 0 len backing

-- ── the serving context ─────────────────────────────────────────────────────

{- | The deployment facts that are fixed for the life of the listener, travelling
   as one value because they travel together through every function below.

   `TrustedProxy` is `--trusted-proxy`'s value: whether this process's peer is a
   configured trusted proxy is an operator assertion about the deployment, not a
   per-connection fact this process can observe. The `Egress` is `None` unless
   `--appview-did` and `--egress-port` were both given, and `None` is what makes
   a server configured for no appview answer every `atproto-proxy` header the
   way it did before there was an outbound path at all.

   One value rather than three parameters, for the reason `admissionClasses`
   states about its own arguments: these are threaded through eleven functions
   whose argument lists are already long, and a pair of them crossed at one
   call site would charge the wrong identity or sign for the wrong appview
   while every signature still typechecked. The proxied-call census joins them
   for the same reason and not because it is configuration: it is the one
   counter only the outbound path charges, and this value is already on every
   function between `acceptLoop` and `forwardProxied`. The buffer budget joins
   them on the same argument: it is charged by the inbound read and given back
   by the connection's retirement, and both of those already hold this. -}
export data Serving =
  | Serving TrustedProxy (Option Egress) ProxyCensus BufferCensus

export
makeServing : TrustedProxy -> Option Egress -> Ref Int -> Serving
makeServing trustedProxy egress inFlight =
  Serving
    trustedProxy
    egress
    (ProxyCensus inFlight (Ref 0) (Ref []))
    (newBufferCensus ())

export
servingTrustedProxy : Serving -> TrustedProxy
servingTrustedProxy (Serving trustedProxy _ _ _) = trustedProxy

servingEgress : Serving -> Option Egress
servingEgress (Serving _ egress _ _) = egress

servingProxyCensus : Serving -> ProxyCensus
servingProxyCensus (Serving _ _ census _) = census

servingBufferCensus : Serving -> BufferCensus
servingBufferCensus (Serving _ _ _ census) = census

-- ── the stats line ──────────────────────────────────────────────────────────

-- | One sample of the process-wide stats line, read off whatever the
-- refs/store hold at the moment it runs and written to stdout. `dir`'s blob
-- count is the one field that costs a directory walk; a failed walk (an
-- unreadable shard, mid-write residue) drops this ONE line rather than the
-- server, since `statsLoop` tries again at the next interval regardless.
emitStats : String ->
  Ref Store ->
  Ref Int ->
  Ref Int ->
  Ref Int ->
  <FileRead "_", Stdout> Unit
emitStats dir storeRef active unframed subs =
  let store = !storeRef
  let (rev, blocks) = match storeRepo store
    -- `storeSize`/the blob half's `BlockStore` counts BLOBS loaded into
    -- memory, not this repository's commit/MST blocks — those live in the
    -- `Repo`'s OWN `BlockStore` (`repoStore`), a distinct value despite the
    -- shared type. Measured directly: a freshly `--init`ed repo reads
    -- `storeSize store == 0` (no blob uploaded yet) while its genesis commit
    -- already holds blocks, which `blockStoreSize (repoStore repo)` reports.
    None => ("-", 0)
    Some repo => (
      tidToString (repoCommitTid (repoLatestCommit repo)),
      blockStoreSize (repoStore repo),
    )
  match blobFileCount dir
    Err _ => ()
    Ok blobs =>
      let () =
        putStrLn
          (statsLogLine StatsEvent {
            active = !active,
            unframed = !unframed,
            subscriptions = !subs,
            rev = rev,
            blocks = blocks,
            blobs = blobs,
          })
      flushStdout ()

-- | Emit one stats line, then sleep `interval` and do it again, forever.
-- Spawned alongside `acceptLoop` (the same shape `pds/serve.mdk`'s `announce`
-- spawns `announceToRelay` in) so the periodic sample runs concurrently with
-- connection handling instead of blocking it — which is why the sleep is
-- `async.sleep`, which parks this ONE task and lets the scheduler run every
-- other one meanwhile, and not `time.sleep`/`sleepMs`, which blocks the
-- single thread the whole scheduler — `acceptLoop` included — runs on.
statsLoop : String ->
  Ref Store ->
  Ref Int ->
  Ref Int ->
  Ref Int ->
  Duration ->
  Async <Clock, FileRead "_", Stdout | e> Unit
statsLoop dir storeRef active unframed subs interval = defer
  () <- liftIO (u => emitStats dir storeRef active unframed subs)
  () <- sleep interval
  statsLoop dir storeRef active unframed subs interval

-- ── the accept and connection loops ─────────────────────────────────────────

-- | Accept connections until the listener fails or is closed, running each on
-- its own task, never more than `maxConcurrentConnections` at a time.
-- `statsInterval` is `pds/serve.mdk`'s `--stats-interval-ms`, or
-- `defaultStatsInterval` when the flag is absent.
export
runServer : Server ->
  String ->
  Ref Store ->
  Listener ->
  Serving ->
  Duration ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
runServer server dir storeRef lis serving statsInterval = defer
  active <- liftIO (u => Ref 0)
  unframed <- liftIO (u => Ref 0)
  subscriptions <- liftIO (u => Ref 0)
  limiterRef <- liftIO (u => Ref initRateLimitState)
  _ <- spawn
    (statsLoop dir storeRef active unframed subscriptions statsInterval)
  acceptLoop
    server
    dir
    storeRef
    lis
    active
    unframed
    limiterRef
    (SubscriptionCensus subscriptions)
    serving

acceptLoop : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref Int ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
acceptLoop server dir storeRef lis active unframed limiterRef census serving =
  defer
    accepted <- A.accept lis
    acceptStep
      server
      dir
      storeRef
      lis
      active
      unframed
      limiterRef
      census
      serving
      accepted

acceptStep : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref Int ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Result String Connection ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
acceptStep _ _ _ _ _ _ _ _ _ (Err message) = deferPure (Err message)
acceptStep server dir storeRef lis active unframed limiterRef census serving (Ok conn) =
  -- Both ceilings close the connection the same way, without a read:
  -- answering it would need the very socket work either ceiling exists to
  -- bound. A connection is charged to the un-framed census here, before it
  -- has been read from, because that is the state it is accepted INTO.
  if !active >= maxConcurrentConnections
    || !unframed >= maxUnframedConnections then defer
    _ <- A.close conn
    acceptLoop server dir storeRef lis active unframed limiterRef census serving
  else
    let () = active := !active + 1
    let () = unframed := !unframed + 1
    defer
      _ <- spawn
        (serveConnection
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          active
          unframed)
      acceptLoop
        server
        dir
        storeRef
        lis
        active
        unframed
        limiterRef
        census
        serving

-- Both counters are decremented on every exit path because the close and the
-- decrement are the continuation of the loop, not something inside it. The
-- un-framed one is USUALLY retired earlier, the moment the header section
-- ends; `releaseUnframed` is idempotent so that this path can retire it
-- unconditionally without having to know whether that already happened.
serveConnection : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  Ref Int ->
  Ref Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
serveConnection server dir storeRef limiterRef census serving conn active unframed =
  defer
    held <- liftIO (u => Ref True)
    -- Bound here rather than passed inline, because the retirement below needs
    -- the charge this connection accumulates: the value `connectionLoop` ends
    -- holding is a rebased successor, but the charge ref inside it is this one.
    buf <- liftIO (u => readBufferNew ())
    _ <- connectionLoop
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      (UnframedSlot unframed held)
      buf
      True
    _ <- A.close conn
    liftIO (u =>
      retireConnection
        active
        (UnframedSlot unframed held)
        (servingBufferCensus serving)
        buf)

{- | Serve requests over one connection until it closes, fails, or times out.
   `pending` is what a previous request left behind: a pipelined client sends
   the next request in the same packet as the last, so the loop scans what it
   already holds before it reads anything more. `firstRequest` is True only
   for the connection's own first framed request — it is what makes
   `ConnectionsClass` a per-connection charge rather than a per-request one.

   Both budgets are armed here, once per request rather than once per
   connection: a kept-alive connection's second request gets its own header
   and request budgets, exactly as a fresh connection's first one does. -}
connectionLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
connectionLoop server dir storeRef limiterRef census serving conn slot pending firstRequest =
  defer
    deadline <- deadlineAfter requestTimeout
    headerDeadline <- deadlineAfter headerTimeout
    frameLoop
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      (Deadlines headerDeadline deadline)
      pending
      httpScanStart
      firstRequest

-- `scanRequestBoundaryWithin` is the ONLY notion of a complete request in this
-- module: nothing here inspects a byte of the buffer on its own. The `HttpScan`
-- it hands back is carried to the next read so that a trickling client costs
-- what it sent rather than what it has sent so far; it is opaque here, and a
-- new request starts from `httpScanStart` in `connectionLoop` because
-- `respond` hands the next request a buffer rebased on its own first byte.
frameLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
frameLoop server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  let scanned =
    scanRequestBoundaryWithin (readBufferBacking buf) (readBufferLen buf) 0 scan
  match scanned
    (HttpFramedAt boundary, _) =>
      let () = releaseUnframed slot
      respond
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        buf
        boundary
        firstRequest
    (HttpFrameFailed _, _) =>
      let () = releaseUnframed slot
      rejectBuffer server dir storeRef limiterRef conn buf firstRequest
    (HttpNeedMore, resumed) =>
      -- A scan that has passed the header section is no longer un-framed in
      -- the sense the census bounds, even though no request has framed yet:
      -- what is still arriving is a body, under its own budgets.
      let () = releaseWhenHeadersDone slot resumed
      framePending
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        deadlines
        buf
        resumed
        firstRequest

-- The header budget is tested only while the header section is unterminated,
-- so a legitimate body that outlives it is not closed on it.
framePending : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
framePending server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  match deadlines
    Deadlines headerDeadline deadline => defer
      late <- expired deadline
      lateHeader <- expired headerDeadline
      if late then
        deferPure (Err "request deadline exceeded")
      else if lateHeader && httpScanInHeaders scan then
        deferPure (Err "header deadline exceeded")
      else
        readMore
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          slot
          deadlines
          buf
          scan
          firstRequest

readMore : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
readMore server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  defer
    reserved <- reserveReadBuffer (servingBufferCensus serving) buf scan
    if not reserved then
      refuseOverBudget conn scan
    else defer
      let want = readSizeFor scan buf
      received <- A.recvBytesWithin (silenceBudget scan) conn want
      match received
        Err message => deferPure (Err message)
        Ok bytes =>
          if B.length bytes == 0 then
            deferPure (endOfStream buf)
          else
            let () = readBufferAppendBytes bytes buf
            frameLoop
              server
              dir
              storeRef
              limiterRef
              census
              serving
              conn
              slot
              deadlines
              buf
              scan
              firstRequest

{- | How much of the budget this connection must hold before it reads again:
   enough to carry the request it is framing to a point it can decide at
   without asking for more.

   In the header section that is only what has already arrived plus the read
   about to be asked for, because nothing longer is knowable there and the
   section is capped at `maxHttpHeaderBytes` anyway.

   Past it, it is the WHOLE of what the request still needs, taken once: a
   `Content-Length` body's end position is fixed the instant the headers
   terminate (`httpScanBodyRemaining`), and `len + remaining` is that position,
   so this number does not move again for the rest of the body however many
   reads deliver it. A chunked body declares its length one chunk at a time
   and so reserves the per-request ceiling it could grow to instead.

   Both are capped at `maxHttpRequestBytes` plus one read, because that is the
   most any buffer can reach: `scanRequestBoundaryWithin` refuses one past
   that ceiling, and the read that carries it past is the last it gets. The
   cap is on a number the PEER chose, and it is held here rather than inferred
   from the ceiling `http` happens to apply to a declared length today, so how
   much of a promise this server will hold before the framer has graded it
   does not depend on which of `http`'s ceilings is the tighter one.

   Reserving the whole of it at once is what makes the budget a WAIT rather
   than a deadlock. A connection charged for part of a body and then queued
   for the rest is waiting on headroom every other such connection is also
   holding part of and also waiting for, which nothing drains: measured, seven
   concurrent 5 MiB uploads against the incremental shape cost six of them a
   reset with no response, and a 40 KB `GET` beside them 4.876 s.

   Exported so `pds/test/read_buffer_test.mdk` can assert that a fixed-length
   body's target does not move as its bytes arrive, which is the whole of why
   one admission is enough. -}
export
readBufferTarget : HttpScan -> ReadBuffer -> Int
readBufferTarget scan buf =
  let len = readBufferLen buf
  let ceiling = maxHttpRequestBytes + readChunkBytes
  if httpScanInHeaders scan then
    len + readChunkBytes
  else match httpScanBodyRemaining scan len
    Some remaining => min ceiling (len + remaining)
    None => ceiling

{- | How many bytes to ask the socket for. A read inside a fixed-length body
   is capped at what that body still needs, so nothing past the request's own
   last byte is ever buffered against its reservation: a pipelined successor
   stays in the kernel's receive queue until the read that frames it, which is
   where it is budgeted for. Exported beside `readBufferTarget`: the cap is
   what keeps a connection's live bytes within its reservation. -}
export
readSizeFor : HttpScan -> ReadBuffer -> Int
readSizeFor scan buf =
  if httpScanInHeaders scan then
    readChunkBytes
  else match httpScanBodyRemaining scan (readBufferLen buf)
    Some remaining => min readChunkBytes remaining
    None => readChunkBytes

-- | Top this connection's charge up to what `readBufferTarget` says it needs,
-- waiting for headroom if the budget is full. `False` means the read is
-- refused and nothing further was charged. A target already covered charges
-- nothing and never waits, which is what makes the body of a fixed-length
-- request one admission rather than one per chunk.
reserveReadBuffer : BufferCensus ->
  ReadBuffer ->
  HttpScan ->
  Async <Clock | e> Bool
reserveReadBuffer census buf scan =
  let owed = readBufferTarget scan buf - readBufferCharged buf
  if owed <= 0 then
    deferPure True
  else defer
    admitted <- admitBufferBytes census owed
    if admitted then
      let () = chargeReadBuffer buf owed
      deferPure True
    else
      deferPure False

{- | What a read refused by the budget is told.

   Closed unanswered while the header section is unterminated, the way this
   phase's other two refusals are: no request has framed, so there is nothing
   to answer about. Past it a request HAS framed its head — `httpScanInHeaders`
   is how this module tells the two apart — and an already-headered refusal is
   told 503 here for the reason `proxyCeilingResponse` tells one: a caller that
   retries later is right to, and what is refused is what is in flight now.

   Either way the connection closes and its retirement gives its whole charge
   back, which is what lets the waiters behind it proceed. -}
refuseOverBudget : Connection ->
  HttpScan ->
  Async <Clock, Net "_", Stdout | e> (Result String Unit)
refuseOverBudget conn scan =
  if httpScanInHeaders scan then
    deferPure (Err "in-flight request buffer budget exceeded")
  else defer
    startedAt <- liftIO (u => monotonic ())
    let bytes = serializeResponse (withAllowOrigin bufferCeilingResponse)
    let trace = RequestTrace "" "" (identityLabel directIdentity) startedAt
    _ <- A.sendAllWithin writeTimeout conn bytes
    _ <- liftIO (u => logAccessBytes trace bytes)
    _ <- drainRefused conn lingerDrainReads
    deferPure (Err "in-flight request buffer budget exceeded")

{- | Read away what the refused peer is still sending, discarding it, so that
   the refusal above reaches it.

   Closing a socket whose receive queue still holds bytes is a TCP RESET, and
   a reset discards whatever the peer had not read yet — the response just
   written included. Measured on this server: a peer told 503 with 4.9 MB of
   body still in flight saw `ECONNRESET` and no status at all, and the same
   peer with its body not yet sent saw the 503. Reading the leftover away is
   what turns the close back into an orderly one.

   Bounded on both axes, because the body being read away is the one this
   server would not hold: nothing is buffered, so what it costs is `left`
   reads and the one short wait that finds the queue already empty. A peer
   still sending past that is told by the reset instead, which is the answer
   it left this server no room for. -}
drainRefused : Connection -> Int -> Async <Clock, Net "_" | e> Unit
drainRefused conn left =
  if left <= 0 then
    deferPure ()
  else defer
    received <- A.recvBytesWithin lingerDrainWait conn readChunkBytes
    match received
      Err _ => deferPure ()
      Ok bytes =>
        if B.length bytes == 0 then
          deferPure ()
        else
          drainRefused conn (left - 1)

-- | What a body refused past `maxInFlightRequestBytes` AND
-- `maxQueuedBufferedReads` is told. Its own error name rather than
-- `proxyCeilingResponse`'s: what ran out is this server's inbound buffer, not
-- its outbound call budget, and a client that can tell them apart can tell
-- whether retrying the same body is worth it.
bufferCeilingResponse : Response
bufferCeilingResponse =
  xrpcErrorResponse
    503
    "Service Unavailable"
    "RequestBufferLimitExceeded"
    "too many request bodies are in flight on this server"

-- | How long this read may find nothing: whichever phase's budget the scan is
-- in. The deadline in `framePending` is only consulted between reads, so a peer
-- that sends nothing at all would otherwise sit out a read budget belonging to
-- some other phase before anything looked at the one it is actually in.
silenceBudget : HttpScan -> Duration
silenceBudget scan =
  if httpScanInHeaders scan then headerTimeout else bodyProgressTimeout

-- A peer that closes between requests has finished; one that closes part way
-- through a request has not.
endOfStream : ReadBuffer -> Result String Unit
endOfStream buf =
  if readBufferIsEmpty buf then Ok () else Err "connection closed mid-request"

-- ── answering one request, and logging it ───────────────────────────────────

{- | The CORS preflight answer this buffer is owed, or `None` when it is not a
   preflight. A buffer that did not parse is never one, for the reason it is
   never an upgrade: there is no `Request` to grade.

   `lib.server_core`'s `handle` keeps a short-circuit of its own, but it sits
   below `applyRequest`, and three classifications run above that: a browser
   preflights with no `Authorization` header and `admitForwardable` resolves a
   credential before it looks at the verb, so an `OPTIONS` to a forwardable
   nsid is refused 401 before `applyRequest` is ever called. Answering here
   makes the preflight independent of which of the four downstream paths the
   real request would have taken. Nothing in the answer depends on them:
   `preflightResponse` reads the request's own headers, and neither touches
   the store nor charges anything. -}
preflightAnswer : Result HttpParseFailure Request -> Option Response
preflightAnswer (Err _) = None
preflightAnswer (Ok request) =
  if isPreflight request then Some (preflightResponse request) else None

{- | What the access log needs to know about a request, gathered where the
   request is still structured and carried to the point its response bytes
   leave.

   A SHELL type rather than one of `lib.accesslog`'s: `startedAt` is a
   monotonic clock reading, which is something this module measures and the
   pure formatter must not be able to. The three strings are the request's
   own and are NOT sanitized here — `accessLogLine` is what makes them safe
   to print, so one place decides that rather than one place per field. -}
data RequestTrace = RequestTrace String String String Float

{- | The trace for a request that reached the framer.

   A buffer that did not parse still gets one, with empty strings for the
   method and target it never supplied (`logToken` renders those as `-`): a
   buffer this server answers 400 is a request, and leaving it out of the log
   is the silence this instrumentation exists to remove. -}
traceFor : Result HttpParseFailure Request -> String -> Float -> RequestTrace
traceFor (Err _) client startedAt = RequestTrace "" "" client startedAt
traceFor (Ok request) client startedAt =
  RequestTrace (requestMethod request) (requestTarget request) client startedAt

{- | Write the one line this request gets.

   On STDOUT and not stderr, beside the banner and the readiness line: an
   answered request is not a fault, and reporting every one of them through
   `ePutStrLn` would put ordinary traffic in the same stream as a persist
   failure. Flushed per line for the reason `ready` flushes (`pds/serve.mdk`):
   stdout is block-buffered when it is a file or a pipe, and a log whose last
   lines are lost whenever the process is killed is not one an operator can
   read after an incident. -}
logAccess : RequestTrace -> Int -> Int -> <Clock, Stdout> Unit
logAccess (RequestTrace method target client startedAt) status responseBytes =
  let () =
    putStrLn
      (accessLogLine AccessEvent {
        method = method,
        path = target,
        status = status,
        responseBytes = responseBytes,
        durationMillis = floatToInt ((monotonic () - startedAt) * 1000.0),
        client = client,
      })
  flushStdout ()

-- | The same line for a response this module holds the serialized bytes of,
-- which is every exit but the admitted subscription upgrade. Reading the
-- status back off the bytes is what makes the funnel exhaustive rather than
-- sampled: an exit added later carries its own status to the log by
-- construction, having nothing else to pass.
logAccessBytes : RequestTrace -> Array Int -> <Clock, Stdout> Unit
logAccessBytes trace responseBytes =
  logAccess trace (responseStatusCode responseBytes) (arrayLength responseBytes)

-- The rate-limit decision is taken here, once per framed request, because
-- this is the one place that holds both the parsed `Request` (headers, for
-- `identifyClient`, and target, for the routed NSID) and the point of
-- admission: a refusal is answered without ever calling `applyRequest`, so a
-- rate-limited request costs a parse and a `step`, not a store transition.
respond : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Int ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
respond server dir storeRef limiterRef census serving conn slot buf boundary firstRequest =
  defer
    nowSeconds <- liftIO (u => floatToInt (now ()))
    -- The monotonic reading and not the wall-clock one above: a duration
    -- measured across a wall-clock adjustment is not a duration.
    startedAt <- liftIO (u => monotonic ())
    respondAt
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      buf
      boundary
      firstRequest
      nowSeconds
      startedAt

respondAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Int ->
  Bool ->
  Int ->
  Float ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
respondAt server dir storeRef limiterRef census serving conn slot buf boundary firstRequest nowSeconds startedAt =
  let parsed = parseRequestAt (readBufferBacking buf) 0 boundary
  let keepAlive = match parsed
    Ok request => requestKeepAlive request
    Err _ => False
  let rest = readBufferFrom boundary buf
  -- The framed request's own bytes stop being buffered here, whatever this
  -- server goes on to answer with them: `rest` holds only what arrived after
  -- the boundary, so the budget gets everything this connection held for the
  -- request back now rather than at the connection's retirement. A kept-alive
  -- connection that serves a thousand requests therefore holds one request's
  -- bytes at a time, not a thousand.
  let () =
    rebaseReadBufferCharge
      (servingBufferCensus serving)
      buf
      (readBufferLen buf - boundary)
  let identified = admissionIdentity (servingTrustedProxy serving) parsed
  -- Built once, here, and carried down every branch below: the log's identity
  -- is the one the request was CHARGED under, so a refused `X-Forwarded-For`
  -- is logged as the shared `direct` bucket it actually counted against
  -- rather than as the value it claimed.
  let trace =
    traceFor parsed (identityLabel (chargedIdentity identified)) startedAt
  let charged =
    applyRateLimit
      limiterRef
      (chargedIdentity identified)
      (admissionClasses firstRequest parsed)
      nowSeconds
  {- The answer owed before any classification runs: the rate-limit refusal,
     the refused-identity refusal, or the preflight answer. The preflight is
     taken AFTER the charge rather than before it, because `applyRateLimit`'s
     contract is that every buffer reaching the framer is charged — a
     preflight costs the same parse and response as anything else, and
     answering one for free would be the unmetered work channel that contract
     exists to close. The refused identity is taken after the charge for the
     same reason, and after the 429 because the 429 carries the `RateLimit-*`
     fields a client needs to retry; either way it is answered, never routed.
     Only the refusals are passed through `withAllowOrigin`:
     `preflightResponse` already carries its own complete header set,
     allow-origin included. -}
  let earlyAnswer = match charged
    Some refusal => Some (withAllowOrigin refusal)
    None => match identified
      Err message => Some (withAllowOrigin (forwardedForRefusal message))
      Ok _ => preflightAnswer parsed
  match earlyAnswer
    Some response =>
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        rest
        keepAlive
        trace
        (serializeResponse response)
    None => defer
      decision <- liftIO (u =>
        upgradeDecision server storeRef nowSeconds parsed)
      match decision
        UpgradeAdmitted admission =>
          admitSubscription
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            trace
            admission
        UpgradeRefused refusal =>
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            False
            trace
            (serializeResponse (withAllowOrigin refusal))
        NotAnUpgrade => defer
          proxy <- liftIO (u =>
            proxyDecisionFor server serving storeRef nowSeconds parsed)
          match proxy
            ProxyAdmitted admission =>
              forwardProxied
                server
                dir
                storeRef
                limiterRef
                census
                serving
                conn
                slot
                rest
                keepAlive
                nowSeconds
                (chargedIdentity identified)
                trace
                admission
            ProxyRefused refusal =>
              sendAndContinue
                server
                dir
                storeRef
                limiterRef
                census
                serving
                conn
                slot
                rest
                keepAlive
                trace
                (serializeResponse (withAllowOrigin refusal))
            NotProxied => defer
              credential <- liftIO (u =>
                serviceAuthDecisionFor
                  server
                  serving
                  storeRef
                  nowSeconds
                  parsed)
              match credential
                ServiceAuthMinted claims =>
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    trace
                    (mintedTokenBytes serving claims)
                ServiceAuthRefused refusal =>
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    trace
                    (serializeResponse (withAllowOrigin refusal))
                NotServiceAuth => defer
                  response <- liftIO (u =>
                    applyRequest
                      server
                      dir
                      storeRef
                      (sliceClamped 0 boundary (readBufferBacking buf)))
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    trace
                    response

-- ── the appview-proxy path ──────────────────────────────────────────────────

{- | Whether this request asked to be proxied, asked of the pure core
   (`lib.server_core`'s `classifyProxy`) after the upgrade question and before
   `applyRequest`.

   A buffer that did not parse never asked: `classifyProxy` grades a `Request`,
   and there is not one. A server with no configured appview is handed `None`
   and refuses every `atproto-proxy` header, which is what keeps a deployment
   that configured no appview answering exactly as it did before.

   The nonce drawn here is what identifies any token minted for this request
   (`jti`), so it comes from `osEntropyBytes` per request, the same source
   `upgradeDecision` and `applyRequest` draw their own from.

   The store is read here for the reason `upgradeDecision` reads it: a forward
   is made on behalf of the logged-in account, so the seam resolves the
   caller's own credential against the open sessions before it admits one.
   Nothing about that transitions the store, so it does not belong inside
   `applyRequest`'s indivisible sequence, and an admitted forward never reaches
   `applyRequest` at all. -}
proxyDecisionFor : Server ->
  Serving ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> ProxyDecision
proxyDecisionFor _ _ _ _ (Err _) = NotProxied
proxyDecisionFor server serving storeRef nowSeconds (Ok request) =
  classifyProxy
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    (map egressAppviews (servingEgress serving))
    !storeRef
    request

{- | Whether this request asked for a service credential of its own, asked of
   the pure core (`lib.server_core`'s `classifyServiceAuth`) after the proxy
   question and before `applyRequest`.

   It is a separate question from the proxy one and is asked second, because
   the two never both apply: `com.atproto.server.getServiceAuth` is a route
   this server REGISTERS, so the proxy seam answers `NotProxied` for it
   whatever header it carries, and every request the proxy seam did admit or
   refuse has already left by the time this runs.

   It draws its OWN nonce, for the same reason `proxyDecisionFor` draws one: it
   is the `jti` of whatever credential is minted for this request, and two
   credentials sharing one would be indistinguishable to the peer that spends
   them. The two calls cannot both mint on one request, so nothing here reuses
   the other's.

   The store is read for the reason the proxy seam reads it: this route is
   gated on the caller's own access token, which is resolved against the open
   sessions. Nothing about that transitions the store, and a minted credential
   never reaches `applyRequest` at all. -}
serviceAuthDecisionFor : Server ->
  Serving ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> ServiceAuthDecision
serviceAuthDecisionFor _ _ _ _ (Err _) = NotServiceAuth
serviceAuthDecisionFor server serving storeRef nowSeconds (Ok request) =
  classifyServiceAuth
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    (map egressAppviews (servingEgress serving))
    !storeRef
    request

{- | What a client that asked for a service credential is answered: the
   credential, signed here with the account's own repo key.

   Nothing about the claim set is chosen here, and the parameter says so: a
   `ServiceAuthRequest` is the pure classifier's own output and there is no
   other way to obtain one, so the issuer, the audience, the method and the
   expiry all arrive already decided. This function signs, and the key never
   leaves `pds/shell/egress.mdk` — `egressMintToken` takes the claim set and
   returns a signature.

   `None` for the egress is unreachable: a `ServiceAuthMinted` decision is only
   produced when an `AppviewTable` was supplied, and the only source of one is
   a configured `Egress`. It answers the same 501 a deployment with no key
   configured gets, rather than a panic, for the reason the proxy path's
   unreachable `None` is a 502: a reachability argument is not a reason to add
   a crash path to a function a client can reach over the network.

   An `Err` from the mint is 500 and not 501: the key IS configured and the
   signature did not come out, which is this server failing rather than this
   server declining. -}
mintedTokenBytes : Serving -> ServiceAuthRequest -> Array Int
mintedTokenBytes serving claims = match servingEgress serving
  None => serializeResponse (withAllowOrigin serviceAuthUnavailableResponse)
  Some egress => match egressMintToken egress claims
    Err _ => serializeResponse (withAllowOrigin serviceAuthMintFailureResponse)
    Ok minted =>
      serializeResponse (withAllowOrigin (serviceAuthTokenResponse minted))

-- | What a client is told when the signature itself did not come out. The
-- reason is not in the body for the reason a proxied read's 502 does not carry
-- one: which internal step failed is this server's business and tells a client
-- nothing it can act on.
serviceAuthMintFailureResponse : Response
serviceAuthMintFailureResponse =
  xrpcErrorResponse
    500
    "Internal Server Error"
    "InternalServerError"
    "the service credential could not be signed"

{- | Make the one outbound call an admitted proxied read authorizes, and answer
   the client with what came back.

   The `ProxyClass` charge is taken HERE and not in `admissionClasses`, because
   only this point knows that a forward is actually going to happen: the class
   bounds outbound calls, and charging it from the nsid alone would charge a
   request that the audience check then refused, or one a server with no
   configured appview was never going to forward. A refusal at the class costs
   the client a 429 and this server no outbound work at all.

   Nothing about the call is decided here. `admission` already carries the
   target and the exact claim set, both produced by the pure classifier; this
   function chooses the identity it charges and nothing else.

   `None` for the egress is unreachable — a `ProxyAdmitted` decision is only
   produced when an `AppviewTable` was supplied, and the only source of one is
   a configured `Egress` — and it is answered 502 rather than by a panic: a
   reachability argument is not a reason to add a crash path to the one
   function a client can reach over the network. -}
forwardProxied : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  Int ->
  ClientIdentity ->
  RequestTrace ->
  ProxyAdmission ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
forwardProxied server dir storeRef limiterRef census serving conn slot rest keepAlive nowSeconds identity trace admission =
  match applyRateLimit limiterRef identity [ProxyClass] nowSeconds
    Some refusal =>
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        rest
        keepAlive
        trace
        (serializeResponse (withAllowOrigin refusal))
    None => match servingEgress serving
      None =>
        sendAndContinue
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          slot
          rest
          keepAlive
          trace
          (serializeResponse (withAllowOrigin proxyUpstreamFailureResponse))
      Some egress => defer
        admitted <- admitProxiedCall (servingProxyCensus serving)
        if not admitted then
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            keepAlive
            trace
            (serializeResponse (withAllowOrigin proxyCeilingResponse))
        else defer
          answered <- egressCall egress admission
          _ <- liftIO (u => releaseProxiedCall (servingProxyCensus serving))
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            keepAlive
            trace
            (proxyAnswerBytes answered)

{- | The bytes a proxied read answers with.

   Every way the call could fail collapses to one 502: which of them happened —
   the proxy refused the connection, a budget ran out, the answer did not decode
   — is this server's business and tells a client nothing it can act on, and
   distinguishing them in the body would describe this deployment's internals to
   whoever asked. -}
{- | What a proxied read past `maxConcurrentProxiedCalls` AND
   `maxQueuedProxiedCalls` is told.

   503 and not 502: nothing was asked of the upstream, so reporting a gateway
   failure would blame a service that was never called, and a caller that
   retries later is right to — what is refused here is what is in flight and
   queued now. That reading holds for both ways past the queue, the full queue
   and the deadline alike, which is why neither gets a code of its own: a
   client can act on "come back" and on nothing finer, and the two differ only
   in how long this server was willing to hold the call open first.

   The claim and the release around the call it guards are still the two halves
   of one decision, the way `admitSubscription`'s are: `admitProxiedCall`
   charges the slot at the one point the call is decided on — whether it took
   it directly or was handed it by `releaseProxiedCall` — and it is given back
   at the one point the call has finished. A refused call, on either path, was
   never charged one. -}
proxyCeilingResponse : Response
proxyCeilingResponse =
  xrpcErrorResponse
    503
    "Service Unavailable"
    "ProxyLimitExceeded"
    "too many proxied reads are in flight on this server"

proxyAnswerBytes : Result String UpstreamAnswer -> Array Int
proxyAnswerBytes (Err _) =
  serializeResponse (withAllowOrigin proxyUpstreamFailureResponse)
proxyAnswerBytes (Ok answer) = match proxyUpstreamResponse answer
  Err _ => serializeResponse (withAllowOrigin proxyUpstreamFailureResponse)
  Ok response => serializeResponse response

-- ── the subscription upgrade path ───────────────────────────────────────────

{- | Whether this request is a subscription upgrade, asked of the pure core
   (`lib.server_core`'s `classifyUpgrade`) before `applyRequest` is called.

   A buffer that did not parse is never an upgrade: `classifyUpgrade` grades a
   `Request`, and there is not one. It is charged and answered exactly as
   before.

   The store is read here as well as inside `applyRequest`, and the two reads
   are deliberately not one: this one resolves the credential a GATED
   subscription route would be admitted against, and nothing about it
   transitions the store, so it does not belong inside the indivisible
   sequence `applyRequest`'s own header describes. An admitted upgrade never
   reaches `applyRequest` at all. -}
upgradeDecision : Server ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> UpgradeDecision
upgradeDecision _ _ _ (Err _) = NotAnUpgrade
upgradeDecision server storeRef nowSeconds (Ok request) =
  classifyUpgrade
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    !storeRef
    request

{- | Hand an admitted upgrade over to the streaming loop, or refuse it because
   the subscription ceiling is reached.

   The claim and the release are the two halves of ONE function on purpose. A
   subscription leaves through many paths — the peer closes, a write fails,
   the log becomes unreadable — and every one of them is a return from
   `runSubscription`, so releasing the slot HERE releases it on all of them by
   construction. A release inside the loop would have to be repeated at each
   of those returns, and a census one connection can fail to give back stops
   bounding anything.

   This is also where the request/response lifecycle ends for this connection.
   `requestTimeout` and `headerTimeout` were armed by `connectionLoop`, which
   this path never re-enters, so neither applies to a subscriber from here on
   — deliberately: they bound how long one REQUEST may take to arrive, and a
   firehose has no next request. `writeTimeout` is not request-scoped and does
   carry over, threaded into the loop as its per-write budget.
   `serveConnection` still closes the socket and retires `active` when this
   returns, so an upgraded connection's teardown needs no special case. -}
admitSubscription : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  RequestTrace ->
  UpgradeAdmission ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
admitSubscription server dir storeRef limiterRef census serving conn slot rest trace admission =
  if not (claimSubscription census) then
    sendAndContinue
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      rest
      False
      trace
      (serializeResponse (withAllowOrigin subscriptionCeilingResponse))
  else defer
    -- The one exit that does not hand `sendAndContinue` a response: the
    -- handshake is written inside `runSubscription`, and what follows it is a
    -- stream with no request/response shape at all. The line is written HERE,
    -- at admission, rather than when the stream ends — a subscription held
    -- open for hours would otherwise leave the request that opened it
    -- unlogged for the whole of that, which is exactly the silence a firehose
    -- deployment most needs not to have. The handshake is rebuilt from the
    -- same pure function `runSubscription` sends, so the byte count is the
    -- one the peer receives.
    _ <- liftIO (u =>
      logAccess
        trace
        upgradeStatus
        (arrayLength (handshakeResponseBytes admission.accept)))
    outcome <- runSubscription
      dir
      writeTimeout
      conn
      admission.accept
      admission.cursor
      (toArray (readBufferLive rest))
    _ <- liftIO (u => releaseSubscription census)
    deferPure outcome

-- The status `lib.websocket`'s `handshakeResponseBytes` writes. Named here
-- rather than parsed back off those bytes because this is the one exit whose
-- status is fixed by the protocol rather than chosen per request.
upgradeStatus : Int
upgradeStatus = 101

-- | What a subscriber past `maxConcurrentSubscriptions` is told, over ordinary
-- HTTP: the upgrade is never completed, so the refusal costs one response and
-- the caller holds nothing afterwards.
subscriptionCeilingResponse : Response
subscriptionCeilingResponse =
  xrpcErrorResponse
    503
    "Service Unavailable"
    "SubscriptionLimitExceeded"
    "too many event-stream subscriptions are open on this server"

-- ── sending a response ──────────────────────────────────────────────────────

sendAndContinue : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  RequestTrace ->
  Array Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
sendAndContinue server dir storeRef limiterRef census serving conn slot rest keepAlive trace responseBytes =
  defer
    sent <- A.sendAllWithin writeTimeout conn responseBytes
    -- Logged after the write and whatever it returned: a response this server
    -- produced and then failed to deliver is exactly what an operator is
    -- looking for, and a line only the successful writes reach would report a
    -- healthier server than the one that is running.
    _ <- liftIO (u => logAccessBytes trace responseBytes)
    match sent
      Err message => deferPure (Err message)
      Ok () =>
        if keepAlive then
          connectionLoop
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            False
        else
          deferPure (Ok ())

-- An unframeable buffer is still answered, by the same pure core: `handleBytes`
-- classifies it 400 or 413 exactly as it classifies a whole buffer handed to it
-- by any other caller. The connection then closes.
--
-- It is charged first, against the shared `direct` identity: a buffer no framer
-- can complete carries nothing this module may trust as an identity, and
-- answering it is still work. `baseClasses` and not `admissionClasses` because
-- there is no routed procedure to add a class for.
rejectBuffer : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  ReadBuffer ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
rejectBuffer server dir storeRef limiterRef conn buf firstRequest = defer
  nowSeconds <- liftIO (u => floatToInt (now ()))
  startedAt <- liftIO (u => monotonic ())
  rejectBufferAt
    server
    dir
    storeRef
    limiterRef
    conn
    buf
    firstRequest
    nowSeconds
    startedAt

rejectBufferAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  ReadBuffer ->
  Bool ->
  Int ->
  Float ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> (Result String Unit)
rejectBufferAt server dir storeRef limiterRef conn buf firstRequest nowSeconds startedAt =
  let charged =
    applyRateLimit
      limiterRef
      directIdentity
      (baseClasses firstRequest)
      nowSeconds
  -- Built directly rather than through `traceFor`, because there is no
  -- request to derive it from: a buffer no framer can complete has neither a
  -- method nor a target, and the identity is the shared `direct` bucket it
  -- was charged under above. The line is still written — an unframeable flood
  -- is precisely the traffic an operator needs to see.
  let trace = RequestTrace "" "" (identityLabel directIdentity) startedAt
  match charged
    Some refusal =>
      let bytes = serializeResponse (withAllowOrigin refusal)
      defer
        sent <- A.sendAllWithin writeTimeout conn bytes
        _ <- liftIO (u => logAccessBytes trace bytes)
        deferPure sent
    None => defer
      response <- liftIO (u =>
        applyRequest server dir storeRef (readBufferLive buf))
      sent <- A.sendAllWithin writeTimeout conn response
      _ <- liftIO (u => logAccessBytes trace response)
      deferPure sent
