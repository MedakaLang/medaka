{- | The native socket shell: a loopback accept loop and the per-connection
   HTTP/1.1 lifecycle around the pure protocol core.

   Nothing here knows what a request means. Bytes arrive from a socket, are
   framed by `lib.http`'s `scanRequestBoundaryFrom` and by nothing else, are
   handed whole to `lib.server_core`'s `handleBytes`, and the response bytes it
   returns go back out. The successor `Store` is persisted through `shell.persist`
   and `shell.blobfile` and then published into the one `Ref Store` every
   connection task shares.

   The listener binds the loopback address and only the loopback address: the
   address is a literal in `bindLoopback` and no parameter, argument, or
   configuration field reaches it. A caller chooses the port and nothing else.

   Every per-connection bound lives here rather than in `lib.resource_limits`
   because each is a `Duration` or a socket-scheduling count, neither of which
   the pure core can express. The one bound this module does NOT own is the
   per-request byte ceiling: `scanRequestBoundaryFrom` already refuses a buffer
   past `maxHttpRequestBytes`, so re-checking it here would be a second,
   divergent answer to a question `lib.http` has already settled. -}

import array.{sliceClamped}
import async.{Async, Wait, deadlineAfter, expired, liftIO, spawn}
import lib.cid.{Cid, cidToString}
import lib.http.{
  Header,
  HttpFrame(..),
  HttpParseFailure,
  HttpScan,
  Request,
  httpScanStart,
  makeHeader,
  parseRequestAt,
  requestHeaders,
  requestKeepAlive,
  Response,
  scanRequestBoundaryFrom,
  serializeResponse,
}
import lib.ratelimit.{
  ClientIdentity,
  RateLimitClass(..),
  RateLimitState,
  RateLimitVerdict(..),
  TrustedProxy,
  classAllowance,
  directIdentity,
  identifyClient,
  initRateLimitState,
  isCreateSessionNsid,
  isRepoExportNsid,
  isWriteNsid,
  remainingInClass,
  step,
}
import lib.repo.{Repo, repoCommitCid, repoExportBlocks, repoLatestCommit}
import lib.resource_limits.{rateLimitWindowSeconds}
import lib.server_core.{RequestContext(..), Server, handleBytes}
import lib.store.{
  Store,
  storeBlobEntries,
  storeBlobMimeIndex,
  storeBlobMimeType,
  storeRepo,
  storeSize,
}
import lib.xrpc.{
  rateLimitFailureWithHeaders,
  requestNsid,
  xrpcErrorResponse,
  xrpcFailureResponse,
}
import net.{Connection, Listener, listen}
import net_async as A
import shell.blobfile.{blobFileWrite}
import shell.persist.{persistSave}
import string.{toUtf8}
import time.{Duration, now, seconds}

-- | How long one connection may stay silent between reads before it is closed.
idleTimeout : Duration
idleTimeout = seconds 30

-- | How long one request may take to arrive in full, however many reads it
-- takes. Reset for each request on a kept-alive connection.
requestTimeout : Duration
requestTimeout = seconds 60

-- | How long writing one response may take before the connection is closed.
writeTimeout : Duration
writeTimeout = seconds 30

-- | Bytes asked for per read. The buffer grows by what actually arrives.
readChunkBytes : Int
readChunkBytes = 65536

{- | How many bytes of OS entropy each request is given.

   It identifies any token the request mints (`RequestContext`'s `nonce`,
   `lib.server_core`), so it is drawn from `osEntropyBytes` and never from
   `randomInt`, whose generator is a seeded SplitMix64 and predictable by
   construction. Sixteen bytes is the usual floor for a value an attacker must
   not be able to guess ahead of time. -}
requestNonceBytes : Int
requestNonceBytes = 16

{- | How many connections may be in flight at once. An accepted connection past
   the ceiling is closed immediately, without a read: answering it would need
   the very socket work the ceiling exists to bound. -}
maxConcurrentConnections : Int
maxConcurrentConnections = 256

{- | Bind the listening socket.

   The address is the literal below and is reachable no other way:
   `bindLoopback` takes a port and nothing else, so no configuration path can
   move this server off the loopback interface. -}
export
bindLoopback : Int -> <Net "_"> Result String Listener
bindLoopback port = listen "127.0.0.1" port

persistFailureBytes : Array Int
persistFailureBytes =
  serializeResponse
    (xrpcErrorResponse
      500
      "Internal Server Error"
      "InternalServerError"
      "Repository state could not be persisted")

{- | Apply one framed request to the shared `Store`.

   This function is the whole reason the shell has the shape it has, and it is
   deliberately ORDINARY, non-`Async` code: read the current store, transition
   it, persist the successor, publish the successor. A scheduler can only
   interleave tasks at an `Async` bind, and there is not one in this sequence —
   `handleBytes` is pure, the clock and entropy readings handed to it are plain
   synchronous `<Clock>`/`<Rand>` calls, and `persistTransition` performs plain
   synchronous `<FileRead, FileWrite>` for both halves, not a suspension. So the four steps run
   as one indivisible unit, and two concurrent connections cannot both read the
   same store and each publish over the other's write. Wrapping the persist in
   `liftIO`, or splitting these steps across two `Async` steps, silently
   reintroduces that lost update; every caller therefore reaches this through a
   SINGLE `liftIO`.

   A persist that fails does not publish: the in-memory store and the disk stay
   the same store, and the client is told the write did not happen. -}
applyRequest : Server ->
  String ->
  Ref Store ->
  Array Int ->
  <Clock, FileRead "_", FileWrite "_", Rand, Stderr> Array Int
applyRequest server dir storeRef bytes =
  let store = !storeRef
  let context = RequestContext {
    nowSeconds = floatToInt (now ()),
    nonce = osEntropyBytes requestNonceBytes,
  }
  let (next, response) = handleBytes server context store bytes
  match persistTransition dir store next
    Err message =>
      let () = ePutStrLn "serve: persist failed, state not advanced: \{message}"
      persistFailureBytes
    Ok () =>
      let () = storeRef := next
      response

{- | Persist whichever halves of the `Store` the transition moved.

   Each half is skipped when it did not move, so a read route rewrites neither
   the block graph nor the blob area. Neither is an `Async` step: this runs
   inside `applyRequest`'s single indivisible sequence, and a suspension
   between the two would let a second connection publish in the gap. -}
persistTransition : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistTransition dir before after = do
  () <- persistRepoHalf dir before after
  if blobsMoved before after then persistBlobHalf dir after else Ok ()

persistRepoHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistRepoHalf dir before after = match (storeRepo before, storeRepo after)
  (_, None) => Ok ()
  (None, Some next) => persistRepo dir next
  (Some prior, Some next) =>
    if headText prior == headText next then Ok () else persistRepo dir next

{- | Whether the blob half of the transition differs.

   Block COUNTS decide the byte half exactly: a blob's name is its content and
   `lib.store` exposes no way to remove one, so two blob halves of equal size
   hold equal blocks. The declared-type index is compared outright because it
   moves on its own — re-uploading identical bytes under a different declared
   MIME type leaves the count where it was — and `storeBlobMimeIndex` answers
   that without copying every blob's bytes, which `storeBlobEntries` would do
   on every read request. -}
blobsMoved : Store -> Store -> Bool
blobsMoved before after =
  storeSize before /= storeSize after
    || storeBlobMimeIndex before /= storeBlobMimeIndex after

{- | The type declared for a stored blob.

   The fallback is `com.atproto.sync.getBlob`'s own (`pds/lib/handlers.mdk`),
   so a blob inserted through the byte-only `storePut` — which no route uses —
   reads back after a restart as exactly what it served before one. -}
declaredMimeType : Store -> Cid -> String
declaredMimeType store cid = match storeBlobMimeType cid store
  Some declared => declared
  None => "application/octet-stream"

blobRows : Store -> List (Cid, String, Array Int)
blobRows store =
  map
    ((cid, bytes) => (cid, declaredMimeType store cid, bytes))
    (storeBlobEntries store)

-- Every blob is rewritten, not just the new one, exactly as `persistRepo`
-- rewrites the whole block graph: a blob file's name is its content, so
-- rewriting one already on disk promotes the same bytes over themselves.
persistBlobHalf : String ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistBlobHalf dir store = blobFileWrite dir (blobRows store)

headText : Repo -> String
headText repo = cidToString (repoCommitCid (repoLatestCommit repo))

persistRepo : String -> Repo -> <FileRead "_", FileWrite "_"> Result String Unit
persistRepo dir repo = do
  blocks <- repoExportBlocks repo
  persistSave dir (repoCommitCid (repoLatestCommit repo)) blocks

-- One rate-limit decision, taken against every class this request must
-- clear: `ConnectionsClass` only on a connection's first framed request (a
-- kept-alive connection is "opened" once, not once per pipelined request),
-- `RequestsClass` always, and `WritesClass`/`CreateSessionClass`/
-- `RepoExportClass` when the routed NSID is one of the write procedures,
-- `createSession`, or a whole-repository export. A refusal at an earlier
-- class in the list short-circuits: a request already being refused should
-- not also spend a later class's budget it never reached.
data RateLimitAdmission =
  | RequestAdmitted RateLimitState
  | RequestRefused RateLimitState RateLimitClass

-- | What every request that reached the framer clears, whatever it routes to
-- and whether or not it parsed.
baseClasses : Bool -> List RateLimitClass
baseClasses firstRequest =
  (if firstRequest then [ConnectionsClass] else []) ++ [RequestsClass]

-- | The extra classes the routed procedure adds. A request that did not parse
-- has no routed procedure and so adds none.
nsidClasses : Result HttpParseFailure Request -> List RateLimitClass
nsidClasses (Err _) = []
nsidClasses (Ok request) = match requestNsid request
  None => []
  Some name =>
    (if isWriteNsid name then [WritesClass] else [])
      ++ (if isCreateSessionNsid name then [CreateSessionClass] else [])
      ++ (if isRepoExportNsid name then [RepoExportClass] else [])

{- | The classes one framed request is charged against, and — below — the
   identity it is charged to.

   No two arguments on this path share a type: the trust assertion is a
   `TrustedProxy`, the first-request flag a `Bool`, the parse outcome a
   `Result`. That is a constraint on any future edit here, not an accident of
   spelling. A charge decided from several same-typed positional flags is
   wrong-but-plausible when two are crossed, and a crossed charge is a 429 for
   the wrong client that no output distinguishes from a correct one — so the
   only thing that can catch it is the type checker. -}
admissionClasses : Bool ->
  Result HttpParseFailure Request ->
  List RateLimitClass
admissionClasses firstRequest parsed =
  baseClasses firstRequest ++ nsidClasses parsed

-- | An unparseable request carries no headers this module may trust, so it is
-- charged to the shared `direct` bucket rather than to a reconstructed
-- identity. Garbage is not the shape a legitimate client sends, so a shared
-- ceiling on it costs a well-behaved client nothing.
admissionIdentity : TrustedProxy ->
  Result HttpParseFailure Request ->
  ClientIdentity
admissionIdentity _ (Err _) = directIdentity
admissionIdentity trustedProxy (Ok request) =
  identifyClient trustedProxy (requestHeaders request)

admitClasses : RateLimitState ->
  ClientIdentity ->
  Int ->
  List RateLimitClass ->
  RateLimitAdmission
admitClasses state _ _ [] = RequestAdmitted state
admitClasses state identity nowSeconds (cls :: rest) =
  match step state identity cls nowSeconds
    (next, Refused) => RequestRefused next cls
    (next, Admitted) => admitClasses next identity nowSeconds rest

classMessage : RateLimitClass -> String
classMessage ConnectionsClass =
  "too many connections for this identity in the current window"
classMessage RequestsClass =
  "too many requests for this identity in the current window"
classMessage WritesClass =
  "too many write requests for this identity in the current window"
classMessage CreateSessionClass =
  "too many createSession attempts for this identity in the current window"
classMessage RepoExportClass =
  "too many repository exports for this identity in the current window"

intHeader : String -> Int -> Header
intHeader name value = match makeHeader name (toUtf8 "\{value}")
  Ok header => header
  Err message => panic "serve: internal rate-limit header error: \{message}"

-- `RateLimit-Reset` needs no state, only `now` and the shared window length:
-- every class resets on the same window boundary.
rateLimitHeaderList : RateLimitState ->
  ClientIdentity ->
  RateLimitClass ->
  Int ->
  List Header
rateLimitHeaderList state identity cls nowSeconds = [
  intHeader "ratelimit-limit" (classAllowance cls),
  intHeader
    "ratelimit-remaining"
    (remainingInClass state identity cls nowSeconds),
  intHeader
    "ratelimit-reset"
    (rateLimitWindowSeconds - nowSeconds % rateLimitWindowSeconds),
]

-- | `None` admits; `Some` is the 429 to send instead of doing any real work.
-- Every buffer that reached the framer is charged, a parse failure included:
-- answering one costs a parse and a response, so an uncharged failure is a
-- work channel with no ceiling on it at all.
applyRateLimit : Ref RateLimitState ->
  ClientIdentity ->
  List RateLimitClass ->
  Int ->
  Option Response
applyRateLimit limiterRef identity classes nowSeconds =
  match admitClasses !limiterRef identity nowSeconds classes
    RequestAdmitted next =>
      let () = limiterRef := next
      None
    RequestRefused next cls =>
      let () = limiterRef := next
      Some
        (xrpcFailureResponse
          (rateLimitFailureWithHeaders
            (classMessage cls)
            (rateLimitHeaderList next identity cls nowSeconds)))

{- | Accept connections until the listener fails or is closed, running each on
   its own task, never more than `maxConcurrentConnections` at a time.
   `trustedProxy` is `--trusted-proxy`'s value, unchanged for the life of the
   listener: whether this process's peer is a configured trusted proxy is an
   operator assertion about the deployment, not a per-connection fact this
   process can observe. -}
export
runServer : Server ->
  String ->
  Ref Store ->
  Listener ->
  TrustedProxy ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
runServer server dir storeRef lis trustedProxy = defer
  active <- liftIO (u => Ref 0)
  limiterRef <- liftIO (u => Ref initRateLimitState)
  acceptLoop server dir storeRef lis active limiterRef trustedProxy

acceptLoop : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref RateLimitState ->
  TrustedProxy ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
acceptLoop server dir storeRef lis active limiterRef trustedProxy = defer
  accepted <- A.accept lis
  acceptStep server dir storeRef lis active limiterRef trustedProxy accepted

acceptStep : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref RateLimitState ->
  TrustedProxy ->
  Result String Connection ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
acceptStep _ _ _ _ _ _ _ (Err message) = deferPure (Err message)
acceptStep server dir storeRef lis active limiterRef trustedProxy (Ok conn) =
  if !active >= maxConcurrentConnections then defer
    _ <- A.close conn
    acceptLoop server dir storeRef lis active limiterRef trustedProxy
  else
    let () = active := !active + 1
    defer
      _ <- spawn
        (serveConnection
          server
          dir
          storeRef
          limiterRef
          trustedProxy
          conn
          active)
      acceptLoop server dir storeRef lis active limiterRef trustedProxy

-- The counter is decremented on every exit path because the close and the
-- decrement are the continuation of the loop, not something inside it.
serveConnection : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Ref Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> Unit
serveConnection server dir storeRef limiterRef trustedProxy conn active = defer
  _ <- connectionLoop server dir storeRef limiterRef trustedProxy conn [||] True
  _ <- A.close conn
  liftIO (u => active := !active - 1)

{- | Serve requests over one connection until it closes, fails, or times out.
   `pending` is what a previous request left behind: a pipelined client sends
   the next request in the same packet as the last, so the loop scans what it
   already holds before it reads anything more. `firstRequest` is True only
   for the connection's own first framed request — it is what makes
   `ConnectionsClass` a per-connection charge rather than a per-request one. -}
connectionLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Array Int ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
connectionLoop server dir storeRef limiterRef trustedProxy conn pending firstRequest =
  defer
    deadline <- deadlineAfter requestTimeout
    frameLoop
      server
      dir
      storeRef
      limiterRef
      trustedProxy
      conn
      deadline
      pending
      httpScanStart
      firstRequest

-- `scanRequestBoundaryFrom` is the ONLY notion of a complete request in this
-- module: nothing here inspects a byte of the buffer on its own. The `HttpScan`
-- it hands back is carried to the next read so that a trickling client costs
-- what it sent rather than what it has sent so far; it is opaque here, and a
-- new request starts from `httpScanStart` in `connectionLoop` because
-- `respond` hands the next request a buffer rebased on its own first byte.
frameLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Wait ->
  Array Int ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
frameLoop server dir storeRef limiterRef trustedProxy conn deadline buf scan firstRequest =
  match scanRequestBoundaryFrom buf 0 scan
    (HttpFramedAt boundary, _) =>
      respond
        server
        dir
        storeRef
        limiterRef
        trustedProxy
        conn
        buf
        boundary
        firstRequest
    (HttpFrameFailed _, _) =>
      rejectBuffer server dir storeRef limiterRef conn buf firstRequest
    (HttpNeedMore, resumed) => defer
      late <- expired deadline
      if late then
        deferPure (Err "request deadline exceeded")
      else
        readMore
          server
          dir
          storeRef
          limiterRef
          trustedProxy
          conn
          deadline
          buf
          resumed
          firstRequest

readMore : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Wait ->
  Array Int ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
readMore server dir storeRef limiterRef trustedProxy conn deadline buf scan firstRequest =
  defer
    received <- A.recvWithin idleTimeout conn readChunkBytes
    match received
      Err message => deferPure (Err message)
      Ok bytes =>
        if arrayLength bytes == 0 then
          deferPure (endOfStream buf)
        else
          frameLoop
            server
            dir
            storeRef
            limiterRef
            trustedProxy
            conn
            deadline
            (buf ++ bytes)
            scan
            firstRequest

-- A peer that closes between requests has finished; one that closes part way
-- through a request has not.
endOfStream : Array Int -> Result String Unit
endOfStream buf =
  if arrayLength buf == 0 then Ok () else Err "connection closed mid-request"

-- The rate-limit decision is taken here, once per framed request, because
-- this is the one place that holds both the parsed `Request` (headers, for
-- `identifyClient`, and target, for the routed NSID) and the point of
-- admission: a refusal is answered without ever calling `applyRequest`, so a
-- rate-limited request costs a parse and a `step`, not a store transition.
respond : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Array Int ->
  Int ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
respond server dir storeRef limiterRef trustedProxy conn buf boundary firstRequest =
  defer
    nowSeconds <- liftIO (u => floatToInt (now ()))
    respondAt
      server
      dir
      storeRef
      limiterRef
      trustedProxy
      conn
      buf
      boundary
      firstRequest
      nowSeconds

respondAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Array Int ->
  Int ->
  Bool ->
  Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
respondAt server dir storeRef limiterRef trustedProxy conn buf boundary firstRequest nowSeconds =
  let parsed = parseRequestAt buf 0 boundary
  let keepAlive = match parsed
    Ok request => requestKeepAlive request
    Err _ => False
  let rest = sliceClamped boundary (arrayLength buf) buf
  let charged =
    applyRateLimit
      limiterRef
      (admissionIdentity trustedProxy parsed)
      (admissionClasses firstRequest parsed)
      nowSeconds
  match charged
    Some refusal =>
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        trustedProxy
        conn
        rest
        keepAlive
        (serializeResponse refusal)
    None => defer
      response <- liftIO (u =>
        applyRequest server dir storeRef (sliceClamped 0 boundary buf))
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        trustedProxy
        conn
        rest
        keepAlive
        response

sendAndContinue : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  TrustedProxy ->
  Connection ->
  Array Int ->
  Bool ->
  Array Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
sendAndContinue server dir storeRef limiterRef trustedProxy conn rest keepAlive responseBytes =
  defer
    sent <- A.sendAllWithin writeTimeout conn responseBytes
    match sent
      Err message => deferPure (Err message)
      Ok () =>
        if keepAlive then
          connectionLoop
            server
            dir
            storeRef
            limiterRef
            trustedProxy
            conn
            rest
            False
        else
          deferPure (Ok ())

-- An unframeable buffer is still answered, by the same pure core: `handleBytes`
-- classifies it 400 or 413 exactly as it classifies a whole buffer handed to it
-- by any other caller. The connection then closes.
--
-- It is charged first, against the shared `direct` identity: a buffer no framer
-- can complete carries nothing this module may trust as an identity, and
-- answering it is still work. `baseClasses` and not `admissionClasses` because
-- there is no routed procedure to add a class for.
rejectBuffer : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  Array Int ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
rejectBuffer server dir storeRef limiterRef conn buf firstRequest = defer
  nowSeconds <- liftIO (u => floatToInt (now ()))
  rejectBufferAt server dir storeRef limiterRef conn buf firstRequest nowSeconds

rejectBufferAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  Array Int ->
  Bool ->
  Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
rejectBufferAt server dir storeRef limiterRef conn buf firstRequest nowSeconds =
  let charged =
    applyRateLimit
      limiterRef
      directIdentity
      (baseClasses firstRequest)
      nowSeconds
  match charged
    Some refusal =>
      A.sendAllWithin writeTimeout conn (serializeResponse refusal)
    None => defer
      response <- liftIO (u => applyRequest server dir storeRef buf)
      A.sendAllWithin writeTimeout conn response
