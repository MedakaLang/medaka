import shell.subscribe.{runSubscription}
import string.{toUtf8}
import time.{Duration, formatIso, fromEpochSeconds, now, seconds}
import vector.{Vector(..)}
import vector as V

{- | How long a connection in the BODY phase may go without delivering a new
   byte before it is closed (#2815).

   A PROGRESS budget, not a phase deadline: every read that delivers bytes
   starts it again, so an upload that keeps arriving is never closed on it
   however long it takes in total — `requestTimeout` is what bounds that. What
   it does close is the one shape nothing else bounded: a peer that terminates
   its headers, declares a `Content-Length`, and then sends nothing. That peer
   has left the un-framed census (`maxUnframedConnections`) behind, so the only
   budget left over it was the whole request's, and it held one of
   `maxConcurrentConnections` for the whole of that while delivering nothing.

   It is the body phase's per-read silence bound as well as its progress bound,
   and those are one question asked once rather than two: `recvWithin` parks
   until either bytes arrive or the budget passes, so a read that returns bytes
   restarts the budget and a read that returns nothing has consumed all of it.

   Deliberately its own constant rather than `headerTimeout`, whose value it
   coincides with: a header section is capped at `maxHttpHeaderBytes` while a
   body may carry megabytes, so the two answer different questions and diverge
   the moment either is tuned. -}
bodyProgressTimeout : Duration
bodyProgressTimeout = seconds 5

-- | How long one request may take to arrive in full, however many reads it
-- takes. Reset for each request on a kept-alive connection.
requestTimeout : Duration
requestTimeout = seconds 60

-- | How long writing one response may take before the connection is closed.
writeTimeout : Duration
writeTimeout = seconds 30

-- | Bytes asked for per read. The buffer grows by what actually arrives.
readChunkBytes : Int
readChunkBytes = 65536

{- | How many bytes of OS entropy each request is given.

   It identifies any token the request mints (`RequestContext`'s `nonce`,
   `lib.server_core`), so it is drawn from `osEntropyBytes` and never from
   `randomInt`, whose generator is a seeded SplitMix64 and predictable by
   construction. Sixteen bytes is the usual floor for a value an attacker must
   not be able to guess ahead of time.

   It is ALSO the salt a login's credential rehash is derived under
   (`applyCreateSession`, `pds/lib/handlers.mdk`), which is the only entropy a
   pure handler has, so the length is `lib.credential`'s `saltBytes` rather
   than its own sixteen: a nonce of some other length would make every rehash
   fail its salt admission and leave the credential silently unupgraded. -}
requestNonceBytes : Int
requestNonceBytes = saltBytes

{- | How many connections may be in flight at once. An accepted connection past
   the ceiling is closed immediately, without a read: answering it would need
   the very socket work the ceiling exists to bound. -}
maxConcurrentConnections : Int
maxConcurrentConnections = 256

{- | How many UN-FRAMED connections may be in flight at once (#2772) — a
   connection whose current request's header section has not been terminated
   yet, which is the state a caller can hold open while doing nothing and
   costing nothing.

   `maxConcurrentConnections` alone does not bound it: a caller that opens
   every slot and never terminates a header holds all 256 for as long as the
   read and request budgets allow, and every other caller is closed at accept
   for the whole of that. So this ceiling is deliberately a small fraction of
   that one. The un-framed state is not where a healthy connection spends any
   measurable time — a client that has sent a request has sent its headers
   with it.

   This ceiling does NOT bound an attacker without bounding legitimate
   concurrency (#2816): it is an admission gate ahead of
   `maxConcurrentConnections`, not a carved-out share of it, so once 64
   connections sit un-framed the 65th is refused regardless of how much of
   the 256 is free — legitimate callers included. An un-framed connection
   reaches no rate-limit class, so a single reconnecting source can hold the
   gate shut indefinitely at no cost to itself. Closing that gap needs a
   ceiling that distinguishes sources, which this one does not; see #2816.

   The charge is global rather than per-caller because no peer identity
   exists before headers: `accept` yields a `Connection` and the runtime has
   no `getpeername`, and `X-Forwarded-For` needs a parsed request. -}
maxUnframedConnections : Int
maxUnframedConnections = 64

{- | How many event-stream subscriptions may be open at once.

   A subscription is the one connection on this server with NO total lifetime
   bound at all: `requestTimeout` and `headerTimeout` are armed per request by
   `connectionLoop`, which an upgraded connection never re-enters, and that is
   correct — "how long may one request take to arrive" is not a question a
   firehose asks. What that leaves is a connection an attacker can open, hold
   silently, and pay nothing further for: it is charged `ConnectionsClass`
   once at open (`baseClasses`) and then costs no traffic, no CPU and no
   further allowance for the rest of its life.

   Without a ceiling of its own that is a denial strictly CHEAPER than the one
   #2816 already documents, on both of #2816's own axes: #2816's un-framed
   flood needs a continuous reconnect stream and reopens within
   `headerTimeout` once it stops, whereas held subscriptions need no further
   bytes and never reopen — and 256 of them would exhaust
   `maxConcurrentConnections` outright, closing this server to every route
   rather than to un-framed callers alone.

   So this ceiling is a small fraction of `maxConcurrentConnections` rather
   than a share of it: with 32 held, seven eighths of the connection census is
   still there for ordinary request/response traffic, and an attacker holding
   all 32 has denied subscriptions alone. Thirty-two is generous for what a
   real PDS serving ONE account needs — its subscribers are the handful of
   relays mirroring it, not its readers. Like every ceiling above it, an
   attempt past it is refused with a cheap answer rather than admitted and
   then dropped: an over-ceiling subscriber is told 503 over ordinary HTTP and
   never reaches the upgrade, so it costs this server one response and
   nothing ongoing. -}
maxConcurrentSubscriptions : Int
maxConcurrentSubscriptions = 32

{- | How many proxied reads may be in flight at once.

   The ceiling this one backs up is `maxHttpClientWireBytes`
   (`pds/lib/resource_limits.mdk`), which bounds ONE upstream response's
   accumulating buffer at about six megabytes. That bound is in LOGICAL bytes
   and the buffer holding them is a `Vector Int` — one tagged 64-bit word per
   byte, plus the doubling slack the vector carries — so one in-flight call
   costs resident memory an order of magnitude above its logical ceiling, and
   until this ceiling existed nothing bounded how many calls paid it at once:
   `maxConcurrentConnections` admits 256, and 256 of them exceed the memory of
   any box this server runs on. What that costs is not the caller's request —
   it is the process, and with it every account's connections and every open
   subscription.

   Eight is what a legitimate client asks for rather than a share of the
   connection census: a client rendering one view issues a handful of proxied
   reads together, and eight is that with room left. Like every ceiling above
   it, the call past it is refused with a cheap answer — a 503, and no
   outbound call made at all — rather than admitted and then dropped.

   It bounds CONCURRENCY, and `ProxyClass` (`pds/lib/ratelimit.mdk`) bounds
   RATE; neither substitutes for the other, because a caller well within its
   rate allowance still has all eight outstanding the moment the upstream is
   slow. A buffer representation that packed bytes as bytes would lower the
   per-call cost without removing the need for a ceiling on the count, which
   is why this is a ceiling rather than a stopgap. -}
maxConcurrentProxiedCalls : Int
maxConcurrentProxiedCalls = 8

{- | How long one request's header section may take to arrive in full (#2772).

   Distinct from `requestTimeout` and far shorter: a header section is capped
   at `maxHttpHeaderBytes` and is what a client sends first, so seconds are
   generous for it, whereas a whole request may legitimately carry megabytes
   of body and needs the longer budget. Bounding both with one number gave the
   cheapest state a caller can hold — headers half sent — the budget of the
   most expensive one.

   It bounds the header phase twice over, because either alone leaves a hole:
   as the deadline `frameLoop` tests, so that a caller trickling one byte at a
   time is closed on total elapsed time; and as the per-read timeout
   `readMore` uses while the headers are unterminated, so that a caller
   sending nothing at all is closed on it rather than sitting out a whole body
   budget before any deadline is looked at. -}
headerTimeout : Duration
headerTimeout = seconds 5

{- | Bind the listening socket to the given address and port.

   `pds/serve.mdk`'s `configure` is the only caller, and it refuses to reach
   here at all for a non-loopback address unless `--trusted-proxy` is also
   set (`requireTrustedBind`) — this function itself performs no such check,
   because it cannot: a bind address is a deployment fact, not something this
   process can verify about its own socket. -}
export
bindAddress : String -> Int -> <Net "_"> Result String Listener
bindAddress addr port = listen addr port

-- This response never reaches `lib.server_core`'s `handle`, so the
-- allow-origin header every response carries is added here rather than
-- inherited.
persistFailureBytes : Array Int
persistFailureBytes =
  serializeResponse
    (withAllowOrigin
      (xrpcErrorResponse
        500
        "Internal Server Error"
        "InternalServerError"
        "Repository state could not be persisted"))

{- | Apply one framed request to the shared `Store`.

   This function is the whole reason the shell has the shape it has, and it is
   deliberately ORDINARY, non-`Async` code: read the current store, transition
   it, persist the successor, publish the successor. A scheduler can only
   interleave tasks at an `Async` bind, and there is not one in this sequence —
   `handleBytes` is pure, the clock and entropy readings handed to it are plain
   synchronous `<Clock>`/`<Rand>` calls, and `persistTransition` performs plain
   synchronous `<FileRead, FileWrite>` for both halves, not a suspension. So the four steps run
   as one indivisible unit, and two concurrent connections cannot both read the
   same store and each publish over the other's write. Wrapping the persist in
   `liftIO`, or splitting these steps across two `Async` steps, silently
   reintroduces that lost update; every caller therefore reaches this through a
   SINGLE `liftIO`.

   A persist that fails does not publish: the in-memory store and the disk stay
   the same store, and the client is told the write did not happen. -}
applyRequest : Server ->
  String ->
  Ref Store ->
  Array Int ->
  <Clock, FileRead "_", FileWrite "_", Rand, Stderr> Array Int
applyRequest server dir storeRef bytes =
  let store = !storeRef
  let nowSeconds = floatToInt (now ())
  let context = RequestContext {
    nowSeconds = nowSeconds,
    nonce = osEntropyBytes requestNonceBytes,
  }
  let (next, response) = handleBytes server context store bytes
  let did = accountDid (serverAccount server)
  match persistTransition dir did nowSeconds store next
    Err message =>
      let () = ePutStrLn "serve: persist failed, state not advanced: \{message}"
      persistFailureBytes
    Ok () =>
      let () = storeRef := next
      response

{- | Persist whichever halves of the `Store` the transition moved.

   Each half is skipped when it did not move, so a read route rewrites neither
   the block graph nor the blob area. None is an `Async` step: this runs
   inside `applyRequest`'s single indivisible sequence, and a suspension
   between any two would let a second connection publish in the gap. -}
persistTransition : String ->
  String ->
  Int ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistTransition dir did nowSeconds before after = do
  () <- persistRepoHalf dir did nowSeconds before after
  () <- persistCredentialHalf dir before after
  () <- if blobsMoved before after then persistBlobHalf dir after else Ok ()
  persistPreferencesHalf dir before after

{- | Persist the preference half when the transition moved it, which
   `putPreferences` does (a wholesale replace) and every other route does
   not. Comparing the two lists is exactly `persistCredentialHalf`'s shape,
   one level simpler: there is no re-derivation case to distinguish, only
   "moved" or "did not". -}
persistPreferencesHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistPreferencesHalf dir before after =
  if storePreferences before == storePreferences after then
    Ok ()
  else
    persistPreferences dir (storePreferences after)

{- | Persist the account credential when the transition moved it, which one
   route does: a login whose stored record predates today's iteration count is
   re-derived onto it (`applyCreateSession`, `pds/lib/handlers.mdk`). Every
   other request leaves the credential where it was and writes nothing.

   A rewrite that failed would not publish the successor store either, so the
   next login re-derives against the record still on disk rather than against
   one nothing can verify. -}
persistCredentialHalf : String ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistCredentialHalf dir before after = match (
  storeCredential before,
  storeCredential after,
)
  (_, None) => Ok ()
  (None, Some next) => persistCredential dir next
  (Some prior, Some next) =>
    if credentialIterations prior == credentialIterations next
      && ctEqBytes (credentialDigest prior) (credentialDigest next) then
      Ok ()
    else
      persistCredential dir next

{- | Whether this transition produced a new commit.

   One question asked once: it is both the condition under which the block
   graph is rewritten and the condition under which a firehose event exists,
   and two spellings of it could disagree — which is exactly the divergence
   "commit persisted, event missing" is made of. -}
repoAdvanced : Store -> Store -> Bool
repoAdvanced before after = match (storeRepo before, storeRepo after)
  (_, None) => False
  (None, Some _) => True
  (Some prior, Some next) => headText prior /= headText next

{- | Persist the new commit and append the event announcing it, or neither.

   The order is stage, persist, promote, and it is what makes the pair
   indivisible under a crash as well as under a failure — `shell.eventlog`'s
   header sets out each crash point. A persist that fails takes the staged
   entry back down with it, so a write the client was told did not happen
   leaves no event behind claiming it did. -}
persistRepoHalf : String ->
  String ->
  Int ->
  Store ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistRepoHalf dir did nowSeconds before after = match storeRepo after
  None => Ok ()
  Some next =>
    if not (repoAdvanced before after) then
      Ok ()
    else match stageCommitEvent dir did nowSeconds (storeRepo before) next
      Err message => Err message
      Ok () => match persistRepo dir next
        Err message => match eventLogDiscardStaged dir
          Err _ => Err message
          Ok () => Err message
        Ok () => eventLogPromote dir eventLogRetentionSeconds nowSeconds

-- The event for a commit, recorded as pending before the commit itself is
-- written. Its sequence number comes off disk rather than out of memory: a
-- relay's cursor has to survive this process, so the counter it indexes has
-- to as well.
stageCommitEvent : String ->
  String ->
  Int ->
  Option Repo ->
  Repo ->
  <FileRead "_", FileWrite "_"> Result String Unit
stageCommitEvent dir did nowSeconds before after = do
  seq <- eventLogNextSequence dir
  let time = formatIso (fromEpochSeconds nowSeconds)
  event <- syncCommitEventFor seq time did before after
  frame <- syncCommitFrame event
  eventLogStage dir EventLogEntry {
    seq = seq,
    timeSeconds = nowSeconds,
    commitCid = headText after,
    frameHex = encode frame,
  }

{- | Whether the blob half of the transition differs.

   Block COUNTS decide the byte half exactly: a blob's name is its content and
   `lib.store` exposes no way to remove one, so two blob halves of equal size
   hold equal blocks. The declared-type index is compared outright because it
   moves on its own — re-uploading identical bytes under a different declared
   MIME type leaves the count where it was — and `storeBlobMimeIndex` answers
   that without copying every blob's bytes, which `storeBlobEntries` would do
   on every read request. -}
blobsMoved : Store -> Store -> Bool
blobsMoved before after =
  storeSize before /= storeSize after
    || storeBlobMimeIndex before /= storeBlobMimeIndex after

{- | The type declared for a stored blob.

   The fallback is `com.atproto.sync.getBlob`'s own (`pds/lib/handlers.mdk`),
   so a blob inserted through the byte-only `storePut` — which no route uses —
   reads back after a restart as exactly what it served before one. -}
declaredMimeType : Store -> Cid -> String
declaredMimeType store cid = match storeBlobMimeType cid store
  Some declared => declared
  None => "application/octet-stream"

blobRows : Store -> List (Cid, String, Array Int)
blobRows store =
  map
    ((cid, bytes) => (cid, declaredMimeType store cid, bytes))
    (storeBlobEntries store)

-- Every blob is rewritten, not just the new one, exactly as `persistRepo`
-- rewrites the whole block graph: a blob file's name is its content, so
-- rewriting one already on disk promotes the same bytes over themselves.
persistBlobHalf : String ->
  Store ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistBlobHalf dir store = blobFileWrite dir (blobRows store)

headText : Repo -> String
headText repo = cidToString (repoCommitCid (repoLatestCommit repo))

persistRepo : String -> Repo -> <FileRead "_", FileWrite "_"> Result String Unit
persistRepo dir repo = do
  blocks <- repoExportBlocks repo
  persistSave dir (repoCommitCid (repoLatestCommit repo)) blocks

-- One rate-limit decision, taken against every class this request must
-- clear: `ConnectionsClass` only on a connection's first framed request (a
-- kept-alive connection is "opened" once, not once per pipelined request),
-- `RequestsClass` always, and `WritesClass`/`CreateSessionClass`/
-- `RepoExportClass` when the routed NSID is one of the write procedures,
-- `createSession`, or a whole-repository export. A refusal at an earlier
-- class in the list short-circuits: a request already being refused should
-- not also spend a later class's budget it never reached.
data RateLimitAdmission =
  | RequestAdmitted RateLimitState
  | RequestRefused RateLimitState RateLimitClass

-- | What every request that reached the framer clears, whatever it routes to
-- and whether or not it parsed.
baseClasses : Bool -> List RateLimitClass
baseClasses firstRequest =
  (if firstRequest then [ConnectionsClass] else []) ++ [RequestsClass]

-- | The extra classes the routed procedure adds. A request that did not parse
-- has no routed procedure and so adds none.
nsidClasses : Result HttpParseFailure Request -> List RateLimitClass
nsidClasses (Err _) = []
nsidClasses (Ok request) = match requestNsid request
  None => []
  Some name =>
    (if isWriteNsid name then [WritesClass] else [])
      ++ (if isCreateSessionNsid name then [CreateSessionClass] else [])
      ++ (if isRepoExportNsid name then [RepoExportClass] else [])

{- | The classes one framed request is charged against, and — below — the
   identity it is charged to.

   No two arguments on this path share a type: the trust assertion is a
   `TrustedProxy`, the first-request flag a `Bool`, the parse outcome a
   `Result`. That is a constraint on any future edit here, not an accident of
   spelling. A charge decided from several same-typed positional flags is
   wrong-but-plausible when two are crossed, and a crossed charge is a 429 for
   the wrong client that no output distinguishes from a correct one — so the
   only thing that can catch it is the type checker. -}
admissionClasses : Bool ->
  Result HttpParseFailure Request ->
  List RateLimitClass
admissionClasses firstRequest parsed =
  baseClasses firstRequest ++ nsidClasses parsed

-- | An unparseable request carries no headers this module may trust, so it is
-- charged to the shared `direct` bucket rather than to a reconstructed
-- identity. Garbage is not the shape a legitimate client sends, so a shared
-- ceiling on it costs a well-behaved client nothing.
admissionIdentity : TrustedProxy ->
  Result HttpParseFailure Request ->
  ClientIdentity
admissionIdentity _ (Err _) = directIdentity
admissionIdentity trustedProxy (Ok request) =
  identifyClient trustedProxy (requestHeaders request)

admitClasses : RateLimitState ->
  ClientIdentity ->
  Int ->
  List RateLimitClass ->
  RateLimitAdmission
admitClasses state _ _ [] = RequestAdmitted state
admitClasses state identity nowSeconds (cls :: rest) =
  match step state identity cls nowSeconds
    (next, Refused) => RequestRefused next cls
    (next, Admitted) => admitClasses next identity nowSeconds rest

classMessage : RateLimitClass -> String
classMessage ConnectionsClass =
  "too many connections for this identity in the current window"
classMessage RequestsClass =
  "too many requests for this identity in the current window"
classMessage WritesClass =
  "too many write requests for this identity in the current window"
classMessage CreateSessionClass =
  "too many createSession attempts for this identity in the current window"
classMessage RepoExportClass =
  "too many repository exports for this identity in the current window"
classMessage ProxyClass =
  "too many proxied appview reads for this identity in the current window"

intHeader : String -> Int -> Header
intHeader name value = match makeHeader name (toUtf8 "\{value}")
  Ok header => header
  Err message => panic "serve: internal rate-limit header error: \{message}"

-- `RateLimit-Reset` needs no state, only `now` and the shared window length:
-- every class resets on the same window boundary.
rateLimitHeaderList : RateLimitState ->
  ClientIdentity ->
  RateLimitClass ->
  Int ->
  List Header
rateLimitHeaderList state identity cls nowSeconds = [
  intHeader "ratelimit-limit" (classAllowance cls),
  intHeader
    "ratelimit-remaining"
    (remainingInClass state identity cls nowSeconds),
  intHeader
    "ratelimit-reset"
    (rateLimitWindowSeconds - nowSeconds % rateLimitWindowSeconds),
]

-- | `None` admits; `Some` is the 429 to send instead of doing any real work.
-- Every buffer that reached the framer is charged, a parse failure included:
-- answering one costs a parse and a response, so an uncharged failure is a
-- work channel with no ceiling on it at all.
applyRateLimit : Ref RateLimitState ->
  ClientIdentity ->
  List RateLimitClass ->
  Int ->
  Option Response
applyRateLimit limiterRef identity classes nowSeconds =
  match admitClasses !limiterRef identity nowSeconds classes
    RequestAdmitted next =>
      let () = limiterRef := next
      None
    RequestRefused next cls =>
      let () = limiterRef := next
      Some
        (xrpcFailureResponse
          (rateLimitFailureWithHeaders
            (classMessage cls)
            (rateLimitHeaderList next identity cls nowSeconds)))

{- | The two budgets one request is under at once: the header section's, and
   the whole request's. They travel as a pair rather than as two `Wait`
   arguments so that a call site cannot silently swap them — they have the
   same type and opposite meanings. -}
data Deadlines = Deadlines Wait Wait

{- | One connection's place in the un-framed census: the process-wide count,
   and whether THIS connection is still one of the connections it counts.

   The flag is what makes retirement idempotent. The count is retired at the
   first point the connection stops being un-framed and again on the exit
   path every connection leaves by, and a census one connection could
   decrement twice would drift below zero and stop bounding anything — an
   outage this process inflicts on itself, which nothing observes as an
   error. -}
data UnframedSlot = UnframedSlot (Ref Int) (Ref Bool)

{- | How many subscriptions are open right now, bounded by
   `maxConcurrentSubscriptions`.

   A type of its own rather than the bare `Ref Int` it wraps, for the reason
   `admissionClasses` states about its own arguments: `active` and `unframed`
   are already two same-typed counters travelling this module, and a third
   crossed with either would bound the wrong thing while still looking like a
   census — which no output distinguishes from a correct one. The type checker
   is what catches that, so the counters that travel furthest do not share a
   type. -}
data SubscriptionCensus = SubscriptionCensus (Ref Int)

-- | Take a subscription slot if one is free. `False` means the ceiling is
-- reached and nothing was charged.
claimSubscription : SubscriptionCensus -> Bool
claimSubscription (SubscriptionCensus open) =
  if !open >= maxConcurrentSubscriptions then
    False
  else
    let () = open := !open + 1
    True

-- | Give a subscription slot back. Called on the ONE path a claimed
-- subscription leaves by, so it needs no idempotence flag: unlike the
-- un-framed census there is no earlier point at which a subscription stops
-- being one.
releaseSubscription : SubscriptionCensus -> Unit
releaseSubscription (SubscriptionCensus open) = open := !open - 1

{- | How many proxied reads are in flight right now, bounded by
   `maxConcurrentProxiedCalls`.

   A type of its own for the reason `SubscriptionCensus` is one: it is a
   third same-typed counter travelling this module, and one crossed with
   another would bound the wrong resource while still looking like a census.
   Unlike the other two it rides on `Serving` rather than beside them,
   because the outbound path is the only thing that charges it and `Serving`
   is already what that path reads its configuration from. -}
data ProxyCensus = ProxyCensus (Ref Int)

-- | Take a proxied-call slot if one is free. `False` means the ceiling is
-- reached and nothing was charged.
claimProxiedCall : ProxyCensus -> Bool
claimProxiedCall (ProxyCensus inFlight) =
  if !inFlight >= maxConcurrentProxiedCalls then
    False
  else
    let () = inFlight := !inFlight + 1
    True

-- | Give a proxied-call slot back. Called on the ONE path a claimed call
-- leaves by, so it needs no idempotence flag: `egressCall` answers every
-- outcome it has with a `Result`, so there is no exit that skips the release.
releaseProxiedCall : ProxyCensus -> Unit
releaseProxiedCall (ProxyCensus inFlight) = inFlight := !inFlight - 1

-- | Retire this connection's un-framed charge, if it still holds one.
releaseUnframed : UnframedSlot -> Unit
releaseUnframed (UnframedSlot unframed held) =
  if !held then
    let () = held := False
    unframed := !unframed - 1

-- | Retire it as soon as the scan leaves the header section, whether or not a
-- whole request has framed yet: the body that may follow is bounded by
-- `bodyProgressTimeout`, `requestTimeout` and `maxHttpRequestBytes`, not by
-- this census.
releaseWhenHeadersDone : UnframedSlot -> HttpScan -> Unit
releaseWhenHeadersDone slot scan =
  if httpScanInHeaders scan then () else releaseUnframed slot

-- | Retire everything one connection holds, on the one path every connection
-- leaves by.
retireConnection : Ref Int -> UnframedSlot -> Unit
retireConnection active slot =
  let () = releaseUnframed slot
  active := !active - 1

{- | A connection's accumulated read bytes: `Vector Int`'s own backing array
   with spare capacity, and how many of its bytes are live. Appending a
   chunk (`readBufferAppend`) copies only the chunk, doubling the backing
   store when it doesn't fit — a request delivered in K reads costs
   O(bytes), not O(bytes × K), which `buf ++ bytes` on a plain `Array Int`
   would cost because `++` copies its whole left operand on every call. The
   doubling itself is `vector.pushArray`'s: this module no longer does its
   own capacity arithmetic.

   The live count is exactly what `scanRequestBoundaryWithin` calls `avail`:
   the backing array's own length is spare capacity, never received bytes,
   so nothing may read past it.

   Exported abstractly, with the operations below, for
   `pds/test/read_buffer_test.mdk`: the growth behavior is pure — a function
   of the bytes appended — and so can be asserted without a socket. The
   representation stays private — a caller outside this module cannot reach
   the `Vector`. -}
export data ReadBuffer = ReadBuffer (Vector Int)

-- | An empty buffer; the backing store is allocated on the first append.
export
readBufferNew : Unit -> ReadBuffer
readBufferNew _ = ReadBuffer (V.new ())

-- | How many bytes are live, in O(1): a `Ref Int` deref, never a traversal of
-- the backing store.
export
readBufferLen : ReadBuffer -> Int
readBufferLen (ReadBuffer v) = let (_, len) = V.rawParts v in len

readBufferIsEmpty : ReadBuffer -> Bool
readBufferIsEmpty buf = readBufferLen buf == 0

-- | The backing array, for a caller (`scanRequestBoundaryWithin`,
-- `parseRequestAt`) that is handed the live count separately and must never
-- read past it on its own. Zero-copy: `V.rawParts` hands back the vector's
-- own backing store.
export
readBufferBacking : ReadBuffer -> Array Int
readBufferBacking (ReadBuffer v) = let (backing, _) = V.rawParts v in backing

{- | Appends `bytes` in place. When the backing store doesn't fit them, it is
   replaced by a doubled one first, copying the live prefix once (`blit`);
   the append itself is one more `blit`, of exactly `arrayLength bytes`
   elements. Neither copy is proportional to bytes already buffered from
   earlier reads — `V.pushArray` grows at most once per call, to the
   smallest doubling that holds the result, however many capacity classes a
   single delivered chunk spans. -}
export
readBufferAppend : Array Int -> ReadBuffer -> Unit
readBufferAppend bytes (ReadBuffer v) = V.pushArray bytes v

{- | A fresh buffer holding the live bytes from `from` to the end — the
   leftover a finished request carries into the next one
   (`respondAt`'s `rest`). Copies the leftover once, the same single copy
   `sliceClamped` performed on the old `Array Int` representation. -}
readBufferFrom : Int -> ReadBuffer -> ReadBuffer
readBufferFrom from buf =
  let sliced = sliceClamped from (readBufferLen buf) (readBufferBacking buf)
  ReadBuffer (Vector (Ref sliced) (Ref (arrayLength sliced)))

-- | The live bytes as an ordinary array, for the one caller
-- (`rejectBufferAt`) that hands the whole buffer to `applyRequest` rather
-- than a scanned `[0, boundary)` prefix.
export
readBufferLive : ReadBuffer -> Array Int
readBufferLive buf = sliceClamped 0 (readBufferLen buf) (readBufferBacking buf)

{- | The deployment facts that are fixed for the life of the listener, travelling
   as one value because they travel together through every function below.

   `TrustedProxy` is `--trusted-proxy`'s value: whether this process's peer is a
   configured trusted proxy is an operator assertion about the deployment, not a
   per-connection fact this process can observe. The `Egress` is `None` unless
   `--appview-did` and `--egress-port` were both given, and `None` is what makes
   a server configured for no appview answer every `atproto-proxy` header the
   way it did before there was an outbound path at all.

   One value rather than three parameters, for the reason `admissionClasses`
   states about its own arguments: these are threaded through eleven functions
   whose argument lists are already long, and a pair of them crossed at one
   call site would charge the wrong identity or sign for the wrong appview
   while every signature still typechecked. The proxied-call census joins them
   for the same reason and not because it is configuration: it is the one
   counter only the outbound path charges, and this value is already on every
   function between `acceptLoop` and `forwardProxied`. -}
export data Serving = Serving TrustedProxy (Option Egress) ProxyCensus

export
makeServing : TrustedProxy -> Option Egress -> Ref Int -> Serving
makeServing trustedProxy egress inFlight =
  Serving trustedProxy egress (ProxyCensus inFlight)

export
servingTrustedProxy : Serving -> TrustedProxy
servingTrustedProxy (Serving trustedProxy _ _) = trustedProxy

servingEgress : Serving -> Option Egress
servingEgress (Serving _ egress _) = egress

servingProxyCensus : Serving -> ProxyCensus
servingProxyCensus (Serving _ _ census) = census

-- | Accept connections until the listener fails or is closed, running each on
-- its own task, never more than `maxConcurrentConnections` at a time.
export
runServer : Server ->
  String ->
  Ref Store ->
  Listener ->
  Serving ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
runServer server dir storeRef lis serving = defer
  active <- liftIO (u => Ref 0)
  unframed <- liftIO (u => Ref 0)
  subscriptions <- liftIO (u => Ref 0)
  limiterRef <- liftIO (u => Ref initRateLimitState)
  acceptLoop
    server
    dir
    storeRef
    lis
    active
    unframed
    limiterRef
    (SubscriptionCensus subscriptions)
    serving

acceptLoop : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref Int ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
acceptLoop server dir storeRef lis active unframed limiterRef census serving =
  defer
    accepted <- A.accept lis
    acceptStep
      server
      dir
      storeRef
      lis
      active
      unframed
      limiterRef
      census
      serving
      accepted

acceptStep : Server ->
  String ->
  Ref Store ->
  Listener ->
  Ref Int ->
  Ref Int ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Result String Connection ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
acceptStep _ _ _ _ _ _ _ _ _ (Err message) = deferPure (Err message)
acceptStep server dir storeRef lis active unframed limiterRef census serving (Ok conn) =
  -- Both ceilings close the connection the same way, without a read:
  -- answering it would need the very socket work either ceiling exists to
  -- bound. A connection is charged to the un-framed census here, before it
  -- has been read from, because that is the state it is accepted INTO.
  if !active >= maxConcurrentConnections
    || !unframed >= maxUnframedConnections then defer
    _ <- A.close conn
    acceptLoop server dir storeRef lis active unframed limiterRef census serving
  else
    let () = active := !active + 1
    let () = unframed := !unframed + 1
    defer
      _ <- spawn
        (serveConnection
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          active
          unframed)
      acceptLoop
        server
        dir
        storeRef
        lis
        active
        unframed
        limiterRef
        census
        serving

-- Both counters are decremented on every exit path because the close and the
-- decrement are the continuation of the loop, not something inside it. The
-- un-framed one is USUALLY retired earlier, the moment the header section
-- ends; `releaseUnframed` is idempotent so that this path can retire it
-- unconditionally without having to know whether that already happened.
serveConnection : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  Ref Int ->
  Ref Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> Unit
serveConnection server dir storeRef limiterRef census serving conn active unframed =
  defer
    held <- liftIO (u => Ref True)
    _ <- connectionLoop
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      (UnframedSlot unframed held)
      (readBufferNew ())
      True
    _ <- A.close conn
    liftIO (u => retireConnection active (UnframedSlot unframed held))

{- | Serve requests over one connection until it closes, fails, or times out.
   `pending` is what a previous request left behind: a pipelined client sends
   the next request in the same packet as the last, so the loop scans what it
   already holds before it reads anything more. `firstRequest` is True only
   for the connection's own first framed request — it is what makes
   `ConnectionsClass` a per-connection charge rather than a per-request one.

   Both budgets are armed here, once per request rather than once per
   connection: a kept-alive connection's second request gets its own header
   and request budgets, exactly as a fresh connection's first one does. -}
connectionLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
connectionLoop server dir storeRef limiterRef census serving conn slot pending firstRequest =
  defer
    deadline <- deadlineAfter requestTimeout
    headerDeadline <- deadlineAfter headerTimeout
    frameLoop
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      (Deadlines headerDeadline deadline)
      pending
      httpScanStart
      firstRequest

-- `scanRequestBoundaryWithin` is the ONLY notion of a complete request in this
-- module: nothing here inspects a byte of the buffer on its own. The `HttpScan`
-- it hands back is carried to the next read so that a trickling client costs
-- what it sent rather than what it has sent so far; it is opaque here, and a
-- new request starts from `httpScanStart` in `connectionLoop` because
-- `respond` hands the next request a buffer rebased on its own first byte.
frameLoop : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
frameLoop server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  let scanned =
    scanRequestBoundaryWithin (readBufferBacking buf) (readBufferLen buf) 0 scan
  match scanned
    (HttpFramedAt boundary, _) =>
      let () = releaseUnframed slot
      respond
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        buf
        boundary
        firstRequest
    (HttpFrameFailed _, _) =>
      let () = releaseUnframed slot
      rejectBuffer server dir storeRef limiterRef conn buf firstRequest
    (HttpNeedMore, resumed) =>
      -- A scan that has passed the header section is no longer un-framed in
      -- the sense the census bounds, even though no request has framed yet:
      -- what is still arriving is a body, under its own budgets.
      let () = releaseWhenHeadersDone slot resumed
      framePending
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        deadlines
        buf
        resumed
        firstRequest

-- The header budget is tested only while the header section is unterminated,
-- so a legitimate body that outlives it is not closed on it.
framePending : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
framePending server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  match deadlines
    Deadlines headerDeadline deadline => defer
      late <- expired deadline
      lateHeader <- expired headerDeadline
      if late then
        deferPure (Err "request deadline exceeded")
      else if lateHeader && httpScanInHeaders scan then
        deferPure (Err "header deadline exceeded")
      else
        readMore
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          slot
          deadlines
          buf
          scan
          firstRequest

readMore : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  Deadlines ->
  ReadBuffer ->
  HttpScan ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
readMore server dir storeRef limiterRef census serving conn slot deadlines buf scan firstRequest =
  defer
    received <- A.recvWithin (silenceBudget scan) conn readChunkBytes
    match received
      Err message => deferPure (Err message)
      Ok bytes =>
        if arrayLength bytes == 0 then
          deferPure (endOfStream buf)
        else
          let () = readBufferAppend bytes buf
          frameLoop
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            deadlines
            buf
            scan
            firstRequest

-- | How long this read may find nothing: whichever phase's budget the scan is
-- in. The deadline in `framePending` is only consulted between reads, so a peer
-- that sends nothing at all would otherwise sit out a read budget belonging to
-- some other phase before anything looked at the one it is actually in.
silenceBudget : HttpScan -> Duration
silenceBudget scan =
  if httpScanInHeaders scan then headerTimeout else bodyProgressTimeout

-- A peer that closes between requests has finished; one that closes part way
-- through a request has not.
endOfStream : ReadBuffer -> Result String Unit
endOfStream buf =
  if readBufferIsEmpty buf then Ok () else Err "connection closed mid-request"

-- The rate-limit decision is taken here, once per framed request, because
-- this is the one place that holds both the parsed `Request` (headers, for
-- `identifyClient`, and target, for the routed NSID) and the point of
-- admission: a refusal is answered without ever calling `applyRequest`, so a
-- rate-limited request costs a parse and a `step`, not a store transition.
respond : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Int ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
respond server dir storeRef limiterRef census serving conn slot buf boundary firstRequest =
  defer
    nowSeconds <- liftIO (u => floatToInt (now ()))
    respondAt
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      buf
      boundary
      firstRequest
      nowSeconds

respondAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Int ->
  Bool ->
  Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
respondAt server dir storeRef limiterRef census serving conn slot buf boundary firstRequest nowSeconds =
  let parsed = parseRequestAt (readBufferBacking buf) 0 boundary
  let keepAlive = match parsed
    Ok request => requestKeepAlive request
    Err _ => False
  let rest = readBufferFrom boundary buf
  let charged =
    applyRateLimit
      limiterRef
      (admissionIdentity (servingTrustedProxy serving) parsed)
      (admissionClasses firstRequest parsed)
      nowSeconds
  match charged
    Some refusal =>
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        rest
        keepAlive
        (serializeResponse refusal)
    None => defer
      decision <- liftIO (u =>
        upgradeDecision server storeRef nowSeconds parsed)
      match decision
        UpgradeAdmitted admission =>
          admitSubscription
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            admission
        UpgradeRefused refusal =>
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            False
            (serializeResponse refusal)
        NotAnUpgrade => defer
          proxy <- liftIO (u =>
            proxyDecisionFor server serving storeRef nowSeconds parsed)
          match proxy
            ProxyAdmitted admission =>
              forwardProxied
                server
                dir
                storeRef
                limiterRef
                census
                serving
                conn
                slot
                rest
                keepAlive
                nowSeconds
                (admissionIdentity (servingTrustedProxy serving) parsed)
                admission
            ProxyRefused refusal =>
              sendAndContinue
                server
                dir
                storeRef
                limiterRef
                census
                serving
                conn
                slot
                rest
                keepAlive
                (serializeResponse refusal)
            NotProxied => defer
              credential <- liftIO (u =>
                serviceAuthDecisionFor
                  server
                  serving
                  storeRef
                  nowSeconds
                  parsed)
              match credential
                ServiceAuthMinted claims =>
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    (mintedTokenBytes serving claims)
                ServiceAuthRefused refusal =>
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    (serializeResponse refusal)
                NotServiceAuth => defer
                  response <- liftIO (u =>
                    applyRequest
                      server
                      dir
                      storeRef
                      (sliceClamped 0 boundary (readBufferBacking buf)))
                  sendAndContinue
                    server
                    dir
                    storeRef
                    limiterRef
                    census
                    serving
                    conn
                    slot
                    rest
                    keepAlive
                    response

{- | Whether this request asked to be proxied, asked of the pure core
   (`lib.server_core`'s `classifyProxy`) after the upgrade question and before
   `applyRequest`.

   A buffer that did not parse never asked: `classifyProxy` grades a `Request`,
   and there is not one. A server with no configured appview is handed `None`
   and refuses every `atproto-proxy` header, which is what keeps a deployment
   that configured no appview answering exactly as it did before.

   The nonce drawn here is what identifies any token minted for this request
   (`jti`), so it comes from `osEntropyBytes` per request, the same source
   `upgradeDecision` and `applyRequest` draw their own from.

   The store is read here for the reason `upgradeDecision` reads it: a forward
   is made on behalf of the logged-in account, so the seam resolves the
   caller's own credential against the open sessions before it admits one.
   Nothing about that transitions the store, so it does not belong inside
   `applyRequest`'s indivisible sequence, and an admitted forward never reaches
   `applyRequest` at all. -}
proxyDecisionFor : Server ->
  Serving ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> ProxyDecision
proxyDecisionFor _ _ _ _ (Err _) = NotProxied
proxyDecisionFor server serving storeRef nowSeconds (Ok request) =
  classifyProxy
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    (map egressAppviews (servingEgress serving))
    !storeRef
    request

{- | Whether this request asked for a service credential of its own, asked of
   the pure core (`lib.server_core`'s `classifyServiceAuth`) after the proxy
   question and before `applyRequest`.

   It is a separate question from the proxy one and is asked second, because
   the two never both apply: `com.atproto.server.getServiceAuth` is a route
   this server REGISTERS, so the proxy seam answers `NotProxied` for it
   whatever header it carries, and every request the proxy seam did admit or
   refuse has already left by the time this runs.

   It draws its OWN nonce, for the same reason `proxyDecisionFor` draws one: it
   is the `jti` of whatever credential is minted for this request, and two
   credentials sharing one would be indistinguishable to the peer that spends
   them. The two calls cannot both mint on one request, so nothing here reuses
   the other's.

   The store is read for the reason the proxy seam reads it: this route is
   gated on the caller's own access token, which is resolved against the open
   sessions. Nothing about that transitions the store, and a minted credential
   never reaches `applyRequest` at all. -}
serviceAuthDecisionFor : Server ->
  Serving ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> ServiceAuthDecision
serviceAuthDecisionFor _ _ _ _ (Err _) = NotServiceAuth
serviceAuthDecisionFor server serving storeRef nowSeconds (Ok request) =
  classifyServiceAuth
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    (map egressAppviews (servingEgress serving))
    !storeRef
    request

{- | What a client that asked for a service credential is answered: the
   credential, signed here with the account's own repo key.

   Nothing about the claim set is chosen here, and the parameter says so: a
   `ServiceAuthRequest` is the pure classifier's own output and there is no
   other way to obtain one, so the issuer, the audience, the method and the
   expiry all arrive already decided. This function signs, and the key never
   leaves `pds/shell/egress.mdk` — `egressMintToken` takes the claim set and
   returns a signature.

   `None` for the egress is unreachable: a `ServiceAuthMinted` decision is only
   produced when an `AppviewTable` was supplied, and the only source of one is
   a configured `Egress`. It answers the same 501 a deployment with no key
   configured gets, rather than a panic, for the reason the proxy path's
   unreachable `None` is a 502: a reachability argument is not a reason to add
   a crash path to a function a client can reach over the network.

   An `Err` from the mint is 500 and not 501: the key IS configured and the
   signature did not come out, which is this server failing rather than this
   server declining. -}
mintedTokenBytes : Serving -> ServiceAuthRequest -> Array Int
mintedTokenBytes serving claims = match servingEgress serving
  None => serializeResponse serviceAuthUnavailableResponse
  Some egress => match egressMintToken egress claims
    Err _ => serializeResponse serviceAuthMintFailureResponse
    Ok minted => serializeResponse (serviceAuthTokenResponse minted)

-- | What a client is told when the signature itself did not come out. The
-- reason is not in the body for the reason a proxied read's 502 does not carry
-- one: which internal step failed is this server's business and tells a client
-- nothing it can act on.
serviceAuthMintFailureResponse : Response
serviceAuthMintFailureResponse =
  xrpcErrorResponse
    500
    "Internal Server Error"
    "InternalServerError"
    "the service credential could not be signed"

{- | Make the one outbound call an admitted proxied read authorizes, and answer
   the client with what came back.

   The `ProxyClass` charge is taken HERE and not in `admissionClasses`, because
   only this point knows that a forward is actually going to happen: the class
   bounds outbound calls, and charging it from the nsid alone would charge a
   request that the audience check then refused, or one a server with no
   configured appview was never going to forward. A refusal at the class costs
   the client a 429 and this server no outbound work at all.

   Nothing about the call is decided here. `admission` already carries the
   target and the exact claim set, both produced by the pure classifier; this
   function chooses the identity it charges and nothing else.

   `None` for the egress is unreachable — a `ProxyAdmitted` decision is only
   produced when an `AppviewTable` was supplied, and the only source of one is
   a configured `Egress` — and it is answered 502 rather than by a panic: a
   reachability argument is not a reason to add a crash path to the one
   function a client can reach over the network. -}
forwardProxied : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  Int ->
  ClientIdentity ->
  ProxyAdmission ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
forwardProxied server dir storeRef limiterRef census serving conn slot rest keepAlive nowSeconds identity admission =
  match applyRateLimit limiterRef identity [ProxyClass] nowSeconds
    Some refusal =>
      sendAndContinue
        server
        dir
        storeRef
        limiterRef
        census
        serving
        conn
        slot
        rest
        keepAlive
        (serializeResponse refusal)
    None => match servingEgress serving
      None =>
        sendAndContinue
          server
          dir
          storeRef
          limiterRef
          census
          serving
          conn
          slot
          rest
          keepAlive
          (serializeResponse proxyUpstreamFailureResponse)
      Some egress =>
        if not (claimProxiedCall (servingProxyCensus serving)) then
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            keepAlive
            (serializeResponse proxyCeilingResponse)
        else defer
          answered <- egressCall egress admission
          _ <- liftIO (u => releaseProxiedCall (servingProxyCensus serving))
          sendAndContinue
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            keepAlive
            (proxyAnswerBytes answered)

{- | The bytes a proxied read answers with.

   Every way the call could fail collapses to one 502: which of them happened —
   the proxy refused the connection, a budget ran out, the answer did not decode
   — is this server's business and tells a client nothing it can act on, and
   distinguishing them in the body would describe this deployment's internals to
   whoever asked. -}
{- | What a proxied read past `maxConcurrentProxiedCalls` is told.

   503 and not 502: nothing was asked of the upstream, so reporting a gateway
   failure would blame a service that was never called, and a caller that
   retries later is right to — the ceiling is on what is in flight now. The
   claim and the release around the call it guards are the two halves of one
   decision, the way `admitSubscription`'s are, so the slot is charged at the
   one point the call is decided on and given back at the one point it has
   finished. -}
proxyCeilingResponse : Response
proxyCeilingResponse =
  xrpcErrorResponse
    503
    "Service Unavailable"
    "ProxyLimitExceeded"
    "too many proxied reads are in flight on this server"

proxyAnswerBytes : Result String UpstreamAnswer -> Array Int
proxyAnswerBytes (Err _) = serializeResponse proxyUpstreamFailureResponse
proxyAnswerBytes (Ok answer) = match proxyUpstreamResponse answer
  Err _ => serializeResponse proxyUpstreamFailureResponse
  Ok response => serializeResponse response

{- | Whether this request is a subscription upgrade, asked of the pure core
   (`lib.server_core`'s `classifyUpgrade`) before `applyRequest` is called.

   A buffer that did not parse is never an upgrade: `classifyUpgrade` grades a
   `Request`, and there is not one. It is charged and answered exactly as
   before.

   The store is read here as well as inside `applyRequest`, and the two reads
   are deliberately not one: this one resolves the credential a GATED
   subscription route would be admitted against, and nothing about it
   transitions the store, so it does not belong inside the indivisible
   sequence `applyRequest`'s own header describes. An admitted upgrade never
   reaches `applyRequest` at all. -}
upgradeDecision : Server ->
  Ref Store ->
  Int ->
  Result HttpParseFailure Request ->
  <Rand> UpgradeDecision
upgradeDecision _ _ _ (Err _) = NotAnUpgrade
upgradeDecision server storeRef nowSeconds (Ok request) =
  classifyUpgrade
    server
    RequestContext {
      nowSeconds = nowSeconds,
      nonce = osEntropyBytes requestNonceBytes,
    }
    !storeRef
    request

{- | Hand an admitted upgrade over to the streaming loop, or refuse it because
   the subscription ceiling is reached.

   The claim and the release are the two halves of ONE function on purpose. A
   subscription leaves through many paths — the peer closes, a write fails,
   the log becomes unreadable — and every one of them is a return from
   `runSubscription`, so releasing the slot HERE releases it on all of them by
   construction. A release inside the loop would have to be repeated at each
   of those returns, and a census one connection can fail to give back stops
   bounding anything.

   This is also where the request/response lifecycle ends for this connection.
   `requestTimeout` and `headerTimeout` were armed by `connectionLoop`, which
   this path never re-enters, so neither applies to a subscriber from here on
   — deliberately: they bound how long one REQUEST may take to arrive, and a
   firehose has no next request. `writeTimeout` is not request-scoped and does
   carry over, threaded into the loop as its per-write budget.
   `serveConnection` still closes the socket and retires `active` when this
   returns, so an upgraded connection's teardown needs no special case. -}
admitSubscription : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  UpgradeAdmission ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
admitSubscription server dir storeRef limiterRef census serving conn slot rest admission =
  if not (claimSubscription census) then
    sendAndContinue
      server
      dir
      storeRef
      limiterRef
      census
      serving
      conn
      slot
      rest
      False
      (serializeResponse subscriptionCeilingResponse)
  else defer
    outcome <- runSubscription
      dir
      writeTimeout
      conn
      admission.accept
      admission.cursor
      (readBufferLive rest)
    _ <- liftIO (u => releaseSubscription census)
    deferPure outcome

-- | What a subscriber past `maxConcurrentSubscriptions` is told, over ordinary
-- HTTP: the upgrade is never completed, so the refusal costs one response and
-- the caller holds nothing afterwards.
subscriptionCeilingResponse : Response
subscriptionCeilingResponse =
  xrpcErrorResponse
    503
    "Service Unavailable"
    "SubscriptionLimitExceeded"
    "too many event-stream subscriptions are open on this server"

sendAndContinue : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  SubscriptionCensus ->
  Serving ->
  Connection ->
  UnframedSlot ->
  ReadBuffer ->
  Bool ->
  Array Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
sendAndContinue server dir storeRef limiterRef census serving conn slot rest keepAlive responseBytes =
  defer
    sent <- A.sendAllWithin writeTimeout conn responseBytes
    match sent
      Err message => deferPure (Err message)
      Ok () =>
        if keepAlive then
          connectionLoop
            server
            dir
            storeRef
            limiterRef
            census
            serving
            conn
            slot
            rest
            False
        else
          deferPure (Ok ())

-- An unframeable buffer is still answered, by the same pure core: `handleBytes`
-- classifies it 400 or 413 exactly as it classifies a whole buffer handed to it
-- by any other caller. The connection then closes.
--
-- It is charged first, against the shared `direct` identity: a buffer no framer
-- can complete carries nothing this module may trust as an identity, and
-- answering it is still work. `baseClasses` and not `admissionClasses` because
-- there is no routed procedure to add a class for.
rejectBuffer : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  ReadBuffer ->
  Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
rejectBuffer server dir storeRef limiterRef conn buf firstRequest = defer
  nowSeconds <- liftIO (u => floatToInt (now ()))
  rejectBufferAt server dir storeRef limiterRef conn buf firstRequest nowSeconds

rejectBufferAt : Server ->
  String ->
  Ref Store ->
  Ref RateLimitState ->
  Connection ->
  ReadBuffer ->
  Bool ->
  Int ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr | e> (Result String Unit)
rejectBufferAt server dir storeRef limiterRef conn buf firstRequest nowSeconds =
  let charged =
    applyRateLimit
      limiterRef
      directIdentity
      (baseClasses firstRequest)
      nowSeconds
  match charged
    Some refusal =>
      A.sendAllWithin writeTimeout conn (serializeResponse refusal)
    None => defer
      response <- liftIO (u =>
        applyRequest server dir storeRef (readBufferLive buf))
      A.sendAllWithin writeTimeout conn response
