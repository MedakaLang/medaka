{- | Native durable persistence for one account repository.

   A repository on disk is exactly two things: its head commit CID, and the block
   graph that head reaches. `persistSave` writes both; `persistLoad` reads both
   back. Neither reconstructs anything — rehydrating a `Repo` is `lib.repo`'s
   `repoFromBlocks`, which is pure, and which the caller reaches with the signing
   key it already holds from configuration (P14: the pure core performs no I/O,
   and this shell owns no reconstruction logic).

   The signing key is never persisted. It cannot be: nothing in this module's
   signatures is a `Repo` or a `SecretKey`, so there is no value here to write one
   out of. A reload therefore always needs the configured key, and
   `repoFromBlocks` rejects a graph whose head does not verify under it.

   The head file is written to a temporary path and promoted with `rename` after
   every block file is written, so a save that is interrupted by the process
   dying leaves the previous head pointing at a graph that is still wholly
   present. That ordering survives a power loss because each staged file is
   `fsync`ed before its `rename` and the containing directory after: without
   those barriers the kernel is free to make the `rename` visible before the
   block writes it was ordered after, and the head would name a graph that is
   not there. The credential file is staged and barriered the same way: it is
   written to a temporary path with `writeFilePrivate` (so the mode is 0600
   from the moment the bytes land, and stays 0600 across `rename`), `fsync`ed,
   then `rename`d onto the real path, then the containing directory is
   `fsync`ed.

   `dir` is the store's root, and the barriers of every directory written
   directly into it are this module's: `blocks/` (`shell.blockfile`) and
   `blobs/` (`shell.blobfile`) create themselves there and leave that dentry
   to the `fsync dir` `persistSave` performs after them. `dir`'s OWN dentry is
   written into a directory this store does not own, so a creation of `dir`
   barriers the directory above it — and only a creation, which keeps an
   operator's directory off the cost of every commit. -}

import array
import fs.{mkdirAll}
import hex.{encode}
import io.{writeFilePrivate}
import json.{Json, asArray, jArray, parse, stringify}
import path.{dirname}
import lib.cid.{Cid, cidFromString, cidToString}
import lib.credential.{
  CredentialRecord,
  credentialDigest,
  credentialIterations,
  credentialSalt,
}
import shell.blockfile.{blockFileRead, blockFileSweepStaging, blockFileWrite}

blocksDir : String -> String
blocksDir dir = "\{dir}/blocks"

-- The store root, created if it is not there, with the dentry that created
-- barriered into the directory above. See the header's last paragraph.
ensureRoot : String -> <FileRead "_", FileWrite "_"> Result String Unit
ensureRoot dir =
  if fileExists dir then
    Ok ()
  else do
    () <- mkdirAll dir
    fsync (dirname dir)

{- | Remove every block file staged beneath `<dir>/blocks/.staging` and never
   promoted or cleaned up — see `blockFileSweepStaging`'s doc comment for what
   this is and the one window it is safe to call in. -}
export
persistSweepStagedBlocks : String ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistSweepStagedBlocks dir = blockFileSweepStaging (blocksDir dir)

-- | Where the account's password credential is kept beneath `dir`.
export
credentialPath : String -> String
credentialPath dir = "\{dir}/credential"

-- The stored credential: iteration count, salt, and derived key, one per line.
-- The password is not among them and was never held here.
credentialText : CredentialRecord -> String
credentialText record =
  "\{intToString (credentialIterations record)}\n\{encode (credentialSalt record)}\n\{encode (credentialDigest record)}\n"

{- | Write the account's password credential beneath `dir`, at mode 0600.

   Both the first-run bootstrap (`pds/serve.mdk`) and the rehash a login
   performs when the stored record predates today's iteration count
   (`pds/shell/server.mdk`) go through here, so there is one spelling of the
   credential file's layout and one place its mode is decided. The mode is not
   advisory: `pds/serve.mdk` refuses to read a secret file any wider back. -}
export
persistCredential : String ->
  CredentialRecord ->
  <FileWrite "_"> Result String Unit
persistCredential dir record = do
  let staged = "\{credentialPath dir}.tmp"
  () <- match writeFilePrivate staged (credentialText record)
    Err message => Err "unwritable credential \{credentialPath dir}: \{message}"
    Ok () => Ok ()
  () <- fsync staged
  () <- rename staged (credentialPath dir)
  fsync dir

headPath : String -> String
headPath dir = "\{dir}/head"

{- | Whether `dir` already holds a persisted head pointer.

   This is presence alone, deliberately: a head that is present but does not
   load or verify under some particular signing key is still a head, and a
   caller deciding whether it may write a genesis repository over `dir` must
   ask this rather than asking whether `persistLoad` succeeded. -}
export
persistHasHead : String -> <FileRead "_"> Bool
persistHasHead dir = fileExists (headPath dir)

{- | Persist a repository's head commit CID and its complete block graph beneath
   `dir`. The blocks are written first: the head is the last thing to move, so it
   never names a graph that is not yet on disk.

   The closing `fsync dir` carries two promotions, not one: the head file's
   `rename`, and the dentry `blockFileWrite` wrote into `dir` on a store whose
   `blocks/` did not exist yet. That is why it comes after `blockFileWrite`
   rather than beside the head write it obviously belongs to. -}
export
persistSave : String ->
  Cid ->
  List (Cid, Array Int) ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistSave dir head blocks = do
  () <- ensureRoot dir
  () <- blockFileWrite (blocksDir dir) blocks
  let staged = "\{headPath dir}.tmp"
  () <- writeFile staged (cidToString head)
  () <- fsync staged
  () <- rename staged (headPath dir)
  fsync dir

{- | Read back the persisted head commit CID and every persisted block row.

   The rows are unverified disk bytes; `repoFromBlocks` is what verifies them, so
   a caller must never treat this result as trusted state on its own. -}
export
persistLoad : String ->
  <FileRead "_"> Result String (Cid, List (Cid, Array Int))
persistLoad dir = do
  text <- match readFile (headPath dir)
    Err message => Err "persist: unreadable head file: \{message}"
    Ok value => Ok value
  head <- match cidFromString text
    Err message => Err "persist: head file is not a CID: \{message}"
    Ok value => Ok value
  blocks <- blockFileRead (blocksDir dir)
  Ok (head, blocks)

preferencesPath : String -> String
preferencesPath dir = "\{dir}/preferences"

{- | Persist the account's whole `app.bsky` preference set beneath `dir`,
   staged then `rename`d exactly like the head file: a process that dies
   mid-write leaves the previous preference set readable, never a torn one. -}
export
persistPreferences : String ->
  List Json ->
  <FileRead "_", FileWrite "_"> Result String Unit
persistPreferences dir prefs = do
  () <- ensureRoot dir
  let staged = "\{preferencesPath dir}.tmp"
  () <- writeFile staged (stringify (jArray prefs))
  () <- fsync staged
  () <- rename staged (preferencesPath dir)
  fsync dir

{- | Read back the persisted preference set, or the empty list when `dir` has
   never had one written — a fresh account, or one that has never called
   `putPreferences`. -}
export
persistLoadPreferences : String -> <FileRead "_"> Result String (List Json)
persistLoadPreferences dir =
  if not (fileExists (preferencesPath dir)) then
    Ok []
  else do
    text <- match readFile (preferencesPath dir)
      Err message => Err "persist: unreadable preferences file: \{message}"
      Ok value => Ok value
    value <- match parse text
      Err message => Err "persist: preferences file is not JSON: \{message}"
      Ok value => Ok value
    match asArray value
      None => Err "persist: preferences file is not a JSON array"
      Some items => Ok (toList items)
