{- | Native durable persistence for one account repository.

   A repository on disk is exactly two things: its head commit CID, and the block
   graph that head reaches. `persistSave` writes both; `persistLoad` reads both
   back. Neither reconstructs anything — rehydrating a `Repo` is `lib.repo`'s
   `repoFromBlocks`, which is pure, and which the caller reaches with the signing
   key it already holds from configuration (P14: the pure core performs no I/O,
   and this shell owns no reconstruction logic).

   The signing key is never persisted. It cannot be: nothing in this module's
   signatures is a `Repo` or a `SecretKey`, so there is no value here to write one
   out of. A reload therefore always needs the configured key, and
   `repoFromBlocks` rejects a graph whose head does not verify under it.

   The head file is written to a temporary path and promoted with `rename` after
   every block file is written, so a save that is interrupted by the process
   dying leaves the previous head pointing at a graph that is still wholly
   present. That ordering survives a power loss because each staged file is
   `fsync`ed before its `rename` and the containing directory after: without
   those barriers the kernel is free to make the `rename` visible before the
   block writes it was ordered after, and the head would name a graph that is
   not there. Every file this module writes (the head, the credential, the
   preference set and the session set) is replaced that one way, through
   `shell.datadir`'s `replaceDurablyIn`: staged at mode 0600 from the moment
   the bytes land, `fsync`ed, `rename`d onto the real path, then the
   containing directory `fsync`ed.

   The store's root is the data directory (`shell.datadir`), which must
   already exist: `pds/serve.mdk` refuses to start without it, and nothing
   here creates it, since its own entry lives in a directory the server has
   no authority over. `blocks/` (`shell.blockfile`) and `blobs/`
   (`shell.blobfile`) create themselves there, and each creation barriers its
   own dentry into the root as it is made, so no directory's durability waits
   on a later call. -}

import array
import bytes.{Bytes}
import hex.{decode, encode}
import json.{Json, asArray, jArray, parse, stringify}
import string.{join, lines, split, toInt, trim}
import lib.cid.{Cid, cidFromString, cidToString}
import lib.credential.{
  CredentialRecord,
  credentialDigest,
  credentialIterations,
  credentialSalt,
}
import lib.store.{SessionRow(..)}
import shell.blockfile.{blockFileRead, blockFileSweepStaging, blockFileWrite}
import shell.datadir.{DataDir(..), replaceDurablyIn}

{- | Remove every block file staged beneath `blocks/.staging` and never
   promoted or cleaned up — see `blockFileSweepStaging`'s doc comment for what
   this is and the one window it is safe to call in. -}
export
persistSweepStagedBlocks : DataDir d ->
  <FileRead d, FileWrite d> Result String Unit
persistSweepStagedBlocks datadir = blockFileSweepStaging datadir

-- | Where the account's password credential is kept in the data directory.
export
credentialPath : DataDir d -> String @d
credentialPath (DataDir root) = "\{root}credential"

-- The stored credential: iteration count, salt, and derived key, one per line.
-- The password is not among them and was never held here.
credentialText : CredentialRecord -> String
credentialText record =
  "\{intToString (credentialIterations record)}\n\{encode (credentialSalt record)}\n\{encode (credentialDigest record)}\n"

{- | Write the account's password credential, at mode 0600.

   Both the first-run bootstrap (`pds/serve.mdk`) and the rehash a login
   performs when the stored record predates today's iteration count
   (`pds/shell/server.mdk`) go through here, so there is one spelling of the
   credential file's layout and one place its mode is decided. The mode is not
   advisory: `pds/serve.mdk` refuses to read a secret file any wider back. -}
export
persistCredential : DataDir d ->
  CredentialRecord ->
  <FileWrite d> Result String Unit
persistCredential (datadir@(DataDir root)) record =
  let target = credentialPath datadir
  match (replaceDurablyIn
    root
    "\{root}credential.tmp"
    target
    (credentialText record))
    Err message => Err "unwritable credential \{target}: \{message}"
    Ok () => Ok ()

headPath : DataDir d -> String @d
headPath (DataDir root) = "\{root}head"

{- | Whether the data directory already holds a persisted head pointer.

   This is presence alone, deliberately: a head that is present but does not
   load or verify under some particular signing key is still a head, and a
   caller deciding whether it may write a genesis repository there must ask
   this rather than asking whether `persistLoad` succeeded. -}
export
persistHasHead : DataDir d -> <FileRead d> Bool
persistHasHead datadir = fileExists (headPath datadir)

{- | Persist a repository's head commit CID, with every block of the graph
   that head reaches which the data directory does not already hold. `blocks` may
   be the whole graph, or only what it adds to a graph already persisted here:
   a block's name is its content and nothing removes one, so a block on disk
   is already the block the head needs. The blocks are written first: the head
   is the last thing to move, so it never names a graph that is not yet on
   disk.

   The head's closing barrier on the root publishes only its own `rename`: a
   `blocks/` that `blockFileWrite` had to create was barriered into the root
   when it was made. -}
export
persistSave : DataDir d ->
  Cid ->
  List (Cid, Bytes) ->
  <FileRead d, FileWrite d> Result String Unit
persistSave (datadir@(DataDir root)) head blocks = do
  () <- blockFileWrite datadir blocks
  replaceDurablyIn root "\{root}head.tmp" (headPath datadir) (cidToString head)

{- | Read back the persisted head commit CID and every persisted block row.

   The rows are unverified disk bytes; `repoFromBlocks` is what verifies them, so
   a caller must never treat this result as trusted state on its own. -}
export
persistLoad : DataDir d -> <FileRead d> Result String (Cid, List (Cid, Bytes))
persistLoad datadir = do
  text <- mapErr
    (message => "persist: unreadable head file: \{message}")
    (readFile (headPath datadir))
  head <- mapErr
    (message => "persist: head file is not a CID: \{message}")
    (cidFromString text)
  blocks <- blockFileRead datadir
  Ok (head, blocks)

preferencesPath : DataDir d -> String @d
preferencesPath (DataDir root) = "\{root}preferences"

{- | Persist the account's whole `app.bsky` preference set,
   staged then `rename`d exactly like the head file: a process that dies
   mid-write leaves the previous preference set readable, never a torn one. -}
export
persistPreferences : DataDir d -> List Json -> <FileWrite d> Result String Unit
persistPreferences (datadir@(DataDir root)) prefs =
  replaceDurablyIn
    root
    "\{root}preferences.tmp"
    (preferencesPath datadir)
    (stringify (jArray prefs))

{- | Read back the persisted preference set, or the empty list when none has
   ever been written — a fresh account, or one that has never called
   `putPreferences`. -}
export
persistLoadPreferences : DataDir d -> <FileRead d> Result String (List Json)
persistLoadPreferences datadir =
  if not (fileExists (preferencesPath datadir)) then
    Ok []
  else do
    text <- mapErr
      (message => "persist: unreadable preferences file: \{message}")
      (readFile (preferencesPath datadir))
    value <- mapErr
      (message => "persist: preferences file is not JSON: \{message}")
      (parse text)
    match asArray value
      None => Err "persist: preferences file is not a JSON array"
      Some items => Ok (toList items)

-- | Where the open session set is kept in the data directory. Exported
-- because `pds/serve.mdk` admits this file's mode before reading it back.
export
sessionsPath : DataDir d -> String @d
sessionsPath (DataDir root) = "\{root}sessions"

{- One row per line, space-separated, every fingerprint in hex. An open
   session is its access fingerprint, refresh fingerprint, expiry, and family;
   a consumed refresh token is the word `consumed`, its fingerprint, its
   family, the instant it was consumed, the instant the family ends, and, once
   a replay inside the grace window has opened a session from it, that
   session's refresh fingerprint. A five-field consumed row is one no replay
   has opened a session from. A superseded refresh token, one whose session a
   later replay closed, is the word `superseded`, its fingerprint, its family,
   and the instant that session would have stopped verifying. No
   field is a bearer token -- each fingerprint is a SHA-256 digest of one
   (`lib.store`'s `sessionFingerprint`), and a family is named by one -- so
   what this file holds cannot be presented to the server it was read from.

   A three-field row is an open session written before families existed. It
   is read as a family of its own, named by its refresh fingerprint and ending
   at its own expiry: that expiry was a login's or a rotation's instant plus
   the ninety-day refresh window, so the family ends no later than a family
   opened at that instant would. -}
sessionRowText : SessionRow -> String
sessionRowText (OpenSessionRow access refresh expires family) =
  "\{encode access} \{encode refresh} \{intToString expires} \{encode family}"
sessionRowText (ConsumedRefreshRow refresh family at ends replayed) =
  let fields =
    "consumed \{encode refresh} \{encode family} \{intToString at} \{intToString ends}"
  match replayed
    None => fields
    Some session => "\{fields} \{encode session}"
sessionRowText (SupersededRefreshRow refresh family until) =
  "superseded \{encode refresh} \{encode family} \{intToString until}"

sessionsText : List SessionRow -> String
sessionsText rows = join "\n" (map sessionRowText rows)

rowFingerprint : String -> Result String Bytes
rowFingerprint text =
  mapErr
    (message => "persist: sessions file has an invalid fingerprint: \{message}")
    (decode text)

rowInstant : String -> Result String Int
rowInstant text = match toInt text
  None => Err "persist: sessions file has a non-numeric instant"
  Some instant => Ok instant

parseSessionRow : String -> Result String SessionRow
parseSessionRow line = match split " " (trim line)
  ["superseded", refreshHex, familyHex, untilText] => do
    refresh <- rowFingerprint refreshHex
    family <- rowFingerprint familyHex
    until <- rowInstant untilText
    Ok (SupersededRefreshRow refresh family until)
  [accessHex, refreshHex, expiresText] => do
    access <- rowFingerprint accessHex
    refresh <- rowFingerprint refreshHex
    expires <- rowInstant expiresText
    Ok (OpenSessionRow access refresh expires refresh)
  [accessHex, refreshHex, expiresText, familyHex] => do
    access <- rowFingerprint accessHex
    refresh <- rowFingerprint refreshHex
    expires <- rowInstant expiresText
    family <- rowFingerprint familyHex
    Ok (OpenSessionRow access refresh expires family)
  ["consumed", refreshHex, familyHex, atText, endsText] => do
    refresh <- rowFingerprint refreshHex
    family <- rowFingerprint familyHex
    at <- rowInstant atText
    ends <- rowInstant endsText
    Ok (ConsumedRefreshRow refresh family at ends None)
  ["consumed", refreshHex, familyHex, atText, endsText, replayedHex] => do
    refresh <- rowFingerprint refreshHex
    family <- rowFingerprint familyHex
    at <- rowInstant atText
    ends <- rowInstant endsText
    replayed <- rowFingerprint replayedHex
    Ok (ConsumedRefreshRow refresh family at ends (Some replayed))
  _ => Err "persist: sessions file has a malformed row"

parseSessionRows : List String -> Result String (List SessionRow)
parseSessionRows [] = Ok []
parseSessionRows (line :: rest) =
  if trim line == "" then
    parseSessionRows rest
  else do
    row <- parseSessionRow line
    rows <- parseSessionRows rest
    Ok (row :: rows)

{- | Persist the open session set beneath `dir`, staged then `rename`d exactly
   like the credential file, and at the same 0600: a session row is not a
   bearer token but it is security-relevant state, and `pds/serve.mdk` refuses
   to read a secret file back at a wider mode.

   Writing this is what lets a restart readmit the sessions it had open, so a
   backup window or a version bump does not log every client out. -}
export
persistSessions : DataDir d ->
  List SessionRow ->
  <FileWrite d> Result String Unit
persistSessions (datadir@(DataDir root)) rows =
  let target = sessionsPath datadir
  match replaceDurablyIn root "\{root}sessions.tmp" target (sessionsText rows)
    Err message => Err "unwritable sessions \{target}: \{message}"
    Ok () => Ok ()

{- | Read back the persisted session set, or the empty list when none has
   ever been written.

   The rows are unverified disk bytes and are not live sessions on their own:
   an expired row is returned as readily as a current one, and the caller
   prunes against the instant it is starting at. -}
export
persistLoadSessions : DataDir d -> <FileRead d> Result String (List SessionRow)
persistLoadSessions datadir =
  if not (fileExists (sessionsPath datadir)) then
    Ok []
  else do
    text <- mapErr
      (message => "persist: unreadable sessions file: \{message}")
      (readFile (sessionsPath datadir))
    parseSessionRows (lines text)
