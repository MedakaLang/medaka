{- | The outbound half of a proxied read: one loopback call to the local egress
   proxy, driven over the same cooperative scheduler the inbound accept loop
   runs on.

   Nothing here decides WHETHER to call. `lib.server_core`'s `classifyProxy`
   has already graded the audience and the method and produced the exact claim
   set a token must carry; this module signs that claim set, serializes the
   request with `lib.httpclient`, and returns what came back. A call this
   module can make is a call that passed every check, because the only way to
   obtain the `ServiceAuthRequest` it signs is for that grading to have
   admitted the request.

   The same holds for a credential a client asks for outright
   (`egressMintToken`, answering `com.atproto.server.getServiceAuth`): the
   claim set is `classifyServiceAuth`'s output and this module only signs it,
   with no socket involved at all. Both entry points live here for one reason —
   the account's repo key is nameable in this module and in no other, so what
   crosses this module's export boundary is a signature and never a
   `SecretKey`.

   THE ADDRESS IS ALWAYS LOOPBACK and is not configurable. Under P5 the egress
   proxy runs on this box (`docs/ops/PDS-DEPLOY.md`), so a host flag would add
   no deployment this design has, and leaving it out is containment as well as
   simplicity: a defect anywhere in the audience grading still cannot send a
   credential bearing this account's identity anywhere but to a listener on
   this machine. An egress proxy is therefore a reverse proxy pinned to ONE
   configured audience, not a forwarding proxy that routes on `Host` — the
   `Host` this module sends is the proxy's own loopback address, so an operator
   who configures a second audience configures a second listener for it and the
   choice between them is this process's, taken from the audience table.

   EVERY WAIT PARKS, the connect included. A loopback listener whose accept
   queue is full does not refuse a dial — the kernel drops the handshake and
   `connect(2)` waits — so a blocking connect here would have wedged the ONE
   thread this scheduler has, and with it every unrelated request and every
   open subscription, which is the opposite of what the rest of this paragraph
   promises. `net_async`'s `connectWithin` parks on write-readiness instead,
   and every byte after it moves through `net_async` too, which parks the task
   on would-block instead of blocking the thread. That is the whole
   requirement this module exists to satisfy: a stalled or slow-dripping
   appview suspends the ONE connection that asked to be proxied, and the accept
   loop, every unrelated in-flight request, and every open firehose
   subscription keep running. Two budgets bound it — a per-read silence budget
   and a whole-call deadline — because either alone leaves the other's hole,
   exactly as `pds/shell/server.mdk`'s inbound pair does: a peer that sends
   nothing is closed on the first, and one that dribbles a byte per budget is
   closed only by the second. -}

import async.{Async, Wait, deadlineAfter, expired}
import lib.httpclient.{
  findHeader,
  Header,
  makeRequestHeader,
  parseResponse,
  responseBody,
  responseHeaders,
  responseReason,
  responseStatus,
  serializeRequest,
}
import lib.jwt.{ServiceAuthRequest, mintServiceToken}
import lib.server_core.{ProxyAdmission}
import lib.proxy.{
  appviewRouteFor,
  appviewRoutePort,
  AppviewTable,
  relayedResponseFields,
  UpstreamAnswer(..),
}
import lib.resource_limits.{maxHttpClientWireBytes}
import lib.sign.{SecretKey}
import net.{Connection}
import net_async as A
import time.{Duration, seconds}
import vector.{Vector}
import vector as V

{- | The loopback address every outbound call this shell makes is reached at.
   See the module header for why this is a constant and not a flag — it holds
   just as much for `pds/shell/crawl.mdk`'s relay announce as it does for a
   proxied read: this process dials no address but its own box. -}
export
egressAddress : String
egressAddress = "127.0.0.1"

{- | How long one outbound read may find nothing before the call is abandoned.
   The outbound analogue of `pds/shell/server.mdk`'s `bodyProgressTimeout`, and
   a progress budget in the same sense: a response that keeps arriving restarts
   it. -}
upstreamSilenceTimeout : Duration
upstreamSilenceTimeout = seconds 5

{- | How long one whole outbound call may take, however many reads it takes.
   Deliberately far below the inbound `requestTimeout`: a client waiting on a
   proxied read is owed an answer — a 502 is an answer — rather than a
   connection held for as long as the inbound lifecycle would allow. -}
upstreamCallTimeout : Duration
upstreamCallTimeout = seconds 10

-- | How long writing the outbound request may take.
upstreamWriteTimeout : Duration
upstreamWriteTimeout = seconds 10

{- | How long one outbound dial may take to complete its handshake.

   The target is a listener on this box, so a dial either completes in
   microseconds or is not going to: the budget exists for the one state that
   is neither a refusal nor a completion — a full accept queue, whose dropped
   handshake `connect(2)` waits out for minutes. It is sized like
   `upstreamSilenceTimeout` because it is the same judgement, that nothing is
   happening, and it is a budget of its own rather than a share of
   `upstreamCallTimeout` so that a slow dial cannot spend the whole call's
   allowance before a single byte is written. -}
upstreamConnectTimeout : Duration
upstreamConnectTimeout = seconds 5

-- | Bytes asked for per outbound read.
upstreamChunkBytes : Int
upstreamChunkBytes = 65536

{- | Everything a proxied call needs that is not in the request: the audiences
   this server proxies to with the loopback egress port each one's forwards
   leave by, and the account's own repo signing key.

   One port per audience and not one for the whole server: each row's egress
   proxy is a reverse proxy pinned to that row's service, so which port a call
   leaves by IS which service it reaches. That is why the port is looked up
   from the same table the audience was admitted against, keyed by the value
   that was ADMITTED — a port derived from the client's header a second time
   would be a second audience decision, taken where nothing grades it.

   The key has no accessor. It enters through `makeEgress` and leaves only as a
   signature over a claim set `lib.server_core` built, so no other module can
   sign anything with it, and nothing can render it. -}
export data Egress = Egress AppviewTable SecretKey

export
makeEgress : AppviewTable -> SecretKey -> Egress
makeEgress appviews signingKey = Egress appviews signingKey

-- | The audiences this server proxies to, for the pure classifier that has to
-- grade a client's header against them.
export
egressAppviews : Egress -> AppviewTable
egressAppviews (Egress appviews _) = appviews

-- The account's own repo signing key, for the two callers in this module that
-- sign with it. It is private to this module and has no export: the key enters
-- through `makeEgress` and leaves only as a signature over a claim set
-- `lib.server_core` built.
egressSigningKey : Egress -> SecretKey
egressSigningKey (Egress _ signingKey) = signingKey

{- | Sign one claim set and hand the credential back, for the route whose
   ANSWER is the credential (`com.atproto.server.getServiceAuth`).

   This is the same signature `egressCall` puts in an outbound `Authorization`
   field, produced for a client that asked for it instead of for a call this
   server makes — so no socket is opened and no audience is routed to, and
   there is nothing here to decide. The `ServiceAuthRequest` is
   `lib.server_core`'s own output (`classifyServiceAuth`) and there is no other
   way to obtain one, so a credential this function can produce is one every
   check admitted.

   It exists so that `pds/shell/server.mdk` never holds the key: this module
   stays the only one that can name a `SecretKey`, and what crosses the export
   boundary is a signature over a claim set some other module built.

   `Err` carries `lib.jwt`'s message, and is reachable only when the RFC 6979
   nonce schedule exhausts its retry bound — which no input chooses and no
   caller can provoke. -}
export
egressMintToken : Egress -> ServiceAuthRequest -> Result String String
egressMintToken egress claims =
  mintServiceToken (egressSigningKey egress) claims

-- The `Host` field's value: the egress proxy's own address, on the port this
-- call's admitted audience is reached at. See the module header on why the
-- address is the proxy's rather than the appview's hostname.
egressHostValue : Int -> String
egressHostValue port = "\{egressAddress}:\{intToString port}"

{- | The outbound request bytes.

   The bearer credential is assembled by CONCATENATION rather than
   interpolation, deliberately: `pds/test/lib_boundary.sh` grades the shell for
   secrets reaching a string interpolation, and a minted token belongs to that
   class whether or not the grep's word list happens to name it.

   The only inbound fields relayed are the ones `lib.server_core` already
   selected and graded (`lib.proxy`'s `relayedRequestHeaders`); this module
   adds no field of the client's and re-decides nothing. Its own three are
   after them, so a relayed field can never displace the credential, and
   `lib.httpclient` owns every framing field besides — including the one
   `content-length`, computed from the body actually being sent rather than
   copied from what the client claimed. -}
egressRequestBytes : Int ->
  ProxyAdmission ->
  String ->
  Result String (Array Int)
egressRequestBytes port admission minted = do
  relayed <- relayedRequestFieldsOf admission.headers
  authorization <- makeRequestHeader "authorization" ("Bearer " ++ minted)
  accept <- makeRequestHeader "accept" "application/json"
  closing <- makeRequestHeader "connection" "close"
  serializeRequest
    admission.verb
    admission.target
    (egressHostValue port)
    (relayed ++ [authorization, accept, closing])
    admission.body

-- The relayed pairs `lib.server_core` selected, in the outbound serializer's
-- own `Header` type. `makeRequestHeader` grades them a second time and cannot
-- disagree with the first — the pure core admitted only printable ASCII under
-- names from its own list — so an `Err` here is a defect in one of the two
-- gradings rather than something a client can provoke.
relayedRequestFieldsOf : List (String, String) -> Result String (List Header)
relayedRequestFieldsOf [] = Ok []
relayedRequestFieldsOf ((name, value) :: rest) = do
  header <- makeRequestHeader name value
  tail <- relayedRequestFieldsOf rest
  Ok (header :: tail)

-- The fields `lib.proxy` says an answer may carry back, paired with their
-- values, in that module's order. A field the upstream did not send is absent
-- rather than empty: `proxyUpstreamResponse` relays what is here and nothing
-- else, so an empty value would be this server asserting something the appview
-- did not say.
relayedAnswerFields : List Header -> List String -> List (String, Array Int)
relayedAnswerFields _ [] = []
relayedAnswerFields headers (name :: rest) = match findHeader name headers
  Some value => (name, value) :: relayedAnswerFields headers rest
  None => relayedAnswerFields headers rest

{- | Decode one complete upstream buffer.

   `lib.httpclient`'s parser wants the whole response at once and owns every
   ceiling on what it decodes, so this module re-checks none of them: the one
   bound it adds is on the buffer it accumulates BEFORE the parser can see it
   (`maxHttpClientWireBytes`), which is a quantity no decoded ceiling can
   express. -}
decodeUpstream : Array Int -> Result String UpstreamAnswer
decodeUpstream buffer = match parseResponse buffer
  Err message => Err "egress: upstream response was not decodable: \{message}"
  Ok response =>
    Ok
      (UpstreamAnswer
        (responseStatus response)
        (responseReason response)
        (findHeader "content-type" (responseHeaders response))
        (relayedAnswerFields (responseHeaders response) relayedResponseFields)
        (responseBody response))

-- Read until the peer closes, which is what `connection: close` asked it to
-- do: the parser needs a complete response and cannot be handed a prefix.
collectUpstream : Wait ->
  Connection ->
  Vector Int ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
collectUpstream deadline conn acc = defer
  late <- expired deadline
  if late then
    deferPure (Err "egress: the upstream call exceeded its budget")
  else defer
    received <- A.recvWithin upstreamSilenceTimeout conn upstreamChunkBytes
    collectStep deadline conn acc received

collectStep : Wait ->
  Connection ->
  Vector Int ->
  Result String (Array Int) ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
collectStep _ _ _ (Err message) =
  deferPure (Err "egress: upstream read failed: \{message}")
collectStep deadline conn acc (Ok bytes) =
  if arrayLength bytes == 0 then
    deferPure (decodeUpstream (V.toArray acc))
  else
    let () = V.pushArray bytes acc
    let (_, collected) = V.rawParts acc
    if collected > maxHttpClientWireBytes then
      deferPure
        (Err
          "egress: upstream response exceeds the \{intToString maxHttpClientWireBytes}-byte wire ceiling")
    else
      collectUpstream deadline conn acc

exchange : Connection ->
  Array Int ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
exchange conn bytes = defer
  deadline <- deadlineAfter upstreamCallTimeout
  sent <- A.sendAllWithin upstreamWriteTimeout conn bytes
  match sent
    Err message =>
      deferPure (Err "egress: upstream request could not be sent: \{message}")
    Ok () => collectUpstream deadline conn (V.new ())

-- The connection is closed on every path out, success and failure alike, which
-- is why the exchange's outcome is held and returned after the close rather
-- than returned from inside it.
opened : Connection ->
  Array Int ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
opened conn bytes = defer
  outcome <- exchange conn bytes
  _ <- A.close conn
  deferPure outcome

{- | Connect to `host`:`port`, send `bytes`, and return what came back —
   the whole connect/write/read-until-close/decode/close sequence, with
   neither a fixed address nor a signed credential baked in.

   This is the one piece of `egressCall` below that has nothing to do with the
   loopback proxy or a service credential: it is exactly the scaffolding
   `pds/shell/crawl.mdk`'s `requestCrawl` also needs, for a call to a
   configured relay that carries no authorization header at all. Both callers
   share this rather than each opening their own socket, so a fix to the
   silence/deadline/wire-ceiling budgets here reaches every outbound call this
   shell makes. -}
export
egressConnect : String ->
  Int ->
  Array Int ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
egressConnect host port bytes = defer
  connected <- A.connectWithin upstreamConnectTimeout host port
  match connected
    Err message =>
      deferPure
        (Err "egress: could not reach \{host}:\{intToString port}: \{message}")
    Ok conn => opened conn bytes

{- | Make one proxied call and return what the appview answered.

   Nothing about the call is chosen here, and the parameter says so: a
   `ProxyAdmission` is the pure classifier's own output and there is no other
   way to obtain one, so the verb, the target, the relayed fields, the body and
   the claim set all arrive already decided. This module signs and sends. A
   verb chosen here would be a second place the verb is decided, and the two
   could disagree.

   WHERE it goes is looked up here, from `admission.audience` — the value
   `lib.server_core` ADMITTED, which is the table's own DID and not the
   client's header text. An audience this table does not hold is an `Err` and
   not a default: falling back to the first row would send a credential minted
   for one service to another one's proxy, which is the confused deputy with
   the grading intact and the routing wrong. That arm is unreachable — an
   admission's audience came out of this same table — and it is an `Err` rather
   than a panic for the reason `pds/shell/server.mdk`'s unreachable `None`
   egress is a 502: a reachability argument is not a reason to add a crash path
   to a function a client can reach over the network.

   `Err` is every way the call can fail to produce an answer — the token could
   not be minted, the target the client sent is not a serializable origin-form
   target, a relayed field is not serializable, the proxy refused the
   connection, a budget ran out, the response did not decode. The caller turns
   all of them into one 502: which of them happened is this server's business
   and not the client's. -}
export
egressCall : Egress ->
  ProxyAdmission ->
  Async <Clock, Net "_" | e> (Result String UpstreamAnswer)
egressCall egress admission =
  match appviewRouteFor (egressAppviews egress) admission.audience
    None =>
      deferPure (Err "egress: the admitted audience is not a configured one")
    Some route =>
      match mintServiceToken (egressSigningKey egress) admission.serviceAuth
        Err message =>
          deferPure
            (Err "egress: could not mint a service credential: \{message}")
        Ok minted =>
          match egressRequestBytes (appviewRoutePort route) admission minted
            Err message =>
              deferPure
                (Err "egress: outbound request is not serializable: \{message}")
            Ok bytes =>
              egressConnect egressAddress (appviewRoutePort route) bytes
