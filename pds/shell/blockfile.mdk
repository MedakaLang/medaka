{- | Native durable block storage: one flat sharded CID-to-bytes file per block.

   A block store is a content-addressed immutable key/value map, which is the one
   workload a filesystem already implements (`docs/design/ATPROTO-PDS-DESIGN.md`
   row P7). A block lives at `<dir>/<shard>/<hex of its binary CID>`, sharded on
   the first byte of its multihash DIGEST — every binary CID starts with the same
   version and codec prefix, so sharding on the CID's own leading bytes would put
   the whole repository in one directory. Writes land in `<dir>/.staging` and are
   promoted with `rename`, so a reader never observes a half-written block and a
   crash never leaves a torn one under a shard. A block's bytes are barriered
   before the `rename` that publishes them, so the promotion cannot reach disk
   ahead of what it names: without that pair, a power loss can leave a shard
   entry naming bytes the kernel has not written yet. The containing shard
   directory is barriered once per distinct directory one write touched, after
   the last block promoted into it and before that write returns — a commit
   landing many blocks in one shard owes that directory one barrier, not one per
   block. Deferring a directory's barrier past a promotion into a different
   directory costs no guarantee, because blocks are content-addressed and
   mutually independent: nothing reads one block's entry only if another's is
   already durable, and an entry a crash leaves unbarriered is the ordinary
   promote-in-flight state, repaired by writing the same bytes again under the
   same name.

   A DIRECTORY this module creates is barriered the same way, into the
   directory its dentry was written into (`stdlib/fs`'s `mkdirAllDurably`): a
   shard whose own entry a crash loses takes every block beneath it, however
   durable those blocks' bytes and their entries already are. Only a creation
   owes that barrier — a directory already on disk wrote no dentry — so a
   shard costs one fsync once in the life of the store rather than one per
   block, and a write over shards that all exist pays nothing for this at
   all. Every directory this module creates is covered by it: the shards,
   `.staging`, and `dir` itself, whose dentry is barriered into the data
   directory above when `.staging` is first created beneath it, so `dir` is
   durable before any block promoted into it is claimed to be.

   Nothing here trusts the disk. Bytes read back are returned as raw rows for
   `blockStoreFromBlocks` to verify against their own CIDs; this module never
   claims a row is valid, and never decodes one.

   **An entry nobody wrote.** Two shapes exist beneath `dir` and no others: a
   shard DIRECTORY named by the two lowercase hex digits `blockShardDir`
   produces, and, inside one, a block FILE named by the CID hex
   `blockFilePath` produces. Every listing here grades an entry on those two
   axes in that order.

   An entry whose TYPE contradicts the level it sits at — a plain file where a
   shard belongs, a directory where a block belongs — is residue an editor, a
   backup tool or an operator left behind, and it is SKIPPED. So is a
   directory beneath `dir` whose name is not a shard name. Skipping any of the
   three can lose no block, because a block's shard and file name are both
   functions of its own content: nothing this module wrote can be sitting
   under a name or a type it could not have produced. The alternative costs
   more than it buys — `listDir` on a non-directory, or `readFileBytes` on a
   directory, reports an unreadable shard or an unreadable block, which is a
   refused startup under a description naming the wrong culprit.

   An entry whose type is right and whose NAME is not — a plain file under a
   shard that does not spell a CID — is REFUSED, naming the path. That is the
   one place a block can be promoted to, so a name that does not parse there
   is a promotion that produced something unreadable rather than something
   foreign arriving, and reading around it would answer with a repository
   whose blocks are quietly not all here. `.staging` is neither case: it is a
   directory this module writes on purpose, and it is skipped by name before
   either question is asked.

   This module is an effectful shell (P14): it holds no protocol state, and its
   signatures carry no `Repo` and no `SecretKey`, so no signing key can reach a
   file through it. -}

import hex.{decode, encode}
import string.{take}
import fs.{isDir, mkdirAllDurably}
import lib.cid.{Cid, cidDigest, cidFromBytes, cidToBytes}

-- Temporary writes are promoted out of this directory, which is therefore the
-- one entry under a block directory that is not a shard.
stagingName : String
stagingName = ".staging"

cidKey : Cid -> String
cidKey cid = encode (cidToBytes cid)

-- | Directory holding one block's shard.
blockShardDir : String -> Cid -> String
blockShardDir dir cid = "\{dir}/\{take 2 (encode (cidDigest cid))}"

-- | Absolute path of one block's file.
blockFilePath : String -> Cid -> String
blockFilePath dir cid = "\{blockShardDir dir cid}/\{cidKey cid}"

-- One shard directory, created if it is not there, with the dentry that
-- created barriered into `dir`. See the header's paragraph on directory
-- barriers for why only a creation owes one.
ensureShard : String -> Cid -> <FileRead "_", FileWrite "_"> Result String Unit
ensureShard dir cid = mkdirAllDurably (blockShardDir dir cid)

writeOne : String ->
  Cid ->
  Array Int ->
  <FileRead "_", FileWrite "_"> Result String Unit
writeOne dir cid bytes = do
  () <- ensureShard dir cid
  let staged = "\{dir}/\{stagingName}/\{cidKey cid}"
  () <- writeFileBytes staged bytes
  () <- fsync staged
  rename staged (blockFilePath dir cid)

-- Promote every row, answering the distinct shard directories they landed in.
-- At most 256 shard names exist, so membership over a list costs less than the
-- barrier it saves.
writeRows : String ->
  List (Cid, Array Int) ->
  List String ->
  <FileRead "_", FileWrite "_"> Result String (List String)
writeRows _ [] shards = Ok shards
writeRows dir ((cid, bytes) :: rest) shards = match writeOne dir cid bytes
  Err message => Err message
  Ok () =>
    let shard = blockShardDir dir cid
    if elem shard shards then
      writeRows dir rest shards
    else
      writeRows dir rest (shard :: shards)

fsyncShards : List String -> <FileRead "_", FileWrite "_"> Result String Unit
fsyncShards [] = Ok ()
fsyncShards (shard :: rest) = match fsync shard
  Err message => Err message
  Ok () => fsyncShards rest

-- `.staging` and, on a store that has none yet, `dir` itself, each dentry
-- barriered into its own parent: `.staging`'s into `dir`, and `dir`'s into
-- the data directory above.
ensureStaging : String -> <FileRead "_", FileWrite "_"> Result String Unit
ensureStaging dir = mkdirAllDurably "\{dir}/\{stagingName}"

{- | Write every row durably beneath `dir`. Writing a block that is already
   present is idempotent: a block's name is its content, so the promoted file
   carries exactly the bytes the old one did. -}
export
blockFileWrite : String ->
  List (Cid, Array Int) ->
  <FileRead "_", FileWrite "_"> Result String Unit
blockFileWrite dir rows = do
  () <- ensureStaging dir
  shards <- writeRows dir rows []
  fsyncShards shards

cidForName : String -> String -> Result String Cid
cidForName path name = match decode name
  Err message =>
    Err "blockfile: \{path}: block file name is not hex: \{message}"
  Ok bytes => match cidFromBytes bytes
    Err message =>
      Err "blockfile: \{path}: block file name is not a CID: \{message}"
    Ok cid => Ok cid

{- | Whether a name is one `blockShardDir` can produce: the first byte of a
   multihash digest in lowercase hex, so exactly two lowercase hex digits. The
   round trip through `encode` is what rules out an odd case or extra length
   that `decode` alone would accept.

   Exported for `shell.blobfile`, whose shard layout is this one — it stores a
   different kind of bytes under the same `<shard>/<cid hex>` tree. Two copies
   of this predicate could disagree about which directories a store is allowed
   to own, which is the one thing a shared layout cannot afford. -}
export
isShardName : String -> Bool
isShardName name = match decode name
  Err _ => False
  Ok bytes => arrayLength bytes == 1 && encode bytes == name

{- | The entries of one shard that are plain files. Every block is promoted
   into a shard as a leaf FILE (`writeOne`), so a directory among a shard's
   entries is residue this module could not have written, and dropping it here
   loses no block. Applied once, for the whole shard, so that every later pass
   over those leaves is looking at the same set.

   Exported for `shell.blobfile` for `isShardName`'s reason: a blob's bytes
   and its sidecar are leaf files in the same sense, and the two stores must
   not disagree about which entries a shard actually holds. -}
export
fileLeaves : String -> List String -> <FileRead "_"> List String
fileLeaves _ [] = []
fileLeaves shardPath (leaf :: rest) = match isDir "\{shardPath}/\{leaf}"
  Ok True => fileLeaves shardPath rest
  _ => leaf :: fileLeaves shardPath rest

readLeaves : String ->
  List String ->
  List (Cid, Array Int) ->
  <FileRead "_"> Result String (List (Cid, Array Int))
readLeaves _ [] acc = Ok acc
readLeaves shardPath (leaf :: rest) acc =
  let path = "\{shardPath}/\{leaf}"
  match cidForName path leaf
    Err message => Err message
    Ok cid => match readFileBytes path
      Err message => Err "blockfile: \{path}: unreadable block file: \{message}"
      Ok bytes => readLeaves shardPath rest ((cid, bytes) :: acc)

readShards : String ->
  List String ->
  List (Cid, Array Int) ->
  <FileRead "_"> Result String (List (Cid, Array Int))
readShards _ [] acc = Ok acc
readShards dir (shard :: rest) acc =
  let path = "\{dir}/\{shard}"
  -- `.staging` is skipped because this module writes it; anything else whose
  -- name is not a shard name, or that is not a directory at all, is skipped
  -- because this module could not have written it. See the header's "An entry
  -- nobody wrote".
  if shard == stagingName || not (isShardName shard) then
    readShards dir rest acc
  else match isDir path
    Ok False => readShards dir rest acc
    _ => match listDir path
      Err message =>
        Err "blockfile: \{path}: unreadable shard directory: \{message}"
      Ok leaves => match readLeaves path (fileLeaves path leaves) acc
        Err message => Err message
        Ok next => readShards dir rest next

{- | Read every persisted row beneath `dir`, in unspecified order.

   The returned rows are UNVERIFIED bytes off disk paired with the CID their file
   name spells. `blockStoreFromBlocks` is what proves each row's bytes hash to
   that CID, and a tampered file fails there. An entry this module did not
   write is skipped or refused by the header's "An entry nobody wrote" rule; a
   directory that IS named like a shard and cannot be listed still fails
   loudly, because that is one of ours. -}
export
blockFileRead : String -> <FileRead "_"> Result String (List (Cid, Array Int))
blockFileRead dir = match listDir dir
  Err message => Err "blockfile: unreadable block directory: \{message}"
  Ok shards => readShards dir shards []

-- Every file left behind under `<dir>/.staging` by a process that crashed
-- between staging a file and its `rename`. `.staging` never holds a
-- subdirectory in this module's own write path (`writeOne` stages a leaf
-- file directly), but this sweep also tolerates residue it did not write —
-- a stray subdirectory is skipped rather than passed to `removeFile`, which
-- fails on a directory.
removeStagingResidue : String ->
  List String ->
  <FileRead "_", FileWrite "_"> Result String Unit
removeStagingResidue _ [] = Ok ()
removeStagingResidue dir (leaf :: rest) = match isDir "\{dir}/\{leaf}"
  Ok True => removeStagingResidue dir rest
  _ => match removeFile "\{dir}/\{leaf}"
    Err message =>
      Err "blockfile: \{dir}/\{leaf}: undeletable staging residue: \{message}"
    Ok () => removeStagingResidue dir rest

{- | Remove every file staged beneath `<dir>/.staging` and never promoted or
   cleaned up — the residue a crash between `writeFileBytes staged` and its
   `rename` leaves behind. Nothing else in this module ever removes from
   `.staging`, so this is the only place stale entries go away.

   Meant to be called once, at startup, before the listener binds
   (`pds/serve.mdk`'s `configure`): that is the only window in which a file
   under `.staging` unambiguously means residue from a prior crash rather
   than a promotion this process has in flight. A data directory that has
   never staged a block reads as nothing to sweep, not as a failure. -}
export
blockFileSweepStaging : String ->
  <FileRead "_", FileWrite "_"> Result String Unit
blockFileSweepStaging dir =
  let staging = "\{dir}/\{stagingName}"
  if not (fileExists staging) then
    Ok ()
  else match listDir staging
    Err message =>
      Err "blockfile: \{staging}: unreadable staging directory: \{message}"
    Ok leaves => removeStagingResidue staging leaves
