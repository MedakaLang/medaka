import shell.server.{
  Serving,
  bindAddress,
  completeGenesisEvents,
  defaultStatsInterval,
  makeServing,
  runServer,
  servingStopping,
}
import string.{
  drop, indexOf, lines, startsWith, stripSuffix, take, toInt, toLower, trim
}
import time.{Duration, millis, now}

serveSpec : ArgSpec
serveSpec = spec "serve" [
  value ["--did"] "DID" "the repository owner's DID",
  value ["--handle"] "HANDLE" "the repository owner's handle",
  value ["--hostname"] "HOST" "this PDS's own hostname",
  value ["--key"] "PATH" "file holding the hex-encoded secp256k1 signing key",
  value
    ["--token-secret"]
    "PATH"
    "file holding the hex-encoded 32-byte session-token secret",
  value
    ["--password-file"]
    "PATH"
    "file holding the account password, for first-run credential bootstrap",
  value ["--data"] "DIR" "existing directory holding the persisted repository",
  intValue ["--port"] "N" "TCP port to bind; 0 picks a free one",
  value
    ["--bind"]
    "ADDR"
    "address to bind, default 127.0.0.1 (loopback); a non-loopback address is refused unless --trusted-proxy is also given",
  switch ["--init"] "create the genesis repository in an empty data directory",
  switch
    ["--force-lock"]
    "take the data directory's single-writer lock even though another process appears to hold it; for a lock left behind by a server that is gone, never for one that is still running",
  switch
    ["--trusted-proxy"]
    "trust this connection's peer to be the reverse proxy in front of it, and read the client identity `X-Forwarded-For` names for rate limiting; without it every request shares one identity bucket",
  value
    ["--appview-did"]
    "DID"
    "the DEFAULT appview service DID: the audience a request whose atproto-proxy header is absent is forwarded to, and one a header may name; requires --egress-port, and without both no request is ever proxied",
  intValue
    ["--egress-port"]
    "N"
    "loopback port of the local egress proxy that forwards to --appview-did; requires --appview-did",
  value
    ["--proxy-audience"]
    "DID=PORT"
    "an ADDITIONAL service DID an atproto-proxy header may name, and the loopback port of the egress proxy that forwards to it; repeatable, and requires --appview-did and --egress-port",
  intValue
    ["--relay-port"]
    "N"
    "loopback port of a local reverse proxy that forwards to a relay; announces this server's --hostname there once at startup, best-effort",
  value
    ["--privacy-policy-url"]
    "URL"
    "this server's privacy policy, reported in describeServer's links; omitted from the response when absent",
  value
    ["--terms-of-service-url"]
    "URL"
    "this server's terms of service, reported in describeServer's links; omitted from the response when absent",
  value
    ["--contact-email"]
    "EMAIL"
    "an operator contact address, reported in describeServer's contact; omitted from the response when absent",
  intValue
    ["--stats-interval-ms"]
    "MS"
    "how often to emit the periodic stats line (active/unframed connections, subscriptions, repo rev, blocks and blobs on disk); default 60000",
]

{- | `pds keygen`'s roster. Both flags name a file to CREATE, and both are
   spelled exactly as `serve` spells the file it later reads back, so a
   generated key is passed to `serve` under the same name it was generated
   under. Neither takes a value that is a secret: a secret in an argument is
   visible in `ps` output to every account on the box, which is why every
   secret in this program travels as a file. -}
keygenSpec : ArgSpec
keygenSpec = spec "keygen" [
  value ["--key"] "PATH" "write a new hex-encoded secp256k1 signing key here",
  value
    ["--token-secret"]
    "PATH"
    "write a new hex-encoded 32-byte session-token secret here",
]

abort : String -> <Stderr> Unit
abort message =
  let () = ePutStrLn message
  exit 1

required : String -> Args -> Result String String
required name parsed = match flagValue name parsed
  Some given => Ok given
  None => Err "missing required flag \{name}"

requiredPort : Args -> Result String Int
requiredPort parsed = do
  text <- required "--port" parsed
  match toInt text
    None => Err "--port is not an integer: \{text}"
    Some port =>
      if port < 0 || port > 65535 then
        Err "--port must be in 0..65535"
      else
        Ok port

-- `--stats-interval-ms`, defaulting to `defaultStatsInterval` when absent.
statsIntervalOf : Args -> Result String Duration
statsIntervalOf parsed = match flagValue "--stats-interval-ms" parsed
  None => Ok defaultStatsInterval
  Some text => match toInt text
    None => Err "--stats-interval-ms is not an integer: \{text}"
    Some ms =>
      if ms <= 0 then
        Err "--stats-interval-ms must be positive"
      else
        Ok (millis ms)

loopbackAddress : String
loopbackAddress = "127.0.0.1"

-- `--bind`, defaulting to loopback when absent. There is no admission check
-- here — a malformed address is caught the same way it always was, by
-- `shell.server`'s `bindAddress` failing to bind it.
bindAddressOf : Args -> String
bindAddressOf parsed = match flagValue "--bind" parsed
  Some given => given
  None => loopbackAddress

isLoopbackAddress : String -> Bool
isLoopbackAddress addr = addr == loopbackAddress

{- | Refuse a non-loopback bind unless `--trusted-proxy` is also set (`#2757`).

   This process cannot observe whether the peer on the other end of an
   accepted connection really is the reverse proxy `--trusted-proxy` claims —
   there is no `getpeername` in the runtime — so the flag is an operator
   assertion about the deployment, and this refusal is what makes skipping it
   a deliberate act rather than a silent direct exposure. It fires before any
   secret is read or generated and before the listener binds (`#2659` item
   4's ordering; a refusal here must leave nothing behind either). -}
requireTrustedBind : String -> TrustedProxy -> Result String Unit
requireTrustedBind bind (TrustedProxy trusted) =
  if isLoopbackAddress bind || trusted then
    Ok ()
  else
    Err
      "refusing to bind \{bind}: a non-loopback bind requires --trusted-proxy (see docs/ops/PDS-DEPLOY.md)"

{- | Refuse a `--did` that names this server's own `did:web` hostname but
   disagrees with it only by case (`#3091`).

   `wellKnownDidJson` (`lib.handlers`) decides which document `/.well-known/
   did.json` serves by comparing the configured DID against `did:web:
   \{hostname}` EXACTLY, because a DID is case-sensitive and the reference
   resolver's own `validateDidDoc` compares `doc.id` the same way. A `--did`
   that spells the hostname in different case takes that comparison's
   fallback arm and keeps serving the SERVER document forever — no signing
   key, no `alsoKnownAs` — which no relay or appview can use to verify this
   account, and which the Bluesky relay's own `NormalizeDID` (lowercasing
   `did:web:`) would resolve to a DIFFERENT identity than this exact-match
   server sees. This refuses that configuration at startup instead of
   serving it.

   A `--did` naming a genuinely different `did:web` host is a different,
   deliberate configuration — that account's identity is resolved at ITS
   host's `/.well-known/did.json`, not this one's, and this server already
   serves the (correct) server document for it. Only case-insensitive
   equality without exact equality is refused. -}
requireDidHostnameCase : String -> String -> Result String Unit
requireDidHostnameCase did hostname =
  let ownDid = "did:web:\{hostname}"
  if not (startsWith "did:web:" did) || did == ownDid then
    Ok ()
  else if toLower did == toLower ownDid then
    Err
      "refusing to start: --did \{did} and --hostname \{hostname} name the same did:web host in different case; the well-known document is served by an exact match, so this configuration would silently keep serving the server document instead of this account's — match the case exactly (e.g. --did \{ownDid})"
  else
    Ok ()

-- Port 0 is accepted for `--port` because the kernel picks a free one there.
-- An egress port is a port this process must REACH, so 0 names nothing; the
-- range itself is `makeAppviewRoute`'s, so a row cannot be built out of a port
-- this process could not dial whatever spelled it.
egressPortOf : String -> String -> Result String Int
egressPortOf flag text = match toInt text
  None => Err "\{flag} is not an integer: \{text}"
  Some port => Ok port

{- | Where a proxied read goes, and the audiences a client's `atproto-proxy`
   header is allowed to name — or `None`, meaning this server proxies nothing.

   All or none, PER ROW. `--appview-did` alone names an audience with no route
   to it and `--egress-port` alone names a route with no audience allowed to
   claim it, so either alone is a startup refusal rather than a silently inert
   proxy: an operator who believes forwarding is configured and is wrong learns
   it here rather than from a 400 on a route they expected to be forwarded.
   `--proxy-audience` carries both halves of a row in one value for the same
   reason — a DID and a port that could be given separately could be given
   unevenly, and a row whose halves came from different flags could be paired
   wrongly with nothing to notice.

   With no flag at all, every `atproto-proxy` header there is gets refused with
   nothing signed, which is the only safe default for a server whose operator
   has not said where its appview is — a proxy that defaults to somewhere is a
   credential-bearing call to a destination nobody chose. `--proxy-audience`
   without the default pair is refused rather than promoted to the default: a
   header-absent read has to go somewhere, and choosing which of an operator's
   additional audiences receives it is not this program's choice to make. -}
configureEgress : Args -> SecretKey -> Result String (Option Egress)
configureEgress parsed signingKey = match (
  flagValue "--appview-did" parsed,
  flagValue "--egress-port" parsed,
  flagValues "--proxy-audience" parsed,
)
  (None, None, []) => Ok None
  (None, None, _ :: _) =>
    Err
      "--proxy-audience requires --appview-did and --egress-port (see docs/ops/PDS-DEPLOY.md)"
  (Some _, None, _) =>
    Err "--appview-did requires --egress-port (see docs/ops/PDS-DEPLOY.md)"
  (None, Some _, _) =>
    Err "--egress-port requires --appview-did (see docs/ops/PDS-DEPLOY.md)"
  (Some did, Some portText, extra) => do
    port <- egressPortOf "--egress-port" portText
    first <- appviewRouteOf "--appview-did" did port
    rest <- extraAudiences extra
    appviews <- makeAppviewTable first rest
    Ok (Some (makeEgress appviews signingKey))

appviewRouteOf : String -> String -> Int -> Result String AppviewRoute
appviewRouteOf flag did port = match makeAppviewRoute did port
  Err message => Err "\{flag} \{did}: \{message}"
  Ok route => Ok route

{- | One `--proxy-audience DID=PORT` value, as a row.

   The split is on the FIRST `=`, which is unambiguous: a DID's grammar
   (`lib.atsyntax`'s `validateDid`) admits no `=` at all, so the separator
   cannot occur inside the half it separates. A value missing either half is
   refused by name rather than left to the integer parse, so an operator who
   typed a DID and forgot the port is told which half is missing. -}
audienceRowOf : String -> Result String AppviewRoute
audienceRowOf text = match indexOf "=" text
  None => Err "--proxy-audience must be DID=PORT: \{text}"
  Some at =>
    let did = take at text
    let portText = drop (at + 1) text
    if did == "" || portText == "" then
      Err
        "--proxy-audience must name both a DID and a port, as DID=PORT: \{text}"
    else do
      port <- egressPortOf "--proxy-audience port" portText
      appviewRouteOf "--proxy-audience" did port

extraAudiences : List String -> Result String (List AppviewRoute)
extraAudiences [] = Ok []
extraAudiences (text :: rest) = do
  route <- audienceRowOf text
  tail <- extraAudiences rest
  Ok (route :: tail)

relayPortOf : String -> Result String Int
relayPortOf text = match toInt text
  None => Err "--relay-port is not an integer: \{text}"
  Some port =>
    if port < 1 || port > 65535 then
      Err "--relay-port must be in 1..65535"
    else
      Ok port

{- | `--relay-port`, or `None` to announce nowhere — the same "no flag, no
   outbound call" default `configureEgress` uses for `--appview-did`.

   Unlike the appview pair there is no second flag to cross-require: a relay
   announce carries no credential and needs no audience DID, only a
   destination, so one flag is the whole configuration. -}
configureRelay : Args -> Result String (Option RelayTarget)
configureRelay parsed = match flagValue "--relay-port" parsed
  None => Ok None
  Some portText => do
    port <- relayPortOf portText
    Ok (Some (makeRelayTarget port))

-- The mode as `chmod` and `stat -c %a` spell it, so an operator can compare a
-- rejection to the `0600` its remedy names without converting anything.
octalMode : Int -> String
octalMode mode =
  let digit = shift => intToString (bitAnd (shiftRight mode shift) 7)
  "0\{digit 6}\{digit 3}\{digit 0}"

{- | Refuse a secret file any account but its owner can read.

   This is a startup check, not a warning: a group- or world-readable signing
   key has already been exposed to every other account on the box for as long
   as it has been there, and a server that serves anyway hides that. -}
requirePrivateMode : String -> String -> <FileRead "_"> Result String Unit
requirePrivateMode label path = do
  mode <- match fileMode path
    Err message => Err "unreadable \{label} \{path}: \{message}"
    Ok given => Ok given
  if isPrivateMode mode then
    Ok ()
  else
    Err
      "refusing to start: \{label} \{path} is mode \{octalMode mode}, readable by accounts other than its owner; restrict it (chmod 0600 \{path}) and restart"

-- Neither key reaches a diagnostic: the mode and read errors name the path,
-- and `hex.decode`'s own messages do not echo what they were given.
readHexBytes : String -> String -> <FileRead "_"> Result String (Array Int)
readHexBytes label path = do
  () <- requirePrivateMode label path
  text <- match readFile path
    Err message => Err "unreadable \{label} \{path}: \{message}"
    Ok given => Ok given
  match decode (trim text)
    Err message => Err "\{label} \{path} is not hex: \{message}"
    Ok bytes => Ok bytes

sessionSecretPath : String -> String
sessionSecretPath dir = "\{dir}/session-secret"

{- | How many distinct byte values a 32-byte session-token secret must carry.

   Thirty-two independent random bytes hold about 28 distinct values, and hold
   fewer than eight with probability far below 1 in 2^60 — so this refuses a
   placeholder (32 zero bytes, a repeated pattern, a short string padded out)
   without ever refusing a real one. It is a NON-ENTROPY detector, not an
   entropy estimator: a secret this admits is not thereby proven random; it merely
   is not obviously constant. -}
minSecretDistinctBytes : Int
minSecretDistinctBytes = 8

distinctSeen : Array Int -> Array Int -> Int -> Int -> Int
distinctSeen bytes seen i found =
  if i >= arrayLength bytes then
    found
  else
    let byte = bytes[i]
    if byte < 0 || byte > 255 || seen[byte] == 1 then
      distinctSeen bytes seen (i + 1) found
    else
      let () = A.setInPlace byte 1 seen
      distinctSeen bytes seen (i + 1) (found + 1)

distinctByteValues : Array Int -> Int
distinctByteValues bytes = distinctSeen bytes (arrayMake 256 0) 0 0

{- | Refuse a session-token secret that is not a generated one.

   Neither the secret nor any measurement of it reaches this diagnostic: a
   count of distinct bytes is a property of the value, and the value is a
   secret even while it is being refused. The message names the file and the
   remedy, which is all an operator needs. -}
admitSessionSecret : String -> Array Int -> Result String (Array Int)
admitSessionSecret path bytes =
  if distinctByteValues bytes < minSecretDistinctBytes then
    Err
      "refusing to start: session-token secret \{path} is a constant or near-constant value, not a generated secret; every session token this server issues would be forgeable from it (generate one with: pds keygen --token-secret \{path})"
  else
    Ok bytes

{- | Generate this server's session-token secret and keep it, at mode 0600. It
   is drawn from `osEntropyBytes`, the OS entropy source, and never from
   `randomInt`, whose SplitMix64 generator is seeded deterministically and
   would make every session token on every deployment forgeable from a public
   constant. -}
generateSessionSecret : String ->
  <FileWrite "_", Rand> Result String (Array Int)
generateSessionSecret dir = do
  let bytes = osEntropyBytes serverSecretBytes
  () <- match writeFilePrivate (sessionSecretPath dir) "\{encode bytes}\n"
    Err message =>
      Err "unwritable session secret \{sessionSecretPath dir}: \{message}"
    Ok () => Ok ()
  Ok bytes

{- | The session-token secret this run already has: the one `--token-secret`
   names, else the one kept in the data directory, else `None` — meaning one
   must be generated.

   This is the READ half, and it writes nothing, so a later failure cannot
   strand a secret it created. A PRESENT but unusable secret IS an error,
   refused before the listener binds rather than at the first request that
   needed it. -}
suppliedSessionSecret : Args ->
  String ->
  <FileRead "_"> Result String (Option (Array Int))
suppliedSessionSecret parsed dir = match flagValue "--token-secret" parsed
  Some path => map Some (readSessionSecret path)
  None =>
    if fileExists (sessionSecretPath dir) then
      map Some (readSessionSecret (sessionSecretPath dir))
    else
      Ok None

-- Both arms above read a secret somebody else chose — the flag's file, or one
-- a previous run left in the data directory — so both are graded, and the one
-- this program generates below is graded by construction instead.
readSessionSecret : String -> <FileRead "_"> Result String (Array Int)
readSessionSecret path = do
  bytes <- readHexBytes "session-token secret" path
  admitSessionSecret path bytes

-- The WRITE half: generate the secret only when the read half found none.
establishSessionSecret : String ->
  Option (Array Int) ->
  <FileWrite "_", Rand> Result String (Array Int)
establishSessionSecret _ (Some bytes) = Ok bytes
establishSessionSecret dir None = generateSessionSecret dir

{- | The account password, as the file holds it: everything in the file with
   one trailing newline removed, which is what `printf %s\\n` and every text
   editor put there. Nothing else is stripped — leading and interior spaces are
   part of a password, and a password this program silently rewrote would not
   be the one its owner typed. -}
passwordOf : String -> Result String String
passwordOf text =
  let password = match stripSuffix "\n" text
    Some shorter => shorter
    None => text
  if password == "" then Err "the password file is empty" else Ok password

-- The password `--password-file` supplies, read and admitted but not yet
-- turned into anything: `planCredential` returns it so the derive-and-keep
-- can happen after every other supplied secret has been admitted too.
-- Neither arm is a failure, so `Result` would be the wrong shape: it would
-- read a supplied password as an error to be recovered from.
-- lint-disable-next-line rule-clone-type
data CredentialSource = Kept CredentialRecord | Bootstrap String

{- | Derive the account credential from an admitted password and keep it, at
   mode 0600. The salt is drawn here, from `osEntropyBytes`: `lib.credential`
   takes a caller-supplied salt and draws no entropy of its own. -}
bootstrapCredential : String ->
  String ->
  <FileWrite "_", Rand> Result String CredentialRecord
bootstrapCredential dir password = do
  record <- makeCredential (osEntropyBytes saltBytes) defaultIterations password
  () <- persistCredential dir record
  Ok record

loadCredential : String -> <FileRead "_"> Result String CredentialRecord
loadCredential dir = do
  () <- requirePrivateMode "credential" (credentialPath dir)
  text <- match readFile (credentialPath dir)
    Err message => Err "unreadable credential \{credentialPath dir}: \{message}"
    Ok given => Ok given
  match lines (trim text)
    [iterationsText, saltText, digestText] => do
      iterations <- match toInt iterationsText
        None =>
          Err
            "credential \{credentialPath dir}: first line is not an iteration count"
        Some given => Ok given
      salt <- decode saltText
      digest <- decode digestText
      credentialFromParts salt iterations digest
    _ =>
      Err
        "credential \{credentialPath dir}: expected three lines (iterations, salt, derived key)"

{- | Where the account's password credential comes from: the one the data
   directory already holds, else the password `--password-file` supplies.

   This is the READ half, and it writes nothing. With neither, the server
   refuses to start. The alternative — starting with no credential and
   refusing every login — would look identical to a correctly configured
   server right up until somebody tried to use it, and the fix would be
   invisible from the outside. -}
planCredential : Args -> String -> <FileRead "_"> Result String CredentialSource
planCredential parsed dir =
  let exists = fileExists (credentialPath dir)
  match (exists, flagValue "--password-file" parsed)
    (True, None) => map Kept (loadCredential dir)
    (True, Some _) =>
      Err
        "refusing to start: \{credentialPath dir} already exists and --password-file was given; in-place rotation is not supported, so remove \{credentialPath dir} first if you intend to replace the password"
    (False, None) =>
      Err
        "no account credential in \{credentialPath dir}: pass --password-file PATH once, holding the account password, to bootstrap one (the password is never taken from an argument value, and there is no terminal prompt)"
    (False, Some path) => map Bootstrap (readPassword path)

-- The supplied password, admitted: unreadable or empty is a rejection here,
-- where nothing has been written yet.
readPassword : String -> <FileRead "_"> Result String String
readPassword path = do
  () <- requirePrivateMode "password file" path
  text <- match readFile path
    Err message => Err "unreadable password file \{path}: \{message}"
    Ok given => Ok given
  match passwordOf text
    Err message => Err "\{path}: \{message}"
    Ok given => Ok given

-- The WRITE half: derive and keep only the password the read half admitted.
establishCredential : String ->
  CredentialSource ->
  <FileWrite "_", Rand> Result String CredentialRecord
establishCredential _ (Kept record) = Ok record
establishCredential dir (Bootstrap password) = bootstrapCredential dir password

{- | `pds keygen` — generate the secrets `pds serve` will not generate for an
   operator: the account signing key, and, when asked, a session-token secret.

   Neither flag has a default, and a run naming neither is an error rather
   than a no-op: a `keygen` that silently generated nothing would look exactly
   like one whose output the operator was about to configure.

   EVERY destination is refused-or-admitted before ANY of them is written, the
   shape `configure` takes for #2659 item 4: a run rejected for its second
   file must leave no secret behind from its first. -}
runKeygen : Args ->
  <FileRead "_", FileWrite "_", Rand, Stdout> Result String Unit
runKeygen parsed = match (
  flagValue "--key" parsed,
  flagValue "--token-secret" parsed,
)
  (None, None) =>
    Err
      "name at least one file to write (--key PATH for the signing key, --token-secret PATH for the session-token secret)"
  (Some keyPath, None) => do
    () <- keygenRefusePath "signing key" keyPath
    keygenSigningKey keyPath
  (None, Some secretPath) => do
    () <- keygenRefusePath "session-token secret" secretPath
    keygenTokenSecret secretPath
  (Some keyPath, Some secretPath) => do
    -- Two names for one file pass both existence checks and would still write
    -- twice, so distinctness is part of admitting the destinations.
    () <- requireDistinctDestinations keyPath secretPath
    () <- keygenRefusePath "signing key" keyPath
    () <- keygenRefusePath "session-token secret" secretPath
    keygenSigningKeyAndTokenSecret keyPath secretPath

requireDistinctDestinations : String -> String -> Result String Unit
requireDistinctDestinations keyPath secretPath =
  if keyPath == secretPath then
    Err
      "refusing \{keyPath}: --key and --token-secret name the same file, and the two secrets are not interchangeable; name two files"
  else
    Ok ()

requireDir : String -> <FileRead "_"> Result String Unit
requireDir dir = match isDir dir
  Err message => Err "data directory \{dir}: \{message}"
  Ok False => Err "data directory \{dir} is not a directory"
  Ok True => Ok ()

genesisTid : Unit -> <Clock> Result String Tid
genesisTid u = tidEncode (floatToInt (now u * 1000000.0)) 0

{- | Create and persist the genesis repository. `--init` refuses a directory
   that already holds one rather than writing over it, so a rerun of a serving
   command cannot silently discard an account's history. -}
initRepo : String ->
  String ->
  Array Int ->
  <Clock, FileRead "_", FileWrite "_"> Result String Repo
initRepo dir did keyBytes = do
  genesis <- genesisTid ()
  repo <- repoInitFromKeyBytes did keyBytes genesis
  blocks <- repoExportBlocks repo
  () <- persistSave dir (repoCommitCid (repoLatestCommit repo)) blocks
  Ok repo

{- | Every persisted blob, read back into the initial `Store` before a single
   connection is accepted.

   Bytes off disk are untrusted exactly as the repository's blocks are, and are
   re-checked the same way: `storePutBlob` verifies each row against the CID its
   file name spells (`blockStorePut`, the very check `blockStoreFromBlocks`
   folds over the repository half), so a tampered blob file refuses the whole
   startup rather than being served. -}
loadBlobs : Store -> String -> <FileRead "_"> Result String Store
loadBlobs store dir = do
  rows <- blobFileRead dir
  admitBlobRows rows store

{- | This is the seam a declared MIME type crosses from the disk into the
   `Store`, and the only place it is checked on the way in: nothing downstream
   re-reads a sidecar, and `sync.getBlob` puts the stored type straight into a
   response header, where a value carrying a control byte is refused far too
   late to answer with. `admitBlob` applies the same shape check to the upload
   path, so a value that reaches here and fails it came from a tampered file
   and belongs to no blob this server can serve. -}
admitBlobRows : List (Cid, String, Array Int) -> Store -> Result String Store
admitBlobRows [] store = Ok store
admitBlobRows ((cid, mimeType, bytes) :: rest) store =
  if not (validMimeShape mimeType) then
    admitBlobRows rest store
  else match storePutBlob cid mimeType bytes store
    Err message => Err "persisted blob \{cidToString cid} rejected: \{message}"
    Ok next => admitBlobRows rest next

loadRepo : String -> String -> SecretKey -> <FileRead "_"> Result String Repo
loadRepo dir did secret = do
  (head, blocks) <- persistLoad dir
  repoFromBlocks did secret head blocks

openRepo : Bool ->
  String ->
  String ->
  Array Int ->
  SecretKey ->
  <Clock, FileRead "_", FileWrite "_"> Result String Repo
openRepo False dir did _ secret = loadRepo dir did secret
openRepo True dir did keyBytes secret =
  if persistHasHead dir then match loadRepo dir did secret
    Ok _ => Err "--init refuses \{dir}: it already holds a repository"
    Err message =>
      Err
        "--init refuses \{dir}: it already holds a repository, but its head does not load under the configured --did and --key (\{message}); check those flags rather than reinitializing"
  else
    initRepo dir did keyBytes

{- | Everything the server needs, or the first reason it may not run: the
   configured server, its initial store, the data directory, the port, the
   address to bind, where (if anywhere) to announce this repository to a
   relay, how often to emit the periodic stats line, and the startup lines
   `start` prints under the banner.

   The startup lines are a VALUE and not a print: this function decides and
   refuses, and a run it refuses must narrate nothing. `start` prints them,
   after the banner, so that a log still begins by saying which build produced
   everything under it. -}
configure : Args ->
  <Clock, Env, FileRead "_", FileWrite "_", Rand> Result String (Server, Store, String, Int, String, Serving, Option RelayTarget, Duration, DataLock, List String)
configure parsed = do
  did <- required "--did" parsed
  handle <- required "--handle" parsed
  hostname <- required "--hostname" parsed
  keyPath <- required "--key" parsed
  dir <- required "--data" parsed
  port <- requiredPort parsed
  let bind = bindAddressOf parsed
  statsInterval <- statsIntervalOf parsed
  let trustedProxy = TrustedProxy (flag "--trusted-proxy" parsed)
  -- Before anything else is read or generated: a bind refusal must leave no
  -- secret behind, same as every other refusal `configure` can raise
  -- (#2659 item 4).
  () <- requireTrustedBind bind trustedProxy
  account <- makeAccount did handle hostname
  () <- requireDidHostnameCase (accountDid account) (accountHostname account)
  let links =
    makeServerLinks
      (flagValue "--privacy-policy-url" parsed)
      (flagValue "--terms-of-service-url" parsed)
      (flagValue "--contact-email" parsed)
  -- Read once at startup, not per request: `_health`'s body is this build's
  -- own provenance, which cannot change while the process is running.
  let version = versionString ()
  server <- pdsServer account links version
  keyBytes <- readHexBytes "signing key" keyPath
  secret <- secretKeyFromBytes keyBytes
  -- Admitted here, beside the other flag-supplied configuration and ahead of
  -- every generated secret, for the same reason `requireTrustedBind` is: a run
  -- refused for a malformed appview DID must leave no session secret on disk
  -- for the next run to adopt (#2659 item 4).
  egress <- configureEgress parsed secret
  let serving = makeServing trustedProxy egress (Ref 0)
  relay <- configureRelay parsed
  () <- requireDir dir
  -- The single-writer lock, taken here: after the directory is known to be one
  -- and before the first thing below that reads or writes anything beneath it.
  -- Both halves of that position are load-bearing. The sweeps a few lines down
  -- delete every file under `.staging`, which is residue from a prior crash
  -- only while no other process is between a write and its `rename`, and
  -- `openRepo` under `--init` writes a genesis repository; a second server
  -- refused after either of those has already destroyed what it was refused
  -- for.
  (lock, lockOutcome) <- acquireDataLock (flag "--force-lock" parsed) dir
  -- A beat in front of every step below that WRITES, and one behind every step
  -- that takes time. The first half is the exclusion itself: a step that
  -- reaches the disk after this process has lost the directory would be the
  -- two-writer case the lock exists to prevent, and `requireDataLock` refuses
  -- the run rather than performing it. The second half is what keeps that from
  -- happening in the first place — a heartbeat between phases leaves a
  -- contender one phase's worth of silence to mistake for a dead holder rather
  -- than the whole of `configure`, which on a large store is many times the
  -- stale window.
  --
  -- Between the phases and no finer: `configure` runs as ONE synchronous step
  -- (`liftIO (u => configure parsed)`) and `async.liftIO` runs it to
  -- completion, so a spawned beat cannot interleave with it — MEASURED, a
  -- 3596ms step with a 100ms beat loop spawned beside it wrote one beat, the
  -- one before the step began. The phases that are unbounded in store size and
  -- still uncovered (`repoFromBlocks`, `loadBlobs`) only READ, so the worst a
  -- store big enough to outlast the window costs is this process's own lock,
  -- which the next beat reports rather than writing through.
  () <- requireDataLock lock
  -- `openRepo True` returns `Ok` only down its `initRepo` branch — every other
  -- branch under `--init` refuses a directory that already holds a
  -- repository — so reaching here with this flag set means THIS run created
  -- the genesis repository.
  let created = flag "--init" parsed
  repo <- openRepo created dir did keyBytes secret
  -- A crash between staging a file and its `rename` leaves it behind in one
  -- of the three `.staging` directories; nothing else in the tree ever
  -- removes one. Swept here, once the data/repository directories are known
  -- to exist and before anything below reads or writes the event log, so a
  -- stale entry left by a PRIOR crash can never be mistaken for output this
  -- start is about to produce (residue this module did not write is
  -- residue, not corruption).
  () <- requireDataLock lock
  () <- persistSweepStagedBlocks dir
  () <- blobFileSweepStaging dir
  () <- eventLogSweepStaging dir
  -- A previous process may have died between persisting a commit and
  -- appending the event announcing it. The staged entry anchors to the commit
  -- it announces, so the repository just loaded is what decides whether it is
  -- finished or dropped. DECIDED here and PERFORMED below, which is the whole
  -- of #2906: an unreadable staged entry must refuse this run before a
  -- generated secret reaches the disk (#2659 item 4), and the log must not be
  -- mutated by a run that then refuses for an unrelated reason. Neither
  -- half can move to where the other one is.
  let head = Some (cidToString (repoCommitCid (repoLatestCommit repo)))
  recovery <- eventLogPlanRecovery dir head
  -- Every SUPPLIED secret is read and admitted first, and only then may a
  -- GENERATED one reach the disk: a run rejected for a bad password file or a
  -- world-readable --token-secret must leave no session secret behind for the
  -- next run to adopt as its own (#2659).
  suppliedSecret <- suppliedSessionSecret parsed dir
  credentialSource <- planCredential parsed dir
  () <- requireDataLock lock
  sessionSecret <- establishSessionSecret dir suppliedSecret
  credential <- establishCredential dir credentialSource
  withBlobs <- loadBlobs (storeFromRepo repo) dir
  withSecret <- storeWithServerSecret sessionSecret withBlobs
  let withCredential = storeWithCredential credential withSecret
  prefs <- persistLoadPreferences dir
  -- Last, after the final step that can still refuse: the log is now
  -- consistent with the head, and only a run that goes on to serve has
  -- touched it. The genesis events are a durable log mutation with nothing
  -- downstream of them that can refuse, so they belong at the same point and
  -- not beside the `--init` repository write that provoked them.
  --
  -- Unconditional, and after the single-entry recovery rather than in place of
  -- it: the two questions are independent and are asked in this order. The
  -- recovery above finishes or drops whatever ONE entry a previous process
  -- left pending, which is what makes the promoted count the whole truth about
  -- how far the quartet got. `created` cannot gate this: the only run allowed
  -- to pass `--init` is the run that creates the repository, so a quartet
  -- interrupted partway through would have no later start able to finish it
  -- (#3006).
  let nowSeconds = floatToInt (now ())
  -- Readmit the sessions the previous process had open, minus whatever
  -- expired while nothing was running: a restart is not a logout. Pruning
  -- here rather than trusting the file is what keeps a stale row from
  -- outliving its own expiry across a long stop.
  () <- if fileExists (sessionsPath dir) then
    requirePrivateMode "sessions file" (sessionsPath dir)
  else
    Ok ()
  sessionRows <- persistLoadSessions dir
  () <- requireDataLock lock
  () <- eventLogApplyRecovery dir recovery eventLogRetentionSeconds nowSeconds
  () <- completeGenesisEvents dir did handle nowSeconds repo
  -- One more before the scheduler starts, so that the gap `start`'s beat loop
  -- inherits is the loop's own interval rather than everything above it.
  () <- requireDataLock lock
  Ok (
    server,
    storeSessionsPrune
      nowSeconds
      (storeWithSessionRows
        sessionRows
        (storeWithPreferences prefs withCredential)),
    dir,
    port,
    bind,
    serving,
    relay,
    statsInterval,
    lock,
    [
      "serve: config did=\{did} handle=\{handle} hostname=\{hostname} data=\{dir} bind=\{bind} trusted-proxy=\{yesNo (flag "--trusted-proxy" parsed)} appview=\{yesNo (isSome egress)} relay=\{yesNo (isSome relay)}",
      "serve: data directory lock: \{lockOutcome}",
      "serve: event log recovery: \{recoveryOutcome recovery}",
    ],
  )

yesNo : Bool -> String
yesNo True = "yes"
yesNo False = "no"

{- | What recovery did to the event log, for the startup line.

   The names are what HAPPENED and not what was decided, which is why the line
   is rendered at the end of `configure` rather than beside
   `eventLogPlanRecovery`: `eventLogApplyRecovery` runs between the two, and a
   run that failed to promote never reaches here to claim it did. -}
recoveryOutcome : EventLogRecovery -> String
recoveryOutcome EventLogSettled = "settled"
recoveryOutcome EventLogOwed = "promoted"
recoveryOutcome EventLogOrphaned = "discarded"

{- | This server's own version, as `pds/medaka.toml` declares it. -}
pdsVersion : String
pdsVersion = "0.1.0"

{- | How this server names the build it is running, from the provenance
   `medaka build --stamp-build` bakes into the binary. The shape and all three
   degradations are `medaka --version`'s, verbatim:

       pdsd 0.1.0 (a1b2c3d4e-dirty, built 2026-09-14)

   so an operator reads a PDS's provenance exactly as they read the compiler's,
   and a binary built WITHOUT the flag reports the bare `pdsd 0.1.0` rather than
   a line with empty parentheses in it. The compiler fingerprint the same flag
   stamps is deliberately absent from this line: it is a 64-character digest,
   `buildFingerprint ()` still returns it for anything that wants to match a
   binary to a compiler, and `medaka --version` omits it for the same reason. -}
versionString : Unit -> <Env> String
versionString _ =
  let commit = buildCommit ()
  let date = buildDate ()
  if commit == "" && date == "" then
    "pdsd \{pdsVersion}"
  else if commit == "" then
    "pdsd \{pdsVersion} (built \{date})"
  else if date == "" then
    "pdsd \{pdsVersion} (\{commit})"
  else
    "pdsd \{pdsVersion} (\{commit}, built \{date})"

{- | The first line of every start that got past `configure`, printed before
   the readiness line so a log begins by saying which build produced
   everything under it — a bind failure's diagnostic included, which is why it
   is written before the bind rather than after it. -}
banner : Unit -> <Env, Stdout> Unit
banner _ = putStrLn "serve: \{versionString ()}"

-- The configuration summary and the event-log recovery outcome, under the
-- banner and above the readiness line. `configure` rendered them; this only
-- writes them.
startupLines : List String -> <Stdout> Unit
startupLines [] = ()
startupLines (line :: rest) =
  let () = putStrLn line
  startupLines rest

-- The readiness line is flushed explicitly: stdout is block-buffered when it is
-- a pipe or a file, and a supervisor that waits for this line before connecting
-- would otherwise wait for a process that never exits.
ready : String -> Int -> <Stdout> Unit
ready bind port =
  let () = putStrLn "serve: listening on \{bind}:\{intToString port}"
  flushStdout ()

reportOutcome : Result String Unit -> <Stderr> Unit
reportOutcome (Ok ()) = ()
reportOutcome (Err message) = abort "serve: accept loop ended: \{message}"

{- | A single best-effort relay announce, fired once at startup rather than on
   every sequenced event the way the reference implementation's rate-limited
   trigger does (`NOTIFY_THRESHOLD`, 1200s) — a deliberate narrowing for this
   slice (`S-crawl-routes`): this server has no event sequencer to hang a
   per-event trigger off yet, and "announce once, if configured" already
   gives an unheard-of server a way to be found without adding a second
   background timer. Failure is logged only and never reaches `reportOutcome`
   or `abort`: an unreachable relay must not prevent startup and must leave
   no durable side effect from a run that reported failure (contract §7;
   #2906, #2659 item 4). -}
announceToRelay : RelayTarget ->
  String ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
announceToRelay target hostname = defer
  outcome <- requestCrawl target hostname
  match outcome
    Ok () => deferPure ()
    Err message =>
      liftIO (u => ePutStrLn "serve: relay announce failed: \{message}")

announce : String ->
  Int ->
  Listener ->
  Store ->
  String ->
  Server ->
  Serving ->
  Option RelayTarget ->
  Duration ->
  Int ->
  Async <Clock, Env, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
announce bind port lis store dir server serving relay statsInterval signalFd =
  defer
    _ <- liftIO (u => ready bind port)
    _ <- match relay
      None => deferPure ()
      Some target =>
        spawn (announceToRelay target (accountHostname (serverAccount server)))
    storeRef <- liftIO (u => Ref store)
    outcome <- runServer server dir storeRef lis serving statsInterval signalFd
    liftIO (u => reportOutcome outcome)

bound : String ->
  Server ->
  Store ->
  String ->
  Serving ->
  Option RelayTarget ->
  Duration ->
  Result String Listener ->
  Async <Clock, Env, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
bound _ _ _ _ _ _ _ (Err message) =
  liftIO (u => abort "serve: bind failed: \{message}")
bound bind server store dir serving relay statsInterval (Ok lis) = defer
  port <- liftIO (u => listenPort lis)
  match port
    Err message =>
      liftIO (u => abort "serve: listener port unavailable: \{message}")
    Ok given => defer
      installed <- liftIO (u => pdsSignalStart ())
      match installed
        Err message =>
          liftIO (u => abort "serve: SIGTERM readiness failed: \{message}")
        Ok signalFd =>
          announce
            bind
            given
            lis
            store
            dir
            server
            serving
            relay
            statsInterval
            signalFd

{- | Keep saying, for as long as this process runs, that it is the one holding
   the data directory. `shell.dirlock` grades a lock by whether this moves, so
   a process that stops beating is a process the next start is entitled to
   take the directory from.

   Spawned in the same shape as `announceToRelay` and `shell.server`'s stats
   loop, and for the same reason: the beat must run concurrently with the
   accept loop rather than between two requests, so the sleep is `async.sleep`,
   which parks this one task, and not `time.sleep`, which blocks the thread
   every other task shares. -}
lockBeatLoop : DataLock ->
  Ref Bool ->
  Async <Clock, FileRead "_", FileWrite "_", Stderr | e> Unit
lockBeatLoop lock stopping = defer
  if !stopping then
    deferPure ()
  else defer
    beat <- liftIO (u => holdDataLock lock)
    match beat
      LockLost message => liftIO (u => abort "serve: \{message}")
      _ => defer
        () <- liftIO (u => reportBeat beat)
        () <- sleep lockBeatInterval
        lockBeatLoop lock stopping

-- A heartbeat this process cannot write is reported and is not fatal: the
-- server is up and answering, and ending a run over one missed beat would turn
-- a momentarily full disk into an outage. What it costs is the lock — long
-- enough without a beat and the next process to start will decide this
-- directory is unheld and take it, which is the case `lockBeatLoop` ends the
-- run over and this one does not: one is this server failing to say it is
-- here, the other is another server already having been told it is not.
reportBeat : LockBeat -> <Stderr> Unit
reportBeat LockHeld = ()
reportBeat (LockBeatFailed message) =
  ePutStrLn "serve: data directory lock heartbeat failed: \{message}"
-- Ended by `lockBeatLoop` before it reaches here; stated rather than swept
-- into a wildcard so that a third outcome added later is a type error here.
reportBeat (LockLost message) =
  ePutStrLn "serve: data directory lock lost: \{message}"

start : Result String (Server, Store, String, Int, String, Serving, Option RelayTarget, Duration, DataLock, List String) ->
  Async <Clock, Env, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
start (Err message) = liftIO (u => abort "serve: \{message}")
start (Ok (server, store, dir, port, bind, serving, relay, statsInterval, lock, lines)) =
  defer
    _ <- liftIO (u => banner ())
    _ <- liftIO (u => startupLines lines)
    _ <- spawn (lockBeatLoop lock (servingStopping serving))
    listener <- liftIO (u => bindAddress bind port)
    bound bind server store dir serving relay statsInterval listener

-- A `keygen` run touches no socket and no repository, so it finishes inside
-- one synchronous step rather than entering the scheduler.
keygen : List String -> <FileRead "_", FileWrite "_", Rand, Stderr, Stdout> Unit
keygen rest = match parseArgs keygenSpec rest
  -- `args` already renders a finished sentence naming the verb.
  Err message => abort message
  Ok parsed => match runKeygen parsed
    Err message => abort "keygen: \{message}"
    Ok () => ()

main : Async <Clock, Env, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout> Unit
main = defer
  argv <- liftIO (u => args ())
  match argv
    "keygen" :: rest => liftIO (u => keygen rest)
    -- Read off raw argv, like `keygen`: `--version` is not a `serve` flag, so
    -- routing it through `parseArgs` would answer a version request with an
    -- unknown-flag rejection.
    "--version" :: _ => liftIO (u => putStrLn (versionString ()))
    _ => defer
      match parseArgs serveSpec argv
        Err message => liftIO (u => abort message)
        Ok parsed => defer
          configured <- liftIO (u => configure parsed)
          start configured
