{- | `pds/serve.mdk` — the PDS entry point: admit a configuration, rehydrate the
   account repository from disk, bind the listener, and serve.

   Every configuration value arrives as a command-line flag and is admitted
   before anything is bound: a bad DID, handle, or hostname is rejected by
   `lib.server_core`'s `makeAccount`, an unreadable or non-hex signing key by
   `readHexBytes`, a data directory that is not a directory by `requireDir`,
   and a repository whose head does not verify under the configured key by
   `lib.repo`'s `repoFromBlocks`. Every one of those exits nonzero. There is no
   default for any of them, so a misconfigured server never starts serving
   something other than what was asked for.

   The bind address is `--bind`, defaulting to `127.0.0.1` (loopback). A
   non-loopback address is refused before anything is read or written unless
   `--trusted-proxy` is also given (`requireTrustedBind`): this process has no
   way to observe whether the peer on the other end of an accepted connection
   is actually the reverse proxy `--trusted-proxy` says it is — there is no
   `getpeername` in the runtime — so the flag is an operator assertion about
   the deployment, not a verified fact, and the refusal is what makes an
   unproxied direct bind require deliberately opting out of it rather than
   silently exposing the server (`#2757`,
   `docs/design/ATPROTO-PDS-DESIGN.md`).

   The signing key is read here and handed to `lib.repo`, which is the only
   thing that needs it, and to nothing else. It is never printed, and neither is
   the `Store` that transitively holds it.

   The session-token secret is the SECOND secret this entry point holds: the
   server's own 32-byte HS256 key, which `lib.server_core`'s seam verifies
   bearer tokens against. It is deliberately a different key from `--key`: the
   signing key authenticates commits to every other implementation on the
   network and has exactly one job. `--token-secret PATH` supplies it; with no
   flag, the secret is generated from `osEntropyBytes` on first run and kept in
   `<data>/session-secret` for every run after.

   The account password is the THIRD, and it is what `com.atproto.server.
   createSession` grades a login against. It arrives as `--password-file PATH`
   and NEVER as an argument value: an argument is visible in `ps` output to
   every user on the box. There is no interactive prompt either — no termios,
   tty, or echo-suppression primitive exists in the runtime or the stdlib, and
   a prompt that echoed the password to the terminal would be worse than the
   file, not better. The password is read once, at bootstrap, turned into a
   PBKDF2 credential record (`lib.credential`), and never stored: `<data>/
   credential` holds a salt, an iteration count, and a derived key. A run whose
   data directory already holds that record needs no `--password-file` at all.

   Every file this program creates holding a secret — the generated session
   secret and the credential record — is written at mode 0600, and a secret
   file it READS at any wider mode is refused before the listener binds rather
   than used: a signing key or session-token secret that another account on
   the box can read is not a secret, and serving anyway would be
   indistinguishable from a correctly permissioned deployment right up until
   somebody used it.

   A failed configuration leaves nothing behind either: every secret the flags
   SUPPLY is read and admitted before any secret this program GENERATES is
   written, so a run rejected for a bad password file leaves no session secret
   on disk for the next run to adopt. -}

import args.{
  Args,
  ArgSpec,
  flag,
  flagValue,
  intValue,
  parseArgs,
  spec,
  switch,
  value,
}
import array as A
import async.{Async, liftIO}
import fs.{isDir}
import hex.{decode, encode}
import io.{isPrivateMode, writeFilePrivate}
import lib.blob.{validMimeShape}
import lib.credential.{
  CredentialRecord,
  credentialFromParts,
  defaultIterations,
  makeCredential,
  saltBytes,
}
import lib.jwt.{serverSecretBytes}
import lib.ratelimit.{TrustedProxy(..)}
import lib.handlers.{pdsServer}
import lib.proxy.{AppviewPolicy, makeAppviewPolicy}
import lib.repo.{
  Repo,
  repoCommitCid,
  repoExportBlocks,
  repoFromBlocks,
  repoInitFromKeyBytes,
  repoLatestCommit,
}
import lib.server_core.{Server, makeAccount}
import lib.sign.{SecretKey, secretKeyFromBytes}
import lib.cid.{Cid, cidToString}
import lib.event_log_record.{eventLogRetentionSeconds}
import lib.store.{
  Store,
  storePutBlob,
  storeFromRepo,
  storeWithCredential,
  storeWithServerSecret,
}
import lib.tid.{Tid, tidEncode}
import net.{Listener, listenPort}
import shell.blobfile.{blobFileRead}
import shell.egress.{Egress, makeEgress}
import shell.eventlog.{eventLogRecover}
import shell.keygen.{keygenRefusePath, keygenSigningKey, keygenTokenSecret}
import shell.persist.{
  credentialPath,
  persistCredential,
  persistHasHead,
  persistLoad,
  persistSave,
}
import shell.server.{Serving, bindAddress, makeServing, runServer}
import string.{lines, stripSuffix, toInt, trim}
import time.{now}

serveSpec : ArgSpec
serveSpec = spec "serve" [
  value ["--did"] "DID" "the repository owner's DID",
  value ["--handle"] "HANDLE" "the repository owner's handle",
  value ["--hostname"] "HOST" "this PDS's own hostname",
  value ["--key"] "PATH" "file holding the hex-encoded secp256k1 signing key",
  value
    ["--token-secret"]
    "PATH"
    "file holding the hex-encoded 32-byte session-token secret",
  value
    ["--password-file"]
    "PATH"
    "file holding the account password, for first-run credential bootstrap",
  value ["--data"] "DIR" "existing directory holding the persisted repository",
  intValue ["--port"] "N" "TCP port to bind; 0 picks a free one",
  value
    ["--bind"]
    "ADDR"
    "address to bind, default 127.0.0.1 (loopback); a non-loopback address is refused unless --trusted-proxy is also given",
  switch ["--init"] "create the genesis repository in an empty data directory",
  switch
    ["--trusted-proxy"]
    "trust this connection's peer to be the reverse proxy in front of it, and read the client identity `X-Forwarded-For` names for rate limiting; without it every request shares one identity bucket",
  value
    ["--appview-did"]
    "DID"
    "the ONE appview service DID an atproto-proxy header may name; requires --egress-port, and without both no request is ever proxied",
  intValue
    ["--egress-port"]
    "N"
    "loopback port of the local egress proxy that forwards to --appview-did; requires --appview-did",
]

{- | `pds keygen`'s roster. Both flags name a file to CREATE, and both are
   spelled exactly as `serve` spells the file it later reads back, so a
   generated key is passed to `serve` under the same name it was generated
   under. Neither takes a value that is a secret: a secret in an argument is
   visible in `ps` output to every account on the box, which is why every
   secret in this program travels as a file. -}
keygenSpec : ArgSpec
keygenSpec = spec "keygen" [
  value ["--key"] "PATH" "write a new hex-encoded secp256k1 signing key here",
  value
    ["--token-secret"]
    "PATH"
    "write a new hex-encoded 32-byte session-token secret here",
]

abort : String -> <Stderr> Unit
abort message =
  let () = ePutStrLn message
  exit 1

required : String -> Args -> Result String String
required name parsed = match flagValue name parsed
  Some given => Ok given
  None => Err "missing required flag \{name}"

requiredPort : Args -> Result String Int
requiredPort parsed = do
  text <- required "--port" parsed
  match toInt text
    None => Err "--port is not an integer: \{text}"
    Some port =>
      if port < 0 || port > 65535 then
        Err "--port must be in 0..65535"
      else
        Ok port

loopbackAddress : String
loopbackAddress = "127.0.0.1"

-- `--bind`, defaulting to loopback when absent. There is no admission check
-- here — a malformed address is caught the same way it always was, by
-- `shell.server`'s `bindAddress` failing to bind it.
bindAddressOf : Args -> String
bindAddressOf parsed = match flagValue "--bind" parsed
  Some given => given
  None => loopbackAddress

isLoopbackAddress : String -> Bool
isLoopbackAddress addr = addr == loopbackAddress

{- | Refuse a non-loopback bind unless `--trusted-proxy` is also set (`#2757`).

   This process cannot observe whether the peer on the other end of an
   accepted connection really is the reverse proxy `--trusted-proxy` claims —
   there is no `getpeername` in the runtime — so the flag is an operator
   assertion about the deployment, and this refusal is what makes skipping it
   a deliberate act rather than a silent direct exposure. It fires before any
   secret is read or generated and before the listener binds (`#2659` item
   4's ordering; a refusal here must leave nothing behind either). -}
requireTrustedBind : String -> TrustedProxy -> Result String Unit
requireTrustedBind bind (TrustedProxy trusted) =
  if isLoopbackAddress bind || trusted then
    Ok ()
  else
    Err
      "refusing to bind \{bind}: a non-loopback bind requires --trusted-proxy (see docs/ops/PDS-DEPLOY.md)"

-- Port 0 is accepted for `--port` because the kernel picks a free one there.
-- An egress port is a port this process must REACH, so 0 names nothing.
egressPortOf : String -> Result String Int
egressPortOf text = match toInt text
  None => Err "--egress-port is not an integer: \{text}"
  Some port =>
    if port < 1 || port > 65535 then
      Err "--egress-port must be in 1..65535"
    else
      Ok port

{- | Where a proxied read goes, and the audience a client's `atproto-proxy`
   header is allowed to name — or `None`, meaning this server proxies nothing.

   All or none. `--appview-did` alone names an audience with no route to it and
   `--egress-port` alone names a route with no audience allowed to claim it, so
   either alone is a startup refusal rather than a silently inert proxy: an
   operator who believes forwarding is configured and is wrong learns it here
   rather than from a 400 on a route they expected to be forwarded.

   With neither, every `atproto-proxy` header there is gets refused with
   nothing signed, which is the only safe default for a server whose operator
   has not said where its appview is — a proxy that defaults to somewhere is a
   credential-bearing call to a destination nobody chose. -}
configureEgress : Args -> SecretKey -> Result String (Option Egress)
configureEgress parsed signingKey = match (
  flagValue "--appview-did" parsed,
  flagValue "--egress-port" parsed,
)
  (None, None) => Ok None
  (Some _, None) =>
    Err "--appview-did requires --egress-port (see docs/ops/PDS-DEPLOY.md)"
  (None, Some _) =>
    Err "--egress-port requires --appview-did (see docs/ops/PDS-DEPLOY.md)"
  (Some did, Some portText) => do
    policy <- appviewPolicyOf did
    port <- egressPortOf portText
    Ok (Some (makeEgress port policy signingKey))

appviewPolicyOf : String -> Result String AppviewPolicy
appviewPolicyOf did = match makeAppviewPolicy did
  Err message => Err "--appview-did \{did}: \{message}"
  Ok policy => Ok policy

-- The mode as `chmod` and `stat -c %a` spell it, so an operator can compare a
-- rejection to the `0600` its remedy names without converting anything.
octalMode : Int -> String
octalMode mode =
  let digit = shift => intToString (bitAnd (shiftRight mode shift) 7)
  "0\{digit 6}\{digit 3}\{digit 0}"

{- | Refuse a secret file any account but its owner can read.

   This is a startup check, not a warning: a group- or world-readable signing
   key has already been exposed to every other account on the box for as long
   as it has been there, and a server that serves anyway hides that. -}
requirePrivateMode : String -> String -> <FileRead "_"> Result String Unit
requirePrivateMode label path = do
  mode <- match fileMode path
    Err message => Err "unreadable \{label} \{path}: \{message}"
    Ok given => Ok given
  if isPrivateMode mode then
    Ok ()
  else
    Err
      "refusing to start: \{label} \{path} is mode \{octalMode mode}, readable by accounts other than its owner; restrict it (chmod 0600 \{path}) and restart"

-- Neither key reaches a diagnostic: the mode and read errors name the path,
-- and `hex.decode`'s own messages do not echo what they were given.
readHexBytes : String -> String -> <FileRead "_"> Result String (Array Int)
readHexBytes label path = do
  () <- requirePrivateMode label path
  text <- match readFile path
    Err message => Err "unreadable \{label} \{path}: \{message}"
    Ok given => Ok given
  match decode (trim text)
    Err message => Err "\{label} \{path} is not hex: \{message}"
    Ok bytes => Ok bytes

sessionSecretPath : String -> String
sessionSecretPath dir = "\{dir}/session-secret"

{- | How many distinct byte values a 32-byte session-token secret must carry.

   Thirty-two independent random bytes hold about 28 distinct values, and hold
   fewer than eight with probability far below 1 in 2^60 — so this refuses a
   placeholder (32 zero bytes, a repeated pattern, a short string padded out)
   without ever refusing a real one. It is a NON-ENTROPY detector, not an
   entropy estimator: a secret this admits is not thereby proven random; it merely
   is not obviously constant. -}
minSecretDistinctBytes : Int
minSecretDistinctBytes = 8

distinctSeen : Array Int -> Array Int -> Int -> Int -> Int
distinctSeen bytes seen i found =
  if i >= arrayLength bytes then
    found
  else
    let byte = bytes[i]
    if byte < 0 || byte > 255 || seen[byte] == 1 then
      distinctSeen bytes seen (i + 1) found
    else
      let () = A.setInPlace byte 1 seen
      distinctSeen bytes seen (i + 1) (found + 1)

distinctByteValues : Array Int -> Int
distinctByteValues bytes = distinctSeen bytes (arrayMake 256 0) 0 0

{- | Refuse a session-token secret that is not a generated one.

   Neither the secret nor any measurement of it reaches this diagnostic: a
   count of distinct bytes is a property of the value, and the value is a
   secret even while it is being refused. The message names the file and the
   remedy, which is all an operator needs. -}
admitSessionSecret : String -> Array Int -> Result String (Array Int)
admitSessionSecret path bytes =
  if distinctByteValues bytes < minSecretDistinctBytes then
    Err
      "refusing to start: session-token secret \{path} is a constant or near-constant value, not a generated secret; every session token this server issues would be forgeable from it (generate one with: pds keygen --token-secret \{path})"
  else
    Ok bytes

{- | Generate this server's session-token secret and keep it, at mode 0600. It
   is drawn from `osEntropyBytes`, the OS entropy source, and never from
   `randomInt`, whose SplitMix64 generator is seeded deterministically and
   would make every session token on every deployment forgeable from a public
   constant. -}
generateSessionSecret : String ->
  <FileWrite "_", Rand> Result String (Array Int)
generateSessionSecret dir = do
  let bytes = osEntropyBytes serverSecretBytes
  () <- match writeFilePrivate (sessionSecretPath dir) "\{encode bytes}\n"
    Err message =>
      Err "unwritable session secret \{sessionSecretPath dir}: \{message}"
    Ok () => Ok ()
  Ok bytes

{- | The session-token secret this run already has: the one `--token-secret`
   names, else the one kept in the data directory, else `None` — meaning one
   must be generated.

   This is the READ half, and it writes nothing, so a later failure cannot
   strand a secret it created. A PRESENT but unusable secret IS an error,
   refused before the listener binds rather than at the first request that
   needed it. -}
suppliedSessionSecret : Args ->
  String ->
  <FileRead "_"> Result String (Option (Array Int))
suppliedSessionSecret parsed dir = match flagValue "--token-secret" parsed
  Some path => map Some (readSessionSecret path)
  None =>
    if fileExists (sessionSecretPath dir) then
      map Some (readSessionSecret (sessionSecretPath dir))
    else
      Ok None

-- Both arms above read a secret somebody else chose — the flag's file, or one
-- a previous run left in the data directory — so both are graded, and the one
-- this program generates below is graded by construction instead.
readSessionSecret : String -> <FileRead "_"> Result String (Array Int)
readSessionSecret path = do
  bytes <- readHexBytes "session-token secret" path
  admitSessionSecret path bytes

-- The WRITE half: generate the secret only when the read half found none.
establishSessionSecret : String ->
  Option (Array Int) ->
  <FileWrite "_", Rand> Result String (Array Int)
establishSessionSecret _ (Some bytes) = Ok bytes
establishSessionSecret dir None = generateSessionSecret dir

{- | The account password, as the file holds it: everything in the file with
   one trailing newline removed, which is what `printf %s\\n` and every text
   editor put there. Nothing else is stripped — leading and interior spaces are
   part of a password, and a password this program silently rewrote would not
   be the one its owner typed. -}
passwordOf : String -> Result String String
passwordOf text =
  let password = match stripSuffix "\n" text
    Some shorter => shorter
    None => text
  if password == "" then Err "the password file is empty" else Ok password

-- The password `--password-file` supplies, read and admitted but not yet
-- turned into anything: `planCredential` returns it so the derive-and-keep
-- can happen after every other supplied secret has been admitted too.
-- Neither arm is a failure, so `Result` would be the wrong shape: it would
-- read a supplied password as an error to be recovered from.
-- lint-disable-next-line rule-clone-type
data CredentialSource = Kept CredentialRecord | Bootstrap String

{- | Derive the account credential from an admitted password and keep it, at
   mode 0600. The salt is drawn here, from `osEntropyBytes`: `lib.credential`
   takes a caller-supplied salt and draws no entropy of its own. -}
bootstrapCredential : String ->
  String ->
  <FileWrite "_", Rand> Result String CredentialRecord
bootstrapCredential dir password = do
  record <- makeCredential (osEntropyBytes saltBytes) defaultIterations password
  () <- persistCredential dir record
  Ok record

loadCredential : String -> <FileRead "_"> Result String CredentialRecord
loadCredential dir = do
  text <- match readFile (credentialPath dir)
    Err message => Err "unreadable credential \{credentialPath dir}: \{message}"
    Ok given => Ok given
  match lines (trim text)
    [iterationsText, saltText, digestText] => do
      iterations <- match toInt iterationsText
        None =>
          Err
            "credential \{credentialPath dir}: first line is not an iteration count"
        Some given => Ok given
      salt <- decode saltText
      digest <- decode digestText
      credentialFromParts salt iterations digest
    _ =>
      Err
        "credential \{credentialPath dir}: expected three lines (iterations, salt, derived key)"

{- | Where the account's password credential comes from: the one the data
   directory already holds, else the password `--password-file` supplies.

   This is the READ half, and it writes nothing. With neither, the server
   refuses to start. The alternative — starting with no credential and
   refusing every login — would look identical to a correctly configured
   server right up until somebody tried to use it, and the fix would be
   invisible from the outside. -}
planCredential : Args -> String -> <FileRead "_"> Result String CredentialSource
planCredential parsed dir =
  let exists = fileExists (credentialPath dir)
  match (exists, flagValue "--password-file" parsed)
    (True, None) => map Kept (loadCredential dir)
    (True, Some _) =>
      Err
        "refusing to start: \{credentialPath dir} already exists and --password-file was given; in-place rotation is not supported, so remove \{credentialPath dir} first if you intend to replace the password"
    (False, None) =>
      Err
        "no account credential in \{credentialPath dir}: pass --password-file PATH once, holding the account password, to bootstrap one (the password is never taken from an argument value, and there is no terminal prompt)"
    (False, Some path) => map Bootstrap (readPassword path)

-- The supplied password, admitted: unreadable or empty is a rejection here,
-- where nothing has been written yet.
readPassword : String -> <FileRead "_"> Result String String
readPassword path = do
  text <- match readFile path
    Err message => Err "unreadable password file \{path}: \{message}"
    Ok given => Ok given
  match passwordOf text
    Err message => Err "\{path}: \{message}"
    Ok given => Ok given

-- The WRITE half: derive and keep only the password the read half admitted.
establishCredential : String ->
  CredentialSource ->
  <FileWrite "_", Rand> Result String CredentialRecord
establishCredential _ (Kept record) = Ok record
establishCredential dir (Bootstrap password) = bootstrapCredential dir password

{- | `pds keygen` — generate the secrets `pds serve` will not generate for an
   operator: the account signing key, and, when asked, a session-token secret.

   Neither flag has a default, and a run naming neither is an error rather
   than a no-op: a `keygen` that silently generated nothing would look exactly
   like one whose output the operator was about to configure.

   EVERY destination is refused-or-admitted before ANY of them is written, the
   shape `configure` takes for #2659 item 4: a run rejected for its second
   file must leave no secret behind from its first. -}
runKeygen : Args ->
  <FileRead "_", FileWrite "_", Rand, Stdout> Result String Unit
runKeygen parsed = match (
  flagValue "--key" parsed,
  flagValue "--token-secret" parsed,
)
  (None, None) =>
    Err
      "name at least one file to write (--key PATH for the signing key, --token-secret PATH for the session-token secret)"
  (Some keyPath, None) => do
    () <- keygenRefusePath "signing key" keyPath
    keygenSigningKey keyPath
  (None, Some secretPath) => do
    () <- keygenRefusePath "session-token secret" secretPath
    keygenTokenSecret secretPath
  (Some keyPath, Some secretPath) => do
    -- Two names for one file pass both existence checks and would still write
    -- twice, so distinctness is part of admitting the destinations.
    () <- requireDistinctDestinations keyPath secretPath
    () <- keygenRefusePath "signing key" keyPath
    () <- keygenRefusePath "session-token secret" secretPath
    () <- keygenSigningKey keyPath
    keygenTokenSecret secretPath

requireDistinctDestinations : String -> String -> Result String Unit
requireDistinctDestinations keyPath secretPath =
  if keyPath == secretPath then
    Err
      "refusing \{keyPath}: --key and --token-secret name the same file, and the two secrets are not interchangeable; name two files"
  else
    Ok ()

requireDir : String -> <FileRead "_"> Result String Unit
requireDir dir = match isDir dir
  Err message => Err "data directory \{dir}: \{message}"
  Ok False => Err "data directory \{dir} is not a directory"
  Ok True => Ok ()

genesisTid : Unit -> <Clock> Result String Tid
genesisTid u = tidEncode (floatToInt (now u * 1000000.0)) 0

{- | Create and persist the genesis repository. `--init` refuses a directory
   that already holds one rather than writing over it, so a rerun of a serving
   command cannot silently discard an account's history. -}
initRepo : String ->
  String ->
  Array Int ->
  <Clock, FileRead "_", FileWrite "_"> Result String Repo
initRepo dir did keyBytes = do
  genesis <- genesisTid ()
  repo <- repoInitFromKeyBytes did keyBytes genesis
  blocks <- repoExportBlocks repo
  () <- persistSave dir (repoCommitCid (repoLatestCommit repo)) blocks
  Ok repo

{- | Every persisted blob, read back into the initial `Store` before a single
   connection is accepted.

   Bytes off disk are untrusted exactly as the repository's blocks are, and are
   re-checked the same way: `storePutBlob` verifies each row against the CID its
   file name spells (`blockStorePut`, the very check `blockStoreFromBlocks`
   folds over the repository half), so a tampered blob file refuses the whole
   startup rather than being served. -}
loadBlobs : Store -> String -> <FileRead "_"> Result String Store
loadBlobs store dir = do
  rows <- blobFileRead dir
  admitBlobRows rows store

{- | This is the seam a declared MIME type crosses from the disk into the
   `Store`, and the only place it is checked on the way in: nothing downstream
   re-reads a sidecar, and `sync.getBlob` puts the stored type straight into a
   response header, where a value carrying a control byte is refused far too
   late to answer with. `admitBlob` applies the same shape check to the upload
   path, so a value that reaches here and fails it came from a tampered file
   and belongs to no blob this server can serve. -}
admitBlobRows : List (Cid, String, Array Int) -> Store -> Result String Store
admitBlobRows [] store = Ok store
admitBlobRows ((cid, mimeType, bytes) :: rest) store =
  if not (validMimeShape mimeType) then
    admitBlobRows rest store
  else match storePutBlob cid mimeType bytes store
    Err message => Err "persisted blob \{cidToString cid} rejected: \{message}"
    Ok next => admitBlobRows rest next

loadRepo : String -> String -> SecretKey -> <FileRead "_"> Result String Repo
loadRepo dir did secret = do
  (head, blocks) <- persistLoad dir
  repoFromBlocks did secret head blocks

openRepo : Bool ->
  String ->
  String ->
  Array Int ->
  SecretKey ->
  <Clock, FileRead "_", FileWrite "_"> Result String Repo
openRepo False dir did _ secret = loadRepo dir did secret
openRepo True dir did keyBytes secret =
  if persistHasHead dir then match loadRepo dir did secret
    Ok _ => Err "--init refuses \{dir}: it already holds a repository"
    Err message =>
      Err
        "--init refuses \{dir}: it already holds a repository, but its head does not load under the configured --did and --key (\{message}); check those flags rather than reinitializing"
  else
    initRepo dir did keyBytes

{- | Everything the server needs, or the first reason it may not run: the
   configured server, its initial store, the data directory, the port, and
   the address to bind. -}
configure : Args ->
  <Clock, FileRead "_", FileWrite "_", Rand> Result String (Server, Store, String, Int, String, Serving)
configure parsed = do
  did <- required "--did" parsed
  handle <- required "--handle" parsed
  hostname <- required "--hostname" parsed
  keyPath <- required "--key" parsed
  dir <- required "--data" parsed
  port <- requiredPort parsed
  let bind = bindAddressOf parsed
  let trustedProxy = TrustedProxy (flag "--trusted-proxy" parsed)
  -- Before anything else is read or generated: a bind refusal must leave no
  -- secret behind, same as every other refusal `configure` can raise
  -- (#2659 item 4).
  () <- requireTrustedBind bind trustedProxy
  account <- makeAccount did handle hostname
  server <- pdsServer account
  keyBytes <- readHexBytes "signing key" keyPath
  secret <- secretKeyFromBytes keyBytes
  -- Admitted here, beside the other flag-supplied configuration and ahead of
  -- every generated secret, for the same reason `requireTrustedBind` is: a run
  -- refused for a malformed appview DID must leave no session secret on disk
  -- for the next run to adopt (#2659 item 4).
  egress <- configureEgress parsed secret
  let serving = makeServing trustedProxy egress
  () <- requireDir dir
  repo <- openRepo (flag "--init" parsed) dir did keyBytes secret
  -- A previous process may have died between persisting a commit and
  -- appending the event announcing it. The staged entry names the commit it
  -- announces, so the repository just loaded is what decides whether it is
  -- finished or dropped; either way the log is consistent with the head
  -- before the first connection is accepted.
  let head = Some (cidToString (repoCommitCid (repoLatestCommit repo)))
  () <- eventLogRecover dir head eventLogRetentionSeconds (floatToInt (now ()))
  -- Every SUPPLIED secret is read and admitted first, and only then may a
  -- GENERATED one reach the disk: a run rejected for a bad password file or a
  -- world-readable --token-secret must leave no session secret behind for the
  -- next run to adopt as its own (#2659).
  suppliedSecret <- suppliedSessionSecret parsed dir
  credentialSource <- planCredential parsed dir
  sessionSecret <- establishSessionSecret dir suppliedSecret
  credential <- establishCredential dir credentialSource
  withBlobs <- loadBlobs (storeFromRepo repo) dir
  withSecret <- storeWithServerSecret sessionSecret withBlobs
  Ok (
    server,
    storeWithCredential credential withSecret,
    dir,
    port,
    bind,
    serving,
  )

-- The readiness line is flushed explicitly: stdout is block-buffered when it is
-- a pipe or a file, and a supervisor that waits for this line before connecting
-- would otherwise wait for a process that never exits.
ready : String -> Int -> <Stdout> Unit
ready bind port =
  let () = putStrLn "serve: listening on \{bind}:\{intToString port}"
  flushStdout ()

reportOutcome : Result String Unit -> <Stderr> Unit
reportOutcome (Ok ()) = ()
reportOutcome (Err message) = abort "serve: accept loop ended: \{message}"

announce : String ->
  Int ->
  Listener ->
  Store ->
  String ->
  Server ->
  Serving ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
announce bind port lis store dir server serving = defer
  _ <- liftIO (u => ready bind port)
  storeRef <- liftIO (u => Ref store)
  outcome <- runServer server dir storeRef lis serving
  liftIO (u => reportOutcome outcome)

bound : String ->
  Server ->
  Store ->
  String ->
  Serving ->
  Result String Listener ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
bound _ _ _ _ _ (Err message) =
  liftIO (u => abort "serve: bind failed: \{message}")
bound bind server store dir serving (Ok lis) = defer
  port <- liftIO (u => listenPort lis)
  match port
    Err message =>
      liftIO (u => abort "serve: listener port unavailable: \{message}")
    Ok given => announce bind given lis store dir server serving

start : Result String (Server, Store, String, Int, String, Serving) ->
  Async <Clock, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout | e> Unit
start (Err message) = liftIO (u => abort "serve: \{message}")
start (Ok (server, store, dir, port, bind, serving)) = defer
  listener <- liftIO (u => bindAddress bind port)
  bound bind server store dir serving listener

-- A `keygen` run touches no socket and no repository, so it finishes inside
-- one synchronous step rather than entering the scheduler.
keygen : List String -> <FileRead "_", FileWrite "_", Rand, Stderr, Stdout> Unit
keygen rest = match parseArgs keygenSpec rest
  -- `args` already renders a finished sentence naming the verb.
  Err message => abort message
  Ok parsed => match runKeygen parsed
    Err message => abort "keygen: \{message}"
    Ok () => ()

main : Async <Clock, Env, FileRead "_", FileWrite "_", Net "_", Rand, Stderr, Stdout> Unit
main = defer
  argv <- liftIO (u => args ())
  match argv
    "keygen" :: rest => liftIO (u => keygen rest)
    _ => defer
      match parseArgs serveSpec argv
        Err message => liftIO (u => abort message)
        Ok parsed => defer
          configured <- liftIO (u => configure parsed)
          start configured
