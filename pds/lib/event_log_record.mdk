{- | The record format and the sequence/cursor/retention arithmetic of the
   firehose event log (`docs/design/ATPROTO-PDS-DESIGN.md` row P12).

   Nothing here performs I/O. The log FILES, their promotion and their
   truncation are `pds/shell/eventlog.mdk`'s; what lives here is every
   decision about the log that can be taken over plain values, so each one is
   testable without a data directory: how one entry is written down and read
   back, what a cursor means, which entries a retention bound still admits,
   and how an entry's identity is spelled in the name of the file that holds
   it.

   The stored payload is the frame `lib.sync_event` produced, as hex. Hex
   rather than raw bytes because the only text-free write primitive this tree
   has writes a whole file (`stdlib/runtime.mdk` declares `appendFile` over
   `String` and no `appendFileBytes`), so an entry has to survive a round trip
   through text. Doubling the stored size costs retention nothing: the bound
   is a time window, not an entry count or a byte ceiling.

   Nothing here reads the payload. An entry is opaque bytes plus the
   arithmetic above, which is what lets the log carry a `#commit`, an
   `#identity`, an `#account` or a `#sync` without a case for each. -}

import list.{sortBy}
import string.{padLeft, split, toInt}

{- | One entry as it is written down.

   `seq` and `timeSeconds` are repeated in the name of the file that carries
   the entry, and a reader compares the two rather than trusting either
   (`pds/shell/blockfile.mdk`'s discipline: nothing on disk is assumed valid).

   `anchorCommitCid` is the repository head this entry's own truth depends on,
   and it is what a restart grades a half-finished append against
   (`eventLogEntryOwed`). A `#commit` event anchors to the head it announces.
   An event that announces no repository mutation anchors to nothing and
   carries `None`. -}
public export data EventLogEntry = EventLogEntry {
  seq : Int,
  timeSeconds : Int,
  anchorCommitCid : Option String,
  frameHex : String,
}

{- | Whether a pending entry left behind by a dead process is still owed, given
   the head that repository actually persisted — the whole recovery
   discriminator, taken over plain values so it is gradeable without a data
   directory.

   An ANCHORED entry is owed exactly when the persisted head is its anchor. A
   caller stages before it persists the commit, so an anchor the head does not
   name is an event whose commit never landed: it is owed to nobody and
   announcing it would publish a mutation no reader can fetch.

   An UNANCHORED entry is ALWAYS owed, and the asymmetry is not a shrug. There
   is no fact on disk that could make such an entry false, and finishing is the
   only rule that converges: a promotion writes the entry's own file before it
   moves the pointer, so a crash inside one leaves an entry file that
   discarding the pending copy could not take back — a sequence number the log
   holds and the pointer denies. Finishing is idempotent and reaches the same
   state however many times it runs. Discarding is safe for an anchored entry
   only because a mismatched anchor proves the promotion never began.

   That makes UNANCHORED an OBLIGATION on whoever stages, not a free choice: an
   event announcing durable state this log does not itself hold must anchor to
   the commit that state lands with, or a crash between the stage and that
   state reaching disk publishes an event nothing corroborates. -}
export
eventLogEntryOwed : Option String -> EventLogEntry -> Bool
eventLogEntryOwed headCommitCid entry = match entry.anchorCommitCid
  None => True
  Some anchor => headCommitCid == Some anchor

{- | The sequence number of a repository's first emitted event.

   One, not zero, so that zero is available as the "before everything" cursor
   without an `Option` — see `eventLogAfterCursor`. -}
export
eventLogFirstSeq : Int
eventLogFirstSeq = 1

-- | The sequence number after `seq`. Strictly increasing, never reused.
export
eventLogNextSeq : Int -> Int
eventLogNextSeq seq = seq + 1

{- | How long an emitted event stays readable, in seconds — three days.

   This is a DEFAULT, not a protocol constant, and every function that acts on
   it takes it as a parameter so an operator can move it. The sync
   specification states no retention window at all; the number is the
   configurable default of the relay generation `docs/design/
   ATPROTO-PDS-DESIGN.md` row P12 recorded, which asked that it be re-derived
   here rather than inherited. Re-derived against the repository's own ground
   truth it is unchanged, and the design is robust to it moving in either
   direction: `com.atproto.sync.getRepo` covers full resynchronization
   independently of anything this log still holds. -}
export
eventLogRetentionSeconds : Int
eventLogRetentionSeconds = 259200

{- | How many appends pass between truncation sweeps.

   Truncation has to list the live log, which is linear in it, so running one
   per append would make an append cost what the log currently holds — the
   whole-set-rewrite shape #2692 measured, in a new place. Sweeping on every
   n-th sequence number instead keeps the append itself a fixed number of file
   operations and the sweep amortized across them. -}
export
eventLogSweepInterval : Int
eventLogSweepInterval = 256

-- | Whether the entry numbered `seq` is the one whose append also sweeps.
export
eventLogSweepsAt : Int -> Bool
eventLogSweepsAt seq = seq % eventLogSweepInterval == 0

{- | Whether an entry emitted at `timeSeconds` has fallen out of the window.

   An entry exactly `retentionSeconds` old is still live; the window is closed
   at its far end, so a bound of zero drops everything emitted before this
   instant and nothing emitted at it. -}
export
eventLogExpired : Int -> Int -> Int -> Bool
eventLogExpired retentionSeconds nowSeconds timeSeconds =
  nowSeconds - timeSeconds > retentionSeconds

{- | The entries a subscriber holding `cursor` has not seen yet, in sequence
   order.

   A cursor NAMES THE LAST EVENT ALREADY DELIVERED, so cursor n yields every
   entry with seq strictly greater than n and a fresh subscriber passes 0 to
   receive the whole live log. The three boundaries this fixes, and which a
   later subscribe route must not re-decide: a cursor below the oldest live
   entry replays from that oldest entry (it neither fails nor skips ahead), a
   cursor exactly at an entry excludes that entry, and a cursor at or past the
   newest entry yields nothing rather than the newest one again. -}
export
eventLogAfterCursor : Int -> List EventLogEntry -> List EventLogEntry
eventLogAfterCursor cursor entries =
  sortBy
    (left right => compare left.seq right.seq)
    (filter (entry => entry.seq > cursor) entries)

-- Sequence numbers and timestamps are zero-padded to fixed widths so that a
-- directory listing sorted as text is sorted as numbers. Sixteen digits
-- exceeds what a 64-bit counter can reach; eleven covers Unix seconds past
-- the year 5138.
seqWidth : Int
seqWidth = 16

timeWidth : Int
timeWidth = 11

{- | The file name one entry is stored under: its sequence number and its
   timestamp, in that order.

   The timestamp is in the NAME so that truncation is filename arithmetic —
   deciding which entries the window has dropped never opens one. -}
export
eventLogEntryName : Int -> Int -> String
eventLogEntryName seq timeSeconds =
  "\{padLeft seqWidth '0' (intToString seq)}-\{padLeft timeWidth '0' (intToString timeSeconds)}"

{- | The sequence number and timestamp a stored entry's file name spells, or
   an error naming what the entry directory held instead.

   A name that does not parse is never skipped: a log directory holding
   something nobody wrote is a fact a reader must report, not route around.
   This log's directory listing IS its index — a cursor is answered from the
   names — so an entry routed around is a hole in a stream no subscriber can
   detect, where a skipped block or blob is caught downstream by the content
   address it is stored under. The name is also the WHOLE of the question: the
   caller in `pds/shell/eventlog.mdk` deliberately stats nothing, so a stray
   plain file and a stray directory reach the same answer here. -}
export
eventLogParseEntryName : String -> Result String (Int, Int)
eventLogParseEntryName name = match split "-" name
  [seqText, timeText] => match (toInt seqText, toInt timeText)
    (Some seq, Some timeSeconds) => Ok (seq, timeSeconds)
    _ => Err "eventlog: entry file name is not two numbers: \{name}"
  _ => Err "eventlog: entry file name is not a seq-time pair: \{name}"

{- | One entry as the contents of its file: four tab-separated fields and no
   trailing newline. Tab because no field can hold one — two decimal integers,
   an anchor and a hex string.

   An absent anchor is the EMPTY third field, which is unambiguous because the
   present one is a base32 CID and a CID is never empty. That keeps the field
   count fixed at four, so a file with any other number of fields is malformed
   whether or not it names an anchor. -}
export
eventLogEncodeEntry : EventLogEntry -> String
eventLogEncodeEntry entry =
  "\{intToString entry.seq}\t\{intToString entry.timeSeconds}\t\{anchorText entry.anchorCommitCid}\t\{entry.frameHex}"

anchorText : Option String -> String
anchorText None = ""
anchorText (Some cid) = cid

anchorOf : String -> Option String
anchorOf "" = None
anchorOf cid = Some cid

-- | An entry read back from its file, or an error naming what was there.
export
eventLogDecodeEntry : String -> Result String EventLogEntry
eventLogDecodeEntry text = match split "\t" text
  [seqText, timeText, anchor, frameHex] => match (
    toInt seqText,
    toInt timeText,
  )
    (Some seq, Some timeSeconds) => Ok EventLogEntry {
      seq = seq,
      timeSeconds = timeSeconds,
      anchorCommitCid = anchorOf anchor,
      frameHex = frameHex,
    }
    _ => Err "eventlog: entry header is not two numbers: \{text}"
  fields =>
    Err
      "eventlog: entry has \{intToString (length fields)} tab-separated fields, expected 4"

{- | Split parsed entry names into the ones the window has dropped and the
   ones it still admits, each in sequence order.

   One function over the whole listing rather than a predicate the caller
   applies twice, so that "which entries leave" and "which entries remain" are
   one answer and cannot disagree. -}
export
eventLogPartitionExpired : Int ->
  Int ->
  List (Int, Int, String) ->
  (List (Int, Int, String), List (Int, Int, String))
eventLogPartitionExpired retentionSeconds nowSeconds rows =
  let ordered = sortBy (l r => compare (rowSeq l) (rowSeq r)) rows
  (
    filter
      (row => eventLogExpired retentionSeconds nowSeconds (rowTime row))
      ordered,
    filter
      (row => not (eventLogExpired retentionSeconds nowSeconds (rowTime row)))
      ordered,
  )

rowSeq : (Int, Int, String) -> Int
rowSeq (seq, _, _) = seq

rowTime : (Int, Int, String) -> Int
rowTime (_, timeSeconds, _) = timeSeconds
