{- | Strict, pure atproto timestamp identifiers.

   A TID is eleven sort-base32 timestamp digits followed by two clock-id
   digits.  The constructor is private so every value has the canonical
   thirteen-character spelling and a representable non-negative timestamp. -}

import string.{fromChar, indexOf, sliceClamped, toChars}

tidAlphabet : String
tidAlphabet = "234567abcdefghijklmnopqrstuvwxyz"

tidTimestampMax : Int
tidTimestampMax = 9007199254740991

-- | An admitted canonical atproto TID.
export data Tid = Tid String Int Int

charValue : Char -> Option Int
charValue c = indexOf (fromChar c) tidAlphabet

decodeDigits : Array Char -> Int -> Int -> Int -> Result String Int
decodeDigits chars pos end acc =
  if pos >= end then
    Ok acc
  else match charValue chars[pos]
    None => Err "tid: character is outside the sortable alphabet"
    Some value => decodeDigits chars (pos + 1) end (acc * 32 + value)

encodeDigit : Int -> Char
encodeDigit value = (toChars tidAlphabet)[value]

encodeFixedGo : Int -> Int -> List Char -> String
encodeFixedGo value remaining acc =
  if remaining == 0 then
    stringFromChars (arrayFromList acc)
  else
    let digit = encodeDigit (value % 32)
    encodeFixedGo (value / 32) (remaining - 1) (digit :: acc)

encodeFixed : Int -> Int -> String
encodeFixed value width = encodeFixedGo value width []

-- | Encode a microsecond timestamp and ten-bit clock identifier.
export
tidEncode : Int -> Int -> Result String Tid
tidEncode micros clockId =
  if micros < 0 || micros > tidTimestampMax then
    Err "tid: timestamp is outside the representable 53-bit range"
  else if clockId < 0 || clockId > 1023 then
    Err "tid: clock id must be in 0..1023"
  else
    Ok (Tid (encodeFixed micros 11 ++ encodeFixed clockId 2) micros clockId)

-- | Strictly parse one undashed canonical TID.
export
tidParse : String -> Result String Tid
tidParse text =
  let chars = toChars text
  if arrayLength chars /= 13 then
    Err "tid: expected exactly 13 characters"
  else match charValue chars[0]
    None => Err "tid: character is outside the sortable alphabet"
    Some first =>
      if first >= 16 then
        Err "tid: high bit must be zero"
      else match decodeDigits chars 0 11 0
        Err message => Err message
        Ok micros =>
          if micros > tidTimestampMax then
            Err "tid: timestamp is outside the representable 53-bit range"
          else
            map (Tid text micros) (decodeDigits chars 11 13 0)

-- | Canonical thirteen-character spelling.
export
tidToString : Tid -> String
tidToString (Tid text _ _) = text

-- | Timestamp component in microseconds.
export
tidMicros : Tid -> Int
tidMicros (Tid _ micros _) = micros

-- | Ten-bit clock identifier.
export
tidClockId : Tid -> Int
tidClockId (Tid _ _ clockId) = clockId

-- | Lexical order, which is chronological for canonical TIDs.
export
tidCompare : Tid -> Tid -> Ordering
tidCompare left right = compare (tidToString left) (tidToString right)

{- | Produce the proposed TID when it is newer than `prior`; otherwise advance
   the prior timestamp by one microsecond using the proposed clock id. -}
export
tidNext : Tid -> Int -> Int -> Result String Tid
tidNext prior proposedMicros proposedClockId = match (tidEncode
  proposedMicros
  proposedClockId)
  Err message => Err message
  Ok proposed =>
    if tidCompare proposed prior == Gt then
      Ok proposed
    else if tidMicros prior == tidTimestampMax then
      Err "tid: monotonic successor exceeds the representable range"
    else
      tidEncode (tidMicros prior + 1) proposedClockId
