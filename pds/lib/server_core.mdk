{- | Pure configured PDS protocol composition.

   A Server joins an admitted account configuration and a validated XRPC
   registry to an injected handler. Raw bytes flow through strict HTTP framing,
   structural routing, an explicit immutable Store transition, and
   deterministic response serialization. No filesystem, socket, clock, async,
   or other effect is available in this module. -}

import http.{
  Header,
  headerName,
  headerValue,
  HttpParseFailure(..),
  parseRequestClassified,
  QueryParam(..),
  Request,
  requestBody,
  requestHeaders,
  requestMethod,
  requestTarget,
  Response,
  serializeResponse,
}
import hex as Hex
import lib.cors.{isPreflight, preflightResponse, withAllowOrigin}
import lib.websocket.{handshakeAccept}
import string.{contains, fromUtf8, splitAt, toInt, toLower, trim}
import lib.atsyntax.{validateDid, validateHandle}
import lib.jwt.{
  Claims(..),
  JwtError(..),
  ServiceAuthRequest(..),
  serviceTokenLifetimeSeconds,
  verifyToken,
}
import lib.nsid.{sameNsidIdentity}
import lib.proxy.{
  appviewRouteDid,
  appviewRouteFor,
  AppviewTable,
  defaultAppviewRoute,
  forwardableProxyVerb,
  isProtectedMethod,
  ProxyDisposition(..),
  ProxyHeader(..),
  proxyDisposition,
  proxyForeignAudienceMessage,
  proxyHeader,
  proxyMethodRefusalResponse,
  proxyNoServiceMessage,
  proxyRefusalResponse,
  proxyServiceDid,
  relayedRequestHeaders,
}
import lib.store.{
  Store,
  sessionFingerprint,
  storeAccessActive,
  storeRefreshActive,
  storeServerSecret,
}
import lib.xrpc.{
  AuthPolicy(..),
  Registry,
  RouteResult(..),
  XrpcCall(..),
  requestNsid,
  routeRequest,
  subscriptionRoute,
  xrpcErrorResponse,
  xrpcFailureResponse,
}

{- | Everything about a request that is not in the request bytes, because
   nothing in `pds/lib` declares an effect row and so nothing here can read it
   for itself: the shell reads both and passes them in
   (`pds/shell/server.mdk`).

   `nowSeconds` is the current instant, in seconds since the Unix epoch, which
   token verification and token minting both need.

   `nonce` is per-request entropy from `osEntropyBytes`, and it is what a token
   minted while serving this request is identified by (`jti`, `lib.jwt`).
   Without it two tokens minted for the same subject and audience in the same
   second would be byte-identical, so a refresh token rotated in the second it
   was issued would be indistinguishable from the one it replaced and the reuse
   detection in `lib.store`'s rotation would have nothing to detect. -}
public export data RequestContext = RequestContext {
  nowSeconds : Int,
  nonce : Array Int,
}

{- | What the seam resolved about the caller's credentials, handed to every
   handler.

   `Authenticated` carries the authenticated subject DID and the fingerprint
   (`lib.store`'s `sessionFingerprint`) of the token that was presented. A
   handler does not re-check either: whether the route may be reached at all
   was already decided in `handle`, against the registry's own classification,
   before dispatch. The fingerprint is there because the session routes act on
   the caller's OWN session — rotating it, closing it — and a fingerprint is
   how a session is named; the bearer token itself is deliberately not handed
   on, so no handler can echo, log, or re-present it. -}
public export data AuthOutcome =
  | Unauthenticated
  | Authenticated String (Array Int)

{- | An endpoint-agnostic pure handler with an explicit successor Store,
   receiving the request context and the auth outcome the seam already
   resolved and enforced. The context is threaded through rather than read
   here: a handler that mints a token needs the same instant the seam verified
   against, and the same request's nonce. -}
export type Handler = RequestContext -> AuthOutcome -> Store -> XrpcCall -> (Store, Response)

{- | The one account this configured server serves: the repository owner's DID,
   the owner's handle, and this PDS's own hostname. Its constructor is private
   so every value has passed atproto identifier admission
   (`lib.atsyntax`). -}
export data Account = Account String String String

{- | Admit one account configuration. The DID and the handle are graded by the
   shared `lib.atsyntax` validators (NOT by `lib.repo`'s own divergent
   `validateDid`, which wrongly accepts digits in a DID method); the PDS
   hostname is graded as a domain name by the same handle syntax. -}
export
makeAccount : String -> String -> String -> Result String Account
makeAccount did handle hostname = do
  () <- validateDid did
  () <- match validateHandle handle
    Err message => Err "server_core: account handle: \{message}"
    Ok () => Ok ()
  () <- match validateHandle hostname
    Err message => Err "server_core: PDS hostname: \{message}"
    Ok () => Ok ()
  Ok (Account did handle hostname)

-- | The repository owner's DID.
export
accountDid : Account -> String
accountDid (Account did _ _) = did

-- | The repository owner's handle.
export
accountHandle : Account -> String
accountHandle (Account _ handle _) = handle

-- | This PDS's own hostname.
export
accountHostname : Account -> String
accountHostname (Account _ _ hostname) = hostname

{- | The audience an ACCESS token for this account carries: this PDS's own
   hostname, the server the token may be presented to. -}
export
accessAudience : Account -> String
accessAudience account = accountHostname account

{- | The audience a REFRESH token for this account carries.

   It is the access audience with a `#refresh` fragment appended, so the two
   token classes are never interchangeable: `verifyToken` compares `aud` for
   equality, so an access token presented to a refresh route is refused
   `JwtWrongAudience` and a refresh token presented to any other gated route
   is refused the same way. RFC 7519 §4.1.3 leaves the form of an `aud` value
   to the application. -}
export
refreshAudience : Account -> String
refreshAudience account = "\{accountHostname account}#refresh"

-- | An account configuration and a validated registry paired with the
-- injected pure handler that serves them.
export data Server = Server Account Registry Handler

export
makeServer : Account -> Registry -> Handler -> Server
makeServer account registry handler = Server account registry handler

-- | The configured account this server serves.
export
serverAccount : Server -> Account
serverAccount (Server account _ _) = account

{- | What the request's credential resolved to.

   The four refusal classes are distinct because the answers they owe a client
   are: no token means log in, an expired one means refresh, and neither
   reveals anything the caller did not already send. -}
data Credential =
  | NoCredential
  | MalformedCredential
  | ExpiredCredential
  | InvalidCredential
  | GoodCredential String (Array Int)

-- What the `Authorization` header carried, before any verification.
data Presented = NoHeader | NotBearer | Bearer String

-- RFC 7235 §2.1: the auth scheme is case-insensitive; the credential after it
-- is not, so only the scheme is lowercased.
bearerOf : String -> Presented
bearerOf text =
  let (scheme, token) = splitAt 7 text
  if toLower scheme == "bearer " then Bearer token else NotBearer

-- Exactly one `Authorization` header is a credential. Two are a request whose
-- credential is ambiguous, which is not a credential.
presentedHeader : List Header -> Int -> Option (Array Int) -> Presented
presentedHeader [] 0 _ = NoHeader
presentedHeader [] 1 (Some value) = bearerOf (fromUtf8 value)
presentedHeader [] _ _ = NotBearer
presentedHeader (header :: rest) count value =
  if headerName header == "authorization" then
    presentedHeader rest (count + 1) (Some (headerValue header))
  else
    presentedHeader rest count value

refusedCredential : JwtError -> Credential
refusedCredential JwtExpired = ExpiredCredential
refusedCredential JwtMalformed = MalformedCredential
refusedCredential _ = InvalidCredential

-- Which audience a token presented to this route must carry, and therefore
-- which of the two token classes the route accepts.
audienceFor : Account -> AuthPolicy -> String
audienceFor account RefreshRoute = refreshAudience account
audienceFor account _ = accessAudience account

-- Whether the session the token belongs to is still open. A refresh route
-- asks after the refresh half, every other route after the access half.
sessionOpen : AuthPolicy -> Array Int -> Store -> Bool
sessionOpen RefreshRoute fingerprint store =
  storeRefreshActive fingerprint store
sessionOpen _ fingerprint store = storeAccessActive fingerprint store

{- | Verify a presented bearer token against this server's own session secret,
   configured account, and open sessions. The token's subject must be the
   account DID and its audience the one this route accepts: those are what a
   token minted for THIS account on THIS server for THIS token class carries,
   so a token minted for another account, or for another server sharing the
   secret, or of the other class, does not verify here.

   A verified signature is NOT on its own a credential: the token's session
   must still be open. That is what makes `deleteSession` a revocation rather
   than an announcement — the access token it revokes is still inside its own
   validity window and still carries a good MAC, and is refused anyway.
   Sessions live only in memory (`lib.store`), so a restart refuses every
   token minted before it.

   A `Store` with no session secret can resolve nothing, so every credential
   presented to it is refused. That is the state a server started without a
   session secret is in, and it fails closed. -}
verifiedCredential : Account ->
  AuthPolicy ->
  RequestContext ->
  Store ->
  String ->
  Credential
verifiedCredential account policy context store token =
  match storeServerSecret store
    None => InvalidCredential
    Some secret =>
      let verified =
        verifyToken
          secret
          (accountDid account)
          (audienceFor account policy)
          context.nowSeconds
          token
      match verified
        Err jwtError => refusedCredential jwtError
        Ok claims =>
          let fingerprint = sessionFingerprint token
          if sessionOpen policy fingerprint store then
            GoodCredential claims.sub fingerprint
          else
            InvalidCredential

resolveCredential : Account ->
  AuthPolicy ->
  RequestContext ->
  Store ->
  Request ->
  Credential
resolveCredential account policy context store request =
  match presentedHeader (requestHeaders request) 0 None
    NoHeader => NoCredential
    NotBearer => MalformedCredential
    Bearer token => verifiedCredential account policy context store token

outcomeOf : Credential -> AuthOutcome
outcomeOf (GoodCredential did fingerprint) = Authenticated did fingerprint
outcomeOf _ = Unauthenticated

{- | The refusal a gated route owes an unresolved credential. The error codes
   are atproto's own `ResponseTypeNames` spellings, the same source every other
   failure class in `lib.xrpc` draws its code from. -}
refusalFor : Credential -> Response
refusalFor NoCredential =
  xrpcErrorResponse
    401
    "Unauthorized"
    "AuthenticationRequired"
    "Authentication Required"
refusalFor ExpiredCredential =
  xrpcErrorResponse 401 "Unauthorized" "ExpiredToken" "Token has expired"
refusalFor _ =
  xrpcErrorResponse
    401
    "Unauthorized"
    "InvalidToken"
    "Token could not be verified"

{- | Route an already framed request, refusing an unauthenticated call to a
   gated route BEFORE the handler runs.

   The check lives here and can live nowhere else: `routeRequest` turns a
   `Request` into an `XrpcCall`, and no `XrpcCall` arm carries a header, so
   this is the last point at which the `Authorization` header still exists.

   A credential is resolved whenever one is presented, on a public route as
   much as a gated one, so a handler can know who is calling; but only a gated
   route is refused when that resolution fails. A public read therefore stays
   readable by a client holding a stale token and by one holding none at all,
   which is what a real PDS does — a repository nobody can read without a
   token is a broken server, not a secure one.

   Neither a route failure nor an auth refusal invokes the handler, and both
   return the identical input Store.

   A CORS preflight (`OPTIONS`) is answered here, ahead of `routeRequest`, so
   it never reaches `xrpc`'s `methodNotAllowed` — CORS is an HTTP-layer
   answer, prior to XRPC admission, and must reach non-XRPC paths too. Every
   other response gets the allow-origin header every response carries;
   `handleRouted`'s own exits are the ones this appends it to, since a
   preflight answer already carries its own complete header set. -}
export
handle : Server -> RequestContext -> Store -> Request -> (Store, Response)
handle server context store request =
  if isPreflight request then
    (store, preflightResponse request)
  else
    let (next, response) = handleRouted server context store request
    (next, withAllowOrigin response)

handleRouted : Server -> RequestContext -> Store -> Request -> (Store, Response)
handleRouted (Server account registry handler) context store request =
  match routeRequest registry request
    RouteFailure failed => (store, xrpcFailureResponse failed)
    RouteCall auth call =>
      let credential = resolveCredential account auth context store request
      match (auth, credential)
        (PublicRoute, resolved) =>
          handler context (outcomeOf resolved) store call
        (_, GoodCredential did fingerprint) =>
          handler context (Authenticated did fingerprint) store call
        (_, refused) => (store, refusalFor refused)

-- ── the subscription upgrade seam ───────────────────────────────────────────

{- | What a framed request means to the socket shell BEFORE it applies it: an
   ordinary request, a refused upgrade, or an upgrade to admit.

   It exists because a subscription leaves the request/response lifecycle
   permanently and nothing downstream of `handle` can express that — `handle`
   returns a complete `Response` and `handleBytes` a complete `Array Int`. So
   the shell asks this question first, and only a `NotAnUpgrade` answer
   reaches the ordinary path. Every DECISION in it is taken here rather than
   in the shell: routing, NSID admission, the handshake's own well-formedness,
   the auth policy the registry holds, and the cursor's syntax are all
   questions about a request's bytes, and none of them is a question about a
   socket. -}
public export data UpgradeDecision =
  | NotAnUpgrade
  | UpgradeRefused Response
  | UpgradeAdmitted UpgradeAdmission

{- | An admitted upgrade: the subscription route's NSID, the
   `Sec-WebSocket-Accept` value the 101 must echo, and the cursor the client
   asked to resume from.

   `cursor` is `None` for a client that named none, which is not the same
   request as `Some 0`: the first asks for the live tail and the second asks
   for everything the log still holds (`lib.event_log_record`'s
   `eventLogAfterCursor` fixes what a cursor VALUE means; this only records
   whether one was sent).

   The auth outcome is deliberately NOT carried. It is resolved and ENFORCED
   here, against the policy the route was registered under, exactly as
   `handle` enforces it for an ordinary route; carrying it onward would be a
   value with no reader, and a reader is what would make a second, divergent
   enforcement possible. -}
public export data UpgradeAdmission = UpgradeAdmission {
  nsid : String,
  accept : String,
  cursor : Option Int,
}

-- One header's single value, or why there is not exactly one. Two
-- `Sec-WebSocket-Key` headers are a handshake whose key is ambiguous, which
-- is not a key — the same rule `presentedHeader` applies to `Authorization`.
data HeaderPick = HeaderMissing | HeaderRepeated | HeaderPicked String

pickHeader : String -> List Header -> Int -> Option (Array Int) -> HeaderPick
pickHeader _ [] 0 _ = HeaderMissing
pickHeader _ [] 1 (Some value) = HeaderPicked (fromUtf8 value)
pickHeader _ [] _ _ = HeaderRepeated
pickHeader wanted (header :: rest) count value =
  if headerName header == wanted then
    pickHeader wanted rest (count + 1) (Some (headerValue header))
  else
    pickHeader wanted rest count value

-- A repeated field is joined by commas rather than refused (RFC 9110 §5.3),
-- and `Connection` legitimately carries a token list, so both fields are
-- tested by containment of their lowercased text rather than by equality.
headerMentions : String -> String -> List Header -> Bool
headerMentions wanted token headers = match pickHeader wanted headers 0 None
  HeaderPicked value => contains token (toLower value)
  _ => False

{- | Whether this request is the opening half of a WebSocket handshake (RFC
   6455 §4.1): `Upgrade: websocket` and a `Connection` field naming `upgrade`.

   Those two alone, because they are what makes the request an UPGRADE at all.
   Everything else the handshake requires — the version, the key — is graded
   below, where a violation can be answered; a request failing one of those
   asked for a WebSocket and is owed a refusal, not a 404 for the page it
   never wanted. -}
requestsUpgrade : Request -> Bool
requestsUpgrade request =
  let headers = requestHeaders request
  headerMentions "upgrade" "websocket" headers
    && headerMentions "connection" "upgrade" headers

-- RFC 6455 §4.1: the only version this server speaks.
webSocketVersion : String
webSocketVersion = "13"

badHandshakeResponse : String -> Response
badHandshakeResponse detail =
  xrpcErrorResponse 400 "Bad Request" "InvalidRequest" detail

{- | RFC 6455 §4.4: a client asking for a version this server does not speak,
   or naming none at all, is answered 426 and told which version it does
   speak. The version is stated in the error message rather than in a
   `Sec-WebSocket-Version` response field because the JSON error envelope is
   the one shape every other refusal on this server takes, and a client that
   cannot read it cannot read a field either. -}
wrongVersionResponse : Response
wrongVersionResponse =
  xrpcErrorResponse
    426
    "Upgrade Required"
    "UnsupportedWebSocketVersion"
    "This server speaks WebSocket version \{webSocketVersion}"

cursorOf : List QueryParam ->
  Int ->
  Option String ->
  Result Response (Option Int)
cursorOf [] 0 _ = Ok None
cursorOf [] 1 (Some text) = match toInt (trim text)
  Some seq => Ok (Some seq)
  None =>
    Err
      (badHandshakeResponse "Query parameter 'cursor' is not a sequence number")
cursorOf [] _ _ =
  Err (badHandshakeResponse "Query parameter 'cursor' must not be repeated")
cursorOf ((QueryParam key value) :: rest) count found =
  if key == "cursor" then
    cursorOf rest (count + 1) (Some value)
  else
    cursorOf rest count found

-- The handshake's own well-formedness, once the route is known to be a
-- registered subscription: the version, then the key.
admitHandshake : Request -> String -> List QueryParam -> UpgradeDecision
admitHandshake request nsid params =
  match pickHeader "sec-websocket-version" (requestHeaders request) 0 None
    HeaderPicked version =>
      if trim version /= webSocketVersion then
        UpgradeRefused wrongVersionResponse
      else
        admitKey request nsid params
    HeaderMissing => UpgradeRefused wrongVersionResponse
    HeaderRepeated =>
      UpgradeRefused
        (badHandshakeResponse "Sec-WebSocket-Version must not be repeated")

admitKey : Request -> String -> List QueryParam -> UpgradeDecision
admitKey request nsid params =
  match pickHeader "sec-websocket-key" (requestHeaders request) 0 None
    HeaderMissing =>
      UpgradeRefused (badHandshakeResponse "Sec-WebSocket-Key is required")
    HeaderRepeated =>
      UpgradeRefused
        (badHandshakeResponse "Sec-WebSocket-Key must not be repeated")
    HeaderPicked key => match handshakeAccept (trim key)
      Err detail => UpgradeRefused (badHandshakeResponse detail)
      Ok accept => match cursorOf params 0 None
        Err refusal => UpgradeRefused refusal
        Ok cursor => UpgradeAdmitted UpgradeAdmission {
          nsid = nsid,
          accept = accept,
          cursor = cursor,
        }

{- | Whether this request is an upgrade to a registered subscription route,
   and if so whether it may be admitted.

   The order is deliberate and is the cheap-first order: a request that is not
   an upgrade at all costs two header scans, and only a request that both asks
   for a WebSocket and names a registered subscription reaches the handshake
   grading or the credential resolution. A non-upgrade GET to a subscription
   route answers `NotAnUpgrade` and is then owed the 426 `routeEndpoint`
   gives it — the one place that answer lives. -}
export
classifyUpgrade : Server ->
  RequestContext ->
  Store ->
  Request ->
  UpgradeDecision
classifyUpgrade (Server account registry _) context store request =
  if not (requestsUpgrade request) then
    NotAnUpgrade
  else match subscriptionRoute registry request
    None => NotAnUpgrade
    Some (nsid, params, auth) => match (
      auth,
      resolveCredential account auth context store request,
    )
      (PublicRoute, _) => admitHandshake request nsid params
      (_, GoodCredential _ _) => admitHandshake request nsid params
      (_, refused) => UpgradeRefused (refusalFor refused)

-- ── the appview-proxy seam ──────────────────────────────────────────────────

{- | What a framed request's `atproto-proxy` header means to the socket shell
   BEFORE it applies the request: nothing, a refusal, or one outbound call to
   make.

   It exists for the reason `UpgradeDecision` does: `handle` returns a complete
   `Response` and cannot express "this answer comes from somewhere else", and
   nothing in `pds/lib` may open a socket. So the shell asks this question
   first, and only a `NotProxied` answer reaches the ordinary path.

   Every DECISION is taken here: whether the method is one this server forwards
   at all, whether the CALLER holds a credential of this account's own, which
   audience the call goes to — the one a header named, graded against the SET
   this server was configured to mint for, or that set's default when no header
   named any — and, when all of them hold, the exact claim set a token must
   carry along with the verb, body and fields that travel with it. The shell
   signs that claim set and sends the call; it chooses none of it. That is what
   makes "nothing was signed" a property of this type rather than of the shell's
   care: a refusal carries no `ServiceAuthRequest`, so there is nothing for the
   shell to sign along that path. -}
public export data ProxyDecision =
  | NotProxied
  | ProxyRefused Response
  | ProxyAdmitted ProxyAdmission

{- | An admitted proxied call: the verb and body being forwarded, the
   origin-form target to forward them at, the inbound fields that travel with
   them, the audience this server ADMITTED, and the service-auth claim set the
   shell must sign with the account's own repo key.

   The target is the client's own, relayed verbatim, because the appview serves
   the same `/xrpc/<nsid>` path with the same query parameters; it is graded as
   an origin-form ASCII target by `lib.httpclient`'s serializer before it
   reaches a socket. The nsid is carried alongside it even though it is also
   the claim set's `lxm` so that the rate-limit class and any diagnostic can
   name the method without reading a value destined to be signed.

   `audience` is the bare DID this server ADMITTED, taken from its own
   configuration and never from the header — the header's own text is in
   `serviceAuth.aud`, where a `#serviceId` fragment is still wanted and is
   stripped at mint. The two are separate fields because they answer different
   questions: what a token was signed for, and which upstream this server
   decided to talk to. Only the second may ever choose a socket.

   `headers` are the relayed inbound fields `lib.proxy`'s
   `relayedRequestHeaders` selected, in that module's order, already graded.
   `body` is the framed request body, empty for a query; the inbound ceiling
   that bounded it (`http`'s own body ceiling) is the only one it needs, since
   nothing on the way out re-buffers it. -}
public export data ProxyAdmission = ProxyAdmission {
  nsid : String,
  verb : String,
  target : String,
  headers : List (String, String),
  body : Array Int,
  audience : String,
  serviceAuth : ServiceAuthRequest,
}

{- | The claim set a token for this call must carry.

   `iss` is the ACCOUNT's DID and not this PDS's hostname: the key that signs
   is the account's own repo key, so the account is the issuer a peer resolves
   (`pds/test/vectors/pds_service_auth_shape_corpus.txt`). `aud` is the
   header's value including any `#serviceId` fragment — `lib.jwt` strips it
   when it mints, and the value that reaches here has already been compared
   against the configured appview in its stripped form. `lxm` is the CANONICAL
   spelling of the method (`lib.nsid`'s `canonicalNsid`, chosen by
   `proxyDisposition`) and not the client's: the two can differ in the case of
   the nsid's authority, and a signed claim must name the value the
   authorization decision was taken against. `jti` is this request's own nonce,
   which is 16 bytes of `osEntropyBytes` and therefore 32 hex characters, the
   width the corpus records. `exp` is `None`, which is `lib.jwt`'s default
   lifetime: a forward is a call this server decided to make, so there is no
   client asking for a window and nothing to widen it for. -}
serviceAuthFor : Account ->
  RequestContext ->
  String ->
  String ->
  ServiceAuthRequest
serviceAuthFor account context nsid audience = ServiceAuthRequest {
  iss = accountDid account,
  aud = audience,
  lxm = Some nsid,
  jti = Hex.encode context.nonce,
  iat = context.nowSeconds,
  exp = None,
}

{- | The admission itself, once the audience half has passed.

   `audience` is the configured bare DID this server will talk to, and
   `signedAudience` is what goes into the claim: the same value for a call that
   named no audience, and the header's own text, fragment included, for one
   that named a service of it.

   The verb is graded HERE and not at the disposition, because it is a property
   of the request rather than of the method: the same nsid is forwardable
   whether the client sent a GET, a POST, or something that is neither. -}
admitForward : Account ->
  RequestContext ->
  Request ->
  String ->
  String ->
  String ->
  ProxyDecision
admitForward account context request nsid audience signedAudience =
  if not (forwardableProxyVerb (requestMethod request)) then
    ProxyRefused proxyMethodRefusalResponse
  else
    let body = requestBody request
    ProxyAdmitted ProxyAdmission {
      nsid = nsid,
      verb = requestMethod request,
      target = requestTarget request,
      headers =
        relayedRequestHeaders (arrayLength body > 0) (requestHeaders request),
      body = body,
      audience = audience,
      serviceAuth = serviceAuthFor account context nsid signedAudience,
    }

-- The audience half for a request that NAMED one: the header must name a DID,
-- this server must have been configured to proxy at all, and the DID must be
-- one of the audiences it was configured with. A failure of any of the three
-- refuses before the verb is looked at, so a header naming someone else's
-- service is refused for naming it and not for what it asked for.
--
-- The admitted value is the ROW's own DID and not the client's bytes, even
-- though the two compared equal: what travels onward is a value this server's
-- own configuration produced, so the port chosen downstream from it
-- (`pds/shell/egress.mdk`) is chosen from the table and never from the header.
admitProxyAudience : Account ->
  RequestContext ->
  Option AppviewTable ->
  Request ->
  String ->
  String ->
  ProxyDecision
admitProxyAudience account context table request nsid raw =
  match proxyServiceDid raw
    None =>
      ProxyRefused
        (proxyRefusalResponse "atproto-proxy does not name a service DID")
    Some service => match table
      None => ProxyRefused (proxyRefusalResponse (proxyNoServiceMessage nsid))
      Some configured => match appviewRouteFor configured service
        None => ProxyRefused (proxyRefusalResponse proxyForeignAudienceMessage)
        Some route =>
          admitForward account context request nsid (appviewRouteDid route) raw

{- | The refusal this caller is owed for its credential, or `None` when it
   holds one.

   A forward is made on behalf of the logged-in account — the shell signs it
   with the ACCOUNT's repo key — so a caller holding no access token is asking
   this server to lend its identity to an anonymous request, and is owed the
   401 every other gated route owes one. `AuthenticatedRoute` is the policy and
   no nsid-keyed lookup is involved: a forwardable method is by construction one
   this server's `Registry` does not hold, and there is exactly one account this
   server ever serves. -}
proxyCredentialRefusal : Account ->
  RequestContext ->
  Store ->
  Request ->
  Option Response
proxyCredentialRefusal account context store request =
  match resolveCredential account AuthenticatedRoute context store request
    GoodCredential _ _ => None
    refused => Some (refusalFor refused)

{- | A forwardable method, and the audience the header named — or the
   configured default, for the `None` clause, where the client named none.

   The named-none clause is what `parseProxyInfo`'s fall-through to
   `defaultService` does in the official implementation: an app that sends no
   header still gets its reads answered, by the FIRST service this operator
   configured (`lib.proxy`'s `defaultAppviewRoute`).

   A server with NO appview configured answers `NotProxied` to that clause
   BEFORE the credential is looked at, and the ordering is the point rather
   than an accident: there is no forward such a deployment could make, so the
   ordinary router owes this request the same 404 it owed before this arm
   existed — and demanding a credential first would answer 401 to a path that
   does not exist. A call that NAMED an audience is a different question: it
   asked this server for something, and is owed an answer to what it asked. -}
admitForwardable : Account ->
  RequestContext ->
  Option AppviewTable ->
  Store ->
  Request ->
  String ->
  Option String ->
  ProxyDecision
admitForwardable _ _ None _ _ _ None = NotProxied
admitForwardable account context (Some configured) store request nsid None =
  match proxyCredentialRefusal account context store request
    Some response => ProxyRefused response
    None =>
      let fallback = appviewRouteDid (defaultAppviewRoute configured)
      admitForward account context request nsid fallback fallback
admitForwardable account context table store request nsid (Some raw) =
  match proxyCredentialRefusal account context store request
    Some response => ProxyRefused response
    None => admitProxyAudience account context table request nsid raw

{- | Whether this request is forwarded, refused, or none of this seam's
   business.

   The METHOD is decided first, and from the registry and the namespace alone
   (`lib.proxy`'s `proxyDisposition`), so the same nsid gets the same
   disposition whether or not a header named an audience for it. Only a
   `ProxyForwardable` method goes on to ask who is calling and where the answer
   is to come from.

   A request naming no XRPC method at all — a well-known path, or a path
   outside `/xrpc/` — is `NotProxied`: there is no method to forward, and the
   local path already owns the answer it is owed. A repeated header is refused
   before even that, because a request whose audience the client left ambiguous
   is not one this server can act on, whatever it asked for.

   A method outside the two forwardable namespaces is REFUSED when a header
   asked for it and left alone when none did. That asymmetry is the difference
   between an instruction and a silence: a client that asked this server to
   forward `com.atproto.admin.deleteAccount` is owed the refusal the official
   implementation gives it, while a client that merely called a method this
   server does not have is owed the router's 404, as it always was.

   Likewise a server with no configured appview is `NotProxied` on the
   header-absent arm and refuses the header-bearing one, which is what keeps
   such a deployment answering exactly as it did before. -}
export
classifyProxy : Server ->
  RequestContext ->
  Option AppviewTable ->
  Store ->
  Request ->
  ProxyDecision
classifyProxy (Server account registry _) context policy store request =
  match proxyHeader (requestHeaders request)
    ProxyHeaderRepeated =>
      ProxyRefused (proxyRefusalResponse "atproto-proxy must not be repeated")
    header => match requestNsid request
      None => NotProxied
      Some nsid => match (proxyDisposition registry nsid, header)
        (ProxyLocallyServed, _) => NotProxied
        (ProxyNotForwardable, ProxyHeaderValue _) =>
          ProxyRefused (proxyRefusalResponse (proxyNoServiceMessage nsid))
        (ProxyNotForwardable, _) => NotProxied
        (ProxyForwardable canonical, ProxyHeaderValue raw) =>
          admitForwardable
            account
            context
            policy
            store
            request
            canonical
            (Some raw)
        (ProxyForwardable canonical, _) =>
          admitForwardable account context policy store request canonical None

-- ── the service-auth mint seam ──────────────────────────────────────────────

{- | The one route whose answer is a SIGNATURE rather than a value this module
   can compute. Registered by `lib.handlers` under this same constant, so the
   nsid the seam recognizes and the nsid the registry holds cannot drift. -}
export
getServiceAuthNsid : String
getServiceAuthNsid = "com.atproto.server.getServiceAuth"

{- | What a framed request for `com.atproto.server.getServiceAuth` means to the
   socket shell: nothing, a refusal, or one claim set to sign and hand back.

   It exists for the reason `ProxyDecision` does, pointed the other way. There
   the signature travels outward on a call this server makes; here the client
   asked for the credential itself and keeps it. Either way the account's repo
   key lives only in the shell (`pds/shell/egress.mdk`), so a `Handler` —
   which returns a complete `Response` and is handed no key — cannot answer
   this route at all, and the decision has to be taken before dispatch.

   Every DECISION is taken here: whether the caller holds a credential of this
   account's own, whether the `aud` it asked for is one this server was
   configured to mint for, whether the `lxm` it named is one no credential may
   carry, and how far out the credential may expire. The shell signs the claim
   set and chooses none of it — and a refusal carries no `ServiceAuthRequest`,
   so along that path there is nothing for it to sign. -}
public export data ServiceAuthDecision =
  | NotServiceAuth
  | ServiceAuthRefused Response
  | ServiceAuthMinted ServiceAuthRequest

{- | The refusal a caller that asked for a credential this server will not mint
   is owed. 400 `InvalidRequest` is what the official implementation answers
   for a malformed or unpermitted request, so a client sees the code it already
   handles. -}
serviceAuthRefusal : String -> Response
serviceAuthRefusal message =
  xrpcErrorResponse 400 "Bad Request" "InvalidRequest" message

-- `BadExpiration` is atproto's own error name for every refusal on the `exp`
-- axis, and it is distinct from `InvalidRequest` so a client can tell "the
-- window you asked for is not available" from "the request is wrong".
badExpirationRefusal : String -> Response
badExpirationRefusal message =
  xrpcErrorResponse 400 "Bad Request" "BadExpiration" message

{- | What a deployment holding no signing key answers this route.

   A server started with no configured audience (`--appview-did` absent) holds
   no `Egress` and therefore no account key in the shell, so it cannot mint
   anything. 501 and not 400: the request is not wrong, and not 500 either,
   because nothing failed — this deployment does not offer the route, which is
   a thing an operator chose and a client can act on.

   The same answer covers a caller that reaches `handle` for this nsid: the
   pure core holds no key on any deployment, so the statement is true there
   too. -}
export
serviceAuthUnavailableResponse : Response
serviceAuthUnavailableResponse =
  xrpcErrorResponse
    501
    "Not Implemented"
    "NotImplemented"
    "This server has no signing key configured for \{getServiceAuthNsid}"

-- | A client's `aud` that does not name a DID at all.
serviceAuthAudienceNotADidMessage : String
serviceAuthAudienceNotADidMessage = "aud does not name a service DID"

{- | The confused-deputy refusal on this route, the same one the proxy seam
   gives an `atproto-proxy` header naming somewhere else: the audience axis is
   an operator-configured set and stays default-deny whether the client asked
   for a forward or for the credential itself. -}
serviceAuthForeignAudienceMessage : String
serviceAuthForeignAudienceMessage =
  "aud names a service this server does not mint credentials for"

{- | The furthest out a client may ask a credential to expire, and — for one
   naming no method — the furthest out it may ask for the same credential to
   be spendable on anything the audience exposes.

   Both are the official implementation's own figures
   (`api/com/atproto/server/getServiceAuth.js`). They are two constants and not
   one because they bound two different things: the first is how stale a
   credential this server signed may be when it is spent, and the second is how
   long an UNRESTRICTED one may be, which is the narrower question. That they
   are sixty and thirty-six hundred rather than some other pair is the peer's
   calibration, not ours. -}
serviceAuthMaxExpirySeconds : Int
serviceAuthMaxExpirySeconds = 3600

serviceAuthMaxMethodlessExpirySeconds : Int
serviceAuthMaxMethodlessExpirySeconds = 60

-- Exactly one value for `name`, `None` when the client sent none, and the
-- refusal a repeat is owed: picking among two values a client sent is choosing
-- on its behalf, and here the choice is what a signature vouches for. Same
-- rule `cursorOf` above applies, and the same one `lib.handlers` applies to
-- every other query parameter on this server.
soleParam : String ->
  List QueryParam ->
  Int ->
  Option String ->
  Result Response (Option String)
soleParam _ [] 0 _ = Ok None
soleParam _ [] 1 found = Ok found
soleParam name [] _ _ =
  Err (serviceAuthRefusal "Query parameter '\{name}' must not be repeated")
soleParam name ((QueryParam key value) :: rest) count found =
  if key == name then
    soleParam name rest (count + 1) (Some value)
  else
    soleParam name rest count found

requiredParam : String -> List QueryParam -> Result Response String
requiredParam name params = match soleParam name params 0 None
  Err response => Err response
  Ok None => Err (serviceAuthRefusal "Query parameter '\{name}' is required")
  Ok (Some value) => Ok value

{- | The audience half, and it is graded FIRST.

   `aud` is the value an attacker wants to choose: a credential bearing this
   account's identity, minted for a service of their naming, is the confused
   deputy handed to the client directly. So it is graded against the SET this
   operator configured — `lib.proxy`'s own table, asked with `appviewRouteFor`,
   the same lookup and the same stripped-fragment form the proxy seam uses —
   and a server carrying no table at all mints for nobody.

   The `None`-table arm answers the 501 rather than the foreign-audience 400:
   such a deployment refuses every `aud` for one reason, and telling a client
   that the DID it named is not configured would invite it to try others. -}
admitServiceAudience : Option AppviewTable -> String -> Result Response Unit
admitServiceAudience table raw = match proxyServiceDid raw
  None => Err (serviceAuthRefusal serviceAuthAudienceNotADidMessage)
  Some bare => match table
    None => Err serviceAuthUnavailableResponse
    Some configured => match appviewRouteFor configured bare
      None => Err (serviceAuthRefusal serviceAuthForeignAudienceMessage)
      Some _ => Ok ()

{- | The method half: a credential may not name one of the account-management
   methods (`lib.proxy`'s `protectedMethods`), whether or not this server
   serves it locally.

   The message is the official implementation's own wording, and it names the
   value the client itself sent and nothing else. -}
admitServiceMethod : Option String -> Result Response Unit
admitServiceMethod None = Ok ()
admitServiceMethod (Some lxm) =
  if isProtectedMethod lxm then
    Err
      (serviceAuthRefusal
        "cannot request a service auth token for the following method: \{lxm}")
  else
    Ok ()

{- | The expiry half, resolved to an instant.

   A request naming no `exp` gets this module's default window, computed here
   rather than left absent so that the decision the shell signs states the
   whole claim set and a test can read it off.

   The three refusals are the official implementation's, in its order: an
   instant already past, one more than an hour out, and — for a credential
   naming no method, which authorizes everything the audience exposes — one
   more than a minute out. -}
admitServiceExpiry : RequestContext ->
  Option String ->
  List QueryParam ->
  Result Response Int
admitServiceExpiry context lxm params = match soleParam "exp" params 0 None
  Err response => Err response
  Ok None => Ok (context.nowSeconds + serviceTokenLifetimeSeconds)
  Ok (Some text) => match toInt (trim text)
    None =>
      Err
        (serviceAuthRefusal
          "Query parameter 'exp' is not a Unix timestamp in seconds")
    Some at => gradeServiceExpiry context lxm at

gradeServiceExpiry : RequestContext ->
  Option String ->
  Int ->
  Result Response Int
gradeServiceExpiry context lxm at =
  let ahead = at - context.nowSeconds
  if ahead < 0 then
    Err (badExpirationRefusal "expiration is in past")
  else if ahead > serviceAuthMaxExpirySeconds then
    Err
      (badExpirationRefusal
        "cannot request a token with an expiration more than an hour in the future")
  else match lxm
    Some _ => Ok at
    None =>
      if ahead > serviceAuthMaxMethodlessExpirySeconds then
        Err
          (badExpirationRefusal
            "cannot request a method-less token with an expiration more than a minute in the future")
      else
        Ok at

{- | The claim set this request earns, or the refusal it is owed.

   `iss` is the ACCOUNT's DID, because the key that signs is the account's own
   repo key. `aud` is the client's own text, fragment included — `lib.jwt`
   strips it at mint, and the stripped form is what `admitServiceAudience`
   compared — so a client that asked for a service OF a configured audience
   gets a credential naming that audience. `jti` is this request's own nonce,
   and `exp` is the resolved instant rather than the client's string. -}
serviceAuthClaims : Account ->
  RequestContext ->
  Option AppviewTable ->
  List QueryParam ->
  Result Response ServiceAuthRequest
serviceAuthClaims account context table params = do
  audience <- requiredParam "aud" params
  () <- admitServiceAudience table audience
  method <- soleParam "lxm" params 0 None
  () <- admitServiceMethod method
  expiry <- admitServiceExpiry context method params
  Ok ServiceAuthRequest {
    iss = accountDid account,
    aud = audience,
    lxm = method,
    jti = Hex.encode context.nonce,
    iat = context.nowSeconds,
    exp = Some expiry,
  }

{- | Whether this request asks for a service credential, and if so whether one
   may be minted for it.

   The registry is consulted rather than trusted: `routeRequest` is what
   decides that this is a GET to a registered query carrying no body framing,
   so a POST to this nsid is `NotServiceAuth` here and is answered the 405 the
   router already owes it. The nsid a decision is taken against is the
   REGISTRY's spelling and not the client's, which is the same rule the proxy
   seam's `lxm` follows.

   The credential is resolved before any parameter is looked at, because this
   route is `AuthenticatedRoute` and the account's identity is exactly what an
   anonymous caller is asking to be handed. -}
export
classifyServiceAuth : Server ->
  RequestContext ->
  Option AppviewTable ->
  Store ->
  Request ->
  ServiceAuthDecision
classifyServiceAuth (Server account registry _) context table store request =
  match requestNsid request
    None => NotServiceAuth
    Some named =>
      if not (sameNsidIdentity named getServiceAuthNsid) then
        NotServiceAuth
      else match routeRequest registry request
        RouteCall _ (QueryCall nsid params) =>
          if nsid /= getServiceAuthNsid then
            NotServiceAuth
          else match (resolveCredential
            account
            AuthenticatedRoute
            context
            store
            request)
            GoodCredential _ _ =>
              match serviceAuthClaims account context table params
                Err response => ServiceAuthRefused response
                Ok claims => ServiceAuthMinted claims
            refused => ServiceAuthRefused (refusalFor refused)
        _ => NotServiceAuth

malformedHttpResponse : Response
malformedHttpResponse =
  xrpcErrorResponse 400 "Bad Request" "InvalidRequest" "Malformed HTTP request"

resourceExcessResponse : Response
resourceExcessResponse =
  xrpcErrorResponse
    413
    "Payload Too Large"
    "PayloadTooLarge"
    "HTTP request exceeds resource limits"

-- | Handle one complete buffered request. Both HTTP failure classes preserve
-- the exact input Store; successful calls expose the handler's successor.
export
handleBytes : Server ->
  RequestContext ->
  Store ->
  Array Int ->
  (Store, Array Int)
handleBytes server context store bytes = match parseRequestClassified bytes
  Err (HttpMalformed _) => (store, serializeResponse malformedHttpResponse)
  Err (HttpResourceExcess _) =>
    (store, serializeResponse resourceExcessResponse)
  Ok request =>
    let (next, response) = handle server context store request
    (next, serializeResponse response)
