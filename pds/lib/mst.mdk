{- | Pure persistent atproto Merkle Search Trees.

   Keys are arbitrary non-empty byte arrays. A mutation splices the
   authoritative sorted entry list in place and rebuilds the node structure
   from it, so only the touched key is ever hashed and the protocol's
   history-independent root and node bytes are preserved. The rebuild reuses
   every old node the touched key cannot reach, so a write re-encodes the
   root-to-key path rather than the whole tree.
   Node constructors remain private so depth, ordering, prefix compression,
   and link invariants cannot be bypassed.

   `mstValidateNodeBytes` and `mstValidateBlocks` provide strict validation of
   canonical node bytes and a complete reachable node-block graph. `mstFromBlocks`
   rebuilds an editable tree from such a graph: it proves every invariant with
   that validator before reading an entry, and rejects any rebuild whose root CID
   differs from the supplied one. -}

-- The byte-range validator is intentionally local at each untrusted boundary.
-- lint-disable-file rule-duplicate-body

import array.{drop, take}
import hex.{encode}
import list.{reverse, sortBy}
import map.{Map(..), get, has, set, size}
import set.{Set}
import set as Set
import lib.cid.{Cid, cidEqual, cidForDagCbor, cidToBytes}
import lib.dagcbor.{DagCbor(..), dagCborDecode, dagCborEncode}
import lib.resource_limits.{
  checkMstBlocks,
  checkMstNodeBytes,
  checkMstNodeEntries,
  checkMstTraversalDepth,
  maxMstTraversalDepth,
}
import sha256.{sha256}

-- ── types ───────────────────────────────────────────────────────────────────

data MstEntry = MstEntry (Array Int) Cid Int

-- | An immutable MST with cached canonical root and built node structure.
export data Mst = Mst (List MstEntry) Cid (Array Int) MstNode

{- | One built node: its CID, its canonical bytes, and its children in the
   protocol's interleaved order — the optional left subtree, then each leaf
   followed by its optional right subtree. That flat interleaving is what the
   covering-proof descent indexes into, so it is the node's authoritative shape
   here and the `l`/`e` encoding is derived from it. -}
data MstNode = MstNode Cid (Array Int) (List NodeEntry)

data NodeEntry = NodeLeaf (Array Int) Cid | NodeSubtree MstNode

data LayerSplit = LayerSplit (List MstEntry) (Option (MstEntry, List MstEntry))

data BuiltEntries = BuiltEntries (List DagCbor) (List NodeEntry)

{- | One already-built node re-read as the child slots it offers. A slot is
   bounded by the leaf keys either side of it, so `OldLeaf` pairs a leaf key
   with the subtree immediately right of it and `OldShape` adds the subtree
   left of every leaf. Bounds, not positions, are what a rebuild matches on:
   a single-key mutation leaves every other leaf key at this node alone, so a
   slot whose two bounds survive holds exactly the entries it held before. -}
data OldLeaf = OldLeaf (Array Int) (Option MstNode)

data OldShape = OldShape (Option MstNode) (List OldLeaf)

{- | What a rebuild knows about the tree it is replacing: the one key the
   mutation touched, and the old node standing in the position now being
   built. Every child slot the touched key falls outside is reused verbatim,
   CID and canonical bytes included, so only the root-to-key path is encoded
   and hashed again. -}
data Reuse = FreshBuild | ReuseFrom (Array Int) OldShape

data DecodedEntry = DecodedEntry (Array Int) Cid (Option Cid)

data DecodedNode = DecodedNode (Option Cid) (List DecodedEntry)

-- ── key bytes and key depth ─────────────────────────────────────────────────

validBytes : Array Int -> Int -> Bool
validBytes bytes i =
  if i >= arrayLength bytes then
    True
  else
    bytes[i] >= 0 && bytes[i] <= 255 && validBytes bytes (i + 1)

bytesCompare : Array Int -> Array Int -> Ordering
bytesCompare left right = bytesCompareAt left right 0

bytesCompareAt : Array Int -> Array Int -> Int -> Ordering
bytesCompareAt left right i =
  if i >= arrayLength left then
    if i >= arrayLength right then Eq else Lt
  else if i >= arrayLength right then
    Gt
  else match compare left[i] right[i]
    Eq => bytesCompareAt left right (i + 1)
    order => order

commonPrefix : Array Int -> Array Int -> Int
commonPrefix left right = commonPrefixAt left right 0

commonPrefixAt : Array Int -> Array Int -> Int -> Int
commonPrefixAt left right i =
  if i >= arrayLength left || i >= arrayLength right || left[i] /= right[i] then
    i
  else
    commonPrefixAt left right (i + 1)

leadingZeroByte : Int -> Int
leadingZeroByte byte =
  if bitAnd byte 0x80 /= 0 then
    0
  else if bitAnd byte 0x40 /= 0 then
    1
  else if bitAnd byte 0x20 /= 0 then
    2
  else if bitAnd byte 0x10 /= 0 then
    3
  else if bitAnd byte 0x08 /= 0 then
    4
  else if bitAnd byte 0x04 /= 0 then
    5
  else if bitAnd byte 0x02 /= 0 then
    6
  else if bitAnd byte 0x01 /= 0 then
    7
  else
    8

leadingZeroBits : Array Int -> Int -> Int
leadingZeroBits digest i =
  if i >= arrayLength digest then
    arrayLength digest * 8
  else
    let zeros = leadingZeroByte digest[i]
    if zeros == 8 then 8 + leadingZeroBits digest (i + 1) else zeros

-- | Compute the mandatory SHA-256 MST depth for one non-empty byte key.
export
mstKeyDepth : Array Int -> Result String Int
mstKeyDepth key =
  if arrayLength key == 0 then
    Err "mst: empty key is not allowed"
  else if not (validBytes key 0) then
    Err "mst: key element outside byte range 0..255"
  else
    Ok (leadingZeroBits (sha256 key) 0 / 2)

-- ── building a tree ─────────────────────────────────────────────────────────

entryCompare : MstEntry -> MstEntry -> Ordering
entryCompare (MstEntry left _ _) (MstEntry right _ _) = bytesCompare left right

prepareEntries : List (Array Int, Cid) -> Result String (List MstEntry)
prepareEntries entries = match prepareEntriesGo entries []
  Err message => Err message
  Ok prepared =>
    let sorted = sortBy entryCompare prepared
    match duplicateKey sorted None
      Some _ => Err "mst: duplicate key is not allowed"
      None => Ok sorted

prepareEntriesGo : List (Array Int, Cid) ->
  List MstEntry ->
  Result String (List MstEntry)
prepareEntriesGo [] acc = Ok (reverse acc)
prepareEntriesGo ((key, value) :: rest) acc = match mstKeyDepth key
  Err message => Err message
  Ok depth =>
    prepareEntriesGo rest (MstEntry (arrayCopy key) value depth :: acc)

duplicateKey : List MstEntry -> Option (Array Int) -> Option (Array Int)
duplicateKey [] _ = None
duplicateKey ((MstEntry key _ _) :: rest) None = duplicateKey rest (Some key)
duplicateKey ((MstEntry key _ _) :: rest) (Some previous) =
  if bytesCompare previous key == Eq then
    Some key
  else
    duplicateKey rest (Some key)

maximumDepth : List MstEntry -> Int -> Int
maximumDepth [] current = current
maximumDepth ((MstEntry _ _ depth) :: rest) current =
  maximumDepth rest (max depth current)

splitLayer : List MstEntry -> Int -> LayerSplit
splitLayer [] _ = LayerSplit [] None
splitLayer ((entry@(MstEntry _ _ depth)) :: rest) layer =
  if depth == layer then
    LayerSplit [] (Some (entry, rest))
  else match splitLayer rest layer
    LayerSplit prefix found => LayerSplit (entry :: prefix) found

mustEncodeNode : DagCbor -> Array Int
mustEncodeNode value =
  resultOrPanic "mst: internal node encoding failed" (dagCborEncode value)

oldLeaves : List NodeEntry -> List OldLeaf
oldLeaves [] = []
oldLeaves ((NodeLeaf key _) :: (NodeSubtree node) :: rest) =
  OldLeaf key (Some node) :: oldLeaves rest
oldLeaves ((NodeLeaf key _) :: rest) = OldLeaf key None :: oldLeaves rest
oldLeaves ((NodeSubtree _) :: rest) = oldLeaves rest

nodeShape : MstNode -> OldShape
nodeShape (MstNode _ _ ((NodeSubtree left) :: rest)) =
  OldShape (Some left) (oldLeaves rest)
nodeShape (MstNode _ _ entries) = OldShape None (oldLeaves entries)

leadKey : List OldLeaf -> Option (Array Int)
leadKey [] = None
leadKey ((OldLeaf key _) :: _) = Some key

boundEqual : Option (Array Int) -> Option (Array Int) -> Bool
boundEqual None None = True
boundEqual (Some left) (Some right) = bytesCompare left right == Eq
boundEqual _ _ = False

descendInto : Array Int -> Option MstNode -> Reuse
descendInto _ None = FreshBuild
descendInto key (Some node) = ReuseFrom key (nodeShape node)

firstKey : Option (MstEntry, List MstEntry) -> Option (Array Int)
firstKey None = None
firstKey (Some (MstEntry key _ _, _)) = Some key

{- | Take the old child of a slot whose bounds the mutation left standing: as
   it is when the touched key falls outside those bounds, and otherwise as the
   starting point for the one child that still has to be rebuilt. -}
takeSlot : Array Int ->
  Option MstNode ->
  Option (Array Int) ->
  Option (Array Int) ->
  List MstEntry ->
  Int ->
  Option MstNode
takeSlot key old lower upper entries layer =
  if keyAboveLower key lower && keyBelowUpper key upper then
    childFor (descendInto key old) entries layer
  else
    old

reuseSlotAfter : Array Int ->
  List OldLeaf ->
  Array Int ->
  Option (Array Int) ->
  List MstEntry ->
  Int ->
  Option MstNode
reuseSlotAfter _ [] _ _ entries layer = childFor FreshBuild entries layer
reuseSlotAfter key ((OldLeaf leafKey child) :: rest) lower upper entries layer =
  if bytesCompare leafKey lower /= Eq then
    reuseSlotAfter key rest lower upper entries layer
  else if boundEqual upper (leadKey rest) then
    takeSlot key child (Some lower) upper entries layer
  else
    childFor FreshBuild entries layer

{- | Build the child of one slot, bounded by the leaf keys `lower` and `upper`.
   An old slot carrying the same two bounds holds the same entries unless the
   touched key lies between them; a slot the mutation reshaped — the one the
   touched key was added to or removed from as a leaf — has no such old slot
   and is built afresh. -}
childSlot : Reuse ->
  Option (Array Int) ->
  Option (Array Int) ->
  List MstEntry ->
  Int ->
  Option MstNode
childSlot FreshBuild _ _ entries layer = childFor FreshBuild entries layer
childSlot (ReuseFrom key (OldShape left leaves)) None upper entries layer =
  if boundEqual upper (leadKey leaves) then
    takeSlot key left None upper entries layer
  else
    childFor FreshBuild entries layer
childSlot (ReuseFrom key (OldShape _ leaves)) (Some lower) upper entries layer =
  reuseSlotAfter key leaves lower upper entries layer

childFor : Reuse -> List MstEntry -> Int -> Option MstNode
childFor _ [] _ = None
childFor reuse entries layer =
  if layer < 0 then
    panic "mst: internal entry fell below depth zero"
  else
    Some (buildNode reuse entries layer)

childValue : Option MstNode -> DagCbor
childValue None = DcNull
childValue (Some (MstNode cid _ _)) = DcLink cid

childEntries : Option MstNode -> List NodeEntry
childEntries None = []
childEntries (Some node) = [NodeSubtree node]

buildNode : Reuse -> List MstEntry -> Int -> MstNode
buildNode reuse entries layer =
  let (LayerSplit before first) = splitLayer entries layer
  let left = childSlot reuse None (firstKey first) before (layer - 1)
  let (BuiltEntries wireEntries rightEntries) =
    buildWireEntries reuse first layer None
  let bytes =
    mustEncodeNode (DcMap [("l", childValue left), ("e", DcArray wireEntries)])
  let cid = cidForDagCbor bytes
  MstNode cid bytes (childEntries left ++ rightEntries)

nodeBlocks : MstNode -> List (Cid, Array Int)
nodeBlocks (MstNode cid bytes entries) = (cid, bytes) :: subtreeBlocks entries

subtreeBlocks : List NodeEntry -> List (Cid, Array Int)
subtreeBlocks [] = []
subtreeBlocks ((NodeLeaf _ _) :: rest) = subtreeBlocks rest
subtreeBlocks ((NodeSubtree node) :: rest) =
  nodeBlocks node ++ subtreeBlocks rest

buildWireEntries : Reuse ->
  Option (MstEntry, List MstEntry) ->
  Int ->
  Option (Array Int) ->
  BuiltEntries
buildWireEntries _ None _ _ = BuiltEntries [] []
buildWireEntries reuse (Some (MstEntry key value _, rest)) layer previous =
  let (LayerSplit between next) = splitLayer rest layer
  let right = childSlot reuse (Some key) (firstKey next) between (layer - 1)
  let prefix = match previous
    None => 0
    Some prior => commonPrefix prior key
  let wire = DcMap [
    ("p", DcInt prefix),
    ("k", DcBytes (drop prefix key)),
    ("v", DcLink value),
    ("t", childValue right),
  ]
  let (BuiltEntries later laterEntries) =
    buildWireEntries reuse next layer (Some key)
  BuiltEntries
    (wire :: later)
    (NodeLeaf key value :: childEntries right ++ laterEntries)

buildAt : Reuse -> List MstEntry -> Int -> Mst
buildAt reuse entries layer =
  let node = buildNode reuse entries layer
  let (MstNode root bytes _) = node
  Mst entries root bytes node

buildMst : List MstEntry -> Mst
buildMst entries = buildAt FreshBuild entries (maximumDepth entries 0)

{- | Rebuild after a single-key mutation, sharing every node the touched key
   does not reach. A node's layer is part of what it encodes, so a promoted or
   demoted root leaves the old nodes no position to be reused in and the tree
   is rebuilt from scratch. -}
rebuildAround : Array Int -> Mst -> List MstEntry -> Mst
rebuildAround key (Mst before _ _ node) entries =
  let layer = maximumDepth entries 0
  if layer == maximumDepth before 0 then
    buildAt (ReuseFrom key (nodeShape node)) entries layer
  else
    buildAt FreshBuild entries layer

-- ── the tree API ────────────────────────────────────────────────────────────

-- | The one canonical empty repository tree.
export
mstEmpty : Mst
mstEmpty = buildMst []

-- | Construct a canonical tree from an entry map in any input order.
export
mstFromEntries : List (Array Int, Cid) -> Result String Mst
mstFromEntries entries = map buildMst (prepareEntries entries)

lookupEntry : Array Int -> List MstEntry -> Option Cid
lookupEntry _ [] = None
lookupEntry key ((MstEntry candidate value _) :: rest) =
  match bytesCompare key candidate
    Lt => None
    Eq => Some value
    Gt => lookupEntry key rest

-- | Look up one exact byte key.
export
mstLookup : Array Int -> Mst -> Option Cid
mstLookup key (Mst entries _ _ _) = lookupEntry key entries

copyEntries : List MstEntry -> List (Array Int, Cid)
copyEntries [] = []
copyEntries ((MstEntry key value _) :: rest) =
  (arrayCopy key, value) :: copyEntries rest

-- | Return the authoritative entries in lexical byte order.
export
mstEntries : Mst -> List (Array Int, Cid)
mstEntries (Mst entries _ _ _) = copyEntries entries

{- | One bounded key-range read. `start` is the inclusive key the read begins
   at — the smallest key an ascending read returns, the largest a descending
   one returns — `prefix` restricts the read to the keys carrying it,
   `reverse` reads descending instead of ascending, and `limit` is how many
   entries the read may return at most. The limit ends the descent rather than
   trimming its result, so a page of a large collection costs the page. -}
public export data MstRangeQuery = MstRangeQuery {
  start : Option (Array Int),
  prefix : Option (Array Int),
  reverse : Bool,
  limit : Option Int,
}

{- | The entries taken so far in reverse traversal order, how many more the
   limit still allows, and whether the scan has passed the far end of the
   range or filled the limit. Every later step is a no-op once it has. -}
data RangeScan = RangeScan (List (Array Int, Cid)) (Option Int) Bool

scanDone : RangeScan -> Bool
scanDone (RangeScan _ _ done) = done

-- A limit of no entries at all leaves the scan with nothing to do.
scanStart : Option Int -> RangeScan
scanStart None = RangeScan [] None False
scanStart (Some limit) = RangeScan [] (Some limit) (limit <= 0)

-- Take one in-range key, ending the scan when it was the last the limit allows.
takeKey : Array Int -> Cid -> RangeScan -> RangeScan
takeKey key value (RangeScan taken remaining _) =
  let kept = (arrayCopy key, value) :: taken
  match remaining
    None => RangeScan kept None False
    Some left => RangeScan kept (Some (left - 1)) (left <= 1)

hasBytesPrefix : Array Int -> Array Int -> Bool
hasBytesPrefix key prefix = commonPrefix key prefix == arrayLength prefix

-- The later of two inclusive lower bounds; `None` is no bound at all.
laterBound : Option (Array Int) -> Option (Array Int) -> Option (Array Int)
laterBound None other = other
laterBound bound None = bound
laterBound (Some left) (Some right) =
  if bytesCompare left right == Lt then Some right else Some left

belowBound : Array Int -> Option (Array Int) -> Bool
belowBound _ None = False
belowBound key (Some bound) = bytesCompare key bound == Lt

aboveBound : Array Int -> Option (Array Int) -> Bool
aboveBound _ None = False
aboveBound key (Some bound) = bytesCompare key bound == Gt

outsidePrefix : Array Int -> Option (Array Int) -> Bool
outsidePrefix _ None = False
outsidePrefix key (Some prefix) = not (hasBytesPrefix key prefix)

-- A key that neither carries the prefix nor sorts below it sorts above every
-- key that does, so a descending read has not reached the prefix run yet.
abovePrefix : Array Int -> Option (Array Int) -> Bool
abovePrefix _ None = False
abovePrefix key (Some prefix) =
  not (hasBytesPrefix key prefix) && bytesCompare key prefix == Gt

{- | Fold one key into a running ascending scan. Below the low bound the scan
   has not reached it yet; past the high bound, or past the end of the prefix
   run, every later key is out of range too, so the scan ends there. -}
scanKey : Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  Array Int ->
  Cid ->
  RangeScan ->
  RangeScan
scanKey lo hi prefix key value (scan@(RangeScan taken remaining _)) =
  if belowBound key lo then
    scan
  else if aboveBound key hi || outsidePrefix key prefix then
    RangeScan taken remaining True
  else
    takeKey key value scan

{- | The same fold for a descending scan, with the two ends exchanged: above
   the high bound the scan has not reached the range yet, and below the low
   bound — or before the start of the prefix run — it has left it for good. -}
scanKeyDesc : Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  Array Int ->
  Cid ->
  RangeScan ->
  RangeScan
scanKeyDesc _ _ _ _ _ (scan@(RangeScan _ _ True)) = scan
scanKeyDesc lo hi prefix key value (scan@(RangeScan taken remaining _)) =
  if aboveBound key hi || abovePrefix key prefix then
    scan
  else if belowBound key lo || outsidePrefix key prefix then
    RangeScan taken remaining True
  else
    takeKey key value scan

-- A subtree holds only keys below the leaf key bounding it on the right, so an
-- `upper` that does not exceed the low bound puts the whole subtree below it.
spanBelowBound : Option (Array Int) -> Option (Array Int) -> Bool
spanBelowBound _ None = False
spanBelowBound None _ = False
spanBelowBound (Some upper) (Some lo) = bytesCompare upper lo /= Gt

nextLeafKey : List NodeEntry -> Option (Array Int)
nextLeafKey ((NodeLeaf key _) :: _) = Some key
nextLeafKey _ = None

-- A subtree holds only keys above the leaf key bounding it on the left, so a
-- `lower` at or past the far end of a descending read puts the whole subtree
-- past it — either above the high bound or beyond the end of the prefix run.
spanAboveRange : Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  Bool
spanAboveRange None _ _ = False
spanAboveRange (Some lower) hi prefix =
  atOrAboveBound lower hi || abovePrefix lower prefix

atOrAboveBound : Array Int -> Option (Array Int) -> Bool
atOrAboveBound _ None = False
atOrAboveBound key (Some bound) = bytesCompare key bound /= Lt

{- | Walk one node's children in key order, entering a subtree only when part
   of its key span can fall inside the range. -}
scanNode : Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  List NodeEntry ->
  RangeScan ->
  RangeScan
scanNode _ _ _ _ (scan@(RangeScan _ _ True)) = scan
scanNode _ _ _ [] scan = scan
scanNode lo hi prefix ((NodeLeaf key value) :: rest) scan =
  scanNode lo hi prefix rest (scanKey lo hi prefix key value scan)
scanNode lo hi prefix ((NodeSubtree (MstNode _ _ children)) :: rest) scan =
  if spanBelowBound (nextLeafKey rest) lo then
    scanNode lo hi prefix rest scan
  else
    scanNode lo hi prefix rest (scanNode lo hi prefix children scan)

{- | The same walk in descending key order: each child is folded in only after
   everything to its right, so the scan meets the keys in the order it answers
   in and a limit can end it where it stands. `lower` is the leaf key bounding
   this run of children on the left — every key under it sorts above that leaf,
   which is what lets a whole subtree above the range be stepped over. -}
scanNodeDesc : Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  Option (Array Int) ->
  List NodeEntry ->
  RangeScan ->
  RangeScan
scanNodeDesc _ _ _ _ [] scan = scan
scanNodeDesc lo hi prefix _ ((NodeLeaf key value) :: rest) scan =
  scanKeyDesc
    lo
    hi
    prefix
    key
    value
    (scanNodeDesc lo hi prefix (Some key) rest scan)
scanNodeDesc lo hi prefix lower ((NodeSubtree (MstNode _ _ children)) :: rest) scan =
  let above = scanNodeDesc lo hi prefix lower rest scan
  if scanDone above || spanAboveRange lower hi prefix then
    above
  else
    scanNodeDesc lo hi prefix lower children above

rangeBounds : MstRangeQuery -> (Option (Array Int), Option (Array Int))
rangeBounds query =
  if query.reverse then
    (query.prefix, query.start)
  else
    (laterBound query.start query.prefix, None)

{- | The entries the query selects, in the direction it asks for. The node
   descent steps over whole subtrees a walk of the flat entry list would cross,
   so a page costs the page and not the repository behind it: 200 reads of a
   two-entry page at the far end took 0.3 ms at both 1,000 and 16,000 entries,
   against 3.7 ms and 101 ms for the walk. A descending read descends in its
   own direction rather than gathering the range and turning it round, so its
   limit bounds the descent exactly as an ascending one's does. -}
export
mstRange : MstRangeQuery -> Mst -> List (Array Int, Cid)
mstRange query (Mst _ _ _ (MstNode _ _ children)) =
  let (lo, hi) = rangeBounds query
  let start = scanStart query.limit
  let (RangeScan taken _ _) =
    if query.reverse then
      scanNodeDesc lo hi query.prefix None children start
    else
      scanNode lo hi query.prefix children start
  reverse taken

-- Every caller must guarantee `key` is absent from the list before calling;
-- `mstInsert` enforces this with an `mstLookup` guard. The `Eq` arm panics
-- rather than silently inserting a duplicate key.
insertSorted : MstEntry -> List MstEntry -> List MstEntry
insertSorted entry [] = [entry]
insertSorted (entry@(MstEntry key _ _)) ((candidate@(MstEntry other _ _)) :: rest) =
  match bytesCompare key other
    Gt => candidate :: insertSorted entry rest
    Lt => entry :: candidate :: rest
    Eq => panic "mst: insertSorted called with a key already present"

-- | Insert a previously absent key.
export
mstInsert : Array Int -> Cid -> Mst -> Result String Mst
mstInsert key value tree = match mstKeyDepth key
  Err message => Err message
  Ok depth => match mstLookup key tree
    Some _ => Err "mst: duplicate key is not allowed"
    None =>
      let (Mst entries _ _ _) = tree
      -- The caller still owns `key`, so the tree keeps its own copy of it.
      let fresh = MstEntry (arrayCopy key) value depth
      Ok (rebuildAround key tree (insertSorted fresh entries))

replaceEntry : Array Int -> Cid -> List MstEntry -> List MstEntry
replaceEntry _ _ [] = []
replaceEntry key value ((entry@(MstEntry candidate _ depth)) :: rest) =
  if bytesCompare key candidate == Eq then
    MstEntry candidate value depth :: rest
  else
    entry :: replaceEntry key value rest

-- | Replace the value at an existing key.
export
mstReplace : Array Int -> Cid -> Mst -> Result String Mst
mstReplace key value tree = match mstKeyDepth key
  Err message => Err message
  Ok _ => match mstLookup key tree
    None => Err "mst: replace key was not found"
    Some _ =>
      let (Mst entries _ _ _) = tree
      Ok (rebuildAround key tree (replaceEntry key value entries))

deleteEntry : Array Int -> List MstEntry -> List MstEntry
deleteEntry _ [] = []
deleteEntry key ((entry@(MstEntry candidate _ _)) :: rest) =
  if bytesCompare key candidate == Eq then
    rest
  else
    entry :: deleteEntry key rest

-- | Delete an existing key, pruning the root back to the canonical empty node.
export
mstDelete : Array Int -> Mst -> Result String Mst
mstDelete key tree = match mstKeyDepth key
  Err message => Err message
  Ok _ => match mstLookup key tree
    None => Err "mst: delete key was not found"
    Some _ =>
      let (Mst entries _ _ _) = tree
      Ok (rebuildAround key tree (deleteEntry key entries))

-- | Root node CID.
export
mstRootCid : Mst -> Cid
mstRootCid (Mst _ root _ _) = root

-- | Defensive copy of the canonical root node bytes.
export
mstRootBytes : Mst -> Array Int
mstRootBytes (Mst _ _ bytes _) = arrayCopy bytes

copyBlocks : List (Cid, Array Int) -> List (Cid, Array Int)
copyBlocks [] = []
copyBlocks ((cid, bytes) :: rest) = (cid, arrayCopy bytes) :: copyBlocks rest

-- | Complete root-first reachable set of canonical MST node blocks.
export
mstNodeBlocks : Mst -> List (Cid, Array Int)
mstNodeBlocks (Mst _ _ _ node) = copyBlocks (nodeBlocks node)

-- ── decoding one node ───────────────────────────────────────────────────────

decodeOptionalLink : String -> DagCbor -> Result String (Option Cid)
decodeOptionalLink _ DcNull = Ok None
decodeOptionalLink _ (DcLink cid) = Ok (Some cid)
decodeOptionalLink label _ = Err "mst: \{label} must be a CID link or null"

decodeEntries : List DagCbor ->
  Option (Array Int) ->
  List DecodedEntry ->
  Result String (List DecodedEntry)
decodeEntries [] _ acc = Ok (reverse acc)
decodeEntries (value :: rest) previous acc = match value
  DcMap [("k", DcBytes suffix), ("p", DcInt prefix), ("t", tree), ("v", DcLink leaf)] =>
    if prefix < 0 then
      Err "mst: prefix length must be non-negative"
    else match previous
      None =>
        if prefix /= 0 then
          Err "mst: first entry prefix length must be zero"
        else if arrayLength suffix == 0 then
          Err "mst: empty key is not allowed"
        else match decodeOptionalLink "entry tree" tree
          Err message => Err message
          Ok child =>
            decodeEntries
              rest
              (Some suffix)
              (DecodedEntry suffix leaf child :: acc)
      Some prior =>
        if prefix > arrayLength prior then
          Err "mst: prefix length exceeds previous key"
        else
          let key = take prefix prior ++ suffix
          if arrayLength suffix == 0 then
            Err "mst: prefix compression produced an empty suffix"
          else if prefix /= commonPrefix prior key then
            Err "mst: prefix compression is not maximal"
          else match bytesCompare prior key
            Lt => match decodeOptionalLink "entry tree" tree
              Err message => Err message
              Ok child =>
                decodeEntries
                  rest
                  (Some key)
                  (DecodedEntry key leaf child :: acc)
            _ => Err "mst: entry order is not strictly lexical"
  _ => Err "mst: invalid node entry form"

decodeNode : Array Int -> Result String DecodedNode
decodeNode bytes = match dagCborDecode bytes
  Err message => Err "mst: \{message}"
  Ok value => match value
    DcMap [("e", DcArray entries), ("l", left)] =>
      match decodeOptionalLink "left subtree" left
        Err message => Err message
        Ok leftLink =>
          map (DecodedNode leftLink) (decodeEntries entries None [])
    _ => Err "mst: invalid node form; expected exactly fields e and l"

entryKey : DecodedEntry -> Array Int
entryKey (DecodedEntry key _ _) = key

entryChild : DecodedEntry -> Option Cid
entryChild (DecodedEntry _ _ child) = child

allEntryDepth : List DecodedEntry -> Int -> Bool
allEntryDepth [] _ = True
allEntryDepth ((DecodedEntry key _ _) :: rest) expected = match mstKeyDepth key
  Err _ => False
  Ok actual => actual == expected && allEntryDepth rest expected

hasEntryChild : List DecodedEntry -> Bool
hasEntryChild [] = False
hasEntryChild (entry :: rest) = match entryChild entry
  Some _ => True
  None => hasEntryChild rest

hasOptionalCid : Option Cid -> Bool
hasOptionalCid None = False
hasOptionalCid (Some _) = True

validateDecoded : Int -> Bool -> DecodedNode -> Result String Unit
validateDecoded expected isRoot (DecodedNode left entries) =
  if expected < 0 then
    Err "mst: node depth is below zero"
  else match entries
    [] =>
      if isRoot then match left
        Some _ =>
          Err "mst: invalid node form; empty root points only to a subtree"
        None =>
          if expected == 0 then
            Ok ()
          else
            Err "mst: empty root depth must be zero"
      else match left
        None => Err "mst: invalid node form; empty non-root leaf"
        Some _ =>
          if expected == 0 then
            Err "mst: depth-zero node cannot link to a subtree"
          else
            Ok ()
    _ =>
      if not (allEntryDepth entries expected) then
        Err "mst: entry depth does not match node depth"
      else if expected == 0
        && (hasOptionalCid left || hasEntryChild entries) then
        Err "mst: depth-zero node cannot link to a subtree"
      else
        Ok ()

validateNodeEntries : DecodedNode -> Result String Unit
validateNodeEntries (DecodedNode _ entries) =
  checkMstNodeEntries (length entries)

-- | Strictly decode and validate one canonical node at a known depth.
export
mstValidateNodeBytes : Int -> Bool -> Array Int -> Result String Unit
mstValidateNodeBytes expected isRoot bytes = do
  _ <- checkMstNodeBytes (arrayLength bytes)
  node <- decodeNode bytes
  _ <- validateNodeEntries node
  validateDecoded expected isRoot node

-- ── validating a block set ──────────────────────────────────────────────────

cidKey : Cid -> String
cidKey cid = encode (cidToBytes cid)

mstEmptySet : Set String
mstEmptySet = empty

validateBlockRows : List (Cid, Array Int) ->
  Map String (Array Int) ->
  Result String (Map String (Array Int))
validateBlockRows [] index = Ok index
validateBlockRows ((cid, bytes) :: rest) index =
  let key = cidKey cid
  if has key index then
    Err "mst: duplicate node block CID"
  else if not (cidEqual cid (cidForDagCbor bytes)) then
    Err "mst: node block CID does not match bytes"
  else
    validateBlockRows rest (set key bytes index)

nodeDepth : DecodedNode -> Int
nodeDepth (DecodedNode _ []) = 0
nodeDepth (DecodedNode _ (entry :: _)) =
  resultOrPanic "mst: decoded key depth failed" (mstKeyDepth (entryKey entry))

keyAboveLower : Array Int -> Option (Array Int) -> Bool
keyAboveLower _ None = True
keyAboveLower key (Some lower) = bytesCompare lower key == Lt

keyBelowUpper : Array Int -> Option (Array Int) -> Bool
keyBelowUpper _ None = True
keyBelowUpper key (Some upper) = bytesCompare key upper == Lt

entriesWithinBounds : List DecodedEntry ->
  Option (Array Int) ->
  Option (Array Int) ->
  Bool
entriesWithinBounds [] _ _ = True
entriesWithinBounds ((DecodedEntry key _ _) :: rest) lower upper =
  keyAboveLower key lower
    && keyBelowUpper key upper
    && entriesWithinBounds rest lower upper

walkOptionalChild : Option Cid ->
  Int ->
  Option (Array Int) ->
  Option (Array Int) ->
  Map String (Array Int) ->
  Set String ->
  Set String ->
  Int ->
  Int ->
  Result String (Set String)
walkOptionalChild None _ _ _ _ _ visited _ _ = Ok visited
walkOptionalChild (Some child) expected lower upper blocks active visited traversal limit =
  walkBlock
    child
    (Some expected)
    False
    lower
    upper
    blocks
    active
    visited
    traversal
    limit

walkEntryChildren : List DecodedEntry ->
  Int ->
  Option (Array Int) ->
  Map String (Array Int) ->
  Set String ->
  Set String ->
  Int ->
  Int ->
  Result String (Set String)
walkEntryChildren [] _ _ _ _ visited _ _ = Ok visited
walkEntryChildren (entry :: rest) expected upper blocks active visited traversal limit =
  let childUpper = match rest
    [] => upper
    next :: _ => Some (entryKey next)
  match (walkOptionalChild
    (entryChild entry)
    expected
    (Some (entryKey entry))
    childUpper
    blocks
    active
    visited
    traversal
    limit)
    Err message => Err message
    Ok nextVisited =>
      walkEntryChildren
        rest
        expected
        upper
        blocks
        active
        nextVisited
        traversal
        limit

walkNodeChildren : DecodedNode ->
  Int ->
  Option (Array Int) ->
  Option (Array Int) ->
  Map String (Array Int) ->
  Set String ->
  Set String ->
  Int ->
  Int ->
  Result String (Set String)
walkNodeChildren (DecodedNode left entries) expected lower upper blocks active visited traversal limit =
  let leftUpper = match entries
    [] => upper
    entry :: _ => Some (entryKey entry)
  match (walkOptionalChild
    left
    expected
    lower
    leftUpper
    blocks
    active
    visited
    traversal
    limit)
    Err message => Err message
    Ok nextVisited =>
      walkEntryChildren
        entries
        expected
        upper
        blocks
        active
        nextVisited
        traversal
        limit

walkKnownBlock : Array Int ->
  Option Int ->
  Bool ->
  Option (Array Int) ->
  Option (Array Int) ->
  Map String (Array Int) ->
  Set String ->
  Set String ->
  String ->
  Int ->
  Int ->
  Result String (Set String)
walkKnownBlock bytes expected isRoot lower upper blocks active visited key traversal limit =
  do
    _ <- checkMstNodeBytes (arrayLength bytes)
    node <- decodeNode bytes
    _ <- validateNodeEntries node
    let depth = match expected
      Some value => value
      None => nodeDepth node
    _ <- validateDecoded depth isRoot node
    match node
      DecodedNode _ entries =>
        if not (entriesWithinBounds entries lower upper) then
          Err "mst: subtree key falls outside its lexical range"
        else
          walkNodeChildren
            node
            (depth - 1)
            lower
            upper
            blocks
            (Set.insert key active)
            (Set.insert key visited)
            (traversal + 1)
            limit

checkTraversalDepth : Int -> Int -> Result String Unit
checkTraversalDepth limit traversal =
  if limit == maxMstTraversalDepth then
    checkMstTraversalDepth traversal
  else if traversal > limit then
    Err "mst: traversal depth exceeds configured resource limit"
  else
    Ok ()

walkBlock : Cid ->
  Option Int ->
  Bool ->
  Option (Array Int) ->
  Option (Array Int) ->
  Map String (Array Int) ->
  Set String ->
  Set String ->
  Int ->
  Int ->
  Result String (Set String)
walkBlock cid expected isRoot lower upper blocks active visited traversal limit =
  match checkTraversalDepth limit traversal
    Err message => Err message
    Ok () =>
      let key = cidKey cid
      if Set.has key active then
        Err "mst: invalid node form; subtree link cycle"
      else if Set.has key visited then
        Err "mst: invalid node form; subtree block is referenced more than once"
      else match get key blocks
        None => Err "mst: missing reachable node block"
        Some bytes =>
          walkKnownBlock
            bytes
            expected
            isRoot
            lower
            upper
            blocks
            active
            visited
            key
            traversal
            limit

validateBlocksWithTraversalLimit : Int ->
  Cid ->
  List (Cid, Array Int) ->
  Result String Unit
validateBlocksWithTraversalLimit limit root blocks = do
  if limit < 0 then
    Err "mst: traversal depth limit must be non-negative"
  else if limit > maxMstTraversalDepth then
    Err "mst: traversal depth limit exceeds the production maximum"
  else
    Ok ()
  _ <- checkMstBlocks (length blocks)
  index <- validateBlockRows blocks Tip
  visited <- walkBlock
    root
    None
    True
    None
    None
    index
    mstEmptySet
    mstEmptySet
    0
    limit
  if Set.size visited /= size index then
    Err "mst: unreachable node block supplied"
  else
    Ok ()

{- | Strict validation with an explicit traversal limit. Production callers
   should use `mstValidateBlocks`; this boundary exists so the real recursive
   walk can be tested at constructible depths. -}
export
mstValidateBlocksWithTraversalLimit : Int ->
  Cid ->
  List (Cid, Array Int) ->
  Result String Unit
mstValidateBlocksWithTraversalLimit limit root blocks =
  validateBlocksWithTraversalLimit limit root blocks

-- | Validate content binding and prove every supplied node block is reachable.
export
mstValidateBlocks : Cid -> List (Cid, Array Int) -> Result String Unit
mstValidateBlocks root blocks =
  validateBlocksWithTraversalLimit maxMstTraversalDepth root blocks

blockEntryPairs : List DecodedEntry ->
  List (Array Int, Cid) ->
  List (Array Int, Cid)
blockEntryPairs [] acc = acc
blockEntryPairs ((DecodedEntry key leaf _) :: rest) acc =
  blockEntryPairs rest ((arrayCopy key, leaf) :: acc)

blockEntries : List (Cid, Array Int) ->
  List (Array Int, Cid) ->
  Result String (List (Array Int, Cid))
blockEntries [] acc = Ok acc
blockEntries ((_, bytes) :: rest) acc = match decodeNode bytes
  Err message => Err message
  Ok (DecodedNode _ entries) => blockEntries rest (blockEntryPairs entries acc)

{- | Rebuild an editable tree from the complete reachable node-block graph under
   `root`, in any input order.

   `mstValidateBlocks` proves depth, ordering, prefix compression, link, and
   reachability invariants before a single entry is read, and the rebuilt root
   CID must equal `root` — so a graph that decodes to any other tree is rejected
   rather than returned. -}
export
mstFromBlocks : Cid -> List (Cid, Array Int) -> Result String Mst
mstFromBlocks root blocks = do
  _ <- mstValidateBlocks root blocks
  entries <- blockEntries blocks []
  tree <- mstFromEntries entries
  if cidEqual (mstRootCid tree) root then
    Ok tree
  else
    Err "mst: rebuilt tree root does not match the supplied root"

-- ── covering proofs ─────────────────────────────────────────────────────────

entryLeafAtOrAbove : Array Int -> NodeEntry -> Bool
entryLeafAtOrAbove key (NodeLeaf candidate _) = bytesCompare candidate key /= Lt
entryLeafAtOrAbove _ (NodeSubtree _) = False

{- | Index of the first leaf whose key is at or above `key`, or the entry count
   when every leaf sorts below it. Subtrees never match, so the index can land
   on a subtree slot or one past the end; `entryAt` is total for both. -}
findLeafIndex : Array Int -> List NodeEntry -> Int
findLeafIndex key entries = findLeafIndexFrom key entries 0

findLeafIndexFrom : Array Int -> List NodeEntry -> Int -> Int
findLeafIndexFrom _ [] index = index
findLeafIndexFrom key (entry :: rest) index =
  if entryLeafAtOrAbove key entry then
    index
  else
    findLeafIndexFrom key rest (index + 1)

entryAt : Int -> List NodeEntry -> Option NodeEntry
entryAt _ [] = None
entryAt index (entry :: rest) =
  if index < 0 then
    None
  else if index == 0 then
    Some entry
  else
    entryAt (index - 1) rest

subtreeAt : Int -> List NodeEntry -> Option MstNode
subtreeAt index entries = match entryAt index entries
  Some (NodeSubtree node) => Some node
  _ => None

{- | Nodes proving where `key` sits. When this node holds the key as a leaf the
   descent stops here; otherwise it continues into the subtree immediately left
   of the insertion point. A node with no such subtree proves nothing on its own
   and contributes no block, which is why this walk can return the empty list
   while the two sibling walks below always contribute their own node. -}
proofForKey : Array Int -> MstNode -> List (Cid, Array Int)
proofForKey key (MstNode cid bytes entries) =
  let index = findLeafIndex key entries
  let exact = match entryAt index entries
    Some (NodeLeaf candidate _) => bytesCompare candidate key == Eq
    _ => False
  if exact then
    [(cid, bytes)]
  else match subtreeAt (index - 1) entries
    None => []
    Some previous => proofForKey key previous ++ [(cid, bytes)]

-- | Nodes proving the nearest key below `key`.
proofForLeftSib : Array Int -> MstNode -> List (Cid, Array Int)
proofForLeftSib key (MstNode cid bytes entries) =
  let index = findLeafIndex key entries
  let below = match subtreeAt (index - 1) entries
    None => []
    Some previous => proofForLeftSib key previous
  below ++ [(cid, bytes)]

-- | Nodes proving the nearest key above `key`.
proofForRightSib : Array Int -> MstNode -> List (Cid, Array Int)
proofForRightSib key (MstNode cid bytes entries) =
  let index = findLeafIndex key entries
  let found = match entryAt index entries
    None => entryAt (index - 1) entries
    present => present
  let below = match found
    None => []
    Some (NodeSubtree node) => proofForRightSib key node
    Some (NodeLeaf candidate _) =>
      let neighbor =
        if bytesCompare candidate key == Eq then
          entryAt (index + 1) entries
        else
          entryAt (index - 1) entries
      match neighbor
        Some (NodeSubtree node) => proofForRightSib key node
        _ => []
  below ++ [(cid, bytes)]

coveringProof : Array Int -> MstNode -> List (Cid, Array Int)
coveringProof key node =
  proofForKey key node ++ proofForLeftSib key node ++ proofForRightSib key node

unionBlocks : List (Cid, Array Int) ->
  Set String ->
  List (Cid, Array Int) ->
  (Set String, List (Cid, Array Int))
unionBlocks [] seen acc = (seen, acc)
unionBlocks ((cid, bytes) :: rest) seen acc =
  let key = cidKey cid
  if Set.has key seen then
    unionBlocks rest seen acc
  else
    unionBlocks rest (Set.insert key seen) ((cid, bytes) :: acc)

coveringProofGo : List (Array Int) ->
  MstNode ->
  Set String ->
  List (Cid, Array Int) ->
  List (Cid, Array Int)
coveringProofGo [] _ _ acc = reverse acc
coveringProofGo (key :: rest) node seen acc =
  let (nextSeen, nextAcc) = unionBlocks (coveringProof key node) seen acc
  coveringProofGo rest node nextSeen nextAcc

checkProofKeys : List (Array Int) -> Result String Unit
checkProofKeys [] = Ok ()
checkProofKeys (key :: rest) = match mstKeyDepth key
  Err message => Err message
  Ok _ => checkProofKeys rest

{- | Union of the covering proofs for `keys` against this tree.

   A covering proof for one key is every MST node — leaf records excluded —
   needed to prove that key's value and the values of its immediate lexical
   neighbors against this tree's root. It therefore includes nodes on the path
   that a write at `keys` never touched: those are exactly what convinces a
   reader that the rest of the tree is unchanged, and no diff between two trees
   can supply them.

   The result is a set: duplicates across keys are dropped, and callers must not
   read anything into the order. On any tree deeper than a single node it is a
   strict subset of `mstNodeBlocks`, which is the point of calling it.

   Keys need not be present. A relay verifying a delete proves the key's absence
   from exactly the same nodes. -}
export
mstCoveringProofBlocks : List (Array Int) ->
  Mst ->
  Result String (List (Cid, Array Int))
mstCoveringProofBlocks keys (Mst _ _ _ node) = do
  _ <- checkProofKeys keys
  Ok (copyBlocks (coveringProofGo keys node mstEmptySet []))
