{- | Consumer-facing secret-key ingress for the PDS signing boundary.

   A `SecretKey` stores the admitted scalar's canonical 32 big-endian bytes
   in a `Bytes` block, never the caller-owned byte array. `PublicKey` stores
   the internal affine point; consumers use only the compressed SEC 1
   representation.

   Every signature a `SecretKey` makes is charged to `Sign`, indexed by what
   the signature is for: `signCommitDigest` performs `<Sign "commit">` and
   `signServiceAuthDigest` performs `<Sign "service-auth">`. The raw signer
   is private, so the only way to spend the key is through a function whose
   row names its purpose. -}

import bytes as B
import lib.scalar.{Sc, scFromFixedBytesReduce, scSecretCandidate, scToBytes}
import lib.secp256k1.{
  AffinePoint,
  EcdsaSignature,
  ecdsaSignDigest,
  ecdsaSignatureCompact,
  ecdsaSignatureFromCompact,
  ecdsaVerifyDigest,
  pointFromCompressed,
  pointCompressed,
  publicPointForSecret,
}

-- | What a repo key signs: the label every signing row carries, parameterized
--   by the set of purposes the key is spent on.
export effect Sign Set

-- | An admitted secp256k1 secret scalar. Its constructor stays module-private.
--   The bytes live in a pointer-free (atomic) block, so the collector never
--   scans a long-held key's words as candidate pointers; limbs exist only
--   transiently, inside `publicKeyForSecret` and `signDigest`.
export data SecretKey = SecretKey B.Bytes

-- The stored bytes come from `scToBytes` of a canonical scalar, so they are
-- already in `[1, n)` and the fixed-control reducer returns that scalar
-- exactly; the public branch-bearing `scFromBytes` validator is not reached.
secretScalar : SecretKey -> Sc
secretScalar (SecretKey stored) = scFromFixedBytesReduce stored

-- | A parsed or derived secp256k1 public key. Its affine carrier and
--   constructor stay private to this consumer boundary.
export data PublicKey = PublicKey AffinePoint

-- | A canonical low-S compact ECDSA signature. The internal signature and
--   both constructors stay private to this consumer boundary.
export data Signature = Signature EcdsaSignature

-- | Admit exactly the scalars in `[1, n)`. Length is public; for a 32-byte
--   input the scalar module computes its fixed-control validity bit before
--   this one declassified aggregate-validity branch constructs a key or an
--   error.
export
secretKeyFromBytes : B.Bytes -> Result String SecretKey
secretKeyFromBytes bs =
  let (validBit, candidate) = scSecretCandidate bs
  if validBit == 1 then
    Ok (SecretKey (scToBytes candidate))
  else
    Err "sign.secretKeyFromBytes: expected a 32-byte scalar in 1..n-1"

-- | Parse one public compressed SEC 1 key. Invalid wire values are rejected
--   before a `PublicKey` exists.
export
publicKeyFromCompressed : B.Bytes -> Result String PublicKey
publicKeyFromCompressed bytes = map PublicKey (pointFromCompressed bytes)

-- | Serialize a public key in its fixed 33-byte compressed form.
export
publicKeyCompressed : PublicKey -> B.Bytes
publicKeyCompressed (PublicKey point) = pointCompressed point

-- | Derive the public key for an admitted secret scalar via the fixed 256-bit
--   ladder in `secp256k1.mdk`.
export
publicKeyForSecret : SecretKey -> PublicKey
publicKeyForSecret key = PublicKey (publicPointForSecret (secretScalar key))

-- | Parse exactly 64 public bytes as canonical nonzero low-S P1363 `r || s`.
export
signatureFromCompact : B.Bytes -> Result String Signature
signatureFromCompact compact = map Signature (ecdsaSignatureFromCompact compact)

-- | Serialize a signature in its fixed 64-byte P1363 `r || s` form.
export
signatureCompact : Signature -> B.Bytes
signatureCompact (Signature signature) = ecdsaSignatureCompact signature

-- Sign exactly one public 32-byte SHA-256 digest. A public length error is
-- rejected before the fixed two-candidate producer begins; only its final
-- aggregate validity bit is declassified here. A produced signature is
-- verified against the signer's own public key before it is returned; that
-- check reads only public values (key, digest, signature). Private: callers
-- reach it through the two purpose-named signers below.
signDigest : SecretKey -> B.Bytes -> Result String Signature
signDigest key digest =
  if B.length digest /= 32 then
    Err "sign.signDigest: expected 32 digest bytes"
  else
    let scalar = secretScalar key
    let (validBit, signature) = ecdsaSignDigest scalar digest
    if validBit == 1 then
      let publicPoint = publicPointForSecret scalar
      if ecdsaVerifyDigest publicPoint digest signature then
        Ok (Signature signature)
      else
        Err "sign.signDigest: internal signature self-check failed"
    else
      Err "RFC 6979 retry bound exhausted"

-- | Sign the 32-byte SHA-256 digest of an unsigned repository commit. A
--   digest of any other length is an `Err`.
export
signCommitDigest : SecretKey ->
  B.Bytes ->
  <Sign "commit"> Result String Signature
signCommitDigest key digest = signDigest key digest

-- | Sign the 32-byte SHA-256 digest of a service-auth JWS signing input. A
--   digest of any other length is an `Err`.
export
signServiceAuthDigest : SecretKey ->
  B.Bytes ->
  <Sign "service-auth"> Result String Signature
signServiceAuthDigest key digest = signDigest key digest

-- | Verify one canonical signature against a public key and 32-byte digest.
--   A digest of any other length returns `False`.
export
verifyDigest : PublicKey -> B.Bytes -> Signature -> Bool
verifyDigest (PublicKey publicPoint) digest (Signature signature) =
  ecdsaVerifyDigest publicPoint digest signature
