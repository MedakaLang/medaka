{- | Opaque immutable storage carrier for the pure PDS protocol core.

   A `Store` has four parts.

   The **blob half** is the verified content-addressed block store that Phase 2
   shipped (`storeGet`/`storePut`/`storeSize` unchanged), plus each blob's
   declared MIME type recorded alongside it by `storePutBlob`/
   `storeBlobMimeType` — content addressing verifies bytes, not MIME, so the
   declared type is state the routes must carry, not something a CID implies —
   plus a running byte total (`storeBlobBytes`) so an upload can be graded
   against a per-account cap without walking every blob, and a base32-CID-text
   index (`storeBlobCidTexts`) kept in the same order a sync cursor compares,
   so paging needs no sort of its own.

   The **repository half** is the configured account's real signed repository
   state (`lib.repo`'s `Repo`), which Phase 4 record writes transition. It is
   `None` until an account is configured, because the protocol composition
   (HTTP framing, routing, media negotiation) is meaningful — and is tested —
   with no account at all; `storeEmpty` therefore stays free of key material
   and of signing.

   🔐 **A configured `Store` is SECRET-BEARING.** `Repo` owns the account's
   secp256k1 `SecretKey` (it must, to sign every commit), so a `Store` built by
   `storeFromRepo` transitively carries that secret. Nothing in this module
   exposes it, and `Store`'s representation is private, but a caller that logs,
   serializes, or otherwise copies a `Store` is copying the signing key. See
   `pds/README.md` § "The Store is secret-bearing".

   The **auth half** is everything the session routes rest on: the server's
   own HS256 session-token secret (`lib.jwt`), `None` until one is configured;
   the account's password credential (`lib.credential`), `None` until one is
   bootstrapped; and the open sessions. The session secret is the SERVER's
   secret and not the account's signing key, and a `Store` without one can
   verify no credential at all, so every gated route refuses; a `Store`
   without a credential record can open no session at all, so `createSession`
   refuses.

   The session set is grouped into families, one per login: each family's open
   sessions and the refresh tokens it has consumed, all of it ending at an
   instant fixed at the login. `pds/shell/server.mdk` persists the whole set
   beside the other halves (`storeSessionRows`) whenever a transition moves
   it, and a restart reads it back (`storeWithSessionRows`), so a session
   survives a restart and so does a revocation: a closed or revoked family is
   absent from the set that was written, and nothing read back can reopen it.

   The **preferences half** is the account's `app.bsky` preference set
   (`app.bsky.actor.getPreferences`/`putPreferences`): a list of preference
   items, each a JSON object carrying its own `$type`. It starts empty on a
   fresh account, and `putPreferences` replaces it wholesale rather than
   merging into it — there is exactly one namespace this server ever writes,
   so a whole-namespace replace and a whole-store replace coincide.

   Multiple repositories belong to a later phase and cannot leak effects
   through this interface. -}

import lib.blockstore.{
  BlockStore,
  blockStoreCids,
  blockStoreEmpty,
  blockStoreEntries,
  blockStoreGet,
  blockStoreHas,
  blockStorePut,
  blockStoreSize,
}
import lib.cid.{Cid, cidToString}
import lib.credential.{CredentialRecord}
import lib.jwt.{serverSecretBytes}
import lib.repo.{Repo}
import hmac.{ctEq}
import sha256.{sha256}
import json.{Json}
import map.{Map(..), get, keys, set, entries, entriesFrom}
import string.{toUtf8}

{- | One open session: the fingerprints of the access and refresh tokens it
   issued, the instant it stops verifying (seconds since the Unix epoch), past
   which the record is prunable, and the family it belongs to.

   A session is keyed by token FINGERPRINTS — `sessionFingerprint`, the
   SHA-256 of the token text — rather than by the tokens themselves, so the
   bearer strings a client holds are not a second time stored on the server.
   The constructor is private: a session is opened, rotated, and closed
   through the operations below and cannot be forged from raw bytes.

   A family is every session one login leads to by rotation. It is named by
   the fingerprint of the refresh token the login issued, and it ends at an
   instant fixed when it is opened: a rotation never moves a session's expiry
   past the end of the family it rotates within. -}
data SessionRecord = SessionRecord (Array Int) (Array Int) Int (Array Int)

{- | A refresh token a rotation consumed: its fingerprint, its family, the
   instant it was consumed, the instant the family ends, and the refresh
   fingerprint of the session the latest replay of it opened, if any.

   It is kept until the family ends so that presenting it again can be told
   apart from presenting a token this server never issued. Soon after the
   rotation, a replay is a client racing its own refresh; long after it, the
   token was copied, and the family it belongs to is revoked.

   The last field is what bounds a burst of replays: each one closes the
   session the one before it opened, so however often the token is replayed
   inside the window, at most one session a replay of it opened is open at a
   time, beside the one the rotation itself opened. -}
data ConsumedRefresh =
  | ConsumedRefresh (Array Int) (Array Int) Int Int (Option (Array Int))

-- The open sessions, and the refresh tokens their families have consumed.
data Sessions = Sessions (List SessionRecord) (List ConsumedRefresh)

-- The three secret-bearing parts of a `Store`, kept as one field so the blob
-- and repository halves are not respelled every time one of them changes.
data Auth = Auth (Option (Array Int)) (Option CredentialRecord) Sessions

emptyAuth : Auth
emptyAuth = Auth None None (Sessions [] [])

{- | The blob half: verified content-addressed bytes (`BlockStore` — the same
   verification `lib.repo`'s own internal block store uses), an index of the
   blobs it holds, and the running total of their lengths.

   The index is keyed on a blob's base32 CID TEXT (`cidToString`) and not on
   `BlockStore`'s own key, which is the HEX of the raw CID bytes. Hex order
   and base32-of-the-same-bytes order are different relations, and the cursor
   `com.atproto.sync.listBlobs` pages with is base32 text, so a pager reading
   the hex order against that cursor walks past blobs it then never returns.
   The index value carries the CID itself, so a key can be turned back into
   the blob it names without re-decoding the text, and the declared MIME type,
   which is `None` for a blob inserted through the byte-only `storePut`:
   content addressing verifies bytes, not MIME, so the type is not derivable
   from the CID and is not part of `BlockStore`'s own representation.

   The total counts each distinct CID once, so it is what the account has
   STORED and not what it has uploaded: re-uploading identical bytes leaves it
   where it was, exactly as it leaves the block store where it was. Keeping it
   here is what lets the account-usage check cost the same on a store of one
   blob and a store of ten thousand.

   The version counts the successful inserts this half has taken, and exists
   so a caller can tell two blob halves apart without walking either: `set` in
   `blobHalfPut` is unconditional, so every insert that admits a blob at all
   advances the counter, and two halves sharing a counter value are two names
   for one insert sequence. It may separate halves the index cannot — the same
   bytes re-declared under the type they already had moves it — which costs a
   caller a write it did not owe and never a change it failed to see. -}
data BlobHalf = BlobHalf BlockStore (Map String (Cid, Option String)) Int Int

blobHalfEmpty : BlobHalf
blobHalfEmpty = BlobHalf blockStoreEmpty Tip 0 0

-- The declared type recorded for a blob, or `None` for one that has no entry
-- at all as well as one inserted without a type.
declaredTypeOf : Cid -> BlobHalf -> Option String
declaredTypeOf cid (BlobHalf _ index _ _) = match get (cidToString cid) index
  Some (_, declared) => declared
  None => None

-- Insert one verified blob under an already-decided declared type. The byte
-- total moves only when the block store gains a row: `blockStorePut` accepts
-- an identical duplicate without storing it a second time, and a store that
-- counted such a re-upload would refuse an account its own quota. The version
-- moves on every insert the block store accepts, duplicate bytes included,
-- because the declared type recorded for them can differ from the one they
-- already carried.
blobHalfPut : Cid ->
  Option String ->
  Array Int ->
  BlobHalf ->
  Result String BlobHalf
blobHalfPut cid declared bytes (BlobHalf blocks index total version) =
  let stored =
    if blockStoreHas cid blocks then total else total + arrayLength bytes
  map
    (next =>
      BlobHalf
        next
        (set (cidToString cid) (cid, declared) index)
        stored
        (version + 1))
    (blockStorePut cid bytes blocks)

-- | Immutable verified protocol state. Its representation is private.
export data Store = Store BlobHalf (Option Repo) Auth (List Json)

-- | The empty protocol store: no blobs, no account, no session state, and no
-- preferences.
export
storeEmpty : Store
storeEmpty = Store blobHalfEmpty None emptyAuth []

-- | A protocol store for one configured account repository, with no blobs and
-- no preferences.
export
storeFromRepo : Repo -> Store
storeFromRepo repo = Store blobHalfEmpty (Some repo) emptyAuth []

-- | The configured account repository, or `None` when no account is set up.
export
storeRepo : Store -> Option Repo
storeRepo (Store _ repo _ _) = repo

-- | Successor store carrying a transitioned account repository. The blob
-- half, the auth half, and the preferences half are untouched.
export
storeWithRepo : Repo -> Store -> Store
storeWithRepo repo (Store blocks _ auth prefs) =
  Store blocks (Some repo) auth prefs

{- | Successor store carrying the server's own session-token secret, admitted
   against `lib.jwt`'s expected length so a misconfigured secret is refused
   here rather than at the first request that would sign with it. The
   repository and blob halves are untouched.

   The secret is a SECOND secret in a `Store` that already carries the
   account's signing key, so the same "never log, serialize, or copy a
   `Store`" rule covers it. -}
export
storeWithServerSecret : Array Int -> Store -> Result String Store
storeWithServerSecret secret (Store blocks repo (Auth _ credential sessions) prefs) =
  if arrayLength secret /= serverSecretBytes then
    Err "store: server session secret must be 32 bytes"
  else
    Ok
      (Store
        blocks
        repo
        (Auth (Some (arrayCopy secret)) credential sessions)
        prefs)

{- | The server's session-token secret, or `None` when no session secret is
   configured — in which case no credential can be verified at all and every
   gated route refuses. -}
export
storeServerSecret : Store -> Option (Array Int)
storeServerSecret (Store _ _ (Auth secret _ _) _) = map arrayCopy secret

{- | Successor store carrying the account's password credential. It is a THIRD
   secret-bearing part of a `Store` (with the account signing key and the
   session secret), and the same "never log, serialize, or copy a `Store`"
   rule covers it. -}
export
storeWithCredential : CredentialRecord -> Store -> Store
storeWithCredential credential (Store blocks repo (Auth secret _ sessions) prefs) =
  Store blocks repo (Auth secret (Some credential) sessions) prefs

{- | The account's password credential, or `None` when none is configured — in
   which case no session can be opened at all and `createSession` refuses. -}
export
storeCredential : Store -> Option CredentialRecord
storeCredential (Store _ _ (Auth _ credential _) _) = credential

{- | The account's `app.bsky` preference set, in the order `putPreferences`
   last wrote it. Empty on a fresh account that has never called
   `putPreferences`. -}
export
storePreferences : Store -> List Json
storePreferences (Store _ _ _ prefs) = prefs

-- | Successor store carrying a wholesale-replaced preference set. The blob,
-- repository, and auth halves are untouched.
export
storeWithPreferences : List Json -> Store -> Store
storeWithPreferences prefs (Store blocks repo auth _) =
  Store blocks repo auth prefs

{- | The fingerprint a session is keyed by: the SHA-256 of the token text.

   Fingerprinting rather than storing the token means a reader of the server's
   memory finds no bearer string it could present, and it is what lets the seam
   ask "is this token's session still open?" with the token it was handed and
   nothing else. -}
export
sessionFingerprint : String -> Array Int
sessionFingerprint token = sha256 (toUtf8 token)

recordFamily : SessionRecord -> Array Int
recordFamily (SessionRecord _ _ _ family) = family

consumedFamily : ConsumedRefresh -> Array Int
consumedFamily (ConsumedRefresh _ family _ _ _) = family

-- The open session whose refresh token this is, while it still verifies.
liveRefresh : Int -> Array Int -> List SessionRecord -> Option SessionRecord
liveRefresh now wanted open =
  find
    (record => match record
      SessionRecord _ refresh expires _ => now < expires && ctEq wanted refresh)
    open

-- The consumption record of this refresh token, while its family lasts.
consumedRefresh : Int ->
  Array Int ->
  List ConsumedRefresh ->
  Option ConsumedRefresh
consumedRefresh now wanted consumed =
  find
    (entry => match entry
      ConsumedRefresh refresh _ _ ends _ => now < ends && ctEq wanted refresh)
    consumed

-- The consumption record of this refresh token dropped.
withoutConsumed : Array Int -> List ConsumedRefresh -> List ConsumedRefresh
withoutConsumed wanted consumed =
  filter
    (entry => match entry
      ConsumedRefresh refresh _ _ _ _ => not (ctEq wanted refresh))
    consumed

hasAccess : Int -> Array Int -> List SessionRecord -> Bool
hasAccess _ _ [] = False
hasAccess now wanted ((SessionRecord access _ expires _) :: rest) =
  now < expires && ctEq wanted access || hasAccess now wanted rest

withoutRefresh : Array Int -> List SessionRecord -> List SessionRecord
withoutRefresh wanted open =
  filter
    (record => match record
      SessionRecord _ refresh _ _ => not (ctEq wanted refresh))
    open

-- Every session and every consumed token of one family dropped. Nothing of
-- the family is left that a later replay could find.
withoutFamily : Array Int -> Sessions -> Sessions
withoutFamily family (Sessions open consumed) =
  Sessions
    (filter (record => not (ctEq family (recordFamily record))) open)
    (filter (entry => not (ctEq family (consumedFamily entry))) consumed)

withSessions : Sessions -> Store -> Store
withSessions sessions (Store blocks repo (Auth secret credential _) prefs) =
  Store blocks repo (Auth secret credential sessions) prefs

storeSessions : Store -> Sessions
storeSessions (Store _ _ (Auth _ _ sessions) _) = sessions

openIn : Array Int -> Array Int -> Int -> Array Int -> Sessions -> Sessions
openIn access refresh expires family (Sessions open consumed) =
  Sessions
    (SessionRecord (arrayCopy access) (arrayCopy refresh) expires family
      :: open)
    consumed

{- | Successor store with one more open session, the first of a new family:
   an access-token fingerprint, a refresh-token fingerprint, and the instant
   the family ends. No rotation within the family outlives that instant. -}
export
storeSessionOpen : Array Int -> Array Int -> Int -> Store -> Store
storeSessionOpen access refresh expires store =
  withSessions
    (openIn access refresh expires (arrayCopy refresh) (storeSessions store))
    store

{- | Whether this access-token fingerprint belongs to an open session at `now`.
   A token this server minted but whose session has since been closed, rotated
   away, revoked, or outlived by its family answers `False`, which is what
   makes `deleteSession` revoke an access token that is otherwise still inside
   its own window.

   A restart is not one of those: the session set is persisted and read back,
   so a token survives one. -}
export
storeAccessActive : Int -> Array Int -> Store -> Bool
storeAccessActive now fingerprint store = match storeSessions store
  Sessions open _ => hasAccess now fingerprint open

{- | Whether this refresh-token fingerprint may be presented to the refresh
   route at `now`: it belongs to an open session, or a rotation consumed it
   within a family that has not ended. The second is admitted so that the
   rotation itself can decide what a replay means (`storeSessionRotate`); a
   token of a revoked or closed family answers `False`. -}
export
storeRefreshActive : Int -> Array Int -> Store -> Bool
storeRefreshActive now fingerprint store = match storeSessions store
  Sessions open consumed =>
    isSome (liveRefresh now fingerprint open)
      || isSome (consumedRefresh now fingerprint consumed)

{- | What presenting a refresh token to `storeSessionRotate` did.

   `Rotated` carries the store with the fresh token pair open. `Revoked`
   carries the store with the presented token's whole family removed: the
   request is refused, and that removal is still a transition the caller must
   keep. `NotRotated` means no family this store knows holds the token. -}
public export data SessionRotation = Rotated Store | Revoked Store | NotRotated

{- | Consume a refresh token at `now` and open a fresh token pair in its family.

   A token of an open session is consumed: its record is replaced by the new
   pair, and it is remembered as consumed until the family ends. The new
   session expires at `expires` or the family's end, whichever is sooner, so
   rotating never extends a family.

   A token already consumed is a replay. Within `graceSeconds` of its
   consumption it is answered like a first presentation, with a fresh pair in
   the same family, because a client that refreshed twice in a burst holds
   both answers' predecessor. The session the rotation opened stays open, and
   the session the previous replay of the same token opened, if one did, is
   closed: a replay supersedes the replay before it, so a burst of any length
   leaves one replay-opened session per consumed token rather than one per
   presentation. Past that window the token has been copied, so
   the whole family is revoked: every open session in it stops verifying,
   including the access token its legitimate holder was using. Other families
   are untouched. -}
export
storeSessionRotate : Array Int ->
  Array Int ->
  Array Int ->
  Int ->
  Int ->
  Int ->
  Store ->
  SessionRotation
storeSessionRotate consumed access refresh expires now graceSeconds store =
  match storeSessions store
    Sessions open spent => match liveRefresh now consumed open
      Some (SessionRecord _ _ ends family) =>
        let record = ConsumedRefresh (arrayCopy consumed) family now ends None
        Rotated
          (withSessions
            (openIn
              access
              refresh
              (min expires ends)
              family
              (Sessions (withoutRefresh consumed open) (record :: spent)))
            store)
      None => match consumedRefresh now consumed spent
        Some (ConsumedRefresh _ family at ends replayed) =>
          if now < at + graceSeconds then
            let superseded = match replayed
              Some previous => withoutRefresh previous open
              None => open
            let entry =
              ConsumedRefresh
                (arrayCopy consumed)
                family
                at
                ends
                (Some (arrayCopy refresh))
            Rotated
              (withSessions
                (openIn
                  access
                  refresh
                  (min expires ends)
                  family
                  (Sessions
                    superseded
                    (entry :: withoutConsumed consumed spent)))
                store)
          else
            Revoked
              (withSessions (withoutFamily family (storeSessions store)) store)
        None => NotRotated

{- | Close the family this refresh fingerprint belongs to at `now`, or `None`
   when no family this store knows holds it. The fingerprint may be an open
   session's refresh token or one a rotation consumed within a family that
   has not ended, inside its grace window or past it: any token
   `storeRefreshActive` admits names its family here. Every token of the
   family stops verifying, and its consumed refresh tokens are forgotten, so a
   replay inside the grace window cannot reopen what was logged out of. -}
export
storeSessionClose : Int -> Array Int -> Store -> Option Store
storeSessionClose now fingerprint store = match storeSessions store
  Sessions open consumed =>
    let found =
      find
        (record => match record
          SessionRecord _ refresh _ _ => ctEq fingerprint refresh)
        open
    let family = match found
      Some record => Some (recordFamily record)
      None => map consumedFamily (consumedRefresh now fingerprint consumed)
    map
      (ended => withSessions (withoutFamily ended (storeSessions store)) store)
      family

{- | The persisted form of the session set, one row per record.

   `OpenSessionRow` is an open session: access fingerprint, refresh
   fingerprint, the instant it expires, and its family. `ConsumedRefreshRow`
   is a consumed refresh token: its fingerprint, its family, the instant it
   was consumed, the instant the family ends, and the refresh fingerprint of
   the session its latest replay opened, if any. -}
public export data SessionRow =
  | OpenSessionRow (Array Int) (Array Int) Int (Array Int)
  | ConsumedRefreshRow (Array Int) (Array Int) Int Int (Option (Array Int))
  deriving (Eq)

openRow : SessionRecord -> SessionRow
openRow (SessionRecord access refresh expires family) =
  OpenSessionRow
    (arrayCopy access)
    (arrayCopy refresh)
    expires
    (arrayCopy family)

consumedRow : ConsumedRefresh -> SessionRow
consumedRow (ConsumedRefresh refresh family at ends replayed) =
  ConsumedRefreshRow
    (arrayCopy refresh)
    (arrayCopy family)
    at
    ends
    (map arrayCopy replayed)

rowSessions : List SessionRow -> Sessions
rowSessions [] = Sessions [] []
rowSessions (row :: rest) = match (row, rowSessions rest)
  (OpenSessionRow access refresh expires family, Sessions open consumed) =>
    Sessions
      (SessionRecord
          (arrayCopy access)
          (arrayCopy refresh)
          expires
          (arrayCopy family)
        :: open)
      consumed
  (ConsumedRefreshRow refresh family at ends replayed, Sessions open consumed) =>
    Sessions
      open
      (ConsumedRefresh
          (arrayCopy refresh)
          (arrayCopy family)
          at
          ends
          (map arrayCopy replayed)
        :: consumed)

{- | Every open session and every consumed refresh token as a flat row.

   This is what a caller that persists sessions across a restart needs, and it
   is all of it. `SessionRecord` itself stays private: a row is admitted back
   as a session only through `storeWithSessionRows`, so the constructor is
   still not reachable from outside this module, and the fingerprints are
   copied on the way out as they are on the way in. -}
export
storeSessionRows : Store -> List SessionRow
storeSessionRows store = match storeSessions store
  Sessions open consumed => map openRow open ++ map consumedRow consumed

{- | Successor store whose session set is exactly these rows, replacing
   whatever it held.

   This is a load-time operation: it is how a restart readmits the sessions a
   previous process wrote out. It admits rows unexamined — an expired one is
   still a session here — so a caller restoring from disk prunes with
   `storeSessionsPrune` against the current instant rather than trusting the
   file to hold only live rows. -}
export
storeWithSessionRows : List SessionRow -> Store -> Store
storeWithSessionRows rows store = withSessions (rowSessions rows) store

{- | Successor store with every session that has expired at `now` dropped, and
   every consumed refresh token whose family has ended. Neither verifies
   anything any more, so both are only memory: this is what keeps the set
   bounded by the families still inside their lifetime. -}
export
storeSessionsPrune : Int -> Store -> Store
storeSessionsPrune now store = match storeSessions store
  Sessions open consumed =>
    withSessions
      (Sessions
        (filter
          (record => match record
            SessionRecord _ _ expires _ => now < expires)
          open)
        (filter
          (entry => match entry
            ConsumedRefresh _ _ _ ends _ => now < ends)
          consumed))
      store

-- | Number of distinct verified blocks in the blob half. The repository half
-- keeps its own blocks and is not counted here.
export
storeSize : Store -> Int
storeSize (Store (BlobHalf blocks _ _ _) _ _ _) = blockStoreSize blocks

{- | How many blobs have been inserted into the blob half, counting a blob
   whose bytes were already there. The number itself names nothing; comparing
   it either side of a transition is the whole of its use.

   Paired with `storeSize` it separates two blob halves at a fixed cost. Every
   other way of asking reads the half: `storeBlobMimeIndex` pairs up its whole
   declared-type index and `storeBlobEntries` copies every blob's bytes, so a
   caller that only needs to know whether anything moved would pay for the
   account it is asking about. It never misses a change — the insert is the
   only thing that moves this half, and it always advances this — and it may
   report one where the recorded state is identical, which re-declaring a
   blob's existing type is. -}
export
storeBlobVersion : Store -> Int
storeBlobVersion (Store (BlobHalf _ _ _ version) _ _ _) = version

{- | The total length of the distinct blobs the blob half holds, without
   walking one of them.

   `storeBlobEntries` answers the same question by handing back a copy of
   every blob in the account, so an upload graded against a per-account byte
   cap would otherwise read the whole account to decide one request. -}
export
storeBlobBytes : Store -> Int
storeBlobBytes (Store (BlobHalf _ _ total _) _ _ _) = total

-- | Whether the blob half already holds a blob, without copying its bytes.
export
storeHasBlob : Cid -> Store -> Bool
storeHasBlob cid (Store (BlobHalf blocks _ _ _) _ _ _) =
  blockStoreHas cid blocks

-- | Look up a blob-half block, returning a defensive copy.
export
storeGet : Cid -> Store -> Option (Array Int)
storeGet cid (Store (BlobHalf blocks _ _ _) _ _ _) = blockStoreGet cid blocks

-- | Verify and immutably insert a blob-half block, returning the successor
-- store. No MIME type is recorded — this is the byte-only primitive
-- `storePutBlob` is built on, and a type already declared for these bytes is
-- kept rather than erased. The repository half is carried through unchanged.
export
storePut : Cid -> Array Int -> Store -> Result String Store
storePut cid bytes (Store half repo auth prefs) =
  map
    (next => Store next repo auth prefs)
    (blobHalfPut cid (declaredTypeOf cid half) bytes half)

-- | Verify and immutably insert a blob-half block together with its declared
-- MIME type, returning the successor store. `pds/lib/blob.mdk`'s `admitBlob`
-- is the one place that decides whether a blob is admitted at all; this only
-- records what it already admitted.
export
storePutBlob : Cid -> String -> Array Int -> Store -> Result String Store
storePutBlob cid mimeType bytes (Store half repo auth prefs) =
  map
    (next => Store next repo auth prefs)
    (blobHalfPut cid (Some mimeType) bytes half)

-- | The declared MIME type of a blob-half entry inserted via `storePutBlob`,
-- or `None` when the CID is absent (or was inserted through the byte-only
-- `storePut`, which no route uses).
export
storeBlobMimeType : Cid -> Store -> Option String
storeBlobMimeType cid (Store half _ _ _) = declaredTypeOf cid half

-- | Every distinct verified block in the blob half, CID-sorted and
-- defensively copied, byte payload included. No route calls this — every
-- caller that only needs names or a byte total reaches for
-- `storeBlobCids`/`storeBlobCidTexts`/`storeBlobBytes` instead.
export
storeBlobEntries : Store -> List (Cid, Array Int)
storeBlobEntries (Store (BlobHalf blocks _ _ _) _ _ _) =
  blockStoreEntries blocks

{- | Every distinct verified CID in the blob half, in canonical CID order and
   carrying no bytes — what `sync.listBlobs` pages over.

   `storeBlobEntries` answers the same question, but copies every blob's bytes
   to do it, so listing the names of an account's blobs would otherwise cost
   the whole blob half. -}
export
storeBlobCids : Store -> List Cid
storeBlobCids (Store (BlobHalf blocks _ _ _) _ _ _) = blockStoreCids blocks

{- | Every distinct blob's base32 CID TEXT, ascending in that text's own
   order and carrying no bytes — what a cursor compared as base32 text pages
   over.

   `storeBlobCids` answers the same question in `lib.blockstore`'s key order,
   which is the hex of the raw CID bytes; the two orders disagree, so a pager
   holding a base32 cursor has to sort that one and cannot sort this one. -}
export
storeBlobCidTexts : Store -> List String
storeBlobCidTexts (Store (BlobHalf _ index _ _) _ _ _) = keys index

{- | One page of that same listing: the blob CID texts from `start` upwards,
   at most `limit` of them, in the same base32-text order.

   `start` is INCLUSIVE, so a caller resuming at a cursor gets the cursor's own
   blob back as the first row and drops it itself. The index answers the
   bounded question rather than handing back every name for the caller to
   filter, so a page of an account's blobs costs the page and not the whole
   blob half — which is what `storeBlobCidTexts`, and every pager built on it,
   costs. -}
export
storeBlobCidTextsFrom : Option String -> Option Int -> Store -> List String
storeBlobCidTextsFrom start limit (Store (BlobHalf _ index _ _) _ _ _) =
  map fst (entriesFrom start limit index)

{- | The blob half's declared-type index: every CID text that has a declared
   MIME type, paired with it, in CID-text order and carrying no bytes.

   Whole-index cost, `O(blob count)` — `storeBlobVersion` is the fixed-cost way
   to tell two blob halves apart; use this only when the pairs themselves are
   needed, not just whether anything moved. -}
export
storeBlobMimeIndex : Store -> List (String, String)
storeBlobMimeIndex (Store (BlobHalf _ index _ _) _ _ _) =
  declaredPairs (entries index)

-- The declared-type index's rows that HAVE a declared type, in the index's
-- own order. A blob inserted through the byte-only `storePut` has none and
-- contributes no row, so the result is the same pairing a store that records
-- types only on the typed insert would hold.
declaredPairs : List (String, (Cid, Option String)) -> List (String, String)
declaredPairs [] = []
declaredPairs ((key, (_, declared)) :: rest) = match declared
  Some mimeType => (key, mimeType) :: declaredPairs rest
  None => declaredPairs rest
