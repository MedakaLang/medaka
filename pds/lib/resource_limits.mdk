{- | Central resource ceilings for untrusted repository and atproto data.

   The pure in-memory Phase 1 implementation deliberately rejects containers
   beyond these bounds instead of allowing attacker-controlled allocation or
   traversal. The exported checks make both sides of every boundary directly
   testable without constructing a maximum-sized valid repository.

   HTTP framing and endpoint-body ceilings are not here: they belong to the
   codec that enforces them and live in `stdlib/http.mdk` as its own `max*`
   and `check*` exports. -}

-- Blob layer policy. Distinct from `http.maxRawBodyBytes`: that is the outer
-- HTTP raw-body framing ceiling (`stdlib/http.mdk`'s `RawBody`), enforced
-- before a body is even attributed to an endpoint. `maxBlobBytes` is the
-- protocol-level per-blob cap `pds/lib/blob.mdk`'s admission function
-- enforces; today it equals the framing ceiling because nothing yet needs
-- them to diverge, but a future endpoint-specific policy can move one
-- without moving the other.
export
maxBlobBytes : Int
maxBlobBytes = 5242880

export
maxAccountBlobBytes : Int
maxAccountBlobBytes = 104857600

export
checkBlobBytes : Int -> Result String Unit
checkBlobBytes size =
  if size > maxBlobBytes then
    Err "blob: exceeds 5242880-byte per-blob resource limit"
  else
    Ok ()

export
checkAccountBlobBytes : Int -> Result String Unit
checkAccountBlobBytes size =
  if size > maxAccountBlobBytes then
    Err "blob: account blob usage exceeds 104857600-byte resource limit"
  else
    Ok ()

export
maxCarBytes : Int
maxCarBytes = 67108864

export
maxCarSectionBytes : Int
maxCarSectionBytes = 4194304

export
maxCarBlocks : Int
maxCarBlocks = 100000

export
maxMstBlocks : Int
maxMstBlocks = 100000

export
maxMstNodeBytes : Int
maxMstNodeBytes = 4194304

export
maxMstNodeEntries : Int
maxMstNodeEntries = 256

export
maxMstTraversalDepth : Int
maxMstTraversalDepth = 128

export
checkCarBytes : Int -> Result String Unit
checkCarBytes size =
  if size > maxCarBytes then
    Err "car: container exceeds 67108864-byte resource limit"
  else
    Ok ()

export
checkCarSectionBytes : Int -> Result String Unit
checkCarSectionBytes size =
  if size > maxCarSectionBytes then
    Err "car: section exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkCarBlocks : Int -> Result String Unit
checkCarBlocks count =
  if count > maxCarBlocks then
    Err "car: block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstBlocks : Int -> Result String Unit
checkMstBlocks count =
  if count > maxMstBlocks then
    Err "mst: node block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstNodeBytes : Int -> Result String Unit
checkMstNodeBytes size =
  if size > maxMstNodeBytes then
    Err "mst: node exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkMstNodeEntries : Int -> Result String Unit
checkMstNodeEntries count =
  if count > maxMstNodeEntries then
    Err "mst: node entry count exceeds 256 resource limit"
  else
    Ok ()

export
checkMstTraversalDepth : Int -> Result String Unit
checkMstTraversalDepth depth =
  if depth > maxMstTraversalDepth then
    Err "mst: traversal depth exceeds 128 resource limit"
  else
    Ok ()

-- Rate limiting policy (#2612). One shared window across the five limit
-- classes `pds/lib/ratelimit.mdk` defines; each class keeps its own
-- allowance within that window.
export
rateLimitWindowSeconds : Int
rateLimitWindowSeconds = 60

export
maxConnectionsPerWindow : Int
maxConnectionsPerWindow = 120

export
maxRequestsPerWindow : Int
maxRequestsPerWindow = 3000

-- Placeholder pending real traffic data, like its three siblings above and
-- below. Two independent constraints bound it. A signed write costs an MST
-- update, a commit signature and a disk persist, so the ceiling belongs far
-- enough below what one window can physically absorb that a caller hits the
-- limit rather than the work. And a write ceiling a flood cannot reach
-- inside one window is unobservable by construction — the count resets
-- mid-flood, so nothing can ever witness the refusal; driving 301 writes
-- takes ~72s against this 60s window, which is what rules out a ceiling in
-- the hundreds until either the window or the per-write cost changes.
export
maxWritesPerWindow : Int
maxWritesPerWindow = 60

export
maxCreateSessionPerWindow : Int
maxCreateSessionPerWindow = 30

{- | The whole-repository export ceiling (`com.atproto.sync.getRepo`), which
   `maxRequestsPerWindow` cannot express: one export's response is bounded
   only by `maxCarBytes`, so the request count and the bytes it authorizes are
   different quantities and the larger one has to be named separately.

   The ceiling times `maxCarBytes` is the egress one identity may nominally
   demand from this route in one window. At 100 that is 6.25 GiB per 60-second
   window — about 900 Mbit/s sustained, one gigabit link — where the shared
   `maxRequestsPerWindow` of 3000 would authorize 187 GiB, past any link this
   process could be reached over. The ceiling is also low enough to be
   reachable inside one window, without which no refusal is observable: the
   count resets mid-flood and nothing witnesses it. -}
export
maxRepoExportsPerWindow : Int
maxRepoExportsPerWindow = 100
