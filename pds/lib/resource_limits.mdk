{- | Central resource ceilings for untrusted repository and protocol data.

   The pure in-memory Phase 1 implementation deliberately rejects containers
   beyond these bounds instead of allowing attacker-controlled allocation or
   traversal. The exported checks make both sides of every boundary directly
   testable without constructing a maximum-sized valid repository. -}

-- HTTP/1.1 framing policy. The raw ceiling includes the request line,
-- header/trailer framing, chunk metadata, and decoded body bytes.
export
maxHttpRequestBytes : Int
maxHttpRequestBytes = 6291456

export
maxHttpHeaderBytes : Int
maxHttpHeaderBytes = 65536

export
maxHttpBodyBytes : Int
maxHttpBodyBytes = 5242880

export
maxHttpRequestLineBytes : Int
maxHttpRequestLineBytes = 8192

export
maxHttpHeaderFields : Int
maxHttpHeaderFields = 100

export
maxHttpTrailerFields : Int
maxHttpTrailerFields = 32

export
maxHttpChunks : Int
maxHttpChunks = 65536

-- Pinned PDS endpoint body policy. These limits are deliberately separate
-- from HTTP framing: callers can test endpoint policy without allocating a
-- maximum-sized request body.
export
maxJsonBodyBytes : Int
maxJsonBodyBytes = 153600

export
maxTextBodyBytes : Int
maxTextBodyBytes = 102400

export
maxRawBodyBytes : Int
maxRawBodyBytes = 5242880

export
checkHttpRequestBytes : Int -> Result String Unit
checkHttpRequestBytes size =
  if size > maxHttpRequestBytes then
    Err "http: request exceeds 6291456-byte resource limit"
  else
    Ok ()

export
checkHttpHeaderBytes : Int -> Result String Unit
checkHttpHeaderBytes size =
  if size > maxHttpHeaderBytes then
    Err "http: combined header and trailer section exceeds 65536-byte resource limit"
  else
    Ok ()

export
checkHttpBodyBytes : Int -> Result String Unit
checkHttpBodyBytes size =
  if size > maxHttpBodyBytes then
    Err "http: decoded body exceeds 5242880-byte resource limit"
  else
    Ok ()

export
checkHttpRequestLineBytes : Int -> Result String Unit
checkHttpRequestLineBytes size =
  if size > maxHttpRequestLineBytes then
    Err "http: request line exceeds 8192-byte resource limit"
  else
    Ok ()

export
checkHttpHeaderFields : Int -> Result String Unit
checkHttpHeaderFields count =
  if count > maxHttpHeaderFields then
    Err "http: header field count exceeds 100 resource limit"
  else
    Ok ()

export
checkHttpTrailerFields : Int -> Result String Unit
checkHttpTrailerFields count =
  if count > maxHttpTrailerFields then
    Err "http: trailer field count exceeds 32 resource limit"
  else
    Ok ()

export
checkHttpChunks : Int -> Result String Unit
checkHttpChunks count =
  if count > maxHttpChunks then
    Err "http: chunk count exceeds 65536 resource limit"
  else
    Ok ()

export
checkJsonBodyBytes : Int -> Result String Unit
checkJsonBodyBytes size =
  if size > maxJsonBodyBytes then
    Err "http: JSON body exceeds 153600-byte resource limit"
  else
    Ok ()

export
checkTextBodyBytes : Int -> Result String Unit
checkTextBodyBytes size =
  if size > maxTextBodyBytes then
    Err "http: text body exceeds 102400-byte resource limit"
  else
    Ok ()

export
checkRawBodyBytes : Int -> Result String Unit
checkRawBodyBytes size =
  if size > maxRawBodyBytes then
    Err "http: raw body exceeds 5242880-byte resource limit"
  else
    Ok ()

export
maxCarBytes : Int
maxCarBytes = 67108864

export
maxCarSectionBytes : Int
maxCarSectionBytes = 4194304

export
maxCarBlocks : Int
maxCarBlocks = 100000

export
maxMstBlocks : Int
maxMstBlocks = 100000

export
maxMstNodeBytes : Int
maxMstNodeBytes = 4194304

export
maxMstNodeEntries : Int
maxMstNodeEntries = 256

export
maxMstTraversalDepth : Int
maxMstTraversalDepth = 128

export
checkCarBytes : Int -> Result String Unit
checkCarBytes size =
  if size > maxCarBytes then
    Err "car: container exceeds 67108864-byte resource limit"
  else
    Ok ()

export
checkCarSectionBytes : Int -> Result String Unit
checkCarSectionBytes size =
  if size > maxCarSectionBytes then
    Err "car: section exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkCarBlocks : Int -> Result String Unit
checkCarBlocks count =
  if count > maxCarBlocks then
    Err "car: block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstBlocks : Int -> Result String Unit
checkMstBlocks count =
  if count > maxMstBlocks then
    Err "mst: node block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstNodeBytes : Int -> Result String Unit
checkMstNodeBytes size =
  if size > maxMstNodeBytes then
    Err "mst: node exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkMstNodeEntries : Int -> Result String Unit
checkMstNodeEntries count =
  if count > maxMstNodeEntries then
    Err "mst: node entry count exceeds 256 resource limit"
  else
    Ok ()

export
checkMstTraversalDepth : Int -> Result String Unit
checkMstTraversalDepth depth =
  if depth > maxMstTraversalDepth then
    Err "mst: traversal depth exceeds 128 resource limit"
  else
    Ok ()
