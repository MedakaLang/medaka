{- | Central resource ceilings for untrusted repository and atproto data.

   The pure in-memory Phase 1 implementation deliberately rejects containers
   beyond these bounds instead of allowing attacker-controlled allocation or
   traversal. The exported checks make both sides of every boundary directly
   testable without constructing a maximum-sized valid repository.

   Inbound HTTP framing and endpoint-body ceilings are not here: they belong
   to the codec that enforces them and live in `stdlib/http.mdk` as its own
   `max*` and `check*` exports. The OUTBOUND direction — a response received
   from an off-box appview — is untrusted input by the same argument. Its
   decoded ceilings are compatibility aliases of `stdlib/http.mdk`'s shared
   codec; only the PDS wire-accumulation ceiling below remains local policy. -}

import http as H

-- Blob layer policy. Distinct from `http.maxRawBodyBytes`: that is the outer
-- HTTP raw-body framing ceiling (`stdlib/http.mdk`'s `RawBody`), enforced
-- before a body is even attributed to an endpoint. `maxBlobBytes` is the
-- protocol-level per-blob cap `pds/lib/blob.mdk`'s admission function
-- enforces; today it equals the framing ceiling because nothing yet needs
-- them to diverge, but a future endpoint-specific policy can move one
-- without moving the other.
export
maxBlobBytes : Int
maxBlobBytes = 5242880

export
maxAccountBlobBytes : Int
maxAccountBlobBytes = 104857600

export
checkBlobBytes : Int -> Result String Unit
checkBlobBytes size =
  if size > maxBlobBytes then
    Err "blob: exceeds 5242880-byte per-blob resource limit"
  else
    Ok ()

export
checkAccountBlobBytes : Int -> Result String Unit
checkAccountBlobBytes size =
  if size > maxAccountBlobBytes then
    Err "blob: account blob usage exceeds 104857600-byte resource limit"
  else
    Ok ()

export
maxCarBytes : Int
maxCarBytes = 67108864

export
maxCarSectionBytes : Int
maxCarSectionBytes = 4194304

export
maxCarBlocks : Int
maxCarBlocks = 100000

export
maxMstBlocks : Int
maxMstBlocks = 100000

export
maxMstNodeBytes : Int
maxMstNodeBytes = 4194304

export
maxMstNodeEntries : Int
maxMstNodeEntries = 256

export
maxMstTraversalDepth : Int
maxMstTraversalDepth = 128

{- | The nesting ceiling both directions of `pds/lib/dagcbor.mdk` enforce. It
   is a ceiling on the decoder's recursion, so the encoder must refuse the
   same values: bytes that module produced but cannot read back would be a
   record committed to a repository that no read path can ever return. -}
export
maxDagCborDepth : Int
maxDagCborDepth = 128

export
checkCarBytes : Int -> Result String Unit
checkCarBytes size =
  if size > maxCarBytes then
    Err "car: container exceeds 67108864-byte resource limit"
  else
    Ok ()

export
checkCarSectionBytes : Int -> Result String Unit
checkCarSectionBytes size =
  if size > maxCarSectionBytes then
    Err "car: section exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkCarBlocks : Int -> Result String Unit
checkCarBlocks count =
  if count > maxCarBlocks then
    Err "car: block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstBlocks : Int -> Result String Unit
checkMstBlocks count =
  if count > maxMstBlocks then
    Err "mst: node block count exceeds 100000 resource limit"
  else
    Ok ()

export
checkMstNodeBytes : Int -> Result String Unit
checkMstNodeBytes size =
  if size > maxMstNodeBytes then
    Err "mst: node exceeds 4194304-byte resource limit"
  else
    Ok ()

export
checkMstNodeEntries : Int -> Result String Unit
checkMstNodeEntries count =
  if count > maxMstNodeEntries then
    Err "mst: node entry count exceeds 256 resource limit"
  else
    Ok ()

export
checkMstTraversalDepth : Int -> Result String Unit
checkMstTraversalDepth depth =
  if depth > maxMstTraversalDepth then
    Err "mst: traversal depth exceeds 128 resource limit"
  else
    Ok ()

export
checkDagCborDepth : Int -> Result String Unit
checkDagCborDepth depth =
  if depth > maxDagCborDepth then
    Err "dagcbor: nesting depth exceeds 128 resource limit"
  else
    Ok ()

-- Rate limiting policy. One shared window across the five limit
-- classes `pds/lib/ratelimit.mdk` defines; each class keeps its own
-- allowance within that window.
export
rateLimitWindowSeconds : Int
rateLimitWindowSeconds = 60

-- Row-count ceiling on each `pds/lib/ratelimit.mdk` window table: bounds how
-- many distinct identities one window can track, not any class's per-identity
-- allowance.
export
maxRateLimitIdentitiesPerWindow : Int
maxRateLimitIdentitiesPerWindow = 5000

export
maxConnectionsPerWindow : Int
maxConnectionsPerWindow = 120

export
maxRequestsPerWindow : Int
maxRequestsPerWindow = 3000

-- Placeholder pending real traffic data, like its three siblings above and
-- below. Two independent constraints bound it. A signed write costs an MST
-- update, a commit signature and a disk persist, so the ceiling belongs far
-- enough below what one window can physically absorb that a caller hits the
-- limit rather than the work. And a write ceiling a flood cannot reach
-- inside one window is unobservable by construction — the count resets
-- mid-flood, so nothing can ever witness the refusal; driving 301 writes
-- takes ~72s against this 60s window, which is what rules out a ceiling in
-- the hundreds until either the window or the per-write cost changes.
export
maxWritesPerWindow : Int
maxWritesPerWindow = 60

export
maxCreateSessionPerWindow : Int
maxCreateSessionPerWindow = 30

{- | The whole-repository export ceiling (`com.atproto.sync.getRepo` and
   `com.atproto.sync.getBlocks` — `pds/lib/ratelimit.mdk`'s `isRepoExportNsid`
   is the list), which
   `maxRequestsPerWindow` cannot express: one export's response is bounded
   only by `maxCarBytes`, so the request count and the bytes it authorizes are
   different quantities and the larger one has to be named separately.

   The ceiling times `maxCarBytes` is the egress one identity may nominally
   demand from this route in one window. At 100 that is 6.25 GiB per 60-second
   window — about 900 Mbit/s sustained, one gigabit link — where the shared
   `maxRequestsPerWindow` of 3000 would authorize 187 GiB, past any link this
   process could be reached over. The ceiling is also low enough to be
   reachable inside one window, without which no refusal is observable: the
   count resets mid-flood and nothing witnesses it. -}
export
maxRepoExportsPerWindow : Int
maxRepoExportsPerWindow = 100

{- | Ceilings on the inbound `X-Forwarded-For` header itself, enforced
   by `pds/lib/ratelimit.mdk`. The framing-level `stdlib/http.mdk`
   header-section cap bounds the WHOLE header block, not any one header's
   share of it, so a single comma-separated value can still arrive holding
   thousands of short tokens within that shared budget — cheap on the wire,
   but each one is a substring the split allocates and a candidate the parse
   then walks.

   The byte ceiling is checked on the RAW header bytes, ahead of both the
   UTF-8 decode and the split, because those are the work it exists to bound.
   The token ceiling is checked on the split's result, the only place a token
   count exists at all — so what it bounds is the WALK over the tokens, and
   what bounds the split itself is the byte ceiling above it. Violating
   either refuses the request rather than demoting it to the shared bucket.
   A real proxy chain is a handful of hops; neither ceiling is reachable by
   one. -}
export
maxXffHeaderBytes : Int
maxXffHeaderBytes = 4096

export
maxXffTokens : Int
maxXffTokens = 64

export
checkXffHeaderBytes : Int -> Result String Unit
checkXffHeaderBytes size =
  if size > maxXffHeaderBytes then
    Err "x-forwarded-for: header exceeds 4096-byte resource limit"
  else
    Ok ()

export
checkXffTokens : Int -> Result String Unit
checkXffTokens count =
  if count > maxXffTokens then
    Err "x-forwarded-for: token count exceeds 64 resource limit"
  else
    Ok ()

{- | The ceiling on proxied appview reads, which
   `maxRequestsPerWindow` cannot express for the reason
   `maxRepoExportsPerWindow` above it cannot: the quantity this bounds is not
   requests this server answers but requests this server MAKES. One inbound
   proxied read becomes one outbound connection, one outbound request and up to
   `maxHttpClientBodyBytes` of response to decode, so a proxied route is an
   amplifier and the shared request allowance of 3000 would authorize 3000
   amplifications per window.

   Sixty is reachable inside one window, without which no refusal is observable
   — the count resets mid-flood and nothing witnesses it — and a loopback round
   trip to the egress proxy is milliseconds, so reaching it costs no real wall
   time. It is also the allowance a signed write gets, which is the right
   company: both spend work a plain read does not. -}
export
maxProxiedCallsPerWindow : Int
maxProxiedCallsPerWindow = 60

{- | Compatibility names for the shared HTTP response ceilings. A response
   from an off-box appview is untrusted input; `stdlib/http.mdk` enforces these
   while the PDS socket layer separately enforces `maxHttpClientWireBytes`. -}
export
maxHttpClientStatusLineBytes : Int
maxHttpClientStatusLineBytes = H.maxHttpResponseStatusLineBytes

export
maxHttpClientHeaderBytes : Int
maxHttpClientHeaderBytes = H.maxHttpHeaderBytes

export
maxHttpClientHeaderFields : Int
maxHttpClientHeaderFields = H.maxHttpHeaderFields

-- | The ceiling on one chunk's declared size, independent of how many bytes
-- of the decoded body have accumulated so far — a single chunk-size line
-- claiming an enormous size is rejected before any attempt to buffer it,
-- rather than only once the running total crosses `maxHttpClientBodyBytes`.
export
maxHttpClientChunkBytes : Int
maxHttpClientChunkBytes = H.maxHttpResponseChunkBytes

export
maxHttpClientChunks : Int
maxHttpClientChunks = H.maxHttpChunks

export
maxHttpClientBodyBytes : Int
maxHttpClientBodyBytes = H.maxHttpBodyBytes

export
checkHttpClientStatusLineBytes : Int -> Result String Unit
checkHttpClientStatusLineBytes size =
  match H.checkHttpResponseStatusLineBytes size
    Ok () => Ok ()
    Err _ => Err "httpclient: status line exceeds 8192-byte resource limit"

export
checkHttpClientHeaderBytes : Int -> Result String Unit
checkHttpClientHeaderBytes size = match H.checkHttpHeaderBytes size
  Ok () => Ok ()
  Err _ =>
    Err
      "httpclient: combined header and trailer section exceeds 65536-byte resource limit"

export
checkHttpClientHeaderFields : Int -> Result String Unit
checkHttpClientHeaderFields count = match H.checkHttpHeaderFields count
  Ok () => Ok ()
  Err _ => Err "httpclient: header field count exceeds 100 resource limit"

export
checkHttpClientChunkBytes : Int -> Result String Unit
checkHttpClientChunkBytes size = match H.checkHttpResponseChunkBytes size
  Ok () => Ok ()
  Err _ => Err "httpclient: chunk size exceeds 1048576-byte resource limit"

{- | `pds/test/protocol_all_engines.sh` cannot drive this ceiling through an
   actual chunked response the way it does the others: exceeding it needs
   65537 chunk-head parses, and `pds/lib/httpclient.mdk`'s chunked decoder
   recurses once per chunk with no tail-call optimisation in the eval
   engine (`E-STACK-OVERFLOW` past ~25000 call depth). This doctest is the
   only place the ceiling's excess side is exercised.

   > isErr (checkHttpClientChunks (maxHttpClientChunks + 1))
   True -}
export
checkHttpClientChunks : Int -> Result String Unit
checkHttpClientChunks count = match H.checkHttpChunks count
  Ok () => Ok ()
  Err _ => Err "httpclient: chunk count exceeds 65536 resource limit"

export
checkHttpClientBodyBytes : Int -> Result String Unit
checkHttpClientBodyBytes size = match H.checkHttpBodyBytes size
  Ok () => Ok ()
  Err _ => Err "httpclient: decoded body exceeds 5242880-byte resource limit"

{- | How many bytes of one upstream response a reader may accumulate before the
   codec has seen any of them.

   It is a SUM of the ceilings above, not a second copy of any of them, and it
   exists because they are all ceilings on DECODED quantities: the codec grades
   a complete buffer, so something has to bound the buffer while it is still
   arriving, and that something is necessarily on the socket side where no
   decoded length is known yet. A reader that waited for the codec's verdict
   would let a drip-feeding peer grow a buffer without bound — the same
   unbounded-read defect this project already paid for on the inbound side.

   The chunk allowance is what makes it a sum rather than just the body
   ceiling: a chunked body carries a size line and a CRLF per chunk, and
   `maxHttpClientChunks` of them is framing the decoded body length does not
   account for. Sixteen bytes per chunk covers a size line of any width a chunk
   this codec admits can have. -}
export
maxHttpClientWireBytes : Int
maxHttpClientWireBytes =
  maxHttpClientStatusLineBytes
    + maxHttpClientHeaderBytes
    + maxHttpClientBodyBytes
    + maxHttpClientChunks * 16
