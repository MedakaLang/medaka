{- | Pure signed version-3 atproto repositories.

   Every mutation returns a fresh state.  Record, MST, and commit blocks cross
   the verified blockstore boundary before the state becomes observable. -}

import list.{reverse}
import string.{startsWith, toUtf8}
import lib.blockstore.{
  BlockStore,
  blockStoreAddMany,
  blockStoreEmpty,
  blockStoreGet,
  blockStorePut,
}
import lib.car.{carEncode}
import lib.cid.{Cid, cidEqual, cidForDagCbor}
import lib.dagcbor.{DagCbor(..), dagCborDecode, dagCborEncode}
import lib.mst.{
  Mst,
  mstDelete,
  mstEmpty,
  mstEntries,
  mstInsert,
  mstLookup,
  mstNodeBlocks,
  mstReplace,
  mstRootCid,
}
import lib.sha256.{sha256}
import lib.sign.{
  PublicKey,
  SecretKey,
  Signature,
  publicKeyForSecret,
  secretKeyFromBytes,
  signDigest,
  signatureCompact,
  signatureFromCompact,
  verifyDigest,
}
import lib.tid.{Tid, tidCompare, tidParse, tidToString}

-- | Immutable metadata for one signed repository commit.
export data RepoCommit =
  | RepoCommit Tid Cid Cid (Array Int) (Array Int) Signature

-- | Immutable repository state; its representation is private.
export data Repo = Repo String SecretKey PublicKey Mst BlockStore RepoCommit

-- | A successful mutation returns both its new state and new commit metadata.
export data RepoMutation = RepoMutation Repo RepoCommit

validBytes : Array Int -> Int -> Bool
validBytes bytes i =
  if i >= arrayLength bytes then
    True
  else
    bytes[i] >= 0 && bytes[i] <= 255 && validBytes bytes (i + 1)

lowerByte : Int -> Bool
lowerByte byte = byte >= 97 && byte <= 122

upperByte : Int -> Bool
upperByte byte = byte >= 65 && byte <= 90

digitByte : Int -> Bool
digitByte byte = byte >= 48 && byte <= 57

alphaByte : Int -> Bool
alphaByte byte = lowerByte byte || upperByte byte

alphaNumericByte : Int -> Bool
alphaNumericByte byte = alphaByte byte || digitByte byte

hexByte : Int -> Bool
hexByte byte = digitByte byte
  || byte >= 65 && byte <= 70
  || byte >= 97 && byte <= 102

didMethodEnd : Array Int -> Int -> Option Int
didMethodEnd bytes i =
  if i >= arrayLength bytes then
    None
  else if bytes[i] == 58 then
    Some i
  else if lowerByte bytes[i] then
    didMethodEnd bytes (i + 1)
  else
    None

didIdentifierByte : Int -> Bool
didIdentifierByte byte = alphaNumericByte byte
  || byte == 46
  || byte == 95
  || byte == 58
  || byte == 37
  || byte == 45

validDidIdentifier : Array Int -> Int -> Bool
validDidIdentifier bytes i =
  if i >= arrayLength bytes then
    True
  else if bytes[i] == 37 then
    i + 2 < arrayLength bytes && hexByte bytes[i + 1] && hexByte bytes[i + 2] && validDidIdentifier bytes (i + 3)
  else
    didIdentifierByte bytes[i] && validDidIdentifier bytes (i + 1)

validDidLastByte : Int -> Bool
validDidLastByte byte = alphaNumericByte byte
  || byte == 46
  || byte == 95
  || byte == 45

validateDid : String -> Result String Unit
validateDid did =
  let bytes = toUtf8 did
  if not (startsWith "did:" did) then Err "repo: invalid DID; expected did:<method>:<identifier>"
  else
    if arrayLength bytes > 2048 then Err "repo: invalid DID; maximum length is 2048 characters"
    else match didMethodEnd bytes 4
      None => Err "repo: invalid DID method"
      Some end =>
        if end == 4 || end + 1 >= arrayLength bytes || not (validDidIdentifier bytes (end + 1)) || not (validDidLastByte bytes[arrayLength bytes - 1]) then
          Err "repo: invalid DID identifier"
        else
          Ok ()

findPathSlash : Array Int -> Int -> Int -> Result String Int
findPathSlash path i slash =
  if i >= arrayLength path then
    if slash < 0 then Err "repo: path must contain exactly one slash" else Ok slash
  else if path[i] == 47 then
    if slash >= 0 then Err "repo: path must contain exactly one slash" else findPathSlash path (i + 1) i
  else
    findPathSlash path (i + 1) slash

validAuthorityBytes : Array Int -> Int -> Int -> Bool
validAuthorityBytes path i end =
  if i >= end then
    True
  else
    (lowerByte path[i] || digitByte path[i] || path[i] == 45) && validAuthorityBytes path (i + 1) end

validateAuthoritySegment : Array Int -> Int -> Int -> Bool -> Result String Unit
validateAuthoritySegment path start end first =
  let size = end - start
  if size < 1 || size > 63 then
    Err "repo: invalid collection NSID authority segment length"
  else if path[start] == 45 || path[end - 1] == 45 then
    Err "repo: invalid collection NSID authority segment hyphen"
  else if first && digitByte path[start] then
    Err "repo: invalid collection NSID top-level segment"
  else if not (validAuthorityBytes path start end) then
    Err "repo: collection NSID authority must be normalized lowercase ASCII"
  else
    Ok ()

validateAuthority : Array Int -> Int -> Int -> Int -> Int -> Result String Int
validateAuthority path i end segmentStart segments =
  if i >= end then do
    () <- validateAuthoritySegment path segmentStart end (segments == 0)
    Ok (segments + 1)
  else
    if path[i] == 46 then do
      () <- validateAuthoritySegment path segmentStart i (segments == 0)
      validateAuthority path (i + 1) end (i + 1) (segments + 1)
    else validateAuthority path (i + 1) end segmentStart segments

lastDotBefore : Array Int -> Int -> Int -> Int -> Int
lastDotBefore path i end last =
  if i >= end then
    last
  else if path[i] == 46 then
    lastDotBefore path (i + 1) end i
  else
    lastDotBefore path (i + 1) end last

validNameBytes : Array Int -> Int -> Int -> Bool
validNameBytes path i end =
  if i >= end then
    True
  else
    alphaNumericByte path[i] && validNameBytes path (i + 1) end

validateCollectionName : Array Int -> Int -> Int -> Result String Unit
validateCollectionName path start end =
  let size = end - start
  if size < 1 || size > 63 then
    Err "repo: invalid collection NSID name length"
  else if digitByte path[start] || not (alphaByte path[start]) then
    Err "repo: invalid collection NSID name start"
  else if not (validNameBytes path start end) then
    Err "repo: invalid collection NSID name characters"
  else
    Ok ()

validateCollection : Array Int -> Int -> Result String Unit
validateCollection path end =
  if end > 317 then Err "repo: collection NSID exceeds 317 characters"
  else
    let lastDot = lastDotBefore path 0 end (-1)
    if lastDot <= 0 || lastDot >= end - 1 then Err "repo: collection must be a valid normalized NSID"
    else
      if lastDot > 253 then Err "repo: collection NSID authority exceeds 253 characters"
      else do
        segments <- validateAuthority path 0 lastDot 0 0
        if segments < 2 then
          Err "repo: collection NSID authority needs at least two segments"
        else
          validateCollectionName path (lastDot + 1) end

rkeyByte : Int -> Bool
rkeyByte byte = alphaNumericByte byte
  || byte == 46
  || byte == 45
  || byte == 95
  || byte == 58
  || byte == 126

validRkeyBytes : Array Int -> Int -> Bool
validRkeyBytes path i =
  if i >= arrayLength path then
    True
  else
    rkeyByte path[i] && validRkeyBytes path (i + 1)

validateRkey : Array Int -> Int -> Result String Unit
validateRkey path start =
  let size = arrayLength path - start
  if size < 1 || size > 512 then
    Err "repo: record key length must be 1..512 characters"
  else if size == 1 && path[start] == 46 then
    Err "repo: record key must not be . or .."
  else if size == 2 && path[start] == 46 && path[start + 1] == 46 then
    Err "repo: record key must not be . or .."
  else if not (validRkeyBytes path start) then
    Err "repo: invalid record key characters"
  else
    Ok ()

validatePath : Array Int -> Result String Unit
validatePath path =
  if arrayLength path == 0 then Err "repo: path must be non-empty"
  else
    if not (validBytes path 0) then Err "repo: path element outside byte range 0..255"
    else do
      slash <- findPathSlash path 0 (-1)
      if slash <= 0 || slash >= arrayLength path - 1 then Err "repo: path must be collection/rkey"
      else do
        () <- validateCollection path slash
        validateRkey path (slash + 1)

validateRecord : DagCbor -> Result String Unit
validateRecord (DcMap _) = Ok ()
validateRecord _ = Err "repo: record must be a DAG-CBOR map"

unsignedValue : String -> Cid -> Tid -> DagCbor
unsignedValue did dataCid rev = DcMap
  [
    ("did", DcString did),
    ("version", DcInt 3),
    ("data", DcLink dataCid),
    ("rev", DcString (tidToString rev)),
    ("prev", DcNull),
  ]

signedValue : String -> Cid -> Tid -> Signature -> DagCbor
signedValue did dataCid rev signature = DcMap
  [
    ("did", DcString did),
    ("version", DcInt 3),
    ("data", DcLink dataCid),
    ("rev", DcString (tidToString rev)),
    ("prev", DcNull),
    ("sig", DcBytes (signatureCompact signature)),
  ]

encodeCommit : String -> DagCbor -> Result String (Array Int)
encodeCommit label value = match dagCborEncode value
  Err message => Err "repo: {label} commit encoding failed: {message}"
  Ok bytes => Ok bytes

buildCommit : String -> SecretKey -> Tid -> Mst -> BlockStore -> Result String (RepoCommit, BlockStore)
buildCommit did secret rev tree store = do
  unsigned <- encodeCommit "unsigned" (unsignedValue did (mstRootCid tree) rev)
  signature <- match signDigest secret (sha256 unsigned)
    Err message => Err "repo: signing failed: {message}"
    Ok value => Ok value
  signed <- encodeCommit "signed" (signedValue did (mstRootCid tree) rev signature)
  let commitCid = cidForDagCbor signed
  withTree <- match blockStoreAddMany (mstNodeBlocks tree) store
    Err message => Err "repo: storing MST failed: {message}"
    Ok value => Ok value
  complete <- match blockStorePut commitCid signed withTree
    Err message => Err "repo: storing commit failed: {message}"
    Ok value => Ok value
  Ok
    (
      RepoCommit rev (mstRootCid tree) commitCid unsigned signed signature,
      complete,
    )

-- | Initialize an empty repository at an explicit deterministic revision.
export
repoInit : String -> SecretKey -> Tid -> Result String Repo
repoInit did secret rev = do
  () <- validateDid did
  (commit, store) <- buildCommit did secret rev mstEmpty blockStoreEmpty
  Ok (Repo did secret (publicKeyForSecret secret) mstEmpty store commit)

-- | Key-byte convenience boundary; malformed signing keys fail loudly.
export
repoInitFromKeyBytes : String -> Array Int -> Tid -> Result String Repo
repoInitFromKeyBytes did keyBytes rev = match secretKeyFromBytes keyBytes
  Err message => Err "repo: bad signing key: {message}"
  Ok secret => repoInit did secret rev

repoCommitRev : RepoCommit -> Tid
repoCommitRev (RepoCommit rev _ _ _ _ _) = rev

-- | Latest commit metadata.
export
repoLatestCommit : Repo -> RepoCommit
repoLatestCommit (Repo _ _ _ _ _ commit) = commit

-- | Revision of commit metadata.
export
repoCommitTid : RepoCommit -> Tid
repoCommitTid = repoCommitRev

-- | Data/MST root of commit metadata.
export
repoCommitDataCid : RepoCommit -> Cid
repoCommitDataCid (RepoCommit _ dataCid _ _ _ _) = dataCid

-- | Signed commit CID.
export
repoCommitCid : RepoCommit -> Cid
repoCommitCid (RepoCommit _ _ cid _ _ _) = cid

-- | Canonical unsigned bytes (the signed map with only `sig` omitted).
export
repoCommitUnsignedBytes : RepoCommit -> Array Int
repoCommitUnsignedBytes (RepoCommit _ _ _ bytes _ _) = arrayCopy bytes

-- | Canonical signed commit bytes.
export
repoCommitSignedBytes : RepoCommit -> Array Int
repoCommitSignedBytes (RepoCommit _ _ _ _ bytes _) = arrayCopy bytes

-- | Compact low-S signature.
export
repoCommitSignature : RepoCommit -> Signature
repoCommitSignature (RepoCommit _ _ _ _ _ signature) = signature

-- | Public verification key bound to the repository state.
export
repoPublicKey : Repo -> PublicKey
repoPublicKey (Repo _ _ publicKey _ _ _) = publicKey

-- | Latest immutable verified store.
export
repoStore : Repo -> BlockStore
repoStore (Repo _ _ _ _ store _) = store

-- | Latest MST root CID.
export
repoRootCid : Repo -> Cid
repoRootCid (Repo _ _ _ tree _ _) = mstRootCid tree

ensureNewer : Tid -> RepoCommit -> Result String Unit
ensureNewer next prior =
  if tidCompare next (repoCommitRev prior) == Gt then
    Ok ()
  else
    Err "repo: revision must be strictly monotonic"

finishMutation : String -> SecretKey -> PublicKey -> Tid -> Mst -> BlockStore -> Result String RepoMutation
finishMutation did secret publicKey rev tree store = do
  (commit, complete) <- buildCommit did secret rev tree store
  let repo = Repo did secret publicKey tree complete commit
  Ok (RepoMutation repo commit)

-- | Create a previously absent record.
export
repoCreate : Array Int -> DagCbor -> Tid -> Repo -> Result String RepoMutation
repoCreate path record rev (Repo did secret publicKey tree store prior) = do
  () <- validatePath path
  () <- validateRecord record
  () <- ensureNewer rev prior
  bytes <- match dagCborEncode record
    Err message => Err "repo: record encoding failed: {message}"
    Ok value => Ok value
  let recordCid = cidForDagCbor bytes
  withRecord <- match blockStorePut recordCid bytes store
    Err message => Err "repo: storing record failed: {message}"
    Ok value => Ok value
  nextTree <- match mstInsert path recordCid tree
    Err message => Err "repo: duplicate create: {message}"
    Ok value => Ok value
  finishMutation did secret publicKey rev nextTree withRecord

-- | Replace an existing record.
export
repoUpdate : Array Int -> DagCbor -> Tid -> Repo -> Result String RepoMutation
repoUpdate path record rev (Repo did secret publicKey tree store prior) = do
  () <- validatePath path
  () <- validateRecord record
  () <- ensureNewer rev prior
  bytes <- match dagCborEncode record
    Err message => Err "repo: record encoding failed: {message}"
    Ok value => Ok value
  let recordCid = cidForDagCbor bytes
  withRecord <- match blockStorePut recordCid bytes store
    Err message => Err "repo: storing record failed: {message}"
    Ok value => Ok value
  nextTree <- match mstReplace path recordCid tree
    Err message => Err "repo: missing update: {message}"
    Ok value => Ok value
  finishMutation did secret publicKey rev nextTree withRecord

-- | Delete an existing record.
export
repoDelete : Array Int -> Tid -> Repo -> Result String RepoMutation
repoDelete path rev (Repo did secret publicKey tree store prior) = do
  () <- validatePath path
  () <- ensureNewer rev prior
  nextTree <- match mstDelete path tree
    Err message => Err "repo: missing delete: {message}"
    Ok value => Ok value
  finishMutation did secret publicKey rev nextTree store

-- | Extract the new immutable state from a successful mutation.
export
repoMutationState : RepoMutation -> Repo
repoMutationState (RepoMutation repo _) = repo

-- | Extract the new commit metadata from a successful mutation.
export
repoMutationCommit : RepoMutation -> RepoCommit
repoMutationCommit (RepoMutation _ commit) = commit

-- | Look up and strictly decode one record.
export
repoLookup : Array Int -> Repo -> Result String (Option DagCbor)
repoLookup path (Repo _ _ _ tree store _) = do
  () <- validatePath path
  match mstLookup path tree
    None => Ok None
    Some cid => match blockStoreGet cid store
      None => Err "repo: missing graph record block"
      Some bytes => match dagCborDecode bytes
        Err message => Err "repo: invalid stored record: {message}"
        Ok value => Ok (Some value)

-- | List canonical path order with decoded current records.
export
repoList : Repo -> Result String (List (Array Int, Cid, DagCbor))
repoList (Repo _ _ _ tree store _) = listRecords (mstEntries tree) store []

listRecords : List (Array Int, Cid) -> BlockStore -> List (Array Int, Cid, DagCbor) -> Result String (List (Array Int, Cid, DagCbor))
listRecords [] _ acc = Ok (reverse acc)
listRecords ((path, cid)::rest) store acc = match blockStoreGet cid store
  None => Err "repo: missing graph record block"
  Some bytes => match dagCborDecode bytes
    Err message => Err "repo: invalid stored record: {message}"
    Ok value => listRecords rest store ((path, cid, value)::acc)

cidMember : Cid -> List Cid -> Bool
cidMember _ [] = False
cidMember wanted (cid::rest) = cidEqual wanted cid || cidMember wanted rest

addUnique : Cid -> List Cid -> List Cid
addUnique cid values = if cidMember cid values then values else values ++ [cid]

entryLinks : List DagCbor -> List Cid -> List Cid -> Result String (List Cid, List Cid)
entryLinks [] trees leaves = Ok (trees, leaves)
entryLinks ((DcMap [("k", DcBytes _), ("p", DcInt _), ("t", child), ("v", DcLink leaf)])::rest) trees leaves =
  let nextTrees = match child
    DcNull => trees
    DcLink cid => addUnique cid trees
    _ => trees
  match child
    DcNull => entryLinks rest nextTrees (addUnique leaf leaves)
    DcLink _ => entryLinks rest nextTrees (addUnique leaf leaves)
    _ => Err "repo: tampered graph node child"
entryLinks _ _ _ = Err "repo: tampered graph node entry"

nodeLinks : Array Int -> Result String (List Cid, List Cid)
nodeLinks bytes = match dagCborDecode bytes
  Err message => Err "repo: tampered graph node: {message}"
  Ok (DcMap [("e", DcArray entries), ("l", left)]) =>
    let initial = match left
      DcNull => Ok []
      DcLink cid => Ok [cid]
      _ => Err "repo: tampered graph left link"
    match initial
      Err message => Err message
      Ok trees => entryLinks entries trees []
  Ok _ => Err "repo: tampered graph node form"

walkNodes : List Cid -> BlockStore -> List (Cid, Array Int) -> List Cid -> Result String (List (Cid, Array Int), List Cid)
walkNodes [] _ blocks leaves = Ok (blocks, leaves)
walkNodes frontier store blocks leaves = match walkLayer frontier store [] leaves blocks
  Err message => Err message
  Ok (next, nextLeaves, nextBlocks) =>
    walkNodes next store nextBlocks nextLeaves

walkLayer : List Cid -> BlockStore -> List Cid -> List Cid -> List (Cid, Array Int) -> Result String (List Cid, List Cid, List (Cid, Array Int))
walkLayer [] _ next leaves blocks = Ok (next, leaves, blocks)
walkLayer (cid::rest) store next leaves blocks = match blockStoreGet cid store
  None => Err "repo: missing graph MST block"
  Some bytes => match nodeLinks bytes
    Err message => Err message
    Ok (children, foundLeaves) =>
      let mergedChildren = fold (acc child => addUnique child acc) next children
      let mergedLeaves = fold (acc leaf => addUnique leaf acc) leaves foundLeaves
      walkLayer
        rest
        store
        mergedChildren
        mergedLeaves
        (blocks ++ [(cid, bytes)])

recordBlocks : List Cid -> BlockStore -> List (Cid, Array Int) -> Result String (List (Cid, Array Int))
recordBlocks [] _ acc = Ok acc
recordBlocks (cid::rest) store acc = match blockStoreGet cid store
  None => Err "repo: missing graph record block"
  Some bytes => recordBlocks rest store (acc ++ [(cid, bytes)])

{- | Validate a commit root and export this implementation's deterministic order:
   commit, breadth-first MST nodes, then reachable record leaves. -}
export
repoExportGraph : Cid -> Array Int -> Cid -> BlockStore -> Result String (List (Cid, Array Int), Array Int)
repoExportGraph commitCid commitBytes dataRoot store = match blockStoreGet commitCid store
  None => Err "repo: missing graph commit block"
  Some storedCommit => if storedCommit /= commitBytes || not (cidEqual commitCid (cidForDagCbor commitBytes)) then Err "repo: tampered graph commit block"
  else match decodeSignedCommit commitBytes
    Err message => Err "repo: invalid graph commit: {message}"
    Ok (_, commitData, _, _) => if not (cidEqual commitData dataRoot) then Err "repo: commit data mismatch"
    else match walkNodes [dataRoot] store [] []
      Err message => Err message
      Ok (nodes, leaves) => match recordBlocks leaves store []
        Err message => Err message
        Ok records =>
          let blocks = (commitCid, arrayCopy commitBytes) :: nodes ++ records
          match carEncode [commitCid] blocks
            Err message => Err "repo: CAR export failed: {message}"
            Ok bytes => Ok (blocks, bytes)

-- | Deterministic full repository CAR bytes.
export
repoExportCar : Repo -> Result String (Array Int)
repoExportCar (Repo _ _ _ tree store (RepoCommit _ _ commitCid _ signed _)) =
  map snd (repoExportGraph commitCid signed (mstRootCid tree) store)

-- | Deterministic full repository CAR block order.
export
repoExportBlocks : Repo -> Result String (List (Cid, Array Int))
repoExportBlocks (Repo _ _ _ tree store (RepoCommit _ _ commitCid _ signed _)) = map fst (repoExportGraph commitCid signed (mstRootCid tree) store)

hasField : String -> List (String, DagCbor) -> Bool
hasField _ [] = False
hasField name ((key, _)::rest) = name == key || hasField name rest

decodeSignedCommit : Array Int -> Result String (String, Cid, Tid, Signature)
decodeSignedCommit bytes = match dagCborDecode bytes
  Err message => Err "repo: invalid commit CBOR: {message}"
  Ok (DcMap fields) => if not (hasField "prev" fields) then Err "repo: required prev field is missing"
  else match fields
    [("did", DcString did), ("rev", DcString revText), ("sig", DcBytes compact), ("data", DcLink dataCid), ("prev", DcNull), ("version", DcInt version)] => if version /= 3 then Err "repo: commit version mismatch"
    else do
      () <- validateDid did
      rev <- match tidParse revText
        Err message => Err "repo: invalid commit TID: {message}"
        Ok value => Ok value
      signature <- match signatureFromCompact compact
        Err message => Err "repo: invalid compact signature: {message}"
        Ok value => Ok value
      Ok (did, dataCid, rev, signature)
    _ => Err "repo: commit must contain exactly did, rev, sig, data, prev, version"
  Ok _ => Err "repo: commit must be a map"

{- | Strictly validate signed v3 commit bytes against expected state and
   return the admitted compact signature. -}
export
repoValidateCommit : String -> Cid -> Tid -> Array Int -> Result String Signature
repoValidateCommit expectedDid expectedData expectedRev bytes = do
  () <- validateDid expectedDid
  (did, dataCid, rev, signature) <- decodeSignedCommit bytes
  if not (cidEqual dataCid expectedData) then
    Err "repo: commit data mismatch"
  else if tidToString rev /= tidToString expectedRev then
    Err "repo: commit rev mismatch"
  else if did /= expectedDid then
    Err "repo: commit DID mismatch"
  else
    Ok signature

-- | Verify the canonical unsigned bytes and compact signature of metadata.
export
repoVerifyCommit : String -> PublicKey -> RepoCommit -> Bool
repoVerifyCommit did publicKey (RepoCommit rev dataCid _ unsigned signed signature) = match repoValidateCommit did dataCid rev signed
  Err _ => False
  Ok parsed => signatureCompact parsed == signatureCompact signature
    && verifyDigest publicKey (sha256 unsigned) signature
