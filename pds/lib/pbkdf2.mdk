{- | PBKDF2 key derivation with HMAC-SHA-256 (RFC 2898).

   A password, a salt and the derived key are each `Bytes`. The caller
   supplies the salt. Nothing here draws entropy or performs any I/O.

   This is the PDS's password KDF (`docs/design/ATPROTO-PDS-DESIGN.md`
   §4.2), not a general recommendation, which is why it is not in the
   stdlib: a new password store should prefer a memory-hard KDF.

   Every function that runs PBKDF2 iterations, here and in `lib.credential`,
   performs `Kdf`, so a row that pays for a password derivation says so. -}

import bytes.{Bytes}
import crypto.hmac.{HmacSha256Key, hmacSha256Key, hmacSha256WithKey}
import mut_bytes as MB
import mut_bytes.{MutBytes}
import u32 as U32
import u8 as U8

-- | Running PBKDF2 iterations: the deliberately expensive part of a password
-- derivation.
export effect Kdf

hashBytes : Int
hashBytes = 32

-- Big-endian 4-byte encoding of the PBKDF2 block index (RFC 2898 §5.2,
-- `INT (i)`). An index that does not fit 32 bits is refused rather than
-- reduced: two blocks of one key would otherwise share an index, and the
-- RFC stops with "derived key too long" there. The index is public, so the
-- checked conversion's branch reveals nothing.
export
int32Be : Int -> Bytes
int32Be n = match U32.tryFromInt n
  Some index => U32.toBytesBE index
  None =>
    panic
      "pbkdf2: block index \{n} is outside 0..4294967295; derived key too long"

xorInto : MutBytes -> Bytes -> Int -> Unit
xorInto acc u i =
  if i >= MB.length acc then
    ()
  else
    let () = MB.setInPlace i (U8.bitXor acc[i] u[i]) acc
    xorInto acc u (i + 1)

-- Folds U_2 .. U_iterations into `acc` (already seeded with U_1), each
-- `Uj = HMAC(P, U_{j-1})`, XORing every one in (RFC 2898 §5.2 `F`). `key`
-- is `password`'s `HmacSha256Key`, built once by the caller so every
-- iteration reuses the same precomputed ipad/opad compressions.
foldU : HmacSha256Key -> Int -> MutBytes -> Bytes -> Int -> MutBytes
foldU key iterations acc prevU j =
  if j >= iterations then
    acc
  else
    let u = hmacSha256WithKey key prevU
    let () = xorInto acc u 0
    foldU key iterations acc u (j + 1)

-- One 32-byte PBKDF2 block `T_blockIndex` (RFC 2898 §5.2 `F(P, S, c, i)`),
-- under the same `key` `foldU` reuses for every iteration.
pbkdf2Block : HmacSha256Key -> Bytes -> Int -> Int -> MutBytes
pbkdf2Block key salt iterations blockIndex =
  let u1 = hmacSha256WithKey key (salt ++ int32Be blockIndex)
  foldU key iterations (MB.thaw u1) u1 1

buildBlocks : HmacSha256Key ->
  Bytes ->
  Int ->
  Int ->
  Int ->
  MutBytes ->
  Int ->
  MutBytes
buildBlocks key salt iterations dkLen total out blockIndex =
  if blockIndex > total then
    out
  else
    let block = pbkdf2Block key salt iterations blockIndex
    let offset = (blockIndex - 1) * hashBytes
    let remaining = dkLen - offset
    let take = min remaining hashBytes
    let () = MB.blit block 0 out offset take
    buildBlocks key salt iterations dkLen total out (blockIndex + 1)

{- | The `dkLen`-byte key derived from `password` and `salt` over
   `iterations` rounds.

   Panics when `iterations` or `dkLen` is less than 1. -}
export
pbkdf2HmacSha256 : Bytes -> Bytes -> Int -> Int -> <Kdf> Bytes
pbkdf2HmacSha256 password salt iterations dkLen =
  if iterations < 1 then
    panic "pbkdf2: iterations must be >= 1"
  else if dkLen < 1 then
    panic "pbkdf2: dkLen must be >= 1"
  else
    let key = hmacSha256Key password
    let total = (dkLen + hashBytes - 1) / hashBytes
    MB.freeze (buildBlocks key salt iterations dkLen total (MB.make dkLen) 1)
