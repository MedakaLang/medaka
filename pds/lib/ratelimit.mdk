{- | Client-identity derivation and the pure rate-limit decision (#2612, PURE
   half only — nothing here is enforced; the shell wires this in next).

   The step function is `(state, identity, class, now) -> (state, verdict)`.
   `now` is a plain `Int` argument, never a `Clock` effect: `pds/lib/` may
   import no effect (`pds/test/lib_boundary.sh`), and threading time through
   the call is what keeps the decision itself testable at exact instants
   instead of by waiting on a real clock.

   SLIDING WINDOW over two fixed windows, not a token bucket and not one
   fixed window (#2775). A single fixed window admits the whole allowance
   just before `now / rateLimitWindowSeconds` changes and the whole
   allowance again just after, so a caller straddling a boundary draws twice
   the nominal rate over a window's worth of seconds while every counter
   reads as within budget. The decision here therefore charges the current
   window's own count PLUS the share of the previous window's count that has
   not yet slid out of view: at `elapsed` seconds into a window, that share
   is `(window - elapsed) / window` of it. A caller that spends its whole
   allowance at the end of one window is refused at the start of the next,
   and regains budget gradually as the boundary recedes.

   That costs one extra table, not a leak rate or per-tick refill state: the
   whole state per identity per class is still one counter, and the window
   index those counters belong to is held once for the pair of tables rather
   than once per row. Retirement stays exact AND free — the table two
   windows old is unreachable the instant the index moves, and it is dropped
   whole, in constant time, by the first decision of the new window. No
   decision ever walks a table.

   IDENTITY: the last hop of `X-Forwarded-For`, parsed only when the caller
   states the connection's peer is a configured trusted proxy — never from
   the socket peer itself, which is always the front proxy under P5 and
   which the runtime has no extern to read anyway. An untrusted peer, a
   missing header, or a last hop that is not IPv4/IPv6-shaped all fall back
   to one shared `direct` identity: a spoofable identity is worse than one
   shared bucket, because it hands an attacker every other client's bucket
   to evict. -}

import http.{Header, headerName, headerValue}
import list.{head, reverse}
import map.{Map(..), get, set}
import regex.{Regex, isFullMatch, mustCompile}
import string.{fromUtf8, split, trim}
import lib.nsid.{sameNsidIdentity}
import lib.resource_limits.{
  checkXffHeaderBytes,
  checkXffTokens,
  maxConnectionsPerWindow,
  maxCreateSessionPerWindow,
  maxProxiedCallsPerWindow,
  maxRepoExportsPerWindow,
  maxRequestsPerWindow,
  maxWritesPerWindow,
  rateLimitWindowSeconds,
}

-- | Opaque: the only way to produce one is `identifyClient`/`directIdentity`,
-- so a caller cannot manufacture an identity that bypassed trust checking.
export data ClientIdentity = ClientIdentity String

-- | The shared bucket for every request whose peer is untrusted, or whose
-- `X-Forwarded-For` is absent or unparseable.
export
directIdentity : ClientIdentity
directIdentity = ClientIdentity "direct"

-- | The bucket key this identity counts against — for logging/headers only;
-- the value is opaque data everywhere else in this module's own API.
export
identityLabel : ClientIdentity -> String
identityLabel (ClientIdentity label) = label

{- | `ProxyClass` is the one class whose cost is not this server's own work: a
   proxied read turns ONE inbound request into ONE outbound request to the
   appview plus up to `maxHttpClientBodyBytes` of response to decode, so its
   count and the shared request count are different quantities and the
   amplifying one needs naming separately — exactly the argument
   `RepoExportClass` rests on, in the outbound direction. -}
public export data RateLimitClass =
  | ConnectionsClass
  | RequestsClass
  | WritesClass
  | CreateSessionClass
  | RepoExportClass
  | ProxyClass

public export data RateLimitVerdict = Admitted | Refused

{- | Opaque, resource-bounded: the `Int` is the window index the SECOND map
   belongs to, and the first map is the window before it. Rows are only ever
   written into the current-window table at the caller's own window index, so
   each table ages out whole. A decision one window on demotes the current
   table to previous and starts a fresh one; a decision further on than that
   starts from two empty tables — never one row per identity ever seen — and
   the bound is "at most one row per identity active in each of the two
   windows in view".

   The index is held once for the pair rather than once per row so that
   retirement costs one comparison instead of a walk: a per-row index forces
   whoever prunes to visit every row, which puts the count of OTHER clients
   seen this window into the cost of serving one request. -}
export data RateLimitState =
  | RateLimitState Int (Map String ClientCounters) (Map String ClientCounters)

data ClientCounters = ClientCounters Int Int Int Int Int Int
-- connections used, requests used, writes used, createSession used,
-- repo exports used, proxied calls used

-- | No window has been entered yet, so any first decision starts fresh: the
-- index cannot collide with a real `now / rateLimitWindowSeconds`, which is
-- never negative.
export
initRateLimitState : RateLimitState
initRateLimitState = RateLimitState (0 - 1) Tip Tip

export
classAllowance : RateLimitClass -> Int
classAllowance ConnectionsClass = maxConnectionsPerWindow
classAllowance RequestsClass = maxRequestsPerWindow
classAllowance WritesClass = maxWritesPerWindow
classAllowance CreateSessionClass = maxCreateSessionPerWindow
classAllowance RepoExportClass = maxRepoExportsPerWindow
classAllowance ProxyClass = maxProxiedCallsPerWindow

{- | The two tables in view at `windowIdx`, given the pair a state holds and
   the index they were written at: the same pair while the index has not
   moved, the current one demoted to previous one window on, and two empty
   tables once the state is older than that. -}
tablesInView : Int ->
  Int ->
  Map String ClientCounters ->
  Map String ClientCounters ->
  (Map String ClientCounters, Map String ClientCounters)
tablesInView stateWindow windowIdx previous current =
  if stateWindow == windowIdx then
    (previous, current)
  else if stateWindow + 1 == windowIdx then
    (current, Tip)
  else
    (Tip, Tip)

countersFor : String -> Map String ClientCounters -> ClientCounters
countersFor key table = match get key table
  Some counters => counters
  None => emptyCounters

{- | What one identity has spent on one class over the window ENDING at
   `elapsed` seconds into the current window: everything charged in this
   window, plus the fraction of the previous window still inside it.

   Integer arithmetic throughout, and the division truncates, so the carried
   share is never rounded up — the estimate errs toward admitting rather than
   toward refusing a caller who has not in fact exceeded anything. -}
slidingUsed : RateLimitClass -> Int -> ClientCounters -> ClientCounters -> Int
slidingUsed limitClass elapsed previous current =
  classUsed limitClass current
    + classUsed limitClass previous
      * (rateLimitWindowSeconds - elapsed)
      / rateLimitWindowSeconds

-- | The pure decision. Same identity, same class: refused while the sliding
-- count over the trailing window is at or past `classAllowance class`,
-- admitted again as the charges behind it slide out of view.
export
step : RateLimitState ->
  ClientIdentity ->
  RateLimitClass ->
  Int ->
  (RateLimitState, RateLimitVerdict)
step (RateLimitState stateWindow previousTable currentTable) (ClientIdentity key) limitClass now =
  let windowIdx = now / rateLimitWindowSeconds
  let elapsed = now % rateLimitWindowSeconds
  let (previous, current) =
    tablesInView stateWindow windowIdx previousTable currentTable
  let previousCounters = countersFor key previous
  let currentCounters = countersFor key current
  let used = slidingUsed limitClass elapsed previousCounters currentCounters
  if used >= classAllowance limitClass then
    (
      RateLimitState windowIdx previous (set key currentCounters current),
      Refused,
    )
  else
    (
      RateLimitState
        windowIdx
        previous
        (set key (bumpClass limitClass currentCounters) current),
      Admitted,
    )

emptyCounters : ClientCounters
emptyCounters = ClientCounters 0 0 0 0 0 0

classUsed : RateLimitClass -> ClientCounters -> Int
classUsed ConnectionsClass (ClientCounters c _ _ _ _ _) = c
classUsed RequestsClass (ClientCounters _ r _ _ _ _) = r
classUsed WritesClass (ClientCounters _ _ w _ _ _) = w
classUsed CreateSessionClass (ClientCounters _ _ _ s _ _) = s
classUsed RepoExportClass (ClientCounters _ _ _ _ x _) = x
classUsed ProxyClass (ClientCounters _ _ _ _ _ p) = p

bumpClass : RateLimitClass -> ClientCounters -> ClientCounters
bumpClass ConnectionsClass (ClientCounters c r wr s x p) =
  ClientCounters (c + 1) r wr s x p
bumpClass RequestsClass (ClientCounters c r wr s x p) =
  ClientCounters c (r + 1) wr s x p
bumpClass WritesClass (ClientCounters c r wr s x p) =
  ClientCounters c r (wr + 1) s x p
bumpClass CreateSessionClass (ClientCounters c r wr s x p) =
  ClientCounters c r wr (s + 1) x p
bumpClass RepoExportClass (ClientCounters c r wr s x p) =
  ClientCounters c r wr s (x + 1) p
bumpClass ProxyClass (ClientCounters c r wr s x p) =
  ClientCounters c r wr s x (p + 1)

-- | `RateLimit-Remaining` for a class, without mutating state: for response
-- headers, computed AFTER the `step` call it accompanies so it reflects the
-- count that call just admitted or refused. Applies `step`'s own sliding
-- count read-only, so the number a client is told matches the number the
-- next decision will act on.
export
remainingInClass : RateLimitState ->
  ClientIdentity ->
  RateLimitClass ->
  Int ->
  Int
remainingInClass (RateLimitState stateWindow previousTable currentTable) (ClientIdentity key) limitClass now =
  let windowIdx = now / rateLimitWindowSeconds
  let elapsed = now % rateLimitWindowSeconds
  let (previous, current) =
    tablesInView stateWindow windowIdx previousTable currentTable
  let used =
    slidingUsed
      limitClass
      elapsed
      (countersFor key previous)
      (countersFor key current)
  let remaining = classAllowance limitClass - used
  if remaining < 0 then 0 else remaining

-- | The write procedures a lower allowance applies to: they cost signing
-- work (or, for `uploadBlob`, disk), unlike a plain read.
export
isWriteNsid : String -> Bool
isWriteNsid nsid =
  sameNsidIdentity nsid "com.atproto.repo.createRecord"
    || sameNsidIdentity nsid "com.atproto.repo.putRecord"
    || sameNsidIdentity nsid "com.atproto.repo.deleteRecord"
    || sameNsidIdentity nsid "com.atproto.repo.applyWrites"
    || sameNsidIdentity nsid "com.atproto.repo.uploadBlob"

-- | `createSession` gets its own, lower allowance: it costs a
-- credential-guessing attempt, not just signing work.
export
isCreateSessionNsid : String -> Bool
isCreateSessionNsid nsid =
  sameNsidIdentity nsid "com.atproto.server.createSession"

{- | The procedures whose single response is a whole-repository CAR, and which
   therefore need `maxRepoExportsPerWindow` on top of the shared request
   allowance: one call's output is bounded by `maxCarBytes` alone, so a count
   of requests cannot bound what the route emits.

   `com.atproto.sync.getRepo` is the only such procedure today. A route that
   serializes the whole block graph belongs here; one that serializes a single
   record or blob does not, since each of those is already bounded per call by
   its own body ceiling. -}
export
isRepoExportNsid : String -> Bool
isRepoExportNsid nsid = sameNsidIdentity nsid "com.atproto.sync.getRepo"

{- | The operator's assertion that this process's peer is a configured trusted
   proxy (`--trusted-proxy`), carried as its own type rather than as a `Bool`.

   Every other per-request flag on the charging path is also a boolean, and one
   of them crossed with this one charges the wrong identity while every gate
   still passes. A distinct type is what makes that crossing a compile error
   instead of a silent mischarge, so this must not be collapsed back to `Bool`
   for brevity. -}
public export data TrustedProxy = TrustedProxy Bool

-- | Derive the caller's identity for this request. The trust assertion is
-- supplied by the caller (`--trusted-proxy`'s value, tested once at
-- configuration); this module never inspects a socket.
export
identifyClient : TrustedProxy -> List Header -> ClientIdentity
identifyClient (TrustedProxy isTrustedPeer) headers =
  if not isTrustedPeer then
    directIdentity
  else match xffLastHop headers
    Some address => ClientIdentity address
    None => directIdentity

isXffHeader : Header -> Bool
isXffHeader h = headerName h == "x-forwarded-for"

{- | Repeated `X-Forwarded-For` fields are one chain, not a contradiction: a
   reverse proxy APPENDS its view of the peer rather than replacing what it
   received, and RFC 7230 makes a repeated field equivalent to one
   comma-joined field in field order, which `http` preserves. So the last
   hop of the LAST field is the hop the nearest trusted proxy wrote, exactly
   as it is within a single field.

   Reading a second field as "malformed, use the shared bucket" would be an
   escape hatch rather than a penalty: the shared bucket is a DIFFERENT
   bucket, so a client whose own bucket was exhausted could win a fresh
   allowance by sending its address twice. -}
xffLastHop : List Header -> Option String
xffLastHop headers = match head (reverse (filter isXffHeader headers))
  Some nearest => lastHopToken (fromUtf8 (headerValue nearest))
  None => None

lastHopToken : String -> Option String
lastHopToken raw =
  if isErr (checkXffHeaderBytes (stringLength raw)) then
    None
  else
    let tokens = map trim (split "," raw)
    if isErr (checkXffTokens (length tokens)) then
      None
    else match head (reverse tokens)
      Some candidate =>
        if isAddressToken candidate then Some candidate else None
      None => None

isAddressToken : String -> Bool
isAddressToken token = isIPv4Address token || isIPv6Address token

-- One definition of a decimal octet, shared by the plain quad and the
-- IPv4-mapped tail below. Leading zeros are admitted: "007" is 7, and a
-- proxy that writes them is still naming an address.
decOctet : String
decOctet = "(?:25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])"

dottedQuad : String
dottedQuad = "\{decOctet}\\.\{decOctet}\\.\{decOctet}\\.\{decOctet}"

ipv4Re : Regex
ipv4Re = mustCompile dottedQuad

{- | Loose on purpose: this only has to reject non-address garbage
   ("not-an-address", empty, punctuation), not validate a fully compliant IPv6
   literal — the value is a rate-limit bucket key, not a routed address. So
   either arm is enough: hex-or-colon throughout with at least one colon, or
   hex-or-colon groups then a dotted quad.

   That second arm is the IPv4-mapped form a dual-stack proxy emits
   (`::ffff:198.51.100.7`). It is neither hex-only (the dots) nor a bare quad
   (the colons), so a check of only those two shapes rejects it — and
   rejecting it collapses every client behind such a proxy into the one shared
   `direct` bucket, turning the per-client limiter into a global one with the
   trust flag correctly set. -}
ipv6Re : Regex
ipv6Re =
  mustCompile "[0-9a-fA-F:]*:[0-9a-fA-F:]*|(?:[0-9a-fA-F]*:)+\{dottedQuad}"

isIPv4Address : String -> Bool
isIPv4Address token = isFullMatch ipv4Re token

isIPv6Address : String -> Bool
isIPv6Address token = isFullMatch ipv6Re token
