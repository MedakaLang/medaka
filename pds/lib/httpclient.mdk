{- | The pure PDS HTTP/1.1 client adapter. It serializes outbound requests and
   preserves the existing client vocabulary over `stdlib/http.mdk`'s shared
   inbound response parser. Response framing, chunk decoding, and decoded
   resource ceilings all live in that shared owner. -}

import array.{forEachWithIndex}
import bytebuilder.{Builder, buildArray, emitU8, newBuilder}
import http as H
import http.{
  Header,
  HttpMalformed,
  HttpResourceExcess,
  ParsedResponse,
  headerName,
  headerValue,
  isTokenByte,
}
import string.{toUtf8}

-- # Request bytes

validTargetByte : Array Int -> Int -> Int -> Bool -> Bool
validTargetByte input pos end query =
  if pos >= end then
    True
  else
    let byte = input[pos]
    if byte == 37 then
      pos + 2 < end
        && isSome (H.hexDigit input[pos + 1])
        && isSome (H.hexDigit input[pos + 2])
        && validTargetByte input (pos + 3) end query
    else
      let unreserved =
        byte >= 48 && byte <= 57
          || byte >= 65 && byte <= 90
          || byte >= 97 && byte <= 122
          || byte == 45
          || byte == 46
          || byte == 95
          || byte == 126
      let subDelimiter =
        byte == 33
          || byte == 36
          || byte == 38
          || byte == 39
          || byte == 40
          || byte == 41
          || byte == 42
          || byte == 43
          || byte == 44
          || byte == 59
          || byte == 61
      let pchar = unreserved || subDelimiter || byte == 58 || byte == 64
      if pchar || byte == 47 || query && byte == 63 then
        validTargetByte input (pos + 1) end query
      else if not query && byte == 63 then
        validTargetByte input (pos + 1) end True
      else
        False

validAsciiValue : Array Int -> Int -> Int -> Bool
validAsciiValue input i end =
  if i >= end then
    True
  else
    let byte = input[i]
    byte >= 32 && byte <= 126 && validAsciiValue input (i + 1) end

emitRequestBytes : Array Int -> Builder -> Unit
emitRequestBytes bytes out = forEachWithIndex (_ byte => emitU8 byte out) bytes

emitRequestText : String -> Builder -> Unit
emitRequestText text out = emitRequestBytes (toUtf8 text) out

-- # Headers

-- | The value of the first field named `name` (already lowercase), if any.
export
findHeader : String -> List Header -> Option (Array Int)
findHeader _ [] = None
findHeader wanted (header :: rest) =
  if headerName header == wanted then
    Some (headerValue header)
  else
    findHeader wanted rest

-- # Structural classification

-- | Structural classification for a codec failure. The diagnostic string is
-- retained for a plain caller (`parseResponse`); the split lets a caller that
-- cares choose retry-worthy (`HttpClientResourceExcess`) from not.
public export data HttpClientParseFailure =
  | HttpClientMalformed String
  | HttpClientResourceExcess String

-- | The diagnostic a failure carries, whichever class it is.
export
httpClientParseFailureMessage : HttpClientParseFailure -> String
httpClientParseFailureMessage (HttpClientMalformed message) = message
httpClientParseFailureMessage (HttpClientResourceExcess message) = message

-- # Requests

hasReservedRequestField : List Header -> Bool
hasReservedRequestField [] = False
hasReservedRequestField (header :: rest) =
  headerName header == "host"
    || headerName header == "content-length"
    || headerName header == "transfer-encoding"
    || hasReservedRequestField rest

-- | Construct a safe request field. The name is canonicalized to lowercase;
-- the value must be printable ASCII and therefore cannot smuggle a CR, LF, or
-- any other control byte into the framed request. No doctest here: `Header`
-- has no `Display` impl, matching `stdlib/http.mdk`'s analogous `makeHeader`,
-- which is undoctested for the same reason.
export
makeRequestHeader : String -> String -> Result String Header
makeRequestHeader name value =
  let nameBytes = toUtf8 name
  if arrayLength nameBytes == 0 || not (all isTokenByte nameBytes) then
    Err "httpclient: invalid request header field name"
  else
    let valueBytes = toUtf8 value
    if not (validAsciiValue valueBytes 0 (arrayLength valueBytes)) then
      Err "httpclient: control or non-ASCII byte in request header field value"
    else
      H.makeHeader name valueBytes

emitHeaders : List Header -> Builder -> Unit
emitHeaders [] _ = ()
emitHeaders (header :: rest) out =
  emitRequestText (headerName header) out
  emitRequestText ": " out
  emitRequestBytes (headerValue header) out
  emitRequestText "\r\n" out
  emitHeaders rest out

{- | Serialize a complete, origin-form HTTP/1.1 request: `method` (a token),
   `target` (an origin-form path, optionally with a query), `host` (the
   `Host` field's value), caller `headers` in their given order, then exactly
   one computed `content-length` — the serializer owns all framing, so a
   caller cannot supply `Host`, `Content-Length` or `Transfer-Encoding`
   itself.

   > serializeRequest "GET" "/xrpc/com.example.get" "127.0.0.1:8080" [] [||]
   Ok [|71, 69, 84, 32, 47, 120, 114, 112, 99, 47, 99, 111, 109, 46, 101, 120, 97, 109, 112, 108, 101, 46, 103, 101, 116, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 104, 111, 115, 116, 58, 32, 49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 56, 48, 56, 48, 13, 10, 99, 111, 110, 116, 101, 110, 116, 45, 108, 101, 110, 103, 116, 104, 58, 32, 48, 13, 10, 13, 10|] -}
export
serializeRequest : String ->
  String ->
  String ->
  List Header ->
  Array Int ->
  Result String (Array Int)
serializeRequest method target host headers body =
  let methodBytes = toUtf8 method
  let targetBytes = toUtf8 target
  let hostBytes = toUtf8 host
  if arrayLength methodBytes == 0 || not (all isTokenByte methodBytes) then
    Err "httpclient: invalid request method token"
  else if arrayLength targetBytes == 0
    || targetBytes[0] /= 47
    || not (validTargetByte targetBytes 0 (arrayLength targetBytes) False) then
    Err
      "httpclient: request target must be an origin-form ASCII target without a fragment"
  else if arrayLength hostBytes == 0
    || not (validAsciiValue hostBytes 0 (arrayLength hostBytes)) then
    Err "httpclient: invalid Host value"
  else if hasReservedRequestField headers then
    Err "httpclient: request framing fields are reserved"
  else if not (all (byte => byte >= 0 && byte <= 255) body) then
    Err "httpclient: request body element outside byte range 0..255"
  else
    let out = newBuilder ()
    emitRequestText method out
    emitRequestText " " out
    emitRequestText target out
    emitRequestText " HTTP/1.1\r\n" out
    emitRequestText "host: " out
    emitRequestText host out
    emitRequestText "\r\n" out
    emitHeaders headers out
    emitRequestText "content-length: " out
    emitRequestText (intToString (arrayLength body)) out
    emitRequestText "\r\n\r\n" out
    emitRequestBytes body out
    Ok (buildArray out)

-- # Response compatibility

-- | The shared parsed response under the name existing PDS callers use.
export type Response = ParsedResponse

export
responseStatus : Response -> Int
responseStatus = H.parsedResponseStatus

export
responseReason : Response -> String
responseReason = H.parsedResponseReason

export
responseHeaders : Response -> List Header
responseHeaders = H.parsedResponseHeaders

export
responseTrailers : Response -> List Header
responseTrailers = H.parsedResponseTrailers

export
responseBody : Response -> Array Int
responseBody = H.parsedResponseBody

export
responseBodyLength : Response -> Int
responseBodyLength = H.parsedResponseBodyLength

{- | Parse one complete HTTP response while retaining the PDS failure
   constructors used by policy callers. The framing work is owned by
   `stdlib/http.mdk`.

   Transfer-coding tokens, including `Chunked`, are ASCII
   case-insensitive. -}
export
parseResponseClassified : Array Int -> Result HttpClientParseFailure Response
parseResponseClassified input = match H.parseResponseClassified input
  Ok response => Ok response
  Err (HttpMalformed message) => Err (HttpClientMalformed message)
  Err (HttpResourceExcess message) => Err (HttpClientResourceExcess message)

-- | `parseResponseClassified` collapsed to its diagnostic string.
export
parseResponse : Array Int -> Result String Response
parseResponse input = match parseResponseClassified input
  Ok response => Ok response
  Err failure => Err (httpClientParseFailureMessage failure)

-- | The boundary of a complete declared-length or chunked response inside
-- `input[0, avail)`.
export
responseBoundaryWithin : Array Int -> Int -> Option Int
responseBoundaryWithin = H.responseBoundaryWithin

-- | `responseBoundaryWithin` over all bytes of `input`.
export
responseBoundary : Array Int -> Option Int
responseBoundary = H.responseBoundary
