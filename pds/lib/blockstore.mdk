{- | Pure immutable content-addressed block storage.

   Insertion looks up the CID first: an already-present CID is idempotent and
   recomputes nothing, while a new CID is verified against the blessed atproto
   CID recomputed from the supplied bytes. Views return the store's own
   `Bytes` values directly, and entries are exposed in canonical binary-CID
   order so callers never inherit insertion-order state. -}

import bytes.{Bytes}
import hex.{encode}
import map.{Map(..), get, set, size, entries}
import lib.cid.{Cid, cidCodec, cidEqual, cidForDagCbor, cidForRaw, cidToBytes}
import lib.multiformats.{multicodecDagCbor}

-- | An immutable verified CID-to-bytes map. Its representation is private.
export data BlockStore = BlockStore (Map String (Cid, Bytes))

cidKey : Cid -> String
cidKey cid = encode (cidToBytes cid)

expectedCid : Cid -> Bytes -> Cid
expectedCid cid bytes =
  if cidCodec cid == multicodecDagCbor then
    cidForDagCbor bytes
  else
    cidForRaw bytes

findBytes : Cid -> Map String (Cid, Bytes) -> Option Bytes
findBytes cid entries = map ((_, bytes) => bytes) (get (cidKey cid) entries)

-- | The empty store.
export
blockStoreEmpty : BlockStore
blockStoreEmpty = BlockStore Tip

-- | Number of distinct verified CIDs.
export
blockStoreSize : BlockStore -> Int
blockStoreSize (BlockStore entries) = size entries

-- | Test whether a CID is present.
export
blockStoreHas : Cid -> BlockStore -> Bool
blockStoreHas cid (BlockStore entries) = match findBytes cid entries
  Some _ => True
  None => False

-- | Look up a block's bytes.
export
blockStoreGet : Cid -> BlockStore -> Option Bytes
blockStoreGet cid (BlockStore entries) = findBytes cid entries

{- | Verify and immutably insert one block. An identical duplicate is
   idempotent; a CID collision with different bytes fails loudly
   ("duplicate CID has different bytes"). -}
export
blockStorePut : Cid -> Bytes -> BlockStore -> Result String BlockStore
blockStorePut cid bytes (BlockStore entries) = match get (cidKey cid) entries
  Some (_, prior) =>
    if prior == bytes then
      Ok (BlockStore entries)
    else
      Err "blockstore: duplicate CID has different bytes"
  None =>
    if not (cidEqual cid (expectedCid cid bytes)) then
      Err "blockstore: block content does not match CID"
    else
      Ok (BlockStore (set (cidKey cid) (cid, bytes) entries))

addRows : List (Cid, Bytes) -> BlockStore -> Result String BlockStore
addRows [] store = Ok store
addRows ((cid, bytes) :: rest) store = match blockStorePut cid bytes store
  Err message => Err message
  Ok next => addRows rest next

-- | Verify and insert every row without mutating the input store.
export
blockStoreAddMany : List (Cid, Bytes) -> BlockStore -> Result String BlockStore
blockStoreAddMany rows store = addRows rows store

-- | Construct a verified immutable store from arbitrary input order.
export
blockStoreFromBlocks : List (Cid, Bytes) -> Result String BlockStore
blockStoreFromBlocks rows = addRows rows blockStoreEmpty

entryValues : List (String, (Cid, Bytes)) -> List (Cid, Bytes)
entryValues [] = []
entryValues ((_, entry) :: rest) = entry :: entryValues rest

-- | Canonical CID-sorted entry view.
export
blockStoreEntries : BlockStore -> List (Cid, Bytes)
blockStoreEntries (BlockStore m) = entryValues (entries m)

{- | Canonical CID-sorted view of which CIDs are present, carrying no bytes.

   `blockStoreEntries` answers the same question but copies every block's bytes
   to do it, so a caller that only needs the names pays the whole store. -}
export
blockStoreCids : BlockStore -> List Cid
blockStoreCids (BlockStore entries) = map ((cid, _) => cid) (toList entries)

-- | Verify and immutably merge every entry from the right-hand store.
export
blockStoreMerge : BlockStore -> BlockStore -> Result String BlockStore
blockStoreMerge left right = blockStoreAddMany (blockStoreEntries right) left
