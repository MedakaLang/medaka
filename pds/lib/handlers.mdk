createRecordNsid : String
createRecordNsid = "com.atproto.repo.createRecord"

putRecordNsid : String
putRecordNsid = "com.atproto.repo.putRecord"

deleteRecordNsid : String
deleteRecordNsid = "com.atproto.repo.deleteRecord"

applyWritesNsid : String
applyWritesNsid = "com.atproto.repo.applyWrites"

{- | The lexicon spells each batch element's and each result's kind as a
   fragment reference into `applyWrites`' own lexicon, so both the accepted
   `$type` values and the emitted ones come from one place. -}
applyWritesType : String -> String
applyWritesType fragment = "\{applyWritesNsid}#\{fragment}"

getRecordNsid : String
getRecordNsid = "com.atproto.repo.getRecord"

listRecordsNsid : String
listRecordsNsid = "com.atproto.repo.listRecords"

describeRepoNsid : String
describeRepoNsid = "com.atproto.repo.describeRepo"

getRepoNsid : String
getRepoNsid = "com.atproto.sync.getRepo"

getLatestCommitNsid : String
getLatestCommitNsid = "com.atproto.sync.getLatestCommit"

uploadBlobNsid : String
uploadBlobNsid = "com.atproto.repo.uploadBlob"

getBlobNsid : String
getBlobNsid = "com.atproto.sync.getBlob"

listBlobsNsid : String
listBlobsNsid = "com.atproto.sync.listBlobs"

resolveHandleNsid : String
resolveHandleNsid = "com.atproto.identity.resolveHandle"

createSessionNsid : String
createSessionNsid = "com.atproto.server.createSession"

refreshSessionNsid : String
refreshSessionNsid = "com.atproto.server.refreshSession"

deleteSessionNsid : String
deleteSessionNsid = "com.atproto.server.deleteSession"

getSessionNsid : String
getSessionNsid = "com.atproto.server.getSession"

-- ── responses ───────────────────────────────────────────────────────────────

invalidRequest : String -> Response
invalidRequest = xrpcErrorResponse 400 "Bad Request" "InvalidRequest"

invalidSwap : String -> Response
invalidSwap = xrpcErrorResponse 400 "Bad Request" "InvalidSwap"

repoNotFound : String -> Response
repoNotFound = xrpcErrorResponse 400 "Bad Request" "RepoNotFound"

notImplemented : String -> Response
notImplemented = xrpcErrorResponse 501 "Not Implemented" "NotImplemented"

recordNotFound : String -> Response
recordNotFound = xrpcErrorResponse 400 "Bad Request" "RecordNotFound"

-- | The name is `sync.getBlob`'s own lexicon-declared error (graded against
-- the pinned reference package, not invented here).
blobNotFound : String -> Response
blobNotFound = xrpcErrorResponse 400 "Bad Request" "BlobNotFound"

handleNotFound : String -> Response
handleNotFound = xrpcErrorResponse 400 "Bad Request" "HandleNotFound"

authenticationRequired : String -> Response
authenticationRequired =
  xrpcErrorResponse 401 "Unauthorized" "AuthenticationRequired"

invalidToken : String -> Response
invalidToken = xrpcErrorResponse 401 "Unauthorized" "InvalidToken"

internalError : String -> Response
internalError =
  xrpcErrorResponse 500 "Internal Server Error" "InternalServerError"

contentTypeHeader : String -> Header
contentTypeHeader value = match makeHeader "content-type" (toUtf8 value)
  Ok header => header
  Err message => panic "handlers: internal response header error: \{message}"

{- | The success counterpart of `xrpcErrorResponse`: 200 with an exact body and
   one declared media type. `lib.http`'s serializer owns all framing. -}
bytesOkResponse : String -> Array Int -> Response
bytesOkResponse contentType body =
  match makeResponse 200 "OK" [contentTypeHeader contentType] body
    Ok response => response
    Err message =>
      panic "handlers: internal response construction error: \{message}"

{- | The standard XRPC success envelope: 200 with a serialized JSON body.
   `lib.xrpc` owns the matching error envelope (`xrpcErrorResponse`) but has no
   success counterpart, so this is it. -}
export
jsonOkResponse : Json -> Response
jsonOkResponse value =
  bytesOkResponse "application/json" (toUtf8 (stringify value))

-- ── request-field admission ─────────────────────────────────────────────────

requireObject : Json -> Result Response Unit
requireObject (JObject _) = Ok ()
requireObject _ = Err (invalidRequest "Request body must be a JSON object")

requiredString : String -> Json -> Result Response String
requiredString name body = match get name body
  None => Err (invalidRequest "Request field '\{name}' is required")
  Some (JString value) => Ok value
  Some _ => Err (invalidRequest "Request field '\{name}' must be a string")

{- | An OPTIONAL lexicon string field. Absent means absent; an explicit JSON
   `null` does NOT. None of the fields this admits is nullable in its lexicon,
   so `null` is a malformed value for a declared-string field and is rejected
   exactly like a number or an object would be — reading it as "absent" would
   silently accept a body the lexicon forbids. (`swapRecord` IS three-valued
   and reads its own `null`; see `checkSwapRecord`.) -}
optionalString : String -> Json -> Result Response (Option String)
optionalString name body = match get name body
  None => Ok None
  Some (JString value) => Ok (Some value)
  Some JNull =>
    Err (invalidRequest "Request field '\{name}' must be a string, not null")
  Some _ => Err (invalidRequest "Request field '\{name}' must be a string")

{- | `validate: true` asks for lexicon record validation, which this server
   does not implement. Honoring it silently would report a validation that
   never happened, so it is refused outright; `validate: false` and an absent
   field both mean "store the record as given", which is what happens. -}
requireNoLexiconValidation : Json -> Result Response Unit
requireNoLexiconValidation body = match get "validate" body
  None => Ok ()
  Some (JBool False) => Ok ()
  Some (JBool True) =>
    Err
      (invalidRequest
        "Lexicon record validation is not implemented; 'validate: true' cannot be honored")
  Some _ => Err (invalidRequest "Request field 'validate' must be a boolean")

requireConfiguredRepo : Store -> Result Response Repo
requireConfiguredRepo store = match storeRepo store
  None =>
    Err (repoNotFound "No account repository is configured on this server")
  Some repo => Ok repo

{- | Handle equality. atproto handles are DOMAIN NAMES, so they are compared
   case-insensitively: the official interop corpus admits `A.ISI.EDU`,
   `XX.LCS.MIT.EDU` and `SRI-NIC.ARPA` as valid handles
   (`pds/test/vectors/interop_handle_valid.txt` lines 2-4), and those name the
   same account as their lowercase spellings. `validateHandle` admits only
   ASCII, which is exactly the range `toLower` folds (issue #417), so the fold
   is total here. DIDs are NOT folded — a DID is case-SENSITIVE (a `did:key`
   identifier is base58, where case carries bits). -}
sameHandle : String -> String -> Bool
sameHandle left right = toLower left == toLower right

{- | A repository-naming request field must be an admitted at-identifier naming
   the one account this server hosts. Admission is `lib.atsyntax`'s, which is
   the graded validator. The field is named because the write lexicons spell it
   `repo` and the `com.atproto.sync.*` lexicons spell it `did`. -}
requireHostedIdentifier : String -> Account -> String -> Result Response Unit
requireHostedIdentifier field account target = do
  () <- match validateAtIdentifier target
    Err message =>
      Err
        (invalidRequest
          "Request field '\{field}' is not a valid at-identifier: \{message}")
    Ok () => Ok ()
  if target == accountDid account
    || sameHandle target (accountHandle account) then
    Ok ()
  else
    Err (repoNotFound "This server does not host the repository '\{target}'")

{- | The `com.atproto.sync.*` lexicons declare their `did` parameter as a DID,
   not an at-identifier: a handle is not an accepted spelling there. This is
   the DID-only counterpart of `requireHostedIdentifier`. -}
requireHostedDid : Account -> String -> Result Response Unit
requireHostedDid account target = do
  () <- match validateDid target
    Err message =>
      Err (invalidRequest "Query parameter 'did' must be a DID: \{message}")
    Ok () => Ok ()
  if target == accountDid account then
    Ok ()
  else
    Err (repoNotFound "This server does not host the repository '\{target}'")

requireHostedRepo : Account -> Json -> Result Response Unit
requireHostedRepo account body = do
  target <- requiredString "repo" body
  requireHostedIdentifier "repo" account target

{- | A record-valued request field. The single-record lexicons spell it
   `record`; `applyWrites` spells the same thing `value` inside each batch
   element, so the field name is a parameter and the diagnostic names whichever
   one the caller actually sent. -}
requireRecordField : String -> Json -> Result Response DagCbor
requireRecordField name body = match get name body
  None => Err (invalidRequest "Request field '\{name}' is required")
  Some value => match lexJsonToDagCbor value
    Err message =>
      Err
        (invalidRequest
          "Request field '\{name}' is not representable as atproto data: \{message}")
    Ok record => Ok record

requireRecord : Json -> Result Response DagCbor
requireRecord = requireRecordField "record"

encodeRecordField : String -> DagCbor -> Result Response (Array Int)
encodeRecordField name record = match dagCborEncode record
  Err message =>
    Err (invalidRequest "Request field '\{name}' cannot be encoded: \{message}")
  Ok bytes => Ok bytes

encodeRecord : DagCbor -> Result Response (Array Int)
encodeRecord = encodeRecordField "record"

recordPath : String -> String -> Array Int
recordPath collection rkey = toUtf8 "\{collection}/\{rkey}"

-- ── revision derivation ─────────────────────────────────────────────────────

advanceTid : Tid -> Result Response Tid
advanceTid prior = match tidNext prior (tidMicros prior) (tidClockId prior)
  Err message =>
    Err (invalidRequest "Repository revision cannot advance: \{message}")
  Ok rev => Ok rev

nextRevision : Repo -> Result Response Tid
nextRevision repo = advanceTid (repoCommitTid (repoLatestCommit repo))

-- ── compare-and-swap ────────────────────────────────────────────────────────

currentCommitCid : Repo -> Cid
currentCommitCid repo = repoCommitCid (repoLatestCommit repo)

currentRecordCid : Array Int -> Repo -> Result Response (Option Cid)
currentRecordCid path repo = match repoLookup path repo
  Err message => Err (invalidRequest "Repository read rejected: \{message}")
  Ok None => Ok None
  Ok (Some value) => match dagCborEncode value
    Err message =>
      Err (invalidRequest "Stored record cannot be re-encoded: \{message}")
    Ok bytes => Ok (Some (cidForDagCbor bytes))

checkSwapCommit : Json -> Repo -> Result Response Unit
checkSwapCommit body repo = match get "swapCommit" body
  None => Ok ()
  Some JNull => Ok ()
  Some (JString text) => match cidFromString text
    Err message =>
      Err
        (invalidRequest
          "Request field 'swapCommit' is not a valid CID: \{message}")
    Ok expected =>
      if cidEqual expected (currentCommitCid repo) then
        Ok ()
      else
        Err (invalidSwap "Commit was at \{cidToString (currentCommitCid repo)}")
  Some _ => Err (invalidRequest "Request field 'swapCommit' must be a string")

{- | `swapRecord` is three-valued: absent means no check, an explicit `null`
   asserts the record is ABSENT, and a CID string asserts it is exactly that
   record. -}
checkSwapRecord : Json -> Array Int -> Repo -> Result Response Unit
checkSwapRecord body path repo = match get "swapRecord" body
  None => Ok ()
  Some JNull => do
    actual <- currentRecordCid path repo
    match actual
      None => Ok ()
      Some cid =>
        Err
          (invalidSwap
            "Record is at \{cidToString cid}; 'swapRecord: null' requires its absence")
  Some (JString text) => match cidFromString text
    Err message =>
      Err
        (invalidRequest
          "Request field 'swapRecord' is not a valid CID: \{message}")
    Ok expected => do
      actual <- currentRecordCid path repo
      match actual
        None => Err (invalidSwap "Record does not exist")
        Some cid =>
          if cidEqual expected cid then
            Ok ()
          else
            Err (invalidSwap "Record was at \{cidToString cid}")
  Some _ =>
    Err (invalidRequest "Request field 'swapRecord' must be a string or null")

-- ── outputs ─────────────────────────────────────────────────────────────────

commitJson : RepoCommit -> Json
commitJson commit = jObject [
  ("cid", JString (cidToString (repoCommitCid commit))),
  ("rev", JString (tidToString (repoCommitTid commit))),
]

{- | `validationStatus` is always `"unknown"`, and that is not a placeholder.
   `requireNoLexiconValidation` REFUSES `validate: true` outright, so every
   write this server accepts is one it stored without grading against a
   lexicon. `"valid"` would claim a check that never ran; omitting the field
   would leave a client unable to tell an unvalidated write from a validated
   one. -}
writeOutput : Account -> String -> String -> Cid -> RepoCommit -> Json
writeOutput account collection rkey recordCid commit = jObject [
  ("uri", JString "at://\{accountDid account}/\{collection}/\{rkey}"),
  ("cid", JString (cidToString recordCid)),
  ("commit", commitJson commit),
  ("validationStatus", JString "unknown"),
]

deleteOutput : RepoCommit -> Json
deleteOutput commit = jObject [("commit", commitJson commit)]

admitMutation : Result String RepoMutation -> Result Response RepoMutation
admitMutation (Err message) =
  Err (invalidRequest "Repository write rejected: \{message}")
admitMutation (Ok mutation) = Ok mutation

-- | `pds/lib/blob.mdk`'s `admitBlob` is the ONE place blob size/MIME
-- admission happens; this only converts its refusal into the XRPC envelope.
admitBlobRef : Result String BlobRef -> Result Response BlobRef
admitBlobRef (Err message) = Err (invalidRequest "Blob rejected: \{message}")
admitBlobRef (Ok ref) = Ok ref

-- ── the write endpoints ─────────────────────────────────────────────────────

applyCreateRecord : Account -> Store -> Json -> Result Response (Repo, Json)
applyCreateRecord account store body = do
  () <- requireObject body
  repo <- requireConfiguredRepo store
  () <- requireHostedRepo account body
  () <- requireNoLexiconValidation body
  collection <- requiredString "collection" body
  record <- requireRecord body
  rev <- nextRevision repo
  proposedRkey <- optionalString "rkey" body
  let rkey = match proposedRkey
    None => tidToString rev
    Some value => value
  let path = recordPath collection rkey
  () <- checkSwapCommit body repo
  () <- checkSwapRecord body path repo
  bytes <- encodeRecord record
  mutation <- admitMutation (repoCreate path record rev repo)
  Ok (
    repoMutationState mutation,
    writeOutput
      account
      collection
      rkey
      (cidForDagCbor bytes)
      (repoMutationCommit mutation),
  )

applyPutRecord : Account -> Store -> Json -> Result Response (Repo, Json)
applyPutRecord account store body = do
  () <- requireObject body
  repo <- requireConfiguredRepo store
  () <- requireHostedRepo account body
  () <- requireNoLexiconValidation body
  collection <- requiredString "collection" body
  rkey <- requiredString "rkey" body
  record <- requireRecord body
  rev <- nextRevision repo
  let path = recordPath collection rkey
  () <- checkSwapCommit body repo
  () <- checkSwapRecord body path repo
  bytes <- encodeRecord record
  existing <- currentRecordCid path repo
  let transition = match existing
    None => repoCreate path record rev repo
    Some _ => repoUpdate path record rev repo
  mutation <- admitMutation transition
  Ok (
    repoMutationState mutation,
    writeOutput
      account
      collection
      rkey
      (cidForDagCbor bytes)
      (repoMutationCommit mutation),
  )

{- | `deleteRecord` is IDEMPOTENT: atproto's contract is that deleting a record
   that is not there succeeds. A caller that retries a delete whose response it
   never saw must not be told the second attempt failed.

   The no-op is a genuine no-op, not a delete of nothing: the repository is
   returned UNCHANGED, so no commit is signed and the revision does not
   advance — a delete that removed nothing has nothing to record. The response
   is the ordinary success shape carrying the CURRENT commit.

   Absence is the ONLY thing this forgives. The path still goes through
   `currentRecordCid` -> `repoLookup` -> `lib.repo`'s `validatePath`, so a
   malformed collection or record key is still rejected; and an explicit
   `swapRecord` CID still fails `InvalidSwap` against a missing record, because
   that caller asserted the record WAS there. -}
applyDeleteRecord : Account -> Store -> Json -> Result Response (Repo, Json)
applyDeleteRecord account store body = do
  () <- requireObject body
  repo <- requireConfiguredRepo store
  () <- requireHostedRepo account body
  collection <- requiredString "collection" body
  rkey <- requiredString "rkey" body
  let path = recordPath collection rkey
  () <- checkSwapCommit body repo
  () <- checkSwapRecord body path repo
  existing <- currentRecordCid path repo
  match existing
    None => Ok (repo, deleteOutput (repoLatestCommit repo))
    Some _ => do
      rev <- nextRevision repo
      mutation <- admitMutation (repoDelete path rev repo)
      Ok (
        repoMutationState mutation,
        deleteOutput (repoMutationCommit mutation),
      )

{- | The record key for the Nth `rkey`-less create in one batch.

   `createRecord` uses the commit revision's own TID spelling when the caller
   names no `rkey`, which is unique because that call mints exactly one record.
   A batch can carry several such creates under ONE revision, so reusing that
   spelling would make the second one collide with the first. Each successive
   rkey-less create therefore advances the same TID sequence the revision came
   from — deterministic, ordered, and identical to `createRecord`'s answer for
   a batch that has only one. -}
autoRkey : Tid -> Int -> Result Response String
autoRkey rev n =
  if n <= 0 then
    Ok (tidToString rev)
  else do
    next <- advanceTid rev
    autoRkey next (n - 1)

batchResult : String -> String -> String -> String -> Cid -> Json
batchResult fragment did collection rkey recordCid = jObject [
  ("$type", JString (applyWritesType fragment)),
  ("uri", JString "at://\{did}/\{collection}/\{rkey}"),
  ("cid", JString (cidToString recordCid)),
  ("validationStatus", JString "unknown"),
]

requireWrites : Json -> Result Response (Array Json)
requireWrites body = match get "writes" body
  None => Err (invalidRequest "Request field 'writes' is required")
  Some (JArray values) => Ok values
  Some _ => Err (invalidRequest "Request field 'writes' must be an array")

{- | One batch element, as the operation to apply, the result row it will
   report, and the successor rkey-less-create counter. -}
batchElement : String ->
  Tid ->
  Int ->
  Json ->
  Result Response (RepoWrite, Json, Int)
batchElement did rev auto element = do
  () <- match element
    JObject _ => Ok ()
    _ => Err (invalidRequest "Every 'writes' element must be a JSON object")
  kind <- requiredString "$type" element
  collection <- requiredString "collection" element
  if kind == applyWritesType "create" then do
    record <- requireRecordField "value" element
    proposed <- optionalString "rkey" element
    (rkey, nextAuto) <- match proposed
      Some value => Ok (value, auto)
      None => do
        derived <- autoRkey rev auto
        Ok (derived, auto + 1)
    bytes <- encodeRecordField "value" record
    Ok (
      RepoWriteCreate (recordPath collection rkey) record,
      batchResult "createResult" did collection rkey (cidForDagCbor bytes),
      nextAuto,
    )
  else if kind == applyWritesType "update" then do
    rkey <- requiredString "rkey" element
    record <- requireRecordField "value" element
    bytes <- encodeRecordField "value" record
    Ok (
      RepoWriteUpdate (recordPath collection rkey) record,
      batchResult "updateResult" did collection rkey (cidForDagCbor bytes),
      auto,
    )
  else if kind == applyWritesType "delete" then do
    rkey <- requiredString "rkey" element
    Ok (
      RepoWriteDelete (recordPath collection rkey),
      jObject [("$type", JString (applyWritesType "deleteResult"))],
      auto,
    )
  else
    Err
      (invalidRequest
        "Every 'writes' element must be a \{applyWritesType "create"}, \{applyWritesType "update"} or \{applyWritesType "delete"}")

batchElements : String ->
  Tid ->
  Array Json ->
  Int ->
  Int ->
  Result Response (List RepoWrite, List Json)
batchElements did rev elements i auto =
  if i >= arrayLength elements then
    Ok ([], [])
  else do
    (write, result, nextAuto) <- batchElement did rev auto elements[i]
    (rest, results) <- batchElements did rev elements (i + 1) nextAuto
    Ok (write :: rest, result :: results)

{- | `applyWrites` is the batch counterpart of the three single-record
   procedures, and its whole point is that it signs ONE commit: N operations
   advance the repository by exactly one revision, not N, so a client that
   needs several records to appear together does not publish a half-written
   repository to any relay reading the commit log.

   It is ALL-OR-NOTHING, which `lib.repo`'s `repoApplyWrites` enforces rather
   than this layer: the first failing operation aborts before anything is
   signed, so a rejected batch leaves the caller's repository at its prior
   commit, exactly like every other rejection here.

   An EMPTY `writes` array is accepted and changes nothing: the response
   carries the CURRENT commit and no results. Signing a commit over an
   unchanged tree would attest to a change that never happened.

   `swapCommit` is honored exactly as the three single writes honor it, and
   there is no `swapRecord`: the lexicon has no per-element compare-and-swap,
   and inventing one would accept bodies a real PDS refuses. -}
applyBatchWrites : Account -> Store -> Json -> Result Response (Repo, Json)
applyBatchWrites account store body = do
  () <- requireObject body
  repo <- requireConfiguredRepo store
  () <- requireHostedRepo account body
  () <- requireNoLexiconValidation body
  elements <- requireWrites body
  rev <- nextRevision repo
  (writes, results) <- batchElements (accountDid account) rev elements 0 0
  () <- checkSwapCommit body repo
  mutation <- admitMutation (repoApplyWrites writes rev repo)
  Ok (
    repoMutationState mutation,
    jObject [
      ("commit", commitJson (repoMutationCommit mutation)),
      ("results", jArray results),
    ],
  )

finishWrite : Store -> Result Response (Repo, Json) -> (Store, Response)
finishWrite store (Err response) = (store, response)
finishWrite store (Ok (repo, output)) =
  (storeWithRepo repo store, jsonOkResponse output)

totalBlobBytes : List (Cid, Array Int) -> Int
totalBlobBytes [] = 0
totalBlobBytes ((_, bytes) :: rest) = arrayLength bytes + totalBlobBytes rest

{- | `com.atproto.repo.uploadBlob`: admit the raw body against `pds/lib/blob.
   mdk`'s `admitBlob` — the ONE place size/MIME admission happens — then
   record the admitted bytes and declared MIME type in the Store's blob half.
   No request field names an account; this server hosts exactly one, and the
   auth layer has already required a session before this handler ever runs. -}
applyUploadBlob : Store ->
  MediaType ->
  Array Int ->
  Result Response (Store, Json)
applyUploadBlob store media bytes = do
  let mimeType = "\{mediaTypeType media}/\{mediaTypeSubtype media}"
  let accountUsedBytes = totalBlobBytes (storeBlobEntries store)
  ref <- admitBlobRef (admitBlob accountUsedBytes mimeType bytes)
  next <- match storePutBlob (blobRefCid ref) mimeType bytes store
    Err message =>
      Err (internalError "Admitted blob could not be stored: \{message}")
    Ok value => Ok value
  Ok (next, jObject [("blob", blobRefToJson ref)])

finishUploadBlob : Store -> Result Response (Store, Json) -> (Store, Response)
finishUploadBlob store (Err response) = (store, response)
finishUploadBlob _ (Ok (next, output)) = (next, jsonOkResponse output)

{- | The four record-write procedures plus `uploadBlob`, or `None` for a call
   this half does not own. `uploadBlob` joins this half rather than the read
   half because it transitions the `Store` (the blob half) exactly like the
   other four transition the repository half — only this half can return a
   successor `Store`. -}
recordHandled : Account -> Store -> XrpcCall -> Option (Store, Response)
recordHandled account store (ProcedureJsonCall nsid _ body)
  | nsid == createRecordNsid =
    Some (finishWrite store (applyCreateRecord account store body))
  | nsid == putRecordNsid =
    Some (finishWrite store (applyPutRecord account store body))
  | nsid == deleteRecordNsid =
    Some (finishWrite store (applyDeleteRecord account store body))
  | nsid == applyWritesNsid =
    Some (finishWrite store (applyBatchWrites account store body))
  | otherwise = None
recordHandled _ store (ProcedureRawCall nsid _ media bytes)
  | nsid == uploadBlobNsid =
    Some (finishUploadBlob store (applyUploadBlob store media bytes))
  | otherwise = None
recordHandled _ _ _ = None

{- | The record-write handler for one configured account. Any routed call that
   is not one of the five record-write procedures is answered 501 with the
   input `Store` intact. -}
export
recordHandler : Account -> Handler
recordHandler account _ _ store call = match recordHandled account store call
  Some result => result
  None => (store, unhandledRoute call)

{- | What a routed call names: the NSID for the five XRPC arms, and the request
   path for the two non-XRPC well-knowns, which have no NSID
   (`lib.xrpc`'s `wellKnownPath` is the single spelling of both). -}
callTarget : XrpcCall -> String
callTarget (QueryCall nsid _) = nsid
callTarget (ProcedureNoInputCall nsid _) = nsid
callTarget (ProcedureJsonCall nsid _ _) = nsid
callTarget (ProcedureTextCall nsid _ _ _) = nsid
callTarget (ProcedureRawCall nsid _ _ _) = nsid
callTarget (WellKnownCall wellKnown) = wellKnownPath wellKnown

unhandledRoute : XrpcCall -> Response
unhandledRoute call =
  notImplemented "This route is not implemented: \{callTarget call}"

-- | The registry of the four record-write procedures plus `uploadBlob`.
export
recordRegistry : Result String Registry
recordRegistry = do
  endpoints <- recordEndpoints
  makeRegistry endpoints

{- | The four record-write procedures plus `uploadBlob`, every one of them
   gated.

   `com.atproto.repo.{createRecord, putRecord, deleteRecord, applyWrites}` each
   require an authenticated session on a real PDS: they transition the
   account's own repository, and a caller that could reach them unauthenticated
   could write to somebody else's repository from the open internet.
   `applyWrites` is not a weaker case for being a batch — it can express every
   edit the other three can. `uploadBlob` is the same argument applied to the
   blob half: an unauthenticated caller could fill this server's storage from
   the open internet. -}
recordEndpoints : Result String (List Endpoint)
recordEndpoints = do
  create <- procedureEndpoint createRecordNsid JsonInput AuthenticatedRoute
  put <- procedureEndpoint putRecordNsid JsonInput AuthenticatedRoute
  remove <- procedureEndpoint deleteRecordNsid JsonInput AuthenticatedRoute
  batch <- procedureEndpoint applyWritesNsid JsonInput AuthenticatedRoute
  upload <- procedureEndpoint uploadBlobNsid RawInput AuthenticatedRoute
  Ok [create, put, remove, batch, upload]

-- | A configured record-write server for one account.
export
recordServer : Account -> Result String Server
recordServer account = do
  registry <- recordRegistry
  Ok (makeServer account registry (recordHandler account))

-- ── query-parameter admission ───────────────────────────────────────────────

paramCount : String -> List QueryParam -> Int
paramCount _ [] = 0
paramCount name ((QueryParam key _) :: rest) =
  if key == name then 1 + paramCount name rest else paramCount name rest

paramFirst : String -> List QueryParam -> Option String
paramFirst _ [] = None
paramFirst name ((QueryParam key value) :: rest) =
  if key == name then Some value else paramFirst name rest

{- | None of these six endpoints takes a repeated parameter, so a repeat is a
   request whose meaning is ambiguous — rejected rather than silently resolved
   to whichever copy happens to come first. -}
optionalParam : String -> List QueryParam -> Result Response (Option String)
optionalParam name params =
  if paramCount name params > 1 then
    Err (invalidRequest "Query parameter '\{name}' must not be repeated")
  else
    Ok (paramFirst name params)

requiredParam : String -> List QueryParam -> Result Response String
requiredParam name params = do
  found <- optionalParam name params
  match found
    None => Err (invalidRequest "Query parameter '\{name}' is required")
    Some value => Ok value

{- | A parameter this server understands the meaning of but does not implement
   is REFUSED, never ignored: silently dropping `since` or `cursor` would
   answer a narrower question than the one asked, as if it were the answer. -}
rejectUnimplementedParam : String -> List QueryParam -> Result Response Unit
rejectUnimplementedParam name params = match paramFirst name params
  None => Ok ()
  Some _ =>
    Err
      (invalidRequest
        "Query parameter '\{name}' is not implemented by this server")

-- ── record views ────────────────────────────────────────────────────────────

recordUri : Account -> String -> String -> String
recordUri account collection rkey =
  "at://\{accountDid account}/\{collection}/\{rkey}"

reencodeRecord : DagCbor -> Result Response (Array Int)
reencodeRecord value = match dagCborEncode value
  Err message =>
    Err (invalidRequest "Stored record cannot be re-encoded: \{message}")
  Ok bytes => Ok bytes

recordView : Account -> String -> String -> DagCbor -> Result Response Json
recordView account collection rkey value = do
  bytes <- reencodeRecord value
  Ok
    (jObject [
      ("uri", JString (recordUri account collection rkey)),
      ("cid", JString (cidToString (cidForDagCbor bytes))),
      ("value", dagCborToLexJson value),
    ])

recordViews : Account ->
  String ->
  List (String, DagCbor) ->
  Result Response (List Json)
recordViews _ _ [] = Ok []
recordViews account collection ((rkey, value) :: rest) = do
  view <- recordView account collection rkey value
  views <- recordViews account collection rest
  Ok (view :: views)

-- ── repository reads ────────────────────────────────────────────────────────

lookupRecord : Array Int -> Repo -> Result Response (Option DagCbor)
lookupRecord path repo = match repoLookup path repo
  Err message => Err (invalidRequest "Repository read rejected: \{message}")
  Ok found => Ok found

listAllEntries : Repo -> Result Response (List (Array Int, Cid, DagCbor))
listAllEntries repo = match repoList repo
  Err message => Err (invalidRequest "Repository listing rejected: \{message}")
  Ok entries => Ok entries

splitRecordPath : Array Int -> Option (String, String)
splitRecordPath path = match split "/" (fromUtf8 path)
  [collection, rkey] => Some (collection, rkey)
  _ => None

{- | The `(rkey, record)` pairs of one collection, in the repository's own
   ascending key order (`lib.mst` keeps entries sorted, so this is already the
   ascending half of atproto's `reverse` parameter). -}
collectionEntries : String ->
  List (Array Int, Cid, DagCbor) ->
  List (String, DagCbor)
collectionEntries _ [] = []
collectionEntries wanted ((path, _, value) :: rest) = match splitRecordPath path
  Some (collection, rkey) =>
    if collection == wanted then
      (rkey, value) :: collectionEntries wanted rest
    else
      collectionEntries wanted rest
  None => collectionEntries wanted rest

distinctCollections : List (Array Int, Cid, DagCbor) ->
  List String ->
  List String
distinctCollections [] seen = reverseOnto seen []
distinctCollections ((path, _, _) :: rest) seen = match splitRecordPath path
  Some (collection, _) =>
    if nameSeen collection seen then
      distinctCollections rest seen
    else
      distinctCollections rest (collection :: seen)
  None => distinctCollections rest seen

nameSeen : String -> List String -> Bool
nameSeen _ [] = False
nameSeen wanted (name :: rest) = name == wanted || nameSeen wanted rest

reverseOnto : List a -> List a -> List a
reverseOnto [] acc = acc
reverseOnto (x :: rest) acc = reverseOnto rest (x :: acc)

-- ── com.atproto.repo.getRecord ──────────────────────────────────────────────

applyGetRecord : Account -> Store -> List QueryParam -> Result Response Json
applyGetRecord account store params = do
  repo <- requireConfiguredRepo store
  target <- requiredParam "repo" params
  () <- requireHostedIdentifier "repo" account target
  collection <- requiredParam "collection" params
  rkey <- requiredParam "rkey" params
  requested <- optionalParam "cid" params
  found <- lookupRecord (recordPath collection rkey) repo
  value <- match found
    None =>
      Err
        (recordNotFound
          "Record not found: \{recordUri account collection rkey}")
    Some value => Ok value
  bytes <- reencodeRecord value
  let actual = cidToString (cidForDagCbor bytes)
  () <- match requested
    None => Ok ()
    Some wanted =>
      if wanted == actual then
        Ok ()
      else
        Err
          (recordNotFound
            "Record \{recordUri account collection rkey} is at \{actual}, not \{wanted}")
  Ok
    (jObject [
      ("uri", JString (recordUri account collection rkey)),
      ("cid", JString actual),
      ("value", dagCborToLexJson value),
    ])

-- ── com.atproto.repo.listRecords ────────────────────────────────────────────

{- | atproto's `reverse` is `false` (descending record key, newest first) by
   default and `true` for ascending. `collectionEntries` yields ascending, so
   the default direction is the reversed one. -}
requireReverse : List QueryParam -> Result Response Bool
requireReverse params = do
  found <- optionalParam "reverse" params
  match found
    None => Ok False
    Some "true" => Ok True
    Some "false" => Ok False
    Some _ =>
      Err (invalidRequest "Query parameter 'reverse' must be 'true' or 'false'")

requireLimit : List QueryParam -> Result Response Int
requireLimit params = do
  found <- optionalParam "limit" params
  match found
    None => Ok 50
    Some text => match toInt text
      None => Err (invalidRequest "Query parameter 'limit' must be an integer")
      Some limit =>
        if limit < 1 || limit > 100 then
          Err
            (invalidRequest "Query parameter 'limit' must be between 1 and 100")
        else
          Ok limit

orderEntries : Bool -> List (String, DagCbor) -> List (String, DagCbor)
orderEntries True entries = entries
orderEntries False entries = reverseOnto entries []

{- | Drop everything up to and including the cursor. The list is already sorted
   in the requested direction, so "sorts after the cursor" is exactly the
   remainder of the page the cursor ended. -}
afterCursor : Bool -> String -> List (String, DagCbor) -> List (String, DagCbor)
afterCursor _ _ [] = []
afterCursor ascending cursor ((rkey, value) :: rest) =
  let keep = if ascending then rkey > cursor else rkey < cursor
  if keep then
    (rkey, value) :: afterCursor ascending cursor rest
  else
    afterCursor ascending cursor rest

takeLimit : Int -> List (String, DagCbor) -> List (String, DagCbor)
takeLimit _ [] = []
takeLimit limit (entry :: rest) =
  if limit <= 0 then [] else entry :: takeLimit (limit - 1) rest

entryCount : List (String, DagCbor) -> Int
entryCount [] = 0
entryCount (_ :: rest) = 1 + entryCount rest

lastRkey : String -> List (String, DagCbor) -> String
lastRkey fallback [] = fallback
lastRkey _ [(rkey, _)] = rkey
lastRkey fallback (_ :: rest) = lastRkey fallback rest

{- | `listRecords` is the ONE collection-taking endpoint whose collection never
   reaches `lib.repo`: every sibling builds a `collection/rkey` path that
   `validatePath` grades, but this one only string-compares the name against
   already-stored paths. Without this check a malformed collection answered
   `{"records": []}` with a 200 — a syntactically impossible collection
   reported as a real, empty one. The grading is `lib.repo`'s own
   `validateCollection`, so admission here is byte-for-byte what `getRecord`
   and the write endpoints apply. -}
requireCollectionSyntax : String -> Result Response Unit
requireCollectionSyntax collection =
  let bytes = toUtf8 collection
  match validateCollection bytes (arrayLength bytes)
    Err message =>
      Err
        (invalidRequest
          "Query parameter 'collection' is not a valid collection NSID: \{message}")
    Ok () => Ok ()

applyListRecords : Account -> Store -> List QueryParam -> Result Response Json
applyListRecords account store params = do
  repo <- requireConfiguredRepo store
  target <- requiredParam "repo" params
  () <- requireHostedIdentifier "repo" account target
  collection <- requiredParam "collection" params
  () <- requireCollectionSyntax collection
  limit <- requireLimit params
  ascending <- requireReverse params
  cursor <- optionalParam "cursor" params
  entries <- listAllEntries repo
  let ordered = orderEntries ascending (collectionEntries collection entries)
  let remaining = match cursor
    None => ordered
    Some text => afterCursor ascending text ordered
  let page = takeLimit limit remaining
  views <- recordViews account collection page
  -- A cursor is emitted only when a further page exists, so a client that gets
  -- none knows it has seen the whole collection.
  if entryCount remaining > entryCount page then
    Ok
      (jObject [
        ("records", jArray views),
        ("cursor", JString (lastRkey "" page)),
      ])
  else
    Ok (jObject [("records", jArray views)])

-- ── com.atproto.repo.describeRepo ───────────────────────────────────────────

{- | `handleIsCorrect` reports whether the handle resolves back to this DID. On
   a one-account server the pair is `Account`'s own invariant — `makeAccount`
   admitted both and `resolveHandle` answers from that same pair — so it is
   `true` by construction, not by a resolution this server cannot perform.

   `didDoc` is NOT emitted: the account DID is a `did:key`, and this server has
   no DID resolver, so any document it printed would be invented. -}
applyDescribeRepo : Account -> Store -> List QueryParam -> Result Response Json
applyDescribeRepo account store params = do
  repo <- requireConfiguredRepo store
  target <- requiredParam "repo" params
  () <- requireHostedIdentifier "repo" account target
  entries <- listAllEntries repo
  Ok
    (jObject [
      ("did", JString (accountDid account)),
      ("handle", JString (accountHandle account)),
      ("collections", jArray (map JString (distinctCollections entries []))),
      ("handleIsCorrect", JBool True),
    ])

-- ── com.atproto.sync.getRepo ────────────────────────────────────────────────

{- | The CAR of the whole repository. The bytes are `repoExportCar`'s, not a
   second CAR emission: `lib.repo` owns the block set and its order, and those
   exact bytes are what the provenance-pinned corpus grades. -}
applyGetRepo : Account -> Store -> List QueryParam -> Result Response Response
applyGetRepo account store params = do
  repo <- requireConfiguredRepo store
  target <- requiredParam "did" params
  () <- requireHostedDid account target
  () <- rejectUnimplementedParam "since" params
  match repoExportCar repo
    Err message => Err (invalidRequest "Repository export rejected: \{message}")
    Ok bytes => Ok (bytesOkResponse "application/vnd.ipld.car" bytes)

-- ── com.atproto.sync.getLatestCommit ────────────────────────────────────────

applyGetLatestCommit : Account ->
  Store ->
  List QueryParam ->
  Result Response Json
applyGetLatestCommit account store params = do
  repo <- requireConfiguredRepo store
  target <- requiredParam "did" params
  () <- requireHostedDid account target
  let commit = repoLatestCommit repo
  Ok
    (jObject [
      ("cid", JString (cidToString (repoCommitCid commit))),
      ("rev", JString (tidToString (repoCommitTid commit))),
    ])

-- ── com.atproto.sync.getBlob ────────────────────────────────────────────────

{- | Blobs are independent of the repository half — `pds/lib/store.mdk`'s blob
   half exists on an unconfigured server too — so this does not call
   `requireConfiguredRepo`, unlike every `sync.*` read above it. -}
applyGetBlob : Account -> Store -> List QueryParam -> Result Response Response
applyGetBlob account store params = do
  target <- requiredParam "did" params
  () <- requireHostedDid account target
  cidText <- requiredParam "cid" params
  cid <- match cidFromString cidText
    Err message =>
      Err
        (invalidRequest "Query parameter 'cid' is not a valid CID: \{message}")
    Ok value => Ok value
  match storeGet cid store
    None =>
      Err
        (blobNotFound "No blob with CID '\{cidText}' is stored on this server")
    Some bytes =>
      let mimeType = match storeBlobMimeType cid store
        None => "application/octet-stream"
        Some declared => declared
      Ok (bytesOkResponse mimeType bytes)

-- ── com.atproto.sync.listBlobs ──────────────────────────────────────────────

requireBlobLimit : List QueryParam -> Result Response Int
requireBlobLimit params = do
  found <- optionalParam "limit" params
  match found
    None => Ok 500
    Some text => match toInt text
      None => Err (invalidRequest "Query parameter 'limit' must be an integer")
      Some limit =>
        if limit < 1 || limit > 1000 then
          Err
            (invalidRequest
              "Query parameter 'limit' must be between 1 and 1000")
        else
          Ok limit

blobCidTexts : List (Cid, Array Int) -> List String
blobCidTexts entries = map ((cid, _) => cidToString cid) entries

{- | Blobs are also independent of the repository half here; `since` (a
   revision cursor into the repository, not the blob half) is refused as
   unimplemented rather than silently ignored, the same policy
   `rejectUnimplementedParam` already applies to `getRepo`'s `since`. -}
applyListBlobs : Account -> Store -> List QueryParam -> Result Response Json
applyListBlobs account store params = do
  target <- requiredParam "did" params
  () <- requireHostedDid account target
  () <- rejectUnimplementedParam "since" params
  limit <- requireBlobLimit params
  cursor <- optionalParam "cursor" params
  let allCids = blobCidTexts (storeBlobEntries store)
  let remaining = match cursor
    None => allCids
    Some text => filter (> text) allCids
  let page = take limit remaining
  if length remaining > length page then match last page
    None => Ok (jObject [("cids", jArray (map JString page))])
    Some cursorCid =>
      Ok
        (jObject [
          ("cids", jArray (map JString page)),
          ("cursor", JString cursorCid),
        ])
  else
    Ok (jObject [("cids", jArray (map JString page))])

-- ── com.atproto.identity.resolveHandle ──────────────────────────────────────

{- | This server resolves exactly the one handle it hosts. It needs no
   repository, so it answers on an unconfigured `Store` too. -}
applyResolveHandle : Account -> List QueryParam -> Result Response Json
applyResolveHandle account params = do
  handle <- requiredParam "handle" params
  () <- match validateHandle handle
    Err message =>
      Err
        (invalidRequest
          "Query parameter 'handle' is not a valid handle: \{message}")
    Ok () => Ok ()
  if sameHandle handle (accountHandle account) then
    Ok (jObject [("did", JString (accountDid account))])
  else
    Err (handleNotFound "Unable to resolve handle '\{handle}'")

-- ── the two well-knowns ─────────────────────────────────────────────────────

{- | This PDS's own did:web document, keyed by the hostname `makeAccount`
   admitted. It describes the SERVER (its atproto service endpoint), not the
   hosted account — the account is a `did:key` and owns a different document
   this server does not serve. -}
didWebDocument : Account -> Json
didWebDocument account = jObject [
  ("@context", jArray [JString "https://www.w3.org/ns/did/v1"]),
  ("id", JString "did:web:\{accountHostname account}"),
  (
    "service",
    jArray [
      jObject [
        ("id", JString "#atproto_pds"),
        ("type", JString "AtprotoPersonalDataServer"),
        ("serviceEndpoint", JString "https://\{accountHostname account}"),
      ],
    ],
  ),
]

wellKnownResponse : Account -> WellKnown -> Response
wellKnownResponse account WellKnownDidDocument =
  jsonOkResponse (didWebDocument account)
wellKnownResponse account WellKnownAtprotoDid =
  bytesOkResponse "text/plain; charset=utf-8" (toUtf8 (accountDid account))

-- ── sessions ────────────────────────────────────────────────────────────────

{- | How long an access token is good for. Two hours is what a real PDS issues:
   long enough that a client is not refreshing constantly, short enough that a
   leaked one expires on its own. -}
accessTokenSeconds : Int
accessTokenSeconds = 7200

{- | How long a refresh token is good for. Ninety days, again matching a real
   PDS: it is the interval after which a client that has gone quiet has to log
   in with the password again. -}
refreshTokenSeconds : Int
refreshTokenSeconds = 7776000

{- | The access and refresh token this request issues, in that order.

   Both are identified by the request's own nonce (`jti`, `lib.jwt`), which is
   what makes two sessions opened in the same second — or a refresh token and
   the token that replaced it — distinct values. They differ from each other in
   audience and lifetime, which is what stops either being presented as the
   other. -}
mintSessionTokens : Account -> Array Int -> RequestContext -> (String, String)
mintSessionTokens account secret context =
  let tokenId = Hex.encode context.nonce
  let issued = context.nowSeconds
  (
    mintToken
      secret
      (accountDid account)
      (accessAudience account)
      tokenId
      issued
      (issued + accessTokenSeconds),
    mintToken
      secret
      (accountDid account)
      (refreshAudience account)
      tokenId
      issued
      (issued + refreshTokenSeconds),
  )

-- The lexicon output shape `createSession` and `refreshSession` share.
sessionOutput : Account -> String -> String -> Json
sessionOutput account access refresh = jObject [
  ("did", JString (accountDid account)),
  ("handle", JString (accountHandle account)),
  ("accessJwt", JString access),
  ("refreshJwt", JString refresh),
]

-- Sessions whose refresh token has expired are dropped whenever the session
-- list is written, so a server nobody logs out of does not accumulate records
-- that can no longer verify anything.
sessionExpiry : RequestContext -> Int
sessionExpiry context = context.nowSeconds + refreshTokenSeconds

{- | Whether the identifier a login presented names this account.

   atproto lets a client log in with either its handle or its DID. A handle is
   compared case-insensitively (atproto handles are domain names, which are);
   a DID is compared exactly, because DID method-specific identifiers are
   case-sensitive. -}
identifiesAccount : Account -> String -> Bool
identifiesAccount account identifier =
  toLower identifier == toLower (accountHandle account)
    || identifier == accountDid account

-- The one place a password is graded. A wrong password and an identifier that
-- names nobody are the same refusal, deliberately.
checkLogin : Account ->
  String ->
  String ->
  CredentialRecord ->
  Result Response Unit
checkLogin account identifier password credential =
  let identified = identifiesAccount account identifier
  let verified = credentialVerify password credential
  if identified && verified then
    Ok ()
  else
    Err (authenticationRequired "Invalid identifier or password")

{- | `com.atproto.server.createSession`: exchange the account password for a
   token pair.

   A wrong password, an unknown identifier, and a server with no credential
   configured are answered IDENTICALLY, and deliberately: the differences
   between them are exactly what an attacker probing for a valid identifier is
   asking about. Nothing in the refusal repeats what was sent. -}
applyCreateSession : Account ->
  RequestContext ->
  Store ->
  Json ->
  Result Response (Store, Json)
applyCreateSession account context store body = do
  () <- requireObject body
  identifier <- requiredString "identifier" body
  password <- requiredString "password" body
  secret <- match storeServerSecret store
    None =>
      Err
        (internalError
          "This server has no session secret configured and can issue no session")
    Some value => Ok value
  credential <- match storeCredential store
    None => Err (authenticationRequired "Invalid identifier or password")
    Some value => Ok value
  () <- checkLogin account identifier password credential
  let (access, refresh) = mintSessionTokens account secret context
  Ok (
    storeSessionOpen
      (sessionFingerprint access)
      (sessionFingerprint refresh)
      (sessionExpiry context)
      (storeSessionsPrune context.nowSeconds store),
    sessionOutput account access refresh,
  )

{- | `com.atproto.server.refreshSession`: rotate the presented refresh token.

   The seam has already verified the refresh token and named its session
   (`AuthOutcome`'s fingerprint), so this rotates and nothing else. The
   consumed token is removed rather than marked, so presenting it a second
   time finds no session and is refused by the seam — reuse of a rotated
   refresh token buys an attacker nothing, and costs the legitimate client
   nothing either, since it already holds the replacement. -}
applyRefreshSession : Account ->
  RequestContext ->
  Array Int ->
  Store ->
  Result Response (Store, Json)
applyRefreshSession account context presented store = do
  secret <- match storeServerSecret store
    None =>
      Err
        (internalError
          "This server has no session secret configured and can issue no session")
    Some value => Ok value
  let (access, refresh) = mintSessionTokens account secret context
  let rotation =
    storeSessionRotate
      presented
      (sessionFingerprint access)
      (sessionFingerprint refresh)
      (sessionExpiry context)
      (storeSessionsPrune context.nowSeconds store)
  rotated <- match rotation
    None => Err (invalidToken "Token could not be verified")
    Some next => Ok next
  Ok (rotated, sessionOutput account access refresh)

{- | `com.atproto.server.deleteSession`: close the presented session.

   Closing it revokes BOTH of its tokens: the access token the caller may
   still be holding no longer names an open session, so the seam refuses it
   from the next request on even though its signature is good and its window
   has not closed. -}
applyDeleteSession : RequestContext ->
  Array Int ->
  Store ->
  Result Response (Store, Json)
applyDeleteSession context presented store =
  let pruned = storeSessionsPrune context.nowSeconds store
  match storeSessionClose presented pruned
    None => Err (invalidToken "Token could not be verified")
    Some next => Ok (next, jObject [])

-- | `com.atproto.server.getSession`: who the caller is authenticated as. The
-- seam resolved that already; this reports it.
applyGetSession : Account -> Json
applyGetSession account = jObject [
  ("did", JString (accountDid account)),
  ("handle", JString (accountHandle account)),
]

finishSession : Store -> Result Response (Store, Json) -> (Store, Response)
finishSession store (Err response) = (store, response)
finishSession _ (Ok (next, output)) = (next, jsonOkResponse output)

{- | The four session routes, or `None` for a call this half does not own.

   `refreshSession`, `deleteSession`, and `getSession` are reachable only with
   an `Authenticated` outcome (they are `RefreshRoute`/`AuthenticatedRoute`,
   which the seam refuses unauthenticated), so their `Unauthenticated` arms
   are unreachable through `handle`; they answer 401 rather than panicking or
   reporting an account identity, because a direct caller of this function is
   not the seam and must not be told a different story than a request would
   be. -}
sessionHandled : Account ->
  RequestContext ->
  AuthOutcome ->
  Store ->
  XrpcCall ->
  Option (Store, Response)
sessionHandled account context _ store (ProcedureJsonCall nsid _ body)
  | nsid == createSessionNsid =
    Some (finishSession store (applyCreateSession account context store body))
  | otherwise = None
sessionHandled account context outcome store (ProcedureNoInputCall nsid _)
  | nsid == refreshSessionNsid = match outcome
    Unauthenticated =>
      Some (store, authenticationRequired "Authentication Required")
    Authenticated _ presented =>
      Some
        (finishSession
          store
          (applyRefreshSession account context presented store))
  | nsid == deleteSessionNsid = match outcome
    Unauthenticated =>
      Some (store, authenticationRequired "Authentication Required")
    Authenticated _ presented =>
      Some (finishSession store (applyDeleteSession context presented store))
  | otherwise = None
sessionHandled account _ outcome store (QueryCall nsid _)
  | nsid == getSessionNsid = match outcome
    Unauthenticated =>
      Some (store, authenticationRequired "Authentication Required")
    Authenticated _ _ => Some (store, jsonOkResponse (applyGetSession account))
  | otherwise = None
sessionHandled _ _ _ _ _ = None

{- | The four session routes, one per policy class it takes.

   `createSession` is PUBLIC: it is how a client that holds no token at all
   gets one, so gating it would make every session unreachable. `getSession`
   is `AuthenticatedRoute`: it reports who the ACCESS token belongs to.
   `refreshSession` and `deleteSession` are `RefreshRoute`, which is atproto's
   own classification — both are authenticated by the session's REFRESH token,
   so a client whose access token has already expired can still refresh it and
   can still log out. -}
sessionEndpoints : Result String (List Endpoint)
sessionEndpoints = do
  create <- procedureEndpoint createSessionNsid JsonInput PublicRoute
  refresh <- procedureEndpoint refreshSessionNsid NoInput RefreshRoute
  remove <- procedureEndpoint deleteSessionNsid NoInput RefreshRoute
  get <- queryEndpoint getSessionNsid AuthenticatedRoute
  Ok [create, refresh, remove, get]

-- ── read dispatch ───────────────────────────────────────────────────────────

collapseResponse : Result Response Response -> Response
collapseResponse (Err response) = response
collapseResponse (Ok response) = response

finishRead : Result Response Json -> Response
finishRead (Err response) = response
finishRead (Ok value) = jsonOkResponse value

{- | The six read/sync/identity queries and the two well-knowns, or `None` for
   a call this half does not own. It returns a bare `Response` because no route
   here can transition the `Store`. -}
readHandled : Account -> Store -> XrpcCall -> Option Response
readHandled account _ (WellKnownCall wellKnown) =
  Some (wellKnownResponse account wellKnown)
readHandled account store (QueryCall nsid params)
  | nsid == getRecordNsid =
    Some (finishRead (applyGetRecord account store params))
  | nsid == listRecordsNsid =
    Some (finishRead (applyListRecords account store params))
  | nsid == describeRepoNsid =
    Some (finishRead (applyDescribeRepo account store params))
  | nsid == getRepoNsid =
    Some (collapseResponse (applyGetRepo account store params))
  | nsid == getLatestCommitNsid =
    Some (finishRead (applyGetLatestCommit account store params))
  | nsid == getBlobNsid =
    Some (collapseResponse (applyGetBlob account store params))
  | nsid == listBlobsNsid =
    Some (finishRead (applyListBlobs account store params))
  | nsid == resolveHandleNsid =
    Some (finishRead (applyResolveHandle account params))
  | otherwise = None
readHandled _ _ _ = None

-- ── the whole Phase-4 API ───────────────────────────────────────────────────

{- | The complete handler: five record writes, four session routes, eight
   reads, two well-knowns. The halves are disjoint by construction — each owns
   a distinct set of NSIDs, and the read half additionally owns the two
   well-knowns — so the order below is a formality rather than a
   precedence. -}
export
pdsHandler : Account -> Handler
pdsHandler account context outcome store call =
  match recordHandled account store call
    Some result => result
    None => match sessionHandled account context outcome store call
      Some result => result
      None => match readHandled account store call
        Some response => (store, response)
        None => (store, unhandledRoute call)

-- | The registry of all seventeen XRPC endpoints. The two well-known paths are
-- NOT here: they have no NSID, and `lib.xrpc` routes them by path.
export
pdsRegistry : Result String Registry
pdsRegistry = do
  writes <- recordEndpoints
  sessions <- sessionEndpoints
  reads <- readEndpoints
  makeRegistry (concatEndpoints writes (concatEndpoints sessions reads))

{- | The eight read queries, every one of them public.

   A repository is public data on atproto: `com.atproto.repo.getRecord`,
   `listRecords` and `describeRepo`, and the `com.atproto.sync.*` pair another
   server's relay reads to mirror this repo, are all reachable on a real PDS
   with no credential — and so is `com.atproto.identity.resolveHandle`, which
   is how a client finds this account before it could have a token at all. A
   server that closed these would not be a stricter PDS; it would be one no
   client and no relay can use.

   The classification is per route, not per kind: a future public procedure
   would say `PublicRoute` here and be right, and a future private query would
   say `AuthenticatedRoute` and be right too. -}
readEndpoints : Result String (List Endpoint)
readEndpoints = do
  getRecord <- queryEndpoint getRecordNsid PublicRoute
  listRecords <- queryEndpoint listRecordsNsid PublicRoute
  describeRepo <- queryEndpoint describeRepoNsid PublicRoute
  getRepo <- queryEndpoint getRepoNsid PublicRoute
  getLatestCommit <- queryEndpoint getLatestCommitNsid PublicRoute
  getBlob <- queryEndpoint getBlobNsid PublicRoute
  listBlobs <- queryEndpoint listBlobsNsid PublicRoute
  resolveHandle <- queryEndpoint resolveHandleNsid PublicRoute
  Ok [
    getRecord,
    listRecords,
    describeRepo,
    getRepo,
    getLatestCommit,
    getBlob,
    listBlobs,
    resolveHandle,
  ]

concatEndpoints : List Endpoint -> List Endpoint -> List Endpoint
concatEndpoints [] rest = rest
concatEndpoints (endpoint :: more) rest = endpoint :: concatEndpoints more rest

-- | A configured full-API server for one account.
export
pdsServer : Account -> Result String Server
pdsServer account = do
  registry <- pdsRegistry
  Ok (makeServer account registry (pdsHandler account))
