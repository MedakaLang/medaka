{- | Shared NSID validation and identity for repository collections and XRPC.

   Validation reports a typed cause. Callers own their diagnostic prefix and
   may deliberately collapse details at a protocol boundary. -}

import bytes as B
import bytes.{Bytes, decodeUtf8, encodeUtf8}
import regex.{Regex, isFullMatchBytes, mustCompile}
import u8 as U8

public export data NsidError =
  | NsidTooLong
  | NsidMalformed
  | NsidAuthorityNeedsTwoSegments
  | NsidAuthoritySegmentLength
  | NsidAuthoritySegmentHyphen
  | NsidTopLevelStartsWithDigit
  | NsidAuthorityNotNormalized
  | NsidNameLength
  | NsidNameStart
  | NsidNameCharacters

lowerByte : Int -> Bool
lowerByte byte = byte >= 97 && byte <= 122

digitByte : Int -> Bool
digitByte byte = byte >= 48 && byte <= 57

alphaByte : Int -> Bool
alphaByte byte = lowerByte byte || byte >= 65 && byte <= 90

byteAt : Bytes -> Int -> Int
byteAt bytes i = U8.toInt bytes[i]

-- Each rule below reports its own cause, so only the character-set SCANS are
-- patterns; the length, hyphen and first-byte rules stay separate.
authorityCharsRe : Regex
authorityCharsRe = mustCompile "[a-zA-Z0-9-]*"

nameCharsRe : Regex
nameCharsRe = mustCompile "[a-zA-Z0-9]*"

validateAuthoritySegment : Bytes -> Int -> Int -> Bool -> Result NsidError Unit
validateAuthoritySegment bytes start end first =
  let size = end - start
  if size < 1 || size > 63 then
    Err NsidAuthoritySegmentLength
  else if byteAt bytes start == 45 || byteAt bytes (end - 1) == 45 then
    Err NsidAuthoritySegmentHyphen
  else if first && digitByte (byteAt bytes start) then
    Err NsidTopLevelStartsWithDigit
  else if not (isFullMatchBytes authorityCharsRe bytes start end) then
    Err NsidAuthorityNotNormalized
  else
    Ok ()

validateAuthority : Bytes -> Int -> Int -> Int -> Int -> Result NsidError Int
validateAuthority bytes i end segmentStart segments =
  if i >= end then do
    () <- validateAuthoritySegment bytes segmentStart end (segments == 0)
    Ok (segments + 1)
  else if byteAt bytes i == 46 then do
    () <- validateAuthoritySegment bytes segmentStart i (segments == 0)
    validateAuthority bytes (i + 1) end (i + 1) (segments + 1)
  else
    validateAuthority bytes (i + 1) end segmentStart segments

lastDotBefore : Bytes -> Int -> Int -> Int -> Int
lastDotBefore bytes i end last =
  if i >= end then
    last
  else if byteAt bytes i == 46 then
    lastDotBefore bytes (i + 1) end i
  else
    lastDotBefore bytes (i + 1) end last

validateName : Bytes -> Int -> Int -> Result NsidError Unit
validateName bytes start end =
  let size = end - start
  if size < 1 || size > 63 then
    Err NsidNameLength
  else if digitByte (byteAt bytes start)
    || not (alphaByte (byteAt bytes start)) then
    Err NsidNameStart
  else if not (isFullMatchBytes nameCharsRe bytes start end) then
    Err NsidNameCharacters
  else
    Ok ()

-- | Validate the first `end` bytes as one NSID. The prefix form
-- lets repository paths validate their collection without copying the rkey.
-- The total is capped at 317 and the authority has no separate cap
-- (`interop_nsid_valid.txt` holds a valid NSID with a 283-character
-- authority); each segment (1-63) and the name (1-63) are still bounded.
export
validateNsidPrefix : Bytes -> Int -> Result NsidError Unit
validateNsidPrefix bytes end =
  if end < 0 || end > B.length bytes then
    Err NsidMalformed
  else if end > 317 then
    Err NsidTooLong
  else
    let lastDot = lastDotBefore bytes 0 end (-1)
    if lastDot <= 0 || lastDot >= end - 1 then
      Err NsidMalformed
    else do
      segments <- validateAuthority bytes 0 lastDot 0 0
      if segments < 2 then
        Err NsidAuthorityNeedsTwoSegments
      else
        validateName bytes (lastDot + 1) end

-- | Validate a complete NSID string.
export
validateNsid : String -> Result NsidError Unit
validateNsid nsid =
  let bytes = encodeUtf8 nsid
  validateNsidPrefix bytes (B.length bytes)

-- | `byte` lowered when it is an ASCII capital letter, and unchanged
-- otherwise.
export
lowerAsciiByte : U8 -> U8
lowerAsciiByte byte = if byte >= 65 && byte <= 90 then byte + 32 else byte

sameIdentityBytes : Bytes -> Bytes -> Int -> Int -> Bool
sameIdentityBytes left right authorityEnd i =
  if i >= B.length left then
    True
  else
    let leftByte = left[i]
    let rightByte = right[i]
    let same =
      if i < authorityEnd then
        lowerAsciiByte leftByte == lowerAsciiByte rightByte
      else
        leftByte == rightByte
    same && sameIdentityBytes left right authorityEnd (i + 1)

-- | Compare NSID identity using a case-insensitive authority and a
-- case-sensitive method name. Callers retain the original spelling.
export
sameNsidIdentity : String -> String -> Bool
sameNsidIdentity left right =
  let leftBytes = encodeUtf8 left
  let rightBytes = encodeUtf8 right
  let leftSize = B.length leftBytes
  let rightSize = B.length rightBytes
  let leftDot = lastDotBefore leftBytes 0 leftSize (-1)
  let rightDot = lastDotBefore rightBytes 0 rightSize (-1)
  leftSize == rightSize
    && leftDot == rightDot
    && leftDot >= 0
    && sameIdentityBytes leftBytes rightBytes leftDot 0

{- | The one spelling of this NSID that stands for its identity: the authority
   folded to lowercase, the method name left exactly as written.

   `sameNsidIdentity` decides identity without producing a value, which is
   enough for a comparison and not enough for a decision that has to be
   RECORDED. A forwarded call signs the method it was admitted for, and the
   value signed must be the one the admission was taken against rather than the
   client's own bytes, which merely compared equal. Two NSIDs are
   `sameNsidIdentity` exactly when their canonical spellings are equal.

   The input is assumed to have passed `validateNsid`; a string with no dot is
   returned unchanged rather than rejected, since nothing here decides
   admission. So is one whose bytes are not UTF-8, which `validateNsid` would
   have refused: folding changes only ASCII letters, so the folded bytes
   decode exactly when the input's do.

   > canonicalNsid "Com.Example.getThing"
   "com.example.getThing"
   > canonicalNsid "noDot"
   "noDot" -}
export
canonicalNsid : String -> String
canonicalNsid nsid =
  let bytes = encodeUtf8 nsid
  let authorityEnd = lastDotBefore bytes 0 (B.length bytes) (-1)
  let folded =
    B.fromU8Array
      (arrayMakeWith (B.length bytes) (i =>
        if i < authorityEnd then lowerAsciiByte bytes[i] else bytes[i]))
  match decodeUtf8 folded
    Some canonical => canonical
    None => nsid

-- | Stable repository-facing wording retained while the validation authority
-- moves into this shared module.
export
nsidErrorMessage : NsidError -> String
nsidErrorMessage NsidTooLong = "collection NSID exceeds 317 characters"
nsidErrorMessage NsidMalformed = "collection must be a valid normalized NSID"
nsidErrorMessage NsidAuthorityNeedsTwoSegments =
  "collection NSID authority needs at least two segments"
nsidErrorMessage NsidAuthoritySegmentLength =
  "invalid collection NSID authority segment length"
nsidErrorMessage NsidAuthoritySegmentHyphen =
  "invalid collection NSID authority segment hyphen"
nsidErrorMessage NsidTopLevelStartsWithDigit =
  "invalid collection NSID top-level segment"
nsidErrorMessage NsidAuthorityNotNormalized =
  "collection NSID authority contains invalid characters"
nsidErrorMessage NsidNameLength = "invalid collection NSID name length"
nsidErrorMessage NsidNameStart = "invalid collection NSID name start"
nsidErrorMessage NsidNameCharacters = "invalid collection NSID name characters"

-- | The same causes worded for a method NSID (an `lxm` claim), which names a
-- method and not a collection.
export
nsidMethodErrorMessage : NsidError -> String
nsidMethodErrorMessage NsidTooLong = "method NSID exceeds 317 characters"
nsidMethodErrorMessage NsidMalformed = "method must be a valid normalized NSID"
nsidMethodErrorMessage NsidAuthorityNeedsTwoSegments =
  "method NSID authority needs at least two segments"
nsidMethodErrorMessage NsidAuthoritySegmentLength =
  "invalid method NSID authority segment length"
nsidMethodErrorMessage NsidAuthoritySegmentHyphen =
  "invalid method NSID authority segment hyphen"
nsidMethodErrorMessage NsidTopLevelStartsWithDigit =
  "invalid method NSID top-level segment"
nsidMethodErrorMessage NsidAuthorityNotNormalized =
  "method NSID authority contains invalid characters"
nsidMethodErrorMessage NsidNameLength = "invalid method NSID name length"
nsidMethodErrorMessage NsidNameStart = "invalid method NSID name start"
nsidMethodErrorMessage NsidNameCharacters =
  "invalid method NSID name characters"
