{- | Opaque atproto CIDv1 values.

   Atproto blesses exactly CIDv1 with `raw` or `dag-cbor`/DRISL codec,
   SHA-256 multihash, and a 32-byte digest. Text form is lowercase unpadded
   base32 multibase (`b...`). The constructor is private so callers cannot
   fabricate a CID that violates those invariants. -}

import lib.multiformats.{
  multibaseBase32Lower,
  multibaseBase32LowerDecode,
  multicodecDagCbor,
  multicodecRaw,
  multicodecSha2_256,
  uvarintDecode,
  uvarintEncode,
}
import bytes.{Bytes}
import bytes as B
import crypto.sha256.{sha256}

-- | An admitted atproto CID. Its constructor is private to this module.
export data Cid = Cid Int Bytes

validCodec : Int -> Bool
validCodec codec = codec == multicodecRaw || codec == multicodecDagCbor

{- | Construct an admitted CID from a codec and SHA-256 digest. -}
export
cidFromDigest : Int -> Bytes -> Result String Cid
cidFromDigest codec digest =
  if not (validCodec codec) then
    Err "cid: codec must be raw (0x55) or dag-cbor/DRISL (0x71)"
  else if B.length digest /= 32 then
    Err "cid: SHA-256 digest length must be 32 bytes"
  else
    Ok (Cid codec digest)

-- | Content-address a structured DAG-CBOR/DRISL block.
export
cidForDagCbor : Bytes -> Cid
cidForDagCbor content = Cid multicodecDagCbor (sha256 content)

-- | Content-address a raw blob.
export
cidForRaw : Bytes -> Cid
cidForRaw content = Cid multicodecRaw (sha256 content)

-- | The admitted codec code.
export
cidCodec : Cid -> Int
cidCodec (Cid codec _) = codec

-- | The 32-byte digest.
export
cidDigest : Cid -> Bytes
cidDigest (Cid _ digest) = digest

-- | Canonical binary CIDv1 serialization.
export
cidToBytes : Cid -> Bytes
cidToBytes (Cid codec digest) =
  uvarintEncode 1
    ++ uvarintEncode codec
    ++ uvarintEncode multicodecSha2_256
    ++ uvarintEncode 32
    ++ digest

decodeAt : String -> Bytes -> Int -> Result String (Int, Int)
decodeAt label bytes offset =
  if offset >= B.length bytes then
    Err "cid: truncated before \{label}"
  else match uvarintDecode (B.drop offset bytes)
    Err message => Err "cid: \{label}: \{message}"
    Ok (value, consumed) => Ok (value, offset + consumed)

{- | Parse and validate one complete binary atproto CID. -}
export
cidFromBytes : Bytes -> Result String Cid
cidFromBytes bytes = match decodeAt "version" bytes 0
  Err message => Err message
  Ok (version, p1) =>
    if version /= 1 then
      Err "cid: version must be 1"
    else match decodeAt "codec" bytes p1
      Err message => Err message
      Ok (codec, p2) =>
        if not (validCodec codec) then
          Err "cid: codec must be raw (0x55) or dag-cbor/DRISL (0x71)"
        else match decodeAt "hash code" bytes p2
          Err message => Err message
          Ok (hashCode, p3) =>
            if hashCode /= multicodecSha2_256 then
              Err "cid: hash code must be sha2-256 (0x12)"
            else match decodeAt "hash length" bytes p3
              Err message => Err message
              Ok (hashLength, p4) =>
                if hashLength /= 32 then
                  Err "cid: SHA-256 digest length must be 32 bytes"
                else if B.length bytes - p4 < 32 then
                  Err "cid: truncated SHA-256 digest"
                else if B.length bytes - p4 > 32 then
                  Err "cid: trailing bytes after SHA-256 digest"
                else
                  cidFromDigest codec (B.take 32 (B.drop p4 bytes))

-- | Canonical lowercase unpadded base32 CID string.
export
cidToString : Cid -> String
cidToString cid = multibaseBase32Lower (cidToBytes cid)

-- | Parse one canonical atproto CID string.
export
cidFromString : String -> Result String Cid
cidFromString text = match multibaseBase32LowerDecode text
  Err message => Err "cid: \{message}"
  Ok bytes => cidFromBytes bytes

-- | Constant-shape value equality (not a timing claim).
export
cidEqual : Cid -> Cid -> Bool
cidEqual left right = cidToBytes left == cidToBytes right

-- | Whether a CID occurs in a list under CID identity.
export
cidMember : Cid -> List Cid -> Bool
cidMember _ [] = False
cidMember cid (candidate :: rest) = cidEqual cid candidate || cidMember cid rest
