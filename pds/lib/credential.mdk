{- | The account password credential: what is stored in place of a password,
   and the one function that grades a presented password against it.

   A credential record is a PBKDF2-HMAC-SHA-256 derivation
   (`lib.pbkdf2`) of the account password under a per-account random salt,
   together with the salt and the iteration count that produced it. The
   password itself is never stored, never returned, and never reaches a
   diagnostic string: nothing in this module renders a password, a salt, or a
   digest, and `CredentialRecord`'s constructor is private so no caller can
   build one out of raw bytes without passing this module's admission.

   Pure function: no I/O, no clock, no entropy read in this module. The salt
   is caller-supplied, drawn from `osEntropyBytes` in the shell
   (`pds/serve.mdk`) — see `docs/design/ATPROTO-PDS-DESIGN.md` §4.2. -}

import lib.pbkdf2.{pbkdf2HmacSha256}
import string.{toUtf8}

{- | The iteration count this server derives account credentials at.

   1,500 is MEASURED on this box against a ~250 ms bootstrap budget for a
   pure-Medaka PBKDF2 (`docs/design/ATPROTO-PDS-DESIGN.md` §4.2), and it is
   far below OWASP's ≥600,000 floor for this algorithm — 600,000 iterations
   takes ~70 s here. It is an artifact of this implementation's speed, not a
   security recommendation. A record carries the count it was derived at, so
   raising this constant does not invalidate an existing credential. -}
export
defaultIterations : Int
defaultIterations = 1500

-- | How many bytes of salt a credential record carries.
export
saltBytes : Int
saltBytes = 16

-- | How many derived bytes a credential record carries.
export
digestBytes : Int
digestBytes = 32

{- | A stored account credential: the salt, the iteration count, and the
   derived key. Its representation is private, and nothing here exposes the
   password it was derived from, because nothing here ever held one past the
   derivation. -}
export data CredentialRecord = CredentialRecord (Array Int) Int (Array Int)

{- | Admit a credential record from its three stored parts, which is how one
   is read back from disk. The parts are graded here so a truncated or
   hand-edited credential file is refused where it is loaded rather than at
   the first login it would silently fail. -}
export
credentialFromParts : Array Int ->
  Int ->
  Array Int ->
  Result String CredentialRecord
credentialFromParts salt iterations digest =
  if arrayLength salt /= saltBytes then
    Err "credential: salt must be \{intToString saltBytes} bytes"
  else if iterations < 1 then
    Err "credential: iteration count must be at least 1"
  else if arrayLength digest /= digestBytes then
    Err "credential: derived key must be \{intToString digestBytes} bytes"
  else
    Ok (CredentialRecord (arrayCopy salt) iterations (arrayCopy digest))

{- | Derive a credential record for `password` under a caller-supplied salt.
   This is the only path that ever sees a password, and it keeps nothing of
   it: the returned record holds the derivation and the parameters alone. -}
export
makeCredential : Array Int -> Int -> String -> Result String CredentialRecord
makeCredential salt iterations password =
  if arrayLength salt /= saltBytes then
    Err "credential: salt must be \{intToString saltBytes} bytes"
  else if iterations < 1 then
    Err "credential: iteration count must be at least 1"
  else
    Ok
      (CredentialRecord
        (arrayCopy salt)
        iterations
        (pbkdf2HmacSha256 (toUtf8 password) salt iterations digestBytes))

-- | The salt this record was derived under. Persisted, not secret by itself.
export
credentialSalt : CredentialRecord -> Array Int
credentialSalt (CredentialRecord salt _ _) = arrayCopy salt

-- | The iteration count this record was derived at.
export
credentialIterations : CredentialRecord -> Int
credentialIterations (CredentialRecord _ iterations _) = iterations

-- | The derived key. It is the password verifier, so a caller that renders it
-- is publishing an offline-crackable value; only persistence needs it.
export
credentialDigest : CredentialRecord -> Array Int
credentialDigest (CredentialRecord _ _ digest) = arrayCopy digest

{- | Whether `password` is the password this record was derived from.

   The comparison XOR-accumulates over the whole digest with no early return,
   so the number of byte comparisons does not depend on where the first
   difference is. -}
export
credentialVerify : String -> CredentialRecord -> Bool
credentialVerify password (CredentialRecord salt iterations digest) =
  ctEqBytes
    digest
    (pbkdf2HmacSha256 (toUtf8 password) salt iterations digestBytes)

xorAccum : Array Int -> Array Int -> Int -> Int -> Int
xorAccum a b i acc =
  if i >= arrayLength a then
    acc
  else
    xorAccum a b (i + 1) (bitOr acc (bitXor a[i] b[i]))

{- | Constant-time byte-array equality, exported because every other
   secret-comparison site in `pds/lib` needs exactly this and there is
   otherwise no shared spelling of it (`lib.jwt` keeps a private copy for its
   own MAC comparison, which must not depend on this module).

   Lengths are compared first and in the clear: an array's length is not a
   secret here, and comparing arrays of different lengths has no well-defined
   constant-time meaning. -}
export
ctEqBytes : Array Int -> Array Int -> Bool
ctEqBytes a b =
  if arrayLength a /= arrayLength b then False else xorAccum a b 0 0 == 0
