{- | The account password credential: what is stored in place of a password,
   and how a presented password is graded against it, whole
   (`credentialVerify`) or a bounded slice at a time (`LoginCheck`).

   A credential record is a PBKDF2-HMAC-SHA-256 derivation
   (`pbkdf2`) of the account password under a per-account random salt,
   together with the salt and the iteration count that produced it. The
   password itself is never stored, never returned, and never reaches a
   diagnostic string: nothing in this module renders a password, a salt, or a
   digest, and `CredentialRecord`'s constructor is private so no caller can
   build one out of raw bytes without passing this module's admission.

   Pure function: no I/O, no clock, no entropy read in this module. The salt
   is caller-supplied, drawn from `osEntropyBytes` in the shell
   (`pds/serve.mdk`) — see `docs/design/ATPROTO-PDS-DESIGN.md` §4.2. -}

import array.{blit, concat, make, setInPlace}
import bytes.{fromArray, fromArrayAssumeByteDomain, toArray}
import hmac.{ctEq}
import hmac.{HmacSha256Key, hmacSha256Key, hmacSha256WithKey}
import pbkdf2.{pbkdf2HmacSha256}
import string.{toUtf8}

{- | The iteration count this server derives account credentials at.

   3,000 is the highest count that fits a 500 ms login-latency budget at the
   0.147 ms per iteration a pure-Medaka PBKDF2 costs on the reference box
   (`docs/design/ATPROTO-PDS-DESIGN.md` §4.2, which records the measurement
   and the budget). That is 200x short of OWASP's ≥600,000 floor for this
   algorithm, so this count is what the implementation can afford and not a
   security recommendation: the floor needs a native SHA-256, since 600,000
   iterations is ~88 s of this one.

   The budget is a login-latency budget: the server pays for a login's
   derivations a slice at a time (`LoginCheck`), between slices of other
   connections' work, so the count sets how long one login takes rather than
   how long every other connection waits behind it.

   A record carries the count it was derived at, so raising this constant
   locks nobody out; a successful login's `LoginVerdict` is what moves an
   existing record onto it. -}
export
defaultIterations : Int
defaultIterations = 3000

-- | How many bytes of salt a credential record carries.
export
saltBytes : Int
saltBytes = 16

-- | How many derived bytes a credential record carries.
export
digestBytes : Int
digestBytes = 32

{- | A stored account credential: the salt, the iteration count, and the
   derived key. Its representation is private, and nothing here exposes the
   password it was derived from, because nothing here ever held one past the
   derivation. -}
export data CredentialRecord = CredentialRecord (Array Int) Int (Array Int)

{- | Admit a credential record from its three stored parts, which is how one
   is read back from disk. The parts are graded here so a truncated or
   hand-edited credential file is refused where it is loaded rather than at
   the first login it would silently fail. -}
export
credentialFromParts : Array Int ->
  Int ->
  Array Int ->
  Result String CredentialRecord
credentialFromParts salt iterations digest =
  if arrayLength salt /= saltBytes then
    Err "credential: salt must be \{intToString saltBytes} bytes"
  else if iterations < 1 then
    Err "credential: iteration count must be at least 1"
  else if arrayLength digest /= digestBytes then
    Err "credential: derived key must be \{intToString digestBytes} bytes"
  else
    Ok (CredentialRecord (arrayCopy salt) iterations (arrayCopy digest))

{- | Derive a credential record for `password` under a caller-supplied salt.
   This is the only path that ever sees a password, and it keeps nothing of
   it: the returned record holds the derivation and the parameters alone. -}
export
makeCredential : Array Int -> Int -> String -> Result String CredentialRecord
makeCredential salt iterations password =
  if arrayLength salt /= saltBytes then
    Err "credential: salt must be \{intToString saltBytes} bytes"
  else if iterations < 1 then
    Err "credential: iteration count must be at least 1"
  else
    Ok
      (CredentialRecord
        (arrayCopy salt)
        iterations
        (pbkdf2HmacSha256 (toUtf8 password) salt iterations digestBytes))

-- | The salt this record was derived under. Persisted, not secret by itself.
export
credentialSalt : CredentialRecord -> Array Int
credentialSalt (CredentialRecord salt _ _) = arrayCopy salt

-- | The iteration count this record was derived at.
export
credentialIterations : CredentialRecord -> Int
credentialIterations (CredentialRecord _ iterations _) = iterations

-- | The derived key. It is the password verifier, so a caller that renders it
-- is publishing an offline-crackable value; only persistence needs it.
export
credentialDigest : CredentialRecord -> Array Int
credentialDigest (CredentialRecord _ _ digest) = arrayCopy digest

{- | Whether `password` is the password this record was derived from.

   The comparison XOR-accumulates over the whole digest with no early return,
   so the number of byte comparisons does not depend on where the first
   difference is. -}
export
credentialVerify : String -> CredentialRecord -> Bool
credentialVerify password (CredentialRecord salt iterations digest) =
  ctEq digest (pbkdf2HmacSha256 (toUtf8 password) salt iterations digestBytes)

{- | A PBKDF2-HMAC-SHA-256 derivation that is paid for a slice at a time.

   It derives exactly what `pbkdf2HmacSha256` derives, but as a value that
   `pbkdf2Advance` moves forward by a bounded number of HMAC calls, so the
   caller decides where the derivation may be interrupted. The server needs
   that because a whole derivation at a login-grade iteration count is long
   enough to stall every other connection if nothing can run in between.

   The value holds the password's precomputed HMAC key, so it derives no
   `Debug` and nothing here renders it. -}
export data Pbkdf2Steps =
  | Pbkdf2Running HmacSha256Key (Array Int) Int Int Int (Array Int) (Array Int) Int (Array Int)
  | Pbkdf2Finished (Array Int)

-- The HMAC-SHA-256 output length, which is also one PBKDF2 block's length.
hashLength : Int
hashLength = 32

{- | The first unpaid-for state of a derivation of `dkLen` bytes from
   `password` and `salt` over `iterations` rounds. No HMAC has run yet.

   Panics on exactly the inputs `pbkdf2HmacSha256` panics on: `iterations` or
   `dkLen` below 1, or an element of `password` or `salt` outside `0` to
   `255`. -}
export
pbkdf2Begin : Array Int -> Array Int -> Int -> Int -> Pbkdf2Steps
pbkdf2Begin password salt iterations dkLen =
  if iterations < 1 then
    panic "pbkdf2: iterations must be >= 1"
  else if dkLen < 1 then
    panic "pbkdf2: dkLen must be >= 1"
  else
    let passwordBytes =
      optionOrPanic
        "pbkdf2: every element of password must be a byte in 0..255"
        (fromArray password)
    let _ =
      optionOrPanic
        "pbkdf2: every element of salt must be a byte in 0..255"
        (fromArray salt)
    Pbkdf2Running
      (hmacSha256Key passwordBytes)
      (arrayCopy salt)
      iterations
      dkLen
      1
      (make 0 0)
      (make 0 0)
      0
      (make dkLen 0)

{- | `steps` moved forward by at most `budget` HMAC calls. A finished
   derivation is returned as it is.

   The state passed in is not modified: the running block and the output are
   copied once per call, then updated in place for the rest of the call. -}
export
pbkdf2Advance : Int -> Pbkdf2Steps -> Pbkdf2Steps
pbkdf2Advance _ (Pbkdf2Finished derived) = Pbkdf2Finished derived
pbkdf2Advance budget (Pbkdf2Running key salt iterations dkLen blockIndex acc prevU j out) =
  runSteps
    budget
    key
    salt
    iterations
    dkLen
    blockIndex
    (arrayCopy acc)
    prevU
    j
    (arrayCopy out)

-- The loop under `pbkdf2Advance`, one HMAC call per step. `acc` holds block
-- `blockIndex`'s XOR of U_1 .. U_j and `prevU` holds U_j; `j = 0` means the
-- block has not started. A block that has folded all `iterations` rounds is
-- written into `out` before the budget is consulted, so the call that pays
-- for the last round also returns the finished key.
runSteps : Int ->
  HmacSha256Key ->
  Array Int ->
  Int ->
  Int ->
  Int ->
  Array Int ->
  Array Int ->
  Int ->
  Array Int ->
  Pbkdf2Steps
runSteps budget key salt iterations dkLen blockIndex acc prevU j out =
  if j >= iterations then
    let offset = (blockIndex - 1) * hashLength
    let () = blit acc 0 out offset (min (dkLen - offset) hashLength)
    if offset + hashLength >= dkLen then
      Pbkdf2Finished out
    else
      runSteps
        budget
        key
        salt
        iterations
        dkLen
        (blockIndex + 1)
        (make 0 0)
        (make 0 0)
        0
        out
  else if budget < 1 then
    Pbkdf2Running key salt iterations dkLen blockIndex acc prevU j out
  else if j == 0 then
    let message = concat [|salt, blockIndexBytes blockIndex|]
    let u1 = toArray (hmacSha256WithKey key (fromArrayAssumeByteDomain message))
    runSteps
      (budget - 1)
      key
      salt
      iterations
      dkLen
      blockIndex
      (arrayCopy u1)
      u1
      1
      out
  else
    let u = toArray (hmacSha256WithKey key (fromArrayAssumeByteDomain prevU))
    let () = xorInPlace acc u 0
    runSteps (budget - 1) key salt iterations dkLen blockIndex acc u (j + 1) out

-- Big-endian 4-byte encoding of a PBKDF2 block index (RFC 2898 §5.2,
-- `INT (i)`).
blockIndexBytes : Int -> Array Int
blockIndexBytes n = [|
  bitAnd (shiftRight n 24) 255,
  bitAnd (shiftRight n 16) 255,
  bitAnd (shiftRight n 8) 255,
  bitAnd n 255,
|]

xorInPlace : Array Int -> Array Int -> Int -> Unit
xorInPlace acc u i =
  if i >= arrayLength acc then
    ()
  else
    let () = setInPlace i (bitXor acc[i] u[i]) acc
    xorInPlace acc u (i + 1)

-- | The derived key, once every round has been paid for.
export
pbkdf2Output : Pbkdf2Steps -> Option (Array Int)
pbkdf2Output (Pbkdf2Finished derived) = Some (arrayCopy derived)
pbkdf2Output (Pbkdf2Running _ _ _ _ _ _ _ _ _) = None

{- | What one login attempt concluded about a stored credential record.

   It names the record it was computed against, whether the presented
   password matched that record, and, when it matched and the record predates
   the target iteration count, the record the password should be re-stored
   as. It is a conclusion about that record only: `loginOutcome` is what
   decides whether it still applies to the record a store holds now. -}
export data LoginVerdict =
  | LoginVerdict CredentialRecord Bool (Option CredentialRecord)

{- | A login attempt's derivations in progress: first the presented password
   under the stored record's salt and count, then, only if it matched a record
   derived at some other count, the same password under a new salt at the
   target count. -}
export data LoginCheck =
  | CheckingPassword CredentialRecord (Array Int) (Array Int) Int Pbkdf2Steps
  | DerivingUpgrade CredentialRecord (Array Int) Int Pbkdf2Steps
  | LoginSettled LoginVerdict

{- | A login check of `password` against `record` that has run no derivation
   yet. `salt` and `iterations` are what a successful login re-derives the
   record under when `record` was derived at a count other than `iterations`.

   The salt is caller-supplied and new: a re-derivation that kept the old salt
   would republish the same salt-and-password pair at a second cost, which is
   what a rotation is supposed to leave behind. A salt of the wrong length, or
   a count below 1, offers no upgrade at all. -}
export
loginCheckBegin : String -> Array Int -> Int -> CredentialRecord -> LoginCheck
loginCheckBegin password salt iterations record =
  let presented = toUtf8 password
  CheckingPassword
    record
    presented
    (arrayCopy salt)
    iterations
    (pbkdf2Begin
      presented
      (credentialSalt record)
      (credentialIterations record)
      digestBytes)

{- | `check` moved forward by at most `budget` HMAC calls.

   The password is graded against the record before any upgrade is derived,
   so a wrong password never pays for, or produces, a second record. -}
export
loginCheckAdvance : Int -> LoginCheck -> LoginCheck
loginCheckAdvance _ (LoginSettled verdict) = LoginSettled verdict
loginCheckAdvance budget (CheckingPassword record presented salt iterations steps) =
  let next = pbkdf2Advance budget steps
  match pbkdf2Output next
    None => CheckingPassword record presented salt iterations next
    Some derived =>
      if not (digestIs record derived) then
        LoginSettled (LoginVerdict record False None)
      else if credentialIterations record == iterations then
        LoginSettled (LoginVerdict record True None)
      else if arrayLength salt /= saltBytes || iterations < 1 then
        LoginSettled (LoginVerdict record True None)
      else
        DerivingUpgrade
          record
          salt
          iterations
          (pbkdf2Begin presented salt iterations digestBytes)
loginCheckAdvance budget (DerivingUpgrade record salt iterations steps) =
  let next = pbkdf2Advance budget steps
  match pbkdf2Output next
    None => DerivingUpgrade record salt iterations next
    Some derived =>
      LoginSettled
        (LoginVerdict
          record
          True
          (Some (CredentialRecord salt iterations derived)))

-- | The verdict, once every derivation the check needs has been paid for.
export
loginCheckVerdict : LoginCheck -> Option LoginVerdict
loginCheckVerdict (LoginSettled verdict) = Some verdict
loginCheckVerdict (CheckingPassword _ _ _ _ _) = None
loginCheckVerdict (DerivingUpgrade _ _ _ _) = None

{- | What a login verdict means against the record a store holds at the
   moment the login would be recorded. `LoginAcceptedUpgrading` carries the
   record to re-store the credential as. -}
public export data LoginOutcome =
  | LoginRefused
  | LoginAccepted
  | LoginAcceptedUpgrading CredentialRecord

{- | Whether `verdict` admits a login against `current`, the record the store
   holds when the login would be recorded.

   A verdict computed against any other record is refused whatever it says:
   the password it graded may have been superseded, and the upgrade it
   carries would overwrite a record it never saw. -}
export
loginOutcome : LoginVerdict -> CredentialRecord -> LoginOutcome
loginOutcome (LoginVerdict graded matched upgrade) current =
  if not (sameRecord graded current) then
    LoginRefused
  else if not matched then
    LoginRefused
  else match upgrade
    None => LoginAccepted
    Some upgraded => LoginAcceptedUpgrading upgraded

sameRecord : CredentialRecord -> CredentialRecord -> Bool
sameRecord (CredentialRecord salt iterations stored) current =
  credentialIterations current == iterations
    && credentialSalt current == salt
    && digestIs current stored

-- Whether `derived` is `record`'s derived key, compared in constant time.
digestIs : CredentialRecord -> Array Int -> Bool
digestIs (CredentialRecord _ _ digest) derived = ctEq digest derived
