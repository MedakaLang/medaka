{- | JWT bearer tokens (RFC 7519) in the JWS Compact Serialization
   (RFC 7515 §7.1), in the two shapes this server mints: session tokens,
   signed with HS256 (HMAC-SHA-256) over the server's own symmetric secret,
   and service-auth tokens, signed with ES256K over one account's secp256k1
   repo key.

   Pure functions: no I/O, no clock, no entropy read in this module. Every
   key is caller-supplied — the session secret as a 32-byte `Array Int`, the
   service-auth key as a `lib.sign.SecretKey` — and so is the current instant,
   an `Int` of seconds since the Unix epoch, and every `jti`. `verifyToken`
   never reads a clock, so a test can place itself at any instant and the
   shell layer owns the secrets, the time source and the entropy.

   The secret is the SERVER's, deliberately not the account's secp256k1
   signing key: that key authenticates commits to every other implementation
   on the network, and a token-minting path is a second, much larger attack
   surface on it for no interop gain, since nothing off-box ever verifies our
   session tokens. See `docs/design/ATPROTO-PDS-DESIGN.md` §4.3.

   That argument is scoped to SESSION tokens, and does not reach service auth —
   the credential presented to an off-box appview when proxying a read. There
   the verifier is a peer holding no secret of ours, so the only key it can
   check is the account's, and service auth IS signed with it, as `ES256K`
   over a different claim set (no `nbf`, no `sub`, plus `lxm`). So `Claims`
   below is the session-token claim set and `ServiceAuthRequest` what a caller
   supplies for the service-auth one; neither is a shape to reuse for the
   other. That wire shape is
   P16/§4.5 of the same document, and
   `pds/test/vectors/pds_service_auth_shape_corpus.txt` records it byte-exact
   as the official implementation's own `createServiceJwt` emits it.

   Service auth is minted here and never verified here: the party that checks
   one is an off-box peer resolving the issuer's key from the network, so a
   verifier on this side would only grade this module against itself.

   `HS256` is pinned by the verifier, not read from the token. A token's own
   `alg` header is attacker-controlled input; selecting the verification
   algorithm from it is the classic algorithm-confusion forgery, of which
   `"alg": "none"` is one instance. `verifyToken` always computes HS256 and
   additionally rejects a header that claims anything else.

   Graded against RFC 7520 §4.4's published HS256 worked example, and the
   service-auth half against the official implementation's own captured wire
   shape plus an `@atproto/crypto` verification of a minted token
   (`pds/test/jwt_test.mdk` and `pds/tools/check_pds_service_jwt.mjs`,
   provenance in `pds/test/VECTOR-PROVENANCE.txt`) — G5: no expected value
   here is graded only against this implementation. -}

import base64.{decodeUrlSafe, encodeUrlSafe}
import json.{Json, Json(..), asInt, asString, get, jObject, parse, stringify}
import sha256.{sha256}
import string.{fromUtf8, indexOf, split, stripSuffix, take, toUtf8}
import lib.hmac_sha256.{hmacSha256FixedKey}
import lib.sign.{SecretKey, signDigest, signatureCompact}

{- | The claim set this server mints and accepts. `iat`, `nbf`, and `exp` are
     seconds since the Unix epoch (RFC 7519 §2 "NumericDate").

     `jti` (RFC 7519 §4.1.7) is the token's own identifier, and it is required
     rather than optional: without it two tokens minted for the same subject
     and audience in the same second are byte-identical, so a session opened
     twice — or a refresh token rotated in the same second it was issued —
     would be indistinguishable from its own predecessor. The caller supplies
     the value; this module never generates one. -}
public export data Claims = Claims {
  sub : String,
  aud : String,
  jti : String,
  iat : Int,
  nbf : Int,
  exp : Int,
}
  deriving (Eq, Debug)

-- | Why a token was refused. Every constructor is a rejection; there is no
--   "accepted with warnings" state.
public export data JwtError =
  | JwtMalformed
  | JwtUnsupportedAlg String
  | JwtBadSignature
  | JwtBadClaims String
  | JwtNotYetValid
  | JwtExpired
  | JwtWrongSubject
  | JwtWrongAudience
  deriving (Eq, Debug)

{- | How many bytes a server session-token secret is. Exported because
     `lib.store` admits the secret it carries against this length, so a
     misconfigured secret is refused where it is installed rather than
     reaching `hs256Signature`'s panic on a request path. -}
export
serverSecretBytes : Int
serverSecretBytes = 32

-- RFC 7515 §2 requires base64url with the trailing `=` omitted, while
-- `base64.encodeUrlSafe`/`decodeUrlSafe` are RFC 4648 §5 and keep the
-- padding, `decodeUrlSafe` rejecting any length that is not a multiple of
-- four. These two adapt between the conventions.
stripPadding : String -> String
stripPadding s = match stripSuffix "=" s
  Some shorter => stripPadding shorter
  None => s

-- These two share `base64.encode`/`decode`'s signature but not their
-- alphabet or their padding convention, which is the whole reason they
-- exist; rule-stdlib-reimpl compares declared signatures only, so it flags
-- both — disabled for this file rather than delegated away.
-- lint-disable-file rule-stdlib-reimpl
b64uEncode : Array Int -> String
b64uEncode bytes = stripPadding (encodeUrlSafe bytes)

b64uDecode : String -> Result String (Array Int)
b64uDecode s = match stringLength s % 4
  0 => decodeUrlSafe s
  2 => decodeUrlSafe "\{s}=="
  3 => decodeUrlSafe "\{s}="
  _ => Err "jwt: segment length is not a valid unpadded base64url length"

-- XOR-accumulates across the whole array with no early return, so the number
-- of byte comparisons does not depend on where the first difference is. The
-- length check ahead of it is deliberate: lengths here are public (a
-- truncated segment is visible in the token text), and comparing arrays of
-- different lengths has no well-defined constant-time meaning.
xorAccum : Array Int -> Array Int -> Int -> Int -> Int
xorAccum a b i acc =
  if i >= arrayLength a then
    acc
  else
    xorAccum a b (i + 1) (bitOr acc (bitXor a[i] b[i]))

ctEqBytes : Array Int -> Array Int -> Bool
ctEqBytes a b =
  if arrayLength a /= arrayLength b then False else xorAccum a b 0 0 == 0

{- | The HS256 signature of a JWS Signing Input (RFC 7515 §5.1 step 5), as an
     unpadded base64url string.

     Exported so the RFC 7520 §4.4 worked example can grade this module
     against a published signing input and signature directly, independently
     of the header and claim shapes `mintToken` chooses. -}
export
hs256Signature : Array Int -> String -> String
hs256Signature secret signingInput =
  if arrayLength secret /= serverSecretBytes then
    panic "jwt: expected a 32-byte server secret"
  else
    b64uEncode (hmacSha256FixedKey secret (toUtf8 signingInput))

headerJson : Json
headerJson = jObject [("alg", JString "HS256"), ("typ", JString "JWT")]

claimsJson : Claims -> Json
claimsJson c = jObject [
  ("sub", JString c.sub),
  ("aud", JString c.aud),
  ("jti", JString c.jti),
  ("iat", JInt c.iat),
  ("nbf", JInt c.nbf),
  ("exp", JInt c.exp),
]

b64uEncodeText : String -> String
b64uEncodeText s = b64uEncode (toUtf8 s)

{- | A signed token for `sub` and `aud` identified by `jti`, valid from
     `issuedAt` until `expiresAt` (both seconds since the Unix epoch). `nbf`
     is `issuedAt`: this server mints no post-dated token. -}
export
mintToken : Array Int -> String -> String -> String -> Int -> Int -> String
mintToken secret sub aud jti issuedAt expiresAt =
  let claims = Claims {
    sub = sub,
    aud = aud,
    jti = jti,
    iat = issuedAt,
    nbf = issuedAt,
    exp = expiresAt,
  }
  let headerSeg = b64uEncodeText (stringify headerJson)
  let claimsSeg = b64uEncodeText (stringify (claimsJson claims))
  let signingInput = "\{headerSeg}.\{claimsSeg}"
  "\{signingInput}.\{hs256Signature secret signingInput}"

decodeSegmentJson : String -> Result String Json
decodeSegmentJson segment = match b64uDecode segment
  Err e => Err e
  Ok bytes => parse (fromUtf8 bytes)

-- The pinned algorithm check. The token's `alg` is only ever compared
-- against the one this module already used; it never selects anything.
checkAlg : String -> Result JwtError Unit
checkAlg headerSeg = match decodeSegmentJson headerSeg
  Err _ => Err JwtMalformed
  Ok header => match map asString (get "alg" header)
    Some (Some "HS256") => Ok ()
    Some (Some other) => Err (JwtUnsupportedAlg other)
    _ => Err (JwtUnsupportedAlg "")

payloadJson : String -> Result JwtError Json
payloadJson claimsSeg = match decodeSegmentJson claimsSeg
  Err _ => Err JwtMalformed
  Ok payload => Ok payload

stringClaim : String -> Json -> Result JwtError String
stringClaim name payload = match map asString (get name payload)
  Some (Some s) => Ok s
  _ => Err (JwtBadClaims name)

intClaim : String -> Json -> Result JwtError Int
intClaim name payload = match map asInt (get name payload)
  Some (Some n) => Ok n
  _ => Err (JwtBadClaims name)

readClaims : Json -> Result JwtError Claims
readClaims payload = do
  sub <- stringClaim "sub" payload
  aud <- stringClaim "aud" payload
  jti <- stringClaim "jti" payload
  iat <- intClaim "iat" payload
  nbf <- intClaim "nbf" payload
  exp <- intClaim "exp" payload
  Ok Claims { sub = sub, aud = aud, jti = jti, iat = iat, nbf = nbf, exp = exp }

-- `exp` is exclusive and `nbf` inclusive, per RFC 7519 §4.1.4/§4.1.5.
checkWindow : Int -> Claims -> Result JwtError Claims
checkWindow now c =
  if now < c.nbf then
    Err JwtNotYetValid
  else if now >= c.exp then
    Err JwtExpired
  else
    Ok c

checkAudience : String -> String -> Claims -> Result JwtError Claims
checkAudience expectedSub expectedAud c =
  if c.sub /= expectedSub then
    Err JwtWrongSubject
  else if c.aud /= expectedAud then
    Err JwtWrongAudience
  else
    Ok c

verifySegments : Array Int ->
  String ->
  String ->
  Int ->
  String ->
  String ->
  String ->
  Result JwtError Claims
verifySegments secret expectedSub expectedAud now headerSeg claimsSeg sigSeg =
  let expected = hs256Signature secret "\{headerSeg}.\{claimsSeg}"
  if not (ctEqBytes (toUtf8 expected) (toUtf8 sigSeg)) then
    Err JwtBadSignature
  else match checkAlg headerSeg
    Err algError => Err algError
    Ok () => do
      payload <- payloadJson claimsSeg
      claims <- readClaims payload
      inWindow <- checkWindow now claims
      checkAudience expectedSub expectedAud inWindow

{- | The claims of `token`, or why it was refused.

     `now` is seconds since the Unix epoch, supplied by the caller — this
     module reads no clock. The signature is checked before anything in the
     token is parsed as JSON, and HS256 is pinned by this verifier rather
     than read from the token's own header. -}
export
verifyToken : Array Int ->
  String ->
  String ->
  Int ->
  String ->
  Result JwtError Claims
verifyToken secret expectedSub expectedAud now token = match split "." token
  [headerSeg, claimsSeg, sigSeg] =>
    verifySegments secret expectedSub expectedAud now headerSeg claimsSeg sigSeg
  _ => Err JwtMalformed

-- ── service auth: the credential an off-box peer verifies (P16/§4.5) ─────────

{- | What a caller supplies to mint one service-auth credential.

     `exp` is absent deliberately: the lifetime is this module's
     (`serviceTokenLifetimeSeconds`), not the caller's, so no call site can
     widen it.

     `aud` may arrive carrying a `#<serviceId>` fragment — such a string names
     a service OF a DID, and only the DID itself is ever the audience.

     `lxm` is the NSID of the method the credential is being spent on. `None`
     omits the claim rather than nulling it, and mints a token that authorizes
     every method the audience exposes, so supply it wherever the call is
     known. -}
public export data ServiceAuthRequest = ServiceAuthRequest {
  iss : String,
  aud : String,
  lxm : Option String,
  jti : String,
  iat : Int,
}
  deriving (Eq, Debug)

{- | How many seconds a service-auth token stays valid.

     Exported so a caller can size its own retry window against the figure
     instead of re-deriving it. Sixty seconds is what the official
     implementation mints, and therefore what a peer's clock-skew tolerance
     is calibrated against. -}
export
serviceTokenLifetimeSeconds : Int
serviceTokenLifetimeSeconds = 60

-- `typ` precedes `alg` here, the reverse of `headerJson` above. A peer
-- verifies the signature over the header segment exactly as serialized, so
-- member order is wire-visible; this order reproduces the byte sequence in
-- pds/test/vectors/pds_service_auth_shape_corpus.txt.
serviceHeaderJson : Json
serviceHeaderJson = jObject [("typ", JString "JWT"), ("alg", JString "ES256K")]

-- `did:web:appview.example#bsky_appview` names the `bsky_appview` service of
-- a DID; the audience is the DID. Signing the fragment in would mint a
-- credential that no peer's `aud` comparison accepts.
bareDid : String -> String
bareDid serviceId = match indexOf "#" serviceId
  Some at => take at serviceId
  None => serviceId

lxmMembers : Option String -> List (String, Json)
lxmMembers (Some method) = [("lxm", JString method)]
lxmMembers None = []

-- The claim set, in the order the official implementation serializes it.
serviceClaimsJson : ServiceAuthRequest -> Json
serviceClaimsJson request =
  jObject
    ([
        ("iat", JInt request.iat),
        ("iss", JString request.iss),
        ("aud", JString (bareDid request.aud)),
        ("exp", JInt (request.iat + serviceTokenLifetimeSeconds)),
      ]
      ++ lxmMembers request.lxm
      ++ [("jti", JString request.jti)])

{- | The ES256K signature of a JWS Signing Input (RFC 7515 §5.1 step 5), as an
     unpadded base64url string: the canonical low-S secp256k1 ECDSA signature
     over the input's SHA-256 digest, serialized as the raw 64-byte IEEE P1363
     `r || s`. Not DER — a peer's verifier refuses that encoding.

     Exported for the reason `hs256Signature` is: it lets a test grade the
     signature independently of the header and claim shapes
     `mintServiceToken` chooses. -}
export
es256kSignature : SecretKey -> String -> Result String String
es256kSignature key signingInput =
  map
    (signature => b64uEncode (signatureCompact signature))
    (signDigest key (sha256 (toUtf8 signingInput)))

{- | A service-auth token for `request`, signed with the issuing account's own
     repo key.

     `Err` carries `lib.sign.signDigest`'s message, and is reachable only when
     the RFC 6979 nonce schedule exhausts its retry bound — which no input
     chooses and no caller can provoke. -}
export
mintServiceToken : SecretKey -> ServiceAuthRequest -> Result String String
mintServiceToken key request =
  let headerSeg = b64uEncodeText (stringify serviceHeaderJson)
  let claimsSeg = b64uEncodeText (stringify (serviceClaimsJson request))
  let signingInput = "\{headerSeg}.\{claimsSeg}"
  map (sigSeg => "\{signingInput}.\{sigSeg}") (es256kSignature key signingInput)
