{- | Strict pure CARv1 for the atproto repository profile.

   The wire format follows final IPLD CARv1: an unsigned-LEB128 length and
   canonical DAG-CBOR header, followed by length-prefixed CID+block sections.
   The atproto profile admits only blessed CIDs and requires at least one root
   whose block is present. Section order is preserved; identical duplicates and
   unrelated blocks are accepted, while every block crosses the verified
   blockstore trust boundary. -}

import bytebuilder.{Builder, buildBytes, emitBytes, newBuilder}
import bytes.{Bytes, length as bytesLength, sliceClamped}
import list.{reverse}
import lib.blockstore.{BlockStore, blockStoreFromBlocks, blockStoreHas}
import lib.cid.{Cid, cidFromBytes, cidToBytes}
import lib.dagcbor.{DagCbor(..), dagCborDecode, dagCborEncode}
import lib.multiformats.{uvarintDecode, uvarintEncode}
import lib.resource_limits.{checkCarBlocks, checkCarBytes, checkCarSectionBytes}

-- | A decoded CAR preserving section order plus its verified unique store.
export data Car = Car (List Cid) (List (Cid, Bytes)) BlockStore

-- | Header roots in their declared order.
export
carRoots : Car -> List Cid
carRoots (Car roots _ _) = roots

-- | Blocks in their original section order, including identical duplicates.
export
carBlocks : Car -> List (Cid, Bytes)
carBlocks (Car _ blocks _) = blocks

-- | Verified unique block store.
export
carStore : Car -> BlockStore
carStore (Car _ _ store) = store

headerValue : List Cid -> Int -> DagCbor
headerValue roots version =
  DcMap [("roots", DcArray (map DcLink roots)), ("version", DcInt version)]

decodeRoots : List DagCbor -> List Cid -> Result String (List Cid)
decodeRoots [] acc = Ok (reverse acc)
decodeRoots ((DcLink cid) :: rest) acc = decodeRoots rest (cid :: acc)
decodeRoots _ _ = Err "car: header roots must contain only CID links"

decodeHeader : Bytes -> Result String (List Cid)
decodeHeader bytes = match dagCborDecode bytes
  Err message => Err "car: invalid header: \{message}"
  Ok (DcMap [("roots", DcArray values), ("version", DcInt version)]) =>
    if version /= 1 then
      Err "car: header version must be 1"
    else match decodeRoots values []
      Err message => Err message
      Ok [] => Err "car: atproto profile requires at least one root"
      Ok roots => Ok roots
  Ok _ => Err "car: header must be exactly {roots, version}"

-- The bytes over `[start, start + size)`, copied out of `input`. Every call
-- site validates the range against a length it already read before slicing,
-- so a clamp here never masks a bounds bug.
carSlice : Bytes -> Int -> Int -> Bytes
carSlice input start size = sliceClamped start (start + size) input

{- | One unsigned-varint at `pos`, bounded by `end` (not necessarily the
   whole input — a CID's own fields bound each other's search window). The
   empty-window case is reported before `multiformats.uvarintDecode` ever
   sees it, so its message names `label` rather than the field-agnostic
   "truncated (input ended with the continuation bit still set)"; every
   other rejection is `uvarintDecode`'s own message, unchanged. -}
readVarintAt : String -> Bytes -> Int -> Int -> Result String (Int, Int)
readVarintAt label input pos end =
  if pos >= end then
    Err "car: truncated \{label} varint"
  else match uvarintDecode (sliceClamped pos end input)
    Err message => Err "car: \{label}: \{message}"
    Ok (value, consumed) => Ok (value, pos + consumed)

parseCidAt : Bytes -> Int -> Int -> Result String (Cid, Int)
parseCidAt input start end = do
  (_, p1) <- readVarintAt "CID version" input start end
  (_, p2) <- readVarintAt "CID codec" input p1 end
  (_, p3) <- readVarintAt "CID hash code" input p2 end
  (digestLength, p4) <- readVarintAt "CID hash length" input p3 end
  -- The length is the input's own varint, up to 2^62 - 1: compared against
  -- what remains before it is added, so the sum cannot overflow.
  if digestLength < 0 || digestLength > end - p4 then
    Err "car: truncated CID digest"
  else
    let cidEnd = p4 + digestLength
    match cidFromBytes (carSlice input start (cidEnd - start))
      Err message => Err "car: malformed or non-blessed CID: \{message}"
      Ok cid => Ok (cid, cidEnd)

decodeSections : Bytes ->
  Int ->
  Int ->
  List (Cid, Bytes) ->
  Result String (List (Cid, Bytes))
decodeSections input pos count acc =
  if pos == bytesLength input then
    Ok (reverse acc)
  else match checkCarBlocks (count + 1)
    Err message => Err message
    Ok () =>
      match (readVarintAt
        "trailing corruption in section length"
        input
        pos
        (bytesLength input))
        Err message => Err message
        Ok (sectionLength, payloadPos) =>
          if sectionLength == 0 then
            Err "car: zero-length section"
          else match checkCarSectionBytes sectionLength
            Err message => Err message
            Ok () =>
              if sectionLength > bytesLength input - payloadPos then
                Err
                  "car: truncated or overlong section length exceeds remaining bytes"
              else
                let sectionEnd = payloadPos + sectionLength
                match parseCidAt input payloadPos sectionEnd
                  Err message => Err message
                  Ok (cid, cidEnd) =>
                    let block = carSlice input cidEnd (sectionEnd - cidEnd)
                    decodeSections
                      input
                      sectionEnd
                      (count + 1)
                      ((cid, block) :: acc)

rootsPresent : List Cid -> BlockStore -> Result String Unit
rootsPresent [] _ = Ok ()
rootsPresent (root :: rest) store =
  if blockStoreHas root store then
    rootsPresent rest store
  else
    Err "car: atproto profile root block is missing"

makeCar : List Cid -> List (Cid, Bytes) -> Result String Car
makeCar [] _ = Err "car: atproto profile requires at least one root"
makeCar roots blocks = match checkCarBlocks (length blocks)
  Err message => Err message
  Ok () => match blockStoreFromBlocks blocks
    Err message => Err "car: \{message}"
    Ok store => map (() => Car roots blocks store) (rootsPresent roots store)

emitSections : List (Cid, Bytes) -> Builder -> Unit
emitSections [] _ = ()
emitSections ((cid, block) :: rest) out =
  let cidBytes = cidToBytes cid
  let payloadLength = bytesLength cidBytes + bytesLength block
  emitBytes (uvarintEncode payloadLength) out
  emitBytes cidBytes out
  emitBytes block out
  emitSections rest out

encodedSectionsSize : List (Cid, Bytes) -> Int -> Result String Int
encodedSectionsSize [] total = Ok total
encodedSectionsSize ((cid, block) :: rest) total =
  let payloadLength = bytesLength (cidToBytes cid) + bytesLength block
  match checkCarSectionBytes payloadLength
    Err message => Err message
    Ok () =>
      let next =
        total + bytesLength (uvarintEncode payloadLength) + payloadLength
      match checkCarBytes next
        Err message => Err message
        Ok () => encodedSectionsSize rest next

{- | Canonically encode the header and preserve the caller's explicit block
   order, once `verified` says the rows are admissible.

   `verified` is what the two encoders below differ in, and it is inspected
   LAST so that a malformed input reports the same refusal from both: the
   block count, the header encoding and the section sizes are all decided
   before the row verification's answer is read. -}
carEncodeChecked : List Cid ->
  List (Cid, Bytes) ->
  Result String Unit ->
  Result String Bytes
carEncodeChecked roots blocks verified = match checkCarBlocks (length blocks)
  Err message => Err message
  Ok () => match dagCborEncode (headerValue roots 1)
    Err message => Err "car: header encoding failed: \{message}"
    Ok header =>
      let headerPrefix = uvarintEncode (bytesLength header)
      let headerSize = bytesLength headerPrefix + bytesLength header
      match encodedSectionsSize blocks headerSize
        Err message => Err message
        Ok _ => match verified
          Err message => Err message
          Ok () =>
            let out = newBuilder ()
            let () = emitBytes headerPrefix out
            let () = emitBytes header out
            let () = emitSections blocks out
            Ok (buildBytes out)

{- | Canonically encode the header and preserve the caller's explicit block
   order. Every row is verified before any bytes are returned. -}
export
carEncode : List Cid -> List (Cid, Bytes) -> Result String Bytes
carEncode roots blocks =
  carEncodeChecked roots blocks (map (_ => ()) (makeCar roots blocks))

rowsVerified : List (Cid, Bytes) -> Result String Unit
rowsVerified blocks = match blockStoreFromBlocks blocks
  Err message => Err "car: \{message}"
  Ok _ => Ok ()

{- | A CAR whose `roots` list is EMPTY, carrying the caller's blocks in the
   caller's order.

   The atproto profile this module otherwise enforces — at least one root,
   whose block is present — is a property of the repository CARs: `getRepo`'s
   export, a `#commit` event's `blocks`, a `#sync` event's. It is not a
   property of the format, and one official route contradicts it:
   `com.atproto.sync.getBlocks` answers a bare bag of blocks, whose header
   names no root at all, because the blocks it returns are the ones the caller
   asked for by CID and nothing relates them to each other. So this encoder
   exists beside `carEncode` rather than as a relaxation of it, and DECODING
   still refuses a rootless CAR: nothing this server reads is one. -}
export
carEncodeRootless : List (Cid, Bytes) -> Result String Bytes
carEncodeRootless blocks = carEncodeChecked [] blocks (rowsVerified blocks)

-- | Strictly decode one complete CARv1 byte array.
export
carDecode : Bytes -> Result String Car
carDecode input = match checkCarBytes (bytesLength input)
  Err message => Err message
  Ok () => match readVarintAt "header length" input 0 (bytesLength input)
    Err message => Err message
    Ok (headerLength, headerPos) =>
      if headerLength == 0 then
        Err "car: zero-length header section"
      else if headerLength > bytesLength input - headerPos then
        Err "car: truncated header section"
      else
        let header = carSlice input headerPos headerLength
        match decodeHeader header
          Err message => Err message
          Ok roots => match decodeSections input (headerPos + headerLength) 0 []
            Err message => Err message
            Ok blocks => makeCar roots blocks
