{- | SHA-1 hashing of a byte string (FIPS 180-4 §6.1, RFC 3174).

   The digest is 20 bytes, most significant byte of each word first.

   SHA-1 is here for ONE reason: RFC 6455 §4.2.2 defines the WebSocket
   opening handshake's `Sec-WebSocket-Accept` as a SHA-1 of the client key
   concatenated with a fixed GUID. That use is a protocol constant, not a
   security claim — the digest authenticates nothing and keeps no secret.
   Nothing else in this server may hash with it; `stdlib/crypto/sha256.mdk` is the
   hash for every content-addressing and signing path.

   There is no incremental form. A message is hashed in one call. -}

-- Arithmetic contract, identical to `stdlib/crypto/sha256.mdk`'s. Every word is a
-- `U32`, so `+` is addition modulo 2^32 and every bit operation, shift and
-- rotate stays within 32 bits. Bytes stay `U8`: a word is assembled from
-- four bytes through `U32.fromU8`, and a digest word leaves through
-- `U32.toBytesBE`. Neither conversion branches, and neither can wrap the
-- byte domain — `Bytes` already guarantees every element is `0` to `255`.
--
-- Message words are big-endian (FIPS 180-4 §3.1) and the digest is emitted in
-- H0..H4 order.
--
-- No padded copy of the whole message is ever materialized: full 64-byte
-- blocks are read directly from the input by offset, and only the final one
-- or two blocks are synthesized to hold the 0x80 marker, the zero padding and
-- the 64-bit big-endian bit length.

-- SHA-1 and SHA-256 share the Merkle-Damgard skeleton the whole SHA-2 family
-- shares — same padding rule, same big-endian word order, same block-folding
-- shape — so the two modules read alike by construction. They are different
-- compression functions over different state widths with different round
-- constants, and neither can be expressed in terms of the other.
-- lint-disable-file rule-stdlib-reimpl
-- lint-disable-file rule-duplicate-body

import array.{make, setInPlace}
import bytes as B
import bytes.{Bytes}
import mut_bytes as MB
import u8 as U8
import u32 as U32

-- ── Constants ────────────────────────────────────────────────────────

-- FIPS 180-4 §5.3.1 initial hash value H(0).
h0Init : (U32, U32, U32, U32, U32)
h0Init = (0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0)

-- FIPS 180-4 §4.2.1 round constants, one per twenty-round quarter.
roundConstant : Int -> U32
roundConstant t =
  if t < 20 then
    0x5a827999
  else if t < 40 then
    0x6ed9eba1
  else if t < 60 then
    0x8f1bbcdc
  else
    0xca62c1d6

-- FIPS 180-4 §4.1.1 f(t, b, c, d), by quarter.
roundF : Int -> U32 -> U32 -> U32 -> U32
roundF t b c d =
  if t < 20 then
    U32.bitOr (U32.bitAnd b c) (U32.bitAnd (U32.bitNot b) d)
  else if t < 40 then
    U32.bitXor (U32.bitXor b c) d
  else if t < 60 then
    U32.bitOr (U32.bitOr (U32.bitAnd b c) (U32.bitAnd b d)) (U32.bitAnd c d)
  else
    U32.bitXor (U32.bitXor b c) d

-- ── Message schedule ─────────────────────────────────────────────────

-- Big-endian 32-bit word starting at byte index `i*4`, read through an
-- arbitrary byte accessor (so the caller decides whether bytes come from
-- the original message or a synthesized tail block).
scheduleWord : (Int -> U8) -> Int -> U32
scheduleWord byteOf i =
  let b0 = U32.fromU8 (byteOf (i * 4))
  let b1 = U32.fromU8 (byteOf (i * 4 + 1))
  let b2 = U32.fromU8 (byteOf (i * 4 + 2))
  let b3 = U32.fromU8 (byteOf (i * 4 + 3))
  U32.bitOr
    (U32.bitOr
      (U32.bitOr (U32.shiftLeft b0 24) (U32.shiftLeft b1 16))
      (U32.shiftLeft b2 8))
    b3

fillFirst16 : Array U32 -> (Int -> U8) -> Int -> Unit
fillFirst16 w byteOf i =
  if i >= 16 then
    ()
  else
    setInPlace i (scheduleWord byteOf i) w
    fillFirst16 w byteOf (i + 1)

-- FIPS 180-4 §6.1.2 step 1: W[t] = ROTL^1(W[t-3] xor W[t-8] xor W[t-14]
-- xor W[t-16]).
extendSchedule : Array U32 -> Int -> Unit
extendSchedule w i =
  if i >= 80 then
    ()
  else
    let x =
      U32.bitXor (U32.bitXor (U32.bitXor w[i - 3] w[i - 8]) w[i - 14]) w[i - 16]
    setInPlace i (U32.rotateLeft x 1) w
    extendSchedule w (i + 1)

-- Build the 80-word message schedule for one block from a byte accessor
-- covering that block's 64 bytes (offsets 0..63).
buildSchedule : (Int -> U8) -> Array U32
buildSchedule byteOf =
  let w = make 80 (0 : U32)
  fillFirst16 w byteOf 0
  extendSchedule w 16
  w

-- ── Compression ──────────────────────────────────────────────────────

type State = (U32, U32, U32, U32, U32)

-- The five working variables are separate parameters rather than one
-- `State` tuple, mirroring `stdlib/crypto/sha256.mdk`'s `compressRounds`: the 80
-- rounds are a self tail call on words and allocate nothing; the tuple is
-- built once, after the last round.
compressRounds : Array U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Int -> State
compressRounds w a b c d e t =
  if t >= 80 then
    (a, b, c, d, e)
  else
    let tv = U32.rotateLeft a 5 + roundF t b c d + e + roundConstant t + w[t]
    compressRounds w tv a (U32.rotateLeft b 30) c d (t + 1)

-- One 64-byte block, addressed via `byteOf` (offsets 0..63 relative to the
-- block start), folded into the running hash state.
compressBlock : (Int -> U8) -> State -> State
compressBlock byteOf (h0, h1, h2, h3, h4) =
  let w = buildSchedule byteOf
  let (a, b, c, d, e) = compressRounds w h0 h1 h2 h3 h4 0
  (h0 + a, h1 + b, h2 + c, h3 + d, h4 + e)

-- ── Driving the blocks ───────────────────────────────────────────────

-- Fold every FULL 64-byte block of `msg` directly by offset — no copy of
-- the message is ever made.
processFullBlocks : Bytes -> Int -> State -> Int -> State
processFullBlocks msg numFull st blockIdx =
  if blockIdx >= numFull then
    st
  else
    let base = blockIdx * 64
    processFullBlocks
      msg
      numFull
      (compressBlock (j => msg[base + j]) st)
      (blockIdx + 1)

-- The message's bit length, big-endian, into the last 8 bytes of the
-- synthesized padded region.
writeLenGo : MB.MutBytes -> Int -> Int -> Int -> Unit
writeLenGo out offset bitLen i =
  if i >= 8 then
    ()
  else
    let shiftAmt = (7 - i) * 8
    MB.setInPlace
      (offset + i)
      (U8.truncate (bitAnd (shiftRight bitLen shiftAmt) 255))
      out
    writeLenGo out offset bitLen (i + 1)

-- The number of bytes in the final, padded region (one block if the tail
-- plus the 0x80 marker plus the 8-byte length fits in 64 bytes, else two).
padLength : Int -> Int
padLength tailLen = if tailLen + 1 + 8 <= 64 then 64 else 128

-- Copies `n` bytes of `src` starting at `srcOff` into `dst` starting at
-- `dstOff`, one byte at a time: the only crossing from the immutable `Bytes`
-- message into the mutable tail buffer being synthesized, and `n` is at most
-- 63 (the tail is always shorter than one block).
blitBytesIntoMut : Bytes -> Int -> MB.MutBytes -> Int -> Int -> Unit
blitBytesIntoMut src srcOff dst dstOff n
  | n <= 0 = ()
  | otherwise =
    MB.setInPlace dstOff src[srcOff] dst
    blitBytesIntoMut src (srcOff + 1) dst (dstOff + 1) (n - 1)

-- Synthesize the final one-or-two padded blocks: `tailLen` message bytes
-- (copied a byte at a time, never the whole message), then `0x80`, then zero
-- bytes, then the 64-bit big-endian bit length of the WHOLE message.
buildTail : Bytes -> Int -> Int -> Bytes
buildTail msg len tailLen =
  let size = padLength tailLen
  let mb = MB.make size
  blitBytesIntoMut msg (len - tailLen) mb 0 tailLen
  MB.setInPlace tailLen (0x80 : U8) mb
  writeLenGo mb (size - 8) (len * 8) 0
  MB.freeze mb

processTail : Bytes -> State -> State
processTail tail st =
  let numBlocks = B.length tail / 64
  processFullBlocks tail numBlocks st 0

digestBytes : State -> Bytes
digestBytes (h0, h1, h2, h3, h4) = B.concat [
  U32.toBytesBE h0,
  U32.toBytesBE h1,
  U32.toBytesBE h2,
  U32.toBytesBE h3,
  U32.toBytesBE h4,
]

-- ── Public entry point ───────────────────────────────────────────────

{- | The 20-byte SHA-1 digest of `msg`. -}
export
sha1 : Bytes -> Bytes
sha1 msg =
  let len = B.length msg
  let numFull = len / 64
  let tailLen = len - numFull * 64
  let afterFull = processFullBlocks msg numFull h0Init 0
  let tail = buildTail msg len tailLen
  digestBytes (processTail tail afterFull)
