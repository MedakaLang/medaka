{- | Canonical CBOR for the atproto data model.

   Atproto now calls this no-float deterministic profile DRISL-CBOR; its
   wire format for the value subset below is the historical DAG-CBOR format:
   shortest integers and lengths, deterministically sorted string map keys,
   no duplicate keys or indefinite values, and CID links under tag 42 with
   the required leading identity byte.

   Medaka `Int` is a signed 63-bit fixnum. Consequently this module supports
   the representable range `[-2^62, 2^62-1]`, and loudly rejects the remaining
   spec-legal 64-bit integer values rather than wrapping them. -}

import array.{drop}
import bytebuilder.{
  Builder,
  buildArray,
  emitBeUint,
  emitBytes,
  emitU8,
  newBuilder,
}
import byteparser.{
  BErr,
  BOk,
  BResult,
  ByteParser,
  ByteParserE,
  runBP,
  takeSlice,
}
import list.{reverse, sortBy}
import string.{fromUtf8, toUtf8}
import lib.cid.{Cid, cidFromBytes, cidToBytes}

-- | The exact atproto data-model value subset admitted by this codec.
public export data DagCbor =
  | DcNull
  | DcBool Bool
  | DcInt Int
  | DcBytes (Array Int)
  | DcString String
  | DcArray (List DagCbor)
  | DcMap (List (String, DagCbor))
  | DcLink Cid

maxDepth : Int
maxDepth = 128

validBytes : Array Int -> Int -> Bool
validBytes bytes i =
  if i < arrayLength bytes then
    bytes[i] >= 0 && bytes[i] <= 255 && validBytes bytes (i + 1)
  else
    True

arrayBytes : Array Int -> Int -> List Int
arrayBytes bytes i =
  if i >= arrayLength bytes then [] else bytes[i] :: arrayBytes bytes (i + 1)

emitArgument : Int -> Int -> Builder -> Unit
emitArgument major value out =
  if value < 24 then
    emitU8 (shiftLeft major 5 + value) out
  else if value <= 255 then
    emitU8 (shiftLeft major 5 + 24) out
    emitU8 value out
  else if value <= 65535 then
    emitU8 (shiftLeft major 5 + 25) out
    emitBeUint 2 value out
  else if value <= 4294967295 then
    emitU8 (shiftLeft major 5 + 26) out
    emitBeUint 4 value out
  else
    emitU8 (shiftLeft major 5 + 27) out
    emitBeUint 8 value out

keyCompare : String -> String -> Ordering
keyCompare left right =
  let a = toUtf8 left
  let b = toUtf8 right
  match compare (arrayLength a) (arrayLength b)
    Eq => compareKeyBytes a b 0
    order => order

compareKeyBytes : Array Int -> Array Int -> Int -> Ordering
compareKeyBytes left right i =
  if i >= arrayLength left then
    Eq
  else match compare left[i] right[i]
    Eq => compareKeyBytes left right (i + 1)
    order => order

emitValue : DagCbor -> Builder -> Result String Unit
emitValue DcNull out =
  emitU8 0xf6 out
  Ok ()
emitValue (DcBool False) out =
  emitU8 0xf4 out
  Ok ()
emitValue (DcBool True) out =
  emitU8 0xf5 out
  Ok ()
emitValue (DcInt value) out =
  if value >= 0 then
    emitArgument 0 value out
  else
    emitArgument 1 (0 - 1 - value) out
  Ok ()
emitValue (DcBytes bytes) out =
  if not (validBytes bytes 0) then
    Err "dagcbor: byte string element outside byte range 0..255"
  else
    emitArgument 2 (arrayLength bytes) out
    emitBytes (arrayBytes bytes 0) out
    Ok ()
emitValue (DcString text) out =
  let bytes = toUtf8 text
  emitArgument 3 (arrayLength bytes) out
  emitBytes (arrayBytes bytes 0) out
  Ok ()
emitValue (DcArray values) out =
  emitArgument 4 (length values) out
  emitValues values out
emitValue (DcMap fields) out =
  let sorted = sortBy ((left, _) (right, _) => keyCompare left right) fields
  match firstDuplicate sorted None
    Some key => Err "dagcbor: duplicate map key '\{key}'"
    None =>
      emitArgument 5 (length sorted) out
      emitFields sorted out
emitValue (DcLink cid) out =
  let bytes = cidToBytes cid
  emitU8 0xd8 out
  emitU8 0x2a out
  emitArgument 2 (arrayLength bytes + 1) out
  emitU8 0 out
  emitBytes (arrayBytes bytes 0) out
  Ok ()

emitValues : List DagCbor -> Builder -> Result String Unit
emitValues [] _ = Ok ()
emitValues (value :: rest) out = match emitValue value out
  Err message => Err message
  Ok () => emitValues rest out

emitFields : List (String, DagCbor) -> Builder -> Result String Unit
emitFields [] _ = Ok ()
emitFields ((key, value) :: rest) out = match emitValue (DcString key) out
  Err message => Err message
  Ok () => match emitValue value out
    Err message => Err message
    Ok () => emitFields rest out

firstDuplicate : List (String, DagCbor) -> Option String -> Option String
firstDuplicate [] _ = None
firstDuplicate ((key, _) :: rest) None = firstDuplicate rest (Some key)
firstDuplicate ((key, _) :: rest) (Some prior) =
  if key == prior then Some key else firstDuplicate rest (Some key)

-- | Encode one value to its unique canonical byte representation.
export
dagCborEncode : DagCbor -> Result String (Array Int)
dagCborEncode value =
  let out = newBuilder ()
  map (_ => buildArray out) (emitValue value out)

foldUInt : Array Int -> Int -> Int
foldUInt bytes i = foldUIntGo bytes i 0

foldUIntGo : Array Int -> Int -> Int -> Int
foldUIntGo bytes i acc =
  if i >= arrayLength bytes then
    acc
  else
    foldUIntGo bytes (i + 1) (acc * 256 + bytes[i])

readSizedArgument : Array Int -> Int -> Int -> Int -> BResult Int
readSizedArgument input pos width minimum = match (runBP
  (takeSlice width)
  input
  pos)
  BErr message errorPos => BErr message errorPos
  BOk bytes endPos =>
    if width == 8 && bytes[0] >= 64 then
      BErr "dagcbor: integer/length exceeds representable Int range" pos
    else
      let value = foldUInt bytes 0
      if value < minimum then
        BErr "dagcbor: non-canonical shortest integer/length" pos
      else
        BOk value endPos

readArgument : Array Int -> Int -> Int -> BResult Int
readArgument _ pos additional
  | additional < 24 = BOk additional pos
readArgument input pos 24 = readSizedArgument input pos 1 24
readArgument input pos 25 = readSizedArgument input pos 2 256
readArgument input pos 26 = readSizedArgument input pos 4 65536
readArgument input pos 27 = readSizedArgument input pos 8 4294967296
readArgument _ pos 31 =
  BErr "dagcbor: indefinite-length values are not allowed" pos
readArgument _ pos _ = BErr "dagcbor: reserved additional-information value" pos

parseValueAt : Array Int -> Int -> Int -> BResult DagCbor
parseValueAt input pos depth =
  if depth > maxDepth then
    BErr "dagcbor: nesting depth exceeds 128" pos
  else if pos >= arrayLength input then
    BErr "dagcbor: truncated value" pos
  else
    let initial = input[pos]
    let major = shiftRight initial 5
    let additional = bitAnd initial 31
    parseMajor input (pos + 1) depth major additional

parseMajor : Array Int -> Int -> Int -> Int -> Int -> BResult DagCbor
parseMajor input pos _ 0 additional = match readArgument input pos additional
  BErr message errorPos => BErr message errorPos
  BOk value endPos => BOk (DcInt value) endPos
parseMajor input pos _ 1 additional = match readArgument input pos additional
  BErr message errorPos => BErr message errorPos
  BOk value endPos => BOk (DcInt (0 - 1 - value)) endPos
parseMajor input pos _ 2 additional = parseBytes input pos additional
parseMajor input pos _ 3 additional = parseString input pos additional
parseMajor input pos depth 4 additional = match (readArgument
  input
  pos
  additional)
  BErr message errorPos => BErr message errorPos
  BOk count endPos => parseArray input endPos depth count []
parseMajor input pos depth 5 additional = match (readArgument
  input
  pos
  additional)
  BErr message errorPos => BErr message errorPos
  BOk count endPos => parseMap input endPos depth count None []
parseMajor input pos depth 6 additional = parseTag input pos depth additional
parseMajor _ pos _ 7 20 = BOk (DcBool False) pos
parseMajor _ pos _ 7 21 = BOk (DcBool True) pos
parseMajor _ pos _ 7 22 = BOk DcNull pos
parseMajor _ pos _ 7 _ =
  BErr
    "dagcbor: floats, undefined, and other simple values are not allowed by atproto"
    pos
parseMajor _ pos _ _ _ = BErr "dagcbor: unsupported CBOR major type" pos

parseBytes : Array Int -> Int -> Int -> BResult DagCbor
parseBytes input pos additional = match readArgument input pos additional
  BErr message errorPos => BErr message errorPos
  BOk count endPos => match runBP (takeSlice count) input endPos
    BErr _ errorPos => BErr "dagcbor: truncated byte string" errorPos
    BOk bytes finalPos => BOk (DcBytes bytes) finalPos

parseString : Array Int -> Int -> Int -> BResult DagCbor
parseString input pos additional = match readArgument input pos additional
  BErr message errorPos => BErr message errorPos
  BOk count endPos => match runBP (takeSlice count) input endPos
    BErr _ errorPos => BErr "dagcbor: truncated UTF-8 string" errorPos
    BOk bytes finalPos =>
      if not (validUtf8 bytes 0) then
        BErr "dagcbor: invalid UTF-8 string" endPos
      else
        BOk (DcString (fromUtf8 bytes)) finalPos

continuation : Int -> Bool
continuation byte = byte >= 0x80 && byte <= 0xbf

validUtf8 : Array Int -> Int -> Bool
validUtf8 bytes i =
  if i >= arrayLength bytes then
    True
  else
    let first = bytes[i]
    if first <= 0x7f then
      validUtf8 bytes (i + 1)
    else if first >= 0xc2 && first <= 0xdf then
      i + 1 < arrayLength bytes
        && continuation bytes[i + 1]
        && validUtf8 bytes (i + 2)
    else if first >= 0xe0 && first <= 0xef then
      validUtf8Three bytes i first
    else if first >= 0xf0 && first <= 0xf4 then
      validUtf8Four bytes i first
    else
      False

validUtf8Three : Array Int -> Int -> Int -> Bool
validUtf8Three bytes i first =
  if i + 2 >= arrayLength bytes then
    False
  else
    let second = bytes[i + 1]
    let secondOk =
      if first == 0xe0 then
        second >= 0xa0 && second <= 0xbf
      else if first == 0xed then
        second >= 0x80 && second <= 0x9f
      else
        continuation second
    secondOk && continuation bytes[i + 2] && validUtf8 bytes (i + 3)

validUtf8Four : Array Int -> Int -> Int -> Bool
validUtf8Four bytes i first =
  if i + 3 >= arrayLength bytes then
    False
  else
    let second = bytes[i + 1]
    let secondOk =
      if first == 0xf0 then
        second >= 0x90 && second <= 0xbf
      else if first == 0xf4 then
        second >= 0x80 && second <= 0x8f
      else
        continuation second
    secondOk
      && continuation bytes[i + 2]
      && continuation bytes[i + 3]
      && validUtf8 bytes (i + 4)

parseArray : Array Int -> Int -> Int -> Int -> List DagCbor -> BResult DagCbor
parseArray _ pos _ 0 acc = BOk (DcArray (reverse acc)) pos
parseArray input pos depth remaining acc = match (parseValueAt
  input
  pos
  (depth + 1))
  BErr message errorPos => BErr message errorPos
  BOk value endPos =>
    parseArray input endPos depth (remaining - 1) (value :: acc)

parseMap : Array Int ->
  Int ->
  Int ->
  Int ->
  Option String ->
  List (String, DagCbor) ->
  BResult DagCbor
parseMap _ pos _ 0 _ acc = BOk (DcMap (reverse acc)) pos
parseMap input pos depth remaining previous acc = match (parseValueAt
  input
  pos
  (depth + 1))
  BErr message errorPos => BErr message errorPos
  BOk keyValue keyEnd => match keyValue
    DcString key => match mapKeyOrder previous key
      Err message => BErr message pos
      Ok () => match parseValueAt input keyEnd (depth + 1)
        BErr message errorPos => BErr message errorPos
        BOk value valueEnd =>
          parseMap
            input
            valueEnd
            depth
            (remaining - 1)
            (Some key)
            ((key, value) :: acc)
    _ => BErr "dagcbor: map key is not a string" pos

mapKeyOrder : Option String -> String -> Result String Unit
mapKeyOrder None _ = Ok ()
mapKeyOrder (Some previous) key = match keyCompare previous key
  Lt => Ok ()
  Eq => Err "dagcbor: duplicate map key"
  Gt => Err "dagcbor: map keys are not in deterministic order"

parseTag : Array Int -> Int -> Int -> Int -> BResult DagCbor
parseTag input pos _ additional = match readArgument input pos additional
  BErr message errorPos => BErr message errorPos
  BOk tag endPos =>
    if tag /= 42 then
      BErr "dagcbor: only tag 42 is allowed" pos
    else
      parseLink input endPos

parseLink : Array Int -> Int -> BResult DagCbor
parseLink input pos =
  if pos >= arrayLength input then
    BErr "dagcbor: truncated tag-42 link" pos
  else
    let initial = input[pos]
    let major = shiftRight initial 5
    let additional = bitAnd initial 31
    if major /= 2 then
      BErr "dagcbor: tag-42 link must contain a byte string" pos
    else match readArgument input (pos + 1) additional
      BErr message errorPos => BErr message errorPos
      BOk count payloadPos => match runBP (takeSlice count) input payloadPos
        BErr _ errorPos =>
          BErr "dagcbor: truncated tag-42 link payload" errorPos
        BOk payload finalPos =>
          if arrayLength payload == 0 || payload[0] /= 0 then
            BErr
              "dagcbor: tag-42 link is missing the leading identity byte"
              payloadPos
          else match cidFromBytes (drop 1 payload)
            Err message => BErr "dagcbor: tag-42 CID: \{message}" payloadPos
            Ok cid => BOk (DcLink cid) finalPos

dagParser : ByteParser DagCbor
dagParser = ByteParserE (input pos => parseValueAt input pos 0)

{- | Strictly decode exactly one canonical value. Trailing bytes are an
   error; no relaxed historical mode is provided. -}
export
dagCborDecode : Array Int -> Result String DagCbor
dagCborDecode bytes =
  if not (validBytes bytes 0) then
    Err "dagcbor: input element outside byte range 0..255"
  else match runBP dagParser bytes 0
    BErr message pos => Err "\{message} at byte \{intToString pos}"
    BOk value pos =>
      if pos /= arrayLength bytes then
        Err
          "dagcbor: trailing bytes after top-level value at byte \{intToString pos}"
      else
        Ok value
